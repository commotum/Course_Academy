solution "Given a function in the form $y = A\\cos(Bx +C) + D,$ the period is $\\dfrac{2\\pi}{B}.$\n\nIn our case, we have that $B=2.$ Therefore, the period is $\\dfrac{2\\pi}{\\left(2\\right)}=\\pi.$"} :knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/questions [{:db/id #edb/ref 17592186129782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db175ad-694b-5bb9-959a-3d6e0b2057a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6\\pi }{5}" :db/id #edb/ref 17592186327192} {:answer/id #uuid "287568e1-57a3-5493-8522-6c1936081561" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186327277} {:answer/id #uuid "6b8dcb34-da39-5684-9e5c-886c63a6cb4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186327859} {:answer/id #uuid "6bcad715-2c41-5c6c-a271-14ddd1312559" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186327863} {:answer/id #uuid "94944c92-3dbf-5f11-9056-1700eb82c373" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186328233}] :answer-field/correct {:answer/id #uuid "1db175ad-694b-5bb9-959a-3d6e0b2057a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6\\pi }{5}" :db/id #edb/ref 17592186327192} :answer-field/id #uuid "e2a75f1b-46ee-5473-b6c7-6d7a730ef92a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329577}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4126b1b4-8e8d-506d-b0ce-d7e1e1256bf6" :question/math-academy-id "q-43404" :question/problem "Calculate the period of the function $f(x)=\\frac{1}{6}\\operatorname{sin}⁡(\\frac{5x}{3}-\\frac{\\pi }{2}).$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{sin}⁡(Bx+C)+D,$ the period $T$ is given by $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=\\frac{5}{3}.$ Therefore, the period is $\\frac{2\\pi }{(\\frac{5}{3})}=\\frac{6\\pi }{5}.$"} {:db/id #edb/ref 17592186129817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8df7410f-c004-5fdc-8775-8ae956245c1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}π" :db/id #edb/ref 17592186128384} {:answer/id #uuid "c26a5f91-454c-5d0b-b99c-3ffa6db0e095" :answer/type {:db/ident :answer.type/math} :answer/value "3π" :db/id #edb/ref 17592186128385} {:answer/id #uuid "fb095275-19d1-5778-9232-aa71d9f1a890" :answer/type {:db/ident :answer.type/math} :answer/value "π" :db/id #edb/ref 17592186128386} {:answer/id #uuid "39937636-fe2a-507d-9af7-f505086060de" :answer/type {:db/ident :answer.type/math} :answer/value "2π" :db/id #edb/ref 17592186128387} {:answer/id #uuid "78edb559-cb2f-5d0d-be91-0a49601aa637" :answer/type {:db/ident :answer.type/math} :answer/value "6π" :db/id #edb/ref 17592186128388}] :answer-field/id #uuid "fcd88061-9c0f-538f-9503-8d54e8dc89ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128383}] :question/id #uuid "e1939ec4-08c8-5e9a-b224-be207716cfa8" :question/math-academy-id "q-53457" :question/problem "Calculate the period of the function $y = \\frac{1}{2}\\cos (\\frac{1}{3}x)$."} {:db/id #edb/ref 17592186233247 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b2af4088-8783-5a40-8f00-4eee6fee36d7" :question/math-academy-id "q-117580" :question/problem "Calculate the period of the function $y=\\operatorname{cos}(12x-\\frac{\\pi }{6}).$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}(Bx+C)+D,$ the period is $\\frac{2\\pi }{B}.$\n\nIn our case, we have that $B=12.$ Therefore, the period is $\\frac{2\\pi }{12}=\\frac{\\pi }{6}.$"} {:db/id #edb/ref 17592186233248 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7b1e99d2-4571-5eb0-b1cd-3cfd5a30a15