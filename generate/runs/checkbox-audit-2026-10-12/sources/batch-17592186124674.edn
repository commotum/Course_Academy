:db/id #edb/ref 17592186349906} {:answer/id #uuid "d33a0364-2eca-59d6-9d4a-aef2fd2d1463" :answer/type {:db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186350301} {:answer/id #uuid "f68a4f0c-5fe8-5709-a481-0a2835088a4f" :answer/type {:db/ident :answer.type/math} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186350605} {:answer/id #uuid "ff872ef7-82ca-59b4-af18-91ac052fdbd1" :answer/type {:db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186350701}] :answer-field/correct {:answer/id #uuid "ff872ef7-82ca-59b4-af18-91ac052fdbd1" :answer/type {:db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186350701} :answer-field/id #uuid "0c1ac7ab-74ba-5764-8f62-f311748dbee5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350729}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e356a361-0054-56e0-9326-4eab7969f279" :question/math-academy-id "q-81513" :question/problem "What is the period of the function $f(x)=-2\\operatorname{sin}⁡(9x-{1}^{∘})?$" :question/worked-solution "Given a function in the form $f(x)=A\\operatorname{sin}⁡(Bx+C)+D,$ the period is $\\frac{{360}^{∘}}{B}.$\n\nIn our case, we have that $B=9.$ Therefore, the period is $\\frac{{360}^{∘}}{9}={40}^{∘}.$"}] :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] [{:db/id #edb/ref 17592186129123 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128880 :question/id #uuid "bfa446cd-c215-59c2-b84d-35d7897e9e34" :question/math-academy-id "e-15615" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-6$ and a maximum value of $8.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny = \\dfrac{y_{\\textrm{min}}+y_{\\textrm{max}}}{2},\n$$\n\nwhere $y_{\\textrm{min}}$ and $y_{\\textrm{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-6+8}{2} \\\\  & =\\frac{2}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the midline is $y=1.$"} :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/questions [{:db/id #edb/ref 17592186129561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4da8725-8550-5cf7-8104-83fb6f684917" :answer/type {:db/ident :answer.type/math} :answer/value "y =-4" :db/id #edb/ref 17592186126844} {:answer/id #uuid "f94a10a6-5ab7-569e-8472-996b9cbd50c2" :answer/type {:db/ident :answer.type/math} :answer/value "y =-9" :db/id #edb/ref 17592186126845} {:answer/id #uuid "10dbf042-1fb5-5a2a-9c60-88dc1897734a" :answer/type {:db/ident :answer.type/math} :answer/value "y = 1" :db/id #edb/ref 17592186126846} {:answer/id #uuid "2a9ea6b3-85d6-5c26-8e00-91d959c6ea53" :answer/type {:db/ident :answer.type/math} :answer/value "y = 5" :db/id #edb/ref 17592186126847} {:answer/id #uuid "35140d77-6bc7-522e-a4b6-6b2d9d5e7dda" :answer/type {:db/ident :answer.type/math} :answer/value "y =-5" :db/id #edb/ref 17592186126848}] :answer-field/id #uuid "4ca55e4f-7957-562a-bb00-f3b76b1ea9e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126843}] :question/id #uuid "411be2a6-219d-561e-9f5e-b4e6962a294f" :question/math-academy-id "q-236750" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-9$ and a maximum value of $1$."} {:db/id #edb/ref 17592186129562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe8c2d-22ae-5a74-9fb5-b44fdb8cce26" :answer/type {:db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186288150} {:answer/id #uuid "3f9156c5-37a7-56f3-b8d3-991ed27e42a2" :answer/type {:db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288465} {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} {:answer/id #uuid "d650ff67-6889-5b78-bc90-d9ce4271c33c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186289456} {:answer/id #uuid "d7360b5c-2ef2-52b6-a3be-6f516c9b4151" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186289463}] :answer-field/correct {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} :answer-field/id #uuid "b0fa4e38-53cb-50b5-ba34-1bae28b400d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290121}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "723b13df-bde4-592d-ade7-17cdd1dad568" :question/math-academy-id "q-236896" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-5$ and a maximum value of $9.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+9}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"} {:db/id #edb/ref 17592186233657 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0c0ba785-82d4-51d4-ba62-9a6ddfc19813" :question/math-academy-id "q-236892" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $0$ and a maximum value of $4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{0+4}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"} {:db/id #edb/ref 17592186233658 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e065fd0c-2f57-53e6-b566-95ea17332857" :question/math-academy-id "q-236903" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-14$ and a maximum value of $-4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-14+(-4)}{2} \\\\  & =\\frac{-18}{2} \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-9.$"} {:db/id #edb/ref 17592186290474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd40bfd-062b-544e-82e4-2ec772085df7" :answer/type {:db/ident :answer.type/math} :answer/value "y=10" :db/id #edb/ref 17592186288466} {:answer/