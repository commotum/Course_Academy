{t}^{3} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}{e}^{t} \\\\ 3{t}^{2} \\\\ 2{e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -{t}^{3}{e}^{-t} \\\\ -{e}^{t}\\end{aligned}]+[\\begin{aligned}1 \\\\ 3{t}^{2}{e}^{-t} \\\\ 2{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 3{t}^{2}{e}^{-t}-{t}^{3}{e}^{-t} \\\\ {e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ {t}^{2}{e}^{-t}(3-t) \\\\ {e}^{t}\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7eb18dc-1cd0-5f11-9766-9b39ce8627d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393003} {:answer/id #uuid "c3e290d0-94dc-5b31-a2bd-857a223edcdb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡2t \\\\ 1 \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393004} {:answer/id #uuid "79b7fc04-e9d4-5de3-8865-cddcf5f7acfe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393005} {:answer/id #uuid "eecd81c6-e868-58ae-b147-24437027c490" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡4t \\\\ {cos}^{2}⁡t-{sin}^{2}⁡t \\\\ {e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393006} {:answer/id #uuid "01d87a17-578a-5627-9784-0c36eaa1beb0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ {cos}^{2}⁡t-{sin}^{2}⁡t \\\\ {e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393007}] :answer-field/correct {:answer/id #uuid "79b7fc04-e9d4-5de3-8865-cddcf5f7acfe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393005} :answer-field/id #uuid "5bffeefe-923c-5235-a516-2e71c745f54b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393002}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9d92bf36-e24a-53bf-b359-cf412f728c8a" :question/math-academy-id "q-70688" :question/problem "Find $(u(t)f(t))^{′}$ where $f(t)=[\\begin{aligned}2\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t \\\\ {e}^{t}\\end{aligned}]$ and $u(t)=\\operatorname{sin}⁡t.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n(u(t)f(t))^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{t})\\end{aligned}]=[\\begin{aligned}2\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t \\\\ {e}^{t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(u(t)f(t))^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =\\operatorname{cos}⁡t[\\begin{aligned}2\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t \\\\ {e}^{t}\\end{aligned}]+\\operatorname{sin}⁡t[\\begin{aligned}2\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t \\\\ {e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\ \\operatorname{cos}⁡t\\operatorname{cos}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t\\end{aligned}]+[\\begin{aligned}2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t\\operatorname{sin}⁡t \\\\ {e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡2t \\\\ {cos}^{2}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t\\end{aligned}]+[\\begin{aligned}\\operatorname{sin}⁡2t \\\\ -{sin}^{2}⁡t \\\\ {e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ {cos}^{2}⁡t-{sin}^{2}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t+{e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393105 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3d10de5-e9c5-5c37-aa64-fa06b54ead11" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{e}^{3t} \\\\ 4{e}^{4t} \\\\ 5{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393107} {:answer/id #uuid "6cba95e3-79b8-5287-a813-d9e41cf5e8b3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(t+3){e}^{3t} \\\\ (t+4){e}^{4t} \\\\ (t+5){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393108} {:answer/id #uuid "a3a250be-c0e9-5cab-92c9-3d602707d998" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3t{e}^{3t} \\\\ 4t{e}^{4t} \\\\ 5t{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393109} {:answer/id #uuid "6b7efc35-c9c9-54ba-9171-12ada5fa9705" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}({t}^{2}+1){e}^{3t} \\\\ ({t}^{2}+2){e}^{4t} \\\\ ({t}^{2}+3){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393110} {:answer/id #uuid "d86e8688-766e-519c-8b4e-8b4b1b2281ad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(3t+1){e}^{3t} \\\\ (4t+1){e}^{4t} \\\\ (5t+1){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393111}] :answer-field/correct {:answer/id #uuid "d86e8688-766e-519c-8b4e-8b4b1b2281ad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(3t+1){e}^{3t} \\\\ (4t+1){e}^{4t} \\\\ (5t+1){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393111} :answer-field/id #uuid "34376f88-2d0f-51e5-9b5f-462c8596e4f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393106}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3a49de4c-5d1f-5ca3-aa1a-4ebaca430818" :question/math-academy-id "q-71227" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}{e}^{3t} \\\\ {e}^{4t} \\\\ {e}^{5t}\\end{aligned}]$ and $u(t)=t.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{3t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{4t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{5t})\\end{aligned}]=[\\begin{aligned}3{e}^{3t} \\\\ 4{e}^{4t} \\\\ 5{e}^{5t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =1\\cdot [\\begin{aligned}{e}^{3t} \\\\ {e}^{4t} \\\\ {e}^{5t}\\end{aligned}]+t[\\begin{aligned}3{e}^{3t} \\\\ 4{e}^{4t} \\\\ 5{e}^{5t}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{3t} \\\\ {e}^{4t} \\\\ {e}^{5t}\\end{aligned}]+[\\begin{aligned}3t{e}^{3t} \\\\ 4t{e}^{4t} \\\\ 5t{e}^{5t}\\end{aligned}] \\\\  & =[\\begin{aligned}(3t+1){e}^{3t} \\\\ (4t+1){e}^{4t} \\\\ (5t+1){e}^{5t}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9538c922-626d-57e3-875e-1c3a6b6e5675" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(4{t}^{2}+t){e}^{t} \\\\ ({t}^{2}-1){e}^{t} \\\\ {e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393114} {:answer/id #uuid "8c39359a-bdf1-5f7a-abe2-7ec39aa9faf5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393115} {:answer/id #uuid "cd118cf1-a60f-5278-b6b0-774581fb4af6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(-5{t}^{3}-3{t}^{2}+1){e}^{t} \\\\ (3{t}^{2}-t-1){e}^{t} \\\\ (t+2){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393116} {:answer/id #uuid "0231d3d9-379e-569f-8987-f29126252cf1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}({t}^{2}-4t+4) \\\\ ({t}^{2}-1) \\\\ (2t+3)\\end{aligned}]" :db/id #edb/ref 17592186393117} {:answer/id #uuid "52e3e13a-2c9a-5dea-92ad-1d1be14d9577" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7{t}^{3}{e}^{t} \\\\ {t}^{2}{e}^{t} \\\\ 4t{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393118}] :answer-field/correct {:answer/id #uuid "8c39359a-bdf1-5f7a-abe2-7ec39aa9faf5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393115} :answer-field/id #uuid "c5faccf8-2ac3-56c6-9185-9f48d31adb8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393113}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1c08c320-55ed-59e1-87a0-c92a722748de" :question/math-academy-id "q-71233" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}2{t}^{3}-3 \\\\ {t}^{2}+1 \\\\ 4t-7\\end{aligned}]$ and $u(t)={e}^{t}.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3) \\\\ \\frac{\\text{d}}{\\text{d}t}({t}^{2}+1) \\\\ \\frac{\\text{d}}{\\text{d}t}(4t-7)\\end{aligned}]=[\\begin{aligned}6{t}^{2} \\\\ 2t \\\\ 4\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & ={e}^{t}[\\begin{aligned}2{t}^{3}-3 \\\\ {t}^{2}+1 \\\\ 4t-7\\end{aligned}]+{e}^{t}[\\begin{aligned}6{t}^{2} \\\\ 2t \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}(2{t}^{3}-3){e}^{t} \\\\ ({t}^{2}+1){e}^{t} \\\\ (4t-7){e}^{t}\\end{aligned}]+[\\begin{aligned}6{t}^{2}{e}^{t} \\\\ 2t{e}^{t} \\\\ 4{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]\\end{aligned}\n$$"}] :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"}] [{:db/id #edb/ref 17592186115392 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114972 :question/id #uuid "cbb15346-028c-59c0-9b20-cd2f408c3bcb" :question/math-academy-id "e-2479" :question/problem "Find $(\\mathbf f \\circ u)'(t),$ if $\\mathbf f(u) = \\ln u \\, \\mathbf i + (u^2+5) \\, \\mathbf j + 4u \\, \\mathbf k$ and $u(t) =2t^3.$" :question/worked-solution "By the chain rule, we have \n\n$$\n(\\mathbf f \\circ u)'(t) = \\mathbf{f}'(u(t)) u'(t).\n$$\n\nNow, let's find the derivative of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\,i+\\frac{\\text{d}}{\\text{d}u}({u}^{2}+5)\\,j+\\frac{\\text{d}}{\\text{d}u}(4u)k \\\\  & =\\frac{1}{u}\\,i+2u\\,j+4\\,k, \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})=6{t}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =(\\frac{1}{u(t)}\\,i+2u(t)\\,j+4\\,k){u}^{′}(t) \\\\  & =(\\frac{1}{2{t}^{3}}\\,i+2(2{t}^{3})\\,j+4\\,k)\\cdot 6{t}^{2} \\\\  & =\\frac{3}{t}\\,i+24{t}^{5}\\,j+24{t}^{2}\\,k.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282" :knowledge-point/questions [{:db/id #edb/ref 17592186115767 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041da615-473a-59b3-bd74-078cc5cac382" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186299946} {:answer/id #uuid "278a088d-66ff-5fc3-9def-6ae04de020b4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4t+4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186300150} {:answer/id #uuid "67ce37ea-b2ab-5a58-86f8-69d3f8240639" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8t \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186300484} {:answer/id #uuid "ab0ec50a-1d0e-532d-ab8d-7cf840b59340" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 2t \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186300820} {:answer/id #uuid "f2329096-2544-59c2-a74f-b394b5ad02bd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4t+4 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186301157}] :answer-field/correct {:answer/id #uuid "041da615-473a-59b3-bd74-078cc5cac382" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186299946} :answer-field/id #uuid "b1a16360-6703-53e1-9901-03f44bb4aa65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301808}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0fd1def5-bd75-572c-939f-770f964a1db9" :question/math-academy-id "q-32498" :question/problem "If $f(u)=[\\begin{aligned}2u \\\\ {u}^{2} \\\\ 3\\end{aligned}]$ and $u(t)=2t+2$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(2u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}u}(3)\\end{aligned}]=[\\begin{aligned}2 \\\\ 2u \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2t+2)=2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =[\\begin{aligned}2 \\\\ 2u(t) \\\\ 0\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}2 \\\\ 2(2t+2) \\\\ 0\\end{aligned}]\\cdot 2 \\\\  & =[\\begin{aligned}4 \\\\ 8t+8 \\\\ 0\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "889f8013-9633-5472-a777-eca4c5e41e7a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡3{t}^{2}\\,i-6{t}^{2}\\,j" :db/id #edb/ref 17592186303308} {:answer/id #uuid "905a9185-fbd2-5d1d-b551-1887761f23f9" :answer/type {:db/ident :answer.type/math} :answer/value "-3{t}^{2}\\operatorname{sin}⁡{t}^{3}\\,i-6{t}^{5}\\,j" :db/id #edb/ref 17592186303358} {:answer/id #uuid "a284a409-3695-5062-bf15-c301f1626b27" :answer/type {:db/ident :answer.type/math} :answer/value "-2{t}^{2}\\operatorname{sin}⁡{t}^{3}\\,i-2{t}^{5}\\,j" :db/id #edb/ref 17592186303458} {:answer/id #uuid "d627a4e8-bf07-5d84-bdda-4e0a8ab4c680" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡u\\,i-2u\\,j" :db/id #edb/ref 17592186303786} {:answer/id #uuid "fd4b1cc6-899c-5984-bb4f-022c7fed3343" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡{t}^{3}\\,i-6{t}^{3}\\,j" :db/id #edb/ref 17592186304047}] :answer-field/correct {:answer/id #uuid "905a9185-fbd2-5d1d-b551-1887761f23f9" :answer/type {:db/ident :answer.type/math} :answer/value "-3{t}^{2}\\operatorname{sin}⁡{t}^{3}\\,i-6{t}^{5}\\,j" :db/id #edb/ref 17592186303358} :answer-field/id #uuid "1317e8fd-c944-52dc-90c8-a38a479a2646" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304116}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d41b7e5-385e-5e64-81bc-3cb7a2474527" :question/math-academy-id "q-32866" :question/problem "If $f(t)=\\operatorname{cos}⁡u\\,i+(1-{u}^{2})\\,j+12\\,k$ and $u(t)={t}^{3}$ then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u)\\,i+\\frac{\\text{d}}{\\text{d}u}(1-{u}^{2})\\,j+\\frac{\\text{d}}{\\text{d}u}(12)\\,k \\\\  & =-\\operatorname{sin}⁡u\\,i-2u\\,j+0\\,k \\\\  & =-\\operatorname{sin}⁡u\\,i-2u\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})=3{t}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t))\\cdot {u}^{′}(t) \\\\  & =(-\\operatorname{sin}⁡(u(t))\\,i-2(u(t))\\,j)\\cdot {u}^{′}(t) \\\\  & =(-\\operatorname{sin}⁡({t}^{3})\\,i-2({t}^{3})\\,j)\\cdot 3{t}^{2} \\\\  & =-3{t}^{2}\\operatorname{sin}⁡{t}^{3}\\,i-6{t}^{5}\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d174aa-f9dc-519a-9e06-114c43894f47" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{cos}⁡({t}^{2}),\\,\\frac{1}{{t}^{2}},\\,t{sec}^{2}⁡({t}^{2})⟩" :db/id #edb/ref 17592186260180} {:answer/id #uuid "3661956c-4318-53fc-ab1c-41b76ef2b5bc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{cos}⁡({t}^{2}),\\,\\frac{1}{t},\\,2t⟩" :db/id #edb/ref 17592186260361} {:answer/id #uuid "3e0b2ee6-a1be-5aa4-868f-eda5b7d48d90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2t\\operatorname{sin}⁡({t}^{2}),\\,\\frac{1}{t},\\,2t{cos}^{2}⁡({t}^{2})⟩" :db/id #edb/ref 17592186260421} {:answer/id #uuid "d905812a-aaa1-5520-a293-216f1bd217d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2t\\operatorname{sec}⁡({t}^{2}),\\,\\frac{1}{t},\\,2t\\operatorname{sin}⁡({t}^{2})⟩" :db/id #edb/ref 17592186261788} {:answer/id #uuid "fe28d3f4-7453-5eff-b63a-74f22f763357" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2t\\operatorname{cos}⁡({t}^{2}),\\,\\frac{2}{t},\\,2t{sec}^{2}⁡({t}^{2})⟩" :db/id #edb/ref 17592186262104}] :answer-field/correct {:answer/id #uuid "fe28d3f4-7453-5eff-b63a-74f22f763357" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2t\\operatorname{cos}⁡({t}^{2}),\\,\\frac{2}{t},\\,2t{sec}^{2}⁡({t}^{2})⟩" :db/id #edb/ref 17592186262104} :answer-field/id #uuid "ee0348a2-9e74-50f7-b367-df15c4e87791" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262539}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "00d88c3d-4bf1-50cd-93ca-fa7a07f78778" :question/math-academy-id "q-128563" :question/problem "If $g(u)=⟨\\operatorname{sin}⁡u,\\,\\operatorname{ln}⁡2u,\\,\\operatorname{tan}⁡u⟩$ and $u(t)={t}^{2},$ then $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(g∘u)^{′}(t)=g′(u(t))u′(t).\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{g}^{′}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}(\\operatorname{sin}⁡u),\\,\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡2u),\\,\\frac{\\text{d}}{\\text{d}u}(\\operatorname{tan}⁡u)⟩ \\\\  & =⟨\\operatorname{cos}⁡u,\\,\\frac{1}{u},\\,{sec}^{2}⁡u⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =⟨\\operatorname{cos}⁡(u(t)),\\,\\frac{1}{u(t)},\\,{sec}^{2}⁡(u(t))⟩\\cdot {u}^{′}(t) \\\\  & =⟨\\operatorname{cos}⁡({t}^{2}),\\,\\frac{1}{{t}^{2}},\\,{sec}^{2}⁡({t}^{2})⟩\\cdot 2t \\\\  & =⟨2t\\operatorname{cos}⁡({t}^{2}),\\,\\frac{2}{t},\\,2t{sec}^{2}⁡({t}^{2})⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262924 :question/answer-fields [{:answer-field/choices [{:answer/i