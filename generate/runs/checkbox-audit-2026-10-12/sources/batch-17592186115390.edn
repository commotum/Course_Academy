u}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}u}(6)\\end{aligned}]=[\\begin{aligned}1 \\\\ 2u \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =[\\begin{aligned}1 \\\\ 2u(t) \\\\ 0\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}1 \\\\ 2({e}^{t}) \\\\ 0\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d6a0cfc-1fdb-5a5d-8094-0fa7eb47f049" :answer/type {:db/ident :answer.type/math} :answer/value "2t\\,i+4t\\,j+6t\\,k" :db/id #edb/ref 17592186300585} {:answer/id #uuid "85523c05-e822-5ae2-b93d-18c8dfd83b7a" :answer/type {:db/ident :answer.type/math} :answer/value "4t\\,i+4t\\,j+4t\\,k" :db/id #edb/ref 17592186300628} {:answer/id #uuid "9570fd04-d2da-5722-889f-b628cb28acf6" :answer/type {:db/ident :answer.type/math} :answer/value "4t\\,i+8t\\,j+12t\\,k" :db/id #edb/ref 17592186300711} {:answer/id #uuid "95853092-5e55-5770-9781-01cbd398a49e" :answer/type {:db/ident :answer.type/math} :answer/value "{t}^{2}i+2{t}^{2}\\,j+3{t}^{2}\\,k" :db/id #edb/ref 17592186300713} {:answer/id #uuid "a47237b6-6c15-5c8f-a39e-9bcc3a189feb" :answer/type {:db/ident :answer.type/math} :answer/value "i+2\\,j+3\\,k" :db/id #edb/ref 17592186300789}] :answer-field/correct {:answer/id #uuid "7d6a0cfc-1fdb-5a5d-8094-0fa7eb47f049" :answer/type {:db/ident :answer.type/math} :answer/value "2t\\,i+4t\\,j+6t\\,k" :db/id #edb/ref 17592186300585} :answer-field/id #uuid "68503596-a623-58aa-b2ac-c212d77d484d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301555}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d2dc74e-c392-56dc-bab3-713a1d0cef87" :question/math-academy-id "q-32502" :question/problem "If  $f(u)=u\\,i+2u\\,j+3u\\,k$ and $u(t)={t}^{2}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write \n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nNow, let's find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}u\\,i+\\frac{\\text{d}}{\\text{d}u}2u\\,j+\\frac{\\text{d}}{\\text{d}t}3u\\,k \\\\  & =i+2\\,j+3\\,k \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\  & =2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =(i+2\\,j+3\\,k)2t \\\\  & =2t\\,i+4t\\,j+6t\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016435a7-09df-59ed-8e52-f08535ec47e9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ 2\\operatorname{ln}⁡t\\end{aligned}]" :db/id #edb/ref 17592186302457} {:answer/id #uuid "32d17b7e-35d0-57c3-ba6d-1d89eb61e334" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{aligned}]" :db/id #edb/ref 17592186302768} {:answer/id #uuid "39e3dc14-bd57-5747-9a00-81c2814bbcbd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]" :db/id #edb/ref 17592186302817} {:answer/id #uuid "6f93626f-cc40-5170-9705-d920aff7ec56" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]" :db/id #edb/ref 17592186303139} {:answer/id #uuid "a07903a9-95bb-5a12-97e9-bc7e59ec2065" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}u \\\\ 5 \\\\ 2u\\end{aligned}]" :db/id #edb/ref 17592186303448}] :answer-field/correct {:answer/id #uuid "6f93626f-cc40-5170-9705-d920aff7ec56" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]" :db/id #edb/ref 17592186303139} :answer-field/id #uuid "18f7d124-041e-581f-adbe-c38cf8ebd23e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304138}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8d3c1bb9-bc23-5441-85c4-926900a42dbb" :question/math-academy-id "q-32860" :question/problem "If $g(u)=[\\begin{aligned}\\operatorname{ln}⁡u \\\\ 5 \\\\ {u}^{2}\\end{aligned}]$ and $u(t)=\\operatorname{ln}⁡t$, then  $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{g}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}⁡u \\\\ \\frac{\\text{d}}{\\text{d}u}\\,\\,5\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}u}\\,\\,{u}^{2}\\,\\,\\end{aligned}]=[\\begin{aligned}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)=\\frac{1}{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =[\\begin{aligned}\\frac{1}{u(t)} \\\\ 0 \\\\ 2u(t)\\end{aligned}]{u}^{′}(t) \\\\  & =\\frac{1}{t}[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ 2\\operatorname{ln}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029ffd0e-a808-5dc2-b75a-236b9d62df96" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,-2{e}^{2t}⟩" :db/id #edb/ref 17592186302470} {:answer/id #uuid "3d48b11a-9299-5f42-982a-2d1e1bb0cbae" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{-2t},\\,0,\\,-{e}^{-4t}⟩" :db/id #edb/ref 17592186302838} {:answer/id #uuid "440997d6-7fcd-5bd7-8476-b139f1366f4b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,-2{e}^{-2t}⟩" :db/id #edb/ref 17592186302887} {:answer/id #uuid "6d9318c8-6af1-5310-8e35-7ffb568cb102" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,2{e}^{2t}⟩" :db/id #edb/ref 17592186303126} {:answer/id #uuid "a8c80301-2671-501b-931c-8779d0c7081d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{-2t},\\,0,\\,{e}^{-4t}⟩" :db/id #edb/ref 17592186303496}] :answer-field/correct {:answer/id #uuid "440997d6-7fcd-5bd7-8476-b139f1366f4b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,-2{e}^{-2t}⟩" :db/id #edb/ref 17592186302887} :answer-field/id #uuid "e0b5f082-25b7-5165-91ab-092341e9996d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304687}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "53be4820-056b-50b8-b65a-84c0096afdb4" :question/math-academy-id "q-32869" :question/problem "If $g(u)=⟨\\operatorname{ln}⁡u,\\,0,\\,\\frac{1}{u}⟩$ and $u(t)={e}^{2t}$, then $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(g∘u)^{′}(t)=g′(u(t))u′(t)\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{g}^{′}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}⁡u,\\,\\frac{\\text{d}}{\\text{d}u}0,\\,\\frac{\\text{d}}{\\text{d}u}(\\frac{1}{u})⟩ \\\\  & =⟨\\frac{1}{u},\\,0,\\,-\\frac{1}{{u}^{2}}⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t})=2{e}^{2t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =⟨\\frac{1}{u(t)},\\,0,\\,-\\frac{1}{{u}^{2}(t)}⟩{u}^{′}(t) \\\\  & =2{e}^{2t}⟨\\frac{1}{{e}^{2t}},\\,0,\\,-\\frac{1}{({e}^{2t})^{2}}⟩ \\\\  & =⟨\\frac{2{e}^{2t}}{{e}^{2t}},\\,0,\\,-\\frac{2{e}^{2t}}{{e}^{4t}}⟩ \\\\  & =⟨2,\\,0,\\,-2{e}^{-2t}⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383ec955-af72-5aeb-813c-b7e9c4f5d6b1" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{2t+1}\\,i+2t{e}^{4t}\\,j" :db/id #edb/ref 17592186302802} {:answer/id #uuid "66c922b2-90d5-511b-af8e-8bcfb11c92dd" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{t+1}\\,i+2t{e}^{2t}\\,j" :db/id #edb/ref 17592186303077} {:answer/id #uuid "ef13717f-b212-5a08-aa3b-404f5a84709d" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186303955} {:answer/id #uuid "f38486c3-26cc-5013-9bbc-fc27b9c0dbd0" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{t+1}\\,i+6t{e}^{2t}\\,j" :db/id #edb/ref 17592186303984} {:answer/id #uuid "f827b8fb-15b2-57b4-b157-dc8224f13cb1" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{2{t}^{2}+1}\\,i-8{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186304011}] :answer-field/correct {:answer/id #uuid "ef13717f-b212-5a08-aa3b-404f5a84709d" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186303955} :answer-field/id #uuid "181930e4-89b2-5460-a910-ab0f457c2a21" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304132}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "30bcefa5-8086-5c62-ab2e-eb5b519248a2" :question/math-academy-id "q-33260" :question/problem "If $f(u)={e}^{u+1}\\,i+{e}^{2u}\\,j+\\frac{1}{e}\\,k$ and $u(t)=2{t}^{2}$ then $(f∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}({e}^{u+1})\\,i+\\frac{\\text{d}}{\\text{d}u}({e}^{2u})\\,j+\\frac{\\text{d}}{\\text{d}u}\\frac{1}{e}\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2u}\\,j+0\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2t}\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})=4t\\end{aligned}\n$$\n\n \nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\ (f∘u)^{′}(t) & =({e}^{2{t}^{2}+1}\\,i+2{e}^{4{t}^{2}}\\,j)4t \\\\  & =4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186373118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2353783-74f2-5934-bfba-3023b84ceef4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\operatorname{sin}⁡(4t-3) \\\\ -4\\operatorname{cos}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373120} {:answer/id #uuid "9fe13228-3768-591d-9f6a-24b6e1eb93a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡(4t-3) \\\\ \\operatorname{cos}⁡(4t-3) \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186373121} {:answer/id #uuid "72be2dff-28b8-52fc-9246-55ec88b83a57" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\operatorname{cos}⁡(4t-3) \\\\ -4\\operatorname{sin}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373122} {:answer/id #uuid "61bb40c2-9ecf-585d-b790-f34cbaa9de79" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8\\operatorname{sin}⁡(4t-3) \\\\ 8\\operatorname{cos}⁡(4t-3) \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186373123} {:answer/id #uuid "243cbcf4-b0d8-5b82-ad87-04f8e247276b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{cos}⁡(4t-3) \\\\ -\\operatorname{sin}⁡(4t-3) \\\\ {e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373124}] :answer-field/correct {:answer/id #uuid "72be2dff-28b8-52fc-9246-55ec88b83a57" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\operatorname{cos}⁡(4t-3) \\\\ -4\\operatorname{sin}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373122} :answer-field/id #uuid "91cea048-4a27-504b-b918-c58dbf7788d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373119}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "df22d5ba-b0c3-58b3-a878-bdf0e607174d" :question/math-academy-id "q-71222" :question/problem "If $f(u)=[\\begin{aligned}\\operatorname{sin}⁡u \\\\ \\operatorname{cos}⁡u \\\\ {e}^{u}\\end{aligned}]$ and $u(t)=4t-3,$ then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{sin}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}({e}^{u})\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ -\\operatorname{sin}⁡u \\\\ {e}^{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4t-3)=4\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(u(t)) \\\\ -\\operatorname{sin}⁡(u(t)) \\\\ {e}^{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(4t-3) \\\\ -\\operatorname{sin}⁡(4t-3) \\\\ {e}^{4t-3}\\end{aligned}]\\cdot 4 \\\\  & =[\\begin{aligned}4\\operatorname{cos}⁡(4t-3) \\\\ -4\\operatorname{sin}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32740510-69e4-53a8-9cf8-9c29535d9249" :answer/type {:db/ident :answer.type/math} :answer/value "\\,i-4{e}^{-2t}\\,j-2{e}^{-3t/2}\\,k" :db/id #edb/ref 17592186387903} {:answer/id #uuid "10afedd6-ff7f-51fa-bc1d-464cb204e6b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-{e}^{-2t}\\,j-2{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387904} {:answer/id #uuid "bcb8b86f-001a-5eb1-9ded-dead76cc9891" :answer/type {:db/ident :answer.type/math} :answer/value "\\,i-2{e}^{-t}\\,j-\\frac{1}{4}{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387905} {:answer/id #uuid "ea538a96-8b67-5fc4-ba6a-05f6aa91f674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387906} {:answer/id #uuid "31024369-16ff-579a-acb7-e67065ff9581" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-2{e}^{2t}\\,j-\\frac{1}{2}{e}^{t}\\,k" :db/id #edb/ref 17592186387907}] :answer-field/correct {:answer/id #uuid "ea538a96-8b67-5fc4-ba6a-05f6aa91f674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387906} :answer-field/id #uuid "93216f8a-001b-5ecf-87cd-938ff9643b14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387902}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "629c6742-cb38-552f-bd6e-09f3aee65a84" :question/math-academy-id "q-128561" :question/problem "If $f(u)=\\operatorname{ln}⁡u\\,i+{u}^{2}\\,j+\\sqrt{u}\\,k$ and $u(t)={e}^{-t},$ then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)i+\\frac{\\text{d}}{\\text{d}u}({u}^{2})j+\\frac{\\text{d}}{\\text{d}u}(\\sqrt{u})k \\\\  & =\\frac{1}{u}\\,i+2u\\,j+\\frac{1}{2\\sqrt{u}}\\,k \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{-t})=-{e}^{-t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t))\\cdot {u}^{′}(t) \\\\  & =(\\frac{1}{u(t)}\\,i+2u(t)\\,j+\\frac{1}{2\\sqrt{u(t)}}\\,k)\\cdot {u}^{′}(t) \\\\  & =(\\frac{1}{{e}^{-t}}\\,i+2{e}^{-t}\\,j+\\frac{1}{2\\sqrt{{e}^{-t}}}\\,k)\\cdot (-{e}^{-t}) \\\\  & =({e}^{t}\\,i+2{e}^{-t}\\,j+\\frac{1}{2}{e}^{t/2}\\,k)\\cdot (-{e}^{-t}) \\\\  & =-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6770c6c3-ca44-5901-927f-1f6eb9c2f483" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-\\frac{t}{2+{t}^{2}},0⟩" :db/id #edb/ref 17592186387910} {:answer/id #uuid "d6f467ee-f10f-5e09-b08f-f8641934f5aa" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{{t}^{2}},-\\frac{{t}^{2}}{1+{t}^{2}},0⟩" :db/id #edb/ref 17592186387911} {:answer/id #uuid "375265a8-c029-5e99-9d9a-45d5e93a7d32" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{1}{t+{t}^{2}},0⟩" :db/id #edb/ref 17592186387912} {:answer/id #uuid "78262439-79b2-52fc-a07a-ed5fa9d567e8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{t},-\\frac{1}{t+{t}^{2}},0⟩" :db/id #edb/ref 17592186387913} {:answer/id #uuid "b4369e5c-dffe-55df-9352-d2f0194bfc84" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{t}{1+{t}^{2}},0⟩" :db/id #edb/ref 17592186387914}] :answer-field/correct {:answer/id #uuid "375265a8-c029-5e99-9d9a-45d5e93a7d32" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{1}{t+{t}^{2}},0⟩" :db/id #edb/ref 17592186387912} :answer-field/id #uuid "c8592051-0273-5e7f-9289-65035199769c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387909}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "00ec801b-e22a-5c19-899f-45b6911ab4a7" :question/math-academy-id "q-128570" :question/problem "If $g(u)=⟨\\frac{1}{u},\\,\\operatorname{ln}⁡(u+1),\\,1⟩$ and $u(t)=\\frac{1}{t}$, then $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(g∘u)^{′}(t)=g′(u(t))u′(t).\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{g}^{′}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}(\\frac{1}{u}),\\,\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡(u+1)),\\,\\frac{\\text{d}}{\\text{d}u}(1)⟩ \\\\  & =⟨-\\frac{1}{{u}^{2}},\\,\\frac{1}{u+1},\\,0⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})=-\\frac{1}{{t}^{2}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =⟨-\\frac{1}{(u(t))^{2}},\\,\\frac{1}{u(t)+1},\\,0⟩\\cdot {u}^{′}(t) \\\\  & =⟨-{t}^{2},\\,\\frac{t}{1+t},\\,0⟩\\cdot (-\\frac{1}{{t}^{2}}) \\\\  & =⟨1,-\\frac{1}{t+{t}^{2}},0⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc0818f3-6660-5a5e-b58d-a575762526c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393010} {:answer/id #uuid "ab98f763-293f-5909-a542-20bf9e265d33" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393011} {:answer/id #uuid "fb1b744a-fd28-5436-8fa1-dc99d58a58de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]" :db/id #edb/ref 17592186393012} {:answer/id #uuid "0df38d96-3c28-5876-bdec-12fe8a88731c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡({e}^{2t}) \\\\ {e}^{3t} \\\\ \\frac{1}{{e}^{2t}}\\end{aligned}]" :db/id #edb/ref 17592186393013} {:answer/id #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393014}] :answer-field/correct {:answer/id #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393014} :answer-field/id #uuid "198253e9-b22c-548e-8e45-872ef7aaca94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c43762c8-310f-5f86-a903-48bba629edc4" :question/math-academy-id "q-70695" :question/problem "If $f(u)=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ {u}^{3} \\\\ \\operatorname{ln}⁡u\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$"}] :knowledge-point/title "Using the Chain Rule for Differentiation"}] [{:db/id #edb/ref 17592186115393 :knowledge-point/canonical-example {:db/id #edb/ref 17592186114973 :question/id #uuid "228ae66f-9dad-5e6d-b405-9fbe62ecb7e9" :question/math-academy-id "e-2480" :question/problem "Find $\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\cdot \\mathbf g)(t),$ given the following functions $\\mathbf f(t)$ and $\\mathbf g(t)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(t) & =\\sqrt{t}\\,i+{t}^{2}j \\\\ g(t) & =\\frac{1}{t}i+{e}^{t}j\\end{aligned}\n$$" :question/worked-solution "Using the dot product rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f} \\cdot \\mathbf{g})(t) = \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f}(t)) \\cdot \\mathbf{g}(t) + \\mathbf{f}(t) \\cdot \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{g}(t))\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}f(t) & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =\\frac{1}{2\\sqrt{t}}\\,i+2t\\,j, \\\\ \\frac{\\text{d}}{\\text{d}t}g(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =-\\frac{1}{{t}^{2}}\\,i+{e}^{t}\\,j.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\eqalign{\n\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\cdot \\mathbf g)(t)\n&= \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f}(t)) \\cdot \\mathbf{g}(t) + \\mathbf{f}(t) \\cdot \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{g}(t)) \\[3pt]\n&= \\left(\\dfrac{1}{2\\sqrt{t}} \\,\\mathbf i +2t \\, \\mathbf j \\right) \\cdot \\left(\\dfrac{1}{t} \\,  \\mathbf i + e^t \\,  \\mathbf j \\right) +\n\\left(\\sqrt{t} \\,  \\mathbf i + t^2 \\,  \\mathbf j \\right) \\cdot \\left(-\\dfrac{1}{t^2}  \\, \\mathbf i + e^t \\, \\mathbf j  \\right) \\[3pt]\t\t \n&=\\dfrac{1}{2t\\sqrt{t}}  +2te^t    +  \\left(-\\dfrac{\\sqrt{t}}{t^2}\\right)    + t^2e^t \\[3pt]\n&=\\dfrac{\\sqrt{t}}{2t^2}  -  \\dfrac{\\sqrt{t}}{t^2} +2te^t   + t^2e^t  \\[3pt]\n&= -\\dfrac{\\sqrt{t}}{2t^2} +\\left(2t+t^2\\right)e^t.\n}\n$$"} :knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" :knowledge-point/questions [{:db/id #edb/ref 17592186115762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0582802c-da60-55c8-b827-54e85f4c84ab" :answer/type {:db/ident :answer.type/math} :answer/value "80{t}^{3}+11{t}^{2}+12t+2" :db/id #edb/ref 17592186299957} {:answer/id #uuid "1b314b6c-c07c-5dd1-84b0-ae7405c80fbf" :answer/type {:db/ident :answer.type/math} :answer/value "80{t}^{3}+6{t}^{2}+10t+2" :db/id #edb/ref 17592186300087} {:answer/id #uuid "5ffe098b-3d9f-5f11-993f-cab4cc8b011e" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{3}+15{t}^{2}+14t+2" :db/id #edb/ref 17592186300454} {:answer/id #uuid "923e3fa5-b372-5604-81b4-5c6bf37d1887" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{3}+7{t}^{2}+10t+2" :db/id #edb/ref 17592186300695} {:answer/id #uuid "e3888121-e3fe-55f8-8939-41b8db9b90ec" :answer/type {:db/ident :answer.type/math} :answer/value "80{t}^{3}+15{t}^{2}+10t+2" :db/id #edb/ref 17592186301095}] :answer-field/correct {:answer/id #uuid "e3888121-e3fe-55f8-8939-41b8db9b90ec" :answer/type {:db/ident :answer.type/math} :answer/value "80{t}^{3}+15{t}^{2}+10t+2" :db/id #edb/ref 17592186301095} :answer-field/id #uuid "e2898930-3fb5-5dee-8009-dea699857dae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301942}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a209f44d-4003-53ab-9d12-642d62514eb3" :question/math-academy-id "q-32298" :question/problem "Find $(f\\cdot g)^{′}(t)$, given that \n\n$$\n\\begin{aligned}f(t) & =20t\\,i-2t\\,j+(2+5t)\\,k \\\\ g(t) & ={t}^{3}\\,i+t\\,j+({t}^{2}+t)\\,k\\end{aligned}\n$$" :question/worked-solution "Using the dot product rule, we can write:\n\n$$\n(f\\cdot g)^{′}(t)={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(20t)\\,i-\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2+5t)\\,k \\\\  & =20\\,i-2\\,j+5\\,k \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\,k \\\\  & =3{t}^{2}\\,i+j+(2t+1)\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f\\cdot g)^{′}(t) & ={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t) \\\\  & =(20\\,i-2\\,j+5\\,k)\\cdot ({t}^{3}\\,i+t\\,j+({t}^{2}+t)\\,k)+(20t\\,i-2t\\,j+(2+5t)\\,k)\\cdot (3{t}^{2}\\,i+j+(2t+1)\\,k) \\\\  & =(20{t}^{3}-2t+5({t}^{2}+t))+(60{t}^{3}-2t+(2+5t)(2t+1)) \\\\  & =80{t}^{3}+15{t}^{2}+10t+2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "875b016f-e8c7-5871-b60a-8140d518ab7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-24t^{3} - 2t - 6 \\\\ 8 - 45t^{2} \\\\ 42t + 20\\end{bmatrix}" :db/id #edb/ref 17592186113551} {:answer/id #uuid "d3cb532f-811d-5a4d-a2ae-e7f634a389c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-42t - 20 \\\\ 8 - 45t^{2} \\\\ 24t^{3} + 2t + 6\\end{bmatrix}" :db/id #edb/ref 17592186113552} {:answer/id #uuid "14263be6-a304-5e5d-b176-0b1171e81f9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}42t + 20 \\\\ 8 - 45t^{2} \\\\ -24t^{3} - 2t - 6\\end{bmatrix}" :db/id #edb/ref 17592186113553} {:answer/id #uuid "2c6e72a8-69da-5220-88ac-e36adeb439a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 - 45t^{2} \\\\ 42t + 20 \\\\ -24t^{3} - 2t - 6\\end{bmatrix}" :db/id #edb/ref 17592186113554} {:answer/id #uuid "686fc5d6-9d73-5924-be7e-292fc0f83dc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21t + 10 \\\\ 45t^{2} \\\\ -24t^{3} - 2t - 6\\end{bmatrix}" :db/id #edb/ref 17592186113555}] :answer-field/id #uuid "18574eab-4e64-5ca8-b34a-644e09dffb17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113550} {:answer-field/choices [{:answer/id #uuid "564ab4d2-73e6-558b-9af0-6f5fdd10eee5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}21t+10 \\\\ 45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390745} {:answer/id #uuid "08d9d97e-52f1-593e-bf6d-177ead5a4e63" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8-45{t}^{2} \\\\ 42t+20 \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390746} {:answer/id #uuid "20623cb8-9b6d-552a-a5b9-c2b26e55fa4e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-42t-20 \\\\ 8-45{t}^{2} \\\\ 24{t}^{3}+2t+6\\end{aligned}]" :db/id #edb/ref 17592186390747} {:answer/id #uuid "e3a88e03-753f-57ff-a632-12697f009654" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-24{t}^{3}-2t-6 \\\\ 8-45{t}^{2} \\\\ 42t+20\\end{aligned}]" :db/id #edb/ref 17592186390748} {:answer/id #uuid "31d0af8e-650c-555d-ad59-94751914d534" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390749}] :answer-field/correct {:answer/id #uuid "31d0af8e-650c-555d-ad59-94751914d534" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390749} :answer-field/id #uuid "e189a085-a70a-5dfd-9709-316634fc8cbc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390744}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "54437c76-a800-5517-9d6f-6a2f64f033aa" :question/math-academy-id "q-32353" :question/problem "Find $(f\\times g)^{′}(t)$ where\n\n$$\nf(t)=[\\begin{aligned}3{t}^{2} \\\\ t+4 \\\\ 8\\end{aligned}],\\,g(t)=[\\begin{aligned}t+2 \\\\ -2{t}^{2} \\\\ 5t\\end{aligned}]\n$$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(t+4) \\\\ \\frac{\\text{d}}{\\text{d}t}(8)\\end{aligned}]=[\\begin{aligned}6t \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {g}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(t+2) \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(5t)\\end{aligned}]=[\\begin{aligned}1 \\\\ -4t \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 6t & 1 & 0 \\\\ t+2 & -2{t}^{2} & 5t\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 \\\\ -2{t}^{2} & 5t\\end{aligned}|i-|\\begin{aligned}6t & 0 \\\\ t+2 & 5t\\end{aligned}|j+|\\begin{aligned}6t & 1 \\\\ t+2 & -2{t}^{2}\\end{aligned}|k \\\\  & =[\\begin{aligned}5t \\\\ -30{t}^{2} \\\\ -12{t}^{3}-t-2\\end{aligned}] \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ 3{t}^{2} & t+4 & 8 \\\\ 1 & -4t & 5\\end{aligned}| \\\\  & =|\\begin{aligned}t+4 & 8 \\\\ -4t & 5\\end{aligned}|i-|\\begin{aligned}3{t}^{2} & 8 \\\\ 1 & 5\\end{aligned}|j+|\\begin{aligned}3{t}^{2} & t+4 \\\\ 1 & -4t\\end{aligned}|k \\\\  & =[\\begin{aligned}37t+20 \\\\ 8-15{t}^{2} \\\\ -12{t}^{3}-t-4\\end{aligned}]\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =[\\begin{aligned}5t \\\\ -30{t}^{2} \\\\ -12{t}^{3}-t-2\\end{aligned}]+[\\begin{aligned}37t+20 \\\\ 8-15{t}^{2} \\\\ -12{t}^{3}-t-4\\end{aligned}]=[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b93f617-87e0-5210-be19-97741891991d" :answer/type {:db/ident :answer.type/math} :answer/value "2⟨\\operatorname{ln}⁡t,\\,3{t}^{2},\\,\\sqrt{t}⟩" :db/id #edb/ref 17592186260262} {:answer/id #uuid "3580541f-830f-598a-a783-88fec72dde5c" :answer/type {:db/ident :answer.type/math} :answer/value "2⟨\\operatorname{ln}⁡t+1,\\,3{t}^{2},\\,2t⟩" :db/id #edb/ref 17592186260354} {:answer/id #uuid "a5a9d477-3e12-5007-82c2-dfea71222f19" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡t+1,\\,t,\\,3t⟩" :db/id #edb/ref 17592186261312} {:answer/id #uuid "af3b5194-5a5b-5ac7-8760-ba017f3228d7" :answer/type {:db/ident :answer.type/math} :answer/value "2⟨\\operatorname{ln}⁡t+1,\\,3t,\\,{t}^{2}⟩" :db/id #edb/ref 17592186261421} {:answer/id #uuid "baf1879f-f001-552d-a8d4-7e78fda261e3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡t,\\,3{t}^{2},\\,{t}^{2}⟩" :db/id #edb/ref 17592186261517}] :answer-field/correct {:answer/id #uuid "3580541f-830f-598a-a783-88fec72dde5c" :answer/type {:db/ident :answer.type/math} :answer/value "2⟨\\operatorname{ln}⁡t+1,\\,3{t}^{2},\\,2t⟩" :db/id #edb/ref 17592186260354} :answer-field/id #uuid "f56a291e-1a05-5ec8-8e7b-40a05867d66d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262550}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "995d1b63-3fd5-54e1-bbec-560efe7ac735" :question/math-academy-id "q-128586" :question/problem "Find $(v(t)f(t))^{′}$ given that  $f(t)=⟨\\operatorname{ln}⁡t,\\,{t}^{2},\\,t⟩$ and $v(t)=2t.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(v(t)f(t))^{′}=v(t){f}^{′}(t)+{v}^{′}(t)f(t).\n$$\n\nLet's find ${v}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨\\frac{1}{t},\\,2t,\\,1⟩ \\\\ {v}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2t)=2\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)f(t))^{′} & =v(t){f}^{′}(t)+{v}^{′}(t)f(t) \\\\  & =2t⟨\\frac{1}{t},\\,2t,\\,1⟩+2⟨\\operatorname{ln}⁡t,\\,{t}^{2},\\,t⟩ \\\\  & =⟨2,\\,4{t}^{2},\\,2t⟩+⟨2\\operatorname{ln}⁡t,\\,2{t}^{2},\\,2t⟩ \\\\  & =2⟨\\operatorname{ln}⁡t+1,\\,3{t}^{2},\\,2t⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c405b6-8e2c-5767-9204-4bdb2fa66d70" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2t,\\,5{t}^{3},\\,9{t}^{4}⟩" :db/id #edb/ref 17592186259956} {:answer/id #uuid "6e532cd0-5a24-5b51-bb5f-bc2c5bfaaba5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{t}^{4},\\,{t}^{3},\\,{t}^{2}⟩" :db/id #edb/ref 17592186260847} {:answer/id #uuid "6fce5174-2553-542e-83df-f8d10e69e544" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2t,\\,5{t}^{4},\\,3{t}^{5}⟩" :db/id #edb/ref 17592186260856} {:answer/id #uuid "9d94ed22-c699-542a-beb8-1d79f82bd0b3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4{t}^{3},\\,5{t}^{2},\\,9{t}^{4}⟩" :db/id #edb/ref 17592186261240} {:answer/id #uuid "bca4179f-3737-54cf-b42b-7f31dd9110b8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4{t}^{3},\\,5{t}^{4},\\,12{t}^{5}⟩" :db/id #edb/ref 17592186261540}] :answer-field/correct {:answer/id #uuid "bca4179f-3737-54cf-b42b-7f31dd9110b8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4{t}^{3},\\,5{t}^{4},\\,12{t}^{5}⟩" :db/id #edb/ref 17592186261540} :answer-field/id #uuid "74146d36-b0eb-5ca0-9527-75ddfa0fc7f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262318}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e2c98f03-8eb1-5c14-ba1a-38fe2722976d" :question/math-academy-id "q-128587" :question/problem "Find  $(u(t)g(t))^{′}$ where $g(t)=⟨t,\\,{t}^{2},\\,2{t}^{3}⟩$ and $u(t)={t}^{3}.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(ug(t))^{′}=u(t){g}^{′}(t)+{u}^{′}(t)g(t).\n$$\n\nLet's find the ${u}^{′}(t)$ and ${g}^{′}(t).$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨1,\\,2t,\\,6{t}^{2}⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})=3{t}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & =u(t){g}^{′}(t)+{u}^{′}(t)g(t) \\\\  & ={t}^{3}⟨1,\\,2t,\\,6{t}^{2}⟩+3{t}^{2}⟨t,\\,{t}^{2},\\,2{t}^{3}⟩ \\\\  & =⟨{t}^{3},\\,2{t}^{4},\\,6{t}^{5}⟩+⟨3{t}^{3},\\,3{t}^{4},\\,6{t}^{5}⟩ \\\\  & =⟨4{t}^{3},\\,5{t}^{4},\\,12{t}^{5}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2f0c39-14ec-595e-a4ae-3b0e0f36d00c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{e}^{t+1},\\,2,\\,4{e}^{3t}⟩" :db/id #edb/ref 17592186260134} {:answer/id #uuid "37f837c5-b882-5c17-be53-31f9d462ba0f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{2t+1},\\,0,\\,-3{e}^{3t}⟩" :db/id #edb/ref 17592186260372} {:answer/id #uuid "7f2ab197-ba6d-56ea-b802-ada707de7359" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{2t+1},\\,-2,\\,2{e}^{3t}⟩" :db/id #edb/ref 17592186260980} {:answer/id #uuid "87cd4c98-ec33-54b2-a15c-b9f4c0dc1eed" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{2t+1},\\,1,\\,2{e}^{3t}⟩" :db/id #edb/ref 17592186261057} {:answer/id #uuid "b3735980-9110-5643-906a-122ec95305f5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{e}^{2t+1},\\,0,\\,3{e}^{3t}⟩" :db/id #edb/ref 17592186261458}] :answer-field/correct {:answer/id #uuid "b3735980-9110-5643-906a-122ec95305f5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{e}^{2t+1},\\,0,\\,3{e}^{3t}⟩" :db/id #edb/ref 17592186261458} :answer-field/id #uuid "0e222c03-3a8a-5590-9dfe-dfec486e1c04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262149}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d768288b-91a5-51ed-b29b-7650008bff18" :question/math-academy-id "q-128894" :question/problem "Find $(v(t)f(t))^{′}$ given that  $f(t)=⟨{e}^{t+1},\\,{e}^{-t},\\,{e}^{2t}⟩$ and $v(t)={e}^{t}.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(v(t)f(t))^{′}=v(t){f}^{′}(t)+{v}^{′}(t)f(t).\n$$\n\nLet's find ${v}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t+1}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{2t})⟩ \\\\  & =⟨{e}^{t+1},\\,-{e}^{-t},\\,2{e}^{2t}⟩ \\\\ {v}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)f(t))^{′} & =v(t){f}^{′}(t)+{v}^{′}(t)f(t) \\\\  & ={e}^{t}⟨{e}^{t+1},\\,-{e}^{-t},\\,2{e}^{2t}⟩+{e}^{t}⟨{e}^{t+1},\\,{e}^{-t},\\,{e}^{2t}⟩ \\\\  & =⟨{e}^{2t+1},\\,-1,\\,2{e}^{3t}⟩+⟨{e}^{2t+1},\\,1,\\,{e}^{3t}⟩ \\\\  & =⟨2{e}^{2t+1},\\,0,\\,3{e}^{3t}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa27233-ccd6-5600-aa83-1e26fdfc1d04" :answer/type {:db/ident :answer.type/math} :answer/value "12{t}^{4}+150{t}^{2}+14" :db/id #edb/ref 17592186300082} {:answer/id #uuid "4659858f-2f59-59af-8140-bdeb6a985b75" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{4}+50{t}^{2}+6" :db/id #edb/ref 17592186300314} {:answer/id #uuid "4dbb3dee-7a8c-53dc-9b4d-450bf35eee82" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{4}+150{t}^{2}+14" :db/id #edb/ref 17592186300366} {:answer/id #uuid "847f2c4d-2f3a-5e6c-b901-f7b8090c71a5" :answer/type {:db/ident :answer.type/math} :answer/value "12{t}^{4}+50{t}^{2}+14" :db/id #edb/ref 17592186300621} {:answer/id #uuid "c35962a3-cffe-5d24-bfef-7b8c30272350" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{4}+150{t}^{2}-10" :db/id #edb/ref 17592186300939}] :answer-field/correct {:answer/id #uuid "4dbb3dee-7a8c-53dc-9b4d-450bf35eee82" :answer/type {:db/ident :answer.type/math} :answer/value "60{t}^{4}+150{t}^{2}+14" :db/id #edb/ref 17592186300366} :answer-field/id #uuid "7edc08bf-eaa3-58b5-8650-9797f1b61df8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301622}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "19486880-810b-5bd6-a22c-f282191bb018" :question/math-academy-id "q-32804" :question/problem "Given $f(t)=2{t}^{3}\\,i-2t\\,j+(1+5{t}^{2})\\,k$, find $({f}^{′}\\cdot f)^{′}(t).$" :question/worked-solution "Using the dot product rule, we can write:\n\n$$\n({f}^{′}\\cdot f)^{′}(t)={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})\\,i-\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(1+5{t}^{2})\\,k \\\\  & =2\\cdot 3{t}^{2}\\,i-2\\,j+5\\cdot 2t\\,k \\\\  & =6{t}^{2}\\,i-2\\,j+10t\\,k \\\\ {f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2})\\,i-\\frac{\\text{d}}{\\text{d}t}(2)\\,j+\\frac{\\text{d}}{\\text{d}t}(10t)\\,k \\\\  & =6\\cdot 2t\\,i+(0)j+(10)\\,k \\\\  & =12t\\,i+10\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}({f}^{′}\\cdot f)^{′}(t) & ={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t) \\\\  & =(12t\\,i+10\\,k)\\cdot (2{t}^{3}\\,i-2t\\,j+(1+5{t}^{2})\\,k)+(6{t}^{2}\\,i-2\\,j+10t\\,k)\\cdot (6{t}^{2}\\,i-2\\,j+10t\\,k) \\\\  & =(12t\\cdot 2{t}^{3}+0\\cdot (-2t)+10\\cdot (1+5{t}^{2}))+((6{t}^{2})^{2}+(-2)^{2}+(10t)^{2}) \\\\  & =24{t}^{4}+0+10+50{t}^{2}+36{t}^{4}+4+100{t}^{2} \\\\  & =60{t}^{4}+150{t}^{2}+14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb30d24-e5fa-5ff3-b793-37ff771c864a" :answer/type {:db/ident :answer.type/math} :answer/value "3{t}^{4}-2{t}^{2}+6t+2" :db/id #edb/ref 17592186300014} {:answer/id #uuid "26a29261-3951-5f05-aa91-50190f871a3b" :answer/type {:db/ident :answer.type/math} :answer/value "15{t}^{4}+6{t}^{2}+2" :db/id #edb/ref 17592186300147} {:answer/id #uuid "54f4bc9d-9659-533f-bcde-0d8203d7cee7" :answer/type {:db/ident :answer.type/math} :answer/value "15{t}^{4}-6t+2" :db/id #edb/ref 17592186300401} {:answer/id #uuid "6c8ad0ce-f737-58e3-9a2a-e7e35fa2da52" :answer/type {:db/ident :answer.type/math} :answer/value "3{t}^{4}+2{t}^{2}-6t+2" :db/id #edb/ref 17592186300509} {:answer/id #uuid "849785f2-76ee-5ce4-8123-ab009fa163a0" :answer/type {:db/ident :answer.type/math} :answer/value "15{t}^{4}+6{t}^{2}-6t+2" :db/id #edb/ref 17592186300624}] :answer-field/correct {:answer/id #uuid "849785f2-76ee-5ce4-8123-ab009fa163a0" :answer/type {:db/ident :answer.type/math} :answer/value "15{t}^{4}+6{t}^{2}-6t+2" :db/id #edb/ref 17592186300624} :answer-field/id #uuid "8d48190f-ac7f-5e0c-a042-b8a82e88e0a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301675}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "38bbc30d-2715-5fd5-8cc3-adae49e8b272" :question/math-academy-id "q-32835" :question/problem "Given $f(t)=⟨{t}^{2}-1\\,,\\,2t\\,,\\,{t}^{3}-1⟩$, find $({f}^{′}\\cdot f)^{′}(t).$" :question/worked-solution "Using the dot product rule, we can write: \n\n$$\n({f}^{′}\\cdot f)^{′}(t)={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)⟩ \\\\  & =⟨2t\\,,\\,2\\,,\\,3{t}^{2}⟩ \\\\ {f}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(2)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨2\\,,\\,0\\,,\\,6t⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}({f}^{′}\\cdot f)^{′}(t) & ={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t) \\\\  & =⟨2\\,,\\,0\\,,\\,6t⟩\\cdot ⟨{t}^{2}-1\\,,\\,2t\\,,\\,{t}^{3}-1⟩+⟨2t\\,,\\,2\\,,\\,3{t}^{2}⟩\\cdot ⟨2t\\,,\\,2\\,,\\,3{t}^{2}⟩ \\\\  & =(2\\cdot ({t}^{2}-1)+0\\cdot (2t)+6t\\cdot ({t}^{3}-1))+((2t)^{2}+{2}^{2}+(3{t}^{2})^{2}) \\\\  & =2{t}^{2}-2+0+6{t}^{4}-6t+4{t}^{2}+4+9{t}^{4} \\\\  & =15{t}^{4}+6{t}^{2}-6t+2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062642b3-def7-5feb-8f41-08b7e4a64ec1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186299962} {:answer/id #uuid "2bd64be2-30aa-5f51-a354-0c648f752da3" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186300175} {:answer/id #uuid "73e23c91-17b0-5276-ba29-6df6883eb88f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186300538} {:answer/id #uuid "c02fe4ca-cc73-5724-8dbb-64c1e0b63d11" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186300925} {:answer/id #uuid "e88569b0-7f63-5ac6-b787-2020ea0b2e1f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186301112}] :answer-field/correct {:answer/id #uuid "73e23c91-17b0-5276-ba29-6df6883eb88f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186300538} :answer-field/id #uuid "d2f006c5-3411-58f0-9d06-d677c36cb1c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301906}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "829808f0-e345-5eeb-99ad-5982ddad6fb7" :question/math-academy-id "q-32837" :question/problem "Given $f(t)=({t}^{3}-1)\\,i+({t}^{2}-2)\\,j+4{t}^{2}\\,k$, evaluate $({f}^{′}\\cdot f)^{′}(0).$" :question/worked-solution "Using the dot product rule, we can write:\n\n$$\n({f}^{′}\\cdot f)^{′}(t)={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-2)\\,j+\\frac{\\text{d}}{\\text{d}t}(4{t}^{2})\\,k \\\\  & =3{t}^{2}\\,i+2t\\,j+4\\cdot 2t\\,k \\\\  & =3{t}^{2}\\,i+2t\\,j+8t\\,k \\\\ {f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(8t)\\,k \\\\  & =3\\cdot 2t\\,i+2j+8\\,k \\\\  & =6t\\,i+2j+8\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}({f}^{′}\\cdot f)^{′}(0) & ={f}^{″}(0)\\cdot f(0)+{f}^{′}(0)\\cdot {f}^{′}(0) \\\\  & =(6(0)\\,i+2\\,j+8\\,k)\\cdot (({0}^{3}-1)\\,i+({0}^{2}-2)\\,j+4(0)^{2}\\,k)+(3(0)^{2}\\,i+2(0)\\,j+8(0)\\,k)\\cdot (3(0)^{2}\\,i+2(0)\\,j+8(0)\\,k) \\\\  & =(2\\,j+8\\,k)\\cdot (-i-2\\,j) \\\\  & =0(-1)+2(-2)+(0) \\\\  & =-4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186308444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b7a747-95ef-5439-8a0d-a5d0bc972bf5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡t+\\frac{2}{{t}^{3}}" :db/id #edb/ref 17592186305178} {:answer/id #uuid "071d818f-582a-511b-8e1a-da0e02e5e527" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡t+1-\\frac{1}{{t}^{3}}" :db/id #edb/ref 17592186305217} {:answer/id #uuid "39c46305-4821-5d35-b86b-257d73a82b77" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡t+1+\\frac{1}{{t}^{3}}" :db/id #edb/ref 17592186305701} {:answer/id #uuid "60474004-6f0b-518e-bd0a-d1fd73598741" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡t+2-\\frac{2}{{t}^{3}}" :db/id #edb/ref 17592186306080} {:answer/id #uuid "79db6f46-1f9b-5903-82ac-d8484423c92c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306313}] :answer-field/correct {:answer/id #uuid "60474004-6f0b-518e-bd0a-d1fd73598741" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡t+2-\\frac{2}{{t}^{3}}" :db/id #edb/ref 17592186306080} :answer-field/id #uuid "d7db7aa7-b12e-53b6-82a4-b2d5f20ca566" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308196}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8a9de11b-dc85-5ae6-9285-a0d6cc055460" :question/math-academy-id "q-33336" :question/problem "Find $(f\\cdot g)^{′}(t)$, given that\n\n$$\n\\begin{aligned}f(t) & =\\operatorname{ln}⁡t\\,i+\\frac{1}{t}\\,j+t\\,k \\\\ g(t) & =t\\,i+\\frac{1}{t}\\,j+\\operatorname{ln}⁡t\\,k\\end{aligned}\n$$" :question/worked-solution "Using the dot product rule, we can write:\n\n$$\n(f\\cdot g)^{′}(t)={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =\\frac{1}{t}\\,i+(-\\frac{1}{{t}^{2}})\\,j+1\\,k \\\\  & =\\frac{1}{t}\\,i-\\frac{1}{{t}^{2}}\\,j+k \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\,k \\\\  & =1\\,i+(-\\frac{1}{{t}^{2}})\\,j+\\frac{1}{t}\\,k \\\\  & =i-\\frac{1}{{t}^{2}}\\,j+\\frac{1}{t}\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f\\cdot g)^{′}(t) & ={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t) \\\\  & =(\\frac{1}{t}\\,i-\\frac{1}{{t}^{2}}\\,j+k)\\cdot (t\\,i+\\frac{1}{t}\\,j+\\operatorname{ln}⁡t\\,k)+(\\operatorname{ln}⁡t\\,i+\\frac{1}{t}\\,j+t\\,k)\\cdot (i-\\frac{1}{{t}^{2}}\\,j+\\frac{1}{t}\\,k) \\\\  & =(\\frac{1}{t}\\cdot t-\\frac{1}{{t}^{2}}\\cdot \\frac{1}{t}+1\\cdot \\operatorname{ln}⁡t)+(\\operatorname{ln}⁡t\\cdot 1+\\frac{1}{t}(-\\frac{1}{{t}^{2}})+t\\cdot \\frac{1}{t}) \\\\  & =1-\\frac{1}{{t}^{3}}+\\operatorname{ln}⁡t+\\operatorname{ln}⁡t-\\frac{1}{{t}^{3}}+1 \\\\  & =2\\operatorname{ln}⁡t+2-\\frac{2}{{t}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186308623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2df4d9e4-5aab-5758-b6bf-f561a4a5bc13" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/id #edb/ref 17592186305590} {:answer/id #uuid "567f9cec-a4ac-5823-9ae9-ff55dac8a4fd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡2,\\,\\operatorname{ln}⁡2,\\,({2}^{2t}-1)\\operatorname{ln}⁡2⟩" :db/id #edb/ref 17592186305989} {:answer/id #uuid "858bfa6f-4a26-5ea8-bf05-c82787e1d16e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,-\\frac{\\operatorname{ln}⁡2}{{2}^{t}},\\,0⟩" :db/id #edb/ref 17592186306424} {:answer/id #uuid "db9b03e9-0749-562a-b299-e3af23995ae5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{2}^{t},\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/id #edb/ref 17592186307187} {:answer/id #uuid "f30b8be4-1b5a-550e-a1eb-f3bf87eff617" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\operatorname{ln}⁡2,\\,-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/id #edb/ref 17592186307392}] :answer-field/correct {:answer/id #uuid "2df4d9e4-5aab-5758-b6bf-f561a4a5bc13" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/id #edb/ref 17592186305590} :answer-field/id #uuid "843487b0-a154-5051-ab18-86349bd94dcd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307936}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "360e7d39-e582-5724-9fad-4481a2f3b45b" :question/math-academy-id "q-33446" :question/problem "Find $(v(t)f(t))^{′}$ given that  $f(t)=⟨{2}^{t},\\,{2}^{t+1},\\,{2}^{2t}+1⟩$ and $v(t)=\\frac{1}{{2}^{t}}.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(v(t)f(t))^{′}=v(t){f}^{′}(t)+{v}^{′}(t)f(t)\n$$\n\nLet's find ${v}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({2}^{t+1}),\\,\\frac{\\text{d}}{\\text{d}t}({2}^{2t}+1)⟩ \\\\  & =⟨{2}^{t}\\operatorname{ln}⁡2,\\,{2}^{t+1}\\operatorname{ln}⁡2,\\,2\\cdot {2}^{2t}\\operatorname{ln}⁡2⟩ \\\\ {v}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{2}^{t}})=-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)f(t))^{′} & =v(t){f}^{′}(t)+{v}^{′}(t)f(t) \\\\  & =\\frac{1}{{2}^{t}}⟨{2}^{t}\\operatorname{ln}⁡2,\\,{2}^{t+1}\\operatorname{ln}⁡2,\\,2\\cdot {2}^{2t}\\operatorname{ln}⁡2⟩-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}⟨{2}^{t},\\,{2}^{t+1},\\,{2}^{2t}+1⟩ \\\\  & =⟨\\frac{{2}^{t}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{{2}^{t+1}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{2\\cdot {2}^{2t}\\operatorname{ln}⁡2}{{2}^{t}}⟩-⟨\\frac{{2}^{t}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{{2}^{t+1}2\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{({2}^{2t}+1)\\operatorname{ln}⁡2}{{2}^{t}}⟩ \\\\  & =⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ec8602-0288-50f5-9393-d24f3e9978eb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5{t}^{6},\\,{t}^{5}+4{t}^{2},\\,4{t}^{3}⟩" :db/id #edb/ref 17592186387973} {:answer/id #uuid "059c4a79-58ba-5ab8-812b-f1ffa1abcd8b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{t}^{6}-5,\\,4{t}^{5}+2t,\\,4{t}^{3}-10t⟩" :db/id #edb/ref 17592186387974} {:answer/id #uuid "22face6d-6d51-591d-a1b9-744a0e476e64" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{t}^{6}+1,\\,4{t}^{5},\\,{t}^{3}-5t⟩" :db/id #edb/ref 17592186387975} {:answer/id #uuid "8428706c-8f90-591b-9287-63282825708a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-7{t}^{6}+5,\\,6{t}^{5}-2t,\\,4{t}^{3}-10t⟩" :db/id #edb/ref 17592186387976} {:answer/id #uuid "5eb7b979-4cab-5af0-b6ed-092b5e887c5a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7{t}^{6},\\,6{t}^{5}-5,\\,4{t}^{3}+2t⟩" :db/id #edb/ref 17592186387977}] :answer-field/correct {:answer/id #uuid "8428706c-8f90-591b-9287-63282825708a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-7{t}^{6}+5,\\,6{t}^{5}-2t,\\,4{t}^{3}-10t⟩" :db/id #edb/ref 17592186387976} :answer-field/id #uuid "658bfb28-3b3a-5fa6-937f-fc8138b0b72f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387972}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c21f1368-688b-50ed-bde8-7422d801bdbd" :question/math-academy-id "q-128896" :question/problem "Find $(f\\times g)^{′}(t)$ given that\n\n$$\n\\begin{aligned}f(t) & =⟨t,\\,5,\\,{t}^{4}⟩, \\\\ g(t) & =⟨{t}^{2},\\,{t}^{3},\\,t⟩.\\end{aligned}\n$$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(5),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{4})⟩ \\\\  & =⟨1,\\,0,\\,4{t}^{3}⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨2t,\\,3{t}^{2},\\,1⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 4{t}^{3} \\\\ {t}^{2} & {t}^{3} & t\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 4{t}^{3} \\\\ {t}^{3} & t\\end{aligned}|i-|\\begin{aligned}1 & 4{t}^{3} \\\\ {t}^{2} & t\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ {t}^{2} & {t}^{3}\\end{aligned}|k \\\\  & =⟨-4{t}^{6},\\,4{t}^{5}-t,\\,{t}^{3}⟩, \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ t & 5 & {t}^{4} \\\\ 2t & 3{t}^{2} & 1\\end{aligned}| \\\\  & =|\\begin{aligned}5 & {t}^{4} \\\\ 3{t}^{2} & 1\\end{aligned}|i-|\\begin{aligned}t & {t}^{4} \\\\ 2t & 1\\end{aligned}|j+|\\begin{aligned}t & 5 \\\\ 2t & 3{t}^{2}\\end{aligned}|k \\\\  & =⟨5-3{t}^{6},\\,2{t}^{5}-t,\\,3{t}^{3}-10t⟩.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =⟨-4{t}^{6},\\,4{t}^{5}-t,\\,{t}^{3}⟩+⟨5-3{t}^{6},\\,2{t}^{5}-t,\\,3{t}^{3}-10t⟩ \\\\  & =⟨-7{t}^{6}+5,\\,6{t}^{5}-2t,\\,4{t}^{3}-10t⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f86cd3-7815-52c3-a642-88091b5dca5c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨20t-2,\\,36{t}^{2}+12t,\\,72{t}^{3}⟩" :db/id #edb/ref 17592186390739} {:answer/id #uuid "3f10ad58-86c7-5488-87e8-2405ac572b35" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8t-2,\\,-48{t}^{2}+12t,\\,36{t}^{3}-6⟩" :db/id #edb/ref 17592186390740} {:answer/id #uuid "b218608b-b05e-57e2-a7b7-ae74abf570fe" :answer/type {:db/ident :answer.type/math} :answer/value "⟨48t-2,\\,-362{t}^{2}+12t,\\,6⟩" :db/id #edb/ref 17592186390741} {:answer/id #uuid "a3285904-7a37-5bb0-9e4b-ea28118d456b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩" :db/id #edb/ref 17592186390742} {:answer/id #uuid "df14411c-6285-5ce6-9d91-f5503ce280c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩" :db/id #edb/ref 17592186390743}] :answer-field/correct {:answer/id #uuid "df14411c-6285-5ce6-9d91-f5503ce280c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩" :db/id #edb/ref 17592186390743} :answer-field/id #uuid "be6adfc3-be4a-5dfa-b9ef-e4320cc373e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390738}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5c0ab63c-e0ff-5937-9e2f-94c308127204" :question/math-academy-id "q-32347" :question/problem "Find $(f\\times g)^{′}(t)$ given that\n\n$$\n\\begin{aligned}f(t) & =⟨6{t}^{2},\\,2t,\\,6⟩ \\\\ g(t) & =⟨3,\\,3{t}^{2},\\,4t-1⟩\\end{aligned}\n$$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(6)⟩ \\\\  & =⟨12t,\\,2,\\,0⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(4t-1)⟩ \\\\  & =⟨0,\\,6t,\\,4⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 12t & 2 & 0 \\\\ 3 & 3{t}^{2} & (4t-1)\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ 3{t}^{2} & (4t-1)\\end{aligned}|i-|\\begin{aligned}12t & 0 \\\\ 3 & (4t-1)\\end{aligned}|j+|\\begin{aligned}12t & 2 \\\\ 3 & 3{t}^{2}\\end{aligned}|k \\\\  & =⟨8t-2,\\,12t-48{t}^{2},\\,36{t}^{3}-6⟩ \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ 6{t}^{2} & 2t & 6 \\\\ 0 & 6t & 4\\end{aligned}| \\\\  & =|\\begin{aligned}2t & 6 \\\\ 6t & 4\\end{aligned}|i-|\\begin{aligned}6{t}^{2} & 6 \\\\ 0 & 4\\end{aligned}|j+|\\begin{aligned}6{t}^{2} & 2t \\\\ 0 & 6t\\end{aligned}|k \\\\  & =⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =⟨8t-2,\\,12t-48{t}^{2},\\,36{t}^{3}-6⟩+⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩ \\\\  & =⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5e5d9ac-8a14-5201-9516-829a7b45050d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+8{t}^{3}⟩" :db/id #edb/ref 17592186390800} {:answer/id #uuid "6ea13000-9bcb-54fe-a381-f6223d0bb92f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0\\,,\\,0\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390801} {:answer/id #uuid "37229cb1-9b3d-541c-ad4c-f9ff6d2bee90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390802} {:answer/id #uuid "b7f3c695-f3a3-58d0-9e05-5aa5b210d1ad" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,-2+2t\\,,\\,-6t+8{t}^{3}⟩" :db/id #edb/ref 17592186390803} {:answer/id #uuid "2452df56-9f06-5ed0-821f-9ea53a5fecf0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6+6{t}^{2}\\,,\\,-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390804}] :answer-field/correct {:answer/id #uuid "37229cb1-9b3d-541c-ad4c-f9ff6d2bee90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390802} :answer-field/id #uuid "b00615b6-9721-5844-9bad-568a5f743f33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390799}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d806e973-4767-5c33-a683-2e2483aec09e" :question/math-academy-id "q-32836" :question/problem "Given $f(t)=⟨1-{t}^{2}\\,,\\,1-{t}^{3}\\,,\\,1-t⟩$, find $({f}^{′}\\times f)^{′}(t).$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n({f}^{′}\\times f)^{′}(t)={f}^{″}(t)\\times f(t)+{f}^{′}(t)\\times {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(1-{t}^{3})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(1-t)⟩ \\\\  & =⟨-2t\\,,\\,-3{t}^{2}\\,,\\,-1⟩ \\\\ {f}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(-3{t}^{2})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(-1)⟩ \\\\  & =⟨-2\\,,\\,-6t\\,,\\,0⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{″}(t)\\times f(t) & =|\\begin{aligned}i & j & k \\\\ -2 & -6t & 0 \\\\ 1-{t}^{2} & 1-{t}^{3} & 1-t\\end{aligned}| \\\\  & =|\\begin{aligned}-6t & 0 \\\\ 1-{t}^{3} & 1-t\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ 1-{t}^{2} & 1-t\\end{aligned}|j+|\\begin{aligned}-2 & -6t \\\\ 1-{t}^{2} & 1-{t}^{3}\\end{aligned}|k \\\\  & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩ \\\\ {f}^{′}(t)\\times {f}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ -2t & -3{t}^{2} & -1 \\\\ -2t & -3{t}^{2} & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-3{t}^{2} & -1 \\\\ -3{t}^{2} & -1\\end{aligned}|i-|\\begin{aligned}-2t & -1 \\\\ -2t & -1\\end{aligned}|j+|\\begin{aligned}-2t & -3{t}^{2} \\\\ -2t & -3{t}^{2}\\end{aligned}|k \\\\  & =⟨0\\,,\\,0\\,,\\,0⟩\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}({f}^{′}\\times f)^{′}(t) & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩+⟨0\\,,\\,0\\,,\\,0⟩ \\\\  & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩\\end{aligned}\n$$"}] :knowledge-point/title "Using the Product Rules for Differentiation"}] [{:db/id #edb/ref 17592186119743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119559 :question/id #uuid "98c98a56-ca57-5dc6-9dc4-c40da53806f7" :question/math-academy-id "e-3063" :question/problem "Write down the integral that gives the arc length of the curve  $\\mathbf f (t) = \\langle 3 \\sin t, \\: 2\\sin 2t \\rangle$\nfrom $t =\\dfrac {3\\pi} 2$  to $t = 2\\pi.$\n\n![](images/57/574a16e843a9c81e5fc9ddbbe2c0dc2c308ffcac4991bcbf48c7f45b4871c93b.png)" :question/worked-solution "First, we find $\\mathbf f'(t)$ and $\\|\\mathbf f'(t)\\|\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡2t)⟩ \\\\  & =⟨3\\operatorname{cos}⁡t,\\,4\\operatorname{cos}⁡2t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{(3\\operatorname{cos}⁡t)^{2}+(4\\operatorname{cos}⁡2t)^{2}} \\\\  & =\\sqrt{9{cos}^{2}⁡t+16{cos}^{2}⁡2t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{a}^{b}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }\\sqrt{9{cos}^{2}⁡t+16{cos}^{2}⁡2t}\\,\\text{d}t.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4fc0992a-423e-5023-98d5-9d53c3b77788" :knowledge-point/questions [{:db/id #edb/ref 17592186120272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c60eb52-e275-5f9e-8b64-8f24c6fbbbff" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\sqrt{2\\cos^{2} 2t + 3\\sin^{2} 3t}dt" :db/id #edb/ref 17592186117772} {:answer/id #uuid "5068c443-8395-505c-92d8-71cea0dfc17e" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π}\\sqrt{4\\cos^{2} 2t + 9\\sin^{2} 3t}dt" :db/id #edb/ref 17592186117773} {:answer/id #uuid "748e7d72-d682-5524-af39-e923fed4a5ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π}\\sqrt{4\\sin^{2} 2t + 9\\cos^{2} 3t}dt" :db/id #edb/ref 17592186117774} {:answer/id #uuid "7997a0c6-f7e9-5d98-aedd-32f939d3e168" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\sqrt{2\\sin^{2} 2t + 9\\cos^{2} 3t}dt" :db/id #edb/ref 17592186117775} {:answer/id #uuid "7eb306df-b1bd-5be5-b18b-0285d0ccf69e" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π}\\sqrt{2\\cos^{2} 2t + 9\\sin^{2} 3t}dt" :db/id #edb/ref 17592186117776}] :answer-field/id #uuid "6e0ba63d-f616-5753-b3ec-5ef064c6cb5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117771} {:answer-field/choices [{:answer/id #uuid "fc3dbeb4-85f0-5977-97bc-032932c84bc6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391649} {:answer/id #uuid "769deadf-6f4e-5979-ab29-41e31ac33156" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{4{sin}^{2}⁡2t+9{cos}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391650} {:answer/id #uuid "8acb4dd0-ab7b-50a4-bed8-752a2b64b388" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391651} {:answer/id #uuid "4b968ecc-eb2e-5899-bdd8-779a4c1f182d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{2{cos}^{2}⁡2t+3{sin}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391652} {:answer/id #uuid "0ec6159d-f7de-5b2f-b124-7ba4b0ab6ebc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{2{sin}^{2}⁡2t+9{cos}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391653}] :answer-field/correct {:answer/id #uuid "8acb4dd0-ab7b-50a4-bed8-752a2b64b388" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391651} :answer-field/id #uuid "438187f3-2ea9-5adc-8e76-df9ae09801fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391648}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "994d254c-8dfb-50db-8abf-3c167a677836" :question/math-academy-id "q-33728" :question/problem "![](images/d1/d162245ac19c3ef9ae63d602fb4e188ddfd241a1a604304f6c272c3902ce1e93.png)\n\nWhich integral expression gives the arc length of the curve $g(t)=⟨\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡3t⟩$ from $t=0$ to $t=\\pi ?$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡3t)⟩ \\\\  & =⟨2\\operatorname{cos}⁡2t,\\,-3\\operatorname{sin}⁡3t⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(2\\operatorname{cos}⁡2t)^{2}+(-3\\operatorname{sin}⁡3t)^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi }‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7002bf97-f2f4-584e-9358-9901bcdc36c8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+5}\\,\\text{d}t" :db/id #edb/ref 17592186312858} {:answer/id #uuid "c02b3e07-f8b1-5a36-8107-54957d2ec5d8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{e}^{t}\\sqrt{{t}^{2}+2t+2}\\,\\text{d}t" :db/id #edb/ref 17592186313481} {:answer/id #uuid "db80e8bf-9842-5c6d-bd83-4583ec9425fa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+4}\\,\\text{d}t" :db/id #edb/ref 17592186313702} {:answer/id #uuid "e797d87f-61ea-5692-b189-9f791eb47e1c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+6}\\,\\text{d}t" :db/id #edb/ref 17592186313811} {:answer/id #uuid "f08c0c47-5ca9-5225-ad0d-e2d99574aadd" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{e}^{t}(t+2)\\,\\text{d}t" :db/id #edb/ref 17592186313902}] :answer-field/correct {:answer/id #uuid "e797d87f-61ea-5692-b189-9f791eb47e1c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+6}\\,\\text{d}t" :db/id #edb/ref 17592186313811} :answer-field/id #uuid "bc1df9aa-037a-519b-b947-a899bc624f42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314526}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3bc45ddc-02bd-5a1e-bfa3-f99f90a0c552" :question/math-academy-id "q-33862" :question/problem "Which integral  expression gives the arc length of the curve $f(t)={e}^{t}(\\,i+2\\,j+t\\,k)$ from  $t=1$ to $t=2?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,i+\\frac{\\text{d}}{\\text{d}t}(2{e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(t{e}^{t})\\,k \\\\  & ={e}^{t}\\,i+2{e}^{t}\\,j+(t{e}^{t}+{e}^{t})\\,k \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{({e}^{t})^{2}+(2{e}^{t})^{2}+({e}^{t}(t+1))^{2}} \\\\  & =\\sqrt{{e}^{2t}+4{e}^{2t}+{e}^{2t}({t}^{2}+2t+1)} \\\\  & =\\sqrt{{e}^{2t}(1+4+{t}^{2}+2t+1)} \\\\  & ={e}^{t}\\sqrt{{t}^{2}+2t+6}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+6}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "786fd2f0-0c3d-5b7a-b5bc-a3608fc69fb2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{16{cos}^{2}⁡t+9}\\,\\text{d}t" :db/id #edb/ref 17592186260929} {:answer/id #uuid "91d23bb2-32fb-5fbc-9842-9fb48c39267d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{3{cos}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186261143} {:answer/id #uuid "9501dc4d-d6ab-5f38-966b-90a4a703d054" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{sin}^{2}⁡t+16}\\,\\text{d}t" :db/id #edb/ref 17592186261170} {:answer/id #uuid "dac1fd6a-eb18-58b7-911b-730ac1c804e7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{4{sin}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186261807} {:answer/id #uuid "fe36bad1-4fa4-557e-a374-9f534fc494fa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t" :db/id #edb/ref 17592186262105}] :answer-field/correct {:answer/id #uuid "fe36bad1-4fa4-557e-a374-9f534fc494fa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t" :db/id #edb/ref 17592186262105} :answer-field/id #uuid "f53642b3-fa2e-5032-9340-8b9099d29395" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262549}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1a4d542-8890-5129-a744-baf652c9fc9c" :question/math-academy-id "q-127419" :question/problem "Which integral expression gives the arc length of the curve $f(t)=⟨4\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t,\\,4\\operatorname{sin}⁡t⟩$ from $t=\\frac{\\pi }{6}$ to $t=\\frac{\\pi }{4}?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-4\\operatorname{sin}⁡t,\\,3\\operatorname{cos}⁡t,\\,4\\operatorname{cos}⁡t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(3\\operatorname{cos}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+9{cos}^{2}⁡t+16{cos}^{2}⁡t} \\\\  & =\\sqrt{16({sin}^{2}⁡t+{cos}^{2}⁡t)+9{cos}^{2}⁡t} \\\\  & =\\sqrt{9{cos}^{2}⁡t+16}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{\\pi /6}^{\\pi /4}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "214ab720-6ecf-5a54-bbca-66e11f886130" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186260158} {:answer/id #uuid "491c9a30-b37c-5794-9dfe-c72bf6a272ad" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{2{e}^{t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186260507} {:answer/id #uuid "741301d8-03d2-596d-99cb-dea017a15918" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{{e}^{t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186260889} {:answer/id #uuid "99f9d829-a8f9-5d96-a7b8-f240b15576e0" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{2{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186261210} {:answer/id #uuid "9a64fc13-46c7-54cc-b859-06bfde01dc08" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186261214}] :answer-field/correct {:answer/id #uuid "214ab720-6ecf-5a54-bbca-66e11f886130" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186260158} :answer-field/id #uuid "83cdb749-1449-536c-beab-38d88342a23d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262347}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ae63a631-2f65-575f-9860-3fcf3ba50584" :question/math-academy-id "q-127427" :question/problem "Which integral expression gives the arc length of the curve $f(t)=⟨\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,{e}^{t},\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩$ from $t=-1$ to $t=1?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,{e}^{t},\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+({e}^{t})^{2}+{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{e}^{2t}+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t} \\\\  & =\\sqrt{{e}^{2t}+2({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\sqrt{{e}^{2t}+2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2208ccc5-5934-51e2-b52d-8ff31bed4e36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186312232} {:answer/id #uuid "65d3df9b-2970-5299-ab99-547382b11901" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186312777} {:answer/id #uuid "7ce9c1bd-fb44-5c82-b8e8-5b81f7969c0d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186312977} {:answer/id #uuid "a95d6aed-c1ec-5c63-b9a8-8a0ba8e816ff" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186313302} {:answer/id #uuid "b5c14440-88e2-525d-85e7-2db79078355d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{{cos}^{2}⁡2t-{sin}^{2}⁡2t+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186313388}] :answer-field/correct {:answer/id #uuid "a95d6aed-c1ec-5c63-b9a8-8a0ba8e816ff" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186313302} :answer-field/id #uuid "9762ce0e-0f2a-5c5c-ad7d-6b8b6bc424c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314419}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "732ad1b9-5772-5700-8754-f590c45d555d" :question/math-academy-id "q-33857" :question/problem "Which integral  expression gives the arc length of the curve $f(t)=⟨\\operatorname{sin}⁡2t,\\operatorname{cos}⁡2t,{t}^{2}⟩$\nfrom  $t=0$ to $t=1?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2})⟩ \\\\  & =⟨2\\operatorname{cos}⁡2t,\\,-2\\operatorname{sin}⁡2t,\\,2t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{(2\\operatorname{cos}⁡2t)^{2}+(-2\\operatorname{sin}⁡2t)^{2}+(2t)^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡2t+4{sin}^{2}⁡2t+4{t}^{2}} \\\\  & =\\sqrt{4({cos}^{2}⁡2t+{sin}^{2}⁡2t+{t}^{2})} \\\\  & =2\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{f}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{1}2\\sqrt{1+{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186391631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e513d59-ec4b-56e0-a149-748a6164fa0e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391633} {:answer/id #uuid "5b08fcdf-1c61-56cb-b330-8a9759c8a89e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186391634} {:answer/id #uuid "8210e913-8fc4-50f7-87cd-8fd56787dfec" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{{t}^{2}+2t\\operatorname{sin}⁡2t}\\,\\text{d}t" :db/id #edb/ref 17592186391635} {:answer/id #uuid "d3b489bc-4e90-59af-8076-7c8a1e2ef20d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+2{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391636} {:answer/id #uuid "d1c3feb9-80f0-5263-bb9b-e4994b84169c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391637}] :answer-field/correct {:answer/id #uuid "5e513d59-ec4b-56e0-a149-748a6164fa0e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391633} :answer-field/id #uuid "5ffd0d69-a63d-58b1-a22c-7c7b302f6577" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391632}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "214d5c25-f05c-5b96-87cf-f66e123da8aa" :question/math-academy-id "q-33706" :question/problem "![](images/10/10ee30ddf508bf985e1c3a41491818723b57301412a5514e4a39c3bc13518acd.png)\n\nWhich integral  expression gives the arc length of the curve $g(t)=⟨t\\operatorname{sin}⁡t,2-t\\operatorname{cos}⁡t⟩$\nfrom  $t=0$ to $t=\\pi ?$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2-t\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t,\\,t\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)^{2}+(t\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+2t\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{t}^{2}{cos}^{2}⁡t+{t}^{2}{sin}^{2}⁡t-2t\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L={\\int }_{0}^{\\pi }‖{g}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{\\pi }\\sqrt{1+{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "917fe269-7275-5dbe-8043-5ab73f39f23b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2{sin}^{2}⁡t+{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392886} {:answer/id #uuid "c302b461-16a8-5a13-a604-48e2a5a05708" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{3-{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392887} {:answer/id #uuid "610e92dd-f0e2-5bea-8bb6-5a4d0d844cb8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2+{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392888} {:answer/id #uuid "6f4b7c1f-6178-5bb3-8bfd-e481d21ad116" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2+{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392889} {:answer/id #uuid "c13bb008-eeba-55b4-aec7-73942951b937" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t" :db/id #edb/ref 17592186392890}] :answer-field/correct {:answer/id #uuid "c13bb008-eeba-55b4-aec7-73942951b937" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t" :db/id #edb/ref 17592186392890} :answer-field/id #uuid "e342550d-8ba6-5a84-9cad-9202991768dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392885}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "719d5fba-71fa-5184-acdb-743568f97311" :question/math-academy-id "q-64723" :question/problem "![](images/d4/d42e9c6ed71f06c2dec273a91d3a4cfbdf5c58095be9370285d7987d38f7b5a6.png)\n\nWhich integral  expression gives the arc length of the curve $h(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j+t\\,k$ from  $t=0$ to $t=2\\pi ?$" :question/worked-solution "First, we find ${h}^{′}(t)$ and $‖{h}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{h}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+1\\,k \\\\ ‖{h}^{′}(t)‖ & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+(1)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2\\pi }‖{h}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b393a27d-b443-5b97-b762-ed6603aad1e1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392893} {:answer/id #uuid "66fa210a-e578-5c4d-8132-eb89718f32cd" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{{t}^{6}+{t}^{4}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392894} {:answer/id #uuid "85f0edfc-dff0-5ee7-a4b2-955898d40c67" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{8{t}^{5}+9{t}^{3}+6}\\,\\text{d}t" :db/id #edb/ref 17592186392895} {:answer/id #uuid "d8531aa7-d3a8-5834-8493-ee803adaa77f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{5}\\sqrt{16{t}^{6}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392896} {:answer/id #uuid "d88974de-cee3-50ec-af8b-a8554a2c05b4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186392897}] :answer-field/correct {:answer/id #uuid "b393a27d-b443-5b97-b762-ed6603aad1e1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392893} :answer-field/id #uuid "0e4f8290-db9f-5614-851c-76e4decb0150" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392892}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "93e74816-9928-5c75-b857-debb8b7d37d0" :question/math-academy-id "q-64724" :question/problem "Which integral expression gives the arc length of the curve $r(t)={t}^{3}\\,i+3t\\,j+{t}^{4}\\,k$ from  $t=2$ to $t=5?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(3t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{4})\\,k \\\\  & =3{t}^{2}\\,i+3\\,j+4{t}^{3}\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(3{t}^{2})^{2}+(3)^{2}+(4{t}^{3})^{2}} \\\\  & =\\sqrt{9{t}^{4}+9+16{t}^{6}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{2}^{5}‖{r}^{′}(t)‖\\,\\text{d}t={\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Curve"}] [{:db/id #edb/ref 17592186119744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119560 :question/id #uuid "8932c22b-465f-5a48-962c-e53730e5ba40" :question/math-academy-id "e-3064" :question/problem "Find the arc length of the curve $\\mathbf g (t) = \\langle 3 - 2 \\sin 2t, \\: 1 - 2\\cos 2t \\rangle$ from $t=\\dfrac \\pi 3$ to $\\pi.$\n\n![](images/29/29c97e5963d451cc389944ef113764b2d15998448e773a02bb98c062207c2860.png)" :question/worked-solution "First, we find $\\mathbf g'(t)$ and $\\|\\mathbf g'(t)\\|\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3-2\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(1-2\\operatorname{cos}⁡2t)⟩ \\\\  & =⟨-4\\operatorname{cos}⁡2t,\\,4\\operatorname{sin}⁡2t⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(-4\\operatorname{cos}⁡2t)^{2}+(4\\operatorname{sin}⁡2t)^{2}} \\\\  & =\\sqrt{16{cos}^{2}⁡2t+16{sin}^{2}⁡2t} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{a}^{b}‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /3}^{\\pi }4\\,\\text{d}t \\\\  & =4t\\,{|}_{\\pi /3}^{\\pi } \\\\  & =4(\\pi -\\frac{\\pi }{3}) \\\\  & =\\frac{8\\pi }{3}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "1e310cbe-9d6b-5bc4-960a-8813333bc8be" :knowledge-point/questions [{:db/id #edb/ref 17592186120527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75e5fa3c-091c-520e-8479-d218155399c2" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186343254} {:answer/id #uuid "8b51d751-2961-50bb-98bc-c99dea65a8e5" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186343452} {:answer/id #uuid "8baa903e-69cf-5fab-bf1d-52f2ba066f34" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186343455} {:answer/id #uuid "c0402a4e-bae1-581e-b109-bffe3d5de024" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186343924} {:answer/id #uuid "deebeadd-1734-5b4a-bc84-8d64bed65493" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186344193}] :answer-field/correct {:answer/id #uuid "8baa903e-69cf-5fab-bf1d-52f2ba066f34" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186343455} :answer-field/id #uuid "e0be3d9a-49eb-5fc8-91bf-4c96b81633a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344886}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d67d847a-8cc9-599e-9782-16c3ef20921d" :question/math-academy-id "q-77065" :question/problem "![](images/b6/b614e2c3e6abf0d7ddb8399aa7ea78b7a0e618a965ee7b5481edf08310a45031.png)\n\nFind the arc length of the curve $g(t)=⟨{t}^{3}-3t,\\,3{t}^{2}⟩$ from $t=1$ to $t=2?$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨3{t}^{2}-3,\\,6t⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(3{t}^{2}-3)^{2}+(6t)^{2}} \\\\  & =\\sqrt{9{t}^{4}-18{t}^{2}+9+36{t}^{2}} \\\\  & =\\sqrt{9{t}^{4}+18{t}^{2}+9} \\\\  & =\\sqrt{(3{t}^{2}+3)^{2}} \\\\  & =3{t}^{2}+3\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}(3{t}^{2}+3)\\,\\text{d}t \\\\  & =({t}^{3}+3t){|}_{1}^{2} \\\\  & =(8+6)-(1+3) \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42dd07b3-4065-530a-88aa-6e7a0aca511d" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186342795} {:answer/id #uuid "78d7838b-fe95-5cad-a4c4-269d7bdb904b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186343282} {:answer/id #uuid "881ebcca-4863-55f5-9890-dcd0a9df648a" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186343415} {:answer/id #uuid "8eab15db-b045-510e-8571-aaaaa67b97ca" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186343486} {:answer/id #uuid "fee32fe0-e17a-5ba1-bc6c-a8f5d62a18d5" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186344482}] :answer-field/correct {:answer/id #uuid "8eab15db-b045-510e-8571-aaaaa67b97ca" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186343486} :answer-field/id #uuid "82eb78e8-3d58-5365-9450-5b95abad2149" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344723}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c0bd5879-0033-526b-bc0b-c6b5d407bf6f" :question/math-academy-id "q-77066" :question/problem "![](images/9b/9b83db0bb11b8e4bbcc4b04b7bf696879d4d7f4732d6aef7d005f9da2b625526.png)\n\nFind the arc length of the curve $g(t)=⟨2{t}^{3/2},\\,3t⟩$ from $t=0$ to $t=3.$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{3/2}),\\,\\frac{\\text{d}}{\\text{d}t}(3t)⟩ \\\\  & =⟨3\\sqrt{t},\\,3⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(3\\sqrt{t})^{2}+{3}^{2}} \\\\  & =\\sqrt{9t+9} \\\\  & =3\\sqrt{t+1}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{3}‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}3\\sqrt{t+1}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}3(t+1)^{1/2}\\,\\text{d}t \\\\  & =2(t+1)^{3/2}{|}_{0}^{3} \\\\  & =16-2 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094b9b5d-90a5-52e6-ad22-1226b75da63c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{e}^{\\pi }-1" :db/id #edb/ref 17592186259958} {:answer/id #uuid "4077f389-0099-57f1-8340-852121cc2cb5" :answer/type {:db/ident :answer.type/math} :answer/value "2({e}^{\\pi }-1)" :db/id #edb/ref 17592186260439} {:answer/id #uuid "6c320932-603e-58a3-a9fc-86f6548e4a8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}({e}^{\\pi /2}-1)" :db/id #edb/ref 17592186260824} {:answer/id #uuid "87a3a0e9-f0fa-50c2-9617-655e6d9e094e" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{\\pi /2}" :db/id #edb/ref 17592186261056} {:answer/id #uuid "f7a2e11f-134c-5105-9358-e819e1684bb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{e}^{\\pi /2}" :db/id #edb/ref 17592186262041}] :answer-field/correct {:answer/id #uuid "6c320932-603e-58a3-a9fc-86f6548e4a8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}({e}^{\\pi /2}-1)" :db/id #edb/ref 17592186260824} :answer-field/id #uuid "d8e0ad00-4b7d-5048-9a17-3b79e4ef2994" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262500}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "76702025-335e-5381-8404-f40fe3fd7dfd" :question/math-academy-id "q-127573" :question/problem "![](images/16/162c0d0310cbbb533c30af373820751fc6c5a447127958486571224d7f8ac07a.png)\n\nFind the arc length of the curve $r(t)=⟨{e}^{t}\\operatorname{cos}⁡t,\\,{e}^{t}\\operatorname{sin}⁡t⟩$ from $t=0$ to $t=\\frac{\\pi }{2}.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨{e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\,{e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)⟩ \\\\  & ={e}^{t}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =|{e}^{t}|\\sqrt{{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}} \\\\  & ={e}^{t}\\sqrt{{cos}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t} \\\\  & ={e}^{t}\\sqrt{2({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\sqrt{2}{e}^{t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2}{e}^{t}\\,\\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}{e}^{t}\\,\\text{d}t \\\\  & =\\sqrt{2}{e}^{t}\\,{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{2}({e}^{\\pi /2}-{e}^{0}) \\\\  & =\\sqrt{2}({e}^{\\pi /2}-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "645b7b78-a1b2-5fca-b90e-39d47899cd92" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260741} {:answer/id #uuid "88e591c2-1771-5bd4-9969-13cd8f27d0ba" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186261066} {:answer/id #uuid "b7f29c98-2b8a-5e10-afa8-61e4c808e5dd" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261488} {:answer/id #uuid "c6d54c34-a83c-514e-812b-09d754b2eef3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186261632} {:answer/id #uuid "ccd06f32-fb58-584a-a752-9e7577253c10" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186261679}] :answer-field/correct {:answer/id #uuid "c6d54c34-a83c-514e-812b-09d754b2eef3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186261632} :answer-field/id #uuid "df607fbe-708b-5c81-8093-49116a0267c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262513}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1f15b24c-9b34-54f4-8404-a1b55cbcfc8d" :question/math-academy-id "q-127585" :question/problem "![](images/c4/c4aa91668440687bbae4b1f85672f5cbaf7ce00d978049c7558eed99b7361d1a.png)\n\nFind the arc length of the curve $r(t)=⟨3t-{t}^{3},\\,3{t}^{2}⟩$ from $t=-1$ to $t=1.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3t-{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨3-3{t}^{2},\\,6t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3-3{t}^{2})}^{2}+{(6t)}^{2}} \\\\  & =\\sqrt{9-18{t}^{2}+9{t}^{4}+36{t}^{2}} \\\\  & =\\sqrt{9{t}^{4}+18{t}^{2}+9} \\\\  & =3\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =3\\sqrt{({t}^{2}+1)^{2}} \\\\  & =3({t}^{2}+1)\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}3({t}^{2}+1)\\,\\text{d}t \\\\  & =3{\\int }_{-1}^{1}({t}^{2}+1)\\,\\text{d}t \\\\  & =3(\\frac{{t}^{3}}{3}+t){|}_{-1}^{1} \\\\  & =3(\\frac{{1}^{3}}{3}+1-[\\frac{(-1)^{3}}{3}+(-1)]) \\\\  & =3(\\frac{1}{3}+1+\\frac{1}{3}+1) \\\\  & =3(\\frac{8}{3}) \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33362404-a630-58e0-ab60-b015a97a07bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186260338} {:answer/id #uuid "8b9f6888-780f-56da-9b96-be6ea61dfe14" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261094} {:answer/id #uuid "b0b610b3-0649-5a84-aede-f6eaefb07746" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186261437} {:answer/id #uuid "d2902a59-e5b1-5475-92d3-40644cd440c0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261727} {:answer/id #uuid "d811aa28-4287-58e1-aa7e-780dedbda6bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}" :db/id #edb/ref 17592186261778}] :answer-field/correct {:answer/id #uuid "d2902a59-e5b1-5475-92d3-40644cd440c0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186261727} :answer-field/id #uuid "a908bb4c-3596-56c3-974f-5d6999f2fa97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262425}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3244e29a-ed4a-595a-8cf3-8bd475ff4af0" :question/math-academy-id "q-127602" :question/problem "![](images/33/33412629fc30584cf4a1726eef7e4f23f623ae4439d25045d61e36f68914dacd.png)\n\nFind the arc length of the curve $r(t)=⟨t,\\,\\frac{1}{3}({t}^{2}+2)^{3/2}⟩$ from $t=-1$ to $t=2.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}({t}^{2}+2)^{3/2})⟩ \\\\  & =⟨1,\\,t\\sqrt{{t}^{2}+2}⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{1}^{2}+{(t\\sqrt{{t}^{2}+2})}^{2}} \\\\  & =\\sqrt{1+{t}^{2}({t}^{2}+2)} \\\\  & =\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =\\sqrt{({t}^{2}+1)^{2}} \\\\  & ={t}^{2}+1\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}({t}^{2}+1)\\text{d}t \\\\  & =(\\frac{{t}^{3}}{3}+t){|}_{-1}^{2} \\\\  & =(\\frac{{2}^{3}}{3}+2)-(\\frac{(-1)^{3}}{3}+(-1)) \\\\  & =\\frac{8}{3}+2+\\frac{1}{3}+1 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025cfcf4-6c89-537a-b8b1-2e525bd5c2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}+{e}^{2}-2" :db/id #edb/ref 17592186342272} {:answer/id #uuid "18941e5d-726d-59b5-9e31-2ef48340a842" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}}{2}" :db/id #edb/ref 17592186342455} {:answer/id #uuid "47398ece-73e5-5c09-a241-0a1c111f3b99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}+1}{2}" :db/id #edb/ref 17592186342828} {:answer/id #uuid "b22dcc61-309a-5bea-8c94-67c83b72f6a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}-1}{2}" :db/id #edb/ref 17592186343803} {:answer/id #uuid "b5dd1c31-05b4-597a-8db3-8c5b0a9b8a55" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186343830}] :answer-field/correct {:answer/id #uuid "47398ece-73e5-5c09-a241-0a1c111f3b99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}+1}{2}" :db/id #edb/ref 17592186342828} :answer-field/id #uuid "9f6d65f0-36c8-5e82-84e3-897a16a6bbcf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344772}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "aec9fc84-c15b-5e80-be71-3437e74d2edf" :question/math-academy-id "q-77068" :question/problem "![](images/54/54cd1a0532bbdbe76bd81d5ad737f6d3e9f5293d08ea78758865b3b71850e346.png)\n\nFind the arc length of the curve $g(t)=⟨\\operatorname{ln}⁡t-\\frac{{t}^{2}}{2},\\,2t⟩$ from $t=1$ to $t=e.$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t-\\frac{{t}^{2}}{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2t)⟩ \\\\  & =⟨\\frac{1}{t}-t,\\,2⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{{(\\frac{1}{t}-t)}^{2}+{2}^{2}} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}-2+{t}^{2}+4} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}+2+{t}^{2}} \\\\  & =\\sqrt{{(\\frac{1}{t}+t)}^{2}} \\\\  & =\\frac{1}{t}+t\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{e}‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{e}(\\frac{1}{t}+t)\\,\\text{d}t \\\\  & =(\\operatorname{ln}⁡t+\\frac{{t}^{2}}{2}){|}_{1}^{e} \\\\  & =(\\operatorname{ln}⁡e+\\frac{{e}^{2}}{2})-(\\operatorname{ln}⁡1+\\frac{{1}^{2}}{2}) \\\\  & =1+\\frac{{e}^{2}}{2}-0-\\frac{1}{2} \\\\  & =\\frac{{e}^{2}+1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "417d6dbd-2ce0-543a-b867-66f46ac5a28b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186342775} {:answer/id #uuid "4af00b12-c488-528b-8d8e-a83c42ba6f9c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186342854} {:answer/id #uuid "6b6338b2-dd43-5df9-9664-ecfbf4ec9d9b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186343153} {:answer/id #uuid "e29b77b4-101f-5781-976e-2efc7b315a07" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186344231} {:answer/id #uuid "f9e5b481-08c2-5c6e-93f4-60c15385b21b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186344435}] :answer-field/correct {:answer/id #uuid "4af00b12-c488-528b-8d8e-a83c42ba6f9c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186342854} :answer-field/id #uuid "f63e4bae-b451-51c9-adf9-3b579789034f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344923}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6edd20b3-8235-5d98-a615-bc507b0983b7" :question/math-academy-id "q-77070" :question/problem "![](images/e6/e6de928031610e2aaf55e3dd753449f766e7dc028a6618087e7489224a73ea7d.png)\n\nFind the arc length of the curve $r(t)=⟨t\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩$\nfrom  $t=0$ to $t=2.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t+\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\,⟩ \\\\  & =⟨t\\operatorname{cos}⁡t,\\,-t\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(t\\operatorname{cos}⁡t)}^{2}+{(-t\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\sqrt{{t}^{2}{sin}^{2}⁡t+{t}^{2}{cos}^{2}⁡t} \\\\  & =\\sqrt{{t}^{2}} \\\\  & =t\\end{aligned}\n$$\n\nNotice that $t\\ge 0$ for $t\\in [0,2].$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}t\\,\\text{d}t \\\\  & ={(\\frac{{t}^{2}}{2})|}_{0}^{2} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a04d171-7f37-5d9d-a2f8-61194e6e93c4" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186342463} {:answer/id #uuid "2dbc28ff-5d76-56ae-8ecf-64a2fdcb3e2b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186342623} {:answer/id #uuid "a4e002a4-bd25-5f07-8e74-c15da484745e" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186343691} {:answer/id #uuid "b2aa47f5-56ab-5309-a1ff-ddb6c0030709" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186343807} {:answer/id #uuid "c97a2a57-f756-5bf4-8ca0-819491201663" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186344007}] :answer-field/correct {:answer/id #uuid "1a04d171-7f37-5d9d-a2f8-61194e6e93c4" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186342463} :answer-field/id #uuid "9bc43f6a-48ec-5f1d-9fa3-8b18c022ec80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344765}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3fbb4ec8-936e-5c4c-830d-f88706e61780" :question/math-academy-id "q-77219" :question/problem "![](images/23/2324d20426a6ef6110714341f256ed3943c66d4068cdb9bd3d1763f8f528f5a1.png)\n\nFind the arc length of the curve $r(t)=⟨6t,-\\frac{3}{t}-{t}^{3}⟩$\nfrom  $t=1$ to $t=3.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(6t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{t}-{t}^{3})⟩ \\\\  & =⟨6,\\,\\frac{3}{{t}^{2}}-3{t}^{2}⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{6}^{2}+{(\\frac{3}{{t}^{2}}-3{t}^{2})}^{2}} \\\\  & =3\\sqrt{{2}^{2}+{(\\frac{1}{{t}^{2}}-{t}^{2})}^{2}} \\\\  & =3\\sqrt{4+\\frac{1}{{t}^{4}}-2+{t}^{4}} \\\\  & =3\\sqrt{\\frac{1}{{t}^{4}}+2+{t}^{4}} \\\\  & =3\\sqrt{{(\\frac{1}{{t}^{2}}+{t}^{2})}^{2}} \\\\  & =3(\\frac{1}{{t}^{2}}+{t}^{2})\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{3}3(\\frac{1}{{t}^{2}}+{t}^{2})\\,\\text{d}t \\\\  & =3{\\int }_{1}^{3}(\\frac{1}{{t}^{2}}+{t}^{2})\\text{d}t \\\\  & =3(-\\frac{1}{t}+\\frac{{t}^{3}}{3}){|}_{1}^{3} \\\\  & =(-\\frac{3}{t}+{t}^{3}){|}_{1}^{3} \\\\  & =(-1+27)-(-3+1) \\\\  & =28\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe2816-aae7-59ca-9562-412dd652a6c7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186342376} {:answer/id #uuid "2bb81157-2ab8-5ec8-a9fa-335547e6606a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186342605} {:answer/id #uuid "519f8d58-aa96-5048-9d82-8885955e1cd1" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186342913} {:answer/id #uuid "5ee0276d-41f4-5591-b923-85e85120cdc9" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186343039} {:answer/id #uuid "988c1583-846c-502f-b92b-7cb927f59f72" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186343579}] :answer-field/correct {:answer/id #uuid "0ffe2816-aae7-59ca-9562-412dd652a6c7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186342376} :answer-field/id #uuid "890c712d-24f5-52cb-9fc0-29be52e23fa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344732}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "707c9a96-8c3c-57b1-ae5a-3037250afe04" :question/math-academy-id "q-77220" :question/problem "![](images/2e/2efa774a3a7e97c23f695cfbdf681b53df055b8a84b84e2729af0a565841aeb7.png)\n\nFind the arc length of the curve $r(t)=⟨\\operatorname{cos}⁡2t+2t\\operatorname{sin}⁡2t,\\,\\operatorname{sin}⁡2t-2t\\operatorname{cos}⁡2t⟩$\nfrom  $t=1$ to $t=2.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t+2t\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t-2t\\operatorname{cos}⁡2t)⟩ \\\\  & =⟨4t\\operatorname{cos}⁡2t\\,,4t\\operatorname{sin}⁡2t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(4t\\operatorname{cos}⁡2t)}^{2}+{(4t\\operatorname{sin}⁡2t)}^{2}} \\\\  & =\\sqrt{16{t}^{2}{cos}^{2}⁡t+16{t}^{2}{sin}^{2}} \\\\  & =\\sqrt{16{t}^{2}} \\\\  & =4t\\end{aligned}\n$$\n\nNotice that $t>0$ for $t\\in [1,2].$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}4t\\,\\text{d}t \\\\  & =2{t}^{2}{|}_{1}^{2} \\\\  & =2(4-1) \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186425876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ed9d04a-f96a-5183-9fc4-8dcfd77061e7" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186425858} {:answer/id #uuid "56a2e6b5-5884-5570-aa94-176a32aa11de" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186425860} {:answer/id #uuid "6e1ffe30-2504-50cd-8a45-20ca6353d983" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186425863} {:answer/id #uuid "9778e0bb-2590-5c24-908d-c9bf4daf3a54" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186425864} {:answer/id #uuid "da2916dc-97c4-51c9-852e-307c5a102816" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186425868}] :answer-field/correct {:answer/id #uuid "da2916dc-97c4-51c9-852e-307c5a102816" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186425868} :answer-field/id #uuid "8c3bd452-520c-5cac-8263-6875362cc4e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425873}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ea583ed-35c3-538b-b597-43518611b1ac" :question/math-academy-id "q-77072" :question/problem "![](images/01/014c2310bcac5b6e9c2be2107bf8a5613b689ff29a8018d2be74fc607dd996db.png)\n\nFind the arc length of the curve $r(t)=⟨7-2{t}^{3},3{t}^{2}+10⟩$\nfrom  $t=0$ to $t=\\sqrt{3}.$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(7-2{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}+10)⟩ \\\\  & =⟨-6{t}^{2},\\,6t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(-6{t}^{2})^{2}+(6t)^{2}} \\\\  & =\\sqrt{36{t}^{4}+36{t}^{2}} \\\\  & =\\sqrt{36{t}^{2}({t}^{2}+1)} \\\\  & =6t\\sqrt{{t}^{2}+1}\\end{aligned}\n$$\n\nNotice that $t\\ge 0$ for $t\\in [0,\\sqrt{3}].$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\sqrt{3}}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{3}}6t\\sqrt{{t}^{2}+1}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u={t}^{2}+1$, $\\text{d}u=2t\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\sqrt{3}}3\\sqrt{{t}^{2}+1}\\cdot 2t\\text{d}t \\\\  & ={\\int }_{1}^{4}3\\sqrt{u}\\,\\text{d}u \\\\  & =3\\cdot \\frac{2}{3}{u}^{3/2}{|}_{1}^{4} \\\\  & =2{u}^{3/2}{|}_{1}^{4} \\\\  & =2(8-1) \\\\  & =14\\end{aligned}\n$$"}] :knowledge-point/title "Computing the Arc Length of a Planar Curve"}] [{:db/id #edb/ref 17592186119771 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119585 :question/id #uuid "fe3edf12-af5b-5bb0-b5b3-efb6cd809134" :question/math-academy-id "e-4394" :question/problem "How can we best describe the following matrix? \n\n![](images/fc/fc2ed708d717844ca73b7ecbfd8467923fad091ae524153350e7e2fb3df1ea4e.png)" :question/worked-solution "Notice that $A$ is a matrix for which all entries above the diagonal are $0$'s:\n![](images/52/5260137f2dbf20b44400659be8467da333ff228e5bff323465f920a9505ee5f2.png)\n\nTherefore, it is a lower triangular matrix.\n\nIt is not an upper triangular matrix or a diagonal matrix since there is a non-zero element below the diagonal: $a_{21}=6 \\neq 0.$"} :knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff" :knowledge-point/questions [{:db/id #edb/ref 17592186120120 :question/answer-fields [{:answer-fiel