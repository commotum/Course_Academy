#edb/ref 17592186236680} {:answer/id #uuid "bb07dd52-f518-54f6-8f86-fe701c1ada44" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi -\\frac{5}{8}" :db/id #edb/ref 17592186237014} {:answer/id #uuid "e2f1e392-4f36-5478-9ad8-f088d40891d5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{8}" :db/id #edb/ref 17592186237242}] :answer-field/correct {:answer/id #uuid "e2f1e392-4f36-5478-9ad8-f088d40891d5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{8}" :db/id #edb/ref 17592186237242} :answer-field/id #uuid "9baaf465-f7d4-5147-8968-33136247a92f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237647}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4d276077-f8d6-5c9d-ba5b-27234154bb37" :question/math-academy-id "q-103242" :question/problem "If $cos⁡x=-\\frac{5}{8},$ then $cos⁡(x+12\\pi )=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=6$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x+2\\cdot 6\\cdot \\pi )=cos⁡(x+12\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=-\\frac{5}{8},$ then $cos⁡(x+12\\pi )=-\\frac{5}{8}.$"} {:db/id #edb/ref 17592186237985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "215fe18b-9f23-5c09-bf88-127529513e0d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186236030} {:answer/id #uuid "706dc48b-2178-5af0-963c-8392b5818616" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186236528} {:answer/id #uuid "852258c8-e623-5916-a3ff-e2ea52c2dac3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}-2\\pi " :db/id #edb/ref 17592186236648} {:answer/id #uuid "dab49c4d-12af-58e7-98db-dab868211f79" :answer/type {:db/iden