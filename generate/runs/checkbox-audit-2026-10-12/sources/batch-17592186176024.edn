\pi }{3}" :db/id #edb/ref 17592186237038}] :answer-field/correct {:answer/id #uuid "046e7856-f1e2-5945-9e7d-0a93df83f4c8" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186235826} :answer-field/id #uuid "d9fe5a2e-ce65-5778-ab3a-31cf0f923ce9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237718}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b38cb050-d54a-5c31-92e4-8df91d886db0" :question/math-academy-id "q-103818" :question/problem "If $\\operatorname{csc}⁡x=3,$ then what is $5\\operatorname{csc}⁡(x+12\\pi )?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=6$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 6\\cdot \\pi )=\\operatorname{csc}⁡(x+12\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=3,$ then $\\operatorname{csc}⁡(x+12\\pi )=3.$\n\nFinally, then\n\n$$\n5\\operatorname{csc}⁡(x+12\\pi )=5\\cdot 3=15.\n$$"} {:db/id #edb/ref 17592186238058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0542c1d6-3728-54b2-b3a1-df0d46ee87d3" :answer/type {:db/ident :answer.type/math} :answer/value "14\\sqrt{5}" :db/id #edb/ref 17592186235835} {:answer/id #uuid "0b969bc4-2614-563a-a866-d0c162cb6031" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi +\\sqrt{5}" :db/id #edb/ref 17592186235878} {:answer/id #uuid "0e532d8e-6d27-5980-ac66-2fdc7efad5ba" :answer/type {:db/ident :answer.type/math} :answer/value "7\\sqrt{5}" :db/id #edb/ref 17592186235893} {:answer/id #uuid "ac6e33a6-cee4-54bd-ac5b-f894bd8dc5ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}\\pi " :db/id #edb/ref 17592186236913} {:answer/id #uuid "ca57c20d-812d-5a15-848b-26c4c659a7c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186237102}] :answer-field/correct {:answer/id #uuid "ca57c20d-812d-5a15-848b-26c4c659a7c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186237102} :answer-field/id #uuid "c0dda148-b9ae-56d7-b3d2-eaf94b4cea53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237685}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "52ab5a05-43c5-5409-b646-b849adccbfdb" :question/math-academy-id "q-103820" :question/problem "If $\\operatorname{csc}⁡x=\\sqrt{5},$ then what is $\\operatorname{csc}⁡(x+14\\pi )?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=7$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 7\\cdot \\pi )=\\operatorname{csc}⁡(x+14\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=\\sqrt{5},$ then $\\operatorname{csc}⁡(x+14\\pi )=\\sqrt{5}.$"} {:db/id #edb/ref 17592186238059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0573c390-2d22-5963-a11d-b89a5ea01981" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186235837} {:answer/id #uuid "5729267a-695b-53dc-a203-2dcf1b185632" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186236370} {:answer/id #uuid "86ea7dfb-4080-5dbc-bd44-f75f681f7a97" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186236658} {:answer/id #uuid "ba20c820-ff56-5f70-80df-435db6fbb48e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186237008} {:answer/id #uuid "c6529e40-6d0d-5635-b1d3-0400fea21e95" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186237073}] :answer-field/correct {:answer/id #uuid "86ea7dfb-4080-5dbc-bd44-f75f681f7a97" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186236658} :answer-field/id #uuid "d6b27ce2-d1cc-5717-9f22-2cb44fddb336" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237716}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11c48f58-20a3-540d-a401-784e0ddc5dea" :question/math-academy-id "q-103822" :question/problem "If $\\operatorname{csc}⁡x=6,$ then what is $\\frac{1}{3}\\operatorname{csc}⁡(x+16\\pi )+5?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=8$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 8\\cdot \\pi )=\\operatorname{csc}⁡(x+16\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=6,$ then $\\operatorname{csc}⁡(x+16\\pi )=6.$\n\nFinally, then\n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{csc}⁡(x+16\\pi )+5 & =\\frac{1}{3}(6)+5 \\\\  & =\\frac{6}{3}+5 \\\\  & =2+5 \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "106237fe-3197-5ac5-9b3a-fa442ee013ef" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333138} {:answer/id #uuid "9ce818a6-b8f5-504d-87b6-360e6e17e9c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186334371} {:answer/id #uuid "ae32d2bb-77f0-51c2-aa46-a10b3f60a63c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186334525} {:answer/id #uuid "b2df05a0-2a5b-5e94-9cb3-c01ea328648b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}+\\pi " :db/id #edb/ref 17592186334560} {:answer/id #uuid "be99bb7d-aa26-552b-9ebb-e92f854399c7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186334639}] :answer-field/correct {:answer/id #uuid "9ce818a6-b8f5-504d-87b6-360e6e17e9c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186334371} :answer-field/id #uuid "65f2ec7d-edc0-5ee9-8e44-7467ec497b7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335436}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eb4ae9f2-b8d5-5ea8-90df-bae5a5d3f761" :question/math-academy-id "q-66605" :question/problem "If $\\operatorname{csc}⁡x=2,$ then what is $\\frac{1}{4}\\operatorname{csc}⁡(x-4\\pi )+2?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-2$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot (-2)\\cdot \\pi )=\\operatorname{csc}⁡(x-4\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=2,$ then $\\operatorname{csc}⁡(x-4\\pi )=2.$\n\nFinally, then\n\n$$\n\\begin{aligned}\\frac{1}{4}\\operatorname{csc}⁡(x-4\\pi )+2 & =\\frac{1}{4}(2)+2 \\\\  & =\\frac{1}{2}+2 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2116cd79-44ea-53c6-889d-f1682fbd66e6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186333285} {:answer/id #uuid "3d232036-8fad-5550-abc3-00107d785ebb" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\pi " :db/id #edb/ref 17592186333565} {:answer/id #uuid "71502cbf-4578-5c31-b861-904cd30b4751" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}+2\\pi " :db/id #edb/ref 17592186334019} {:answer/id #uuid "78d38142-d9f0-58b7-a882-9c15bbb0ea41" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186334072} {:answer/id #uuid "b85f9153-ad14-57e3-93d0-fc16c152374a" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}-1" :db/id #edb/ref 17592186334605}] :answer-field/correct {:answer/id #uuid "b85f9153-ad14-57e3-93d0-fc16c152374a" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}-1" :db/id #edb/ref 17592186334605} :answer-field/id #uuid "48a2344e-da17-5c35-be6d-dd0a9ebe6076" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335380}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f07d7f91-d30a-5dce-8cae-ea7d095128ab" :question/math-academy-id "q-66667" :question/problem "If $\\operatorname{csc}⁡x=\\sqrt{2},$ then what is $5\\operatorname{csc}⁡(x+10\\pi )-1?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 5\\cdot \\pi )=\\operatorname{csc}⁡(x+10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=\\sqrt{2},$ then $\\operatorname{csc}⁡(x+10\\pi )=\\sqrt{2}.$\n\nFinally, then\n\n$$\n5\\operatorname{csc}⁡(x+10\\pi )-1=5\\sqrt{2}-1.\n$$"}] :knowledge-point/title "Utilizing the Periodicity Property of the Cosecant Function"}] [{:db/id #edb/ref 17592186176057 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175703 :question/id #uuid "08253dde-510a-5451-ba5c-64d42d647db2" :question/math-academy-id "e-11012" :question/problem "If $\\cos x = \\dfrac{\\sqrt 3}{4},$ then find the value of $\\cos (-x-6\\pi).$" :question/worked-solution "First, let's recall the graph of $y=\\cos{x}.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\cos{x}$ is $2\\pi.$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\cos{x}$ is an *even* function, and we have\n\n$$\n\\cos(-x) = \\cos{x}.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\cos{x},$ we have\n\n$$\n\\begin{aligned}cos⁡(-x-6\\pi ) & =cos⁡(-x-2\\pi \\cdot 3) \\\\  & =cos⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\cos{x},$ we have\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =\\frac{\\sqrt{3}}{4}.\\end{aligned}\n$$\n\nTherefore, $\\cos (-x-6\\pi)= \\dfrac{\\sqrt 3}{4}.$"} :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/questions [{:db/id #edb/ref 17592186176346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95bf4225-7f2b-533b-b53e-c9b1fee93f68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186267480} {:answer/id #uuid "9832c278-c6fe-5a16-af70-2a5d2cbee4ba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267511} {:answer/id #uuid "ad699b9a-4479-5d4d-a163-8f41699cbfeb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186267711} {:answer/id #uuid "e1ef3bf2-09ff-56a5-a1d9-4ee8d61fd861" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186268141} {:answer/id #uuid "e58c1d7f-af4f-5dd4-b8bb-d3a27371d68e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186268174}] :answer-field/correct {:answer/id #uuid "e58c1d7f-af4f-5dd4-b8bb-d3a27371d68e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186268174} :answer-field/id #uuid "caecf20f-30a6-5b32-b66b-f7b3637a7847" :answer-field/key "selection" :answer-field/type {:db/ident :a