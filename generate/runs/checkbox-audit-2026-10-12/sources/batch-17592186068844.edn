q=-1" :db/id #edb/ref 17592186321196} {:answer/id #uuid "3a24431c-0458-5079-ba01-2125d8265013" :answer/type {:db/ident :answer.type/math} :answer/value "p=-1,\\text{ }q=-2" :db/id #edb/ref 17592186321591} {:answer/id #uuid "87a74df6-aa5b-55d1-9195-ebca010ca76f" :answer/type {:db/ident :answer.type/math} :answer/value "p=-2,\\text{ }q=-1" :db/id #edb/ref 17592186322227} {:answer/id #uuid "87e87cc0-c65e-58b9-830c-9fa8d6110c04" :answer/type {:db/ident :answer.type/math} :answer/value "p=-2,\\text{ }q=1" :db/id #edb/ref 17592186322228} {:answer/id #uuid "c83b2264-9101-5cd8-bf5b-2f9a1b4b64c0" :answer/type {:db/ident :answer.type/math} :answer/value "p=-1,\\text{ }q=2" :db/id #edb/ref 17592186322699}] :answer-field/correct {:answer/id #uuid "05dc7c32-8d37-5398-be0e-018937be178c" :answer/type {:db/ident :answer.type/math} :answer/value "p=-1,\\text{ }q=-1" :db/id #edb/ref 17592186321196} :answer-field/id #uuid "9ba493d1-ab57-5c7e-9730-deee9030cd8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323471}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9f1f3d3-135b-535b-b40c-7f56a71bf933" :question/math-academy-id "q-3662" :question/problem "If the expression ${x}^{2}-2x$ is written as $(x+p{)}^{2}+q$, then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 1x\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${1}^{2}:$ \n\n$$\n{{x}^{2}-2\\cdot 1x+{1}^{2}}_{⏟}-\\,{1}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-1{)}^{2}-{1}^{2}\n$$\n\nFinally, evaluating the last term, we get\n\n$$\n(x-1{)}^{2}-1.\n$$\n\nTherefore, $p=-1$ and $q=-1.$"} {:db/id #edb/ref 17592186400937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d53fe67-7a37-5135-9bda-59dc26da7eba" :answer/type {:db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=10" :db/id #edb/ref 17592186400939} {:answer/id #uuid "9b5c7488-0854-5209-9e72-78867a6a1be6" :answer/type {:db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=5" :db/id #edb/ref 17592186400940} {:answer/id #uuid "a2ec775e-a603-50a4-a821-b02cc8bdf4a2" :answer/type {:db/ident :answer.type/math} :answer/value "p=-10,\\text{ }q=5" :db/id #edb/ref 17592186400941} {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} {:answer/id #uuid "c0e81c67-49e3-5deb-9f3d-4bfdd5f4f433" :answer/type {:db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=-5" :db/id #edb/ref 17592186400943}] :answer-field/correct {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} :answer-field/id #uuid "c559c184-d951-52c2-ae9b-1fd6b5cd4853" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400938}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a81398bc-73ed-504a-b8b3-ef512650d7f6" :question/math-academy-id "q-141622" :question/problem "If the expression ${y}^{2}-10y+30$ is written as $(y+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 5y+30\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $30$ last:\n\n$$\n{{y}^{2}-2\\cdot 5y+{5}^{2}}_{⏟}-\\,{5}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-5{)}^{2}-{5}^{2}+30\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-5{)}^{2}+5.\n$$\n\nTherefore, $p=-5$ and $q=5.$"}] :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] [{:db/id #edb/ref 17592186073752 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073445 :question/id #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" :question/math-academy-id "e-13009" :question/problem "Solve the following system of equations:\n${x - y = 4; x + 2y = 16$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. It doesn't matter which equation we pick first, so we choose the easiest one. In this case, the first equation looks like the easiest.\n\nUsing the first equation, we can isolate $x$ by adding $y$ to both sides of the equation:\n\n$$\n\\begin{aligned}\nx - y &= 4 \\\\\nx &= 4 + y\n\\end{aligned}\n$$\n\nThen, we replace $x$ with $4+y$ in the second equation and solve for $y$:\n\n$$\n\\begin{aligned} x+2y &=16 \\\\ (4+y) + 2y &=16 \\\\ 4+3y &=16 \\\\ 3y &=12 \\\\ y &=4 \\end{aligned}\n$$\n\nIf we now substitute $y=4$ into\n\n$$\nx=4+y\n$$\n\n, then we can find the value of $x$:\n\n$$\n\\begin{aligned} x &= 4 + y \\\\ &= 4 + (4) \\\\ &=8 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x = 8$ and $y = 4$, which can be written as $(8, 4)$."} :knowledge-point/id #uuid "5e79a91b-c479-53da-9f06-59c082fa4187" :knowledge-point/questions [{:db/id #edb/ref 17592186074030 :question/answer-fields [{:answer-field/id #uuid "c3a49164-4f9d-597a-9dc6-abf7860aa4ba" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186070261} {:answer-field/id #uuid "795f6bc6-c4b4-5520-883c-77f20cec08ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186070262}] :question/id #uuid "acc0a44e-6eb6-5a95-a139-3841ec88693b" :question/math-academy-id "q-171690" :question/problem "Consider the following system of equations:\n${x + 5y = 13; y = x + 5$\nFind the solution $(x, y)$ to this system using the method of substitution.The solution is\n$($\n{{field-1}}\n$$,\n{{field-2}}\n$)$"} {:db/id #edb/ref 17592186074172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b643d8b6-388a-54ab-b235-3715b075ca10" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186071271} {:answer/id #uuid "b7ca0af2-c9e2-50b8-aa82-29c811387109" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186071272} {:answer/id #uuid "db6b16f5-5009-56b0-8dbc-feec7e3509af" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186071273} {:answer/id #uuid "4284c760-b4f9-5590-8b60-e0effdb4b5dd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186071274} {:answer/id #uuid "4fbb9be1-44f2-5b9e-84d5-cc040bbae729" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186071275}] :answer-field/id #uuid "4b7102cd-5458-52ab-8b4b-346cb2e5c0d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071270}] :question/id #uuid "963fb1bc-3f29-5c06-94a9-37168b40e1c1" :question/math-academy-id "q-4133" :question/problem "Given the system of equations below, what is the value of $a - b$?\n\n${3a + 2b = 4; - 4a + b = 2$"} {:db/id #edb/ref 17592186074185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "831b8a12-3240-5543-8f0b-63a066174430" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186071349} {:answer/id #uuid "e71abec1-af90-564e-96cc-65f749dff99a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186071350} {:answer/id #uuid "f9bd14c8-f201-5c70-ba77-5489006197a2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186071351} {:answer/id #uuid "30891c0a-e32e-5e99-9826-2629f5f5792b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186071352} {:answer/id #uuid "424e6c76-ef65-55f4-bb2c-05129500785f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186071353}] :answer-field/id #uuid "4ff0f62d-b46f-5fed-abea-e9c339cbff76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186071348}] :question/id #uuid "5c71bd6b-b9a3-5587-89f4-a14a2c760bc2" :question/math-academy-id "q-5179" :question/problem "Given the system of equations below, what is the value of $p - q$?\n\n${3p = 15; p + 2q = 9$"} {:db/id #edb/ref 17592186233560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d447476e-6786-52c0-9a5b-aa6aa6b42f96" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186232246}] :answer-field/correct {:answer/id #uuid "d447476e-6786-52c0-9a5b-aa6aa6b42f96" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186232246} :answer-field/id #uuid "e6f81397-282c-55bf-a574-31b7a7eb6872" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232245} {:answer-field/choices [{:answer/id #uuid "e0d9ee9f-e333-5485-a7ba-ff333f3a6931" :answer/type {:db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186232248}] :answer-field/correct {:answer/id #uuid "e0d9ee9f-e333-5485-a7ba-ff333f3a6931" :answer/type {:db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186232248} :answer-field/id #uuid "e81a89a6-5e45-5c38-944f-815f8eebc873" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232247}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ba03c851-f080-5b98-bcba-fc2174ffc663" :question/math-academy-id "q-167194" :question/problem "The coefficients $a$ and $b$ also satisfy the equation $20b+400a=7\\,200.$ Find the values of $a$ and $b.$\n\n$a\\,=$\n{{field-1}}\n\n$b\\,=$\n{{field-2}}" :question/worked-solution "We have the following system of linear equations:\n\n$$\n{\\begin{aligned}b=480-10a \\\\ 20b+400a=7\\,200\\end{aligned}\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. \n\nNotice that the first equation is already solved for $b:$\n\n$$\nb=480-10a\n$$\n\nSo, we replace $b$ in the second equation and solve for $a:$\n\n$$\n\\begin{aligned}20b+400a & =7\\,200 \\\\ 20(480-10a)+400a & =7\\,200 \\\\ 9\\,600-200a+400a & =7\\,200 \\\\ 9\\,600+200a & =7\\,200 \\\\ 200a & =-2\\,400 \\\\ a & =-12\\end{aligned}\n$$\n\nIf we now substitute $a=-12$ into $b=480-10a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =480-10(-12) \\\\ b & =600\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=-12,\\,b=600.$"} {:db/id #edb/ref 17592186233567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f6ebe2-11a4-50a4-afb6-e54166d6b757" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186232262}] :answer-field/correct {:answer/id #uuid "25f6ebe2-11a4-50a4-afb6-e54166d6b757" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186232262} :answer-field/id #uuid "d89c06a2-d40d-59be-aba2-b51cfcb77eb2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232261} {:answer-field/choices [{:answer/id #uuid "81d5e96b-1699-54bb-87d3-abe3b34a48dc" :answer/type {:db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186232264}] :answer-field/correct {:answer/id #uuid "81d5e96b-1699-54bb-87d3-abe3b34a48dc" :answer/type {:db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186232264} :answer-field/id #uuid "80788b1d-1ccd-5c42-ae32-41ab3f383746" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232263}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d104504e-e7b5-56df-8154-499bbc1d3f80" :question/math-academy-id "q-167210" :question/problem "The coefficients $a$ and $b$ also satisfy the equation $30b+900a=6\\,000.$ Find the values of $a$ and $b.$\n\n$a\\,=$\n{{field-1}}\n\n$b\\,=$\n{{field-2}}" :question/worked-solution "We have the following system of linear equations:\n\n$$\n{\\begin{aligned}b=240-20a \\\\ 30b+900a=6\\,000\\end{aligned}\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. \n\nNotice that the first equation is already solved for $b:$\n\n$$\nb=240-20a\n$$\n\nSo, we replace $b$ in the second equation and solve for $a:$\n\n$$\n\\begin{aligned}30b+900a & =6\\,000 \\\\ 30(240-20a)+900a & =6\\,000 \\\\ 7\\,200-600a+900a & =6\\,000 \\\\ 7\\,200+300a & =6\\,000 \\\\ 300a & =-1\\,200 \\\\ a & =-4\\end{aligned}\n$$\n\nIf we now substitute $a=-4$ into $b=240-20a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =240-20(-4) \\\\ b & =320\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=-4,\\,b=320.$"} {:db/id #edb/ref 17592186233574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74b8ef99-22cc-5e49-9884-ae62824c5059" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186232278}] :answer-field/correct {:answer/id #uuid "74b8ef99-22cc-5e49-9884-ae62824c5059" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186232278} :answer-field/id #uuid "194751b6-0ff6-5047-a6e8-f7e3cfbe1451" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232277} {:answer-field/choices [{:answer/id #uuid "39731897-add5-5068-a83a-649fb0aa6e48" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186232280}] :answer-field/correct {:answer/id #uuid "39731897-add5-5068-a83a-649fb0aa6e48" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186232280} :answer-field/id #uuid "03a21b91-803e-51b3-8b0d-859c1f623d17" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232279}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6afc1799-60d6-5f69-94a5-994731079a93" :question/math-academy-id "q-167226" :question/problem "The coefficients $a$ and $b$ also satisfy the equation $70a+9b=600.$ Find the values of $a$ and $b.$\n\n$a\\,=$\n{{field-1}}\n\n$b\\,=$\n{{field-2}}" :question/worked-solution "We have the following system of linear equations:\n\n$$\n{\\begin{aligned}b=75-5a \\\\ 70a+9b=600\\end{aligned}\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. \n\nNotice that the first equation is already solved for $b:$\n\n$$\nb=75-5a\n$$\n\nSo, we replace $b$ in the second equation and solve for $a:$\n\n$$\n\\begin{aligned}70a+9b & =600 \\\\ 70a+9(75-5a) & =600 \\\\ 70a+675-45a & =600 \\\\ 25a+675 & =600 \\\\ 25a & =-75 \\\\ a & =-3\\end{aligned}\n$$\n\nIf we now substitute $a=-3$ into $b=75-5a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =75-5(-3) \\\\ b & =90\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $a=-3,\\,b=90.$"}] :knowledge-point/title "Solving a System of Linear Equations Using Substitution"}] [{:db/id #edb/ref 17592186073753 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073446 :question/id #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" :question/math-academy-id "e-13010" :question/problem "Solve the following system of equations:\n\n${2u + 9v - 6 = 0; 2u + 6v - 8 = 0$" :question/worked-solution "Sometimes, it's handy to assign a number to each equation in a system, so that we can refer to them more easily:\n\n$$\n{2u + 9v - 6 = 0(1); 2u + 6v - 8 = 0(2)\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $\\color{blue}(2)$, we can solve for $u$ as follows:\n\n$$\n\\begin{aligned} 2u+6v-8 &= 0 \\\\ 2u+6v &= 8 \\\\ 2u &= 8 - 6v \\\\ u &= \\dfrac{8-6v}{2} \\\\ u &= 4 - 3v \\end{aligned}\n$$\n\nThen, we substitute $u=4-3v$ into equation $\\color{red}(1)$ and solve for $v$:\n\n$$\n\\begin{aligned} 2u+9v-6 &= 0 \\\\ 2(4-3v)+9v-6 &= 0 \\\\ 8-6v+9v-6 &= 0 \\\\ 2+3v &= 0 \\\\ 3v &= -2 \\\\ v &= -\\dfrac{2}{3} \\end{aligned}\n$$\n\nIf we now substitute\n\n$$\nv=-\\dfrac{2}{3}\n$$\n\ninto equation $\\color{red}(1)$, then we can find the value of $u$:\n\n$$\n\\begin{aligned} 2u+9v-6 &= 0 \\\\ 2u+9\\left(-\\dfrac{2}{3}\\right) -6 &= 0 \\\\ 2u-6-6 &= 0 \\\\ 2u-12 &= 0 \\\\ 2u &= 12 \\\\ u &= 6 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $u=6$ and\n\n$$\nv=-\\dfrac{2}{3}\n$$\n\n, which can be written as\n\n$$\n\\left(6,-\\dfrac{2}{3}\\right)\n$$"} :knowledge-point/id #uuid "b4352698-7af7-5d74-9c3a-0f951c3e6078" :knowledge-point/questions [{:db/id #edb/ref 17592186073997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a72bb5e1-600c-5bc3-9a20-8a9139d96608" :answer/type {:db/ident :answer.type/math} :answer/value "p = 4, q = 2" :db/id #edb/ref 17592186070068} {:answer/id #uuid "db48f86d-2fc7-507b-bdea-a2a005a0b680" :answer/type {:db/ident :answer.type/math} :answer/value "p = 4, q =-1" :db/id #edb/ref 17592186070069} {:answer/id #uuid "02252a99-76f0-5313-9df0-f9ec9acc8c20" :answer/type {:db/ident :answer.type/math} :answer/value "p = 4, q = 3" :db/id #edb/ref 17592186070070} {:answer/id #uuid "3b9ad275-7db8-59c8-8912-f40f971d2f8f" :answer/type {:db/ident :answer.type/math} :answer/value "p = 3, q = 4" :db/id #edb/ref 17592186070071} {:answer/id #uuid "6285edaa-20b3-59cd-9749-0f49e5e95580" :answer/type {:db/ident :answer.type/math} :answer/value "p =-4, q = 3" :db/id #edb/ref 17592186070072}] :answer-field/id #uuid "76642104-cdd8-5320-bbe7-97e833212d5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186070067}] :question/id #uuid "833a2ed3-b37f-5ade-bd6a-5fdaf64b6506" :question/math-academy-id "q-12444" :question/problem "Using the method of substitution, find the solution of\n${-3p + q =-9; 5p + 4q = 32$."} {:db/id #edb/ref 17592186073998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "840a66d8-a769-5b7d-9b3e-56e75696fb72" :answer/type {:db/ident :answer.type/math} :answer/value "a =-4, b = 4" :db/id #edb/ref 17592186070074} {:answer/id #uuid "885a205a-2ea2-543d-94ad-dd8f41804a39" :answer/type {:db/ident :answer.type/math} :answer/value "a = 3, b =-3" :db/id #edb/ref 17592186070075} {:answer/id #uuid "8b98aa0f-2e3d-5c66-a1e2-83fb7ee036b1" :answer/type {:db/ident :answer.type/math} :answer/value "a = 4, b =-4" :db/id #edb/ref 17592186070076} {:answer/id #uuid "b1e7e93a-adf5-514b-a6ad-8218c526bbc3" :answer/type {:db/ident :answer.type/math} :answer/value "a = 2, b =-2" :db/id #edb/ref 17592186070077} {:answer/id #uuid "1cacef46-ef5e-5b1b-814c-14b3f44ea4fb" :answer/type {:db/ident :answer.type/math} :answer/value "a =-2, b = 2" :db/id #edb/ref 17592186070078}] :answer-field/id #uuid "3f914bec-7e6e-58f8-a49c-484a6a89ef3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186070073}] :question/id #uuid "90bf8b55-699c-5e18-b484-90473cb6a72f" :question/math-academy-id "q-12457" :question/problem "Using the method of substitution, find the solution of\n\n${-7a + 2b = 18; -6a + 6b = 0$"} {:db/id #edb/ref 17592186074047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d90bc-6b5c-5888-a441-c0910faf7b57" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186070290} {:answer/id #uuid "3afa1d5f-dfe6-59bc-8683-638f0716320d" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186070291} {:answer/id #uuid "5b963b53-bada-5f5f-9e14-bb49282b0719" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186070292} {:answer/id #uuid "637fb8f3-b4ed-5b3b-b5dc-ae08c01f9ce3" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186070293} {:answer/id #uuid "71ce6b5e-047a-5e92-8750-073b719123cc" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186070294}] :answer-field/id #uuid "8b1211a7-7190-520c-ac4c-581ede5f3f0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186070289}] :question/id #uuid "a7c18dc6-0363-5db7-9c51-22de1db359fc" :question/math-academy-id "q-18483" :question/problem "Given the system of equations below, what is the value of $p - q$?\n\n${5q + 55 = 0; 2p + 3q + 3 = 0$"}] :knowledge-point/title "Solving a Challenging System of Linear Equations Using Substitution"}] [{:db/id #edb/ref 17592186073776 :knowledge-point/canonical-example {:db/id #edb/ref 17592186073480 :question/id #uuid "f2105fec-c85b-5928-92e6-95ed80f1326c" :question/math-academy-id "e-14009" :question/problem "Show that the following system of equations has no solution.\n\n${4x + 2y = 4; 2x + y = 4$" :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $-2$, then we will get a $-4x$ term that can cancel with the $4x$ term in the first equation:\n\n$$\n{4x + 2y = 4; 2x + y = 4 \\mid \\mid \\cdot (-2)\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n4x + 2y &= 4 \\\\\n- 4x - 2y &= -8 \\\\\n0 &= (4 - 8) \\\\\n0 &= -4\n\\end{aligned}\n$$\n\nThe statement $0=-4$ is *always false*. Therefore, we conclude that the system has *no solutions*.\n\nGeometrically, this means that the corresponding lines *do not intersect*. In other words, they are *parallel.*\n\n![](images/04/048c377f99093f493c37bc4de0363527996c8928348b43ad9c9747965f984c1f.png)"} :knowledge-point/id #uuid "a24fb4f3-6e3c-5c45-b31e-85b7ce290eda" :knowledge-point/questions [{:db/id #edb/ref 17592186074059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a18f1824-3dc6-5be0-ac2f-8dc7d149ea49" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186070311} {:answer/id #uuid "c2a5f92e-26c3-577c-9607-de562db7346c" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186070312} {:answer/id #uuid "64558df4-ad83-5b34-a3b7-63fff9c0d7aa" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186070313}] :answer-field/id #uuid "f25dca02-f19e-5b90-85b6-f363b7822cfc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186070310}] :question/id #uuid "db4ced0c-7aa1-5612-b60c-da9238f3ca28" :question/math-academy-id "q-211984" :question/problem "Consider the following system of equations:\n\n${6x + 4y = 6; - 2x - y = 5$\n\nThis system of equations has {{field-1}}."} {:db/id #edb/ref 17592186074086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e68ea0f6-0c4b-5948-83f5-ff28c2e4168d" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186070367} {:answer/id #uuid "2538c1b9-bfe4-5a49-9a4d-041fb3280dc6" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186070368} {:answer/id #uuid "3052b8bd-d15e-5191-af99-65807ded222d" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186070369}] :answer-field/id #uuid "56f7931c-2301-53d0-aff9-d64e1ec4c799" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186070366}] :question/id #uuid "cc576833-ebf9-5c8f-b749-c0cfe585139d" :question/math-academy-id "q-237043" :question/problem "Consider the following system of equations:\n\n${y - 3x - 2 = 0; 4y - 12x - 8 = 0$\n\nThis system of equations has {{field-1}}."} {:db/id #edb/ref 17592186074087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a63e30c0-cda9-58f0-aaa0-0b5e17e4d7b4" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186070371} {:answer/id #uuid "ebda1ec7-dc47-5ae4-88f3-b0e4338d63a9" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186070372} {:answer/id #uuid "f7cb9713-fa2b-59a2-b51d-c8360c95fceb" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186070373}] :answer-field/id #uuid "59fc212c-55f0-5857-8850-50ee3e15dd2f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186070370}] :question/id #uuid "a43ef3b0-9627-5633-9a33-9830700deff8" :question/math-academy-id "q-237046" :question/problem "Consider the following system of equations:\n\n${2x - 5y = 15; 4x - 10y =-10$\n\nThis system of equations has {{field-1}}."}] :knowledge-point/title "Finding the Number of Solutions to a System"}]}
