lor{purple}{3}}\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x + {\\color{blue}{1}})^2  + 2.\n$$"} :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/questions [{:db/id #edb/ref 17592186069050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ab50fb-0577-520e-8649-ecef0b3f5050" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 6)^{2} + 18" :db/id #edb/ref 17592186065734} {:answer/id #uuid "d623b72f-76cf-56bf-9193-4bfd3d74722e" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 6)^{2} - 21" :db/id #edb/ref 17592186065735} {:answer/id #uuid "ed96bbb5-93d4-5055-be1f-aa7b76ac78d2" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 6)^{2} - 24" :db/id #edb/ref 17592186065736} {:answer/id #uuid "4ff48381-583b-5502-8f1b-44ac2b2cfc89" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 6)^{2} - 15" :db/id #edb/ref 17592186065737} {:answer/id #uuid "51fb8bb4-78de-57f2-90d4-26756509f0b3" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 3)^{2} - 12" :db/id #edb/ref 17592186065738}] :answer-field/id #uuid "89d32665-54a6-5013-9a31-e9b601051c82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065733}] :question/id #uuid "0df043f7-85ab-59e8-b923-cb7889170f30" :question/math-academy-id "q-140221" :question/problem "Complete the square on the quadratic expression $y^{2} + 12y + 15$."} {:db/id #edb/ref 17592186069186 :question/answer-fields [{:answer-field/id #uuid "c13619bc-5da4-58c3-8392-a51654138df3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066329} {:answer-field/id #uuid "64193fcd-9f32-5d02-803f-4dc7d03003ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186066330}] :question/id #uuid "1b8e89c5-8930-56e1-94ae-d8d80995aed2" :question/math-academy-id "q-250390" :questio