\\\\ y & =2(-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(\\sqrt{2},-\\sqrt{2}).$"} {:db/id #edb/ref 17592186284680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359a8b1a-2e90-5221-b6b6-45c8e9ae12e9" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186282165} {:answer/id #uuid "5b3df71b-aee2-5f35-9b12-53d884eac1df" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186282460} {:answer/id #uuid "65df5433-d222-576b-bdee-9211bd3a1f8b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186282563} {:answer/id #uuid "6d834bc3-a336-5730-9fdf-30a9b3c13603" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186282627} {:answer/id #uuid "fba3c6d5-e0fb-5390-90be-e8ccc191e99a" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186283892}] :answer-field/correct {:answer/id #uuid "65df5433-d222-576b-bdee-9211bd3a1f8b" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-2)" :db/id #edb/ref 17592186282563} :answer-field/id #uuid "e0606b74-307e-5421-b86b-2c8a159b55ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284327}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "648c4b24-94b5-5a05-aa36-37a2f263b7f4" :question/math-academy-id "q-17128" :question/problem "Given that the distance from a point $P$ to the origin is $2,$ and that $P$ makes an angle of $\\frac{3\\pi }{2}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=2,\\,\\theta =\\frac{3\\pi }{2}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =2\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =2(-1) \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(0,-2).$"} {:db/id #edb/ref 17592186284681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7d1dc9-08a0-5c97-af85-8958c4f26edc" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-2\\sqrt{3})" :db/id #edb/ref 17592186281972} {:answer/id #uuid "630c3a59-ef83-541f-b9f3-e86f0db79abb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,\\sqrt{3})" :db/id #edb/ref 17592186282540} {:answer/id #uuid "6d760ce6-7b53-5b17-95f0-2a701da851f0" :answer/type {:db/ident :answer.type/math} :answer/value "(2,\\sqrt{3})" :db/id #edb/ref 17592186282625} {:answer/id #uuid "6fda8237-6723-59bd-aa75-aa04c8fefcec" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186282646} {:answer/id #uuid "8297ba5c-921d-5ae0-bd90-2ee58b877b3a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,2\\sqrt{3})" :db/id #edb/ref 17592186282817}] :answer-field/correct {:answer/id #uuid "6fda8237-6723-59bd-aa75-aa04c8fefcec" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186282646} :answer-field/id #uuid "684d27ef-fb36-5be2-9f3b-9d537878d018" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284107}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0cbc4e4b-2d27-5640-8947-f02e086abba5" :question/math-academy-id "q-17134" :question/problem "Given that the distance from a point $P$ to the origin is $4,$ and that $P$ makes an angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=4,\\,\\theta =\\frac{4\\pi }{3}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =4\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\ x & =4(-\\frac{1}{2}) \\\\ x & =-2\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =4\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\ y & =4(-\\frac{\\sqrt{3}}{2}) \\\\ y & =-2\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2,-2\\sqrt{3}).$"} {:db/id #edb/ref 17592186284682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0068e4a5-cb28-5519-9eed-397f1fd495ba" :answer/type {:db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186281690} {:answer/id #uuid "24c5f2d9-5d73-5dfb-8877-22831e9dfcc2" :answer/type {:db/ident :answer.type/math} :answer/value "(7,1)" :db/id #edb/ref 17592186282010} {:answer/id #uuid "2fc39e53-d504-5253-a096-83f4724ee131" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186282113} {:answer/id #uuid "62a281e2-ead9-5741-8c03-34eb83922464" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186282534} {:answer/id #uuid "eba4daee-0b6f-57bd-8eb5-6f8a3b202d40" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,0)" :db/id #edb/ref 17592186283748}] :answer-field/correct {:answer/id #uuid "2fc39e53-d504-5253-a096-83f4724ee131" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186282113} :answer-field/id #uuid "f111caec-f6e3-5cc4-a5b9-929e5f8a60b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284361}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dbe89916-9884-50d0-99bb-1478386ff8b6" :question/math-academy-id "q-17137" :question/problem "Given that the distance from a point $P$ to the origin is $7,$ and that $P$ makes an angle of $0$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=7,\\,\\theta =0.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =7\\operatorname{cos}⁡(0) \\\\ x & =7\\cdot 1 \\\\ x & =7\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =7\\operatorname{sin}⁡(0) \\\\ y & =7\\cdot 0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(7,0).$"} {:db/id #edb/ref 17592186294874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ac03d3b-2532-57c0-b9b4-500023e08f39" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186293241}] :answer-field/correct {:answer/id #uuid "4ac03d3b-2532-57c0-b9b4-500023e08f39" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186293241} :answer-field/id #uuid "5dfdbeb0-5188-55a0-995a-50f79130fd12" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294263} {:answer-field/choices [{:answer/id #uuid "bad2a675-9325-5f9e-98e8-a2644c41a27d" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186293659}] :answer-field/correct {:answer/id #uuid "bad2a675-9325-5f9e-98e8-a2644c41a27d" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186293659} :answer-field/id #uuid "a5869a77-39c9-5092-ba56-1653742daea3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294522}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3bdc99cf-7f58-58bc-8d19-759a3c38b4ba" :question/math-academy-id "q-276786" :question/problem "If the distance from a point $P$ to the origin is $8,$ and that $P$ makes an angle of $\\frac{7\\pi }{4}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=8,\\,\\theta =\\frac{7\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\cdot \\operatorname{cos}⁡(\\frac{7\\pi }{4}) \\\\  & =8\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\cdot \\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =8\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(4\\sqrt{2},-4\\sqrt{2}).$"} {:db/id #edb/ref 17592186294876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8687607-80ff-5873-a6e5-4e7b5b0a8602" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293711}] :answer-field/correct {:answer/id #uuid "c8687607-80ff-5873-a6e5-4e7b5b0a8602" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293711} :answer-field/id #uuid "687ed8c9-f3bb-5447-b65d-0661ab582ddb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294295} {:answer-field/choices [{:answer/id #uuid "9f01dce6-e066-51e9-8e04-c9e737fc1a0f" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186293562}] :answer-field/correct {:answer/id #uuid "9f01dce6-e066-51e9-8e04-c9e737fc1a0f" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186293562} :answer-field/id #uuid "f1e1cb57-225d-5cba-8410-44dfe2c60e0f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294776}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bfa9ea2c-dfab-54c2-ba47-4e82fd54912f" :question/math-academy-id "q-276791" :question/problem "If the distance from a point $P$ to the origin is $12,$ and that $P$ makes an angle of ${60}^{∘}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=12,\\,\\theta ={60}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\cdot \\operatorname{cos}⁡({60}^{∘}) \\\\  & =12\\cdot (\\frac{1}{2}) \\\\  & =6\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\cdot \\operatorname{sin}⁡({60}^{∘}) \\\\  & =12\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =6\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(6,6\\sqrt{3}).$"} {:db/id #edb/ref 17592186294878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76b9b4bb-41ee-5123-9c9a-81ee28b29a2c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186293419}] :answer-field/correct {:answer/id #uuid "76b9b4bb-41ee-5123-9c9a-81ee28b29a2c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186293419} :answer-field/id #uuid "62f664e1-3397-5fc8-8997-d85966d501de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294281} {:answer-field/choices [{:answer/id #uuid "3e8a5a4c-630b-516e-b8e0-968782ed3ec0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186293182}] :answer-field/correct {:answer/id #uuid "3e8a5a4c-630b-516e-b8e0-968782ed3ec0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186293182} :answer-field/id #uuid "9ff41a97-f9b0-5355-aeb2-b3b9a775f59b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294507}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a88a0577-f66a-514f-9dd3-d71688a75644" :question/math-academy-id "q-276798" :question/problem "If the distance from a point $P$ to the origin is $3,$ and that $P$ makes an angle of ${240}^{∘}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=3,\\,\\theta ={240}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\cdot \\operatorname{cos}⁡({240}^{∘}) \\\\  & =3\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\cdot \\operatorname{sin}⁡({240}^{∘}) \\\\  & =3\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{3}{2},-\\frac{3\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186354398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040aa995-2a95-5978-ae2e-5bf3e64df54b" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{3},2\\sqrt{3})" :db/id #edb/ref 17592186351604} {:answer/id #uuid "327eef0b-6d33-56b7-b7fa-65647e6064b0" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{3},4)" :db/id #edb/ref 17592186352034} {:answer/id #uuid "8813249a-4b08-5911-ab6e-9dfd026fab0b" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4\\sqrt{2})" :db/id #edb/ref 17592186352759} {:answer/id #uuid "d6f4b322-8686-56b2-9216-36cb838b3f08" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4)" :db/id #edb/ref 17592186353432} {:answer/id #uuid "dcf46c88-e2c1-5c74-915f-85de76f4b18a" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},8\\sqrt{3})" :db/id #edb/ref 17592186353489}] :answer-field/correct {:answer/id #uuid "d6f4b322-8686-56b2-9216-36cb838b3f08" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4)" :db/id #edb/ref 17592186353432} :answer-field/id #uuid "496d734d-db4b-581d-ac63-001e27aa3e49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353946}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ab581aa-df37-556d-9193-036f42c477b8" :question/math-academy-id "q-8516" :question/problem "Given that the distance from a point $P$ to the origin is $8,$ and that $P$ makes an angle of ${150}^{∘}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=8,\\,\\theta ={150}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡({150}^{∘}) \\\\  & =8(-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡({150}^{∘}) \\\\  & =8\\cdot \\frac{1}{2} \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$"}] :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] [{:db/id #edb/ref 17592186092219 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092061 :question/id #uuid "63b5b1e6-1885-554c-973c-bd78555f44ec" :question/math-academy-id "e-5385" :question/problem "The point $A$ has polar coordinates $\\left(r, \\dfrac{11\\pi}{6} \\right)$ and the point $B$ has polar coordinates $\\left(5r,\\dfrac{5\\pi}{6}\\right).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(3,-\\sqrt{3}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\eqalign{\n\t\tr &= \\sqrt{x^2+y^2}\\[3pt]\n\t\t &=\\sqrt{3^2+(\\sqrt{3})^2}\\[3pt]\n\t\t &= \\sqrt{12} \\[3pt]\n\t\t &= 2\\sqrt{3}\n\t}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n\\left(5(2\\sqrt{3}),\\dfrac{5\\pi}{6}\\right)=\\left(10\\sqrt{3},\\dfrac{5\\pi}{6}\\right).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx = r\\cos\\theta, \\qquad y=r\\sin\\theta.\n$$\n\nFirst, we calculate the $x$-coordinate of $B\\mathbin{:}$\n\n$$\n\\eqalign{\n\t\tx &= r\\cos\\theta\\[5pt]\n\t\t&=10\\sqrt{3} \\cos\\left(\\dfrac{5\\pi}{6} \\right)\\[5pt]\n\t\t&= 10\\sqrt{3} \\left(-\\dfrac{\\sqrt{3}}{2} \\right)\\[5pt]\n\t\t&= -15\n\t}\n$$\n\nThen, we calculate the $y$-coordinate of $B\\mathbin{:}$\n\n$$\n\\eqalign{\n\t\ty &= r\\sin\\theta\\[5pt]\n\t\t&=10\\sqrt{3} \\sin\\left(\\dfrac{5\\pi}{6} \\right)\\[5pt]\n\t\t&= 10\\sqrt{3} \\cdot\\dfrac{1}{2} \\[5pt]\n\t\t&=5\\sqrt{3}\n\t}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $\\left( -15,  5\\sqrt{3}\\right).$"} :knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb" :knowledge-point/questions [{:db/id #edb/ref 17592186092703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdf20096-bc79-5589-a630-1641f8fe0ea5" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{15}, 2\\sqrt{5})" :db/id #edb/ref 17592186090419} {:answer/id #uuid "d3c9ff15-216c-5b7c-bf56-2cfa31cb97af" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{15}, 2\\sqrt{15})" :db/id #edb/ref 17592186090420} {:answer/id #uuid "5d034e1a-b724-530e-affc-63bac67f2a1e" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{5}, 2\\sqrt{15})" :db/id #edb/ref 17592186090421} {:answer/id #uuid "7ca499d2-67e9-5fc6-a4c5-5208506dc65c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5}, \\sqrt{15})" :db/id #edb/ref 17592186090422} {:answer/id #uuid "7f0b692a-5390-54a9-a6f7-739b88f06ee0" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{15}, 4\\sqrt{5})" :db/id #edb/ref 17592186090423}] :answer-field/id #uuid "4a4d92fd-ac4b-5f7a-9c34-e0bfcd92fac9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090418}] :question/id #uuid "0ebc9d27-9c03-5dba-a9e8-e61d4df48f75" :question/math-academy-id "q-40803" :question/problem "The point $A$ has polar coordinates $(r, \\frac{π}{4})$ and the point $B$ has polar coordinates $(2r, \\frac{π}{3})$. Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(\\sqrt{10}, \\sqrt{10})$."} {:db/id #edb/ref 17592186092704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0d74418-5a15-53d0-9b0f-29a8ffb06a72" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, 0)" :db/id #edb/ref 17592186090425} {:answer/id #uuid "decad71a-b4e9-5d7b-9199-8f0aee31dcd9" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 1)" :db/id #edb/ref 17592186090426} {:answer/id #uuid "e90c9538-684f-5cce-a8ea-7f6831fa103a" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 0)" :db/id #edb/ref 17592186090427} {:answer/id #uuid "512c0a28-3bdb-5347-b37e-b43ef2062001" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-1)" :db/id #edb/ref 17592186090428} {:answer/id #uuid "55cd377c-4643-5da3-a323-25622bb33cc9" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-1)" :db/id #edb/ref 17592186090429}] :answer-field/id #uuid "3c7a661a-09c6-5373-b0d4-2134575fd07d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090424}] :question/id #uuid "3dd4897a-0f39-5ff6-8f3b-6202a2c681b8" :question/math-academy-id "q-40806" :question/problem "The point $A$ has polar coordinates $(2, θ)$ and the point $B$ has polar coordinates $(1, θ - \\frac{π}{4})$. Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(\\sqrt{2},-\\sqrt{2})$."} {:db/id #edb/ref 17592186256407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a155516-d839-587a-bed9-42b9a2e072c9" :answer/type {:db/ident :answer.type/math} :answer/value "(6\\sqrt{3},-6)" :db/id #edb/ref 17592186253747} {:answer/id #uuid "1129da34-d7d1-5e9f-8843-f5403e6bf93a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{3},-2\\sqrt{3})" :db/id #edb/ref 17592186253820} {:answer/id #uuid "12c049a4-b3f5-57ad-8839-06ff45915613" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3},-6)" :db/id #edb/ref 17592186253833} {:answer/id #uuid "4009cc1a-951f-501b-bdc2-6e69fb5a6357" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{3},-\\sqrt{3})" :db/id #edb/ref 17592186254222} {:answer/id #uuid "a9834412-7636-54d2-8673-12769dbe9d79" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-6)" :db/id #edb/ref 17592186255166}] :answer-field/correct {:answer/id #uuid "0a155516-d839-587a-bed9-42b9a2e072c9" :answer/type {:db/ident :answer.type/math} :answer/value "(6\\sqrt{3},-6)" :db/id #edb/ref 17592186253747} :answer-field/id #uuid "e4d936aa-147e-55d6-93f2-fbed67c48196" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256328}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b0e5e2dd-de81-57dc-8848-06ae6eac4cea" :question/math-academy-id "q-120455" :question/problem "The point $A$ has polar coordinates $(r,\\frac{5\\pi }{6})$ and the point $B$ has polar coordinates $({r}^{2},\\frac{11\\pi }{6}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-3,\\sqrt{3}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(\\sqrt{3})^{2}} \\\\  & =\\sqrt{12}\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n((\\sqrt{12})^{2},\\frac{11\\pi }{6})=(12,\\frac{11\\pi }{6}).\n$$\n\n \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{11\\pi }{6}) \\\\  & =12(\\frac{\\sqrt{3}}{2}) \\\\  & =6\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =12(-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(6\\sqrt{3},-6).$"} {:db/id #edb/ref 17592186256409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a02ee7-0c84-56f1-bbf0-ebb90394da60" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186253859} {:answer/id #uuid "39bbabdf-ded0-54de-9bce-39f8a04d806d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186254176} {:answer/id #uuid "6f9d34e5-3a45-5295-96d7-05130d5b7bc6" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186254659} {:answer/id #uuid "7a7d44b2-7e30-57fa-9135-30c7aad08a99" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{3},-2)" :db/id #edb/ref 17592186254758} {:answer/id #uuid "c869f985-2a3d-5a8b-ba06-6ea45dcdacab" :answer/type {:db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186255454}] :answer-field/correct {:answer/id #uuid "39bbabdf-ded0-54de-9bce-39f8a04d806d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186254176} :answer-field/id #uuid "8600f656-d47f-52c4-96f7-5d633c8eeb59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256169}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6d3f790c-6d1a-5380-94bb-56056dda53c1" :question/math-academy-id "q-120468" :question/problem "The point $A$ has polar coordinates $(2,\\theta )$ and the point $B$ has polar coordinates $(4,\\theta +\\frac{\\pi }{3}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-\\sqrt{3},-1).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡(\\frac{-1}{-\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(1/\\sqrt{3}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nSince the point $A$ lies in the third quadrant, we have $\\theta =\\pi +{\\theta }_{R}=\\frac{7\\pi }{6}.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(4,\\frac{7\\pi }{6}+\\frac{\\pi }{3})=(4,\\frac{3\\pi }{2}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\cdot \\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\cdot \\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(0,-4).$"} {:db/id #edb/ref 17592186294879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2708c61-f2d1-53ee-a4ea-fb782ceca8db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293822}] :answer-field/correct {:answer/id #uuid "e2708c61-f2d1-53ee-a4ea-fb782ceca8db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293822} :answer-field/id #uuid "da981865-cfbd-52c1-9bab-b92faa7bdbfb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294696} {:answer-field/choices [{:answer/id #uuid "89b9cc0e-222c-5712-817e-705a58a6e766" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186293467}] :answer-field/correct {:answer/id #uuid "89b9cc0e-222c-5712-817e-705a58a6e766" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186293467} :answer-field/id #uuid "ef892571-43d2-5d92-9083-6ce12a147796" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294770}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "60b828e5-8a1d-5f25-a3d7-f526a8ab5604" :question/math-academy-id "q-276803" :question/problem "The point $A$ has polar coordinates $(r,\\frac{\\pi }{6})$ and the point $B$ has polar coordinates $(\\frac{r}{3},\\frac{5\\pi }{6}).$ Determine the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(\\sqrt{3},1).$\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(\\sqrt{3})}^{2}+{1}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are $(\\frac{2}{3},\\frac{5\\pi }{6}).$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\frac{2}{3}\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =\\frac{2}{3}(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\frac{2}{3}\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =\\frac{2}{3}(\\frac{1}{2}) \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-\\frac{\\sqrt{3}}{3},\\frac{1}{3}).$"} {:db/id #edb/ref 17592186294880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52ddb059-0d05-51a1-bd95-f4bc61d11fb8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186293267}] :answer-field/correct {:answer/id #uuid "52ddb059-0d05-51a1-bd95-f4bc61d11fb8" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186293267} :answer-field/id #uuid "34283d07-159f-5091-9a01-99f05e0ae58a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294110} {:answer-field/choices [{:answer/id #uuid "d4492581-9f4a-54f6-8d56-efd1c2556ae3" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{3}" :db/id #edb/ref 17592186293754}] :answer-field/correct {:answer/id #uuid "d4492581-9f4a-54f6-8d56-efd1c2556ae3" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{3}" :db/id #edb/ref 17592186293754} :answer-field/id #uuid "a643542b-f211-57cf-9379-abb105ab8ff5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294525}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "18267ca6-6217-5e13-9301-7563b567900e" :question/math-academy-id "q-276807" :question/problem "The point $A$ has polar coordinates $(r,\\frac{\\pi }{6})$ and the point $B$ has polar coordinates $(2r,\\frac{7\\pi }{6}).$ Determine the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(2\\sqrt{3},2).$\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(2\\sqrt{3})}^{2}+(2)^{2}} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n(2\\cdot 4,\\frac{7\\pi }{6})=(8,\\frac{7\\pi }{6}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =8(-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =8(-\\frac{1}{2}) \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-4\\sqrt{3},-4).$"} {:db/id #edb/ref 17592186294881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0c17d61-8b20-57f7-bc5b-640a6ec8d53b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{3}}{2}" :db/id #edb/ref 17592186293866}] :answer-field/correct {:answer/id #uuid "f0c17d61-8b20-57f7-bc5b-640a6ec8d53b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{3}}{2}" :db/id #edb/ref 17592186293866} :answer-field/id #uuid "7a127bc7-9c4c-53d5-928b-fac60ba066e6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294364} {:answer-field/choices [{:answer/id #uuid "0e6d10ef-69b9-50c0-90b4-1995316eadf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186292997}] :answer-field/correct {:answer/id #uuid "0e6d10ef-69b9-50c0-90b4-1995316eadf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186292997} :answer-field/id #uuid "826392ad-052e-559d-8fa4-5b8ae6ee49d9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294392}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8de1e1e5-b9e0-5943-ba28-afbdac6dbd1d" :question/math-academy-id "q-276838" :question/problem "The point $A$ has polar coordinates $(5,\\theta )$ and the point $B$ has polar coordinates $(5,\\theta +\\frac{\\pi }{6}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(5,0).$\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡(\\frac{0}{5}) \\\\  & =\\operatorname{arctan}⁡(0) \\\\  & =0\\end{aligned}\n$$\n\nSince the point $A$ lies in the first quadrant, we have $\\theta ={\\theta }_{R}=0.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(5,0+\\frac{\\pi }{6})=(5,\\frac{\\pi }{6}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =5\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =5\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{5\\sqrt{3}}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =5\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =5\\cdot \\frac{1}{2} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\frac{5\\sqrt{3}}{2},\\frac{5}{2}).$"} {:db/id #edb/ref 17592186326881 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d8dfee2-0dcc-51dd-8359-792e8b7dcf0e" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-5\\sqrt{3})" :db/id #edb/ref 17592186324094} {:answer/id #uuid "2fc33d3f-43b1-5036-bee7-64c9f48bbe57" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{5},\\sqrt{5})" :db/id #edb/ref 17592186324353} {:answer/id #uuid "6a8acf08-5493-5784-b668-42814866416a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{5},\\sqrt{15})" :db/id #edb/ref 17592186324861} {:answer/id #uuid "8c2836f8-1ba6-5faa-ae75-030fa6b7030c" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{5},-3\\sqrt{5})" :db/id #edb/ref 17592186325163} {:answer/id #uuid "bf2f2323-45b4-58c8-8c06-7d06b792ddfa" :answer/type {:db/ident :answer.type/math} :answer/value "(-5\\sqrt{3},-5)" :db/id #edb/ref 17592186325616}] :answer-field/correct {:answer/id #uuid "0d8dfee2-0dcc-51dd-8359-792e8b7dcf0e" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-5\\sqrt{3})" :db/id #edb/ref 17592186324094} :answer-field/id #uuid "d2ba43e9-48cb-5399-8b07-ea56e49d1700" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326601}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "351973f9-e651-502b-90b1-ba68a5d4bedc" :question/math-academy-id "q-40804" :question/problem "The point $A$ has polar coordinates $(r,\\frac{3\\pi }{4})$ and the point $B$ has polar coordinates $({r}^{2},\\frac{4\\pi }{3}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-\\sqrt{5},\\sqrt{5}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(\\sqrt{5})^{2}+(\\sqrt{5})^{2}} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n((\\sqrt{10})^{2},\\frac{4\\pi }{3})=(10,\\frac{4\\pi }{3}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =10\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{1}{2}) \\\\  & =-5\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =10\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{\\sqrt{3}}{2}) \\\\  & =-5\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-5,-5\\sqrt{3}).$"} {:db/id #edb/ref 17592186326884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de63e38-80fb-54c4-9a7c-5a96600b508f" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{3},4\\sqrt{3})" :db/id #edb/ref 17592186324222} {:answer/id #uuid "23d41aa2-c3a0-5270-abba-3a1f3207c3d3" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186324266} {:answer/id #uuid "2e4dd8b9-9d94-588f-a6d0-7d91017750d9" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{2},2\\sqrt{2})" :db/id #edb/ref 17592186324340} {:answer/id #uuid "81916b05-53d5-5cfe-b7c6-b0642b2c06ac" :answer/type {:db/ident :answer.type/math} :answer/value "(8\\sqrt{3},8\\sqrt{3})" :db/id #edb/ref 17592186325056} {:answer/id #uuid "82355246-8fcd-5520-a5e5-83b3cb9b05c9" :answer/type {:db/ident :answer.type/math} :answer/value "(8\\sqrt{2},8\\sqrt{2})" :db/id #edb/ref 17592186325067}] :answer-field/correct {:answer/id #uuid "23d41aa2-c3a0-5270-abba-3a1f3207c3d3" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186324266} :answer-field/id #uuid "3036c726-f5d4-51ab-a7e4-77d619c6072b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "417c4b2b-c91e-563b-b92c-41495ea7b2b8" :question/math-academy-id "q-40826" :question/problem "The point $A$ has polar coordinates $(\\sqrt{2},\\theta )$ and the point $B$ has polar coordinates $(8,\\theta +\\pi ).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-1,-1).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡(\\frac{-1}{-1}) \\\\  & =\\operatorname{arctan}⁡(1) \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nSince the point $A$ lies in the third quadrant, we have $\\theta =\\pi +{\\theta }_{R}=\\frac{5\\pi }{4}.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(8,\\frac{5\\pi }{4}+\\pi )=(8,\\frac{9\\pi }{4})=(8,\\frac{\\pi }{4}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =8\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =8\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(4\\sqrt{2},4\\sqrt{2}).$"} {:db/id #edb/ref 17592186354486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d257c92-35f5-5542-8460-7eedd2b1d612" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{3}{2},\\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186352271} {:answer/id #uuid "5dfbf2f2-dbb2-5231-a8e3-5c7f27e6aec7" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{3\\sqrt{3}}{2},\\frac{3}{2})" :db/id #edb/ref 17592186352400} {:answer/id #uuid "66bc6397-ad23-5f9d-bbbd-4c19753bdac4" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{3}}{2},-\\frac{3}{2})" :db/id #edb/ref 17592186352476} {:answer/id #uuid "7d900d5b-7506-5283-a33a-77e549a766d0" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{3},3)" :db/id #edb/ref 17592186352669} {:answer/id #uuid "af70cc0a-2339-58cb-ad6d-c2731efb201f" :answer/type {:db/ident :answer.type/math} :answer/value "(3,3\\sqrt{3})" :db/id #edb/ref 17592186353058}] :answer-field/correct {:answer/id #uuid "5dfbf2f2-dbb2-5231-a8e3-5c7f27e6aec7" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{3\\sqrt{3}}{2},\\frac{3}{2})" :db/id #edb/ref 17592186352400} :answer-field/id #uuid "d717a7d4-1e96-542f-89a3-19928481d9b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a9b63e65-54e5-5242-a627-cab8a091bffb" :question/math-academy-id "q-86619" :question/problem "The point $A$ has polar coordinates $(r,\\frac{\\pi }{4})$ and the point $B$ has polar coordinates $(\\frac{r}{2},\\frac{5\\pi }{6}).$  Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(3\\sqrt{2},3\\sqrt{2}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(3\\sqrt{2})^{2}+(3\\sqrt{2})^{2}} \\\\  & =\\sqrt{18+18} \\\\  & =\\sqrt{36} \\\\  & =6\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n(\\frac{6}{2},\\frac{5\\pi }{6})=(3,\\frac{5\\pi }{6}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =3(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{3}}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =3(\\frac{1}{2}) \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-\\frac{3\\sqrt{3}}{2},\\frac{3}{2}).$"}] :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given Some Information About Another Point"}] [{:db/id #edb/ref 17592186092260 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092116 :question/id #uuid "c986ab8f-a8a6-5721-bc8d-ba7ec19b95ea" :question/math-academy-id "e-727" :question/problem "Calculate $f'(x)$ if $f(x) = e^{5x +4}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf = e^u, \\qquad u=5x+4.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 5 \\\\  & =5{e}^{u} \\\\  & =5{e}^{5x+4}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/questions [{:db/id #edb/ref 17592186092512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6fe2c4c-f454-5aca-a824-b3a7d3b7906a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{3x}}{3}" :db/id #edb/ref 17592186089244} {:answer/id #uuid "fd2c856f-0818-5870-a81c-c09468b81451" :answer/type {:db/ident :answer.type/math} :answer/value "xe^{3x}" :db/id #edb/ref 17592186089245} {:answer/id #uuid "33420c54-a5e9-5e50-8d8a-2b748db05ce4" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{3x}" :db/id #edb/ref 17592186089246} {:answer/id #uuid "43e58a07-4775-5ba0-87bf-4177453776ee" :answer/type {:db/ident :answer.type/math} :answer/value "3xe^{3x}" :db/id #edb/ref 17592186089247} {:answer/id #uuid "62505802-48e7-5721-a94d-ba4a709ec693" :answer/type {:db/ident :answer.type/math} :answer/value "e^{3x}" :db/id #edb/ref 17592186089248}] :answer-field/id #uuid "c07e8ff0-97b2-55ed-aa61-6034627f1aa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089243}] :question/id #uuid "2b5accbf-e263-55a8-aa47-3d5a01076c05" :question/math-academy-id "q-11816" :question/problem "Given that $f(x) = e^{3x}$, find $\\frac{df}{dx}$."} {:db/id #edb/ref 17592186092513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a72f46cd-ae5e-5369-ac3a-906a711a6a72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2x + 5}}{2}" :db/id #edb/ref 17592186089250} {:answer/id #uuid "b53db06b-92b9-5298-810d-18bcc71b09a0" :answer/type {:db/ident :answer.type/math} :answer/value "2xe^{2x + 5}" :db/id #edb/ref 17592186089251} {:answer/id #uuid "181aab1e-8a13-55d1-af91-7902b69fdb42" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{2x + 5}" :db/id #edb/ref 17592186089252} {:answer/id #uuid "228c28d4-c54c-59fc-abc4-8bd4a76de28f" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x + 5}" :db/id #edb/ref 17592186089253} {:answer/id #uuid "4de1d19f-8a03-5aca-a314-5556b81aac11" :answer/type {:db/ident :answer.type/math} :answer/value "(2x + 5)e^{2x + 5}" :db/id #edb/ref 17592186089254}] :answer-field/id #uuid "aa7337e6-4d8a-5b6d-9fd4-37daba6415d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089249}] :question/id #uuid "b27b93f8-5f19-566f-95e3-f0a0b21ec684" :question/math-academy-id "q-11817" :question/problem "Given that $f(x) = e^{2x + 5}$, find $\\frac{df}{dx}$."} {:db/id #edb/ref 17592186233098 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f95fdc58-1eb7-5580-ab34-aae2969c5c74" :question/math-academy-id "q-107420" :question/problem "Calculate ${f}^{'}(x)$ if $f(x)={x}^{3}-{e}^{1-3x}.$" :question/worked-solution "First, we express $y={e}^{1-3x}$ as the composite function\n\n$$\ny={e}^{u},\\,u=1-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{1-3x}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}-{e}^{1-3x}) \\\\  & =3{x}^{2}-(-3{e}^{1-3x}) \\\\  & =3({x}^{2}+{e}^{1-3x}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234086 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f33e1827-8673-5c93-87ec-142118255194" :question/math-academy-id "q-48003" :question/problem "Given that $y=-3{e}^{5-x},$ find $\\frac{\\text{d}y}{\\text{d}x}$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0cfd52e-1fc1-51eb-85e5-32d9d3dc6090" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-3x+5}+8" :db/id #edb/ref 17592186313486}] :answer-field/correct {:answer/id #uuid "c0cfd52e-1fc1-51eb-85e5-32d9d3dc6090" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-3x+5}+8" :db/id #edb/ref 17592186313486} :answer-field/id #uuid "7fd73eaf-0df8-5718-b843-1cd77b6090a3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314351}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8593de99-5055-5455-bd33-e38ccd6c9851" :question/math-academy-id "q-340496" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=8x+{e}^{-3x+5}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $y={e}^{-3x+5}$ as the composite function\n\n$$\ny={e}^{u},\\,u=-3x+5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{-3x+5}.\\end{aligned}\n$$\n\nFinally, using the sum rule of differentiation, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8x+{e}^{-3x+5}) \\\\  & =8-3{e}^{-3x+5} \\\\  & =-3{e}^{-3x+5}+8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "970e1936-ac2b-534a-8ed4-97d799d35e63" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186313177}] :answer-field/correct {:answer/id #uuid "970e1936-ac2b-534a-8ed4-97d799d35e63" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186313177} :answer-field/id #uuid "f6a75775-f14f-5a3f-b4e1-1d6d0f134ccc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314681}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8caad42a-7778-5faa-ba43-6f75823507a3" :question/math-academy-id "q-340497" :question/problem "Find the slope $m$ of the tangent to the curve $y=-4{e}^{2-x}$ at the point where $x=2-ln⁡(3).$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-4{e}^{u},\\,u=2-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-4{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4{e}^{u}\\cdot (-1) \\\\  & =4{e}^{u} \\\\  & =4{e}^{2-x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=2-ln⁡(3)$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows\n\n$$\n\\begin{aligned}m=\\frac{\\text{d}y}{\\text{d}x}{|}_{x=2-ln⁡(3)} & =4{e}^{2-(2-ln⁡(3))} \\\\  & =4{e}^{ln⁡(3)} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016b59fa-7dd1-5430-8a0d-9d17b256b87e" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}+3" :db/id #edb/ref 17592186326950} {:answer/id #uuid "1a09b33b-87d5-53a9-afee-f8e02962d4c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{4x-1}" :db/id #edb/ref 17592186327160} {:answer/id #uuid "35f572ac-b945-560e-89f5-d45ed6858e1a" :answer/type {:db/ident :answer.type/math} :answer/value "8{e}^{4x-1}+3" :db/id #edb/ref 17592186327403} {:answer/id #uuid "bab77687-86e3-5b97-960a-d832566921c3" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-2}" :db/id #edb/ref 17592186328563} {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611}] :answer-field/correct {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611} :answer-field/id #uuid "a2f4dd66-f6d3-5f50-8ce9-b004c416733f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329462}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd0c521a-06b7-559f-8b78-1152ec8cbcd7" :question/math-academy-id "q-48007" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{4x-1}+3.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+3,\\,u=4x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 4 \\\\  & =-8{e}^{u} \\\\  & =-8{e}^{4x-1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a9f96f-82fe-597d-8f9c-ec74365b138f" :answer/type {:db/ident :answer.type/math} :answer/value "y=20ex\\cdot ln⁡(5)" :db/id #edb/ref 17592186327093} {:answer/id #uuid "341d8922-42cf-54fa-9393-c8b46d49f2db" :answer/type {:db/ident :answer.type/math} :answer/value "y=5ex" :db/id #edb/ref 17592186327386} {:answer/id #uuid "388c97a7-d581-5bec-9e47-92d37546c27d" :answer/type {:db/ident :answer.type/math} :answer/value "y=ex" :db/id #edb/ref 17592186327428} {:answer/id #uuid "569457c0-25f6-5141-b92a-2099597b16ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=4ex" :db/id #edb/ref 17592186327685} {:answer/id #uuid "ae9ebfb2-3fe0-510b-bcbc-62f5f335f2b0" :answer/type {:db/ident :answer.type/math} :answer/value "y=20ex" :db/id #edb/ref 17592186328449}] :answer-field/correct {:answer/id #uuid "ae9ebfb2-3fe0-510b-bcbc-62f5f335f2b0" :answer/type {:db/ident :answer.type/math} :answer/value "y=20ex" :db/id #edb/ref 17592186328449} :answer-field/id #uuid "40293d79-60e8-50ac-8ded-e02ee37fe2cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329311}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b6722d36-cd26-5e84-89df-067b2a93b540" :question/math-academy-id "q-48657" :question/problem "Find the equation of the tangent to the curve $y=5{e}^{4x}$ at the point where $x=\\frac{1}{4}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=5{e}^{u},\\,u=4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=5{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =5{e}^{u}\\cdot 4 \\\\  & =20{e}^{u} \\\\  & =20{e}^{4x}.\\end{aligned}\n$$\n\nNow, to find the slope of the tangent to the curve at $x=\\frac{1}{4}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1/4} & ={(20{e}^{4x})|}_{x=1/4} \\\\  & =20{e}^{4(1/4)} \\\\  & =20e\\end{aligned}\n$$\n\nAlso, the $y$-value of the point on the curve where $x={x}_{1}=\\frac{1}{4}$ is\n\n$$\n\\begin{aligned}{y}_{1} & ={(5{e}^{4x})|}_{x=1/4} \\\\  & =5{e}^{4(1/4)} \\\\  & =5e.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at that point:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5e & =20e(x-\\frac{1}{4}) \\\\ y-5e & =20ex-5e \\\\ y & =20ex\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3844e08c-6f9d-5cf6-a14e-cc030d9a01b0" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{5}" :db/id #edb/ref 17592186327425} {:answer/id #uuid "a89f0a93-4737-553c-9bbe-0034bad64d50" :answer/type {:db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186328394} {:answer/id #uuid "adef63ee-5bd4-5b53-b409-c9e308d93260" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328445} {:answer/id #uuid "c199d559-8e1d-58ab-8615-2d150595957a" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186328624} {:answer/id #uuid "d557a2be-477a-515d-91b2-d30108f2cab4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328801}] :answer-field/correct {:answer/id #uuid "adef63ee-5bd4-5b53-b409-c9e308d93260" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328445} :answer-field/id #uuid "d0d50368-ac7e-5bb9-86d5-22e01e5b4791" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329554}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fbf43982-c74c-540d-95a5-32f181ac4ea6" :question/math-academy-id "q-48658" :question/problem "Find the slope of the tangent to the curve $y=-3{e}^{5-x}$ at the point where $x=5-ln⁡(2).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=-3{e}^{u},\\,u=5-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3{e}^{u}\\cdot (-1) \\\\  & =3{e}^{u} \\\\  & =3{e}^{5-x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=5-ln⁡(2)$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=5-ln⁡(2)} & =3{e}^{5-(5-ln⁡(2))} \\\\  & =3{e}^{ln⁡(2)} \\\\  & =3\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] [{:db/id #edb/ref 17592186092261 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092118 :question/id #uuid "775dfc95-df31-5198-aeb2-4603b8386957" :question/math-academy-id "e-728" :question/problem "Given that $y= 3\\cdot 2^{1 - x},$ find $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny = 3\\cdot 2^u, \\qquad u=1-x.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = 3\\cdot 2^u\\ln(2),\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\cdot {2}^{u}ln⁡(2)\\cdot (-1) \\\\  & =-3\\cdot {2}^{u}ln⁡(2) \\\\  & =-3\\cdot {2}^{1-x}ln⁡(2).\\end{aligned}\n$$"} :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/questions [{:db/id #edb/ref 17592186092733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d9ee625-e773-554a-b6fd-1b00c950d2f1" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 3^{2x}\\ln (3)" :db/id #edb/ref 17592186090599} {:answer/id #uuid "a2e4f469-6799-5ce4-b565-a59f324b5ec8" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}" :db/id #edb/ref 17592186090600} {:answer/id #uuid "bdacec05-5c20-55b6-8105-e82bd5158002" :answer/type {:db/ident :answer.type/math} :answer/value "2x3^{2x^{2}}" :db/id #edb/ref 17592186090601} {:answer/id #uuid "f7139b42-c4a4-5c78-ab9a-4c8bcf3ecb8f" :answer/type {:db/ident :answer.type/math} :answer/value "4x3^{2x^{2}}\\ln (3)" :db/id #edb/ref 17592186090602} {:answer/id #uuid "15755bfa-20fa-599b-b783-c67a495db7ea" :answer/type {:db/ident :answer.type/math} :answer/value "x3^{2x}\\ln (3)" :db/id #edb/ref 17592186090603}] :answer-field/id #uuid "4acd11bc-cb2e-5a8e-a9ee-06ec6470c2d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090598} {:answer-field/choices [{:answer/id #uuid "9c382a73-b479-5088-ba73-8174216969b9" :answer/type {:db/ident :answer.type/math} :answer/value "4x{3}^{2{x}^{2}}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402979} {:answer/id #uuid "7bd5037d-c800-5b92-94d5-bf8378100f05" :answer/type {:db/ident :answer.type/math} :answer/value "x{3}^{2x}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402980} {:answer/id #uuid "bc15acd8-2e05-54df-824b-49b27e8976d4" :answer/type {:db/ident :answer.type/math} :answer/value "4x{3}^{2{x}^{2}}" :db/id #edb/ref 17592186402981} {:answer/id #uuid "c86614c3-2ff7-5322-a6c3-9ce930da4214" :answer/type {:db/ident :answer.type/math} :answer/value "2x{3}^{2{x}^{2}}" :db/id #edb/ref 17592186402982} {:answer/id #uuid "098f7a16-97a6-5c7b-bd17-6d5da322792f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot {3}^{2x}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402983}] :answer-field/correct {:answer/id #uuid "9c382a73-b479-5088-ba73-8174216969b9" :answer/type {:db/ident :answer.type/math} :answer/value "4x{3}^{2{x}^{2}}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186402979} :answer-field/id #uuid "08bb9372-bdf9-5f57-a4fb-f3aaaf1824d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402978}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8711f34a-9cc5-5a70-9af6-219e0592f067" :question/math-academy-id "q-48565" :question/problem "If $f(x)={3}^{2{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={3}^{u},\\,u=2{x}^{2}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={3}^{u}\\operatorname{ln}⁡(3),\\,\\frac{\\text{d}u}{\\text{d}x}=4x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={3}^{u}\\operatorname{ln}⁡(3)\\cdot (4x) \\\\  & =4x\\cdot {3}^{u}\\operatorname{ln}⁡(3) \\\\  & =4x\\cdot {3}^{2{x}^{2}}\\operatorname{ln}⁡(3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa029f20-9e8b-5be2-9aaf-e25b51c039d3" :answer/type {:db/ident :answer.type/math} :answer/value "(12x)3^{6x^{2} - 4}" :db/id #edb/ref 17592186090611} {:answer/id #uuid "adc2037a-76a7-570a-a5b0-aad7e20b5c7b" :answer/type {:db/ident :answer.type/math} :answer/value "(12x)3^{6x^{2} - 4}\\ln (3)" :db/id #edb/ref 17592186090612} {:answer/id #uuid "cbe2a81f-2507-5d07-bb73-29c3696d08a5" :answer/type {:db/ident :answer.type/math} :answer/value "(12x - 4)3^{6x^{2} - 4}" :db/id #edb/ref 17592186090613} {:answer/id #uuid "d255dee3-7ee2-5cfc-af90-221a41a1961e" :answer/type {:db/ident :answer.type/math} :answer/value "(12x - 4)3^{6x^{2} - 4}\\ln (3)" :db/id #edb/ref 17592186090614} {:answer/id #uuid "582b9da7-3b84-58f5-a115-eedbe6fbcb2e" :answer/type {:db/ident :answer.type/math} :answer/value "(12x^{3})3^{12x}\\ln (3)" :db/id #edb/ref 17592186090615}] :answer-field/id #uuid "d7d3b7cd-8fef-5ba2-8969-6b86fbad9f15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090610}] :question/id #uuid "475f4a17-648a-5df1-a5af-24c4bc3218f3" :question/math-academy-id "q-48631" :question/problem "Given that $y = 3^{6x^{2} - 4}$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186233099 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5b5b538e-387a-5bc3-9ad6-828140780508" :question/math-academy-id "q-107458" :question/problem "If $f(x)={2}^{3-{x}^{3}},$ find ${f}^{'}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={2}^{u},\\,u=3-{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={2}^{u}\\operatorname{ln}2,\\,\\frac{\\text{d}u}{\\text{d}x}=-3{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}2\\cdot (-3{x}^{2}) \\\\  & =-3{x}^{2}\\cdot {2}^{u}\\operatorname{ln}2 \\\\  & =-3{x}^{2}\\cdot {2}^{3-{x}^{3}}\\operatorname{ln}2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234314 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cc156fa4-1ae1-5983-b7ca-740de211698e" :question/math-academy-id "q-71881" :question/problem "Given that $y=2\\cdot {5}^{x+{x}^{3}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=2\\cdot {5}^{u},\\,u=x+{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=2\\cdot {5}^{u}\\operatorname{ln}5,\\,\\frac{\\text{d}u}{\\text{d}x}=1+3{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =2\\cdot {5}^{u}\\operatorname{ln}5\\cdot (1+3{x}^{2}) \\\\  & =(1+3{x}^{2})\\cdot 2\\cdot {5}^{u}\\operatorname{ln}5 \\\\  & =(2+6{x}^{2}){5}^{x+{x}^{3}}\\operatorname{ln}5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152cb325-9ed7-57e6-9c36-b431d68cdffb" :answer/type {:db/ident :answer.type/math} :answer/value "-2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241362} {:answer/id #uuid "2e76f4b9-59bb-51c9-a297-586eb211cb2f" :answer/type {:db/ident :answer.type/math} :answer/value "-6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241592} {:answer/id #uuid "33d1a60d-2b25-5917-b2e1-7176812399fd" :answer/type {:db/ident :answer.type/math} :answer/value "6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241637} {:answer/id #uuid "7ab59f64-3cac-5e93-b9c8-4dd4ce8cba35" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186242259} {:answer/id #uuid "ec2442e6-3bcb-5d29-a607-74db0268944f" :answer/type {:db/ident :answer.type/math} :answer/value "3x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186243268}] :answer-field/correct {:answer/id #uuid "33d1a60d-2b25-5917-b2e1-7176812399fd" :answer/type {:db/ident :answer.type/math} :answer/value "6x\\cdot {4}^{{x}^{2}-1}ln⁡4" :db/id #edb/ref 17592186241637} :answer-field/id #uuid "fdd15e38-3eee-5ed4-a0c4-348e7c224b10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243881}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f637ee3d-e925-50b9-8fb1-4aa44482e5e0" :question/math-academy-id "q-107459" :question/problem "Given that $y=3\\cdot {4}^{{x}^{2}-1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\cdot {4}^{u},\\,u={x}^{2}-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\cdot {4}^{u}ln⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\cdot {4}^{u}ln⁡4\\cdot 2x \\\\  & =6x\\cdot {4}^{{x}^{2}-1}ln⁡4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530546dd-8877-5ee4-a9a9-4e6037256c79" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186241920} {:answer/id #uuid "600e2c77-5502-5a78-b78c-316c9d3b0309" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242042} {:answer/id #uuid "a399353b-dcb8-5ce5-8226-adfa95834745" :answer/type {:db/ident :answer.type/math} :answer/value "24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242614} {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} {:answer/id #uuid "f5f46ff0-e8a9-5bfe-82dc-8df71e3e5cb5" :answer/type {:db/ident :answer.type/math} :answer/value "-24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186243356}] :answer-field/correct {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} :answer-field/id #uuid "cfbbf656-26a0-5730-8af0-76fb3508854c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243802}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a0d30f56-0d1c-5b77-92c9-4ebf415c4add" :question/math-academy-id "q-107461" :question/problem "If $f(x)={6}^{1-4x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={6}^{u},\\,u=1-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={6}^{u}ln⁡6,\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}ln⁡6\\cdot (-4) \\\\  & =-4\\cdot {6}^{u}ln⁡6 \\\\  & =-4\\cdot {6}^{1-4x}ln⁡6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb72661-686b-55b7-acd2-2a3bd4990839" :answer/type {:db/ident :answer.type/math} :answer/value "9\\cdot {2}^{9x}" :db/id #edb/ref 17592186284881} {:answer/id #uuid "0fa45466-3a87-5294-bb09-177ec594bc1e" :answer/type {:db/ident :answer.type/math} :answer/value "9x" :db/id #edb/ref 17592186284925} {:answer/id #uuid "7da55036-6972-52f3-847b-a31f95df7852" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{9x}" :db/id #edb/ref 17592186285944} {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} {:answer/id #uuid "f0d61fb9-24f0-590c-861d-b0dc09f76a1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286998}] :answer-field/correct {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} :answer-field/id #uuid "05333763-722c-5f4d-b56e-21e02dec7970" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287152}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "15807573-b299-5e98-85b6-db47d2fbe91c" :question/math-academy-id "q-1952" :question/problem "Given that $y={2}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={2}^{u},\\,u=9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={2}^{u}\\operatorname{ln}⁡2,\\,\\frac{\\text{d}u}{\\text{d}x}=9.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}⁡2\\cdot 9 \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{u} \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{9x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297340 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f743bf76-aa68-58e9-907f-2483aa71ceaf" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{ln}(5)" :db/id #edb/ref 17592186296581}] :answer-field/correct {:answer/id #uuid "f743bf76-aa68-58e9-907f-2483aa71ceaf" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{ln}(5)" :db/id #edb/ref 17592186296581} :answer-field/id #uuid "47b334c0-adcd-5c15-b3b3-c3ba23b7d937" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296767}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "96fff31f-332c-5572-b655-bad437de2f44" :question/math-academy-id "q-312462" :question/problem "Given that $f(x)={5}^{{x}^{3}+1},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}$\\cdot \\,{5}^{{x}^{3}+1}$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={5}^{u},\\,u={x}^{3}+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={5}^{u}ln⁡(5),\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={5}^{u}ln⁡(5)\\cdot (3{x}^{2}) \\\\  & =3{x}^{2}ln⁡(5)\\cdot {5}^{u} \\\\  & =3{x}^{2}ln⁡(5)\\cdot {5}^{{x}^{3}+1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa1743b3-cca5-5571-9ea3-78db4f0b711a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(5)" :db/id #edb/ref 17592186313309}] :answer-field/correct {:answer/id #uuid "aa1743b3-cca5-5571-9ea3-78db4f0b711a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(5)" :db/id #edb/ref 17592186313309} :answer-field/id #uuid "a3811faf-1cb9-5232-9104-02c745e33d3d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314452}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5d403927-9339-566e-9390-9903483d0c58" :question/math-academy-id "q-340969" :question/problem "Find the slope $m$ of the tangent to the curve $y={5}^{x-{x}^{3}}$ at the point where $x=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={5}^{u},\\,u=x-{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={5}^{u}ln⁡(5),\\,\\frac{\\text{d}u}{\\text{d}x}=1-3{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={5}^{u}ln⁡(5)\\cdot (1-3{x}^{2}) \\\\  & =(1-3{x}^{2}){5}^{x-{x}^{3}}ln⁡(5).\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={((1-3{x}^{2}){5}^{x-{x}^{3}}ln⁡(5))|}_{x=1} \\\\  & =(1-3(1)^{2}){5}^{1-(1)^{3}}ln⁡(5) \\\\  & =-2\\cdot {5}^{0}ln⁡(5) \\\\  & =-2ln⁡(5)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f178a09-59b9-5bd4-94f2-717a9d712eec" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327354} {:answer/id #uuid "ce962925-563f-5203-9850-54b8e1527957" :answer/type {:db/ident :answer.type/math} :answer/value "7ln⁡(4)" :db/id #edb/ref 17592186328749} {:answer/id #uuid "d0342368-9d6f-56bf-9428-8ca2563004ae" :answer/type {:db/ident :answer.type/math} :answer/value "28ln⁡(4)" :db/id #edb/ref 17592186328765} {:answer/id #uuid "e44279a3-2028-5e38-9e46-7a6b15fa9ce2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186328935} {:answer/id #uuid "e877c22b-b0a5-5c6f-80fc-dddf3ca707ed" :answer/type {:db/ident :answer.type/math} :answer/value "4ln⁡(4)" :db/id #edb/ref 17592186328967}] :answer-field/correct {:answer/id #uuid "d0342368-9d6f-56bf-9428-8ca2563004ae" :answer/type {:db/ident :answer.type/math} :answer/value "28ln⁡(4)" :db/id #edb/ref 17592186328765} :answer-field/id #uuid "c745005c-c2dc-5006-b584-ff3b1f2fe9d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329537}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac2dcbe2-d530-570b-ae79-f45a337889ca" :question/math-academy-id "q-48659" :question/problem "Find the slope of the tangent to the curve $y={4}^{7x}$ at the point where $x=\\frac{1}{7}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={4}^{u},\\,u=7x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={4}^{u}ln⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=7.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={4}^{u}ln⁡4\\cdot 7 \\\\  & =7ln⁡4\\cdot {4}^{u} \\\\  & =7ln⁡4\\cdot {4}^{7x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=\\frac{1}{7}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=1/7} & =7ln⁡(4)\\cdot {4}^{7(1/7)} \\\\  & =7ln⁡(4)\\cdot 4 \\\\  & =28ln⁡(4)\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve at the point where $x=\\frac{1}{7}$ is $28ln⁡(4).$"}] :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] [{:db/id #edb/ref 17592186092263 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092119 :question/id #uuid "b15a88b5-e2c4-51c1-90d5-031c2a8c23d3" :question/math-academy-id "e-729" :question/problem "Given that $y=e^{-x^2},$ calculate $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "First we express $y$ as the composite function\n\n$$\ny = e^u, \\qquad u=-x^2.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =-2x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-2x) \\\\  & =-2x{e}^{u} \\\\  & =-2x{e}^{-{x}^{2}}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/questions [{:db/id #edb/ref 17592186092618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "265b541b-62a2-540d-bd79-5ef733742b3d" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285123} {:answer/id #uuid "4a81ce5d-011d-51ee-bf9c-6333bf4dc66f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2{x}^{2}}" :db/id #edb/ref 17592186285478} {:answer/id #uuid "4b97230b-e5a8-5328-9497-45595399fb66" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{{x}^{2}}" :db/id #edb/ref 17592186285492} {:answer/id #uuid "812af0ad-7d34-5c50-a85a-78aa2431dcbb" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285975} {:answer/id #uuid "dedd5724-68fc-54e4-9b62-8ebbbd324624" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186286818}] :answer-field/correct {:answer/id #uuid "812af0ad-7d34-5c50-a85a-78aa2431dcbb" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}}" :db/id #edb/ref 17592186285975} :answer-field/id #uuid "0cfdfe24-c411-57d2-aa42-0fbbe96ad9c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287169}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0e52fa16-cf3e-5339-95e2-786fe7ef7e5d" :question/math-academy-id "q-1953" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{{x}^{2}}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u={x}^{2}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x) \\\\  & =2x{e}^{u} \\\\  & =2x{e}^{{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f53b1fe-17ee-5800-9a3f-82327590a8b5" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{5}e^{x^{4} + 1}" :db/id #edb/ref 17592186090605} {:answer/id #uuid "b344b273-973c-5cd4-9b78-f9f4b6c14df2" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{3} + e^{x^{4} + 1}" :db/id #edb/ref 17592186090606} {:answer/id #uuid "16fb416e-e5bf-57d4-a129-dd88c945f90c" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{3}e^{x^{4} + 1}" :db/id #edb/ref 17592186090607} {:answer/id #uuid "2ec445b1-9e9b-5639-9cba-48edb379db01" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{4}e^{x^{4} + 1}" :db/id #edb/ref 17592186090608} {:answer/id #uuid "63133f5d-41f8-5703-8b59-5583d2d92a0e" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{5} + e^{x^{4} + 1}" :db/id #edb/ref 17592186090609}] :answer-field/id #uuid "566e0008-fcd5-5a48-a5f1-0d9f404686db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090604}] :question/id #uuid "842ba2f6-4002-59f4-86c1-997627e51415" :question/math-academy-id "q-48628" :question/problem "Given that $y = e^{x^{4} + 1}$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186233913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5dc7bc1-7cee-51ed-a77a-e3c95bd45d7d" :answer/type {:db/ident :answer.type/math} :answer/value "-7{e}^{3}" :db/id #edb/ref 17592186232838}] :answer-field/correct {:answer/id #uuid "b5dc7bc1-7cee-51ed-a77a-e3c95bd45d7d" :answer/type {:db/ident :answer.type/math} :answer/value "-7{e}^{3}" :db/id #edb/ref 17592186232838} :answer-field/id #uuid "95689d09-12c1-5c25-ad3c-3364276260a0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232837}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "06ab12ca-1261-529b-b77e-4551b3fd2404" :question/math-academy-id "q-340948" :question/problem "Find the slope $m$ of the tangent to the curve $y={e}^{-2{x}^{6}+5x}$ at the point where $x=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=-2{x}^{6}+5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-12{x}^{5}+5.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-12{x}^{5}+5) \\\\  & =(-12{x}^{5}+5){e}^{u} \\\\  & =(-12{x}^{5}+5){e}^{-2{x}^{6}+5x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={((-12{x}^{5}+5){e}^{-2{x}^{6}+5x})|}_{x=1} \\\\  & =(-12(1)^{5}+5){e}^{-2(1)^{6}+5(1)} \\\\  & =-7{e}^{3} \\\\  & =-7{e}^{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeafba33-9d2d-5c84-83d1-aba9c2f1d3a7" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-1}" :db/id #edb/ref 17592186232840}] :answer-field/correct {:answer/id #uuid "eeafba33-9d2d-5c84-83d1-aba9c2f1d3a7" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{-1}" :db/id #edb/ref 17592186232840} :answer-field/id #uuid "67d8ceb6-7fd7-562b-b684-7cdcaee0de6d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232839}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8c2fc6b2-b088-54ff-90dc-24056bf60933" :question/math-academy-id "q-340955" :question/problem "Find the slope $m$ of the tangent to the curve $y={e}^{-3x}$ at the point where $x=\\frac{1}{3}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=-3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-3) \\\\  & =-3{e}^{u} \\\\  & =-3{e}^{-3x}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=\\frac{1}{3}$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/3} & ={(-3{e}^{-3x})|}_{x=1/3} \\\\  & =-3{e}^{-3(1/3)} \\\\  & =-3{e}^{-1} \\\\  & =-3{e}^{-1}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "340d32ab-0292-55d6-ad2a-da14464f67e2" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}x" :db/id #edb/ref 17592186234632}] :answer-field/correct {:answer/id #uuid "340d32ab-0292-55d6-ad2a-da14464f67e2" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}x" :db/id #edb/ref 17592186234632} :answer-field/id #uuid "b6445949-abe5-548c-ab63-85eaeea6ef0f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235195}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b2e5f110-a6b6-523d-8a9c-2c0d4e144aec" :question/math-academy-id "q-167329" :question/problem "Given that $y=f(h(x)),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $\\frac{\\text{d}y}{\\text{d}x}=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n${e}^{-4\\operatorname{sin}⁡x}$" :question/worked-solution "First, notice that $y$ is a composite function:\n\n$$\ny=\\frac{1}{2}{e}^{h},\\,h=-4\\operatorname{sin}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}h}=\\frac{1}{2}{e}^{h},\\,\\frac{\\text{d}h}{\\text{d}x}=-4\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}h}\\cdot \\frac{\\text{d}h}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{h}\\cdot (-4\\operatorname{cos}⁡x) \\\\  & =-2{e}^{-4\\operatorname{sin}⁡x}\\operatorname{cos}⁡x \\\\  & =-2\\operatorname{cos}⁡x\\,{e}^{-4\\operatorname{sin}⁡x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d81f09a-0feb-5148-a473-414d681185ad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}(x)" :db/id #edb/ref 17592186234761}] :answer-field/correct {:answer/id #uuid "8d81f09a-0feb-5148-a473-414d681185ad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}(x)" :db/id #edb/ref 17592186234761} :answer-field/id #uuid "a9c18185-4f4a-5388-bff5-21e01260a961" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b4e678b8-dc07-54a9-88b9-306f52add57d" :question/math-academy-id "q-167783" :question/problem "Given that $y=f(h(x)),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n                            \n                                    \n                                        \n                                        \n\n| $\\frac{\\text{d}y}{\\text{d}x}=\\,-$ | {{field-1}} |\n| --- | --- |\n| ${e}^{4\\operatorname{sin}⁡(x)}$ |  |" :question/worked-solution "First, notice that $y$ is a composite function:\n\n$$\ny=\\frac{1}{2}{e}^{h},\\,h=-4\\operatorname{sin}⁡(x).\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}h}=\\frac{1}{2}{e}^{h},\\,\\frac{\\text{d}h}{\\text{d}x}=-4\\operatorname{cos}⁡(x).\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}h}\\cdot \\frac{\\text{d}h}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{h}\\cdot (-4\\operatorname{cos}⁡(x)) \\\\  & =-2{e}^{-4\\operatorname{sin}⁡(x)}\\operatorname{cos}⁡(x) \\\\  & =-\\frac{2\\operatorname{cos}⁡(x)}{{e}^{4\\operatorname{sin}⁡(x)}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad776a9-f4a0-5e5c-a3f9-720c0f51d8db" :answer/type {:db/ident :answer.type/math} :answer/value "-5{x}^{4}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186241411} {:answer/id #uuid "2b4eb06f-e217-5ea4-b6a5-fd33dc42e528" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{4}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186241563} {:answer/id #uuid "6f6b602b-df9a-5236-8240-b5610aba6892" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186242173} {:answer/id #uuid "830d7ceb-1451-565b-a032-3b85a06189f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{x}^{2}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186242323} {:answer/id #uuid "ee1d283c-0aa8-54f8-8845-20de899f1a2a" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{5}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186243290}] :answer-field/correct {:answer/id #uuid "2b4eb06f-e217-5ea4-b6a5-fd33dc42e528" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{4}{e}^{{x}^{5}+1}" :db/id #edb/ref 17592186241563} :answer-field/id #uuid "d9d8a733-77cf-5587-abae-2d5e6d3cb563" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243816}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6db51996-7191-5665-ba1d-2ca54d5c9e73" :question/math-academy-id "q-107437" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{{x}^{5}+1}.$" :question/worked-solution "First we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u={x}^{5}+1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (5{x}^{4}) \\\\  & =5{x}^{4}{e}^{u} \\\\  & =5{x}^{4}{e}^{{x}^{5}+1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100855dc-01a1-54eb-889b-5c5849671fed" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241318} {:answer/id #uuid "412016b5-7fcf-5318-88ca-74a5337fd439" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241764} {:answer/id #uuid "b3c2451f-e77c-598c-a29b-975bfafc93b7" :answer/type {:db/ident :answer.type/math} :answer/value "(2x+2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186242750} {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} {:answer/id #uuid "e95fa722-682a-5996-bbc5-42651cbf8584" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243242}] :answer-field/correct {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} :answer-field/id #uuid "666980b0-ea06-5cc6-8aba-d89d9e6e8dd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243640}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "30a7e2e3-900c-5659-9ff0-e1c7283ea786" :question/math-academy-id "q-107445" :question/problem "Given that $y={e}^{{x}^{2}-2x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{2}-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x-2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x-2) \\\\  & =(2x-2){e}^{u} \\\\  & =(2x-2){e}^{{x}^{2}-2x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e4e1491-e222-5802-886e-742231f78057" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186242027} {:answer/id #uuid "7723f856-56f5-5fee-abc8-1ff5e841e23c" :answer/type {:db/ident :answer.type/math} :answer/value "6e" :db/id #edb/ref 17592186242235} {:answer/id #uuid "a1ea903b-13e1-5dd4-9c7a-d0effe5e2d14" :answer/type {:db/ident :answer.type/math} :answer/value "-6{e}^{3}" :db/id #edb/ref 17592186242598} {:answer/id #uuid "a87df020-501d-5562-907f-215a3c896761" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{{e}^{3}}" :db/id #edb/ref 17592186242659} {:answer/id #uuid "b5b77e66-762b-57c0-a0ff-fd2e1fa2a094" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{3}" :db/id #edb/ref 17592186242766}] :answer-field/correct {:answer/id #uuid "5e4e1491-e222-5802-886e-742231f78057" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186242027} :answer-field/id #uuid "902db5d9-f439-5129-b87b-ab1648bec205" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243706}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "61336957-36ed-5998-bb55-140d4de08baf" :question/math-academy-id "q-107449" :question/problem "Find the slope of the tangent to the curve $y={e}^{3{x}^{2}-3}$ at the point where $x=-1.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=3{x}^{2}-3.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=6x.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 6x \\\\  & =6x\\cdot {e}^{u} \\\\  & =6x{e}^{3{x}^{2}-3}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=-1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} & ={6x{e}^{3{x}^{2}-3}|}_{x=-1} \\\\  & =6(-1){e}^{3(-1)^{2}-3} \\\\  & =-6\\cdot {e}^{0} \\\\  & =-6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f51954f-ef10-5b61-8e64-a3c5da15b5b8" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186241888} {:answer/id #uuid "561e1348-b169-5b7b-9445-b0635e9a11e7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186241956} {:answer/id #uuid "662b5321-520e-54cd-9509-03f4e29b7113" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242102} {:answer/id #uuid "d763b1fc-ea11-5f90-95d1-e07b6b76e1cb" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186243092} {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251}] :answer-field/correct {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251} :answer-field/id #uuid "4a8beb4d-3f02-544b-a522-4d1a06ffa730" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243581}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f0b47caa-0fc0-55c4-b8be-d17c35ea6d3b" :question/math-academy-id "q-107452" :question/problem "Find the slope of the tangent to the curve $y={e}^{{x}^{3}-4x}$ at the point where $x=2.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{3}-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (3{x}^{2}-4) \\\\  & =(3{x}^{2}-4){e}^{{x}^{3}-4x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(3{x}^{2}-4){e}^{{x}^{3}-4x}\\,|}_{x=2} \\\\  & =(3(2)^{2}-4){e}^{{2}^{3}-4(2)} \\\\  & =8\\cdot {e}^{0} \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bbc6124-c201-533d-8a89-7b77ca50d995" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{4}{e}^{4{x}^{5}}" :db/id #edb/ref 17592186295698}] :answer-field/correct {:answer/id #uuid "4bbc6124-c201-533d-8a89-7b77ca50d995" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{4}{e}^{4{x}^{5}}" :db/id #edb/ref 17592186295698} :answer-field/id #uuid "93a5b787-ef54-5338-bc44-45f2d399376a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296938}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "487ee789-7ad7-529c-b59f-58c0bcaef3bf" :question/math-academy-id "q-312451" :question/problem "Given that $f(x)={e}^{4{x}^{5}},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=4{x}^{5}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=20{x}^{4}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (20{x}^{4}) \\\\  & =20{x}^{4}{e}^{u} \\\\  & =20{x}^{4}{e}^{4{x}^{5}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "804c89d6-ac48-5950-9eea-d3b372fd6ba9" :answer/type {:db/ident :answer.type/math} :answer/value "12{e}^{4}" :db/id #edb/ref 17592186313008}] :answer-field/correct {:answer/id #uuid "804c89d6-ac48-5950-9eea-d3b372fd6ba9" :answer/type {:db/ident :answer.type/math} :answer/value "12{e}^{4}" :db/id #edb/ref 17592186313008} :answer-field/id #uuid "54daf3d6-e597-5f82-adf6-49dc58401548" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314249}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "85e8601e-9018-5cbf-862d-85832e302cc6" :question/math-academy-id "q-340949" :question/problem "Find the slope $m$ of the tangent to the curve $y={e}^{4{x}^{3}}$ at the point where $x=1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=4{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=12{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (12{x}^{2}) \\\\  & =12{x}^{2}{e}^{u} \\\\  & =12{x}^{2}{e}^{4{x}^{3}}.\\end{aligned}\n$$\n\nFinally, to find the slope $m$ of the tangent to the curve at $x=1$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}m={\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(12{x}^{2}{e}^{4{x}^{3}})|}_{x=1} \\\\  & =12(1)^{2}{e}^{4(1)^{3}} \\\\  & =12{e}^{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b1c38d-bd47-595a-85a4-aaa20457bc59" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{2}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186327383} {:answer/id #uuid "87871190-a65e-5c1e-8282-1faf7bde4a6f" :answer/type {:db/ident :answer.type/math} :answer/value "(8-6{x}^{2}){e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328101} {:answer/id #uuid "b8909401-18d1-5019-a6f0-ca794f50ba31" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{4}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328540} {:answer/id #uuid "c387f8bc-a855-544f-9080-010895d03bd3" :answer/type {:db/ident :answer.type/math} :answer/value "-6{x}^{2}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328643} {:answer/id #uuid "e092d66a-dbb8-5e12-ab82-47da6c4607df" :answer/type {:db/ident :answer.type/math} :answer/value "-6{x}^{4}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328899}] :answer-field/correct {:answer/id #uuid "c387f8bc-a855-544f-9080-010895d03bd3" :answer/type {:db/ident :answer.type/math} :answer/value "-6{x}^{2}{e}^{8-2{x}^{3}}" :db/id #edb/ref 17592186328643} :answer-field/id #uuid "025f7489-d455-5ba5-a862-9edaba9cd328" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329189}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "97112097-e97d-59a1-a70d-99c7a4daf89b" :question/math-academy-id "q-48629" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{8-2{x}^{3}}.$" :question/worked-solution "First we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=8-2{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-6{x}^{2}) \\\\  & =-6{x}^{2}{e}^{8-2{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6de9ff01-0b1f-56cd-885f-31d83a6b64e3" :answer/type {:db/ident :answer.type/math} :answer/value "8x{e}^{{x}^{2}}" :db/id #edb/ref 17592186337007} {:answer/id #uuid "767d6034-4f15-5263-ac09-9c05f7472792" :answer/type {:db/ident :answer.type/math} :answer/value "8{x}^{3}{e}^{{x}^{3}}" :db/id #edb/ref 17592186337099} {:answer/id #uuid "863405a3-9a66-5ca8-8f7d-483681a818bd" :answer/type {:db/ident :answer.type/math} :answer/value "9{x}^{2}{e}^{8{x}^{4}}" :db/id #edb/ref 17592186337245} {:answer/id #uuid "bbec19e9-c6de-585e-af2b-e55511e50cc2" :answer/type {:db/ident :answer.type/math} :answer/value "8{x}^{3}{e}^{2{x}^{4}}" :db/id #edb/ref 17592186337701} {:answer/id #uuid "dcd7048a-7f6e-500d-bd2e-6421b3f20cac" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}{e}^{2{x}^{4}}" :db/id #edb/ref 17592186337952}] :answer-field/correct {:answer/id #uuid "bbec19e9-c6de-585e-af2b-e55511e50cc2" :answer/type {:db/ident :answer.type/math} :answer/value "8{x}^{3}{e}^{2{x}^{4}}" :db/id #edb/ref 17592186337701} :answer-field/id #uuid "19f83298-fbd1-5427-81bb-2dc30205845b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338323}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "44577a72-fe3b-5755-87e3-6deb6a748e27" :question/math-academy-id "q-71873" :question/problem "Given that $y={e}^{2{x}^{4}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u=2{x}^{4}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8{x}^{3}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (8{x}^{3}) \\\\  & =8{x}^{3}{e}^{u} \\\\  & =8{x}^{3}{e}^{2{x}^{4}}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] [{:db/id #edb/ref 17592186092273 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092112 :question/id #uuid "f0c5bd75-dd47-5028-8eff-38c87e7411bf" :question/math-academy-id "e-7116" :question/problem "The diagram below shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $\\left(3,\\dfrac{\\pi}{4}\\right)$ and $m \\angle AOB=\\dfrac{\\pi}{2},$ what are the Cartesian coordinates of $B?$\n\n![](images/a0/a0d06318ba26eee754bc3581f5a0f1c126eb0723f8aea2cac0fad075ee56e7f9.png)" :question/worked-solution "First, since $A$ has polar coordinates $\\left(3,\\dfrac{\\pi}{4}\\right),$ we must have $r=3.$ Also, since the points $A$ and $B$ both lie on a circle of radius $3,$ the $r$-coordinate of $B$ must also be $3.$\n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta$-coordinate of $A$ is $\\dfrac{\\pi}{4},$ the $\\theta$-coordinate of $B$ must be\n\n$$\n\\theta_B = \\dfrac{\\pi}{4}+\\dfrac{\\pi}{2} = \\dfrac{3\\pi}{4}.\n$$\n\nSo, the polar coordinates of $B$ are $\\left(3,\\dfrac{3\\pi}{4}\\right)$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx = r\\cos\\theta, \\qquad y=r\\sin\\theta.\n$$\n\nFirst, we calculate the $x$-coordinate of $B\\mathbin{:}$\n\n$$\n\\eqalign{\n\t\tx &= r\\cos\\theta\\[5pt]\n\t\t &=3\\cos\\left(\\dfrac{3\\pi}{4} \\right)\\[5pt]\n\t\t &=3\\left(-\\dfrac{\\sqrt{2}}{2}\\right)\\[5pt]\n\t\t &=-\\dfrac{3\\sqrt 2}{2}\n\t}\n$$\n\nThen, we calculate the $y$-coordinate of $B\\mathbin{:}$\n\n$$\n\\eqalign{\n\t\ty &= r\\sin\\theta\\[5pt]\n\t\t &= 3\\sin\\left(\\dfrac{3\\pi}{4} \\right)\\[5pt]\n\t\t &= 3\\cdot\\dfrac{\\sqrt{2}}{2}\\[5pt]\n\t\t &=\\dfrac{3\\sqrt 2}{2}\n\t}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $\\left(-\\dfrac{3\\sqrt 2}{2},\\dfrac{3\\sqrt 2}{2}\\right).$"} :knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529" :knowledge-point/questions [{:db/id #edb/ref 17592186092705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d121349d-31c9-5bac-922f-a3d7427c2e17" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{2}, 4\\sqrt{3})" :db/id #edb/ref 17592186090431} {:answer/id #uuid "d94ac2cb-77dc-5c8e-8b60-7ebe1cd327a1" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 2\\sqrt{3})" :db/id #edb/ref 17592186090432} {:answer/id #uuid "00cc892a-647a-5731-8038-c03a6486c06e" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 2\\sqrt{2})" :db/id #edb/ref 17592186090433} {:answer/id #uuid "351d03cf-8046-5fde-9515-8c70b37ccacf" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{2}, 4\\sqrt{2})" :db/id #edb/ref 17592186090434} {:answer/id #uuid "6a204728-2a70-5b4e-a407-acd285e5b284" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 4\\sqrt{3})" :db/id #edb/ref 17592186090435}] :answer-field/id #uuid "ab58c44e-78a4-588e-a3bb-863a1a4a410d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090430}] :question/id #uuid "1ce6ea90-167e-5e84-81ba-98cd4696c493" :question/math-academy-id "q-40920" :question/problem "![](images/d8/d8fd52f3c965f041ea3e9bbc4e8a9705c49ec95be105653d869a0443fa97fac9.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(8, \\frac{π}{4})$ and $m∠AOB = \\frac{5π}{12}$, what are the Cartesian coordinates of $B$?"} {:db/id #edb/ref 17592186092706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee1ace03-46fb-5027-9235-084445577994" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{3}, 2)" :db/id #edb/ref 17592186090437} {:answer/id #uuid "255dd244-f72a-5bd1-aede-078a04b6d5d8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2\\sqrt{3}, 2\\sqrt{3})" :db/id #edb/ref 17592186090438} {:answer/id #uuid "3b187ede-27c7-5c96-98e5-d476e31f991b" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{2}, 3\\sqrt{2})" :db/id #edb/ref 17592186090439} {:answer/id #uuid "4ad01eed-2a28-57ef-8f83-88b52a9d0ee6" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{3}, 3)" :db/id #edb/ref 17592186090440} {:answer/id #uuid "6eb7380d-f51d-526c-a08f-ae184cdbb5bd" :answer/type {:db/ident :answer.type/math} :answer/value "(-3, 2\\sqrt{3})" :db/id #edb/ref 17592186090441}] :answer-field/id #uuid "75eac4b1-2ea4-536a-9d02-dcb0cd0092c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090436}] :question/id #uuid "8f2d9d99-cff8-53e7-a4e3-be764ae4d44f" :question/math-academy-id "q-40922" :question/problem "![](images/ee/eed8bcd0866e87fabdb6a87b8a0c4622c61871222c46e7b616927fc3ced4c129.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(6, 210^{∘})$ and $m∠AOB = 75^{∘}$, what are the Cartesian coordinates of $B$?"} {:db/id #edb/ref 17592186256423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5da02127-9e0f-517d-b833-10a14ea966be" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3\\sqrt{3})" :db/id #edb/ref 17592186254500} {:answer/id #uuid "872e2a4f-200b-5af7-8500-67bf6abe3f22" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186254867} {:answer/id #uuid "aa36bbb1-b88c-5b72-bb8b-94823eb95074" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},\\sqrt{3})" :db/id #edb/ref 17592186255175} {:answer/id #uuid "d7f185a7-e803-56ef-9e38-6ce29b1a5f8f" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},3)" :db/id #edb/ref 17592186255586} {:answer/id #uuid "e8f56308-c9ed-5d20-99cf-9b1ba40c9435" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},3\\sqrt{3})" :db/id #edb/ref 17592186255716}] :answer-field/correct {:answer/id #uuid "5da02127-9e0f-517d-b833-10a14ea966be" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3\\sqrt{3})" :db/id #edb/ref 17592186254500} :answer-field/id #uuid "562137bc-c0ee-5964-b8f9-1d239f29ef6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256088}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ec6a7f4f-9f9a-5a0c-bdce-ef6083c2204a" :question/math-academy-id "q-120593" :question/problem "![](images/48/48517c5d3fa340bed1cc7b5493f0099a72afa79d9e0690b79695afe018c8a05c.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(6,\\frac{\\pi }{6})$ and $m∠AOB=\\frac{\\pi }{2},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(6,\\frac{\\pi }{6}),$ we must have $r=6.$ Also, since the points $A$ and $B$ both lie on a circle of radius $6,$ the $r$-coordinate of $B$ must also be $6.$ \n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{\\pi }{6}+\\frac{\\pi }{2}=\\frac{2\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(6,\\frac{2\\pi }{3})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6(-\\frac{1}{2}) \\\\  & =-3\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6(\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-3,3\\sqrt{3}).$"} {:db/id #edb/ref 17592186256424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b0831bf-55aa-510a-918a-90cd99cdc701" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186254315} {:answer/id #uuid "54a4837d-2402-5b85-885b-20b64294842f" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{3},2\\sqrt{3})" :db/id #edb/ref 17592186254408} {:answer/id #uuid "7962a6c2-849e-5bfd-90f7-16eb630fa284" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{3},-2)" :db/id #edb/ref 17592186254745} {:answer/id #uuid "87c149ae-d2b4-5a7d-8b6f-ca93c28e9563" :answer/type {:db/ident :answer.type/math} :answer/value "(-2\\sqrt{3},2)" :db/id #edb/ref 17592186254874} {:answer/id #uuid "f870bd85-6f4b-5e70-909a-8712db2320fe" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,2\\sqrt{3})" :db/id #edb/ref 17592186255845}] :answer-field/correct {:answer/id #uuid "f870bd85-6f4b-5e70-909a-8712db2320fe" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,2\\sqrt{3})" :db/id #edb/ref 17592186255845} :answer-field/id #uuid "da62c4ed-dbe1-5f2f-b50d-04b6985ed206" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256309}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0eb03380-bb2e-5373-833c-3b08aac5da8c" :question/math-academy-id "q-120595" :question/problem "![](images/5f/5ff0219f3f76441dbffc770ce0b8f2481cca8c46b8aa832ab7893d472f3026ae.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(4,\\frac{5\\pi }{6})$ and $m∠AOB=\\frac{\\pi }{6},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(4,\\frac{5\\pi }{6}),$ we must have $r=4.$ Also, since the points $A$ and $B$ both lie on a circle of radius $4,$ the $r$-coordinate of $B$ must also be $4.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{5\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{5\\pi }{6}-\\frac{\\pi }{6}=\\frac{2\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(4,\\frac{2\\pi }{3})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =4\\cdot (-\\frac{1}{2}) \\\\  & =-2\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =4\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =2\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-2,2\\sqrt{3}).$"} {:db/id #edb/ref 17592186256425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0484ad77-2f99-5c81-a6cb-a1158be44d88" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186253704} {:answer/id #uuid "15246ab6-3ecb-5633-9b4e-b73f8ed07f54" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},-4)" :db/id #edb/ref 17592186253853} {:answer/id #uuid "31095a2e-0934-55af-abe5-a2f05014f85f" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186254098} {:answer/id #uuid "3f307f37-58c4-56a4-a6dd-e9b99b686e71" :answer/type {:db/ident :answer.type/math} :answer/value "(4,4\\sqrt{2})" :db/id #edb/ref 17592186254213} {:answer/id #uuid "e1629e74-354a-56e5-bbe5-bfd524f9a56f" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-2\\sqrt{2})" :db/id #edb/ref 17592186255670}] :answer-field/correct {:answer/id #uuid "31095a2e-0934-55af-abe5-a2f05014f85f" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186254098} :answer-field/id #uuid "e62cfd60-2bdd-5ae1-8632-0391624de18c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256330}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4cadc848-bed5-5538-a431-ac83515fffa4" :question/math-academy-id "q-120597" :question/problem "![](images/fd/fd38e4bed4f11f07f2c6901a74c7543655f5ff8a95b8b049e54ff4ff4dd409ee.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(4\\sqrt{2},{150}^{∘})$ and $m∠AOB={165}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(4\\sqrt{2},{150}^{∘}),$ we must have $r=4\\sqrt{2}.$ Also, since the points $A$ and $B$ both lie on a circle of radius $4\\sqrt{2},$ the $r$-coordinate of $B$ must also be $4\\sqrt{2}.$  \n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${150}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={150}^{∘}+{165}^{∘}={315}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(4\\sqrt{2},{315}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡({315}^{∘}) \\\\  & =4\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\sqrt{2}\\operatorname{sin}⁡({315}^{∘}) \\\\  & =4\\sqrt{2}(-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(4,-4).$"} {:db/id #edb/ref 17592186256426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9724a5f6-c9f4-536a-a17b-5425407b9c7d" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186255002} {:answer/id #uuid "ea54590c-b0df-5003-9417-4c09af7236b1" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186255723} {:answer/id #uuid "eb87a981-771e-5056-8d37-a93f3b1e2bef" :answer/type {:db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186255730} {:answer/id #uuid "feab8e4b-ee4c-5116-8ef8-f1f48cf2bd2f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},2)" :db/id #edb/ref 17592186255909} {:answer/id #uuid "ff088a24-bea8-531d-8f92-d5dff5c8b72a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,\\sqrt{2})" :db/id #edb/ref 17592186255913}] :answer-field/correct {:answer/id #uuid "ea54590c-b0df-5003-9417-4c09af7236b1" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186255723} :answer-field/id #uuid "47c6223c-72f8-56bd-b93f-b161db175405" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256059}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1f77f386-bd94-517d-b58d-73799834bcb9" :question/math-academy-id "q-120598" :question/problem "![](images/47/475bda1ee758774ec9b07ec12a0ed92e56c4b571fd39f6e1ecca439278106ea6.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(2,{240}^{∘})$ and $m∠AOB={195}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(2,{240}^{∘}),$ we must have $r=2.$ Also, since the points $A$ and $B$ both lie on a circle of radius $2,$ the $r$-coordinate of $B$ must also be $2.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${240}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={240}^{∘}-{195}^{∘}={45}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(2,{45}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡({45}^{∘}) \\\\  & =2(\\frac{\\sqrt{2}}{2}) \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡({45}^{∘}) \\\\  & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\sqrt{2},\\sqrt{2}).$"} {:db/id #edb/ref 17592186294889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9601aa2e-abda-5507-ad25-c4cf0d606ed2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186293522}] :answer-field/correct {:answer/id #uuid "9601aa2e-abda-5507-ad25-c4cf0d606ed2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186293522} :answer-field/id #uuid "13aa7ac9-c9db-5cb2-a8e4-6b8e1ab477fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293993} {:answer-field/choices [{:answer/id #uuid "c520d556-f1f8-5b44-ba0f-87c690254537" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293697}] :answer-field/correct {:answer/id #uuid "c520d556-f1f8-5b44-ba0f-87c690254537" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293697} :answer-field/id #uuid "422e7132-f763-5853-af40-ea2fb905c278" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294161}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3c0494bb-9b54-5cfd-9186-bd801e2eaf2d" :question/math-academy-id "q-277012" :question/problem "![](images/d9/d931b377a8d62bf3b56672a0f556c0581e8400c5b1c7b1f783f08e4297342855.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. Determine the Cartesian coordinates of $B$ given that the polar coordinates of the point $A$ are $(4,{240}^{∘})$ and $m∠AOB={210}^{∘}.$\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, since $A$ has polar coordinates $(4,{240}^{∘}),$ we must have $r=4.$ Also, since the points $A$ and $B$ both lie on a circle of radius $4,$ the $r$-coordinate of $B$ must also be $4.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${240}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={240}^{∘}-{210}^{∘}={30}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(4,{30}^{∘})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡({30}^{∘}) \\\\  & =4\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =2\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡({30}^{∘}) \\\\  & =4\\cdot \\frac{1}{2} \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(2\\sqrt{3},2).$"} {:db/id #edb/ref 17592186294890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e3ea9aa-2309-5688-8b5e-dd148f86cfd5" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293482}] :answer-field/correct {:answer/id #uuid "8e3ea9aa-2309-5688-8b5e-dd148f86cfd5" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186293482} :answer-field/id #uuid "e142ea0a-9b5f-51f6-80c8-47978bf6ecdf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294719} {:answer-field/choices [{:answer/id #uuid "c9b12f13-f42a-5b68-a20b-fb1c035b77fd" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186293714}] :answer-field/correct {:answer/id #uuid "c9b12f13-f42a-5b68-a20b-fb1c035b77fd" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186293714} :answer-field/id #uuid "f2b0d2fd-d64a-5114-8b1b-0b8b6064a336" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294783}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fb90e8f9-7bb2-5ebe-9317-d50976c6167d" :question/math-academy-id "q-277027" :question/problem "![](images/db/dbca0b9bd96eb68b7f874df74848bb887037a7de2ed7613bc848c40f78feff4f.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. Determine the Cartesian coordinates of $B$ given that the polar coordinates of the point $A$ are $(10,{60}^{∘})$ and $m∠AOB={60}^{∘}.$\n\nThe Cartesian coordinates of $B$ are $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "First, since $A$ has polar coordinates $(10,{60}^{∘}),$ we must have $r=10.$ Also, since the points $A$ and $B$ both lie on a circle of radius $10,$ the $r$-coordinate of $B$ must also be $10.$\n\nNotice that one must traverse the circle counter-clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${60}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={60}^{∘}+{60}^{∘}={120}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(10,{120}^{∘})$ \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =10\\operatorname{cos}⁡({120}^{∘}) \\\\  & =10\\cdot (-\\frac{1}{2}) \\\\  & =-5\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =10\\operatorname{sin}⁡({120}^{∘}) \\\\  & =10\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =5\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-5,5\\sqrt{3}).$"} {:db/id #edb/ref 17592186351267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19aefefa-5028-5a51-9e4a-e7a5f85a0ecd" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3},4)" :db/id #edb/ref 17592186348661} {:answer/id #uuid "31c265f3-9b60-519e-8c42-a2074afe1991" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{2},4)" :db/id #edb/ref 17592186348888} {:answer/id #uuid "61e897c5-e855-5435-b9a3-3ce1fe3df228" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5\\sqrt{2}}{2},\\frac{9}{2})" :db/id #edb/ref 17592186349343} {:answer/id #uuid "6bdd275f-98a8-5d3a-be25-406316b4b4e3" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{2},\\frac{5\\sqrt{3}}{2})" :db/id #edb/ref 17592186349442} {:answer/id #uuid "a8ea7143-6d50-55a0-8054-cb45eeb37658" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{2},\\frac{9}{2})" :db/id #edb/ref 17592186349952}] :answer-field/correct {:answer/id #uuid "6bdd275f-98a8-5d3a-be25-406316b4b4e3" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{2},\\frac{5\\sqrt{3}}{2})" :db/id #edb/ref 17592186349442} :answer-field/id #uuid "7ce1ae29-1a77-542a-a894-431caec80306" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350924}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e4c53f6c-deac-537d-ad18-d2272f3b99d1" :question/math-academy-id "q-81221" :question/problem "![](images/6e/6e9d2238ca77532c3adda8d35f94061d108c3e15432ce48fdc33885ddf4f4e48.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(5,\\frac{7\\pi }{6})$ and $m∠AOB=\\frac{5\\pi }{6},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(5,\\frac{7\\pi }{6}),$ we must have $r=5.$ Also, since the points $A$ and $B$ both lie on a circle of radius $5,$ the $r$-coordinate of $B$ must also be $5.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{7\\pi }{6},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{7\\pi }{6}-\\frac{5\\pi }{6}=\\frac{\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(5,\\frac{\\pi }{3})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{cos}⁡(\\frac{\\pi }{3}) \\\\  & =5\\cdot \\frac{1}{2} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =5\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{5\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\frac{5}{2},\\frac{5\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186351268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a38cdd4-2914-5fbf-af5a-f896fca82487" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{11}{2},-4\\sqrt{2})" :db/id #edb/ref 17592186348534} {:answer/id #uuid "46388f94-0b9a-5819-926f-46042d3247f3" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,-4\\sqrt{2})" :db/id #edb/ref 17592186349085} {:answer/id #uuid "46e780ae-e427-5db3-9e7b-87fd979da562" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-5\\sqrt{3})" :db/id #edb/ref 17592186349091} {:answer/id #uuid "de7003e9-ed40-536d-a5eb-03ffaab61707" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-5\\sqrt{3})" :db/id #edb/ref 17592186350392} {:answer/id #uuid "e8f16d9b-438b-5abd-801a-9c54b0392c42" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-4\\sqrt{6})" :db/id #edb/ref 17592186350488}] :answer-field/correct {:answer/id #uuid "de7003e9-ed40-536d-a5eb-03ffaab61707" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-5\\sqrt{3})" :db/id #edb/ref 17592186350392} :answer-field/id #uuid "07393c80-442e-58d3-986a-670d473a0e30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350717}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ebfe6ff0-a2a2-5246-ac85-4546ec479cc9" :question/math-academy-id "q-81224" :question/problem "![](images/a6/a615f7a80b81f89fccd8c82bf65d65e3a4a65958ec8a6fbc746ae68749949a87.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(10,\\frac{\\pi }{3})$ and $m∠AOB=\\pi ,$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(10,\\frac{\\pi }{3}),$ we must have $r=10.$ Also, since the points $A$ and $B$ both lie on a circle of radius $10,$ the $r$-coordinate of $B$ must also be $10.$\n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is $\\frac{\\pi }{3},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}=\\frac{\\pi }{3}+\\pi =\\frac{4\\pi }{3}.\n$$\n\nSo, the polar coordinates of $B$ are $(10,\\frac{4\\pi }{3})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =10\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{1}{2}) \\\\  & =-5\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =10\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =10(-\\frac{\\sqrt{3}}{2}) \\\\  & =-5\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(-5,-5\\sqrt{3}).$"}] :knowledge-point/title "Finding the Cartesian Coordinates of a Point Using a Diagram"}] [{:db/id #edb/ref 17592186092375 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092081 :question/id #uuid "1957007f-eabd-5d40-8f59-ff635ea1d539" :question/math-academy-id "e-602" :question/problem "![](images/83/834eff403ac2a6f696e104ec914cac1b951f8a6d989e11c0e9f2576ac9e7f0d8.png)\n\nFind an integral expression for the arc length of the curve defined parametrically as\n\n$$\nx=1-t, \\quad y= \\dfrac{2}{3} t^{3/2}, \\qquad t\\in[0,1].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-t)=-1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{3}{t}^{3/2})={t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(-1)}^{2}+{({t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{1+t}\\,\\text{d}t.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52" :knowledge-point/questions [{:db/id #edb/ref 17592186092574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "980c32be-9337-5148-aafb-c9804c249b8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{-1}^{1}\\sqrt{9t^{4} + 12t^{2} + 4}dt" :db/id #edb/ref 17592186089616} {:answer/id #uuid "c7597a52-6382-5d77-a48e-c688a94aa2da" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-1}^{1}\\sqrt{t^{4} + 4t^{2} + 2}dt" :db/id #edb/ref 17592186089617} {:answer/id #uuid "05072a23-fdb5-5ea9-91d2-634bdb351f17" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-1}^{1}\\sqrt{t^{4} + 4t^{2} + 1}dt" :db/id #edb/ref 17592186089618} {:answer/id #uuid "150cbc59-2ca7-54ec-a6a8-67ca6cba9c5f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{-1}^{1}\\sqrt{t^{4} + t^{2} + 1}dt" :db/id #edb/ref 17592186089619} {:answer/id #uuid "4fb7b801-40e5-58de-b29f-fe621d66b0b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{-1}^{1}\\sqrt{9t^{4} + 16t^{2} + 4}dt" :db/id #edb/ref 17592186089620}] :answer-field/id #uuid "4cc9cbdc-b53f-5d3e-98b2-5cf0e50befd3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089615}] :question/id #uuid "f0d23e0d-f38a-562a-8c27-86c2428291ae" :question/math-academy-id "q-15172" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x = t^{2} + 1, y = t^{3} + 2t$\nfrom $t =-1$ to $t = 1$?"} {:db/id #edb/ref 17592186092826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a124acdc-e495-5b11-b2b6-753bf6e46659" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-3}^{2}\\sqrt{2t^{4} - t^{2} + 2t + 1}dt" :db/id #edb/ref 17592186091157} {:answer/id #uuid "b1926fa9-7a78-5623-aaed-effce755523c" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{-3}^{2}\\sqrt{2t^{2} + t + 1}dt" :db/id #edb/ref 17592186091158} {:answer/id #uuid "d3611a38-c0b5-5dc9-9132-078542d94502" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{-3}^{2}\\sqrt{t^{4} - t^{2} + t + 1}dt" :db/id #edb/ref 17592186091159} {:answer/id #uuid "2fde0d28-04a8-5bdc-956f-de766ab86529" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-3}^{2}\\sqrt{t^{4} - t^{2} + 2t + 2}dt" :db/id #edb/ref 17592186091160} {:answer/id #uuid "57d3f5ba-4367-5524-a843-57e49b68ed77" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-3}^{2}\\sqrt{t^{2} + 2t + 2}dt" :db/id #edb/ref 17592186091161}] :answer-field/id #uuid "c7484595-bd71-5a88-ac55-560af2ce4f19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091156}] :question/id #uuid "767ca9bf-bda6-519c-b045-66d55d563e0c" :question/math-academy-id "q-81437" :question/problem "![](images/2c/2c96a0fc119984b83ba68a0cfc50540563a3ea76cc887d3e184238250773e91b.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x = t^{2} + 2t + 1, y = \\frac{2}{3}t^{3} - 2t$\nfrom $t =-3$ to $t = 2$ (shown above)?"} {:db/id #edb/ref 17592186256770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1691c723-a29f-5657-aee7-eec47906ae55" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-2}^{3}\\sqrt{8{t}^{6}+9{t}^{4}+20{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186253864} {:answer/id #uuid "52ebc669-036d-52bd-bd42-f8a9effb2d03" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{3}\\sqrt{{t}^{6}+{t}^{4}+{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186254393} {:answer/id #uuid "aea928a3-cf09-5314-9b87-9ec1f92f214b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186255207} {:answer/id #uuid "b39d0d7c-49b9-5298-8296-ac358a89bec4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{4{t}^{6}+3{t}^{4}+4{t}^{3}+5}\\,\\text{d}t" :db/id #edb/ref 17592186255251} {:answer/id #uuid "ff64285b-3a4e-5ddc-aa99-b508b397f090" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+49{t}^{4}+25}\\,\\text{d}t" :db/id #edb/ref 17592186255918}] :answer-field/correct {:answer/id #uuid "aea928a3-cf09-5314-9b87-9ec1f92f214b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186255207} :answer-field/id #uuid "2ac33bf7-e329-5540-9b40-ace253188539" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255997}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1ac06717-3d6e-5cb8-bb53-88e2680a811e" :question/math-academy-id "q-123005" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-8,\\,y={t}^{4}+5t$\nfrom $t=-2$ to $t=3$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-8)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}+5t)=4{t}^{3}+5\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{{(3{t}^{2})}^{2}+{(4{t}^{3}+5)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{9{t}^{4}+16{t}^{6}+40{t}^{3}+25}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070a4318-5841-5f5c-8d72-6fb59872fc0e" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{18{t}^{2}-12}\\,\\text{d}t" :db/id #edb/ref 17592186253722} {:answer/id #uuid "17d49195-6be3-5ce7-aa2a-921578f62915" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t" :db/id #edb/ref 17592186253877} {:answer/id #uuid "3741fd0d-810d-5265-b32c-6114a62fde8f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{6{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186254148} {:answer/id #uuid "4cd7ccb4-e388-5676-9be3-2b14b685baf5" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{1}\\sqrt{36{t}^{2}+5t}\\,\\text{d}t" :db/id #edb/ref 17592186254331} {:answer/id #uuid "528db892-4fe7-531e-81df-1965b9853c97" :answer/type {:db/ident :answer.type/math} :answer/value "5{\\int }_{0}^{1}\\sqrt{{t}^{2}+5}\\,\\text{d}t" :db/id #edb/ref 17592186254391}] :answer-field/correct {:answer/id #uuid "17d49195-6be3-5ce7-aa2a-921578f62915" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t" :db/id #edb/ref 17592186253877} :answer-field/id #uuid "c9c515a7-5b1f-551b-a793-9f6e12bfd819" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256279}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a6c68291-2bb7-56b1-a306-1312ff237a63" :question/math-academy-id "q-123019" :question/problem "![](images/0a/0a58808ee9b20e201d1ea8a31683f742e02f739127640de2fea87ce4757e7901.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{2},\\,y=5t$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5t)=5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(6t)^{2}+(5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2107bda6-d473-50dd-ba60-ad2a320b0aed" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-1}^{2}\\sqrt{27{t}^{4}+4{t}^{2}-t+6}\\,\\text{d}t" :db/id #edb/ref 17592186253962} {:answer/id #uuid "3421b0d5-8f17-526e-9dba-9537c508fcc2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{9{t}^{4}+4{t}^{2}-20t+5}\\,\\text{d}t" :db/id #edb/ref 17592186254121} {:answer/id #uuid "6c853f8d-b33e-5895-ba0b-c7a9e2102da5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{85{t}^{4}-20t+25}\\,\\text{d}t" :db/id #edb/ref 17592186254634} {:answer/id #uuid "8799eb05-fe1e-5cc8-b350-130c501b0286" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{2}\\sqrt{9{t}^{4}+{t}^{2}-5t+6}\\,\\text{d}t" :db/id #edb/ref 17592186254873} {:answer/id #uuid "d79fac35-f1e8-5450-97f3-86f17fbbb483" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t" :db/id #edb/ref 17592186255579}] :answer-field/correct {:answer/id #uuid "d79fac35-f1e8-5450-97f3-86f17fbbb483" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t" :db/id #edb/ref 17592186255579} :answer-field/id #uuid "132e3016-73cb-5474-ae06-aa55eeff7889" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255950}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a0cda492-f891-5b24-90a6-900da47a3f8d" :question/math-academy-id "q-123025" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{3}+5,\\,y={t}^{2}-5t$\nfrom $t=-1$ to $t=2$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+5)=9{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-5t)=2t-5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{(9{t}^{2})^{2}+(2t-5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40667602-c7d2-52f3-b515-00979eaf90c3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{4+t+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349032} {:answer/id #uuid "514b71c4-dc4b-550b-a85a-0e54a3f5b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{4+4t+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349185} {:answer/id #uuid "5898362e-f963-559f-b809-786b12c62c78" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4t+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349260} {:answer/id #uuid "784441b4-8a2c-50a3-b06e-746d478ecd7a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{t+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349554} {:answer/id #uuid "caa71d58-f8d1-5f06-9145-4ddcc7adf731" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186350231}] :answer-field/correct {:answer/id #uuid "caa71d58-f8d1-5f06-9145-4ddcc7adf731" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186350231} :answer-field/id #uuid "7706adee-7a3b-5175-ab48-f3203b4530f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350913}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cc4af2ef-5b85-5a46-b1fb-ff4ea6d0758d" :question/math-academy-id "q-81377" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t-1,\\,y={t}^{2}+2$\nfrom $t=-1$ to $t=2$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-1)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+2)=2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{{(1)}^{2}+{(2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173b2b5c-5428-506b-9f15-da54e1e7da07" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+3}\\,\\text{d}t" :db/id #edb/ref 17592186348641} {:answer/id #uuid "1af0386f-90d9-5a79-afed-aa45754d349a" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186348677} {:answer/id #uuid "1ce5f7a3-81c2-5b76-a5e7-4963090954d7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186348699} {:answer/id #uuid "2c69be06-5fa9-5750-ba1a-4f53458bc229" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{2}+3}\\,\\text{d}t" :db/id #edb/ref 17592186348835} {:answer/id #uuid "d64b585a-e82a-5026-900a-c28a246b6b6b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186350328}] :answer-field/correct {:answer/id #uuid "1ce5f7a3-81c2-5b76-a5e7-4963090954d7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186348699} :answer-field/id #uuid "b11f3cba-eadf-5d36-86ff-2f0552d4e5e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351010}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f078660-763f-536d-9faf-52311fdcfddf" :question/math-academy-id "q-81380" :question/problem "![](images/12/120220c7c1a24c68c1a9282548efcf62c34fd110bd11911799a2a83409f257ab.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+1,\\,y=3t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+1)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3t)=3.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(3)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+9}\\,\\text{d}t \\\\  & =3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186394703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e2720b5-b7ef-506c-86d6-fa144d1dbad3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+2{t}^{2}-2t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394705} {:answer/id #uuid "962d9602-db26-5929-a1c1-0bd2caac4e94" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{3{t}^{2}+2t-1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394706} {:answer/id #uuid "2589a138-5496-5db8-b982-4b36bc678287" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{{t}^{2}-12t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394707} {:answer/id #uuid "d18f1c16-5f34-5e7a-96c8-21d14e6ab156" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{3{t}^{4}+4{t}^{2}-2t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394708} {:answer/id #uuid "1ee3240f-fc29-5617-8390-178d04eee2ef" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394709}] :answer-field/correct {:answer/id #uuid "1ee3240f-fc29-5617-8390-178d04eee2ef" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394709} :answer-field/id #uuid "f248aef5-8be7-5408-8afd-4afcb3aba568" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394704}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "77ecc403-c204-532a-a0f9-e871a850287a" :question/math-academy-id "q-85724" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-1,\\,y={t}^{2}-t$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)=2t-1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(3{t}^{2})^{2}+(2t-1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71b63c40-4166-58be-98ca-c4f5edc13748" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+t}\\,\\text{d}t" :db/id #edb/ref 17592186400074} {:answer/id #uuid "e8a8ab40-ccbb-5118-b2d9-f78348093f93" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186400075} {:answer/id #uuid "b749b256-812c-5226-8d12-e7a772eb2ad5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+3}\\,\\text{d}t" :db/id #edb/ref 17592186400076} {:answer/id #uuid "c9a93f8e-9a44-5007-89a0-efaebde7602c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+2}\\,\\text{d}t" :db/id #edb/ref 17592186400077} {:answer/id #uuid "bded8aee-c9b6-50a7-9080-88cf30b26b0a" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186400078}] :answer-field/correct {:answer/id #uuid "e8a8ab40-ccbb-5118-b2d9-f78348093f93" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186400075} :answer-field/id #uuid "d769d84c-e8c5-56e0-8e28-ef7348f0bb6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ce632c36-0a89-59ca-a425-8c378bad7972" :question/math-academy-id "q-123020" :question/problem "![](images/ae/ae210abc4028440aa9c822510d68f0ab0b8ba4b9f5806dd299149e953ccd1b21.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-4,\\,y=2t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2t)=2.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(2)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "925080f9-1488-5ed3-9988-57bac8e25aa1" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+2t+4}\\,\\text{d}t" :db/id #edb/ref 17592186401036} {:answer/id #uuid "8b14ae74-d72b-5c6f-bfb4-9fdf19b4b592" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+4}\\,\\text{d}t" :db/id #edb/ref 17592186401037} {:answer/id #uuid "c911c453-c1b3-506d-a7de-c8341e32d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/id #edb/ref 17592186401038} {:answer/id #uuid "69aeb839-370f-503b-8dde-d870cf822808" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}t\\sqrt{3{t}^{2}+2}\\,\\text{d}t" :db/id #edb/ref 17592186401039} {:answer/id #uuid "e1915447-2ced-5598-8af5-d918f3a8a810" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+24t+8}\\,\\text{d}t" :db/id #edb/ref 17592186401040}] :answer-field/correct {:answer/id #uuid "c911c453-c1b3-506d-a7de-c8341e32d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/id #edb/ref 17592186401038} :answer-field/id #uuid "9ac60323-fbe0-5435-bfb2-619a71c7a175" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dddf8a10-d360-5144-aae4-5bd6e2bd6915" :question/math-academy-id "q-15174" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+{t}^{2},\\,y={t}^{3}-{t}^{2}$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})=3{t}^{2}+2t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})=3{t}^{2}-2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(3{t}^{2}+2t)}^{2}+{(3{t}^{2}-2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+12{t}^{3}+4{t}^{2}+9{t}^{4}-12{t}^{3}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{18{t}^{4}+8{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve"}] [{:db/id #edb/ref 17592186092376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092113 :question/id #uuid "5bae6269-2112-56ea-b123-bee58701cf87" :question/math-academy-id "e-7130" :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](images/48/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(\\operatorname{cos}⁡t))=-\\operatorname{tan}⁡t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(1)}^{2}+{(-\\operatorname{tan}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+{tan}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{sec}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡t\\,\\text{d}t\\,.\\end{aligned}\n$$"} :knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3" :knowledge-point/questions [{:db/id #edb/ref 17592186092573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac7208bd-8759-509f-aec8-b72d63dc377b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{2\\sin^{2} (4t) + \\cos^{2} (t)}dt" :db/id #edb/ref 17592186089610} {:answer/id #uuid "c8e4a462-def2-5041-9d86-629d00d6c6f1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2}\\sqrt{\\sin^{2} (4t) + \\cos^{2} (t)}dt" :db/id #edb/ref 17592186089611} {:answer/id #uuid "e3499abe-efbf-509e-ba00-61325a39091c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{2\\cos^{2} (4t) + \\sin^{2} (t)}dt" :db/id #edb/ref 17592186089612} {:answer/id #uuid "e87d0171-bd01-58f1-a2a4-2a22124be105" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2}\\sqrt{\\cos^{2} (4t) + \\sin^{2} (t)}dt" :db/id #edb/ref 17592186089613} {:answer/id #uuid "3bf170f4-362e-577e-893f-a65fc8d4acae" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{\\cos^{2} (4t) + 2\\sin^{2} (t)}dt" :db/id #edb/ref 17592186089614}] :answer-field/id #uuid "13fc5e26-b2f3-5efb-bf53-9cf5f0c83d92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089609}] :question/id #uuid "2ac73185-5f28-5b9e-aeb9-15f1142ceee2" :question/math-academy-id "q-15155" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x = 1 + \\sin (4t), y = 4\\cos (t)$\nfrom $t = 0$ to $t = 2$?"} {:db/id #edb/ref 17592186092575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c02db39-1323-5178-823d-035cbc0e974b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273319} {:answer/id #uuid "76f538de-df54-5fad-9a26-4e6bcab7eb7a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273399} {:answer/id #uuid "7f93ecb1-ea78-5b92-86af-7eaf211452f3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273483} {:answer/id #uuid "a4a2a416-fa2b-57e0-ae21-9414bcd449ab" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273807} {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472}] :answer-field/correct {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472} :answer-field/id #uuid "8d36b979-5ca7-502e-b3f6-581c418d1ffe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d674e5dc-8a57-5368-b53e-8363dba234a5" :question/math-academy-id "q-15185" :question/problem "![](images/80/80577a585741748702b61596db84983592ecbc6c01fca78af033bf82dbe62ad2.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y={e}^{t}\\operatorname{sin}⁡t$\nfrom $t=-3$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)={e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}\\sqrt{{e}^{2t}+{e}^{2t}{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{1+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f016b0-2fd0-50db-a608-6fb63624e44f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+8\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186272994} {:answer/id #uuid "69d385f0-e607-521b-a6d5-ff44ee22ff0c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273301} {:answer/id #uuid "7e8a87c9-2f3a-5822-a579-01d6eb0bbb36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273473} {:answer/id #uuid "8df9ee48-5fdc-55b9-9efb-127f8dd6bac9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273611} {:answer/id #uuid "ad71957f-f727-5cbc-9851-57e268064b02" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+2{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273883}] :answer-field/correct {:answer/id #uuid "7e8a87c9-2f3a-5822-a579-01d6eb0bbb36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273473} :answer-field/id #uuid "18bf7715-0000-5c6a-ac8b-11821a5550c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274679}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b418c2bf-fd1a-57e4-845f-5c5fb4e1bb93" :question/math-academy-id "q-15163" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t+2\\operatorname{sin}⁡(t),\\,y=1+\\operatorname{cos}⁡(2t)$\nfrom $t=2$ to $t=5$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t+2\\operatorname{sin}⁡(t))=1+2\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{(1+2\\operatorname{cos}⁡(t))^{2}+(-2\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186288018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042ce01d-341b-5a8f-b26c-2bae1091ffbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{2{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186284821} {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} {:answer/id #uuid "2277789f-926a-5240-a07d-b7aedc65a771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186285096} {:answer/id #uuid "ca8848d4-7288-585c-b944-73aa40d45c9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{{e}^{t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186286635} {:answer/id #uuid "d0070ef7-3de9-5565-a190-4c165235a08f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186286682}] :answer-field/correct {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} :answer-field/id #uuid "d0b9c64d-9e93-55fe-a0fb-bcc5981e0b91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287575}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "809a8d30-1507-55ed-ad1d-5fa778afd784" :question/math-academy-id "q-20909" :question/problem "![](images/59/59704c6b8e643337113ab99b22eaeaac8d59ac3c15042409e8a0a8eac6ee54fd.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\frac{t}{2},\\,y={e}^{t}$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\nWe have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(\\frac{1}{2})}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{({e}^{2t})+(\\frac{1}{4})}\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1008f91c-5312-57ff-b584-94eee41fe74d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)-2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288152} {:answer/id #uuid "1da60212-9b1b-5f90-b4ad-60a5d028fa99" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)-4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288219} {:answer/id #uuid "2d0f56b4-96f6-5e10-b8c1-e96fcb0adb3d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)+2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288328} {:answer/id #uuid "c400b002-970a-5f9c-b980-7c4fcc67cff4" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(3t)+{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289327} {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641}] :answer-field/correct {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641} :answer-field/id #uuid "92070a66-23e2-56dd-9cc9-c4b8a5e22afc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290057}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6e26edb-f404-57aa-9e8d-fef8eb7ecc78" :question/math-academy-id "q-21339" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=2\\operatorname{sin}⁡(3t)-1,\\,y=2\\operatorname{cos}⁡(2t)+2$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(3t)-1) \\\\  & =2\\operatorname{cos}⁡(3t)\\cdot 3 \\\\  & =6\\operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)+2) \\\\  & =-2\\operatorname{sin}⁡(2t)\\cdot 2 \\\\  & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(6\\operatorname{cos}⁡(3t))^{2}+(-4\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{2}⁡(3t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d3de1db-0fcc-5d54-a34d-c4772f63450c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288331} {:answer/id #uuid "4d6783bc-60cb-5ebf-aed7-e258b2417e6c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{16{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288571} {:answer/id #uuid "72dafc8f-1319-50ac-8575-b91418fddf5c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288830} {:answer/id #uuid "7dd6ac01-4a42-5fe6-a775-9f769a7e8298" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288884} {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967}] :answer-field/correct {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967} :answer-field/id #uuid "3cb71b35-5d29-5e3f-a2c7-defaa9483e1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289861}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "97f4a57c-d78d-5eaa-81d0-22dc3ac7dd99" :question/math-academy-id "q-21347" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{sin}⁡(3t)$\nfrom $t=\\frac{\\pi }{4}$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))=3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{(2\\operatorname{cos}⁡(2t))^{2}+(3\\operatorname{cos}⁡(3t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69475fb9-4639-5aee-af40-ad859a263a2c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186288774} {:answer/id #uuid "91284f31-5e28-57a6-85bb-2b392b818d21" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289008} {:answer/id #uuid "a96e4ea4-d995-5d4a-b26e-2d37c11a1916" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289155} {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} {:answer/id #uuid "ef891aab-5620-5243-8798-2c0bd3ae8835" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(t)-{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289612}] :answer-field/correct {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} :answer-field/id #uuid "0e6962ab-6088-50b4-b289-81a33c131c7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289765}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1524414a-eeb0-5a99-93da-15745003f6ea" :question/math-academy-id "q-21354" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t),\\,y=t-\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{4}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t))=\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡(t))=1-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t))^{2}+(1-\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)+2\\operatorname{cos}⁡(t)\\operatorname{sin}⁡(t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95a19ab2-d61e-5cd4-9296-0ccc2a2ce9cc" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{5{sin}^{2}⁡t-8\\operatorname{sin}⁡t+32}\\,\\text{d}t" :db/id #edb/ref 17592186400081} {:answer/id #uuid "6f516eb5-80db-56b9-88c4-8fec44175002" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t-8\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400082} {:answer/id #uuid "d04936f6-e3a3-5955-87a3-ae992e7c288a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400083} {:answer/id #uuid "25a5d7fc-f3f7-50d4-9122-01398e9fb385" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{8{sin}^{2}⁡t-2\\operatorname{sin}⁡t+8}\\,\\text{d}t" :db/id #edb/ref 17592186400084} {:answer/id #uuid "4e16c553-ec8a-5568-b27c-e4f4689e3032" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400085}] :answer-field/correct {:answer/id #uuid "4e16c553-ec8a-5568-b27c-e4f4689e3032" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400085} :answer-field/id #uuid "51bd27ca-b51f-55c8-a2b1-03c787e77a4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400080}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a37e6009-e864-56bc-93ae-b166a2b05514" :question/math-academy-id "q-123027" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=3\\operatorname{cos}⁡t,\\,y=8t+\\operatorname{cos}⁡t$\nfrom $t=-1$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8t+\\operatorname{cos}⁡t)=8-\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(8-\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t+64-16\\operatorname{sin}⁡t+{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221b2a78-3ed9-5fcc-a904-b72ed2d8cda6" :answer/type {:db/ident :answer.type/math} :answer/v