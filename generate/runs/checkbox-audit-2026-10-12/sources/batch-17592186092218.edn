orname{cos}⁡t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t+4{cos}^{2}⁡t}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c46a2e-4e00-5991-99c9-9dc68c9a9598" :answer/type {:db/ident :answer.type/math} :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401050} {:answer/id #uuid "2499ce46-f979-5a96-92be-fd0c7ac31bf7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401051} {:answer/id #uuid "61eb1149-6ab5-5e3a-8377-404854e1b082" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{2{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401052} {:answer/id #uuid "7ed903c6-dd0e-5b89-95d6-7cb6b868a842" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{3{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186401053} {:answer/id #uuid "d4b764bb-1a8d-5c44-bf30-3132c5443550" :answer/type {:db/ident :answer.type/math} :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186401054}] :answer-field/correct {:answer/id #uuid "2499ce46-f979-5a96-92be-fd0c7ac31bf7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401051} :answer-field/id #uuid "d340f787-388c-5296-b3a4-86e39060db0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401049}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "243b404d-a4f2-57e8-bc56-d916439edf0e" :question/math-academy-id "q-15182" :question/problem "![](images/d6/d683c3960705fa32d11826008a9844c51c8e59e38f5158fce7f4e44c31b97ca9.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(3t),\\,y=3\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(3t))=-3\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡(t))=3\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-3\\operatorname{sin}⁡(3t))^{2}+(3\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡(3t)+9{cos}^{2}⁡(t)}\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a58988e-9e60-53e1-9ccc-6195ac2bdc85" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}-1}\\,\\text{d}t" :db/id #edb/ref 17592186401868} {:answer/id #uuid "c4824b8b-2ed7-5c3c-ae44-9e7e39c2adaa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186401869} {:answer/id #uuid "8e755153-eb7c-5c80-ac13-6bd2f55ebc06" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}-1}\\,\\text{d}t" :db/id #edb/ref 17592186401870} {:answer/id #uuid "8dadc22b-b156-5944-b045-f3c498f81787" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186401871} {:answer/id #uuid "89771be0-5923-5fe1-8923-30d66256f236" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186401872}] :answer-field/correct {:answer/id #uuid "89771be0-5923-5fe1-8923-30d66256f236" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186401872} :answer-field/id #uuid "f3d97d84-3165-5293-95f8-8ad9ae1b81ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401867}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a60afb71-a1f2-5589-86e8-84aaf38f221a" :question/math-academy-id "q-21353" :question/problem "![](images/4a/4aa2bca8faab077c47fb968882579233babe7d323ba3120088e8ea5599fbd570.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y=t$\nfrom $t=0$ to $t=2$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{({e}^{t})^{2}+(1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve Containing Special Functions"}]}
