swer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} {:answer/id #uuid "be3cb9cd-cb94-5657-98ff-b3d91e1ff9d6" :answer/type {:db/ident :answer.type/math} :answer/value "-6ru+3st" :db/id #edb/ref 17592186334635} {:answer/id #uuid "fa49eaa1-621e-5ca8-a141-b55927a350aa" :answer/type {:db/ident :answer.type/math} :answer/value "3(2st-ru)" :db/id #edb/ref 17592186335181}] :answer-field/correct {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} :answer-field/id #uuid "8926dc70-416f-5104-b768-f00f2078937e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335501}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3f8c0050-79c4-5426-9e5c-a8628ebc0ae0" :question/math-academy-id "q-69650" :question/problem "Calculate $det(H)$, if\n    $H=[\\begin{aligned}-2r & 3s \\\\ -2t & 3u\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =|\\begin{aligned}-2r & 3s \\\\ -2t & 3u\\end{aligned}| \\\\  & =-2r\\cdot 3u-3s\\cdot (-2t) \\\\  & =-6ru-(-6st) \\\\  & =-6ru+6st \\\\  & =6(st-ru)\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] [{:db/id #edb/ref 17592186059750 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059559 :question/id #uuid "043a5e58-e1a0-50a5-b1be-d404e6262991" :question/math-academy-id "e-4436" :question/problem "If\n${A} = \n    \\left\\lbrack\n    \\matrix {\n        2 & -1 \\\n        -3 & k\n    }\n    \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k?$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 \\\\ -3 & k\\end{aligned}| \\\\  & =2\\cdot k-(-1)\\cdot (-3) \\\\  & =2k-3\\end{aligned}\n$$\n\nSince $\\det(A)=5,$ we obtain:\n\n$$\n\\begin{aligned}det(A) & =5 \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4\\end{aligned}\n$$"} :knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/questions [{:db/id #edb/ref 17592186060001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0ff914a-1317-5490-ba59-b2437dd6665a" :answer/type {:db/ident :answer.type/math} :answer/value "k = 9" :db/id #edb/ref 17592186056365} {:answer/id #uuid "be028415-acff-5d6d-8080-1a4b0687fc37" :answer/type {:db/ident :answer.type/math} :answer/value "k =-4" :db/id #edb/ref 17592186056366} {:answer/id #uuid "28d6cf2e-8b16-58ce-af42-d46cb399a7f6" :answer/type {:db/ident :answer.type/math} :answer/value "k =-9" :db/id #edb/ref 17592186056367} {:answer/id #uuid "3882486c-1efa-5685-9f10-e83963bf1488" :answer/type {:db/ident :answer.type/math} :answer/value "k = 4" :db/id #edb/ref 17592186056368} {:answer/id #uuid "585ec4a5-edb5-5cf4-907c-653192911ffa" :answer/type {:db/ident :answer.type/math} :answer/value "k = 0" :db/id #edb/ref 17592186056369}] :answer-field/id #uuid "463bd4e4-2bee-5ee4-b6dd-f8a4f765f86b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056364}] :question/id #uuid "cda11aab-d0f1-5aed-9faf-9b4214024dc7" :question/math-academy-id "q-11651" :question/problem "If\n$C = \\begin{bmatrix}2 & 3 \\\\ 5 & k\\end{bmatrix}$\nand\n$det(C) = 3$, what is the value of $k$?"} {:db/id #edb/ref 17592186060195 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8f75c6a-39ca-54ce-90b2-d2fed57bce1c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186057631} {:answer/id #uuid "f1cc6fa4-5d2d-5ef7-8b9e-ca6b2a04a6df" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186057632} {:answer/id #uuid "34efec5a-0267-59a9-a0e8-a8bbc8e3bbc3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057633} {:answer/id #uuid "626288b8-1266-5c66-8802-e4279b82a65f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186057634} {:answer/id #uuid "65626e08-ea8e-5f2e-a56f-1de07c241265" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186057635}] :answer-field/id #uuid "1cb55465-244d-5741-a788-539ef4e5adf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057630}] :question/id #uuid "e1d88843-5476-50c9-8034-3251a4933b8a" :question/math-academy-id "q-19801" :question/problem "If\n$A = \\begin{bmatrix}1 + t & 2t \\\\ -3 & 1 - t\\end{bmatrix}$\nand $det(A) = 10$, what is the value of $t$?"} {:db/id #edb/ref 17592186233379 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ed3ae951-db6d-557c-8a34-9c013751cf9a" :question/math-academy-id "q-127614" :question/problem "If\n$D=[\\begin{aligned}2x & 6 \\\\ 2x & x-2\\end{aligned}]$\nand $det(D)=-32$, what is the value of $x?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2x & 6 \\\\ 2x & x-2\\end{aligned}| \\\\  & =2x\\cdot (x-2)-6\\cdot 2x \\\\  & =2{x}^{2}-16x\\end{aligned}\n$$\n\nSince $det(D)=-32$, we obtain:\n\n$$\n\\begin{aligned}det(D) & =-32 \\\\ 2{x}^{2}-16x & =-32 \\\\ 2{x}^{2}-16x+32 & =0 \\\\ {x}^{2}-8x+16 & =0 \\\\ (x-4)^{2} & =0 \\\\ x & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0209a06e-c872-52c8-83aa-6e78fe082784" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186250573} {:answer/id #uuid "0e8f8e5e-07ec-513d-8935-253e50a8994b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186250679} {:answer/id #uuid "5c767359-7b77-5594-a325-0a9b4ca901af" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251315} {:answer/id #uuid "dd8e6d11-24ab-54f4-9302-a197b45ae78f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252504} {:answer/id #uuid "e407a6b3-d6da-578c-aa7b-c0b520a0af0f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252555}] :answer-field/correct {:answer/id #uuid "dd8e6d11-24ab-54f4-9302-a197b45ae78f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252504} :answer-field/id #uuid "5e5bd1bd-eab3-5250-8633-db4827abfabb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252971}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "605f5d22-0a36-54b2-9fda-393ada9a651b" :question/math-academy-id "q-11653" :question/problem "If\n    $M=[\\begin{aligned}2 & w \\\\ 4 & 3\\end{aligned}]$\nand\n$\\text{det}(M)=2$, what is the value of $w?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(M) & =|\\begin{aligned}2 & w \\\\ 4 & 3\\end{aligned}| \\\\  & =2\\cdot 3-w\\cdot 4 \\\\  & =6-4w.\\end{aligned}\n$$\n\n    \n\nSince $det(M)=2$, we get:\n\n$$\n\\begin{aligned}det(M) & =2 \\\\ 6-4w & =2 \\\\ -4w & =2-6 \\\\ -4w & =-4 \\\\ w & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262803 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "231d65c4-afe9-5dda-9ec8-8e657ebc2e97" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186260183} {:answer/id #uuid "2cde1f0f-ce43-5b48-8b5f-a4207965af8f" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186260279} {:answer/id #uuid "2e9b7936-2a9f-5fa6-98b8-c2d31209e615" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{3}{2}" :db/id #edb/ref 17592186260296} {:answer/id #uuid "6e18de3f-d88f-51e5-8a5a-4c7a07f3003b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186260842} {:answer/id #uuid "72f9541a-9495-523a-a73a-4a7b746e235a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{4}" :db/id #edb/ref 17592186260881}] :answer-field/correct {:answer/id #uuid "2cde1f0f-ce43-5b48-8b5f-a4207965af8f" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186260279} :answer-field/id #uuid "469de0af-655e-5c52-99af-6a01835c14fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262246}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eb9b1b8a-cede-5e44-9f81-ee8a71692716" :question/math-academy-id "q-127604" :question/problem "If\n    $U=[\\begin{aligned}3 & -5 \\\\ 2k & -k+2\\end{aligned}]$\nand\n$\\text{det}(U)=-1$, what is the value of $k?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =|\\begin{aligned}3 & -5 \\\\ 2k & -k+2\\end{aligned}| \\\\  & =3\\cdot (-k+2)-(-5)\\cdot 2k \\\\  & =7k+6\\end{aligned}\n$$\n\nSince $det(U)=-1$, we get:\n\n$$\n\\begin{aligned}det(U) & =-1 \\\\ 7k+6 & =-1 \\\\ 7k & =-1-6 \\\\ 7k & =-7 \\\\ k & =-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "613ae31f-3ed4-522f-b38e-30b725565300" :answer/type {:db/ident :answer.type/math} :answer/value "v=4" :db/id #edb/ref 17592186260710} {:answer/id #uuid "6c66b584-1346-57a8-91c6-b84e73a70782" :answer/type {:db/ident :answer.type/math} :answer/value "v=-2" :db/id #edb/ref 17592186260826} {:answer/id #uuid "8ccc1966-d22e-5ca2-85e6-62f888a4ebc7" :answer/type {:db/ident :answer.type/math} :answer/value "v=\\frac{3}{4}" :db/id #edb/ref 17592186261106} {:answer/id #uuid "dfbbb63f-c7de-5798-b663-aa393eb8f406" :answer/type {:db/ident :answer.type/math} :answer/value "v=-3" :db/id #edb/ref 17592186261850} {:answer/id #uuid "f645c953-47f3-5b1c-9345-c05fb1f18f37" :answer/type {:db/ident :answer.type/math} :answer/value "v=\\frac{7}{3}" :db/id #edb/ref 17592186262029}] :answer-field/correct {:answer/id #uuid "6c66b584-1346-57a8-91c6-b84e73a70782" :answer/type {:db/ident :answer.type/math} :answer/value "v=-2" :db/id #edb/ref 17592186260826} :answer-field/id #uuid "0ae8e73c-6de7-5bcc-a8b5-a2c66229f23e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262142}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7bb355a7-6406-51ad-b4a4-0aaf09eca17d" :question/math-academy-id "q-127606" :question/problem "If\n$T=[\\begin{aligned}v & 2v \\\\ 2 & v+8\\end{aligned}]$\nand $det(T)=-4$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}v & 2v \\\\ 2 & v+8\\end{aligned}| \\\\  & =v\\cdot (v+8)-2v\\cdot 2 \\\\  & ={v}^{2}+4v\\end{aligned}\n$$\n\nSince $det(T)=-4$, we obtain:\n\n$$\n\\begin{aligned}det(T) & =-4 \\\\ {v}^{2}+4v & =-4 \\\\ {v}^{2}+4v+4 & =0 \\\\ (v+2)^{2} & =0 \\\\ v & =-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aab353e-d8a2-5cee-ad8e-75d89f36942f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186259969} {:answer/id #uuid "55f69ea5-658f-54da-aab9-eba230208482" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186260610} {:answer/id #uuid "77bbba7e-5eef-5fde-bf0b-27cf27e274ce" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260919} {:answer/id #uuid "e35430a5-8bd9-5cd3-a709-f9d32c9a6cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186261873} {:answer/id #uuid "f83c7a76-e478-5e97-87ce-06f9facc6cc8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186262044}] :answer-field/correct {:answer/id #uuid "77bbba7e-5eef-5fde-bf0b-27cf27e274ce" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260919} :answer-field/id #uuid "481e7819-63cc-5385-bd4b-6641777b91a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262249}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "612dd17c-57fb-5f36-b33a-8e40d39733fb" :question/math-academy-id "q-127607" :question/problem "If\n$P=[\\begin{aligned}r-3 & r \\\\ 3 & r\\end{aligned}]$\nand $det(P)=-9$, what is the value of $r?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(P) & =|\\begin{aligned}r-3 & r \\\\ 3 & r\\end{aligned}| \\\\  & =(r-3)\\cdot r-r\\cdot 3 \\\\  & ={r}^{2}-6r\\end{aligned}\n$$\n\nSince $det(P)=-9$, we obtain:\n\n$$\n\\begin{aligned}det(P) & =-9 \\\\ {r}^{2}-6r & =-9 \\\\ {r}^{2}-6r+9 & =0 \\\\ (r-3)^{2} & =0 \\\\ r & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d8c86ed-6d17-58e5-80b8-58959792fbea" :answer/type {:db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186260000} {:answer/id #uuid "5da2ff79-d5ff-5f94-843d-fd01485931c3" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{2}{5}" :db/id #edb/ref 17592186260680} {:answer/id #uuid "63782cc1-1e3c-5b15-9b88-3f08b70112ea" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186260732} {:answer/id #uuid "7a8b63ad-24d0-5034-a4cd-e73692e2757c" :answer/type {:db/ident :answer.type/math} :answer/value "p=3" :db/id #edb/ref 17592186260943} {:answer/id #uuid "c7f4b75b-8f4c-53c9-98ea-95862842547a" :answer/type {:db/ident :answer.type/math} :answer/value "p=-5" :db/id #edb/ref 17592186261645}] :answer-field/correct {:answer/id #uuid "0d8c86ed-6d17-58e5-80b8-58959792fbea" :answer/type {:db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186260000} :answer-field/id #uuid "4e8c9907-19d6-5803-bfec-b352898f4520" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262266}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4e03a4dd-5246-5c91-8e03-9d7ad64d917d" :question/math-academy-id "q-127608" :question/problem "If\n$B=[\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}]$\nand $det(B)=1$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(B) & =|\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}| \\\\  & =(5-p)\\cdot p-p\\cdot 3 \\\\  & =-{p}^{2}+2p\\end{aligned}\n$$\n\nSince $det(B)=1$, we obtain:\n\n$$\n\\begin{aligned}det(B) & =1 \\\\ -{p}^{2}+2p & =1 \\\\ -{p}^{2}+2p-1 & =0 \\\\ {p}^{2}-2p+1 & =0 \\\\ (p-1)^{2} & =0 \\\\ p & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a37c432-ec3a-54fa-a265-be8a73e5b042" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186260101} {:answer/id #uuid "570d06e5-402c-5a48-aa29-06ffa92a5243" :answer/type {:db/ident :answer.type/math} :answer/value "y=18" :db/id #edb/ref 17592186260619} {:answer/id #uuid "76d5eb3b-a067-51ff-b76b-ba5ac4fdd83a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186260912} {:answer/id #uuid "bd179fed-e737-5b98-9f59-7194e6703cb3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{9}{2}" :db/id #edb/ref 17592186261544} {:answer/id #uuid "d688ed58-3493-5fc2-84fe-15f1d55d1e83" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{18}{2}" :db/id #edb/ref 17592186261762}] :answer-field/correct {:answer/id #uuid "1a37c432-ec3a-54fa-a265-be8a73e5b042" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186260101} :answer-field/id #uuid "a12a44ba-4364-5ba9-9b64-63befc571bbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262414}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41f9cebe-1261-5298-9d1d-10bd7138212b" :question/math-academy-id "q-127609" :question/problem "If\n$A=[\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}]$\nand $det(A)=-27$, what is the value of $y?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}| \\\\  & =3y\\cdot (y-5)-y\\cdot 3 \\\\  & =3{y}^{2}-18y\\end{aligned}\n$$\n\nSince $det(A)=-27$, we obtain:\n\n$$\n\\begin{aligned}det(A) & =-27 \\\\ 3{y}^{2}-18y & =-27 \\\\ 3{y}^{2}-18y+27 & =0 \\\\ {y}^{2}-6y+9 & =0 \\\\ (y-3)^{2} & =0 \\\\ y & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291058}] :answer-field/correct {:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291058} :answer-field/id #uuid "5deef2d0-b2e7-54ab-a3df-7734195f5705" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292019}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d712990-6aa9-538b-af72-704fc59cbac8" :question/math-academy-id "q-275598" :question/problem "If\n    $C=[\\begin{aligned}1 & k \\\\ 4 & 6\\end{aligned}]$\nand\n$\\text{det}(C)=-14,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =|\\begin{aligned}1 & k \\\\ 4 & 6\\end{aligned}| \\\\  & =1\\cdot 6-k\\cdot 4 \\\\  & =6-4k.\\end{aligned}\n$$\n\nSince $det(C)=-14$, we get\n\n$$\n\\begin{aligned}det(C) & =-14 \\\\ 6-4k & =-14 \\\\ -4k & =-14-6 \\\\ -4k & =-20 \\\\ k & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291266}] :answer-field/correct {:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291266} :answer-field/id #uuid "339de4a9-ce7b-517d-9496-4255c739b1c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291908}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d673c24b-03d4-55e8-a5fb-605bc1d6c21f" :question/math-academy-id "q-275601" :question/problem "If\n$A=[\\begin{aligned}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{aligned}]$\nand $det(A)=7,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{aligned}| \\\\  & =(3+p)(5-p)-(4p-{p}^{2})\\cdot 1 \\\\  & =15-3p+5p-{p}^{2}-4p+{p}^{2} \\\\  & =15-2p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =15-2p.\\end{aligned}\n$$\n\nFinally, since $det(A)=7$, we obtain\n\n$$\n\\begin{aligned}det(A) & =7 \\\\ 15-2p & =7 \\\\ -2p & =-8 \\\\ p & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479}] :answer-field/correct {:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479} :answer-field/id #uuid "154b6de9-0d77-5e77-8de1-45bf6ab48913" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298716}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1e3ffcd6-7f26-5f4f-8230-33ae44d7f744" :question/math-academy-id "q-317377" :question/problem "If\n    $D=[\\begin{aligned}2 & m \\\\ 3 & 5\\end{aligned}]$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2 & m \\\\ 3 & 5\\end{aligned}| \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524}] :answer-field/correct {:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524} :answer-field/id #uuid "ebf4f818-ea4f-5a3d-9526-388b53c60cf1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299436}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d0f61095-530a-54e2-bb79-353fa0efed39" :question/math-academy-id "q-317382" :question/problem "If\n$U=[\\begin{aligned}1+r & 2-r \\\\ -5 & 4\\end{aligned}]$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =|\\begin{aligned}1+r & 2-r \\\\ -5 & 4\\end{aligned}| \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164}] :answer-field/correct {:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164} :answer-field/id #uuid "0eda0fee-f95d-5630-8031-5abef3969057" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298688}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6e22859c-f056-5995-96a3-08af912796b8" :question/math-academy-id "q-317385" :question/problem "If\n$S=[\\begin{aligned}3+s & 2s \\\\ -4 & 3-s\\end{aligned}]$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}3+s & 2s \\\\ -4 & 3-s\\end{aligned}| \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd1c86f-37e4-5b7b-9ec3-6d55d9670cea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333244} {:answer/id #uuid "4342bd65-1b39-56fb-b10b-45b1a8deeebc" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186333618} {:answer/id #uuid "982f2c1a-e0ab-57c2-b71f-62ccc2593e9b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186334339} {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186334384} {:answer/id #uuid "ab173fd5-9f80-5b1f-9676-76188073a554" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186334491}] :answer-field/correct {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186334384} :answer-field/id #uuid "8c672b33-f965-56dc-b5e9-ce679a558195" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335509}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "66ad3ebb-398d-57e0-be2a-0ce7c08b87a1" :question/math-academy-id "q-69661" :question/problem "If\n$S=[\\begin{aligned}1-p & 1+p \\\\ -3 & 2\\end{aligned}]$\nand $det(S)=2$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}1-p & 1+p \\\\ -3 & 2\\end{aligned}| \\\\  & =(1-p)\\cdot 2-(1+p)\\cdot (-3) \\\\  & =2-2p+3+3p \\\\  & =5+p\\end{aligned}\n$$\n\nSince $det(S)=2$, we obtain:\n\n$$\n\\begin{aligned}det(S) & =2 \\\\ 5+p & =2 \\\\ p & =2-5 \\\\ p & =-3\\end{aligned}\n$$"}] :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] [{:db/id #edb/ref 17592186059826 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059385 :question/id #uuid "9096883e-6dd0-5dd1-8e9c-176775edadba" :question/math-academy-id "e-10785" :question/problem "Which inequality corresponds to the interval $x \\in (1, 5)$?" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only parentheses. So, the endpoints are *not* included.\n\n$$\nx\\in {\\color{red}{(}}1, 5{\\color{red}{)}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n1 \\,\\,{\\color{red}{<}}\\,\\, x \\,\\,{\\color{red}{<}}\\,\\, 5\n$$"} :knowledge-poin