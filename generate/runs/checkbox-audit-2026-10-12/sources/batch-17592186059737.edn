} :answer/value "-5 < y \\le 2\\sqrt{2}" :db/id #edb/ref 17592186058154}] :answer-field/id #uuid "0d65456b-d6a0-5cc9-98e8-03b57278d3d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058149}] :question/id #uuid "11535801-c532-571b-9347-5e423e902106" :question/math-academy-id "q-25754" :question/problem "The interval $y ∈ [- 5, 2\\sqrt{2})$ corresponds to the inequality"}] :knowledge-point/title "Translating Between Half-Open Intervals and Inequalities"}] [{:db/id #edb/ref 17592186059828 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059387 :question/id #uuid "45d05c7d-e278-552f-a524-926d4a57d870" :question/math-academy-id "e-10787" :question/problem "What interval corresponds to the segment shown below?\n\n![](images/43/430481f9d0863b0bb5602f949e6f994d8007ea29fdd741a485d880df8d5d2dec.png)" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nThe given interval can be represented by the following inequality:\n\n$$\n-2\\,\\, {\\color{blue}{\\leq}} \\,\\, x \\,\\, {\\color{red}{\\lt}} \\,\\, 2\n$$\n\nWe can express our inequality in interval notation as follows:\n\n$$\nx\\in {\\color{blue}{[}}-2,2{\\color{red}{)}}\n$$"} :knowledge-point/id #uuid "c8c3e092-d9ff-5dc9-ad1e-f31aa2b226ba" :knowledge-point/questions [{:db/id #edb/ref 17592186060264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec3873b0-5ab7-5411-bf22-7c4136f37266" :answer/type {:db/ident :answer.type/math} :answer/value "x ∈ (-1, 2)" :db/id #edb/ref 17592186058207} {:answer/id #uuid "181d11b5-f9d7-52d1-9dc2-ace5aad93a5e" :answer/type {:db/ident :answer.type/math} :answer/value "x ∈ [- 1, 2]" :db/id #edb/ref 17592186058208} {:answer/i