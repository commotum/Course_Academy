} :answer/value "4{x}^{2}{y}^{2}" :db/id #edb/ref 17592186261256} {:answer/id #uuid "a2a8698b-73f4-57ac-a21f-031d3c8b223a" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}-3)" :db/id #edb/ref 17592186261294}] :answer-field/correct {:answer/id #uuid "61a3d195-a5ae-5921-ac90-3b4c24a6e5e9" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}+5)" :db/id #edb/ref 17592186260716} :answer-field/id #uuid "b1e2c382-0ce2-5adc-b135-69fb578a8e4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262444}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5adfe9df-8aee-5967-99f3-985aed9cc4da" :question/math-academy-id "q-127603" :question/problem "Calculate $det(D)$, if\n    $D=[\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}| \\\\  & =2x\\cdot xy-y\\cdot (-5) \\\\  & =2{x}^{2}y+5y \\\\  & =y(2{x}^{2}+5)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231}] :answer-field/correct {:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231} :answer-field/id #uuid "60cd938e-fe0c-506b-935f-e549ff5c73c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292029}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d53568b9-73ac-5ba0-8169-82ca6f9fc7df" :question/math-academy-id "q-275595" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{aligned}|=$\n {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{aligned}| & =\\sqrt{3}\\cdot \\sqrt{3}-y\\cdot 2 \\\\  & =3-2y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616}] :answer-field/correct {:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616} :answer-field/id #uuid "0ac069ea-97f0-5b28-aae8-5ec01ea01538" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298670}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e6ca014c-b5cb-5825-95b8-87e00a3142c6" :question/math-academy-id "q-317367" :question/problem "Calculate $det(D)$ given that\n$D=[\\begin{aligned}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{aligned}].$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{aligned}| \\\\  & =\\frac{2}{5}\\cdot 2-(-3)\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{4}{5}-\\frac{3}{2} \\\\  & =-\\frac{7}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774}] :answer-field/correct {:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774} :answer-field/id #uuid "eab4d4b7-2252-5c08-b2b6-6e240fa0a5f2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299429}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a27ba74d-67e7-552a-808b-c86c1ab2858a" :question/math-academy-id "q-317368" :question/problem "Calculate $det(E)$ given that\n$E=[\\begin{aligned}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{aligned}].$\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =|\\begin{aligned}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{aligned}| \\\\  & =-\\frac{3}{4}\\cdot (-1)-5\\cdot 2 \\\\  & =\\frac{3}{4}-10 \\\\  & =-\\frac{37}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811}] :answer-field/correct {:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811} :answer-field/id #uuid "d3a33b9b-67e3-53e5-bc18-a48957e9fa7a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299357}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5cb8c1aa-faf5-5b19-b22a-04f7e16807fe" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$D=[\\begin{aligned}3x & 2y \\\\ -5 & x\\end{aligned}].$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}3x & 2y \\\\ -5 & x\\end{aligned}| \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787}] :answer-field/correct {:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787} :answer-field/id #uuid "5f79e083-14ad-5456-a436-b4ade461c1f1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298964}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9aa98f1a-30c2-558c-875f-c99582477892" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0feb68bf-c01c-5e15-9300-ed8a2f76be21" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186333131} {:answer/id #uuid "1b7eebe0-7cb3-5f9c-90c8-996ed14bd473" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2{z}