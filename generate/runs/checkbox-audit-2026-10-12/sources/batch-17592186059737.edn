ent :question.difficulty/moderate} :question/id #uuid "b53c0c18-d59e-56b1-837f-3b6d41491a5f" :question/math-academy-id "q-11646" :question/problem "Calculate $\\text{det}(L)$, if\n    $L=[\\begin{aligned}4 & 5 \\\\ -2 & 3\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(L) & =|\\begin{aligned}4 & 5 \\\\ -2 & 3\\end{aligned}| \\\\  & =4\\cdot 3-(-2)\\cdot 5 \\\\  & =12-(-10) \\\\  & =22\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78dc759e-2781-5f7c-8fdf-32c8a7488616" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260936} {:answer/id #uuid "a6e65376-d802-5c70-a9b5-c7a733c9a942" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186261331} {:answer/id #uuid "bb19c345-96c8-5417-8091-0779682fa6e0" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186261521} {:answer/id #uuid "e51f0554-9934-5f77-b1d4-2f9e022ea1c7" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186261892} {:answer/id #uuid "e740a674-cf61-5f78-af1b-0865ebe203d8" :answer/type {:db/ident :answer.type/math} :answer/value "62" :db/id #edb/ref 17592186261903}] :answer-field/correct {:answer/id #uuid "78dc759e-2781-5f7c-8fdf-32c8a7488616" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260936} :answer-field/id #uuid "d7443e3d-bb79-5f31-9bc0-f76639543945" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262499}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1ea8f2b8-d1da-5f6e-96c2-1f49a78fce12" :question/math-academy-id "q-127578" :question/problem "$|\\begin{aligned}5 & -9 \\\