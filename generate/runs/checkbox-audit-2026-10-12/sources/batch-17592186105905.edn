_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28850236-3de7-5c0f-ad4a-582ad9110aa3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285141} {:answer/id #uuid "664869a8-b432-582c-8b54-e197d9d1a3df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186285715} {:answer/id #uuid "bfccf2a2-4590-5036-915e-9685779cef8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186286542} {:answer/id #uuid "c40ec30b-c8c3-5bdf-bfde-854b6e185a64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186286586} {:answer/id #uuid "fd89f41f-3a93-5bce-90c4-03f483be869a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{6}-\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186287106}] :answer-field/correct {:answer/id #uuid "664869a8-b432-582c-8b54-e197d9d1a3df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}" :db/id #edb/ref 17592186285715} :answer-field/id #uuid "d28ece84-3df4-51e6-a121-897423efdecc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287579}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e415a913-d869-5296-88b6-0354f2046768" :question/math-academy-id "q-19143" :question/problem "Let $a=⟨2,1,-1⟩$ and $b=⟨1,4,2⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28821f48-88e1-581d-b34d-ec1fc4f59a03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186285140} {:answer/id #uuid "49409df2-050f-52a4-8e83-0d1c45e7ad2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{5}" :db/id #edb/ref 17592186285462} {:answer/id #uuid "58358764-c4a7-5af5-92ea-b6dcb1906bdd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285599} {:answer/id #uuid "7217bf98-ec78-513a-8e37-cb8d6a8b8ed9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{15}" :db/id #edb/ref 17592186285838} {:answer/id #uuid "e30bceea-881e-560d-b0c5-a474f1311ae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186286861}] :answer-field/correct {:answer/id #uuid "e30bceea-881e-560d-b0c5-a474f1311ae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186286861} :answer-field/id #uuid "73a60c4c-5c55-56bb-b830-7bdc6154b85e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287389}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3ff49977-bf49-5e35-8d9c-c45493e6961d" :question/math-academy-id "q-19145" :question/problem "Let $c=⟨4,3,0⟩$ and $d=⟨2,1,2⟩.$ Find ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1930a8b6-cd05-5bad-be3f-eae31bbbbee7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186285012} {:answer/id #uuid "b0026f8e-38dc-5c51-a2ec-b994f309e5ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{12}" :db/id #edb/ref 17592186286394} {:answer/id #uuid "d4184123-74bc-5c11-b1a2-60f3c7b8e2f7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186286715} {:answer/id #uuid "d4c28def-c746-5f59-b80d-ed038e2ec013" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{12}" :db/id #edb/ref 17592186286721} {:ans