=\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43038c56-d384-5570-86af-704e0880166f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186290909}] :answer-field/correct {:answer/id #uuid "43038c56-d384-5570-86af-704e0880166f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186290909} :answer-field/id #uuid "6d92e0bb-bf02-560d-8309-29d74166634f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5b790374-4bad-5824-af22-323909fd339e" :question/math-academy-id "q-275244" :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c90fa25-691f-58a4-b734-448a6fca3732" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186291159}] :answer-field/correct {:answer/id #uuid "7c90fa25-691f-58a4-b734-448a6fca3732" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186291159} :answer-field/id #uuid "3c398229-da8b-56ee-b803-4aa60968cde1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291938}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "911cdd8c-0aad-54d0-80d8-17350e5cfd46" :question/math-academy-id "q-275245" :question/problem "Let $c=⟨1,2,-3⟩$ and $d=⟨2,1,2⟩.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d7f3d04-9d9a-5db3-8121-2770a9e7e2ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186291102}] :answer-field/correct {:answer/id #uuid "6d7f3d04-9d9a-5db3-8121-2770a9e7e2ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186291102} :answer-field/id #uuid "35278910-7191-599c-8899-b91af97d2d88" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291910}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ec0f207d-cef1-5071-a74a-2301f10fe8e0" :question/math-academy-id "q-275247" :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e21be6-5288-5a39-b610-c229edf14988" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186298044}] :answer-field/correct {:answer/id #uuid "71e21be6-5288-5a39-b610-c229edf14988" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186298044} :answer-field/id #uuid "217237de-6b94-5d9f-a394-4d02f2866345" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298749}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4084d86f-eb87-5f25-b405-7c5720bf45bf" :question/math-academy-id "q-318977" :question/problem "Let $p=⟨4,-1,1⟩$ and $q=⟨1,2,2⟩.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(4)(1)+(-1)(2)+(1)(2)}{\\sqrt{{1}^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{4-2+2}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7883d86b-cdec-54e0-b22d-e3deedc52363" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186298077}] :answer-field/correct {:answer/id #uuid "7883d86b-cdec-54e0-b22d-e3deedc52363" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186298077} :answer-field/id #uuid "d1742b44-a127-5c8f-93df-71d8fba4ab73" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299348}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "aaf8f1e8-3743-57db-8cf5-200275190fd5" :question/math-academy-id "q-318979" :question/problem "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51311319-cccb-5499-b7df-82fada2209c7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297893}] :answer-field/correct {:answer/id #uuid "51311319-cccb-5499-b7df-82fada2209c7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297893} :answer-field/id #uuid "32644fe5-7234-58cb-be30-d57ff4db1d29" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298809}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7682317e-79ab-546a-b643-7edbcbe6f8ee" :question/math-academy-id "q-318981" :question/problem "Let $r=⟨-1,2,3⟩$ and $s=⟨2,0,0⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-1)(2)+(2)(0)+(3)(0)}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{-2}{\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ecac01c-6f18-504a-a708-bcf3faabfed9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186297750}] :answer-field/correct {:answer/id #uuid "2ecac01c-6f18-504a-a708-bcf3faabfed9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186297750} :answer-field/id #uuid "2737ed18-d118-51f4-b5e7-ebf40846ad60" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298768}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b5e680fa-ce4a-56db-a90a-7d183fdb5f25" :question/math-academy-id "q-318987" :question/problem "Let $m=⟨6,8,0⟩$ and $n=⟨0,5,12⟩.$ Find ${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n.$\n\n${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =\\frac{m\\cdot n}{|\\,n\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{m}\\,n & =\\frac{m\\cdot n}{|\\,m\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c48ccf7-bca3-57a8-a2b5-7cdab2abc3bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186298234}] :answer-field/correct {:answer/id #uuid "9c48ccf7-bca3-57a8-a2b5-7cdab2abc3bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186298234} :answer-field/id #uuid "ce3473e6-0fcc-554b-8da2-28c6134ccc97" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299328}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6dbc91c-6749-54fc-b502-867b88fba0c5" :question/math-academy-id "q-318988" :question/problem "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00efebbd-b34e-5e1d-90ba-a1a1a499e767" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186379365}] :answer-field/correct {:answer/id #uuid "00efebbd-b34e-5e1d-90ba-a1a1a499e767" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186379365} :answer-field/id #uuid "0e556b82-e5e4-5c2f-9171-f94a4a3a1d96" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379364}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2aae90e0-11e3-5ee4-8f7d-d33e1592b8e6" :question/math-academy-id "q-318978" :question/problem "Let $r=⟨-3,2,4⟩$ and $s=⟨1,2,-1⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-3)(1)+(2)(2)+(4)(-1)}{\\sqrt{{1}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{-3+4-4}{\\sqrt{6}} \\\\  & =-\\frac{3}{\\sqrt{6}} \\\\  & =-\\frac{\\sqrt{6}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a08d5080-b0cc-529b-927c-57d7b8fb919c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186379368}] :answer-field/correct {:answer/id #uuid "a08d5080-b0cc-529b-927c-57d7b8fb919c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186379368} :answer-field/id #uuid "aedce65b-2d90-57c8-9df1-ce436a0e55d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379367}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "64a835fe-a6b3-525d-8366-194469689a7f" :question/math-academy-id "q-318984" :question/problem "Let $u=⟨3,1,-2⟩$ and $v=⟨1,1,1⟩.$ Find the scalar projection of $u$ onto $v.$\n\n${\\text{comp}}_{v}\\,u=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{v}\\,u & =\\frac{u\\cdot v}{|\\,v\\,|} \\\\  & =\\frac{{u}_{x}{v}_{x}+{u}_{y}{v}_{y}+{u}_{z}{v}_{z}}{\\sqrt{{v}_{x}^{2}+{v}_{y}^{2}+{v}_{z}^{2}}} \\\\  & =\\frac{(3)(1)+(1)(1)+(-2)(1)}{\\sqrt{{1}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{3+1-2}{\\sqrt{3}} \\\\  & =\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Scalar Projection Using Components"}] [{:db/id #edb/ref 17592186105918 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105490 :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let ![](images/e4/e477b14c9148f4132c747a358e1e99f76d40df85b82c66d6e7dd38581b33913c.png) and ![](images/b1/b17d86e3e395b2fd752f5529090c0a5e4e2fdce17642be5594bee98e8c47fed2.png) Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{c}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{0\\cdot 2+0\\cdot (-4)+1\\cdot 0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =\\frac{0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/questions [{:db/id #edb/ref 17592186106213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1000e887-f114-51b9-b67a-d436889f9bb6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288151} {:answer/id #uuid "4f6cbdef-32ec-5499-a6bd-ce420ddec4fe" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288580} {:answer/id #uuid "812d7309-b400-5fd3-bd24-0d8abc7cac68" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288903} {:answer/id #uuid "a7847429-4b08-529a-a14c-c8cbd6af9359" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186289142} {:answer/id #uuid "dfa64626-acf1-57f9-bd83-06342e759333" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289525}] :answer-field/correct {:answer/id #uuid "4f6cbdef-32ec-5499-a6bd-ce420ddec4fe" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288580} :answer-field/id #uuid "2edfa40a-17b0-5eff-898c-e2c29a2c872d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289836}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "71a079d2-97d0-5455-a26c-8d71df225e2c" :question/math-academy-id "q-236734" :question/problem "Let $p=⟨-1,1,2⟩$ and $q=⟨4,x,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 4+1\\cdot x+2\\cdot 1 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186106214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32a9b8e6-e5c7-5386-b6a4-a0340f010993" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288364} {:answer/id #uuid "485ef75c-1b41-5e2a-a66c-0c07edb72c16" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288532} {:answer/id #uuid "61691320-cd84-5b8a-b32e-847e76c40d8b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288713} {:answer/id #uuid "e150dd45-0881-5820-a874-6959ab85bc53" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289535} {:answer/id #uuid "f232237e-47c0-523d-897d-f50021d1ccdb" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289632}] :answer-field/correct {:answer/id #uuid "61691320-cd84-5b8a-b32e-847e76c40d8b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288713} :answer-field/id #uuid "71f1aa2c-7ea0-5d2e-810c-4873abf36f67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289980}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f961e7bf-40d0-5b4f-86c7-b36ac1e85bd7" :question/math-academy-id "q-236735" :question/problem "Let $p=[\\begin{aligned}6 \\\\ 1 \\\\ 4\\end{aligned}]$ and $q=[\\begin{aligned}x \\\\ 4 \\\\ -4\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =6\\cdot x+1\\cdot 4+4\\cdot (-4) \\\\  & =6x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 6x-12 & =0 \\\\ 6x & =12 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641ccdd7-0572-5c4f-b7e6-d4afe84948d3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186288736} {:answer/id #uuid "66ccc376-8b86-58f9-b2ff-5c6b7268656c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288752} {:answer/id #uuid "72db54e1-ea6b-5dd6-a346-7ef3737b3912" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288831} {:answer/id #uuid "d8aca7b4-fb6f-58c2-83da-427e09c26a5a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289478} {:answer/id #uuid "ed0c240a-396a-521b-addd-33491e305d80" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186289599}] :answer-field/correct {:answer/id #uuid "72db54e1-ea6b-5dd6-a346-7ef3737b3912" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288831} :answer-field/id #uuid "d2d641b9-8ae0-5f17-b941-11db55cc78a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290188}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a5d78299-26e4-51e8-b76f-fbcf41be9fda" :question/math-academy-id "q-237014" :question/problem "Let $p=[\\begin{aligned}-2 \\\\ 0 \\\\ 5\\end{aligned}]$ and $q=[\\begin{aligned}15 \\\\ \\sqrt{2} \\\\ x\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-2)\\cdot 15+0\\cdot \\sqrt{2}+5\\cdot x \\\\  & =5x-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 5x-30 & =0 \\\\ 5x & =30 \\\\ x & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f63989c-30f1-5c24-b29f-efbf4137d328" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288234} {:answer/id #uuid "1fcdfc3c-0b4f-56d0-8865-1174e6c456fc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186288238} {:answer/id #uuid "436014ad-b619-5cc4-b0db-f17722d1681a" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186288492} {:answer/id #uuid "45206803-f9d0-55fe-be31-cc4c00a72853" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186288501} {:answer/id #uuid "92856ac6-8e97-51a2-9023-612b203bc678" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289016}] :answer-field/correct {:answer/id #uuid "1f63989c-30f1-5c24-b29f-efbf4137d328" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186288234} :answer-field/id #uuid "094c47e3-6adf-5882-8699-9b8ef4f4d74a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289746}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f879853f-8faf-5226-ac51-81b9eb8102b2" :question/math-academy-id "q-237015" :question/problem "Let $p=[\\begin{aligned}5 \\\\ x \\\\ 2\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -2 \\\\ -3\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290488 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b700fff-7350-5a76-9d33-c6381d7b4af9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288117} {:answer/id #uuid "1c148563-2d95-5d3e-a347-48d7c955421a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288212} {:answer/id #uuid "2a0223ed-9e09-5f4d-8cc1-702460540107" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288310} {:answer/id #uuid "c4c48f5e-b790-58d9-875e-5aaa2333b742" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289334} {:answer/id #uuid "f1e9c580-629d-51e0-8934-3fda8eae5fe1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289631}] :answer-field/correct {:answer/id #uuid "2a0223ed-9e09-5f4d-8cc1-702460540107" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288310} :answer-field/id #uuid "348703ae-c9d1-5e58-8c49-61fe59940c35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289842}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7a6e6afc-4f8e-5725-a54c-691ecc02b5ca" :question/math-academy-id "q-237016" :question/problem "Let $a=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}-2 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2a414a-e78b-5958-8429-12052b4523b3" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186288205} {:answer/id #uuid "8c9f2614-32c3-56e5-a409-d2760ef70248" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288971} {:answer/id #uuid "b251eb43-1e9d-55b6-850c-8b2662839755" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289210} {:answer/id #uuid "cb0819fe-16d3-5da2-9e12-f9a8552518f6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289378} {:answer/id #uuid "f278ef26-95d6-561a-bd55-6e9c6609d020" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289634}] :answer-field/correct {:answer/id #uuid "f278ef26-95d6-561a-bd55-6e9c6609d020" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289634} :answer-field/id #uuid "2a6e7ba3-1c4d-5d41-a107-43b856da8d1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289828}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9ede3719-f0d6-5ce0-9786-3cb5498e6270" :question/math-academy-id "q-237017" :question/problem "Let $p=i-3j$ and $q=xi+2j+k.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot x+(-3)\\cdot 2+0\\cdot 1 \\\\  & =x-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-6 & =0 \\\\ x & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} {:answer/id #uuid "4be5c6a7-9473-5f8f-a76d-361e76618b03" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288557} {:answer/id #uuid "969e8fda-7e9c-55a7-bced-44ceb4371dda" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289039} {:answer/id #uuid "cbe15376-5215-5280-ae06-1a3991f84d01" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186289384} {:answer/id #uuid "eb4d7bb2-b033-5091-b1bf-ce3cd9d629f1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289590}] :answer-field/correct {:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} :answer-field/id #uuid "0bd2ffd0-af54-5576-8d75-4029636169bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289757}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "23ed6766-8e64-5c6e-b8a5-b8f25dcf697a" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341784da-b585-53fe-93fa-c3cbb0d2b032" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288377} {:answer/id #uuid "8ca536b9-617f-5625-ad14-acd349960cf7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186288973} {:answer/id #uuid "ac275e68-b65e-502d-8d04-712cba1e1a03" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186289174} {:answer/id #uuid "bba33e30-0659-53ad-a553-8814871bb2ba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289270} {:answer/id #uuid "f03674f0-c895-5b67-901a-d1feb586a561" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289620}] :answer-field/correct {:answer/id #uuid "341784da-b585-53fe-93fa-c3cbb0d2b032" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288377} :answer-field/id #uuid "fff57b46-70ef-54bd-87fb-a12c9a20446e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290256}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8158669b-62f4-54f1-8025-20269eb7a332" :question/math-academy-id "q-237020" :question/problem "Let $p=⟨2,0,3⟩$ and $q=⟨3,0,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13792421-9275-5651-8409-88c85398dd37" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288166} {:answer/id #uuid "490f58c8-c786-5d31-8e1c-79dccd244271" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288538} {:answer/id #uuid "710f00a5-6a28-5ddc-bbc9-f671cc856f77" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288818} {:answer/id #uuid "95c00138-66e1-5e8b-a88a-99d98837093b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289032} {:answer/id #uuid "fc1f4fad-69ca-506c-bf35-61221cd5e6c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289696}] :answer-field/correct {:answer/id #uuid "13792421-9275-5651-8409-88c85398dd37" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288166} :answer-field/id #uuid "10ff23a8-ea19-544f-b919-18be2538ce3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289772}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f85820f0-0e97-5a70-b11e-7b663b24839a" :question/math-academy-id "q-237021" :question/problem "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" :question/worked-solution "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c8fa6e-ec22-57a4-ace9-9ab79eb86dfc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288485} {:answer/id #uuid "b84d2b62-4353-5f5a-a5c9-69ea117204f1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186289251} {:answer/id #uuid "d5049764-b1b5-5357-be51-767024d656d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289448} {:answer/id #uuid "dbf67f99-cbea-58b8-a183-8ed451369ef4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289496} {:answer/id #uuid "dd4a724f-68fe-5924-b70a-bdc7366c3c49" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289506}] :answer-field/correct {:answer/id #uuid "d5049764-b1b5-5357-be51-767024d656d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289448} :answer-field/id #uuid "1dc69ae9-136f-5a66-9a05-68c04a2bca60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289806}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "487960be-d7be-5dc4-ae5e-e966e5d0db00" :question/math-academy-id "q-237022" :question/problem "Let $p=⟨3,5,x⟩$ and $q=⟨-3,1,2⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-3)+5\\cdot 1+x\\cdot 2 \\\\  & =2x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "914d3440-61a2-5cbd-915b-d851c90abbd0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291255}] :answer-field/correct {:answer/id #uuid "914d3440-61a2-5cbd-915b-d851c90abbd0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291255} :answer-field/id #uuid "da2ac539-adda-5fda-b798-5c65309f7150" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292405}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0e5cdb13-4156-58cf-ae33-5a314b89945e" :question/math-academy-id "q-275253" :question/problem "Let $p=⟨-1,2,1⟩$ and $q=⟨2,x,0⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 2+2\\cdot x+1\\cdot 0 \\\\  & =-2+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -2+2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb0079d-45e8-5b05-b410-c68104c01c2a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186290701}] :answer-field/correct {:answer/id #uuid "0eb0079d-45e8-5b05-b410-c68104c01c2a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186290701} :answer-field/id #uuid "3af26996-2272-545c-90e4-e37f7e8325a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291933}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0b211c2b-bc36-53db-aca9-0fadea78784c" :question/math-academy-id "q-275256" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b95007d2-d2c4-5ca8-947f-ac698527e171" :answer/type {:db/ident :answer.type/math} :answer/value "-1/3" :db/id #edb/ref 17592186298357}] :answer-field/correct {:answer/id #uuid "b95007d2-d2c4-5ca8-947f-ac698527e171" :answer/type {:db/ident :answer.type/math} :answer/value "-1/3" :db/id #edb/ref 17592186298357} :answer-field/id #uuid "a8db6f26-99f0-50e3-8855-273485708ec8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299208}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "100a4e96-9db1-5d18-a7bd-1bd05f0073dc" :question/math-academy-id "q-319150" :question/problem "Let $p=⟨3,-1,2⟩$ and $q=⟨x,1,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot x+(-1)\\cdot 1+2\\cdot 1 \\\\  & =3x+1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+1 & =0 \\\\ 3x & =-1 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0452a64-927f-5d7d-b07e-4b57abd4d6a6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298259}] :answer-field/correct {:answer/id #uuid "a0452a64-927f-5d7d-b07e-4b57abd4d6a6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298259} :answer-field/id #uuid "0b238f8d-e0d9-5ffc-aee7-5172fbc4d28f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298671}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "252df411-1410-5fbc-a0ba-6a3198b7a34c" :question/math-academy-id "q-319171" :question/problem "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fc4d159-66a8-552d-8401-ac5170a3b165" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297689}] :answer-field/correct {:answer/id #uuid "1fc4d159-66a8-552d-8401-ac5170a3b165" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297689} :answer-field/id #uuid "07b94070-fa19-5c0e-b7d6-fe0a4474788f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298660}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b9e2634-f76e-5353-8b9c-ac4ebc43947e" :question/math-academy-id "q-319172" :question/problem "Let $p=⟨-2,3,4⟩$ and $q=⟨1,2,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =-2+6+4x \\\\  & =4x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 4x+4 & =0 \\\\ 4x & =-4 \\\\ x & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b09c2782-cc5c-5c6b-94f6-5ea932871845" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298323}] :answer-field/correct {:answer/id #uuid "b09c2782-cc5c-5c6b-94f6-5ea932871845" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298323} :answer-field/id #uuid "f27bc293-b846-5a95-9571-c426e151ab18" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299451}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54bac378-b09e-5746-9da1-a5edf37aafcf" :question/math-academy-id "q-319252" :question/problem "Let $p=2i-3j+k$ and $q=xi+4j.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot x+(-3)\\cdot 4+1\\cdot 0 \\\\  & =2x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-12 & =0 \\\\ 2x & =12 \\\\ x & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1b13d9-95f4-5e20-8b5e-53f42fb2123d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297784}] :answer-field/correct {:answer/id #uuid "3b1b13d9-95f4-5e20-8b5e-53f42fb2123d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297784} :answer-field/id #uuid "e0b7ba0f-63e5-5c5e-bfd2-b99c69925ef2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299402}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "abcc12ab-195b-5a18-8e90-22ddbe9f6e4c" :question/math-academy-id "q-319253" :question/problem "Let $p=-4i+2j-3k$ and $q=5i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8294dbd7-4cb6-51d9-8d20-d8495bf0ea10" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298117}] :answer-field/correct {:answer/id #uuid "8294dbd7-4cb6-51d9-8d20-d8495bf0ea10" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298117} :answer-field/id #uuid "2e96eb66-c582-5560-9a9e-1bb66c30da90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298798}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f7e28ce4-d965-5f90-abdd-fd4ebe18371a" :question/math-academy-id "q-319254" :question/problem "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10667f31-4ce7-5455-9b8d-d46f3fda4165" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297627}] :answer-field/correct {:answer/id #uuid "10667f31-4ce7-5455-9b8d-d46f3fda4165" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297627} :answer-field/id #uuid "c0705119-20db-5fba-b904-b479530a6dc6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299282}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c487f5aa-c96a-57d4-aea4-cb293f8d9612" :question/math-academy-id "q-319255" :question/problem "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90285a75-b811-5504-9cc1-612873c4e624" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298177}] :answer-field/correct {:answer/id #uuid "90285a75-b811-5504-9cc1-612873c4e624" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298177} :answer-field/id #uuid "f5e32c57-fed0-5cac-8815-45d1f36b47b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299467}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "82fa0dd5-2719-5c00-bc10-1f3440618fed" :question/math-academy-id "q-319256" :question/problem "Let $a=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ -4\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =(-2)\\cdot 3+5\\cdot x+1\\cdot (-4) \\\\  & =5x-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}5x-10 & =0 \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9679c15f-eb66-5f8f-bc63-1aefe179a953" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186379344} {:answer/id #uuid "0020d0a8-0606-5b18-a7a8-958973e37be8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186379345} {:answer/id #uuid "c47bb5b3-5921-5681-9fee-e5068d117e86" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186379346} {:answer/id #uuid "8be61420-e5d2-50d1-9814-aa6788849373" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186379347} {:answer/id #uuid "f7f0dff6-0e8a-5003-9ccb-b4ae6d63b705" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186379348}] :answer-field/correct {:answer/id #uuid "f7f0dff6-0e8a-5003-9ccb-b4ae6d63b705" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186379348} :answer-field/id #uuid "67ba134b-4d9f-5cf6-b38a-1dcb5e8de13b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379343}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f76a4d7-83bc-53e9-bba0-121ef750dc15" :question/math-academy-id "q-237019" :question/problem "Let $p=i+2j+xk$ and $q=3i+6j-3k.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot 3+2\\cdot 6+x\\cdot (-3) \\\\  & =15-3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 15-3x & =0 \\\\ 3x & =15 \\\\ x & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb69b0f2-a946-5ec4-8b5a-8dc7a021c0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-8/3" :db/id #edb/ref 17592186379371}] :answer-field/correct {:answer/id #uuid "eb69b0f2-a946-5ec4-8b5a-8dc7a021c0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-8/3" :db/id #edb/ref 17592186379371} :answer-field/id #uuid "681c19f4-13bc-5301-abe1-89b3c65ef8d0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379370}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cf60000a-0fab-5712-856b-db3cc64a89f2" :question/math-academy-id "q-319257" :question/problem "Let $a=[\\begin{aligned}4 \\\\ -1 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}2 \\\\ 0 \\\\ x\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =4\\cdot 2+(-1)\\cdot 0+3\\cdot x \\\\  & =3x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}3x+8 & =0 \\\\ 3x & =-8 \\\\ x & =-\\frac{8}{3}.\\end{aligned}\n$$"}] :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}]}
