 =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 2+3\\cdot (-7)+(-1)\\cdot 0}{\\sqrt{{2}^{2}+(-7)^{2}+{0}^{2}}} \\\\  & =-\\frac{15}{\\sqrt{53}}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/questions [{:db/id #edb/ref 17592186106038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b24cdda-6887-539c-aa19-1c06e9321c24" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186102115} {:answer/id #uuid "d18d3c58-289e-5a20-94fe-dbe96e805c83" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186102116} {:answer/id #uuid "d9720da9-28f2-56fb-a1f5-59662d9ad0ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186102117} {:answer/id #uuid "0dfd980b-6168-5088-a700-0e0079b992e9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186102118} {:answer/id #uuid "27950d87-f67f-542d-91b8-ca59d3df0945" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186102119}] :answer-field/id #uuid "9895968c-daeb-5a4a-ad5b-4bce722f55b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102114}] :question/id #uuid "1ea6d0bd-3f53-5b68-921a-856b3d897bbb" :question/math-academy-id "q-126501" :question/problem "Let $c = ⟨2, 1, 2⟩$ and $d = ⟨ - 1, 2, 2⟩$. Find $comp_{d}c + comp_{c}d$."} {:db/id #edb/ref 17592186106098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38804ecb-a9e5-5292-83cd-22d2f3dddc02" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285314} {:answer/id #uuid "87af4911-57b8-5d1b-a61c-48885ecb8443" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286030} {:answer/id #uuid "b2