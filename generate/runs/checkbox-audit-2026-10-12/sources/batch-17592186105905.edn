 "bdcec5e6-2531-5f95-ae29-3c0f54fe0692" :question/math-academy-id "q-19135" :question/problem "Suppose $|\\,a\\,|=8$ and the angle between vectors $a$ and $b$ is $\\theta ={120}^{∘}.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡({120}^{∘}) \\\\  & =8\\cdot (-\\frac{1}{2}) \\\\  & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58363d5c-920b-5c26-a09f-feadb48d18af" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186379362}] :answer-field/correct {:answer/id #uuid "58363d5c-920b-5c26-a09f-feadb48d18af" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186379362} :answer-field/id #uuid "569ff198-8871-5c1e-bb50-e29a59fe2e29" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379361}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "59d8a9a7-8383-53f6-9c1f-7b708ece3184" :question/math-academy-id "q-318969" :question/problem "Suppose $|\\,m\\,|=12$ and the angle between vectors $m$ and $n$ is $\\theta =\\frac{\\pi }{4}.$ Find the scalar projection of $m$ onto $n.$\n\n${\\text{comp}}_{n}\\,m=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =|\\,m\\,|\\operatorname{cos}⁡\\theta  \\\\  & =12cos\\,(\\frac{\\pi }{4}) \\\\  & =12\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1c473f5-dd16-51e8-972f-8503bdea49f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186379933} {:answer/