wer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186236834} {:answer/id #uuid "aef8d084-d169-5e09-9f0e-1801f381f55c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186236932} {:answer/id #uuid "e2447701-f8a9-51c7-9d3a-46b568b874f7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186237235}] :answer-field/correct {:answer/id #uuid "695ae008-d47c-57f9-9587-05c4c533f86b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186236484} :answer-field/id #uuid "edfc2aca-9792-5f3e-b0d4-4cac4d28ecd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237748}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "144f5038-f97a-55ee-aff4-8a719828b869" :question/math-academy-id "q-101528" :question/problem "Let $a=⟨2,-1,2⟩$ and $b=⟨6,2,-3⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 6+(-1)\\cdot 2+2\\cdot (-3)}{\\sqrt{{6}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{4}{\\sqrt{49}} \\\\  & =\\frac{4}{7}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{7}-\\frac{4}{3} \\\\  & =4(\\frac{1}{7}-\\frac{1}{3}) \\\\  & =4(\\frac{3}{21}-\\frac{7}{21}) \\\\  & =-\\frac{16}{21}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65481007-8af1-5f1c-8985-c322b0b2eaad" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236460} {:answer/id #uuid "8e0e3d4f-455b-56e0-8e43-c37201bd7145" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186236717} {:answer/id #uuid "c92389fa-897e-5ad9-8bf2-97d05c95f4cf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186237091} {:answer/id #uuid "cec3e8ae-9080-53fc-b8e8-bceb2f549aeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186237128} {:answer/id #uuid "f9f4c0e9-5bc2-5b74-a144-0c1547768fc5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186237397}] :answer-field/correct {:answer/id #uuid "c92389fa-897e-5ad9-8bf2-97d05c95f4cf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186237091} :answer-field/id #uuid "44dddb26-f4fb-57da-99dc-4c1ff9c89ba9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237526}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d1b1c513-b8bc-52c7-b4e0-fc1349d07866" :question/math-academy-id "q-101529" :question/problem "Let $p=⟨1,\\sqrt{6},3⟩$ and $q=⟨-7,\\sqrt{6},3⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot (-7)+\\sqrt{6}\\cdot \\sqrt{6}+3\\cdot 3}{\\sqrt{(-7)^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{64}} \\\\  & =1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{8}{\\sqrt{{1}^{2}+{\\sqrt{6}}^{2}+{3}^{2}}} \\\\  & =\\frac{8}{\\sqrt{16}} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =1+2 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eaebfb6-259d-5705-8c51-8711af08443f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{2}}{3}" :db/id #edb/ref 17592186260137} {:answer/id #uuid "83d5b435-ad62-5aba-8858-af5a85b263b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186261020} {:answer/id #uuid "8de52fa9-07d3-55ac-b5db-21acd7458485" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261117} {:answer/id #uuid "c33bd9d9-4ed1-58ae-9644-70021d5a13a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186261599} {:answer/id #uuid "e574ef85-82f0-5cd8-ada8-d11da8587242" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186261893}] :answer-field/correct {:answer/id #uuid "8de52fa9-07d3-55ac-b5db-21acd7458485" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261117} :answer-field/id #uuid "51c4cd54-301a-5ffb-9364-f72617508b78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262269}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8db4a866-2f87-543f-a3e4-3db1b1a6a407" :question/math-academy-id "q-126502" :question/problem "Let $p=⟨6,-4,1⟩$ and $q=⟨2\\sqrt{2},\\sqrt{2},-2\\sqrt{2}⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{com