ype/math} :answer/value "y = 2x + 2" :db/id #edb/ref 17592186085185} {:answer/id #uuid "f2c24ff1-5b0c-55fb-9861-7d3fc64a0299" :answer/type {:db/ident :answer.type/math} :answer/value "y =-2x" :db/id #edb/ref 17592186085186} {:answer/id #uuid "033bb08b-e29e-5184-ac71-a26b042292d4" :answer/type {:db/ident :answer.type/math} :answer/value "y =-3x - \\frac{1}{2}" :db/id #edb/ref 17592186085187} {:answer/id #uuid "233f6227-d9d6-5cb6-89dd-2d1ebbfeff8d" :answer/type {:db/ident :answer.type/math} :answer/value "y = 4x + \\frac{2}{3}" :db/id #edb/ref 17592186085188}] :answer-field/id #uuid "886af4c2-4f6d-5386-9820-4833142619da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085183}] :question/id #uuid "1ba28ced-ec0f-59ad-a240-1ab74fcbc020" :question/math-academy-id "q-22574" :question/problem "Which of the following lines is parallel to $4x + 2y = 7$?"}] :knowledge-point/title "Identifying Parallel Lines Given in Standard Form"}]}
