)^{2} & =9 \\\\ (x-2)^{2}+(y-(-2))^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nWe see that $a=2,$ $b=-2,$ and $r=3.$ \n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $3.$"} {:db/id #edb/ref 17592186338851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ca118a-c6bd-5450-9425-9c36f7d885b9" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-3,-3)$ and radius is $5$" :db/id #edb/ref 17592186336095} {:answer/id #uuid "7e77ce24-9b12-5518-b880-fef2d2b5aee7" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(3,3)$ and radius is $5$" :db/id #edb/ref 17592186337175} {:answer/id #uuid "c86388d9-fab6-5c9d-8548-47665f65daef" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(3,3)$ and radius is $\\sqrt{5}$" :db/id #edb/ref 17592186337805} {:answer/id #uuid "daa728ef-76a5-5bdc-bdc9-e5c2963954c5" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-3,-3)$ and radius is $\\sqrt{5}$" :db/id #edb/ref 17592186337935} {:answer/id #uuid "e127089c-cdb2-55d2-9194-95a3353e427e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-3,3)$ and radius is $5$" :db/id #edb/ref 17592186337996}] :answer-field/correct {:answer/id #uuid "daa728ef-76a5-5bdc-bdc9-e5c2963954c5" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-3,-3)$ and radius is $\\sqrt{5}$" :db/id #edb/ref 17592186337935} :answer-field/id #uuid "5e76b9a2-98b8-50ac-be7b-e3fc9f5dc1c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338441}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "82bdb90e-db88-5742-a337-6ee1c028122e" :question/math-academy-id "q-70935" :question/problem "What is the center and radius of the circle with equation $(x+3)^{2}+(y+3)^{2}=5?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+3)^{2}+(y+3)^{2} & =5 \\\\ (x-(-3))^{2}+(y-(-3))^{2} & =(\\sqrt{5})^{2}.\\end{aligned}\n$$\n\nWe see that $a=-3,$ $b=-3,$ and $r=\\sqrt{5}.$ \n\nTherefore, the circle is centered at $(-3,-3)$ and its radius is $\\sqrt{5}.$"} {:db/id #edb/ref 17592186393050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} {:answer/id #uuid "b904b162-87b0-576b-9c8a-3c647aa88565" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $16$" :db/id #edb/ref 17592186393053} {:answer/id #uuid "e0376e6b-94e1-5393-8f70-58f85be3025d" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $4$" :db/id #edb/ref 17592186393054} {:answer/id #uuid "a1fe974f-7739-5447-8c15-65e11281c360" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393055} {:answer/id #uuid "1a4bb814-df36-50ef-990c-594eb222e321" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $16$" :db/id #edb/ref 17592186393056}] :answer-field/correct {:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} :answer-field/id #uuid "85727bd6-7f77-5807-aa8a-f0686b43c486" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393051}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fed78696-d1d3-57b4-8aa2-ab1ef29e5f93" :question/math-academy-id "q-70933" :question/problem "What is the center and radius of the circle with equation $(x+1)^{2}+(y+6)^{2}=16?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+1)^{2}+(y+6)^{2} & =16 \\\\ (x-(-1))^{2}+(y-(-6))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nWe see that $a=-1,$ $b=-6,$ and $r=4.$ \n\nTherefore, the circle is centered at $(-1,-6)$ and its radius is $4.$"} {:db/id #edb/ref 17592186399933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6440d02-db02-5883-9248-472636d87c8e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(5,-3)$ and the radius is $81$" :db/id #edb/ref 17592186399935} {:answer/id #uuid "94926a7f-9ef5-5bea-98f4-3362f05a53c5" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-5,3)$ and the radius is $9$" :db/id #edb/ref 17592186399936} {:answer/id #uuid "fa5c4042-f4c5-57b6-807b-9dcbfece1050" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(5,-3)$ and the radius is $9$" :db/id #edb/ref 17592186399937} {:answer/id #uuid "cc99ae56-0324-5987-9998-2298bc7a275a" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-5,3)$ and the radius is $81$" :db/id #edb/ref 17592186399938} {:answer/id #uuid "2b544bb0-1ba1-5798-982f-f6455ce5b545" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-5,-3)$ and the radius is $9$" :db/id #edb/ref 17592186399939}] :answer-field/correct {:answer/id #uuid "94926a7f-9ef5-5bea-98f4-3362f05a53c5" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-5,3)$ and the radius is $9$" :db/id #edb/ref 17592186399936} :answer-field/id #uuid "25170187-1ade-556c-bc9b-88b463f1ae2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399934}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d5e9656c-2992-5d25-9ed1-710bfe400433" :question/math-academy-id "q-117084" :question/problem "What is the center and the radius of the circle with equation $(x+5)^{2}+(y-3)^{2}=81?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+5)^{2}+(y-3)^{2} & =81 \\\\ (x-(-5))^{2}+(y-3)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nWe see that $a=-5,$ $b=3,$ and $r=9.$ \n\nTherefore, the circle is centered at $(-5,3)$ and its radius is $9.$"} {:db/id #edb/ref 17592186399940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e41033f-736e-5607-8753-961b845b539a" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-7,-10)$ and the radius is $100$" :db/id #edb/ref 17592186399942} {:answer/id #uuid "f27f0122-8daa-5b13-a293-2ff7b998ce73" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and the radius is $10$" :db/id #edb/ref 17592186399943} {:answer/id #uuid "2340cacd-f3c4-5ae7-99ea-d36258840812" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(7,10)$ and the radius is $10$" :db/id #edb/ref 17592186399944} {:answer/id #uuid "3f33726c-a4cf-5d51-a84c-d3798a16d83e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-7,-10)$ and the radius is $10$" :db/id #edb/ref 17592186399945} {:answer/id #uuid "a0981346-e334-5ecc-a493-0c31ebc3ef03" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(7,10)$ and the radius is $100$" :db/id #edb/ref 17592186399946}] :answer-field/correct {:answer/id #uuid "2340cacd-f3c4-5ae7-99ea-d36258840812" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(7,10)$ and the radius is $10$" :db/id #edb/ref 17592186399944} :answer-field/id #uuid "62169293-0e81-54fc-944c-cda58edb5a92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399941}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "064ec2a1-8603-5d8c-96f4-94b94ae469b9" :question/math-academy-id "q-117086" :question/problem "What is the center and the radius of the circle with equation $(x-7)^{2}+(y-10)^{2}=100?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-7)^{2}+(y-10)^{2} & =100 \\\\ (x-7)^{2}+(y-10)^{2} & ={10}^{2}.\\end{aligned}\n$$\n\nWe see that $a=7,$ $b=10,$ and $r=10.$ \n\nTherefore, the circle is centered at $(7,10)$ and its radius is $10.$"}] :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] [{:db/id #edb/ref 17592186087657 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087465 :question/id #uuid "7e01a50d-62f1-5cc2-875e-bb085ef571c4" :question/math-academy-id "e-3230" :question/problem "The line segment $\\overline{XY}$ is a diameter of a circle. Given that $X$ and $Y$ have coordinates $(3,4)$ and $(-1,2)$, respectively, what is the equation of the circle?\n\n![](images/81/81c7d204e134940e4a2cafe465485eb473a81435e3b4f2ca0f291c315d3c37c1.png)" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is\n\n$$\n(x-a)^2 + (y-b)^2 = r^2.\n$$\n\nUsing the distance formula to compute the distance between the points $X(3,4)$ and $Y(-1,2),$ we find that the length the diameter is \n\n$$\n\\begin{aligned}XY & =\\sqrt{{(-1-3)}^{2}+{(2-4)}^{2}} \\\\  & =\\sqrt{{4}^{2}+{2}^{2}} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$\n\nSo the radius of the circle is \n\n$$\nr = \\dfrac{XY}{2} = \\dfrac{2\\sqrt{5}}{2}=\\sqrt{5}.\n$$\n\nSince the center of a circle is the midpoint of the diameter, we can find the center using the midpoint formula as follows:\n\n$$\n\\left( \\dfrac{x_1+x_2}{2}, \\dfrac {y_1+y_2}{2}\\right) = \\left( \\dfrac{3+(-1)}{2}, \\dfrac {4+2}{2}\\right)=(1,3)\n$$\n\nSo our circle has radius $r=\\sqrt{5}$ and center $(a,b)=(1,3),$ and therefore it is represented by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-1)^{2}+(y-3)^{2} & =(\\sqrt{5})^{2} \\\\ (x-1)^{2}+(y-3)^{2} & =5\\end{aligned}\n$$"} :knowledge-point/id #uuid "47863922-b0d5-5a0b-8a01-ffefe3b3c929" :knowledge-point/questions [{:db/id #edb/ref 17592186088018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d9ed301-b583-529b-8c15-15dff536ac19" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} + y^{2} = 9" :db/id #edb/ref 17592186084843} {:answer/id #uuid "9ed00534-c8f8-59ef-9273-b0a069640f75" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 1)^{2} + (y - 2)^{2} = 9" :db/id #edb/ref 17592186084844} {:answer/id #uuid "cd591b26-ec37-52af-8a3d-1a24f276ca0a" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 1)^{2} + (y - 2)^{2} = 9" :db/id #edb/ref 17592186084845} {:answer/id #uuid "18e68fa1-44e5-54fc-84b2-bc7401d40532" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 1)^{2} + (y - 2)^{2} = 36" :db/id #edb/ref 17592186084846} {:answer/id #uuid "6de6e75f-d2d5-5dbf-ad4b-e3dae391dd98" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 1)^{2} + (y - 2)^{2} = 36" :db/id #edb/ref 17592186084847}] :answer-field/id #uuid "99a50a1a-471c-53e3-a732-730ce03ccab6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084842}] :question/id #uuid "293734c3-516c-57c6-8a6e-55cdb18577cc" :question/math-academy-id "q-15292" :question/problem "![](images/33/330409f3fa32ee8701066cd3b43