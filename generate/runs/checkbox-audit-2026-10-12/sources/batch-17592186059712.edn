nt :answer.type/math} :answer/value "2j+4k" :db/id #edb/ref 17592186266934} :answer-field/id #uuid "4f4fdb06-eb4a-5a07-b8eb-90c5091d394f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268547}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e1f83a16-76ac-5449-b50d-56fce3468edc" :question/math-academy-id "q-1396" :question/problem "Let $a=4i+2j-k$ and $b=2i+2j-k.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 2 & -1 \\\\ 2 & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -1 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ 2 & -1\\end{aligned}|j+|\\begin{aligned}4 & 2 \\\\ 2 & 2\\end{aligned}|k \\\\  & =(2\\cdot (-1)-(-1)\\cdot 2)i-(4\\cdot (-1)-(-1)\\cdot 2)j+(4\\cdot 2-2\\cdot 2)k \\\\  & =(-2+2)i-(-4+2)j+(8-4)k \\\\  & =2j+4k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186271969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1f8641-083e-5979-bce4-29e77b2f98b0" :answer/type {:db/ident :answer.type/math} :answer/value "-15i-28j+32k" :db/id #edb/ref 17592186269382} {:answer/id #uuid "1c991130-1867-526a-b960-271f05839726" :answer/type {:db/ident :answer.type/math} :answer/value "-15i+28j+44k" :db/id #edb/ref 17592186269503} {:answer/id #uuid "34af8bd6-ec32-5567-9645-00a05534e8da" :answer/type {:db/ident :answer.type/math} :answer/value "15i+28j+44k" :db/id #edb/ref 17592186269753} {:answer/id #uuid "3e1a966c-5004-5649-a390-ccaf764bed6d" :answer/type {:db/ident :answer.type/math} :answer/value "16i-28j+32k" :db/id #edb/ref 17592186269836} {:answer/id #uuid "a8809211-bd9c-5503-8eaf-d3f49bf867f7" :answer/type {:db/ident :answer.type/math} :answer/value "-15i+44j-28k" :db/id #edb/ref 17592186270773}] :answer-field/correct {:answer/id #uuid "1c991130-1867-526a-b960-271f05839726" :answer/type {:db/ident :answer.type/math} :answer/value "