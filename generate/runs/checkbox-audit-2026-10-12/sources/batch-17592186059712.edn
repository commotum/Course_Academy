#{[{:db/id #edb/ref 17592186059712 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059525 :question/id #uuid "43cfef07-255d-5167-b815-267883918993" :question/math-academy-id "e-4294" :question/problem "Let $\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}$ $\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}$ and $\\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}$ Find $2\\mathbf{a}-(\\mathbf{b}-5\\mathbf{c})$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n2a - (b - 5c) &= 2 \\cdot \\begin{bmatrix}1 \\\\ -5\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - 5 \\cdot \\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - \\begin{bmatrix}-15 \\\\ 35\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - \\begin{bmatrix}17 \\\\ -31\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-15 \\\\ 21\\end{bmatrix}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/questions [{:db/id #edb/ref 17592186060124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80c22748-96be-5547-9bb5-c095c53f1617" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186057103} {:answer/id #uuid "8e0c2ce4-4775-5361-93f2-15eead4dc45e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-21 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186057104} {:answer/id #uuid "a7484c4e-d068-56dc-aca8-2e2bc40974ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}34 \\\\ -8\\end{bmatrix}" :db/id #edb/ref 17592186057105} {:answer/id #uuid "a9c7300d-d4ef-555d-8f12-7a5c000ac874" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}34 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186057106} {:answer/id #uuid "25ad1d96-7836-5a9b-a6bb-72edaef30273" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 \\\\ -8\\end{bmatrix}" :db/id #edb/ref 17592186057107}] :answer-field/id #uuid "816127c8-ea5b-543b-bd2f-b8af95ed22d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057102}] :question/id #uuid "22cfb88f-d04e-5906-ba67-ce3112ea3c66" :question/math-academy-id "q-18040" :question/problem "Let $a = \\begin{bmatrix}4 \\\\ -2\\end{bmatrix}$, $b = \\begin{bmatrix}3 \\\\ 3\\end{bmatrix}$ and $c = \\begin{bmatrix}-8 \\\\ 4\\end{bmatrix}$. Find $a - (2b - 3c)$."} {:db/id #edb/ref 17592186060125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed92333-8c57-5c5e-b38e-8d0e5bb30fc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -13\\end{bmatrix}" :db/id #edb/ref 17592186057109} {:answer/id #uuid "ccbccb7b-4ce6-5702-a7f1-931d4c7f5bfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 13\\end{bmatrix}" :db/id #edb/ref 17592186057110} {:answer/id #uuid "d185e2a7-6bd1-5423-95d8-b583726e7df8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186057111} {:answer/id #uuid "e21f0714-be11-5cce-a0c2-a1c048f9887a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186057112} {:answer/id #uuid "00c4601b-4a4c-5376-874a-5efdf36f020d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -11\\end{bmatrix}" :db/id #edb/ref 17592186057113}] :answer-field/id #uuid "44615549-151b-5d3d-b02b-54ab6c84a788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057108}] :question/id #uuid "2a5c3b4f-534d-508b-a057-66300261cf45" :question/math-academy-id "q-18041" :question/problem "Let $a = \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$, $b = \\begin{bmatrix}4 \\\\ 1\\end{bmatrix}$ and $c = \\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}$. Find $a - (2b + 5c)$."} {:db/id #edb/ref 17592186234272 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c7102fb2-1b14-588a-bd41-c065850a33f5" :question/math-academy-id "q-70412" :question/problem "Let $a=[\\begin{aligned}4 \\\\ -7\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 4\\end{aligned}]$ and $c=[\\begin{aligned}4 \\\\ -6\\end{aligned}].$ Find $3a-(b+4c).$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}3a-(b+4c) & =3\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+4\\cdot [\\begin{aligned}4 \\\\ -6\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+[\\begin{aligned}16 \\\\ -24\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-[\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234273 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aad6285a-b3b6-504e-bdb1-d51f41010e44" :question/math-academy-id "q-70414" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 5\\end{aligned}]$ and $c=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Find $a+(2b-2c).$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a+(2b-2c) & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+(2\\cdot [\\begin{aligned}2 \\\\ 5\\end{aligned}]-2\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+([\\begin{aligned}4 \\\\ 10\\end{aligned}]-[\\begin{aligned}2 \\\\ 4\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 7\\end{aligned}]\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}] [{:db/id #edb/ref 17592186059713 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059526 :question/id #uuid "0adf8fad-9a6f-5eb1-970f-11633ba98ca1" :question/math-academy-id "e-4295" :question/problem "The vectors $\\vec{a}$ and $\\vec{b}$ are given in the picture below. Find the coordinates of $\\vec{a}+6\\vec{b}$.\n\n![](images/56/56b10e759084da6fb21c8421bc9ff6d74aac2602df28f6c8e478bd874d7d6e9f.png)" :question/worked-solution "From the picture, we obtain\n\n$$\n\\vec{a}=\\langle -3,2 \\rangle\n$$\n\nand\n\n$$\n\\vec{b}=\\langle 4,5 \\rangle\n$$\n\nTherefore, to compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\na^(→) + 6b^(→) &= ⟨ - 3, 2⟩ + 6 \\cdot ⟨4, 5⟩ \\\\\n&= ⟨ - 3, 2⟩ + ⟨6 \\cdot 4, 6 \\cdot 5⟩ \\\\\n&= ⟨ - 3, 2⟩ + ⟨24, 30⟩ \\\\\n&= ⟨21, 32⟩\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "fc55e44b-82d0-5145-8a24-d43bc60dc594" :knowledge-point/questions [{:db/id #edb/ref 17592186060028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "815c3a41-9158-597c-a900-28f71dc19e8e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3, 5⟩" :db/id #edb/ref 17592186056527} {:answer/id #uuid "c6c16558-0f65-5213-8725-6982d8f91873" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-4⟩" :db/id #edb/ref 17592186056528} {:answer/id #uuid "2632c7be-399a-59a9-a1c5-d3040176c2d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 3,-3⟩" :db/id #edb/ref 17592186056529} {:answer/id #uuid "3630aa01-0ede-53a0-9581-47ac3d27e799" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,-5⟩" :db/id #edb/ref 17592186056530} {:answer/id #uuid "4c7a8a07-59eb-509a-98b9-cc938456eba8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 3⟩" :db/id #edb/ref 17592186056531}] :answer-field/id #uuid "09d60f5c-a8df-5e06-be54-94be00ab60af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056526}] :question/id #uuid "70dfc6f5-0d00-5ccd-bb86-1c88699f5f00" :question/math-academy-id "q-1323" :question/problem "If $u^(→) = ⟨4, 1⟩$ and $v^(→) = ⟨1,-4⟩$, then $u^(→) - v^(→) =$"} {:db/id #edb/ref 17592186060041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e97a75c-a837-567a-8756-67dfad176334" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 11, 4⟩" :db/id #edb/ref 17592186056605} {:answer/id #uuid "a370905b-4205-5438-b194-1750e2fd465f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 24,-21⟩" :db/id #edb/ref 17592186056606} {:answer/id #uuid "c1e2d804-4fde-5234-8f14-04d7c065242f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 24, 21⟩" :db/id #edb/ref 17592186056607} {:answer/id #uuid "f8601e90-71b0-596f-8f7a-24048ce102a7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨11,-4⟩" :db/id #edb/ref 17592186056608} {:answer/id #uuid "66b9ccc9-0bcc-51d3-b695-fcb59bdbbb7e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨24,-21⟩" :db/id #edb/ref 17592186056609}] :answer-field/id #uuid "2fd4b126-00ce-5715-a19e-17e93432620d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056604}] :question/id #uuid "a46b9579-0f65-55f3-9e73-31c91369d46c" :question/math-academy-id "q-1386" :question/problem "If $v^(→) = ⟨8,-7⟩$, then $3v^(→) =$"} {:db/id #edb/ref 17592186233382 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b4885183-19e5-5c7a-bc09-9d2bdd330428" :question/math-academy-id "q-1300" :question/problem "If $\\overset{\\to }{u}=⟨-3,1⟩$ and $\\overset{\\to }{v}=⟨4,6⟩$, then $\\overset{\\to }{u}+\\overset{\\to }{v}=$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{u}+\\overset{\\to }{v} & =⟨-3,1⟩+⟨4,6⟩ \\\\  & =⟨-3+4,1+6⟩ \\\\  & =⟨1,7⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233395 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c85fb6aa-50dc-5e02-b59e-421805ee7c0f" :question/math-academy-id "q-1324" :question/problem "If $\\overset{\\to }{U}=⟨1,3⟩$ and $\\overset{\\to }{V}=⟨6,3⟩$, then $\\overset{\\to }{U}+\\overset{\\to }{V}=$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{U}+\\overset{\\to }{V} & =⟨1,3⟩+⟨6,3⟩ \\\\  & =⟨1+6,3+3⟩ \\\\  & =⟨7,6⟩\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] [{:db/id #edb/ref 17592186059714 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059527 :question/id #uuid "e2b211fe-d37a-55dd-bf76-9ffab2b6f128" :question/math-academy-id "e-4297" :question/problem "Let $\\mathbf{a}=\\langle -4, 6 \\rangle$. Find $\\mid \\,\\mathbf{a}\\, \\mid$." :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}\n\\mid a \\mid &= \\sqrt{a_{x}^{2} + a_{y}^{2}} \\\\\n&= \\sqrt{(-4)^{2} + (6)^{2}} \\\\\n&= \\sqrt{16 + 36} \\\\\n&= 2\\sqrt{13}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/questions [{:db/id #edb/ref 17592186060029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "867aed2c-b35e-5007-9ac2-00eb9f789e80" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186056533} {:answer/id #uuid "b570b441-3e76-5296-a70a-898635c0d51b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186056534} {:answer/id #uuid "1e5efcaa-fda8-5f46-86a8-ec26f06edd9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186056535} {:answer/id #uuid "2fd699d3-7d66-5b5d-9684-70191f970035" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186056536} {:answer/id #uuid "56b171f0-eae2-5de6-86da-e18b78da9838" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186056537}] :answer-field/id #uuid "0c808bac-3136-50e9-88db-5847268bcea6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056532}] :question/id #uuid "f764385e-ba4e-56aa-912a-4bdb3a698813" :question/math-academy-id "q-1325" :question/problem "If $v = ⟨4,-1⟩$, then what is the magnitude of $v$?\n\n> A scientific calculator is required to answer this question."} {:db/id #edb/ref 17592186060126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a79d21fc-302a-5450-a54f-6475533b9ce7" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{19}" :db/id #edb/ref 17592186057115} {:answer/id #uuid "e2de1a7d-f3cd-583a-9023-113e1389cccb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{152}" :db/id #edb/ref 17592186057116} {:answer/id #uuid "f12252ac-d673-5896-9285-85965a7929b4" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{15}" :db/id #edb/ref 17592186057117} {:answer/id #uuid "22c4967f-8145-57dd-b805-7191087f6156" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{17}" :db/id #edb/ref 17592186057118} {:answer/id #uuid "3cab3961-9873-5028-99db-92118b7dacac" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{157}" :db/id #edb/ref 17592186057119}] :answer-field/id #uuid "c8bc4442-f564-5392-8824-4c50f5f84d3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057114}] :question/id #uuid "9ada1995-eb39-5223-994f-7ad65f7c8096" :question/math-academy-id "q-18046" :question/problem "Let $a = ⟨ - 12, 3⟩$. Find $\\mid a \\mid$.\n\n> A scientific calculator is required to answer this question."} {:db/id #edb/ref 17592186233594 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b8c6e450-fe10-5923-accc-8b824e3c81c1" :question/math-academy-id "q-18047" :question/problem "Let $a=⟨5,9⟩.$ Find $|\\,a\\,|.$" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(5)^{2}+(9)^{2}} \\\\  & =\\sqrt{25+81} \\\\  & =\\sqrt{106}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233595 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "26fce79e-92f6-594d-aec2-af45c6145c5c" :question/math-academy-id "q-18048" :question/problem "if $a=⟨-4,8⟩$, then  what is the magnitude of  $a?$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+(8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =\\sqrt{16\\cdot 5} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] [{:db/id #edb/ref 17592186059715 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059528 :question/id #uuid "d4ad6011-24a4-5642-997f-dcc4e807224f" :question/math-academy-id "e-4298" :question/problem "Let $A(1,3)$ and $B(2,-2)$. Find $\\mid \\overrightarrow{AB} \\mid$.\n\n![](images/f9/f95ee3c5c81750d97019d910350e4c78f0962baa682c834928450a451691145a.png)" :question/worked-solution "We have\n\n$$\nOA^(→) = a = i + 3j,; OB^(→) = b = 2i - 2j\n$$\n\nExpressing $\\overrightarrow{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\nAB^(→) &= OB^(→) - OA^(→) \\\\\n&= b - a \\\\\n&= (2i - 2j) - (i + 3j) \\\\\n&= i - 5j\n\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n\\mid AB^(→) \\mid &= \\sqrt{1^{2} + (-5)^{2}} \\\\\n&= \\sqrt{1 + 25} \\\\\n&= \\sqrt{26}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "7bc170fa-a70e-55af-8f3e-f4ea07431e30" :knowledge-point/questions [{:db/id #edb/ref 17592186060127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fa76cd1-659d-5a5b-8d30-aa37db4db6b0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186057121} {:answer/id #uuid "c207c803-b1ce-5924-b942-d55d34b0a896" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186057122} {:answer/id #uuid "fb4bdbac-dae8-512d-9f28-a6d1ca641844" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186057123} {:answer/id #uuid "5c31b652-4b6c-5d88-8099-aa3b8dbea173" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186057124} {:answer/id #uuid "70729c42-11e6-5309-82bb-19226d272451" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186057125}] :answer-field/id #uuid "21f89363-a985-51cc-946e-14f2aa27f506" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057120}] :question/id #uuid "6a56ae9f-24f2-57fe-8fdd-fdcdaeb8e97e" :question/math-academy-id "q-18051" :question/problem "![](images/2c/2c1f9580f07d06af7ec900ee63c95872e06f459107e64cf1b5117d928efdab22.png)\n\nLet $A(-4, 1)$ and $B(3, 0)$. Find $\\mid AB^(→) \\mid$."} {:db/id #edb/ref 17592186060128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "859a4033-c7be-5ff5-af88-1823e959391b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{27}" :db/id #edb/ref 17592186057127} {:answer/id #uuid "ad6482c5-d423-5cfa-b5c4-60571c0a06c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{23}" :db/id #edb/ref 17592186057128} {:answer/id #uuid "e1496379-7a78-53b1-8d89-c51305772b95" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186057129} {:answer/id #uuid "e7ded905-451e-5e8d-87f6-0bff47652269" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186057130} {:answer/id #uuid "4818a873-c410-58c3-9fa9-c071285aa2cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{26}" :db/id #edb/ref 17592186057131}] :answer-field/id #uuid "60525c6f-c622-5ce0-b076-32a8f28ba4a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057126}] :question/id #uuid "1c261405-1fb7-5f8f-992e-8a8c19696484" :question/math-academy-id "q-18052" :question/problem "![](images/0d/0d92a4d7b9c59b0d6bc8ffec9926bcf189c9bbe808c5bed7a02d6ab09bcebcd0.png)\n\nLet $P(-2, 2)$ and $Q(3, 3)$. Find $\\mid PQ^(→) \\mid$."} {:db/id #edb/ref 17592186233366 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "02dcce11-c60f-5753-ba12-d8ce046f2ae1" :question/math-academy-id "q-125118" :question/problem "![](images/f3/f35a3ad730621023ec86e5727588fc86083ee500b3a72c55ab2808bd290019e9.png)\n\nLet $P(1,2)$ and $Q(-2,1).$ Find $|\\overset{\\to }{PQ}|.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i+2j, \\\\  & \\overset{\\to }{OQ}=q=-2i+j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{PQ}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =q-p \\\\  & =(-2i+j)-(i+2j) \\\\  & =-3i-j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{PQ}| & =\\sqrt{(-3)^{2}+(-1)^{2}} \\\\  & =\\sqrt{9+1} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233596 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f6f7008d-b645-50b0-a00b-9cf227ed2ff3" :question/math-academy-id "q-18049" :question/problem "![](images/1a/1a250499768a91e3e225a05d141e42d7ed89168ba82c5560777f64b8b29fac4a.png)\n\nLet $C(-1,3)$ and $D(1,-2).$ Find $|\\overset{\\to }{CD}|.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OC}=c=-i+3j, \\\\  & \\overset{\\to }{OD}=d=i-2j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{CD}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =\\overset{\\to }{OD}-\\overset{\\to }{OC} \\\\  & =d-c \\\\  & =(i-2j)-(-i+3j) \\\\  & =2i-5j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{CD}| & =\\sqrt{{2}^{2}+(-5)^{2}} \\\\  & =\\sqrt{4+25} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233598 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c14ed0ed-41e3-5534-b77e-503efe93d887" :question/math-academy-id "q-18055" :question/problem "![](images/1e/1e3e9c336bf85cf0f19b2326f12c5fd986fee5b0aae65b8d79257ea234efee13.png)\n\nPoints $P$ and $Q$ are shown in the picture above. Find $|\\overset{\\to }{PQ}|.$" :question/worked-solution "From the picture, we obtain $P(1,1)$ and $Q(2,3).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OP}=p=i+j, \\\\  & \\overset{\\to }{OQ}=q=2i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{PQ}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =q-p \\\\  & =(2i+3j)-(i+j) \\\\  & =i+2j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{PQ}| & =\\sqrt{{1}^{2}+(2)^{2}} \\\\  & =\\sqrt{1+4} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Vector From Position Vectors and then Computing its Magnitude"}] [{:db/id #edb/ref 17592186059716 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059530 :question/id #uuid "65198cdd-dd3b-5840-aaf3-cecd96eb9d3b" :question/math-academy-id "e-4301" :question/problem "Let $\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}$ Find a unit vector that is parallel to $\\mathbf{a}+2\\mathbf{b}$." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}\nu &= \\frac{a + 2b}{\\mid a + 2b \\mid}\n\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\na + 2b &= \\begin{bmatrix}-2 \\\\ 0\\end{bmatrix} + 2 \\cdot \\begin{bmatrix}1 \\\\ -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-2 \\\\ 0\\end{bmatrix} + \\begin{bmatrix}2 \\\\ -2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-2 + 2 \\\\ 0 + (-2)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -2\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n\\mid a + 2b \\mid &= \\sqrt{0^{2} + (-2)^{2}} \\\\\n&= \\sqrt{4} \\\\\n&= 2\n\\end{aligned}\n$$\n\nFinally, we divide $\\mathbf{a}+2\\mathbf{b}$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{a + 2b}{\\mid a + 2b \\mid} \\\\\n&= \\frac{1}{2}(a + 2b) \\\\\n&= \\frac{1}{2} \\cdot \\begin{bmatrix}0 \\\\ -2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -1\\end{bmatrix}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "9c45a70b-273c-5fec-a768-40a1cf218628" :knowledge-point/questions [{:db/id #edb/ref 17592186060119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c0ae1f8-a9cf-50fb-bb0e-5bc2b25f22d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186057073} {:answer/id #uuid "cc509d88-beba-52ad-90e8-932e39775b94" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ -6\\end{bmatrix}" :db/id #edb/ref 17592186057074} {:answer/id #uuid "04113066-ce59-5327-a2a0-17fd031b7844" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{1}{5}\\end{bmatrix}" :db/id #edb/ref 17592186057075} {:answer/id #uuid "3b79648f-cdfe-5e7d-ab62-272eea15302a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186057076} {:answer/id #uuid "5d6a7c46-b482-51be-a70e-62fa54b28535" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186057077}] :answer-field/id #uuid "278a8f50-693e-592e-9524-cda537320d44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057072}] :question/id #uuid "7fcb46f7-1c4e-5d49-b783-5c8f11cf4f94" :question/math-academy-id "q-17709" :question/problem "Let $a = \\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}$ and $b = \\begin{bmatrix}3 \\\\ -2\\end{bmatrix}$. Find a unit vector that is parallel to $a + 3b$ and points the same direction."} {:db/id #edb/ref 17592186060129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3339c8-cfee-5d1c-ad46-ab44efd7b6e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{73}} \\\\ \\frac{3}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057133} {:answer/id #uuid "96688b3e-d471-54f6-8aec-c73d555b7226" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{77}} \\\\ \\frac{8}{\\sqrt{77}}\\end{bmatrix}" :db/id #edb/ref 17592186057134} {:answer/id #uuid "c2e8a09e-3906-503f-9e9f-3e6c5b353823" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{\\sqrt{73}} \\\\ \\frac{3}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057135} {:answer/id #uuid "29a80b65-88dd-51a4-baa0-c738950c1264" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{73}} \\\\ \\frac{8}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057136} {:answer/id #uuid "401e5f5b-5db4-522a-9b7a-11b15f373032" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{76}} \\\\ \\frac{8}{\\sqrt{76}}\\end{bmatrix}" :db/id #edb/ref 17592186057137}] :answer-field/id #uuid "f8820177-fcee-5d33-9928-79e84e800cd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057132}] :question/id #uuid "bfe76e58-e39f-55e9-9d8c-8f6cb0fc0443" :question/math-academy-id "q-18058" :question/problem "Let $a = \\begin{bmatrix}3 \\\\ 8\\end{bmatrix}$. Find a unit vector that is parallel to $a$ and points the same direction."} {:db/id #edb/ref 17592186233367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0602d7a4-2911-50a7-8931-1b4bc528c19a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{5} \\\\ -\\frac{3}{10}\\end{aligned}]" :db/id #edb/ref 17592186411685} {:answer/id #uuid "3c5b6bc3-0505-592d-8bbe-21764c037dd0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{8}{\\sqrt{5}} \\\\ -\\frac{6}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186411711} {:answer/id #uuid "74dbb49a-6f69-59c5-ab9c-6bf2f84350df" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186411739} {:answer/id #uuid "8c50ba8e-c157-5ca3-9288-576321916d2f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{8}{\\sqrt{10}} \\\\ -\\frac{6}{\\sqrt{10}}\\end{aligned}]" :db/id #edb/ref 17592186411752} {:answer/id #uuid "dda19a54-ac15-5715-b0ab-0a3f1c4ff8ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{5} \\\\ -\\frac{3}{10}\\end{aligned}]" :db/id #edb/ref 17592186411801}] :answer-field/correct {:answer/id #uuid "74dbb49a-6f69-59c5-ab9c-6bf2f84350df" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]" :db/id #edb/ref 17592186411739} :answer-field/id #uuid "760bc6eb-d6bd-5bc8-a1ad-d57d71d59023" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411832}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eff15426-c7b2-53a2-8441-6bacd0c6dc45" :question/math-academy-id "q-125135" :question/problem "Let $b=[\\begin{aligned}8 \\\\ -6\\end{aligned}].$ Find a unit vector that is parallel to $b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|\\,b\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,b\\,| & =\\sqrt{{8}^{2}+(-6)^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$\n\nFinally, we divide $b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|b|} \\\\  & =\\frac{1}{10}\\cdot b \\\\  & =\\frac{1}{10}\\cdot [\\begin{aligned}8 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233368 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "06094a0c-ab74-504d-9e7a-29ff1a469a1b" :question/math-academy-id "q-125138" :question/problem "Let $a=[\\begin{aligned}0 \\\\ 2\\end{aligned}]$ and $b=[\\begin{aligned}5 \\\\ 8\\end{aligned}].$ Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}2a+b & =2\\cdot [\\begin{aligned}0 \\\\ 2\\end{aligned}]+[\\begin{aligned}5 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 4\\end{aligned}]+[\\begin{aligned}5 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}0+5 \\\\ 4+8\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 12\\end{aligned}]\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|2a+b| & =\\sqrt{{5}^{2}+{12}^{2}} \\\\  & =\\sqrt{169} \\\\  & =13.\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|} \\\\  & =\\frac{1}{13}(2a+b) \\\\  & =\\frac{1}{13}\\cdot [\\begin{aligned}5 \\\\ 12\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{13} \\\\ \\frac{12}{13}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234271 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "af9476c9-5aa2-526b-87d4-a82f7e7eeb39" :question/math-academy-id "q-70409" :question/problem "Let $n=[\\begin{aligned}5 \\\\ 4\\end{aligned}].$ Find a unit vector that is parallel to $n$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|\\,n\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|n| & =\\sqrt{{5}^{2}+{4}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nFinally, we divide $n$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|n|} \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot n \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot [\\begin{aligned}5 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{\\sqrt{41}} \\\\ \\frac{4}{\\sqrt{41}}\\end{aligned}]\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] [{:db/id #edb/ref 17592186059730 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059543 :question/id #uuid "1ab8245a-39fb-5633-b5ff-865ab17dbfb9" :question/math-academy-id "e-4323" :question/problem "Let $\\mathbf{a}=\\langle 0,-0.4,11 \\rangle$ and $\\mathbf{b}=\\langle 2,5,2 \\rangle.$ Find $\\mathbf{a} \\cdot \\mathbf{b}.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 2+(-0.4)\\cdot 5+11\\cdot 2 \\\\  & =0-2+22 \\\\  & =20\\end{aligned}\n$$"} :knowledge-point/id #uuid "68abb4f0-c532-5cb6-882c-dacfe6a945dc" :knowledge-point/questions [{:db/id #edb/ref 17592186060030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0888ddef-8bdd-5f2a-9651-377e2d59b4fa" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186266221} {:answer/id #uuid "65cbccca-5647-533f-9957-61401f6703fa" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186267047} {:answer/id #uuid "73c31d02-3131-57b8-a4b6-76ae1cf00f68" :answer/type {:db/ident :answer.type/math} :answer/value "39" :db/id #edb/ref 17592186267162} {:answer/id #uuid "93171610-1482-5b05-a8ec-52bcb035bb11" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186267460} {:answer/id #uuid "bb720482-33bd-5d46-b376-8816f86a87bf" :answer/type {:db/ident :answer.type/math} :answer/value "57" :db/id #edb/ref 17592186267826}] :answer-field/correct {:answer/id #uuid "93171610-1482-5b05-a8ec-52bcb035bb11" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186267460} :answer-field/id #uuid "ae56222c-36e1-52f9-b169-6a33e59a6f02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268719}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "299fd51e-9aaf-5d57-966c-4d85ff141159" :question/math-academy-id "q-1340" :question/problem "Let $u=⟨-3,2⟩$ and $v=⟨7,9⟩.$ Find $u\\cdot v.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =(-3)\\cdot 7+2\\cdot 9 \\\\  & =-21+18 \\\\  & =-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186060031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0a5a756-722b-5967-81a3-734cefc8ec24" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186056545} {:answer/id #uuid "c1770900-f1ca-564e-8acd-cbff21e07109" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186056546} {:answer/id #uuid "f1243975-2701-5e3b-9ead-25c1860cda0c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186056547} {:answer/id #uuid "069a0151-b380-5cfe-bc79-93245524b320" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186056548} {:answer/id #uuid "13fd41af-5c6d-5dc2-b3df-814bcf97ea35" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186056549}] :answer-field/id #uuid "e1f0d44a-d8a6-5e77-99b2-1bbdefc5351c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056544}] :question/id #uuid "fe5f0f61-d46c-57e6-b1ba-ec9d07fb2f45" :question/math-academy-id "q-1355" :question/problem "If $a = ⟨ - 1, 0, 6⟩$ and $b = ⟨10, 2,-5⟩$, then $a \\cdot b =$"} {:db/id #edb/ref 17592186235513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a057226-4563-56e2-8c25-e6d52f70db8d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186234756}] :answer-field/correct {:answer/id #uuid "8a057226-4563-56e2-8c25-e6d52f70db8d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186234756} :answer-field/id #uuid "5ebb2a22-14d9-5829-aa9d-41c29ede505f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235071}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3e60be6b-04aa-5311-85b6-7c960267e903" :question/math-academy-id "q-168035" :question/problem "Find the dot product of the vectors $q$ and $r.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $q\\cdot r=\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "The dot product of two vectors given in component form can be computed by summing up the products of corresponding components of vectors:\n\n$$\n\\begin{aligned}q\\cdot r & ={q}_{x}\\cdot {r}_{x}+{q}_{y}\\cdot {r}_{y}+{q}_{z}\\cdot {r}_{z}\\end{aligned}\n$$\n\nFrom part 1, we have $q=⟨0,-3,2⟩$ and $r=⟨0,4,3⟩.$ Therefore, the formula for the dot product gives\n\n$$\n\\begin{aligned}q\\cdot r & =0\\cdot 0+(-3)\\cdot 4+2\\cdot 3 \\\\  & =0-12+6 \\\\  & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00754d46-0704-5773-b914-479b2780c54e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186235797} {:answer/id #uuid "0b160a2e-ac6a-5783-b728-e3786b2e8ea0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186235873} {:answer/id #uuid "5e18d896-af8f-5c4e-a92e-a5e7a5d02427" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186236408} {:answer/id #uuid "aa42023a-fee9-57d2-8160-bb0856641f36" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186236893} {:answer/id #uuid "fd10e16a-4040-5c60-bbca-1fcbbc9e602c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186237421}] :answer-field/correct {:answer/id #uuid "0b160a2e-ac6a-5783-b728-e3786b2e8ea0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186235873} :answer-field/id #uuid "2955f949-c61e-5c52-a7ce-dd2c578781b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237493}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "424bd239-6062-5739-8f7b-4979cfdd4107" :question/math-academy-id "q-101406" :question/problem "Let $p=⟨1,-2⟩$ and $q=⟨4,-1⟩.$ Find $p\\cdot q.$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =1\\cdot 4+(-2)\\cdot (-1) \\\\  & =4+2 \\\\  & =6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186268965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f4fbac-4061-5f3d-9799-55a99d06ca9a" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186266362} {:answer/id #uuid "399da875-0cc4-5b61-a973-cc4519bb7617" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186266651} {:answer/id #uuid "7d0c297e-304e-5779-afcf-cf59460c8afd" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186267252} {:answer/id #uuid "ad65bdc8-68c1-535f-a56b-c476a9c4b5af" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186267709} {:answer/id #uuid "f1057cc8-fca6-5ace-b14b-ab32a6cdb93e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186268287}] :answer-field/correct {:answer/id #uuid "f1057cc8-fca6-5ace-b14b-ab32a6cdb93e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186268287} :answer-field/id #uuid "3e32f98a-0b5b-5df5-ace1-4bb6116c03b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268508}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bd6a5391-fcf3-5a3e-bf4c-ad2c6e4a6452" :question/math-academy-id "q-1341" :question/problem "If $\\overset{\\to }{a}=⟨1,-2,4⟩$ and $\\overset{\\to }{b}=⟨11,4,-1⟩$, then $\\overset{\\to }{a}\\cdot \\overset{\\to }{b}=$" :question/worked-solution "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{a}\\cdot \\overset{\\to }{b} & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 11+(-2)\\cdot 4+4\\cdot (-1) \\\\  & =11+(-8)+(-4) \\\\  & =-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425e3407-b831-5dfb-8a4e-ab70c457a4ab" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186297820}] :answer-field/correct {:answer/id #uuid "425e3407-b831-5dfb-8a4e-ab70c457a4ab" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186297820} :answer-field/id #uuid "bcec9a87-0fd2-5ac6-945b-1c415bc62f4f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299275}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18bcf01e-256b-5339-97ad-00f972b0c662" :question/math-academy-id "q-317910" :question/problem "If $a=⟨5,1⟩$ and $b=⟨2,4⟩,$ then $a\\cdot b=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =5\\cdot 2+1\\cdot 4 \\\\  & =10+4 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35fdb316-399f-5821-b5d4-b5ce24c7099e" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186297769}] :answer-field/correct {:answer/id #uuid "35fdb316-399f-5821-b5d4-b5ce24c7099e" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186297769} :answer-field/id #uuid "0dca9ebc-819e-5579-86a0-5f4b732b025c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298684}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "02b21351-2b17-5c15-a1fb-09ee1d2960d3" :question/math-academy-id "q-317911" :question/problem "If $u=⟨8,-2⟩$ and $v=⟨3,6⟩,$ then $u\\cdot v=${{field-1}}." :question/worked-solution "Summing up the products of corresponding components, we obtain\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =8\\cdot 3+(-2)\\cdot 6 \\\\  & =24-12 \\\\  & =12.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Dot Product Using the General Formula"}] [{:db/id #edb/ref 17592186059731 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059544 :question/id #uuid "dfc10727-c0d7-5b83-a4f6-afe3eb4831cd" :question/math-academy-id "e-4324" :question/problem "Let $[\\begin{aligned}4 \\\\ -2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 5 \\\\ t\\end{aligned}]$. Given that $\\mathbf{a} \\perp \\mathbf{b}$, find the value of $t$." :question/worked-solution "We know that $\\mathbf{a} \\perp \\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are perpendicular) if and only if $\\mathbf{a} \\cdot \\mathbf{b} = 0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =4\\cdot (-2)+(-2)\\cdot 5+1\\cdot t \\\\  & =-8-10+t \\\\  & =t-18.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ t-18 & =0 \\\\ t & =18\\end{aligned}\n$$"} :knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/questions [{:db/id #edb/ref 17592186060184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae77e54a-32d3-50f9-90e1-d721c6912eb1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057565} {:answer/id #uuid "bef01f32-2af6-504c-9185-33a340c040ed" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186057566} {:answer/id #uuid "05f7dc59-7d31-5a4e-b1a7-5bcc62a410e1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186057567} {:answer/id #uuid "126b8159-3ed9-5704-855e-553385d3d53f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186057568} {:answer/id #uuid "424479e4-1853-5168-afdd-f90066e0a09b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186057569}] :answer-field/id #uuid "3a0be646-0391-52b4-8b5c-f114ed783be8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057564}] :question/id #uuid "02c9cfa7-4ae9-5705-8d7c-fd2022315d5b" :question/math-academy-id "q-19021" :question/problem "Let $u = \\begin{bmatrix}x \\\\ -2\\end{bmatrix}$ and $v = \\begin{bmatrix}x \\\\ 2\\end{bmatrix}$. Given that $u⊥v$ and $x > 0$, find the value of $x$."} {:db/id #edb/ref 17592186060185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55d62b6-5917-5302-bee6-928b3a17278b" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186057571} {:answer/id #uuid "007b9b4a-9aba-5d0b-8651-b268b0d7200b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186057572} {:answer/id #uuid "536fbee0-344e-58b1-8307-db534e6334b1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057573} {:answer/id #uuid "61891842-8ad9-52be-9016-cfbcb9079347" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186057574} {:answer/id #uuid "74d0b8c7-fc2c-5232-a7ad-7e4fb33c6ae2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186057575}] :answer-field/id #uuid "69413196-ca59-537c-b270-83f81dac5f78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057570}] :question/id #uuid "14310796-c50e-535f-830b-a7d5f462ade4" :question/math-academy-id "q-19022" :question/problem "What is the value of $x$ given that $a = ⟨x,-6x, 3⟩, b = ⟨x, 1, 3⟩$ and $a⊥b$?"} {:db/id #edb/ref 17592186237827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35170554-7491-5b34-9b67-ab6efae808e5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236152} {:answer/id #uuid "49bebe95-7d8f-5363-8791-a41d117d2f9c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186236287} {:answer/id #uuid "77b5df1a-8495-5220-8d4a-3d2d72b7ceae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186236568} {:answer/id #uuid "84346316-be9d-55ce-ad43-19e661050d2b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186236640} {:answer/id #uuid "9da633c8-52af-507c-8a35-a65c81ee25b6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186236802}] :answer-field/correct {:answer/id #uuid "77b5df1a-8495-5220-8d4a-3d2d72b7ceae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186236568} :answer-field/id #uuid "3f7b6300-7056-5f11-ba41-499cc6516307" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237521}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dfd0ffab-79f2-5643-9530-8f55bce579c3" :question/math-academy-id "q-101417" :question/problem "Let $u=[\\begin{aligned}9 \\\\ 2x\\end{aligned}]$ and $v=[\\begin{aligned}-2 \\\\ x\\end{aligned}].$ Given that $u⊥v$ and $x<0$, find the value of $x.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =9\\cdot (-2)+2x\\cdot x \\\\  & =-18+2{x}^{2}.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ -18+2{x}^{2} & =0 \\\\ 2{x}^{2} & =18 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $x<0.$ Therefore, $x=-3.$"} {:db/id #edb/ref 17592186269008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6896d0d5-0d79-5756-b49d-54e6544b747c" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186267074} {:answer/id #uuid "739434d2-a34f-51ba-85b2-ecb051fb40b5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267159} {:answer/id #uuid "aa9709bd-77ac-5c62-901d-3e693169f7b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186267686} {:answer/id #uuid "d662411b-1715-5ff4-8a35-4927cc146fdd" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186268054} {:answer/id #uuid "d927e205-8536-566a-9f6c-22e1afa9f648" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186268067}] :answer-field/correct {:answer/id #uuid "739434d2-a34f-51ba-85b2-ecb051fb40b5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267159} :answer-field/id #uuid "a6039b6c-4aa0-5bb3-9ed0-9729597efec4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268702}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "214450de-6c4e-5468-90b3-b289da0c12f3" :question/math-academy-id "q-1348" :question/problem "Let $p=[\\begin{aligned}7 \\\\ n\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$ Given that $p⊥q$, find the value of $n.$" :question/worked-solution "We know that $p⊥q$ ($p$ and $q$ are perpendicular) if and only if $p\\cdot q=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =7\\cdot 4+n\\cdot (-4) \\\\  & =28-4n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 28-4n & =0 \\\\ 28 & =4n \\\\ n & =7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cdf7785-cbcd-5112-bc95-0ebbc936c864" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{12}" :db/id #edb/ref 17592186285506} {:answer/id #uuid "6c3e8d51-22f5-56d9-bed9-0046f6689fee" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186285779} {:answer/id #uuid "cc2594eb-bee1-5bc9-9567-d9bdbbe0c102" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186286647} {:answer/id #uuid "cd97d40d-cba1-5ada-8396-a11d2d4f6bbe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186286658} {:answer/id #uuid "e137dd90-b672-5a36-ac92-f22334af1df6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186286837}] :answer-field/correct {:answer/id #uuid "cd97d40d-cba1-5ada-8396-a11d2d4f6bbe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186286658} :answer-field/id #uuid "126e0055-240c-57c8-bdd7-5831adf2287c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287177}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9064a6be-d660-5dcb-af2d-9691a386096a" :question/math-academy-id "q-19023" :question/problem "Let $g=[\\begin{aligned}{r}^{2} \\\\ -1 \\\\ -6\\end{aligned}]$ and $h=[\\begin{aligned}3 \\\\ {r}^{2} \\\\ 2\\end{aligned}].$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$"} {:db/id #edb/ref 17592186299660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050de492-c23d-5e5a-9515-f5292836bf29" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297577}] :answer-field/correct {:answer/id #uuid "050de492-c23d-5e5a-9515-f5292836bf29" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297577} :answer-field/id #uuid "af74f5ad-0374-5f9e-bd30-ae2ff4e64785" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299231}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6840a760-5144-5da8-bd56-8faedecfd9c9" :question/math-academy-id "q-317932" :question/problem "If $c=[\\begin{aligned}k \\\\ 2k \\\\ 4\\end{aligned}],$ $d=[\\begin{aligned}-3 \\\\ 2 \\\\ 2\\end{aligned}],$ and $c⊥d,$ then $k=${{field-1}}." :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+2k\\cdot 2+4\\cdot 2 \\\\  & =-3k+4k+8 \\\\  & =k+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ k+8 & =0 \\\\ k & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc42bda9-d3c0-5507-b933-0b2f39398215" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298373}] :answer-field/correct {:answer/id #uuid "bc42bda9-d3c0-5507-b933-0b2f39398215" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298373} :answer-field/id #uuid "a0941247-a978-51c6-9a76-00d8d070c636" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299169}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d22ee02b-54e6-511a-8cc5-59280c888981" :question/math-academy-id "q-317945" :question/problem "Let $a=⟨2{x}^{2},-4⟩$ and $b=⟨8,4⟩.$ If $a⊥b$ and $x>0,$ then $x=${{field-1}}." :question/worked-solution "We know that $a⊥b$ ($a$ and $b$ are perpendicular) if and only if $a\\cdot b=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =2{x}^{2}\\cdot 8+(-4)\\cdot 4 \\\\  & =16{x}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 16{x}^{2}-16 & =0 \\\\ 16{x}^{2} & =16 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=1.$"} {:db/id #edb/ref 17592186345278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bb6caf7-964e-584f-8548-449063ff8736" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186342474} {:answer/id #uuid "5c6655fa-a76a-596f-a2ad-fcfeda7271b7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186343014} {:answer/id #uuid "683aa6b1-adb6-5752-98f4-3a273931868b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186343127} {:answer/id #uuid "78d230ed-b93e-5bce-ae61-1e6e00da2e94" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186343280} {:answer/id #uuid "d7db328f-e4c7-567e-b319-dbb4a9fef103" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186344135}] :answer-field/correct {:answer/id #uuid "d7db328f-e4c7-567e-b319-dbb4a9fef103" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186344135} :answer-field/id #uuid "67145e24-54e9-57c2-bd15-3f132d50bd30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344667}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b9597aa-ca6f-577e-9d42-415936c8f19c" :question/math-academy-id "q-77152" :question/problem "Let $u=[\\begin{aligned}a \\\\ 2 \\\\ 4\\end{aligned}]$ and $v=[\\begin{aligned}a \\\\ -4 \\\\ -2\\end{aligned}].$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-4)+4\\cdot (-2) \\\\  & ={a}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ {a}^{2}-16 & =0 \\\\ {a}^{2} & =16 \\\\ a & =\\pm 4\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-4.$"}] :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] [{:db/id #edb/ref 17592186059736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059545 :question/id #uuid "d2698dbf-dea6-5abb-970e-a3ace180e337" :question/math-academy-id "e-4341" :question/problem "Let $\\mathbf{a}=\\langle 3,-4,1 \\rangle$ and $\\mathbf{b}=\\langle -7,0,2 \\rangle.$ Find $\\mathbf{a} \\times \\mathbf{b}.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & -4 & 1 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -7 & 2\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -7 & 0\\end{aligned}|k \\\\  & =((-4)\\cdot 2-1\\cdot 0)i-(3\\cdot 2-1\\cdot (-7))j+(3\\cdot 0-(-4)\\cdot (-7))k \\\\  & =-8i-13j-28k \\\\  & =⟨-8,-13,-28⟩.\\end{aligned}\n$$"} :knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/questions [{:db/id #edb/ref 17592186060046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aac8c206-b291-573d-ae2a-74259dfb0e6b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 28,-19,-61⟩" :db/id #edb/ref 17592186056635} {:answer/id #uuid "ca53652c-eb08-5737-b6e1-44c670d816d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 18, 19,-61⟩" :db/id #edb/ref 17592186056636} {:answer/id #uuid "f956129b-c0d4-5106-85ef-d4cae79b9a85" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 28, 19,-19⟩" :db/id #edb/ref 17592186056637} {:answer/id #uuid "5c983fbc-29f4-567c-af19-bcd23d5769f0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨28,-19,-19⟩" :db/id #edb/ref 17592186056638} {:answer/id #uuid "69487641-8222-5353-80f9-06c01524c50c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18, 19, 61⟩" :db/id #edb/ref 17592186056639}] :answer-field/id #uuid "55babe7a-df9e-5246-9069-b8e548bbfc62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056634} {:answer-field/choices [{:answer/id #uuid "0430e0c4-a0b4-5049-ad23-35a8288d7cd5" :answer/type {:db/ident :answer.type/math} 