 17592186287642}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "034087b3-a93a-5e90-bae0-492e734813aa" :question/math-academy-id "q-19778" :question/problem "Let $a=⟨2,3,0⟩$ and $b=⟨6,4,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 2 & 3 & 0 \\\\ 6 & 4 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 \\\\ 4 & 0\\end{aligned}|i-|\\begin{aligned}2 & 0 \\\\ 6 & 0\\end{aligned}|j+|\\begin{aligned}2 & 3 \\\\ 6 & 4\\end{aligned}|k \\\\  & =(3\\cdot 0-4\\cdot 0)i-(2\\cdot 0-6\\cdot 0)j+(2\\cdot 4-6\\cdot 3)k \\\\  & =(0)i-(0)j+(8-18)k \\\\  & =⟨0,0,-10⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3667975a-08ab-553b-aaa5-3e11181b33b6" :answer/type {:db/ident :answer.type/math} :answer/value "8i" :db/id #edb/ref 17592186285293} {:answer/id #uuid "76ce9755-8e9a-535b-b7c9-a11c10deb2c1" :answer/type {:db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186285893} {:answer/id #uuid "78e3ab46-0643-52fc-806d-f544336547b3" :answer/type {:db/ident :answer.type/math} :answer/value "3k" :db/id #edb/ref 17592186285913} {:answer/id #uuid "dec73641-897d-5ca8-94a5-bd30ad1e5038" :answer/type {:db/ident :answer.type/math} :answer/value "4i-2j+3k" :db/id #edb/ref 17592186286816} {:answer/id #uuid "f9b8797b-5449-567c-9675-9327a56ee50f" :answer/type {:db/ident :answer.type/math} :answer/value "3i+8k" :db/id #edb/ref 17592186287070}] :answer-field/correct {:answer/id #uuid "76ce9755-8e9a-535b-b7c9-a11c10deb2c1" :answer/type {:db/ident :answer.type/math} :answer/value "6j" :db/id #edb/ref 17592186285893} :answer-field/id #uuid "baf0953c-0de9-59ad-a7d5-d92d682f01e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287535}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "