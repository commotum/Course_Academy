/math} :answer/value "⟨-10,2,30⟩" :db/id #edb/ref 17592186400754} {:answer/id #uuid "904fd9b0-d482-5093-afb0-55078a667399" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,-14,30⟩" :db/id #edb/ref 17592186400755} {:answer/id #uuid "f884e2c3-8624-5ca1-87bf-175fa491b5ea" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,2,30⟩" :db/id #edb/ref 17592186400756}] :answer-field/correct {:answer/id #uuid "86f43fbb-95b7-541f-8b6c-884210699c13" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,-2,30⟩" :db/id #edb/ref 17592186400752} :answer-field/id #uuid "6f171d5e-1ede-583a-b2ab-a54f8c858c3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400751}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f2ea4789-04ff-53b9-83f0-42f591cf2261" :question/math-academy-id "q-1393" :question/problem "Let $u=⟨4,5,-1⟩$ and $v=⟨-6,0,2⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 4 & 5 & -1 \\\\ -6 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}5 & -1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ -6 & 2\\end{aligned}|j+|\\begin{aligned}4 & 5 \\\\ -6 & 0\\end{aligned}|k \\\\  & =(5\\cdot 2-(-1)\\cdot 0)i-(4\\cdot 2-(-1)\\cdot (-6))j+(4\\cdot 0-5\\cdot (-6))k \\\\  & =(10-0)i-(8-6)j+(0-(-30))k \\\\  & =10i-2j+30k.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Cross Product Using Determinants"}]}
