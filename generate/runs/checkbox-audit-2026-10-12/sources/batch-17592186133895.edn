s}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }6{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186405050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25a141bb-7515-52e5-991a-6d1cce5fd112" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186405052} {:answer/id #uuid "15639b84-a5cd-5c57-999c-5eaa4da55cb8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡2t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186405053} {:answer/id #uuid "153703e1-22d9-5301-b881-b997b52a3787" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186405054} {:answer/id #uuid "08da98f7-5e83-58f1-9af7-d12e18b8d86a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡2t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186405055} {:answer/id #uuid "bd69317b-3202-5a07-9b1f-77c79a7cbb53" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\operatorname{sin}⁡2t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186405056}] :answer-field/correct {:answer/id #uuid "25a141bb-7515-52e5-991a-6d1cce5fd112" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186405052} :answer-field/id #uuid "d59276d0-6151-587a-b33c-8bc27d781877" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186405051}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d0f4b84a-3d7c-5e64-bd13-2b1a225fb6c3" :question/math-academy-id "q-126748" :question/problem "![](images/65/6571fcdf94818485c2a39e90e018d46e9c95e1acbe0a8cf2f67c688d160a347c.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨2\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡t⟩$ for $t\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{-\\pi /2}^{\\pi /2}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, piecewise smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨4\\operatorname{cos}⁡2t,\\,-\\operatorname{sin}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡t\\cdot 4\\operatorname{cos}⁡2t\\,dt \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}4\\operatorname{cos}⁡t\\operatorname{cos}⁡2t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30625b21-0638-5df6-8e7f-5ecca67ca674" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186431017} {:answer/id #uuid "31a713ed-2a9a-58c6-bfc8-e17df3a2f279" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{cos}⁡2t-\\operatorname{cos}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431018} {:answer/id #uuid "7643c9ff-155d-5092-a735-8716263f25b6" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431026} {:answer/id #uuid "a4547936-89a5-5eb1-a5c2-aca7ffed8e29" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{cos}⁡2t-\\operatorname{cos}⁡t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186431032} {:answer/id #uuid "f95f8500-94e5-5ec5-b5e0-95f0daf53e67" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431039}] :answer-field/correct {:answer/id #uuid "f95f8500-94e5-5ec5-b5e0-95f0daf53e67" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431039} :answer-field/id #uuid "4c9269d5-fd3f-54ff-be8f-682c742d6ce4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431042}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2177a684-6e86-5255-ac01-04a426569ee5" :question/math-academy-id "q-126760" :question/problem "![](images/a9/a95b161dab89fe1245724921ef4ee36112d7a4062e7e171411e4ffe61253b91f.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡t-\\operatorname{cos}⁡2t⟩$ for $t\\in [\\frac{\\pi }{3},\\frac{5\\pi }{3}].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{\\pi /3}^{5\\pi /3}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t,\\,-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-x\\,\\text{d}y & ={\\int }_{\\pi /3}^{5\\pi /3}(-\\operatorname{sin}⁡t+\\operatorname{sin}⁡2t)\\cdot (-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t)\\,dt \\\\  & ={\\int }_{\\pi /3}^{5\\pi /3}(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031791c1-0f2f-546c-82e8-999c8554dc97" :answer/type {:db/ident :answer.type/math} :answer/value "5{cos}^{6}⁡t{sin}^{4}⁡t" :db/id #edb/ref 17592186431012} {:answer/id #uuid "7bf73cdb-b201-56ec-9e65-ae9499b1e5c5" :answer/type {:db/ident :answer.type/math} :answer/value "-5{cos}^{5}⁡t{sin}^{5}⁡t" :db/id #edb/ref 17592186431028} {:answer/id #uuid "88f605ff-e892-57f0-8a1b-c76ad9f5a91e" :answer/type {:db/ident :answer.type/math} :answer/value "5{cos}^{5}⁡t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186431029} {:answer/id #uuid "e1ec8ccb-1292-5505-905e-84a2ec107ae8" :answer/type {:db/ident :answer.type/math} :answer/value "-5{sin}^{6}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186431037} {:answer/id #uuid "f58f79ef-051d-5166-b8fb-70ef66a978d8" :answer/type {:db/ident :answer.type/math} :answer/value "5{sin}^{6}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186431038}] :answer-field/correct {:answer/id #uuid "f58f79ef-051d-5166-b8fb-70ef66a978d8" :answer/type {:db/ident :answer.type/math} :answer/value "5{sin}^{6}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186431038} :answer-field/id #uuid "c7e0a66d-4420-5ec9-9e88-13a5cdd58112" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431045}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d1f25e51-cfc7-5f63-98bf-d803b12546e2" :question/math-academy-id "q-126761" :question/problem "![](images/10/10f4094edb09afc7908bd0cd3df089387c8f5b762ea5ef86da152d1c9d08b5e4.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨{sin}^{5}⁡t,\\,{cos}^{5}⁡t⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, piecewise-smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨5{sin}^{4}⁡t\\operatorname{cos}⁡t,\\,-5{cos}^{4}⁡t\\operatorname{sin}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-x\\,\\text{d}y & ={\\int }_{0}^{2\\pi }(-{sin}^{5}⁡t)\\cdot (-5{cos}^{4}⁡t\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }5{sin}^{6}⁡t{cos}^{4}⁡t\\,dt.\\end{aligned}\n$$"}] :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] [{:db/id #edb/ref 17592186133897 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133713 :question/id #uuid "aa4400ff-09b0-596c-9857-c13881b72f73" :question/math-academy-id "e-9555" :question/problem "Consider the region $D$ enclosed by the curve $C=C_1 \\cup C_2,$ where \n\n- $C_1$ is parametrized by $\\mathbf{r}_1(t) =-2 t^4 \\: \\mathbf{i} + t^3 \\: \\mathbf{j}$ for $t \\in \\left[-1,1\\right],$ and\n\n- $C_2$ is parametrized by $\\mathbf{r}_2(t) = -2\\: \\mathbf{i} -t \\: \\mathbf{j}$ for $t \\in \\left[-1,1\\right].$\n\nUse Green's theorem to find the area of the region.\n\n![](images/14/147e8fdd97fc938ae5482b70d7215483956a860ee3ce69ae5bbebd111dcc343b.png)" :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, piecewise-smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\dfrac{\\partial Q}{\\partial x} - \\dfrac{\\partial P}{\\partial y} = 0 - \\left(-1\\right) = 1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y) = -y$ and $Q(x,y) = 0,$ we get\n\n$$\n\\oint\\limits_C P \\: \\text{d}x + Q \\: \\text{d}y = -\\oint\\limits_C y \\: \\text{d}x.\n$$\n\n \n\nThe derivatives of $\\mathbf r_1(t)$ and $\\mathbf r_2(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=-8{t}^{3}\\,i+3{t}^{2}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-j\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}-{∮}_{C}y\\,\\text{d}x & =-{∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & =-{∮}_{{C}_{1}}y\\,dx-{∮}_{{C}_{2}}y\\,dx \\\\  & =-{\\int }_{-1}^{1}{t}^{3}\\cdot (-8{t}^{3})\\,\\text{d}t-{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =8{\\int }_{-1}^{1}{t}^{6}\\,\\text{d}t+0 \\\\  & =8[\\frac{{t}^{7}}{7}]_{-1}^{1} \\\\  & =8\\cdot \\frac{2}{7} \\\\  & =\\frac{16}{7}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "cf9b73fa-c7ce-5c93-9131-ec36d29d6c3a" :knowledge-point/questions [{:db/id #edb/ref 17592186134376 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f72d1468-b59f-55f3-9d92-ba00ddb0db88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186132296} {:answer/id #uuid "fa256ecb-1155-587e-a827-4c7f7584f6f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186132297} {:answer/id #uuid "fe5293a6-7b3b-5ed3-a5f8-13eb0ad2c78d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186132298} {:answer/id #uuid "5d10c8c0-0ad7-587d-9d4f-df30df144733" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186132299} {:answer/id #uuid "6c3d7569-0df8-52ec-b06f-90609c9c6e56" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186132300}] :answer-field/id #uuid "bb773cb5-403e-5d2c-95a1-5dbb8eba2e0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132295} {:answer-field/choices [{:answer/id #uuid "d8b5adde-1913-5b7b-8715-f70ae223e349" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186370941} {:answer/id #uuid "5f438494-28b7-57fb-80d6-a3fe7e73a368" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186370942} {:answer/id #uuid "e8b51f75-a136-57d4-bf07-dc90a22f9315" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186370943} {:answer/id #uuid "2260ecea-4586-5fe7-ac66-3cc46eb39c1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186370944} {:answer/id #uuid "2f828455-578e-54d4-843d-b9476bb1f31f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186370945}] :answer-field/correct {:answer/id #uuid "e8b51f75-a136-57d4-bf07-dc90a22f9315" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186370943} :answer-field/id #uuid "1f079002-de78-5504-85d4-0c00298a5bfe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370940}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c3df1fb-6ba7-5d92-9c02-3f4fe719a847" :question/math-academy-id "q-42215" :question/problem "![](images/df/df940d9ea08ed1b326d4904933bd41c318112836d2d657abcb3c158aabbe7bb4.png)\n\nUse Green's theorem to find the area of the region enclosed by the curve \n$C$ parametrized as $r(t)=3\\operatorname{sin}⁡t\\,i+2\\operatorname{sin}⁡2t\\,j$ \nfor $t\\in [0,\\pi ].$" :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented. \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =3\\operatorname{cos}⁡t\\,i+4\\operatorname{cos}⁡2t\\,j.\\end{aligned}\n$$\n\nFinally, we can evaluate our line integral using the substitution $u=\\operatorname{cos}⁡t,\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}y\\,dx & ={\\int }_{0}^{\\pi }2\\operatorname{sin}⁡2t\\cdot 3\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }\\operatorname{sin}⁡2t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }2\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =12{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & =-12{\\int }_{1}^{-1}{u}^{2}\\,\\text{d}u \\\\  & =12{\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & =4{{u}^{3}|}_{-1}^{1} \\\\  & =4({1}^{3}-(-1)^{3}) \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f48c0b-2a3d-5163-b8e8-0c7233eb05fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186132356} {:answer/id #uuid "e01d132b-6218-5a49-8b31-e23dbbbfbe93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186132357} {:answer/id #uuid "ed54db10-308f-5357-92ca-c739526b9c08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186132358} {:answer/id #uuid "fab5eb83-c4a0-5d86-82d7-ebea1c4f60b9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186132359} {:answer/id #uuid "6d37aff8-08ac-5983-b3ea-04ddf202a770" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186132360}] :answer-field/id #uuid "30db4754-f10f-5c4e-a207-166a2bda9bd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132355}] :question/id #uuid "c299dba6-b9c4-559b-b05a-803d3465ef0e" :question/math-academy-id "q-42298" :question/problem "![](images/01/01a5f06674cacca4764f438a8c06f020659f0177a0b74952f40bc9072627ec3f.png)\n\nConsider the region $D$ enclosed by the curve $C = C_{1}∪C_{2}$, where\n\n- $C_{1}$ is parametrized by $r_{1}(t) = 2t^{2}i - t^{3}j$ for $t ∈ [- 1, 1]$, and\n- $C_{2}$ is parametrized by $r_{2}(t) = 2i + tj$ for $t ∈ [- 1, 1]$.\n\nUse Green's theorem to find the area of the region."} {:db/id #edb/ref 17592186369399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "107fbbcc-1cef-591d-838c-89092ff4b58f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186369401} {:answer/id #uuid "8c11bbb3-2d45-5311-90fd-c92caf9bea8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186369402} {:answer/id #uuid "2983dbf6-4125-5413-bca4-9b9acc749a72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}" :db/id #edb/ref 17592186369403} {:answer/id #uuid "319ba55a-cea6-54fc-8482-99d900f9e65a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186369404} {:answer/id #uuid "20585aa7-a901-5327-aa20-d6a600d555d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186369405}] :answer-field/correct {:answer/id #uuid "8c11bbb3-2d45-5311-90fd-c92caf9bea8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186369402} :answer-field/id #uuid "a332c9c0-5c80-59f8-b499-e9724c2807a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369400}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8c42efa1-14e8-5edb-ba70-51dc3c6ff4b6" :question/math-academy-id "q-126722" :question/problem "![](images/2a/2a89a14bced6f6700614cfad216070154cae165785458f817ea06d266edfde4e.png)\n\nUse Green's theorem to find the area of the region enclosed by the curve \n$C$ parametrized as $r(t)=2\\operatorname{sin}⁡2t\\,i-2\\operatorname{sin}⁡t\\,j$ \nfor $t\\in [0,\\pi ].$" :question/worked-solution "First, let $P(x,y)=0$ and $Q(x,y)=x.$\n\nOur simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented. \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y=-{∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =4\\operatorname{cos}⁡2t\\,i-2\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nFinally, we can evaluate our line integral using the substitution $u=\\operatorname{cos}⁡t,\\text{d}u=-\\operatorname{sin}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}-{∮}_{C}x\\,dy & =-{\\int }_{0}^{\\pi }2\\operatorname{sin}⁡2t\\cdot (-2\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡2t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }2\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =8{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & =-8{\\int }_{1}^{-1}{u}^{2}\\,\\text{d}u \\\\  & =8{\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{8}{3}{u}^{3}{|}_{-1}^{1} \\\\  & =\\frac{8}{3}({1}^{3}-(-1)^{3}) \\\\  & =\\frac{16}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e634686a-03c3-5649-bd9a-7735236d04f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186369408} {:answer/id #uuid "4d8ff954-ed9f-55d7-a5de-4eb98b4a7700" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186369409} {:answer/id #uuid "44a799f1-979a-58d8-8972-839c9e22e67a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186369410} {:answer/id #uuid "a7508032-3abc-5fc9-a2ba-c0eca938cd0f" :answer/type {:db/ident :answer.type/math} :answer/value "7\\pi " :db/id #edb/ref 17592186369411} {:answer/id #uuid "dc9679c6-90fa-580d-a0cd-427d1ddfb956" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186369412}] :answer-field/correct {:answer/id #uuid "44a799f1-979a-58d8-8972-839c9e22e67a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186369410} :answer-field/id #uuid "c3b0054e-e505-5919-822e-5e1dd45e03f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369407}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5e16fd42-acd5-59dc-b36e-e5d23e861950" :question/math-academy-id "q-126725" :question/problem "![](images/41/41dc9af596ca43b1d0d61bb4273be46d3a3d1adc62f99a70fe53c72d69667093.png)\n\nUse Green's theorem to find the area of the region enclosed by the curve \n$C$ parametrized as $r(t)=\\operatorname{sin}⁡2t\\,i+\\operatorname{cos}⁡t\\,j$ \nfor $t\\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}].$" :question/worked-solution "First, let $P(x,y)=0$ and $Q(x,y)=x.$\n\nOur simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =2\\operatorname{cos}⁡2t\\,i-\\operatorname{sin}⁡t\\,j.\\end{aligned}\n$$\n\nFinally, we can evaluate our line integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}x\\,dy & ={\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{sin}⁡2t\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =-{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{sin}⁡2t\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-{\\int }_{\\pi /2}^{3\\pi /2}2\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-2{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{cos}⁡t{sin}^{2}⁡t\\,\\text{d}t \\\\  & =-2{\\int }_{1}^{-1}{u}^{2}\\,\\text{d}u \\\\  & =2{\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{2}{3}{u}^{3}{|}_{-1}^{1} \\\\  & =\\frac{2}{3}({1}^{3}-(-1)^{3}) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369427 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d263f40-9c2f-5a37-bde8-f22ac722349c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186369429} {:answer/id #uuid "d98084a7-8c18-5006-8eaf-808ce526a650" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186369430} {:answer/id #uuid "c270fb54-3408-58f5-94c5-0ccc6a0d2bb1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186369431} {:answer/id #uuid "89fea390-1808-5719-8411-656965ac4356" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369432} {:answer/id #uuid "f90a6d10-d2f7-5146-b3e5-bd6446824220" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186369433}] :answer-field/correct {:answer/id #uuid "f90a6d10-d2f7-5146-b3e5-bd6446824220" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186369433} :answer-field/id #uuid "dbaaffb7-8edd-5da1-89b3-b92a5ba8c4dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369428}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8b773c29-9e6f-5096-b07b-de5aaca35eab" :question/math-academy-id "q-126818" :question/problem "![](images/9e/9eb614f4f6e00c5fa03759a61d69734aa1c6eaf26d98d3c78b96052ca16162d0.png)\n\nConsider the region $D$ enclosed by the curve $C={C}_{1}\\cup {C}_{2},$ where \n\n- ${C}_{1}$ is parametrized by ${r}_{1}(t)=-2{t}^{2}\\,i+3{t}^{3}\\,j$ for $t\\in [-1,1],$ and\n\n- ${C}_{2}$ is parametrized by ${r}_{2}(t)=-2\\,i-t\\,j$ for $t\\in [-3,3].$\n\nUse Green's theorem to find the area of the region." :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, piecewise-smooth, closed path $C$ is positively oriented and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y=-{∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=-4t\\,i+9{t}^{2}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-j\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}-{∮}_{C}y\\,\\text{d}x & =-{∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & =-{∮}_{{C}_{1}}y\\,dx-{∮}_{{C}_{2}}y\\,dx \\\\  & =-{\\int }_{-1}^{1}3{t}^{3}\\cdot (-4t)\\,\\text{d}t-{\\int }_{-3}^{3}(-t)\\cdot 0\\,\\text{d}t \\\\  & =12{\\int }_{-1}^{1}{t}^{4}\\,\\text{d}t-0 \\\\  & =12[\\frac{{t}^{5}}{5}]_{-1}^{1} \\\\  & =12\\cdot \\frac{2}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd2f859-8cbd-5fb2-a799-4047912f2b9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186369450} {:answer/id #uuid "c80ede24-c0d9-5ecf-be0b-3875c8087b10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186369451} {:answer/id #uuid "b67159a4-a2c9-5c6e-a51b-b9e8fec0e05d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369452} {:answer/id #uuid "6d280bef-8091-5d89-be52-181cdb57aaa5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186369453} {:answer/id #uuid "aa5c20b2-9d53-5d85-af6f-b027ed46706b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186369454}] :answer-field/correct {:answer/id #uuid "c80ede24-c0d9-5ecf-be0b-3875c8087b10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186369451} :answer-field/id #uuid "f29d4169-0dcc-5881-9d8b-1107b9cc1f1c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369449}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7834afec-6e2d-5917-b360-ab0e90141806" :question/math-academy-id "q-126858" :question/problem "![](images/52/52ec0dfc4590daf9306c2389bd321acbf80f263c799fa4ddd4e5b8f662e0a2b5.png)\n\nConsider the region $D$ enclosed by the curve $C={C}_{1}\\cup {C}_{2},$ where \n\n- ${C}_{1}$ is parametrized by ${r}_{1}(t)={t}^{5}\\,i+{t}^{4}\\,j$ for $t\\in [-1,1],$ and\n\n- ${C}_{2}$ is parametrized by ${r}_{2}(t)=-t\\,i+1\\,j$ for $t\\in [-1,1].$\n\nUse Green's theorem to find the area of the region." :question/worked-solution "First, let $P(x,y)=0$ and $Q(x,y)=x.$\n\nOur simple, piecewise-smooth, closed path $C$ is positively oriented and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=5{t}^{4}\\,i+4{t}^{3}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-i\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}x\\,\\text{d}y & ={∮}_{{C}_{1}\\cup {C}_{2}}x\\,dy \\\\  & ={∮}_{{C}_{1}}x\\,dy+{∮}_{{C}_{2}}x\\,dy \\\\  & ={\\int }_{-1}^{1}{t}^{5}\\cdot 4{t}^{3}\\,\\text{d}t+{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}{t}^{8}\\,\\text{d}t-0 \\\\  & =4[\\frac{{t}^{9}}{9}]_{-1}^{1} \\\\  & =4\\cdot \\frac{2}{9} \\\\  & =\\frac{8}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46ee80ff-c5ae-55ec-a96c-b506acfb7915" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186431021} {:answer/id #uuid "4addbefd-201e-5755-8641-7e27605c3311" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186431023} {:answer/id #uuid "7a937f5d-4690-55ac-bcf9-5662d89ca2a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186431027} {:answer/id #uuid "b4200cd7-229f-5b2c-80d8-6fbc6195eb39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186431034} {:answer/id #uuid "dd351131-c322-54cb-8179-38615de2670f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186431036}] :answer-field/correct {:answer/id #uuid "7a937f5d-4690-55ac-bcf9-5662d89ca2a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186431027} :answer-field/id #uuid "771735d3-fa1a-5273-a935-b05b06edb2c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431044}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "819104c2-11eb-5b49-9398-d7d5879660f9" :question/math-academy-id "q-126727" :question/problem "![](images/b5/b51e252935f7077f3285258845d8d1e4957b83894037f968ee306910aa88bad6.png)\n\nUse Green's theorem to find the area of the region enclosed by the curve \n$C$ parametrized as $r(t)=-\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡2t\\,j$ \nfor $t\\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}].$" :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$\n\nOur simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y=-{∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡2t\\,j.\\end{aligned}\n$$\n\nFinally, we can evaluate our line integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}-{∮}_{C}y\\,dx & =-{\\int }_{\\pi /2}^{3\\pi /2}2\\operatorname{sin}⁡2t\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-2{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{sin}⁡2t\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-2{\\int }_{\\pi /2}^{3\\pi /2}2\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-4{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{cos}⁡t{sin}^{2}⁡t\\,\\text{d}t \\\\  & =-4{\\int }_{1}^{-1}{u}^{2}\\,\\text{d}u \\\\  & =4{\\int }_{-1}^{1}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{4}{3}{u}^{3}{|}_{-1}^{1} \\\\  & =\\frac{4}{3}({1}^{3}-(-1)^{3}) \\\\  & =\\frac{8}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b151d74-5c74-545d-8b07-dea1d8453657" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186431016} {:answer/id #uuid "32eb8a32-3dbf-536c-8383-dfb162184c29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186431019} {:answer/id #uuid "419ff17a-c941-551d-ad1c-89eccf44a609" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186431020} {:answer/id #uuid "4b345484-1be0-5dbb-8ec3-b21aa5962d50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{9}" :db/id #edb/ref 17592186431024} {:answer/id #uuid "a3a3e7c7-ac4d-53f3-be35-8650eb6afd4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186431031}] :answer-field/correct {:answer/id #uuid "4b345484-1be0-5dbb-8ec3-b21aa5962d50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{9}" :db/id #edb/ref 17592186431024} :answer-field/id #uuid "64517546-ac9e-59a3-822e-98cda097a61b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431043}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bd34f4a5-5a97-5165-88b5-594ad30569e0" :question/math-academy-id "q-126859" :question/problem "![](images/9e/9ebabcf1e3c3c3d2f4850d425657e7314c0135c81a432bfbbc8ae31ee39cb85d.png)\n\nConsider the region $D$ enclosed by the curve $C={C}_{1}\\cup {C}_{2},$ where \n\n- ${C}_{1}$ is parametrized by ${r}_{1}(t)={t}^{5}\\,i-2{t}^{4}\\,j$ for $t\\in [-1,1],$ and\n\n- ${C}_{2}$ is parametrized by ${r}_{2}(t)=-t\\,i-2\\,j$ for $t\\in [-1,1].$\n\nUse Green's theorem to find the area of the region." :question/worked-solution "First, let $P(x,y)=0$ and $Q(x,y)=x.$ \n\nOur simple, piecewise-smooth, closed path $C$ is negatively oriented, and   \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y=-{∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=5{t}^{4}\\,i-8{t}^{3}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-i\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}-{∮}_{C}x\\,\\text{d}y & =-{∮}_{{C}_{1}\\cup {C}_{2}}x\\,dy \\\\  & =-{∮}_{{C}_{1}}x\\,dy-{∮}_{{C}_{2}}x\\,dy \\\\  & =-{\\int }_{-1}^{1}{t}^{5}\\cdot (-8{t}^{3})\\,\\text{d}t-{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =8{\\int }_{-1}^{1}{t}^{8}\\,\\text{d}t+0 \\\\  & =8[\\frac{{t}^{9}}{9}]_{-1}^{1} \\\\  & =8\\cdot \\frac{2}{9} \\\\  & =\\frac{16}{9}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating an Area Using Green's Theorem"}] [{:db/id #edb/ref 17592186133898 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133714 :question/id #uuid "39577555-e9cb-563a-8f5e-8b9ea4b57364" :question/math-academy-id "e-9556" :question/problem "Consider the vector field $\\mathbf{F}(x,y) = e^{x+y} \\, \\mathbf{i} + 3xy \\, \\mathbf{j}.$ Evaluate the scalar curl of $\\mathbf{F}$ at the point $(-1,1).$" :question/worked-solution "If $\\mathbf{F} = P\\,\\mathbf{i} + Q\\,\\mathbf{j}$ is a vector field on $\\mathbb{R}^2$ and the partial derivatives of the components of $\\mathbf F$ all exist, then the *scalar* curl of $\\mathbf{F}$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(3xy)-\\frac{∂}{∂y}({e}^{x+y}) \\\\  & =3y-{e}^{x+y}.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(-1,1),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(-1,1)} & =3(1)-{e}^{-1+1} \\\\  & =3-{e}^{0} \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$"} :knowledge-point/id #uuid "6b65b190-b587-5827-a160-b8df85b6227c" :knowledge-point/questions [{:db/id #edb/ref 17592186134094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99d308c6-8a57-5de5-bcc7-bf40d867d0e2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186130721} {:answer/id #uuid "adb3a2f4-608c-5138-8635-60f40d20bbb6" :answer/type {:db/ident :answer.type/math} :answer/value "-y" :db/id #edb/ref 17592186130722} {:answer/id #uuid "b425488f-374f-5fbf-a20f-6ed75b115a63" :answer/type {:db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186130723} {:answer/id #uuid "bda8a425-c21e-5b88-81a7-318e0cea26f4" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186130724} {:answer/id #uuid "669852c3-9028-56fe-aab7-f1bce32786a2" :answer/type {:db/ident :answer.type/math} :answer/value "xy" :db/id #edb/ref 17592186130725}] :answer-field/id #uuid "8fcbecb7-a504-5e86-b075-909351068095" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130720}] :question/id #uuid "64f58b26-9afd-5961-840b-da865c629781" :question/math-academy-id "q-126427" :question/problem "Given that $F(x, y) = xyi + yj$, what is the scalar curl of $F$?"} {:db/id #edb/ref 17592186134095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "613b73ad-b4bd-580f-91d8-dabafde0761e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186409595} {:answer/id #uuid "8cf92fb5-00f1-572a-8207-d72045cf4a6a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186409599} {:answer/id #uuid "9a5d28d8-413b-530d-ad6e-efa5df8905f1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186409601} {:answer/id #uuid "ee35c795-c099-5c49-977b-052171747158" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186409603} {:answer/id #uuid "f7113576-7a9c-589a-960b-40c8d014ca07" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186409604}] :answer-field/correct {:answer/id #uuid "9a5d28d8-413b-530d-ad6e-efa5df8905f1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186409601} :answer-field/id #uuid "9898eac0-330a-51e3-bb68-1c7f9a46f935" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409607}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "494f0061-8555-5747-be24-aea11c4501ae" :question/math-academy-id "q-126428" :question/problem "Consider the vector field $F(x,y)=x\\operatorname{sin}⁡y\\,i+\\operatorname{cos}⁡(xy)\\,j.$ Evaluate the scalar curl of $F$ at the point $(\\pi ,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(xy))-\\frac{∂}{∂y}(x\\operatorname{sin}⁡y) \\\\  & =-\\operatorname{sin}⁡(xy)\\cdot y-x\\operatorname{cos}⁡y \\\\  & =-y\\operatorname{sin}⁡(xy)-x\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(\\pi ,0),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(\\pi ,0)} & =-0\\cdot \\operatorname{sin}⁡(\\pi \\cdot 0)-\\pi \\cdot \\operatorname{cos}⁡(0) \\\\  & =0-\\pi \\cdot 1 \\\\  & =-\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc3ca35d-b2c9-5696-ab5b-faec203fe6d2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234892}] :answer-field/correct {:answer/id #uuid "dc3ca35d-b2c9-5696-ab5b-faec203fe6d2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234892} :answer-field/id #uuid "49a019d5-8e68-590c-aeae-b08b6bbb3998" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235047}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a254e595-25b7-5631-ae7f-2ec647939f75" :question/math-academy-id "q-168118" :question/problem "The scalar curl of a plane velocity field is called the **vorticity,** denoted $\\omega .$ The vorticity describes a measure of the local rotation of the field at a given point. Find the vorticity of $V$ at $(1,1).$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $\\omega (1,1)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "If $V=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $V$ all exist, then the *scalar* curl of $V$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\end{aligned}\n$$\n\nIn our case, we have $P={x}^{2}y$ and $Q=2xy.$ Therefore, the scalar curl (i.e., the vorticity) of $V$ at $(x,y)$ is given by\n\n$$\n\\begin{aligned}\\omega  & =\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} \\\\  & =\\frac{∂}{∂x}(2xy)-\\frac{∂}{∂y}({x}^{2}y) \\\\  & =2y-{x}^{2}.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(1,1),$ and obtain\n\n$$\n\\begin{aligned}\\omega (1,1) & =(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,{|}_{(1,\\,1)} \\\\  & =2(1)-(1)^{2} \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13264dd3-32ca-5425-ae4a-10ae592d25f7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260044} {:answer/id #uuid "1ad4275e-e84f-5e99-9926-6ed1c4bda7e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186260108} {:answer/id #uuid "5ec4d041-01f8-5cba-bbc5-711d818eb654" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186260692} {:answer/id #uuid "7344edf5-4fa2-53cc-aefd-2082b97c5134" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186260883} {:answer/id #uuid "deb142df-e54d-5f60-a501-f62bc2ccccc3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261841}] :answer-field/correct {:answer/id #uuid "1ad4275e-e84f-5e99-9926-6ed1c4bda7e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186260108} :answer-field/id #uuid "6208b069-a1cc-5b39-96a3-5295dfbd12c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262291}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "84980841-460b-507f-8790-439efc8ff63f" :question/math-academy-id "q-126525" :question/problem "Consider the vector field $F(x,y)=\\operatorname{sin}⁡(x+y)\\,i+(x{y}^{2}+1)\\,j.$ Evaluate the scalar curl of $F$ at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(x{y}^{2}+1)-\\frac{∂}{∂y}(\\operatorname{sin}⁡(x+y)) \\\\  & ={y}^{2}-\\operatorname{cos}⁡(x+y).\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(0,\\frac{\\pi }{2}),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(0,\\pi /2)} & ={(\\frac{\\pi }{2})}^{2}-\\operatorname{cos}⁡(0+\\frac{\\pi }{2}) \\\\  & =\\frac{{\\pi }^{2}}{4}-0 \\\\  & =\\frac{{\\pi }^{2}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad86e3ef-c12c-5d63-830a-dabac47cd90c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261396} {:answer/id #uuid "ad96fb47-5ab0-591e-bc64-e12732e133be" :answer/type {:db/ident :answer.type/math} :answer/value "e-2" :db/id #edb/ref 17592186261400} {:answer/id #uuid "bbd7a97a-dfe1-5328-9d66-c8db33781a74" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261528} {:answer/id #uuid "dbbe8614-b318-5962-bad4-61b3cb58bbab" :answer/type {:db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186261819} {:answer/id #uuid "fd16fd7d-6e48-5c28-b4cd-957ff093701a" :answer/type {:db/ident :answer.type/math} :answer/value "-2e" :db/id #edb/ref 17592186262091}] :answer-field/correct {:answer/id #uuid "ad96fb47-5ab0-591e-bc64-e12732e133be" :answer/type {:db/ident :answer.type/math} :answer/value "e-2" :db/id #edb/ref 17592186261400} :answer-field/id #uuid "8a0748a2-8172-58a7-b068-6319c44ba0db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262365}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e3ea6616-7ac7-5c42-90f8-53e0ef7d6fff" :question/math-academy-id "q-126529" :question/problem "Consider the vector field $F(x,y)=(2x+{y}^{2})\\,i+y{e}^{x}\\,j.$ Evaluate the scalar curl of $F$ at the point $(1,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(y{e}^{x})-\\frac{∂}{∂y}(2x+{y}^{2}) \\\\  & =y{e}^{x}-2y.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(1,1),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(1,1)} & =(1){e}^{1}-2(1) \\\\  & =e-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3041df57-595f-539a-b239-3c78801fee42" :answer/type {:db/ident :answer.type/math} :answer/value "1-3{y}^{2}" :db/id #edb/ref 17592186260309} {:answer/id #uuid "4b114062-2293-5f00-a193-d448102a6e39" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}-3{y}^{2}" :db/id #edb/ref 17592186260520} {:answer/id #uuid "55005e13-3fcc-5508-8bcc-edecfb139184" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260598} {:answer/id #uuid "5caebef8-ad28-5626-af16-e744946586b6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186260668} {:answer/id #uuid "ab2b0c46-2ff3-54df-b539-763bc499f9da" :answer/type {:db/ident :answer.type/math} :answer/value "6x-1" :db/id #edb/ref 17592186261374}] :answe