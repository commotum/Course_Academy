c{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v{e}^{u} & {e}^{u} \\\\ {e}^{v} & u{e}^{v}\\end{aligned}| \\\\  & =v{e}^{u}\\cdot u{e}^{v}-{e}^{v}\\cdot {e}^{u} \\\\  & =uv{e}^{u+v}-{e}^{u+v} \\\\  & =(uv-1){e}^{u+v} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(-1,1)} & =(uv-1){e}^{u+v}\\,{|}_{u=-1\\,v=1} \\\\  & =(-1\\cdot 1-1){e}^{-1+1} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-2|\\cdot \\delta A \\\\  & =2\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a27b376-f76e-5224-bd14-dcd0f58ef17d" :answer/type {:db/ident :answer.type/math} :answer/value "14\\,\\delta A" :db/id #edb/ref 17592186279419} {:answer/id #uuid "6df88852-e281-540b-9be8-5da79ff04db5" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279592} {:answer/id #uuid "e29c7966-53cc-5a98-a45d-f216ac316386" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186280594} {:answer/id #uuid "e5bf82bf-7ae4-51b0-8078-b62137d694c7" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186280619} {:answer/id #uuid "f2ae113f-b190-5e88-a500-9aa18217b4af" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id #edb/ref 17592186280706}] :answer-field/correct {:answer/id #uuid "6df88852-e281-540b-9be8-5da79ff04db5" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279592} :answer-field/id #uuid "150f9199-b68c-5aef-8efe-e079ecbd49f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280869}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9ee4cd0d-00ad-5fb0-be36-91eca3f6f7a9" :question/math-academy-id "q-161873" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\frac{1}{u}-v \\\\ {u}^{2}v\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{1}{{u}^{2}} & -1 \\\\ 2uv & {u}^{2}\\end{aligned}| \\\\  & =(-\\frac{1}{{u}^{2}})\\cdot ({u}^{2})-2uv\\cdot (-1) \\\\  & =-1+2uv \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(2,2)} & =(-1+2uv)\\,{|}_{u=2\\,v=2} \\\\  & =-1+2(2)(2) \\\\  & =7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|7|\\cdot \\delta A \\\\  & =7\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9515a0-7aca-5bd0-93c2-b5138c7c3052" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\delta A" :db/id #edb/ref 17592186279294} {:answer/id #uuid "62fb6c42-d7b5-5116-b4d8-c608240b0020" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279491} {:answer/id #uuid "65e00832-3370-516f-bf0e-931f9e463a62" :answer/type {:db/ident :answer.type/math} :answer/value "21\\,\\delta A" :db/id #edb/ref 17592186279521} {:answer/id #uuid "c042a147-a78a-546c-adff-8d9859d6b5eb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186280284} {:answer/id #uuid "df364235-b831-5c0a-a5fa-907e835f3022" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186280559}] :answer-field/correct {:answer/id #uuid "62fb6c42-d7b5-5116-b4d8-c608240b0020" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186279491} :answer-field/id #uuid "3c8c07a6-1fb4-5da8-abe5-ac2081b48db6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280937}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9201622d-d447-58b4-8006-2fbea11393d4" :question/math-academy-id "q-161874" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(4,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\sqrt{u}+{v}^{2} \\\\ uv\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{2\\sqrt{u}} & 2v \\\\ v & u\\end{aligned}| \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot u-v\\cdot 2v \\\\  & =\\frac{1}{2}\\sqrt{u}-2{v}^{2} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(4,2)} & ={\\frac{1}{2}\\sqrt{u}-2{v}^{2}\\,|}_{u=4\\,v=2} \\\\  & =\\frac{1}{2}\\sqrt{4}-2(2)^{2} \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-7|\\cdot \\delta A \\\\  & =7\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018385f7-7519-5922-8545-718d1e4443e3" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186278597} {:answer/id #uuid "09f72da4-93f7-5f6e-8f5c-7adf97a2d87b" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186278688} {:answer/id #uuid "42229dfb-92db-527f-98d4-81e464debdce" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,\\delta A" :db/id #edb/ref 17592186279182} {:answer/id #uuid "5806f5cb-b442-516d-a7af-f295ed7a67a3" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186279401} {:answer/id #uuid "b63f49ff-6805-5e3d-9a84-bb5bf0cb46d3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186280191}] :answer-field/correct {:answer/id #uuid "09f72da4-93f7-5f6e-8f5c-7adf97a2d87b" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186278688} :answer-field/id #uuid "30341de0-d7c9-531a-935d-0764a34a14a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280923}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8a571cf4-d621-5149-95d3-896e62b990d5" :question/math-academy-id "q-161875" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{cos}⁡u-{v}^{2} \\\\ u+v\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\operatorname{sin}⁡u & -2v \\\\ 1 & 1\\end{aligned}| \\\\  & =(-\\operatorname{sin}⁡u)\\cdot 1-1\\cdot (-2v) \\\\  & =-\\operatorname{sin}⁡u+2v \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(0,3)} & =(-\\operatorname{sin}⁡u+2v)\\,{|}_{u=0\\,v=3} \\\\  & =-\\operatorname{sin}⁡0+2(3) \\\\  & =6\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|6|\\cdot \\delta A \\\\  & =6\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6868218d-e1cc-5d50-a993-c991f43b1d4f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186279541} {:answer/id #uuid "7cc9479c-c9e8-5ef9-bf90-29e06a33263c" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta A" :db/id #edb/ref 17592186279705} {:answer/id #uuid "9162be54-7854-53e2-9565-c82bf2b82b2e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186279888} {:answer/id #uuid "d5ff9956-5830-5df1-9e06-3627aaf262d4" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186280480} {:answer/id #uuid "d96ff063-ffb7-5f8f-95e7-79745e683d0f" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186280513}] :answer-field/correct {:answer/id #uuid "6868218d-e1cc-5d50-a993-c991f43b1d4f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186279541} :answer-field/id #uuid "cf437f98-16a0-57d1-a983-d2d8546f1bd5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281197}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4a48d509-ce9f-57c3-ab71-29eb65410f8f" :question/math-academy-id "q-161885" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\frac{{u}^{2}}{v} \\\\ uv\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{2u}{v} & -\\frac{{u}^{2}}{{v}^{2}} \\\\ v & u\\end{aligned}| \\\\  & =\\frac{2u}{v}\\cdot u-v\\cdot (-\\frac{{u}^{2}}{{v}^{2}}) \\\\  & =\\frac{2{u}^{2}}{v}+\\frac{{u}^{2}}{v} \\\\  & =\\frac{3{u}^{2}}{v} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(2,4)} & =(\\frac{3{u}^{2}}{v})\\,{|}_{u=2\\,v=4} \\\\  & =\\frac{3(2)^{2}}{4} \\\\  & =3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|3|\\cdot \\delta A \\\\  & =3\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cbff252-78de-56e0-9831-68d0d5847cf4" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,\\delta A" :db/id #edb/ref 17592186278858} {:answer/id #uuid "254166ee-c366-5b0a-8254-ef1c99d8cefa" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,\\delta A" :db/id #edb/ref 17592186278923} {:answer/id #uuid "4a7b2391-4ac4-5aba-b7fd-d5c4a0c731ac" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186279258} {:answer/id #uuid "5bb16338-8739-5100-afb4-a97df7a35f4d" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\delta A" :db/id #edb/ref 17592186279437} {:answer/id #uuid "5ec2c7bb-fc96-59d3-9cef-a3d5103aac04" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\delta A" :db/id #edb/ref 17592186279461}] :answer-field/correct {:answer/id #uuid "5bb16338-8739-5100-afb4-a97df7a35f4d" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\delta A" :db/id #edb/ref 17592186279437} :answer-field/id #uuid "82c1b0c7-bd87-588b-918a-c6b0538039e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281069}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "787ef4d5-9dfe-5be7-87e1-4a46bed285bf" :question/math-academy-id "q-161887" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,4)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\sqrt{uv} \\\\ u{v}^{2}\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{\\sqrt{v}}{2\\sqrt{u}} & \\frac{\\sqrt{u}}{2\\sqrt{v}} \\\\ {v}^{2} & 2uv\\end{aligned}| \\\\  & =\\frac{\\sqrt{v}}{2\\sqrt{u}}\\cdot 2uv-{v}^{2}\\cdot \\frac{\\sqrt{u}}{2\\sqrt{v}} \\\\  & =v\\sqrt{uv}-\\frac{1}{2}v\\sqrt{uv} \\\\  & =\\frac{1}{2}v\\sqrt{uv} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(1,4)} & ={(\\frac{1}{2}v\\sqrt{uv})\\,|}_{u=1\\,v=4} \\\\  & =\\frac{1}{2}(4)\\sqrt{(1)(4)} \\\\  & =4\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|4|\\cdot \\delta A \\\\  & =4\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f94640a-439d-5450-b89c-214d6351fa55" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186383570} {:answer/id #uuid "22b7af57-2308-539f-b4dc-7bf734738b88" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id #edb/ref 17592186383571} {:answer/id #uuid "305c7067-b121-52de-832b-2cd582abe378" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186383572} {:answer/id #uuid "0e57c966-7e8f-5c20-b14e-3fff17deba68" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186383573} {:answer/id #uuid "c14d8db9-1f54-501a-a0d4-dbdd47484709" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta A" :db/id #edb/ref 17592186383574}] :answer-field/correct {:answer/id #uuid "305c7067-b121-52de-832b-2cd582abe378" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186383572} :answer-field/id #uuid "1fd0ed70-8ad1-5612-8701-9b382b52743e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383569}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6f0941ca-edd5-5538-8a0c-b3d25f8e41f5" :question/math-academy-id "q-161877" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{ln}⁡(u-v) \\\\ v-{u}^{2}\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{u-v} & -\\frac{1}{u-v} \\\\ -2u & 1\\end{aligned}| \\\\  & =\\frac{1}{u-v}\\cdot 1-(-2u)\\cdot (-\\frac{1}{u-v}) \\\\  & =\\frac{1-2u}{u-v} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(2,1)} & ={(\\frac{1-2u}{u-v})\\,|}_{u=2\\,v=1} \\\\  & =\\frac{1-2(2)}{2-1} \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-3|\\cdot \\delta A \\\\  & =3\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61164a03-d653-5509-8896-92a9f5d833f2" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186383577} {:answer/id #uuid "5766d69f-6242-5cfa-96ee-c8cd587905ef" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id #edb/ref 17592186383578} {:answer/id #uuid "6ec2c14a-52b6-5478-a60f-1f678392ec7a" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186383579} {:answer/id #uuid "5317cbac-448e-539f-b6c8-0a7df3081b44" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\delta A" :db/id #edb/ref 17592186383580} {:answer/id #uuid "18259f51-378f-592e-be8d-c8109a57fd90" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\delta A" :db/id #edb/ref 17592186383581}] :answer-field/correct {:answer/id #uuid "5766d69f-6242-5cfa-96ee-c8cd587905ef" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\delta A" :db/id #edb/ref 17592186383578} :answer-field/id #uuid "c852d323-c95a-5a6d-9333-8d677385a559" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383576}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3a2efb4f-04d0-536e-850b-89df0bdf4245" :question/math-academy-id "q-161878" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-3,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+{v}^{2} \\\\ \\operatorname{sin}⁡(u+v)\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2v \\\\ \\operatorname{cos}⁡(u+v) & \\operatorname{cos}⁡(u+v)\\end{aligned}| \\\\  & =1\\cdot \\operatorname{cos}⁡(u+v)-\\operatorname{cos}⁡(u+v)\\cdot 2v \\\\  & =(1-2v)\\operatorname{cos}⁡(u+v) \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(-3,3)} & =(1-2v)\\operatorname{cos}⁡(u+v)\\,{|}_{u=-3\\,v=3} \\\\  & =(1-2(3))\\operatorname{cos}⁡(-3+3) \\\\  & =-5\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-5|\\cdot \\delta A \\\\  & =5\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186389216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efa02fb0-8bd7-58b2-846f-b834fa4d00a5" :answer/type {:db/ident :answer.type/math} :answer/value "21\\,\\delta A" :db/id #edb/ref 17592186389218} {:answer/id #uuid "f26a101a-d1b7-54cb-9da6-045b68d673b8" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,\\delta A" :db/id #edb/ref 17592186389219} {:answer/id #uuid "102a5894-9256-52e2-86ff-598cf595625d" :answer/type {:db/ident :answer.type/math} :answer/value "13\\,\\delta A" :db/id #edb/ref 17592186389220} {:answer/id #uuid "a7e6000c-9905-5a76-9098-325dd8f54c3e" :answer/type {:db/ident :answer.type/math} :answer/value "11\\,\\delta A" :db/id #edb/ref 17592186389221} {:answer/id #uuid "eca4c4f3-4d0e-5221-a6c4-b18b4d27e0a2" :answer/type {:db/ident :answer.type/math} :answer/value "17\\,\\delta A" :db/id #edb/ref 17592186389222}] :answer-field/correct {:answer/id #uuid "a7e6000c-9905-5a76-9098-325dd8f54c3e" :answer/type {:db/ident :answer.type/math} :answer/value "11\\,\\delta A" :db/id #edb/ref 17592186389221} :answer-field/id #uuid "c652ad8c-b6bc-516a-b0a9-9d72286277e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389217}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dc1b537d-1bb4-5840-be74-781a73ccdf95" :question/math-academy-id "q-161876" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(-2,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{e}^{u+v} \\\\ {u}^{3}+v\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{u+v} & {e}^{u+v} \\\\ 3{u}^{2} & 1\\end{aligned}| \\\\  & ={e}^{u+v}\\cdot 1-3{u}^{2}\\cdot {e}^{u+v} \\\\  & ={e}^{u+v}(1-3{u}^{2}) \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(-2,2)} & ={e}^{u+v}(1-3{u}^{2})\\,{|}_{u=-2\\,v=2} \\\\  & ={e}^{-2+2}(1-3(-2)^{2}) \\\\  & =-11\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-11|\\cdot \\delta A \\\\  & =11\\,\\delta A.\\end{aligned}\n$$"}] :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] [{:db/id #edb/ref 17592186129283 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128861 :question/id #uuid "6102567f-7035-5fa2-b12e-80a0470de4a3" :question/math-academy-id "e-12418" :question/problem "Sketch the region in the $uv$-plane where the transformation $\\mathbf{T},$ given by \n![](images/57/57874e6e685ee9fb1a2b527fe046696aa983b04d22751c72d8a76783b349ca18.svg)\nis (locally) orientation-reversing." :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}  <    0\n$$\n\nWe have\n\n![](images/45/4595adcbeb5ee3dc0bbe1258536e9b0e3e2fc81d5720a3394029df814f55f949.svg)\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{v} & u{e}^{v} \\\\ 2u & -2v\\end{aligned}| \\\\  & ={e}^{v}\\cdot (-2v)-u{e}^{v}\\cdot 2u \\\\  & =-2{e}^{v}({u}^{2}+v).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-2{e}^{v}({u}^{2}+v) & <0 \\\\ {u}^{2}+v & >0 \\\\ v & >-{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=-u^2\n$$\n\ndefines a downward-opening parabola, and the coordinates of, say, $(1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/2b/2b6128c5a1737e3ad1fd82f91f5ccd320421ad3472ae8152440034ecea10d364.png)"} :knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/questions [{:db/id #edb/ref 17592186129503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061056bc-bfce-5ff4-8595-a2d484ecafcd" :answer/type {:db/ident :answer.type/image} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 17592186275531} {:answer/id #uuid "16f3a484-24df-5d26-8a99-6de6aa5fdb49" :answer/type {:db/ident :answer.type/image} :answer/value "images/15/154f70201a5a00737d8df61952f5600ff91a2373df07b0b54680fe84e048402c.png" :db/id #edb/ref 17592186275690} {:answer/id #uuid "5d63b3ec-601c-5feb-8242-cbcc9d6062a7" :answer/type {:db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186276310} {:answer/id #uuid "9cb5eb91-0daf-521c-91f4-9877e03fe3e3" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186276885} {:answer/id #uuid "ff869b8f-3276-5ccb-a221-37224323880c" :answer/type {:db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186277723}] :answer-field/correct {:answer/id #uuid "061056bc-bfce-5ff4-8595-a2d484ecafcd" :answer/type {:db/ident :answer.type/image} :answer/value "images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 17592186275531} :answer-field/id #uuid "cd317045-c8ee-5fc6-a8f1-218f77e90e7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278085}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5ab6f10-630f-5f61-bd52-33e1fa95452d" :question/math-academy-id "q-160341" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-2{v}^{2} \\\\ u-v\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-2{v}^{2} \\\\ u-v\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -4v \\\\ 1 & -1\\end{aligned}| \\\\  & =2u\\cdot (-1)-(-4v)\\cdot 1 \\\\  & =-2u+4v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-2u+4v & <0 \\\\ 4v & <2u \\\\ v & <\\frac{1}{2}u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=\\frac{1}{2}u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/09/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png)"} {:db/id #edb/ref 17592186129509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e468aabf-e6e4-5599-81b1-17dc6d355954" :answer/type {:db/ident :answer.type/image} :answer/value "images/13/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png" :db/id #edb/ref 17592186389030} {:answer/id #uuid "bdeedbec-6bdf-59e7-9b2b-b9d5e4e3ee50" :answer/type {:db/ident :answer.type/image} :answer/value "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186389031} {:answer/id #uuid "a24ff250-c577-5a6e-8589-b7fa78f56034" :answer/type {:db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186389032} {:answer/id #uuid "ddf74745-74d7-5023-8d2f-494bd3a4b62a" :answer/type {:db/ident :answer.type/image} :answer/value "images/15/154f70201a5a00737d8df61952f5600ff91a2373df07b0b54680fe84e048402c.png" :db/id #edb/ref 17592186389033} {:answer/id #uuid "c8a52325-f624-5716-886a-b507033c0141" :answer/type {:db/ident :answer.type/image} :answer/value "images/09/090bab0ac1c6356010d83a6ad54c59b53b7dd12062fb5e331a936ce3f3a1b411.png" :db/id #edb/ref 17592186389034}] :answer-field/correct {:answer/id #uuid "a24ff250-c577-5a6e-8589-b7fa78f56034" :answer/type {:db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186389032} :answer-field/id #uuid "391991ce-c7bf-55cb-8662-29196fd230b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389029}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4471fd6f-9a7d-5e2e-b974-bcbd5ed1ceb0" :question/math-academy-id "q-160601" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ 4u-{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-preserving?" :question/worked-solution "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-v \\\\ 4u-{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -1 \\\\ 4 & -2v\\end{aligned}| \\\\  & =2u\\cdot (-2v)-4\\cdot (-1) \\\\  & =-4uv+4.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-4uv+4 & >0 \\\\ -4uv & >-4 \\\\ uv & <1\\end{aligned}\n$$\n\n \n\nThis gives the solution $v<\\frac{1}{u}$ for $u>0$ and $v>\\frac{1}{u}$ for $u<0.$\n\nNotice that the equation \n\n$$\nv=\\frac{1}{u}\n$$\n\ndefines a hyperbola, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png)"} {:db/id #edb/ref 17592186281352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48838786-15c4-529e-9b61-9a4ae3631e27" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186279238} {:answer/id #uuid "644450bf-23df-5be6-9017-bc23e84a13fa" :answer/type {:db/ident :answer.type/image} :answer/value "images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png" :db/id #edb/ref 17592186279504} {:answer/id #uuid "71de0d63-b9fe-5bf9-98a3-3aa0f0728bad" :answer/type {:db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186279627} {:answer/id #uuid "743bb53f-15e9-5c76-9499-48070c482fc8" :answer/type {:db/ident :answer.type/image} :answer/value "images/7f/7f214af0b5d71689ec7f21fff043e1779f1d3244c13fdbaf7b8df7f408d66298.png" :db/id #edb/ref 17592186279641} {:answer/id #uuid "9e8384cd-3f08-52be-b19d-6807ce1004b4" :answer/type {:db/ident :answer.type/image} :answer/value "images/14/14015cadab7d5dc8a9c33d0c1a57a44a79506bd01ba9b1cfe8ec1d280eb3fbb6.png" :db/id #edb/ref 17592186279998}] :answer-field/correct {:answer/id #uuid "644450bf-23df-5be6-9017-bc23e84a13fa" :answer/type {:db/ident :answer.type/image} :answer/value "images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png" :db/id #edb/ref 17592186279504} :answer-field/id #uuid "158dba50-6c99-530b-a3b4-71c1f3ef60c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280870}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "613ff480-77bb-508e-adea-361b7545c613" :question/math-academy-id "q-161838" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v \\\\ {u}^{2}+{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v \\\\ {u}^{2}+{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ 2u & 2v\\end{aligned}| \\\\  & =1\\cdot (2v)-(2u)\\cdot 1 \\\\  & =2v-2u.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2v-2u & <0 \\\\ 2v & <2u \\\\ v & <u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/83/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png)"} {:db/id #edb/ref 17592186281353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e5ece0f-ace5-59e3-8bac-5e7030391f49" :answer/type {:db/ident :answer.type/image} :answer/value "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186278998} {:answer/id #uuid "56614d5f-f51d-520c-bd5a-2efe188329bc" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186279385} {:answer/id #uuid "63c73c6f-8214-55ad-9f4a-739379cccb77" :answer/type {:db/ident :answer.type/image} :answer/value "images/cb/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png" :db/id #edb/ref 17592186279499} {:answer/id #uuid "90ce74d2-cefd-5461-a622-b31141a5968a" :answer/type {:db/ident :answer.type/image} :answer/value "images/13/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png" :db/id #edb/ref 17592186279883} {:answer/id #uuid "df833e78-3be8-5410-bdd9-e871a352bba6" :answer/type {:db/ident :answer.type/image} 