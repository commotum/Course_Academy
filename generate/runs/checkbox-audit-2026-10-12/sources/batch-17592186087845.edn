:db/id #edb/ref 17592186256387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2075c86f-b918-575b-95e8-97859e70f90d" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-\\sqrt{2})" :db/id #edb/ref 17592186253951} {:answer/id #uuid "52496fb6-06f9-54e1-953b-c03cfcd9334c" :answer/type {:db/ident :answer.type/math} :answer/value "(-2\\sqrt{2},-2\\sqrt{2})" :db/id #edb/ref 17592186254387} {:answer/id #uuid "6724825c-031e-5303-abbe-a1eba30f6cba" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186254603} {:answer/id #uuid "8470b6c3-3213-5f69-8af6-c90604195120" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{2},-1)" :db/id #edb/ref 17592186254848} {:answer/id #uuid "b04df24b-bdd0-5a86-9ea8-ddd583bd9c28" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\sqrt{2},-2)" :db/id #edb/ref 17592186255221}] :answer-field/correct {:answer/id #uuid "52496fb6-06f9-54e1-953b-c03cfcd9334c" :answer/type {:db/ident :answer.type/math} :answer/value "(-2\\sqrt{2},-2\\sqrt{2})" :db/id #edb/ref 17592186254387} :answer-field/id #uuid "5736a212-726e-5d37-950e-cb5984448244" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256090}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cffd31fb-6e24-58d9-bedb-a4c483fcb431" :question/math-academy-id "q-120311" :question/problem "The point $P$ has polar coordinates $(4,{225}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡({225}^{∘}) \\\\  & =4(-\\frac{\\sqrt{2}}{2}) \\\\  & =-2\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡({225}^{∘}) \\\\  & =4(-\\frac{\\sqrt{2}}{2}) \\\\  & =-2\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2\\sqrt{2},-2\\sqrt{2}).$"} {:db/id #edb/ref 17592186294837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c01297c0-4360-5196-b378-cd6d24b00a49" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293681}] :answer-field/correct {:answer/id #uuid "c01297c0-4360-5196-b378-cd6d24b00a49" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293681} :answer-field/id #uuid "5a18b0e0-b9aa-52e0-98f1-977eb7e19dc9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294253} {:answer-field/choices [{:answer/id #uuid "468ac213-e7f6-5724-9735-7787b9bbd432" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293221}] :answer-field/correct {:answer/id #uuid "468ac213-e7f6-5724-9735-7787b9bbd432" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293221} :answer-field/id #uuid "6cc6c722-0281-52d1-9044-934e70f285b3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294311}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eb68afad-979d-5067-bbdf-a0270d1ebbf5" :question/math-academy-id "q-276511" :question/problem "If the point $P$ has polar coordinates $(2,\\frac{\\pi }{2}),$ then its Cartesian coordinates are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =2\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\ x & =2\\cdot 0 \\\\ x & =0\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\ y & =2\\cdot 1 \\\\ y & =2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(0,2).$"} {:db/id #edb/ref 17592186294838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8b2ae77-8b62-5d95-92cd-30b386d31fa5" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186293653}] :answer-field/correct {:answer/id #uuid "b8b2ae77-8b62-5d95-92cd-30b386d31fa5" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{3}" :db/id #edb/ref 17592186293653} :answer-field/id #uuid "9fabd070-935d-5a2e-a288-75e37fb6b529" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294504} {:answer-field/choices [{:answer/id #uuid "d50cbd5a-22d6-5311-8256-9d985b42f1cc" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293758}] :answer-field/correct {:answer/id #uuid "d50cbd5a-22d6-5311-8256-9d985b42f1cc" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293758} :answer-field/id #uuid "a5b8ae25-12a1-5948-afc5-b6d6a4c132c3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294524}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "41b67774-fd1a-58ed-b47c-db421e0a8ae7" :question/math-academy-id "q-276514" :question/problem "If the point $P$ has polar coordinates $(4,\\frac{7\\pi }{6}),$ then its Cartesian coordinates are\n\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =4\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-2\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =4\\cdot -\\frac{1}{2} \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2\\sqrt{3},-2).$"} {:db/id #edb/ref 17592186294873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bec1215c-a928-5e0d-bdca-f0ee1a9eeb09" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293676}] :answer-field/correct {:answer/id #uuid "bec1215c-a928-5e0d-bdca-f0ee1a9eeb09" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186293676} :answer-field/id #uuid "a736685c-11e6-54f2-a5de-ef608423b32b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294531} {:answer-field/choices [{:answer/id #uuid "239fe93b-47ca-58b8-94c8-c516ddb17b0d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186293083}] :answer-field/correct {:answer/id #uuid "239fe93b-47ca-58b8-94c8-c516ddb17b0d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186293083} :answer-field/id #uuid "e1a81f9d-47a7-5fca-93b8-996ea238d63a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294722}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "83820c39-8bef-53bd-a5fc-3568dd433cbb" :question/math-academy-id "q-276774" :question/problem "If the point $P$ has polar coordinates $(2,{300}^{∘}),$ then its Cartesian coordinates are\n\n$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡({300}^{∘}) \\\\  & =2(\\frac{1}{2}) \\\\  & =1\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡({300}^{∘}) \\\\  & =2(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(1,-\\sqrt{3}).$"} {:db/id #edb/ref 17592186354404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08efb97a-0845-52d8-bdec-7bd31306c42b" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},-3\\sqrt{2})" :db/id #edb/ref 17592186351646} {:answer/id #uuid "230bc612-57e0-56e6-8eea-f9e3d483e43e" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},3\\sqrt{2})" :db/id #edb/ref 17592186351882} {:answer/id #uuid "338ca3df-505f-596c-a48d-5be76e527d0d" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},-3\\sqrt{2})" :db/id #edb/ref 17592186352044} {:answer/id #uuid "3fa18674-53ae-5117-b249-67885b2aced3" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{3}{2},-3\\sqrt{2})" :db/id #edb/ref 17592186352155} {:answer/id #uuid "4896ba6b-ce49-594f-aaf5-6386e658c01e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-\\frac{1}{2})" :db/id #edb/ref 17592186352234}] :answer-field/correct {:answer/id #uuid "230bc612-57e0-56e6-8eea-f9e3d483e43e" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},3\\sqrt{2})" :db/id #edb/ref 17592186351882} :answer-field/id #uuid "c1be8990-390c-5a17-b09b-6ffc2b3112fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354149}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f70a1b51-73cd-5475-aadd-7e2e3bee491f" :question/math-academy-id "q-8519" :question/problem "The point $P$ has polar coordinates $(6,{45}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate od $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =6\\operatorname{cos}⁡({45}^{∘}) \\\\ x & =6\\cdot \\frac{\\sqrt{2}}{2} \\\\ x & =3\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =6\\operatorname{sin}⁡({45}^{∘}) \\\\ y & =6\\cdot \\frac{\\sqrt{2}}{2} \\\\ y & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(3\\sqrt{2},3\\sqrt{2}).$"}] :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given in Polar Coordinates"}]}
