answer/id #uuid "6f7ccbe7-06c3-5517-a28c-85c2c93dd1cc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186251462} {:answer/id #uuid "d660a7a7-dc36-5e4d-a9c3-166dbc8a4519" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252451} {:answer/id #uuid "ee8b6705-43a0-5e03-9cf5-13a5fd9b86d4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186252643} {:answer/id #uuid "f84a8157-12d6-59ae-8ec7-46e3a067045a" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186252726}] :answer-field/correct {:answer/id #uuid "d660a7a7-dc36-5e4d-a9c3-166dbc8a4519" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252451} :answer-field/id #uuid "6791bcd9-7fc1-57ae-bf12-184e668747b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252993}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3178c55c-4ff5-5444-b0f8-fb074a12a44a" :question/math-academy-id "q-118780" :question/problem "What is the order of the ordinary differential equation ${x}^{2}\\frac{{\\text{d}}^{7}y}{\\text{d}{x}^{7}}-9{x}^{7}\\frac{\\text{d}y}{\\text{d}x}=2\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}}?$" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}},$ which has order $8.$\n\nTherefore, the order of the ODE is $8.$"} {:db/id #edb/ref 17592186233253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8743aa26-cf69-5449-934f-38ba3af38f5b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186422177} {:answer/id #uuid "74efbd4d-220e-5275-80bd-028967ae7884" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186422178}]