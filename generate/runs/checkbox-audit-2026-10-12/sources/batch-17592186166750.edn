b05c-c3d2ef4f194f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382684} {:answer/id #uuid "7ae9b086-4ca3-5355-af06-586613fd1dc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{{y}^{2}+1}\\,i-\\operatorname{ln}⁡({y}^{2}+1)\\,j" :db/id #edb/ref 17592186382685} {:answer/id #uuid "fa1ed37a-ed72-5634-8413-f5aedf5da794" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2xy}{{y}^{2}+1}\\,i+\\operatorname{ln}⁡({y}^{2}+1)\\,j" :db/id #edb/ref 17592186382686} {:answer/id #uuid "6d47ca13-b171-5cc5-9de1-aa1e0daf4499" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i-\\frac{xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382687} {:answer/id #uuid "5b384027-61ed-5223-9ea6-1b096f29bda4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382688}] :answer-field/correct {:answer/id #uuid "5b384027-61ed-5223-9ea6-1b096f29bda4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j" :db/id #edb/ref 17592186382688} :answer-field/id #uuid "5323b306-b747-5d4a-8438-95e5a038dfe5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382683}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a92703b-4103-5d43-a169-46ae386c0c50" :question/math-academy-id "q-104400" :question/problem "For which of the following vector fields is $f(x,y)=x\\operatorname{ln}⁡({y}^{2}+1)$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j \\\\  & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡({y}^{2}+1))\\,i+\\frac{∂}{∂y}(x\\operatorname{ln}⁡({y}^{2}+1))\\,j \\\\  & =\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2xy}{{y}^{2}+1}\\,j.\n$$"} {:db/id #edb/ref 17592186382689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7109fa2b-c389-5fc6-b0c4-b41d4d74bf4c" :answer/type {:db/ident :answer.type/math} :answer/value "6x\\,i-y\\,j-4z\\,k" :db/id #edb/ref 17592186382691} {:answer/id #uuid "e9db5c91-f335-58aa-97c3-99952996d70f" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\,i-2y\\,j-2z\\,k" :db/id #edb/ref 17592186382692} {:answer/id #uuid "0631570a-280c-5f08-a196-767cab352a76" :answer/type {:db/ident :answer.type/math} :answer/value "6x\\,i-2y\\,j-4z\\,k" :db/id #edb/ref 17592186382693} {:answer/id #uuid "fc7f9857-e151-5110-9b90-a5c8c453d023" :answer/type {:db/ident :answer.type/math} :answer/value "6x\\,i+2y\\,j+4z\\,k" :db/id #edb/ref 17592186382694} {:answer/id #uuid "8dc25693-095f-5e5b-8994-90d409ec8817" :answer/type {:db/ident :answer.type/math} :answer/value "3x\\,i-y\\,j-2z\\,k" :db/id #edb/ref 17592186382695}] :answer-field/correct {:answer/id #uuid "0631570a-280c-5f08-a196-767cab352a76" :answer/type {:db/ident :answer.type/math} :answer/value "6x\\,i-2y\\,j-4z\\,k" :db/id #edb/ref 17592186382693} :answer-field/id #uuid "777faee0-1b4e-5ed3-9d6b-efa0173e6d16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382690}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "99ded14c-42f7-5e12-a882-b682276e471b" :question/math-academy-id "q-104402" :question/problem "For which of the following vector fields is $f(x,y,z)=3{x}^{2}-{y}^{2}-2{z}^{2}$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k \\\\  & =\\frac{∂}{∂x}(3{x}^{2}-{y}^{2}-2{z}^{2})\\,i+\\frac{∂}{∂y}(3{x}^{2}-{y}^{2}-2{z}^{2})\\,j+\\frac{∂}{∂z}(3{x}^{2}-{y}^{2}-2{z}^{2})\\,k \\\\  & =6x\\,i-2y\\,j-4z\\,k \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=6x\\,i-2y\\,j-4z\\,k.\n$$"} {:db/id #edb/ref 17592186382696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7a94cea-936d-5e4d-ae19-8ad4604dbaa4" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡(xy-z)\\,i+y\\operatorname{cos}⁡(xy-z)\\,j-z\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382698} {:answer/id #uuid "e3feb8c8-b6b5-5b0c-979a-fa204c7f4e38" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382699} {:answer/id #uuid "115abe44-c0ca-57da-b518-6f2d0f2c33ca" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{sin}⁡(xy-z)\\,i-x\\operatorname{cos}⁡(xy-z)\\,j+\\operatorname{sin}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382700} {:answer/id #uuid "45dbde3e-c0f4-522e-8450-38dd964b2722" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡(xy-z)\\,i-y\\operatorname{cos}⁡(xy-z)\\,j+\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382701} {:answer/id #uuid "d4a258a7-72bb-5a84-a2bc-356a3c11b847" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{sin}⁡(xy-z)\\,j-\\operatorname{sin}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382702}] :answer-field/correct {:answer/id #uuid "e3feb8c8-b6b5-5b0c-979a-fa204c7f4e38" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k" :db/id #edb/ref 17592186382699} :answer-field/id #uuid "52aae08c-2f4f-5759-bdb7-0ce12352bc22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382697}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "92017542-0c54-511c-9493-08cbabacf96f" :question/math-academy-id "q-104403" :question/problem "For which of the following vector fields is $f(x,y,z)=\\operatorname{sin}⁡(xy-z)$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k \\\\  & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy-z))\\,i+\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy-z))\\,j+\\frac{∂}{∂z}(\\operatorname{sin}⁡(xy-z))\\,k \\\\  & =y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=y\\operatorname{cos}⁡(xy-z)\\,i+x\\operatorname{cos}⁡(xy-z)\\,j-\\operatorname{cos}⁡(xy-z)\\,k.\n$$"} {:db/id #edb/ref 17592186382703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4316cd9b-1517-5a38-89bb-fe261972cb80" :answer/type {:db/ident :answer.type/math} :answer/value "i+j+k" :db/id #edb/ref 17592186382705} {:answer/id #uuid "c74231a7-4c08-5c80-aad4-2f6813ba5103" :answer/type {:db/ident :answer.type/math} :answer/value "2i-j-k" :db/id #edb/ref 17592186382706} {:answer/id #uuid "e4527c6a-2fc5-5c2f-b8da-1f12673c53d8" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x-y-z}\\,i+{e}^{2x-y-z}\\,j+{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382707} {:answer/id #uuid "822aa67f-98a4-57c6-8772-9ee5aa70cf3d" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382708} {:answer/id #uuid "22eacead-e6b0-5320-9bdc-0ffab1b473ca" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382709}] :answer-field/correct {:answer/id #uuid "822aa67f-98a4-57c6-8772-9ee5aa70cf3d" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k" :db/id #edb/ref 17592186382708} :answer-field/id #uuid "98bee3aa-ab3e-511a-89b6-caa042a74ebf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382704}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d18a5537-9a57-5262-bad7-d34e0ce877ea" :question/math-academy-id "q-104404" :question/problem "For which of the following vector fields is $f(x,y,z)={e}^{2x-y-z}$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient.\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k \\\\  & =\\frac{∂}{∂x}({e}^{2x-y-z})\\,i+\\frac{∂}{∂y}({e}^{2x-y-z})\\,j+\\frac{∂}{∂z}({e}^{2x-y-z})\\,k \\\\  & =2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF=2{e}^{2x-y-z}\\,i-{e}^{2x-y-z}\\,j-{e}^{2x-y-z}\\,k.\n$$"}] :knowledge-point/title "Identifying the Vector Field Corresponding to a Given Potential Function"}] [{:db/id #edb/ref 17592186166863 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166716 :question/id #uuid "3f266f66-1d79-5864-b497-1bc1b138c318" :question/math-academy-id "e-9499" :question/problem "Which of the following vector fields are conservative on $\\mathbb R^2?$\n\n- $\\mathbf F = (e^{y^2} - 2xy) \\, \\mathbf i + (2xye^{y^2} - y) \\,\\mathbf j$\n\n- $\\mathbf G = (3x^2 - y^2) \\, \\mathbf i + (4 - 2xy) \\,\\mathbf j$\n\n- $\\mathbf H = (xy^2 + 1) \\, \\mathbf i + 2xy \\,\\mathbf j$" :question/worked-solution "Let $\\mathbf F(x,y) = P(x,y)\\,\\mathbf i+ Q(x,y)\\,\\mathbf j$ be a vector field with domain $D = \\mathbb R^2,$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$\\mathbf F$ *is conservative if and only if $\\dfrac{\\partial P}{\\partial y} = \\dfrac{\\partial Q}{\\partial x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D = \\mathbb R^2.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $\\mathbf F,$ we have $P = e^{y^2} - 2xy$ and $Q = 2xye^{y^2} - y.$ Computing the partial derivatives, we get\n\n$$\n\\dfrac{\\partial P}{\\partial y} = 2ye^{y^2} - 2x, \\qquad  \\dfrac{\\partial Q}{\\partial x} = 2ye^{y^2}.\n$$\n\nSince the partial derivatives are not equal, we conclude that $\\mathbf F$ is not conservative on $\\mathbb R^2.$\n\n- For the vector field $\\mathbf G,$ we have $P = 3x^2 - y^2$ and $Q = 4 - 2xy.$ Computing the partial derivatives, we get\n\n$$\n\\dfrac{\\partial P}{\\partial y} = -2y, \\qquad  \\dfrac{\\partial Q}{\\partial x} = -2y.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on $\\mathbb R^2,$ we conclude that $\\mathbf{G}$ is conservative on $\\mathbb R^2.$\n\n- For the vector field $\\mathbf H,$ we have $P = xy^2 + 1$ and $Q = 2xy.$ Computing the partial derivatives, we get\n\n$$\n\\dfrac{\\partial P}{\\partial y} = 2xy, \\qquad \\dfrac{\\partial Q}{\\partial x} = 2y.\n$$\n\nSince the partial derivatives are not equal, we conclude that $\\mathbf{H}$ is not conservative on $\\mathbb R^2.$\n\nTherefore, the correct answer is \"II only.\""} :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/questions [{:db/id #edb/ref 17592186167051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111ee143-b204-52dc-901b-47382a1489db" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186238194} {:answer/id #uuid "3581368e-c885-5ff2-b82a-09eb6f093bd6" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238521} {:answer/id #uuid "4f8915d6-8b4a-5c14-9460-5b71897c903f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186238738} {:answer/id #uuid "58e93f7f-87c4-5995-8170-4643fd94d517" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186238820} {:answer/id #uuid "faa73f66-6bc9-5ad8-9cb2-050ec0587a12" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186240271}] :answer-field/correct {:answer/id #uuid "3581368e-c885-5ff2-b82a-09eb6f093bd6" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186238521} :answer-field/id #uuid "b8d72dee-892f-5d42-b6d4-b3e265727c9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240653}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ef2b9923-252b-570f-aaa0-557007eb97e9" :question/math-academy-id "q-104570" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=x{e}^{xy}\\,i+y{e}^{xy}\\,j$\n- $G=(xy+{y}^{2})\\,i+(xy+{x}^{2})\\,j$\n- $H=\\operatorname{cos}⁡(x-y)\\,i-\\operatorname{cos}⁡(x-y)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x{e}^{xy}$ and $Q=y{e}^{xy}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}={x}^{2}{e}^{xy},\\,\\frac{∂Q}{∂x}={y}^{2}{e}^{xy}.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=xy+{y}^{2}$ and $Q=xy+{x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=x+2y,\\,\\frac{∂Q}{∂x}=y+2x.\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\operatorname{cos}⁡(x-y)$ and $Q=-\\operatorname{cos}⁡(x-y).$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\operatorname{sin}⁡(x-y),\\,\\frac{∂Q}{∂x}=\\operatorname{sin}⁡(x-y).\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186167319 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f57512d-b808-5b37-8b72-ba85bc2ab9c9" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186348581} {:answer/id #uuid "598051c0-ae0c-551f-a7b8-2f880f705ade" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186349272} {:answer/id #uuid "91e79ff7-018d-5f66-9d42-027d480cda21" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186349750} {:answer/id #uuid "a7f998e9-1712-5e4d-ac9e-7f869c27f48b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186349942} {:answer/id #uuid "b28b84e3-ed80-5009-8b70-0b6177e3b17a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186350026}] :answer-field/correct {:answer/id #uuid "91e79ff7-018d-5f66-9d42-027d480cda21" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186349750} :answer-field/id #uuid "ae2ae959-f0fc-512a-9f2b-e7bd024880fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351005}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "321a61eb-7345-5f73-a2c6-72200c42218f" :question/math-academy-id "q-81745" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=({x}^{2}+2y)\\,i+({x}^{2}+2y)\\,j$\n- $G=(y{e}^{x}+2)\\,i+({e}^{x}+4y)\\,j$\n- $H=y\\,i+x\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ \n\nWith this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P={x}^{2}+2y$ and $Q={x}^{2}+2y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=y{e}^{x}+2$ and $Q={e}^{x}+4y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{x},\\,\\frac{∂Q}{∂x}={e}^{x}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=y$ and $Q=x.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=1,\\,\\frac{∂Q}{∂x}=1.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186240898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58f11833-470e-5bef-bed8-6e5dd7f35fe9" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238821} {:answer/id #uuid "73bfaf49-d235-5587-b751-402d142ac763" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186239046} {:answer/id #uuid "a836c130-129a-569d-9e28-b1933339a9c4" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186239516} {:answer/id #uuid "b09885ad-d9c7-552d-b4c7-930d5c59c1e0" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239589} {:answer/id #uuid "fb3240e0-b339-53b6-a701-9e9f4809ca9f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186240276}] :answer-field/correct {:answer/id #uuid "b09885ad-d9c7-552d-b4c7-930d5c59c1e0" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186239589} :answer-field/id #uuid "4fa88a49-b814-5ee5-80f8-03e880fa2400" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240472}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7ff94cca-f0c0-5b4f-9e96-5ccdc57e1837" :question/math-academy-id "q-104573" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=(2x-y)\\,i-x\\,j$\n- $G=y\\operatorname{cos}⁡(xy)\\,i+x\\operatorname{cos}⁡(xy)\\,j$\n- $H={e}^{x-y}\\,i-{e}^{x-y}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=2x-y$ and $Q=-x.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-1,\\,\\frac{∂Q}{∂x}=-1.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=y\\operatorname{cos}⁡(xy)$ and $Q=x\\operatorname{cos}⁡(xy).$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy),\\,\\frac{∂Q}{∂x}=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy).\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={e}^{x-y}$ and $Q=-{e}^{x-y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-{e}^{x-y},\\,\\frac{∂Q}{∂x}=-{e}^{x-y}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186240901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c39dccc-d152-5823-8cfe-96d61199aa56" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186238165} {:answer/id #uuid "21e993fb-7e01-5a59-b005-ac176de2681e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238349} {:answer/id #uuid "2643658b-7491-52bd-8be9-74fb74f6311b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186238387} {:answer/id #uuid "9a0c18d7-5599-5d7e-8192-2ab68f7c76f4" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186239392} {:answer/id #uuid "9ba2a58b-9f8a-5330-9034-f99d18182f35" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186239411}] :answer-field/correct {:answer/id #uuid "21e993fb-7e01-5a59-b005-ac176de2681e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186238349} :answer-field/id #uuid "97fa4ed2-4752-5f83-95ae-700c3f3d2fe0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240597}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aac0da30-e1e4-5293-838c-ddb161ffe326" :question/math-academy-id "q-104582" :question/problem "Which of the following vector fields are conservative in their respective domains?\n\n- $F=(2x-4y)\\,i+(4x-8y)\\,j$\n- $G={2}^{2x+y+1}\\,i+{2}^{2x+y}\\,j$\n- $H=2x\\operatorname{ln}⁡({y}^{2}+1)\\,i+\\frac{2{x}^{2}y}{{y}^{2}+1}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=2x-4y$ and $Q=4x-8y.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-4,\\,\\frac{∂Q}{∂x}=4.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P={2}^{2x+y+1}$ and $Q={2}^{2x+y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}={2}^{2x+y+1}\\operatorname{ln}⁡2,\\,\\frac{∂Q}{∂x}={2}^{2x+y+1}\\operatorname{ln}⁡2.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=2x\\operatorname{ln}⁡({y}^{2}+1)$ and $Q=\\frac{2{x}^{2}y}{{y}^{2}+1}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{4xy}{{y}^{2}+1},\\,\\frac{∂Q}{∂x}=\\frac{4xy}{{y}^{2}+1}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186259580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21d9852e-69fd-5f78-b596-3c06c036a10f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257058} {:answer/id #uuid "49de7af0-f078-503e-95c7-8697a62eeaee" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257427} {:answer/id #uuid "5ed252e8-5b71-548f-b94e-185b4ee28acf" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257615} {:answer/id #uuid "b6ce090d-299a-51d2-8010-91cd86e763aa" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258372} {:answer/id #uuid "fe21bd30-6e40-5d24-8d08-9bd937dd0001" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186259009}] :answer-field/correct {:answer/id #uuid "49de7af0-f078-503e-95c7-8697a62eeaee" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257427} :answer-field/id #uuid "449d9eb0-dd44-5a20-acf3-6f28a9047d75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259156}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dc1786af-49ed-5f49-98af-90852a6f6e8b" :question/math-academy-id "q-123984" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=x\\operatorname{sin}⁡y\\,i+y\\operatorname{cos}⁡x\\,j$\n- $G=3{e}^{3x+2y}\\,i+2{e}^{3x+2y}\\,j$\n- $H=2xy\\,i+({x}^{2}+{y}^{2})\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x\\operatorname{sin}⁡y$ and $Q=y\\operatorname{cos}⁡x.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=x\\operatorname{cos}⁡y,\\,\\frac{∂Q}{∂x}=-y\\operatorname{sin}⁡x.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=3{e}^{3x+2y}$ and $Q=2{e}^{3x+2y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=6{e}^{3x+2y},\\,\\frac{∂Q}{∂x}=6{e}^{3x+2y}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=2xy$ and $Q={x}^{2}+{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=2x,\\,\\frac{∂Q}{∂x}=2x.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186351310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b20504-eb8f-5d01-805e-5c2c73911ff9" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186348497} {:answer/id #uuid "58495078-f25d-5caa-9e9f-acd35b208492" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186349257} {:answer/id #uuid "b6e29989-1115-51bc-b006-b0585434984c" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186350068} {:answer/id #uuid "f19cb000-c2b9-5463-89d0-62d431f51a49" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186350558} {:answer/id #uuid "f9b70ce0-457c-5a69-8109-1155c16a7979" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186350643}] :answer-field/correct {:answer/id #uuid "b6e29989-1115-51bc-b006-b0585434984c" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186350068} :answer-field/id #uuid "cc7186dc-6d3c-52e8-99a2-72eb1d283968" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351063}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cc1a89db-98a6-54e9-a27c-1ebc3462a7a6" :question/math-academy-id "q-81460" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F(x,y)=2xy\\,i+{x}^{2}\\,j$\n- $G(x,y)=\\operatorname{sin}⁡({y}^{2})\\,i+2xy\\operatorname{cos}⁡({y}^{2})\\,j$\n- $H(x,y)=y{e}^{xy}\\,i+x{e}^{xy}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=2xy$ and $Q={x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2x,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=\\operatorname{sin}⁡({y}^{2})$ and $Q=2xy\\operatorname{cos}⁡({y}^{2}).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y\\operatorname{cos}⁡({y}^{2}),\\,\\frac{∂Q}{∂x}=2y\\operatorname{cos}⁡({y}^{2}).\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=y{e}^{xy}$ and $Q=x{e}^{xy}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{xy}+xy{e}^{xy},\\,\\frac{∂Q}{∂x}={e}^{xy}+xy{e}^{xy}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III\"."} {:db/id #edb/ref 17592186351360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2806c1c4-5819-5528-99b5-07a1282188af" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186348791} {:answer/id #uuid "41fdca7b-2f69-53c5-aa30-5da82b0afbb0" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186349045} {:answer/id #uuid "5ad21b19-a14c-5c7e-b405-21c881609989" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186349283} {:answer/id #uuid "9d2051ba-4a15-5899-8d3d-05372dec18d7" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186349850} {:answer/id #uuid "ec6fe9b6-1320-51b4-91b9-2a021494df06" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186350512}] :answer-field/correct {:answer/id #uuid "5ad21b19-a14c-5c7e-b405-21c881609989" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186349283} :answer-field/id #uuid "3c423c97-fbb0-595a-8ba8-a36055c42250" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350812}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2410b4fd-4172-5cce-b672-b1259e48aa6b" :question/math-academy-id "q-81743" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=x\\operatorname{sin}⁡(xy)\\,i+y\\operatorname{sin}⁡(xy)\\,j$\n- $G=(2x+1)\\,i+(5{y}^{2}+2y+1)\\,j$\n- $H={y}^{2}\\,i+{x}^{2}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x\\operatorname{sin}⁡(xy)$ and $Q=y\\operatorname{sin}⁡(xy).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={x}^{2}\\operatorname{cos}⁡(xy),\\,\\frac{∂Q}{∂x}={y}^{2}\\operatorname{cos}⁡(xy).\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=2x+1$ and $Q=5{y}^{2}+2y+1.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=0.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={y}^{2}$ and $Q={x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186351361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f855fb8-acdd-56d6-868a-909a37ec196a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186348584} {:answer/id #uuid "8333608c-ada1-5c9e-8613-f80c9ade1729" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186349647} {:answer/id #uuid "95274748-d466-516d-9cc4-9d612b948b6f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186349783} {:answer/id #uuid "ba12d4ba-4e27-5b70-a28e-e4122b80fe51" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186350097} {:answer/id #uuid "ef58528b-7e6f-5240-90e2-cd211e1304a8" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186350542}] :answer-field/correct {:answer/id #uuid "8333608c-ada1-5c9e-8613-f80c9ade1729" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186349647} :answer-field/id #uuid "34bf605a-a2c4-55a9-b98c-3dfee16df4de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350798}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7be69df3-7414-5358-b771-962bb47016d4" :question/math-academy-id "q-81746" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=xy\\,i+(\\frac{1}{2}{x}^{2}+{y}^{2})\\,j$\n- $G=(4x+{y}^{2})\\,i-4x{y}^{2}\\,j$\n- $H=\\operatorname{sin}⁡(xy)\\,i+\\operatorname{cos}⁡(xy)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.  \n\n- For the vector field $F,$ we have $P=xy$ and $Q=\\frac{1}{2}{x}^{2}+{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x,\\,\\frac{∂Q}{∂x}=x.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=4x+{y}^{2}$ and $Q=-4x{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=-4{y}^{2}.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\operatorname{sin}⁡(xy)$ and $Q=\\operatorname{cos}⁡(xy).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x\\operatorname{cos}⁡(xy),\\,\\frac{∂Q}{∂x}=-y\\operatorname{sin}⁡(xy),.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186383048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b75a3d7-2c68-5045-939c-b96536eefabd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186383050} {:answer/id #uuid "f5875d4b-1aef-538a-bf55-036d2dbe25e0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186383051} {:answer/id #uuid "64767d53-1d74-51af-ad19-60acded6a893" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186383052} {:answer/id #uuid "dd5e03b1-190d-56fe-ba76-1f1148be498c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186383053} {:answer/id #uuid "aeb3f32d-6563-5ea5-b046-5c00b38ede14" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186383054}] :answer-field/correct {:answer/id #uuid "f5875d4b-1aef-538a-bf55-036d2dbe25e0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186383051} :answer-field/id #uuid "d45c8874-e962-5ad8-a6b1-35fe34dae948" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383049}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7f81692c-bc38-55e0-9228-b9c2fd15506d" :question/math-academy-id "q-123866" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=x{y}^{2}\\,i+{x}^{2}y\\,j$\n- $G=2x\\,i-3(x+y)\\,j$\n- $H={e}^{x-y}\\,i+{e}^{y-x}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=x{y}^{2}$ and $Q={x}^{2}y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2xy,\\,\\frac{∂Q}{∂x}=2xy.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=2x$ and $Q=-3(x+y).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=-3.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={e}^{x-y}$ and $Q={e}^{y-x}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-{e}^{x-y},\\,\\frac{∂Q}{∂x}=-{e}^{y-x}.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186410575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dd4d74c-d28c-5067-b253-93fff9b615be" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186410564} {:answer/id #uuid "96aeda3b-433c-5c5a-a89e-38dda14fc2d1" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186410567} {:answer/id #uuid "b3d7b4b6-5f16-50df-84c9-3952694f88d8" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186410568} {:answer/id #uuid "ccb3baff-2a23-5160-bf8a-97ba1ff3048b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186410569} {:answer/id #uuid "dc0937dc-40e4-5230-9016-9a4210085b2c" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186410570}] :answer-field/correct {:answer/id #uuid "6dd4d74c-d28c-5067-b253-93fff9b615be" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186410564} :answer-field/id #uuid "bd4eb193-01d2-584e-8123-beed2a93cb45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410573}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6b4c4358-44ac-586a-b065-3dc8b8db940a" :question/math-academy-id "q-104574" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=\\frac{2x}{{e}^{y}}\\,i-\\frac{{x}^{2}}{{e}^{y}}\\,j$\n- $G=\\operatorname{arctan}⁡y\\,i-\\frac{x}{{y}^{2}+1}\\,j$\n- $H=(8x-3y)\\,i+(4y-3x+1)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=\\frac{2x}{{e}^{y}}$ and $Q=-\\frac{{x}^{2}}{{e}^{y}}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-\\frac{2x}{{e}^{y}},\\,\\frac{∂Q}{∂x}=-\\frac{2x}{{e}^{y}}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=\\operatorname{arctan}⁡y$ and $Q=-\\frac{x}{{y}^{2}+1}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{1}{{y}^{2}+1},\\,\\frac{∂Q}{∂x}=-\\frac{1}{{y}^{2}+1}.\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=8x-3y$ and $Q=4y-3x+1.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-3,\\,\\frac{∂Q}{∂x}=-3.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186410576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3575b062-a274-5475-804d-55979057dd00" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186410563} {:answer/id #uuid "78caf0fc-34c9-58ec-aada-68ca4ec8235e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186410565} {:answer/id #uuid "8e23f760-5ac7-5ae1-99ac-01f57b186e7b" :answer/type {:db/ident :answer.type/text} :answer/value "ll only" :db/id #edb/ref 17592186410566} {:answer/id #uuid "eef188a5-b79b-535e-a698-3abfd5aa7c90" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186410571} {:answer/id #uuid "ef9201b9-0d51-54ab-bcd2-eefc57d9346d" :answer/type {:db/ident :answer.type/text} :answer/value "l only" :db/id #edb/ref 17592186410572}] :answer-field/correct {:answer/id #uuid "78caf0fc-34c9-58ec-aada-68ca4ec8235e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186410565} :answer-field/id #uuid "e9b7d5ac-eef6-5e03-9395-4cad5505dd2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410574}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "953d7cc2-ab7b-52e3-b63e-6dc18089f06f" :question/math-academy-id "q-86896" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=({e}^{x+y}-\\sqrt{2})\\,i+({e}^{x+y}-\\sqrt{7})\\,j$\n- $G=({y}^{3}-6x)\\,i+(3x{y}^{2})\\,j$\n- $H=\\frac{2xy}{{x}^{2}+1}\\,i+\\operatorname{ln}⁡({x}^{2}+1)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P={e}^{x+y}-\\sqrt{2}$ and $Q={e}^{x+y}-\\sqrt{7}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{x+y},\\,\\frac{∂Q}{∂x}={e}^{x+y}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P={y}^{3}-6x$ and $Q=3x{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=3{y}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\frac{2xy}{{x}^{2}+1}$ and $Q=\\operatorname{ln}⁡({x}^{2}+1).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=\\frac{2x}{{x}^{2}+1},\\,\\frac{∂Q}{∂x}=\\frac{2x}{{x}^{2}+1}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III\"."}] :knowledge-point/title "Identifying Conservative Vector Fields"}] [{:db/id #edb/ref 17592186166864 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166717 :question/id #uuid "ae01904d-13f0-5d6e-ad3a-cc714c65765b" :question/math-academy-id "e-9500" :question/problem "Consider the vector field $\\mathbf F = \\dfrac{2ay}{1+9x^2} \\, \\mathbf i + \\arctan{3x} \\, \\mathbf j$ on $\\mathbb R^2$, where $a$ is a constant. Given that $\\mathbf F$ is conservative, find the value of $a.$" :question/worked-solution "Let $\\mathbf F(x,y) = P(x,y)\\,\\mathbf i+ Q(x,y)\\,\\mathbf j$ be a vector field with domain $D = \\mathbb R^2,$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$\\mathbf F$ *is conservative if and only if $\\dfrac{\\partial P}{\\partial y} = \\dfrac{\\partial Q}{\\partial x}$ everywhere on $D.$*\n\nFor the vector field $\\mathbf F,$ the domain $D = \\mathbb R^2,$ and we have\n\n$$\nP = \\dfrac{2ay}{1+9x^2}, \\qquad Q = \\arctan{3x}.\n$$\n\n \nComputing the partial derivatives, we get\n\n$$\n\\dfrac{\\partial P}{\\partial y} = \\dfrac{2a}{1 + 9x^2}, \n\\qquad \n\\dfrac{\\partial Q}{\\partial x} = \\dfrac{3}{1 + 9x^2}.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on $\\mathbb R^2.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{2a}{1+9{x}^{2}} & =\\frac{3}{1+9{x}^{2}} \\\\ 2a & =3 \\\\ a & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that $a = \\dfrac{3}{2}.$"} :knowledge-point/id #uuid "d8d73fd7-cdeb-59f1-a84c-aab6defb3aa3" :knowledge-point/questions [{:db/id #edb/ref 17592186167050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ad87b50-24eb-5866-a7a3-616f4089f740" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186163379} {:answer/id #uuid "d2d86d76-1ed0-5562-a0b6-7e81a5bdd6a6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186163380} {:answer/id #uuid "dd8a7e19-8534-5440-a04f-59429a4c1084" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186163381} {:answer/id #uuid "1bcf0893-e2c6-53b9-ac36-110666bdc913" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186163382} {:answer/id #uuid "62273ef4-b30a-5ac7-bfb0-b7ed3c358094" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186163383}] :answer-field/id #uuid "2cd8df0e-a91d-558b-bb05-ba85ed8ba7d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163378} {:answer-field/choices [{:answer/id #uuid "d5cc30dd-c54c-510e-a8ae-905a8e5f5570" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186382711} {:answer/id #uuid "c34ca81d-7ee1-541d-b3dd-2ca1a9a7b794" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186382712} {:answer/id #uuid "ed208e02-eb59-5dac-832b-a002914d41da" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186382713} {:answer/id #uuid "6f96d04c-ea2f-566b-890a-1654a4e46ca2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186382714} {:answer/id #uuid "6b74b360-5da5-5315-8da6-0afc30df25d4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186382715}] :answer-field/correct {:answer/id #uuid "6f96d04c-ea2f-566b-890a-1654a4e46ca2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186382714} :answer-field/id #uuid "09bd8799-4e53-54b3-b672-a9390042cbde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382710}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2658d9bc-59d5-580d-bbeb-6f2b334d98b1" :question/math-academy-id "q-104412" :question/problem "Consider the vector field $F=(x-a){e}^{x+y}\\,i+x{e}^{x+y}\\,j$ on ${R}^{2}$, where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP=(x-a){e}^{x+y},\\,Q=x{e}^{x+y}.\n$$\n\n \nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=(x-a){e}^{x+y},\\,\\frac{∂Q}{∂x}=(x+1){e}^{x+y}.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}(x-a){e}^{x+y} & =(x+1){e}^{x+y} \\\\ (x-a){e}^{x+y}-(x+1){e}^{x+y} & =0 \\\\ (x-a-x-1){e}^{x+y} & =0 \\\\ -(a+1){e}^{x+y} & =0 \\\\ a & =-1.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=-1.$"} {:db/id #edb/ref 17592186167090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bfb852c-7d91-5cab-a4e2-b111d25e0b3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186256899} {:answer/id #uuid "7e881c79-6475-5588-8be9-f6821d563a21" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186257907} {:answer/id #uuid "895f93e5-2793-5091-8d7e-8ac3ac6cb993" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257988} {:answer/id #uuid "d20f891c-8cea-5f52-ae6b-7335a42bce68" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258612} {:answer/id #uuid "ff0483eb-6d10-563a-b7b9-8fbebc7e5b43" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186259022}] :answer-field/correct {:answer/id #uuid "ff0483eb-6d10-563a-b7b9-8fbebc7e5b43" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186259022} :answer-field/id #uuid "41941692-41a8-5fa2-93ae-ce67bff52ff4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259151}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "86789f73-1843-5bdb-8f6f-64ce79172176" :question/math-academy-id "q-123996" :question/problem "Consider the vector field $F=2ay\\,i+(3-x)\\,j$ on ${R}^{2}$, where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP=2ay,\\,Q=3-x.\n$$\n\n \n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=2a,\\,\\frac{∂Q}{∂x}=-1.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}2a & =-1 \\\\ a & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=-\\frac{1}{2}.$"} {:db/id #edb/ref 17592186235528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52ca1b15-c83a-5a5b-99dd-ef8fece2b7ce" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234674}] :answer-field/correct {:answer/id #uuid "52ca1b15-c83a-5a5b-99dd-ef8fece2b7ce" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234674} :answer-field/id #uuid "1eab04f3-72d0-5700-818d-000286df1e51" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235000}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6cc69a41-78c7-5072-a175-2938b84fa694" :question/math-academy-id "q-168600" :question/problem "Given that $F(x,y)$ is conservative, find the value of $a.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $a=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n>$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor our vector field $F,$ the domain is $D={R}^{2},$ and we have \n\n$$\nP=a{y}^{3}-1,\\,Q=3x{y}^{2}+1.\n$$\n\n \n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=3a{y}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}3a{y}^{2} & =3{y}^{2} \\\\ 3a & =3 \\\\ a & =1.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=1.$"} {:db/id #edb/ref 17592186240870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e828d95-ecbc-57d8-b8d9-acf763b088e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186238462} {:answer/id #uuid "3b6e3eea-6dbc-567a-b7c6-ba10a5fed190" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186238572} {:answer/id #uuid "541fb43b-1bee-5827-afeb-bd3595f7ffbb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186238779} {:answer/id #uuid "7802141d-b50b-5e83-be03-15a439e33fe5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186239092} {:answer/id #uuid "a8355852-7497-53ad-930e-a02821cc5439" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186239515}] :answer-field/correct {:answer/id #uuid "7802141d-b50b-5e83-be03-15a439e33fe5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186239092} :answer-field/id #uuid "816ba5d9-4c22-58e9-ba7c-700eb48c8a5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240560}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f05e7a0d-26f2-588a-8d78-a6a57d732300" :question/math-academy-id "q-104410" :question/problem "Consider the vector field $F=(ay-2x{y}^{3})\\,i+(x-3{x}^{2}{y}^{2})\\,j$ on ${R}^{2},$ where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ we have $P=ay-2x{y}^{3}$ and $Q=x-3{x}^{2}{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=a-6x{y}^{2},\\,\\frac{∂Q}{∂x}=1-6x{y}^{2}.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}a-6x{y}^{2} & =1-6x{y}^{2} \\\\ a & =1.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=1.$"} {:db/id #edb/ref 17592186240872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1bc900-62d1-5615-af0f-6dbe4ee35a2e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186238300} {:answer/id #uuid "2899ff60-966e-5c9f-a77b-cd076462b487" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186238412} {:answer/id #uuid "501fc527-192e-54f2-86ab-52b7b2842115" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186238747} {:answer/id #uuid "dac6fd53-9350-56e6-9302-b6846604e6ab" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186239963} {:answer/id #uuid "e1b1e404-5480-5ec1-86f2-cbf9a0ee1d1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186240036}] :answer-field/correct {:answer/id #uuid "2899ff60-966e-5c9f-a77b-cd076462b487" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186238412} :answer-field/id #uuid "f74e5e09-607e-5411-a367-f75da43c0068" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240766}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7bd6d6aa-1b16-5a93-a052-cdf54093004e" :question/math-academy-id "q-104414" :question/problem "Consider the vector field $F=\\frac{axy}{{x}^{2}+1}\\,i+\\operatorname{ln}⁡({x}^{2}+1)\\,j$ on ${R}^{2},$ where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ we have $P=\\frac{axy}{{x}^{2}+1}$ and $Q=\\operatorname{ln}⁡({x}^{2}+1).$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{ax}{{x}^{2}+1},\\,\\frac{∂Q}{∂x}=\\frac{2x}{{x}^{2}+1}.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{ax}{{x}^{2}+1} & =\\frac{2x}{{x}^{2}+1} \\\\ ax & =2x \\\\ a & =2.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=2.$"} {:db/id #edb/ref 17592186259581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57190c25-01e9-52f1-a602-8b6b3c0b0030" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257533} {:answer/id #uuid "7dfeddeb-7431-5e49-a9dd-7f38f3f510f7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186257898} {:answer/id #uuid "83f96867-7578-5dde-bcc0-b2a067859fd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257951} {:answer/id #uuid "e808abd0-4e4a-50c9-b1de-e375e94dc248" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258794} {:answer/id #uuid "ef0ebf91-bb0c-5cda-9ad5-c786f1c45f30" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258855}] :answer-field/correct {:answer/id #uuid "ef0ebf91-bb0c-5cda-9ad5-c786f1c45f30" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258855} :answer-field/id #uuid "df48032b-0934-5e84-9809-b7bc5cdb5be7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259425}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b7768381-49c0-5755-a526-0e09cbb087b9" :question/math-academy-id "q-123993" :question/problem "Consider the vector field $F=({y}^{3}-ay)\\,i+(3x{y}^{2}-2x)\\,j$ on ${R}^{2}$, where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP={y}^{3}-ay,\\,Q=3x{y}^{2}-2x.\n$$\n\n \n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=3{y}^{2}-a,\\,\\frac{∂Q}{∂x}=3{y}^{2}-2.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}3{y}^{2}-a & =3{y}^{2}-2 \\\\ -a & =-2 \\\\ a & =2.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=2.$"} {:db/id #edb/ref 17592186259582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14db70f5-df8f-5f08-a150-3a466567a842" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186256971} {:answer/id #uuid "2fb1fb64-ec36-5925-bee7-1a5e8272a7ea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257201} {:answer/id #uuid "61f28b33-098c-5f5d-9ab0-c30766af1628" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257644} {:answer/id #uuid "7533dde9-b1e2-58c9-81d7-b484f86dcbda" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257810} {:answer/id #uuid "9813db15-8d6c-5d3c-b904-d7c6bd10d9bb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258123}] :answer-field/correct {:answer/id #uuid "9813db15-8d6c-5d3c-b904-d7c6bd10d9bb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258123} :answer-field/id #uuid "272f8a51-e7d1-5e59-aadf-b74351e207b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259099}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ca502a8a-0b55-5b4d-8a4b-58f7420e37da" :question/math-academy-id "q-123998" :question/problem "Consider the vector field $F=({y}^{2}+2xy)\\,i+({x}^{2}+2axy)\\,j$ on ${R}^{2}$, where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP={y}^{2}+2xy,\\,Q={x}^{2}+2axy.\n$$\n\n \n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=2y+2x,\\,\\frac{∂Q}{∂x}=2x+2ay.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}2y+2x & =2x+2ay \\\\ 2y & =2ay \\\\ 2y-2ay & =0 \\\\ 2y(1-a) & =0 \\\\ 1-a & =0 \\\\ a & =1.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=1.$"} {:db/id #edb/ref 17592186259583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f02a01-13bc-56b7-b177-ccb430449d52" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186256871} {:answer/id #uuid "27841610-a8b4-5bab-82b2-27e5466d5850" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257130} {:answer/id #uuid "470598a5-e320-5126-88c8-0994c3641e58" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257403} {:answer/id #uuid "b2aadeb0-045b-5aca-85eb-0efc92490277" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186258337} {:answer/id #uuid "c1adda1d-9da5-5d62-bd41-e44c2f642fac" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186258476}] :answer-field/correct {:answer/id #uuid "09f02a01-13bc-56b7-b177-ccb430449d52" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186256871} :answer-field/id #uuid "def33358-ee55-5273-82f4-3c6232c5e848" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259424}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "652885e3-f092-5423-886c-a33306bd20ca" :question/math-academy-id "q-124000" :question/problem "Consider the vector field $F=(ax{y}^{2}+1)\\,i+(4{x}^{2}y+1)\\,j$ on ${R}^{2}$, where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP=ax{y}^{2}+1,\\,Q=4{x}^{2}y+1.\n$$\n\n \n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=2axy,\\,\\frac{∂Q}{∂x}=8xy.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}2axy & =8xy \\\\ 2axy-8xy & =0 \\\\ 2(a-4)xy & =0 \\\\ a-4 & =0 \\\\ a & =4.\\end{aligned}\n$$\n\nSince the last equality must be satisfied everywhere on $D,$ we conclude that $a-4=0,$ that is, $a=4.$"} {:db/id #edb/ref 17592186362333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4568d555-f227-5e34-a46e-e128971708e2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186361137} {:answer/id #uuid "62339377-95b5-5286-afc6-4c2f3145b84b" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186361276} {:answer/id #uuid "79919e77-489f-5457-a3b0-ecf7191bb0b2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186361372} {:answer/id #uuid "bb81ef3b-a990-5f38-bd1a-392f516c4a11" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186361674} {:answer/id #uuid "e92122ee-410e-5b80-a54b-ad31ed1ba6c4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361876}] :answer-field/correct {:answer/id #uuid "4568d555-f227-5e34-a46e-e128971708e2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186361137} :answer-field/id #uuid "0d7cb4af-cadc-59d2-b331-ed625ffc95bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361990}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4992c928-66f9-55e4-9096-4efa99debc55" :question/math-academy-id "q-98946" :question/problem "Consider the vector field $F=(3{x}^{2}+\\operatorname{cos}⁡\\pi y)\\,i+(ax-\\pi x\\operatorname{sin}⁡\\pi y)\\,j$ on ${R}^{2},$ where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP=3{x}^{2}+\\operatorname{cos}⁡\\pi y,\\,Q=ax-\\pi x\\operatorname{sin}⁡\\pi y.\n$$\n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-\\pi \\operatorname{sin}⁡\\pi y,\\,\\frac{∂Q}{∂x}=a-\\pi \\operatorname{sin}⁡\\pi y.\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}-\\pi \\operatorname{sin}⁡\\pi y & =a-\\pi \\operatorname{sin}⁡\\pi y \\\\ a & =0.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=0.$"} {:db/id #edb/ref 17592186383055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd9d3890-e5fa-57a3-9137-eeba2c84a593" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186383057} {:answer/id #uuid "d2e62bfe-1108-53de-82a5-a03533c4f994" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186383058} {:answer/id #uuid "d05e703d-f6df-5364-a2c7-03adc5fdd414" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186383059} {:answer/id #uuid "31c18c30-748a-5d6c-9a1a-4722fa3a251d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186383060} {:answer/id #uuid "70ad12cb-bd4a-5ceb-a9c2-f1f68db1330e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186383061}] :answer-field/correct {:answer/id #uuid "31c18c30-748a-5d6c-9a1a-4722fa3a251d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186383060} :answer-field/id #uuid "3bcb7611-75f0-57b9-8afb-f4a5ccb4b065" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383056}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f2d723a2-0f08-5c17-a7db-01dafeefa476" :question/math-academy-id "q-123999" :question/problem "Consider the vector field $F=a\\operatorname{sin}⁡(3x-y)\\,i+(\\operatorname{sin}⁡(3x-y)+1)\\,j$ on ${R}^{2}$, where $a$ is a constant. Given that $F$ is conservative, find the value of $a.$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nFor the vector field $F,$ the domain $D={R}^{2},$ and we have \n\n$$\nP=a\\operatorname{sin}⁡(3x-y),\\,Q=\\operatorname{sin}⁡(3x-y)+1.\n$$\n\n \n\nComputing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=-a\\operatorname{cos}⁡(3x-y),\\,\\frac{∂Q}{∂x}=3\\operatorname{cos}⁡(3x-y).\n$$\n\nIt's clear that the partial derivatives exist and are continuous on ${R}^{2}.$ Equating the partial derivatives, we get\n\n$$\n\\begin{aligned}-a\\operatorname{cos}⁡(3x-y) & =3\\operatorname{cos}⁡(3x-y) \\\\ 3\\operatorname{cos}⁡(3x-y)+a\\operatorname{cos}⁡(3x-y) & =0 \\\\ (3+a)\\operatorname{cos}⁡(3x-y) & =0 \\\\ 3+a & =0 \\\\ a & =-3.\\end{aligned}\n$$\n\nTherefore, we conclude that $a=-3.$"}] :knowledge-point/title "Finding a Parameter in a Given Conservative Vector Field"}] [{:db/id #edb/ref 17592186166865 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166718 :question/id #uuid "03bebdcd-5908-5c60-b35a-1c8f59593afd" :question/math-academy-id "e-9577" :question/problem "![](images/0f/0f4f0de23892a6f76642f8c7e5d3a6112a8ffa2d9f50000cd974f293a7d8b3b6.png)\n\nFind $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(0,-1)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-0)^2 + (y - (-1))^2 = 2^2 \\qquad\\Longrightarrow\\qquad\nx^2 + (y+1)^2 = 4.\n$$\n\nNow, to calculate $\\dfrac{\\textrm d y}{\\textrm d x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+(y+1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}((y+1)^{2}) & =0 \\\\ 2x+2(y+1)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+1)\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y+1}\\end{aligned}\n$$"} :knowledge-point/id #uuid "1331279e-1a5f-5f6f-9104-0c88e1f9f6d0" :knowledge-point/questions [{:db/id #edb/ref 17592186167091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d76abaf-d6f3-5b89-8bc8-773822409c75" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x^{2}}{y^{2}}" :db/id #edb/ref 17592186163625} {:answer/id #uuid "af7463aa-12d7-57ad-803b-3c850c3fe265" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y}{x}" :db/id #edb/ref 17592186163626} {:answer/id #uuid "ca72da31-eeea-56d4-973b-8125561d7056" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186163627} {:answer/id #uuid "ee2d3c03-496e-55bf-a039-5ecbd04ee38f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}" :db/id #edb/ref 17592186163628} {:answer/id #uuid "06dcb89b-43af-580e-a84a-316afd26beda" :answer/type {:db/ident :answer.type/math} :answer/value "yx^{2}" :db/id #edb/ref 17592186163629}] :answer-field/id #uuid "fff66644-0b05-5c26-a65d-0ffc27452391" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163624}] :question/id #uuid "3d859e7f-f28f-5c06-af6e-a805a7402be0" :question/math-academy-id "q-127359" :question/problem "![](images/ef/efaa81ed608cd130b1f9a6000dd50c27f8d81ed7cbd6c10570c04df1281c149d.png)\n\nFind $\\frac{dy}{dx}$ for the circle shown above."} {:db/id #edb/ref 17592186167092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdffde0b-6618-51d6-bc49-a22477f723f8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y - 1}{x + 1}" :db/id #edb/ref 17592186163631} {:answer/id #uuid "d1dfdf67-527b-511d-abee-249d1eb9a880" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x + 1}{y - 1}" :db/id #edb/ref 17592186163632} {:answer/id #uuid "27c4a1e8-5acb-5b6f-8de6-b2f50aeb90c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y - 1}{x + 1}" :db/id #edb/ref 17592186163633} {:answer/id #uuid "38683bd4-b061-5d5a-a1c0-60944a2fa2e9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x - 1}{y + 1}" :db/id #edb/ref 17592186163634} {:answer/id #uuid "38ae922f-61ca-5b33-bdae-7d7e14ba332a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x + 1}{y + 1}" :db/id #edb/ref 17592186163635}] :answer-field/id #uuid "02b4c5ff-6289-5b8b-bb00-03fbd4292b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163630}] :question/id #uuid "ef223789-79d4-59f3-b94f-8f0a66169b59" :question/math-academy-id "q-127360" :question/problem "![](images/a0/a09aa5c81ec7775f390901569afb0468204c49752eb401845e6836317616f25d.png)\n\nFind $\\frac{dy}{dx}$ for the circle shown above."} {:db/id #edb/ref 17592186262777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2675139a-3fa5-5b56-94e2-c392744f2058" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{y}" :db/id #edb/ref 17592186260211} {:answer/id #uuid "53dc176a-f425-5b28-938a-cb3b8dfbea9a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4x}{y}" :db/id #edb/ref 17592186260581} {:answer/id #uuid "705192e6-bac2-5c6b-acc2-b4a6d7c27a4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{x}" :db/id #edb/ref 17592186260862} {:answer/id #uuid "e9942a87-c77c-5a9d-a10f-bfd1dc59e1f5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186261919} {:answer/id #uuid "ee2aee2c-79cc-5487-8a09-2deff11502b7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186261972}] :answer-field/correct {:answer/id #uuid "e9942a87-c77c-5a9d-a10f-bfd1dc59e1f5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y}" :db/id #edb/ref 17592186261919} :answer-field/id #uuid "486a8e80-f3f5-5ea0-86c4-8514e424260b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fdc8e2a5-3885-5dd5-9725-cf793a052578" :question/math-academy-id "q-127493" :question/problem "![](images/f2/f24d078ca0dc57ebd12778b7862683b0289e9c0d4c664639bd210dcc1f7c6d1b.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at the origin and has a radius of $4,$ its equation is given by\n\n$$\n{x}^{2}+{y}^{2}={4}^{2}\\,⟹\\,{x}^{2}+{y}^{2}=16.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(16) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1baa187c-702f-5d74-9e49-a1dc869d9fa4" :answer/type {:db/ident :answer.type/math} :answer/value "(1-x)y" :db/id #edb/ref 17592186260112} {:answer/id #uuid "5a6d8273-ae12-56d9-9e8e-fcc50fc83290" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+1}{y}" :db/id #edb/ref 17592186260645} {:answer/id #uuid "74a22088-ee78-5010-84ba-740de0945199" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-x}{y}" :db/id #edb/ref 17592186260896} {:answer/id #uuid "ae28886d-9cbf-5b7c-9d76-cf9e7ca1aa9c" :answer/type {:db/ident :answer.type/math} :answer/value "-(x+1)y" :db/id #edb/ref 17592186261410} {:answer/id #uuid "e6444082-8e18-513f-a526-e008b7c933af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{y}" :db/id #edb/ref 17592186261896}] :answer-field/correct {:answer/id #uuid "74a22088-ee78-5010-84ba-740de0945199" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-x}{y}" :db/id #edb/ref 17592186260896} :answer-field/id #uuid "71d6fbea-23c2-5931-a1d8-e65fc956b604" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262313}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "270ef110-70fe-5fce-83a6-6d6bf6a5f7cf" :question/math-academy-id "q-127497" :question/problem "![](images/a3/a3ca092dc7c0668ac465d4832b91a2b831af057ff22e357b4e7105bfb454ea18.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(1,0)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-1)^{2}+(y-0)^{2}={2}^{2}\\,⟹\\,(x-1)^{2}+{y}^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x-1)^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x-1)^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2(x-1)+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2(x-1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1-x}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "086f2ce1-1368-53f8-ba86-97532f17e2be" :answer/type {:db/ident :answer.type/math} :answer/value "2(x+1)(y+1)" :db/id #edb/ref 17592186259953} {:answer/id #uuid "15624327-92e2-5e45-93c8-9e8b0f12c8a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-x}{y+1}" :db/id #edb/ref 17592186260061} {:answer/id #uuid "1b0ad15c-3fd9-513f-9213-0034cf18a310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{1-y}" :db/id #edb/ref 17592186260109} {:answer/id #uuid "262a7584-90ba-501c-94ba-193aab3a5f57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(x+1)}{y-1}" :db/id #edb/ref 17592186260210} {:answer/id #uuid "56f957aa-f127-5fa0-8b32-8a16dec1aaac" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)(1-y)" :db/id #edb/ref 17592186260618}] :answer-field/correct {:answer/id #uuid "1b0ad15c-3fd9-513f-9213-0034cf18a310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+1}{1-y}" :db/id #edb/ref 17592186260109} :answer-field/id #uuid "d01c7489-9aff-5d6d-85e8-5b918e133134" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262489}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d49ad33a-9c4d-534a-b2d2-deca2d37a9d8" :question/math-academy-id "q-127499" :question/problem "![](images/2f/2f08e0a0d1fd855f2d179ac65dbdf5d022f3488b85c78b5cbb507f12bd69487e.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(-1,1)$ and has a radius of $1,$ its equation is given by\n\n$$\n(x-(-1))^{2}+(y-1)^{2}={1}^{2}\\,⟹\\,(x+1)^{2}+(y-1)^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+1)^{2}+(y-1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+1)^{2})+\\frac{\\text{d}}{\\text{d}x}((y-1)^{2}) & =0 \\\\ 2(x+1)+2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =-2(x+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{y-1} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+1}{1-y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262780 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbff705-86d7-5620-9b91-f217fc3dd62f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{x+3}" :db/id #edb/ref 17592186259995} {:answer/id #uuid "1404812d-8afd-556d-a934-1872662ba5ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+3}{y+2}" :db/id #edb/ref 17592186260050} {:answer/id #uuid "2cae2188-2835-52aa-8873-60409aaec2d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(x-3)}{y-2}" :db/id #edb/ref 17592186260276} {:answer/id #uuid "7b7c9e2c-eda0-5eef-8879-0d607c2ec01a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y+2}{x-3}" :db/id #edb/ref 17592186260952} {:answer/id #uuid "86c7e6c8-e96b-5be4-8744-21b6d321d35e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(y+2)}{x+3}" :db/id #edb/ref 17592186261050}] :answer-field/correct {:answer/id #uuid "1404812d-8afd-556d-a934-1872662ba5ea" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+3}{y+2}" :db/id #edb/ref 17592186260050} :answer-field/id #uuid "88ab4b98-7df7-574e-9078-9c3fc81e2000" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262363}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8fba4c03-ae99-5394-bb2d-645b07038e02" :question/math-academy-id "q-127500" :question/problem "![](images/78/78ad1a6835bb71441f77a3ca2bbdc93a42635e0386cda35fbe5fc9b0c9f48677.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(-3,-2)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-(-3))^{2}+(y-(-2))^{2}={2}^{2}\\,⟹\\,(x+3)^{2}+(y+2)^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+3)^{2}+(y+2)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+3)^{2})+\\frac{\\text{d}}{\\text{d}x}((y+2)^{2}) & =0 \\\\ 2(x+3)+2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =-2(x+3) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+3}{y+2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12fcdc1d-9e23-5008-bf5d-34dc22fc186c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{x+2}" :db/id #edb/ref 17592186260042} {:answer/id #uuid "22b7ceba-bd0d-5cf4-99c5-b69358079cd6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y+2}{x}" :db/id #edb/ref 17592186260179} {:answer/id #uuid "41bc10c8-5d61-5860-b083-a238754518aa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x+2}{3y}" :db/id #edb/ref 17592186260450} {:answer/id #uuid "79ec63bb-645a-50e8-b0a6-bd5548a8649a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y+2}" :db/id #edb/ref 17592186260940} {:answer/id #uuid "97f828a2-e540-5264-bff8-1e86698e24a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{y+2}" :db/id #edb/ref 17592186261194}] :answer-field/correct {:answer/id #uuid "79ec63bb-645a-50e8-b0a6-bd5548a8649a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{y+2}" :db/id #edb/ref 17592186260940} :answer-field/id #uuid "8a9b4da9-c684-5fbe-a09a-8174d70bd535" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262368}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "49f66e90-d770-50de-8b81-b5c4a9d9e022" :question/math-academy-id "q-127502" :question/problem "![](images/81/812f88e913650b7924fc13acc7adde999819d0011fa547a7e0ad73cb37e3939f.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." :question/worked-solution "Since our circle is centered at $(0,-2)$ and has a radius of $3,$ its equation is given by\n\n$$\n(x-0)^{2}+(y-(-2))^{2}={3}^{2}\\,⟹\\,{x}^{2}+(y+2)^{2}=9.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+(y+2)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}((y+2)^{2}) & =0 \\\\ 2x+2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y+2}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Slope of the Tangent to a Circle"}]}
