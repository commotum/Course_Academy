35e8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =4$" :db/id #edb/ref 17592186344322} :answer-field/id #uuid "1a3fc608-70a9-52f3-b660-88c24389d51a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344538}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "98730953-beae-5f36-b02e-39e84ea26f4a" :question/math-academy-id "q-77515" :question/problem "![](images/c8/c800644be3cc0ad0688d52948a4a2cb813cbe14b1fe899abe5a1d92613a687bf.png)\n\nConsider the picture above. Given that $r=\\lambda p+\\mu q$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/90/90272fad8af526de6e169faba8daae29210c1f502c4959d0e1829e5ad65476f0.png)\n\nIn $△OPR$ shown above, we have \n\n- $OP=2|p|$\n\n- $\\overset{\\to }{OP}$ and $p$ have the same direction\n\nHence, $\\overset{\\to }{OP}=2p.$\n\nSimilarly:\n\n- $PR=4|q|$\n\n- $\\overset{\\to }{PR}$ and $q$ have the same direction\n\nHence, $\\overset{\\to }{PR}=4q.$\n\nAdditionally, \n\n$$\n\\begin{aligned}r & =\\overset{\\to }{OP}+\\overset{\\to }{PR} \\\\  & =2p+4q.\\end{aligned}\n$$\n\nConsequently, $r=\\lambda p+\\mu q=2p+4q.$\n\nSince $p∦q,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =2$ and $\\mu =4$"} {:db/id #edb/ref 17592186365574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c28aff5d-53e7-5f16-983d-538f4ce98117" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186365576}] :answer-field/correct {:answer/id #uuid "c28aff5d-53e7-5f16-983d-538f4ce98117" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186365576} :answer-field/id #uuid "7cfd16dc-f42e-5638-89f3-68f27f774336" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365575} {:answer-field/choices [{:answer/id #uuid "81e0b22a-548d-5d2e-b32f-16412fc6cadf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186365578}] :answer-field/correct {:answer/id #uuid "81e0b22a-548d-5d2e-b32f-16412fc6cadf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186365578} :answer-field/id #uuid "71b77659-ec75-56f7-ab9f-4c3596d182b4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365577}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "681d8619-9082-56b4-9422-241cad7644a3" :question/math-academy-id "q-326016" :question/problem "![](images/0f/0f9ee37fe5f1cf32ba470b24e5d27b4164bd00a0caeae0536ae48d4cc5836c6d.png)\n\nConsider the picture above. If $t=\\lambda a+\\mu b$, then$\\,\\lambda =$\n{{field-1}}\nand \n$\\mu =$\n{{field-2}}." :question/worked-solution "![](images/c9/c95e718a0c30e2be1f3678123eea0006b17fd781305c06a4f277488c2389337f.png)\n\nIn $△OXT$ shown above, we have:\n\n- $OX=\\frac{7}{4}\\cdot |a|$\n\n- $\\overset{\\to }{OX}$ has the opposite direction to $a$\n\nHence, $\\overset{\\to }{OX}=-\\frac{7}{4}a.$\n\nSimilarly:\n\n- $XT=2|b|$\n\n- $\\overset{\\to }{XT}$ has the opposite direction to $b$\n\nHence, $\\overset{\\to }{XT}=-2b.$\n\nAdditionally,\n\n$$\nt=\\overset{\\to }{OX}+\\overset{\\to }{XT}=-\\frac{7}{4}a-2b.\n$$\n\nConsequently, $t=\\lambda a+\\mu b=-\\frac{7}{4}a-2b.$\n\nSince $b∦a,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-\\frac{7}{4}$ and $\\mu =-2$"} {:db/id #edb/ref 17592186403878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a9d3aac-2ddf-558e-9987-0dee3c2852ff" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2.5$ and $\\mu =-3$" :db/id #edb/ref 17592186403880} {:answer/id #uuid "d0c5e6ea-81c8-564a-84fa-99f998a1a61d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =3$" :db/id #edb/ref 17592186403881} {:answer/id #uuid "ed44e8da-0848-535d-a8ae-87bdbaa1daf7" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =-3$" :db/id #edb/ref 17592186403882} {:answer/id #uuid "8353c3d6-6092-5f38-bfd8-8a8168b1859c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =2.5$" :db/id #edb/ref 17592186403883} {:answer/id #uuid "aa67f058-afcd-51ee-97d4-c377ce896d7a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2.5$ and $\\mu =3$" :db/id #edb/ref 17592186403884}] :answer-field/correct {:answer/id #uuid "d0c5e6ea-81c8-564a-84fa-99f998a1a61d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =3$" :db/id #edb/ref 17592186403881} :answer-field/id #uuid "6554496f-6084-5a58-8758-7a159d646048" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403879}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b8cb8830-d33b-5725-abf1-a6d3f309ef27" :question/math-academy-id "q-77452" :question/problem "![](images/16/1649e6c4ef2874cda2a7d7428b54220ef2a1790ba4b197c755165c48add0c31e.png)\n\nConsider the picture above. Given that $c=\\lambda a+\\mu b$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/7c/7cf17440c27765efb34b6a01c12a76ad4e980fc540307e2218227153661db5dd.png)\n\nIn $△OAC$ shown above, we have:\n\n- $OA=2.5|a|$\n\n- $\\overset{\\to }{OA}$ and $a$ have the same direction\n\nHence, $\\overset{\\to }{OA}=2.5a.$\n\nSimilarly:\n\n- $AC=3|b|$\n\n- $\\overset{\\to }{AC}$ and $b$ have the same direction\n\nHence, $\\overset{\\to }{AC}=3b.$\n\nAdditionally, \n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OA}+\\overset{\\to }{AC} \\\\  & =2.5a+3b.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+\\mu b=2.5a+3b.$ \n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n$\\,$ $\\lambda =2.5$ and $\\mu =3$"} {:db/id #edb/ref 17592186420467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f1fbbe3-94d8-5bd3-8727-4e6f9a832097" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =2$" :db/id #edb/ref 17592186420448} {:answer/id #uuid "90599886-7bfb-5b72-84ac-b60df87c5d99" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =2$" :db/id #edb/ref 17592186420452} {:answer/id #uuid "a6826047-3513-5e97-9ed8-1ae795633fc4" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =2$" :db/id #edb/ref 17592186420453} {:answer/id #uuid "b05969db-3a13-5b96-96be-8b739e33d310" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =3$" :db/id #edb/ref 17592186420455} {:answer/id #uuid "cf620219-7b28-5e23-a450-b4abd046ba47" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-3$" :db/id #edb/ref 17592186420457}] :answer-field/correct {:answer/id #uuid "a6826047-3513-5e97-9ed8-1ae795633fc4" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =2$" :db/id #edb/ref 17592186420453} :answer-field/id #uuid "979e9c27-4560-5e47-8337-19ce5dc8192c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420463}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d5f98ecb-0f26-50ae-9a82-cc334fd82c55" :question/math-academy-id "q-20413" :question/problem "![](images/4b/4bb7598c9ebae28be572508974cd025caa8f4a6c3313f025ff0f5ca55296334e.png)\n\nConsider the picture above. Given that $h=\\lambda f+\\mu g$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/43/43642acdb991827b4e1e16744e8a69507a383a1319ae07efde78480af4bab166.png)\n\nIn $△OFH$ shown above, we have \n\n- $OF=2|g|$\n\n- $\\overset{\\to }{OF}$ and $g$ have the same direction\n\nHence, $\\overset{\\to }{OF}=2g.$\n\nSimilarly:\n\n- $FH=3|f|$\n\n- $\\overset{\\to }{FH}$ has the opposite direction to $f$\n\nHence, $\\overset{\\to }{FH}=-3f.$\n\nAdditionally, \n\n$$\n\\begin{aligned}h & =\\overset{\\to }{OF}+\\overset{\\to }{FH} \\\\  & =2g-3f \\\\  & =-3f+2g.\\end{aligned}\n$$\n\nConsequently, $h=\\lambda f+\\mu g=-3f+2g.$\n\nSince $f∦g,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-3$ and $\\mu =2$"}] :knowledge-point/title "Finding Two Scalar Factors in a Linear Combination"}] [{:db/id #edb/ref 17592186096653 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096452 :question/id #uuid "09d593cc-526e-5691-9a18-efff515eae59" :question/math-academy-id "e-4288" :question/problem "Consider the following diagram, where $\\overrightarrow{OA}=\\mathbf{a},$ $\\overrightarrow{OB}=\\mathbf{b},$ and $X$ divides $AB$ in the ratio $3:1.$ Find $\\overrightarrow{OX}.$\n\n![](images/67/678ea2936b8a5b1ded74cb8a0875c629e8be0f7002c98492ebf2e8109fc603ef.png)" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overrightarrow{OX} = \\overrightarrow{OA}+\\overrightarrow{AX}.\n$$\n\nWe're told that $\\overrightarrow{OA} = \\mathbf{a},$ so we just need to work out $\\overrightarrow{AX}.$\n\nFirst, from $\\triangle OAB,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AX:XB=3:1,$ we have\n\n$$\n\\overrightarrow{AX}=\\dfrac{3}{4}\\overrightarrow{AB}=\\dfrac{3}{4}(\\mathbf{b}-\\mathbf{a}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OX} & =\\overset{\\to }{OA}+\\overset{\\to }{AX} \\\\  & =a+\\frac{3}{4}(b-a) \\\\  & =\\frac{1}{4}a+\\frac{3}{4}b.\\end{aligned}\n$$"} :knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/questions [{:db/id #edb/ref 17592186097046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95092ddd-a592-51a9-a935-ee8d21d09f58" :answer/type {:db/ident :answer.type/math} :answer/value "OT^(→) = a + \\frac{1}{2}b" :db/id #edb/ref 17592186094250} {:answer/id #uuid "c8ea1899-3edc-5a44-a68d-8e0dc35e8f3e" :answer/type {:db/ident :answer.type/math} :answer/value "OT^(→) = \\frac{2}{3}a + \\frac{1}{3}b" :db/id #edb/ref 17592186094251} {:answer/id #uuid "0f332864-f317-5e8c-afc1-79039bba7d4b" :answer/type {:db/ident :answer.type/math} :answer/value "OT^(→) = \\frac{1}{3}a + \\frac{2}{3}b" :db/id #edb/ref 17592186094252} {:answer/id #uuid "149f3ec8-5bfe-5cff-b544-5450e508dd7d" :answer/type {:db/ident :answer.type/math} :answer/value "OT^(→) = \\frac{1}{2}a + b" :db/id #edb/ref 17592186094253} {:answer/id #uuid "28977d08-9521-501a-8c2b-abbc30e9104f" :answer/type {:db/ident :answer.type/math} :answer/value "OT^(→) = \\frac{1}{2}a + \\frac{1}{2}b" :db/id #edb/ref 17592186094254}] :answer-field/id #uuid "7ba0bf42-9d3f-5ea8-846a-8da902ababbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094249} {:answer-field/choices [{:answer/id #uuid "4bff8291-52e2-5378-8c8d-7d44f23a4c69" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{1}{2}a+b" :db/id #edb/ref 17592186364895} {:answer/id #uuid "34011083-f78c-5655-a0da-dc9cb40aca66" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{1}{2}a+\\frac{1}{2}b" :db/id #edb/ref 17592186364896} {:answer/id #uuid "485389db-c4a8-5142-9541-d78c1ba0024d" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{2}{3}a+\\frac{1}{3}b" :db/id #edb/ref 17592186364897} {:answer/id #uuid "3a64dc1f-5834-51d0-838e-b496cd2b0fdd" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{1}{3}a+\\frac{2}{3}b" :db/id #edb/ref 17592186364898} {:answer/id #uuid "15eb2c14-0598-5915-a3c6-298fc96e1bc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=a+\\frac{1}{2}b" :db/id #edb/ref 17592186364899}] :answer-field/correct {:answer/id #uuid "34011083-f78c-5655-a0da-dc9cb40aca66" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{1}{2}a+\\frac{1}{2}b" :db/id #edb/ref 17592186364896} :answer-field/id #uuid "2ab7ddb7-0e0f-504f-b6a0-52fbf88f18aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364894}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a844b5df-969a-5ad4-9ad2-fd01250ec5ee" :question/math-academy-id "q-12212" :question/problem "![](images/c2/c2406e6f3cb76f50bfcc73a348b38d93b7a24da8e4314e0b3523bb4cbf143364.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=a,$ $\\overset{\\to }{OB}=b$, and $T$ divides $\\overset{―}{AB}$ in the ratio $AT:TB=1:1.$ Find $\\overset{\\to }{OT}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OT}=\\overset{\\to }{OA}+\\overset{\\to }{AT}.\n$$\n\nWe're told that $\\overset{\\to }{OA}=a,$ so we just need to work out $\\overset{\\to }{AT}.$\n\nFirst, from $△OAB,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AT:TB=1:1,$ we have\n\n$$\n\\overset{\\to }{AT}=\\frac{1}{2}\\overset{\\to }{AB}=\\frac{1}{2}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =a+\\frac{1}{2}(b-a) \\\\  & =\\frac{1}{2}a+\\frac{1}{2}b.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b42e7ab-ac63-5783-9fe9-b799c27fa880" :answer/type {:db/ident :answer.type/math} :answer/value "OR^(→) = \\frac{3}{4}p + \\frac{1}{4}q" :db/id #edb/ref 17592186095365} {:answer/id #uuid "92f11bab-00ea-5806-85db-1bdf7b4a1d64" :answer/type {:db/ident :answer.type/math} :answer/value "OR^(→) = \\frac{2}{3}p + \\frac{1}{3}q" :db/id #edb/ref 17592186095366} {:answer/id #uuid "ae89d302-f0f7-5e09-9194-c33771847064" :answer/type {:db/ident :answer.type/math} :answer/value "OR^(→) = \\frac{1}{2}p + \\frac{1}{2}q" :db/id #edb/ref 17592186095367} {:answer/id #uuid "db7890bf-209c-5d9f-a75a-7bb34f398293" :answer/type {:db/ident :answer.type/math} :answer/value "OR^(→) = \\frac{1}{3}p + \\frac{2}{3}q" :db/id #edb/ref 17592186095368} {:answer/id #uuid "5bb7d370-156f-57c3-abfb-39c1d909ef46" :answer/type {:db/ident :answer.type/math} :answer/value "OR^(→) = \\frac{1}{4}p + \\frac{3}{4}q" :db/id #edb/ref 17592186095369}] :answer-field/id #uuid "b1d5a5be-01e8-5ebd-96ba-2cafaf557859" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095364}] :question/id #uuid "27eb1507-c2b5-51fc-be8d-7ac00e5bfd55" :question/math-academy-id "q-42659" :question/problem "![](images/fb/fb31653c9fc5031372c4b08e8fba0ec809c7e58a7a2321a8a7eb027b8eacd48a.png)\n\nConsider the diagram above, where $OP^(→) = p$, $OQ^(→) = q$ and $R$ divides $PQ^(―)$ in the ratio $PR: RQ = 1: 2$. Find $OR^(→)$."} {:db/id #edb/ref 17592186256381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3914dd-4f9d-52fd-84b0-addb499fcb53" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{10}h+\\frac{7}{10}i" :db/id #edb/ref 17592186253914} {:answer/id #uuid "491d5c09-aff2-5cb7-a5b0-ce88b63b18de" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{5}h+\\frac{2}{5}i" :db/id #edb/ref 17592186254299} {:answer/id #uuid "8c5ace5d-136b-52aa-8a79-7ef14da799ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{2}h+\\frac{1}{2}i" :db/id #edb/ref 17592186254913} {:answer/id #uuid "d1a748c5-34db-5f1a-955a-3db960e37efa" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{7}{10}h+\\frac{3}{10}i" :db/id #edb/ref 17592186255540} {:answer/id #uuid "dcc15687-ab0f-5cda-9954-dc238979cbe6" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{2}{5}h+\\frac{3}{5}i" :db/id #edb/ref 17592186255627}] :answer-field/correct {:answer/id #uuid "d1a748c5-34db-5f1a-955a-3db960e37efa" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{7}{10}h+\\frac{3}{10}i" :db/id #edb/ref 17592186255540} :answer-field/id #uuid "ae15c7d1-59b0-5d81-bcf1-1e0483cf8ab7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256236}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eee74ea9-5018-5a1b-8460-e61ca7767d79" :question/math-academy-id "q-120285" :question/problem "![](images/c4/c4d26b3db6446f586ca47634d9f9a3a004968a0081b8859ce46b4b4af799d066.png)\n\nConsider the diagram above, where $\\overset{\\to }{OH}=h,$ $\\overset{\\to }{OI}=i$ and $J$ divides $\\overset{―}{HI}$ in the ratio $HJ:JI=3:7.$ Find $\\overset{\\to }{OJ}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OJ}=\\overset{\\to }{OH}+\\overset{\\to }{HJ}.\n$$\n\nWe're told that $\\overset{\\to }{OH}=h,$ so we just need to work out $\\overset{\\to }{HJ}.$\n\nFirst, from $△OHI,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HI} & =\\overset{\\to }{HO}+\\overset{\\to }{OI} \\\\  & =-\\overset{\\to }{OH}+\\overset{\\to }{OI} \\\\  & =-h+i \\\\  & =i-h.\\end{aligned}\n$$\n\nSince $HJ:JI=3:7,$ we have\n\n$$\n\\overset{\\to }{HJ}=\\frac{3}{10}\\overset{\\to }{HI}=\\frac{3}{10}(i-h).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OJ} & =\\overset{\\to }{OH}+\\overset{\\to }{HJ} \\\\  & =h+\\frac{3}{10}(i-h) \\\\  & =\\frac{7}{10}h+\\frac{3}{10}i.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08042bf4-3ef1-5d30-b0f3-3f433bba0296" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{9}u+\\frac{7}{9}v" :db/id #edb/ref 17592186253727} {:answer/id #uuid "0df1ebc5-6217-5105-bde2-c6c8741a810e" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{1}{3}u+\\frac{2}{3}v" :db/id #edb/ref 17592186253788} {:answer/id #uuid "80614574-97e2-5043-b396-2114fd647949" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186254805} {:answer/id #uuid "bba72999-a4aa-5c77-bf97-584951bba851" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{5}{7}u+\\frac{2}{7}v" :db/id #edb/ref 17592186255344} {:answer/id #uuid "ded7e171-58ae-5dc1-8f0a-f9fdf6931af4" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{3}u+\\frac{1}{3}v" :db/id #edb/ref 17592186255647}] :answer-field/correct {:answer/id #uuid "08042bf4-3ef1-5d30-b0f3-3f433bba0296" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{9}u+\\frac{7}{9}v" :db/id #edb/ref 17592186253727} :answer-field/id #uuid "38859fb6-3c7d-5b36-af09-e8454c183c16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256022}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e34b700c-a9ab-5795-931b-c570187a69f9" :question/math-academy-id "q-120294" :question/problem "![](images/70/707beca1d856414e25874cc0b56c6654fbb41d699f01106b6749d49408b39aee.png)\n\nConsider the diagram above, where $\\overset{\\to }{OU}=u,$ $\\overset{\\to }{OV}=v$ and $W$ divides $\\overset{―}{UV}$ in the ratio $UW:WV=7:2.$ Find $\\overset{\\to }{OW}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OW}=\\overset{\\to }{OU}+\\overset{\\to }{UW}.\n$$\n\nWe're told that $\\overset{\\to }{OU}=u,$ so we just need to work out $\\overset{\\to }{UW}.$\n\nFirst, from $△OUV,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =\\overset{\\to }{UO}+\\overset{\\to }{OV} \\\\  & =-\\overset{\\to }{OU}+\\overset{\\to }{OV} \\\\  & =-u+v \\\\  & =v-u.\\end{aligned}\n$$\n\nSince $UW:WV=7:2,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{7}{9}\\overset{\\to }{UV}=\\frac{7}{9}(v-u).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =u+\\frac{7}{9}(v-u) \\\\  & =\\frac{2}{9}u+\\frac{7}{9}v.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec7aea6-7e9b-5e22-b08e-4d9e29b49a14" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{5}{9}m+\\frac{4}{9}n" :db/id #edb/ref 17592186253798} {:answer/id #uuid "38a55f08-30dd-5226-a035-3ef422cf9289" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{1}{3}m+\\frac{2}{3}n" :db/id #edb/ref 17592186254161} {:answer/id #uuid "98379f30-a71c-5d53-ae03-042f3405b7ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{1}{2}m+\\frac{1}{2}n" :db/id #edb/ref 17592186255015} {:answer/id #uuid "aa8a188a-e50d-5036-99f0-699a116256a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{2}{3}m+\\frac{1}{3}n" :db/id #edb/ref 17592186255178} {:answer/id #uuid "d0d7c189-608f-5823-837a-7c7d46640d1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{4}{9}m+\\frac{5}{9}n" :db/id #edb/ref 17592186255533}] :answer-field/correct {:answer/id #uuid "38a55f08-30dd-5226-a035-3ef422cf9289" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{1}{3}m+\\frac{2}{3}n" :db/id #edb/ref 17592186254161} :answer-field/id #uuid "389158e2-a0c0-5ba2-947f-ffa5aaa799ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256023}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c29ac42f-42ba-5668-9b76-4de9b80fc725" :question/math-academy-id "q-120303" :question/problem "![](images/50/50b87e86bd2985e54ce0a8fe6b3e23986f7e1946a5284d0ae297d96b9cbc60f6.png)\n\nConsider the diagram above, where $\\overset{\\to }{OM}=m,$ $\\overset{\\to }{ON}=n$ and $P$ divides $\\overset{―}{MN}$ in the ratio $MP:PN=2:1.$ Find $\\overset{\\to }{OP}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OP}=\\overset{\\to }{OM}+\\overset{\\to }{MP}.\n$$\n\nWe're told that $\\overset{\\to }{OM}=m,$ so we just need to work out $\\overset{\\to }{MP}.$\n\nFirst, from $△OMN,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{MN} & =\\overset{\\to }{MO}+\\overset{\\to }{ON} \\\\  & =-\\overset{\\to }{OM}+\\overset{\\to }{ON} \\\\  & =-m+n \\\\  & =n-m.\\end{aligned}\n$$\n\nSince $MP:PN=2:1,$ we have\n\n$$\n\\overset{\\to }{MP}=\\frac{2}{3}\\overset{\\to }{MN}=\\frac{2}{3}(n-m).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OP} & =\\overset{\\to }{OM}+\\overset{\\to }{MP} \\\\  & =m+\\frac{2}{3}(n-m) \\\\  & =\\frac{1}{3}m+\\frac{2}{3}n.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d994bc9-80ac-519e-8a27-b44303783cce" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=-\\frac{6}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186253920} {:answer/id #uuid "417bf975-159a-5419-bfd1-40ebc9a90508" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{6}{7}a-\\frac{1}{7}b" :db/id #edb/ref 17592186254227} {:answer/id #uuid "dbd9489c-6b47-566f-89ad-f4e016150b16" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{5}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186255619} {:answer/id #uuid "e41f44f3-369d-5892-92cf-ef2145ce59f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{6}{7}a+\\frac{1}{7}b" :db/id #edb/ref 1