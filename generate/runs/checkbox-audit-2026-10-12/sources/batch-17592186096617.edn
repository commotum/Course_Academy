 :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186300030}] :answer-field/correct {:answer/id #uuid "111b3502-4d20-5d31-91b8-7abbeab14d76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186300030} :answer-field/id #uuid "306a4818-28a4-5233-9c68-e7e860afe61d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301379} {:answer-field/choices [{:answer/id #uuid "d103b022-3392-5699-86c4-14260174eff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186301004}] :answer-field/correct {:answer/id #uuid "d103b022-3392-5699-86c4-14260174eff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186301004} :answer-field/id #uuid "58d2a450-3879-51ea-99f9-5107ab896718" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301520}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11bb7f28-c383-5b5e-983f-e1f6dfaba280" :question/math-academy-id "q-322586" :question/problem "![](images/1d/1deea2da05b0d12c7e9afbb12f0340bdbfef18ff37dc49c506929028bfeb67c4.png)\n\nConsider the diagram above, where $\\overset{\\to }{OL}=l,$ $\\overset{\\to }{OP}=p,$ and $Q$ divides $\\overset{―}{LP}$ in the ratio $LQ:QP=7:9.$ Express $\\overset{\\to }{OQ}$ via the vectors $l$ and $p.$\n\n$\\,\\overset{\\to }{OQ}=$\n{{field-1}}\n$l+$\n{{field-2}}\n$p$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OQ}=\\overset{\\to }{OL}+\\overset{\\to }{LQ}.\n$$\n\nWe're told that $\\overset{\\to }{OL}=l,$ so we just need to work out $\\overset{\\to }{LQ}.$\n\nFirst, from $△OLP,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{LP} & =\\overset{\\to }{LO}+\\overset{\\to }{OP} \\\\  & =-\\overset{\\to }{OL}+\\overset{\\to }{OP} \\\\  & =-l+p \\\\  & =p-l.\\end{aligned}\n$$\n\nSince $LQ:QP=7:9,$ we have\n\n$$\n\\overset{\\to }{LQ}=\\frac{7}{16}\\overset{\\to }{LP}=\\frac{7}{16}(p-l).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OQ} & =\\overset{\\to }{OL}+\\overset{\\to }{LQ} \\\\  & =l+\\frac{7}{16}(p-l) \\\\  & =\\frac{9}{16}l+\\frac{7}{16}p.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3b19d7-9caa-5865-b36b-62dba7ca1b49" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{1}{3}u+\\frac{2}{3}v" :db/id #edb/ref 17592186327054} {:answer/id #uuid "12bc31bd-410e-5cec-b3e8-db5ec16e6668" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}v-\\frac{2}{9}u" :db/id #edb/ref 17592186327095} {:answer/id #uuid "1d8032c3-8159-562d-b85e-ce01f3a9419c" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186327189} {:answer/id #uuid "ccd9827b-fe26-5576-843d-788fca86322f" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{3}u+\\frac{1}{3}v" :db/id #edb/ref 17592186328732} {:answer/id #uuid "f6116bad-8f2c-5913-918c-8429cac9d1d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=-\\frac{1}{3}v+\\frac{2}{3}u" :db/id #edb/ref 17592186329092}] :answer-field/correct {:answer/id #uuid "1d8032c3-8159-562d-b85e-ce01f3a9419c" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186327189} :answer-field/id #uuid "624e21c0-b503-5eed-93a7-5e549f2e0d0a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329358}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cfe5446c-2b26-5e48-974b-de364027f648" :question/math-academy-id "q-42669" :question/problem "![](images/04/040127594f639248736d4492f1853bcb1e6ef18c37db9242ebe466045713628a.png)\n\nConsider the diagram above, where $\\overset{\\to }{OU}=u,$ $\\overset{\\to }{OV}=v$ and $W$ divides $\\overset{―}{UV}$ in the ratio $UW:WV=2:7.$ Find $\\overset{\\to }{OW}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OW}=\\overset{\\to }{OU}+\\overset{\\to }{UW}.\n$$\n\nWe're told that $\\overset{\\to }{OU}=u,$ so we just need to work out $\\overset{\\to }{UW}.$\n\nFirst, from $△OUV,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =\\overset{\\to }{UO}+\\overset{\\to }{OV} \\\\  & =-\\overset{\\to }{OU}+\\overset{\\to }{OV} \\\\  & =-u+v \\\\  & =v-u.\\end{aligned}\n$$\n\nSince $UW:WV=2:7,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{2}{9}\\overset{\\to }{UV}=\\frac{2}{9}(v-u).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =u+\\frac{2}{9}(v-u) \\\\  & =\\frac{7}{9}u+\\frac{2}{9}v.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a4ecfa-47e2-56f4-a423-468e55f93529" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{2}h+\\frac{1}{2}i" :db/id #edb/ref 17592186387003} {:answer/id #uuid "e23408c0-6a35-5afe-abe2-00bbdaf4622a" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{4}h+\\frac{1}{4}i" :db/id #edb/ref 17592186387004} {:answer/id #uuid "a498dbcf-0f77-508b-9c07-efe06b97d9ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{5}{8}h+\\frac{3}{8}i" :db/id #edb/ref 17592186387005} {:answer/id #uuid "748b1bc5-d773-5fa4-a285-111048597c9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{8}h+\\frac{3}{4}i" :db/id #edb/ref 17592186387006} {:answer/id #uuid "86f8cb36-0676-5c61-8d2f-37ebe1006578" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{8}h+\\frac{5}{8}i" :db/id #edb/ref 17592186387007}] :answer-field/correct {:answer/id #uuid "86f8cb36-0676-5c61-8d2f-37ebe1006578" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{8}h+\\frac{5}{8}i" :db/id #edb/ref 17592186387007} :answer-field/id #uuid "3c4f4208-0c8e-57ef-ad8c-1decee05823d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387002}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c0b691a2-9da7-5f9d-b601-8f5daf61f352" :question/math-academy-id "q-120304" :question/problem "![](images/65/6560a7f05ae95638cbfe902dfa022b2d8de6b07c6e1e6f85051ccf87b92ec338.png)\n\nConsider the diagram above, where $\\overset{\\to }{OH}=h,$ $\\overset{\\to }{OI}=i$ and $J$ divides $\\overset{―}{HI}$ in the ratio $HJ:JI=5:3.$ Find $\\overset{\\to }{OJ}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OJ}=\\overset{\\to }{OH}+\\overset{\\to }{HJ}.\n$$\n\nWe're told that $\\overset{\\to }{OH}=h,$ so we just need to work out $\\overset{\\to }{HJ}.$\n\nFirst, from $△OHI,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HI} & =\\overset{\\to }{HO}+\\overset{\\to }{OI} \\\\  & =-\\overset{\\to }{OH}+\\overset{\\to }{OI} \\\\  & =-h+i \\\\  & =i-h.\\end{aligned}\n$$\n\nSince $HJ:JI=5:3,$ we have\n\n$$\n\\overset{\\to }{HJ}=\\frac{5}{8}\\overset{\\to }{HI}=\\frac{5}{8}(i-h).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OJ} & =\\overset{\\to }{OH}+\\overset{\\to }{HJ} \\\\  & =h+\\frac{5}{8}(i-h) \\\\  & =\\frac{3}{8}h+\\frac{5}{8}i.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c08254-bcec-5457-b88b-bb1b31577752" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{6}r+\\frac{1}{6}s" :db/id #edb/ref 17592186390560} {:answer/id #uuid "86737275-5bda-5fe0-92b5-103129881f25" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{6}{11}r+\\frac{5}{11}s" :db/id #edb/ref 17592186390561} {:answer/id #uuid "361d2b59-2e0b-5aa1-b524-15d353a4c2a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=r+\\frac{5}{6}s" :db/id #edb/ref 17592186390562} {:answer/id #uuid "b20f5119-753b-5441-bf91-ce6580448a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" :db/id #edb/ref 17592186390563} {:answer/id #uuid "04d1bf75-797e-5041-b68d-706cd3bf0bc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{1}{11}r+s" :db/id #edb/ref 17592186390564}] :answer-field/correct {:answer/id #uuid "b20f5119-753b-5441-bf91-ce6580448a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" :db/id #edb/ref 17592186390563} :answer-field/id #uuid "48dac603-f4ce-5e8e-b8da-9de99fd610ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390559}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c822bdd5-b239-5109-a43e-980b6e32d798" :question/math-academy-id "q-278288" :question/problem "![](images/ba/ba82c6b68026b0f4339c1e4fa01c4b1aa1b7aee74b74176f81bba1c0e1de259f.png)\n\nConsider the diagram above, where $\\overset{\\to }{OR}=r,$ $\\overset{\\to }{OS}=s$ and $V$ divides $\\overset{―}{RS}$ in the ratio $RV:VS=6:5.$ Find $\\overset{\\to }{OV}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OV}=\\overset{\\to }{OR}+\\overset{\\to }{RV}.\n$$\n\nWe're told that $\\overset{\\to }{OR}=r,$ so we just need to work out $\\overset{\\to }{RV}.$\n\nFirst, from $△ORS,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\overset{\\to }{RO}+\\overset{\\to }{OS} \\\\  & =-\\overset{\\to }{OR}+\\overset{\\to }{OS} \\\\  & =-r+s \\\\  & =s-r.\\end{aligned}\n$$\n\nSince $RV:VS=6:5,$ we have\n\n$$\n\\overset{\\to }{RV}=\\frac{6}{11}\\overset{\\to }{RS}=\\frac{6}{11}(s-r).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OV} & =\\overset{\\to }{OR}+\\overset{\\to }{RV} \\\\  & =r+\\frac{6}{11}(s-r) \\\\  & =\\frac{5}{11}r+\\frac{6}{11}s.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186420465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "747da426-8469-5cfb-b9c1-0f275aa12f5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{1}{4}a+\\frac{3}{4}b" :db/id #edb/ref 17592186420450} {:answer/id #uuid "7870ed39-d3a3-5476-9037-af3a46374a41" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{5}{8}a+\\frac{3}{8}b" :db/id #edb/ref 17592186420451} {:answer/id #uuid "ac24f6e2-146b-56c4-926e-7b7b203e75f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{8}a+\\frac{5}{8}b" :db/id #edb/ref 17592186420454} {:answer/id #uuid "d4a4f00d-a543-5fec-976f-fd2b59d619f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{4}a+\\frac{1}{4}b" :db/id #edb/ref 17592186420458} {:answer/id #uuid "f78f9d21-45cd-5cd7-95b8-055e70bef457" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{7}{8}a+\\frac{1}{8}b" :db/id #edb/ref 17592186420461}] :answer-field/correct {:answer/id #uuid "7870ed39-d3a3-5476-9037-af3a46374a41" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{5}{8}a+\\frac{3}{8}b" :db/id #edb/ref 17592186420451} :answer-field/id #uuid "0cd7bc1d-4953-5e13-8ab6-2c158bebc612" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420462}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6fe46ce7-a162-566e-a261-116569794a12" :question/math-academy-id "q-120289" :question/problem "![](images/52/52e25ccc5b59b3eecd914c5b141e443475a5de58299404528d27f1fc85db97ea.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=a,$ $\\overset{\\to }{OB}=b$, and $T$ divides $\\overset{―}{AB}$ in the ratio $AT:TB=3:5.$ Find $\\overset{\\to }{OT}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OT}=\\overset{\\to }{OA}+\\overset{\\to }{AT}.\n$$\n\nWe're told that $\\overset{\\to }{OA}=a,$ so we just need to work out $\\overset{\\to }{AT}.$\n\nFirst, from $△OAB,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AT:TB=3:5,$ we have\n\n$$\n\\overset{\\to }{AT}=\\frac{3}{8}\\overset{\\to }{AB}=\\frac{3}{8}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =a+\\frac{3}{8}(b-a) \\\\  & =\\frac{5}{8}a+\\frac{3}{8}b.\\end{aligned}\n$$"}] :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] [{:db/id #edb/ref 17592186096696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096496 :question/id #uuid "e8b9014e-32cf-5f04-856c-7fd663bea50f" :question/math-academy-id "e-528" :question/problem "Find the general solution to the differential equation $f'(x) - 3\\sin(2x) = 0.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\nf'(x) = 3\\sin{2x}.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int 3\\operatorname{sin}⁡2x\\,\\text{d}x \\\\ f(x) & =3\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f" :knowledge-point/questions [{:db/id #edb/ref 17592186097118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f651d57-fd13-5223-b101-19044f5a3b48" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) =-\\frac{11}{2}x + C" :db/id #edb/ref 17592186094682} {:answer/id #uuid "0c189129-a43b-5083-8426-a8d988b5bcfc" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = \\frac{11}{2} - C" :db/id #edb/ref 17592186094683} {:answer/id #uuid "441b0a08-b772-5959-b466-9ce911e9e6d1" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) =-\\frac{11}{2}x^{2} + C" :db/id #edb/ref 17592186094684} {:answer/id #uuid "63128db0-6242-55ce-a386-75928939d9fb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = \\frac{11}{2}x^{2}" :db/id #edb/ref 17592186094685} {:answer/id #uuid "7833225a-e7d7-58d8-a243-47f76b32d976" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = 11x^{2} + C" :db/id #edb/ref 17592186094686}] :answer-field/id #uuid "702c2b7a-1035-57b4-98fc-9ee1ec455ef0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094681}] :question/id #uuid "e1c8faa6-71a3-52b0-9c4c-3e41ed01dd83" :question/math-academy-id "q-14245" :question/problem "Find the general solution to the differential equation $f^{′}(x) + 11x = 0$."} {:db/id #edb/ref 17592186097299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a181c2-eaa7-54a0-8890-e935b4d4ff1e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2{e}^{2x}-2{x}^{2}+C" :db/id #edb/ref 17592186330015} {:answer/id #uuid "15c676e1-03b3-5352-b3b8-1386a7ac7b2e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2{e}^{2x}-{x}^{2}+C" :db/id #edb/ref 17592186330129} {:answer/id #uuid "c78be5e7-440c-5080-aede-7717891b5955" :answer/type {:db/ident :answer.type/math} :answer/value "y=-{e}^{2x}-{x}^{2}+C" :db/id #edb/ref 17592186331715} {:answer/id #uuid "cdb467dd-d851-57e6-ba23-4d6c40542276" :answer/type {:db/ident :answer.type/math} :answer/value "y=-{e}^{2x}-2{x}^{2}+C" :db/id #edb/ref 17592186331773} {:answer/id #uuid "fd0ac1c2-8887-5016-9ea9-5bc26155b0dd" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4{e}^{2x}-2{x}^{2}+C" :db/id #edb/ref 17592186332172}] :answer-field/correct {:answer/id #uuid "15c676e1-03b3-5352-b3b8-1386a7ac7b2e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2{e}^{2x}-{x}^{2}+C" :db/id #edb/ref 17592186330129} :answer-field/id #uuid "7491e487-3ec6-578a-921d-573211c3741a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332412}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cb82aa2f-3e4a-523a-94c2-c95aa3cb8ffa" :question/math-academy-id "q-50136" :question/problem "Solve the differential equation $\\frac{\\text{d}y}{\\text{d}x}+4{e}^{2x}=-2x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4{e}^{2x}-2x.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x \\\\ y & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\begin{aligned}y & =\\int (-4{e}^{2x}-2x)\\,\\text{d}x \\\\  & =-4\\int {e}^{2x}\\,\\text{d}x-2\\int x\\,\\text{d}x \\\\  & =-2{e}^{2x}-{x}^{2}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2628def8-9645-51de-9e8f-3993f1de42dc" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-8\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186250883} {:answer/id #uuid "2e2afe8b-693c-5e5d-8ae5-7dd6c9ecac38" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{2}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186250948} {:answer/id #uuid "7e485acb-f298-517c-be2f-3047650c561f" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-\\frac{1}{4}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186251613} {:answer/id #uuid "ce428001-7345-56f1-b009-0b23f9dd54d5" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-\\frac{1}{8}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186252376} {:answer/id #uuid "d492b169-b001-5d91-9313-3a1cdca45303" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186252432}] :answer-field/correct {:answer/id #uuid "ce428001-7345-56f1-b009-0b23f9dd54d5" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-\\frac{1}{8}\\operatorname{cos}⁡4x+C" :db/id #edb/ref 17592186252376} :answer-field/id #uuid "21d3ab40-897b-52d6-935d-dd5cec3b2f88" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252865}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b105cb3a-38a2-5c0a-8e78-f3632457e0c5" :question/math-academy-id "q-119032" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)=\\frac{1}{2}\\operatorname{sin}⁡4x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{2}\\operatorname{sin}⁡4x.\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sin}⁡4x\\,\\text{d}x \\\\ f(x) & =\\frac{1}{2}\\int \\operatorname{sin}⁡4x\\,\\text{d}x \\\\  & =\\frac{1}{2}(-\\frac{1}{4}\\operatorname{cos}⁡4x) \\\\  & =-\\frac{1}{8}\\operatorname{cos}⁡4x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "171dcc35-2e96-5d00-9b3e-92b88f1e973d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=3\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186250755} {:answer/id #uuid "2b19b8bd-9546-5cc0-9ed1-4c2a8ecedd85" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-\\frac{3}{(x-1)^{2}}+C" :db/id #edb/ref 17592186250923} {:answer/id #uuid "437d8ac4-b175-5851-bcbe-f20b4b028b84" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{3}\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186251118} {:answer/id #uuid "64d8f14f-2e7e-56a6-a247-99126b763397" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-\\frac{1}{(3x-1)^{2}}+C" :db/id #edb/ref 17592186251380} {:answer/id #uuid "e882ef4b-8f4d-553d-bbb5-65eff9191ac7" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\operatorname{ln}⁡|3x-1|+C" :db/id #edb/ref 17592186252586}] :answer-field/correct {:answer/id #uuid "171dcc35-2e96-5d00-9b3e-92b88f1e973d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=3\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186250755} :answer-field/id #uuid "e1a55590-7e4d-59c4-88a9-f483aed246b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253190}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e46bf143-4783-5ce4-a8e4-31db596b41d7" :question/math-academy-id "q-119034" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)=\\frac{3}{x-1}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{3}{x-1}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{x-1}\\,\\text{d}x \\\\ f(x) & =3\\int \\frac{1}{x-1}\\,\\text{d}x \\\\  & =3\\operatorname{ln}⁡|x-1|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245c51d3-f742-5f41-b1dd-3551a892b046" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}(1-x)+C" :db/id #edb/ref 17592186250868} {:answer/id #uuid "688f1217-b625-5da8-a08e-dadadf44274e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}({x}^{2}-1)+C" :db/id #edb/ref 17592186251410} {:answer/id #uuid "705ba4e9-a328-506c-95e2-3f7a3275a47d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)={x}^{2}(2x-1)+C" :db/id #edb/ref 17592186251470} {:answer/id #uuid "9b76e6cf-b140-5d7b-bf6a-f55d3ab8cc9c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)={x}^{2}(2-x)+C" :db/id #edb/ref 17592186251893} {:answer/id #uuid "cd912817-d2f0-5ce1-a2a2-c2744159033c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}(3-x)+C" :db/id #edb/ref 17592186252367}] :answer-field/correct {:answer/id #uuid "245c51d3-f742-5f41-b1dd-3551a892b046" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}(1-x)+C" :db/id #edb/ref 17592186250868} :answer-field/id #uuid "dbaa4233-2442-5788-bdba-a93b2096247b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253180}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fb6cc49c-88f2-58a8-a4b7-b8174a349cdf" :question/math-academy-id "q-119035" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)+6{x}^{2}=4x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =4x-6{x}^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (4x-6{x}^{2})\\text{d}x \\\\  & =4\\int x\\,\\text{d}x-6\\int {x}^{2}\\,\\text{d}x \\\\  & =4\\cdot \\frac{1}{2}{x}^{2}-6\\cdot \\frac{1}{3}{x}^{3} \\\\  & =2{x}^{2}-2{x}^{3}+C \\\\  & =2{x}^{2}(1-x)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186362335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07dc3b58-eba0-5097-b69a-33c5acc27717" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{9}{5}\\operatorname{sin}⁡(3x)+C" :db/id #edb/ref 17592186360865} {:answer/id #uuid "190d9a53-3469-5e7f-b03f-2cf38a49c79d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{9}{5}\\operatorname{cos}⁡(3x)+C" :db/id #edb/ref 17592186360936} {:answer/id #uuid "404a584d-5be0-5c62-874f-3e3012cc296c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{3}{5}\\operatorname{sin}⁡(3x)+C" :db/id #edb/ref 17592186361125} {:answer/id #uuid "46d918e7-6c1c-54ae-9afa-2a28c3b9aae3" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{5}\\operatorname{cos}⁡(3x)+C" :db/id #edb/ref 17592186361143} {:answer/id #uuid "d39f0726-0e78-5f3d-a8ec-67d31d858e0a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{5}\\operatorname{sin}⁡(3x)+C" :db/id #edb/ref 17592186361784}] :answer-field/correct {:answer/id #uuid "d39f0726-0e78-5f3d-a8ec-67d31d858e0a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{5}\\operatorname{sin}⁡(3x)+C" :db/id #edb/ref 17592186361784} :answer-field/id #uuid "3bf37d9f-29ab-5f48-be79-4562eb844e34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362036}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d1695f8e-4929-5966-a2ac-c737d784a8b6" :question/math-academy-id "q-99006" :question/problem "Solve the differential equation $-5{f}^{′}(x)+3\\operatorname{cos}⁡(3x)=0.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n{f}^{′}(x)=\\frac{3}{5}\\operatorname{cos}⁡(3x).\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{5}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\ f(x) & =\\int \\frac{3}{5}\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\int \\frac{3}{5}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{3}{5}\\int \\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{3}{5}\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)+C \\\\  & =\\frac{1}{5}\\operatorname{sin}⁡(3x)+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186386896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1101527-9f4f-5301-a5d7-2c4675ea434d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)={e}^{x-3}+C" :db/id #edb/ref 17592186386898} {:answer/id #uuid "702773f0-c93f-5fdc-8cfc-c4f417f927cb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{3}{e}^{-x}+C" :db/id #edb/ref 17592186386899} {:answer/id #uuid "db2dc2fe-2a07-5f7b-a570-4e58c725722c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=3{e}^{-x}+C" :db/id #edb/ref 17592186386900} {:answer/id #uuid "09cf98b5-cc32-56bd-a7bc-80017c397c1d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)={e}^{-3x}+C" :db/id #edb/ref 17592186386901} {:answer/id #uuid "2723b2b5-87a6-52a2-bd3a-988db461edac" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-{e}^{-x/3}+C" :db/id #edb/ref 17592186386902}] :answer-field/correct {:answer/id #uuid "db2dc2fe-2a07-5f7b-a570-4e58c725722c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=3{e}^{-x}+C" :db/id #edb/ref 17592186386900} :answer-field/id #uuid "a5995d24-fede-525d-a40c-73179ae79979" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386897}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "57dad966-30e8-503a-bfa2-6fa76bd6e7c3" :question/math-academy-id "q-119033" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)+3{e}^{-x}=0.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-3{e}^{-x}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (-3{e}^{-x})\\text{d}x \\\\ f(x) & =-3\\int {e}^{-x}\\,\\text{d}x \\\\  & =-3(-{e}^{-x})+C \\\\  & =3{e}^{-x}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186399989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b6602d-f037-52b0-8c48-d0885dedafc2" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2(x+9{e}^{-3x})+C" :db/id #edb/ref 17592186399991} {:answer/id #uuid "30b063ed-08ab-5694-9771-9427e9a07c6f" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x-2{e}^{-3x}+C" :db/id #edb/ref 17592186399992} {:answer/id #uuid "95477359-7c43-51b4-a1ff-890600150acd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x+{e}^{-3x}+C" :db/id #edb/ref 17592186399993} {:answer/id #uuid "4a2d9c2f-bf87-54d1-a5c5-0103894f75e3" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x-18{e}^{-3x}+C" :db/id #edb/ref 17592186399994} {:answer/id #uuid "3694a7a7-cd54-5712-bdcb-421abc079139" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2(x-3{e}^{-3x})+C" :db/id #edb/ref 17592186399995}] :answer-field/correct {:answer/id #uuid "30b063ed-08ab-5694-9771-9427e9a07c6f" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x-2{e}^{-3x}+C" :db/id #edb/ref 17592186399992} :answer-field/id #uuid "8f36605a-43ff-547f-a708-ab078c73b400" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399990}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8e422fe9-fc97-5df0-b6a5-ce1fd6f9f5cf" :question/math-academy-id "q-119037" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)-6{e}^{-3x}=1.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =1+6{e}^{-3x}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (1+6{e}^{-3x})\\text{d}x \\\\  & =\\int \\text{d}x+6\\int {e}^{-3x}\\,\\text{d}x \\\\  & =x+6(-\\frac{1}{3}{e}^{-3x}) \\\\  & =x-2{e}^{-3x}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the General Solution of a Differential Equation Using Integration"}]}
