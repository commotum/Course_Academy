#{[{:db/id #edb/ref 17592186096617 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096417 :question/id #uuid "d7a77a89-0535-54da-a246-36ee5b4e9e7f" :question/math-academy-id "e-3634" :question/problem "Differentiate $x\\cos x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)=x$ and $v(x)=\\cos x .$ So, we apply the product rule:\n\n$$\n\\eqalign{\n\t (x\\cos x)' &=   u'(x) \\cdot v(x) + u(x) \\cdot v'(x)\\\n\t\t\t\t\t\t&= (x)'\\cdot \\cos x + x\\cdot (\\cos x)'\\\n\t\t\t\t\t   & = 1 \\cdot \\cos x + x (-\\sin x)\\\n\t\t\t\t\t  & =  \\cos x - x \\sin x\t\t\t\t\t\n\n}\n$$"} :knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77" :knowledge-point/questions [{:db/id #edb/ref 17592186097154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aca48a7b-5c44-5ceb-9f7a-46475643a906" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos x - x^{2}\\sin x" :db/id #edb/ref 17592186094898} {:answer/id #uuid "bb75f041-eacc-5451-b3bf-166b8949e018" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos x - 2x\\sin x" :db/id #edb/ref 17592186094899} {:answer/id #uuid "be19c12b-7932-58a0-8911-03fae070336e" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos x - x^{2}\\sin x" :db/id #edb/ref 17592186094900} {:answer/id #uuid "01d55ed0-9518-50b6-bd31-eee6e6062db5" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos x - 2x\\sin x" :db/id #edb/ref 17592186094901} {:answer/id #uuid "7c36000d-a170-5e76-a4c2-7f56fa11b4fd" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\cos x + x^{2}\\sin x" :db/id #edb/ref 17592186094902}] :answer-field/id #uuid "176e6625-97a1-5955-aa6f-db131e85d138" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094897}] :question/id #uuid "637cc150-7613-534a-bd8b-a83dc2342647" :question/math-academy-id "q-1907" :question/problem "Differentiate $x^{2}\\cos x$."} {:db/id #edb/ref 17592186097244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9123bd43-0985-5815-be98-b4a9d900c88c" :answer/type {:db/ident :answer.type/math} :answer/value "2x + x^{2}\\sec x\\tan x" :db/id #edb/ref 17592186095389} {:answer/id #uuid "c878d6c7-8a8f-5afe-acd0-f6083b75b15d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\tan x(2x + \\sec x)" :db/id #edb/ref 17592186095390} {:answer/id #uuid "cafc2f88-c0bc-5677-aebd-e70ab8b877b4" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\sec x\\tan x" :db/id #edb/ref 17592186095391} {:answer/id #uuid "098c202e-114f-59ad-a524-c2dbaf56709e" :answer/type {:db/ident :answer.type/math} :answer/value "x(2\\tan x + x\\sec^{2} x)" :db/id #edb/ref 17592186095392} {:answer/id #uuid "72022765-1175-5b0d-bf32-d2786a419e46" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x(2 + x^{2}\\tan x)" :db/id #edb/ref 17592186095393}] :answer-field/id #uuid "634e8d5c-10ef-5420-b752-d09396e5a6f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095388}] :question/id #uuid "af8066b5-6cf6-5662-aded-c14a5c3d72ef" :question/math-academy-id "q-47965" :question/problem "Differentiate $x^{2}\\tan x$."} {:db/id #edb/ref 17592186233774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d88db36a-1743-57b4-81de-ba3e94f146e8" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232540}] :answer-field/correct {:answer/id #uuid "d88db36a-1743-57b4-81de-ba3e94f146e8" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232540} :answer-field/id #uuid "4cf0faa2-183e-595b-9158-aab3d3891b84" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232539}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a902a53e-f058-534a-bee4-004868eb968b" :question/math-academy-id "q-310188" :question/problem "Differentiate ${3}^{x}\\operatorname{sin}(x).$\n\n$({3}^{x}\\operatorname{sin}(x))^{'}=$\n{{field-1}} $+\\,{3}^{x}\\operatorname{cos}(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)=\\operatorname{sin}(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({3}^{x}\\operatorname{sin}(x))^{'} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =({3}^{x})^{'}\\cdot \\operatorname{sin}(x)+{3}^{x}\\cdot (\\operatorname{sin}(x))^{'} \\\\  & =({3}^{x}\\operatorname{ln}(3))(\\operatorname{sin}(x))+({3}^{x})(\\operatorname{cos}(x)) \\\\  & ={3}^{x}\\operatorname{ln}(3)\\operatorname{sin}(x)+{3}^{x}\\operatorname{cos}(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131acbe9-558d-5eca-b043-6011320bbf1f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{tan}(x)-2)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232577}] :answer-field/correct {:answer/id #uuid "131acbe9-558d-5eca-b043-6011320bbf1f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{tan}(x)-2)\\operatorname{sin}(x)" :db/id #edb/ref 17592186232577} :answer-field/id #uuid "db20f675-f846-587b-8b98-472e5b4e4ce4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232576}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "04a32680-52e9-52f1-b831-14d1889bed06" :question/math-academy-id "q-319402" :question/problem "Differentiate $(2-\\operatorname{tan}(x))\\operatorname{cos}(x)$\n\n$((2-\\operatorname{tan}(x))\\operatorname{cos}(x))^{'}=-{sec}^{2}(x)\\operatorname{cos}(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=2-\\operatorname{tan}(x)$ and $v(x)=\\operatorname{cos}(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}((2-\\operatorname{tan}(x))\\operatorname{cos}(x))^{'} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =(2-\\operatorname{tan}(x))^{'}\\cdot \\operatorname{cos}(x)+(2-\\operatorname{tan}(x))\\cdot (\\operatorname{cos}(x))^{'} \\\\  & =(-{sec}^{2}(x))(\\operatorname{cos}(x))+(2-\\operatorname{tan}(x))(-\\operatorname{sin}(x)) \\\\  & =-{sec}^{2}(x)\\operatorname{cos}(x)+(\\operatorname{tan}(x)-2)\\operatorname{sin}(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234296 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b5dea81-9340-51d4-993f-9f9ce501ae79" :question/math-academy-id "q-71004" :question/problem "Differentiate ${e}^{x}\\operatorname{sin}x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=\\operatorname{sin}x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}\\operatorname{sin}x)^{'} & ={u}^{'}(x)\\cdot v(x)+u(x)\\cdot {v}^{'}(x) \\\\  & =({e}^{x})^{'}\\cdot \\operatorname{sin}x+{e}^{x}\\cdot (\\operatorname{sin}x)^{'} \\\\  & =({e}^{x})(\\operatorname{sin}x)+({e}^{x})(\\operatorname{cos}x) \\\\  & ={e}^{x}\\operatorname{sin}x+{e}^{x}\\operatorname{cos}x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20897b11-31f3-5236-8344-066364ab30aa" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}cos⁡x-{e}^{x}sin⁡x" :db/id #edb/ref 17592186238339} {:answer/id #uuid "2e9dc0f2-2211-5b4e-a2e7-26a81ec7f21c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}cos⁡x+sin⁡x" :db/id #edb/ref 17592186238465} {:answer/id #uuid "528c811e-a747-5b55-b5c7-a2d707220097" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}cos⁡x-{e}^{x}sin⁡x" :db/id #edb/ref 17592186238765} {:answer/id #uuid "c9cd3281-ae65-5560-8442-2a603e50ff12" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}cos⁡x+sin⁡x" :db/id #edb/ref 17592186239827} {:answer/id #uuid "cce47b31-03c3-57e4-ae08-02ac34ba2a0c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}cos⁡x+{e}^{x}sin⁡x" :db/id #edb/ref 17592186239848}] :answer-field/correct {:answer/id #uuid "528c811e-a747-5b55-b5c7-a2d707220097" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}cos⁡x-{e}^{x}sin⁡x" :db/id #edb/ref 17592186238765} :answer-field/id #uuid "fe0d6216-93d3-5d7b-aefb-cbdf2e8a0a46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240776}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d7240cf-a773-5ae8-8c7e-03955317789e" :question/math-academy-id "q-104297" :question/problem "Differentiate ${e}^{x}cos⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}cos⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot cos⁡x+{e}^{x}\\cdot (cos⁡x)^{′} \\\\  & =({e}^{x})(cos⁡x)+({e}^{x})(-sin⁡x) \\\\  & ={e}^{x}cos⁡x-{e}^{x}sin⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "329a0351-2458-5dc2-afb3-fb83d076e70a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}sec⁡x+{e}^{x}{sec}^{2}⁡x" :db/id #edb/ref 17592186285251} {:answer/id #uuid "3d41ba8e-fd4a-5c5b-8e2c-3eb30e482c53" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186285366} {:answer/id #uuid "5b2ff268-76d1-583f-9abe-62b917b9c7eb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{csc}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186285621} {:answer/id #uuid "93783351-25ff-5c87-8ae9-958c98c327e1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}⁡x+tan⁡x" :db/id #edb/ref 17592186286129} {:answer/id #uuid "eb7d1570-7a65-5731-b765-bf52675c003d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186286945}] :answer-field/correct {:answer/id #uuid "eb7d1570-7a65-5731-b765-bf52675c003d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x" :db/id #edb/ref 17592186286945} :answer-field/id #uuid "a44b9e2e-ea9e-5094-bc4f-bc781e7df5d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287478}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a541e9ea-7fd8-5568-9e5c-f9ef03f5eaf6" :question/math-academy-id "q-1931" :question/problem "Differentiate ${e}^{x}tan⁡x.$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=tan⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}tan⁡x)^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot tan⁡x+{e}^{x}\\cdot (tan⁡x)^{′} \\\\  & =({e}^{x})(tan⁡x)+({e}^{x})({sec}^{2}⁡x) \\\\  & ={e}^{x}{sec}^{2}⁡x+{e}^{x}tan⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bac31f3f-82dd-5744-9c52-62141c569e1f" :answer/type {:db/ident :answer.type/math} :answer/value "(2+\\operatorname{sin}(x)){e}^{x}" :db/id #edb/ref 17592186298365}] :answer-field/correct {:answer/id #uuid "bac31f3f-82dd-5744-9c52-62141c569e1f" :answer/type {:db/ident :answer.type/math} :answer/value "(2+\\operatorname{sin}(x)){e}^{x}" :db/id #edb/ref 17592186298365} :answer-field/id #uuid "3d13588f-071e-5a52-a869-877b2c497c93" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298845}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c9a55990-04ba-5f4c-bd0b-a335f0aeb15a" :question/math-academy-id "q-319350" :question/problem "Differentiate ${e}^{x}(2+sin⁡(x)).$\n\n$({e}^{x}(2+sin⁡(x)))^{′}=$\n{{field-1}} $+\\,{e}^{x}cos⁡(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)={e}^{x}$ and $v(x)=2+sin⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}({e}^{x}sec⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({e}^{x})^{′}\\cdot (2+sin⁡(x))+{e}^{x}\\cdot (2+sin⁡(x))^{′} \\\\  & =({e}^{x})(2+sin⁡(x))+({e}^{x})(cos⁡(x)) \\\\  & =(2+sin⁡(x)){e}^{x}+{e}^{x}cos⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70915bcc-86df-54d2-a4fe-50e0b9f25633" :answer/type {:db/ident :answer.type/math} :answer/value "4x\\operatorname{cos}(x)" :db/id #edb/ref 17592186298034}] :answer-field/correct {:answer/id #uuid "70915bcc-86df-54d2-a4fe-50e0b9f25633" :answer/type {:db/ident :answer.type/math} :answer/value "4x\\operatorname{cos}(x)" :db/id #edb/ref 17592186298034} :answer-field/id #uuid "75c11172-6006-5675-abeb-a1bc58910b0a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dca45644-472a-517e-a9dd-987f8f5907bc" :question/math-academy-id "q-319357" :question/problem "Differentiate $2{x}^{2}cos⁡(x).$\n\n$(2{x}^{2}cos⁡(x))^{′}=$\n{{field-1}} $-\\,2{x}^{2}sin⁡(x)$" :question/worked-solution "Here, we have the product of the two functions $u(x)=2{x}^{2}$ and $v(x)=cos⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(2{x}^{2}cos⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2{x}^{2})^{′}\\cdot cos⁡(x)+2{x}^{2}\\cdot (cos⁡(x))^{′} \\\\  & =(4x)(cos⁡(x))+(2{x}^{2})(-sin⁡(x)) \\\\  & =4xcos⁡(x)-2{x}^{2}sin⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299752 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284d504d-e400-57ba-866e-f8dff66216fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x}{sec}^{2}(x)" :db/id #edb/ref 17592186297724}] :answer-field/correct {:answer/id #uuid "284d504d-e400-57ba-866e-f8dff66216fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{x}{sec}^{2}(x)" :db/id #edb/ref 17592186297724} :answer-field/id #uuid "ecb4d22f-ab7d-5aa3-8db2-cf3a5509f8ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299438}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9df2a3ce-ad57-5588-83d2-42b69ca3314d" :question/math-academy-id "q-319385" :question/problem "Differentiate $\\sqrt{x}tan⁡(x).$\n\n$(\\sqrt{x}tan⁡(x))^{′}=\\frac{tan⁡(x)}{2\\sqrt{x}}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=\\sqrt{x}$ and $v(x)=tan⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(\\sqrt{x}tan⁡(x))^{′} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(\\sqrt{x})^{′}\\cdot tan⁡(x)+\\sqrt{x}\\cdot (tan⁡(x))^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}(tan⁡(x))+(\\sqrt{x})({sec}^{2}⁡(x)) \\\\  & =\\frac{tan⁡(x)}{2\\sqrt{x}}+\\sqrt{x}{sec}^{2}⁡(x)\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Product Containing a Trigonometric Function"}] [{:db/id #edb/ref 17592186096618 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096418 :question/id #uuid "6bb0eded-7277-5ab5-8c13-bfc480403b1a" :question/math-academy-id "e-3635" :question/problem "Given that $f(x)=x^2\\ln x,$ find $f'(x).$" :question/worked-solution "Here, we have the product of two functions $u(x) = x^2$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2})}^{′}ln⁡x+{x}^{2}{(ln⁡x)}^{′} \\\\  & =2x\\cdot ln⁡x+{x}^{2}(\\frac{1}{x}) \\\\  & =2xln⁡x+x \\\\  & =x(2ln⁡x+1)\\end{aligned}\n$$"} :knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8" :knowledge-point/questions [{:db/id #edb/ref 17592186097162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0160d55-41e0-5207-b70c-5dfc23c09ff6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5\\ln x}{x}" :db/id #edb/ref 17592186094946} {:answer/id #uuid "c7990de4-7764-55e3-9375-eb40c109bc76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x} + \\frac{5\\ln x}{x\\ln 3}" :db/id #edb/ref 17592186094947} {:answer/id #uuid "d09b4047-e57a-53fc-a06a-395be25f2765" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{\\ln x}{x\\ln 3}" :db/id #edb/ref 17592186094948} {:answer/id #uuid "335f8a22-7cb0-58d7-b32a-65b960fb6f3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5\\ln x}{x\\ln 3}" :db/id #edb/ref 17592186094949} {:answer/id #uuid "667ba516-4fd4-5570-a622-0203f2df6f20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5}{x\\ln 3}" :db/id #edb/ref 17592186094950}] :answer-field/id #uuid "39bd020b-c912-5ba2-9e81-38edfaf9381b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094945}] :question/id #uuid "cf22f993-a76b-52d8-8977-b83456911b64" :question/math-academy-id "q-1933" :question/problem "Given that $f(x) = 5\\log_{3} x\\ln x$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186097245 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bee14b33-9a9a-566f-ae0f-b70db7b75c86" :answer/type {:db/ident :answer.type/math} :answer/value "-3x^{-4}\\log_{2} x + x^{-3} \\cdot \\frac{1}{x}" :db/id #edb/ref 17592186095395} {:answer/id #uuid "65a54537-8926-5d90-9de3-43e22ca3f920" :answer/type {:db/ident :answer.type/math} :answer/value "-3x^{-4} \\cdot \\frac{1}{x\\ln 2}" :db/id #edb/ref 17592186095396} {:answer/id #uuid "6d25aa7d-6713-5cdb-87e2-d99151b0b223" :answer/type {:db/ident :answer.type/math} :answer/value "x^{-3}(3\\log_{2} x - \\frac{1}{\\ln 2})" :db/id #edb/ref 17592186095397} {:answer/id #uuid "73dfd687-de90-55f0-b921-6721f070fe6d" :answer/type {:db/ident :answer.type/math} :an