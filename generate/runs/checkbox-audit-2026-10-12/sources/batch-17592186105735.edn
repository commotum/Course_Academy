 & 0\\end{aligned}|+1\\cdot |\\begin{aligned}3 & -3 \\\\ 2 & -1\\end{aligned}| \\\\  & =((-3)\\cdot 0-(-1)\\cdot 2)+4(3\\cdot 0-2\\cdot 2)+(3\\cdot (-1)-2\\cdot (-3)) \\\\  & =2-16+3 \\\\  & =-11.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f004e8a-2d25-564b-bf1f-8fae2abb86df" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260017} {:answer/id #uuid "82fda9c3-16c1-5806-a012-a34ae4c1bfa8" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186261012} {:answer/id #uuid "972f1345-e52d-58eb-ae30-3eb82ce9c45f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186261187} {:answer/id #uuid "c2590a97-ba1f-5833-ac3a-19f3da83c3e8" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261588} {:answer/id #uuid "d4426b8c-3067-50d4-8333-34c0e794e8f8" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186261745}] :answer-field/correct {:answer/id #uuid "c2590a97-ba1f-5833-ac3a-19f3da83c3e8" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261588} :answer-field/id #uuid "2d10b3cf-a3e7-5c1c-aafc-7abe846e273d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262203}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "55c9895d-23d4-50a7-8c21-33e1b247f3b1" :question/math-academy-id "q-128107" :question/problem "Let $a=⟨0,9,3⟩,$ $b=⟨3,2,0⟩$ and $c=⟨-1,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}0 & 9 & 3 \\\\ 3 & 2 & 0 \\\\ -1 & 1 & 1\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned