#{[{:db/id #edb/ref 17592186105735 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105593 :question/id #uuid "2f380683-0d93-541d-a07d-95a1d889c761" :question/math-academy-id "e-4347" :question/problem "Let $\\mathbf{a}=\\langle 2,-3,2 \\rangle,$ $\\mathbf{b}=\\langle -1,0,5 \\rangle,$ and $\\mathbf{c}=\\langle 1,2,3 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 5 \\\\ 1 & 2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 5 \\\\ 2 & 3\\end{aligned}|i-|\\begin{aligned}-1 & 5 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(0\\cdot 3-5\\cdot 2)i-(-1\\cdot 3-5\\cdot 1)j+(-1\\cdot 2-0\\cdot 2)k \\\\  & =-10i+8j-2k \\\\  & =⟨-10,8,-2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,-3,2⟩\\cdot ⟨-10,8,-2⟩ \\\\  & =2\\cdot (-10)+(-3)\\cdot 8+2\\cdot (-2) \\\\  & =-48\\end{aligned}\n$$"} :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/questions [{:db/id #edb/ref 17592186106130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a7cc806-5d8c-52f5-8e9d-28150ae6a1bb" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186285339} {:answer/id #uuid "3b0d409a-ddf1-525b-a0d4-aa58e215fa46" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186285343} {:answer/id #uuid "bd3e507c-3caf-5e62-ac65-0cc55ade3ef2" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186286515} {:answer/id #uuid "c0d377fc-8087-5c10-96ba-7988c2d59520" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186286551} {:answer/id #uuid "da0f18b2-ddfb-59a1-8003-09695e06caea" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186286778}] :answer-field/correct {:answer/id #uuid "3a7cc806-5d8c-52f5-8e9d-28150ae6a1bb" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186285339} :answer-field/id #uuid "fb44303e-1350-575a-9022-58d744cd9e96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287657}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "54e446ca-f780-515b-91f0-06748b3e67bc" :question/math-academy-id "q-20063" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨1,0,2⟩$ and $b\\times c=⟨-2,1,8⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,0,2⟩\\cdot ⟨-2,1,8⟩ \\\\  & =1\\cdot (-2)+0\\cdot 1+2\\cdot 8 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186106131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6351ad9-60eb-5c1f-b085-0679828a8f43" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186102663} {:answer/id #uuid "bd21b2e9-ea49-5df3-8d99-5c5fe08c5507" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186102664} {:answer/id #uuid "de9107a1-a714-5163-bbc2-967ba2fe6b39" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186102665} {:answer/id #uuid "f05b096d-b558-5756-8dfd-2ddf5e8baaf0" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186102666} {:answer/id #uuid "f58ada1e-09a7-5c98-bb8c-566d28d2cc28" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186102667}] :answer-field/correct {:answer/id #uuid "f58ada1e-09a7-5c98-bb8c-566d28d2cc28" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186102667} :answer-field/id #uuid "ab5f7550-d466-5039-802c-5c3f0c6aa926" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102662}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cb9b799b-95c5-5b8c-b1f0-b4bcc39f76c4" :question/math-academy-id "q-20065" :question/problem "Given that $a=⟨0,-2,3⟩,$ $b=⟨4,-2,1⟩,$ and $c=⟨3,-1,2⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 4 & -2 & 1 \\\\ 3 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 1 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}4 & 1 \\\\ 3 & 2\\end{aligned}|j+|\\begin{aligned}4 & -2 \\\\ 3 & -1\\end{aligned}|k \\\\  & =((-2)\\cdot 2-1\\cdot (-1))i-(4\\cdot 2-1\\cdot 3)j+(4\\cdot (-1)-(-2)\\cdot 3)k \\\\  & =-3i-5j+2k \\\\  & =⟨-3,-5,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,-2,3⟩\\cdot ⟨-3,-5,2⟩ \\\\  & =0\\cdot (-3)+(-2)\\cdot (-5)+3\\cdot 2 \\\\  & =16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2533792b-1000-57ed-bd32-dc18c559c932" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186260197} {:answer/id #uuid "3a3b313e-4d83-5f33-8d62-60d3aa43890d" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186260395} {:answer/id #uuid "983ba299-7c28-5f24-a401-422168b7fb14" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261195} {:answer/id #uuid "a8aa8b47-ed96-5324-a779-87eafae577e1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261348} {:answer/id #uuid "ee23525d-d93f-54d4-aaea-f54545a58a05" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261970}] :answer-field/correct {:answer/id #uuid "ee23525d-d93f-54d4-aaea-f54545a58a05" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186261970} :answer-field/id #uuid "8a6925d3-c72a-585b-9c71-de675fc6d995" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262366}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "345911eb-d8f0-5c7f-a7bf-7219fc388144" :question/math-academy-id "q-128091" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-1,1,0⟩$ and $b\\times c=⟨6,1,7⟩.$" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,1,0⟩\\cdot ⟨6,1,7⟩ \\\\  & =(-1)\\cdot 6+1\\cdot 1+0\\cdot 7 \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292839 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e75192d-d55e-5612-87e9-5c19a9bc0579" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186290700}] :answer-field/correct {:answer/id #uuid "0e75192d-d55e-5612-87e9-5c19a9bc0579" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186290700} :answer-field/id #uuid "0b4447ef-bb30-5505-b1c3-d8bc339f5382" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291776}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "72cfd9b9-a8b6-5fcc-92da-c6a5b78e755e" :question/math-academy-id "q-275347" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{3},0,-2⟩$ and $b\\times c=⟨-\\sqrt{3},10,-10⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{3},0,-2⟩\\cdot ⟨-\\sqrt{3},10,-10⟩ \\\\  & =(-\\sqrt{3})\\cdot (-\\sqrt{3})+0\\cdot 10+(-2)\\cdot (-10) \\\\  & =3+0+20 \\\\  & =23.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0e5a73a-2919-5f8c-a396-7d6e2d9fe189" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291402}] :answer-field/correct {:answer/id #uuid "b0e5a73a-2919-5f8c-a396-7d6e2d9fe189" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291402} :answer-field/id #uuid "dcec4611-b8bf-5bde-af83-ce1e61831acc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292422}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ae335859-0dfa-58d7-a7ca-cf642f79ca2b" :question/math-academy-id "q-275348" :question/problem "Given that $a=⟨1,2,3⟩,$ $b=⟨-1,0,-2⟩,$ and $c=⟨0,-2,1⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & -2 \\\\ 0 & -2 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|i-|\\begin{aligned}-1 & -2 \\\\ 0 & 1\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}|k \\\\  & =(0\\cdot 1-(-2)\\cdot (-2))i-((-1)\\cdot 1-0\\cdot (-2))j+((-1)\\cdot (-2)-0\\cdot 0)k \\\\  & =-4i+j+2k \\\\  & =⟨-4,1,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,2,3⟩\\cdot ⟨-4,1,2⟩ \\\\  & =1\\cdot (-4)+2\\cdot 1+3\\cdot 2 \\\\  & =-4+2+6 \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a5bc8d5-e509-5863-b1b0-5d966475a48c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298152}] :answer-field/correct {:answer/id #uuid "8a5bc8d5-e509-5863-b1b0-5d966475a48c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298152} :answer-field/id #uuid "4e520c21-8113-540a-a136-ed9d09b72c68" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298903}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e756bda8-091e-58df-91a3-7d6c4fd6790c" :question/math-academy-id "q-317302" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨\\sqrt{7},-2,5⟩$ and $b\\times c=⟨\\sqrt{7},3,-1⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨\\sqrt{7},-2,5⟩\\cdot ⟨\\sqrt{7},3,-1⟩ \\\\  & =(\\sqrt{7})(\\sqrt{7})+(-2)(3)+(5)(-1) \\\\  & =7-6-5 \\\\  & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "642b83ad-84f3-53a2-ae75-f108cc2a5be0" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186297978}] :answer-field/correct {:answer/id #uuid "642b83ad-84f3-53a2-ae75-f108cc2a5be0" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186297978} :answer-field/id #uuid "cf93de4a-48e1-5dad-a599-646066d80847" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299336}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dcaa5f3b-4be2-5705-929a-5ba642430c92" :question/math-academy-id "q-317303" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{8},\\,4,\\,-3⟩$ and $b\\times c=⟨\\sqrt{8},\\,-1,\\,2⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{8},\\,4,\\,-3⟩\\cdot ⟨\\sqrt{8},\\,-1,\\,2⟩ \\\\  & =(-\\sqrt{8})(\\sqrt{8})+(4)(-1)+(-3)(2) \\\\  & =-8-4-6 \\\\  & =-18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f46a08c3-ac51-5443-9d62-4a4fdbe6834b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298591}] :answer-field/correct {:answer/id #uuid "f46a08c3-ac51-5443-9d62-4a4fdbe6834b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298591} :answer-field/id #uuid "5a67eb77-f73b-57a3-9ceb-4843468c5708" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298946}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "47306bb8-b679-542e-9111-9cf80b931f6e" :question/math-academy-id "q-317304" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨0,\\,5,\\,\\sqrt{11}⟩$ and $b\\times c=⟨7,\\,-2,\\,\\sqrt{11}⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,\\,5,\\,\\sqrt{11}⟩\\cdot ⟨7,\\,-2,\\,\\sqrt{11}⟩ \\\\  & =(0)(7)+(5)(-2)+(\\sqrt{11})(\\sqrt{11}) \\\\  & =0-10+11 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5ad400-1475-5884-8d73-aa99d98ec4d6" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186339542} {:answer/id #uuid "57d0a154-1aaa-5696-835d-3eecfa11a6d9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339929} {:answer/id #uuid "86e1fe55-454a-5121-bac4-46896aa3ba50" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186340340} {:answer/id #uuid "908c7900-9735-5a67-b556-85b9b49edab0" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186340424} {:answer/id #uuid "f836db60-b44d-5c4b-8a95-1f0a325c7eee" :answer/type {:db