31d822e022d65d.png" :db/id #edb/ref 17592186386963} :answer-field/id #uuid "8eb0f45e-2d6d-59d5-95a0-428528782598" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386960}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5ca31a32-1c1a-5bad-882d-872d4b1f5188" :question/math-academy-id "q-119372" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{xy}?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/7d/7d5df9fe81ebd1e656eefc97380ae646a1a4f64de51e4745bc31d822e022d65d.png)\n\n  \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/d0/d05d98b24783511dc6ff7518141e49d9cfefe96565f16b9d11b30d0e6fc0a5a4.png)"} {:db/id #edb/ref 17592186386966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84adfcaf-a598-5571-aa06-f6af588ed60a" :answer/type {:db/ident :answer.type/image} :answer/value "images/fe/fe57c0cc2d75729921eb46408e0e4a6932eba06c00034f2ec4c579c8c5627376.png" :db/id #edb/ref 17592186386968} {:answer/id #uuid "d119e212-ad62-51f4-aa40-7ccda4c4d389" :answer/type {:db/ident :answer.type/image} :answer/value "images/c9/c959785ef067b41eba5e5ca5f0759acdd81c9f613c92854ba5937be6bced2c86.png" :db/id #edb/ref 17592186386969} {:answer/id #uuid "e17b3836-865c-519c-88f1-9b2ec1f1d16a" :answer/type {:db/ident :answer.type/image} :answer/value "images/ac/ac12c64fe5282c78ea926eec823cec6b66c8fad9f153c4191d39ba7751e90e25.png" :db/id #edb/ref 17592186386970} {:answer/id #uuid "373395c0-c96b-52a6-9531-5a58b40d8884" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png" :db/id #edb/ref 17592186386971} {:answer/id #uuid "48347676-3575-5e72-90f7-c8cf10b0c6a7" :answer/type {:db/ident :answer.type/image} :answer/value "images/96/96817ea42e1d860db97d3ee6bca79e9a8b03a0fd413c87ebc5679f746da3166b.png" :db/id #edb/ref 17592186386972}] :answer-field/correct {:answer/id #uuid "373395c0-c96b-52a6-9531-5a58b40d8884" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png" :db/id #edb/ref 17592186386971} :answer-field/id #uuid "cc934043-e8c4-5447-b0e7-d94aa4cef2d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386967}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d1772040-8608-5c67-8243-2a903b40e108" :question/math-academy-id "q-119383" :question/problem "Given that $f(x,y)$ varies with both $x$ and $y,$ which of the following **cannot** be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(x,y)?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope field varies with both $x$ and $y.$\n\nOf the given slope fields, we note the following slope field does not vary with $x$ given a fixed value of $y.$\n\n![](images/9c/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png)\n\n \n\nTo see this more clearly, notice that if we draw a horizontal line, the slopes do not vary.\n\n![](images/9d/9d256bd6c44a9abc8489c360722b5c5e8243f0d4a9aa6fee03cad52e5334b385.png)"} {:db/id #edb/ref 17592186395465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1e8df4-9ee7-5f3f-87ce-6b27241b1f47" :answer/type {:db/ident :answer.type/image} :answer/value "images/58/58a69833c7b4f627c0cfd436f5ff624ea15dfc0f68d548e94b987794f06a58a0.png" :db/id #edb/ref 17592186395467} {:answer/id #uuid "bc6eb4ee-97c1-582b-8da7-2c61313e86ed" :answer/type {:db/ident :answer.type/image} :answer/value "images/41/4191f22560c393dacad29a06e34b7c725800e27554e2c4ad7a9e40d9e56741e6.png" :db/id #edb/ref 17592186395468} {:answer/id #uuid "0f2fa908-d317-59a8-b3b8-2b0d51743ef0" :answer/type {:db/ident :answer.type/image} :answer/value "images/e4/e45b8a64f56d831392ddc1eca4ddec922949d58e1c3f1f69c4db6238fe9a3200.png" :db/id #edb/ref 17592186395469} {:answer/id #uuid "f663747e-7bbd-55ad-b290-2459b37f9e69" :answer/type {:db/ident :answer.type/image} :answer/value "images/ab/ab73df79e9518f68e27860a1655867d092255e604666c4153f3d950b30410fc5.png" :db/id #edb/ref 17592186395470} {:answer/id #uuid "06ef197b-ec6b-5859-aeed-bb60ff22e391" :answer/type {:db/ident :answer.type/image} :answer/value "images/43/43d4b05227a0667420e6978f01671931fb2392fe39692400407708edc8c24987.png" :db/id #edb/ref 17592186395471}] :answer-field/correct {:answer/id #uuid "06ef197b-ec6b-5859-aeed-bb60ff22e391" :answer/type {:db/ident :answer.type/image} :answer/value "images/43/43d4b05227a0667420e6978f01671931fb2392fe39692400407708edc8c24987.png" :db/id #edb/ref 17592186395471} :answer-field/id #uuid "e5fb134a-fbef-51db-87b6-a286e83e96be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395466}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6e290eb2-4c30-594d-9303-2ef73ece0ff6" :question/math-academy-id "q-98231" :question/problem "Given that $f(x,y)$ varies with both $x$ and $y,$ which of the following **cannot** be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(x,y)?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope field varies with both $x$ and $y.$\n\nOf the given slope fields, we note the following slope field does not vary with $x$ given a fixed value of $y.$\n\n![](images/43/43d4b05227a0667420e6978f01671931fb2392fe39692400407708edc8c24987.png)\n\n \n\nTo see this more clearly, notice that if we draw a horizontal line, the slopes do not vary.\n\n![](images/71/718f65dc7f4ccab0931d04855c647bd39beffc014f1f389896edf83352fcc988.png)"}] :knowledge-point/title "Identifying a Possible Slope Field Based on the Type of Equation"}] [{:db/id #edb/ref 17592186172041 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171847 :question/id #uuid "ab9fe3df-7f60-55c5-b8af-810b0746993e" :question/math-academy-id "e-8576" :question/problem "Consider the differential equation $\\dfrac{\\textrm{d}y}{\\textrm{d}x}=(x+1)(y+1)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x \\gt -1$ and $y \\gt -1,$ the slope of the slope field is positive\n\n- At every point $(x,y)$ where $x \\lt -1$ and $y \\lt -1,$ the slope of the slope field is positive\n\n- At every point $(x,y)$ where $x \\gt -1$ and $y \\lt -1,$ the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y) = (x+1)(y+1).$ Then, our differential equation is $\\dfrac{\\textrm dy}{\\textrm d x} = f(x,y).$ \n\nNotice that $f(x,y) = 0$ when $x = -1$ or $y = -1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/e7/e7b398c7ff971e39b15980078232556d23866ab2f65a05b7d8df9a5f67b797dc.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/94/943ed7c12c71438d567da5ec901435bae1d3c7e576ba9b6c933d9fddc4e42b8f.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x \\gt -1$ and $y \\gt -1,$ then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in this region.\n\n- Statement II is true. If $x \\lt -1$ and $y \\lt -1,$ then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in this region.\n\n- Statement III is true. If $x \\gt -1$ and $y \\lt -1,$ then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\lt     0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x, y)$ in this region.\n\nTherefore, the correct answer is \"I, II, and III.\""} :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/questions [{:db/id #edb/ref 17592186172639 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c71a8e11-3808-53b6-bd23-65fd7fcd5550" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186171460} {:answer/id #uuid "12866de9-3edc-59a3-b95a-2ccf73d9c19a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186171461} {:answer/id #uuid "1da14450-0ccc-58cb-baa9-09a9454b2a88" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186171462} {:answer/id #uuid "2e5c8c2c-9c11-54a7-bc83-0f636d4ad4a4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186171463} {:answer/id #uuid "4f282a0e-df35-5fae-b43f-b6d35465926f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171464}] :answer-field/id #uuid "8897d65d-b234-5eff-84b6-9ed7672f819a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171459}] :question/id #uuid "4026efcc-47dd-5838-ae2e-6298d2d740c1" :question/math-academy-id "q-96475" :question/problem "Consider the differential equation $\\frac{dy}{dx} = (x - 1)(y + 2)$ and its slope field. Which of the following statements are true?\n\n1. At every point $(x, y)$ where $x > 1$ and $y > - 2$, the slope of the slope field is positive\n2. At every point $(x, y)$ where $x < 1$ and $y > - 2$, the slope of the slope field is positive\n3. At every point $(x, y)$ where $x > 1$ and $y < - 2$, the slope of the slope field is positive"} {:db/id #edb/ref 17592186172649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0034a4c6-10b3-508b-8a76-afcee44b5628" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186360829} {:answer/id #uuid "54b4ecb4-3c90-5cbd-8513-4c588703ab5f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186361213} {:answer/id #uuid "58ca3b2a-6a23-5aa0-8f8c-eb75ceef12c5" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186361240} {:answer/id #uuid "8c45f8d5-3f54-55ab-8e59-4b349667c905" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186361455} {:answer/id #uuid "c814eaaa-dc5e-5c70-a113-f897b76f031d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186361741}] :answer-field/correct {:answer/id #uuid "0034a4c6-10b3-508b-8a76-afcee44b5628" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186360829} :answer-field/id #uuid "0cb2fb3c-0491-59a7-9d61-fd56136a2903" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361989}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e86fafab-049b-51e4-93da-aada8761c377" :question/math-academy-id "q-97538" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x+1)^{2}(y-2)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<-1$ and $y>2,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<-1$ and $y<2,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>-1$ and $y<2,$ the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=(x+1)^{2}(y-2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=-1$ or $y=2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/1f/1f4b1b2ca736fb83eff0a4b85a3f479bf99b3b337492d0a77abe739038ed141f.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/fd/fdafadd1631a75c2998aaed5c6bad62a3ea1dcc0ac57d245a00d167e74aa3bb4.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x<-1$ and $y>2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is true. If $x<-1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x>-1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region."} {:db/id #edb/ref 17592186253604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67874484-f055-5bdc-9fd3-198a347a0744" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186251404} {:answer/id #uuid "824d5247-711d-581f-809a-1f19ab2773f2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251652} {:answer/id #uuid "8cd58f64-6603-57e8-94c4-71bbe1f72bfc" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251742} {:answer/id #uuid "bff29df0-de1b-5104-8784-d7457576de04" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252248} {:answer/id #uuid "d66c8ca7-023e-56a6-ae42-fb1c5bd76042" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252452}] :answer-field/correct {:answer/id #uuid "67874484-f055-5bdc-9fd3-198a347a0744" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186251404} :answer-field/id #uuid "9bb3e315-43fa-5de0-8cf7-3f0430b90376" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253077}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "635d0331-704b-5958-9f79-2f8d94fa4111" :question/math-academy-id "q-119797" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(2-x)(y+1)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x>2$ and $y<-1,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<2$ and $y<-1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x<2$ and $y>-1,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(2-x)(y+1).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=2$ or $y=-1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/ca/caa61190f1a5565c58838556529715c08f9f00402c6f4b3ccb99a914e748f198.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/01/01e91ecf01cfc64ed87e29081a6b9f8a3fc5afade1b25be08039b8778d981cf7.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x>2$ and $y<-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is true. If $x<2$ and $y<-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x<2$ and $y>-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186253605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b2c05c-45aa-52f2-926a-dfe4e47c4cb2" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186250577} {:answer/id #uuid "088934bb-2f89-5d2f-8bf7-d3aa09fc9883" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186250626} {:answer/id #uuid "aa0234ac-b1e7-5745-8e71-c415216e56b1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252023} {:answer/id #uuid "aca7731a-ce6a-5b20-93d0-7c22b7484036" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186252058} {:answer/id #uuid "c0a81237-6f56-5be3-abce-b5757d269f65" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186252254}] :answer-field/correct {:answer/id #uuid "c0a81237-6f56-5be3-abce-b5757d269f65" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186252254} :answer-field/id #uuid "e6178889-d0c3-5deb-a263-3cfc60399060" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253205}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dff46479-0340-5239-b8ff-db620f2c9a7a" :question/math-academy-id "q-119800" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(1-x)(y-2)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<1$ and $y>2,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>1$ and $y<2,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x<1$ and $y<2,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(1-x)(y-2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=1$ or $y=2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/47/47784a3201e93648e495827b12078073cc9f1a03cd3c11904a875bad10a3bde2.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/73/73631c178777b4489e35fa87d08474ccf2b8b484b9bf5fe7272b1ce25d45f1b0.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $x<1$ and $y>2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is false. If $x>1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement III is false. If $x<1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"None of those listed.\""} {:db/id #edb/ref 17592186253607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2869e252-5aad-5585-a2f8-08a41606bfde" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186250899} {:answer/id #uuid "54614a4d-c109-5408-909c-8c54b4b4c5c7" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251243} {:answer/id #uuid "b77ba196-db26-538f-8e5a-e02891425df4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252170} {:answer/id #uuid "cf547f70-e98c-5aed-bbd4-8b339b622658" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252383} {:answer/id #uuid "ff12155d-ea78-55f5-90a2-6de9c9364d1d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252794}] :answer-field/correct {:answer/id #uuid "54614a4d-c109-5408-909c-8c54b4b4c5c7" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251243} :answer-field/id #uuid "847c24e9-f310-5636-8ed5-8312caef5fb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253027}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2a6ca6d7-d1ef-5811-9457-4d7cf9a54890" :question/math-academy-id "q-119816" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x-2)^{2}(y+1)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<2$ and $y>-1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x<2$ and $y<-1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>2$ and $y>-1,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(x-2)^{2}(y+1).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=2$ or $y=-1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/ca/caa61190f1a5565c58838556529715c08f9f00402c6f4b3ccb99a914e748f198.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/d8/d836463631120853e05b3b5fb9e534822cf5611747a3eb17e22333901bfb8fd3.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $x<2$ and $y>-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is true. If $x<2$ and $y<-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x>2$ and $y>-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186360825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c2b8d12-985f-5154-b196-4a58e8731ec9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358149} {:answer/id #uuid "3d3ed46f-3efb-549c-a2ab-14a096238d27" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358277} {:answer/id #uuid "64e0c1d5-e5ab-579b-a3ac-99d6c3bef5ab" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358633} {:answer/id #uuid "bebe2100-c3d3-585f-9f76-603d3d573f45" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359419} {:answer/id #uuid "d052948e-dd52-545d-83a1-1e20f93fb082" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359576}] :answer-field/correct {:answer/id #uuid "3d3ed46f-3efb-549c-a2ab-14a096238d27" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358277} :answer-field/id #uuid "11862314-5f9a-560e-a90e-f4c4cc26ccfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360028}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a885d23a-7465-5389-b01f-26298ac26e61" :question/math-academy-id "q-97495" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x+2)(y+2)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x>-2$ and $y>-2,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<-2$ and $y>-2,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<-2$ and $y<-2,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(x+2)(y+2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=-2$ or $y=-2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/7d/7d225d82eee3043380eda76506b28e81aee06d42a232348b91b0d5ceb04f3318.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/bd/bd9eedd3b8d82415e8f3126236f2e3a3b4e326a7072057bbd21406da92a08139.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x>-2$ and $y>-2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is false. If $x<-2$ and $y>-2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x<-2$ and $y<-2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region."} {:db/id #edb/ref 17592186362211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572e882f-55e8-5f8c-bef9-e2ca43c5aa8e" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186361232} {:answer/id #uuid "b83920fb-1c4a-58a5-a3eb-19b04558fc77" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186361658} {:answer/id #uuid "dcdd71cd-9125-515e-beba-78871bd17934" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186361820} {:answer/id #uuid "df84b662-06bb-5956-b2b8-ed9d7dd03572" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186361835} {:answer/id #uuid "e141cef1-00b8-507b-905b-682a9ecc50de" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186361843}] :answer-field/correct {:answer/id #uuid "dcdd71cd-9125-515e-beba-78871bd17934" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186361820} :answer-field/id #uuid "cf7a3cd9-1c4a-5e27-aaba-915f6fb36210" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362171}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3ca0f65d-7276-53ff-adf8-200ee3f85dcc" :question/math-academy-id "q-97534" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x-1)(y-1)^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<1$ and $y<1,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x>1$ and $y<1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>1$ and $y>1,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(x-1)(y-1)^{2}.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=1$ or $y=1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/07/075264fa042adc64e160a83f03a2b125dd5a9b0927fc3ed318778c0004689ec4.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/57/5716d59a745fc148b504a4db523286d7c7209fe793fcf369a90d220125f7e9fb.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $x<1$ and $y<1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement II is false. If $x>1$ and $y<1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x>1$ and $y>1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region."}] :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] [{:db/id #edb/ref 17592186172083 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171889 :question/id #uuid "f0111439-4fd8-5add-b95f-5e783178fd63" :question/math-academy-id "e-9440" :question/problem "Draw a diagram that represents the vector field \n\n$$\n\\mathbf{F}(x,y)= -2xy \\, \\mathbf{i} + x^2 \\, \\mathbf{j}\n$$\n\n at the points $(-2,1), (-1,-2),$ and $(1,-1).$" :question/worked-solution "To sketch the vector field at the given points, we substitute their coordinates into the function $\\mathbf F(x,y) = -2xy \\, \\mathbf{i} + x^2 \\, \\mathbf{j} \\,\\mathbin{:}$\n\n$$\n\\begin{aligned}F(-2,1) & =-2(-2)(1)\\,i+(-2)^{2}\\,j=4\\,i+4\\,j \\\\ F(-1,-2) & =-2(-1)(-2)\\,i+(-1)^{2}\\,j=-4\\,i+j \\\\ F(1,-1) & =-2(1)(-1)\\,i+{1}^{2}\\,j=2\\,i+j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/cf/cf51cba8548d1f342a9dd5c06b533782feb955fca4b90adfac5b6988d7e2e470.png)"} :knowledge-point/id #uuid "a5b00f0c-fc7f-5262-b1a3-cdd6c1560cd6" :knowledge-point/questions [{:db/id #edb/ref 17592186172275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a92a7327-4920-5e27-9447-1c7bf838154d" :answer/type {:db/ident :answer.type/image} :answer/value "images/17/17e2a819903c4836cbf77cd117939be363525a6483082cede15ea73108231d46.png" :db/id #edb/ref 17592186168514} {:answer/id #uuid "e17373c4-5676-5b64-994a-a014b8fd8b99" :answer/type {:db/ident :answer.type/image} :answer/value "images/63/63543b3fb37cc73765bcd65d0bbbd575911bd672aa4f15b90ade19f4182b660e.png" :db/id #edb/ref 17592186168515} {:answer/id #uuid "1d55af91-f6ba-5a1e-8faf-0fe5df83e992" :answer/type {:db/ident :answer.type/image} :answer/value "images/54/54e21214507a8882e2b19130a8266c39a1b92252d54ae7ae4015a9494fce52a2.png" :db/id #edb/ref 17592186168516} {:answer/id #uuid "1e741758-8137-51f7-8727-2cfad442752f" :answer/type {:db/ident :answer.type/image} :answer/value "images/a2/a25f4c185e44773e8689785e04dc8d3c70a9934e8e02eee94a5c85061eebfd52.png" :db/id #edb/ref 17592186168517} {:answer/id #uuid "64618133-3b91-5a3a-ada3-c2b6802ed1f8" :answer/type {:db/ident :answer.type/image} :answer/value "images/f0/f074ea082192f9d653f8519f79dc05fb7c732f6c695444b167ce2417844b6a36.png" :db/id #edb/ref 17592186168518}] :answer-field/id #uuid "2b7d2410-bf2a-5ecd-956a-96e998dbd0fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168513}] :question/id #uuid "19719bc2-a844-5b6e-926d-79b5bdfa6933" :question/math-academy-id "q-122264" :question/problem "Which of the following diagrams represents the vector field $F(x, y) = x^{2}i - 2yj$ at the indicated points?"} {:db/id #edb/ref 17592186172286 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0a4588a-a70a-5752-b2c8-01cc42d39edf" :answer/type {:db/ident :answer.type/image} :answer/value "images/27/271bcaebb02bc573b2d6c3b00758387ff1a49787270c137f7e69ed3223e7de2b.png" :db/id #edb/ref 17592186168580} {:answer/id #uuid "3eb7e952-7f56-56d6-875d-d7fd08e13aac" :answer/type {:db/ident :answer.type/image} :answer/value "images/33/33c6c3680f3cab38ffd1508fad160948f3bc1159c01dc287b3fe113c0cf89875.png" :db/id #edb/ref 17592186168581} {:answer/id #uuid "5f0e3626-c59b-53de-817d-5c6c8128a918" :answer/type {:db/ident :answer.type/image} :answer/value "images/21/21fc0f3e9a2d5100421953ef2270de9d8a99fb395d761b4eb9a3f9f0e1889ac3.png" :db/id #edb/ref 17592186168582} {:answer/id #uuid "7951f9ae-9706-5dfa-82a5-3cfe79b73cef" :answer/type {:db/ident :answer.type/image} :answer/value "images/4d/4d3b3c7f1a3b85e40cec4392b4c487c5423636837ea2672c6cdcd6fdeb2b0cc7.png" :db/id #edb/ref 17592186168583} {:answer/id #uuid "7f0edf41-9f7f-55ea-993a-529370820e18" :answer/type {:db/ident :answer.type/image} :answer/value "images/1f/1f87c6b14dba3adad00c49362df7ba03bcbb6f990eba0302b