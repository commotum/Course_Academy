dddc2a6501aebf3.png" :db/id #edb/ref 17592186251141} {:answer/id #uuid "67864773-2b83-5fe7-b3c2-dd3f9cfc959e" :answer/type {:db/ident :answer.type/image} :answer/value "images/d4/d48911eaffd88e249ef115a5511bff979ffa0f848ef8a1e8556db07ad273e41a.png" :db/id #edb/ref 17592186251403} {:answer/id #uuid "99afecf9-aae7-5672-9f61-af699ce2e605" :answer/type {:db/ident :answer.type/image} :answer/value "images/a0/a0f75b52c741eca3322f4fe61009ba3c65e573f588edf9d3785019a1227f9769.png" :db/id #edb/ref 17592186251873} {:answer/id #uuid "b818a5b9-3cf1-501e-9730-c83f9f4f8530" :answer/type {:db/ident :answer.type/image} :answer/value "images/c7/c78c6d760cffb3dfb95233f9fc21dfea5a951371b056827885d1aa35469a458c.png" :db/id #edb/ref 17592186252174} {:answer/id #uuid "e6090260-0643-5bca-9ded-9404bb20dc1a" :answer/type {:db/ident :answer.type/image} :answer/value "images/4a/4afe9527d6ff39ce7f5325a4a35ce5095d9bf0b1beb2fcde4de86a977bdac9e8.png" :db/id #edb/ref 17592186252567}] :answer-field/correct {:answer/id #uuid "46aa0755-f688-51de-900d-6e595ccb40df" :answer/type {:db/ident :answer.type/image} :answer/value "images/5e/5e6b2df4680cea04cda42312659c76ba713a025150ebcc547dddc2a6501aebf3.png" :db/id #edb/ref 17592186251141} :answer-field/id #uuid "8d550c9d-12f7-57e8-8d00-8767a1fd0394" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253050}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2e87292a-2b40-5740-b2bc-7f066927b72e" :question/math-academy-id "q-119674" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{{y}^{2}}{x}?$" :question/worked-solution "We have to sketch the slope field at the points $(-1,-2),(2,-2)$ and $(2,2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-2)}=-\\frac{(-2)^{2}}{(-1)}=4, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,-2)}=-\\frac{(-2)^{2}}{2}=-2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,2)}=-\\frac{{2}^{2}}{2}=-2.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/5e/5e6b2df4680cea04cda42312659c76ba713a025150ebcc547dddc2a6501aebf3.png)"} {:db/id #edb/ref 17592186332777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081c395e-81a0-58ca-9b28-908fbc08890b" :answer/type {:db/ident :answer.type/image} :answer/value "images/9b/9bba5f86445177b9124813e85bf9294b7b566a029686f163c685663f5b352e30.png" :db/id #edb/ref 17592186330018} {:answer/id #uuid "6693c55b-1fbf-5e3a-bcc1-b97dd508708b" :answer/type {:db/ident :answer.type/image} :answer/value "images/3d/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png" :db/id #edb/ref 17592186330868} {:answer/id #uuid "a161b1e9-2046-5e54-8b93-40f73c498c97" :answer/type {:db/ident :answer.type/image} :answer/value "images/7a/7a550e346a2b31e09ec2dbfcf8eefe9a80108a74edffa92cb3a617643a810e31.png" :db/id #edb/ref 17592186331402} {:answer/id #uuid "cb04b6dd-6d28-5c58-a979-d60f59b78f97" :answer/type {:db/ident :answer.type/image} :answer/value "images/e5/e5b20b6b0ae17ca9ee891ec33efa93fd23f684e938b1527e56db01f11a2e53d8.png" :db/id #edb/ref 17592186331751} {:answer/id #uuid "e3217471-cfef-53f9-a6f4-33a3eafa2151" :answer/type {:db/ident :answer.type/image} :answer/value "images/a8/a87973b958bd7a598da127164fd77365daaf121a601c25d198f1a3256bd84f6d.png" :db/id #edb/ref 17592186331954}] :answer-field/correct {:answer/id #uuid "6693c55b-1fbf-5e3a-bcc1-b97dd508708b" :answer/type {:db/ident :answer.type/image} :answer/value "images/3d/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png" :db/id #edb/ref 17592186330868} :answer-field/id #uuid "498a90f9-7a3f-5e45-8a1f-e1f3e2ba683e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332325}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2935646c-b052-5fbf-9833-4d59c4cb2c23" :question/math-academy-id "q-49811" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2{x}^{2}-\\frac{1}{2}{y}^{2}?$" :question/worked-solution "We have to sketch the slope field at the points $(1,2),(1,0),$ and $(-1,-2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,2)}=2(1)^{2}-\\frac{1}{2}(2)^{2}=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,0)}=2(1)^{2}-\\frac{1}{2}(0)^{2}=2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-2)}=2(-1)^{2}-\\frac{1}{2}(-2)^{2}=0.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/3d/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png)"} {:db/id #edb/ref 17592186348396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188951c5-b647-59de-87db-4f6c6b426d9e" :answer/type {:db/ident :answer.type/image} :answer/value "images/c4/c4f19e6b424610387a8973b037c3f4636c09dba441ab1d6bd36dbe103d779a88.png" :db/id #edb/ref 17592186345567} {:answer/id #uuid "a08f9159-c1f0-5d9d-9faa-036322f0f4ff" :answer/type {:db/ident :answer.type/image} :answer/value "images/77/770f3089576cabd68f3c80b597eb4f15df279538c49853526b0ea123bc75af08.png" :db/id #edb/ref 17592186346754} {:answer/id #uuid "a91b1c88-e8a7-5b29-af5d-037d5dd16059" :answer/type {:db/ident :answer.type/image} :answer/value "images/82/8255d8370e49983ff0e37b5068a8a997de5eeadaedf7bd7869cf5dcd3c826ca1.png" :db/id #edb/ref 17592186346823} {:answer/id #uuid "b930def4-6682-5174-b08b-663fd943ac8f" :answer/type {:db/ident :answer.type/image} :answer/value "images/e1/e1ca6081e8077bcbc54de6a71e10ef1d278bbbc6b99842f1eee0d3dfcb71ebda.png" :db/id #edb/ref 17592186346959} {:answer/id #uuid "e88b14e0-794c-5f33-8cc8-2732ab08b857" :answer/type {:db/ident :answer.type/image} :answer/value "images/5b/5b77994fcd8b675c439a37e1b2049c0c6d266f12b3dc298b3183133b9010c818.png" :db/id #edb/ref 17592186347401}] :answer-field/correct {:answer/id #uuid "b930def4-6682-5174-b08b-663fd943ac8f" :answer/type {:db/ident :answer.type/image} :answer/value "images/e1/e1ca6081e8077bcbc54de6a71e10ef1d278bbbc6b99842f1eee0d3dfcb71ebda.png" :db/id #edb/ref 17592186346959} :answer-field/id #uuid "7fb0239c-d4e5-5a09-af6a-e5c0ec1b636b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347830}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a57b32c5-cfbb-5d77-9ba0-fa861f47a6d6" :question/math-academy-id "q-80499" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+2y}{4}?$" :question/worked-solution "We have to sketch the slope field at the points $(4,-2),(2,1),$ and $(-1,3).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(4,-2)}=\\frac{4+2(-2)}{4}=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,1)}=\\frac{2+2(1)}{4}=1, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,3)}=\\frac{-1+2(3)}{4}=\\frac{5}{4}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/e1/e1ca6081e8077bcbc54de6a71e10ef1d278bbbc6b99842f1eee0d3dfcb71ebda.png)"} {:db/id #edb/ref 17592186394009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e351540a-03e5-5560-8edb-4489b8437b6d" :answer/type {:db/ident :answer.type/image} :answer/value "images/32/327d6ae536cd6d76eff01387b51a4d2cc0522559d6ec6d02e3a86c2a3977f7b2.png" :db/id #edb/ref 17592186394011} {:answer/id #uuid "617858dc-e3d0-5878-95c3-a12969db50fb" :answer/type {:db/ident :answer.type/image} :answer/value "images/1b/1b8e42e667d2fe4c713e92f879c9894e826fdbe3e6928addb3c4b36ce71991e0.png" :db/id #edb/ref 17592186394012} {:answer/id #uuid "c7d0c0bb-d5d0-5d94-ac93-0530d2e8ddfa" :answer/type {:db/ident :answer.type/image} :answer/value "images/e7/e7e267508d68c1d4eeb31509a4a2957e120cecab920481ba6dc2b0fa1f84433b.png" :db/id #edb/ref 17592186394013} {:answer/id #uuid "4d512f05-dd97-5052-a1ea-cf88826055eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/3d/3ddcc5784dc1fd60ba3c95ecda373678d00fc6c45e6b5e5655febcc130c37d95.png" :db/id #edb/ref 17592186394014} {:answer/id #uuid "8caa0ceb-c764-5a3c-ad71-21838d736049" :answer/type {:db/ident :answer.type/image} :answer/value "images/25/2527ad3b4f6d0a1d84a9e907b5e3e9bddee439fbd17c2a1a4c3ca8c418f65293.png" :db/id #edb/ref 17592186394015}] :answer-field/correct {:answer/id #uuid "4d512f05-dd97-5052-a1ea-cf88826055eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/3d/3ddcc5784dc1fd60ba3c95ecda373678d00fc6c45e6b5e5655febcc130c37d95.png" :db/id #edb/ref 17592186394014} :answer-field/id #uuid "3a48c867-00e1-516c-a92b-1a0172abc1ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394010}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "be176ed2-61aa-5d12-9259-7d0a7e6c43ee" :question/math-academy-id "q-80497" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x-2y?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,-1),(2,-1),$ and $(2,1).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation. \n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,-1)}=(-2)-2(-1)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,-1)}=(2)-2(-1)=4, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,1)}=(2)-2(1)=0.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/6a/6a2d6f3812df2844171dacf1675d8e3d90167010cb2ffcf939f88d9cfcafe8a9.png)"} {:db/id #edb/ref 17592186395114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eec0e316-618a-5c06-8ef7-151ecbbb1a19" :answer/type {:db/ident :answer.type/image} :answer/value "images/bf/bfd9789a91f680d5105d9081e51103ffba5e986fa4a96331cde06df6d0c42854.png" :db/id #edb/ref 17592186395116} {:answer/id #uuid "e1a52671-312b-5bd4-be3f-4aa0a30f8a4a" :answer/type {:db/ident :answer.type/image} :answer/value "images/54/543365359599203eb6f9e8824f6e3b2987a1fec9121568dd7a9098bfc16870f1.png" :db/id #edb/ref 17592186395117} {:answer/id #uuid "ca1ba541-6bb3-5c12-a669-2035625bf666" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3edf063230f100455638fa25f28a4c5e59e2e54884d9e273724b76ae483aa0bc.png" :db/id #edb/ref 17592186395118} {:answer/id #uuid "956373bb-29e5-548d-9797-5b1c1b94804e" :answer/type {:db/ident :answer.type/image} :answer/value "images/63/631f9d7772354c6962f98e857371eac65d0fe36116bbae60dacd0db7ba01bc04.png" :db/id #edb/ref 17592186395119} {:answer/id #uuid "ce6386d1-d302-5559-a668-c92b3aa1ae83" :answer/type {:db/ident :answer.type/image} :answer/value "images/76/7670c9662fec950b45f2f939ed416590d278875b168caea9d7e5b70f7c8c6a9f.png" :db/id #edb/ref 17592186395120}] :answer-field/correct {:answer/id #uuid "e1a52671-312b-5bd4-be3f-4aa0a30f8a4a" :answer/type {:db/ident :answer.type/image} :answer/value "images/54/543365359599203eb6f9e8824f6e3b2987a1fec9121568dd7a9098bfc16870f1.png" :db/id #edb/ref 17592186395117} :answer-field/id #uuid "20d543f0-8732-53ef-a971-f59ec7730788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395115}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "53548ea4-2b92-5da8-9bc4-e7dc116ebef9" :question/math-academy-id "q-96089" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x+2y?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,1),(1,1),$ and $(2,1).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,1)}=-2+2(1)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)}=1+2(1)=3, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,1)}=2+2(1)=4.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/cc/cc55a08f71cd75f0dda356149a61e9ab78536ecbb4644b88f840122863b92b88.png)"}] :knowledge-point/title "Sketching the Slope Field of a Differential Equation at Some Isolated Points"}] [{:db/id #edb/ref 17592186172039 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171845 :question/id #uuid "0444de80-19f1-5251-b159-5dc55756bb19" :question/math-academy-id "e-8506" :question/problem "Consider the differential equation $\\dfrac{\\textrm{d}y}{\\textrm{d}x} = -2xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the second quadrant, the slope of the slope field is negative\n\n- At every point in the third quadrant, the slope of the slope field is negative\n\n- At every point in the fourth quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y) = -2xy.$ Then, our differential equation is $\\dfrac{\\textrm dy}{\\textrm d x} = f(x,y).$ \n\nNotice that $f(x,y) = 0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/2c/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in the second quadrant.\n\n- Statement II is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} = f(x,y)  \\lt     0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x, y)$ in the third quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} = f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"II and III only.\""} :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/questions [{:db/id #edb/ref 17592186172645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25870a81-3fb9-5fff-99c8-b31d4d47f4d4" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186358088} {:answer/id #uuid "68642bc1-1fe2-5046-b870-193c09a6307e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358667} {:answer/id #uuid "cd2617a6-8d55-50dd-989a-3c169e2d734f" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359556} {:answer/id #uuid "df64247d-9878-5db4-a2f5-6e04feb3019d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359713} {:answer/id #uuid "faeb364e-2dc9-5349-b448-291e24801481" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359968}] :answer-field/correct {:answer/id #uuid "68642bc1-1fe2-5046-b870-193c09a6307e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358667} :answer-field/id #uuid "b2c1922c-e541-58e2-b317-09d86b29b9aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360312}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fd7005de-da4a-5aae-a0ea-f0c01c178438" :question/math-academy-id "q-96767" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is positive\n- At every point in the second quadrant, the slope of the slope field is positive\n- At every point in the third quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=2xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\\,\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement II is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\\,\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement III is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\\,\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant."} {:db/id #edb/ref 17592186172648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81224000-258e-53da-b7de-824e60d2147f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186171514} {:answer/id #uuid "92deaf85-2e4a-58c8-afbc-75826f08c7cc" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186171515} {:answer/id #uuid "1797e5b1-06a1-56c3-9a5b-a773ed4f0f43" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186171516} {:answer/id #uuid "336428ca-3225-589d-b53c-4fb2f58b8b57" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186171517} {:answer/id #uuid "4690854a-c2f9-5351-b9d0-5d2ecc7078c0" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171518}] :answer-field/id #uuid "21d16917-92f0-50df-8d88-ad6deaea620a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171513}] :question/id #uuid "1142a38e-b72d-5615-beec-20a68972aab2" :question/math-academy-id "q-97483" :question/problem "Consider the differential equation $\\frac{dy}{dx} = xy^{2}$ and its slope field. Which of the following statements are true?\n\n1. At every point in the first quadrant, the slope of the slope field is negative\n2. At every point in the second quadrant, the slope of the slope field is negative\n3. At every point in the third quadrant, the slope of the slope field is negative"} {:db/id #edb/ref 17592186253595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4024098a-75c5-587d-98e5-611a840a3f6c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251084} {:answer/id #uuid "8147097f-9500-559a-b763-5d18c3c05977" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251642} {:answer/id #uuid "a7a788e3-0888-5b96-b5e8-fe59078e85ef" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251998} {:answer/id #uuid "cd7940fe-e009-5c39-a725-51edd2b4b231" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186252364} {:answer/id #uuid "f0c041f4-0069-51cc-8fc9-dc51958217c4" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252658}] :answer-field/correct {:answer/id #uuid "cd7940fe-e009-5c39-a725-51edd2b4b231" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186252364} :answer-field/id #uuid "9fd357ab-4cdd-5d88-8a4c-504651c08bf7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253087}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d92f1990-38b8-544d-a68e-c6daa48b1c4f" :question/math-academy-id "q-119766" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=6xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the second quadrant, the slope of the slope field is negative\n- At every point in the third quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=6xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement II is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"I, II, and III.\""} {:db/id #edb/ref 17592186253597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4db36eaf-4ffc-5508-9545-39fec25627c5" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186251198} {:answer/id #uuid "6331aaf5-ebd1-5fd0-ad5e-b1e8c26c6e19" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251365} {:answer/id #uuid "aafcb178-f3b0-5c69-9bdc-9bc95e9976a9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252035} {:answer/id #uuid "d9d0e8fa-1cf5-5319-a372-da5562830e04" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252470} {:answer/id #uuid "ec6c0656-e0b6-5034-a716-05d39e776c4f" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252624}] :answer-field/correct {:answer/id #uuid "d9d0e8fa-1cf5-5319-a372-da5562830e04" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252470} :answer-field/id #uuid "8a66e81b-e76c-50ef-ae46-b238872655c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253045}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e15411d6-1039-50b8-8bc5-cef852747aab" :question/math-academy-id "q-119769" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-5xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is positive\n- At every point in the second quadrant, the slope of the slope field is negative\n- At every point in the fourth quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=-5xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/2c/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement II is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"III only.\""} {:db/id #edb/ref 17592186253601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a23a81-0e8e-53d2-b379-e528d1f8ca4b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250576} {:answer/id #uuid "34932341-3fc4-5bc7-b98b-bed9117c110c" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186250991} {:answer/id #uuid "cdfd5dd1-e549-5276-98b4-315702b805e7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186252375} {:answer/id #uuid "dc95d7df-540b-546a-966a-318e0aec0168" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252494} {:answer/id #uuid "ea9b4280-c7f7-5fd9-a76d-21dd63f8825e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252605}] :answer-field/correct {:answer/id #uuid "ea9b4280-c7f7-5fd9-a76d-21dd63f8825e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252605} :answer-field/id #uuid "399483bc-9051-5872-9fc8-eef50e79e353" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252899}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c47e99b0-49b1-5362-97e1-164913960980" :question/math-academy-id "q-119774" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=8{x}^{2}{y}^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is negative\n- At every point in the third quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=8{x}^{2}{y}^{2}.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/d1/d1e4f48450a7f2032d755a5255d1a1e8a726dd16d273dae5dc1e587826d5ce58.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\n- Statement III is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186360821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abcd81a-04cb-5f3d-bf7c-5a40e77ab86c" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186357843} {:answer/id #uuid "3e21fd9a-73a3-5d42-a3b9-c321bdbf429d" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358284} {:answer/id #uuid "a3342c33-c4cb-5972-bbf0-844e548ec80f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359175} {:answer/id #uuid "c44ebec3-b543-5864-9138-301f48817447" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359474} {:answer/id #uuid "e8226eb9-9db7-5a3a-bfd4-98afbebcdfff" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359811}] :answer-field/correct {:answer/id #uuid "a3342c33-c4cb-5972-bbf0-844e548ec80f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359175} :answer-field/id #uuid "0bd3727a-c195-517b-9342-ead502eabf68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360018}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9ebbc31b-8f74-56d3-8d4f-392a8aeeda85" :question/math-academy-id "q-97477" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is positive\n- At every point in the second quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=-xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/2c/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement III is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant."} {:db/id #edb/ref 17592186360822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28b5050e-3c91-5b32-9608-4ab0f25924f8" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358123} {:answer/id #uuid "76c647bb-1c2b-57e9-adfb-6d297e840fe3" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358775} {:answer/id #uuid "a4e07eec-1263-52a0-96a2-6ff737753133" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359184} {:answer/id #uuid "b87644fd-16c8-57e7-b776-284f95840160" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359351} {:answer/id #uuid "d49b3f5c-06cf-55b9-a237-04e9fd017f63" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359608}] :answer-field/correct {:answer/id #uuid "a4e07eec-1263-52a0-96a2-6ff737753133" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359184} :answer-field/id #uuid "eae18750-fc4e-5ff6-8fa2-28c6515e1295" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360417}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ffe3a0e-6b8b-5f1d-8f45-5dd040381266" :question/math-academy-id "q-97482" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=9xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is negative\n- At every point in the second quadrant, the slope of the slope field is negative\n- At every point in the fourth quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=9xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement III is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the fourth quadrant."} {:db/id #edb/ref 17592186360823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aed349c-a347-5a86-af03-12b175ca7877" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186357845} {:answer/id #uuid "460e0de2-2390-5ea2-8980-253ff4e7d6cf" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358349} {:answer/id #uuid "548ecce6-afaf-59bb-8495-5247ba6afda1" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186358481} {:answer/id #uuid "70e078e9-6455-5918-b21a-0463a593ca59" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358737} {:answer/id #uuid "8191e2a0-724c-5a98-adc0-6786421ba6fe" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358883}] :answer-field/correct {:answer/id #uuid "548ecce6-afaf-59bb-8495-5247ba6afda1" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186358481} :answer-field/id #uuid "40412182-a1cd-5133-b52e-cabd6c830001" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360085}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "90e895ee-1be8-55c1-ab2d-a3596627f1b5" :question/math-academy-id "q-97487" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-4x{y}^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is negative\n- At every point in the second quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=-4x{y}^{2}.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/96/96c937cf10d45d8870a4a56e257d184dcf2e4caf11312c05df9f385f9c5ee7a8.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the fourth quadrant."}] :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] [{:db/id #edb/ref 17592186172040 :knowledge-point/canonical-example {:db/id #edb/ref 17592186171846 :question/id #uuid "3602a14d-6bd7-5586-a6e8-51d069dc8641" :question/math-academy-id "e-8507" :question/problem "Which of the following could be the slope field for the differential equation $\\dfrac{\\textrm d y}{\\textrm d x} = x+y?$ \n\n![](images/3b/3bd19865d2a1bb6bbb40c57112f269b51a3740d01da2c80b81db4eb84c6766f1.png)" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/54/543bb98ff948d1186e05d84db7992f9d5033ba4eaf47a9787b6b5664b88510a2.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/43/433f0cf3835465e7a0cca195f8b0f0b280984200d84f49533219f08967adc497.png)"} :knowledge-point/id #uuid "a2334101-5266-5853-aedf-04c85746b5cc" :knowledge-point/questions [{:db/id #edb/ref 17592186172640 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e7544c8-1881-562c-a26c-67a5f3ad2076" :answer/type {:db/ident :answer.type/image} :answer/value "images/b3/b3e3fd451b0ebb2b4eb614dd54f5193be179f8bdcf7d84191004ddb80e39b3f8.png" :db/id #edb/ref 17592186358016} {:answer/id #uuid "4b404c6e-5559-5f02-84c2-72074650e04f" :answer/type {:db/ident :answer.type/image} :answer/value "images/a3/a324b98fc4ec7a38ce6276a357a649751b316c0e61ddb193ce5f34caed608e98.png" :db/id #edb/ref 17592186358397} {:answer/id #uuid "bfc84bf1-4325-5c89-9a0a-6f20097f7793" :answer/type {:db/ident :answer.type/image} :answer/value "images/01/01cdcfc68fa5bf42f788b8ef9a099364ac6428457c40240bec101f18cb26ba01.png" :db/id #edb/ref 17592186359431} {:answer/id #uuid "c6c40e04-dba8-5b50-8824-d407b26a69b6" :answer/type {:db/ident :answer.type/image} :answer/value "images/37/37b6f122623a0f6952362446078958512ea57fb86aa04aa735b93487a7fdecb1.png" :db/id #edb/ref 17592186359500} {:answer/id #uuid "db446cd3-68d8-5b4e-8744-b1c105346c32" :answer/type {:db/ident :answer.type/image} :answer/value "images/d3/d3fc1db67353f797a60edd29987d01f6798bac25d98664845d9541635828410d.png" :db/id #edb/ref 17592186359670}] :answer-field/correct {:answer/id #uuid "4b404c6e-5559-5f02-84c2-72074650e04f" :answer/type {:db/ident :answer.type/image} :answer/value "images/a3/a324b98fc4ec7a38ce6276a357a649751b316c0e61ddb193ce5f34caed608e98.png" :db/id #edb/ref 17592186358397} :answer-field/id #uuid "79f71ba8-1e73-5288-aa74-8336d55348a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360194}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8e4e2c73-61a2-51eb-9aeb-b173fc18ef10" :question/math-academy-id "q-96476" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=xy?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/a3/a324b98fc4ec7a38ce6276a357a649751b316c0e61ddb193ce5f34caed608e98.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/9d/9d60c65cda12bb6ac800906e7889a8ecc395974dff0379130d647810c1623869.png)"} {:db/id #edb/ref 17592186172641 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "866243bf-f149-5fa2-95ed-23db86ef9c18" :answer/type {:db/ident :answer.type/image} :answer/value "images/98/989a9c0a5f720929dda562c4b8f64aa3cc84001d53ca2b3be8ad6cd53f458c5d.png" :db/id #edb/ref 17592186171472} {:answer/id #uuid "abcc77e5-1280-52fb-886a-7633a10799eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/43/43d4b05227a0667420e6978f01671931fb2392fe39692400407708edc8c24987.png" :db/id #edb/ref 17592186171473} {:answer/id #uuid "aeda3f8e-03ae-56a1-85d4-19b7a4ea1942" :answer/type {:db/ident :answer.type/image} :answer/value "images/78/78042a69ce4ac14b6d99455b32d40e35830efb1086a3c3fc05f705988b913b40.png" :db/id #edb/ref 17592186171474} {:answer/id #uuid "1199c78f-82c4-59d3-bd76-979d091ea864" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3e8b9711bda744d16af71f3c4ae6ddb4e2007f6dc2963c87f7d643831209b8c7.png" :db/id #edb/ref