dent :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{9{y}^{2}}{4}=1" :db/id #edb/ref 17592186339144} {:answer/id #uuid "4904f1fc-dc77-524c-af2d-813ee70dcc8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186339783} {:answer/id #uuid "a8efa69b-78be-5a02-81b6-baa9e8fedd59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186340664} {:answer/id #uuid "cdd060fa-0631-5438-80c1-f6c14e340129" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186340956} {:answer/id #uuid "d6c989e2-03ee-581f-83f6-e95b613b2103" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{9{y}^{2}}{4}=1" :db/id #edb/ref 17592186341033}] :answer-field/correct {:answer/id #uuid "4904f1fc-dc77-524c-af2d-813ee70dcc8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186339783} :answer-field/id #uuid "013f1fb3-558e-5ad1-b4b7-34a42443c53c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341385}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "65bcf244-fd2b-540c-b6fb-6b4c12786b6a" :question/math-academy-id "q-73619" :question/problem "![](images/86/8637901efc126236b190e7012cf65a06be078cb21c3093eff39b927493000138.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=1.5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1.5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{(\\frac{3}{2})}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{(\\frac{{3}^{2}}{{2}^{2}})} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{(\\frac{9}{4})} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81223159-c5d4-588d-9314-66a3a430542a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186369184} {:answer/id #uuid "b8e66f76-6ad4-5bdc-abf7-bebed8056693" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186369185} {:answer/id #uuid "634bfffa-5e14-55f7-a686-f6fb8d6cec2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{3}=1" :db/id #edb/ref 17592186369186} {:answer/id #uuid "e31e6823-8cbb-53ae-bb81-764ac833481b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186369187} {:answer/id #uuid "99c6a89a-45a4-5739-bf2f-f0c0f3684523" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{12}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186369188}] :answer-field/correct {:answer/id #uuid "b8e66f76-6ad4-5bdc-abf7-bebed8056693" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186369185} :answer-field/id #uuid "e4e6da79-a939-5e5c-a0d3-eb489cc25e8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369183}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5b02d1c4-7d7d-53ea-825a-e7c0df24295a" :question/math-academy-id "q-115108" :question/problem "![](images/93/93eeedaad213d62038239223