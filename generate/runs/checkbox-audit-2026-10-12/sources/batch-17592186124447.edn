#{[{:db/id #edb/ref 17592186124447 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124251 :question/id #uuid "67e9bcb5-4bf2-56b8-8d82-95355841eaaa" :question/math-academy-id "e-3150" :question/problem "Find the gradient of the product $f(x,y) g(x,y)$ given that \n\n$$\n\\begin{aligned}f(x,y) & =xy,\\, &  & ∇f(x,y)=y\\text{ }i+x\\text{ }j, &  &  \\\\ g(x,y) & =\\sqrt{xy},\\, &  & ∇g(x,y)=\\frac{\\sqrt{xy}}{2x}\\text{ }i+\\frac{\\sqrt{xy}}{2y}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n\\nabla [fg] = g \\, \\nabla\\! f  + f \\, \\nabla\\! g.\n$$\n\nUsing the product rule shown above, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =\\sqrt{xy}(y\\text{ }i+x\\text{ }j)+xy(\\frac{\\sqrt{xy}}{2x}\\text{ }i+\\frac{\\sqrt{xy}}{2y}\\text{ }j) \\\\  & =\\sqrt{xy}(y\\text{ }i+x\\text{ }j)+\\frac{\\sqrt{xy}}{2}(y\\text{ }i+x\\text{ }j) \\\\  & =\\frac{3\\sqrt{xy}}{2}(y\\text{ }i+x\\text{ }j).\\end{aligned}\n$$"} :knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/questions [{:db/id #edb/ref 17592186124954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f8e544-1ea9-599e-974a-71d2d151a87f" :answer/type {:db/ident :answer.type/math} :answer/value "(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j" :db/id #edb/ref 17592186321442} {:answer/id #uuid "348405b8-ded5-5a35-a88c-d99faa23725d" :answer/type {:db/ident :answer.type/math} :answer/value "-16x{y}^{3}\\text{ }i+12{x}^{4}y\\text{ }j" :db/id #edb/ref 17592186321545} {:answer/id #uuid "5942edfe-58e8-5af7-8cfa-2852eccc2bef" :answer/type {:db/ident :answer.type/math} :answer/value "(2{x}^{3}{y}^{2}-x{y}^{3})\\text{ }i+({x}^{4}y-2{x}^{2}{y}^{2})\\text{ }j" :db/id #edb/ref 17592186321851} {:answer/id #uuid "6e8e1067-ba7b-54fb-af35-6a7524d7c253" :answer/type {:db/ident :answer.type/math} :answer/value "24{x}^{3}{y}^{2}-16x{y}^{3}+12{x}^{4}y-24{x}^{2}{y}^{2}" :db/id #edb/ref 17592186322003} {:answer/id #uuid "85783609-ce00-565d-bb5e-3dd88e517710" :answer/type {:db/ident :answer.type/math} :answer/value "(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }i+(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }j" :db/id #edb/ref 17592186322203}] :answer-field/correct {:answer/id #uuid "25f8e544-1ea9-599e-974a-71d2d151a87f" :answer/type {:db/ident :answer.type/math} :answer/value "(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j" :db/id #edb/ref 17592186321442} :answer-field/id #uuid "6498a189-6a46-5093-a0ab-23fe9a246ff1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323370}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7958e50f-73b4-5252-b8f0-e891d3332089" :question/math-academy-id "q-36144" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & =3{x}^{2}-4y,\\, &  & ∇g(x,y)=6x\\text{ }i-4\\text{ }j, &  &  \\\\ h(x,y) & =2{x}^{2}{y}^{2},\\, &  & ∇h(x,y)=4x{y}^{2}\\text{ }i+4{x}^{2}y\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[gh]=h\\,∇\\,g+g\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =2{x}^{2}{y}^{2}(6x\\text{ }i-4\\text{ }j)+(3{x}^{2}-4y)(4x{y}^{2}\\text{ }i+4{x}^{2}y\\text{ }j) \\\\  & =(2{x}^{2}{y}^{2}\\cdot 6x\\text{ }i-2{x}^{2}{y}^{2}\\cdot 4\\text{ }j)+((3{x}^{2}-4y)\\cdot 4x{y}^{2}\\text{ }i+(3{x}^{2}-4y)\\cdot 4{x}^{2}y\\text{ }j) \\\\  & =12{x}^{3}{y}^{2}\\text{ }i-8{x}^{2}{y}^{2}\\text{ }j+(12{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-16{x}^{2}{y}^{2})\\text{ }j \\\\  & =(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186125073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "823cc20e-f86a-5020-9707-c46b0aebe5ff" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2}\\ln y(2\\ln x + 1)i + x^{2}\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123039} {:answer/id #uuid "2149104b-9ef4-58ae-9dd2-d0090b43d4b4" :answer/type {:db/ident :answer.type/math} :answer/value "xy^{2}\\ln y(2\\ln x + 1)i + x^{2}y\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123040} {:answer/id #uuid "237aa152-79aa-59ca-9da8-d11107a70f8c" :answer/type {:db/ident :answer.type/math} :answer/value "xy^{2}\\ln y(\\ln x + 1)i + x^{2}y\\ln x(\\ln y + 1)j" :db/id #edb/ref 17592186123041} {:answer/id #uuid "4598fee0-272e-5114-8a2c-ded49201d59a" :answer/type {:db/ident :answer.type/math} :answer/value "2xy^{2}\\ln x\\ln yi + 2x^{2}y\\ln x\\ln yj" :db/id #edb/ref 17592186123042} {:answer/id #uuid "62496431-e87b-55ac-959c-a35896635b84" :answer/type {:db/ident :answer.type/math} :answer/value "xy\\ln y(2\\ln x + 1)i + xy\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123043}] :answer-field/id #uuid "570aa897-a887-5746-b026-d89e242c332b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123038}] :question/id #uuid "5428db75-6dff-5dda-b472-e2a79932ad02" :question/math-academy-id "q-37466" :question/problem "What is the gradient of the product $f(x, y)g(x, y)$ if $f(x, y) = \\ln x\\ln y$ and $g(x, y) = x^{2}y^{2}$?"} {:db/id #edb/ref 17592186262920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d1fe3ce-e39c-5f48-af02-f843ac8fe12f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186260280} {:answer/id #uuid "45a436bb-d9d3-5ae2-86cd-61af704fb4ec" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186260482} {:answer/id #uuid "8143f91a-8754-5cf9-b946-da41a6f966ab" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}(y(1-2{x}^{2})\\text{ }i+x(1+2{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186261002} {:answer/id #uuid "8b667d91-bb69-5253-9d69-5052dedca4a2" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}(x(1-{y}^{2})\\text{ }i+xy(1-{x}^{2})\\text{ }j)" :db/id #edb/ref 17592186261091} {:answer/id #uuid "c13fe910-b536-5489-9442-be8cb1a3b3de" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({x}^{2}(1+{y}^{2})\\text{ }i+2{y}^{2}(1+{x}^{2})\\text{ }j)" :db/id #edb/ref 17592186261582}] :answer-field/correct {:answer/id #uuid "2d1fe3ce-e39c-5f48-af02-f843ac8fe12f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186260280} :answer-field/id #uuid "7821d5ef-cff7-57a3-8006-a2f8c44afc3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262323}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "76e2d854-0d75-5d56-8dc4-994bd31ca49e" :question/math-academy-id "q-128521" :question/problem "What is the gradient of the product $f(x,y)g(x,y)$ if $f(x,y)=x{y}^{2}$ and $g(x,y)={e}^{-({x}^{2}+{y}^{2})}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=f∇g+g∇f.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{y}^{2})={y}^{2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{y}^{2})=2xy\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={y}^{2}\\text{ }i+2xy\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({e}^{-({x}^{2}+{y}^{2})})=-2x{e}^{-({x}^{2}+{y}^{2})} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({e}^{-({x}^{2}+{y}^{2})})=-2y{e}^{-({x}^{2}+{y}^{2})}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇g(x,y) & =\\frac{∂g}{∂x}\\text{ }i+\\frac{∂g}{∂y}\\text{ }j=-2x{e}^{-({x}^{2}+{y}^{2})}\\text{ }i-2y{e}^{-({x}^{2}+{y}^{2})}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =x{y}^{2}(-2x{e}^{-({x}^{2}+{y}^{2})}\\text{ }i-2y{e}^{-({x}^{2}+{y}^{2})}\\text{ }j)+{e}^{-({x}^{2}+{y}^{2})}({y}^{2}\\text{ }i+2xy\\text{ }j) \\\\  & ={e}^{-({x}^{2}+{y}^{2})}(-2{x}^{2}{y}^{2}\\text{ }i-2x{y}^{3}\\text{ }j)+{e}^{-({x}^{2}+{y}^{2})}({y}^{2}\\text{ }i+2xy\\text{ }j) \\\\  & ={e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f78169-2f44-5c43-87d6-b815be978a5a" :answer/type {:db/ident :answer.type/math} :answer/value "3x\\,i+{y}^{2}\\,j-2xy\\,k" :db/id #edb/ref 17592186260207} {:answer/id #uuid "296e6ebc-12ce-58be-b45b-a814a6ab10d3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}\\,i+3xy\\,k" :db/id #edb/ref 17592186260240} {:answer/id #uuid "38efeb4c-9bd1-5acf-ab43-dafd337eae24" :answer/type {:db/ident :answer.type/math} :answer/value "x\\,i-2xz\\,k" :db/id #edb/ref 17592186260381} {:answer/id #uuid "bbf61748-52a6-5ede-9896-0da38336b843" :answer/type {:db/ident :answer.type/math} :answer/value "{z}^{2}\\,j+2yz\\,k" :db/id #edb/ref 17592186261530} {:answer/id #uuid "ea736859-5ca3-578a-b099-b7d2e3d293b1" :answer/type {:db/ident :answer.type/math} :answer/value "x\\,i-{z}^{2}\\,j-2yz\\,k" :db/id #edb/ref 17592186261932}] :answer-field/correct {:answer/id #uuid "bbf61748-52a6-5ede-9896-0da38336b843" :answer/type {:db/ident :answer.type/math} :answer/value "{z}^{2}\\,j+2yz\\,k" :db/id #edb/ref 17592186261530} :answer-field/id #uuid "e3a18160-dc2f-533e-9be0-793491ff920c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262526}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "13103db1-962a-564a-a73e-3a0e51d17668" :question/math-academy-id "q-128529" :question/problem "Find the gradient of the product $f(x,y,z)h(x,y,z),$ given that \n\n$$\n\\begin{aligned}f(x,y,z) & =x{y}^{2}{z}^{3},\\, &  & ∇f(x,y,z)={y}^{2}{z}^{3}\\,i+2xy{z}^{3}\\,j+3x{y}^{2}{z}^{2}\\,k, &  &  \\\\ h(x,y,z) & =\\frac{1}{xyz},\\, &  & ∇h(x,y,z)=-\\frac{1}{{x}^{2}yz}\\,i-\\frac{1}{x{y}^{2}z}\\,j-\\frac{1}{xy{z}^{2}}\\text{ }k. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[fh]=h∇f+f∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)h(x,y,z)] & =h(x,y,z)∇f(x,y,z)+f(x,y,z)∇h(x,y,z) \\\\  & =\\frac{1}{xyz}({y}^{2}{z}^{3}\\,i+2xy{z}^{3}\\,j+3x{y}^{2}{z}^{2}\\,k)+x{y}^{2}{z}^{3}(-\\frac{1}{{x}^{2}yz}\\,i-\\frac{1}{x{y}^{2}z}\\,j-\\frac{1}{xy{z}^{2}}\\,k) \\\\  & =\\frac{{y}^{2}{z}^{3}}{xyz}\\,i+\\frac{2xy{z}^{3}}{xyz}\\,j+\\frac{3x{y}^{2}{z}^{2}}{xyz}\\,k-\\frac{x{y}^{2}{z}^{3}}{{x}^{2}yz}\\,i-\\frac{x{y}^{2}{z}^{3}}{x{y}^{2}z}\\,j-\\frac{x{y}^{2}{z}^{3}}{xy{z}^{2}}\\,k \\\\  & =\\frac{y{z}^{2}}{x}\\,i+2{z}^{2}\\,j+3yz\\,k-\\frac{y{z}^{2}}{x}\\,i-{z}^{2}\\,j-yz\\,k \\\\  & ={z}^{2}\\,j+2yz\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ef7585-f490-52ce-84d4-c14afbd71f8c" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{ln}⁡(xy)+2)\\text{ }i+x(\\operatorname{ln}⁡(xy)+2)\\text{ }j" :db/id #edb/ref 17592186333143} {:answer/id #uuid "21b12eb3-67b9-5f76-80f9-150884fc0d5e" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j" :db/id #edb/ref 17592186333290} {:answer/id #uuid "3ea7c594-0a56-5e0b-a1fd-7fd5413db99e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(xy)\\text{ }i-y\\operatorname{ln}⁡(xy)\\text{ }j" :db/id #edb/ref 17592186333580} {:answer/id #uuid "f9a4ec80-da82-5689-8ecb-e79e98294b6f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(xy)\\text{ }i+y\\operatorname{ln}⁡(xy)\\text{ }j" :db/id #edb/ref 17592186335176} {:answer/id #uuid "fe69f0a9-435b-5c17-9a63-9c54c8b0d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(xy)\\text{ }i+x\\operatorname{ln}⁡(xy)\\text{ }j" :db/id #edb/ref 17592186335228}] :answer-field/correct {:answer/id #uuid "21b12eb3-67b9-5f76-80f9-150884fc0d5e" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j" :db/id #edb/ref 17592186333290} :answer-field/id #uuid "c8f1d221-bfab-57b4-bd66-7eea20107505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "838d032d-5600-5cb9-9af4-36cc70864ee1" :question/math-academy-id "q-65131" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =xy,\\, &  & ∇f(x,y)=y\\text{ }i+x\\text{ }j, &  &  \\\\ g(x,y) & =\\operatorname{ln}⁡(xy),\\, &  & ∇g(x,y)=\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by:\n\n$$\n∇[fg]=g\\,∇\\,f+f\\,∇\\,g\n$$\n\nSo, using this product rule we obtain: \n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(\\operatorname{ln}⁡(xy))(y\\text{ }i+x\\text{ }j)+xy(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j) \\\\  & =y\\operatorname{ln}⁡(xy)\\text{ }i+x\\operatorname{ln}⁡(xy)\\text{ }j+y\\text{ }i+x\\text{ }j \\\\  & =[y\\operatorname{ln}⁡(xy)\\text{ }i+y\\text{ }i]+[x\\operatorname{ln}⁡(xy)\\text{ }j+x\\text{ }j] \\\\  & =y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23400f54-8b3f-5ebc-b598-c7818f4586c2" :answer/type {:db/ident :answer.type/math} :answer/value "y\\text{ }i+x\\text{ }j" :db/id #edb/ref 17592186336361} {:answer/id #uuid "34196f13-9af3-5e84-930f-7cdc02f6b4ef" :answer/type {:db/ident :answer.type/math} :answer/value "x\\text{ }i+y\\text{ }j" :db/id #edb/ref 17592186336521} {:answer/id #uuid "78b044f0-5569-5fa2-b926-c4fa16e63d1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i+\\text{ }j" :db/id #edb/ref 17592186337118} {:answer/id #uuid "86424757-d1c0-5142-865b-bc737655d636" :answer/type {:db/ident :answer.type/math} :answer/value "-\\text{ }i+\\text{ }j" :db/id #edb/ref 17592186337246} {:answer/id #uuid "8a45146a-092c-5746-a1f7-52f22a8062eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i-\\text{ }j" :db/id #edb/ref 17592186337277}] :answer-field/correct {:answer/id #uuid "78b044f0-5569-5fa2-b926-c4fa16e63d1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i+\\text{ }j" :db/id #edb/ref 17592186337118} :answer-field/id #uuid "0fa16c79-d297-52a5-b07c-cccb5e15aa03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338305}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "91443473-cbb1-5ab2-b98b-379cda895777" :question/math-academy-id "q-71476" :question/problem "Find the gradient of the product $f(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & ={x}^{2}y+x{y}^{2},\\, &  & ∇f(x,y)=(2xy+{y}^{2})\\text{ }i+({x}^{2}+2xy)\\text{ }j, &  &  \\\\ h(x,y) & =\\frac{1}{xy},\\, &  & ∇h(x,y)=-\\frac{1}{{x}^{2}y}\\text{ }i-\\frac{1}{x{y}^{2}}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=h\\,∇\\,f+f\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =h(x,y)∇f(x,y)+f(x,y)∇h(x,y) \\\\  & =\\frac{1}{xy}((2xy+{y}^{2})\\text{ }i+({x}^{2}+2xy)\\text{ }j)+({x}^{2}y+x{y}^{2})(-\\frac{1}{{x}^{2}y}\\text{ }i-\\frac{1}{x{y}^{2}}\\text{ }j) \\\\  & =(\\frac{2xy+{y}^{2}}{xy}\\text{ }i+\\frac{{x}^{2}+2xy}{xy}\\text{ }j)+(-\\frac{{x}^{2}y+x{y}^{2}}{{x}^{2}y}\\text{ }i-\\frac{{x}^{2}y+x{y}^{2}}{x{y}^{2}}\\text{ }j) \\\\  & =(\\frac{2x+y}{x}\\text{ }i+\\frac{x+2y}{y}\\text{ }j)+(-\\frac{x+y}{x}\\text{ }i-\\frac{x+y}{y}\\text{ }j) \\\\  & =(-\\frac{x+y}{x}+\\frac{2x+y}{x})\\text{ }i+(-\\frac{x+y}{y}+\\frac{x+2y}{y})\\text{ }j \\\\  & =\\text{ }i+\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763b5a77-6493-5261-b8d3-54d89d3556f5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy+2x-3y)\\,i-({x}^{2}-3xy+3x)\\,j)" :db/id #edb/ref 17592186383106} {:answer/id #uuid "35f70d4c-b368-5785-8f2b-55de44f7f968" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}((2x-3y)\\,i-3x\\,j)" :db/id #edb/ref 17592186383107} {:answer/id #uuid "02ee0e10-1bfe-5fcd-b946-23648b7beb03" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy-y)\\,i+({x}^{2}+3xy+3x)\\,j)" :db/id #edb/ref 17592186383108} {:answer/id #uuid "00dc6b24-907b-54d8-b5de-b9d4002d1f43" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy-2x-3y)\\,i+({x}^{2}+3xy+3x)\\,j)" :db/id #edb/ref 17592186383109} {:answer/id #uuid "b3105e5f-7b64-505a-a465-56ea29d0bb91" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy)\\,i-3x\\,j)" :db/id #edb/ref 17592186383110}] :answer-field/correct {:answer/id #uuid "763b5a77-6493-5261-b8d3-54d89d3556f5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy+2x-3y)\\,i-({x}^{2}-3xy+3x)\\,j)" :db/id #edb/ref 17592186383106} :answer-field/id #uuid "864fbb12-509a-5c57-bdf6-96d7c651bd26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383105}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fb82a957-3ae8-5e58-8924-0d152fcf4c22" :question/math-academy-id "q-128532" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & ={e}^{x-y},\\, &  & ∇g(x,y)={e}^{x-y}\\,i-{e}^{x-y}\\,j, &  &  \\\\ h(x,y) & ={x}^{2}-3xy,\\, &  & ∇h(x,y)=(2x-3y)\\,i-3x\\,j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[gh]=h∇g+g∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =({x}^{2}-3xy)({e}^{x-y}\\,i-{e}^{x-y}\\,j)+{e}^{x-y}((2x-3y)\\,i-3x\\,j) \\\\  & =(({x}^{2}-3xy){e}^{x-y}\\,i-({x}^{2}-3xy){e}^{x-y}\\,j)+((2x-3y){e}^{x-y}\\,i-3x{e}^{x-y}\\,j) \\\\  & ={e}^{x-y}({x}^{2}-3xy+2x-3y)\\,i-{e}^{x-y}({x}^{2}-3xy+3x)\\,j \\\\  & ={e}^{x-y}(({x}^{2}-3xy+2x-3y)\\,i-({x}^{2}-3xy+3x)\\,j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be7f21f4-cabe-54eb-bc85-93d694a5ed38" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{2}+2x){e}^{xy}\\text{ }i+({x}^{2}+{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385552} {:answer/id #uuid "4ec1d0e5-cc37-5321-849e-8e1b3950c06b" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385553} {:answer/id #uuid "3ad1fd13-781b-5d24-9468-b6d312c780db" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385554} {:answer/id #uuid "f82a086d-2718-5c14-b976-c8999ecd57bb" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x)\\text{ }i+({x}^{3}+x{y}^{2}+2y)\\text{ }j" :db/id #edb/ref 17592186385555} {:answer/id #uuid "2e9d2f1c-dc91-5316-9ad5-65fd3a68e1cd" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{xy}\\text{ }i+2y{e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385556}] :answer-field/correct {:answer/id #uuid "3ad1fd13-781b-5d24-9468-b6d312c780db" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385554} :answer-field/id #uuid "e3b75486-11a8-5732-8e0c-87ceee70a576" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385551}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "48290c67-cc9b-570f-83c1-2b1af7db25a9" :question/math-academy-id "q-71484" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & ={e}^{xy},\\, &  & ∇g(x,y)=y{e}^{xy}\\text{ }i+x{e}^{xy}\\text{ }j, &  &  \\\\ h(x,y) & ={x}^{2}+{y}^{2},\\, &  & ∇h(x,y)=2x\\text{ }i+2y\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[gh]=h\\,∇\\,g+g\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =({x}^{2}+{y}^{2})(y{e}^{xy}\\text{ }i+x{e}^{xy}\\text{ }j)+{e}^{xy}(2x\\text{ }i+2y\\text{ }j) \\\\  & =(({x}^{2}+{y}^{2})y{e}^{xy}\\text{ }i+({x}^{2}+{y}^{2})x{e}^{xy}\\text{ }j)+(2x{e}^{xy}\\text{ }i+2y{e}^{xy}\\text{ }j) \\\\  & =({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186437018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caf56146-05fe-53cc-92f2-a535ba4943df" :answer/type {:db/ident :answer.type/math} :answer/value "(x+y)y{e}^{xy}\\text{ }i+x(x+y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186436998} {:answer/id #uuid "d2acb1a7-39df-54ef-82c2-34bde846d73e" :answer/type {:db/ident :answer.type/math} :answer/value "(x+y){e}^{x+y}\\text{ }i+(x+y){e}^{x+y}\\text{ }j" :db/id #edb/ref 17592186436999} {:answer/id #uuid "df8dc6a7-9339-5e43-b61c-4513120ec263" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)y{e}^{x}\\text{ }i+x(1+y){e}^{y}\\text{ }j" :db/id #edb/ref 17592186437001} {:answer/id #uuid "f072c200-9d5e-5ac5-b478-4233e499425f" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)y{e}^{x+y}\\text{ }i+x(1+y){e}^{x+y}\\text{ }j" :db/id #edb/ref 17592186437005} {:answer/id #uuid "f9e6b982-9c47-56e1-8b69-4a1e0179c1d1" :answer/type {:db/ident :answer.type/math} :answer/value "xy{e}^{xy}\\text{ }i+(x+1)(1+y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186437007}] :answer-field/correct {:answer/id #uuid "f072c200-9d5e-5ac5-b478-4233e499425f" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)y{e}^{x+y}\\text{ }i+x(1+y){e}^{x+y}\\text{ }j" :db/id #edb/ref 17592186437005} :answer-field/id #uuid "90c23b7b-1640-5aaa-b8b3-64340afb293e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437012}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5961ee6e-358e-5baa-837e-dbd941cc54b6" :question/math-academy-id "q-71515" :question/problem "What is the gradient of the product $f(x,y)h(x,y)$ if $f(x,y)=x{e}^{y}$ and $h(x,y)=y{e}^{x}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=f\\,∇\\,h+h\\,∇\\,f\\,\\,\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{e}^{y})={e}^{y} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{e}^{y})=x{e}^{y}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={e}^{y}\\text{ }i+x{e}^{y}\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(y{e}^{x})=y{e}^{x} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(y{e}^{x})={e}^{x}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇h(x,y) & =\\frac{∂h}{∂x}\\text{ }i+\\frac{∂h}{∂y}\\text{ }j=y{e}^{x}\\text{ }i+{e}^{x}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =x{e}^{y}(y{e}^{x}\\text{ }i+{e}^{x}\\text{ }j)+y{e}^{x}({e}^{y}\\text{ }i+x{e}^{y}\\text{ }j) \\\\  & =xy{e}^{x+y}\\text{ }i+x{e}^{x+y}\\text{ }j+y{e}^{x+y}\\text{ }i+xy{e}^{x+y}\\text{ }j \\\\  & =(x+1)y{e}^{x+y}\\text{ }i+x(1+y){e}^{x+y}\\text{ }j\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] [{:db/id #edb/ref 17592186124454 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124258 :question/id #uuid "a01560be-9023-593a-87d3-7412f3b208a3" :question/math-academy-id "e-3362" :question/problem "Given the function $f(x,y) = 6x^2+2y^2 - 2xy^2,$ find the equation of the tangent line to the level curve that passes through the point where $(x,y) = (3,3).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y) = k$ at the point $(x_0,y_0)$ can be expressed as\n\n$$\n\\nabla f(x_0,y_0) \\cdot \\langle x-x_0, \\: y-y_0 \\rangle  = 0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y) = (3,3)\\mathbin{:}$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\text{ }i+{f}_{y}(x,y)\\text{ }j \\\\  & =\\frac{∂}{∂x}(6{x}^{2}+2{y}^{2}-2x{y}^{2})\\text{ }i+\\frac{∂}{∂y}(6{x}^{2}+2{y}^{2}-2x{y}^{2})\\text{ }j \\\\  & =(12x-2{y}^{2})\\text{ }i+(4y-4xy)\\text{ }j \\\\ ∇\\,f(3,3) & =(12(3)-2(3)^{2})i+(4(3)-4(3)(3))j \\\\  & =18\\,i-24\\,j \\\\  & =⟨18,-24⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent to the level curve that passes through the point $(x_0,y_0)=(3,3)$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(3,3)\\cdot ⟨x-3,\\,y-3⟩ & =0 \\\\ ⟨18,-24⟩\\cdot ⟨x-3,\\,y-3⟩ & =0.\\end{aligned}\n$$\n\nWe can leave our answer in this form. Or, if we want to leave our final answer in Cartesian form, we expand the dot product and simplify:\n\n$$\n\\begin{aligned}18(x-3)-24(y-3) & =0 \\\\ 18x-24y+18 & =0 \\\\ 3x-4y+3 & =0\\end{aligned}\n$$\n\n![](images/10/102f55fe0add794d3ee0f9f044b5e35c4403d4f160fe36e97d737d33ef3abb68.png)"} :knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/questions [{:db/id #edb/ref 17592186124979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "880dbacb-028a-561a-b827-9b8d23398589" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-1⟩ \\cdot ⟨x + 1, y - 1⟩ = 0" :db/id #edb/ref 17592186122475} {:answer/id #uuid "eea120f5-6b01-590f-a495-58069c019bdb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5, 3⟩ \\cdot ⟨x + 1, y - 1⟩ = 0" :db/id #edb/ref 17592186122476} {:answer/id #uuid "186d36a1-ef7f-5df9-898e-5c21ca1e411f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5, 4⟩ \\cdot ⟨x + 1, y - 1⟩ = 0" :db/id #edb/ref 17592186122477} {:answer/id #uuid "1a23c037-a94f-5827-814e-e63f6001d36c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 4,-5⟩ \\cdot ⟨x + 1, y - 1⟩ = 0" :db/id #edb/ref 17592186122478} {:answer/id #uuid "2e27fd9a-d984-5263-b543-88b22a5fa2f6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6, 2⟩ \\cdot ⟨x + 1, y - 1⟩ = 0" :db/id #edb/ref 17592186122479}] :answer-field/id #uuid "cbade43c-aee7-5def-a760-a6555c7e377c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122474}] :question/id #uuid "6ecf0fad-2e50-567b-a7b0-a4806d471317" :question/math-academy-id "q-36383" :question/problem "Given the function $f(x, y) = 3x^{2} + 2xy^{2} - y$, find the equation of the tangent line to the level curve that passes through the point where $(x, y) = (-1, 1)$."} {:db/id #edb/ref 17592186125075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cfb60c5a-84f6-579a-bf8c-8a6c56d5d89c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 1⟩ \\cdot ⟨x - \\sqrt{π}, y - 2⟩ = 0" :db/id #edb/ref 17592186123051} {:answer/id #uuid "eafc3ef7-13a4-5982-aca8-f0cf9eb309b4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6, 9⟩ \\cdot ⟨x - \\sqrt{π}, y - 2⟩ = 0" :db/id #edb/ref 17592186123052} {:answer/id #uuid "235a3491-4b91-5459-8922-ea5faa29313d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨36, 0⟩ \\cdot ⟨x - \\sqrt{π}, y - 2⟩ = 0" :db/id #edb/ref 17592186123053} {:answer/id #uuid "7422fc2c-561d-530d-89b3-bc543c859506" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 12⟩ \\cdot ⟨x - \\sqrt{π}, y - 2⟩ = 0" :db/id #edb/ref 17592186123054} {:answer/id #uuid "7fa883bd-b0b4-5d35-aa6a-26142de534a4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-36⟩ \\cdot ⟨x - \\sqrt{π}, y - 2⟩ = 0" :db/id #edb/ref 17592186123055}] :answer-field/id #uuid "912b4db0-e052-5337-99c9-aff6e5410f1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123050}] :question/id #uuid "6369bf45-c149-5591-b6da-b79b10114d99" :question/math-academy-id "q-37517" :question/problem "Given the function $f(x, y) = \\cos (x^{2}) - 3y^{3}$, find the equation of the tangent line to the level curve that passes through the point where $(x, y) = (\\sqrt{π}, 2)$."} {:db/id #edb/ref 17592186265823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053d7683-eb2b-524a-8f48-34c58516b514" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,0⟩\\cdot ⟨x+1,\\,y⟩=0" :db/id #edb/ref 17592186263046} {:answer/id #uuid "107f9a00-2ab2-5ddd-bcac-9802763a9723" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,1⟩\\cdot ⟨x+1,\\,y⟩=0" :db/id #edb/ref 17592186263152} {:answer/id #uuid "680b9d63-4091-5ae1-8e3f-46a7c9d43e8e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1⟩\\cdot ⟨x+1,\\,y⟩=0" :db/id #edb/ref 17592186263897} {:answer/id #uuid "dfe4251a-b496-5eb8-8465-e83d73fba9d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0⟩\\cdot ⟨x+1,\\,y⟩=0" :db/id #edb/ref 17592186264944} {:answer/id #uuid "ff129e04-8125-5957-a2fe-9be8a804d26a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-2⟩\\cdot ⟨x+1,\\,y⟩=0" :db/id #edb/ref 17592186265243}] :answer-field/correct {:answer/id #uuid "dfe4251a-b496-5eb8-8465-e83d73fba9d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0⟩\\cdot ⟨x+1,\\,y⟩=0" :db/id #edb/ref 17592186264944} :answer-field/id #uuid "afefeac9-9210-5ff6-a466-d566f40851cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "54ba14c7-96f4-538f-92f9-9aee3ad220a5" :question/math-academy-id "q-130096" :question/problem "Given the function $f(x,y)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1),$ find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(-1,0).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-1,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1))\\,j \\\\  & =\\frac{2x}{{x}^{2}+{y}^{2}+1}\\,i+\\frac{2y}{{x}^{2}+{y}^{2}+1}\\,j \\\\ ∇f(-1,0) & =\\frac{2(-1)}{(-1)^{2}+{0}^{2}+1}\\,i+\\frac{2(0)}{(-1)^{2}+{0}^{2}+1}\\,j \\\\  & =(-1)i+0\\,j \\\\  & =⟨-1,0⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(-1,0)\\cdot ⟨x-(-1),\\,y-0⟩ & =0 \\\\ ⟨-1,0⟩\\cdot ⟨x+1,\\,y⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fa62eab-b90e-5a48-abaf-f85a91f5acd1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,0⟩\\cdot ⟨x+1,\\,y+1⟩=0" :db/id #edb/ref 17592186263290} {:answer/id #uuid "62b1fd5a-785c-5c0d-b89b-dc81b75e19f5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1⟩\\cdot ⟨x+1,\\,y+1⟩=0" :db/id #edb/ref 17592186263851} {:answer/id #uuid "a52310bc-e27c-5255-928c-7b85e9ff51e1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,4⟩\\cdot ⟨x+1,\\,y+1⟩=0" :db/id #edb/ref 17592186264412} {:answer/id #uuid "bb1bcd1d-dd9d-5585-a7f9-07a54fc0555d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,1⟩\\cdot ⟨x+1,\\,y+1⟩=0" :db/id #edb/ref 17592186264626} {:answer/id #uuid "f2dab8b3-8a9a-56d3-9061-2a98e26196d2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-6⟩\\cdot ⟨x+1,\\,y+1⟩=0" :db/id #edb/ref 17592186265134}] :answer-field/correct {:answer/id #uuid "f2dab8b3-8a9a-56d3-9061-2a98e26196d2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-6⟩\\cdot ⟨x+1,\\,y+1⟩=0" :db/id #edb/ref 17592186265134} :answer-field/id #uuid "b246b7e5-0c53-5a83-ad21-caca0e7a4743" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265561}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a7c798f0-d19a-5ddc-9430-afe4c5122532" :question/math-academy-id "q-130104" :question/problem "Given the function $f(x,y)={x}^{2}-4xy+5{y}^{2}$ find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(-1,-1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}-4xy+5{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}-4xy+5{y}^{2})\\,j \\\\  & =(2x-4y)\\,i+(10y-4x)\\,j \\\\ ∇f(-1,-1) & =(2(-1)-4(-1))\\,i+(10(-1)-4(-1))\\,j \\\\  & =2\\,i-6\\,j \\\\  & =⟨2,-6⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(-1,-1)\\cdot ⟨x-(-1),\\,y-(-1)⟩ & =0 \\\\ ⟨2,-6⟩\\cdot ⟨x+1,\\,y+1⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a942dfb1-22bb-50b2-98f2-430b4650b212" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,5⟩\\cdot ⟨x-1,\\,y-2⟩=0" :db/id #edb/ref 17592186337559} {:answer/id #uuid "cfff2df5-b768-59eb-8a42-e88ece513035" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,10⟩\\cdot ⟨x-1,\\,y-2⟩=0" :db/id #edb/ref 17592186337851} {:answer/id #uuid "d9eb05eb-aff7-5ff4-a1a3-c9872358aa4c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-10,15⟩\\cdot ⟨x-1,\\,y-2⟩=0" :db/id #edb/ref 17592186337929} {:answer/id #uuid "f6a6cdf3-2c19-59a7-a21a-bd11e399318c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨15,10⟩\\cdot ⟨x-1,\\,y-2⟩=0" :db/id #edb/ref 17592186338196} {:answer/id #uuid "fc4820c5-0c22-53d7-866f-01894b830fd0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,5⟩\\cdot ⟨x-1,\\,y-2⟩=0" :db/id #edb/ref 17592186338247}] :answer-field/correct {:answer/id #uuid "fc4820c5-0c22-53d7-866f-01894b830fd0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,5⟩\\cdot ⟨x-1,\\,y-2⟩=0" :db/id #edb/ref 17592186338247} :answer-field/id #uuid "acd1dce1-2f9e-5620-9964-a61a6eed12b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338593}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "36039f0f-02eb-5e5b-b0c3-c0ef4b9dcb59" :question/math-academy-id "q-72371" :question/problem "Given the function $f(x,y)={x}^{2}{y}^{2}+xy$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,2).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as \n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,2):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+xy)\\,i+\\frac{∂}{∂y}({x}^{2}{y}^{2}+xy)\\,j \\\\  & =(2x{y}^{2}+y)\\,i+(2y{x}^{2}+x)\\,j \\\\ ∇\\,f(1,2) & =(2(1)(2)^{2}+(2))\\,i+(2(2)(1)^{2}+(1))\\,j \\\\  & =10\\,i+5\\,j \\\\  & =⟨10,5⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,2)\\cdot ⟨x-1,\\,y-2⟩ & =0 \\\\ ⟨10,5⟩\\cdot ⟨x-1,\\,y-2⟩ & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8440b232-2d79-53cd-bad6-36fe06f0e97a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,0⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388078} {:answer/id #uuid "fec3679d-d002-508a-b44e-896ae847115f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388079} {:answer/id #uuid "d41769d3-a85e-5a1d-b0d2-621fb6f6adf3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388080} {:answer/id #uuid "8d510eb4-4bca-58e9-bca7-c33fc8cc7f6f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388081} {:answer/id #uuid "112648f6-f22c-57a0-8ebb-0ebd53decbdd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388082}] :answer-field/correct {:answer/id #uuid "112648f6-f22c-57a0-8ebb-0ebd53decbdd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388082} :answer-field/id #uuid "b68b09e4-9252-5d68-ab26-fe3cc2a6e217" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388077}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c1bed00-c1da-539a-bd7b-b11b7bf684ae" :question/math-academy-id "q-130094" :question/problem "Given the function $f(x,y)=x{y}^{2}-x+y,$ find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,-1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-x+y)\\,i+\\frac{∂}{∂y}(x{y}^{2}-x+y)\\,j \\\\  & =({y}^{2}-1)\\text{ }i+(2xy+1)\\text{ }j \\\\ ∇f(1,-1) & =((-1)^{2}-1)\\,i+(2(1)(-1)+1)\\,j \\\\  & =0\\,i-j \\\\  & =⟨0,-1⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,-1)\\cdot ⟨x-1,\\,y-(-1)⟩ & =0 \\\\ ⟨0,-1⟩\\cdot ⟨x-1,\\,y+1⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f817dec0-31ee-5a90-a6ae-2391b9cf9403" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,2⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393210} {:answer/id #uuid "d27aae8e-1b41-5a3d-9baf-285744999d7e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393211} {:answer/id #uuid "1898f2e5-1406-5cc8-82d7-46e5635ddabe" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393212} {:answer/id #uuid "4d956027-e0b5-5ae7-a8b7-35ca7afa539e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,3⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393213} {:answer/id #uuid "9b764f7f-086e-5989-aeae-04810e887220" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393214}] :answer-field/correct {:answer/id #uuid "9b764f7f-086e-5989-aeae-04810e887220" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393214} :answer-field/id #uuid "d2b7a822-706f-59e1-aaeb-ea5e1255d429" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393209}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "85c3a288-e595-578f-a534-db75ed9d872f" :question/math-academy-id "q-72377" :question/problem "Given the function $f(x,y)=2x{y}^{2}+xy+2x$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2x{y}^{2}+xy+2x)\\,i+\\frac{∂}{∂y}(2x{y}^{2}+xy+2x)\\,j \\\\  & =(2{y}^{2}+y+2)\\,i+(4xy+x)\\,j \\\\ ∇\\,f(1,1) & =(2(1)^{2}+(1)+2)\\,i+(4(1)(1)+(1))\\,j \\\\  & =5\\,i+5\\,j \\\\  & =⟨5,5⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,1)\\cdot ⟨x-1,\\,y-1⟩ & =0 \\\\ ⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩ & =0\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] [{:db/id #edb/ref 17592186124455 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124259 :question/id #uuid "f6400ab7-3684-5f0d-b8f0-1c85b0b322ec" :question/math-academy-id "e-3363" :question/problem "Consider the plane curve $x^2-3xy+4y=2.$ Find a tangent vector to the curve at the point $(1,1).$" :question/worked-solution "First, if we set $f(x,y) = x^2-3xy+4y,$ our curve can be viewed as the level curve $f(x,y)=2.$ \n\nA tangent vector to the level curve that passes through the point $(1,1)$ can be computed as follows:\n\n$$\n\\mathbf t(1,1) = f_y(1,1) \\ \\mathbf i - f_x(1,1) \\ \\mathbf j\n$$\n\nSo, we calculate $\\mathbf t(x,y)$ and evaluate it at $(1,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}({x}^{2}-3xy+4y)\\text{ }i-\\frac{∂}{∂x}({x}^{2}-3xy+4y)\\text{ }j \\\\  & =(-3x+4)\\text{ }i-(2x-3y)\\text{ }j \\\\ t(1,1) & =(-3(1)+4)\\text{ }i-(2(1)-3(1))\\text{ }j \\\\  & =1\\,i-(-1)\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $\\mathbf i +\\mathbf j,$ as shown in the diagram below.\n\n![](images/01/0114bf524d085402bd27178d687a5faf176b7147c8e8726b84042b17823b6b0b.png)"} :knowledge-point/id #uuid "348fa49f-2af8-5562-91f6-3f70bb93ea90" :knowledge-point/questions [{:db/id #edb/ref 17592186124980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adfa4a9b-088c-5d4c-a06a-f83cff46387a" :answer/type {:db/ident :answer.type/math} :answer/value "6i + 2j" :db/id #edb/ref 17592186122481} {:answer/id #uuid "bc43c78b-b71e-59cc-86a1-ed21b4906ff7" :answer/type {:db/ident :answer.type/math} :answer/value "2i - 6j" :db/id #edb/ref 17592186122482} {:answer/id #uuid "166843cc-f599-540c-a895-790beb61e4f8" :answer/type {:db/ident :answer.type/math} :answer/value "6i" :db/id #edb/ref 17592186122483} {:answer/id #uuid "4c8d92ed-bd29-5e78-ac9c-40789085eb1c" :answer/type {:db/ident :answer.type/math} :answer/value "6i - j" :db/id #edb/ref 17592186122484} {:answer/id #uuid "75ba95d3-ccdd-5335-bc47-1bc87a3a2f26" :answer/type {:db/ident :answer.type/math} :answer/value "3i + 2j" :db/id #edb/ref 17592186122485}] :answer-field/id #uuid "ea33b86b-0147-5727-9ec2-461d7ee2b6cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122480}] :question/id #uuid "d538882c-b1cd-5192-bbe8-86de583ea5af" :question/math-academy-id "q-36391" :question/problem "Consider the plane curve $x^{2}y = xy + 4$. Find a tangent vector to that curve at the point $(2, 2)$."} {:db/id #edb/ref 17592186125191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb45de19-662d-5d40-8c9f-bbab41e8b53e" :answer/type {:db/ident :answer.type/math} :answer/value "i + \\frac{π}{2}j" :db/id #edb/ref 17592186123747} {:answer/id #uuid "2a2d68dc-8a02-5aaf-bc95-d03534713413" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π}{2}i + j" :db/id #edb/ref 17592186123748} {:answer/id #uuid "5a8566cd-85af-5590-bb6a-4011fa8ce372" :answer/type {:db/ident :answer.type/math} :answer/value "-i - j" :db/id #edb/ref 17592186123749} {:answer/id #uuid "74712c7b-e3ca-5c16-8204-9da1f79907ba" :answer/type {:db/ident :answer.type/math} :answer/value "-i + \\frac{π}{2}j" :db/id #edb/ref 17592186123750} {:answer/id #uuid "78e79b08-e49f-5790-abb9-6e44dbd739b1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π}{2}i - j" :db/id #edb/ref 17592186123751}] :answer-field/id #uuid "5a0a667c-f1d0-53cf-8fc5-a0a93a5313b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123746} {:answer-field/choices [{:answer/id #uuid "323ab6d8-7707-5cf4-a618-ba17b3923dd9" :answer/type {:db/ident :answer.type/math} :answer/value "-i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364297} {:answer/id #uuid "043f0c6b-beee-5929-91a6-329b0aba6cab" :answer/type {:db/ident :answer.type/math} :answer/value "i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364298} {:answer/id #uuid "6c7f3a73-6bb3-57e1-b890-8a39b32ac5a3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}\\,i+j" :db/id #edb/ref 17592186364299} {:answer/id #uuid "b9bd5e2f-eea5-58c3-8f18-2c41ef884348" :answer/type {:db/ident :answer.type/math} :answer/value "-i-j" :db/id #edb/ref 17592186364300} {:answer/id #uuid "cb787b13-c2e5-5275-b510-4a2ee9675a16" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}\\,i-j" :db/id #edb/ref 17592186364301}] :answer-field/correct {:answer/id #uuid "323ab6d8-7707-5cf4-a618-ba17b3923dd9" :answer/type {:db/ident :answer.type/math} :answer/value "-i+\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186364297} :answer-field/id #uuid "4633732e-7712-5dd5-9f2e-d57d7262b765" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364296}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ad74cdc7-0885-5bf3-989d-0d3835ead91a" :question/math-academy-id "q-65204" :question/problem "Consider the plane curve $\\operatorname{cos}⁡x\\operatorname{cos}⁡y=\\operatorname{sin}⁡(xy).$ Find a tangent vector to that curve at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x\\operatorname{cos}⁡y & =\\operatorname{sin}⁡xy \\\\ \\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy) & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡xy$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(0,\\frac{\\pi }{2})$ can be computed as follows:\n\n$$\nt(0,\\frac{\\pi }{2})={f}_{y}(0,\\frac{\\pi }{2})i-{f}_{x}(0,\\frac{\\pi }{2})j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(0,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,i-\\frac{∂}{∂x}(\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡(xy))\\,j \\\\  & =(-\\operatorname{cos}⁡x\\operatorname{sin}⁡y-x\\operatorname{cos}⁡(xy))i-(-\\operatorname{sin}⁡x\\operatorname{cos}⁡y-y\\operatorname{cos}⁡(xy))\\,j \\\\ t(0,\\frac{\\pi }{2}) & =(-\\operatorname{cos}⁡(0)\\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))i-(-\\operatorname{sin}⁡(0)\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{2}\\operatorname{cos}⁡(0\\cdot \\frac{\\pi }{2}))j \\\\  & =-i+\\frac{\\pi }{2}\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i+\\frac{\\pi }{2}\\,j.$"} {:db/id #edb/ref 17592186265852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab7ecfb-6837-5f43-a7dc-5de26787b651" :answer/type {:db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186263102} {:answer/id #uuid "23c6bb01-4817-5934-b31c-f94122a313f8" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\,i+j" :db/id #edb/ref 17592186263311} {:answer/id #uuid "4d97af51-08fe-5c7f-90df-c14d7845e35f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}\\,i+j" :db/id #edb/ref 17592186263672} {:answer/id #uuid "96b21983-40a1-5c92-8a77-84386b07a32d" :answer/type {:db/ident :answer.type/math} :answer/value "-i-\\frac{\\pi }{2}\\,j" :db/id #edb/ref 17592186264290} {:answer/id #uuid "eae56032-740f-556c-b1d0-0bf3c280086c" :answer/type {:db/ident :answer.type/math} :answer/value "i+2\\,j" :db/id #edb/ref 17592186265047}] :answer-field/correct {:answer/id #uuid "0ab7ecfb-6837-5f43-a7dc-5de26787b651" :answer/type {:db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186263102} :answer-field/id #uuid "86808a14-0099-527e-bba9-8dfc049cb102" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265481}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1e97b736-408e-55e1-a895-d40d15156508" :question/math-academy-id "q-130198" :question/problem "Consider the plane curve $x\\operatorname{cos}⁡y=-y\\operatorname{sin}⁡x+\\frac{\\pi }{2}.$ Find a tangent vector to that curve at the point $(\\frac{\\pi }{2},0).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡y & =-y\\operatorname{sin}⁡x+\\frac{\\pi }{2} \\\\ x\\operatorname{cos}⁡y+y\\operatorname{sin}⁡x & =\\frac{\\pi }{2}\\end{aligned}\n$$\n\nIf we set $f(x,y)=x\\operatorname{cos}⁡y+y\\operatorname{sin}⁡x,$ our curve can be viewed as the level curve $f(x,y)=\\frac{\\pi }{2}.$ \n\nA tangent vector to the level curve that passes through the point $(\\frac{\\pi }{2},0)$ can be computed as follows:\n\n$$\nt(\\frac{\\pi }{2},0)={f}_{y}(\\frac{\\pi }{2},0)i-{f}_{x}(\\frac{\\pi }{2},0)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(\\frac{\\pi }{2},0):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡y+y\\operatorname{sin}⁡x)i-\\frac{∂}{∂x}(x\\operatorname{cos}⁡y+y\\operatorname{sin}⁡x)j \\\\  & =(-x\\operatorname{sin}⁡y+\\operatorname{sin}⁡x)i-(\\operatorname{cos}⁡y+y\\operatorname{cos}⁡x)j \\\\ t(\\frac{\\pi }{2},0) & =(-\\frac{\\pi }{2}\\operatorname{sin}⁡0+\\operatorname{sin}⁡(\\frac{\\pi }{2}))i-(\\operatorname{cos}⁡0+0\\operatorname{cos}⁡(\\frac{\\pi }{2}))j \\\\  & =i-j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $i-j.$"} {:db/id #edb/ref 17592186265853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db8855f-407d-543c-b41c-01ec8863c250" :answer/type {:db/ident :answer.type/math} :answer/value "i+{e}^{2}\\,j" :db/id #edb/ref 17592186263273} {:answer/id #uuid "310e7ac2-6457-50a9-b85b-62fe72227f50" :answer/type {:db/ident :answer.type/math} :answer/value "i-e\\,j" :db/id #edb/ref 17592186263418} {:answer/id #uuid "313c22eb-142a-5e0a-bbf7-3e694214c7e6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i" :db/id #edb/ref 17592186263420} {:answer/id #uuid "3ef9f166-57a7-581f-b069-feefd3a089a9" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186263557} {:answer/id #uuid "66d4bf27-1916-5b14-ad54-71713514a6d7" :answer/type {:db/ident :answer.type/math} :answer/value "2e\\,i+j" :db/id #edb/ref 17592186263890}] :answer-field/correct {:answer/id #uuid "310e7ac2-6457-50a9-b85b-62fe72227f50" :answer/type {:db/ident :answer.type/math} :answer/value "i-e\\,j" :db/id #edb/ref 17592186263418} :answer-field/id #uuid "c0fb381c-a4a1-50c1-8a16-52f23963275a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265583}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b37d7050-f209-536a-923e-f6a34554696d" :question/math-academy-id "q-130200" :question/problem "Consider the plane curve $x{e}^{{y}^{2}+1}=e-y.$ Find a tangent vector to that curve at the point $(1,0).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{e}^{{y}^{2}+1} & =e-y \\\\ x{e}^{{y}^{2}+1}+y & =e\\end{aligned}\n$$\n\nIf we set $f(x,y)=x{e}^{{y}^{2}+1}+y,$ our curve can be viewed as the level curve $f(x,y)=e.$ \n\nA tangent vector to the level curve that passes through the point $(1,0)$ can be computed as follows:\n\n$$\nt(1,0)={f}_{y}(1,0)i-{f}_{x}(1,0)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,0):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(x{e}^{{y}^{2}+1}+y)i-\\frac{∂}{∂x}(x{e}^{{y}^{2}+1}+y)j \\\\  & =(2xy{e}^{{y}^{2}+1}+1)i-{e}^{{y}^{2}+1}\\,j \\\\ t(1,0) & =(2(1)(0){e}^{0+1}+1)i-{e}^{0+1}\\,j \\\\  & =i-e\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $i-e\\,j.$"} {:db/id #edb/ref 17592186323918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cbb66c-c87e-532e-b215-79cebdd50220" :answer/type {:db/ident :answer.type/math} :answer/value "(2e-8)\\,i+(\\frac{e}{2}-8)j" :db/id #edb/ref 17592186321343} {:answer/id #uuid "25737ab8-5934-517a-82e3-355f226249ae" :answer/type {:db/ident :answer.type/math} :answer/value "(1-4e)\\,i+(\\frac{2}{e}-8)j" :db/id #edb/ref 17592186321438} {:answer/id #uuid "569fd915-b891-5273-a763-b23c030c775d" :answer/type {:db/ident :answer.type/math} :answer/value "(2-8e)\\,i+(2-8e)j" :db/id #edb/ref 17592186321831} {:answer/id #uuid "91bfacf0-e81a-591f-b5c7-eb843413fffc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{e}-8)i+(8e-2)\\,j" :db/id #edb/ref 17592186322304} {:answer/id #uuid "e6c24a19-a0b8-5781-9f03-f3684c7d7f7c" :answer/type {:db/ident :answer.type/math} :answer/value "(8-2e)\\,i+(\\frac{8}{e}-2)j" :db/id #edb/ref 17592186322954}] :answer-field/correct {:answer/id #uuid "91bfacf0-e81a-591f-b5c7-eb843413fffc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{e}-8)i+(8e-2)\\,j" :db/id #edb/ref 17592186322304} :answer-field/id #uuid "2328f82b-ecf4-5e93-897c-028b4fd16484" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323237}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "12b276e2-b703-55f7-94b8-069326b3f510" :question/math-academy-id "q-37516" :question/problem "Consider the plane curve $2x\\operatorname{ln}⁡y=8xy+2-8e.$ Find a tangent vector to that curve at the point $(1,e).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡y & =8xy+2-8e \\\\ 2x\\operatorname{ln}⁡y-8xy & =2-8e\\end{aligned}\n$$\n\nIf we set $f(x,y)=2x\\operatorname{ln}⁡y-8xy$, our curve can be viewed as the level curve $f(x,y)=2-8e.$ \n\nA tangent vector to the level curve that passes through the point $(1,e)$ can be computed as follows:\n\n$$\nt(1,e)={f}_{y}(1,e)\\,i-{f}_{x}(1,e)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,e):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2x\\operatorname{ln}⁡y-8xy)\\,i-\\frac{∂}{∂x}(2x\\operatorname{ln}⁡y-8xy)\\,j \\\\  & =(\\frac{2x}{y}-8x)i-(2\\operatorname{ln}⁡y-8y)\\,j \\\\ t(1,e) & =(\\frac{2(1)}{e}-8(1))i-(2\\operatorname{ln}⁡e-8(e))\\,j \\\\  & =(\\frac{2}{e}-8)i+(8e-2)j\\end{aligned}\n$$\n\n  \n\nTherefore, our tangent vector is $(\\frac{2}{e}-8)i+(8e-2)\\,j.$"} {:db/id #edb/ref 17592186339107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a7f7daf-eab5-5f09-9994-fb78510d1452" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,i+6\\,j" :db/id #edb/ref 17592186336857} {:answer/id #uuid "5bdf6205-616a-5fe8-bae1-1eafc7069834" :answer/type {:db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186336867} {:answer/id #uuid "5f640f70-dd55-53af-a444-45f3d1013ded" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i-j" :db/id #edb/ref 17592186336897} {:answer/id #uuid "6d1b9f33-c38c-59c8-99f2-2467570782ed" :answer/type {:db/ident :answer.type/math} :answer/value "i+6\\,j" :db/id #edb/ref 17592186337000} {:answer/id #uuid "9f2d1ea8-f373-5f19-800d-34e70ba82c85" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i-6\\,j" :db/id #edb/ref 17592186337470}] :answer-field/correct {:answer/id #uuid "5a7f7daf-eab5-5f09-9994-fb78510d1452" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,i+6\\,j" :db/id #edb/ref 17592186336857} :answer-field/id #uuid "31c46a4e-d03a-5a5a-b5e5-3a014deba440" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338371}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "148b9435-dbdc-5e2a-8580-1b7906c6cec6" :question/math-academy-id "q-72400" :question/problem "Consider the plane curve ${x}^{2}+{y}^{2}=2xy+9.$ Find a tangent vector to that curve at the point $(-1,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2xy+9 \\\\ {x}^{2}+{y}^{2}-2xy-9 & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}-2xy-9$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(-1,2)$ can be computed as follows:\n\n$$\nt(-1,2)={f}_{y}(-1,2)\\,i-{f}_{x}(-1,2)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,2):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}-2xy-9)\\,i-\\frac{∂}{∂x}({x}^{2}+{y}^{2}-2xy-9)\\,j \\\\  & =(2y-2x)\\,i-(2x-2y)\\,j \\\\ t(-1,2) & =(2(2)-2(-1))\\,i-(2(-1)-2(2))\\,j \\\\  & =6\\,i+6\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $6\\,i+6\\,j.$"} {:db/id #edb/ref 17592186339122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a24f4b8-a184-5828-8c72-dcc5b94e5943" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,i-5\\,j" :db/id #edb/ref 17592186336423} {:answer/id #uuid "2afed586-1f6a-50fd-ad21-c54f17e514f5" :answer/type {:db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186336436} {:answer/id #uuid "af297190-71a7-5741-8317-95edf63e83e2" :answer/type {:db/ident :answer.type/math} :answer/value "i+5\\,j" :db/id #edb/ref 17592186337604} {:answer/id #uuid "be71b2b4-857d-5122-ac95-bc07fb632330" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,i-j" :db/id #edb/ref 17592186337725} {:answer/id #uuid "c71d302c-3c74-5be4-b48a-d3f52171a59d" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\,j" :db/id #edb/ref 17592186337799}] :answer-field/correct {:answer/id #uuid "c71d302c-3c74-5be4-b48a-d3f52171a59d" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\,j" :db/id #edb/ref 17592186337799} :answer-field/id #uuid "26dc6ba3-c35c-5f43-8491-310a9b2258ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338352}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c4a11cf-62cb-5e11-869c-4992e2a1b6f6" :question/math-academy-id "q-72463" :question/problem "Consider the plane curve $2{x}^{3}{y}^{2}-4xy=1-3x.$ Find a tangent vector to that curve at the point $(1,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{3}{y}^{2}-4xy & =1-3x \\\\ 2{x}^{3}{y}^{2}-4xy+3x & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{3}{y}^{2}-4xy+3x$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(1,1)$ can be computed as follows:\n\n$$\nt(1,1)={f}_{y}(1,1)i-{f}_{x}(1,1)j\n$$\n\n \n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2{x}^{3}{y}^{2}-4xy+3x)i-\\frac{∂}{∂x}(2{x}^{3}{y}^{2}-4xy+3x)j \\\\  & =(4y{x}^{3}-4x)i-(6{x}^{2}{y}^{2}-4y+3)j \\\\ t(1,1) & =(4(1)(1)^{3}-4(1))i-(6(1)^{2}(1)^{2}-4(1)+3)j \\\\  & =-5\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-5\\,j.$"} {:db/id #edb/ref 17592186363031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f3795a-9c5d-564b-99c5-8234a8f8adae" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,j" :db/id #edb/ref 17592186363033} {:answer/id #uuid "17117ea5-c48d-5a75-87dd-44fd4b306516" :answer/type {:db/ident :answer.type/math} :answer/value "i-2\\,j" :db/id #edb/ref 17592186363034} {:answer/id #uuid "a1a1d040-84f6-5093-b8b7-a02c512a3ef2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,i-2\\,j" :db/id #edb/ref 17592186363035} {:answer/id #uuid "afb47ff5-03cb-5158-9e15-6ff6eeca5436" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\,i" :db/id #edb/ref 17592186363036} {:answer/id #uuid "0c788786-b66b-5944-b4ad-21c56064f8a1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+3\\,j" :db/id #edb/ref 17592186363037}] :answer-field/correct {:answer/id #uuid "0c788786-b66b-5944-b4ad-21c56064f8a1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+3\\,j" :db/id #edb/ref 17592186363037} :answer-field/id #uuid "d07c4d10-4f15-5f81-9aca-9c05aa1a4821" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363032}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55fb49e6-3301-5747-997a-6aea4f919a61" :question/math-academy-id "q-130201" :question/problem "Consider the plane curve $xy=3-{x}^{2}-{y}^{3}.$ Find a tangent vector to that curve at the point $(-1,-1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}xy & =3-{x}^{2}-{y}^{3} \\\\ xy+{x}^{2}+{y}^{3} & =3\\end{aligned}\n$$\n\nIf we set $f(x,y)=xy+{x}^{2}+{y}^{3},$ our curve can be viewed as the level curve $f(x,y)=3.$ \n\nA tangent vector to the level curve that passes through the point $(-1,-1)$ can be computed as follows:\n\n$$\nt(-1,-1)={f}_{y}(-1,-1)i-{f}_{x}(-1,-1)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,-1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(xy+{x}^{2}+{y}^{3})i-\\frac{∂}{∂x}(xy+{x}^{2}+{y}^{3})j \\\\  & =(x+3{y}^{2})i-(y+2x)j \\\\ t(-1,-1) & =(-1+3(-1)^{2})i-(-1+2(-1))j \\\\  & =2\\,i+3\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $2\\,i+3\\,j.$"} {:db/id #edb/ref 17592186364309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b63d502-5d59-57aa-8402-34f229d7c402" :answer/type {:db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186364311} {:answer/id #uuid "d929314d-5095-5284-a04d-ed11a462fa9c" :answer/type {:db/ident :answer.type/math} :answer/value "i-3\\,j" :db/id #edb/ref 17592186364312} {:answer/id #uuid "47b22ede-a70a-5c2c-93d8-02196b170ae3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,i-2\\,j" :db/id #edb/ref 17592186364313} {:answer/id #uuid "18da3830-6440-532f-9cfa-3f5d7f38caec" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+j" :db/id #edb/ref 17592186364314} {:answer/id #uuid "41a6476e-7908-5df0-9348-8c27d17118c4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+3\\,j" :db/id #edb/ref 17592186364315}] :answer-field/correct {:answer/id #uuid "d929314d-5095-5284-a04d-ed11a462fa9c" :answer/type {:db/ident :answer.type/math} :answer/value "i-3\\,j" :db/id #edb/ref 17592186364312} :answer-field/id #uuid "727e4de1-593d-5c99-aa03-6535fb642416" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364310}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ddd3bf49-0b80-5ad0-bb5a-ddf4f0c0659f" :question/math-academy-id "q-72388" :question/problem "Consider the plane curve $x+1={x}^{2}y.$ Find a tangent vector to that curve at the point $(1,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x+1 & ={x}^{2}y \\\\ {x}^{2}y-x-1 & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}y-x-1$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(1,2)$ can be computed as follows:\n\n$$\nt(1,2)={f}_{y}(1,2)i-{f}_{x}(1,2)j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,2):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}({x}^{2}y-x-1)i-\\frac{∂}{∂x}({x}^{2}y-x-1)j \\\\  & ={x}^{2}\\,i-(2xy-1)j \\\\ t(1,2) & =(1)^{2}\\,i-(2(1)(2)-1)j \\\\  & =i-3\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $i-3\\,j.$"} {:db/id #edb/ref 17592186373743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b36ad97d-7477-5e7d-8ba7-295eb688f029" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,j" :db/id #edb/ref 17592186373745} {:answer/id #uuid "118ee41d-f5a0-5dff-b95c-7ca94836bc57" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,i" :db/id #edb/ref 17592186373746} {:answer/id #uuid "19b66868-06fe-5184-957b-7342b00b0910" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i-4\\,j" :db/id #edb/ref 17592186373747} {:answer/id #uuid "bd3d37cc-037a-5d75-8a4d-47c54303cb93" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i-j" :db/id #edb/ref 17592186373748} {:answer/id #uuid "0ff73071-c5ea-582c-baaf-95b7a73e5652" :answer/type {:db/ident :answer.type/math} :answer/value "i+2\\,j" :db/id #edb/ref 17592186373749}] :answer-field/correct {:answer/id #uuid "19b66868-06fe-5184-957b-7342b00b0910" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i-4\\,j" :db/id #edb/ref 17592186373747} :answer-field/id #uuid "8983d5c5-c4ae-595e-a0a2-63b53b664593" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373744}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "591300c7-13a2-5dd3-a27a-1d6a5e36e2a6" :question/math-academy-id "q-130192" :question/problem "Consider the plane curve ${x}^{2}y={y}^{2}+3.$ Find a tangent vector to that curve at the point $(2,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}y & ={y}^{2}+3 \\\\ {x}^{2}y-{y}^{2} & =3\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}y-{y}^{2},$ our curve can be viewed as the level curve $f(x,y)=3.$ \n\nA tangent vector to the level curve that passes through the point $(2,1)$ can be computed as follows:\n\n$$\nt(2,1)={f}_{y}(2,1)\\,i-{f}_{x}(2,1)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(2,1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}({x}^{2}y-{y}^{2})\\,i-\\frac{∂}{∂x}({x}^{2}y-{y}^{2})\\,j \\\\  & =({x}^{2}-2y)\\,i-2xy\\,j \\\\ t(2,1) & =({2}^{2}-2(1))\\,i-2(2)(1)\\,j \\\\  & =2\\,i-4\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $2\\,i-4\\,j.$"} {:db/id #edb/ref 17592186373750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "911d7e42-cfcf-516f-9283-caa49f997f72" :answer/type {:db/ident :answer.type/math} :answer/value "2i" :db/id #edb/ref 17592186373752} {:answer/id #uuid "0e521a0c-e2f8-593e-ac64-9ff0e485a18b" :answer/type {:db/ident :answer.type/math} :answer/value "-i+j" :db/id #edb/ref 17592186373753} {:answer/id #uuid "35594e4f-af9b-5a65-8a40-4f8e1ea611be" :answer/type {:db/ident :answer.type/math} :answer/value "-i-2\\,j" :db/id #edb/ref 17592186373754} {:answer/id #uuid "2593f5c0-8a74-5dbd-9a7a-90d0d2eee839" :answer/type {:db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186373755} {:answer/id #uuid "99b82f0f-6ffa-5c51-818b-49987fd97f69" :answer/type {:db/ident :answer.type/math} :answer/value "2i+j" :db/id #edb/ref 17592186373756}] :answer-field/correct {:answer/id #uuid "35594e4f-af9b-5a65-8a40-4f8e1ea611be" :answer/type {:db/ident :answer.type/math} :answer/value "-i-2\\,j" :db/id #edb/ref 17592186373754} :answer-field/id #uuid "e43ec9cc-2584-517e-838c-48a27daf6cd8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373751}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8f7db75e-f1c4-5d13-9d48-0ee7ceacaa16" :question/math-academy-id "q-130194" :question/problem "Consider the plane curve $x\\operatorname{ln}⁡y={x}^{2}-1.$ Find a tangent vector to that curve at the point $(-1,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x\\operatorname{ln}⁡y & ={x}^{2}-1 \\\\ x\\operatorname{ln}⁡y-{x}^{2} & =-1\\end{aligned}\n$$\n\nIf we set $f(x,y)=x\\operatorname{ln}⁡y-{x}^{2},$ our curve can be viewed as the level curve $f(x,y)=-1.$ \n\nA tangent vector to the level curve that passes through the point $(-1,1)$ can be computed as follows:\n\n$$\nt(-1,1)={f}_{y}(-1,1)\\,i-{f}_{x}(-1,1)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(-1,1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡y-{x}^{2})\\,i-\\frac{∂}{∂x}(x\\operatorname{ln}⁡y-{x}^{2})\\,j \\\\  & =\\frac{x}{y}\\,i-(\\operatorname{ln}⁡y-2x)\\,j \\\\ t(-1,1) & =\\frac{(-1)}{1}\\,i-(\\operatorname{ln}⁡1-2(-1))\\,j \\\\  & =-i-2\\,j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i-2\\,j.$"}] :knowledge-point/title "Finding a Tangent Vector to a Plane Curve"}] [{:db/id #edb/ref 17592186124456 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124260 :question/id #uuid "c4ca2e8a-5a5b-54c6-983d-2f5e821084ee" :question/math-academy-id "e-3364" :question/problem "At which points on the curve $6xy+3y^2 =7+ y - 3x^2$ is the tangent vector to the curve perpendicular to the vector $\\mathbf{j}?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}6xy+3{y}^{2} & =7+y-3{x}^{2} \\\\ 6xy+3{y}^{2}-y+3{x}^{2} & =7\\end{aligned}\n$$\n\nIf we set $f(x,y) = 6xy+3y^2 - y + 3x^2 ,$ our curve can be viewed as the level curve $f(x,y)=7.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\n\\mathbf t(x,y) = f_y(x,y) \\ \\mathbf i - f_x(x,y) \\ \\mathbf j\n$$\n\nSo, we calculate $\\mathbf t(x,y)\\mathbin{:}$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\text{ }i-{f}_{x}(x,y)\\text{ }j \\\\  & =\\frac{∂}{∂y}(6xy+3{y}^{2}-y+3{x}^{2})\\,i-\\frac{∂}{∂x}(6xy+3{y}^{2}-y+3{x}^{2})\\,j \\\\  & =(6x+6y-1)\\,i-(6y+6x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $\\mathbf{j},$ we must have $\\mathbf t \\cdot \\mathbf j = 0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((6x+6y-1)\\,i-(6y+6x)\\,j)\\cdot j & =0 \\\\ -6y-6x & =0 \\\\ y & =-x\\end{aligned}\n$$\n\nSubstituting $y=-x$ into the equation of our curve gives\n\n$$\n\\begin{aligned}6xy+3{y}^{2} & =7+y-3{x}^{2} \\\\ 6x(-x)+3(-x)^{2} & =7+(-x)-3{x}^{2} \\\\ -6{x}^{2}+3{x}^{2} & =7-x-3{x}^{2} \\\\ x & =7.\\end{aligned}\n$$\n\nFinally, if $x=7,$ we get $y=-7$ and the corresponding point is $(7,-7).$"} :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/questions [{:db/id #edb/ref 17592186124970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8606d62a-7486-572b-ab8c-46ac67243f27" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1)$ only" :db/id #edb/ref 17592186122421} {:answer/id #uuid "8f2694cd-e581-5ff7-a9aa-b48ef5ee9bca" :answer/type {:db/ident :answer.type/text} :answer/value "$(1, 1)$ and $(-1,-1)$" :db/id #edb/ref 17592186122422} {:answer/id #uuid "9973918f-d39c-52e3-86a6-bf0100f4d491" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1)$ and $(-1, 0)$" :db/id #edb/ref 17592186122423} {:answer/id #uuid "a901eb45-a368-5209-88c3-8e8c6859c2c8" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1)$ only" :db/id #edb/ref 17592186122424} {:answer/id #uuid "ba03bbc6-c116-5e39-979e-23def921a186" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1, 0)$ only" :db/id #edb/ref 17592186122425}] :answer-field/id #uuid "1bdf279b-86e9-5860-aa19-361360e00ba6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122420}] :question/id #uuid "fa8c1acf-fd5d-5946-ab8b-13077cafbbf0" :question/math-academy-id "q-36332" :question/problem "At which points on the curve $2xy + 3y^{2} = x^{2} + 4$ is the tangent vector to the curve perpendicular to the vector $j$?"} {:db/id #edb/ref 17592186125192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9822afda-d1f9-50c7-a4ce-ea8333bde970" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1)$ only" :db/id #edb/ref 17592186123753} {:answer/id #uuid "d6cc44e4-8095-54f5-8c67-b26a7016d7a3" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0)$ and $(1,-1)$ only" :db/id #edb/ref 17592186123754} {:answer/id #uuid "df50602a-0fac-52e0-a43b-248da252f93a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0)$ and $(1, 1)$ only" :db/id #edb/ref 17592186123755} {:answer/id #uuid "118a1db3-1d81-586e-807c-5bae6d8c1389" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0)$, $(-1, 1)$, and $(1,-1)$" :db/id #edb/ref 17592186123756} {:answer/id #uuid "39c66834-a727-5875-bdb0-255fc0f29118" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0)$, $(-1,-1)$, and $(1, 1)$" :db/id #edb/ref 17592186123757}] :answer-field/id #uuid "663d3173-cf3c-5803-b1f4-22200799840f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123752}] :question/id #uuid "142e660e-5b1f-5e61-a343-ee1945f69615" :question/math-academy-id "q-65208" :question/problem "At which points on the curve $9x^{2}y = 3y^{3} - 6x$ is the tangent vector to the curve perpendicular to the vector $i$?"} {:db/id #edb/ref 17592186265855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4be39072-497d-5f31-85ed-080e23888640" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186263654} {:answer/id #uuid "c1a31d3c-8503-58a7-8ecf-53ce88e8429e" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186264681} {:answer/id #uuid "c5f465b6-bac3-55a1-8d75-c1289cf7313e" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-5)" :db/id #edb/ref 17592186264733} {:answer/id #uuid "d297311d-d396-508d-a6bd-3e8b3fd8c863" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186264836} {:answer/id #uuid "e32b090c-8a44-582a-8e53-682c5da583b2" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-12)" :db/id #edb/ref 17592186264972}] :answer-field/correct {:answer/id #uuid "c1a31d3c-8503-58a7-8ecf-53ce88e8429e" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4)" :db/id #edb/ref 17592186264681} :answer-field/id #uuid "a2ab0ddd-26ef-5f3a-b559-a55d7b1fb92f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265530}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1ac4e615-d461-5edb-9d78-97997efce275" :question/math-academy-id "q-130223" :question/problem "At which point on the curve ${x}^{2}y=-8x-4$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}y & =-8x-4 \\\\ {x}^{2}y+8x & =-4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}y+8x,$ our curve can be viewed as the level curve $f(x,y)=-4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}y+8x)\\,i-\\frac{∂}{∂x}({x}^{2}y+8x)\\,j \\\\  & ={x}^{2}\\,i-(2xy+8)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ({x}^{2}\\,i-(2xy+8)\\,j)\\cdot j & =0 \\\\ -(2xy+8) & =0 \\\\ xy+4 & =0 \\\\ y & =-\\frac{4}{x}\\end{aligned}\n$$\n\nSubstituting $y=-\\frac{4}{x}$ into the equation of our curve gives\n\n$$\n\\begin{aligned}{x}^{2}y & =-8x-4 \\\\ {x}^{2}(-\\frac{4}{x}) & =-8x-4 \\\\ -4x & =-8x-4 \\\\ 4x & =-4 \\\\ x & =-1.\\end{aligned}\n$$\n\nFinally, for $x=-1,$ we get $y=4,$ and the corresponding point is $(-1,4).$"} {:db/id #edb/ref 17592186339110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ae43d1-4fec-5e37-8920-14fdf8f6c77d" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,2)$ and $(1,2)$" :db/id #edb/ref 17592186336245} {:answer/id #uuid "464aa712-2203-5c71-852e-42121f806af6" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,2)$ only" :db/id #edb/ref 17592186336685} {:answer/id #uuid "6fb7b868-b5d8-579b-adf6-6962389cbae6" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-2,-2)$" :db/id #edb/ref 17592186337020} {:answer/id #uuid "84b9fe17-3141-5ba4-b930-81eb79ca211c" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(2,1)$" :db/id #edb/ref 17592186337228} {:answer/id #uuid "971e49c0-6fdc-5a97-b4f7-0171b41fa764" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,0)$  and $(0,2)$" :db/id #edb/ref 17592186337407}] :answer-field/correct {:answer/id #uuid "6fb7b868-b5d8-579b-adf6-6962389cbae6" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-2,-2)$" :db/id #edb/ref 17592186337020} :answer-field/id #uuid "2db519c2-9383-5593-acf5-9c05c003290b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338361}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9c0801c9-8ff6-5c1f-a200-5a0877707694" :question/math-academy-id "q-72410" :question/problem "At which points on the curve ${y}^{2}+2xy={x}^{2}+8$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2xy & ={x}^{2}+8 \\\\ {y}^{2}+2xy-{x}^{2} & =8\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2xy-{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=8.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2xy-{x}^{2})i-\\frac{∂}{∂x}({y}^{2}+2xy-{x}^{2})j \\\\  & =2(y+x)\\,i-2(y-x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ (2(y+x)\\,i-2(y-x)\\,j)\\cdot j & =0 \\\\ -2(y-x) & =0 \\\\ y & =x\\end{aligned}\n$$\n\nSubstituting $y=x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2xy-{x}^{2} & =8 \\\\ (x)^{2}+2x(x)-{x}^{2} & =8 \\\\ {x}^{2}+2{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nFinally:\n\n- If $x=2$, we get $y=2$ and the corresponding point is $(2,2).$\n\n- If $x=-2$, we get $y=-2$ and the corresponding point is $(-2,-2).$"} {:db/id #edb/ref 17592186339115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df1c7eb-8340-5ae5-bb12-5c1eac211a43" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and  $(-2,4)$ only" :db/id #edb/ref 17592186336164} {:answer/id #uuid "3661bffb-2951-513d-a543-ac65bfdf1f97" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,4)$ and  $(-4,1)$ only" :db/id #edb/ref 17592186336537} {:answer/id #uuid "423b1542-232d-58c0-9337-ae84e6e0aa74" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and  $(4,-4)$ only" :db/id #edb/ref 17592186336658} {:answer/id #uuid "a6e95c16-5a95-5943-85ba-54d73ac6ae5d" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,1)$ and  $(-4,4)$ only" :db/id #edb/ref 17592186337541} {:answer/id #uuid "b7fad17d-f3ef-5003-b21c-026ac1013257" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,4)$ only" :db/id #edb/ref 17592186337660}] :answer-field/correct {:answer/id #uuid "a6e95c16-5a95-5943-85ba-54d73ac6ae5d" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,1)$ and  $(-4,4)$ only" :db/id #edb/ref 17592186337541} :answer-field/id #uuid "61738848-0a31-5b0d-adc3-57da8b8e226b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338448}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5577e429-0d55-5dd4-b588-49ac727edd6b" :question/math-academy-id "q-72440" :question/problem "At which points on the curve ${x}^{2}+2xy=-5y+4$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+2xy & =-5y+4 \\\\ {x}^{2}+2xy+5y & =4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+2xy+5y$, our curve can be viewed as the level curve $f(x,y)=4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+2xy+5y)i-\\frac{∂}{∂x}({x}^{2}+2xy+5y)j \\\\  & =(2x+5)\\,i-(2x+2y)\\,j\\end{aligned}\n$$\n\n  \n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+5)\\,i-(2x+2y)\\,j)\\cdot j & =0 \\\\ -(2x+2y) & =0 \\\\ x & =-y\\end{aligned}\n$$\n\nSubstituting $x=-y$ into the equation of our curve gives:    \n\n$$\n\\begin{aligned}{x}^{2}+2xy+5y & =4 \\\\ (-y)^{2}+2(-y)y+5y & =4 \\\\ {y}^{2}-2{y}^{2}+5y & =4 \\\\ -{y}^{2}+5y-4 & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0 \\\\ y & =1\\,\\text{or}\\,y=4\\end{aligned}\n$$\n\nFinally:\n\n- If $y=1$, we get $x=-1$ and the corresponding point is $(-1,1).$\n\n- If $y=4$, we get $x=-4$ and the corresponding point is $(-4,4).$"} {:db/id #edb/ref 17592186364316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4b0f044-128c-5f1b-aa69-2500dbaf5ea2" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1)$ and $(0,-3)$" :db/id #edb/ref 17592186364318} {:answer/id #uuid "bdd3ddf3-f39a-5e23-9542-809cca8045dd" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(-1,-3)$" :db/id #edb/ref 17592186364319} {:answer/id #uuid "cd3c3702-cba3-57ad-b3e0-2c994913bd41" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,3)$ and $(0,-3)$" :db/id #edb/ref 17592186364320} {:answer/id #uuid "71ef2f17-55ba-507e-8bbc-fc7b6bfebfc5" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,0)$ and $(-1,0)$" :db/id #edb/ref 17592186364321} {:answer/id #uuid "9e254c1d-c4f8-51bc-9734-35d90904ed56" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ and $(1,-3)$" :db/id #edb/ref 17592186364322}] :answer-field/correct {:answer/id #uuid "bdd3ddf3-f39a-5e23-9542-809cca8045dd" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(-1,-3)$" :db/id #edb/ref 17592186364319} :answer-field/id #uuid "e462412c-3cbc-5541-9147-125fc8a64b29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364317}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "32727d15-71dd-5c57-93a9-b5f15381c7c6" :question/math-academy-id "q-72416" :question/problem "At which points on the curve $2xy-3{x}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2xy-3{x}^{2}=-y \\\\ 2xy-3{x}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2xy-3{x}^{2}+y$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2xy-3{x}^{2}+y)i-\\frac{∂}{∂x}(2xy-3{x}^{2}+y)j \\\\  & =(2x+1)\\,i-2(y-3x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+1)\\,i-2(y-3x)\\,j)\\cdot j & =0 \\\\ -2(y-3x) & =0 \\\\ y & =3x\\end{aligned}\n$$\n\nSubstituting $y=3x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}2xy-3{x}^{2}+y & =0 \\\\ 2x(3x)-3{x}^{2}+3x & =0 \\\\ 6{x}^{2}-3{x}^{2}+3x & =0 \\\\ 3{x}^{2}+3x & =0 \\\\ 3x(x+1) & =0 \\\\ x & =0\\,\\text{or}\\,x=-1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=0$, we get $y=0$ and the corresponding point is $(0,0).$\n\n- If $x=-1$, we get $y=-3$ and the corresponding point is $(-1,-3).$"} {:db/id #edb/ref 17592186373757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8afc3ae9-00f3-516a-bbcb-c44682d96676" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,1)$ and $(1,1)$" :db/id #edb/ref 17592186373759} {:answer/id #uuid "81d8dc6b-68e6-5833-9743-e2dd9a57e9e5" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,1)$ and $(0,0)$" :db/id #edb/ref 17592186373760} {:answer/id #uuid "894083b9-b198-57bd-991b-77b81ac6aedf" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,\\frac{1}{3})$ only" :db/id #edb/ref 17592186373761} {:answer/id #uuid "a0589f58-1050-5bd6-9ac8-d8b3fa41a8fc" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(0,\\frac{1}{3})$" :db/id #edb/ref 17592186373762} {:answer/id #uuid "9d22b9c8-42b9-5f43-a01d-96f9e724e330" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ only" :db/id #edb/ref 17592186373763}] :answer-field/correct {:answer/id #uuid "a0589f58-1050-5bd6-9ac8-d8b3fa41a8fc" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(0,\\frac{1}{3})$" :db/id #edb/ref 17592186373762} :answer-field/id #uuid "f40ff009-072c-5417-b244-503451b38228" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373758}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3d9c5851-2645-50db-8b4e-b731824fd7d9" :question/math-academy-id "q-130225" :question/problem "At which points on the curve $2{x}^{2}-3{y}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2{x}^{2}-3{y}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-3{y}^{2}+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2}+y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2}+y)\\,j \\\\  & =(-6y+1)\\,i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((-6y+1)\\,i-4x\\,j)\\cdot j & =0 \\\\ -4x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nSubstituting $x=0$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2({0}^{2})-3{y}^{2} & =-y \\\\ 3{y}^{2}-y & =0 \\\\ y(3y-1) & =0 \\\\ y & =0,\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, the corresponding points are $(0,0)$ and $(0,\\frac{1}{3}).$"} {:db/id #edb/ref 17592186375335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27399e42-4acc-553e-ba4e-5998ae4da3e8" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-2)$ and $(0,1)$" :db/id #edb/ref 17592186375337} {:answer/id #uuid "a57c1eee-a86d-5c18-9d82-3d9e99558aee" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(1,0)$" :db/id #edb/ref 17592186375338} {:answer/id #uuid "bfb1fb31-2625-5bc1-9263-d7661c3e1d2b" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and $(2,0)$" :db/id #edb/ref 17592186375339} {:answer/id #uuid "ec3841f3-4849-5ca6-b655-2344b4b09e89" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-2)$ and $(1,0)$" :db/id #edb/ref 17592186375340} {:answer/id #uuid "30f0e009-0c6d-57a0-b587-090a0c1d88bd" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,0)$" :db/id #edb/ref 17592186375341}] :answer-field/correct {:answer/id #uuid "30f0e009-0c6d-57a0-b587-090a0c1d88bd" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,0)$" :db/id #edb/ref 17592186375341} :answer-field/id #uuid "079e80ed-3676-528f-b478-841f2caa3b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375336}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "703e7046-bcfc-54c8-9bb1-c367d4d9ddb7" :question/math-academy-id "q-72427" :question/problem "At which points on the curve ${y}^{2}+2x=2xy+2y-2$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2x & =2xy+2y-2 \\\\ {y}^{2}+2x-2xy-2y & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2x-2xy-2y$, our curve can be viewed as the level curve $f(x,y)=-2.$  \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2x-2xy-2y)i-\\frac{∂}{∂x}({y}^{2}+2x-2xy-2y)j \\\\  & =(2y-2x-2)\\,i-(2-2y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2y-2x-2)\\,i-(2-2y)\\,j)\\cdot i & =0 \\\\ 2y-2x-2 & =0 \\\\ 2(y-x-1) & =0 \\\\ y & =x+1\\end{aligned}\n$$\n\nSubstituting $y=x+1$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2x-2xy-2y & =-2 \\\\ (x+1)^{2}+2x-2x(x+1)-2(x+1)+2 & =0 \\\\ (x+1)^{2}-2x(x+1)-2(x+1)+2(x+1) & =0 \\\\ (x+1)^{2}-2x(x+1)-\\cancel{2(x+1)}+\\cancel{2(x+1)} & =0 \\\\ (x+1)^{2}-2x(x+1) & =0 \\\\ (x+1)(x+1-2x) & =0 \\\\ (x+1)(-x+1) & =0 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=1$, we get $y=2$ and the corresponding point is $(1,2).$\n\n- If $x=-1$, we get $y=0$ and the corresponding point is $(-1,0).$"} {:db/id #edb/ref 17592186388083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f4e581-a00c-5132-927c-1585f2f16335" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186388085} {:answer/id #uuid "a25cb316-03e0-5b80-b36c-bf23e9ecd400" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-\\frac{7}{8})" :db/id #edb/ref 17592186388086} {:answer/id #uuid "7ce509f6-676c-5142-b2e8-6b75044a4ae3" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-1)" :db/id #edb/ref 17592186388087} {:answer/id #uuid "56675fa5-8d6f-5214-9ce9-5265d8d72af6" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186388088} {:answer/id #uuid "5bff0bff-8fcd-5363-b279-0ef233e06a17" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{2},-\\frac{1}{2})" :db/id #edb/ref 17592186388089}] :answer-field/correct {:answer/id #uuid "a25cb316-03e0-5b80-b36c-bf23e9ecd400" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-\\frac{7}{8})" :db/id #edb/ref 17592186388086} :answer-field/id #uuid "368f7e81-de7f-51a5-98fc-f718da4aa1b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388084}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f930a915-2d68-50d6-9185-efb4889fde3f" :question/math-academy-id "q-130209" :question/problem "At which point on the curve $2{x}^{2}=y+1$ is the tangent vector to the curve perpendicular to the vector $i+j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2} & =y+1 \\\\ 2{x}^{2}-y & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-y,$ our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-y)\\,j \\\\  & =-i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i+j,$ we must have $t\\cdot (i+j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (i+j) & =0 \\\\ (-i-4x\\,j)\\cdot (i+j) & =0 \\\\ -1-4x & =0 \\\\ x & =-\\frac{1}{4}\\end{aligned}\n$$\n\nSubstituting $x=-\\frac{1}{4}$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2} & =y+1 \\\\ 2{(-\\frac{1}{4})}^{2} & =y+1 \\\\ \\frac{1}{8} & =y+1 \\\\ y & =-\\frac{7}{8}.\\end{aligned}\n$$\n\nFinally, the corresponding point is $(-\\frac{1}{4},-\\frac{7}{8}).$"} {:db/id #edb/ref 17592186400450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a3b5cf6-0370-5cde-a9e6-1edabf953fa1" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ only" :db/id #edb/ref 17592186400452} {:answer/id #uuid "796d0d95-8bf2-5062-97c0-381c6826adbc" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,2)$ and $(0,0)$" :db/id #edb/ref 17592186400453} {:answer/id #uuid "930c85b6-cd1d-5f01-b245-1181988c9afd" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,2)$ only" :db/id #edb/ref 17592186400454} {:answer/id #uuid "03b48f4a-4c69-5175-9b51-45915a00e587" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,0)$ only" :db/id #edb/ref 17592186400455} {:answer/id #uuid "36a2c161-410d-5532-af77-2aaed16bed2f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,0)$ and $(0,2)$" :db/id #edb/ref 17592186400456}] :answer-field/correct {:answer/id #uuid "796d0d95-8bf2-5062-97c0-381c6826adbc" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,2)$ and $(0,0)$" :db/id #edb/ref 17592186400453} :answer-field/id #uuid "31717cb2-d9d0-54f4-b700-91183260eebd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400451}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6851bbc7-80d6-5dc9-8a00-f559624fa12f" :question/math-academy-id "q-130217" :question/problem "At which points on the curve ${x}^{2}+{y}^{2}=2y-2x$ is the tangent vector to the curve perpendicular to the vector $-i+j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2y-2x \\\\ {x}^{2}+{y}^{2}+2x-2y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}+2x-2y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}+2x-2y)\\,i-\\frac{∂}{∂x}({x}^{2}+{y}^{2}+2x-2y)\\,j \\\\  & =(2y-2)\\,i-(2x+2)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $-i+j,$ we must have $t\\cdot (-i+j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (-i+j) & =0 \\\\ ((2y-2)\\,i-(2x+2)\\,j)\\cdot (-i+j) & =0 \\\\ -(2y-2)-(2x+2) & =0 \\\\ -2y-2x & =0 \\\\ y & =-x\\end{aligned}\n$$\n\nSubstituting $y=-x$ into the equation of our curve gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2y-2x \\\\ {x}^{2}+(-x)^{2} & =2(-x)-2x \\\\ 2{x}^{2} & =-4x \\\\ 2{x}^{2}+4x & =0 \\\\ 2x(x+2) & =0 \\\\ x & =-2,0.\\end{aligned}\n$$\n\nFinally:\n\n- For $x=-2,$ we get $y=2,$ and the corresponding point is $(-2,2).$\n\n- For $x=0,$ we get $y=0,$ and the corresponding point is $(0,0).$"} {:db/id #edb/ref 17592186403571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3b898a6-e9f5-51f8-8993-b6f0322af5e6" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,2)$ and $(-1,3)$" :db/id #edb/ref 17592186403573} {:answer/id #uuid "3acac861-9675-5531-8e0f-29301bd84beb" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and $(-1,-1)$" :db/id #edb/ref 17592186403574} {:answer/id #uuid "879099ba-26c3-5eca-b156-1546984f09e1" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,-2)$" :db/id #edb/ref 17592186403575} {:answer/id #uuid "56e7a278-62d5-5448-adb4-7672d93764ee" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(1,-2)$" :db/id #edb/ref 17592186403576} {:answer/id #uuid "c66b876c-2af7-5756-8122-0570c4918dbd" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,3)$ and $(3,-2)$" :db/id #edb/ref 17592186403577}] :answer-field/correct {:answer/id #uuid "879099ba-26c3-5eca-b156-1546984f09e1" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,-2)$" :db/id #edb/ref 17592186403575} :answer-field/id #uuid "22c59322-d13f-5287-a0fa-c2f86091a95e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403572}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "49dc4b38-854b-53b5-ba44-1bf47c27ef1c" :question/math-academy-id "q-72412" :question/problem "At which points on the curve ${y}^{2}-4xy=-5{x}^{2}+1$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}-4xy & =-5{x}^{2}+1 \\\\ {y}^{2}-4xy+5{x}^{2} & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}-4xy+5{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}-4xy+5{x}^{2})i-\\frac{∂}{∂x}({y}^{2}-4xy+5{x}^{2})j \\\\  & =2(y-2x)\\,i-(10x-4y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ (2(y-2x)\\,i-(10x-4y)\\,j)\\cdot i & =0 \\\\ 2(y-2x) & =0 \\\\ y & =2x\\end{aligned}\n$$\n\nSubstituting $y=2x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}-4xy+5{x}^{2} & =1 \\\\ (2x)^{2}-4x(2x)+5{x}^{2} & =1 \\\\ 4{x}^{2}-8{x}^{2}+5{x}^{2} & =1 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=1$, we get $y=2$ and the corresponding point is $(1,2).$\n\n- If $x=-1$, we get $y=-2$ and the corresponding point is $(-1,-2).$"}] :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] [{:db/id #edb/ref 17592186124458 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124262 :question/id #uuid "bf35c502-5a22-5953-9158-b2464d28c09f" :question/math-academy-id "e-3377" :question/problem "Find the directional derivative of the function $g(x, y) =3x^2+4xy$ at the point $A(0,1)$ in the direction towards the point $B(1,4).$" :question/worked-solution "The directional derivative $g'_{\\mathbf u}(a,b)$ of a function $g(x,y)$ at the point $(a,b)$ in the direction of the vector $\\mathbf v$ is given by\n\n$$\ng'_{\\mathbf u}(a,b) = \\nabla g(a,b)\\cdot\\mathbf u\n$$\n\nwhere $\\mathbf u$ is a unit vector in the direction of $\\mathbf v.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,4⟩-⟨0,1⟩ \\\\  & =⟨1,3⟩ \\\\ u & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{{1}^{2}+{3}^{2}}}⟨1,3⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨1,3⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $\\nabla g(x,y)$ and evaluate it at the point $A(0,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(3{x}^{2}+4xy),\\frac{∂}{∂y}(3{x}^{2}+4xy)⟩ \\\\  & =⟨6x+4y,\\,4x⟩ \\\\ ∇g(0,1) & =⟨6\\cdot 0+4\\cdot 1,\\,4\\cdot 0⟩ \\\\  & =⟨4,0⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(0,1) & =∇g(0,1)\\cdot u \\\\  & =⟨4,0⟩\\cdot ⟨\\frac{1}{\\sqrt{10}},\\frac{3}{\\sqrt{10}}⟩ \\\\  & =\\frac{4}{\\sqrt{10}} \\\\  & =\\frac{4\\sqrt{10}}{10} \\\\  & =\\frac{2\\sqrt{10}}{5}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "fd2b430e-fd5d-57ba-bc28-f7c113eda07a" :knowledge-point/questions [{:db/id #edb/ref 17592186124962 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91e3020e-b220-554e-a3f0-07e483342e90" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{21}}{21}" :db/id #edb/ref 17592186122373} {:answer/id #uuid "a1e6986e-ec79-5752-9e0d-ea5960beab16" :answer/type {:db/ident :answer.type/math} :answer/value "14\\sqrt{29}" :db/id #edb/ref 17592186122374} {:answer/id #uuid "a8340c19-e527-5c1b-953c-c260766408b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14\\sqrt{21}}{21}" :db/id #edb/ref 17592186122375} {:answer/id #uuid "db0760d0-b134-5ae3-af68-54c39c2f1781" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{29}}{29}" :db/id #edb/ref 17592186122376} {:answer/id #uuid "0801896c-1c2b-510b-86df-c0542a7bf4e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14\\sqrt{29}}{29}" :db/id #edb/ref 17592186122377}] :answer-field/id #uuid "5dfb4078-c321-5580-bb20-9356ac667745" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122372}] :question/id #uuid "4ba373e3-c7d5-54ce-a51c-b2950c874b69" :question/math-academy-id "q-36273" :question/problem "Find the directional derivative of the function $f(x, y) = 2x + y^{2}$ at the point $(0, 1)$ in the direction of the vector $v = 5i + 2j$."} {:db/id #edb/ref 17592186125029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93fcdd41-5aba-54fd-9f19-d383cd0c8b1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{78}{5}" :db/id #edb/ref 17592186122775} {:answer/id #uuid "abdb47d5-6a5e-50f3-b8d6-ae7cb6744ce6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{5}" :db/id #edb/ref 17592186122776} {:answer/id #uuid "b32de488-c397-50e7-9e0d-a9d2fa222187" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{18}{5}" :db/id #edb/ref 17592186122777} {:answer/id #uuid "5be9dc56-00c0-5419-8e09-cdc3986dabdf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{21}{5}" :db/id #edb/ref 17592186122778} {:answer/id #uuid "6f19ba24-1488-5e98-a493-56f081245961" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{78}{5}" :db/id #edb/ref 17592186122779}] :answer-field/id #uuid "52446f3c-8c33-54d6-a7e9-42d22d6cabce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122774}] :question/id #uuid "f655da5c-6e4d-590f-afb2-3ac467aa95f7" :question/math-academy-id "q-37077" :question/problem "Find the directional derivative of the function $f(x, y) = (x + y^{2})^{2}$ at the point $A(-1,-2)$ in the direction towards the point $B(2, 2)$."} {:db/id #edb/ref 17592186235525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7eaac021-36b6-54cc-b7ec-c212007fad51" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186234738}] :answer-field/correct {:answer/id #uuid "7eaac021-36b6-54cc-b7ec-c212007fad51" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186234738} :answer-field/id #uuid "61ede809-36cc-5d59-b1d8-f7a0b29d9d5f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235075}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e02c41aa-7da1-51d0-a8bf-4d3360c07bca" :question/math-academy-id "q-168116" :question/problem "Find the directional derivative of the function $f(x,y)=\\text{div}\\,V$ at the point $(1,1)$ in the direction of the vector $v=-3\\,i+4\\,j.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        The required directional derivative is ${f}_{u}^{′}(1,1)=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{(-3)^{2}+{4}^{2}}=\\sqrt{25}=5 \\\\ u & =\\frac{1}{5}(-3\\,i+4\\,j)\\end{aligned}\n$$\n\nIn part 3, we found that the gradient $∇f(x,y)$ at the point $(1,1)$ is\n\n$$\n∇\\,f(1,1)=∇(\\text{div}\\,V)\\,{|}_{(1,\\,1)}=4\\,i+2\\,j.\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(1,1) & =∇\\,f(1,1)\\cdot u \\\\  & =(4\\,i+2\\,j)\\cdot (\\frac{1}{5}(-3\\,i+4\\,j)) \\\\  & =\\frac{4\\cdot (-3)+2\\cdot 4}{5} \\\\  & =-\\frac{4}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08151725-c767-5bfa-8cc0-566dac73c7c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}+2}{2}" :db/id #edb/ref 17592186263073} {:answer/id #uuid "6b75a71e-ff62-5063-9c04-4318296a44fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186263928} {:answer/id #uuid "8f591e1b-9777-5d0f-b497-43f656adfa40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}+4}{2}" :db/id #edb/ref 17592186264230} {:answer/id #uuid "bd6ad8b4-a673-5008-ae07-fbef7600a1fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}-1" :db/id #edb/ref 17592186264645} {:answer/id #uuid "bd888fe4-7f5e-51b1-a53d-363189aedc9d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186264646}] :answer-field/correct {:answer/id #uuid "08151725-c767-5bfa-8cc0-566dac73c7c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}+2}{2}" :db/id #edb/ref 17592186263073} :answer-field/id #uuid "93ddfe34-8e2a-5c0d-ad1d-5d50a7d04569" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265512}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5e9cc9e7-1d62-51d1-8fa2-dd51fa7daa28" :question/math-academy-id "q-130257" :question/problem "Find the directional derivative of the function $f(x,y)=xy$ at the point $(2,1)$ in the direction of the vector $v=\\sqrt{3}\\,i+j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{(\\sqrt{3})^{2}+{1}^{2}}=2 \\\\ u & =\\frac{1}{2}(\\sqrt{3}\\,i+j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(2,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}(xy)\\text{ }i+\\frac{∂}{∂y}(xy)\\text{ }j \\\\  & =y\\,i+x\\,j \\\\ ∇\\,f(2,1) & =i+2\\,j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(2,1) & =∇\\,f(2,1)\\cdot u \\\\  & =(i+2\\,j)\\cdot \\frac{1}{2}(\\sqrt{3}\\,i+j) \\\\  & =\\frac{1(\\sqrt{3})+2(1)}{2} \\\\  & =\\frac{\\sqrt{3}+2}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1da1714c-2291-5808-ac0e-0808ab462f8d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263272} {:answer/id #uuid "450b63f8-2ed8-5c35-8a78-b5c67477b5ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186263607} {:answer/id #uuid "72992976-c623-506b-9f6f-3a6145bc7b3f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{5}" :db/id #edb/ref 17592186263992} {:answer/id #uuid "7dc54a79-4160-5b82-ac56-cae08fe005df" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264084} {:answer/id #uuid "b7690e09-485b-5e3c-b1cf-05000b42442a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264589}] :answer-field/correct {:answer/id #uuid "72992976-c623-506b-9f6f-3a6145bc7b3f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{5}" :db/id #edb/ref 17592186263992} :answer-field/id #uuid "7c8b53a4-366c-5e74-a168-e6f6544ed5ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265461}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "35885778-6551-5cbf-9f14-c659423ae334" :question/math-academy-id "q-130260" :question/problem "Find the directional derivative of the function $f(x,y)=\\operatorname{ln}⁡({x}^{2}+{y}^{2})$ at the point $(0,-1)$ in the direction of the vector $v=3\\,i+4\\,j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{3}^{2}+{4}^{2}}=5 \\\\ u & =\\frac{1}{5}(3\\,i+4\\,j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(0,-1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}))\\text{ }i+\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}))\\text{ }j \\\\  & =\\frac{2x}{{x}^{2}+{y}^{2}}\\,i+\\frac{2y}{{x}^{2}+{y}^{2}}j \\\\ ∇\\,f(0,-1) & =\\frac{2(0)}{{0}^{2}+(-1)^{2}}\\,i+\\frac{2(-1)}{{0}^{2}+(-1)^{2}}\\,j \\\\  & =-2\\,j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(0,-1) & =∇\\,f(0,-1)\\cdot u \\\\  & =-2\\,j\\cdot \\frac{1}{5}(3\\,i+4\\,j) \\\\  & =-\\frac{2(4)}{5} \\\\  & =-\\frac{8}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "086fecd5-a126-5f32-9308-1bc895c050b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186263080} {:answer/id #uuid "8d43de9a-94e9-5878-939e-2733944f61c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186264208} {:answer/id #uuid "9b78ab4c-27f6-5a87-8918-b6215e38243b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264329} {:answer/id #uuid "b92952ce-92d6-5fe1-84dc-4e5ec973c535" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186264605} {:answer/id #uuid "cd1aafca-14b7-5d95-9816-988f20570192" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264795}] :answer-field/correct {:answer/id #uuid "9b78ab4c-27f6-5a87-8918-b6215e38243b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264329} :answer-field/id #uuid "6e1d9c83-156f-56e6-8ce6-3d01bf086064" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265433}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ae068a0a-3a23-5516-a4b7-13c70903e5db" :question/math-academy-id "q-130263" :question/problem "Find the directional derivative of the function $f(x,y)={x}^{2}+{y}^{2}-xy$ at the point $(1,1)$ in the direction of the vector $v=i-j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{1}^{2}+(-1)^{2}}=\\sqrt{2} \\\\ u & =\\frac{1}{\\sqrt{2}}(i-j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}-xy)i+\\frac{∂}{∂y}({x}^{2}+{y}^{2}-xy)j \\\\  & =(2x-y)\\,i+(2y-x)\\,j \\\\ ∇\\,f(1,1) & =(2(1)-1)\\,i+(2(1)-1)\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(1,1) & =∇\\,f(1,1)\\cdot u \\\\  & =(i+j)\\cdot \\frac{1}{\\sqrt{2}}(i-j) \\\\  & =\\frac{1(1)+1(-1)}{\\sqrt{2}} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00835dd1-8061-59e4-8040-48a957847175" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186321154} {:answer/id #uuid "2b84de9a-1d96-5d76-b304-fcc568ae08c3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186321481} {:answer/id #uuid "8f8d9dd6-ab7c-531c-92df-429bb88b6255" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186322286} {:answer/id #uuid "93873ce7-adfb-5826-85f5-744afae73ad2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186322319} {:answer/id #uuid "f4e6066c-22d2-5127-a385-fb4a7da7ae82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186323067}] :answer-field/correct {:answer/id #uuid "f4e6066c-22d2-5127-a385-fb4a7da7ae82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186323067} :answer-field/id #uuid "e2ab9660-72ee-5cec-b767-3be5f30759da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323617}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0cd131d3-dbf5-532a-a1c1-f69d113636a0" :question/math-academy-id "q-36290" :question/problem "Find the directional derivative of the function $f(x,y)=x{e}^{y}+{x}^{2}y$ at the point $A(1,0)$ in the direction towards the point $B(0,1).$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,1⟩-⟨1,0⟩ \\\\  & =⟨-1,1⟩ \\\\ u & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}}}⟨-1,1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $∇f(x,y)$ and evaluate it at the point $A(1,0):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =⟨\\frac{∂}{∂x}(x{e}^{y}+{x}^{2}y),\\,\\frac{∂}{∂y}(x{e}^{y}+{x}^{2}y)⟩ \\\\  & =⟨{e}^{y}+2xy,\\,x{e}^{y}+{x}^{2}⟩ \\\\ ∇\\,f(1,0) & =⟨{e}^{0}+2\\cdot 1\\cdot 0,\\,1\\cdot {e}^{0}+{1}^{2}⟩ \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is:\n\n$$\n\\begin{aligned}{f}_{u}^{′}(1,0) & =∇f(1,0)\\cdot u \\\\  & =⟨1,\\,2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1304514c-b435-522f-ad3a-591f2559a22b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{34}}{34}" :db/id #edb/ref 17592186351730} {:answer/id #uuid "7e4fba7a-fe7c-5a9c-9fbe-87782d23df70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11\\sqrt{43}}{43}" :db/id #edb/ref 17592186352676} {:answer/id #uuid "c8a1b502-7fbf-5960-aaec-5f60565ea22e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{34}}{34}" :db/id #edb/ref 17592186353314} {:answer/id #uuid "c94460ac-494e-513e-82ed-c599cb03d029" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{43}}{34}" :db/id #edb/ref 17592186353320} {:answer/id #uuid "f1e9e528-e824-57bb-899a-9e75210a8db6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{34}}{34}" :db/id #edb/ref 17592186353676}] :answer-field/correct {:answer/id #uuid "c8a1b502-7fbf-5960-aaec-5f60565ea22e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{34}}{34}" :db/id #edb/ref 17592186353314} :answer-field/id #uuid "e9f8833b-3f19-5c49-a196-1b1b54521800" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354216}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f8f45df0-069c-5e4a-a4d7-bdd2e15f5467" :question/math-academy-id "q-86429" :question/problem "Find the directional derivative of the function $f(x,y)=6{x}^{2}+2y$ at the point $(0,1)$ in the direction of the vector $v=3i+5j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{3}^{2}+{5}^{2}}=\\sqrt{34} \\\\ u & =\\frac{1}{\\sqrt{34}}(3i+5j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(0,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}(6{x}^{2}+2y)\\text{ }i+\\frac{∂}{∂y}(6{x}^{2}+2y)\\text{ }j \\\\  & =12x\\,i+2\\,j \\\\ ∇\\,f(0,1) & =(12\\cdot 0)\\,i+2\\,j \\\\  & =2j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(0,1) & =∇\\,f(0,1)\\cdot u \\\\  & =2j\\cdot (\\frac{3}{\\sqrt{34}}i+\\frac{5}{\\sqrt{34}}j) \\\\  & =\\frac{0\\cdot 3+2\\cdot 5}{\\sqrt{34}} \\\\  & =\\frac{10\\sqrt{34}}{34}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Directional Derivative"}] [{:db/id #edb/ref 17592186124459 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124263 :question/id #uuid "dc1e4548-ce72-5618-86f4-b68b46b50550" :question/math-academy-id "e-3381" :question/problem "In what direction does the function $f (x, y) = \\ln (x^2y)$ decrease most rapidly at the point $(2, 1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ decreases most rapidly in the direction opposite to that of its gradient.\n\nSo, we compute $-\\nabla f(x,y)$ and evaluate it at the point $(2,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}-∇f(x,y) & =-\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}y))\\text{ }i-\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}y))\\text{ }j \\\\  & =-\\frac{1}{{x}^{2}y}\\cdot 2xy\\text{ }i-\\frac{1}{{x}^{2}y}\\cdot {x}^{2}j \\\\  & =-\\frac{2}{x}\\text{ }i-\\frac{1}{y}\\text{ }j \\\\ -∇f(2,1) & =-\\frac{2}{2}\\text{ }i-\\frac{1}{1}\\text{ }j \\\\  & =-i-j\\end{aligned}\n$$\n\nTherefore, the function decreases most rapidly in the direction of $- \\, \\mathbf i - \\mathbf j.$"} :knowledge-point/id #uuid "ff351d3f-449b-5c41-8f72-d1917b2b7536" :knowledge-point/questions [{:db/id #edb/ref 17592186124963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8f5286b-99bb-5a1a-927f-88c70551e130" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin (1)i + 2j" :db/id #edb/ref 17592186122379} {:answer/id #uuid "da96497d-aef7-5188-aa0a-fd775e4f774d" :answer/type {:db/ident :answer.type/math} :answer/value "-2i - j" :db/id #edb/ref 17592186122380} {:answer/id #uuid "e735c0a2-12f8-53a9-8832-06b822e65e49" :answer/type {:db/ident :answer.type/math} :answer/value "(2 - \\sin (1))i + j" :db/id #edb/ref 17592186122381} {:answer/id #uuid "fb69c42b-63e6-5bbc-ad18-f9fbc6438e6e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sin (1) - 2)i - j" :db/id #edb/ref 17592186122382} {:answer/id #uuid "1b2b4fe4-fb54-51f9-b481-aa6353b4c03c" :answer/type {:db/ident :answer.type/math} :answer/value "2i + j" :db/id #edb/ref 17592186122383}] :answer-field/id #uuid "0e3d8181-5a0a-57e3-b64b-0cfbd5cc5890" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122378}] :question/id #uuid "e75dd59c-9b9f-50d9-a9a4-c1850c66ee84" :question/math-academy-id "q-36293" :question/problem "In what direction does the function $f(x, y) = \\cos x + x^{2}y$ increase most rapidly at the point $(1, 1)$?"} {:db/id #edb/ref 17592186124965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ff85bb-8ce2-5025-a0a1-83fc98417ed7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2\\pi ,-2,-\\pi ⟩" :db/id #edb/ref 17592186321217} {:answer/id #uuid "636513d9-9ad2-5bbe-b8b3-cd67a4bf8d3d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,2,1⟩" :db/id #edb/ref 17592186321920} {:answer/id #uuid "9f98fa5a-9408-52f3-8b7e-8f25e3ab2ecf" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\pi ,-1,\\pi ⟩" :db/id #edb/ref 17592186322407} {:answer/id #uuid "c672059e-d68f-556c-9a70-117d11270e16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\pi ,2,\\pi ⟩" :db/id #edb/ref 17592186322686} {:answer/id #uuid "cdeb1fca-19f0-5446-8266-9a4f0c5b2778" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\pi ,2,\\pi ⟩" :db/id #edb/ref 17592186322752}] :answer-field/correct {:answer/id #uuid "cdeb1fca-19f0-5446-8266-9a4f0c5b2778" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\pi ,2,\\pi ⟩" :db/id #edb/ref 17592186322752} :answer-field/id #uuid "cd3b7500-df79-56f9-843a-ede4ff70a4be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323570}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9a412c3a-6b92-5f8b-8cf9-ec76f9ca97fa" :question/math-academy-id "q-36305" :question/problem "In what direction does the function $g(x,y,z)={y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z)$ increase most rapidly at the point $(1,1,2)?$" :question/worked-solution "At a given point, a function $g(x,y,z)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇g(x,y,z)$ and evaluate it at the point $(1,1,2):$\n\n$$\n\\begin{aligned}∇g(x,y,z) & =⟨\\frac{∂}{∂x}({y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z)),\\,\\frac{∂}{∂y}({y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z)),\\,\\frac{∂}{∂z}({y}^{2}+\\operatorname{sin}⁡(2\\pi x+\\pi z))⟩ \\\\  & =⟨2\\pi \\operatorname{cos}⁡(2\\pi x+\\pi z),\\,2y,\\,\\pi \\operatorname{cos}⁡(2\\pi x+\\pi z)⟩ \\\\ ∇g(1,1,2) & =⟨2\\pi \\operatorname{cos}⁡(2\\pi \\cdot 1+\\pi \\cdot 2),\\,2\\cdot 1,\\,\\pi \\operatorname{cos}⁡(2\\pi \\cdot 1+\\pi \\cdot 2)⟩ \\\\  & =⟨2\\pi \\operatorname{cos}⁡(4\\pi ),\\,2,\\,\\pi \\operatorname{cos}⁡(4\\pi )⟩ \\\\  & =⟨2\\pi ,\\,2,\\,\\pi ⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $⟨2\\pi ,\\,2,\\,\\pi ⟩.$"} {:db/id #edb/ref 17592186265872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "371188b1-b7ec-57b7-b295-164f4505e38f" :answer/type {:db/ident :answer.type/math} :answer/value "i-2\\,j" :db/id #edb/ref 17592186263494} {:answer/id #uuid "468d5107-6a48-54fc-a274-623f490c7ae3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+j" :db/id #edb/ref 17592186263617} {:answer/id #uuid "5224940d-41f5-5791-9620-631ff60b6036" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,i+10\\,j" :db/id #edb/ref 17592186263707} {:answer/id #uuid "5a9a260e-6d34-52c4-a50b-774f0edf8d5b" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,i+j" :db/id #edb/ref 17592186263781} {:answer/id #uuid "c1f338bb-07ad-5dd5-a554-45630ad32b40" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,i-5\\,j" :db/id #edb/ref 17592186264684}] :answer-field/correct {:answer/id #uuid "5224940d-41f5-5791-9620-631ff60b6036" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,i+10\\,j" :db/id #edb/ref 17592186263707} :answer-field/id #uuid "82b1bccb-f245-5952-bbe0-74fd47a6963c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265475}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "234c72df-7b34-5698-b613-f1acebf8fd8e" :question/math-academy-id "q-130276" :question/problem "In what direction does the function $f(x,y)={x}^{2}+3xy+2{y}^{2}$ increase most rapidly at the point $(2,1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(2,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+3xy+2{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+3xy+2{y}^{2})\\,j \\\\  & =(2x+3y)\\,i+(3x+4y)\\,j \\\\ ∇f(2,1) & =(2(2)+3(1))\\,i+(3(2)+4(1))\\,j \\\\  & =7\\,i+10\\,j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $7\\,i+10\\,j.$"} {:db/id #edb/ref 17592186323874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "255172e6-7a9f-58d5-a331-2f9b1c75fdc1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,-\\pi ,\\,3⟩" :db/id #edb/ref 17592186321437} {:answer/id #uuid "ad71c1c5-8c51-5b0e-a1c2-00e6be326690" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\pi +3,\\,\\pi ,\\,3⟩" :db/id #edb/ref 17592186322506} {:answer/id #uuid "b2583193-7c57-5a7b-a812-d2606cdf10e7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,0,\\,6⟩" :db/id #edb/ref 17592186322542} {:answer/id #uuid "c7d64c08-23f9-5296-9b84-8bb3edc8f8d3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\pi +3,\\,-1,\\,6⟩" :db/id #edb/ref 17592186322698} {:answer/id #uuid "dd715aea-f494-54b7-886a-982c585d2245" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,-1,\\,6⟩" :db/id #edb/ref 17592186322878}] :answer-field/correct {:answer/id #uuid "c7d64c08-23f9-5296-9b84-8bb3edc8f8d3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\pi +3,\\,-1,\\,6⟩" :db/id #edb/ref 17592186322698} :answer-field/id #uuid "511dda4a-e46b-5ff9-8563-b0b60e9db9a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323325}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2e292b5a-7460-5589-a8da-d2424c37287d" :question/math-academy-id "q-37080" :question/problem "Given the function $f(x,y,z)=\\operatorname{sin}⁡(\\pi x+y)+3{z}^{2}x$, in what direction does the function increase most rapidly at the point $(1,0,1)?$" :question/worked-solution "At a given point, a function $f(x,y,z)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y,z)$ and evaluate it at the point $(1,0,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =⟨\\frac{∂}{∂x}(\\operatorname{sin}⁡(\\pi x+y)+3{z}^{2}x),\\,\\frac{∂}{∂y}(\\operatorname{sin}⁡(\\pi x+y)+3{z}^{2}x),\\,\\frac{∂}{∂z}(\\operatorname{sin}⁡(\\pi x+y)+3{z}^{2}x)⟩ \\\\  & =⟨\\pi \\operatorname{cos}⁡(\\pi x+y)+3{z}^{2},\\,\\operatorname{cos}⁡(\\pi x+y),\\,6xz⟩ \\\\ ∇f(1,0,1) & =⟨\\pi \\operatorname{cos}⁡(\\pi \\cdot 1+0)+3\\cdot {1}^{2},\\,\\operatorname{cos}⁡(\\pi \\cdot 1+0),\\,6\\cdot 1\\cdot 1⟩ \\\\  & =⟨\\pi \\operatorname{cos}⁡(\\pi )+3,\\,\\operatorname{cos}⁡(\\pi ),\\,6⟩ \\\\  & =⟨-\\pi +3,\\,-1,\\,6⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $⟨-\\pi +3,\\,-1,\\,6⟩.$"} {:db/id #edb/ref 17592186351517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e2d1818-23b6-5bc6-9705-1aa1f8fcde6c" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{-1}+1)\\text{ }i+({e}^{-1}-1)j" :db/id #edb/ref 17592186349013} {:answer/id #uuid "68eb9247-b932-5869-944e-6c106bd7cb39" :answer/type {:db/ident :answer.type/math} :answer/value "(e-1)\\text{ }i+ej" :db/id #edb/ref 17592186349413} {:answer/id #uuid "6fd17f28-20e2-5ce1-8906-d302e5e5f909" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{-1}+1)\\text{ }i+{e}^{-1}j" :db/id #edb/ref 17592186349472} {:answer/id #uuid "91bd11c8-e407-5439-bdc4-1470bfd9ed1a" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{-1}-1)\\text{ }i+{e}^{-1}j" :db/id #edb/ref 17592186349749} {:answer/id #uuid "df06fa9d-9784-5210-b854-98e07a5502ea" :answer/type {:db/ident :answer.type/math} :answer/value "(e+1)\\text{ }i+(e-1)j" :db/id #edb/ref 17592186350399}] :answer-field/correct {:answer/id #uuid "91bd11c8-e407-5439-bdc4-1470bfd9ed1a" :answer/type {:db/ident :answer.type/math} :answer/value "({e}^{-1}-1)\\text{ }i+{e}^{-1}j" :db/id #edb/ref 17592186349749} :answer-field/id #uuid "49ce0ac9-9872-520a-b868-69cd398be0c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350832}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4e724341-d4b7-5d33-9112-e9d06eaccd62" :question/math-academy-id "q-83554" :question/problem "In what direction does the function $f(x,y)=x\\operatorname{ln}⁡y+y{e}^{x}-xy$ increase most rapidly at the point $(-1,1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y+y{e}^{x}-xy)\\text{ }i+\\frac{∂}{∂y}(x\\operatorname{ln}⁡y+y{e}^{x}-xy)\\text{ }j \\\\  & =(\\operatorname{ln}⁡y+y{e}^{x}-y)\\text{ }i+(\\frac{x}{y}+{e}^{x}-x)\\text{ }j \\\\ ∇f(1,1) & =(\\operatorname{ln}⁡1+1\\cdot {e}^{-1}-1)\\text{ }i+(\\frac{-1}{1}+{e}^{-1}-(-1))\\text{ }j \\\\  & =({e}^{-1}-1)\\text{ }i+{e}^{-1}j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $({e}^{-1}-1)\\text{ }i+{e}^{-1}j.$"} {:db/id #edb/ref 17592186354478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1721b07e-259c-5a3f-a8e9-4f2d59c63517" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186351772} {:answer/id #uuid "215ecffb-b146-5627-91b0-550f671dd2c0" :answer/type {:db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186351867} {:answer/id #uuid "722664ed-33e9-5cc1-b19b-4351c6efb19f" :answer/type {:db/ident :answer.type/math} :answer/value "i+j" :db/id #edb/ref 17592186352566} {:answer/id #uuid "81a3d5cd-c8fc-5c45-bcca-96eb05f8c947" :answer/type {:db/ident :answer.type/math} :answer/value "2i-j" :db/id #edb/ref 17592186352695} {:answer/id #uuid "df442e6f-48af-5860-ac3c-76c823ada575" :answer/type {:db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186353507}] :answer-field/correct {:answer/id #uuid "1721b07e-259c-5a3f-a8e9-4f2d59c63517" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186351772} :answer-field/id #uuid "40e73d7d-cb49-50d9-9ae1-9e40c00f9a4e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353927}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1b68e57-d9ea-56e4-b3b2-4bb6dcbf9139" :question/math-academy-id "q-86537" :question/problem "In what direction does the function $f(x,y)=3{x}^{2}\\operatorname{sin}⁡y-y\\operatorname{cos}⁡x$ increase most rapidly at the point $(0,1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(0,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(3{x}^{2}\\operatorname{sin}⁡y-y\\operatorname{cos}⁡x)\\text{ }i+\\frac{∂}{∂y}(3{x}^{2}\\operatorname{sin}⁡y-y\\operatorname{cos}⁡x)\\text{ }j \\\\  & =(y\\operatorname{sin}⁡x+6x\\operatorname{sin}⁡y)\\text{ }i+(3{x}^{2}\\operatorname{cos}⁡y-\\operatorname{cos}⁡x)\\text{ }j \\\\ ∇f(0,1) & =(1\\cdot \\operatorname{sin}⁡(0)+6\\cdot 0\\cdot \\operatorname{sin}⁡(1))\\text{ }i+(3(0)^{2}\\operatorname{cos}⁡(1)-\\operatorname{cos}⁡(0))\\text{ }j \\\\  & =-j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $-j.$"}] :knowledge-point/title "Finding the Direction of Maximum Increase or Maximum Decrease of a Function"}] [{:db/id #edb/ref 17592186124460 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124264 :question/id #uuid "1eea4610-508a-5437-802e-9d009b777e82" :question/math-academy-id "e-3382" :question/problem "Consider the function $g (x, y) = \\ln \\left(\\sqrt {xy^3}\\right).$ What is the rate of change of $g$ at the point $\\left(\\dfrac 12, \\dfrac 32 \\right)$ in the direction in which the function increases most rapidly?" :question/worked-solution "At a given point, a function $g(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nIn our case, we compute $\\nabla g(x,y)$ and evaluate it at the point $\\left(\\dfrac 12, \\dfrac 32 \\right)\\!\\mathbin{:}$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{ln}⁡(\\sqrt{x{y}^{3}})),\\,\\frac{∂}{∂y}(\\operatorname{ln}⁡(\\sqrt{x{y}^{3}}))⟩ \\\\  & =⟨\\frac{1}{\\sqrt{x{y}^{3}}}\\cdot \\frac{{y}^{3}}{2\\sqrt{x{y}^{3}}},\\,\\frac{1}{\\sqrt{x{y}^{3}}}\\cdot \\frac{3x{y}^{2}}{2\\sqrt{x{y}^{3}}}⟩ \\\\  & =⟨\\frac{1}{2x},\\,\\frac{3}{2y}⟩ \\\\ ∇g(\\frac{1}{2},\\frac{3}{2}) & =⟨\\frac{1}{2\\cdot (\\frac{1}{2})},\\frac{3}{2\\cdot (\\frac{3}{2})}⟩ \\\\  & =⟨1,1⟩\\end{aligned}\n$$\n\nFinally, the rate of change of $g(x,y)$ at the point $\\left(\\dfrac 12, \\dfrac 32 \\right)$ in the direction of $\\nabla g\\left(\\dfrac 12, \\dfrac 32 \\right)$ is given by\n\n$$\n\\begin{aligned}‖∇g(\\frac{1}{2},\\frac{3}{2})‖ & =‖⟨1,1⟩‖ \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "c330648f-69ad-5778-98cb-bd48a0b160dd" :knowledge-point/questions [{:db/id #edb/ref 17592186124964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8377f097-45c2-5136-bb1a-ec94780f46ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{10}}{10}" :db/id #edb/ref 17592186122385} {:answer/id #uuid "85e45877-a3bb-5df2-b95b-1b22f8f282b8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186122386} {:answer/id #uuid "c53a2aeb-cf40-56b1-837e-e4a412f6db98" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186122387} {:answer/id #uuid "42f3f813-ee54-55f9-9e98-8cd208a09b33" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8\\sqrt{10}}{5}" :db/id #edb/ref 17592186122388} {:answer/id #uuid "4a7e03b0-95c8-5010-8940-20600f4e7159" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{5}" :db/id #edb/ref 17592186122389}] :answer-field/id #uuid "ff58ae13-957c-59b0-9fda-ff457d0f11e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122384}] :question/id #uuid "a985e88b-265b-5691-956a-877ec947cdff" :question/math-academy-id "q-36297" :question/problem "Consider the function $g(x, y) = \\frac{x^{2}}{y}$. What is the rate of change of $g(x, y)$ at the point $(2, 1)$ in the direction of the vector $v = ⟨ - 1, 3⟩$?"} {:db/id #edb/ref 17592186125028 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb74f0-7cbb-50ca-b586-f737d6776ec5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π + e}}{e}" :db/id #edb/ref 17592186122769} {:answer/id #uuid "dc78535a-8c2f-56df-9b87-429982d864c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{π + e}{e}}" :db/id #edb/ref 17592186122770} {:answer/id #uuid "f0fd833e-3cf7-55af-bc07-55bc949b0cae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π^{2} + e^{2}}}{e}" :db/id #edb/ref 17592186122771} {:answer/id #uuid "39f8b7b1-abe0-5cdc-8e14-a6a2092e6f81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π^{4} + e^{2}}}{π}" :db/id #edb/ref 17592186122772} {:answer/id #uuid "6b9b409c-8615-5646-8312-02eb29a5d380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{π^{2} + e^{2}}}{π}" :db/id #edb/ref 17592186122773}] :answer-field/id #uuid "4aca3088-e8f0-5dbc-95a5-523c9e4320d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122768}] :question/id #uuid "8ea3ebc5-2c81-5696-aab4-931973a19233" :question/math-academy-id "q-37074" :question/problem "Consider the function $g(x, y) = \\sin (y\\ln x)$. What is the rate of change of $g(x, y)$ at the point $(e, π)$ in the direction in which the function increases most rapidly?"} {:db/id #edb/ref 17592186265978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a5cc75b-1aa1-5b30-9362-5f8752961da4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186263250} {:answer/id #uuid "1d98f894-779c-5822-84b3-85b9a53ad6b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186263271} {:answer/id #uuid "4efb98a8-8a82-5879-9aee-9a09d6afe439" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263687} {:answer/id #uuid "bcb30fc7-6c64-5f56-9344-f70ad5eab684" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264636} {:answer/id #uuid "e5a55fec-f5cc-59e3-8bae-75fcaf8ea6a0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265001}] :answer-field/correct {:answer/id #uuid "e5a55fec-f5cc-59e3-8bae-75fcaf8ea6a0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265001} :answer-field/id #uuid "f0ef6581-d8af-5b79-a84d-4f8dc281dbef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265678}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "129e769a-9e81-5bb8-a357-71dd7d678811" :question/math-academy-id "q-130801" :question/problem "Consider the function $g(x,y)=\\frac{x}{y}+\\frac{y}{x}.$ What is the rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of the vector $v=⟨1,-\\sqrt{2}⟩?$" :question/worked-solution "The rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(-1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{1}^{2}+(-\\sqrt{2})^{2}}=\\sqrt{3} \\\\ u & =\\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇g(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{x}{y}+\\frac{y}{x}),\\,\\frac{∂}{∂y}(\\frac{x}{y}+\\frac{y}{x})⟩ \\\\  & =⟨\\frac{1}{y}-\\frac{y}{{x}^{2}},\\,\\frac{1}{x}-\\frac{x}{{y}^{2}}⟩ \\\\ ∇g(-1,1) & =⟨\\frac{1}{1}-\\frac{1}{(-1)^{2}},\\frac{1}{(-1)}-\\frac{(-1)}{{1}^{2}}⟩ \\\\  & =⟨0,0⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(-1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(-1,1) & =∇g(-1,1)\\cdot u \\\\  & =⟨0,0⟩\\cdot \\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩ \\\\  & =\\frac{0(1)+0(-\\sqrt{2})}{\\sqrt{3}} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f931965-4230-53c9-9c4e-51f593f9d015" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186321267} {:answer/id #uuid "57f67efd-2b45-5e67-a5e4-4b0fd709ba1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{8}" :db/id #edb/ref 17592186321837} {:answer/id #uuid "7b1a8d46-fbc3-5f92-8b69-6709f7023c5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{80}" :db/id #edb/ref 17592186322114} {:answer/id #uuid "cda4641b-3880-5a2f-a60a-2d4b84c1090a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186322750} {:answer/id #uuid "d4216551-4828-50f1-870a-15d1ba740ddb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{82}" :db/id #edb/ref 17592186322802}] :answer-field/correct {:answer/id #uuid "d4216551-4828-50f1-870a-15d1ba740ddb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{82}" :db/id #edb/ref 17592186322802} :answer-field/id #uuid "9e6c5b32-a96f-564b-b174-aa4099e65f9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323476}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a13cba05-5f4a-5d75-8f65-f72eb54e0d73" :question/math-academy-id "q-36300" :question/problem "Consider the function $f(x,y)=2xy+{e}^{3x-y}.$ What is the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction in which the function decreases most rapidly?" :question/worked-solution "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(1,3):$\n\n$$\n\\begin{aligned}-∇\\,f(x,y) & =-\\frac{∂}{∂x}(2xy+{e}^{3x-y})\\text{ }i-\\frac{∂}{∂y}(2xy+{e}^{3x-y})\\text{ }j \\\\  & =-(2y+3{e}^{3x-y})\\text{ }i-(2x-{e}^{3x-y})\\text{ }j \\\\ -∇\\,f(1,3) & =-(2\\cdot 3+3\\cdot {e}^{3\\cdot 1-3})\\text{ }i-(2\\cdot 1-{e}^{3\\cdot 1-3})\\text{ }j \\\\  & =-9\\text{ }i-\\text{ }j\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction of $-∇f(1,3)$ is given by\n\n$$\n\\begin{aligned}‖-∇\\,f(1,3)‖ & =‖-9\\text{ }i-\\text{ }j‖ \\\\  & =\\sqrt{(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{82}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8837b541-d3d8-5ebe-8ea8-af61591cb6fa" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186322232} {:answer/id #uuid "b6f03f12-e1ac-5472-a11e-f1f87bcd9621" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186322572} {:answer/id #uuid "c1717e43-53c5-54f5-8c5f-68df4b9cfd08" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322650} {:answer/id #uuid "d2a54f97-4039-5587-a94f-458a55a1776d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186322792} {:answer/id #uuid "f7ef68e3-e12b-57d6-890b-83987a1922bd" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186323097}] :answer-field/correct {:answer/id #uuid "d2a54f97-4039-5587-a94f-458a55a1776d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186322792} :answer-field/id #uuid "4a40605a-36ce-555d-abab-e5a81e672aeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a0c033d-5079-51f1-a44e-c13c59694293" :question/math-academy-id "q-37083" :question/problem "Consider the function $f(x,y)=(x+y)\\operatorname{ln}⁡(x+y).$ What is the rate of change of $f(x,y)$ at the point $(2,-1)$ in the direction in which the function decreases most rapidly?" :question/worked-solution "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(2,-1):$\n\n$$\n\\begin{aligned}-∇\\,f(x,y) & =-\\frac{∂}{∂x}((x+y)\\operatorname{ln}⁡(x+y))\\text{ }i-\\frac{∂}{∂y}((x+y)\\operatorname{ln}⁡(x+y))\\text{ }j \\\\  & =(\\operatorname{ln}⁡(x+y)+1)\\text{ }i+(\\operatorname{ln}⁡(x+y)+1)\\text{ }j \\\\ -∇\\,f(2,-1) & =-(\\operatorname{ln}⁡(2-1)+1)i-(\\operatorname{ln}⁡(2-1)+1)j \\\\  & =-i-j\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(2,-1)$ in the direction of $-∇f(2,-1)$ is given by\n\n$$\n\\begin{aligned}‖-∇\\,f(2,-1)‖ & =‖-i-j‖ \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209d039-cd49-5b32-a5a2-fccba4c4ad04" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\sqrt{2}" :db/id #edb/ref 17592186348739} {:answer/id #uuid "2f701612-723b-57b5-8841-6b161d28a285" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{\\sqrt{2}}" :db/id #edb/ref 17592186348867} {:answer/id #uuid "aa56a022-8acc-58dd-9945-dec0f389f84c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\pi " :db/id #edb/ref 17592186349960} {:answer/id #uuid "b2decfd4-db20-5142-a782-96a864cc1cbe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{\\sqrt{2}}" :db/id #edb/ref 17592186350030} {:answer/id #uuid "eedbad12-eb1d-52b0-b11b-38c97411879b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186350537}] :answer-field/correct {:answer/id #uuid "2f701612-723b-57b5-8841-6b161d28a285" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{\\sqrt{2}}" :db/id #edb/ref 17592186348867} :answer-field/id #uuid "b045770b-be7d-51e7-a88e-a4035b50e4fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351008}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e60c4cce-b8b4-5a37-8e5f-19c98e4b5e86" :question/math-academy-id "q-83608" :question/problem "Consider the function $g(x,y)=\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy.$ What is the rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of the vector $v=⟨-2,2⟩?$" :question/worked-solution "The rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{(-2)^{2}+{2}^{2}}=2\\sqrt{2} \\\\ u & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇\\,g(x,y)$ and evaluate it at the point $(1,1):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy),\\,\\frac{∂}{∂y}(\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy)⟩ \\\\  & =⟨\\frac{\\pi \\operatorname{cos}⁡(\\pi x)}{y}+\\pi y,\\,-\\frac{\\operatorname{sin}⁡(\\pi x)}{{y}^{2}}+\\pi x⟩ \\\\ ∇\\,g(1,1) & =⟨\\frac{\\pi \\operatorname{cos}⁡(\\pi \\cdot 1)}{1}+\\pi \\cdot 1,\\,-\\frac{\\operatorname{sin}⁡(\\pi \\cdot 1)}{{1}^{2}}+\\pi \\cdot 1⟩ \\\\  & =⟨-\\pi +\\pi ,0+\\pi ⟩ \\\\  & =⟨0,\\pi ⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(1,1) & =∇\\,g(1,1)\\cdot u \\\\  & =⟨0,\\pi ⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{0\\cdot (-1)+\\pi \\cdot 1}{\\sqrt{2}} \\\\  & =\\frac{\\pi }{\\sqrt{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023898fb-a616-56d4-822f-050c9d7ed901" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}(\\pi -2)" :db/id #edb/ref 17592186348471} {:answer/id #uuid "0d1d16bc-4349-5f72-b0c9-a69b046c4e68" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi -2)" :db/id #edb/ref 17592186348560} {:answer/id #uuid "131969f5-9f12-5738-8e7a-92fb804ff6ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi -\\sqrt{2}" :db/id #edb/ref 17592186348611} {:answer/id #uuid "92759975-27e9-56dd-8a00-cf955f71c7f0" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi +2)" :db/id #edb/ref 17592186349756} {:answer/id #uuid "f2e6ddfc-23e4-505d-a08b-5cfa9e448be9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}(\\pi +2)" :db/id #edb/ref 17592186350577}] :answer-field/correct {:answer/id #uuid "023898fb-a616-56d4-822f-050c9d7ed901" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}(\\pi -2)" :db/id #edb/ref 17592186348471} :answer-field/id #uuid "e4a8d4eb-f7c9-5c5f-88e7-3850845e3558" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351109}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54b4a6ea-a43d-5fa2-b223-b9c52e67cdd7" :question/math-academy-id "q-83613" :question/problem "Consider the function $g(x,y)=2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x.$ What is the rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4})$ in the direction of the vector $v=⟨-1,1⟩?$" :question/worked-solution "The rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4})$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(\\frac{\\pi }{4},\\frac{\\pi }{4}).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{(-1)^{2}+{1}^{2}}=\\sqrt{2} \\\\ u & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇\\,g(x,y)$ and evaluate it at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x),\\,\\frac{∂}{∂y}(2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x)⟩ \\\\  & =⟨2\\operatorname{tan}⁡y-2y{sec}^{2}⁡x,\\,2x{sec}^{2}⁡y-2\\operatorname{tan}⁡x⟩ \\\\ ∇\\,g(\\frac{\\pi }{4},\\frac{\\pi }{4}) & =⟨2\\operatorname{tan}⁡(\\frac{\\pi }{4})-2\\cdot \\frac{\\pi }{4}\\cdot {sec}^{2}⁡(\\frac{\\pi }{4}),\\,2\\cdot \\frac{\\pi }{4}\\cdot {sec}^{2}⁡(\\frac{\\pi }{4})-2\\operatorname{tan}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨2\\cdot 1-\\frac{\\pi }{2}\\cdot 2,\\frac{\\pi }{2}\\cdot 2-2\\cdot 1⟩ \\\\  & =⟨2-\\pi ,\\,\\pi -2⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(\\frac{\\pi }{4},\\frac{\\pi }{4})$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(\\frac{\\pi }{4},\\frac{\\pi }{4}) & =∇\\,g(\\frac{\\pi }{4},\\frac{\\pi }{4})\\cdot u \\\\  & =⟨2-\\pi ,\\pi -2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{(2-\\pi )\\cdot (-1)+(\\pi -2)\\cdot 1}{\\sqrt{2}} \\\\  & =\\frac{2\\pi -4}{\\sqrt{2}} \\\\  & =\\sqrt{2}(\\pi -2).\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Rate of Change of a Function in a Given Direction"}] [{:db/id #edb/ref 17592186124461 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124265 :question/id #uuid "b8884af1-186f-582b-8de2-a137a66649b0" :question/math-academy-id "e-3432" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y) = x^2 + 2y^2 +x$ that passes through the point where $(x,y) = (1, 1).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y) = (1,1)$ can be found by computing $\\nabla f(1,1).$  \n\nSo, we first find the gradient and evaluate it at $(x,y) = (1,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}+2{y}^{2}+x)\\,i+\\frac{∂}{∂y}({x}^{2}+2{y}^{2}+x)\\,j \\\\  & =(2x+0+1)\\,i+(0+4y+0)\\,j \\\\  & =(2x+1)\\,i+4y\\,j \\\\ ∇f(1,1) & =(2(1)+1)\\,i+4(1)\\,j \\\\  & =3\\,i+4\\,j\\end{aligned}\n$$\n\nFinally, since we want a unit normal vector, we normalize $\\nabla f(1,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{∇f(1,1)}{‖∇f(1,1)‖} & =\\frac{3\\,i+4\\,j}{\\sqrt{{3}^{2}+{4}^{2}}} \\\\  & =\\frac{1}{5}(3\\,i+4\\,j)\\end{aligned}\n$$"} :knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d" :knowledge-point/questions [{:db/id #edb/ref 17592186124969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a93dcc0e-bacf-58c5-b6f4-47f43da168f0" :answer/type {:db/ident :answer.type/math} :answer/value "-k" :db/id #edb/ref 17592186122415} {:answer/id #uuid "28b09048-1131-506e-a285-e59ac557f01d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}i + \\frac{1}{\\sqrt{2}}j" :db/id #edb/ref 17592186122416} {:answer/id #uuid "370200a2-bd3f-5447-b9b1-ea23d53237b7" :answer/type {:db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186122417} {:answer/id #uuid "42dfcda5-2b9e-563b-b4e1-fb6d44bf17e7" :answer/type {:db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186122418} {:answer/id #uuid "5b6f5f06-d20e-5856-b8b1-1ac758877073" :answer/type {:db/ident :answer.type/math} :answer/value "-i - j" :db/id #edb/ref 17592186122419}] :answer-field/id #uuid "37f65865-99f1-54aa-953e-7c631fab08cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122414}] :question/id #uuid "9e917aee-92ff-5d58-8526-d5d5bb6b5240" :question/math-academy-id "q-36311" :question/problem "Find a unit normal vector to the level curve of the function $f(x, y) = 2x^{2} + 2y^{2} - y$ that passes through the point where $(x, y) = (0, 1)$."} {:db/id #edb/ref 17592186124978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f27d5774-1d7f-5ab4-89fe-a21d12c54d80" :answer/type {:db/ident :answer.type/math} :answer/value "7i - 12j" :db/id #edb/ref 17592186122469} {:answer/id #uuid "0c98f74f-ddb3-5180-b0de-0967ea8e4636" :answer/type {:db/ident :answer.type/math} :answer/value "7i + 7j" :db/id #edb/ref 17592186122470} {:answer/id #uuid "28fd0a19-0ae3-560f-bf90-dd64e91b6777" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(i + 2j)" :db/id #edb/ref 17592186122471} {:answer/id #uuid "4079226d-5808-50e6-a05b-af629030f084" :answer/type {:db/ident :answer.type/math} :answer/value "i - 4j" :db/id #edb/ref 17592186122472} {:answer/id #uuid "4165f948-3799-5c70-a272-874ae43fc465" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(2i + j)" :db/id #edb/ref 17592186122473}] :answer-field/id #uuid "b33a5905-3216-54dd-ad86-072ac416bdd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122468}] :question/id #uuid "5e2999c4-1892-5dd4-a533-5ed9b93e52c1" :question/math-academy-id "q-36378" :question/problem "Find a unit normal vector to the level curve of the function $f(x, y) = 2x + 4y + 5xy$ that passes through the point where $(x, y) = (2, 1)$."} {:db/id #edb/ref 17592186265871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1441a2d6-6646-53cf-910b-640be6a3ce12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186263189} {:answer/id #uuid "1d83c4d7-e29e-518f-8d81-fc678900ebe8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(i+2\\,j)" :db/id #edb/ref 17592186263270} {:answer/id #uuid "3151187a-5967-53d5-ae4b-7ac589aab55a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186263421} {:answer/id #uuid "5d332831-6792-53d3-9b0e-7703fcddae9d" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186263808} {:answer/id #uuid "970e8c1f-d7a6-5f66-9d87-f248bc2ef3cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(2\\,i+j)" :db/id #edb/ref 17592186264293}] :answer-field/correct {:answer/id #uuid "1441a2d6-6646-53cf-910b-640be6a3ce12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186263189} :answer-field/id #uuid "2376d46b-16ff-5b21-93b2-796a7646d0b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265308}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3aa96b9c-802f-5254-a50f-7fd477588b2c" :question/math-academy-id "q-130271" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\sqrt{x}+2\\sqrt{y}$ that passes through the point where $(x,y)=(1,4).$" :question/worked-solution "A normal vector to the level curve that passes through the point $(x,y)=(1,4)$ can be found by computing $∇f(1,4).$ \n\nSo, we first find the gradient and evaluate it at $(x,y)=(1,4):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\sqrt{x}+2\\sqrt{y})\\,i+\\frac{∂}{∂y}(\\sqrt{x}+2\\sqrt{y})\\,j \\\\  & =\\frac{1}{2\\sqrt{x}}\\,i+\\frac{1}{\\sqrt{y}}\\,j \\\\ ∇f(1,4) & =\\frac{1}{2\\sqrt{1}}\\,i+\\frac{1}{\\sqrt{4}}\\,j \\\\  & =\\frac{1}{2}\\,i+\\frac{1}{2}\\,j \\\\  & =\\frac{1}{2}(i+j)\\end{aligned}\n$$\n\nFinally, we normalize $∇f(1,4):$\n\n$$\n\\begin{aligned}\\frac{∇f(1,4)}{‖∇f(1,4)‖} & =\\frac{\\frac{1}{2}(i+j)}{‖\\frac{1}{2}(i+j)‖} \\\\  & =\\frac{1}{(\\frac{1}{2}\\sqrt{{1}^{2}+{1}^{2}})}\\cdot \\frac{1}{2}(i+j) \\\\  & =\\frac{1}{\\sqrt{2}}(i+j) \\\\  & =\\frac{\\sqrt{2}}{2}(i+j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "478e5238-b82e-52a7-b916-e3176ac5c7a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186321709} {:answer/id #uuid "64e34a4f-d3ec-50b3-936b-5c2fc27ddda9" :answer/type {:db/ident :answer.type/math} :answer/value "i+j" :db/id #edb/ref 17592186321930} {:answer/id #uuid "b7c06b6f-03ce-5422-811e-bdf364365b2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}(i+j)" :db/id #edb/ref 17592186322577} {:answer/id #uuid "cd17be78-1f08-5dc6-b596-77159cdc94ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}(i-j)" :db/id #edb/ref 17592186322743} {:answer/id #uuid "e8f19b61-a2d2-5713-a47b-f64a9abfebff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186322974}] :answer-field/correct {:answer/id #uuid "e8f19b61-a2d2-5713-a47b-f64a9abfebff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186322974} :answer-field/id #uuid "d9d79ebc-11b5-5629-a6fc-dd3e1f57e714" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323599}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "51e044b0-3c0e-5644-831b-0d5fd92a4af2" :question/math-academy-id "q-36346" :question/problem "Find a unit normal vector to the level curve of the function $g(x,y)=\\operatorname{ln}⁡(xy)$ that passes through the point where $(x,y)=(1,1).$" :question/worked-solution "A normal vector to the level curve that passes through the point  where $(x,y)=(1,1)$, can be found by computing $∇g(1,1).$ \n\nSo, we first find the gradient of $g(x,y)$ and evaluate it at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}∇g(x,y) & ={g}_{x}(x,y)\\,i+{g}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))\\,j \\\\  & =\\frac{1}{xy}\\cdot y\\,i+\\frac{1}{xy}\\cdot x\\,j \\\\  & =\\frac{1}{x}\\,i+\\frac{1}{y}\\,j \\\\ ∇g(1,1) & =\\frac{1}{(1)}\\,i+\\frac{1}{(1)}\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇g(1,1):$\n\n$$\n\\begin{aligned}\\frac{∇g(1,1)}{‖∇g(1,1)‖} & =\\frac{i+j}{\\sqrt{{1}^{2}+{1}^{2}}} \\\\  & =\\frac{\\sqrt{2}}{2}(i+j)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157bc3da-2d1c-5137-b516-d8ff7c42bad7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186336235} {:answer/id #uuid "3cfe7ebf-3262-597f-b2fd-edf534fd618c" :answer/type {:db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186336607} {:answer/id #uuid "4baa559e-cde4-5072-9145-09ac20cb641a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186336735} {:answer/id #uuid "829583d7-8e78-579d-9221-64ce8b48dc24" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(i-j)" :db/id #edb/ref 17592186337220} {:answer/id #uuid "e26af925-4997-53e5-8b3d-7425b92d8e93" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186338003}] :answer-field/correct {:answer/id #uuid "4baa559e-cde4-5072-9145-09ac20cb641a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186336735} :answer-field/id #uuid "e48649d2-bf76-55fc-aef9-b0aff8e82c8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338680}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "22cfc584-e8e6-55e0-a1d3-35d71c5742a0" :question/math-academy-id "q-71370" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)={x}^{2}+{y}^{2}$ that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2}).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2})$, can be found by computing $∇f(-\\frac{1}{2},\\frac{1}{2}).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\text{ }i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\text{ }j \\\\  & =2x\\text{ }i+2y\\text{ }j \\\\ ∇f(-\\frac{1}{2},\\frac{1}{2}) & =2(-\\frac{1}{2})\\text{ }i+2(\\frac{1}{2})\\text{ }j \\\\  & =-i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∇f(-\\frac{1}{2},\\frac{1}{2})}{‖∇f(-\\frac{1}{2},\\frac{1}{2})‖} & =\\frac{-i+j}{\\sqrt{(-1)^{2}+(1)^{2}}} \\\\  & =\\frac{-i+j}{\\sqrt{2}} \\\\  & =-\\frac{\\sqrt{2}}{2}(i-j)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049b7f23-d6a7-5be3-a6ca-ac19b8a84234" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186336070} {:answer/id #uuid "123c36c6-7310-581c-8de4-b675e090dc56" :answer/type {:db/ident :answer.type/math} :answer/value "i+i" :db/id #edb/ref 17592186336203} {:answer/id #uuid "4b49d759-d015-5843-b6e9-3497dc09edfe" :answer/type {:db/ident :answer.type/math} :answer/value "i-i" :db/id #edb/ref 17592186336730} {:answer/id #uuid "6e16ffd6-406d-50b5-9b6a-0f4b899fc6bd" :answer/type {:db/ident :answer.type/math} :answer/value "-i" :db/id #edb/ref 17592186337009} {:answer/id #uuid "ccd3f738-ef19-5d09-afcb-04a5b6bdd7fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(-2i+i)" :db/id #edb/ref 17592186337828}] :answer-field/correct {:answer/id #uuid "6e16ffd6-406d-50b5-9b6a-0f4b899fc6bd" :answer/type {:db/ident :answer.type/math} :answer/value "-i" :db/id #edb/ref 17592186337009} :answer-field/id #uuid "60184a90-8959-560b-aa4a-378830d13dbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338445}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "436e814d-020d-5b28-b909-495bbb1c431a" :question/math-academy-id "q-71374" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=x+3y-2xy$ that passes through the point where $(x,y)=(\\frac{3}{2},1).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(\\frac{3}{2},1)$, can be found by computing $∇f(\\frac{3}{2},1).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x+3y-2xy)\\text{ }i+\\frac{∂}{∂y}(x+3y-2xy)\\text{ }j \\\\  & =(1-2y)\\text{ }i+(3-2x)\\text{ }j \\\\ ∇f(\\frac{3}{2},1) & =(1-2(1))\\text{ }i+(3-2(\\frac{3}{2}))\\text{ }j \\\\  & =-i\\end{aligned}\n$$\n\nFinally, we normalize $∇f(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∇f(\\frac{3}{2},1)}{‖∇f(\\frac{3}{2},1)‖} & =\\frac{-i}{1}=-i\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2372ab35-9f15-566a-9150-808733fd4bb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(i-j)" :db/id #edb/ref 17592186336363} {:answer/id #uuid "2630b03f-d66e-5733-b918-78baaf9f7ded" :answer/type {:db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186336392} {:answer/id #uuid "e77b993b-c3bb-5f5a-9474-9bd52741e5b2" :answer/type {:db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186338055} {:answer/id #uuid "e9097253-bc27-5ce4-8fb8-daded67d09c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186338066} {:answer/id #uuid "f6a289db-1c93-5c45-ab8f-caa51a0ee7e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186338195}] :answer-field/correct {:answer/id #uuid "f6a289db-1c93-5c45-ab8f-caa51a0ee7e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186338195} :answer-field/id #uuid "1d94b131-873d-56a9-92e8-a2ed25af773a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338331}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1092dcda-9470-51be-bb7f-4be55bcc6069" :question/math-academy-id "q-71381" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)={e}^{x+y}+x+y$ that passes through the point where $(x,y)=(0,0).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(0,0)$, can be found by computing $∇f(0,0).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(0,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({e}^{x+y}+x+y)\\text{ }i+\\frac{∂}{∂y}({e}^{x+y}+x+y)\\text{ }j \\\\  & =({e}^{x+y}+1)\\text{ }i+({e}^{x+y}+1)\\text{ }j \\\\ ∇f(0,0) & =({e}^{0+0}+1)\\text{ }i+({e}^{0+0}+1)\\text{ }j \\\\  & =2i+2j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(0,0):$\n\n$$\n\\begin{aligned}\\frac{∇f(0,0)}{‖∇f(0,0)‖} & =\\frac{2i+2j}{\\sqrt{(2)^{2}+(2)^{2}}} \\\\  & =\\frac{2i+2j}{2\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}(i+j)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1239f96f-2e4e-508d-a9f2-75796efa86a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{10}(4\\,i+2\\,j)" :db/id #edb/ref 17592186383155} {:answer/id #uuid "45a77767-f45c-5c88-af82-5221a5fbd33b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(\\,i-2\\,j)" :db/id #edb/ref 17592186383156} {:answer/id #uuid "33650346-32bd-534a-a64c-45e97e73fd4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(2\\,j-j)" :db/id #edb/ref 17592186383157} {:answer/id #uuid "64e6389b-f8ce-50bf-a097-05a8b301d96c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\,i-\\,j)" :db/id #edb/ref 17592186383158} {:answer/id #uuid "d73cf648-7973-5ea5-aece-b31b3cb3d9d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{10}(2\\,i+4\\,j)" :db/id #edb/ref 17592186383159}] :answer-field/correct {:answer/id #uuid "45a77767-f45c-5c88-af82-5221a5fbd33b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(\\,i-2\\,j)" :db/id #edb/ref 17592186383156} :answer-field/id #uuid "876e06ec-0ab3-5cfb-b188-15f5d0a5be15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383154}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cee7213b-050a-5cea-8e38-6fcbc59025d4" :question/math-academy-id "q-129892" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\frac{x+y}{x-y}$ that passes through the point where $(x,y)=(-2,-1).$" :question/worked-solution "A normal vector to the level curve that passes through the point $(x,y)=(-2,-1)$ can be found by computing $∇f(-2,-1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y)=(-2,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\frac{x+y}{x-y})\\,i+\\frac{∂}{∂y}(\\frac{x+y}{x-y})\\,j \\\\  & =\\frac{1(x-y)-(x+y)(1)}{(x-y)^{2}}\\,i+\\frac{1(x-y)-(x+y)(-1)}{(x-y)^{2}}\\,j \\\\  & =-\\frac{2y}{(x-y)^{2}}\\,i+\\frac{2x}{(x-y)^{2}}\\,j \\\\ ∇f(-2,-1) & =-\\frac{2(-1)}{(-2-(-1))^{2}}\\,i+\\frac{2(-2)}{(-2-(-1))^{2}}\\,j \\\\  & =2\\,i-4\\,j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(-2,-1):$\n\n$$\n\\begin{aligned}\\frac{∇f(-2,-1)}{‖∇f(-2,-1)‖} & =\\frac{2\\,i-4\\,j}{\\sqrt{{2}^{2}+(-4)^{2}}} \\\\  & =\\frac{1}{2\\sqrt{5}}(2\\,i-4\\,j) \\\\  & =\\frac{1}{\\sqrt{5}}(i-2\\,j) \\\\  & =\\frac{\\sqrt{5}}{5}(\\,i-2\\,j)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce66abc2-1493-50b5-a986-b312bd69b0d3" :answer/type {:db/ident :answer.type/math} :answer/value "i-j" :db/id #edb/ref 17592186383162} {:answer/id #uuid "97a0676c-47bb-533c-80d9-c0d75ef46077" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(-i+j)" :db/id #edb/ref 17592186383163} {:answer/id #uuid "83aa1130-305c-5cb1-ac5b-814ca52426a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186383164} {:answer/id #uuid "21c379b6-9115-5238-9915-dbace494a5e0" :answer/type {:db/ident :answer.type/math} :answer/value "i+j" :db/id #edb/ref 17592186383165} {:answer/id #uuid "e6bd01d5-5f84-5141-bac1-7784075d4ae4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186383166}] :answer-field/correct {:answer/id #uuid "83aa1130-305c-5cb1-ac5b-814ca52426a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186383164} :answer-field/id #uuid "20194f88-b71b-5ea3-a75b-4873d6a1dd62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383161}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d9318eb5-4446-512c-876e-9868eec1bc8a" :question/math-academy-id "q-130274" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\operatorname{arctan}⁡(\\frac{y}{x})$ that passes through the point where $(x,y)=(2,-2).$" :question/worked-solution "A normal vector to the level curve that passes through the point $(x,y)=(2,-2)$ can be found by computing $∇f(2,-2).$ \n\nSo, we first find the gradient and evaluate it at $(x,y)=(2,-2):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(\\frac{y}{x}))i+\\frac{∂}{∂y}(\\operatorname{arctan}⁡(\\frac{y}{x}))j \\\\  & =\\frac{(-\\frac{y}{{x}^{2}})}{1+{(\\frac{y}{x})}^{2}}\\,i+\\frac{(\\frac{1}{x})}{1+{(\\frac{y}{x})}^{2}}\\,j \\\\  & =-\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j \\\\ ∇f(2,-2) & =-\\frac{(-2)}{{2}^{2}+(-2)^{2}}\\,i+\\frac{2}{{2}^{2}+(-2)^{2}}\\,j \\\\  & =\\frac{2}{8}\\,i+\\frac{2}{8}\\,j \\\\  & =\\frac{1}{4}(i+j)\\end{aligned}\n$$\n\nFinally, we normalize $∇f(2,-2):$\n\n$$\n\\begin{aligned}\\frac{∇f(2,-2)}{‖∇f(2,-2)‖} & =\\frac{\\frac{1}{4}(i+j)}{‖\\frac{1}{4}(i+j)‖} \\\\  & =\\frac{1}{(\\frac{1}{4}\\cdot \\sqrt{{1}^{2}+{1}^{2}})}\\cdot \\frac{1}{4}(i+j) \\\\  & =\\frac{1}{\\sqrt{2}}(i+j) \\\\  & =\\frac{\\sqrt{2}}{2}(i+j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79312bdb-f048-5202-b77a-86cf88a3b986" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{41}}{41}(5i+4j)" :db/id #edb/ref 17592186385510} {:answer/id #uuid "8d705007-aa0c-5cde-a573-738e2aff9dca" :answer/type {:db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186385511} {:answer/id #uuid "03fdb318-277a-5b7b-bf02-538ad5ca1565" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186385512} {:answer/id #uuid "b9c5a255-ae95-5c0d-ae54-45b0dbd4189d" :answer/type {:db/ident :answer.type/math} :answer/value "j" :db/id #edb/ref 17592186385513} {:answer/id #uuid "ab101cb8-1cc9-52ea-95e4-ec2e563d3dc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{41}}{41}(5i-4j)" :db/id #edb/ref 17592186385514}] :answer-field/correct {:answer/id #uuid "ab101cb8-1cc9-52ea-95e4-ec2e563d3dc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{41}}{41}(5i-4j)" :db/id #edb/ref 17592186385514} :answer-field/id #uuid "20d844bc-8ba7-554c-ae01-efce8b8ec0bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385509}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "522c74bc-3c1b-5bd8-a1b2-9e3f5a7b89a7" :question/math-academy-id "q-71383" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\sqrt{{x}^{2}-{y}^{2}}$ that passes through the point where $(x,y)=(5,4).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(5,4)$, can be found by computing $∇f(5,4).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(5,4):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}-{y}^{2}})\\text{ }i+\\frac{∂}{∂y}(\\sqrt{{x}^{2}-{y}^{2}})\\text{ }j \\\\  & =\\frac{x}{\\sqrt{{x}^{2}-{y}^{2}}}\\text{ }i-\\frac{y}{\\sqrt{{x}^{2}-{y}^{2}}}\\text{ }j \\\\ ∇f(5,4) & =\\frac{5}{\\sqrt{(5)^{2}-(4)^{2}}}\\text{ }i-\\frac{4}{\\sqrt{(5)^{2}-(4)^{2}}}\\text{ }j \\\\  & =\\frac{5}{\\sqrt{9}}i-\\frac{4}{\\sqrt{9}}j \\\\  & =\\frac{5}{3}i-\\frac{4}{3}j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(5,4):$\n\n$$\n\\begin{aligned}\\frac{∇f(5,4)}{‖∇f(5,4)‖} & =\\frac{\\frac{5}{3}i-\\frac{4}{3}j}{\\sqrt{{(\\frac{5}{3})}^{2}+{(-\\frac{4}{3})}^{2}}} \\\\  & =\\frac{\\frac{5}{3}i-\\frac{4}{3}j}{\\frac{\\sqrt{41}}{3}} \\\\  & =\\frac{\\sqrt{41}}{41}(5i-4j)\\end{aligned}\n$$"}] :knowledge-point/title "Finding a Normal Vector to a Level Curve"}]}
