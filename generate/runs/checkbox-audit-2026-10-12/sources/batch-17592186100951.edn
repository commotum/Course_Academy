dd-5e1a-8086-20e6009f70ea" :question/math-academy-id "q-125611" :question/problem "Consider the highlighted entry of the matrix $Y$ given below. Describe it in terms of ${y}_{ij}.$\n\n$$\nY=[\\begin{aligned}2 & 1 \\\\ -4 & 5 \\\\ 0 & 0 \\\\ 1 & 7\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $4$th row and $2$nd column. Hence, we have ${y}_{42}=7.$"} {:db/id #edb/ref 17592186400702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53bc7c4a-ec03-5241-b616-ab551e2b27cc" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{21}" :db/id #edb/ref 17592186400704} {:answer/id #uuid "3b70af93-f0df-596a-b13f-d4cefebb16dd" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{13}" :db/id #edb/ref 17592186400705} {:answer/id #uuid "710c1a23-9554-5a6a-91ac-2f16e51847e1" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{43}" :db/id #edb/ref 17592186400706} {:answer/id #uuid "64372579-911a-5351-8eec-53ed6b8d3b83" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{22}" :db/id #edb/ref 17592186400707} {:answer/id #uuid "437a5fab-d07b-5f08-b95c-d799c5a714f7" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{34}" :db/id #edb/ref 17592186400708}] :answer-field/correct {:answer/id #uuid "437a5fab-d07b-5f08-b95c-d799c5a714f7" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{34}" :db/id #edb/ref 17592186400708} :answer-field/id #uuid "d6c4d5fd-03ba-51d6-8190-92d4e4a4e499" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400703}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "76f61515-4e83-5716-8dff-d44543d61f70" :question/math-academy-id "q-13499" :question/problem "Consider the highlighted entry of the matrix $A$ given below. Describe it in terms of ${a}_{ij}.$\n\n$$\nA=[\\begin{aligned}3 & 5 & 10 & 6 \\\\ 6 & 14 & 8 & 1 \\\\ 9 & 17 & 9 & 0\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $3$rd row and $4$th column. Hence, we have ${a}_{34}=0.$"}] :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] [{:db/id #edb/ref 17592186105732 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105590 :question/id #uuid "957d070a-edc8-521f-a5bd-d10177a0bdbc" :question/math-academy-id "e-4344" :question/problem "Calculate the area of the triangle spanned by $\\mathbf{a}=\\langle 4,0,-3 \\rangle$ and $\\mathbf{b}=\\langle 5,-1,2 \\rangle.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 0 & -3 \\\\ 5 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -3 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}4 & -3 \\\\ 5 & 2\\end{aligned}|j+|\\begin{aligned}4 & 0 \\\\ 5 & -1\\end{aligned}|k \\\\  & =(0\\cdot 2-(-3)\\cdot (-1))i-(4\\cdot 2-(-3)\\cdot 5)j+(4\\cdot (-1)-0\\cdot 5)k \\\\  & =-3i-23j-4k \\\\  & =⟨-3,-23,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{(-3)^{2}+(-23)^{2}+(-4)^{2}} \\\\  & =\\sqrt{554}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\nA_{\\triangle} = \\dfrac{1}{2}A = \\dfrac{\\sqrt{554}}{2}.\n$$"} :knowledge-point/id #uuid "f88dd688-449b-5a6d-8b91-78d00d0c932b" :knowledge-point/questions [{:db/id #edb/ref 17592186106120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2513eb07-16be-5286-bc33-d8aa8c46c1cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{273}}{2}" :db/id #edb/ref 17592186285112} {:answer/id #uuid "66423ab8-fae7-5127-a7c3-1cdcd20b4cdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{285}}{2}" :db/id #edb/ref 17592186285714} {:answer/id #uuid "6eb9250a-2aa6-5790-8265-790a777b83b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{825}}{2}" :db/id #edb/ref 17592186285813} {:answer/id #uuid "d4231ebb-ea19-5c2a-a034-0b7b57f48b39" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{177}" :db/id #edb/ref 17592186286716} {:answer/id #uuid "d4b9c672-c12b-55d0-930a-778da5483675" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{582}}{2}" :db/id #edb/ref 17592186286720}] :answer-field/correct {:answer/id #uuid "66423ab8-fae7-5127-a7c3-1cdcd20b4cdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{285}}{2}" :db/id #edb/ref 17592186285714} :answer-field/id #uuid "ac35f525-4afb-57b4-9fa8-5e8beb00c4c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287501}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9432694c-4fbd-5497-812b-7bbf4e4f27ac" :question/math-academy-id "q-19983" :question/problem "Calculate the area of the triangle spanned by $a=⟨1,3,2⟩$ and $b=⟨4,1,-2⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 3 & 2 \\\\ 4 & 1 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ 1 & -2\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 4 & -2\\end{aligned}|j+|\\begin{aligned}1 & 3 \\\\ 4 & 1\\end{aligned}|k \\\\  & =(3\\cdot (-2)-1\\cdot 2)i-(1\\cdot (-2)-4\\cdot 2)j+(1\\cdot 1-4\\cdot 3)k \\\\  & =-8i+10j-11k \\\\  & =⟨-8,10,-11⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{(-8)^{2}+{10}^{2}+(-11)^{2}} \\\\  & =\\sqrt{285}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{285}}{2}.\n$$"} {:db/id #edb/ref 17592186106121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ac7131d-bfd4-5f3e-bab3-45391fafe62f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186102603} {:answer/id #uuid "b7e95b0b-62a1-5619-b9ab-2516eedd3655" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186102604} {:answer/id #uuid "c37bf917-2973-5eae-ac60-dce80a07a630" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186102605} {:answer/id #uuid "c93f0b80-d4cf-5996-b664-2fe92fe080b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186102606} {:answer/id #uuid "50747cd8-e107-55b8-bc9e-602c96d71358" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186102607}] :answer-field/id #uuid "89c92172-1d2c-5b8b-affa-31d099647b03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102602}] :question/id #uuid "38aabf32-76e6-58d5-9143-a45f8b36d698" :question/math-academy-id "q-20003" :question/problem "Calculate the area of the parallelogram spanned by $a = ⟨ - 2,-3,-1⟩$ and $b = ⟨1, 2, 1⟩$."} {:db/id #edb/ref 17592186287886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f5744ef-1b8e-5152-8f6b-6c58808e05e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186285821} {:answer/id #uuid "75a1e7cc-e3a2-51b8-bca9-b3b300d0756f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285880} {:answer/id #uuid "a39acd59-c1ec-51d0-a69d-f4370d5bdf1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186286288} {:answer/id #uuid "ac05f264-0ba2-5898-bdea-abf6a84471dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186286361} {:answer/id #uuid "dd89447a-889f-5b9e-92e0-00cf6cf24813" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186286804}] :answer-field/correct {:answer/id #uuid "a39acd59-c1ec-51d0-a69d-f4370d5bdf1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186286288} :answer-field/id #uuid "6af7f554-1c70-5cd5-8470-5c00835248b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287372}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8ddbfd2e-178a-532d-aeb2-81eedf1fe8dc" :question/math-academy-id "q-18580" :question/problem "Calculate the area of the triangle spanned by $r=⟨1,-2,3⟩$ and $t=⟨0,1,-2⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}r\\times t & =|\\begin{aligned}i & j & k \\\\ 1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & -2\\end{aligned}|i-|\\begin{aligned}1 & 3 \\\\ 0 & -2\\end{aligned}|j+|\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}|k \\\\  & =((-2)\\cdot (-2)-3\\cdot 1)i-(1\\cdot (-2)-3\\cdot 0)j+(1\\cdot 1-(-2)\\cdot 0)k \\\\  & =i+2j+k \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,r\\times t\\,| \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{6}}{2}.\n$$"} {:db/id #edb/ref 17592186287968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31831168-454f-5baf-9173-586eba9d4624" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{2}" :db/id #edb/ref 17592186285238} {:answer/id #uuid "3b19523e-0825-5461-afc4-1afb51acc0f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{3}" :db/id #edb/ref 17592186285344} {:answer/id #uuid "6c0bab51-aa06-5633-ad7e-cad3