g:\n\n|  |  | To: |  |  |  |\n| --- | --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** | **D** |\n| From: | **A** | $0$ | $1$ | $2$ | $0$ |\n| **B** | $2$ | $0$ | $1$ | $0$ |  |\n| **C** | $1$ | $0$ | $0$ | $2$ |  |\n| **D** | $0$ | $1$ | $1$ | $0$ |  |"} {:db/id #edb/ref 17592186299760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d816bd-9665-55ec-afab-acba6f96d302" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297646}] :answer-field/correct {:answer/id #uuid "15d816bd-9665-55ec-afab-acba6f96d302" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297646} :answer-field/id #uuid "17404f51-6ab8-54f3-998b-0d6184eaf10c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298721} {:answer-field/choices [{:answer/id #uuid "38925505-1deb-541b-9845-6f04a152eb3a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297777}] :answer-field/correct {:answer/id #uuid "38925505-1deb-541b-9845-6f04a152eb3a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297777} :answer-field/id #uuid "de503228-55fa-51f7-b201-55d95f0b171e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299391} {:answer-field/choices [{:answer/id #uuid "5103616d-e721-5201-b16d-cf56d020e42f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297891}] :answer-field/correct {:answer/id #uuid "5103616d-e721-5201-b16d-cf56d020e42f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297891} :answer-field/id #uuid "f5fd00cc-3f42-51ad-a172-24b12fe37e45" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299470}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b4dd82a5-6212-589b-b