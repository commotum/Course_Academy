 $B$ to $B,$ and so $b=1.$\n\n- There are no arrows starting at Station C and ending at Station A. So, there are no routes from $C$ to $A,$ and so $c=0.$\n\nAs a result, our route matrix is the following:\n\n<table align=\"center\" cellpadding=\"10\" rules=\"all\">\n<tbody><tr>\n<td></td>\n<td></td>\n<td align=\"center\" colspan=\"3\">To:</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\"><b>A</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\"><b>B</b></td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\"><b>C</b></td>\n</tr>\n<tr>\n<td align=\"center\" rowspan=\"3\">From:</td>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\"><b>A</b></td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$0$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\"><b>B</b></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$2$</td>\n</tr>\n<tr>\n<td align=\"center\" bgcolor=\"#D6EAF8\" width=\"30\"><b>C</b></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$1$</td>\n<td align=\"center\">$0$</td>\n</tr>\n</tbody></table>\n\nTherefore, \n\n$$\na+b+c=1+1+0=2.\n$$"} {:db/id #edb/ref 17592186271965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53144731-7725-5907-918b-d5713b670e0d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270007} {:answer/id #uuid "5a44cfba-69bd-514f-beb9-1f9c988affe3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270072} {:answer/id #uuid "60c809fd-5f78-5ac9-aa54-4cdd1b54286e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270124} {:answer/id #uuid "70398bab-0b9a-5aa7-adad-d0d070ded60a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270262} {:answer/id #uuid "e913dca1-03c6-5d39-8cb8-3922ed7d4b59" :answer/type {:db/ident :answer.ty