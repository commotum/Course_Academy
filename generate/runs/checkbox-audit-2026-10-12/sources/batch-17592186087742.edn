/ref 17592186390527}] :answer-field/correct {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} :answer-field/id #uuid "9cb7b8b6-ddf5-57db-b6c9-dfd64245bb49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390522}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5100b042-b82c-5834-8756-fafba09daf0e" :question/math-academy-id "q-26815" :question/problem "Which of the following is the graph of $y={6}^{x}-0.75?$" :question/worked-solution "First, we plot the graph of $y={6}^{x}:$\n\n![](images/29/29d270676a48f4cf40625ef3ec50b0323c9c99389b2a7d080881727eda28de56.png)\n\nTo sketch the graph of $y={6}^{x}-0.75,$ we take the graph of $y={6}^{x}$ and shift it $0.75$ units down. The $y$-intercept moves from $(0,1)$ to $(0,0.25),$ and the horizontal asymptote moves from $y=0$ to $y=-0.75.$\n\n![](images/3b/3b141be99e5c01c70d6f6f04f4adf06741f1dc0fcef80c73b52e3dba1ae44a87.png)"}] :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] [{:db/id #edb/ref 17592186087822 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087426 :question/id #uuid "65c814f8-df2f-549d-9467-c6dda6890bb3" :question/math-academy-id "e-1220" :question/problem "The graph below shows the curve $y=3^{x}+c$ . What is the value of $c?$\n\n![](images/00/00264eb90dbaa2c50fdd626d61292c0428fd0bbbd03a6d051353598450b4ad89.png)" :question/worked-solution "The horizontal asymptote of $y=3^x$ is $y=0.$ The vertical translation $y=3^x+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"} :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/questions [{:db/id #edb/ref 17592186088113 :question/answer-fields [{:answer-field/choices [{:a