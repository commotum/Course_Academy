4a32-50a4-975f-accd13de1c2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186346681} {:answer/id #uuid "9c34cf48-184f-5f27-854d-fce512817ca5" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186346709} {:answer/id #uuid "b01c81d6-c1c0-5050-b9fb-d93f9ec6cb0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186346888} {:answer/id #uuid "ffa8b400-8708-5b8d-83bc-881fae5386fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186347598}] :answer-field/correct {:answer/id #uuid "ffa8b400-8708-5b8d-83bc-881fae5386fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186347598} :answer-field/id #uuid "88c47178-8a69-5a88-a339-d68cd924d589" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347844}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a718936b-2ed0-5746-9d07-e03f3d3e7270" :question/math-academy-id "q-79272" :question/problem "![](images/15/15dd47ff2ba433da8ad8f6ed25bfa984806e84e4150c0a56697526116cc41431.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=1.$ So, the parametric equations of the *full* circle are \n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/dd/ddd66398b45c22772af257d6856454b63fde930253090329f99383e4e063fff4.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{\\pi }{2}]$, we get the required quarter-circle.\n\nTherefore, the parametric equations of the quarter-circle are \n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{\\pi }{2}].\n$$"} {:db/id #edb/ref 17592186397836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232441c2-f7f1-5f16-bc4b-60b09c0b1593" :answer/type {:db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186397838} {:answer/id #uuid "82fba5c9-0131-541c-8948-a25c0d8eae2f" :answer/type {:db/ident :answer.type/math} :answer/value "[0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186397839} {:answer/id #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186397840} {:answer/id #uuid "0f87d6d3-3c3b-5273-849d-9b1476a53757" :answer/type {:db/ident :answer.type/math} :answer/value "[0,\\pi ]" :db/id #edb/ref 17592186397841} {:answer/id #uuid "c5222c9f-23b7-5ec8-b93f-57e76ab64107" :answer/type {:db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},2\\pi )" :db/id #edb/ref 17592186397842}] :answer-field/correct {:answer/id #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186397840} :answer-field/id #uuid "dad99554-fa4d-57b5-9d6d-0148f288e880" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186397837}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "da600baa-a9d3-5724-9a5b-8920df8b8600" :question/math-academy-id "q-106293" :question/problem "![](images/d6/d698646baac96e15db7f447c0e1af6dbc0cb03cae50084fbfbb6cab15eabf565.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=2.$ So, the parametric equations of the *full* circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/b7/b76043921a3f9399049d6c3b4f557c7263da4d38a070c66a2dd444dbe2806c8e.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{\\pi }{2},\\pi ]$, we get the required quarter-circle.\n\nTherefore, the parametric equations of the quarter-circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\frac{\\pi }{2},\\pi ].\n$$"}] :knowledge-point/title "Parametrizing Part of a Circle"}] [{:db/id #edb/ref 17592186087786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087616 :question/id #uuid "8bff424d-8f2e-528b-acf0-12c33958a132" :question/math-academy-id "e-6817" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=3\\cos\\theta + 2,\\quad y=3\\sin\\theta - 4, \\quad 0\\leq\\theta\\lt 2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta.$ We can do this using the Pythagorean identity:\n\n$$\n\\cos^2 \\theta + \\sin^2 \\theta = 1\n$$\n\nBy isolating the $\\cos\\theta$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{x-2}{3} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x-2)^{2}}{{3}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x-2)^{2}}{9} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\sin\\theta$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\\frac{y+4}{3} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y+4)^{2}}{{3}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y+4)^{2}}{9} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSubstituting these values into the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  & =1 \\\\ \\frac{(x-2)^{2}}{9}+\\frac{(y+4)^{2}}{9} & =1 \\\\ (x-2)^{2}+(y+4)^{2} & =9.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is $(x-2)^2 + (y+4)^2 = 9.$"} :knowledge-point/id #uuid "3d334fa1-725c-5687-9ed2-83a5788db925" :knowledge-point/questions [{:db/id #edb/ref 17592186088020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94805d06-84ce-573c-95d0-ef9240045ded" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 3)^{2} + (y - 5)^{2} = 81" :db/id #edb/ref 17592186084855} {:answer/id #uuid "b5b96777-b8f0-5318-a701-8952fe3121b0" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 3)^{2} + (y - 5)^{2} = 9" :db/id #edb/ref 17592186084856} {:answer/id #uuid "bda79002-269a-55da-805c-50c6a85976b4" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} + (y + 5)^{2} = 81" :db/id #edb/ref 17592186084857} {:answer/id #uuid "466785f2-f5ab-544a-9f83-653479ce6953" :answer/type {:db/ident :answer.type/math} :answer/value "(x - 3)^{2} + (y + 5)^{2} = 18" :db/id #edb/ref 17592186084858} {:answer/id #uuid "67d8c3a4-81c0-5500-9673-e670303fba2a" :answer/type {:db/ident :answer.type/math} :answer/value "(x + 3)^{2} + (y - 5)^{2} = 18" :db/id #edb/ref 17592186084859}] :answer-field/id #uuid "31b498e5-1477-59a7-b414-140c1ef6e234" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084854}] :question/id #uuid "e0808c46-a050-5e50-a062-e87353dcdd48" :question/math-academy-id "q-15799" :question/problem "Determine the Cartesian equation of the circle\n\n$x = 9\\cos θ - 3, y = 9\\sin θ + 5, 0 \\le θ < 2π$."} {:db/id #edb/ref 17592186088272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4e3ff7-0f56-5670-968d-942fa26f266b" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=9" :db/id #edb/ref 17592186333116} {:answer/id #uuid "57b7ce5d-ec6b-5250-87a2-d5986283a00b" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=3" :db/id #edb/ref 17592186333790} {:answer/id #uuid "743a1c09-f9a8-5517-b74f-0ae55c1bb3ff" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{3}" :db/id #edb/ref 17592186334038} {:answer/id #uuid "85baee00-733f-595d-aeb8-248060ee0eaf" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186334179} {:answer/id #uuid "a77f4060-9ba3-5f34-8f8a-5b05fd704d8c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=9" :db/id #edb/ref 17592186334457}] :answer-field/correct {:answer/id #uuid "a77f4060-9ba3-5f34-8f8a-5b05fd704d8c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=9" :db/id #edb/ref 17592186334457} :answer-field/id #uuid "cd786231-9ee2-54a9-ac19-aa1cf56c5c9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335616}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0e86c521-0742-549b-8e0a-9a85599dcb9d" :question/math-academy-id "q-6879" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =3\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & =(3\\operatorname{cos}⁡\\theta )^{2} \\\\  & =9{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =3\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & =(3\\operatorname{sin}⁡\\theta )^{2} \\\\  & =9{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =9{cos}^{2}⁡\\theta +9{sin}^{2}⁡\\theta  \\\\  & =9({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =9(1) \\\\  & =9.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=9.$"} {:db/id #edb/ref 17592186241157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f59f06d-b9a6-5438-a966-d3b5565735a3" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+{(y-2)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239446} {:answer/id #uuid "ad4e0cba-3407-5463-bc8e-cecffd5ecc85" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+1)}^{2}+{(y+2)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239559} {:answer/id #uuid "b0bebb9d-7faf-5639-8545-a824ed4d0302" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+2)}^{2}+{(y+1)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239592} {:answer/id #uuid "c2a220fb-a7b7-5add-a148-72170d71b738" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+1)}^{2}+{(y+2)}^{2}=\\frac{3}{2}" :db/id #edb/ref 17592186239764} {:answer/id #uuid "ff94d839-5539-5e72-b58a-5e6b2133fac2" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+{(y-2)}^{2}=\\frac{3}{2}" :db/id #edb/ref 17592186240322}] :answer-field/correct {:answer/id #uuid "ad4e0cba-3407-5463-bc8e-cecffd5ecc85" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+1)}^{2}+{(y+2)}^{2}=\\frac{9}{4}" :db/id #edb/ref 17592186239559} :answer-field/id #uuid "43343ab1-d9ca-5b6d-a323-22a64344f342" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240446}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f2bc3b27-8c03-5cde-b344-2e0c55032f69" :question/math-academy-id "q-106299" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=\\frac{3}{2}\\operatorname{cos}⁡\\theta -1,\\,y=\\frac{3}{2}\\operatorname{sin}⁡\\theta -2,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x+1 & =\\frac{3}{2}\\operatorname{cos}⁡\\theta  \\\\ \\frac{2}{3}(x+1) & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{4}{9}{(x+1)}^{2} & ={cos}^{2}⁡\\theta \\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y+2 & =\\frac{3}{2}\\operatorname{sin}⁡\\theta  \\\\ \\frac{2}{3}(y+2) & ={sin}^{2}⁡\\theta  \\\\ \\frac{4}{9}{(y+2)}^{2} & ={sin}^{2}⁡\\theta \\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{4}{9}{(x+1)}^{2}+\\frac{4}{9}{(y+2)}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ 4{(x+1)}^{2}+4{(y+2)}^{2} & =9 \\\\ {(x+1)}^{2}+{(y+2)}^{2} & =\\frac{9}{4}\\end{aligned}\n$$\n\nTherefore the Cartesian equation of the circle is ${(x+1)}^{2}+{(y+2)}^{2}=\\frac{9}{4}.$"} {:db/id #edb/ref 17592186241158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1179ddc8-9d2b-5f37-858d-a4af5d525038" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=\\sqrt{5}" :db/id #edb/ref 17592186238199} {:answer/id #uuid "5c77ee41-eb12-5d5d-aee0-f73a63e3d59a" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=25" :db/id #edb/ref 17592186238864} {:answer/id #uuid "868b4972-5724-52d5-879b-b7ce9a27b554" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}+{(y-\\frac{1}{2})}^{2}=5" :db/id #edb/ref 17592186239226} {:answer/id #uuid "e91810a1-61c1-5eba-91a0-ed9b1bf5ef6b" :answer/type {:db/ident :answer.type/math} :answer/value "{(x+\\frac{1}{2})}^{2}+{(y-\\frac{1}{2})}^{2}=25" :db/id #edb/ref 17592186240107} {:answer/id #uuid "fd3e3abf-1c31-5d04-ae31-72a0f1e5bc40" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=5" :db/id #edb/ref 17592186240294}] :answer-field/correct {:answer/id #uuid "5c77ee41-eb12-5d5d-aee0-f73a63e3d59a" :answer/type {:db/ident :answer.type/math} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=25" :db/id #edb/ref 17592186238864} :answer-field/id #uuid "2f97f707-7649-51de-a352-c860d9645f7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240416}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "85bc2cb1-6e4a-5b13-b0c1-a6335dc66a91" :question/math-academy-id "q-106300" :question/problem "Determine the Cartesian equation of the circle\n\n$$\nx=5\\operatorname{cos}⁡\\theta +\\frac{1}{2},\\,y=5\\operatorname{sin}⁡\\theta -\\frac{1}{2},\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}(x-\\frac{1}{2}) & =5\\operatorname{cos}⁡\\theta  \\\\ \\frac{1}{5}(x-\\frac{1}{2}) & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{1}{25}{(x-\\frac{1}{2})}^{2} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}(y+\\frac{1}{2}) & =5\\operatorname{sin}⁡\\theta  \\\\ \\frac{1}{5}(y+\\frac{1}{2}) & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{1}{25}{(y+\\frac{1}{2})}^{2} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{25}{(x-\\frac{1}{2})}^{2}+\\frac{1}{25}{(y+\\frac{1}{2})}^{2} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\ \\frac{1}{25}{(x-\\frac{1}{2})}^{2}+\\frac{1}{25}{(y+\\frac{1}{2})}^{2} & =1 \\\\ {(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2} & =25.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=25.$"} {:db/id #edb/ref 17592186243923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa416b1-d5ce-5503-b94a-3e38eba55fa7" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\frac{5}{2}" :db/id #edb/ref 17592186241276} {:answer/id #uuid "56eae8d6-2606-519e-88c0-2a4f95d5a1ff" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\frac{25}{4}" :db/id #edb/ref 17592186241966} {:answer/id #uuid "6b02e3f2-9739-5323-a096-d7c64f08da33" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\frac{25}{4}" :db/id #edb/ref 17592186242140} {:answer/id #uuid "94adb393-4580-5bd9-8341-d1156639d308" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\frac{5}{2}" :db/id #edb/ref 17592186242486} {:answer/id #uuid "c970979d-e0eb-5a39-af93-dcdfdeddae68" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{\\frac{5}{2}}" :db/id #edb/ref 17592186242953}] :answer-field/correct {:answer/id #uuid "56eae8d6-2606-519e-88c0-2a4f95d5a1ff" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\frac{25}{4}" :db/id #edb/ref 17592186241966} :answer-field/id #uuid "c999e49c-1d23-5427-99dc-13feea41bd21" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243793}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4f054c8b-83ad-51a3-ac06-f9b576f40779" :question/math-academy-id "q-106696" :question/problem "Calculate the Cartesian equation of the circle\n\n$$\nx=\\frac{5}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{5}{2}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the circle, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $x$-equation, we get\n\n$$\n\\begin{aligned}x & =\\frac{5}{2}\\operatorname{cos}⁡\\theta  \\\\ {x}^{2} & ={(\\frac{5}{2}\\operatorname{cos}⁡\\theta )}^{2} \\\\  & =\\frac{25}{4}{cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy squaring the $y$-equation, we get\n\n$$\n\\begin{aligned}y & =\\frac{5}{2}\\operatorname{sin}⁡\\theta  \\\\ {y}^{2} & ={(\\frac{5}{2}\\operatorname{sin}⁡\\theta )}^{2} \\\\  & =\\frac{25}{4}{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =\\frac{25}{4}{cos}^{2}⁡\\theta +\\frac{25}{4}{sin}^{2}⁡\\theta  \\\\  & =\\frac{25}{4}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =\\frac{25}{4}(1) \\\\  & =\\frac{25}{4}.\\end{aligned}\n$$\n\nTherefore the Cartesian equation is ${x}^{2}+{y}^{2}=\\frac{25}{4}.$"} {:db/id #edb/ref 17592186275404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ba1d767-a5eb-570e-83d3-118be64e32a2" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=4" :db/id #edb/ref 17592186273447} {:answer/id #uuid "dc0ba066-dba6-518e-800f-bc01062cfe89" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=\\sqrt{2}" :db/id #edb/ref 17592186274319} {:answer/id #uuid "df8ba9fa-4cfe-5b42-8b8c-710472617b01" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=8" :db/id #edb/ref 17592186274361} {:a