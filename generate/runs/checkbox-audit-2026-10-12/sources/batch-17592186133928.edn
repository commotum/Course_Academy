1\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe9f3a4-5cf2-57da-bcd0-f2ef4cb40acb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2}\\,x+y\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186278733} {:answer/id #uuid "22082459-dc16-5814-aa58-32ad4a0572c0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186278901} {:answer/id #uuid "54ac7f0f-775a-50ab-b1ab-fadfeb9bb310" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,3{y}^{2}+xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186279362} {:answer/id #uuid "5e06d3d8-095d-5f06-bf6e-56940d9ad14d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{2}^{{z}^{2}+{x}^{2}}\\,3{y}^{2}+xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186279452} {:answer/id #uuid "e7f6523c-8035-585f-ad29-1d759e7d0636" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186280633}] :answer-field/correct {:answer/id #uuid "e7f6523c-8035-585f-ad29-1d759e7d0636" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186280633} :answer-field/id #uuid "070d1c83-7b76-5bd7-a3dc-6b326edc9f9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280842}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8e6de64a-d194-59f6-b620-cf3ddbd502d1" :question/math-academy-id "q-162589" :question/problem "Let $S$ be the boundary of the finite solid region enclosed by the planes $x=-1,$ $x=1,$ $z=0,$ $z=1,$ and the surfaces $y={x}^{2}+{z}^{2}$ and $y=2.$ Given that the surface $S$ is positively (outward) oriented and $F=({y}^{3}-z)\\,i+z\\,j+2xyz\\,k,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS=\n$$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({y}^{3}-z)+\\frac{∂}{∂y}(z)+\\frac{∂}{∂z}(2xyz) \\\\  & =0+0+2xy \\\\  & =2xy.\\end{aligned}\n$$\n\nTherefore, using the divergence theorem, we have\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}2xy\\,\\text{d}V,\n$$\n\nwhere $R$ is a type III solid region that can be written as\n\n$$\nR={(x,y,z)\\,:\\,-1\\le x\\le 1,\\,0\\le z\\le 1,\\,{x}^{2}+{z}^{2}\\le y\\le 2}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}{∭}_{R}2xy\\,\\text{d}V & ={\\int }_{-1}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}+{z}^{2}}^{2}\\,2xy\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186398562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a60a0ff-d58d-574d-ad7b-aa68f48f45e3" :answer/type {:db/ident :answer.type/math} :answer/value "2x+y+1" :db/id #edb/ref 17592186398564} {:answer/id #uuid "caf3aed4-56d3-57fb-9c54-0b9379ad0474" :answer/type {:db/ident :answer.type/math} :answer/value "xy+2" :db/id #edb/ref 17592186398565} {:answer/id #uuid "5e393df8-940d-5225-8bcc-4aba9a085593" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+2y" :db/id #edb/ref 17592186398566} {:answer/id #uuid "8ebc6e76-bfea-5200-aea9-f978a3678ba3" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+xy" :db/id #edb/ref 17592186398567} {:answer/id #uuid "c0a5acac-f897-54fc-9f0e-b6da562e322e" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+y+2" :db/id #edb/ref 17592186398568}] :answer-field/correct {:answer/id #uuid "c0a5acac-f897-54fc-9f0e-b6da562e322e" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+y+2" :db/id #edb/ref 17592186398568} :answer-field/id #uuid "196954bd-17a6-525e-a3ea-36557f290435" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398563}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e0d14173-8029-50a6-8f00-d7853c057071" :question/math-academy-id "q-162581" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=0,$ $y=1,$ $y=2,$ $z=0,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=xy\\,i+2y\\,j+{x}^{2}zk,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS={\\int }_{-1}^{0}{\\int }_{1}^{2}{\\int }_{0}^{1}\\,\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nWhat is the missing part of the expression?" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(xy)+\\frac{∂}{∂y}(2y)+\\frac{∂}{∂z}({x}^{2}z) \\\\  & =y+2+{x}^{2} \\\\  & ={x}^{2}+y+2.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}({x}^{2}+y+2)\\,\\text{d}V \\\\  & ={\\int }_{-1}^{0}{\\int }_{1}^{2}{\\int }_{0}^{1}\\,{x}^{2}+y+2\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186398569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc53f04c-d5bb-59dd-b389-8e0eefab0229" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3z" :db/id #edb/ref 17592186398571} {:answer/id #uuid "af12ea26-8299-5100-8312-7691bb7b67f0" :answer/type {:db/ident :answer.type/math} :answer/value "2x-z+4" :db/id #edb/ref 17592186398572} {:answer/id #uuid "958be202-ad70-5f65-942d-3cf053018cf9" :answer/type {:db/ident :answer.type/math} :answer/value "6x-z" :db/id #edb/ref 17592186398573} {:answer/id #uuid "221c39d4-97a7-58e1-af0f-bd5bd145ae18" :answer/type {:db/ident :answer.type/math} :answer/value "6x+4z" :db/id #edb/ref 17592186398574} {:answer/id #uuid "fc84079a-9c1c-54c9-bc3c-5fd874d6a1dc" :answer/type {:db/ident :answer.type/math} :answer/value "2x-y-2z" :db/id #edb/ref 17592186398575}] :answer-field/correct {:answer/id #uuid "958be202-ad70-5f65-942d-3cf053018cf9" :answer/type {:db/ident :answer.type/math} :answer/value "6x-z" :db/id #edb/ref 17592186398573} :answer-field/id #uuid "5b4c4f1b-ebdf-554c-9f5f-c8043f8e6124" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398570}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "20faa8ac-7475-55a0-94fb-35eb1571259e" :question/math-academy-id "q-162583" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=4,$ $y=-1,$ $y=1,$ $z=0,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F=({x}^{2}+y)\\,i-yz\\,j+4xz\\,k,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS={\\int }_{0}^{4}{\\int }_{-1}^{1}{\\int }_{0}^{2}\\,\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nWhat is the missing part of the expression?" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2}+y)+\\frac{∂}{∂y}(-yz)+\\frac{∂}{∂z}(4xz) \\\\  & =2x-z+4x \\\\  & =6x-z.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}(6x-z)\\,\\text{d}V \\\\  & ={\\int }_{0}^{4}{\\int }_{-1}^{1}{\\int }_{0}^{2}\\,6x-z\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499cdd5b-e6c0-5bd4-bfc7-e7acaa3926fb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{x-z+2}\\,3{z}^{2}-4\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186430922} {:answer/id #uuid "4e983312-df08-546e-9806-4e462f4e1659" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{2}\\,3{z}^{2}-4\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186430923} {:answer/id #uuid "688adcb4-8f82-5557-b006-90cbca149a33" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{2}\\,{z}^{3}-3\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186430927} {:answer/id #uuid "8128a8cf-b3f9-556e-aefb-154a9c6699fb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{x-z+2}\\,{z}^{2}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186430931} {:answer/id #uuid "d03cded5-b5e9-5895-a862-9145e719e5f1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{x-z+2}\\,{z}^{3}-3\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186430933}] :answer-field/correct {:answer/id #uuid "499cdd5b-e6c0-5bd4-bfc7-e7acaa3926fb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{x-z+2}\\,3{z}^{2}-4\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x" :db/id #edb/ref 17592186430922} :answer-field/id #uuid "8ef02b27-25c8-5d51-9b89-2000755f118a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430943}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "00083281-29d7-555a-802b-bb136fd26b95" :question/math-academy-id "q-162586" :question/problem "Let $S$ be the boundary of the finite solid region enclosed by the planes $x=0,$ $x=1,$ $z=0,$ $z=1,$ and the surfaces $y={x}^{2}$ and $y=x-z+2.$ Given that the surface $S$ is positively (outward) oriented and $F=z\\,i-4y\\,j+{z}^{3}\\,k,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS=\n$$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(z)+\\frac{∂}{∂y}(-4y)+\\frac{∂}{∂z}({z}^{3}) \\\\  & =0-4+3{z}^{2} \\\\  & =3{z}^{2}-4.\\end{aligned}\n$$\n\nTherefore, using the divergence theorem, we have\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}(3{z}^{2}-4)\\,\\text{d}V,\n$$\n\nwhere $R$ is a type III solid region that can be written as\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le x\\le 1,\\,0\\le z\\le 1,\\,{x}^{2}\\le y\\le x-z+2\\}.\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}{∭}_{R}(3{z}^{2}-4)\\,\\text{d}V & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{x-z+2}\\,3{z}^{2}-4\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069804e3-7c58-5f7e-b7b1-a0c2c5c704f1" :answer/type {:db/ident :answer.type/math} :answer/value "2x+xz" :db/id #edb/ref 17592186430911} {:answer/id #uuid "06c35222-68d1-50e1-b3be-f3859d1566f3" :answer/type {:db/ident :answer.type/math} :answer/value "2+z" :db/id #edb/ref 17592186430912} {:answer/id #uuid "165ccd61-a96d-55ca-a818-a06291f0c969" :answer/type {:db/ident :answer.type/math} :answer/value "x+2z" :db/id #edb/ref 17592186430914} {:answer/id #uuid "661de3a9-92bc-5da3-91fa-17df7bbafc4f" :answer/type {:db/ident :answer.type/math} :answer/value "y+z" :db/id #edb/ref 17592186430925} {:answer/id #uuid "fd490bcb-15ef-5833-9df8-21e37b4504ad" :answer/type {:db/ident :answer.type/math} :answer/value "x+yz" :db/id #edb/ref 17592186430940}] :answer-field/correct {:answer/id #uuid "069804e3-7c58-5f7e-b7b1-a0c2c5c704f1" :answer/type {:db/ident :answer.type/math} :answer/value "2x+xz" :db/id #edb/ref 17592186430911} :answer-field/id #uuid "89b39073-1256-589c-ae05-81365bf7916b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430942}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cd56ae3f-1187-5181-af79-1866b5188a10" :question/math-academy-id "q-162575" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=1,$ $y=0,$ $y=2,$ $z=1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}\\,i+xyz\\,j+2y\\,k,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS={\\int }_{-1}^{1}{\\int }_{0}^{2}{\\int }_{1}^{2}\\,\\bbox[2pt,border: 1pt solid black]{\\phantom{AAAAA}}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nWhat is the missing part of the expression?" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2})+\\frac{∂}{∂y}(xyz)+\\frac{∂}{∂z}(2y) \\\\  & =2x+xz+0 \\\\  & =2x+xz.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}(2x+xz)\\,\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{2}{\\int }_{1}^{2}\\,2x+xz\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] :knowledge-point/title "Writing the Flux Across a Closed Surface as a Triple Integral"}] [{:db/id #edb/ref 17592186133930 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133490 :question/id #uuid "9bb760a6-9060-532a-a59d-3cedf335daac" :question/math-academy-id "e-12448" :question/problem "Consider the positively oriented surface $S$ given by $x^2 + y^2 + z^2 = 4$ and the vector field $\\mathbf{F} = 2x \\, \\mathbf{i} + y \\, \\mathbf{j} + 4 \\, \\mathbf{k}.$ Use the divergence theorem to find the flux of $\\mathbf{F}$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n\\iint\\limits_{S} \\mathbf{F}\\cdot\\mathrm{d}\\mathbf{S}\n= \\iiint\\limits_R \\textrm{div}\\,\\mathbf{F} \\: \\textrm{d}V.\n$$\n\nComputing the divergence of $\\mathbf{F},$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(2x)+\\frac{∂}{∂y}(y)+\\frac{∂}{∂z}(4) \\\\  & =2+1+0 \\\\  & =3.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $2$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3\\,\\text{d}V \\\\  & =3{∭}_{R}\\,\\text{d}V \\\\  & =3\\cdot \\text{Volume}(R) \\\\  & =3\\cdot \\frac{4}{3}\\pi \\cdot {2}^{3} \\\\  & =32\\pi .\\end{aligned}\n$$"} :knowledge-point/id #uuid "5c239481-1424-575a-b4f7-b6f5409dd240" :knowledge-point/questions [{:db/id #edb/ref 17592186134137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c423938-da5c-5986-904d-ca90bf43b04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}" :db/id #edb/ref 17592186278710} {:answer/id #uuid "1603c0df-af5e-5636-b1a6-72475e40234a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25{\\pi }^{2}}{4}" :db/id #edb/ref 17592186278787} {:answer/id #uuid "1d02c2fc-86f7-5eda-b6b6-62da495ea6ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\,000\\pi }{3}" :db/id #edb/ref 17592186278860} {:answer/id #uuid "4b1ed5c0-e3de-599b-b026-5cb574362292" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{400\\pi }{3}" :db/id #edb/ref 17592186279264} {:answer/id #uuid "9dc2db2a-7618-540a-a2a1-b6f665e7242c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{800\\pi }{3}" :db/id #edb/ref 17592186279990}] :answer-field/correct {:answer/id #uuid "1d02c2fc-86f7-5eda-b6b6-62da495ea6ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\,000\\pi }{3}" :db/id #edb/ref 17592186278860} :answer-field/id #uuid "b9ce83a8-eea0-5bfa-a466-b577953f924a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281161}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "088370e5-5be7-5c78-9dd1-180055943e46" :question/math-academy-id "q-162410" :question/problem "Consider the positively (outward) oriented surface $S$ given by ${x}^{2}+(y-2)^{2}+(z+1)^{2}=25$ and the vector field $F=x\\,i+xz\\,j+3z\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x)+\\frac{∂}{∂y}(xz)+\\frac{∂}{∂z}(3z) \\\\  & =1+0+3 \\\\  & =4.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $5$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4\\,\\text{d}V \\\\  & =4{∭}_{R}\\,\\text{d}V \\\\  & =4\\cdot \\text{Volume}(R) \\\\  & =4\\cdot \\frac{4}{3}\\pi \\cdot {5}^{3} \\\\  & =\\frac{2\\,000\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d80dd4e3-7ed1-503d-9671-7f45280ca24f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{2}" :db/id #edb/ref 17592186130985} {:answer/id #uuid "17a086d8-d007-5821-8115-e76ddac0915a" :answer/type {:db/ident :answer.type/math} :answer/value "2π" :db/id #edb/ref 17592186130986} {:answer/id #uuid "4a19f710-b32c-5035-a13b-72785acbdf61" :answer/type {:db/ident :answer.type/math} :answer/value "6π" :db/id #edb/ref 17592186130987} {:answer/id #uuid "67b10b1f-2e11-5777-9ba4-8b1485780761" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4π}{3}" :db/id #edb/ref 17592186130988} {:answer/id #uuid "755be662-4415-5c52-965a-228af18f717c" :answer/type {:db/ident :answer.type/math} :answer/value "4π" :db/id #edb/ref 17592186130989}] :answer-field/id #uuid "4a64fc7d-ca43-526d-a9de-b6748f05a24c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130984} {:answer-field/choices [{:answer/id #uuid "60179c77-308c-5a4b-9b41-da233c3efd4f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186374181} {:answer/id #uuid "c11f9a42-43be-517a-94cc-42c6ba595526" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{3}" :db/id #edb/ref 17592186374182} {:answer/id #uuid "e2d48b0f-7937-5ff0-8ff5-b0a889036dee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186374183} {:answer/id #uuid "ae328f95-387f-55bc-b6b1-78da1a0e6c8b" :answer/type {:db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186374184} {:answer/id #uuid "9829f33d-f493-59a1-b8be-a91cbaec38dc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186374185}] :answer-field/correct {:answer/id #uuid "60179c77-308c-5a4b-9b41-da233c3efd4f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186374181} :answer-field/id #uuid "a29f5580-8460-5ca2-bf68-68db1fc8ae7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374180}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "de14125f-fde2-50fc-9770-aae06e6d9c30" :question/math-academy-id "q-162411" :question/problem "![](images/d0/d0f6f5ed91981e15d2fb80e2630cec6d20f566feb627899f529e07bab12b73fb.png)\n\nConsider the vector field $F=⟨{z}^{2},\\,2y,\\,{x}^{2}+y⟩$ and the surface $S$ defined by the bounding region of a right circular cylinder of height $2$ whose base is a circle of radius $1$ centered at the origin, as shown above. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({z}^{2})+\\frac{∂}{∂y}(2y)+\\frac{∂}{∂z}({x}^{2}+y) \\\\  & =0+2+0 \\\\  & =2.\\end{aligned}\n$$\n\nLet $R$ be the solid cylinder enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2\\,\\text{d}V \\\\  & =2{∭}_{R}\\,\\text{d}V \\\\  & =2\\cdot \\text{Volume}(R) \\\\  & =2\\cdot \\pi \\cdot {1}^{2}\\cdot 2 \\\\  & =4\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a529250-7d38-56c1-a622-ff64fed6a943" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186278829} {:answer/id #uuid "2f3cea9e-711c-52bd-bf9d-eaae4c5bf127" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\pi " :db/id #edb/ref 17592186279003} {:answer/id #uuid "417909d6-a428-5bad-93a3-7802edb9f815" :answer/type {:db/ident :answer.type/math} :answer/value "-16\\pi " :db/id #edb/ref 17592186279176} {:answer/id #uuid "520a773b-54ab-554d-965c-034440c2452d" :answer/type {:db/ident :answer.type/math} :answer/value "6\\pi " :db/id #edb/ref 17592186279338} {:answer/id #uuid "9219b018-274a-5760-bb2c-8a5c016a3ad1" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\pi " :db/id #edb/ref 17592186279893}] :answer-field/correct {:answer/id #uuid "2f3cea9e-711c-52bd-bf9d-eaae4c5bf127" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\pi " :db/id #edb/ref 17592186279003} :answer-field/id #uuid "c807b5db-45e6-5011-a1a3-2596f4f3033b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281182}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3c0ba9cf-530e-5fff-bddf-77afd0f80ef9" :question/math-academy-id "q-162569" :question/problem "![](images/58/581ac462bfcfead22a6c5ad4eb247f05adb1a677e92cac51954b0746cd083ab7.png)\n\nConsider the vector field $F=⟨x-y,\\,y+z,\\,2x-3z⟩$ and the surface $S$ defined by the bounding region of a right circular cylinder of height $3$ whose base is a circle of radius $2$ centered at the origin, as shown above. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(x-y)+\\frac{∂}{∂y}(y+z)+\\frac{∂}{∂z}(2x-3z) \\\\  & =1+1+(-3) \\\\  & =-1.\\end{aligned}\n$$\n\nLet $R$ be the solid cylinder enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}-1\\,\\text{d}V \\\\  & =-{∭}_{R}\\,\\text{d}V \\\\  & =-\\text{Volume}(R) \\\\  & =-\\pi \\cdot {2}^{2}\\cdot 3 \\\\  & =-12\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d047b1e-3afb-5c5a-88f9-faeab4432ef1" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186279129} {:answer/id #uuid "565cbac4-9d5b-53f7-ad95-f3c76b6932d1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186279384} {:answer/id #uuid "93da9f2a-8ea0-53d4-858e-491166b1dc48" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186279908} {:answer/id #uuid "a5861e93-47f0-536a-a4e4-9d3f7a9b658a" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186280057} {:answer/id #uuid "da4056b9-a344-5551-a7d2-55af24530e22" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186280519}] :answer-field/correct {:answer/id #uuid "3d047b1e-3afb-5c5a-88f9-faeab4432ef1" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186279129} :answer-field/id #uuid "5b030670-12c0-5a90-a682-f7582e669ba1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280989}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c50889a1-249a-5104-a142-d8d313afba10" :question/math-academy-id "q-162572" :question/problem "![](images/aa/aac27058402f89bef73700129a7812b3cf4f971c11975fc1711a46b8d10e61fe.png)\n\nConsider the vector field $F=⟨3x+y{e}^{z},\\,xy+2,\\,1-xz⟩$ and the surface $S$ defined by the bounding region of the rectangular solid shown above in the first octant. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(3x+y{e}^{z})+\\frac{∂}{∂y}(xy+2)+\\frac{∂}{∂z}(1-xz) \\\\  & =3+x+(-x) \\\\  & =3.\\end{aligned}\n$$\n\nLet $R$ be the rectangular solid enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3\\,\\text{d}V \\\\  & =3{∭}_{R}\\,\\text{d}V \\\\  & =3\\cdot \\text{Volume}(R) \\\\  & =3\\cdot 1\\cdot 2\\cdot 3 \\\\  & =18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3274b94e-9050-5914-92cf-a20e7f33b9f9" :answer/type {:db/ident :answer.type/math} :answer/value "64\\pi " :db/id #edb/ref 17592186279033} {:answer/id #uuid "4021cef0-295e-5798-9f4f-2157ebca2b8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{128\\pi }{3}" :db/id #edb/ref 17592186279158} {:answer/id #uuid "59d4c631-de3a-5f80-abfd-ae0e4830d3d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{256\\pi }{3}" :db/id #edb/ref 17592186279414} {:answer/id #uuid "659a3952-f331-5c0f-9621-9a4212215836" :answer/type {:db/ident :answer.type/math} :answer/value "96\\pi " :db/id #edb/ref 17592186279515} {:answer/id #uuid "a356390a-20fd-5203-b264-de87732ef03b" :answer/type {:db/ident :answer.type/math} :answer/value "78\\pi " :db/id #edb/ref 17592186280042}] :answer-field/correct {:answer/id #uuid "659a3952-f331-5c0f-9621-9a4212215836" :answer/type {:db/ident :answer.type/math} :answer/value "96\\pi " :db/id #edb/ref 17592186279515} :answer-field/id #uuid "4f6afff7-29bd-5084-9d8e-63605244a213" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280961}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e9b12219-fd15-591a-8410-7eb56a488ff2" :question/math-academy-id "q-162578" :question/problem "Consider the positively (outward) oriented surface $S$ given by ${x}^{2}+{y}^{2}+(z-4)^{2}=4$ and the vector field $F=z\\,i+6y\\,j+(x+3z)\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(z)+\\frac{∂}{∂y}(6y)+\\frac{∂}{∂z}(x+3z) \\\\  & =0+6+3 \\\\  & =9.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $2$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}9\\,\\text{d}V \\\\  & =9{∭}_{R}\\,\\text{d}V \\\\  & =9\\cdot \\text{Volume}(R) \\\\  & =9\\cdot \\frac{4}{3}\\pi \\cdot {2}^{3} \\\\  & =96\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd0be77-03d3-5682-acf0-3a7644fad46d" :answer/type {:db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186278994} {:answer/id #uuid "6d4cf883-7b99-518c-bfbc-917db8f1e538" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186279587} {:answer/id #uuid "b9ca94f3-a2e6-5cf7-9f7b-6d1fec661b99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32\\pi }{3}" :db/id #edb/ref 17592186280228} {:answer/id #uuid "d1b1f74d-c55b-5f6c-8668-cf5d8fcbf163" :answer/type {:db/ident :answer.type/math} :answer/value "18\\pi " :db/id #edb/ref 17592186280442} {:answer/id #uuid "e434d311-7872-56cf-97d6-9851e8e02577" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}" :db/id #edb/ref 17592186280605}] :answer-field/correct {:answer/id #uuid "e434d311-7872-56cf-97d6-9851e8e02577" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16\\pi }{3}" :db/id #edb/ref 17592186280605} :answer-field/id #uuid "70df89b8-d119-5821-aca7-6b92f8aab9b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281032}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8a625adb-c2bb-5fe3-8ab2-cff87a075be0" :question/math-academy-id "q-162580" :question/problem "Consider the positively (outward) oriented surface $S$ given by $(x+2)^{2}+(y-1)^{2}+{z}^{2}=1$ and the vector field $F=({y}^{2}-{x}^{2})\\,i+4y\\,j+2xz\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({y}^{2}-{x}^{2})+\\frac{∂}{∂y}(4y)+\\frac{∂}{∂z}(2xz) \\\\  & =-2x+4+2x \\\\  & =4.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $1$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4\\,\\text{d}V \\\\  & =4{∭}_{R}\\,\\text{d}V \\\\  & =4\\cdot \\text{Volume}(R) \\\\  & =4\\cdot \\frac{4}{3}\\pi \\cdot {1}^{3} \\\\  & =\\frac{16\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dedb4d6-dae2-543b-80b2-9ccef9fa5a88" :answer/type {:db/ident :answer.type/math} :answer/value "32\\pi " :db/id #edb/ref 17592186374188} {:answer/id #uuid "8eabaa4a-a54f-5ddc-885b-ce8690b34285" :answer/type {:db/ident :answer.type/math} :answer/value "54\\pi " :db/id #edb/ref 17592186374189} {:answer/id #uuid "896566d9-4a61-5d61-b4f4-4aa45c0939f5" :answer/type {:db/ident :answer.type/math} :answer/value "64\\pi " :db/id #edb/ref 17592186374190} {:answer/id #uuid "4dc850a0-843d-56eb-abc2-2419b6e13be9" :answer/type {:db/ident :answer.type/math} :answer/value "27\\pi " :db/id #edb/ref 17592186374191} {:answer/id #uuid "af363662-dfd8-5c09-8594-73404f30ea3b" :answer/type {:db/ident :answer.type/math} :answer/value "48\\pi " :db/id #edb/ref 17592186374192}] :answer-field/correct {:answer/id #uuid "8eabaa4a-a54f-5ddc-885b-ce8690b34285" :answer/type {:db/ident :answer.type/math} :answer/value "54\\pi " :db/id #edb/ref 17592186374189} :answer-field/id #uuid "9accbfc9-5746-540c-8cdb-b27e56facfc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374187}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "139943e3-1c42-5e1e-8135-8c3ce7b2dffc" :question/math-academy-id "q-162570" :question/problem "![](images/98/9861e9edc3c7517af6fd912046f62ec04a6e478942c3017ed9903e8b366130c2.png)\n\nConsider the vector field $F=⟨1-2x,\\,5y-3{z}^{2},\\,{x}^{3}-{y}^{2}⟩$ and the surface $S$ defined by the bounding region of a right circular cylinder of height $2$ whose base is a circle of radius $3$ centered at the origin, as shown above. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(1-2x)+\\frac{∂}{∂y}(5y-3{z}^{2})+\\frac{∂}{∂z}({x}^{3}-{y}^{2}) \\\\  & =-2+5+0 \\\\  & =3.\\end{aligned}\n$$\n\nLet $R$ be the solid cylinder enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3\\,\\text{d}V \\\\  & =3{∭}_{R}\\,\\text{d}V \\\\  & =3\\cdot \\text{Volume}(R) \\\\  & =3\\cdot \\pi \\cdot {3}^{2}\\cdot 2 \\\\  & =54\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a718cce9-8e5d-5dec-8a0a-3840ae5b697b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186374195} {:answer/id #uuid "b2dec189-d251-5cdb-beb7-7e7b56595d20" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186374196} {:answer/id #uuid "1af109f7-1025-5d70-baae-5d18a7702281" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374197} {:answer/id #uuid "a2591ccc-8c08-599f-b2a7-b656cee9d9f9" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186374198} {:answer/id #uuid "0653f4e3-f779-564a-8100-ee0e0831159c" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186374199}] :answer-field/correct {:answer/id #uuid "b2dec189-d251-5cdb-beb7-7e7b56595d20" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186374196} :answer-field/id #uuid "24fbd410-95a8-5da8-9827-3827f59a3a95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374194}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a61b4d5a-a480-5473-9f9f-c9865eee4653" :question/math-academy-id "q-162571" :question/problem "![](images/07/07b46ab683e54813e0f6090c6841302ea7d914bc6b1577afc883f6e42e0a3903.png)\n\nConsider the vector field $F=⟨3x-y{z}^{2},\\,y+{e}^{z},\\,2y\\operatorname{sin}⁡x⟩$ and the surface $S$ defined by the bounding region of the rectangular solid shown above in the first octant. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(3x-y{z}^{2})+\\frac{∂}{∂y}(y+{e}^{z})+\\frac{∂}{∂z}(2y\\operatorname{sin}⁡x) \\\\  & =3+1+0 \\\\  & =4.\\end{aligned}\n$$\n\nLet $R$ be the rectangular solid enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4\\,\\text{d}V \\\\  & =4{∭}_{R}\\,\\text{d}V \\\\  & =4\\cdot \\text{Volume}(R) \\\\  & =4\\cdot 1\\cdot 2\\cdot 1 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f3436d-bc76-5261-8ad1-368ca3b77f95" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186430915} {:answer/id #uuid "3e6b3f5a-f220-5554-9220-850158e49738" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186430919} {:answer/id #uuid "6b730726-fed2-5b3e-8ffc-354b2c3bf2f7" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186430929} {:answer/id #uuid "e4005834-c2ac-5578-8587-1d569f479bce" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186430936} {:answer/id #uuid "e993ee67-8cbb-5ee4-a9bb-9dc04ab4bbe5" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186430937}] :answer-field/correct {:answer/id #uuid "6b730726-fed2-5b3e-8ffc-354b2c3bf2f7" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186430929} :answer-field/id #uuid "d4a0d219-93b4-5cee-98eb-dc3219549951" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430945}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "28a83ce5-6b28-57bd-96e8-b831ae6041a8" :question/math-academy-id "q-162573" :question/problem "![](images/6d/6dc4f6d9e8520dead79789efd4f08c07ea7921d28f4cf6f8da06de533d012e90.png)\n\nConsider the vector field $F=⟨y-z,\\,y-2x,\\,x+4z⟩$ and the surface $S$ defined by the bounding region of the rectangular solid shown above in the first octant. Given that $S$ is positively (outward) oriented, use the divergence theorem to find the flux of $F$ through $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y-z)+\\frac{∂}{∂y}(y-2x)+\\frac{∂}{∂z}(x+4z) \\\\  & =0+1+4 \\\\  & =5.\\end{aligned}\n$$\n\nLet $R$ be the rectangular solid enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}5\\,\\text{d}V \\\\  & =5{∭}_{R}\\,\\text{d}V \\\\  & =5\\cdot \\text{Volume}(R) \\\\  & =5\\cdot 4\\cdot 2\\cdot 2 \\\\  & =80.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b92e2ac-43e0-56d7-9ecd-75553160a01c" :answer/type {:db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186430918} {:answer/id #uuid "41e506e3-ebbe-5f8b-ae29-c18276419687" :answer/type {:db/ident :answer.type/math} :answer/value "72\\pi " :db/id #edb/ref 17592186430920} {:answer/id #uuid "5b7901d4-d410-5e21-8e33-71572db7a730" :answer/type {:db/ident :answer.type/math} :answer/value "64\\pi " :db/id #edb/ref 17592186430924} {:answer/id #uuid "6aacb83d-c030-5c62-a7af-140b5f553083" :answer/type {:db/ident :answer.type/math} :answer/value "36\\pi " :db/id #edb/ref 17592186430928} {:answer/id #uuid "ceca5263-40f9-5ba9-8496-31c6fead0bd7" :answer/type {:db/ident :answer.type/math} :answer/value "48\\pi " :db/id #edb/ref 17592186430932}] :answer-field/correct {:answer/id #uuid "41e506e3-ebbe-5f8b-ae29-c18276419687" :answer/type {:db/ident :answer.type/math} :answer/value "72\\pi " :db/id #edb/ref 17592186430920} :answer-field/id #uuid "b15f2475-f304-5fb8-a434-536b4a248735" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430944}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f2b40e8-b423-5c7a-b959-43a67763f792" :question/math-academy-id "q-162574" :question/problem "Consider the positively (outward) oriented surface $S$ given by ${x}^{2}+(y-2)^{2}+{z}^{2}=9$ and the vector field $F=(yz-2x)\\,i+3y\\,j+(x+z)\\,k.$ Use the divergence theorem to find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(yz-2x)+\\frac{∂}{∂y}(3y)+\\frac{∂}{∂z}(x+z) \\\\  & =-2+3+1 \\\\  & =2.\\end{aligned}\n$$\n\nLet $R$ be the solid sphere of radius $3$ enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2\\,\\text{d}V \\\\  & =2{∭}_{R}\\,\\text{d}V \\\\  & =2\\cdot \\text{Volume}(R) \\\\  & =2\\cdot \\frac{4}{3}\\pi \\cdot {3}^{3} \\\\  & =72\\pi .\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Flux Across the Surface of a Known Solid"}] [{:db/id #edb/ref 17592186133931 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133491 :question/id #uuid "dfba5156-6b5f-5622-9406-7598ae2630b6" :question/math-academy-id "e-12449" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=0,$ $y=2,$ $z=1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $\\mathbf{F} =e^z \\, \\mathbf{i} + x^2y^2 \\, \\mathbf{j} + 4x^2yz \\, \\mathbf{k},$ find the flux of $\\mathbf{F}$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $\\mathbf{F}$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n\\iint\\limits_{S} \\mathbf{F}\\cdot\\mathrm{d}\\mathbf{S}\n= \\iiint\\limits_R \\textrm{div}\\,\\mathbf{F} \\: \\textrm{d}V.\n$$\n\nComputing the divergence of $\\mathbf{F},$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({e}^{z})+\\frac{∂}{∂y}({x}^{2}{y}^{2})+\\frac{∂}{∂z}(4{x}^{2}yz) \\\\  & =0+2{x}^{2}y+4{x}^{2}y \\\\  & =6{x}^{2}y.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}6{x}^{2}y\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{1}^{2}6{x}^{2}y\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}\\,\\text{d}x\\cdot {\\int }_{0}^{2}2y\\,\\text{d}y\\cdot {\\int }_{1}^{2}\\,\\text{d}z \\\\  & =[{x}^{3}]_{x=0}^{x=1}\\cdot [{y}^{2}]_{y=0}^{y=2}\\cdot (2-1) \\\\  & =(1-0)\\cdot (4-0)\\cdot 1 \\\\  & =4.\\end{aligned}\n$$"} :knowledge-point/id #uuid "c7866416-74af-5891-b8c9-f6c1a3a751ac" :knowledge-point/questions [{:db/id #edb/ref 17592186134139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfbacc2c-3295-5427-aa6d-abb9d46ca58b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186130991} {:answer/id #uuid "068f8b0d-155c-5288-ab99-7bef355ce630" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186130992} {:answer/id #uuid "217bf025-09a6-5388-b75e-9b4aa6c0931a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186130993} {:answer/id #uuid "3f8b540c-c595-5796-b0a9-c06e4f0ff6a1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186130994} {:answer/id #uuid "4935e6a8-5d04-5659-bd19-c0da643e24ae" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186130995}] :answer-field/id #uuid "3cf5d99a-43d2-5f4d-9cab-2d45271876ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130990}] :question/id #uuid "c4d6f3d3-e8a0-54e3-96bf-06ac782d45a1" :question/math-academy-id "q-162412" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x =-1$, $x = 1$, $y = 0$, $y = 1$, $z = 0$, $z = 1$. Given that the surface $S$ is positively (outward) oriented and $F = 2xzi + (x^{2} + z)j + 2k$, find the flux of $F$ across $S$."} {:db/id #edb/ref 17592186134140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "305d1aaf-bbea-5c5f-a549-96aeb913edda" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186279014} {:answer/id #uuid "7052a4ed-9911-5fd7-bc04-95f5aa7e4565" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186279610} {:answer/id #uuid "774d71e4-5b4e-524f-b577-edc0dd3ee10b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186279657} {:answer/id #uuid "ca898aae-6598-59af-88de-b8842924f741" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186280367} {:answer/id #uuid "cd52ceb4-0135-536f-8588-e294bafcb89b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280401}] :answer-field/correct {:answer/id #uuid "cd52ceb4-0135-536f-8588-e294bafcb89b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280401} :answer-field/id #uuid "f6048b0a-8782-5f08-a33d-6088d1e77789" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281271}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b54a2292-f496-593a-8f3d-c0762d77f082" :question/math-academy-id "q-162606" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=2,$ $y=0,$ $y=1,$ $z=0,$ $z=\\frac{\\pi }{2}.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}\\operatorname{cos}⁡z\\,i+\\operatorname{sin}⁡z\\,j+(x+y)\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2}\\operatorname{cos}⁡z)+\\frac{∂}{∂y}(\\operatorname{sin}⁡z)+\\frac{∂}{∂z}(x+y) \\\\  & =2x\\operatorname{cos}⁡z+0+0 \\\\  & =2x\\operatorname{cos}⁡z.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2x\\operatorname{cos}⁡z\\,\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{\\pi /2}2x\\operatorname{cos}⁡z\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}2x\\,\\text{d}x\\cdot {\\int }_{0}^{1}\\text{d}y\\cdot {\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡z\\,\\text{d}z \\\\  & =[{x}^{2}]_{x=0}^{x=2}\\cdot (1-0)\\cdot [\\operatorname{sin}⁡z]_{z=0}^{z=\\pi /2} \\\\  & =({2}^{2}-{0}^{2})\\cdot 1\\cdot (\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡0) \\\\  & =4\\cdot 1\\cdot 1 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "638bdd3c-988f-5b06-9b5e-88c81e7acaff" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186234699}] :answer-field/correct {:answer/id #uuid "638bdd3c-988f-5b06-9b5e-88c81e7acaff" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186234699} :answer-field/id #uuid "c9aaca52-991c-54fa-a8a1-2c32329e23f6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235219}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7dc47c56-52c7-5494-aceb-b1baa61e89b6" :question/math-academy-id "q-168617" :question/problem "Let $S$ be the boundary of the region. The flux of the vector field $F$ across $S$ represents the rate at which the air passes through the surface. Given that the surface $S$ is positively (outward) oriented, use the divergence theorem to write down the integral that gives this rate.\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        The required rate is ${∬}_{S}F\\cdot dS={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{4-x-y}$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\text{d}z\\,\\text{d}y\\,\\text{d}x.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nIn part 1, we found that \n\n$$\n\\begin{aligned}\\text{div}\\,F=2x.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2x\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{4-x-y}2x\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082e3c86-e949-5ff4-b33f-cb02c016d1d6" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186278667} {:answer/id #uuid "149426fb-57b1-536b-9c11-dd047080a433" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186278775} {:answer/id #uuid "16d8f309-fda3-575c-a9d3-a8ec0f44cdcc" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186278793} {:answer/id #uuid "4ae65590-f27f-55dc-9769-e7944f343866" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186279261} {:answer/id #uuid "9c741780-eba9-5519-8797-113033813b77" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186279984}] :answer-field/correct {:answer/id #uuid "9c741780-eba9-5519-8797-113033813b77" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186279984} :answer-field/id #uuid "af809870-df22-50bf-a671-64310449b9b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281137}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7e758b54-bd1f-5329-88cb-61523affaf73" :question/math-academy-id "q-162594" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=2,$ $y=0,$ $y=4,$ $z=1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}y\\,i+2z\\,j+xyz\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2}y)+\\frac{∂}{∂y}(2z)+\\frac{∂}{∂z}(xyz) \\\\  & =2xy+0+xy \\\\  & =3xy.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3xy\\,\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{4}{\\int }_{1}^{2}3xy\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x\\,\\text{d}x\\cdot {\\int }_{0}^{4}y\\,\\text{d}y\\cdot {\\int }_{1}^{2}3\\,\\text{d}z \\\\  & ={[\\frac{{x}^{2}}{2}]}_{x=0}^{x=2}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=4}\\cdot [3z]_{z=1}^{z=2} \\\\  & =(2-0)\\cdot (8-0)\\cdot (6-3) \\\\  & =48.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52186257-9f4b-56fb-b960-29a2f63ea399" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279339} {:answer/id #uuid "697dee97-f93f-5355-b963-f4f2ed4536b3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186279547} {:answer/id #uuid "b1c9b24c-57c8-5afa-a32e-082d761b5954" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280164} {:answer/id #uuid "e0aaa464-a730-5cbb-ab6f-fdbf65421878" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186280578} {:answer/id #uuid "ebf8c058-83e0-502b-802f-07d67539564b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186280667}] :answer-field/correct {:answer/id #uuid "697dee97-f93f-5355-b963-f4f2ed4536b3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186279547} :answer-field/id #uuid "12ac0596-1f70-519e-8661-fc2d524e2e33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280863}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dea24fde-a211-5010-b92d-b13afeca9f75" :question/math-academy-id "q-162596" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=1,$ $x=e,$ $y=0,$ $y=2,$ $z=0,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F=y\\operatorname{ln}⁡x\\,i+{z}^{2}\\,j+(x-{y}^{3})\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x)+\\frac{∂}{∂y}({z}^{2})+\\frac{∂}{∂z}(x-{y}^{3}) \\\\  & =\\frac{y}{x}+0+0 \\\\  & =\\frac{y}{x}.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}\\frac{y}{x}\\,\\text{d}V \\\\  & ={\\int }_{1}^{e}{\\int }_{0}^{2}{\\int }_{0}^{2}\\frac{y}{x}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}\\frac{1}{x}\\,\\text{d}x\\cdot {\\int }_{0}^{2}y\\,\\text{d}y\\cdot {\\int }_{0}^{2}\\text{d}z \\\\  & =[\\operatorname{ln}⁡x]_{x=1}^{x=e}\\cdot {[\\frac{{y}^{2}}{2}]}_{y=0}^{y=2}\\cdot [z]_{z=0}^{z=2} \\\\  & =(\\operatorname{ln}⁡e-\\operatorname{ln}⁡1)\\cdot (\\frac{{2}^{2}}{2}-\\frac{{0}^{2}}{2})\\cdot (2-0) \\\\  & =(1-0)\\cdot (2-0)\\cdot (2-0) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "453e572a-9b7a-5c8b-af0a-d4bbab3e02c0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186279211} {:answer/id #uuid "719c2ade-ec2a-5fc4-81bc-42bee8f852aa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186279622} {:answer/id #uuid "a8b4c658-0c6e-58c5-a593-f19bdd138a00" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280083} {:answer/id #uuid "b7e4f34b-b03f-5102-8a05-51e7755ec9a8" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186280208} {:answer/id #uuid "bf7e88cc-1b76-537b-a6f1-169efb2d510e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280275}] :answer-field/correct {:answer/id #uuid "a8b4c658-0c6e-58c5-a593-f19bdd138a00" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186280083} :answer-field/id #uuid "e81d88b2-55dd-5e26-8ccb-24f90e955d12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281246}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e7cc5e4b-aa70-5d55-82a4-140961e3cc36" :question/math-academy-id "q-162599" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=1,$ $y=2,$ $z=1,$ $z=3.$ Given that the surface $S$ is positively (outward) oriented and $F={x}^{2}\\,i+2y\\,j+(x+{y}^{2})\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}({x}^{2})+\\frac{∂}{∂y}(2y)+\\frac{∂}{∂z}(x+{y}^{2}) \\\\  & =2x+2+0 \\\\  & =2x+2.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}(2x+2)\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{2}{\\int }_{1}^{3}(2x+2)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(2x+2)\\,\\text{d}x\\cdot {\\int }_{1}^{2}\\text{d}y\\cdot {\\int }_{1}^{3}\\text{d}z \\\\  & =[{x}^{2}+2x]_{x=0}^{x=1}\\cdot (2-1)\\cdot (3-1) \\\\  & =({1}^{2}+2(1)-0)\\cdot 1\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186281508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0828f14c-57b5-5bff-96a4-41f2ecf9c8cc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186278666} {:answer/id #uuid "601888a6-bae8-5265-8032-ca7466880974" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186279474} {:answer/id #uuid "6f899f87-fc79-53d1-9d8b-59f00b8892d8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279603} {:answer/id #uuid "ce7b1ce6-5db6-5b72-8254-8b233c23921a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186280411} {:answer/id #uuid "f34738d0-7faa-5814-82e1-6d902521196c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186280717}] :answer-field/correct {:answer/id #uuid "6f899f87-fc79-53d1-9d8b-59f00b8892d8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186279603} :answer-field/id #uuid "22288074-59ca-5f02-9943-023604b9357b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280889}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a55db798-fcb0-54c3-9d76-3d7d1e841ffa" :question/math-academy-id "q-162600" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=1,$ $y=2,$ $z=-1,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=2y\\,i+x{y}^{2}\\,j+2xyz\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(2y)+\\frac{∂}{∂y}(x{y}^{2})+\\frac{∂}{∂z}(2xyz) \\\\  & =0+2xy+2xy \\\\  & =4xy.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4xy\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{2}{\\int }_{-1}^{1}4xy\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}2x\\,\\text{d}x\\cdot {\\int }_{1}^{2}2y\\,\\text{d}y\\cdot {\\int }_{-1}^{1}\\text{d}z \\\\  & =[{x}^{2}]_{x=0}^{x=1}\\cdot [{y}^{2}]_{y=1}^{y=2}\\cdot (1-(-1)) \\\\  & =(1-0)\\cdot (4-1)\\cdot 2 \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374200 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25469fa9-aa9b-5ce2-912f-092bcf0c9271" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186374202} {:answer/id #uuid "7ee396c4-83e0-5fa2-ae23-69048563ecb3" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186374203} {:answer/id #uuid "ddac6d93-fada-5b42-9d98-dffa0367488c" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186374204} {:answer/id #uuid "c8406793-5096-5aff-b557-a3bebc57cf38" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186374205} {:answer/id #uuid "88de07a7-1a0f-5f7b-b1a1-718b8c6821c2" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186374206}] :answer-field/correct {:answer/id #uuid "ddac6d93-fada-5b42-9d98-dffa0367488c" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186374204} :answer-field/id #uuid "940992af-dba8-51a2-a024-f36c67d58c17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374201}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c1604058-cdd6-524d-a2be-ab81c147d2ce" :question/math-academy-id "q-162597" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=1,$ $x=3,$ $y=0,$ $y=2,$ $z=-1,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=(y-{x}^{2})\\,i+xy\\,j+3xz\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y-{x}^{2})+\\frac{∂}{∂y}(xy)+\\frac{∂}{∂z}(3xz) \\\\  & =(-2x)+x+3x \\\\  & =2x.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2x\\,\\text{d}V \\\\  & ={\\int }_{1}^{3}{\\int }_{0}^{2}{\\int }_{-1}^{1}2x\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}2x\\,\\text{d}x\\cdot {\\int }_{0}^{2}\\text{d}y\\cdot {\\int }_{-1}^{1}\\text{d}z \\\\  & =[{x}^{2}]_{x=1}^{x=3}\\cdot (2-0)\\cdot (1-(-1)) \\\\  & =(9-1)\\cdot 2\\cdot 2 \\\\  & =32.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1a9148-8e77-5639-ad7f-cbca7f0df0cc" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186374209} {:answer/id #uuid "0bcc0510-4039-55e0-823c-e4ac7d5653d8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186374210} {:answer/id #uuid "0acfab67-9718-5e64-b967-a1914c71eddf" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374211} {:answer/id #uuid "2bf62725-3d23-5464-bf59-4f18a980c4db" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186374212} {:answer/id #uuid "702faaa4-c282-5398-860f-c6e1f3c9bb1f" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186374213}] :answer-field/correct {:answer/id #uuid "0a1a9148-8e77-5639-ad7f-cbca7f0df0cc" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186374209} :answer-field/id #uuid "8ced5422-0477-54ea-a063-de1490b4e5d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374208}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c2a8924c-323c-54ea-b830-8522b9835da1" :question/math-academy-id "q-162602" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=1,$ $y=0,$ $y=3,$ $z=1,$ $z=3.$ Given that the surface $S$ is positively (outward) oriented and $F=(2{x}^{3}+z)\\,i-z\\,j-3{x}^{2}z\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(2{x}^{3}+z)+\\frac{∂}{∂y}(-z)+\\frac{∂}{∂z}(-3{x}^{2}z) \\\\  & =6{x}^{2}+0+(-3{x}^{2}) \\\\  & =3{x}^{2}.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3{x}^{2}\\,\\text{d}V \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{3}{\\int }_{1}^{3}3{x}^{2}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}3{x}^{2}\\text{d}x\\cdot {\\int }_{0}^{3}\\text{d}y\\cdot {\\int }_{1}^{3}\\text{d}z \\\\  & =[{x}^{3}]_{x=-1}^{x=1}\\cdot (3-0)\\cdot (3-1) \\\\  & =({1}^{3}-(-1)^{3})\\cdot 3\\cdot 2 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430948 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12f5be7e-0bfc-59a7-af3a-6dfcf5d7d844" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186430913} {:answer/id #uuid "23e226ce-01b7-5120-bfc5-5949d300bfcf" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186430916} {:answer/id #uuid "475b50f4-a66e-582c-bb09-b18513917dc7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186430921} {:answer/id #uuid "e03f06d7-09f6-5991-8022-a31e044488bf" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186430935} {:answer/id #uuid "ecbcc9d3-a1f4-5e44-b6a6-513ff6a3a28b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186430938}] :answer-field/correct {:answer/id #uuid "ecbcc9d3-a1f4-5e44-b6a6-513ff6a3a28b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186430938} :answer-field/id #uuid "fc27d6bf-860e-505c-82f5-df4b985c7b2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430946}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "09c354f4-ffe0-5d80-b23d-97b7671b8b06" :question/math-academy-id "q-162595" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=2,$ $y=0,$ $y=1,$ $z=-1,$ $z=2.$ Given that the surface $S$ is positively (outward) oriented and $F=y{z}^{2}\\,i-2yz\\,j+3{z}^{2}\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y{z}^{2})+\\frac{∂}{∂y}(-2yz)+\\frac{∂}{∂z}(3{z}^{2}) \\\\  & =0+(-2z)+6z \\\\  & =4z.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}4z\\,\\text{d}V \\\\  & ={\\int }_{-1}^{2}{\\int }_{0}^{1}{\\int }_{-1}^{2}4z\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{-1}^{2}\\text{d}x\\cdot {\\int }_{0}^{1}\\text{d}y\\cdot {\\int }_{-1}^{2}4z\\,\\text{d}z \\\\  & =(2-(-1))\\cdot (1-0)\\cdot [2{z}^{2}]_{z=-1}^{z=2} \\\\  & =3\\cdot 1\\cdot (8-2) \\\\  & =18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ea0e2b-5e7a-52c9-a1b3-f61827c82bd8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186430917} {:answer/id #uuid "676e7034-5bd6-59ee-bc64-fafa0a12a224" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186430926} {:answer/id #uuid "727b00ee-627c-530d-87da-873160a2d3d5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186430930} {:answer/id #uuid "dc5308bb-1224-54c9-a249-060024986a6d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186430934} {:answer/id #uuid "fa91438f-d562-5478-84cb-9cc0479a64c0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186430939}] :answer-field/correct {:answer/id #uuid "727b00ee-627c-530d-87da-873160a2d3d5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186430930} :answer-field/id #uuid "6f84ddbb-0ce0-5549-8bb9-1dfef0b987f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430941}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ce23f40-f256-54cd-9b13-888ae9d3dff9" :question/math-academy-id "q-162605" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=0,$ $x=1,$ $y=1,$ $y=3,$ $z=0,$ $z=\\operatorname{ln}⁡3.$ Given that the surface $S$ is positively (outward) oriented and $F=(y+{z}^{2})\\,i-x\\,j+3{x}^{2}{e}^{z}\\,k,$ find the flux of $F$ across $S.$" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y+{z}^{2})+\\frac{∂}{∂y}(-x)+\\frac{∂}{∂z}(3{x}^{2}{e}^{z}) \\\\  & =0+0+3{x}^{2}{e}^{z} \\\\  & =3{x}^{2}{e}^{z}.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}3{x}^{2}{e}^{z}\\,\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{3}{\\int }_{0}^{\\operatorname{ln}⁡3}3{x}^{2}{e}^{z}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}\\,\\text{d}x\\cdot {\\int }_{1}^{3}\\text{d}y\\cdot {\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{z}\\,\\text{d}z \\\\  & =[{x}^{3}]_{x=0}^{x=1}\\cdot (3-1)\\cdot [{e}^{z}]_{z=0}^{z=\\operatorname{ln}⁡3} \\\\  & =({1}^{3}-{0}^{3})\\cdot 2\\cdot ({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =1\\cdot 2\\cdot (3-1) \\\\  & =4.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Flux Across a Closed Surface"}] [{:db/id #edb/ref 17592186138428 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138083 :question/id #uuid "cbf28a0c-c34d-5855-b72e-4225a11710c1" :question/math-academy-id "e-13129" :question/problem "Consider the following system of equations:\n${x + 2y = 8; 2x - y = 6$\n\nUse the diagram below to determine this system's solution $(x,y)$.\n\n![](images/6f/6f0b7960b9b4c98250741b009da2ad19c1123c5b7adf9cd5072430fb9a879dc9.png)" :question/worked-solution "The solution of the system corresponds to the point of intersection of the lines.\n\n![](images/5c/5c1c69adc880ea7cfdb5a4e0a10abd6032d2eedf0386923b94df9b7c173edd6d.png)\n\nIn this case, we have the point $(4,2)$. Therefore, the solution to the given system is $(4,2)$."} :knowledge-point/id #uuid "0f80bc47-7b56-5357-b4e7-718f4ddfa41b" :knowledge-point/questions [{:db/id #edb/ref 17592186138700 :question/answer-fields [{:answer-field/id #uuid "827fc2ad-fcf7-5342-b52d-405f79525927" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135439} {:answer-field/id #uuid "b60de75b-396f-5a8a-9692-ab3e6fe2d3d8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135440}] :question/id #uuid "c750ebe1-0c7d-5650-92b4-e61ed4c0abda" :question/math-academy-id "q-171700" :question/problem "![](images/af/af8654d3581e41e1d206494fc3e6f0f2d1a9471285c0d9c856484ac966cbdc51.png)\n\nConsider the following system of equations:\n${x + y = 1; 2x + y = 4$\n\nUse the diagram provided to determine the solution $(x, y)$ of this system.\n\nThe solution is\n$($\n{{field-1}}\n$$,\n{{field-2}}\n$)$."} {:db/id #edb/ref 17592186138764 :question/answer-fields [{:answer-field/id #uuid "a6d3b349-7ac8-5a43-ba25-747ee0fca304" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135541} {:answer-field/id #uuid "3995f0d7-4020-5135-aeec-4e993d9b0188" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135542}] :question/id #uuid "bbfdc27f-1f59-586d-a7a6-cadc27ed5daf" :question/math-academy-id "q-238014" :question/problem "![](images/70/7035e6e365263cddf659554a40093d9661a140754d4c195791fd266c9389c3da.png)\n\nConsider the following system of equations:\n${4x - y = 12; y =-3x + 9$\n\nUse the diagram provided to determine the solution $(x, y)$ of this system.\n\nThe solution is\n$($\n{{field-1}}\n$$,\n{{field-2}}\n$)$."}] :knowledge-point/title "Finding the Solution to a System From Its Graph"}] [{:db/id #edb/ref 17592186138429 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138084 :question/id #uuid "86771ced-afc0-5061-a532-bc2345a52ea8" :question/math-academy-id "e-13130" :question/problem "![](images/09/0915c99015922e27855d92ebb13756da634a8f10dd8fe3abbc016590f06e1077.png)\n\nThe graph above shows the number of liters of water in pool $A$ and pool $B$ as a function of time, measured in days. How many days will it take for both pools to contain the same amount of water?" :question/worked-solution "The pools have the same amount of water when the two graphs intersect.\n\n![](images/cf/cf7a9b8bdccbc66086c473813523ed893ee192830965300a8c4a0702ad065fc3.png)\n\nIn this case, we have the point $(5,400)$. So, both pools have the same amount ($400\\,\\textrm{L}$) of water at $t=5$ days."} :knowledge-point/id #uuid "4154d81b-c94a-57f7-80fa-0daa341505e6" :knowledge-point/questions [{:db/id #edb/ref 17592186138783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2e689cf-e055-5aba-b4d2-3b11b04d1e2e" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186135647} {:answer/id #uuid "ec1c3419-1155-5170-be6d-98f1b0176672" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186135648} {:answer/id #uuid "1a814fda-9d35-5744-9906-6c0a6c7069a5" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186135649} {:answer/id #uuid "1c5ebb6d-5110-56a4-bd41-59743682fc49" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186135650} {:answer/id #uuid "3532a08a-d9a7-524b-ae88-f0c36f56f4ec" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186135651}] :answer-field/id #uuid "0609360b-f7ba-52dd-a7b8-807f5c237c61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135646}] :question/id #uuid "10d6cebb-53da-57a8-b24b-2a1a1f8f0163" :question/math-academy-id "q-45165" :question/problem "![](images/0d/0d5e3ef2393a00fc74c91ebc44f71d553e641d0e1bca21bf783252cbafcca84c.png)\n\nThe graph above shows the speed of cars $A$ and $B$ as a function of the distance that they traveled during a brake test. At which distance, in meters, did both cars reach the same speed?"} {:db/id #edb/ref 17592186139116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8337461-4342-5b9c-8484-145234157d30" :answer/type {:db/ident :answer.type/math} :answer/value "3h" :db/id #edb/ref 17592186137645} {:answer/id #uuid "fac79086-a744-5542-af8a-0dc08066528c" :answer/type {:db/ident :answer.type/math} :answer/value "6h" :db/id #edb/ref 17592186137646} {:answer/id #uuid "457e9b7f-b0e1-5c8a-85f7-66a18dd92b73" :answer/type {:db/ident :answer.type/math} :answer/value "5h" :db/id #edb/ref 17592186137647} {:answer/id #uuid "65a7608d-9c83-510d-a732-df0fa09b2c61" :answer/type {:db/ident :answer.type/math} :answer/value "2h" :db/id #edb/ref 17592186137648} {:answer/id #uuid "76d46f6f-2c96-5f74-acbf-ddb738b654ac" :answer/type {:db/ident :answer.type/math} :answer/value "4h" :db/id #edb/ref 17592186137649}] :answer-field/id #uuid "3b856f10-522c-5eaa-860d-a2dd17029956" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186137644}] :question/id #uuid "ac5a82e8-bf81-5b0e-b617-f0a11d180015" :question/math-academy-id "q-59886" :question/problem "![](images/b9/b91b1093a485c671cb5e7566498a1e2b95452d9b92ea87e478696ff8c9ace0ff.png)\n\nTwo trucks, Truck $A$ and Truck $B$, are carrying shipments between distribution centers. The graph above shows the distances (in miles) of Truck $A$ and Truck $B$ from one of the centers as a function of time (in hours). At what time are Truck $A$ and Truck $B$ the same distance from the center?"}] :knowledge-point/title "Word Problems"}] [{:db/id #edb/ref 17592186152116 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151877 :question/id #uuid "78763507-6493-5a57-91a1-1c0c92324473" :question/math-academy-id "e-14805" :question/problem "Find the least common multiple of $4(x+1)$ and $6(x+1).$" :question/worked-solution "To find the least common multiple ($\\textrm{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nFirst, we find $\\textrm{LCM}(4,6)\\mathbin{:}$\n\n- Multiples of $4\\mathbin{:}$ $\\quad 4, \\, 8, \\, {\\color{blue}12}, \\ldots$\n\n- Multiples of $6\\mathbin{:}$ $\\quad 6, \\, {\\color{blue}12}, \\, 18, \\ldots$\n\nSo, $\\textrm{LCM}(4,6) =  {\\color{blue}{12}}.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\textrm{LCM}\\left((x+1), \\, (x+1)\\right) = {\\color{red}{(x+1)}}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\textrm{LCM}\\left(4(x+1), \\, 6(x+1)\\right) = {\\color{blue}{12}}\\cdot {\\color{red}{(x+1)}} = 12(x+1).\n$$"} :knowledge-point/id #uuid "db871222-7398-5fea-8097-bcf669751a40" :knowledge-point/questions [{:db/id #edb/ref 17592186152511 :question/answer-fields [{:answer-field/id #uuid "c7bb582a-acb7-5544-b886-1bb65181448f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186149595}] :question/id #uuid "e6a42137-9fd1-5780-b649-7b5f194f63a7" :question/math-academy-id "q-218482" :question/problem "The least common multiple of $6(w - 8)$ and $15(w - 8)$ is {{field-1}}."} {:db/id #edb/ref 17592186152733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9daf35c8-cab9-5735-9f9d-2b637a85574f" :answer/type {:db/ident :answer.type/math} :answer/value "30(x - 1)^{2}" :db/id #edb/ref 17592186150906} {:answer/id #uuid "f21c8387-a425-5935-ade9-82c8941b2ab2" :answer/type {:db/ident :answer.type/math} :answer/value "30(x - 1)" :db/id #edb/ref 17592186150907} {:answer/id #uuid "fdcf8ac0-ce3d-5200-8666-4621b93e0f25" :answer/type {:db/ident :answer.type/math} :answer/value "8(x - 1)" :db/id #edb/ref 17592186150908} {:answer/id #uuid "2009ce06-5aed-57af-8b84-6b7f745682d1" :answer/type {:db/ident :answer.type/math} :answer/value "15(x - 1)" :db/id #edb/ref 17592186150909} {:answer/id #uuid "5c1faa04-8c34-5f95-82cc-1ffef00adffc" :answer/type {:db/ident :answer.type/math} :answer/value "15(x - 1)^{2}" :db/id #edb/ref 17592186150910}] :answer-field/id #uuid "4335f336-bfff-56e8-8645-a45d5b136a09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150905}] :question/id #uuid "3a9fca8b-ae63-5742-985d-da434e1bb1cc" :question/math-academy-id "q-76238" :question/problem "Find the least common multiple of $3(x - 1)$ and $5(x - 1)$."} {:db/id #edb/ref 17592186247230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8d13e1-a99f-5ab7-a526-b7cfba5e8813" :answer/type {:db/ident :answer.type/math} :answer/value "9(z-4)^{2}" :db/id #edb/ref 17592186244444} {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} {:answer/id #uuid "7c28feb1-7589-5e8d-9418-28850a614574" :answer/type {:db/ident :answer.type/math} :answer/value "28(z-4)^{4}" :db/id #edb/ref 17592186245401} {:answer/id #uuid "a73784f2-2fb7-5100-b1a9-c95f9187984f" :answer/type {:db/ident :answer.type/math} :answer/value "28(z-4)^{2}" :db/id #edb/ref 17592186245812} {:answer/id #uuid "f54ce985-d718-578e-8921-d62dfebbfd89" :answer/type {:db/ident :answer.type/math} :answer/value "14(z-4)^{4}" :db/id #edb/ref 17592186246478}] :answer-field/correct {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} :answer-field/id #uuid "b7db519b-b493-5c2a-b1f8-3f09714be182" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246881}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1022040b-f64c-5ed6-9959-011542bf6e8b" :question/math-academy-id "q-111582" :question/problem "Find the least common multiple of $2(z-4)^{2}$ and $7(z-4)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(2,7):$\n\n- Multiples of $2:$ $\\,2,\\,4,…,\\,12,\\,14,16,…$\n\n- Multiples of $7:$ $\\,7,\\,14,\\,21,…$\n\nSo, $\\text{LCM}(2,7)=14.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((z-4)^{2},\\,(z-4)^{2})=(z-4)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(2(z-4)^{2},\\,7(z-4)^{2})=14\\cdot (z-4)^{2}=14(z-4)^{2}.\n$$"} {:db/id #edb/ref 17592186290383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56763c56-e76a-5f24-b49e-928932323992" :answer/type {:db/ident :answer.type/math} :answer/value "36(y-3)" :db/id #edb/ref 17592186288630}] :answer-field/correct {:answer/id #uuid "56763c56-e76a-5f24-b49e-928932323992" :answer/type {:db/ident :answer.type/math} :answer/value "36(y-3)" :db/id #edb/ref 17592186288630} :answer-field/id #uuid "a1550040-6aa8-5d6a-8568-bc6df52c06d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290087}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fa4632cb-7d35-54aa-89c7-812065d4a185" :question/math-academy-id "q-221994" :question/problem "The least common multiple of $4(y-3)$ and $9(y-3)$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(4,9):$\n\n- Multiples of $4:$ $\\,4,\\,8,\\,12,\\,16,\\,20,\\,24,\\,28,\\,32,\\,36,…$\n\n- Multiples of $9:$ $\\,9,\\,18,\\,27,\\,36,\\,45,\\,54,…$\n\nSo, $\\text{LCM}(4,9)=36.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y-3),\\,(y-3))=(y-3).\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(4(y-3),\\,9(y-3))=36\\cdot (y-3)=36(y-3).\n$$"} {:db/id #edb/ref 17592186290384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "859c7d02-8e63-53b8-829d-0eac5b214280" :answer/type {:db/ident :answer.type/math} :answer/value "9(y+7)^{2}" :db/id #edb/ref 17592186288936}] :answer-field/correct {:answer/id #uuid "859c7d02-8e63-53b8-829d-0eac5b214280" :answer/type {:db/ident :answer.type/math} :answer/value "9(y+7)^{2}" :db/id #edb/ref 17592186288936} :answer-field/id #uuid "251d4be3-7af4-5b71-ac48-27f09bb2de97" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289817}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a0fbd6c-5258-5a3a-8b3d-54cb21af5e4c" :question/math-academy-id "q-221998" :question/problem "The least common multiple of $3(y+7)^{2}$ and $9(y+7)^{2}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(3,9):$\n\n- Multiples of $3:$ $\\,3,\\,6,\\,9,\\,12,…$\n\n- Multiples of $9:$ $\\,9,\\,18,\\,27,…$\n\nSo, $\\text{LCM}(3,9)=9.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y+7)^{2},\\,(y+7)^{2})=(y+7)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(3(y+7)^{2},\\,9(y+7)^{2})=9\\cdot (y+7)^{2}=9(y+7)^{2}\n$$"} {:db/id #edb/ref 17592186290385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b793f73-b71e-50c2-add9-fd3bb120bcb6" :answer/type {:db/ident :answer.type/math} :answer/value "20(z-1)^{2}" :db/id #edb/ref 17592186288876}] :answer-field/correct {:answer/id #uuid "7b793f73-b71e-50c2-add9-fd3bb120bcb6" :answer/type {:db/ident :answer.type/math} :answer/value "20(z-1)^{2}" :db/id #edb/ref 17592186288876} :answer-field/id #uuid "1b0c5483-7da3-5d90-973c-277dfae26c5b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289795}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c61a52da-f3a4-50e1-b761-609814a1be75" :question/math-academy-id "q-221999" :question/problem "The least common multiple of $4(z-1)^{2}$ and $10(z-1)^{2}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(4,10):$\n\n- Multiples of $4:$ $\\,4,\\,8,\\,12,\\,16,\\,20,\\,24,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,\\,50,…$\n\nSo, $\\text{LCM}(4,10)=20.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((z-1)^{2},\\,(z-1)^{2})=(z-1)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(4(z-1)^{2},\\,10(z-1)^{2})=20\\cdot (z-1)^{2}=20(z-1)^{2}\n$$"} {:db/id #edb/ref 17592186345215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c5daec-215b-519e-b948-8734e5d06899" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{2}" :db/id #edb/ref 17592186342961} {:answer/id #uuid "9a145a1b-f7bd-50a4-9259-671b24f22358" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)^{2}" :db/id #edb/ref 17592186343593} {:answer/id #uuid "a3779eca-872e-5e74-9368-f9fe0b4b4b79" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)" :db/id #edb/ref 17592186343675} {:answer/id #uuid "ad143ae4-f941-5eef-b5ef-3f8ba889a17e" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)" :db/id #edb/ref 17592186343762} {:answer/id #uuid "c729e1de-709f-58cd-b65e-918025a0a02d" :answer/type {:db/ident :answer.type/math} :answer/value "25(y+1)" :db/id #edb/ref 17592186343984}] :answer-field/correct {:answer/id #uuid "ad143ae4-f941-5eef-b5ef-3f8ba889a17e" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)" :db/id #edb/ref 17592186343762} :answer-field/id #uuid "48e9ac68-09ff-54ff-a3e2-f44557a9b1fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344615}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a0aeedc6-9345-53e2-9356-b127ab780aee" :question/math-academy-id "q-76409" :question/problem "Find the least common multiple of $10(y+1)$ and $15(y+1).$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y+1),\\,(y+1))=(y+1).\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1),\\,15(y+1))=30\\cdot (y+1)=30(y+1).\n$$"}] :knowledge-point/title "Finding the LCM of Two Polynomials that Differ by a Constant Factor"}] [{:db/id #edb/ref 17592186152117 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151879 :question/id #uuid "588a1460-6cd3-519a-ae98-7bc80c7a946c" :question/math-academy-id "e-14809" :question/problem "Find the least common multiple of $9(x-1)^4$ and $12(x-1)^2.$" :question/worked-solution "To find the least common multiple ($\\textrm{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nFirst, we find $\\textrm{LCM}(9,12)\\mathbin{:}$\n\n- Multiples of $9 \\mathbin{:}$ $\\quad 9, \\, 18, \\, 27, \\, {\\color{blue}36}, \\, 45, \\ldots$\n\n- Multiples of $12 \\mathbin{:}$ $\\quad 12, \\, 24, \\, {\\color{blue}36}, \\, 48, \\ldots$\n\nSo, $\\textrm{LCM}(9,12) =  {\\color{blue}{36}}.$\n\nTo find the $\\textrm{LCM}$ of $(x-1)^4$ and $(x-1)^2,$ we raise $(x-1)$ to the largest power that appears in the expressions, which is $4.$ Therefore,\n\n$$\n\\textrm{LCM}\\left((x-1)^4, \\, (x-1)^2\\right) = {\\color{red}{(x-1)^4}}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\textrm{LCM}\\left(9(x-1)^4, \\, 12(x-1)^2\\right) = {\\color{blue}{36}}\\cdot {\\color{red}{(x-1)^4}} = 36(x-1)^4.\n$$"} :knowledge-point/id #uuid "92a06a13-9e6b-53b1-9fad-ec6cba8b9545" :knowledge-point/questions [{:db/id #edb/ref 17592186152516 :question/answer-fields [{:answer-field/id #uuid "fe98f23f-b63f-5b3b-93d9-9bd2e3e5e383" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186149600}] :question/id #uuid "23d9a941-362d-5b43-b727-77e05cacf8dd" :question/math-academy-id "q-222016" :question/problem "The least common multiple of $9(y + 7)^{4}$ and $3(y + 7)^{2}$ is {{field-1}}."} {:db/id #edb/ref 17592186152744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "813b9d12-3005-5562-83e3-cad4df49c185" :answer/type {:db/ident :answer.type/math} :answer/value "6(y - 4)^{3}" :db/id #edb/ref 17592186150972} {:answer/id #uuid "bdf863f9-99db-5789-b184-4076d8cec3a4" :answer/type {:db/ident :answer.type/math} :answer/value "6(y - 4)^{2}" :db/id #edb/ref 17592186150973} {:answer/id #uuid "cf4c912f-c08f-5c71-82d9-cc97eb31bdfb" :answer/type {:db/ident :answer.type/math} :answer/value "2(y - 4)^{2}" :db/id #edb/ref 17592186150974} {:answer/id #uuid "305525ba-5cd5-544c-aa63-b2c499bf7789" :answer/type {:db/ident :answer.type/math} :answer/value "3(y - 4)^{2}" :db/id #edb/ref 17592186150975} {:answer/id #uuid "5348a2fd-31a6-5cfe-9567-cf6e85ce552b" :answer/type {:db/ident :answer.type/math} :answer/value "3(y - 4)" :db/id #edb/ref 17592186150976}] :answer-field/id #uuid "e9ab3b75-da54-5fa7-8a97-d807052c826f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150971}] :question/id #uuid "1d8ab5a8-e076-5cc6-9e2b-5fc7fcef9ac6" :question/math-academy-id "q-76460" :question/problem "Find the least common multiple of $2(y - 4)^{2}$ and $3(y - 4)$."} {:db/id #edb/ref 17592186290353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce81a481-fe7e-518c-a1d7-bd34e84fea7f" :answer/type {:db/ident :answer.type/math} :answer/value "14(z+3)^{5}" :db/id #edb/ref 17592186289409}] :answer-field/correct {:answer/id #uuid "ce81a481-fe7e-518c-a1d7-bd34e84fea7f" :answer/type {:db/ident :answer.type/math} :answer/value "14(z+3)^{5}" :db/id #edb/ref 17592186289409} :answer-field/id #uuid "cb6457be-66fa-5a61-8d4b-7978b2734725" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290173}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cd9da29a-b393-5138-bdff-e8e16834aa3d" :question/math-academy-id "q-218483" :question/problem "The least common multiple of $7(z+3)^{2}$ and $2(z+3)^{5}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(7,2):$\n\n- Multiples of $7:$ $\\,7,\\,14,\\,28,…$\n\n- Multiples of $2:$ $\\,2,\\,4,\\,6,\\,8,\\,10,\\,12,\\,14,\\,24,…$\n\nSo, $\\text{LCM}(7,2)=14.$\n\nTo find the $\\text{LCM}$ of $(z+3)^{2}$ and $(z+3)^{5}$ we raise $(z+3)$ to the largest power that appears in the expressions, which is $5.$ Therefore,\n\n$$\n\\text{LCM}((z+3)^{2},\\,(z+3)^{5})=(z+3)^{5}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(7(z+3)^{2},\\,2(z+3)^{5})=14\\cdot (z+3)^{5}=14(z+3)^{5}.\n$$"} {:db/id #edb/ref 17592186290386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020bcddf-6dba-5a6c-bfad-755a7d039e8e" :answer/type {:db/ident :answer.type/math} :answer/value "40(x-1)^{4}" :db/id #edb/ref 17592186288041}] :answer-field/correct {:answer/id #uuid "020bcddf-6dba-5a6c-bfad-755a7d039e8e" :answer/type {:db/ident :answer.type/math} :answer/value "40(x-1)^{4}" :db/id #edb/ref 17592186288041} :answer-field/id #uuid "a425cf36-1923-5b1e-a442-6afa4a3ee362" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290100}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "920b8fd7-c6c7-592b-b8ac-58c5083f2e3a" :question/math-academy-id "q-222013" :question/problem "The least common multiple of $5(x-1)^{3}$ and $8(x-1)^{4}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(5,8):$\n\n- Multiples of $5:$ $\\,5,\\,10,\\,15,\\,20,\\,25,\\,30,\\,35,\\,40,…$\n\n- Multiples of $8:$ $\\,8,\\,16,\\,24,\\,32,\\,40,\\,48,\\,56,…$\n\nSo, $\\text{LCM}(5,8)=40.$\n\nTo find the $\\text{LCM}$ of $(x-1)^{3}$ and $(x-1)^{4}$ we raise $(x-1)$ to the largest power that appears in the expressions, which is $4.$ Therefore,\n\n$$\n\\text{LCM}((x-1)^{3},\\,(x-1)^{4})=(x-1)^{4}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(5(x-1)^{3},\\,8(x-1)^{4})=40\\cdot (x-1)^{4}=40(x-1)^{4}\n$$"} {:db/id #edb/ref 17592186290387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2d2fef-25c0-587d-b915-1baa50eebd4d" :answer/type {:db/ident :answer.type/math} :answer/value "30(w+3)^{6}" :db/id #edb/ref 17592186288133}] :answer-field/correct {:answer/id #uuid "0e2d2fef-25c0-587d-b915-1baa50eebd4d" :answer/type {:db/ident :answer.type/math} :answer/value "30(w+3)^{6}" :db/id #edb/ref 17592186288133} :answer-field/id #uuid "710e948a-0db1-5114-aba0-8bf4d460ca33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289978}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a3b9782f-5b5f-5eb0-8fa1-1ab86047cc94" :question/math-academy-id "q-222021" :question/problem "The least common multiple of $15(w+3)^{3}$ and $10(w+3)^{6}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(15,10):$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,\\,60,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\nSo, $\\text{LCM}(15,10)=30.$\n\nTo find the $\\text{LCM}$ of $(w+3)^{3}$ and $(w+3)^{6},$ we raise $(w+3)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((w+3)^{3},\\,(w+3)^{6})=(w+3)^{6}\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(15(w+3)^{3},\\,10(w+3)^{6})=30\\cdot (w+3)^{6}=30(w+3)^{6}\n$$"} {:db/id #edb/ref 17592186290388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a0e110-653e-5959-ac4f-8f4f958ca254" :answer/type {:db/ident :answer.type/math} :answer/value "40(y-2)^{9}" :db/id #edb/ref 17592186288173}] :answer-field/correct {:answer/id #uuid "14a0e110-653e-5959-ac4f-8f4f958ca254" :answer/type {:db/ident :answer.type/math} :answer/value "40(y-2)^{9}" :db/id #edb/ref 17592186288173} :answer-field/id #uuid "8051f9f9-9451-50a9-a1e3-eb0f9fd17f95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290011}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b0cd1da4-cfec-56f1-a8d9-6ec40f8f1bec" :question/math-academy-id "q-222022" :question/problem "The least common multiple of $8(y-2)^{9}$ and $20(y-2)^{7}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(8,20):$\n\n- Multiples of $8:$ $\\,8,\\,16,\\,24,\\,32,\\,40,…$\n\n- Multiples of $20:$ $\\,20,\\,40,\\,60,\\,80,…$\n\nSo, $\\text{LCM}(8,20)=40.$\n\nTo find the $\\text{LCM}$ of $(y-2)^{9}$ and $(y-2)^{7},$ we raise $(y-2)$ to the largest power that appears in the expressions, which is $9.$ Therefore,\n\n$$\n\\text{LCM}((y-2)^{9},\\,(y-2)^{7})=(y-2)^{9}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(8(y-2)^{9},\\,20(y-2)^{7})=40\\cdot (y-2)^{9}=40(y-2)^{9}\n$$"} {:db/id #edb/ref 17592186345221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} {:answer/id #uuid "a00fafbc-22ed-52d6-8f01-31dffa057768" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{10}" :db/id #edb/ref 17592186343651} {:answer/id #uuid "da747809-5242-5b07-9971-7285cceb6b5c" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)^{10}" :db/id #edb/ref 17592186344157} {:answer/id #uuid "eb3e407c-9b56-57b2-833f-24e819c942f6" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{12}" :db/id #edb/ref 17592186344298} {:answer/id #uuid "eb9d1027-57d3-5a23-9b93-f847e9338320" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)^{6}" :db/id #edb/ref 17592186344302}] :answer-field/correct {:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} :answer-field/id #uuid "81b1b5e2-12f3-59b8-8a06-c39c41de6a36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344722}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6fe6c820-9683-5a7a-b33c-5f323f0359af" :question/math-academy-id "q-76457" :question/problem "Find the least common multiple of $10(y+1)^{6}$ and $15(y+1)^{4}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nTo find the $\\text{LCM}$ of $(y+1)^{6}$ and $(y+1)^{4},$ we raise $(y+1)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((y+1)^{6},\\,(y+1)^{4})=(y+1)^{6}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1)^{6},\\,15(y+1)^{4})=30\\cdot (y+1)^{6}=30(y+1)^{6}.\n$$"}] :knowledge-point/title "Finding the LCM of Two Single-Variable Polynomials"}]}
