.type/blank} :db/id #edb/ref 17592186297151}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a09e33e6-12c2-544c-8fa4-02ef6f3be0de" :question/math-academy-id "q-308849" :question/problem "Given that $y=8ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8ln⁡x) \\\\  & =8\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =8\\cdot \\frac{1}{x} \\\\  & =\\frac{8}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ee19c8-ffa3-51c2-90c8-f32e76bf3ba8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4x}" :db/id #edb/ref 17592186312005} {:answer/id #uuid "04e1e1ed-ae8d-46b8-ab8d-1085b1802387" :answer/type {:db/ident :answer.type/math} :answer/value "11/(4x)" :db/id #edb/ref 17592186409335}] :answer-field/correct {:answer/id #uuid "04ee19c8-ffa3-51c2-90c8-f32e76bf3ba8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4x}" :db/id #edb/ref 17592186312005} :answer-field/id #uuid "e6760650-0666-56ec-a209-471cd8d6b267" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314644}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dffc415e-0ffd-5f91-84e8-ab042b2a6f3c" :question/math-academy-id "q-339949" :question/problem "Given that $y=\\frac{11}{4}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}ln⁡x) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{x} \\\\  & =\\frac{11}{4x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77574496-a3d5-5133-b54d-5a41edeef925" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{3x}" :db/id #edb/ref 17592186312931} {:answer/id #uuid "8d49850c-09b0-4746-acd2-5bace5c80ed5" :answer/type {:db/ident :answer.type/math} :answer/value "-7/(3x)" :db/id #edb/ref 17592186409336}] :answer-field/correct {:answer/id #uuid "77574496-a3d5-5133-b54d-5a41edeef925" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{3x}" :db/id #edb/ref 17592186312931} :answer-field/id #uuid "2d5f9fb9-2594-5780-812f-98f59dc7cafe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314132}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eeedc903-d84c-5e00-bc96-dcee7bf9bc01" :question/math-academy-id "q-339950" :question/problem "Given that $y=-\\frac{7}{3}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{7}{3}ln⁡x) \\\\  & =-\\frac{7}{3}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =-\\frac{7}{3}\\cdot \\frac{1}{x} \\\\  & =-\\frac{7}{3x}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"}] [{:db/id #edb/ref 17592186096614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096414 :question/id #uuid "58d47fb0-cf75-58c4-8eea-f3ae97333159" :question/math-academy-id "e-3628" :question/problem "Given that $f(x)=2\\ln x+x^2-1$, find $f'(x).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\eqalign{\n\t\t\tf'(x) &= \\left(2\\ln x+x^2-1\\right)'\\\n\t\t\t&=2 \\cdot \\dfrac{1}{x}+2x-0\\\n\t\t\t&=\\dfrac{2}{x}+2x.\n\n}\n$$"} :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/questions [{:db/id #edb/ref 17592186097156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1045aaaf-0a76-5469-afdc-876ec049ae29" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}-ln⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186284929} {:answer/id #uuid "aa30aba2-91df-575b-9e42-a1c8a2d47cbf" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}ln⁡x-\\frac{1}{x}" :db/id #edb/ref 17592186286338} {:answer/id #uuid "c13aff45-c853-5d8b-ae11-7b4d6befdcb6" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡11+\\frac{5}{x}" :db/id #edb/ref 17592186286556} {:answer/id #uuid "eff2509a-f3c8-5644-a073-b8761ffb95e6" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}ln⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186286990} {:answer/id #uuid "ff507140-fe41-5deb-989d-ac21680f83b3" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}-\\frac{1}{x}" :db/id #edb/ref 17592186287129}] :answer-field/correct {:answer/id #uuid "eff2509a-f3c8-5644-a073-b8761ffb95e6" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}ln⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186286990} :answer-field/id #uuid "38feddcb-991e-5fb6-9fb0-47bd31940554" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287264}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1cb4423b-343c-5035-85a6-f38acaa8835d" :question/math-academy-id "q-1919" :question/problem "Find ${f}^{′}(x)$ for $f(x)={11}^{x}-5ln⁡x.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({11}^{x}-5ln⁡x) \\\\  & ={11}^{x}\\cdot ln⁡11-5(\\frac{1}{x}) \\\\  & ={11}^{x}ln⁡11-\\frac{5}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8847ec53-1ef1-5244-9261-3db213a50ea2" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x}\\ln x + \\frac{1}{x}" :db/id #edb/ref 17592186094916} {:answer/id #uuid "af4a5664-c507-5fd9-af8c-e68ce9129a6b" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x}\\ln - 5 + \\frac{2}{x}" :db/id #edb/ref 17592186094917} {:answer/id #uuid "d160ad97-ce05-5c09-a415-37e669bc37d0" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{x} + \\frac{1}{x}" :db/id #edb/ref 17592186094918} {:answer/id #uuid "f0f5dc19-0891-5c65-ba47-3963e6e0a451" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x} - \\ln 3 + \\frac{2}{x}" :db/id #edb/ref 17592186094919} {:answer/id #uuid "fdb7af8c-26aa-56d2-9b2c-2028d177a3e0" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x} + \\frac{2}{x}" :db/id #edb/ref 17592186094920}] :answer-field/id #uuid "e0978740-9d55-5364-bce6-ab2f65f0ed46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094915}] :question/id #uuid "e09c4141-d749-574e-b1a3-1f49f5b7e3d8" :question/math-academy-id "q-1920" :question/problem "Calculate $\\frac{dy}{dx}$ for $y =-5e^{x} + 2\\ln x$."} {:db/id #edb/ref 17592186233262 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The negative coefficient remains negative: d[-3x^2]/dx = -6x." :answer/id #uuid "3b2b9b31-ff69-5fd5-b05e-2f7659ff135f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}+6x+2" :db/id #edb/ref 17592186408180} {:answer/feedback "Differentiate term by term: d[5 ln(x)]/dx = 5/x, d[-3x^2]/dx = -6x, and d[2x]/dx = 2." :answer/id #uuid "0d5c95ed-e8ad-537b-a8d6-7a28ab66e027" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-6x+2" :db/id #edb/ref 17592186408181} {:answer/feedback "The coefficient 5 multiplies the derivative of ln(x): d[5 ln(x)]/dx = 5/x, not 1/x." :answer/id #uuid "91dae272-a571-532b-b8c9-5f1a0d446765" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-6x+2" :db/id #edb/ref 17592186408182} {:answer/feedback "Differentiate the quadratic term as well: d[-3x^2]/dx = -6x; the original -3x^2 term cannot remain in the derivative." :answer/id #uuid "3b96cf13-3041-512c-817b-bce2b6cd16ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-3x^{2}+2" :db/id #edb/ref 17592186408183} {:answer/feedback "The power rule gives d[-3x^2]/dx = -3(2x) = -6x. Include the factor 2 from the exponent." :answer/id #uuid "441d1cc7-ac98-5400-9e91-3512f2bc8afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-3x+2" :db/id #edb/ref 17592186408184}] :answer-field/correct {:answer/feedback "Differentiate term by term: d[5 ln(x)]/dx = 5/x, d[-3x^2]/dx = -6x, and d[2x]/dx = 2." :answer/id #uuid "0d5c95ed-e8ad-537b-a8d6-7a28ab66e027" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-6x+2" :db/id #edb/ref 17592186408181} :answer-field/id #uuid "11eacdbf-0599-50c9-89ae-2687d890483f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408185}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0a394889-e060-5e16-b9db-b5d3312e9a55" :question/math-academy-id "q-11914" :question/problem "Given that $y=5\\operatorname{ln}x-3{x}^{2}+2x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}x-3{x}^{2}+2x) \\\\  & =5(\\frac{1}{x})-3\\cdot 2x+2 \\\\  & =\\frac{5}{x}-6x+2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74933759-75c5-532d-af31-afd3380ef04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi {x}^{\\pi -1}" :db/id #edb/ref 17592186232808}] :answer-field/correct {:answer/id #uuid "74933759-75c5-532d-af31-afd3380ef04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi {x}^{\\pi -1}" :db/id #edb/ref 17592186232808} :answer-field/id #uuid "68d840e4-5315-5b1c-ac1b-5463bf99806d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232807}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ef040da7-239c-5fb0-8704-10d30763e312" :question/math-academy-id "q-339973" :question/problem "Given that $y=2\\operatorname{ln}x+{x}^{\\pi }+1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}x+{x}^{\\pi }+1) \\\\  & =2(\\frac{1}{x})+\\pi {x}^{\\pi -1} \\\\  & =\\frac{2}{x}+\\pi {x}^{\\pi -1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0384a71b-bf28-515f-8b2b-476abb5fca12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-10+7{x}^{2}" :db/id #edb/ref 17592186235817} {:answer/id #uuid "4e8c24ce-0ee5-5eba-b662-bb6dcb3d78e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186236321} {:answer/id #uuid "5659c514-e496-58f4-9efc-5892bb18fbec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186236366} {:answer/id #uuid "682d240f-295a-54b0-8f99-5ef92b911aaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+10+21{x}^{3}" :db/id #edb/ref 17592186236477} {:answer/id #uuid "fee011ed-5418-5bfa-a0ce-9610f711b134" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{x}+10+21{x}^{2}" :db/id #edb/ref 17592186237440}] :answer-field/correct {:answer/id #uuid "5659c514-e496-58f4-9efc-5892bb18fbec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186236366} :answer-field/id #uuid "23a9552c-cb8c-5d34-a069-fe4c1cccbba6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237483}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2ed4b1bb-20cc-53c5-859e-2495715a907d" :question/math-academy-id "q-101716" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=2\\operatorname{ln}⁡x-10x+7{x}^{3}-1.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x-10x+7{x}^{3}-1) \\\\  & =2(\\frac{1}{x})-10+21{x}^{2} \\\\  & =\\frac{2}{x}-10+21{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bf5cf8-eaf1-5b10-8d2a-662c31b3b508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186250885} {:answer/id #uuid "783b0f4c-199c-5928-b08e-dcb4df838be4" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{2}{x}" :db/id #edb/ref 17592186251549} {:answer/id #uuid "89f1e417-01f6-5b82-ba77-84fd142edcc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186251714} {:answer/id #uuid "e0afa8a6-a60b-5d30-b8a6-b2c64b3b9e85" :answer/type {:db/ident :answer.type/math} :answer/value "2x+\\frac{1}{x}" :db/id #edb/ref 17592186252532} {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782}] :answer-field/correct {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782} :answer-field/id #uuid "ef06db64-440f-52c2-ab98-0824b44d15d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253222}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2a7a5557-d240-5298-a285-f0853a897b06" :question/math-academy-id "q-11911" :question/problem "Given that $y=2x+ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+ln⁡x) \\\\  & =2+\\frac{1}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cae6982-03b7-597e-93e4-369fa68c8f5f" :answer/type {:db/ident :answer.type/math} :answer/value "3e+1" :db/id #edb/ref 17592186296102}] :answer-field/correct {:answer/id #uuid "9cae6982-03b7-597e-93e4-369fa68c8f5f" :answer/type {:db/ident :answer.type/math} :answer/value "3e+1" :db/id #edb/ref 17592186296102} :answer-field/id #uuid "e26d719b-6dbc-535a-8df8-4e273868c85f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297102}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "395be2fc-ff05-5c2f-8d61-c5ab0d5aca86" :question/math-academy-id "q-308854" :question/problem "Given the function  $y=3{x}^{e}+ln⁡x,$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{e}+ln⁡x) \\\\  & =3e{x}^{e-1}+\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(3e{x}^{e-1}+\\frac{1}{x})|}_{x=1} \\\\  & =3e\\cdot {1}^{e-1}+\\frac{1}{1} \\\\  & =3e+1\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596bfc33-1d46-58a1-9057-d28b147c68d1" :answer/type {:db/ident :answer.type/math} :answer/value "2+e" :db/id #edb/ref 17592186312691}] :answer-field/correct {:answer/id #uuid "596bfc33-1d46-58a1-9057-d28b147c68d1" :answer/type {:db/ident :answer.type/math} :answer/value "2+e" :db/id #edb/ref 17592186312691} :answer-field/id #uuid "ac34aef1-8e01-5f48-b043-096d0f12b55a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314475}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ff04e1e3-e896-53d9-a3c6-32e3bf7042a0" :question/math-academy-id "q-340099" :question/problem "Given the function  $y=2\\operatorname{ln}⁡x+{e}^{x}$, find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x+{e}^{x}) \\\\  & =\\frac{2}{x}+{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x}+{e}^{x})|}_{x=1} \\\\  & =\\frac{2}{1}+{e}^{1} \\\\  & =2+e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "566f2bfd-9b10-5889-ad0c-475cdee4aa4a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}+2{e}^{2}" :db/id #edb/ref 17592186312672}] :answer-field/correct {:answer/id #uuid "566f2bfd-9b10-5889-ad0c-475cdee4aa4a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}+2{e}^{2}" :db/id #edb/ref 17592186312672} :answer-field/id #uuid "675f05c9-21d9-5557-bbbf-524e71c7eea0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314301}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4272d4a8-55fd-5380-aaa8-0f20266b3bc5" :question/math-academy-id "q-340100" :question/problem "Given the function  $y=-3\\operatorname{ln}⁡x+2{e}^{x}+4$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+2{e}^{x}+4) \\\\  & =-\\frac{3}{x}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(-\\frac{3}{x}+2{e}^{x})|}_{x=2} \\\\  & =-\\frac{3}{2}+2{e}^{2}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39500646-122f-5de4-a3f8-1b1dfa91aa61" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{4}{3}\\operatorname{ln}(2)" :db/id #edb/ref 17592186312439}] :answer-field/correct {:answer/id #uuid "39500646-122f-5de4-a3f8-1b1dfa91aa61" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{4}{3}\\operatorname{ln}(2)" :db/id #edb/ref 17592186312439} :answer-field/id #uuid "c1560d5a-5716-563a-970a-84ea931d3b0b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314550}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "905686ba-b3f6-58e7-998d-63ec7c2c2866" :question/math-academy-id "q-340104" :question/problem "Given the function  $y=4ln⁡x-\\frac{1}{3}\\cdot {2}^{x}+5$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4ln⁡x-\\frac{1}{3}\\cdot {2}^{x}+5) \\\\  & =\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}ln⁡(2).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}ln⁡(2))|}_{x=2} \\\\  & =\\frac{4}{2}-\\frac{1}{3}\\cdot {2}^{2}ln⁡(2) \\\\  & =2-\\frac{4}{3}ln⁡(2)\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0beb1ecb-7649-51d5-8923-8085f1d146bc" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186401629} {:answer/id #uuid "aa5ec049-b8d0-5c17-a28c-05813122674f" :answer/type {:db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186401630} {:answer/id #uuid "c2d87b1b-17a5-523c-a973-f5e0ad287cd3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186401631} {:answer/id #uuid "ea4f4094-0cfd-5ae4-8308-88f0b83b2c27" :answer/type {:db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186401632} {:answer/id #uuid "946c0adc-baba-5359-a975-69b7a89f4838" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186401633}] :answer-field/correct {:answer/id #uuid "aa5ec049-b8d0-5c17-a28c-05813122674f" :answer/type {:db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186401630} :answer-field/id #uuid "5088efea-7f9e-57d5-8f9c-14c688a0e06b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401628}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "104d7814-9b21-55a2-864d-c61ec56f5c8f" :question/math-academy-id "q-17392" :question/problem "Given that $y=2{x}^{e}-ln⁡x$, find the instantaneous rate of change at $x=1.$" :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{e}-ln⁡x) \\\\  & =2e{x}^{e-1}-\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(2e{x}^{e-1}-\\frac{1}{x})|}_{x=1} \\\\  & =2e\\cdot {1}^{e-1}-\\frac{1}{1} \\\\  & =2e-1\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] [{:db/id #edb/ref 17592186096615 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096415 :question/id #uuid "f61ac550-d62c-558f-b6d5-0d4c9aba8089" :question/math-academy-id "e-3629" :question/problem "Given that $y=4\\log_3 x,$ find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "Here, we apply our formula for the derivative when the base of the logarithm is a number other than $e.$ By doing so, we obtain\n\n$$\n\\eqalign{\n\t\t\t\\dfrac{\\textrm{d}y}{\\textrm{d}x}&=\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4\\log_3 x\\right)\\\n\t\t\t\t\t\t\t\t\t &=4\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\log_3 x\\right)\\\n\t\t\t\t\t\t\t\t\t &=4\\cdot\\dfrac{1}{x \\ln 3}\\\n\t\t\t\t\t\t\t\t\t&=\\dfrac{4}{x \\ln 3}.\n\n}\n$$"} :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/questions [{:db/id #edb/ref 17592186097018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fc74cbb-55e3-58fe-93f7-23d2f90e74b3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{x\\ln 5}" :db/id #edb/ref 17592186094082} {:answer/id #uuid "c8eb47da-1745-5e7e-9737-588db0279dc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{x\\ln 5}" :db/id #edb/ref 17592186094083} {:answer/id #uuid "27f824f3-9710-5d1e-89d8-290ab212a196" :answer/type {:db/ident :answer.type/math} :answer/value "x - \\frac{3}{x\\ln 5}" :db/id #edb/ref 17592186094084} {:answer/id #uuid "38a4b8f7-dd90-5e68-8316-42e512e1e894" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\frac{1}{x\\ln 5}" :db/id #edb/ref 17592186094085} {:answer/id #uuid "4599b2f9-9707-597b-9797-37f1b2b1555a" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\frac{3}{x\\ln 5}" :db/id #edb/ref 17592186094086}] :answer-field/id #uuid "5630eeac-2ac2-529f-8c22-77ea989d69be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094081}] :question/id #uuid "f06ecd5e-5944-5764-a8e8-9da3fea992d9" :question/math-academy-id "q-11903" :question/problem "Given that $y = x - 3\\log_{5} x$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186097019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6f74602-324e-53ca-838c-8b274a97bc96" :answer/type {:db/ident :answer.type/math} :answer/value "2x - \\frac{7}{x\\ln 9}" :db/id #edb/ref 17592186094088} {:answer/id #uuid "bb439b88-d8d5-5ce1-97d2-fff353d9a6cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{x\\ln 5}" :db/id #edb/ref 17592186094089} {:answer/id #uuid "e85a174f-b0d2-5831-bff8-3555b6382def" :answer/type {:db/ident :answer.type/math} :answer/value "2x - \\frac{1}{x\\ln 9}" :db/id #edb/ref 17592186094090} {:answer/id #uuid "16661e50-45a6-585e-90ce-2d427494b71b" :answer/type {:db/ident :answer.type/math} :answer/value "x - \\frac{1}{x\\ln 9}" :db/id #edb/ref 17592186094091} {:answer/id #uuid "21e9072b-91cf-598e-9f41-3597bcbc89ca" :answer/type {:db/ident :answer.type/math} :answer/value "x - \\frac{7}{x\\ln 9}" :db/id #edb/ref 17592186094092}] :answer-field/id #uuid "f26be675-4841-5853-9c73-242d275f5343" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094087}] :question/id #uuid "5483eb06-46ab-500c-9fb8-8d630575623c" :question/math-academy-id "q-11907" :question/problem "Given that $y = x^{2} - 7\\log_{9} x$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186233051 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d746064f-9bc3-5f26-9c93-afaf01c3e7e9" :question/math-academy-id "q-101719" :question/problem "Given that $y=7-4{log}_{3}x$, find the instantaneous rate of change at $x=\\frac{1}{\\operatorname{ln}3}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}x)=\\frac{1}{x\\operatorname{ln}a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(7-4{log}_{3}x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-4\\frac{\\text{d}}{\\text{d}x}({log}_{3}x) \\\\  & =0-4\\cdot \\frac{1}{x\\operatorname{ln}3} \\\\  & =-\\frac{4}{x\\operatorname{ln}3}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1/\\operatorname{ln}3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/\\operatorname{ln}3} & ={(-\\frac{4}{x\\operatorname{ln}3})\\,|}_{x=1/\\operatorname{ln}3} \\\\  & =-\\frac{4}{1} \\\\  & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7910af85-fe7d-5c72-bfa8-012147c4fad3" :answer/type {:db/ident :answer.type/math} :answer/value "8-\\frac{6}{\\operatorname{ln}3}" :db/id #edb/ref 17592186232810}] :answer-field/correct {:answer/id #uuid "7910af85-fe7d-5c72-bfa8-012147c4fad3" :answer/type {:db/ident :answer.type/math} :answer/value "8-\\frac{6}{\\operatorname{ln}3}" :db/id #edb/ref 17592186232810} :answer-field/id #uuid "3a0533ea-5c3b-54d0-8191-c267a1815911" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232809}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c2dd8674-7fa4-5d68-955d-c19f5b7e1758" :question/math-academy-id "q-339989" :question/problem "Given the function $y=4{x}^{2}-6{log}_{3}x,$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}x)=\\frac{1}{x\\operatorname{ln}a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}-6{log}_{3}x) \\\\  & =4\\cdot 2x-6\\cdot \\frac{1}{x\\operatorname{ln}3} \\\\  & =8x-\\frac{6}{x\\operatorname{ln}3}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(8x-\\frac{6}{x\\operatorname{ln}3})|}_{x=1} \\\\  & =8(1)-\\frac{6}{1\\cdot \\operatorname{ln}3} \\\\  & =8-\\frac{6}{\\operatorname{ln}3}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dcaf086-29eb-58e3-9792-842c7a25fb05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}(7)}-\\frac{3}{x}" :db/id #edb/ref 17592186232812}] :answer-field/correct {:answer/id #uuid "4dcaf086-29eb-58e3-9792-842c7a25fb05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x\\operatorname{ln}(7)}-\\frac{3}{x}" :db/id #edb/ref 17592186232812} :answer-field/id #uuid "b4aa8b73-2643-5d54-9ecf-8c68f6f1aaca" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232811}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c0ddc214-9263-5104-9473-b379b6f7ec26" :question/math-academy-id "q-339997" :question/problem "Given that $f(x)={log}_{7}x-3\\operatorname{ln}x$, find ${f}^{'}(x).$\n\n${f}^{'}(x)=$\n{{field-1}}" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}x)=\\frac{1}{x\\operatorname{ln}a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}({log}_{7}x-3\\operatorname{ln}x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({log}_{7}x)-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}x) \\\\  & =\\frac{1}{x\\operatorname{ln}(7)}-3(\\frac{1}{x}) \\\\  & =\\frac{1}{x\\operatorname{ln}(7)}-\\frac{3}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0442097d-1b68-55b7-9cb8-c462931d1330" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238117} {:answer/id #uuid "0e522cac-c75a-5c1f-9bac-01ed6857debd" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{ln⁡5}" :db/id #edb/ref 17592186238178} {:answer/id #uuid "44b6755c-aead-5542-8a1b-64818f1fbff2" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{x}+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238650} {:answer/id #uuid "461da220-919b-5435-93cc-a2ea3dad39d0" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{x}ln⁡7+\\frac{1}{x}" :db/id #edb/ref 17592186238664} {:answer/id #uuid "ffca6930-a453-5efc-ba11-64e5e1be934c" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186240327}] :answer-field/correct {:answer/id #uuid "0442097d-1b68-55b7-9cb8-c462931d1330" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238117} :answer-field/id #uuid "7bea711e-203a-5f4c-8d6c-0248b489ff5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240554}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a3193e7-39e5-59fc-a3d8-c6e491fa4479" :question/math-academy-id "q-105256" :question/problem "Find ${f}^{′}(x)$ for $f(x)={7}^{x}+{log}_{5}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}+{log}_{5}⁡x) \\\\  & ={7}^{x}\\cdot ln⁡7+\\frac{1}{xln⁡5} \\\\  & ={7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010fae26-d218-5d85-80be-b5da7fa03138" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{xln⁡4}" :db/id #edb/ref 17592186250562} {:answer/id #uuid "1d7274d3-9d6c-566f-8ab0-5d6dadc206db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4x}" :db/id #edb/ref 17592186250801} {:answer/id #uuid "3fea77d7-dd38-54a3-ab38-de4a5e6af670" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡5}" :db/id #edb/ref 17592186251082} {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788} {:answer/id #uuid "e56177c0-fb1c-54a8-8c75-934ef63a1c08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186252561}] :answer-field/correct {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788} :answer-field/id #uuid "35ef16c9-7f8c-57e6-86fd-b4dbee5a6bfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252894}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b9de855f-8e10-5bff-89a6-c3649ce380b6" :question/math-academy-id "q-11900" :question/problem "Given that $y=5{log}_{4}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{4}⁡x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x) \\\\  & =5\\cdot \\frac{1}{xln⁡4} \\\\  & =\\frac{5}{xln⁡4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d6c7d7-cbc8-50f3-a344-45446b405f44" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186284858} {:answer/id #uuid "2557b0d8-9f3c-5e2b-a795-8eef0be2c846" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186285117} {:answer/id #uuid "265b440a-0541-5605-93d6-05c026a9c562" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186285122} {:answer/id #uuid "7663eb58-65d7-5b9c-a07b-0641ecb1169d" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x}" :db/id #edb/ref 17592186285889} {:answer/id #uuid "eb874120-2ccd-5cec-a284-10e8ad025134" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186286946}] :answer-field/correct {:answer/id #uuid "08d6c7d7-cbc8-50f3-a344-45446b405f44" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}" :db/id #edb/ref 17592186284858} :answer-field/id #uuid "2efe99a9-b212-56ab-a943-1bebc7a16391" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287245}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "884748ff-1cf0-5818-a246-3daa4fae09f6" :question/math-academy-id "q-1921" :question/problem "Find ${f}^{′}(x)$ for $f(x)={2}^{x}+\\operatorname{log}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({2}^{x}+\\operatorname{log}⁡x) \\\\  & ={2}^{x}\\cdot \\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10} \\\\  & ={2}^{x}\\text{ }\\operatorname{ln}⁡2+\\frac{1}{x\\operatorname{ln}⁡10}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a21d7c1-657b-5c7c-bc8d-a5a78f0a5e39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}3}-4+5e" :db/id #edb/ref 17592186295600}] :answer-field/correct {:answer/id #uuid "3a21d7c1-657b-5c7c-bc8d-a5a78f0a5e39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}3}-4+5e" :db/id #edb/ref 17592186295600} :answer-field/id #uuid "24fc67ac-4879-57d5-8bd2-d439a30262bd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296699}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8688ee43-a87d-5757-aeae-1697946d83af" :question/math-academy-id "q-308866" :question/problem "Given the function  $y=2{log}_{3}⁡x-4\\operatorname{ln}⁡x+5{e}^{x},$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{x\\operatorname{ln}⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{log}_{3}⁡x-4\\operatorname{ln}⁡x+5{e}^{x}) \\\\  & =\\frac{2}{x\\operatorname{ln}⁡3}-\\frac{4}{x}+5{e}^{x}.\\end{aligned}\n$$\n\nHence, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x\\operatorname{ln}⁡3}-\\frac{4}{x}+5{e}^{x})\\,|}_{x=1} \\\\  & =\\frac{2}{1\\cdot \\operatorname{ln}⁡3}-\\frac{4}{1}+5{e}^{1} \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}-4+5e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277904a9-9e9e-53f0-a87c-616303962482" :answer/type {:db/ident :answer.type/math} :answer/value "55-\\frac{1}{\\operatorname{ln}6}" :db/id #edb/ref 17592186312275}] :answer-field/correct {:answer/id #uuid "277904a9-9e9e-53f0-a87c-616303962482" :answer/type {:db/ident :answer.type/math} :answer/value "55-\\frac{1}{\\operatorname{ln}6}" :db/id #edb/ref 17592186312275} :answer-field/id #uuid "0bb11537-ff22-5776-85db-c4e4d92da407" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314045}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b9fb0b98-97be-5fa4-a0a8-73b036fd9d03" :question/math-academy-id "q-339994" :question/problem "Given the function $y=2{x}^{3}+x-3{log}_{6}⁡x,$ find the instantaneous rate of change at $x=3.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=3$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}+x-3{log}_{6}⁡x) \\\\  & =2\\cdot 3{x}^{2}+1-3\\cdot \\frac{1}{xln⁡6} \\\\  & =6{x}^{2}+1-\\frac{3}{xln⁡6}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(6{x}^{2}+1-\\frac{3}{xln⁡6})|}_{x=3} \\\\  & =6(3)^{2}+1-\\frac{3}{3\\cdot ln⁡6} \\\\  & =55-\\frac{1}{ln⁡6}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a1b399-700a-5dd2-967b-49969d3534b8" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3)+\\frac{1}{x\\operatorname{ln}(10)}" :db/id #edb/ref 17592186312291}] :answer-field/correct {:answer/id #uuid "29a1b399-700a-5dd2-967b-49969d3534b8" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3)+\\frac{1}{x\\operatorname{ln}(10)}" :db/id #edb/ref 17592186312291} :answer-field/id #uuid "38b53a32-4b9b-556b-afd9-471f5f44697e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314162}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6065f3ff-ff9c-5643-832d-8d1ba7e4dfa6" :question/math-academy-id "q-340105" :question/problem "Given that $f(x)={3}^{x}+log⁡x$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+log⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}}{\\text{d}x}(log⁡x) \\\\  & ={3}^{x}ln⁡(3)+\\frac{1}{xln⁡(10)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cea7a0d-5e57-5d82-b9dc-783b5889bf1e" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}+\\frac{3}{x\\operatorname{ln}(5)}" :db/id #edb/ref 17592186312833}] :answer-field/correct {:answer/id #uuid "6cea7a0d-5e57-5d82-b9dc-783b5889bf1e" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}+\\frac{3}{x\\operatorname{ln}(5)}" :db/id #edb/ref 17592186312833} :answer-field/id #uuid "8b6adce3-ac95-53df-964b-74afaf250503" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314381}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "05a9cae0-c21b-5778-9f36-154aaf19469f" :question/math-academy-id "q-340106" :question/problem "Given that $y=-{e}^{x}+3{log}_{5}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-{e}^{x}+3{log}_{5}⁡x) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({e}^{x})+3\\frac{\\text{d}}{\\text{d}x}({log}_{5}⁡x) \\\\  & =-{e}^{x}+3\\cdot \\frac{1}{xln⁡(5)} \\\\  & =-{e}^{x}+\\frac{3}{xln⁡(5)}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] [{:db/id #edb/ref 17592186096616 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096416 :question/id #uuid "5eaa00f8-0fd0-5de6-a7c0-965db6de3a5c" :question/math-academy-id "e-3630" :question/problem "Given that $y= \\log_4 x + \\ln x$,  find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\dfrac {\\textrm{d}y} {\\textrm{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\eqalign{\n\\dfrac{\\textrm{d}y}{\\textrm{d}x}\n\t\t&= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( \\log_4 x + \\ln x \\right)\\\n\t\t&= \\dfrac{\\textrm{d}}{\\textrm{d}x}(\\log_4 x) + \\dfrac{\\textrm{d}}{\\textrm{d}x}(\\ln x )\\\n\t\t&= \\dfrac{1}{x\\ln 4} + \\dfrac{1}{x}.\n}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{1}{xln⁡4}+\\frac{1}{x})|}_{x=1} \\\\  & =\\frac{1}{ln⁡4}+1.\\end{aligned}\n$$"} :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/questions [{:db/id #edb/ref 17592186097136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9a1ef8d-83de-5766-9657-a3bfe0bb38dd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186094790} {:answer/id #uuid "0252fcd7-aeab-5761-8acd-d83247a91140" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186094791} {:answer/id #uuid "0ec8a347-f04f-5b31-b96a-f6161c05a063" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186094792} {:answer/id #uuid "3d77c43e-3716-58ad-bfa3-1b5969543ef2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186094793} {:answer/id #uuid "6a1e92d9-bcf0-58ec-9823-44766ae56d64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186094794}] :answer-field/id #uuid "7f1d45b3-2a55-54df-9843-cd54e2302ddb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094789}] :question/id #uuid "0259cf05-81de-512b-a7bb-bd7b4b70d4e7" :question/math-academy-id "q-17373" :question/problem "Given that $y =-\\frac{3}{5}\\ln x$, find the slope of the tangent at $x = 1$."} {:db/id #edb/ref 17592186097137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9535bbe-8473-5599-9eae-86f82aec85f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\ln 3}" :db/id #edb/ref 17592186094796} {:answer/id #uuid "f914470b-dc52-52fd-977b-65814c410cbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3 + 5" :db/id #edb/ref 17592186094797} {:answer/id #uuid "3208ddc6-452f-5f4f-bfef-252a124463b6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186094798} {:answer/id #uuid "45323c64-e7df-59cc-84f6-49f89ffab9e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\ln 3}" :db/id #edb/ref 17592186094799} {:answer/id #uuid "70fe78d5-79ed-559e-ab74-f865abba7a8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\ln 3} + 5" :db/id #edb/ref 17592186094800}] :answer-field/id #uuid "6bb3288b-51b9-54b1-8b95-4333cd4a102b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094795}] :question/id #uuid "55e0676e-8226-56ea-844c-41bb8f4c2189" :question/math-academy-id "q-17395" :question/problem "Given that $y = \\log_{3} x + 5\\ln x$, find the slope of the tangent at $x = 1$."} {:db/id #edb/ref 17592186233052 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2ae057d0-d78b-5718-aa6f-daab4feb4650" :question/math-academy-id "q-101723" :question/problem "Given that $y=4{e}^{x}-3{log}_{7}x$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4{e}^{x}-\\frac{3}{x\\operatorname{ln}7}\\,.\n$$\n\nTherefore, the slope  of the tangent at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(4{e}^{x}-\\frac{3}{x\\operatorname{ln}7})|}_{x=3} \\\\  & =4{e}^{3}-\\frac{3}{3\\operatorname{ln}7} \\\\  & =4{e}^{3}-\\frac{1}{\\operatorname{ln}7}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c8b4247-2f6e-5c89-84d3-05e82fd928d0" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186232814}] :answer-field/correct {:answer/id #uuid "8c8b4247-2f6e-5c89-84d3-05e82fd928d0" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186232814} :answer-field/id #uuid "b23a283b-6469-55b9-90b7-faa54b42b98a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232813}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "203042d7-3a90-5b98-a3a8-41d259d10f67" :question/math-academy-id "q-340014" :question/problem "Given the function $y=5{x}^{2}+6\\operatorname{ln}x,$ the slope of the tangent line at $x=3$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}+6\\operatorname{ln}x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}x) \\\\  & =5\\cdot 2x+6\\cdot \\frac{1}{x} \\\\  & =10x+\\frac{6}{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(10x+\\frac{6}{x})|}_{x=3} \\\\  & =10\\cdot 3+\\frac{6}{3} \\\\  & =32\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe3da45a-b176-52b2-a1fc-b27d861de6a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}-18\\operatorname{ln}3" :db/id #edb/ref 17592186232816}] :answer-field/correct {:answer/id #uuid "fe3da45a-b176-52b2-a1fc-b27d861de6a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}-18\\operatorname{ln}3" :db/id #edb/ref 17592186232816} :answer-field/id #uuid "263e1f60-7948-5f00-a01d-0963d8a18442" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232815}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7cc61275-8b03-5f03-bb68-53ecece9ebf0" :question/math-academy-id "q-340022" :question/problem "Given the function $y=5\\operatorname{ln}x-2\\cdot {3}^{x},$ the slope of the tangent line at $x=2$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}x-2\\cdot {3}^{x}) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}x)-2\\frac{\\text{d}}{\\text{d}x}({3}^{x}) \\\\  & =5\\cdot \\frac{1}{x}-2\\cdot {3}^{x}\\operatorname{ln}3 \\\\  & =\\frac{5}{x}-2\\operatorname{ln}3\\cdot {3}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{5}{x}-2\\operatorname{ln}3\\cdot {3}^{x})|}_{x=2} \\\\  & =\\frac{5}{2}-2\\operatorname{ln}3\\cdot {3}^{2} \\\\  & =\\frac{5}{2}-18\\operatorname{ln}3\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a68429f7-6205-5d83-9b54-817cfb429a93" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{2}+\\frac{1}{\\operatorname{ln}4}" :db/id #edb/ref 17592186232820} {:answer/id #uuid "6c1498cc-e778-47a5-bb1a-c239ac9e2a39" :answer/type {:db/ident :answer.type/math} :answer/value "-3e^2+\\frac{1}{\\ln4}" :db/id #edb/ref 17592186409341}] :answer-field/correct {:answer/id #uuid "a68429f7-6205-5d83-9b54-817cfb429a93" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{2}+\\frac{1}{\\operatorname{ln}4}" :db/id #edb/ref 17592186232820} :answer-field/id #uuid "eb82ad2c-5850-514d-a61d-c6dc21f1e26a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232819}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "25397da2-818c-507a-82b9-e23dda017608" :question/math-academy-id "q-340109" :question/problem "Given the function $y=-3{e}^{x}+2{log}_{4}x,$ the slope of the tangent line at $x=2$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3{e}^{x}+2{log}_{4}x) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}({e}^{x})+2\\frac{\\text{d}}{\\text{d}x}({log}_{4}x) \\\\  & =-3{e}^{x}+2\\cdot \\frac{1}{x\\operatorname{ln}4} \\\\  & =-3{e}^{x}+\\frac{2}{x\\operatorname{ln}4}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(-3{e}^{x}+\\frac{2}{x\\operatorname{ln}4})|}_{x=2} \\\\  & =-3{e}^{2}+\\frac{2}{2\\cdot \\operatorname{ln}4} \\\\  & =-3{e}^{2}+\\frac{1}{\\operatorname{ln}4}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234289 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e390b863-0cc7-5db5-bfcb-f1828e76e02e" :question/math-academy-id "q-70897" :question/problem "Given that $y=2{log}_{2}x+{2}^{x}$, find the slope of the tangent at $x=2.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}2}+{2}^{x}\\operatorname{ln}2\\,.\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{2}{x\\operatorname{ln}2}+{2}^{x}\\operatorname{ln}2)|}_{x=2} \\\\  & =\\frac{2}{2\\cdot \\operatorname{ln}2}+{2}^{2}\\operatorname{ln}2 \\\\  & =\\frac{1}{\\operatorname{ln}2}+4\\operatorname{ln}2\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "472e11dd-8537-5b30-ad11-59c4c14c5212" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186236273} {:answer/id #uuid "6d4f0ac8-1dab-5270-b011-493f700ff938" :answer/type {:db/ident :answer.type/math} :answer/value "3+8ln⁡2" :db/id #edb/ref 17592186236509} {:answer/id #uuid "78e82567-e2b5-51dd-885b-f1af7319339c" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186236577} {:answer/id #uuid "90cac687-dd21-570e-a62a-f9e1d628421a" :answer/type {:db/ident :answer.type/math} :answer/value "8ln⁡2-2" :db/id #edb/ref 17592186236739} {:answer/id #uuid "97421f7d-e972-5d83-b422-5d436b8e6feb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186236777}] :answer-field/correct {:answer/id #uuid "78e82567-e2b5-51dd-885b-f1af7319339c" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186236577} :answer-field/id #uuid "3e2000d3-5ddf-572d-be68-d0feed75463e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237519}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "09ca9b0e-b19f-5aca-b14f-466e3c4366f1" :question/math-academy-id "q-101726" :question/problem "Given that $y=3x-5+8{log}_{2}⁡x$, find the slope of the tangent at $x=\\frac{1}{ln⁡2}.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x-5+8{log}_{2}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3x)+\\frac{\\text{d}}{\\text{d}x}(-5)+\\frac{\\text{d}}{\\text{d}x}(8{log}_{2}⁡x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(5)+8\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x) \\\\  & =3-0+8\\cdot \\frac{1}{xln⁡2} \\\\  & =3+\\frac{8}{xln⁡2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=\\frac{1}{ln⁡2}$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/ln⁡2} & ={(3+\\frac{8}{xln⁡2})|}_{x=1/ln⁡2} \\\\  & =3+\\frac{8}{(\\frac{1}{ln⁡2}\\cdot ln⁡2)} \\\\  & =3+8 \\\\  & =11\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284696 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea60620-2ab9-5040-8270-703c9a1d6b7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281818} {:answer/id #uuid "7936ae4e-f008-5af5-820c-1674250b0ac2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186282726} {:answer/id #uuid "7c387048-20f2-5147-a642-ff8e502ef022" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186282760} {:answer/id #uuid "90f5b318-f4a9-5268-90ba-ba237d66d663" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186282944} {:answer/id #uuid "9a3d6901-3436-54f0-a0b1-ce4e806a253f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283033}] :answer-field/correct {:answer/id #uuid "0ea60620-2ab9-5040-8270-703c9a1d6b7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186281818} :answer-field/id #uuid "ec15cdba-b1f7-5ecd-9880-c9e9cda591f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284349}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9bd05e5a-ceb5-5b6d-a1ee-24c21df80b24" :question/math-academy-id "q-17371" :question/problem "Given that $y=3ln⁡x+2{x}^{2}-5x$, find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3ln⁡x+2{x}^{2}-5x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3ln⁡x)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(5x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(ln⁡x)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(5x) \\\\  & =3\\cdot \\frac{1}{x}+4x-5 \\\\  & =\\frac{3}{x}+4x-5\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x}+4x-5)|}_{x=1} \\\\  & =\\frac{3}{1}+4\\cdot 1-5 \\\\  & =3+4-5 \\\\  & =2\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c897e4-b652-55dd-8d72-bc5035453929" :answer/type {:db/ident :answer.type/math} :answer/value "24-\\frac{5}{2\\operatorname{ln}3}" :db/id #edb/ref 17592186312506}] :answer-field/correct {:answer/id #uuid "42c897e4-b652-55dd-8d72-bc5035453929" :answer/type {:db/ident :answer.type/math} :answer/value "24-\\frac{5}{2\\operatorname{ln}3}" :db/id #edb/ref 17592186312506} :answer-field/id #uuid "32f3d565-6897-5bcf-9632-a037dba3624d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314146}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1eb887e7-89db-539c-9d35-d652e9bb15c3" :question/math-academy-id "q-340024" :question/problem "Given the function $y=2{x}^{3}-5{log}_{3}⁡x,$ the slope of the tangent line at $x=2$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-5{log}_{3}⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({x}^{3})-5\\frac{\\text{d}}{\\text{d}x}({log}_{3}⁡x) \\\\  & =2\\cdot 3{x}^{2}-5\\cdot \\frac{1}{xln⁡3} \\\\  & =6{x}^{2}-\\frac{5}{xln⁡3}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(6{x}^{2}-\\frac{5}{xln⁡3})|}_{x=2} \\\\  & =6(2)^{2}-\\frac{5}{2ln⁡3} \\\\  & =24-\\frac{5}{2ln⁡3}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "101f0087-1aec-50e5-a9b7-d806a0ea860a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}2}+5" :db/id #edb/ref 17592186312090}] :answer-field/correct {:answer/id #uuid "101f0087-1aec-50e5-a9b7-d806a0ea860a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}2}+5" :db/id #edb/ref 17592186312090} :answer-field/id #uuid "9a7fc2dd-1d62-5a23-a97f-19baf25d47a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314431}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1b69d4c2-7ebc-59ed-aa14-566d23bb3592" :question/math-academy-id "q-340026" :question/problem "Given the function $y=6{log}_{2}⁡x+4{x}^{2}-3x,$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6{log}_{2}⁡x+4{x}^{2}-3x) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})-3\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =6\\cdot \\frac{1}{xln⁡2}+4\\cdot 2x-3 \\\\  & =\\frac{6}{xln⁡2}+8x-3\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{6}{xln⁡2}+8x-3)|}_{x=1} \\\\  & =\\frac{6}{1\\cdot ln⁡2}+8(1)-3 \\\\  & =\\frac{6}{ln⁡2}+5\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314915 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60475637-df2c-5099-a5a7-9cd23687c0fd" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{3}-\\frac{1}{\\operatorname{ln}2}" :db/id #edb/ref 17592186312747}] :answer-field/correct {:answer/id #uuid "60475637-df2c-5099-a5a7-9cd23687c0fd" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{3}-\\frac{1}{\\operatorname{ln}2}" :db/id #edb/ref 17592186312747} :answer-field/id #uuid "6bd5a890-600f-5ed0-9892-4e5fc04515a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314310}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5c352abb-1992-52cb-94e7-b48e48f5bbc8" :question/math-academy-id "q-340110" :question/problem "Given the function $y=4{e}^{x}-3{log}_{2}⁡x+7,$ the slope of the tangent line at $x=3$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-3{log}_{2}⁡x+7) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-3\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+\\frac{\\text{d}}{\\text{d}x}(7) \\\\  & =4{e}^{x}-3\\cdot \\frac{1}{xln⁡2}+0 \\\\  & =4{e}^{x}-\\frac{3}{xln⁡2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(4{e}^{x}-\\frac{3}{xln⁡2})|}_{x=3} \\\\  & =4{e}^{3}-\\frac{3}{3\\cdot ln⁡2} \\\\  & =4{e}^{3}-\\frac{1}{ln⁡2}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186403412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c631962-dd2a-53db-b827-84d94e8f7e53" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{\\operatorname{ln}⁡10}-3" :db/id #edb/ref 17592186403414} {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} {:answer/id #uuid "33140677-5da7-59ef-8215-135fba67dffb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡10}+3" :db/id #edb/ref 17592186403416} {:answer/id #uuid "7fefc24f-ce9e-58b5-aba2-9f2cb372222e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}-9" :db/id #edb/ref 17592186403417} {:answer/id #uuid "cc3a5a72-8cb5-5f5c-812b-2114a27a36be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡10}+9" :db/id #edb/ref 17592186403418}] :answer-field/correct {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} :answer-field/id #uuid "1fcab4c2-5aab-5cee-8699-609d2431de61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403413}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ddfac57c-89c4-597b-b080-b0ac4a48d4c1" :question/math-academy-id "q-70903" :question/problem "Given that $y=3\\operatorname{log}⁡x+{x}^{3}-4$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2}\\,.\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2})|}_{x=3} \\\\  & =\\frac{3}{3\\cdot \\operatorname{ln}⁡10}+3\\cdot {3}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}+27\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}]}
