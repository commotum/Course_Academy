 :db/id #edb/ref 17592186330973} {:answer/id #uuid "7a615d72-2639-5796-9876-984ecf702dec" :answer/type {:db/ident :answer.type/image} :answer/value "images/56/566935c224696f817a798a9e0f608ba384b5da6af1f0bfec6ad769e910f1230c.png" :db/id #edb/ref 17592186331033} {:answer/id #uuid "8feb98b8-4798-558b-9d2a-1181de6e3f6e" :answer/type {:db/ident :answer.type/image} :answer/value "images/4b/4bcb4f24caba3010cb8bfffecacbd392ad5951d4e42873d467c9007ad2b7ea46.png" :db/id #edb/ref 17592186331227} {:answer/id #uuid "a9f5ab31-edff-5dee-88f0-7ee4a29422a7" :answer/type {:db/ident :answer.type/image} :answer/value "images/1f/1fd9c2f2358171f102969930fde05347f50bd497f725fdc4c24fec97490f15ad.png" :db/id #edb/ref 17592186331457}] :answer-field/correct {:answer/id #uuid "4b595fdc-ac24-53b1-b485-072a76711f6f" :answer/type {:db/ident :answer.type/image} :answer/value "images/83/83c166a9882661ec123b3f14bf76c9c7585052d0e85e24c4e41b7bbde4de9326.png" :db/id #edb/ref 17592186330631} :answer-field/id #uuid "f42fe6aa-d5ce-5802-8ca2-328c4a548b5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332630}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "27b042e7-c453-5f49-bac9-de5985bbacde" :question/math-academy-id "q-50196" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-3(x+1)^{2}.$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =-3\\int (x+1)^{2}\\,\\text{d}x \\\\ y & =-3\\int (x+1)^{2}\\,\\text{d}x \\\\  & =-(x+1)^{3}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1.$\n\n![](images/03/03a5bf5134dc7d551b2602145c4c25081a2ad274f02c95845e5789b288e618a1.png)"} {:db/id #edb/ref 17592186253548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad94dc2-96d1-5f82-a763-87dd2729f0de" :answer/type {:db/ident :answer.type/image} :answer/value "images/78/7832a2110292cb364cf06c24eb51e9bb1ee42fe430ac8fcc381af047a09125e4.png" :db/id #edb/ref 17592186250651} {:answer/id #uuid "104071b2-3939-5957-8b0b-115c9954484c" :answer/type {:db/ident :answer.type/image} :answer/value "images/ce/cece096a5b267821994e9b6d8142f0d7ea684bbe8e28da7cdb01b87a73f1db4c.png" :db/id #edb/ref 17592186250695} {:answer/id #uuid "37599f90-3244-5785-b02a-3b8c6636ce9b" :answer/type {:db/ident :answer.type/image} :answer/value "images/96/96359fe35288b866cbf9fd929e2515af04a4ec0dc565a4cd4af9d3a8fcd20f94.png" :db/id #edb/ref 17592186251006} {:answer/id #uuid "56cfa623-a5a2-5b84-a1b7-c443f45bdc6e" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186251263} {:answer/id #uuid "a29f2347-9127-52fe-8d0d-29d70ef13664" :answer/type {:db/ident :answer.type/image} :answer/value "images/8e/8ede6d26a62570f4037ecc58c377e95389ab00dbee36b60c46e6fb2021e01cea.png" :db/id #edb/ref 17592186251955}] :answer-field/correct {:answer/id #uuid "56cfa623-a5a2-5b84-a1b7-c443f45bdc6e" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7ecaa30c600519d6bfcc7a43a4275a55d6f6cc1b52b48c8e7b117e7a772343e.png" :db/id #edb/ref 17592186251263} :answer-field/id #uuid "56370ecd-d3f8-58ef-b871-fb4e753f3b83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252955}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0b17887e-edc7-5942-b62d-5bad58805bd8" :question/math-academy-id "q-119132" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{e}^{-x/4}}{2}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{{e}^{-x/4}}{2}\\,\\text{d}x \\\\ y & =\\frac{1}{2}\\int {e}^{-x/4}\\,\\text{d}x \\\\  & =\\frac{1}{2}(-4{e}^{-x/4}) \\\\  & =-2{e}^{-x/4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=0,3,6.$\n\n![](images/a4/a4b534bd33daabc94aa3c86935b1fd4c0be723fafbc418ed382716541a864293.png)"} {:db/id #edb/ref 17592186332790 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097973d9-9ded-556a-9845-2e01f4285582" :answer/type {:db/ident :answer.type/image} :answer/value "images/5c/5c933988eb335b7310387cfc532a6e144de3e43bfebde4c29d1e5fe76fa35027.png" :db/id #edb/ref 17592186330031} {:answer/id #uuid "7df61f71-c57b-5b3a-bb1e-71c5faddfe2f" :answer/type {:db/ident :answer.type/image} :answer/value "images/4a/4a2aefaff6332175608a37f6532bafd5be4ccb60a2aad8e4400a0f5767c4588a.png" :db/id #edb/ref 17592186331057} {:answer/id #uuid "ae78f203-25a9-5c21-a930-c1db83c7064a" :answer/type {:db/ident :answer.type/image} :answer/value "images/aa/aae99f368b61351b9163646b70ea0b085019d6935334422ccb398958a81d1e47.png" :db/id #edb/ref 17592186331492} {:answer/id #uuid "d249f656-2f38-5318-b289-f42310bd1132" :answer/type {:db/ident :answer.type/image} :answer/value "images/76/763db9d469cdd9047ec823966fc922726c97cb22e6cd848a432f26bc5e6529d6.png" :db/id #edb/ref 17592186331816} {:answer/id #uuid "f90cf1a3-9d3e-5917-a76d-9ba382f31925" :answer/type {:db/ident :answer.type/image} :answer/value "images/89/8910d0342d03d546117091ccd19378905b8cfc3644997cfe3ca7d95a3b4e7a6f.png" :db/id #edb/ref 17592186332139}] :answer-field/correct {:answer/id #uuid "097973d9-9ded-556a-9845-2e01f4285582" :answer/type {:db/ident :answer.type/image} :answer/value "images/5c/5c933988eb335b7310387cfc532a6e144de3e43bfebde4c29d1e5fe76fa35027.png" :db/id #edb/ref 17592186330031} :answer-field/id #uuid "b60cced6-9db4-5c73-bcb1-9ed58f36cdd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332517}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "70caacc2-c352-5e5b-80a4-9b13475ccda0" :question/math-academy-id "q-49947" :question/problem "Which of the following shows some of the solution curves of the differential equation $x\\cdot \\frac{\\text{d}y}{\\text{d}x}=1$ for $x>0?$" :question/worked-solution "Rearranging and Integrating the equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{x} \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ y & =\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x|+C \\\\  & =\\operatorname{ln}⁡x+C,\\,x>0.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,2.$\n\n![](images/8e/8e047c3c27a000af943f50499f8c7559acceeb78cc006e796c7d353729991517.png)"} {:db/id #edb/ref 17592186332808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a36ddfca-2b14-509d-b5d4-e1b9e7e3d77a" :answer/type {:db/ident :answer.type/image} :answer/value "images/36/3670e1b40ce25af5974059a86c502cfb68f80e81746cbb162805ab7ae4a6bce2.png" :db/id #edb/ref 17592186331414} {:answer/id #uuid "cb41bf96-b7f8-5841-b2a3-e61783f9e2c2" :answer/type {:db/ident :answer.type/image} :answer/value "images/1c/1cf05351f0353e95dbdff8f620f6e920650d505be88edb3e61486676cb59357c.png" :db/id #edb/ref 17592186331752} {:answer/id #uuid "d493a642-0802-5e9f-bbcf-6f942159881d" :answer/type {:db/ident :answer.type/image} :answer/value "images/7d/7d23f940448475b1da1008ab1d3270236abec662208e81bd0de9355e85103a38.png" :db/id #edb/ref 17592186331835} {:answer/id #uuid "df729bef-a2ff-5cbe-8c4a-710c0ea5cca6" :answer/type {:db/ident :answer.type/image} :answer/value "images/90/90beec07c4d15fa823aee98c8a1a1e6c58846bb9b713b84848e010cc98cb3ca3.png" :db/id #edb/ref 17592186331922} {:answer/id #uuid "e1f097f0-5895-56e1-86a8-3d39d336d5d8" :answer/type {:db/ident :answer.type/image} :answer/value "images/18/18a0a935932bbe409ceb7e36459a2091ee46b74829c873bfc048a71f543d8eff.png" :db/id #edb/ref 17592186331948}] :answer-field/correct {:answer/id #uuid "df729bef-a2ff-5cbe-8c4a-710c0ea5cca6" :answer/type {:db/ident :answer.type/image} :answer/value "images/90/90beec07c4d15fa823aee98c8a1a1e6c58846bb9b713b84848e010cc98cb3ca3.png" :db/id #edb/ref 17592186331922} :answer-field/id #uuid "f9ca8b77-7e7d-5a41-bcb5-89f345e28085" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332640}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "33315476-f420-5411-98c9-f5414bf3df7e" :question/math-academy-id "q-50197" :question/problem "Which of the following shows some of the solution curves of the differential equation ${x}^{2}\\cdot \\frac{\\text{d}y}{\\text{d}x}+1=0$ for $x>0?$" :question/worked-solution "Rearranging and Integrating the equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{{x}^{2}} \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =-\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\ y & =-\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{x}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1$ for $x>0.$\n\n![](images/c8/c837c3b617fa49f3d081d961196a954fada99b8d7cd12b7d7f729232e16be066.png)"} {:db/id #edb/ref 17592186332809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045fe77f-3730-5d18-925c-cda953523ffe" :answer/type {:db/ident :answer.type/image} :answer/value "images/d2/d29058f4c71941f04dd2d934f1896972f0eb41a179984ec5d3675265ee9da56c.png" :db/id #edb/ref 17592186329995} {:answer/id #uuid "105c00ce-00da-5bc3-8cf5-f61420a4738b" :answer/type {:db/ident :answer.type/image} :answer/value "images/25/25e8c2c60a94