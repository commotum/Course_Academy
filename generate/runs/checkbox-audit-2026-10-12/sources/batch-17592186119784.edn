ld/choices [{:answer/id #uuid "ae85fb59-c193-58ba-bf01-9ed467aac023" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234813}] :answer-field/correct {:answer/id #uuid "ae85fb59-c193-58ba-bf01-9ed467aac023" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234813} :answer-field/id #uuid "a7ef65a3-d4ef-527d-bea7-f7bcb05085c1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235180}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8690a396-1b0d-570c-a12c-64188b2e8728" :question/math-academy-id "q-168115" :question/problem "Find the direction of the greatest rate of expansion of the fluid at the point $(1,1).$ Do not normalize the answer.\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        The required direction is $∇(\\text{div}\\,V)\\,{|}_{(1,\\,1)}=⟨$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$⟩.$" :question/worked-solution "In part 2, we found that\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(\\text{div}\\,V)\\,{|}_{(1,\\,1)} & =4 \\\\ \\frac{∂}{∂y}(\\text{div}\\,V)\\,{|}_{(1,\\,1)} & =2\\end{aligned}\n$$\n\nTherefore, the gradient at $(1,1)$ is the following:\n\n$$\n\\begin{aligned}∇(\\text{div}\\,V)\\,{|}_{(1,\\,1)} & =\\frac{∂}{∂x}(\\text{div}\\,V)\\,{|}_{(1,\\,1)}\\,i+\\frac{∂}{∂y}(\\text{div}\\,V)\\,{|}_{(1,\\,1)}\\,j \\\\  & =4\\,i+2\\,j \\\\  & =⟨4,\\,2⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3571c649-0531-50fb-81be-aa0dc6824b5c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\pi ,\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186321556} {:answer/id #uuid "4ff57b68-3c51-53bb-b23d-d256805ec32e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,1⟩" :db/id #edb/ref 17592186321773} {:answer/id #uuid "a280209e-a266-5259-8e3c-561a3617e91a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\pi ,\\,0⟩" :db/id #edb/ref 17592186322429} {:answer/id #uuid "dec9e1b5-c792-5421-b9a9-29ad4b32bf0a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\pi ,\\,2⟩" :db/id #edb/ref 17592186322888} {:answer/id #uuid "f61c2261-0bcc-57ad-8951-891f80c64105" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{\\pi }{4},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186323075}] :answer-field/correct {:answer/id #uuid "dec9e1b5-c792-5421-b9a9-29ad4b32bf0a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\pi ,\\,2⟩" :db/id #edb/ref 17592186322888} :answer-field/id #uuid "81886d51-1e5e-5e76-8e7d-103ef37f4bdb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1ae928cb-8fc1-5d80-9fc4-2442ff5c0221" :question/math-academy-id "q-36005" :question/problem "Evaluate $∇h(x,y)$ at $(1,1)$ if $h(x,y)=4x\\operatorname{arctan}⁡y.$" :question/worked-solution "First, we find the partial derivatives\n\n$$\n\\begin{aligned}{h}_{x}(x,y) & =\\frac{∂}{∂x}(4x\\operatorname{arctan}⁡y) \\\\  & =4\\operatorname{arctan}⁡y \\\\ {h}_{y}(x,y) & =\\frac{∂}{∂y}(4x\\operatorname{arctan}⁡y) \\\\  & =\\frac{4x}{{y}^{2}+1}\\end{aligned}\n$$\n\nHence, the gradient is \n\n$$\n\\begin{aligned}∇h(x,y) & =⟨{h}_{x}(x,y),\\,{h}_{y}(x,y)⟩ \\\\  & =⟨4\\operatorname{arctan}⁡y,\\,\\frac{4x}{{y}^{2}+1}⟩ \\\\ ∇h(1,1) & =⟨4\\operatorname{arctan}⁡1,\\,\\frac{4\\cdot 1}{{1}^{2}+1}⟩ \\\\  & =⟨4\\cdot \\frac{\\pi }{4},\\,\\frac{4}{2}⟩ \\\\  & =⟨\\pi ,\\,2⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f9fc2f6-55bd-579f-8d29-1c23432bc9d6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,\\,0⟩" :db/id #edb/ref 17592186321268} {:answer/id #uuid "60e28288-b23d-5dcd-b0df-f485ee49c892" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186321907} {:answer/id #uuid "67ff6316-9900-5d46-835b-dc3f73fa9490" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,\\,0⟩" :db/id #edb/ref 17592186321959} {:answer/id #uuid "8b7eefa4-73e4-5852-8337-87a7151461a5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,0⟩" :db/id #edb/ref 17592186322262} {:answer/id #uuid "e6558f18-e9d0-5aff-84ab-a80892c690b3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186322950}] :answer-field/correct {:answer/id #uuid "0f9fc2f6-55bd-579f-8d29-1c23432bc9d6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,\\,0⟩" :db/id #edb/ref 17592186321268} :answer-field/id #uuid "4c408a79-7d5b-5c64-bf80-a6ec1301f01a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323314}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4dc17c5e-dc05-517c-b33a-803dd069587a" :question/math-academy-id "q-36009" :question/problem "Evaluate the gradient of $g(x,y)$ at the point $(\\frac{1}{2},0)$ if $g(x,y)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2})) \\\\  & =\\frac{2x}{{x}^{2}+{y}^{2}} \\\\ {g}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2})) \\\\  & =\\frac{2y}{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨{g}_{x}(x,y),\\,{g}_{y}(x,y)⟩ \\\\  & =⟨\\frac{2x}{{x}^{2}+{y}^{2}},\\,\\frac{2y}{{x}^{2}+{y}^{2}}⟩ \\\\  & =\\frac{2}{{x}^{2}+{y}^{2}}⟨x,\\,y⟩ \\\\ ∇g(\\frac{1}{2},\\,0) & =\\frac{2}{{(\\frac{1}{2})}^{2}+{0}^{2}}⟨\\frac{1}{2},\\,0⟩ \\\\  & =\\frac{2}{\\,\\frac{1}{4}}⟨\\frac{1}{2},\\,0⟩ \\\\  & =8⟨\\frac{1}{2},\\,0⟩ \\\\  & =⟨4,\\,0⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25a66e67-c420-5bae-9224-c8f5d4fde075" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186321440} {:answer/id #uuid "47baee24-d042-549a-8151-b2da72dc39a4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0⟩" :db/id #edb/ref 17592186321711} {:answer/id #uuid "9abaf78d-69a4-535f-a08b-0a3417313ea2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,8⟩" :db/id #edb/ref 17592186322375} {:answer/id #uuid "c8af8076-8ba0-5745-9225-6f71fe87a617" :answer/type {:db/ident :answer.type/math} :answer/value "⟨16,\\,1⟩" :db/id #edb/ref 17592186322707} {:answer/id #uuid "cc23bd77-b2ea-5ecd-832e-27ef06e5c5fa" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,\\,1⟩" :db/id #edb/ref 17592186322734}] :answer-field/correct {:answer/id #uuid "cc23bd77-b2ea-5ecd-832e-27ef06e5c5fa" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,\\,1⟩" :db/id #edb/ref 17592186322734} :answer-field/id #uuid "561a4834-955d-5829-ab93-034d86fd0c74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323334}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b4ba176-5939-5525-9fa4-02ef800efbcd" :question/math-academy-id "q-36909" :question/problem "Evaluate $∇f(x,y)$ at $(2,1)$ if $f(x,y)={x}^{2}\\sqrt{y+3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}\\sqrt{y+3}) \\\\  & =2x\\sqrt{y+3} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}({x}^{2}\\sqrt{y+3}) \\\\  & =\\frac{{x}^{2}}{2\\sqrt{y+3}}.\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨{f}_{x}(x,y),\\,{f}_{y}(x,y)⟩ \\\\  & =⟨2x\\sqrt{y+3},\\,\\frac{{x}^{2}}{2\\sqrt{y+3}}⟩ \\\\ ∇f(2,1) & =⟨2\\cdot 2\\sqrt{1+3},\\,\\frac{{2}^{2}}{2\\sqrt{1+3}}⟩ \\\\  & =⟨8,\\,1⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d9e603-cd32-5f3b-902b-7e9672467e90" :answer/type {:db/ident :answer.type/math} :answer/value "x\\text{ }i+(y-2\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/id #edb/ref 17592186321173} {:answer/id #uuid "34daa0d5-90eb-5a4b-aa2d-75910e6b15b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\text{ }i+(\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/id #edb/ref 17592186321551} {:answer/id #uuid "540220bc-b512-5297-ba09-11bb7feac085" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\text{ }i+(\\frac{1}{y}+2y\\operatorname{sin}⁡y)\\text{ }j" :db/id #edb/ref 17592186321808} {:answer/id #uuid "60d1352a-42b1-5de3-9128-c508fc1e23ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j" :db/id #edb/ref 17592186321906} {:answer/id #uuid "6c9d8c76-ca28-5482-a971-dc4ecb87331f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\text{ }i+2y(\\frac{1}{y}-\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/id #edb/ref 17592186321992}] :answer-field/correct {:answer/id #uuid "34daa0d5-90eb-5a4b-aa2d-75910e6b15b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\text{ }i+(\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/id #edb/ref 17592186321551} :answer-field/id #uuid "c7786cc2-42a8-56f0-a43a-1f962ff29273" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323561}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a48a9c83-f027-5fdb-8704-573396808d2c" :question/math-academy-id "q-36910" :question/problem "Given  $g(x,y)=\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})$, find $∇g(x,y).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\frac{1}{xy}\\cdot y+0 \\\\  & =\\frac{1}{x} \\\\ {g}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\frac{1}{xy}\\cdot x-\\operatorname{sin}⁡({y}^{2})\\cdot 2y \\\\  & =\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y) & ={g}_{x}(x,y)\\text{ }i+{g}_{y}(x,y)\\text{ }j \\\\  & =\\frac{1}{x}\\text{ }i+(\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2}))\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db9d9fc-22a0-597f-aae9-81bb345368b7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{{x}^{2}+{y}^{2}}\\,i+\\frac{y}{{x}^{2}+{y}^{2}}\\,j" :db/id #edb/ref 17592186383085} {:answer/id #uuid "8ecab5b2-5c74-57ec-9424-e1622a043b35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{{x}^{2}+{y}^{2}}\\,i-\\frac{y}{{x}^{2}+{y}^{2}}\\,j" :db/id #edb/ref 17592186383086} {:answer/id #uuid "59d1274a-8060-550f-9c16-15badbd51936" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}\\,i+\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}\\,j" :db/id #edb/ref 17592186383087} {:answer/id #uuid "89408273-38c8-5f7c-aaa3-d98a11b3ce1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j" :db/id #edb/ref 17592186383088} {:answer/id #uuid "e06e7ee3-6e0b-56c9-a951-2e2c02187b31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{{x}^{2}+{y}^{2}}\\,i-\\frac{x}{{x}^{2}+{y}^{2}}\\,j" :db/id #edb/ref 17592186383089}] :answer-field/correct {:answer/id #uuid "89408273-38c8-5f7c-aaa3-d98a11b3ce1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j" :db/id #edb/ref 17592186383088} :answer-field/id #uuid "ac0e2a52-799a-5e23-b506-14c0bcd60b6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383084}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a0611e4b-e342-5f93-a418-5af6bc5c2cae" :question/math-academy-id "q-127650" :question/problem "If $h(x,y)=\\operatorname{arctan}⁡(\\frac{y}{x}),$ find $∇h(x,y).$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(\\frac{y}{x})) \\\\  & =\\frac{1}{1+{(\\frac{y}{x})}^{2}}\\cdot (-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}\\cdot (-\\frac{y}{{x}^{2}}) \\\\  & =-\\frac{y}{{x}^{2}+{y}^{2}} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{arctan}⁡(\\frac{y}{x})) \\\\  & =\\frac{1}{1+{(\\frac{y}{x})}^{2}}\\cdot (\\frac{1}{x}) \\\\  & =\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}\\cdot \\frac{1}{x} \\\\  & =\\frac{x}{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =-\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5054b3-9e44-5b99-bd16-9b033843680e" :answer/type {:db/ident :answer.type/math} :answer/value "(y\\operatorname{sin}⁡(xy)+2x\\operatorname{ln}⁡y)\\text{ }i+(x\\operatorname{sin}⁡(xy)+\\frac{{x}^{2}}{y})\\text{ }j" :db/id #edb/ref 17592186385503} {:answer/id #uuid "05942608-4f0c-5190-9795-fc199ef694f0" :answer/type {:db/ident :answer.type/math} :answer/value "(x\\operatorname{cos}⁡(xy)+2x\\operatorname{ln}⁡y)\\text{ }i+(y\\operatorname{cos}⁡(xy)+\\frac{{x}^{2}}{y})\\text{ }j" :db/id #edb/ref 17592186385504} {:answer/id #uuid "1a7a4935-ee9f-5a3b-a985-9a5dab391c99" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡(xy)\\text{ }i+\\frac{{x}^{2}}{y}\\text{ }j" :db/id #edb/ref 17592186385505} {:answer/id #uuid "ed4bed73-4b7c-549c-929b-e9d32c41ffd0" :answer/type {:db/ident :answer.type/math} :answer/value "(x\\operatorname{sin}⁡(xy)+2x\\operatorname{ln}⁡y)\\text{ }i+(y\\operatorname{sin}⁡(xy)+\\frac{{x}^{2}}{y})\\text{ }j" :db/id #edb/ref 17592186385506} {:answer/id #uuid "9fd98997-fd6e-50eb-b908-a7bc2293d619" :answer/type {:db/ident :answer.type/math} :answer/value "(y\\operatorname{cos}⁡(xy)+2x\\operatorname{ln}⁡y)\\text{ }i+(x\\operatorname{cos}⁡(xy)+\\frac{{x}^{2}}{y})\\text{ }j" :db/id #edb/ref 17592186385507}] :answer-field/correct {:answer/id #uuid "9fd98997-fd6e-50eb-b908-a7bc2293d619" :answer/type {:db/ident :answer.type/math} :answer/value "(y\\operatorname{cos}⁡(xy)+2x\\operatorname{ln}⁡y)\\text{ }i+(x\\operatorname{cos}⁡(xy)+\\frac{{x}^{2}}{y})\\text{ }j" :db/id #edb/ref 17592186385507} :answer-field/id #uuid "7eb508af-a083-5c2f-a34b-a0c8200b10d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385502}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4ef41413-e673-510f-9d54-17f57ba92ac8" :question/math-academy-id "q-71350" :question/problem "Given  $f(x,y)=\\operatorname{sin}⁡(xy)+{x}^{2}\\operatorname{ln}⁡y$, find $∇f(x,y).$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy)+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =y\\operatorname{cos}⁡(xy)+2x\\operatorname{ln}⁡y \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy)+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =x\\operatorname{cos}⁡(xy)+{x}^{2}\\cdot \\frac{1}{y} \\\\  & =x\\operatorname{cos}⁡(xy)+\\frac{{x}^{2}}{y}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\text{ }i+{f}_{y}(x,y)\\text{ }j \\\\  & =(y\\operatorname{cos}⁡(xy)+2x\\operatorname{ln}⁡y)\\text{ }i+(x\\operatorname{cos}⁡(xy)+\\frac{{x}^{2}}{y})\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186437017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a96f20-3d44-594c-b78c-5063ef876b55" :answer/type {:db/ident :answer.type/math} :answer/value "i+e\\,j" :db/id #edb/ref 17592186436981} {:answer/id #uuid "586b4ce1-ff41-581f-8671-763767e3f3aa" :answer/type {:db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186436985} {:answer/id #uuid "e58c9d0d-900d-5547-a140-989e42e2459e" :answer/type {:db/ident :answer.type/math} :answer/value "e\\,j" :db/id #edb/ref 17592186437002} {:answer/id #uuid "f50ec89d-eacd-5a88-8f97-5ca1603aa25f" :answer/type {:db/ident :answer.type/math} :answer/value "e\\,i+e\\,j" :db/id #edb/ref 17592186437006} {:answer/id #uuid "fbc7838c-e6a9-592d-8e12-48498680e92d" :answer/type {:db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186437009}] :answer-field/correct {:answer/id #uuid "15a96f20-3d44-594c-b78c-5063ef876b55" :answer/type {:db/ident :answer.type/math} :answer/value "i+e\\,j" :db/id #edb/ref 17592186436981} :answer-field/id #uuid "51d09cbe-76cd-5f94-9148-15ee4e3c70f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437010}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "51a75799-7672-5c71-a422-88f2c2c1de7a" :question/math-academy-id "q-127652" :question/problem "Evaluate $∇f(x,y)$ at $(e,1)$ if $f(x,y)={x}^{y}.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{y}) \\\\  & =y{x}^{y-1} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}({x}^{y}) \\\\  & ={x}^{y}\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =y{x}^{y-1}\\text{ }i+{x}^{y}\\operatorname{ln}⁡x\\text{ }j, \\\\ ∇f(e,1) & =1(e)^{1-1}\\,i+{e}^{1}\\operatorname{ln}⁡e\\,j \\\\  & =i+e\\,j.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186437019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04308c81-1719-5c33-8d40-ebccd5767820" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\,1⟩" :db/id #edb/ref 17592186436980} {:answer/id #uuid "8e9a1c99-2d0e-5085-aa56-1bc7935a41a6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,-1⟩" :db/id #edb/ref 17592186436990} {:answer/id #uuid "b75c28ff-2fd2-5cb7-a89b-d7658bb7354e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,1⟩" :db/id #edb/ref 17592186436994} {:answer/id #uuid "d8f83b16-7c14-555d-b3bd-510c637f070d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,1⟩" :db/id #edb/ref 17592186437000} {:answer/id #uuid "e717d850-f7b3-516d-8057-a5abe63141f9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,-1⟩" :db/id #edb/ref 17592186437003}] :answer-field/correct {:answer/id #uuid "b75c28ff-2fd2-5cb7-a89b-d7658bb7354e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,1⟩" :db/id #edb/ref 17592186436994} :answer-field/id #uuid "798ed032-e7e1-5b90-a986-cd5c9792165f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437011}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bace43f6-9821-5763-9bf8-9ca1cf7da037" :question/math-academy-id "q-71353" :question/problem "Evaluate $∇h(x,y)$ at $(1,-1)$ if $h(x,y)={e}^{{x}^{2}+xy}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y) & =\\frac{∂}{∂x}({e}^{{x}^{2}+xy}) \\\\  & =(2x+y){e}^{{x}^{2}+xy} \\\\ {h}_{y}(x,y) & =\\frac{∂}{∂y}({e}^{{x}^{2}+xy}) \\\\  & =x{e}^{{x}^{2}+xy}.\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇h(x,y) & =⟨{h}_{x}(x,y),\\,{h}_{y}(x,y)⟩ \\\\  & =⟨(2x+y){e}^{{x}^{2}+xy},\\,x{e}^{{x}^{2}+xy}⟩ \\\\ ∇h(1,-1) & =⟨(2(1)+(-1)){e}^{{1}^{2}+(1)(-1)},\\,1\\cdot {e}^{{1}^{2}+(1)(-1)}⟩ \\\\  & =⟨1,\\,1⟩\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Gradient of a Function of Two Variables"}] [{:db/id #edb/ref 17592186124444 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124248 :question/id #uuid "bfade25e-065a-5c66-a554-9ee4e9559a55" :question/math-academy-id "e-3132" :question/problem "Evaluate $\\nabla g(x,y,z)$   at $(2,-1,3)$ if $g(x,y,z) = x^2 + xyz.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}+xyz) \\\\  & =2x+yz \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}+xyz) \\\\  & =0+xz \\\\  & =xz \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}+xyz) \\\\  & =0+xy \\\\  & =xy\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =(2x+yz)\\text{ }i+(xz)\\text{ }j+(xy)\\text{ }k \\\\ ∇g(2,-1,3) & =(2(2)+(-1)(3))\\text{ }i+2(3)\\text{ }j+2(-1)\\text{ }k \\\\  & =1\\text{ }i+6\\text{ }j-2\\text{ }k \\\\  & =i+6\\text{ }j-2\\text{ }k.\\end{aligned}\n$$"} :knowledge-point/id #uuid "fe2c7ce2-f053-57af-9f4d-54bd3a41648a" :knowledge-point/questions [{:db/id #edb/ref 17592186125020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35a99596-2194-56d8-b34a-8cf33e24d509" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{xyz}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186321558} {:answer/id #uuid "6fa3bf93-c16d-5b28-921e-41079fe50f98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xyz}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322014} {:answer/id #uuid "bdfd3cdb-b6de-5b57-8bc2-55f6cfdc0358" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322622} {:answer/id #uuid "ce59c82e-5d51-5485-be48-7fb4d8c385b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{xyz}}{2}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186322758} {:answer/id #uuid "def79f1e-967d-536d-901e-8b6506e4e5d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{xyz}(\\frac{1}{yz}\\text{ }i+\\frac{1}{xz}\\text{ }j+\\frac{1}{xz}\\text{ }k)" :db/id #edb/ref 17592186322890}] :answer-field/correct {:answer/id #uuid "bdfd3cdb-b6de-5b57-8bc2-55f6cfdc0358" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322622} :answer-field/id #uuid "b1682cef-8ea8-5e2a-8b48-c4bffce5ce2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323514}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4903eb08-1095-52c0-bd3a-a8d7c39455f8" :question/math-academy-id "q-36918" :question/problem "Given $f(x,y,z)=\\sqrt{xyz}$, find $∇f(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (yz) \\\\  & =\\frac{\\sqrt{xyz}}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xz) \\\\  & =\\frac{\\sqrt{xyz}}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xy) \\\\  & =\\frac{\\sqrt{xyz}}{2z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2x}\\text{ }i+\\frac{\\sqrt{xyz}}{2y}\\text{ }j+\\frac{\\sqrt{xyz}}{2z}\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186125022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e393b4-8a81-5128-9ba6-326770dd3c30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k" :db/id #edb/ref 17592186321197} {:answer/id #uuid "46cf9748-7a8c-51e8-a98f-bf480e7d4abd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{yz}\\text{ }j+\\frac{1}{yz}\\text{ }k" :db/id #edb/ref 17592186321705} {:answer/id #uuid "5277d147-5423-52ea-9448-c91d7f890aac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2\\sqrt{y}}\\text{ }j+\\frac{1}{2\\sqrt{z}}\\text{ }k" :db/id #edb/ref 17592186321796} {:answer/id #uuid "76d89040-9cda-5314-8747-132b54e35625" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2yz}\\text{ }j+\\frac{1}{2yz}\\text{ }k" :db/id #edb/ref 17592186322073} {:answer/id #uuid "fa45680f-55c0-5cbc-847f-d3b13a4ac29e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k" :db/id #edb/ref 17592186323119}] :answer-field/correct {:answer/id #uuid "05e393b4-8a81-5128-9ba6-326770dd3c30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k" :db/id #edb/ref 17592186321197} :answer-field/id #uuid "4bd27916-0e07-570f-8b09-3b81d2a1b865" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323310}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e287a6b3-141e-5735-ae69-360760a9ed55" :question/math-academy-id "q-36968" :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)=\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =\\frac{1}{2\\sqrt{x+2}}+0 \\\\  & =\\frac{1}{2\\sqrt{x+2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot z \\\\  & =\\frac{1}{2y} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot y \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0404f2a9-3d08-5a53-a026-f44a816bf37f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{ }i+\\frac{1}{3}\\text{ }j+k" :db/id #edb/ref 17592186321188} {:answer/id #uuid "13134d6f-499b-591c-bde5-f5b16ff56598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{ }i+\\frac{\\sqrt{6}}{6}\\text{ }j-\\frac{\\sqrt{2}}{2}\\text{ }k" :db/id #edb/ref 17592186321294} {:answer/id #uuid "39e1fd9f-c905-53ce-88ed-48a994829d3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k" :db/id #edb/ref 17592186321589} {:answer/id #uuid "457eb332-a887-58f4-9e71-5175afe5b10a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{ }i+6\\text{ }j-2\\text{ }k" :db/id #edb/ref 17592186321697} {:answer/id #uuid "6f462375-be9f-527c-9fe5-1e84d47ed3f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{ }i+\\frac{1}{3}\\text{ }j-k" :db/id #edb/ref 17592186322010}] :answer-field/correct {:answer/id #uuid "39e1fd9f-c905-53ce-88ed-48a994829d3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k" :db/id #edb/ref 17592186321589} :answer-field/id #uuid "c77c2c1d-e1c1-5a2d-9ca2-89a1901c372b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323562}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5313963c-57a3-55b2-bdc3-c997dcee0402" :question/math-academy-id "q-36969" :question/problem "Evaluate $∇f(x,y,z)$ at the point $(2,3,1)$ if $f(x,y,z)=\\operatorname{ln}⁡(\\sqrt{xyz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot yz \\\\  & =\\frac{1}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot xz \\\\  & =\\frac{1}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot xy \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\n \n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{x}(x,y,z)\\text{ }j+{f}_{x}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2x}\\text{ }i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k \\\\ ∇f(2,3,1) & =\\frac{1}{2\\cdot 2}\\text{ }i+\\frac{1}{2\\cdot 3}\\text{ }j+\\frac{1}{2\\cdot 1}\\text{ }k \\\\  & =\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c165a4b-7842-5080-b22d-dd998f4efc33" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(yz+zx)\\text{ }i+y\\operatorname{ln}⁡(yz+zx)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/id #edb/ref 17592186336145} {:answer/id #uuid "546a4641-9ee2-54b1-9a19-949510d27139" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(z)\\text{ }i+y\\operatorname{ln}⁡(z)\\text{ }j+xy\\operatorname{ln}⁡(z)\\text{ }k" :db/id #edb/ref 17592186336813} {:answer/id #uuid "c3ad8a94-3343-5d3e-a1c5-41b03ebbd768" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(z)\\text{ }i+xy\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/id #edb/ref 17592186337767} {:answer/id #uuid "d4f50290-6f7b-5795-9900-ef50d3f55007" :answer/type {:db/ident :answer.type/math} :answer/value "xy\\operatorname{ln}⁡(z)\\text{ }i+xy\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/id #edb/ref 17592186337892} {:answer/id #uuid "efe0a9c2-3996-5cde-90b0-22cd1b0fb18a" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(z)\\text{ }i+x\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/id #edb/ref 17592186338130}] :answer-field/correct {:answer/id #uuid "efe0a9c2-3996-5cde-90b0-22cd1b0fb18a" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(z)\\text{ }i+x\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/id #edb/ref 17592186338130} :answer-field/id #uuid "f4a6e392-66e6-5d55-9d5a-95166bc83697" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338705}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c4f224f8-09b2-598d-bc90-7a090ce4820d" :question/math-academy-id "q-71422" :question/problem "Given $h(x,y,z)=xy\\operatorname{ln}⁡(z)$, find $∇h(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy\\operatorname{ln}⁡(z)) \\\\  & =y\\operatorname{ln}⁡(z) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy\\operatorname{ln}⁡(z)) \\\\  & =x\\operatorname{ln}⁡(z) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy\\operatorname{ln}⁡(z)) \\\\  & =xy\\cdot \\frac{1}{z} \\\\  & =\\frac{xy}{z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{y}(x,y,z)\\text{ }j+{h}_{z}(x,y,z)\\text{ }k \\\\  & =y\\operatorname{ln}⁡(z)\\text{ }i+x\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a21b9f7-4aaa-5471-bf82-f2d8ab4a05d3" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186336422} {:answer/id #uuid "71cc0d72-27c7-5788-8341-714d4d503875" :answer/type {:db/ident :answer.type/math} :answer/value "(2x+yz{e}^{xyz})\\text{ }i+(2y+xz{e}^{xyz})\\text{ }j+(2z+xy{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337049} {:answer/id #uuid "78722099-cc9a-5084-9630-ca6c5d2d30e3" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337116} {:answer/id #uuid "7a839402-601f-5953-874b-788c1ff02eff" :answer/type {:db/ident :answer.type/math} :answer/value "(x{y}^{2}{z}^{2}+yz{e}^{xyz-1})\\text{ }i+({x}^{2}y{z}^{2}+xz{e}^{xyz-1})\\text{ }j+({x}^{2}{y}^{2}z+xy{e}^{xyz-1})\\text{ }k" :db/id #edb/ref 17592186337136} {:answer/id #uuid "ac9d6b72-745e-56b9-86ea-4dab4db1e685" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+x{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+y{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+z{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337584}] :answer-field/correct {:answer/id #uuid "78722099-cc9a-5084-9630-ca6c5d2d30e3" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337116} :answer-field/id #uuid "df0b11fb-76fe-57a4-9209-9720c0dc1087" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338670}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2d8f2390-7ede-5da9-be05-731bb79d1f06" :question/math-academy-id "q-71425" :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)={x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2x{y}^{2}{z}^{2}+yz{e}^{xyz} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2{x}^{2}y{z}^{2}+xz{e}^{xyz} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2{x}^{2}{y}^{2}z+xy{e}^{xyz}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "514f6510-65a6-5c71-8eca-34568a35dcba" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})j+{y}^{z}\\operatorname{ln}⁡y\\,k" :db/id #edb/ref 17592186383092} {:answer/id #uuid "6a1164dc-4f74-5f63-8956-517c46e081b5" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+z{y}^{z-1}\\,j+{y}^{z}\\operatorname{ln}⁡y\\,k" :db/id #edb/ref 17592186383093} {:answer/id #uuid "37e9d54a-963a-50c9-af62-5869773b3bbc" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{y}\\operatorname{ln}⁡y\\,i+{x}^{y}\\operatorname{ln}⁡x\\,j+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})k" :db/id #edb/ref 17592186383094} {:answer/id #uuid "daceaefe-76b2-57db-9142-cb9036ed18b4" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})i+{x}^{y}\\operatorname{ln}⁡y\\,j+{y}^{z}\\operatorname{ln}⁡z\\,k" :db/id #edb/ref 17592186383095} {:answer/id #uuid "b6a91458-30b5-5353-b216-4f46dc771583" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+z{y}^{z-1}\\,j+z{y}^{z-1}\\,k" :db/id #edb/ref 17592186383096}] :answer-field/correct {:answer/id #uuid "514f6510-65a6-5c71-8eca-34568a35dcba" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})j+{y}^{z}\\operatorname{ln}⁡y\\,k" :db/id #edb/ref 17592186383092} :answer-field/id #uuid "aa7309b8-5993-5bb2-9ecd-ce38b1c0b74d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383091}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cf052c6a-faee-5b8c-b178-4c397426507c" :question/math-academy-id "q-127945" :question/problem "If $f(x,y,z)={x}^{y}+{y}^{z},$ find $∇f(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{y}+{y}^{z}) \\\\  & =y{x}^{y-1} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{y}+{y}^{z}) \\\\  & ={x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{y}+{y}^{z}) \\\\  & ={y}^{z}\\operatorname{ln}⁡y\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =y{x}^{y-1}\\,i+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})j+{y}^{z}\\operatorname{ln}⁡y\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b8c5a90-83e7-5f9f-b520-1eaae67e52b7" :answer/type {:db/ident :answer.type/math} :answer/value "e(i-\\frac{1}{2}\\,j)" :db/id #edb/ref 17592186383099} {:answer/id #uuid "de50d21e-e598-5ea9-bc0f-adeed68ca073" :answer/type {:db/ident :answer.type/math} :answer/value "e(i-\\frac{1}{2}\\,j+k)" :db/id #edb/ref 17592186383100} {:answer/id #uuid "86a0af6e-4435-566d-a878-c8e589b685c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{e}(-i+\\pi \\,j-k)" :db/id #edb/ref 17592186383101} {:answer/id #uuid "7f1d0ab5-cfea-5a4b-924a-7f3b508a6a85" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{e}(i+\\pi \\,j-k)" :db/id #edb/ref 17592186383102} {:answer/id #uuid "ce237491-8288-54ff-835f-4ec66f6ccaa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{e}(i+\\frac{1}{2}\\,j)" :db/id #edb/ref 17592186383103}] :answer-field/correct {:answer/id #uuid "ce237491-8288-54ff-835f-4ec66f6ccaa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{e}(i+\\frac{1}{2}\\,j)" :db/id #edb/ref 17592186383103} :answer-field/id #uuid "ba2fd85f-4bd0-5b36-b61c-e043947f1967" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383098}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "804d417e-4fe8-53d3-ae3f-56da60f7d4fb" :question/math-academy-id "q-127947" :question/problem "Evaluate $∇h(x,y,z)$ at the point $(\\frac{1}{2},1,\\pi )$ if $h(x,y,z)={e}^{xy}\\operatorname{cos}⁡(yz).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}({e}^{xy}\\operatorname{cos}⁡(yz)) \\\\  & =y{e}^{xy}\\operatorname{cos}⁡(yz) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}({e}^{xy}\\operatorname{cos}⁡(yz)) \\\\  & =x{e}^{xy}\\operatorname{cos}⁡(yz)+{e}^{xy}(-\\operatorname{sin}⁡(yz))(z) \\\\  & ={e}^{xy}(x\\operatorname{cos}⁡(yz)-z\\operatorname{sin}⁡(yz)) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}({e}^{xy}\\operatorname{cos}⁡(yz)) \\\\  & =-y{e}^{xy}\\operatorname{sin}⁡(yz)\\end{aligned}\n$$\n\n \n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\,i+{h}_{x}(x,y,z)\\,j+{h}_{x}(x,y,z)\\,k \\\\  & =y{e}^{xy}\\operatorname{cos}⁡(yz)\\,i+{e}^{xy}(x\\operatorname{cos}⁡(yz)-z\\operatorname{sin}⁡(yz))\\,j-y{e}^{xy}\\operatorname{sin}⁡(yz)\\,k \\\\  & ={e}^{xy}(y\\operatorname{cos}⁡(yz)\\,i+(x\\operatorname{cos}⁡(yz)-z\\operatorname{sin}⁡(yz))\\,j-y\\operatorname{sin}⁡(yz)\\,k) \\\\ ∇h(\\frac{1}{2},1,\\pi ) & ={e}^{(1/2)(1)}(1\\operatorname{cos}⁡(1\\pi )\\,i+(\\frac{1}{2}\\operatorname{cos}⁡(1\\pi )-\\pi \\operatorname{sin}⁡(1\\pi ))\\,j-1\\operatorname{sin}⁡(1\\pi )\\,k) \\\\  & =\\sqrt{e}(-i-\\frac{1}{2}\\,j-0\\,k) \\\\  & =-\\sqrt{e}(i+\\frac{1}{2}\\,j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94b23f6d-fcbc-5f05-bdfa-551e5a601813" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k)" :db/id #edb/ref 17592186385333} {:answer/id #uuid "5cb1b5c1-0c20-551c-a0c4-1c105471790f" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(zi+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\text{ }k)" :db/id #edb/ref 17592186385334} {:answer/id #uuid "0886912b-e3e5-5d97-a4f7-8d67907aca83" :answer/type {:db/ident :answer.type/math} :answer/value "z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k" :db/id #edb/ref 17592186385335} {:answer/id #uuid "d8f5b6bf-05e5-54bc-b294-aa5357db39ab" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)\\text{ }(zi+y\\text{ }j+x\\text{ }k)" :db/id #edb/ref 17592186385336} {:answer/id #uuid "24c26190-fbac-5847-9741-c5fdf4a37862" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(zi+y\\text{ }j+x\\text{ }k)" :db/id #edb/ref 17592186385337}] :answer-field/correct {:answer/id #uuid "94b23f6d-fcbc-5f05-bdfa-551e5a601813" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k)" :db/id #edb/ref 17592186385333} :answer-field/id #uuid "63bf46dd-0351-5c7b-a783-d87b1b22bab9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385332}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7f2c8781-0baa-5cdd-8cbc-03cc6b1166f3" :question/math-academy-id "q-35989" :question/problem "Given  $g(x,y,z)={e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)$, find $∇g(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)) \\\\  & =2z{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1) \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)) \\\\  & =2y{e}^{2xz}\\operatorname{cos}⁡({y}^{2}-1) \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)) \\\\  & =2x{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1).\\end{aligned}\n$$\n\nHence, the gradient is: \n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =2z{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)\\text{ }i+2y{e}^{2xz}\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+2x{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k \\\\  & =2{e}^{2xz}\\text{ }(z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "633422e1-8e43-5c9f-91f7-5f1b7bac7900" :answer/type {:db/ident :answer.type/math} :answer/value "yz\\text{ }i+xz\\text{ }j+xy\\text{ }k" :db/id #edb/ref 17592186385346} {:answer/id #uuid "c843fcb2-eb1c-505e-b82f-631646ec1f8e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k)" :db/id #edb/ref 17592186385347} {:answer/id #uuid "021bd062-132f-5e06-92b6-5a56c9d30357" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186385348} {:answer/id #uuid "3e3b7394-d1cf-599d-a5a4-871fc9682748" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(xyz)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k)" :db/id #edb/ref 17592186385349} {:answer/id #uuid "8fef3c82-4839-5c58-8b07-a4fabcf9cc44" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(\\text{ }i+\\text{ }j+\\text{ }k)" :db/id #edb/ref 17592186385350}] :answer-field/correct {:answer/id #uuid "c843fcb2-eb1c-505e-b82f-631646ec1f8e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k)" :db/id #edb/ref 17592186385347} :answer-field/id #uuid "3d7b2133-c26f-5485-a0f6-31ac0fd776d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385345}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bcc7ffb5-272b-56a1-a959-51ef6109597c" :question/math-academy-id "q-36012" :question/problem "Given $h(x,y,z)=xyz\\operatorname{ln}⁡(xyz)$, find  $∇h(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xyz\\operatorname{ln}⁡(xyz)) \\\\  & =yz\\operatorname{ln}⁡(xyz)+xyz\\frac{yz}{xyz} \\\\  & =yz(\\operatorname{ln}⁡(xyz)+1) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xyz\\operatorname{ln}⁡(xyz)) \\\\  & =xz\\operatorname{ln}⁡(xyz)+xyz\\frac{xz}{xyz} \\\\  & =xz(\\operatorname{ln}⁡(xyz)+1) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xyz\\operatorname{ln}⁡(xyz)) \\\\  & =xy\\operatorname{ln}⁡(xyz)+xyz\\frac{xy}{xyz} \\\\  & =xy(\\operatorname{ln}⁡(xyz)+1)\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{y}(x,y,z)\\text{ }j+{h}_{z}(x,y,z)\\text{ }k \\\\  & =yz(\\operatorname{ln}⁡(xyz)+1)\\text{ }i+xz(\\operatorname{ln}⁡(xyz)+1)\\text{ }j+xy(\\operatorname{ln}⁡(xyz)+1)\\text{ }k \\\\  & =(\\operatorname{ln}⁡(xyz)+1)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac0e82c-e65c-52b4-92cf-ea9eef5506dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385531} {:answer/id #uuid "725ac3d7-7213-5bdb-b47f-4954c2a469c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i+\\pi \\text{ }j+\\pi \\text{ }k" :db/id #edb/ref 17592186385532} {:answer/id #uuid "44d96ff8-6e7a-5e3c-bdfc-e4fa56a64251" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i+\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385533} {:answer/id #uuid "5a3bbb8f-e6f1-5641-8261-340795b58dda" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385534} {:answer/id #uuid "fa3e1f03-a9e4-5b31-b950-95579c95df2e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi \\text{ }i+\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385535}] :answer-field/correct {:answer/id #uuid "7ac0e82c-e65c-52b4-92cf-ea9eef5506dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385531} :answer-field/id #uuid "7027997b-9ea2-56b2-bbd7-bdf567a4b72d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385530}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aef7acb8-89a1-5016-aa4c-ee6f59af7efc" :question/math-academy-id "q-71426" :question/problem "Evaluate $∇h(x,y,z)$ at the point $(1,-1,\\pi )$ if $h(x,y,z)=\\operatorname{sin}⁡(xyz).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xyz)) \\\\  & =yz\\operatorname{cos}⁡(xyz) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xyz)) \\\\  & =xz\\operatorname{cos}⁡(xyz) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{sin}⁡(xyz)) \\\\  & =xy\\operatorname{cos}⁡(xyz)\\end{aligned}\n$$\n\n \nHence, the gradient is\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{x}(x,y,z)\\text{ }j+{h}_{x}(x,y,z)\\text{ }k \\\\  & =yz\\operatorname{cos}⁡(xyz)\\text{ }i+xz\\operatorname{cos}⁡(xyz)\\text{ }j+xy\\operatorname{cos}⁡(xyz)\\text{ }k \\\\ ∇h(1,-1,\\pi ) & =(-1)(\\pi )\\operatorname{cos}⁡(-\\pi )\\text{ }i+(1)(\\pi )\\operatorname{cos}⁡(-\\pi )\\text{ }j+(1)(-1)\\operatorname{cos}⁡(-\\pi )\\text{ }k \\\\  & =(-\\pi )(-1)\\text{ }i+\\pi (-1)\\text{ }j-(-1)\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186437016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b7ebbbc-7508-52dc-91d2-56b705b7eccc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-12,0,8⟩" :db/id #edb/ref 17592186436986} {:answer/id #uuid "763a0475-ce2e-53a8-aa2d-9466219586f6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨12,8,0⟩" :db/id #edb/ref 17592186436989} {:answer/id #uuid "bd9e8470-5c37-54ae-b712-f0a64e63b2e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,8,0⟩" :db/id #edb/ref 17592186436995} {:answer/id #uuid "c0ae3e99-1ea5-5fa4-a1e9-7139e200dfcc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-4,8⟩" :db/id #edb/ref 17592186436996} {:answer/id #uuid "e7d9044c-103d-5c75-a1cc-b44786993ed3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4,0,8⟩" :db/id #edb/ref 17592186437004}] :answer-field/correct {:answer/id #uuid "bd9e8470-5c37-54ae-b712-f0a64e63b2e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,8,0⟩" :db/id #edb/ref 17592186436995} :answer-field/id #uuid "fe5a3950-f690-5d04-879c-231b6f838613" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437015}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3edc7251-4f74-5afa-bcee-22e839f081a7" :question/math-academy-id "q-127946" :question/problem "Evaluate $∇h(x,y,z)$ at $(1,-2,2)$ if $h(x,y,z)={x}^{2}{z}^{2}-x{y}^{2}+2yz.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}{z}^{2}-x{y}^{2}+2yz) \\\\  & =2x{z}^{2}-{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}{z}^{2}-x{y}^{2}+2yz) \\\\  & =2z-2xy \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}{z}^{2}-x{y}^{2}+2yz) \\\\  & =2{x}^{2}z+2y\\end{aligned}\n$$\n\nTherefore, the gradient is \n\n$$\n\\begin{aligned}∇h(x,y,z) & =⟨{h}_{x}(x,y,z),\\,{h}_{y}(x,y,z),\\,{h}_{z}(x,y,z)⟩ \\\\  & =⟨2x{z}^{2}-{y}^{2},\\,2z-2xy,\\,2{x}^{2}z+2y⟩ \\\\ ∇h(1,-2,2) & =⟨2(1)(2)^{2}-(-2)^{2},\\,-2(1)(-2)+2(2),\\,2(1)^{2}(2)+2(-2)⟩ \\\\  & =⟨8-4,4+4,4-4⟩ \\\\  & =⟨4,8,0⟩.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Gradient of a Function of Three Variables"}] [{:db/id #edb/ref 17592186124445 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124249 :question/id #uuid "b2549d7b-07c2-5f2f-89a3-2cccecf2ba22" :question/math-academy-id "e-3133" :question/problem "Given that $f(x,y)= (y-4)\\ln (x-2),$ find the points $(x, y)$ where $\\nabla f(x,y) = \\mathbf 0.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((y-4)\\operatorname{ln}⁡(x-2)) \\\\  & =\\frac{y-4}{x-2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((y-4)\\operatorname{ln}⁡(x-2)) \\\\  & =\\operatorname{ln}⁡(x-2)\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\nabla f(x,y) = \\dfrac {y-4}{x-2} \\, \\mathbf i + \\ln(x-2) \\, \\mathbf j.\n$$\n\nNow, we solve $\\nabla f(x,y) = \\mathbf 0\\mathbin{:}$\n\n$$\n\\dfrac {y-4}{x-2} \\, \\mathbf i + \\ln(x-2) \\, \\mathbf j = 0 \\  \\mathbf i + 0\\ \\mathbf j\n$$\n\nBy equating the coefficients of $\\mathbf{i}$ on both sides of the equation (and similarly with $\\mathbf{j}$), we obtain\n\n$$\n\\{\\begin{aligned}\\frac{y-4}{x-2}=0 \\\\ \\operatorname{ln}⁡(x-2)=0.\\end{aligned}\n$$\n\nFrom the first equation, we get $y-4=0,$ which means $y=4.$  From the second equation, we obtain $\\ln(x-2)=0,$ which means that $x=3.$\n\nTherefore, $\\nabla f(x,y) =\\mathbf  0$ at the point $(3,4).$"} :knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340" :knowledge-point/questions [{:db/id #edb/ref 17592186124944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a28c62d9-42c2-5bab-af79-c25e2c1af6db" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{6},\\frac{1}{2})" :db/id #edb/ref 17592186322430} {:answer/id #uuid "bcdf801e-cc4b-53df-a3aa-d41d5909acc1" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{2},\\frac{1}{12})" :db/id #edb/ref 17592186322612} {:answer/id #uuid "ce509177-3d5a-5986-a13b-d30b4334afa7" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186322757} {:answer/id #uuid "e8d388fe-66aa-582e-9f0b-761be7954f4c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{6},0)" :db/id #edb/ref 17592186322972} {:answer/id #uuid "fe13f225-c620-5ad1-9d61-c77c2908a9da" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{1}{2})" :db/id #edb/ref 17592186323151}] :answer-field/correct {:answer/id #uuid "e8d388fe-66aa-582e-9f0b-761be7954f4c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{6},0)" :db/id #edb/ref 17592186322972} :answer-field/id #uuid "691827ae-2fb8-5708-9d35-1f7788b44561" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323377}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "da858976-fa9b-559a-a71d-31223d9b1ce7" :question/math-academy-id "q-35995" :question/problem "Given that $f(x,y)=3{x}^{2}+{y}^{2}-x$, find the points $(x,y)$ where $∇f(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(3{x}^{2}+{y}^{2}-x) \\\\  & =6x+0-1 \\\\  & =6x-1 \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3{x}^{2}+{y}^{2}-x) \\\\  & =0+2y-0 \\\\  & =2y\\end{aligned}\n$$\n\nHence, $∇f(x,y)=(6x-1)\\,i+2y\\,j.$\n\nNow, we solve $∇f(x,y)=0:$\n\n$$\n(6x-1)\\,i+2y\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}6x-1=0 \\\\ 2y=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=\\frac{1}{6}.$ From the second equation, we obtain $y=0.$ \n\nTherefore, $∇f(x,y)=0$ at the point $(\\frac{1}{6},0)\\,.$"} {:db/id #edb/ref 17592186125023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a668d31-3cc8-5ea9-96ef-7e0fdcd58b8c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and  $(-1,-1,-1)$" :db/id #edb/ref 17592186321594} {:answer/id #uuid "649040c7-206e-50ab-b58d-af585a9cdb7e" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1,1)$ only" :db/id #edb/ref 17592186321929} {:answer/id #uuid "b6c29216-4d6d-58d7-9dc1-49c48b3848a7" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ only" :db/id #edb/ref 17592186322570} {:answer/id #uuid "eff49e99-8930-5a35-aa82-5e696d691c29" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186323039} {:answer/id #uuid "ff909540-c4d2-5403-9b36-0186dff131b9" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,-1,0)$" :db/id #edb/ref 17592186323164}] :answer-field/correct {:answer/id #uuid "ff909540-c4d2-5403-9b36-0186dff131b9" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,-1,0)$" :db/id #edb/ref 17592186323164} :answer-field/id #uuid "4c22ca2c-680a-5b37-a867-786a2de07c36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323313}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "adae0b04-7ccf-59da-b863-ae9717fcfd97" :question/math-academy-id "q-36970" :question/problem "Given $h(x,y,z)=xy+x{y}^{2}+{z}^{3}.$ Find the points $(x,y,z)$ where $∇h(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy+x{y}^{2}+{z}^{3}) \\\\  & =y+{y}^{2}+0 \\\\  & =y+{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy+x{y}^{2}+{z}^{3}) \\\\  & =x+2xy+0 \\\\  & =x+2xy \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy+x{y}^{2}+{z}^{3}) \\\\  & =0+0+3{z}^{2} \\\\  & =3{z}^{2}\\end{aligned}\n$$\n\nHence, $∇h(x,y,z)=(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k.$\n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficients of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}y+{y}^{2}=0 \\\\ x+2xy=0 \\\\ 3{z}^{2}=0\\end{aligned}\n$$\n\nThe first equation can be written as $y(1+y)=0$, which gives $y=0$ or $y=-1.$ Substituting these into the second equation, we obtain:\n\n$$\n\\begin{aligned}x+2x(0) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nor,\n\n$$\n\\begin{aligned}x+2x(-1) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nFinally, from the third equation, we get $z=0.$\n\nTherefore, $∇h(x,y,z)=0$ at two points: $(0,0,0)$ and $(0,-1,0).$"} {:db/id #edb/ref 17592186262919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23779567-a8ad-53b9-bba7-20eb9434d446" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,0)$ and $(0,\\frac{\\pi }{2})$" :db/id #edb/ref 17592186260186} {:answer/id #uuid "252ff177-ca33-56d5-90df-65c900fa8710" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,0)$ only" :db/id #edb/ref 17592186260196} {:answer/id #uuid "3c0fd5bb-e524-591c-95eb-dd9ac92e0ae7" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,\\frac{\\pi }{2})$ only" :db/id #edb/ref 17592186260410} {:answer/id #uuid "8a3682d9-c2f8-516c-9549-f226b96cd4e4" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,\\frac{\\pi }{2})$ only" :db/id #edb/ref 17592186261080} {:answer/id #uuid "cfca039c-c8d9-5aa9-b3cf-495e5bcbfed8" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0)$ and $(1,\\frac{\\pi }{2})$" :db/id #edb/ref 17592186261709}] :answer-field/correct {:answer/id #uuid "23779567-a8ad-53b9-bba7-20eb9434d446" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,0)$ and $(0,\\frac{\\pi }{2})$" :db/id #edb/ref 17592186260186} :answer-field/id #uuid "9694ecaf-94de-5d7f-a9c8-24cf2ab3c726" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262394}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "48261b12-c86c-55b1-9e2a-f38acbfa450a" :question/math-academy-id "q-128517" :question/problem "Given that $f(x,y)={x}^{2}-2x\\operatorname{cos}⁡y,$ find the points $(x,y),$ for $0\\le y<\\pi ,$ where $∇f(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}-2x\\operatorname{cos}⁡y) \\\\  & =2x-2\\operatorname{cos}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}-2x\\operatorname{cos}⁡y) \\\\  & =2x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nHence, $∇f(x,y)=2(x-\\operatorname{cos}⁡y)\\,i+2x\\operatorname{sin}⁡y\\,j.$\n\nNow, we solve $∇f(x,y)=0:$ \n\n$$\n2(x-\\operatorname{cos}⁡y)\\,i+2x\\operatorname{sin}⁡y\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}2(x-\\operatorname{cos}⁡y)=0 \\\\ 2x\\operatorname{sin}⁡y=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=\\operatorname{cos}⁡y.$ Substituting this into the second equation, we obtain \n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡y\\operatorname{sin}⁡y & =0 \\\\ \\operatorname{sin}⁡2y & =0 \\\\ y & =0,\\,\\frac{\\pi }{2}\\end{aligned}\n$$\n\n- For $y=0,$ we get $x=\\operatorname{cos}⁡0=1.$\n\n- For $y=\\frac{\\pi }{2},$ we get $x=\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\nTherefore, $∇h(x,y)=0,$ for $0\\le y<\\pi ,$ at two points: $(1,0)$ and $(0,\\frac{\\pi }{2}).$"} {:db/id #edb/ref 17592186385536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f709b8d-e22d-555e-8f82-4b819b741a2d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186385538} {:answer/id #uuid "4f628e18-1e56-5031-998e-e94575d669fb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186385539} {:answer/id #uuid "8a817cfe-6e50-5534-9c89-401a91beed6d" :answer/type {:db/ident :answer.type/math} :answer/value "(4,2)" :db/id #edb/ref 17592186385540} {:answer/id #uuid "6f89f99e-c222-5f75-b88f-1f3ed3be632f" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-2)" :db/id #edb/ref 17592186385541} {:answer/id #uuid "55d2d586-a13f-55b7-99b9-71d0fd4b3d5b" :answer/type {:db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186385542}] :answer-field/correct {:answer/id #uuid "2f709b8d-e22d-555e-8f82-4b819b741a2d" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186385538} :answer-field/id #uuid "c5955cf1-cc26-55ec-8c2a-34ff0cdd5429" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385537}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "191461eb-d37c-55af-a5cc-b1cdcbe5989a" :question/math-academy-id "q-71437" :question/problem "Given that $g(x,y)=4xy+{y}^{2}-{x}^{2}$, find the points $(x,y)$ where $∇g(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4xy+{y}^{2}-{x}^{2}) \\\\  & =4y+0-2x \\\\  & =2(2y-x) \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4xy+{y}^{2}-{x}^{2}) \\\\  & =4x+2y-0 \\\\  & =2(2x+y)\\end{aligned}\n$$\n\nHence, $∇g(x,y)=2(2y-x)\\,i+2(2x+y)\\,j.$\n\nNow, we solve $∇g(x,y)=0:$\n\n$$\n2(2y-x)\\,i+2(2x+y)\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}2y-x=0 \\\\ 2x+y=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=2y.$ Substituting these into the second equation, we obtain: \n\n$$\n\\begin{aligned}2(2y)+y & =0 \\\\ 5y & =0 \\\\ y & =0\\end{aligned}\n$$\n\nFinally, we get $x=2\\cdot 0=0.$\n\nTherefore, $∇g(x,y)=0$ at the point $(0,0).$"} {:db/id #edb/ref 17592186385543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00852e0a-f6f6-5c5a-ac0e-5aab7917034a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186385545} {:answer/id #uuid "0a138de7-1cdb-5fca-ab9b-192f03014909" :answer/type {:db/ident :answer.type/math} :answer/value "(e,e,e)" :db/id #edb/ref 17592186385546} {:answer/id #uuid "4db23065-4328-5f87-98fa-c2f53e71285d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{e},\\frac{1}{e},\\frac{1}{e})" :db/id #edb/ref 17592186385547} {:answer/id #uuid "c45fae02-a3c6-5e5b-83c3-515185ddf33b" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-1,-1)" :db/id #edb/ref 17592186385548} {:answer/id #uuid "965bb97e-ab1f-5bcd-b8b9-68650da44bfa" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1,1)" :db/id #edb/ref 17592186385549}] :answer-field/correct {:answer/id #uuid "965bb97e-ab1f-5bcd-b8b9-68650da44bfa" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1,1)" :db/id #edb/ref 17592186385549} :answer-field/id #uuid "12e34691-896f-5bb6-afac-57e259bb49f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385544}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ceb4f40b-ddfe-5165-8e9a-092d10842d64" :question/math-academy-id "q-71475" :question/problem "Given that $g(x,y,z)=x\\operatorname{ln}⁡x+y\\operatorname{ln}⁡y+z\\operatorname{ln}⁡z-x-y-z$, find the points $(x,y,z)$ where $∇g(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡x+y\\operatorname{ln}⁡y+z\\operatorname{ln}⁡z-x-y-z) \\\\  & =\\operatorname{ln}⁡x+x\\cdot \\frac{1}{x}+0+0-1-0-0 \\\\  & =\\operatorname{ln}⁡x+1-1 \\\\  & =\\operatorname{ln}⁡x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡x+y\\operatorname{ln}⁡y+z\\operatorname{ln}⁡z-x-y-z) \\\\  & =0+\\operatorname{ln}⁡y+y\\cdot \\frac{1}{y}+0-0-1-0 \\\\  & =\\operatorname{ln}⁡y+1-1 \\\\  & =\\operatorname{ln}⁡y \\\\ \\frac{∂g}{∂z} & =\\frac{∂}{∂z}(x\\operatorname{ln}⁡x+y\\operatorname{ln}⁡y+z\\operatorname{ln}⁡z-x-y-z) \\\\  & =0+0+\\operatorname{ln}⁡z+z\\cdot \\frac{1}{z}-0-0-1 \\\\  & =\\operatorname{ln}⁡z+1-1 \\\\  & =\\operatorname{ln}⁡z\\end{aligned}\n$$\n\nHence, $∇g(x,y,z)=\\operatorname{ln}⁡x\\,i+\\operatorname{ln}⁡y\\,j+\\operatorname{ln}⁡z\\,k.$ \n\nNow, we solve $∇g(x,y,z)=0:$\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡x\\,i+\\operatorname{ln}⁡y\\,j+\\operatorname{ln}⁡z\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficient of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}\\operatorname{ln}⁡x=0 \\\\ \\operatorname{ln}⁡y=0 \\\\ \\operatorname{ln}⁡z=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=1.$  Similarly, from the second and third equations, we obtain $y=1$ and $z=1.$\n\nHence, $∇g(x,y,z)=0$ at the point $(1,1,1).$"} {:db/id #edb/ref 17592186395845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3c6467b-917f-5aae-9cc9-3d8de87bf705" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186395847} {:answer/id #uuid "95acc209-e214-5661-af27-7731166005f9" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{2},\\frac{3}{4})" :db/id #edb/ref 17592186395848} {:answer/id #uuid "8a0c76fb-2820-5cf1-9645-b9dbc230a965" :answer/type {:db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186395849} {:answer/id #uuid "bef1175c-5920-532e-b7b5-9da5b087ef6f" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186395850} {:answer/id #uuid "4b5d5b3b-9e1f-57a7-8376-c15ae99d31d4" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186395851}] :answer-field/correct {:answer/id #uuid "4b5d5b3b-9e1f-57a7-8376-c15ae99d31d4" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186395851} :answer-field/id #uuid "3ad0dc77-76f9-5eaa-aa66-ed1f16aa44f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395846}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7795ea1b-86ec-5a3d-baba-dbdd67574697" :question/math-academy-id "q-36911" :question/problem "Given that $f(x,y)=\\operatorname{ln}⁡({x}^{2}+1)+2(y-3)^{2}$, find the points $(x,y)$ where $∇f(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+1)+2(y-3)^{2}) \\\\  & =\\frac{1}{{x}^{2}+1}\\cdot 2x+0 \\\\  & =\\frac{2x}{{x}^{2}+1} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+1)+2(y-3)^{2}) \\\\  & =0+2\\cdot 2(y-3) \\\\  & =4(y-3)\\end{aligned}\n$$\n\nHence, $∇f(x,y)=\\frac{2x}{{x}^{2}+1}\\,i+4(y-3)\\,j.$\n\nNow, we solve $∇f(x,y)=0:$ \n\n$$\n\\frac{2x}{{x}^{2}+1}\\,i+4(y-3)\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}\\frac{2x}{{x}^{2}+1}=0 \\\\ 4(y-3)=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=0$ and from the second equation, we obtain $y=3.$ \n\nTherefore, $∇f(x,y)=0$ at the point $(0,3).$"} {:db/id #edb/ref 17592186400373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a10163a-dceb-5ab4-b904-ba9a054ac615" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,3)$ and $(-3,-3)$" :db/id #edb/ref 17592186400375} {:answer/id #uuid "83d361ab-691b-507d-aa60-ee6cbedb4a3b" :answer/type {:db/ident :answer.type/text} :answer/value "$(-3,-3)$ only" :db/id #edb/ref 17592186400376} {:answer/id #uuid "6ad8d842-3217-5d0b-a3d1-f6c4802c29c7" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,-3)$ and $(-3,3)$" :db/id #edb/ref 17592186400377} {:answer/id #uuid "e58ac478-7209-5f45-a6c1-f164d3f25552" :answer/type {:db/ident :answer.type/text} :answer/value "$(-3,3)$ only" :db/id #edb/ref 17592186400378} {:answer/id #uuid "bf97e181-9c44-5eb6-9ba0-39838ff1806e" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,3)$ only" :db/id #edb/ref 17592186400379}] :answer-field/correct {:answer/id #uuid "83d361ab-691b-507d-aa60-ee6cbedb4a3b" :answer/type {:db/ident :answer.type/text} :answer/value "$(-3,-3)$ only" :db/id #edb/ref 17592186400376} :answer-field/id #uuid "975890c9-a5ad-56b9-8079-273dba5ca847" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400374}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a633d445-62c8-5864-b7bf-d694cd1cd56c" :question/math-academy-id "q-128519" :question/problem "Given that $g(x,y)=\\frac{9}{y}-\\frac{3y}{x}+x,$ find the points $(x,y)$ where $∇g(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{9}{y}-\\frac{3y}{x}+x) \\\\  & =\\frac{3y}{{x}^{2}}+1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{9}{y}-\\frac{3y}{x}+x) \\\\  & =-\\frac{9}{{y}^{2}}-\\frac{3}{x}\\end{aligned}\n$$\n\nHence, $∇g(x,y)=(\\frac{3y}{{x}^{2}}+1)i-(\\frac{9}{{y}^{2}}+\\frac{3}{y})j.$\n\nNow, we solve $∇g(x,y)=0:$\n\n$$\n(\\frac{3y}{{x}^{2}}+1)i-(\\frac{9}{{y}^{2}}+\\frac{3}{x})j=0\\,i+0\\,j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}\\frac{3y}{{x}^{2}}+1=0 \\\\ \\frac{9}{{y}^{2}}+\\frac{3}{x}=0\\end{aligned}\n$$\n\nFrom the first equation, we get $y=-\\frac{{x}^{2}}{3}.$ Substituting this into the second equation, we obtain\n\n$$\n\\begin{aligned}\\frac{9}{{(-\\frac{{x}^{2}}{3})}^{2}}+\\frac{3}{x} & =0 \\\\ 9\\cdot {(-\\frac{3}{{x}^{2}})}^{2}+\\frac{3}{x} & =0 \\\\ \\frac{81}{{x}^{4}}+\\frac{3}{x} & =0 \\\\ \\frac{81+3{x}^{3}}{{x}^{4}} & =0 \\\\ 81+3{x}^{3} & =0 \\\\ {x}^{3} & =-27 \\\\ x & =-3.\\end{aligned}\n$$\n\nFor $x=-3,$ we get $y=-\\frac{(-3)^{2}}{3}=-3.$\n\nTherefore, $∇g(x,y)=0$ at the point: $(-3,-3).$"} {:db/id #edb/ref 17592186403475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9ec4597-899c-5f21-a16c-2695e9541e21" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1,1)$ only" :db/id #edb/ref 17592186403477} {:answer/id #uuid "4c24ba4d-0c93-5d33-a565-f106f0e3b765" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1,-1)$ and $(-1,1,1)$" :db/id #edb/ref 17592186403478} {:answer/id #uuid "a1afdd74-60dd-5f9b-bad5-2d5610ad3377" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1,1)$ and $(-1,1,-1)$" :db/id #edb/ref 17592186403479} {:answer/id #uuid "e68b95bf-0642-5f05-aa57-9a8fabde2338" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,1,-1)$ only" :db/id #edb/ref 17592186403480} {:answer/id #uuid "15edafbf-4f96-51e2-9aa0-c33dbac930ad" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1,-1)$ and $(1,1,1)$" :db/id #edb/ref 17592186403481}] :answer-field/correct {:answer/id #uuid "a1afdd74-60dd-5f9b-bad5-2d5610ad3377" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1,1)$ and $(-1,1,-1)$" :db/id #edb/ref 17592186403479} :answer-field/id #uuid "ca042fa0-0bbe-58d3-8050-de243a925b8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403476}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c503ae86-f71f-5a21-9c90-e19ce4d410a1" :question/math-academy-id "q-71474" :question/problem "Given that $f(x,y,z)=\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z$, find the points $(x,y,z)$ where $∇f(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{{x}^{2}y}+0-\\frac{1}{z{x}^{2}}-0 \\\\  & =-\\frac{z+y}{{x}^{2}yz} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{x{y}^{2}}-\\frac{1}{{y}^{2}}+0-0 \\\\  & =-\\frac{1+x}{x{y}^{2}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =0+0-\\frac{1}{{z}^{2}x}-1 \\\\  & =-\\frac{1+{z}^{2}x}{{z}^{2}x}\\end{aligned}\n$$\n\nHence, $∇f(x,y,z)=-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k.$ \n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficient of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}=0 \\\\ -\\frac{1+x}{x{y}^{2}}=0 \\\\ -\\frac{1+{z}^{2}x}{{z}^{2}x}=0\\end{aligned}\n$$\n\nFrom the second equation, we get $x=-1.$ Substituting these into the third equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{1+{z}^{2}x}{{z}^{2}x} & =0 \\\\ -\\frac{1+{z}^{2}(-1)}{{z}^{2}(-1)} & =0 \\\\ 1-{z}^{2} & =0 \\\\ {z}^{2} & =1 \\\\ z & =\\pm 1\\end{aligned}\n$$\n\nSubstituting $x=-1$ into the first equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{z+y}{(-1)^{2}yz} & =0 \\\\ z+y & =0 \\\\ y & =-z\\end{aligned}\n$$\n\nWhen $z=1,$ we have $y=-1$ and when $z=-1,$ we have $y=1.$\n\nHence, $∇f(x,y,z)=0$ at two points: $(-1,-1,1)$ and $(-1,1,-1).$"} {:db/id #edb/ref 17592186437020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e36d0b8-dad3-53f0-905d-1b73b0cfb007" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1,-1),$ $(0,0,0)$ and $(1,1,1)$" :db/id #edb/ref 17592186436982} {:answer/id #uuid "3eb3ce4f-3615-5638-9cca-7d5f9a7f4065" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1,-1),$ $(0,0,0)$ and $(1,1,1)$" :db/id #edb/ref 17592186436983} {:answer/id #uuid "4a50ec3f-8ef4-53d6-b614-888ffb598364" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1,-1)$ and $(1,1,1)$" :db/id #edb/ref 17592186436984} {:answer/id #uuid "b421e42f-f55a-5ffe-a533-367af3998505" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1,-1)$ and $(-1,-1,1)$" :db/id #edb/ref 17592186436993} {:answer/id #uuid "ca48ce3d-8118-5a85-8d40-9f54dccebe39" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-1,-1)$ and $(0,0,0)$" :db/id #edb/ref 17592186436997}] :answer-field/correct {:answer/id #uuid "3eb3ce4f-3615-5638-9cca-7d5f9a7f4065" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1,-1),$ $(0,0,0)$ and $(1,1,1)$" :db/id #edb/ref 17592186436983} :answer-field/id #uuid "e9f85d81-d1f0-5077-ba52-dc9b36b72fa3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437014}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c3503a39-2405-5c8f-9ad7-2d39b5c187d5" :question/math-academy-id "q-128513" :question/problem "Given $h(x,y,z)={x}^{2}+4yz-2{z}^{2}-2{y}^{2}x.$ Find the points $(x,y,z)$ where $∇h(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}+4yz-2{z}^{2}-2{y}^{2}x) \\\\  & =2x-2{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}+4yz-2{z}^{2}-2{y}^{2}x) \\\\  & =4z-4yx \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}+4yz-2{z}^{2}-2{y}^{2}x) \\\\  & =4y-4z\\end{aligned}\n$$\n\nHence, $∇h(x,y,z)=2(x-{y}^{2})\\,i+4(z-yx)\\,j+4(y-z)\\,k.$\n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}2(x-{y}^{2})\\,i+4(z-yx)\\,j+4(y-z)\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficients of $i$, $j$, and $k$, we obtain\n\n$$\n\\{\\begin{aligned}x-{y}^{2}=0, \\\\ z-yx=0, \\\\ y-z=0\\end{aligned}\n$$\n\nThe first equation gives $x={y}^{2}.$ Substituting this into the second equation, we obtain $z={y}^{3}.$ Substituting $z={y}^{3}$ into the third equation gives\n\n$$\n\\begin{aligned}y-{y}^{3} & =0 \\\\ y(1-{y}^{2}) & =0 \\\\ y & =0,\\,\\pm 1.\\end{aligned}\n$$\n\n- For $y=-1,$ we get $x=(-1)^{2}=1$ and $z=(-1)^{3}=-1.$\n\n- For $y=0,$ we obtain $x={0}^{2}=0$ and $z={0}^{3}=0.$\n\n- For $y=1,$ gives $x={1}^{2}=1$ and $z={1}^{3}=1.$\n\nFinally, $∇h(x,y,z)=0$ at three points: $(1,-1,-1),$ $(0,0,0)$ and $(1,1,1).$"} {:db/id #edb/ref 17592186437021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e2a514c-da70-5cc8-95d2-327d72d03570" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,-2)$ only" :db/id #edb/ref 17592186436987} {:answer/id #uuid "7067d8af-1731-5b47-8f38-e961d32014a4" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186436988} {:answer/id #uuid "8f042e63-ea21-547d-8187-c6464d907f1c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,2)$" :db/id #edb/ref 17592186436991} {:answer/id #uuid "a6cf6f0f-1cc3-5518-a4d7-359da9629347" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,-2)$" :db/id #edb/ref 17592186436992} {:answer/id #uuid "fb87d0bd-b556-514b-84e7-e694a530dff2" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(-1,0,-2)$" :db/id #edb/ref 17592186437008}] :answer-field/correct {:answer/id #uuid "a6cf6f0f-1cc3-5518-a4d7-359da9629347" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,-2)$" :db/id #edb/ref 17592186436992} :answer-field/id #uuid "e83f4999-419d-51c4-a803-c6789f4e1b52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437013}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d13fce5d-8bd4-547a-afec-720ff5befaa7" :question/math-academy-id "q-71470" :question/problem "Given $h(x,y,z)=xy{e}^{x}+{z}^{2}{e}^{z}.$ Find the points $(x,y,z)$ where $∇h(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy{e}^{x}+{z}^{2}{e}^{z}) \\\\  & =xy{e}^{x}+y{e}^{x}+0 \\\\  & =y(x+1){e}^{x} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy{e}^{x}+{z}^{2}{e}^{z}) \\\\  & =x{e}^{x}+0 \\\\  & =x{e}^{x} \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy{e}^{x}+{z}^{2}{e}^{z}) \\\\  & =0+2z{e}^{z}+{z}^{2}{e}^{z} \\\\  & =z(2+z){e}^{z}\\end{aligned}\n$$\n\nHence, $∇h(x,y,z)=y(x+1){e}^{x}\\,i+x{e}^{x}\\,j+z(2+z){e}^{z}\\,k.$\n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}y(x+1){e}^{x}\\,i+x{e}^{x}\\,j+z(2+z){e}^{z}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficients of $i$, $j$, and $k$, we obtain:\n\n$$\n\\{\\begin{aligned}y(x+1){e}^{x}=0 \\\\ x{e}^{x}=0 \\\\ z(2+z){e}^{z}=0\\end{aligned}\n$$\n\nThe second equation gives $x=0.$ Substituting these into the first equation, we obtain:\n\n$$\n\\begin{aligned}y(0+1){e}^{0} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nFinally, from the third equation, we get  $z=0$ or $z=-2.$\n\nTherefore, $∇h(x,y,z)=0$ at two points: $(0,0,0)$ and $(0,0,-2).$"}] :knowledge-point/title "Finding the Points Where a Gradient Vanishes"}]}
