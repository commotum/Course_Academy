26}{3}\\ln|x|+C \\\\  & =\\frac{26}{3}\\ln|x|+\\frac{26}{3}\\ln K \\\\  & =\\frac{26}{3}(\\ln|x|+\\ln K) \\\\  & =\\frac{26}{3}\\ln(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5a5e89-9037-5553-b5d2-6a4486bcb3c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\frac{19}{2}|x|+K)" :db/id #edb/ref 17592186485667} {:answer/id #uuid "92ef70a0-d452-5a59-ab1c-9d1ac5d53d59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{2}\\ln(|x|+K)" :db/id #edb/ref 17592186485677} {:answer/id #uuid "b93aa08c-69e4-52cc-9d3f-c40131037a1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\frac{19}{2}K|x|)" :db/id #edb/ref 17592186485689} {:answer/id #uuid "c7719ec9-9d74-54fc-b468-a3828bdba599" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln(19K|x|)" :db/id #edb/ref 17592186485692} {:answer/id #uuid "cd786feb-ef7f-59bb-a0f9-07dc918062e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{2}\\ln(K|x|)" :db/id #edb/ref 17592186485693}] :answer-field/correct {:answer/id #uuid "cd786feb-ef7f-59bb-a0f9-07dc918062e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{2}\\ln(K|x|)" :db/id #edb/ref 17592186485693} :answer-field/id #uuid "9c284cce-bd2c-5191-907a-2655b2eab8fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485681}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3804d021-7f16-5da7-b098-000b906fd834" :question/problem "What is the antiderivative of $\\frac{19}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{19}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{19}{2x}\\text{d}x & =\\frac{19}{2}\\int \\frac{1}{x}\\text{d}x \\\\  & =\\frac{19}{2}\\ln|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=\\frac{19}{2}\\ln K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $\\frac{19}{2}\\ln|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{19}{2x}\\text{d}x & =\\frac{19}{2}\\ln|x|+\\frac{19}{2}\\ln K \\\\  & =\\frac{19}{2}(\\ln|x|+\\ln K) \\\\  & =\\frac{19}{2}\\ln(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86bdb749-6964-56bf-886e-2406ea9390fe" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{5}{2x}+\\ln(5K|x|)" :db/id #edb/ref 17592186485674} {:answer/id #uuid "9c50f0b4-82d0-5208-9c17-960f9214e291" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{25}{4x}+5\\ln(K|x|)" :db/id #edb/ref 17592186485682} {:answer/id #uuid "ab800146-0d13-5760-8d30-c384e390d612" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{25}{4x}+\\ln(5K|x|)" :db/id #edb/ref 17592186485685} {:answer/id #uuid "abdfc4a5-3f23-5bfa-bbb0-0e2b9637518a" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{5}{2x}+5\\ln(K|x|)" :db/id #edb/ref 17592186485686} {:answer/id #uuid "c0d7eafc-c8a2-51db-99ad-6b6307a44727" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{5}{2x}+5\\ln(K|x|)" :db/id #edb/ref 17592186485691}] :answer-field/correct {:answer/id #uuid "9c50f0b4-82d0-5208-9c17-960f9214e291" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{25}{4x}+5\\ln(K|x|)" :db/id #edb/ref 17592186485682} :answer-field/id #uuid "11110ce0-9a9b-5d32-ac92-6783feda80fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485655}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "945acb46-c0e6-527b-9ef1-1687fa58f759" :question/problem "What is the antiderivative of ${(1+\\frac{5}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{5}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{5}{x}+\\frac{25}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+5\\int \\frac{1}{x}\\,\\text{d}x+\\frac{25}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+5\\ln|x|+\\frac{25{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+5\\ln|x|-\\frac{25}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=5\\ln K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $5\\ln|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{5}{2x})}^{2}\\text{d}x & =x-\\frac{25}{4x}+5\\ln|x|+5\\ln K \\\\  & =x-\\frac{25}{4x}+5(\\ln|x|+\\ln K) \\\\  & =x-\\frac{25}{4x}+5\\ln(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485683 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e5c4a7-4613-53bc-8ea6-cb64e6e1a292" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{31}{2x}+31\\ln(K|x|)" :db/id #edb/ref 17592186485657} {:answer/id #uuid "3a2c94aa-08e7-5643-a702-d10e8b43ef6f" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{961}{4x}+\\ln(31K|x|)" :db/id #edb/ref 17592186485662} {:answer/id #uuid "421528db-2521-5704-90c2-e7762a53ea69" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{961}{4x}+31\\ln(K|x|)" :db/id #edb/ref 17592186485664} {:answer/id #uuid "89fa9854-3450-5047-8f17-80d1d324a209" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{31}{2x}+\\ln(31K|x|)" :db/id #edb/ref 17592186485675} {:answer/id #uuid "d8cb3738-dfa2-5c51-b6cb-012ad668eefb" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{31}{2x}+31\\ln(K|x|)" :db/id #edb/ref 17592186485695}] :answer-field/correct {:answer/id #uuid "421528db-2521-5704-90c2-e7762a53ea69" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{961}{4x}+31\\ln(K|x|)" :db/id #edb/ref 17592186485664} :answer-field/id #uuid "e6ae0fca-5dbf-5b74-9877-d3140374a28a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485700}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a66a11fb-1259-5ab3-8c0c-9c8425b6d0e8" :question/problem "What is the antiderivative of ${(1+\\frac{31}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{31}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{31}{x}+\\frac{961}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+31\\int \\frac{1}{x}\\,\\text{d}x+\\frac{961}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+31\\ln|x|+\\frac{961{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+31\\ln|x|-\\frac{961}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=31\\ln K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $31\\ln|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{31}{2x})}^{2}\\text{d}x & =x-\\frac{961}{4x}+31\\ln|x|+31\\ln K \\\\  & =x-\\frac{961}{4x}+31(\\ln|x|+\\ln K) \\\\  & =x-\\frac{961}{4x}+31\\ln(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bdc35e3-629d-5843-a884-ae2758caddde" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{225}{4x}+\\ln(15K|x|)" :db/id #edb/ref 17592186485656} {:answer/id #uuid "3df98d15-4fa7-50ac-ac08-9b30b8a001f2" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{15}{2x}+15\\ln(K|x|)" :db/id #edb/ref 17592186485663} {:answer/id #uuid "698afe3c-54a3-5fed-97c6-8e1039b93f8d" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{15}{2x}+\\ln(15K|x|)" :db/id #edb/ref 17592186485670} {:answer/id #uuid "6a87f713-9f26-5f94-a328-4069c9403f8d" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{15}{2x}+15\\ln(K|x|)" :db/id #edb/ref 17592186485671} {:answer/id #uuid "965e0b2c-0e72-5fa6-8ab7-ba7ff03d5a0a" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{225}{4x}+15\\ln(K|x|)" :db/id #edb/ref 17592186485680}] :answer-field/correct {:answer/id #uuid "965e0b2c-0e72-5fa6-8ab7-ba7ff03d5a0a" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{225}{4x}+15\\ln(K|x|)" :db/id #edb/ref 17592186485680} :answer-field/id #uuid "bdf9924d-2986-55ef-9f43-203ca40cf77c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485690}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b39b559e-6dd3-51ab-936e-f0e9c4871293" :question/problem "What is the antiderivative of ${(1+\\frac{15}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{15}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{15}{x}+\\frac{225}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+15\\int \\frac{1}{x}\\,\\text{d}x+\\frac{225}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+15\\ln|x|+\\frac{225{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+15\\ln|x|-\\frac{225}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=15\\ln K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $15\\ln|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{15}{2x})}^{2}\\text{d}x & =x-\\frac{225}{4x}+15\\ln|x|+15\\ln K \\\\  & =x-\\frac{225}{4x}+15(\\ln|x|+\\ln K) \\\\  & =x-\\frac{225}{4x}+15\\ln(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc7c798-c28f-5e72-9322-1ee1aac6135f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\ln(K|x|)" :db/id #edb/ref 17592186485659} {:answer/id #uuid "4e6a9723-c590-529f-a3c3-7b89d54f579e" :answer/type {:db/ident :answer.type/math} :answer/value "13x-\\ln(K|x|)" :db/id #edb/ref 17592186485665} {:answer/id #uuid "50b043d7-e27f-504b-a749-c29451b309d6" :answer/type {:db/ident :answer.type/math} :answer/value "13x+\\ln(K|x|)" :db/id #edb/ref 17592186485666} {:answer/id #uuid "71ef7a94-585b-5a3c-9918-618922f2ff8f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-\\ln(K|x|)" :db/id #edb/ref 17592186485673} {:answer/id #uuid "ab14b5fb-4ed1-5e1c-b145-ce07c95f72d7" :answer/type {:db/ident :answer.type/math} :answer/value "13x+\\ln(|x|+K)" :db/id #edb/ref 17592186485684}] :answer-field/correct {:answer/id #uuid "4e6a9723-c590-529f-a3c3-7b89d54f579e" :answer/type {:db/ident :answer.type/math} :answer/value "13x-\\ln(K|x|)" :db/id #edb/ref 17592186485665} :answer-field/id #uuid "5f4bba06-ef88-5964-ab10-7440bec05827" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485668}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cff54124-30c2-5574-bb39-923719275223" :question/problem "What is the antiderivative of $\\frac{13x-1}{x}?$" :question/worked-solution "We separate the integrand into the sum of two fractions so that we can simplify each term. So, we get\n\n$$\n\\begin{aligned}\\int \\frac{13x-1}{x}\\,\\text{d}x & =\\int (\\frac{13x}{x}-\\frac{1}{x})\\,\\text{d}x \\\\  & =\\int (13-\\frac{1}{x})\\,\\text{d}x \\\\  & =13\\int \\,\\text{d}x-\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =13x-\\ln|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\ln K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\ln|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{13x-1}{x}\\,\\text{d}x & =13x-\\ln|x|+C \\\\  & =13x-\\ln|x|-\\ln K \\\\  & =13x-(\\ln|x|+\\ln K) \\\\  & =13x-\\ln(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9601d56b-13dc-5c3b-b8fc-ac4cf5a63f1d" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{13}{2x}+13\\ln(K|x|)" :db/id #edb/ref 17592186485679} {:answer/id #uuid "b21f79af-fa86-52c4-a824-e9a0f9084cc7" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{13}{2x}+13\\ln(K|x|)" :db/id #edb/ref 17592186485687} {:answer/id #uuid "e1269c07-5445-54f2-bdda-222c26fdc846" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{169}{4x}+\\ln(13K|x|)" :db/id #edb/ref 17592186485697} {:answer/id #uuid "e26ad8e0-8171-5fa1-8ab4-1edce19f58de" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{169}{4x}+13\\ln(K|x|)" :db/id #edb/ref 17592186485698} {:answer/id #uuid "fbf3f2a0-70ac-5190-980d-d5f380321b26" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{13}{2x}+\\ln(13K|x|)" :db/id #edb/ref 17592186485702}] :answer-field/correct {:answer/id #uuid "e26ad8e0-8171-5fa1-8ab4-1edce19f58de" :answer/type {:db/ident :answer.type/math} :answer/value "x-\\frac{169}{4x}+13\\ln(K|x|)" :db/id #edb/ref 17592186485698} :answer-field/id #uuid "27a6c73a-a091-5778-bc39-461ebe695de9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485658}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e28c721a-f526-5bc6-baf1-6b2e23923597" :question/problem "What is the antiderivative of ${(1+\\frac{13}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{13}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{13}{x}+\\frac{169}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+13\\int \\frac{1}{x}\\,\\text{d}x+\\frac{169}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+13\\ln|x|+\\frac{169{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+13\\ln|x|-\\frac{169}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=13\\ln K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $13\\ln|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{13}{2x})}^{2}\\text{d}x & =x-\\frac{169}{4x}+13\\ln|x|+13\\ln K \\\\  & =x-\\frac{169}{4x}+13(\\ln|x|+\\ln K) \\\\  & =x-\\frac{169}{4x}+13\\ln(K|x|).\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] [{:db/id #edb/ref 17592186184350 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183946 :question/id #uuid "ab4772a2-f980-5ad7-a377-34e34b95be83" :question/math-academy-id "e-14403" :question/problem "Calculate  $\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x.$" :question/worked-solution "Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \n\n$$\n\\dfrac{ \\textrm{d}u}{ \\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\\int {x^3\\,{3^{1-x^4}} }\\, \\textrm{d}x \n&=\\int {{3^{1-x^4}}\\cdot x^3 }\\, \\textrm{d}x \\[5pt]\n&=  \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u\\[5pt]\n                                                     &= -\\dfrac{1}{4}\\int {3^{u}}  \\textrm{d}u\\[5pt]\n                                                     &=  -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C\\[5pt]\n                                                     &=   -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C.\n}\n$$"} :knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/questions [{:db/id #edb/ref 17592186184746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82507a0e-9640-5f91-baac-ab6e9c5da3e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{3x}}{2\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186295968} {:answer/id #uuid "90098dd5-289f-547e-b363-0c0f0a9af66e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296038} {:answer/id #uuid "b0881961-d42a-52bd-baff-db91f2644d0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{3\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296198} {:answer/id #uuid "bd10d05c-0dcf-50d3-bed0-8065b29b1c8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296263} {:answer/id #uuid "ddd37029-5f4f-5d4c-b32f-36f0f45b0933" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296446}] :answer-field/correct {:answer/id #uuid "ddd37029-5f4f-5d4c-b32f-36f0f45b0933" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :db/id #edb/ref 17592186296446} :answer-field/id #uuid "f130d306-f973-5ac4-a801-416349e0b6ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297127}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a383a3e5-774c-580f-ac7a-6d64870e5f9c" :question/math-academy-id "q-31420" :question/problem "Calculate the integral $\\int x{8}^{3{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{8}^{3{x}^{2}}\\,\\text{d}x & =\\int {8}^{3{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\int {8}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int {8}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\frac{{8}^{u}}{\\operatorname{ln}⁡8}+C \\\\  & =\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b629301-1067-56d3-ab58-ad1143497b16" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3^{x^{3} - 5}}{2} + C" :db/id #edb/ref 17592186183632} {:answer/id #uuid "c2980156-3e48-54e4-ace1-4a5f3a97bdce" :answer/type {:db/ident :answer.type/math} :answer/value "3^{x^{3} - 5} + C" :db/id #edb/ref 17592186183633} {:answer/id #uuid "c82dea64-4532-5248-a8cd-de11704b9a4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3^{x^{3} - 5}}{2\\ln 3} + C" :db/id #edb/ref 17592186183634} {:answer/id #uuid "22ab9fe2-60bf-59f9-90a4-89daca871a10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3^{x^{3} - 5}}{\\ln 3} + C" :db/id #edb/ref 17592186183635} {:answer/id #uuid "439eb146-c976-58e3-a26b-dfdd872160f4" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 3^{x^{3} - 5} + C" :db/id #edb/ref 17592186183636}] :answer-field/id #uuid "2fbafaee-57dd-530a-9c31-0773ad8a574d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183631}] :question/id #uuid "33727dd7-f9f9-5003-bd0e-141b31536141" :question/math-academy-id "q-73800" :question/problem "Calculate the integral $\\displaystyle \\int3x^{2}3^{x^{3} - 5}dx$."} {:db/id #edb/ref 17592186290291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d80916-0404-5166-b211-35cc9c85ea75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {4}^{{x}^{3}/5}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288269} {:answer/id #uuid "9b48c261-f211-55b8-86ce-65dbc47a6b39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C" :db/id #edb/ref 1759218