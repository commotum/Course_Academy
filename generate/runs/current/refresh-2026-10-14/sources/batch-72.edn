.type/math} :answer/value "4\\ln|\\cos{\\left(x \\right)}|+C" :db/id #edb/ref 17592186487523} {:answer/id #uuid "73e70d84-59dd-567b-bcd8-6355ab50c465" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln|\\cos{\\left(2 x \\right)}|+C" :db/id #edb/ref 17592186487537} {:answer/id #uuid "fa5b9eed-5d22-527e-bec7-4f2a6d50a878" :answer/type {:db/ident :answer.type/math} :answer/value "4\\ln|\\sin{\\left(x \\right)}|+C" :db/id #edb/ref 17592186487552}] :answer-field/correct {:answer/id #uuid "fa5b9eed-5d22-527e-bec7-4f2a6d50a878" :answer/type {:db/ident :answer.type/math} :answer/value "4\\ln|\\sin{\\left(x \\right)}|+C" :db/id #edb/ref 17592186487552} :answer-field/id #uuid "01ef7e32-d7cb-534b-91ae-cd39a184e31c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186487518}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d12445d-3523-59d2-975c-8479b75a0de1" :question/problem "What is $\\int \\frac{4 \\cos{\\left(x \\right)}}{\\sin{\\left(x \\right)}}\\,\\text{d}x$?" :question/worked-solution "Let $u=\\sin{\\left(x \\right)},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\cos{\\left(x \\right)}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{4 \\cos{\\left(x \\right)}}{\\sin{\\left(x \\right)}}\\,\\text{d}x &= 4\\int \\frac{1}{u}\\,\\text{d}u \\\\ &= 4\\ln|u|+C \\\\ &= 4\\ln|\\sin{\\left(x \\right)}|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186487541 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12be31af-33e6-533c-b43c-df530db8a53e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln|\\cos{\\left(2 x \\right)}|+C" :db/id #edb/ref 17592186487520} {:answer/id #uuid "63550523-6b44-51dc-8b90-f25fcaa6964f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln|\\sin{\\left(x \\right)}|+C" :db/id #edb/ref 17592186487533} {:answer/id #uuid "c4d56462-2c53-5292-b5dd-9141ec