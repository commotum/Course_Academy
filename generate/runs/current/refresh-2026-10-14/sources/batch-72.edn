swer.type/math} :answer/value "\\frac{{4}^{x-7}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295291} {:answer/id #uuid "156c7585-0e2b-5c0b-a8c0-28e3ea36cf59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295392} {:answer/id #uuid "1cb5b38c-ddae-51cd-8c03-e4ec4201cdbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295432} {:answer/id #uuid "522139ab-1225-59a8-b925-e83a6e2f7dbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295740} {:answer/id #uuid "f0d4c693-b699-5083-ad7a-ed14a75b3087" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{2}+C" :db/id #edb/ref 17592186296550}] :answer-field/correct {:answer/id #uuid "522139ab-1225-59a8-b925-e83a6e2f7dbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{2\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295740} :answer-field/id #uuid "55ef16e6-ce51-5b7c-aff0-0e1c6f8cca5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296807}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e54cfe97-3d02-5434-8c76-88bdc2adef2f" :question/math-academy-id "q-31419" :question/problem "Calculate the integral $\\int x{4}^{{x}^{2}-7}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{4}^{{x}^{2}-7}\\,\\text{d}x & =\\int {4}^{{x}^{2}-7}\\cdot x\\,\\text{d}x \\\\  & =\\int {4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{{x}^{2}