n find the corresponding $y$ by substituting $x$ into the formula $y=2x+2.$\nTherefore, we obtain\n\n- if $x=0$ then $y=2(0)+2=2,$\n\n- if $x=1$ then $y=2(1)+2=4,$\n\n- if $x=2$ then $y=2(2)+2=6,$ and\n\n- if $x=3$ then $y=2(3)+2=8.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $2$ | $4$ | $6$ | $8$ |\n\nPlotting these $(x,y)$ pairs on the $xy$-plane: \n\n![](images/6b/6b2da4bfc7c768788d143999fb61e76bb3a60facffc35e430d98085b395932f7.png)\n\nFinally, connecting the points gives us a straight line. This is the graph of  $y=2x+2.$\n\n![](images/04/0400a1437f26b74feb16161cf51a88c175ee6837fe1e5d8f8785ba2bb2b9c68b.png)"} {:db/id #edb/ref 17592186497774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06fa8c2f-5b1f-5063-8e88-0b913061880c" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/30ea4f86a1a588cd617779bc001935f50b7fa358ecca86efeaf26bde27642627.png" :db/id #edb/ref 17592186497766} {:answer/id #uuid "09af78ca-b5c2-58ed-aee4-4ddfc7a7f013" :answer/type {:db/ident :answer.type/image} :answer/value "images/f3/f3b91b84281ef5b4936438c7e92935cbaf15d17ee50b33a27a7bed638391ef74.png" :db/id #edb/ref 17592186497767} {:answer/id #uuid "29968d51-b8a6-5bee-82fc-d738be24cc8b" :answer/type {:db/ident :answer.type/image} :answer/value "images/b9/b9758c660c06a62ba10ca7ced102655a3a8f376d31d9c4ef73ec9ea8b33e769b.png" :db/id #edb/ref 17592186497770} {:answer/id #uuid "7083980a-a87f-5d35-b45a-36f6cd7e349b" :answer/type {:db/ident :answer.type/image} :answer/value "images/07/07b33747d01621cb73ae464999a8d6a135f0dc579f9e50b250f34b3df9ca4783.png" :db/id #edb/ref 17592186497779} {:answer/id #uuid "f90d513b-aef2-5217-be5f-bd7b7f1eafff" :answer/type {:db/ident :answer.type/image} :answer/value "images/05/05d10ee3d2e6bc295a7d2e6b07ca726c9c11c159d74f1d81c71fce761fa4275e.png" :db/id #edb/ref 17592186497786}] :answer-field/correct {:answer/id #uuid "f90d513b-aef2-5217-be5f-bd7b7f1eafff" :answer/type {:db/ident :answer.type/image} :answer/value "images/05/05d10ee3d2e6bc295a7d2e6b07ca726c9c11c159d74f1d81c71fce761fa4275e.png" :db/id #edb/ref 17592186497786} :answer-field/id #uuid "ad570f02-ebbc-528a-ba9a-40d1735ee18e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497782}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5a903cf9-42ce-5563-9b36-303a8f1c1320" :question/problem "Copy and complete the table below and use it to determine which of the following is the graph of $y=-x-3.$.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | ---: | ---: | ---: | ---: |\n| $y$ |  |  |  |  |" :question/worked-solution "First, we fill the table. Given a value of $x,$ we can find the corresponding $y$ by substituting $x$ into the formula $y=-x-3.$ Therefore,\n\n- if $x=0$ then $y=-(0)-3=-3,$\n\n- if $x=1$ then $y=-(1)-3=-4,$\n\n- if $x=2$ then $y=-(2)-3=-5,$ and\n\n- if $x=3$ then $y=-(3)-3=-6.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $-3$ | $-4$ | $-5$ | $-6$ |\n\nWe plot these $(x,y)$ pairs on the $xy$-plane:\n\n![](images/c9/c96b7da7b073986de68a557df8a9dbde16d39566c87eb0b5ba6ac62bd40da7c4.png)\n\nFinally, connecting the points gives us a straight line. This is the graph of $y=-x-3.$\n\n![](images/05/05d10ee3d2e6bc295a7d2e6b07ca726c9c11c159d74f1d81c71fce761fa4275e.png)"} {:db/id #edb/ref 17592186497775 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "505696e7-5c70-5bfb-9d5d-53a811375cd2" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e65396cb057b7306ae81557f25d24f797e736ad37c09ddb0e67ee19c4e9ab318.png" :db/id #edb/ref 17592186497773} {:answer/id #uuid "685c2324-6319-5bc5-b432-4f7efc03eacb" :answer/type {:db/ident :answer.type/image} :answer/value "images/db/dbddb21434456cdcb99c4ba0660c65615c97538ccbdcf2d6057e855d0d30f8f9.png" :db/id #edb/ref 17592186497778} {:answer/id #uuid "816e9948-7eb3-5b5d-9fb6-b4ad3fb7ff4e" :answer/type {:db/ident :answer.type/image} :answer/value "images/4b/4bb98a9deb3f1049e3b2eeffca7deccfefb79fd5d893b89940be52fbce397d8a.png" :db/id #edb/ref 17592186497780} {:answer/id #uuid "8497b882-b57f-5efb-b03e-5229284a8b76" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3efb14f33400cd4a6353b93e5d99a826083cca6859785d5bd5d837fb00ad302f.png" :db/id #edb/ref 17592186497781} {:answer/id #uuid "e100f2db-5cdc-57b9-ba80-cfeb83c61519" :answer/type {:db/ident :answer.type/image} :answer/value "images/54/54c37e2aadc0f1a3db8ec1f39905b1e694804df7680999079f1d2a2017c09794.png" :db/id #edb/ref 17592186497785}] :answer-field/correct {:answer/id #uuid "8497b882-b57f-5efb-b03e-5229284a8b76" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3efb14f33400cd4a6353b93e5d99a826083cca6859785d5bd5d837fb00ad302f.png" :db/id #edb/ref 17592186497781} :answer-field/id #uuid "39f305ae-b441-5bc6-833a-ae8108df72ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497771}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5da1545d-7bf4-538f-94f3-464d21187a82" :question/problem "Copy and complete the table below and use it to determine which of the following is the graph of $y=2x-6.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ |  |  |  |  |" :question/worked-solution "First, we fill the table. Given a value of $x$ we can find the corresponding $y$ by substituting $x$ into the formula $y=2x-6.$\nTherefore, we obtain\n\n- if $x=0$ then $y=2(0)-6=-6,$\n\n- if $x=1$ then $y=2(1)-6=-4,$\n\n- if $x=2$ then $y=2(2)-6=-2,$ and\n\n- if $x=3$ then $y=2(3)-6=0.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-4$ | $-2$ | $0$ |\n\nPlotting these $(x,y)$ pairs on the $xy$-plane: \n\n![](images/95/958c5a848a09e43832324b8afb000348c7630cd2c42e99a51215d48d9895a00e.png)\n\nFinally, connecting the points gives us a straight line. This is the graph of  $y=2x-6.$\n\n![](images/3e/3efb14f33400cd4a6353b93e5d99a826083cca6859785d5bd5d837fb00ad302f.png)"} {:db/id #edb/ref 17592186497777 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b68311-0695-52e7-984f-b1f413574531" :answer/type {:db/ident :answer.type/image} :answer/value "images/f5/f59cdf977a5aa60bea4bbe522a20e29c3d13caa13ce178b5038569da0282bf04.png" :db/id #edb/ref 17592186497768} {:answer/id #uuid "10291a72-b265-5a7e-ae36-03727e2c077a" :answer/type {:db/ident :answer.type/image} :answer/value "images/d8/d89b7a9495d61d6c67332c05aa99d35957782b600b447bb0a70dbf3595857f83.png" :db/id #edb/ref 17592186497769} {:answer/id #uuid "3cb40a26-7dd0-53a3-8f8b-50d6ae6b03aa" :answer/type {:db/ident :answer.type/image} :answer/value "images/44/44b8f095ef9aca54e6215b1b61c9fad562dd54b0f00b7e9b8e2efdd904dd83e6.png" :db/id #edb/ref 17592186497772} {:answer/id #uuid "c411d8f7-79b2-5537-91be-c623daad8c30" :answer/type {:db/ident :answer.type/image} :answer/value "images/15/15bdb2e49885cb6bc9ea7aeccff0cb3227504f5b122f0f16e51bc2e6154d01c6.png" :db/id #edb/ref 17592186497783} {:answer/id #uuid "dcebd751-9faf-5113-a03b-26d02cbb100e" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c62998935843f79fcf2007edbfe243071b75c9ceb63babf46cad3c6aa507291c.png" :db/id #edb/ref 17592186497784}] :answer-field/correct {:answer/id #uuid "3cb40a26-7dd0-53a3-8f8b-50d6ae6b03aa" :answer/type {:db/ident :answer.type/image} :answer/value "images/44/44b8f095ef9aca54e6215b1b61c9fad562dd54b0f00b7e9b8e2efdd904dd83e6.png" :db/id #edb/ref 17592186497772} :answer-field/id #uuid "645e1d5a-90c9-50c4-b1ae-f7aff3a3dba1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497776}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67365bc6-453f-5a19-82a4-9817c6e05a99" :question/problem "Copy and complete the table below and use it to determine which of the following is the graph of $y=x-6.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ |  |  |  |  |" :question/worked-solution "First, we fill the table. Given a value of $x,$ we can find the corresponding $y$ by substituting $x$ into the formula $y=x-6.$ Therefore,\n\n- if $x=0$ then $y=(0)-6=-6,$\n\n- if $x=1$ then $y=(1)-6=-5,$\n\n- if $x=2$ then $y=(2)-6=-4,$ and\n\n- if $x=3$ then $y=(3)-6=-3.$\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $y$ | $-6$ | $-5$ | $-4$ | $-3$ |\n\nWe plot these $(x,y)$ pairs on the $xy$-plane:\n\n![](images/99/99188f2a0f8de0054a6375a88a11242bea7e4799cc17552cd9ba0dd00d5a0788.png)\n\nFinally, connecting the points gives us a straight line. This is the graph of $y=x-6.$\n\n![](images/44/44b8f095ef9aca54e6215b1b61c9fad562dd54b0f00b7e9b8e2efdd904dd83e6.png)"}] :knowledge-point/title "Plotting a Line Using a Table"}] [{:db/id #edb/ref 17592186054695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054603 :question/id #uuid "4aad1578-4134-5f25-88cb-8ab4631257ee" :question/math-academy-id "e-984" :question/problem "Sketch the graph of $y=-\\dfrac{1}{2}x+3.$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\nIt is often easiest to pick one of the points to have an $x$-coordinate of $x=0.$ So, for the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}x+3 \\\\  & =-\\frac{1}{2}(0)+3 \\\\  & =0+3 \\\\  & =3.\\end{aligned}\n$$\n\nSo, the first point is $(0,3).$\n\nFor the second point, let's choose $x=4.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}x+3 \\\\  & =-\\frac{1}{2}(4)+3 \\\\  & =-2+3 \\\\  & =1.\\end{aligned}\n$$\n\nSo, the second point is $(4,1).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-\\dfrac{1}{2}x+3.$\n\n![](images/36/36689081acaacb24a09826c3927388697e77d92caeca900d053d33d0f99d2b8c.png)"} :knowledge-point/id #uuid "ebeb4e5a-adbe-5a94-b05d-61933a687892" :knowledge-point/questions [{:db/id #edb/ref 17592186055369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0a3946e-4d98-5306-b4b2-f900a60e9abf" :answer/type {:db/ident :answer.type/image} :answer/value "images/ff/ff2f94655de95a7a5099423b3d0dbbb9bb6e64f39aca105eb8cab1366f547064.png" :db/id #edb/ref 17592186053452} {:answer/id #uuid "f18a5b0b-4150-51bf-ae4a-e1621ffc7785" :answer/type {:db/ident :answer.type/image} :answer/value "images/8b/8bc5f7358456a111f29f900e8148e60a0fede85ca9b951e3d752ca1e1a800e6a.png" :db/id #edb/ref 17592186053453} {:answer/id #uuid "15e16ea3-e05e-53e9-8ea7-ae8c5c48c14e" :answer/type {:db/ident :answer.type/image} :answer/value "images/7e/7ed9a41dc38df65a985785c318e5d0407a43615cef7dfa0c60ad454099a089a9.png" :db/id #edb/ref 17592186053454} {:answer/id #uuid "2fb80dc2-f93b-5a21-82fe-a63bca5f9b7c" :answer/type {:db/ident :answer.type/image} :answer/value "images/0c/0cfc4bba4867b40c4c38b0886c37bb5c4cd64d293530ece7c67cdb6349134013.png" :db/id #edb/ref 17592186053455} {:answer/id #uuid "3f60c829-2580-5c06-aab1-c1c58924a888" :answer/type {:db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186053456}] :answer-field/id #uuid "c2b4ae38-d4b8-5d3e-8141-6ba4d4385b82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053451}] :question/id #uuid "28feb85a-a0a4-55cd-b26b-1f144b97ee7f" :question/math-academy-id "q-54286" :question/problem "Which of the following graphs shows the line $y = 2x - 4$?"} {:db/id #edb/ref 17592186055430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b72f52d3-7c21-5555-bf79-a5e32ea63dc5" :answer/type {:db/ident :answer.type/image} :answer/value "images/9e/9e2977ee1faa5dde2d1bf3a427037aac75b2692486bdcb724356452765c8b661.png" :db/id #edb/ref 17592186053818} {:answer/id #uuid 