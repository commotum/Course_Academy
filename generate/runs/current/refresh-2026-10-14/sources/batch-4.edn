\nFinally, connecting the points gives us a straight line. This is the graph of $y=x-2.$\n\n![](images/89/893dba533e0afffe05f9603293355ccf38b2723fcd91608ea03fe321e26a0d5f.png)"} {:db/id #edb/ref 17592186055429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8012f237-f895-59fa-8270-6503cec53a98" :answer/type {:db/ident :answer.type/image} :answer/value "images/33/33840084a698d261095927ca6ca12e85673665e3dc00264e1d21722a60c16fa4.png" :db/id #edb/ref 17592186053812} {:answer/id #uuid "9ce4d676-af93-589c-ba26-6402379e878e" :answer/type {:db/ident :answer.type/image} :answer/value "images/89/893dba533e0afffe05f9603293355ccf38b2723fcd91608ea03fe321e26a0d5f.png" :db/id #edb/ref 17592186053813} {:answer/id #uuid "d1b7f4ba-210d-5ab9-a5f8-a2904e7fedf2" :answer/type {:db/ident :answer.type/image} :answer/value "images/41/416bc4e441bac223991d615915c282fed3ecae8ececd4ce04433a1eacfad47f2.png" :db/id #edb/ref 17592186053814} {:answer/id #uuid "f0e4e655-149e-5749-b055-169473ebdae6" :answer/type {:db/ident :answer.type/image} :answer/value "images/7e/7e1e94d8d56f09e4c5d2b47cbd04ec99d51f97465d8144683f16a5689fd6324c.png" :db/id #edb/ref 17592186053815} {:answer/id #uuid "40c8bec8-cf09-50fd-97ef-11e1dc5e4980" :answer/type {:db/ident :answer.type/image} :answer/value "images/ea/eaf735f72849b82e92f7baf0d991f3e024e013b66d9813d4e0d5f3a87632c901.png" :db/id #edb/ref 17592186053816}] :answer-field/id #uuid "423e8e65-dd75-5e41-82c6-09a914060bee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053811}] :question/id #uuid "4cd916a5-f5b2-585b-bea7-8dda3f5e10d9" :question/math-academy-id "q-59676" :question/problem "Copy and complete the table below and use it to determine which of the following is the graph of $y =-x + 1$.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | ---: | ---: | ---: | ---: |\n| $y$ |  |  |  |  |"} {:db/id #edb/ref 17592186490257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3