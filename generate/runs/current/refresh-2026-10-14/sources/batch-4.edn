 #edb/ref 17592186489978} {:answer/id #uuid "eb6bc548-b54d-5ef3-9f0e-1da8be1a265c" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b2bb0b6f019af476eae3e76adb7ac2ef4745a6c4bdeae24cd4a40320b23f882b.png" :db/id #edb/ref 17592186490024} {:answer/id #uuid "fba812d1-3f67-596b-b851-fa0314c2cb48" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e6aa0661b20e4d114abb475dfc3cba6180bed5155c6051262a68c31110408a18.png" :db/id #edb/ref 17592186490062}] :answer-field/correct {:answer/id #uuid "eb6bc548-b54d-5ef3-9f0e-1da8be1a265c" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b2bb0b6f019af476eae3e76adb7ac2ef4745a6c4bdeae24cd4a40320b23f882b.png" :db/id #edb/ref 17592186490024} :answer-field/id #uuid "d17d82c6-1a23-5c4e-bb97-55ab46a58407" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490184}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3f93db21-c74e-5e95-a404-6814f4df05d9" :question/math-academy-id "q-102054" :question/problem "Which of the following graphs shows the line $y=-2x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-2x \\\\  & =-2(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-2x \\\\  & =-2(1) \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the second point is $(1,-2).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-2x.$ \n\n![](images/c6/c632cc2770958b5d73f6e143de0b72d19b2099f9f656ff34f273d88acc4f9cb4.png)"} {:db/id #edb/ref 17592186490285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1395c3db-95d9-5639-b9d4-30e6fc772906" :answer/type {:db/ident :answer.type/image} :answer/value "images/0c/0cfc4bba4867b40c4c38b0886c37bb5c4cd64d293530ece7c67cdb6349134013.png" :db/id #edb/ref 17592186489558} {:answer/id #uuid "3b2e4dbc-417e-567d-87f0-6c258efaf698" :answer/type {:db/ident :answer.type/image} :answer/value "images/9e/9e2977ee1faa5dde2d1bf3a427037aac75b2692486bdcb724356452765c8b661.png" :db/id #edb/ref 17592186489648} {:answer/id #uuid "73631664-2efe-5676-8831-b04bad13e778" :answer/type {:db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186489784} {:answer/id #uuid "7a5037ef-50db-500f-ac5f-db15fcc0b6b8" :answer/type {:db/ident :answer.type/image} :answer/value "images/24/24d776784e54d7e38452f9b548051d0a2015e119f7c701ac74be87ef3dbb42f9.png" :db/id #edb/ref 17592186489794} {:answer/id #uuid "c346fa15-1ab9-5397-875e-59d3c4e305eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/af/afb86fd4a7ffd591dfbbc6e8ee837b33b943972212b04b15f9040b310b0abdba.png" :db/id #edb/ref 17592186489936}] :answer-field/correct {:answer/id #uuid "73631664-2efe-5676-8831-b04bad13e778" :answer/type {:db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186489784} :answer-field/id #uuid "4ceda208-3258-5df9-a5ee-0311a1f10448" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490120}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a5b958d4-e62e-522f-9fd3-554270dc7fdb" :question/math-academy-id "q-109055" :question/problem "Which of the following graphs shows the line $y=2-\\frac{1}{2}x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-\\frac{1}{2}x \\\\  & =2-\\frac{1}{2}(0) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the first point is $(0,2).$\n\n- For the second point, we will let the $x$-coordinate be $x=8.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-\\frac{1}{2}x \\\\  & =2-\\frac{1}{2}(8) \\\\  & =2-4 \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the second point is $(8,-2).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=2-\\frac{1}{2}x.$\n\n![](images/a8/a8c562212687c848e2de25b757f59acd70467a085ae2e0713fbeafa355ad5bb5.png)"} {:db/id #edb/ref 17592186497745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6c1d0d-4c00-5981-9219-0c8e265c4f69" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7603626fb60eb9cae8ed8155a1eb81d2a66a3c239468c93ccf7c0f0530a5193.png" :db/id #edb/ref 17592186497747} {:answer/id #uuid "468e40cd-9cf9-5a6b-96e2-0dee3bac3ebb" :answer/type {:db/ident :answer.type/image} :answer/value "images/ac/ac2fb8cd0a1e808bc599067860a3bf1af50a167e4ae71c8ad4d8a9329ebe6cb0.png" :db/id #edb/ref 17592186497750} {:answer/id #uuid "6f98bc0a-745d-5fe8-9adb-75bc94c5e580" :answer/type {:db/ident :answer.type/image} :answer/value "images/53/53c3f8c77c96b0925ce788a07b102555a1fca916d8ea20fd47fe6894c2eb46b5.png" :db/id #edb/ref 17592186497754} {:answer/id #uuid "8f0741d7-a6b1-5299-943c-c9df2fd77321" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b2bb0b6f019af476eae3e76adb7ac2ef4745a6c4bdeae24cd4a40320b23f882b.png" :db/id #edb/ref 17592186497757} {:answer/id #uuid "fa366fab-7ce5-5d4f-8d88-5e08fc12f31f" :answer/type {:db/ident :answer.type/image} :answer/value "images/5f/5fcdd5b3c95340859bbb6f30dd3e80aa7396762e91187541bf68f64e2b21c1b3.png" :db/id #edb/ref 17592186497763}] :answer-field/correct {:answer/id #uuid "1e6c1d0d-4c00-5981-9219-0c8e265c4f69" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7603626fb60eb9cae8ed8155a1eb81d2a66a3c239468c93ccf7c0f0530a5193.png" :db/id #edb/ref 17592186497747} :answer-field/id #uuid "714f5f25-99f5-58fb-9ddf-b6fc9c8a48c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497755}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1b239726-9ec0-5ecb-8b93-7c8edf0b2f3f" :question/problem "Which of the following graphs shows the line $y=-4x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-4x \\\\  & =-4(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-4x \\\\  & =-4(1) \\\\  & =-4.\\end{aligned}\n$$\n\nSo, the second point is $(1,-4).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-4x.$ \n\n![](images/8b/8b008b94eebbd24ae51670447848ce2d644c067d43dd92d72de85b048358cc54.png)"} {:db/id #edb/ref 17592186497762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197e6448-d4b8-50c4-8753-532544dcd499" :answer/type {:db/ident :answer.type/image} :answer/value "images/99/992d82dfeac6b0a73453363ca57efaa9fe70b2b5ccd7cd1712b5772f09c224d2.png" :db/id #edb/ref 17592186497744} {:answer/id #uuid "42221fb0-f700-5e55-a7e6-33f0cb67bcb9" :answer/type {:db/ident :answer.type/image} :answer/value "images/8a/8a82731b726d091769fdf10ca7f5d7ee87816cd490f933aaf1fc2c19c0701603.png" :db/id #edb/ref 17592186497749} {:answer/id #uuid "4ac7786b-a678-552f-b339-f52f193863ee" :answer/type {:db/ident :answer.type/image} :answer/value "images/8e/8ef5652a5d1a90b6874dc19a87b7109fc2144507a587fb1daab19c0c3442d4df.png" :db/id #edb/ref 17592186497751} {:answer/id #uuid "ad159fd3-feff-5d67-88af-d4e81768184a" :answer/type {:db/ident :answer.type/image} :answer/value "images/b3/b3be73566253173f2ca88649fd585cced2cab7cddc27be7c40eeae9d8db2cc09.png" :db/id #edb/ref 17592186497759} {:answer/id #uuid "d3f0b6a4-03c2-5777-8ad1-670384f66a6c" :answer/type {:db/ident :answer.type/image} :answer/value "images/0d/0d517f4c1af2fbd48ec41131ce7dec1aeb4d2c50514e53360ab043a4daa93552.png" :db/id #edb/ref 17592186497761}] :answer-field/correct {:answer/id #uuid "197e6448-d4b8-50c4-8753-532544dcd499" :answer/type {:db/ident :answer.type/image} :answer/value "images/99/992d82dfeac6b0a73453363ca57efaa9fe70b2b5ccd7cd1712b5772f09c224d2.png" :db/id #edb/ref 17592186497744} :answer-field/id #uuid "24d238d3-c42b-5a24-b6da-36a8047d399e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497748}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e9992e41-e63d-5336-a605-48b1d684791a" :question/problem "Which of the following graphs shows the line $y=-3x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-3x \\\\  & =-3(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-3x \\\\  & =-3(1) \\\\  & =-3.\\end{aligned}\n$$\n\nSo, the second point is $(1,-3).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-3x.$ \n\n![](images/08/08e854b04d47ff670b197a2a0c7b51c13eb135626e0ed6cdfd24368d4032f259.png)"} {:db/id #edb/ref 17592186497764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc17c22-f348-5c67-921e-bb49f7e4bc08" :answer/type {:db/ident :answer.type/image} :answer/value "images/af/afb86fd4a7ffd591dfbbc6e8ee837b33b943972212b04b15f9040b310b0abdba.png" :db/id #edb/ref 17592186497746} {:answer/id #uuid "5656dea6-87b8-5765-a05d-162629ac3306" :answer/type {:db/ident :answer.type/image} :answer/value "images/39/39ae505504b452e87f70c4b555914b597ff0d3859f54f1f4d2ed5516c73131da.png" :db/id #edb/ref 17592186497752} {:answer/id #uuid "59705c30-8f9f-56b2-8c1d-4816e1357d09" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c4d21e0fdbdb082c1efdd50936da2cd8c131be9b5ac3fa0fa85a73f8c11cf48.png" :db/id #edb/ref 17592186497753} {:answer/id #uuid "a43ac8a2-cf32-55c4-b2d4-693e23dc22b3" :answer/type {:db/ident :answer.type/image} :answer/value "images/d1/d17e0a44ef03d6110f031a8ab6f0bf63b478a263754bbab63124e880546aef28.png" :db/id #edb/ref 17592186497758} {:answer/id #uuid "cd48e67e-3c17-53e8-a38a-e16bd3b4647f" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c7577f7033f36315d50748424d7a8db635e9aecd4c88c9ed4626f3294bc6c2b.png" :db/id #edb/ref 17592186497760}] :answer-field/correct {:answer/id #uuid "59705c30-8f9f-56b2-8c1d-4816e1357d09" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c4d21e0fdbdb082c1efdd50936da2cd8c131be9b5ac3fa0fa85a73f8c11cf48.png" :db/id #edb/ref 17592186497753} :answer-field/id #uuid "77551351-5d0a-512a-acd9-8abceb71136c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497756}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ffd546da-09fc-5649-b60d-749bd09256a6" :question/problem "Which of the following graphs shows the line $y=-1x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-1x \\\\  & =-1(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1x \\\\  & =-1(1) \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the second point is $(1,-1).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-1x.$ \n\n![](images/73/7322801cf231391f58d39f2fad42b779e04fc1b81b686bcb3291ebfee5651226.png)"}] :knowledge-point/title "Sketching a Line Using Two Points"}] [{:db/id #edb/ref 17592186064172 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064050 :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/math-academy-id "e-380" :question/problem "Calculate $\\displaystyle \\int -6(7^x) \\, \\textrm d x.$" :question/worked-solution "First, we factor out the constant $-6.$ Then, we integrate the exponential function, and get\n\n$$\n\\eqalign{\n\\int (-6)7^x  \\, \\textrm d x   \n&= -6\\int 7^x\\,\\textrm{d}x\\\n&=-6 \\cdot \\dfrac{7^x}{\\ln 7} + C.\n}\n$$"} :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/questions [{:db/id #edb/ref 17592186064732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f91348-41c4-59da-9054-29ca395a2dff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\ln x} + C" :db/id #edb/ref 17592186062450} {:answer/id #uuid "0c1f6d71-03b1-5b2e-88f6-fb297b2ed172" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln x}{\\ln 5} + C" :db/id #edb/ref 17592186062451} {:answer/id #uuid "36f6ac37-51eb-57a2-a3ff-6f122cc6d6cb" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot \\frac{4^{x}}{\\ln 5} + C" :db/id #edb/ref 17592186062452} {:answer/id #uuid "5ac5273f-b429-5937-9cf1-d1c7eda2cfb6" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cdot \\frac{5^{\\ln x}}{\\ln 5} + C" :db/id #edb/ref 17592186062453} {:answer/id #uuid "6a2714d6-38ad-52bb-bd65-61cbd0d301e9" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cdot \\frac{5^{x}}{\\ln 5} + C" :db/id #edb/ref 17592186062454}] :answer-field/id #uuid "98e96cde-6df7-5835-82c7-e2a56458c62a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062449}] :question/id #uuid "e19a3f4c-ed35-54ad-b148-0361a3082be0" :question/math-academy-id "q-31248" :question/problem "What is $\\displaystyle \\int4 \\cdot 5^{x}dx$?"} {:db/id #edb/ref 17592186064932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e9e8cc-7e2c-5b9c-8895-6a0d01a94483" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{ln⁡3}+C" :db/id #edb/ref 17592186333213} {:answer/id #uuid "2550874f-8ee9-5a21-ad79-124324b76991" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡({3}^{x})+C" :db/id #edb/ref 17592186333335} {:answer/id #uuid "602373f3-a4ef-5989-b10a-66c28e72546b" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}ln⁡3+C" :db/id #edb/ref 17592186333867} {:answer/id #uuid "93360ddb-2f30-5402-b6bd-6562c3c2c6d4" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}+C" :db/id #edb/ref 17592186334300} {:answer/id #uuid "94f01e4b-399e-55ad-bf45-f119b26a99ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡3}+C" :db/id #edb/ref 17592186334315}] :answer-field/correct {:answer/id #uuid "18e9e8cc-7e2c-5b9c-8895-6a0d01a94483" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{ln⁡3}+C" :db/id #edb/ref 17592186333213} :answer-field/id #uuid "fb7cb00b-1c03-5bd1-8af9-27f6fe69ec11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335676}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "709a586a-cd76-5969-9f50-4116711ad7ab" :question/math-academy-id "q-66139" :question/problem "Calculate $\\int {3}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {3}^{x}\\,\\text{d}x & =\\frac{{3}^{x}}{ln⁡3}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0558a391-cdbf-584c-a0f0-8f221f341cae" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06607b0a-9d24-576c-adf1-bdc2e55f52bb" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186247482} {:answer/id #uuid "22d652bf-3b5e-5181-8f0c-7123f5c17343" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186247734} {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} {:answer/id #uuid "99a53d55-830f-55db-ac33-a12525e3cd5a" :answer/type {:db/ident :answer.type/math} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186248795}] :answer-field/correct {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} :answer-field/id #uuid "3eca50b8-7630-5d78-accd-b706994b9510" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249782}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "333b8bc2-8d50-5f18-bbc4-8fbfe08b346d" :question/math-academy-id "q-113887" :question/problem "Calculate $\\int {5}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d639fb1-5e97-552a-8900-f00ca81a7aa1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot {9}^{x}+C" :db/id #edb/ref 17592186247685} {:answer/id #uuid "4e751153-0344-5e47-bcf5-2ce3275c0e44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡9}{{9}^{x}}+C" :db/id #edb/ref 17592186248130} {:answer/id #uuid "7bfcf753-80ad-5540-ac4c-743bbdad3d0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{9}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186248511} {:answer/id #uuid "c52e14f9-6656-5f67-a272-35abe6783236" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡2}{9ln⁡x}+C" :db/id #edb/ref 17592186249175} {:answer/id #uuid "fc1db222-2e90-5213-97f5-5919e160fc92" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186249619}] :answer-field/correct {:answer/id #uuid "fc1db222-2e90-5213-97f5-5919e160fc92" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{9}^{x}}{ln⁡9}+C" :db/id #edb/ref 17592186249619} :answer-field/id #uuid "8f4bc499-d0fb-5f3a-829e-6c1ced03dc45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249923}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "763936f6-7387-5f00-bda0-da6f24c0d625" :question/math-academy-id "q-113890" :question/problem "$\\int 2\\cdot {9}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $2.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 2\\cdot {9}^{x}\\,\\text{d}x & =2\\int {9}^{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{9}^{x}}{ln⁡9}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fd8908-86c1-5758-81a1-2ec277f68aa3" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{1}{8})}^{x}ln⁡8+C" :db/id #edb/ref 17592186247614} {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} {:answer/id #uuid "5253b616-1982-56f6-8a9e-7ac1838f5f20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡8}+C" :db/id #edb/ref 17592186248162} {:answer/id #uuid "57f12027-6306-5a43-b276-eb500592f0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{ln⁡x}{{8}^{x}}+C" :db/id #edb/ref 17592186248222} {:answer/id #uuid "7f8980f3-ea7f-50a6-9c9c-7812ebfc0549" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{8}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186248544}] :answer-field/correct {:answer/id #uuid "1d42c3ea-2473-5c66-8a3d-af03c336005b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C" :db/id #edb/ref 17592186247681} :answer-field/id #uuid "8d70d61a-ae6a-57e0-bc6d-72a634f609db" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249920}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "89cd3b1f-2f20-5813-8f46-6c4d05bd7fcb" :question/math-academy-id "q-113893" :question/problem "Calculate $\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {(\\frac{1}{8})}^{x}\\,\\text{d}x & =\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C\\end{aligned}\n$$\n\nUsing the laws of logarithms, we have that\n\n$$\n\\begin{aligned}ln⁡(\\frac{1}{8}) & =ln⁡1-ln⁡8 \\\\  & =0-ln⁡8 \\\\  & =-ln⁡8.\\end{aligned}\n$$\n\nSo, we can simplify our final answer as follows:\n\n$$\n\\begin{aligned}\\frac{{(\\frac{1}{8})}^{x}}{ln⁡(\\frac{1}{8})}+C=-\\frac{{(\\frac{1}{8})}^{x}}{ln⁡8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38bd8b8c-b4c6-5ce9-a1d8-1966ee4c81bb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot \\frac{{3}^{ln⁡x}}{ln⁡2}+C" :db/id #edb/ref 17592186295587} {:answer/id #uuid "588dfff7-5cbe-5038-b14d-3d8e751e698d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡2}+C" :db/id #edb/ref 17592186295779} {:answer/id #uuid "986402eb-7839-5d62-b792-c55aac95a275" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186296083} {:answer/id #uuid "9902409f-61ad-5f6d-bef9-23a2badd42e4" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{3}^{2x}}{ln⁡3}+C" :db/id #edb/ref 17592186296087} {:answer/id #uuid "ba798157-3c82-5684-a8b2-fe1f9b64430c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{ln⁡x}+C" :db/id #edb/ref 17592186296245}] :answer-field/correct {:answer/id #uuid "986402eb-7839-5d62-b792-c55aac95a275" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot \\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186296083} :answer-field/id #uuid "11c70d75-1a42-5da1-9557-cc4e7e234b2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296672}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a909a720-f9c7-52e5-a8a4-abd3492e6b5f" :question/math-academy-id "q-31249" :question/problem "$\\int 3\\cdot {2}^{x}\\,\\text{d}x=$" :question/worked-solution "First, we factor out the constant $3.$ Then, we integrate the exponential function and get\n\n$$\n\\begin{aligned}\\int 3\\cdot {2}^{x}\\,\\text{d}x & =3\\int {2}^{x}\\,\\text{d}x \\\\  & =3\\cdot \\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating an Exponential Function With a General Base"}] [{:db/id #edb/ref 17592186064206 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064077 :question/id #uuid "d6501a20-6ebd-5786-870e-3527423b6332" :question/math-academy-id "e-449" :question/problem "Calculate $\\displaystyle{\\int \\dfrac{3}{5x+2}\\textrm{d}x}.$" :question/worked-solution "First, let $u=5x+2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 5\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 5 \\textrm d u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{5x+2}\\text{d}x & =3\\int \\frac{1}{5x+2}\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{3}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{3}{5}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{3}{5}\\operatorname{ln}⁡|5x+2|+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049443 :topic/math-academy-id 1361 :topic/title "Integrating the Reciprocal Function"} {:db/id #edb/ref 17592186050628 :topic/math-academy-id 334 :topic/title "Integrating Algebraic Functions Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074cbeeb-ceea-5d3a-b261-66c040d68ae2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186272451} {:answer/id #uuid "55a8292a-df16-5981-a5ea-00451577d189" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186273116} {:answer/id #uuid "c05838da-c78f-5df1-9575-655f840fa6b9" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274053} {:answer/id #uuid "d783c2de-76be-5361-adef-4dddf883917b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274273} {:answer/id #uuid "fb4ef98e-f7e7-56cd-950d-8eb83c1a8061" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274591}] :answer-field/correct {:answer/id #uuid "55a8292a-df16-5981-a5ea-00451577d189" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186273116} :answer-field/id #uuid "b72a5c10-3eed-5cd1-8364-3fce07a4be90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274951}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0fe299cc-e2f3-5032-a27f-6865f6c34c09" :question/math-academy-id "q-15707" :question/problem "$\\int \\frac{2}{x+1}\\,\\text{d}x=$" :question/worked-solution "First, let $u=x+1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x+1}\\,\\text{d}x & =2\\int \\frac{1}{x+1}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|x+1|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c144dd71-a451-50f4-bd73-a9c0523fd92d" :answer/type {:db/ident :answer.type/math} :answer/value "6\\ln \\mid 3x + 5 \\mid + C" :db/id #edb/ref 17592186063271} {:answer/id #uuid "2a177a11-33ab-5af0-b512-1510e305ebca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}\\ln \\mid 3x + 5 \\mid + C" :db/id #edb/ref 17592186063272} {:answer/id #uuid "2c2db0fc-0ec4-521c-98c8-29c7d2b63934" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\ln \\mid 3x + 5 \\mid + C" :db/id #edb/ref 17592186063273} {:answer/id #uuid "370a2b45-ff96-5771-8da2-62aca4a1839f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln \\mid 3x + 5 \\mid + C" :db/id #edb/ref 17592186063274} {:answer/id #uuid "5f5557bf-4c03-59e2-84cc-7091578e76cf" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\ln \\mid 3x + 5 \\mid + C" :db/id #edb/ref 17592186063275}] :answer-field/id #uuid "96da5b1f-df4d-5072-b0bc-718f3a5f68fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063270}] :question/id #uuid "58fee417-01ff-5eb4-9db6-9bace2e941d9" :question/math-academy-id "q-49511" :question/problem "Calculate $\\displaystyle \\int\\frac{2}{3x + 5}dx$."} {:db/id #edb/ref 17592186332717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e553192-d942-52a2-b058-a08aabebd6c4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186330209} {:answer/id #uuid "3609e68c-2c58-5cd1-8487-b74e635c9a15" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186330433} {:answer/id #uuid "70afd178-4cb4-5205-a323-152e86d990b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186330961} {:answer/id #uuid "94d347be-1f83-5358-b298-300c5831441e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186331269} {:answer/id #uuid "cdcde39b-ef58-518e-9c3e-c03c007b3d91" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186331774}] :answer-field/correct {:answer/id #uuid "cdcde39b-ef58-518e-9c3e-c03c007b3d91" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|+C" :db/id #edb/ref 17592186331774} :answer-field/id #uuid "574c5cd9-01b9-5d58-af18-c94886f17465" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332366}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "33493dd3-c6fe-5889-a9fc-d8fc59aa44da" :question/math-academy-id "q-49450" :question/problem "$\\int \\frac{1}{x-1}\\,\\text{d}x=$" :question/worked-solution "First, let $u=x-1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x-1}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|x-1|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1769bd13-d55d-5f6a-9446-919c53c722cf" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186330148} {:answer/id #uuid "54869286-b971-57b4-815f-5bbbdc7c4d50" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186330712} {:answer/id #uuid "7f11a40a-6408-5a1b-9034-2e0d3b330be3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331071} {:answer/id #uuid "84440df1-9b77-5a93-ac20-596184b2ec9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331124} {:answer/id #uuid "dba89aaa-0aa6-5aba-a139-c4ea916ad0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331897}] :answer-field/correct {:answer/id #uuid "dba89aaa-0aa6-5aba-a139-c4ea916ad0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331897} :answer-field/id #uuid "595a4b0f-ad62-571b-b6da-2d943ad48b26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332373}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2da03267-825e-5f39-863f-d7f53abceed7" :question/math-academy-id "q-49452" :question/problem "$\\int \\frac{1}{2-3x}\\,\\text{d}x=$" :question/worked-solution "First, let $u=2-3x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\,⟹\\,\\text{d}x=-\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u$, solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{2-3x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{3}\\,\\text{d}u) \\\\  & =-\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a085972-1baf-5648-867f-fa22e0ba0ea8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330175} {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} {:answer/id #uuid "903c6656-2cfe-57a6-9d04-bf4558a5f1f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331233} {:answer/id #uuid "b84ce15d-f916-5272-a13b-c0e2002f591a" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331578} {:answer/id #uuid "c7f98b80-b189-5486-9209-b6f6b685306a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331720}] :answer-field/correct {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} :answer-field/id #uuid "e906895e-8048-51d8-952c-ac1ed3e3bf3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f7ef9efb-7fe5-57f8-b97b-c7d8ad3002b1" :question/math-academy-id "q-49453" :question/problem "Calculate $\\int \\frac{3}{x+4}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x+4}\\,\\text{d}x & =3\\int \\frac{1}{x+4}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡|x+4|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e123997-b127-5730-b68c-958b0361cebb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186330498} {:answer/id #uuid "47555f75-8cc0-5307-a2e7-2d5be9828691" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186330592} {:answer/id #uuid "6bb83a27-d49d-56ba-a116-ebcc1b07eb20" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186330918} {:answer/id #uuid "c60f9f26-a6ac-50d4-b74e-4271d8892439" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186331706} {:answer/id #uuid "e37dc1e8-45fb-5780-a977-095cddc9ce8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186331959}] :answer-field/correct {:answer/id #uuid "e37dc1e8-45fb-5780-a977-095cddc9ce8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186331959} :answer-field/id #uuid "ea1c4516-41ca-5cc8-a8b3-01d5e9a5f968" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332611}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "69e9c2db-c46a-594b-831a-b87a3d7f93fe" :question/math-academy-id "q-49454" :question/problem "Calculate $\\int \\frac{1}{x+3}\\,\\text{d}x.$" :question/worked-solution "First, let $u=x+3.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x+3}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|x+3|+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a Linear Rational Function"}]}
