wer/id #uuid "9ceaef6f-9c72-5e48-957f-a3b4fb381803" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368485} {:answer/id #uuid "5f51609c-de29-58f2-96a9-a374c98ed7e3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186368486} {:answer/id #uuid "9fe13fe4-6d18-59d6-b45c-734844d8bb16" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186368487} {:answer/id #uuid "30845c4d-bc01-5613-a571-98932c7e1467" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368488}] :answer-field/correct {:answer/id #uuid "9fe13fe4-6d18-59d6-b45c-734844d8bb16" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186368487} :answer-field/id #uuid "4e476a11-df12-5fd0-a4d1-0ce0c6a4c96e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368483}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac5797f3-9c5f-5fa4-9757-c3f4e800eeb1" :question/math-academy-id "q-35394" :question/problem "Determine the number of pivot columns of the matrix $C,$ given by\n\n$$\nC=\\begin{bmatrix}1 & -2 & -1 & 4 & -5 \\\\ 0 & -3 & 0 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 0 \\\\ 0 & -1 & 0 & 2 & 3\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $C$ to row echelon form:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}1 & -2 & -1 & 4 & -5 \\\\ 0 & -3 & 0 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 0 \\\\ 0 & -1 & 0 & 2 & 3\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-\\frac{1}{3}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & -1 & 4 & -5 \\\\ 0 & -3 & 0 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 0 \\\\ 0 & 0 & 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $C$ has $4$ pivots, and therefore the number of pivot columns is $4.$"} {:db/id #edb/ref 17592186414494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c25b5ef-b912-5c71-9670-944d65285749" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186414467} {:answer/id #uuid "ad1a92a6-f6d8-5aa2-9a4c-0f2edb4ce9bc" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186414479} {:answer/id #uuid "e884e7e6-8f56-5bfb-a2ca-b9c4594a1a4b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186414486} {:answer/id #uuid "f3c840b3-dbab-5742-a2b1-8a2edee0b393" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186414487} {:answer/id #uuid "fa159688-f836-5d57-8c3c-4060d2af4504" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186414488}] :answer-field/correct {:answer/id #uuid "e884e7e6-8f56-5bfb-a2ca-b9c4594a1a4b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186414486} :answer-field/id #uuid "76643a29-5807-570f-8aa9-f5fb774e145b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414490}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7b4a741d-30d4-5d2c-9fde-2ae106aac7d2" :question/math-academy-id "q-130961" :question/problem "Determine the number of pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}-1 & 0 & 2 & 7 & -1 \\\\ 0 & 3 & 0 & 1 & 2 \\\\ 0 & -6 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & -2 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}-1 & 0 & 2 & 7 & -1 \\\\ 0 & 3 & 0 & 1 & 2 \\\\ 0 & -6 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & -2 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}-1 & 0 & 2 & 7 & -1 \\\\ 0 & 3 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 5 \\\\ 0 & 0 & 0 & -2 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼\\begin{bmatrix}-1 & 0 & 2 & 7 & -1 \\\\ 0 & 3 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 5 \\\\ 0 & 0 & 0 & 0 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}] :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] [{:db/id #edb/ref 17592186124480 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124293 :question/id #uuid "3ac076bd-5add-5c08-bb96-7b11c0a37d54" :question/math-academy-id "e-4706" :question/problem "What are the pivot columns of the matrix $B,$ given by\n![](images/f1/f10a5ef881920312ccdb163d9db70779d3848f7dc510c29d516eaf74a5ddd38d.svg)" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & -5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & -4 & 7 \\\\ 0 & 0 & 0 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 2\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-\\frac{2}{7}){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -5 & 0 & 0 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & \\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $4$th columns."} :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/questions [{:db/id #edb/ref 17592186124905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d902d5f9-286f-59ed-ad2f-a940f9d64e13" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186402456} {:answer/id #uuid "59e21a65-e54b-529e-af01-45eee909fed5" :answer/type {:db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186402457} {:answer/id #uuid "9e3a2e7f-88af-59d2-b10b-0f6888607047" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186402458} {:answer/id #uuid "5c862c29-b1f0-5ae3-9332-7d1761b0bb60" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402459} {:answer/id #uuid "56592c5b-5ea8-5015-81bc-3667c1634320" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186402460}] :answer-field/correct {:answer/id #uuid "5c862c29-b1f0-5ae3-9332-7d1761b0bb60" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186402459} :answer-field/id #uuid "b7425100-9aef-51c1-8d0e-fb3c989d9fa0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402455}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c93d2ae4-7e7b-5500-9b27-fd939892ffa9" :question/math-academy-id "q-35732" :question/problem "What are the pivot columns of the matrix $A,$ given by\n\n$$\nA=\\begin{bmatrix}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $A$ to row echelon form:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{bmatrix} & {R}_{1} & ↔{R}_{4} \\\\  & ∼\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $4$th columns."} {:db/id #edb/ref 17592186124906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40487040-b1c7-5407-a2db-530c13d29890" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th" :db/id #edb/ref 17592186321655} {:answer/id #uuid "4a91e3df-5714-5e10-9d58-d3f745be7029" :answer/type {:db/ident :answer.type/text} :answer/v