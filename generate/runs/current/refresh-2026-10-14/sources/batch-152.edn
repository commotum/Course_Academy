/ident :answer.type/math} :answer/value "⟨-2,\\,-3⟩" :db/id #edb/ref 17592186339776} {:answer/id #uuid "7cd77b81-1334-565d-8d3e-a2dd22d80c81" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186340253} {:answer/id #uuid "98819df0-6bd8-514f-987b-6451b9591fa6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,\\,0⟩" :db/id #edb/ref 17592186340501} {:answer/id #uuid "e19f3444-b301-5e49-b412-439b90466a1e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2-3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186341127} {:answer/id #uuid "eae4a6a8-5987-5a1e-bdd5-af1c44dee51c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186341202}] :answer-field/correct {:answer/id #uuid "eae4a6a8-5987-5a1e-bdd5-af1c44dee51c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186341202} :answer-field/id #uuid "7801b1aa-c6e8-5bd6-8f4c-7fe9a4c707f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341591}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f00ce7fb-f804-52bb-ae27-0431b21c7460" :question/math-academy-id "q-73738" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=\\begin{bmatrix}1 & -3 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}.\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is \n\n$$\n{\\begin{aligned}x-3y=-2 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-3y=-2.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=-2+3y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=-2+3y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2+3y \\\\ y\\end{bmatrix}=⟨-2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342073 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c87faa6-b893-53ba-92f4-903ccf2dd32d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & -2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339374} {:answer/id #uuid "359295b0-82ba-5167-85b6-7dd0bfdb6bf5" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 3 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339603} {:answer/id #uuid "60eaf115-9b83-5456-8a7e-58465ef148d4" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339993} {:answer/id #uuid "64ccd9c1-b048-5406-90fe-2f5854979f7d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186340021} {:answer/id #uuid "6ac239fb-67c1-5152-911c-d8d3251c0f0e" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 16\\end{bmatrix}" :db/id #edb/ref 17592186340075}] :answer-field/correct {:answer/id #uuid "60eaf115-9b83-5456-8a7e-58465ef148d4" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339993} :answer-field/id #uuid "8b1f506b-8f53-50ce-aefc-1cc168e288d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341624}] :question/difficulty {:db/ident :