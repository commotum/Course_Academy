 "a5c4ebf5-c3f7-51fd-acf7-a9712d8515e6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186340632} :answer-field/id #uuid "72bd5908-df4a-5071-9c06-4a211c439573" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341580}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e012b726-5b5c-59b3-9af4-421c826c1005" :question/math-academy-id "q-73636" :question/problem "What are the pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}1 & 3 & 0 & -1 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 3 & 0 & -1 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 3 & 0 & -1 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $3$rd columns."} {:db/id #edb/ref 17592186342046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9158a1e-ec92-5a85-91c0-20a1ac46a48d" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186340666} {:answer/id #uuid "b2728011-3f39-5c0e-80c4-f7db4bfbdeeb" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $6$th only" :db/id #edb/ref 17592186340750} {:answer/id #uuid "bd9e67c6-6e81-5e3b-be7d-db793cd3b0e2" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186340820} {:answer/id #uuid "d96d7546-90a3-580f-9f5a-249f3f3451e5" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186341057} {:answer/id #uuid "da721718-1f5a-5297-b2fc-1ff9bfdec092" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $6$th only" :db/id #edb/ref 17592186341068}] :answer-field/correct {:answer/id #uuid "bd9e67c6-6e81-5e3b-be7d-db793cd3b0e2" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186340820} :answer-field/id #uuid "31d2b7f2-9d9e-5f2d-9a1c-eeaf7743cd2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341467}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1b6c62c9-235a-5e15-9835-d3716c4119bd" :question/math-academy-id "q-73639" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & -6 & 0 & -4 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & -6 & 0 & -4 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼\\begin{bmatrix}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $2$nd, $3$rd, $5$th and $6$th columns."} {:db/id #edb/ref 17592186367373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78ca9091-6be2-5814-ae61-53be5638f15a" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186367375} {:answer/id #uuid "a6acf6b5-0371-5ddc-aab0-1212e3b32fa7" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186367376} {:answer/id #uuid "0854a26e-7a60-5e62-94fa-94bd6dfb909a" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $4$th, and $5$th only" :db/id #edb/ref 17592186367377} {:answer/id #uuid "8a115871-2791-5cf4-8ac6-bed9617a6ce6" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186367378} {:answer/id #uuid "46d18e0b-7506-5f2f-b65b-344226d96695" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $4$th, and $6$th only" :db/id #edb/ref 17592186367379}] :answer-field/correct {:answer/id #uuid "78ca9091-6be2-5814-ae61-53be5638f15a" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, $5$th, and $6$th only" :db/id #edb/ref 17592186367375} :answer-field/id #uuid "6cd32b6b-9449-5905-9f94-dbbbe678ea51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367374}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "30da60ae-07cf-5bba-adce-b72ca62ce00b" :question/math-academy-id "q-131307" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}0 & -1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 9 & -3 \\\\ 0 & 3 & -6 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & -3\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}0 & -1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 9 & -3 \\\\ 0 & 3 & -6 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & -3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 9 & -3 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & -3\\end{bmatrix} & {R}_{4} & :={R}_{4}+2{R}_{3} \\\\  & ∼\\begin{bmatrix}0 & -1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 9 & -3 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $2$nd, $3$rd, $5$th, and $6$th columns."} {:db/id #edb/ref 17592186400590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35bc5be3-2fe5-58fc-b85a-64fce1c7784d" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186400592} {:answer/id #uuid "7ee4be77-eda8-5477-a3be-58be37102e14" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186400593} {:answer/id #uuid "8e4d6b54-8a7a-519d-b637-e37bde3dbb2d" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186400594} {:answer/id #uuid "df41476c-0271-5fb9-ba37-452038f9f479" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $3$rd only" :db/id #edb/ref 17592186400595} {:answer/id #uuid "643510db-e574-5619-acbb-62a64f7e0730" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186400596}] :answer-field/correct {:answer/id #uuid "643510db-e574-5619-acbb-62a64f7e0730" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186400596} :answer-field/id #uuid "e34b1c74-ee10-528c-9c1b-188a96803527" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400591}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "190c1f09-7ea5-53d8-a079-57d65ed02079" :question/math-academy-id "q-131302" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}7 & 2 & 5 & 0 \\\\ 0 & -2 & -1 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{b