uuid "a42cf267-cd93-5235-bac2-c5ef6a96f055" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{sin}⁡(xy)+1)" :db/id #edb/ref 17592186264400}] :answer-field/correct {:answer/id #uuid "6273b842-ef76-552a-bc8b-402fc78dd30d" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{cos}⁡(xy)-2)" :db/id #edb/ref 17592186263845} :answer-field/id #uuid "8a671a21-e6ba-55dc-abe6-747d123487e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265491}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e76ba6c5-d6f9-5c6d-bdbf-7e135802e67b" :question/math-academy-id "q-131344" :question/problem "Given that $F(x,y)=({y}^{2}+{e}^{x})\\,i+\\operatorname{sin}⁡(xy)\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy))-\\frac{∂}{∂y}({y}^{2}+{e}^{x}) \\\\  & =y\\operatorname{cos}⁡(xy)-2y \\\\  & =y(\\operatorname{cos}⁡(xy)-2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "094b4e33-453c-5089-9253-e8aa4183aa51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186263087} {:answer/id #uuid "2f34bbbf-e9de-56ed-b5d5-8fd90694b1a1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263397} {:answer/id #uuid "4e08ff17-d0ef-5f8f-ad8b-de16401e07eb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263677} {:answer/id #uuid "91330e43-4daf-53a5-80cb-73904b06cc42" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264246} {:answer/id #uuid "f949f546-1d67-5e4c-8955-0d191616d3a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186265181}] :answer-field/correct {:answer/id #uuid "094b4e33-453c-5089-9253-e8aa4183aa51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186263087} :answer-field/id #uuid "cbc7fc2f-2d80-546c-928f-f71b49a246d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265606}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5ab1d5d9-c180-5acc-b2cc-0f6200926992" :question/math-academy-id "q-131348" :question/problem "Consider the vector field $F(x,y)=({x}^{2}+xy)\\,i+\\operatorname{ln}⁡(x+y)\\,j.$ Evaluate the scalar curl of $F$ at the point $(\\frac{1}{2},0).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y))-\\frac{∂}{∂y}({x}^{2}+xy) \\\\  & =\\frac{1}{x+y}-x.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(\\frac{1}{2},0),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(1/2,0)} & =\\frac{1}{(\\frac{1}{2}+0)}-\\frac{1}{2} \\\\  & =2-\\frac{1}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186362536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b80ad287-ac84-5ca1-86d0-c5e6390eb3d1" :answer/type {:db/ident :answer.type/math} :answer/value "-6xy" :db/id #edb/ref 17592186362538}] :answer-field/correct {:answer/id #uuid "b80ad287-ac84-5ca1-86d0-c5e6390eb3d1" :answer/type {:db/ident :answer.type/math} :answer/value "-6xy" :db/id #edb/ref 17592186362538} :answer-field/id #uuid "e71f8d4b-84bb-5e5f-b15b-3ca03cb3cddb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362537}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e244d7dd-417f-51de-bb65-cf4cf4f73429" :question/math-academy-id "q-169202" :question/problem "The scalar curl of $F$ is\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(-{y}^{3})-\\frac{∂}{∂y}(3x{y}^{2}) \\\\  & =0-(3x\\cdot 2y) \\\\  & =-6xy.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69cdb73c-68f9-51c3-a494-dbe4266db912" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186383064} {:answer/id #uuid "417e54d2-9717-5a97-a672-bbd2ccb8aafb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186383065} {:answer/id #uuid "f4cc8f77-f135-588f-ab23-c3509ab33e20" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186383066} {:answer/id #uuid "2f9778f5-bd6a-5d4b-81d4-8238d7ae5689" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186383067} {:answer/id #uuid "6247fb45-a096-58a2-8ab7-eac0357ef0e6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186383068}] :answer-field/correct {:answer/id #uuid "f4cc8f77-f135-588f-ab23-c3509ab33e20" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186383066} :answer-field/id #uuid "1329f6f4-d27c-52fa-b484-d7367ccdea8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383063}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c88bce86-de64-567d-8976-da96551577ee" :question/math-academy-id "q-126520" :question/problem "Consider the vector field $F(x,y)=(x+{y}^{2})\\,i+y\\operatorname{ln}⁡({x}^{2}+1)\\,j.$ Evaluate the scalar curl of $F$ at the point $(0,-1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡({x}^{2}+1))-\\frac{∂}{∂y}(x+{y}^{2}) \\\\  & =\\frac{2xy}{{x}^{2}+1}-2y.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(0,-1),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(0,-1)} & =\\frac{2(0)(-1)}{{0}^{2}+1}-2(-1) \\\\  & =0+2 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60ac814a-bd23-5ee0-b4f1-9f60f6f92a04" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186383071} {:answer/id #uuid "413bc497-4dc9-517b-955f-ff234af7121f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186383072} {:answer/id #uuid "68aee1b1-ce3f-5ba3-8aee-10ef06e824b5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186383073} {:answer/id #uuid "b4a78035-db24-5d4f-b02e-a5266dbde465" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186383074} {:answer/id #uuid "3fb908f3-12e2-51fd-82ab-4f09ca5fad8f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186383075}] :answer-field/correct {:answer/id #uuid "60ac814a-bd23-5ee0-b4f1-9f60f6f92a04" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186383071} :answer-field/id #uuid "83fe23ea-1458-55ab-bb2d-e5ba77ca30b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383070}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a595714d-0237-5554-9973-668e9384b87c" :question/math-academy-id "q-126527" :question/problem "Consider the vector field $F(x,y)=(x-{y}^{2})\\,i+({y}^{3}-x)\\,j.$ Evaluate the scalar curl of $F$ at the point $(-1,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}({y}^{3}-x)-\\frac{∂}{∂y}(x-{y}^{2}) \\\\  & =-1-(-2y) \\\\  & =2y-1.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(-1,1),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(-1,1)} & =2(1)-1 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be488c31-9256-566c-b32a-08e6c160f22c" :answer/type {:db/ident :answer.type/math} :answer/value "1+2x\\operatorname{cos}⁡y" :db/id #edb/ref 17592186383078} {:answer/id #uuid "f7488729-2ee4-53c3-8133-c6ecbdfd35b7" :answer/type {:db/ident :answer.type/math} :answer/value "2-y\\operatorname{cos}⁡x" :db/id #edb/ref 17592186383079} {:answer/id #uuid "53b1ed95-0584-576a-b16d-faf84c6c5497" :answer/type {:db/ident :answer.type/math} :answer/value "3-\\operatorname{sin}⁡y" :db/id #edb/ref 17592186383080} {:answer/id #uuid "045cf962-a0e3-5f5d-9614-af24c41f8a68" :answer/type {:db/ident :answer.type/math} :answer/value "2-x\\operatorname{cos}⁡y" :db/id #edb/ref 17592186383081} {:answer/id #uuid "4063a276-ab18-5a28-835e-27da301a0497" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡y-3" :db/id #edb/ref 17592186383082}] :answer-field/correct {:answer/id #uuid "045cf962-a0e3-5f5d-9614-af24c41f8a68" :answer/type {:db/ident :answer.type/math} :answer/value "2-x\\operatorname{cos}⁡y" :db/id #edb/ref 17592186383081} :answer-field/id #uuid "b22a1cc1-84ab-59a2-be59-cc57b115de95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383077}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8cde4f56-4a8b-58dd-9183-074bcd7df016" :question/math-academy-id "q-126537" :question/problem "Given that $F(x,y)=x\\operatorname{sin}⁡y\\,i+(2x+3y)\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(2x+3y)-\\frac{∂}{∂y}(x\\operatorname{sin}⁡y) \\\\  & =2-x\\operatorname{cos}⁡y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186409609 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd5ff55-9267-592c-8f53-54d27c28ddbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2({y}^{2}-{x}^{2})}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409591} {:answer/id #uuid "64ee45f8-90e8-584e-9ee0-f763b1794d3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409596} {:answer/id #uuid "81f3041d-6679-5b2e-8990-3525e4b2226c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409598} {:answer/id #uuid "9811b973-e6d5-574c-9870-5a2db507cfc5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186409600} {:answer/id #uuid "d498b33f-c852-5e73-bfc6-bc624cb1045e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}" :db/id #edb/ref 17592186409602}] :answer-field/correct {:answer/id #uuid "0fd5ff55-9267-