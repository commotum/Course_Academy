92f-52c6-a875-55bb696d0ded" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437476} :answer-field/id #uuid "91d192c0-fb0c-5d05-a1b4-1e76869a1358" :answer-field/key "IV" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438767}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2c2154fc-c947-5ba9-b169-f98f4fea25a5" :question/math-academy-id "q-105669" :question/problem "![](images/24/2414de6e2129d4fceaae304d16f9be0c91a545e5a8544b2033f353ddb2e581b9.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the positive $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/86/86aee33cdfa96ac0a61468cc9657e791e399f31c024cdbc3a932193dc897d534.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate counterclockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (counterclockwise), our thumb will point away from the screen. Therefore, $\\text{curl}\\,F$ also points away from the screen, in the direction of increasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186241110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf86ba1-b225-5f4e-a85f-182bd2bdbc53" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437478} {:answer/id #uuid "c7744411-0aa5-54ef-9c74-d6ca7e53bdb6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437479}] :answer-field/correct {:answer/id #uuid "c7744411-0aa5-54ef-9c74-d6ca7e53bdb6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437479} :answer-field/id #uuid "af1fc1b7-1f6d-5789-bbaf-748a9803bc96" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438768} {:answer-field/choices [{:answer/id #uuid "9168e608-76cb-5350-991f-3427546bf922" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437480} {:answer/id #uuid "6acf104d-e9d0-56e0-a85c-9b1ece39cee2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437481}] :answer-field/correct {:answer/id #uuid "9168e608-76cb-5350-991f-3427546bf922" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437480} :answer-field/id #uuid "6aa0313b-ee82-5436-b649-0b4504bba2d2" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438769} {:answer-field/choices [{:answer/id #uuid "bf15f6c8-cfc5-5bbe-886a-d7a4c35fe3b1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437482} {:answer/id #uuid "5ab85c7d-e507-5369-a231-49fca8b2c436" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437483}] :answer-field/correct {:answer/id #uuid "5ab85c7d-e507-5369-a231-49fca8b2c436" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437483} :answer-field/id #uuid "c223aec0-697d-56a5-825e-44718ec7f2d3" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438770} {:answer-field/choices [{:answer/id #uuid "a4d8d559-74b6-5016-bfae-9833564ce138" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437484} {:answer/id #uuid "ee14db71-cbc6-5c05-87b0-f9afe0453fbe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437485}] :answer-field/correct {:answer/id #uuid "a4d8d559-74b6-5016-bfae-9833564ce138" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437484} :answer-field/id #uuid "28f80fe3-8688-556e-8b02-a42b1e403d0f" :answer-field/key "IV" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438771}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "54529993-0bd1-511f-b362-f0eafc672ef8" :question/math-academy-id "q-105671" :question/problem "![](images/4c/4c38294780ac6d5079b759f39a7dbd4944b1c3c21495245dfd314ec180c0434e.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is irrotational\n- **IV.** $\\text{curl}\\,F$ points in the positive $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/97/979b63f21e56924bd7880f9487cf829089e38cf14d287e70196c7a661e41f97f.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statement III is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statement IV is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186241116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6da5be-dab7-5557-9faa-e9c458176103" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437486} {:answer/id #uuid "c92cf9d4-7709-5ceb-b895-b546ae07415c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437487}] :answer-field/correct {:answer/id #uuid "0d6da5be-dab7-5557-9faa-e9c458176103" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437486} :answer-field/id #uuid "e7e9da93-54af-5e26-8cfa-2245f93b43c5" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438772} {:answer-field/choices [{:answer/id #uuid "59