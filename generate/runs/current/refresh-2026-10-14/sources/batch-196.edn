answer/value "x{e}^{xy}+y\\operatorname{sin}⁡y" :db/id #edb/ref 17592186261565}] :answer-field/correct {:answer/id #uuid "36a55975-5a00-579c-91b8-556c16369c1e" :answer/type {:db/ident :answer.type/math} :answer/value "y{e}^{xy}+\\operatorname{sin}⁡y" :db/id #edb/ref 17592186260362} :answer-field/id #uuid "ab8a1355-bba2-53de-b55d-74f37e0b6215" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262432}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "20e33a61-f8a2-5ddb-b435-3e2df0814545" :question/math-academy-id "q-126544" :question/problem "Given that $F(x,y)=\\operatorname{cos}⁡y\\,i+{e}^{xy}\\,j,$ what is the scalar curl of $F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}({e}^{xy})-\\frac{∂}{∂y}(\\operatorname{cos}⁡y) \\\\  & =y{e}^{xy}-(-\\operatorname{sin}⁡y) \\\\  & =y{e}^{xy}+\\operatorname{sin}⁡y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221ac97f-6559-509a-a3d9-2450bf49633e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-{y}^{2}+1}{{x}^{2}+1}" :db/id #edb/ref 17592186260172} {:answer/id #uuid "a2757385-050d-54a8-8369-31a9aa26112c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+2x{y}^{2}+1}{{x}^{2}+1}" :db/id #edb/ref 17592186261289} {:answer/id #uuid "b7289054-f9d1-5ae6-bd2a-f55dcf3e02b8" :answer/type {:db/ident :answer.type/math} :answer/value "x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186261483} {:answer/id #uuid "fbb179e1-20cb-58d0-b8da-a19ff4125371" :answer/type {:db/ident :answer.type/math} :answer/value "2x-2y\\operatorname{ln}⁡({x}^{2}+1)" :db/id #edb/ref 17592186262076} {:answer/id #uuid "fcd94cc3-eb96-53bb-8a15-6