 :answer/value "true" :db/id #edb/ref 17592186439610}] :answer-field/correct {:answer/id #uuid "a2bdaabe-318f-5a44-a993-5dc144a01cc7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439610} :answer-field/id #uuid "c19eff62-0f3d-5e8b-8840-f4fa3fa30937" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440162} {:answer-field/choices [{:answer/id #uuid "9e122d41-3d05-51c1-8ec6-c73fbca7dcd6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439611} {:answer/id #uuid "2ab71ce6-dc10-5b55-86c4-8863ebadb312" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439612}] :answer-field/correct {:answer/id #uuid "9e122d41-3d05-51c1-8ec6-c73fbca7dcd6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439611} :answer-field/id #uuid "12845eb8-7a86-57fa-a87d-28447fbed3a1" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440163} {:answer-field/choices [{:answer/id #uuid "c69287cc-e1d6-5913-b9fc-cfeb0e6876ad" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439613} {:answer/id #uuid "433b23fc-2e50-5918-ad8e-38d59e8d6077" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439614}] :answer-field/correct {:answer/id #uuid "c69287cc-e1d6-5913-b9fc-cfeb0e6876ad" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439613} :answer-field/id #uuid "a99ea223-df14-549f-8f0a-56f14ff03cc4" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440164}] :question/id #uuid "4431905d-f46d-548a-987b-b6164fd2cc5d" :question/math-academy-id "q-27021" :question/problem "Which of the following statements are true regarding the function $y = \\cos x$? Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The zeros of the function are $x = \\frac{π}{2} + nπ$.\n- **II.** The function has maximum values at $x = \\frac{3π}{2} + 2nπ$.\n- **III.** The range of $y = \\cos x$ is $[- 1, 0]$." :question/worked-solution "Cosine has zeros at x=pi/2+n*pi. At x=3pi/2+2n*pi it is zero, not maximal, and its range is [-1,1]. Only I is true."} {:db/id #edb/ref 17592186235452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbd74cf7-7832-5d4d-9bdb-4352f71d9f85" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234944}] :answer-field/correct {:answer/id #uuid "fbd74cf7-7832-5d4d-9bdb-4352f71d9f85" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234944} :answer-field/id #uuid "6614a1f6-a87a-5480-bfb4-b31cd6dddad3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235080} {:answer-field/choices [{:answer/id #uuid "44c736f2-25bd-5d43-acf7-389cd352b94b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186234650}] :answer-field/correct {:answer/id #uuid "44c736f2-25bd-5d43-acf7-389cd352b94b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186234650} :answer-field/id #uuid "86dd5a39-356d-58f6-a814-f6ba7ef31193" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235139} {:answer-field/choices [{:answer/id #uuid "bd151ce5-c877-5cb0-954c-57ccd397f03f" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186234837}] :answer-field/correct {:answer/id #uuid "bd151ce5-c877-5cb0-954c-57ccd397f03f" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186234837} :answer-field/id #uuid "8fb953ef-938a-5b5b-99c5-5fa2a0878578" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #