(u,v)} & =\\left|\\begin{matrix}\\frac{\\partial x}{\\partial u}&\\frac{\\partial x}{\\partial v}\\\\\\frac{\\partial y}{\\partial u}&\\frac{\\partial y}{\\partial v}\\end{matrix}\\right|\\\\& =\\left|\\begin{matrix}4 \\left(u + 2 v\\right)&8 \\left(u + 2 v\\right)\\\\3 \\left(u - v\\right)^{2}&- 3 \\left(u - v\\right)^{2}\\end{matrix}\\right|\\\\& =(4 \\left(u + 2 v\\right))\\cdot (- 3 \\left(u - v\\right)^{2})-(8 \\left(u + 2 v\\right))\\cdot (3 \\left(u - v\\right)^{2})\\\\& =- 36 u^{3} + 108 u v^{2} - 72 v^{3}\\\\& =- 36 \\left(u - v\\right)^{2} \\left(u + 2 v\\right)\\\\\\left.\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|_{(1,2)} & =\\left(- 36 \\left(u - v\\right)^{2} \\left(u + 2 v\\right)\\right)\\big|_{u=1,v=2}\\\\& =- 36 \\left((1) - (2)\\right)^{2} \\left((1) + 2 (2)\\right)\\\\& =-180\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & \\approx|-180|\\cdot\\delta A\\\\ & =180\\,\\delta A.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186518930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26961c66-edcd-5145-85c4-6c1fc54d0f34" :answer/type {:db/ident :answer.type/math} :answer/value "3600\\,\\delta A" :db/id #edb/ref 17592186518913} {:answer/id #uuid "6037566d-f7b6-50da-a88b-dfbdeeb3fcc0" :answer/type {:db/ident :answer.type/math} :answer/value "60\\,\\delta A" :db/id #edb/ref 17592186518935} {:answer/id #uuid "76383b00-80af-5d97-ab38-8ebc7d2e3bb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{60}\\,\\delta A" :db/id #edb/ref 17592186518940} {:answer/id #uuid "812363c8-d6ee-5aea-85f6-8c6219b20949" :answer/type {:db/ident :answer.type/math} :answer/value "120\\,\\delta A" :db/id #edb/ref 17592186518943} {:answer/id #uuid "ec0f0246-49a2-593f-b299-8edb618ae39c" :answer/type {:db/ident :answer.type/math} :answer/value "30\\,\\delta A" :db/id #edb/ref 17592186518969}] :answer-field/correct {:answer/id #uuid "6037566d-f7b6-50da-a88b-dfbdeeb3fcc0" :answer/type {:db/ident :answer.type/math} 