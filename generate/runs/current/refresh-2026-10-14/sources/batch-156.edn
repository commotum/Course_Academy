{2}}{3}" :db/id #edb/ref 17592186236528} :answer-field/id #uuid "18c72a16-c41c-5f7d-a59f-cf1e101272bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237467}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c027c724-5ec4-54a9-b208-10f063932ce3" :question/math-academy-id "q-103243" :question/problem "If $cos⁡x=\\frac{\\sqrt{2}}{3},$ then $cos⁡(x-14\\pi )=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-7$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x+2\\cdot (-7)\\cdot \\pi )=cos⁡(x-14\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=\\frac{\\sqrt{2}}{3},$ then $cos⁡(x-14\\pi )=\\frac{\\sqrt{2}}{3}.$"} {:db/id #edb/ref 17592186237986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14927c29-0886-540d-95a2-4473de589ea8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186235940} {:answer/id #uuid "42b67f48-9900-5969-bb84-e376aa0e142a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{8}" :db/id #edb/ref 17592186236244} {:answer/id #uuid "b71cb3ce-28e0-585f-9894-ebfd9f88d9fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{2}" :db/id #edb/ref 17592186236978} {:answer/id #uuid "bae2f1a4-b12f-55b2-94e9-674f5ea009e7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi +\\frac{3}{2}" :db/id #edb/ref 17592186237013} {:answer/id #uuid "ce3be85b-3abb-5d86-a3c0-ca3e422113ad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi -\\frac{3}{4}" :db/id #edb/ref 17592186237124}] :answer-field/correct {:answer/id #uuid "14927c29-0886-540d-95a2-4473de589ea8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186235940} :answer-field/id #uuid "58f2a3ce-c6d5-5bd3-a262-29e4efe476df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237558}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4c5a6195-b8ed-52d4-86b4-4695109267db" :question/math-academy-id "q-103279" :question/problem "If $cos⁡x=\\frac{3}{8},$ then $4cos⁡(x-10\\pi )+5=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x+2\\cdot (-5)\\cdot \\pi )=cos⁡(x-10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=\\frac{3}{8},$ then $cos⁡(x-10\\pi )=\\frac{3}{8}.$\n\nFinally, then\n\n$$\n\\begin{aligned}4cos⁡(x-10\\pi )+5 & =4(\\frac{3}{8})+5 \\\\  & =\\frac{3}{2}+5 \\\\  & =\\frac{13}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0e7978b-65fb-572d-9e69-fb0ed478e885" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337487} {:answer/id #uuid "c8d773d6-1137-500e-9144-d700b2fde742" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}-10\\pi " :db/id #edb/ref 17592186337808} {:answer/id #uuid "d9c26a46-9433-52e8-869e-79e45ee386aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}-2\\pi " :db/id #edb/ref 17592186337927} {:answer/id #uuid "de73e983-b2d8-5bee-8dbc-77304e29d367" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337970} {:answer/id #uuid "e38b4e0e-34f4-5b2c-bf38-151d565a04ef" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}+10\\pi " :db/id #edb/ref 17592186338018}] :answer-field/correct {:answer/id #uuid "a0e7978b-65fb-572d-9e69-fb0ed478e885" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186337487} :answer-field/id #uuid "dd7d23c2-1