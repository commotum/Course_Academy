nt }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =({e}^{u}){|}_{0}^{1} \\\\  & ={e}^{1}-{e}^{0} \\\\  & =e-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0609bfa0-feaa-5eb6-8746-b749fc1e9ec2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,{e}^{x-1}+C" :db/id #edb/ref 17592186247477} {:answer/id #uuid "253a16d7-628b-53f9-a7b2-1f6c746a4abb" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247750} {:answer/id #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247828} {:answer/id #uuid "3bc85c63-a410-59bf-afe3-e5c1937a752b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x/2\\,-\\,1}}{2}+C" :db/id #edb/ref 17592186247953} {:answer/id #uuid "42a6cbcd-5218-511c-8178-7959687c4db1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186248018}] :answer-field/correct {:answer/id #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247828} :answer-field/id #uuid "4c624ee9-f981-5550-b705-79dced8e3486" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249811}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0dd276ae-ab9b-5d13-9781-196a361b49ac" :question/math-academy-id "q-113833" :question/problem "Calculate $\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x.$" :question/worked-solution "If we let $u=\\frac{x}{2}-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x & =\\int {e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =2\\int {e}^{u}\\,\\text{d}u \\\\  & =2\\,{e}^{u}+C \\\\  & =2\\,{e}^{x/2\\,-\\,1}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269142 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b278184-3c1a-51a7-a4b7-1998a71da8a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{e}^{3x}+C" :db/id #edb/ref 17592186266667} {:answer/id #uuid "64b91be6-e764-5247-9687-cc3d8a106a99" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{3x}+C" :db/id #edb/ref 17592186267034} {:answer/id #uuid "7501336f-7401-5639-8bba-372754b5587a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}{e}^{3x}+C" :db/id #edb/ref 17592186267173} {:answer/id #uuid "a54f3a7b-cdee-500a-8a6d-f8beaa588cc0" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3x}+C" :db/id #edb/ref 17592186267637} {:answer/id #uuid "c9e6fb05-9b5d-5928-bd5e-dbb48801ad3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}{e}^{5x}+C" :db/id #edb/ref 17592186267957}] :answer-field/correct {:answer/id #uuid "7501336f-7401-5639-8bba-372754b5587a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}{e}^{3x}+C" :db/id #edb/ref 17592186267173} :answer-field/id #uuid "53c4cf3f-ad58-56ca-aff5-107a809e8f19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "94671e02-a8dc-5c87-b443-151869fd52de" :question/math-academy-id "q-13732" :question/problem "$\\int 5{e}^{3x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 5{e}^{3x}\\,\\text{d}x & =\\int 5{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}{e}^{u}+C \\\\  & =\\frac{5}{3}{e}^{3x}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b72e205-86d9-5b47-bdcf-349ea88b438a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186266250} {:answer/id #uuid "69ce1d76-7873-550f-a974-e3238eefea4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{130}{3}" :db/id #edb/ref 17592186267081} {:answer/id #uuid "82cf1fb3-6525-538b-9699-a561c30abb9d" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186267295} {:answer/id #uuid "8ad2c511-8d76-585e-9fd2-7ea2903024cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{128}{3}" :db/id #edb/ref 17592186267386} {:answer/id #uuid "cedd122e-70d9-5696-97f0-924ad1110ed1" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186267994}] :answer-field/correct {:answer/id #uuid "82cf1fb3-6525-538b-9699-a561c30abb9d" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186267295} :answer-field/id #uuid "4247852f-3c47-5cdb-ab06-85feef271aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268518}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5b445bd7-4fa3-531e-a119-be633f3ce5d1" :question/math-academy-id "q-13775" :question/problem "Evaluate ${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration,  we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{6x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{6x}\\,\\text{d}u \\\\  & =4{\\int }_{0}^{6\\operatorname{ln}⁡2}{e}^{u}\\frac{1}{6}\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{6})}{e}^{u}\\text{d}u \\\\  & =\\frac{2}{3}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({2}^{6})} \\\\  & =\\frac{2}{3}({e}^{\\operatorname{ln}⁡({2}^{6})}-{e}^{0}) \\\\  & =\\frac{2}{3}({2}^{6}-1) \\\\  & =\\frac{2}{3}(64-1) \\\\  & =\\frac{2}{3}\\cdot 63 \\\\  & =42\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbe1e45-425c-5d24-9a2e-b0d2bc2b4422" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{9}" :db/id #edb/ref 17592186266423} {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} {:answer/id #uuid "5f41e2cc-d2de-56ef-80d2-9ac7568a671c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186266986} {:answer/id #uuid "7daa41e8-6e90-5e70-8402-bd9770caa41f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{80}{9}" :db/id #edb/ref 17592186267255} {:answer/id #uuid "a3c299e5-a721-5088-944a-c9d0c0bc8ecf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186267617}] :answer-field/correct {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} :answer-field/id #uuid "a01b2373-b791-524c-ae21-c98d1b57c90b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268689}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6e36897b-696c-54c5-85d9-3c04b5f56902" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68846e-8392-5a94-a3aa-2686ed8da072" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{25}{16}" :db/id #edb/ref 17592186295320} {:answer/id #uuid "2b89a108-9830-5765-ab37-236b6c7a436c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186295517} {:answer/id #uuid "567f2736-63ee-5f2a-b291-57227aca1813" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{16}" :db/id #edb/ref 17592186295771} {:answer/id #uuid "98a360bd-7dc7-5172-9965-33a5e01d2144" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{16}" :db/id #edb/ref 17592186296086} {:answer/id #uuid "b68c6e0c-5bad-5bf2-bfb7-247965fb865b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{25}{8}" :db/id #edb/ref 17592186296225}] :answer-field/correct {:answer/id #uuid "2b89a108-9830-5765-ab37-236b6c7a436c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186295517} :answer-field/id #uuid "f97a2636-5f46-5511-ac10-6484a8f5f52e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297145}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "38f9635e-72c4-5968-9945-fe2ceda9691e" :question/math-academy-id "q-30922" :question/problem "Evaluate the integral ${\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=-2x,$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x & =-5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{-2x}\\,\\text{d}u \\\\  & =-5{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}(-\\frac{1}{2}\\,\\text{d}u) \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{-2})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({4}^{-2})} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡({4}^{-2})}-{e}^{0}) \\\\  & =\\frac{5}{2}({4}^{-2}-1) \\\\  & =\\frac{5}{2}(\\frac{1}{16}-1) \\\\  & =\\frac{5}{2}\\cdot (-\\frac{15}{16}) \\\\  & =-\\frac{75}{32}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f193d193-1bf0-5987-8095-5e68075aa685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{5}" :db/id #edb/ref 17592186318367}] :answer-field/correct {:answer/id #uuid "f193d193-1bf0-5987-8095-5e68075aa685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{5}" :db/id #edb/ref 17592186318367} :answer-field/id #uuid "cdbd4d07-bfd0-51cd-a3e5-380d16ff0679" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318863}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d36c1c11-19b9-5940-860c-a11b298fedf7" :question/math-academy-id "q-349595" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $5\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{5x}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{5\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{4}{5}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{5})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{4}{5}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({2}^{5})} \\\\  & =\\frac{4}{5}({e}^{\\operatorname{ln}⁡({2}^{5})}-{e}^{0}) \\\\  & =\\frac{4}{5}({2}^{5}-1) \\\\  & =\\frac{4}{5}(32-1) \\\\  & =\\frac{4}{5}\\cdot 31 \\\\  & =\\frac{124}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3edf67a7-98ed-5fa7-a584-a4df28da0c03" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186317765}] :answer-field/correct {:answer/id #uuid "3edf67a7-98ed-5fa7-a584-a4df28da0c03" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186317765} :answer-field/id #uuid "96b04790-7dd5-55c7-ad74-3f32de8c4fb5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318758}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b9d82eda-7286-547a-83ef-0ce6d0452b88" :question/math-academy-id "q-349596" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡4}5{e}^{3x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}5{e}^{3x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{3x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{3\\operatorname{ln}⁡4}{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{3})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({4}^{3})} \\\\  & =\\frac{5}{3}({e}^{\\operatorname{ln}⁡({4}^{3})}-{e}^{0}) \\\\  & =\\frac{5}{3}({4}^{3}-1) \\\\  & =\\frac{5}{3}(64-1) \\\\  & =\\frac{5}{3}(63) \\\\  & =105\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2699f10-0b6b-5d35-aaa2-36b73e978859" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9}-e" :db/id #edb/ref 17592186318120}] :answer-field/correct {:answer/id #uuid "a2699f10-0b6b-5d35-aaa2-36b73e978859" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9}-e" :db/id #edb/ref 17592186318120} :answer-field/id #uuid "8e8ce480-0b94-536b-9ea9-402ad657f2e0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318740}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8852114f-8bc0-5518-9880-52e4b44b23ec" :question/math-academy-id "q-349601" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=4x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $9$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x & =4{\\int }_{0}^{2}{e}^{4x+1}\\,\\text{d}x \\\\  & =4{\\int }_{1}^{9}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & ={\\int }_{1}^{9}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{1}^{9} \\\\  & ={e}^{9}-{e}^{1} \\\\  & ={e}^{9}-e\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7048b4f-eab9-53d1-89fb-1d65b5316873" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{4}-3" :db/id #edb/ref 17592186322455}] :answer-field/correct {:answer/id #uuid "a7048b4f-eab9-53d1-89fb-1d65b5316873" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{4}-3" :db/id #edb/ref 17592186322455} :answer-field/id #uuid "efb3e809-f5f1-5a7d-8ffc-3c402b2e5aaa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186323641}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fd07d931-c8c4-5e1c-9858-8aed94aa2f51" :question/math-academy-id "q-362689" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{0}12{e}^{-4x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=-4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $-1$ | $0$ |\n| --- | --- | --- |\n| $u$ | $4$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}12{e}^{-4x}\\,\\text{d}x & =12{\\int }_{-1}^{0}{e}^{-4x}\\,\\text{d}x \\\\  & =12{\\int }_{4}^{0}{e}^{u}\\cdot (-\\frac{1}{4})\\,\\text{d}u \\\\  & =-3{\\int }_{4}^{0}{e}^{u}\\,\\text{d}u \\\\  & =-3\\cdot {e}^{u}\\,{|}_{4}^{0} \\\\  & =-3({e}^{0}-{e}^{4}) \\\\  & =-3(1-{e}^{4}) \\\\  & =3{e}^{4}-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bcca4c-5187-5b94-ac7b-5d02a3f2a7a8" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2z}+C" :db/id #edb/ref 17592186330287} {:answer/id #uuid "42c0d901-d11d-559d-85ac-c32b85f2ebde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186330547} {:answer/id #uuid "b72adbd0-bb37-569b-a51f-ca71e2f21191" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186331566} {:answer/id #uuid "c2a7f69b-7b9b-5b9c-a316-48041e48b095" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2z}+C" :db/id #edb/ref 17592186331680} {:answer/id #uuid "ed5ddad8-9030-5f3c-8173-cbf15c6a73ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{z}}{2}+C" :db/id #edb/ref 17592186332034}] :answer-field/correct {:answer/id #uuid "42c0d901-d11d-559d-85ac-c32b85f2ebde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186330547} :answer-field/id #uuid "5a02851a-ae90-5a99-96af-7dadaa7d8178" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332375}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "375483c5-6d04-5b75-830f-34c3a2a176c9" :question/math-academy-id "q-51160" :question/problem "$\\int {e}^{z}{e}^{z}\\,\\text{d}z=$" :question/worked-solution "First, we notice that\n\n$$\n\\int {e}^{z}{e}^{z}\\,\\text{d}z=\\int {e}^{2z}\\,\\text{d}z.\n$$\n\nIf we let $u=2z$, then\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2\\,⟹\\,\\text{d}z=\\frac{1}{2}\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int {e}^{2z}\\,\\text{d}z & =\\int {e}^{2z}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{2z}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{2z}}{2}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f50ded-9f12-51bb-a822-c1a4dc23c1e4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{17 {e}^{- 6 x - 2}}{6} + C" :db/id #edb/ref 17592186486566} {:answer/id #uuid "4f83cade-9ff1-5412-b97f-b97f2cbbe392" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{- 6 x - 2} + C" :db/id #edb/ref 17592186486568} {:answer/id #uuid "93666e6d-1a12-5926-957a-515012ac4cf7" :answer/type {:db/ident :answer.type/math} :answer/value "- {e}^{- 6 x - 2} + C" :db/id #edb/ref 17592186486572} {:answer/id #uuid "981141c0-7599-5cce-ae10-1464ee76b15a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{- 6 x - 2}}{6} + C" :db/id #edb/ref 17592186486573} {:answer/id #uuid "9dc23cf1-613d-5795-85b2-7758594c68cf" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 {e}^{- 6 x - 2} + C" :db/id #edb/ref 17592186486574}] :answer-field/correct {:answer/id #uuid "30f50ded-9f12-51bb-a822-c1a4dc23c1e4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{17 {e}^{- 6 x - 2}}{6} + C" :db/id #edb/ref 17592186486566} :answer-field/id #uuid "f96eaad2-708f-55c4-b8bd-ca9fe0fd745b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486583}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0cdba6d7-7a6b-54f6-b7d5-39604050f081" :question/problem "What is $\\int 17 {e}^{- 6 x - 2}\\,\\text{d}x$?" :question/worked-solution "If we let $u=- 6 x - 2,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6\\quad\\Longrightarrow\\quad\\text{d}x=- \\frac{1}{6}\\,\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 17 {e}^{- 6 x - 2}\\,\\text{d}x&=\\int 17{e}^{u}\\cdot - \\frac{1}{6}\\,\\text{d}u \\\\ &=- \\frac{17}{6}\\int {e}^{u}\\,\\text{d}u \\\\ &=- \\frac{17}{6}{e}^{u}+C \\\\ &=- \\frac{17 {e}^{- 6 x - 2}}{6}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0509bb76-47cb-5776-89ad-4918b5670f82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{17 x}}{8} + C" :db/id #edb/ref 17592186486564} {:answer/id #uuid "39d20901-8395-52c2-a3d2-b837a59f265d" :answer/type {:db/ident :answer.type/math} :answer/value "8 {e}^{8 x + 3} + C" :db/id #edb/ref 17592186486567} {:answer/id #uuid "c3e3d634-fb28-5096-89e6-31636d00431a" :answer/type {:db/ident :answer.type/math} :answer/value "17 {e}^{8 x + 3} + C" :db/id #edb/ref 17592186486576} {:answer/id #uuid "d6d56921-07c2-5ed7-a309-ae0f21f511c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 {e}^{8 x + 3}}{17} + C" :db/id #edb/ref 17592186486578} {:answer/id #uuid "fa4e0ccf-a5a0-5d88-a3a5-0b612d29b4b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{8 x + 3}}{8} + C" :db/id #edb/ref 17592186486584}] :answer-field/correct {:answer/id #uuid "fa4e0ccf-a5a0-5d88-a3a5-0b612d29b4b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17 {e}^{8 x + 3}}{8} + C" :db/id #edb/ref 17592186486584} :answer-field/id #uuid "c8e1a941-1a09-527e-9beb-23a4b61432d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486577}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "daf12fe8-bb11-5fd8-a3b3-59d7ece27403" :question/problem "$\\int 17 {e}^{8 x + 3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=8 x + 3,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8\\quad\\Longrightarrow\\quad\\text{d}x=\\frac{1}{8}\\,\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 17 {e}^{8 x + 3}\\,\\text{d}x&=\\int 17{e}^{u}\\cdot \\frac{1}{8}\\,\\text{d}u \\\\ &=\\frac{17}{8}\\int {e}^{u}\\,\\text{d}u \\\\ &=\\frac{17}{8}{e}^{u}+C \\\\ &=\\frac{17 {e}^{8 x + 3}}{8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "523fb413-bcaa-5750-8a89-02163f3e910f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486569} {:answer/id #uuid "6384ef1d-eb0c-5b89-81a8-9b3c4b5b9b66" :answer/type {:db/ident :answer.type/math} :answer/value "- 7 {e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486570} {:answer/id #uuid "a5670e65-dba0-567d-a8e1-807da90c42f9" :answer/type {:db/ident :answer.type/math} :answer/value "7 {e}^{x - 4} + C" :db/id #edb/ref 17592186486575} {:answer/id #uuid "dffc41ff-8df9-5896-af63-b72614c86a56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{\\frac{x}{7} - 4}}{7} + C" :db/id #edb/ref 17592186486580} {:answer/id #uuid "e368b95a-6074-5507-b918-fe622d329a58" :answer/type {:db/ident :answer.type/math} :answer/value "7 {e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486581}] :answer-field/correct {:answer/id #uuid "e368b95a-6074-5507-b918-fe622d329a58" :answer/type {:db/ident :answer.type/math} :answer/value "7 {e}^{\\frac{x}{7} - 4} + C" :db/id #edb/ref 17592186486581} :answer-field/id #uuid "7c47b8e2-1d72-58cc-a7ba-c337501e85c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486571}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f11bb3fa-ce88-546d-aefd-7cd344d3c36f" :question/problem "Calculate $\\int {e}^{\\frac{x}{7} - 4}\\,\\text{d}x.$" :question/worked-solution "If we let $u=\\frac{x}{7} - 4,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{7}\\quad\\Longrightarrow\\quad\\text{d}x=7\\,\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{\\frac{x}{7} - 4}\\,\\text{d}x&=\\int 1{e}^{u}\\cdot 7\\,\\text{d}u \\\\ &=7\\int {e}^{u}\\,\\text{d}u \\\\ &=7{e}^{u}+C \\\\ &=7 {e}^{\\frac{x}{7} - 4}+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] [{:db/id #edb/ref 17592186115190 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115019 :question/id #uuid "118a33c0-5831-586e-a0a5-e8bd3e1e4c9a" :question/math-academy-id "e-3644" :question/problem "Find $f'(x)$ if $f(x) = 2 \\csc x.$" :question/worked-solution "Here, we just take the constant out of the derivative and use the result for the derivative of $\\csc x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2csc⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}(csc⁡x) \\\\  & =2(-csc⁡xcot⁡x) \\\\  & =-2csc⁡xcot⁡x\\end{aligned}\n$$"} :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813 :topic/math-academy-id 1109 :topic/title "The Product Rule for Differentiation"} {:db/id #edb/ref 17592186048842 :topic/math-academy-id 1110 :topic/title "The Quotient Rule for Differentiation"} {:db/id #edb/ref 17592186050928 :topic/math-academy-id 611 :topic/title "The Reciprocal Trigonometric Ratios"}] :knowledge-point/questions [{:db/id #edb/ref 17592186115529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b16a493d-80f9-557b-bddf-119b38d4c14a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x - \\csc x\\cot x + \\sin x" :db/id #edb/ref 17592186112184} {:answer/id #uuid "6532f9ad-48c7-5ce1-ad3b-fd4f4e5fd3ef" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x - \\csc x\\cot x - \\sin x" :db/id #edb/ref 17592186112185} {:answer/id #uuid "677ec7da-ccbb-5e4d-91b0-64120fe3b2f9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x + \\csc x\\cot x + \\sin x" :db/id #edb/ref 17592186112186} {:answer/id #uuid "68a019de-dfcb-58fd-b7fb-070e4e015901" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x - \\csc^{2} x + \\sin x" :db/id #edb/ref 17592186112187} {:answer/id #uuid "7de17009-9120-5b7f-9d54-ec12975c4214" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x + \\csc^{2} x + \\sin x" :db/id #edb/ref 17592186112188}] :answer-field/id #uuid "866fbc7e-2d69-58df-9b40-82b1b5bd04aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112183}] :question/id #uuid "8f8fdb37-5d28-51d3-9859-e8918f947bbb" :question/math-academy-id "q-1889" :question/problem "Find $f^{′}(x)$ if $f(x) = \\csc x + 2\\tan x - \\cos x$."} {:db/id #edb/ref 17592186115727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136ad750-eb9e-5055-a26a-c8cda8dba5ea" :answer/type {:db/ident :answer.type/math} :answer/value "x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295374} {:answer/id #uuid "1cce689b-d66b-5419-b42f-1c935770579a" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-6csc⁡xcot⁡x" :db/id #edb/ref 17592186295433} {:answer/id #uuid "4c7cbd2b-769e-5c2a-8198-1408890da6d8" :answer/type {:db/ident :answer.type/math} :answer/value "-2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295702} {:answer/id #uuid "be094b01-e8a4-5075-a548-43ad86b83a02" :answer/type {:db/ident :answer.type/math} :answer/value "2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296269} {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463}] :answer-field/correct {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463} :answer-field/id #uuid "ed22d9b2-1f65-5896-a2a0-0c98a0de1f14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297120}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "683c5003-d2ff-5388-892e-f05923834b32" :question/math-academy-id "q-31283" :question/problem "Find ${f}^{′}(x)$ if $f(x)={x}^{2}-6csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233086 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3182ee5-db37-51de-958f-f774926b0554" :question/math-academy-id "q-104316" :question/problem "Find ${f}^{'}(x)$ if $f(x)={e}^{x}\\operatorname{csc}x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}\\operatorname{csc}x) \\\\  & ={e}^{x}(\\operatorname{csc}x)+{e}^{x}(-\\operatorname{csc}x\\operatorname{cot}x) \\\\  & ={e}^{x}\\operatorname{csc}x(1-\\operatorname{cot}x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0352fb0-8489-59d5-9924-70ee4464f51e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{csc}(x)-4x\\operatorname{csc}(x)\\operatorname{cot}(x)" :db/id #edb/ref 17592186232547}] :answer-field/correct {:answer/id #uuid "b0352fb0-8489-59d5-9924-70ee4464f51e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{csc}(x)-4x\\operatorname{csc}(x)\\operatorname{cot}(x)" :db/id #edb/ref 17592186232547} :answer-field/id #uuid "92356ea9-377d-5be5-b994-12f076bbd702" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232546}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "723bc8ce-f01f-58e1-82b5-d447fd0cc901" :question/math-academy-id "q-313722" :question/problem "Find ${h}^{'}(x)$ if $h(x)=4x\\operatorname{csc}(x).$\n\n${h}^{'}(x)=$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{h}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x\\operatorname{csc}(x)) \\\\  & =4(\\operatorname{csc}(x))+(4x)(-\\operatorname{csc}(x)\\operatorname{cot}(x)) \\\\  & =4\\operatorname{csc}(x)-4x\\operatorname{csc}(x)\\operatorname{cot}(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00535c78-693d-578f-9854-35ede0f5ea84" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186238081} {:answer/id #uuid "56c48d9d-1d29-5486-a7a5-24c09b6716ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }+5" :db/id #edb/ref 17592186238804} {:answer/id #uuid "9df9ae80-6d01-5879-b89f-4b4c816fb271" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }-5" :db/id #edb/ref 17592186239436} {:answer/id #uuid "a2edb5df-f3ab-5a56-b218-c1793bbbc5b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{\\pi }" :db/id #edb/ref 17592186239473} {:answer/id #uuid "d1e52b5d-7e6c-50b9-8aa1-34d4c2e3f3a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186239899}] :answer-field/correct {:answer/id #uuid "d1e52b5d-7e6c-50b9-8aa1-34d4c2e3f3a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186239899} :answer-field/id #uuid "e98e4466-7268-5d92-b403-0d0b4b3f5a67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240738}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "454b86d7-c6a0-5ac5-a0b5-59bf704396c0" :question/math-academy-id "q-105298" :question/problem "Find ${f}^{′}(\\frac{\\pi }{2})$ if $f(x)=ln⁡x-5csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x-5csc⁡x) \\\\  & =\\frac{1}{x}-5(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}+5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{2}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =\\frac{1}{(\\frac{\\pi }{2})}+5csc⁡(\\frac{\\pi }{2})cot⁡(\\frac{\\pi }{2}) \\\\  & =\\frac{2}{\\pi }+5\\cdot 1\\cdot 0 \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b187e54-5678-58b5-9aff-2031ec98f761" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}csc⁡x(ln⁡2+cot⁡x)" :db/id #edb/ref 17592186238160} {:answer/id #uuid "2058ffb0-c56f-523c-bf66-f8cc7453f206" :answer/type {:db/ident :answer.type/math} :answer/value "csc⁡x({2}^{x}ln⁡2-cot⁡x)" :db/id #edb/ref 17592186238334} {:answer/id #uuid "7a0c46bc-3e8d-51d9-90c9-36764bcb9a99" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}csc⁡x(ln⁡2-cot⁡x)" :db/id #edb/ref 17592186239108} {:answer/id #uuid "d1795b5a-93ce-5e52-9bea-134248e1edce" :answer/type {:db/ident :answer.type/math} :answer/value "csc⁡x({2}^{x}ln⁡2+cot⁡x)" :db/id #edb/ref 17592186239891} {:answer/id #uuid "e22d82e1-3f0d-5981-bca2-0a4d5eba60db" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}ln⁡2csc⁡xcot⁡x" :db/id #edb/ref 17592186240044}] :answer-field/correct {:answer/id #uuid "7a0c46bc-3e8d-51d9-90c9-36764bcb9a99" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{x}csc⁡x(ln⁡2-cot⁡x)" :db/id #edb/ref 17592186239108} :answer-field/id #uuid "831bbc3d-026c-54df-89fc-4dc90147c376" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240563}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7d61641d-525b-5efe-8635-c3fda06c667c" :question/math-academy-id "q-105299" :question/problem "Find ${f}^{′}(x)$ if $f(x)={2}^{x}csc⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({2}^{x}csc⁡x) \\\\  & ={2}^{x}ln⁡2(csc⁡x)+{2}^{x}(-csc⁡xcot⁡x) \\\\  & ={2}^{x}csc⁡x(ln⁡2-cot⁡x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f61aea39-f97c-5016-8587-a2f49bb65ddc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}-\\frac{3}{8}{\\pi }^{2}" :db/id #edb/ref 17592186296575}] :answer-field/correct {:answer/id #uuid "f61aea39-f97c-5016-8587-a2f49bb65ddc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}-\\frac{3}{8}{\\pi }^{2}" :db/id #edb/ref 17592186296575} :answer-field/id #uuid "4fc1501a-a5bd-5b32-9331-155d085aefef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296787}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1bab49d0-a1b6-58fc-8a02-9d9fd89dd0f7" :question/math-academy-id "q-313723" :question/problem "Find ${g}^{′}(\\frac{\\pi }{4})$ if $g(x)=csc⁡x-2{x}^{3}+cos⁡x.$\n\n${g}^{′}(\\frac{\\pi }{4})=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-csc⁡x-2{x}^{3}+cos⁡x) \\\\  & =(-csc⁡xcot⁡x)-2\\cdot 3{x}^{2}+(-sin⁡x) \\\\  & =-csc⁡xcot⁡x-6{x}^{2}-sin⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{g}^{′}(\\frac{\\pi }{4}) & =-csc\\,(\\frac{\\pi }{4})cot\\,(\\frac{\\pi }{4})-6{(\\frac{\\pi }{4})}^{2}-sin\\,(\\frac{\\pi }{4}) \\\\  & =-\\sqrt{2}\\cdot 1-6\\cdot \\frac{{\\pi }^{2}}{16}-\\frac{\\sqrt{2}}{2} \\\\  & =-\\sqrt{2}-\\frac{3}{8}{\\pi }^{2}-\\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{3\\sqrt{2}}{2}-\\frac{3}{8}{\\pi }^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b34c416-57fc-58ea-9d79-6823aeb070fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{csc}(x)}{x}-\\operatorname{ln}(x)\\operatorname{csc}(x)\\operatorname{cot}(x)" :db/id #edb/ref 17592186312703}] :answer-field/correct {:answer/id #uuid "5b34c416-57fc-58ea-9d79-6823aeb070fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{csc}(x)}{x}-\\operatorname{ln}(x)\\operatorname{csc}(x)\\operatorname{cot}(x)" :db/id #edb/ref 17592186312703} :answer-field/id #uuid "1796b8ee-d2f7-5e22-9787-083c3b5ddf1b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314071}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b3a61332-223a-5fc8-8ea7-10ae847de63a" :question/math-academy-id "q-340582" :question/problem "Find ${h}^{′}(x)$ if $h(x)=ln⁡(x)csc⁡(x).$\n\n${h}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡(x)csc⁡(x)) \\\\  & =\\frac{1}{x}(csc⁡x)+(ln⁡(x))(-csc⁡(x)cot⁡(x)) \\\\  & =\\frac{csc⁡(x)}{x}-ln⁡(x)csc⁡(x)cot⁡(x)\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] [{:db/id #edb/ref 17592186115192 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115021 :question/id #uuid "9b2548d6-87fc-56b1-aa7d-cef328eb4e24" :question/math-academy-id "e-3647" :question/problem "Calculate $f'(x)$ if $f(x) = x\\sec x.$" :question/worked-solution "We use the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(xsec⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x)\\cdot sec⁡x+x\\cdot \\frac{\\text{d}}{\\text{d}x}(sec⁡x) \\\\  & =(1)\\cdot sec⁡x+x\\cdot (sec⁡xtan⁡x) \\\\  & =sec⁡x(1+xtan⁡x)\\end{aligned}\n$$"} :knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/questions [{:db/id #edb/ref 17592186115530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80a2375e-1857-594b-8038-9e379060665f" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc^{2} x + 2\\cos x - 3\\sec^{2} x + 11" :db/id #edb/ref 17592186112190} {:answer/id #uuid "93af32d1-eee8-5bbb-afd1-add5cb6079c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x\\tan x - 2\\cos x - 3\\sec^{2} x + 11" :db/id #edb/ref 17592186112191} {:answer/id #uuid "b626aeae-9484-5670-b9a0-a0bcb8bb3c60" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc^{2} x - 2\\cos x - 3\\sec^{2} x + 11" :db/id #edb/ref 17592186112192} {:answer/id #uuid "ef98fb06-7c89-5b43-9b40-2b69ecb594fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x\\tan x - 2\\sin x - 3\\sec^{2} x + 11" :db/id #edb/ref 17592186112193} {:answer/id #uuid "0e30fe05-fcaf-5351-9536-8944d9bf1505" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x\\tan x - 2\\cos x - 3\\csc^{2} x + 11" :db/id #edb/ref 17592186112194}] :answer-field/id #uuid "8e251d3f-86f1-5f7d-8b73-b447b651f972" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112189}] :question/id #uuid "dad23bad-be29-541e-a7a0-95704d2c4bdd" :question/math-academy-id "q-1892" :question/problem "Find the derivative of $y =-2\\sin x + \\sec x - 3\\tan x + 11x$."} {:db/id #edb/ref 17592186115726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93472800-5cb9-5e57-b732-f2e0ba0c068f" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sec x\\tan x - 3" :db/id #edb/ref 17592186113323} {:answer/id #uuid "c19846ca-ad32-5550-b417-daf56b091c5e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sec x\\tan x - 3" :db/id #edb/ref 17592186113324} {:answer/id #uuid "ed3e15c9-0c13-5163-9f2f-1c17ad82b2a5" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sec x\\tan x" :db/id #edb/ref 17592186113325} {:answer/id #uuid "1f0e2ec0-af16-5100-8193-c72ee091025a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x\\tan x" :db/id #edb/ref 17592186113326} {:answer/id #uuid "304b017c-2341-578a-89b1-37ce9ed2fae3" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sec x\\cot x" :db/id #edb/ref 17592186113327}] :answer-field/id #uuid "1988b1d5-0315-5a4a-9f99-f970be599ea8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113322}] :question/id #uuid "c2ea1fd0-cbbe-514c-8365-1321efd3ea49" :question/math-academy-id "q-31280" :question/problem "Calculate $\\frac{dy}{dx}$ if $y = 3\\sec x - 3$."} {:db/id #edb/ref 17592186233604 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "326a7abb-eafe-5ef7-95ad-f379504b3864" :question/math-academy-id "q-1883" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3}{{x}^{2}}+\\operatorname{cos}x-3\\operatorname{sec}x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-2}+\\operatorname{cos}x-3\\operatorname{sec}x) \\\\  & =-2\\cdot 3{x}^{-3}+(-\\operatorname{sin}x)-3\\operatorname{sec}x\\operatorname{tan}x \\\\  & =-6{x}^{-3}-\\operatorname{sin}x-3\\operatorname{sec}x\\operatorname{tan}x \\\\  & =-\\frac{6}{{x}^{3}}-\\operatorname{sin}x-3\\operatorname{sec}x\\operatorname{tan}x\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233611 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bb909c2b-b4a1-545d-9302-d4f03a02a17d" :question/math-academy-id "q-1938" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{\\operatorname{sec}x}{4x}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{sec}x}{4x}) \\\\  & =\\frac{(\\operatorname{sec}x\\operatorname{tan}x)(4x)-(\\operatorname{sec}x)(4)}{(4x)^{2}} \\\\  & =\\frac{4x\\operatorname{sec}x\\operatorname{tan}x-4\\operatorname{sec}x}{16{x}^{2}} \\\\  & =\\frac{4(x\\operatorname{sec}x\\operatorname{tan}x-\\operatorname{sec}x)}{16{x}^{2}} \\\\  & =\\frac{x\\operatorname{sec}x\\operatorname{tan}x-\\operatorname{sec}x}{4{x}^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e46edded-4d40-56ba-b292-c5f0a8d33251" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{tan}(x)-2" :db/id #edb/ref 17592186232752}] :answer-field/correct {:answer/id #uuid "e46edded-4d40-56ba-b292-c5f0a8d33251" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{tan}(x)-2" :db/id #edb/ref 17592186232752} :answer-field/id #uuid "b5778e06-97ac-5ef8-8d10-7ce0085036ef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232751}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9734f0a3-cd50-5274-b82b-f9e29252c158" :question/math-academy-id "q-337182" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3\\operatorname{sec}(x)}{5{x}^{2}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{3\\operatorname{sec}(x)}{5{x}^{3}}($\n{{field-1}}$)$" :question/worked-solution "We calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{3\\operatorname{sec}(x)}{5{x}^{2}}) \\\\  & =\\frac{(3\\operatornam