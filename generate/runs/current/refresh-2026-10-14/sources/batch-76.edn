#{[{:db/id #edb/ref 17592186096620 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096420 :question/id #uuid "932c9b44-c040-5ae1-84f7-277767c255d4" :question/math-academy-id "e-3637" :question/problem "Given that $f(x) = \\dfrac{x} {9x^2 + 5x},$ find $f'(x).$" :question/worked-solution "The numerator and denominator are $u(x) = x$ and $v(x) = 9x^2 + 5x,$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{′}(x) & =1, \\\\ {v}^{′}(x) & =18x+5.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\eqalign{\n\t\t\tf'(x) \t& = \\dfrac {u'(x)\\cdot v(x) - u(x) v'(x)} {[v(x)]^2}\\\n\t\t\t\t& = \\dfrac{\\left( 9x^2+5x \\right )\\cdot 1 -x\\cdot \\left( 18x+5 \\right)}{\\left( 9x^2+5x\\right)^2}\\\n\t\t\t\t& = \\dfrac{\\left( 9x^2+5x-18x^2-5x \\right)}{\\left( 9x^2+5x\\right)^2}\\\n\t\t\t\t& = -\\dfrac{9x^2}{\\left( 9x^2+5x\\right)^2}.\n\t\t}\n$$"} :knowledge-point/id #uuid "fc978820-517c-5885-b31b-ab6f9650d57a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932 :topic/math-academy-id 278 :topic/title "The Sum and Constant Multiple Rules for Differentiation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186097024 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cea1ece-8d86-5b36-9f09-cdc0917272c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9{(4x-9)}^{2}}" :db/id #edb/ref 17592186251191} {:answer/id #uuid "61591785-e116-5156-9f81-f49dddb7b0b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{{(4x-9)}^{2}}" :db/id #edb/ref 17592186251348} {:answer/id #uuid "727df267-9e2a-54ef-bcc5-de9dc7298da9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{{(4x-9)}^{2}}" :db/id #edb/ref 17592186251493} {:answer/id #uuid "d637340d-541a-5922-b4b6-c3eefff141cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(4x-9)}^{2}}" :db/id #edb/ref 17592186252449} {:answer/id #uuid "e0757571-aa88-5c25-8b40-27c29a4c955d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{{(4x-9)}^{2}}" :db/id #edb/ref 17592186252530}] :answer-field/correct {:answer/id #uuid "727df267-9e2a-54ef-bcc5-de9dc7298da9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{{(4x-9)}^{2}}" :db/id #edb/ref 17592186251493} :answer-field/id #uuid "7a02e8cc-e8d1-5baf-aaee-8a82fb6d9122" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253015}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1c28431-540b-52b0-8025-5bd41ef201c1" :question/math-academy-id "q-11955" :question/problem "Given that $f(x)=\\frac{-2}{4x-9}$, find ${f}^{′}(x).$" :question/worked-solution "The numerator and denominator are $u(x)=-2$ and $v(x)=4x-9,$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{′}(x) & =0, \\\\ {v}^{′}(x) & =4.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x){v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(0)\\cdot (4x-9)-(-2)\\cdot (4)}{{(4x-9)}^{2}} \\\\  & =\\frac{8}{{(4x-9)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb418dcf-4b31-596f-8733-fda2cae49042" :answer/type {:db/ident :answer.type/math} :answer/value "(10x + 5)/((2x - 1)^{2})" :db/id #edb/ref 17592186094124} {:answer/id #uuid "cccbc445-bd5f-5ec7-a50a-e4662a299584" :answer/type {:db/ident :answer.type/math} :answer/value "(20x + 5)/((2x - 1)^{2})" :db/id #edb/ref 17592186094125} {:answer/id #uuid "d4f27e05-6400-5232-b358-36a20fc55135" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/((2x - 1)^{2})" :db/id #edb/ref 17592186094126} {:answer/id #uuid "dee7de9d-aa9b-512d-8573-27fa15ee6dee" :answer/type {:db/ident :answer.type/math} :answer/value "(5 - 10x)/((2x - 1)^{2})" :db/id #edb/ref 17592186094127} {:answer/id #uuid "2615c6de-1ecc-5b3c-ae82-a7a052c8cc4f" :answer/type {:db/ident :answer.type/math} :answer/value "- (5)/((2x - 1)^{2})" :db/id #edb/ref 17592186094128}] :answer-field/id #uuid "4cfc2711-d454-5d1a-b2c4-f0eceb2506fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094123}] :question/id #uuid "bad98009-f46f-5793-b767-f5a7dcb3c5af" :question/math-academy-id "q-11966" :question/problem "Given that $f(x) = \\frac{-5x}{2x - 1}$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186233084 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2d5c94d4-600d-5879-b9be-f30602b81bb7" :question/math-academy-id "q-104305" :question/problem "Given that $f(x)=\\frac{10}{3-{x}^{2}}$, find ${f}^{'}(x).$" :question/worked-solution "The numerator and denominator are $u(x)=10$ and $v(x)=3-{x}^{2},$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{'}(x) & =0, \\\\ {v}^{'}(x) & =-2x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{{u}^{'}(x)\\cdot v(x)-u(x)\\cdot {v}^{'}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(0)\\cdot (3-{x}^{2})-(10)\\cdot (-2x)}{{(3-{x}^{2})}^{2}} \\\\  & =\\frac{20x}{{(3-{x}^{2})}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233085 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d0055bc-7f16-584e-a97c-1d79ddbcd69d" :question/math-academy-id "q-104309" :question/problem "Given that $f(x)=\\frac{3-2x}{2{x}^{2}-2}$, find ${f}^{'}(x).$" :question/worked-solution "The numerator and denominator are $u(x)=3-2x$ and $v(x)=2{x}^{2}-2,$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{'}(x) & =-2, \\\\ {v}^{'}(x) & =4x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n \n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{{u}^{'}(x)\\cdot v(x)-u(x)\\cdot {v}^{'}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(-2)(2{x}^{2}-2)-(3-2x)(4x)}{{(2{x}^{2}-2)}^{2}} \\\\  & =\\frac{-4{x}^{2}+4-12x+8{x}^{2}}{{(2{x}^{2}-2)}^{2}} \\\\  & =\\frac{4{x}^{2}-12x+4}{4{({x}^{2}-1)}^{2}} \\\\  & =\\frac{{x}^{2}-3x+1}{{({x}^{2}-1)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "212b149b-1dd8-5450-b17f-57d69ec65809" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}" :db/id #edb/ref 17592186232822}] :answer-field/correct {:answer/id #uuid "212b149b-1dd8-5450-b17f-57d69ec65809" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}" :db/id #edb/ref 17592186232822} :answer-field/id #uuid "edced4b0-ac32-5c7c-9e30-42715ad03015" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232821}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a97b1e20-63fd-5ba5-b6fc-1f82595d60c6" :question/math-academy-id "q-340290" :question/problem "Given that $f(x)=\\frac{2}{{x}^{2}}$, find ${f}^{'}(x).$\n\n${f}^{'}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=2$ and $v(x)={x}^{2},$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{'}(x) & =0, \\\\ {v}^{'}(x) & =2x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{{u}^{'}(x)\\cdot v(x)-u(x)\\cdot {v}^{'}(x)}{[v(x)]^{2}} \\\\  & =\\frac{0\\cdot {x}^{2}-2\\cdot 2x}{{({x}^{2})}^{2}} \\\\  & =\\frac{-4x}{{x}^{4}} \\\\  & =-\\frac{4}{{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b21735-8635-55ee-9031-a6ee4821e28b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-{x}^{2}+4x+k+8}{{({x}^{2}+4x+k)}^{2}}" :db/id #edb/ref 17592186234556}] :answer-field/correct {:answer/id #uuid "03b21735-8635-55ee-9031-a6ee4821e28b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-{x}^{2}+4x+k+8}{{({x}^{2}+4x+k)}^{2}}" :db/id #edb/ref 17592186234556} :answer-field/id #uuid "7f19431f-dc7a-5469-ba75-1b7452db1e4b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235130}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ecceb386-fdf1-5dd9-81d5-114b41a2975b" :question/math-academy-id "q-128235" :question/problem "Find the derivative of $f(x).$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${f}^{′}(x)\\,=\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=x-2$ and $v(x)={x}^{2}+4x+k,$ respectively. Their derivatives are given by\n\n \n\n$$\n\\begin{aligned}{u}^{′}(x) & =1, \\\\ {v}^{′}(x) & =2x+4.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(1)({x}^{2}+4x+k)-(x-2)(2x+4)}{{({x}^{2}+4x+k)}^{2}} \\\\  & =\\frac{({x}^{2}+4x+k)-(2{x}^{2}-8)}{{({x}^{2}+4x+k)}^{2}} \\\\  & =\\frac{-{x}^{2}+4x+k+8}{{({x}^{2}+4x+k)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bf24fa9-ed1f-5955-a88a-b7e064a7b5bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7(5-4x)}{{(2{x}^{2}-5x-3)}^{2}}" :db/id #edb/ref 17592186234687}] :answer-field/correct {:answer/id #uuid "5bf24fa9-ed1f-5955-a88a-b7e064a7b5bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7(5-4x)}{{(2{x}^{2}-5x-3)}^{2}}" :db/id #edb/ref 17592186234687} :answer-field/id #uuid "b344e1c5-05c6-574a-ab90-1680f6b2c7d0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235191}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8c0064da-4356-5b95-8b94-94fe6fbae30f" :question/math-academy-id "q-128335" :question/problem "Calculate ${f}^{′}(x).$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${f}^{′}(x)\\,=\\,$ \n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=7$ and $v(x)=2{x}^{2}-5x-3,$ respectively. Their derivatives are given by\n\n$$\n{u}^{′}(x)=0,\\,{v}^{′}(x)=4x-5.\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x){v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(0)\\cdot (2{x}^{2}-5x-3)-7\\cdot (4x-5)}{{(2{x}^{2}-5x-3)}^{2}} \\\\  & =\\frac{-7\\cdot (4x-5)}{{(2{x}^{2}-5x-3)}^{2}} \\\\  & =\\frac{7(5-4x)}{{(2{x}^{2}-5x-3)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ea11b77-4105-57c4-ad6a-a791fba0a5dc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{(x+1)}^{2}}" :db/id #edb/ref 17592186313223}] :answer-field/correct {:answer/id #uuid "9ea11b77-4105-57c4-ad6a-a791fba0a5dc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{(x+1)}^{2}}" :db/id #edb/ref 17592186313223} :answer-field/id #uuid "4001791d-6816-5705-b627-d4d0593f9001" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314183}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1a44833b-d2d0-5994-baf0-85df4e6d1fa1" :question/math-academy-id "q-340287" :question/problem "Given that $f(x)=\\frac{1}{x+1}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=1$ and $v(x)=x+1,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =0, \\\\ {v}^{′}(x) & =1.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{0\\cdot (x+1)-1\\cdot 1}{{(x+1)}^{2}} \\\\  & =\\frac{-1}{{(x+1)}^{2}} \\\\  & =-\\frac{1}{{(x+1)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314923 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7f18b28-5912-5914-8aa1-319e8969b724" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{{(1-3x)}^{2}}" :db/id #edb/ref 17592186313404}] :answer-field/correct {:answer/id #uuid "b7f18b28-5912-5914-8aa1-319e8969b724" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{{(1-3x)}^{2}}" :db/id #edb/ref 17592186313404} :answer-field/id #uuid "078f8db2-73b3-537a-96c0-c91f714ab8da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314034}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "896d857d-c5c3-50e9-b5c4-a8009fe7f2b4" :question/math-academy-id "q-340297" :question/problem "Given that $f(x)=\\frac{6x}{1-3x}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=6x$ and $v(x)=1-3x,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =6, \\\\ {v}^{′}(x) & =-3.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{6\\cdot (1-3x)-6x\\cdot (-3)}{{(1-3x)}^{2}} \\\\  & =\\frac{6-18x+18x}{{(1-3x)}^{2}} \\\\  & =\\frac{6}{{(1-3x)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a4e194-497d-5ade-a154-fd721778fd76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+2x}{(x+1)^{2}}" :db/id #edb/ref 17592186312560}] :answer-field/correct {:answer/id #uuid "48a4e194-497d-5ade-a154-fd721778fd76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+2x}{(x+1)^{2}}" :db/id #edb/ref 17592186312560} :answer-field/id #uuid "9413c1af-f4f2-5835-a86f-4eba1827756d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314411}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7883ddbf-8c25-5e40-ba73-888b49a42d52" :question/math-academy-id "q-340298" :question/problem "Given that $f(x)=\\frac{{x}^{2}}{x+1}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)={x}^{2}$ and $v(x)=x+1,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =2x, \\\\ {v}^{′}(x) & =1.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{2x\\cdot (x+1)-{x}^{2}\\cdot 1}{{(x+1)}^{2}} \\\\  & =\\frac{2{x}^{2}+2x-{x}^{2}}{{(x+1)}^{2}} \\\\  & =\\frac{{x}^{2}+2x}{(x+1)^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61e09da3-92e2-579d-9a0d-8bcc6eae6b4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{x}^{2}}{({x}^{2}+1)^{2}}" :db/id #edb/ref 17592186312755}] :answer-field/correct {:answer/id #uuid "61e09da3-92e2-579d-9a0d-8bcc6eae6b4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{x}^{2}}{({x}^{2}+1)^{2}}" :db/id #edb/ref 17592186312755} :answer-field/id #uuid "af5a764f-a2d3-5790-afd5-4cc7047cdbef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314482}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "512fed86-0cd5-5df9-91e6-8e4e5eb5930f" :question/math-academy-id "q-340303" :question/problem "Given that $f(x)=\\frac{x}{{x}^{2}+1},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The numerator and denominator are $u(x)=x$ and $v(x)={x}^{2}+1,$ respectively. Their derivatives are given by\n\n$$\n\\begin{aligned}{u}^{′}(x) & =1, \\\\ {v}^{′}(x) & =2x.\\end{aligned}\n$$\n\nApplying the quotient rule, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{1\\cdot ({x}^{2}+1)-x\\cdot (2x)}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{{x}^{2}+1-2{x}^{2}}{({x}^{2}+1)^{2}} \\\\  & =\\frac{1-{x}^{2}}{({x}^{2}+1)^{2}}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Quotient of Two Polynomials"}] [{:db/id #edb/ref 17592186096655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096454 :question/id #uuid "9a42787b-24fb-50c8-9f3f-9e95d35c403c" :question/math-academy-id "e-459" :question/problem "Calculate  $\\displaystyle{\\int e^{1-3x}\\, \\textrm{d}x }.$" :question/worked-solution "If we let $u=1-3x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3\\quad\\Longrightarrow\\quad \\textrm d x = -\\dfrac 1 3 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{1-3x}\\,\\text{d}x & =\\int {e}^{u}\\cdot (-\\frac{1}{3})\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}{e}^{u}+C \\\\  & =-\\frac{1}{3}{e}^{1-3x}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"} {:db/id #edb/ref 17592186048754 :topic/math-academy-id 312 :topic/title "Integrating Exponential Functions"} {:db/id #edb/ref 17592186050628 :topic/math-academy-id 334 :topic/title "Integrating Algebraic Functions Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186097099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d7f849-00ec-5e56-93bd-5f9af777de2c" :answer/type {:db/ident :answer.type/math} :answer/value "-6e^{-6x} + C" :db/id #edb/ref 17592186094568} {:answer/id #uuid "86b83b6e-810a-5b7c-8d7d-dec07b441bde" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{-6x} + C" :db/id #edb/ref 17592186094569} {:answer/id #uuid "e0d45296-f41d-5260-89b5-e966f8183b9c" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-6x} + C" :db/id #edb/ref 17592186094570} {:answer/id #uuid "4c62783d-5ce8-5688-b061-43d00f936eb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}e^{-6x} + C" :db/id #edb/ref 17592186094571} {:answer/id #uuid "53d806b7-7b1d-5247-bcd5-05bb3e53e235" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}e^{-6x} + C" :db/id #edb/ref 17592186094572}] :answer-field/id #uuid "c3d3ffff-3549-5728-bf95-65b415f0642e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094567}] :question/id #uuid "4aa289aa-4bea-5233-863b-82ac1f00cf7d" :question/math-academy-id "q-13733