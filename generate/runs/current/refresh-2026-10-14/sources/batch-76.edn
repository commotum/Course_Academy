em "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3sec⁡x}{{e}^{x}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3sec⁡x}{{e}^{x}}) \\\\  & =\\frac{(3sec⁡xtan⁡x)({e}^{x})-(3sec⁡x)({e}^{x})}{({e}^{x})^{2}} \\\\  & =\\frac{3{e}^{x}sec⁡x(tan⁡x-1)}{{e}^{2x}} \\\\  & =\\frac{3sec⁡x(tan⁡x-1)}{{e}^{x}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "286fa88f-8ea5-503e-8fb0-428138ec40ff" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}sec⁡x(1+tan⁡x)" :db/id #edb/ref 17592186238410} {:answer/id #uuid "332c8633-3843-5c31-a194-e34735ef2602" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}sec⁡x(1-tan⁡x)" :db/id #edb/ref 17592186238499} {:answer/id #uuid "8bc2bfad-0679-520a-922e-89fcbb185bdd" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}sec⁡x(ln⁡5+tan⁡x)" :db/id #edb/ref 17592186239269} {:answer/id #uuid "9e62b7b8-8b3e-5c27-ac36-76b46c3019f0" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}sec⁡x(ln⁡5-tan⁡x)" :db/id #edb/ref 17592186239440} {:answer/id #uuid "c0d4930a-e248-568f-8ae5-64a2d0673eb8" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}sec⁡xtan⁡x" :db/id #edb/ref 17592186239738}] :answer-field/correct {:answer/id #uuid "8bc2bfad-0679-520a-922e-89fcbb185bdd" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}sec⁡x(ln⁡5+tan⁡x)" :db/id #edb/ref 17592186239269} :answer-field/id #uuid "f62f2c07-95e1-52c0-8500-ebb6139248e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240762}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dd297ed3-dba2-5110-9b3e-0d62167228f9" :question/math-academy-id "q-105314" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y={5}^{x}sec⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}sec⁡x) \\\\  & ={5}^{x}ln⁡5sec⁡x+{5}^{x}sec⁡xtan⁡x \\\\  & ={5}^{x}sec⁡x(ln⁡5+tan⁡x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241037 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01edfff5-f123-51ba-a62f-aed1989315e6" :answer/type {:db/ident :answer.type/math} :answer/value "-3cos⁡x-sec⁡xtan⁡x" :db/id #edb/ref 17592186238096} {:answer/id #uuid "249f92ae-729a-555f-b6e1-5e5982b4eabc" :answer/type {:db/ident :answer.type/math} :answer/value "3tan⁡x" :db/id #edb/ref 17592186238377} {:answer/id #uuid "8feef765-b5e2-58fa-b272-4256330846a0" :answer/type {:db/ident :answer.type/math} :answer/value "3cos⁡x+sec⁡xtan⁡x" :db/id #edb/ref 17592186239307} {:answer/id #uuid "bd795b11-23bc-5d2e-92ff-9130b95d5d2e" :answer/type {:db/ident :answer.type/math} :answer/value "-3cos⁡x+sec⁡xtan⁡x" :db/id #edb/ref 17592186239707} {:answer/id #uuid "e6e37b21-cc92-59c4-9bda-e10d7f67783c" :answer/type {:db/ident :answer.type/math} :answer/value "3cos⁡x-sec⁡xtan⁡x" :db/id #edb/ref 17592186240087}] :answer-field/correct {:answer/id #uuid "8feef765-b5e2-58fa-b272-4256330846a0" :answer/type {:db/ident :answer.type/math} :answer/value "3cos⁡x+sec⁡xtan⁡x" :db/id #edb/ref 17592186239307} :answer-field/id #uuid "51e2cff0-7cc5-5c58-867f-157458144217" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240481}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c5d31a05-3052-5924-9370-b49e037bb225" :question/math-academy-id "q-105316" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=3sin⁡x+sec⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3sin⁡x+sec⁡x) \\\\  & =3cos⁡x+sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cec10e18-7a10-5b64-8fe3-d5bc946a7e82" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}(x)\\operatorname{tan}(x)" :db/id #edb/ref 17592186313592}] :answer-field/correct {:answer/id #uuid "cec10e18-7a10-5b64-8fe3-d5bc946a7e82" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}(x)\\operatorname{tan}(x)" :db/id #edb/ref 17592186313592} :answer-field/id #uuid "fd342ef5-6196-57f0-ba44-b5e1261550f2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314689}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "da4a2c60-1cea-5b42-b245-062d281d5cf8" :question/math-academy-id "q-340608" :question/problem "Find the derivative of $y=2\\operatorname{sec}⁡(x)-{4}^{x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}\n$-\\,{4}^{x}\\operatorname{ln}⁡4$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(2\\operatorname{sec}⁡(x)-{4}^{x}) \\\\  & =2\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)-{4}^{x}\\operatorname{ln}⁡4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddf204d8-e22c-51c6-8fc3-35b6c7b7645b" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{tan}(x)" :db/id #edb/ref 17592186313721}] :answer-field/correct {:answer/id #uuid "ddf204d8-e22c-51c6-8fc3-35b6c7b7645b" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{tan}(x)" :db/id #edb/ref 17592186313721} :answer-field/id #uuid "b7dd68d5-5e9b-5e20-afa9-1cf870f43426" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314510}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cc86df7a-ccb0-5d8a-9c1d-7584dfc21d9f" :question/math-academy-id "q-340611" :question/problem "Find the derivative of $y={e}^{x}sec⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}={e}^{x}sec⁡(x)($\n{{field-1}}\n$)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}sec⁡(x)) \\\\  & ={e}^{x}sec⁡(x)+{e}^{x}sec⁡(x)tan⁡(x) \\\\  & ={e}^{x}sec⁡(x)(1+tan⁡(x))\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42958185-7df3-56a0-9626-eed54c7f99ca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312504}] :answer-field/correct {:answer/id #uuid "42958185-7df3-56a0-9626-eed54c7f99ca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312504} :answer-field/id #uuid "65f1890c-928c-56f6-8eb3-b4f4e9dc83d7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314295}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e573d90a-bd1d-5d85-a1c8-ca191df5266e" :question/math-academy-id "q-340620" :question/problem "Find the derivative of $y=4sec⁡x+{e}^{x}$ at $x=0.$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{0}=$\n{{field-1}}" :question/worked-solution "First, we take the derivative of each term and then add them:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(4sec⁡x+{e}^{x}) \\\\  & =4sec⁡xtan⁡x+{e}^{x}\\end{aligned}\n$$\n\nThen, we substitute $x=0$:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=0} & =(4sec⁡xtan⁡x+{e}^{x})\\,{|}_{x=0} \\\\  & =4sec⁡(0)tan⁡(0)+{e}^{0} \\\\  & =4\\cdot 1\\cdot 0+1 \\\\  & =1\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}]}
