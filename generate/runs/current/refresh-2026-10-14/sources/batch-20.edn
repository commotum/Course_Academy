{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So, $sin⁡\\theta =\\frac{\\sqrt{10}}{5}.$\n\nKnowing that $csc⁡\\theta =\\frac{1}{sin⁡\\theta },$ we have\n\n$$\n\\begin{aligned}csc⁡\\theta =\\frac{1}{(\\frac{\\sqrt{10}}{5})}=\\frac{5}{\\sqrt{10}}.\\end{aligned}\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}csc⁡\\theta  & =\\frac{5}{\\sqrt{10}} \\\\  & =\\frac{5}{\\sqrt{10}}\\cdot \\frac{\\sqrt{10}}{\\sqrt{10}} \\\\  & =\\frac{5\\sqrt{10}}{10} \\\\  & =\\frac{\\sqrt{10}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "528a08e6-b114-52bc-80b8-70909e3bcf6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186352305} {:answer/id #uuid "840edc39-ce69-5e96-a971-721e9703e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186352722} {:answer/id #uuid "9b103a08-6e43-5cc7-a32e-70ec6d35d281" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{7}}{7}" :db/id #edb/ref 17592186352896} {:answer/id #uuid "d780a273-2e9f-579d-b951-eb5dfc8fc835" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186353437} {:answer/id #uuid "e9803a68-f2b3-5f47-b6d4-6601df336f7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186353599}] :answer-field/correct {:answer/id #uuid "d780a273-2e9f-579d-b951-eb5dfc8fc835" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186353437} :answer-field/id #uuid "c1301c22-4c52-5421-ba45-744724340b9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354148}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5348ffc1-6c19-57de-8e72-a13dbe8b5969" :question/math-academy-id "q-85234" :question/problem "![](images/87/87635426224ded01c8bf486c7f59eeb6cacbe4e5c7db964643910bb5d142f0f3.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{2}}{3},$ use the Pythagorean identity to find $sec⁡\\theta .$" :question/worked-solution "![](images/9f/9f64bae56998bca7d825780c8c2b437ae3106486053cc9c8ed1b1fca2a88d4ab.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{2}}{3}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{2}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{2}}{3}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{2}}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{2}{9}} \\\\  & =\\pm \\sqrt{\\frac{7}{9}} \\\\  & =\\pm \\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{\\sqrt{7}}{3}.$\n\nKnowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(\\frac{\\sqrt{7}}{3})}=\\frac{3}{\\sqrt{7}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}sec⁡\\theta  & =\\frac{3}{\\sqrt{7}} \\\\  & =\\frac{3}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} \\\\  & =\\frac{3\\sqrt{7}}{7}\\end{aligned}\n$$"}] :knowledge-point/title "Computing a Reciprocal Ratio Using the Pythagorean Identity"}] [{:db/id #edb/ref 17592186162081 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161894 :question/id #uuid "55e8e57f-7f9e-529a-aa1b-24e1d86c4133" :question/math-academy-id "e-9470" :question/problem "![](images/76/765415456d7f33c3558e08e7c4fc01ef3e80961c1e073a210033d91741d78f60.png)\n\nCalculate $\\displaystyle\\int_C \\,\\textrm d s,$ where $C$ is the arc of a semicircle of radius $4$ traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\int_C \\,\\textrm d s = L.\n$$\n\nIn this case, $C$ is a semicircle of radius $r = 4.$ Its arc length is given by\n\n$$\n\\begin{aligned}L=\\pi r=4\\pi .\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\int_C \\,\\textrm d s = 4\\pi.\n$$"} :knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050089 :topic/math-academy-id 460 :topic/title "The Circumference of a Circle"} {:db/id #edb/ref 17592186050289 :topic/math-academy-id 2107 :topic/title "Line Integrals of Scalar Functions"} {:db/id #edb/ref 17592186050975 :topic/math-academy-id 459 :topic/title "The Distance Formula"}] :knowledge-point/questions [{:db/id #edb/ref 17592186162329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9753b03f-5368-57b2-af6c-e7dbe0c7a32b" :answer/type {:db/ident :answer.type/math} :answer/value "3π" :db/id #edb/ref 17592186159177} {:answer/id #uuid "eb3bba85-4f43-5945-9af3-289916125d54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3π}{2}" :db/id #edb/ref 17592186159178} {:answer/id #uuid "f9beb1c2-834d-5706-a18d-d85e62930916" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186159179} {:answer/id #uuid "24255bc5-5854-5b3f-b032-26c0628e5e16" :answer/type {:db/ident :answer.type/math} :answer/value "6π" :db/id #edb/ref 17592186159180} {:answer/id #uuid "6d552bcd-423f-5cca-9da0-17c23c691043" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186159181}] :answer-field/id #uuid "e15c9333-073d-521f-b511-64879ae2fcf0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159176}] :question/id #uuid "644abfce-6167-55c8-a092-efe38481c912" :question/math-academy-id "q-122567" :question/problem "![](images/c5/c5f7ed5a3d4763df369a9bc76cc934e5dd2c7f85dd074f623ae4f59f77f8e0c1.png)\n\nCalculate $\\displaystyle \\int_{C}ds$, where $C$ is the arc of a semicircle of radius $3$ traversed once in the counterclockwise direction, as shown above."} {:db/id #edb/ref 17592186162331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42d6a148-88c2-5e27-b2b8-7077e4ee92a7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186254242} {:answer/id #uuid "5e89e2cb-53fb-5209-b3b3-97fdcea9c2f4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254511} {:answer/id #uuid "c1c3c401-a416-5d33-9269-e60113197301" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186255400} {:answer/id #uuid "cf6c7463-ebe9-5c33-a220-becd6222ffaf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255515} {:answer/id #uuid "f05c2444-815f-56de-b32a-4ff4cd4ae7c1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186255772}] :answer-field/correct {:answer/id #uuid "42d6a148-88c2-5e27-b2b8-7077e4ee92a7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186254242} :answer-field/id #uuid "c8f24811-145c-5e38-85a4-66faa4942fa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256276}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "418cd3d5-ecfd-5690-a4c6-98dd1a3d29e8" :question/math-academy-id "q-122768" :question/problem "![](images/b7/b7e72ce1ab38408f04f3b8d5a228ec0a3632c60086ef0a7abeb7e18af3002e6b.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $3$ and $4.$ Therefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{3}^{2}+{4}^{2}} \\\\  & =\\sqrt{9+16} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=5.\n$$"} {:db/id #edb/ref 17592186256713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff0acc0-0e93-5334-be16-87734e65f347" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186253947} {:answer/id #uuid "267a1756-880b-503d-9cde-ec448304a42a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186254013} {:answer/id #uuid "3916ee0d-ef52-5786-a7a9-672356d765a8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186254166} {:answer/id #uuid "5356d693-3c5b-5b4b-a259-9f59cf7f89fd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186254397} {:answer/id #uuid "f5b78f71-4853-5da1-a1f0-3fedc3d3c1bf" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186255820}] :answer-field/correct {:answer/id #uuid "5356d693-3c5b-5b4b-a259-9f59cf7f89fd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186254397} :answer-field/id #uuid "38593efc-6c98-5f7c-a0ed-dbed4bca04a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256021}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5a8b286f-d065-50b6-ae53-27022484f1f9" :question/math-academy-id "q-122766" :question/problem "![](images/1a/1a46390ced6cc52c535f9f48e5e157cea83960caa339e98b23e3b64c93e0ea38.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is a line segment directed along the $y$-axis. Therefore, we have\n\n$$\n{\\int }_{C}\\,\\text{d}s=3-(-1)=4.\n$$"} {:db/id #edb/ref 17592186256714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57b9b426-71c1-5edb-9dd9-ca085fb61738" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254441} {:answer/id #uuid "77ea77f7-6a1b-56e7-8f3b-74939f184252" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186254729} {:answer/id #uuid "8943a84b-b99d-54fe-9fb1-3ac026d3d430" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186254887} {:answer/id #uuid "b2a7cf28-d7d6-5020-81cc-adfd50ba234f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255243} {:answer/id #uuid "cf01093d-6c43-52d5-8c1a-7fdd0ec9b92e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186255510}] :answer-field/correct {:answer/id #uuid "b2a7cf28-d7d6-5020-81cc-adfd50ba234f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255243} :answer-field/id #uuid "589066a3-615a-51c9-bb5d-9e742c10db6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256092}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3baa811b-dfdb-522b-86b9-2539a33b41e1" :question/math-academy-id "q-122767" :question/problem "![](images/d8/d82f445e19af6e6d343bfab6c082108e945a8feb21caa9b60a2d93da24fc3f6a.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the line segment directed along the $x$-axis. Therefore, we have\n\n$$\n{\\int }_{C}\\,\\text{d}s=5-1=4.\n$$"} {:db/id #edb/ref 17592186256715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce7ca60-5bcd-5786-a176-79dc33c37a12" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186254197} {:answer/id #uuid "614d3299-5ff7-52bc-9ff5-8dea36b35628" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186254542} {:answer/id #uuid "8fd81a7e-ee4a-5467-8b4d-882cd76a5836" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186254932} {:answer/id #uuid "bb63d7d5-a184-535e-a55e-59071a4a779c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186255340} {:answer/id #uuid "d7cde993-b01f-5a5f-ac2a-e34925aad9ec" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186255581}] :answer-field/correct {:answer/id #uuid "614d3299-5ff7-52bc-9ff5-8dea36b35628" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186254542} :answer-field/id #uuid "1a12dd65-6b67-5890-bee5-c40b46175718" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255965}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "65bfb8fc-d1de-55fb-a552-bcd799264edb" :question/math-academy-id "q-122769" :question/problem "![](images/e4/e41579712730d26c66d9f46f8d978fd51c8efbd76394c094113454e24b3aaff7.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $2$ and $4:$ \n\n![](images/84/849f44d06de55f14811d433f9ccfdd30d47f6a1db1970cdfbfbd6f16be4959b0.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{2}^{2}+{4}^{2}} \\\\  & =\\sqrt{4+16} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=2\\sqrt{5}.\n$$"} {:db/id #edb/ref 17592186256716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a61e51f-0cb8-563b-a933-412b31a8bff4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186253894} {:answer/id #uuid "2f133303-0ca9-5c34-9b67-603238077a30" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254086} {:answer/id #uuid "60d04bd9-3b2b-5773-af0c-28cc3399b1c2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186254536} {:answer/id #uuid "6662b8b2-0b86-5153-b706-d142f59cd08d" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186254592} {:answer/id #uuid "7e3cc7a1-a0b3-5270-a27e-c99b62538255" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186254789}] :answer-field/correct {:answer/id #uuid "60d04bd9-3b2b-5773-af0c-28cc3399b1c2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186254536} :answer-field/id #uuid "0c66c1de-5cc3-594e-9c4d-492721e5ecfe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255935}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "10f80d39-efd4-5625-821a-21dfccdb41c2" :question/math-academy-id "q-122770" :question/problem "![](images/69/69072873cb1f613ee9c2fa4a4caf3dc3409026c2a8310847b1c3dd890cc816d8.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $3$ and $6:$ \n\n![](images/d0/d0d9f0fad038f04b6d93920979161694f4e709a31b68083f20e768bf60aa1675.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{3}^{2}+{6}^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=3\\sqrt{5}.\n$$"}] :knowledge-point/title "Calculating Line Integrals of Unity"}]}
