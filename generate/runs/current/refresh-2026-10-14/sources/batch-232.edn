}{7})" :db/id #edb/ref 17592186491328} :answer-field/id #uuid "0f594d6f-899f-501e-b39f-e6bd9250f07b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491283}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "82683be9-eba9-5ac8-95c1-48b221025807" :question/problem "Evaluate the integral $\\displaystyle \\int_{1/2}^{1}\\cosh (\\frac{2x - 1}{7})dx$." :question/worked-solution "Let $u=\\frac{2x-1}{7}$. Then $du=\\frac{2}{7}\\,dx$, so $dx=\\frac{7}{2}\\,du$. The bounds $x=\\frac{1}{2}$ and $x=1$ become $u=0$ and $u=\\frac{1}{7}$.\n\n$$\n\\frac{7}{2}\\int_{0}^{\\frac{1}{7}}\\cosh u\\,du = \\frac{7}{2}[\\sinh u]_{0}^{\\frac{1}{7}} = \\frac{7}{2}(\\sinh (\\frac{1}{7})-\\sinh 0) = \\frac{7}{2}\\sinh (\\frac{1}{7})\n$$"} {:db/id #edb/ref 17592186491325 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c41cae1f-510a-5176-91a9-574f6cfa9cc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\cosh (6x - 3) + C" :db/id #edb/ref 17592186491331} {:answer/id #uuid "c65ec8bb-bd38-575b-80d7-ae80f2b439ab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}\\cosh (6x - 3) + C" :db/id #edb/ref 17592186491332} {:answer/id #uuid "d2320cec-21d4-5d34-9257-5ae68e5a08f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\cosh (6x - 3) + C" :db/id #edb/ref 17592186491335} {:answer/id #uuid "d7f87e11-083a-5274-9357-3dea809ba8e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\cosh (6x - 3) + C" :db/id #edb/ref 17592186491339} {:answer/id #uuid "eba507a9-e380-5494-a24c-4e45d7d84da1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\cosh (6x + 3) + C" :db/id #edb/ref 17592186491343}] :answer-field/correct {:answer/id #uuid "d2320cec-21d4-5d34-9257-5ae68e5a08f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\cosh (6x - 3) + C" :db/id #edb/ref 17592186491335} :answer-field/id #uuid "3c13c50b-6d1f-54ad-a8de-d4dffa818cbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491298}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a2a68b35-ddab-5d17-905e-096fb9475d79" :question/problem "What is $\\displaystyle \\int\\sinh (6x - 3)dx$?" :question/worked-solution "Let $u=6x - 3$. Then $du=6\\,dx$, so $dx=\\frac{1}{6}\\,du$.\n\n$$\n\\int\\sinh (6x - 3)dx = \\frac{1}{6}\\int\\sinh u\\,du = \\frac{1}{6}\\cosh u + C = \\frac{1}{6}\\cosh (6x - 3) + C\n$$"} {:db/id #edb/ref 17592186491338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f5f67f-6ada-59ae-b2c7-33e44ece32ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\cosh (6x - 4) + C" :db/id #edb/ref 17592186491289} {:answer/id #uuid "3ddab21f-a346-5f6a-a927-c51027816363" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}\\cosh (6x - 4) + C" :db/id #edb/ref 17592186491300} {:answer/id #uuid "ba1a8424-c5f7-5f22-90d4-5b5aa3351ba6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\cosh (6x + 4) + C" :db/id #edb/ref 17592186491329} {:answer/id #uuid "e1a7f919-ca4c-5585-a449-debf89007218" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\cosh (6x - 4) + C" :db/id #edb/ref 17592186491341} {:answer/id #uuid "edd2da9c-9c45-5049-b95d-6d33776e560d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\cosh (6x - 4) + C" :db/id #edb/ref 17592186491345}] :answer-field/correct {:answer/id #uuid "e1a7f919-ca4c-5585-a449-debf89007218" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\cosh (6x - 4) + C" :db/id #edb/ref 17592186491341} :answer-field/id #uuid "198a6cb1-1b50-5421-ac2c-666a63e267f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491290}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d51f6d4a-9fe0-500c-90c3-86af5830b753" :question/problem "What is $\\displaystyle \\int\\sinh (6x - 4)dx$?" :question/worked-solution "Let $u=6x - 4$. Then $du=6\\,dx$, so $dx=\\frac{1}{6}\\,du$.\n\n$$\n\\int\\sinh (6x - 4)dx = \\frac{1}{6}\\int\\sinh u\\,du = \\frac{1}{6}\\cosh u + C = \\frac{1}{6}\\cosh (6x - 4) + C\n$$"}] :knowledge-point/title "Integrating Hyperbolic Functions With Linear Arguments"}] [{:db/id #edb/ref 17592186175912 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175740 :question/id #uuid "1e0c95a6-24fc-55d1-9c4c-bf87877b3723" :question/math-academy-id "e-14729" :question/problem "Find the equation of the line that passes through the point $(1,-1)$ and is parallel to the line passing through the points $(2,1)$ and $(6,4)$. Write your answer in **standard form**." :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(2,1)$ and $(6,4)$:\n\n$$\n\\begin{aligned}\nm &= \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} \\\\\n&= \\frac{4 - 1}{6 - 2} \\\\\n&= \\frac{3}{4}\n\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of\n\n$$\n\\dfrac{3}{4}\n$$\n\nand passes through the point $(1,-1)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - (-1) &= \\frac{3}{4}(x - 1) \\\\\ny + 1 &= \\frac{3}{4}x - \\frac{3}{4} \\\\\ny &= \\frac{3}{4}x - \\frac{7}{4}\n\\end{aligned}\n$$\n\nFinally, we write this equation in standard form.\n\n$$\n\\begin{aligned}\ny &= \\frac{3}{4}x - \\frac{7}{4} \\\\\n4y &= 3x - 7 \\\\\n- 3x + 4y &= -7 \\\\\n3x - 4y &= 7\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "1a27c6f2-b81b-5b62-bcd0-14936842fe83" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049201 :topic/math-academy-id 3725 :topic/title "Properties of Lines Given in Standard Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186176419 :question/answer-fields [{:answer-field/id #uuid "e84db149-0fdf-57ec-bf76-ee6bccc2080a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174742} {:answer-field/id #uuid "053e9052-c4d0-592f-ae8e-2395eb179ccb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174743}] :question/id #uuid "31a937d8-bfb4-5425-9660-09c37501adc3" :question/math-academy-id "q-214093" :question/problem "Find the equation of the line that passes through the point $(-2, 1)$ and is parallel to $8x + 2y = 1$. Write your answer in **standard form.** {{field-1}}\n$=$\n{{field-2}}"} {:db/id #edb/ref 17592186176425 :question/answer-fields [{:answer-field/id #uuid "ebedceec-ce46-563a-86f8-37641baa1792" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174749} {:answer-field/id #uuid "12fea534-1224-5d05-a740-0d3308290ac4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174750}] :question/id #uuid "7da08e74-5166-5885-919a-dfff8326bc6a" :question/math-academy-id "q-216399" :question/problem "Find the equation of the line that passes through the point $(-2,-1)$ and is parallel to the line passing through the points $(3,-1)$ and $(6, 5)$. Write your answer in **standard form.** {{field-1}}\n$=$\n{{field-2}}"} {:db/id #edb/ref 17592186482661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bfeabcf-3074-5dad-83fc-0b9921b99bfe" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186482676}] :answer-field/correct {:answer/id #uuid "7bfeabcf-3074-5dad-83fc-0b9921b99bfe" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186482676} :answer-field/id #uuid "83da722a-9b17-5707-b4cd-76ca14b0f71e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482679} {:answer-field/choices [{:answer/id #uuid "032cefff-85b6-5b05-af15-c5c410327937" :answer/type {:db/ident :answer.type/math} :answer/value "4 x + y" :db/id #edb/ref 17592186482658}] :answer-field/correct {:answer/id #uuid "032cefff-85b6-5b05-af15-c5c410327937" :answer/type {:db/ident :answer.type/math} :answer/value "4 x + y" :db/id #edb/ref 17592186482658} :answer-field/id #uuid "c7381428-e4d3-569d-8aa3-19518ccacaf6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482698}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f9dba79-4d85-500f-864d-6679c1dd4ec3" :question/problem "Find the equation of the line that passes through the point $(-2,-1)$ and is parallel to $8x + 2y = 1$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, write the given line in slope-intercept form:\n\n$$\n\\begin{aligned}8 x + 2 y &= 1 \\\\ 2 y &= 1 -8 x \\\\ y &= \\frac{1}{2} -4 x\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $-4$ and passes through the point $(-2,-1)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-1) &= -4(x-(-2)) \\\\ y-(-1) &= -4 x -8 \\\\ y &= -4 x -9\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= -4 x -9 \\\\ 4 x + y &= -9\\end{aligned}\n$$\n\nThe first blank is $4 x + y$ and the second blank is $-9$."} {:db/id #edb/ref 17592186482663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "974c7431-c4bb-54d6-8f16-8e345b3010c3" :answer/type {:db/ident :answer.type/math} :answer/value "4 x + y" :db/id #edb/ref 17592186482687}] :answer-field/correct {:answer/id #uuid "974c7431-c4bb-54d6-8f16-8e345b3010c3" :answer/type {:db/ident :answer.type/math} :answer/value "4 x + y" :db/id #edb/ref 17592186482687} :answer-field/id #uuid "bac43c51-35c4-5930-92a1-fa58b760c8b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482695} {:answer-field/choices [{:answer/id #uuid "3c60047a-3cdd-5b2a-817c-3632d821b07d" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186482665}] :answer-field/correct {:answer/id #uuid "3c60047a-3cdd-5b2a-817c-3632d821b07d" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186482665} :answer-field/id #uuid "be089c35-7da0-5673-ad2d-5afefb37f7e1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482697}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18de6b0f-e0d4-57c9-8c2f-955688f324ec" :question/problem "Find the equation of the line that passes through the point $(-2,-5)$ and is parallel to $8x + 2y = 1$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, write the given line in slope-intercept form:\n\n$$\n\\begin{aligned}8 x + 2 y &= 1 \\\\ 2 y &= 1 -8 x \\\\ y &= \\frac{1}{2} -4 x\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $-4$ and passes through the point $(-2,-5)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-5) &= -4(x-(-2)) \\\\ y-(-5) &= -4 x -8 \\\\ y &= -4 x -13\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= -4 x -13 \\\\ 4 x + y &= -13\\end{aligned}\n$$\n\nThe first blank is $4 x + y$ and the second blank is $-13$."} {:db/id #edb/ref 17592186482667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4aa40b8-3294-55d0-b962-0a73373ca524" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id #edb/ref 17592186482692}] :answer-field/correct {:answer/id #uuid "b4aa40b8-3294-55d0-b962-0a73373ca524" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id #edb/ref 17592186482692} :answer-field/id #uuid "7c23546c-9f6f-510f-b262-3f84762c3e5e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482677} {:answer-field/choices [{:answer/id #uuid "f72d17d6-9556-5f70-9a06-7c9c878846c8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186482706}] :answer-field/correct {:answer/id #uuid "f72d17d6-9556-5f70-9a06-7c9c878846c8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186482706} :answer-field/id #uuid "d3ba4946-5218-5f0d-bdda-f87130d28c39" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482700}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "45e85c69-2915-53ec-9b6f-8e73c6118d11" :question/problem "Find the equation of the line that passes through the point $(-2,-8)$ and is parallel to the line passing through the points $(3,-1)$ and $(6, 5)$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(3,-1)$ and $(6,5)$:\n\n$$\n\\begin{aligned}m &= \\frac{y_2-y_1}{x_2-x_1} \\\\ &= \\frac{5-(-1)}{6-(3)} \\\\ &= 2\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $2$ and passes through the point $(-2,-8)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-8) &= 2(x-(-2)) \\\\ y-(-8) &= 2 x + 4 \\\\ y &= 2 x -4\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= 2 x -4 \\\\ 2 x -y &= 4\\end{aligned}\n$$\n\nThe first blank is $2 x -y$ and the second blank is $4$."} {:db/id #edb/ref 17592186482673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7346477-76ec-53e3-8749-86f16ad253e3" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id #edb/ref 17592186482688}] :answer-field/correct {:answer/id #uuid "a7346477-76ec-53e3-8749-86f16ad253e3" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id #edb/ref 17592186482688} :answer-field/id #uuid "6f334fab-18b8-5f48-8db5-38821108857f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482672} {:answer-field/choices [{:answer/id #uuid "0df94000-eea7-560d-be59-c18037122c7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186482660}] :answer-field/correct {:answer/id #uuid "0df94000-eea7-560d-be59-c18037122c7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186482660} :answer-field/id #uuid "922fb1bc-9c16-5396-b62d-d471b8174bb1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482686}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "70571ec1-99d9-55ba-a9fd-658e53807f96" :question/problem "F