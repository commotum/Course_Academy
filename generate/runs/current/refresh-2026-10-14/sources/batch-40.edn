#{[{:db/id #edb/ref 17592186059675 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059503 :question/id #uuid "31b9e2d8-1458-50b3-a920-703476825420" :question/math-academy-id "e-3631" :question/problem "Find the derivative of $y =  3\\cos x  + 4\\sin x + 2x^3.$" :question/worked-solution "We know that $\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\sin x ) = \\cos x,$ and that $\\dfrac{\\textrm{d}}{\\textrm{d}x} ( \\cos x ) = -\\sin x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3cos⁡x+4sin⁡x+2{x}^{3}) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(cos⁡x)+4\\frac{\\text{d}}{\\text{d}x}(sin⁡x)+2\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\  & =-3sin⁡x+4cos⁡x+2(3){x}^{2} \\\\  & =-3sin⁡x+4cos⁡x+6{x}^{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932 :topic/math-academy-id 278 :topic/title "The Sum and Constant Multiple Rules for Differentiation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac9634ef-7d12-5fc7-8486-2002f0e1b8ed" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\cos x - \\sin x" :db/id #edb/ref 17592186058345} {:answer/id #uuid "ddf9d360-ecae-5c9e-add7-78fe278e27ec" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin x + \\cos x" :db/id #edb/ref 17592186058346} {:answer/id #uuid "0f0dde70-457d-5a46-bc08-91d7ac21d219" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\tan x - \\cos x" :db/id #edb/ref 17592186058347} {:answer/id #uuid "4379eca7-3b91-591d-9449-1811c5ba0348" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x - 5\\cos x" :db/id #edb/ref 17592186058348} {:answer/id #uuid "508dcb97-0602-5582-91d6-429a0c4dd46f" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin x - \\cos x" :db/id #edb/ref 17592186058349}] :answer-field/id #uuid "2e007826-090c-5baf-898e-fac51047932d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058344}] :question/id #uuid "5132bd56-3a34-5a1c-b610-0cebb914852e" :question/math-academy-id "q-47906" :question/problem "Find $\\frac{d}{dx}(5\\cos x - \\sin x)$."} {:db/id #edb/ref 17592186060288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a436ea41-7313-5f7c-9e5e-d7cf92a31fc9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2\\sin x + \\cos x}{8}" :db/id #edb/ref 17592186058351} {:answer/id #uuid "a5c29a6a-9465-540f-9e67-a9a86fe45e11" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sin x + 2\\cos x}{8}" :db/id #edb/ref 17592186058352} {:answer/id #uuid "309d2c30-5a79-5940-9d8f-f1c473e37e97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sin x + 2\\cos x}{8}" :db/id #edb/ref 17592186058353} {:answer/id #uuid "72172321-c1b7-54ae-8b91-b2981e5b8f5f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sin x + \\cos x}{8}" :db/id #edb/ref 17592186058354} {:answer/id #uuid "7cef5fd1-fd37-5e84-8a6c-a2ed441e0417" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sin x - 2\\cos x}{8}" :db/id #edb/ref 17592186058355}] :answer-field/id #uuid "efeabe47-4ae4-5147-807f-0350ffa4359e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058350}] :question/id #uuid "07d15927-3e0d-5b26-9fdd-d0546a7d1aef" :question/math-academy-id "q-47908" :question/problem "Find the derivative of $y = \\frac{\\cos x}{8} - \\frac{\\sin x}{4}$."} {:db/id #edb/ref 17592186235429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f82a959f-469c-580d-b699-744a01e1a73e" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cos}x" :db/id #edb/ref 17592186234938}] :answer-field/correct {:answer/id #uuid "f82a959f-469c-580d-b699-744a01e1a73e" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cos}x" :db/id #edb/ref 17592186234938} :answer-field/id #uuid "01d3bdac-6753-510d-b7d4-b1bb408d2f9f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186234978}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8a37e3e9-7f1b-5a8d-b564-d8b93eaac32a" :question/math-academy-id "q-167324" :question/problem "$\\frac{\\text{d}h}{\\text{d}x}\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "We know that \n\n$$\n\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\n$$\n\nApplying this formula and the constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x) \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\  & =-4\\cdot (\\operatorname{cos}⁡x) \\\\  & =-4\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bff132e5-2ee2-59aa-8aea-3502c866b4de" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cos}(x)" :db/id #edb/ref 17592186234842}] :answer-field/correct {:answer/id #uuid "bff132e5-2ee2-59aa-8aea-3502c866b4de" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cos}(x)" :db/id #edb/ref 17592186234842} :answer-field/id #uuid "e4cf055c-8ce0-5492-8beb-32c82e4064bc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235248}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6cb1f8a0-05ce-5136-9c47-0498f7e83853" :question/math-academy-id "q-167778" :question/problem "$\\frac{\\text{d}h}{\\text{d}x}\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "We know that \n\n$$\n\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡(x))=\\operatorname{cos}⁡(x).\n$$\n\nApplying this formula and the constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡(x)) \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡(x)) \\\\  & =-4\\cdot (\\operatorname{cos}⁡(x)) \\\\  & =-4\\operatorname{cos}⁡(x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "203dab4a-3058-5e0e-90fa-52dcc35d2407" :answer/type {:db/ident :answer.type/math} :answer/value "4cos⁡x+2sin⁡x" :db/id #edb/ref 17592186285078} {:answer/id #uuid "46da0d85-3682-54d0-b58f-5f7b61e746ee" :answer/type {:db/ident :answer.type/math} :answer/value "2cos⁡x+4sin⁡x" :db/id #edb/ref 17592186285442} {:answer/id #uuid "55c1f225-5772-53df-9957-91ede62f7763" :answer/type {:db/ident :answer.type/math} :answer/value "2cos⁡x-4sin⁡x" :db/id #edb/ref 17592186285577} {:answer/id #uuid "66e054b3-95bb-5323-86e6-76b98c6154cc" :answer/type {:db/ident :answer.type/math} :answer/value "-4cos⁡x-2sin⁡x" :db/id #edb/ref 17592186285725} {:answer/id #uuid "92c0eef2-67dc-58fb-baa0-cc77ea56c821" :answer/type {:db/ident :answer.type/math} :answer/value "4cos⁡x-2sin⁡x" :db/id #edb/ref 17592186286120}] :answer-field/correct {:answer/id #uuid "55c1f225-5772-53df-9957-91ede62f7763" :answer/type {:db/ident :answer.type/math} :answer/value "2cos⁡x-4sin⁡x" :db/id #edb/ref 17592186285577} :answer-field/id #uuid "f1a13dae-3ed1-5b21-b23c-46bc3ddb17e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287640}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3974f0a3-ea97-56a9-a9e2-a7e59e1e84b1" :question/math-academy-id "q-1847" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(4cos⁡x+2sin⁡x)=$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x,$ and that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(4cos⁡x+2sin⁡x) & =4(-sin⁡x)+2(cos⁡x) \\\\  & =2cos⁡x-4sin⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04fa2ca0-5410-5738-8228-11c0d9ec4e4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186284832} {:answer/id #uuid "21163962-dbce-5c4a-9b9a-9ca9a5b9852a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{5}" :db/id #edb/ref 17592186285087} {:answer/id #uuid "3b82e03f-7320-5fd8-aa40-e2facea3ab8c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{21}{6}" :db/id #edb/ref 17592186285348} {:answer/id #uuid "9eea7b77-2513-5960-bc9f-8572e987d50f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186286240} {:answer/id #uuid "e5038023-5b22-563c-be39-21b7f5c99eca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186286883}] :answer-field/correct {:answer/id #uuid "9eea7b77-2513-5960-bc9f-8572e987d50f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186286240} :answer-field/id #uuid "ef361f71-5834-5185-8f00-5ef7a49d8455" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287638}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f830e92-57d1-5d05-97f7-0f6a59992f23" :question/math-academy-id "q-1900" :question/problem "What is the slope of the tangent line to the curve $y=2x-5cos⁡x$ at the point $x=\\frac{\\pi }{6}?$" :question/worked-solution "The slope at $x=\\frac{\\pi }{6}$ is given by the value of the derivative ${y}^{′}$ at $x=\\frac{\\pi }{6}.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-5cos⁡x) \\\\  & =2-5(-sin⁡x) \\\\  & =2+5sin⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{6},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(30) & =2+5sin⁡(\\frac{\\pi }{6}) \\\\  & =2+5(\\frac{1}{2}) \\\\  & =2+\\frac{5}{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore,  the instantaneous rate of change is $\\frac{9}{2}.$"} {:db/id #edb/ref 17592186297316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eda8d71-b593-5d95-86c9-5bba5f41ecdd" :answer/type {:db/ident :answer.type/math} :answer/value "12x+6sin⁡x" :db/id #edb/ref 17592186295355} {:answer/id #uuid "9cdb325f-ae0b-5a49-b609-cab3e9c25d86" :answer/type {:db/ident :answer.type/math} :answer/value "6x+6sin⁡x" :db/id #edb/ref 17592186296105} {:answer/id #uuid "a190184d-f11f-593d-b408-9b37e070ca95" :answer/type {:db/ident :answer.type/math} :answer/value "12x-6sin⁡x" :db/id #edb/ref 17592186296127} {:answer/id #uuid "d3db1a2e-d54f-5696-906b-c48583e1acb5" :answer/type {:db/ident :answer.type/math} :answer/value "12x-sin⁡x" :db/id #edb/ref 17592186296382} {:answer/id #uuid "ef4b1b52-780c-57c9-9707-2dacfce41710" :answer/type {:db/ident :answer.type/math} :answer/value "12x+sin⁡x" :db/id #edb/ref 17592186296538}] :answer-field/correct {:answer/id #uuid "0eda8d71-b593-5d95-86c9-5bba5f41ecdd" :answer/type {:db/ident :answer.type/math} :answer/value "12x+6sin⁡x" :db/id #edb/ref 17592186295355} :answer-field/id #uuid "44751772-2752-5c4b-a6b7-c43cb14bd23b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296763}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8745f56e-112e-51d0-a4cd-8f6c067107b5" :question/math-academy-id "q-30991" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=6({x}^{2}-cos⁡x)+5.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6({x}^{2}-cos⁡x)+5) \\\\  & =6\\cdot 2x+6sin⁡x+0 \\\\  & =12x+6sin⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186315088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4888f926-ac9b-5bbc-8435-71b677b35500" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{cos}x}{4}+{x}^{3}" :db/id #edb/ref 17592186312559}] :answer-field/correct {:answer/id #uuid "4888f926-ac9b-5bbc-8435-71b677b35500" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{cos}x}{4}+{x}^{3}" :db/id #edb/ref 17592186312559} :answer-field/id #uuid "25b7e347-dabe-5d35-a8f1-93d368fa3fc2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314108}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "30336cd1-38ee-5642-8e7c-8269174ccf53" :question/math-academy-id "q-341383" :question/problem "Find the derivative of $y=\\frac{5sin⁡x}{4}+\\frac{{x}^{4}}{4}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5sin⁡x}{4}+\\frac{{x}^{4}}{4}) \\\\  & =\\frac{5}{4}(cos⁡x)+\\frac{1}{4}(4{x}^{3}) \\\\  & =\\frac{5cos⁡x}{4}+{x}^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58178d4f-4abd-58b7-80f3-235da8563710" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-1}" :db/id #edb/ref 17592186327707} {:answer/id #uuid "6e8ba3a3-8163-54a7-a89c-617f3758ea02" :answer/type {:db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186327890} {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} {:answer/id #uuid "b8c3ad30-bf9c-5740-9f1f-85721ef68822" :answer/type {:db/ident :answer.type/math} :answer/value "-2sin⁡x+2{x}^{-3}" :db/id #edb/ref 17592186328543} {:answer/id #uuid "fb5d65e6-8cdc-5871-afa6-4d5b3c079a97" :answer/type {:db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-2}" :db/id #edb/ref 17592186329139}] :answer-field/correct {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} :answer-field/id #uuid "fa72fd76-960d-5bcb-9cf5-7f47b8602241" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329616}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f32d0b6b-0338-505d-81ba-ba8c8d1669de" :question/math-academy-id "q-47985" :question/problem "Find the derivative of $y=-2cos⁡x+{x}^{-2}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2cos⁡x+{x}^{-2}) \\\\  & =-2(-sin⁡x)+(-2){x}^{-2-1} \\\\  & =2sin⁡x-2{x}^{-3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186489467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031a974d-9b1e-5723-8d58-6fca1791d2cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{252}{5}" :db/id #edb/ref 17592186489462} {:answer/id #uuid "127e7c18-d458-55dd-8d52-8b6e1b1d5f87" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186489464} {:answer/id #uuid "6612c30b-4a4f-5379-9362-7887231b0c78" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186489473} {:answer/id #uuid "bb87ab96-2d8e-5e3a-9369-c94d7acaef68" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186489487} {:answer/id #uuid "f8cfb147-7f8e-5337-9e4c-c8ce4545f759" :answer/type {:db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186489496}] :answer-field/correct {:answer/id #uuid "127e7c18-d458-55dd-8d52-8b6e1b1d5f87" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186489464} :answer-field/id #uuid "af330894-e3b0-5f96-bf7b-26f02738a953" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "308d927b-9585-594c-b5e7-da139c2cdf56" :question/problem "What is the slope of the tangent line to the curve $y=24 x - 60 \\cos{\\left(x \\right)}$ at the point $x=\\frac{\\pi}{6}$?" :question/worked-solution "The slope is the derivative evaluated at $x=\\frac{\\pi}{6}.$\n\nWe know that $\\frac{\\text{d}}{\\text{d}x}(\\sin x)=\\cos x,$ and that $\\frac{\\text{d}}{\\text{d}x}(\\cos x)=-\\sin x.$ Applying these formulas and the sum and constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} &= \\frac{\\text{d}}{\\text{d}x}(24 x - 60 \\cos{\\left(x \\right)}) \\\\ &= (60 \\sin{\\left(x \\right)})+(24) \\\\ &= 60 \\sin{\\left(x \\right)} + 24.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi}{6},$ we get\n\n$$\ny^{\\prime}(\\frac{\\pi}{6})=24+60\\sin(\\frac{\\pi}{6})=24+60\\left(\\frac{1}{2}\\right)=54.\n$$\n\nTherefore, the slope is $54.$"} {:db/id #edb/ref 17592186489470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f7d473-2d4b-516c-9268-0b2806d1a4ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{99}{2}" :db/id #edb/ref 17592186489463} {:answer/id #uuid "2b299f08-d135-5982-959b-fb63b1206a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{231}{5}" :db/id #edb/ref 17592186489465} {:answer/id #uuid "30332371-e541-5526-ad31-ea0fe696c0c6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{77}{2}" :db/id #edb/ref 17592186489466} {:answer/id #uuid "4dc0f155-25cd-54c2-a5ca-25242fdd9010" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{99}{4}" :db/id #edb/ref 17592186489471} {:answer/id #uuid "61d971aa-f63d-5d90-8b35-1be41f05b791" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{121}{2}" :db/id #edb/ref 17592186489472}] :answer-field/correct {:answer/id #uuid "04f7d473-2d4b-516c-9268-0b2806d1a4ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{99}{2}" :db/id #edb/ref 17592186489463} :answer-field/id #uuid "ed73cf49-1aff-5c8e-afb5-67724f07dc37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489494}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "44191e59-3ef1-56f2-b3ae-15156e95a80d" :question/problem "What is the slope of the tangent line to the curve $y=22 x - 55 \\cos{\\left(x \\right)}$ at the point $x=\\frac{\\pi}{6}$?" :question/worked-solution "The slope is the derivative evaluated at $x=\\frac{\\pi}{6}.$\n\nWe know that $\\frac{\\text{d}}{\\text{d}x}(\\sin x)=\\cos x,$ and that $\\frac{\\text{d}}{\\text{d}x}(\\cos x)=-\\sin x.$ Applying these formulas and the sum and constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} &= \\frac{\\text{d}}{\\text{d}x}(22 x - 55 \\cos{\\left(x \\right)}) \\\\ &= (55 \\sin{\\left(x \\right)})+(22) \\\\ &= 55 \\sin{\\left(x \\right)} + 22.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi}{6},$ we get\n\n$$\ny^{\\prime}(\\frac{\\pi}{6})=22+55\\sin(\\frac{\\pi}{6})=22+55\\left(\\frac{1}{2}\\right)=\\frac{99}{2}.\n$$\n\nTherefore, the slope is $\\frac{99}{2}.$"} {:db/id #edb/ref 17592186489478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66e44a42-d9ae-5df3-8081-ebea64b