76048" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236980}] :answer-field/correct {:answer/id #uuid "b7289c68-237a-522e-b56e-57064d776048" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236980} :answer-field/id #uuid "88322035-f59b-5d15-97b6-79b1ff1b2397" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237621}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "721c17b8-891a-5aa8-81e5-901c21b4cfea" :question/math-academy-id "q-103081" :question/problem "The derivative of $y=x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{4}$ is" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(x-\\operatorname{tan}⁡x) \\\\  & =1-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & =1-{sec}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =1-(\\sqrt{2})^{2} \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4dddb2-8ce0-518b-941e-482ca5265f7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282747} {:answer/id #uuid "bc54686a-049f-5040-b7a9-b8062cc1c750" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186283321} {:answer/id #uuid "be37be01-215e-5391-bca4-f872aefba533" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186283341} {:answer/id #uuid "ea403761-0f48-5b27-a322-4bdbfaf43080" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186283735} {:answer/id #uuid "f3762c53-5b99-5615-8c9e-e78f50dd46f8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283817}] :answer-field/correct {:answer/id #uuid "7b4dddb2-8ce0-518b-941e-482ca5265f7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282747} :answer-field/id #uuid "33d75bdd-6edb-5b58-9b7f-46c8d0ecd14e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284025}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a05f390f-2f4a-5c91-9fbd-0dbf4e6d9e1b" :question/math-academy-id "q-17912" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=-tan⁡x$ when $x=\\pi .$" :question/worked-solution "The instantaneous rate of change  when $x=\\pi $ is given by the value of the derivative ${f}^{′}(x)$ at $x=\\pi .$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-tan⁡x) \\\\  & =-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\pi ,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =-{sec}^{2}⁡\\pi  \\\\  & =-1\\cdot (-1)^{2} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,  the instantaneous rate of change is $-1.$"} {:db/id #edb/ref 17592186315107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955}] :answer-field/correct {:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955} :answer-field/id #uuid "980400c0-8e83-5892-8b48-98f7e9a9af2a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314422}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d99ea33e-6fab-5224-901c-7ede7395140b" :question/math-academy-id "q-341495" :question/problem "Find ${f}^{′}(x)$ if $f(x)=4\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}+3tan⁡x) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =4(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{2}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317183 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044}] :answer-field/correct {:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044} :answer-field/id #uuid "01b8be81-ed30-5c06-b89b-3ae37ec6ccee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316550}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "04d16541-33c4-5168-abf0-25ac42f61efd" :question/math-academy-id "q-341825" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=\\operatorname{tan}⁡x-{x}^{2}$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x-{x}^{2}) \\\\  & ={sec}^{2}⁡x-2x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & ={sec}^{2}⁡(0)-2\\cdot 0 \\\\  & ={(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2}-0 \\\\  & ={(\\frac{1}{1})}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $1.$"} {:db/id #edb/ref 17592186317185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bcc3b9e-9aa6-5680-ac1b-555091e408db" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186315640}] :answer-field/correct {:answer/id #uuid "5bcc3b9e-9aa6-5680-ac1b-555091e408db" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186315640} :answer-field/id #uuid "ced27d33-b811-5c5f-93ee-716aecc76bbb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317037}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "194833de-eabd-521e-a061-701c99c91a20" :question/math-academy-id "q-341858" :question/problem "Find the slope of $y=tan⁡x+2sin⁡x$ at $x=0.$\n\n${y}^{′}(0)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(tan⁡x+2sin⁡x) \\\\  & ={sec}^{2}⁡x+2cos⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & ={sec}^{2}⁡(0)+2cos⁡(0) \\\\  & =1+2(1) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope is $3.$"} {:db/id #edb/ref 17592186329845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026a56b8-1115-5684-ac6e-ef1630e64970" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186326960} {:answer/id #uuid "0393bd6c-c00c-5794-bb05-1c8299be09b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2{sec}^{2}⁡\\sqrt{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186326972} {:answer/id #uuid "25ff194a-cfcd-58a0-adba-8bc91fdf1efe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2x{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327262} {:answer/id #uuid "44d191be-38a4-500e-8cfb-76a9d83fe2e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}sec⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327534} {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218}] :answer-field/correct {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218} :answer-field/id #uuid "39c98579-7ff9-5677-8870-c03daabb35df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329297}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "db3973ed-197d-5377-b8db-60e027e16ad0" :question/math-academy-id "q-47983" :question/problem "Find the derivative of $y=\\sqrt{x}+tan⁡x.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+tan⁡x) \\\\  & =\\frac{1}{2\\sqrt{x}}+{sec}^{2}⁡x \\\\  & =\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d90aaf-3c7e-502e-a562-e8e30a2e4f44" :answer/type {:db/ident :answer.type/math} :answer/value "6-3{cos}^{2}⁡x+4" :db/id #edb/ref 17592186336237} {:answer/id #uuid "54e94de8-7041-5cb7-8ea3-b142551e7f53" :answer/type {:db/ident :answer.type/math} :answer/value "3-6{sec}^{2}⁡x" :db/id #edb/ref 17592186336815} {:answer/id #uuid "962192cb-bb3f-5f88-bfc0-61f615078d44" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2{sec}^{2}⁡x" :db/id #edb/ref 17592186337402} {:answer/id #uuid "ab1f8bc7-61bf-53fe-b692-8455b9959c1b" :answer/type {:db/ident :answer.type/math} :answer/value "6x-6{sec}^{2}⁡x" :db/id #edb/ref 17592186337577} {:answer/id #uuid "fb2a1768-76da-50c5-bba8-68baff7dd8fd" :answer/type {:db/ident :answer.type/math} :answer/value "x-3sec⁡x+4" :db/id #edb/ref 17592186338238}] :answer-field/correct {:answer/id #uuid "ab1f8bc7-61bf-53fe-b692-8455b9959c1b" :answer/type {:db/ident :answer.type/math} :answer/value "6x-6{sec}^{2}⁡x" :db/id #edb/ref 17592186337577} :answer-field/id #uuid "05962ec1-c075-566a-ac05-4eef6517c851" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338284}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4d2fc325-5a17-5cde-b04c-927ac9646ab9" :question/math-academy-id "q-70911" :question/problem "Find ${y}^{′}$ for $y=3({x}^{2}-2tan⁡x)+4.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}(3({x}^{2}-2tan⁡x)+4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-6tan⁡x+4) \\\\  & =3\\cdot 2x-6{sec}^{2}⁡x+0 \\\\  & =6x-6{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061d1324-c902-50ac-9f19-d8b4a5784809" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{2}" :db/id #edb/ref 17592186483526} {:answer/id #uuid "4b1f1314-7647-545e-b012-8ae1c258500a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483531} {:answer/id #uuid "6dac38e5-adce-5d03-bb83-d08ba2555997" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186483533} {:answer/id #uuid "856d6ef1-16cb-533f-8b58-6fd8f077de44" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483534} {:answer/id #uuid "89742711-38f2-5693-8a77-c2b1336920a0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186483535}] :answer-field/correct {:answer/id #uuid "6dac38e5-adce-5d03-bb83-d08ba2555997" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186483533} :answer-field/id #uuid "5fe8258d-1897-5414-82b1-02fddba2f0e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483532}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "06ead9d9-ba18-5b78-9c0b-6c3f9d9d335d" :question/problem "The derivative of $y=2x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{4}$ is" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\operatorname{tan}⁡x) \\\\  & =2-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & =2-{sec}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =2-(\\sqrt{2})^{2} \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488ebcb1-34b1-54b2-bb0f-d3834972fc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}x" :db/id #edb/ref 17592186483530}] :answer-field/correct {:answer/id #uuid "488ebcb1-34b1-54b2-bb0f-d3834972fc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}x" :db/id #edb/ref 17592186483530} :answer-field/id #uuid "c9aa3437-62e4-5f8b-b2f8-54736d53760f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483536}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "16f98c04-c89a-5e4f-bf27-ed015bececed" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\sqrt{x}+2tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+2tan⁡x) \\\\  & =1\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+2\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =1(\\frac{1}{2\\sqrt{x}})+2({sec}^{2}⁡x) \\\\  & =\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285ce513-2344-54e5-878f-50e519f82f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186483529}] :answer-field/correct {:answer/id #uuid "285ce513-2344-54e5-878f-50e519f82f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186483529} :answer-field/id #uuid "e01d02f0-76ac-5033-8fce-0f78e59a051a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483537}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ec85ab69-3759-5a26-ad41-7f26f7d7092f" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+3tan⁡x) \\\\  & =1\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =1(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] [{:db/id #edb/ref 17592186064281 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064125 :question/id #uuid "2bb17470-6365-5e08-b649-f9f42146a4c6" :question/math-academy-id "e-732" :question/problem "Calculate $f'(x)$ if $f(x) = 2\\sin (3x - 1).$" :question/worked-solution "First, we express $f(x)$ as a composite function\n\n$$\nf = 2\\sin u, \\qquad u=3x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = 2\\cos u, \\qquad\\dfrac{\\textrm d u}{\\textrm d x} = 3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =2\\operatorname{cos}⁡u\\cdot 3 \\\\  & =6\\operatorname{cos}⁡u \\\\  & =6\\operatorname{cos}⁡(3x-1).\\end{aligned}\n$$"} :knowledge-point/id #uuid "73216188-6524-55c3-b945-86d13ef64170" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050420 :topic/math-academy-id 280 :topic/title "Differentiating Trigonometric Functions"} {:db/id #edb/ref 17592186051084 :topic/math-academy-id 1108 :topic/title "The Chain Rule for Differentiation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc1c1e20-e0bd-5261-a228-a6393d854e62" :answer/type {:db/ident :answer.type/math} :answer/value "x\\sin (2x)" :db/id #edb/ref 17592186061472} {:answer/id #uuid "eabd9412-f16f-51f6-9afa-a299fea0f5a2" :answer/type {:db/ident :answer.type/math} :answer/value "-x\\sin (x^{2})" :db/id #edb/ref 17592186061473} {:answer/id #uuid "ef240dd9-6a53-5d01-856e-e0dbfc93cd48" :answer/type {:db/ident :answer.type/math} :answer/value "-2x\\sin (x^{2})" :db/id #edb/ref 17592186061474} {:answer/id #uuid "3a1be5d7-ffa1-57f2-b287-c276a6a48eed" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\sin (2x)" :db/id #edb/ref 17592186061475} {:answer/id #uuid "4eff482c-db2b-5c8c-907e-a2a93e856881" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos (x^{2})" :db/id #edb/ref 17592186061476}] :answer-field/id #uuid "036a9747-914d-5a19-b770-7b65ebc0f065" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061471}] :question/id #uuid "3fce4c88-35a3-5f54-919c-8b47bd528110" :question/math-academy-id "q-1943" :question/problem "Calculate $\\frac{df}{dx}$ for $f(x) = \\cos (x^{2})$."} {:db/id #edb/ref 17592186064547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d164d79-3e8a-5a0a-be16-5e01ba43a6cd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\csc^{2} (2x + 2)" :db/id #edb/ref 17592186061478} {:answer/id #uuid "a7498bfe-4586-5ea2-90b0-47b5e1e0e983" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cot (2x + 2)" :db/id #edb/ref 17592186061479} {:answer/id #uuid "073354e8-10c4-5bb3-a6c9-b895b814bc8b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} (2x + 2)" :db/id #edb/ref 17592186061480} {:answer/id #uuid "0878a6d5-e68c-5cd4-8f21-d0d75793d8a3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec (2x + 2)" :db/id #edb/ref 17592186061481} {:answer/id #uuid "3bf4965c-6cb7-5099-abdd-6b4a478d4ddd" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2} (2x + 2)" :db/id #edb/ref 17592186061482}] :answer-field/id #uuid "4ba2a3e9-dc27-51b2-a022-1104008419eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061477}] :question/id #uuid "49ca619d-ecfe-5593-9b17-e64572a2a67e" :question/math-academy-id "q-1946" :question/problem "Find $f^{′}(x)$ for $f(x) = \\tan (2x + 2)$."} {:db/id #edb/ref 17592186233773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2998be6e-3d61-5b63-935a-7bdb143e1005" :answer/type {:db/ident :answer.type/text} :answer/value "$-4\\pi$" :db/id #edb/ref 17592186232538}] :answer-field/correct {:answer/id #uuid "2998be6e-3d61-5b63-935a-7bdb143e1005" :answer/type {:db/ident :answer.type/text} :answer/value "$-4\\pi$" :db/id #edb/ref 17592186232538} :answer-field/id #uuid "fc5ffdb9-90bc-5cec-a6a0-95ec2b95ac7b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232537}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "390498a7-88cc-5a78-b03f-2394c5362be8" :question/math-academy-id "q-310182" :question/problem "Find the slope $m$ of $y =\\sin \\left(\\pi \\left(x^{2} + 2x - 2\\right)\\right)$ at $x = 1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The slope of $y = f(x)$ at $x=1$ is given by $f'(1).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\ny = \\sin{u}, \\qquad u = \\pi \\left(x^{2} +2x - 2\\right).\n\\]\n\nDifferentiating gives\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = \\cos{u}, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = \\pi (2x + 2).\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\nf'(x) &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n\n&=\\cos u \\cdot \\pi (2x+2)\\\\[5pt]\n\n&=\\pi (2x+2)\\cos u\\\\[5pt]\n\n&=\\pi (2x+2)\\cos \\left(  \\pi \\left(x^{2} +2x - 2\\right) \\right).\n\\end{align*}\n\nEvaluating at $x=1,$ we find\n\n\\begin{align}\nf'(1) & =\\pi (2\\cdot1+2)\\cos \\left(  \\pi \\left(1^{2} +2\\cdot1 - 2\\right) \\right) \\\\[3pt]\n\n& =4\\pi \\cos(\\pi) \\\\[3pt]\n&= 4\\pi \\cdot (-1) \\\\[3pt]\n&= -4\\pi\n\\end{align}\n\nTherefore, the slope $m$ of $y = f(x)$ at $x = 1$ is \n\\[\nm = f'(1) = \\bbox[4pt, border: 1px solid lightgray]{-4\\pi}.\n\\]"} {:db/id #edb/ref 17592186233777 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "97de5fad-6e5e-571a-91b7-dfa67983b9d4" :question/math-academy-id "q-31241" :question/problem "Find the slope of $y=\\operatorname{sin}({x}^{2}+2x-1)$ at $x=0.$" :question/worked-solution "The slope of $y=f(x)$ at $x=0$ is given by ${f}^{'}(0).$\n\nWe will calculate ${f}^{'}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=\\operatorname{sin}u,\\,u={x}^{2}+2x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\operatorname{cos}u,\\,\\frac{\\text{d}u}{\\text{d}x}=2x+2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\operatorname{cos}u\\cdot (2x+2) \\\\  & =(2x+2)\\operatorname{cos}u \\\\  & =(2x+2)\\operatorname{cos}({x}^{2}+2x-1).\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we find\n\n$$\n\\begin{aligned}{f}^{'}(0) & =(2\\cdot 0+2)\\operatorname{cos}({0}^{2}+2\\cdot 0-1) \\\\  & =2\\operatorname{cos}(-1) \\\\  & =2\\operatorname{cos}1\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=0$ is $2\\operatorname{cos}1.$"} {:db/id #edb/ref 17592186234093 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2bc06eae-ad0a-5d3a-b849-103c9ea4b53e" :question/math-academy-id "q-48508" :question/problem "Find the equation of the tangent to the curve $y = \\cos (5x-2 )$ at the point $\\left(\\dfrac 2 5,1\\right).$" :question/worked-solution "The slope of $y = f(x)$ at $x=\\dfrac 2 5$ is given by $f'\\left(\\dfrac 2 5\\right).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\ny = \\cos{u}, \\qquad u = 5x-2.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = -\\sin u \\qquad \\style{font-family:inherit;}{\\text{and}} \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = 5.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\nf'(x) &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=-\\sin u \\cdot 5\\\\[5pt]\n&=-5\\sin u\\\\[5pt]\n&= -5\\sin\\left(5x-2 \\right).\n\\end{align*}\n\nEvaluating at $x=\\dfrac 25,$ we find\n\n\\begin{eqnarray}\n \\eqalign{\n\nm=f'\\left(\\dfrac 25\\right)  & =- 5 \\sin \\left(5\\cdot \\dfrac 2 5-2\\right)\\\\[5pt] \n\t\t& =- 5 \\sin 0\\\\[5pt]\n\t\t&= 0.\n \n       \n    }\n\\end{eqnarray}\nFinally, we find the equation of the tangent at the point $\\left(\\dfrac 2 5,1\\right) \\mathbin{:}$\n\n\\begin{align*}\ny-y_1&=m(x-x_1)\\\\[5pt]\ny-1&=0\\left(x-\\dfrac{2}{5}\\right)\\\\[5pt]\ny-1&=0\\\\[5pt]\ny&=1.\n\\end{align*}"} {:db/id #edb/ref 17592186234096 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6400ab63-050a-5a93-a765-8b1d07a079a0" :question/math-academy-id "q-48636" :question/problem "Find the equation of the tangent to the curve $f(x) = \\cos{\\left(x^3\\right)}$ at the point $\\left(0,1\\right).$" :question/worked-solution "First, the slope of $y = f(x)$ at $x = 0$ is given by $f'(0).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\ny = \\cos{u}, \\qquad u = x^3.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = -\\sin{u}, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} =3x^2.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\n\\dfrac{\\textrm d y}{\\textrm d x} &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n\n&= -\\sin{u} \\cdot 3x^2\\\\[5pt]\n\n&=-3x^2\\sin(x^3).\n\\end{align*}\n\nEvaluating at $x=0,$ we find\n\\begin{align}\nm=f'(0) & = -3(0)^2\\sin(0^3) = 0.\n\\end{align}\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\\begin{align}\ny - y_1 & = m(x - x_1)\\\\[3pt]\n\ny - 1 & = 0 \\cdot \\left(x - 0 \\right)\\\\[3pt]\n\ny - 1 & = 0\\\\[3pt]\n\ny & =1.\n\\end{align}"} {:db/id #edb/ref 17592186297322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c11aa0cd-50a9-55f9-b43c-ec6085afea6d" :answer/type {:db/ident :answer.type/math} :answer/value "12{x}^{3}{sec}^{2}(3{x}^{4}-5)" :db/id #edb/ref 17592186296287}] :answer-field/correct {:answer/id #uuid "c11aa0cd-50a9-55f9-b43c-ec6085afea6d" :answer/type {:db/ident :answer.type/math} :answer/value "12{x}^{3}{sec}^{2}(3{x}^{4}-5)" :db/id #edb/ref 17592186296287} :answer-field/id #uuid "41d54636-77f2-54cb-a399-2372401bb451" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296758}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a87f80fe-d2d2-50e5-bf92-8b685bd67b58" :question/math-academy-id "q-310179" :question/problem "Given that $y=\\operatorname{tan}⁡(3{x}^{4}-5)$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as a composite function\n\n$$\ny=\\operatorname{tan}⁡u,\\,u=3{x}^{4}-5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={sec}^{2}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=12{x}^{3}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={sec}^{2}⁡u\\cdot 12{x}^{3} \\\\  & =12{x}^{3}{sec}^{2}⁡u \\\\  & =12{x}^{3}{sec}^{2}⁡(3{x}^{4}-5).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e6eb30f-5bfc-5e1d-a01c-0f6eb7e00e8d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295719}] :answer-field/correct {:answer/id #uuid "4e6eb30f-5bfc-5e1d-a01c-0f6eb7e00e8d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295719} :answer-field/id #uuid "a8643e81-9ec6-59f8-9881-f0c74f9799e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296991}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4c450049-c1ac-524d-8d79-0a2c2ad034fe" :question/math-academy-id "q-310180" :question/problem "Find the slope $m$ of the tangent to the curve $y=\\operatorname{sin}⁡(3x)$ at $x=\\frac{\\pi }{6}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{6}$ is given by ${f}^{′}(\\frac{\\pi }{6}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=\\operatorname{sin}⁡u,\\,u=3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\operatorname{cos}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =(\\operatorname{cos}⁡u)\\cdot 3 \\\\  & =3\\operatorname{cos}⁡(3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{6},$ we find\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{6}) & =3\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{6}) \\\\  & =3\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of $y=f(x)$ at $x=\\frac{\\pi }{6}$ is \n\n$$\nm={f}^{′}(\\frac{\\pi }{6})=0.\n$$"} {:db/id #edb/ref 17592186297328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d50494a-917e-5fc9-aaca-421ef13620f4" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡11" :db/id #edb/ref 17592186295342} {:answer/id #uuid "3aba53ad-193b-5d70-873b-c0e3c7c67902" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{cos}⁡11" :db/id #edb/ref 17592186295604} {:answer/id #uuid "cf3a18b3-703f-5be8-adc1-aabd15547f90" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{cos}⁡2" :db/id #edb/ref 17592186296355} {:answer/id #uuid "d11f2b61-41fa-5a40-9644-c5fb5f1d15b0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{cos}⁡11" :db/id #edb/ref 17592186296366} {:answer/id #uuid "fba457fb-4dfa-5ba5-ab35-1a6884267105" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{cos}⁡11" :db/id #edb/ref 17592186296608}] :answer-field/correct {:answer/id #uuid "0d50494a-917e-5fc9-aaca-421ef13620f4" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡11" :db/id #edb/ref 17592186295342} :answer-field/id #uuid "b67cf090-cb84-5901-9453-1f707812d0f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297014}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d3355be-a5a0-56e5-8db1-b9c9b33d002a" :question/math-academy-id "q-31153" :question/problem "Find the slope of the tangent to the curve $y=\\operatorname{sin}⁡(3x+5)$ at the point where $x=2.$" :question/worked-solution "The slope of $y=f(x)$ at $x=2$ is given by ${f}^{′}(2).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=\\operatorname{sin}⁡u,\\,u=3x+5.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\operatorname{cos}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =(\\operatorname{cos}⁡u)\\cdot 3 \\\\  & =3\\operatorname{cos}⁡(3x+5).\\end{aligned}\n$$\n\nEvaluating at $x=2,$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(2) & =3\\operatorname{cos}⁡(3\\cdot 2+5) \\\\  & =3\\operatorname{cos}⁡11.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=2$ is $3\\operatorname{cos}⁡11.$"} {:db/id #edb/ref 17592186297329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "839fa6c2-077d-5ff2-ac87-202c88b24d73" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡(11-2x)-9{x}^{2}" :db/id #edb/ref 17592186295972} {:answer/id #uuid "845a86c6-af92-5003-9e84-abb01c1b1037" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(11-2x)-9{x}^{2}" :db/id #edb/ref 17592186295976} {:answer/id #uuid "ae90c9d3-49ef-5560-b2b9-97ed8b3e467b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(11-2x)-18{x}^{2}" :db/id #edb/ref 17592186296188} {:answer/id #uuid "e92d5c94-4ae2-53dc-bf2b-f28a16b6d315" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(11-2x)-18{x}^{2}" :db/id #edb/ref 17592186296508} {:answer/id #uuid "e99e59dc-3c45-58f0-abbc-809678feb2fd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(11-2x)-18{x}^{2}" :db/id #edb/ref 17592186296511}] :answer-field/correct {:answer/id #uuid "e99e59dc-3c45-58f0-abbc-809678feb2fd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(11-2x)-18{x}^{2}" :db/id #edb/ref 17592186296511} :answer-field/id #uuid "e16ad6c1-d476-5dae-b48f-bee5ac9ba27e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297098}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a15a3bf2-ccf2-5108-b6fe-372cf79c1d17" :question/math-academy-id "q-31163" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{cos}⁡(11-2x)-6{x}^{3}.$" :question/worked-solution "Let $g(x)=\\operatorname{cos}⁡(11-2x)$ and $h(x)=-6{x}^{3}.$ Then,\n\n$$\n\\begin{aligned}f(x) & =g(x)+h(x).\\end{aligned}\n$$\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\operatorname{cos}⁡(11-2x)$ as the composite function\n\n$$\ng=\\operatorname{cos}⁡u,\\,u=11-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}g}{\\text{d}u}=-\\operatorname{sin}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}g}{\\text{d}x} & =\\frac{\\text{d}g}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-\\operatorname{sin}⁡u\\cdot (-2) \\\\  & =2\\operatorname{sin}⁡u \\\\  & =2\\operatorname{sin}⁡(11-2x)\\end{aligned}\n$$\n\nNext, we differentiate $h(x)=-6{x}^{3}.$ \n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}h}{\\text{d}x}=-18{x}^{2}\n$$\n\nHence,\n\n$$\n{f}^{′}(x)={g}^{′}(x)+{h}^{′}(x)=2\\operatorname{sin}⁡(11-2x)-18{x}^{2}.\n$$"} {:db/id #edb/ref 17592186332841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3975e3e3-190d-50c6-a1fa-2372d4812b2a" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-\\pi -3" :db/id #edb/ref 17592186330465} {:answer/id #uuid "86d8dbc9-4448-5893-85ef-2de9fe4cbe8d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x+\\pi -2" :db/id #edb/ref 17592186331151} {:answer/id #uuid "8cb1a78b-64dd-5b14-bc5f-ce06a27bb9ec" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186331200} {:answer/id #uuid "9617b878-c4f0-5d98-8d9b-dbb4117349ac" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x+2\\pi " :db/id #edb/ref 17592186331282} {:answer/id #uuid "afe48e27-93ba-5a98-8584-1499283d0a82" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186331508}] :answer-field/correct {:answer/id #uuid "8cb1a78b-64dd-5b14-bc5f-ce06a27bb9ec" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186331200} :answer-field/id #uuid "3d979568-c652-583d-8844-6e678e24e5e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332303}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9ea4e0db-90cb-5911-bc10-79d17635a4f1" :question/math-academy-id "q-51026" :question/problem "Find the equation of the tangent to the curve $y=2\\operatorname{cos}⁡(x-1)$ at the point $(1+\\pi ,-2).$" :question/worked-solution "First, the slope of $y=f(x)$ at $x=1+\\pi $ is given by ${f}^{′}(1+\\pi ).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=2\\operatorname{cos}⁡u,\\,u=x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-2\\operatorname{sin}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2\\operatorname{sin}⁡u\\cdot 1 \\\\  & =-2\\operatorname{sin}⁡(x-1).\\end{aligned}\n$$\n\nEvaluating at $x=1+\\pi ,$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}m={f}^{′}(1+\\pi ) & =-2\\operatorname{sin}⁡(1+\\pi -1) \\\\  & =-2\\operatorname{sin}⁡(\\pi ) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(1+\\pi ,-2):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =0(x-(1+\\pi )) \\\\ y+2 & =0 \\\\ y & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c21bebd-faa9-5e47-86d5-105935cf93a9" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186491413} {:answer/id #uuid "8609c4ba-b913-512c-b515-0998e93e7785" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 12 x + 12 \\pi" :db/id #edb/ref 17592186491415} {:answer/id #uuid "e306351b-f7b2-5a3a-a137-067728da4a2d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x - 13 - \\pi" :db/id #edb/ref 17592186491429} {:answer/id #uuid "e6f5eaf7-7a98-5396-8b85-e5a1ae4f1cf7" :answer/type {:db/ident :answer.type/math} :answer/value "y=-12" :db/id #edb/ref 17592186491430} {:answer/id #uuid "f8e39cff-3a0b-561b-aed8-6264adb9a14b" :answer/type {:db/ident :answer.type/math} :answer/value "y=x - 12 + \\pi" :db/id #edb/ref 17592186491437}] :answer-field/correct {:answer/id #uuid "e6f5eaf7-7a98-5396-8b85-e5a1ae4f1cf7" :answer/type {:db/ident :answer.type/math} :answer/value "y=-12" :db/id #edb/ref 17592186491430} :answer-field/id #uuid "fffaf1e8-370e-5f04-8dfc-a0db9cc43904" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491439}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a8a0d3c1-7c1b-5f34-8315-2483a617ccdf" :question/problem "Find the equation of the tangent to the curve $y=12\\operatorname{cos}⁡(x-1)$ at the point $(1+\\pi ,-12).$\n\n{{selection}}" :question/worked-solution "First, the slope of $y=f(x)$ at $x=1+\\pi $ is given by ${f}^{′}(1+\\pi ).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=12\\operatorname{cos}⁡u,\\,u=x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-12\\operatorname{sin}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-12\\operatorname{sin}⁡u\\cdot 1 \\\\  & =-12\\operatorname{sin}⁡(x-1).\\end{aligned}\n$$\n\nEvaluating at $x=1+\\pi ,$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}m={f}^{′}(1+\\pi ) & =-12\\operatorname{sin}⁡(1+\\pi -1) \\\\  & =-12\\operatorname{sin}⁡(\\pi ) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(1+\\pi ,-12):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-12) & =0(x-(1+\\pi )) \\\\ y+12 & =0 \\\\ y & =-12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5d2b87e-a9e3-5258-b683-b2c75b9d67c3" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186491420} {:answer/id #uuid "cc514de1-4d5e-554f-a6ba-78fec0fab754" :answer/type {:db/ident :answer.type/math} :answer/value "y=x - 3 + \\pi" :db/id #edb/ref 17592186491424} {:answer/id #uuid "dcccecec-d6e1-5ee8-a79b-04a97a794dcf" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186491427} {:answer/id #uuid "e93d0b7a-c9db-5772-a1b5-36e791646ba3" :answer/type {:db/ident :answer.type/math} :answer/value "y=x - 4 - \\pi" :db/id #edb/ref 17592186491431} {:answer/id #uuid "f4e4f64c-13d8-53d9-a08b-47cebaf795b4" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 3 x + 3 \\pi" :db/id #edb/ref 17592186491435}] :answer-field/correct {:answer/id #uuid "a5d2b87e-a9e3-5258-b683-b2c75b9d67c3" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186491420} :answer-field/id #uuid "9207df1b-4a6c-533b-b78e-f5d2674e1371" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491417}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cf807996-e431-5716-aed7-89d8d85c588a" :question/problem "Find the equation of the tangent to the curve $y=3\\operatorname{cos}⁡(x-1)$ at the point $(1+\\pi ,-3).$\n\n{{selection}}" :question/worked-solution "First, the slope of $y=f(x)$ at $x=1+\\pi $ is given by ${f}^{′}(1+\\pi ).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=3\\operatorname{cos}⁡u,\\,u=x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-3\\operatorname{sin}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-3\\operatorname{sin}⁡u\\cdot 1 \\\\  & =-3\\operatorname{sin}⁡(x-1).\\end{aligned}\n$$\n\nEvaluating at $x=1+\\pi ,$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}m={f}^{′}(1+\\pi ) & =-3\\operatorname{sin}⁡(1+\\pi -1) \\\\  & =-3\\operatorname{sin}⁡(\\pi ) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(1+\\pi ,-3):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-3) & =0(x-(1+\\pi )) \\\\ y+3 & =0 \\\\ y & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186491432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f18fe80-b975-5243-8971-ac37a514c459" :answer/type {:db/ident :answer.type/math} :answer/value "- 18 x^{2} - \\sin{\\left(2 x - 12 \\right)}" :db/id #edb/ref 17592186491412} {:answer/id #uuid "866b680e-b95e-59e9-a274-19e8c2a75d6d" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 x^{2} - \\cos{\\left(2 x - 12 \\right)}" :db/id #edb/ref 17592186491416} {:answer/id #uuid "a2356a72-59b5-5c9c-b674-716424d158d1" :answer/type {:db/ident :answer.type/math} :answer/value "- 18 x^{2} + 2 \\cos{\\left(2 x - 12 \\right)}" :db/id #edb/ref 17592186491419} {:answer/id #uuid "d43c8d95-d21a-5c9b-9163-9316a2bc2a68" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 x^{2} + 2 \\sin{\\left(2 x - 12 \\right)}" :db/id #edb/ref 17592186491426} {:answer/id #uuid "ef497264-895e-54be-869a-0733bc78f89e" :answer/type {:db/ident :answer.type/math} :answer/value "- 18 x^{2} - 2 \\sin{\\left(2 x - 12 \\right)}" :db/id #edb/ref 17592186491433}] :answer-field/correct {:answer/id #uuid "ef497264-895e-54be-869a-0733bc78f89e" :answer/type {:db/ident :answer.type/math} :answer/value "- 18 x^{2} - 2 \\sin{\\left(2 x - 12 \\right)}" :db/id #edb/ref 17592186491433} :answer-field/id #uuid "0908c732-21de-5c29-bd3c-fcc27be47e16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491409}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "edc669f2-8811-573d-b7ea-ebf03a0592e1" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{cos}⁡(12-2x)-6{x}^{3}.$\n\n{{selection}}" :question/worked-solution "Let $g(x)=\\operatorname{cos}⁡(12-2x)$ and $h(x)=-6{x}^{3}.$ Then,\n\n$$\n\\begin{aligned}f(x) & =g(x)+h(x).\\end{aligned}\n$$\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\operatorname{cos}⁡(12-2x)$ as the composite function\n\n$$\ng=\\operatorname{cos}⁡u,\\,u=12-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}g}{\\text{d}u}=-\\operatorname{sin}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}g}{\\text{d}x} & =\\frac{\\text{d}g}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-\\operatorname{sin}⁡u\\cdot (-2) \\\\  & =2\\operatorname{sin}⁡u \\\\  & =2\\operatorname{sin}⁡(12-2x)\\end{aligned}\n$$\n\nNext, we differentiate $h(x)=-6{x}^{3}.$ \n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}h}{\\text{d}x}=-18{x}^{2}\n$$\n\nHence,\n\n$$\n{f}^{′}(x)={g}^{′}(x)+{h}^{′}(x)=2\\operatorname{sin}⁡(12-2x)-18{x}^{2}.\n$$"} {:db/id #edb/ref 17592186491434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "340044b2-b48d-5eb9-817c-624479f49ac2" :answer/type {:db/ident :answer.type/math} :answer/value "18 \\pi" :db/id #edb/ref 17592186491411}] :answer-field/correct {:answer/id #uuid "340044b2-b48d-5eb9-817c-624479f49ac2" :answer/type {:db/ident :answer.type/math} :answer/value "18 \\pi" :db/id #edb/ref 17592186491411} :answer-field/id #uuid "a8942c70-e5be-58bd-9441-c89f4912e367" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186491421}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "efb4aba1-7652-55ac-8883-4dc872ffd09b" :question/problem "Find the slope $m$ of $y =\\sin \\left(\\pi \\left(8x^{2} + 2x - 2\\right)\\right)$ at $x = 1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The slope of $y = f(x)$ at $x=1$ is given by $f'(1).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\ny = \\sin{u}, \\qquad u = \\pi \\left(8x^{2} +2x - 2\\right).\n\\]\n\nDifferentiating gives\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = \\cos{u}, \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = \\pi (16x + 2).\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\nf'(x) &= \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n\n&=\\cos u \\cdot \\pi (16x+2)\\\\[5pt]\n\n&=\\pi (16x+2)\\cos u\\\\[5pt]\n\n&=\\pi (16x+2)\\cos \\left(  \\pi \\left(8x^{2} +2x - 2\\right) \\right).\n\\end{align*}\n\nEvaluating at $x=1,$ we find\n\n\\begin{align}\nf'(1) & =\\pi (16\\cdot1+2)\\cos \\left(  \\pi \\left(8\\cdot1^{2} +2\\cdot1 - 2\\right) \\right) \\\\[3pt]\n\n& =18\\pi \\cos(8\\pi) \\\\[3pt]\n&= 18\\pi \\cdot (1) \\\\[3pt]\n&= 18 \\pi\n\\end{align}\n\nTherefore, the slope $m$ of $y = f(x)$ at $x = 1$ is \n\\[\nm = f'(1) = \\bbox[4pt, border: 1px solid lightgray]{18 \\pi}.\n\\]"} {:db/id #edb/ref 17592186491436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1117cafb-bea7-5676-bd0f-63daf7595db3" :answer/type {:db/ident :answer.type/math} :answer/value "y=- 11 x + 11 \\pi" :db/id #edb/ref 17592186491410} {:answer/id #uuid "76c93819-5f94-5f71-9207-90527902ad17" :answer/type {:db/ident :answer.type/math} :answer/value "y=-11" :db/id #edb/ref 17592186491414} {:answer/id #uuid "aba5c3d1-b904-56ff-b6f0-a46b86905b0d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x - 12 - \\pi" :db/id #edb/ref 17592186491423} {:answer/id #uuid "dd23d842-a5d1-5918-948e-36db4983f82a" :answer/type {:db/ident :answer.type/math} :answer/value "y=x - 11 + \\pi" :db/id #edb/ref 17592186491428} {:answer/id #uuid "fa02d377-8768-52fe-b201-deaea37828d7" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186491438}] :answer-field/correct {:answer/id #uuid "76c93819-5f94-5f71-9207-90527902ad17" :answer/type {:db/ident :answer.type/math} :answer/value "y=-11" :db/id #edb/ref 17592186491414} :answer-field/id #uuid "9c494561-b4d8-5b70-a243-062936e00deb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491418}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f70d4be3-a4f6-5618-b5df-d3aca4e557dc" :question/problem "Find the equation of the tangent to the curve $y=11\\operatorname{cos}⁡(x-1)$ at the point $(1+\\pi ,-11).$\n\n{{selection}}" :question/worked-solution "First, the slope of $y=f(x)$ at $x=1+\\pi $ is given by ${f}^{′}(1+\\pi ).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\ny=11\\operatorname{cos}⁡u,\\,u=x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-11\\operatorname{sin}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-11\\operatorname{sin}⁡u\\cdot 1 \\\\  & =-11\\operatorname{sin}⁡(x-1).\\end{aligned}\n$$\n\nEvaluating at $x=1+\\pi ,$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}m={f}^{′}(1+\\pi ) & =-11\\operatorname{sin}⁡(1+\\pi -1) \\\\  & =-11\\operatorname{sin}⁡(\\pi ) \\\\  & =0.\\end{aligned}\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(1+\\pi ,-11):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-11) & =0(x-(1+\\pi )) \\\\ y+11 & =0 \\\\ y & =-11.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Trigonometric Function Using the Chain Rule"}] [{:db/id #edb/ref 17592186064282 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064126 :question/id #uuid "7f56b401-c800-5708-8978-b84ce3f542f5" :question/math-academy-id "e-733" :question/problem "Calculate $\\dfrac{\\textrm d y}{\\textrm d x}$ if $y = 4\\csc (5x + 3).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny = 4 \\csc u, \\qquad u = 5x+3.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = -4\\csc u\\cot u, \\qquad\\dfrac{\\textrm d u}{\\textrm d x} = 5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-4\\operatorname{csc}⁡u\\operatorname{cot}⁡u\\cdot 5 \\\\  & =-20\\operatorname{csc}⁡u\\operatorname{cot}⁡u \\\\  & =-20\\operatorname{csc}⁡(5x+3)\\operatorname{cot}⁡(5x+3).\\end{aligned}\n$$"} :knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050985 :topic/math-academy-id 1686 :topic/title "Differentiating Reciprocal Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80e18e26-df33-506e-8bb4-fd67abf883da" :answer/type {:db/ident :answer.type/math} :answer/value "3\\csc (x + 1)" :db/id #edb/ref 17592186062462} {:answer/id #uuid "96261f6d-e124-50ee-989b-9ff7298343ac" :answer/type {:db/ident :answer.type/math} :answer/value "-\\csc (x + 1)" :db/id #edb/ref 17592186062463} {:answer/id #uuid "a925357e-c0f8-5aa5-bc2c-e4eef645c841" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc^{2} (x + 1)" :db/id #edb/ref 17592186062464} {:answer/id #uuid "d40c0fa2-6167-5dc2-9bb7-99b4e980ab95" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\csc^{2} (x + 1)" :db/id #edb/ref 17592186062465} {:answer/id #uuid "7963297f-ee9b-56b9-bba5-8ac5abe22591" :answer/type {:db/ident :answer.type/math} :answer/value "3\\csc^{2} (x + 1)" :db/id #edb/ref 17592186062466}] :answer-field/id #uuid "dbc7d811-b62b-5dec-8746-f6cf0f61ed5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062461}] :question/id #uuid "1b616b61-30a4-583a-b6e7-fb2d2865a061" :question/math-academy-id "q-31330" :question/problem "Calculate $\\frac{dy}{dx}$ for $y = 3\\cot (x + 1)$."} {:db/id #edb/ref 17592186064832 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86cbc052-d057-5ca3-a021-474dba6e77d0" :answer/type {:db/ident :answer.type/math} :answer/value "(24x^{2} + 1)\\sec^{2} (8x^{3} + 1)" :db/id #edb/ref 17592186063050} {:answer/id #uuid "b95a509d-da65-581c-b466-479585827a1f" :answer/type {:db/ident :answer.type/math} :answer/value "(24x^{2} + 1)\\sec (8x^{3} + 1)\\tan (8x^{3} + 1)" :db/id #edb/ref 17592186063051} {:answer/id #uuid "dfeb07af-d7b6-5a2a-a0d0-3b87a062a9b7" :answer/type {:db/ident :answer.type/math} :answer/value "24x^{2}\\sec (8x^{3} + 1)\\tan (8x^{3} + 1)" :db/id #edb/ref 17592186063052} {:answer/id #uuid "22e39583-b9b0-58e4-9389-3b2c45384e99" :answer/type {:db/ident :answer.type/math} :answer/value "24x^{2}\\sec^{2} (8x^{3} + 1)\\tan (8x^{3} + 1)" :db/id #edb/ref 17592186063053} {:answer/id #uuid "57078df4-2b95-5600-bb2c-aecfa9f3b363" :answer/type {:db/ident :answer.type/math} :answer/value "24x^{2}\\tan (8x^{3} + 1)" :db/id #edb/ref 17592186063054}] :answer-field/id #uuid "9fb94899-b5df-5cb3-89dd-067026d00d62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063049}] :question/id #uuid "939bf80b-4d9e-564c-8cda-c93dfb10c69c" :question/math-academy-id "q-48640" :question/problem "Given that $y = \\sec (8x^{3} + 1)$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186233784 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2237c092-e55e-5faa-952c-040582df86cd" :question/math-academy-id "q-31333" :question/problem "Calculate $\\dfrac {\\textrm d y}{\\textrm d x}$ for $y =8\\csc(10x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n\\[\ny = 8\\csc{u}, \\qquad u = 10x\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d y}{\\textrm d u} = -8\\csc u \\cot u \\qquad \\style{font-family:inherit;}{\\text{and}} \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = 10.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\n\\dfrac{\\textrm d y}{\\textrm d x} & = \\dfrac{\\textrm d y}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=-8\\csc u \\cot u \\cdot (10)\\\\[5pt]\n&=-80\\csc u \\cot u \\\\[5pt]\n&=-80\\csc (10x) \\cot (10x).\n\\end{align*}"} {:db/id #edb/ref 17592186233786 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "08700159-7288-5d29-bd3f-48a4fec9efd3" :question/math-academy-id "q-31341" :question/problem "Find the slope of the tangent to the curve $y=\\cot\\left(1-\\dfrac x 5 \\right)$ at the point where $x =1.$" :question/worked-solution "The slope of $y = f(x)$ at $x=1$ is given by $f'(1).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n\\[\nf = \\cot{u}, \\qquad u = 1-\\dfrac x 5.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d f}{\\textrm d u} = -\\csc^2 u \\qquad \\text{and}\\qquad \\dfrac{\\textrm d u}{\\textrm d x} = -\\dfrac{1}{5}.\n\\]\n\nWe now apply the chain rule, and get\n\n\\begin{align*}\n\\dfrac{\\textrm d f}{\\textrm d x} &= \\dfrac{\\textrm d f}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=-\\csc^2 u \\cdot  \\left( -\\dfrac{1}{5}\\right)\\\\[5pt]\n&= \\dfrac{1}{5}\\csc^2 \\left(1-\\dfrac{x}{5}\\right).\n\\end{align*}\n\nEvaluating at $x=1,$ we find\n\n\\begin{eqnarray}\n    \\eqalign{\n\nf'(x) & =\\dfrac 1 5\\csc^2\\left(1-\\dfrac 1 5 \\right) \\\\[3pt]\n\t& =\\dfrac 1 5\\csc^2\\left(\\dfrac 4 5 \\right) .\n       \n    }\n\\end{eqnarray}\nTherefore, the slope of the tangent to the curve $y = f(x)$ at $x = 1$ is $\\dfrac{1}{5}\\csc^2\\left(\\dfrac{4}{5}\\right).$"} {:db/id #edb/ref 17592186233932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52c44924-d8e9-5fbd-b199-533c02ea22db" :answer/type {:db/ident :answer.type/text} :answer/value "$\\pi\\sqrt{2}$" :db/id #edb/ref 17592186232881}] :answer-field/correct {:answer/id #uuid "52c44924-d8e9-5fbd-b199-533c02ea22db" :answer/type {:db/ident :answer.type/text} :answer/value "$\\pi\\sqrt{2}$" :db/id #edb/ref 17592186232881} :answer-field/id #uuid "d7882970-45d5-5a12-b222-7fd793dc58e7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232880}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "463cd378-4bb3-58ba-b4a9-7c4b66c3df42" :question/math-academy-id "q-342405" :question/problem "Find the slope $m$ of $f(x) = \\sec\\left(\\pi x^{2}\\right)$ at $x = \\dfrac{1}{2}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, the slope of $y = f(x)$ at $x = \\dfrac{1}{2}$ is given by $f'\\left( \\dfrac{1}{2} \\right).$\n\nWe will calculate $f'(x)$ using the chain rule. We express $f(x)$ as the composite function\n\\[\nf = \\sec{u}, \\qquad u = \\pi x^{2}.\n\\]\n\nDifferentiating gives\n\\[\n\\dfrac{\\textrm d f}{\\textrm d u} = \\sec{u}\\tan{u}, \\qquad\\dfrac{\\textrm d u}{\\textrm d x} = 2\\pi x.\n\\]\n\nWe now apply the chain rule, and get\n\\begin{align*}\n\\dfrac{\\textrm d f}{\\textrm d x} & = \\dfrac{\\textrm d f}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n\n&= \\sec{u}\\tan{u} \\cdot 2\\pi x \\\\[5pt]\n\n&= 2\\pi x \\sec{\\left(\\pi x^{2}\\right)}\\tan{\\left(\\pi x^{2}\\right)}.\n\\end{align*}\n\nEvaluating at $x=\\dfrac{1}{2}$, we find \n\\begin{eqnarray}\n \\eqalign{\nf'\\left( \\dfrac{1}{2} \\right) &= 2\\pi \\cdot \\dfrac{1}{2}\\cdot \\sec{\\left[\\pi\\cdot\\left(\\dfrac{1}{2}\\right)^{2}\\right]}\\tan{\\left[\\pi\\cdot\\left(\\dfrac{1}{2}\\right)^{2}\\right]} \\\\[5pt]\n&= \\pi \\sec{\\left(\\dfrac{\\pi}{4}\\right)} \\tan{\\left(\\dfrac{\\pi}{4}\\right)} \\\\[5pt]\n&= \\pi \\cdot \\sqrt{2}\\cdot 1 \\\\[5pt]\n&= \\pi\\sqrt{2}.}\n\\end{eqnarray}\n\nTherefore, the slope of $y = f(x)$ at $x=\\dfrac{1}{2}$ is $\\bbox[4pt, border: 1px solid lightgray]{\\pi\\sqrt{2}}.$"} {:db/id #edb/ref 17592186233933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143769f0-011c-5a89-a8d1-3274d68dc818" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\pi\\sqrt{3}$" :db/id #edb/ref 17592186232883}] :answer-field/correct {:answer/id #uuid "143769f0-011c-5a89-a8d1-3274d68dc818" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\pi\\sqrt{3}$" :db/id #edb/ref 17592186232883} :answer-field/id #uuid "7734e075-ee26-5d23-82fa-3daceee46549" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232882} {:answer-field/choices [{:answer/id #uuid "ec951508-5df0-544e-811e-06de9fdab3c8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\pi\\sqrt{3}+2$" :db/id #edb/ref 17592186232885}] :answer-field/correct {:answer/id #uuid "ec951508-5df0-544e-811e-06de9fdab3c8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\pi\\sqrt{3}+2$" :db/id #edb/ref 17592186232885} :answer-field/id #uuid "accc5c10-3717-5651-9bd6-da6794647764" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232884}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0be3be5b-a8d5-5056-abe1-e704e1cd0a66" :question/math-academy-id "q-342412" :question/problem "Find the equation of the tangent to the curve $f(x) = \\csc{\\left(\\dfrac{\\pi x^{3}}{6}\\right)}$ at the point $(1,2).$\n\n$y =$\n{{field-1}}$x \\: + \\:$\n{{field-2}}" :question/worked-solution "First, the slope of $y = f(x)$ at $x = 1$ is given by $f'(1).$\n\nWe will calculate $f'(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\\[\nf = \\csc{u}, \\qquad u = \\dfrac{\\pi x^{3}}{6}.\n\\]\n\nDifferentiating gives\n\\[\n\\dfrac{\\textrm d f}{\\textrm d u} = -\\csc{u}\\cot{u}  \\qquad \\text{and} \\qquad \\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{\\pi}{2} x^{2}.\n\\]\n\nWe now apply the chain rule, and get\n\\begin{align*}\n\\dfrac{\\textrm d f}{\\textrm d x} &= \\dfrac{\\textrm d f}{\\textrm d u} \\cdot \\dfrac{\\textrm d u}{\\textrm d x}\\\\[5pt]\n&=\\left(-\\csc{u}\\cot{u}\\right) \\cdot \\dfrac{\\pi}{2} x^{2} \\\\[5pt]\n&= -\\dfrac{\\pi}{2} x^{2} \\csc{\\left(\\dfrac{\\pi x^{3}}{6}\\right)\\cot{\\left(\\dfrac{\\pi x^{3}}{6}\\right)}}.\n\\end{align*}\n\nEvaluating at $x=1,$ we find\n\\begin{align}\nm=f'(1)& =-\\dfrac{\\pi}{2} \\cdot 1^2 \\cdot \\csc{\\left(\\dfrac{\\pi}{6}\\right)\\cot{\\left(\\dfrac{\\pi}{6}\\right)}} \\\\[5pt] \n\n&= -\\dfrac{\\pi}{2} \\cdot 2 \\cdot \\sqrt{3} \\\\[5pt]\n\n& = -\\pi\\sqrt{3}.\n\\end{align}\n\nFinally, we find the equation of the tangent at the point $\\left(1,2\\right) \\mathbin{:}$\n\n\\begin{align*}\ny-y_1 &= m(x-x_1)\\\\[5pt]\n\ny-2 &= -\\pi\\sqrt{3}(x-1)\\\\[5pt]\n\ny &= \\bbox[4pt, border: 1px solid lightgray]{-\\pi\\sqrt{3}}x + \\bbox[4pt, border: 1px solid lightgray]{\\pi\\sqrt{3} + 2}\n\\end{align*}"} {:db/id #edb/ref 17592186234094 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6bb14b64-aadc-52aa-9ee3-c1ddaebaaa46" :question/math-academy-id "q-48510" :question/problem "Find the equation of the tangent to the curve $y=\\sec(3x)-2x$ at the point $\\left(0,1\\right).$" :question/worked-solution "Let $g(x)=\\sec(3x )$ and $h(x)=-2x.$ Then,\n\n\\begin{align}\nf(x)&=g(x)+h(x) . \n\\end{align}\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\sec(3x)$ as the composite function\n\\[\ng = \\sec u, \\qquad u = 3x.\n\\]\n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d g}{\\textrm d u} = \\sec u \\tan u \\qquad \\text{and} \\qquad \\dfrac{\\textrm{d}u}{\\textrm d x} = 3.\n\\]\n\nWe now apply the chain rule, and we get\n\\[\n\t\\eqalign{\n\\require{cancel}\n\t\t\t\\dfrac{\\textrm{d}g}{\\textrm{d}x}&=\\dfrac{\\textrm{d}g}{\\textrm{d}u}\\cdot \\dfrac{\\textrm{d}u}{\\textrm{d}x}\\\\[5pt]\n\t\t\t\t\t\t\t\t\t&=\\sec u \\tan u \\cdot (3)\\\\[5pt]\n\t\t\t\t\t\t\t\t\t&=3 \\sec u \\tan u\\\\[5pt]\n                                                                        & =3\\sec (3x) \\tan (3x)\n}\n\n\\]\n\nNext, we differentiate $h(x)=-2x.$ \n\nDifferentiating gives\n\n\\[\n\\dfrac{\\textrm d h}{\\textrm d x} = -2\n\\]\n\nHence,\n\\[f'(x)=g'(x)+h'(x)=3\\sec (3x) \\tan (3x) -2.\\]\n\nEvaluating at $x=0,$ we find\n\n\\begin{align*}\nm=f'(0) & =3\\sec\\left(3\\cdot 0\\right)\\tan\\left(3\\cdot 0\\right) -2\\\\[3pt]\n\t& =3\\sec 0\\tan 0 -2\\\\[3pt]\n\t& =3\\cdot 1\\cdot 0 - 2\\\\[3pt]\n\t&=-2.       \n\\end{align*}\n\nFinally, we find the equation of the tangent at the point $(0,1) \\mathbin{:}$\n\n\\begin{align}\ny-y_1&=m(x-x_1)\\\\[3pt]\ny-1&=-2 \\left(x-0 \\right)\\\\[3pt]\ny-1&=-2x\\\\[3pt]\ny&=-2x+1.\n\\end{align}"} {:db/id #edb/ref 17592186297324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaa9039f-813c-5a39-8485-506d974ba6b5" :answer/type {:db/ident :answer.type/math} :answer/value "-6{x}^{2}{csc}^{2}(2{x}^{3})" :db/id #edb/ref 17592186296163}] :answer-field/correct {:answer/id #uuid "aaa9039f-813c-5a39-8485-506d974ba6b5" :answer/type {:db/ident :answer.type/math} :answer/value "-6{x}^{2}{csc}^{2}(2{x}^{3})" :db/id #edb/ref 17592186296163} :answer-field/id #uuid "46b02564-c009-551f-ac97-3090c5c01752" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296764}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7a2ac9db-9f05-59f3-8c0a-71e8b95b390c" :question/math-academy-id "q-310222" :question/problem "Given that $f(x)=\\operatorname{cot}⁡(2{x}^{3}),$ we have\n\n${f}^{′}(x)=$\n\n{{field-1}}." :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\ny=\\operatorname{cot}⁡u,\\,u=2{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=6{x}^{2}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot 6{x}^{2} \\\\  & =-6{x}^{2}{csc}^{2}⁡(2{x}^{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "549d0a09-c27a-56d6-be90-544ce881b79a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sec}⁡(2x-1)\\operatorname{tan}⁡(2x-1)" :db/id #edb/ref 17592186295754} {:answer/id #uuid "b795c0ec-a13b-503b-9ccb-e58a9bb8f08d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{csc}⁡(2x-1)\\operatorname{tan}⁡(2x-1)" :db/id #edb/ref 17592186296230} {:answer/id #uuid "c38e3377-80cf-5c60-9229-319f52f9e34a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(2x-1)\\operatorname{tan}⁡(2x-1)" :db/id #edb/ref 17592186296301} {:answer/id #uuid "c9bd9f93-e328-559c-941f-fea015c16e20" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡(2x-1)\\operatorname{tan}⁡(2x-1)" :db/id #edb/ref 17592186296325} {:answer/id #uuid "ff98d619-199f-5915-8ae2-fece74959e5e" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sec}⁡(x)\\operatorname{tan}⁡(x)" :db/id #edb/ref 17592186296635}] :answer-field/correct {:answer/id #uuid "c9bd9f93-e328-559c-941f-fea015c16e20" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡(2x-1)\\operatorname{tan}⁡(2x-1)" :db/id #edb/ref 17592186296325} :answer-field/id #uuid "0a170546-189b-5b8d-b3bf-87715d626a57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296659}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b56b53a5-1b6c-546f-ab86-f9c5279b7a79" :question/math-academy-id "q-31320" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{sec}⁡(2x-1).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=\\operatorname{sec}⁡u,\\,u=2x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot 2 \\\\  & =2\\operatorname{sec}⁡u\\operatorname{tan}⁡u \\\\  & =2\\operatorname{sec}⁡(2x-1)\\operatorname{tan}⁡(2x-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074a9ec9-6bfa-51c3-b293-a2e6c7634c3c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295302} {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} {:answer/id #uuid "64d5cac3-e49f-55a4-a517-b40d5927cff8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186295841} {:answer/id #uuid "748fff53-6b97-5ddb-a2b7-7573ce8fffb9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295904} {:answer/id #uuid "c09b0310-1b57-58cd-bbcf-bbf81a785509" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296283}] :answer-field/correct {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} :answer-field/id #uuid "67494433-5316-509e-bbfc-ae0d8a99e4af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296848}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8d5db746-ab9b-5b5a-bc25-31e21fc4632d" :question/math-academy-id "q-31338" :question/problem "Find the slope of $f(x)=\\operatorname{cot}⁡(2\\pi -3x)$ at $x=\\frac{\\pi }{2}.$" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is $3.$"} {:db/id #edb/ref 17592186297369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d62ded4-2ee6-52b4-bc69-a4642638d154" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295710} {:answer/id #uuid "81a7a75b-3985-56bc-ad9c-0316c2348f3b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295965} {:answer/id #uuid "9a357d65-23c5-58be-868e-2ac0c3d388e1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296090} {:answer/id #uuid "c2c28805-4880-53a7-a205-3cbba072dd28" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296298} {:answer/id #uuid "f605d237-0166-587c-b104-dc53781dd11d" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296574}] :answer-field/correct {:answer/id #uuid "4d62ded4-2ee6-52b4-bc69-a4642638d154" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295710} :answer-field/id #uuid "7aaa5d76-a174-5c5f-afc2-1ec32957d4f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296883}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ab907b07-4062-5dae-90ac-fc279f3c0e29" :question/math-academy-id "q-31340" :question/problem "Find the slope of $f(x)=\\operatorname{csc}⁡(5x)$ at $x=-\\frac{\\pi }{2}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{csc}⁡u,\\,u=5x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-\\operatorname{csc}⁡u\\operatorname{cot}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-\\operatorname{csc}⁡u\\operatorname{cot}⁡u\\cdot (5) \\\\  & =-5\\operatorname{csc}⁡u\\operatorname{cot}⁡u \\\\  & =-5\\operatorname{csc}⁡(5x)\\operatorname{cot}⁡(5x).\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line at the point where $x=-\\frac{\\pi }{2}$ is \n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x}{|}_{x=-\\pi /2} & =-5\\operatorname{csc}⁡(5x)\\operatorname{cot}⁡(5x){|}_{x=-\\pi /2} \\\\  & =-5\\operatorname{csc}⁡(5\\cdot (-\\frac{\\pi }{2}))\\operatorname{cot}⁡(5\\cdot (-\\frac{\\pi }{2})) \\\\  & =-5\\operatorname{csc}⁡(-\\frac{5\\pi }{2})\\operatorname{cot}⁡(-\\frac{5\\pi }{2}) \\\\  & =-5\\cdot (-1)\\cdot 0 \\\\  & =0.\\end{aligned}\\end{aligned}\n$$\n\nHence, the slope of the tangent to the curve at $x=-\\frac{\\pi }{2}$ is $0.$"} {:db/id #edb/ref 17592186317255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81f82b4d-712a-53f7-8962-e76dc6fc923e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}(2x)\\operatorname{tan}(2x)-{x}^{3}" :db/id #edb/ref 17592186315836}] :answer-field/correct {:answer/id #uuid "81f82b4d-712a-53f7-8962-e76dc6fc923e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}(2x)\\operatorname{tan}(2x)-{x}^{3}" :db/id #edb/ref 17592186315836} :answer-field/id #uuid "dd0d42bf-cd3a-5552-acca-b0d7611c6c58" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317075}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dfe90c5f-4f9b-5154-ad49-fe645628cf50" :question/math-academy-id "q-342402" :question/problem "Given that $f(x)=\\frac{1}{2}\\operatorname{sec}⁡(2x)-\\frac{1}{4}{x}^{4},$ we have\n\n${f}^{′}(x)=$\n\n{{field-1}}." :question/worked-solution "Let $g(x)=\\frac{1}{2}\\operatorname{sec}⁡(2x)$ and $h(x)=-\\frac{1}{4}{x}^{4}.$ Then\n\n$$\nf(x)=g(x)+h(x).\n$$\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\frac{1}{2}\\operatorname{sec}⁡(2x)$ as the composite function\n\n$$\ng=\\frac{1}{2}\\operatorname{sec}⁡u,\\,u=2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}g}{\\text{d}u}=\\frac{1}{2}\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}g}{\\text{d}x} & =\\frac{\\text{d}g}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2}\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot 2 \\\\  & =\\operatorname{sec}⁡(2x)\\operatorname{tan}⁡(2x).\\end{aligned}\n$$\n\nNext, we differentiate $h(x)=-\\frac{1}{4}{x}^{4}.$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =-{x}^{3}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={g}^{′}(x)+{h}^{′}(x) \\\\  & =\\operatorname{sec}⁡(2x)\\operatorname{tan}⁡(2x)-{x}^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45e2c946-cebd-5416-8a76-6327b5030505" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{\\pi }{2}" :db/id #edb/ref 17592186327546} {:answer/id #uuid "8c9341d4-99b6-50f0-aa6d-9c6dd9382020" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186328140} {:answer/id #uuid "acbeb3ba-53eb-5b9a-b551-835bc36de883" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-\\frac{\\pi }{2}" :db/id #edb/ref 17592186328432} {:answer/id #uuid "ca6bee3f-bd8c-5dcf-8359-5ca512f57072" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x-\\frac{\\pi }{2}" :db/id #edb/ref 17592186328708} {:answer/id #uuid "db84f8eb-8423-54a1-b09a-ae141285ed5e" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186328851}] :answer-field/correct {:answer/id #uuid "db84f8eb-8423-54a1-b09a-ae141285ed5e" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x-\\frac{3\\pi }{2}" :db/id #edb/ref 17592186328851} :answer-field/id #uuid "ac2d96d1-6187-53ac-b42b-8e94f57a3b62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329484}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "33385857-91b0-513f-9a43-e506cd0cb163" :question/math-academy-id "q-48512" :question/problem "Find the equation of the tangent to the curve $y=\\operatorname{cot}⁡(2\\pi -3x)$ at the point $(\\frac{\\pi }{2},0).$" :question/worked-solution "First, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =(-{csc}^{2}⁡u)\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}m={f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\n$$\n\nFinally, we find the equation of the tangent at the point $(\\frac{\\pi }{2},0):$\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =3(x-\\frac{\\pi }{2}) \\\\ y & =3x-\\frac{3\\pi }{2}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Reciprocal Trigonometric Function Using the Chain Rule"}]}
