s}x\\,\\text{d}x-2\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3\\operatorname{sin}x-2\\operatorname{sec}x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233195 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b17add20-e3fe-557a-b7ba-b30e3097020e" :question/math-academy-id "q-113925" :question/problem "$\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\,\\text{d}x & =-\\operatorname{csc}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x & =2\\int \\operatorname{cos}\\operatorname{csc}x\\,\\operatorname{cot}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2(-\\operatorname{csc}x)+(-\\operatorname{cos}x)+C \\\\  & =-2\\operatorname{csc}x-\\operatorname{cos}x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234311 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "27d3e02d-3099-56f8-b860-c654c168397f" :question/math-academy-id "q-71657" :question/problem "$\\int (-8\\operatorname{csc}y\\,\\operatorname{cot}y)\\,\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}y\\operatorname{cot}y\\,\\text{d}y & =-\\operatorname{csc}y+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8\\operatorname{csc}y\\,\\operatorname{cot}y)\\,\\text{d}y & =-8\\int \\operatorname{csc}y\\operatorname{cot}y\\,\\text{d}y \\\\  & =-8(-\\operatorname{csc}y)+C \\\\  & =8\\operatorname{csc}y+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a6b2d77-6333-57e0-afd5-ae25cfed1172" :answer/type {:db/ident :answer.type/math} :answer/value "3sec