} - \\frac{16}{x^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186489491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39359cea-c70f-5460-a00b-b3252b77490d" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186489468} {:answer/id #uuid "3ba991d8-77cd-5adf-a4be-6a604604dc7b" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186489469} {:answer/id #uuid "6631f744-56ce-5b33-810f-f48c092b445f" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186489474} {:answer/id #uuid "68bb25f2-417c-5380-9161-3ad0df79a70e" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186489476} {:answer/id #uuid "81381787-644f-59de-aa98-b2a079bbc729" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{168}{5}" :db/id #edb/ref 17592186489480}] :answer-field/correct {:answer/id #uuid "6631f744-56ce-5b33-810f-f48c092b445f" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186489474} :answer-field/id #uuid "c590b228-1737-55da-8acb-b2ae441356b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489489}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ddd31c3c-768d-5290-8e36-3f5b830ff739" :question/problem "What is the slope of the tangent line to the curve $y=16 x - 40 \\cos{\\left(x \\right)}$ at the point $x=\\frac{\\pi}{6}$?" :question/worked-solution "The slope is the derivative evaluated at $x=\\frac{\\pi}{6}.$\n\nWe know that $\\frac{\\text{d}}{\\text{d}x}(\\sin x)=\\cos x,$ and that $\\frac{\\text{d}}{\\text{d}x}(\\cos x)=-\\sin x.$ Applying these formulas and the sum and constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} &= \\frac{\\text{d}}{\\text{d}x}(16 x - 40 \\cos{\\left(x \\right)}) \\\\ &= (40 \\sin{\\left(x \\right)})+(16) \\\\ &= 40 \\sin{\\left(x \\right)} + 16.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi}{6},$ we get\n\n$$\ny^{\\prime}(\\frac{\\pi}{6})=16+40\\sin(\\frac{\\pi}{6})=16+40\\left(\\frac{1}{2}\\right)=36.\n$$\n\nTherefore, the slope is $36.$"} {:db/id #edb/ref 17592186489493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c3cfd04-7aa6-5774-ba14-f010e7a101cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186489477} {:answer/id #uuid "8ed07005-38e6-5e5d-a622-d2cfd6049750" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{21}{2}" :db/id #edb/ref 17592186489483} {:answer/id #uuid "ad3e4c2a-e530-5c7e-b4a1-ac5402e2de1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186489485} {:answer/id #uuid "bf467ae4-1e01-5b03-972f-3946b7761d12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186489488} {:answer/id #uuid "f4deb1ae-1bcf-532a-b1e2-248371cdc02d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{5}" :db/id #edb/ref 17592186489495}] :answer-field/correct {:answer/id #uuid "6c3cfd04-7aa6-5774-ba14-f010e7a101cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186489477} :answer-field/id #uuid "aae48b1d-52dc-57a0-8231-48c0aaf2bf33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186489484}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e697136f-ba37-5c15-b682-60c32dbf1e52" :question/problem "What is the slope of the tangent line to the curve $y=6 x - 15 \\cos{\\left(x \\right)}$ at the point $x=\\frac{\\pi}{6}$?" :question/worked-solution "The slope is the derivative evaluated at $x=\\frac{\\pi}{6}.$\n\nWe know that $\\frac{\\text{d}}{\\text{d}x}(\\sin x)=\\cos x,$ and that $\\frac{\\text{d}}{\\text{d}x}(\\cos x)=-\\sin x.$ Applying these formulas and the sum and constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} &= \\frac{\\text{d}}{\\text{d}x}(6 x - 15 \\cos{\\left(x \\right)}) \\\\ &= (15 \\sin{\\left(x \\right)})+(6) \\\\ &= 15 \\sin{\\left(x \\right)} + 6.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi}{6},$ we get\n\n$$\ny^{\\prime}(\\frac{\\pi}{6})=6+15\\sin(\\frac{\\pi}{6})=6+15\\left(\\frac{1}{2}\\right)=\\frac{27}{2}.\n$$\n\nTherefore, the slope is $\\frac{27}{2}.$"} {:db/id #edb/ref 17592186514433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cos x" :db/id #edb/ref 17592186514159}] :answer-field/correct {:answer/id #uuid "f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\cos x" :db/id #edb/ref 17592186514159} :answer-field/id #uuid "0c175b32-cf9f-563c-b23b-dd0064f3ca32" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514214}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "83dc5138-e470-5b8f-b97c-b3006ebeb428" :question/math-academy-id "q-166071" :question/problem "$\\frac{\\text{d}h}{\\text{d}x}\\,=${{field-1}}" :question/worked-solution "We know that \n\n$$\n\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\n$$\n\nApplying this formula and the constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x) \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\  & =-4\\cdot (\\operatorname{cos}⁡x) \\\\  & =-4\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] [{:db/id #edb/ref 17592186059676 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059504 :question/id #uuid "ae922c00-2ff5-5a46-805a-62955bc5a08a" :question/math-academy-id "e-3632" :question/problem "Find the slope of $y = 4\\tan x + 5x$ at $x = 0.$" :question/worked-solution "The slope at $x=0$ is given by the value of the derivative $y'$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\tan x) = \\sec^2 x.$ We get\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4tan⁡x+5x) \\\\  & =4{sec}^{2}⁡x+5.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & =4{sec}^{2}⁡0+5 \\\\  & =4\\cdot 1+5 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore, the slope is $9.$"} :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/questions [{:db/id #edb/ref 17592186060266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc30ef38-cbec-55b9-a2fa-eac62f6febaf" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\csc^{2} x - 3x" :db/id #edb/ref 17592186058219} {:answer/id #uuid "d639cc01-99a5-5305-b28d-b0e55d5fff5d" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\sec^{2} x - 3x" :db/id #edb/ref 17592186058220} {:answer/id #uuid "4360cf12-9eb7-5492-ba39-14a61f0ea3ed" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sec^{2} x - 3" :db/id #edb/ref 17592186058221} {:answer/id #uuid "5374242e-ca7e-5305-910c-cf4057c4f398" :answer/type {:db/ident :answer.type/math} :answer/value "8\\csc^{2} x + 3" :db/id #edb/ref 17592186058222} {:answer/id #uuid "74e8baf7-d99f-5f98-8217-2cecba703059" :answer/type {:db/ident :answer.type/math} :answer/value "8\\csc x - 3" :db/id #edb/ref 17592186058223}] :answer-field/id #uuid "27d44d3b-325c-56cd-be48-4b748b31211c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058218}] :question/id #uuid "c5de72a3-98da-5c31-b21b-0c678c7a23a8" :question/math-academy-id "q-30990" :question/problem "Find $\\frac{df}{dx}$ for $f(x) = 8\\tan x - 3x$."} {:db/id #edb/ref 