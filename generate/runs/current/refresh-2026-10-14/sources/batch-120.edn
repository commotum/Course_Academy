\  & =-\\frac{1}{e}-\\frac{1}{e}+1 \\\\  & =1-\\frac{2}{e} \\\\  & =\\frac{e-2}{e}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "353c38c6-0699-5d31-a3a7-681d96b0021d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186247901} {:answer/id #uuid "5507088f-1a8b-5d15-a203-9e83009f5db2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186248191} {:answer/id #uuid "85d825e8-4b77-570d-9579-44732d982d72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186248617} {:answer/id #uuid "c26ec3ba-1125-5219-b27d-d1384ee85f70" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186249151} {:answer/id #uuid "d210b2f5-3730-5d88-a77c-6afcdc80ecd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186249287}] :answer-field/correct {:answer/id #uuid "85d825e8-4b77-570d-9579-44732d982d72" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186248617} :answer-field/id #uuid "e7cbe6e3-ee8a-56d6-bba3-4dcd2dab931c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250069}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0ba270d9-6da5-5830-bec9-26eadbb91904" :question/math-academy-id "q-114330" :question/problem "${\\int }_{0}^{\\pi /5}5x\\operatorname{cos}⁡(5x)\\,\\text{d}x=$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=5x & ⇒ & {u}^{′}=5 \\\\ {v}^{′}=\\operatorname{cos}⁡(5x) & ⇒ & v=\\frac{\\operatorname{sin}⁡(5x)}{5}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 5x\\cdot \\operatorname{cos}⁡(5x)\\,\\text{d}x & =5x\\cdot \\frac{\\operatorname{sin}⁡(5x)}{5}-\\int \\frac{\\operatorname{sin}⁡(5x)}{5}\\cdot 5\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(5x)-\\int \\operatorname{sin}⁡(5x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /5}5x\\operatorname{cos}⁡(5x)\\,\\text{d}x & =x\\operatorname{sin}⁡(5x){|}_{0}^{\\pi /5}-{\\int }_{0}^{\\pi /5}\\operatorname{sin}⁡(5x)\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡(5x){|}_{0}^{\\pi /5}+\\frac{1}{5}\\operatorname{cos}⁡(5x){|}_{0}^{\\pi /5} \\\\  & =[\\frac{\\pi }{5}\\operatorname{sin}⁡(5\\cdot \\frac{\\pi }{5})-0\\operatorname{sin}⁡(5\\cdot 0)] \\\\  & +\\frac{1}{5}[\\operatorname{cos}⁡(5\\cdot \\frac{\\pi }{5})-\\operatorname{cos}⁡(5\\cdot 0)] \\\\  & =(0-0)+\\frac{1}{5}(-1-1) \\\\  & =-\\frac{2}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e98c30-1d43-5f8a-b696-0c34179f4a2f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317642}] :answer-field/correct {:answer/id #uuid "18e98c30-1d43-5f8a-b696-0c34179f4a2f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317642} :answer-field/id #uuid "c2fe00d1-0029-52ff-8d78-f242bb9ada4e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318844}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d61aaced-d2d7-58f8-932d-53be360378fb" :question/math-academy-id "q-346870" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}={e}^{x} & ⇒ & v={e}^{x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot {e}^{x}\\,\\text{d}x & =2x\\cdot {e}^{x}-\\int {e}^{x}\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x & =2x{e}^{x}\\,{|}_{0}^{1}-2{\\int }_{0}^{1}{e}^{x}\\,\\text{d}x \\\\  & =2x{e}^{x}\\,{|}_{0}^{1}-2{e}^{x}\\,{|}_{0}^{1} \\\\  & =2(1\\cdot {e}^{1}-0\\cdot {e}^{0})-2({e}^{1}-{e}^{0}) \\\\  & =2e-2(e-1) \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c377238f-b153-585f-8aa9-69ae456b7747" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9{e}^{4}+3}{4}" :db/id #edb/ref 17592186318212}] :answer-field/correct {:answer/id #uuid "c377238f-b153-585f-8aa9-69ae456b7747" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9{e}^{4}+3}{4}" :db/id #edb/ref 17592186318212} :answer-field/id #uuid "f381b13c-2394-583e-8bf6-dd424644547a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318929}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cb6faac0-b896-57ad-9d54-07d07059068d" :question/math-academy-id "q-349217" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}3x{e}^{2x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=3x & ⇒ & {u}^{′}=3 \\\\ {v}^{′}={e}^{2x} & ⇒ & v=\\frac{1}{2}{e}^{2x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 3x\\cdot {e}^{2x}\\,\\text{d}x & =3x\\cdot \\frac{1}{2}{e}^{2x}-\\int \\frac{1}{2}{e}^{2x}\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}3x{e}^{2x}\\,\\text{d}x & =\\frac{3}{2}x{e}^{2x}\\,{|}_{0}^{2}-\\frac{3}{2}{\\int }_{0}^{2}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{3}{2}x{e}^{2x}\\,{|}_{0}^{2}-\\frac{3}{4}{e}^{2x}\\,{|}_{0}^{2} \\\\  & =\\frac{3}{2}(2\\cdot {e}^{4}-0\\cdot {e}^{0})-\\frac{3}{4}({e}^{4}-{e}^{0}) \\\\  & =3{e}^{4}-\\frac{3}{4}({e}^{4}-1) \\\\  & =\\frac{9{e}^{4}+3}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4abe39b1-1acd-5859-bbde-adde947b15bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }" :db/id #edb/ref 17592186317810}] :answer-field/correct {:answer/id #uuid "4abe39b1-1acd-5859-bbde-adde947b15bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }" :db/id #edb/ref 17592186317810} :answer-field/id #uuid "ceb951fd-f6ee-51b4-b39a-e0e4ddc059fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318864}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "67ba33c4-ecff-5b0f-91ab-b446a5b2d9d2" :question/math-academy-id "q-349231" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\pi x) & ⇒ & v=-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))-\\int (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{\\pi }{\\int }_{0}^{1}\\operatorname{cos}⁡(\\pi x)\\,\\text{d}x \\\\  & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{{\\pi }^{2}}\\operatorname{sin}⁡(\\pi x)\\,{|}_{0}^{1} \\\\  & =-\\frac{4}{\\pi }(1\\cdot \\operatorname{cos}⁡(\\pi \\cdot 1)-0\\cdot \\operatorname{cos}⁡(\\pi \\cdot 0))+\\frac{4}{{\\pi }^{2}}(\\operatorname{sin}⁡(\\pi \\cdot 1)-\\operatorname{sin}⁡(\\pi \\cdot 0)) \\\\  & =-\\frac{4}{\\pi }(-1-0)+\\frac{4}{{\\pi }^{2}}(0-0) \\\\  & =\\frac{4}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31043ecf-974a-5de9-96ed-984ebdd8c7d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8\\pi }{3}" :db/id #edb/ref 17592186317718}] :answer-field/correct {:answer/id #uuid "31043ecf-974a-5de9-96ed-984ebdd8c7d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8\\pi }{3}" :db/id #edb/ref 17592186317718} :answer-field/id #uuid "c9d52bf5-cb5b-5fca-b529-dba6cdf38afd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318855}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30f0e38b-4d35-5e3a-af39-84633279075a" :question/math-academy-id "q-349253" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2\\pi }4x\\operatorname{sin}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(3x) & ⇒ & v=-\\frac{1}{3}\\operatorname{cos}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(3x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{3}\\operatorname{cos}⁡(3x))-\\int (-\\frac{1}{3}\\operatorname{cos}⁡(3x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }4x\\operatorname{sin}⁡(3x)\\,\\text{d}x & =-\\frac{4}{3}x\\operatorname{cos}⁡(3x)\\,{|}_{0}^{2\\pi }+\\frac{4}{3}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =-\\frac{4}{3}x\\operatorname{cos}⁡(3x)\\,{|}_{0}^{2\\pi }+\\frac{4}{9}\\operatorname{sin}⁡(3x)\\,{|}_{0}^{2\\pi } \\\\  & =-\\frac{4}{3}(2\\pi \\cdot \\operatorname{cos}⁡(6\\pi )-0\\cdot \\operatorname{cos}⁡(0))+\\frac{4}{9}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =-\\frac{4}{3}(2\\pi \\cdot 1-0\\cdot 1)+\\frac{4}{9}(0-0) \\\\  & =-\\frac{8\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f87a2ec9-3787-50b9-9e55-d6cd2446c049" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186318389}] :answer-field/correct {:answer/id #uuid "f87a2ec9-3787-50b9-9e55-d6cd2446c049" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186318389} :answer-field/id #uuid "3da5149a-42e0-57ab-b867-65aa7f203c05" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318551}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "615dee59-7992-5c1c-8fe1-9c3970b38307" :question/math-academy-id "q-349297" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}9x\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=9x & ⇒ & {u}^{′}=9 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{1}{3}\\operatorname{sin}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 9x\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =9x\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)-\\int \\frac{1}{3}\\operatorname{sin}⁡(3x)\\cdot 9\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}9x\\operatorname{cos}⁡(3x)\\,\\text{d}x & =3x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}-3{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =3x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}+\\operatorname{cos}⁡(3x)\\,{|}_{0}^{\\pi /3} \\\\  & =3(\\frac{\\pi }{3}\\cdot \\operatorname{sin}⁡(\\pi )-0\\cdot \\operatorname{sin}⁡(0))+(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =3(\\frac{\\pi }{3}\\cdot 0-0\\cdot 0)+(-1-1) \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f52ada2e-b967-5581-b835-fdd4ef42d1b2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186318377}] :answer-field/correct {:answer/id #uuid "f52ada2e-b967-5581-b835-fdd4ef42d1b2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186318377} :answer-field/id #uuid "43a2be7d-5b56-578e-b8ea-825b72904689" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318568}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dfc2da83-70ec-5b4d-8276-3941e4e2e19f" :question/math-academy-id "q-349305" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}(-18x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=-18x & ⇒ & {u}^{′}=-18 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{1}{3}\\operatorname{sin}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (-18x)\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =(-18x)\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)-\\int \\frac{1}{3}\\operatorname{sin}⁡(3x)\\cdot (-18)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}(-18x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & =-6x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}+6{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =-6x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}-2\\operatorname{cos}⁡(3x)\\,{|}_{0}^{\\pi /3} \\\\  & =-6(\\frac{\\pi }{3}\\cdot \\operatorname{sin}⁡(\\pi )-0\\cdot \\operatorname{sin}⁡(0))-2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-6(\\frac{\\pi }{3}\\cdot 0-0\\cdot 0)-2(-1-1) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9137fb31-7c6a-5b4c-a54b-cf399bcfa5a8" :answer/type {:db/ident :answer.type/math} :answer/value "1-4{e}^{-3}" :db/id #edb/ref 17592186318059}] :answer-field/correct {:answer/id #uuid "9137fb31-7c6a-5b4c-a54b-cf399bcfa5a8" :answer/type {:db/ident :answer.type/math} :answer/value "1-4{e}^{-3}" :db/id #edb/ref 17592186318059} :answer-field/id #uuid "c49e403e-dc95-5927-91fe-0a0152fb1039" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318848}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fce587bb-2230-5419-afb1-775f458fc405" :question/math-academy-id "q-349348" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}9x{e}^{-3x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=9x & ⇒ & {u}^{′}=9 \\\\ {v}^{′}={e}^{-3x} & ⇒ & v=-\\frac{1}{3}{e}^{-3x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 9x\\cdot {e}^{-3x}\\,\\text{d}x & =9x\\cdot (-\\frac{1}{3}{e}^{-3x})-\\int (-\\frac{1}{3}{e}^{-3x})\\cdot 9\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}9x{e}^{-3x}\\,\\text{d}x & =-3x{e}^{-3x}\\,{|}_{0}^{1}-3{\\int }_{0}^{1}{e}^{-3x}\\,\\text{d}x \\\\  & =-3x{e}^{-3x}\\,{|}_{0}^{1}-{e}^{-3x}\\,{|}_{0}^{1} \\\\  & =-3(1\\cdot {e}^{-3}-0\\cdot {e}^{0})-({e}^{-3}-{e}^{0}) \\\\  & =-3{e}^{-3}-({e}^{-3}-1) \\\\  & =1-4{e}^{-3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e03bb2-38fd-590c-a711-0f08ab8bba0b" :answer/type {:db/ident :answer.type/math} :answer/value "-1+{e}^{2}" :db/id #edb/ref 17592186330278} {:answer/id #uuid "9cfe119c-4c83-5685-9e72-3d7e3a36aafe" :answer/type {:db/ident :answer.type/math} :answer/value "1-3{e}^{2}" :db/id #edb/ref 17592186331355} {:answer/id #uuid "b81ff5e8-6e1a-5415-a73c-95423efd63bb" :answer/type {:db/ident :answer.type/math} :answer/value "-2-{e}^{2}" :db/id #edb/ref 17592186331574} {:answer/id #uuid "d88e6b38-60e3-55a1-b267-396d75df9e52" :answer/type {:db/ident :answer.type/math} :answer/value "-1-{e}^{2}" :db/id #edb/ref 17592186331872} {:answer/id #uuid "e8104679-8097-5d99-8871-6a598728a76b" :answer/type {:db/ident :answer.type/math} :answer/value "1+{e}^{2}" :db/id #edb/ref 17592186331985}] :answer-field/correct {:answer/id #uuid "d88e6b38-60e3-55a1-b267-396d75df9e52" :answer/type {:db/ident :answer.type/math} :answer/value "-1-{e}^{2}" :db/id #edb/ref 17592186331872} :answer-field/id #uuid "a2900df1-3dd3-5e4a-bcd5-28bec34e44ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "105b4be6-43d2-5e3c-baa6-177cc086c196" :question/math-academy-id "q-49660" :question/problem "Evaluate ${\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{-x} & ⇒ & v=-{e}^{-x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{-x}\\,\\text{d}x & =x\\cdot (-{e}^{-x})-\\int (-{e}^{-x})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x & =-x{e}^{-x}{|}_{-2}^{0}+{\\int }_{-2}^{0}{e}^{-x}\\,\\text{d}x \\\\  & =-x{e}^{-x}{|}_{-2}^{0}-{e}^{-x}{|}_{-2}^{0} \\\\  & =[-0{e}^{-0}-2{e}^{2}]-[{e}^{0}-{e}^{2}] \\\\  & =-2{e}^{2}-1+{e}^{2} \\\\  & =-1-{e}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d04d3d4-1dd0-57fb-b1e2-c225a604887a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186330065} {:answer/id #uuid "10711776-d5af-58ee-a204-f0481a37ef0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186330095} {:answer/id #uuid "94d2489f-97d4-5923-a4e5-c84c3ac1206a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186331268} {:answer/id #uuid "bef58735-ea92-5021-ba86-331e3acbbeb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186331643} {:answer/id #uuid "e88ab2f9-1ace-5545-9427-562efa040d45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186331991}] :answer-field/correct {:answer/id #uuid "bef58735-ea92-5021-ba86-331e3acbbeb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186331643} :answer-f