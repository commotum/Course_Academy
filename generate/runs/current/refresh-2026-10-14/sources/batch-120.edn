8b5-915f-029502f88355" :answer/type {:db/ident :answer.type/math} :answer/value "[-4,-2]" :db/id #edb/ref 17592186502647} :answer-field/id #uuid "60d400d7-cc0a-53e9-8c5c-d69c00c39617" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502664}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e71ef6b0-33d5-574b-a412-76bd2763d136" :question/problem "The inequality $-4\\le x\\le -2$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $-4$ and $-2$ *are* included. \n\n$$\n-4\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,-2\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n[-4,-2]\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [-4,-2].\n$$"} {:db/id #edb/ref 17592186502718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1626e470-cad1-5f9d-9ec9-727a32fd1da3" :answer/type {:db/ident :answer.type/math} :answer/value "-11 \\le x < 8" :db/id #edb/ref 17592186502636} {:answer/id #uuid "4342b6ad-f0f0-5ac9-b979-b2c99f19fac1" :answer/type {:db/ident :answer.type/math} :answer/value "-11 < x < 8" :db/id #edb/ref 17592186502648} {:answer/id #uuid "4de629f1-5eba-57cc-9794-28eaabc6d1cd" :answer/type {:db/ident :answer.type/text} :answer/value "$x < - 11$ or $x > 8$" :db/id #edb/ref 17592186502658} {:answer/id #uuid "779e535b-e467-53d6-a379-d26f9d0eccc8" :answer/type {:db/ident :answer.type/math} :answer/value "-11 < x \\le 8" :db/id #edb/ref 17592186502677} {:answer/id #uuid "935f93d8-33c3-5010-ae21-4b4e7a1df253" :answer/type {:db/ident :answer.type/math} :answer/value "-11 \\le x \\le 8" :db/id #edb/ref 17592186502687}] :answer-field/correct {:answer/id #uuid "935f93d8-33c3-5010-ae21-4b4e7a1df253" :answer/type {:db/ident :answer.type/math} :answer/value "-11 \\le x \\le 8" :db/id #edb/ref 17592186502687} :answer-field/id #uuid "99bbbcdd-7ca0-5ed9-8647-ac2286849187" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502693}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fb411cd3-b0bc-5d55-b10a-a980eed0b2af" :question/problem "Which inequality corresponds to the interval $x ∈ [- 11, 8]$?" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only brackets. So, the endpoints are *included*.\n\n$$\nx\\in {\\color{blue}{[}}-11, 8{\\color{blue}{]}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n-11 \\,\\,{\\color{blue}{\\le}}\\,\\, x \\,\\,{\\color{blue}{\\le}}\\,\\, 8\n$$"}] :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}] [{:db/id #edb/ref 17592186064167 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064038 :question/id #uuid "368cbbae-4eff-5eff-a8f3-d3e8359447a9" :question/math-academy-id "e-364" :question/problem "Calculate $\\displaystyle \\int x^2 \\,\\textrm d x.$" :question/worked-solution "We apply the power rule with $n=2$, and we get\n\n$$\n\\int x^2 \\,\\textrm d x = \\dfrac{x^{2+1}}{2+1} + C = \\dfrac{x^3}{3}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{3}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{3})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3})+0 & = \\\\ \\frac{1}{3}\\cdot 3{x}^{2} & = \\\\ {x}^{2}\\,✓\\end{aligned}\n$$"} :knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593 :topic/math-academy-id 35 :topic/title "The Power Rule for Differentiation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd9ded59-ba65-5176-b8f9-b0abbcde8e5e" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2}" :db/id #edb/ref 17592186061520} {:answer/id #uuid "06876c28-ebd0-5db2-80b3-e9af69ed8c2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186061521} {:answer/id #uuid "1e1c848c-bcad-5a85-903a-9791288e9010" :answer/type {:db/ident :answer.type/math} :answer/value "2 + C" :db/id #edb/ref 17592186061522} {:answer/id #uuid "53a354ab-679e-5199-ac84-f449177db3d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2}" :db/id #edb/ref 17592186061523} {:answer/id #uuid "759d2e84-4518-561f-8c74-506babc880c4" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} + C" :db/id #edb/ref 17592186061524}] :answer-field/id #uuid "d83860ac-499e-5a75-812f-1da4dee6be22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061519}] :question/id #uuid "9681ab06-ae34-5546-895c-3849a33f13b3" :question/math-academy-id "q-2005" :question/problem "Calculate $\\intxdx$."} {:db/id #edb/ref 17592186064556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a441ddd8-cdfd-510b-9645-167a452b9e7c" :answer/type {:db/ident :answer.type/math} :answer/value "x^{5} + C" :db/id #edb/ref 17592186061532} {:answer/id #uuid "b6abf952-05e5-525b-9306-14df3eb50611" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{3} + C" :db/id #edb/ref 17592186061533} {:answer/id #uuid "b8fbde76-9228-5e56-b028-6340005dc28d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4} + C" :db/id #edb/ref 17592186061534} {:answer/id #uuid "4e170175-65b7-57c4-b9e2-727b6b0c9179" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186061535} {:answer/id #uuid "4f79a5e8-a535-5732-a68c-46578acb44dc" :answer/type {:db/ident :answer.type/math} :answer/value "x^{3} + C" :db/id #edb/ref 17592186061536}] :answer-field/id #uuid "5f64550e-ffcf-5991-a4ac-264a9e506706" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186061531}] :question/id #uuid "a4162e45-b600-54a2-bad9-383dac48cede" :question/math-academy-id "q-2022" :question/problem "Calculate $\\intx^{4}dx$."} {:db/id #edb/ref 17592186233174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b47ac44-1559-5265-ba44-bd5a6e355495" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{21}+C" :db/id #edb/ref 17592186513558} {:answer/id #uuid "62de7813-7886-5bed-86cd-1ca23e600b30" :answer/type {:db/ident :answer.type/math} :answer/value "21{x}^{19}+C" :db/id #edb/ref 17592186513799} {:answer/id #uuid "65428549-ccd7-5201-8026-265c549f0352" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{19}+C" :db/id #edb/ref 17592186513804} {:answer/id #uuid "7f5af8b6-1444-5218-bbb1-bf6a887d157c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{19}}{19}+C" :db/id #edb/ref 17592186513863} {:answer/id #uuid "8cf69104-089b-5eec-8f81-3bf53d5632ac" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{21}+C" :db/id #edb/ref 17592186513895}] :answer-field/correct {:answer/id #uuid "0b47ac44-1559-5265-ba44-bd5a6e355495" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{21}}{21}+C" :db/id #edb/ref 17592186513558} :answer-field/id #uuid "6982cbcb-0bd9-554d-8104-e02dd398a383" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514278}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6e6c66f6-6133-59f6-a79d-0cbf1615accf" :question/math-academy-id "q-113665" :question/problem "Calculate $\\int {x}^{20}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=20$, and we get\n\n$$\n\\int {x}^{20}\\,\\text{d}x=\\frac{{x}^{20+1}}{20+1}+C=\\frac{{x}^{21}}{21}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{21}}{21}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{21}}{21})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{21}\\frac{\\text{d}}{\\text{d}x}({x}^{21})+0 & = \\\\ \\frac{1}{21}\\cdot 21{x}^{20} & = \\\\ {x}^{20}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233175 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7949e7bf-09d1-5ce9-ac3c-0d7f26b2e6c4" :question/math-academy-id "q-113670" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{17}$ and ${F}^{'}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=17$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{17}\\,\\text{d}x \\\\  & =\\frac{{x}^{17+1}}{17+1}+C \\\\  & =\\frac{{x}^{18}}{18}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{18}}{18}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{18}}{18})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{18}\\frac{\\text{d}}{\\text{d}x}({x}^{18})+0 & = \\\\ \\frac{1}{18}\\cdot 18\\,{x}^{17} & = \\\\ {x}^{17}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234186 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "48cc16d0-0280-564d-bcf3-e481ad8d20ab" :question/math-academy-id "q-66126" :question/problem "Calculate $\\int 1\\,\\text{d}x.$" :question/worked-solution "If we write the integrand as a power of $x$, we have ${x}^{0}=1.$ Therefore, we can use the power rule with $n=0$ and we get\n\n$$\n\\begin{aligned}\\int 1\\,\\text{d}x & =\\int {x}^{0}\\,\\text{d}x \\\\  & =\\frac{{x}^{0+1}}{0+1}+C \\\\  & =x+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(x+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ 1+0 & = \\\\ 1\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234300 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eb47b292-deba-58b8-a79e-0386e8ea55e3" :question/math-academy-id "q-71121" :question/problem "Calculate $\\int {x}^{10}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=10$, and we get\n\n$$\n\\int {x}^{10}\\,\\text{d}x=\\frac{{x}^{10+1}}{10+1}+C=\\frac{{x}^{11}}{11}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{11}}{11})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{11}\\frac{\\text{d}}{\\text{d}x}({x}^{11})+0 & = \\\\ \\frac{1}{11}\\cdot 11{x}^{10} & = \\\\ {x}^{10}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6ad986-0c26-5cd6-9cd3-04a7be56d694" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{7}+C" :db/id #edb/ref 17592186503846} {:answer/id #uuid "4ec8b324-f032-547f-97d9-6c73f80f4440" :answer/type {:db/ident :answer.type/math} :answer/value "x^{7}+C" :db/id #edb/ref 17592186503850} {:answer/id #uuid "7fe67df0-46d1-5acd-abf6-e732a8688e8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}+C" :db/id #edb/ref 17592186503855} {:answer/id #uuid "b8b1f0d3-bec7-598d-ba2e-a3f438f06ce3" :answer/type {:db/ident :answer.type/math} :answer/value "7x^{7}+C" :db/id #edb/ref 17592186503868} {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875}] :answer-field/correct {:answer/id #uuid "fa59a2a3-a8ed-5b0b-abda-91a9bba04e9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{7}}{7}+C" :db/id #edb/ref 17592186503875} :answer-field/id #uuid "b67f2104-8e47-50cd-b752-fad1aa17e5ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503867}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4194dc2e-82ad-5109-91f4-d383eed4b18e" :question/problem "Calculate $\\int {x}^{6}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=6$, and we get\n\n$$\n\\int {x}^{6}\\,\\text{d}x=\\frac{{x}^{6+1}}{6+1}+C=\\frac{{x}^{7}}{7}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{7}}{7})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7})+0 & = \\\\ \\frac{1}{7}\\cdot 7{x}^{6} & = \\\\ {x}^{6}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} {:answer/id #uuid "0b7b7de0-eaf8-57d9-8475-c23f72194dd2" :answer/type {:db/ident :answer.type/math} :answer/value "8x^{8}" :db/id #edb/ref 17592186503844} {:answer/id #uuid "a5bb73e6-3ec8-51dd-ad3b-1cd6d6243b7a" :answer/type {:db/ident :answer.type/math} :answer/value "8 + C" :db/id #edb/ref 17592186503862} {:answer/id #uuid "b52194ac-60ec-5ec7-91b2-c8a58426c3e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8}" :db/id #edb/ref 17592186503866} {:answer/id #uuid "f1d839d9-d182-5a2a-8ca4-8961f79ffaae" :answer/type {:db/ident :answer.type/math} :answer/value "x^{8} + C" :db/id #edb/ref 17592186503874}] :answer-field/correct {:answer/id #uuid "01b9bd22-8b41-542b-82ba-62e400af4a02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503842} :answer-field/id #uuid "88eaa69f-9171-51b9-9926-45e937a2ad36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503859}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4fc55d29-07c8-58f3-8bc8-d1223d0589d0" :question/problem "Calculate $\\int {x}^{7}\\,\\text{d}x.$ Include the arbitrary constant of integration." :question/worked-solution "We apply the power rule with $n=7$, and we get\n\n$$\n\\int {x}^{7}\\,\\text{d}x=\\frac{{x}^{7+1}}{7+1}+C=\\frac{{x}^{8}}{8}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{8}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{8})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{8}\\frac{\\text{d}}{\\text{d}x}({x}^{8})+0 & = \\\\ \\frac{1}{8}\\cdot 8{x}^{7} & = \\\\ {x}^{7}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081fa2f5-42b3-5c04-80c9-10a003c271a4" :answer/type {:db/ident :answer.type/math} :answer/value "5x^{4} + C" :db/id #edb/ref 17592186503843} {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} {:answer/id #uuid "7015537d-a311-57e0-815f-dece8e7c2eea" :answer/type {:db/ident :answer.type/math} :answer/value "x^{6} + C" :db/id #edb/ref 17592186503853} {:answer/id #uuid "84bc4aa5-c9e8-54dc-9352-f633e5591d8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5} + C" :db/id #edb/ref 17592186503857} {:answer/id #uuid "dd56a3a8-a755-5234-b43f-e287021340e7" :answer/type {:db/ident :answer.type/math} :answer/value "x^{4} + C" :db/id #edb/ref 17592186503870}] :answer-field/correct {:answer/id #uuid "4a21e63a-5ffd-51d5-a90e-548e77d4bab3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{6}}{6} + C" :db/id #edb/ref 17592186503849} :answer-field/id #uuid "51200684-dca8-5045-9aea-e16255caa7bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503852}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "74bb6151-9d7e-5db4-9d07-e87c336986aa" :question/problem "Calculate $\\int {x}^{5}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=5$, and we get\n\n$$\n\\int {x}^{5}\\,\\text{d}x=\\frac{{x}^{5+1}}{5+1}+C=\\frac{{x}^{6}}{6}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{6}}{6}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{6}}{6})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{6}\\frac{\\text{d}}{\\text{d}x}({x}^{6})+0 & = \\\\ \\frac{1}{6}\\cdot 6{x}^{5} & = \\\\ {x}^{5}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19401952-b969-5a9f-9750-1720c3ea9602" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9} + C" :db/id #edb/ref 17592186503845} {:answer/id #uuid "3d942c43-21e5-5ec4-b609-785240316ce4" :answer/type {:db/ident :answer.type/math} :answer/value "8x^{7} + C" :db/id #edb/ref 17592186503847} {:answer/id #uuid "7ff916ab-3641-575c-b8ab-d8ce83a4174b" :answer/type {:db/ident :answer.type/math} :answer/value "x^{9} + C" :db/id #edb/ref 17592186503856} {:answer/id #uuid "90147ce6-5ad4-56fc-aa26-0fc98c813215" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{8}}{8} + C" :db/id #edb/ref 17592186503861} {:answer/id #uuid "ce201103-531a-5e28-bbe3-329fc7ec8063" :answer/type {:db/ident :answer.type/math} :answer/value "x^{7} + C" :db/id #edb/ref 17592186503869}] :answer-field/correct {:answer/id #uuid "19401952-b969-5a9f-9750-1720c3ea9602" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{9}}{9} + C" :db/id #edb/ref 17592186503845} :answer-field/id #uuid "fe44896c-83fc-509b-862e-d8c3138397c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503876}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8d476a50-5742-5b02-8acf-300d458d3177" :question/problem "Calculate $\\int {x}^{8}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=8$, and we get\n\n$$\n\\int {x}^{8}\\,\\text{d}x=\\frac{{x}^{8+1}}{8+1}+C=\\frac{{x}^{9}}{9}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{9}}{9}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{9}}{9})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{9}\\frac{\\text{d}}{\\text{d}x}({x}^{9})+0 & = \\\\ \\frac{1}{9}\\cdot 9{x}^{8} & = \\\\ {x}^{8}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863bcfda-f86c-5454-b9dc-accc499f2c5b" :answer/type {:db/ident :answer.type/math} :answer/value "4x^{4}+C" :db/id #edb/ref 17592186503858} {:answer/id #uuid "abbb6d1e-23ec-52ad-93a6-2a688bee49af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186503864} {:answer/id #uuid "abe28291-ecd6-5f9e-985f-a0a2c28cc41d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{5}}{5}+C" :db/id #edb/ref 17592186503865} {:answer/id #uuid "e85650a9-47ba-50b3-a4f1-3c07d1371853" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3}}{4}+C" :db/id #edb/ref 17592186503872} {:answer/id #uuid "f079c239-840f-54f7-96fe-bbb4346258a9" :answer/type {:db/ident :answer.type/math} :answer/value "x^{4}+C" :db/id #edb/ref 17592186503873}] :answer-field/correct {:answer/id #uuid "abbb6d1e-23ec-52ad-93a6-2a688bee49af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{4}}{4}+C" :db/id #edb/ref 17592186503864} :answer-field/id #uuid "a740068d-6348-515e-8b5f-4399bec063f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186503863}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e2fcd99b-3b51-589f-9fd0-4c5df6da6a6c" :question/problem "Calculate $\\int {x}^{3}\\,\\text{d}x.$" :question/worked-solution "We apply the power rule with $n=3$, and we get\n\n$$\n\\int {x}^{3}\\,\\text{d}x=\\frac{{x}^{3+1}}{3+1}+C=\\frac{{x}^{4}}{4}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{4}}{4}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{4}}{4})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{4}\\frac{\\text{d}}{\\text{d}x}({x}^{4})+0 & = \\\\ \\frac{1}{4}\\cdot 4{x}^{3} & = \\\\ {x}^{3}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddf04c2-71d3-54b1-9f4b-d9699e9cc552" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{12}}{13}+C" :db/id #edb/ref 17592186513693} {:answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{14}}{14}+C" :db/id #edb/ref 17592186513816} {:answer/id #uuid "a01e6e97-6d87-5937-8e57-076aaa390207" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{12}}{12}+C" :db/id #edb/ref 17592186513942} {:answer/id #uuid "a8adc543-25c4-55be-8081-e8857819cce0" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{14}+C" :db/id #edb/ref 17592186513971} {:answer/id #uuid "f56d5cb2-21a5-51fe-8738-17f8affe9a15" :answer/type {:db/ident :answer.type/math} :answer/value "13{x}^{14}+C" :db/id #edb/ref 17592186514172}] :answer-field/correct {:answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{14}}{14}+C" :db/id #edb/ref 17592186513816} :answer-field/id #uuid "c8fbc5ea-5d9e-52eb-88d3-b4d6971c6c74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514321}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c1117fb-96ed-5032-8c50-48772b44cf5c" :question/math-academy-id "q-113668" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{13}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=13$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{13}\\,\\text{d}x \\\\  & =\\frac{{x}^{13+1}}{13+1}+C \\\\  & =\\frac{{x}^{14}}{14}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{14}\\frac{\\text{d}}{\\text{d}x}({x}^{14})+0 & = \\\\ \\frac{1}{14}\\cdot 14\\,{x}^{13} & = \\\\ {x}^{13}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0387228b-625c-57a2-b9a5-65db0be7f989" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{5}+C" :db/id #edb/ref 17592186513537} {:answer/id #uuid "6b8e57bc-7acc-5bac-a92c-82592c8e49c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}+C" :db/id #edb/ref 17592186513823} {:answer/id #uuid "78df9ad8-f292-595e-872f-5f8ef18126cc" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{5}+C" :db/id #edb/ref 17592186513850} {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} {:answer/id #uuid "b224165e-2200-5c30-be67-560f8a090e5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{5}+C" :db/id #edb/ref 17592186513998}] :answer-field/correct {:answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186513977} :answer-field/id #uuid "ee20556c-e250-51aa-b85c-fc28797d2901" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514340}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c" :question/math-academy-id "q-29994" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{4}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=4$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}+C \\\\  & =\\frac{{x}^{5}}{5}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5})+0 & = \\\\ \\frac{1}{5}\\cdot 5{x}^{4} & = \\\\ {x}^{4}\\,✓\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Antiderivative of a Monomial"}]}
