uid "92f021d2-f657-568a-9458-97dc25ae2244" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186331255} {:answer/id #uuid "b1f49c5b-b91f-5372-945d-fd51d107045f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331524} {:answer/id #uuid "bc706a10-6660-59a2-b283-dfcba28564b5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331611} {:answer/id #uuid "f6ff4fa6-edc2-533d-88c9-09406c898508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186332119}] :answer-field/correct {:answer/id #uuid "b1f49c5b-b91f-5372-945d-fd51d107045f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331524} :answer-field/id #uuid "e116d325-1e59-5f3b-b1ef-e63b4cf776b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332598}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b7d1b926-6342-572b-ba02-f2edcfbab3a9" :question/math-academy-id "q-49674" :question/problem "${\\int }_{-\\pi /4}^{\\pi /4}x\\operatorname{cos}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(2x) & ⇒ & v=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(2x)\\,\\text{d}x & =x\\cdot \\frac{\\operatorname{sin}⁡(2x)}{2}-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /4}^{\\pi /4}x\\operatorname{cos}⁡(2x)\\,\\text{d}x & ={\\frac{x\\operatorname{sin}⁡(2x)}{2}|}_{-\\pi /4}^{\\pi /4}-{\\int }_{-\\pi /4}^{\\pi /4}\\frac{\\operatorname{sin}⁡(2x)}{2}\\,\\text{d}x \\\\  & ={\\frac{1}{2}x\\operatorname{sin}⁡(2x)|}_{-\\pi /4}^{\\pi /4}+\\frac{1}{4}\\operatorname{cos}⁡(2x){|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}[\\frac{\\pi }{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{4}\\operatorname{sin}⁡(-\\frac{\\pi }{2})]+\\frac{1}{4}[\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(-\\frac{\\pi }{2})] \\\\  & =\\frac{1}{2}[\\frac{\\pi }{4}-\\frac{\\pi }{4}]+\\frac{1}{4}[0-0] \\\\  & =\\frac{1}{2}[0]+0 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e6d4ed-2a95-5b96-a81c-b22982fa0499" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{12}+1" :db/id #edb/ref 17592186330291} {:answer/id #uuid "4e20740e-c6da-5ad1-a62b-85285c7d638d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\pi }{12}+\\frac{1}{2}" :db/id #edb/ref 17592186330660} {:answer/id #uuid "9f6c93f5-fe12-5a2e-9367-75108b2be7a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\pi }{6}-\\frac{1}{2}" :db/id #edb/ref 17592186331383} {:answer/id #uuid "e330c811-9644-5c56-b0f4-0f24b313cf8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{12}+\\frac{1}{2}" :db/id #edb/ref 17592186331956} {:answer/id #uuid "fb9e871c-2c0e-518b-a4af-68c0103a8640" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{6}-\\frac{1}{2}" :db/id #edb/ref 17592186332160}] :answer-field/correct {:answer/id #uuid "e330c811-9644-5c56-b0f4-0f24b313cf8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{12}+\\frac{1}{2}" :db/id #edb/ref 17592186331956} :answer-field/id #uuid "872a6308-1549-5a6a-ab50-2e8d6d61c150" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332438}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4518fd0-a820-5329-a38a-c80d052e166a" :question/math-academy-id "q-49676" :question/problem "Evaluate  ${\\int }_{\\pi /6}^{\\pi /2}x\\operatorname{sin}⁡x\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡x & ⟹\\,v=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡x\\,\\text{d}x & =-x\\cdot \\operatorname{cos}⁡x-\\int (-\\operatorname{cos}⁡x)\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =-x\\operatorname{cos}⁡x{|}_{\\pi /6}^{\\pi /2}+{\\int }_{\\pi /6}^{\\pi /2}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡x{|}_{\\pi /6}^{\\pi /2}+\\operatorname{sin}⁡x{|}_{\\pi /6}^{\\pi /2} \\\\  & =-[\\frac{\\pi }{2}\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{6}\\operatorname{cos}⁡(\\frac{\\pi }{6})] \\\\  & +[\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(\\frac{\\pi }{6})] \\\\  & =[\\frac{\\pi }{2}\\cdot 0-\\frac{\\pi }{6}\\cdot \\frac{\\sqrt{3}}{2}]+[1-\\frac{1}{2}] \\\\  & =\\frac{\\sqrt{3}\\pi }{12}+\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ecbfbfa-cec6-5df3-a0c9-e11c1f67b71c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e+1}{4}" :db/id #edb/ref 17592186330075} {:answer/id #uuid "4f85b6ee-800b-57ab-a844-ec6e2709c11a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{2}+1" :db/id #edb/ref 17592186330672} {:answer/id #uuid "80f169d6-295c-563d-8914-8d2bd9999054" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{4}" :db/id #edb/ref 17592186331093} {:answer/id #uuid "