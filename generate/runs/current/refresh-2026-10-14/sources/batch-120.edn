:answer-field/choices [{:answer/id #uuid "2314e2c3-071d-5d1e-bdca-e7896981bcd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186330252} {:answer/id #uuid "79f50141-9381-5317-8323-d88e90e3a8a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186331031} {:answer/id #uuid "8b21378b-3425-5e03-a842-b62254df4ffd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186331184} {:answer/id #uuid "b85d4fc1-2e09-58f6-acfa-bed34a4d5787" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186331579} {:answer/id #uuid "c25d6949-0735-57ba-84b8-0d9c36850ad6" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186331676}] :answer-field/correct {:answer/id #uuid "c25d6949-0735-57ba-84b8-0d9c36850ad6" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186331676} :answer-field/id #uuid "abe032e0-af40-56ec-a6ec-e09e79cb742f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332500}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b98f2873-3564-5f19-a00b-95639d25a774" :question/math-academy-id "q-49682" :question/problem "Evaluate ${\\int }_{\\pi /2}^{3\\pi /2}2x\\operatorname{cos}⁡(x)\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}=\\operatorname{cos}⁡(x) & ⇒ & v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =2x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{\\pi /2}^{3\\pi /2}2x\\operatorname{cos}⁡(x)\\,\\text{d}x & =2x\\operatorname{sin}⁡(x){|}_{\\pi /2}^{3\\pi /2}-{\\int }_{\\pi /2}^{3\\pi /2}2\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =2x\\operatorname{sin}⁡(x){|}_{\\pi /2}^{3\\pi /2}+2\\operatorname{cos}⁡(x){|}_{\\pi /2}^{3\\pi /2} \\\\  & =2[\\frac{3\\pi }{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\frac{\\pi }{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})] \\\\  & +2[\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{cos}⁡(\\frac{\\pi }{2})] \\\\  & =2[-\\frac{3\\pi }{2}-\\frac{\\pi }{2}]+2[0-0] \\\\  & =2(-2\\pi )+0 \\\\  & =-4\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186362867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "364fe6cb-9d03-53ce-a165-42f5c54b95ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3e}{16}" :db/id #edb/ref 17592186362869} {:answer/id #uuid "c21264c7-8089-52ce-9a48-6dad38c7f2ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186362870} {:answer/id #uuid "ef9db4ec-3467-518d-a30c-e4d04ca7e957" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{2}" :db/id #edb/ref 17592186362871} {:answer/id #uuid "b4b710cd-dff5-5c54-9db5-d82e41461d08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186362872} {:answer/id #uuid "c0fe8a21-d6a2-507f-9611-cdd51fb00208" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186362873}] :answer-field/correct {:answer/id #uuid "c0fe8a21-d6a2-507f-9611-cdd51fb00208" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186362873} :answer-field/id #uuid "08dd7829-9567-51b3-9a69-757f02b76b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362868}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "65eb7d35-cf19-5d83-87df-2f6cd4fcb07e" :question/math-academy-id "q-114317" :question/problem "Evaluate the integral ${\\int }_{0}^{1/4}x{e}^{4x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{4x} & ⇒ & v=\\frac{{e}^{4x}}{4}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{4x}\\,\\text{d}x & =x\\cdot \\frac{{e}^{4x}}{4}-\\int (\\frac{{e}^{4x}}{4})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/4}x{e}^{4x}\\,\\text{d}x & ={\\frac{1}{4}x{e}^{4x}|}_{0}^{1/4}-\\frac{1}{4}{\\int }_{0}^{1/4}{e}^{4x}\\text{d}x \\\\  & ={\\frac{1}{4}x{e}^{4x}|}_{0}^{1/4}-{\\frac{1}{16}{e}^{4x}|}_{0}^{1/4} \\\\  & =\\frac{1}{4}[\\frac{1}{4}{e}^{4(1/4)}-0\\cdot {e}^{4\\cdot 0}]-\\frac{1}{16}[{e}^{4(1/4)}-{e}^{4\\cdot 0}] \\\\  & =\\frac{1}{4}[\\frac{e}{4}-0]-\\frac{1}{16}[e-1] \\\\  & =\\frac{e}{16}-\\frac{e}{16}+\\frac{1}{16} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186364275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31cdfcf9-98d2-5183-877d-c6911c5786e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{5}" :db/id #edb/ref 17592186364277} {:answer/id #uuid "0c65c166-229d-5e3b-933e-08d975e562bc" :answer/type {:db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186364278} {:answer/id #uuid "aa2cde5a-f869-5481-8dc3-00dd3ad08d94" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi " :db/id #edb/ref 17592186364279} {:answer/id #uuid "a7d225f4-6349-507e-b1a7-f6934a27b132" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\pi }{12}" :db/id #edb/ref 17592186364280} {:answer/id #uuid "23f19c4b-e2a1-55d9-989d-819c4ed4c37f" :answer/type {:db/ident :answer.type/math} :answer/value "36\\pi " :db/id #edb/ref 17592186364281}] :answer-field/correct {:answer/id #uuid "aa2cde5a-f869-5481-8dc3-00dd3ad08d94" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi " :db/id #edb/ref 17592186364279} :answer-field/id #uuid "ce18f523-92fa-512f-8b3f-d199baff422a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364276}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d40fd3d-7b15-59ca-8ee5-88d3927298a9" :question/math-academy-id "q-49678" :question/problem "Evaluate ${\\int }_{-\\pi }^{\\pi }12x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=12x & ⇒ & {u}^{′}=12 \\\\ {v}^{′}=\\operatorname{sin}⁡(x) & ⇒ & v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 12x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =12x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 12\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-\\pi }^{\\pi }12x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-12x\\operatorname{cos}⁡(x){|}_{-\\pi }^{\\pi }+12{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-12x\\operatorname{cos}⁡(x){|}_{-\\pi }^{\\pi }+12\\operatorname{sin}⁡(x){|}_{-\\pi }^{\\pi } \\\\  & =-12[\\pi \\operatorname{cos}⁡(\\pi )+\\pi \\operatorname{cos}⁡(-\\pi )] \\\\  & +12[\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )] \\\\  & =-12[-\\pi -\\pi ]+12[0-0] \\\\  & =-12[-2\\pi ] \\\\  & =24\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ae3e78-b1f4-5477-8bac-c412eb3c2747" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi-4" :db/id #edb/ref 17592186431280}] :answer-field/correct {:answer/id #uuid "81ae3e78-b1f4-5477-8bac-c412eb3c2747" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi-4" :db/id #edb/ref 17592186431280} :answer-field/id #uuid "0902a00b-6972-5278-913c-8072ffb99155" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186431281}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5473d4ab-39f5-5e1e-ade8-0e74627b89e6" :question/math-academy-id "q-349299" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}4x\\operatorname{cos}⁡(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{cos}⁡(x) & ⇒ & v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =4x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}4x\\operatorname{cos}⁡(x)\\,\\text{d}x & =4x\\operatorname{sin}⁡(x)\\,{|}_{0}^{\\pi /2}-4{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =4x\\operatorname{sin}⁡(x)\\,{|}_{0}^{\\pi /2}+4\\operatorname{cos}⁡(x)\\,{|}_{0}^{\\pi /2} \\\\  & =4(\\frac{\\pi }{2}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\cdot \\operatorname{sin}⁡(0))+4(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =4(\\frac{\\pi }{2}\\cdot 1-0\\cdot 0)+4(0-1) \\\\  & =2\\pi -4.\\end{aligned}\n$$"}] :knowledge-point/title "Computing a Definite Integral Using Integration by Parts"}] [{:db/id #edb/ref 17592186100873 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100695 :question/id #uuid "3a696ed3-e341-5ea6-bf17-681ba8e386c7" :question/math-academy-id "e-4407" :question/problem "Let $C=AB.$ What is the value of $c_{32}$, if\n![](images/c6/c6c7e580cfd96bc23c55742535ceb40a94635c2a44b911e0d08311c3a599c2fa.png)" :question/worked-solution "Multiplying the $3$rd row in $A$ by the $2$nd column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{32} & =\\begin{bmatrix}1 & 2 \\\\ -2 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}3 & 4 & -1 \\\\ 1 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix} \\\\  & =1\\cdot 4+2\\cdot (-2) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/questions [{:db/id #edb/ref 17592186101529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da11c7dd-d121-5ec6-a851-0550acc8383c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186100336} {:answer/id #uuid "f05ee2d4-37e9-50bf-9c22-b5b9883029bf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186100337} {:answer/id #uuid "ff390486-aaf4-5c76-bea7-169be73cbb9b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186100338} {:answer/id #uuid "3dbfdba2-052a-5173-854f-fcd1979b88ad" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186100339} {:answer/id #uuid "4a55b509-3db2-5543-b2b0-ff04d40fa36c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186100340}] :answer-field/id #uuid "8eb61b81-552d-543e-9977-b4452142c164" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100335}] :question/id #uuid "b8e4eb4a-9417-587e-869f-333706170962" :question/math-academy-id "q-70791" :question/problem "Let $C = AB$. What is the value of $c_{13}$, if\n$A = \\begin{bmatrix}-1 & 2 \\\\ 3 & 4 \\\\ -5 & 6\\end{bmatrix}, B = \\begin{bmatrix}0 & 1 & -2 \\\\ 2 & 0 & 5\\end{bmatrix}$?"} {:db/id #edb/ref 17592186101530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80585822-4b2a-5bc3-ad21-63aca33fef78" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186100342} {:answer/id #uuid "f46d7639-df84-528a-ac36-8f2b1d918a6a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186100343} {:answer/id #uuid "f94ccd4f-ecfd-528a-99d6-bb71f6fbdbfc" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186100344} {:answer/id #uuid "568af77e-37c0-5e0d-b22d-90aeab758b4a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186100345} {:answer/id #uuid "7559a496-a2a5-5577-b7ea-25f918286d30" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186100346}] :answer-field/id #uuid "9e6f1148-d36b-51bb-99e8-5de0ade3469e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100341}] :question/id #uuid "d6dc76a2-8ad4-5d9f-970f-746f45e0bc48" :question/math-academy-id "q-70792" :question/problem "Let $Z = XY$. What is the value of $z_{42}$, if\n$X = \\begin{bmatrix}-1 & 2 & -1 \\\\ 3 & 4 & 0 \\\\ 0 & -1 & 1 \\\\ -5 & 6 & -2\\end{bmatrix}, Y = \\begin{bmatrix}1 & -3 & -2 \\\\ -4 & 0 & -2 \\\\ -5 & 1 & -1\\end{bmatrix}$?"} {:db/id #edb/ref 17592186265828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a9b3cc-7576-59b2-aabd-3e3baec2350f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186263163} {:answer/id #uuid "220549d6-0043-5ea3-afc4-aec900485a3c" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186263301} {:answer/id #uuid "2ba621a6-7f8a-5196-8dc2-e27ffc2bb0d5" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186263369} {:answer/id #uuid "c860a24f-7231-5ddb-8c12-1297c7899912" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264755} {:answer/id #uuid "e89a0dc1-39c3-5234-b0bd-01580a7b5954" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186265022}] :answer-field/correct {:answer/id #uuid "e89a0dc1-39c3-5234-b0bd-01580a7b5954" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186265022} :answer-field/id #uuid "7b13e3a0-f57b-544f-a120-5165f77a15ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265456}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "945d4e42-e131-5958-8aed-5486accd9a01" :question/math-academy-id "q-130111" :question/problem "Let $S=UV.$ What is the value of ${s}_{13}$, if\n\n$$\nU=\\begin{bmatrix}-2 & 3 & -1 \\\\ 3 & 0 & 4\\end{bmatrix},\\,V=\\begin{bmatrix}-1 & -2 & 3 \\\\ 1 & 3 & -2 \\\\ 10 & 2 & -5\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $1$st row in $U$ by the $3$rd column in $V$, we get\n\n$$\n\\begin{aligned}{s}_{13} & =\\begin{bmatrix}-2 & 3 & -1 \\\\ 3 & 0 & 4\\end{bmatrix}\\begin{bmatrix}-1 & -2 & 3 \\\\ 1 & 3 & -2 \\\\ 10 & 2 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 3 & -1\\end{bmatrix}\\begin{bmatrix}3 \\\\ -2 \\\\ -5\\end{bmatrix} \\\\  & =(-2)\\cdot 3+3\\cdot (-2)+(-1)\\cdot (-5) \\\\  & =-6-6+5 \\\\  & =-7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41cfda0a-f144-589a-a43c-f062ef97cc0c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263582} {:answer/id #uuid "6754aa3f-9d7e-5ec5-8d62-0bc2e16b1dd9" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186263893} {:answer/id #uuid "8692590c-83fe-5fc5-a3dc-acaa0e379556" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186264160} {:answer/id #uuid "cc7c5d22-55ac-5c2e-8365-30562490fd3c" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186264790} {:answer/id #uuid "f3ee5f0e-8ece-5209-a013-26fe841fffb9" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186265142}] :answer-field/correct {:answer/id #uuid "41cfda0a-f144-589a-a43c-f062ef97cc0c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186263582} :answer-field/id #uuid "913f5424-fdc7-501c-8672-ca7479ea1e3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265506}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "131c2176-2405-5c54-b473-9fb3958cf472" :question/math-academy-id "q-130120" :question/problem "Let $D=AB.$ What is the value of ${d}_{24}$, if\n\n$$\nA=\\begin{bmatrix}-1 & 2 & 4 \\\\ 3 & 4 & -1 \\\\ -1 & 1 & 0 \\\\ 0 & 4 & -7\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 1 & -2 & -3 \\\\ 0 & 4 & -1 & 1 \\\\ 2 & 0 & 3 & -3\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $2$nd row in $A$ by the $4$th column in $B$, we get\n\n$$\n\\begin{aligned}{d}_{24} & =\\begin{bmatrix}-1 & 2 & 4 \\\\ 3 & 4 & -1 \\\\ -1 & 1 & 0 \\\\ 0 & 4 & -7\\end{bmatrix}\\begin{bmatrix}1 & 1 & -2 & -3 \\\\ 0 & 4 & -1 & 1 \\\\ 2 & 0 & 3 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 4 & -1\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 1 \\\\ -3\\end{bmatrix} \\\\  & =3\\cdot (-3)+4\\cdot 1+(-1)\\cdot (-3) \\\\  & =-9+4+3 \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73870312-24b0-5710-9582-ace4d833975f" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186291128}] :answer-field/correct {:answer/id #uuid "73870312-24b0-5710-9582-ace4d833975f" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186291128} :answer-field/id #uuid "61916db7-9570-5896-8478-8a654eab7267" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292032}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "375c7db7-262a-5420-9a53-a13dd2a5b997" :question/math-academy-id "q-275547" :question/problem "Let $L=MN.$ What is the value of ${l}_{22}$, if\n\n$$\nM=\\begin{bmatrix}2 & -3 \\\\ 4 & 2\\end{bmatrix},\\,N=\\begin{bmatrix}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{bmatrix}?\n$$\n\n${l}_{22}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{l}_{22} & =\\begin{bmatrix}2 & -3 \\\\ 4 & 2\\end{bmatrix}\\begin{bmatrix}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 3\\end{bmatrix} \\\\  & =4\\cdot 2+2\\cdot 3 \\\\  & =8+6 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297872}] :answer-field/correct {:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297872} :answer-field/id #uuid "0b459b10-8619-5f0d-afdd-56b9910358fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298672}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0cf7bab6-9aaa-53a5-ad4b-30e1807bc5dc" :question/math-academy-id "q-318462" :question/problem "Let $P=QR.$ What is the value of ${p}_{31}$, if\n\n$$\nQ=\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix},\\,R=\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix}?\n$$\n\n${p}_{31}=$\n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $Q$ by the $1$st column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{31} & =\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =2(5)+1(-3)+(-2)(1) \\\\  & =10-3-2 \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186297660}] :answer-field/correct {:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186297660} :answer-field/id #uuid "cd3d9a0e-8498-5cbb-884b-c40fde8b221a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "941171d1-f178-5deb-90c4-b1a669882e6a" :question/math-academy-id "q-318463" :question/problem "Let $X=YZ.$ What is the value of ${x}_{12}$, if\n\n$$\nY=\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix},\\,Z=\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix}?\n$$\n\n${x}_{12}=$\n{{field-1}}" :question/worked-solution "Multiplying the $1$st row in $Y$ by the $2$nd column in $Z$, we get\n\n$$\n\\begin{aligned}{x}_{12} & =\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix}\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 3 & 0\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =(-2)(5)+3(-3)+0(1) \\\\  & =-10-9+0 \\\\  & =-19.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299687 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298385}] :answer-field/correct {:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298385} :answer-field/id #uuid "04b1a5a5-69b5-54cc-9927-afbe16de429c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298654}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d709c6eb-9e1b-5062-85d4-7521181b0638" :question/math-academy-id "q-318470" :question/problem "Let $Z=XY.$ What is the value of ${z}_{24}$, if\n\n$$\nX=\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix},\\,Y=\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix}?\n$$\n\n${z}_{24}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $X$ by the $4$th column in $Y,$ we get\n\n$$\n\\begin{aligned}{z}_{24} & =\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 2\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix} \\\\  & =3(-3)+2(2) \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab14835-d162-5a27-a085-b4b919a36b42" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186336132} {:answer/id #uuid "3315575e-eba2-51bc-a342-692c1283d7cb" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186336516} {:answer/id #uuid "618bb264-210a-53cf-ab61-500e5973c2f3" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186336911} {:answer/id #uuid "9eb3cc5f-cfd1-5a82-9250-0d6ceda1e462" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337467} {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186337488}] :answer-field/correct {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186337488} :answer-field/id #uuid "a63e7de0-266f-539b-8fee-e35ab81173de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338586}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "44992928-91b6-50f2-9197-4b5da9dd00f2" :question/math-academy-id "q-70946" :question/problem "Let $D=EF.$ What is the value of ${d}_{23}$, if\n\n$$\nE=\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix},\\,F=\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $2$nd row in $E$ by the $3$rd column in $F$, we get\n\n$$\n\\begin{aligned}{d}_{23} & =\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix}\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 3\\end{bmatrix}\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =(-4)\\cdot (-5)+3\\cdot (-2) \\\\  & =20-6 \\\\  & =14.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e95cad-860e-538a-8b99-9f0c70f261c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336097} {:answer/id #uuid "57fc8d0d-2b20-52ee-b810-0e17521266a7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336838} {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337096} {:answer/id #uuid "a99efaa4-b49e-5cdd-af2c-d3ba9219b384" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186337563} {:answer/id #uuid "ad8fdf84-56c3-5819-a6bb-de4f89a6b352" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186337589}] :answer-field/correct {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337096} :answer-field/id #uuid "7d3b9a44-3753-5606-8ec0-132a1ef649d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338499}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bb301367-989b-59c3-9a3a-157e756a6cf8" :question/math-academy-id "q-70949" :question/problem "Let $K=MN.$ What is the value of ${k}_{12}$, if\n\n$$\nM=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix},\\,N=\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $1$st row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{12} & =\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix} \\\\  & =5\\cdot (-1)+(-4)\\cdot (-2) \\\\  & =-5+8 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} {:answer/id #uuid "3b70ccb4-c16c-5cf5-b11e-8aafc5f11705" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186336590} {:answer/id #uuid "baedc752-7f92-5818-8e49-7eadefb98f9f" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186337692} {:answer/id #uuid "d7a7677a-b2a4-59f0-ac24-ee44c46d1a26" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186337904} {:answer/id #uuid "f431b48c-3499-5e6b-9764-458010a3f0be" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186338165}] :answer-field/correct {:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} :answer-field/id #uuid "618939f6-04ba-5ea6-a01f-f04923f31488" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338449}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3ed5dbc7-d94a-5c52-80fe-8e1e3e8256f9" :question/math-academy-id "q-70956" :question/problem "Let $T=UV.$ What is the value of ${t}_{41}$, if\n\n$$\nU=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix},\\,V=\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $4$th row of $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{41} & =\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =(-5)\\cdot (-2)+3\\cdot (-1)+10\\cdot (-1) \\\\  & =10-3-10 \\\\  & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n$$\nP=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix},\\,Q=\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -4\\end{bmatrix}\\begin{bmatrix}10 \\\\ 7\\end{bmatrix} \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}]}
