ath} :answer/value "4" :db/id #edb/ref 17592186295375} {:answer/id #uuid "28fc5cf6-6471-5d82-bb36-92f61e00662f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295498} {:answer/id #uuid "38232641-7f92-55ce-8842-067f6f7fcb51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186295582} {:answer/id #uuid "a107bd3a-590a-5785-8899-90e2f9d4863d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186296123}] :answer-field/correct {:answer/id #uuid "0a358628-bbab-5730-aa92-30852d8b8b73" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295319} :answer-field/id #uuid "b26af55d-71ac-5eea-97e8-97cf35cab8c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e5cf9073-af1e-5711-af30-8567dad9e870" :question/math-academy-id "q-288135" :question/problem "Consider the equation in the variable $y,$ given by\n\n$$\n4py=-2\n$$\n\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=4p,\\,b=-2.\n$$\n\nTherefore, the equation has no solution if\n\n$$\n4p=0.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=0.\n$$"} {:db/id #edb/ref 17592186297178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9cd574-87f6-5684-a4a2-52f23dcc4f6d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295323} {:answer/id #uuid "4512c30d-0418-5d1a-a9a4-5767ffaddbf8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295659} {:answer/id 