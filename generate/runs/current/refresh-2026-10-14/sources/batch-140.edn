& -6 \\\\ 7 & 8 & -9\\end{bmatrix}" :db/id #edb/ref 17592186337588} {:answer/id #uuid "d87232e7-9ac0-5e74-9288-126f3843a691" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & \\,\\,\\,-4 & 5 \\\\ 7 & 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186337912} {:answer/id #uuid "e979800a-d684-515d-a581-6ee7d81f7d42" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 3 \\\\ \\,\\,\\,-4 & 5 & 6 \\\\ 7 & 8 & 9\\end{bmatrix}" :db/id #edb/ref 17592186338070}] :answer-field/correct {:answer/id #uuid "d87232e7-9ac0-5e74-9288-126f3843a691" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & \\,\\,\\,-4 & 5 \\\\ 7 & 0 & 8\\end{bmatrix}" :db/id #edb/ref 17592186337912} :answer-field/id #uuid "2d485f3e-94a3-58e5-82d8-2b9ca2129796" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338360}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "05b351f4-ec25-5f54-8775-4cda53fe0446" :question/math-academy-id "q-71714" :question/problem "What is the coefficient matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y=3 \\\\ -4y+5z=6 \\\\ 7x+8z=9\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\begin{aligned}{\\begin{aligned}x+2y+0z=3 \\\\ 0x-4y+5z=6 \\\\ 7x+0y+8z=9\\end{aligned}\\end{aligned}\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}1 & 2 & 0 \\\\ 0 & \\,\\,\\,-4 & 5 \\\\ 7 & 0 & 8\\end{bmatrix}\n$$"}] :knowledge-point/title "Finding the Coefficient Matrix of a System of Linear Equations"}] [{:db/id #edb/ref 17592186059768 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059577 :question/id #uuid "b5967dd6-bdf9-5cd0-9639-ec2816d04256" :question/math-academy-id "e-4684" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n![](images/a5/a5abba041a61cad76d43d5bb13d0fd4e873eb2daf2282e8d9828b8ab79fe2ba0.png)" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n![](images/2f/2f9ae37920ec528a700715658900bbbf3ec4c855767bf06f79d044f488a8bbf2.png)\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\left\\lbrack\n\t\\matrix {\n\t\t1 & 1 & -3 \\\n\t\t-7 & -1 & 1 \\\n                2 & 1 & -2 \n\t}\n\t\\right\\rbrack\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n![](images/af/af1499610c0c312a1f5c50d99967a004ae6b3042c3a88ca20a86f922b28aaaff.png)"} :knowledge-point/id #uuid "3f9ccaa5-d69c-584d-946e-0c57b3050160" :knowledge-point/questions [{:db/id #edb/ref 17592186059969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f36c6d0-d4a6-5f4b-8a3b-e70b9d746666" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 1 & 0 & 9\\end{array}\\right]" :db/id #edb/ref 17592186238184} {:answer/id #uuid "5b0b792e-91b6-5398-8f05-b6eca06d89b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 1 & 1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186238843} {:answer/id #uuid "bd5e7734-a55a-5ab8-87e5-1607c023de19" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 0 & 1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186239705} {:answer/id #uuid "c17de7bc-051c-5d71-a1b6-48a31e14f49d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 1 & 1 \\\\ 1 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186239747} {:answer/id #uuid "f9869cab-b95d-563e-a32f-123c0f5c7137" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 1 & 1 \\\\ 1 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186240263}] :answer-field/correct {:answer/id #uuid "bd5e7734-a55a-5ab8-87e5-1607c023de19" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 0 & 1 & 9\\end{array}\\right]" :db/id #edb/ref 17592186239705} :answer-field/id #uuid "ccab6e40-0d12-5a86-a565-87bd8af797a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240688}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fc7baee7-708d-5083-9b3d-6efab5143302" :question/math-academy-id "q-1051" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\begin{cases}6x+y+z=4 \\\\ x+z=9\\end{cases}$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\begin{cases}6x+y+z=4 \\\\ x+0y+z=9\\end{cases}$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\left[\\begin{array}{cc|c}6 & 1 & 1 \\\\ 1 & 0 & 1\\end{array}\\right]\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}6 & 1 & 1 & 4 \\\\ 1 & 0 & 1 & 9\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186060201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5302557b-a7b1-5e1f-8977-b9ce4ab14929" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & 1 & 5 \\\\ 1 & 1 & 6\\end{array}\\right]" :db/id #edb/ref 17592186285551} {:answer/id #uuid "62179514-e299-574b-b29f-c9