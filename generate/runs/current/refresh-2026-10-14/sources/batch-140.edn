nt matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{ccc|c}21 & 1 & 1 & 17 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186510656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a65aca2-38dd-59e3-b1c7-039905c04317" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & 19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510648} {:answer/id #uuid "6566fc61-7a5a-592d-9dc2-c0350737660c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & 0 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510654} {:answer/id #uuid "886a6286-37e4-5c0a-93ea-fa942c212225" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & -1 & 6 \\\\ -17 & 21 & 23 & 0 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510662} {:answer/id #uuid "9482753c-57a4-53a9-b52c-c5c772f0bdc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & 1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510664} {:answer/id #uuid "fc1133df-98bb-5e9c-92c1-0a2d359167ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & -19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & 19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510683}] :answer-field/correct {:answer/id #uuid "5a65aca2-38dd-59e3-b1c7-039905c04317" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}8 & 19 & -1 & 6 \\\\ -17 & 21 & 0 & -23 \\\\ 15 & -1 & -19 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510648} :answer-field/id #uuid "3ac74c0e-650c-5c0d-aae4-91abf12af746" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 