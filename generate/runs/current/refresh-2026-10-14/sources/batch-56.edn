#{[{:db/id #edb/ref 17592186059677 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059505 :question/id #uuid "0bc72287-b782-5add-89ef-f2a465573ab0" :question/math-academy-id "e-3653" :question/problem "Find $f''(x)$ for $f(x) = 2x^3 + \\dfrac 1 x.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(2{x}^{3}+\\frac{1}{x})}^{′} \\\\  & ={(2{x}^{3}+{x}^{-1})}^{′} \\\\  & =2(3){x}^{2}-{x}^{-2} \\\\  & =6{x}^{2}-{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & =(6{x}^{2}-{x}^{-2})^{′} \\\\  & =6(2)x-(-2){x}^{-3} \\\\  & =12x+2{x}^{-3}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932 :topic/math-academy-id 278 :topic/title "The Sum and Constant Multiple Rules for Differentiation"} {:db/id #edb/ref 17592186050420 :topic/math-academy-id 280 :topic/title "Differentiating Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186059971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbe4aeca-271b-5a58-b495-ee46d8ee584c" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{2} - 14x" :db/id #edb/ref 17592186056186} {:answer/id #uuid "c09440c7-c1b1-599c-89f7-de006da8a227" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{2} - 14" :db/id #edb/ref 17592186056187} {:answer/id #uuid "e08f438f-113e-59d3-a000-03da1819bbc2" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{2}" :db/id #edb/ref 17592186056188} {:answer/id #uuid "e5ef5f67-294a-5b3d-b4fe-ebc3db7cbb1e" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{2} + 14" :db/id #edb/ref 17592186056189} {:answer/id #uuid "3936c6ec-3d4a-5766-83ab-b288ca48dcc4" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{2} + 14x" :db/id #edb/ref 17592186056190}] :answer-field/id #uuid "742f921d-0a5c-5461-9ead-962ba03a2f11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056185}] :question/id #uuid "698346c2-da12-556d-9fea-b6c4b1662b70" :question/math-academy-id "q-10573" :question/problem "Find $f^{″}(x)$ for $f(x) = 3x^{4} - 7x^{2} - 8$."} {:db/id #edb/ref 17592186060172 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d02a6f3-28d4-5c66-9ce4-f8598635727f" :answer/type {:db/ident :answer.type/math} :answer/value "20x^{3} - 8x" :db/id #edb/ref 17592186057483} {:answer/id #uuid "06a4ffbe-27e8-5ae9-a28b-8e6aa5522269" :answer/type {:db/ident :answer.type/math} :answer/value "20x^{3} - 8x - 7" :db/id #edb/ref 17592186057484} {:answer/id #uuid "22a0db5b-6b84-5969-9553-68a3a27228d0" :answer/type {:db/ident :answer.type/math} :answer/value "60x^{2} - 8" :db/id #edb/ref 17592186057485} {:answer/id #uuid "2a3ebbb6-9ee3-5641-8b28-49459285b596" :answer/type {:db/ident :answer.type/math} :answer/value "8x" :db/id #edb/ref 17592186057486} {:answer/id #uuid "3bb9bcc3-e2a8-574e-8bd2-15125f48346c" :answer/type {:db/ident :answer.type/math} :answer/value "60x^{2}" :db/id #edb/ref 17592186057487}] :answer-field/id #uuid "a7eb1815-6bb3-59e3-b68f-1fe5be350bfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057482}] :question/id #uuid "b9ef1c3d-25ed-5b43-9410-0f67214fa9e4" :question/math-academy-id "q-1851" :question/problem "Find $f^{″}(x)$ for $f(x) = 5x^{4} - 4x^{2} - 7x$."} {:db/id #edb/ref 17592186233123 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "de3aadfd-ded1-53bb-8c7a-ca7c60560e8d" :question/math-academy-id "q-10907" :question/problem "Find ${f}^{''}(-1)$ if $f(x)=4{x}^{5}-3{x}^{4}.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & ={(4{x}^{5}-3{x}^{4})}^{'} &  \\\\  & =5\\cdot 4{x}^{4}-4\\cdot 3{x}^{3} \\\\  & =20{x}^{4}-12{x}^{3}\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{''}(x) & ={(20{x}^{4}-12{x}^{3})}^{'} \\\\  & =4\\cdot 20{x}^{3}-3\\cdot 12{x}^{2} \\\\  & =80{x}^{3}-36{x}^{2}\\,.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=-1$, we obtain\n\n$$\n\\begin{aligned}{f}^{''}(-1) & =80(-1)^{3}-36(-1)^{2} \\\\  & =-80-36 \\\\  & =-116.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233601 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1655c1ae-8739-50f2-81ee-c83924d8db9a" :question/math-academy-id "q-1852" :question/problem "Find ${f}^{''}(x)$ for $f(x)=12{x}^{3}-5\\operatorname{sin}x+4\\operatorname{cos}x.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & ={(12{x}^{3}-5\\operatorname{sin}x+4\\operatorname{cos}x)}^{'} &  \\\\  & =3\\cdot 12{x}^{2}-5(\\operatorname{cos}x)+4(-\\operatorname{sin}x) \\\\  & =36{x}^{2}-5\\operatorname{cos}x-4\\operatorname{sin}x.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{''}(x) & ={(36{x}^{2}-5\\operatorname{cos}x-4\\operatorname{sin}x)}^{'} \\\\  & =2\\cdot 36x-5(-\\operatorname{sin}x)-4(\\operatorname{cos}x) \\\\  & =72x+5\\operatorname{sin}x-4\\operatorname{cos}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa00d870-fb4a-5923-b620-e0f176cf7ea7" :answer/type {:db/ident :answer.type/math} :answer/value "-6x-6" :db/id #edb/ref 17592186234940}] :answer-field/correct {:answer/id #uuid "fa00d870-fb4a-5923-b620-e0f176cf7ea7" :answer/type {:db/ident :answer.type/math} :answer/value "-6x-6" :db/id #edb/ref 17592186234940} :answer-field/id #uuid "6d17eea9-4da4-5969-9c62-f3e153c4f561" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235092}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "278a7bce-1b90-5d01-b44e-3fac1eca5038" :question/math-academy-id "q-128287" :question/problem "Calculate ${f}^{″}(x).$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${f}^{″}(x)\\,=\\,$ \n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "We already know that\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-3{x}^{2}-6x+24.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(-3{x}^{2}-6x+24)}^{′} \\\\  & =-3\\cdot 2x-6\\cdot 1+0 \\\\  & =-6x-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0803874-a90d-56fd-a574-502ea3d987fc" :answer/type {:db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186234925}] :answer-field/correct {:answer/id #uuid "f0803874-a90d-56fd-a574-502ea3d987fc" :answer/type {:db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186234925} :answer-field/id #uuid "a145d34e-2f2d-57fd-861d-ae23542378fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235165}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cf5f6035-a258-5a14-8838-a24ee5796c2c" :question/math-academy-id "q-167325" :question/problem "${g}^{″}(x)=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8-\\frac{2}{3}\\cdot 3{x}^{2} \\\\  & =8-2{x}^{2}.\\end{aligned}\n$$\n\nFinally, computing the second derivative, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(8-2{x}^{2}) \\\\  & =-4x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a3cb5e0-0aab-5830-9d6d-c2f1e718af9c" :answer/type {:db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186234757}] :answer-field/correct {:answer/id #uuid "8a3cb5e0-0aab-5830-9d6d-c2f1e718af9c" :answer/type {:db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186234757} :answer-field/id #uuid "5e373de0-a688-5868-b03b-0611dc9458f1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235069}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "321a6511-60f4-5506-a94d-91240e0772aa" :question/math-academy-id "q-167779" :question/problem "${g}^{″}(x)=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8-\\frac{2}{3}\\cdot 3{x}^{2} \\\\  & =8-2{x}^{2}.\\end{aligned}\n$$\n\nFinally, computing the second derivative, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(8-2{x}^{2}) \\\\  & =-4x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0937fb22-de20-5285-adfe-fb134454e739" :answer/type {:db/ident :answer.type/math} :answer/value "24{x}^{2}-24" :db/id #edb/ref 17592186241260} {:answer/id #uuid "4ade996e-8565-5999-b8b9-37a0812a3215" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186241854} {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} {:answer/id #uuid "c17a783f-f9eb-533a-858b-97da81489721" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}-10" :db/id #edb/ref 17592186242874} {:answer/id #uuid "e29f5fcc-b099-589c-9900-89b9765edee7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186243194}] :answer-field/correct {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} :answer-field/id #uuid "4cfdea00-47d2-5a4e-be1a-28b9c2503425" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243586}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2dffb4d9-bf1b-5b2c-8ebe-2cdd8aa443db" :question/math-academy-id "q-10883" :question/problem "Find ${f}^{″}(x)$ for $f(x)=4\\sqrt{x}+5{x}^{2}+x.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(4\\sqrt{x}+5{x}^{2}+x)}^{′} \\\\  & ={(4{x}^{1/2}+5{x}^{2}+x)}^{′} \\\\  & =\\frac{1}{2}\\cdot 4{x}^{-1/2}+2\\cdot 5x+1 \\\\  & =2{x}^{-1/2}+10x+1\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(2{x}^{-1/2}+10x+1)}^{′} \\\\  & =-\\frac{1}{2}\\cdot 2{x}^{-3/2}+10+0 \\\\  & =-{x}^{-3/2}+10 \\\\  & =-\\frac{1}{\\sqrt{{x}^{3}}}+10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a244425-3749-5c1f-8cde-c706ba9401be" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186241269} {:answer/id #uuid "0f5837e4-11e0-542c-8b9f-939b3ff4674a" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186241311} {:answer/id #uuid "22ad69eb-6de8-5ec6-8df2-1b4a1903b77e" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186241480} {:answer/id #uuid "a4e8467a-fb2b-587f-a5f4-a0e51ab08e62" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186242631} {:answer/id #uuid "f02f5db4-9ff4-5a63-b827-32f454692621" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186243315}] :answer-field/correct {:answer/id #uuid "0a244425-3749-5c1f-8cde-c706ba9401be" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186241269} :answer-field/id #uuid "c32d794a-6e85-5bf8-8ed7-81fe7811ab5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243785}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d969ea68-aab7-5811-a686-d14bdbf027ac" :question/math-academy-id "q-10892" :question/problem "Find ${f}^{″}(-2)$ if $f(x)=2{x}^{3}+4{x}^{2}-7.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(2{x}^{3}+4{x}^{2}-7)}^{′} &  \\\\  & =3\\cdot 2{x}^{2}+2\\cdot 4x-0 \\\\  & =6{x}^{2}+8x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(6{x}^{2}+8x)}^{′} \\\\  & =2\\cdot 6x+8 \\\\  & =12x+8\\,.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=-2$, we obtain\n\n$$\n\\begin{aligned}{f}^{″}(-2) & =12(-2)+8 \\\\  & =-24+8 \\\\  & =-16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "529b3b5f-5184-57e6-92af-e107ed446d23" :answer/type {:db/ident :answer.type/math} :answer/value "30{x}^{5}+20{x}^{4}" :db/id #edb/ref 17592186241914} {:answer/id #uuid "7cf8852c-8566-5c26-a458-3a13a3298fc4" :answer/type {:db/ident :answer.type/math} :answer/value "30{x}^{4}+25{x}^{3}" :db/id #edb/ref 17592186242276} {:answer/id #uuid "9daca241-19af-5dac-b1c4-662389bf1310" :answer/type {:db/ident :answer.type/math} :answer/value "30{x}^{4}+20{x}^{3}" :db/id #edb/ref 17592186242556} {:answer/id #uuid "a04edd58-c118-5af2-9bcd-bd23442203b5" :answer/type {:db/ident :answer.type/math} :answer/value "40{x}^{3}+30{x}^{2}" :db/id #edb/ref 17592186242583} {:answer/id #uuid "b883a0a4-32f3-575c-85e6-75eb0b45d35f" :answer/type {:db/ident :answer.type/math} :answer/value "35{x}^{4}+20{x}^{3}" :db/id #edb/ref 17592186242799}] :answer-field/correct {:answer/id #uuid "9daca241-19af-5dac-b1c4-662389bf1310" :answer/type {:db/ident :answer.type/math} :answer/value "30{x}^{4}+20{x}^{3}" :db/id #edb/ref 17592186242556} :answer-field/id #uuid "8dbb22a9-36ce-5b90-b084-6a4e41f2d13d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243703}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b52b494-b991-5987-a3d3-0817f181b4b9" :question/math-academy-id "q-10902" :question/problem "Find ${f}^{″}(x)$ for $f(x)={x}^{6}+{x}^{5}.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{6}+{x}^{5})}^{′} \\\\  & =6\\cdot {x}^{5}+5\\cdot {x}^{4} \\\\  & =6{x}^{5}+5{x}^{4}\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(6{x}^{5}+5{x}^{4})}^{′} \\\\  & =5\\cdot 6{x}^{4}+4\\cdot 5{x}^{3} \\\\  & =30{x}^{4}+20{x}^{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b268833-a892-5a14-ab75-38558f16bc57" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186295511} {:answer/id #uuid "bf7be3a8-94b4-5a24-adb6-b753140ab093" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186296278} {:answer/id #uuid "d19d31e7-9654-53a0-8391-14a1f9103d85" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186296372} {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} {:answer/id #uuid "edf73d42-1443-5359-8707-64a0a6a850c6" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186296527}] :answer-field/correct {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} :answer-field/id #uuid "e0375b64-7629-58c5-bdc5-3b40af6de210" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297096}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "88cefa50-35a4-5398-bbcf-d41d22641c1f" :question/math-academy-id "q-28556" :question/problem "Find ${g}^{″}(4)$ if $g(x)=4{x}^{2}\\sqrt{x}-2x+7.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & ={(4{x}^{2}\\sqrt{x}-2x+7)}^{′} \\\\  & ={(4{x}^{5/2}-2x+7)}^{′} \\\\  & =4(\\frac{5}{2}){x}^{3/2}-2+0 \\\\  & =10{x}^{3/2}-2.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{g}^{″}(x) & ={(10{x}^{3/2}-2)}^{′} \\\\  & =10(\\frac{3}{2}){x}^{1/2}-0 \\\\  & =15{x}^{1/2} \\\\  & =15\\sqrt{x}.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=4$, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(4) & =15\\sqrt{4} \\\\  & =15(2) \\\\  & =30.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c19f81e-01bc-5afa-9c54-cd5d13905a3e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186315806}] :answer-field/correct {:answer/id #uuid "7c19f81e-01bc-5afa-9c54-cd5d13905a3e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186315806} :answer-field/id #uuid "b556c2a9-a165-5bb4-80fe-96d361886c1d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316973}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6ad0715e-8443-526b-9290-e5e4f91ac239" :question/math-academy-id "q-342851" :question/problem "Find ${g}^{″}(1)$ if $g(x)=-{x}^{3}+4x\\sqrt{x}.$\n\n${g}^{″}(1)=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & ={(-{x}^{3}+4x\\sqrt{x})}^{′} \\\\  & ={(-{x}^{3}+4{x}^{3/2})}^{′} \\\\  & =3(-{x}^{2})+\\frac{3}{2}(4{x}^{1/2}) \\\\  & =-3{x}^{2}+6{x}^{1/2}.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{g}^{″}(x) & ={(-3{x}^{2}+6{x}^{1/2})}^{′} \\\\  & =2(-3x)+\\frac{1}{2}(6{x}^{-1/2}) \\\\  & =-6x+3{x}^{-1/2} \\\\  & =-6x+\\frac{3}{\\sqrt{x}}.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=1$, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(1) & =-6(1)+\\frac{3}{\\sqrt{1}} \\\\  & =-6+3 \\\\  & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer/type {:db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186513842}] :answer-field/correct {:answer/id #uuid "75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer/type {:db/ident :answer.type/math} :answer/value "-4x" :db/id #edb/ref 17592186513842} :answer-field/id #uuid "826eda45-40bd-506b-a5bb-0ddbb36d06dc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514287}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "60d8ee2b-aed9-5a87-bc1d-99d095c196bb" :question/math-academy-id "q-166072" :question/problem "${g}^{″}(x)=${{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8-\\frac{2}{3}\\cdot 3{x}^{2} \\\\  & =8-2{x}^{2}.\\end{aligned}\n$$\n\nFinally, computing the second derivative, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(8-2{x}^{2}) \\\\  & =-4x.\\end{aligned}\n$$"}] :knowledge-point/title "Computing Second Order Derivatives"}] [{:db/id #edb/ref 17592186059678 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059506 :question/id #uuid "b092bc79-d369-5ff0-a6bb-5fc059699275" :question/math-academy-id "e-3654" :question/problem "Calculate $\\dfrac {\\textrm d^2 y}{\\textrm d x^2}$ for $y = 3 x^4 + 5x+ \\sqrt x.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+5x+\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+5x+{x}^{1/2}) \\\\  & =3(4){x}^{3}+5+\\frac{1}{2}{x}^{-1/2} \\\\  & =12{x}^{3}+5+\\frac{1}{2}{x}^{-1/2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{3}+5+\\frac{1}{2}{x}^{-1/2}) \\\\  & =12(3){x}^{2}+0+\\frac{1}{2}(-\\frac{1}{2}){x}^{-3/2} \\\\  & =36{x}^{2}-\\frac{1}{4}{x}^{-3/2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050690 :topic/math-academy-id 1116 :topic/title "Differentiating Logarithmic Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186059983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5be5fc5-1b3a-5415-919e-e488457ff30d" :answer/type {:db/ident :answer.type/math} :answer/value "84x^{5} + 100x^{3} - \\frac{24}{x^{3}}" :db/id #edb/ref 17592186056257} {:answer/id #uuid "c932bc43-ea00-5841-957b-d630de6af19c" :answer/type {:db/ident :answer.type/math} :answer/value "84x^{5} + 100x^{3} - 24x^{3}" :db/id #edb/ref 17592186056258} {:answer/id #uuid "d5d53180-7f30-5ee1-bd1f-48f86e9550cc" :answer/type {:db/ident :answer.type/math} :answer/value "84x^{5} + 100x^{3} + \\frac{24}{x^{3}}" :db/id #edb/ref 17592186056259} {:answer/id #uuid "49664c83-92b6-5404-9f76-f0481c8627d0" :answer/type {:db/ident :answer.type/math} :answer/value "84x^{5} + 60x^{3} + \\frac{24}{x^{3}}" :db/id #edb/ref 17592186056260} {:answer/id #uuid "6bc3dc9f-411d-5bab-816f-61a1ca17b0e7" :answer/type {:db/ident :answer.type/math} :answer/value "60x^{5} + 100x^{3} + \\frac{24}{x^{3}}" :db/id #edb/ref 17592186056261}] :answer-field/id #uuid "8cb21671-2189-5d05-a36c-cf69d2de94b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056256}] :question/id #uuid "b06e811e-bb9a-57ca-8534-6f06b83ca3e1" :question/math-academy-id "q-10894" :question/problem "Calculate $\\frac{d^{2}y}{dx^{2}}$ for $y = 2x^{7} + 5x^{5} + \\frac{12}{x}$."} {:db/id #edb/ref 17592186059986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23efc5ef-2690-54f2-bee2-55957c887e24" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{2}+12" :db/id #edb/ref 17592186241494} {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} {:answer/id #uuid "864b257c-04a1-57df-ba29-1fda8aa650a7" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{2}+8x" :db/id #edb/ref 17592186242356} {:answer/id #uuid "c9c4addb-f175-5120-8653-b40175f4b448" :answer/type {:db/ident :answer.type/math} :answer/value "30{x}^{2}+8" :db/id #edb/ref 17592186242960} {:answer/id #uuid "cd2989ae-1b63-5358-ae2f-b0968d4a0f14" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+8" :db/id #edb/ref 17592186242985}] :answer-field/correct {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} :answer-field/id #uuid "17955a33-082e-5b39-af43-2edeaac25d20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243479}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b7a8a2be-ff9a-5f4a-96bd-e383a3bb4443" :question/math-academy-id "q-10903" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=5{x}^{4}+4{x}^{2}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+4{x}^{2}) \\\\  & =4\\cdot 5{x}^{3}+2\\cdot 4x \\\\  & =20{x}^{3}+8x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(20{x}^{3}+8x) \\\\  & =3\\cdot 20{x}^{2}+8 \\\\  & =60{x}^{2}+8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233603 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "443f2d86-b193-514f-8fa7-b04ad26e2b53" :question/math-academy-id "q-1873" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=-3\\operatorname{sin}x+5{x}^{3}-19.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{sin}x+5{x}^{3}-19) \\\\  & =-3\\operatorname{cos}x+3\\cdot 5{x}^{2}-0 \\\\  & =-3\\operatorname{cos}x+15{x}^{2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{cos}x+15{x}^{2}) \\\\  & =-3(-\\operatorname{sin}x)+2\\cdot 15x \\\\  & =3\\operatorname{sin}x+30x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8c3d43f-23b0-5425-88c0-fc158bde4601" :answer/type {:db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186232893}] :answer-field/correct {:answer/id #uuid "a8c3d43f-23b0-5425-88c0-fc158bde4601" :answer/type {:db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186232893} :answer-field/id #uuid "81d972e8-8030-589f-a30d-a41cff65da46" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232892}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e0540428-ac4f-55af-ae7e-8832aecc5895" :question/math-academy-id "q-342868" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}) \\\\  & =8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2} \\\\  & =2{x}^{7}+1+2{x}^{-3/2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7}+1+2{x}^{-3/2}) \\\\  & =7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2} \\\\  & =14{x}^{6}-3{x}^{-5/2} \\\\  & =14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1011aa3a-954e-50dc-ae18-549fb483dc2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}-\\frac{1}{2{x}^{4}}" :db/id #edb/ref 17592186238192} {:answer/id #uuid "37a1c828-f01a-5291-b4c3-a7df666b6ef7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{x}^{4}}+\\frac{1}{x}" :db/id #edb/ref 17592186238537} {:answer/id #uuid "624d0f96-ecbc-542d-a722-fcec02fdffb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186238921} {:answer/id #uuid "77f204bc-bb7d-50f3-9399-6ddab9bf24e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3{x}^{3}}-\\frac{2}{x}" :db/id #edb/ref 17592186239090} {:answer/id #uuid "cf221d71-61bf-50ec-ba67-26d985655f37" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{x}^{2}}-\\frac{1}{{x}^{4}}" :db/id #edb/ref 17592186239871}] :answer-field/correct {:answer/id #uuid "624d0f96-ecbc-542d-a722-fcec02fdffb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186238921} :answer-field/id #uuid "25967c04-e2d2-5d17-a034-bddf2421e5de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240397}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c5fc6aa-a9f3-5065-aa63-827da84b30b5" :question/math-academy-id "q-104191" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=ln⁡x+\\frac{1}{6{x}^{2}}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+\\frac{1}{6{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+\\frac{1}{6}{x}^{-2}) \\\\  & =\\frac{1}{x}+\\frac{1}{6}\\cdot (-2){x}^{-2-1} \\\\  & ={x}^{-1}-\\frac{1}{3}{x}^{-3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-1}-\\frac{1}{3}{x}^{-3}) \\\\  & =(-1){x}^{-1-1}-\\frac{1}{3}\\cdot (-3){x}^{-3-1} \\\\  & =\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa44a27-ef68-5389-9758-f884a5d93477" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x" :db/id #edb/ref 17592186238277} {:answer/id #uuid "2415dd70-94cd-5924-9d0e-22cf05a020c7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{{x}^{5}}}+cos⁡x" :db/id #edb/ref 17592186238374} {:answer/id #uuid "93cb1ee1-225c-5deb-b3e5-a0bf21607a98" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{{x}^{5}}-sin⁡x" :db/id #edb/ref 17592186239332} {:answer/id #uuid "9d1e2a22-2c42-5e28-96bc-5600c10b0095" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\sqrt{{x}^{5}}}+2sin⁡x" :db/id #edb/ref 17592186239420} {:answer/id #uuid "b15c3867-b8c6-5277-b1af-d18fc8689a91" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{{x}^{5}}-2cos⁡x" :db/id #edb/ref 17592186239603}] :answer-field/correct {:answer/id #uuid "1aa44a27-ef68-5389-9758-f884a5d93477" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x" :db/id #edb/ref 17592186238277} :answer-field/id #uuid "3465f331-8843-5ef7-b5b2-36db197078df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240427}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7aef485-7834-5512-aabf-9615a3c07b9a" :question/math-academy-id "q-104192" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{4}{\\sqrt{x}}+2sin⁡x.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{\\sqrt{x}}+2sin⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{-1/2}+2sin⁡x) \\\\  & =4(-\\frac{1}{2}){x}^{-1/2-1}+2cos⁡x \\\\  & =-2{x}^{-3/2}+2cos⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-3/2}+2cos⁡x) \\\\  & =-2(-\\frac{3}{2}){x}^{-3/2-1}-2sin⁡x \\\\  & =\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55141915-0d74-5334-b370-96432f69b95b" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}-24x-20" :db/id #edb/ref 17592186241947} {:answer/id #uuid "6306efd5-043b-539c-91ee-7e9f27e5dfbc" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+24x-22" :db/id #edb/ref 17592186242071} {:answer/id #uuid "b34c7760-3388-5d7c-98f0-4822140cb6c6" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+24x-20" :db/id #edb/ref 17592186242743} {:answer/id #uuid "d1adf1ed-bc60-5f4d-845b-5aaad68f50b2" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+48x-20" :db/id #edb/ref 17592186243027} {:answer/id #uuid "eff1d342-3308-57a3-b940-c84f6585776a" :answer/type {:db/ident :answer.type/math} :answer/value "30{x}^{3}+24x-20" :db/id #edb/ref 17592186243311}] :answer-field/correct {:answer/id #uuid "b34c7760-3388-5d7c-98f0-4822140cb6c6" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+24x-20" :db/id #edb/ref 17592186242743} :answer-field/id #uuid "f4aa114b-2075-5fda-80cc-208793687adb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243864}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c88b9b5e-25b3-5b4b-a09e-22dcd4394553" :question/math-academy-id "q-10884" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=3{x}^{5}+4{x}^{3}-10{x}^{2}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{5}+4{x}^{3}-10{x}^{2}) \\\\  & =5\\cdot 3{x}^{4}+3\\cdot 4{x}^{2}-2\\cdot 10x \\\\  & =15{x}^{4}+12{x}^{2}-20x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(15{x}^{4}+12{x}^{2}-20x) \\\\  & =15\\cdot 4{x}^{3}+2\\cdot 12x-20 \\\\  & =60{x}^{3}+24x-20.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e1d1f8-4b3b-5f18-a100-a8ccb58c59dd" :answer/type {:db/ident :answer.type/math} :answer/value "6-\\frac{8}{{x}^{3}}" :db/id #edb/ref 17592186315780}] :answer-field/correct {:answer/id #uuid "74e1d1f8-4b3b-5f18-a100-a8ccb58c59dd" :answer/type {:db/ident :answer.type/math} :answer/value "6-\\frac{8}{{x}^{3}}" :db/id #edb/ref 17592186315780} :answer-field/id #uuid "c6b14006-56d1-58f0-b9f3-8c1de5bea365" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317022}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd8f94da-36ef-5137-94da-7eeaf5cded56" :question/math-academy-id "q-342877" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{6{x}^{3}+2{x}^{2}-8}{2x}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{3}+2{x}^{2}-8}{2x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+x-4{x}^{-1}) \\\\  & =6x+1+(-1)(-4{x}^{-2}) \\\\  & =6x+1+4{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(6x+1+4{x}^{-2}) \\\\  & =6+0+(-2)(4{x}^{-3}) \\\\  & =6-\\frac{8}{{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247}] :answer-field/correct {:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247} :answer-field/id #uuid "4ead05b7-6e52-5257-883b-117555657e43" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316729}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b404face-8b9a-5dc3-b331-958133c51335" :question/math-academy-id "q-342966" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=6\\sqrt{x}+5\\operatorname{cos}⁡x.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5\\operatorname{cos}⁡x) \\\\  & =(\\frac{1}{2})\\cdot 6{x}^{-1/2}+5(-\\operatorname{sin}⁡x) \\\\  & =3{x}^{-1/2}-5\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1/2}-5\\operatorname{sin}⁡x) \\\\  & =(-\\frac{1}{2})\\cdot 3{x}^{-3/2}-5\\operatorname{cos}⁡x \\\\  & =-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c013f9b-32c6-561a-8bb7-5ffbeeb02352" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{3}-3\\operatorname{sin}x" :db/id #edb/ref 17592186315804}] :answer-field/correct {:answer/id #uuid "7c013f9b-32c6-561a-8bb7-5ffbeeb02352" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{3}-3\\operatorname{sin}x" :db/id #edb/ref 17592186315804} :answer-field/id #uuid "6ab75fc2-e886-5595-bce3-c49cad6edb6a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316806}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4bacdaf5-3165-55be-a1a2-4605e9c99c4f" :question/math-academy-id "q-342970" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y={x}^{5}+3\\operatorname{sin}⁡x-\\frac{1}{{x}^{2}}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}\n$-\\,\\frac{6}{{x}^{4}}$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+3\\operatorname{sin}⁡x-\\frac{1}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+3\\operatorname{sin}⁡x-{x}^{-2}) \\\\  & =5{x}^{4}+3\\operatorname{cos}⁡x-(-2){x}^{-3} \\\\  & =5{x}^{4}+3\\operatorname{cos}⁡x+2{x}^{-3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+3\\operatorname{cos}⁡x+2{x}^{-3}) \\\\  & =4\\cdot 5{x}^{3}+3(-\\operatorname{sin}⁡x)+(-3)\\cdot 2{x}^{-4} \\\\  & =20{x}^{3}-3\\operatorname{sin}⁡x-\\frac{6}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62a7c57a-402a-5316-967c-d531e59f7eb2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484411}] :answer-field/correct {:answer/id #uuid "62a7c57a-402a-5316-967c-d531e59f7eb2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484411} :answer-field/id #uuid "2bafd2c9-bbbc-52ec-862f-3ce38d24c0e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484408}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "37315e0b-7879-5b79-8d31-f3ffb31ff99f" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=3\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right).$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\left(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}\\right)) \\\\  & =3\\left(8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2}\\right) \\\\  & =3\\left(2{x}^{7}+1+2{x}^{-3/2}\\right).\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3\\left(2{x}^{7}+1+2{x}^{-3/2}\\right)) \\\\  & =3\\left(7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2}\\right) \\\\  & =3\\left(14{x}^{6}-3{x}^{-5/2}\\right) \\\\  & =3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70cd9538-668f-54c8-9da5-97936e550794" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484413}] :answer-field/correct {:answer/id #uuid "70cd9538-668f-54c8-9da5-97936e550794" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484413} :answer-field/id #uuid "ef1ec59e-24d2-5255-b6f4-548ca07eb97e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484416}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "690274a2-8a45-50eb-9fc2-1e4aa16bd1d2" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=2\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right).$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2\\left(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}\\right)) \\\\  & =2\\left(8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2}\\right) \\\\  & =2\\left(2{x}^{7}+1+2{x}^{-3/2}\\right).\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(2\\left(2{x}^{7}+1+2{x}^{-3/2}\\right)) \\\\  & =2\\left(7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2}\\right) \\\\  & =2\\left(14{x}^{6}-3{x}^{-5/2}\\right) \\\\  & =2\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484415 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ae87d93-a20b-5f09-9770-bcb0613bac77" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484410}] :answer-field/correct {:answer/id #uuid "4ae87d93-a20b-5f09-9770-bcb0613bac77" :answer/type {:db/ident :answer.type/math} :answer/value "4\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484410} :answer-field/id #uuid "70de6406-7b4b-586b-a0ad-0e0af36610de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484414}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ddbcf5e6-626a-58ec-bb4c-7099d5a9a9bf" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=4\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right).$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4\\left(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}\\right)) \\\\  & =4\\left(8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2}\\right) \\\\  & =4\\left(2{x}^{7}+1+2{x}^{-3/2}\\right).\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(4\\left(2{x}^{7}+1+2{x}^{-3/2}\\right)) \\\\  & =4\\left(7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2}\\right) \\\\  & =4\\left(14{x}^{6}-3{x}^{-5/2}\\right) \\\\  & =4\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right).\\end{aligned}\n$$"}] :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] [{:db/id #edb/ref 17592186059679 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059507 :question/id #uuid "627f1ef4-64a8-5764-89c7-cb4e31009dbe" :question/math-academy-id "e-3655" :question/problem "Given $y = \\dfrac {3 x^2 + x - 1} x$, find $\\dfrac {\\textrm d^{3} y} {\\textrm d x^3}.$" :question/worked-solution "First, notice that we can rewrite the function as the sum of powers of $x,$ as follows:\n\n$$\n\\begin{aligned}y & =\\frac{3{x}^{2}+x-1}{x} \\\\  & =\\frac{3{x}^{2}}{x}+\\frac{x}{x}-\\frac{1}{x} \\\\  & =3x+1-{x}^{-1}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x+1-{x}^{-1}) \\\\  & =3+0-(-1){x}^{-2} \\\\  & =3+{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3+{x}^{-2}) \\\\  & =0+(-2){x}^{-3} \\\\  & =-2{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-3}) \\\\  & =-2(-3){x}^{-4} \\\\  & =6{x}^{-4}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "322168bb-52e3-5352-a2e3-c5bdbf2bc13e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048749 :topic/math-academy-id 1114 :topic/title "Differentiating Exponential Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3568e348-7ce3-53e7-8502-cac9028cdcdc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{{x}^{3}}" :db/id #edb/ref 17592186295567} {:answer/id #uuid "8c14d153-4524-58cf-8b2c-d20c26c1fc75" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{18}{{x}^{4}}" :db/id #edb/ref 17592186296013} {:answer/id #uuid "b633fca1-f64b-5667-ba0f-050384a46b55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{{x}^{3}}" :db/id #edb/ref 17592186296223} {:answer/id #uuid "bd2f4910-15e2-593d-bdf1-94c31115bfa0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{{x}^{4}}+6" :db/id #edb/ref 17592186296264} {:answer/id #uuid "f87b7ebd-557f-5734-921e-d68efbecb1fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{{x}^{4}}" :db/id #edb/ref 17592186296587}] :answer-field/correct {:answer/id #uuid "8c14d153-4524-58cf-8b2c-d20c26c1fc75" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{18}{{x}^{4}}" :db/id #edb/ref 17592186296013} :answer-field/id #uuid "af764e84-7a43-583f-ac16-eeaab9e351d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297002}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b83e7d12-8550-5720-b6a4-35cd583e538f" :question/math-academy-id "q-28546" :question/problem "Given $h(x)=3{x}^{2}-5x+\\frac{3}{x},$ find ${h}^{‴}(x).$" :question/worked-solution "First, notice that we can rewrite the function as follows:\n\n$$\n\\begin{aligned}h(x) & =3{x}^{2}-5x+\\frac{3}{x} \\\\  & =3{x}^{2}-5x+3{x}^{-1}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-5x+3{x}^{-1}) \\\\  & =6x-5-3{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{h}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(6x-5-3{x}^{-2}) \\\\  & =6+6{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{h}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(6+6{x}^{-3}) \\\\  & =-18{x}^{-4} \\\\  & =-\\frac{18}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186060262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d46c5b0-6bb4-5847-9aaa-1336df514c00" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2} + \\frac{24}{x^{4}}" :db/id #edb/ref 17592186058195} {:answer/id #uuid "36d1d57f-0468-5d34-bb79-4e5a15d95a81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x}{2} - \\frac{24}{x^{4}}" :db/id #edb/ref 17592186058196} {:answer/id #uuid "39e46328-6486-5423-8481-1e92b7837027" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x}{2} + \\frac{24}{x^{5}}" :db/id #edb/ref 17592186058197} {:answer/id #uuid "6bed310b-243c-5842-893b-cd8d99d24ae7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2} - \\frac{96}{x^{5}}" :db/id #edb/ref 17592186058198} {:answer/id #uuid "71902624-2d7f-5ff6-92f7-41fa13e75200" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2} + \\frac{96}{x^{5}}" :db/id #edb/ref 17592186058199}] :answer-field/id #uuid "80343e98-0d12-5d8b-a499-ccac8eb65f02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058194}] :question/id #uuid "7111eb8a-8d63-5fe7-944e-af6d1e8c6fb5" :question/math-academy-id "q-28550" :question/problem "Given $y = \\frac{x^{3}}{4} - \\frac{4}{x^{2}}$, find $\\frac{d^{3}y}{dx^{3}}$."} {:db/id #edb/ref 17592186233740 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4a76738-7009-51e8-8695-330c64de49ff" :question/math-academy-id "q-28551" :question/problem "Given $y=7{x}^{2}-1+\\frac{1}{2x}$, find $\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}.$" :question/worked-solution "First, notice that we can rewrite the function as follows:\n\n$$\n\\begin{aligned}h(x) & =7{x}^{2}-1+\\frac{1}{2x} \\\\  & =7{x}^{2}-1+\\frac{{x}^{-1}}{2}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(7{x}^{2}-1+\\frac{{x}^{-1}}{2}) \\\\  & =7(2)x-0+\\frac{(-1){x}^{-2}}{2} \\\\  & =14x-\\frac{{x}^{-2}}{2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(14x-\\frac{{x}^{-2}}{2}) \\\\  & =14-\\frac{(-2){x}^{-3}}{2} \\\\  & =14+{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}} & =\\frac{\\text{d}}{\\text{d}x}(14+{x}^{-3}) \\\\  & =0+(-3){x}^{-4} \\\\  & =-\\frac{3}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ac8e23b-d558-5977-8e3b-8cb7528e6904" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{{x}^{4}}" :db/id #edb/ref 17592186232536}] :answer-field/correct {:answer/id #uuid "6ac8e23b-d558-5977-8e3b-8cb7528e6904" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{{x}^{4}}" :db/id #edb/ref 17592186232536} :answer-field/id #uuid "e9233847-64a2-5832-bf70-e89847d7d076" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232535}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2d972297-90ba-5f62-8dae-f2bd9cfdb28a" :question/math-academy-id "q-310170" :question/problem "Given $g(x)=4{x}^{2}+6x-\\frac{2}{x},$ we have\n\n${g}^{‴}(x)=$\n{{field-1}}" :question/worked-solution "First, notice that we can rewrite the function as follows:\n\n$$\n\\begin{aligned}g(x) & =4{x}^{2}+6x-\\frac{2}{x} \\\\  & =4{x}^{2}+6x-2{x}^{-1}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{2}+6x-2{x}^{-1}) \\\\  & =8x+6+2{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{g}^{''}(x) & =\\frac{\\text{d}}{\\text{d}x}(8x+6+2{x}^{-2}) \\\\  & =8-4{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{g}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(8-4{x}^{-3}) \\\\  & =12{x}^{-4} \\\\  & =\\frac{12}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055ab99f-f5e5-5862-922f-e80586d6bce2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{{x}^{3}}-60x" :db/id #edb/ref 17592186238125} {:answer/id #uuid "31ab4dc4-f8f6-563e-addf-187d4e82001a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{x}^{2}}-60x" :db/id #edb/ref 17592186238488} {:answer/id #uuid "637ebda4-74e8-5447-916e-716524da34c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{{x}^{3}}+\\frac{15}{\\sqrt{x}}" :db/id #edb/ref 17592186238928} {:answer/id #uuid "7c4b5e31-c1d2-5fd3-b885-22c78555f74d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}-\\frac{1}{\\sqrt{x}}" :db/id #edb/ref 17592186239130} {:answer/id #uuid "ad353eb8-47c0-5897-baf8-2af62962fe4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{x}^{3}}-\\frac{15}{\\sqrt{x}}" :db/id #edb/ref 17592186239558}] :answer-field/correct {:answer/id #uuid "ad353eb8-47c0-5897-baf8-2af62962fe4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{x}^{3}}-\\frac{15}{\\sqrt{x}}" :db/id #edb/ref 17592186239558} :answer-field/id #uuid "05e47e8d-cfec-57b7-884d-14e03e730d35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240333}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dbc15ca0-e95e-5ce8-90b9-fc14fcd67fee" :question/math-academy-id "q-104294" :question/problem "Given $f(x)=2\\operatorname{ln}⁡x-8\\sqrt{{x}^{5}},$ find ${f}^{‴}(x).$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x-8\\sqrt{{x}^{5}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x-8{x}^{5/2}) \\\\  & =\\frac{2}{x}-20{x}^{3/2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{f}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}-20{x}^{3/2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1}-20{x}^{3/2}) \\\\  & =-2{x}^{-2}-30{x}^{1/2}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{f}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-2}-30{x}^{1/2}) \\\\  & =4{x}^{-3}-15{x}^{-1/2} \\\\  & =\\frac{4}{{x}^{3}}-\\frac{15}{\\sqrt{x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79239b6d-f719-5c75-9053-bf2a10d2c4df" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}x-\\frac{6}{{x}^{4}}" :db/id #edb/ref 17592186295928}] :answer-field/correct {:answer/id #uuid "79239b6d-f719-5c75-9053-bf2a10d2c4df" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}x-\\frac{6}{{x}^{4}}" :db/id #edb/ref 17592186295928} :answer-field/id #uuid "49d81211-9ca6-5ed2-a5dc-1f113f908f71" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296772}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ca192f94-8d93-544f-8a75-568decc353d8" :question/math-academy-id "q-310171" :question/problem "Find ${g}^{(4)}(x)$ for $g(x)=\\operatorname{cos}⁡x+\\operatorname{ln}⁡x.$\n\n${g}^{(4)}(x)=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x+\\operatorname{ln}⁡x) \\\\  & =-\\operatorname{sin}⁡x+\\frac{1}{x}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{sin}⁡x+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{sin}⁡x+{x}^{-1}) \\\\  & =-\\operatorname{cos}⁡x-{x}^{-2}.\\end{aligned}\n$$\n\nComputing the third derivative, we get\n\n$$\n\\begin{aligned}{g}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{cos}⁡x-{x}^{-2}) \\\\  & =\\operatorname{sin}⁡x+2{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the fourth derivative, we get\n\n$$\n\\begin{aligned}{g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x+2{x}^{-3}) \\\\  & =\\operatorname{cos}⁡x-6{x}^{-4} \\\\  & =\\operatorname{cos}⁡x-\\frac{6}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d84336-4879-5a04-9adc-98a7579fa0b4" :answer/type {:db/ident :answer.type/math} :answer/value "120{x}^{2}-18" :db/id #edb/ref 17592186315395}] :answer-field/correct {:answer/id #uuid "30d84336-4879-5a04-9adc-98a7579fa0b4" :answer/type {:db/ident :answer.type/math} :answer/value "120{x}^{2}-18" :db/id #edb/ref 17592186315395} :answer-field/id #uuid "ea2bc0a5-15fb-5d3d-b502-46126dca1e8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317102}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f082c550-bc0d-5284-a89a-ca202b931026" :question/math-academy-id "q-343075" :question/problem "Given $g(x)=2{x}^{5}-3{x}^{3},$ we have\n\n${g}^{‴}(x)=$ \n{{field-1}}." :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{5}-3{x}^{3}) \\\\  & =10{x}^{4}-9{x}^{2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(10{x}^{4}-9{x}^{2}) \\\\  & =40{x}^{3}-18x.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{g}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(40{x}^{3}-18x) \\\\  & =120{x}^{2}-18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb9ba391-ec76-500e-a4b3-f13c4c8a9fdc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}-\\frac{3}{2{x}^{4}}" :db/id #edb/ref 17592186316270}] :answer-field/correct {:answer/id #uuid "cb9ba391-ec76-500e-a4b3-f13c4c8a9fdc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}-\\frac{3}{2{x}^{4}}" :db/id #edb/ref 17592186316270} :answer-field/id #uuid "e8a8d81e-5ba1-5d3c-ab8d-a75ade40ffc6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317099}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6406b0de-85c2-57d8-ad6d-cd0fcf72814c" :question/math-academy-id "q-343086" :question/problem "Given $f(x)=\\frac{{x}^{5}-{x}^{2}+x}{4{x}^{2}},$ we have\n\n${f}^{‴}(x)=$ \n{{field-1}}." :question/worked-solution "First, notice that we can rewrite the function as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{5}-{x}^{2}+x}{4{x}^{2}} \\\\  & =\\frac{{x}^{3}}{4}-\\frac{1}{4}+\\frac{1}{4x}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{4}-\\frac{1}{4}+\\frac{1}{4x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{4}-\\frac{1}{4}+\\frac{1}{4}{x}^{-1}) \\\\  & =\\frac{3{x}^{2}}{4}-\\frac{1}{4}{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{f}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{2}}{4}-\\frac{1}{4}{x}^{-2}) \\\\  & =\\frac{3x}{2}+\\frac{1}{2}{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{f}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3x}{2}+\\frac{1}{2}{x}^{-3}) \\\\  & =\\frac{3}{2}-\\frac{3}{2}{x}^{-4} \\\\  & =\\frac{3}{2}-\\frac{3}{2{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e280261-9531-503b-b9c9-1565463ee291" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{x}+\\frac{8}{{x}^{5}}" :db/id #edb/ref 17592186316003}] :answer-field/correct {:answer/id #uuid "9e280261-9531-503b-b9c9-1565463ee291" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{x}+\\frac{8}{{x}^{5}}" :db/id #edb/ref 17592186316003} :answer-field/id #uuid "5806fc65-8fca-534c-b69b-882c7849b116" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316749}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "340cc804-6eed-5bf6-9664-2ced31609b52" :question/math-academy-id "q-343089" :question/problem "Given $f(x)=3{e}^{x}-\\frac{1}{3{x}^{2}},$ we have\n\n${f}^{‴}(x)=$ \n{{field-1}}." :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x}-\\frac{1}{3{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x}-\\frac{1}{3}{x}^{-2}) \\\\  & =3{e}^{x}+\\frac{2}{3}{x}^{-3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{f}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x}+\\frac{2}{3}{x}^{-3}) \\\\  & =3{e}^{x}-2{x}^{-4}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{f}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x}-2{x}^{-4}) \\\\  & =3{e}^{x}+8{x}^{-5} \\\\  & =3{e}^{x}+\\frac{8}{{x}^{5}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317358 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5428d3b8-416b-5016-b040-c26d30f3c6cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{x}^{3}}+24x" :db/id #edb/ref 17592186315602}] :answer-field/correct {:answer/id #uuid "5428d3b8-416b-5016-b040-c26d30f3c6cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{x}^{3}}+24x" :db/id #edb/ref 17592186315602} :answer-field/id #uuid "87ae11e1-6a52-5f24-8369-ef0b8fd88cfe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316859}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d9d7023a-3aa5-56f6-a910-25e31e021f84" :question/math-academy-id "q-343114" :question/problem "Given $f(x)=2ln⁡x+{x}^{4},$ we have\n\n${f}^{‴}(x)=$ \n{{field-1}}." :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2ln⁡x+{x}^{4}) \\\\  & =\\frac{2}{x}+4{x}^{3} \\\\  & =2{x}^{-1}+4{x}^{3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{f}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1}+4{x}^{3}) \\\\  & =-2{x}^{-2}+12{x}^{2}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{f}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-2}+12{x}^{2}) \\\\  & =4{x}^{-3}+24x \\\\  & =\\frac{4}{{x}^{3}}+24x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91b28808-f3e6-522f-ab26-3b5cc17a7486" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}x-{e}^{x}" :db/id #edb/ref 17592186315932}] :answer-field/correct {:answer/id #uuid "91b28808-f3e6-522f-ab26-3b5cc17a7486" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}x-{e}^{x}" :db/id #edb/ref 17592186315932} :answer-field/id #uuid "6bc35772-0b39-5222-9015-f8ac868e25d2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316810}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9f16160f-2d16-509d-a78c-972837e58147" :question/math-academy-id "q-343120" :question/problem "Find ${g}^{(4)}(x)$ for $g(x)=sin⁡x-{e}^{x}.$\n\n${g}^{(4)}(x)=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(sin⁡x-{e}^{x}) \\\\  & =cos⁡x-{e}^{x}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(cos⁡x-{e}^{x}) \\\\  & =-sin⁡x-{e}^{x}.\\end{aligned}\n$$\n\nComputing the third derivative, we get\n\n$$\n\\begin{aligned}{g}^{‴}(x) & =\\frac{\\text{d}}{\\text{d}x}(-sin⁡x-{e}^{x}) \\\\  & =-cos⁡x-{e}^{x}.\\end{aligned}\n$$\n\nFinally, computing the fourth derivative, we get\n\n$$\n\\begin{aligned}{g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-cos⁡x-{e}^{x}) \\\\  & =sin⁡x-{e}^{x}.\\end{aligned}\n$$"}] :knowledge-point/title "Computing Higher Order Derivatives"}] [{:db/id #edb/ref 17592186105716 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105574 :question/id #uuid "9c57c69e-efa2-5e82-992c-53570e61af09" :question/math-academy-id "e-375" :question/problem "Find the integral of $\\dfrac 1 {2x} + 3x$ with respect to $x.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2x}+3x)\\,\\text{d}x & =\\int \\frac{1}{2x}\\,\\text{d}x+\\int 3x\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x+3\\int x\\,\\text{d}x \\\\  & =\\frac{1}{2}ln⁡|x|+3\\cdot \\frac{{x}^{1+1}}{1+1}+C \\\\  & =\\frac{ln⁡|x|}{2}+\\frac{3{x}^{2}}{2}+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050321 :topic/math-academy-id 3769 :topic/title "The Sum Rule for Indefinite Integrals"}] :knowledge-point/questions [{:db/id #edb/ref 17592186106279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7df1bf0-48a3-5a59-9307-1ad8298d702a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x + \\frac{7x^{2}}{2} + C" :db/id #edb/ref 17592186103823} {:answer/id #uuid "cbffbc55-a113-51f2-99fe-e84514f317cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\ln \\mid x \\mid + \\frac{3x^{2}}{2} + C" :db/id #edb/ref 17592186103824} {:answer/id #uuid "3dfc8f1b-9538-55b0-a5fc-fc7646612347" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}\\ln \\mid x \\mid + \\frac{5x^{2}}{2} + C" :db/id #edb/ref 17592186103825} {:answer/id #uuid "639c4e77-f7ca-5b86-a4b0-e2cb702dbd50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\ln \\mid x \\mid + \\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186103826} {:answer/id #uuid "7fb0e4e4-3bfd-5f96-90ff-9c3394cb8e44" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\ln x + \\frac{5x^{2}}{2} + C" :db/id #edb/ref 17592186103827}] :answer-field/id #uuid "5e7eec42-1e1f-56d9-bbb4-434ba50d5374" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103822}] :question/id #uuid "aeae1bba-21da-5f3e-a689-91fa6fd271af" :question/math-academy-id "q-29836" :question/problem "Find the integral of $\\frac{3}{5x} + 3x$ with respect to $x$."} {:db/id #edb/ref 17592186106280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8140037d-2d2c-5542-a0ba-9edf6b7bbf28" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln \\mid x \\mid - \\frac{2}{x} + C" :db/id #edb/ref 17592186103829} {:answer/id #uuid "0405b19e-98fb-5a56-97e4-d2d44340c6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x \\mid - x^{1/2} + C" :db/id #edb/ref 17592186103830} {:answer/id #uuid "14506e14-75d8-5464-ba2e-4e8d416dcb89" :answer/type {:db/ident :answer.type/math} :answer/value "x - 2x^{1/2} + C" :db/id #edb/ref 17592186103831} {:answer/id #uuid "3737381e-42d1-5ec5-a0be-6e2c2c114442" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln \\mid x \\mid - 2x^{1/2} + C" :db/id #edb/ref 17592186103832} {:answer/id #uuid "72930a31-c1dd-529c-95f0-0c9ed79b8c26" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x \\mid + 2x^{1/2} + C" :db/id #edb/ref 17592186103833}] :answer-field/id #uuid "f13e7011-de56-51ec-9c85-6d23ec9e1c7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103828}] :question/id #uuid "60e355f2-c5a8-565b-92ee-4e1844ef9c98" :question/math-academy-id "q-29857" :question/problem "Find the integral of $\\frac{2}{x} - \\frac{1}{\\sqrt{x}}$ with respect to $x$."} {:db/id #edb/ref 17592186238001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116ed1cb-cee2-51fa-b983-0d044a80cbf1" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+ln⁡|3x|+C" :db/id #edb/ref 17592186235911} {:answer/id #uuid "335087d8-fab5-5522-94d1-93d0d9655755" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}-ln⁡|3x|+C" :db/id #edb/ref 17592186236140} {:answer/id #uuid "a77100c8-1980-51d5-9cdf-fe3f251c5336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{x}^{2}-3ln⁡|x|+C" :db/id #edb/ref 17592186236865} {:answer/id #uuid "b3489f8b-789f-5fa4-bb29-debd57283e3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{x}^{2}-ln⁡|3x|+C" :db/id #edb/ref 17592186236952} {:answer/id #uuid "e22f3892-01f6-5e59-8632-9444a5c795ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186237233}] :answer-field/correct {:answer/id #uuid "a77100c8-1980-51d5-9cdf-fe3f251c5336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{x}^{2}-3ln⁡|x|+C" :db/id #edb/ref 17592186236865} :answer-field/id #uuid "82b1ee9b-e334-5197-b749-02b7be8b5397" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237614}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d804d2ab-c752-5a11-a731-3f70b2a95171" :question/math-academy-id "q-103374" :question/problem "Calculate $\\int \\frac{3{x}^{2}-6}{2x}\\,dx.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-6}{2x}\\,\\text{d}x & =\\int (\\frac{3{x}^{2}}{2x}-\\frac{3}{x})\\text{d}x \\\\  & =\\int (\\frac{3}{2}x-\\frac{3}{x})\\text{d}x \\\\  & =\\frac{3}{2}\\int x\\,\\text{d}x-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{4}{x}^{2}-3ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4abe304b-eb2b-5d95-b662-98795ce766a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{3/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236297} {:answer/id #uuid "6d00a003-0364-5b3a-b73d-cf2606acaf82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{5/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236506} {:answer/id #uuid "b7b12b3f-b8dd-53cd-a79b-4f8d64e6c135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236984} {:answer/id #uuid "c71fc3c7-fa6d-5f20-8988-65604e335a7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{3/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186237078} {:answer/id #uuid "ca4ffb28-67bb-5e22-a3dc-17c627b249f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{5/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186237101}] :answer-field/correct {:answer/id #uuid "b7b12b3f-b8dd-53cd-a79b-4f8d64e6c135" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236984} :answer-field/id #uuid "67ce5cc2-6611-553c-af07-6c3510863b9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237573}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1a6388af-23c9-54c5-98cc-a8fb2fcf5235" :question/math-academy-id "q-103593" :question/problem "Calculate $\\int ({x}^{3/2}+\\frac{1}{2}{x}^{-1})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{3/2}+\\frac{1}{2}{x}^{-1})\\,\\text{d}x=\\int {x}^{3/2}\\,\\text{d}x+\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{3/2}\\,\\text{d}x+\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{3/2+1}}{\\frac{3}{2}+1}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297251 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a44ce-4517-57c9-8784-5136e6d9c6af" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{11/3}+\\sqrt{5}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295500} {:answer/id #uuid "2e55410d-693f-527e-b63c-efdd8027016a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{4/3}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295534} {:answer/id #uuid "91074ff5-3842-537b-b69c-20abfee3093d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡x}{5}{x}^{5/3}+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296046} {:answer/id #uuid "ae484638-462d-55ee-b006-7e7f7e36be1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{5}{x}^{7/3}+\\sqrt{3}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296183} {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395}] :answer-field/correct {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395} :answer-field/id #uuid "d4ea97da-7b64-5d03-a1a8-9448f2925fe1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297075}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a9a35970-b3a0-5bae-b863-30b3731d8d68" :question/math-academy-id "q-29885" :question/problem "Calculate $\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x=\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{2/3+1}}{\\frac{2}{3}+1}+\\sqrt{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00628492-eb93-5878-979e-30036d304edf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186295270} {:answer/id #uuid "0e5a70b3-ab83-532b-aa08-1862b689d752" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{7/3}-3ln⁡|x|+C" :db/id #edb/ref 17592186295352} {:answer/id #uuid "37558070-eb2f-5f46-8242-8655de914964" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}{x}^{2/3}-ln⁡|x|+C" :db/id #edb/ref 17592186295579} {:answer/id #uuid "b8f41b7f-152b-52ff-9cf7-213f37faf4c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}{x}^{1/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186296236} {:answer/id #uuid "d19e531c-0ef6-56ff-a397-6ea185e85664" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{7/3}-3ln⁡|x|+C" :db/id #edb/ref 17592186296373}] :answer-field/correct {:answer/id #uuid "00628492-eb93-5878-979e-30036d304edf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C" :db/id #edb/ref 17592186295270} :answer-field/id #uuid "52c825a2-113a-5331-8971-e3d904594718" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296801}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8c693357-ab6d-5b31-ab83-a3f2da57f6b4" :question/math-academy-id "q-29886" :question/problem "Find the integral of $2{x}^{7/3}-\\frac{1}{3x}$ with respect to $x.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (2{x}^{7/3}-\\frac{1}{3x})\\text{d}x & =\\int 2{x}^{7/3}\\,\\text{d}x-\\frac{1}{3}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{7/3+1}}{(\\frac{7}{3}+1)}-\\frac{1}{3}ln⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{10/3}-\\frac{1}{3}ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "176c0cc3-ba47-5a28-bd33-bd9278429e85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186295407} {:answer/id #uuid "2f103c39-3c15-50c6-8f4f-b6fcedebd3da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}{x}^{2}+5ln⁡|x|+C" :db/id #edb/ref 17592186295537} {:answer/id #uuid "58a0d4bf-d3f2-5150-8b06-787b98cd79e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186295780} {:answer/id #uuid "73445bd7-7a1a-5461-a8e3-361ce1af59fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}{x}^{2}+2ln⁡|x|+C" :db/id #edb/ref 17592186295898} {:answer/id #uuid "970ce0c0-c57d-5784-8a2c-ff97639ff009" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{2}+4ln⁡|x|+C" :db/id #edb/ref 17592186296073}] :answer-field/correct {:answer/id #uuid "176c0cc3-ba47-5a28-bd33-bd9278429e85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{2}+3ln⁡|x|+C" :db/id #edb/ref 17592186295407} :answer-field/id #uuid "abead380-5729-56aa-a799-0bc9297616ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296997}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a09c1ef5-54ac-5fb8-be82-1b666b5326c2" :question/math-academy-id "q-29888" :question/problem "Find the integral of $\\frac{3}{{x}^{-1}}+3{x}^{-1}$ with respect to $x.$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{3}{{x}^{-1}}+3{x}^{-1})\\text{d}x & =3\\int x\\,\\text{d}x+3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{2}{x}^{2}+3ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abba1e8-07a5-5982-8931-920e2b54ed11" :answer/type {:db/ident :answer.type/math} :answer/value "-5ln⁡|x|+C" :db/id #edb/ref 17592186295324} {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} {:answer/id #uuid "218a6eff-a0a2-5775-878d-fb334d854a63" :answer/type {:db/ident :answer.type/math} :answer/value "4ln⁡|x|+C" :db/id #edb/ref 17592186295454} {:answer/id #uuid "5203ee4a-c762-565e-a1e7-1c414c5d786d" :answer/type {:db/ident :answer.type/math} :answer/value "-6x+C" :db/id #edb/ref 17592186295738} {:answer/id #uuid "e96a5e23-083b-5d3f-bddc-50fd9a0aed8b" :answer/type {:db/ident :answer.type/math} :answer/value "5x+C" :db/id #edb/ref 17592186296509}] :answer-field/correct {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} :answer-field/id #uuid "65380cf5-c8c6-595a-9584-e99d721414af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296843}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "77e80b12-44f5-5ee6-b586-d6d7898a0c32" :question/math-academy-id "q-29915" :question/problem "Find the integral of $\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1}$ with respect to $x.$" :question/worked-solution "Simplifying the exponents and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1})\\text{d}x & =\\int \\frac{1}{{x}^{5/2-3/2}}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{x}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25ea8d40-84bf-534f-8e8c-6302589f6d1d" :answer/type {:db/ident :answer.type/math} :answer/value "2xln⁡|x|+C" :db/id #edb/ref 17592186330280} {:answer/id #uuid "3a4ddb04-2a0f-541d-8c66-b81a1140bf9f" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡|2-\\frac{1}{x}|+C" :db/id #edb/ref 17592186330472} {:answer/id #uuid "9ecd5285-27bd-58a2-ae63-f8d42089b197" :answer/type {:db/ident :answer.type/math} :answer/value "2x-ln⁡|x|+C" :db/id #edb/ref 17592186331373} {:answer/id #uuid "ebfcaae4-3cd8-5b37-ad78-afba74998213" :answer/type {:db/ident :answer.type/math} :answer/value "4x-4ln⁡|x|-\\frac{1}{x}+C" :db/id #edb/ref 17592186332021} {:answer/id #uuid "f6fa8737-41d4-5415-b503-7159707db2c3" :answer/type {:db/ident :answer.type/math} :answer/value "{(2x-ln⁡|x|)}^{2}+C" :db/id #edb/ref 17592186332118}] :answer-field/correct {:answer/id #uuid "ebfcaae4-3cd8-5b37-ad78-afba74998213" :answer/type {:db/ident :answer.type/math} :answer/value "4x-4ln⁡|x|-\\frac{1}{x}+C" :db/id #edb/ref 17592186332021} :answer-field/id #uuid "0a2c34fc-7951-5002-8305-c48283de9967" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332210}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3c37bd55-c0e8-559f-80d9-e5fdbb837ece" :question/math-academy-id "q-49100" :question/problem "Find the integral of ${(2-\\frac{1}{x})}^{2}$ with respect to $x.$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(2-\\frac{1}{x})}^{2}\\text{d}x & =\\int (4-\\frac{4}{x}+\\frac{1}{{x}^{2}})\\text{d}x \\\\  & =\\int 4\\,\\text{d}x-\\int \\frac{4}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4\\int \\text{d}x-4\\int \\frac{1}{x}\\,\\text{d}x+\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =4x-4ln⁡|x|+\\frac{{x}^{-2+1}}{-2+1}+C \\\\  & =4x-4ln⁡|x|-\\frac{1}{x}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}]}
