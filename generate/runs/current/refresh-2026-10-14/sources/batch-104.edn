 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true. As a result, $D={C}^{-1}$ and statement III is true too.\n\n- Now, we check whether $CE=EC={I}_{3}.$ Computing $CE$, we get\n\n$$\n\\begin{aligned}CE & =\\begin{bmatrix}2 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}0 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}∗ & 3 & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false.\n\nTherefore, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186339007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f54242e1-7020-5a41-a926-bafc9fc2bfaa" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451555} {:answer/id #uuid "eceddc36-fb4c-5de8-9c2a-5188fd8d48c5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451556}] :answer-field/correct {:answer/id #uuid "f54242e1-7020-5a41-a926-bafc9fc2bfaa" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451555} :answer-field/id #uuid "98305e3a-4f27-53e0-84d9-532aec2ca50f" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452625} {:answer-field/choices [{:answer/id #uuid "2d6c11d0-5258-5ba0-b8a8-e720776f47d5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451557} {:answer/id #uuid "78d7a896-e269-5cf6-93a0-89a34b5ea079" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451558}] :answer-field/correct {:answer/id #uuid "78d7a896-e269-5cf6-93a0-89a34b5ea079" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451558} :answer-field/id #uuid "c0048543-e370-52ca-874a-c6b05513a8f2" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.