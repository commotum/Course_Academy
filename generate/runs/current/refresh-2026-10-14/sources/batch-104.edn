frac{3}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057135} {:answer/id #uuid "29a80b65-88dd-51a4-baa0-c738950c1264" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{73}} \\\\ \\frac{8}{\\sqrt{73}}\\end{bmatrix}" :db/id #edb/ref 17592186057136} {:answer/id #uuid "401e5f5b-5db4-522a-9b7a-11b15f373032" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{\\sqrt{76}} \\\\ \\frac{8}{\\sqrt{76}}\\end{bmatrix}" :db/id #edb/ref 17592186057137}] :answer-field/id #uuid "f8820177-fcee-5d33-9928-79e84e800cd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057132}] :question/id #uuid "bfe76e58-e39f-55e9-9d8c-8f6cb0fc0443" :question/math-academy-id "q-18058" :question/problem "Let $a = \\begin{bmatrix}3 \\\\ 8\\end{bmatrix}$. Find a unit vector that is parallel to $a$ and points the same direction."} {:db/id #edb/ref 17592186233367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0602d7a4-2911-50a7-8931-1b4bc528c19a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{5} \\\\ -\\frac{3}{10}\\end{bmatrix}" :db/id #edb/ref 17592186411685} {:answer/id #uuid "3c5b6bc3-0505-592d-8bbe-21764c037dd0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{\\sqrt{5}} \\\\ -\\frac{6}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186411711} {:answer/id #uuid "74dbb49a-6f69-59c5-ab9c-6bf2f84350df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186411739} {:answer/id #uuid "8c50ba8e-c157-5ca3-9288-576321916d2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{\\sqrt{10}} \\\\ -\\frac{6}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186411752} {:answer/id #uuid "dda19a54-ac15-5715-b0ab-0a3f1c4ff8ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{5} \\\\ -\\frac{3}{10}\\end{bmatrix}" :db/id #edb/ref 17592186411801}] :answer-field/correct {:answer/id #uuid "74dbb49a-6f69-59c5-ab9c-6bf2f84350df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}" :db/id #edb/ref 17592186411739} :answer-field/id #uuid "760bc6eb-d6bd-5bc8-a1ad-d57d71d59023" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411832}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eff15426-c7b2-53a2-8441-6bacd0c6dc45" :question/math-academy-id "q-125135" :question/problem "Let $b=\\begin{bmatrix}8 \\\\ -6\\end{bmatrix}.$ Find a unit vector that is parallel to $b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|\\,b\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,b\\,| & =\\sqrt{{8}^{2}+(-6)^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =\\sqrt{100} \\\\  & =10.\\end{aligned}\n$$\n\nFinally, we divide $b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{b}{|b|} \\\\  & =\\frac{1}{10}\\cdot b \\\\  & =\\frac{1}{10}\\cdot \\begin{bmatrix}8 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{4}{5} \\\\ -\\frac{3}{5}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233368 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "06094a0c-ab74-504d-9e7a-29ff1a469a1b" :question/math-academy-id "q-125138" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ 2\\end{bmatrix}$ and $b=\\begin{bmatrix}5 \\\\ 8\\end{bmatrix}.$ Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}2a+b & =2\\cdot \\begin{bmatrix}0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}5 \\\\ 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}0+5 \\\\ 4+8\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ 12\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|2a+b| & =\\sqrt{{5}^{2}+{12}^{2}} \\\\  & =\\sqrt{169} \\\\  & =13.\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{2a+b}{|2a+b|} \\\\  & =\\frac{1}{13}(2a+b) \\\\  & =\\frac{1}{13}\\cdot \\begin{bmatrix}5 \\\\ 12\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{13} \\\\ \\frac{12}{13}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234271 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "af9476c9-5aa2-526b-87d4-a82f7e7eeb39" :question/math-academy-id "q-70409" :question/problem "Let $n=\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}.$ Find a unit vector that is parallel to $n$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|\\,n\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|n| & =\\sqrt{{5}^{2}+{4}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nFinally, we divide $n$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{n}{|n|} \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot n \\\\  & =\\frac{1}{\\sqrt{41}}\\cdot \\begin{bmatrix}5 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{5}{\\sqrt{41}} \\\\ \\frac{4}{\\sqrt{41}}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501424 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20917d48-ba12-5d1f-b21a-0ff1206db43b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2 \\sqrt{85}}{85} \\\\ \\frac{9 \\sqrt{85}}{85}\\end{bmatrix}" :db/id #edb/ref 17592186501420} {:answer/id #uuid "4448f5e2-51c2-5573-af62-a5a77921a60f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2 \\sqrt{85}}{85} \\\\ \\frac{3 \\sqrt{85}}{85}\\end{bmatrix}" :db/id #edb/ref 17592186501426} {:answer/id #uuid "69c38540-0ec4-5bc4-9f17-e6d71b15d3c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186501431} {:answer/id #uuid "6d3a56cd-220c-5797-bf5d-1232e4735202" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2 \\sqrt{85}}{85} \\\\ - \\frac{9 \\sqrt{85}}{85}\\end{bmatrix}" :db/id #edb/ref 17592186501432} {:answer/id #uuid "bbfe8e76-81fa-5a5d-bd36-45854289df62" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{\\sqrt{85}}{85} \\\\ \\frac{9 \\sqrt{85}}{85}\\end{bmatrix}" :db/id #edb/ref 17592186501444}] :answer-field/correct {:answer/id #uuid "20917d48-ba12-5d1f-b21a-0ff1206db43b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2 \\sqrt{85}}{85} \\\\ \\frac{9 \\sqrt{85}}{85}\\end{bmatrix}" :db/id #edb/ref 17592186501420} :answer-field/id #uuid "ca99c9f4-3bb7-5fbd-9bf4-f8cd3f0a0232" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501447}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3fe77d7b-c249-5da3-ae37-3fb1cc69e4ca" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -2\\end{bmatrix}$ and $b=\\begin{bmatrix}2 \\\\ 13\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 13\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -4\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 13\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(2) \\\\ (-4)+(13)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2 \\\\ 9\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(2)^2+(9)^2} \\\\\n&= \\sqrt{85} \\\\\n&= \\sqrt{85}\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{\\sqrt{85}}\\cdot (2a+b) \\\\\n&= \\frac{1}{\\sqrt{85}}\\cdot \\begin{bmatrix}2 \\\\ 9\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{2 \\sqrt{85}}{85} \\\\ \\frac{9 \\sqrt{85}}{85}\\end{bmatrix}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501425 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36b5a9a2-dc90-5731-af84-a45f4751626a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{20}{29} \\\\ \\frac{21}{29}\\end{bmatrix}" :db/id #edb/ref 17592186501422} {:answer/id #uuid "5d3cacb0-979d-5cd5-8d2c-9ce9ba39d324" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{10}{29} \\\\ - \\frac{21}{29}\\end{bmatrix}" :db/id #edb/ref 17592186501429} {:answer/id #uuid "7d5bb797-4d29-566d-8a17-e90b3639c09b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}20 \\\\ -21\\end{bmatrix}" :db/id #edb/ref 17592186501434} {:answer/id #uuid "adcc82ff-26bb-5dc4-b727-5883ed507729" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{20}{29} \\\\ - \\frac{7}{29}\\end{bmatrix}" :db/id #edb/ref 17592186501440} {:answer/id #uuid "af4f327a-bbbc-5d9e-adf3-279321fc88a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{20}{29} \\\\ - \\frac{21}{29}\\end{bmatrix}" :db/id #edb/ref 17592186501442}] :answer-field/correct {:answer/id #uuid "af4f327a-bbbc-5d9e-adf3-279321fc88a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{20}{29} \\\\ - \\frac{21}{29}\\end{bmatrix}" :db/id #edb/ref 17592186501442} :answer-field/id #uuid "075f845c-a443-544d-908f-2d88965db5a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501416}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "41db4b75-2005-5439-8a2f-cb0d807696ee" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -2\\end{bmatrix}$ and $b=\\begin{bmatrix}20 \\\\ -17\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}20 \\\\ -17\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -4\\end{bmatrix}+\\begin{bmatrix}20 \\\\ -17\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(20) \\\\ (-4)+(-17)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}20 \\\\ -21\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(20)^2+(-21)^2} \\\\\n&= \\sqrt{841} \\\\\n&= 29\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{29}\\cdot (2a+b) \\\\\n&= \\frac{1}{29}\\cdot \\begin{bmatrix}20 \\\\ -21\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{20}{29} \\\\ - \\frac{21}{29}\\end{bmatrix}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17390a50-909e-519b-b1c9-2fd6e74d5286" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501419} {:answer/id #uuid "24652883-4d03-5d3a-94a2-7578f505b356" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}" :db/id #edb/ref 17592186501421} {:answer/id #uuid "3e7113a7-4e6f-50a3-ba67-bda8e88e5ac3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501423} {:answer/id #uuid "b19bb3ae-14c7-59ef-85c7-6d21c84a18fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{195}\\end{bmatrix}" :db/id #edb/ref 17592186501443} {:answer/id #uuid "f5b9b920-4cc5-5a82-a0bb-b0280d83ae64" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501450}] :answer-field/correct {:answer/id #uuid "17390a50-909e-519b-b1c9-2fd6e74d5286" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}" :db/id #edb/ref 17592186501419} :answer-field/id #uuid "af1f73f3-416d-515c-8b21-fd9ed0345370" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501441}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8567289b-a7cd-523c-8ba0-cb8ef5847d98" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}$ and $b=\\begin{bmatrix}4 \\\\ -1\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}4 \\\\ -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -6\\end{bmatrix}+\\begin{bmatrix}4 \\\\ -1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(4) \\\\ (-6)+(-1)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}4 \\\\ -7\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(4)^2+(-7)^2} \\\\\n&= \\sqrt{65} \\\\\n&= \\sqrt{65}\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{\\sqrt{65}}\\cdot (2a+b) \\\\\n&= \\frac{1}{\\sqrt{65}}\\cdot \\begin{bmatrix}4 \\\\ -7\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{4 \\sqrt{65}}{65} \\\\ - \\frac{7 \\sqrt{65}}{65}\\end{bmatrix}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4424df-2c27-57d6-b91a-4c769aa3a3d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186501417} {:answer/id #uuid "99a9035c-621d-5f0a-90b1-430b6da30043" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501438} {:answer/id #uuid "9fcb7f83-60ae-5fd7-8845-026488417b53" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{6}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501439} {:answer/id #uuid "f1867dff-0f88-5922-972b-2e006c5e6a9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{39}\\end{bmatrix}" :db/id #edb/ref 17592186501448} {:answer/id #uuid "f5b575f3-1801-524b-a76d-306e898a95d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501449}] :answer-field/correct {:answer/id #uuid "99a9035c-621d-5f0a-90b1-430b6da30043" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}" :db/id #edb/ref 17592186501438} :answer-field/id #uuid "45c48596-27ed-55c4-8123-7a3960c5a2e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501428}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "87c53303-b5c9-58af-aa9e-4eabf0ef314d" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ -1\\end{bmatrix}$ and $b=\\begin{bmatrix}-12 \\\\ -3\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-12 \\\\ -3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ -2\\end{bmatrix}+\\begin{bmatrix}-12 \\\\ -3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(-12) \\\\ (-2)+(-3)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-12 \\\\ -5\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(-12)^2+(-5)^2} \\\\\n&= \\sqrt{169} \\\\\n&= 13\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{13}\\cdot (2a+b) \\\\\n&= \\frac{1}{13}\\cdot \\begin{bmatrix}-12 \\\\ -5\\end{bmatrix} \\\\\n&= \\begin{bmatrix}- \\frac{12}{13} \\\\ - \\frac{5}{13}\\end{bmatrix}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135f6880-f2d4-57f4-b6c2-f57d76de9846" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{123}\\end{bmatrix}" :db/id #edb/ref 17592186501418} {:answer/id #uuid "64d9579b-9034-5d26-9564-05a7d8dfa32d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 \\\\ 40\\end{bmatrix}" :db/id #edb/ref 17592186501430} {:answer/id #uuid "71a98ba4-87aa-5cfb-85c6-16c3b6494b24" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ - \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501433} {:answer/id #uuid "bc8348aa-d847-507f-b28b-29a3f3e30499" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{82} \\\\ \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501445} {:answer/id #uuid "c52d8eab-2ff9-5a8e-b72b-8b924b645da0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501446}] :answer-field/correct {:answer/id #uuid "c52d8eab-2ff9-5a8e-b72b-8b924b645da0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{41}\\end{bmatrix}" :db/id #edb/ref 17592186501446} :answer-field/id #uuid "449fcc00-8553-5455-8f81-e7253900c6b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501427}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9375cd18-2a95-552f-b85a-1ce8d0584d8e" :question/problem "Let $a=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}$ and $b=\\begin{bmatrix}9 \\\\ 38\\end{bmatrix}$. Find a unit vector that is parallel to $2a+b$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\nu=\\frac{2a+b}{|2a+b|}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}\n2a+b &= 2\\cdot \\begin{bmatrix}0 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}9 \\\\ 38\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0 \\\\ 2\\end{bmatrix}+\\begin{bmatrix}9 \\\\ 38\\end{bmatrix} \\\\\n&= \\begin{bmatrix}0+(9) \\\\ (2)+(38)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}9 \\\\ 40\\end{bmatrix}\n\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}\n|2a+b| &= \\sqrt{(9)^2+(40)^2} \\\\\n&= \\sqrt{1681} \\\\\n&= 41\n\\end{aligned}\n$$\n\nFinally, we divide $2a+b$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}\nu &= \\frac{2a+b}{|2a+b|} \\\\\n&= \\frac{1}{41}\\cdot (2a+b) \\\\\n&= \\frac{1}{41}\\cdot \\begin{bmatrix}9 \\\\ 40\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{9}{41} \\\\ \\frac{40}{41}\\end{bmatrix}\n\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] [{:db/id #edb/ref 17592186087695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087502 :question/id #uuid "9c82456c-49ea-5a5e-b0a2-0ab17059acee" :question/math-academy-id "e-4390" :question/problem "Which of the following are zero matrices?\n\n$$\n\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\n$$" :question/worked-solution "- $P$ is a zero matrix since *all* its entries are zeros.\n\n- $Q$ is *not* a zero matrix since some of its entries are not zeros (for instance, $q_{12}=0.1\\neq0$).\n\n- $R$ is a zero matrix since *all* its entries are zeros.\n\nTherefore, only $P$ and $R$ are zero matrices."} :knowledge-point/id #uuid "ddb59990-7419-585f-aa1b-901d59c8cfc1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048896 :topic/math-academy-id 861 :topic/title "Introduction to Matrices"}] :knowledge-poi