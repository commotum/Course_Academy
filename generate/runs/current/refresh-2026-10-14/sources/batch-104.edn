& 4 \\\\ 5 & 6 & 5\\end{bmatrix}\\begin{bmatrix}-1 & -1 & 1 \\\\ -5 & 0 & 1 \\\\ 7 & 1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-1 & -1 & 1 \\\\ -5 & 0 & 1 \\\\ 7 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 1 & 1 \\\\ 3 & 5 & 4 \\\\ 5 & 6 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186275253 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d1f5b74-5fdc-5c2f-910a-09a005af8e81" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464396} {:answer/id #uuid "175316c7-1adf-5b8d-9638-61dd2beadeec" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464397}] :answer-field/correct {:answer/id #uuid "175316c7-1adf-5b8d-9638-61dd2beadeec" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464397} :answer-field/id #uuid "689c5fa5-ba6c-5e0d-a930-75571a26cf6e" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465132} {:answer-field/choices [{:answer/id #uuid "ac1e17b4-aee8-5fc5-8886-0a6cc9af81d9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464398} {:answer/id #uuid "80fd3428-c192-5980-99ad-b767ce6f34a2" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464399}] :answer-field/correct {:answer/id #uuid "ac1e17b4-aee8-5fc5-8886-0a6cc9af81d9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464398} :answer-field/id #uuid "9360b20c-7cda-5648-84a2-06445bc9ec4a" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465133} {:answer-field/choices [{:answer/id #uuid "57a03919-ca84-5fcc-84b3-a6150ed38402" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464400} {:answer/id #uuid "812754e6-e6a9-505c-b216-977872b3454c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464401}] :answer-field/correct {:answer/id #uuid "57a03919-ca84-5fcc-84b3-a6150ed38402" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464400} :answer-field/id #uuid "34e458fe-d597-518a-9c37-c84225521501" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465134}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1e4c02d8-0c31-5630-b78b-ca07d9d8a348" :question/math-academy-id "q-149833" :question/problem "Consider the matrices\n\n$$\nE=\\begin{bmatrix}1 & -1 & 1 \\\\ 2 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix},\\,F=\\frac{1}{3}\\begin{bmatrix}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix},\\,G=\\begin{bmatrix}1 & -3 & 4 \\\\ 0 & 2 & 3 \\\\ 3 & 0 & 1\\end{bmatrix}.\n$$\n\nWhich of the following statements are true?\n- **I.** $EF=FE={I}_{3}$\n- **II.** $FG=GF={I}_{3}$\n- **III.** $F={G}^{-1}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- First, we check whether $EF=FE={I}_{3}.$ Computing $EF$, we get\n\n$$\n\\begin{aligned}EF & =\\frac{1}{3}\\begin{bmatrix}1 & -1 & 1 \\\\ 2 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $FE$, we get\n\n$$\n\\begin{aligned}FE & =\\frac{1}{3}\\begin{bmatrix}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\\begin{bmatrix}1 & -1 & 1 \\\\ 2 & 1 & 2 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement I is true.\n\n- Now, we check whether $FG=GF={I}_{3}.$ Computing $FG$, we get\n\n$$\n\\begin{aligned}FG & =\\frac{1}{3}\\begin{bmatrix}1 & 1 & -3 \\\\ -2 & 1 & 0 \\\\ 0 & 0 & 3\\end{bmatrix}\\begin{bmatrix}1 & -3 & 4 \\\\ 0 & 2 & 3 \\\\ 3 & 0 & 1\\end{bmatrix} \\\\  & =\\frac{1}{3}\\begin{bmatrix}-8 & ∗ & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $F\\ne {G}^{-1}$ and statement III is false too.\n\nTherefore, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186339006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e493eb59-09aa-532b-acaf-dcd3967c268c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451549} {:answer/id #uuid "5eabfd91-4aa6-583d-b86d-836095be241a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451550}] :answer-field/correct {:answer/id #uuid "5eabfd91-4aa6-583d-b86d-836095be241a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451550} :answer-field/id #uuid "b2a2e580-f385-518a-bca2-50adf41ac690" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452622} {:answer-field/choices [{:answer/id #uuid "9e8dfef5-800b-5f06-a7b3-cca50500ee1b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451551} {:answer/id #uuid "1766099c-21d2-5f82-a7a3-13809129d3bb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451552}] :answer-field/correct {:answer/id #uuid "9e8dfef5-800b-5f06-a7b3-cca50500ee1b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451551} :answer-field/id #uuid "8ae44e41-c376-5d7d-800c-6a09f7ac5681" :answer-fie