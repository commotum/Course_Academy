#{[{:db/id #edb/ref 17592186119806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119617 :question/id #uuid "548ef945-392b-5e75-9b60-14f4e2de6261" :question/math-academy-id "e-4790" :question/problem "Find $\\mathbf{x},$ if $\\mathbf{a}+2\\mathbf{x} = \\mathbf{b}$ and\n![](images/8f/8fef8bb1e88ca823b49d8c5544c5456c66b7a5beb0c9bd48f349a50bf3fa17b5.svg)" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $\\mathbf{x},$ we get\n\n$$\n\\begin{aligned}a+2x & =b \\\\ 2x & =b-a \\\\ x & =\\frac{1}{2}(b-a) \\\\ x & =\\frac{1}{2}(\\begin{bmatrix}24 \\\\ -9 \\\\ 13\\end{bmatrix}-\\begin{bmatrix}12 \\\\ -11 \\\\ -5\\end{bmatrix}) \\\\ x & =\\frac{1}{2}\\begin{bmatrix}12 \\\\ 2 \\\\ 18\\end{bmatrix} \\\\ x & =\\begin{bmatrix}6 \\\\ 1 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/questions [{:db/id #edb/ref 17592186120310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a8765e6-0879-5856-ad1b-f5eb1d7789a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186315364} {:answer/id #uuid "40775ed2-c9df-5e2a-a497-29165c069954" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186315488} {:answer/id #uuid "5aeb048a-16d3-59c4-b03e-ad92c8ce7998" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186315634} {:answer/id #uuid "862e28cf-dd10-5b90-8ece-d08261ca4a6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 0 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186315869} {:answer/id #uuid "d3abbdcf-b73d-5cc1-8e30-ffe65468b6df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ -2 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 1759218631