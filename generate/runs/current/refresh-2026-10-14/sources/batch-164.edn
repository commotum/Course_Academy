/value "D = \\begin{bmatrix}1 & 1 & 1 & 0 \\\\ 0 & -1 & 0 & 3 \\\\ 0 & 0 & 3 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186118299} {:answer/id #uuid "ddbcd510-8196-5dd5-8040-8e0d74f88a8e" :answer/type {:db/ident :answer.type/math} :answer/value "E = \\begin{bmatrix}1 & 2 & 0 & 0 & 5 \\\\ 0 & 3 & 0 & 5 & 3 \\\\ 0 & 0 & 1 & 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186118300} {:answer/id #uuid "e1dc381e-7fc9-51f4-91a7-448730b2123f" :answer/type {:db/ident :answer.type/math} :answer/value "A = \\begin{bmatrix}5 & -3 & 2 & 0 \\\\ 0 & 2 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186118301} {:answer/id #uuid "3ddbdba3-aa44-5df7-8946-615c6227e1f5" :answer/type {:db/ident :answer.type/math} :answer/value "B = \\begin{bmatrix}1 & 0 & 2 & 0 & 0 \\\\ 0 & -1 & 3 & 1 & 2 \\\\ 0 & 0 & 1 & 1 & 0 \\\\ 0 & 0 & 0 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186118302} {:answer/id #uuid "51383179-335b-5d6d-8add-d367b6dab0fa" :answer/type {:db/ident :answer.type/math} :answer/value "C = \\begin{bmatrix}1 & -1 & 2 \\\\ 0 & 2 & 3 \\\\ 0 & 3 & -2\\end{bmatrix}" :db/id #edb/ref 17592186118303}] :answer-field/id #uuid "8b490f9e-f431-571e-9a05-4fef55cab46a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118298}] :question/id #uuid "086b96e1-65a9-5422-b3cf-ae3404b4fecb" :question/math-academy-id "q-34807" :question/problem "Which of the following matrices has a rank of $4$?"} {:db/id #edb/ref 17592186120384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "945d944c-fac2-5c78-b5af-5193058f264a" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186118419} {:answer/id #uuid "ab86d42d-39d0-589e-b841-62a253b4d424" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186118420} {:answer/id #uuid "b8a4f0a2-4dd2-5bf8-a5a1-995713db8bfd" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186118421} {