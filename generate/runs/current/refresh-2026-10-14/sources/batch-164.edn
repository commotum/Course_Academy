field.type/radio} :db/id #edb/ref 17592186240619}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0970eb33-9f16-5468-a48a-ce3c4e9ea202" :question/math-academy-id "q-105159" :question/problem "Find $x$, if $4a+3x=b$ and\n\n$$\na=\\begin{bmatrix}3 \\\\ -1 \\\\ -4\\end{bmatrix},\\,b=\\begin{bmatrix}3 \\\\ 2 \\\\ -1\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}4a+3x & =b \\\\ 3x & =b-4a \\\\ x & =\\frac{1}{3}(b-4a) \\\\ x & =\\frac{1}{3}(\\begin{bmatrix}3 \\\\ 2 \\\\ -1\\end{bmatrix}-4\\begin{bmatrix}3 \\\\ -1 \\\\ -4\\end{bmatrix}) \\\\ x & =\\frac{1}{3}\\begin{bmatrix}-9 \\\\ 6 \\\\ 15\\end{bmatrix} \\\\ x & =\\begin{bmatrix}-3 \\\\ 2 \\\\ 5\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078a9ec2-ec45-5cb3-9fa6-fafc704f3a74" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186238137} {:answer/id #uuid "0fc0872c-5cbc-50aa-a104-55f19e6b295e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186238190} {:answer/id #uuid "3859506a-2f62-51f2-9746-b6b6e6ad359c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238543} {:answer/id #uuid "7b700677-9bf6-5789-9d49-4fae8f9135eb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186239119} {:answer/id #uuid "a7a5b1bf-85fc-59df-966b-dfb82ea3d6cf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186239508}] :answer-field/correct {:answer/id #uuid "7b700677-9bf6-5789-9d49-4fae8f9135eb" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186239119} :answer-field/id #uuid "e10a3090-0273-566f-800d-479ce03b72bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :d