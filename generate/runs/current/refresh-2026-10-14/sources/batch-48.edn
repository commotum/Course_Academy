#{[{:db/id #edb/ref 17592186059676 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059504 :question/id #uuid "ae922c00-2ff5-5a46-805a-62955bc5a08a" :question/math-academy-id "e-3632" :question/problem "Find the slope of $y = 4\\tan x + 5x$ at $x = 0.$" :question/worked-solution "The slope at $x=0$ is given by the value of the derivative $y'$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\tan x) = \\sec^2 x.$ We get\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4tan⁡x+5x) \\\\  & =4{sec}^{2}⁡x+5.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & =4{sec}^{2}⁡0+5 \\\\  & =4\\cdot 1+5 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore, the slope is $9.$"} :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/questions [{:db/id #edb/ref 17592186060266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc30ef38-cbec-55b9-a2fa-eac62f6febaf" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\csc^{2} x - 3x" :db/id #edb/ref 17592186058219} {:answer/id #uuid "d639cc01-99a5-5305-b28d-b0e55d5fff5d" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\sec^{2} x - 3x" :db/id #edb/ref 17592186058220} {:answer/id #uuid "4360cf12-9eb7-5492-ba39-14a61f0ea3ed" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sec^{2} x - 3" :db/id #edb/ref 17592186058221} {:answer/id #uuid "5374242e-ca7e-5305-910c-cf4057c4f398" :answer/type {:db/ident :answer.type/math} :answer/value "8\\csc^{2} x + 3" :db/id #edb/ref 17592186058222} {:answer/id #uuid "74e8baf7-d99f-5f98-8217-2cecba703059" :answer/type {:db/ident :answer.type/math} :answer/value "8\\csc x - 3" :db/id #edb/ref 17592186058223}] :answer-field/id #uuid "27d44d3b-325c-56cd-be48-4b748b31211c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058218}] :question/id #uuid "c5de72a3-98da-5c31-