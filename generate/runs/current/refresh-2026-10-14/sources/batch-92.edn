#{[{:db/id #edb/ref 17592186064177 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064051 :question/id #uuid "90010ae5-e211-510f-b188-dc3006926d94" :question/math-academy-id "e-381" :question/problem "Calculate $\\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x.$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\eqalign{\n\\displaystyle \\int 5 \\cdot 9^x +3 e^x  \\, \\textrm d x &= \\displaystyle 5\\int 9^x \\, \\textrm{d}x+ 3 \\displaystyle \\int e^x \\, \\textrm{d}x\\\n&= 5\\cdot \\dfrac{9^x}{\\ln 9} + 3 e^x +C.\n}\n$$"} :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050321 :topic/math-academy-id 3769 :topic/title "The Sum Rule for Indefinite Integrals"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb961f21-24f9-5186-8b78-9160a090c5f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2^{x}}{\\ln 2} - 10e^{x} + C" :db/id #edb/ref 17592186062456} {:answer/id #uuid "e669465d-2a21-50bb-8844-652cde65cb07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x - 2}{\\ln 2} - 10e^{x} + C" :db/id #edb/ref 17592186062457} {:answer/id #uuid "1fd3cf03-65ba-5dbb-b119-e3a217383f5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{\\ln 2} - e^{x} + C" :db/id #edb/ref 17592186062458} {:answer/id #uuid "36ba2561-d258-5dff-81fe-25738beafe32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{\\ln 2} + e^{10x} + C" :db/id #edb/ref 17592186062459} {:answer/id #uuid "43e299a5-2bc0-592c-8cb9-be8f6744c147" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2^{x}}{\\ln \\mid x \\mid} - 10e^{x} + C" :db/id #edb/ref 17592186062460}] :answer-field/id #uuid "7fd73a8a-2a74-5be1-800c-826ac42df97b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062455}] :question/id #uuid "d4a07f60-4f2c-5af2-ada1-305bc3c189a7" :question/math-academy-id "q-31311" :question/problem "What is $\\displaystyle \\int(2^{x} - 10e^{x})dx$?"} {:db/id #edb/ref 17592186064889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1508f44-ef2f-5fb2-833b-2c1cdbc1f242" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x} + \\frac{4^{x}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063391} {:answer/id #uuid "fb1b5947-8324-568d-a1eb-6bab88724f99" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x} + \\frac{x^{4}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063392} {:answer/id #uuid "10820fcc-08b9-5665-9f14-e212298a861f" :answer/type {:db/ident :answer.type/math} :answer/value "e^{2x} + \\frac{x^{4}}{\\ln 4} - 2x^{2} + C" :db/id #edb/ref 17592186063393} {:answer/id #uuid "1aa00c79-92f8-5479-b7be-d4906d2fca5f" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{x} + 4^{x}\\ln 4 - \\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186063394} {:answer/id #uuid "64107285-5bce-5d52-ac18-a3e7155a4f0e" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{x} + \\frac{4^{x}}{\\ln 4} - x^{2} + C" :db/id #edb/ref 17592186063395}] :answer-field/id #uuid "6518b595-b387-521a-bcc0-05e2bc70cceb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063390}] :question/id #uuid "c5ef23df-cb86-53d4-a2bd-c06a8017fa2b" :question/math-academy-id "q-51102" :question/problem "What is $\\displaystyle \\int(2e^{x} + 4^{x} - 2x)dx$?"} {:db/id #edb/ref 17592186233778 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bf1d61d4-5576-5207-ad64-f8866ebc8219" :question/math-academy-id "q-31261" :question/problem "$\\int ({e}^{x}+{8}^{x}+\\frac{3}{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int ({e}^{x}+{8}^{x}+\\frac{3}{x})\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x+\\int {8}^{x}\\,\\text{d}x+\\int \\frac{3}{x}\\,\\text{d}x \\\\  & ={e}^{x}+\\frac{{8}^{x}}{\\operatorname{ln}8}+3\\operatorname{ln}|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235436 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4efd78ec-0961-543d-89f6-569515b073d4" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}" :db/id #edb/ref 17592186234669}] :answer-field/correct {:answer/id #uuid "4efd78ec-0961-543d-89f6-569515b073d4" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}" :db/id #edb/ref 17592186234669} :answer-field/id #uuid "a091f6bc-b989-5a26-a703-2d9db59566b8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235163}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d250de2a-60d6-5a40-8247-2b544c01b955" :question/math-academy-id "q-167332" :question/problem "$\\int (4f(x)+3g(x))\\,\\text{d}x\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "We combine the sum and the constant multiple rules, as follows:\n\n$$\n\\begin{aligned}\\int (4f(x)+3g(x))\\text{d}x & =\\int (4\\cdot \\frac{1}{2}{e}^{x}+3(8x-\\frac{2}{3}{x}^{3}))\\text{d}x \\\\  & =\\int (2{e}^{x}+24x-2{x}^{3})\\text{d}x \\\\  & =2\\int {e}^{x}\\,\\text{d}x+24\\int x\\,\\text{d}x-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{e}^{x}+24\\cdot \\frac{{x}^{2}}{2}-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."} {:db/id #edb/ref 17592186235485 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf72517-3161-51c9-a14c-e5763bd0a6ee" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}" :db/id #edb/ref 17592186234788}] :answer-field/correct {:answer/id #uuid "9cf72517-3161-51c9-a14c-e5763bd0a6ee" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}" :db/id #edb/ref 17592186234788} :answer-field/id #uuid "d167882f-97cc-578a-888d-a466d8df8618" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235228}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f4bfc51-e9ec-5f3d-bb23-fc7c6d021c8b" :question/math-academy-id "q-167786" :question/problem "$\\int (4f(x)+3g(x))\\,\\text{d}x\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "We combine the sum and the constant multiple rules, as follows:\n\n$$\n\\begin{aligned}\\int (4f(x)+3g(x))\\text{d}x & =\\int (4\\cdot \\frac{1}{2}{e}^{x}+3(8x-\\frac{2}{3}{x}^{3}))\\text{d}x \\\\  & =\\int (2{e}^{x}+24x-2{x}^{3})\\text{d}x \\\\  & =2\\int {e}^{x}\\,\\text{d}x+24\\int x\\,\\text{d}x-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{e}^{x}+24\\cdot \\frac{{x}^{2}}{2}-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."} {:db/id #edb/ref 17592186290437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f1030c-14e2-59e9-a189-ae72636d7cec" :answer/type {