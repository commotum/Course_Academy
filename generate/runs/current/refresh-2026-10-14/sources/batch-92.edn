}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15325872-4e2f-544f-9dec-000683e3691e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(x)}{25}+C" :db/id #edb/ref 17592186288177} {:answer/id #uuid "164243e9-717c-580d-9d74-331ac357f68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288180} {:answer/id #uuid "6b7d4913-276e-5926-8683-f107a4d1158c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(25x)}{25}+C" :db/id #edb/ref 17592186288790} {:answer/id #uuid "87403b08-b913-5b5b-af1b-47f906da3828" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288944} {:answer/id #uuid "90b08433-72df-5a70-8a55-aec7b22f8981" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(25x)}{25}+C" :db/id #edb/ref 17592186289001}] :answer-field/correct {:answer/id #uuid "164243e9-717c-580d-9d74-331ac357f68c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288180} :answer-field/id #uuid "589b96c3-feba-5f82-b690-a05fef9d4fc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289916}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d025ad08-0459-5553-af22-02ed776a0b57" :question/math-academy-id "q-2507" :question/problem "$\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${