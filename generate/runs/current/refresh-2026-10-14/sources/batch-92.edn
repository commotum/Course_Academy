gin{aligned}\\int \\frac{1}{9\\sqrt{1-81{x}^{2}}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{\\sqrt{1-(9x)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{9}\\text{d}u) \\\\  & =\\frac{1}{81}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{81}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{81}\\operatorname{arcsin}⁡(9x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250163 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c527d9-5fef-527b-944d-6452bf1f22ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248439} {:answer/id #uuid "b49d7d3e-613f-5c56-842d-c0c3e5de4bcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{8}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249040} {:answer/id #uuid "bde79f17-dd2a-5f64-a9ae-c0fae23b5c8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(3x)+C" :db/id #edb/ref 17592186249113} {:answer/id #uuid "dc9408cf-bf7c-5267-9022-0123e7766afe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249376} {:answer/id #uuid "ec0cf6c1-d063-5749-83ca-58271291edbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{8}\\operatorname{arcsin}⁡(3x)+C" :db/id #edb/ref 17592186249497}] :answer-field/correct {:answer/id #uuid "73c527d9-5fef-527b-944d-6452bf1f22ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248439} :answer-field/id #uuid "aaa559e6-16f4-5c76-808e-c0ea0a5329cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249974}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "836b44bd