403-1fcf-56ef-a15e-d472389956d6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186249026}] :answer-field/correct {:answer/id #uuid "b2e81403-1fcf-56ef-a15e-d472389956d6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186249026} :answer-field/id #uuid "f87d1651-2170-52b4-b32a-7d6f3076ecc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250110}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e7c70ecc-510e-5481-bfab-ec3f7c63aab2" :question/math-academy-id "q-114030" :question/problem "Calculate $\\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x & =2\\int \\frac{1}{\\sqrt{25\\cdot (1-{x}^{2}/25)}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-{x}^{2}/25}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{5})}^{2}.$ \n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get  \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (5\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =2\\operatorname{arcsin}⁡u+C \\\\  & =2\\operatorname{arcsin}⁡(\\frac{x}{5})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2488cb64-1bbf-52da-a312-e3caf405d555" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247745} {:answer/id #uuid "38930a0c-015d-5696-ba08-428df9678156" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247929} {:answer/id #uuid "3fe37be6-22eb-55e9-ba87-4d2f7527adbf" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247991} {:answer/id #uuid "725143bf-9ac9-517a-9c80-3ca905fe3cce" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{x})+C" :db/id #edb/ref 17592186248422} {:answer/id #uuid "e6673b34-1ab8-57dc-8fcd-d06a4fb12faa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249454}] :answer-field/correct {:answer/id #uuid "38930a0c-015d-5696-ba08-428df9678156" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247929} :answer-field/id #uuid "87006c2a-5518-5f50-8546-d7d44af9d5e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249905}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b8555c3-b26d-54b8-b47b-601c910c10ab" :question/math-academy-id "q-114032" :question/problem "Calculate $\\int \\frac{3}{\\sqrt{1-3{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $3{x}^{2}=(\\sqrt{3}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{\\sqrt{1-3{x}^{2}}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{1-(\\sqrt{3}x)^{2}}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{3}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{3\\sqrt{3}}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8e08bb-1b37-5cf6-86db-c3ef539c1d7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\operatorname{arccos}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186288202} {:answer/id #uuid "45dc7c37-051d-511b-9e8a-aec010663441" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186288507} {:answer/id #uuid "58113f3e-82c1-5ec1-9b67-5669fee9fd01" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arccos}⁡({x}^{2})+C" :db/id #edb/ref 17592186288647} {:answer/id #uuid "978f50c6-52a3-5c94-9441-ace404075a2b" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡({x}^{2})+C" :db/id #edb/ref 17592186289048} {:answer/id #uuid "99ed0e47-4a7c-5b89-9c0b-8ff18f3172b5" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡(\\frac{{x}^{2}}{9})+C" :db/id #edb/ref 17592186289060}] :answer-field/correct {:answer/id #uuid "45dc7c37-051d-511b-9e8a-aec010663441" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186288507} :answer-field/id #uuid "f07d43ea-d249-5835-9f11-f5ac2c8850b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290229}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2b7a5d31-b8c0-5e03-b3eb-62f1624001b3" :question/math-academy-id "q-2503" :question/problem "$\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{9\\cdot (1-{x}^{2}/9)}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{x}^{2}/9}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$  \n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "107a9f41-2502-55f7-8a6a-ad9668d4d961" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(9x)}{9}+C" :db/id #edb/ref 17592186288156} {:answer/id #uuid "26fda1ba-8631-59b5-be99-a0b25adfb1b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(3x)}{3}+C" :db/id #edb/ref 17592186288289} {:answer/id #uuid "3dd4480a-eb47-5df7-8f7d-7d8a0364fcf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C" :db/id #edb/ref 17592186288453} {:answer/id #uuid "d611d7c2-8a82-5a2a-819e-f3aaaf3c8caf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}{(9x)}^{2}}{9}+C" :db/id #edb/ref 17592186289454} {:answer/id #uuid "fe0ca68c-3ad4-59cd-a28c-b4af3a7ea2b9" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡(3x)+C" :db/id #edb/ref 17592186289710}] :answer-field/correct {:answer/id #uuid "3dd4480a-eb47-5df7-8f7d-7d8a0364fcf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C" :db/id #edb/ref 17592186288453} :answer-field/id #uuid "bc6db447-0452-575d-91d0-4892a31cf97a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290140}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "125b10d6-12e0-5b91-bec6-9d12798feef7" :question/math-academy-id "q-2506" :question/problem "$\\int \\frac{1}{\\sqrt{1-9{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{1-9{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(3x)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e102532-1da6-505c-8449-9cc76869ce8f" :answer/type {:db/ident :answer.type/math} :answer/value "36\\operatorname{arcsin}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186327613} {:answer/id #uuid "7a1a0201-5d52-55b8-abe6-b78bfe3139ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x}{2})+C" :db/id #edb/ref 17592186327981} {:answer/id #uuid "c31eb764-054a-5f59-8e49-ecb141552eb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186328639} {:answer/id #uuid "df2c1966-1b2a-5a6d-bb6c-45c4f8885c1f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{arcsin}(\\frac{x}{6})+C" :db/id #edb/ref 17592186328889} {:answer/id #uuid "e319cc83-daa7-5ab6-89e3-973218f6e0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186328923}] :answer-field/correct {:answer/id #uuid "c31eb764-054a-5f59-8e49-ecb141552eb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186328639} :answer-field/id #uuid "381407f6-8896-57f4-8153-d40f382fa1ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329294}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03ce47aa-60a1-561f-9a2d-d11c8a6e24bf" :question/math-academy-id "q-4334" :question/problem "$\\int \\frac{1}{\\sqrt{36-{x}^{2}}}\\text{d}x\\,=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{36\\cdot (1-{x}^{2}/36)}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-{x}^{2}/36}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-(x/6)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{6})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{6}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{6}\\,⟹\\,\\text{d}x=6\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-(x/6)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (6\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(\\frac{x}{6})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20636742-aec8-533d-81ab-483f87790c99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(4x)}{4}+C" :db/id #edb/ref 17592186330228} {:answer/id #uuid "38566a19-7854-56cf-af3a-e54d537a1d3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(2x)}{4}+C" :db/id #edb/ref 17592186330453} {:answer/id #uuid "526ca6ab-aa62-5847-a02f-822078fec297" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(4x)+C" :db/id #edb/ref 17592186330700} {:answer/id #uuid "574c08c3-be86-5c8a-8004-c16318247a1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C" :db/id #edb/ref 17592186330731} {:answer/id #uuid "a94c081b-466b-5fb0-a0ba-fcb864725ee9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(4x)}{2}+C" :db/id #edb/ref 17592186331452}] :answer-field/correct {:answer/id #uuid "a94c081b-466b-5fb0-a0ba-fcb864725ee9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(4x)}{2}+C" :db/id #edb/ref 17592186331452} :answer-field/id #uuid "c8b5e79f-94df-55e7-982d-e299729c78cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332551}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0234d108-fb03-514f-bf51-2014068d6893" :question/math-academy-id "q-49535" :question/problem "$\\int \\frac{2}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $16{x}^{2}=(4x)^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x & =2\\int \\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{4}\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{\\operatorname{arcsin}⁡(4x)}{2}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383613a-52a1-5d64-8c26-ecd04de30f0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186339435} {:answer/id #uuid "4c648079-c85a-5f5e-8976-d0479a4da8f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186339821} {:answer/id #uuid "6b5550ab-a530-5982-a558-83f8aec51f26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186340078} {:answer/id #uuid "7c200317-7a2d-5a1a-9a82-89183fc7851c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186340244} {:answer/id #uuid "ec37b5d7-c2b9-52a3-ad41-1f64c1e8cd40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186341210}] :answer-field/correct {:answer/id #uuid "ec37b5d7-c2b9-52a3-ad41-1f64c1e8cd40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186341210} :answer-field/id #uuid "ba24916a-286f-51a8-ad99-99bcf753abe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341703}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "279b83c3-9e48-526a-b453-9a5fa23b12aa" :question/math-academy-id "q-73712" :question/problem "$\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:   \n\n$$\n\\begin{aligned}\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =\\frac{8}{3}\\int \\frac{1}{\\sqrt{4\\cdot (1-{x}^{2}/4)}}\\,\\text{d}x \\\\  & =\\frac{8}{3}\\cdot \\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{x}^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$ \n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\n \n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x \\\\  & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (2\\,\\text{d}u) \\\\  & =\\frac{8}{3}\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{8}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Sine"}] [{:db/id #edb/ref 17592186064219 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064091 :question/id #uuid "3e89a278-54ab-59a6-adb6-38f43c0fbe9a" :question/math-academy-id "e-471" :question/problem "Calculate the integral  $\\displaystyle{\\int \\dfrac{3}{2 + 50x^2} \\, \\textrm{d}x }.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\dfrac{3}{2 + 50x^2} \\, \\textrm{d}x = \\int \\dfrac{3}{2(1 + 25x^2)} = \\dfrac 3 2 \\int \\dfrac{1}{1+25x^2}\\,\\textrm d x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+u^2}\\textrm{d}u =\\arctan u +C.\n$$\n\nThe only difference is that instead of $u^2$ as the variable, we have $25x^2 = (5x)^2.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=5\\quad\\Longrightarrow\\quad \\dfrac 1 5\\,\\textrm d u = \\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{2+50{x}^{2}}\\,\\text{d}x & =\\frac{3}{2}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{2}\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\,\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{3}{10}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{10}\\cdot \\operatorname{arctan}⁡u+C \\\\  & =\\frac{3}{10}\\operatorname{arctan}⁡5x+C\\end{aligned}\\end{aligned}\n$$"} :knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/questions [{:db/id #edb/ref 17592186064874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b3f469d-d785-54c0-8500-e4f4c541c311" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arctan}⁡(3x)+C" :db/id #edb/ref 17592186330478} {:answer/id #uuid "44fe7e54-fa6e-59d5-8a26-f4f36bb5501f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(3x)}{3}+C" :db/id #edb/ref 17592186330572} {:answer/id #uuid "848d8e79-5f9b-50c9-a7a2-c023a98ccebf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(3x)+C" :db/id #edb/ref 17592186331128} {:answer/id #uuid "be85cd80-7bd6-5b67-8980-2e785a3889ed" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(3x)+C" :db/id #edb/ref 17592186331634} {:answer/id #uuid "fb4584df-c775-5f4a-a59c-6d2f35a59525" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C" :db/id #edb/ref 17592186332157}] :answer-field/correct {:answer/id #uuid "be85cd80-7bd6-5b67-8980-2e785a3889ed" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(3x)+C" :db/id #edb/ref 17592186331634} :answer-field/id #uuid "3e5cefbe-1794-5312-8f1f-f28eb36bbc55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332307}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5ff7c3e1-6732-5fb3-bcd2-7ed1aeab0712" :question/math-academy-id "q-49540" :question/problem "$\\int \\frac{6}{1+9{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\n\nSo. let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{6}{1+9{x}^{2}}\\,\\text{d}x & =6\\int \\frac{1}{1+(3x)^{2}}\\text{d}x \\\\  & =6\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =2\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =2\\operatorname{arctan}⁡u+C \\\\  & =2\\operatorname{arctan}⁡(3x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064876 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0edb1c73-87ee-58c2-a730-43e7f693d596" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{arctan}⁡(\\frac{x}{9})+C" :db/id #edb/ref 17592186330078} {:answer/id #uuid "26074d64-e780-5986-be16-fa82ceeb0164" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186330281} {:answer/id #uuid "3ec2d31d-3894-565f-9b91-3bc180c6d541" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186330506} {:answer/id #uuid "581c2751-ecf3-5021-a41f-a828e408e3cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x}{9})+C" :db/id #edb/ref 17592186330735} {:answer/id #uuid "59dbc6dd-87a6-5e93-99fe-8c88f23299aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{x}{9})+C" :db/id #edb/ref 17592186330753}] :answer-field/correct {:answer/id #uuid "3ec2d31d-3894-565f-9b91-3bc180c6d541" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186330506} :answer-field/id #uuid "ef0aa3c5-1f7e-5feb-b2ae-0f439aa2181d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332622}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ea76ea1f-1600-5c9d-b198-b9fb197580ab" :question/math-academy-id "q-49548" :question/problem "$\\int \\frac{1}{9+{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{9+{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{9\\cdot (1+{x}^{2}/9)}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{x}^{2}/9}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+(x/3)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{9+{x}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1+(x/3)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{u}^{2}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b46bc9-97cb-5bce-918b-8b92646973b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186247570} {:answer/id #uuid "1b1e75f2-49eb-5a5d-9cee-c6ed60930c7d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186247668} {:answer/id #uuid "3de5bd43-5bd8-5d01-8064-06ac8fdb185f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186247970} {:answer/id #uuid "c07e9314-0212-563d-818b-d17717a081be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186249137} {:answer/id #uuid "c7202512-7634-5743-96f4-8104d0655a3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186249191}] :answer-field/correct {:answer/id #uuid "c7202512-7634-5743-96f4-8104d0655a3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186249191} :answer-field/id #uuid "c3dd683c-9379-5f34-9cdb-095ffd9b03f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250005}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c6b1e250-deab-5051-9d86-76fdce192937" :question/math-academy-id "q-114033" :question/problem "Calculate $\\int \\frac{3}{1+36{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $36{x}^{2}=(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{1+36{x}^{2}}\\,\\text{d}x & =3\\int \\frac{1}{1+(6x)^{2}}\\text{d}x \\\\  & =3\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0539dfbd-c13f-5910-83ae-6847aafc2ffa" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247464} {:answer/id #uuid "0e2ff00e-68bf-502d-98ea-81a253a73c45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247554} {:answer/id #uuid "4cfc5510-a085-5eb9-b318-bbda8928e434" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186248113} {:answer/id #uuid "5be141d4-f3ae-5dbe-a3ed-b73522cecff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186248256} {:answer/id #uuid "b327e315-fd5b-5fed-a846-f91465502aee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186249029}] :answer-field/correct {:answer/id #uuid "0e2ff00e-68bf-502d-98ea-81a253a73c45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247554} :answer-field/id #uuid "692c144a-767b-5856-8997-1c4aa1c3ede5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249853}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2983a03c-228c-5295-a88a-957cc5ef8213" :question/math-academy-id "q-114035" :question/problem "Calculate $\\int \\frac{1}{1+5{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $5{x}^{2}=(\\sqrt{5}x)^{2}.$\n\nThus, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+5{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(\\sqrt{5}x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9072ff-4248-5c96-aa34-ca722a5750b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186247515} {:answer/id #uuid "5c681104-b0e2-5a5b-8f09-f83ae1045726" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248265} {:answer/id #uuid "69b6f3a0-9094-584b-a375-09202334d54b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248367} {:answer/id #uuid "8be15631-a51f-557d-9b64-882be871c95f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+C" :db/id #edb/ref 17592186248677} {:answer/id #uuid "ff4d3d45-5080-5430-90e3-c1923ab5f66b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249659}] :answer-field/correct {:answer/id #uuid "ff4d3d45-5080-5430-90e3-c1923ab5f66b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249659} :answer-field/id #uuid "f08c78cb-9c6d-566a-a639-9975746cefc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250089}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ac34d6b4-de07-59e6-a640-adcba3a25634" :question/math-academy-id "q-114036" :question/problem "Calculate $\\int \\frac{1}{1+3{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $3{x}^{2}=(\\sqrt{3}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+3{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(\\sqrt{3}x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "253eba90-1471-5899-a022-f2a6a0dcc2f4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186247751} {:answer/id #uuid "5d35edcf-35aa-5569-a7e5-3873e6df59f4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248273} {:answer/id #uuid "ae194557-e33c-5111-90ab-ccce8ece805c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatornam