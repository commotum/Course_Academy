7-5b03-bdd5-d469206d5055" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{7}^{x}}{ln⁡7}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186488368} {:answer/id #uuid "e3714c2f-038a-502c-8e59-d26f59c829cb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{ln⁡2}+\\frac{{x}^{2}}{2}-3{e}^{x}+C" :db/id #edb/ref 17592186488371} {:answer/id #uuid "e862b7ff-3d80-5b2f-b753-3257f1333194" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{7}^{x}}{ln⁡7}+{x}^{2}+{e}^{x}+C" :db/id #edb/ref 17592186488373}] :answer-field/correct {:answer/id #uuid "c779612a-03b7-5b03-bdd5-d469206d5055" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{7}^{x}}{ln⁡7}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186488368} :answer-field/id #uuid "96c4d617-33df-5106-88ff-53415e61c0a7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488364}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f83b5753-3204-51de-9a63-cf67f502215f" :question/problem "$\\int (2{e}^{x}-{7}^{x}+{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (2{e}^{x}-{7}^{x}+{x}^{2})\\,\\text{d}x & =2\\int {e}^{x}\\,\\text{d}x-\\int {7}^{x}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2{e}^{x}-\\frac{{7}^{x}}{ln⁡7}+\\frac{{x}^{3}}{3}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "569b842d-17a2-53d4-9b00-9b5178c0a749" :answer/type {:db/ident :answer.type/math} :answer/value "2e^x+12x^2-\\frac{x^4}{2}" :db/id #edb/ref 17592186513767}] :answer-field/correct {:answer/id #uuid "569b842d-17a2-53d4-9b00-9b5178c0a749" :answer/type {:db/ident :answer.type/math} :answer/value "2e^x+12x^2-\\frac{x^4}{2}" :db/id #edb/ref 17592186513767} :answer-field/id #uuid "9a994c66-aac8-5b19-bc23-3cf37a49b2cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514300}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7323da16-6dcc-5329-81f1-5b6cb91bd332" :question/math-academy-id "q-166079" :question/problem "$\\int (4f(x)+3g(x))\\,\\text{d}x\\,=${{field-1}}\n$+C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "We combine the sum and the constant multiple rules, as follows:\n\n$$\n\\begin{aligned}\\int (4f(x)+3g(x))\\text{d}x & =\\int (4\\cdot \\frac{1}{2}{e}^{x}+3(8x-\\frac{2}{3}{x}^{3}))\\text{d}x \\\\  & =\\int (2{e}^{x}+24x-2{x}^{3})\\text{d}x \\\\  & =2\\int {e}^{x}\\,\\text{d}x+24\\int x\\,\\text{d}x-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{e}^{x}+24\\cdot \\frac{{x}^{2}}{2}-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] :knowledge-point/title "Integrating a Sum of Exponential Functions"}] [{:db/id #edb/ref 17592186064218 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064090 :question/id #uuid "48ec6930-88b7-5aad-9bb7-c5e23e766f80" :question/math-academy-id "e-470" :question/problem "Calculate the integral $\\displaystyle \\int \\dfrac{9}{4\\sqrt{1-9x^2}} \\, \\textrm{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\textrm{d}u = \\arcsin(u)+C.\n$$\n\nThe only difference is that instead of $u^2$ as the variable, we have $9x^2 = (3x)^2.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=3\\quad\\Longrightarrow\\quad \\dfrac 1 3 \\,\\textrm d u=\\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{9}{4\\sqrt{1-9{x}^{2}}}\\,\\text{d}x & =\\frac{9}{4}\\int \\frac{1}{\\sqrt{1-(3x)^{2}}}\\,\\,\\text{d}x \\\\  & =\\frac{9}{4}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{9}{12}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{3}{4}\\cdot \\operatorname{arcsin}⁡u+C \\\\  & =\\frac{3}{4}\\operatorname{arcsin}⁡3x+C\\end{aligned}\\end{aligned}\n$$"} :knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050628 :topic/math-academy-id 334 :topic/title "Integrating Algebraic Functions Using Substitution"} {:db/id #edb/ref 17592186050675 :topic/math-academy-id 303 :topic/title "Differentiating Inverse Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064647 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3b7a90-7d72-5a99-9f10-108f806b6da5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(2x)}{2}+C" :db/id #edb/ref 17592186288315} {:answer/id #uuid "34a56bfb-a273-5eec-9f09-a222905d86f2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186288382} {:answer/id #uuid "43404de6-f6f9-59a5-acf1-14d8593d6a56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccos}⁡(4x)}{4}+C" :db/id #edb/ref 17592186288490} {:answer/id #uuid "711eb3a2-2c35-5a61-b85b-17fa689080bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arccos}⁡(2x)}{2}+C" :db/id #edb/ref 17592186288822} {:answer/id #uuid "c5155d79-8ade-51eb-8d3c-822c02c6beaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(4x)}{4}+C" :db/id #edb/ref 17592186289336}] :answer-field/correct {:answer/id #uuid "2b3b7a90-7d72-5a99-9f10-108f806b6da5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(2x)}{2}+C" :db/id #edb/ref 17592186288315} :answer-field/id #uuid "91651d73-69de-589e-aa19-a3ea361f9513" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290056}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "acd4f39a-fd64-5311-a828-2932bce0f1a8" :question/math-academy-id "q-2505" :question/problem "$\\int \\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $4{x}^{2}=(2x)^{2}.$\n\nSo, let's substitute $u=2x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{\\operatorname{arcsin}⁡(2x)}{2}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19438f52-8874-56fd-bb9f-7857344ac362" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡(7x)+C" :db/id #edb/ref 17592186330164} {:answer/id #uuid "27da08fc-35f0-56f1-acff-a755484fdd6c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186330305} {:answer/id #uuid "9871b94a-089f-5bbe-8ded-48924d04a46a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{arcsin}⁡(\\frac{x}{7})}{7}+C" :db/id #edb/ref 17592186331310} {:answer/id #uuid "ab93e473-1608-50b7-b492-43d6a6d77578" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186331471} {:answer/id #uuid "ecbe9328-2d86-5c1a-b284-26c4a4a4a355" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(\\frac{x}{7})}{3}+C" :db/id #edb/ref 17592186332026}] :answer-field/correct {:answer/id #uuid "ab93e473-1608-50b7-b492-43d6a6d77578" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcsin}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186331471} :answer-field/id #uuid "46fef57b-341f-5a8d-b8ea-18d737471bce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332317}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20c23af2-eaef-5502-8cf2-7e2560ab8597" :question/math-academy-id "q-49547" :question/problem "$\\int \\frac{3}{\\sqrt{49-{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{\\sqrt{49-{x}^{2}}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{49\\cdot (1-{x}^{2}/49)}}\\,\\text{d}x \\\\  & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-{x}^{2}/49}}\\,\\text{d}x \\\\  & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-(x/7)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{7})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{7}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{7}\\,⟹\\,\\text{d}x=7\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{\\sqrt{49-{x}^{2}}}\\,\\text{d}x & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-(x/7)^{2}}}\\,\\text{d}x \\\\  & =\\frac{3}{7}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (7\\,\\text{d}u) \\\\  & =3\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =3\\operatorname{arcsin}⁡u+C \\\\  & =3\\operatorname{arcsin}⁡(\\frac{x}{7})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b38da3-5f2b-5083-b082-6baa6d33f014" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186247658} {:answer/id #uuid "812bcd0b-19c0-5f1f-bc5e-f010128ff079" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248565} {:answer/id #uuid "990243d0-e530-5c29-873f-06195a661663" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248789} {:answer/id #uuid "9987c0f9-6105-5ebc-a015-774c178a4474" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186248793} {:answer/id #uuid "a00a5ad1-e697-5458-b48b-1b1317dfeb95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(x)}{5}+C" :db/id #edb/ref 17592186248850}] :answer-field/correct {:answer/id #uuid "812bcd0b-19c0-5f1f-bc5e-f010128ff079" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248565} :answer-field/id #uuid "b9cd7cdb-bf34-5d1b-afd1-7a3df6dc3414" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249992}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b2f614f9-7ab2-5976-a519-b4171e38a53c" :question/math-academy-id "q-114022" :question/problem "Calculate $\\int \\frac{5}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x & =5\\int \\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =5\\cdot \\frac{1}{5}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(5x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae94c5a-4c0e-5d18-8e16-ca2223f1d464" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247517} {:answer/id #uuid "8779f6eb-94c4-53a0-ab68-b0042bb9935b" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248636} {:answer/id #uuid "8f996840-de58-519e-9ad5-b2271f08b943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{36}\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248702} {:answer/id #uuid "a7a73405-8896-5d3b-959c-d98a3a0bf6d6" :answer/type {:db/ident :answer.type/math} :answer/value "36\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248915} {:answer/id #uuid "dd1ebfa7-4b17-5af2-bcf2-93117f7bdcce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186249385}] :answer-field/correct {:answer/id #uuid "8f996840-de58-519e-9ad5-b2271f08b943" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{36}\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248702} :answer-field/id #uuid "d1111c22-992f-5424-8973-a294870d0e57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250033}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "49cf1e17-5602-5d73-b695-bcf78c6bba28" :question/math-academy-id "q-114023" :question/problem "Calculate $\\int \\frac{1}{6\\sqrt{1-36{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $36{x}^{2}=(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{6\\sqrt{1-36{x}^{2}}}\\,\\text{d}x & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-(6x)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{36}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{36}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{36}\\operatorname{arcsin}⁡(6x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cd4706-704b-5191-9295-cd464731fc6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247445} {:answer/id #uuid "3a38ccf5-fcac-5430-8dfa-c7d60a37aa2f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186247939} {:answer/id #uuid "4c9e9d8f-89aa-55a3-97cf-08796f3a38a7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186248109} {:answer/id #uuid "8f55739b-0baf-52ac-867b-fcfbf2995448" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248699} {:answer/id #uuid "bff3e8f2-1813-5dfd-b250-2a81a2e1016b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249130}] :answer-field/correct {:answer/id #uuid "bff3e8f2-1813-5dfd-b250-2a81a2e1016b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249130} :answer-field/id #uuid "66b8014f-e254-5931-890e-409b4231ae26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249851}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f4bd8aa-6ac8-5557-b597-a73e9dcdaedc" :question/math-academy-id "q-114024" :question/problem "Calculate $\\int \\frac{4}{\\sqrt{1-2{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $2{x}^{2}=(\\sqrt{2}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{\\sqrt{1-2{x}^{2}}}\\,\\text{d}x & =4\\int \\frac{1}{\\sqrt{1-(\\sqrt{2}x)^{2}}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\frac{4}{\\sqrt{2}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{4\\sqrt{2}}{2}\\operatorname{arcsin}⁡u+C \\\\  & =2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c68f15c-76dd-5da9-8a8c-db134c0b26d5" :answer/type {:db/ident :