\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d1c680b-da3e-532e-b768-23a73eed1830" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248115} {:answer/id #uuid "76b64e00-cc9d-56bb-96a5-6ed308000d0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x}{\\sqrt{2}})+C" :db/id #edb/ref 17592186248469} {:answer/id #uuid "81a2d087-34bd-5b98-b3f9-540414b7de9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248571} {:answer/id #uuid "a16a9266-9795-55dc-8015-252092435b4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248867} {:answer/id #uuid "f738a875-32bb-5a84-9c85-9b96cb51105b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249583}] :answer-field/correct {:answer/id #uuid "81a2d087-34bd-5b98-b3f9-540414b7de9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248571} :answer-field/id #uuid "1add6643-9b56-5600-a0e9-cb809f1a9078" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249716}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "087bd91d-1f6c-594e-8ca6-46ed6f38b1d4" :question/math-academy-id "q-114052" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{2{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{2{x}^{2}-1}}=\\int \\frac{\\sqrt{2}}{|\\sqrt{2}x|\\sqrt{(\\sqrt{2}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{2}x.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{2{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{2}}{|\\sqrt{2}x|\\sqrt{(\\sqrt{2}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{2}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\sqrt{2}\\cdot \\frac{1}{\\sqrt{2}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f7223b-3eec-5940-8deb-7bc6e19cac0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186247868} {:answer/id #uuid "3d76b2e3-b64f-5ff7-9e80-9f8479c9c899" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247967} {:answer/id #uuid "9bd42595-09d2-528a-bd27-8cbc87ecbf1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248810} {:answer/id #uuid "def281e2-ae26-5545-95a5-a8332aa49347" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(3x)+C" :db/id #edb/ref 17592186249402} {:answer/id #uuid "f9f3a636-5c31-5b0d-9342-5cf8e8d5dd79" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186249601}] :answer-field/correct {:answer/id #uuid "3d76b2e3-b64f-5ff7-9e80-9f8479c9c899" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{3}x)+C" :db/id #ed