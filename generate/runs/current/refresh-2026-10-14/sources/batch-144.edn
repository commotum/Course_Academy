 & 2 & -1 \\\\ -1 & 0 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $2$nd, and $3$rd rows of $A$ are $-7$, $5$, and $3$, respectively.\n\n$$\nA=\\begin{bmatrix}0 & -7 & 2 & 0 \\\\ 0 & 0 & 5 & 6 \\\\ 3 & 0 & 2 & -1 \\\\ -1 & 0 & 0 & 1\\end{bmatrix}\n$$\n\nSo, the answer is $-7+5+3=1.$"} {:db/id #edb/ref 17592186413823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af01445c-3d84-5d24-87a3-64223a7372ab" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186413810} {:answer/id #uuid "ba88dc80-baa7-5c24-9c66-3bc2e7c87798" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186413811} {:answer/id #uuid "d4778d8a-14c7-5354-8674-e0b3a10d2f71" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186413813} {:answer/id #uuid "da23471b-f798-5486-86af-971ad557716d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186413814} {:answer/id #uuid "de9eacf8-6e58-5082-9700-9ef1eaea5160" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186413816}] :answer-field/correct {:answer/id #uuid "da23471b-f798-5486-86af-971ad557716d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186413814} :answer-field/id #uuid "9abb4bdb-6a2c-505b-9dc2-250a89af5226" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413820}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "43229055-b652-5005-bf91-54dcfc3e2941" :question/math-academy-id "q-129206" :question/problem "What is the sum of the leading entries of the $1$st, $3$rd, and $4$th rows in the matrix $A,$ given below?\n\n$$\nA=\\begin{bmatrix}0 & 0 & 0 & -6 \\\\ 4 & 1 & 4 & -9 \\\\ 0 & 4 & -3 & 7 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $3$rd, and $4$th rows of $A$ are $-6$, $4$, and $1$, respectively.\n\n$$\nA=\\begin{bmatrix}0 & 0 & 0 & -6 \\\\ 4 & 1 & 4 & -9 \\\\ 0 & 4 & -3 & 7 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}\n$$\n\nSo, the answer is $-6+4+1=-1.$"}] :knowledge-point/title "Identifying the Leading Entries of a Matrix"}]}
