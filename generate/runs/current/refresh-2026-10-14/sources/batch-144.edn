db/ref 17592186459960}] :answer-field/correct {:answer/id #uuid "213dd0db-1f16-57b8-a75a-94405f576b31" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459960} :answer-field/id #uuid "c1992ae7-8a06-5253-8bae-a159ecd12de1" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460846} {:answer-field/choices [{:answer/id #uuid "93932082-4e2a-5d11-9338-3badee54015f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459961} {:answer/id #uuid "3337fae3-8c3b-5ced-a2fe-a0e0b650426e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459962}] :answer-field/correct {:answer/id #uuid "3337fae3-8c3b-5ced-a2fe-a0e0b650426e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459962} :answer-field/id #uuid "da567c2d-7ca3-5ce0-9d1f-676b0894d8d6" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460847}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "181e77e0-d595-5539-baef-b4986d4c678b" :question/math-academy-id "q-42024" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 7 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 4\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 3 & 6 & 12 \\\\ 0 & 0 & 4 & 8 \\\\ 0 & 0 & 0 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 & 0 & 0 & 3 & 9 \\\\ 0 & 0 & 2 & 5 & 8 & 0 \\\\ 0 & 0 & 0 & 0 & 1 & 3\\end{bmatrix}.\n$$\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 7 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 4\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & 3 & 6 & 12 \\\\ 0 & 0 & 4 & 8 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}1 & 0 & 0 & 0 & 3 & 9 \\\\ 0 & 0 & 2 & 5 & 8 & 0 \\\\ 0 & 0 & 0 & 0 & 1 & 3\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186129778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3496ac3-8437-5e13-847a-9b80a3c3fb91" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186128150} {:answer/id #uuid "b5f43b8e-4ecc-5971-b43f-437aad51b4d8" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186128151} {:answer/id #uuid "034a1eb6-4a74-5fca-831a-b2bb6a34a1bd" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186128152} {:answer/id #uuid "081a0215-3eb3-5aa3-82ad-22c32b803f03" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186128153} {:answer/id #uuid "30e6f031-8d50-57de-b491-2b8b783102ea" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186128154}] :answer-field/id #uuid "c1a50c50-2b60-57e8-b02f-bbbfaf5e7c4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128149}] :question/id #uuid "d19d6145-1fb1-5d51-b074-044e9b77aefd" :question/math-academy-id "q-42369" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$A = \\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}, B 