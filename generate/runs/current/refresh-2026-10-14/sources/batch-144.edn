swer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262196}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "03af429b-e04f-5720-9b8e-95f1a130559b" :question/math-academy-id "q-129204" :question/problem "What is the sum of the leading entries of the $1$st, $2$nd, and $3$rd rows in the matrix $A,$ given below?\n\n$$\nA=\\begin{bmatrix}0 & -3 & 0 & 4 \\\\ 0 & 0 & 5 & 2 \\\\ 2 & -1 & 0 & 7 \\\\ 0 & 1 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $2$nd, and $3$rd rows of $A$ are $-3$, $5$, and $2$, respectively.\n\n$$\nA=\\begin{bmatrix}0 & -3 & 0 & 4 \\\\ 0 & 0 & 5 & 2 \\\\ 2 & -1 & 0 & 7 \\\\ 0 & 1 & 0 & 1\\end{bmatrix}\n$$\n\nSo, the answer is $-3+5+2=4.$"} {:db/id #edb/ref 17592186262982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05056a18-4a1b-56ae-9146-37d93d4da44e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186259919} {:answer/id #uuid "451296a8-2e61-5d47-8055-fd2de5f6c91d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260477} {:answer/id #uuid "6b84f4a2-59c1-5935-a422-553cc994364d" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186260818} {:answer/id #uuid "869ab7b5-7cad-5b9e-9de0-d89be84e8872" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186261046} {:answer/id #uuid "d9d61cb2-14f3-56af-be73-a0630a967f9d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261799}] :answer-field/correct {:answer/id #uuid "d9d61cb2-14f3-56af-be73-a0630a967f9d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186261799} :answer-field/id #uuid "07283908-15b1-50dd-b795-a6cb15c3b636" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262137}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d744cee3-f932-562f-a8e4-3c888c5140d9" :question/math-academy-id "q-129209" :question/problem "What is the sum of the leading entries of the $1$st and $4$th rows in the matrix $A,$ given below?\n\n$$\nA=\\begin{bmatrix}0 & -4 & 1 & 0 \\\\ -9 & 2 & 0 & 0 \\\\ 8 & 9 & -8 & 8 \\\\ 0 & 0 & 9 & -1\\end{bmatrix}\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st and $4$th rows of  $A$ are $-4$ and $9$, respectively.\n\n$$\nA=\\begin{bmatrix}0 & -4 & 1 & 0 \\\\ -9 & 2 & 0 & 0 \\\\ 8 & 9 & -8 & 8 \\\\ 0 & 0 & 9 & -1\\end{bmatrix}.\n$$\n\nSo, the answer is $-4+9=5.$"} {:db/id #edb/ref 17592186262984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b07e7c-2479-5481-937b-546fce0e0e8b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186259883} {:answer/id #uuid "1c6d52d6-d447-5c0f-9c71-fcb0e8a001a5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260117} {:answer/id #uuid "285f2214-448b-5089-ae68-6e048bb1990d" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186260231} {:answer/id #uuid "3c77c35d-6640-587e-aeb3-93289e676dad" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186260414} {:answer/id #uuid "73c95cbf-6292-5e82-9eab-f55a95dae78b" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260887}] :answer-field/correct {:answer/id #uuid "1c6d52d6-d447-5c0f-9c71-fcb0e8a001a5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186260117} :answer-field/id #uuid "21d42879-c7d2-5273-8c7e-dd23e55a86e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 1