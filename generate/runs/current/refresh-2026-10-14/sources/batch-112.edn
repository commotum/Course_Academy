:answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186339922} {:answer/id #uuid "6bbc5f38-16b9-57ee-a58b-64b2d5ef36e7" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186340083} {:answer/id #uuid "eec38fc4-d48a-5e6e-8931-f06a7a864ae4" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186341234} {:answer/id #uuid "eed401bf-7466-5857-a56b-834def403b2e" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186341236}] :answer-field/correct {:answer/id #uuid "eec38fc4-d48a-5e6e-8931-f06a7a864ae4" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186341234} :answer-field/id #uuid "53154123-fac5-56a4-af6a-e5b7c7ec264f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341530}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67b1cc06-52db-594d-af64-fc96a02b017c" :question/math-academy-id "q-73653" :question/problem "What is the value of ${\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x & =4{\\int }_{1}^{4}{log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =2\\operatorname{ln}⁡4\\cdot (1-0) \\\\  & =2\\operatorname{ln}⁡4 \\\\  & =4\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164d03a7-1370-51a6-8397-ae3a37ee3435" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186339325} {:answer/id #uuid "59a89007-afad-59e1-97c9-f01d389bf291" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186339943} {:answer/id #uuid "9266fee0-0299-5561-8066-c587641ef39a" :answer/type {:db/ident :answer.type/math} :answer/value "8{ln}^{2}⁡2" :db/id #edb/ref 17592186340441} {:answer/id #uuid "a3158c6c-e82d-594c-bf87-7aa6ded323cd" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186340606} {:answer/id #uuid "c4b063ef-7d2e-5c4b-99bd-f6ee337f7b43" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡2" :db/id #edb/ref 17592186340876}] :answer-field/correct {:answer/id #uuid "a3158c6c-e82d-594c-bf87-7aa6ded323cd" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186340606} :answer-field/id #uuid "083ceb34-fb13-5d1c-8ff1-ed4f8fdff6b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341398}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "46fc463a-0e37-5adb-8efe-657661cd9784" :question/math-academy-id "q-73655" :question/problem "What is the value of ${\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $16$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x & =2{\\int }_{2}^{4}\\frac{1}{{log}_{4}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡4\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡({2}^{2})\\operatorname{ln}⁡2 \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eafeb14-c8c5-545b-a26c-84a8ffdb3bb1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\operatorname{ln}⁡8}" :db/id #edb/ref 17592186339540} {:answer/id #uuid "31f0df20-fa82-5df5-ac98-2f11e0f712be" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186339567} {:answer/id #uuid "453ac55b-b5ef-5bd9-ab47-2d658db0c581" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\operatorname{ln}⁡8" :db/id #edb/ref 17592186339742} {:answer/id #uuid "66afc99b-c4df-5906-b1f4-1abfb6ca13c5" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340031} {:answer/id #uuid "997973b5-0aa4-5755-be92-64594db4e075" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\sqrt{2})\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340513}] :answer-field/correct {:answer/id #uuid "66afc99b-c4df-5906-b1f4-1abfb6ca13c5" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340031} :answer-field/id #uuid "246f92ed-b4b3-5d28-a1bf-1d986ab28138" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341443}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3ddbff7e-d3cb-563f-8731-6916af8ccc56" :question/math-academy-id "q-73656" :question/problem "What is the value of ${\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $8$ | $64$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x & ={\\int }_{8}^{64}\\frac{1}{\\sqrt{{log}_{8}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8{\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8(2\\sqrt{u}){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡8(\\sqrt{2}-\\sqrt{1}) \\\\  & =2(\\sqrt{2}-1)\\operatorname{ln}⁡8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba9b513-fd9e-5532-ac97-f39096b6d80d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡7" :db/id #edb/ref 17592186339229} {:answer/id #uuid "5146b66f-c081-5a5d-8a49-9465f6a29017" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}" :db/id #edb/ref 17592186339874} {:answer/id #uuid "6f33def5-e388-5e0c-8e27-ef1debc47437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186340114} {:answer/id #uuid "f3b7ff34-6e45-5d0f-881a-f864fd3aefad" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7" :db/id #edb/ref 17592186341276} {:answer/id #uuid "fc039a6e-3ced-5554-821f-11c2bfcbf96a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡7" :db/id #edb/ref 17592186341355}] :answer-field/correct {:answer/id #uuid "6f33def5-e388-5e0c-8e27-ef1debc47437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186340114} :answer-field/id #uuid "71a8e5ea-7823-5b4d-bd7c-7ee99e3470da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341575}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f9fa12f0-8b86-59fd-acb9-b45aae5f88d9" :question/math-academy-id "q-73658" :question/problem "What is the value of ${\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{7}⁡(\\frac{x}{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡7}\\cdot \\frac{1}{3}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $21$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x & ={\\int }_{3}^{21}{log}_{7}⁡(\\frac{x}{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot (1-0) \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c85c552c-0ff1-5148-a4d2-342abba93768" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{{log}_{3}⁡x}" :db/id #edb/ref 17592186374619} {:answer/id #uuid "e786ce68-d2d1-5eff-b775-2083018f9df2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186374620} {:answer/id #uuid "8509899d-a879-55ba-9bde-472de5ff5912" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{2}" :db/id #edb/ref 17592186374621} {:answer/id #uuid "e73eeb00-dc7c-5cf8-af46-0b97a4a94f3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{3}" :db/id #edb/ref 17592186374622} {:answer/id #uuid "1c419824-ebeb-53f2-b58f-f2ebd505e783" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186374623}] :answer-field/correct {:answer/id #uuid "e786ce68-d2d1-5eff-b775-2083018f9df2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186374620} :answer-field/id #uuid "2c6f018d-495b-531f-bd03-e442b877a27d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374618}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "46f01b36-965c-5aab-a0e7-c33b421d2a82" :question/math-academy-id "q-31588" :question/problem "What is the value of ${\\int }_{1}^{3}\\frac{{log}_{3}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{{log}_{3}⁡x}{x}\\,\\text{d}x & ={\\int }_{1}^{3}{log}_{3}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\operatorname{ln}⁡3\\cdot (\\frac{{1}^{2}}{2}-\\frac{{0}^{2}}{2}) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1edf87b-ed45-5304-b224-31e9ec542b58" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186374626} {:answer/id #uuid "2943b0e0-33c3-5ccc-aa84-ab39c1960224" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186374627} {:answer/id #uuid "d6187747-e0a4-5fee-8cd9-05c678a121a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{24}" :db/id #edb/ref 17592186374628} {:answer/id #uuid "690317d0-3209-5ddb-94c9-c1a622a766f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186374629} {:answer/id #uuid "5a24c986-898e-54c0-b365-6f458b7c7959" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186374630}] :answer-field/correct {:answer/id #uuid "690317d0-3209-5ddb-94c9-c1a622a766f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186374629} :answer-field/id #uuid "ab434a47-b415-5d71-8685-330d0dcab9c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374625}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8e40beb0-a519-50d4-b251-d1345097fb54" :question/math-academy-id "q-31590" :question/problem "What is the value of ${\\int }_{e}^{{e}^{2}}\\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{e}^{{e}^{2}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {\\frac{{u}^{2}}{2}|}_{1}^{2} \\\\  & =\\frac{1}{4}\\cdot {{u}^{2}|}_{1}^{2} \\\\  & =\\frac{1}{4}({2}^{2}-{1}^{2}) \\\\  & =\\frac{1}{4}(3) \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7f5c99e-9a37-5820-a1ca-cf048d293561" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375066}] :answer-field/correct {:answer/id #uuid "e7f5c99e-9a37-5820-a1ca-cf048d293561" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375066} :answer-field/id #uuid "49d84293-79fe-5d8a-8714-af649008e9a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375065}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7909088b-942e-5c28-83d7-5489395899d0" :question/math-academy-id "q-350209" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}\\frac{3\\sqrt{\\operatorname{ln}⁡x}}{x}\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{3\\sqrt{\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & =3{\\int }_{1}^{e}\\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{1}\\sqrt{u}\\,\\text{d}u \\\\  & =3{\\int }_{0}^{1}{u}^{1/2}\\,\\text{d}u \\\\  & =3\\cdot \\frac{{u}^{3/2}}{3/2}\\,{|}_{0}^{1} \\\\  & =2\\cdot {u}^{3/2}\\,{|}_{0}^{1} \\\\  & =2({1}^{3/2}-{0}^{3/2}) \\\\  & =2(1-0) \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b922c00-fec0-5e92-b344-12d9b0a9d88e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186375069}] :answer-field/correct {:answer/id #uuid "9b922c00-fec0-5e92-b344-12d9b0a9d88e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186375069} :answer-field/id #uuid "b4f0da75-3954-585b-bedf-4f0ec53da429" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375068}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a467975c-198b-531b-975f-70d1e6e0a17e" :question/math-academy-id "q-351282" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}\\frac{4\\operatorname{ln}⁡({x}^{3})}{5x}\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{3}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{3}}\\cdot 3{x}^{2}=\\frac{3}{x}\\,⟹\\,\\frac{1}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{4\\operatorname{ln}⁡({x}^{3})}{5x}\\,\\text{d}x & =\\frac{4}{5}{\\int }_{1}^{e}\\operatorname{ln}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{4}{5}{\\int }_{0}^{3}u\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{4}{15}{\\int }_{0}^{3}u\\,\\text{d}u \\\\  & =\\frac{4}{15}\\cdot {\\frac{{u}^{2}}{2}|}_{0}^{3} \\\\  & =\\frac{4}{15}\\cdot \\frac{9}{2} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eab9d45b-a0c0-5418-a203-0aba7763da28" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186375072}] :answer-field/correct {:answer/id #uuid "eab9d45b-a0c0-5418-a203-0aba7763da28" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186375072} :answer-field/id #uuid "eb1fc348-9d4d-5007-8914-af996cd84800" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375071}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1a82fa79-cd38-52c8-bdda-6f1fd4a33aa2" :question/math-academy-id "q-351286" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{2}^{8}\\frac{{log}_{2}⁡(2x)}{x}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" :question/worked-solution "Let $u={log}_{2}⁡(2x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x\\operatorname{ln}⁡2}\\cdot 2=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $8$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{8}\\frac{{log}_{2}⁡(2x)}{x}\\,\\text{d}x & ={\\int }_{2}^{8}{log}_{2}⁡(2x)\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{4}u\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{u}^{2}}{2}{|}_{2}^{4} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡2(16-4) \\\\  & =(6)\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21c7787a-31a6-57b0-b969-bd5a3135ac96" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375344} {:answer/id #uuid "ea54053a-6425-5e9e-9a77-4524ffd6d1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375345} {:answer/id #uuid "d4d2f994-5b9c-5919-a4e1-d619a8e6da32" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡8" :db/id #edb/ref 17592186375346} {:answer/id #uuid "1c809f7d-d7ef-5008-a293-5216d4ae0256" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375347} {:answer/id #uuid "e0158386-27f6-5854-8b7c-bf137f533a07" :answer/type {:db/ident :answer.type/math} :answer/value "3{ln}^{2}⁡8" :db/id #edb/ref 17592186375348}] :answer-field/correct {:answer/id #uuid "ea54053a-6425-5e9e-9a77-4524ffd6d1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375345} :answer-field/id #uuid "0cf307e2-aa61-5c5c-9a35-cb1835a62040" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375343}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1db700ab-3b05-5d1d-a411-1cbed80c9e6b" :question/math-academy-id "q-73657" :question/problem "What is the value of ${\\int }_{1}^{2}\\frac{6{log}_{8}⁡(2x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡(2x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x\\operatorname{ln}⁡8}\\cdot 2=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1/3$ | $2/3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{6{log}_{8}⁡(2x)}{x}\\,\\text{d}x & =6{\\int }_{1}^{2}{log}_{8}⁡(2x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =6{\\int }_{1/3}^{2/3}u\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =6\\operatorname{ln}⁡8{\\int }_{1/3}^{2/3}u\\,\\text{d}u \\\\  & =6\\operatorname{ln}⁡8\\cdot \\frac{{u}^{2}}{2}{|}_{1/3}^{2/3} \\\\  & =3\\operatorname{ln}⁡8\\cdot (\\frac{4}{9}-\\frac{1}{9}) \\\\  & =\\operatorname{ln}⁡8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186441900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4403caea-cd74-51a9-b79d-725521c1723f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186441878} {:answer/id #uuid "53d5b4d4-65c5-534f-b5bf-9a4d54b10bf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441880} {:answer/id #uuid "74dd2751-1a10-5b13-a07e-4a1b5ceee5f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡4" :db/id #edb/ref 17592186441882} {:answer/id #uuid "d0c5c72a-52a6-527f-9089-d3942f82a598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{5}" :db/id #edb/ref 17592186441888} {:answer/id #uuid "fa48eb2e-b23d-5975-8ee4-2650534bd1bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡4}{5}" :db/id #edb/ref 17592186441894}] :answer-field/correct {:answer/id #uuid "d0c5c72a-52a6-527f-9089-d3942f82a598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{5}" :db/id #edb/ref 17592186441888} :answer-field/id #uuid "5e5e2b78-7327-5ca0-90fb-487bdfff6019" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186441895}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d724ae77-2273-56ab-852e-2415e473e7f8" :question/math-academy-id "q-13840" :question/problem "Evaluate the integral ${\\int }_{e}^{{e}^{2}}\\frac{2}{5x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{2}{5x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{e}^{{e}^{2}}\\frac{2}{x\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{5}{\\int }_{2}^{4}\\frac{2}{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{5}{\\int }_{2}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡|u|){|}_{2}^{4} \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡4-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡{2}^{2}-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}(2\\operatorname{ln}⁡2-\\operatorname{ln}⁡2) \\\\  & =\\frac{\\operatorname{ln}⁡2}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b7494e-bb79-5b12-9236-a587f999330d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489565} {:answer/id #uuid "1b976c74-2288-5edb-ac14-b1435c6814f0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489578} {:answer/id #uuid "4a39aa0a-e274-5fb2-8704-b394c3cd5dd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186489687} {:answer/id #uuid "65a94067-f449-5e05-8e2b-89087734bd4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489754} {:answer/id #uuid "7c3b6154-88e4-5ca3-9c7b-ddeffecf3bd3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489798}] :answer-field/correct {:answer/id #uuid "7c3b6154-88e4-5ca3-9c7b-ddeffecf3bd3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489798} :answer-field/id #uuid "3273c5e4-90f1-5aee-9f26-60f52ccd89f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490099}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "29e8aaaf-e383-5b29-a6be-9cfefb451c7a" :question/math-academy-id "q-31616" :question/problem "What is the value of ${\\int }_{5}^{25}\\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $25$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{25}\\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3{\\int }_{5}^{25}\\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =3\\operatorname{ln}⁡5(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =3\\operatorname{ln}⁡2\\operatorname{ln}⁡5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "588a64f8-b007-597a-90a1-13bc0deadb69" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{ln}⁡3)" :db/id #edb/ref 17592186489726} {:answer/id #uuid "58d74548-f1c5-5c19-af0c-64a5b689a324" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489727} {:answer/id #uuid "64f36bf8-3759-5b50-8859-73b64d5b2c38" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{2}⁡3\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489752} {:answer/id #uuid "ae420e08-ae64-53a3-b2a8-a61252329c53" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489897} {:answer/id #uuid "fba1a44c-3ac0-56fc-b34d-91572dd0f45a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186490061}] :answer-field/correct {:answer/id #uuid "58d74548-f1c5-5c19-af0c-64a5b689a324" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489727} :answer-field/id #uuid "1e61d7a6-a656-53b9-8d80-257f6bbc76cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490088}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "43a38f2f-26ab-5a55-9c36-de9ec5e565a5" :question/math-academy-id "q-31615" :question/problem "What is the value of ${\\int }_{4}^{8}\\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $8$ |\n| --- | --- | --- |\n| $u$ | $2$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{8}\\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & ={\\int }_{4}^{8}\\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{3}\\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2(\\operatorname{ln}⁡|u|){|}_{2}^{3} \\\\  & =\\operatorname{ln}⁡2\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59077802-2ece-52ce-8fdb-8f6f3735b72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489730} {:answer/id #uuid "da84991b-fcac-5426-a689-60bfacfa87a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489996} {:answer/id #uuid "df6c29bc-d773-5ece-9a45-14b4359b35cd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489999} {:answer/id #uuid "eed896f0-f769-50fb-a53d-7bc14aff6cc3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490029} {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032}] :answer-field/correct {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032} :answer-field/id #uuid "a108c977-d111-5123-bfa0-9f9dd2b6376b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490166}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "633f13a2-1c12-5a0e-ade7-b4d04e14c842" :question/math-academy-id "q-13844" :question/problem "What is the value of ${\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡8$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{2}\\frac{1}{(\\operatorname{ln}⁡(4x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {(-{u}^{-1})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}\\cdot {(\\frac{1}{u})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡8}-\\frac{1}{\\operatorname{ln}⁡4}) \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡{2}^{3}}-\\frac{1}{\\operatorname{ln}⁡{2}^{2}}) \\\\  & =-\\frac{3}{2}(\\frac{1}{3\\operatorname{ln}⁡2}-\\frac{1}{2\\operatorname{ln}⁡2}) \\\\  & =-\\frac{3}{2}(-\\frac{1}{6\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{4\\operatorname{ln}⁡2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6a9f60-c08f-5467-a283-a5c875e998cb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186489583} {:answer/id #uuid "311cb6a0-4004-536b-aff8-04d49cb5cc24" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489625} {:answer/id #uuid "abe6da9b-8429-54a3-ba90-b2deefe451bc" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186489892} {:answer/id #uuid "f50f90e5-5553-5d0c-bfdb-c4fbba7c5236" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490044} {:answer/id #uuid "fc4aa3c7-4608-5feb-8e43-09317d7d8264" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490064}] :answer-field/correct {:answer/id #uuid "f50f90e5-5553-5d0c-bfdb-c4fbba7c5236" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490044} :answer-field/id #uuid "b8df4958-daa0-55e3-96a1-d8edb4b2bd89" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490173}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ee507cc2-c5c1-5dca-b8f8-28391520da63" :question/math-academy-id "q-49552" :question/problem "What is the value of ${\\int }_{e/4}^{{e}^{3}/4}\\frac{3}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡4x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/4$ | ${e}^{3}/4$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e/4}^{{e}^{3}/4}\\frac{3}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =3{\\int }_{e/4}^{{e}^{3}/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =3(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =3(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =3\\operatorname{ln}⁡3\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating Definite Integrals"}] [{:db/id #edb/ref 17592186138429 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138084 :question/id #uuid "86771ced-afc0-5061-a532-bc2345a52ea8" :question/math-academy-id "e-13130" :question/problem "![](images/09/0915c99015922e27855d92ebb13756da634a8f10dd8fe3abbc016590f06e1077.png)\n\nThe graph above shows the number of liters of water in pool $A$ and pool $B$ as a function of time, measured in days. How many days will it take for both pools to contain the same amount of water?" :question/worked-solution "The pools have the same amount of water when the two graphs intersect.\n\n![](images/cf/cf7a9b8bdccbc66086c473813523ed893ee192830965300a8c4a0702ad065fc3.png)\n\nIn this case, we have the point $(5,400).$ So, both pools have the same amount ($400\\,\\textrm{L}$) of water at $t=5$ days."} :knowledge-point/id #uuid "4154d81b-c94a-57f7-80fa-0daa341505e6" :knowledge-point/questions [{:db/id #edb/ref 17592186138783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2e689cf-e055-5aba-b4d2-3b11b04d1e2e" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186135647} {:answer/id #uuid "ec1c3419-1155-5170-be6d-98f1b0176672" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186135648} {:answer/id #uuid "1a814fda-9d35-5744-9906-6c0a6c7069a5" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186135649} {:answer/id #uuid "1c5ebb6d-5110-56a4-bd41-59743682fc49" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186135650} {:answer/id #uuid "3532a08a-d9a7-524b-ae88-f0c36f56f4ec" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186135651}] :answer-field/id #uuid "0609360b-f7ba-52dd-a7b8-807f5c237c61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135646}] :question/id #uuid "10d6cebb-53da-57a8-b24b-2a1a1f8f0163" :question/math-academy-id "q-45165" :question/problem "![](images/0d/0d5e3ef2393a00fc74c91ebc44f71d553e641d0e1bca21bf783252cbafcca84c.png)\n\nThe graph above shows the speed of cars $A$ and $B$ as a function of the distance that they traveled during a brake test. At which distance, in meters, did both cars reach the same speed?"} {:db/id #edb/ref 17592186139116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8337461-4342-5b9c-8484-145234157d30" :answer/type {:db/ident :answer.type/math} :answer/value "3h" :db/id #edb/ref 17592186137645} {:answer/id #uuid "fac79086-a744-5542-af8a-0dc08066528c" :answer/type {:db/ident :answer.type/math} :answer/value "6h" :db/id #edb/ref 17592186137646} {:answer/id #uuid "457e9b7f-b0e1-5c8a-85f7-66a18dd92b73" :answer/type {:db/ident :answer.type/math} :answer/value "5h" :db/id #edb/ref 17592186137647} {:answer/id #uuid "65a7608d-9c83-510d-a732-df0fa09b2c61" :answer/type {:db/ident :answer.type/math} :answer/value "2h" :db/id #edb/ref 175921861