b/id #edb/ref 17592186276347} {:answer/id #uuid "c6e6df92-0fe0-52bf-ad68-64d6651fef07" :answer/type {:db/ident :answer.type/math} :answer/value "y+\\frac{2x}{y}" :db/id #edb/ref 17592186277246}] :answer-field/correct {:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id #edb/ref 17592186275720} :answer-field/id #uuid "9501b870-d0cb-5b61-aa64-68a74b0b08a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277990}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c020eea-053d-5f14-b5a2-c9f697a99828" :question/math-academy-id "q-159613" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=xy+{x}^{2}\\operatorname{ln}⁡y.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =\\frac{∂}{∂y}(xy)+\\frac{∂}{∂y}({x}^{2}\\operatorname{ln}⁡y) \\\\  & =x\\cdot \\frac{∂}{∂y}(y)+{x}^{2}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y) \\\\  & =x\\cdot 1+{x}^{2}\\cdot \\frac{1}{y} \\\\  & =x+\\frac{{x}^{2}}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb6e91c-e353-5113-a18f-0395e4a6e343" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{y}^{2}}+\\frac{2}{{x}^{3}}" :db/id #edb/ref 17592186276032} {:answer/id #uuid "4118aa52-6cf2-5999-9929-8a5819037289" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276047} {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} {:answer/id #uuid "ebaecd0a-b971-5e92-b62d-28ceae190dc8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{{y}^{2}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186277539} {:answer/id #uuid "f0a09a6f-356b-5b97-85dc-4fbfa42ac95a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}-\\frac{y}{{x}^{2}}" :db/id #edb/ref 17592186277589}] :answer-field/correct {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id #edb/ref 17592186276416} :answer-field/id #uuid "e473ea39-99a3-5f5a-9eb6-13ee0b150617" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278125}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "198d06c9-ec80-5c14-815c-c9ec68f7a2d2" :question/math-academy-id "q-159616" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=\\frac{x}{y}-\\frac{y}{{x}^{2}}.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the constant multiple rule for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y}-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{y})-\\frac{∂}{∂x}(\\frac{y}{{x}^{2}}) \\\\  & =\\frac{1}{y}\\cdot \\frac{∂}{∂x}(x)-y\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{2}}) \\\\  & =\\frac{1}{y}\\cdot (1)-y\\cdot (-\\frac{2}{{x}^{3}}) \\\\  & =\\frac{1}{y}+\\frac{2y}{{x}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186275545} {:answer/id #uuid "2959b683-8721-5d47-ae28-bfdae8458730" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}-16y" :db/id #e