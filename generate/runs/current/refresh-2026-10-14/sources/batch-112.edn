\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{e}\\operatorname{ln}⁡(4x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e}u\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {\\frac{{u}^{2}}{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & ={\\frac{3}{4}\\cdot {u}^{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & =\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} {:answer/id #uuid "78b9a284-7918-5a48-9b63-09d2dbf15a7d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267206} {:answer/id #uuid "c324f604-f021-5ec4-97d6-e46d27f5780b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡4" :db/id #edb/ref 17592186267886} {:answer/id #uuid "f349a50e-2135-5759-85b8-7bfb21768dc7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268308} {:answer/id #uuid "f3e8bc1f-2171-58ab-a46f-699ee9e27a89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268311}] :answer-field/correct {:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} :answer-field/id #uuid "a5268c76-ac42-5d62-8149-d9e09487a8d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268701}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ed857a50-0096-5fa3-bea2-e4ec1bd8cccb" :question/math-academy-id "q-13845" :question/problem "What is the value of ${\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e/4$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =\\frac{1}{4}{\\int }_{1}^{e/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}{\\int }_{\\operatorname{ln}⁡4}^{1}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡|u|){|}_{\\operatorname{ln}⁡4}^{1} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =\\frac{1}{4}(0-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd0da3d-094d-5fbb-931b-382cf883ca96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186295445} {:answer/id #uuid "5a904f2e-d51a-5abf-9629-c23b1eeaa263" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186295788} {:answer/id #uuid "5bbb6c9a-e6ec-50df-98be-50c0649c8d41" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186295795} {:answer/id #uuid "5fdceb7c-75b4-550b-9e43-434ead9f1bdc" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186295815} {:answer/id #uuid "9755583c-285b-50c4-a5fa-70b2b96ce22c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296075}] :answer-field/correct {:answer/id #uuid "9755583c-285b-50c4-a5fa-70b2b96ce22c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296075} :answer-field/id #uuid "bb9a7dd7-bdc6-5dcf-9c43-1e871e8d4d7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297023}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e4974d46-0f4e-5eb4-8954-be690c361878" :question/math-academy-id "q-31619" :question/problem "What is the value of ${\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x & =3{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(5x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot {\\frac{{u}^{1/2}}{1/2}|}_{1}^{4} \\\\  & =6\\cdot {\\sqrt{u}|}_{1}^{4} \\\\  & =6(\\sqrt{4}-\\sqrt{1}) \\\\  & =6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1431f8c9-f4af-57b3-98ac-1fc0b9479411" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{5}{2}" :db/id #edb/ref 17592186295380} {:answer/id #uuid "2559dc23-195c-5be9-bf05-24d04cf43261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186295469} {:answer/id #uuid "bcaa502b-a0c5-53a1-887c-c886eb6931bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{2}{3}" :db/id #edb/ref 17592186296260} {:answer/id #uuid "d8b954a5-2736-58ed-849a-01556eeac516" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡\\frac{x}{2}" :db/id #edb/ref 17592186296409} {:answer/id #uuid "f669c739-19e2-57ac-8224-83c10f80317d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186296578}] :answer-field/correct {:answer/id #uuid "2559dc23-195c-5be9-bf05-24d04cf43261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186295469} :answer-field/id #uuid "427dc5ae-0525-58ef-873a-f99cabbf18b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296761}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a9ace025-d2a7-57e0-b56c-f814cc5835a7" :question/math-academy-id "q-31639" :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{5x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{5x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{5}{\\int }_{2}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡|u|){|}_{2}^{3} \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06398586-1c51-546e-ba9b-fc7781b26de5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295297} {:answer/id #uuid "269c31e1-e53c-5dda-b79d-8b56f6fde233" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295476} {:answer/id #uuid "4ad9be68-7d1f-50a6-a25e-0bffd97fdc02" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295693} {:answer/id #uuid "51834b5a-e89e-5af7-b055-a18d07393528" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295737} {:answer/id #uuid "d8354e5a-3360-5329-9797-814959106481" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186296406}] :answer-field/correct {:answer/id #uuid "4ad9be68-7d1f-50a6-a25e-0bffd97fdc02" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295693} :answer-field/id #uuid "82a36094-e049-5aab-be04-713d1d5a9633" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296902}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f3473f0-efaa-5747-926c-a19ff897e0a6" :question/math-academy-id "q-31643" :question/problem "What is the value of ${\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/2$ | $1/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x & ={\\int }_{1/2}^{e/2}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(2x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}{u}^{-1/2}\\,\\text{d}u \\\\  & ={\\frac{{u}^{1/2}}{1/2}|}_{0}^{1} \\\\  & =2\\cdot {\\sqrt{u}|}_{0}^{1} \\\\  & =2(\\sqrt{1}-\\sqrt{0}) \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2562a9c9-aca4-5aab-ae8c-dfc0d8930a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|x|}{2\\sqrt{2}}" :db/id #edb/ref 17592186295470} {:answer/id #uuid "31d9ef31-5977-5a8f-86a4-f2af5b82793e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186295548} {:answer/id #uuid "4915700f-dd8e-57ab-ac0f-4d614790089c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡|x|}{\\sqrt{2}}" :db/id #edb/ref 17592186295685} {:answer/id #uuid "7b9da615-dcc8-547b-b139-e0fddd363070" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186295945} {:answer/id #uuid "9df1f497-a52a-514a-a098-e2493f3a2f1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{2\\sqrt{x}}" :db/id #edb/ref 17592186296110}] :answer-field/correct {:answer/id #uuid "31d9ef31-5977-5a8f-86a4-f2af5b82793e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186295548} :answer-field/id #uuid "5b6f305a-1541-5b71-afe2-360d801bd991" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296819}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8f30c06d-366c-59ac-9244-d2bac8160fec" :question/math-academy-id "q-31648" :question/problem "What is the value of  ${\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡2}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $4$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}{log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}u\\cdot \\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u \\\\  & =\\frac{3}{\\sqrt{2}}\\cdot \\frac{\\operatorname{ln}⁡2}{2}{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2\\sqrt{2}}\\cdot \\frac{{u}^{2}}{2}{|}_{2}^{4} \\\\  & =\\frac{3\\operatorname{ln}⁡2}{4\\sqrt{2}}\\cdot (16-4) \\\\  & =\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c47da02-0de3-57ba-80b0-c125c05b20e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{3}" :db/id #edb/ref 17592186295525} {:answer/id #uuid "4c228dda-3c12-503a-ae76-b6dbd65e3cfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{2\\sqrt{5}}" :db/id #edb/ref 17592186295701} {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} {:answer/id #uuid "cb2d8a19-1869-5d11-b6b2-5d7224310807" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296333} {:answer/id #uuid "fe9d3052-96a7-52e6-88ad-4c8dcf860d47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296624}] :answer-field/correct {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} :answer-field/id #uuid "d0467277-3365-50ac-9fc9-dd5fec40a456" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297066}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7168c66b-e063-53c6-92aa-cf6372184dec" :question/math-academy-id "q-31669" :question/problem "What is the value of ${\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡(5x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x\\operatorname{ln}⁡5}\\cdot 5=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x & =7{\\int }_{1}^{5}{log}_{5}⁡(5x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =7{\\int }_{1}^{2}u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}{|}_{1}^{2} \\\\  & =7\\operatorname{ln}⁡5\\cdot (\\frac{4}{2}-\\frac{1}{2}) \\\\  & =\\frac{21\\operatorname{ln}⁡5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc5d5dbd-ebb8-54de-b27d-1e5f671375fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{75}{8}" :db/id #edb/ref 17592186318241}] :answer-field/correct {:answer/id #uuid "cc5d5dbd-ebb8-54de-b27d-1e5f671375fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{75}{8}" :db/id #edb/ref 17592186318241} :answer-field/id #uuid "264e356f-d936-5e81-beea-c24086edca28" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318501}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b8d4df78-0e9a-508b-ae35-e42755fe5bc0" :question/math-academy-id "q-346434" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e}^{{e}^{4}}\\frac{5\\operatorname{ln}⁡x}{4x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{4}}\\frac{5\\operatorname{ln}⁡x}{4x}\\,\\text{d}x & =\\frac{5}{4}{\\int }_{e}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{1}^{4}u\\,\\text{d}u \\\\  & =\\frac{5}{4}\\cdot \\frac{{u}^{2}}{2}\\,{|}_{1}^{4} \\\\  & =\\frac{5}{8}\\cdot {u}^{2}\\,{|}_{1}^{4} \\\\  & =\\frac{5}{8}({4}^{2}-{1}^{2}) \\\\  & =\\frac{5}{8}\\cdot 15 \\\\  & =\\frac{75}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403ba02d-eba3-5591-8259-adb3276aecb5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/id #edb/ref 17592186317772}] :answer-field/correct {:answer/id #uuid "403ba02d-eba3-5591-8259-adb3276aecb5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/id #edb/ref 17592186317772} :answer-field/id #uuid "30bc48a1-0d41-5c82-b1da-321bf1b58346" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318522}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cd8052bf-7195-55ef-bdc6-284e7fea5262" :question/math-academy-id "q-346435" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $32$ |\n| --- | --- | --- |\n| $u$ | $2$ | $5$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x & ={\\int }_{4}^{32}\\frac{1}{\\sqrt{{log}_{2}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot 2\\sqrt{u}\\,{|}_{2}^{5} \\\\  & =(2\\sqrt{5}-2\\sqrt{2})\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "973c5b68-ad60-5e99-b2c9-bcdcccc2ac6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}4" :db/id #edb/ref 17592186319839}] :answer-field/correct {:answer/id #uuid "973c5b68-ad60-5e99-b2c9-bcdcccc2ac6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}4" :db/id #edb/ref 17592186319839} :answer-field/id #uuid "eea04459-9e0b-58bf-95d3-0439c072fbce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320659}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b939403-6bca-5ea1-8cdf-234c2e6cc503" :question/math-academy-id "q-351281" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x & ={\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\operatorname{ln}⁡(5x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{4} \\\\  & =\\operatorname{ln}⁡4-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bed6edcd-4615-53d1-831c-db585e0780f2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319976}] :answer-field/correct {:answer/id #uuid "bed6edcd-4615-53d1-831c-db585e0780f2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319976} :answer-field/id #uuid "d52ea3ad-2100-5f48-98bb-b1648f840777" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320603}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "61d3be96-13ed-5bf2-8f8a-0bd5779fc023" :question/math-academy-id "q-351283" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{3}^{81}\\frac{2}{x\\sqrt{{log}_{3}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡3$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $81$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{81}\\frac{2}{x\\sqrt{{log}_{3}⁡x}}\\,\\text{d}x & =2{\\int }_{3}^{81}\\frac{1}{\\sqrt{{log}_{3}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡3\\cdot (2\\sqrt{u}){|}_{1}^{4} \\\\  & =4\\operatorname{ln}⁡3(\\sqrt{4}-\\sqrt{1}) \\\\  & =4\\operatorname{ln}⁡3(2-1) \\\\  & =(4)\\operatorname{ln}⁡3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8a2fb3-0f4b-5fe7-ab34-cb4b95eae8e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}3" :db/id #edb/ref 17592186319418} {:answer/id #uuid "0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\ln 3" :db/id #edb/ref 17592186441874}] :answer-field/correct {:answer/id #uuid "0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\ln 3" :db/id #edb/ref 17592186441874} :answer-field/id #uuid "d8924e9a-12d1-532a-9e9e-b8791083cc33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "353ff421-65f8-59eb-b8ea-71a83d1ce946" :question/math-academy-id "q-351287" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x=($\n{{field-1}}\n$)\\,\\operatorname{ln}⁡5$" :question/worked-solution "Let $u={log}_{5}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡5}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡5}\\,⟹\\,\\frac{\\operatorname{ln}⁡5}{2}\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $125$ |\n| --- | --- | --- |\n| $u$ | $2$ | $6$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x & =\\frac{8}{3}{\\int }_{5}^{125}\\frac{1}{{log}_{5}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{8}{3}{\\int }_{2}^{6}\\frac{1}{u}\\cdot \\frac{\\operatorname{ln}⁡5}{2}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}{\\int }_{2}^{6}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡|u|){|}_{2}^{6} \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2) \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}\\operatorname{ln}⁡3 \\\\  & =(\\frac{4}{3}\\operatorname{ln}⁡3)\\operatorname{ln}⁡5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4161adbe-3593-51fb-aeb0-7604bab27c35" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186330530} {:answer/id #uuid "449448ac-be28-5cf5-a19f-c4898f99b10f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186330567} {:answer/id #uuid "9d3ba09d-36e9-510e-8bf1-411520149fad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186331358} {:answer/id #uuid "a5a2edd0-4861-5503-aa98-ef2925501542" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331433} {:answer/id #uuid "b4640f92-afdc-54b3-afe7-d70b32daa8e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186331544}] :answer-field/correct {:answer/id #uuid "b4640f92-afdc-54b3-afe7-d70b32daa8e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186331544} :answer-field/id #uuid "c289de45-9a1b-5061-b32e-0117afdc042d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332543}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fde6af27-2c77-53dd-8542-aaa673109767" :question/math-academy-id "q-49517" :question/problem "What is the value of ${\\int }_{e}^{{e}^{2}}\\frac{\\text{d}x}{x\\operatorname{ln}⁡x}?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{\\text{d}x}{x\\operatorname{ln}⁡x} & ={\\int }_{e}^{{e}^{2}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =\\operatorname{ln}⁡2-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡2\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f292278-673c-5eba-880c-7cda055f8171" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186330511} {:answer/id #uuid "5dac8132-bf52-5344-825a-5d6616a1cdd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186330784} {:answer/id #uuid "83aeb76a-c46c-5da9-b6b1-d3b2c07f5e3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186331119} {:answer/id #uuid "884a0de8-2fb3-540c-834e-7021c6f3a3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186331163} {:answer/id #uuid "dc4580e3-6e2d-5fe8-9d8c-