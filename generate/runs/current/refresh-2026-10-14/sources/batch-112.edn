operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cf2f12-d9f3-59fd-be22-70990f0c064c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186295477} {:answer/id #uuid "32474011-c0eb-5c98-b028-863b8f17da19" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186295550} {:answer/id #uuid "8b40389e-34eb-5524-b04f-3adc8016457b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296008} {:answer/id #uuid "a5006fea-9435-5ebd-a15e-7ec4fb282356" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296137} {:answer/id #uuid "e0893163-fbac-5102-8d54-6ed75f43ac2c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296461}] :answer-field/correct {:answer/id #uuid "e0893163-fbac-5102-8d54-6ed75f43ac2c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296461} :answer-field/id #uuid "c59c5853-4a44-56f0-94bb-09e77fa03053" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297042}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f906b7ab-49ff-57e2-8ffb-323870b5ae05" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e801e34a-0125-5366-bfbe-7c5392f185fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {log}_{4}⁡x+C" :db/id #edb/ref 17592186374609} {:answer/id #uuid "62971e29-5a80-538d-9637-1c44a46cb3f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{4}⁡x}{2}+C" :db/id #edb/ref 17592186374610} {:answer/id #uuid "f1b2cf9d-77a0-5a78-af8e-45f3fc5b07a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot \\frac{{log}_{4}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186374611} {:answer/id #uuid "0cd16dac-0e0f-5456-b5cc-6f633c746a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {log}_{4}^{2}⁡x+C" :db/id #edb/ref 17592186374612} {:answer/id #uuid "85ac5157-29fb-5860-accd-7d93b3916a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot {log}_{4}^{2}⁡x+C" :db/id #edb/ref 17592186374613}] :answer-field/correct {:answer/id #uuid "85ac5157-29fb-5860-accd-7d93b3916a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot {log}_{4}^{2}⁡x+C" :db/id #edb/ref 17592186374613} :answer-field/id #uuid "ebe67bfb-124a-593d-83ad-61599d1d4bef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374608}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "102ce1ec-ef07-53e3-afee-6e16414152b1" :question/math-academy-id "q-31395" :question/problem "$\\int \\frac{2{log}_{4}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2{log}_{4}⁡x}{x}\\,\\text{d}x & =2\\int {log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4\\int u\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡4\\cdot {u}^{2}+C \\\\  & =\\operatorname{ln}⁡4\\cdot {log}_{4}^{2}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186384656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126fc08e-95cb-5306-9924-3f019148d8ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{log}_{5}^{2}⁡({x}^{3})}{6}+C" :db/id #edb/ref 17592186384658} {:answer/id #uuid "c5ca6758-4100-5c28-a5e2-8d3c88248263" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5\\operatorname{ln}⁡({x}^{3})}{12}+C" :db/id #edb/ref 17592186384659} {:answer/id #uuid "8ace6c23-79dc-5742-bc86-816d99045d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5{log}_{5}^{2}⁡({x}^{3})}{12}+C" :db/id #edb/ref 17592186384660} {:answer/id #uuid "c0fb5889-b60d-5aaf-8beb-363ab1698930" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{ln}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186384661} {:answer/id #uuid "4cc9eae9-b3ce-547a-9a34-0e08774a75ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{ln}^{2}⁡({x}^{3})}{2}+C" :db/id #edb/ref 17592186384662}] :answer-field/correct {:answer/id #uuid "8ace6c23-79dc-5742-bc86-816d99045d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5{log}_{5}^{2}⁡({x}^{3})}{12}+C" :db/id #edb/ref 17592186384660} :answer-field/id #uuid "c996e19a-d711-54dc-9b49-a03cea7cecd2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384657}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6517d214-0493-5c34-bfbe-5920e35412fd" :question/math-academy-id "q-210751" :question/problem "$\\int \\frac{{log}_{5}⁡({x}^{3})}{2x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡({x}^{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡5}\\,⟹\\,\\frac{\\operatorname{ln}⁡5}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{5}⁡({x}^{3})}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{5}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot (\\frac{\\operatorname{ln}⁡5}{3}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡5}{6}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡5}{6}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡5{log}_{5}^{2}⁡({x}^{3})}{12}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] [{:db/id #edb/ref 17592186100818 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100610 :question/id #uuid "d2f49acf-ed91-510d-a0f1-41c50eeef9e7" :question/math-academy-id "e-14422" :question/problem "Evaluate $\\displaystyle{\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x}.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | $e^2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\eqalign{\n\t\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x\n&= \\int_{e}^{e^2} (\\ln x)^2\\cdot \\dfrac{\\textrm{d}x}{x}\\[5pt]\n&=\\int_{1}^{2} u^2\\,\\textrm{d}u\\[5pt]\n&=\\left.\\dfrac13u^{3}\\right|_{1}^{2}\\[5pt] \n&=\\dfrac{1}{3}\\left(2^3-1^3 \\right)\\[5pt]\n&=\\dfrac{1}{3}\\left(8-1 \\right)\\[5pt]\n&=\\dfrac{7}{3}\t\t\n\n\t}\n$$"} :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186101451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f44a31c-8f02-517f-a3ff-76a016ef1103" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186330368} {:answer/id #uuid "3b888702-3835-5e64-a746-f342b2add188" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186330480} {:answer/id #uuid "55e0e2dc-0727-59f1-ab88-5104534b5eae" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186330719} {:answer/id #uuid "570539a7-4903-5aaa-8ab5-396b0db3ecbe" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡4" :db/id #edb/ref 17592186330727} {:answer/id #uuid "fe377b72-3be3-5386-8d19-dd14073a8aa9" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186332189}] :answer-field/correct {:answer/id #uuid "55e0e2dc-0727-59f1-ab88-5104534b5eae" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186330719} :answer-field/id #uuid "41c0ce28-8066-581a-a24f-804e0ab448c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332311}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "131ef8ba-67f1-5c9d-a9d6-716f27012aa1" :question/math-academy-id "q-49605" :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$  gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x & =8{\\int }_{{e}^{2}}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =8{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =8\\cdot {\\frac{{u}^{2}}{2}|}_{2}^{4} \\\\  & =4\\cdot {u}^{2}{|}_{2}^{4} \\\\  & =4\\cdot (16-4) \\\\  & =48\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1911069-1c55-5932-b891-074fa38d0681" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186099874} {:answer/id #uuid "b51f2b52-e938-50e1-90fa-bb6448bdc3fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{1}{5})" :db/id #edb/ref 17592186099875} {:answer/id #uuid "d779e443-9211-5d9f-983d-aa5869c4abba" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (\\frac{3}{2})" :db/id #edb/ref 17592186099876} {:answer/id #uuid "101f63ee-048f-5071-864e-f39dff