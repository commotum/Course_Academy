 \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249cc9e7-cb4d-52ad-9e9e-e84024942ace" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡{x}^{2}|+C" :db/id #edb/ref 17592186288268} {:answer/id #uuid "5da3752e-4993-5ec0-877d-0a3fd775b84c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288687} {:answer/id #uuid "63651b20-ed95-5e55-8f68-81a466cc5ce7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288726} {:answer/id #uuid "926da738-6ea6-53a7-b613-8359f66a864b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2+\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186289015} {:answer/id #uuid "e33f2640-c785-5dc0-acda-5e6494b2de0a" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186289542}] :answer-field/correct {:answer/id #uuid "5da3752e-4993-5ec0-877d-0a3fd775b84c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186288687} :answer-field/id #uuid "30b841af-b6a0-5f34-a593-ca46481cf7b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289838}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "07ddd93b-2266-558f-9ab3-369202ae0194" :question/math-academy-id "q-210752" :question/problem "$\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3783aaf0-95fe-582e-9b6c-214d1b88d33f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288408} {:answer/id #uuid "37ab6ab5-1c0e-58f5-b386-e76cdaa7443e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288410} {:answer/id #uuid "4d666098-aa58-56fe-865c-a47cdc80ed88" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288570} {:answer/id #uuid "be835456-2ece-556e-a15f-dfc8e8723b39" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186289286} {:answer/id #uuid "efd7546d-984c-5ba3-b883-fe67852b9b22" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/id #edb/ref 17592186289618}] :answer-field/correct {:answer/id #uuid "37ab6ab5-1c0e-58f5-b386-e76cdaa7443e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/id #edb/ref 17592186288410} :answer-field/id #uuid "9a19bf0f-f7af-52cd-8c16-c823fa1c1794" :answer-field/key "selection" :an