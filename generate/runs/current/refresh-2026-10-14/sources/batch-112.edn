swer.type/math} :answer/value "{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id #edb/ref 17592186275741} {:answer/id #uuid "4619d482-5733-51a3-96e0-8ad693700d75" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{2x+3y}+6x{y}^{2}" :db/id #edb/ref 17592186276096} {:answer/id #uuid "4c062e4a-ec8c-5adf-8963-947c77e772cf" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+6x{y}^{2}" :db/id #edb/ref 17592186276145} {:answer/id #uuid "733056c4-4ea1-5358-977a-a7c64e073092" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x+3y}+2x{y}^{3}" :db/id #edb/ref 17592186276520} {:answer/id #uuid "ad5a9b83-408b-502e-b6e9-1db4afeef584" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id #edb/ref 17592186277035}] :answer-field/correct {:answer/id #uuid "ad5a9b83-408b-502e-b6e9-1db4afeef584" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id #edb/ref 17592186277035} :answer-field/id #uuid "4348a5dd-f992-5c0f-a358-d3667a2d63fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277829}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5ed8a7e6-be3b-5de6-bfb2-8c47db49086f" :question/math-academy-id "q-159623" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)={e}^{2x+3y}+{x}^{2}{y}^{3}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum rule for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}({e}^{2x+3y}+{x}^{2}{y}^{3}) \\\\  & =\\frac{∂}{∂y}({e}^{2x}\\cdot {e}^{3y})+\\frac{∂}{∂y}({x}^{2}{y}^{3}) \\\\  & ={e}^{2x}\\cdot \\frac{∂}{∂y}({e}^{3y})+{x}^{2}\\cdot \\frac{∂}{∂y}({y}^{3}) \\\\  & ={e}^{2x}\\cdot 3{e}^{3y}+{x}^{2}\\cdot 3{y}^{2} \\\\  & =3{e}^{2x+3y}+3{x}^{2}{y}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "051af5b2-726e-5b49-a969-9796e797ae3e" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}" :db/id #edb/ref 17592186381218} {:answer/id #uuid "ecde6fb6-675d-59f3-9850-531e953ba33d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{tan}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381219} {:answer/id #uuid "20ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381220} {:answer/id #uuid "a24feefe-3cbe-5e42-b271-0ac95ae87b92" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{csc}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381221} {:answer/id #uuid "faa81e86-4ae1-53c8-8b77-4618058650b4" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}\\operatorname{tan}⁡y-{3}^{x+y}" :db/id #edb/ref 17592186381222}] :answer-field/correct {:answer/id #uuid "20ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id #edb/ref 17592186381220} :answer-field/id #uuid "e9775693-9681-5414-8d66-ab2776e2f417" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381217}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "26ca0866-34da-5a8a-8819-c0314d3abbb7" :question/math-academy-id "q-159611" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)={x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}) \\\\  & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y)-\\frac{∂}{∂y}({3}^{x}\\cdot {3}^{y}) \\\\  & ={x}^{3}\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡y)-{3}^{x}\\cdot \\frac{∂}{∂y}({3}^{y}) \\\\  & ={x}^{3}\\cdot {sec}^{2}⁡y-{3}^{x}\\cdot {3}^{y}\\operatorname{ln}⁡3 \\\\  & ={x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc01c4d-160a-5eea-af63-34bb0d6f5cfe" :answer/type {:db/ident :answer.type/math} :answer/value "5-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381225} {:answer/id #uuid "c56e8f59-813f-5140-bc33-6355f2e8c8f2" :answer/type {:db/ident :answer.type/math} :answer/value "5-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381226} {:answer/id #uuid "f4c320e0-173a-55b6-b2fe-6e2df1ef3a1a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381227} {:answer/id #uuid "23510347-ad72-510f-9453-61fb93eb4c94" :answer/type {:db/ident :answer.type/math} :answer/value "5y-2\\operatorname{sin}⁡x" :db/id #edb/ref 17592186381228} {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381229}] :answer-field/correct {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381229} :answer-field/id #uuid "107fee59-5ae8-5849-9751-9c38f3f036ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381224}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a343ea27-2d89-5c6e-9038-e851b2a44521" :question/math-academy-id "q-159614" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=5y-2\\operatorname{sin}⁡x.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(5y-2\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(5y)-\\frac{∂}{∂x}(2\\operatorname{sin}⁡x) \\\\  & =5\\cdot \\frac{∂}{∂x}(y)-2\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & =5\\cdot (0)-2\\cdot (\\operatorname{cos}⁡x) \\\\  & =-2\\operatorname{cos}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42294efd-0726-56da-9ff2-aacaa739035d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{{y}^{5}}+6x" :db/id #edb/ref 17592186381232} {:answer/id #uuid "e692a74c-4360-52d2-9a3b-14b7bb724d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12{x}^{2}}{{y}^{4}}+6" :db/id #edb/ref 17592186381233} {:answer/id #uuid "e8ed405c-d0bb-58ec-9cb0-db66e314a0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{3}}{{y}^{5}}+6y" :db/id #edb/ref 17592186381234} {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} {:answer/id #uuid "1c43e727-621e-5491-9269-e9a7064dc12d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{{y}^{5}}+6" :db/id #edb/ref 17592186381236}] :answer-field/correct {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id #edb/ref 17592186381235} :answer-field/id #uuid "88fa3ce5-5c28-5db2-ada3-b42ead245d4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381231}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55f3a1d2-cb7d-5965-acea-2992a42840fe" :question/math-academy-id "q-159618" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\frac{{x}^{3}}{{y}^{4}}+6xy.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}}+6xy) \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}})+\\frac{∂}{∂x}(6xy) \\\\  & =\\frac{1}{{y}^{4}}\\frac{∂}{∂x}({x}^{3})+6y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{{y}^{4}}\\cdot 3{x}^{2}+6y\\cdot 1 \\\\  & =\\frac{3{x}^{2}}{{y}^{4}}+6y\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6f0ef5-d53d-5837-98c8-631186129434" :answer/type {:db/ident :answer.type/math} :answer/value "32{y}^{3}-\\frac{24y}{{x}^{5}}" :db/id #edb/ref 17592186381239} {:answer/id #uuid "cd8e251a-8b10-5e05-b8e9-664d5a11015b" :answer/type {:db/ident :answer.type/math} :answer/value "32x{y}^{3}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381240} {:answer/id #uuid "b39b7828-0e78-591c-b643-6a8cdf575bd5" :answer/type {:db/ident :answer.type/math} :answer/value "32x{y}^{3}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381241} {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} {:answer/id #uuid "4b9203e9-d678-558b-b50c-6a4193709f98" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}+\\frac{6y}{{x}^{4}}" :db/id #edb/ref 17592186381243}] :answer-field/correct {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id #edb/ref 17592186381242} :answer-field/id #uuid "3225480b-17a3-5de3-a894-3b9c909ffb27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381238}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54a3e289-7644-5884-8f3d-09b4adcf7d3d" :question/math-academy-id "q-159621" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =\\frac{∂}{∂x}(8x{y}^{4})+\\frac{∂}{∂x}(\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =8{y}^{4}\\cdot \\frac{∂}{∂x}(x)+3{y}^{2}\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{4}}) \\\\  & =8{y}^{4}\\cdot 1+3{y}^{2}\\cdot (-\\frac{4}{{x}^{5}}) \\\\  & =8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186436330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21514dc3-fd5d-565c-a5dd-41b334024de1" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{y}+{e}^{x}" :db/id #edb/ref 17592186436293} {:answer/id #uuid "9023fe86-f4d4-53cf-afa7-ceab284c385c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}" :db/id #edb/ref 17592186436306} {:answer/id #uuid "a479ae38-298e-5258-8558-f1d904df696f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}+y{e}^{x}" :db/id #edb/ref 17592186436312} {:answer/id #uuid "e1294690-bb34-5896-b0c1-f42f98fe8355" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}+{e}^{x}" :db/id #edb/ref 17592186436319} {:answer/id #uuid "ffa0af21-05d8-5b41-b926-c8615ac23faf" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}" :db/id #edb/ref 17592186436323}] :answer-field/correct {:answer/id #uuid "21514dc3-fd5d-565c-a5dd-41b334024de1" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{y}+{e}^{x}" :db/id #edb/ref 17592186436293} :answer-field/id #uuid "ec0f419d-2a0d-5de9-af19-f4de7b215052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436328}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7ea23849-68e0-52dc-ba91-b8da7ebd925a" :question/math-academy-id "q-159624" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)=x{e}^{y}+y{e}^{x}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x{e}^{y}+y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(x{e}^{y})+\\frac{∂}{∂y}(y{e}^{x}) \\\\  & =x\\cdot \\frac{∂}{∂y}({e}^{y})+{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot {e}^{y}+{e}^{x}\\cdot 1 \\\\  & =x{e}^{y}+{e}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186436333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5347b519-c490-5531-86d9-c47823454ef5" :answer/type {:db/ident :answer.type/math} :answer/value "-{y}^{2}" :db/id #edb/ref 17592186436298} {:answer/id #uuid "55c2293e-6cda-5e44-a3be-cf42f0b0106e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡y-{y}^{2}" :db/id #edb/ref 17592186436299} {:answer/id #uuid "6d40833e-3b6e-5b26-96b6-154dbe238c17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6xy}{1+{y}^{2}}" :db/id #edb/ref 17592186436304} {:answer/id #uuid "a2853c1d-4c78-58f1-877e-d34353665049" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-{y}^{2}" :db/id #edb/ref 17592186436310} {:answer/id #uuid "ab9e0b79-350f-56ca-97e1-d432fc67e8d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-2xy" :db/id #edb/ref 17592186436313}] :answer-field/correct {:answer/id #uuid "ab9e0b79-350f-56ca-97e1-d432fc67e8d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-2xy" :db/id #edb/ref 17592186436313} :answer-field/id #uuid "1ad15885-4f52-5353-a9a6-c3dae29fe5c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436324}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ca64fedb-1539-5dab-a00d-8a624f81d8c4" :question/math-academy-id "q-159612" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=3\\operatorname{arctan}⁡y-x{y}^{2}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3\\operatorname{arctan}⁡y-x{y}^{2}) \\\\  & =\\frac{∂}{∂y}(3\\operatorname{arctan}⁡y)-\\frac{∂}{∂y}(x{y}^{2}) \\\\  & =3\\cdot \\frac{∂}{∂y}(\\operatorname{arctan}⁡y)-x\\cdot \\frac{∂}{∂y}({y}^{2}) \\\\  & =3\\cdot \\frac{1}{1+{y}^{2}}-x\\cdot 2y \\\\  & =\\frac{3}{1+{y}^{2}}-2xy\\end{aligned}\n$$"}] :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] [{:db/id #edb/ref 17592186124643 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124201 :question/id #uuid "a14d53ae-1922-531d-bb2a-bda9b4829f6e" :question/math-academy-id "e-11045" :question/problem "Given that $f(x,y) = y^2\\ln{x},$ express $\\dfrac{\\partial f}{\\partial x}$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0} \\left(\\dfrac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x) = y^2 \\ln{x},$  we have that \n\n$$\nf(x+h,y) = y^2\\ln(x+h).\n$$\n\nTherefore,\n\n$$\n\\displaystyle \\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0}\\left( \\dfrac{y^2\\ln(x+h) -y^2\\ln{x} }{h}\\right).\n$$"} :knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048449 :topic/math-academy-id 1931 :topic/title "Limits and Continuity of Multivariable Functions"} {:db/id #edb/ref 17592186048904 :topic/math-academy-id 812 :topic/title "Defining the Derivative Using Derivative Notation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186124806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a982a06-37f5-5503-bfa9-cb1dd6d38914" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3(x+h)^{2}y-3{x}^{2}y}{h})" :db/id #edb/ref 17592186436294} {:answer/id #uuid "a0c460cb-67db-5572-99a9-ee900ea57026" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3{x}^{2}y-3{x}^{2}(y+h)}{h})" :db/id #edb/ref 17592186436309} {:answer/id #uuid "cf081fa8-128f-5e46-8325-e879a6351185" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3{x}^{2}(y+h)+3{x}^{2}y}{h})" :db/id #edb/ref 17592186436315} {:answer/id #uuid "d91afb82-9ea2-57cb-beea-4efb7de3116e" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3(x+h)^{2}y+3{x}^{2}y}{h})" :db/id #edb/ref 17592186436316} {:answer/id #uuid "e544a325-ec37-5b38-a930-60dd700bae41" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3{x}^{2}(y+h)-3{x}^{2}y}{h})" :db/id #edb/ref 17592186436321}] :answer-field/correct {:answer/id #uuid "2a982a06-37f5-5503-bfa9-cb1dd6d38914" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{3(x+h)^{2}y-3{x}^{2}y}{h})" :db/id #edb/ref 17592186436294} :answer-field/id #uuid "55b7ddca-7b00-5c43-89e9-90f57dc02219" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121433}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b1789afc-331e-5614-8cc9-89f93ec40167" :question/math-academy-id "q-158412" :question/problem "Given that $f(x,y)=3{x}^{2}y,$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{f(x+h,y)-f(x,y)}{h}).\n$$\n\nSince $f(x)=3{x}^{2}y$,  we have that \n\n$$\nf(x+h,y)=3(x+h)^{2}y.\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{3(x+h)^{2}y-3{x}^{2}y}{h}).\n$$"} {:db/id #edb/ref 17592186124807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa38f898-f95c-52be-becb-7fc9b2a08852" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(h → 0)(\\frac{x\\sqrt{y + h} + x\\sqrt{y}}{h})" :db/id #edb/ref 17592186121440} {:answer/id #uuid "22805a92-432b-5fd2-b9db-7f79f63ae0ea" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(h → 0)(((x + h)\\sqrt{y} - x\\sqrt{y + h})/(h))" :db/id #edb/ref 17592186121441} {:answer/id #uuid "3a787f74-c1ba-589c-ab07-3e5300560ee6" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(h → 0)(((x + h)\\sqrt{y} - x\\sqrt{y})/(h))" :db/id #edb/ref 17592186121442} {:answer/id #uuid "3f588410-fab9-53cf-8d13-27e4f649404f" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(h → 0)(\\frac{x\\sqrt{y + h} - x\\sqrt{y}}{h})" :db/id #edb/ref 17592186121443} {:answer/id #uuid "564275bc-7ea2-5e92-83da-0e9860a52600" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(h → 0)((x\\sqrt{y + h} - (x + h)\\sqrt{y})/(h))" :db/id #edb/ref 17592186121444}] :answer-field/id #uuid "20dffa5d-0545-52c2-9e31-4bd97821f9b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121439}] :question/id #uuid "0b3ca695-bbf4-58d5-b3fd-5901b18ae41b" :question/math-academy-id "q-158413" :question/problem "Given that $f(x, y) = x\\sqrt{y}$, then $\\frac{∂f}{∂y} =$