end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,0=0\\cdot 1+3\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=(-1)\\cdot 1+4\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}, &  & \\,-4=5\\cdot (-2)+2\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299651 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582}] :answer-field/correct {:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582} :answer-field/id #uuid "7f84dc72-92a1-5353-b591-bdf85d6a4d27" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299069} {:answer-field/choices [{:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036}] :answer-field/correct {:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036} :answer-field/id #uuid "c6007ff8-9e9f-5fb3-89f5-bb5c4da4bf33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299300}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d6b8e49d-bc16-5e49-870a-d27907495843" :question/math-academy-id "q-317846" :question/problem "Determine $AB$ given