gned} & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-3=-1\\cdot 3 \\\\  & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,1=(-1)\\cdot (-1) \\\\  & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 \\\\ -9 & ∗\\end{bmatrix}, &  & \\,-9=(-3)\\cdot 3 \\\\  & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 \\\\ -9 & 3\\end{bmatrix}, &  & \\,3=(-3)\\cdot (-1)\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}-3 & 1 \\\\ -9 & 3\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1731f4d0-2e00-51db-8ba8-df32c1c91bc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 16 \\\\ 2 & 0 & 8 \\\\ 1 & 0 & 4 \\\\ 1 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186263220} {:answer/id #uuid "35d5240f-4de5-5ab2-a31d-42037cfc6435" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & 16 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & -1 & 8 & 2 \\\\ 1 & 0 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186263475} {:answer/id #uuid "8bd1c6fb-594a-5b00-aa29-c8f0422c862c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & 16 & 1 \\\\ 2 & -1 & 8 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 1 & 0 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186264196} {:answer/id #uuid "a4b6c187-e4d1-55f9-ab48-a635363b3fb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & 16 \\\\ 2 & -1 & 8 \\\\ 1 & 0 & 4 \\\\ 0 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264403} {:answer/id #uuid "a59536c8-b0af-533f-8581-64006b7db377" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186264419}] :answer-field/correct {:answer/id #uuid "1731f4d0-2e00-51db-8b