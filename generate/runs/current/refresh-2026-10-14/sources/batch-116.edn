f 17592186297880} :answer-field/id #uuid "96cea0dd-cf80-5acf-9892-8cd8aa4d611a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299136}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2eb6f27b-270d-54d9-87be-3557d2c76515" :question/math-academy-id "q-318588" :question/problem "Find $PQ,$ if\n$P=\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}$\nand\n$Q=\\begin{bmatrix}-4 & 2\\end{bmatrix}.$\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $PQ=\\,\\,$ |  | {{field-3}} | {{field-4}} |  |\n|  |  | {{field-5}} | {{field-6}} |  |" :question/worked-solution "Here, $P$ is a $3\\times 1$ matrix and $Q$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $P$ and $1$ row in matrix $Q$, so the product is well defined:\n\n$$\n{P}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{Q}_{\\boxed{\\text{1}}\\times 2}={PQ}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}PQ & =\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot (-4) & 0\\cdot 2 \\\\ 3\\cdot (-4) & 3\\cdot 2 \\\\ (-1)\\cdot (-4) & (-1)\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -12 & 6 \\\\ 4 & -2\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186396025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396027} {:answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396028} {:answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396029} {:answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186396030} {:answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396031}] :answer-field/correct {:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396027} :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396026}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=\\begin{bmatrix}0 \\\\ -2 \\\\ -3\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}1 & 2\\end{bmatrix}.$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 \\\\ -2 \\\\ -3\\end{bmatrix}\\begin{bmatrix}1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}]}
