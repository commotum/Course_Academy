e/text} :answer/value "false" :db/id #edb/ref 17592186439773} {:answer/id #uuid "15d84877-db47-53cc-adf7-15e463488793" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439774}] :answer-field/correct {:answer/id #uuid "1ce9210e-8c33-56d3-a143-b8194c6e7d2c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439773} :answer-field/id #uuid "99529b71-fb0d-5b9b-adec-1b9531669fa6" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440244} {:answer-field/choices [{:answer/id #uuid "6b1d3092-75b5-5c45-bb6e-b7fe0a349b7f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439775} {:answer/id #uuid "e8bd57e5-7e8e-551a-ba0e-d12a020c81be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439776}] :answer-field/correct {:answer/id #uuid "e8bd57e5-7e8e-551a-ba0e-d12a020c81be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439776} :answer-field/id #uuid "f0fe034c-e5e1-5872-82ba-0cd1c7e50825" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440245} {:answer-field/choices [{:answer/id #uuid "d14b44f4-3d4a-5cb3-910a-55d6269fe2a7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439777} {:answer/id #uuid "68b5fed7-7415-5fc0-88be-8ef93d2a2bef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439778}] :answer-field/correct {:answer/id #uuid "d14b44f4-3d4a-5cb3-910a-55d6269fe2a7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439777} :answer-field/id #uuid "b0c9f803-913c-53b9-89d7-27213f39508d" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440246}] :question/id #uuid "bfa79719-c636-549a-8b52-62d1b8be1bcf" :question/math-academy-id "q-44504" :question/problem "![](images/20/20e05c0af32d6fe2643af2912d51ef1b3994374260ffaa4fc22002def474c15f.png)\n\nIdentify the points on the graph that lie on the line $y = 8x - 3$.\n\nSelect all that apply." :question/worked-solution "A=(-6,5), B=(1,5), C=(6,5). Only B satisfies y=8x-3."} {:db/id #edb/ref 17592186490232 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f20f4e-40c9-5a9d-8129-6ea89406c9b3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186489592} {:answer/id #uuid "2e314e93-a74f-58a2-8a61-c6709c1e6a05" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186489617} {:answer/id #uuid "2e61ea38-9adb-5df3-9e77-c49b744c8375" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186489618} {:answer/id #uuid "c8cdeb7e-9f2c-5249-a813-a2de4fe3188f" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186489951} {:answer/id #uuid "d311c0e5-165f-5e28-b3c6-245a633be859" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186489981}] :answer-field/correct {:answer/id #uuid "2e314e93-a74f-58a2-8a61-c6709c1e6a05" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186489617} :answer-field/id #uuid "73f7dd8a-46cc-50f8-8f6c-5dc06aa45a32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490141}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3250f349-fbfe-56f8-96e2-52cb212003b3" :question/math-academy-id "q-102142" :question/problem "![](images/7d/7dad50d17444096c60b129131104209b8b7371d546f80d7b0c838baec1df8b4d.png)\n\nWhich of the given points lie on the line $y=-5x+6?$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(0,5),B(1,2)$ and $C(2,-4).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(0,5)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-5x+6 \\\\ (5) & =-5(0)+6 \\\\ 5 & =6\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $A$ does *not* lie on the line.\n\n- Substituting the point $B(1,2)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-5x+6 \\\\ (2) & =-5(1)+6 \\\\ 2 & =1\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(2,-4)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =-5x+6 \\\\ (-4) & =-5(2)+6 \\\\ -4 & =-4\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only point $C$ lies on the line."} {:db/id #edb/ref 17592186490291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4f3252-d422-5b2b-87b7-6916c51a12a0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186489550} {:answer/id #uuid "38679d57-742c-5817-a31c-101bf33ca332" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186489640} {:answer/id #uuid "685aeab1-eebd-534e-8e4a-d21630e148b9" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186489763} {:answer/id #uuid "a111be60-4cf1-5eab-b12f-bf275dc291fc" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186489871} {:answer/id #uuid "f9fd167a-76c2-572d-ac6f-8214ea48c14a" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186490058}] :answer-field/correct {:answer/id #uuid "0f4f3252-d422-5b2b-87b7-6916c51a12a0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186489550} :answer-field/id #uuid "29e6c0ec-30d3-5bc5-89e9-08b3f00c0259" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490093}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "acf0d12e-cf58-5db7-b66f-2999c47f2d4e" :question/math-academy-id "q-71829" :question/problem "![](images/c3/c33968d9b5c86e39ba35c88a5f28bb8950178004c763a5c011633b9a060e98a8.png)\n\nIdentify the points that lie on the line $y=4x+2.$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-1,-2)$, $B(0,1)$ and $C(1,6).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-1,-2)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =4x+2 \\\\ (-2) & =4(-1)+2 \\\\ -2 & =-2\\,✓\\end{aligned}\n$$\n\nTherefore, the point $A$ does lie on the line.\n\n- Substituting the point $B(0,1)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =4x+2 \\\\ (1) & =4(0)+2 \\\\ 1 & =2\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(1,6)$ results in true statement:\n\n$$\n\\begin{aligned}y & =4x+2 \\\\ (6) & =4(1)+2 \\\\ 6 & =6\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only points $A$ and $C$ lie on the line."} {:db/id #edb/ref 17592186498666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e65719-9423-5445-8fcf-aaf6c05d97d5" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498676} {:answer/id #uuid "643d71ec-95bc-5042-8b51-322a436c9046" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186498683} {:answer/id #uuid "80feb855-589a-53c3-bac3-61637b4af9e4" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498690} {:answer/id #uuid "e967faa4-e8a6-581c-a3cf-38284b6b90c7" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498712} {:answer/id #uuid "ecf14a96-818d-5db6-9c66-a0d3175bb6b4" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498714}] :answer-field/correct {:answer/id #uuid "32e65719-9423-5445-8fcf-aaf6c05d97d5" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498676} :answer-field/id #uuid "fffeded8-fcf5-542f-a921-ded34513e23b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498716}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f863f32-c463-5f07-9482-1c6f6e74c019" :question/problem "![](images/4c/4c714262b9da22ea9ad859817db86a3aaf0b29ef811246aedc969bc9999c0348.png)\n\nIdentify the points that lie on the line $y=x+3.$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-3,0)$, $B(-1,4)$ and $C(3,6).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-3,0)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =x+3 \\\\ (0) & =1(-3)+3 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the point $A$ does lie on the line.\n\n- Substituting the point $B(-1,4)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =x+3 \\\\ (4) & =1(-1)+3 \\\\ 4 & =2\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(3,6)$ results in true statement:\n\n$$\n\\begin{aligned}y & =x+3 \\\\ (6) & =1(3)+3 \\\\ 6 & =6\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only points $A$ and $C$ lie on the line."} {:db/id #edb/ref 17592186498667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b01faa9-1661-5d2c-8b15-89c1d529166b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498665} {:answer/id #uuid "2773d5bd-6a1e-5e0f-bdc4-1f27d274f0fc" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186498671} {:answer/id #uuid "4546836a-abb8-583d-8041-3599332cf4de" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498678} {:answer/id #uuid "86ff2819-d939-51c4-94f3-9732d4521a05" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498693} {:answer/id #uuid "961c8a45-200e-5ff7-841b-40c1e1f1d099" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498695}] :answer-field/correct {:answer/id #uuid "86ff2819-d939-51c4-94f3-9732d4521a05" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498693} :answer-field/id #uuid "02799bef-6cfd-5d9e-bca3-3026a3cc6d51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498661}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "12a60b9c-85ce-50af-b45d-06caed36a198" :question/problem "![](images/3c/3cee718f18c9ef081b3e90a70d4db00ef0339d7d5f0b87423f7c5687709471a6.png)\n\nWhich of the given points lie on the line $y=-5x-2?$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-2,9),B(-1,4)$ and $C(1,-7).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-2,9)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-5x-2 \\\\ (9) & =-5(-2)-2 \\\\ 9 & =8\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $A$ does *not* lie on the line.\n\n- Substituting the point $B(-1,4)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-5x-2 \\\\ (4) & =-5(-1)-2 \\\\ 4 & =3\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(1,-7)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =-5x-2 \\\\ (-7) & =-5(1)-2 \\\\ -7 & =-7\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only point $C$ lies on the line."} {:db/id #edb/ref 17592186498669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a90128e-f77f-5ec3-9038-8600c7b3dcfd" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498681} {:answer/id #uuid "627354bc-e225-5d3c-9eda-85b7e4603569" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498682} {:answer/id #uuid "7d0560a4-412e-54e3-91ff-603a3b02dcd8" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498688} {:answer/id #uuid "8098dcbf-4d2e-5f36-b4e9-f6ca59744fa8" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186498689} {:answer/id #uuid "a27987d5-3a9e-5baf-b1a3-d4be781d9d5b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498697}] :answer-field/correct {:answer/id #uuid "5a90128e-f77f-5ec3-9038-8600c7b3dcfd" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498681} :answer-field/id #uuid "ed72d909-9af6-5dcf-9647-d3ab941b4b50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498715}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "21a9c497-cf26-5338-8f2e-52de8c6489fc" :question/problem "![](images/70/70b04ef6ee89c2bf06db99444f1f89afbe2ea15871f8f79da29668f7be3f9f97.png)\n\nIdentify the points that lie on the line $y=2x.$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-1,-2)$, $B(1,4)$ and $C(2,4).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-1,-2)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =2x \\\\ (-2) & =2(-1)+0 \\\\ -2 & =-2\\,✓\\end{aligned}\n$$\n\nTherefore, the point $A$ does lie on the line.\n\n- Substituting the point $B(1,4)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =2x \\\\ (4) & =2(1)+0 \\\\ 4 & =2\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(2,4)$ results in true statement:\n\n$$\n\\begin{aligned}y & =2x \\\\ (4) & =2(2)+0 \\\\ 4 & =4\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only points $A$ and $C$ lie on the line."} {:db/id #edb/ref 17592186498672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2517ee62-3508-5043-99a6-8cbff4a054bf" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498670} {:answer/id #uuid "49484dad-6a3e-55b6-a9bc-7f95d103cd98" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498679} {:answer/id #uuid "6965c31a-509c-5fad-b07e-299d62f499ff" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498686} {:answer/id #uuid "9a6fe6ee-5189-5bb5-9dc1-3ca7c751bd17" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498696} {:answer/id #uuid "ca1b1055-64cd-5ad9-a4f4-4ba68a08c842" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186498708}] :answer-field/correct {:answer/id #uuid "6965c31a-509c-5fad-b07e-299d62f499ff" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498686} :answer-field/id #uuid "030b1280-3f72-5e40-9687-4451485960c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498662}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "277a1bc9-d733-576e-9af4-fb70571bb178" :question/problem "![](images/eb/eb6b3f51e0e61f72015505469f9fd6e6aa2d5e5b550825e4c761fc78f535ef59.png)\n\nIdentify the points that lie on the line $y=3x+2.$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-3,-7)$, $B(-1,1)$ and $C(1,5).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-3,-7)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =3x+2 \\\\ (-7) & =3(-3)+2 \\\\ -7 & =-7\\,✓\\end{aligned}\n$$\n\nTherefore, the point $A$ does lie on the line.\n\n- Substituting the point $B(-1,1)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =3x+2 \\\\ (1) & =3(-1)+2 \\\\ 1 & =-1\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(1,5)$ results in true statement:\n\n$$\n\\begin{aligned}y & =3x+2 \\\\ (5) & =3(1)+2 \\\\ 5 & =5\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only points $A$ and $C$ lie on the line."} {:db/id #edb/ref 17592186498698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b24e4af-347a-5ac2-9514-dd6e178db687" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186498668} {:answer/id #uuid "70b48381-828b-5d40-b1db-1850c4bb5fbe" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498687} {:answer/id #uuid "aef1cd6c-325f-57b3-b55a-22367510cec4" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498702} {:answer/id #uuid "b7497970-afdd-59b5-8946-7e774cc44e0c" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498705} {:answer/id #uuid "e81db796-7d07-5