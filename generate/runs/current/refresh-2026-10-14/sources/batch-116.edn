, &  & \\,1=2\\cdot (-2)+(-3)\\cdot 4+1\\cdot 1+4\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$ST=\\begin{bmatrix}24 & 1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d545a5-b2e6-5053-b8b6-37194c5c9aa5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 6 \\\\ -3 & 10\\end{bmatrix}" :db/id #edb/ref 17592186263315} {:answer/id #uuid "338b8f0e-6e8c-5003-a20f-65d3696dd73a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}" :db/id #edb/ref 17592186263448} {:answer/id #uuid "40cea55b-6167-57c5-a2d6-7f87677038d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & 10 \\\\ -5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186263572} {:answer/id #uuid "53864c34-56a3-5553-afb8-033b263dcdea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 10 \\\\ -6 & 5\\end{bmatrix}" :db/id #edb/ref 17592186263719} {:answer/id #uuid "d6bc1bd7-12d4-51d7-8d46-edc046b147b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 10 \\\\ -2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186264868}] :answer-field/correct {:answer/id #uuid "338b8f0e-6e8c-5003-a20f-65d3696dd73a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}" :db/id #edb/ref 17592186263448} :answer-field/id #uuid "7f084fe2-5f6e-5af3-b0dc-03f636f5e40e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265467}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "78f7d23e-60ed-507c-b4f6-6101bce65778" :question/math-academy-id "q-129495" :question/problem "Find $AB$, if\n$A=\\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}$" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-15=2\\cdot (-3)+(-1)\\cdot 6+1\\cdot (-3) \\\\  & \\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & 3 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,3=2\\cdot 2+(-1)\\cdot 5+1\\cdot 4 \\\\  & \\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & 3 \\\\ -9 & ∗\\end{bmatrix}, &  & \\,-9=1\\cdot (-3)+0\\cdot 6+2\\cdot (-3) \\\\  & \\begin{bmatrix}-2 & 1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}, &  & \\,10=1\\cdot 2+0\\cdot 5+2\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30980b36-8778-5a51-89b8-a81fc027883f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}22 & 9\\end{bmatrix}" :db/id #edb/ref 17592186263413} {:answer/id #uuid "3bd13396-77b3-54fa-8ae9-6c7200fc84bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 12\\end{bmatrix}" :db/id #edb/ref 17592186263533} {:answer/id #uuid "7e0eeffe-95e5-570e-9c36-aea6b4fd89db" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 9\\end{bmatrix}" :db/id #edb/ref 17592186264086} {:answer/id #uuid "975b44bb-df10-5292-a437-e855bf7bd551" :answer/type {:db/ident :answ