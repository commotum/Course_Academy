gned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3x+4}\\,\\text{d}x=\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|).\n$$"} {:db/id #edb/ref 17592186339116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} {:answer/id #uuid "6ae31738-7e11-5b61-bda5-73b51a186dc1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336978} {:answer/id #uuid "9dd74f15-1558-5167-ae1a-0738b496e927" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337459} {:answer/id #uuid "afeaa9dd-27fb-515f-9b9a-a9fc160293f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337612} {:answer/id #uuid "c8d07741-d286-59ef-b0bc-34120b2124b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337807}] :answer-field/correct {:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} :answer-field/id #uuid "14072edb-e48a-597d-a3df-afce4caaaa51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338311}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b16baf99-001c-5b72-bc61-2ffc6c75b449" :question/math-academy-id "q-72445" :question/problem "Calculate $\\int \\frac{1}{7-x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=7-x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{7-x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|+C \\\\  & =-\\operatorname{ln}⁡|7-x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\operatorname{ln}⁡|7-x|+C & =-\\operatorname{ln}⁡|7-x|-\\operatorname{ln}⁡K \\\\  & =-(\\operatorname{ln}⁡|7-x|+\\operatorname{ln}⁡K) \\\\  & =-\\operatorname{ln}⁡(K|7-x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{7-x}\\,\\text{d}x=-\\operatorname{ln}⁡(K|7-x|).\n$$"} {:db/id #edb/ref 17592186339117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b76063-8fda-596f-8106-cbb57f2ef69a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186336093} {:answer/id #uuid "86f6a2e9-4d29-5e23-9617-09660280aaa3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337252} {:answer/id #uuid "b4ead48b-c59a-570e-a7de-39bcbc22b8fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337638} {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} {:answer/id #uuid "f6322442-f9d7-5f7c-ac2d-896d214f1436" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186338188}] :answer-field/correct {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id 