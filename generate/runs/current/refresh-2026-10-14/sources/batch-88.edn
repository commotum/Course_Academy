#uuid "521d6737-f622-5a95-8205-2c2c5f2e0873" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{10}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491390} {:answer/id #uuid "604a9ab2-ffa7-55cc-8e05-8521cfeb2098" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491393}] :answer-field/correct {:answer/id #uuid "3b32f0fe-afd1-5f2f-bd1e-9943f2d38376" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491385} :answer-field/id #uuid "4b8ae8f2-247f-5d06-abb6-af657a1cd8b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491388}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d9f41743-b83b-587e-a674-fcd409f35761" :question/problem "Calculate $\\int \\frac{6}{5-5x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{6}{5-5x}\\,\\text{d}x & =6\\int \\frac{1}{5-5x}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{u}\\cdot (-\\frac{1}{5})\\,\\text{d}u \\\\  & =-\\frac{6}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{6}{5}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|+C & =-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|-\\frac{6}{5}\\operatorname{ln}⁡K \\\\  & =-\\frac{6}{5}(\\operatorname{ln}⁡|5-5x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{6}{5-5x}\\,\\text{d}x=-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|).\n$$"} {:db/id #edb/ref 17592186491404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed309e1-7fed-5611-88ea-d3f7f560e643" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491380} {:answer/id #uuid "2d5ba678-fb47-535d-94c1-f60655b4d9d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491383} {:answer/id #uuid "593e3a6a-f60c-5f0d-9379-e7310c6ecf8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{|6x+2|}{K})" :db/id #edb/ref 17592186491391} {:answer/id #uuid "5e575092-4b7d-5a7a-b65e-eccaca74bbfe" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491392} {:answer/id #uuid "792e0c84-eee3-5f47-9343-9bd165f08572" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{K}{6}\\operatorname{ln}⁡(|6x+2|)" :db/id #edb/ref 17592186491395}] :answer-field/correct {:answer/id #uuid "2d5ba678-fb47-535d-94c1-f60655b4d9d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491383} :answer-field/id #uuid "85668fa6-214c-50d9-8486-30cba7ace9ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491398}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e5cc660e-d261-5bf0-a86d-22509ddcb061" :question/problem "Calculate $\\int \\frac{1}{6x+2}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=6x+2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{6x+2}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{6}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+C & =\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+\\frac{1}{6}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{6}(\\operatorname{ln}⁡|6x+2|+\\operatorname{ln}⁡K) \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{6x+2}\\,\\text{d}x=\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|).\n$$"}] :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] [{:db/id #edb/ref 17592186064208 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064079 :question/id #uuid "2c4912bd-290a-5074-b11b-459c77b7e238" :question/math-academy-id "e-451" :question/problem "Calculate $\\displaystyle \\int\\left(\\dfrac{1}{1+2x} + \\dfrac{1}{1-2x}\\right)\\,\\textrm d x.$" :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{1+2x}+\\frac{1}{1-2x})\\,\\text{d}x & =\\int \\frac{1}{1+2x}\\,\\text{d}x+\\int \\frac{1}{1-2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|1+2x|-\\frac{1}{2}\\operatorname{ln}⁡|1-2x|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|\\frac{1+2x}{1-2x}|+\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{1+2x}{1-2x}|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."} :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049195 :topic/math-academy-id 30 :topic/title "Combining the Laws of Logarithms"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfd2d2ed-bde7-5852-ad54-9413725ba362" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\ln (K \\mid (3 + x)(3 - x) \\mid)" :db/id #edb/ref 17592186063289} {:answer/id #uuid "06ecf633-c157-551a-801c-b3e0b80c46a0" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (K \\mid (3 + x)(3 - x) \\mid)" :db/id #edb/ref 17592186063290} {:answer/id #uuid "347ee57e-dc21-5601-aedd-39623b12b425" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\ln (K \\mid \\frac{3 + x}{3 - x} \\mid)" :db/id #edb/ref 17592186063291} {:answer/id #uuid "4c19a150-4fe0-5943-b867-d733575701f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\ln (K \\mid \\frac{3 + x}{3 - x} \\mid)" :db/id #edb/ref 17592186063292} {:answer/id #uuid "71e8148c-1259-51b8-bd1f-7beb91b85ac4" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (K \\mid \\frac{3 + x}{3 - x} \\mid)" :db/id #edb/ref 17592186063293}] :answer-field/id #uuid "e59dbe5d-4bf3-5d80-b1d4-17a7f8bd063b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063288}] :question/id #uuid "73d57d7a-3b1c-55f0-9005-5f9ae1e1f6c5" :question/math-academy-id "q-49521" :question/problem "What is $\\displaystyle \\int(\\frac{1}{3 + x} + \\frac{1}{3 - x})dx$?"} {:db/id #edb/ref 17592186064873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01c17ae9-f850-5069-a775-ba205fbf2d58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|(2+4x)(2-4x)|)" :db/id #edb/ref 17592186329972} {:answer/id #uuid "140c5f12-84