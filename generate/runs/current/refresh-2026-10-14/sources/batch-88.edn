pe {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(4)}{6}" :db/id #edb/ref 17592186246443}] :answer-field/correct {:answer/id #uuid "f1583875-29dd-54fe-8736-666f2cd465ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(4)}{6}" :db/id #edb/ref 17592186246443} :answer-field/id #uuid "e47922e5-1281-5fc5-b42e-037d9d684004" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246953}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4f496a56-4bd2-5cbc-b0fa-ae68e7d900e8" :question/math-academy-id "q-113747" :question/problem "Calculate the definite integral ${\\int }_{0}^{1}\\frac{x}{3{x}^{2}+1}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =3{x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =6x \\\\ \\text{d}u & =6x\\,\\text{d}x \\\\ \\frac{1}{6}\\,\\text{d}u & =x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=3{x}^{2}+1.$\n\n$$\n\\begin{aligned}x & 0 & 1 \\\\ u & 1 & 4\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\frac{1}{3{x}^{2}+1}\\cdot x\\,\\text{d}x={\\int }_{1}^{4}\\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u & =\\frac{1}{6}{\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡(u){|}_{1}^{4} \\\\  & =\\frac{1}{6}(\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(1)) \\\\  & =\\frac{\\operatorname{ln}⁡(4)}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031259ca-bfb9-5b7f-b6a8-7ce7b040a7bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)-3\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186263028} {:answer/id #uuid "4b0fb49c-cf37-5bbb-ac4b-cd15a80ea2e3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186263646} {:answer/id #uuid "502e4a3c-5767-5bad-afb9-566bff4bbf5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186263695} {:answer/id #uuid "c86b65c3-42d2-51bf-ab55-3ddc8c7be580" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186264756} {:answer/id #uuid "ef28c228-7495-5093-98b4-f9461d7bffc4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186265098}] :answer-field/correct {:answer/id #uuid "c86b65c3-42d2-51bf-ab55-3ddc8c7be580" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186264756} :answer-field/id #uuid "ebf4a5a8-46b3-57bc-9d21-211323b280d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265667}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1aaf83f-8e31-580d-be7a-f74704e40ada" :question/math-academy-id "q-13189" :question/problem "Evaluate the definite integral ${\\int }_{1}^{2}\\frac{1}{3x+2}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =3x+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3 \\\\ \\text{d}u & =3\\,\\text{d}x \\\\ \\frac{1}{3}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=3x+2.$\n\n$$\n\\begin{aligned}x & 1 & 2 \\\\ u & 5 & 8\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{2}\\frac{1}{(3x+2)}\\,\\text{d}x={\\int }_{5}^{8}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{5}^{8}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u & =\\frac{1}{3}{\\int }_{5}^{8}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(u){|}_{5}^{8} \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡(8)-\\operatorname{ln}⁡(5)) \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡({2}^{3})-\\operatorname{ln}⁡(5)) \\\\  & =\\frac{1}{3}(3\\operatorname{ln}⁡(2)-\\operatorname{ln}⁡(5)) \\\\  & =\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09593aa7-e83c-5ed6-bd45-53082a45f236" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186275556} {:answer/id #uuid "427f4434-8739-5b25-89a8-d80cac27109a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186276062} {:answer/id #uuid "6f3bd312-ab75-552a-b307-9bca8f6476bd" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186276475} {:answer/id #uuid "cfb881b2-920d-54a5-aff7-6fe14e3fe893" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186277315} {:answer/id #uuid "ebdc4a49-01c7-5dd4-bf20-8ed5030b45d0" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186277544}] :answer-field/correct {:answer/id #uuid "6f3bd312-ab75-552a-b307-9bca8f6476bd" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186276475} :answer-field/id #uuid "0e6fd52e-8813-5b8c-897f-9d1d6a0937c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277753}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bcd00089-dfc9-5b87-bbb7-bcf6555185c4" :question/math-academy-id "q-15877" :question/problem "${\\int }_{5}^{8}\\frac{-4}{x-4}\\,\\text{d}x=$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =x-4 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =1 \\\\ \\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=x-4.$\n\n$$\n\\begin{aligned}x & 5 & 8 \\\\ u & 1 & 4\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{5}^{8}\\frac{-4}{(x-4)}\\,\\text{d}x={\\int }_{1}^{4}\\frac{-4}{u}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{-4}{u}\\,\\text{d}u & =-4{\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =-4\\operatorname{ln}⁡(u){|}_{1}^{4} \\\\  & =-4(\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(1)) \\\\  & =-4\\operatorname{ln}⁡({2}^{2}) \\\\  & =-4\\cdot 2\\operatorname{ln}⁡(2) \\\\  & =-8\\operatorname{ln}⁡(2).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f6ea38-ad07-544d-adb3-fd783dc6bad1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186285136} {:answer/id #uuid "77597546-fe44-5699-b67c-30138509c486" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186285897} {:answer/id #uuid "978fa7ab-3aea-5887-996b-b02b82c18b02" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186286168} {:answer/id #uuid "b3fa9ef9-82a0-522d-a8f3-95180cd52333" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186286427} {:answer/id #uuid "f2c84326-79c6-56cd-a471-12eed180a2a9" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186287012}] :answer-field/correct {:answer/id #uuid "b3fa9ef9-82a0-522d-a8f3-95180cd52333" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186286427} :answer-field/id #uuid "e17b8a67-5342-5ca5-b903-1f2b7600caba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287611}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e4159a01-b72c-51c2-a983-4428dc1372a4" :question/math-academy-id "q-19129" :question/problem "Calculate the definite integral ${\\int }_{0}^{2}\\frac{4x}{1+{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =1+{x}^{2} \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2x \\\\ \\text{d}u & =2x\\,\\text{d}x \\\\ 2\\,\\text{d}u & =4x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=1+{x}^{2}.$\n\n$$\n\\begin{aligned}x & 0 & 2 \\\\ u & 1 & 5\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\frac{1}{(1+{x}^{2})}\\cdot 4x\\,\\text{d}x={\\int }_{1}^{5}\\frac{1}{u}\\cdot 2\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{1}{u}\\cdot 2\\,\\text{d}u & =2{\\int }_{1}^{5}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡(u){|}_{1}^{5} \\\\  & =2(\\operatorname{ln}⁡(5)-\\operatorname{ln}⁡(1)) \\\\  & =2\\operatorname{ln}⁡(5).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "752af0da-dbae-5520-b62b-cf96e0283d3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}(\\frac{11}{3})" :db/id #edb/ref 17592186309661}] :answer-field/correct {:answer/id #uuid "752af0da-dbae-5520-b62b-cf96e0283d3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}(\\frac{11}{3})" :db/id #edb/ref 17592186309661} :answer-field/id #uuid "09205559-5a9a-53bf-8f0c-47fbdcd2d6a5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310819}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "999290d3-e880-5065-9964-ee6f1b8bd7a7" :question/math-academy-id "q-336717" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{1}^{3}\\frac{1}{4x-1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =4x-1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4 \\\\ \\text{d}u & =4\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=4x-1.$\n\n$$\n\\begin{aligned}x & 1 & 3 \\\\ u & 3 & 11\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{3}\\frac{1}{(4x-1)}\\,\\text{d}x={\\int }_{3}^{11}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{11}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{3}^{11}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{3}^{11} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(11)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}ln\\,(\\frac{11}{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346c66fa-7cd0-5539-a484-a3d7c3d37a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}(\\frac{9}{4})" :db/id #edb/ref 17592186309147}] :answer-field/correct {:answer/id #uuid "346c66fa-7cd0-5539-a484-a3d7c3d37a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}(\\frac{9}{4})" :db/id #edb/ref 17592186309147} :answer-field/id #uuid "80f925dd-1cec-502d-a118-9bf74b6846b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311148}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cb5be3ea-fe7c-5ca2-a3b9-f4f0c7f3fd0b" :question/math-academy-id "q-336729" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{0}^{1}\\frac{10{x}^{3}}{5{x}^{4}+4}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =5{x}^{4}+4 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =20{x}^{3} \\\\ \\text{d}u & =20{x}^{3}\\,\\text{d}x \\\\ \\frac{1}{20}\\text{d}u & ={x}^{3}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=5{x}^{4}+4.$\n\n$$\n\\begin{aligned}x & 0 & 1 \\\\ u & 4 & 9\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\frac{10{x}^{3}}{(5{x}^{4}+4)}\\,\\text{d}x={\\int }_{4}^{9}\\frac{10}{u}\\cdot \\frac{1}{20}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}\\frac{10}{u}\\cdot \\frac{1}{20}\\text{d}u & =\\frac{1}{2}{\\int }_{4}^{9}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(u){|}_{4}^{9} \\\\  & =\\frac{1}{2}(\\operatorname{ln}⁡(9)-\\operatorname{ln}⁡(4)) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{9}{4}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186311745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70e64df3-40fb-5dfe-b47f-cb59b54de51f" :answer/type {:db/ident :answer.type/math} :answer/value "6-3\\sqrt{2}" :db/id #edb/ref 17592186309626}] :answer-field/correct {:answer/id #uuid "70e64df3-40fb-5dfe-b47f-cb59b54de51f" :answer/type {:db/ident :answer.type/math} :answer/value "6-3\\sqrt{2}" :db/id #edb/ref 17592186309626} :answer-field/id #uuid "fc14edd4-00a2-5561-9b13-b0709465094a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186311534}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "abe680fd-d2f9-5e02-bf28-2364a659dfbf" :question/math-academy-id "q-336745" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{0}^{1}\\frac{6x}{\\sqrt{{({x}^{2}+1)}^{3}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2x \\\\ \\text{d}u & =2x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{2}+1.$\n\n$$\n\\begin{aligned}x & 0 & 1 \\\\ u & 1 & 2\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\frac{6x}{\\sqrt{{({x}^{2}+1)}^{3}}}\\,\\text{d}x={\\int }_{1}^{2}\\frac{3}{\\sqrt{{u}^{3}}}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}3{u}^{-3/2}\\,\\text{d}u & ={-\\frac{6}{\\sqrt{u}}|}_{1}^{2} \\\\  & =-\\frac{6}{\\sqrt{2}}+\\frac{6}{\\sqrt{1}} \\\\  & =6-\\frac{6}{\\sqrt{2}} \\\\  & =6-3\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd377a2-95d6-5fde-b6fb-edd9f6c82895" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339404} {:answer/id #uuid "3886b9bb-57fc-5b04-9e14-43198654677d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339636} {:answer/id #uuid "a97ece83-bf8e-5d12-9343-39690fdb4170" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186340671} {:answer/id #uuid "ba478bc4-e72f-56ec-9e2c-5aa0ce4151f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186340796} {:answer/id #uuid "ea3a1f4f-8538-5b6c-a02c-9ceb12a2d036" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186341196}] :answer-field/correct {:answer/id #uuid "ea3a1f4f-8538-5b6c-a02c-9ceb12a2d036" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186341196} :answer-field/id #uuid "1d077c61-6966-5590-ac4c-55b42acccc9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341432}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "76b52539-5773-539b-aa13-33f834965a19" :question/math-academy-id "q-73432" :question/problem "Calculate the definite integral ${\\int }_{0}^{2}\\frac{{x}^{3}}{{x}^{4}+9}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{4}+9 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3} \\\\ \\text{d}u & =4{x}^{3}\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & ={x}^{3}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{4}+9.$ \n\n$$\n\\begin{aligned}x & 0 & 2 \\\\ u & 9 & 25\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\frac{1}{({x}^{4}+9)}\\,{x}^{3}\\,\\text{d}x={\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{9}^{25}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{9}^{25} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(25)-\\operatorname{ln}⁡(9)) \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡({5}^{2})-\\operatorname{ln}⁡({3}^{2})) \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡(5)-2\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}\\cdot 2(\\operatorname{ln}⁡(5)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a79382-4e7c-5565-8f8d-651f202629f3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339292} {:answer/id #uuid "5502a3b1-d9e4-5a34-9dd4-491eeed2b23f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186339908} {:answer/id #uuid "7087f43f-c9bf-565d-98ab-1b54c5d110f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186340127} {:answer/id #uuid "82ee8f5a-e3ab-507f-9c16-8da87f52b8bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186340304} {:answer/id #uuid "edc21a13-792e-5848-97d2-4e2185d5c45b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186341227}] :answer-field/correct {:answer/id #uuid "82ee8f5a-e3ab-507f-9c16-8da87f52b8bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186340304} :answer-field/id #uuid "d1ca444a-b6c3-53c4-8f09-a91cb7eeef34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341749}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "12e14ad3-9d99-5fee-b75f-bd6aa0861881" :question/math-academy-id "q-73434" :question/problem "Calculate the definite integral ${\\int }_{-1}^{1}\\frac{{x}^{2}}{{x}^{3}+2}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{3}+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2} \\\\ \\text{d}u & =3{x}^{2}\\,\\text{d}x \\\\ \\frac{1}{3}\\text{d}u & ={x}^{2}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{3}+2.$ \n\n$$\n\\begin{aligned}x & -1 & 1 \\\\ u & 1 & 3\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{-1}^{1}\\frac{1}{({x}^{3}+2)}\\,{x}^{2}\\,\\text{d}x={\\int }_{1}^{3}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(u){|}_{1}^{3} \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡(3)-\\operatorname{ln}⁡(1)) \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(3).\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Definite Integral of a Rational Function Using Substitution"}]}
