 {:answer/id #uuid "3cab3961-9873-5028-99db-92118b7dacac" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{157}" :db/id #edb/ref 17592186057119}] :answer-field/id #uuid "c8bc4442-f564-5392-8824-4c50f5f84d3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057114}] :question/id #uuid "9ada1995-eb39-5223-994f-7ad65f7c8096" :question/math-academy-id "q-18046" :question/problem "Let $a = ⟨ - 12, 3⟩$. Find $\\mid a \\mid$.\n\n> A scientific calculator is required to answer this question."} {:db/id #edb/ref 17592186233594 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b8c6e450-fe10-5923-accc-8b824e3c81c1" :question/math-academy-id "q-18047" :question/problem "Let $a=⟨5,9⟩.$ Find $|\\,a\\,|.$" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(5)^{2}+(9)^{2}} \\\\  & =\\sqrt{25+81} \\\\  & =\\sqrt{106}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233595 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "26fce79e-92f6-594d-aec2-af45c6145c5c" :question/math-academy-id "q-18048" :question/problem "if $a=⟨-4,8⟩$, then  what is the magnitude of  $a?$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+(8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =\\sqrt{16\\cdot 5} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079b9a79-06f2-5db8-b532-db1a9740e2a6" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186501340} {:answer/id #uuid "16cda31a-522e-5e9a-a392-a12fa93be895" :answer/type {:db/ident :answer.type/math} :answer/value "7 \\sqrt{17}" :db/id #edb/ref 17592186501345} {:answer/id #uuid "3526a895-cf9a-5109-8227-ed027b72f819