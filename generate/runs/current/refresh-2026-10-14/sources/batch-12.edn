/ident :answer.type/math} :answer/value "(-\\infty ,\\sqrt{2})" :db/id #edb/ref 17592186482937} {:answer/id #uuid "631e7e91-f606-52be-bde6-7906debd7ca2" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\sqrt{2},\\sqrt{2}]" :db/id #edb/ref 17592186482987} {:answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186483030} {:answer/id #uuid "ea146e9c-cd0f-5d3f-a757-f080a85565c3" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186483205}] :answer-field/correct {:answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186483030} :answer-field/id #uuid "657476d4-a8fb-55ad-87cf-4c749b0e1c83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483274}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c556bd18-7997-5c17-980e-bee5855d1c3c" :question/math-academy-id "q-154704" :question/problem "The inequality $-\\sqrt{2}<x<\\sqrt{2}$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-\\sqrt{2}$ and $\\sqrt{2}$ are *not* included. \n\n$$\n-\\sqrt{2}\\,\\,<\\,\\,x\\,\\,<\\,\\,\\sqrt{2}\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-\\sqrt{2},\\sqrt{2})\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-\\sqrt{2},\\sqrt{2}).\n$$"} {:db/id #edb/ref 17592186502734 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034bd5c3-e174-5944-895b-0214bf8e479e" :answer/type {:db/ident :answer.