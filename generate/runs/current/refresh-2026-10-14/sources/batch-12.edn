9} {:answer/id #uuid "ca372480-9e23-56cc-b29f-25f7cd95b354" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-13,0⟩" :db/id #edb/ref 17592186509649} {:answer/id #uuid "ff0cf2d9-3d89-55eb-a0c9-2a5f9b334665" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-40,-25⟩" :db/id #edb/ref 17592186509663}] :answer-field/correct {:answer/id #uuid "087dd19a-b630-5df2-8c4a-2bbf271158e6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨40,-25⟩" :db/id #edb/ref 17592186509630} :answer-field/id #uuid "eb6d8e58-be63-564f-9ff0-983d30d3d437" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509657}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fd331529-f190-56d9-afa5-df2361ebb88a" :question/problem "If $\\overset{\\to }{v} = ⟨8,-5⟩$, then $5\\overset{\\to }{v} =$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}5\\overset{\\to }{v} &= 5\\cdot ⟨8,-5⟩ \\\\ &= ⟨5\\cdot 8,5\\cdot (-5)⟩ \\\\ &= ⟨40,-25⟩\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Sums and Scalar Multiplication of Vectors Given in Alternative Notation"}] [{:db/id #edb/ref 17592186059714 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059527 :question/id #uuid "e2b211fe-d37a-55dd-bf76-9ffab2b6f128" :question/math-academy-id "e-4297" :question/problem "Let $\\mathbf{a}=\\langle -4, 6 \\rangle$. Find $\\mid \\,\\mathbf{a}\\, \\mid$." :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}\n\\mid a \\mid &= \\sqrt{a_{x}^{2} + a_{y}^{2}} \\\\\n&= \\sqrt{(-4)^{2} + (6)^{2}} \\\\\n&= \\sqrt{16 + 36} \\\\\n&= 2\\sqrt{13}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048882 :topic/math-academy-id 1101 :topic/title "The Magnitude of a Vector"}] :knowledge-point/q