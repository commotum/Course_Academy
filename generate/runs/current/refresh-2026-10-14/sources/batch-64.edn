rname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259} :answer-field/id #uuid "c4f33047-2f0b-50bf-84ac-e403b1fabf2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341723}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "958efc2b-d91b-53e5-b712-1690bc1b7068" :question/math-academy-id "q-72605" :question/problem "$\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14754cfc-feeb-534b-989b-a2eadef64916" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}\\left|x^{3} - 4\\right|+C" :db/id #edb/ref 17592186485646} {:answer/id #uuid "3293c679-5e91-5171-9636-02a7747eba9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}\\left|x^{3} - 4 x\\right|+C" :db/id #edb/ref 17592186485647} {:answer/id #uuid "3d942fe6-71c1-5d46-8d24-79f1eaaf07ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}\\left|\\frac{1}{x^{3} - 4}\\right|+C" :db/id #edb/ref 17592186485648} {:answer/id #uuid "5987b091-fcdd-5b19-9fa7-5c0ee6bc7a19" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}\\left|3 x^{2} - 4\\right|+C" :db/id #edb/ref 17592186485649} {:answer/id #uuid "ad07f07f-d4ea-5118-abbe-219e9d3be0b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}\\left|3 x^{2} - 4 x\\right|+C" :db/id #edb/ref 17592186485651}] :answer-field/correct {:answer/id #uuid "3293c679-5e91-5171-9636-02a7747eba9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}\\left|x^{3} - 4 x\\right|+C" :db/id #edb/ref 17592186485647} :answer-field/id #uuid "df85561f-f3cd-53b4-9771-d8dc2ea256d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485652}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7d1f4346-0ddf-5d6f-9434-8141c2640699" :question/problem "$\\int \\frac{3 x^{2} - 4}{x^{3} - 4 x}\\,\\text{d}x=$" :question/worked-solution "Let $u=x^{3} - 4 x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3 x^{2} - 4\\,⟹\\,\\text{d}u=(3 x^{2} - 4)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3 x^{2} - 4}{x^{3} - 4 x}\\,\\text{d}x & =\\int \\frac{1}{x^{3} - 4 x}\\cdot (3 x^{2} - 4)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}|u|+C \\\\  & =\\operatorname{ln}\\left|x^{3} - 4 x\\right|+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}]}
