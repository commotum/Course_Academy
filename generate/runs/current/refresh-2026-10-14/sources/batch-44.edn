#{[{:db/id #edb/ref 17592186064178 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064052 :question/id #uuid "a9671d61-6b85-5d84-b49c-a6443569f6c0" :question/math-academy-id "e-382" :question/problem "Calculate $\\displaystyle \\int 3\\sin{x}\\,\\textrm d x.$" :question/worked-solution "Recall that\n\n$$\n\\int \\sin x \\, \\textrm dx = -\\cos x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 3sin⁡x\\,\\text{d}x & =3\\int sin⁡x\\,\\text{d}x \\\\  & =3(-cos⁡x)+C \\\\  & =-3cos⁡x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048442 :topic/math-academy-id 43 :topic/title "The Constant Multiple Rule for Indefinite Integrals"} {:db/id #edb/ref 17592186050321 :topic/math-academy-id 3769 :topic/title "The Sum Rule for Indefinite Integrals"} {:db/id #edb/ref 17592186050420 :topic/math-academy-id 280 :topic/title "Differentiating Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a586423-82a8-52b3-b714-e15c8e71c4d9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sin y + C" :db/id #edb/ref 17592186061544} {:answer/id #uuid "8d664539-03c5-5ddb-bdf5-bdfae01d1f3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin y + C" :db/id #edb/ref 17592186061545} {:answer/id #uuid "e22ce7c2-7884-59c9-9565-c7fcfd4c2ed6" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin y + C" :db/id #edb/ref 17592186061546} {:answer/id #uuid "385561fe-4eb3-5d10-a0f5-f926e2992f0e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos y + C" :db/id #edb/ref 17592186061547} {:answer/id #uuid "516532c4-9d7c-5444-85fc-ed8da50b326e" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cos y + C" :db/id #edb/ref 17592186061548}] :answer-field/id #uuid "9916dff2-a748-502c-9153-ace01d99b478" :answer-field/key "selection" :answ