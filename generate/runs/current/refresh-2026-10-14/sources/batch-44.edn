C \\\\  & =9sin⁡x-7cos⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479274 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038bee05-fc17-560d-81a4-eddee2941c17" :answer/type {:db/ident :answer.type/math} :answer/value "9sin⁡x+4cos⁡x+C" :db/id #edb/ref 17592186479239} {:answer/id #uuid "4bd519e1-ed02-5fc1-a625-19ec561e5d65" :answer/type {:db/ident :answer.type/math} :answer/value "4cos⁡x-9sin⁡x+C" :db/id #edb/ref 17592186479246} {:answer/id #uuid "4d798e26-0fbf-501d-afea-4118652df824" :answer/type {:db/ident :answer.type/math} :answer/value "9sin⁡x-4cos⁡x+C" :db/id #edb/ref 17592186479247} {:answer/id #uuid "5df67844-abdc-564c-a0ff-63a81d44554b" :answer/type {:db/ident :answer.type/math} :answer/value "4sin⁡x-9cos⁡x+C" :db/id #edb/ref 17592186479250} {:answer/id #uuid "d721b877-ea95-5c96-95da-6cd996dc29e1" :answer/type {:db/ident :answer.type/math} :answer/value "9cos⁡x-4sin⁡x+C" :db/id #edb/ref 17592186479270}] :answer-field/correct {:answer/id #uuid "4d798e26-0fbf-501d-afea-4118652df824" :answer/type {:db/ident :answer.type/math} :answer/value "9sin⁡x-4cos⁡x+C" :db/id #edb/ref 17592186479247} :answer-field/id #uuid "b25534a8-b217-59fa-8c39-60ec8bc3ad53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479263}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e29c1749-87aa-51fb-995a-b651c655a77b" :question/problem "$\\int (9cos⁡x+4sin⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (9cos⁡x+4sin⁡x)\\,\\text{d}x & =9\\int cos⁡x\\,\\text{d}x+4\\int sin⁡x\\,\\text{d}x \\\\  & =9sin⁡x+4(-cos⁡x)+C \\\\  & =9sin⁡x-4cos⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cos x" :db/id #edb/ref 17592186513601}] :answer-field/correct {:answer/id #uuid "1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cos x" :db/id #edb/ref 17592186513601} :answer-field/id #uuid "685c059e-7098-5c75-b848-36830bd2c7c1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514277}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2932e26e-2b57-549a-866d-7abe171c7f20" :question/math-academy-id "q-166078" :question/problem "$\\int h(x)\\,\\text{d}x\\,=${{field-1}}\n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int h(x)\\,\\text{d}x & =\\int -4\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{cos}⁡x+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] :knowledge-point/title "Integrating Sine and Cosine"}] [{:db/id #edb/ref 17592186064181 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064055 :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/math-academy-id "e-385" :question/problem "Calculate the integral $\\displaystyle{\\int} \\csc{x}(\\csc{x}+3\\cot{x} )\\, \\textrm{d}x.$" :question/worked-solution "Recall that \n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\int csc⁡x(csc⁡x+3cot⁡x)\\,\\text{d}x & =\\int {csc}^{2}⁡x+3csc⁡xcot⁡x\\,\\text{d}x \\\\  & =\\int {csc}^{2}⁡x\\,\\text{d}x+3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-cot⁡x-3csc⁡x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-poin