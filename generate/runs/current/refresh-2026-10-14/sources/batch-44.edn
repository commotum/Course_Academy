{2}}\\right)\\cdot y & =\\left(e^{2 x^{2}}\\right)\\cdot \\left(2 x e^{- 2 x^{2}}\\right)\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x)):$\n\n$$\n\\begin{aligned}\\frac{d}{dx}\\left(y\\cdot \\left(e^{2 x^{2}}\\right)\\right) & =\\left(e^{2 x^{2}}\\right)\\cdot \\left(2 x e^{- 2 x^{2}}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186495328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59eeb590-79fd-58f7-ad78-207852a155dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(e^{3 x^{2}}\\right)\\right)=\\left(e^{3 x^{2}}\\right)\\cdot \\left(2 x e^{3 x^{2}}\\right)" :db/id #edb/ref 17592186495330} {:answer/id #uuid "68f5ac64-b832-5951-bffe-8ffd8ba5cf8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(e^{- 3 x^{2}}\\right)\\right)=\\left(e^{- 3 x^{2}}\\right)\\cdot \\left(2 x e^{3 x^{2}}\\right)" :db/id #edb/ref 17592186495332} {:answer/id #uuid "7de2f377-86ef-5ea6-a299-49f2f2a98bf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(x^{2}\\right)\\right)=\\left(x^{2}\\right)\\cdot \\left(2 x e^{3 x^{2}}\\right)" :db/id #edb/ref 17592186495340} {:answer/id #uuid "84fe84eb-4e89-56b7-9e40-585553aea026" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(e^{6 x}\\right)\\right)=\\left(e^{6 x}\\right)\\cdot \\left(2 x e^{3 x^{2}}\\right)" :db/id #edb/ref 17592186495342} {:answer/id #uuid "e2217242-e42e-5522-8af0-a8daa9849881" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(e^{3 x}\\right)\\right)=\\left(e^{3 x}\\right)\\cdot \\left(2 x e^{3 x^{2}}\\right)" :db/id #edb/ref 17592186495366}] :answer-field/correct {:answer/id #uuid "59eeb590-79fd-58f7-ad78-207852a155dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(e^{3 x^{2}}\\right)\