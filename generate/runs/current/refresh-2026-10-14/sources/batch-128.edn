.type/math} :answer/value "115" :db/id #edb/ref 17592186510610} {:answer/id #uuid "c928ad02-b344-5e24-a7d6-2cb2e76b8a64" :answer/type {:db/ident :answer.type/math} :answer/value "225" :db/id #edb/ref 17592186510616}] :answer-field/correct {:answer/id #uuid "8b00f4b7-d970-56a3-806a-2fa066818eb3" :answer/type {:db/ident :answer.type/math} :answer/value "335" :db/id #edb/ref 17592186510605} :answer-field/id #uuid "4ce62e8c-ff19-5b5a-a636-830fc7ba65dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510595}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b23310d1-b6de-5e56-8977-6813a00c8cb9" :question/problem "$|\\begin{aligned}-15 & -11 \\\\ 10 & -15\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}-15 & -11 \\\\ 10 & -15\\end{aligned}| & =-15\\cdot (-15)-(-11)\\cdot 10 \\\\  & =225-(-110) \\\\  & =335\\end{aligned}\n$$"} {:db/id #edb/ref 17592186510617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45482320-ca91-5c71-a92c-e0a8ce03cdb5" :answer/type {:db/ident :answer.type/math} :answer/value "156" :db/id #edb/ref 17592186510594} {:answer/id #uuid "680e2bfe-fb61-5d5e-8dcb-8e656b48c082" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186510601} {:answer/id #uuid "7d3723d1-3bbb-5378-bdf1-8adae692d227" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186510604} {:answer/id #uuid "c6097b50-9415-5938-9802-60334296d427" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186510615} {:answer/id #uuid "f5822848-cd15-5ab7-809a-95aee17f1031" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186510620}] :answer-field/correct {:answer/id #