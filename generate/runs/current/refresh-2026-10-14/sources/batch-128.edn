 \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}| \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$"} :knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048896 :topic/math-academy-id 861 :topic/title "Introduction to Matrices"}] :knowledge-point/questions [{:db/id #edb/ref 17592186059980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bef9d71-e6eb-54e4-8e8e-a529aa8f1992" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186241284} {:answer/id #uuid "af58227c-7285-5719-b8ee-6e95dc121818" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186242708} {:answer/id #uuid "b33e532a-b90d-5de2-812f-858d1ea4ce57" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186242741} {:answer/id #uuid "b7782812-7471-5927-8799-42fa4e8f2c90" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186242786} {:answer/id #uuid "d690db23-f51d-5c54-a3fe-07d2f24b9b75" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186243082}] :answer-field/correct {:answer/id #uuid "0bef9d71-e6eb-54e4-8e8e-a529aa8f1992" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186241284} :answer-field/id #uuid "bbd1e424-be57-57db-8709-ae267fc7b54a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243770}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67459f8a-4276-51e0-8ff0-10c56a6d248e" :question/math-academy-id "q-1079" :question/problem "Calculate $\\text{det}(A)$, if\n$A=\\begin{bmatrix}1 & 2 \\\\ 3 & 0\\end{bmatrix}.$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(A) & =|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}| \\\\  & =1\\cdot 0-2\\cdot 3 \\\\  & =0-6 \\\\  & =-6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186060000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adeef685-13ff-59be-8555-fa285a4b673e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186056359} {:answer/id #uuid "e93e332c-0067-5a8e-978e-451498a19a05" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056360} {:answer/id #uuid "09a86a42-c0b8-57e0-a93a-e191a7d6b5f7" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186056361} {:answer/id #uuid "0a801cc5-5312-593f-9422-e650a8b22f74" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186056362} {:answer/id #uuid "3f33f5eb-9069-5dcd-955b-ccc0b698801b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186056363}] :answer-field/id #uuid "809ecc7b-96f9-5877-beda-07f945eee167" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056358}] :question/id #uuid "ea87b1ac-4625-5a01-8d70-68a1975a00a3" :question/math-academy-id "q-11648" :question/problem "What is $\\begin{vmatrix}2 & -4 \\\\ -2 & 7\\end{vmatrix}$?"} {:db/id #edb/ref 17592186244112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "089d503b-4f24-5763-9960-5ba89a429460" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186241256} {:answer/id #uuid "1e118c0a-4e95-58e5-a976-91027b338e8e" :answer/type {:db/ident :answer.type/math} :answer/value "-34" :db/id #edb/ref 17592186241438} {:answer/id #uuid "7326fac1-3a0a-542f-ada6-d08f1f8e9903" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186242201} {:answer/id #uuid "8d44a50