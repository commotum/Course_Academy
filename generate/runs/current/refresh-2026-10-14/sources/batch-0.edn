7383a40-44c5-5a00-bfa0-07f13c0dcbe6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336953} {:answer/id #uuid "b945ae93-7849-5d6e-b645-1e8c14a1d6cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{1/2x}+C" :db/id #edb/ref 17592186337675} {:answer/id #uuid "fbb744da-ccfd-5f44-8169-07909ef53f32" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186338242}] :answer-field/correct {:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} :answer-field/id #uuid "f9fc2e0f-aa1f-50b5-8ba0-74df5403bd7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338718}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7119fae9-f265-530e-8dcf-9a8fd6ab825e" :question/math-academy-id "q-71900" :question/problem "$\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $\\frac{1}{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x & =\\frac{1}{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{x}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2617015a-5455-5667-ad50-b136e5b1fa55" :answer/type {:db/ident :answer.type/math} :answer/value "-5{e}^{x}+C" :db/id #edb/ref 17592186336390} {:answer/id #uuid "3a23d2fc-a7aa-5d1c-9864-c7a6153600b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}{e}^{x}+C" :db/id #edb/ref 17592186336580} {:answer/id #uuid "58f93f66-db36-5c48-881b-168f6ab9b1da" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336846} {:answer/id #uuid "91871bd5-c6b8-54e1-afe7-328451f3d7cd" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{5x}+C" :db/id #edb/ref 17592186337348} {:answer/id #uuid "d7c559ce-e0d7-5005-92d4-45151197edcb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-5x}+C" :db/id #edb/ref 17592186337906}] :answer-field/correct {:answer/id #uuid "2617015a-5455-5667-ad50-b136e5b1fa55" :answer/type {:db/ident :answer.type/math} :answer/value "-5{e}^{x}+C" :db/id #edb/ref 17592186336390} :answer-field/id #uuid "a5cc0952-0c9f-5522-9ba6-3e6da71b3cd2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338585}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d0db7f6e-faf8-548f-9f7b-4ca5b8b122ae" :question/math-academy-id "q-71914" :question/problem "$\\int -5{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $-5$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -5{e}^{x}\\,\\text{d}x & =-5\\int {e}^{x}\\,\\text{d}x \\\\  & =-5{e}^{x}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047bf720-73c7-51c2-a1d1-0d7ce9ba0daf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}{e}^{x}+C" :db/id #edb/ref 17592186336069} {:answer/id #uuid "28c95efa-9323-5c94-81de-c262b269bc72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }{e}^{x}+C" :db/id #edb/ref 17592186336413} {:answer/id #uuid "6c76f031-a85c-501b-9e15-92c6ad1fc1ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{\\pi }^{2}}{e}^{x}+C" :db/id #edb/ref 17592186336992} {:answer/id #uuid "87d9262e-48c6-59b6-91be-da9db9655aed" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {e}^{x}+C" :db/id #edb/ref 17592186337257} {:answer/id #uuid "a43b59b6-25ca-52aa-9cd7-3a4cf85aee70" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186337525}] :answer-field/correct {:answer/id #uuid "047bf720-73c7-51c2-a1d1-0d7ce9ba0daf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}{e}^{x}+C" :db/id #edb/ref 17592186336069} :answer-field/id #uuid "c2b21568-35b2-50d7-96a4-854078bb38e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338626}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c37273e4-126c-576b-aa8c-be1f096ba883" :question/math-academy-id "q-71918" :question/problem "$\\int {\\pi }^{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant ${\\pi }^{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int {\\pi }^{2}{e}^{x}\\,\\text{d}x & ={\\pi }^{2}\\int {e}^{x}\\,\\text{d}x \\\\  & ={\\pi }^{2}{e}^{x}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating the Exponential Function"}] [{:db/id #edb/ref 17592186068722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068564 :question/id #uuid "e2579380-1933-5819-a39e-9ffcfdafeeee" :question/math-academy-id "e-452" :question/problem "Calculate $\\displaystyle\\int 6x^2(2x^3+3)^6\\,\\textrm{d}x .$" :question/worked-solution "We note that $6x^2$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu=2x^3+3.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{2}\\,⟹\\,\\text{d}u=6{x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 6{x}^{2}(2{x}^{3}+3)^{6}\\,\\text{d}x & =\\int (2{x}^{3}+3)^{6}\\,6{x}^{2}\\,\\text{d}x \\\\  & =\\int {u}^{6}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{6}\\,\\text{d}u & =\\frac{{u}^{7}}{7}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=2x^3+3$ back in the expression. So the final result is\n\n$$\n\\displaystyle\\int 6x^2(2x^3+3)^6\\,\\textrm{d}x =\\dfrac{(2x^3+3)^7}{7}+C.\n$$"} :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050628 :topic/math-academy-id 334 :topic/title "Integrating Algebraic Functions Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186069140 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2452d0d5-3314-543c-8155-cd466478eb94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{3}+4)^{6}}{6x}+C" :db/id #edb/ref 17592186288264} {:answer/id #uuid "5181e9aa-208f-5201-b3ec-4362a8aec6e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{3}+4)^{5}}{5}+C" :db/id #edb/ref 17592186288598} {:answer/id #uuid "618b6980-5d49-54b2-98e1-6b2c17a106f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}({x}^{3}+4)^{6}}{2}+C" :db/id #edb/ref 17592186288715} {:answer/id #uuid "c874aedd-75e1-5980-8701-168e514e7383" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{3}+4)^{6}}{6}+C" :db/id #edb/ref 17592186289359} {:answer/id #uuid "fa9cf091-1a90-540f-a2e6-02899e4f742d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x({x}^{3}+4)^{6}}{2}+C" :db/id #edb/ref 17592186289681}] :answer-field/correct {:answer/id #uuid "c874aedd-75e1-5980-8701-168e514e7383" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{3}+4)^{6}}{6}+C" :db/id #edb/ref 17592186289359} :answer-field/id #uuid "5b6d7df2-4fc8-500a-b204-7a34c353e466" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289923}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "082a63d7-3326-5dca-8bbb-73a2f7476913" :question/math-academy-id "q-2189" :question/problem "Calculate $\\int 3{x}^{2}({x}^{3}+4)^{5}\\,\\text{d}x.$" :question/worked-solution "We note that $3{x}^{2}$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu={x}^{3}+4.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2}\\,⟹\\,\\text{d}u=3{x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}({x}^{3}+4)^{5}\\,\\text{d}x & =\\int ({x}^{3}+4)^{5}\\,3{x}^{2}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\int {u}^{5}\\,\\text{d}u=\\frac{{u}^{6}}{6}+C\n$$\n\nLastly, we substitute $u={x}^{3}+4$ back in the expression. So the final result is\n\n$$\n\\int 3{x}^{2}({x}^{3}+4)^{5}\\,\\text{d}x=\\frac{({x}^{3}+4)^{6}}{6}+C.\n$$"} {:db/id #edb/ref 17592186069141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5927e7-3d1a-5589-9ab4-b01b479f66f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186288882} {:answer/id #uuid "a65798db-1640-5ac0-9550-f0316b86d818" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289133} {:answer/id #uuid "a71c627c-e9b2-5a11-b21d-b190f3a77006" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289138} {:answer/id #uuid "d436ea16-40f5-50d5-8944-8947c0a63c89" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x({x}^{2}+1)^{12}}{12}+C" :db/id #edb/ref 17592186289436} {:answer/id #uuid "eb4463e3-17c4-52b2-809c-06d7c4b4e286" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{12}}{12}+C" :db/id #edb/ref 17592186289589}] :answer-field/correct {:answer/id #uuid "a65798db-1640-5ac0-9550-f0316b86d818" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289133} :answer-field/id #uuid "827ea8a6-3f45-58a9-acce-ef8eb4a48299" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290018}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c4b49482-74ae-5d27-81da-2160ac3cb246" :question/math-academy-id "q-2195" :question/problem "$\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=$" :question/worked-solution "We note that $2x$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu={x}^{2}+1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x & =\\int ({x}^{2}+1)^{12}\\,2x\\,\\text{d}x \\\\  & =\\int {u}^{12}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\int {u}^{12}\\,\\text{d}u=\\frac{{u}^{13}}{13}+C\n$$\n\nLastly, we substitute $u={x}^{2}+1$ back in the expression. So the final result is\n\n$$\n\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=\\frac{({x}^{2}+1)^{13}}{13}+C.\n$$"} {:db/id #edb/ref 17592186247375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e9f2b0-37e6-50e9-81f9-f4870eb89a96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2{x}^{6}-3)^{3/2}}{2}+C" :db/id #edb/ref 17592186244649} {:answer/id #uuid "5c181d1d-bf18-55ce-a822-d1dd57423b61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(2{x}^{6}-3)^{3/2}}{3}+C" :db/id #edb/ref 17592186245123} {:answer/id #uuid "96815189-eaa4-553f-a459-50b35808ed3d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{2{x}^{6}-3}}+C" :db/id #edb/ref 17592186245641} {:answer/id #uuid "9f1a82cf-c0af-5ed8-82c6-891e0d588025" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{2{x}^{6}-3}}+C" :db/id #edb/ref 17592186245732} {:answer/id #uuid "cdcc076d-df76-5525-b8c1-56042f929b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3(2{x}^{6}-3)^{3/2}}{2}+C" :db/id #edb/ref 17592186246149}] :answer-field/correct {:answer/id #uuid "5c181d1d-bf18-55ce-a822-d1dd57423b61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(2{x}^{6}-3)^{3/2}}{3}+C" :db/id #edb/ref 17592186245123} :answer-field/id #uuid "393c10c8-dc0a-514f-91a5-4a6f69993612" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246644}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6fab21e9-9cee-52c0-ac1e-55235a31831f" :question/math-academy-id "q-113581" :question/problem "Calculate $\\int 12{x}^{5}\\sqrt{2{x}^{6}-3}\\,\\text{d}x.$" :question/worked-solution "We note that $12{x}^{5}$ is the derivative of the quantity in the square root. So we make a substitution\n\n$$\nu=2{x}^{6}-3.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =12{x}^{5}\\,⟹\\,\\text{d}u=12{x}^{5}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 12{x}^{5}\\sqrt{2{x}^{6}-3}\\,\\text{d}x & =\\int \\sqrt{2{x}^{6}-3}\\cdot 12{x}^{5}\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2{u}^{3/2}}{3}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=2{x}^{6}-3$ back in the expression. So the final result is\n\n$$\n\\int 12{x}^{5}\\sqrt{2{x}^{6}-3}\\,\\text{d}x=\\frac{2(2{x}^{6}-3)^{3/2}}{3}+C.\n$$"} {:db/id #edb/ref 17592186290518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2029e990-e06c-5de3-bbb1-b0f88ba76514" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3(5{x}^{2}-4)^{3/2}}{2}+C" :db/id #edb/ref 17592186288239} {:answer/id #uuid "26e955b2-8d3d-529c-aa79-f141fc091ae9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/id #edb/ref 17592186288288} {:answer/id #uuid "2df24f84-49a3-5635-8292-77d1429d86ae" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/id #edb/ref 17592186288342} {:answer/id #uuid "836b0c8d-6627-5e01-a339-6971dc4ede71" :answer/type {:db/ident :answer.type/math} :answer/value "3(5{x}^{2}-4)^{2/3}+C" :db/id #edb/ref 17592186288915} {:answer/id #uuid "b431a516-679a-55de-bc9a-2dca5dba0032" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3(5{x}^{2}-4)^{2/3}}{2}+C" :db/id #edb/ref 17592186289223}] :answer-field/correct {:answer/id #uuid "26e955b2-8d3d-529c-aa79-f141fc091ae9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C" :db/id #edb/ref 17592186288288} :answer-field/id #uuid "8489e6ea-2848-5483-8e22-602ea51d9d4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290022}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f908f52d-efaa-5ed9-92ad-fd2900015e8a" :question/math-academy-id "q-2390" :question/problem "Calculate $\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x.$" :question/worked-solution "We note that $10x$ is the derivative of the quantity in the square root. So we make a substitution\n\n$$\nu=5{x}^{2}-4.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =10x\\,⟹\\,\\text{d}u=10x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x & =\\int \\sqrt{5{x}^{2}-4}\\,10x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2{u}^{3/2}}{3}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=5{x}^{2}-4$ back in the expression. So the final result is\n\n$$\n\\int 10x\\sqrt{5{x}^{2}-4}\\,\\text{d}x=\\frac{2(5{x}^{2}-4)^{3/2}}{3}+C.\n$$"} {:db/id #edb/ref 17592186339100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181818f9-ee5d-570b-8805-3453bec6da26" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/id #edb/ref 17592186336257} {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} {:answer/id #uuid "601c5f25-3385-59f3-b9ec-6f4783410687" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/id #edb/ref 17592186336901} {:answer/id #uuid "d13e9d9a-a682-5a93-b274-9657dd12c702" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186337864} {:answer/id #uuid "e2d6ab9a-d942-55d2-8674-766bbfa15318" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/id #edb/ref 17592186338008}] :answer-field/correct {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} :answer-field/id #uuid "1287170e-aae1-5d7e-9ef3-ec229bb6713f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338307}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "94a2c36c-7f20-5b89-950f-742f856d9127" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] [{:db/id #edb/ref 17592186175922 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175735 :question/id #uuid "ca9ba6cf-860f-5868-b91f-1dff84406f22" :question/math-academy-id "e-14357" :question/problem "Find the equation of the line that is perpendicular to $y = 4x - 1$ and passes through the point $(-8,7).$" :question/worked-solution "Let $l_1$ denote the line $y = 4x - 1,$ and let $l_2$ denote the line we want to find.\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of $l_2$ is the negative reciprocal of the slope of $l_1.$ Since $l_1$ has a slope of $4,$ the line $l_2$ must have a slope of $-\\dfrac{1}{4}.$\n\nOur perpendicular line must have the slope $m=-\\dfrac{1}{4}$ and pass through the point $(x_1,y_1)=(-8,7).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\eqalign{\ny - y_1 &= m(x-x_1) \\[5pt]\ny - 7 &= -\\dfrac{1}{4}(x-(-8)) \\[5pt]\ny - 7 &= -\\dfrac{1}{4}(x+8)\\[5pt]\ny - 7 &= -\\dfrac{1}{4}x - 2 \\[5pt]\ny &= -\\dfrac{1}{4}x + 5\n\t}\n$$"} :knowledge-point/id #uuid "ae4289af-e251-514c-981e-5c6d21992ad3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048357 :topic/math-academy-id 1427 :topic/title "Perpendicular Lines in the Coordinate Plane"} {:db/id #edb/ref 17592186050635 :topic/math-academy-id 418 :topic/title "Equations of Lines in Point-Slope Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186176416 :question/answer-fields [{:answer-field/id #uuid "b307199d-b09b-5e92-be29-542cecd7a78d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174739}] :question/id #uuid "86694a81-382d-570a-bba2-f718aff06c16" :question/math-academy-id "q-213914" :question/problem "![](images/5b/5b2ff0718a069c9bd874deae58021fe9b240b3245261eb849e7745c01d08853e.png)\n\nThe equation of the line $l_{1}$ is $y = 3x + 2$ and $l_{2}$ is perpendicular to $l_{1}$. What is the equation of $l_{2}$?$y =$\n{{field-1}}"} {:db/id #edb/ref 17592186176491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83e2d117-3b19-5862-b22c-94a3b9a8e0a3" :answer/type {:db/ident :answer.type/math} :answer/value "y =-2x + 2" :db/id #edb/ref 17592186175085} {:answer/id #uuid "84a43373-e5db-5377-9196-ea90e51633ae" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{1}{2}x + 8" :db/id #edb/ref 17592186175086} {:answer/id #uuid "ec133aff-8cc2-58b2-9cb2-2a3bd557b947" :answer/type {:db/ident :answer.type/math} :answer/value "y =-2x - 4" :db/id #edb/ref 17592186175087} {:answer/id #uuid "45379c9d-40e3-5530-86e5-3fa79a57f85e" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{1}{2}x + 12" :db/id #edb/ref 17592186175088} {:answer/id #uuid "7ac72c4d-a1cd-55c1-b0e7-e0cc6a09ca23" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2x + 12" :db/id #edb/ref 17592186175089}] :answer-field/id #uuid "a54fbe2c-caca-5de6-8e0b-a7b9cbeece6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175084}] :question/id #uuid "586b8e07-fc00-5c06-8f03-e2636b3e621e" :question/math-academy-id "q-44604" :question/problem "![](images/d1/d17cb653247e268818c4b66fb71b5f78109c84e7b42c590d0579658559f18a11.png)\n\nIn the diagram above, the equation of the line $l_{1}$ is $y = \\frac{1}{2}x$ and $l_{2}$ is perpendicular to $l_{1}$. What is the equation of the line $l_{2}$?"} {:db/id #edb/ref 17592186290494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6205539f-4a8f-5ebe-95f4-8e0519a32854" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}x-1" :db/id #edb/ref 17592186288719}] :answer-field/correct {:answer/id #uuid "6205539f-4a8f-5ebe-95f4-8e0519a32854" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}x-1" :db/id #edb/ref 17592186288719} :answer-field/id #uuid "82716775-5fec-5c32-aebe-ecb6e962d953" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290017}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9140d2e6-111a-5292-b6b0-fffff303bdec" :question/math-academy-id "q-237031" :question/problem "Find the equation of the line perpendicular to $y=4x-6$ that passes through the point $(8,-3).$\n\n$y=$\n{{field-1}}" :question/worked-solution "Let ${l}_{1}$ denote the line $y=4x-6,$ and let ${l}_{2}$ denote the line we want to find.\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $4,$ the line ${l}_{2}$ must have a slope of $-\\frac{1}{4}.$\n\nOur perpendicular line must have the slope $m=-\\frac{1}{4}$ and pass through the point $({x}_{1},{y}_{1})=(8,-3).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-3) & =-\\frac{1}{4}(x-8) \\\\ y+3 & =-\\frac{1}{4}x+2 \\\\ y & =-\\frac{1}{4}x-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090f3874-013a-5395-a89a-29ea2571ace8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}x+1" :db/id #edb/ref 17592186288100}] :answer-field/correct {:answer/id #uuid "090f3874-013a-5395-a89a-29ea2571ace8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}x+1" :db/id #edb/ref 17592186288100} :answer-field/id #uuid "b3f653c3-a0d8-5a83-a33c-8914c4b2eddc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290124}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "383ada0a-1bdb-5618-9cd6-7908256a85cd" :question/math-academy-id "q-237193" :question/problem "![](images/5a/5add9f877dc2e93b1c8e562794aa64c83d180f5c683735055ee24f8a190e8740.png)\n\nThe equation of the line ${l}_{1}$ is $y=-4x-3$ and ${l}_{2}$ is perpendicular to ${l}_{1}.$  What is the equation of ${l}_{2}?$\n\n$y=$\n{{field-1}}" :question/worked-solution "Since perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $-4,$ the line ${l}_{2}$ must have a slope of $\\frac{1}{4}.$\n\nOur perpendicular line must have the slope $m=\\frac{1}{4}$ and pass through the point $({x}_{1},{y}_{1})=(4,2).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =\\frac{1}{4}(x-4) \\\\ y-2 & =\\frac{1}{4}x-1 \\\\ y & =\\frac{1}{4}x+1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a73f77be-2b8c-543d-b7e9-b9dcef443eec" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186289141}] :answer-field/correct {:answer/id #uuid "a73f77be-2b8c-543d-b7e9-b9dcef443eec" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186289141} :answer-field/id #uuid "5fba18a7-719c-5582-adf6-f2d211e85df9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289938}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a5691d5-2f92-5293-81b7-0db83b2ca8e7" :question/math-academy-id "q-237197" :question/problem "The lines $y=\\frac{2}{5}x-2$ and $y=mx+b$ are perpendicular. If the line $y=mx+b$ passes through the point $(6,-1),$ what is the value of $b?$\n\n$b=$\n{{field-1}}" :question/worked-solution "Let ${l}_{1}$ denote the line $y=\\frac{2}{5}x-2,$ and let ${l}_{2}$ denote the line we want to find.\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $\\frac{2}{5},$ the line ${l}_{2}$ must have a slope of $-\\frac{5}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{5}{2}$ and pass through the point $({x}_{1},{y}_{1})=(6,-1).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =-\\frac{5}{2}(x-6) \\\\ y+1 & =-\\frac{5}{2}x+15 \\\\ y & =-\\frac{5}{2}x+14\\end{aligned}\n$$\n\nTherefore, $b=14.$"} {:db/id #edb/ref 17592186329753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e922a42-6deb-5bc6-a4f2-a8d06f3fea60" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x+6" :db/id #edb/ref 17592186328024} {:answer/id #uuid "d59f7611-aece-5245-9299-86b545be9496" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+6" :db/id #edb/ref 17592186328803} {:answer/id #uuid "dd0e28cc-1799-536e-bd55-0a06dc16bb67" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x" :db/id #edb/ref 17592186328867} {:answer/id #uuid "de5640a4-5333-5d9b-b991-e89e51fe95ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=-6x-2" :db/id #edb/ref 17592186328881} {:answer/id #uuid "ed73643a-713f-5f7a-aea6-c63401f50949" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x+6" :db/id #edb/ref 17592186329014}] :answer-field/correct {:answer/id #uuid "d59f7611-aece-5245-9299-86b545be9496" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+6" :db/id #edb/ref 17592186328803} :answer-field/id #uuid "2512d590-4b14-5e67-bd6c-bb6c4cebbb08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "36e2ce70-a218-5096-a57b-5f93338562ee" :question/math-academy-id "q-44337" :question/problem "![](images/c9/c9c426e75153bd893e3dbef39bd8a837991d8c3ec6a48b41aeb27df6c4250660.png)\n\nIn the diagram above, the equation of the line ${l}_{1}$ is $y=2x-1$ and ${l}_{2}$ is perpendicular to ${l}_{1}.$ What is the equation of the line ${l}_{2}?$" :question/worked-solution "Since perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $2,$ the line ${l}_{2}$ must have a slope of $-\\frac{1}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{1}{2}$ and a $y$-intercept of $6.$ Therefore, it can be written in slope-intercept form as\n\n$$\ny=-\\frac{1}{2}x+6.\n$$"} {:db/id #edb/ref 17592186329757 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57e23f1f-9afd-529c-8754-206a83a53d41" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186327704} {:answer/id #uuid "596b0741-805d-50aa-80e7-2406183584f5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327718} {:answer/id #uuid "cd151538-f2a8-52ab-b29c-9a6222ccc753" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186328738} {:answer/id #uuid "ea9e312c-018f-5df3-b69e-cb2f84fe89e7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328987} {:answer/id #uuid "ffeda689-ed27-51ce-907b-58258346f71b" :answer/type {:db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186329181}] :answer-field/correct {:answer/id #uuid "cd151538-f2a8-52ab-b29c-9a6222ccc753" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186328738} :answer-field/id #uuid "aa4240f9-2248-54fc-95ab-bba96ca459df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329481}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "93700919-0d0d-5f0f-8a74-9dd360322563" :question/math-academy-id "q-44606" :question/problem "The lines $y=\\frac{1}{2}x-3$ and $y=mx+b$ are perpendicular. Given that the line $y=mx+b$ passes through the point $(-1,5),$ what is the value of $b?$" :question/worked-solution "Let ${l}_{1}$ denote the line $y=\\frac{1}{2}x-3,$ and let ${l}_{2}$ denote the line we want to find.\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $\\frac{1}{2},$ the line ${l}_{2}$ must have a slope of $-2.$\n\nOur perpendicular line must have the slope $m=-2$ and pass through the point $({x}_{1},{y}_{1})=(-1,5).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =-2(x-(-1)) \\\\ y-5 & =-2(x+1) \\\\ y-5 & =-2x-2 \\\\ y & =-2x+3\\end{aligned}\n$$\n\nTherefore, $b=3.$"}] :knowledge-point/title "Finding the Equation of a Perpendicular Line"}] [{:db/id #edb/ref 17592186184349 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183945 :question/id #uuid "3e9586ee-12d1-5dbb-81f6-0f0a4998e00a" :question/math-academy-id "e-14402" :question/problem "Calculate  $\\displaystyle{\\int x^2 e^{x^3+1}\\, \\textrm{d}x }.$" :question/worked-solution "Let's introduce the new variable $u = x^3+1.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{{x}^{3}+1}\\cdot \\,{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050101 :topic/math-academy-id 1112 :topic/title "Integrating Exponential Functions Using Linear Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186184470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d22492-39be-5818-b2f9-72466fc0f7d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}e^{x^{3} + 2} + C" :db/id #edb/ref 17592186180998} {:answer/id #uuid "a7ac4ca7-0b5d-5006-8e17-41afe089eb14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}e^{x^{3} + 2} + C" :db/id #edb/ref 17592186180999} {:answer/id #uuid "b92fcd6b-3979-572f-840c-1b878839f23b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}e^{x^{3} + 2} + C" :db/id #edb/ref 17592186181000} {:answer/id #uuid "cfe98265-80f0-5ce4-ab7c-24cb05043464" :answer/type {:db/ident :answer.type/math} :answer/value "4e^{x^{3} + 2} + C" :db/id #edb/ref 17592186181001} {:answer/id #uuid "4c9c2116-b26a-55d4-9a9c-1cc7c0ce1d54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}e^{x^{3} + 2} + C" :db/id #edb/ref 17592186181002}] :answer-field/id #uuid "74aa1e13-622e-5bc2-9c8b-8b14ea8a9e82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 1759218