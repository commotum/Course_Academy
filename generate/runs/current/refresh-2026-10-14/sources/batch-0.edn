:answer/value "-{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186340613} {:answer/id #uuid "aa24112d-02cf-52a3-98b5-d799573a4663" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186340681} {:answer/id #uuid "e1df2684-cab8-51a8-a3b4-21cf85839e36" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186341131}] :answer-field/correct {:answer/id #uuid "a3e1e3d7-4987-5b16-8a1e-ddf441083d39" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{5-2{x}^{3}}+C" :db/id #edb/ref 17592186340613} :answer-field/id #uuid "3a39fa1f-bf03-5be7-a356-d7a0ccbb9e6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341485}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "78eb8eca-5e7f-5422-8275-d4d9278c8f6b" :question/math-academy-id "q-73664" :question/problem "$\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=5-2{x}^{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{2}\\,⟹\\,-\\text{d}u=6{x}^{2}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\,\\text{d}x & =\\int {e}^{5-2{x}^{3}}\\cdot 6{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\,(-\\text{d}u) \\\\  & =-\\int {e}^{u}\\,\\text{d}u \\\\  & =-{e}^{u}+C \\\\  & =-{e}^{5-2{x}^{3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9a0870-f8c4-5b88-9fc4-23a032ca1014" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186339228} {:answer/id #uuid "1c4583d3-b65d-531b-90ce-c8082399cab5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{27}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186339370} {:answer/id #uuid "1fa6a84f-26cb-5ba8-9c5a-d930d920fb17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186339403} {:answer/id #uuid "e327b154-8449-5e64-8466-531b65354f8c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186341139} {:answer/id #uuid "f6415d67-ab62-5c80-8c4b-4c14b2b5afc2" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186341304}] :answer-field/correct {:answer/id #uuid "1fa6a84f-26cb-5ba8-9c5a-d930d920fb17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{e}^{3{x}^{3}+1}+C" :db/id #edb/ref 17592186339403} :answer-field/id #uuid "f4b217b9-d7db-507a-b039-4fdc0e3ca281" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341815}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "936e31ed-13cd-5404-9ab8-85dcf93e8b28" :question/math-academy-id "q-73798" :question/problem "$\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=3{x}^{3}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u=3{x}^{2}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{3{x}^{3}+1}\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{3{x}^{3}+1}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Products Containing the Exponential Function"}]}
