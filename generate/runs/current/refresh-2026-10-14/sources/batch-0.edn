pe/math} :answer/value "{e}^{{z}^{2}}+C" :db/id #edb/ref 17592186288463} {:answer/id #uuid "95b7afd6-8fcf-5067-8e15-ead7f07a0ef1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{z}}{2}+C" :db/id #edb/ref 17592186289031} {:answer/id #uuid "9620b0c1-fc6c-5c19-a632-d8a82a74f6dc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186289038}] :answer-field/correct {:answer/id #uuid "00acbd21-382b-5ab9-ae57-615f612cac26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186288029} :answer-field/id #uuid "0a11595a-5a8b-5fc2-9ad5-95d2f1d21318" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289748}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8c2e05bf-d6ab-5dd9-a54b-6f33a76c6868" :question/math-academy-id "q-2382" :question/problem "$\\int z{e}^{{z}^{2}}\\,\\text{d}z=$" :question/worked-solution "Let's introduce the new variable $u={z}^{2}.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2z\\,⟹\\,\\frac{1}{2}\\text{d}u=z\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int z{e}^{{z}^{2}}\\,\\text{d}z & =\\int {e}^{{z}^{2}}\\cdot z\\,\\text{d}z \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{{z}^{2}}}{2}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20dee8fa-f8ac-5b39-a8ad-c1b5486f639d" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186339411} {:answer/id #uuid "70c68315-1c62-551c-8f66-382b1980812f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2{x}^{2}-x}+C" :db/id #edb/ref 17592186340129} {:answer/id #uuid "8b0f4634-38d0-5a9c-a0e0-e9289