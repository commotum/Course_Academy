#{[{:db/id #edb/ref 17592186064171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064049 :question/id #uuid "3ff03590-c618-5a60-b2ac-e0a20be6a8ae" :question/math-academy-id "e-377" :question/problem "Calculate $\\displaystyle \\int 6e^x  \\textrm d x.$" :question/worked-solution "Factoring out the constant $6$ and taking the integral, we get\n\n$$\n\\eqalign{\n\\int 6e^x   \\textrm d x   =6 \\int e^x  \\, \\textrm d x =6e^x +C.\n                                                                               \n}\n$$"} :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048442 :topic/math-academy-id 43 :topic/title "The Constant Multiple Rule for Indefinite Integrals"} {:db/id #edb/ref 17592186048749 :topic/math-academy-id 1114 :topic/title "Differentiating Exponential Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186064730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "910b8b6a-55e2-5efa-b9cd-5825d5701abb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{e^{x}} + C" :db/id #edb/ref 17592186062438} {:answer/id #uuid "bf11c64d-2599-567c-a4c2-bf2b27fd9a04" :answer/type {:db/ident :answer.type/math} :answer/value "e^{3x} + C" :db/id #edb/ref 17592186062439} {:answer/id #uuid "cfc3b227-c765-5945-8e43-f5f68cce2cf7" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{\\ln x} + C" :db/id #edb/ref 17592186062440} {:answer/id #uuid "0b175dff-3816-5913-bdba-bedc85309011" :answer/type {:db/ident :answer.type/math} :answer/value "3e^{x} + C" :db/id #edb/ref 17592186062441} {:answer/id #uuid "563f491b-0d7b-525b-b7e0-07bf66f59e34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{x}}{3} + C" :db/id #edb/ref 17592186062442}] :answer-field/id #uuid "9bcf16c6-503f-54d0-b03e-1d2abdb7054f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062437}] :question/id