30} :answer-field/id #uuid "2548b4e8-e81b-529c-a2f5-cc0f516d4d68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488412}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "330f3ae2-18da-5c7f-9c2a-77ec2bbc5932" :question/problem "If $f(x)=\\frac{x^{2} + \\sin{\\left(x \\right)}}{e^{x} + \\cos{\\left(x \\right)}}$, find $f^{\\prime}(x)$ wherever the denominator is nonzero." :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=x^{2} + \\sin{\\left(x \\right)}$ and $v(x)=e^{x} + \\cos{\\left(x \\right)}.$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}f^{\\prime}(x)&=\\frac{u^{\\prime}(x)\\cdot v(x)-u(x)\\cdot v^{\\prime}(x)}{[v(x)]^{2}}\\\\ &=\\frac{(x^{2} + \\sin{\\left(x \\right)})^{\\prime}\\cdot (e^{x} + \\cos{\\left(x \\right)})-(x^{2} + \\sin{\\left(x \\right)})\\cdot (e^{x} + \\cos{\\left(x \\right)})^{\\prime}}{(e^{x} + \\cos{\\left(x \\right)})^{2}}\\\\ &=\\frac{(2 x + \\cos{\\left(x \\right)})\\cdot (e^{x} + \\cos{\\left(x \\right)})-(x^{2} + \\sin{\\left(x \\right)})\\cdot (e^{x} - \\sin{\\left(x \\right)})}{(e^{x} + \\cos{\\left(x \\right)})^{2}}\\\\ &=\\frac{x^{2} \\sin{\\left(x \\right)} + 2 x \\cos{\\left(x \\right)} + \\left(- x^{2} + 2 x - \\sin{\\left(x \\right)} + \\cos{\\left(x \\right)}\\right) e^{x} + 1}{\\left(e^{x} + \\cos{\\left(x \\right)}\\right)^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186488419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "115cbbca-5c59-56be-8ae9-4898e0f41248" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - 2 \\sin{\\left(x \\right)}\\right)}{\\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488409} {:answer/id #uuid "2bb3d4ca-451f-5af4-832d-4b02354ca06d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 x + 2 \\cos{\\left(x \\right)}}{e^{x} - 2 \\sin{\\left(x \\right)}}" :db/id #edb/ref 17592186488414} {:answer/id #uuid "2d9e4c34-9fa3-50dd-ad2c-68f1787e630d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - 2 \\sin{\\left(x \\right)}\\right)}{e^{x} + 2 \\cos{\\left(x \\right)}}" :db/id #edb/ref 17592186488416} {:answer/id #uuid "5db49704-01d6-55f7-8987-4d01df9d9062" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - 2 \\sin{\\left(x \\right)}\\right)}{\\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488429} {:answer/id #uuid "c0aab957-62fc-5e52-b01e-fabd522e5128" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right) + \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - 2 \\sin{\\left(x \\right)}\\right)}{\\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488440}] :answer-field/correct {:answer/id #uuid "5db49704-01d6-55f7-8987-4d01df9d9062" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - 2 \\sin{\\left(x \\right)}\\right)}{\\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488429} :answer-field/id #uuid "073f6d5e-fa77-501b-89fa-51940634a7be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488407}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "338ce37f-52f4-5598-a419-2b56ddad1042" :question/problem "If $f(x)=\\frac{x^{2} + 2 \\sin{\\left(x \\right)}}{e^{x} + 2 \\cos{\\left(x \\right)}}$, find $f^{\\prime}(x)$ wherever the denominator is nonzero." :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=x^{2} + 2 \\sin{\\left(x \\right)}$ and $v(x)=e^{x} + 2 \\cos{\\left(x \\right)}.$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}f^{\\prime}(x)&=\\frac{u^{\\prime}(x)\\cdot v(x)-u(x)\\cdot v^{\\prime}(x)}{[v(x)]^{2}}\\\\ &=\\frac{(x^{2} + 2 \\sin{\\left(x \\right)})^{\\prime}\\cdot (e^{x} + 2 \\cos{\\left(x \\right)})-(x^{2} + 2 \\sin{\\left(x \\right)})\\cdot (e^{x} + 2 \\cos{\\left(x \\right)})^{\\prime}}{(e^{x} + 2 \\cos{\\left(x \\right)})^{2}}\\\\ &=\\frac{(2 x + 2 \\cos{\\left(x \\right)})\\cdot (e^{x} + 2 \\cos{\\left(x \\right)})-(x^{2} + 2 \\sin{\\left(x \\right)})\\cdot (e^{x} - 2 \\sin{\\left(x \\right)})}{(e^{x} + 2 \\cos{\\left(x \\right)})^{2}}\\\\ &=\\frac{2 x^{2} \\sin{\\left(x \\right)} + 4 x \\cos{\\left(x \\right)} + \\left(- x^{2} + 2 x - 2 \\sin{\\left(x \\right)} + 2 \\cos{\\left(x \\right)}\\right) e^{x} + 4}{\\left(e^{x} + 2 \\cos{\\left(x \\right)}\\right)^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186488420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53ce5a3a-4308-5f24-b77e-3d536770f4b4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\pi" :db/id #edb/ref 17592186488428} {:answer/id #uuid "a0f3740d-5ffb-5166-9eec-78f1df332cfa" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186488434} {:answer/id #uuid "b8125df1-2886-5302-9507-570e14557d20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{\\pi}" :db/id #edb/ref 17592186488437} {:answer/id #uuid "b95a866f-d9de-5d95-b16e-b89f43aad8ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186488438} {:answer/id #uuid "c60bbdb9-b3ff-5e20-b3dc-7a2f894d281c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2 \\pi}" :db/id #edb/ref 17592186488441}] :answer-field/correct {:answer/id #uuid "b8125df1-2886-5302-9507-570e14557d20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{\\pi}" :db/id #edb/ref 17592186488437} :answer-field/id #uuid "05a1acc8-68d0-5d1a-86e6-d6b9eb56d363" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488406}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "347a250b-fde2-504e-aba8-c4e6cad7f81f" :question/problem "If a curve $C$ is given by $y=\\frac{\\sin x}{1x}$, calculate the slope of the tangent line to the curve at the point where $x=\\pi$." :question/worked-solution "In this case, the expression for $y$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\sin{\\left(x \\right)}$ and $v(x)=x.$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}f^{\\prime}(x)&=\\frac{u^{\\prime}(x)\\cdot v(x)-u(x)\\cdot v^{\\prime}(x)}{[v(x)]^{2}}\\\\ &=\\frac{(\\sin{\\left(x \\right)})^{\\prime}\\cdot (x)-(\\sin{\\left(x \\right)})\\cdot (x)^{\\prime}}{(x)^{2}}\\\\ &=\\frac{(\\cos{\\left(x \\right)})\\cdot (x)-(\\sin{\\left(x \\right)})\\cdot (1)}{(x)^{2}}\\\\ &=\\frac{x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)}}{x^{2}}\\\\ &=\\frac{x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)}}{x^{2}}\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi$ into the formula and get\n\n$$\n\\begin{aligned}f^{\\prime}(\\pi)&=\\frac{\\pi\\cos(\\pi)-\\sin(\\pi)}{1\\pi^{2}}\\\\ &=\\frac{\\pi(-1)-0}{1\\pi^{2}}\\\\ &=- \\frac{1}{\\pi}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- \\frac{1}{\\pi}.$"} {:db/id #edb/ref 17592186488433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "334c76f6-83e5-5e3e-883c-47bdbba96b72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - \\sin{\\left(x \\right)}\\right)}{\\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488418} {:answer/id #uuid "67d3838a-4f72-59f7-a46f-77165cd733dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + \\cos{\\left(x \\right)}\\right) + \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - \\sin{\\left(x \\right)}\\right)}{\\left(e^{x} + \\cos{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488431} {:answer/id #uuid "bf30e4a4-a8cd-53c9-a22b-3efae8cc7abd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - \\sin{\\left(x \\right)}\\right)}{\\left(e^{x} + \\cos{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488439} {:answer/id #uuid "da545753-4150-59dd-b351-be79377ecc69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2 x + 2 \\cos{\\left(x \\right)}}{e^{x} - \\sin{\\left(x \\right)}}" :db/id #edb/ref 17592186488443} {:answer/id #uuid "dbce7423-7701-5fe2-81c8-a812659a5de5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - \\sin{\\left(x \\right)}\\right)}{e^{x} + \\cos{\\left(x \\right)}}" :db/id #edb/ref 17592186488445}] :answer-field/correct {:answer/id #uuid "bf30e4a4-a8cd-53c9-a22b-3efae8cc7abd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(2 x + 2 \\cos{\\left(x \\right)}\\right) \\left(e^{x} + \\cos{\\left(x \\right)}\\right) - \\left(x^{2} + 2 \\sin{\\left(x \\right)}\\right) \\left(e^{x} - \\sin{\\left(x \\right)}\\right)}{\\left(e^{x} + \\cos{\\left(x \\right)}\\right)^{2}}" :db/id #edb/ref 17592186488439} :answer-field/id #uuid "3dd06b30-684e-598d-868b-8d957b30359d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186488422}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "827bc541-4fb4-5c74-8167-ae29b054ee8e" :question/problem "If $f(x)=\\frac{x^{2} + 2 \\sin{\\left(x \\right)}}{e^{x} + \\cos{\\left(x \\right)}}$, find $f^{\\prime}(x)$ wherever the denominator is nonzero." :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=x^{2} + 2 \\sin{\\left(x \\right)}$ and $v(x)=e^{x} + \\cos{\\left(x \\right)}.$\n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}f^{\\prime}(x)&=\\frac{u^{\\prime}(x)\\cdot v(x)-u(x)\\cdot v^{\\prime}(x)}{[v(x)]^{2}}\\\\ &=\\frac{(x^{2} + 2 \\sin{\\left(x \\right)})^{\\prime}\\cdot (e^{x} + \\cos{\\left(x \\right)})-(x^{2} + 2 \\sin{\\left(x \\right)})\\cdot (e^{x} + \\cos{\\left(x \\right)})^{\\prime}}{(e^{x} + \\cos{\\left(x \\right)})^{2}}\\\\ &=\\frac{(2 x + 2 \\cos{\\left(x \\right)})\\cdot (e^{x} + \\cos{\\left(x \\right)})-(x^{2} + 2 \\sin{\\left(x \\right)})\\cdot (e^{x} - \\sin{\\left(x \\right)})}{(e^{x} + \\cos{\\left(x \\right)})^{2}}\\\\ &=\\frac{x^{2} \\sin{\\left(x \\right)} + 2 x \\cos{\\left(x \\right)} + \\left(- x^{2} + 2 x - 2 \\sin{\\left(x \\right)} + 2 \\cos{\\left(x \\right)}\\right) e^{x} + 2}{\\left(e^{x} + \\cos{\\left(x \\right)}\\right)^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862}] :answer-field/correct {:answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/id #edb/ref 17592186513862} :answer-field/id #uuid "ba412a72-8abe-5840-811a-70be04c017e7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514310}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "709bef3c-1deb-5177-94a0-6a0cd6bca192" :question/math-academy-id "q-166075" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h})\\,=${{field-1}}" :question/worked-solution "Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$\n\nWe apply the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h}) & =\\frac{{f}^{′}(x)\\cdot h(x)-f(x)\\cdot {h}^{′}(x)}{[h(x)]^{2}} \\\\  & =\\frac{{(\\frac{1}{2}{e}^{x})}^{′}\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)^{′}}{(-4\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{cos}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{2{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{8{sin}^{2}⁡x}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] [{:db/id #edb/ref 17592186096622 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096422 :question/id #uuid "53d435ea-a20f-5216-8020-f36cdf8b7c36" :question/math-academy-id "e-3639" :question/problem "Given that $y=\\dfrac{1}{3x+7},$ find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "Let $u=1$ and $v=3x+7.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =0\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=3.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\eqalign{\n\t\t\t\\dfrac{\\textrm{d}y}{\\textrm{d}x}\t& = \\dfrac{ v\\dfrac{\\textrm{d}u}{\\textrm{d}x}-u\\dfrac{\\textrm{d}v}{\\textrm{d}x}}{v^2}\\\n\t\t\t\t\t\t\t\t\t\t& = \\dfrac{ \\left( 3x+7 \\right ) \\cdot 0 -1\\cdot 3}{\\left( 3x+7\\right)^2}\\\n\t\t\t\t\t\t\t\t\t\t& = -\\dfrac{3}{\\left( 3x+7\\right)^2}.\n\t\t}\n$$"} :knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/questions [{:db/id #edb/ref 17592186097023 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "052e178f-fea5-5edd-8eb2-a0888eea09b0" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\ln x - (3x + 5))/(x\\ln^{2} x)" :db/id #edb/ref 17592186094112} {:answer/id #uuid "1a776c8a-cd90-5637-93d4-8cd2f27de4cb" :answer/type {:db/ident :answer.type/math} :answer/value "(3x\\ln x - (3x + 5))/(\\ln^{2} x)" :db/id #edb/ref 17592186094113} {:answer/id #uuid "1c0f548b-77b2-50d4-b4e6-f4ba3a8df425" :answer/type {:db/ident :answer.type/math} :answer/value "(3x\\ln x - (3x + 5))/(x\\ln^{2} x)" :db/id #edb/ref 17592186094114} {:answer/id #uuid "745306f4-72c5-5545-9816-cf49926f8987" :answer/type {:db/ident :answer.type/math} :answer/value "(x\\ln x - (3x + 5))/(x\\ln^{2} x)" :db/id #edb/ref 17592186094115} {:answer/id #uuid "75e3555f-d86a-547c-81cb-db6853872d16" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\ln x - (3x + 5))/(\\ln^{2} x)" :db/id #edb/ref 17592186094116}] :answer-field/id #uuid "c5d12056-22c4-5e67-9b03-1faad824c4ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094111}] :question/id #uuid "d2103018-8e5a-539f-91b2-e397fbb60fe0" :question/math-academy-id "q-11944" :question/problem "Given that $y = \\frac{3x + 5}{\\ln x}$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186097402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bbfb0e4-90b8-5f5a-8681-e89d8f2e043f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sin^{2} x}" :db/id #edb/ref 17592186096337} {:answer/id #uuid "c183e0da-4c8b-551b-a2f4-2434c957e3b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{1 - \\cos x}" :db/id #edb/ref 17592186096338} {:answer/id #uuid "c54f47c7-3780-5af4-82e3-41e944af0188" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sin^{2} x}" :db/id #edb/ref 17592186096339} {:answer/id #uuid "ef4d0483-5cc0-5868-99ae-0c56b4fd93da" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{1 + \\cos x}" :db/id #edb/ref 17592186096340} {:answer/id #uuid "7ac0f891-ba3f-524e-bcc7-ed5935f2ffad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{1 - \\cos x}" :db/id #edb/ref 17592186096341}] :answer-field/id #uuid "b2ef6915-f8da-5af2-93cd-7f20d85ba689" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096336}] :question/id #uuid "7f46ac0c-943e-53a7-8642-7b7c02c8d0f5" :question/math-academy-id "q-9909" :question/problem "Given that $y = \\frac{1 + \\cos x}{\\sin x}$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186233909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411ad0a6-dfdf-5210-9031-b071ed9f1d25" :answer/type {:db/ident :answer.type/math} :answer/value "x{sec}^{2}x-2\\operatorname{tan}x" :db/id #edb/ref 17592186232828}] :answer-field/correct {:answer/id #uuid "411ad0a6-dfdf-5210-9031-b071ed9f1d25" :answer/type {:db/ident :answer.type/math} :answer/value "x{sec}^{2}x-2\\operatorname{tan}x" :db/id #edb/ref 17592186232828} :answer-field/id #uuid "51587dfb-9879-5d5f-a825-9b651145a6a1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232827}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b0dda45f-ecb7-59f8-a972-5883eeaa75ea" :question/math-academy-id "q-340336" :question/problem "Given that $y=\\frac{\\operatorname{tan}x}{{x}^{2}}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{x}^{3}}\\cdot ($\n{{field-1}}\n$).$" :question/worked-solution "Let $u=\\operatorname{tan}x$ and $v={x}^{2}.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={sec}^{2}x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{{x}^{2}\\cdot {sec}^{2}x-\\operatorname{tan}x\\cdot 2x}{{({x}^{2})}^{2}} \\\\  & =\\frac{x(x{sec}^{2}x-2\\operatorname{tan}x)}{{x}^{4}} \\\\  & =\\frac{1}{{x}^{3}}\\cdot (\\,x{sec}^{2}x-2\\operatorname{tan}x\\,).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab6d73ac-0c25-5277-aa73-cfb0e1fb216d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x{e}^{x}}{(x+1)^{2}}" :db/id #edb/ref 17592186232830}] :answer-field/correct {:answer/id #uuid "ab6d73ac-0c25-5277-aa73-cfb0e1fb216d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x{e}^{x}}{(x+1)^{2}}" :db/id #edb/ref 17592186232830} :answer-field/id #uuid "7aaf1234-8fbb-5268-b237-19413ad4ad78" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232829}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b60ff19b-c625-5bda-addb-5e04895bf04d" :question/math-academy-id "q-340340" :question/problem "Given that $y=\\frac{{e}^{x}}{x+1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u={e}^{x}$ and $v=x+1.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={e}^{x}\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=1.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(x+1)\\cdot {e}^{x}-{e}^{x}\\cdot 1}{(x+1)^{2}} \\\\  & =\\frac{{e}^{x}(x+1-1)}{(x+1)^{2}} \\\\  & =\\frac{x{e}^{x}}{(x+1)^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b89321c-e3ba-5c4f-81cd-a7cbf23d72d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250653} {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} {:answer/id #uuid "3a22468e-a8b9-5374-a6b1-4af81ef69538" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186251034} {:answer/id #uuid "bd9f93f8-6285-5333-9fbc-0e76b0bb68f3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252231} {:answer/id #uuid "e86a868c-0137-5698-8032-3302efc36e18" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252584}] :answer-field/correct {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} :answer-field/id #uuid "05c220dd-0a63-5428-9d3d-76e098f2cb6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252820}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ae64d20-c5b4-50bb-94bc-ab5da04017e1" :question/math-academy-id "q-11969" :question/problem "Given that $y=\\frac{-x}{9-2x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=-x$ and $v=9-2x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-2.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(9-2x)\\cdot (-1)-(-x)\\cdot (-2)}{{(9-2x)}^{2}} \\\\  & =\\frac{-9+2x-2x}{{(9-2x)}^{2}} \\\\  & =-\\frac{9}{{(9-2x)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3eec343-e0fb-5e52-bd97-aa3ada6a41b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186313924}] :answer-field/correct {:answer/id #uuid "f3eec343-e0fb-5e52-bd97-aa3ada6a41b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186313924} :answer-field/id #uuid "fff9ae42-05ed-5c15-9feb-e04d24b0b620" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314697}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d40e1594-3ec0-54e3-88ea-531a4ce96db1" :question/math-academy-id "q-340332" :question/problem "Given that $y=\\frac{{x}^{2}}{{x}^{2}+1}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u={x}^{2}$ and $v={x}^{2}+1.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{({x}^{2}+1)\\cdot 2x-{x}^{2}\\cdot 2x}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{2{x}^{3}+2x-2{x}^{3}}{{({x}^{2}+1)}^{2}} \\\\  & =\\frac{2x}{{({x}^{2}+1)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cadf6e0-479a-5eb1-bed6-41de67fcde17" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}x\\operatorname{cot}x" :db/id #edb/ref 17592186312190}] :answer-field/correct {:answer/id #uuid "1cadf6e0-479a-5eb1-bed6-41de67fcde17" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}x\\operatorname{cot}x" :db/id #edb/ref 17592186312190} :answer-field/id #uuid "5e19e32f-4d6c-5aaa-8114-0d5626382a44" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314273}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "23fd6f2c-8994-5050-a37a-61410033ca13" :question/math-academy-id "q-340335" :question/problem "Given that $f(x)=\\frac{1-sin⁡x}{sin⁡x},$ find ${f}^{′}(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u=1-sin⁡x$ and $v=sin⁡x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-cos⁡x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=cos⁡x.\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{sin⁡x\\cdot (-cos⁡x)-(1-sin⁡x)\\cdot cos⁡x}{{sin}^{2}⁡x} \\\\  & =\\frac{cos⁡x(-sin⁡x-1+sin⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{cos⁡x\\cdot (-1)}{{sin}^{2}⁡x} \\\\  & =-\\frac{1}{sin⁡x}\\cdot \\frac{cos⁡x}{sin⁡x} \\\\  & =-csc⁡xcot⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d58cd28-0b2e-5dc6-8d9f-4ed89ec4aa5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}x+x\\operatorname{sin}x" :db/id #edb/ref 17592186312472}] :answer-field/correct {:answer/id #uuid "3d58cd28-0b2e-5dc6-8d9f-4ed89ec4aa5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}x+x\\operatorname{sin}x" :db/id #edb/ref 17592186312472} :answer-field/id #uuid "db75a262-e72e-5fe8-a7c4-cd5620e1e8e7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314620}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "86ab750e-4dae-544c-82a8-041d54807290" :question/math-academy-id "q-340337" :question/problem "Given that $y=\\frac{x}{cos⁡x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{{cos}^{2}⁡x}\\cdot ($\n{{field-1}}\n$).$" :question/worked-solution "Let $u=x$ and $v=cos⁡x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-sin⁡x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{cos⁡x\\cdot 1-x\\cdot (-sin⁡x)}{{cos}^{2}⁡x} \\\\  & =\\frac{1}{{cos}^{2}⁡x}\\cdot (cos⁡x+xsin⁡x\\,).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1e08605-30ac-5180-b993-bb8905dcf80f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}x-1}{(\\operatorname{ln}x)^{2}}" :db/id #edb/ref 17592186313247}] :answer-field/correct {:answer/id #uuid "a1e08605-30ac-5180-b993-bb8905dcf80f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}x-1}{(\\operatorname{ln}x)^{2}}" :db/id #edb/ref 17592186313247} :answer-field/id #uuid "d0021a41-de95-5d7c-9f18-7f5e0c873094" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314583}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c69eee29-5e7a-522d-bfc9-641f3d5d4893" :question/math-academy-id "q-340341" :question/problem "Given that $y=\\frac{x}{ln⁡x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Let $u=x$ and $v=ln⁡x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(ln⁡x\\cdot 1-x\\cdot \\frac{1}{x})}{{(ln⁡x)}^{2}} \\\\  & =\\frac{ln⁡x-1}{{(ln⁡x)}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314935 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe403dd4-e8fc-5b37-a657-5cdb8ad41fe7" :answer/type {:db/ident :answer.type/math} :answer/value "1-2\\operatorname{ln}x" :db/id #edb/ref 17592186314003}] :answer-field/correct {:answer/id #uuid "fe403dd4-e8fc-5b37-a657-5cdb8ad41fe7" :answer/type {:db/ident :answer.type/math} :answer/value "1-2\\operatorname{ln}x" :db/id #edb/ref 17592186314003} :answer-field/id #uuid "392caec0-4bec-552a-a683-fe5f52bda24d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314167}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ac3d430-ffd8-5d49-8cb6-f41434a00666" :question/math-academy-id "q-340343" :question/problem "Given that $y=\\frac{{log}_{3}⁡x}{{x}^{2}},$ find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=($\n{{field-1}}\n$)\\cdot \\frac{1}{{x}^{3}ln⁡3}$" :question/worked-solution "Let $u={log}_{3}⁡x=\\frac{ln⁡x}{ln⁡3}$ and $v={x}^{2}.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =\\frac{1}{xln⁡3}\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{({x}^{2}\\cdot \\frac{1}{xln⁡3}-\\frac{ln⁡x}{ln⁡3}\\cdot 2x)}{({x}^{2})^{2}} \\\\  & =\\frac{(\\frac{x}{ln⁡3}-\\frac{2xln⁡x}{ln⁡3})}{{x}^{4}} \\\\  & =\\frac{x-2xln⁡x}{{x}^{4}ln⁡3} \\\\  & =\\frac{x(1-2ln⁡x)}{{x}^{4}ln⁡3} \\\\  & =\\frac{1-2ln⁡x}{{x}^{3}ln⁡3} \\\\  & =(\\,1-2ln⁡x\\,)\\cdot \\frac{1}{{x}^{3}ln⁡3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062035c1-6c90-564d-8b13-de49b608d266" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x+sin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186326987} {:answer/id #uuid "2910abca-f7b3-5791-8f7a-5d785db71ac1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x(cos⁡x-sin⁡x)}{{x}^{2}}" :db/id #edb/ref 17592186327283} {:answer/id #uuid "307f5f77-d554-54f8-b07f-a055f9032570" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-sin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186327364} {:answer/id #uuid "4d34ef37-8d75-58c2-851f-7b695ddebb8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{cos⁡x-xsin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186327604} {:answer/id #uuid "bcdb9ba0-cdfe-5238-a0fa-e87668e2c5a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-sin⁡x}{x}" :db/id #edb/ref 17592186328576}] :answer-field/correct {:answer/id #uuid "307f5f77-d554-54f8-b07f-a055f9032570" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-sin⁡x}{{x}^{2}}" :db/id #edb/ref 17592186327364} :answer-field/id #uuid "0d1b0a80-ec7b-59ff-95e0-572af934d29c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329203}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "07e43382-7a4d-51f0-8c81-c9b869f5d27e" :question/math-academy-id "q-47994" :question/problem "Given that $y=\\frac{sin⁡x}{x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=sin⁡x$ and $v=x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =cos⁡x\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=1.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{x(cos⁡x)-sin⁡x\\cdot (1)}{(x)^{2}} \\\\  & =\\frac{xcos⁡x-sin⁡x}{{x}^{2}}.\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] [{:db/id #edb/ref 17592186115191 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115020 :question/id #uuid "23b1cfcf-9f46-5274-b07b-66770a827409" :question/math-academy-id "e-3646" :question/problem "Find $\\dfrac {\\textrm d y} {\\textrm d x}$ if $y = 2x - 3\\cot x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x-3cot⁡x) \\\\  & =2-3(-{csc}^{2}⁡x) \\\\  & =2+3{csc}^{2}⁡x\\end{aligned}\n$$"} :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/questions [{:db/id #edb/ref 17592186115521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80db9b17-c00d-5d41-aaa4-fa1e51dee63f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2} x - 25x^{4} + 23\\csc^{2} x" :db/id #edb/ref 17592186112136} {:answer/id #uuid "9a7b81c0-8ad2-587a-a241-99c48eb7e113" :answer/type {:db/ident :answer.type/math} :answer/value "25\\sec^{2} x - 23x^{4} + \\csc^{2} x" :db/id #edb/ref 17592186112137} {:answer/id #uuid "fa7e6faa-1dc6-5e22-b678-d60e43a5fb62" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2} x - 25x^{4} + \\sec^{2} x" :db/id #edb/ref 17592186112138} {:answer/id #uuid "782db20d-ef5b-5c18-b4e2-e4c9f20296ea" :answer/type {:db/ident :answer.type/math} :answer/value "23\\sec^{2} x - 25x^{4} + \\csc^{2} x" :db/id #edb/ref 17592186112139} {:answer/id #uuid "7d39749b-c0c4-5b8f-91c6-a484f187fd97" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2} x - 23x^{4} + \\csc^{2} x" :db/id #edb/ref 17592186112140}] :answer-field/id #uuid "bdce5dfa-0fbc-5104-abaa-ea3e2c51cf93" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112135}] :question/id #uuid "1d331471-9368-5e62-8b1a-84ad6ca208e2" :question/math-academy-id "q-17639" :question/problem "Find $f^{′}(x)$ if $f(x) = 23\\tan x - 5x^{5} - \\cot x$."} {:db/id #edb/ref 17592186115725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95923357-a465-5fc5-a88d-f447ee68027b" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc^{2} x" :db/id #edb/ref 17592186113317} {:answer/id #uuid "a19bc06b-d1f1-542e-975e-c02d34975d68" :answer/type {:db/ident :answer.type/math} :answer/value "2 - \\csc^{2} x" :db/id #edb/ref 17592186113318} {:answer/id #uuid "4cd529f5-560a-510a-8946-ed511fe08759" :answer/type {:db/ident :answer.type/math} :answer/value "-2 - \\csc x" :db/id #edb/ref 17592186113319} {:answer/id #uuid "5008fe11-cf1f-5851-8702-22f39d6b2d5e" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\csc x" :db/id #edb/ref 17592186113320} {:answer/id #uuid "64c6a260-94ff-5ad5-8c8a-dc743080aacd" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\csc^{2} x" :db/id #edb/ref 17592186113321}] :answer-field/id #uuid "2b32474e-1717-5b6a-8b09-11e1fe8bc43c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113316}] :question/id #uuid "ad857892-e3de-5073-9020-350ba1b93e6a" :question/math-academy-id "q-31279" :question/problem "Find $f^{′}(x)$ if $f(x) = 2x - \\cot x$."} {:db/id #edb/ref 17592186233781 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "73219a58-c08c-520e-96a1-4134d001c0d8" :question/math-academy-id "q-31288" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-6\\operatorname{cot}x.$" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-6\\operatorname{cot}x) \\\\  & =-6(-{csc}^{2}x) \\\\  & =6{csc}^{2}x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =6{csc}^{2}(\\frac{\\pi }{6}) \\\\  & =6{(2)}^{2} \\\\  & =24.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233787 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2bd5c98f-2174-5540-b7d6-172750f2ba2f" :question/math-academy-id "q-31355" :question/problem "Find ${f}^{'}(x)$ if $f(x)=\\frac{\\operatorname{cot}x}{{x}^{2}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{cot}x}{{x}^{2}}) \\\\  & =\\frac{(-{csc}^{2}x)\\cdot {x}^{2}-\\operatorname{cot}x\\cdot (2x)}{{x}^{4}} \\\\  & =\\frac{-x{csc}^{2}x-2\\operatorname{cot}x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342af53-2f55-5c64-ada7-5e6f534a392d" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}-{csc}^{2}⁡x" :db/id #edb/ref 17592186238108} {:answer/id #uuid "25e791c4-5e5d-54a5-a4d8-243c4ebd3551" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5-csc⁡x" :db/id #edb/ref 17592186238383} {:answer/id #uuid "2a8cdc06-3917-5a72-8baf-b7984c9c4345" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+csc⁡x" :db/id #edb/ref 17592186238429} {:answer/id #uuid "36a65434-a9ca-5879-a8bf-ac9ba0af8ece" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+{csc}^{2}⁡x" :db/id #edb/ref 17592186238526} {:answer/id #uuid "f072d48a-4459-559f-aaa6-60307b5cf008" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5-{csc}^{2}⁡x" :db/id #edb/ref 17592186240177}] :answer-field/correct {:answer/id #uuid "36a65434-a9ca-5879-a8bf-ac9ba0af8ece" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+{csc}^{2}⁡x" :db/id #edb/ref 17592186238526} :answer-field/id #uuid "d4627284-dc8a-5fab-aaa8-c7cf89fd3ae3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240707}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cfb4b430-487b-5445-947c-5c3c68e5ffd5" :question/math-academy-id "q-105309" :question/problem "Find ${f}^{′}(x)$ if $f(x)={5}^{x}-cot⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-cot⁡x) \\\\  & ={5}^{x}ln⁡5-(-{csc}^{2}⁡x) \\\\  & ={5}^{x}ln⁡5+{csc}^{2}⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf4c902-f4f0-5e66-8a96-dff670ee7f7f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+3{csc}^{2}(x)" :db/id #edb/ref 17592186313873}] :answer-field/correct {:answer/id #uuid "edf4c902-f4f0-5e66-8a96-dff670ee7f7f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+3{csc}^{2}(x)" :db/id #edb/ref 17592186313873} :answer-field/id #uuid "5a999c3f-682e-5c0e-a6ed-d84ccc7c3d5d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314265}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fc3f29f8-f5c9-5816-a926-df2d0b5bf36c" :question/math-academy-id "q-340595" :question/problem "Find ${g}^{′}(x)$ for $g(x)={e}^{x}-3cot⁡(x).$\n\n${g}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}-3cot⁡(x)) \\\\  & ={e}^{x}-3(-{csc}^{2}⁡(x)) \\\\  & ={e}^{x}+3{csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e7edecf-22c1-57ae-b9db-577c0bc42b57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cot}(x)}{x}" :db/id #edb/ref 17592186312992}] :answer-field/correct {:answer/id #uuid "7e7edecf-22c1-57ae-b9db-577c0bc42b57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cot}(x)}{x}" :db/id #edb/ref 17592186312992} :answer-field/id #uuid "61d877e6-8bc9-5db8-855a-3075f76bd9a6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314284}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "692c831b-b188-57f9-8d8a-25236044469a" :question/math-academy-id "q-340597" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}} $-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x)) \\\\  & =\\frac{1}{x}\\cdot \\operatorname{cot}⁡(x)+\\operatorname{ln}⁡(x)(-{csc}^{2}⁡(x)) \\\\  & =\\frac{\\operatorname{cot}⁡(x)}{x}-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56c1968-5cfb-5078-ac6d-1fb92ae0c8a2" :answer/type {:db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id #edb/ref 17592186313276}] :answer-field/correct {:answer/id #uuid "a56c1968-5cfb-5078-ac6d-1fb92ae0c8a2" :answer/type {:db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id #edb/ref 17592186313276} :answer-field/id #uuid "d98aad80-5c8a-5e64-afd9-dd37c9c06f08" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314612}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0fe74bab-fbda-57cd-8d62-b0fe7ee7ec0e" :question/math-academy-id "q-340598" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=x\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{cot}⁡(x)\\,-$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}⁡(x)) \\\\  & =1\\operatorname{cot}⁡(x)+x(-{csc}^{2}⁡(x)) \\\\  & =\\operatorname{cot}⁡(x)-x{csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d72bf0eb-ad62-5881-9084-66b56ea503b7" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}(x)" :db/id #edb/ref 17592186313672}] :answer-field/correct {:answer/id #uuid "d72bf0eb-ad62-5881-9084-66b56ea503b7" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}(x)" :db/id #edb/ref 17592186313672} :answer-field/id #uuid "e5eea6c3-db40-505b-9e0d-14232418925e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314641}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e8691b6d-0ecf-5d21-b2f3-79779cf5dbfe" :question/math-academy-id "q-340599" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{ln⁡(x)}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+{csc}^{2}⁡(x)\\,\\cdot ${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | $x{cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{ln⁡(x)}{cot⁡(x)}) \\\\  & =\\frac{cot⁡(x)\\cdot \\frac{1}{x}-ln⁡(x)(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{(\\frac{cot⁡(x)+xln⁡(x){csc}^{2}⁡(x)}{x})}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+{csc}^{2}⁡(x)\\cdot xln⁡(x)}{x{cot}^{2}⁡(x)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a88a36db-5e45-548d-8bfc-2a65d42b2b2f" :answer/type {:db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id #edb/ref 17592186313297}] :answer-field/correct {:answer/id #uuid "a88a36db-5e45-548d-8bfc-2a65d42b2b2f" :answer/type {:db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id #edb/ref 17592186313297} :answer-field/id #uuid "7bb36ddb-0276-5ac3-89fe-420e530a39fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314339}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e33e2c96-5cc5-507d-8909-c27b983d8b76" :question/math-academy-id "q-340603" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{x}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | ${cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x}{cot⁡(x)}) \\\\  & =\\frac{1(cot⁡(x))-x(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+x{csc}^{2}⁡(x)}{{cot}^{2}⁡(x)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a34f86b-faa2-5844-9680-3f6951dc4ecf" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{4}{csc}^{2}⁡x+8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401807} {:answer/id #uuid "63214331-a811-5bf2-8cb7-4da5c8c1d678" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}csc⁡x" :db/id #edb/ref 17592186401808} {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401809} {:answer/id #uuid "5a35c415-50b4-5005-8173-6121abbd643e" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}csc⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401810} {:answer/id #uuid "cb8e226f-a28c-5b1a-b7df-6f312bfd06a3" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x+8{x}^{3}tan⁡x" :db/id #edb/ref 17592186401811}] :answer-field/correct {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401809} :answer-field/id #uuid "f7aeb284-4f80-510f-8935-07a7e23c626b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401806}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" :question/math-academy-id "q-1913" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "739c6465-e65d-5e8a-9302-2401b613f4a3" :answer/type {:db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186484399}] :answer-field/correct {:answer/id #uuid "739c6465-e65d-5e8a-9302-2401b613f4a3" :answer/type {:db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186484399} :answer-field/id #uuid "610df292-6f25-5e8d-ae0d-aa6202e27c58" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484397}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "268686d4-3f61-5f6f-958f-b9cbd3d98bfa" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-23\\operatorname{cot}x.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-23\\operatorname{cot}x) \\\\  & =-23(-\\csc^{2}x) \\\\  & =23\\csc^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =23\\csc^{2}(\\frac{\\pi }{6}) \\\\  & =23{(2)}^{2} \\\\  & =92.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "937cb0f6-05f8-58c3-8390-fd1812e2fd5f" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186484402}] :answer-field/correct {:answer/id #uuid "937cb0f6-05f8-58c3-8390-fd1812e2fd5f" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186484402} :answer-field/id #uuid "00a38c63-6e30-59bb-a910-a17a9a30ca42" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484392}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "642226f4-4216-5997-8c49-d89893f16b26" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-20\\operatorname{cot}x.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-20\\operatorname{cot}x) \\\\  & =-20(-\\csc^{2}x) \\\\  & =20\\csc^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =20\\csc^{2}(\\frac{\\pi }{6}) \\\\  & =20{(2)}^{2} \\\\  & =80.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48b77b1b-2ca3-5e29-b239-ae26da66e788" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186484395}] :answer-field/correct {:answer/id #uuid "48b77b1b-2ca3-5e29-b239-ae26da66e788" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186484395} :answer-field/id #uuid "2e06b933-b611-5729-8f6a-7ac93664106e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484394}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "79d2874c-dd9d-510f-b175-5a641d94465c" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-18\\operatorname{cot}x.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-18\\operatorname{cot}x) \\\\  & =-18(-\\csc^{2}x) \\\\  & =18\\csc^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =18\\csc^{2}(\\frac{\\pi }{6}) \\\\  & =18{(2)}^{2} \\\\  & =72.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8fdaa06-37ba-5e90-8d0a-18e660b7323f" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186484406}] :answer-field/correct {:answer/id #uuid "f8fdaa06-37ba-5e90-8d0a-18e660b7323f" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186484406} :answer-field/id #uuid "4ecedb33-e80f-5b7c-87a0-10e4b71e3a3e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484396}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8aa4dfea-0782-5084-84c6-91694e3827da" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-12\\operatorname{cot}x.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-12\\operatorname{cot}x) \\\\  & =-12(-\\csc^{2}x) \\\\  & =12\\csc^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =12\\csc^{2}(\\frac{\\pi }{6}) \\\\  & =12{(2)}^{2} \\\\  & =48.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a288e9a3-a0a4-5506-a535-342896e55335" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186484403}] :answer-field/correct {:answer/id #uuid "a288e9a3-a0a4-5506-a535-342896e55335" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186484403} :answer-field/id #uuid "df78fbb8-649e-5da6-b3de-db8383faee78" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484404}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f063162f-159a-5fb0-8426-190c82972357" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-5\\operatorname{cot}x.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-5\\operatorname{cot}x) \\\\  & =-5(-\\csc^{2}x) \\\\  & =5\\csc^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =5\\csc^{2}(\\frac{\\pi }{6}) \\\\  & =5{(2)}^{2} \\\\  & =20.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] [{:db/id #edb/ref 17592186115193 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115022 :question/id #uuid "83b8a6dd-c8c4-5537-ac88-289265752755" :question/math-academy-id "e-3648" :question/problem "Find the slope of $y=f(x)$ at $x=\\dfrac{\\pi}{4}$ if $f(x) = \\dfrac{-2\\cot x}{\\sin x}.$" :question/worked-solution "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{-2cot⁡x}{sin⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(-2cot⁡x)\\cdot sin⁡x-(-2cot⁡x)\\cdot \\frac{\\text{d}}{\\text{d}x}(sin⁡x)}{{[sin⁡x]}^{2}} \\\\  & =\\frac{-2(-{csc}^{2}⁡x)\\cdot sin⁡x+2cot⁡x\\cdot (cos⁡x)}{{sin}^{2}⁡x} \\\\  & =\\frac{2csc⁡x+2cot⁡xcos⁡x}{{sin}^{2}⁡x}\\end{aligned}\n$$\n\nThen, we substitute $x=\\dfrac{\\pi}{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =\\frac{2csc⁡(\\frac{\\pi }{4})+2cot⁡(\\frac{\\pi }{4})cos⁡(\\frac{\\pi }{4})}{{sin}^{2}⁡(\\frac{\\pi }{4})} \\\\  & =\\frac{2\\cdot (\\sqrt{2})+2\\cdot (1)\\cdot (\\frac{\\sqrt{2}}{2})}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{3\\sqrt{2}}{(\\frac{1}{2})} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048465 :topic/math-academy-id 268 :topic/title "Finding Trigonometric Ratios of Special Angles Using the Unit Circle"} {:db/id #edb/ref 17592186050711 :topic/math-academy-id 332 :topic/title "Calculating the Slope of a Tangent Line Using Differentiation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186115528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2092ed7b-78ba-5b08-8ed9-5a3ae1c22f13" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{csc}⁡(\\sqrt{3})\\operatorname{cot}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186285080} {:answer/id #uuid "61025999-7cbd-5360-838b-eda24fb2a51c" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186285678} {:answer/id #uuid "a9b589e9-9125-5e9a-b153-823caacb3c8a" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})+\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})+\\frac{1}{3}" :db/id #edb/ref 17592186286334} {:answer/id #uuid "b5151810-8b1c-5b10-a7e3-87a15f4d9958" :answer/type {:db/ident :answer.type/math} :answer/value "11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186286435} {:answer/id #uuid "daba25ff-6035-5619-8ac0-07d5eb9bd01a" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{csc}⁡(\\sqrt{3})\\operatorname{cot}⁡(\\sqrt{3})-1" :db/id #edb/ref 17592186286782}] :answer-field/correct {:answer/id #uuid "61025999-7cbd-5360-838b-eda24fb2a51c" :answer/type {:db/ident :answer.type/math} :answer/value "-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186285678} :answer-field/id #uuid "ab8dc92d-302f-5800-8e99-962388310e9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287498}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c56fab41-d998-532e-9118-40493f1a0626" :question/math-academy-id "q-1886" :question/problem "Find the slope of $y=f(x)$ at $x=\\sqrt{3}$ if $f(x)=11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+\\frac{1}{x}.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(11\\operatorname{cos}⁡x-\\operatorname{sec}⁡x+{x}^{-1}) \\\\  & =11(-\\operatorname{sin}⁡x)-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}} \\\\  & =-11\\operatorname{sin}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x-\\frac{1}{{x}^{2}}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\sqrt{3}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\sqrt{3}) & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{(\\sqrt{3})^{2}} \\\\  & =-11\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186115531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d05e6b-994a-5931-90fb-0244e740694f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285997} {:answer/id #uuid "b9702af1-9a01-5ff4-990f-2b8e8b2bf574" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\sqrt{2}+2" :db/id #edb/ref 17592186286475} {:answer/id #uuid "c916f7e2-e71d-5044-a1e6-83799fa5fc80" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}+2" :db/id #edb/ref 17592186286622} {:answer/id #uuid "e5017828-3ef7-5857-8b3a-d98ae9e0243d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286882} {:answer/id #uuid "e79e42be-aa4f-50c1-a571-518a34f7f2ac" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sqrt{2}+2" :db/id #edb/ref 17592186286908}] :answer-field/correct {:answer/id #uuid "e5017828-3ef7-5857-8b3a-d98ae9e0243d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286882} :answer-field/id #uuid "8379a3b1-8766-53c7-86da-7fc0c6df7e5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287424}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18111828-8d82-5c70-b695-6858b89927bd" :question/math-academy-id "q-1905" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{4}$ if $f(x)=2x-\\sqrt{2}sec⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\sqrt{2}sec⁡x) \\\\  & =2-\\sqrt{2}sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =2-\\sqrt{2}sec⁡(\\frac{\\pi }{4})tan⁡(\\frac{\\pi }{4}) \\\\  & =2-\\sqrt{2}(\\sqrt{2})(1) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233087 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8cc9778d-34a0-53fe-a02e-327d24fefea1" :question/math-academy-id "q-104437" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{4}$ if $f(x)=x\\operatorname{cot}x.$" :question/worked-solution "First, we take the derivative using the product rule:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}x) \\\\  & =\\operatorname{cot}x+x(-{csc}^{2}x) \\\\  & =\\operatorname{cot}x-x{csc}^{2}x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{\\pi /4} & =\\operatorname{cot}(\\frac{\\pi }{4})-\\frac{\\pi }{4}{csc}^{2}(\\frac{\\pi }{4}) \\\\  & =1-\\frac{\\pi }{4}\\cdot (\\sqrt{2})^{2} \\\\  & =1-\\frac{\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e9d963-612a-5223-a2bb-a0380a286d94" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232832}] :answer-field/correct {:answer/id #uuid "03e9d963-612a-5223-a2bb-a0380a286d94" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232832} :answer-field/id #uuid "56422a4a-1f7d-5745-b018-ef376ed6e05f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232831}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6e21b5cf-a720-5e69-8578-f6d79190e60d" :question/math-academy-id "q-340642" :question/problem "Find the slope $m$ of $y=g(x)$ at $x=\\frac{\\pi }{2}$ if $g(x)=\\operatorname{csc}x\\operatorname{cot}x.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the product rule and sum rule:\n\n$$\n\\begin{aligned}{g}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csc}x\\operatorname{cot}x) \\\\  & =(-\\operatorname{csc}x\\operatorname{cot}x)(\\operatorname{cot}x)+(\\operatorname{csc}x)(-{csc}^{2}x) \\\\  & =-\\operatorname{csc}x({cot}^{2}x+{csc}^{2}x)\\end{aligned}\n$$\n\nNow, we substitute $x=\\frac{\\pi }{2}$ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={g}^{'}(\\frac{\\pi }{2}) & =-\\operatorname{csc}(\\frac{\\pi }{2})[{cot}^{2}(\\frac{\\pi }{2})+{csc}^{2}(\\frac{\\pi }{2})] \\\\  & =-1\\cdot ({0}^{2}+{1}^{2}) \\\\  & =-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f7e706-6667-560b-bd84-79164bd2ed56" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186238265} {:answer/id #uuid "485520fe-f7db-5462-90b3-8b9dc00969d6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186238684} {:answer/id #uuid "4ebd5941-c9bf-5355-a88c-6736db31de31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186238730} {:answer/id #uuid "746fc071-c68b-5025-87be-eb8a9b327237" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239055} {:answer/id #uuid "fe35b390-cf3c-53c9-b56a-b8e3bb467faa" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186240302}] :answer-field/correct {:answer/id #uuid "746fc071-c68b-5025-87be-eb8a9b327237" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186239055} :answer-field/id #uuid "1a5d153b-a4b3-593f-9ec7-5127df5989a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240372}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "10b5a865-9dfd-5753-8931-5381fe6e32af" :question/math-academy-id "q-104442" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=\\frac{sec⁡x}{\\sqrt{3}}+\\frac{3{x}^{2}}{\\pi }.$" :question/worked-solution "First, we take the derivative of each term and then add them, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{sec⁡x}{\\sqrt{3}}+\\frac{3{x}^{2}}{\\pi }) \\\\  & =\\frac{sec⁡xtan⁡x}{\\sqrt{3}}+\\frac{6x}{\\pi }\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{\\pi /3} & =\\frac{1}{\\sqrt{3}}\\cdot sec⁡(\\frac{\\pi }{3})\\cdot tan⁡(\\frac{\\pi }{3})+\\frac{6}{\\pi }\\cdot \\frac{\\pi }{3} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot 2\\cdot \\sqrt{3}+2 \\\\  & =2+2 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d15acc-1672-5ec4-bb78-f3474884b897" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-5\\sqrt{3}" :db/id #edb/ref 17592186284830} {:answer/id #uuid "48fabaf5-be8a-589c-8cf0-074c455a9240" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186285458} {:answer/id #uuid "63f73e2e-4004-5fc8-9825-f8337f6c2b07" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}-10\\sqrt{3}" :db/id #edb/ref 17592186285697} {:answer/id #uuid "766bb2aa-4af5-5e09-aed3-a777505c1a5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}+10\\sqrt{3}" :db/id #edb/ref 17592186285891} {:answer/id #uuid "e40e7c86-1ed2-5d5e-9940-61e65ceaec5c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186286873}] :answer-field/correct {:answer/id #uuid "e40e7c86-1ed2-5d5e-9940-61e65ceaec5c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186286873} :answer-field/id #uuid "e8570317-ecab-5ed9-a868-188d2c2ead8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287627}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f9daa906-697e-5ad9-9a96-96e98679f403" :question/math-academy-id "q-1904" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{6}$ if $f(x)=-{x}^{2}+5csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{d}{dx}(-{x}^{2}+5csc⁡x) \\\\  & =2\\cdot (-x)+5(-csc⁡xcot⁡x) \\\\  & =-2x-5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ into the derivative and get:\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{6}) & =-2(\\frac{\\pi }{6})-5csc⁡(\\frac{\\pi }{6})cot⁡(\\frac{\\pi }{6}) \\\\  & =-\\frac{\\pi }{3}-5\\cdot 2\\cdot \\sqrt{3} \\\\  & =-\\frac{\\pi }{3}-10\\sqrt{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4212e2b2-4307-5ba7-9307-27d580b7ec58" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }" :db/id #edb/ref 17592186312499}] :answer-field/correct {:answer/id #uuid "4212e2b2-4307-5ba7-9307-27d580b7ec58" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }" :db/id #edb/ref 17592186312499} :answer-field/id #uuid "5f109190-b06a-563b-a599-ac63006fd39c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314275}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a443ce48-9d5c-5ad3-838c-31eadde39a66" :question/math-academy-id "q-340630" :question/problem "Find the slope $m$ of $y=h(x)$ at $x=\\pi $ if $h(x)={e}^{x}+3\\operatorname{sec}⁡x.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}+3\\operatorname{sec}⁡x) \\\\  & ={e}^{x}+3\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nNow, we substitute $x=\\pi $ and evaluate the slope $m:$\n\n$$\n\\begin{aligned}m={h}^{′}(\\pi ) & ={e}^{\\pi }+3\\operatorname{sec}⁡(\\pi )\\operatorname{tan}⁡(\\pi ) \\\\  & ={e}^{\\pi }+3\\cdot (-1)\\cdot 0 \\\\  & ={e}^{\\pi }\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "faba1883-af56-500b-a141-28392efb394f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186313976}] :answer-field/correct {:answer/id #uuid "faba1883-af56-500b-a141-28392efb394f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186313976} :answer-field/id #uuid "7f7953c8-2aeb-585d-85e3-e06ca80b78e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314349}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "19b497f4-a444-5fb7-80fe-a52cd36cf318" :question/math-academy-id "q-340660" :question/problem "Find the slope of $y=f(x)$ at $x=0$ if $f(x)=\\frac{4x}{sec⁡x}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4x}{sec⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(4x)\\cdot sec⁡x-4x\\cdot \\frac{\\text{d}}{\\text{d}x}(sec⁡x)}{{sec}^{2}⁡x} \\\\  & =\\frac{4sec⁡x-4x\\cdot sec⁡xtan⁡x}{{sec}^{2}⁡x} \\\\  & =\\frac{4sec⁡x(1-xtan⁡x)}{{sec}^{2}⁡x} \\\\  & =\\frac{4(1-xtan⁡x)}{sec⁡x}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=0$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(0) & =\\frac{4(1-0\\cdot tan⁡0)}{sec⁡0} \\\\  & =\\frac{4(1-0)}{1} \\\\  & =4\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20324c7d-2431-5dbf-89ba-4a62fbbbbdeb" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{3}{\\pi }" :db/id #edb/ref 17592186336333} {:answer/id #uuid "2d601842-f51f-5a34-901c-3c87ed74673e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186336467} {:answer/id #uuid "c6ecc1e0-b453-5588-a3e8-923b6e7ebcab" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi -2" :db/id #edb/ref 17592186337797} {:answer/id #uuid "ec9d4934-d293-54d1-9eb4-aaf1a8bf5781" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }" :db/id #edb/ref 17592186338096} {:answer/id #uuid "ef4a666c-1131-5d8c-a6c2-62062090c6e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }+2" :db/id #edb/ref 17592186338125}] :answer-field/correct {:answer/id #uuid "2d601842-f51f-5a34-901c-3c87ed74673e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186336467} :answer-field/id #uuid "743b193f-17c2-5199-b0eb-adc69b1674c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338476}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b4b4054a-401d-511c-ba0c-65722b1ecab6" :question/math-academy-id "q-70874" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=ln⁡x+3csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+3csc⁡x) \\\\  & =\\frac{1}{x}+3(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}-3csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =\\frac{1}{(\\frac{\\pi }{3})}-3csc⁡(\\frac{\\pi }{3})cot⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{\\sqrt{3}})(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{3}) \\\\  & =\\frac{3}{\\pi }-2.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44e335b2-2f79-5710-bbc1-c60edb590906" :answer/type {:db/ident :answer.type/math} :answer/value "12\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186486530} {:answer/id #uuid "53178bc7-2dc1-53f1-a6a1-d11f22cc0728" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186486532} {:answer/id #uuid "9f9c0dfe-55ae-53c0-9db7-e14b3bd6a2c0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{csc}⁡(\\sqrt{3})\\operatorname{cot}⁡(\\sqrt{3})-\\frac{1}{3}" :db/id #edb/ref 17592186486534} {:answer/id #uuid "adb4bd5d-b0da-59ca-bd21-1ba0eda6617c" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\operatorname{sin}⁡(\\sqrt{3})+\\operatorname{sec}⁡(\\sqrt{3})\\operatorname{tan}⁡(\\sqrt{3})+\\frac{1}{3}" :db/id #edb/ref 17592186486535} {:answer/id #uuid "e7945de4-279b-51f5-9b79-90d2995d9c62" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\operatorname{sin}⁡(\\sqrt{3})-\\operatorname{csc}⁡(\\sqrt{3})\\operatorname{cot}⁡(\\sqrt{3})-1" :db/id #edb/ref 17592186486539}] :answer-field/correct {:answer/id #uuid "53178bc7-2dc1-53f1-a