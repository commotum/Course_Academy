{2}+0-{x}^{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0 \\\\ -2{x}^{2}\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dac886f-ec90-5d08-838c-5a59cf7394ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-7b \\\\ -7c\\end{bmatrix}" :db/id #edb/ref 17592186388405} {:answer/id #uuid "5a12801a-3fc5-59fe-a868-0dd7454f9d59" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7c \\\\ 7c\\end{bmatrix}" :db/id #edb/ref 17592186388406} {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7b \\\\ 7c\\end{bmatrix}" :db/id #edb/ref 17592186388407} {:answer/id #uuid "2ca00378-b5c5-5906-96a7-630208843a2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7b \\\\ 7b\\end{bmatrix}" :db/id #edb/ref 17592186388408} {:answer/id #uuid "b66bb36e-56a0-54a6-bcba-44591ba41152" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7c \\\\ 7b\\end{bmatrix}" :db/id #edb/ref 17592186388409}] :answer-field/correct {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7b \\\\ 7c\\end{bmatrix}" :db/id #edb/ref 17592186388407} :answer-field/id #uuid "00031ac6-c3f2-5a96-85f9-1258053acaf3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388404}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "89271958-955e-55b3-a956-b8c8b5250728" :question/math-academy-id "q-13556" :question/problem "Find $By$  if \n$B=\\begin{bmatrix}b & b \\\\ c & c\\end{bmatrix}$\nand\n$y=\\begin{bmatrix}3 \\\\ 4\\end{bmatrix}.$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product: \n\n$$\n\\begin{aligned}By & =\\begin{bmatrix}b & b \\\\ c & c\\end{bmatrix}\\begin{bmatrix}3 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}b\\cdot 3+b\\cdot 4 \\\\ c\\cdot 3+c\\cdot 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}3b+4b \\\\ 3c+4c\\end{bmatrix} \\\\  & =\\begin{bmatrix}7b \\\\ 7c\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}]}
