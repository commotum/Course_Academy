e/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186273456} {:answer/id #uuid "c1a18fc9-a5e4-5114-9e49-a25850256a3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186274068} {:answer/id #uuid "e9a0d5f2-4775-5f7c-a31f-fcc07ff6b602" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186274454}] :answer-field/correct {:answer/id #uuid "571f07e4-3cae-5eaa-8dbe-07b2ee76adde" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273133} :answer-field/id #uuid "0f6006ec-bc26-506d-945a-2f744a365967" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274660}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "907b2362-3732-5d22-8020-cc9e89939dae" :question/math-academy-id "q-152762" :question/problem "Evaluate ${\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z.$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z & ={lim}_{a\\to \\infty }{\\int }_{8}^{a}\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{8}^{a}{z}^{-4/3}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{[-3{z}^{-1/3}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{z}}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{a}}-\\frac{1}{\\sqrt[3]{8}}) \\\\  & =-6(0-\\frac{1}{2}) \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64e8a97c-bd31-58a6-ba54-a89ed0b36bd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186317910}] :answer-field/correct {:answer/id #uuid "64e8a97c-bd31-58a6-ba54-a8