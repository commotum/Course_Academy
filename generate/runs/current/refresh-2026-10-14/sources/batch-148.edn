e {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-3{R}_{1}" :db/id #edb/ref 17592186339741} {:answer/id #uuid "64bc7a5d-f05c-508b-8e6f-0c816e66dd68" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{1}" :db/id #edb/ref 17592186340019} {:answer/id #uuid "66d5039f-7e91-5441-b9ac-066a1add60d4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{2}" :db/id #edb/ref 17592186340032} {:answer/id #uuid "6efcee92-7f3a-5b03-8419-b8d8e7b73d4d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-2{R}_{2}" :db/id #edb/ref 17592186340112} {:answer/id #uuid "98eddd1d-580c-5f43-aabf-9b49e45c9fcb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{3}{R}_{3}" :db/id #edb/ref 17592186340508}] :answer-field/correct {:answer/id #uuid "44ff5f78-99ee-52f3-bd1d-6f04102d7f6c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-3{R}_{1}" :db/id #edb/ref 17592186339741} :answer-field/id #uuid "51eb3628-ef5f-5e6a-a72e-2dd27e5eda70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341527}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d64eac74-31dd-5514-b904-fdc9f48abd1b" :question/math-academy-id "q-72860" :question/problem "Given that\n$S=\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{bmatrix}$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{bmatrix}\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ -2 & 4 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is \n\n$$\n{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nor simply\n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}.\n$$"}] :knowledge-point/title "Identifying the Appropriate Row Operation To Transform a Given Entry to a Desired Value"}] [{:db/id #edb/ref 17592186124477 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124290 :question/id #uuid "ccfdc303-534f-530e-810b-f475a997f5d8" :question/math-academy-id "e-4703" :question/problem "The row echelon form matrix $B$ is given below. What are its pivot columns?\n![](images/ce/ce4c17b3e47f0618d315e8e61feeb2b58cd913e54b63a3a375b8bd4676efbc8e.svg)" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $2$nd, $3$rd, and $4$th columns:\n\n![](images/31/31b76b7840d750cf7cf060c5d218644f8733d46a0b59c0e347aeb634ea6c1091.svg)"} :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048980 :topic/math-academy-id 2083 :topic/title "Row Echelon Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186124903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b5eac8a-365f-5e3f-b4ec-4494dd19d536" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186321606} {:answer/id #uuid "5947ae45-97e5-58d4-85cf-768c57593ce3" :answer/type {:db/ident :answer.type/text} :answer/value "All the columns are pivot" :db/id #edb/ref 17592186321852} {:answer/id #uuid "6fe839e9-3060-5925-abca-bd0a772af174" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186322015} {:answer/id #uuid "a8c87cdf-4f58-5a9e-96fe-0c83a3b90268" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186322471} {:answer/id #uuid "d139e134-55eb-513c-a290-351de3157559" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" 