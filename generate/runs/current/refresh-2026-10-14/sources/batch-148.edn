1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756e234a-8217-5c8b-abaa-69ea121a0c6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393238} {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393239} {:answer/id #uuid "1a9cf17b-a149-5bc6-9345-792b1cc2a3c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & -5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393240} {:answer/id #uuid "1d4576b0-5970-52fb-8377-b193cb931a98" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393241} {:answer/id #uuid "4cfa023b-7905-5d00-83b5-528df496267c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393242}] :answer-field/correct {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393239} :answer-field/id #uuid "bdfc7f8f-fcd9-55fe-82a8-5f2ff5b50086" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393237}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2facacda-0611-5507-a35e-091ce7069bfa" :question/math-academy-id "q-72781" :question/problem "Consider the augmented matrix $N,$ given by\n\n$$\nN=\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ on $N?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ means that we need to add $-2$ times the first row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}N & =\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2+(-2)(1) & 1+(-2)(-2) & 2+(-2)(1) & 3+(-2)(-1) \\\\ 7 & -1 & 3 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186409514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4ab753-6b82-5ab8-ba3d-7608aa4c916d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409502} {:answer/id #uuid "194870f0-6df3-5b30-a6cd-f6757f9664e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409503} {:answer/id #uuid "1b67b21e-36ae-5c1e-8349-3329a2526d09" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -2 & 0 & -2 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409504} {:answer/id #uuid "d17d40c5-c1fa-5dba-9197-d5e6fe380c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409509} {:answer/id #uuid "ded53cb4-d3ae-5aa7-b6fd-20bffcd08576" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -2 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409510}] :answer-field/correct {:answer/id #uuid "d17d40c5-c1fa-5dba-9197-d5e6fe380c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409509} :answer-field/id #uuid "7dcb6b06-d72f-52cd-bd8f-33eb7f67405b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409512}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "56624c75-a028-5dc9-962f-9700b721674f" :question/math-academy-id "q-72785" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 4 & 3 & 2 & 1 \\\\ 1 & -1 & 0 & 3\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $V?$\n\n$$\n\\begin{aligned}{R}_{2} & ↔{R}_{3} \\\\ {R}_{2} & :={R}_{2}+(-1)\\cdot {R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}↔{R}_{3}$ means that we need to swap the second and third rows.\n\n- The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}V & =\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 4 & 3 & 2 & 1 \\\\ 1 & -1 & 0 & 3\\end{array}\\right]\\,{R}_{2}↔{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 1 & -1 & 0 & 3 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 1+(-1)(1) & -1+(-1)(0) & 0+(-1)(0) & 3+(-1)(2) \\\\ 4 & 3 & 2 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]\\end{aligned}\n$$"}] :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] [{:db/id #edb/ref 17592186059773 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059582 :question/id #uuid "a24c9621-793b-5c60-9c47-2b452f0faa2b" :question/math-academy-id "e-4695" :question/problem "Which elementary row operation could transform the matrix $A$ into the matrix $B$, where \n![](images/56/56fd7e343edf6c26f36718a30f899af6c8eaf0cad5f6b07c90ffa93c19df6346.png)" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has been changed is the $2$nd row. \n\nNow, applying the operation $R_2:=R_2+1 \\cdot R_1,$ we get the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-4 & -2 & 4 \\\\ 4 & 1 & 2 \\\\ 1 & 2 & 3\\end{bmatrix}\\,{R}_{2}:={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}-4 & -2 & 4 \\\\ 4+1\\cdot (-4) & 1+1\\cdot (-2) & 2+1\\cdot 4 \\\\ 1 & 2 & 3\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}-4 & -2 & 4 \\\\ 0 & -1 & 6 \\\\ 1 & 2 & 3\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the transformation could be done by the operation \n\n$$\nR_2:=R_2+1\\cdot R_1\n$$\n\nor simply\n\n$$\nR_2:=R_2+R_1.\n$$"} :knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd" :knowledge-point/questions [{:db/id #edb/ref 17592186060199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6a9a638-e29c-5cbb-95da-3c9432fff576" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + R_{3}" :db/id #edb/ref 17592186057655} {:answer/id #uuid "e74c6cd7-7601-5870-a276-a97c972b2d62" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}:=R_{1} + \\frac{1}{4}R_{2}" :db/id #edb/ref 17592186057656} {:answer/id #uuid "1a8a15ec-ce37-5b11-beb7-6800b50f1cfd" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=\\frac{1}{4}R_{2}" :db/id #edb/ref 17592186057657} {:answer/id #uuid "4be00846-229b-5fb9-8858-1207d8d92927" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-3)R_{1}" :db/id #edb/ref 17592186057658} {:answer/id #uuid "6153c56b-fcda-50c4-8d6e-921afef47c5f" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}↔R_{2}" :db/id #edb/ref 17592186057659}] :answer-field/id #uuid "9f48f084-035b-5804-a392-e1b695b074e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057654}] :question/id #uuid "e2dc9d0e-faaf-52a3-b487-1837ebe01f47" :question/math-academy-id "q-20240" :question/problem "Which of the following elementary row operations transforms the matrix $A$ into the matrix $B$, where\n$A = \\begin{bmatrix}1 & 2 & 4 \\\\ 4 & 1 & 2 \\\\ 0 & -7 & -14\\end{bmatrix}, B = \\begin{bmatrix}1 & 2 & 4 \\\\ 1 & -5 & -10 \\\\ 0 & -7 & -14\\end{bmatrix}$?"} {:db/id #edb/ref 17592186060203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfed05c-425f-552b-b8cc-895234c69fd3" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}:=R_{3} + (-3)R_{1}" :db/id #edb/ref 17592186057679} {:answer/id #uuid "1e87f9e1-9cbe-5c36-a131-fbbba14c1293" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}:=\\frac{1}{3}R_{3}" :db/id #edb/ref 17592186057680} {:answer/id #uuid "3f3782c8-74ea-5e38-92bb-cff6d4a22f36" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}↔R_{3}" :db/id #edb/ref 17592186057681} {:answer/id #uuid "46d42c59-6fef-5a37-ae48-bc9e582ce69d" :answer/type {:db/ident :answer.type/math} :answer/value "R_{1}↔R_{2}" :db/id #edb/ref 17592186057682} {:answer/id #uuid "6402f5be-8426-5a6f-9157-a02fa3dfe02f" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + 3R_{1}" :db/id #edb/ref 17592186057683}] :answer-field/id #uuid "67101441-c29f-53f5-8a75-53e447a10ce2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057678}] :question/id #uuid "a2105120-b69b-54ae-a450-1a629e320d19" :question/math-academy-id "q-20389" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $Y$, where\n$X = \\begin{bmatrix}7 & 3 & 2 \\\\ 4 & 5 & 2 \\\\ 9 & 3 & 5\\end{bmatrix}, Y = \\begin{bmatrix}9 & 3 & 5 \\\\ 4 & 5 & 2 \\\\ 7 & 3 & 2\\end{bmatrix}$?"} {:db/id #edb/ref 17592186265820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af69085-0030-572e-b52e-dcc632cfeb8d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-2)\\cdot {R}_{1}" :db/id #edb/ref 17592186263254} {:answer/id #uuid "5ebcc636-d88c-55d2-a740-a27caf069c18" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{5}\\cdot {R}_{3}" :db/id #edb/ref 17592186263822} {:answer/id #uuid "780bfbb2-7d3d-56d9-8b2b-a7d0e4c71c99" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+{R}_{2}" :db/id #edb/ref 17592186264042} {:answer/id #uuid "90babf1e-2cff-5e69-94d1-dffcb8720e1d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/id #edb/ref 17592186264244} {:answer/id #uuid "e15f22cd-b3f4-5838-8dce-e4a76cdee1d4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-\\frac{3}{10})\\cdot {R}_{3}" :db/id #edb/ref 17592186264958}] :answer-field/correct {:answer/id #uuid "5ebcc636-d88c-55d2-a740-a27caf069c18" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{5}\\cdot {R}_{3}" :db/id #edb/ref 17592186263822} :answer-field/id #uuid "1e506518-b054-5cf5-929f-375c13a354c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265294}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b8c55c12-17df-581d-b93b-78d07db8cec0" :question/math-academy-id "q-130087" :question/problem "Which of the following elementary row operations transforms the matrix $A$ into the matrix $B$, where\n\n$$\nA=\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 10 & 5 & -5\\end{bmatrix},\\,B=\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 2 & 1 & -1\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st and the $2$nd rows are the same in both matrices. The only row that has changed is the $3$rd row. \n\nBy considering the given row operations that modify the $3$rd row, we notice that\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 10 & 5 & -5\\end{bmatrix} & {R}_{3}:=\\frac{1}{5}\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}5 & 2 & -3 \\\\ -8 & 0 & 2 \\\\ 2 & 1 & -1\\end{bmatrix} \\\\  & =B.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:=\\frac{1}{5}\\cdot {R}_{3}.\n$$"} {:db/id #edb/ref 17592186265822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18eecb6b-e55a-580a-a528-9515405968ac" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186263237} {:answer/id #uuid "73f8fe8d-5e24-5253-ba73-d97dee5c4859" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{3}\\cdot {R}_{1}" :db/id #edb/ref 17592186264009} {:answer/id #uuid "74c9e1f2-6a6b-56d3-9d44-66769ac34cd5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186264013} {:answer/id #uuid "94ca2a1b-485a-5fd5-b46c-769bb7676a4b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=3\\cdot {R}_{1}" :db/id #edb/ref 17592186264273} {:answer/id #uuid "c31b9aac-2e88-5b1a-b16a-3655f0039486" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-\\frac{4}{7})\\cdot {R}_{2}" :db/id #edb/ref 17592186264700}] :answer-field/correct {:answer/id #uuid "94ca2a1b-485a-5fd5-b46c-769bb7676a4b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=3\\cdot {R}_{1}" :db/id #edb/ref 17592186264273} :answer-field/id #uuid "879c7689-ba35-53bc-8a73-459e579b54ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265484}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "84b806b0-6ebe-59b8-9bb2-7c89ea346a6f" :question/math-academy-id "q-130095" :question/problem "Which of the following elementary row operations transforms the matrix  $C$ into the matrix $D$, where \n\n$$\nC=\\begin{bmatrix}-2 & 1 & -1 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix},\\,D=\\begin{bmatrix}-6 & 3 & -3 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd and the $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that modify the $1$st row, we notice that\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}-2 & 1 & -1 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix} & {R}_{1} & :=3\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}-6 & 3 & -3 \\\\ 7 & 7 & 2 \\\\ -6 & 1 & 6\\end{bmatrix} \\\\  & =D.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:=3\\cdot {R}_{1}.\n$$"} {:db/id #edb/ref 17592186265824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70b5d61f-c9bb-53db-b9f8-776572325e44" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-{R}_{1}" :db/id #edb/ref 17592186263975} {:answer/id #uuid "80400201-820c-5bf7-9494-f3be26c3120e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=(-\\frac{8}{3})\\cdot {R}_{3}" :db/id #edb/ref 17592186264103} {:answer/id #uuid "8cc226bf-c629-576a-a0b1-9200550a1b26" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186264204} {:answer/id #uuid "9d09eadd-fb6a-5d4b-9197-8a7bc4cf994d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-5)\\cdot {R}_{1}" :db/id #edb/ref 17592186264343} {:answer/id #uuid "da0b59f1-817e-5b44-bdcc-047175c24ec1" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=(-\\frac{3}{8})\\cdot {R}_{2}" :db/id #edb/ref 17592186264901}] :answer-field/correct {:answer/id #uuid "8cc226bf-c629-576a-a0b1-9200550a1b26" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186264204} :answer-field/id #uuid "d8120c56-5c2a-5c36-bb8b-b495ce68084e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265620}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "85e6dfb7-2447-51c4-a184-4a363a6b54d0" :question/math-academy-id "q-130100" :question/problem "Which of the following elementary row operations transforms the matrix $E$ into the matrix $F$, where\n\n$$\nE=\\begin{bmatrix}5 & -2 & 3 \\\\ 8 & -3 & 7 \\\\ -3 & 1 & -3\\end{bmatrix},\\,F=\\begin{bmatrix}5 & -2 & 3 \\\\ -3 & 1 & -3 \\\\ 8 & -3 & 7\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st row is the same in both matrices. The only rows that have changed are the $2$nd row and the $3$rd row.   \n\nBy considering the given row operations that change both the $2$nd and the $3$rd row, we notice that \n\n$$\n\\begin{aligned}E & =\\begin{bmatrix}5 & -2 & 3 \\\\ 8 & -3 & 7 \\\\ -3 & 1 & -3\\end{bmatrix} & {R}_{2}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}5 & -2 & 3 \\\\ -3 & 1 & -3 \\\\ 8 & -3 & 7\\end{bmatrix} \\\\  & =F.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}↔{R}_{3}.\n$$"} {:db/id #edb/ref 17592186265825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04b59128-335a-5c7e-a797-47cf712164a4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+5{R}_{3}" :db/id #edb/ref 17592186263043} {:answer/id #uuid "07b0872a-0ee3-5a48-8b29-e7a390b686f5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186263070} {:answer/id #uuid "7ce7255c-8139-5e6e-977f-00a5882719ed" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{5}{R}_{3}" :db/id #edb/ref 17592186264077} {:answer/id #uuid "8f523dfa-2a5c-572d-a6a8-32d391eb708f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186264229} {:answer/id #uuid "cf8961fc-9d65-5127-950c-b6ad08adc159" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+5{R}_{1}" :db/id #edb/ref 17592186264816}] :answer-field/correct {:answer/id #uuid "04b59128-335a-5c7e-a797-47cf712164a4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+5{R}_{3}" :db/id #edb/ref 17592186263043} :answer-field/id #uuid "f5287a79-37ef-5b18-8c01-fe42f7511edd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265684}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8d79bcd3-c9f6-51cc-bac3-1326fcc4218c" :question/math-academy-id "q-130103" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=\\begin{bmatrix}0 & 0 & 5 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix},\\,W=\\begin{bmatrix}5 & -5 & -10 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd and the $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that modify the $1$st row, we notice that\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}0 & 0 & 5 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix}\\,{R}_{1}:={R}_{1}+5\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}5 & -5 & -10 \\\\ 5 & 6 & 10 \\\\ 1 & -1 & -3\\end{bmatrix} \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+5{R}_{3}.\n$$"} {:db/id #edb/ref 17592186287989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5c7599-29ce-5dfb-b9ba-7e6fb2bf85d8" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}-\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186284920} {:answer/id #uuid "3a3de505-4af9-587f-bcca-65ed2365b867" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=-\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285336} {:answer/id #uuid "5495a455-efc7-5ebe-b382-a6c7dce1ea64" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285564} {:answer/id #uuid "f489821f-daaf-5cd9-bdf8-076fa189ac14" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=(-2){R}_{1}" :db/id #edb/ref 17592186287030} {:answer/id #uuid "fd46554d-54cc-5fd1-8d36-7125d02933cd" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{4}{R}_{2}" :db/id #edb/ref 17592186287104}] :answer-field/correct {:answer/id #uuid "5495a455-efc7-5ebe-b382-a6c7dce1ea64" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285564} :answer-field/id #uuid "5b9e0856-cd52-5230-aead-a0e0ab0fa9b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287343}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bf5f9366-1ce3-5395-93b6-14a04149ebc4" :question/math-academy-id "q-20387" :question/problem "Which of the following elementary row operations transforms the matrix $S$ into the matrix $T$, where\n\n$$\nS=\\begin{bmatrix}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix},\\,T=\\begin{bmatrix}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd and $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that changes the $1$st  row, we notice that\n\n$$\n\\begin{aligned}S & =\\begin{bmatrix}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix} & \\,{R}_{1}:=\\frac{1}{4}\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{bmatrix} \\\\  & =T.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:=\\frac{1}{4}{R}_{1}.\n$$"} {:db/id #edb/ref 17592186341877 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc83716-bcdd-5971-b345-0a3b056ccd8d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186339517} {:answer/id #uuid "2d77cf58-f845-5176-9aa2-991f2712d10d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{1}" :db/id #edb/ref 17592186339527} {:answer/id #uuid "765b9679-06bc-5c19-a38d-2a4e2df30fc9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{2}+(-5){R}_{1}" :db/id #edb/ref 17592186340183} {:answer/id #uuid "9762987d-0a0c-5c9d-a411-04ea1e36360b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186340491} {:answer/id #uuid "f9f7715c-928c-5d36-aa0c-fa5710955380" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=2{R}_{3}+4{R}_{1}" :db/id #edb/ref 17592186341337}] :answer-field/correct {:answer/id #uuid "2cc83716-bcdd-5971-b345-0a3b056ccd8d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186339517} :answer-field/id #uuid "323bfb27-13db-5ad8-9ce5-e34beac999ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341469}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c70a88ac-8f1d-5e97-afff-9c3f83ff71f2" :question/math-academy-id "q-72850" :question/problem "Which of the following elementary row operations transforms the matrix $U$ into the matrix $V$, where\n\n$$\nU=\\begin{bmatrix}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{bmatrix},\\,V=\\begin{bmatrix}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $2$nd row is the same in both matrices. The only rows that have changed are the $1$st row and the $3$rd row.   \n\nBy considering the given row operations that change both the $1$st and the $3$rd row, we notice that\n\n$$\n\\begin{aligned}U & =\\begin{bmatrix}1 & 3 & 2 \\\\ 6 & 4 & 5 \\\\ 1 & 2 & -1\\end{bmatrix} & \\,{R}_{1}↔{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 2 & -1 \\\\ 6 & 4 & 5 \\\\ 1 & 3 & 2\\end{bmatrix} \\\\  & =V.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}↔{R}_{3}.\n$$"} {:db/id #edb/ref 17592186341878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14beb007-c69a-5ab7-974c-8b10dc220da9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/id #edb/ref 17592186339312} {:answer/id #uuid "195eaddc-f871-5643-a440-887c3d944ede" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{3}" :db/id #edb/ref 17592186339352} {:answer/id #uuid "5638c8ca-be0f-53bb-8e47-8a06ac66a0a5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186339916} {:answer/id #uuid "a87e9a85-4c7f-5663-9658-9578bf406123" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/id #edb/ref 17592186340659} {:answer/id #uuid "dd65c7d4-9bf4-5a81-bb2c-8537f1f6b07f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186341094}] :answer-field/correct {:answer/id #uuid "a87e9a85-4c7f-5663-9658-9578bf406123" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/id #edb/ref 17592186340659} :answer-field/id #uuid "327a5532-0a35-5d86-90b5-6ede866a293a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341471}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4a88dee0-a622-519b-8c88-19f1fcfff46b" :question/math-academy-id "q-72854" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=\\begin{bmatrix}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{bmatrix},\\,W=\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{bmatrix}\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{bmatrix} \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1}.\n$$"} {:db/id #edb/ref 17592186341879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10fde8ed-c795-5da4-a95b-29e46375fcb5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186339278} {:answer/id #uuid "48f4fc3d-dee9-5c13-9595-5090d724fdc4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186339781} {:answer/id #uuid "911d1403-8ac9-5500-adca-d4b8a3503e13" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2}" :db/id #edb/ref 17592186340430} {:answer/id #uuid "e9244a29-e0f3-5ccf-9e6a-6f0730c28beb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{3}" :db/id #edb/ref 17592186341181} {:answer/id #uuid "ee14cd60-0a49-5fe7-9d23-89ee4e2073f7" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{1}" :db/id #edb/ref 17592186341228}] :answer-field/correct {:answer/id #uuid "10fde8ed-c795-5da4-a95b-29e46375fcb5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1}" :db/id #edb/ref 17592186339278} :answer-field/id #uuid "257bad1f-221a-57d2-9d78-0054a16aca97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341445}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dd718a57-6301-5304-b58e-f8632645f2ed" :question/math-academy-id "q-72856" :question/problem "Which of the following elementary row operations transforms the matrix $K$ into the matrix $L$, where\n\n$$\nK=\\begin{bmatrix}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{bmatrix},\\,L=\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{bmatrix}?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}K & =\\begin{bmatrix}1 & 3 & 2 \\\\ -2 & 4 & -2 \\\\ 0 & -1 & -1\\end{bmatrix}\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & 2 \\\\ 0 & 10 & 2 \\\\ 0 & -1 & -1\\end{bmatrix} \\\\  & =L.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+2{R}_{1}.\n$$"}] :knowledge-point/title "Identifying the Appropriate Row Operation To Transform One Matrix Into Another"}] [{:db/id #edb/ref 17592186059774 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059583 :question/id #uuid "f8417bbc-b748-519b-a997-fbb4aed755eb" :question/math-academy-id "e-4696" :question/problem "Given that\n![](images/59/59ee8e91d058e347238320a2bd5496630f33534564f67f901d2ddf89000f0108.png) which elementary row operation could make $a_{22}=0?$" :question/worked-solution "In the given matrix, we have $a_{22}=5$ and we want to perform an elementary row operation that makes $a_{22}=0.$\n\n- We *cannot* make $a_{22}=0$ by switching two rows, because there are no rows with $0$ as the second entry.\n\n- We *cannot* multiply the second row by $0,$ because we are only allowed to multiply rows by *nonzero* constants.\n\n- However, we *can* add a multiple of another row to the $2$nd row to make $a_{22}=0.$\n\nLooking at the first row, we see that $a_{12}=1.$ If we add $-5$ times this entry to $a_{22},$ we will get $a_{22}=0$ as desired. So, the elementary row operation that we need to use is\n\n$$\nR_2 := R_2 + (-5) \\cdot R_1.\n$$\n\nApplying this operation, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 1 & -2 \\\\ -1 & 5 & 6 \\\\ 0 & 2 & 4\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-5)\\cdot {R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 1 & -2 \\\\ -1+(-5)\\cdot 3 & 5+(-5)\\cdot 1 & 6+(-5)\\cdot (-2) \\\\ 0 & 2 & 4\\end{bmatrix} \\\\  & ∼\\begin{bmatrix}3 & 1 & -2 \\\\ -16 & 0 & 16 \\\\ 0 & 2 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the desired elemetary row operation is\n\n$$\nR_2 := R_2 + (-5) \\cdot R_1,\n$$\n\nor simply\n\n$$\nR_2 := R_2 -5 R_1.\n$$"} :knowledge-point/id #uuid "0464b51e-8568-521e-96a5-a65c04569c2a" :knowledge-point/questions [{:db/id #edb/ref 17592186060202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41716f23-ee4c-5bb2-a921-beab82d30ab6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=(-2){R}_{2}" :db/id #edb/ref 17592186285397} {:answer/id #uuid "b9c8e1e8-c9d8-5c14-aef8-3d331f2305c6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186286481} {:answer/id #uuid "d18900fd-9449-5555-8667-d815a552643c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186286692} {:answer/id #uuid "eaa65898-2c49-5b99-bcc1-f887fbd2e749" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-3){R}_{1}" :db/id #edb/ref 17592186286938} {:answer/id #uuid "ef596c19-3210-593c-9060-0306e67f0299" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{3}" :db/id #edb/ref 17592186286983}] :answer-field/correct {:answer/id #uuid "ef596c19-3210-593c-9060-0306e67f0299" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{3}" :db/id #edb/ref 17592186286983} :answer-field/id #uuid "a3482a72-d76b-517a-a632-b7cefc297370" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287475}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9ec5da5b-045b-5f9b-81d1-dca84ed41202" :question/math-academy-id "q-20388" :question/problem "Given that\n$C=\\begin{bmatrix}4 & 6 & 2 \\\\ 3 & 6 & 4 \\\\ 2 & 3 & 1\\end{bmatrix}$,\nwhich of the following elementary row operations makes ${a}_{22}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C & =\\begin{bmatrix}4 & 6 & 2 \\\\ 3 & 6 & 4 \\\\ 2 & 3 & 1\\end{bmatrix}\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{3} \\\\  & ∼\\begin{bmatrix}4 & 6 & 2 \\\\ -1 & 0 & 2 \\\\ 2 & 3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$"} {:db/id #edb/ref 17592186060204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbacce2f-e401-55d5-b198-479ced06aab8" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=\\frac{1}{3}R_{2}" :db/id #edb/ref 17592186057685} {:answer/id #uuid "ed4da000-e209-5984-82b2-47dcd76ab0db" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=(-1)R_{2}" :db/id #edb/ref 17592186057686} {:answer/id #uuid "fee2cb51-1eff-502c-8aef-dc646f0368ce" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}↔R_{1}" :db/id #edb/ref 17592186057687} {:answer/id #uuid "19035f05-2f9f-5ad0-9df1-b300d9f2846b" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + R_{1}" :db/id #edb/ref 17592186057688} {:answer/id #uuid "5e83af35-57c0-56fe-9662-1c2a19b19f93