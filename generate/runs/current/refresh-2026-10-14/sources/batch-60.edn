db/ref 17592186331930}] :answer-field/correct {:answer/id #uuid "83b153b7-2aaa-5823-8b5c-ce9f1a4bbc39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}ln⁡|x|+C" :db/id #edb/ref 17592186331120} :answer-field/id #uuid "aecf8e36-3fbd-5edb-aa3b-f4cafc82e67e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332505}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0721a79b-46f6-56dc-93df-e0a639013e16" :question/math-academy-id "q-49097" :question/problem "Calculate $\\int \\frac{\\text{d}x}{9x}.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{1}{9}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{9x} & =\\frac{1}{9}\\int \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{9}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{1}{9}ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cf665c7-1dff-56a8-a3c6-fb9c10945332" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\operatorname{ln}⁡|x|}+C" :db/id #edb/ref 17592186236098} {:answer/id #uuid "34032b6f-eb99-5e91-bdbb-1e84068bc722" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|x|}{5}+C" :db/id #edb/ref 17592186236148} {:answer/id #uuid "a1fcf7ed-963f-52ab-9901-90952782a3bc" :answer/type {:db/ident :answer.type/math} :answer/value "5+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236831} {:answer/id #uuid "eaeb0807-fa69-565f-a63b-96f8e43dd5e0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186237294} {:answer/id #uuid "eebee465-4e2c-5dfa-b1ab-73fac6c46049" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186237321}] :answer-field/correct {:answer/id