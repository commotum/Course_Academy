a58-b9e6-26e92886a8e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237712}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "05650b77-8467-5403-8d37-57ab51debfc5" :question/math-academy-id "q-103590" :question/problem "Calculate $\\int \\frac{10}{x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $10$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{10}{x}\\,\\text{d}x & =10\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =10ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155da407-c8ba-5fa2-9127-413d6bff8d2a" :answer/type {:db/ident :answer.type/math} :answer/value "3ln⁡x+C" :db/id #edb/ref 17592186295391} {:answer/id #uuid "2ca76ff5-0227-56f5-94be-d80b462a5d45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{ln⁡x}+C" :db/id #edb/ref 17592186295528} {:answer/id #uuid "5c5899f6-d895-5413-bfee-0587b9cf1149" :answer/type {:db/ident :answer.type/math} :answer/value "3ln⁡|x|+C" :db/id #edb/ref 17592186295802} {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} {:answer/id #uuid "bd595728-5d66-5fce-842a-829a9bf9e495" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-3}{ln⁡|x|}+C" :db/id #edb/ref 17592186296265}] :answer-field/correct {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} :answer-field/id #uuid "d6439f4c-9689-5960-aa2c-ca05e0a5ed1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297080}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f3f7435c-4593-5eb7-979c-b6475dc0ac4f" :question/math-academy-id "q-29831" :question/problem "Calculate $\\int -\\frac{3}{x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-3$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{3}{x}\\,\\text{d}x & =-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-3ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb7f045-75a2-5840-b035-0d22f40ce914" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295332} {:answer/id #uuid "22008f65-56ab-5584-b2a7-219b8aa929b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295457} {:answer/id #uuid "55122d04-bb93-5d8b-8bd4-d64b3d678903" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{ln}⁡(|x|+C)" :db/id #edb/ref 17592186295758} {:answer/id #uuid "90945f15-66e1-5752-949d-0d39a8268628" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{\\sqrt{2}|x|}{2}+C)" :db/id #edb/ref 17592186296042} {:answer/id #uuid "96e578e3-22a1-5b23-8aa9-28c1fa572382" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\sqrt{2}|x|)+C" :db/id #edb/ref 17592186296072}] :answer-field/correct {:answer/id #uuid "0bb7f045-75a2-5840-b035-0d22f40ce914" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295332} :answer-field/id #uuid "3795ff06-964f-5f69-a112-7a5a0ee759bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296737}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ac24bc33-26ae-5498-b55b-b6545ea0f7e9" :question/math-academy-id "q-29838" :question/problem "Calculate $\\int \\frac{1}{x\\sqrt{2}}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{1}{\\sqrt{2}}=\\frac{1}{\\sqrt{2}}\\frac{\\sqrt{2}}{\\sqrt{2}}=\\frac{\\sqrt{2}}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{x\\sqrt{2}}\\,\\text{d}x & =\\frac{1}{\\sqrt{2}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =\\frac{\\sqrt{2}}{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06934704-6ef1-5664-b98a-208fbb67f444" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}ln⁡|x|+C" :db/id #edb/ref 17592186336083} {:answer/id #uuid "11affbda-3790-5221-a0f9-206efc0697e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}ln⁡|x|+C" :db/id #edb/ref 17592186336199} {:answer/id #uuid "2fdee0a7-95bf-510c-9d92-6457ba59b30e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡|x|+C" :db/id #edb/ref 17592186336490} {:answer/id #uuid "7d51ab48-706c-5b44-9e31-d4ec0674610d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡|x|+C" :db/id #edb/ref 17592186337162} {:answer/id #uuid "f462f1c7-7422-5d7f-8f83-3c7c9b4ffdf5" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡|x|+C" :db/id #edb/ref 17592186338166}] :answer-field/correct {:answer/id #uuid "06934704-6ef1-5664-b98a-208fbb67f444" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}ln⁡|x|+C" :db/id #edb/ref 17592186336083} :answer-field/id #uuid "51238528-a87b-5d1d-a6db-71ac85ba4345" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338417}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8fbc7600-3894-5ba1-954f-4082eb977ea7" :question/math-academy-id "q-71098" :question/problem "Calculate $\\int -\\frac{2}{5x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{2}{5}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{2}{5x}\\,\\text{d}x & =-\\frac{2}{5}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{2}{5}ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} {:answer/id #uuid "58b493c2-73d3-5db1-af15-0200a2937632" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186336844} {:answer/id #uuid "daf20704-2d65-5753-af90-f6e026c52e12" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186337940} {:answer/id #uuid "ec4261ce-b5b3-5551-9fbd-56937e1eea24" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186338091} {:answer/id #uuid "f7a97ce9-ff10-5758-b496-1ffe87d0bb3c" :answer/type {:db/ident :answer.type/math} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186338202}] :answer-field/correct {:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} :answer-field/id #uuid "f930863c-55bb-55cc-bd9d-51b8ae4abea3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338715}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d9daecf1-e255-5c0c-a433-fdc798f551aa" :question/math-academy-id "q-72059" :question/problem "Calculate $\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ad457ab-9dfe-5e17-83b4-d6d8e14c7be3" :answer/type {:db/ident :answer.type/math} :answer/value "12\\ln|x|+C" :db/id #edb/ref 17592186484362} {:answer/id #uuid "a18fd0e7-7d34-5323-850d-89e75bc773cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(12+x)+C" :db/id #edb/ref 17592186484363} {:answer/id #uuid "a7e0b24d-5bf5-5b2e-807d-c4441d0c8640" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(12-x)+C" :db/id #edb/ref 17592186484364} {:answer/id #uuid "c1d6e8fc-61ca-52fb-b90d-a1132046e6da" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln|x|+12x+C" :db/id #edb/ref 17592186484365} {:answer/id #uuid "ff6d022c-c3aa-5965-9460-e44fb365dc40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\ln|x|+C" :db/id #edb/ref 17592186484368}] :answer-field/correct {:answer/id #uuid "ff6d022c-c3aa-5965-9460-e44fb365dc40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\ln|x|+C" :db/id #edb/ref 17592186484368} :answer-field/id #uuid "eed8a3c1-45f5-5263-95f8-3a596c4a54c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186484367}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d301a42e-a966-5b54-9419-2f4b091a74c6" :question/problem "Calculate $\\int \\frac{\\text{d}x}{12x}.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{1}{12}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}x}{12x} & =\\frac{1}{12}\\int \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{12}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\ln|x|+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a Reciprocal Function"}] [{:db/id #edb/ref 17592186184351 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183947 :question/id #uuid "70fd3433-e905-5643-8e55-0bdf774d781e" :question/math-academy-id "e-14404" :question/problem "Calculate  $\\displaystyle \\int \\dfrac {e^{2x}} {e^{2x} + 1} \\, \\textrm{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u = e^{2x}+1.$ Differentiating gives \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 2e^{2x}\\quad\\Longrightarrow\\quad\n\\dfrac{1}{2}\\, \\textrm{d}u = e^{2x} \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}}{{e}^{2x}+1}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}+1}\\cdot {e}^{2x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{e}^{2x}+1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({e}^{2x}+1)+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x.$"} :knowledge-point/id #uuid "ed3b6c3d-b840-50ef-9e6b-584bf14877b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049443 :topic/math-academy-id 1361 :topic/title "Integrating the Reciprocal Function"}] :knowledge-point/questions [{:db/id #edb/ref 17592186184451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29e54fcf-d2f2-5df4-90db-2d54fb195e46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{({e}^{3x}+2)}^{4}}{4}+C" :db/id #edb/ref 17592186247795} {:answer/id #uuid "431bf13d-976e-5095-9df8-63b0916664a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{({e}^{3x}+2)}^{3}}{3}+C" :db/id #edb/ref 17592186248025} {:answer/id #uuid "4fa1568a-384f-58a8-924a-2a38ae937084" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{({e}^{3x}+2)}^{4}}{6}+C" :db/id #edb/ref 17592186248140} {:answer/id #uuid "577a0caf-bf7e-59b5-a4ca-f40167c4fa08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{({e}^{3x}+2)}^{3}}{6}+C" :db/id #edb/ref 17592186248218} {:answer/id #uuid "87d85e70-9986-5c51-90ba-53c36aea0512" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{({e}^{3x}+2)}^{4}}{3}+C" :db/id #edb/ref 17592186248638}] :answer-field/correct {:answer/id #uuid "4fa1568a-384f-58a8-924a-2a38ae937084" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{({e}^{3x}+2)}^{4}}{6}+C" :db/id #edb/ref 17592186248140} :answer-field/id #uuid "792f7b0f-b886-5c74-9417-ec3ce40c477b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249878}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2445485f-2474-5b96-9886-76e2b061635a" :question/math-academy-id "q-113852" :question/problem "Calculate the integral $\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={e}^{3x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{3x}\\,⟹\\,\\frac{2}{3}\\text{d}u=2{e}^{3x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\,\\text{d}x & =\\int {({e}^{3x}+2)}^{3}\\cdot 2{e}^{3x}\\,\\text{d}x \\\\  & =\\int {u}^{3}\\,\\frac{2}{3}\\text{d}u \\\\  & =\\frac{2}{3}\\int {u}^{3}\\,\\text{d}u \\\\  & =\\frac{2}{3}\\frac{{u}^{4}}{4}+C \\\\  & =\\frac{{({e}^{3x}+2)}^{4}}{6}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b970921c-d15d-53a0-b5c6-fc46e6dcab7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{3^{x} + 1}}{\\ln 3} + C" :db/id #edb/ref 17592186180890} {:answer/id #uuid "d778ab08-7f17-5d9d-8fac-d2f1898f19d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3^{x} + 1}}{6\\ln 3} + C" :db/id #edb/ref 17592186180891} {:answer/id #uuid "e134739a-8071-5865-951f-b5b40b3c8ea4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3^{x} + 1}}{3\\ln 3} + C" :db/id #edb/ref 17592186180892} {:answer/id #uuid "e6051283-eee8-5ca7-aef7-508bb9f721c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3^{x} + 1}}{\\ln 3} + C" :db/id #edb/ref 17592186180893} {:answer/id #uuid "53948032-e541-5f9a-a89d-710bf093f2e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3^{x} + 1}}{2\\ln 3} + C" :db/id #edb/ref 17592186180894}] :answer-field/id #uuid "ffc72a8c-7d71-520d-87f2-59d147ec95f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186180889}] :question/id #uuid "7818d7dd-cee4-50cd-9c8b-99419a2fa97a" :question/math-academy-id "q-113876" :question/problem "Calculate the integral $\\displaystyle \\int\\frac{3^{x + 1}}{\\sqrt{3^{x} + 1}}dx$."} {:db/id #edb/ref 17592186234356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b3ff8f-fef3-5d4b-8ac7-c7f0be3c20e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{2}^{z}-9}}{2}+C" :db/id #edb/ref 17592186339438} {:answer/id #uuid "36b29201-973e-54a1-9076-d11d6f4d33f1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{2}^{z}-9}+C" :db/id #edb/ref 17592186339618} {:answer/id #uuid "714604c9-2b37-531a-bb67-a0c67b2a5cb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186340134} {:answer/id #uuid "d56615b3-79b5-569f-a38a-6eae7ea1c379" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{2}^{z}-9}}{2\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186341017} {:answer/id #uuid "dcc1530c-4d98-5329-89c2-53ade6de9cab" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2\\sqrt{{2}^{z}-9}+C" :db/id #edb/ref 17592186341089}] :answer-field/correct {:answer/id #uuid "714604c9-2b37-531a-bb67-a0c67b2a5cb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}⁡2}+C" :db/id #edb/ref 17592186340134} :answer-field/id #uuid "9441441f-4088-5ff2-aa37-6b852eabed90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341641}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9aadcdf1-9134-541b-ab5d-b526e490dc48" :question/math-academy-id "q-73670" :question/problem "Calculate the integral $\\int \\frac{{2}^{z}}{\\sqrt{{2}^{z}-9}}\\,\\text{d}z.$" :question/worked-solution "Let's introduce the new variable $u={2}^{z}-9.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}z}={2}^{z}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{z}\\,\\text{d}z.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{2}^{z}}{\\sqrt{{2}^{z}-9}}\\,\\text{d}z & =\\int \\frac{1}{\\sqrt{{2}^{z}-9}}\\cdot {2}^{z}\\,\\text{d}z \\\\  & =\\int \\frac{1}{\\operatorname{ln}⁡2}\\cdot \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{1/2}}{(\\frac{1}{2})} \\\\  & =\\frac{2\\sqrt{{2}^{z}-9}}{\\operatorname{ln}⁡2}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d4c17e-b4e9-5c3d-8e37-585ca78e36f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C" :db/id #edb/ref 17592186247458} {:answer/id #uuid "5dbb5507-aaa0-5749-a41a-43f26c688149" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{4}+C" :db/id #edb/ref 17592186248276} {:answer/id #uuid "b5da3429-fa5a-5c1e-bc1f-55c28c97d965" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2{e}^{2x}}+C" :db/id #edb/ref 17592186249052} {:answer/id #uuid "b800b44e-6e5f-530d-a74e-e61c336c427d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C" :db/id #edb/ref 17592186249070} {:answer/id #uuid "c9a200ad-d245-5814-a41d-3e6f3d647290" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C" :db/id #edb/ref 17592186249218}] :answer-field/correct {:answer/id #uuid "c9a200ad-d245-5814-a41d-3e6f3d647290" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C" :db/id #edb/ref 17592186249218} :answer-field/id #uuid "1a658127-d29f-5d3c-9088-48b067088416" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249714}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e2191fab-edb1-5e72-a762-ef056bc648a3" :question/math-academy-id "q-113873" :question/problem "Calculate the integral$\\int \\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={e}^{2x}-2x.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2{e}^{2x}-2=2({e}^{2x}-1)\\,⟹\\,\\frac{1}{2}\\text{d}u=({e}^{2x}-1)\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}-2x}\\cdot ({e}^{2x}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "398d7153-dd3c-5a82-b5a4-cae2a584156a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5x}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295595} {:answer/id #uuid "4ca4abb9-0851-5c3b-9177-0dd90d8d8845" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295704} {:answer/id #uuid "7a287bc3-0892-5d93-8218-78604cf894d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295934} {:answer/id #uuid "7ef3b95e-bd1a-57ef-8fe5-5cd8afb14244" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{5}^{x}\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295954} {:answer/id #uuid "af23df45-3861-5a0d-ac36-df9c438d8eb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{5\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186296190}] :answer-field/correct {:answer/id #uuid "4ca4abb9-0851-5c3b-9177-0dd90d8d8845" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C" :db/id #edb/ref 17592186295704} :answer-field/id #uuid "04a5f69b-9de4-5df4-950b-038dd6a88814" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296647}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cb025f0b-ba4d-525b-a215-9bdb02362821" :question/math-academy-id "q-31478" :question/problem "Calculate the integral $\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={5}^{x}+1.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={5}^{x}\\operatorname{ln}⁡5\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u={5}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{5}^{x}}{{5}^{x}+1}\\,\\text{d}x & =\\int \\frac{1}{{5}^{x}+1}\\cdot {5}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡5}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}\\cdot \\operatorname{ln}⁡|{5}^{x}+1|+C \\\\  & =\\frac{\\operatorname{ln}⁡({5}^{x}+1)}{\\operatorname{ln}⁡5}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${5}^{x}+1>0$ for all $x.$"} {:db/id #edb/ref 17592186297411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07618f82-80dd-5c73-b8a4-2164bc070f03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x})}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295304} {:answer/id #uuid "7fabc313-b7ec-5fea-8e37-3c5a06d43177" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{4}^{x}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295957} {:answer/id #uuid "872590b5-df6d-5e6e-9dc4-79994e14eb92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{4\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186295994} {:answer/id #uuid "ac13f248-7d32-5d3e-b31a-bf1601844a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296173} {:answer/id #uuid "b29969af-ede3-53c4-a306-057c9ce68656" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296208}] :answer-field/correct {:answer/id #uuid "ac13f248-7d32-5d3e-b31a-bf1601844a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186296173} :answer-field/id #uuid "7f35bb0c-6a4b-5fe9-b22b-03be76e5104e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296892}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fa16c83a-9f14-57ce-8cd3-45bb3a59d16f" :question/math-academy-id "q-31480" :question/problem "Calculate the integral $\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={4}^{x}+2.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={4}^{x}\\operatorname{ln}⁡4\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u={4}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{4}^{x}}{{4}^{x}+2}\\,\\text{d}x & =\\int \\frac{1}{{4}^{x}+2}\\cdot {4}^{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{\\operatorname{ln}⁡4}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{\\operatorname{ln}⁡4}\\cdot \\operatorname{ln}⁡|{4}^{x}+2|+C \\\\  & =\\frac{\\operatorname{ln}⁡({4}^{x}+2)}{\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that ${4}^{x}+2>0$ for all $x.$"} {:db/id #edb/ref 17592186332748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027a07ce-3cfe-56e8-be37-2a1cb12f5c96" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{({e}^{x}+4)^{5}}+C" :db/id #edb/ref 17592186329985} {:answer/id #uuid "21d26b82-340b-5005-b15b-4c394deda50e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186330239} {:answer/id #uuid "34f46ff9-bbb8-5507-929a-8bf833e4a41a" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186330415} {:answer/id #uuid "b30e1c0f-e528-5e60-ac58-17f053cef19d" :answer/type {:db/ident :answer.type/math} :answer/value "10\\sqrt[3]{({e}^{x}+4)^{2}}+C" :db/id #edb/ref 17592186331531} {:answer/id #uuid "c31f2fe7-9fe8-531c-bb86-82e9bb1e9492" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186331685}] :answer-field/correct {:answer/id #uuid "c31f2fe7-9fe8-531c-bb86-82e9bb1e9492" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C" :db/id #edb/ref 17592186331685} :answer-field/id #uuid "18e0a5f1-7890-529c-b7ba-c46e029335b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332236}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2a94e796-17ea-59f0-8634-ea54546ad51c" :question/math-academy-id "q-49577" :question/problem "Calculate the integral $\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={e}^{x}+4.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,⟹\\,\\text{d}u={e}^{x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5{e}^{x}\\sqrt{{e}^{x}+4}\\,\\text{d}x & =5\\int \\sqrt{{e}^{x}+4}\\cdot {e}^{x}\\,\\text{d}x \\\\  & =5\\int \\sqrt{u}\\,\\text{d}u \\\\  & =5\\int {u}^{1/2}\\,\\text{d}u \\\\  & =5\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{10}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{10}{3}\\sqrt{({e}^{x}+4)^{3}}+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85fd39-fb12-5fd0-84ca-1f9410fd86c2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186339238} {:answer/id #uuid "35d01e19-8df6-5a98-9a4e-a13ff45e59c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186339607} {:answer/id #uuid "ba62682b-6375-50c8-ab0e-ae65ecff8935" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186340799} {:answer/id #uuid "f040dd33-55b8-577d-b65c-882719ad8257" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\operatorname{ln}⁡2}\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186341244} {:answer/id #uuid "fbec05e7-3328-5ebb-a6b8-92e98b6e67b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186341354}] :answer-field/correct {:answer/id #uuid "ba62682b-6375-50c8-ab0e-ae65ecff8935" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186340799} :answer-field/id #uuid "9475f005-9702-55df-8eb5-e3d9087d1fde" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341643}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4d8e2bdb-04c0-5bb8-8174-6e672a971ff9" :question/math-academy-id "q-73669" :question/problem "Calculate the integral $\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={2}^{x}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{x}\\,\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x & =\\int 2\\cdot {2}^{x}\\sqrt{{2}^{x}-5}\\,\\text{d}x \\\\  & =2\\int \\sqrt{{2}^{x}-5}\\cdot {2}^{x}\\,\\text{d}x \\\\  & =2\\int \\sqrt{u}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C.\\end{aligned}\n$$"}] :knowledge-point/title "More Complex Cases"}] [{:db/id #edb/ref 17592186184352 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183948 :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4(\\frac{15}{16}) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "114e3660-63d9-511d-b89c-e71081ffa1e5" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186184471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037f04c8-ba6f-5b6c-8fa9-0c6883765bb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186266175} {:answer/id #uuid "4d76620b-4c1e-5237-a48c-f056d6dc9063" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186266833} {:answer/id #uuid "5079f712-46dd-55b7-8b26-77e72f0df867" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186266859} {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} {:answer/id #uuid "57c0df91-f04f-5221-8066-bed8410acb39" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186266928}] :answer-field/correct {:answer/id #uuid "50f90dfe-d802-574a-8ed8-759b5057b926" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266869} :answer-field/id #uuid "db7fea76-3c9e-5620-891f-f29f43564753" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8b4cba33-ddfb-53fe-af87-4270187c1909" :question/math-academy-id "q-13751" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\operatorname{ln}⁡3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5x{e}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡3}}5{e}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡3} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡3}-{e}^{0}) \\\\  & =\\frac{5}{2}(3-1) \\\\  & =\\frac{5}{2}(2) \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184741 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5bf8a0-a538-5131-b32d-777d76c86e0c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3\\ln 2}" :db/id #edb/ref 17592186183061} {:answer/id #uuid "00154e8b-a47a-59a6-9e54-9aee8af6344c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6\\ln 2}" :db/id #edb/ref 17592186183062} {:answer/id #uuid "3185e3f8-9923-5b43-9df1-2a552956c3a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6\\ln 2}" :db/id #edb/ref 17592186183063} {:answer/id #uuid "42546591-d960-5ea6-822b-c544d4094b17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2\\ln 2}" :db/id #edb/ref 17592186183064} {:answer/id #uuid "79a4d23b-d2d8-5bbc-814e-532fcf20645f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8\\ln 2}" :db/id #edb/ref 17592186183065}] :answer-field/id #uuid "95360911-bf76-5292-82a2-81c244f28aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183060}] :question/id #uuid "3c1f6565-c9e4-53b3-bf2f-682503382e07" :question/math-academy-id "q-30977" :question/problem "Evaluate the integral $\\displaystyle \\int_{0}^{1}x2^{3x^{2}}dx$."} {:db/id #edb/ref 17592186297313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "819b16a3-f7a6-565b-b3ef-3936ba7715f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186295964} {:answer/id #uuid "887f9f69-8383-56d4-b68c-b8cfc625db4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186296002} {:answer/id #uuid "ccfd95ae-9589-58f8-99d6-dc27d8a4b715" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186296340} {:answer/id #uuid "d14bc0b9-fea2-545e-9860-0eceaf4fb7d1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296368} {:answer/id #uuid "f5ac6476-516e-5949-a1aa-b0dc8472989d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{20}" :db/id #edb/ref 17592186296571}] :answer-field/correct {:answer/id #uuid "887f9f69-8383-56d4-b68c-b8cfc625db4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186296002} :answer-field/id #uuid "87845b5e-5ef2-542f-81a3-6d45bf09aa5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296913}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d27a3338-cb0f-5ca8-99dd-ea66c994efb5" :question/math-academy-id "q-30953" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=2{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\operatorname{ln}⁡5$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}\\frac{1}{5}x{e}^{2{x}^{2}}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡5}}{e}^{2{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{20}{\\int }_{0}^{2\\operatorname{ln}⁡5}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{20}{e}^{u}\\,{|}_{0}^{2\\operatorname{ln}⁡5} \\\\  & =\\frac{1}{20}({e}^{2\\operatorname{ln}⁡5}-{e}^{0}) \\\\  & =\\frac{1}{20}(25-1) \\\\  & =\\frac{24}{20} \\\\  & =\\frac{6}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ccece4-65c4-5e5c-8817-3a18dce11af4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186295310} {:answer/id #uuid "84942b44-5495-5682-952a-911af4e4422c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186295978} {:answer/id #uuid "bfed6b15-aecc-5150-b7ae-098abfc895f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{4}" :db/id #edb/ref 17592186296281} {:answer/id #uuid "c1be6811-0f82-5ed6-a4cb-46cd3b3d2590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296291} {:answer/id #uuid "cebdb2d9-074e-514a-9533-ddadbb7aad7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296351}] :answer-field/correct {:answer/id #uuid "c1be6811-0f82-5ed6-a4cb-46cd3b3d2590" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186296291} :answer-field/id #uuid "f8639f62-79b8-5cc0-8a72-d453dd46c5a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297143}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7481f370-fa2c-5189-a8ea-31c09e902fb8" :question/math-academy-id "q-30978" :question/problem "Evaluate the integral ${\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}x{4}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{4}^{{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{4}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}{4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}\\,{|}_{0}^{1} \\\\  & =\\frac{1}{2\\operatorname{ln}⁡4}(4-1) \\\\  & =\\frac{3}{2\\operatorname{ln}⁡4} \\\\  & =\\frac{3}{4\\operatorname{ln}⁡2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd2ee4a-9bd2-5dd9-bf3f-33b0c730a0e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186317699}] :answer-field/correct {:answer/id #uuid "2bd2ee4a-9bd2-5dd9-bf3f-33b0c730a0e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186317699} :answer-field/id #uuid "4ab28277-8243-5753-94c4-46d003e744e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318588}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03065e0a-3e2d-519b-9716-a27401bbed9d" :question/math-academy-id "q-346400" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u={x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x\\cdot {3}^{{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{0}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{1}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(3-1) \\\\  & =\\frac{2}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a45e9d32-be80-51d7-b4d0-0082a4e9941a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186319882}] :answer-field/correct {:answer/id #uuid "a45e9d32-be80-51d7-b4d0-0082a4e9941a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186319882} :answer-field/id #uuid "e8bd78c3-38e4-5e76-9e6e-43ae4383b2eb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320645}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5669eaaa-dc6f-518c-94e2-a518478a7aa8" :question/math-academy-id "q-350740" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{x}^{2}+\\operatorname{ln}⁡2.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt{\\operatorname{ln}⁡2}$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡2$ | $4\\operatorname{ln}⁡2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡2}}x{e}^{3{x}^{2}+\\operatorname{ln}⁡2}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}{e}^{u}\\,{|}_{\\operatorname{ln}⁡2}^{4\\operatorname{ln}⁡2} \\\\  & =\\frac{1}{6}({e}^{4\\operatorname{ln}⁡2}-{e}^{\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{6}(16-2) \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f28b6429-4e66-5c8e-bb3f-5daf1daa32a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186320115}] :answer-field/correct {:answer/id #uuid "f28b6429-4e66-5c8e-bb3f-5daf1daa32a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{\\operatorname{ln}(3)}" :db/id #edb/ref 17592186320115} :answer-field/id #uuid "174ca392-0304-5d05-b095-f15caadd5198" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320215}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5411d5fe-3637-5792-875a-d180b054e392" :question/math-academy-id "q-350743" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=2x+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {3}^{2x+1}\\,\\text{d}x & ={\\int }_{1}^{3}{3}^{u}\\,\\text{d}u \\\\  & ={\\frac{{3}^{u}}{\\operatorname{ln}⁡(3)}\\,|}_{1}^{3} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}({3}^{3}-{3}^{1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}(27-3) \\\\  & =\\frac{24}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bae22f-c29c-57f9-8e20-c50243b1f0f5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}(\\frac{16}{7})" :db/id #edb/ref 17592186319463}] :answer-field/correct {:answer/id #uuid "18bae22f-c29c-57f9-8e20-c50243b1f0f5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}(\\frac{16}{7})" :db/id #edb/ref 17592186319463} :answer-field/id #uuid "2ea49404-1273-5753-90c5-6d44c92c292b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320273}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "951fb591-2a64-51d6-a9bd-1ec21eaafe23" :question/math-academy-id "q-350751" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's introduce the new variable $u=3{e}^{x}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{e}^{x}\\,⟹\\,\\text{d}u=3{e}^{x}\\,\\text{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $\\operatorname{ln}⁡2$ | $\\operatorname{ln}⁡5$ |\n| --- | --- | --- |\n| $u$ | $7$ | $16$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{12{e}^{x}}{3{e}^{x}+1}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\operatorname{ln}⁡5}\\frac{4}{3{e}^{x}+1}\\cdot 3{e}^{x}\\,\\text{d}x \\\\  & ={\\int }_{7}^{16}\\frac{4}{u}\\cdot \\,\\text{d}u \\\\  & =4{\\int }_{7}^{16}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡|u|\\,{|}_{7}^{16} \\\\  & =4(\\operatorname{ln}⁡(16)-\\operatorname{ln}⁡(7)) \\\\  & =4\\operatorname{ln}⁡(\\frac{16}{7}).\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating Definite Integrals"}]}
