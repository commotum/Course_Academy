#{[{:db/id #edb/ref 17592186068916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068568 :question/id #uuid "daf5cc74-4c7d-500a-9345-03bd6b73a333" :question/math-academy-id "e-465" :question/problem "Calculate the integral $\\displaystyle\\int 5 \\csc {\\left(6x+\\dfrac \\pi 3\\right)} \\cot {\\left(6x+\\dfrac \\pi 3\\right)} \\,  \\textrm{d}x.$" :question/worked-solution "If we let $u=6x+\\dfrac \\pi 3,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 6\\quad\\Longrightarrow\\quad \\textrm d x =\\dfrac 1 6\\, \\textrm d u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 5\\operatorname{csc}⁡(6x+\\frac{\\pi }{3})\\operatorname{cot}⁡(6x+\\frac{\\pi }{3})\\,\\text{d}x & =5\\int \\operatorname{csc}⁡(6x+\\frac{\\pi }{3})\\operatorname{cot}⁡(6x+\\frac{\\pi }{3})\\,\\text{d}x \\\\  & =5\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{5}{6}\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\frac{5}{6}\\operatorname{csc}⁡u+C \\\\  & =-\\frac{5}{6}\\operatorname{csc}⁡(6x+\\frac{\\pi }{3})+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "084eb4cc-2f84-5288-90a6-be84066922b6" :knowledge-point/questions [{:db/id #edb/ref 17592186069004 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00a40602-52d1-5dc9-8e31-c35464767acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186235799} {:answer/id #uuid "3eec2768-c2bf-5731-b512-c6df48d8bb5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186236217} {:answer/id #uuid "4e578f69-909a-523b-8577-e3cdb3de2088" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186236318} {:answer/id #uuid "d4240689-1a4e-5384-9ef2-fdfe11a2085d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186237156} {:answer/id #uuid "e779e3e4-8675-5338-a515-5145e18de6ae" :answer/type {:db/ident :answer.type/math} :answer/value "7\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186237271}] :answer-field/correct {:answer/id #uuid "00a40602-52d1-5dc9-8e31-c35464767acf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{sec}⁡(7x)+C" :db/id #edb/ref 17592186235799} :answer-field/id #uuid "ea812aef-b957-50aa-a86e-5bc828f0e956" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237741}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8ab6145f-e13a-585c-bc5c-d4f390fce17e" :question/math-academy-id "q-10143" :question/problem "Calculate the integral $\\int \\operatorname{sec}⁡(7x)\\operatorname{tan}⁡(7x)\\,\\text{d}x.$" :question/worked-solution "If we let $u=7x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=7\\,⟹\\,\\text{d}x=\\frac{1}{7}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\operatorname{sec}⁡(7x)\\operatorname{tan}⁡(7x)\\,\\text{d}x & =\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot \\frac{1}{7}\\,\\text{d}u \\\\  & =\\frac{1}{7}\\int \\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{7}\\operatorname{sec}⁡u+C \\\\  & =\\frac{1}{7}\\operatorname{sec}⁡(7x)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f85cf725-3237-5c2c-aa64-a45c7c2a4c32" :answer/type {:db/ident :answer.type/math} :answer/value "\\csc (8x) + C" :db/id #edb/ref 17592186065470} {:answer/id #uuid "f8a92f4d-c241-5c04-a633-0e1a6d38dbbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\csc (8x) + C" :db/id #edb/ref 17592186065471} {:answer/id #uuid "1639954a-f29a-5655-9185-4c5ede14b2a1" :answer/type {:db/ident :answer.type/math} :