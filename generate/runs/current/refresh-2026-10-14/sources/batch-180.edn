D) & ={D}^{2}-4I \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix}+\\begin{bmatrix}-4 & 0 \\\\ 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-4 & 0+0 \\\\ 0+0 & 4-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3d5317a-31f3-54aa-a6b5-786a8ff7f811" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293635}] :answer-field/correct {:answer/id #uuid "b3d5317a-31f3-54aa-a6b5-786a8ff7f811" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186293635} :answer-field/id #uuid "6eb78f3a-36e5-5305-b6cb-2c5f0c33edd8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294318} {:answer-field/choices [{:answer/id #uuid "5c3ea9f9-60ad-5fe7-85fe-6d4d7a58ffd0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293302}] :answer-field/correct {:answer/id #uuid "5c3ea9f9-60ad-5fe7-85fe-6d4d7a58ffd0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293302} :answer-field/id #uuid "878b519a-9848-5864-b294-4a97244a614d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294412} {:answer-field/choices [{:answer/id #uuid "80a53002-fac7-5fa3-b9bb-fc880c2ae565" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293450}] :answer-field/correct {:answer/id #uuid "80a53002-fac7-5fa3-b9bb-fc880c2ae565" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293450} :answer-field/id #uuid "e87a6e92-ea2b-5d15-8aeb-33ed594d4c37" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294749