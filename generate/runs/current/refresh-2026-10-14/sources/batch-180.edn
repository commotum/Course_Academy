x}3 & 5 \\\\ 1 & -2\\end{bmatrix}+5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & 5 \\\\ 1 & 9\\end{bmatrix}+\\begin{bmatrix}6 & 10 \\\\ 2 & -4\\end{bmatrix}+\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}14+6+5 & 5+10+0 \\\\ 1+2+0 & 9+(-4)+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}25 & 15 \\\\ 3 & 10\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1744d8fb-81b6-5395-81e3-a30d1cf22dca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 & -11 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186300056} {:answer/id #uuid "3abbca31-cd1a-55dc-ab78-8295ad3f83b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 12 \\\\ -11 & 17\\end{bmatrix}" :db/id #edb/ref 17592186300246} {:answer/id #uuid "4bc77c6a-3546-525e-8f13-32f2ba98a1e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}22 & -8 \\\\ -3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186300356} {:answer/id #uuid "97271f38-aaea-5cbb-9d12-854e247ffaa7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 & -12 \\\\ -2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186300724} {:answer/id #uuid "b62e6866-8fdc-5e97-9346-6542dc3d5717" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}14 & -15 \\\\ 1 & 5\\end{bmatrix}" :db/id #edb/ref 17592186300868}] :answer-field/correct {:answer/id #uuid "97271f38-aaea-5cbb-9d12-854e247ffaa7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}17 & -12 \\\\ -2 & 7\\end{bmatrix}" :db/id #edb/ref 17592186300724} :answer-field/id #uuid "e2bb789b-a485-529a-bddb-817de5ff3b84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301943}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "997c432b-610d-53fe-ad2b-73f9ef5c7989" :question/math-academy-id "q-32321" :question/problem "Consider the matrix $A=\\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix}.$ Find $f(A)$ if $f(X)={X}^{2}-3X+1.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-3X+1 \\\\  & ={X}^{2}-3X+I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}-3A+I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 6 \\\\ 1 & 15\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-3A+I \\\\  & =\\begin{bmatrix}10 & 6 \\\\ 1 & 15\\end{bmatrix}-3\\begin{bmatrix}-2 & 6 \\\\ 1 & 3\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 6 \\\\ 1 & 15\\end{bmatrix}-\\begin{bmatrix}-6 & 18 \\\\ 3 & 9\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}10-(-6)+1 & 6-18 \\\\ 1-3 & 15-9+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}17 & -12 \\\\ -2 & 7\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7432675c-1027-5aa0-a1ec-059ac0616064" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186346376} {:answer/id #uuid "a44fcd22-948d-5a46-913d-f4941f2b9707" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 2 & 5\\end{bmatrix}" :db/id #edb/ref 17592186346777} {:answer/id #uuid "c2458522-1cdc-52c3-91b1-a8e62a9005c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186347031} {:answer/id #uuid "d0b94a18-65cb-56a2-9e73-12873cfb72b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ -3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186347180} {:answer/id #uuid "da60de60-2f65-5642-8043-ea8744f9c6c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186347271}] :answer-field/correct {:answer/id #uuid "7432675c-1027-5aa0-a1ec-059ac0616064" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186346376} :answer-field/id #uuid "11494126-82fe-5418-bc4c-a3684108c3e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347638}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "87c2d592-961d-53db-a080-ae23863dbae1" :question/math-academy-id "q-78579" :question/problem "Consider the matrix $B=\\begin{bmatrix}1 & -1 \\\\ -3 & 2\\end{bmatrix}.$ Find $f(B)$ if $f(X)={X}^{2}-3X+4.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-3X+4 \\\\  & ={X}^{2}-3X+4I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}-3B+4I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}1 & -1 \\\\ -3 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 \\\\ -3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -3 \\\\ -9 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}-3B+4I \\\\  & =\\begin{bmatrix}4 & -3 \\\\ -9 & 7\\end{bmatrix}-3\\begin{bmatrix}1 & -1 \\\\ -3 & 2\\end{bmatrix}+4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -3 \\\\ -9 & 7\\end{bmatrix}-\\begin{bmatrix}3 & -3 \\\\ -9 & 6\\end{bmatrix}+\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-3+4 & -3-(-3)+0 \\\\ -9-(-9)+0 & 7-6+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e9e4cd6-8ebd-5aad-a231-c22d9b6757df" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186365531}] :answer-field/correct {:answer/id #uuid "6e9e4cd6-8ebd-5aad-a231-c22d9b6757df" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186365531} :answer-field/id #uuid "b78e6099-588e-57b5-84f3-60d1185cf6ef" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365530} {:answer-field/choices [{:answer/id #uuid "c5699f5b-052a-57b4-9646-8cd7406d269d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186365533}] :answer-field/correct {:answer/id #uuid "c5699f5b-052a-57b4-9646-8cd7406d269d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186365533} :answer-field/id #uuid "ad71da3b-ef92-568b-8d10-b85b7150c5f7" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365532} {:answer-field/choices [{:answer/id #uuid "262bede2-d975-509a-8ae6-ee2b6ca72736" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186365535}] :answer-field/correct {:answer/id #uuid "262bede2-d975-509a-8ae6-ee2b6ca72736" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186365535} :answer-field/id #uuid "a00d8d49-acfe-503b-90be-9a94167f11e6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365534} {:answer-field/choices [{:answer/id #uuid "03292ed6-0db9-5c48-bbc4-8be20e0639e9" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186365537}] :answer-field/correct {:answer/id #uuid "03292ed6-0db9-5c48-bbc4-8be20e0639e9" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186365537} :answer-field/id #uuid "29e201c0-3a1a-538d-9101-9fec659b4d05" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365536}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55b781aa-d29f-5fcc-876e-4fb67d5ab82b" :question/math-academy-id "q-279486" :question/problem "Consider the matrix $B=\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}.$ If $f(X)={X}^{2}+X-4$, find $f(B).$\n\n| $f(B)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X-4 \\\\  & ={X}^{2}+X-4I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}+B-4I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ -3 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}+B-4I \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ -3 & 7\\end{bmatrix}+\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}-4\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 6 \\\\ -3 & 7\\end{bmatrix}+\\begin{bmatrix}0 & 2 \\\\ -1 & 3\\end{bmatrix}-\\begin{bmatrix}4 & 0 \\\\ 0 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2+0-4 & 6+2-0 \\\\ -3+(-1)-0 & 7+3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 8 \\\\ -4 & 6\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186365538 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2de13f-7428-5cf4-a15d-bb759547b2ed" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186365540}] :answer-field/correct {:answer/id #uuid "2b2de13f-7428-5cf4-a15d-bb759547b2ed" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186365540} :answer-field/id #uuid "11f8211f-fddf-5d62-b133-32198e03aa6f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365539} {:answer-field/choices [{:answer/id #uuid "9ea4d763-c8fb-5f15-8550-82d38c91fb41" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365542}] :answer-field/correct {:answer/id #uuid "9ea4d763-c8fb-5f15-8550-82d38c91fb41" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365542} :answer-field/id #uuid "442f54fb-8ea0-51fb-bfe8-bce6dace459a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365541} {:answer-field/choices [{:answer/id #uuid "831af219-b629-59f3-aa0d-961a442fa561" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365544}] :answer-field/correct {:answer/id #uuid "831af219-b629-59f3-aa0d-961a442fa561" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186365544} :answer-field/id #uuid "ee738f6e-6149-5378-bb24-e7a5a743621a" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365543} {:answer-field/choices [{:answer/id #uuid "38720bc1-0b3f-5911-b14c-3283ea1fba26" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186365546}] :answer-field/correct {:answer/id #uuid "38720bc1-0b3f-5911-b14c-3283ea1fba26" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186365546} :answer-field/id #uuid "ab40a567-7f9c-536f-8745-37c134a38b77" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365545}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d4bdadfb-e233-53cf-93ab-2b717c37253a" :question/math-academy-id "q-279506" :question/problem "Consider the matrix $E=\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}.$ If $f(X)={X}^{2}+4X-5$, find $f(E).$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$f(E)=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n{{field-1}}\n</td>\n<td align=\"center\">\n{{field-2}}\n</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n{{field-3}}\n</td>\n<td align=\"center\" width=\"30px\">\n{{field-4}}\n</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+4X-5 \\\\  & ={X}^{2}+4X-5I\\end{aligned}\n$$\n\nSo, we want to find $f(E)={E}^{2}+4E-5I.$\n\nLet's calculate ${E}^{2}$ as follows:\n\n$$\n\\begin{aligned}{E}^{2} & =E\\cdot E \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 3 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(E):$\n\n$$\n\\begin{aligned}f(E) & ={E}^{2}+4E-5I \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 3 & 1\\end{bmatrix}+4\\begin{bmatrix}2 & 0 \\\\ 1 & 1\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 \\\\ 3 & 1\\end{bmatrix}+\\begin{bmatrix}8 & 0 \\\\ 4 & 4\\end{bmatrix}-\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4+8-5 & 0+0-0 \\\\ 3+4-0 & 1+4-5\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 0 \\\\ 7 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d7958c-94ba-5de3-9243-e30601f76543" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 \\\\ -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366304} {:answer/id #uuid "b10801ca-f13a-57ad-8038-3828133145ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366305} {:answer/id #uuid "e55ee6b6-6cbe-5ecc-a66b-628ac43bc811" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186366306} {:answer/id #uuid "1a296f4e-0f9b-50c7-9b4e-bd01d0b60375" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 \\\\ -4 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366307} {:answer/id #uuid "eba229a2-1a77-552c-9266-524a1d9a221b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ -4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366308}] :answer-field/correct {:answer/id #uuid "eba229a2-1a77-552c-9266-524a1d9a221b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ -4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366308} :answer-field/id #uuid "de3f2328-fa8d-5da1-9c29-ab9566101429" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366303}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2869021c-9120-59a9-9952-6f0d251d0602" :question/math-academy-id "q-78347" :question/problem "Consider the matrix $B=\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}.$  Find $f(B)$ if $f(X)={X}^{2}+X+3.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X+3 \\\\  & ={X}^{2}+X+3I\\end{aligned}\n$$\n\nSo, we want to find $f(B)={B}^{2}+B+3I.$\n\nLet's calculate ${B}^{2}$ as follows:\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(B):$\n\n$$\n\\begin{aligned}f(B) & ={B}^{2}+B+3I \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}+\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}+3\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}+\\begin{bmatrix}2 & 1 \\\\ -4 & -2\\end{bmatrix}+\\begin{bmatrix}3 & 0 \\\\ 0 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0+2+3 & 0+1+0 \\\\ 0+(-4)+0 & 0+(-2)+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 1 \\\\ -4 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afe8d6d8-0a6d-5efd-a9c0-c468f00d3f21" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 5 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366311} {:answer/id #uuid "d25a56e7-16c2-5f88-992b-3343761aa97c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & 5 \\\\ -5 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366312} {:answer/id #uuid "e3f3e7d5-a5eb-5b88-94d1-ab28c0dfcffd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & 5 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366313} {:answer/id #uuid "8d63f40b-f2ea-5001-ae5e-ff191217dc44" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & -5 \\\\ 5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186366314} {:answer/id #uuid "eb627ab1-f604-5f7b-aa59-eecf1c4e4f64" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 9 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366315}] :answer-field/correct {:answer/id #uuid "e3f3e7d5-a5eb-5b88-94d1-ab28c0dfcffd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}29 & 5 \\\\ -15 & -1\\end{bmatrix}" :db/id #edb/ref 17592186366313} :answer-field/id #uuid "176f723a-0a36-5ca0-a32a-8d6d6c5acf73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366310}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2a14c0ed-8414-58e1-8b26-a5335ab66e8a" :question/math-academy-id "q-78584" :question/problem "Consider the matrix $H=\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}.$  Find $f(H)$ if $f(X)={X}^{2}+X+2.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X+2 \\\\  & ={X}^{2}+X+2I\\end{aligned}\n$$\n\nSo, we want to find $f(H)={H}^{2}+H+2I.$\n\nLet's calculate ${H}^{2}$ as follows:\n\n$$\n\\begin{aligned}{H}^{2} & =H\\cdot H \\\\  & =\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}22 & 4 \\\\ -12 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(H):$\n\n$$\n\\begin{aligned}f(H) & ={H}^{2}+H+2I \\\\  & =\\begin{bmatrix}22 & 4 \\\\ -12 & -2\\end{bmatrix}+\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}+2\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}22 & 4 \\\\ -12 & -2\\end{bmatrix}+\\begin{bmatrix}5 & 1 \\\\ -3 & -1\\end{bmatrix}+\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}22+5+2 & 4+1+0 \\\\ -12-3+0 & -2-1+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}29 & 5 \\\\ -15 & -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388132 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67b616c2-ce6e-5c95-8648-dd89dbfaa3f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 6 \\\\ 6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186388134} {:answer/id #uuid "ca63b17e-8661-5864-bf17-dbc1f35dc340" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 6 \\\\ 9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388135} {:answer/id #uuid "5cae900f-3b80-52ed-97df-eae2af51f956" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -6 \\\\ 9 & -6\\end{bmatrix}" :db/id #edb/ref 17592186388136} {:answer/id #uuid "8a887fa4-9ae0-5c2c-ac17-c0d680bda859" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -3 \\\\ 9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388137} {:answer/id #uuid "de5ea921-ae36-5369-bf56-d02193f5bc68" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 6 \\\\ -6 & 9\\end{bmatrix}" :db/id #edb/ref 17592186388138}] :answer-field/correct {:answer/id #uuid "ca63b17e-8661-5864-bf17-dbc1f35dc340" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 6 \\\\ 9 & 6\\end{bmatrix}" :db/id #edb/ref 17592186388135} :answer-field/id #uuid "889964a6-0e86-53e7-a015-8ff79199c498" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388133}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "01490c7d-4c84-5d6b-914b-a1fab67bc26a" :question/math-academy-id "q-130681" :question/problem "Consider the matrix $A=\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}.$  Find $f(A)$ if $f(X)={X}^{2}-2X-8.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-2X-8 \\\\  & ={X}^{2}-2X-8I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}-2A-8I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 10 \\\\ 15 & 22\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}-2A-8I \\\\  & =\\begin{bmatrix}7 & 10 \\\\ 15 & 22\\end{bmatrix}-2\\begin{bmatrix}1 & 2 \\\\ 3 & 4\\end{bmatrix}-8\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 10 \\\\ 15 & 22\\end{bmatrix}+\\begin{bmatrix}-2 & -4 \\\\ -6 & -8\\end{bmatrix}+\\begin{bmatrix}-8 & 0 \\\\ 0 & -8\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-2-8 & 10-4+0 \\\\ 15-6+0 & 22-8-8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 6 \\\\ 9 & 6\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c29b720-4600-5452-856a-0de6c5b2cbbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 2 \\\\ -1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186388141} {:answer/id #uuid "d78e56c2-19a5-58bf-aac5-d59f602172e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186388142} {:answer/id #uuid "b2514912-db4d-511d-a89d-093ae0777083" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ -1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186388143} {:answer/id #uuid "d3f1a29c-c2ff-5901-b277-ceaff0eb220f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 2 \\\\ -1 & -6\\end{bmatrix}" :db/id #edb/ref 17592186388144} {:answer/id #uuid "adc7ac7b-e40f-5c06-9fee-5b824b5729d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388145}] :answer-field/correct {:answer/id #uuid "adc7ac7b-e40f-5c06-9fee-5b824b5729d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388145} :answer-field/id #uuid "5decefa1-878b-5a33-98d2-b1ec4d4f6078" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388140}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6097bb1d-9d7a-56b4-9d4d-09d460a9e165" :question/math-academy-id "q-130687" :question/problem "Consider the matrix $C=\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}.$ Find $f(C)$ if $f(X)={X}^{2}-X+5.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-X+5 \\\\  & ={X}^{2}-X+5I\\end{aligned}\n$$\n\nSo, we want to find $f(C)={C}^{2}-C+5I.$\n\nLet's calculate ${C}^{2}$ as follows:\n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 2 \\\\ -1 & -1\\end{bmatrix} \\\\  & =C\\end{aligned}\n$$\n\nNow, we can evaluate $f(C):$\n\n$$\n\\begin{aligned}f(C) & ={C}^{2}-C+5I \\\\  & =C-C+5I \\\\  & =5I \\\\  & =5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388146 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d46de3-1964-521e-987f-3f87e63d14f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 0 & 7\\end{bmatrix}" :db/id #edb/ref 17592186388148} {:answer/id #uuid "290eb367-b69e-51e9-b010-dd7d2e86e6ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388149} {:answer/id #uuid "8ec94462-c5a9-5b19-af43-e4fb15a1b17d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}" :db/id #edb/ref 17592186388150} {:answer/id #uuid "def69761-fa9a-5675-91a9-81ca5a36b65a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}" :db/id #edb/ref 17592186388151} {:answer/id #uuid "cdeec92a-fd20-575e-a12b-6d715aa8a4a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 4 \\\\ 12 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388152}] :answer-field/correct {:answer/id #uuid "290eb367-b69e-51e9-b010-dd7d2e86e6ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186388149} :answer-field/id #uuid "56b6390d-ed7e-571e-81e8-62f931b08ef6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388147}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "22954632-a7ef-5551-8cda-37dd0def8e71" :question/math-academy-id "q-130688" :question/problem "Consider the matrix $K=\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}.$ Find $f(K)$ if $f(X)={X}^{2}-4X+1.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-4X+1 \\\\  & ={X}^{2}-4X+I\\end{aligned}\n$$\n\nSo, we want to find $f(K)={K}^{2}-4K+I.$\n\nLet's calculate ${K}^{2}$ as follows:\n\n$$\n\\begin{aligned}{K}^{2} & =K\\cdot K \\\\  & =\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(K):$\n\n$$\n\\begin{aligned}f(K) & ={K}^{2}-4K+I \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}-4\\begin{bmatrix}2 & 1 \\\\ 3 & 2\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 4 \\\\ 12 & 7\\end{bmatrix}-\\begin{bmatrix}8 & 4 \\\\ 12 & 8\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}7-8+1 & 4-4-0 \\\\ 12-12+0 & 7-8+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22af9faf-479c-5211-b924-d2a2ed0ab1ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 6 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186485823} {:answer/id #uuid "4a573fe0-ecf3-566c-990e-bc2091d59ff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 8 & 2\\end{bmatrix}" :db/id #edb/ref 17592186485900} {:answer/id #uuid "c787cd72-628c-5183-a122-bb1328cc72f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 2 & 8\\end{bmatrix}" :db/id #edb/ref 17592186486126} {:answer/id #uuid "dd037009-e252-5c9b-a802-118a15252803" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 2 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186486169} {:answer/id #uuid "f294d9c4-87c6-5c05-8909-273b2ed447a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 8 \\\\ 2 & 6\\end{bmatrix}" :db/id #edb/ref 17592186486206}] :answer-field/correct {:answer/id #uuid "c787cd72-628c-5183-a122-bb1328cc72f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 2 & 8\\end{bmatrix}" :db/id #edb/ref 17592186486126} :answer-field/id #uuid "1c461903-1b4b-5b26-ad15-a19492090b76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486248}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2224e8b1-e5b3-5120-9cd4-8c63afa14c71" :question/math-academy-id "q-78583" :question/problem "Consider the matrix $D=\\begin{bmatrix}1 & -3 \\\\ -1 & 0\\end{bmatrix}.$  Find $f(D)$ if $f(X)={X}^{2}-3X+5.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}-3X+5 \\\\  & ={X}^{2}-3X+5I\\end{aligned}\n$$\n\nSo, we want to find $f(D)={D}^{2}-3D+5I.$\n\nLet's calculate ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =\\begin{bmatrix}1 & -3 \\\\ -1 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -3 \\\\ -1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -3 \\\\ -1 & 3\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(D):$\n\n$$\n\\begin{aligned}f(D) & ={D}^{2}-3D+5I \\\\  & =\\begin{bmatrix}4 & -3 \\\\ -1 & 3\\end{bmatrix}-3\\begin{bmatrix}1 & -3 \\\\ -1 & 0\\end{bmatrix}+5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -3 \\\\ -1 & 3\\end{bmatrix}+\\begin{bmatrix}-3 & 9 \\\\ 3 & 0\\end{bmatrix}+\\begin{bmatrix}5 & 0 \\\\ 0 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4-3+5 & -3+9+0 \\\\ -1+3+0 & 3+0+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 6 \\\\ 2 & 8\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25168437-2aa4-5977-952c-2051730ceff6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 4 \\\\ -2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186485826} {:answer/id #uuid "5b213e2b-cc6d-508a-a15f-3bf22cc91d0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186485924} {:answer/id #uuid "8b991cf9-c833-51b6-a70c-6462ead85a65" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 3 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186486013} {:answer/id #uuid "caf9fadd-4204-560a-bbdd-f5a3d57450f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & 1 \\\\ 20 & 5\\end{bmatrix}" :db/id #edb/ref 17592186486132} {:answer/id #uuid "e0dd670b-075f-5794-a254-3720ba484dbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}11 & 1 \\\\ 20 & 5\\end{bmatrix}" :db/id #edb/ref 17592186486176}] :answer-field/correct {:answer/id #uuid "5b213e2b-cc6d-508a-a15f-3bf22cc91d0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}" :db/id #edb/ref 17592186485924} :answer-field/id #uuid "ab274d63-ed23-5349-8036-9b61afae1797" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486307}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ebea1a9b-d1dc-56a2-8933-0092e4727688" :question/math-academy-id "q-130673" :question/problem "Consider the matrix $A=\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}.$  Find $f(A)$ if $f(X)={X}^{2}+X-1.$" :question/worked-solution "First, we rewrite the polynomial, interpreting any constants as multiples of the identity matrix:\n\n$$\n\\begin{aligned}f(X) & ={X}^{2}+X-1 \\\\  & ={X}^{2}+X-I\\end{aligned}\n$$\n\nSo, we want to find $f(A)={A}^{2}+A-I.$\n\nLet's calculate ${A}^{2}$ as follows:\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we can evaluate $f(A):$\n\n$$\n\\begin{aligned}f(A) & ={A}^{2}+A-I \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}-\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}+\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}+\\begin{bmatrix}-1 & 0 \\\\ 0 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+3-1 & 0-2+0 \\\\ 0+4+0 & 1-3-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -2 \\\\ 4 & -3\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating a Matrix Polynomial"}] [{:db/id #edb/ref 17592186161979 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161771 :question/id #uuid "c68d70a2-e4f8-5f08-8220-3df420a1e199" :question/math-academy-id "e-8156" :question/problem "Which of the following matrices are symmetric?\n\n![](images/fb/fb428c39bbc03be798bca2463658676de5c684396001cf547e9395352f456bc9.svg)" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA = A^T\n$$\n\nEquivalently, $a_{ij} = a_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P=P^T.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q=Q^T.$\n\n- $R$ is *not* a symmetric matrix. Since $r_{12} \\neq r_{21},$ we obtain $R \\neq R^T.$\n![](images/3f/3f91ec40e717eac93bb38f9c13f7b1700e84ac109ccceaffbb8473ba8d6b4e34.svg)\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""} :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050727 :topic/math-academy-id 232 :topic/title "The Transpose of a Matrix"}] :knowledge-point/questions [{:db/id #edb/ref 17592186162586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08e8db0d-99fb-5ea7-9318-4ca99d58e090" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186354745} {:answer/id #uuid "08fcbe18-d45e-5004-92c0-3a6422d2d1cd" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186354747} {:answer/id #uuid "828f3975-2835-5574-9c59-f895cdfa0945" :answer/type {:db/ident :answer.type/text} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186355811} {:answer/id #uuid "82d2f3a8-d1ef-544d-accc-41592fb63fef" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186355815} {:answer/id #uuid "a7339d78-1022-501f-b997-37e63b3a3c52" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186356144}] :answer-field/correct {:answer/id #uuid "08fcbe18-d45e-5004-92c0-3a6422d2d1cd" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186354747} :answer-field/id #uuid "66133d70-b9fb-5d32-b845-e980e242563c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357093}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd69c0a4-182b-55d3-9077-6d410397ebbd" :question/math-academy-id "q-93583" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}-5 & 3 \\\\ 3 & 0\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & -2 & -1 \\\\ -2 & 1 & 1 \\\\ 1 & -1 & 9\\end{bmatrix},\\,R=\\begin{bmatrix}0 & 3 \\\\ 0 & 0\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{13}\\ne {q}_{31},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=\\begin{bmatrix}1 & -2 & -1 \\\\ -2 & 1 & 1 \\\\ 1 & -1 & 9\\end{bmatrix}\n$$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}0 & 3 \\\\ 0 & 0\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"$P$ only.\""} {:db/id #edb/ref 17592186162613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ba5482-5def-5eb1-8afb-b35147f01cb8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460395} {:answer/id #uuid "c2b55bdd-c3cc-58fc-a9bf-8d537f751a4b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460396}] :answer-field/correct {:answer/id #uuid "c2b55bdd-c3cc-58fc-a9bf-8d537f751a4b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460396} :answer-field/id #uuid "e5900cb9-3c0a-5858-84ac-a5057863b2eb" :answer-field/key "P" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461064} {:answer-field/choices [{:answer/id #uuid "426fd1ef-0fc7-5598-a5b3-9ce88b4d09c6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460397} {:answer/id #uuid "72b04334-21e6-5b43-a89a-7fc2f082bcfd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460398}] :answer-field/correct {:answer/id #uuid "426fd1ef-0fc7-5598-a5b3-9ce88b4d09c6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460397} :answer-field/id #uuid "62aa287c-82c9-5b53-bffa-feef2459476d" :answer-field/key "Q" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461065} {:answer-field/choices [{:answer/id #uuid "bc940bfb-2218-5131-b425-d004e50900ed" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460399} {:answer/id #uuid "97f47d98-81cc-56ed-ad89-84f36eb470e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460400}] :answer-field/correct {:answer/id #uuid "97f47d98-81cc-56ed-ad89-84f36eb470e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460400} :answer-field/id #uuid "00e781ce-f91c-5253-aa0a-4f69bb5ac8d2" :answer-field/key "R" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186461066}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4f59c753-3356-5eb7-a27a-598f27f0d76a" :question/math-academy-id "q-93994" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}2 & 0 & 1 \\\\ 0 & -3 & -2 \\\\ 1 & -2 & 1\\end{bmatrix},\\,Q=\\begin{bmatrix}-1 & 4 \\\\ 3 & -1\\end{bmatrix},\\,R=\\begin{bmatrix}5 & 8 \\\\ 8 & -5\\end{bmatrix}\n$$\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{12}\\ne {q}_{21},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=\\begin{bmatrix}-1 & 4 \\\\ 3 & -1\\end{bmatrix}\n$$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""} {:db/id #edb/ref 17592186272114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12857ff7-7f34-53f2-92a8-fc5552e5223d" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186269431} {:answer/id #uuid "18c99cf2-a2ea-5550-8e35-29afed4e9f0c" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186269476} {:answer/id #uuid "555c78b8-9307-5a0d-84c0-e46552fd5cce" :answer/type {:db/ident :answer.type/text} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186270027} {:answer/id #uuid "c3d9d61f-bacc-5381-9864-7b41873c8c5d" :answer/type {:db/ident :answer.type/text} :answer/value "$P,$ $Q,$ and $R$" :db/id #edb/ref 17592186270998} {:answer/id #uuid "c47e9ae5-65c0-542a-acd0-bd7144abd9f9" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186271004}] :answer-field/correct {:answer/id #uuid "c3d9d61f-bacc-5381-9864-7b41873c8c5d" :answer/type {:db/ident :answer.type/text} :answer/value "$P,$ $Q,$ and $R$" :db/id #edb/ref 17592186270998} :answer-field/id #uuid "b7ed00bf-fcba-544c-8d6c-e3b5291f4354" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271844}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "180f854f-d44c-5145-855a-5e70b4193e38" :question/math-academy-id "q-140504" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}1 & -1 \\\\ -1 & 1\\end{bmatrix},\\,Q=\\begin{bmatrix}0 & \\sqrt{3} \\\\ \\sqrt{3} & 0\\end{bmatrix},\\,R=\\begin{bmatrix}-3 & 1 & 3 \\\\ 1 & 2 & -4 \\\\ 3 & -4 & 1\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$P,$ $Q,$ and $R.$\""} {:db/id #edb/ref 17592186275133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa67ce65-42d8-53e7-8c99-76f56fc9bcce" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186273859} {:answer/id #uuid "bd3ce2af-19e4-5fa6-bb1c-90f4bceacb0f" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186274024} {:answer/id #uuid "e3c641db-c970-54c3-9db3-c50ea1207234" :answer/type {:db/ident :answer.type/text} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186274401} {:answer/id #uuid "e7aa91c1-4798-5ba0-80a6-7ee8a99088ac" :answer/type {:db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186274435} {:answer/id #uuid "efe3bafc-8625-52ac-b13b-f6e88685587e" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186274510}] :answer-field/correct {:answer/id #uuid "e3c641db-c970-54c3-9db3-c50ea1207234" :answer/type {:db/ident :answer.type/text} :answer/value "None of the matrices are symmetric" :db/id #edb/ref 17592186274401} :answer-field/id #uuid "ba0e3b07-f917-5e4e-bc53-42a8b1e9f4f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274958}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "550ab27b-8963-569e-bb9e-df189c98b4f3" :question/math-academy-id "q-143679" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 0 & -1 \\\\ -1 & 2 & 0\\end{bmatrix},\\,Q=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 0 & \\sqrt{2} \\\\ 1 & 2 & -1\\end{bmatrix},\\,R=\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{13}\\ne {p}_{31},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=\\begin{bmatrix}0 & 1 & 2 \\\\ 1 & 0 & -1 \\\\ -1 & 2 & 0\\end{bmatrix}\n$$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{13}\\ne {q}_{31},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=\\begin{bmatrix}1 & 0 & -1 \\\\ 0 & 0 & \\sqrt{2} \\\\ 1 & 2 & -1\\end{bmatrix}\n$$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{bmatrix}\n$$\n\nTherefore, the correct answer is \"None of the matrices are symmetric.\""} {:db/id #edb/ref 17592186275134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "691d2386-08e0-5e84-8528-ca09e15fee56" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464300} {:answer/id #uuid "40fc8e5d-a7c6-5dee-ad15-ced14c3143c8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464301}] :answer-field/correct {:answer/id #uuid "40fc8e5d-a7c6-5dee-ad15-ced14c3143c8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464301} :answer-field/id #uuid "fe6f4042-36ad-5790-9b6a-ec08b4a4e1de" :answer-field/key "P" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465084} {:answer-field/choices [{:answer/id #uuid "a166b78e-fbfa-54cb-b123-2bd64adb1d28" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464302} {:answer/id #uuid "aaf7898e-f1aa-583f-936b-db61e1a09fba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464303}] :answer-field/correct {:answer/id #uuid "aaf7898e-f1aa-583f-936b-db61e1a09fba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/