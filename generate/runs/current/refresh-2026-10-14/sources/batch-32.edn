/math} :answer/value "20(4x+6)^{4}" :db/id #edb/ref 17592186493335} :answer-field/id #uuid "74945d2f-3779-5856-8f0b-b1fe26940f82" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493329}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8c698fb8-2f47-52aa-ab20-d02b17699d11" :question/problem "Given that $f(x)={(4x+6)}^{5},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=4x+6$ and $f(g(x))=g(x{)}^{5}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{5}{)}^{′}=5{g}^{4}, \\\\ {g}^{′}(x) & =(4x+6{)}^{′}=4.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =5{g}^{4}\\cdot (4) \\\\  & =20(4x+6{)}^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6b327a-95b5-56cb-b8b1-80852501eb0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2\\sqrt{5x-3}}" :db/id #edb/ref 17592186493327}] :answer-field/correct {:answer/id #uuid "1e6b327a-95b5-56cb-b8b1-80852501eb0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2\\sqrt{5x-3}}" :db/id #edb/ref 17592186493327} :answer-field/id #uuid "6a534b2c-8471-58d8-901e-8ca326167938" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493328}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "97e8ab80-425a-5ce3-aeca-1b6c32080f6d" :question/problem "Given that $f(x)=\\sqrt{5x-3},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Let $g(x)=5x-3$ and $f(g(x))=\\sqrt{g(x)}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & ={(\\sqrt{g})}^{′}=\\frac{1}{2\\sqrt{g}}, \\\\ {g}^{′}(x) & =(5x-3)^{′}=5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =\\frac{1}{2\\sqrt{g}}\\cdot 5 \\\\  & =\\frac{5}{2\\sqrt{5x-3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df5e2ea6-5eec-545e-bf02-640b9eb005aa" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{4}-28{x}^{3}" :db/id #edb/ref 17592186493334}] :answer-field/correct {:answer/id #uuid "df5e2ea6-5eec-545e-bf02-640b9eb005aa" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{4}-28{x}^{3}" :db/id #edb/ref 17592186493334} :answer-field/id #uuid "a9beb5af-bf72-501b-8c38-28d625a4d182" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493333}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a645231c-c79c-561b-9b41-b96c53332e19" :question/problem "Given that $f(x)={({x}^{5}-7{x}^{4})}^{2},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2({x}^{5}-7{x}^{4})($\n{{field-1}}\n$)$" :question/worked-solution "Let $g(x)={x}^{5}-7{x}^{4}$ and $f(g(x))=g(x)^{2}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{2})^{′}=2g, \\\\ {g}^{′}(x) & =({x}^{5}-7{x}^{4})^{′}=5{x}^{4}-28{x}^{3}.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =2g\\cdot (5{x}^{4}-28{x}^{3}) \\\\  & =2({x}^{5}-7{x}^{4})(\\,5{x}^{4}-28{x}^{3}\\,).\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}]}
