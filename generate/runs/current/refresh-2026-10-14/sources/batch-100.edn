ext{d}x}{x} \\\\  & =\\int \\frac{3}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡3\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =3\\operatorname{ln}⁡3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a00bd77-f937-55b8-9148-a5c1a2df5750" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{3}⁡x}{2}+C" :db/id #edb/ref 17592186295597} {:answer/id #uuid "4a0e44e3-51df-57b7-9de3-73290c5703d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}⁡x}{2}+C" :db/id #edb/ref 17592186295690} {:answer/id #uuid "8b673669-26b9-55f4-aeb7-78ad83c0d37c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296009} {:answer/id #uuid "c1b0c7ae-0328-590a-8a7c-83c5e5868a50" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296290} {:answer/id #uuid "e1684df1-979f-5851-a0c3-4dbc8f47887a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{5}^{2}⁡x}{x}+C" :db/id #edb/ref 17592186296466}] :answer-field/correct {:answer/id #uuid "c1b0c7ae-0328-590a-8a7c-83c5e5868a50" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296290} :answer-field/id #uuid "d0f353b4-b1a0-534f-8162-8c7bfcdf5cc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297068}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b0501bb6-8d0d-5290-9b3d-4f26ccd12ac3" :question/math-academy-id "q-31394" :question/problem "$\\int \\frac{{log}_{5}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{5}⁡x}{x}\\,\\text{d}x & =\\int {log}_{5}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡5\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡5\\cdot \\frac{{log}_{5}^{2}⁡x}{2}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032db269-5170-5f9b-a293-a64c6b8de5f3" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{3}⁡x+C" :db/id #edb/ref 17592186295278} {:answer/id #uuid "8c57cbd1-d8ae-5cb5-96bf-565f2293425f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186296015} {:answer/id #uuid "a011a8fa-a5ba-5019-8866-0b7377968785" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186296116} {:answer/id #uuid "d6f2aee1-0c4b-5cfd-93d1-18aaa3aae927" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186296399} {:answer/id #uuid "dacc49c0-7e50-5c30-97a5-a53696b8ec4a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3x}+C" :db/id #edb/ref 17592186296422}] :answer-field/correct {:answer/id #uuid "a011a8fa-a5ba-5019-8866-0b7377968785" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186296116} :answer-field/id #uuid "58373ceb-68ef-5d2e-ad2f-6c3319d69691" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296812}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "46a1f16d-d0cd-5aab-85fe-3d2691d325ef" :question/math-academy-id "q-31397" :question/problem "$\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{3}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bdf01e2-d959-5d74-8b6f-e69d4a474616" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡x\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C" :db/id #edb/ref 17592186295521} {:answer/id #uuid "455fefdc-f2d0-5c81-8eb5-1798b1ae907b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186295661} {:answer/id #uuid "49e87fa3-26bd-5446-af1f-f1898bd93c7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(5)}{5}\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C" :db/id #edb/ref 17592186295688} {:answer/id #uuid "6f2f8f3e-a15c-51d9-8314-704645beda07" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186295880} {:answer/id #uuid "d510a940-8c9e-5a4f-9e72-4e2553f2cdf5" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186296388}] :answer-field/correct {:answer/id #uuid "d510a940-8c9e-5a4f-9e72-4e2553f2cdf5" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186296388} :answer-field/id #uuid "49ec13b3-2234-5cd3-af27-ef024afdf609" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296773}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a480eb68-e1fa-542d-9387-098493118819" :question/math-academy-id "q-31399" :question/problem "$\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3\\int \\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "247f5c61-8dea-5c72-9001-ec5d7b70591c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295467} {:answer/id #uuid "4b9ec191-f4bb-5c86-8e6c-08aee654144a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295697} {:answer/id #uuid "8c832d15-3e5e-5c99-9339-9f4b3d100902" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296017} {:answer/id #uuid "8f4de440-cd8e-5ea6-9b03-b62c0fe90378" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296031} {:answer/id #uuid "d47dd115-efcf-5c72-a9de-08221fb2d4e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296387}] :answer-field/correct {:answer/id #uuid "4b9ec191-f4bb-5c86-8e6c-08aee654144a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295697} :answer-field/id #uuid "34099187-cafa-5bea-a9c2-38e91ea94b1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296730}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "baa80704-3dfa-5ff9-bf20-e404177dc892" :question/math-academy-id "q-31400" :question/problem "$\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cf2f12-d9f3-59fd-be22-70990f0c064c" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186295477} {:answer/id #uuid "32474011-c0eb-5c98-b028-863b8f17da19" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186295550} {:answer/id #uuid "8b40389e-34eb-5524-b04f-3adc8016457b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296008} {:answer/id #uuid "a5006fea-9435-5ebd-a15e-7ec4fb282356" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296137} {:answer/id #uuid "e0893163-fbac-5102-8d54-6ed75f43ac2c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296461}] :answer-field/correct {:answer/id #uuid "e0893163-fbac-5102-8d54-6ed75f43ac2c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186296461} :answer-field/id #uuid "c59c5853-4a44-56f0-94bb-09e77fa03053" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297042}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f906b7ab-49ff-57e2-8ffb-323870b5ae05" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374607 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e801e34a-0125-5366-bfbe-7c5392f185fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {log}_{4}⁡x+C" :db/id #edb/ref 17592186374609} {:answer/id #uuid "62971e29-5a80-538d-9637-1c44a46cb3f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{4}⁡x}{2}+C" :db/id #edb/ref 17592186374610} {:answer/id #uuid "f1b2cf9d-77a0-5a78-af8e-45f3fc5b07a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot \\frac{{log}_{4}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186374611} {:answer/id #uuid "0cd16dac-0e0f-5456-b5cc-6f633c746a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {log}_{4}^{2}⁡x+C" :db/id #edb/ref 17592186374612} {:answer/id #uuid "85ac5157-29fb-5860-accd-7d93b3916a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot {log}_{4}^{2}⁡x+C" :db/id #edb/ref 17592186374613}] :answer-field/correct {:answer/id #uuid "85ac5157-29fb-5860-accd-7d93b3916a42" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\cdot {log}_{4}^{2}⁡x+C" :db/id #edb/ref 17592186374613} :answer-field/id #uuid "ebe67bfb-124a-593d-83ad-61599d1d4bef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374608}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "102ce1ec-ef07-53e3-afee-6e16414152b1" :question/math-academy-id "q-31395" :question/problem "$\\int \\frac{2{log}_{4}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2{log}_{4}⁡x}{x}\\,\\text{d}x & =2\\int {log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4\\int u\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡4\\cdot {u}^{2}+C \\\\  & =\\operatorname{ln}⁡4\\cdot {log}_{4}^{2}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186384656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "126fc08e-95cb-5306-9924-3f019148d8ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{log}_{5}^{2}⁡({x}^{3})}{6}+C" :db/id #edb/ref 17592186384658} {:answer/id #uuid "c5ca6758-4100-5c28-a5e2-8d3c88248263" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5\\operatorname{ln}⁡({x}^{3})}{12}+C" :db/id #edb/ref 17592186384659} {:answer/id #uuid "8ace6c23-79dc-5742-bc86-816d99045d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5{log}_{5}^{2}⁡({x}^{3})}{12}+C" :db/id #edb/ref 17592186384660} {:answer/id #uuid "c0fb5889-b60d-5aaf-8beb-363ab1698930" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{ln}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186384661} {:answer/id #uuid "4cc9eae9-b3ce-547a-9a34-0e08774a75ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{ln}^{2}⁡({x}^{3})}{2}+C" :db/id #edb/ref 17592186384662}] :answer-field/correct {:answer/id #uuid "8ace6c23-79dc-5742-bc86-816d99045d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5{log}_{5}^{2}⁡({x}^{3})}{12}+C" :db/id #edb/ref 17592186384660} :answer-field/id #uuid "c996e19a-d711-54dc-9b49-a03cea7cecd2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384657}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6517d214-0493-5c34-bfbe-5920e35412fd" :question/math-academy-id "q-210751" :question/problem "$\\int \\frac{{log}_{5}⁡({x}^{3})}{2x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡({x}^{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡5}\\,⟹\\,\\frac{\\operatorname{ln}⁡5}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{5}⁡({x}^{3})}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{5}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot (\\frac{\\operatorname{ln}⁡5}{3}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡5}{6}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡5}{6}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡5{log}_{5}^{2}⁡({x}^{3})}{12}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] [{:db/id #edb/ref 17592186100818 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100610 :question/id #uuid "d2f49acf-ed91-510d-a0f1-41c50eeef9e7" :question/math-academy-id "e-14422" :question/problem "Evaluate $\\displaystyle{\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x}.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | $e^2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\eqalign{\n\t\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x\n&= \\int_{e}^{e^2} (\\ln x)^2\\cdot \\dfrac{\\textrm{d}x}{x}\\[5pt]\n&=\\int_{1}^{2} u^2\\,\\textrm{d}u\\[5pt]\n&=\\left.\\dfrac13u^{3}\\right|_{1}^{2}\\[5pt] \n&=\\dfrac{1}{3}\\left(2^3-1^3 \\right)\\[5pt]\n&=\\dfrac{1}{3}\\left(8-1 \\right)\\[5pt]\n&=\\dfrac{7}{3}\t\t\n\n\t}\n$$"} :knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186101451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f44a31c-8f02-517f-a3ff-76a016ef1103" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186330368} {:answer/id #uuid "3b888702-3835-5e64-a746-f342b2add188" :answer/type {:db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186330480} {:answer/id #uuid "55e0e2dc-0727-59f1-ab88-5104534b5eae" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186330719} {:answer/id #uuid "570539a7-4903-5aaa-8ab5-396b0db3ecbe" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡4" :db/id #edb/ref 17592186330727} {:answer/id #uuid "fe377b72-3be3-5386-8d19-dd14073a8aa9" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186332189}] :answer-field/correct {:answer/id #uuid "55e0e2dc-0727-59f1-ab88-5104534b5eae" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186330719} :answer-field/id #uuid "41c0ce28-8066-581a-a24f-804e0ab448c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332311}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "131ef8ba-67f1-5c9d-a9d6-716f27012aa1" :question/math-academy-id "q-49605" :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$  gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{4}}\\frac{8\\operatorname{ln}⁡x}{x}\\,\\text{d}x & =8{\\int }_{{e}^{2}}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =8{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =8\\cdot {\\frac{{u}^{2}}{2}|}_{2}^{4} \\\\  & =4\\cdot {u}^{2}{|}_{2}^{4} \\\\  & =4\\cdot (16-4) \\\\  & =48\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1911069-1c55-5932-b891-074fa38d0681" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186099874} {:answer/id #uuid "b51f2b52-e938-50e1-90fa-bb6448bdc3fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{1}{5})" :db/id #edb/ref 17592186099875} {:answer/id #uuid "d779e443-9211-5d9f-983d-aa5869c4abba" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (\\frac{3}{2})" :db/id #edb/ref 17592186099876} {:answer/id #uuid "101f63ee-048f-5071-864e-f39dff0809ff" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186099877} {:answer/id #uuid "1ec3c643-d894-5c5f-a8f2-0ca4531cfaae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186099878}] :answer-field/id #uuid "d362f82d-b09f-5d0b-96ff-bd40056bb313" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099873}] :question/id #uuid "0cfec737-9b19-5478-8889-9f310f6bafce" :question/math-academy-id "q-49607" :question/problem "What is the value of $\\displaystyle \\int_{e^{4}}^{e^{9}}\\frac{3\\sqrt{\\ln x}}{2x}dx$?"} {:db/id #edb/ref 17592186101535 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a0a75b-f8ec-54c5-8a7a-c4809a5dfbd1" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186441876} {:answer/id #uuid "64a568b0-03ae-50f3-9960-f6a12c2c3edd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441881} {:answer/id #uuid "8351c1fb-1f5f-531e-b8d0-f8d53498e7df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{ln}^{2}⁡2}{2}" :db/id #edb/ref 17592186441883} {:answer/id #uuid "9773d021-d3dc-5a4f-a413-83c7aabfc9ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441885} {:answer/id #uuid "e68587f4-8c6a-5209-a952-e474e449105e" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441892}] :answer-field/correct {:answer/id #uuid "13a0a75b-f8ec-54c5-8a7a-c4809a5dfbd1" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186441876} :answer-field/id #uuid "ff77337b-c76b-58b6-bf25-fc16e01ca583" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100371}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d5cc7305-f37c-53f7-a090-f87a05c29da3" :question/math-academy-id "q-73654" :question/problem "What is the value of ${\\int }_{2}^{4}\\frac{4}{x{log}_{2}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $4$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{4}{x{log}_{2}⁡x}\\,\\text{d}x & =4{\\int }_{2}^{4}\\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡2{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡2(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =4\\operatorname{ln}⁡2\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d6f093e-f768-5e62-ade0-cf5596e4cd1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186267107} {:answer/id #uuid "86209d84-5f42-5574-8ad3-0e47879b9965" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267327} {:answer/id #uuid "870b3329-aa01-5f17-9195-ecc19a4828b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186267336} {:answer/id #uuid "9e67db5a-0313-599c-9c9f-de8434f5f20e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186267571} {:answer/id #uuid "b99c433b-c983-52f0-b3d5-5926af31a475" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267807}] :answer-field/correct {:answer/id #uuid "870b3329-aa01-5f17-9195-ecc19a4828b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186267336} :answer-field/id #uuid "55ad0e89-e68a-51f1-9876-435c573c4ae8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268561}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2ee2e00a-8c3c-5799-9d71-e6ddab6853db" :question/math-academy-id "q-13837" :question/problem "What is the value of ${\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{2}{3}{\\int }_{0}^{2}u\\,\\text{d}u \\\\  & =\\frac{2}{3}\\cdot {\\frac{{u}^{2}}{2}|}_{0}^{2} \\\\  & ={\\frac{{u}^{2}}{3}|}_{0}^{2} \\\\  & =\\frac{{2}^{2}}{3}-\\frac{{0}^{2}}{3} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8e4b7e-6484-54d8-82ef-905057fbfe3d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186266274} {:answer/id #uuid "171b3ebd-28f1-5159-9586-ca3b0ad1e1c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266333} {:answer/id #uuid "c46c5362-21f4-5da6-a3af-f4cf5a5e87ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186267899} {:answer/id #uuid "ceb69016-0981-5564-a216-f5aa929c2431" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186267993} {:answer/id #uuid "f5a9f8db-caf5-5753-9bbd-1d64a0f8ff58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186268322}] :answer-field/correct {:answer/id #uuid "c46c5362-21f4-5da6-a3af-f4cf5a5e87ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡2" :db/id #edb/ref 17592186267899} :answer-field/id #uuid "5563d6e5-dc15-5788-932c-de927f8d699c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268560}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "71f1a3c4-8374-541a-b0a7-9306ac0ecfa6" :question/math-academy-id "q-13841" :question/problem "What is the value of ${\\int }_{e/2}^{{e}^{2}/2}\\frac{2}{3x\\operatorname{ln}⁡(2x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/2$ | ${e}^{2}/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/2}^{{e}^{2}/2}\\frac{2}{3x\\operatorname{ln}⁡(2x)}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{e/2}^{{e}^{2}/2}\\frac{1}{\\operatorname{ln}⁡(2x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{2}{3}{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{2}{3}(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =\\frac{2}{3}(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =\\frac{2}{3}(\\operatorname{ln}⁡2-0) \\\\  & =\\frac{2}{3}\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "849b6357-4405-5be3-92d3-690a94a05de9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/id #edb/ref 17592186267312} {:answer/id #uuid "b62ec833-626a-59ec-9dac-6cd0249d5050" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}(\\operatorname{ln}⁡4)^{2}" :db/id #edb/ref 17592186267774} {:answer/id #uuid "c48de8c0-7f6c-5175-819c-ff9faa871868" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/id #edb/ref 17592186267902} {:answer/id #uuid "eee85d39-a002-55e1-9d08-b414d80753db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}(\\operatorname{ln}⁡4e-\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268270} {:answer/id #uuid "fe235bb5-2062-5c7a-a542-8a9eb6a5f67e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}(\\operatorname{ln}⁡4e)^{2}" :db/id #edb/ref 17592186268383}] :answer-field/correct {:answer/id #uuid "c48de8c0-7f6c-5175-819c-ff9faa871868" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/id #edb/ref 17592186267902} :answer-field/id #uuid "3b9be068-64dc-5bb7-baad-868d90e8f25b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268501}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "386635f7-97fa-5094-9755-51271e1af076" :question/math-academy-id "q-13842" :question/problem "What is the value of ${\\int }_{1}^{e}\\frac{3\\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡4e$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{3\\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{e}\\operatorname{ln}⁡(4x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e}u\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {\\frac{{u}^{2}}{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & ={\\frac{3}{4}\\cdot {u}^{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & =\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} {:answer/id #uuid "78b9a284-7918-5a48-9b63-09d2dbf15a7d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267206} {:answer/id #uuid "c324f604-f021-5ec4-97d6-e46d27f5780b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡4" :db/id #edb/ref 17592186267886} {:answer/id #uuid "f349a50e-2135-5759-85b8-7bfb21768dc7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268308} {:answer/id #uuid "f3e8bc1f-2171-58ab-a46f-699ee9e27a89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186268311}] :answer-field/correct {:answer/id #uuid "7148b847-d982-5ea4-b057-c5e42788f937" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186267138} :answer-field/id #uuid "a5268c76-ac42-5d62-8149-d9e09487a8d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268701}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ed857a50-0096-5fa3-bea2-e4ec1bd8cccb" :question/math-academy-id "q-13845" :question/problem "What is the value of ${\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e/4$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =\\frac{1}{4}{\\int }_{1}^{e/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}{\\int }_{\\operatorname{ln}⁡4}^{1}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡|u|){|}_{\\operatorname{ln}⁡4}^{1} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =\\frac{1}{4}(0-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd0da3d-094d-5fbb-931b-382cf883ca96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186295445} {:answer/id #uuid "5a904f2e-d51a-5abf-9629-c23b1eeaa263" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186295788} {:answer/id #uuid "5bbb6c9a-e6ec-50df-98be-50c0649c8d41" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186295795} {:answer/id #uuid "5fdceb7c-75b4-550b-9e43-434ead9f1bdc" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186295815} {:answer/id #uuid "9755583c-285b-50c4-a5fa-70b2b96ce22c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296075}] :answer-field/correct {:answer/id #uuid "9755583c-285b-50c4-a5fa-70b2b96ce22c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296075} :answer-field/id #uuid "bb9a7dd7-bdc6-5dcf-9c43-1e871e8d4d7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297023}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e4974d46-0f4e-5eb4-8954-be690c361878" :question/math-academy-id "q-31619" :question/problem "What is the value of ${\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{3}{x\\sqrt{\\operatorname{ln}⁡(5x)}}\\,\\text{d}x & =3{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(5x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot {\\frac{{u}^{1/2}}{1/2}|}_{1}^{4} \\\\  & =6\\cdot {\\sqrt{u}|}_{1}^{4} \\\\  & =6(\\sqrt{4}-\\sqrt{1}) \\\\  & =6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1431f8c9-f4af-57b3-98ac-1fc0b9479411" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{5}{2}" :db/id #edb/ref 17592186295380} {:answer/id #uuid "2559dc23-195c-5be9-bf05-24d04cf43261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186295469} {:answer/id #uuid "bcaa502b-a0c5-53a1-887c-c886eb6931bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{2}{3}" :db/id #edb/ref 17592186296260} {:answer/id #uuid "d8b954a5-2736-58ed-849a-01556eeac516" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡\\frac{x}{2}" :db/id #edb/ref 17592186296409} {:answer/id #uuid "f669c739-19e2-57ac-8224-83c10f80317d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186296578}] :answer-field/correct {:answer/id #uuid "2559dc23-195c-5be9-bf05-24d04cf43261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186295469} :answer-field/id #uuid "427dc5ae-0525-58ef-873a-f99cabbf18b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296761}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a9ace025-d2a7-57e0-b56c-f814cc5835a7" :question/math-academy-id "q-31639" :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{5x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{5x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{5}{\\int }_{2}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡|u|){|}_{2}^{3} \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06398586-1c51-546e-ba9b-fc7781b26de5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295297} {:answer/id #uuid "269c31e1-e53c-5dda-b79d-8b56f6fde233" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295476} {:answer/id #uuid "4ad9be68-7d1f-50a6-a25e-0bffd97fdc02" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295693} {:answer/id #uuid "51834b5a-e89e-5af7-b055-a18d07393528" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295737} {:answer/id #uuid "d8354e5a-3360-5329-9797-814959106481" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186296406}] :answer-field/correct {:answer/id #uuid "4ad9be68-7d1f-50a6-a25e-0bffd97fdc02" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295693} :answer-field/id #uuid "82a36094-e049-5aab-be04-713d1d5a9633" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296902}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f3473f0-efaa-5747-926c-a19ff897e0a6" :question/math-academy-id "q-31643" :question/problem "What is the value of ${\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/2$ | $1/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x & ={\\int }_{1/2}^{e/2}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(2x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}{u}^{-1/2}\\,\\text{d}u \\\\  & ={\\frac{{u}^{1/2}}{1/2}|}_{0}^{1} \\\\  & =2\\cdot {\\sqrt{u}|}_{0}^{1} \\\\  & =2(\\sqrt{1}-\\sqrt{0}) \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2562a9c9-aca4-5aab-ae8c-dfc0d8930a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|x|}{2\\sqrt{2}}" :db/id #edb/ref 17592186295470} {:answer/id #uuid "31d9ef31-5977-5a8f-86a4-f2af5b82793e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186295548} {:answer/id #uuid "4915700f-dd8e-57ab-ac0f-4d614790089c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡|x|}{\\sqrt{2}}" :db/id #edb/ref 17592186295685} {:answer/id #uuid "7b9da615-dcc8-547b-b139-e0fddd363070" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186295945} {:answer/id #uuid "9df1f497-a52a-514a-a098-e2493f3a2f1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{2\\sqrt{x}}" :db/id #edb/ref 17592186296110}] :answer-field/correct {:answer/id #uuid "31d9ef31-5977-5a8f-86a4-f2af5b82793e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}" :db/id #edb/ref 17592186295548} :answer-field/id #uuid "5b6f305a-1541-5b71-afe2-360d801bd991" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296819}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8f30c06d-366c-59ac-9244-d2bac8160fec" :question/math-academy-id "q-31648" :question/problem "What is the value of  ${\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡2}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $4$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{4}\\frac{3{log}_{2}⁡({x}^{2})}{\\sqrt{2}x}\\,\\text{d}x & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}{log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{\\sqrt{2}}{\\int }_{2}^{4}u\\cdot \\frac{\\operatorname{ln}⁡2}{2}\\,\\text{d}u \\\\  & =\\frac{3}{\\sqrt{2}}\\cdot \\frac{\\operatorname{ln}⁡2}{2}{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =\\frac{3\\operatorname{ln}⁡2}{2\\sqrt{2}}\\cdot \\frac{{u}^{2}}{2}{|}_{2}^{4} \\\\  & =\\frac{3\\operatorname{ln}⁡2}{4\\sqrt{2}}\\cdot (16-4) \\\\  & =\\frac{9\\operatorname{ln}⁡2}{\\sqrt{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c47da02-0de3-57ba-80b0-c125c05b20e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{3}" :db/id #edb/ref 17592186295525} {:answer/id #uuid "4c228dda-3c12-503a-ae76-b6dbd65e3cfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{2\\sqrt{5}}" :db/id #edb/ref 17592186295701} {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} {:answer/id #uuid "cb2d8a19-1869-5d11-b6b2-5d7224310807" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296333} {:answer/id #uuid "fe9d3052-96a7-52e6-88ad-4c8dcf860d47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31\\operatorname{ln}⁡5}{\\sqrt{5}}" :db/id #edb/ref 17592186296624}] :answer-field/correct {:answer/id #uuid "710ae787-1902-5217-9c26-724daf023aa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\operatorname{ln}⁡5}{2}" :db/id #edb/ref 17592186295887} :answer-field/id #uuid "d0467277-3365-50ac-9fc9-dd5fec40a456" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297066}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7168c66b-e063-53c6-92aa-cf6372184dec" :question/math-academy-id "q-31669" :question/problem "What is the value of ${\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡(5x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x\\operatorname{ln}⁡5}\\cdot 5=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}\\frac{7{log}_{5}⁡(5x)}{x}\\,\\text{d}x & =7{\\int }_{1}^{5}{log}_{5}⁡(5x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =7{\\int }_{1}^{2}u\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =7\\operatorname{ln}⁡5\\cdot \\frac{{u}^{2}}{2}{|}_{1}^{2} \\\\  & =7\\operatorname{ln}⁡5\\cdot (\\frac{4}{2}-\\frac{1}{2}) \\\\  & =\\frac{21\\operatorname{ln}⁡5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc5d5dbd-ebb8-54de-b27d-1e5f671375fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{75}{8}" :db/id #edb/ref 17592186318241}] :answer-field/correct {:answer/id #uuid "cc5d5dbd-ebb8-54de-b27d-1e5f671375fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{75}{8}" :db/id #edb/ref 17592186318241} :answer-field/id #uuid "264e356f-d936-5e81-beea-c24086edca28" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318501}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b8d4df78-0e9a-508b-ae35-e42755fe5bc0" :question/math-academy-id "q-346434" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e}^{{e}^{4}}\\frac{5\\operatorname{ln}⁡x}{4x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{4}}\\frac{5\\operatorname{ln}⁡x}{4x}\\,\\text{d}x & =\\frac{5}{4}{\\int }_{e}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{1}^{4}u\\,\\text{d}u \\\\  & =\\frac{5}{4}\\cdot \\frac{{u}^{2}}{2}\\,{|}_{1}^{4} \\\\  & =\\frac{5}{8}\\cdot {u}^{2}\\,{|}_{1}^{4} \\\\  & =\\frac{5}{8}({4}^{2}-{1}^{2}) \\\\  & =\\frac{5}{8}\\cdot 15 \\\\  & =\\frac{75}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403ba02d-eba3-5591-8259-adb3276aecb5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/id #edb/ref 17592186317772}] :answer-field/correct {:answer/id #uuid "403ba02d-eba3-5591-8259-adb3276aecb5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/id #edb/ref 17592186317772} :answer-field/id #uuid "30bc48a1-0d41-5c82-b1da-321bf1b58346" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318522}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cd8052bf-7195-55ef-bdc6-284e7fea5262" :question/math-academy-id "q-346435" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $32$ |\n| --- | --- | --- |\n| $u$ | $2$ | $5$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x & ={\\int }_{4}^{32}\\frac{1}{\\sqrt{{log}_{2}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot 2\\sqrt{u}\\,{|}_{2}^{5} \\\\  & =(2\\sqrt{5}-2\\sqrt{2})\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "973c5b68-ad60-5e99-b2c9-bcdcccc2ac6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}4" :db/id #edb/ref 17592186319839}] :answer-field/correct {:answer/id #uuid "973c5b68-ad60-5e99-b2c9-bcdcccc2ac6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}4" :db/id #edb/ref 17592186319839} :answer-field/id #uuid "eea04459-9e0b-58bf-95d3-0439c072fbce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320659}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b939403-6bca-5ea1-8cdf-234c2e6cc503" :question/math-academy-id "q-351281" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(5x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5x}\\cdot 5=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/5$ | ${e}^{4}/5$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{x\\operatorname{ln}⁡(5x)}\\,\\text{d}x & ={\\int }_{e/5}^{{e}^{4}/5}\\frac{1}{\\operatorname{ln}⁡(5x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{4} \\\\  & =\\operatorname{ln}⁡4-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bed6edcd-4615-53d1-831c-db585e0780f2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319976}] :answer-field/correct {:answer/id #uuid "bed6edcd-4615-53d1-831c-db585e0780f2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319976} :answer-field/id #uuid "d52ea3ad-2100-5f48-98bb-b1648f840777" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320603}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "61d3be96-13ed-5bf2-8f8a-0bd5779fc023" :question/math-academy-id "q-351283" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{3}^{81}\\frac{2}{x\\sqrt{{log}_{3}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡3$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $81$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{81}\\frac{2}{x\\sqrt{{log}_{3}⁡x}}\\,\\text{d}x & =2{\\int }_{3}^{81}\\frac{1}{\\sqrt{{log}_{3}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡3\\cdot (2\\sqrt{u}){|}_{1}^{4} \\\\  & =4\\operatorname{ln}⁡3(\\sqrt{4}-\\sqrt{1}) \\\\  & =4\\operatorname{ln}⁡3(2-1) \\\\  & =(4)\\operatorname{ln}⁡3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8a2fb3-0f4b-5fe7-ab34-cb4b95eae8e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}3" :db/id #edb/ref 17592186319418} {:answer/id #uuid "0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\ln 3" :db/id #edb/ref 17592186441874}] :answer-field/correct {:answer/id #uuid "0444227a-dd50-5fbc-9b4c-b746cc7ac5e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\ln 3" :db/id #edb/ref 17592186441874} :answer-field/id #uuid "d8924e9a-12d1-532a-9e9e-b8791083cc33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "353ff421-65f8-59eb-b8ea-71a83d1ce946" :question/math-academy-id "q-351287" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x=($\n{{field-1}}\n$)\\,\\operatorname{ln}⁡5$" :question/worked-solution "Let $u={log}_{5}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡5}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡5}\\,⟹\\,\\frac{\\operatorname{ln}⁡5}{2}\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $125$ |\n| --- | --- | --- |\n| $u$ | $2$ | $6$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x & =\\frac{8}{3}{\\int }_{5}^{125}\\frac{1}{{log}_{5}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{8}{3}{\\int }_{2}^{6}\\frac{1}{u}\\cdot \\frac{\\operatorname{ln}⁡5}{2}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}{\\int }_{2}^{6}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡|u|){|}_{2}^{6} \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2) \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}\\operatorname{ln}⁡3 \\\\  & =(\\frac{4}{3}\\operatorname{ln}⁡3)\\operatorname{ln}⁡5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4161adbe-3593-51fb-aeb0-7604bab27c35" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186330530} {:answer/id #uuid "449448ac-be28-5cf5-a19f-c4898f99b10f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186330567} {:answer/id #uuid "9d3ba09d-36e9-510e-8bf1-411520149fad" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186331358} {:answer/id #uuid "a5a2edd0-4861-5503-aa98-ef2925501542" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331433} {:answer/id #uuid "b4640f92-afdc-54b3-afe7-d70b32daa8e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186331544}] :answer-field/correct {:answer/id #uuid "b4640f92-afdc-54b3-afe7-d70b32daa8e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186331544} :answer-field/id #uuid "c289de45-9a1b-5061-b32e-0117afdc042d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332543}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fde6af27-2c77-53dd-8542-aaa673109767" :question/math-academy-id "q-49517" :question/problem "What is the value of ${\\int }_{e}^{{e}^{2}}\\frac{\\text{d}x}{x\\operatorname{ln}⁡x}?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{\\text{d}x}{x\\operatorname{ln}⁡x} & ={\\int }_{e}^{{e}^{2}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =\\operatorname{ln}⁡2-\\operatorname{ln}⁡1 \\\\  & =\\operatorname{ln}⁡2\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f292278-673c-5eba-880c-7cda055f8171" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186330511} {:answer/id #uuid "5dac8132-bf52-5344-825a-5d6616a1cdd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186330784} {:answer/id #uuid "83aeb76a-c46c-5da9-b6b1-d3b2c07f5e3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡3}{3}" :db/id #edb/ref 17592186331119} {:answer/id #uuid "884a0de8-2fb3-540c-834e-7021c6f3a3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186331163} {:answer/id #uuid "dc4580e3-6e2d-5fe8-9d8c-28fc47a327cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡2}{3}" :db/id #edb/ref 17592186331902}] :answer-field/correct {:answer/id #uuid "5dac8132-bf52-5344-825a-5d6616a1cdd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186330784} :answer-field/id #uuid "d90e8da3-8c2b-5ff0-aa8c-d768bd2f0c85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332582}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "06ae8c49-a573-55e1-8d24-c78494f9b5b0" :question/math-academy-id "q-49606" :question/problem "What is the value of ${\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e}^{{e}^{3}}\\frac{\\sqrt{3}}{2x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{\\sqrt{3}}{2}{\\int }_{e}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{\\sqrt{3}}{2}{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =\\frac{\\sqrt{3}\\operatorname{ln}⁡3}{2}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08301326-b847-5bf8-a7ac-ae63cd79e249" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡2" :db/id #edb/ref 17592186339196} {:answer/id #uuid "56930227-1428-50c5-a8cc-034a49832e89" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186339922} {:answer/id #uuid "6bbc5f38-16b9-57ee-a58b-64b2d5ef36e7" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186340083} {:answer/id #uuid "eec38fc4-d48a-5e6e-8931-f06a7a864ae4" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186341234} {:answer/id #uuid "eed401bf-7466-5857-a56b-834def403b2e" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186341236}] :answer-field/correct {:answer/id #uuid "eec38fc4-d48a-5e6e-8931-f06a7a864ae4" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186341234} :answer-field/id #uuid "53154123-fac5-56a4-af6a-e5b7c7ec264f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341530}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67b1cc06-52db-594d-af64-fc96a02b017c" :question/math-academy-id "q-73653" :question/problem "What is the value of ${\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x & =4{\\int }_{1}^{4}{log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =2\\operatorname{ln}⁡4\\cdot (1-0) \\\\  & =2\\operatorname{ln}⁡4 \\\\  & =4\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164d03a7-1370-51a6-8397-ae3a37ee3435" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186339325} {:answer/id #uuid "59a89007-afad-59e1-97c9-f01d389bf291" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186339943} {:answer/id #uuid "9266fee0-0299-5561-8066-c587641ef39a" :answer/type {:db/ident :answer.type/math} :answer/value "8{ln}^{2}⁡2" :db/id #edb/ref 17592186340441} {:answer/id #uuid "a3158c6c-e82d-594c-bf87-7aa6ded323cd" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186340606} {:answer/id #uuid "c4b063ef-7d2e-5c4b-99bd-f6ee337f7b43" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡2" :db/id #edb/ref 17592186340876}] :answer-field/correct {:answer/id #uuid "a3158c6c-e82d-594c-bf87-7aa6ded323cd" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186340606} :answer-field/id #uuid "083ceb34-fb13-5d1c-8ff1-ed4f8fdff6b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341398}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "46fc463a-0e37-5adb-8efe-657661cd9784" :question/math-academy-id "q-73655" :question/problem "What is the value of ${\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $16$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x & =2{\\int }_{2}^{4}\\frac{1}{{log}_{4}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡4\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡({2}^{2})\\operatorname{ln}⁡2 \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eafeb14-c8c5-545b-a26c-84a8ffdb3bb1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\operatorname{ln}⁡8}" :db/id #edb/ref 17592186339540} {:answer/id #uuid "31f0df20-fa82-5df5-ac98-2f11e0f712be" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186339567} {:answer/id #uuid "453ac55b-b5ef-5bd9-ab47-2d658db0c581" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\operatorname{ln}⁡8" :db/id #edb/ref 17592186339742} {:answer/id #uuid "66afc99b-c4df-5906-b1f4-1abfb6ca13c5" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340031} {:answer/id #uuid "997973b5-0aa4-5755-be92-64594db4e075" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\sqrt{2})\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340513}] :answer-field/correct {:answer/id #uuid "66afc99b-c4df-5906-b1f4-1abfb6ca13c5" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)\\operatorname{ln}⁡8" :db/id #edb/ref 17592186340031} :answer-field/id #uuid "246f92ed-b4b3-5d28-a1bf-1d986ab28138" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341443}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3ddbff7e-d3cb-563f-8731-6916af8ccc56" :question/math-academy-id "q-73656" :question/problem "What is the value of ${\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $8$ | $64$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x & ={\\int }_{8}^{64}\\frac{1}{\\sqrt{{log}_{8}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8{\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8(2\\sqrt{u}){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡8(\\sqrt{2}-\\sqrt{1}) \\\\  & =2(\\sqrt{2}-1)\\operatorname{ln}⁡8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba9b513-fd9e-5532-ac97-f39096b6d80d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡7" :db/id #edb/ref 17592186339229} {:answer/id #uuid "5146b66f-c081-5a5d-8a49-9465f6a29017" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}" :db/id #edb/ref 17592186339874} {:answer/id #uuid "6f33def5-e388-5e0c-8e27-ef1debc47437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186340114} {:answer/id #uuid "f3b7ff34-6e45-5d0f-881a-f864fd3aefad" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7" :db/id #edb/ref 17592186341276} {:answer/id #uuid "fc039a6e-3ced-5554-821f-11c2bfcbf96a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡7" :db/id #edb/ref 17592186341355}] :answer-field/correct {:answer/id #uuid "6f33def5-e388-5e0c-8e27-ef1debc47437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186340114} :answer-field/id #uuid "71a8e5ea-7823-5b4d-bd7c-7ee99e3470da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341575}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f9fa12f0-8b86-59fd-acb9-b45aae5f88d9" :question/math-academy-id "q-73658" :question/problem "What is the value of ${\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{7}⁡(\\frac{x}{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡7}\\cdot \\frac{1}{3}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $21$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x & ={\\int }_{3}^{21}{log}_{7}⁡(\\frac{x}{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot (1-0) \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c85c552c-0ff1-5148-a4d2-342abba93768" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{{log}_{3}⁡x}" :db/id #edb/ref 17592186374619} {:answer/id #uuid "e786ce68-d2d1-5eff-b775-2083018f9df2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186374620} {:answer/id #uuid "8509899d-a879-55ba-9bde-472de5ff5912" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{2}" :db/id #edb/ref 17592186374621} {:answer/id #uuid "e73eeb00-dc7c-5cf8-af46-0b97a4a94f3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{3}" :db/id #edb/ref 17592186374622} {:answer/id #uuid "1c419824-ebeb-53f2-b58f-f2ebd505e783" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186374623}] :answer-field/correct {:answer/id #uuid "e786ce68-d2d1-5eff-b775-2083018f9df2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3}{2}" :db/id #edb/ref 17592186374620} :answer-field/id #uuid "2c6f018d-495b-531f-bd03-e442b877a27d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374618}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "46f01b36-965c-5aab-a0e7-c33b421d2a82" :question/math-academy-id "q-31588" :question/problem "What is the value of ${\\int }_{1}^{3}\\frac{{log}_{3}⁡x}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{{log}_{3}⁡x}{x}\\,\\text{d}x & ={\\int }_{1}^{3}{log}_{3}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\operatorname{ln}⁡3\\cdot (\\frac{{1}^{2}}{2}-\\frac{{0}^{2}}{2}) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1edf87b-ed45-5304-b224-31e9ec542b58" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186374626} {:answer/id #uuid "2943b0e0-33c3-5ccc-aa84-ab39c1960224" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186374627} {:answer/id #uuid "d6187747-e0a4-5fee-8cd9-05c678a121a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{24}" :db/id #edb/ref 17592186374628} {:answer/id #uuid "690317d0-3209-5ddb-94c9-c1a622a766f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186374629} {:answer/id #uuid "5a24c986-898e-54c0-b365-6f458b7c7959" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186374630}] :answer-field/correct {:answer/id #uuid "690317d0-3209-5ddb-94c9-c1a622a766f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186374629} :answer-field/id #uuid "ab434a47-b415-5d71-8685-330d0dcab9c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374625}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8e40beb0-a519-50d4-b251-d1345097fb54" :question/math-academy-id "q-31590" :question/problem "What is the value of ${\\int }_{e}^{{e}^{2}}\\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{e}^{{e}^{2}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {\\frac{{u}^{2}}{2}|}_{1}^{2} \\\\  & =\\frac{1}{4}\\cdot {{u}^{2}|}_{1}^{2} \\\\  & =\\frac{1}{4}({2}^{2}-{1}^{2}) \\\\  & =\\frac{1}{4}(3) \\\\  & =\\frac{3}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7f5c99e-9a37-5820-a1ca-cf048d293561" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375066}] :answer-field/correct {:answer/id #uuid "e7f5c99e-9a37-5820-a1ca-cf048d293561" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186375066} :answer-field/id #uuid "49d84293-79fe-5d8a-8714-af649008e9a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375065}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7909088b-942e-5c28-83d7-5489395899d0" :question/math-academy-id "q-350209" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}\\frac{3\\sqrt{\\operatorname{ln}⁡x}}{x}\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{3\\sqrt{\\operatorname{ln}⁡x}}{x}\\,\\text{d}x & =3{\\int }_{1}^{e}\\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3{\\int }_{0}^{1}\\sqrt{u}\\,\\text{d}u \\\\  & =3{\\int }_{0}^{1}{u}^{1/2}\\,\\text{d}u \\\\  & =3\\cdot \\frac{{u}^{3/2}}{3/2}\\,{|}_{0}^{1} \\\\  & =2\\cdot {u}^{3/2}\\,{|}_{0}^{1} \\\\  & =2({1}^{3/2}-{0}^{3/2}) \\\\  & =2(1-0) \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b922c00-fec0-5e92-b344-12d9b0a9d88e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186375069}] :answer-field/correct {:answer/id #uuid "9b922c00-fec0-5e92-b344-12d9b0a9d88e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186375069} :answer-field/id #uuid "b4f0da75-3954-585b-bedf-4f0ec53da429" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375068}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a467975c-198b-531b-975f-70d1e6e0a17e" :question/math-academy-id "q-351282" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}\\frac{4\\operatorname{ln}⁡({x}^{3})}{5x}\\,\\text{d}x=$ \n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{3}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{3}}\\cdot 3{x}^{2}=\\frac{3}{x}\\,⟹\\,\\frac{1}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{4\\operatorname{ln}⁡({x}^{3})}{5x}\\,\\text{d}x & =\\frac{4}{5}{\\int }_{1}^{e}\\operatorname{ln}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{4}{5}{\\int }_{0}^{3}u\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{4}{15}{\\int }_{0}^{3}u\\,\\text{d}u \\\\  & =\\frac{4}{15}\\cdot {\\frac{{u}^{2}}{2}|}_{0}^{3} \\\\  & =\\frac{4}{15}\\cdot \\frac{9}{2} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eab9d45b-a0c0-5418-a203-0aba7763da28" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186375072}] :answer-field/correct {:answer/id #uuid "eab9d45b-a0c0-5418-a203-0aba7763da28" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186375072} :answer-field/id #uuid "eb1fc348-9d4d-5007-8914-af996cd84800" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186375071}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1a82fa79-cd38-52c8-bdda-6f1fd4a33aa2" :question/math-academy-id "q-351286" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{2}^{8}\\frac{{log}_{2}⁡(2x)}{x}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" :question/worked-solution "Let $u={log}_{2}⁡(2x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x\\operatorname{ln}⁡2}\\cdot 2=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $2$ | $8$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{2}^{8}\\frac{{log}_{2}⁡(2x)}{x}\\,\\text{d}x & ={\\int }_{2}^{8}{log}_{2}⁡(2x)\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{4}u\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{4}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{u}^{2}}{2}{|}_{2}^{4} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡2(16-4) \\\\  & =(6)\\operatorname{ln}⁡2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186375342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21c7787a-31a6-57b0-b969-bd5a3135ac96" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375344} {:answer/id #uuid "ea54053a-6425-5e9e-9a77-4524ffd6d1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375345} {:answer/id #uuid "d4d2f994-5b9c-5919-a4e1-d619a8e6da32" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡8" :db/id #edb/ref 17592186375346} {:answer/id #uuid "1c809f7d-d7ef-5008-a293-5216d4ae0256" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375347} {:answer/id #uuid "e0158386-27f6-5854-8b7c-bf137f533a07" :answer/type {:db/ident :answer.type/math} :answer/value "3{ln}^{2}⁡8" :db/id #edb/ref 17592186375348}] :answer-field/correct {:answer/id #uuid "ea54053a-6425-5e9e-9a77-4524ffd6d1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186375345} :answer-field/id #uuid "0cf307e2-aa61-5c5c-9a35-cb1835a62040" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375343}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1db700ab-3b05-5d1d-a411-1cbed80c9e6b" :question/math-academy-id "q-73657" :question/problem "What is the value of ${\\int }_{1}^{2}\\frac{6{log}_{8}⁡(2x)}{x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{8}⁡(2x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x\\operatorname{ln}⁡8}\\cdot 2=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1/3$ | $2/3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{6{log}_{8}⁡(2x)}{x}\\,\\text{d}x & =6{\\int }_{1}^{2}{log}_{8}⁡(2x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =6{\\int }_{1/3}^{2/3}u\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =6\\operatorname{ln}⁡8{\\int }_{1/3}^{2/3}u\\,\\text{d}u \\\\  & =6\\operatorname{ln}⁡8\\cdot \\frac{{u}^{2}}{2}{|}_{1/3}^{2/3} \\\\  & =3\\operatorname{ln}⁡8\\cdot (\\frac{4}{9}-\\frac{1}{9}) \\\\  & =\\operatorname{ln}⁡8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186441900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4403caea-cd74-51a9-b79d-725521c1723f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡8" :db/id #edb/ref 17592186441878} {:answer/id #uuid "53d5b4d4-65c5-534f-b5bf-9a4d54b10bf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2" :db/id #edb/ref 17592186441880} {:answer/id #uuid "74dd2751-1a10-5b13-a07e-4a1b5ceee5f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡4" :db/id #edb/ref 17592186441882} {:answer/id #uuid "d0c5c72a-52a6-527f-9089-d3942f82a598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{5}" :db/id #edb/ref 17592186441888} {:answer/id #uuid "fa48eb2e-b23d-5975-8ee4-2650534bd1bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡4}{5}" :db/id #edb/ref 17592186441894}] :answer-field/correct {:answer/id #uuid "d0c5c72a-52a6-527f-9089-d3942f82a598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{5}" :db/id #edb/ref 17592186441888} :answer-field/id #uuid "5e5e2b78-7327-5ca0-90fb-487bdfff6019" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186441895}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d724ae77-2273-56ab-852e-2415e473e7f8" :question/math-academy-id "q-13840" :question/problem "Evaluate the integral ${\\int }_{e}^{{e}^{2}}\\frac{2}{5x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{2}}\\frac{2}{5x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{e}^{{e}^{2}}\\frac{2}{x\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{5}{\\int }_{2}^{4}\\frac{2}{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{5}{\\int }_{2}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡|u|){|}_{2}^{4} \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡4-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡{2}^{2}-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}(2\\operatorname{ln}⁡2-\\operatorname{ln}⁡2) \\\\  & =\\frac{\\operatorname{ln}⁡2}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b7494e-bb79-5b12-9236-a587f999330d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489565} {:answer/id #uuid "1b976c74-2288-5edb-ac14-b1435c6814f0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489578} {:answer/id #uuid "4a39aa0a-e274-5fb2-8704-b394c3cd5dd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡3" :db/id #edb/ref 17592186489687} {:answer/id #uuid "65a94067-f449-5e05-8e2b-89087734bd4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489754} {:answer/id #uuid "7c3b6154-88e4-5ca3-9c7b-ddeffecf3bd3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489798}] :answer-field/correct {:answer/id #uuid "7c3b6154-88e4-5ca3-9c7b-ddeffecf3bd3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡2\\operatorname{ln}⁡5" :db/id #edb/ref 17592186489798} :answer-field/id #uuid "3273c5e4-90f1-5aee-9f26-60f52ccd89f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490099}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "29e8aaaf-e383-5b29-a6be-9cfefb451c7a" :question/math-academy-id "q-31616" :question/problem "What is the value of ${\\int }_{5}^{25}\\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $25$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{25}\\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3{\\int }_{5}^{25}\\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =3\\operatorname{ln}⁡5(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =3\\operatorname{ln}⁡2\\operatorname{ln}⁡5\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "588a64f8-b007-597a-90a1-13bc0deadb69" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\operatorname{ln}⁡3)" :db/id #edb/ref 17592186489726} {:answer/id #uuid "58d74548-f1c5-5c19-af0c-64a5b689a324" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489727} {:answer/id #uuid "64f36bf8-3759-5b50-8859-73b64d5b2c38" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{2}⁡3\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489752} {:answer/id #uuid "ae420e08-ae64-53a3-b2a8-a61252329c53" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489897} {:answer/id #uuid "fba1a44c-3ac0-56fc-b34d-91572dd0f45a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186490061}] :answer-field/correct {:answer/id #uuid "58d74548-f1c5-5c19-af0c-64a5b689a324" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186489727} :answer-field/id #uuid "1e61d7a6-a656-53b9-8d80-257f6bbc76cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490088}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "43a38f2f-26ab-5a55-9c36-de9ec5e565a5" :question/math-academy-id "q-31615" :question/problem "What is the value of ${\\int }_{4}^{8}\\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $8$ |\n| --- | --- | --- |\n| $u$ | $2$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{8}\\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & ={\\int }_{4}^{8}\\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{3}\\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2(\\operatorname{ln}⁡|u|){|}_{2}^{3} \\\\  & =\\operatorname{ln}⁡2\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490258 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59077802-2ece-52ce-8fdb-8f6f3735b72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489730} {:answer/id #uuid "da84991b-fcac-5426-a689-60bfacfa87a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489996} {:answer/id #uuid "df6c29bc-d773-5ece-9a45-14b4359b35cd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186489999} {:answer/id #uuid "eed896f0-f769-50fb-a53d-7bc14aff6cc3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490029} {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032}] :answer-field/correct {:answer/id #uuid "f14b3a35-0151-5e3a-b9bf-83c572725766" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186490032} :answer-field/id #uuid "a108c977-d111-5123-bfa0-9f9dd2b6376b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490166}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "633f13a2-1c12-5a0e-ade7-b4d04e14c842" :question/math-academy-id "q-13844" :question/problem "What is the value of ${\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡8$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{3}{2x{ln}^{2}⁡(4x)}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{2}\\frac{1}{(\\operatorname{ln}⁡(4x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {(-{u}^{-1})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}\\cdot {(\\frac{1}{u})|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡8} \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡8}-\\frac{1}{\\operatorname{ln}⁡4}) \\\\  & =-\\frac{3}{2}(\\frac{1}{\\operatorname{ln}⁡{2}^{3}}-\\frac{1}{\\operatorname{ln}⁡{2}^{2}}) \\\\  & =-\\frac{3}{2}(\\frac{1}{3\\operatorname{ln}⁡2}-\\frac{1}{2\\operatorname{ln}⁡2}) \\\\  & =-\\frac{3}{2}(-\\frac{1}{6\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{4\\operatorname{ln}⁡2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186490321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6a9f60-c08f-5467-a283-a5c875e998cb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186489583} {:answer/id #uuid "311cb6a0-4004-536b-aff8-04d49cb5cc24" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186489625} {:answer/id #uuid "abe6da9b-8429-54a3-ba90-b2deefe451bc" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3}" :db/id #edb/ref 17592186489892} {:answer/id #uuid "f50f90e5-5553-5d0c-bfdb-c4fbba7c5236" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490044} {:answer/id #uuid "fc4aa3c7-4608-5feb-8e43-09317d7d8264" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490064}] :answer-field/correct {:answer/id #uuid "f50f90e5-5553-5d0c-bfdb-c4fbba7c5236" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186490044} :answer-field/id #uuid "b8df4958-daa0-55e3-96a1-d8edb4b2bd89" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490173}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ee507cc2-c5c1-5dca-b8f8-28391520da63" :question/math-academy-id "q-49552" :question/problem "What is the value of ${\\int }_{e/4}^{{e}^{3}/4}\\frac{3}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡4x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/4$ | ${e}^{3}/4$ |\n| --- | --- | --- |\n| $u$ | $1$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{e/4}^{{e}^{3}/4}\\frac{3}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =3{\\int }_{e/4}^{{e}^{3}/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =3(\\operatorname{ln}⁡|u|){|}_{1}^{3} \\\\  & =3(\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =3\\operatorname{ln}⁡3\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating Definite Integrals"}]}
