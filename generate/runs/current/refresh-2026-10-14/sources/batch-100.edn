5b355-307a-57db-947f-d3ef8d268d84" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498677} {:answer/id #uuid "83323bd5-5d34-562b-8783-b053fe0eef22" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498691} {:answer/id #uuid "a8f856d5-e5e8-54b8-ab43-051a8533362c" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498700} {:answer/id #uuid "da7c1cda-1a6a-51a1-bee2-23c37eac0b62" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498710}] :answer-field/correct {:answer/id #uuid "a8f856d5-e5e8-54b8-ab43-051a8533362c" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498700} :answer-field/id #uuid "50fbda0d-f2a0-59f8-8288-e3b71a72d78f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498680}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac37c3c8-b208-5c81-a00d-e1bd9d503cf5" :question/problem "![](images/21/210db4ba3df7f9004c6ffe53336ce3e42d4156841560813478c404353b204c0c.png)\n\nWhich of the given points lie on the line $y=-4x+1?$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(0,3),B(1,-1)$ and $C(2,-7).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(0,3)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-4x+1 \\\\ (3) & =-4(0)+1 \\\\ 3 & =1\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $A$ does *not* lie on the line.\n\n- Substituting the point $B(1,-1)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-4x+1 \\\\ (-1) & =-4(1)+1 \\\\ -1 & =-3\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(2,-7)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =-4x+1 \\\\ (-7) & =-4(2)+1 \\\\ -7 & =-7\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only point $C$ lies on the line."} {:db/id #edb/ref 17592186498703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0944b8cd-a8ad-5881-872d-cc7841b124b3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498663} {:answer/id #uuid "0a037906-7560-5a7f-af3a-df39ea31c7f5" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498664} {:answer/id #uuid "2e04fce8-d81f-5c10-9a2d-ce00e7cc6157" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186498674} {:answer/id #uuid "64c6d466-8db0-5469-a154-b446a630e557" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498685} {:answer/id #uuid "cb659afb-f587-5d6a-8397-672e2e9f924f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498709}] :answer-field/correct {:answer/id #uuid "0944b8cd-a8ad-5881-872d-cc7841b124b3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498663} :answer-field/id #uuid "9124fd28-3c96-58aa-a8b1-46f977a63903" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498694}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b0bb51db-df3a-5c24-9053-c8f5081141e9" :question/problem "![](images/1a/1aa0849898f763eedd84d050a7bd7c24bbb10c8f89c81e3f533622252330814e.png)\n\nIdentify the points that lie on the line $y=3x+4.$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-3,-5)$, $B(1,5)$ and $C(2,10).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-3,-5)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =3x+4 \\\\ (-5) & =3(-3)+4 \\\\ -5 & =-5\\,✓\\end{aligned}\n$$\n\nTherefore, the point $A$ does lie on the line.\n\n- Substituting the point $B(1,5)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =3x+4 \\\\ (5) & =3(1)+4 \\\\ 5 & =7\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(2,10)$ results in true statement:\n\n$$\n\\begin{aligned}y & =3x+4 \\\\ (10) & =3(2)+4 \\\\ 10 & =10\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only points $A$ and $C$ lie on the line."} {:db/id #edb/ref 17592186498706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32181eed-9458-5ccf-acc4-92033b733168" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186498675} {:answer/id #uuid "6485fbd6-7602-59e9-b7db-664adfdbcd5a" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186498684} {:answer/id #uuid "a768ab80-55c6-5d51-80fc-ee9ca1c3c7c4" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498699} {:answer/id #uuid "b31cf4f4-e928-5d0a-810e-cf15a16aed3f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186498704} {:answer/id #uuid "ea9fccde-11ea-51fa-a5a6-450785e2da15" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186498713}] :answer-field/correct {:answer/id #uuid "a768ab80-55c6-5d51-80fc-ee9ca1c3c7c4" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186498699} :answer-field/id #uuid "84d72100-1cce-5a74-8205-dd9bc89e56ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186498692}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bbacf92b-66e8-58cd-bc32-e7d565177fbf" :question/problem "![](images/1f/1ff37e7ea63a62de2a1ccbf59c53225b739be305f9e87f7aceca7735ba210bbd.png)\n\nWhich of the given points lie on the line $y=-3x?$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-2,8),B(0,-2)$ and $C(2,-6).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-2,8)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-3x \\\\ (8) & =-3(-2)+0 \\\\ 8 & =6\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $A$ does *not* lie on the line.\n\n- Substituting the point $B(0,-2)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-3x \\\\ (-2) & =-3(0)+0 \\\\ -2 & =0\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(2,-6)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =-3x \\\\ (-6) & =-3(2)+0 \\\\ -6 & =-6\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only point $C$ lies on the line."}] :knowledge-point/title "Identifying Points That Lie on a Line"}] [{:db/id #edb/ref 17592186100816 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100608 :question/id #uuid "8ea17e06-1248-510c-9e71-c57da0cb0d02" :question/math-academy-id "e-14405" :question/problem "Calculate $\\displaystyle{\\int \\dfrac{3}{x \\sqrt{\\ln x}} \\, \\textrm{d}x }.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot 2{u}^{1/2}+C \\\\  & =6\\sqrt{u}+C \\\\  & =6\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\\end{aligned}\n$$"} :knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050628 :topic/math-academy-id 334 :topic/title "Integrating Algebraic Functions Using Substitution"} {:db/id #edb/ref 17592186050690 :topic/math-academy-id 1116 :topic/title "Differentiating Logarithmic Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186101144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f860421-016d-598e-9a3b-ffff8d6777f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186266421} {:answer/id #uuid "386b67e4-14f4-532f-99b9-a8475b7fa620" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186266634} {:answer/id #uuid "6f269b33-359d-570d-a5a4-2bdd627272b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186267120} {:answer/id #uuid "b07dd8a2-3991-579e-8bab-35891ec7f947" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|" :db/id #edb/ref 17592186267734} {:answer/id #uuid "dac75aaf-6ecf-5d0c-907e-5b1aefb829ae" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186268080}] :answer-field/correct {:answer/id #uuid "dac75aaf-6ecf-5d0c-907e-5b1aefb829ae" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186268080} :answer-field/id #uuid "792a154d-57c5-59ce-ae0e-d4d767699f22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268628}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fe83e5e8-3e8c-5cd2-aca6-78f5c7a59344" :question/math-academy-id "q-13802" :question/problem "Calculate the integral $\\int \\frac{2}{x\\operatorname{ln}⁡(2x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(2x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(2x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3834cd28-59bb-579a-9438-f0c990ef8544" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{{ln}^{3}⁡(3x)}" :db/id #edb/ref 17592186266632} {:answer/id #uuid "88b07b84-7107-5a7d-ab77-963e934bbed0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{{ln}^{2}⁡(3x)}+C" :db/id #edb/ref 17592186267357} {:answer/id #uuid "e9c5bc00-f7dc-587e-b392-bb8fee1f11bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268224} {:answer/id #uuid "ed683359-bd54-5829-8677-c183904d17ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268252} {:answer/id #uuid "f5eb23a5-741f-5f84-9cfa-dcfe634aeafc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268324}] :answer-field/correct {:answer/id #uuid "e9c5bc00-f7dc-587e-b392-bb8fee1f11bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186268224} :answer-field/id #uuid "00e0a046-60d9-5919-9ccb-b91a58a0c5cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268403}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6b36b281-88d8-5ece-aa59-a18e57169f2d" :question/math-academy-id "q-13814" :question/problem "Calculate the integral $\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x & =5\\int \\frac{1}{(\\operatorname{ln}⁡(3x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{{u}^{2}}\\cdot \\text{d}u \\\\  & =-5\\cdot {u}^{-1}+C \\\\  & =-\\frac{5}{u}+C \\\\  & =-\\frac{5}{\\operatorname{ln}⁡(3x)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b74934d9-a8f9-51b9-8fd9-2c5d2d130f1d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln^{2} x + C" :db/id #edb/ref 17592186099211} {:answer/id #uuid "ca5931a9-8ed8-5f6c-b23c-048291524298" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln^{2} x + C" :db/id #edb/ref 17592186099212} {:answer/id #uuid "d8e6f962-d19c-5da1-afbf-4d7fbd8ab063" :answer/type {:db/ident :answer.type/math} :answer/value "-\\ln^{2} x + C" :db/id #edb/ref 17592186099213} {:answer/id #uuid "e8fa06e1-51c9-568c-adcc-e69419217ad3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln^{2} x}{2} + C" :db/id #edb/ref 17592186099214} {:answer/id #uuid "0d543a68-0c1a-525f-97de-a9398f98598b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln x + C" :db/id #edb/ref 17592186099215}] :answer-field/id #uuid "142d3249-0a26-562e-8022-9b03f7b49ba2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099210}] :question/id #uuid "fe74443f-369b-55cf-8b9f-9acedc4906f2" :question/math-academy-id "q-2202" :question/problem "Calculate the integral $\\displaystyle \\int\\frac{4\\ln x}{x}dx$."} {:db/id #edb/ref 17592186269163 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1254fcec-98e0-5f67-a76b-6f8a8e44308a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186266302} {:answer/id #uuid "2df7ae72-0cf7-5370-8c96-6a976c483816" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186266551} {:answer/id #uuid "94c0889d-4b4f-5d2e-afac-f8d8f354ffd1" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡x+C" :db/id #edb/ref 17592186267474} {:answer/id #uuid "ad4b89d4-801b-51a5-9299-c541da6954c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186267708} {:answer/id #uuid "ee9364d1-6361-5047-8594-cb93beae9749" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186268265}] :answer-field/correct {:answer/id #uuid "ee9364d1-6361-5047-8594-cb93beae9749" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186268265} :answer-field/id #uuid "c87b8c31-bac0-55a7-9f5f-8efffda69a26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268767}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b8d94a83-3a6d-514a-949b-8d2d5e661234" :question/math-academy-id "q-13803" :question/problem "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int \\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{4}{u}^{2}+C \\\\  & =\\frac{1}{4}{ln}^{2}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028b5d24-5343-5712-ab0f-d2940e077210" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186266165} {:answer/id #uuid "2296eb71-af04-5c41-943c-a5d4e6ebc126" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡|x|+C" :db/id #edb/ref 17592186266454} {:answer/id #uuid "238496c5-76bc-51bf-9369-36c9de851713" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186266471} {:answer/id #uuid "47641199-4887-5f5e-986c-9437b93c2232" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186266781} {:answer/id #uuid "92224e92-8249-52e3-bd3f-d168ab26bf3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\operatorname{ln}⁡({x}^{2})+C" :db/id #edb/ref 17592186267447}] :answer-field/correct {:answer/id #uuid "238496c5-76bc-51bf-9369-36c9de851713" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C" :db/id #edb/ref 17592186266471} :answer-field/id #uuid "89bcc82a-73ac-56e2-ab50-09b7c5de2e1c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268651}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6641fae0-7624-5b24-b01b-edaaed427bd0" :question/math-academy-id "q-13807" :question/problem "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\operatorname{ln}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =\\frac{1}{3}\\int u\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{6}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{6}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{12}{u}^{2}+C \\\\  & =\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d002c74-ff20-553d-9136-17296c2d8d2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186266826} {:answer/id #uuid "8c5bd3ce-72c6-51a5-95b4-0077a28233d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}x\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186267398} {:answer/id #uuid "ba510d31-6337-529f-b283-89a45c84c928" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186267817} {:answer/id #uuid "bafa205e-e8d6-525e-bbe0-a6d46a971887" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186267822} {:answer/id #uuid "e9d0db79-ae5a-53ee-b446-50fcd6c6f54f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}x\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186268225}] :answer-field/correct {:answer/id #uuid "bafa205e-e8d6-525e-bbe0-a6d46a971887" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186267822} :answer-field/id #uuid "2e5a6b2e-ccb8-5317-92db-43476ba1348a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268486}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "78bb1805-2714-583b-b597-4f74cc851968" :question/math-academy-id "q-13808" :question/problem "Calculate the integral $\\int \\frac{5}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =5\\int \\frac{1}{\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{u}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{5}{2}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05babc80-2859-5f1a-8b0c-87dde6cecf89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186266195} {:answer/id #uuid "7521208c-37a3-5d02-8b01-1a8e8c876524" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186267176} {:answer/id #uuid "b2995bfc-506c-5873-9d39-f1d95af9a6cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186267741} {:answer/id #uu