+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290508 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59903832-ebd8-5edb-b89c-53f714cb7aef" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\operatorname{ln}⁡x}+C" :db/id #edb/ref 17592186288658} {:answer/id #uuid "6ad73b65-11fb-5224-8359-ee2d76b15c3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x}{x}+C" :db/id #edb/ref 17592186288785} {:answer/id #uuid "765d3c94-83e4-5457-8ab9-e63851a63232" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡(\\operatorname{ln}⁡x)}+C" :db/id #edb/ref 17592186288851} {:answer/id #uuid "7ba243c9-13ae-5910-9946-52e804848d87" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x+C" :db/id #edb/ref 17592186288877} {:answer/id #uuid "9e312fed-274b-51ee-a199-a566455e7e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{\\operatorname{ln}⁡(\\operatorname{ln}⁡x)}}{x}+C" :db/id #edb/ref 17592186289094}] :answer-field/correct {:answer/id #uuid "59903832-ebd8-5edb-b89c-53f714cb7aef" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\operatorname{ln}⁡x}+C" :db/id #edb/ref 17592186288658} :answer-field/id #uuid "6cc68702-a05a-5a30-bf9e-106a06c707fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289968}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f9ed1d83-c155-582f-82be-1fc779359a21" :question/math-academy-id "q-2380" :question/problem "Calculate the integral $\\int \\frac{1}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot \\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dae15a2-1ee3-5e1c-9740-88dbcb27308a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186295346} {:answer/id #uuid "21c52b8f-99f3-501e-b48b-11fa940e47fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186295455} {:answer/id #uuid "8339edfa-ac01-5a35-ba61-f72d13beb9e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{\\operatorname{ln}⁡x}+C" :db/id #edb/ref 17592186295971} {:answer/id #uuid "afde279f-b6c5-5153-a7ee-1486db54540c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186296193} {:answer/id #uuid "eaf9ca14-d6e0-59ec-bd95-95f8ca1bf1d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186296516}] :answer-field/correct {:answer/id #uuid "21c52b8f-99f3-501e-b48b-11fa940e47fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186295455} :answer-field/id #uuid "15bc6d3f-2f78-5fec-acf5-1f972668822a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296677}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7cf9e06a-68e3-56b4-9085-33ef355832a1" :question/math-academy-id "q-31398" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{2}{9}{u}^{3/2}+C \\\\  & =\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186374531 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129b807e-539b-5cac-a914-e2c7e71a90b8" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{\\operatorname{ln}⁡(9x)}+C" :db/id #edb/ref 17592186374533} {:answer/id #uuid "b35b7f1f-586a-5eb5-955d-dfd52ee42076" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{{ln}^{2}⁡(3{x}^{2})}+C" :db/id #edb/ref 17592186374534} {:answer/id #uuid "6755122b-5f86-5eff-94f0-2d7baf81b776" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{ln}^{3}⁡(9x)}+C" :db/id #edb/ref 17592186374535} {:answer/id #uuid "51fdb1e4-dced-512d-993c-1c3079295855" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{{ln}^{3}⁡(3x)}+C" :db/id #edb/ref 17592186374536} {:answer/id #uuid "d23abcb8-3caa-50f7-961e-747596cf16b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\sqrt{\\operatorname{ln}⁡(3x)}+C" :db/id #edb/ref 17592186374537}] :answer-field/correct {:answer/id #uuid "51fdb1e4-dced-512d-993c-1c3079295855" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{{ln}^{3}⁡(3x)}+C" :db/id #edb/ref 17592186374536} :answer-field/id #uuid "26fad09b-23ab-5b9a-8576-81bb56e1bd61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374532}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9ee01988-486e-562a-9b69-5957be021102" :question/math-academy-id "q-210743" :question/problem "Calculate the integral $\\int \\frac{9\\sqrt{\\operatorname{ln}⁡(3x)}}{x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{9\\sqrt{\\operatorname{ln}⁡(3x)}}{x}\\,\\text{d}x & =9\\int \\sqrt{\\operatorname{ln}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =9\\int \\sqrt{u}\\,\\text{d}u \\\\  & =9\\int {u}^{1/2}\\,\\text{d}u \\\\  & =9\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =6{u}^{3/2}+C \\\\  & =6\\sqrt{{ln}^{3}⁡(3x)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f423be97-7cf1-5892-a889-cd6b8dad197b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡|\\operatorname{ln}⁡x|}+C" :db/id #edb/ref 17592186401889} {:answer/id #uuid "a1be16c0-5889-5190-9b94-52c61fcd25d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186401890} {:answer/id #uuid "e01f3245-4ea5-537d-ba0e-1dda5e71ae4e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(\\operatorname{ln}⁡\\sqrt{2})+C" :db/id #edb/ref 17592186401891} {:answer/id #uuid "0802bc99-bb18-5591-b8e0-f242435e7f0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186401892} {:answer/id #uuid "99159f55-3655-56b7-986e-53df7b0da90a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{\\operatorname{ln}⁡|\\operatorname{ln}⁡x|}+C" :db/id #edb/ref 17592186401893}] :answer-field/correct {:answer/id #uuid "0802bc99-bb18-5591-b8e0-f242435e7f0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186401892} :answer-field/id #uuid "0ff01c23-3bf9-54e8-b3ae-815e53dd5059" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401888}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6e0472f6-3d3e-5a0e-bbc2-09db07e6e756" :question/math-academy-id "q-2194" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{2}}{x\\operatorname{ln}⁡x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{2}}{x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\sqrt{2}\\int \\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\sqrt{2}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\sqrt{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186441898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51f5ec9c-cf1f-5d72-a5d8-f8dc65eacd30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186441879} {:answer/id #uuid "83e83f58-9225-53a6-8e6a-f42f69406481" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\sqrt{3}\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186441884} {:answer/id #uuid "be58a7fb-a086-5860-ad30-dd1c817fbd59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186441887} {:answer/id #uuid "dac76dc6-a248-5bf4-bc16-bc99e472f0d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186441890} {:answer/id #uuid "eb90fc15-7950-575d-a8ff-31fa8bd25ec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186441893}] :answer-field/correct {:answer/id #uuid "dac76dc6-a248-5bf4-bc16-bc99e472f0d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C" :db/id #edb/ref 17592186441890} :answer-field/id #uuid "a0f12e38-1619-5468-ac12-872947123f4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186441896}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "814f2ed7-2079-5a15-870f-7b1832892ba3" :question/math-academy-id "q-210748" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{3}}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{3}}{x\\operatorname{ln}⁡({x}^{2})}\\,\\text{d}x & =\\sqrt{3}\\int \\frac{1}{\\operatorname{ln}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\sqrt{3}\\int \\frac{1}{u}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{\\sqrt{3}}{2}\\int \\frac{\\text{d}u}{u} \\\\  & =\\frac{\\sqrt{3}}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{\\sqrt{3}}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡({x}^{2})|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186441899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cdc4e41-1390-58a2-bac1-3d5ad6ed32e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{ln}⁡(x)|+C" :db/id #edb/ref 17592186441875} {:answer/id #uuid "383da31d-fae5-528c-b771-c06390c58c47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/id #edb/ref 17592186441877} {:answer/id #uuid "9a132687-cf9b-5e12-8918-cb54c98b6670" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(3x)+C" :db/id #edb/ref 17592186441886} {:answer/id #uuid "d129af00-45fd-56b1-bfbc-bbc2b9c9a339" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/id #edb/ref 17592186441889} {:answer/id #uuid "e2371163-1bcf-5101-ab68-2260fe787c84" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/id #edb/ref 17592186441891}] :answer-field/correct {:answer/id #uuid "d129af00-45fd-56b1-bfbc-bbc2b9c9a339" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/id #edb/ref 17592186441889} :answer-field/id #uuid "edd22d9f-f6c6-5c79-8b35-f5d0306c51e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186441897}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cc39d04c-8fc6-5458-bd77-d57b514616c4" :question/math-academy-id "q-13822" :question/problem "Calculate the integral $\\int \\frac{1}{3x\\operatorname{ln}⁡(3x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x\\operatorname{ln}⁡(3x)}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{\\operatorname{ln}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] [{:db/id #edb/ref 17592186100817 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100609 :question/id #uuid "1579f932-6e7f-5daa-b001-54a9f6c236ad" :question/math-academy-id "e-14406" :question/problem "Calculate the integral $\\displaystyle \\int \\dfrac{\\log^2_3 x }{x} \\,\\textrm d x.$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\dfrac{(\\log_3 x)^2 }{x} \\,\\textrm d x.\n$$\n\nLet $u=\\log_3 x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{x\\ln 3}\\quad\\Longrightarrow\\quad\\ln 3\\,\\textrm d u = \\dfrac 1 x \\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{({log}_{3}⁡x)^{2}}{x}\\,\\text{d}x & =\\int ({log}_{3}⁡x)^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int {u}^{2}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{1}{3}{u}^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3({log}_{3}⁡x)^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3{log}_{3}^{3}⁡x+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/questions [{:db/id #edb/ref 17592186101371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097bf9be-35d0-5117-aeeb-185f65a4e444" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot \\frac{{log}_{2}⁡x}{2}+C" :db/id #edb/ref 17592186295316} {:answer/id #uuid "0c595f3e-4a64-5335-bfee-ef4f9c199d44" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186295335} {:answer/id #uuid "3a9d8072-eeac-5190-ac53-423bbc5c0d15" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}⁡x}{2}+C" :db/id #edb/ref 17592186295602} {:answer/id #uuid "7c854fd3-91d0-5ade-bfec-4aa656855a88" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡x\\cdot \\frac{{log}_{2}^{2}⁡x}{x}+C" :db/id #edb/ref 17592186295948} {:answer/id #uuid "943f1ef0-98c7-561c-8c98-1ab90aa0f4c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296059}] :answer-field/correct {:answer/id #uuid "943f1ef0-98c7-561c-8c98-1ab90aa0f4c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C" :db/id #edb/ref 17592186296059} :answer-field/id #uuid "94521d82-e55e-520c-aa39-65e9dae6d07e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296944}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bc1950d7-cc9c-5e9a-8f86-5dcc05de2e91" :question/math-academy-id "q-31329" :question/problem "$\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x & =\\int {log}_{2}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101374 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27327c99-efb7-58e8-a74e-787cf861a36a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295482} {:answer/id #uuid "87c24d2f-2c74-5040-90ac-f36195ad44b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295999} {:answer/id #uuid "9bd76f53-ed5e-50ea-9b0a-4825cbde5b04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{3}^{2}⁡x}{4}+C" :db/id #edb/ref 17592186296097} {:answer/id #uuid "cee39ee1-4f54-5380-b841-9cb4997a9fd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({x}^{2}){log}_{3}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296353} {:answer/id #uuid "e80a0ef7-8043-5002-b2dc-df0cdf73346a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186296500}] :answer-field/correct {:answer/id #uuid "87c24d2f-2c74-5040-90ac-f36195ad44b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186295999} :answer-field/id #uuid "91e8e1d5-6ca1-583b-a916-cb7fac5a8d3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296934}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d8e9ea16-ddaf-5f82-ac82-079325b04f6b" :question/math-academy-id "q-31401" :question/problem "$\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡({x}^{2}).$Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡3}\\,⟹\\,\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{3}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\int u\\cdot \\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186101536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383be394-a41f-5e0f-b93b-a0ff9878be08" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡{x}^{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186339635} {:answer/id #uuid "750a3dcf-e361-507f-ad62-9dbb75727d78" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡4\\operatorname{ln}⁡|{log}_{7}⁡x|+C" :db/id #edb/ref 17592186340176} {:answer/id #uuid "aa31712a-2e4f-527b-a00c-e331135a4450" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186340682} {:answer/id #uuid "dc05d22a-2a20-518f-afa3-1ccc9267a967" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡({x}^{4})|+C" :db/id #edb/ref 17592186341082} {:answer/id #uuid "e0868377-7786-5248-883a-b568427cad5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186341122}] :answer-field/correct {:answer/id #uuid "e0868377-7786-5248-883a-b568427cad5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C" :db/id #edb/ref 17592186341122} :answer-field/id #uuid "aff887c8-fb12-5cba-942f-5f6c84cf518a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341687}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254254b3-d4a0-54c9-ac1e-ee05acbabc64" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}⁡x+C" :db/id #edb/ref 17592186247752} {:answer/id #uuid "44cdb3aa-54aa-5e3d-91cc-188c8ad81e29" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248039} {:answer/id #uuid "47d6d603-3f64-5f3d-9792-34e35a52deb8" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248064} {:answer/id #uuid "54647379-fd57-5c64-be8d-ab2381cdcfe3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248182} {:answer/id #uuid "a149b29b-935e-5e8f-910f-3a39f1539f77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248865}] :answer-field/correct {:answer/id #uuid "44cdb3aa-54aa-5e3d-91cc-188c8ad81e29" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186248039} :answer-field/id #uuid "7570be9b-8fa8-53ff-853e-6ff96a771057" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249870}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5c740bb4-ff2e-5c3c-8f3d-5a68fa36c853" :question/math-academy-id "q-114020" :question/problem "$\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "225507dc-148f-5a6f-94ae-b671ee8c43a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186247730} {:answer/id #uuid "a28decf6-e50f-5cd8-a481-bb4b6ce53e6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186248876} {:answer/id #uuid "f0a219d2-19b3-55a0-a684-551ff9a54e4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}⁡x+C" :db/id #edb/ref 17592186249538} {:answer/id #uuid "fa1f8080-6e0f-5732-9038-7a2a1a9a5eb8" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17