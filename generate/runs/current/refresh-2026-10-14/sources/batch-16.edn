 & 2\\cdot (-2) \\\\ 2\\cdot (-2) & 2\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -1 \\\\ -1 & 0\\end{bmatrix}+\\begin{bmatrix}0 & -4 \\\\ -4 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3+0 & -1+(-4) \\\\ -1+(-4) & 0+4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a6d9c98-0d36-5c8c-88d6-f29f7189dc93" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298010}] :answer-field/correct {:answer/id #uuid "6a6d9c98-0d36-5c8c-88d6-f29f7189dc93" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186298010} :answer-field/id #uuid "70257ab0-a556-5053-9433-85fc9778f431" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299016} {:answer-field/choices [{:answer/id #uuid "6a0e90e7-1f3e-5b6b-84b6-2b5faa9af3c4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298007}] :answer-field/correct {:answer/id #uuid "6a0e90e7-1f3e-5b6b-84b6-2b5faa9af3c4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298007} :answer-field/id #uuid "8045faa8-8bb2-5d93-891e-841546247f14" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299072} {:answer-field/choices [{:answer/id #uuid "44fd0c6e-d854-58df-95cb-a0a90567c1d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297835}] :answer-field/correct {:answer/id #uuid "44fd0c6e-d854-58df-95cb-a0a90567c1d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297835} :answer-field/id #uuid "b8fe989e-dadb-5348-aa38-7751bf6cd3b3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299264} {:answer-field/choices [{:answer/id #uuid 