:answer-field/choices [{:answer/id #uuid "5380e4f7-3997-5eec-a4c1-2dd08757f0a2" :answer/type {:db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186297904}] :answer-field/correct {:answer/id #uuid "5380e4f7-3997-5eec-a4c1-2dd08757f0a2" :answer/type {:db/ident :answer.type/math} :answer/value "-52" :db/id #edb/ref 17592186297904} :answer-field/id #uuid "2488bf7b-4c5f-5b36-8cbb-ca49d28d8bf9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298761} {:answer-field/choices [{:answer/id #uuid "07a31a1b-94aa-5cea-9846-cc139c0dc4ab" :answer/type {:db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186297589}] :answer-field/correct {:answer/id #uuid "07a31a1b-94aa-5cea-9846-cc139c0dc4ab" :answer/type {:db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186297589} :answer-field/id #uuid "8ab1180c-fa05-5dcf-b73c-82d0a580b13c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299102} {:answer-field/choices [{:answer/id #uuid "27f662dc-9756-5093-86b7-94ddad217ede" :answer/type {:db/ident :answer.type/math} :answer/value "-182" :db/id #edb/ref 17592186297722}] :answer-field/correct {:answer/id #uuid "27f662dc-9756-5093-86b7-94ddad217ede" :answer/type {:db/ident :answer.type/math} :answer/value "-182" :db/id #edb/ref 17592186297722} :answer-field/id #uuid "a09c47e6-4da3-5f54-947d-4183a7d968e3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299170}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5aecc675-116f-5b56-855b-8a2ff5a85c00" :question/math-academy-id "q-319943" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-3 \\\\ 2 \\\\ 7\\end{bmatrix},\\,B=\\begin{bmatrix}5 & -1\\end{bmatrix},\\,C=\\begin{bmatrix}-4 \\\\ 6\\end{bmatrix}.\n$$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $ABC=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 1$ matrix, $B$ is a $1\\times 2$ matrix, and $C$ is a $2\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 2$ matrix, which will require finding $6$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =\\begin{bmatrix}5 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-4 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-20-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-26\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}-3 \\\\ 2 \\\\ 7\\end{bmatrix}\\cdot \\begin{bmatrix}-26\\end{bmatrix} \\\\  & =\\begin{bmatrix}78 \\\\ -52 \\\\ -182\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6482cff8-ea84-5d14-a24d-9034a0c7b0a1" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186297981}] :answer-field/correct {:answer/id #uuid "6482cff8-ea84-5d14-a24d-9034a0c7b0a1" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186297981} :answer-field/id #uuid "24506a77-9b74-5997-b750-9ae0f37f53de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298759} {:answer-field/choices [{:answer/id #uuid "4004e514-65cc-5ba3-8951-7fdfa32a9481" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186297805}] :answer-field/correct {:answer/id #uuid "4004e514-65cc-5ba3-8951-7fdfa32a9481" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186297805} :answer-field/id #uuid "4fb3cc92-18ef-57d1-8cf8-4873a0f63452" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298907} {:answer-field/choices [{:answer/id #uuid "67ac13fb-5f80-5b63-8caf-0023f6f87094" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186297998}] :answer-field/correct {:answer/id #uuid "67ac13fb-5f80-5b63-8caf-0023f6f87094" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186297998} :answer-field/id #uuid "d1529332-216e-5593-b381-6e2408117b50" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299347}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "34cd5f5a-f82e-5ae5-899e-5e1bd32cf8b9" :question/math-academy-id "q-320021" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}6 & -2\\end{bmatrix},\\,B=\\begin{bmatrix}-1 \\\\ 3\\end{bmatrix},\\,C=\\begin{bmatrix}2 & -4 & 5\\end{bmatrix}.\n$$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\">$ABC=\\,\\,$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 1$ matrix, which will require finding only $1$ entry, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}6 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}-1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6\\cdot (-1)+(-2)\\cdot 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $(AB)$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)\\,C \\\\  & =\\begin{bmatrix}-12\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -4 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 & 48 & -60\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e9a8c05-e895-5db2-be21-7ff8a989939a" :answer/type {:db/ident :answer.type/math} :answer/value "-58" :db/id #edb/ref 17592186298101}] :answer-field/correct {:answer/id #uuid "7e9a8c05-e895-5db2-be21-7ff8a989939a" :answer/type {:db/ident :answer.type/math} :answer/value "-58" :db/id #edb/ref 17592186298101} :answer-field/id #uuid "298a71ad-58e1-55a8-a4ab-0720f04e5f75" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298777} {:answer-field/choices [{:answer/id #uuid "5f7e0eae-c541-5188-8a63-03a909e42ee0" :answer/type {:db/ident :answer.type/math} :answer/value "136" :db/id #edb/ref 17592186297954}] :answer-field/correct {:answer/id #uuid "5f7e0eae-c541-5188-8a63-03a909e42ee0" :answer/type {:db/ident :answer.type/math} :answer/value "136" :db/id #edb/ref 17592186297954} :answer-field/id #uuid "a531995d-b29d-5426-9f4b-9a89a67a333f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299192}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7d60a4e0-4fdb-56f1-b62d-65e7bbd5fd84" :question/math-academy-id "q-320026" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-4 & 6\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -1 \\\\ 3 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 \\\\ -2 & 4\\end{bmatrix}.\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-4 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -1 \\\\ 3 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 34\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}10 & 34\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ -2 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-58 & 136\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186326920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0768e386-ed42-523a-8b81-d32778b33888" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & 18 & 9 \\\\ 21 & 7 & -42 \\\\ 8 & 2 & -6\\end{bmatrix}" :db/id #edb/ref 17592186324039} {:answer/id #uuid "5765f40b-6dcf-5301-9949-f4819aec1ba2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 \\\\ 42 \\\\ 9\\end{bmatrix}" :db/id #edb/ref 17592186324697} {:answer/id #uuid "8bca11ec-165a-537d-b134-38df44b671e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 & 0 & 0 \\\\ 18 & 9 & -42 \\\\ 4 & 0 & -8\\end{bmatrix}" :db/id #edb/ref 17592186325158} {:answer/id #uuid "a36dc3f4-9f65-59e6-9311-6f889cfc4cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186325358} {:answer/id #uuid "f31eb4fa-cff2-5b17-9422-8db3c6117a17" :answer/type {:db/ident :answer.type/math} :answer/value "-144" :db/id #edb/ref 17592186326112}] :answer-field/correct {:answer/id #uuid "a36dc3f4-9f65-59e6-9311-6f889cfc4cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}" :db/id #edb/ref 17592186325358} :answer-field/id #uuid "b79923e4-1da4-5e24-8a5e-c420b9db32e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326548}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0594dca0-de16-5429-abef-c4b9b45aec7e" :question/math-academy-id "q-42001" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\,C=\\begin{bmatrix}-2 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 \\\\ -21 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}9 \\\\ -21 \\\\ -4\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186326921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d6f5d49-745b-5ede-bd5a-5fba9ad228e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ 24 \\\\ 36\\end{bmatrix}" :db/id #edb/ref 17592186324875} {:answer/id #uuid "80a1cf50-d570-5721-9f08-cde570f35644" :answer/type