/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}" :db/id #edb/ref 17592186326192}] :answer-field/correct {:answer/id #uuid "fc705767-f381-5ed0-ad93-5efbdbb99971" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}" :db/id #edb/ref 17592186326192} :answer-field/id #uuid "ec730f37-5c2e-54b5-bbb4-1fd945357ac7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326647}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fc71896c-5daf-5e26-9560-8339a3f927a3" :question/math-academy-id "q-41979" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}0 & 1 & 0\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{bmatrix}.$" :question/worked-solution "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}.\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 & 1 & 0\\end{bmatrix}\\begin{bmatrix}4\\sqrt{2} & 1.5 & 2 \\\\ -3.5 & -2\\sqrt{3} & -3 \\\\ 1 & 4 & -\\sqrt{5}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3.5 & -2\\sqrt{3} & -3\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cd465a5-2228-506e-85ae-bca8f7b15782" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186392437} {:answer/id #uuid "89c7f214-2178-5237-aa70-418be548a79a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ 3\\sqrt{2} \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186392438} {:answer/id #uuid "b9584a78-324d-5402-b9dd-9340417fbdbe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 3\\sqrt{2} & 2\\end{bmatrix}" :db/id #edb/ref 17592186392439} {:answer/id #uuid "9dfc011c-f3fc-50b6-918e-d5e364adfbb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{3} \\\\ -5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186392440} {:answer/id #uuid "f8d7fd08-e9dc-5175-be41-5413c7de1648" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{3} & -5 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392441}] :answer-field/correct {:answer/id #uuid "2cd465a5-2228-506e-85ae-bca8f7b15782" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}" :db/id #edb/ref 17592186392437} :answer-field/id #uuid "04d1601d-b94a-56ad-af90-0c952d160d14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392436}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7d52bfbe-0cf7-5e74-a083-e7db8c4ef851" :question/math-academy-id "q-41943" :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$" :question/worked-solution "Notice that $B$ is the $3$rd *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $3$rd *column* of the identity matrix ${I}_{3}$, the result must be the $3$rd column of $A.$ Therefore,\n\n$$\nAB=\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}.\n$$\n\n \n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{3}\\cdot 0+(-5)\\cdot 0+5\\cdot 1 \\\\ (-5)\\cdot 0+3\\sqrt{2}\\cdot 0+(-3.5)\\cdot 1 \\\\ 1\\cdot 0+2\\cdot 0+(-4\\sqrt{5})\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 \\\\ -3.5 \\\\ -4\\sqrt{5}\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] [{:db/id #edb/ref 17592186115226 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115056 :question/id #uuid "32bd6b27-e95d-5de4-941f-309eb0bc61f1" :question/math-academy-id "e-4411" :question/problem "Find $AB-CB,$ where\n![](images/b4/b4b5ccc4e5075ba81dc840743f0267ba2e5f28d75a5be09de54df111203b949a.svg)" :question/worked-solution "We can apply the distributive law\n\n$$\nAB-CB=(A-C)B.\n$$\n\nSo, we calculate $A-C$ first:\n\n$$\n\\begin{aligned}A-C & =\\begin{bmatrix}2 & 4 & -3 \\\\ -1 & -5 & 3 \\\\ -2 & 0 & 7\\end{bmatrix}-\\begin{bmatrix}3 & 4 & -3 \\\\ -1 & -4 & 3 \\\\ -2 & 0 & 8\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix} \\\\  & =-{I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB-CB & =(A-C)B \\\\  & =-{I}_{3}B \\\\  & =-B \\\\  & =\\begin{bmatrix}-\\sqrt{2} & -\\sqrt{3} & 45 \\\\ -81 & \\sqrt{5} & 2 \\\\ -2 & -1 & -\\sqrt{3}\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050407 :topic/math-academy-id 1196 :topic/title "Multiplying Matrices"} {:db/id #edb/ref 17592186051079 :topic/math-academy-id 87 :topic/title "Factoring Linear Expressions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186115829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9607e1e7-f8ac-53de-9908-c1f571a0116f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{2} & -\\sqrt{3} & -1 \\\\ -\\sqrt{5} & -\\sqrt{6} & -1 \\\\ -\\sqrt{7} & -\\sqrt{2} & -1\\end{bmatrix}" :db/id #edb/ref 17592186113912} {:answer/id #uuid "a6768771-f5b7-548e-999b-f6902415943b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186113913} {:answer/id #uuid "3fb0f0a6-006f-5c75-b1b8-e221a96e83b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186113914} {:answer/id #uuid "44d07522-65f1-56fb-9042-731bbe25d2a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{2} & 2\\sqrt{3} & 2 \\\\ 2\\sqrt{5} & 2\\sqrt{6} & 2 \\\\ 2\\sqrt{7} & 2\\sqrt{2} & 2\\end{bmatrix}" :db/id #edb/ref 17592186113915} {:answer/id #uuid "7d1284d9-c607-5679-ad2a-4ed9873a1875" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{2} & \\sqrt{3} & 1 \\\\ \\sqrt{5} & \\sqrt{6} & 1 \\\\ \\sqrt{7} & \\sqrt{2} & 1\\end{bmatrix}" :db/id #edb/ref 17592186113916}] :answer-field/id #uuid "80098924-46d2-51df-aebc-a0350ae533b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113911}] :question/id #uuid "9796bb85-e5f6-55ad-ade8-918ae279a8e2" :question/math-academy-id "q-42004" :question/problem "Calculate $BA + BC$, where\n$A = \\begin{bmatrix}4 & 2 & -1 \\\\ 2 & -5 & 3 \\\\ -3 & 1 & 2\\end{bmatrix}, B = \\begin{bmatrix}\\sqrt{2} & \\sqrt{3} & 1 \\\\ \\sqrt{5} & \\sqrt{6} & 1 \\\\ \\sqrt{7} & \\sqrt{2} & 1\\end{bmatrix}, C = \\begin{bmatrix}-4 & -2 & 1 \\\\ -2 & 5 & -3 \\\\ 3 & -1 & -2\\end{bmatrix}$."} {:db/id #edb/ref 17592186115836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13773284-d540-59d5-9332-97c84b837ffe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\sqrt{2} & 1 & \\sqrt{3} \\\\ 1 & \\sqrt{5} & 1 \\\\ \\sqrt{7} & 1 & \\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186484855} {:answer/id #uuid "a397a770-fb84-5803-b445-bb962f0edcc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\sqrt{2} & -1 & -\\sqrt{3} \\\\ -1 & -\\sqrt{5} & -1 \\\\ -\\sqrt{7} & -1 & -\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186485172} {:answer/id #uuid "bd233e28-d1ff-5b24-a20c-c4ce4f8e0913" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186485224} {:answer/id #uuid "ca909ceb-d495-5fda-9394-cd7bfc79f6cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\sqrt{2} & -2 & -2\\sqrt{3} \\\\ -2 & -2\\sqrt{5} & -2 \\\\ -2\\sqrt{7} & -2 & -2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186485248} {:answer/id #uuid "d61c9def-9523-5682-a82f-7beb698de51e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{bmatrix}" :db/id #edb/ref 17592186485266}] :answer-field/correct {:answer/id #uuid "ca909ceb-d495-5fda-9394-cd7bfc79f6cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2\\sqrt{2} & -2 & -2\\sqrt{3} \\\\ -2 & -2\\sqrt{5} & -2 \\\\ -2\\sqrt{7} & -2 & -2\\sqrt{2}\\end{bmatrix}" :db/id #edb/ref 17592186485248} :answer-field/id #uuid "5acf797e-8560-5305-87b5-ad22ffde0a24" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113953}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "008d2c2b-6bdc-5e16-92ee-368e3b3e4390" :question/math-academy-id "q-42263" :question/problem "Find $AB+CB$, where\n\n$$\nA=\\begin{bmatrix}3 & 2 & 1 \\\\ 1 & -5 & -1 \\\\ -9 & 10 & 11\\end{bmatrix},\\,B=\\begin{bmatrix}\\sqrt{2} & 1 & \\sqrt{3} \\\\ 1 & \\sqrt{5} & 1 \\\\ \\sqrt{7} & 1 & \\sqrt{2}\\end{bmatrix},\\,C=\\begin{bmatrix}-5 & -2 & -1 \\\\ -1 & 3 & 1 \\\\ 9 & -10 & -13\\end{bmatrix}.\n$$" :question/worked-solution "We apply the distributive law\n\n$$\nAB+CB=(A+C)B.\n$$\n\nSo, we calculate $A+C$ first:\n\n$$\n\\begin{aligned}A+C & =\\begin{bmatrix}3 & 2 & 1 \\\\ 1 & -5 & -1 \\\\ -9 & 10 & 11\\end{bmatrix}+\\begin{bmatrix}-5 & -2 & -1 \\\\ -1 & 3 & 1 \\\\ 9 & -10 & -13\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{bmatrix} \\\\  & =-2{I}_{3}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+CB & =(A+C)B \\\\  & =-2{I}_{3}B \\\\  & =-2B \\\\  & =\\begin{bmatrix}-2\\sqrt{2} & -2 & -2\\sqrt{3} \\\\ -2 & -2\\sqrt{5} & -2 \\\\ -2\\sqrt{7} & -2 & -2\\sqrt{2}\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83e8b5b8-2dc6-502f-9895-61592963799f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234745}] :answer-field/correct {:answer/id #uuid "83e8b5b8-2dc6-502f-9895-61592963799f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234745} :answer-field/id #uuid "73f19ed8-00ca-518c-b9b0-9aa8b5d98ca5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235100} {:answer-field/choices [{:answer/id #uuid "e3d714a7-0082-5d4f-ab9a-17597b16c336" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234904}] :answer-field/correct {:answer/id #uuid "e3d714a7-0082-5d4f-ab9a-17597b16c336" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234904} :answer-field/id #uuid "8eddebdf-1405-58bc-9c0f-2eb87f83aa52" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235144} {:answer-field/choices [{:answer/id #uuid "c56147c9-f2b7-5667-be10-7a59be78f3d8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234854}] :answer-field/correct {:answer/id #uuid "c56147c9-f2b7-5667-be10-7a59be78f3d8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234854} :answer-field/id #uuid "d733dbe9-c554-5e94-95f1-066ae833b632" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235234} {:answer-field/choices [{:answer/id #uuid "dd65aedc-568a-52b0-80dd-3058db6f72f6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186234893}] :answer-field/correct {:answer/id #uuid "dd65aedc-568a-52b0-80dd-3058db6f72f6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186234893} :answer-field/id #uuid "f602e10d-959a-555e-a86b-ac99268e9349" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235267}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "27a916f2-ae5e-57d0-a97a-ec9cecb80707" :question/math-academy-id "q-138783" :question/problem "$$\nX+Y=\\begin{bmatrix}-3 & 0 \\\\ 1 & -1\\end{bmatrix}\\,Z=\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix}\n$$\n\nConsider the matrices above. Knowing that the matrix representation $T=\\begin{bmatrix}{t}_{11} & {t}_{12} \\\\ {t}_{21} & {t}_{22}\\end{bmatrix}$ of a linear transformation $T$ is given by\n\n$$\nT=XZ+YZ,\n$$\n\nfind the values ${t}_{ij}.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${t}_{11}=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,{t}_{12}=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                                \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${t}_{21}=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-3}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,{t}_{22}=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-4}}" :question/worked-solution "We apply the distributive law\n\n$$\nXZ+YZ=(X+Y)Z.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T & =XZ+YZ \\\\  & =(X+Y)Z \\\\  & =\\begin{bmatrix}-3 & 0 \\\\ 1 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 0 \\\\ 2 & -1\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "306bf8f6-3b52-5e8e-b8