n{bmatrix}3 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =\\begin{bmatrix}-2 \\\\ 4 \\\\ 6\\end{bmatrix}\\cdot \\begin{bmatrix}6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-12 \\\\ 24 \\\\ 36\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc44afbe-5d76-5e09-9981-f46801ba7f6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5\\end{bmatrix}" :db/id #edb/ref 17592186392450} {:answer/id #uuid "52743f64-5575-5f50-ab83-057fdf07b94a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186392451} {:answer/id #uuid "56be43e4-cbda-5ce6-b53d-23acb1dfe969" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & -3 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186392452} {:answer/id #uuid "77068922-3e71-5bec-a56b-febc23200124" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186392453} {:answer/id #uuid "55501deb-48c2-5461-b4b5-3c1803f7a5f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5 \\\\ 1 & 4\\end{bmatrix}" :db/id #edb/ref 17592186392454}] :answer-field/correct {:answer/id #uuid "bc44afbe-5d76-5e09-9981-f46801ba7f6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 5\\end{bmatrix}" :db/id #edb/ref 17592186392450} :answer-field/id #uuid "fb19f32f-0991-5b71-b98c-bdea9bdda5e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392449}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54c6b58b-7b12-5b44-8e47-3a85c2ee0cea" :question/math-academy-id "q-41981" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-3 & 5\\end{bmatrix},\\,B=\\begin{bmatrix}1 & 3 \\\\ 1 & 4\\end{bmatrix},\\,C=\\begin{bmatrix}4 & -3 \\\\ -1 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-3 & 5\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 3 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 11\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}2 & 11\\end{bmatrix}\\cdot \\begin{bmatrix}4 & -3 \\\\ -1 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e619a67-9c5c-5198-a6e6-8fe2cae308d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}55 \\\\ -21 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186392503} {:answer/id #uuid "26af411f-4369-55ad-9e9b-e90514a5bcc0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-68 \\\\ -22 \\\\ 50\\end{bmatrix}" :db/id #edb/ref 17592186392504} {:answer/id #uuid "d5580b66-a310-537c-a0c5-a20457678669" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-68 \\\\ -22 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186392505} {:answer/id #uuid "45d96025-8f3a-50af-9de9-cd071e5ec232" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}68 \\\\ -22 \\\\ 40\\end{bmatrix}" :db/id #edb/ref 17592186392506} {:answer/id #uuid "a3df1fc7-14b6-532e-b12c-6343f041272c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{b