gned}B+C & =\\begin{bmatrix}-1 & 1 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}+\\begin{bmatrix}-2 & \\sqrt{3}-1 & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-3 & \\sqrt{3} & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AB+AC & =A(B+C) \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\begin{bmatrix}-3 & \\sqrt{3} & 2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ -3 & \\sqrt{3} & 2 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299807 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef007d40-b791-53aa-9b40-72f91b2d419b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298568}] :answer-field/correct {:answer/id #uuid "ef007d40-b791-53aa-9b40-72f91b2d419b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298568} :answer-field/id #uuid "0deed4f2-dd64-5c96-b18e-c5f0a491debe" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298685} {:answer-field/choices [{:answer/id #uuid "b68de8a1-8c59-5236-9114-1c38de17959a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298346}] :answer-field/correct {:answer/id #uuid "b68de8a1-8c59-5236-9114-1c38de17959a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298346} :answer-field/id #uuid "37adcf6c-936c-5af6-a7dd-0a90083d1d39" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298828} {:answer-field/choices [{:answer/id #uuid "f6888e5b-7ee3-5beb-a34c-d2d2512e9509" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298605}] :answer-field/correct {:answer/id #uuid "f6888e5b-7ee3-5beb-a34c-d2d2512e9509" :answer/type {:db/ident :answer.type/m