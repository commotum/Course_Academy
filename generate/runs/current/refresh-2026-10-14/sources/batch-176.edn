99808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9da96a1-344c-5f5e-a46c-8a86b727fdf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298547}] :answer-field/correct {:answer/id #uuid "e9da96a1-344c-5f5e-a46c-8a86b727fdf5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298547} :answer-field/id #uuid "116521de-0adb-5a98-b423-99337450df86" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298701} {:answer-field/choices [{:answer/id #uuid "71d4223f-d072-595c-a7da-6966340f5b77" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298043}] :answer-field/correct {:answer/id #uuid "71d4223f-d072-595c-a7da-6966340f5b77" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298043} :answer-field/id #uuid "be4a571d-2431-5458-90ca-a3137f93b385" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299280} {:answer-field/choices [{:answer/id #uuid "b7b4551c-d1bf-5252-92e7-1c4fc58579a6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298350}] :answer-field/correct {:answer/id #uuid "b7b4551c-d1bf-5252-92e7-1c4fc58579a6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298350} :answer-field/id #uuid "c3ea6bc8-213a-5fdb-837a-90f9b0b85525" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299296} {:answer-field/choices [{:answer/id #uuid "3c914a12-9a64-5c33-9b56-bd3e968832ee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297792}] :answer-field/correct {:answer/id #uuid "3c914a12-9a64-5c33-9b56-bd3e968832ee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297792} :answer-field/id #uuid "e2b94e82-5ae7-58f3-8f79