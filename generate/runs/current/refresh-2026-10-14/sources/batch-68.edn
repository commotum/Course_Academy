ype/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267118} {:answer/id #uuid "9a78f2b9-be60-5dd9-a1b2-d3dae91c37e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186267540} {:answer/id #uuid "a54496d0-737c-5f0e-b323-1106d3723e9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186267634} {:answer/id #uuid "da3d8464-42f7-59e9-bbc9-ba3a5c255583" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186268077}] :answer-field/correct {:answer/id #uuid "2bba42d0-4d22-55d1-bf2a-5afa7f154545" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266532} :answer-field/id #uuid "464dd787-aac1-5fd3-8b68-a426f70499c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268525}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5d3c5f6c-be88-5a7d-88c2-f5f9124aa97d" :question/math-academy-id "q-13533" :question/problem "${\\int }_{0}^{\\sqrt{\\pi /2}}5x\\operatorname{cos}⁡(2{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Let $u=2{x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\text{d}u=x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi /2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi $ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi /2}}5x\\operatorname{cos}⁡(2{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi /2}}5\\operatorname{cos}⁡(2{x}^{2})\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }5\\operatorname{cos}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{5}{4}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{5}{4}\\operatorname{sin}⁡u{|}_{0}^{\\pi } \\\\  & =\\frac{5}{4}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{5}{4}(0) \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573778d5-04ef-570b-bb92-30f2581d353a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186266920} {:answer/id #uuid "853703e3-5ee8-58a7-a762-0b6b51b9da3b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267318} {:answer/id #uuid "8a690975-9629-524f-8754-019e655cbcf7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267378} {:answer/id #uuid "b4e7245c-ae8f-576f-ad7b-ae3e6def801c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186267761} {:answer/id #uuid "c5d49c16-cf0d-5d32-ac21-f912a3f35a4f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267918}] :answer-field/correct {:answer/id #uuid "c5d49c16-cf0d-5d32-ac21-f912a3f35a4f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267918} :answer-field/id #uuid "d8a52cc8-a59a-5790-8e07-7483e8b8eee9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268791}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f9af6a27-d8cc-5d10-84b4-1e204dd24944" :question/math-academy-id "q-13537" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{\\pi }}3x\\operatorname{sin}⁡(2{x}^{2})\\,\\text{d}x.$" :question/worked-solution "Let $u=2{x}^{2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x\\,⟹\\,\\frac{1}{4}\\text{d}u=x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi }$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2\\pi $ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi }}3x\\operatorname{sin}⁡(2{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi }}3\\operatorname{sin}⁡(2{x}^{2})\\cdot x\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }3\\operatorname{sin}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{3}{4}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{3}{4}\\operatorname{cos}⁡u{|}_{0}^{2\\pi } \\\\  & =-\\frac{3}{4}(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{3}{4}(1-1) \\\\  & =-\\frac{3}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4675341d-47de-58d1-9169-e4ea300f6534" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡(\\frac{1}{x})+C" :db/id #edb/ref 17592186295666} {:answer/id #uuid "49060b70-8ca0-5560-a25f-c33fdf13abe5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(\\frac{1}{x})+C" :db/id #edb/ref 17592186295684} {:answer/id #uuid "73e82961-671e-5f43-927c-85b68cebb79e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡(\\frac{1}{x})+C" :db/id #edb/ref 17592186295902} {:answer/id #uuid "8cc5e39c-b266-5cff-bbd7-b9a7c961e739" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡(\\frac{1}{x})+C" :db/id #edb/ref 17592186296018} {:answer/id #uuid "902705ff-4eac-5fc0-8d8a-b9ebd4cdfeff" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡(\\frac{1}{x})+C" :db/id #edb/ref 17592186296039}] :answer-field/correct {:answer/id #uuid "4675341d-47de-58d1-9169-e4ea300f6534" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡(\\frac{1}{x})+C" :db/id #edb/ref 17592186295666} :answer-field/id #uuid "4c5828d6-8af8-5472-82db-0c5fb62611d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296780}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7ade3ef7-2470-5279-802e-68d9ba79206f" :question/math-academy-id "q-3038" :question/problem "Calculate the integral $\\int \\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "Let $u=\\frac{1}{x}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\frac{1}{{x}^{2}}\\,⟹\\,-\\text{d}u=\\frac{1}{{x}^{2}}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\,\\text{d}x & =\\int {sec}^{2}⁡(\\frac{1}{x})\\cdot \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡u\\cdot (-\\text{d}u) \\\\  & =-\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =-\\operatorname{tan}⁡u+C \\\\  & =-\\operatorname{tan}⁡(\\frac{1}{x})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8483f978-0eb7-58b8-8af7-e33b9170b809" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318016}] :answer-field/correct {:answer/id #uuid "8483f978-0eb7-58b8-8af7-e33b9170b809" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186318016} :answer-field/id #uuid "072ef757-3ef7-5291-a2b9-f78bdb72dd2b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318442}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b2f52a91-e2df-5743-9b16-3551c628a81b" :question/math-academy-id "q-350202" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\sqrt{\\pi /12}}8xsec\\,(4{x}^{2})tan\\,(4{x}^{2})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=4{x}^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8x\\,⟹\\,\\text{d}u=8x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\sqrt{\\pi /12}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi /3$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi /12}}8xsec\\,(4{x}^{2})tan\\,(4{x}^{2})\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\pi /12}}sec\\,(4{x}^{2})tan\\,(4{x}^{2})\\cdot 8x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{sec}⁡(u)\\operatorname{tan}⁡(u)\\,\\text{d}u \\\\  & =\\operatorname{sec}⁡(u)\\,{|}_{0}^{\\pi /3} \\\\  & =\\operatorname{sec}⁡(\\frac{\\pi }{3})-\\operatorname{sec}⁡(0) \\\\  & =2-1 \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a0832f3-44e5-55dc-b0d6-cde9d7754977" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317931}] :answer-field/correct {:answer/id #uuid "6a0832f3-44e5-55dc-b0d6-cde9d7754977" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186317931} :answer-field/id #uuid "81013bc8-e699-5fa8-92f3-108172fec02c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318703}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4977c738-ef65-5d72-9699-ec8683cb5818" :question/math-academy-id "q-350203" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\sqrt{\\pi /12}}^{\\sqrt{\\pi /6}}12x\\operatorname{cos}⁡(6{x}^{2})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=6{x}^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=12x\\,⟹\\,\\text{d}u=12x\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $\\sqrt{\\pi /12}$ | $\\sqrt{\\pi /6}$ |\n| --- | --- | --- |\n| $u$ | $\\pi /2$ | $\\pi $ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{\\pi /12}}^{\\sqrt{\\pi /6}}12x\\operatorname{cos}⁡(6{x}^{2})\\,\\text{d}x & ={\\int }_{\\sqrt{\\pi /12}}^{\\sqrt{\\pi /6}}\\operatorname{cos}⁡(6{x}^{2})\\cdot 12x\\,\\text{d}x \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡(u)\\,\\text{d}u \\\\  & =\\operatorname{sin}⁡(u)\\,{|}_{\\pi /2}^{\\pi } \\\\  & =\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =0-1 \\\\  & =-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67db1928-5d77-5d01-9982-b91efb720baf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cot{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486547} {:answer/id #uuid "80b3b820-877a-56c3-86d8-db243bd28b5d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\csc{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486551} {:answer/id #uuid "8414f7a2-369f-5120-b9a8-467cd2cbffd3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\cot{\\left(x^{2} \\right)}}{2}+C" :db/id #edb/ref 17592186486553} {:answer/id #uuid "8dcad831-351c-5fb6-8252-0ad06ca0e301" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cot{\\left(x^{2} \\right)}}{2}+C" :db/id #edb/ref 17592186486554} {:answer/id #uuid "d2010a1d-48cd-5e3a-8bb6-9f30dbdd2492" :answer/type {:db/ident :answer.type/math} :answer/value "\\cot{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486561}] :answer-field/correct {:answer/id #uuid "67db1928-5d77-5d01-9982-b91efb720baf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cot{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486547} :answer-field/id #uuid "240f4141-c6e4-573e-9f31-860c6fa6e3b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486545}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "002482ff-69a9-5b63-b3f0-5cd70a51819a" :question/problem "Calculate $\\int 2 x \\csc^{2}{\\left(x^{2} \\right)}\\,\\text{d}x.$" :question/worked-solution "Let $u=x^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2 x \\csc^{2}{\\left(x^{2} \\right)}\\,\\text{d}x &= 1\\int \\csc^{2}{\\left(u \\right)}\\,\\text{d}u \\\\ &= - \\cot{\\left(u \\right)}+C \\\\ &= - \\cot{\\left(x^{2} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2b14aa-939d-5f78-95d5-a8ac2d5a46b9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486543} {:answer/id #uuid "1202f884-82b1-540e-bfd1-0ee80ba2c514" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486544} {:answer/id #uuid "b9b4275b-87e1-5689-822b-8dac3c858579" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486558} {:answer/id #uuid "cb6699db-b1f0-5226-8168-b9ec448eac86" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486560} {:answer/id #uuid "fcef9471-29d4-56f5-9a65-4b6c75538bcf" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486562}] :answer-field/correct {:answer/id #uuid "0b2b14aa-939d-5f78-95d5-a8ac2d5a46b9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\cos{\\left(x^{2} \\right)}+C" :db/id #edb/ref 17592186486543} :answer-field/id #uuid "79c1360c-2029-597a-92dc-abe7f1cbfea3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486550}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "82583355-6299-599e-bdc6-d65fa8aebd0a" :question/problem "Calculate $\\int 2 x \\sin{\\left(x^{2} \\right)}\\,\\text{d}x.$" :question/worked-solution "Let $u=x^{2},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2 x \\sin{\\left(x^{2} \\right)}\\,\\text{d}x &= 1\\int \\sin{\\left(u \\right)}\\,\\text{d}u \\\\ &= - \\cos{\\left(u \\right)}+C \\\\ &= - \\cos{\\left(x^{2} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186486555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28b0a88b-6033-5a60-beab-0cbad3f7fed3" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\tan{\\left(x^{3} \\right)}+C" :db/id #edb/ref 17592186486546} {:answer/id #uuid "6f9bacea-3262-508b-9719-4fd80bf9d534" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\sec{\\left(x^{3} \\right)}}{3}+C" :db/id #edb/ref 17592186486548} {:answer/id #uuid "79463279-bba4-5ce7-b66d-91ca6c29fee1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\tan{\\left(x^{3} \\right)}}{3}+C" :db/id #edb/ref 17592186486549} {:answer/id #uuid "b44d88f2-1b54-541f-aa56-dae6e3f577f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\tan{\\left(x^{3} \\right)}}{2}+C" :db/id #edb/ref 17592186486556} {:answer/id #uuid "c04acc4c-98a0-5857-8fdc-cdb07ac37366" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\tan{\\left(x^{3} \\right)}+C" :db/id #edb/ref 17592186486559}] :answer-field/correct {:answer/id #uuid "79463279-bba4-5ce7-b66d-91ca6c29fee1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\tan{\\left(x^{3} \\right)}}{3}+C" :db/id #edb/ref 17592186486549} :answer-field/id #uuid "b59d98d5-6b64-56b9-afca-bffec0e1eaf3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186486557}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9f181c0b-4ade-5cfb-806e-89c254367d4c" :question/problem "$\\int 8 x^{2} \\sec^{2}{\\left(x^{3} \\right)}\\,\\text{d}x=$" :question/worked-solution "Let $u=x^{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3 x^{2}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 8 x^{2} \\sec^{2}{\\left(x^{3} \\right)}\\,\\text{d}x &= \\frac{8}{3}\\int \\sec^{2}{\\left(u \\right)}\\,\\text{d}u \\\\ &= \\frac{8 \\tan{\\left(u \\right)}}{3}+C \\\\ &= \\frac{8 \\tan{\\left(x^{3} \\right)}}{3}+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Products Containing Trigonometric Functions Using Substitution"}]}
