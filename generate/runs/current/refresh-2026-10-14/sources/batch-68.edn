#{[{:db/id #edb/ref 17592186068723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068565 :question/id #uuid "9bf7d343-8d3d-5194-93c4-7b80bc1e3609" :question/math-academy-id "e-453" :question/problem "Calculate $\\displaystyle\\int x\\left(1+2x^2\\right)^6\\,\\textrm{d}x .$" :question/worked-solution "The $x$ that's outside the parentheses isn't quite the derivative of $(1+2x^2).$ The derivative of $(1+2x^2)$ is $4x,$ so we're out by a constant factor of $4$. However, since we're out only by a constant factor, substitution will still work!\n\nSo we make the substitution\n\n$$\nu=1+2x^2.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =4x\\,⟹\\,\\frac{1}{4}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x{(1+2{x}^{2})}^{6}\\,\\text{d}x & =\\int {(1+2{x}^{2})}^{6}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{6}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{6}\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{6}\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{7}}{7}+C \\\\  & =\\frac{1}{28}{u}^{7}+C \\\\  & =\\frac{1}{28}{(1+2{x}^{2})}^{7}+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/questions [{:db/id #edb/ref 17592186069029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9563eb43-dadf-5267-ba13-b147f768d7bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{11}(x^{2} + 5)^{11} + C" :db/id #edb/ref 17592186065608} {:answer/id #uuid "a06c375d-5daf-5bb5-ab62-b41efe5ded0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}(x^{2} + 5)^{10} + C" :db/id #edb/ref 17592186065609} {:answer/id #uuid "d1f491f6-9e20-57c9-a317-8d8cfa6a9a4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}(x^{2} + 5)^{11} + C" :db/id #edb/ref 17592186065610} {:answer/id #uuid "04737357-c7ae-57a4-9070-91a4ae84b588" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}(x^{2} + 5)^{10} + C" :db/id #edb/ref 17592186065611} {:answer/id #uuid "6d93c772-fca9-523c-9538-c7fe7f696dc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{22}(x^{2} + 5)^{11} + C" :db/id #edb/ref 17592186065612}] :answer-field/id #uuid "692104d9-569e-5428-b7b0-321b3e970222" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186065607}] :question/id #uuid "a7e4db8c-b3e2-51ed-a39a-42253ac35668" :question/math-academy-id "q-12494" :question/problem "Calculate $\\intx(x^{2} + 5)^{10}dx$."} {:db/id #edb/ref 17592186069030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0439a2aa-fc95-5a6f-8ba6-a08e185beaa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{44}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186256815} {:answer/id #uuid "76cdbd0e-31fa-5d43-9da9-087458569c34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{40}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186257830} {:answer/id #uuid "7a976b23-fe40-5cb5-af5e-04ee0fd15dd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}{({x}^{4}+11)}^{9}+C" :db/id #edb/ref 17592186257866} {:answer/id #uuid "bf4cbcec-1f82-59d7-95a8-2396d64d3e5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{36}{({x}^{4}+11)}^{9}+C" :db/id #edb/ref 17592186258449} {:answer/id #uuid "cb446671-4285-5ffd-806b-31e615004133" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186258546}] :answer-field/correct {:answer/id #uuid "76cdbd0e-31fa-5d43-9da9-087458569c34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{40}{({x}^{4}+11)}^{10}+C" :db/id #edb/ref 17592186257830} :answer-field/id #uuid "87ede77b-ed26-5e38-bf4c-454ee0d7c02e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259267}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "395d59bc-74f3-5209-b445-2d063af44516" :question/math-academy-id "q-12496" :question/problem "Calculate $\\int {x}^{3}{({x}^{4}+11)}^{9}\\,\\text{d}x.$" :question/worked-solution "In this case, the ${x}^{3}$ that's outside the parentheses isn't quite the derivative of $({x}^{4}+11).$ But the derivative is $4{x}^{3},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu={x}^{4}+11.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={x}^{3}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{3}{({x}^{4}+11)}^{9}\\,\\text{d}x & =\\int ({x}^{4}+11)^{9}\\cdot {x}^{3}\\,\\text{d}x \\\\  & =\\int {u}^{9}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{9}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{9}\\,\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{10}}{10}+C \\\\  & =\\frac{1}{40}{u}^{10}+C \\\\  & =\\frac{1}{40}({x}^{4}+11)^{10}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e32ff11-46c7-5e54-94bf-fdf37bd4e777" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{6}+C" :db/id #edb/ref 17592186245143} {:answer/id #uuid "61c7ef3d-13c8-5479-bf15-23c7156762ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/id #edb/ref 17592186245171} {:answer/id #uuid "90a0075f-a39c-584e-ab19-3bcdb240a499" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{3}+C" :db/id #edb/ref 17592186245575} {:answer/id #uuid "ad996ae5-8424-527c-80d5-4c89b95ad520" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{2}+C" :db/id #edb/ref 17592186245863} {:answer/id #uuid "c21643d0-8214-58cb-bb01-f4183d7d91a2" :answer/type {:db/ident :answer.type/math} :answer/value "2(4+{x}^{6})^{6}+C" :db/id #edb/ref 17592186246045}] :answer-field/correct {:answer/id #uuid "61c7ef3d-13c8-5479-bf15-23c7156762ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/id #edb/ref 17592186245171} :answer-field/id #uuid "51b37ac4-75b0-5695-8c29-875df29f0437" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246690}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "49e41322-d540-5688-b30a-e33aaf2dc9a7" :question/math-academy-id "q-113710" :question/problem "Calculate $\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x.$" :question/worked-solution "In this case, the term $2{x}^{5}$ outside the parentheses isn't quite the derivative of $4+{x}^{6}.$ But the derivative is $6{x}^{5},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=4+{x}^{6}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{5}\\,⟹\\,\\frac{1}{3}\\text{d}u=2{x}^{5}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x & =\\int (4+{x}^{6})^{5}\\cdot 2{x}^{5}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u & =\\frac{1}{3}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =\\frac{1}{18}{u}^{6}+C \\\\  & =\\frac{1}{18}(4+{x}^{6})^{6}+C \\\\  & =\\frac{(4+{x}^{6})^{6}}{18}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f63ea0a-f3f2-54ef-a270-6ec6fbabee05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{21}+C" :db/id #edb/ref 17592186244589} {:answer/id #uuid "38e1e66e-1847-56da-b418-1e266ee6a140" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7(2+{x}^{7})^{3}}{3}+C" :db/id #edb/ref 17592186244816} {:answer/id #uuid "58e52009-5fcb-5c44-b3c6-ddd679ec2d6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{3}+C" :db/id #edb/ref 17592186245099} {:answer/id #uuid "9aa948c9-5fc8-5e93-8c9f-7c5ebc071e92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{7}+C" :db/id #edb/ref 17592186245680} {:answer/id #uuid "f55f1788-6600-5094-8abf-85647a35ae75" :answer/type {:db/ident :answer.type/math} :answer/value "21(2+{x}^{7})^{3}+C" :db/id #edb/ref 17592186246479}] :answer-field/correct {:answer/id #uuid "1f63ea0a-f3f2-54ef-a270-6ec6fbabee05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(2+{x}^{7})^{3}}{21}+C" :db/id #edb/ref 17592186244589} :answer-field/id #uuid "fc454689-a46a-5c25-bff9-c900649eb050" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246996}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ddb8f392-6e2f-5096-a24e-dc20632151b9" :question/math-academy-id "q-113711" :question/problem "Calculate $\\int {x}^{6}(2+{x}^{7})^{2}\\,\\text{d}x.$" :question/worked-solution "In this case, the term ${x}^{6}$ outside the parentheses isn't quite the derivative of $2+{x}^{7}.$ But the derivative is $7{x}^{6},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=2+{x}^{7}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =7{x}^{6}\\,⟹\\,\\frac{1}{7}\\text{d}u={x}^{6}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{6}(2+{x}^{7})^{2}\\,\\text{d}x & =\\int (2+{x}^{7})^{2}\\cdot {x}^{6}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\frac{1}{7}\\text{d}u \\\\  & =\\frac{1}{7}\\int {u}^{2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{7}\\int {u}^{2}\\,\\text{d}u & =\\frac{1}{7}\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\frac{1}{21}{u}^{3}+C \\\\  & =\\frac{1}{21}(2+{x}^{7})^{3}+C \\\\  & =\\frac{(2+{x}^{7})^{3}}{21}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87270835-ee16-52fc-9e6f-b7224403ba40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{({x}^{3}+10)^{3}}}{2}+C" :db/id #edb/ref 17592186245504} {:answer/id #uuid "a6dba20e-7807-5eb8-987c-b857409770d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{({x}^{3}+10)^{3}}}{3}+C" :db/id #edb/ref 17592186245808} {:answer/id #uuid "a80ed814-2729-5b22-b7af-1feac14bf0e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{({x}^{3}+10)^{3}}}{9}+C" :db/id #edb/ref 17592186245817} {:answer/id #uuid "b2044155-10ef-598a-b01d-212d7fc71f33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{({x}^{3}+10)^{3}}}{4}+C" :db/id #edb/ref 17592186245896} {:answer/id #uuid "ed918b76-3831-5f97-a7d6-16ae5b86b6ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{3}+10)^{3}}+C" :db/id #edb/ref 17592186246411}] :answer-field/correct {:answer/id #uuid "a80ed814-2729-5b22-b7af-1feac14bf0e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{({x}^{3}+10)^{3}}}{9}+C" :db/id #edb/ref 17592186245817} :answer-field/id #uuid "28b194cc-bc5c-5930-a248-aeea15605d87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246613}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "289ac24b-4cc7-5baf-9d30-2e391bade4eb" :question/math-academy-id "q-113715" :question/problem "Calculate $\\int 2{x}^{2}\\sqrt{{x}^{3}+10}\\,\\text{d}x.$" :question/worked-solution "In this case, the $2{x}^{2}$ that's outside the square root isn't quite the derivative of ${x}^{3}+10.$ But the derivative is $3{x}^{2},$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{3}+10.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2}\\,⟹\\,\\frac{2}{3}\\text{d}u=2{x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{2}\\sqrt{{x}^{3}+10}\\,\\text{d}x & =\\int \\sqrt{{x}^{3}+10}\\cdot 2{x}^{2}\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{2}{3}\\text{d}u \\\\  & =\\frac{2}{3}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{2}{3}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{2}{3}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{3}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{9}{u}^{3/2}+C \\\\  & =\\frac{4}{9}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4\\sqrt{({x}^{3}+10)^{3}}}{9}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05923f64-0178-515d-b1c0-8a34f89bf2d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/id #edb/ref 17592186288070} {:answer/id #uuid "33e66623-ff10-5d20-8993-f2536250f43c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/id #edb/ref 17592186288373} {:answer/id #uuid "38e8f95c-0391-5a44-87d6-e145b0a88952" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{5}}{5}+C" :db/id #edb/ref 17592186288422} {:answer/id #uuid "52abbeaf-48c8-5e31-8c3a-14d2a081d694" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{(3-{x}^{2})}^{6}}{4}+C" :db/id #edb/ref 17592186288606} {:answer/id #uuid "b0632e15-3fe5-52f8-9671-b43672893723" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{6}+C" :db/id #edb/ref 17592186289198}] :answer-field/correct {:answer/id #uuid "05923f64-0178-515d-b1c0-8a34f89bf2d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{(3-{x}^{2})}^{6}}{12}+C" :db/id #edb/ref 17592186288070} :answer-field/id #uuid "fa27dea5-b8ee-51a6-a6c0-5aa2c0cfdffb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290248}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "46e8f3d6-924e-554c-9c9c-a93b6ef8fe0f" :question/math-academy-id "q-2379" :question/problem "$\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x=$" :question/worked-solution "In this case, the $x$ that's outside the parentheses isn't quite the derivative of $(3-{x}^{2}).$ But the derivative is $-2x,$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=3-{x}^{2}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-2x\\,⟹\\,(-\\frac{1}{2})\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x{(3-{x}^{2})}^{5}\\,\\text{d}x & =\\int {(3-{x}^{2})}^{5}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot (-\\frac{1}{2})\\text{d}u \\\\  & =-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\int {u}^{5}\\,\\text{d}u & =-\\frac{1}{2}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{1}{12}{u}^{6}+C \\\\  & =-\\frac{1}{12}{(3-{x}^{2})}^{6}+C \\\\  & =-\\frac{{(3-{x}^{2})}^{6}}{12}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a8076b-3d53-572b-b0b2-b4ec5111ae1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}-1)^{4}}{8}+C" :db/id #edb/ref 17592186288536} {:answer/id #uuid "a0f5c1bd-0e1f-5f32-9ba3-fafac18070b3" :answer/type {:db/ident :answer.type/math} :answer/value "8({x}^{2}-1)^{4}+C" :db/id #edb/ref 17592186289107} {:answer/id #uuid "ad74c40c-9bd2-547f-bef9-24e8d0e39eca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}-1)^{5}}{10}+C" :db/id #edb/ref 17592186289181} {:answer/id #uuid "b5f58358-e18b-5b5b-b0a3-50324e55504f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}-1)^{3}}{6}+C" :db/id #edb/ref 17592186289237} {:answer/id #uuid "f2f7f194-aba6-5c72-b363-bd05aa96fbc4" :answer/type {:db/ident :answer.type/math} :answer/value "3({x}^{2}-1)^{3}+C" :db/id #edb/ref 17592186289636}] :answer-field/correct {:answer/id #uuid "48a8076b-3d53-572b-b0b2-b4ec5111ae1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}-1)^{4}}{8}+C" :db/id #edb/ref 17592186288536} :answer-field/id #uuid "75d837f9-107a-5091-a101-b034c67fe38c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289988}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c383c96e-d00b-5142-a0f8-5447857bcdf7" :question/math-academy-id "q-2388" :question/problem "Calculate $\\int x({x}^{2}-1)^{3}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the parentheses isn't quite the derivative of $({x}^{2}-1).$ But the derivative is $2x,$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu={x}^{2}-1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x({x}^{2}-1)^{3}\\,\\text{d}x & =\\int ({x}^{2}-1)^{3}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{3}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{3}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{3}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{4}}{4}+C \\\\  & =\\frac{1}{8}{u}^{4}+C \\\\  & =\\frac{1}{8}({x}^{2}-1)^{4}+C \\\\  & =\\frac{({x}^{2}-1)^{4}}{8}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339101 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12648c9d-ca0a-5c06-8d28-3b5339e18c79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}(2{x}^{3}+1)^{5}+C" :db/id #edb/ref 17592186336205} {:answer/id #uuid "348bc642-a686-5037-93a1-80ef9b043c21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}(2{x}^{3}+1)^{5}+C" :db/id #edb/ref 17592186336527} {:answer/id #uuid "523c5a54-8017-5c7a-8654-3737dc48aa62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{36}(2{x}^{3}+1)^{6}+C" :db/id #edb/ref 17592186336788} {:answer/id #uuid "8f57998c-0372-5e76-9f28-8d0085a6338d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(2{x}^{3}+1)^{6}+C" :db/id #edb/ref 17592186337326} {:answer/id #uuid "d7481bed-10ff-52c3-b2ea-c7552feac11d" :answer/type {:db/ident :answer.type/math} :answer/value "10(2{x}^{3}+1)^{5}+C" :db/id #edb/ref 17592186337901}] :answer-field/correct {:answer/id #uuid "523c5a54-8017-5c7a-8654-3737dc48aa62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{36}(2{x}^{3}+1)^{6}+C" :db/id #edb/ref 17592186336788} :answer-field/id #uuid "a143ae71-3353-55f0-b57e-1cc94703fdd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338575}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ae07dc95-0de4-5355-b9e4-0429124190f3" :question/math-academy-id "q-72385" :question/problem "$\\int {x}^{2}{(2{x}^{3}+1)}^{5}\\,\\text{d}x=$" :question/worked-solution "In this case, the ${x}^{2}$ that's outside the parentheses isn't quite the derivative of $(2{x}^{3}+1).$ But the derivative is $6{x}^{2},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=2{x}^{3}+1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{2}\\,⟹\\,\\frac{1}{6}\\text{d}u={x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {x}^{2}{(2{x}^{3}+1)}^{5}\\,\\text{d}x & =\\int (2{x}^{3}+1)^{5}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\frac{1}{6}\\text{d}u \\\\  & =\\frac{1}{6}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{6}\\int {u}^{5}\\,\\text{d}u & =\\frac{1}{6}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =\\frac{1}{36}{u}^{6}+C \\\\  & =\\frac{1}{36}(2{x}^{3}+1)^{6}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14f1a007-67d4-5294-a8eb-ef4468d234a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{32}{(1+{x}^{8})}^{8}+C" :db/id #edb/ref 17592186336231} {:answer/id #uuid "3758f3a7-0955-5e41-b718-be8c4ac8cdd8" :answer/type {:db/ident :answer.type/math} :answer/value "8{(1+{x}^{8})}^{8}+C" :db/id #edb/ref 17592186336547} {:answer/id #uuid "528c7f2c-2c2f-5b2f-91d2-6645351de509" :answer/type {:db/ident :answer.type/math} :answer/value "7{(1+{x}^{8})}^{7}+C" :db/id #edb/ref 17592186336791} {:answer/id #uuid "65fb49ec-61da-5444-9520-d4d71c8c2033" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}{(1+{x}^{8})}^{8}+C" :db/id #edb/ref 17592186336941} {:answer/id #uuid "6fc0c86e-c394-5252-94ae-76022f6e4b17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{56}{(1+{x}^{8})}^{7}+C" :db/id #edb/ref 17592186337021}] :answer-field/correct {:answer/id #uuid "14f1a007-67d4-5294-a8eb-ef4468d234a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{32}{(1+{x}^{8})}^{8}+C" :db/id #edb/ref 17592186336231} :answer-field/id #uuid "d17f0f7f-b9b3-554b-a065-0304d8dc81c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338647}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bc72adcf-bd5d-570e-acd1-e64eaf250f11" :question/math-academy-id "q-72386" :question/problem "$\\int 2{x}^{7}{(1+{x}^{8})}^{7}\\,\\text{d}x=$" :question/worked-solution "In this case, the $2{x}^{7}$ that's outside the parentheses isn't quite the derivative of $(1+{x}^{8}).$ But the derivative is $8{x}^{7},$ so we're only out by a constant factor. \n\nSo we make the substitution\n\n$$\nu=1+{x}^{8}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =8{x}^{7}\\,⟹\\,\\frac{1}{8}\\text{d}u={x}^{7}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{7}{(1+{x}^{8})}^{7}\\,\\text{d}x & =\\int 2{(1+{x}^{8})}^{7}\\cdot {x}^{7}\\,\\text{d}x \\\\  & =\\int 2{u}^{7}\\cdot \\frac{1}{8}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{7}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{7}\\,\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =\\frac{1}{32}{u}^{8}+C \\\\  & =\\frac{1}{32}{(1+{x}^{8})}^{8}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59935f-f93b-599b-9816-d15f61104595" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336167} {:answer/id #uuid "1ccce204-ca7a-5eee-bc02-3fcc7e16e632" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336299} {:answer/id #uuid "4b5b5f53-8881-5e03-8cde-ddfcc41895a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336732} {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} {:answer/id #uuid "7bc5cfb0-4b70-528a-a0e4-e88e561188b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337152}] :answer-field/correct {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} :answer-field/id #uuid "80b5679a-f4f7-56bb-9b5b-253ee5665aec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338504}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "de70203f-dd05-5f0d-9800-283717012618" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483515 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26ddfda2-b2b6-595c-8b7e-f782a80088e3" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\left(x^{2} - 20\\right)^{\\frac{3}{2}}+C" :db/id #edb/ref 17592186483513} {:answer/id #uuid "97f64ec0-4889-505b-9dd4-4c8f869db6e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(x^{2} - 20\\right)^{\\frac{3}{2}}+C" :db/id #edb/ref 17592186483519} {:answer/id #uuid "9e1af47f-baed-5394-9f36-b6382e9e257a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(x^{2} - 20\\right)^{\\frac{3}{2}}}{2}+C" :db/id #edb/ref 17592186483520} {:answer/id #uuid "a13be955-6868-5c64-97b7-93c1632881a7" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\left(x^{2} - 20\\right)^{\\frac{3}{2}}+C" :db/id #edb/ref 17592186483521} {:answer/id #uuid "d4626a44-dab4-5881-8d15-87fbe21dc93a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(x^{2} - 20\\right)^{\\frac{3}{2}}}{3}+C" :db/id #edb/ref 17592186483522}] :answer-field/correct {:answer/id #uuid "d4626a44-dab4-5881-8d15-87fbe21dc93a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(x^{2} - 20\\right)^{\\frac{3}{2}}}{3}+C" :db/id #edb/ref 17592186483522} :answer-field/id #uuid "909bc525-ad6d-5f0b-acd1-9b05c9585d04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483518}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "60241274-8490-524b-acba-fc74aea3d5e9" :question/problem "Calculate $\\int x\\sqrt{x^{2} - 20}\\,\\text{d}x.$\n\nWork on an interval where $x^{2} - 20>0$." :question/worked-solution "In this case, the $x$ outside the parentheses isn't quite the derivative of $(x^{2} - 20).$ But the derivative is $2 x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu=x^{2} - 20.\n$$\n\nIts derivative is given by\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 x\\quad\\Longrightarrow\\quad \\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\int x\\sqrt{x^{2} - 20}\\,\\text{d}x=\\frac{1}{2}\\int u^{\\frac{1}{2}}\\,\\text{d}u.\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int u^{\\frac{1}{2}}\\,\\text{d}u &=\\frac{1}{2}\\frac{u^{\\frac{3}{2}}}{\\frac{3}{2}}+C\\\\ &=\\frac{1}{3}u^{\\frac{3}{2}}+C\\\\ &=\\frac{\\left(x^{2} - 20\\right)^{\\frac{3}{2}}}{3}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ef1452f-8922-5c41-aad6-b2506e9df8ed" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\left(- x^{2} + 11\\right)^{3}}{3}+C" :db/id #edb/ref 17592186483511} {:answer/id #uuid "12fef86c-0c97-50c4-9487-6d40fc7b6a2e" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\left(- x^{2} + 11\\right)^{4}}{8}+C" :db/id #edb/ref 17592186483512} {:answer/id #uuid "62d8dfd9-a6bd-508a-9775-552281a549c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(- x^{2} + 11\\right)^{4}}{2}+C" :db/id #edb/ref 17592186483516} {:answer/id #uuid "6a43b002-eae2-584f-8ba4-a6fb2321c862" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(- x^{2} + 11\\right)^{4}}{4}+C" :db/id #edb/ref 17592186483517} {:answer/id #uuid "d49c5348-be43-503f-8745-e317361c550b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\left(- x^{2} + 11\\right)^{4}}{4}+C" :db/id #edb/ref 17592186483523}] :answer-field/correct {:answer/id #uuid "12fef86c-0c97-50c4-9487-6d40fc7b6a2e" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\left(- x^{2} + 11\\right)^{4}}{8}+C" :db/id #edb/ref 17592186483512} :answer-field/id #uuid "58512abd-62af-54c3-b5c3-67149278f4ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483514}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f11633ad-c3d3-53f8-93e6-d3a1d7d686df" :question/problem "$\\int x\\left(- x^{2} + 11\\right)^{3}\\,\\text{d}x=$" :question/worked-solution "In this case, the $x$ outside the parentheses isn't quite the derivative of $(- x^{2} + 11).$ But the derivative is $- 2 x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu=- x^{2} + 11.\n$$\n\nIts derivative is given by\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=- 2 x\\quad\\Longrightarrow\\quad - \\frac{1}{2}\\,\\text{d}u=x\\,\\text{d}x.\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\int x\\left(- x^{2} + 11\\right)^{3}\\,\\text{d}x=- \\frac{1}{2}\\int u^{3}\\,\\text{d}u.\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}- \\frac{1}{2}\\int u^{3}\\,\\text{d}u &=- \\frac{1}{2}\\frac{u^{4}}{4}+C\\\\ &=- \\frac{1}{8}u^{4}+C\\\\ &=- \\frac{\\left(- x^{2} + 11\\right)^{4}}{8}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] [{:db/id #edb/ref 17592186068786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068628 :question/id #uuid "0461f8ba-c3c5-5e22-a679-32ee4f2a01b8" :question/math-academy-id "e-6149" :question/problem "$\\displaystyle \\int \\dfrac{x^2}{\\sqrt{1-x^3}} \\, \\textrm{d}x=$" :question/worked-solution "Let $u = 1 - x^3.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3x^2 \\quad \\Longrightarrow\\quad -\\dfrac{1}{3} \\textrm d u= x^2 \\, \\textrm d x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{3}}}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{1}{3})\\text{d}u \\\\  & =-\\frac{1}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{1}{3}(2\\sqrt{u})+C \\\\  & =-\\frac{2}{3}\\sqrt{u}+C \\\\  & =-\\frac{2}{3}\\sqrt{1-{x}^{3}}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/questions [{:db/id #edb/ref 17592186069174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11177df5-0483-5972-bcaf-9017710da256" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x}}{\\sqrt{{x}^{3}+7}}+C" :db/id #edb/ref 17592186288159} {:answer/id #uuid "9705b997-814b-59ba-9086-20d3695fb1fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{{x}^{3}+7}+C" :db/id #edb/ref 17592186289042} {:answer/id #uuid "ddddbc9c-8e13-5c76-8aa8-0be8e56b19f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{x}^{3}+7}+C" :db/id #edb/ref 17592186289507} {:answer/id #uuid "e95a230c-2af6-58ef-bf2b-d28f8c9c3d65" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{x}^{3}+7}+C" :db/id #edb/ref 17592186289581} {:answer/id #uuid "ec2bc56b-6a94-5d2d-a542-0a0c2d7488ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{{x}^{3}+7}}+C" :db/id #edb/ref 17592186289594}] :answer-field/correct {:answer/id #uuid "e95a230c-2af6-58ef-bf2b-d28f8c9c3d65" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{x}^{3}+7}+C" :db/id #edb/ref 17592186289581} :answer-field/id #uuid "27abd601-d10e-5e6b-9bac-388db9d51c71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289822}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "87181cd2-9356-511c-8a55-f0b3b8086037" :question/math-academy-id "q-2389" :question/problem "Calculate the integral $\\int \\frac{3{x}^{2}}{\\sqrt{{x}^{3}+7}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{3}+7.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}}{\\sqrt{{x}^{3}+7}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{{x}^{3}+7}}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{3}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =2\\sqrt{u}+C \\\\  & =2\\sqrt{{x}^{3}+7}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a628c40c-4e75-5f13-87be-61ed84087ba2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{x^{4} + 1} + C" :db/id #edb/ref 17592186067451} {:answer/id #uuid "c716a796-4725-553b-87be-ebe47623aa63" :answer/type {:db/ident :answer.type/math} :answer/value "- (4)/((x^{4} + 1)^{3}) + C" :db/id #edb/ref 17592186067452} {:answer/id #uuid "d42b25df-815d-59a5-9f61-e2f883e6b35a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{x^{4} + 1} + C" :db/id #edb/ref 17592186067453} {:answer/id #uuid "ea02432c-292f-5904-8f8b-0a42cacc4a80" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(4(x^{4} + 1)) + C" :db/id #edb/ref 17592186067454} {:answer/id #uuid "4ad3d496-ac04-56f5-a6ac-8f40ca19950a" :answer/type {:db/ident :answer.type/math} :answer/value "- (1)/(4(x^{4} + 1)) + C" :db/id #edb/ref 17592186067455}] :answer-field/id #uuid "0c64e83c-6563-59b2-b449-b09716f74242" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067450}] :question/id #uuid "1c59aa96-af86-5131-a78a-b95c0bde8857" :question/math-academy-id "q-49636" :question/problem "Calculate $\\displaystyle \\int(x^{3})/((x^{4} + 1)^{2})dx$."} {:db/id #edb/ref 17592186247402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387b1fd3-d0b6-5a4f-9f87-df4622619640" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186244813} {:answer/id #uuid "5a108ad3-8f59-57fb-86b0-8078293f3c34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245104} {:answer/id #uuid "64849b83-6c8e-5754-857d-65fbc670429e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245200} {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} {:answer/id #uuid "d7b59bc3-4c29-5982-981f-e767a487ae12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186246233}] :answer-field/correct {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} :answer-field/id #uuid "a5979b9c-8e33-51cf-9331-a30916482816" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246840}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "14745f6d-a16a-5fbf-98d1-0322f61ed9f2" :question/math-academy-id "q-113726" :question/problem "Calculate $\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x.$" :question/worked-solution "Let $u=3-{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5{x}^{4}\\,⟹\\,-\\frac{7}{5}\\text{d}u=7{x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x & =\\int \\frac{1}{{(3-{x}^{5})}^{6}}\\cdot 7{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{6}}\\cdot (-\\frac{7}{5})\\,\\text{d}u \\\\  & =-\\frac{7}{5}\\int \\frac{1}{{u}^{6}}\\,\\text{d}u \\\\  & =-\\frac{7}{5}(-\\frac{1}{5{u}^{5}})+C \\\\  & =\\frac{7}{25{u}^{5}}+C \\\\  & =\\frac{7}{25(3-{x}^{5})^{5}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247403 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea424b4-ccd0-51fd-8ec1-e3764c70780a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}\\sqrt{1-{x}^{3}}+C" :db/id #edb/ref 17592186244445} {:answer/id #uuid "5e879178-7f38-55b6-aad8-bff7a55417b2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}\\sqrt{1-{x}^{3}}+C" :db/id #edb/ref 17592186245146} {:answer/id #uuid "61f62b26-c52f-5367-8085-4051cd9de4ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4\\sqrt{1-{x}^{3}}}+C" :db/id #edb/ref 17592186245172} {:answer/id #uuid "8f89d43d-4540-53ea-8e0f-ac2bb206aaab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\sqrt{1-{x}^{3}}+C" :db/id #edb/ref 17592186245566} {:answer/id #uuid "e3d74297-cdb4-5644-bd76-8754aa62281e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3\\sqrt{1-{x}^{3}}}+C" :db/id #edb/ref 17592186246338}] :answer-field/correct {:answer/id #uuid "5e879178-7f38-55b6-aad8-bff7a55417b2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}\\sqrt{1-{x}^{3}}+C" :db/id #edb/ref 17592186245146} :answer-field/id #uuid "90d27c22-3b3c-5f6d-8503-ca7d14efde69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246795}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b09729b9-ffc3-52fc-8706-830a753599b5" :question/math-academy-id "q-113728" :question/problem "$\\int \\frac{2{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x=$" :question/worked-solution "Let $u=1-{x}^{3}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3{x}^{2}\\,⟹\\,(-\\frac{2}{3})\\text{d}u=2{x}^{2}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{3}}}\\cdot 2{x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{2}{3})\\text{d}u \\\\  & =-\\frac{2}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{2}{3}(2\\sqrt{u})+C \\\\  & =-\\frac{4}{3}\\sqrt{u}+C \\\\  & =-\\frac{4}{3}\\sqrt{1-{x}^{3}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259766 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "453def53-174d-5896-8e4f-7faa7466d05c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2{({x}^{2}+5)}^{8}}+C" :db/id #edb/ref 17592186257385} {:answer/id #uuid "98eb7e12-8b7e-5878-badc-a9f99309abb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258129} {:answer/id #uuid "a1b2fef7-0445-5ee0-9c9b-2663d3fb7feb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258199} {:answer/id #uuid "bdcefc88-d3ad-5c21-9ac6-75e0800e4041" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18{({x}^{2}+5)}^{8}}+C" :db/id #edb/ref 17592186258438} {:answer/id #uuid "dfeda5a9-a962-51e6-b8b1-1e93608cc2ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258733}] :answer-field/correct {:answer/id #uuid "dfeda5a9-a962-51e6-b8b1-1e93608cc2ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258733} :answer-field/id #uuid "0d7f8515-44cd-5765-b9d4-3675220879f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259058}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3d839b9a-ccae-57dc-9109-2e848ce0d27f" :question/math-academy-id "q-12502" :question/problem "Calculate $\\int \\frac{x}{{({x}^{2}+5)}^{10}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+5.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{x}{{({x}^{2}+5)}^{10}}\\,\\text{d}x & =\\int \\frac{1}{{({x}^{2}+5)}^{10}}\\cdot x\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{10}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{{u}^{10}}\\,\\text{d}u \\\\  & =\\frac{1}{2}(-\\frac{1}{9{u}^{9}})+C \\\\  & =-\\frac{1}{18{u}^{9}}+C \\\\  & =-\\frac{1}{18({x}^{2}+5)^{9}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332742 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a74f7a5-d13b-5625-8685-33bf17f81ed3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330180} {:answer/id #uuid "20943720-048e-50c7-805b-b14bda47d8c2" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330229} {:answer/id #uuid "6988d942-8c13-5520-b8de-e15f8996b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330896} {:answer/id #uuid "99cbcdb1-7b43-5aa9-9f23-79ca0088debf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{s}^{4}+1}+C" :db/id #edb/ref 17592186331329} {:answer/id #uuid "9adc4166-7d1a-5d72-a022-77854432da9a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{s}^{4}+1}+C" :db/id #edb/ref 17592186331341}] :answer-field/correct {:answer/id #uuid "6988d942-8c13-5520-b8de-e15f8996b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330896} :answer-field/id #uuid "545dd268-f619-59e2-a48a-b0dec0dece4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332359}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ab8a443f-9ff6-5aa0-97a4-a9045bf8e902" :question/math-academy-id "q-49560" :question/problem "Calculate $\\int \\frac{10{s}^{4}}{\\sqrt{{s}^{5}+1}}\\,\\text{d}s.$" :question/worked-solution "Let $u={s}^{5}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}s}=5{s}^{4}\\,⟹\\,\\frac{1}{5}\\text{d}u={s}^{4}\\,\\text{d}s,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{s}^{4}}{\\sqrt{{s}^{5}+1}}\\,\\text{d}s & =10\\int \\frac{1}{\\sqrt{{s}^{5}+1}}\\cdot {s}^{4}\\,\\text{d}s \\\\  & =10\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{10}{5}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =2\\cdot (2\\sqrt{u})+C \\\\  & =4\\sqrt{u}+C \\\\  & =4\\sqrt{{s}^{5}+1}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a0b1ce-6161-5e73-b36b-31d37e3b0b40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330112} {:answer/id #uuid "279bd955-25ed-5deb-9e91-1b260848ad7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330302} {:answer/id #uuid "4482d3ef-e1bd-52a2-968c-377e9def4806" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330566} {:answer/id #uuid "95ddf6e6-b070-55fd-b7d5-d3c0133dcc47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(1-{y}^{4})}^{5}}+C" :db/id #edb/ref 17592186331280} {:answer/id #uuid "b12013db-5592-5de5-ac15-a7f940470213" :answer/type {:db/ident :answer.type/math} :answer/value "{(1-{y}^{4})}^{5}+C" :db/id #edb/ref 17592186331516}] :answer-field/correct {:answer/id #uuid "13a0b1ce-6161-5e73-b36b-31d37e3b0b40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330112} :answer-field/id #uuid "8d27f773-d358-573a-9ebd-6ee1d5a4748e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332449}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "052c4300-130d-5380-bb49-cade415fdcf7" :question/math-academy-id "q-49561" :question/problem "Calculate $\\int \\frac{4{y}^{3}}{{(1-{y}^{4})}^{5}}\\,\\text{d}y.$" :question/worked-solution "Let $u=1-{y}^{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=-4{y}^{3}\\,⟹\\,(-\\frac{1}{4})\\text{d}u={y}^{3}\\,\\text{d}y,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4{y}^{3}}{{(1-{y}^{4})}^{5}}\\,\\text{d}y & =4\\int \\frac{1}{{(1-{y}^{4})}^{5}}\\cdot {y}^{3}\\,\\text{d}y \\\\  & =4\\int \\frac{1}{{u}^{5}}\\cdot (-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{4}{4}\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-(-\\frac{1}{4{u}^{4}})+C \\\\  & =\\frac{1}{4{u}^{4}}+C \\\\  & =\\frac{1}{4{(1-{y}^{4})}^{4}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332747 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088243d9-1f83-5d73-9676-61898c216f3a" :answer/type {:db/ident :answer.type/math} :answer/value "{(9-{x}^{2})}^{4}+C" :db/id #edb/ref 17592186330023} {:answer/id #uuid "19751e43-a723-581f-94f1-b9c5b12f13c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{(9-{x}^{2})}^{3}}+C" :db/id #edb/ref 17592186330169} {:answer/id #uuid "2ad52c65-7a01-580d-80a2-76c6aec15062" :answer/type {:db/ident :answer.type/m