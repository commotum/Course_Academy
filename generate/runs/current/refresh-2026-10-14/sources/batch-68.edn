answer.type/math} :answer/value "\\frac{3}{\\sqrt{{x}^{2}+1}}+C" :db/id #edb/ref 17592186330812} {:answer/id #uuid "61b6a8c9-a76e-5a52-a014-b7ba8c5cc386" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{x}^{2}+1}+C" :db/id #edb/ref 17592186330824} {:answer/id #uuid "8f23d841-25df-55e9-b092-19092e2a325c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{{x}^{2}+1}+C" :db/id #edb/ref 17592186331217} {:answer/id #uuid "db61c987-2624-5d24-8ca8-a4cd964f55a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2\\sqrt{{x}^{2}+1}}+C" :db/id #edb/ref 17592186331892}] :answer-field/correct {:answer/id #uuid "8f23d841-25df-55e9-b092-19092e2a325c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{{x}^{2}+1}+C" :db/id #edb/ref 17592186331217} :answer-field/id #uuid "dc2934a2-8eb7-5567-8e5e-da2d00346f85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332587}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "679af307-d9ef-5c2e-98dc-b2fb1b1809f9" :question/math-academy-id "q-49634" :question/problem "Calculate $\\int \\frac{3x}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3x}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\cdot x\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\frac{3}{2}(2\\sqrt{u})+C \\\\  & =3\\sqrt{u}+C \\\\  & =3\\sqrt{{x}^{2}+1}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186410416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0678af68-2cfb-5844-963f-561512f9006d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3\\sqrt{2-{x}^{6}}}+C" :db/id #edb/ref 17592186410208} {:answer/id #uuid "327adc54-a9df-5f2d-b704-5f8e97ebeefa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410241} {:answer/id #uuid "9fb4fe7b-3555-57fe-b8fa-15be7b061577" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410307} {:answer/id #uuid "e1c194db-8c56-5f8b-9caf-143ea6db9c78" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410355} {:answer/id #uuid "e721585d-c9aa-5992-9200-4910767201bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410359}] :answer-field/correct {:answer/id #uuid "e721585d-c9aa-5992-9200-4910767201bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C" :db/id #edb/ref 17592186410359} :answer-field/id #uuid "ba44c6c6-d2e7-5fc3-91bc-e559cd6937b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410405}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0a661730-d4ec-53a7-9567-e2d3f75e3bd0" :question/math-academy-id "q-113727" :question/problem "$\\int \\frac{{x}^{5}}{\\sqrt{2-{x}^{6}}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-{x}^{6}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{5}\\,⟹\\,(-\\frac{1}{6})\\text{d}u={x}^{5}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{5}}{\\sqrt{2-{x}^{6}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{2-{x}^{6}}}\\cdot {x}^{5}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{1}{6})\\text{d}u \\\\  & =-\\frac{1}{6}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{1}{6}(2\\sqrt{u})+C \\\\  & =-\\frac{1}{3}\\sqrt{u}+C \\\\  & =-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c21e6-de9d-58d9-9a51-d7f5069b72df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485704} {:answer/id #uuid "1674cd48-0238-5567-836c-df6a45c0436b" :answer/type {:db/ident :answer.type/math} :answer/value "{(12-{y}^{4})}^{5}+C" :db/id #edb/ref 17592186485705} {:answer/id #uuid "9fe2a835-68c8-5b9a-9bea-b3b00e73e23e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(12-{y}^{4})}^{5}}+C" :db/id #edb/ref 17592186485708} {:answer/id #uuid "daead01d-e38c-5120-9297-889531d9d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485709} {:answer/id #uuid "e895667b-20b9-5b21-8522-ef6dc6c60417" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485710}] :answer-field/correct {:answer/id #uuid "daead01d-e38c-5120-9297-889531d9d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485709} :answer-field/id #uuid "8d111a2e-9476-57d5-8ade-195346a8bc68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485706}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "99e025e4-1ea6-5d6e-812a-92d3fa45174a" :question/problem "Calculate $\\int \\frac{4{y}^{3}}{{(12-{y}^{4})}^{5}}\\,\\text{d}y.$" :question/worked-solution "Let $u=12-{y}^{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=-4{y}^{3}\\,⟹\\,(-\\frac{1}{4})\\text{d}u={y}^{3}\\,\\text{d}y,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4{y}^{3}}{{(12-{y}^{4})}^{5}}\\,\\text{d}y & =4\\int \\frac{1}{{(12-{y}^{4})}^{5}}\\cdot {y}^{3}\\,\\text{d}y \\\\  & =4\\int \\frac{1}{{u}^{5}}\\cdot (-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{4}{4}\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-(-\\frac{1}{4{u}^{4}})+C \\\\  & =\\frac{1}{4{u}^{4}}+C \\\\  & =\\frac{1}{4{(12-{y}^{4})}^{4}}+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Other Fractional Expressions"}] [{:db/id #edb/ref 17592186068915 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068567 :question/id #uuid "0021ae6a-8ef8-564e-9c2e-fb5f9e8f7313" :question/math-academy-id "e-464" :question/problem "Calculate the integral $\\displaystyle\\int 2 \\sin {\\left(\\dfrac x 3\\right)} \\,  \\textrm{d}x.$" :question/worked-solution "If we let $u=\\dfrac x 3,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac 1 3\\quad\\Longrightarrow\\quad \\textrm d x =3\\, \\textrm d u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2\\operatorname{sin}⁡(\\frac{x}{3})\\,\\text{d}x & =2\\int \\operatorname{sin}⁡u\\cdot 3\\,\\text{d}u \\\\  & =2\\cdot 3\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-6\\operatorname{cos}⁡u+C \\\\  & =-6\\operatorname{cos}⁡(\\frac{x}{3})+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "746d1bc6-98ec-59a1-bec6-9dcfb7081a5d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"} {:db/id #edb/ref 17592186048777 :topic/math-academy-id 285 :topic/title "Integrating Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186069047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201f04d6-c002-5e0e-95fe-a7bfb6f3cd47" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266427} {:answer/id #uuid "4017a737-6567-579a-8f02-98712b431a35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266723} {:answer/id #uuid "928bb7be-da0b-5934-b68c-38f79005663e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186267450} {:answer/id #uuid "932c94aa-6652-5204-910b-18fdb3861f29" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267461} {:answer/id #uuid "99faa052-1151-586c-8bf2-0746b9af0da9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267536}] :answer-field/correct {:answer/id #uuid "4017a737-6567-579a-8f02-98712b431a35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266723} :answer-field/id #uuid "0b6fc5f0-4245-5250-93b5-36ad6b67d400" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9e8b61bc-bb4e-5bb5-ab6c-973e00e2baa2" :question/math-academy-id "q-13647" :question/problem "${\\int }_{0}^{\\pi /8}5\\operatorname{sin}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "If we let $u=4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /8$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /8}5\\operatorname{sin}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}5\\operatorname{sin}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{5}{4}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{5}{4}\\operatorname{cos}⁡u{|}_{0}^{\\pi /2} \\\\  & =-\\frac{5}{4}(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{5}{4}(0-1) \\\\  & =\\frac{5}{4}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de554e76-bfb8-5794-8ac9-2f13ece1fe32" :answer/type {:db/ident :answer.type/math} :answe