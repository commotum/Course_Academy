nolimits} \\int\\sech^{2} (\\frac{1x}{5})\\,\\mathrm{d}x$." :question/worked-solution "Let $u=\\frac{1x}{5}$. Differentiating gives $\\mathrm{d}u=\\frac{1}{5}\\,\\mathrm{d}x$, so $\\mathrm{d}x=5\\,\\mathrm{d}u$.\n\nUsing the substitution and $\\frac{\\mathrm{d}}{\\mathrm{d}u}\\tanh u=\\sech^2 u$,\n\n$$\\begin{aligned}\n\\int\\sech^2(\\frac{1x}{5})\\,\\mathrm{d}x\n&=5\\int\\sech^2 u\\,\\mathrm{d}u \\\\\n&=5\\tanh u+C \\\\\n&=5\\tanh(\\frac{1x}{5})+C.\n\\end{aligned}$$\n\nThe argument is linear and the integrand is defined for every real $x$."} {:db/id #edb/ref 17592186490437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44b9b739-0082-5682-b520-b9df05781ad7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(\\sech 6 - \\sech 12)" :db/id #edb/ref 17592186490429} {:answer/id #uuid "78112faf-62ed-5629-9fd8-a061022f3a70" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(\\tanh 2 - \\tanh 6)" :db/id #edb/ref 17592186490441} {:answer/id #uuid "9538f564-6267-537c-9772-4dca5bf4e66e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(\\sech 6 - \\sech 2)" :db/id #edb/ref 17592186490452} {:answer/id #uuid "d418fdcd-5f31-530f-899f-e7240d74ca22" :answer/type {:db/ident :answer.type/math} :answer/value "6(\\sech 2 - \\sech 6)" :db/id #edb/ref 17592186490472} {:answer/id #uuid "dce4d9e0-6d47-5cf4-af0d-812e09ee29c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(\\tanh^{2} 12)" :db/id #edb/ref 17592186490475}] :answer-field/correct {:answer/id #uuid "44b9b739-0082-5682-b520-b9df05781ad7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}(\\sech 6 - \\sech 12)" :db/id #edb/ref 17592186490429} :answer-field/id #uuid "98fabf30-b390-5e77-a63f-49f5b1f78c1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490453}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "671810fd-a971-5119-a687-026670ace5f8" :question/problem "Evaluate the integral $\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\int_{1}^{2}\\sech 6x\\tanh 6x\\,\\mathrm{d}x$." :question/worked-solution "Let $u=6x$. Then $\\mathrm{d}x=\\frac{1}{6}\\,\\mathrm{d}u$. When $x=1$, $u=6$; when $x=2$, $u=12$.\n\nUsing $\\frac{\\mathrm{d}}{\\mathrm{d}u}\\sech u=-\\sech u\\tanh u$,\n\n$$\\begin{aligned}\n\\int_1^2\\sech(6x)\\tanh(6x)\\,\\mathrm{d}x\n&=\\frac{1}{6}\\int_{6}^{12}\\sech u\\tanh u\\,\\mathrm{d}u \\\\\n&=\\frac{1}{6}[-\\sech u]_{6}^{12} \\\\\n&=\\frac{1}{6}(\\sech 6-\\sech 12).\n\\end{aligned}$$\n\nThe integrand is continuous on $[1,2]$, and the result is positive because $\\sech u$ decreases for $u>0$."} {:db/id #edb/ref 17592186490446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "513cfd57-8b76-5695-a4cc-1e0ae9c95fae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\tanh 2 - \\tanh 4)" :db/id #edb/ref 17592186490432} {:answer/id #uuid "53177d99-1856-5469-b40b-4256cee29795" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\sech 4 - \\sech 2)" :db/id #edb/ref 17592186490434} {:answer/id #uuid "6e5ca4ce-57a7-5b6c-941a-c4405005a9bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\sech 4 - \\sech 8)" :db/id #edb/ref 17592186490438} {:answer/id #uuid "a1bf8a5d-f199-5d75-9adf-22cf0be0c99f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\tanh^{2} 8)" :db/id #edb/ref 17592186490457} {:answer/id #uuid "b4c8b8a6-3940-5b4f-a185-ff227446647f" :answer/type {:db/ident :answer.type/math} :answer/value "4(\\sech 2 - \\sech 4)" :db/id #edb/ref 17592186490462}] :answer-field/correct {:answer/id #uuid "6e5ca4ce-57a7-5b6c-941a-c4405005a9bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}(\\sech 4 - \\sech 8)" :db/id #edb/ref 17592186490438} :answer-field/id #uuid "b56cdf4a-dbbc-5251-8d80-2a7325d85f3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490463}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "83dcbf6a-fff6-598d-b0b3-c3120f6ec8cb" :question/problem "Evaluate the integral $\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\int_{1}^{2}\\sech 4x\\tanh 4x\\,\\mathrm{d}x$." :question/worked-solution "Let $u=4x$. Then $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. When $x=1$, $u=4$; when $x=2$, $u=8$.\n\nUsing $\\frac{\\mathrm{d}}{\\mathrm{d}u}\\sech u=-\\sech u\\tanh u$,\n\n$$\\begin{aligned}\n\\int_1^2\\sech(4x)\\tanh(4x)\\,\\mathrm{d}x\n&=\\frac{1}{4}\\int_{4}^{8}\\sech u\\tanh u\\,\\mathrm{d}u \\\\\n&=\\frac{1}{4}[-\\sech u]_{4}^{8} \\\\\n&=\\frac{1}{4}(\\sech 4-\\sech 8).\n\\end{aligned}$$\n\nThe integrand is continuous on $[1,2]$, and the result is positive because $\\sech u$ decreases for $u>0$."} {:db/id #edb/ref 17592186490449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fc6b1ac-a15b-5c1d-9fb4-1d427038d7f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}(\\sech 7 - \\sech 2)" :db/id #edb/ref 17592186490435} {:answer/id #uuid "8c8e69d4-089b-581f-923d-e3016a9bf309" :answer/type {:db/ident :answer.type/math} :answer/value "7(\\sech 2 - \\sech 7)" :db/id #edb/ref 17592186490448} {:answer/id #uuid "93d8bb7c-ca83-5675-89b9-9b1ab924c667" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}(\\tanh^{2} 14)" :db/id #edb/ref 17592186490451} {:answer/id #uuid "bf434d9b-4a7a-5ef1-af0d-672c641490be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}(\\sech 7 - \\sech 14)" :db/id #edb/ref 17592186490467} {:answer/id #uuid "efbf1426-ae62-5088-9a35-1b2432f08d97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}(\\tanh 2 - \\tanh 7)" :db/id #edb/ref 17592186490477}] :answer-fiel