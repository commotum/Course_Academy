 #uuid "0cccaeda-6ecb-51bb-a2a1-8a0550dfcef2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (\\frac{36}{37})" :db/id #edb/ref 17592186482729} {:answer/id #uuid "2277d424-532e-5ade-9081-473385c6ab7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{6}{7})" :db/id #edb/ref 17592186482735} {:answer/id #uuid "289329bc-db55-55d0-9ee5-8eb6f355da1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{3}{3})" :db/id #edb/ref 17592186482737} {:answer/id #uuid "6ad8cd24-1e02-5134-88d3-3a32a9ee13a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{71}{36})" :db/id #edb/ref 17592186482754} {:answer/id #uuid "731dcae3-1742-5a64-930f-1919e898289a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 36" :db/id #edb/ref 17592186482760}] :answer-field/correct {:answer/id #uuid "6ad8cd24-1e02-5134-88d3-3a32a9ee13a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{71}{36})" :db/id #edb/ref 17592186482754} :answer-field/id #uuid "77e1a9de-780d-510c-8e0f-915271c2447a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482761}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ec2ce764-8489-5f9a-a8a6-a50e646dc3d8" :question/problem "Evaluate the integral\n$\\displaystyle \\int_{0}^{\\ln 6}\\frac{\\cosh x}{3 + \\sinh x}dx$." :question/worked-solution "Let $u=3+\\sinh x$. Differentiating gives $\\mathrm{d}u=\\cosh x\\,\\mathrm{d}x$.\n\nWhen $x=0$, $u=3$. When $x=\\ln 6$,\n\n$$u=3+\\frac{e^{\\ln 6}-e^{-\\ln 6}}{2}\n=3+\\frac{6-\\frac{1}{6}}{2}=\\frac{71}{12}.$$\n\nTherefore,\n\n$$\\begin{aligned}\n\\int_0^{\\ln 6}\\frac{\\cosh x}{3+\\sinh x}\\,\\mathrm{d}x\n&=\\int_3^{\\frac{71}{12}}\\frac{1}{u}\\,\\mathrm{d}u \\\\\n&=\\left[\\ln u\\right]_3^{\\frac{71}{12}} \\\\\n&=\\ln(\\frac{71}{12})-\\ln 3 \\\\\n&=\\ln\\left(\\frac{71}{36}\\right).\n\\end{aligned}$$\n\nHere $u>0$ throughout the interval, so the logarithm and substitution are defined."}] :knowledge-point/title "Integrating Quotients Containing Hyperbolic Functions Using Substitution"}]}
