8e3ed1c9" :answer/type {:db/ident :answer.type/math} :answer/value "-21/25" :db/id #edb/ref 17592186234654}] :answer-field/correct {:answer/id #uuid "47aa2462-582b-5f54-b165-de938e3ed1c9" :answer/type {:db/ident :answer.type/math} :answer/value "-21/25" :db/id #edb/ref 17592186234654} :answer-field/id #uuid "2c10dfd2-d554-554d-aa4d-c8564ac701e2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235017}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "148255e2-2a82-52fa-9fe8-d3d82db03fcc" :question/math-academy-id "q-128332" :question/problem "The slope of the tangent line to the graph of $y=f(x)$ at $x=2$ is\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "The slope of the tangent at $x=2$ is equal to ${f}^{′}(2).$ In part 1, we found\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{7(5-4x)}{(2{x}^{2}-5x-3)^{2}}.\\end{aligned}\n$$\n\nNow, we evaluate at $x=2,$ and we get\n\n$$\n\\begin{aligned}{f}^{′}(2) & =\\frac{7(5-4\\cdot 2)}{(2\\cdot {2}^{2}-5\\cdot 2-3)^{2}} \\\\  & =\\frac{7\\cdot (-3)}{(-5)^{2}} \\\\  & =-\\frac{21}{25}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line to the curve at $x=2$ is $-\\frac{21}{25}.$"} {:db/id #edb/ref 17592186235458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88ca2c1b-08ce-5224-a752-7911554c06e4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234755}] :answer-field/correct {:answer/id #uuid "88ca2c1b-08ce-5224-a752-7911554c06e4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234755} :answer-field/id #uuid "616098ac-de92-57f7-a966-f500d556595b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "840e39fc-48e8-52c6-b612-48460181a806" :question/math-academy-id "q-167637" :question/problem "Find $m,$ the slope of the tangent to the curve $y=k(x)$ at the point where $x=0.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $m=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "We have $k(x)=3{e}^{x}-{x}^{3}-2x.$\n\nThe slope of the tangent at $x=0$ is equal to ${k}^{′}(0).$ From step 6, the derivative is\n\n$$\n{k}^{′}(x)=3{e}^{x}-3{x}^{2}-2.\n$$\n\nNow, we evaluate at $x=0$ and get \n\n$$\n\\begin{aligned}{k}^{′}(0) & =3{e}^{0}-3(0)^{2}-2 \\\\  & =3-0-2 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $1.$"} {:db/id #edb/ref 17592186235472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863f5d65-d013-5eb3-9d59-e2be419a568e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234749}] :answer-field/correct {:answer/id #uuid "863f5d65-d013-5eb3-9d59-e2be419a568e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234749} :answer-field/id #uuid "c02cf8a5-ab39-51c6-aefc-ea37d7693cb5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235211}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7ac78358-12d0-5a70-a560-f137aa0a8466" :question/math-academy-id "q-167695" :question/problem "The slope of the tangent to the curve at $A$ is\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "We use the expression $f(x)={e}^{x}+{x}^{2}+x$ for $x\\le 1.$ The slope of the tangent at $x=0$ is equal to ${f}^{′}(0).$ In part 5, we found that\n\n$$\n{f}^{′}(x)={e}^{x}+2x+1,\\,x<1.\n$$\n\nNow, we evaluate at $x=0$ and get\n\n$$\n\\begin{aligned}{f}^{′}(0) & ={e}^{0}+2(0)+1 \\\\  & =1+0+1 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $2.$"} {:db/id #edb/ref 17592186244051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fefa26e-2fa6-5555-9b69-a7d240be5a20" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186241892} {:answer/id #uuid "a0269731-71e4-57cb-b2bf-778762c3458e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186242582} {:answer/id #uuid "b633bda9-8ab7-5f09-80e4-954614b958e8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186242776} {:answer/id #uuid "c32e4508-9db7-5457-8d2d-5b6f748c8084" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186242895} {:answer/id #uuid "e24cc110-ddde-549b-8668-eef1f4ece3eb" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186243189}] :answer-field/correct {:answer/id #uuid "b633bda9-8ab7-5f09-80e4-954614b958e8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186242776} :answer-field/id #uuid "3487c206-b655-58a4-86d6-b718ccbb64e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243535}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3484b5f4-09f4-5479-950e-a1fa473c555f" :question/math-academy-id "q-10742" :question/problem "Find the slope of the tangent to the curve $y={x}^{7}-6{x}^{5}-2670x$ at the point where $x=3.$" :question/worked-solution "Let $f(x)={x}^{7}-6{x}^{5}-2670x.$ The slope of the tangent at $x=3$ is equal to ${f}^{′}(3).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{7}-6{x}^{5}-2670x) \\\\  & =7{x}^{6}-30{x}^{4}-2670.\\end{aligned}\n$$\n\nNow, we evaluate at $x=3$ and get\n\n$$\n\\begin{aligned}{f}^{′}(3) & =7(3{)}^{6}-30(3{)}^{4}-2670 \\\\  & =5103-2430-2670 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $3.$"} {:db/id #edb/ref 17592186287885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08edecd9-7498-5687-8250-29e2c7131bec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{95}{3}" :db/id #edb/ref 17592186284859} {:answer/id #uuid "5a2939f5-96ff-54e4-8c3c-4c886ba2b863" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{95}{2}" :db/id #edb/ref 17592186285613} {:answer/id #uuid "83ead110-58a5-573d-8e09-09af7514676b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{93}{4}" :db/id #edb/ref 17592186285999} {:answer/id #uuid "c530b1b4-c88b-5a99-bded-79c45e050302" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{95}{4}" :db/id #edb/ref 17592186286594} {:answer/id #uuid "ede9faa0-e803-5e71-a16f-7b1bce45810a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{97}{4}" :db/id #edb/ref 17592186286968}] :answer-field/correct {:answer/id #uuid "c530b1b4-c88b-5a99-bded-79c45e050302" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{95}{4}" :db/id #edb/ref 17592186286594} :answer-field/id #uuid "4cec6592-976b-5435-b95c-029220036c90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287319}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7c4e8d46-ac88-5164-bd4b-77084f860e6f" :question/math-academy-id "q-1853" :question/problem "Find the slope of the tangent to the curve $y=3{x}^{4}-6{x}^{3}+\\frac{1}{x}$ at the point where $x=2.$" :question/worked-solution "Let $f(x)=3{x}^{4}-6{x}^{3}+\\frac{1}{x}.$ The slope of the tangent at $x=2$ is equal to ${f}^{′}(2).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}-6{x}^{3}+\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}-6{x}^{3}+{x}^{-1}) \\\\  & =4\\cdot 3{x}^{3}-3\\cdot 6{x}^{2}-{x}^{-2} \\\\  & =12{x}^{3}-18{x}^{2}-{x}^{-2}.\\end{aligned}\n$$\n\nNow, we evaluate at $x=2$ and get\n\n$$\n\\begin{aligned}{f}^{′}(2) & =12(2{)}^{3}-18(2{)}^{2}-(2{)}^{-2} \\\\  & =96-72-\\frac{1}{4} \\\\  & =\\frac{95}{4}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\frac{95}{4}.$"} {:db/id #edb/ref 17592186317207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63d0f5cd-46a4-50a2-9dba-19216ba7ae0d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186315677}] :answer-field/correct {:answer/id #uuid "63d0f5cd-46a4-50a2-9dba-19216ba7ae0d" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186315677} :answer-field/id #uuid "8828ce43-bf6b-5f4e-a9cc-7e80e96e6b8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316861}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "539fc4f1-fdc4-53aa-aff9-dc358cfa0420" :question/math-academy-id "q-342107" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y={x}^{6}-4{x}^{4}+8{x}^{2}-4$ at the point where $x=-1.$\n\n$m=$\n{{field-1}}" :question/worked-solution "Let $f(x)=({x}^{2}-1{)}^{3}+3.$ The slope of the tangent at $x=-1$ is equal to ${f}^{′}(-1).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{d}{dx}\\,({x}^{6}-4{x}^{4}+8{x}^{2}-4) \\\\  & =6{x}^{5}-4(4{x}^{3})+8(2x)-0 \\\\  & =6{x}^{5}-16{x}^{3}+16x.\\end{aligned}\n$$\n\nNow, we evaluate at $x=-1$ and get\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =6(-1{)}^{5}-16(-1{)}^{3}+16(-1) \\\\  & =-6+16-16 \\\\  & =-6.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at $x=-1$ is\n\n$$\nm={f}^{′}(-1)=-6.\n$$"} {:db/id #edb/ref 17592186317341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8de4250-244c-599d-8ad8-6dcd8ea0d782" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186316065}] :answer-field/correct {:answer/id #uuid "a8de4250-244c-599d-8ad8-6dcd8ea0d782" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186316065} :answer-field/id #uuid "59da1fc4-190c-51ce-89c1-86dc868f0ac8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316756}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9ce56e89-e4a0-55d3-bc60-994f61368da9" :question/math-academy-id "q-342937" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=-2{x}^{2}+\\frac{1}{(x-2{)}^{2}}$ at the point where $x=3.$\n\n$m=$\n{{field-1}}" :question/worked-solution "Let $f(x)=-2{x}^{2}+\\frac{1}{(x-2{)}^{2}}.$ The slope of the tangent at $x=3$ is equal to ${f}^{′}(3).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{2}+\\frac{1}{(x-2{)}^{2}}) \\\\  & =-4x+(-2(x-2{)}^{-3}) \\\\  & =-4x-\\frac{2}{(x-2{)}^{3}}.\\end{aligned}\n$$\n\nNow, we evaluate at $x=3$ and get\n\n$$\n\\begin{aligned}{f}^{′}(3) & =-4(3)-\\frac{2}{(3-2{)}^{3}} \\\\  & =-12-2 \\\\  & =-14.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at $x=3$ is\n\n$$\nm={f}^{′}(3)=-14.\n$$"} {:db/id #edb/ref 17592186317342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f9acd4b-e9fa-5157-9c6b-9e6e7b92d98b" :answer/type {:db/ident :answer.type/math} :answer/value "-80/9" :db/id #edb/ref 17592186315572}] :answer-field/correct {:answer/id #uuid "4f9acd4b-e9fa-5157-9c6b-9e6e7b92d98b" :answer/type {:db/ident :answer.type/math} :answer/value "-80/9" :db/id #edb/ref 17592186315572} :answer-field/id #uuid "904bde89-fd81-5c60-8d85-fd0811a7990e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316878}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f8271ee-facf-5afc-aacd-f55d8d375bb4" :question/math-academy-id "q-342942" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=2{x}^{4}-7{x}^{3}-6{x}^{2}-\\frac{1}{x}$ at the point where $x=3.$\n\n$m=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2{x}^{4}-7{x}^{3}-6{x}^{2}-\\frac{1}{x}.$ The slope of the tangent at $x=3$ is equal to ${f}^{′}(3).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{4}-7{x}^{3}-6{x}^{2}-\\frac{1}{x}) \\\\  & =2\\cdot 4{x}^{3}-7\\cdot 3{x}^{2}-6\\cdot 2x+{x}^{-2} \\\\  & =8{x}^{3}-21{x}^{2}-12x+\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nNow, we evaluate at $x=3$ and get\n\n$$\n\\begin{aligned}{f}^{′}(3) & =8({3}^{3})-21({3}^{2})-12(3)+\\frac{1}{{3}^{2}} \\\\  & =216-189-36+\\frac{1}{9} \\\\  & =-9+\\frac{1}{9} \\\\  & =-\\frac{80}{9}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at $x=3$ is\n\n$$\nm={f}^{′}(3)=-\\frac{80}{9}.\n$$"} {:db/id #edb/ref 17592186510702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "feddfbf6-7252-533d-8d94-cfc4865d5046" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186510718}] :answer-field/correct {:answer/id #uuid "feddfbf6-7252-533d-8d94-cfc4865d5046" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186510718} :answer-field/id #uuid "1bc61bdd-576b-5352-ba4d-c3039d7d23da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510703}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "16c505e0-5d29-5749-bc56-753e338dddc8" :question/problem "Find $m,$ the slope of the tangent to the curve $y=k(x)$ at the point where $x=0.$\n\nWe have $k(x)=-x^{3} -4 x + 4 e^{x}$ and $k^{\\prime}(x)=-3 x^{2} + 4 e^{x} -4.$\n\n$m=$\n{{field-1}}" :question/worked-solution "We have $k(x)=-x^{3} -4 x + 4 e^{x}.$ The slope of the tangent at $x=0$ is equal to $k^{\\prime}(0).$ The given derivative is\n\n$$\nk^{\\prime}(x)=-3 x^{2} + 4 e^{x} -4.\n$$\n\nNow, we evaluate at $x=0$ and get\n\n$$\n\\begin{aligned}k^{\\prime}(0) & =-3 (0)^{2} + 4 e^{(0)} -4 \\\\ & =-4+0+4 \\\\ & =0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $0.$"} {:db/id #edb/ref 17592186510704 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4859e2-30ff-519a-9a6c-35af3d551f32" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186510701}] :answer-field/correct {:answer/id #uuid "0a4859e2-30ff-519a-9a6c-35af3d551f32" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186510701} :answer-field/id #uuid "d52995ac-26e6-5baf-863a-2d28b3cb00b8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510714}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "23f74b85-e755-53c7-b42c-a010cf3710be" :question/problem "Find $m,$ the slope of the tangent to the curve $y=k(x)$ at the point where $x=0.$\n\nWe have $k(x)=-x^{3} -5 x + 5 e^{x}$ and $k^{\\prime}(x)=-3 x^{2} + 5 e^{x} -5.$\n\n$m=$\n{{field-1}}" :question/worked-solution "We have $k(x)=-x^{3} -5 x + 5 e^{x}.$ The slope of the tangent at $x=0$ is equal to $k^{\\prime}(0).$ The given derivative is\n\n$$\nk^{\\prime}(x)=-3 x^{2} + 5 e^{x} -5.\n$$\n\nNow, we evaluate at $x=0$ and get\n\n$$\n\\begin{aligned}k^{\\prime}(0) & =-3 (0)^{2} + 5 e^{(0)} -5 \\\\ & =-5+0+5 \\\\ & =0.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $0.$"} {:db/id #edb/ref 17592186510707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d07a24ec-f343-50fa-bb00-c0033bb8788f" :answer/type {:db/ident :answer.type/math} :answer/value "3585/16" :db/id #edb/ref 17592186510712}] :answer-field/correct {:answer/id #uuid "d07a24ec-f343-50fa-bb00-c0033bb8788f" :answer/type {:db/ident :answer.type/math} :answer/value "3585/16" :db/id #edb/ref 17592186510712} :answer-field/id #uuid "dbcf1c49-7241-5d03-94fd-bfa2c1d44ecf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510715}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5280129d-18fb-5b8f-bb02-d86a2b5535fa" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=2 x^{4} -5 x^{3} -6 x^{2} -\\frac{1}{x}$ at the point where $x=4.$\n\n$m=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2 x^{4} -5 x^{3} -6 x^{2} -\\frac{1}{x}.$ The slope of the tangent at $x=4$ is equal to $f^{\\prime}(4).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}f^{\\prime}(x) & =\\frac{\\text{d}}{\\text{d}x}(2 x^{4} -5 x^{3} -6 x^{2} -\\frac{1}{x}) \\\\ & =2\\cdot4x^{3}-5\\cdot3x^{2}-6\\cdot2x+x^{-2} \\\\ & =8 x^{3} -15 x^{2} -12 x + \\frac{1}{x^{2}}.\\end{aligned}\n$$\n\nNow, we evaluate at $x=4$ and get\n\n$$\n\\begin{aligned}f^{\\prime}(4) & =8 (4)^{3} -15 (4)^{2} -12 (4) + \\frac{1}{(4)^{2}} \\\\ & =\\frac{1}{16}-240-48+512 \\\\ & =224+\\frac{1}{16} \\\\ & =\\frac{3585}{16}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at $x=4$ is\n\n$$\nm=f^{\\prime}(4)=\\frac{3585}{16}.\n$$"} {:db/id #edb/ref 17592186510708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48da9c19-eb94-57e4-ab53-e522cd3c9230" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186510706}] :answer-field/correct {:answer/id #uuid "48da9c19-eb94-57e4-ab53-e522cd3c9230" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186510706} :answer-field/id #uuid "e54b6005-dbbf-5b97-9101-9359c6e3889a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510717}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "689248f2-21f8-5d24-90d8-7ca8fd740f53" :question/problem "Find $m,$ the slope of the tangent to the curve $y=k(x)$ at the point where $x=0.$\n\nWe have $k(x)=-x^{3} -2 x + 6 e^{x}$ and $k^{\\prime}(x)=-3 x^{2} + 6 e^{x} -2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "We have $k(x)=-x^{3} -2 x + 6 e^{x}.$ The slope of the tangent at $x=0$ is equal to $k^{\\prime}(0).$ The given derivative is\n\n$$\nk^{\\prime}(x)=-3 x^{2} + 6 e^{x} -2.\n$$\n\nNow, we evaluate at $x=0$ and get\n\n$$\n\\begin{aligned}k^{\\prime}(0) & =-3 (0)^{2} + 6 e^{(0)} -2 \\\\ & =-2+0+6 \\\\ & =4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $4.$"} {:db/id #edb/ref 17592186510709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76abe992-bbf1-5cfa-87c6-f978c497f36b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186510710}] :answer-field/correct {:answer/id #uuid "76abe992-bbf1-5cfa-87c6-f978c497f36b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186510710} :answer-field/id #uuid "d3e4dd70-afe4-5747-9b07-4ef72dea046e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510713}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "75d5858a-47f7-5c0c-b41e-cfdd00aba409" :question/problem "Find $m,$ the slope of the tangent to the curve $y=k(x)$ at the point where $x=0.$\n\nWe have $k(x)=-x^{3} -4 x + 6 e^{x}$ and $k^{\\prime}(x)=-3 x^{2} + 6 e^{x} -4.$\n\n$m=$\n{{field-1}}" :question/worked-solution "We have $k(x)=-x^{3} -4 x + 6 e^{x}.$ The slope of the tangent at $x=0$ is equal to $k^{\\prime}(0).$ The given derivative is\n\n$$\nk^{\\prime}(x)=-3 x^{2} + 6 e^{x} -4.\n$$\n\nNow, we evaluate at $x=0$ and get\n\n$$\n\\begin{aligned}k^{\\prime}(0) & =-3 (0)^{2} + 6 e^{(0)} -4 \\\\ & =-4+0+6 \\\\ & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $2.$"} {:db/id #edb/ref 17592186510711 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e7afbec-5a92-5243-80c2-e91712f44bfe" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186510705}] :answer-field/correct {:answer/id #uuid "3e7afbec-5a92-5243-80c2-e91712f44bfe" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186510705} :answer-field/id #uuid "e3374900-12ae-50ac-9f6c-160897350c5c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510716}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b38d997b-b6bd-5955-ad93-8d9cd05fb5df" :question/problem "Find $m,$ the slope of the tangent to the curve $y=k(x)$ at the point where $x=0.$\n\nWe have $k(x)=-x^{3} -3 x + 5 e^{x}$ and $k^{\\prime}(x)=-3 x^{2} + 5 e^{x} -3.$\n\n$m=$\n{{field-1}}" :question/worked-solution "We have $k(x)=-x^{3} -3 x + 5 e^{x}.$ The slope of the tangent at $x=0$ is equal to $k^{\\prime}(0).$ The given derivative is\n\n$$\nk^{\\prime}(x)=-3 x^{2} + 5 e^{x} -3.\n$$\n\nNow, we evaluate at $x=0$ and get\n\n$$\n\\begin{aligned}k^{\\prime}(0) & =-3 (0)^{2} + 5 e^{(0)} -3 \\\\ & =-3+0+5 \\\\ & =2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $2.$"}] :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve at a Given Point"}] [{:db/id #edb/ref 17592186064343 :knowledge-point/canonical-example {:db/id #edb/ref 17592186063983 :question/id #uuid "3138f267-3903-510c-86e8-5597d3689262" :question/math-academy-id "e-143" :question/problem "What is the slope of the tangent to the curve $y = x^4 + 3\\sqrt [3]{x^2}$ at the point $(1,4)?$" :question/worked-solution "This time, we'll use $\\dfrac{\\textrm d y}{\\textrm d x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+3\\sqrt[3]{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+3{x}^{2/3}) \\\\  & =4\\cdot {x}^{3}+3\\cdot \\frac{2}{3}\\cdot {x}^{-1/3} \\\\  & =4{x}^{3}+2{x}^{-1/3}.\\end{aligned}\n$$\n\nEvaluating at $x=1$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =4(1{)}^{3}+2(1{)}^{-1/3} \\\\  & =4+2 \\\\  & =6\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $6.$"} :knowledge-point/id #uuid "3ca13570-d504-53e6-8e02-0f1e85047a3e" :knowledge-point/questions [{:db/id #edb/ref 17592186064534 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80bd3d5d-7aff-5a42-83fa-ba1927818c93" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186061400} {:answer/id #uuid "b1a16a6b-137a-50c0-a444-9c3d7b17a6c3" :answer/type {:db/ident :answer.type/math} :answer/value "11^{1/4}" :db/id #edb/ref 17592186061401} {:answer/id #uuid "c0df2c06-5a97-51cc-812f-585c9b0aa742" :answer/type {:db/ident :answer.type/math} :answer/value "-35" :db/id #edb/ref 17592186061402} {:answer/id #uuid "d03708dc-5