$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-3\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t+4{cos}^{2}⁡t}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c46a2e-4e00-5991-99c9-9dc68c9a9598" :answer/type {:db/ident :answer.type/math} :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401050} {:answer/id #uuid "2499ce46-f979-5a96-92be-fd0c7ac31bf7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401051} {:answer/id #uuid "61eb1149-6ab5-5e3a-8377-404854e1b082" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{2{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401052} {:answer/id #uuid "7ed903c6-dd0e-5b89-95d6-7cb6b868a842" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{3{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186401053} {:answer/id #uuid "d4b764bb-1a8d-5c44-bf30-3132c5443550" :answer/type {:db/ident :answer.type/math} :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186401054}] :answer-field/correct {:answer/id #uuid "2499ce46-f979-5a96-92be-fd0c7ac31bf7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id 