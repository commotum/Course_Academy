}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71b63c40-4166-58be-98ca-c4f5edc13748" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+t}\\,\\text{d}t" :db/id #edb/ref 17592186400074} {:answer/id #uuid "e8a8ab40-ccbb-5118-b2d9-f78348093f93" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186400075} {:answer/id #uuid "b749b256-812c-5226-8d12-e7a772eb2ad5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+3}\\,\\text{d}t" :db/id #edb/ref 17592186400076} {:answer/id #uuid "c9a93f8e-9a44-5007-89a0-efaebde7602c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+2}\\,\\text{d}t" :db/id #edb/ref 17592186400077} {:answer/id #uuid "bded8aee-c9b6-50a7-9080-88cf30b26b0a" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186400078}] :answer-field/correct {:answer/id #uuid "e8a8ab40-ccbb-5118-b2d9-f78348093f93" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186400075} :answer-field/id #uuid "d769d84c-e8c5-56e0-8e28-ef7348f0bb6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ce632c36-0a89-59ca-a425-8c378bad7972" :question/math-academy-id "q-123020" :question/problem "![](images/ae/ae210abc4028440aa9c822510d68f0ab0b8ba4b9f5806dd299149e953ccd1b21.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-4,\\,y=2t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2t)=2.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(2)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "925080f9-1488-5ed3-9988-57bac8e25aa1" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+2t+4}\\,\\text{d}t" :db/id #edb/ref 17592186401036} {:answer/id #uuid "8b14ae74-d72b-5c6f-bfb4-9fdf19b4b592" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+4}\\,\\text{d}t" :db/id #edb/ref 17592186401037} {:answer/id #uuid "c911c453-c1b3-506d-a7de-c8341e32d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/id #edb/ref 17592186401038} {:answer/id #uuid "69aeb839-370f-503b-8dde-d870cf822808" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}t\\sqrt{3{t}^{2}+2}\\,\\text{d}t" :db/id #edb/ref 17592186401039} {:answer/id #uuid "e1915447-2ced-5598-8af5-d918f3a8a810" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+24t+8}\\,\\text{d}t" :db/id #edb/ref 17592186401040}] :answer-field/correct {:answer/id #uuid "c911c453-c1b3-506d-a7de-c8341e32d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/id #edb/ref 17592186401038} :answer-field/id #uuid "9ac60323-fbe0-5435-bfb2-619a71c7a175" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dddf8a10-d360-5144-aae4-5bd6e2bd6915" :question/math-academy-id "q-15174" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+{t}^{2},\\,y={t}^{3}-{t}^{2}$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})=3{t}^{2}+2t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})=3{t}^{2}-2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(3{t}^{2}+2t)}^{2}+{(3{t}^{2}-2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+12{t}^{3}+4{t}^{2}+9{t}^{4}-12{t}^{3}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{18{t}^{4}+8{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve"}] [{:db/id #edb/ref 17592186092376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092113 :question/id #uuid "5bae6269-2112-56ea-b123-bee58701cf87" :question/math-academy-id "e-7130" :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](images/48/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(\\operatorname{cos}⁡t))=-\\operatorname{tan}⁡t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(1)}^{2}+{(-\\operatorname{tan}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+{tan}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{sec}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡t\\,\\text{d}t\\,.\\end{aligned}\n$$"} :knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048191 :topic/math-academy-id 1115 :topic/title "Selecting Procedures for Calculating Derivatives"} {:db/id #edb/ref 17592186049488 :topic/math-academy-id 207 :topic/title "Simplifying Expressions Using the Pythagorean Identity"}] :knowledge-point/questions [{:db/id #edb/ref 17592186092573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac7208bd-8759-509f-aec8-b72d63dc377b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{2\\sin^{2} (4t) + \\cos^{2} (t)}dt" :db/id #edb/ref 17592186089610} {:answer/id #uuid "c8e4a462-def2-5041-9d86-629d00d6c6f1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2}\\sqrt{\\sin^{2} (4t) + \\cos^{2} (t)}dt" :db/id #edb/ref 17592186089611} {:answer/id #uuid "e3499abe-efbf-509e-ba00-61325a39091c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{2\\cos^{2} (4t) + \\sin^{2} (t)}dt" :db/id #edb/ref 17592186089612} {:answer/id #uuid "e87d0171-bd01-58f1-a2a4-2a22124be105" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2}\\sqrt{\\cos^{2} (4t) + \\sin^{2} (t)}dt" :db/id #edb/ref 17592186089613} {:answer/id #uuid "3bf170f4-362e-577e-893f-a65fc8d4acae" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{\\cos^{2} (4t) + 2\\sin^{2} (t)}dt" :db/id #edb/ref 17592186089614}] :answer-field/id #uuid "13fc5e26-b2f3-5efb-bf53-9cf5f0c83d92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089609}] :question/id #uuid "2ac73185-5f28-5b9e-aeb9-15f1142ceee2" :question/math-academy-id "q-15155" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x = 1 + \\sin (4t), y = 4\\cos (t)$\nfrom $t = 0$ to $t = 2$?"} {:db/id #edb/ref 17592186092575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c02db39-1323-5178-823d-035cbc0e974b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273319} {:answer/id #uuid "76f538de-df54-5fad-9a26-4e6bcab7eb7a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273399} {:answer/id #uuid "7f93ecb1-ea78-5b92-86af-7eaf211452f3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273483} {:answer/id #uuid "a4a2a416-fa2b-57e0-ae21-9414bcd449ab" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273807} {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472}] :answer-field/correct {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472} :answer-field/id #uuid "8d36b979-5ca7-502e-b3f6-581c418d1ffe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d674e5dc-8a57-5368-b53e-8363dba234a5" :question/math-academy-id "q-15185" :question/problem "![](images/80/80577a585741748702b61596db84983592ecbc6c01fca78af033bf82dbe62ad2.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y={e}^{t}\\operatorname{sin}⁡t$\nfrom $t=-3$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)={e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}\\sqrt{{e}^{2t}+{e}^{2t}{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{1+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f016b0-2fd0-50db-a608-6fb63624e44f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+8\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186272994} {:answer/id #uuid "69d385f0-e607-521b-a6d5-ff44ee22ff0c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273301} {:answer/id #uuid "7e8a87c9-2f3a-5822-a579-01d6eb0bbb36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273473} {:answer/id #uuid "8df9ee48-5fdc-55b9-9efb-127f8dd6bac9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273611} {:answer/id #uuid "ad71957f-f727-5cbc-9851-57e268064b02" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+2{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273883}] :answer-field/correct {:answer/id #uuid "7e8a87c9-2f3a-5822-a579-01d6eb0bbb36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273473} :answer-field/id #uuid "18bf7715-0000-5c6a-ac8b-11821a5550c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274679}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b418c2bf-fd1a-57e4-845f-5c5fb4e1bb93" :question/math-academy-id "q-15163" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t+2\\operatorname{sin}⁡(t),\\,y=1+\\operatorname{cos}⁡(2t)$\nfrom $t=2$ to $t=5$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t+2\\operatorname{sin}⁡(t))=1+2\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{(1+2\\operatorname{cos}⁡(t))^{2}+(-2\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186288018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042ce01d-341b-5a8f-b26c-2bae1091ffbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{2{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186284821} {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} {:answer/id #uuid "2277789f-926a-5240-a07d-b7aedc65a771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186285096} {:answer/id #uuid "ca8848d4-7288-585c-b944-73aa40d45c9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{{e}^{t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186286635} {:answer/id #uuid "d0070ef7-3de9-5565-a190-4c165235a08f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186286682}] :answer-field/correct {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} :answer-field/id #uuid "d0b9c64d-9e93-55fe-a0fb-bcc5981e0b91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287575}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "809a8d30-1507-55ed-ad1d-5fa778afd784" :question/math-academy-id "q-20909" :question/problem "![](images/59/59704c6b8e643337113ab99b22eaeaac8d59ac3c15042409e8a0a8eac6ee54fd.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\frac{t}{2},\\,y={e}^{t}$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\nWe have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(\\frac{1}{2})}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{({e}^{2t})+(\\frac{1}{4})}\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1008f91c-5312-57ff-b584-94eee41fe74d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)-2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288152} {:answer/id #uuid "1da60212-9b1b-5f90-b4ad-60a5d028fa99" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)-4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288219} {:answer/id #uuid "2d0f56b4-96f6-5e10-b8c1-e96fcb0adb3d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)+2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288328} {:answer/id #uuid "c400b002-970a-5f9c-b980-7c4fcc67cff4" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(3t)+{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289327} {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641}] :answer-field/correct {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641} :answer-field/id #uuid "92070a66-23e2-56dd-9cc9-c4b8a5e22afc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290057}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6e26edb-f404-57aa-9e8d-fef8eb7ecc78" :question/math-academy-id "q-21339" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=2\\operatorname{sin}⁡(3t)-1,\\,y=2\\operatorname{cos}⁡(2t)+2$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(3t)-1) \\\\  & =2\\operatorname{cos}⁡(3t)\\cdot 3 \\\\  & =6\\operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)+2) \\\\  & =-2\\operatorname{sin}⁡(2t)\\cdot 2 \\\\  & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(6\\operatorname{cos}⁡(3t))^{2}+(-4\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{2}⁡(3t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d3de1db-0fcc-5d54-a34d-c4772f63450c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288331} {:answer/id #uuid "4d6783bc-60cb-5ebf-aed7-e258b2417e6c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{16{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288571} {:answer/id #uuid "72dafc8f-1319-50ac-8575-b91418fddf5c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288830} {:answer/id #uuid "7dd6ac01-4a42-5fe6-a775-9f769a7e8298" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288884} {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967}] :answer-field/correct {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967} :answer-field/id #uuid "3cb71b35-5d29-5e3f-a2c7-defaa9483e1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289861}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "97f4a57c-d78d-5eaa-81d0-22dc3ac7dd99" :question/math-academy-id "q-21347" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{sin}⁡(3t)$\nfrom $t=\\frac{\\pi }{4}$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))=3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{(2\\operatorname{cos}⁡(2t))^{2}+(3\\operatorname{cos}⁡(3t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69475fb9-4639-5aee-af40-ad859a263a2c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186288774} {:answer/id #uuid "91284f31-5e28-57a6-85bb-2b392b818d21" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289008} {:answer/id #uuid "a96e4ea4-d995-5d4a-b26e-2d37c11a1916" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289155} {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} {:answer/id #uuid "ef891aab-5620-5243-8798-2c0bd3ae8835" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(t)-{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289612}] :answer-field/correct {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} :answer-field/id #uuid "0e6962ab-6088-50b4-b289-81a33c131c7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289765}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1524414a-eeb0-5a99-93da-15745003f6ea" :question/math-academy-id "q-21354" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t),\\,y=t-\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{4}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t))=\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡(t))=1-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t))^{2}+(1-\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)+2\\operatorname{cos}⁡(t)\\operatorname{sin}⁡(t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95a19ab2-d61e-5cd4-9296-0ccc2a2ce9cc" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{5{sin}^{2}⁡t-8\\operatorname{sin}⁡t+32}\\,\\text{d}t" :db/id #edb/ref 17592186400081} {:answer/id #uuid "6f516eb5-80db-56b9-88c4-8fec44175002" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t-8\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400082} {:answer/id #uuid "d04936f6-e3a3-5955-87a3-ae992e7c288a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400083} {:answer/id #uuid "25a5d7fc-f3f7-50d4-9122-01398e9fb385" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{8{sin}^{2}⁡t-2\\operatorname{sin}⁡t+8}\\,\\text{d}t" :db/id #edb/ref 17592186400084} {:answer/id #uuid "4e16c553-ec8a-5568-b27c-e4f4689e3032" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400085}] :answer-field/correct {:answer/id #uuid "4e16c553-ec8a-5568-b27c-e4f4689e3032" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400085} :answer-field/id #uuid "51bd27ca-b51f-55c8-a2b1-03c787e77a4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400080}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a37e6009-e864-56bc-93ae-b166a2b05514" :question/math-academy-id "q-123027" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=3\\operatorname{cos}⁡t,\\,y=8t+\\operatorname{cos}⁡t$\nfrom $t=-1$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8t+\\operatorname{cos}⁡t)=8-\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(8-\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t+64-16\\operatorname{sin}⁡t+{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221b2a78-3ed9-5fcc-a904-b72ed2d8cda6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(5t)+36\\operatorname{cos}⁡(6t)}\\,\\text{d}t" :db/id #edb/ref 17592186400088} {:answer/id #uuid "2037ceca-da9b-5e6c-99af-f9e9635c71f9" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{5{sin}^{2}⁡(5t)+6{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400089} {:answer/id #uuid "f6282b39-25dd-527c-8c08-c5ccbd4d5888" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{10{sin}^{2}⁡(5t)+12{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400090} {:answer/id #uuid "3954ccd4-113c-522e-8865-af8dedf5924f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400091} {:answer/id #uuid "5f536300-dcae-55c0-9423-568faa002b3a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400092}] :answer-field/correct {:answer/id #uuid "5f536300-dcae-55c0-9423-568faa002b3a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400092} :answer-field/id #uuid "065d677c-9998-56e4-8b57-ce841d04bf36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400087}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/