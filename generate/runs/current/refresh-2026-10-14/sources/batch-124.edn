nswer-field/choices [{:answer/id #uuid "3deadac5-cdf8-5e75-ae2a-eee2cb807f74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186236203} {:answer/id #uuid "54cffde1-6816-5ea8-8a8e-4bc57d647d91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186236359} {:answer/id #uuid "78d2514a-fc87-5ea2-ba75-c3b0a0228d07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{12}" :db/id #edb/ref 17592186236576} {:answer/id #uuid "97f02cf2-ef1c-5b76-a07d-4960bec8fb03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186236780} {:answer/id #uuid "9d79781a-49cc-5dfd-913b-705f76ced6d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186236801}] :answer-field/correct {:answer/id #uuid "78d2514a-fc87-5ea2-ba75-c3b0a0228d07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{12}" :db/id #edb/ref 17592186236576} :answer-field/id #uuid "f87a24b1-1a6a-5576-8397-9b6e025b871a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237763}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f43899a9-0d39-51e2-a17a-ed84d3a6182c" :question/math-academy-id "q-102224" :question/problem "What is the slope of the tangent to the curve $y=x-\\sqrt[3]{x}$ at the point $(8,6)?$" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x-{x}^{1/3}) \\\\  & =1-\\frac{1}{3}\\cdot {x}^{-2/3} \\\\  & =1-\\frac{1}{3\\sqrt[3]{{x}^{2}}}.\\end{aligned}\n$$\n\nEvaluating at $x=8$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=8} & =1-\\frac{1}{3\\sqrt[3]{{8}^{2}}} \\\\  & =1-\\frac{1}{12} \\\\  & =\\frac{11}{12}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\frac{11}{12}.$"} {:db/id #edb/ref 17592186287908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12fa34e9-36a5-53b0-864e-e49006aea61a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186284955} {:answer/id #uuid "1561d0de-1d9a-5816-adf0-332546be2070" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{64}{3}" :db/id #edb/ref 17592186284975} {:answer/id #uuid "51ff58b7-37eb-5bbc-817d-30f38fc8b966" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{95}{3}" :db/id #edb/ref 17592186285544} {:answer/id #uuid "772b3c2f-b8e6-591c-aa95-2207b2fe7105" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{3}" :db/id #edb/ref 17592186285896} {:answer/id #uuid "a1311533-15e5-55be-95e9-6a13721ea560" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{19}{3}" :db/id #edb/ref 17592186286259}] :answer-field/correct {:answer/id #uuid "772b3c2f-b8e6-591c-aa95-2207b2fe7105" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{62}{3}" :db/id #edb/ref 17592186285896} :answer-field/id #uuid "40852b40-5066-5bb2-baf7-aba2d523557f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287287}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3ab75e26-390f-5656-b37e-13f84729c253" :question/math-academy-id "q-1901" :question/problem "What is the slope of the tangent to the curve $y=5{x}^{4}+\\sqrt[3]{{x}^{2}}$ at the point $(1,6)?$" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+\\sqrt[3]{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+{x}^{2/3}) \\\\  & =4\\cdot 5{x}^{3}+\\frac{2}{3}\\cdot {x}^{-1/3} \\\\  & =20{x}^{3}+\\frac{2{x}^{-1/3}}{3}.\\end{aligned}\n$$\n\nEvaluating at $x=1$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & =20(1{)}^{3}+\\frac{2(1{)}^{-1/3}}{3} \\\\  & =20+\\frac{2}{3} \\\\  & =\\frac{62}{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent to the curve is $\\frac{62}{3}.$"} {:db/id #edb/ref 17592186297293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38eb4046-4c7a-5ac7-8681-c5433d9c769b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186295590}] :answer-field/correct {:answer/id #uuid "38eb4046-4c7a-5ac7-8681-c5433d9c769b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186295590} :answer-field/id #uuid "765ee05d-d577-5c70-860a-1a3a3269b893" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296877}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8d2746f0-484f-5af7-8356-aa63ec30ff54" :question/math-academy-id "q-304130" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=4x-2\\sqrt{x}$ at the point $(4,12).$\n\n$m=$\n{{field-1}}" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4x-2\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x-2{x}^{1/2}) \\\\  & =4-2\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =4-\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nEvaluating at $x=4$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =4-\\frac{1}{\\sqrt{4}} \\\\  & =4-\\frac{1}{2} \\\\  & =\\frac{7}{2}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(4,12)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=4}=\\frac{7}{2}.\n$$"} {:db/id #edb/ref 17592186317353 :question/answer-fields [{:answer-f