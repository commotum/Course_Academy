 sec⁡xtan⁡x\\,\\text{d}x \\\\  & =3tan⁡x+8sec⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Secant Squared"}] [{:db/id #edb/ref 17592186064181 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064055 :question/id #uuid "c2c57145-3988-5ce8-b13f-114bba6964f7" :question/math-academy-id "e-385" :question/problem "Calculate the integral $\\displaystyle{\\int} \\csc{x}(\\csc{x}+3\\cot{x} )\\, \\textrm{d}x.$" :question/worked-solution "Recall that \n\n$$\n\\int \\csc^2 x \\, \\textrm dx = -\\cot x + C\n$$\n\nand\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = -\\csc x + C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\int csc⁡x(csc⁡x+3cot⁡x)\\,\\text{d}x & =\\int {csc}^{2}⁡x+3csc⁡xcot⁡x\\,\\text{d}x \\\\  & =\\int {csc}^{2}⁡x\\,\\text{d}x+3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-cot⁡x-3csc⁡x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/questions [{:db/id #edb/ref 17592186064561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9514139-a2a6-5bd1-bb22-a30d378fed2d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cot θ + C" :db/id #edb/ref 17592186061562} {:answer/id #uuid "eed4872a-677e-5bf1-9ac1-7745c22f9811" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\tan θ + C" :db/id #edb/ref 17592186061563} {:answer/id #uuid "4f6be769-be0c-59d8-bd08-5ab42211e71c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sec θ\\tan θ + C" :db/id #edb/ref 17592186061564} {:answer/id #uuid "79f7d61a-0f09-5604-afcb-63f1ca08625f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec θ\\tan θ + C" :db/id #edb/ref 17592186061565} {:answer/id #uuid "7c16845b-ee60-53a2-94c3-5af50addf2ec" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cot θ + C" :db/id #edb/ref 17592186061566}] :answer-field/id #uuid "5658b5a3-e942-5c71-a410-d4ed8e5b7170" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/