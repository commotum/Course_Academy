a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cos x" :db/id #edb/ref 17592186513601}] :answer-field/correct {:answer/id #uuid "1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cos x" :db/id #edb/ref 17592186513601} :answer-field/id #uuid "685c059e-7098-5c75-b848-36830bd2c7c1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514277}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2932e26e-2b57-549a-866d-7abe171c7f20" :question/math-academy-id "q-166078" :question/problem "$\\int h(x)\\,\\text{d}x\\,=${{field-1}}\n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int h(x)\\,\\text{d}x & =\\int -4\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{cos}⁡x+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] :knowledge-point/title "Integrating Sine and Cosine"}] [{:db/id #edb/ref 17592186064179 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064053 :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/math-academy-id "e-383" :question/problem "Calculate $\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x.$" :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = - \\csc x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-csc⁡xcot⁡x)\\,\\text{d}x & =-\\int (csc⁡xcot⁡x)\\,\\text{d}x \\\\  & =-(-csc⁡x)+C \\\\  & =csc⁡x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050985 :topic/math-academy-id 1686 :topic/title "Differentiating Reciprocal Trigonometric Functions"}] :knowledge-point