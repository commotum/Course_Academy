#{[{:db/id #edb/ref 17592186119849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119663 :question/id #uuid "b3e4eb01-0669-586b-a716-aef87d1c3580" :question/math-academy-id "e-5418" :question/problem "If ![](images/82/823965b7b8f818ec843aefc4c4cc16ef2922e269db8d53f37cf633ff132e5783.svg), find $\\textrm{rank}(A).$" :question/worked-solution "To find the rank of $A,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}2 & 3 & 0 \\\\ 0 & -1 & 5 \\\\ -4 & 0 & 5\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & 3 & 0 \\\\ 0 & -1 & 5 \\\\ 0 & 6 & 5\\end{bmatrix} & {R}_{3} & :={R}_{3}+6{R}_{2} \\\\  & ∼\\begin{bmatrix}2 & 3 & 0 \\\\ 0 & -1 & 5 \\\\ 0 & 0 & 35\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix above has $3$ pivot columns (or, alternatively, it has exactly $3$ non-zero rows).\n\nTherefore, $\\textrm{rank}(A)=3.$"} :knowledge-point/id #uuid "7f5a44c9-16e5-55fb-a10f-15435a0a9a4c" :knowledge-point/questions [{:db/id #edb/ref 17592186120385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14dd34ba-9468-53a2-9845-eb4e8b38ec6d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186118425} {:answer/id #uuid "20b42974-83ae-5b86-b797-0829b8502639" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186118426} {:answer/id #uuid "322af0d7-24f2-512e-9eff-37e8df93d8cf" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186118427} {:answer/id #uuid "5e3f285d-e591-56e3-b453-bdbb2b362acc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186118428} {:answer/id #uuid "73d77042-6226-5a29-929f-8ecb249e7be0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186118429}] :answer-field/correct {:answer/id #uuid "73d77042-6226-5a29-929f-8ecb249e7be0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186118429} :answer-field/id #uuid "9e59740f-515b-5ab1-932f-8cfe0a24239f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118424}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e13c820e-af56-5b5b-820f-610b6109dac0" :question/math-academy-id "q-35278" :question/problem "If \n$A=\\begin{bmatrix}-2 & 1 & 3 & -2 \\\\ 6 & -2 & -7 & 5 \\\\ 0 & 2 & 4 & -3 \\\\ 0 & -3 & -6 & 3\\end{bmatrix}$, find $\\text{rank}(A).$" :question/worked-solution "To find the rank of $A,$ we first reduce it to row echelon form, as follows:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-2 & 1 & 3 & -2 \\\\ 6 & -2 & -7 & 5 \\\\ 0 & 2 & 4 & -3 \\\\ 0 & -3 & -6 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & 1 & 3 & -2 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & 2 & 4 & -3 \\\\ 0 & -3 & -6 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 1 & 3 & -2 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & -3 & -6 & 3\\end{bmatrix} & {R}_{4} & :={R}_{4}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 1 & 3 & -2 \\\\ 0 & 1 & 2 & -1 \\\\ 0 & 0 & 0 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows).\n\nTherefore, $\\text{rank}(A)=3.$"} {:db/id #edb/ref 17592186120386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00939ade-063c-559f-bd8d-433b0e5ab9e4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319394} {:answer/id #uuid "0660261a-521f-50ee-a7a8-84d6b48be7fd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319408} {:answer/id #uuid "212bd7b4-020a-5096-b846-a43a66bd1476" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319494} {:answer/id #uuid "5f0a4c71-c2ad-546d-bd08-c8f07a432b5d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/i