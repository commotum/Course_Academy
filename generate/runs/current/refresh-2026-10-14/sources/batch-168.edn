{:db/ident :answer.type/math} :answer/value "4 + π" :db/id #edb/ref 17592186175467}] :answer-field/id #uuid "997df49b-9c71-559b-91fb-60d0342ff500" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175462}] :question/id #uuid "cdb2f8c6-5b96-5f1a-a1ef-af467a3784b7" :question/math-academy-id "q-66473" :question/problem "If $\\csc x = \\frac{4}{3}$, then what is $\\csc (x - 2π)$?"} {:db/id #edb/ref 17592186238057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046e7856-f1e2-5945-9e7d-0a93df83f4c8" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186235826} {:answer/id #uuid "0ad271c1-164f-563d-8144-41ec17665cf1" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186235869} {:answer/id #uuid "a09b59df-731b-5769-9760-9b0d192e94e8" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\pi +6)" :db/id #edb/ref 17592186236819} {:answer/id #uuid "b688d9e4-b336-5610-8767-b855b6de77af" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186236974} {:answer/id #uuid "bfc90515-aa08-5349-8ded-9adc15546217" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186237038}] :answer-field/correct {:answer/id #uuid "046e7856-f1e2-5945-9e7d-0a93df83f4c8" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186235826} :answer-field/id #uuid "d9fe5a2e-ce65-5778-ab3a-31cf0f923ce9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237718}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b38cb050-d54a-5c31-92e4-8df91d886db0" :question/math-academy-id "q-103818" :question/problem "If $\\operatorname{csc}⁡x=3,$ then what is $5\\operatorname{csc}⁡(x+12\\pi )?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=6$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 6\\cdot \\pi )=\\operatorname{csc}⁡(x+12\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=3,$ then $\\operatorname{csc}⁡(x+12\\pi )=3.$\n\nFinally, then\n\n$$\n5\\operatorname{csc}⁡(x+12\\pi )=5\\cdot 3=15.\n$$"} {:db/id #edb/ref 17592186238058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0542c1d6-3728-54b2-b3a1-df0d46ee87d3" :answer/type {:db/ident :answer.type/math} :answer/value "14\\sqrt{5}" :db/id #edb/ref 17592186235835} {:answer/id #uuid "0b969bc4-2614-563a-a866-d0c162cb6031" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi +\\sqrt{5}" :db/id #edb/ref 17592186235878} {:answer/id #uuid "0e532d8e-6d27-5980-ac66-2fdc7efad5ba" :answer/type {:db/ident :answer.type/math} :answer/value "7\\sqrt{5}" :db/id #edb/ref 17592186235893} {:answer/id #uuid "ac6e33a6-cee4-54bd-ac5b-f894bd8dc5ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}\\pi " :db/id #edb/ref 17592186236913} {:answer/id #uuid "ca57c20d-812d-5a15-848b-26c4c659a7c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186237102}] :answer-field/correct {:answer/id #uuid "ca57c20d-812d-5a15-848b-26c4c659a7c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186237102} :answer-field/id #uuid "c0dda148-b9ae-56d7-b3d2-eaf94b4cea53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237685}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "52ab5a05-43c5-5409-b646-b849adccbfdb" :question/math-academy-id "q-103820" :question/problem "If $\\operatorname{csc}⁡x=\\sqrt{5},$ then what is $\\operatorname{csc}⁡(x+14\\pi )?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=7$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x=\\operatorname{csc}⁡(x+2\\cdot 7\\cdot \\pi )=\\operatorname{csc}⁡(x+14\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\operatorname{csc}⁡x=\\sqrt{5},$ then $\\operatorname{csc}⁡(x+14\\pi )=\\sqrt{5}.$"} {:db/id #edb/ref 17592186238059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0573c390-2d22-5963-a11d-b89a5ea01981" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186235837} {:answer/id #uuid "5729267a-695b-53dc-a203-2dcf1b185632" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186236370} {:answer/id #uuid "86ea7dfb-4080-5dbc-bd44-f75f681f7a97" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186236658} {:answer/id #uuid "ba20c820-ff56-5f70-80df-435db6fbb48e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186237008} {:answer/id #uuid "c6529e40-6d0d-5635-b1d3-0400fea21e95" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186237073}] :answer-field/correct {:answer/id #uuid "86ea7dfb-4080-5dbc-bd44-f75f681f7a97" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186236658} :answer-field/id #uuid "d6b27ce2-d1cc-5717-9f22-2cb44fddb336" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237716}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11c48f58-20a3-540d-a401-784e0ddc5dea" :question/math-academy-id "q-103822" :question/problem "If $\\operatorname{csc}⁡x=6,$ then what is $\\frac{1}{3}\\operatorname{csc}⁡(x+16\\pi )+5?$" :question/worked-solution "The period of $y=\\operatorname{csc}⁡x$ is $2\\pi .$ Th