202f4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515943}] :answer-field/correct {:answer/id #uuid "4a49c3a6-2c06-51bc-844d-138fc04973bf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515932} :answer-field/id #uuid "9d5a7135-c828-5ac9-9f26-2582cf461adc" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515967} {:answer-field/choices [{:answer/id #uuid "0fe3f231-f5ba-5be1-be9e-5913a0ba515b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515918} {:answer/id #uuid "d6809d06-ba04-53eb-a13b-c80cbe50f533" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515991}] :answer-field/correct {:answer/id #uuid "0fe3f231-f5ba-5be1-be9e-5913a0ba515b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515918} :answer-field/id #uuid "d49fd3a5-9c47-585e-8b53-058417e9e66d" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515990} {:answer-field/choices [{:answer/id #uuid "887815d4-2bcf-5d8b-9e5f-f7ea52b630ba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515957} {:answer/id #uuid "e1858030-90d1-596e-94f4-b3d56ccfa68e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515998}] :answer-field/correct {:answer/id #uuid "887815d4-2bcf-5d8b-9e5f-f7ea52b630ba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515957} :answer-field/id #uuid "fbb88c09-f4d5-55b1-a3f8-9fd61d296e7d" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186516010}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fd8d12b3-aeb5-5b1d-8119-9c9bbba0e242" :question/problem "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The domain is all real numbers except $x=\\frac{\\pi}{2}+n\\pi.$\n- **II.** The function is positive throughout $(-\\frac{\\pi}{2}+n\\pi,n\\pi).$\n- **III.** The least positive period is $\\pi.$" :question/worked-solution "Let's plot the graph of $y=\\tan x.$\n\n![](images/e6/e65a2728d8bdad40af736ced1ec8303bf10fb4d11fc66b33784663512093a26b.png)\n\nLet's go through each statement.\n\n- Statement I is true. The function is defined everywhere except where $x=\\frac{\\pi}{2}+n\\pi.$\n\n- Statement II is false. The function is positive on $(0,\\frac{\\pi}{2})$ and negative on $(-\\frac{\\pi}{2},0).$ The period is $\\pi,$ so these signs repeat after each integer multiple of $\\pi.$\n\n- Statement III is true. The graph repeats after a horizontal shift of $\\pi,$ and no smaller positive shift repeats the whole graph. Therefore, the least positive period is $\\pi.$\n\nSo, the correct answer is \"I and III only\"."} {:db/id #edb/ref 17592186516013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73b37b97-b986-5456-8e62-34787bd79605" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515946} {:answer/id #uuid "b325d968-3efb-56f5-acbb-1eb81a3be0e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515975}] :answer-field/correct {:answer/id #uuid "b325d968-3efb-56f5-acbb-1eb81a3be0e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515975} :answer-field/id #uuid "cad6637a-6bd9-5a4d-9bd5-7590635e9ec4" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515985} {:answer-field/choices [{:answer/id #uuid "3e157c8c-8176-5d3f-a03a-8db996797e4e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515928} {:answer/id #uuid "4b1cc927-b873-5a3b-85f0-e969007e542f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515933}] :answer-field/correct {:answer/id #uuid "4b1cc927-b873-5a3b-85f0-e969007e542f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515933} :answer-field/id #uuid "df8de3ac-eae1-5a30-8682-67b99b7619e8" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515997} {:answer-field/choices [{:answer/id #uuid "1fc6d116-71fd-5ee8-872a-349a07304b3d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515922} {:answer/id #uuid "b009f358-bfd7-5f04-b8e5-d66ffdcfbaef" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515974}] :answer-field/correct {:answer/id #uuid "1fc6d116-71fd-5ee8-872a-349a07304b3d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515922} :answer-field/id #uuid "fde6c007-7dfd-585a-9a96-dd7bf33c447e" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186516012}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fe358ff1-13c7-55a7-ad7a-3ea54f49d006" :question/problem "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The domain is all real numbers except $x=\\frac{\\pi}{2}+n\\pi.$\n- **II.** The function is positive throughout $(n\\pi,\\frac{\\pi}{2}+n\\pi).$\n- **III.** The least positive period is $2\\pi.$" :question/worked-solution "Let's plot the graph of $y=\\tan x.$\n\n![](images/e6/e65a2728d8bdad40af736ced1ec8303bf10fb4d11fc66b33784663512093a26b.png)\n\nLet's go through each statement.\n\n- Statement I is true. The function is defined everywhere except where $x=\\frac{\\pi}{2}+n\\pi.$\n\n- Statement II is true. The function is positive on $(0,\\frac{\\pi}{2})$ and negative on $(-\\frac{\\pi}{2},0).$ The period is $\\pi,$ so these signs repeat after each integer multiple of $\\pi.$\n\n- Statement III is false. The graph repeats after a horizontal shift of $\\pi,$ and no smaller positive shift repeats the whole graph. Therefore, the least positive period is $\\pi.$\n\nSo, the correct answer is \"I and II only\"."}] :knowledge-point/title "Describing Properties of the Tangent Function"}] [{:db/id #edb/ref 17592186176053 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175699 :question/id #uuid "12dc1c50-69bc-54d8-8d60-a7fc144c9644" :question/math-academy-id "e-11008" :question/problem "Which of the following statements are true regarding the graph of $y=\\csc x?$\n\n- The function takes the value $1$ at $x = -\\dfrac {\\pi} 2 + 2 \\pi n,$ where $n$ is an integer\n\n- The range of the function is $(-\\infty,+\\infty)$\n\n- The function has zeroes at $x = 0, \\pm \\pi, \\pm 2 \\pi,\\dots$" :question/worked-solution "Let's have a look at the graph of $y=\\csc x.$\n\n![](images/a9/a92d46319d381f0a8cab7823021b3b7e9b5c030ad964586b8e72129a2cd5abe7.png)\n\nNow, let's go through each statement.\n\n- The cosecant takes the value $1$ at $x = \\dfrac {\\pi} 2 + 2 \\pi n.$ Therefore, statement I is false.\n\n- The range of $y = \\csc x$ is $(-\\infty,-1] \\cup [1, \\infty).$ Therefore, statement II is false.\n\n- The cosecant graph does not intersect the $x$-axis. Therefore, statement III is false.\n\nIn conclusion, none of the statements are true."} :knowledge-point/id #uuid "92d6129b-a5c5-597a-86ee-3f19af20f326" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049075 :topic/math-academy-id 1573 :topic/title "Graphing Secant and Cosecant"} {:db/id #edb/ref 17592186050172 :topic/math-academy-id 3540 :topic/title "Describing Properties of the Sine Function"}] :knowledge-point/questions [{:db/id #edb/ref 17592186176487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c5e2592-4591-5762-bcbe-2782ea0f3180" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439767} {:answer/id #uuid "3bc8ccba-ce7d-5e48-8754-9ea49736590b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439768}] :answer-field/correct {:answer/id #uuid "3bc8ccba-ce7d-5e48-8754-9ea49736590b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439768} :answer-field/id #uuid "c3f557e4-66ef-5920-8da5-88cce596386c" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440241} {:answer-field/choices [{:answer/id #uuid "6880fb21-3096-58cb-af07-7d1e2ea7dd77" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439769} {:answer/id #uuid "0cd10553-ba3f-56b6-ad32-275f9052a89a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439770}] :answer-field/correct {:answer/id #uuid "0cd10553-ba3f-56b6-ad32-275f9052a89a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439770} :answer-field/id #uuid "49359634-c5ac-52d1-a03b-87b9054fe601" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440242} {:answer-field/choices [{:answer/id #uuid "9eb04900-1fcb-52ce-91bc-e54e340f3cc2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439771} {:answer/id #uuid "b8452449-f7ba-5c1c-9d12-c1bb509ee50c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439772}] :answer-field/correct {:answer/id #uuid "b8452449-f7ba-5c1c-9d12-c1bb509ee50c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439772} :answer-field/id #uuid "058bbf0f-d4f4-55ca-8a1f-a84af0d4303a" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440243}] :question/id #uuid "5961bc49-07f6-5191-b949-28358553d498" :question/math-academy-id "q-42912" :question/problem "Which of the following statements are true regarding the function $y = \\csc x$? Assume $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The point $(π,-1)$ is not on the graph.\n- **II.** The function has a vertical asymptotes at $x = nπ$.\n- **III.** The value $y = 2$ is in the range of the function." :question/worked-solution "Cosecant is undefined at pi and at every n*pi, so (pi,-1) is not on its graph and those x-values are vertical asymptotes. It takes the value 2 where sin(x)=1/2."} {:db/id #edb/ref 17592186176548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6aadfbfd-7e0d-5462-9403-7ec6f34bcd45" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439867} {:answer/id #uuid "36512727-2b25-560b-a5ef-a6a4dca23d6a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439868}] :answer-field/correct {:answer/id #uuid "36512727-2b25-560b-a5ef-a6a4dca23d6a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439868} :answer-field/id #uuid "e14982a7-98ac-5534-aa55-8a5040b1aa77" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440291} {:answer-field/choices [{:answer/id #uuid "3081db96-8e26-52e9-95d2-ce823865c78c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439869} {:answer/id #uuid "0f14ba72-6dd9-5b85-8fb4-3a959179e0b8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439870}] :answer-field/correct {:answer/id #uuid "3081db96-8e26-52e9-95d2-ce823865c78c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439869} :answer-field/id #uuid "632309ee-0c98-5584-910d-0b95c24c4b57" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440292} {:answer-field/choices [{:answer/id #uuid "8b38f072-608f-59e8-ac23-79a3eeb7fa91" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439871} {:answer/id #uuid "db27e3a1-ed43-5079-8562-a73f366e243b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439872}] :answer-field/correct {:answer/id #uuid "db27e3a1-ed43-5079-8562-a73f366e243b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439872} :answer-field/id #uuid "bd2616ba-1558-574f-a2d0-2541e9af7773" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440293}] :question/id #uuid "82d5c89d-6391-5689-957e-6be71174a415" :question/math-academy-id "q-65310" :question/problem "Which of the following statements are true regarding the function $y = \\csc x$? Assume $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The domain of the function is all real numbers except $x = nπ$.\n- **II.** The function has a zero at $x = \\frac{π}{2}$.\n- **III.** The function takes the value $-1$ at $x =-\\frac{π}{2} + 2nπ$." :question/worked-solution "Cosecant is defined exactly when x is not n*pi, never equals zero, and equals -1 at -pi/2+2n*pi."} {:db/id #edb/ref 17592186238055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43695e61-1e83-5a72-9ff3-f9bf8f0ff41d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437324} {:answer/id #uuid "7f9f1b84-1f9d-52ee-b77c-bb7cf2eaf5ec" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437325}] :answer-field/correct {:answer/id #uuid "43695e61-1e83-5a72-9ff3-f9bf8f0ff41d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437324} :answer-field/id #uuid "5985bcd7-8973-51f9-9c22-d1da25705334" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438691} {:answer-field/choices [{:answer/id #uuid "94f1f229-d949-5c5e-aaf2-e1aff529a00a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437326} {:answer/id #uuid "e88c8370-f864-5a65-8d5f-24e20ca5796f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437327}] :answer-field/correct {:answer/id #uuid "94f1f229-d949-5c5e-aaf2-e1aff529a00a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437326} :answer-field/id #uuid "2613d71e-2edc-5912-80f7-8226169c47b5" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438692} {:answer-field/choices [{:answer/id #uuid "bcf21feb-caad-5f01-82f0-e33663c8dbc1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437328} {:answer/id #uuid "8328e87e-23da-585d-b66e-42111af5c87e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437329}] :answer-field/correct {:answer/id #uuid "8328e87e-23da-585d-b66e-42111af5c87e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437329} :answer-field/id #uuid "c5477318-3d23-52d5-9a55-05595aeaea30" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438693}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "55643e28-3c44-53e1-a6da-d559974acbda" :question/math-academy-id "q-103811" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The domain of the function is all positive real numbers.\n- **II.** $x=\\frac{9\\pi }{2}$ is a vertical asymptote of the function.\n- **III.** $\\operatorname{csc}⁡(x-4\\pi )=\\operatorname{csc}⁡(x+6\\pi ).$" :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The function's domain is all real numbers except the integer multiples of $\\pi $, such as $0,\\pm \\pi ,\\pm 2\\pi ,….$ Hence, the statement I is false.\n\n- The lines $x=n\\pi $ for any integer $n,$ are the vertical asymptotes of the function. Hence, statement II is false.\n\n- The period of the function is $2\\pi .$ So, $\\operatorname{csc}⁡(x-4\\pi )=\\operatorname{csc}⁡(x)=\\operatorname{csc}⁡(x+6\\pi ).$ Hence, statement III is true."} {:db/id #edb/ref 17592186238056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9d4f60c-cb6e-5f02-8f4a-a198f7cafa23" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437336} {:answer/id #uuid "36efe75c-8338-5448-b8b1-f0f24de49042" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437337}] :answer-field/correct {:answer/id #uuid "a9d4f60c-cb6e-5f02-8f4a-a198f7cafa23" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437336} :answer-field/id #uuid "3f359a76-6b4d-5ef4-8d92-7e15d488f261" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438697} {:answer-field/choices [{:answer/id #uuid "434a0e71-1d31-5c13-a968-09b7e4ab49c4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437338} {:answer/id #uuid "6e498609-ab5a-526b-bdc2-2b89a7e8bc74" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437339}] :answer-field/correct {:answer/id #uuid "6e498609-ab5a-526b-bdc2-2b89a7e8bc74" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437339} :answer-field/id #uuid "b3e70be4-e476-5046-a564-3ee1193d0d78" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438698} {:answer-field/choices [{:answer/id #uuid "85984aac-915a-5905-a791-04f32942b8bd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437340} {:answer/id #uuid "4722da66-f024-52e9-b6dc-755aa8810cc6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437341}] :answer-field/correct {:answer/id #uuid "4722da66-f024-52e9-b6dc-755aa8810cc6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437341} :answer-field/id #uuid "a3cd87df-e0b6-57e0-879b-9a26805f19c7" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438699}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "048ceaff-1e4b-5807-8d50-fab96c1502f7" :question/math-academy-id "q-103814" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$ Assume $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** $y=1$ is the minimum value of the function. $$\n- **II.** $x=9\\pi $ is a vertical asymptote of the function.\n- **III.** The function takes the value $1$ at $x=\\frac{\\pi }{2}+2n\\pi .$" :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/06/066fe6ce8a65927436d64753ec4e61bfea257405e4b2f81554ac8341572bcf15.png)\n\nNow, let's go through each statement.\n\n- The range of the function is $(-\\infty ,-1]\\cup [1,\\infty )$, therefore the function doesn't have a minimum value. Hence, statement I is false.\n\n- The lines $x=n\\pi $ for any integer $n$ are the vertical asymptotes of the function. Hence statement II is true.\n\n- The cosecant takes the value $1$ at $x=\\frac{\\pi }{2}+2n\\pi .$ Hence statement III is true."} {:db/id #edb/ref 17592186335824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e211abea-7b27-5a54-be2b-2776b824b945" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438350} {:answer/id #uuid "79899ac4-ccf6-540e-b658-cb8b94ac43da" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438351}] :answer-field/correct {:answer/id #uuid "e211abea-7b27-5a54-be2b-2776b824b945" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438350} :answer-field/id #uuid "edae0a14-27e5-5e98-b83b-4156e2b25186" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439204} {:answer-field/choices [{:answer/id #uuid "67a95286-58a4-575f-9e02-1c66187d6d04" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438352} {:answer/id #uuid "eea5daa5-e442-5597-9cec-3ad2abc796cb" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438353}] :answer-field/correct {:answer/id #uuid "67a95286-58a4-575f-9e02-1c66187d6d04" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438352} :answer-field/id #uuid "cf74774a-d3c3-5b92-9271-5390bf41b92d" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439205} {:answer-field/choices [{:answer/id #uuid "2548a6ab-0a8e-5889-96af-63d49ce1229d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438354} {:answer/id #uuid "f0494e1c-1e6b-50ae-bba0-b1f997d7bb40" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438355}] :answer-field/correct {:answer/id #uuid "f0494e1c-1e6b-50ae-bba0-b1f997d7bb40" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438355} :answer-field/id #uuid "4ca7e1ae-07e6-57e8-afc7-3d171793c761" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439206}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7573ddef-f834-5ca7-911d-588bad3a2d0f" :question/math-academy-id "q-65307" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The domain of the function is all real numbers.\n\n- **II.** $x=\\frac{\\pi }{2}$ is a vertical asymptote of the function.\n\n- **III.** The graph of the function doesn't intersect the $y$-axis." :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The domain of the function is all real numbers except the integer multiples of $\\pi $, such as $0,\\pm \\pi ,\\pm 2\\pi ,….$ Hence, statement I is false.\n\n- The lines $x=n\\pi ,$ for any integer $n,$ are the vertical asymptotes of the function. Hence, statement II is false.\n\n- The graph of the function doesn't intersect the $y$-axis, as $x=0$ is not in the domain of $y=\\operatorname{csc}⁡x.$ Hence, statement III is true."} {:db/id #edb/ref 17592186335825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c29a3814-a545-563e-9080-6c788b49451b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438356} {:answer/id #uuid "d6f89c4d-da0d-58fc-ab37-efc5ed7f1053" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438357}] :answer-field/correct {:answer/id #uuid "c29a3814-a545-563e-9080-6c788b49451b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438356} :answer-field/id #uuid "30435fb6-1037-57a8-b967-d652cdf699a7" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439207} {:answer-field/choices [{:answer/id #uuid "c0ebde88-a46b-560f-9b2d-c9311641fa24" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438358} {:answer/id #uuid "d06a8128-c2a1-53e6-bd78-9b4f1b872f74" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438359}] :answer-field/correct {:answer/id #uuid "d06a8128-c2a1-53e6-bd78-9b4f1b872f74" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438359} :answer-field/id #uuid "3aa49081-1dec-5a36-ad7e-37cc67073211" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439208} {:answer-field/choices [{:answer/id #uuid "70935825-1eb9-59f1-b836-2b74b2e4e965" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438360} {:answer/id #uuid "d95548b2-40ec-5ebf-b1ab-d29936ab04f6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438361}] :answer-field/correct {:answer/id #uuid "70935825-1eb9-59f1-b836-2b74b2e4e965" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438360} :answer-field/id #uuid "168eb318-5e34-58b3-8153-3564c073e9ff" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439209}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "69d68c82-75d2-569e-bc5a-a35be8a71a62" :question/math-academy-id "q-65308" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The range of the function is all real numbers.\n- **II.** $\\operatorname{csc}⁡(x)=\\operatorname{csc}⁡(x+2\\pi ).$\n- **III.** $x=5\\pi $ is in the domain of the function." :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ).$ Hence, statement I is false.\n\n- The period of the function is $2\\pi ,$ so $\\operatorname{csc}⁡(x)=\\operatorname{csc}⁡(x+2n\\pi )$ for any integer $n.$ Substituing $n=1,$ we get $\\operatorname{csc}⁡(x)=\\operatorname{csc}⁡(x+2\\pi ).$ Hence, Statement II is true.\n\n- The function $y=\\operatorname{csc}⁡x$ is defined for all real numbers except the integer multiples of $\\pi ,$ so $5\\pi $ is not in the domain of $y=\\operatorname{csc}⁡x.$ Hence, statement III is false."} {:db/id #edb/ref 17592186399398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59486814-0d8e-599a-bf0f-57dc550e7b15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437330} {:answer/id #uuid "a1dce793-5565-5d7f-905d-7cd04e4d56ce" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437331}] :answer-field/correct {:answer/id #uuid "59486814-0d8e-599a-bf0f-57dc550e7b15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437330} :answer-field/id #uuid "a341d84b-92d9-5335-b0b9-fd13587dacad" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438694} {:answer-field/choices [{:answer/id #uuid "74c41ab1-5221-54d6-bfb2-b2d2b1a66a85" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437332} {:answer/id #uuid "79a66b2d-395b-5d7a-972b-1551475dda80" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437333}] :answer-field/correct {:answer/id #uuid "74c41ab1-5221-54d6-bfb2-b2d2b1a66a85" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437332} :answer-field/id #uuid "1d83191a-11eb-57de-8d9a-63c9eb52fa02" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438695} {:answer-field/choices [{:answer/id #uuid "6e7478e7-5c82-57c4-9e23-eb0f7d938047" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437334} {:answer/id #uuid "c4654fa4-c8d7-53b9-af56-adb9aeac3408" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437335}] :answer-field/correct {:answer/id #uuid "6e7478e7-5c82-57c4-9e23-eb0f7d938047" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437334} :answer-field/id #uuid "548cb375-8481-538b-9ce6-63f0f2d26906" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438696}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4383ecaa-1c57-5705-8853-cba2341fc9fa" :question/math-academy-id "q-103812" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The range of the function is $(-\\infty ,-1].$\n- **II.** $y=-1$ is the maximum value of the function.\n- **III.** $x=15\\pi $ is in the domain." :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ therefore the function doesn't have a maximum value. Hence, statements I and II are both false.\n\n- The function's domain is all real numbers except the integer multiples of $\\pi $, such as $0,\\pm \\pi ,\\pm 2\\pi ,….$ Hence, statement III is false."} {:db/id #edb/ref 17592186517000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6bab16-c48f-5d71-ba04-cf367cce07b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186516997} {:answer/id #uuid "667b9553-a43f-59bc-b1b6-5bed93f5c4ad" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186517035}] :answer-field/correct {:answer/id #uuid "667b9553-a43f-59bc-b1b6-5bed93f5c4ad" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/i