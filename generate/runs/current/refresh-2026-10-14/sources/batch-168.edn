} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AT:TB=3:5,$ we have\n\n$$\n\\overset{\\to }{AT}=\\frac{3}{8}\\overset{\\to }{AB}=\\frac{3}{8}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =a+\\frac{3}{8}(b-a) \\\\  & =\\frac{5}{8}a+\\frac{3}{8}b.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514792 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299a1a26-1ed8-58a8-8754-b92a5d097aba" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{4}{7}a+\\frac{3}{7}b" :db/id #edb/ref 17592186514800} {:answer/id #uuid "40e57336-9f2f-5da5-99b8-a298ad020a5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=-\\frac{3}{7}a+\\frac{4}{7}b" :db/id #edb/ref 17592186514804} {:answer/id #uuid "704d7806-7673-56ed-a4ca-904f790d4cb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=a+\\frac{4}{7}b" :db/id #edb/ref 17592186514811} {:answer/id #uuid "8d14c68c-bcf1-56fc-9bb7-892465781b76" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{7}a+\\frac{4}{7}b" :db/id #edb/ref 17592186514821} {:answer/id #uuid "ec0db186-6749-56b6-9b8a-76869feeb4d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{7}a-\\frac{4}{7}b" :db/id #edb/ref 17592186514844}] :answer-field/correct {:answer/id #uuid "8d14c68c-bcf1-56fc-9bb7-892465781b76" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{7}a+\\frac{4}{7}b" :db/id #edb/ref 17592186514821} :answer-field/id #uuid "7e65207c-f0d4-53e7-9354-c6a4f2688177" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514815}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "01a6503b-1a83-57d8-97d2-6422b55010bc" :question/problem "![](