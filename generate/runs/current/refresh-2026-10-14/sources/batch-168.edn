f8ab7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256236}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eee74ea9-5018-5a1b-8460-e61ca7767d79" :question/math-academy-id "q-120285" :question/problem "![](images/c4/c4d26b3db6446f586ca47634d9f9a3a004968a0081b8859ce46b4b4af799d066.png)\n\nConsider the diagram above, where $\\overset{\\to }{OH}=h,$ $\\overset{\\to }{OI}=i$ and $J$ divides $\\overset{―}{HI}$ in the ratio $HJ:JI=3:7.$ Find $\\overset{\\to }{OJ}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OJ}=\\overset{\\to }{OH}+\\overset{\\to }{HJ}.\n$$\n\nWe're told that $\\overset{\\to }{OH}=h,$ so we just need to work out $\\overset{\\to }{HJ}.$\n\nFirst, from $△OHI,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HI} & =\\overset{\\to }{HO}+\\overset{\\to }{OI} \\\\  & =-\\overset{\\to }{OH}+\\overset{\\to }{OI} \\\\  & =-h+i \\\\  & =i-h.\\end{aligned}\n$$\n\nSince $HJ:JI=3:7,$ we have\n\n$$\n\\overset{\\to }{HJ}=\\frac{3}{10}\\overset{\\to }{HI}=\\frac{3}{10}(i-h).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OJ} & =\\overset{\\to }{OH}+\\overset{\\to }{HJ} \\\\  & =h+\\frac{3}{10}(i-h) \\\\  & =\\frac{7}{10}h+\\frac{3}{10}i.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08042bf4-3ef1-5d30-b0f3-3f433bba0296" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{9}u+\\frac{7}{9}v" :db/id #edb/ref 17592186253727} {:answer/id #uuid "0df1ebc5-6217-5105-bde2-c6c8741a810e" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{1}{3}u+\\frac{2}{3}v" :db/id #edb/ref 17592186253788} {:answer/id #uuid "80614574-97e2-5043-b396-2114fd647949" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186254805} {:answer/id #uuid "bba72999-a4aa-5c77-bf97-584951bba851" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{5}{7}u+\\frac{2}{7}v" :db/id #edb/ref 17592186255344} {:answer/id #uuid "ded7e171-58ae-5dc1-8f0a-f9fdf6931af4" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{3}u+\\frac{1}{3}v" :db/id #edb/ref 17592186255647}] :answer-field/correct {:answer/id #uuid "08042bf4-3ef1-5d30-b0f3-3f433bba0296" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{9}u+\\frac{7}{9}v" :db/id #edb/ref 17592186253727} :answer-field/id #uuid "38859fb6-3c7d-5b36-af09-e8454c183c16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256022}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e34b700c-a9ab-5795-931b-c570187a69f9" :question/math-academy-id "q-120294" :question/problem "![](images/70/707beca1d856414e25874cc0b56c6654fbb41d699f01106b6749d49408b39aee.png)\n\nConsider the diagram above, where $\\overset{\\to }{OU}=u,$ $\\overset{\\to }{OV}=v$ and $W$ divides $\\overset{―}{UV}$ in the ratio $UW:WV=7:2.$ Find $\\overset{\\to }{OW}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OW}=\\overset{\\to }{OU}+\\overset{\\to }{UW}.\n$$\n\nWe're told that $\\overset{\\to }{OU}=u,$ so we just need to work out $\\overset{\\to }{UW}.$\n\nFirst, from $△OUV,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =\\overset{\\to }{UO}+\\overset{\\to }{OV} \\\\  & =-\\overset{\\to }{OU}+\\overset{\\to }{OV} \\\\  & =-u+v \\\\  & =v-u.\\end{aligned}\n$$\n\nSince $UW:WV=7:2,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{7}{9}\\overset{\\to }{UV}=\\frac{7}{9}(v-u).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =u+\\frac{7}{9}(v-u) \\\\  & =\\frac{2}{9}u+\\frac{7}{9}v.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec7aea6-7e9b-5e22-b08e-4d9e29b49a14" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{5}{9}m+\\frac{4}{9}n" :db/id #edb/ref 17592186253798} {:answer/id #uuid "38a55f08-30dd-5226-a035-3ef422cf9289" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{1}{3}m+\\frac{2}{3}n" :db/id #edb/ref 17592186254161} {:answer/id #uuid "98379f30-a71c-5d53-ae03-042f3405b7ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{1}{2}m+\\frac{1}{2}n" :db/id #edb/ref 17592186255015} {:answer/id #uuid "aa8a188a-e50d-5036-99f0-699a116256a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{2}{3}m+\\frac{1}{3}n" :db/id #edb/ref 17592186255178} {:answer/id #uuid "d0d7c189-608f-5823-837a-7c7d46640d1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{4}{9}m+\\frac{5}{9}n" :db/id #edb/ref 17592186255533}] :answer-field/correct {:answer/id #uuid "38a55f08-30dd-5226-a035-3ef422cf9289" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OP}=\\frac{1}{3}m+\\frac{2}{3}n" :db/id #edb/ref 17592186254161} :answer-field/id #uuid "389158e2-a0c0-5ba2-947f-ffa5aaa799ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256023}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c29ac42f-42ba-5668-9b76-4de9b80fc725" :question/math-academy-id "q-120303" :question/problem "![](images/50/50b87e86bd2985e54ce0a8fe6b3e23986f7e1946a5284d0ae297d96b9cbc60f6.png)\n\nConsider the diagram above, where $\\overset{\\to }{OM}=m,$ $\\overset{\\to }{ON}=n$ and $P$ divides $\\overset{―}{MN}$ in the ratio $MP:PN=2:1.$ Find $\\overset{\\to }{OP}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OP}=\\overset{\\to }{OM}+\\overset{\\to }{MP}.\n$$\n\nWe're told that $\\overset{\\to }{OM}=m,$ so we just need to work out $\\overset{\\to }{MP}.$\n\nFirst, from $△OMN,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{MN} & =\\overset{\\to }{MO}+\\overset{\\to }{ON} \\\\  & =-\\overset{\\to }{OM}+\\overset{\\to }{ON} \\\\  & =-m+n \\\\  & =n-m.\\end{aligned}\n$$\n\nSince $MP:PN=2:1,$ we have\n\n$$\n\\overset{\\to }{MP}=\\frac{2}{3}\\overset{\\to }{MN}=\\frac{2}{3}(n-m).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OP} & =\\overset{\\to }{OM}+\\overset{\\to }{MP} \\\\  & =m+\\frac{2}{3}(n-m) \\\\  & =\\frac{1}{3}m+\\frac{2}{3}n.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d994bc9-80ac-519e-8a27-b44303783cce" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=-\\frac{6}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186253920} {:answer/id #uuid "417bf975-159a-5419-bfd1-40ebc9a90508" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{6}{7}a-\\frac{1}{7}b" :db/id #edb/ref 17592186254227} {:answer/id #uuid "dbd9489c-6b47-566f-89ad-f4e016150b16" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{5}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186255619} {:answer/id #uuid "e41f44f3-369d-5892-92cf-ef2145ce59f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{6}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186255689} {:answer/id #uuid "efce3a4e-c17a-5f7a-b22e-e51a9e6f255f" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186255765}] :answer-field/correct {:answer/id #uuid "e41f44f3-369d-5892-92cf-ef2145ce59f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{6}{7}a+\\frac{1}{7}b" :db/id #edb/ref 17592186255689} :answer-field/id #uuid "fe05e0a3-cb61-5682-9f8a-ba17656f998c" :answer-field