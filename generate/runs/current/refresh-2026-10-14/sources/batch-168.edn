} \\\\  & =-\\overset{\\to }{OS}+\\overset{\\to }{OT} \\\\  & =-s+t \\\\  & =t-s.\\end{aligned}\n$$\n\nSince $SL:LT=11:4,$ we have\n\n$$\n\\overset{\\to }{SL}=\\frac{11}{15}\\overset{\\to }{ST}=\\frac{11}{15}(t-s).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OL} & =\\overset{\\to }{OS}+\\overset{\\to }{SL} \\\\  & =s+\\frac{11}{15}(t-s) \\\\  & =\\frac{4}{15}s+\\frac{11}{15}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa9e3a8b-c071-5d0e-81bf-ddc27065f654" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{17}" :db/id #edb/ref 17592186300818}] :answer-field/correct {:answer/id #uuid "aa9e3a8b-c071-5d0e-81bf-ddc27065f654" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{17}" :db/id #edb/ref 17592186300818} :answer-field/id #uuid "24470832-a4f9-57f7-99c2-0c4da16ae600" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301340} {:answer-field/choices [{:answer/id #uuid "e8a1594d-ec17-53b6-8cd8-9593fe66ca1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{17}" :db/id #edb/ref 17592186301114}] :answer-field/correct {:answer/id #uuid "e8a1594d-ec17-53b6-8cd8-9593fe66ca1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{17}" :db/id #edb/ref 17592186301114} :answer-field/id #uuid "3e6ba9e6-a7a1-5b0f-b138-160dc339aa31" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301431}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "933ea721-7b6c-5d1a-827a-41c6ac7ccead" :question/math-academy-id "q-322582" :question/problem "![](images/76/76ddb750ca447fd7f73f2481ecd46bb53eba12e392e81e8b64c2c23589e11694.png)\n\nConsider the diagram above, where $\\overset{\\to }{OK}=k,$ $\\overset{\\to }{OZ}=z,$ and $Y$ divides $\\overset{―}{KZ}$ in the ratio $KY:YZ=10:7.$ Express $\\overset{\\to }{OY}$ via the vectors $k$ and $z.$\n\n$\\,\\overset{\\to }{OY}=$\n{{field-1}}\n$k+$\n{{field-2}}\n$z$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OY}=\\overset{\\to }{OK}+\\overset{\\to }{KY}.\n$$\n\nWe're told that $\\overset{\\to }{OK}=k,$ so we just need to work out $\\overset{\\to }{KY}.$\n\nFirst, from $△OKZ,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{KZ} & =\\overset{\\to }{KO}+\\overset{\\to }{OZ} \\\\  & =-\\overset{\\to }{OK}+\\overset{\\to }{OZ} \\\\  & =-k+z \\\\  & =z-k.\\end{aligned}\n$$\n\nSince $KY:YZ=10:7,$ we have\n\n$$\n\\overset{\\to }{KY}=\\frac{10}{17}\\overset{\\to }{KZ}=\\frac{10}{17}(z-k).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OY} & =\\overset{\\to }{OK}+\\overset{\\to }{KY} \\\\  & =k+\\frac{10}{17}(z-k) \\\\  & =\\frac{7}{17}k+\\frac{10}{17}z.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e3ab9b3-b004-5c05-861c-4429d0885514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{19}" :db/id #edb/ref 17592186300519}] :answer-field/correct {:answer/id #uuid "6e3ab9b3-b004-5c05-861c-4429d0885514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{19}" :db/id #edb/ref 17592186300519} :answer-field/id #uuid "257374bb-4fcd-535e-9b70-c67245f5a50c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301342} {:answer-field/choices [{:answer/id #uuid "7f48c4b3-d819-50a6-a9df-d19da3ae33a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{19}" :db/id #edb/ref 17592186300593}] :answer-field/correct {:answer/id #uuid "7f48c4b3-d819-50a6-a9df-d19da3ae33a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{19}" :db/id #edb/ref 17592186300593} :answer-field/id #uuid "8cc79974-795c-5c9e-b38b-d74f3b32ec5e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301672}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d044fb8e-8045-5f46-9513-7ab06e52b140" :question/math-academy-id "q-322583" :question/problem "![](images/d0/d0e71a97dc559536c25b63fda50805875d4651166a9442ae0d3d081704edebb2.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=a,$ $\\overset{\\to }{OQ}=q,$ and $N$ divides $\\overset{―}{AQ}$ in the ratio $AN:NQ=12:7.$ Express $\\overset{\\to }{ON}$ via the vectors $a$ and $q.$\n\n$\\,\\overset{\\to }{ON}=$\n{{field-1}}\n$a+$\n{{field-2}}\n$q$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{ON}=\\overset{\\to }{OA}+\\overset{\\to }{AN}.\n$$\n\nWe're told that $\\overset{\\to }{OA}=a,$ so we just need to work out $\\overset{\\to }{AN}.$\n\nFirst, from $△OAQ,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AQ} & =\\overset{\\to }{AO}+\\overset{\\to }{OQ} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OQ} \\\\  & =-a+q \\\\  & =q-a.\\end{aligned}\n$$\n\nSince $AN:NQ=12:7,$ we have\n\n$$\n\\overset{\\to }{AN}=\\frac{12}{19}\\overset{\\to }{AQ}=\\frac{12}{19}(q-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{ON} & =\\overset{\\to }{OA}+\\overset{\\to }{AN} \\\\  & =a+\\frac{12}{19}(q-a) \\\\  & =\\frac{7}{19}a+\\frac{12}{19}q.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111b3502-4d20-5d31-91b8-7abbeab14d76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186300030}] :answer-field/correct {:answer/id #uuid "111b3502-4d20-5d31-91b8-7abbeab14d76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186300030} :answer-field/id #uuid "306a4818-28a4-5233-9c68-e7e860afe61d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301379} {:answer-field/choices [{:answer/id #uuid "d103b022-3392-5699-