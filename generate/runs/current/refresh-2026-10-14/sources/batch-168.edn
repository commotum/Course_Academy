} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AT:TB=4:1,$ we have\n\n$$\n\\overset{\\to }{AT}=\\frac{4}{5}\\overset{\\to }{AB}=\\frac{4}{5}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =a+\\frac{4}{5}(b-a) \\\\  & =\\frac{1}{5}a+\\frac{4}{5}b.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34ac65a4-6d08-5944-9854-166010f95d68" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{5}a+\\frac{2}{5}b" :db/id #edb/ref 17592186514801} {:answer/id #uuid "358ccc11-d61a-56ed-b8f7-3c55b87ef3e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=-\\frac{2}{5}a+\\frac{3}{5}b" :db/id #edb/ref 17592186514802} {:answer/id #uuid "d8823c81-2964-58b6-88bd-1505f5c62a47" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=a+\\frac{3}{5}b" :db/id #edb/ref 17592186514838} {:answer/id #uuid "e13e241a-e583-5a80-977e-1580a6eb3975" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{2}{5}a+\\frac{3}{5}b" :db/id #edb/ref 17592186514841} {:answer/id #uuid "f362c158-e25d-590d-9ce3-6cb8af431750" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{2}{5}a-\\frac{3}{5}b" :db/id #edb/ref 17592186514846}] :answer-field/correct {:answer/id #uuid "e13e241a-e583-5a80-977e-1580a6eb3975" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{2}{5}a+\\frac{3}{5}b" :db/id #edb/ref 17592186514841} :answer-field/id #uuid "dfa661b2-48a8-58c1-a4c7-37e6af796c7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514840}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d526f2e4-d8b9-5a46-8735-cff82b33bd06" :question/problem "![](images/ed/ed743552b27ace3491336d3070a3eec64986a46f7f208ac4673c2df4c5d7d184.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=a,$ $\\overset{\\to }{OB}=b$ and $T$ divides $\\overset{―}{AB}$ in the ratio $AT:TB=3:2.$ Find $\\overset{\\to }{OT}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OT}=\\overset{\\to }{OA}+\\overset{\\to }{AT}.\n$$\n\nWe're told that $\\overset{\\to }{OA}=a,$ so we just need to work out $\\overset{\\to }{AT}.$\n\nFirst, from $△OAB,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AT:TB=3:2,$ we have\n\n$$\n\\overset{\\to }{AT}=\\frac{3}{5}\\overset{\\to }{AB}=\\frac{3}{5}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =a+\\frac{3}{5}(b-a) \\\\  & =\\frac{2}{5}a+\\frac{3}{5}b.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ae8ce9-f444-564c-b5be-bbe3c87eb372" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186514795}] :answer-field/correct {:answer/id #uuid "07ae8ce9-f444-564c-b5be-bbe3c87eb372" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186514795} :answer-field/id #uuid "92e9c794-020e-5a79-a258-fed7b5ea3267" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514823} {:answer-field/choices [{:answer/id #uuid "991390d0-1deb-5380-8d75-2bd22dcc3a9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186514827}] :answer-field/correct {:answer/id #uuid "991390d0-1deb-5380-8d75-2bd22dcc3a9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186514827} :answer-field/id #uuid "fe4d97b4-fe1c-5bce-9cbb-ce2d601098a7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514849}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f73e6a96-1406-51eb-b8e1-7f0e1dc19d40" :question/problem "![](images/30/30350c72fc81e95a1287d9235974a3ab79f6e8d4bc11fa65611264c7ee115ebd.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=a,$ $\\overset{\\to }{OB}=b$ and $T$ divides $\\overset{―}{AB}$ in the ratio $AT:TB=1:3.$ Express $\\overset{\\to }{OT}$ via the vectors $a$ and $b$.\n\n$\\,\\overset{\\to }{OT}=$\n{{field-1}}\n$a+$\n{{field-2}}\n$b$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OT}=\\overset{\\to }{OA}+\\overset{\\to }{AT}.\n$$\n\nWe're told that $\\overset{\\to }{OA}=a,$ so we just need to work out $\\overset{\\to }{AT}.$\n\nFirst, from $△OAB,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nSince $AT:TB=1:3,$ we have\n\n$$\n\\overset{\\to }{AT}=\\frac{1}{4}\\overset{\\to }{AB}=\\frac{1}{4}(b-a).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =a+\\frac{1}{4}(b-a) \\\\  & =\\frac{3}{4}a+\\frac{1}{4}b.\\end{aligned}\n$$"}] :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] [{:db/id #edb/ref 17592186176049 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175695 :question/id #uuid "2f4571af-99cf-5a4a-9998-fb6a0f7d6be9" :question/math-academy-id "e-11004" :question/problem "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\n- The zeros of the function are at $x = \\pi n.$\n\n- The function has asymptotes at $x = 2\\pi n.$\n\n- The range of the function is $y\\in [-1,1].$" :question/worked-solution "Let's plot the graph of $y=\\tan x.$\n\n![](images/32/326418398ce1a33f03a21f3bdb58107856f4ccb72241429f1604486281e60822.png)\n\nLet's go through each statement.\n\n- Statement I is true. The zeros occur at $x=0, \\pm \\pi, \\pm2\\pi,\\ldots,$ which can be written as $x=n\\pi.$\n\n- Statement II is false. The function has an asymptote at $x = \\dfrac \\pi 2$ and the period is $\\pi.$ Therefore, the asymptotes occur at $x = \\dfrac \\pi 2 + \\pi n.$\n\n- Statement III is false. The function takes values on all the real numbers, hence the range is $y\\in (-\\infty, \\infty).$\n\nSo, the correct answer is \"I only\"."} :knowledge-point/id #uuid "4241c7bd-4a2b-556f-be9f-8a884addebb9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049155 :topic/math-academy-id 1493 :topic/title "Graphing Tangent and Cotangent"}] :knowledge-point/questions [{:db/id #edb/ref 17592186176452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ba1a255-23c5-558c-890e-352eda666203" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438028} {:answer/id #uuid "81040fec-7087-5a36-951b-b14d732d3182" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438029}] :answer-field/correct {:answer/id #uuid "2ba1a255-23c5-558c-890e-352eda666203" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438028} :answer-field/id #uuid "d005fdab-8b78-5385-b8aa-903a81e93357" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439043} {:answer-field/choices [{:answer/id #uuid "cb0045bc-f2f1-542d-bb18-f3e3a32d2249" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438030} {:answer/id #uuid "72151a10-5577-5c23-b443-f401e6df03cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438031}] :answer-field/correct {:answer/id #uuid "72151a10-5577-5c23-b443-f401e6df03cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438031} :answer-field/id #uuid "b788b23d-3122-5950-affc-e24e292331da" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439044} {:answer-field/choices [{:answer/id #uuid "f160f821-e2d0-550e-97fc-505a5402176a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438032} {:answer/id #uuid "6d124318-fd4c-51c0-8d63-f26f3899820c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438033}] :answer-field/correct {:answer/id #uuid "f160f821-e2d0-550e-97fc-505a5402176a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438032} :answer-field/id #uuid "ba780c82-a764-5e2e-ac73-af96e4c3fadd" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439045}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ac898e3a-bbc1-536e-8415-2d3fbc798e28" :question/math-academy-id "q-27638" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The function has asymptotes at $x=n\\pi .$\n- **II.** The function returns only positive values on the intervals $(\\pi n,\\frac{\\pi }{2}+\\pi n)\\,.$\n- **III.** The function has zeros at $x=\\frac{\\pi }{2}+n\\pi .$" :question/worked-solution "Let's plot the graph of $y=tan⁡x.$\n\n![](images/32/326418398ce1a33f03a21f3bdb58107856f4ccb72241429f1604486281e60822.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function has an asymptote at $x=\\frac{\\pi }{2}$ and the period is $\\pi .$ Therefore, the asymptotes occur at $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement II is true. The function returns only positive values on the interval $(0,\\frac{\\pi }{2})$ and the period is $\\pi .$ Therefore, the function is positive on $(n\\pi ,\\frac{\\pi }{2}+n\\pi )\\,.$\n\n- Statement III is false. The zeros occur at $x=0,\\pm \\pi ,\\pm 2\\pi ,…,$ which can be written as $x=n\\pi .$\n\nSo, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186176453 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06caa996-019d-55b8-9b18-5c983270de02" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439615} {:answer/id #uuid "f490172a-f960-5273-937b-4f942ee332ef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439616}] :answer-field/correct {:answer/id #uuid "f490172a-f960-5273-937b-4f942ee332ef" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439616} :answer-field/id #uuid "ed2f5e64-32f3-5522-8385-0836cdf1b1de" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440165} {:answer-field/choices [{:answer/id #uuid "4c0e3f19-9827-5a02-9335-759832aa58f2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439617} {:answer/id #uuid "25bf5a5c-a822-56a1-a1c2-c6a5ab56d691" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439618}] :answer-field/correct {:answer/id #uuid "4c0e3f19-9827-5a02-9335-759832aa58f2" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439617} :answer-field/id #uuid "c8a3ab15-7920-5551-b932-d3776cb36d30" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440166} {:answer-field/choices [{:answer/id #uuid "7a5ad809-5893-5399-b9f3-ad07e3a9d1df" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439619} {:answer/id #uuid "1518fe23-d68e-51c4-ba9d-5901e8279447" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439620}] :answer-field/correct {:answer/id #uuid "7a5ad809-5893-5399-b9f3-ad07e3a9d1df" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439619} :answer-field/id #uuid "b5ce653d-94c4-5b5c-8d40-d92ea9bebea4" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440167}] :question/id #uuid "95d49fd8-cd30-53eb-a4a3-b8a8c0494e55" :question/math-academy-id "q-27660" :question/problem "Which of the following statements are true regarding the function $y = \\tan x$? Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The function has asymptotes at $x = \\frac{π}{2} + πn$.\n- **II.** The range of the function is $y ∈ (-\\frac{π}{2}, \\frac{π}{2})$.\n- **III.** The domain of the function is all real numbers except $x = nπ$." :question/worked-solution "Tangent has vertical asymptotes at pi/2+n*pi and range all real numbers. Its domain excludes pi/2+n*pi, rather than n*pi. Only I is true."} {:db/id #edb/ref 17592186237987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d62743dd-6b08-537d-99a1-950e0129a65b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437312} {:answer/id #uuid "ca6522af-a085-5421-9c2f-2778b4ad8bee" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437313}] :answer-field/correct {:answer/id #uuid "ca6522af-a085-5421-9c2f-2778b4ad8bee" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437313} :answer-field/id #uuid "7795f1b0-ab3b-568b-86a9-79ad8f59e765" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438685} {:answer-field/choices [{:answer/id #uuid "62cebc6c-fb9e-5e2f-a4dc-892c8730f19c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437314} {:answer/id #uuid "7c865e34-f1b0-5ac5-896e-1465217ac529" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437315}] :answer-field/correct {:answer/id #uuid "62cebc6c-fb9e-5e2f-a4dc-892c8730f19c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437314} :answer-field/id #uuid "3a680935-e5c9-5bc1-9251-f1ef3483d3ef" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438686} {:answer-field/choices [{:answer/id #uuid "a1a71c62-3700-5f58-82ca-cdcc35abc891" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437316} {:answer/id #uuid "f8103b2e-08e3-58da-8184-32ba8bfa5da1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437317}] :answer-field/correct {:answer/id #uuid "a1a71c62-3700-5f58-82ca-cdcc35abc891" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437316} :answer-field/id #uuid "895e53e0-0454-5c88-bc63-752876bb1bff" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438687}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2215b590-8140-5323-92bf-8ae24e1b7bb4" :question/math-academy-id "q-103289" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{tan}⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The domain of the function is all real numbers except $x=\\frac{\\pi }{2}+n\\pi $\n\n- **II.** The function has zeros at $x=\\frac{\\pi }{2}+n\\pi $ for any integer $n$\n\n- **III.** The range of the function is $y\\in (-\\frac{\\pi }{4},\\frac{\\pi }{4})$" :question/worked-solution "Let's plot the graph of $y=tan⁡x.$\n\n![](images/73/732955302ca49a41f6c43cf242d7c869e630e88d804c4b56a5beb3b081f2d230.png)\n\nLet's go through each statement.\n\n- Statement I is true. The function is defined everywhere, except where $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement II is false. The zeros occur at $x=0,\\pm \\pi ,\\pm 2\\pi ,…,$ which can be written as $x=n\\pi .$\n\n- Statement III is false. The function takes values on all the real numbers, hence the range is $y\\in (-\\infty ,\\infty ).$\n\nSo, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186237989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36b1a6cb-d9b2-5499-9bed-f6591d1d13f1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437318} {:answer/id #uuid "6d863ba2-7deb-5dbd-a418-153187c043da" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437319}] :answer-field/correct {:answer/id #uuid "36b1a6cb-d9b2-5499-9bed-f6591d1d13f1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437318} :answer-field/id #uuid "b085e966-e913-5fdf-8891-5d9c59a6837a" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438688} {:answer-field/choices [{:answer/id #uuid "dff2e6d4-d7e6-5cbf-8bd1-6ae518e69246" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437320} {:answer/id #uuid "4419d897-28a5-5bc9-9d30-6eda47c75fc6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437321}] :answer-field/correct {:answer/id #uuid "4419d897-28a5-5bc9-9d30-6eda47c75fc6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437321} :answer-field/id #uuid "772ee15e-615c-53a7-b9f0-b705e3e4cbdd" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438689} {:answer-field/choices [{:answer/id #uuid "e2a96a27-f532-56b1-b071-6cec50f8503f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437322} {:answer/id #uuid "d47830c6-0653-572d-a8a7-41bbd043f9fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437323}] :answer-field/correct {:answer/id #uuid "d47830c6-0653-572d-a8a7-41bbd043f9fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437323} :answer-field/id #uuid "98d41179-1f25-5250-b6ec-ea5a42b8c13b" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438690}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6f5925ee-40c3-50af-9950-ecf1ea188724" :question/math-academy-id "q-103295" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\nSelect all that apply.\n\n- **I.** The vertical asymptotes of the function are $x=2n\\pi $\n- **II.** Its graph passes through the point $(0,0)$\n- **III.** $tan⁡(x-\\frac{\\pi }{6})=tan⁡(x+\\frac{5\\pi }{6})$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/c2/c2d0606829588b01f6cba2fa4785b201c47a6d9ffa325d54e64544c9769d7e4a.png)\n\nLet's examine each statement.\n\n- Statement I is false. The function has an asymptote at $x=\\frac{\\pi }{2}$ and the period is $\\pi .$ Therefore, the asymptotes occur at $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement II is true. Indeed, the graph of the function passes through the point $(0,0).$\n\n- Statement III is true. The function $y=tan⁡x$ has period $\\pi .$ So, $tan⁡(x-\\frac{\\pi }{6})=tan⁡(x-\\frac{\\pi }{6}+\\pi )=tan⁡(x+\\frac{5\\pi }{6}).$\n\nSo, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186297168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df692c1e-d1d5-5935-aa4f-58e66111c366" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438034} {:answer/id #uuid "9b4152bd-b840-569a-98b3-f7a6bbc4543b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438035}] :answer-field/correct {:answer/id #uuid "9b4152bd-b840-569a-98b3-f7a6bbc4543b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438035} :answer-field/id #uuid "4c4ce857-699d-5650-bbce-c9a33e567439" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439046} {:answer-field/choices [{:answer/id #uuid "0ebcf390-41da-5232-afcf-76ca3cd35d70" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438036} {:answer/id #uuid "c855dbc6-62a7-535d-acf4-3e0422823e8e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438037}] :answer-field/correct {:answer/id #uuid "0ebcf390-41da-5232-afcf-76ca3cd35d70" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438036} :answer-field/id #uuid "c9ad80d7-8062-5402-b3db-57b743c9edc8" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439047} {:answer-field/choices [{:answer/id #uuid "4b955e63-485d-5f8d-acaf-14b8077b8a15" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438038} {:answer/id #uuid "2efbdf03-740a-56f5-983f-e118131d7d73" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438039}] :answer-field/correct {:answer/id #uuid "2efbdf03-740a-56f5-983f-e118131d7d73" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438039} :answer-field/id #uuid "97cebb1e-e8e5-51e9-a969-4786401b7b78" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439048}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4be11add-d875-5219-b83f-33d16bf37abb" :question/math-academy-id "q-28675" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\nSelect all that apply.\n\n- **I.** $tan⁡(x+\\pi )=tan⁡(x+n\\pi ).$\n- **II.** The function has asymptotes at $x=n\\pi $\n- **III.** $tan⁡(x-\\frac{\\pi }{2})=tan⁡(x+\\frac{\\pi }{2}).$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/31/31b430f003171dcc04a8f17402d6035fbbc305c244d3676bbf5da83fa447bd50.png)\n\nLet's examine each statement.\n\n- Statement I is true. The function $y=tan⁡x$ has period $\\pi .$ So, $tan⁡(x+\\pi )=tan⁡(x)=tan⁡(x+n\\pi )$ for any integer $n.$\n\n- Statement II is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement III is true. The function $y=tan⁡x$ has period $\\pi .$ So, $tan⁡(x-\\frac{\\pi }{2})=tan⁡(x-\\frac{\\pi }{2}+\\pi )=tan⁡(x+\\frac{\\pi }{2}).$"} {:db/id #edb/ref 17592186297238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be00b005-d8ae-5556-989d-9072cc71e838" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438100} {:answer/id #uuid "3bbcac9c-60a0-50a4-942c-941011f376c9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438101}] :answer-field/correct {:answer/id #uuid "be00b005-d8ae-5556-989d-9072cc71e838" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438100} :answer-field/id #uuid "32c87592-feba-5843-b53f-3dd7cba9448b" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439079} {:answer-field/choices [{:answer/id #uuid "6abcd6a9-7b5e-5d6b-9996-2c86b49036f4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438102} {:answer/id #uuid "8b000f1f-8a8f-5516-94cf-8fdecbb9fac6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438103}] :answer-field/correct {:answer/id #uuid "8b000f1f-8a8f-5516-94cf-8fdecbb9fac6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438103} :answer-field/id #uuid "988a8e84-3487-5c91-b92c-117dfb072fd4" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439080} {:answer-field/choices [{:answer/id #uuid "eae80eb8-ecc1-50d6-bf8d-03a87f7208d5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438104} {:answer/id #uuid "0f1d5a9d-8037-593f-a297-14c9b5d70607" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438105}] :answer-field/correct {:answer/id #uuid "eae80eb8-ecc1-50d6-bf8d-03a87f7208d5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438104} :answer-field/id #uuid "22795c00-f02a-5d3a-8c66-e44547341575" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439081}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c5a3a079-0ec8-5b33-84d2-568517288149" :question/math-academy-id "q-29608" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{tan}⁡x?$ Assume that $n$ represents any integer.\n\nSelect all that apply.\n\n- **I.** The function has asymptotes at $x=n\\pi .$\n\n- **II.** $\\operatorname{tan}⁡(x)=\\operatorname{tan}⁡(x+2n\\pi ).$\n\n- **III.** The range of the function is $[-1,1].$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/31/31b430f003171dcc04a8f17402d6035fbbc305c244d3676bbf5da83fa447bd50.png)\n\nLet's examine each statement.\n\n- Statement I is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement II is true. The function has period $\\pi .$ So, $tan⁡(x+2n\\pi )=tan⁡(x+n\\pi +n\\pi )=tan⁡(x+n\\pi )=tan⁡(x).$\n\n- Statement III is false. The range of $y=tan⁡x$ is $(-\\infty ,+\\infty ).$"} {:db/id #edb/ref 17592186515916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f74909d-3917-5c2c-ab2f-dd1b795a3b27" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515929} {:answer/id #uuid "e4e63d41-590c-51d9-be3e-9529b97aa13f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515999}] :answer-field/correct {:answer/id #uuid "3f74909d-3917-5c2c-ab2f-dd1b795a3b27" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515929} :answer-field/id #uuid "58d19d64-0412-5d33-bb62-bc6da3b833f8" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515937} {:answer-field/choices [{:answer/id #uuid "a3f6b5ee-38f3-5b40-85a8-9992cbe5a3e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515969} {:answer/id #uuid "a78b662a-1866-5d3a-9082-787353e6d592" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515970}] :answer-field/correct {:answer/id #uuid "a3f6b5ee-38f3-5b40-85a8-9992cbe5a3e0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515969} :answer-field/id #uuid "697f706a-db33-5589-87cb-f6bb5a07193d" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515944} {:answer-field/choices [{:answer/id #uuid "798ef0e1-48c8-530a-81db-9a4a0aa42ac1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515951} {:answer/id #uuid "feba7162-d932-5146-90aa-e0386fd42d87" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186516014}] :answer-field/correct {:answer/id #uuid "798ef0e1-48c8-530a-81db-9a4a0aa42ac1" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515951} :answer-field/id #uuid "fb3f4145-d21c-57db-a5fa-197de63efd53" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186516009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0611bd23-ee0e-588d-8010-4f01ff7ae188" :question/problem "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The zeros of the function are exactly $x=n\\pi.$\n- **II.** The vertical asymptotes are exactly $x=\\frac{\\pi}{2}+n\\pi.$\n- **III.** The range of the function is $[-1,1].$" :question/worked-solution "Let's plot the graph of $y=\\tan x.$\n\n![](images/e6/e65a2728d8bdad40af736ced1ec8303bf10fb4d11fc66b33784663512093a26b.png)\n\nLet's go through each statement.\n\n- Statement I is true. The zeros occur at $x=0,\\pm\\pi,\\pm2\\pi,\\ldots,$ which can be written as $x=n\\pi.$\n\n- Statement II is true. The function has an asymptote at $x=\\frac{\\pi}{2}$ and the period is $\\pi.$ Therefore, the asymptotes occur at $x=\\frac{\\pi}{2}+n\\pi.$\n\n- Statement III is false. The function takes values on all the real numbers, hence the range is $(-\\infty,\\infty).$\n\nSo, the correct answer is \"I and II only\"."} {:db/id #edb/ref 17592186515926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75a178e2-b8a0-5e23-95d8-57e0b22e66e8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515948} {:answer/id #uuid "cea54101-9dc1-513c-8325-1c76ddfeb073" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515989}] :answer-field/correct {:answer/id #uuid "cea54101-9dc1-513c-8325-1c76ddfeb073" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515989} :answer-field/id #uuid "131a63aa-afd8-5dd6-98ab-74699ace8718" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515920} {:answer-field/choices [{:answer/id #uuid "0f0a2436-d2b8-5ada-bc74-03b482439509" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515917} {:answer/id #uuid "2d3d707f-8861-51cf-bd71-44eb3c3678ba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515924}] :answer-field/correct {:answer/id #uuid "2d3d707f-8861-51cf-bd71-44eb3c3678ba" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515924} :answer-field/id #uuid "8b59ef31-8c85-53fa-af26-f5a8104dc0e2" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515960} {:answer-field/choices [{:answer/id #uuid "37f2a0ca-c13a-53b6-8fde-b6f03e923b0e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515927} {:answer/id #uuid "93abb7ed-08f3-5fe3-b5e8-61618de9def4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515961}] :answer-field/correct {:answer/id #uuid "93abb7ed-08f3-5fe3-b5e8-61618de9def4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515961} :answer-field/id #uuid "e5c77fec-21b9-5241-91cb-3a7932d621ee" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186516000}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "34e68721-06df-5e4c-ae2f-a9024e61fe8c" :question/problem "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The domain is all real numbers.\n- **II.** The function is negative throughout $(-\\frac{\\pi}{2}+n\\pi,n\\pi).$\n- **III.** The least positive period is $\\pi.$" :question/worked-solution "Let's plot the graph of $y=\\tan x.$\n\n![](images/e6/e65a2728d8bdad40af736ced1ec8303bf10fb4d11fc66b33784663512093a26b.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function is defined everywhere except where $x=\\frac{\\pi}{2}+n\\pi.$\n\n- Statement II is true. The function is positive on $(0,\\frac{\\pi}{2})$ and negative on $(-\\frac{\\pi}{2},0).$ The period is $\\pi,$ so these signs repeat after each integer multiple of $\\pi.$\n\n- Statement III is true. The graph repeats after a horizontal shift of $\\pi,$ and no smaller positive shift repeats the whole graph. Therefore, the least positive period is $\\pi.$\n\nSo, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186515938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0216de2e-4a0f-57e3-9b57-0ff0f473bd35" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515915} {:answer/id #uuid "cb9acb2e-307a-5bff-84df-1d99817452ce" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515986}] :answer-field/correct {:answer/id #uuid "cb9acb2e-307a-5bff-84df-1d99817452ce" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515986} :answer-field/id #uuid "11def7b4-86ae-5083-b3a6-95ac3f063630" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515919} {:answer-field/choices [{:answer/id #uuid "579b7bf4-e674-5a6e-b50f-733059831e20" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515936} {:answer/id #uuid "f1aa9208-25fb-5388-854e-ae4d8c510856" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186516004}] :answer-field/correct {:answer/id #uuid "f1aa9208-25fb-5388-854e-ae4d8c510856" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186516004} :answer-field/id #uuid "8931d3a2-66cf-56b8-bac8-575ecfa645ca" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186515958} {:answer-field/choices [{:answer/id #uuid "9a9e56e4-bf34-5382-b3b1-43439c58246b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515966} {:answer/id #uuid "be607b27-6eca-5b4a-9d6d-c11c7c093414" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515980}] :answer-field/correct {:answer/id #uuid "9a9e56e4-bf34-5382-b3b1-43439c58246b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515966} :answer-field/id #uuid "f5857270-a22c-56e6-97bf-70aed0be91ec" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186516006}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "599ca534-9c31-5bf4-83d8-146c8a000e49" :question/problem "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The zeros of the function are exactly $x=n\\pi.$\n- **II.** The vertical asymptotes are exactly $x=2n\\pi.$\n- **III.** The range of the function is $(-\\frac{\\pi}{2},\\frac{\\pi}{2}).$" :question/worked-solution "Let's plot the graph of $y=\\tan x.$\n\n![](images/e6/e65a2728d8bdad40af736ced1ec8303bf10fb4d11fc66b33784663512093a26b.png)\n\nLet's go through each statement.\n\n- Statement I is true. The zeros occur at $x=0,\\pm\\pi,\\pm2\\pi,\\ldots,$ which can be written as $x=n\\pi.$\n\n- Statement II is false. The function has an asymptote at $x=\\frac{\\pi}{2}$ and the period is $\\pi.$ Therefore, the asymptotes occur at $x=\\frac{\\pi}{2}+n\\pi.$\n\n- Statement III is false. The function takes values on all the real numbers, hence the range is $(-\\infty,\\infty).$\n\nSo, the correct answer is \"I only\"."} {:db/id #edb/ref 17592186515955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac1ccbbf-2e1d-5283-8a4e-55267eec4969" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186515972} {:answer/id #uuid "ddda8b05-602f-59e2-bda7-7dc6611e7e43" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186515995}] :answer-field/correct {:answer/id #uuid "ddda8b05-602f-59e2-bda7-7dc6611e7e43" :answer/type {:db/ident :answer.type/text} :answer/val