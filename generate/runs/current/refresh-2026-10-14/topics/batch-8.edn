#{[{:db/id #edb/ref 17592186048863 :topic/_next [{:db/id #edb/ref 17592186049304 :topic/math-academy-id 29 :topic/title "Adding and Subtracting Matrices"} {:db/id #edb/ref 17592186049939 :topic/math-academy-id 137 :topic/title "Distributing the Negative Sign in a Linear Expression"}] :topic/id #uuid "c769a4f9-fb8c-5389-aac8-802ee9b0afb4" :topic/knowledge-points [{:db/id #edb/ref 17592186100991 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100686 :question/id #uuid "0928c2fa-a772-5d39-a638-1b1d0e71be2f" :question/math-academy-id "e-4378" :question/problem "Calculate $A-(B-C),$ where\n\n$$\n\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}\n$$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}A-(B-C) & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-(\\begin{bmatrix}-1 & -1 \\\\ 2 & 0\\end{bmatrix}-\\begin{bmatrix}0 & -5 \\\\ 1 & 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-\\begin{bmatrix}-1-0 & -1-(-5) \\\\ 2-1 & 0-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-\\begin{bmatrix}-1 & 4 \\\\ 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1-(-1) & 0-4 \\\\ 2-1 & -2-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -4 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"} {:db/id #edb/ref 17592186100992 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100687 :question/id #uuid "1b15db42-aba2-575c-a01e-b715450329fd" :question/math-academy-id "e-4379" :question/problem "Find $A+C-(B+A),$ if\n\n$$\n\\begin{bmatrix}1 & -2 \\\\ \\sqrt{2} & 0 \\\\ 0 & -2\\end{bmatrix}\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses: \n\n$$\n\\begin{aligned}A+C-(B+A) & =A+C-B-A \\\\  & =\\cancel{A}+C-B-\\cancel{A} \\\\  & =C-B\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}C-B & =\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}-\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3-3 & -1-(-1) \\\\ 1-2 & 2-0 \\\\ -6-(-4) & 1-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -1 & 2 \\\\ -2 & 0\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :topic/math-academy-id 1168 :topic/title "Properties of Matrix Addition"}] [{:db/id #edb/ref 17592186049304 :topic/_next [{:db/id #edb/ref 17592186048896 :topic/math-academy-id 861 :topic/title "Introduction to Matrices"} {:db/id #edb/ref 17592186049626 :topic/math-academy-id 297 :topic/title "Subtracting a Negative Number"} {:db/id #edb/ref 17592186050421 :topic/math-academy-id 328 :topic/title "Adding a Negative Number"}] :topic/id #uuid "eb12f285-e65a-58f1-8269-2aaa56459015" :topic/knowledge-points [{:db/id #edb/ref 17592186054648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054545 :question/id #uuid "45832301-e578-578d-8866-147b998a1c22" :question/math-academy-id "e-4374" :question/problem "Calculate $A+B,$ where\n\n$$\n\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & -5 \\\\ -2 & 3\\end{bmatrix}+\\begin{bmatrix}-10 & 2 \\\\ 2 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}1-10 & -5+2 \\\\ -2+2 & 3-4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -3 \\\\ 0 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Adding Square Matrices"} {:db/id #edb/ref 17592186054649 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054546 :question/id #uuid "fc4a66f3-5180-5ac0-bd4d-830196fa459a" :question/math-academy-id "e-4375" :question/problem "Calculate $A-B,$ where\n\n$$\n\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}\n$$" :question/worked-solution "We subtract the corresponding entries:\n\n$$\n\\begin{aligned}A-B & =\\begin{bmatrix}2 & -1 \\\\ -1 & 0 \\\\ 3 & 2\\end{bmatrix}-\\begin{bmatrix}0 & -1 \\\\ 2 & -1 \\\\ -1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2-0 & -1-(-1) \\\\ -1-2 & 0-(-1) \\\\ 3-(-1) & 2-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ -3 & 1 \\\\ 4 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Subtracting Matrices"} {:db/id #edb/ref 17592186054650 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054547 :question/id #uuid "b77816bd-e128-5888-9973-97c51c99f7f0" :question/math-academy-id "e-4396" :question/problem "Calculate ${A}+ {B},$ where\n\n$$\n\\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix}\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}1 & 3 & 1 & 0 \\\\ 2 & 4 & -1 & 2\\end{bmatrix}+\\begin{bmatrix}-2 & -3 & 1 & 1 \\\\ 1 & -2 & 3 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-2) & 3+(-3) & 1+1 & 0+1 \\\\ 2+1 & 4+(-2) & -1+3 & 2+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 & 2 & 1 \\\\ 3 & 2 & 2 & 3\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Adding Non-Square Matrices"}] :topic/math-academy-id 29 :topic/next [{:db/id #edb/ref 17592186048863 :topic/math-academy-id 1168 :topic/title "Properties of Matrix Addition"} {:db/id #edb/ref 17592186050979 :topic/math-academy-id 146 :topic/title "Scalar Multiplication of Matrices"}] :topic/title "Adding and Subtracting Matrices"}] [{:db/id #edb/ref 17592186050714 :topic/_next [{:db/id #edb/ref 17592186050291 :topic/math-academy-id 112 :topic/title "Properties of the Unit Circle in the First Quadrant"}] :topic/id #uuid "60b97f00-f86a-5a4f-834e-1a83f8ee3cc2" :topic/knowledge-points [{:db/id #edb/ref 17592186110754 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110456 :question/id #uuid "42313322-7535-5969-ad84-958449e48c1b" :question/math-academy-id "e-3480" :question/problem "The point $A$ is located in the first quadrant and lies on the unit circle. The $y$-coordinate of $A$ is $\\dfrac{5}{9}.$ What is the $x$-coordinate of $A?$" :question/worked-solution "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\nx^2+y^2=1 .\n$$\n\nSubstituting $y=\\dfrac{5}{9}$ into the above and solving for $x$ gives\n\n$$\n\\eqalign{\n\t\tx^2+y^2&=1\\[5pt]\n\t        x^2+\\left(\\dfrac{5}{9}\\right)^2&=1\\[5pt]\n\t\tx^2+\\left(\\dfrac{25}{81}\\right)&=1\\[5pt]\n\t\tx^2&= 1-\\dfrac{25}{81}\\[5pt]\n\t\tx^2&= \\dfrac{56}{81}\\[5pt]\n\t\tx&= \\sqrt{\\dfrac{56}{81}}\\[5pt]\n\t        x&= \\pm \\dfrac{2\\sqrt{14}}{9}.\n}\n$$\n\nSince $A$ lies in the first quadrant, $x$ must be positive. So, we select the positive answer. \n\nTherefore, our final answer is $x=\\dfrac{2\\sqrt{14}}{9}.$"} :knowledge-point/title "Using the Pythagorean Theorem on the Unit Circle"} {:db/id #edb/ref 17592186110755 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110457 :question/id #uuid "02c747c2-0eda-5c53-8e43-829f878dd278" :question/math-academy-id "e-3482" :question/problem "![](images/aa/aad0b38f5afb88c13039ac577a927e232d84905de40297ed824c966795ce7bb4.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2}{3},$ use the Pythagorean identity to find $\\sin\\theta.$" :question/worked-solution "Any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2}{3}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{9}} \\\\  & =\\pm \\sqrt{\\frac{5}{9}} \\\\  & =\\pm \\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $\\sin\\theta$ is positive in the first quadrant. \n\nSo our final answer is $\\sin\\theta = \\dfrac{\\sqrt 5}{3}.$"} :knowledge-point/title "Computing a Trigonometric Ratio Using the Pythagorean Identity"} {:db/id #edb/ref 17592186110756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110458 :question/id #uuid "bbf71023-510c-54af-9d0c-4df6744e3007" :question/math-academy-id "e-3484" :question/problem "![](images/e5/e50848432dd18a4a5dc64d4e5a5cfb8b3e14e9fed6231774dd83ead5552cd463.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2\\sqrt 6}{7},$ use the Pythagorean identity to find $\\csc\\theta.$" :question/worked-solution "Again, any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2\\sqrt 6}{7}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2\\sqrt 6}{7}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2\\sqrt 6}{7}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2\\sqrt{6}}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{24}{49}} \\\\  & =\\pm \\sqrt{\\frac{25}{49}} \\\\  & =\\pm \\frac{5}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. So, $\\sin\\theta = \\dfrac{5}{7}.$\n\nFinally, knowing that $\\csc\\theta = \\dfrac{1}{\\sin\\theta},$ we have\n\n$$\n\\csc\\theta = \\dfrac{1}{\\left(\\dfrac{5}{7}\\right)} = \\dfrac{7}{5}.\n$$"} :knowledge-point/title "Computing a Reciprocal Ratio Using the Pythagorean Identity"} {:db/id #edb/ref 17592186110758 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110459 :question/id #uuid "ba6cc6a0-dbb8-58d2-9d02-c76310028d4e" :question/math-academy-id "e-3485" :question/problem "![](images/e6/e666ddc8a8eda452abd833e963446c96de5d34dfbf76e9c92564e85a48080524.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{4}{5},$ what is $\\tan\\theta?$" :question/worked-solution "We're given that $x=\\dfrac{4}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{4}{5}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{4}{5}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{4}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{16}{25}} \\\\  & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. Therefore $\\sin\\theta = \\dfrac{3}{5}.$\n\nUsing the fact that\n\n$$\n\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta},\n$$\n\nwe finally get\n\n$$\n\\tan\\theta = \\dfrac{\\left(\\dfrac{3}{5}\\right)}{\\left(\\dfrac{4}{5}\\right)} = \\dfrac {3}{4}.\n$$"} :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :topic/math-academy-id 1453 :topic/next [{:db/id #edb/ref 17592186048461 :topic/math-academy-id 2021 :topic/title "Extending the Pythagorean Identity to All Quadrants"} {:db/id #edb/ref 17592186049488 :topic/math-academy-id 207 :topic/title "Simplifying Expressions Using the Pythagorean Identity"} {:db/id #edb/ref 17592186049797 :topic/math-academy-id 6175 :topic/title "Calculating Trigonometric Ratios From Descriptions"}] :topic/title "Using the Pythagorean Identity in the First Quadrant"}] [{:db/id #edb/ref 17592186050979 :topic/_next [{:db/id #edb/ref 17592186049304 :topic/math-academy-id 29 :topic/title "Adding and Subtracting Matrices"} {:db/id #edb/ref 17592186050163 :topic/math-academy-id 1167 :topic/title "Index Notation for Matrices"} {:db/id #edb/ref 17592186050613 :topic/math-academy-id 40 :topic/title "Solving One-Step Multiplication and Division Equations"}] :topic/id #uuid "76be574f-7aed-5702-a936-6383d4a34609" :topic/knowledge-points [{:db/id #edb/ref 17592186059740 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059549 :question/id #uuid "4391bd7a-560e-5b59-bf5c-b68ff235c05e" :question/math-academy-id "e-4380" :question/problem "Calculate $-2A$, if \n$A=\\left\\lbrack\n    \t\\matrix {\n        \t2 & -1 \\\n        \t4 & 7\n    \t}\n    \t\\right\\rbrack.$" :question/worked-solution "We multiply each entry of $A$ by $-2,$ as follows:\n\n$$\n\\begin{aligned}-2A & =-2\\begin{bmatrix}2 & -1 \\\\ 4 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2\\cdot 2 & -2\\cdot (-1) \\\\ -2\\cdot 4 & -2\\cdot 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-4 & 2 \\\\ -8 & -14\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Multiplying a Matrix by a Scalar"} {:db/id #edb/ref 17592186059741 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059550 :question/id #uuid "69ac9cdd-b27b-5b90-be25-02252df54e9e" :question/math-academy-id "e-4381" :question/problem "If $k {A} =\n\\left\\lbrack\n    \t\\matrix {\n        \t1 & 3 & 4 \\\n        \t6 & 0 & -2\n    \t}\n    \t\\right\\rbrack,$\nwhere ${A} =\n\\left\\lbrack\n    \t\\matrix {\n        \t2 & 6 & 8 \\\n        \t12 & 0 & -4\n    \t}\n    \t\\right\\rbrack$\nand $k$ is a scalar, calculate the value of $k.$" :question/worked-solution "To express $kA,$ we multiply each entry of $A$ by $k,$ as follows:\n\n$$\n\\begin{aligned}kA & =k\\cdot \\begin{bmatrix}2 & 6 & 8 \\\\ 12 & 0 & -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}2k & 6k & 8k \\\\ 12k & 0 & -4k\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we set the above result equal to the matrix given for $kA$ in the problem statement:\n\n$$\n\\left\\lbrack\n    \t\\matrix {\n        \t2k & 6k & 8k \\\n        \t12k & 0 & -4k\n    \t}\n    \t\\right\\rbrack\n=\n\\left\\lbrack\n    \t\\matrix {\n        \t1 & 3 & 4 \\\n        \t6 & 0 & -2\n    \t}\n    \t\\right\\rbrack\n$$\n\nWe can solve for $k$ by equating any two corresponding (nonzero) elements. Let's choose the top-left elements, $2k$ and $1.$ Equating these elements, we get\n\n$$\n\\begin{aligned}2k & =1 \\\\ k & =\\frac{1}{2}.\\end{aligned}\n$$\n\n**Note:** We would still get the same result if we chose any other two corresponding (nonzero) elements."} :knowledge-point/title "Calculating the Value of a Scalar"} {:db/id #edb/ref 17592186059742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059551 :question/id #uuid "1828e8ba-504d-5b20-b5fa-82005c7588f6" :question/math-academy-id "e-4382" :question/problem "Calculate $2 {A} + \\dfrac{1}{2} {B}$, where\n$\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}$ and ${B}=\n    \\left\\lbrack\n    \\matrix {\n        0 & 2 \\\n        4 & 2\n    }\n    \\right\\rbrack\n.$" :question/worked-solution "We multiply each entry of $A$ by $2$ and each entry of $B$ by $\\dfrac{1}{2},$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}2A+\\frac{1}{2}B & =2\\begin{bmatrix}1 & 5 \\\\ 1 & 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}0 & 2 \\\\ 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 1 & 2\\cdot 5 \\\\ 2\\cdot 1 & 2\\cdot 2\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{2}\\cdot 0 & \\frac{1}{2}\\cdot 2 \\\\ \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 10 \\\\ 2 & 4\\end{bmatrix}+\\begin{bmatrix}0 & 1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2+0 & 10+1 \\\\ 2+2 & 4+1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 & 11 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :topic/math-academy-id 146 :topic/next [{:db/id #edb/ref 17592186049548 :topic/math-academy-id 864 :topic/title "Inverses of 2x2 Matrices"} {:db/id #edb/ref 17592186049737 :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"} {:db/id #edb/ref 17592186050727 :topic/math-academy-id 232 :topic/title "The Transpose of a Matrix"} {:db/id #edb/ref 17592186050825 :topic/math-academy-id 1195 :topic/title "Multiplying a Matrix by a Column Vector"}] :topic/title "Scalar Multiplication of Matrices"}]}
