#{[{:db/id #edb/ref 17592186048245 :topic/_next [{:db/id #edb/ref 17592186050101 :topic/math-academy-id 1112 :topic/title "Integrating Exponential Functions Using Linear Substitution"}] :topic/id #uuid "8bdb85a0-8774-5298-bc46-db4f7969ae17" :topic/knowledge-points [{:db/id #edb/ref 17592186184349 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183945 :question/id #uuid "3e9586ee-12d1-5dbb-81f6-0f0a4998e00a" :question/math-academy-id "e-14402" :question/problem "Calculate  $\\displaystyle{\\int x^2 e^{x^3+1}\\, \\textrm{d}x }.$" :question/worked-solution "Let's introduce the new variable $u = x^3+1.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 3x^2\\quad\\Longrightarrow\\quad\\dfrac 1 3 \\textrm{d}u = x^2 \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{e}^{{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{{x}^{3}+1}\\cdot \\,{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{{x}^{3}+1}+C.\\end{aligned}\n$$"} :knowledge-point/title "Integrating Products Containing the Exponential Function"} {:db/id #edb/ref 17592186184350 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183946 :question/id #uuid "ab4772a2-f980-5ad7-a377-34e34b95be83" :question/math-academy-id "e-14403" :question/problem "Calculate  $\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x.$" :question/worked-solution "Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \n\n$$\n\\dfrac{ \\textrm{d}u}{ \\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\\int {x^3\\,{3^{1-x^4}} }\\, \\textrm{d}x \n&=\\int {{3^{1-x^4}}\\cdot x^3 }\\, \\textrm{d}x \\[5pt]\n&=  \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u\\[5pt]\n                                                     &= -\\dfrac{1}{4}\\int {3^{u}}  \\textrm{d}u\\[5pt]\n                                                     &=  -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C\\[5pt]\n                                                     &=   -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C.\n}\n$$"} :knowledge-point/title "Integrating Products Containing Other Exponential Functions"} {:db/id #edb/ref 17592186184351 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183947 :question/id #uuid "70fd3433-e905-5643-8e55-0bdf774d781e" :question/math-academy-id "e-14404" :question/problem "Calculate  $\\displaystyle \\int \\dfrac {e^{2x}} {e^{2x} + 1} \\, \\textrm{d}x.$" :question/worked-solution "Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u = e^{2x}+1.$ Differentiating gives \n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 2e^{2x}\\quad\\Longrightarrow\\quad\n\\dfrac{1}{2}\\, \\textrm{d}u = e^{2x} \\, \\textrm{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{e}^{2x}}{{e}^{2x}+1}\\,\\text{d}x & =\\int \\frac{1}{{e}^{2x}+1}\\cdot {e}^{2x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{e}^{2x}+1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({e}^{2x}+1)+C.\\end{aligned}\n$$\n\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x.$"} :knowledge-point/title "More Complex Cases"} {:db/id #edb/ref 17592186184352 :knowledge-point/canonical-example {:db/id #edb/ref 17592186183948 :question/id #uuid "a99e8d2c-1934-57a9-9a6a-578ec9230f6f" :question/math-academy-id "e-14407" :question/problem "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt {\\ln 4}} 16xe^{-2x^2}\\, \\textrm{d}x}$." :question/worked-solution "Let's introduce the new variable $u=-2x^2.$ Differentiating gives\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=-4x\n\\qquad\\Longrightarrow\\qquad\n-4 \\, \\textrm{d}u=16x \\, \\textrm{d}x.\n$$\n\nNext, we determine the new limits of integration:\n\n| $x$ | $0$ | $\\sqrt {\\ln 4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\ln 4$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}16x{e}^{-2{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{\\operatorname{ln}⁡4}}{e}^{-2{x}^{2}}\\cdot 16x\\,\\text{d}x \\\\  & ={\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\cdot (-4\\,\\text{d}u) \\\\  & =-4{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}\\,\\text{d}u \\\\  & =-4{e}^{u}\\,{|}_{0}^{-2\\operatorname{ln}⁡4} \\\\  & =-4({e}^{-2\\operatorname{ln}⁡4}-{e}^{0}) \\\\  & =-4(\\frac{1}{16}-1) \\\\  & =4(\\frac{15}{16}) \\\\  & =\\frac{15}{4}.\\end{aligned}\n$$"} :knowledge-point/title "Evaluating Definite Integrals"}] :topic/math-academy-id 3770 :topic/next [{:db/id #edb/ref 17592186048996 :topic/math-academy-id 2513 :topic/title "Integrating Density Functions"} {:db/id #edb/ref 17592186049202 :topic/math-academy-id 1085 :topic/title "Integrating Vector-Valued Functions"} {:db/id #edb/ref 17592186049380 :topic/math-academy-id 1061 :topic/title "Solving First-Order ODEs Using Direct Integration"} {:db/id #edb/ref 17592186049947 :topic/math-academy-id 762 :topic/title "Calculating Velocity Using Integration"} {:db/id #edb/ref 17592186049952 :topic/math-academy-id 2512 :topic/title "Integrating Rates of Change"} {:db/id #edb/ref 17592186050207 :topic/math-academy-id 1992 :topic/title "Double Integrals Over Rectangular Domains"} {:db/id #edb/ref 17592186050217 :topic/math-academy-id 760 :topic/title "The Arc Length of a Planar Curve"} {:db/id #edb/ref 17592186050379 :topic/math-academy-id 759 :topic/title "Improper Integrals of the Second Kind"} {:db/id #edb/ref 17592186050929 :topic/math-academy-id 317 :topic/title "Introduction to Integration by Parts"} {:db/id #edb/ref 17592186051015 :topic/math-academy-id 4004 :topic/title "Improper Integrals Involving Exponential Functions"}] :topic/title "Integrating Exponential Functions Using Substitution"}] [{:db/id #edb/ref 17592186048754 :topic/_next [{:db/id #edb/ref 17592186049443 :topic/math-academy-id 1361 :topic/title "Integrating the Reciprocal Function"}] :topic/id #uuid "bb9926b3-3427-50e2-94a5-96b4e07466cd" :topic/knowledge-points [{:db/id #edb/ref 17592186064171 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064049 :question/id #uuid "3ff03590-c618-5a60-b2ac-e0a20be6a8ae" :question/math-academy-id "e-377" :question/problem "Calculate $\\displaystyle \\int 6e^x  \\textrm d x.$" :question/worked-solution "Factoring out the constant $6$ and taking the integral, we get\n\n$$\n\\eqalign{\n\\int 6e^x   \\textrm d x   =6 \\int e^x  \\, \\textrm d x =6e^x +C.\n                                                                               \n}\n$$"} :knowledge-point/title "Integrating the Exponential Function"} {:db/id #edb/ref 17592186064172 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064050 :question/id #uuid "66cbcaeb-93ee-5c15-a230-e66d2fbdd761" :question/math-academy-id "e-380" :question/problem "Calculate $\\displaystyle \\int -6(7^x) \\, \\textrm d x.$" :question/worked-solution "First, we factor out the constant $-6.$ Then, we integrate the exponential function, and get\n\n$$\n\\eqalign{\n\\int (-6)7^x  \\, \\textrm d x   \n&= -6\\int 7^x\\,\\textrm{d}x\\\n&=-6 \\cdot \\dfrac{7^x}{\\ln 7} + C.\n}\n$$"} :knowledge-point/title "Integrating an Exponential Function With a General Base"} {:db/id #edb/ref 17592186064177 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064051 :question/id #uuid "90010ae5-e211-510f-b188-dc3006926d94" :question/math-academy-id "e-381" :question/problem "Calculate $\\displaystyle \\int 5 \\cdot 9^x +3 e^x \\, \\textrm d x.$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\eqalign{\n\\displaystyle \\int 5 \\cdot 9^x +3 e^x  \\, \\textrm d x &= \\displaystyle 5\\int 9^x \\, \\textrm{d}x+ 3 \\displaystyle \\int e^x \\, \\textrm{d}x\\\n&= 5\\cdot \\dfrac{9^x}{\\ln 9} + 3 e^x +C.\n}\n$$"} :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :topic/math-academy-id 312 :topic/next [{:db/id #edb/ref 17592186048577 :topic/math-academy-id 2793 :topic/title "Necessary and Sufficient Conditions"} {:db/id #edb/ref 17592186050101 :topic/math-academy-id 1112 :topic/title "Integrating Exponential Functions Using Linear Substitution"} {:db/id #edb/ref 17592186050571 :topic/math-academy-id 3575 :topic/title "Applying the Fundamental Theorem of Calculus to Exponential and Trigonometric Functions"}] :topic/title "Integrating Exponential Functions"}] [{:db/id #edb/ref 17592186050473 :topic/_next [{:db/id #edb/ref 17592186048357 :topic/math-academy-id 1427 :topic/title "Perpendicular Lines in the Coordinate Plane"}] :topic/id #uuid "4c6d2580-78c9-5782-9c3a-465dcd055b32" :topic/knowledge-points [{:db/id #edb/ref 17592186175922 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175735 :question/id #uuid "ca9ba6cf-860f-5868-b91f-1dff84406f22" :question/math-academy-id "e-14357" :question/problem "Find the equation of the line that is perpendicular to $y = 4x - 1$ and passes through the point $(-8,7).$" :question/worked-solution "Let $l_1$ denote the line $y = 4x - 1,$ and let $l_2$ denote the line we want to find.\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of $l_2$ is the negative reciprocal of the slope of $l_1.$ Since $l_1$ has a slope of $4,$ the line $l_2$ must have a slope of $-\\dfrac{1}{4}.$\n\nOur perpendicular line must have the slope $m=-\\dfrac{1}{4}$ and pass through the point $(x_1,y_1)=(-8,7).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\eqalign{\ny - y_1 &= m(x-x_1) \\[5pt]\ny - 7 &= -\\dfrac{1}{4}(x-(-8)) \\[5pt]\ny - 7 &= -\\dfrac{1}{4}(x+8)\\[5pt]\ny - 7 &= -\\dfrac{1}{4}x - 2 \\[5pt]\ny &= -\\dfrac{1}{4}x + 5\n\t}\n$$"} :knowledge-point/title "Finding the Equation of a Perpendicular Line"} {:db/id #edb/ref 17592186175923 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175737 :question/id #uuid "ca9ec8da-5f74-53dc-afa7-e6cc965fcc95" :question/math-academy-id "e-14363" :question/problem "Find the equation of the line that passes through the point $(3,4)$ and is perpendicular to the line passing through the points $(0,1)$ and $(-2,4).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope $m_1$ of the line passing through the points $(0,1)$ and $(-2,4)\\mathbin{:}$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-1}{-2-0} \\\\  & =\\frac{3}{-2} \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm \\cdot \\left(-\\dfrac{3}{2}\\right) = -1 \\quad \\Rightarrow \\quad m = \\dfrac{2}{3}.\n$$\n\nWe know that the line passes through the point $(3,4).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =\\frac{2}{3}(x-3) \\\\ y-4 & =\\frac{2}{3}x-2 \\\\ y & =\\frac{2}{3}x+2\\end{aligned}\n$$"} :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"} {:db/id #edb/ref 17592186175924 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175741 :question/id #uuid "49cee7e9-29a5-5e1e-bc13-7dbabaaea405" :question/math-academy-id "e-14730" :question/problem "What is the equation of the line that passes through the point $(6,2)$ and is perpendicular to $3x-2y=1?$" :question/worked-solution "First, we write the equation $3x-2y=1$ in its slope-intercept form as follows:\n\n$$\n\\begin{aligned}3x-2y & =1 \\\\ -2y & =-3x+1 \\\\ y & =\\frac{3}{2}x-\\frac{1}{2}\\end{aligned}\n$$\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of the new line should be the negative reciprocal of the slope of the given line $y=\\dfrac{3}{2}x - \\dfrac{1}{2}.$ The given line has a slope of $\\dfrac{3}{2},$ so our perpendicular line must have a slope of $-\\dfrac{2}{3}.$\n\nOur perpendicular line must have the slope $m=-\\dfrac{2}{3}$ and pass through the point $(x_1,y_1) = (6,2).$ Using point-slope form and simplifying, we obtain the equation of the line in slope-intercept form:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-\\frac{2}{3}(x-6) \\\\ y-2 & =-\\frac{2}{3}x+4 \\\\ y & =-\\frac{2}{3}x+6\\end{aligned}\n$$"} :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :topic/math-academy-id 3562 :topic/next [{:db/id #edb/ref 17592186049021 :topic/math-academy-id 1187 :topic/title "Thales' Theorem in the Coordinate Plane"} {:db/id #edb/ref 17592186049119 :topic/math-academy-id 987 :topic/title "Calculating the Equation of a Normal Line Using Differentiation"} {:db/id #edb/ref 17592186049564 :topic/math-academy-id 1184 :topic/title "Perpendicular Bisectors of Diameters in the Coordinate Plane"} {:db/id #edb/ref 17592186049583 :topic/math-academy-id 1188 :topic/title "Equations of Tangent Lines to Circles"} {:db/id #edb/ref 17592186050409 :topic/math-academy-id 526 :topic/title "The Shortest Distance Between a Point and a Line"} {:db/id #edb/ref 17592186050667 :topic/math-academy-id 6416 :topic/title "Perpendicular Lines"}] :topic/title "Finding Equations of Perpendicular Lines"}] [{:db/id #edb/ref 17592186050771 :topic/_next [{:db/id #edb/ref 17592186048557 :topic/math-academy-id 331 :topic/title "Integrating Linear Rational Functions Using Substitution"}] :topic/id #uuid "655ce7e8-5c0a-5ddc-a7e7-f1d2126f4eba" :topic/knowledge-points [{:db/id #edb/ref 17592186068722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068564 :question/id #uuid "e2579380-1933-5819-a39e-9ffcfdafeeee" :question/math-academy-id "e-452" :question/problem "Calculate $\\displaystyle\\int 6x^2(2x^3+3)^6\\,\\textrm{d}x .$" :question/worked-solution "We note that $6x^2$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu=2x^3+3.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{2}\\,⟹\\,\\text{d}u=6{x}^{2}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 6{x}^{2}(2{x}^{3}+3)^{6}\\,\\text{d}x & =\\int (2{x}^{3}+3)^{6}\\,6{x}^{2}\\,\\text{d}x \\\\  & =\\int {u}^{6}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{6}\\,\\text{d}u & =\\frac{{u}^{7}}{7}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=2x^3+3$ back in the expression. So the final result is\n\n$$\n\\displaystyle\\int 6x^2(2x^3+3)^6\\,\\textrm{d}x =\\dfrac{(2x^3+3)^7}{7}+C.\n$$"} :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"} {:db/id #edb/ref 17592186068723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068565 :question/id #uuid "9bf7d343-8d3d-5194-93c4-7b80bc1e3609" :question/math-academy-id "e-453" :question/problem "Calculate $\\displaystyle\\int x\\left(1+2x^2\\right)^6\\,\\textrm{d}x .$" :question/worked-solution "The $x$ that's outside the parentheses isn't quite the derivative of $(1+2x^2).$ The derivative of $(1+2x^2)$ is $4x,$ so we're out by a constant factor of $4$. However, since we're out only by a constant factor, substitution will still work!\n\nSo we make the substitution\n\n$$\nu=1+2x^2.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =4x\\,⟹\\,\\frac{1}{4}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x{(1+2{x}^{2})}^{6}\\,\\text{d}x & =\\int {(1+2{x}^{2})}^{6}\\cdot x\\,\\text{d}x \\\\  & =\\int {u}^{6}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int {u}^{6}\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{4}\\int {u}^{6}\\text{d}u & =\\frac{1}{4}\\cdot \\frac{{u}^{7}}{7}+C \\\\  & =\\frac{1}{28}{u}^{7}+C \\\\  & =\\frac{1}{28}{(1+2{x}^{2})}^{7}+C.\\end{aligned}\n$$"} :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"} {:db/id #edb/ref 17592186068724 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068566 :question/id #uuid "49f679c4-bbc4-59a5-9b0c-0f3b69d7cf57" :question/math-academy-id "e-454" :question/problem "Calculate $\\displaystyle \\int \\dfrac{x^2}{x^3+1}\\,\\textrm d x.$" :question/worked-solution "Let $u=x^3+1.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 3x^2\\quad\\Longrightarrow\\quad \\dfrac 1 3 \\textrm d u= x^2 \\, \\textrm d x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}}{{x}^{3}+1}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}+1}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|{x}^{3}+1|+C\\end{aligned}\n$$"} :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"} {:db/id #edb/ref 17592186068786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068628 :question/id #uuid "0461f8ba-c3c5-5e22-a679-32ee4f2a01b8" :question/math-academy-id "e-6149" :question/problem "$\\displaystyle \\int \\dfrac{x^2}{\\sqrt{1-x^3}} \\, \\textrm{d}x=$" :question/worked-solution "Let $u = 1 - x^3.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3x^2 \\quad \\Longrightarrow\\quad -\\dfrac{1}{3} \\textrm d u= x^2 \\, \\textrm d x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{3}}}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{1}{3})\\text{d}u \\\\  & =-\\frac{1}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{1}{3}(2\\sqrt{u})+C \\\\  & =-\\frac{2}{3}\\sqrt{u}+C \\\\  & =-\\frac{2}{3}\\sqrt{1-{x}^{3}}+C\\end{aligned}\n$$"} :knowledge-point/title "Integrating Other Fractional Expressions"}] :topic/math-academy-id 443 :topic/next [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"}] :topic/title "Integration Using Substitution"}]}
