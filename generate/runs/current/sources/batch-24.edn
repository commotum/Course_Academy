 \\\\ 1 & -3 & 2 \\\\ 4 & 2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-3 & 2 \\\\ 2 & -1\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 4 & -1\\end{aligned}|j+|\\begin{aligned}1 & -3 \\\\ 4 & 2\\end{aligned}|k \\\\  & =((-3)(-1)-(2)(2))i-((1)(-1)-(2)(4))j+((1)(2)-(-3)(4))k \\\\  & =(3-4)i-(-1-8)j+(2+12)k \\\\  & =-1i+9j+14k \\\\  & =⟨-1,9,14⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186366191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9c6a0d0-c117-5e96-b865-2dacd6e41994" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},5,1⟩" :db/id #edb/ref 17592186366193} {:answer/id #uuid "beb3960c-33f6-5ccc-90a2-4bf3a3443bc7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1+\\sqrt{2},5⟩" :db/id #edb/ref 17592186366194} {:answer/id #uuid "a982c283-6343-574c-a0c8-9e368c413e0c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,\\sqrt{2},5⟩" :db/id #edb/ref 17592186366195} {:answer/id #uuid "f74ec461-843d-5840-88be-501e8c5d86ab" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,5+\\sqrt{2}⟩" :db/id #edb/ref 17592186366196} {:answer/id #uuid "e3984714-c39c-544a-ac66-c149c7ec2e46" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},0,1⟩" :db/id #edb/ref 17592186366197}] :answer-field/correct {:answer/id #uuid "f74ec461-843d-5840-88be-501e8c5d86ab" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,5+\\sqrt{2}⟩" :db/id #edb/ref 17592186366196} :answer-field/id #uuid "7999650e-074f-524c-a7d0-2f7628a020e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366192}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ef7e06d8-dfe4-5df3-a085-e6e7aabbf10f" :question/math-academy-id "q-69570" :question/problem "Let $a=⟨5,\\sqrt{2},0⟩$ and $b=⟨-1,1,0⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 5 & \\sqrt{2} & 0 \\\\ -1 & 1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}\\sqrt{2} & 0 \\\\ 1 & 0\\end{aligned}|i-|\\begin{aligned}5 & 0 \\\\ -1 & 0\\end{aligned}|j+|\\begin{aligned}5 & \\sqrt{2} \\\\ -1 & 1\\end{aligned}|k \\\\  & =(\\sqrt{2}\\cdot 0-0\\cdot 1)i-(5\\cdot 0-0\\cdot (-1))j+(5\\cdot 1-\\sqrt{2}\\cdot (-1))k \\\\  & =0\\cdot i-0\\cdot j+(5+\\sqrt{2})k \\\\  & =⟨0,0,5+\\sqrt{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390360 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a2ecca-4420-5a73-85e5-d8fd94cb2fdf" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-15,5,3⟩" :db/id #edb/ref 17592186390362} {:answer/id #uuid "37f1f0b7-f7d0-59d9-b906-b1e9b3bc1438" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-15,3,5⟩" :db/id #edb/ref 17592186390363} {:answer/id #uuid "1b801238-dd43-58b7-a037-5fb7adad9f3a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,-15,5⟩" :db/id #edb/ref 17592186390364} {:answer/id #uuid "b9a830dc-88d1-5eec-a445-b8adc0a5469e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨15,5,3⟩" :db/id #edb/ref 17592186390365} {:answer/id #uuid "3abd8bb4-bf5c-5575-bf37-b9815f3df034" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,5,12⟩" :db/id #edb/ref 17592186390366}] :answer-field/correct {:answer/id #uuid "37f1f0b7-f7d0-59d9-b906-b1e9b3bc1438" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-15,3,5⟩" :db/id #edb/ref 17592186390363} :answer-field/id #uuid "9ba37642-671c-52eb-9ccf-cac56d58f19b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390361}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "765f0999-da93-5e44-b207-672576084830" :question/math-academy-id "q-19779" :question/problem "Let $a=⟨1,0,3⟩$ and $b=⟨2,5,3⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 3 \\\\ 2 & 5 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 5 & 3\\end{aligned}|i-|\\begin{aligned}1 & 3 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|k \\\\  & =(0\\cdot 3-3\\cdot 5)i-(1\\cdot 3-2\\cdot 3)j+(1\\cdot 5-2\\cdot 0)k \\\\  & =(0-15)i-(3-6)j+(5-0)k \\\\  & =⟨-15,3,5⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f43fbb-95b7-541f-8b6c-884210699c13" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,-2,30⟩" :db/id #edb/ref 17592186400752} {:answer/id #uuid "3b6022ff-41cc-5e6f-94c9-3fc31db2cbb6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,14,30⟩" :db/id #edb/ref 17592186400753} {:answer/id #uuid "45ff73b4-62a8-5ce3-88c9-d43c398f4a6a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-10,2,30⟩" :db/id #edb/ref 17592186400754} {:answer/id #uuid "904fd9b0-d482-5093-afb0-55078a667399" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,-14,30⟩" :db/id #edb/ref 17592186400755} {:answer/id #uuid "f884e2c3-8624-5ca1-87bf-175fa491b5ea" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,2,30⟩" :db/id #edb/ref 17592186400756}] :answer-field/correct {:answer/id #uuid "86f43fbb-95b7-541f-8b6c-884210699c13" :answer/type {:db/ident :answer.type/math} :answer/value "⟨10,-2,30⟩" :db/id #edb/ref 17592186400752} :answer-field/id #uuid "6f171d5e-1ede-583a-b2ab-a54f8c858c3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400751}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f2ea4789-04ff-53b9-83f0-42f591cf2261" :question/math-academy-id "q-1393" :question/problem "Let $u=⟨4,5,-1⟩$ and $v=⟨-6,0,2⟩.$ Find $u\\times v.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 4 & 5 & -1 \\\\ -6 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}5 & -1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}4 & -1 \\\\ -6 & 2\\end{aligned}|j+|\\begin{aligned}4 & 5 \\\\ -6 & 0\\end{aligned}|k \\\\  & =(5\\cdot 2-(-1)\\cdot 0)i-(4\\cdot 2-(-1)\\cdot (-6))j+(4\\cdot 0-5\\cdot (-6))k \\\\  & =(10-0)i-(8-6)j+(0-(-30))k \\\\  & =10i-2j+30k.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Cross Product Using Determinants"}] [{:db/id #edb/ref 17592186059737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059546 :question/id #uuid "b834e666-de4f-5964-a280-6571ad44b6bd" :question/math-academy-id "e-4343" :question/problem "Let $\\mathbf{a}=\\langle 3, 1, 2x \\rangle,$ $\\mathbf{b}=\\langle 0,1,x \\rangle,$ and $|\\,\\mathbf{a} \\times \\mathbf{b}\\,| = \\sqrt{19}.$ Find $x.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & 1 & 2x \\\\ 0 & 1 & x\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 2x \\\\ 1 & x\\end{aligned}|i-|\\begin{aligned}3 & 2x \\\\ 0 & x\\end{aligned}|j+|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|k \\\\  & =-xi-3xj+3k \\\\  & =⟨-x,-3x,3⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{(-x)^{2}+(-3x)^{2}+{3}^{2}} \\\\  & =\\sqrt{10{x}^{2}+9}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned} & |\\,a\\times b\\,|=\\sqrt{19} \\\\  & \\sqrt{10{x}^{2}+9}=\\sqrt{19} \\\\  & 10{x}^{2}+9=19 \\\\  & 10{x}^{2}=10 \\\\  & {x}^{2}=1\\end{aligned}\n$$\n\nTherefore, the solutions are $x= \\pm 1.$"} :knowledge-point/id #uuid "21cef8c9-92ff-5527-a837-2236a0c1f9eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048784 :topic/math-academy-id 116 :topic/title "Solving Radical Equations"} {:db/id #edb/ref 17592186051021 :topic/math-academy-id 1277 :topic/title "Calculating the Magnitude of Cartesian Vectors in 3D"}] :knowledge-point/questions [{:db/id #edb/ref 1759