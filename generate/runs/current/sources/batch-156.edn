oices [{:answer/id #uuid "83bdeed3-df37-5030-9210-4fd26c862b5d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{31}" :db/id #edb/ref 17592186400200} {:answer/id #uuid "5071b299-4f24-5216-a03b-d3bb38f10c37" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{41}" :db/id #edb/ref 17592186400201} {:answer/id #uuid "6c05e69c-1e2c-58a5-8d1d-ec8b55b911ab" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{32}" :db/id #edb/ref 17592186400202} {:answer/id #uuid "7d163472-1ec4-5e60-97dc-1403c415123e" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{42}" :db/id #edb/ref 17592186400203} {:answer/id #uuid "214dd131-7e3a-56a7-b7fd-be2f662d3fd3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{43}" :db/id #edb/ref 17592186400204}] :answer-field/correct {:answer/id #uuid "7d163472-1ec4-5e60-97dc-1403c415123e" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{42}" :db/id #edb/ref 17592186400203} :answer-field/id #uuid "93e2aeb3-64f5-5d7d-b868-6bf0abe7eba8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400199}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a14b13fa-47dd-5e1a-8086-20e6009f70ea" :question/math-academy-id "q-125611" :question/problem "Consider the highlighted entry of the matrix $Y$ given below. Describe it in terms of ${y}_{ij}.$\n\n$$\nY=[\\begin{aligned}2 & 1 \\\\ -4 & 5 \\\\ 0 & 0 \\\\ 1 & 7\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $4$th row and $2$nd column. Hence, we have ${y}_{42}=7.$"} {:db/id #edb/ref 17592186400702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53bc7c4a-ec03-5241-b616-ab551e2b27cc" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{21}" :db/id #edb/ref 17592186400704} {:answer/id #uuid "3b70af93-f0df-596a-b13f-d4cefebb16dd" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{13}" :db/id #edb/ref 17592186400705} {:answer/id #uuid "710c1a23-9554-5a6a-91ac-2f16e51847e1" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{43}" :db/id #edb/ref 17592186400706} {:answer/id #uuid "64372579-911a-5351-8eec-53ed6b8d3b83" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{22}" :db/id #edb/ref 17592186400707} {:answer/id #uuid "437a5fab-d07b-5f08-b95c-d799c5a714f7" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{34}" :db/id #edb/ref 17592186400708}] :answer-field/correct {:answer/id #uuid "437a5fab-d07b-5f08-b95c-d799c5a714f7" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{34}" :db/id #edb/ref 17592186400708} :answer-field/id #uuid "d6c4d5fd-03ba-51d6-8190-92d4e4a4e499" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400703}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "76f61515-4e83-5716-8dff-d44543d61f70" :question/math-academy-id "q-13499" :question/problem "Consider the highlighted entry of the matrix $A$ given below. Describe it in terms of ${a}_{ij}.$\n\n$$\nA=[\\begin{aligned}3 & 5 & 10 & 6 \\\\ 6 & 14 & 8 & 1 \\\\ 9 & 17 & 9 & 0\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $3$rd row and $4$th column. Hence, we have ${a}_{34}=0.$"}] :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] [{:db/id #edb/ref 17592186105732 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105590 :question/id #uuid "957d070a-edc8-521f-a5bd-d10177a0bdbc" :question/math-academy-id "e-4344" :question/problem "Calculate the area of the triangle spanned by $\\mathbf{a}=\\langle 4,0,-3 \\rangle$ and $\\mathbf{b}=\\langle 5,-1,2 \\rangle.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 4 & 0 & -3 \\\\ 5 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -3 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}4 & -3 \\\\ 5 & 2\\end{aligned}|j+|\\begin{aligned}4 & 0 \\\\ 5 & -1\\end{aligned}|k \\\\  & =(0\\cdot 2-(-3)\\cdot (-1))i-(4\\cdot 2-(-3)\\cdot 5)j+(4\\cdot (-1)-0\\cdot 5)k \\\\  & =-3i-23j-4k \\\\  & =⟨-3,-23,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{(-3)^{2}+(-23)^{2}+(-4)^{2}} \\\\  & =\\sqrt{554}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\nA_{\\triangle} = \\dfrac{1}{2}A = \\dfrac{\\sqrt{554}}{2}.\n$$"} :knowledge-point/id #uuid "f88dd688-449b-5a6d-8b91-78d00d0c932b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049132 :topic/math-academy-id 245 :topic/title "Calculating the Cross Product Using Determinants"} {:db/id #edb/ref 17592186051021 :topic/math-academy-id 1277 :topic/title "Calculating the Magnitude of Cartesian Vectors in 3D"}] :knowledge-point/questions [{:db/id #edb/ref 17592186106120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2513eb07-16be-5286-bc33-d8aa8c46c1cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{273}}{2}" :db/id #edb/ref 17592186285112} {:answer/id #uuid "66423ab8-fae7-5127-a7c3-1cdcd20b4cdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{285}}{2}" :db/id #edb/ref 17592186285714} {:answer/id #uuid "6eb9250a-2aa6-5790-8265-790a777b83b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{825}}{2}" :db/id #edb/ref 17592186285813} {:answer/id #uuid "d4231ebb-ea19-5c2a-a034-0b7b57f48b39" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{177}" :db/id #edb/ref 17592186286716} {:answer/id #uuid "d4b9c672-c12b-55d0-930a-778da5483675" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{582}}{2}" :db/id #edb/ref 17592186286720}] :answer-field/correct {:answer/id #uuid "66423ab8-fae7-5127-a7c3-1cdcd20b4cdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{285}}{2}" :db/id #edb/ref 17592186285714} :answer-field/id #uuid "ac35f525-4afb-57b4-9fa8-5e8beb00c4c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287501}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9432694c-4fbd-5497-812b-7bbf4e4f27ac" :question/math-academy-id "q-19983" :question/problem "Calculate the area of the triangle spanned by $a=⟨1,3,2⟩$ and $b=⟨4,1,-2⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 3 & 2 \\\\ 4 & 1 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ 1 & -2\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 4 & -2\\end{aligned}|j+|\\begin{aligned}1 & 3 \\\\ 4 & 1\\end{aligned}|k \\\\  & =(3\\cdot (-2)-1\\cdot 2)i-(1\\cdot (-2)-4\\cdot 2)j+(1\\cdot 1-4\\cdot 3)k \\\\  & =-8i+10j-11k \\\\  & =⟨-8,10,-11⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{(-8)^{2}+{10}^{2}+(-11)^{2}} \\\\  & =\\sqrt{285}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{285}}{2}.\n$$"} {:db/id #edb/ref 17592186106121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ac7131d-bfd4-5f3e-bab3-45391fafe62f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186102603} {:answer/id #uuid "b7e95b0b-62a1-5619-b9ab-2516eedd3655" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186102604} {:answer/id #uuid "c37bf917-2973-5eae-ac60-dce80a07a630" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186102605} {:answer/id #uuid "c93f0b80-d4cf-5996-b664-2fe92fe080b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186102606} {:answer/id #uuid "50747cd8-e107-55b8-bc9e-602c96d71358" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186102607}] :answer-field/id #uuid "89c92172-1d2c-5b8b-affa-31d099647b03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102602}] :question/id #uuid "38aabf32-76e6-58d5-9143-a45f8b36d698" :question/math-academy-id "q-20003" :question/problem "Calculate the area of the parallelogram spanned by $a = ⟨ - 2,-3,-1⟩$ and $b = ⟨1, 2, 1⟩$."} {:db/id #edb/ref 17592186287886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f5744ef-1b8e-5152-8f6b-6c58808e05e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186285821} {:answer/id #uuid "75a1e7cc-e3a2-51b8-bca9-b3b300d0756f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285880} {:answer/id #uuid "a39acd59-c1ec-51d0-a69d-f4370d5bdf1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186286288} {:answer/id #uuid "ac05f264-0ba2-5898-bdea-abf6a84471dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186286361} {:answer/id #uuid "dd89447a-889f-5b9e-92e0-00cf6cf24813" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186286804}] :answer-field/correct {:answer/id #uuid "a39acd59-c1ec-51d0-a69d-f4370d5bdf1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186286288} :answer-field/id #uuid "6af7f554-1c70-5cd5-8470-5c00835248b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287372}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8ddbfd2e-178a-532d-aeb2-81eedf1fe8dc" :question/math-academy-id "q-18580" :question/problem "Calculate the area of the triangle spanned by $r=⟨1,-2,3⟩$ and $t=⟨0,1,-2⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}r\\times t & =|\\begin{aligned}i & j & k \\\\ 1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 3 \\\\ 1 & -2\\end{aligned}|i-|\\begin{aligned}1 & 3 \\\\ 0 & -2\\end{aligned}|j+|\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}|k \\\\  & =((-2)\\cdot (-2)-3\\cdot 1)i-(1\\cdot (-2)-3\\cdot 0)j+(1\\cdot 1-(-2)\\cdot 0)k \\\\  & =i+2j+k \\\\  & =⟨1,2,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,r\\times t\\,| \\\\  & =\\sqrt{{1}^{2}+{2}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{6}}{2}.\n$$"} {:db/id #edb/ref 17592186287968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31831168-454f-5baf-9173-586eba9d4624" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{2}" :db/id #edb/ref 17592186285238} {:answer/id #uuid "3b19523e-0825-5461-afc4-1afb51acc0f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{14}}{3}" :db/id #edb/ref 17592186285344} {:answer/id #uuid "6c0bab51-aa06-5633-ad7e-cad3a75b9f36" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186285778} {:answer/id #uuid "77a22a7a-5f71-57a2-bca0-1e46be7780e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186285899} {:answer/id #uuid "c7c0d194-f09e-5a8c-aaff-63d2d1628464" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186286617}] :answer-field/correct {:answer/id #uuid "6c0bab51-aa06-5633-ad7e-cad3a75b9f36" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{14}" :db/id #edb/ref 17592186285778} :answer-field/id #uuid "35ae4963-3d48-5daa-bb09-fff5ace57f0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287258}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fa11bb3b-6421-5e71-90eb-d6514f51a379" :question/math-academy-id "q-19981" :question/problem "Calculate the area of the parallelogram spanned by $u=⟨2,1,-1⟩$ and $v=⟨1,2,0⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ 2 & 1 & -1 \\\\ 1 & 2 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}|i-|\\begin{aligned}2 & -1 \\\\ 1 & 0\\end{aligned}|j+|\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(1\\cdot 0-2\\cdot (-1))i-(2\\cdot 0-1\\cdot (-1))j+(2\\cdot 2-1\\cdot 1)k \\\\  & =2i-j+3k \\\\  & =⟨2,-1,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,u\\times v\\,| \\\\  & =\\sqrt{{2}^{2}+(-1)^{2}+{3}^{2}} \\\\  & =\\sqrt{14}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36790fe4-27d4-5430-88cf-40fdcbb1fe9b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186285294} {:answer/id #uuid "b3f9e5eb-469c-55c5-8da6-311732c4b4a7" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186286426} {:answer/id #uuid "ba27497f-dcbe-599e-afe6-02f759bdea5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{5}}{3}" :db/id #edb/ref 17592186286485} {:answer/id #uuid "bda96f26-df0a-565b-8da0-e4190336d93e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{3}}{2}" :db/id #edb/ref 17592186286522} {:answer/id #uuid "dc8e723b-8aea-5162-a514-5d1ec48189fd" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186286796}] :answer-field/correct {:answer/id #uuid "dc8e723b-8aea-5162-a514-5d1ec48189fd" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186286796} :answer-field/id #uuid "72125cc1-d961-5f15-b759-baf12f6c70d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287386}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6f2ce5a4-7f12-54b1-ab3b-420eb2d47dab" :question/math-academy-id "q-19997" :question/problem "Calculate the area of the parallelogram spanned by $f=⟨1,1,-2⟩$ and $g=⟨3,2,1⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}f\\times g & =|\\begin{aligned}i & j & k \\\\ 1 & 1 & -2 \\\\ 3 & 2 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}|i-|\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}|j+|\\begin{aligned}1 & 1 \\\\ 3 & 2\\end{aligned}|k \\\\  & =(1\\cdot 1-2\\cdot (-2))i-(1\\cdot 1-3\\cdot (-2))j+(1\\cdot 2-3\\cdot 1)k \\\\  & =5i-7j-k \\\\  & =⟨5,-7,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,f\\times g\\,| \\\\  & =\\sqrt{{5}^{2}+(-7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{75} \\\\  & =5\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce73380-2abe-591b-a501-2fffb25e9869" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186284895} {:answer/id #uuid "1b175e13-968e-5ec8-9d17-0a77d893b075" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186285027} {:answer/id #uuid "2e9105f8-f2d6-5c3f-9c60-b593e96c51d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186285206} {:answer/id #uuid "ab82b635-2160-5ed5-a7f7-47c54a617da1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186286354} {:answer/id #uuid "ace7fdea-5fb7-5fd8-aa32-30d01d52a4f2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286368}] :answer-field/correct {:answer/id #uuid "ace7fdea-5fb7-5fd8-aa32-30d01d52a4f2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286368} :answer-field/id #uuid "b1b35598-0d81-58f5-9d4e-8b067b0830b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287516}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9a99808d-9449-580d-ae70-e6aff48c1ff9" :question/math-academy-id "q-20004" :question/problem "Calculate the area of the parallelogram spanned by $h=⟨2,0,3⟩$ and $l=⟨4,1,3⟩.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}h\\times l & =|\\begin{aligned}i & j & k \\\\ 2 & 0 & 3 \\\\ 4 & 1 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 1 & 3\\end{aligned}|i-|\\begin{aligned}2 & 3 \\\\ 4 & 3\\end{aligned}|j+|\\begin{aligned}2 & 0 \\\\ 4 & 1\\end{aligned}|k \\\\  & =(0\\cdot 3-1\\cdot 3)i-(2\\cdot 3-4\\cdot 3)j+(2\\cdot 1-4\\cdot 0)k \\\\  & =-3i+6j+2k \\\\  & =⟨-3,6,2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,h\\times l\\,| \\\\  & =\\sqrt{(-3)^{2}+{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ba6a314-9690-51f8-ac65-d87aa7adaabd" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186291309}] :answer-field/correct {:answer/id #uuid "9ba6a314-9690-51f8-ac65-d87aa7adaabd" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186291309} :answer-field/id #uuid "de32afac-e614-53fa-b799-24f12769f89d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292428}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fc161987-10e4-5ee6-a6c6-ed110201a1f8" :question/math-academy-id "q-275220" :question/problem "Calculate the area $A$ of the parallelogram spanned by $a=⟨-4,-2,1⟩$ and $b=⟨0,-2,-1⟩.$\n\n$A=${{field-1}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -4 & -2 & 1 \\\\ 0 & -2 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 1 \\\\ -2 & -1\\end{aligned}|i-|\\begin{aligned}-4 & 1 \\\\ 0 & -1\\end{aligned}|j+|\\begin{aligned}-4 & -2 \\\\ 0 & -2\\end{aligned}|k \\\\  & =((-2)\\cdot (-1)-(-2)\\cdot 1)i-((-4)\\cdot (-1)-0\\cdot 1)j+((-4)\\cdot (-2)-0\\cdot (-2))k \\\\  & =4i-4j+8k \\\\  & =⟨4,-4,8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{4}^{2}+(-4)^{2}+{8}^{2}} \\\\  & =4\\sqrt{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff2a44dc-fdc6-559d-9985-a9e6ce7b18ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186291722}] :answer-field/correct {:answer/id #uuid "ff2a44dc-fdc6-559d-9985-a9e6ce7b18ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186291722} :answer-field/id #uuid "60989695-b200-54ed-9968-72677234d5ec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292028}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1c7348e7-1921-5e09-8018-775e68160619" :question/math-academy-id "q-275222" :question/problem "Calculate the area ${A}_{△}$ of the triangle spanned by $a=⟨-2,-1,0⟩$ and $b=⟨-4,2,-2⟩.$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -2 & -1 & 0 \\\\ -4 & 2 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 0 \\\\ 2 & -2\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ -4 & -2\\end{aligned}|j+|\\begin{aligned}-2 & -1 \\\\ -4 & 2\\end{aligned}|k \\\\  & =((-1)\\cdot (-2)-2\\cdot 0)i-((-2)\\cdot (-2)-(-4)\\cdot 0)j+((-2)\\cdot 2-(-4)\\cdot (-1))k \\\\  & =2i-4j-8k \\\\  & =⟨2,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{2}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =2\\sqrt{21}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{21}}{2}=\\sqrt{21}.\n$$"} {:db/id #edb/ref 17592186297464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e27d4c6-c946-503d-ac45-3010dc21b71f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{17}" :db/id #edb/ref 17592186296023}] :answer-field/correct {:answer/id #uuid "8e27d4c6-c946-503d-ac45-3010dc21b71f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{17}" :db/id #edb/ref 17592186296023} :answer-field/id #uuid "6c1cb17d-1226-50b5-8a55-fa9762362774" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296861}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e9963779-43cf-5b65-8821-6ff0b678d8cf" :question/math-academy-id "q-316345" :question/problem "Calculate the area $A$ of the parallelogram spanned by $a=⟨-3,5,0⟩$ and $b=⟨4,-1,2⟩.$\n\n$A=${{field-1}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -3 & 5 & 0 \\\\ 4 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}5 & 0 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}-3 & 0 \\\\ 4 & 2\\end{aligned}|j+|\\begin{aligned}-3 & 5 \\\\ 4 & -1\\end{aligned}|k \\\\  & =(5\\cdot 2-0\\cdot (-1))i-((-3)\\cdot 2-0\\cdot 4)j+((-3)\\cdot (-1)-5\\cdot 4)k \\\\  & =10i+6j-17k \\\\  & =⟨10,6,-17⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{10}^{2}+{6}^{2}+(-17)^{2}} \\\\  & =\\sqrt{100+36+289} \\\\  & =\\sqrt{425} \\\\  & =5\\sqrt{17}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed164a80-8e70-5398-881b-db2dc37213b2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296523}] :answer-field/correct {:answer/id #uuid "ed164a80-8e70-5398-881b-db2dc37213b2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296523} :answer-field/id #uuid "fa7793f2-af09-5083-a758-5dedb4543d5e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297147}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5b9773af-f53a-5ffd-bd89-0fdc3a8398e6" :question/math-academy-id "q-316350" :question/problem "Calculate the area $A$ of the parallelogram spanned by $a=⟨1,0,0⟩$ and $b=⟨0,3,4⟩.$\n\n$A=${{field-1}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 0 \\\\ 0 & 3 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 0 \\\\ 3 & 4\\end{aligned}|i-|\\begin{aligned}1 & 0 \\\\ 0 & 4\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 0 & 3\\end{aligned}|k \\\\  & =(0\\cdot 4-0\\cdot 3)i-(1\\cdot 4-0\\cdot 0)j+(1\\cdot 3-0\\cdot 0)k \\\\  & =0i-4j+3k \\\\  & =⟨0,-4,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,a\\times b\\,| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+{3}^{2}} \\\\  & =\\sqrt{0+16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62f41066-5228-5f44-a4bc-f9a7a9de4308" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{2}" :db/id #edb/ref 17592186295832}] :answer-field/correct {:answer/id #uuid "62f41066-5228-5f44-a4bc-f9a7a9de4308" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{31}{2}" :db/id #edb/ref 17592186295832} :answer-field/id #uuid "809afc0c-e441-5baf-a7b0-01f0a22f4f33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296898}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ed3e1530-1ab9-5085-9128-11a28820fcba" :question/math-academy-id "q-316355" :question/problem "Calculate the area ${A}_{△}$ of the triangle spanned by $p=⟨0,5,-1⟩$ and $q=⟨6,0,1⟩.$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}p\\times q & =|\\begin{aligned}i & j & k \\\\ 0 & 5 & -1 \\\\ 6 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}5 & -1 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}0 & -1 \\\\ 6 & 1\\end{aligned}|j+|\\begin{aligned}0 & 5 \\\\ 6 & 0\\end{aligned}|k \\\\  & =(5\\cdot 1-(-1)\\cdot 0)i-(0\\cdot 1-(-1)\\cdot 6)j+(0\\cdot 0-5\\cdot 6)k \\\\  & =5i-6j-30k \\\\  & =⟨5,-6,-30⟩.\\end{aligned}\n$$\n\nTherefore, the area of the corresponding parallelogram is\n\n$$\n\\begin{aligned}A & =|\\,p\\times q\\,| \\\\  & =\\sqrt{{5}^{2}+(-6)^{2}+(-30)^{2}} \\\\  & =\\sqrt{25+36+900} \\\\  & =\\sqrt{961} \\\\  & =31.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of the triangle is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{31}{2}.\n$$"}] :knowledge-point/title "Calculating the Area of the Triangle Spanned by Two Vectors"}] [{:db/id #edb/ref 17592186105733 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105591 :question/id #uuid "e354c43b-837f-5447-9759-6aeb3952cd57" :question/math-academy-id "e-4345" :question/problem "Calculate the area of the $\\bigtriangleup\\!ABC,$ if $A(1,0,-2),$ $B(-2,0,1),$ $C(1,1,-1).$" :question/worked-solution "First, we find the vectors $\\overrightarrow{AB}$ and $\\overrightarrow{AC}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+k)-(i-2k) \\\\  & =-3i+3k \\\\  & =⟨-3,0,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j-k)-(i-2k) \\\\  & =j+k \\\\  & =⟨0,1,1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =|\\begin{aligned}i & j & k \\\\ -3 & 0 & 3 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 1 & 1\\end{aligned}|i-|\\begin{aligned}-3 & 3 \\\\ 0 & 1\\end{aligned}|j+|\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}|k \\\\  & =(0\\cdot 1-3\\cdot 1)i-(-3\\cdot 1-3\\cdot 0)j+(-3\\cdot 1-0\\cdot 0)k \\\\  & =-3i+3j-3k \\\\  & =⟨-3,3,-3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}+(-3)^{2}} \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $\\bigtriangleup\\!ABC$ is\n\n$$\nA_{\\bigtriangleup} = \\dfrac{1}{2}A = \\dfrac{3\\sqrt{3}}{2}.\n$$"} :knowledge-point/id #uuid "7c30217a-484c-5c31-a2bf-413f04e0edea" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049537 :topic/math-academy-id 175 :topic/title "Addition and Scalar Multiplication of Cartesian Vectors in 3D"}] :knowledge-point/questions [{:db/id #edb/ref 17592186106122 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85a14407-0a6c-560b-8095-289da4451e7c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186102609} {:answer/id #uuid "b2030633-b210-501b-9cf0-3ba099309103" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186102610} {:answer/id #uuid "c0b9134c-bdf1-524b-a131-a0f0eeff5541" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186102611} {:answer/id #uuid "0905aefd-9fae-531d-b65e-a331cd656d3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186102612} {:answer/id #uuid "4a088302-e129-5ad6-bedd-5373b57c8359" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186102613}] :answer-field/id #uuid "74b45571-7029-59a9-a139-4dde30284cc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102608}] :question/id #uuid "b7fa7f1d-963f-5878-b4cb-ed2a7ee6c561" :question/math-academy-id "q-20016" :question/problem "Calculate the area of the $△ABC$, if $A(1, 1, 0)$, $B(3, 2, 2)$, $C(1, 2, 1)$."} {:db/id #edb/ref 17592186106123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e79b7a5-a889-5636-81a6-5c628d9606ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186284912} {:answer/id #uuid "78d9ff09-0da1-5a53-8355-bac5cd8c3dc2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285912} {:answer/id #uuid "a718ab84-4198-545d-bdfa-d0f5048065c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186286310} {:answer/id #uuid "b63ac272-c912-57b7-9e69-82262d25e7e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186286451} {:answer/id #uuid "e47df95b-3077-5100-92fa-f72c23d2e1f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286879}] :answer-field/correct {:answer/id #uuid "0e79b7a5-a889-5636-81a6-5c628d9606ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186284912} :answer-field/id #uuid "3b4dc220-3cdd-52b1-9314-1cc837d05799" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287270}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7799a52e-21d3-584f-93c3-f00bb69321c0" :question/math-academy-id "q-20026" :question/problem "Calculate the area of the $△\\,PQR$, if $P(4,7,3)$, $Q(5,6,2)$, $R(3,8,3).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(5i+6j+2k)-(4i+7j+3k) \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(3i+8j+3k)-(4i+7j+3k) \\\\  & =-i+j \\\\  & =⟨-1,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =|\\begin{aligned}i & j & k \\\\ 1 & -1 & -1 \\\\ -1 & 1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ 1 & 0\\end{aligned}|i-|\\begin{aligned}1 & -1 \\\\ -1 & 0\\end{aligned}|j+|\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}|k \\\\  & =((-1)\\cdot 0-1\\cdot (-1))i-(1\\cdot 0-(-1)\\cdot (-1))j+(1\\cdot 1-(-1)\\cdot (-1))k \\\\  & =i+j \\\\  & =⟨1,1,0⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186262836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "180fef8e-8ea9-590e-9071-b52b4ff39f1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{62}" :db/id #edb/ref 17592186260084} {:answer/id #uuid "26d80b3f-6ec0-5698-94d6-f4acd16ceac0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{31}}{2}" :db/id #edb/ref 17592186260215} {:answer/id #uuid "86077a7b-20d4-5ba1-ac9f-2d5a7c49bd94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{2}}{2}" :db/id #edb/ref 17592186261039} {:answer/id #uuid "8d5c1838-c93e-5dfd-a8b4-ee4f539e435b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{31}" :db/id #edb/ref 17592186261110} {:answer/id #uuid "c792e5c1-7724-54f5-bafa-ba70e9aeab23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{62}}{2}" :db/id #edb/ref 17592186261641}] :answer-field/correct {:answer/id #uuid "c792e5c1-7724-54f5-bafa-ba70e9aeab23" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{62}}{2}" :db/id #edb/ref 17592186261641} :answer-field/id #uuid "6dd7393b-e016-5b2f-a010-b9d7e2bb709b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262303}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f81e690-5559-586b-a65b-10e4fedf8848" :question/math-academy-id "q-127866" :question/problem "Calculate the area of the $△\\,ABC,$ if $A(5,0,5),$ $B(6,-1,4),$ $C(9,1,0).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(6i-j+4k)-(5i+5k) \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(9i+j)-(5i+5k) \\\\  & =4i+j-5k \\\\  & =⟨4,1,-5⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =|\\begin{aligned}i & j & k \\\\ 1 & -1 & -1 \\\\ 4 & 1 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ 1 & -5\\end{aligned}|i-|\\begin{aligned}1 & -1 \\\\ 4 & -5\\end{aligned}|j+|\\begin{aligned}1 & -1 \\\\ 4 & 1\\end{aligned}|k \\\\  & =((-1)\\cdot (-5)-1\\cdot (-1))i-(1\\cdot (-5)-4\\cdot (-1))j+(1\\cdot 1-4\\cdot (-1))k \\\\  & =6i+j+5k \\\\  & =⟨6,1,5⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{6}^{2}+{1}^{2}+{5}^{2}} \\\\  & =\\sqrt{62}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{62}}{2}.\n$$"} {:db/id #edb/ref 17592186262845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e7e2ae-f229-5350-bfe1-691c383da5a1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{21}" :db/id #edb/ref 17592186259879} {:answer/id #uuid "4884595d-d50d-5093-a9bb-f114519d1405" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{17}}{3}" :db/id #edb/ref 17592186260502} {:answer/id #uuid "93fa82e9-537b-5d8c-9b2e-dd7bafe5cff8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186261162} {:answer/id #uuid "c4a6eb21-de86-596c-8e62-5108683c8e7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{21}}{2}" :db/id #edb/ref 17592186261611} {:answer/id #uuid "ed6f234a-fdc5-5088-b8f4-93467b60aada" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id #edb/ref 17592186261960}] :answer-field/correct {:answer/id #uuid "93fa82e9-537b-5d8c-9b2e-dd7bafe5cff8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{21}" :db/id #edb/ref 17592186261162} :answer-field/id #uuid "38599921-2cac-5ba2-a213-10d43c1e348b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262224}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e1c91586-572d-5c90-b62f-69027efa2214" :question/math-academy-id "q-127908" :question/problem "Calculate the area of the $△\\,PQR,$ if $P(2,6,6),$ $Q(4,8,2),$ $R(0,5,6).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(4i+8j+2k)-(2i+6j+6k) \\\\  & =2i+2j-4k \\\\  & =⟨2,2,-4⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(5j+6k)-(2i+6j+6k) \\\\  & =-2i-j \\\\  & =⟨-2,-1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =|\\begin{aligned}i & j & k \\\\ 2 & 2 & -4 \\\\ -2 & -1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -4 \\\\ -1 & 0\\end{aligned}|i-|\\begin{aligned}2 & -4 \\\\ -2 & 0\\end{aligned}|j+|\\begin{aligned}2 & 2 \\\\ -2 & -1\\end{aligned}|k \\\\  & =(2\\cdot 0-(-1)\\cdot (-4))i-(2\\cdot 0-(-2)\\cdot (-4))j+(2\\cdot (-1)-(-2)\\cdot 2)k \\\\  & =-4i+8j+2k \\\\  & =⟨-4,8,2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{(-4)^{2}+{8}^{2}+{2}^{2}} \\\\  & =\\sqrt{84} \\\\  & =2\\sqrt{21}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{21}}{2}=\\sqrt{21}.\n$$"} {:db/id #edb/ref 17592186262848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "622785b6-0e5a-504c-8ba7-61c896b4597d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186260722} {:answer/id #uuid "679872d9-fa42-5cab-a5a3-e29f317c39aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21\\sqrt{2}}{2}" :db/id #edb/ref 17592186260780} {:answer/id #uuid "8c028d49-b914-543f-9314-9b33da7f6f9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{86}}{2}" :db/id #edb/ref 17592186261098} {:answer/id #uuid "c1ddb50b-ce6a-5a57-9ddd-5fad6c4d0a87" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{13}}{2}" :db/id #edb/ref 17592186261586} {:answer/id #uuid "cd0039be-579d-518d-a9d0-03877c66d22e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{43}" :db/id #edb/ref 17592186261681}] :answer-field/correct {:answer/id #uuid "8c028d49-b914-543f-9314-9b33da7f6f9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{86}}{2}" :db/id #edb/ref 17592186261098} :answer-field/id #uuid "8005319e-8e8b-5ab9-a565-7a8f41f83817" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262339}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ef5f09ae-6eb9-5c04-9bb6-e694acc7855a" :question/math-academy-id "q-127913" :question/problem "Calculate the area of the $△\\,PQR,$ if $P(6,1,5),$ $Q(5,1,7),$ $R(4,2,0).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(5i+j+7k)-(6i+j+5k) \\\\  & =-i+2k \\\\  & =⟨-1,0,2⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(4i+2j)-(6i+j+5k) \\\\  & =-2i+j-5k \\\\  & =⟨-2,1,-5⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 2 \\\\ -2 & 1 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 2 \\\\ 1 & -5\\end{aligned}|i-|\\begin{aligned}-1 & 2 \\\\ -2 & -5\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(0\\cdot (-5)-1\\cdot 2)i-((-1)\\cdot (-5)-(-2)\\cdot 2)j+((-1)\\cdot 1-(-2)\\cdot 0)k \\\\  & =-2i-9j-k \\\\  & =⟨-2,-9,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{(-2)^{2}+(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{86}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{86}}{2}.\n$$"} {:db/id #edb/ref 17592186262849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391e4ba1-cf5b-5a61-85aa-0b17144eae39" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260382} {:answer/id #uuid "668cda2c-92ee-5199-b862-983b8a4c4afb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186260768} {:answer/id #uuid "6c2dfdd4-a52e-57e2-9f5e-3ab0a20c414b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186260822} {:answer/id #uuid "6cb8fe9f-e32c-520a-816f-56dd8fde1270" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186260832} {:answer/id #uuid "8671701c-63a1-5620-a70a-e58d9e0297c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186261044}] :answer-field/correct {:answer/id #uuid "668cda2c-92ee-5199-b862-983b8a4c4afb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186260768} :answer-field/id #uuid "8368d079-5a01-5ee1-9848-effbe38c3053" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262345}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1ecbe45d-cebe-5d0b-b79b-4337a04e8ef8" :question/math-academy-id "q-127915" :question/problem "Calculate the area of the $△\\,WXY,$ if $W(3,9,4),$ $X(1,7,3),$ $Y(6,12,8).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{WX}$ and $\\overset{\\to }{WY}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{WX} & =x-w \\\\  & =(i+7j+3k)-(3i+9j+4k) \\\\  & =-2i-2j-k \\\\  & =⟨-2,-2,-1⟩ \\\\ \\overset{\\to }{WY} & =y-w \\\\  & =(6i+12j+8k)-(3i+9j+4k) \\\\  & =3i+3j+4k \\\\  & =⟨3,3,4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{WX}\\times \\overset{\\to }{WY} & =|\\begin{aligned}i & j & k \\\\ -2 & -2 & -1 \\\\ 3 & 3 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & -1 \\\\ 3 & 4\\end{aligned}|i-|\\begin{aligned}-2 & -1 \\\\ 3 & 4\\end{aligned}|j+|\\begin{aligned}-2 & -2 \\\\ 3 & 3\\end{aligned}|k \\\\  & =((-2)\\cdot 4-3\\cdot (-1))i-((-2)\\cdot 4-3\\cdot (-1))j+((-2)\\cdot 3-3\\cdot (-2))k \\\\  & =-5i+5j \\\\  & =⟨-5,5,0⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{WX}$ and $\\overset{\\to }{WY}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{WX}\\times \\overset{\\to }{WY}| \\\\  & =\\sqrt{(-5)^{2}+{5}^{2}+{0}^{2}} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,WXY$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{5\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186287887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1920d715-e444-516d-8fac-793798266f68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186285011} {:answer/id #uuid "29e1177a-6728-5e48-bee7-8dc0e9fdc691" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186285154} {:answer/id #uuid "a7af1a98-7783-53e1-8fd7-c75ee0dc0fa0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186286317} {:answer/id #uuid "af7def2a-51b9-5a38-89f0-dcfcbe125b08" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286387} {:answer/id #uuid "f54aae70-dfb4-5043-9686-2b5185587d3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186287034}] :answer-field/correct {:answer/id #uuid "f54aae70-dfb4-5043-9686-2b5185587d3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186287034} :answer-field/id #uuid "da1704eb-bbb3-5f38-b0f6-6aae59a45a8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287592}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20a90ebb-b81e-5c2a-8135-e658aa05c005" :question/math-academy-id "q-18581" :question/problem "Calculate the area of the $△\\,LMN$, if $L(0,0,1)$, $M(2,1,1)$, $N(3,1,1).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(2i+j+k)-k \\\\  & =2i+j \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(3i+j+k)-k \\\\  & =3i+j \\\\  & =⟨3,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =|\\begin{aligned}i & j & k \\\\ 2 & 1 & 0 \\\\ 3 & 1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 \\\\ 1 & 0\\end{aligned}|i-|\\begin{aligned}2 & 0 \\\\ 3 & 0\\end{aligned}|j+|\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}|k \\\\  & =(1\\cdot 0-0\\cdot 1)i-(2\\cdot 0-0\\cdot 3)j+(2\\cdot 1-1\\cdot 3)k \\\\  & =-k \\\\  & =⟨0,0,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{0}^{2}+{0}^{2}+(-1)^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186287971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d78b70-cb8f-5e6f-99ce-03eb325a6129" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186284818} {:answer/id #uuid "0586a3e6-6eb5-5101-969f-81fc47045d2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186284833} {:answer/id #uuid "57c889db-8102-5c28-aa33-9a91e2b2a89f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285591} {:answer/id #uuid "bcba07e4-2097-5048-b82d-fcda445cced9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286508} {:answer/id #uuid "c3c8ab1c-911c-552c-9f08-414eae7622f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186286582}] :answer-field/correct {:answer/id #uuid "03d78b70-cb8f-5e6f-99ce-03eb325a6129" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186284818} :answer-field/id #uuid "6c509f79-9189-5afb-8b33-24e72c7a6b3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287374}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cee105b4-e3ae-5a95-a3ab-a9f9dc2703a2" :question/math-academy-id "q-20017" :question/problem "Calculate the area of the $△\\,RST$, if $R(3,-2,1)$, $S(2,-2,2)$, $T(1,-3,3).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =s-r \\\\  & =(2i-2j+2k)-(3i-2j+k) \\\\  & =-i+k \\\\  & =⟨-1,0,1⟩ \\\\ \\overset{\\to }{RT} & =t-r \\\\  & =(i-3j+3k)-(3i-2j+k) \\\\  & =-2i-j+2k \\\\  & =⟨-2,-1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{RS}\\times \\overset{\\to }{RT} & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 1 \\\\ -2 & -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}|i-|\\begin{aligned}-1 & 1 \\\\ -2 & 2\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ -2 & -1\\end{aligned}|k \\\\  & =(0\\cdot 2-(-1)\\cdot 1)i-((-1)\\cdot 2-(-2)\\cdot 1)j+((-1)\\cdot (-1)-(-2)\\cdot 0)k \\\\  & =i+k \\\\  & =⟨1,0,1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{RS}$ and $\\overset{\\to }{RT}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{RS}\\times \\overset{\\to }{RT}| \\\\  & =\\sqrt{{1}^{2}+{0}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,RST$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186292815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47d3a2b5-466f-590c-8ea8-479084264b69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{34}}{2}" :db/id #edb/ref 17592186290925}] :answer-field/correct {:answer/id #uuid "47d3a2b5-466f-590c-8ea8-479084264b69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{34}}{2}" :db/id #edb/ref 17592186290925} :answer-field/id #uuid "45ec0f2b-c1b4-5c37-a450-1b90d5f71f78" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291960}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41352b96-198e-5a5d-978c-31702eac06ab" :question/math-academy-id "q-275224" :question/problem "Calculate the area ${A}_{△}$ of the $△\\,ABC$, if $A(-2,0,-1)$, $B(-3,3,-4)$, $C(0,-2,2).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-3i+3j-4k)-(-2i-k) \\\\  & =-i+3j-3k \\\\  & =⟨-1,3,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-2j+2k)-(-2i-k) \\\\  & =2i-2j+3k \\\\  & =⟨2,-2,3⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =|\\begin{aligned}i & j & k \\\\ -1 & 3 & -3 \\\\ 2 & -2 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}3 & -3 \\\\ -2 & 3\\end{aligned}|i-|\\begin{aligned}-1 & -3 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}-1 & 3 \\\\ 2 & -2\\end{aligned}|k \\\\  & =(3\\cdot 3-(-2)\\cdot (-3))i-((-1)\\cdot 3-2\\cdot (-3))j+((-1)\\cdot (-2)-2\\cdot 3)k \\\\  & =3i-3j-4k \\\\  & =⟨3,-3,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{3}^{2}+(-3)^{2}+(-4)^{2}} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{34}}{2}.\n$$"} {:db/id #edb/ref 17592186297467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77b0cc91-ce5c-5046-8f7d-a7344d76cd0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{42}" :db/id #edb/ref 17592186295920}] :answer-field/correct {:answer/id #uuid "77b0cc91-ce5c-5046-8f7d-a7344d76cd0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{42}" :db/id #edb/ref 17592186295920} :answer-field/id #uuid "0ff4772e-9511-5679-8988-c1e0ad78f24a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296670}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2e86dffd-3cdd-51b5-8002-a730ad7bd647" :question/math-academy-id "q-316361" :question/problem "Calculate the area ${A}_{△}$ of the $△\\,PQR$, if $P(1,-2,0)$, $Q(3,1,-1)$, $R(-1,0,2).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(3i+j-k)-(i-2j) \\\\  & =2i+3j-k \\\\  & =⟨2,3,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(-i+2k)-(i-2j) \\\\  & =-2i+2j+2k \\\\  & =⟨-2,2,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =|\\begin{aligned}i & j & k \\\\ 2 & 3 & -1 \\\\ -2 & 2 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}3 & -1 \\\\ 2 & 2\\end{aligned}|i-|\\begin{aligned}2 & -1 \\\\ -2 & 2\\end{aligned}|j+|\\begin{aligned}2 & 3 \\\\ -2 & 2\\end{aligned}|k \\\\  & =(3\\cdot 2-(-1)\\cdot 2)i-(2\\cdot 2-(-1)\\cdot (-2))j+(2\\cdot 2-3\\cdot (-2))k \\\\  & =8i-2j+10k \\\\  & =⟨8,-2,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{8}^{2}+(-2)^{2}+{10}^{2}} \\\\  & =\\sqrt{64+4+100} \\\\  & =\\sqrt{168} \\\\  & =2\\sqrt{42}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{42}}{2}=\\sqrt{42}.\n$$"} {:db/id #edb/ref 17592186297468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dba9f272-6930-502c-8925-212ed902a7be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{237}}{2}" :db/id #edb/ref 17592186296427}] :answer-field/correct {:answer/id #uuid "dba9f272-6930-502c-8925-212ed902a7be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{237}}{2}" :db/id #edb/ref 17592186296427} :answer-field/id #uuid "7d733894-4032-579e-a650-81c38b682309" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296890}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a38f6d6d-8117-5b90-a022-c6e9c7160729" :question/math-academy-id "q-316362" :question/problem "Calculate the area ${A}_{△}$ of the $△\\,DEF$, if $D(-2,1,3)$, $E(0,-1,0)$, $F(2,2,-1).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =(-j)-(-2i+j+3k) \\\\  & =2i-2j-3k \\\\  & =⟨2,-2,-3⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =(2i+2j-k)-(-2i+j+3k) \\\\  & =4i+j-4k \\\\  & =⟨4,1,-4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =|\\begin{aligned}i & j & k \\\\ 2 & -2 & -3 \\\\ 4 & 1 & -4\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & -3 \\\\ 1 & -4\\end{aligned}|i-|\\begin{aligned}2 & -3 \\\\ 4 & -4\\end{aligned}|j+|\\begin{aligned}2 & -2 \\\\ 4 & 1\\end{aligned}|k \\\\  & =((-2)\\cdot (-4)-(-3)\\cdot 1)i-(2\\cdot (-4)-(-3)\\cdot 4)j+(2\\cdot 1-(-2)\\cdot 4)k \\\\  & =11i-4j+10k \\\\  & =⟨11,-4,10⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{{11}^{2}+(-4)^{2}+{10}^{2}} \\\\  & =\\sqrt{121+16+100} \\\\  & =\\sqrt{237}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{237}}{2}.\n$$"} {:db/id #edb/ref 17592186297469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ce5de2-b8be-5dc3-beaf-15c0bca7c3b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{2}}{2}" :db/id #edb/ref 17592186295588}] :answer-field/correct {:answer/id #uuid "38ce5de2-b8be-5dc3-beaf-15c0bca7c3b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13\\sqrt{2}}{2}" :db/id #edb/ref 17592186295588} :answer-field/id #uuid "940eef9e-f927-5a3a-861d-74d1ef0554a6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296940}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "66634719-8e4b-59db-b970-ace87e066b21" :question/math-academy-id "q-316363" :question/problem "Calculate the area ${A}_{△}$ of the $△\\,LMN$, if $L(-3,0,1)$, $M(0,2,-2)$, $N(2,-1,0).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(2j-2k)-(-3i+k) \\\\  & =3i+2j-3k \\\\  & =⟨3,2,-3⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(2i-j)-(-3i+k) \\\\  & =5i-j-k \\\\  & =⟨5,-1,-1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =|\\begin{aligned}i & j & k \\\\ 3 & 2 & -3 \\\\ 5 & -1 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -3 \\\\ -1 & -1\\end{aligned}|i-|\\begin{aligned}3 & -3 \\\\ 5 & -1\\end{aligned}|j+|\\begin{aligned}3 & 2 \\\\ 5 & -1\\end{aligned}|k \\\\  & =(2\\cdot (-1)-(-3)\\cdot (-1))i-(3\\cdot (-1)-(-3)\\cdot 5)j+(3\\cdot (-1)-2\\cdot 5)k \\\\  & =-5i-12j-13k \\\\  & =⟨-5,-12,-13⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{(-5)^{2}+(-12)^{2}+(-13)^{2}} \\\\  & =\\sqrt{25+144+169} \\\\  & =\\sqrt{338} \\\\  & =13\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{13\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186297486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "970f719c-7b09-55f2-929e-43449f0a9042" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{2}" :db/id #edb/ref 17592186296074}] :answer-field/correct {:answer/id #uuid "970f719c-7b09-55f2-929e-43449f0a9042" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{2}" :db/id #edb/ref 17592186296074} :answer-field/id #uuid "97996f38-e573-5502-9f72-9a2d0b28eaf9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296953}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1c80aa6a-7a46-5942-80d2-93913627438b" :question/math-academy-id "q-316514" :question/problem "Calculate the area ${A}_{△}$ of the $△\\,DEF$, if $D(-1,2,0)$, $E(2,0,1)$, $F(1,3,2).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =(2i+k)-(-i+2j) \\\\  & =3i-2j+k \\\\  & =⟨3,-2,1⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =(i+3j+2k)-(-i+2j) \\\\  & =2i+j+2k \\\\  & =⟨2,1,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\times \\overset{\\to }{DF} & =|\\begin{aligned}i & j & k \\\\ 3 & -2 & 1 \\\\ 2 & 1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 1 \\\\ 1 & 2\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ 2 & 2\\end{aligned}|j+|\\begin{aligned}3 & -2 \\\\ 2 & 1\\end{aligned}|k \\\\  & =((-2)\\cdot 2-1\\cdot 1)i-(3\\cdot 2-2\\cdot 1)j+(3\\cdot 1-(-2)\\cdot 2)k \\\\  & =-5i-4j+7k \\\\  & =⟨-5,-4,7⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{DE}\\times \\overset{\\to }{DF}| \\\\  & =\\sqrt{(-5)^{2}+(-4)^{2}+{7}^{2}} \\\\  & =\\sqrt{90} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DEF$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{10}}{2}.\n$$"} {:db/id #edb/ref 17592186297487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fe7bd94-f1f1-5968-8699-68e5eff1beb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{146}}{2}" :db/id #edb/ref 17592186295726}] :answer-field/correct {:answer/id #uuid "4fe7bd94-f1f1-5968-8699-68e5eff1beb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{146}}{2}" :db/id #edb/ref 17592186295726} :answer-field/id #uuid "f58dd836-40be-566d-a116-79d128a9ed1d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297135}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "af1c1af8-7ccd-5f01-9374-729457ea6109" :question/math-academy-id "q-316516" :question/problem "Calculate the area ${A}_{△}$ of the $△\\,LMN$, if $L(1,0,-1)$, $M(3,2,0)$, $N(0,1,3).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{LM} & =m-l \\\\  & =(3i+2j)-(i-k) \\\\  & =2i+2j+k \\\\  & =⟨2,2,1⟩ \\\\ \\overset{\\to }{LN} & =n-l \\\\  & =(j+3k)-(i-k) \\\\  & =-i+j+4k \\\\  & =⟨-1,1,4⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{LM}\\times \\overset{\\to }{LN} & =|\\begin{aligned}i & j & k \\\\ 2 & 2 & 1 \\\\ -1 & 1 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 \\\\ 1 & 4\\end{aligned}|i-|\\begin{aligned}2 & 1 \\\\ -1 & 4\\end{aligned}|j+|\\begin{aligned}2 & 2 \\\\ -1 & 1\\end{aligned}|k \\\\  & =(2\\cdot 4-1\\cdot 1)i-(2\\cdot 4-(-1)\\cdot 1)j+(2\\cdot 1-2\\cdot (-1))k \\\\  & =7i-9j+4k \\\\  & =⟨7,-9,4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{LM}$ and $\\overset{\\to }{LN}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{LM}\\times \\overset{\\to }{LN}| \\\\  & =\\sqrt{{7}^{2}+(-9)^{2}+{4}^{2}} \\\\  & =\\sqrt{146}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,LMN$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{146}}{2}.\n$$"} {:db/id #edb/ref 17592186297489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e247391e-4dbd-55f5-93b1-53a444f611d0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186296472}] :answer-field/correct {:answer/id #uuid "e247391e-4dbd-55f5-93b1-53a444f611d0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186296472} :answer-field/id #uuid "3c517877-5eaa-568b-a6c7-60cea011507e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296751}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cf87a92d-df17-5548-a069-1e61f18f426a" :question/math-academy-id "q-316530" :question/problem "Calculate the area of the $△\\,STU,$ if $S(0,1,2),$ $T(2,3,1),$ $U(4,1,2).$\n\n${A}_{△}=${{field-1}}" :question/worked-solution "First, we find the vectors $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{ST} & =t-s \\\\  & =(2i+3j+k)-(j+2k) \\\\  & =2i+2j-k \\\\  & =⟨2,2,-1⟩ \\\\ \\overset{\\to }{SU} & =u-s \\\\  & =(4i+j+2k)-(j+2k) \\\\  & =4i+0j+0k \\\\  & =⟨4,0,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{ST}\\times \\overset{\\to }{SU} & =|\\begin{aligned}i & j & k \\\\ 2 & 2 & -1 \\\\ 4 & 0 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & -1 \\\\ 0 & 0\\end{aligned}|i-|\\begin{aligned}2 & -1 \\\\ 4 & 0\\end{aligned}|j+|\\begin{aligned}2 & 2 \\\\ 4 & 0\\end{aligned}|k \\\\  & =(2\\cdot 0-(-1)\\cdot 0)i-(2\\cdot 0-(-1)\\cdot 4)j+(2\\cdot 0-2\\cdot 4)k \\\\  & =0i-4j-8k \\\\  & =⟨0,-4,-8⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{ST}$ and $\\overset{\\to }{SU}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{ST}\\times \\overset{\\to }{SU}| \\\\  & =\\sqrt{{0}^{2}+(-4)^{2}+(-8)^{2}} \\\\  & =\\sqrt{16+64} \\\\  & =\\sqrt{80} \\\\  & =4\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,STU$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{5}}{2}=2\\sqrt{5}.\n$$"} {:db/id #edb/ref 17592186338894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d7ae9-a232-5e60-a939-66c340b257d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186336190} {:answer/id #uuid "4cd5eccf-eb1f-5b09-992c-5886e6477e5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{261}}{2}" :db/id #edb/ref 17592186336746} {:answer/id #uuid "990c829b-454f-5fa4-985e-5a8b68b776dc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186337424} {:answer/id #uuid "9f98312c-c9f2-57e2-af6f-1c2737cbfe55" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{261}" :db/id #edb/ref 17592186337475} {:answer/id #uuid "e64d8662-a67b-5f89-82e8-43f6670bbf96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{97}}{2}" :db/id #edb/ref 17592186338040}] :answer-field/correct {:answer/id #uuid "4cd5eccf-eb1f-5b09-992c-5886e6477e5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{261}}{2}" :db/id #edb/ref 17592186336746} :answer-field/id #uuid "5cc2c532-03ad-50fc-87d1-ea179d58d664" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338436}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "874ee269-4d1d-55a1-8553-04a0864d5dd5" :question/math-academy-id "q-71106" :question/problem "Calculate the area of the $△\\,WXY$, if $W(2,-3,1)$, $X(-2,1,2)$, $Y(3,-1,3).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{WX}$ and $\\overset{\\to }{WY}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{WX} & =x-w \\\\  & =(-2i+j+2k)-(2i-3j+k) \\\\  & =-4i+4j+k \\\\  & =⟨-4,4,1⟩ \\\\ \\overset{\\to }{WY} & =y-w \\\\  & =(3i-j+3k)-(2i-3j+k) \\\\  & =i+2j+2k \\\\  & =⟨1,2,2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{WX}\\times \\overset{\\to }{WY} & =|\\begin{aligned}i & j & k \\\\ -4 & 4 & 1 \\\\ 1 & 2 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}4 & 1 \\\\ 2 & 2\\end{aligned}|i-|\\begin{aligned}-4 & 1 \\\\ 1 & 2\\end{aligned}|j+|\\begin{aligned}-4 & 4 \\\\ 1 & 2\\end{aligned}|k \\\\  & =(4\\cdot 2-1\\cdot 2)i-((-4)\\cdot 2-1\\cdot 1)j+((-4)\\cdot 2-1\\cdot 4)k \\\\  & =6i+9j-12k \\\\  & =⟨6,9,-12⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{WX}$ and $\\overset{\\to }{WY}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{WX}\\times \\overset{\\to }{WY}| \\\\  & =\\sqrt{{6}^{2}+{9}^{2}+{12}^{2}} \\\\  & =\\sqrt{261}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,WXY$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{261}}{2}.\n$$"} {:db/id #edb/ref 17592186338895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0932fe92-f8de-576e-baff-260c08cc1de7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186336112} {:answer/id #uuid "7efd8fb5-fe32-562c-9d4b-d5fba1fd6b48" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337184} {:answer/id #uuid "8ef6d298-4c28-5ba4-8962-81bdffb4b6ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186337321} {:answer/id #uuid "eb23c031-3731-5c6e-aed8-4d36c5b9f20c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186338081} {:answer/id #uuid "fc78233b-b5f1-5862-b741-cfd6e52f48e7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338250}] :answer-field/correct {:answer/id #uuid "eb23c031-3731-5c6e-aed8-4d36c5b9f20c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186338081} :answer-field/id #uuid "0daa5bc7-b875-5ff1-9f3e-508ca3073b43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338302}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0d10b6fa-62e6-5893-8115-0db23250352f" :question/math-academy-id "q-71107" :question/problem "Calculate the area of the $△\\,NPQ$, if $N(1,0,1)$, $P(2,2,3)$, $Q(2,1,1).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{NP}$ and $\\overset{\\to }{NQ}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{NP} & =p-n \\\\  & =(2i+2j+3k)-(i+k) \\\\  & =i+2j+2k \\\\  & =⟨1,2,2⟩ \\\\ \\overset{\\to }{NQ} & =q-n \\\\  & =(2i+j+k)-(i+k) \\\\  & =i+j \\\\  & =⟨1,1,0⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{NP}\\times \\overset{\\to }{NQ} & =|\\begin{aligned}i & j & k \\\\ 1 & 2 & 2 \\\\ 1 & 1 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 2 \\\\ 1 & 0\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}|j+|\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}|k \\\\  & =(2\\cdot 0-1\\cdot 2)i-(1\\cdot 0-1\\cdot 2)j+(1\\cdot 1-1\\cdot 2)k \\\\  & =-2i+2j-k \\\\  & =⟨-2,2,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{NP}$ and $\\overset{\\to }{NQ}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{NP}\\times \\overset{\\to }{NQ}| \\\\  & =\\sqrt{(-2)^{2}+{2}^{2}+(-1)^{2}} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,NPQ$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3}{2}.\n$$"} {:db/id #edb/ref 17592186338896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aed134b-e703-50a2-978e-28071145ddef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186336586} {:answer/id #uuid "4cfc4a3f-63ff-5d1a-9c0f-ebcdda99431e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186336748} {:answer/id #uuid "7047a495-50ca-567e-88e4-273aa8914f6d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186337028} {:answer/id #uuid "bc4ffce1-6601-5f91-8b10-271b848d8b34" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186337703} {:answer/id #uuid "ca325988-d63a-57fe-a35a-615af188b50b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186337813}] :answer-field/correct {:answer/id #uuid "4cfc4a3f-63ff-5d1a-9c0f-ebcdda99431e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186336748} :answer-field/id #uuid "40c086ce-f13d-57ca-a69b-b4e1945642fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338395}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d25fe3fb-23c6-5ca6-a0b3-475c85a18297" :question/math-academy-id "q-71109" :question/problem "Calculate the area of the $△\\,FGH$, if $F(1,1,2)$, $G(2,2,3)$, $H(1,0,1).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{FG}$ and $\\overset{\\to }{FH}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{FG} & =g-f \\\\  & =(2i+2j+3k)-(i+j+2k) \\\\  & =i+j+k \\\\  & =⟨1,1,1⟩ \\\\ \\overset{\\to }{FH} & =h-f \\\\  & =(i+k)-(i+j+2k) \\\\  & =-j-k \\\\  & =⟨0,-1,-1⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{FG}\\times \\overset{\\to }{FH} & =|\\begin{aligned}i & j & k \\\\ 1 & 1 & 1 \\\\ 0 & -1 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}|i-|\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}|j+|\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}|k \\\\  & =(1\\cdot (-1)-(-1)\\cdot 1)i-(1\\cdot (-1)-0\\cdot 1)j+(1\\cdot (-1)-0\\cdot 1)k \\\\  & =j-k \\\\  & =⟨0,1,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{FG}$ and $\\overset{\\to }{FH}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{FG}\\times \\overset{\\to }{FH}| \\\\  & =\\sqrt{{0}^{2}+{1}^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,FGH$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186338898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47e924de-54b8-5328-8007-3b54077fff81" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336697} {:answer/id #uuid "55f44d06-e6f6-5fe2-85b3-f7a48edceca8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186336822} {:answer/id #uuid "d8658307-2241-5976-8f8b-323e902dd088" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337910} {:answer/id #uuid "fc896c2a-9e50-5f5d-a2dd-8fde07578b47" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338251} {:answer/id #uuid "fcf6bcc4-3401-51e2-8ab5-cc86c889fcc4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186338258}] :answer-field/correct {:answer/id #uuid "47e924de-54b8-5328-8007-3b54077fff81" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336697} :answer-field/id #uuid "8d4de416-4232-5a36-bef2-7154753e04a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338537}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7c8d8ac3-0a22-56d4-bfd2-5a54455f0999" :question/math-academy-id "q-71111" :question/problem "Calculate the area of the $△\\,CDE$, if $C(1,-2,3)$, $D(1,-3,3)$, $E(1,1,1).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{CD}$ and $\\overset{\\to }{CE}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =d-c \\\\  & =(i-3j+3k)-(i-2j+3k) \\\\  & =-j \\\\  & =⟨0,-1,0⟩ \\\\ \\overset{\\to }{CE} & =e-c \\\\  & =(i+j+k)-(i-2j+3k) \\\\  & =3j-2k \\\\  & =⟨0,3,-2⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{CD}\\times \\overset{\\to }{CE} & =|\\begin{aligned}i & j & k \\\\ 0 & -1 & 0 \\\\ 0 & 3 & -2\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 0 \\\\ 3 & -2\\end{aligned}|i-|\\begin{aligned}0 & 0 \\\\ 0 & -2\\end{aligned}|j+|\\begin{aligned}0 & -1 \\\\ 0 & 3\\end{aligned}|k \\\\  & =((-1)\\cdot (-2)-3\\cdot 0)i-(0\\cdot (-2)-0\\cdot 0)j+(0\\cdot 3-0\\cdot (-1))k \\\\  & =2i \\\\  & =⟨2,0,0⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{CD}$ and $\\overset{\\to }{CE}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{CD}\\times \\overset{\\to }{CE}| \\\\  & =\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,CDE$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=1.\n$$"}] :knowledge-point/title "Calculating the Area of a Triangle Given Its Vertices"}]}
