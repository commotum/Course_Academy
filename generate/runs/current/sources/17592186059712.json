        },
        ":question/id": "c7102fb2-1b14-588a-bd41-c065850a33f5",
        ":question/math-academy-id": "q-70412",
        ":question/problem": "Let $a=[\\begin{aligned}4 \\\\ -7\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 4\\end{aligned}]$ and $c=[\\begin{aligned}4 \\\\ -6\\end{aligned}].$ Find $3a-(b+4c).$",
        ":question/worked-solution": "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}3a-(b+4c) & =3\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+4\\cdot [\\begin{aligned}4 \\\\ -6\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-([\\begin{aligned}2 \\\\ 4\\end{aligned}]+[\\begin{aligned}16 \\\\ -24\\end{aligned}]) \\\\  & =[\\begin{aligned}12 \\\\ -21\\end{aligned}]-[\\begin{aligned}18 \\\\ -20\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"
      },
      {
        ":db/id": 17592186234273,
        ":question/difficulty": {
          ":db/ident": ":question.difficulty/moderate"
        },
        ":question/id": "aad6285a-b3b6-504e-bdb1-d51f41010e44",
        ":question/math-academy-id": "q-70414",
        ":question/problem": "Let $a=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$, $b=[\\begin{aligned}2 \\\\ 5\\end{aligned}]$ and $c=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Find $a+(2b-2c).$",
        ":question/worked-solution": "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a+(2b-2c) & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+(2\\cdot [\\begin{aligned}2 \\\\ 5\\end{aligned}]-2\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+([\\begin{aligned}4 \\\\ 10\\end{aligned}]-[\\begin{aligned}2 \\\\ 4\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 7\\end{aligned}]\\end{aligned}\n$$"
      }
