iculty/easy} :question/id #uuid "a09e33e6-12c2-544c-8fa4-02ef6f3be0de" :question/math-academy-id "q-308849" :question/problem "Given that $y=8ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8ln⁡x) \\\\  & =8\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =8\\cdot \\frac{1}{x} \\\\  & =\\frac{8}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ee19c8-ffa3-51c2-90c8-f32e76bf3ba8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4x}" :db/id #edb/ref 17592186312005} {:answer/id #uuid "04e1e1ed-ae8d-46b8-ab8d-1085b1802387" :answer/type {:db/ident :answer.type/math} :answer/value "11/(4x)" :db/id #edb/ref 17592186409335}] :answer-field/correct {:answer/id #uuid "04ee19c8-ffa3-51c2-90c8-f32e76bf3ba8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4x}" :db/id #edb/ref 17592186312005} :answer-field/id #uuid "e6760650-0666-56ec-a209-471cd8d6b267" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314644}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dffc415e-0ffd-5f91-84e8-ab042b2a6f3c" :question/math-academy-id "q-339949" :question/problem "Given that $y=\\frac{11}{4}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}ln⁡x) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{x} \\\\  & =\\frac{11}{4x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77574496-a3d5-5133-b54d-5a41edeef925" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{3x}" :db/id #edb/ref 17592186312931} {:answer/id #uuid "8d49850c-09b0-4746-acd2-5bace5c80ed5" :answer/type {:db/ident :answer.type/math} :answer/value "-7/(3x)" :db/id #edb/ref 17592186409336}] :answer-field/correct {:answer/id #uuid "77574496-a3d5-5133-b54d-5a41edeef925" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{3x}" :db/id #edb/ref 17592186312931} :answer-field/id #uuid "2d5f9fb9-2594-5780-812f-98f59dc7cafe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314132}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eeedc903-d84c-5e00-bc96-dcee7bf9bc01" :question/math-academy-id "q-339950" :question/problem "Given that $y=-\\frac{7}{3}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{7}{3}ln⁡x) \\\\  & =-\\frac{7}{3}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =-\\frac{7}{3}\\cdot \\frac{1}{x} \\\\  & =-\\frac{7}{3x}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"}] [{:db/id #edb/ref 17592186096614 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096414 :question/id #uuid "58d47fb0-cf75-58c4-8eea-f3ae97333159" :question/math-academy-id "e-3628" :question/problem "Given that $f(x)=2\\ln x+x^2-1$, find $f'(x).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\eqalign{\n\t\t\tf'(x) &= \\left(2\\ln x+x^2-1\\right)'\\\n\t\t\t&=2 \\cdot \\dfrac{1}{x}+2x-0\\\n\t\t\t&=\\dfrac{2}{x}+2x.\n\n}\n$$"} :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/questions [{:db/id #edb/ref 17592186097156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1045aaaf-0a76-5469-afdc-876ec049ae29" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}-ln⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186284929} {:answer/id #uuid "aa30aba2-91df-575b-9e42-a1c8a2d47cbf" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}ln⁡x-\\frac{1}{x}" :db/id #edb/ref 17592186286338} {:answer/id #uuid "c13aff45-c853-5d8b-ae11-7b4d6befdcb6" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡11+\\frac{5}{x}" :db/id #edb/ref 17592186286556} {:answer/id #uuid "eff2509a-f3c8-5644-a073-b8761ffb95e6" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}ln⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186286990} {:answer/id #uuid "ff507140-fe41-5deb-989d-ac21680f83b3" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}-\\frac{1}{x}" :db/id #edb/ref 17592186287129}] :answer-field/correct {:answer/id #uuid "eff2509a-f3c8-5644-a073-b8761ffb95e6" :answer/type {:db/ident :answer.type/math} :answer/value "{11}^{x}ln⁡11-\\frac{5}{x}" :db/id #edb/ref 17592186286990} :answer-field/id #uuid "38feddcb-991e-5fb6-9fb0-47bd31940554" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287264}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1cb4423b-343c-5035-85a6-f38acaa8835d" :question/math-academy-id "q-1919" :question/problem "Find ${f}^{′}(x)$ for $f(x)={11}^{x}-5ln⁡x.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({11}^{x}-5ln⁡x) \\\\  & ={11}^{x}\\cdot ln⁡11-5(\\frac{1}{x}) \\\\  & ={11}^{x}ln⁡11-\\frac{5}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186097157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8847ec53-1ef1-5244-9261-3db213a50ea2" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x}\\ln x + \\frac{1}{x}" :db/id #edb/ref 17592186094916} {:answer/id #uuid "af4a5664-c507-5fd9-af8c-e68ce9129a6b" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x}\\ln - 5 + \\frac{2}{x}" :db/id #edb/ref 17592186094917} {:answer/id #uuid "d160ad97-ce05-5c09-a415-37e669bc37d0" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{x} + \\frac{1}{x}" :db/id #edb/ref 17592186094918} {:answer/id #uuid "f0f5dc19-0891-5c65-ba47-3963e6e0a451" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x} - \\ln 3 + \\frac{2}{x}" :db/id #edb/ref 17592186094919} {:answer/id #uuid "fdb7af8c-26aa-56d2-9b2c-2028d177a3e0" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{x} + \\frac{2}{x}" :db/id #edb/ref 17592186094920}] :answer-field/id #uuid "e0978740-9d55-5364-bce6-ab2f65f0ed46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094915}] :question/id #uuid "e09c4141-d749-574e-b1a3-1f49f5b7e3d8" :question/math-academy-id "q-1920" :question/problem "Calculate $\\frac{dy}{dx}$ for $y =-5e^{x} + 2\\ln x$."} {:db/id #edb/ref 17592186233262 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The negative coefficient remains negative: d[-3x^2]/dx = -6x." :answer/id #uuid "3b2b9b31-ff69-5fd5-b05e-2f7659ff135f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}+6x+2" :db/id #edb/ref 17592186408180} {:answer/feedback "Differentiate term by term: d[5 ln(x)]/dx = 5/x, d[-3x^2]/dx = -6x, and d[2x]/dx = 2." :answer/id #uuid "0d5c95ed-e8ad-537b-a8d6-7a28ab66e027" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-6x+2" :db/id #edb/ref 17592186408181} {:answer/feedback "The coefficient 5 multiplies the derivative of ln(x): d[5 ln(x)]/dx = 5/x, not 1/x." :answer/id #uuid "91dae272-a571-532b-b8c9-5f1a0d446765" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-6x+2" :db/id #edb/ref 17592186408182} {:answer/feedback "Differentiate the quadratic term as well: d[-3x^2]/dx = -6x; the original -3x^2 term cannot remain in the derivative." :answer/id #uuid "3b96cf13-3041-512c-817b-bce2b6cd16ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-3x^{2}+2" :db/id #edb/ref 17592186408183} {:answer/feedback "The power rule gives d[-3x^2]/dx = -3(2x) = -6x. Include the factor 2 from the exponent." :answer/id #uuid "441d1cc7-ac98-5400-9e91-3512f2bc8afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-3x+2" :db/id #edb/ref 17592186408184}] :answer-field/correct {:answer/feedback "Differentiate term by term: d[5 ln(x)]/dx = 5/x, d[-3x^2]/dx = -6x, and d[2x]/dx = 2." :answer/id #uuid "0d5c95ed-e8ad-537b-a8d6-7a28ab66e027" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{x}-6x+2" :db/id #edb/ref 17592186408181} :answer-field/id #uuid "11eacdbf-0599-50c9-89ae-2687d890483f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408185}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0a394889-e060-5e16-b9db-b5d3312e9a55" :question/math-academy-id "q-11914" :question/problem "Given that $y=5\\operatorname{ln}x-3{x}^{2}+2x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}x-3{x}^{2}+2x) \\\\  & =5(\\frac{1}{x})-3\\cdot 2x+2 \\\\  & =\\frac{5}{x}-6x+2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74933759-75c5-532d-af31-afd3380ef04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi {x}^{\\pi -1}" :db/id #edb/ref 17592186232808}] :answer-field/correct {:answer/id #uuid "74933759-75c5-532d-af31-afd3380ef04d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+\\pi {x}^{\\pi -1}" :db/id #edb/ref 17592186232808} :answer-field/id #uuid "68d840e4-5315-5b1c-ac1b-5463bf99806d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232807}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ef040da7-239c-5fb0-8704-10d30763e312" :question/math-academy-id "q-339973" :question/problem "Given that $y=2\\operatorname{ln}x+{x}^{\\pi }+1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}x+{x}^{\\pi }+1) \\\\  & =2(\\frac{1}{x})+\\pi {x}^{\\pi -1} \\\\  & =\\frac{2}{x}+\\pi {x}^{\\pi -1}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0384a71b-bf28-515f-8b2b-476abb5fca12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-10+7{x}^{2}" :db/id #edb/ref 17592186235817} {:answer/id #uuid "4e8c24ce-0ee5-5eba-b662-bb6dcb3d78e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186236321} {:answer/id #uuid "5659c514-e496-58f4-9efc-5892bb18fbec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186236366} {:answer/id #uuid "682d240f-295a-54b0-8f99-5ef92b911aaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}+10+21{x}^{3}" :db/id #edb/ref 17592186236477} {:answer/id #uuid "fee011ed-5418-5bfa-a0ce-9610f711b134" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{x}+10+21{x}^{2}" :db/id #edb/ref 17592186237440}] :answer-field/correct {:answer/id #uuid "5659c514-e496-58f4-9efc-5892bb18fbec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}-10+21{x}^{2}" :db/id #edb/ref 17592186236366} :answer-field/id #uuid "23a9552c-cb8c-5d34-a069-fe4c1cccbba6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237483}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2ed4b1bb-20cc-53c5-859e-2495715a907d" :question/math-academy-id "q-101716" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=2\\operatorname{ln}⁡x-10x+7{x}^{3}-1.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x-10x+7{x}^{3}-1) \\\\  & =2(\\frac{1}{x})-10+21{x}^{2} \\\\  & =\\frac{2}{x}-10+21{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bf5cf8-eaf1-5b10-8d2a-662c31b3b508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186250885} {:answer/id #uuid "783b0f4c-199c-5928-b08e-dcb4df838be4" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{2}{x}" :db/id #edb/ref 17592186251549} {:answer/id #uuid "89f1e417-01f6-5b82-ba77-84fd142edcc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186251714} {:answer/id #uuid "e0afa8a6-a60b-5d30-b8a6-b2c64b3b9e85" :answer/type {:db/ident :answer.type/math} :answer/value "2x+\\frac{1}{x}" :db/id #edb/ref 17592186252532} {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782}] :answer-field/correct {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782} :answer-field/id #uuid "ef06db64-440f-52c2-ab98-0824b44d15d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253222}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2a7a5557-d240-5298-a285-f0853a897b06" :question/math-academy-id "q-11911" :question/problem "Given that $y=2x+ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+ln⁡x) \\\\  & =2+\\frac{1}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cae6982-03b7-597e-93e4-369fa68c8f5f" :answer/type {:db/ident :answer.type/math} :answer/value "3e+1" :db/id #edb/ref 17592186296102}] :answer-field/correct {:answer/id #uuid "9cae6982-03b7-597e-93e4-369fa68c8f5f" :answer/type {:db/ident :answer.type/math} :answer/value "3e+1" :db/id #edb/ref 17592186296102} :answer-field/id #uuid "e26d719b-6dbc-535a-8df8-4e273868c85f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297102}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "395be2fc-ff05-5c2f-8d61-c5ab0d5aca86" :question/math-academy-id "q-308854" :question/problem "Given the function  $y=3{x}^{e}+ln⁡x,$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{e}+ln⁡x) \\\\  & =3e{x}^{e-1}+\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(3e{x}^{e-1}+\\frac{1}{x})|}_{x=1} \\\\  & =3e\\cdot {1}^{e-1}+\\frac{1}{1} \\\\  & =3e+1\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596bfc33-1d46-58a1-9057-d28b147c68d1" :answer/type {:db/ident :answer.type/math} :answer/value "2+e" :db/id #edb/ref 17592186312691}] :answer-field/correct {:answer/id #uuid "596bfc33-1d46-58a1-9057-d28b147c68d1" :answer/type {:db/ident :answer.type/math} :answer/value "2+e" :db/id #edb/ref 17592186312691} :answer-field/id #uuid "ac34aef1-8e01-5f48-b043-096d0f12b55a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314475}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ff04e1e3-e896-53d9-a3c6-32e3bf7042a0" :question/math-academy-id "q-340099" :question/problem "Given the function  $y=2\\operatorname{ln}⁡x+{e}^{x}$, find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{ln}⁡x+{e}^{x}) \\\\  & =\\frac{2}{x}+{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{2}{x}+{e}^{x})|}_{x=1} \\\\  & =\\frac{2}{1}+{e}^{1} \\\\  & =2+e\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "566f2bfd-9b10-5889-ad0c-475cdee4aa4a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}+2{e}^{2}" :db/id #edb/ref 17592186312672}] :answer-field/correct {:answer/id #uuid "566f2bfd-9b10-5889-ad0c-475cdee4aa4a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}+2{e}^{2}" :db/id #edb/ref 17592186312672} :answer-field/id #uuid "675f05c9-21d9-5557-bbbf-524e71c7eea0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314301}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4272d4a8-55fd-5380-aaa8-0f20266b3bc5" :question/math-academy-id "q-340100" :question/problem "Given the function  $y=-3\\operatorname{ln}⁡x+2{e}^{x}+4$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+2{e}^{x}+4) \\\\  & =-\\frac{3}{x}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(-\\frac{3}{x}+2{e}^{x})|}_{x=2} \\\\  & =-\\frac{3}{2}+2{e}^{2}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39500646-122f-5de4-a3f8-1b1dfa91aa61" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{4}{3}\\operatorname{ln}(2)" :db/id #edb/ref 17592186312439}] :answer-field/correct {:answer/id #uuid "39500646-122f-5de4-a3f8-1b1dfa91aa61" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{4}{3}\\operatorname{ln}(2)" :db/id #edb/ref 17592186312439} :answer-field/id #uuid "c1560d5a-5716-563a-970a-84ea931d3b0b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314550}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "905686ba-b3f6-58e7-998d-63ec7c2c2866" :question/math-academy-id "q-340104" :question/problem "Given the function  $y=4ln⁡x-\\frac{1}{3}\\cdot {2}^{x}+5$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4ln⁡x-\\frac{1}{3}\\cdot {2}^{x}+5) \\\\  & =\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}ln⁡(2).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}ln⁡(2))|}_{x=2} \\\\  & =\\frac{4}{2}-\\frac{1}{3}\\cdot {2}^{2}ln⁡(2) \\\\  & =2-\\frac{4}{3}ln⁡(2)\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0beb1ecb-7649-51d5-8923-8085f1d146bc" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186401629} {:answer/id #uuid "aa5ec049-b8d0-5c17-a28c-05813122674f" :answer/type {:db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186401630} {:answer/id #uuid "c2d87b1b-17a5-523c-a973-f5e0ad287cd3" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186401631} {:answer/id #uuid "ea4f4094-0cfd-5ae4-8308-88f0b83b2c27" :answer/type {:db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186401632} {:answer/id #uuid "946c0adc-baba-5359-a975-69b7a89f4838" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186401633}] :answer-field/correct {:answer/id #uuid "aa5ec049-b8d0-5c17-a28c-05813122674f" :answer/type {:db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186401630} :answer-field/id #uuid "5088efea-7f9e-57d5-8f9c-14c688a0e06b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401628}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "104d7814-9b21-55a2-864d-c61ec56f5c8f" :question/math-academy-id "q-17392" :question/problem "Given that $y=2{x}^{e}-ln⁡x$, find the instantaneous rate of change at $x=1.$" :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{e}-ln⁡x) \\\\  & =2e{x}^{e-1}-\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(2e{x}^{e-1}-\\frac{1}{x})|}_{x=1} \\\\  & =2e\\cdot {1}^{e-1}-\\frac{1}{1} \\\\  & =2e-1\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}]}
