#{[{:db/id #edb/ref 17592186176050 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175696 :question/id #uuid "f4649856-d777-5468-a7f4-df50479e36d7" :question/math-academy-id "e-11005" :question/problem "If $\\tan\\left( x\\right) = -2$ for some value of $x,$ then find the value of $\\tan\\left( x-2\\pi\\right).$" :question/worked-solution "The period of $y=\\tan x$ is $\\pi.$ Therefore, for any integer $n,$ we have\n\n$$\n\\tan x = \\tan (x+n\\pi).\n$$\n\nSubstituting $n=-2$ into the above gives\n\n$$\n\\begin{aligned}tan⁡x & =tan⁡(x+(-2)\\cdot \\pi )=tan⁡(x-2\\pi ).\\end{aligned}\n$$\n\nSince $\\tan\\left( x\\right) = -2,$ we get that $\\tan\\left( x-2\\pi\\right) = -2.$"} :knowledge-point/id #uuid "eed0c7c3-0bb5-56eb-a9ca-9ec4dc7b3efe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049353 :topic/math-academy-id 2148 :topic/title "Periodic Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186176458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da1cae17-3049-5957-9085-6d8db9031a94" :answer/type {:db/ident :answer.type/math} :answer/value "2 + 4π" :db/id #edb/ref 17592186174889} {:answer/id #uuid "06d76541-3c00-57ac-bf49-44d84ecb3a75" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186174890} {:answer/id #uuid "1c1e0f88-776f-5267-a422-c987a92886bf" :answer/type {:db/ident :answer.type/math} :answer/value "4π" :db/id #edb/ref 17592186174891} {:answer/id #uuid "5ebc65b2-0c8f-5bbb-8037-10ad080606a6" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186174892} {:answer/id #uuid "7a12c2a5-4d17-580c-bcae-19031e420588" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186174893}] :answer-field/id #uuid "8cf95971-9c69-5bc7-8b24-5f1c37369fc5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186174888}] :question/id #uuid "bd810017-2f6c-51ef-95bf-bef7c6896d24" :q