}\\theta " :db/id #edb/ref 17592186389121} {:answer/id #uuid "d3398719-8fe7-5303-a753-c43f72bb0596" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{16}\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186389122} {:answer/id #uuid "b175c8ee-c27d-5255-8737-063a160f1607" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{16}{r}^{2}\\operatorname{ln}⁡(r+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186389123} {:answer/id #uuid "1a083a94-f096-531d-ba65-44631b40cc71" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{4}r\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186389124} {:answer/id #uuid "4ca6e142-ca44-5238-9857-d72f2dd5f577" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}\\operatorname{ln}⁡(r+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186389125}] :answer-field/correct {:answer/id #uuid "00aa38ea-bac0-52a0-86dc-bc6b9414c3ba" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186389121} :answer-field/id #uuid "2c650825-40f2-5963-96ba-a65375cf218b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389120}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a368d06f-dd38-5739-a1e1-1669cc437d2c" :question/math-academy-id "q-161041" :question/problem "![](images/6b/6b077d20bcb79f293383a7810d1c46ad42ce78d17a8d631b01f66a9fd547f475.png)\n\nThe region $D$ is the circle shown above. What is ${∬}_{D}\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1)\\,\\text{d}A$ expressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents the disk of radius $4$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 4,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\operatorname{ln}⁡({x}^{2}+{y}^{2}+1)\\,\\text{d}A & ={∬}_{Δ}\\operatorname{ln}⁡((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1)r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r\\operatorname{ln}⁡({r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1)\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{4}r\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186394497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cbf1a51-29f1-5394-92b0-8fa0f03ed53d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{0}{\\int }_{0}^{1}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186394499} {:answer/id #uuid "27e50012-eea3-5128-88f0-eda7bc43ff75" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}r\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186394500} {:answer/id #uuid "cc41e329-99f2-5f79-8b27-2fe659d98387" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{0}{\\int }_{0}^{1}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186394501} {:answer/id #uuid "fc17b81c-5c7b-56d4-81ee-2ee528fd1694" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186394502} {:answer/id #uuid "71b6433e-1c17-5544-8e0e-856c1b39a65e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186394503}] :answer-field/correct {:answer/id #uuid "71b6433e-1c17-5544-8e0e-856c1b39a65e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186394503} :answer-field/id #uuid "eded17d8-4f57-5cb7-b32d-e7959dffa38a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394498}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "548b0706-bd0c-5d06-92da-211a7b8ff882" :question/math-academy-id "q-83499" :question/problem "![](images/8c/8c3056de2634d5315aebcbc978bf279eeb95da736ab6796c9d86dc39d9feadc5.png)\n\nThe region $D$ is the quarter-circle shown above. What is\n${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186411863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "545b4aad-bc8c-59f4-a624-a099157d5076" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{2}}r(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411722} {:answer/id #uuid "8930c666-998a-5367-8dd0-b9dfcc9f93f4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411751} {:answer/id #uuid "adfa686a-3a9f-5c43-baff-2feb8fd0100f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}r\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411769} {:answer/id #uuid "cb339401-80d8-5441-8a36-c4eb7250cbc0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411789} {:answer/id #uuid "cfda085a-1d8b-55be-bd0f-4cfdeac71375" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411794}] :answer-field/correct {:answer/id #uuid "cb339401-80d8-5441-8a36-c4eb7250cbc0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411789} :answer-field/id #uuid "75ea2526-b966-5bc2-949f-e2b7d5c9deed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411831}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "72611a88-9d34-5676-b505-ea5928bf6c8a" :question/math-academy-id "q-83500" :question/problem "![](images/55/55bbf6f55ce287321f2cc593ea48d65a78c655ca18d2a34df68b63c2bda92c8f.png)\n\nThe region $D$ is the semicircle shown above. What is\n${∬}_{D}(x+y)\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\sqrt{2}$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le \\sqrt{2},\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}(x+y)\\,\\text{d}A & ={∬}_{Δ}((r\\operatorname{cos}⁡\\theta )+(r\\operatorname{sin}⁡\\theta ))\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c2bf0f-9ee2-5d88-8b23-545cf4448435" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430734} {:answer/id #uuid "7c5313f3-0d47-59ad-80f4-3575ea706678" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi /2}{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430750} {:answer/id #uuid "bdef2d30-346b-534b-81e2-deb246402953" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\sqrt{3}}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430753} {:answer/id #uuid "ccbd5dd6-3cb9-5c6a-a847-fed35c7db186" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{-\\sqrt{3}}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430755} {:answer/id #uuid "e7a98739-7f64-53ee-a143-4b1433040ca0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430758}] :answer-field/correct {:answer/id #uuid "e7a98739-7f64-53ee-a143-4b1433040ca0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430758} :answer-field/id #uuid "d2c5fff5-18f1-537f-babe-36cf80cdf6a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430766}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9bb2e441-17ac-5548-ad1a-c8ae9611922f" :question/math-academy-id "q-83954" :question/problem "![](images/a6/a60d80425c240deb1ea372d7a21c3774247c4827536ce6f409f7e8736c7c94bc.png)\n\nThe region $D$ is the quarter-circle shown above. What is\n${∬}_{D}x\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\sqrt{3}$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le \\sqrt{3},\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e9bbb5-54b5-5e26-a0a0-50d7cf20ec9d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{25}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430735} {:answer/id #uuid "6ef3239f-a18f-5059-bc4c-90c9f800c498" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{2}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430746} {:answer/id #uuid "eb9c6068-17a0-54f3-9151-2a048c9f0abc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430759} {:answer/id #uuid "f3db7076-912a-5dca-b78b-50d779ed3d9a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{5}{r}^{2}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430761} {:answer/id #uuid "f55622cc-0b32-52f4-8ae8-9cf843cdb023" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{25}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430762}] :answer-field/correct {:answer/id #uuid "eb9c6068-17a0-54f3-9151-2a048c9f0abc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430759} :answer-field/id #uuid "e75c2f8e-ad0e-567f-ad60-4f9161bdb2d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430767}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b93ec44e-b9fb-53f6-875f-5ef36dc8b48a" :question/math-academy-id "q-161043" :question/problem "![](images/2d/2db1e29e5f911a45c4c48ab41c4ad6dc63eeb36a8112672ae66844e14342f4c0.png)\n\nThe region $D$ is the circle shown above. What is ${∬}_{D}{y}^{2}\\,\\text{d}A$ expressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents the disk of radius $5$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 5,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}{(r\\operatorname{sin}⁡\\theta )}^{2}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"}] :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] [{:db/id #edb/ref 17592186129200 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129018 :question/id #uuid "f31dd085-70fa-5eed-adf9-89fb0e6654e1" :question/math-academy-id "e-7348" :question/problem "Integrate the function $f(x, y) = 15xy^2$ over the portion of the disk of radius $2$ centered at the origin, where $x \\geq 0,y \\geq 0.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nFirst, let's sketch our region $D\\mathbin{:}$\n\n![](images/05/051cfbbf3fd37f01ff7e4442fccdc5ec4ce506e3c452b68bfa2ed5ae6e5cf6b9.png)\n\nIn polar coordinates $(r, \\theta),$ the region can be expressed as \n\n$$\n\\Delta = \\left\\{ (r,\\theta) \\: : \\: 0 \\leq r \\leq 2, \\:0\\leq \\theta \\leq  \\dfrac{\\pi}{2} \\right\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}15x{y}^{2}\\,\\text{d}A & ={∬}_{Δ}15r\\operatorname{cos}⁡\\theta \\cdot (r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}15{r}^{4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta {\\int }_{0}^{2}5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,{[{r}^{5}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta ({2}^{5}-0)\\text{d}\\theta  \\\\  & =32{\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =32{[{sin}^{3}⁡\\theta ]}_{0}^{\\pi /2} \\\\  & =32({sin}^{3}⁡(\\frac{\\pi }{2})-{sin}^{3}⁡(0)) \\\\  & =32(1-0) \\\\  & =32.\\end{aligned}\n$$"} :knowledge-point/id #uuid "5b97f75d-c784-5f3a-984d-f9a5fdf21d61" :knowledge-point/questions [{:db/id #edb/ref 17592186129632 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dbb1193-47be-5246-a935-a3e2f7a5d9cc" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186321372} {:answer/id #uuid "6be44563-7ff5-5aff-888b-8534ab2d8574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186321988} {:answer/id #uuid "7d81d17b-e0e4-5462-aa1e-2daeda378c4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186322134} {:answer/id #uuid "9e663173-e8bf-5e07-9a64-eabd853d519d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322395} {:answer/id #uuid "c307b8a7-c480-5cfb-a7fb-ea588c87cd94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186322662}] :answer-field/correct {:answer/id #uuid "c307b8a7-c480-5cfb-a7fb-ea588c87cd94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186322662} :answer-field/id #uuid "54b4bbfb-a31e-55b3-9e9c-d9e99a687a4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323330}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a604ede7-8a36-5960-82df-176ca647b425" :question/math-academy-id "q-38140" :question/problem "Integrate the function $f(x,y)=2x+y$ over the portion of the disk of radius $2$ centered at the origin, where $y\\ge 0.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/b5/b5ba69ab02aa13e201b7b9113f6a36e705ad19e6412499504afc4f239459a8f3.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}(2x+y)\\,\\text{d}A & ={∬}_{Δ}(2r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,{[\\frac{{r}^{3}}{3}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )(\\frac{{2}^{3}}{3}-0)\\text{d}\\theta  \\\\  & =\\frac{8}{3}{\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{8}{3}[2\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ]_{0}^{\\pi } \\\\  & =\\frac{8}{3}((2\\operatorname{sin}⁡(\\pi )-\\operatorname{cos}⁡(\\pi ))-(2\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{8}{3}(1+1) \\\\  & =\\frac{16}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd51e610-6f03-5601-be97-90a082867f32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186128804} {:answer/id #uuid "115c217e-8e0a-5c5b-8302-ae521adc07f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186128805} {:answer/id #uuid "232b05d7-2819-5154-96f7-710edeff9ff6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186128806} {:answer/id #uuid "4505c771-cef0-508f-89e7-d4849ae94ee6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186128807} {:answer/id #uuid "6325e896-5085-50b5-ab25-23a0ebf6535e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186128808}] :answer-field/correct {:answer/id #uuid "cd51e610-6f03-5601-be97-90a082867f32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186128804} :answer-field/id #uuid "d8292c76-a1e0-5537-aaa6-9b5b73963ff1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128803}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "929376bc-8d45-5684-ae94-b99b8cb09d33" :question/math-academy-id "q-83968" :question/problem "![](images/fd/fd1a5a140c3a2d430312d6f6ceeb21d6b7282119c8ec53365553ff845d8c64d5.png)\n\nEvaluate the double integral ${∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A,$ where the region $D$ is the semicircle shown above." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\frac{1}{2}$ centered at \n$(0,-\\frac{1}{2}).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write the $x=\\sqrt{-{y}^{2}-y}$ in polar coordinates:\n\n$$\n\\begin{aligned}x & =\\sqrt{-{y}^{2}-y} \\\\ {x}^{2} & =-{y}^{2}-y \\\\ {x}^{2}+{y}^{2} & =-y \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =-r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =-r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2} & =-r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}+r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-\\operatorname{sin}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le -\\operatorname{sin}⁡\\theta ,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta )\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta {\\int }_{0}^{-\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta [\\frac{{r}^{4}}{4}]_{0}^{-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta ((-\\operatorname{sin}⁡\\theta )^{4}-{0}^{4})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /2}^{0}\\operatorname{cos}⁡\\theta {sin}^{4}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{[\\frac{{sin}^{5}⁡\\theta }{5}]}_{-\\pi /2}^{0} \\\\  & =\\frac{1}{20}({sin}^{5}⁡0-{sin}^{5}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{1}{20}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e776117-b2c8-5c7a-9d16-751f765be404" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275599} {:answer/id #uuid "4f9d1ae7-f6c6-570b-9ced-645ab8a2169a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276190} {:answer/id #uuid "7c016cad-a688-555e-9bb3-a399d13f0149" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276608} {:answer/id #uuid "9a2b4cc3-f053-5ed5-b9d6-7f1939263729" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276859} {:answer/id #uuid "faf68c35-0933-5c2f-838a-cc6c8b57001f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277676}] :answer-field/correct {:answer/id #uuid "faf68c35-0933-5c2f-838a-cc6c8b57001f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186277676} :answer-field/id #uuid "0c7f3a1e-076c-5684-8e63-15c2040c9f43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277749}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9fa6b6f5-4249-530e-aeb1-5511d96e1746" :question/math-academy-id "q-161050" :question/problem "Integrate the function $f(x,y)=15{x}^{2}y$ over the disk of radius $1$ centered at the origin." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/9b/9b54b7a488a1983ba1816fdf5c55e039951eb417102c61963977b2f48b9c8d9e.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}12{x}^{2}y\\,\\text{d}A & ={∬}_{Δ}15({r}^{2}{cos}^{2}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}15{r}^{4}({cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta ){\\int }_{0}^{1}5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )\\,{[{r}^{5}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )(1-0)\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =[-{cos}^{3}⁡\\theta ]_{0}^{2\\pi } \\\\  & =-({cos}^{3}⁡(2\\pi )-{cos}^{3}⁡(0)) \\\\  & =-(1-1) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ad79092-f016-53f7-a552-da7705b0e553" :answer/type {:db/ident :answer.type/math} :answer/value "9+4\\pi " :db/id #edb/ref 17592186275728} {:answer/id #uuid "7636b055-40d1-5da4-992b-6cf4130c550f" :answer/type {:db/ident :answer.type/math} :answer/value "9\\pi " :db/id #edb/ref 17592186276544} {:answer/id #uuid "bed5cbac-2b75-59e8-bf61-95fb98959df9" :answer/type {:db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186277178} {:answer/id #uuid "ddd67c0a-3dac-561a-8db6-3731e772cb7f" :answer/type {:db/ident :answer.type/math} :answer/value "18+2\\pi " :db/id #edb/ref 17592186277422} {:answer/id #uuid "f22075cf-3f26-53dc-89c2-6eefbee0d8bd" :answer/type {:db/ident :answer.type/math} :answer/value "27\\pi " :db/id #edb/ref 17592186277603}] :answer-field/correct {:answer/id #uuid "bed5cbac-2b75-59e8-bf61-95fb98959df9" :answer/type {:db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186277178} :answer-field/id #uuid "f825344c-a3e7-5d9c-a7f6-4fa9aa047ca6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278162}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ad9dc383-588b-5128-942d-8b56b5fb2221" :question/math-academy-id "q-161052" :question/problem "Integrate the function $f(x,y)=4{y}^{2}$ over the disk of radius $3$ centered at the origin." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/0a/0a1de805051eff4ea82b4eefb7bb113c724b3d4e7304704831b6294ee4e4d674.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}4{y}^{2}\\,\\text{d}A & ={∬}_{Δ}4(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{3}4{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta {\\int }_{0}^{3}4{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,{[{r}^{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta (81-0)\\text{d}\\theta  \\\\  & =81{\\int }_{0}^{2\\pi }{sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =81{\\int }_{0}^{2\\pi }\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{81}{2}{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{0}^{2\\pi } \\\\  & =\\frac{81}{2}[(2\\pi -0)-\\frac{1}{2}(\\operatorname{sin}⁡4\\pi -\\operatorname{sin}⁡0)] \\\\  & =\\frac{81}{2}\\cdot 2\\pi  \\\\  & =81\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116fe698-da44-5921-9595-81cea6cf0777" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi ({e}^{2}-1)" :db/id #edb/ref 17592186275632} {:answer/id #uuid "1bb65dd3-22d7-5680-9fd1-2950d61da9b2" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}(2\\pi -1)" :db/id #edb/ref 17592186275734} {:answer/id #uuid "63ccd069-a545-55f8-89a3-8f411148b91d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186276380} {:answer/id #uuid "7d759d00-8c72-5816-95c1-40378ed648d6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {e}^{4}" :db/id #edb/ref 17592186276620} {:answer/id #uuid "b249fdf3-d35b-5850-8f01-7cb45187798e" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi ({e}^{4}-1)" :db/id #edb/ref 17592186277073}] :answer-field/correct {:answer/id #uuid "b249fdf3-d35b-5850-8f01-7cb45187798e" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi ({e}^{4}-1)" :db/id #edb/ref 17592186277073} :answer-field/id #uuid "dd14850f-a094-504b-a27e-fd0a9ea939b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278114}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bba8bb12-bb44-5085-86bc-e29c01145558" :question/math-academy-id "q-161053" :question/problem "Integrate the function $f(x,y)={e}^{{x}^{2}+{y}^{2}}$ over the disk of radius $2$ centered at the origin." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/81/811cfa127ad232e8d5a990998604718a57344d1bd7f43173dc0987631c13db33.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{e}^{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}{e}^{(r{cos}^{2}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{e}^{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{e}^{{r}^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{[\\frac{1}{2}{e}^{{r}^{2}}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}({e}^{4}-1)\\text{d}\\theta  \\\\  & =\\frac{1}{2}({e}^{4}-1)[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{1}{2}({e}^{4}-1)(2\\pi -0) \\\\  & =\\pi ({e}^{4}-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a04819ad-b64f-5339-bd10-f5dae67b0b11" :answer/type {:db/ident :answer.type/math} :answer/value "27\\pi " :db/id #edb/ref 17592186276922} {:answer/id #uuid "bd2c3493-79bf-50d5-b228-17395a6342de" :answer/type {:db/ident :answer.type/math} :answer/value "9\\pi -3" :db/id #edb/ref 17592186277160} {:answer/id #uuid "e51cd9aa-028b-5139-bde8-c1e863ead1cf" :answer/type {:db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186277477} {:answer/id #uuid "fa0a5b30-f93d-53d1-a5dd-3f5cd120beb7" :answer/type {:db/ident :answer.type/math} :answer/value "18\\pi +2" :db/id #edb/ref 17592186277664} {:answer/id #uuid "fb94ab63-cb9a-57db-88b5-198ca54a362e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\pi " :db/id #edb/ref 17592186277684}] :answer-field/correct {:answer/id #uuid "e51cd9aa-028b-5139-bde8-c1e863ead1cf" :answer/type {:db/ident :answer.type/math} :answer/value "81\\pi " :db/id #edb/ref 17592186277477} :answer-field/id #uuid "c3194bfd-1758-55d9-8263-07b55c8c710d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278069}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f641b0ca-15bb-53b1-96d0-217b8812f929" :question/math-academy-id "q-161054" :question/problem "Integrate the function $f(x,y)=2({x}^{2}+{y}^{2})$ over the disk of radius $3$ centered at the origin" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/0a/0a1de805051eff4ea82b4eefb7bb113c724b3d4e7304704831b6294ee4e4d674.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}2{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{∬}_{Δ}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\,{[\\frac{{r}^{4}}{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }(\\frac{81}{4}-0)\\text{d}\\theta  \\\\  & =\\frac{81}{2}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{81}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{81}{2}(2\\pi -0) \\\\  & =81\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d7209c-7c17-506b-a4a6-86dde4f2d563" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186275501} {:answer/id #uuid "22dc0a44-0404-58da-88dd-666cf5f8fdf9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275788} {:answer/id #uuid "24f5786b-4836-55d8-ad56-141581c6fdc4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275810} {:answer/id #uuid "3edc9dc7-a45f-5d0a-8152-3cecbb7db9af" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186276022} {:answer/id #uuid "60d9ad63-0c6e-5759-b321-954fef286724" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186276349}] :answer-field/correct {:answer/id #uuid "24f5786b-4836-55d8-ad56-141581c6fdc4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275810} :answer-field/id #uuid "b3c6d819-dfad-57d8-acd9-b4103349034b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278038}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c4a72efd-94bd-57c9-9125-f124ca8a7f81" :question/math-academy-id "q-161055" :question/problem "![](images/71/719f86db69489f62bcbe2753e88cdc6713f04dc6f53415cc2484e2eaab8ffac3.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{x}{y}\\,\\text{d}A,$ where the region $D$ is the semicircle shown above." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $1$ centered at \n$(0,1).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write the $x=\\sqrt{2y-{y}^{2}}$ in polar coordinates:\n\n$$\n\\begin{aligned}x & =\\sqrt{2y-{y}^{2}} \\\\ {x}^{2} & =2y-{y}^{2} \\\\ {x}^{2}+{y}^{2} & =2y \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =2r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{sin}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le \\frac{\\pi }{2}}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{x}{y}\\,\\text{d}A & ={∬}_{Δ}\\frac{r\\operatorname{cos}⁡\\theta }{r\\operatorname{sin}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2\\operatorname{sin}⁡\\theta }r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }{[\\frac{{r}^{2}}{2}]}_{0}^{2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }(2{sin}^{2}⁡\\theta -0)\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2\\theta \\,\\text{d}\\theta  \\\\  & ={[-\\frac{1}{2}\\operatorname{cos}⁡2\\theta ]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{2}(-1-1) \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c8b8e0-2cc2-5fe5-a1df-e98cd1001f29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186351613} {:answer/id #uuid "7c4bd1d1-6340-5981-bf6a-672c766b04a6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186352654} {:answer/id #uuid "c7e43f8a-2b13-5ebe-b51e-312ffdb9f42b" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\operatorname{ln}⁡2" :db/id #edb/ref 17592186353302} {:answer/id #uuid "de54c0b4-a6ca-5c07-9dbe-5dedc4f5b648" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2}{2}" :db/id #edb/ref 17592186353496} {:answer/id #uuid "fa31fa69-bb59-5f48-98b0-b5486fce2c71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi \\operatorname{ln}⁡2}{2}" :db/id #edb/ref 17592186353757}] :answer-field/correct {:answer/id #uuid "fa31fa69-bb59-5f48-98b0-b5486fce2c71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi \\operatorname{ln}⁡2}{2}" :db/id #edb/ref 17592186353757} :answer-field/id #uuid "bbf98d97-f14f-5123-b9e9-537f4bff4e00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354139}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a65ae57-db8c-559b-a30a-84cd82c23ff1" :question/math-academy-id "q-83970" :question/problem "Integrate the function $f(x,y)=\\frac{2}{{x}^{2}+{y}^{2}+1}$ over the portion of the disk of radius $1$ centered at the origin, where $x\\le 0$ and $y\\le 0.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/e4/e4275e74a45deb22c0ed22546772e33fbd5caeb89a4036b1a2f4870e8ecf67a1.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2}{{x}^{2}+{y}^{2}+1}\\,\\text{d}A & ={∬}_{Δ}\\frac{2}{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{1}\\frac{2r}{{r}^{2}+1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}[\\operatorname{ln}⁡({r}^{2}+1)]_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1)\\,\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡2{\\int }_{\\pi }^{3\\pi /2}\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡2[\\theta ]_{\\pi }^{3\\pi /2} \\\\  & =\\operatorname{ln}⁡2(\\frac{3\\pi }{2}-\\pi ) \\\\  & =\\frac{\\pi \\operatorname{ln}⁡2}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c68a910-d47a-5d42-8472-65a137268360" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186430736} {:answer/id #uuid "6f84c6cd-963a-5926-9438-431cae8fd173" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186430747} {:answer/id #uuid "a1c001e9-e046-5dfd-859e-0f7553c95834" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186430751} {:answer/id #uuid "c1c797d0-94a3-5402-8500-48167fa5bf9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186430754} {:answer/id #uuid "f171ab4d-9dad-5bbc-b321-f960560419b8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186430760}] :answer-field/correct {:answer/id #uuid "f171ab4d-9dad-5bbc-b321-f960560419b8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186430760} :answer-field/id #uuid "0c8566ad-8855-54ed-9229-fd53a23bc1a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430763}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2077302e-eca5-5aa1-8731-3c58ab648006" :question/math-academy-id "q-83520" :question/problem "Integrate the function $f(x,y)=x-y$ over the portion of the disk of radius $2$ centered at the origin, where $x\\ge 0$ and $y\\ge 0.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](images/7b/7b181b47af7d29b68d86d26b5c2b948c17ce39c01a62cbb36e874bb733865718.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}x-y\\,dA & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}{r}^{2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta ){\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\frac{1}{3}{[{r}^{3}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{3}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )({2}^{3}-{0}^{3})\\text{d}\\theta  \\\\  & =\\frac{8}{3}{\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{8}{3}[\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ]_{0}^{\\pi /2} \\\\  & =\\frac{8}{3}[(\\operatorname{sin}⁡\\frac{\\pi }{2}+\\operatorname{cos}⁡\\frac{\\pi }{2})-(\\operatorname{sin}⁡0+\\operatorname{cos}⁡0)] \\\\  & =\\frac{8}{3}(1-1) \\\\  & =0.\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating a Double Integral by Converting To Polar Coordinates"}] [{:db/id #edb/ref 17592186129253 :knowledge-point/canonical-example {:db/id #edb/ref 17592186129078 :question/id #uuid "53aa15a0-8633-51b8-8731-9099eec94940" :question/math-academy-id "e-9941" :question/problem "![](images/26/2683c694582a7c2dbe1c95cce6af22ef941a1e77b54721151a935e81ec2b3b1a.png)\n\nA part of the graph of a polynomial $p(x)$ is given above. Which of the following statements is true?\n\n- $x=-4$ is a multiple root of odd multiplicity\n\n- $x=-4$ is a multiple root of even multiplicity\n\n- $x=-4$ is a simple root" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *tangent* to the $x$-axis at $x=-4.$ So, $x=-4$ is a *multiple* root. \n\nFurthermore, the graph touches the $x$-axis and reverses direction at $x=-4.$ So, $x=-4$ has *even* multiplicity.\n\nTherefore, $x=-4$ is a multiple root of even multiplicity."} :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048669 :topic/math-academy-id 88 :topic/title "Multiplicities of the Roots of Polynomials"}] :knowledge-point/questions [{:db/id #edb/ref 17592186129495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a5e1ad2-1530-5ea9-afd0-b8821e67489f" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 3$ is a simple root" :db/id #edb/ref 17592186126471} {:answer/id #uuid "b940577f-2c1c-5880-a99b-02e525839d37" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 3$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186126472} {:answer/id #uuid "0ceac3b7-c7d5-5c42-8a20-1f2b0f06b7cd" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 3$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186126473} {:answer/id #uuid "4b63a343-8aae-5d66-9e41-c67c5eb894fd" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 3$ is not a root of $p(x)$" :db/id #edb/ref 17592186126474} {:answer/id #uuid "7711f0f7-1ff6-56fa-bee0-58f1ffec3040" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 3$ is a simple root of even multiplicity" :db/id #edb/ref 17592186126475}] :answer-field/id #uuid "99c6317b-2913-5842-8456-613c95eb39c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb