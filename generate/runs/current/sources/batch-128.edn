-5d27-b27b-ac44d2256aba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{x}-sin⁡x" :db/id #edb/ref 17592186286822}] :answer-field/correct {:answer/id #uuid "c5d4f500-323e-5311-9fac-df967ad59f73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286604} :answer-field/id #uuid "87489006-c764-5370-a687-c0a258ab9b3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287432}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7d56c895-83f0-5d1c-bce1-e5e5d8df4d98" :question/math-academy-id "q-1934" :question/problem "Given that $f(x)=cos⁡xlog⁡x,$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=cos⁡x$ and $v(x)=log⁡x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(cos⁡x)}^{′}log⁡x+cos⁡x{(log⁡x)}^{′} \\\\  & =(-sin⁡x)(log⁡x)+(cos⁡x)(\\frac{1}{xln⁡10}) \\\\  & =\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd6401f2-6da7-5c65-8aa1-add3b78f3859" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{x}{sec}^{2}(x)" :db/id #edb/ref 17592186298448}] :answer-field/correct {:answer/id #uuid "cd6401f2-6da7-5c65-8aa1-add3b78f3859" :answer/type {:db/ident :answer.type/math} :answer/value "{4}^{x}{sec}^{2}(x)" :db/id #edb/ref 17592186298448} :answer-field/id #uuid "26876702-3fb0-5366-a888-d8bd68fa6992" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298765}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6ccc1718-8889-5c4c-8f82-a3c2895dd7ec" :question/math-academy-id "q-319425" :question/problem "Given that $f(x)={4}^{x}tan⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}ln⁡(4)tan⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)={4}^{x}$ and $v(x)=tan⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({4}^{x})}^{′}tan⁡(x)+{4}^{x}{(tan⁡(x))}^{′} \\\\  & =({4}^{x}ln⁡(4))tan⁡(x)+{4}^{x}({sec}^{2}⁡(x)) \\\\  & ={4}^{x}ln⁡(4)tan⁡(x)+{4}^{x}{sec}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "308e34e3-3155-5d60-9431-e03d0af4fa0b" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297757}] :answer-field/correct {:answer/id #uuid "308e34e3-3155-5d60-9431-e03d0af4fa0b" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297757} :answer-field/id #uuid "f623b835-9c91-54d1-9180-2267f616a2e6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299472}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b53a0674-b02c-54b5-9306-2aa04fbf2674" :question/math-academy-id "q-319902" :question/problem "Given that $f(x)={x}^{3}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,{x}^{3}{e}^{x}$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{3}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{3})^{′}{e}^{x}+{x}^{3}({e}^{x})^{′} \\\\  & =(3{x}^{2})({e}^{x})+({x}^{3})({e}^{x}) \\\\  & =3{x}^{2}{e}^{x}+{x}^{3}{e}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "401c2c7b-6e36-5f00-8952-5abb22a759f2" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297807}] :answer-field/correct {:answer/id #uuid "401c2c7b-6e36-5f00-8952-5abb22a759f2" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297807} :answer-field/id #uuid "1f735430-71e8-5777-be52-a2e57f486a49" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298744}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7e457c64-526b-50d2-a5e1-9c9608789ec6" :question/math-academy-id "q-319903" :question/problem "Given that $f(x)=5{x}^{2}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=10x{e}^{x}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=5{x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(5{x}^{2})^{′}{e}^{x}+5{x}^{2}({e}^{x})^{′} \\\\  & =(10x)({e}^{x})+(5{x}^{2})({e}^{x}) \\\\  & =10x{e}^{x}+5{x}^{2}{e}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2303e32-8b26-55ec-9d0f-18e1bc3899cb" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3){log}_{3}(x)" :db/id #edb/ref 17592186298462}] :answer-field/correct {:answer/id #uuid "d2303e32-8b26-55ec-9d0f-18e1bc3899cb" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3){log}_{3}(x)" :db/id #edb/ref 17592186298462} :answer-field/id #uuid "792dd6e3-1db8-586c-a5f7-0da2170dac92" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299050}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d825ca35-2305-5442-afb6-a99517062893" :question/math-academy-id "q-320814" :question/problem "Given that $f(x)={3}^{x}{log}_{3}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)={log}_{3}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({3}^{x})}^{′}{log}_{3}⁡(x)+{3}^{x}{({log}_{3}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))({log}_{3}⁡(x))+({3}^{x})(\\frac{1}{x\\operatorname{ln}⁡(3)}) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3){log}_{3}⁡(x)+\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca46b1c5-ece7-5119-abe8-777dcc7ec3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{x\\operatorname{ln}(4)}" :db/id #edb/ref 17592186298433}] :answer-field/correct {:answer/id #uuid "ca46b1c5-ece7-5119-abe8-777dcc7ec3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{x\\operatorname{ln}(4)}" :db/id #edb/ref 17592186298433} :answer-field/id #uuid "0aa44b57-7202-5d5a-9c5f-cd88604e7d86" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298669}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6161762d-7ca8-5487-95de-c569a1e07882" :question/math-academy-id "q-320815" :question/problem "Given that $f(x)={4}^{x}{log}_{4}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)={4}^{x}$ and $v(x)={log}_{4}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({4}^{x})}^{′}{log}_{4}⁡(x)+{4}^{x}{({log}_{4}⁡(x))}^{′} \\\\  & =({4}^{x}\\operatorname{ln}⁡(4))({log}_{4}⁡(x))+({4}^{x})(\\frac{1}{x\\operatorname{ln}⁡(4)}) \\\\  & ={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)+\\frac{{4}^{x}}{x\\operatorname{ln}⁡(4)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e34c232-975f-51cf-8ed5-ecf0f78eff8c" :answer/type {:db/ident :answer.type/math} :answer/value "-{5}^{-x}\\operatorname{ln}(5){log}_{7}(x)" :db/id #edb/ref 17592186297797}] :answer-field/correct {:answer/id #uuid "3e34c232-975f-51cf-8ed5-ecf0f78eff8c" :answer/type {:db/ident :answer.type/math} :answer/value "-{5}^{-x}\\operatorname{ln}(5){log}_{7}(x)" :db/id #edb/ref 17592186297797} :answer-field/id #uuid "3b389b0c-f96f-5746-b4d1-da5e3f5fb10c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298838}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "42b535b3-90b5-5bc5-bbb3-36d4082e369c" :question/math-academy-id "q-320816" :question/problem "Given that $f(x)={5}^{-x}{log}_{7}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{5}^{-x}}{xln⁡(7)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={5}^{-x}$ and $v(x)={log}_{7}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({5}^{-x})}^{′}{log}_{7}⁡(x)+{5}^{-x}{({log}_{7}⁡(x))}^{′} \\\\  & =(-{5}^{-x}ln⁡(5))({log}_{7}⁡(x))+({5}^{-x})(\\frac{1}{xln⁡(7)}) \\\\  & =-{5}^{-x}ln⁡(5){log}_{7}⁡(x)+\\frac{{5}^{-x}}{xln⁡(7)}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}]}
