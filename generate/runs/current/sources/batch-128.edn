^{x}\\operatorname{ln}(5))\\operatorname{sin}(x)+{5}^{x}(\\operatorname{cos}(x)) \\\\  & ={5}^{x}\\operatorname{ln}(5)\\operatorname{sin}(x)+{5}^{x}\\operatorname{cos}(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb3cf46d-4dfa-538f-ba3e-cfde7c2bd873" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{2x}" :db/id #edb/ref 17592186232591}] :answer-field/correct {:answer/id #uuid "bb3cf46d-4dfa-538f-ba3e-cfde7c2bd873" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{2x}" :db/id #edb/ref 17592186232591} :answer-field/id #uuid "ac9d63dd-c99e-5f08-8d1a-09b6cb6e69fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232590}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ab210aae-e5d2-52de-b35d-cb8603b929bf" :question/math-academy-id "q-319909" :question/problem "Given that $f(x)={x}^{2}{e}^{2x},$ find ${f}^{'}(x).$\n\n${f}^{'}(x)=2x{e}^{2x}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}$ and $v(x)={e}^{2x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =({x}^{2})^{'}{e}^{2x}+{x}^{2}({e}^{2x})^{'} \\\\  & =(2x)({e}^{2x})+({x}^{2})(2{e}^{2x}) \\\\  & =2x{e}^{2x}+2{x}^{2}{e}^{2x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40427a01-e865-553d-9978-a8f9a86f4287" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot {3}^{x}" :db/id #edb/ref 17592186251086} {:answer/id #uuid "4d3624d4-0726-5e76-8ec2-c6738c5615aa" :answer/type {:db/ident :answer.type/math} :answer/value "(1+\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186251193} {:answer/id #uuid "a5e9eb2f-18a3-50d7-9c4e-0a47c7a87ea4" :answer/type {:db/ident :answer.type/math} :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186251984} {:answer/id #uuid "b56383b5-a0ac-53ad-a0fe-2a36c1ab2610" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}" :db/id #edb/ref 17592186252146} {:answer/id #uuid "ee1a7c18-5e33-593a-86b3-851a45507a67" :answer/type {:db/ident :answer.type/math} :answer/value "(x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186252636}] :answer-field/correct {:answer/id #uuid "a5e9eb2f-18a3-50d7-9c4e-0a47c7a87ea4" :answer/type {:db/ident :answer.type/math} :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186251984} :answer-field/id #uuid "7ce3d68b-66a4-51fa-a4ba-3670771baf6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253021}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "11c94822-e3fa-5674-8f0a-3b72546b7b89" :question/math-academy-id "q-11841" :question/problem "Given that $f(x)=x\\cdot {3}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=x$ and $v(x)={3}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(x)^{′}\\cdot {3}^{x}+x\\cdot ({3}^{x})^{′} \\\\  & ={3}^{x}+(x)(\\operatorname{ln}⁡3\\cdot {3}^{x}) \\\\  & ={3}^{x}+x\\operatorname{ln}⁡3\\cdot {3}^{x} \\\\  & =(1+x\\operatorname{ln}⁡3){3}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1371ebf8-eb22-510a-8da9-ab71603cf224" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)x{e}^{x}" :db/id #edb/ref 17592186284960} {:answer/id #uuid "53d9fa80-4531-56fa-a24b-26f7f44fadfa" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{x}" :db/id #edb/ref 17592186285560} {:answer/id #uuid "7e63c504-8cfa-54d7-aead-931836c675c3" :answer/type {:db/ident :answer.type/math} :answer/value "x(2{e}^{x}+x)" :db/id #edb/ref 17592186285950} {:answer/id #uuid "8f418a4b-7d9e-52b0-a17c-229783a68355" :answer/type {:db/ident