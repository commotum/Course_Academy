:answer.type/math} :answer/value "4t\\,i+8t\\,j+12t\\,k" :db/id #edb/ref 17592186300711} {:answer/id #uuid "95853092-5e55-5770-9781-01cbd398a49e" :answer/type {:db/ident :answer.type/math} :answer/value "{t}^{2}i+2{t}^{2}\\,j+3{t}^{2}\\,k" :db/id #edb/ref 17592186300713} {:answer/id #uuid "a47237b6-6c15-5c8f-a39e-9bcc3a189feb" :answer/type {:db/ident :answer.type/math} :answer/value "i+2\\,j+3\\,k" :db/id #edb/ref 17592186300789}] :answer-field/correct {:answer/id #uuid "7d6a0cfc-1fdb-5a5d-8094-0fa7eb47f049" :answer/type {:db/ident :answer.type/math} :answer/value "2t\\,i+4t\\,j+6t\\,k" :db/id #edb/ref 17592186300585} :answer-field/id #uuid "68503596-a623-58aa-b2ac-c212d77d484d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301555}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5d2dc74e-c392-56dc-bab3-713a1d0cef87" :question/math-academy-id "q-32502" :question/problem "If  $f(u)=u\\,i+2u\\,j+3u\\,k$ and $u(t)={t}^{2}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write \n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nNow, let's find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}u\\,i+\\frac{\\text{d}}{\\text{d}u}2u\\,j+\\frac{\\text{d}}{\\text{d}t}3u\\,k \\\\  & =i+2\\,j+3\\,k \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\  & =2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =(i+2\\,j+3\\,k)2t \\\\  & =2t\\,i+4t\\,j+6t\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304789 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016435a7-09df-59ed-8e52-f08535ec47e9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ 2\\operatorname{ln}⁡t\\end{aligned}]" :db/id #edb/ref 17592186302457} {:answer/id #uuid "32d17b7e-35d0-57c3-ba6d-1d89eb61e334" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{aligned}]" :db/id #edb/ref 17592186302768} {:answer/id #uuid "39e3dc14-bd57-5747-9a00-81c2814bbcbd" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]" :db/id #edb/ref 17592186302817} {:answer/id #uuid "6f93626f-cc40-5170-9705-d920aff7ec56" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]" :db/id #edb/ref 17592186303139} {:answer/id #uuid "a07903a9-95bb-5a12-97e9-bc7e59ec2065" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}u \\\\ 5 \\\\ 2u\\end{aligned}]" :db/id #edb/ref 17592186303448}] :answer-field/correct {:answer/id #uuid "6f93626f-cc40-5170-9705-d920aff7ec56" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]" :db/id #edb/ref 17592186303139} :answer-field/id #uuid "18f7d124-041e-581f-adbe-c38cf8ebd23e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304138}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8d3c1bb9-bc23-5441-85c4-926900a42dbb" :question/math-academy-id "q-32860" :question/problem "If $g(u)=[\\begin{aligned}\\operatorname{ln}⁡u \\\\ 5 \\\\ {u}^{2}\\end{aligned}]$ and $u(t)=\\operatorname{ln}⁡t$, then  $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{g}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}⁡u \\\\ \\frac{\\text{d}}{\\text{d}u}\\,\\,5\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}u}\\,\\,{u}^{2}\\,\\,\\end{aligned}]=[\\begin{aligned}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)=\\frac{1}{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =[\\begin{aligned}\\frac{1}{u(t)} \\\\ 0 \\\\ 2u(t)\\end{aligned}]{u}^{′}(t) \\\\  & =\\frac{1}{t}[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ 2\\operatorname{ln}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029ffd0e-a808-5dc2-b75a-236b9d62df96" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,-2{e}^{2t}⟩" :db/id #edb/ref 17592186302470} {:answer/id #uuid "3d48b11a-9299-5f42-982a-2d1e1bb0cbae" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{-2t},\\,0,\\,-{e}^{-4t}⟩" :db/id #edb/ref 17592186302838} {:answer/id #uuid "440997d6-7fcd-5bd7-8476-b139f1366f4b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,-2{e}^{-2t}⟩" :db/id #edb/ref 17592186302887} {:answer/id #uuid "6d9318c8-6af1-5310-8e35-7ffb568cb102" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,2{e}^{2t}⟩" :db/id #edb/ref 17592186303126} {:answer/id #uuid "a8c80301-2671-501b-931c-8779d0c7081d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{e}^{-2t},\\,0,\\,{e}^{-4t}⟩" :db/id #edb/ref 17592186303496}] :answer-field/correct {:answer/id #uuid "440997d6-7fcd-5bd7-8476-b139f1366f4b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,0,\\,-2{e}^{-2t}⟩" :db/id #edb/ref 17592186302887} :answer-field/id #uuid "e0b5f082-25b7-5165-91ab-092341e9996d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304687}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "53be4820-056b-50b8-b65a-84c0096afdb4" :question/math-academy-id "q-32869" :question/problem "If $g(u)=⟨\\operatorname{ln}⁡u,\\,0,\\,\\frac{1}{u}⟩$ and $u(t)={e}^{2t}$, then $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(g∘u)^{′}(t)=g′(u(t))u′(t)\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{g}^{′}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}⁡u,\\,\\frac{\\text{d}}{\\text{d}u}0,\\,\\frac{\\text{d}}{\\text{d}u}(\\frac{1}{u})⟩ \\\\  & =⟨\\frac{1}{u},\\,0,\\,-\\frac{1}{{u}^{2}}⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t})=2{e}^{2t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =⟨\\frac{1}{u(t)},\\,0,\\,-\\frac{1}{{u}^{2}(t)}⟩{u}^{′}(t) \\\\  & =2{e}^{2t}⟨\\frac{1}{{e}^{2t}},\\,0,\\,-\\frac{1}{({e}^{2t})^{2}}⟩ \\\\  & =⟨\\frac{2{e}^{2t}}{{e}^{2t}},\\,0,\\,-\\frac{2{e}^{2t}}{{e}^{4t}}⟩ \\\\  & =⟨2,\\,0,\\,-2{e}^{-2t}⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186305066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383ec955-af72-5aeb-813c-b7e9c4f5d6b1" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{2t+1}\\,i+2t{e}^{4t}\\,j" :db/id #edb/ref 17592186302802} {:answer/id #uuid "66c922b2-90d5-511b-af8e-8bcfb11c92dd" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{t+1}\\,i+2t{e}^{2t}\\,j" :db/id #edb/ref 17592186303077} {:answer/id #uuid "ef13717f-b212-5a08-aa3b-404f5a84709d" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186303955} {:answer/id #uuid "f38486c3-26cc-5013-9bbc-fc27b9c0dbd0" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{t+1}\\,i+6t{e}^{2t}\\,j" :db/id #edb/ref 17592186303984} {:answer/id #uuid "f827b8fb-15b2-57b4-b157-dc8224f13cb1" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{2{t}^{2}+1}\\,i-8{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186304011}] :answer-field/correct {:answer/id #uuid "ef13717f-b212-5a08-aa3b-404f5a84709d" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186303955} :answer-field/id #uuid "181930e4-89b2-5460-a910-ab0f457c2a21" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304132}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "30bcefa5-8086-5c62-ab2e-eb5b519248a2" :question/math-academy-id "q-33260" :question/problem "If $f(u)={e}^{u+1}\\,i+{e}^{2u}\\,j+\\frac{1}{e}\\,k$ and $u(t)=2{t}^{2}$ then $(f∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}({e}^{u+1})\\,i+\\frac{\\text{d}}{\\text{d}u}({e}^{2u})\\,j+\\frac{\\text{d}}{\\text{d}u}\\frac{1}{e}\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2u}\\,j+0\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2t}\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})=4t\\end{aligned}\n$$\n\n \nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\ (f∘u)^{′}(t) & =({e}^{2{t}^{2}+1}\\,i+2{e}^{4{t}^{2}}\\,j)4t \\\\  & =4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186373118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2353783-74f2-5934-bfba-3023b84ceef4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\operatorname{sin}⁡(4t-3) \\\\ -4\\operatorname{cos}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373120} {:answer/id #uuid "9fe13228-3768-591d-9f6a-24b6e1eb93a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡(4t-3) \\\\ \\operatorname{cos}⁡(4t-3) \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186373121} {:answer/id #uuid "72be2dff-28b8-52fc-9246-55ec88b83a57" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\operatorname{cos}⁡(4t-3) \\\\ -4\\operatorname{sin}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373122} {:answer/id #uuid "61bb40c2-9ecf-585d-b790-f34cbaa9de79" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8\\operatorname{sin}⁡(4t-3) \\\\ 8\\operatorname{cos}⁡(4t-3) \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186373123} {:answer/id #uuid "243cbcf4-b0d8-5b82-ad87-04f8e247276b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{cos}⁡(4t-3) \\\\ -\\operatorname{sin}⁡(4t-3) \\\\ {e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373124}] :answer-field/correct {:answer/id #uuid "72be2dff-28b8-52fc-9246-55ec88b83a57" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\operatorname{cos}⁡(4t-3) \\\\ -4\\operatorname{sin}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]" :db/id #edb/ref 17592186373122} :answer-field/id #uuid "91cea048-4a27-504b-b918-c58dbf7788d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373119}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "df22d5ba-b0c3-58b3-a878-bdf0e607174d" :question/math-academy-id "q-71222" :question/problem "If $f(u)=[\\begin{aligned}\\operatorname{sin}⁡u \\\\ \\operatorname{cos}⁡u \\\\ {e}^{u}\\end{aligned}]$ and $u(t)=4t-3,$ then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{sin}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}({e}^{u})\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ -\\operatorname{sin}⁡u \\\\ {e}^{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4t-3)=4\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(u(t)) \\\\ -\\operatorname{sin}⁡(u(t)) \\\\ {e}^{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(4t-3) \\\\ -\\operatorname{sin}⁡(4t-3) \\\\ {e}^{4t-3}\\end{aligned}]\\cdot 4 \\\\  & =[\\begin{aligned}4\\operatorname{cos}⁡(4t-3) \\\\ -4\\operatorname{sin}⁡(4t-3) \\\\ 4{e}^{4t-3}\\end{aligned}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32740510-69e4-53a8-9cf8-9c29535d9249" :answer/type {:db/ident :answer.type/math} :answer/value "\\,i-4{e}^{-2t}\\,j-2{e}^{-3t/2}\\,k" :db/id #edb/ref 17592186387903} {:answer/id #uuid "10afedd6-ff7f-51fa-bc1d-464cb204e6b9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-{e}^{-2t}\\,j-2{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387904} {:answer/id #uuid "bcb8b86f-001a-5eb1-9ded-dead76cc9891" :answer/type {:db/ident :answer.type/math} :answer/value "\\,i-2{e}^{-t}\\,j-\\frac{1}{4}{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387905} {:answer/id #uuid "ea538a96-8b67-5fc4-ba6a-05f6aa91f674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387906} {:answer/id #uuid "31024369-16ff-579a-acb7-e67065ff9581" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-2{e}^{2t}\\,j-\\frac{1}{2}{e}^{t}\\,k" :db/id #edb/ref 17592186387907}] :answer-field/correct {:answer/id #uuid "ea538a96-8b67-5fc4-ba6a-05f6aa91f674" :answer/type {:db/ident :answer.type/math} :answer/value "-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k" :db/id #edb/ref 17592186387906} :answer-field/id #uuid "93216f8a-001b-5ecf-87cd-938ff9643b14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387902}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "629c6742-cb38-552f-bd6e-09f3aee65a84" :question/math-academy-id "q-128561" :question/problem "If $f(u)=\\operatorname{ln}⁡u\\,i+{u}^{2}\\,j+\\sqrt{u}\\,k$ and $u(t)={e}^{-t},$ then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)i+\\frac{\\text{d}}{\\text{d}u}({u}^{2})j+\\frac{\\text{d}}{\\text{d}u}(\\sqrt{u})k \\\\  & =\\frac{1}{u}\\,i+2u\\,j+\\frac{1}{2\\sqrt{u}}\\,k \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{-t})=-{e}^{-t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t))\\cdot {u}^{′}(t) \\\\  & =(\\frac{1}{u(t)}\\,i+2u(t)\\,j+\\frac{1}{2\\sqrt{u(t)}}\\,k)\\cdot {u}^{′}(t) \\\\  & =(\\frac{1}{{e}^{-t}}\\,i+2{e}^{-t}\\,j+\\frac{1}{2\\sqrt{{e}^{-t}}}\\,k)\\cdot (-{e}^{-t}) \\\\  & =({e}^{t}\\,i+2{e}^{-t}\\,j+\\frac{1}{2}{e}^{t/2}\\,k)\\cdot (-{e}^{-t}) \\\\  & =-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6770c6c3-ca44-5901-927f-1f6eb9c2f483" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-\\frac{t}{2+{t}^{2}},0⟩" :db/id #edb/ref 17592186387910} {:answer/id #uuid "d6f467ee-f10f-5e09-b08f-f8641934f5aa" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{{t}^{2}},-\\frac{{t}^{2}}{1+{t}^{2}},0⟩" :db/id #edb/ref 17592186387911} {:answer/id #uuid "375265a8-c029-5e99-9d9a-45d5e93a7d32" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{1}{t+{t}^{2}},0⟩" :db/id #edb/ref 17592186387912} {:answer/id #uuid "78262439-79b2-52fc-a07a-ed5fa9d567e8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{t},-\\frac{1}{t+{t}^{2}},0⟩" :db/id #edb/ref 17592186387913} {:answer/id #uuid "b4369e5c-dffe-55df-9352-d2f0194bfc84" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{t}{1+{t}^{2}},0⟩" :db/id #edb/ref 17592186387914}] :answer-field/correct {:answer/id #uuid "375265a8-c029-5e99-9d9a-45d5e93a7d32" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-\\frac{1}{t+{t}^{2}},0⟩" :db/id #edb/ref 17592186387912} :answer-field/id #uuid "c8592051-0273-5e7f-9289-65035199769c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387909}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "00ec801b-e22a-5c19-899f-45b6911ab4a7" :question/math-academy-id "q-128570" :question/problem "If $g(u)=⟨\\frac{1}{u},\\,\\operatorname{ln}⁡(u+1),\\,1⟩$ and $u(t)=\\frac{1}{t}$, then $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(g∘u)^{′}(t)=g′(u(t))u′(t).\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{g}^{′}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}(\\frac{1}{u}),\\,\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡(u+1)),\\,\\frac{\\text{d}}{\\text{d}u}(1)⟩ \\\\  & =⟨-\\frac{1}{{u}^{2}},\\,\\frac{1}{u+1},\\,0⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})=-\\frac{1}{{t}^{2}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =⟨-\\frac{1}{(u(t))^{2}},\\,\\frac{1}{u(t)+1},\\,0⟩\\cdot {u}^{′}(t) \\\\  & =⟨-{t}^{2},\\,\\frac{t}{1+t},\\,0⟩\\cdot (-\\frac{1}{{t}^{2}}) \\\\  & =⟨1,-\\frac{1}{t+{t}^{2}},0⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc0818f3-6660-5a5e-b58d-a575762526c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393010} {:answer/id #uuid "ab98f763-293f-5909-a542-20bf9e265d33" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393011} {:answer/id #uuid "fb1b744a-fd28-5436-8fa1-dc99d58a58de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]" :db/id #edb/ref 17592186393012} {:answer/id #uuid "0df38d96-3c28-5876-bdec-12fe8a88731c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡({e}^{2t}) \\\\ {e}^{3t} \\\\ \\frac{1}{{e}^{2t}}\\end{aligned}]" :db/id #edb/ref 17592186393013} {:answer/id #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393014}] :answer-field/correct {:answer/id #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393014} :answer-field/id #uuid "198253e9-b22c-548e-8e45-872ef7aaca94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c43762c8-310f-5f86-a903-48bba629edc4" :question/math-academy-id "q-70695" :question/problem "If $f(u)=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ {u}^{3} \\\\ \\operatorname{ln}⁡u\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$"}] :knowledge-point/title "Using the Chain Rule for Differentiation"}]}
