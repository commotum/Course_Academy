#{[{:db/id #edb/ref 17592186059849 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059454 :question/id #uuid "7780340c-43d6-5d38-9270-865914098218" :question/math-academy-id "e-14764" :question/problem "Given that the determinant of  $[\\begin{aligned}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{aligned}]$ is $2,$ find the value of the constant $k.$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $k\\mathbin{:}$\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 1 & 2 \\\\ k & 4 & 5 \\\\ 0 & 2 & 3\\end{aligned}| & =3|\\begin{aligned}4 & 5 \\\\ 2 & 3\\end{aligned}|-1|\\begin{aligned}k & 5 \\\\ 0 & 3\\end{aligned}|+2|\\begin{aligned}k & 4 \\\\ 0 & 2\\end{aligned}| \\\\  & =3(12-10)-1(3k-0)+2(2k-0) \\\\  & =3\\cdot 2-1\\cdot 3k+2\\cdot 2k \\\\  & =6-3k+4k \\\\  & =k+6\\end{aligned}\n$$\n\nSince the determinant of the matrix is $2,$ we have:\n\n$$\n\\begin{aligned}k+6 & =2 \\\\ k & =-4\\end{aligned}\n$$"} :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050465 :topic/math-academy-id 422 :topic/title "The Quadratic Formula"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1912b5b-58a0-5491-a50c-b728a4ed3e22" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $6$ only" :db/id #edb/ref 17592186059299} {:answer/id #uuid "c8f7c0b0-c3a5-549e-b078-15d79f0248eb" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $8$ only" :db/id #edb/ref 17592186059300} {:answer/id #uuid "06c85cfe-b123-504b-9faf-324c33d747ac" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ only" :db/id #edb/ref 17592186059301} {:answer/id #uuid "0e43444a-08a5-579c-96df-f1622d1ebfa6" :answer/type {:db/ident :answer.type/text} :answer/value "$-8$ and $-2$ only" :db/id #edb/ref 17592186059302} {:answer/id #uuid "38b74efe-eb9e-5251-9500-fed3d79db7a2" :answ