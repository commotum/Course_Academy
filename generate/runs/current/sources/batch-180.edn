#{[{:db/id #edb/ref 17592186110602 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110336 :question/id #uuid "5eca5ef2-627f-5d32-8edb-88e223b11d71" :question/math-academy-id "e-14365" :question/problem "Find the equation of the line that is perpendicular to $x=2$ and passes through the point $(3,4).$" :question/worked-solution "Since the line $x=2$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(3,4),$ which has a $y$-coordinate of $4.$ So, the perpendicular line is $y=4.$"} :knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050763 :topic/math-academy-id 97 :topic/title "Horizontal and Vertical Lines"}] :knowledge-point/questions [{:db/id #edb/ref 17592186110949 :question/answer-fields [{:answer-field/id #uuid "9d51b4bc-0806-5b57-a4a9-30e6fb4bca40" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186107535} {:answer-field/id #uuid "a15e1a9b-1d3d-5c59-960a-9ee83d2d311b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186107536}] :question/id #uuid "4195803a-42bd-5c36-83eb-3efb2b176331" :question/math-academy-id "q-215418" :question/problem "Find the equation of the line that is perpendicular to $y = 2$ and passes through the point $(-3, 4)$. Write your answer in **standard form.** {{field-1}} $=$\n{{field-2}}"} {:db/id #edb/ref 17592186110950 :question/answer-fields [{:answer-field/id #uuid "bc25fe25-0330-5b6d-a1df-77f042d7d394" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186107537} {:answer-field/id #uuid "e5e28cc4-7edb-5d4a-86c2-ccea3087d4d7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186107538}]