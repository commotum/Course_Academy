db/id #edb/ref 17592186257106} :answer-field/id #uuid "f5c380c2-6f7a-5fa6-a1cf-bdd2ef574b31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259460}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "02dd9d18-cd94-5447-91da-e2448419b7b2" :question/math-academy-id "q-123179" :question/problem "Consider the vector field $F=(2x+3y-4z)^{2}\\,i+(2x+3y-4z)^{2}\\,j+(2x+3y-4z)^{2}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((2x+3y-4z)^{2})+\\frac{∂}{∂y}((2x+3y-4z)^{2})+\\frac{∂}{∂z}((2x+3y-4z)^{2}) \\\\  & =4(2x+3y-4z)+6(2x+3y-4z)-8(2x+3y-4z) \\\\  & =2(2x+3y-4z) \\\\  & =4x+6y-8z.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71cbe9b9-abfb-59ee-9a3b-f7f689c26688" :answer/type {:db/ident :answer.type/math} :answer/value "144" :db/id #edb/ref 17592186257781} {:answer/id #uuid "88b7f1be-ad85-5371-a6af-84faa05bd3aa" :answer/type {:db/ident :answer.type/math} :answer/value "76" :db/id #edb/ref 17592186257981} {:answer/id #uuid "d1c60dec-38f0-52c7-b0aa-6a4369234d40" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186258609} {:answer/id #uuid "d40a47e0-a307-5498-8db8-91105ba44fa3" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186258639} {:answer/id #uuid "edb9593d-e1cc-5ea7-ae77-b57065d0d67e" :answer/type {:db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186258838}] :answer-field/correct {:answer/id #uuid "d40a47e0-a307-5498-8db8-91105ba44fa3" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186258639} :answer-field/id #uuid "31c01b0b-506b-5b5b-95a1-7bc8278302dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259120}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "74e7bf88-8da6-528c-84d5-ded22deb1ee4" :question/math-academy-id "q-123200" :question/problem "Consider the vector field $F=(x-y)^{3}\\,i+(y+z)^{3}\\,j+(x+z)^{3}\\,k.$ Evaluate $\\text{div}\\,F$ at the point $(-2,2,2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((x-y)^{3})+\\frac{∂}{∂y}((y+z)^{3})+\\frac{∂}{∂z}((x+z)^{3}) \\\\  & =3(x-y)^{2}+3(y+z)^{2}+3(x+z)^{2}.\\end{aligned}\n$$\n\n \n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-2,2,2),$ and obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F(-2,2,2) & =3((-2)-(2))^{2}+3((2)+(2))^{2}+3((-2)+(2))^{2} \\\\  & =3(-4)^{2}+3(4)^{2}+3(0)^{2} \\\\  & =96.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bcdd62-0b56-5da2-a50a-586faa6696b0" :answer/type {:db/ident :answer.type/math} :answer/value "xy{z}^{2}+xz" :db/id #edb/ref 17592186263155} {:answer/id #uuid "295ca0f4-57e7-5a42-ac1c-c9565fd958a3" :answer/type {:db/ident :answer.type/math} :answer/value "y{z}^{2}+xy{e}^{y}" :db/id #edb/ref 17592186263355} {:answer/id #uuid "2be15acb-dbc4-5b00-98a8-38e26089e1ec" :answer/type {:db/ident :answer.type/math} :answer/value "5y{z}^{2}+x{e}^{y}" :db/id #edb/ref 17592186263371} {:answer/id #uuid "40fe9bd6-26ef-51ba-a8ee-4aa3