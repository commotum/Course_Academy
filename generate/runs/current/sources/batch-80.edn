#{[{:db/id #edb/ref 17592186087686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087433 :question/id #uuid "4f0593d8-bce5-5c73-aedd-ffe0faf15a59" :question/math-academy-id "e-14364" :question/problem "The lines $y=cx+7$ and $y=5x-3$ are parallel. What is the value of $c$?" :question/worked-solution "For two lines to be parallel, they must have the same slope.\n\nBoth lines are in slope-intercept form, so we can pick out the slope of each equation by looking at the $x$-coefficient.\n\n- The slope of the line $y=cx+7$ is $c$.\n- The slope of the line $y=5x-3$ is $5$.\n\nBecause the slopes must be the same, we must have $c=5$."} :knowledge-point/id #uuid "353a2fb8-5677-5047-8f39-595f43d9eeb9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716 :topic/math-academy-id 1240 :topic/title "Equations of Lines in Slope-Intercept Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186088072 :question/answer-fields [{:answer-field/id #uuid "c12cfecd-6908-57f1-91b4-ad6618d6b44c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186085140}] :question/id #uuid "8abba1b4-cf74-5469-9ad3-fd07f923a0f6" :question/math-academy-id "q-215719" :question/problem "The lines $y =-7x + 5$ and $y = mx + 2$ are parallel. What is the value of $m$?$m =$\n{{field-1}}"} {:db/id #edb/ref 17592186088073 :question/answer-fields [{:answer-field/id #uuid "51594eb3-a520-5a77-a55d-36ea7b41a396" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186085141}] :question/id #uuid "570f0d0a-a716-58d6-9635-7e7137caf659" :question/math-academy-id "q-215726" :question/problem "The lines $y =-\\frac{1}{8}x - 4$ and $y = mx + 6$ are parallel. What is the value of $m$?$m =$\n{{field-1}}"} {:db/id #edb/ref 17592186088176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb95632f-ccbf-5d8f-8ed1-2b2d0954659a" :answer/type {:db/ident :answer.type/math} :answer/v