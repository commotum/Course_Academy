86049201 :topic/math-academy-id 3725 :topic/title "Properties of Lines Given in Standard Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186087980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6bf01d9-1387-514b-afb5-fde88dafcb9b" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{3}{2}x + 6" :db/id #edb/ref 17592186084615} {:answer/id #uuid "1e7fa38f-3d7a-58ce-b27f-e3d665aba389" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{9}{4}x + \\frac{6}{5}" :db/id #edb/ref 17592186084616} {:answer/id #uuid "25180595-bbf1-583a-9a44-97d13f692586" :answer/type {:db/ident :answer.type/math} :answer/value "y = 6x + 5" :db/id #edb/ref 17592186084617} {:answer/id #uuid "38aee078-8100-5d7d-9eb6-406ce83f2e29" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{3}x - 3" :db/id #edb/ref 17592186084618} {:answer/id #uuid "5977f454-540b-54e7-8f16-ad456776a01b" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{3}{2}x + 1" :db/id #edb/ref 17592186084619}] :answer-field/id #uuid "245bbcc2-f655-5a48-bdbc-29042b01978a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084614}] :question/id #uuid "2fc0301a-011f-54d0-a696-b3599604db22" :question/math-academy-id "q-110094" :question/problem "Which of the following lines is parallel to $6x - 4y = 9$?"} {:db/id #edb/ref 17592186088003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eba8ed3a-e9e6-572d-8f63-2af14720b605" :answer/type {:db/ident :answer.type/math} :answer/value "y = 8x - 3" :db/id #edb/ref 17592186084753} {:answer/id #uuid "f142c471-0c73-5027-a095-f1f7d546e328" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x - 2" :db/id #edb/ref 17592186084754} {:answer/id #uuid "f3c15800-7ce4-5396-9281-1383a52cea32" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2x + 1" :db/id #edb/ref 17592186084755} {:answer/id #uuid "272782b2-67