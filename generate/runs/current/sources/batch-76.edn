swer/type {:db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186337504} {:answer/id #uuid "cd350b86-92f1-5b47-8195-38e00e0239ed" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y+2)^{2}=25" :db/id #edb/ref 17592186337831} {:answer/id #uuid "feac2e41-7550-5e75-ab07-0ad3fc367bb5" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+1)^{2}=25" :db/id #edb/ref 17592186338266}] :answer-field/correct {:answer/id #uuid "a2353a98-7f3f-5dcb-8a84-2f6b9edb5c4c" :answer/type {:db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186337504} :answer-field/id #uuid "b8cce04b-83c9-5250-85c8-d53e40d3c24a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338613}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b58a709-693d-534f-9bbe-586e11704f18" :question/math-academy-id "q-70896" :question/problem "![](images/ba/baa279bad56527ad959b2923f25df848396ffc7060c612469d637d4e614117b5.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $C(1,2)$ and the radius of the circle is $r=5.$ Therefore, the equation of the circle is\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-1)^{2}+(y-2)^{2} & ={5}^{2} \\\\ (x-1)^{2}+(y-2)^{2} & =25.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a00270e-5e9a-5b54-924d-4ef9bdceca94" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-2)^{2}=64" :db/id #edb/ref 17592186337432} {:answer/id #uuid "a825607b-2d15-5682-8738-35632d6078be" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y+3)^{2}=64" :db/id #edb/ref 17592186337552} {:answer/id #uuid "dac05b17-668c-59f0-a102-93f1f5f12437" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y-3)^{2}=64" :db/id #edb/ref 17592186337937} {:answer/id #uuid "ee7cb397-1c3d-5437-80bc-0d25f5c93337" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+2)^{2}=64" :db/id #edb/ref 17592186338118} {:answer/id #uuid "f4c47c68-de5c-5236-b155-78a447eb8332" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+3)^{2}=64" :db/id #edb/ref 17592186338171}] :answer-field/correct {:answer/id #uuid "f4c47c68-de5c-5236-b155-78a447eb8332" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+3)^{2}=64" :db/id #edb/ref 17592186338171} :answer-field/id #uuid "7718debd-009e-52ad-b486-a85853f1ee0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338482}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "81c6457c-f4fd-58e1-87c0-0244bbebd614" :question/math-academy-id "q-70898" :question/problem "![](images/88/887895a47cf6ce3a6f109f754ef0c46eecaa6d68763baf3a696008e014d231af.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $C(-2,-3)$ and the radius of the circle is $r=8.$ Therefore, the equation of the circle is\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-(-2))^{2}+(y-(-3))^{2} & ={8}^{2} \\\\ (x+2)^{2}+(y+3)^{2} & =64.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Equation of a Circle Given the Center and the Radius"}] [{:db/id #edb/ref 17592186087656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087464 :question/id #uuid "e2d2147e-98df-54df-a271-4c5dff362a96" :question/math-academy-id "e-3226" :question/problem "What is the center and radius of the circle with equation $(x-2)^2 + (y+4)^2 = 9?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^2 + (y-b)^2 = r^2.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-2)^{2}+(y+4)^{2} & =9 \\\\ (x-2)^{2}+(y-(-4))^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nWe see that $a = 2,$ $b = - 4,$ and $r = 3.$ \n\nTherefore, the circle is centered at $(2,-4)$ and its radius is $3.$"} :knowledge-point/id #uuid "89462485-2e28-5727-82c7-7afd0cac6d77" :knowledge-point/questions [{:db/id #edb/ref 17592186088311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0576cbfe-64f6-5bc3-a016-f311431b8cc7" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(2,3)$ and radius is $6$" :db/id #edb/ref 17592186342291} {:answer/id #uuid "2d02910a-922e-5c4c-b5fc-7dd9508107d6" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-2,-3)$ and radius is $6$" :db/id #edb/ref 17592186342614} {:answer/id #uuid "30c13b16-79f8-5389-b2ee-a0eb671325c0" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186342645} {:answer/id #uuid "bc241e1f-2741-5d91-8f59-ef85f94eac0e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-2,-3)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186343891} {:answer/id #uuid "c972847a-26b8-5b15-aa4d-ff0fb36da0a5" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(2,3)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186344005}] :answer-field/correct {:answer/id #uuid "c972847a-26b8-5b15-aa4d-ff0fb36da0a5" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(2,3)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186344005} :answer-field/id #uuid "89edcb63-a33b-5de5-ba63-aeca3edd3169" :answer-field/key "selection" :answer-field/type {:db/i