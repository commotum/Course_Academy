/math-academy-id "q-327852" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\sqrt{8-t},\\,y=\\sqrt{16-2t}+1,\\,t<8,\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $\\sqrt{8-t}>0$ for all $t<8.$ Consequently, the range of $x$ is\n\n$$\nx>0.\n$$\n\n- To find the range of $y,$ note that $\\sqrt{16-2t}+1>1$ for all $t<8.$ Consequently, the range of $y$ is\n\n$$\ny>1.\n$$"} {:db/id #edb/ref 17592186342036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "335d0d1c-7aa5-5e41-83dd-2bd696206902" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1,\\,y\\ge 10" :db/id #edb/ref 17592186339584} {:answer/id #uuid "45b4e8f6-0254-586e-8b2c-8ca34c9155e5" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 1,\\,y\\le 10" :db/id #edb/ref 17592186339747} {:answer/id #uuid "760a81e8-5ce1-5b78-9884-f109dafe3e65" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -1,\\,y\\ge -2" :db/id #edb/ref 17592186340179} {:answer/id #uuid "94d1ef80-cf3c-5620-bee7-53c5c5629fbb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1,\\,y\\le 10" :db/id #edb/ref 17592186340466} {:answer/id #uuid "e778c967-2eb3-5de6-8c75-2e13c5bc4346" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -1,\\,y\\ge -2" :db/id #edb/ref 17592186341172}] :answer-field/correct {:answer/id #uuid "335d0d1c-7aa5-5e41-83dd-2bd696206902" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1,\\,y\\ge 10" :db/id #edb/ref 17592186339584} :answer-field/id #uuid "043f62a1-3349-567c-aec9-24574a79034c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341390}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8f5b7d05-a282-5021-9aa5-8966b1c2524c" :question/math-academy-id "q-73623" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\sqrt{t-2}+1,\\,\\,\\,y={t}^{3}+2,\\,t\\ge 2,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $\\sqrt{t-2}\\ge 0$ for all $t\\ge 2.$ Consequently, $x=\\sqrt{t-2}+1\\ge 1.$\n\n- To find the range of $y,$ note that ${t}^{3}\\ge 8$ for all $t\\ge 2.$ Consequently, $y={t}^{3}+2\\ge 8+2=10.$\n\nTherefore, the ranges are $x\\ge 1$ and $y\\ge 10.$"} {:db/id #edb/ref 17592186400114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c848ce1a-65b8-563c-9fec-80599c592bcc" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -3,\\,y\\ge 2" :db/id #edb/ref 17592186400116} {:answer/id #uuid "7f194208-efc2-515c-a071-37d890d6515f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge -3" :db/id #edb/ref 17592186400117} {:answer/id #uuid "2b898a9d-7842-5e4a-9365-22c2934152ca" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge 3" :db/id #edb/ref 17592186400118} {:answer/id #uuid "8a1c0d33-169a-5055-a64e-c6a8e8656c1e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -1,\\,y\\ge 3" :db/id #edb/ref 17592186400119} {:answer/id #uuid "658dd7e1-62d5-534e-8c6f-6d03db279945" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 3,\\,y\\le -2" :db/id #edb/ref 17592186400120}] :answer-field/correct {:answer/id #uuid "2b898a9d-7842-5e4a-9365-22c2934152ca" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge 3" :db/id #edb/ref 17592186400118} :answer-field/id #uuid "acb683db-68cc-56c9-829b-45a54bf4f29a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400115}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3e9c6f6-566c-5162-9fe9-4d86fd16d1a4" :question/math-academy-id "q-123769" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3-t,\\,\\,\\,y=t+2,\\,t\\ge 1,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $3-t\\le 2$ for all $t\\ge 1.$ Consequently, $x=3-t\\le 2.$\n\n- To find the range of $y,$ note that $t+2\\ge 3$ for all $t\\ge 1.$ Consequently, $y=t+2\\ge 3.$\n\nTherefore, the ranges are $x\\le 2$ and $y\\ge 3.$"} {:db/id #edb/ref 17592186403675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9f73d83-c051-5dff-95b7-3c8c97c9edbb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge -1,\\,y\\ge 0" :db/id #edb/ref 17592186403677} {:answer/id #uuid "ad14150b-a7fa-5e1f-8e26-8118219d8796" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 0,\\,y\\le -4" :db/id #edb/ref 17592186403678} {:answer/id #uuid "aa0317e7-34d8-5e8a-a56c-876d04157a55" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 1,\\,y\\le -4" :db/id #edb/ref 17592186403679} {:answer/id #uuid "0117c445-1ef3-5ae6-aae5-46c6b2367762" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 4,\\,y\\ge 1" :db/id #edb/ref 17592186403680} {:answer/id #uuid "a9339c84-b774-56f5-95e7-f320ba73550e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge -4" :db/id #edb/ref 17592186403681}] :answer-field/correct {:answer/id #uuid "a9339c84-b774-56f5-95e7-f320ba73550e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge -4" :db/id #edb/ref 17592186403681} :answer-field/id #uuid "966a4be9-e62e-532a-b5f4-b29c14204104" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403676}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5fc2dccb-24dd-5003-b2b4-73d21d258e08" :question/math-academy-id "q-73617" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-t,\\,\\,\\,y={t}^{2}-4,\\,t\\ge -1,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $1-t\\le 2$ for all $t\\ge -1.$ Consequently, $x=1-t\\le 2.$\n\n- To find the range of $y,$ note that ${t}^{2}\\ge 0$ for all $t.$ Consequently, $y={t}^{2}-4\\ge -4.$\n\nTherefore, the ranges are $x\\le 2$ and $y\\ge -4.$"}] :knowledge-point/title "Determining the Range of a Parametric Equation"}] [{:db/id #edb/ref 17592186087736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087542 :question/id #uuid "25ab094c-a35e-5507-a6df-459361ff6fcd" :question/math-academy-id "e-5292" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx = 4\\cos\\theta, \\,\\,\\, y = 2\\sin\\theta, \\quad 0\\leq \\theta <     2\\pi,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\leq\\theta <  2\\pi,$ we have $-1 \\leq \\cos{\\theta} \\leq 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -4 & \\le 4\\operatorname{cos}⁡\\theta \\le 4 \\\\ -4 & \\le x\\le 4.\\end{aligned}\n$$\n\nSo, we can conclude that $-4 \\leq x \\leq 4.$\n\n- To find the range of $y,$ notice that for $0\\leq\\theta <  2\\pi,$ we have $-1 \\leq \\sin{\\theta} \\leq 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -2 & \\le 2\\operatorname{sin}⁡\\theta \\le 2 \\\\ -2 & \\le y\\le 2.\\end{aligned}\n$$\n\nSo, we can conclude that $-2 \\leq y \\leq 2.$\n\nTherefore, the ranges are $-4 \\leq x \\leq 4$ and $-2 \\leq y \\leq 2.$"} :knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049872 :topic/math-academy-id 2062 :topic/title "Properties of Transformed Sine and Cosine Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186088029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "399f8d43-8f84-5c44-94d4-0b0dd69e8268" :answer/type {:db/ident :answer.type/math} :answer/value "1\\le x\\le 1,\\,1\\le y\\le 1" :db/id #edb/ref 17592186279098} {:answer/id #uuid "4759a2f7-a933-59e3-957d-8ccee01e9143" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\le x\\le 3,\\,-7\\le y\\le 7" :db/id #edb/ref 17592186279231} {:answer/id #uuid "87d0badb-d995-50bf-b63f-47523b429a32" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\le x\\le 7,\\,-3\\le y\\le 3" :db/id #edb/ref 17592186279804} {:answer/id #uuid "ebd6c89c-69a3-5f3f-b152-dc3c96d08337" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x\\le 3,\\,0\\le y\\le 7" :db/id #edb/ref 17592186280666} {:answer/id #uuid "f95e3399-d4d4-5fb0-82b3-fbc31ee229f7" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x\\le 7,\\,0\\le y\\le 3" :db/id #edb/ref 17592186280782}] :answer-field/correct {:answer/id #uuid "87d0badb-d995-50bf-b63f-47523b429a32" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\le x\\le 7,\\,-3\\le y\\le 3" :db/id #edb/ref 17592186279804} :answer-field/id #uuid "7930e983-ef79-5ead-aefc-e8d03715f738" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281054}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "167fa292-246c-5f48-b5ed-5686c02c3004" :question/math-academy-id "q-16201" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=7\\operatorname{cos}⁡\\theta ,\\,\\,\\,y=3\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -7 & \\le 7\\operatorname{cos}⁡\\theta \\le 7 \\\\ -7 & \\le x\\le 7.\\end{aligned}\n$$\n\nSo, we can conclude that $-7\\le x\\le 7.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -3 & \\le 3\\operatorname{sin}⁡\\theta \\le 3 \\\\ -3 & \\le y\\le 3.\\end{aligned}\n$$\n\nSo, we can conclude that $-3\\le y\\le 3.$\n\nTherefore, the ranges are $-7\\le x\\le 7$ and $-3\\le y\\le 3.$"} {:db/id #edb/ref 17592186088281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86dadee3-7d6d-5185-ab3b-b85a361a52e3" :answer/type {:db/ident :answer.type/math} :answer/value "0 \\le x \\le 4, 2 \\le y \\le 4" :db/id #edb/ref 17592186086341} {:answer/id #uuid "d5399094-f398-56ed-9f79-a44406253676" :answer/type {:db/ident :answer.type/math} :answer/value "-4 \\le x \\le - 2,-4 \\le y \\le 0" :db/id #edb/ref 17592186086342} {:answer/id #uuid "45d78f20-324c-515d-a7d7-5a8cca623062" :answer/type {:db/ident :answer.type/math} :answer/value "-4 \\le x \\le 0,-2 \\le y \\le 4" :db/id #edb/ref 17592186086343} {:answer/id #uuid "49999e5c-859b-52f5-9853-47952d52774d" :answer/type {:db/ident :answer.type/math} :answer/value "-4 \\le x \\le 2, 0 \\le y \\le 4" :db/id #edb/ref 17592186086344} {:answer/id #uuid "6f7a3f21-dc25-5a43-bc94-3ffe87b345a9" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\le x \\le 4, 0 \\le y \\le 4" :db/id #edb/ref 17592186086345}] :answer-field/id #uuid "5333b62b-8f5a-5314-ac5f-0d3282feeb1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086340}] :question/id #uuid "355799f7-9ac6-525e-ab74-a660990999e5" :question/math-academy-id "q-70341" :question/problem "Given that a curve is defined parametrically as\n$x = 3\\cos θ - 1, y = 2\\sin θ + 2, 0 \\le θ < 2π$,\nwhat are the ranges of $x$ and $y$?"} {:db/id #edb/ref 17592186233713 :question/answer-field