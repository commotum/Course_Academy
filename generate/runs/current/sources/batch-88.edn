d}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ 5 & \\text{ }\\ge -5\\operatorname{sin}⁡\\theta \\text{ }\\ge -5 \\\\ -5 & \\le -5\\operatorname{sin}⁡\\theta \\le 5 \\\\ -5 & \\le y\\le 5.\\end{aligned}\n$$\n\nSo, we can conclude that $-5\\le y\\le 5.$"} {:db/id #edb/ref 17592186302364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44d09dea-aace-573a-a9c0-aba161ed95be" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186300305}] :answer-field/correct {:answer/id #uuid "44d09dea-aace-573a-a9c0-aba161ed95be" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186300305} :answer-field/id #uuid "2a7e8232-4ea7-50da-a729-8ae332ab2b56" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301361} {:answer-field/choices [{:answer/id #uuid "67a265f0-04cb-52e1-9228-78c09deadd1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186300483}] :answer-field/correct {:answer/id #uuid "67a265f0-04cb-52e1-9228-78c09deadd1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\le " :db/id #edb/ref 17592186300483} :answer-field/id #uuid "409be484-6063-58b7-a05a-f2fdc00614c3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301443} {:answer-field/choices [{:answer/id #uuid "0f4feec6-f58b-5688-be02-649cde464b11" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300021}] :answer-field/correct {:answer/id #uuid "0f4feec6-f58b-5688-be02-649cde464b11" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186300021} :answer-field/id #uuid "4e8f8b3d-430d-56b6-8191-d86f99809ba0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301483} {:answer-field/choices [{:answer/id #uuid "dd85e24d-182c-5f16-8f66-d77e2d0e26ce" :answer/ty