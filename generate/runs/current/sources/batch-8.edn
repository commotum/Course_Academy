211cd-01a7-542a-b47e-d75d6a3097fa" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333762} :answer-field/id #uuid "86f8ba01-fc2b-52fd-b820-3b99058407b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335497}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "38bf6e1d-10b4-5dc1-a968-36547cdb03b4" :question/math-academy-id "q-65243" :question/problem "Simplify the trigonometric expression ${sin}^{2}⁡x{cos}^{2}⁡x+{cos}^{4}⁡x+{sin}^{2}⁡x.$" :question/worked-solution "First, we factor ${cos}^{2}⁡x$  from the first two terms:\n\n$$\n{sin}^{2}⁡x{cos}^{2}⁡x+{cos}^{4}⁡x+{sin}^{2}⁡x={cos}^{2}⁡x\\cdot ({sin}^{2}⁡x+{cos}^{2}⁡x)+{sin}^{2}⁡x\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the given expression:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x\\cdot ({sin}^{2}⁡x+{cos}^{2}⁡x)+{sin}^{2}⁡x & ={cos}^{2}⁡x\\cdot 1+{sin}^{2}⁡x \\\\  & ={cos}^{2}⁡x+{sin}^{2}⁡x \\\\  & =1\\end{aligned}\n$$\n\nWe conclude that\n\n$$\n{sin}^{2}⁡x{cos}^{2}⁡x+{cos}^{4}⁡x+{sin}^{2}⁡x=1.\n$$"} {:db/id #edb/ref 17592186341845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733d9013-5828-5e8a-a6ca-98d0ee84db3d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340151} {:answer/id #uuid "9e08cb06-fa94-559a-b45f-0247593ae993" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340553} {:answer/id #uuid "ce427bad-7fbf-553d-94e7-4eac1f2a458e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340960} {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} {:answer/id #uuid "ddb559b7-bf25-5a4d-8461-b1784d7b4dd7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341097}] :answer-field/correct {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} :answer-field/id #uuid "7c77d87a-34f1-5f64-8f04-06a22766d6be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341597}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5b1e203a-fce6-56f0-bd3a-5a969f3f611d" :question/math-academy-id "q-72711" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x.$" :question/worked-solution "First, we factor the expression:\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x) & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x.\n$$"}] :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] [{:db/id #edb/ref 17592186059642 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059470 :question/id #uuid "f2b7e482-2bcd-5bd2-91ee-66415b375da4" :question/math-academy-id "e-3137" :question/problem "Simplify the trigonometric expression $\\dfrac {\\cos \\theta \\sin^2 \\theta + \\cos^3 \\theta}{\\sin\\theta}.$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\dfrac {\\cos \\theta \\sin^2 \\theta + \\cos^3 \\theta} {\\sin \\theta}\t=\t\\dfrac {\\cos \\theta \\cdot (\\sin^2 \\theta + \\cos^2 \\theta)} {\\sin \\theta}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}{\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{cos}⁡\\theta \\cdot (1)}{\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\dfrac {\\cos \\theta \\sin^2 \\theta + \\cos^3 \\theta} {\\sin \\theta} = \\cot \\theta.\n$$"} :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049181 :topic/math-academy-id 423 :topic/title "Simplifying Rational Expressions by Factoring"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "907031aa-def2-5346-b05d-e1bb6356bb7c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\tan θ - 1" :db/id #edb/ref 17592186058693} {:answer/id #uuid "a08fa882-3190-566d-b2f4-0ed8fd4b937a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\tan θ" :db/id #edb/ref 17592186058694} {:answer/id #uuid "a0aee8d5-2045-56ab-bd31-028c9587b3f5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\tan θ" :db/id #edb/ref 17592186058695} {:answer/id #uuid "c4abf770-24eb-5c59-8f09-2d0539b74806" :answer/type {:db/ident :answer.type/math} :answer/value "\\tan θ + 1" :db/id #edb/ref 17592186058696} {:answer/id #uuid "fc69524c-9e1a-5654-8df5-824a0099f555" :answer/type {:db/ident :answer.type/math} :answer/value "\\tan θ" :db/id #edb/ref 17592186058697}] :answer-field/id #uuid "f498156a-db3c-53cc-b241-93d5d1f06fd6" 