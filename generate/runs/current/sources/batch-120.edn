+ 1}dt" :db/id #edb/ref 17592186091159} {:answer/id #uuid "2fde0d28-04a8-5bdc-956f-de766ab86529" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-3}^{2}\\sqrt{t^{4} - t^{2} + 2t + 2}dt" :db/id #edb/ref 17592186091160} {:answer/id #uuid "57d3f5ba-4367-5524-a843-57e49b68ed77" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{-3}^{2}\\sqrt{t^{2} + 2t + 2}dt" :db/id #edb/ref 17592186091161}] :answer-field/id #uuid "c7484595-bd71-5a88-ac55-560af2ce4f19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091156}] :question/id #uuid "767ca9bf-bda6-519c-b045-66d55d563e0c" :question/math-academy-id "q-81437" :question/problem "![](images/2c/2c96a0fc119984b83ba68a0cfc50540563a3ea76cc887d3e184238250773e91b.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x = t^{2} + 2t + 1, y = \\frac{2}{3}t^{3} - 2t$\nfrom $t =-3$ to $t = 2$ (shown above)?"} {:db/id #edb/ref 17592186256770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1691c723-a29f-5657-aee7-eec47906ae55" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-2}^{3}\\sqrt{8{t}^{6}+9{t}^{4}+20{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186253864} {:answer/id #uuid "52ebc669-036d-52bd-bd42-f8a9effb2d03" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{3}\\sqrt{{t}^{6}+{t}^{4}+{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186254393} {:answer/id #uuid "aea928a3-cf09-5314-9b87-9ec1f92f214b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186255207} {:answer/id #uuid "b39d0d7c-49b9-5298-8296-ac358a89bec4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{4{t}^{6}+3{t}^{4}+4{t}^{3}+5}\\,\\text{d}t" :db/id #edb/ref 17592186255251} {:answer/id #uuid "ff64285b-3a4e-5ddc-aa99-b508b397f090" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+49{t}^{4}+25}\\,\\text{d}t" :db/id #edb/ref 17592186255918}] :answer-field/correct {:answer/id #uuid "aea928a3-cf09-5314-9b87-9ec1f92f214b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t" :db/id #edb/ref 17592186255207} :answer-field/id #uuid "2ac33bf7-e329-5540-9b40-ace253188539" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255997}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1ac06717-3d6e-5cb8-bb53-88e2680a811e" :question/math-academy-id "q-123005" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-8,\\,y={t}^{4}+5t$\nfrom $t=-2$ to $t=3$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-8)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}+5t)=4{t}^{3}+5\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{{(3{t}^{2})}^{2}+{(4{t}^{3}+5)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{9{t}^{4}+16{t}^{6}+40{t}^{3}+25}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256771 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "070a4318-5841-5f5c-8d72-6fb59872fc0e" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{18{t}^{2}-12}\\,\\text{d}t" :db/id #edb/ref 17592186253722} {:answer/id #uuid "17d49195-6be3-5ce7-aa2a-921578f62915" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t" :db/id #edb/ref 17592186253877} {:answer/id #uuid "3741fd0d-810d-5265-b32c-6114a62fde8f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{6{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186254148} {:answer/id #uuid "4cd7ccb4-e388-5676-9be3-2b14b685baf5" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{1}\\sqrt{36{t}^{2}+5t}\\,\\text{d}t" :db/id #edb/ref 17592186254331} {:answer/id #uuid "528db892-4fe7-531e-81df-1965b9853c97" :answer/type {:db/ident :answer.type/math} :answer/value "5{\\int }_{0}^{1}\\sqrt{{t}^{2}+5}\\,\\text{d}t" :db/id #edb/ref 17592186254391}] :answer-field/correct {:answer/id #uuid "17d49195-6be3-5ce7-aa2a-921578f62915" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t" :db/id #edb/ref 17592186253877} :answer-field/id #uuid "c9c515a7-5b1f-551b-a793-9f6e12bfd819" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256279}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a6c68291-2bb7-56b1-a306-1312ff237a63" :question/math-academy-id "q-123019" :question/problem "![](images/0a/0a58808ee9b20e201d1ea8a31683f742e02f739127640de2fea87ce4757e7901.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{2},\\,y=5t$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5t)=5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(6t)^{2}+(5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2107bda6-d473-50dd-ba60-ad2a320b0aed" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-1}^{2}\\sqrt{27{t}^{4}+4{t}^{2}-t+6}\\,\\text{d}t" :db/id #edb/ref 17592186253962} {:answer/id #uuid "3421b0d5-8f17-526e-9dba-9537c508fcc2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{9{t}^{4}+4{t}^{2}-20t+5}\\,\\text{d}t" :db/id #edb/ref 17592186254121} {:answer/id #uuid "6c853f8d-b33e-5895-ba0b-c7a9e2102da5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{85{t}^{4}-20t+25}\\,\\text{d}t" :db/id #edb/ref 17592186254634} {:answer/id #uuid "8799eb05-fe1e-5cc8-b350-130c501b0286" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{2}\\sqrt{9{t}^{4}+{t}^{2}-5t+6}\\,\\text{d}t" :db/id #edb/ref 17592186254873} {:answer/id #uuid "d79fac35-f1e8-5450-97f3-86f17fbbb483" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t" :db/id #edb/ref 17592186255579}] :answer-field/correct {:answer/id #uuid "d79fac35-f1e8-5450-97f3-86f17fbbb483" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t" :db/id #edb/ref 17592186255579} :answer-field/id #uuid "132e3016-73cb-5474-ae06-aa55eeff7889" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255950}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a0cda492-f891-5b24-90a6-900da47a3f8d" :question/math-academy-id "q-123025" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{3}+5,\\,y={t}^{2}-5t$\nfrom $t=-1$ to $t=2$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+5)=9{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-5t)=2t-5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{(9{t}^{2})^{2}+(2t-5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40667602-c7d2-52f3-b515-00979eaf90c3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{4+t+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349032} {:answer/id #uuid "514b71c4-dc4b-550b-a85a-0e54a3f5b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{4+4t+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349185} {:answer/id #uuid "5898362e-f963-559f-b809-786b12c62c78" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4t+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349260} {:answer/id #uuid "784441b4-8a2c-50a3-b06e-746d478ecd7a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{t+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186349554} {:answer/id #uuid "caa71d58-f8d1-5f06-9145-4ddcc7adf731" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186350231}] :answer-field/correct {:answer/id #uuid "caa71d58-f8d1-5f06-9145-4ddcc7adf731" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186350231} :answer-field/id #uuid "7706adee-7a3b-5175-ab48-f3203b4530f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350913}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cc4af2ef-5b85-5a46-b1fb-ff4ea6d0758d" :question/math-academy-id "q-81377" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t-1,\\,y={t}^{2}+2$\nfrom $t=-1$ to $t=2$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-1)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+2)=2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{{(1)}^{2}+{(2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{1+4{t}^{2}}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186351300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173b2b5c-5428-506b-9f15-da54e1e7da07" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+3}\\,\\text{d}t" :db/id #edb/ref 17592186348641} {:answer/id #uuid "1af0386f-90d9-5a79-afed-aa45754d349a" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186348677} {:answer/id #uuid "1ce5f7a3-81c2-5b76-a5e7-4963090954d7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186348699} {:answer/id #uuid "2c69be06-5fa9-5750-ba1a-4f53458bc229" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{2}+3}\\,\\text{d}t" :db/id #edb/ref 17592186348835} {:answer/id #uuid "d64b585a-e82a-5026-900a-c28a246b6b6b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186350328}] :answer-field/correct {:answer/id #uuid "1ce5f7a3-81c2-5b76-a5e7-4963090954d7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186348699} :answer-field/id #uuid "b11f3cba-eadf-5d36-86ff-2f0552d4e5e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351010}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f078660-763f-536d-9faf-52311fdcfddf" :question/math-academy-id "q-81380" :question/problem "![](images/12/120220c7c1a24c68c1a9282548efcf62c34fd110bd11911799a2a83409f257ab.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+1,\\,y=3t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+1)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3t)=3.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(3)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+9}\\,\\text{d}t \\\\  & =3{\\int }_{-2}^{0}\\sqrt{{t}^{4}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186394703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e2720b5-b7ef-506c-86d6-fa144d1dbad3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+2{t}^{2}-2t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394705} {:answer/id #uuid "962d9602-db26-5929-a1c1-0bd2caac4e94" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{3{t}^{2}+2t-1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394706} {:answer/id #uuid "2589a138-5496-5db8-b982-4b36bc678287" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{{t}^{2}-12t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394707} {:answer/id #uuid "d18f1c16-5f34-5e7a-96c8-21d14e6ab156" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{3{t}^{4}+4{t}^{2}-2t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394708} {:answer/id #uuid "1ee3240f-fc29-5617-8390-178d04eee2ef" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394709}] :answer-field/correct {:answer/id #uuid "1ee3240f-fc29-5617-8390-178d04eee2ef" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t\\," :db/id #edb/ref 17592186394709} :answer-field/id #uuid "f248aef5-8be7-5408-8afd-4afcb3aba568" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394704}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "77ecc403-c204-532a-a0f9-e871a850287a" :question/math-academy-id "q-85724" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-1,\\,y={t}^{2}-t$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)=2t-1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(3{t}^{2})^{2}+(2t-1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+4{t}^{2}-4t+1}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71b63c40-4166-58be-98ca-c4f5edc13748" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+t}\\,\\text{d}t" :db/id #edb/ref 17592186400074} {:answer/id #uuid "e8a8ab40-ccbb-5118-b2d9-f78348093f93" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186400075} {:answer/id #uuid "b749b256-812c-5226-8d12-e7a772eb2ad5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+3}\\,\\text{d}t" :db/id #edb/ref 17592186400076} {:answer/id #uuid "c9a93f8e-9a44-5007-89a0-efaebde7602c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+2}\\,\\text{d}t" :db/id #edb/ref 17592186400077} {:answer/id #uuid "bded8aee-c9b6-50a7-9080-88cf30b26b0a" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/id #edb/ref 17592186400078}] :answer-field/correct {:answer/id #uuid "e8a8ab40-ccbb-5118-b2d9-f78348093f93" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/id #edb/ref 17592186400075} :answer-field/id #uuid "d769d84c-e8c5-56e0-8e28-ef7348f0bb6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ce632c36-0a89-59ca-a425-8c378bad7972" :question/math-academy-id "q-123020" :question/problem "![](images/ae/ae210abc4028440aa9c822510d68f0ab0b8ba4b9f5806dd299149e953ccd1b21.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-4,\\,y=2t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2t)=2.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(2)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "925080f9-1488-5ed3-9988-57bac8e25aa1" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+2t+4}\\,\\text{d}t" :db/id #edb/ref 17592186401036} {:answer/id #uuid "8b14ae74-d72b-5c6f-bfb4-9fdf19b4b592" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{9{t}^{2}+4}\\,\\text{d}t" :db/id #edb/ref 17592186401037} {:answer/id #uuid "c911c453-c1b3-506d-a7de-c8341e32d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/id #edb/ref 17592186401038} {:answer/id #uuid "69aeb839-370f-503b-8dde-d870cf822808" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}t\\sqrt{3{t}^{2}+2}\\,\\text{d}t" :db/id #edb/ref 17592186401039} {:answer/id #uuid "e1915447-2ced-5598-8af5-d918f3a8a810" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+24t+8}\\,\\text{d}t" :db/id #edb/ref 17592186401040}] :answer-field/correct {:answer/id #uuid "c911c453-c1b3-506d-a7de-c8341e32d5e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t" :db/id #edb/ref 17592186401038} :answer-field/id #uuid "9ac60323-fbe0-5435-bfb2-619a71c7a175" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dddf8a10-d360-5144-aae4-5bd6e2bd6915" :question/math-academy-id "q-15174" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+{t}^{2},\\,y={t}^{3}-{t}^{2}$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})=3{t}^{2}+2t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})=3{t}^{2}-2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(3{t}^{2}+2t)}^{2}+{(3{t}^{2}-2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+12{t}^{3}+4{t}^{2}+9{t}^{4}-12{t}^{3}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{18{t}^{4}+8{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve"}] [{:db/id #edb/ref 17592186092376 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092113 :question/id #uuid "5bae6269-2112-56ea-b123-bee58701cf87" :question/math-academy-id "e-7130" :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](images/48/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(\\operatorname{cos}⁡t))=-\\operatorname{tan}⁡t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(1)}^{2}+{(-\\operatorname{tan}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+{tan}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{sec}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡t\\,\\text{d}t\\,.\\end{aligned}\n$$"} :knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048191 :topic/math-academy-id 1115 :topic/title "Selecting Procedures for Calculating Derivatives"} {:db/id #edb/ref 17592186049488 :topic/math-academy-id 207 :topic/title "Simplifying Expressions Using the Pythagorean Identity"}] :knowledge-point/questions [{:db/id #edb/ref 17592186092573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac7208bd-8759-509f-aec8-b72d63dc377b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{2\\sin^{2} (4t) + \\cos^{2} (t)}dt" :db/id #edb/ref 17592186089610} {:answer/id #uuid "c8e4a462-def2-5041-9d86-629d00d6c6f1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2}\\sqrt{\\sin^{2} (4t) + \\cos^{2} (t)}dt" :db/id #edb/ref 17592186089611} {:answer/id #uuid "e3499abe-efbf-509e-ba00-61325a39091c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{2\\cos^{2} (4t) + \\sin^{2} (t)}dt" :db/id #edb/ref 17592186089612} {:answer/id #uuid "e87d0171-bd01-58f1-a2a4-2a22124be105" :answer/type {:db/ident :answer.type/math} :answer/value "4\\displaystyle \\int_{0}^{2}\\sqrt{\\cos^{2} (4t) + \\sin^{2} (t)}dt" :db/id #edb/ref 17592186089613} {:answer/id #uuid "3bf170f4-362e-577e-893f-a65fc8d4acae" :answer/type {:db/ident :answer.type/math} :answer/value "2\\displaystyle \\int_{0}^{2}\\sqrt{\\cos^{2} (4t) + 2\\sin^{2} (t)}dt" :db/id #edb/ref 17592186089614}] :answer-field/id #uuid "13fc5e26-b2f3-5efb-bf53-9cf5f0c83d92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089609}] :question/id #uuid "2ac73185-5f28-5b9e-aeb9-15f1142ceee2" :question/math-academy-id "q-15155" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x = 1 + \\sin (4t), y = 4\\cos (t)$\nfrom $t = 0$ to $t = 2$?"} {:db/id #edb/ref 17592186092575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c02db39-1323-5178-823d-035cbc0e974b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273319} {:answer/id #uuid "76f538de-df54-5fad-9a26-4e6bcab7eb7a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273399} {:answer/id #uuid "7f93ecb1-ea78-5b92-86af-7eaf211452f3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273483} {:answer/id #uuid "a4a2a416-fa2b-57e0-ae21-9414bcd449ab" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{cos}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273807} {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472}] :answer-field/correct {:answer/id #uuid "ebffd150-b312-515d-a26e-013ddad9564b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186274472} :answer-field/id #uuid "8d36b979-5ca7-502e-b3f6-581c418d1ffe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d674e5dc-8a57-5368-b53e-8363dba234a5" :question/math-academy-id "q-15185" :question/problem "![](images/80/80577a585741748702b61596db84983592ecbc6c01fca78af033bf82dbe62ad2.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y={e}^{t}\\operatorname{sin}⁡t$\nfrom $t=-3$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)={e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}\\sqrt{{e}^{2t}+{e}^{2t}{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{1+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f016b0-2fd0-50db-a608-6fb63624e44f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+8\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186272994} {:answer/id #uuid "69d385f0-e607-521b-a6d5-ff44ee22ff0c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+16{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273301} {:answer/id #uuid "7e8a87c9-2f3a-5822-a579-01d6eb0bbb36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273473} {:answer/id #uuid "8df9ee48-5fdc-55b9-9efb-127f8dd6bac9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273611} {:answer/id #uuid "ad71957f-f727-5cbc-9851-57e268064b02" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+2\\operatorname{cos}⁡(t)+2{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273883}] :answer-field/correct {:answer/id #uuid "7e8a87c9-2f3a-5822-a579-01d6eb0bbb36" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186273473} :answer-field/id #uuid "18bf7715-0000-5c6a-ac8b-11821a5550c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274679}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b418c2bf-fd1a-57e4-845f-5c5fb4e1bb93" :question/math-academy-id "q-15163" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=t+2\\operatorname{sin}⁡(t),\\,y=1+\\operatorname{cos}⁡(2t)$\nfrom $t=2$ to $t=5$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t+2\\operatorname{sin}⁡(t))=1+2\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{(1+2\\operatorname{cos}⁡(t))^{2}+(-2\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{2}^{5}\\sqrt{1+4\\operatorname{cos}⁡(t)+4{cos}^{2}⁡(t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186288018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042ce01d-341b-5a8f-b26c-2bae1091ffbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{2{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186284821} {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} {:answer/id #uuid "2277789f-926a-5240-a07d-b7aedc65a771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186285096} {:answer/id #uuid "ca8848d4-7288-585c-b944-73aa40d45c9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{{e}^{t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186286635} {:answer/id #uuid "d0070ef7-3de9-5565-a190-4c165235a08f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186286682}] :answer-field/correct {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} :answer-field/id #uuid "d0b9c64d-9e93-55fe-a0fb-bcc5981e0b91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287575}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "809a8d30-1507-55ed-ad1d-5fa778afd784" :question/math-academy-id "q-20909" :question/problem "![](images/59/59704c6b8e643337113ab99b22eaeaac8d59ac3c15042409e8a0a8eac6ee54fd.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\frac{t}{2},\\,y={e}^{t}$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\nWe have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(\\frac{1}{2})}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{({e}^{2t})+(\\frac{1}{4})}\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290298 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1008f91c-5312-57ff-b584-94eee41fe74d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)-2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288152} {:answer/id #uuid "1da60212-9b1b-5f90-b4ad-60a5d028fa99" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)-4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288219} {:answer/id #uuid "2d0f56b4-96f6-5e10-b8c1-e96fcb0adb3d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)+2{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186288328} {:answer/id #uuid "c400b002-970a-5f9c-b980-7c4fcc67cff4" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(3t)+{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289327} {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641}] :answer-field/correct {:answer/id #uuid "f3b052e5-81af-5157-9a69-881e064e72dd" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t" :db/id #edb/ref 17592186289641} :answer-field/id #uuid "92070a66-23e2-56dd-9cc9-c4b8a5e22afc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290057}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6e26edb-f404-57aa-9e8d-fef8eb7ecc78" :question/math-academy-id "q-21339" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=2\\operatorname{sin}⁡(3t)-1,\\,y=2\\operatorname{cos}⁡(2t)+2$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡(3t)-1) \\\\  & =2\\operatorname{cos}⁡(3t)\\cdot 3 \\\\  & =6\\operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)+2) \\\\  & =-2\\operatorname{sin}⁡(2t)\\cdot 2 \\\\  & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(6\\operatorname{cos}⁡(3t))^{2}+(-4\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{2}⁡(3t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290299 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d3de1db-0fcc-5d54-a34d-c4772f63450c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288331} {:answer/id #uuid "4d6783bc-60cb-5ebf-aed7-e258b2417e6c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{16{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288571} {:answer/id #uuid "72dafc8f-1319-50ac-8575-b91418fddf5c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288830} {:answer/id #uuid "7dd6ac01-4a42-5fe6-a775-9f769a7e8298" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288884} {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967}] :answer-field/correct {:answer/id #uuid "8bef632c-9e9e-5375-8c17-7ff1526dfe34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186288967} :answer-field/id #uuid "3cb71b35-5d29-5e3f-a2c7-defaa9483e1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289861}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "97f4a57c-d78d-5eaa-81d0-22dc3ac7dd99" :question/math-academy-id "q-21347" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{sin}⁡(3t)$\nfrom $t=\\frac{\\pi }{4}$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))=3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{(2\\operatorname{cos}⁡(2t))^{2}+(3\\operatorname{cos}⁡(3t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290300 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69475fb9-4639-5aee-af40-ad859a263a2c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186288774} {:answer/id #uuid "91284f31-5e28-57a6-85bb-2b392b818d21" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289008} {:answer/id #uuid "a96e4ea4-d995-5d4a-b26e-2d37c11a1916" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289155} {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} {:answer/id #uuid "ef891aab-5620-5243-8798-2c0bd3ae8835" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(t)-{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289612}] :answer-field/correct {:answer/id #uuid "ac501491-2831-575c-ac89-af59b5aa9473" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186289176} :answer-field/id #uuid "0e6962ab-6088-50b4-b289-81a33c131c7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289765}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1524414a-eeb0-5a99-93da-15745003f6ea" :question/math-academy-id "q-21354" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t),\\,y=t-\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{4}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t))=\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡(t))=1-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t))^{2}+(1-\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)+2\\operatorname{cos}⁡(t)\\operatorname{sin}⁡(t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95a19ab2-d61e-5cd4-9296-0ccc2a2ce9cc" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{5{sin}^{2}⁡t-8\\operatorname{sin}⁡t+32}\\,\\text{d}t" :db/id #edb/ref 17592186400081} {:answer/id #uuid "6f516eb5-80db-56b9-88c4-8fec44175002" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t-8\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400082} {:answer/id #uuid "d04936f6-e3a3-5955-87a3-ae992e7c288a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400083} {:answer/id #uuid "25a5d7fc-f3f7-50d4-9122-01398e9fb385" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{8{sin}^{2}⁡t-2\\operatorname{sin}⁡t+8}\\,\\text{d}t" :db/id #edb/ref 17592186400084} {:answer/id #uuid "4e16c553-ec8a-5568-b27c-e4f4689e3032" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400085}] :answer-field/correct {:answer/id #uuid "4e16c553-ec8a-5568-b27c-e4f4689e3032" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" :db/id #edb/ref 17592186400085} :answer-field/id #uuid "51bd27ca-b51f-55c8-a2b1-03c787e77a4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400080}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a37e6009-e864-56bc-93ae-b166a2b05514" :question/math-academy-id "q-123027" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=3\\operatorname{cos}⁡t,\\,y=8t+\\operatorname{cos}⁡t$\nfrom $t=-1$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8t+\\operatorname{cos}⁡t)=8-\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(8-\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t+64-16\\operatorname{sin}⁡t+{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221b2a78-3ed9-5fcc-a904-b72ed2d8cda6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(5t)+36\\operatorname{cos}⁡(6t)}\\,\\text{d}t" :db/id #edb/ref 17592186400088} {:answer/id #uuid "2037ceca-da9b-5e6c-99af-f9e9635c71f9" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}\\sqrt{5{sin}^{2}⁡(5t)+6{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400089} {:answer/id #uuid "f6282b39-25dd-527c-8c08-c5ccbd4d5888" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{10{sin}^{2}⁡(5t)+12{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400090} {:answer/id #uuid "3954ccd4-113c-522e-8865-af8dedf5924f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400091} {:answer/id #uuid "5f536300-dcae-55c0-9423-568faa002b3a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400092}] :answer-field/correct {:answer/id #uuid "5f536300-dcae-55c0-9423-568faa002b3a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186400092} :answer-field/id #uuid "065d677c-9998-56e4-8b57-ce841d04bf36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400087}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30eadd5a-469c-54ec-b683-aec3a996fde4" :question/math-academy-id "q-123030" :question/problem "![](images/88/8868658c9bc7195f435a0109fce26b8a4fa39324c0a9a39e3fb644c5f02cdc9b.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(5t),\\,y=6\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(5t))=-5\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡(t))=6\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-5\\operatorname{sin}⁡(5t))^{2}+(6\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b85309c-59d7-5810-84c4-7ea68f827ebf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{3{sin}^{2}⁡t+2{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186401043} {:answer/id #uuid "cdd04e4b-26ba-5e0d-9091-43c5f06e6bd8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}(3\\operatorname{sin}⁡t+2\\operatorname{cos}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186401044} {:answer/id #uuid "eb350998-6cb3-5e21-b128-0e21ffcf76a2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t+4{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186401045} {:answer/id #uuid "9f297950-b005-5b22-b845-7190b859cf3c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{4{sin}^{2}⁡t+9{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186401046} {:answer/id #uuid "a99448ba-c640-5e57-a298-7dcd50a71e96" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}(9{sin}^{2}⁡t+4{cos}^{2}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186401047}] :answer-field/correct {:answer/id #uuid "eb350998-6cb3-5e21-b128-0e21ffcf76a2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t+4{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186401045} :answer-field/id #uuid "9286f2bc-6874-57c4-a822-f4b4566f80e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401042}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9a2f2890-829e-5660-aa0e-71dea52c1f55" :question/math-academy-id "q-15178" :question/problem "![](images/ca/ca290e8fd51edddf4381ec267b8e0a5692d0e52bd2a36b7d43ab89cbeb5cf00d.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=3\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-3\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t+4{cos}^{2}⁡t}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41c46a2e-4e00-5991-99c9-9dc68c9a9598" :answer/type {:db/ident :answer.type/math} :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401050} {:answer/id #uuid "2499ce46-f979-5a96-92be-fd0c7ac31bf7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401051} {:answer/id #uuid "61eb1149-6ab5-5e3a-8377-404854e1b082" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{2{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401052} {:answer/id #uuid "7ed903c6-dd0e-5b89-95d6-7cb6b868a842" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{3{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186401053} {:answer/id #uuid "d4b764bb-1a8d-5c44-bf30-3132c5443550" :answer/type {:db/ident :answer.type/math} :answer/value "9{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(t)+{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/id #edb/ref 17592186401054}] :answer-field/correct {:answer/id #uuid "2499ce46-f979-5a96-92be-fd0c7ac31bf7" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t" :db/id #edb/ref 17592186401051} :answer-field/id #uuid "d340f787-388c-5296-b3a4-86e39060db0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401049}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "243b404d-a4f2-57e8-bc56-d916439edf0e" :question/math-academy-id "q-15182" :question/problem "![](images/d6/d683c3960705fa32d11826008a9844c51c8e59e38f5158fce7f4e44c31b97ca9.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(3t),\\,y=3\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(3t))=-3\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡(t))=3\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-3\\operatorname{sin}⁡(3t))^{2}+(3\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡(3t)+9{cos}^{2}⁡(t)}\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\sqrt{{sin}^{2}⁡(3t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186401866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a58988e-9e60-53e1-9ccc-6195ac2bdc85" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}-1}\\,\\text{d}t" :db/id #edb/ref 17592186401868} {:answer/id #uuid "c4824b8b-2ed7-5c3c-ae44-9e7e39c2adaa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186401869} {:answer/id #uuid "8e755153-eb7c-5c80-ac13-6bd2f55ebc06" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}-1}\\,\\text{d}t" :db/id #edb/ref 17592186401870} {:answer/id #uuid "8dadc22b-b156-5944-b045-f3c498f81787" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186401871} {:answer/id #uuid "89771be0-5923-5fe1-8923-30d66256f236" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186401872}] :answer-field/correct {:answer/id #uuid "89771be0-5923-5fe1-8923-30d66256f236" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186401872} :answer-field/id #uuid "f3d97d84-3165-5293-95f8-8ad9ae1b81ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401867}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a60afb71-a1f2-5589-86e8-84aaf38f221a" :question/math-academy-id "q-21353" :question/problem "![](images/4a/4aa2bca8faab077c47fb968882579233babe7d323ba3120088e8ea5599fbd570.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y=t$\nfrom $t=0$ to $t=2$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{({e}^{t})^{2}+(1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve Containing Special Functions"}] [{:db/id #edb/ref 17592186092377 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092082 :question/id #uuid "86835544-a7f1-5be2-99c1-14e39a14f3fd" :question/math-academy-id "e-603" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=e^t(\\cos{t}+\\sin{t}), \\quad y=e^t(\\cos{t}-\\sin{t}) , \\quad t\\in \\left[0,\\dfrac{\\pi}{4}\\right].\n$$\n\n![](images/15/15d185178bf8882f837c19361d630c0e537e145ca2337cad4655677255d0348a.png)" :question/worked-solution "Computing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\  & =2{e}^{t}\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\  & =-2{e}^{t}\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(2{e}^{t}\\operatorname{cos}⁡t)}^{2}+{(-2{e}^{t}\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{4{e}^{2t}({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}2{e}^{t}\\,\\text{d}t \\\\  & =2{e}^{t}{|}_{0}^{\\pi /4} \\\\  & =2({e}^{\\pi /4}-1).\\end{aligned}\n$$"} :knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048717 :topic/math-academy-id 1037 :topic/title "Integration Using the Pythagorean Identities"} {:db/id #edb/ref 17592186049303 :topic/math-academy-id 1038 :topic/title "Integration Using the Double-Angle Formulas"} {:db/id #edb/ref 17592186050489 :topic/math-academy-id 478 :topic/title "Integrating Trigonometric Functions Using Substitution"}] :knowledge-point/questions [{:db/id #edb/ref 17592186092471 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60627aba-89ef-53b6-b4ce-ca7854856bfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186236430} {:answer/id #uuid "70edbcb1-0834-5f95-9e7a-268c0a3c7bca" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186236535} {:answer/id #uuid "806bb986-60b0-52f0-9e7d-fe440e12d7b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186236617} {:answer/id #uuid "d998f6fb-b8bd-532a-8961-d0fc2000cb68" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186237195} {:answer/id #uuid "da1538df-e67c-5454-aadf-6bd6796416e3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186237201}] :answer-field/correct {:answer/id #uuid "da1538df-e67c-5454-aadf-6bd6796416e3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186237201} :answer-field/id #uuid "cb257275-f2f7-5467-9be9-cb2bc1b74739" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237704}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "dcf46b6f-f5d9-5eec-afdf-9ca4614f945b" :question/math-academy-id "q-10255" :question/problem "![](images/ac/ac040bc2c3eb943f947f34602c7c03e90f18e129a0fa7749d8ae60faaab12f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=t-\\operatorname{sin}⁡t,\\,y=1-\\operatorname{cos}⁡t,\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡t)=1-\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-\\operatorname{cos}⁡t)=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(1-\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1-2\\operatorname{cos}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{sin}^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ \\operatorname{cos}⁡t & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 1-\\operatorname{cos}⁡t & =2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 2-2\\operatorname{cos}⁡t & =4{sin}^{2}⁡(\\frac{t}{2})\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{4{sin}^{2}⁡(\\frac{t}{2})}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(\\frac{t}{2})\\text{d}t \\\\  & =-2\\cdot 2\\cdot {\\operatorname{cos}⁡(\\frac{t}{2})|}_{0}^{\\pi } \\\\  & =-4(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0) \\\\  & =-4(0-1) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186092472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa3cd51-4469-5ba2-8636-0c4ac940fa23" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{\\pi }-\\pi " :db/id #edb/ref 17592186235867} {:answer/id #uuid "1b9306d9-9701-5f33-a7ee-c92f9826deea" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}-2" :db/id #edb/ref 17592186235990} {:answer/id #uuid "30704c9c-37d2-55f6-ba6e-a3279d9dc991" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sqrt{2}-\\pi " :db/id #edb/ref 17592186236126} {:answer/id #uuid "c65faa6c-8d42-5137-bf44-8cf565ae4758" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186237075} {:answer/id #uuid "dcb869b9-ae25-5d19-9d15-663789818115" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}-2" :db/id #edb/ref 17592186237208}] :answer-field/correct {:answer/id #uuid "1b9306d9-9701-5f33-a7ee-c92f9826deea" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}-2" :db/id #edb/ref 17592186235990} :answer-field/id #uuid "25174e9d-1c45-51db-a656-8b3a0ad5d3c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237487}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "977bb89c-c84c-5262-ad82-39cc342b286c" :question/math-academy-id "q-10260" :question/problem "![](images/51/5117030d23370b2167513b7a2eee5258aae4eb9f45ad428fd82e4334c4ce6638.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=1+3t,\\,y=2{t}^{3/2},\\,t\\in [0,1].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+3t)=3\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3/2})=3{t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{3}^{2}+{(3{t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9+9t}\\,\\text{d}t \\\\  & =3{\\int }_{0}^{1}(1+t)^{1/2}\\,\\text{d}t \\\\  & =3\\cdot {\\frac{2}{3}(1+t)^{3/2}|}_{0}^{1} \\\\  & =2\\sqrt{8}-2 \\\\  & =4\\sqrt{2}-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "241e58ea-86ce-5450-939e-02de03cdebfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186236050} {:answer/id #uuid "2e56d505-7726-5af1-871c-95766070a7e1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236112} {:answer/id #uuid "5b86c06b-4025-5e46-b183-b3a382a369a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186236390} {:answer/id #uuid "62be5c5d-404d-5b63-b96a-01802a0419b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186236442} {:answer/id #uuid "f134bbd3-d5b3-51e4-9905-9b65f60e5fa1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186237336}] :answer-field/correct {:answer/id #uuid "241e58ea-86ce-5450-939e-02de03cdebfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186236050} :answer-field/id #uuid "86665b82-4f5e-59d4-b139-f213cd90fc89" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237619}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eeda4143-b348-582e-8960-ff5a4ad7dde2" :question/math-academy-id "q-10256" :question/problem "![](images/da/da529910e268ea4c124d7c27b085ca1799e255604459c539cc8d5809dda8f95a.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx={sin}^{3}⁡t,\\,y={cos}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({sin}^{3}⁡t)=3{sin}^{2}⁡t\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({cos}^{3}⁡t)=-3{cos}^{2}⁡t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(3{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}+{(-3{cos}^{2}⁡t\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{4}⁡t{cos}^{2}⁡t+9{cos}^{4}⁡t{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{sin}^{2}⁡t{cos}^{2}⁡t({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =\\frac{3}{2}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{4}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{4}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{4}(-1-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a98e176-de94-501d-9654-ee79fa546361" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186235866} {:answer/id #uuid "5cbcf497-35c1-530e-8b8a-1e4520aff5ff" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236401} {:answer/id #uuid "64a92041-6332-5b56-9a49-329279ae7898" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186236454} {:answer/id #uuid "c676c67b-ce2e-5ee3-a924-56c7b533c894" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186237076} {:answer/id #uuid "ea75476f-d42e-58e7-be1d-885fe5dc9408" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186237291}] :answer-field/correct {:answer/id #uuid "ea75476f-d42e-58e7-be1d-885fe5dc9408" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186237291} :answer-field/id #uuid "dc8f08e3-d8d9-5787-8e9c-79e2c433c62c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237721}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "01f0c95b-ef07-5cce-9a1b-7f84a8200390" :question/math-academy-id "q-10257" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=2{cos}^{3}⁡t,\\,y=2{sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{cos}^{3}⁡t)=-6{cos}^{2}⁡t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{sin}^{3}⁡t)=6{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(-6{cos}^{2}⁡t\\operatorname{sin}⁡t)}^{2}+{(6{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{4}⁡t{sin}^{2}⁡t+36{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}6\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{2}(-1-1) \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33d582ab-25c3-5d89-b31c-eee9f2c1897c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186236147} {:answer/id #uuid "671a11ec-27d8-52b9-9a59-8dd0d0ec54c3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186236466} {:answer/id #uuid "7dedda59-24a2-5ab6-bb9d-20a20b1f41ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186236599} {:answer/id #uuid "c654b5a5-a703-55fd-9759-75e1cbdb9a7a" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186237074} {:answer/id #uuid "e227f87d-b8bb-5a30-92ed-b9b3c38e19ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186237232}] :answer-field/correct {:answer/id #uuid "671a11ec-27d8-52b9-9a59-8dd0d0ec54c3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186236466} :answer-field/id #uuid "58761fb6-2552-5c63-b655-9819d63debb2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237557}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "27c17b75-37ea-5768-beae-14242dea6c22" :question/math-academy-id "q-10258" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=2(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t),\\,y=2(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t),\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)) \\\\  & =2\\operatorname{cos}⁡t-2(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =2t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)) \\\\  & =-2\\operatorname{sin}⁡t+2(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =2t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(2t\\operatorname{sin}⁡t)}^{2}+{(2t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{t}^{2}({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }t\\,\\text{d}t \\\\  & =2\\cdot {\\frac{{t}^{2}}{2}|}_{0}^{\\pi } \\\\  & =2(\\frac{{\\pi }^{2}}{2}-0) \\\\  & ={\\pi }^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09aa28b6-42d5-5647-8c67-6ad4ae934fea" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186235862} {:answer/id #uuid "1bb02d36-4654-5167-a760-32462c48caf1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186235991} {:answer/id #uuid "3ead8f61-e137-5573-914b-52260b377c8b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236214} {:answer/id #uuid "478c7a12-33ef-5729-9381-971f513d4e4e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186236277} {:answer/id #uuid "c3466be1-0698-5115-8533-dbaa1ef80524" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186237050}] :answer-field/correct {:answer/id #uuid "09aa28b6-42d5-5647-8c67-6ad4ae934fea" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186235862} :answer-field/id #uuid "b04a5fcb-f5d2-5c81-be86-d5724d0bb948" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237664}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "31e80fe7-2790-57b6-8a22-f24ca436c4a9" :question/math-academy-id "q-10261" :question/problem "![](images/82/8288453c2625dac592a51054df332abf8ee49dbf8cbcabaf327c3ffe63b55f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t),\\,y=2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t),\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t))}^{2}+{(2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{sin}^{2}⁡t-8\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t)+4{sin}^{2}⁡(2t)+4{cos}^{2}⁡t-8\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+4{cos}^{2}⁡(2t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4+4-8(\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡(2t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{sin}^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ \\operatorname{cos}⁡t & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 1-\\operatorname{cos}⁡t & =2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 8-8\\operatorname{cos}⁡t & =16{sin}^{2}⁡(\\frac{t}{2})\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{16{sin}^{2}⁡(\\frac{t}{2})}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(\\frac{t}{2})\\,\\text{d}t \\\\  & =-8{\\operatorname{cos}⁡(\\frac{t}{2})|}_{0}^{\\pi } \\\\  & =-8(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0) \\\\  & =-8(0-1) \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186288017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0439511f-6bcb-5df1-b107-723ed7eac55b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186284822} {:answer/id #uuid "11540c92-a30f-5e29-852e-f44110b49f42" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186284939} {:answer/id #uuid "3dd6e6c8-c066-57ed-aca5-d04d9fd31bbf" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186285371} {:answer/id #uuid "766a4044-6e95-5e6f-af50-99ef14df0af9" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186285890} {:answer/id #uuid "d33d668e-b0ca-57c8-867a-44e3e4914dfd" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186286710}] :answer-field/correct {:answer/id #uuid "0439511f-6bcb-5df1-b107-723ed7eac55b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186284822} :answer-field/id #uuid "2f7cd0e3-04ea-5f3a-b65d-50397f5fe917" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287247}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dfd9b617-c165-5285-b91a-34485ed418b9" :question/math-academy-id "q-20907" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=4\\operatorname{sin}⁡t+5,\\,y=4(\\operatorname{cos}⁡t+1),\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t+5))=4\\operatorname{cos}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4(\\operatorname{cos}⁡t+1))=-4\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(4\\operatorname{cos}⁡(t))^{2}+(-4\\operatorname{sin}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{16{cos}^{2}⁡(t)+16{sin}^{2}⁡(t)}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi /2}\\sqrt{1}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi /2}\\,\\text{d}t \\\\  & =4t{|}_{0}^{\\pi /2} \\\\  & =4(\\frac{\\pi }{2}-0) \\\\  & =2\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "413af386-018a-5a79-9059-adefc2791bd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186317776}] :answer-field/correct {:answer/id #uuid "413af386-018a-5a79-9059-adefc2791bd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186317776} :answer-field/id #uuid "487a3ee4-df99-519f-a750-20dbe1bce54e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318584}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f8e9f1bb-dfe9-519e-8bb3-e8a484b04ce5" :question/math-academy-id "q-348086" :question/problem "![](images/12/121012fc5671ada263e83ec6d3a897d187ecb3a9d56c8e4331a3c0c608a92622.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t,\\,y=-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t,\\,t\\in [0,\\pi ].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t-(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t\\operatorname{sin}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =\\operatorname{sin}⁡t-(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =-t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(t\\operatorname{sin}⁡t)}^{2}+{(-t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}{sin}^{2}⁡t+{t}^{2}{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }t\\,\\text{d}t \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{{\\pi }^{2}}{2}-0 \\\\  & =\\frac{{\\pi }^{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63e7b79b-6298-5b7e-aa80-09f258e9f2ab" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186317907}] :answer-field/correct {:answer/id #uuid "63e7b79b-6298-5b7e-aa80-09f258e9f2ab" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186317907} :answer-field/id #uuid "1499962a-f058-50a8-a54d-83b434d7fef1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318468}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0c09908c-2ee7-5200-b887-daef1f475ca5" :question/math-academy-id "q-348088" :question/problem "![](images/be/be9e314ed11882842bbf9a74deeb3a994596c8275a4e854ffc66327fa0008058.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t,\\,y=\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t,\\,t\\in [0,2\\pi ].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t) \\\\  & =-\\operatorname{sin}⁡t+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =t\\operatorname{cos}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t-(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{(t\\operatorname{cos}⁡t)}^{2}+{(t\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{t}^{2}{cos}^{2}⁡t+{t}^{2}{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{t}^{2}({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }t\\,\\text{d}t \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}}{2}-0 \\\\  & =2{\\pi }^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de455dde-6d11-5b5e-8482-288ea3511e85" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186320067}] :answer-field/correct {:answer/id #uuid "de455dde-6d11-5b5e-8482-288ea3511e85" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186320067} :answer-field/id #uuid "4737cb78-73d4-5104-9fb5-39afec1f7dd0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320312}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2f48ecf1-07a6-51f5-a6dc-b4e6133b86d6" :question/math-academy-id "q-351427" :question/problem "![](images/33/33939aec3ac1315771d36714d15b590980197aabf3c169cdea1a1108baf6d0fa.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=3\\operatorname{sin}⁡t+2,\\,y=3\\operatorname{cos}⁡t-4,\\,t\\in [0,\\frac{\\pi }{3}].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t+2) \\\\  & =3\\operatorname{cos}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-4) \\\\  & =-3\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{(3\\operatorname{cos}⁡t)}^{2}+{(-3\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{9{cos}^{2}⁡t+9{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{9({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{9}\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /3}\\text{d}t \\\\  & =3t\\,{|}_{0}^{\\pi /3} \\\\  & =3(\\frac{\\pi }{3}-0) \\\\  & =\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c3b7c9a-1628-5579-88b4-676c4b08825d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186319423}] :answer-field/correct {:answer/id #uuid "0c3b7c9a-1628-5579-88b4-676c4b08825d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186319423} :answer-field/id #uuid "2c1d24ee-bce7-5e94-b62a-b8bc141ef9ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320266}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4184edde-38d0-51b8-8041-b0992688a366" :question/math-academy-id "q-351428" :question/problem "![](images/da/da2526ff7031c9dbc704b59e60c65df14dcd0678427e02c386fc16a86e1fc89c.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=5\\operatorname{sin}⁡t-3,\\,y=5\\operatorname{cos}⁡t+1,\\,t\\in [\\frac{\\pi }{5},\\frac{\\pi }{2}].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{sin}⁡t-3) \\\\  & =5\\operatorname{cos}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{cos}⁡t+1) \\\\  & =-5\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /5}^{\\pi /2}\\sqrt{{(5\\operatorname{cos}⁡t)}^{2}+{(-5\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /5}^{\\pi /2}\\sqrt{25{cos}^{2}⁡t+25{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /5}^{\\pi /2}\\sqrt{25({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /5}^{\\pi /2}\\sqrt{25}\\,\\text{d}t \\\\  & =5{\\int }_{\\pi /5}^{\\pi /2}\\text{d}t \\\\  & =5t\\,{|}_{\\pi /5}^{\\pi /2} \\\\  & =5(\\frac{\\pi }{2}-\\frac{\\pi }{5}) \\\\  & =5(\\frac{3\\pi }{10}) \\\\  & =\\frac{3\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320838 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df2cb4b-8bc6-564a-8b2d-5f0c079efa30" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319481}] :answer-field/correct {:answer/id #uuid "1df2cb4b-8bc6-564a-8b2d-5f0c079efa30" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186319481} :answer-field/id #uuid "6098a653-b151-59fc-800d-89802b1f9a5c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320364}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "97b78e76-2eb3-551c-ab96-c9852dc794ae" :question/math-academy-id "q-351429" :question/problem "![](images/5f/5fdcb137c459d5631db3dc3d02ff33ca0b791619694f1badbe7f3f2d0b19141d.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\frac{1}{2}{t}^{2},\\,y=\\frac{1}{3}(2t+1)^{3/2},\\,t\\in [0,2].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{2}) \\\\  & =t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}(2t+1)^{3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{3}{2}(2t+1)^{1/2}\\cdot 2 \\\\  & =(2t+1)^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{(t)^{2}+{((2t+1)^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{t}^{2}+2t+1}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{(t+1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}|t+1|\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}(t+1)\\,\\text{d}t \\\\  & =(\\frac{{t}^{2}}{2}+t)\\,{|}_{0}^{2} \\\\  & =(\\frac{4}{2}+2)-0 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462c106d-60a7-517a-bb34-02784bafa0df" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }-1" :db/id #edb/ref 17592186319599}] :answer-field/correct {:answer/id #uuid "462c106d-60a7-517a-bb34-02784bafa0df" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }-1" :db/id #edb/ref 17592186319599} :answer-field/id #uuid "baadc580-16c9-5c86-999f-1612b836e8a8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320545}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "212fc3da-e462-5e01-bc09-3c9becca9722" :question/math-academy-id "q-351438" :question/problem "![](images/19/19f2adedfeac6e4c4af07c3d3742203020e10ce841dd22f8b2e22c36ee2bf8e1.png)\n\nFind the arc length of the curve $L$ defined parametrically as\n\n$$\nx={e}^{2t}\\operatorname{cos}⁡t,\\,y={e}^{2t}\\operatorname{sin}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nDo not round the answer.\n\n$L=\\frac{\\sqrt{5}}{2}(${{field-1}}$)$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}\\operatorname{cos}⁡t) \\\\  & =2{e}^{2t}\\operatorname{cos}⁡t-{e}^{2t}\\operatorname{sin}⁡t \\\\  & ={e}^{2t}(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}\\operatorname{sin}⁡t) \\\\  & =2{e}^{2t}\\operatorname{sin}⁡t+{e}^{2t}\\operatorname{cos}⁡t \\\\  & ={e}^{2t}(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{2t}(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t))}^{2}+{({e}^{2t}(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}{(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{e}^{4t}{(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}({(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2})}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}(4{cos}^{2}⁡t-4\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+4{sin}^{2}⁡t+4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}(4({cos}^{2}⁡t+{sin}^{2}⁡t)+{sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5{e}^{4t}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5}\\,{e}^{2t}\\,\\text{d}t \\\\  & =\\sqrt{5}\\cdot \\frac{{e}^{2t}}{2}\\,{|}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2bf159b-7ee8-54ca-963e-4a6cee5dc607" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319938}] :answer-field/correct {:answer/id #uuid "b2bf159b-7ee8-54ca-963e-4a6cee5dc607" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186319938} :answer-field/id #uuid "580ca613-86fd-57f9-90d0-d5d1af6d384d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320352}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2bc346f7-e655-5b4d-b5a3-0f310aa8fdb4" :question/math-academy-id "q-351439" :question/problem "![](images/0b/0b9c4ebc430e05ef205e3d8108f2e1649bbc51b1a6b54e8f47b48e7ddad1e9a6.png)\n\nFind the arc length of the curve $L$ defined parametrically as\n\n$$\nx=4{cos}^{3}⁡t,\\,y=4{sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{4}].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4{cos}^{3}⁡t) \\\\  & =4\\cdot 3{cos}^{2}⁡t\\cdot (-\\operatorname{sin}⁡t) \\\\  & =-12\\operatorname{sin}⁡t{cos}^{2}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4{sin}^{3}⁡t) \\\\  & =4\\cdot 3{sin}^{2}⁡t\\cdot \\operatorname{cos}⁡t \\\\  & =12{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /4}\\sqrt{{(-12\\operatorname{sin}⁡t{cos}^{2}⁡t)}^{2}+{(12{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{144{sin}^{2}⁡t{cos}^{4}⁡t+144{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{144{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{144{sin}^{2}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}12|\\operatorname{sin}⁡t\\operatorname{cos}⁡t|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}12\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-3\\operatorname{cos}⁡(2t)\\,{|}_{0}^{\\pi /4} \\\\  & =-3\\operatorname{cos}⁡(\\frac{\\pi }{2})+3\\operatorname{cos}⁡0 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1650979-8a8d-5c45-9228-031f33216db2" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320035}] :answer-field/correct {:answer/id #uuid "d1650979-8a8d-5c45-9228-031f33216db2" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320035} :answer-field/id #uuid "078922c3-552d-5dbd-b708-92b4116bb58c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320173}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "781cb0dd-c613-5bc2-b9c0-2614a05ddf91" :question/math-academy-id "q-351471" :question/problem "![](images/a4/a4d2cf1820b792d804ab4d1b17ce1f36c0b63e4f406f8692d47f64a823b805f1.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=3\\operatorname{cos}⁡t-\\operatorname{cos}⁡(3t),\\,y=3\\operatorname{sin}⁡t-\\operatorname{sin}⁡(3t),\\,t\\in [0,\\pi ].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡(3t)) \\\\  & =-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡(3t),\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t-\\operatorname{sin}⁡(3t)) \\\\  & =3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡(3t))}^{2}+{(3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡(3t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9{sin}^{2}⁡t-18\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t)+9{sin}^{2}⁡(3t)+9{cos}^{2}⁡t-18\\operatorname{cos}⁡t\\operatorname{cos}⁡(3t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9+9-18(\\operatorname{cos}⁡t\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(3t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(2t)}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2t)=1-2{sin}^{2}⁡t.$ Therefore, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2t) & =1-2{sin}^{2}⁡(t) \\\\ 1-\\operatorname{cos}⁡(2t) & =2{sin}^{2}⁡(t) \\\\ 18-18\\operatorname{cos}⁡(2t) & =36{sin}^{2}⁡(t)\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(2t)}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{36{sin}^{2}⁡(t)}\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }|\\operatorname{sin}⁡(t)|\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(t)\\,\\text{d}t \\\\  & =-6\\operatorname{cos}⁡(t)\\,{|}_{0}^{\\pi } \\\\  & =-6(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡0) \\\\  & =-6(-1-1) \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320851 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "335fc60d-9d0b-5146-9aa1-0fb071f12d2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186319550}] :answer-field/correct {:answer/id #uuid "335fc60d-9d0b-5146-9aa1-0fb071f12d2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186319550} :answer-field/id #uuid "13cab329-a431-597a-8084-a7aa60854288" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320203}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5cc835fd-2da5-5e56-9fd0-7e642115b2a6" :question/math-academy-id "q-351474" :question/problem "![](images/cf/cf06561072376949c6df49aec94b45c57b1cd43fbb031ea7b157ea5dfbac877a.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\frac{1}{9}(6t+1)^{3/2},\\,y=\\frac{3}{2}{t}^{2},\\,t\\in [0,1].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{9}(6t+1)^{3/2}) \\\\  & =\\frac{1}{9}\\cdot \\frac{3}{2}(6t+1)^{1/2}\\cdot 6 \\\\  & =(6t+1)^{1/2},\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{2}{t}^{2}) \\\\  & =3t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{((6t+1)^{1/2})}^{2}+(3t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{6t+1+9{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(3t+1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}|3t+1|\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(3t+1)\\,\\text{d}t \\\\  & =(\\frac{3{t}^{2}}{2}+t)\\,{|}_{0}^{1} \\\\  & =(\\frac{3}{2}+1)-0 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd59335f-9ad0-5fc5-9249-f762bb6a6bd1" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320157}] :answer-field/correct {:answer/id #uuid "fd59335f-9ad0-5fc5-9249-f762bb6a6bd1" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320157} :answer-field/id #uuid "47988f9f-964f-5b0d-b582-4fcffe8e127c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320313}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3d22cb6e-269c-50b3-a963-22e85d7e4b70" :question/math-academy-id "q-351505" :question/problem "![](images/89/893efa56ec41ef2242a48831ad4f58b23edc791464ccc7dcb4dd104b87843360.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=t-\\frac{{t}^{3}}{3},\\,y={t}^{2},\\,t\\in [0,3].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{{t}^{3}}{3}) \\\\  & =1-{t}^{2},\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\  & =2t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{(1-{t}^{2})^{2}+(2t)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{1-2{t}^{2}+{t}^{4}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{1+2{t}^{2}+{t}^{4}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}\\sqrt{(1+{t}^{2})^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}(1+{t}^{2})\\,\\text{d}t \\\\  & =(t+\\frac{{t}^{3}}{3})\\,{|}_{0}^{3} \\\\  & =(3+\\frac{27}{3})-0 \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f98797f-08e7-52a2-b61b-fdbd3d8f6443" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sqrt{3}-\\frac{8}{3}" :db/id #edb/ref 17592186319486}] :answer-field/correct {:answer/id #uuid "1f98797f-08e7-52a2-b61b-fdbd3d8f6443" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sqrt{3}-\\frac{8}{3}" :db/id #edb/ref 17592186319486} :answer-field/id #uuid "1952a2da-3ef1-58fe-88d9-4df0661f32da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320226}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ad2ad837-fe00-5eb7-ab02-db6f230cbbfd" :question/math-academy-id "q-351508" :question/problem "![](images/a6/a61d1a169971b5e0af320372885cdcbae794d163ab767685ef5b688a083aaadb.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2+4t,\\,y=\\frac{8}{3}{t}^{3/2},\\,t\\in [0,2].\n$$\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2+4t)=4,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{8}{3}{t}^{3/2})=4{t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2}\\sqrt{{4}^{2}+{(4{t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{16+16t}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2}(1+t)^{1/2}\\,\\text{d}t \\\\  & =4\\cdot \\frac{2}{3}(1+t)^{3/2}\\,{|}_{0}^{2} \\\\  & =\\frac{8}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{8}{3}(3\\sqrt{3}-1) \\\\  & =8\\sqrt{3}-\\frac{8}{3}.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Arc Length of a Parametric Curve"}] [{:db/id #edb/ref 17592186096610 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096410 :question/id #uuid "8e4367b2-f7bc-5588-b30b-d612915e3e68" :question/math-academy-id "e-3624" :question/problem "Given that $f(x)=3e^x + \\ln 3$, find $f'(x).$" :question/worked-solution "The derivative of $e^x$ is just $e^x$ itself. On the other hand, $\\ln 3$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\eqalign{\nf'(x) &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3e^x + \\ln 3\\right)\\\n                                                  &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( 3e^x\\right) +  \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left( \\ln 3 \\right)\\\n                                                  &= 3\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(e^x\\right) + 0\\\n                                                  &= 3 e^x.\n}\n$$"} :knowledge-point/id #uuid "bb40a0ff-c3b5-512d-a436-cc2fce456008" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048932 :topic/math-academy-id 278 :topic/title "The Sum and Constant Multiple Rules for Differentiation"}] :knowledge-point/questions [{:db/id #edb/ref 17592186097160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf8a11fa-1240-537a-95d9-4f13df04cb91" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\ln 7 \\cdot e^{x}" :db/id #edb/ref 17592186094934} {:answer/id #uuid "dda24f68-a7ba-5bf1-96f0-617b7c17fe44" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 7e^{x} + \\ln 7" :db/id #edb/ref 17592186094935} {:answer/id #uuid "1309387e-621f-5d0b-bfb6-5f115748360a" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 0" :db/id #edb/ref 17592186094936} {:answer/id #uuid "2a07d543-9ac5-58f1-b5ef-aa2ee963c2ce" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\ln 7" :db/id #edb/ref 17592186094937} {:answer/id #uuid "7ab10bca-83d1-523f-bea5-740b0fb72553" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 7e^{x}" :db/id #edb/ref 17592186094938}] :answer-field/id #uuid "a83160c8-467b-5b39-bd2c-19bac5b891ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094933}] :question/id #uuid "c5e514ba-2b59-510b-8545-fa3adc383ab3" :question/math-academy-id "q-1927" :question/problem "Given that $f(x) = \\ln 7 + 7e^{x}$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186097316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80ead02c-6b7a-5427-a098-9365a890c204" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) =-4e^{x} + \\ln 2" :db/id #edb/ref 17592186095821} {:answer/id #uuid "a2229a9e-ba02-54ac-8ee3-942cfe462c7e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\ln 2" :db/id #edb/ref 17592186095822} {:answer/id #uuid "da457f81-da86-59ef-a2f7-84fe5f19f924" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 0" :db/id #edb/ref 17592186095823} {:answer/id #uuid "11cb83da-303f-50b1-9867-145640b74f54" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 2 - 4e^{x}" :db/id #edb/ref 17592186095824} {:answer/id #uuid "3a7daba6-5606-50b8-8ec8-465caa41dd60" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) =-4e^{x}" :db/id #edb/ref 17592186095825}] :answer-field/id #uuid "42cc8fce-e292-5c51-b7cd-156991b55f2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095820}] :question/id #uuid "32d48a7b-7bcb-5f18-b8f4-b39f8f7670ef" :question/math-academy-id "q-51208" :question/problem "Given that $f(x) = \\ln 2 - 4e^{x}$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186237849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f85df34-ee93-5aca-8d12-bcf5fe3faa9d" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡5" :db/id #edb/ref 17592186236117} {:answer/id #uuid "4d519265-840b-5e03-a09d-732553549f65" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236310} {:answer/id #uuid "5283baad-0cc3-5be9-a599-fc7057b5e7e9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186236339} {:answer/id #uuid "5848a3b7-55a7-59c9-957c-d8c9f1aede42" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186236373} {:answer/id #uuid "81168510-58be-58b5-8480-660231a90ce8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236621}] :answer-field/correct {:answer/id #uuid "5848a3b7-55a7-59c9-957c-d8c9f1aede42" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186236373} :answer-field/id #uuid "e280c21e-3772-51fb-a46a-1fbd0e6c47ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237727}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "987874a9-79ce-51e5-b80a-f5a44c3f0800" :question/math-academy-id "q-101587" :question/problem "Given that $f(x)=5{e}^{x}+1$, find the slope of the tangent at $x=0.$" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $1$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =5{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5{e}^{x})\\,|}_{x=0} \\\\  & =5{e}^{0} \\\\  & =5\\cdot 1 \\\\  & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d31247c-4643-5464-a30c-802705aaf50b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186236007} {:answer/id #uuid "3b878615-e206-52a0-bf52-3f4f50ce31b5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236190} {:answer/id #uuid "54afb277-4dae-5d46-82a6-d2ef3ba15dd9" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186236358} {:answer/id #uuid "9e126482-0792-53fb-9f81-3febb0cec7c7" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186236807} {:answer/id #uuid "a16f91bd-4ea9-5f5b-b438-3d185dbe8f3d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186236829}] :answer-field/correct {:answer/id #uuid "54afb277-4dae-5d46-82a6-d2ef3ba15dd9" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186236358} :answer-field/id #uuid "2ea4542f-4e0e-5b2c-a84d-fa40f33689f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237504}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cf78a5ba-4334-5b57-bc16-3a848e2f0dba" :question/math-academy-id "q-101590" :question/problem "Given that $f(x)=2{e}^{x}-ln⁡11$, find the slope of the tangent at $x=1.$" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $-ln⁡11$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}-ln⁡11) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-ln⁡11) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x})\\,|}_{x=1} \\\\  & =2{e}^{1} \\\\  & =2e.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cdb78ad-20bf-5af0-a094-1b3f6357e552" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{x}" :db/id #edb/ref 17592186312717} {:answer/id #uuid "6cffecb4-1fcc-411a-8289-8bcd57cb4ab4" :answer/type {:db/ident :answer.type/math} :answer/value "6e^{x}" :db/id #edb/ref 17592186409337}] :answer-field/correct {:answer/id #uuid "5cdb78ad-20bf-5af0-a094-1b3f6357e552" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{x}" :db/id #edb/ref 17592186312717} :answer-field/id #uuid "7a411b7f-e09b-54e6-9330-1c2c71a4efc6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314334}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6869b95a-63a5-54db-b062-b375ad3ac68d" :question/math-academy-id "q-340056" :question/problem "Given that $f(x)=6{e}^{x}+ln⁡8,$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡8$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}+ln⁡8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡8) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =6{e}^{x}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6db64c05-bd48-51ef-9218-df180caf5534" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186312840}] :answer-field/correct {:answer/id #uuid "6db64c05-bd48-51ef-9218-df180caf5534" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186312840} :answer-field/id #uuid "413c0c5a-e837-526a-8b03-fa256fc8b859" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314186}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "19b7181e-4102-59d9-864a-c870a873bbda" :question/math-academy-id "q-340067" :question/problem "Given that $f(x)=9{e}^{x}+ln⁡4$, the slope of the tangent line at $x=ln⁡2$ is{{field-1}}." :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡4$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}+ln⁡4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(9{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡4) \\\\  & =9\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =9{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=ln⁡2} & ={(9{e}^{x})\\,|}_{x=ln⁡2} \\\\  & =9{e}^{ln⁡2} \\\\  & =9\\cdot 2 \\\\  & =18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338886 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2615d5d0-577d-51e9-a7eb-7299c88c1240" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=-{e}^{x}" :db/id #edb/ref 17592186336388} {:answer/id #uuid "2d4ee843-f5a5-5e6f-a7b4-d39ee29e9a08" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=-2{e}^{x}" :db/id #edb/ref 17592186336465} {:answer/id #uuid "935cffee-f030-54ce-8980-0ae960bd62a9" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=10-2{e}^{x}" :db/id #edb/ref 17592186337376} {:answer/id #uuid "b4aa127c-c35b-5236-91c3-effa79e34c62" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=10-{e}^{x}" :db/id #edb/ref 17592186337635} {:answer/id #uuid "d6f526af-9e12-5d00-a48a-09643a747fff" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=0" :db/id #edb/ref 17592186337899}] :answer-field/correct {:answer/id #uuid "2d4ee843-f5a5-5e6f-a7b4-d39ee29e9a08" :answer/type {:db/ident :answer.type/math} :answer/value "{f}^{′}(x)=-2{e}^{x}" :db/id #edb/ref 17592186336465} :answer-field/id #uuid "c72ca8b2-1291-5b13-840e-71b284db3d8b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338635}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bd4ec376-93b4-54c8-9a98-7640cf3d729e" :question/math-academy-id "q-71053" :question/problem "Given that $f(x)=10-2{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $10$ is a constant, so its derivative is $0.$\n\nUsing the addition rule, then, we have \n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(10-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(10)+\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}) \\\\  & =0-2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =-2{e}^{x}.\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Constant"}]}
