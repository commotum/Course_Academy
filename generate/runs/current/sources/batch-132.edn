5-563e-a052-19d551e6520a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =2$" :db/id #edb/ref 17592186327900} {:answer/id #uuid "be6c2167-cf77-5c18-b9a9-c5f9e8dffcf0" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =2$" :db/id #edb/ref 17592186328597} {:answer/id #uuid "c1ea5c82-4696-5794-899e-2fbfedfbd836" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-4$ and $\\mu =-2$" :db/id #edb/ref 17592186328628}] :answer-field/correct {:answer/id #uuid "c1ea5c82-4696-5794-899e-2fbfedfbd836" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-4$ and $\\mu =-2$" :db/id #edb/ref 17592186328628} :answer-field/id #uuid "a0f8ee01-9c68-5cfd-a230-414249ca8bcf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329456}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8c824c20-e7d8-5ee0-a1d9-a9f4762eb921" :question/math-academy-id "q-42662" :question/problem "![](images/e2/e2f149fb4f32fb264e0af6898e7737d570ec90bbff31cf1256eb9bd2636ceab3.png)\n\nConsider the picture above. Given that $w=\\lambda u+\\mu v$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/58/589f9f524a7c98da61ad6c5001b8d392d89073d5734cd70cfa750d153fe6f7b7.png)\n\nIn $△OUW$ shown above, we have \n\n- $OU=2|v|$\n\n- $\\overset{\\to }{OU}$ has the opposite direction to $v$\n\nHence, $\\overset{\\to }{OU}=-2v.$\n\nSimilarly:\n\n- $UW=4|u|$\n\n- $\\overset{\\to }{UW}$ has the opposite direction to $u$\n\nHence, $\\overset{\\to }{UW}=-4u.$\n\nAdditionally, \n\n$$\n\\begin{aligned}w & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =-2v-4u \\\\  & =-4u-2v.\\end{aligned}\n$$\n\nConsequently, $w=\\lambda u+\\mu v=-4u-2v.$\n\nSince $u∦v,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-4$ and $\\mu =-2$"} {:db/id #edb/ref 17592186329679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cfbd0cb-8733-5454-bc51-0705f00c775a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =1$" :db/id #edb/ref 17592186327184} {:answer/id #uuid "453cbc37-f1de-5673-a82f-603e75313e66" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =-3$" :db/id #edb/ref 17592186327538} {:answer/id #uuid "4fb803a8-19e2-5f29-aee8-b53dd044f6ac" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =1$" :db/id #edb/ref 17592186327629} {:answer/id #uuid "6ca86f5b-66fb-523f-889e-3c74b76af03b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =-1$" :db/id #edb/ref 17592186327871} {:answer/id #uuid "c00cff55-58e1-5cdc-9c57-9569e58b8ad4" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =2$" :db/id #edb/ref 17592186328613}] :answer-field/correct {:answer/id #uuid "4fb803a8-19e2-5f29-aee8-b53dd044f6ac" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =1$" :db/id #edb/ref 17592186327629} :answer-field/id #uuid "11b673e4-f9d9-54b5-824e-58d311d04d42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329216}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ff56059b-4551-5fb8-813b-6274d8fd5efd" :question/math-academy-id "q-42676" :question/problem "![](images/be/be4bd3ff63baa05d861cbad6a26c6b53b8b7f1fed64feb0c0465408c6e7ced2d.png)\n\nConsider the picture above. Given that $l=\\lambda j+\\mu k$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/a2/a216faf7db26da01730a18607a298e442af47a7d45a7a69e6fd12cbfd2229360.png)\n\nIn $△OJL$ shown above, we have \n\n- $OJ=3|j|$\n\n- $\\overset{\\to }{OJ}$ and $j$ have the opposite direction\n\nHence, $\\overset{\\to }{OJ}=-3j.$\n\nSimilarly:\n\n- $JL=|k|$\n\n- $\\overset{\\to }{JL}$ and $k$ have the same direction\n\nHence, $\\overset{\\to }{JL}=k.$\n\nAdditionally, \n\n$$\n\\begin{aligned}l & =\\overset{\\to }{OJ}+\\overset{\\to }{JL} \\\\  & =-3j+k.\\end{aligned}\n$$\n\nConsequently, $l=\\lambda j+\\mu k=-3j+k.$\n\nSince $j∦k,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-3$ and $\\mu =1$"} {:db/id #edb/ref 17592186345312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35e8a992-ba26-5ab0-b03f-0702bf91ee4e" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-4$" :db/id #edb/ref 17592186342682} {:answer/id #uuid "6e67d9a0-0419-5935-870f-d8c935f24492" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =-4$" :db/id #edb/ref 17592186343186} {:answer/id #uuid "b2cf7717-8b57-5c5a-8c6b-fe789015f15d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\mu =3$" :db/id #edb/ref 17592186343809} {:answer/id #uuid "c92fb33f-34e7-5c73-878b-4458c8cc210d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =3$" :db/id #edb/ref 17592186344002} {:answer/id #uuid "ed1ac42e-951d-5ef5-af7a-bd888f1535e8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =4$" :db/id #edb/ref 17592186344322}] :answer-field/correct {:answer/id #uuid "ed1ac42e-951d-5ef5-af7a-bd888f1535e8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =4$" :db/id #edb/ref 17592186344322} :answer-field/id #uuid "1a3fc608-70a9-52f3-b660-88c24389d51a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344538}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "98730953-beae-5f36-b02e-39e84ea26f4a" :question/math-academy-id "q-77515" :question/problem "![](images/c8/c800644be3cc0ad0688d52948a4a2cb813cbe14b1fe899abe5a1d92613a687bf.png)\n\nConsider the picture above. Given that $r=\\lambda p+\\mu q$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/90/90272fad8af526de6e169faba8daae29210c1f502c4959d0e1829e5ad65476f0.png)\n\nIn $△OPR$ shown above, we have \n\n- $OP=2|p|$\n\n- $\\overset{\\to }{OP}$ and $p$ have the same direction\n\nHence, $\\overset{\\to }{OP}=2p.$\n\nSimilarly:\n\n- $PR=4|q|$\n\n- $\\overset{\\to }{PR}$ and $q$ have the same direction\n\nHence, $\\overset{\\to }{PR}=4q.$\n\nAdditionally, \n\n$$\n\\begin{aligned}r & =\\overset{\\to }{OP}+\\overset{\\to }{PR} \\\\  & =2p+4q.\\end{aligned}\n$$\n\nConsequently, $r=\\lambda p+\\mu q=2p+4q.$\n\nSince $p∦q,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =2$ and $\\mu =4$"} {:db/id #edb/ref 17592186365574 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c28aff5d-53e7-5f16-983d-538f4ce98117" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186365576}] :answer-field/correct {:answer/id #uuid "c28aff5d-53e7-5f16-983d-538f4ce98117" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186365576} :answer-field/id #uuid "7cfd16dc-f42e-5638-89f3-68f27f774336" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365575} {:answer-field/choices [{:answer/id #uuid "81e0b22a-548d-5d2e-b32f-16412fc6cadf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186365578}] :answer-field/correct {:answer/id #uuid "81e0b22a-548d-5d2e-b32f-16412fc6cadf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186365578} :answer-field/id #uuid "71b77659-ec75-56f7-ab9f-4c3596d182b4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186365577}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "681d8619-9082-56b4-9422-241cad7644a3" :question/math-academy-id "q-326016" :question/problem "![](images/0f/0f9ee37fe5f1cf32ba470b24e5d27b4164bd00a0caeae0536ae48d4cc5836c6d.png)\n\nConsider the picture above. If $t=\\lambda a+\\mu b$, then$\\,\\lambda =$\n{{field-1}}\nand \n$\\mu =$\n{{field-2}}." :question/worked-solution "![](images/c9/c95e718a0c30e2be1f3678123eea0006b17fd781305c06a4f277488c2389337f.png)\n\nIn $△OXT$ shown above, we have:\n\n- $OX=\\frac{7}{4}\\cdot |a|$\n\n- $\\overset{\\to }{OX}$ has the opposite direction to $a$\n\nHence, $\\overset{\\to }{OX}=-\\frac{7}{4}a.$\n\nSimilarly:\n\n- $XT=2|b|$\n\n- $\\overset{\\to }{XT}$ has the opposite direction to $b$\n\nHence, $\\overset{\\to }{XT}=-2b.$\n\nAdditionally,\n\n$$\nt=\\overset{\\to }{OX}+\\overset{\\to }{XT}=-\\frac{7}{4}a-2b.\n$$\n\nConsequently, $t=\\lambda a+\\mu b=-\\frac{7}{4}a-2b.$\n\nSince $b∦a,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-\\frac{7}{4}$ and $\\mu =-2$"} {:db/id #edb/ref 17592186403878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a9d3aac-2ddf-558e-9987-0dee3c2852ff" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2.5$ and $\\mu =-3$" :db/id #edb/ref 17592186403880} {:answer/id #uuid "d0c5e6ea-81c8-564a-84fa-99f998a1a61d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =3$" :db/id #edb/ref 17592186403881} {:answer/id #uuid "ed44e8da-0848-535d-a8ae-87bdbaa1daf7" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =-3$" :db/id #edb/ref 17592186403882} {:answer/id #uuid "8353c3d6-6092-5f38-bfd8-8a8168b1859c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =2.5$" :db/id #edb/ref 17592186403883} {:answer/id #uuid "aa67f058-afcd-51ee-97d4-c377ce896d7a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2.5$ and $\\mu =3$" :db/id #edb/ref 17592186403884}] :answer-field/correct {:answer/id #uuid "d0c5e6ea-81c8-564a-84fa-99f998a1a61d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =3$" :db/id #edb/ref 17592186403881} :answer-field/id #uuid "6554496f-6084-5a58-8758-7a159d646048" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403879}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b8cb8830-d33b-5725-abf1-a6d3f309ef27" :question/math-academy-id "q-77452" :question/problem "![](images/16/1649e6c4ef2874cda2a7d7428b54220ef2a1790ba4b197c755165c48add0c31e.png)\n\nConsider the picture above. Given that $c=\\lambda a+\\mu b$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/7c/7cf17440c27765efb34b6a01c12a76ad4e980fc540307e2218227153661db5dd.png)\n\nIn $△OAC$ shown above, we have:\n\n- $OA=2.5|a|$\n\n- $\\overset{\\to }{OA}$ and $a$ have the same direction\n\nHence, $\\overset{\\to }{OA}=2.5a.$\n\nSimilarly:\n\n- $AC=3|b|$\n\n- $\\overset{\\to }{AC}$ and $b$ have the same direction\n\nHence, $\\overset{\\to }{AC}=3b.$\n\nAdditionally, \n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OA}+\\overset{\\to }{AC} \\\\  & =2.5a+3b.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+\\mu b=2.5a+3b.$ \n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n$\\,$ $\\lambda =2.5$ and $\\mu =3$"} {:db/id #edb/ref 17592186420467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f1fbbe3-94d8-5bd3-8727-4e6f9a832097" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =2$" :db/id #edb/ref 17592186420448} {:answer/id #uuid "90599886-7bfb-5b72-84ac-b60df87c5d99" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =2$" :db/id #edb/ref 17592186420452} {:answer/id #uuid "a6826047-3513-5e97-9ed8-1ae795633fc4" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =2$" :db/id #edb/ref 17592186420453} {:answer/id #uuid "b05969db-3a13-5b96-96be-8b739e33d310" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =3$" :db/id #edb/ref 17592186420455} {:answer/id #uuid "cf620219-7b28-5e23-a450-b4abd046ba47" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-3$" :db/id #edb/ref 17592186420457}] :answer-field/correct {:answer/id #uuid "a6826047-3513-5e97-9ed8-1ae795633fc4" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =2$" :db/id #edb/ref 17592186420453} :answer-field/id #uuid "979e9c27-4560-5e47-8337-19ce5dc8192c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420463}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d5f98ecb-0f26-50ae-9a82-cc334fd82c55" :question/math-academy-id "q-20413" :question/problem "![](images/4b/4bb7598c9ebae28be572508974cd025caa8f4a6c3313f025ff0f5ca55296334e.png)\n\nConsider the picture above. Given that $h=\\lambda f+\\mu g$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/43/43642acdb991827b4e1e16744e8a69507a383a1319ae07efde78480af4bab166.png)\n\nIn $△OFH$ shown above, we have \n\n- $OF=2|g|$\n\n- $\\overset{\\to }{OF}$ and $g$ have the same direction\n\nHence, $\\overset{\\to }{OF}=2g.$\n\nSimilarly:\n\n- $FH=3|f|$\n\n- $\\overset{\\to }{FH}$ has the opposite direction to $f$\n\nHence, $\\overset{\\to }{FH}=-3f.$\n\nAdditionally, \n\n$$\n\\begin{aligned}h & =\\overset{\\to }{OF}+\\overset{\\to }{FH} \\\\  & =2g-3f \\\\  & =-3f+2g.\\end{aligned}\n$$\n\nConsequently, $h=\\lambda f+\\mu g=-3f+2g.$\n\nSince $f∦g,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-3$ and $\\mu =2$"}] :knowledge-point/title "Finding Two Scalar Factors in a Linear Combination"}]}
