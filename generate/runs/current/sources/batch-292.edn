#{[{:db/id #edb/ref 17592186138428 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138083 :question/id #uuid "cbf28a0c-c34d-5855-b72e-4225a11710c1" :question/math-academy-id "e-13129" :question/problem "Consider the following system of equations:\n${x + 2y = 8; 2x - y = 6$\n\nUse the diagram below to determine this system's solution $(x,y)$.\n\n![](images/6f/6f0b7960b9b4c98250741b009da2ad19c1123c5b7adf9cd5072430fb9a879dc9.png)" :question/worked-solution "The solution of the system corresponds to the point of intersection of the lines.\n\n![](images/5c/5c1c69adc880ea7cfdb5a4e0a10abd6032d2eedf0386923b94df9b7c173edd6d.png)\n\nIn this case, we have the point $(4,2)$. Therefore, the solution to the given system is $(4,2)$."} :knowledge-point/id #uuid "0f80bc47-7b56-5357-b4e7-718f4ddfa41b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050790 :topic/math-academy-id 95 :topic/title "Graphing Linear Equations"}] :knowledge-point/questions [{:db/id #edb/ref 17592186138700 :question/answer-fields [{:answer-field/id #uuid "827fc2ad-fcf7-5342-b52d-405f79525927" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135439} {:answer-field/id #uuid "b60de75b-396f-5a8a-9692-ab3e6fe2d3d8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135440}] :question/id #uuid "c750ebe1-0c7d-5650-92b4-e61ed4c0abda" :question/math-academy-id "q-171700" :question/problem "![](images/af/af8654d3581e41e1d206494fc3e6f0f2d1a9471285c0d9c856484ac966cbdc51.png)\n\nConsider the following system of equations:\n${x + y = 1; 2x + y = 4$\n\nUse the diagram provided to determine the solution $(x, y)$ of this system.\n\nThe solution is\n$($\n{{field-1}}\n$$,\n{{field-2}}\n$)$."} {:db/id #edb/ref 17592186138764 :question/answer-fields [{:answer-field/id #uuid "a6d3b349-7ac8-5a43-ba25-747ee0fca304" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135541} {:answer-field/id #uuid "3995f0d7-4020-5135-aeec-4e993d9b0188" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186135542}] :question/id #uuid "bbfdc27f-1f59-586d-a7a6-cadc27ed5daf" :question/math-academy-id "q-238014" :question/problem "![](images/70/7035e6e365263cddf659554a40093d9661a140754d4c195791fd266c9389c3da.png)\n\nConsider the following system of equations:\n${4x - y = 12; y =-3x + 9$\n\nUse the diagram provided to determine the solution $(x, y)$ of this system.\n\nThe solution is\n$($\n{{field-1}}\n$$,\n{{field-2}}\n$)$."}] :knowledge-point/title "Finding the Solution to a System From Its Graph"}] [{:db/id #edb/ref 17592186138429 :knowledge-point/canonical-example {:db/id #edb/ref 17592186138084 :question/id #uuid "86771ced-afc0-5061-a532-bc2345a52ea8" :question/math-academy-id "e-13130" :question/problem "![](images/09/0915c99015922e27855d92ebb13756da634a8f10dd8fe3abbc016590f06e1077.png)\n\nThe graph above shows the number of liters of water in pool $A$ and pool $B$ as a function of time, measured in days. How many days will it take for both pools to contain the same amount of water?" :question/worked-solution "The pools have the same amount of water when the two graphs intersect.\n\n![](images/cf/cf7a9b8bdccbc66086c473813523ed893ee192830965300a8c4a0702ad065fc3.png)\n\nIn this case, we have the point $(5,400)$. So, both pools have the same amount ($400\\,\\textrm{L}$) of water at $t=5$ days."} :knowledge-point/id #uuid "4154d81b-c94a-57f7-80fa-0daa341505e6" :knowledge-point/questions [{:db/id #edb/ref 17592186138783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2e689cf-e055-5aba-b4d2-3b11b04d1e2e" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186135647} {:answer/id #uuid "ec1c3419-1155-5170-be6d-98f1b0176672" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186135648} {:answer/id #uuid "1a814fda-9d35-5744-9906-6c0a6c7069a5" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186135649} {:answer/id #uuid "1c5ebb6d-5110-56a4-bd41-59743682fc49" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186135650} {:answer/id #uuid "3532a08a-d9a7-524b-ae88-f0c36f56f4ec" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186135651}] :answer-field/id #uuid "0609360b-f7ba-52dd-a7b8-807f5c237c61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186135646}] :question/id #uuid "10d6cebb-53da-57a8-b24b-2a1a1f8f0163" :question/math-academy-id "q-45165" :question/problem "![](images/0d/0d5e3ef2393a00fc74c91ebc44f71d553e641d0e1bca21bf783252cbafcca84c.png)\n\nThe graph above shows the speed of cars $A$ and $B$ as a function of the distance that they traveled during a brake test. At which distance, in meters, did both cars reach the same speed?"} {:db/id #edb/ref 17592186139116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8337461-4342-5b9c-8484-145234157d30" :answer/type {:db/ident :answer.type/math} :answer/value "3h" :db/id #edb/ref 17592186137645} {:answer/id #uuid "fac79086-a744-5542-af8a-0dc08066528c" :answer/type {:db/ident :answer.type/math} :answer/value "6h" :db/id #edb/ref 17592186137646} {:answer/id #uuid "457e9b7f-b0e1-5c8a-85f7-66a18dd92b73" :answer/type {:db/ident :answer.type/math} :answer/value "5h" :db/id #edb/ref 17592186137647} {:answer/id #uuid "65a7608d-9c83-510d-a732-df0fa09b2c61" :answer/type {:db/ident :answer.type/math} :answer/value "2h" :db/id #edb/ref 17592186137648} {:answer/id #uuid "76d46f6f-2c96-5f74-acbf-ddb738b654ac" :answer/type {:db/ident :answer.type/math} :answer/value "4h" :db/id #edb/ref 17592186137649}] :answer-field/id #uuid "3b856f10-522c-5eaa-860d-a2dd17029956" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186137644}] :question/id #uuid "ac5a82e8-bf81-5b0e-b617-f0a11d180015" :question/math-academy-id "q-59886" :question/problem "![](images/b9/b91b1093a485c671cb5e7566498a1e2b95452d9b92ea87e478696ff8c9ace0ff.png)\n\nTwo trucks, Truck $A$ and Truck $B$, are carrying shipments between distribution centers. The graph above shows the distances (in miles) of Truck $A$ and Truck $B$ from one of the centers as a function of time (in hours). At what time are Truck $A$ and Truck $B$ the same distance from the center?"}] :knowledge-point/title "Word Problems"}] [{:db/id #edb/ref 17592186152116 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151877 :question/id #uuid "78763507-6493-5a57-91a1-1c0c92324473" :question/math-academy-id "e-14805" :question/problem "Find the least common multiple of $4(x+1)$ and $6(x+1).$" :question/worked-solution "To find the least common multiple ($\\textrm{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nFirst, we find $\\textrm{LCM}(4,6)\\mathbin{:}$\n\n- Multiples of $4\\mathbin{:}$ $\\quad 4, \\, 8, \\, {\\color{blue}12}, \\ldots$\n\n- Multiples of $6\\mathbin{:}$ $\\quad 6, \\, {\\color{blue}12}, \\, 18, \\ldots$\n\nSo, $\\textrm{LCM}(4,6) =  {\\color{blue}{12}}.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\textrm{LCM}\\left((x+1), \\, (x+1)\\right) = {\\color{red}{(x+1)}}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\textrm{LCM}\\left(4(x+1), \\, 6(x+1)\\right) = {\\color{blue}{12}}\\cdot {\\color{red}{(x+1)}} = 12(x+1).\n$$"} :knowledge-point/id #uuid "db871222-7398-5fea-8097-bcf669751a40" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048209 :topic/math-academy-id 2625 :topic/title "The Least Common Multiple of Two Monomials"}] :knowledge-point/questions [{:db/id #edb/ref 17592186152511 :question/answer-fields [{:answer-field/id #uuid "c7bb582a-acb7-5544-b886-1bb65181448f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186149595}] :question/id #uuid "e6a42137-9fd1-5780-b649-7b5f194f63a7" :question/math-academy-id "q-218482" :question/problem "The least common multiple of $6(w - 8)$ and $15(w - 8)$ is {{field-1}}."} {:db/id #edb/ref 17592186152733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9daf35c8-cab9-5735-9f9d-2b637a85574f" :answer/type {:db/ident :answer.type/math} :answer/value "30(x - 1)^{2}" :db/id #edb/ref 17592186150906} {:answer/id #uuid "f21c8387-a425-5935-ade9-82c8941b2ab2" :answer/type {:db/ident :answer.type/math} :answer/value "30(x - 1)" :db/id #edb/ref 17592186150907} {:answer/id #uuid "fdcf8ac0-ce3d-5200-8666-4621b93e0f25" :answer/type {:db/ident :answer.type/math} :answer/value "8(x - 1)" :db/id #edb/ref 17592186150908} {:answer/id #uuid "2009ce06-5aed-57af-8b84-6b7f745682d1" :answer/type {:db/ident :answer.type/math} :answer/value "15(x - 1)" :db/id #edb/ref 17592186150909} {:answer/id #uuid "5c1faa04-8c34-5f95-82cc-1ffef00adffc" :answer/type {:db/ident :answer.type/math} :answer/value "15(x - 1)^{2}" :db/id #edb/ref 17592186150910}] :answer-field/id #uuid "4335f336-bfff-56e8-8645-a45d5b136a09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150905}] :question/id #uuid "3a9fca8b-ae63-5742-985d-da434e1bb1cc" :question/math-academy-id "q-76238" :question/problem "Find the least common multiple of $3(x - 1)$ and $5(x - 1)$."} {:db/id #edb/ref 17592186247230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8d13e1-a99f-5ab7-a526-b7cfba5e8813" :answer/type {:db/ident :answer.type/math} :answer/value "9(z-4)^{2}" :db/id #edb/ref 17592186244444} {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} {:answer/id #uuid "7c28feb1-7589-5e8d-9418-28850a614574" :answer/type {:db/ident :answer.type/math} :answer/value "28(z-4)^{4}" :db/id #edb/ref 17592186245401} {:answer/id #uuid "a73784f2-2fb7-5100-b1a9-c95f9187984f" :answer/type {:db/ident :answer.type/math} :answer/value "28(z-4)^{2}" :db/id #edb/ref 17592186245812} {:answer/id #uuid "f54ce985-d718-578e-8921-d62dfebbfd89" :answer/type {:db/ident :answer.type/math} :answer/value "14(z-4)^{4}" :db/id #edb/ref 17592186246478}] :answer-field/correct {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} :answer-field/id #uuid "b7db519b-b493-5c2a-b1f8-3f09714be182" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246881}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1022040b-f64c-5ed6-9959-011542bf6e8b" :question/math-academy-id "q-111582" :question/problem "Find the least common multiple of $2(z-4)^{2}$ and $7(z-4)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(2,7):$\n\n- Multiples of $2:$ $\\,2,\\,4,…,\\,12,\\,14,16,…$\n\n- Multiples of $7:$ $\\,7,\\,14,\\,21,…$\n\nSo, $\\text{LCM}(2,7)=14.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((z-4)^{2},\\,(z-4)^{2})=(z-4)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(2(z-4)^{2},\\,7(z-4)^{2})=14\\cdot (z-4)^{2}=14(z-4)^{2}.\n$$"} {:db/id #edb/ref 17592186290383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56763c56-e76a-5f24-b49e-928932323992" :answer/type {:db/ident :answer.type/math} :answer/value "36(y-3)" :db/id #edb/ref 17592186288630}] :answer-field/correct {:answer/id #uuid "56763c56-e76a-5f24-b49e-928932323992" :answer/type {:db/ident :answer.type/math} :answer/value "36(y-3)" :db/id #edb/ref 17592186288630} :answer-field/id #uuid "a1550040-6aa8-5d6a-8568-bc6df52c06d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290087}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fa4632cb-7d35-54aa-89c7-812065d4a185" :question/math-academy-id "q-221994" :question/problem "The least common multiple of $4(y-3)$ and $9(y-3)$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(4,9):$\n\n- Multiples of $4:$ $\\,4,\\,8,\\,12,\\,16,\\,20,\\,24,\\,28,\\,32,\\,36,…$\n\n- Multiples of $9:$ $\\,9,\\,18,\\,27,\\,36,\\,45,\\,54,…$\n\nSo, $\\text{LCM}(4,9)=36.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y-3),\\,(y-3))=(y-3).\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(4(y-3),\\,9(y-3))=36\\cdot (y-3)=36(y-3).\n$$"} {:db/id #edb/ref 17592186290384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "859c7d02-8e63-53b8-829d-0eac5b214280" :answer/type {:db/ident :answer.type/math} :answer/value "9(y+7)^{2}" :db/id #edb/ref 17592186288936}] :answer-field/correct {:answer/id #uuid "859c7d02-8e63-53b8-829d-0eac5b214280" :answer/type {:db/ident :answer.type/math} :answer/value "9(y+7)^{2}" :db/id #edb/ref 17592186288936} :answer-field/id #uuid "251d4be3-7af4-5b71-ac48-27f09bb2de97" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289817}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a0fbd6c-5258-5a3a-8b3d-54cb21af5e4c" :question/math-academy-id "q-221998" :question/problem "The least common multiple of $3(y+7)^{2}$ and $9(y+7)^{2}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(3,9):$\n\n- Multiples of $3:$ $\\,3,\\,6,\\,9,\\,12,…$\n\n- Multiples of $9:$ $\\,9,\\,18,\\,27,…$\n\nSo, $\\text{LCM}(3,9)=9.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y+7)^{2},\\,(y+7)^{2})=(y+7)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(3(y+7)^{2},\\,9(y+7)^{2})=9\\cdot (y+7)^{2}=9(y+7)^{2}\n$$"} {:db/id #edb/ref 17592186290385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b793f73-b71e-50c2-add9-fd3bb120bcb6" :answer/type {:db/ident :answer.type/math} :answer/value "20(z-1)^{2}" :db/id #edb/ref 17592186288876}] :answer-field/correct {:answer/id #uuid "7b793f73-b71e-50c2-add9-fd3bb120bcb6" :answer/type {:db/ident :answer.type/math} :answer/value "20(z-1)^{2}" :db/id #edb/ref 17592186288876} :answer-field/id #uuid "1b0c5483-7da3-5d90-973c-277dfae26c5b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289795}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c61a52da-f3a4-50e1-b761-609814a1be75" :question/math-academy-id "q-221999" :question/problem "The least common multiple of $4(z-1)^{2}$ and $10(z-1)^{2}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(4,10):$\n\n- Multiples of $4:$ $\\,4,\\,8,\\,12,\\,16,\\,20,\\,24,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,\\,50,…$\n\nSo, $\\text{LCM}(4,10)=20.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((z-1)^{2},\\,(z-1)^{2})=(z-1)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(4(z-1)^{2},\\,10(z-1)^{2})=20\\cdot (z-1)^{2}=20(z-1)^{2}\n$$"} {:db/id #edb/ref 17592186345215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c5daec-215b-519e-b948-8734e5d06899" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{2}" :db/id #edb/ref 17592186342961} {:answer/id #uuid "9a145a1b-f7bd-50a4-9259-671b24f22358" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)^{2}" :db/id #edb/ref 17592186343593} {:answer/id #uuid "a3779eca-872e-5e74-9368-f9fe0b4b4b79" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)" :db/id #edb/ref 17592186343675} {:answer/id #uuid "ad143ae4-f941-5eef-b5ef-3f8ba889a17e" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)" :db/id #edb/ref 17592186343762} {:answer/id #uuid "c729e1de-709f-58cd-b65e-918025a0a02d" :answer/type {:db/ident :answer.type/math} :answer/value "25(y+1)" :db/id #edb/ref 17592186343984}] :answer-field/correct {:answer/id #uuid "ad143ae4-f941-5eef-b5ef-3f8ba889a17e" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)" :db/id #edb/ref 17592186343762} :answer-field/id #uuid "48e9ac68-09ff-54ff-a3e2-f44557a9b1fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344615}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a0aeedc6-9345-53e2-9356-b127ab780aee" :question/math-academy-id "q-76409" :question/problem "Find the least common multiple of $10(y+1)$ and $15(y+1).$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y+1),\\,(y+1))=(y+1).\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1),\\,15(y+1))=30\\cdot (y+1)=30(y+1).\n$$"}] :knowledge-point/title "Finding the LCM of Two Polynomials that Differ by a Constant Factor"}] [{:db/id #edb/ref 17592186152117 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151879 :question/id #uuid "588a1460-6cd3-519a-ae98-7bc80c7a946c" :question/math-academy-id "e-14809" :question/problem "Find the least common multiple of $9(x-1)^4$ and $12(x-1)^2.$" :question/worked-solution "To find the least common multiple ($\\textrm{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nFirst, we find $\\textrm{LCM}(9,12)\\mathbin{:}$\n\n- Multiples of $9 \\mathbin{:}$ $\\quad 9, \\, 18, \\, 27, \\, {\\color{blue}36}, \\, 45, \\ldots$\n\n- Multiples of $12 \\mathbin{:}$ $\\quad 12, \\, 24, \\, {\\color{blue}36}, \\, 48, \\ldots$\n\nSo, $\\textrm{LCM}(9,12) =  {\\color{blue}{36}}.$\n\nTo find the $\\textrm{LCM}$ of $(x-1)^4$ and $(x-1)^2,$ we raise $(x-1)$ to the largest power that appears in the expressions, which is $4.$ Therefore,\n\n$$\n\\textrm{LCM}\\left((x-1)^4, \\, (x-1)^2\\right) = {\\color{red}{(x-1)^4}}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\textrm{LCM}\\left(9(x-1)^4, \\, 12(x-1)^2\\right) = {\\color{blue}{36}}\\cdot {\\color{red}{(x-1)^4}} = 36(x-1)^4.\n$$"} :knowledge-point/id #uuid "92a06a13-9e6b-53b1-9fad-ec6cba8b9545" :knowledge-point/questions [{:db/id #edb/ref 17592186152516 :question/answer-fields [{:answer-field/id #uuid "fe98f23f-b63f-5b3b-93d9-9bd2e3e5e383" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186149600}] :question/id #uuid "23d9a941-362d-5b43-b727-77e05cacf8dd" :question/math-academy-id "q-222016" :question/problem "The least common multiple of $9(y + 7)^{4}$ and $3(y + 7)^{2}$ is {{field-1}}."} {:db/id #edb/ref 17592186152744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "813b9d12-3005-5562-83e3-cad4df49c185" :answer/type {:db/ident :answer.type/math} :answer/value "6(y - 4)^{3}" :db/id #edb/ref 17592186150972} {:answer/id #uuid "bdf863f9-99db-5789-b184-4076d8cec3a4" :answer/type {:db/ident :answer.type/math} :answer/value "6(y - 4)^{2}" :db/id #edb/ref 17592186150973} {:answer/id #uuid "cf4c912f-c08f-5c71-82d9-cc97eb31bdfb" :answer/type {:db/ident :answer.type/math} :answer/value "2(y - 4)^{2}" :db/id #edb/ref 17592186150974} {:answer/id #uuid "305525ba-5cd5-544c-aa63-b2c499bf7789" :answer/type {:db/ident :answer.type/math} :answer/value "3(y - 4)^{2}" :db/id #edb/ref 17592186150975} {:answer/id #uuid "5348a2fd-31a6-5cfe-9567-cf6e85ce552b" :answer/type {:db/ident :answer.type/math} :answer/value "3(y - 4)" :db/id #edb/ref 17592186150976}] :answer-field/id #uuid "e9ab3b75-da54-5fa7-8a97-d807052c826f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150971}] :question/id #uuid "1d8ab5a8-e076-5cc6-9e2b-5fc7fcef9ac6" :question/math-academy-id "q-76460" :question/problem "Find the least common multiple of $2(y - 4)^{2}$ and $3(y - 4)$."} {:db/id #edb/ref 17592186290353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce81a481-fe7e-518c-a1d7-bd34e84fea7f" :answer/type {:db/ident :answer.type/math} :answer/value "14(z+3)^{5}" :db/id #edb/ref 17592186289409}] :answer-field/correct {:answer/id #uuid "ce81a481-fe7e-518c-a1d7-bd34e84fea7f" :answer/type {:db/ident :answer.type/math} :answer/value "14(z+3)^{5}" :db/id #edb/ref 17592186289409} :answer-field/id #uuid "cb6457be-66fa-5a61-8d4b-7978b2734725" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290173}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cd9da29a-b393-5138-bdff-e8e16834aa3d" :question/math-academy-id "q-218483" :question/problem "The least common multiple of $7(z+3)^{2}$ and $2(z+3)^{5}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(7,2):$\n\n- Multiples of $7:$ $\\,7,\\,14,\\,28,…$\n\n- Multiples of $2:$ $\\,2,\\,4,\\,6,\\,8,\\,10,\\,12,\\,14,\\,24,…$\n\nSo, $\\text{LCM}(7,2)=14.$\n\nTo find the $\\text{LCM}$ of $(z+3)^{2}$ and $(z+3)^{5}$ we raise $(z+3)$ to the largest power that appears in the expressions, which is $5.$ Therefore,\n\n$$\n\\text{LCM}((z+3)^{2},\\,(z+3)^{5})=(z+3)^{5}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(7(z+3)^{2},\\,2(z+3)^{5})=14\\cdot (z+3)^{5}=14(z+3)^{5}.\n$$"} {:db/id #edb/ref 17592186290386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020bcddf-6dba-5a6c-bfad-755a7d039e8e" :answer/type {:db/ident :answer.type/math} :answer/value "40(x-1)^{4}" :db/id #edb/ref 17592186288041}] :answer-field/correct {:answer/id #uuid "020bcddf-6dba-5a6c-bfad-755a7d039e8e" :answer/type {:db/ident :answer.type/math} :answer/value "40(x-1)^{4}" :db/id #edb/ref 17592186288041} :answer-field/id #uuid "a425cf36-1923-5b1e-a442-6afa4a3ee362" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290100}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "920b8fd7-c6c7-592b-b8ac-58c5083f2e3a" :question/math-academy-id "q-222013" :question/problem "The least common multiple of $5(x-1)^{3}$ and $8(x-1)^{4}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(5,8):$\n\n- Multiples of $5:$ $\\,5,\\,10,\\,15,\\,20,\\,25,\\,30,\\,35,\\,40,…$\n\n- Multiples of $8:$ $\\,8,\\,16,\\,24,\\,32,\\,40,\\,48,\\,56,…$\n\nSo, $\\text{LCM}(5,8)=40.$\n\nTo find the $\\text{LCM}$ of $(x-1)^{3}$ and $(x-1)^{4}$ we raise $(x-1)$ to the largest power that appears in the expressions, which is $4.$ Therefore,\n\n$$\n\\text{LCM}((x-1)^{3},\\,(x-1)^{4})=(x-1)^{4}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(5(x-1)^{3},\\,8(x-1)^{4})=40\\cdot (x-1)^{4}=40(x-1)^{4}\n$$"} {:db/id #edb/ref 17592186290387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e2d2fef-25c0-587d-b915-1baa50eebd4d" :answer/type {:db/ident :answer.type/math} :answer/value "30(w+3)^{6}" :db/id #edb/ref 17592186288133}] :answer-field/correct {:answer/id #uuid "0e2d2fef-25c0-587d-b915-1baa50eebd4d" :answer/type {:db/ident :answer.type/math} :answer/value "30(w+3)^{6}" :db/id #edb/ref 17592186288133} :answer-field/id #uuid "710e948a-0db1-5114-aba0-8bf4d460ca33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289978}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a3b9782f-5b5f-5eb0-8fa1-1ab86047cc94" :question/math-academy-id "q-222021" :question/problem "The least common multiple of $15(w+3)^{3}$ and $10(w+3)^{6}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(15,10):$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,\\,60,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\nSo, $\\text{LCM}(15,10)=30.$\n\nTo find the $\\text{LCM}$ of $(w+3)^{3}$ and $(w+3)^{6},$ we raise $(w+3)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((w+3)^{3},\\,(w+3)^{6})=(w+3)^{6}\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(15(w+3)^{3},\\,10(w+3)^{6})=30\\cdot (w+3)^{6}=30(w+3)^{6}\n$$"} {:db/id #edb/ref 17592186290388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a0e110-653e-5959-ac4f-8f4f958ca254" :answer/type {:db/ident :answer.type/math} :answer/value "40(y-2)^{9}" :db/id #edb/ref 17592186288173}] :answer-field/correct {:answer/id #uuid "14a0e110-653e-5959-ac4f-8f4f958ca254" :answer/type {:db/ident :answer.type/math} :answer/value "40(y-2)^{9}" :db/id #edb/ref 17592186288173} :answer-field/id #uuid "8051f9f9-9451-50a9-a1e3-eb0f9fd17f95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186290011}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b0cd1da4-cfec-56f1-a8d9-6ec40f8f1bec" :question/math-academy-id "q-222022" :question/problem "The least common multiple of $8(y-2)^{9}$ and $20(y-2)^{7}$ is{{field-1}}." :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(8,20):$\n\n- Multiples of $8:$ $\\,8,\\,16,\\,24,\\,32,\\,40,…$\n\n- Multiples of $20:$ $\\,20,\\,40,\\,60,\\,80,…$\n\nSo, $\\text{LCM}(8,20)=40.$\n\nTo find the $\\text{LCM}$ of $(y-2)^{9}$ and $(y-2)^{7},$ we raise $(y-2)$ to the largest power that appears in the expressions, which is $9.$ Therefore,\n\n$$\n\\text{LCM}((y-2)^{9},\\,(y-2)^{7})=(y-2)^{9}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(8(y-2)^{9},\\,20(y-2)^{7})=40\\cdot (y-2)^{9}=40(y-2)^{9}\n$$"} {:db/id #edb/ref 17592186345221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} {:answer/id #uuid "a00fafbc-22ed-52d6-8f01-31dffa057768" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{10}" :db/id #edb/ref 17592186343651} {:answer/id #uuid "da747809-5242-5b07-9971-7285cceb6b5c" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)^{10}" :db/id #edb/ref 17592186344157} {:answer/id #uuid "eb3e407c-9b56-57b2-833f-24e819c942f6" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{12}" :db/id #edb/ref 17592186344298} {:answer/id #uuid "eb9d1027-57d3-5a23-9b93-f847e9338320" :answer/type {:db/ident :answer.type/math} :answer/value "150(y+1)^{6}" :db/id #edb/ref 17592186344302}] :answer-field/correct {:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} :answer-field/id #uuid "81b1b5e2-12f3-59b8-8a06-c39c41de6a36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344722}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6fe6c820-9683-5a7a-b33c-5f323f0359af" :question/math-academy-id "q-76457" :question/problem "Find the least common multiple of $10(y+1)^{6}$ and $15(y+1)^{4}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nTo find the $\\text{LCM}$ of $(y+1)^{6}$ and $(y+1)^{4},$ we raise $(y+1)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((y+1)^{6},\\,(y+1)^{4})=(y+1)^{6}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1)^{6},\\,15(y+1)^{4})=30\\cdot (y+1)^{6}=30(y+1)^{6}.\n$$"}] :knowledge-point/title "Finding the LCM of Two Single-Variable Polynomials"}]}
