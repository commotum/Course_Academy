        ":question/answer-fields": [
          {
            ":answer-field/choices": [
              {
                ":answer/feedback": "The negative coefficient remains negative: d[-3x^2]/dx = -6x.",
                ":answer/id": "3b2b9b31-ff69-5fd5-b05e-2f7659ff135f",
                ":answer/type": {
                  ":db/ident": ":answer.type/math"
                },
                ":answer/value": "\\frac{5}{x}+6x+2",
                ":db/id": 17592186408180
              },
              {
                ":answer/feedback": "Differentiate term by term: d[5 ln(x)]/dx = 5/x, d[-3x^2]/dx = -6x, and d[2x]/dx = 2.",
                ":answer/id": "0d5c95ed-e8ad-537b-a8d6-7a28ab66e027",
                ":answer/type": {
                  ":db/ident": ":answer.type/math"
                },
                ":answer/value": "\\frac{5}{x}-6x+2",
                ":db/id": 17592186408181
              },
              {
                ":answer/feedback": "The coefficient 5 multiplies the derivative of ln(x): d[5 ln(x)]/dx = 5/x, not 1/x.",
                ":answer/id": "91dae272-a571-532b-b8c9-5f1a0d446765",
                ":answer/type": {
                  ":db/ident": ":answer.type/math"
                },
                ":answer/value": "\\frac{1}{x}-6x+2",
                ":db/id": 17592186408182
              },
              {
                ":answer/feedback": "Differentiate the quadratic term as well: d[-3x^2]/dx = -6x; the original -3x^2 term cannot remain in the derivative.",
