#{[{:db/id #edb/ref 17592186129123 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128880 :question/id #uuid "bfa446cd-c215-59c2-b84d-35d7897e9e34" :question/math-academy-id "e-15615" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-6$ and a maximum value of $8.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny = \\dfrac{y_{\\textrm{min}}+y_{\\textrm{max}}}{2},\n$$\n\nwhere $y_{\\textrm{min}}$ and $y_{\\textrm{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-6+8}{2} \\\\  & =\\frac{2}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the midline is $y=1.$"} :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050533 :topic/math-academy-id 206 :topic/title "Vertical Translations of Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186129561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4da8725-8550-5cf7-8104-83fb6f684917" :answer/type {:db/ident :answer.type/math} :answer/value "y =-4" :db/id #edb/ref 17592186126844} {:answer/id #uuid "f94a10a6-5ab7-569e-8472-996b9cbd50c2" :answer/type {:db/ident :answer.type/math} :answer/value "y =-9" :db/id #edb/ref 17592186126845} {:answer/id #uuid "10dbf042-1fb5-5a2a-9c60-88dc1897734a" :answer/type {:db/ident :answer.type/math} :answer/value "y = 1" :db/id #edb/ref 17592186126846} {:answer/id #uuid "2a9ea6b3-85d6-5c26-8e00-91d959c6ea53" :answer/type {:db/ident :answer.type/math} :answer/value "y = 5" :db/id #edb/ref 17592186126847} {:answer/id #uuid "35140d77-6bc7-522e-a4b6-6b2d9d5e7dda" :answer/type {:db/ident :answer.type/math} :answer/value "y =-5" :db/id #edb/ref 17592186126848}] :answer-field/id #uuid "4ca55e4f-7957-562a-bb00-f3b76b1ea9e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126843}] :question/id #uuid "411be2a6-219d-561e-9f5e-b4e6962a294f" :question/math-academy-id "q-236750" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-9$ and a maximum value of $1$."} {:db/id #edb/ref 17592186129562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe8c2d-22ae-5a74-9fb5-b44fdb8cce26" :answer/type {:db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186288150} {:answer/id #uuid "3f9156c5-37a7-56f3-b8d3-991ed27e42a2" :answer/type {:db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288465} {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} {:answer/id #uuid "d650ff67-6889-5b78-bc90-d9ce4271c33c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186289456} {:answer/id #uuid "d7360b5c-2ef2-52b6-a3be-6f516c9b4151" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186289463}] :answer-field/correct {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} :answer-field/id #uuid "b0fa4e38-53cb-50b5-ba34-1bae28b400d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290121}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "723b13df-bde4-592d-ade7-17cdd1dad568" :question/math-academy-id "q-236896" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-5$ and a maximum value of $9.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+9}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"} {:db/id #edb/ref 17592186233657 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0c0ba785-82d4-51d4-ba62-9a6ddfc19813" :question/math-academy-id "q-236892" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $0$ and a maximum value of $4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{0+4}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"} {:db/id #edb/ref 17592186233658 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e065fd0c-2f57-53e6-b566-95ea17332857" :question/math-academy-id "q-236903" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-14$ and a maximum value of $-4.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-14+(-4)}{2} \\\\  & =\\frac{-18}{2} \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-9.$"} {:db/id #edb/ref 17592186290474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fd40bfd-062b-544e-82e4-2ec772085df7" :answer/type {:db/ident :answer.type/math} :answer/value "y=10" :db/id #edb/ref 17592186288466} {:answer/id #uuid "8e5e3c1c-7364-5f79-b142-fdd7f16b88c1" :answer/type {:db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186288985} {:answer/id #uuid "8ea149b8-4046-5f9a-86fb-993d32d1547b" :answer/type {:db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288986} {:answer/id #uuid "b95d738d-433a-5a37-9962-7b7f42af9eb6" :answer/type {:db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186289257} {:answer/id #uuid "c589d6c6-0ea0-572a-8640-cb03b9f272b8" :answer/type {:db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289341}] :answer-field/correct {:answer/id #uuid "8ea149b8-4046-5f9a-86fb-993d32d1547b" :answer/type {:db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288986} :answer-field/id #uuid "93e769bf-84dc-5265-92dd-ad238215d9bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290060}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b9b62cc-429e-52b2-9f37-7f9e4fb21a23" :question/math-academy-id "q-236890" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $2$ and a maximum value of $10.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{2+10}{2} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the midline is $y=6.$"} {:db/id #edb/ref 17592186290475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} {:answer/id #uuid "4a00572c-39f3-51f2-908d-92627f661500" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186288544} {:answer/id #uuid "a37b2fb0-553a-530f-99ca-b90f84cdee3f" :answer/type {:db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186289123} {:answer/id #uuid "ab1273fc-bf67-57d2-a722-130587889698" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186289164} {:answer/id #uuid "f95f3f20-7128-592d-a073-380a9759c7df" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186289672}] :answer-field/correct {:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} :answer-field/id #uuid "246102b7-25b3-5a75-9c7c-581da5239b11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289815}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "250619d1-370b-5c0d-af5b-ed64a801198a" :question/math-academy-id "q-236893" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-7$ and a maximum value of $3.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-7+3}{2} \\\\  & =\\frac{-4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-2.$"} {:db/id #edb/ref 17592186290476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2a6538-c236-5b1a-b158-96a6be4f1748" :answer/type {:db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186288200} {:answer/id #uuid "1dffc632-f16c-55e1-9b97-d1c5aeae6758" :answer/type {:db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288222} {:answer/id #uuid "8543a8fe-b744-523c-b7fb-7c470ba81d14" :answer/type {:db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288931} {:answer/id #uuid "bb0a5dd6-d308-583b-b134-199f67a9d04b" :answer/type {:db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186289267} {:answer/id #uuid "ffd48777-993d-5f12-a8f2-e3af62e80d7b" :answer/type {:db/ident :answer.type/math} :answer/value "y=10" :db/id #edb/ref 17592186289727}] :answer-field/correct {:answer/id #uuid "bb0a5dd6-d308-583b-b134-199f67a9d04b" :answer/type {:db/ident :answer.type/math} :answer/value "y=8" :db/id #edb/ref 17592186289267} :answer-field/id #uuid "2687fc32-533f-593d-8d64-483ed7bd132f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289820}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "19d7902b-1be6-510b-930b-715d7217e72b" :question/math-academy-id "q-236899" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $6$ and a maximum value of $10.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{6+10}{2} \\\\  & =\\frac{16}{2} \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, the midline is $y=8.$"} {:db/id #edb/ref 17592186290477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f675d33-9792-5f53-b7b9-f9536f49fb90" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186288142} {:answer/id #uuid "18eea2d3-d7aa-5ce2-95b1-3436a75fdf6a" :answer/type {:db/ident :answer.type/math} :answer/value "y=12" :db/id #edb/ref 17592186288192} {:answer/id #uuid "46157afd-69d5-5ce4-ad51-f9464b541346" :answer/type {:db/ident :answer.type/math} :answer/value "y=6" :db/id #edb/ref 17592186288511} {:answer/id #uuid "80c01211-152d-5bc4-83af-258dcbd2d63b" :answer/type {:db/ident :answer.type/math} :answer/value "y=15" :db/id #edb/ref 17592186288900} {:answer/id #uuid "cf212491-b8c6-5480-a89e-4b6471b10f23" :answer/type {:db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186289414}] :answer-field/correct {:answer/id #uuid "cf212491-b8c6-5480-a89e-4b6471b10f23" :answer/type {:db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186289414} :answer-field/id #uuid "f7defb23-ecb8-5959-b191-fd609b6b1d79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290242}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d0c4be84-8850-5ae2-a033-a27a5aa083d4" :question/math-academy-id "q-236901" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $3$ and a maximum value of $15.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{3+15}{2} \\\\  & =\\frac{18}{2} \\\\  & =9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=9.$"}] :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] [{:db/id #edb/ref 17592186129124 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128879 :question/id #uuid "61b6821f-3ee5-5dd8-b8a3-ee1859645237" :question/math-academy-id "e-15611" :question/problem "What is the range of the function $f(x) = -4\\cos(3x)-2?$" :question/worked-solution "The range of $\\cos x$ is\n\n$$\n-1 \\leq \\cos x \\leq 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\leq\\cos\\left(3x \\right) \\leq 1.\n$$\n\nMultiplying the above inequality by $-4$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡(3x)\\le 1 \\\\ 4 & \\ge -4\\operatorname{cos}⁡(3x)\\ge -4 \\\\ 2 & \\ge -4\\operatorname{cos}⁡(3x)-2\\ge -6 \\\\ -6 & \\le f(x)\\le 2.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-6,2].$"} :knowledge-point/id #uuid "5696c2d5-4e35-5ed3-a4a2-6fe9b158e461" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049707 :topic/math-academy-id 754 :topic/title "The Range of a Function"} {:db/id #edb/ref 17592186050734 :topic/math-academy-id 388 :topic/title "Solving Compound Inequalities"}] :knowledge-point/questions [{:db/id #edb/ref 17592186129402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa4dfa97-3f07-5567-8750-354f30d3bb6c" :answer/type {:db/ident :answer.type/math} :answer/value "y ∈ [- 7,-1]" :db/id #edb/ref 17592186125913} {:answer/id #uuid "0762c47c-21fb-5163-a406-96a9be3d58cb" :answer/type {:db/ident :answer.type/math} :answer/value "y ∈ [- 3, 3]" :db/id #edb/ref 17592186125914} {:answer/id #uuid "2a6936e4-5181-5162-bdd9-123c1faeca22" :answer/type {:db/ident :answer.type/math} :answer/value "y ∈ [- 1, 1]" :db/id #edb/ref 17592186125915} {:answer/id #uuid "2fbbf1f8-d357-55ff-a29c-402606b30540" :answer/type {:db/ident :answer.type/math} :answer/value "y ∈ [- 7, 1]" :db/id #edb/ref 17592186125916} {:answer/id #uuid "6ae56e90-9f1d-5606-9be5-28722497106f" :answer/type {:db/ident :answer.type/math} :answer/value "y ∈ [- 4, 4]" :db/id #edb/ref 17592186125917}] :answer-field/id #uuid "63d1fe39-af31-57a3-bd68-bea4f64dce00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186125912}] :question/id #uuid "e4da1620-07d2-569d-b915-84247670b54c" :question/math-academy-id "q-10249" :question/problem "Find the range of the function $y = 3\\sin (2x + 1) - 4$."} {:db/id #edb/ref 17592186129768 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0ef8c22-f84b-5450-ba53-f513cd2e8d8a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186128090} {:answer/id #uuid "f39f7275-b997-50eb-bfe6-5386d1bd0c96" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186128091} {:answer/id #uuid "35652bf7-d7f8-545e-a697-6d6f7dd7d218" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186128092} {:answer/id #uuid "3cb0de2a-4744-5f7a-a1b7-5be8f4e10aa4" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186128093} {:answer/id #uuid "5e478863-f5ae-5093-89d0-33aafa8dece6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186128094}] :answer-field/id #uuid "8c7b6e5e-0594-58f5-86e9-fbfd11180ced" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128089}] :question/id #uuid "461f90fa-99b0-5fee-bcc1-f1621ef2267d" :question/math-academy-id "q-40977" :question/problem "What is the minimum value of $f(x) =-\\cos (x + \\frac{π}{4}) + 3$?"} {:db/id #edb/ref 17592186233683 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "efc3b489-6805-58cd-9ffd-9dce88f3406c" :question/math-academy-id "q-25512" :question/problem "Find the range of the function $f(x)=-2\\operatorname{sin}(3x)+1.$" :question/worked-solution "The range of $\\operatorname{sin}x$ is\n\n$$\n-1\\le \\operatorname{sin}x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}(3x)\\le 1.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $1$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}(3x)\\le 1 \\\\  & 2\\ge -2\\operatorname{sin}(2x)\\ge -2 \\\\  & 3\\ge -2\\operatorname{sin}(2x)+1\\ge -1 \\\\  & -1\\le f(x)\\le 3.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-1,3].$"} {:db/id #edb/ref 17592186234034 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "35cc2bef-7c45-5174-b681-8a4353622923" :question/math-academy-id "q-40908" :question/problem "What is the range of the function $f(x)=4\\operatorname{sin}(x+{30}^{∘})-2?$" :question/worked-solution "The range of $\\operatorname{sin}x$ is\n\n$$\n-1\\le \\operatorname{sin}x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}(x+{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $4$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}(x+{30}^{∘})\\le 1 \\\\  & -4\\le 4\\operatorname{sin}(x+{30}^{∘})\\le 4 \\\\  & -6\\le 4\\operatorname{sin}(x+{30}^{∘})-2\\le 2 \\\\  & -6\\le f(x)\\le 2.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-6,2].$"} {:db/id #edb/ref 17592186238052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bee8a09-1b10-5d3b-a3e0-53f487269fbd" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in (-4,0)" :db/id #edb/ref 17592186236092} {:answer/id #uuid "3ae5f17b-6d77-50aa-9f3e-7b11978d9ef3" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-4,0]" :db/id #edb/ref 17592186236187} {:answer/id #uuid "6e51c3bd-ccb5-5657-a12f-be75f9b7421d" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in (-4,0]" :db/id #edb/ref 17592186236517} {:answer/id #uuid "8af5fbbe-fd48-522b-bd11-fcef14c27e77" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-4,0)" :db/id #edb/ref 17592186236685} {:answer/id #uuid "c5deb01d-4513-5f86-8831-7f209ca52bc7" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186237069}] :answer-field/correct {:answer/id #uuid "3ae5f17b-6d77-50aa-9f3e-7b11978d9ef3" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-4,0]" :db/id #edb/ref 17592186236187} :answer-field/id #uuid "823dc40d-4f4d-5208-b833-113087963ad8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237612}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9b3308de-6d92-5bb6-a7a9-50e3ea31e7e7" :question/math-academy-id "q-10379" :question/problem "Find the range of the function $y=2\\operatorname{cos}⁡(4x)-2.$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(4x)\\le 1.\n$$\n\nMultiplying the above inequality by $2$ and then subtracting $2,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(4x)\\le 1 \\\\  & -2\\le 2\\operatorname{cos}⁡(4x)\\le 2 \\\\  & -4\\le 2\\operatorname{cos}⁡(4x)-2\\le 0 \\\\  & -4\\le y\\le 0.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [-4,0].$"} {:db/id #edb/ref 17592186326892 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46dbfb94-8f7e-52b5-a0bc-216cfa3f3688" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-1,5]" :db/id #edb/ref 17592186324540} {:answer/id #uuid "761814c1-8f36-5a1f-a9c3-df54f177de2c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-6,1]" :db/id #edb/ref 17592186324952} {:answer/id #uuid "8d0d2ae8-7e42-557f-930a-2314bd90d992" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [0,4]" :db/id #edb/ref 17592186325169} {:answer/id #uuid "b06eafb2-11d2-56a5-ab67-ec95fe6b25ba" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-3,3]" :db/id #edb/ref 17592186325476} {:answer/id #uuid "b37f5dc8-1fd1-5b76-b5e2-0cd483be88a8" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-4,0]" :db/id #edb/ref 17592186325510}] :answer-field/correct {:answer/id #uuid "46dbfb94-8f7e-52b5-a0bc-216cfa3f3688" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\in [-1,5]" :db/id #edb/ref 17592186324540} :answer-field/id #uuid "19ba0b8e-1c6b-5fd4-a9f9-80b8a5cf11c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326269}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9d95e69c-d8b6-504a-9a9e-0e0569042175" :question/math-academy-id "q-40903" :question/problem "What is the range of $f(x)=3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})+2?$" :question/worked-solution "The range of $\\operatorname{sin}⁡x$ is\n\n$$\n-1\\le \\operatorname{sin}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 1.\n$$\n\nMultiplying the above inequality by $3$ and then adding $2$, we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 1 \\\\  & -3\\le 3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})\\le 3 \\\\  & -1\\le 3\\operatorname{sin}⁡(x+\\frac{\\pi }{6})+2\\le 5 \\\\  & -1\\le f(x)\\le 5.\\end{aligned}\n$$\n\nTherefore, the range is $f(x)\\in [-1,5].$"} {:db/id #edb/ref 17592186326912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d1c4191-fab1-56ef-9a9e-5df4f5a37573" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [4,6]" :db/id #edb/ref 17592186324871} {:answer/id #uuid "705447cb-ac85-5790-aadf-544a4a2ca55d" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-2,6]" :db/id #edb/ref 17592186324896} {:answer/id #uuid "c37b50d3-93b0-5e4b-a2f6-ad5ca8b620b9" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [3,6]" :db/id #edb/ref 17592186325652} {:answer/id #uuid "d9fbb5f9-1876-576d-956d-164f993762da" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [2,4]" :db/id #edb/ref 17592186325870} {:answer/id #uuid "e3d1017a-3133-56bf-ad84-e9bd0f77a8d9" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [2,6]" :db/id #edb/ref 17592186325976}] :answer-field/correct {:answer/id #uuid "e3d1017a-3133-56bf-ad84-e9bd0f77a8d9" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [2,6]" :db/id #edb/ref 17592186325976} :answer-field/id #uuid "5600e685-5275-5ef3-a75f-13f121192c83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326367}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8be6063d-ee1d-5aea-9fe3-f1f6572dff56" :question/math-academy-id "q-41840" :question/problem "What is the range of the function $y=-2\\operatorname{sin}⁡(x+{30}^{∘})+4?$" :question/worked-solution "The range of $\\operatorname{sin}⁡x$ is\n\n$$\n-1\\le \\operatorname{sin}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}⁡(x+{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $4$, we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡(x+{30}^{∘})\\le 1 \\\\ 2 & \\ge -2\\operatorname{sin}⁡(x+{30}^{∘})\\ge -2 \\\\ 6 & \\ge -2\\operatorname{sin}⁡(x+{30}^{∘})+4\\ge 2 \\\\ 2 & \\le y\\le 6.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [2,6].$"} {:db/id #edb/ref 17592186326917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04840a88-e955-54d7-9016-ac6fea11fba3" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-5,3]" :db/id #edb/ref 17592186324015} {:answer/id #uuid "38292c02-f847-53f2-a45b-6862fdc0c0e8" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-5,4]" :db/id #edb/ref 17592186324427} {:answer/id #uuid "6ac3ca11-8380-5948-90cd-da2a9257a2a6" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-1,5]" :db/id #edb/ref 17592186324863} {:answer/id #uuid "a6982aa2-f584-5158-bc82-602dcb0974ec" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [0,2]" :db/id #edb/ref 17592186325391} {:answer/id #uuid "f6deb213-4583-5f6b-81ae-fc1650ade5aa" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-3,5]" :db/id #edb/ref 17592186326145}] :answer-field/correct {:answer/id #uuid "f6deb213-4583-5f6b-81ae-fc1650ade5aa" :answer/type {:db/ident :answer.type/math} :answer/value "y\\in [-3,5]" :db/id #edb/ref 17592186326145} :answer-field/id #uuid "fd64b16d-a8fc-5173-a59f-621cbfcddda1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326667}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "87e222c7-c912-54d0-9c4f-f1a9126f53ea" :question/math-academy-id "q-41964" :question/problem "What is the range of the function $y=-4\\operatorname{cos}⁡(x-{30}^{∘})+1?$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(x-{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $-4$ and then adding $1,$ we get\n\n$$\n\\begin{aligned} & -1\\le \\operatorname{cos}⁡(x-{30}^{∘})\\le 1 \\\\  & 4\\ge -4\\operatorname{cos}⁡(x-{30}^{∘})\\ge -4 \\\\  & 5\\ge -4\\operatorname{cos}⁡(x-{30}^{∘})+1\\ge -3 \\\\  & -3\\le y\\le 5.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [-3,5].$"} {:db/id #edb/ref 17592186335863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049dd516-6944-5edb-9121-db6169976ff5" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186333026} {:answer/id #uuid "0a8d3b55-d51c-51d5-bd6a-0541774185bc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333086} {:answer/id #uuid "1a966c12-73ac-529e-b12c-6d9225d16bae" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333234} {:answer/id #uuid "62773bc4-d26b-5f61-9e63-bc7fe7b85b79" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186333884} {:answer/id #uuid "680b922e-06f1-58c6-a230-4f635170ac17" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333942}] :answer-field/correct {:answer/id #uuid "1a966c12-73ac-529e-b12c-6d9225d16bae" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333234} :answer-field/id #uuid "10ca3b69-16be-55a0-a521-16c8667ae7c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335272}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "df79444b-bf13-5349-9442-8567f87e370a" :question/math-academy-id "q-65928" :question/problem "What is the minimum value of $f(x)=-\\operatorname{cos}⁡(3x+\\pi )-4?$" :question/worked-solution "The range of $\\operatorname{cos}⁡x$ is\n\n$$\n-1\\le \\operatorname{cos}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{cos}⁡(3x+\\pi )\\le 1.\n$$\n\nMultiplying the above inequality by $-1$ and then subtracting $4,$ we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡(3x+\\pi )\\le 1 \\\\ 1 & \\ge -\\operatorname{cos}⁡(3x+\\pi )\\ge -1 \\\\ -3 & \\ge -\\operatorname{cos}⁡(3x+\\pi )-4\\ge -5 \\\\ -5 & \\le f(x)\\le -3.\\end{aligned}\n$$\n\nTherefore, the minimum value is $-5.$"}] :knowledge-point/title "Finding the Range of a Transformed Sinusoidal Function"}] [{:db/id #edb/ref 17592186129145 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128960 :question/id #uuid "2f03be7e-0a77-5869-b591-6a8f8f3942de" :question/math-academy-id "e-5814" :question/problem "![](images/59/5970275bd70bcfd944c03abc8f60c2b159e3545dc876a0dd05bc23343b85bdec.png)\n\nWhich of the following could be the equation of the polynomial above?\n\n- $y=(x+2)(x+1)^2(x-2)$\n\n- $y=(x+2)^3(x+1)^2(x-2)$\n\n- $y=(x+2)(x+1)^2(x-2)^3$" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-2,$ $x=-1,$ and $x=2.$\n\nBased on the graph, we can make the following conclusions about the multiplicities:\n\n- Since the graph is *not* tangent to the $x$-axis at $x =-2,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph just touches the $x$-axis and reverses direction at $x =-1,$ this root has even multiplicity.\n\n- Since the graph passes through $x = 2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=2,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y= (x+2)(x+1)^2(x-2)^3.$"} :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/questions [{:db/id #edb/ref 17592186129690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83b06151-1ea9-5064-8aff-08bf63e0d416" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x(x + 1)(x - 1)(x + 2)" :db/id #edb/ref 17592186127622} {:answer/id #uuid "84d4f872-00ce-51c8-a6ca-36325b9d9779" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x(x + 1)^{2}(x - 1)(x + 2)" :db/id #edb/ref 17592186127623} {:answer/id #uuid "97472f95-56f9-59ee-97e9-95b2461feac4" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x^{2}(x + 1)(x - 1)^{2}" :db/id #edb/ref 17592186127624} {:answer/id #uuid "ee765f01-e447-554c-a501-1a610ca5262a" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x(x + 1)(x - 1)" :db/id #edb/ref 17592186127625} {:answer/id #uuid "39d4418e-d4e1-5dc7-980d-a9c125d0c18f" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x(x + 1)^{2}(x - 1)" :db/id #edb/ref 17592186127626}] :answer-field/id #uuid "116c4e32-9a54-5177-a715-af96a3549f1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127621}] :question/id #uuid "554c3d5c-456e-56d6-be80-86b327875e6d" :question/math-academy-id "q-38668" :question/problem "![](images/7e/7edd497f4981e5f612665b020fdaad9fe68968d6648dd52c4aa991c800386c4b.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?"} {:db/id #edb/ref 17592186129691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e159b70-940e-58fb-947e-3c1d83faac7b" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(x+3)(x+1)(x-2)" :db/id #edb/ref 17592186324098} {:answer/id #uuid "90aa4b93-0264-51e4-ba3b-df24bdf4f4be" :answer/type {:db/ident :answer.type/math} :answer/value "y=3(x+2)(x+1)(x-2)" :db/id #edb/ref 17592186325202} {:answer/id #uuid "ab825ca0-c2c4-51f3-89da-e0d689cdc75b" :answer/type {:db/ident :a