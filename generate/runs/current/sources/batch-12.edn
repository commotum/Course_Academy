#{[{:db/id #edb/ref 17592186059643 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059471 :question/id #uuid "9ee1e04e-8a36-5597-8928-c2ebd67c1b1a" :question/math-academy-id "e-3139" :question/problem "Simplify the trigonometric expression $\\dfrac{\\sin{\\theta}}{1+\\cos{\\theta}}+\\cot{\\theta}.$" :question/worked-solution "First, we rewrite the second term using the identity $\\cot \\theta = \\dfrac{\\cos\\theta}{\\sin\\theta},$ as follows:\n\n$$\n\\dfrac{\\sin{\\theta}}{1+\\cos{\\theta}}+\\dfrac{\\cos{\\theta}}{\\sin{\\theta}}\n$$\n\nNext, we put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta }{\\operatorname{sin}⁡\\theta (1+\\operatorname{cos}⁡\\theta )}+\\frac{\\operatorname{cos}⁡\\theta \\cdot (1+\\operatorname{cos}⁡\\theta )}{\\operatorname{sin}⁡\\theta (1+\\operatorname{cos}⁡\\theta )} & = \\\\ \\frac{\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta \\cdot (1+\\operatorname{cos}⁡\\theta )}{\\operatorname{sin}⁡\\theta (1+\\operatorname{cos}⁡\\theta )} & \\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta (1+\\operatorname{cos}⁡\\theta )} & = \\\\ \\frac{({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta (1+\\operatorname{cos}⁡\\theta )} & = \\\\ \\frac{1+\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta (1+\\operatorname{cos}⁡\\theta )} & = \\\\ \\frac{1}{\\operatorname{sin}⁡\\theta } & = \\\\ \\operatorname{csc}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\dfrac{\\sin{\\theta}}{1+\\cos{\\theta}}+\\cot{\\theta} = \\csc\\theta.\n$$"} :knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050310 :topic/math-academy-id 3739 :topic/title "Adding Rational Expressions With No Common Factors in the Denominator"} {:db/id #edb/ref 17592186050928 :topic/math-academy-id 611 :topic/title "The Reciprocal Trigonometric Ratios"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caf44729-aa03-5060-afd1-ad0ce37efea1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2} x" :db/id #edb/ref 17592186056791} {:answer/id #uuid "cc9b95ce-4ea6-53e7-8ac5-f06dd9ddf4a5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sec x" :db/id #edb/ref 17592186056792} {:answer/id #uuid "13450e27-68a9-554d-b372-0deaafb038b4" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec^{2} x" :db/id #edb/ref 17592186056793} {:answer/id #uuid "266a3d72-103c-5529-a849-8722f225f57b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec x" :db/id #edb/ref 17592186056794} {:answer/id #uuid "69bbfc14-5127-5ae1-887a-00e2b6d050af" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec x" :db/id #edb/ref 17592186056795}] :answer-field/id #uuid "d9fe3dda-992d-570f-8dfd-a1fd1f42c49d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056790}] :question/id #uuid "454abeb6-6857-55f9-9b96-e1e8469a574b" :question/math-academy-id "q-1579" :question/problem "What is $\\frac{\\cos x}{1 - \\sin x} - \\tan x$?"} {:db/id #edb/ref 17592186060226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de421596-8167-5804-a274-26143d902b00" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec θ" :db/id #edb/ref 17592186057999} {:answer/id #uuid "e6596922-d870-5815-8caa-c56e9eb91672" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec θ + 2" :db/id #edb/ref 17592186058000} {:answer/id #uuid "0c6b0625-764d-5d59-a350-645fee24dd01" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sec θ + 2" :db/id #edb/ref 17592186058001} {:answer/id #uuid "4ac4f308-7003-5153-ac12-b065fa7cf226" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sec θ" :db/id #edb/ref 17592186058002} {:answer/id #uuid "5b6c8933-02d9-504c-9440-ef1eca3dfac2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sec θ" :db/id #edb/ref 17592186058003}] :answer-field/id #uuid "d8f3fa84-4784-5fd5-9bd4-bf01c716de69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057998}] :question/id #uuid "2e719436-9bd8-5170-a19c-63ea0460d236" :question/math-academy-id "q-23522" :question/problem "What is $\\cos θ + \\frac{\\sin^{2} θ}{\\cos θ}$?"} {:db/id #edb/ref 17592186253594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5849bb-789c-55dc-b22f-663e67e3571e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186251441} {:answer/id #uuid "a278e6d5-4579-5dbc-89f7-1919dc0a81a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186251954} {:answer/id #uuid "c069559c-6260-51c1-a64b-9bed21216b27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186252252} {:answer/id #uuid "c802eca5-1c87-5dfc-ae16-0c9da3679cce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186252326} {:answer/id #uuid "f758c764-6980-50ac-860d-7a0a1279d166" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186252715}] :answer-field/correct {:answer/id #uuid "f758c764-6980-50ac-860d-7a0a1279d166" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186252715} :answer-field/id #uuid "862ad186-b2f1-59fa-b8f3-cd1202dce3d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253031}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d0d3dca9-aff5-5370-bb54-448ec1d2e38e" :question/math-academy-id "q-119764" :question/problem "Simplify the trigonometric expression $\\operatorname{tan}⁡x-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}.$" :question/worked-solution "First, we rewrite the first term using the definition of $\\operatorname{tan}⁡x.$ This gives\n\n$$\n\\operatorname{tan}⁡x-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}.\n$$\n\nNow, we put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}-\\frac{(1-\\operatorname{cos}⁡x)\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{{sin}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}-\\frac{\\operatorname{cos}⁡x-{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{{sin}^{2}⁡x-(\\operatorname{cos}⁡x-{cos}^{2}⁡x)}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{{sin}^{2}⁡x-\\operatorname{cos}⁡x+{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡x-\\operatorname{cos}⁡x+{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\operatorname{tan}⁡x-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\n$$"} {:db/id #edb/ref 17592186253596 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d921589-04fa-57cf-b244-978da47124ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186250802} {:answer/id #uuid "981af32a-b543-562f-a722-27d17840b262" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186251860} {:answer/id #uuid "a0a7046c-f34f-5960-95ca-1c2d73520766" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta \\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186251939} {:answer/id #uuid "a8221673-73e3-5e15-b330-5c44df97503f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186252005} {:answer/id #uuid "ad78031b-233e-5a8e-a9e2-0d0f1f88049e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186252064}] :answer-field/correct {:answer/id #uuid "1d921589-04fa-57cf-b244-978da47124ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186250802} :answer-field/id #uuid "31a95a2f-0045-5d71-b0d3-ea8658460213" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252891}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a82c56b9-720e-52fc-8dc1-2a735f11a49c" :question/math-academy-id "q-119767" :question/problem "$\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{1}{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{sin}⁡\\theta }\\cdot \\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }+\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\\operatorname{csc}⁡\\theta \\operatorname{sec}⁡\\theta .\n$$"} {:db/id #edb/ref 17592186253599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55eb6103-d65c-564e-8146-1b697fcf6114" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186251257} {:answer/id #uuid "9c494cc4-f14a-523f-afab-b55ead4e2206" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251902} {:answer/id #uuid "9cabf4a9-d334-52aa-94a3-29c1226a338c" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251905} {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} {:answer/id #uuid "cdfac5b4-b918-541c-bab0-02afa81cd836" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186252374}] :answer-field/correct {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} :answer-field/id #uuid "5889b846-4b45-54d4-a4c7-1acb0782d3ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252962}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8a4d16bb-7544-56af-8e64-b1dbb3f56d7c" :question/math-academy-id "q-119770" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{2+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x=1.\n$$"} {:db/id #edb/ref 17592186253600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d7b5f91-2c37-5fae-acd3-ab851569533c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186251452} {:answer/id #uuid "af37c521-a94c-5b77-88a6-5309b210c625" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{1+\\operatorname{sin}⁡\\theta }" :db/id #edb/ref 17592186252081} {:answer/id #uuid "c5e9a0ec-cc21-5425-9379-8a5af52437e0" :answer/type {:db/ident :answer.type/math} :answer/value "1+{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186252302} {:answer/id #uuid "d406df00-ed82-57c6-8bcb-2a684e461536" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{1+\\operatorname{sin}⁡\\theta }" :db/id #edb/ref 17592186252430} {:answer/id #uuid "de490b09-1c46-54be-978d-9843c9fa8296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186252509}] :answer-field/correct {:answer/id #uuid "6d7b5f91-2c37-5fae-acd3-ab851569533c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{1+{sin}^{2}⁡\\theta }" :db/id #edb/ref 17592186251452} :answer-field/id #uuid "54002820-442d-5036-9f81-7a9c962e49b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252953}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "655d2fb5-3fa2-5139-a053-7e43658638e3" :question/math-academy-id "q-119773" :question/problem "$1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } & =\\frac{1}{1}+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}} \\\\  & =\\frac{1\\cdot (1+{sin}^{2}⁡\\theta )}{1\\cdot (1+{sin}^{2}⁡\\theta )}+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}} \\\\  & =\\frac{1+{sin}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } \\\\  & =\\frac{1+{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{1+{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta } & =\\frac{1+1}{1+{sin}^{2}⁡\\theta } \\\\  & =\\frac{2}{1+{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n1+\\frac{{cos}^{2}⁡\\theta }{1+{sin}^{2}⁡\\theta }=\\frac{2}{1+{sin}^{2}⁡\\theta }.\n$$"} {:db/id #edb/ref 17592186253602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2853c65b-3f44-502d-a803-a0acd38f76b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186250898} {:answer/id #uuid "4b0ebc01-13f7-52d1-9ab2-4cd3a673ddd7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251177} {:answer/id #uuid "a0d9a327-adec-5add-ad89-f4382522907f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251942} {:answer/id #uuid "bd3e9417-953e-5115-a9a9-ba65d6cc8801" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186252225} {:answer/id #uuid "e9bf68d8-8dae-5276-becd-1ee419276ffc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+1" :db/id #edb/ref 17592186252600}] :answer-field/correct {:answer/id #uuid "bd3e9417-953e-5115-a9a9-ba65d6cc8801" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186252225} :answer-field/id #uuid "5f85872d-1cc7-59c2-b228-3710cc0bc671" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252976}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a48a9a21-fe38-560f-b14b-f3224e4f215c" :question/math-academy-id "q-119775" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x}{1}-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x}-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x(1-\\operatorname{sin}⁡x)-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x-{sin}^{2}⁡x-{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-({sin}^{2}⁡x+{cos}^{2}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x-1}{1-\\operatorname{sin}⁡x} \\\\  & =\\frac{-(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡x-\\frac{{cos}^{2}⁡x}{1-\\operatorname{sin}⁡x}=-1.\n$$"} {:db/id #edb/ref 17592186329714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c09847-2ab1-5fb6-aa84-b7fd83b2bb5e" :answer/type {:db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186327149} {:answer/id #uuid "68cf78c6-d0fb-5db7-80d9-19e5ac4e8c0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186327839} {:answer/id #uuid "6b1f2fd2-2e2b-561f-aee3-ea8774ddfad3" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186327858} {:answer/id #uuid "976c80ed-cab7-5eb4-bcd2-8cfa8928b4dc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186328245} {:answer/id #uuid "e0257c29-bec9-5ad9-85a7-a7ff4ac96f7e" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186328896}] :answer-field/correct {:answer/id #uuid "976c80ed-cab7-5eb4-bcd2-8cfa8928b4dc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186328245} :answer-field/id #uuid "6982ad4e-ae8e-5626-9538-ed0986cbdc90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329369}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "42f409ec-583f-5739-b6a6-cc4f7712efc0" :question/math-academy-id "q-43291" :question/problem "Simplify $\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta }+\\frac{(1-\\operatorname{sin}⁡\\theta )(1-\\operatorname{sin}⁡\\theta )}{\\operatorname{cos}⁡\\theta (1-\\operatorname{sin}⁡\\theta )} \\\\  & =\\frac{{cos}^{2}⁡\\theta +{(1-\\operatorname{sin}⁡\\theta )}^{2}}{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡\\theta +{(1-\\operatorname{sin}⁡\\theta )}^{2}}{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } & =\\frac{{cos}^{2}⁡\\theta +1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+1-2\\operatorname{sin}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{1+1-2\\operatorname{sin}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{2-2\\operatorname{sin}⁡\\theta }{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{2(1-\\operatorname{sin}⁡\\theta )}{(1-\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{2}{\\operatorname{cos}⁡\\theta } \\\\  & =2\\operatorname{sec}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡\\theta }{1-\\operatorname{sin}⁡\\theta }+\\frac{1-\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }=2\\operatorname{sec}⁡\\theta .\n$$"} {:db/id #edb/ref 17592186329718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d51a21-90c5-5b54-a6e4-e0b0b8a2ed02" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t+1" :db/id #edb/ref 17592186327134} {:answer/id #uuid "40320fe3-c500-5dcb-a7c9-96f211e3f18e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186327498} {:answer/id #uuid "7a98372a-b734-5075-bb5b-a84d747704c2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t-1" :db/id #edb/ref 17592186327984} {:answer/id #uuid "95f2320a-4032-50dc-aeeb-456b3b00cb5f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t+1" :db/id #edb/ref 17592186328238} {:answer/id #uuid "ace65715-85a6-5e2d-ba3b-d82ca77a9505" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t" :db/id #edb/ref 17592186328434}] :answer-field/correct {:answer/id #uuid "40320fe3-c500-5dcb-a7c9-96f211e3f18e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186327498} :answer-field/id #uuid "34fb1090-54c7-5d88-a697-5bc7387e677b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329286}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "db749ad3-a154-5aac-9219-0c39bfac704c" :question/math-academy-id "q-43298" :question/problem "$\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}) & =\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t}{\\operatorname{sin}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\cancel{\\operatorname{sin}⁡t}}{\\cancel{\\operatorname{sin}⁡t}}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\operatorname{cos}⁡t+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nWe put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta +\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} & =\\frac{\\operatorname{cos}⁡t}{1}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t}{1\\cdot \\operatorname{cos}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}=\\frac{1}{\\operatorname{cos}⁡t}=\\operatorname{sec}⁡t\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=\\operatorname{sec}⁡t.\n$$"} {:db/id #edb/ref 17592186335821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c8084f1-6841-5a83-a0a9-4728de9177be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186333559} {:answer/id #uuid "a9738497-c928-53c7-8246-c23024c54d5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186334474} {:answer/id #uuid "aad6e45d-c5bf-55b1-a13f-acf62c66eee4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186334487} {:answer/id #uuid "d576eaef-5d3b-5f62-8b03-59e2ff4a958a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{sin}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186334862} {:answer/id #uuid "e0c1b629-8341-58b0-b93c-f2b6b2df8050" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186334946}] :answer-field/correct {:answer/id #uuid "e0c1b629-8341-58b0-b93c-f2b6b2df8050" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186334946} :answer-field/id #uuid "b580d327-d2db-5160-9423-8dcb2cbf4ce5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335576}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e7530664-1986-510e-beca-1909e1fcad46" :question/math-academy-id "q-65254" :question/problem "$\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\operatorname{sin}⁡x=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & \\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\frac{\\operatorname{sin}⁡x(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{1(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x} & =\\frac{{cos}^{2}⁡x+{sin}^{2}⁡x+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x} \\\\  & =\\frac{({cos}^{2}⁡x+{sin}^{2}⁡x)+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\operatorname{sin}⁡x=\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}.\n$$"} {:db/id #edb/ref 17592186341847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e32204-b57f-51f4-9028-656492f4466e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186339756} {:answer/id #uuid "4b83938a-b3d9-50a4-a9ef-f655cf87e947" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x-1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186339806} {:answer/id #uuid "61a071b8-8278-5181-97b3-31ae95cf4439" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186339999} {:answer/id #uuid "7e365f2c-7be7-5a6c-bb21-4f90b3aae003" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186340266} {:answer/id #uuid "c3a927e5-02b7-5789-b37b-2831c6b2b5ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186340868}] :answer-field/correct {:answer/id #uuid "61a071b8-8278-5181-97b3-31ae95cf4439" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186339999} :answer-field/id #uuid "446108f8-7f35-5931-91d5-61b1fc42e37e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341501}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "dce072f1-1bfb-5e57-9eb5-e624cb48ce45" :question/math-academy-id "q-72715" :question/problem "Simplify the trigonometric expression $\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x.$" :question/worked-solution "First, we rewrite the second term using the definition of $\\operatorname{tan}⁡x.$ This gives:\n\n$$\n\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$\n\nWe put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\frac{(1+\\operatorname{cos}⁡x)\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}+\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x+{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}+\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x+{cos}^{2}⁡x+{sin}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x+{cos}^{2}⁡x+{sin}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} & =\\frac{\\operatorname{cos}⁡x+({cos}^{2}⁡x+{sin}^{2}⁡x)}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\n$$"}] :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] [{:db/id #edb/ref 17592186059655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059486 :question/id #uuid "d917e025-59a4-5df5-b412-4eb6f2c4afc7" :question/math-academy-id "e-3329" :question/problem "Simplify the expression $\\sin x(2\\cos x - \\sin x) - \\cos^2x.$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x\\operatorname{cos}⁡x-{sin}^{2}⁡x-{cos}^{2}⁡x\\end{aligned}\n$$\n\nNext, we group the $\\sin^2 x$ and $\\cos^2 x$ terms. \n\n$$\n2\\sin x\\cos x -(\\sin^2x + \\cos^2 x)\n$$\n\nThen, we use $\\sin^2{x} + \\cos^2{x} = 1$ to simplify the expression in the parentheses:\n\n$$\n2\\sin x\\cos x - 1\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin x(2\\cos x - \\sin x) - \\cos^2x = 2\\sin x\\cos x - 1.\n$$"} :knowledge-point/id #uuid "ec62fd08-5729-5dc4-97b9-1a422f70109e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048867 :topic/math-academy-id 203 :topic/title "Simplifying Expressions Using Basic Trigonometric Identities"} {:db/id #edb/ref 17592186050818 :topic/math-academy-id 371 :topic/title "Multiplying Binomials"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8df8b818-0930-5639-b4a1-ad518eba7033" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186056785} {:answer/id #uuid "c693be5b-d9c6-5b58-b0cc-b463fe702aca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056786} {:answer/id #uuid "11a72960-3ccb-5e7e-8e5b-9bae45b9e145" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186056787} {:answer/id #uuid "55372a31-da38-5d71-8d44-05c985c2e838" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186056788} {:answer/id #uuid "70b2fbd1-609f-5b86-9317-c1df76393f6f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186056789}] :answer-field/id #uuid "8438eb9d-4689-506c-baa3-bf43fb2925d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056784}] :question/id #uuid "42990716-c346-5987-b709-e9a6920ea807" :question/math-academy-id "q-1578" :question/problem "What is $(\\sin x - \\cos x)^{2} + (\\sin x + \\cos x)^{2}$?"} {:db/id #edb/ref 17592186060343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c86c4a78-21c0-5077-b5d6-2c8e5efd96b7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186058681} {:answer/id #uuid "f30e1138-5284-51ea-a2ca-19c19dad8edb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186058682} {:answer/id #uuid "328bdc2b-657f-5e7b-b85c-009cfa95d3f1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186