#{[{:db/id #edb/ref 17592186087839 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087515 :question/id #uuid "446ea007-1ff4-5023-8e3f-7f00eb0fb2d0" :question/math-academy-id "e-5071" :question/problem "What is the equation of the ellipse given below?\n\n![](images/6d/6d2ba3fba1a05a841a486553ea3a52d6f3797974630420ad79ae50f4c6f5bc15.png)" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\dfrac{x^2}{a^2}+\\dfrac{y^2}{b^2}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=5$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{5}^{2}}+\\frac{{y}^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9} & =1.\\end{aligned}\n$$"} :knowledge-point/id #uuid "f88c1deb-cd11-5b68-b90b-2d8edfae2469" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048432 :topic/math-academy-id 853 :topic/title "Introduction to Ellipses"} {:db/id #edb/ref 17592186048811 :topic/math-academy-id 842 :topic/title "Equations of Circles Centered at the Origin"}] :knowledge-point/questions [{:db/id #edb/ref 17592186088323 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f245cc5-cf66-5e23-941f-5ed3c61f8519" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{x}^{2}}{7}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186342368} {:answer/id #uuid "2aaf0f54-99ea-5f51-b032-c17b629e54df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186342595} {:answer/id #uuid "b0519dd2-e0e8-5e54-915c-ce7ec5a247b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9{x}^{2}}{24}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186343788} {:answer/id #uuid "f625dd86-0749-5723-adf5-e39041ad4f8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344405} {:answer/id #uuid "fb39f685-9e2f-50ea-ae5a-250fc73349a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344448}] :answer-field/correct {:answer/id #uuid "f625dd86-0749-5723-adf5-e39041ad4f8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186344405} :answer-field/id #uuid "65e8416d-99db-5904-9535-5182a7fbb499" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344665}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0f8eff0d-f84c-5907-a2c9-a5a7eb91d57f" :question/math-academy-id "q-7603" :question/problem "![](images/8a/8ac809353e7834d328d645fafb5c02e17386ba087e778a841865ef6313893e79.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=\\frac{7}{2}$ and the vertical radius has length $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3.5}^{2}}+\\frac{{y}^{2}}{{2}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{(\\frac{7}{2})}^{2}}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{(\\frac{{7}^{2}}{{2}^{2}})}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{(\\frac{49}{4})}+\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{4{x}^{2}}{49}+\\frac{{y}^{2}}{4} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186088324 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17dbb695-a8da-50c8-bbc0-8305a0e101a4" :answer/type {:db/ident :answer.type/math} :answer/val