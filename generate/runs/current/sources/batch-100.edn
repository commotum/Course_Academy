ipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{(\\frac{9}{2})}^{2}}+\\frac{{y}^{2}}{{(\\frac{13}{2})}^{2}} & =1 \\\\ \\frac{{x}^{2}}{(\\frac{81}{4})}+\\frac{{y}^{2}}{(\\frac{169}{4})} & =1 \\\\ \\frac{4{x}^{2}}{81}+\\frac{4{y}^{2}}{169} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186336014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b3bb62-33b0-5fec-8deb-ae6cde1bb204" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{8}=1" :db/id #edb/ref 17592186333142} {:answer/id #uuid "57b12094-7cc6-57f1-9a04-7d107daa9163" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186333789} {:answer/id #uuid "723d2d46-f03f-5f70-9a86-d1649d7ce1a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+{y}^{2}=1" :db/id #edb/ref 17592186334024} {:answer/id #uuid "c1a9b15c-1941-5024-81d9-ee6347a6b3e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+{y}^{2}=1" :db/id #edb/ref 17592186334669} {:answer/id #uuid "ff431699-49d9-55e7-9957-c34cb6f5df16" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186335235}] :answer-field/correct {:answer/id #uuid "ff431699-49d9-55e7-9957-c34cb6f5df16" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186335235} :answer-field/id #uuid "bfa364a8-de07-5a0a-aec8-fc0fb7bebdf9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335590}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "daa08063-18f2-5c3f-bfa5-03e9e47d2153" :question/math-academy-id "q-69892" :question/problem "![](images/1a/1acc2d6b8387947ff7186322796e273bcec366810ad73ac0025494ab627e06b2.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-sol