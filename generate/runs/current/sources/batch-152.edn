ld.type/radio} :db/id #edb/ref 17592186398264}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8904abf3-dbf2-549a-8f8b-9fbdb7308ad3" :question/math-academy-id "q-125561" :question/problem "Find the entry ${e}_{31}$ of the matrix $E$, where \n\n$$\nE=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${e}_{31}$ lies at the intersection of the $3$rd row and $1$st column. Therefore, ${e}_{31}=-3.$\n\n$$\nE=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ -3 & 4\\end{aligned}]\n$$"}] :knowledge-point/title "Finding an Entry of a Matrix"}]}
