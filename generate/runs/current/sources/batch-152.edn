:answer/id #uuid "08bbec5d-c22e-5416-941f-e614581e5ee1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292968}] :answer-field/correct {:answer/id #uuid "08bbec5d-c22e-5416-941f-e614581e5ee1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292968} :answer-field/id #uuid "6e95a709-acfb-50eb-82c6-8f68e1122c4b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294317}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e09062a5-fbd4-5002-8fc5-41df91866e41" :question/math-academy-id "q-279540" :question/problem "Find the entry ${f}_{32}$ of the matrix $F$, where \n\n$$\nF=[\\begin{aligned}4 & 5 & -2 & 0 \\\\ -2 & -1 & 2 & 5 \\\\ 3 & 4 & 0 & -3\\end{aligned}].\n$$\n\n${f}_{32}=$\n{{field-1}}" :question/worked-solution "The entry ${f}_{32}$ lies at the intersection of the $3$rd row and $2$nd column. Therefore, ${f}_{32}=4.$\n\n$$\nF=[\\begin{aligned}4 & 5 & -2 & 0 \\\\ -2 & -1 & 2 & 5 \\\\ 3 & 4 & 0 & -3\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186395748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13c60e5-0749-5b32-b12e-a8ade2bfafa4" :answer/type {:db/ident :answer.type/text} :answer/value "No such entry" :db/id #edb/ref 17592186395750} {:answer/id #uuid "934f3147-a632-5a7a-90a4-6abb01c749b5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186395751} {:answer/id #uuid "75f10e54-f429-5034-a07c-5f3a477a96f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395752} {:answer/id #uuid "fc409e78-b2db-5c05-a2e5-b9108d710f88" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395753} {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754}] :answer-field/correct {:answer/id #uuid "42e84e66-ce19-5239-