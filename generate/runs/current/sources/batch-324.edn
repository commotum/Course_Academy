png)\n\n  \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/83/83f2ac528d0e4bdd7e486284a9f3d5692e0111c5cdc58dcc554e12dd0185f15f.png)"} {:db/id #edb/ref 17592186362278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24b46e4f-6125-5427-8033-f6b5e164dc44" :answer/type {:db/ident :answer.type/image} :answer/value "images/2c/2c71db516bb0ab1514fe6e8979c980210c396fcafb88fd566ae9754ad0792bc8.png" :db/id #edb/ref 17592186360993} {:answer/id #uuid "4fec0a30-ce6c-5251-9629-d6a4cc45a554" :answer/type {:db/ident :answer.type/image} :answer/value "images/4e/4ea9eceec3de9b414efa87954d869119caf0748f152186aff5ede9bbade3f1fc.png" :db/id #edb/ref 17592186361187} {:answer/id #uuid "7702d12c-f585-5e66-b67b-93c532d96223" :answer/type {:db/ident :answer.type/image} :answer/value "images/74/7428d46543d8dd2def3e48b980643572dd661f5f7edc6cba304d64eb99439403.png" :db/id #edb/ref 17592186361365} {:answer/id #uuid "fbcaa236-6e83-556d-9413-da91fcda30a3" :answer/type {:db/ident :answer.type/image} :answer/value "images/cb/cb58d805bed05b6846fd0ab7657f8e05c65eb69562a6cda494689e44745fb9d1.png" :db/id #edb/ref 17592186361962} {:answer/id #uuid "fea37d7a-163c-5da3-8f1d-0d6bab2ddb5d" :answer/type {:db/ident :answer.type/image} :answer/value "images/d9/d94451671073d38af905b1190a15f97e6419a3a6052f83e53caa5a94b4a7000a.png" :db/id #edb/ref 17592186361975}] :answer-field/correct {:answer/id #uuid "4fec0a30-ce6c-5251-9629-d6a4cc45a554" :answer/type {:db/ident :answer.type/image} :answer/value "images/4e/4ea9eceec3de9b414efa87954d869119caf0748f152186aff5ede9bbade3f1fc.png" :db/id #edb/ref 17592186361187} :answer-field/id #uuid "baa9da19-6193-5649-bda4-a423b8957b5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362152}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b2eadfcb-db6a-5800-9cd9-5adcd903a84a" :question/math-academy-id "q-98229" :question/problem "Given that $f(x,y)$ varies with both $x$ and $y,$ which of the following **cannot** be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(x,y)?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope field varies with both $x$ and $y.$\n\nOf the given slope fields, we note the following slope field does not vary with $y$ given a fixed value of $x.$\n\n![](images/4e/4ea9eceec3de9b414efa87954d869119caf0748f152186aff5ede9bbade3f1fc.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line, the slopes do not vary.\n\n![](images/fe/fe2169790c1ee1d823937235bedd20ff10ecca662f030fd03dbfe23434517e47.png)"} {:db/id #edb/ref 17592186362279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f989087-946d-5b3c-a851-11e0aad7c255" :answer/type {:db/ident :answer.type/image} :answer/value "images/4e/4e286da41a3a0026ff7ee55649be2f0bdf5209e407a0f6fe96b3bbffa1295fb5.png" :db/id #edb/ref 17592186360891} {:answer/id #uuid "1110b134-e3de-5a68-abe0-02cce56908e2" :answer/type {:db/ident :answer.type/image} :answer/value "images/0b/0be25701c9d678977655081af50779401b207cbcd91a4c04cb32e8740180ae45.png" :db/id #edb/ref 17592186360897} {:answer/id #uuid "604167fb-e12a-5163-b44a-4e20940c69b2" :answer/type {:db/ident :answer.type/image} :answer/value "images/b4/b433458640a60ab79880fe94549be1071420948c1c809d5c43576d4aeed45510.png" :db/id #edb/ref 17592186361270} {:answer/id #uuid "688ee605-f5bc-54c3-8640-8f71633d1d5c" :answer/type {:db/ident :answer.type/image} :answer/value "images/8b/8b5ff8f702e76cb7108ae458447b38eed4d18e38336f54279f25d1c59c02e3b4.png" :db/id #edb/ref 17592186361307} {:answer/id #uuid "d569e669-62ba-5faa-80b1-48870007be96" :answer/type {:db/ident :answer.type/image} :answer/value "images/ae/ae