 has a slope of $-1.$\n\nMultiplying the slopes together, we have\n\n$$\n1\\cdot (-1)=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-x+9$ is perpendicular to the given line."} {:db/id #edb/ref 17592186339129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7f19f7-5593-5372-821e-d1252d3b8446" :answer/type {:db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186337587} {:answer/id #uuid "c0e66778-1d33-59c9-9c63-84193616625d" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x-3" :db/id #edb/ref 17592186337745} {:answer/id #uuid "cf4a56a8-6d0c-5363-9d42-b65beb462d50" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x+5" :db/id #edb/ref 17592186337846} {:answer/id #uuid "cf58d7b6-9e04-5b2a-b15f-7c5224686dfe" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x-1" :db/id #edb/ref 17592186337847} {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222}] :answer-field/correct {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222} :answer-field/id #uuid "833a989b-8bb1-589d-92ce-6ba9062090a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338511}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cdd0bbdf-150a-52db-a038-e888ce1f0809" :question/math-academy-id "q-72524" :question/problem "Which of the following lines is perpendicular to $y=-\\frac{x}{2}+7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\frac{x}{2}+7$ is in slope-intercept form, and its slope is $-\\frac{1}{2}.$\n\nLooking at the answer choices, the line $y=2x+19$ has a slope of $2.$\n\nMultiplying the slopes together, we have\n\n$$\n-\\frac{1}{2}\\cdot 2=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=2x+19$ is perpendicular to the given line."} {:db/id #edb/ref 17592186339130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011d16f2-0de4-5412-9dc8-f45155a4331b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}x-6" :db/id #edb/ref 17592186336042} {:answer/id #uuid "2652bd1c-0743-5d2d-9efc-004faa03dab5" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x-1" :db/id #edb/ref 17592186336395} {:answer/id #uuid "2f6b3b84-b257-5a0c-acc6-c31b6da27f1a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}" :db/id #edb/ref 17592186336487} {:answer/id #uuid "50d7c551-36eb-5138-901f-0d9eedfb90fd" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}x+6" :db/id #edb/ref 17592186336773} {:answer/id #uuid "6a23ebae-5f98-5fc9-8781-6a40fa1160b8" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186336973}] :answer-field/correct {:answer/id #uuid "011d16f2-0de4-5412-9dc8-f45155a4331b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}x-6" :db/id #edb/ref 17592186336042} :answer-field/id #uuid "06d71401-0f58-5333-a20e-1b0cca5daa8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338288}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "48d306d6-e8ce-55ca-9b15-7ab82015d64a" :question/math-academy-id "q-72527" :question/problem "Which of the following lines is perpendicular to $y=-4x+1?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-4x+1$ is in slope-intercept form, and its slope is $-4.$\n\nLooking at the answer choices, the line $y=\\frac{1}{4}x-6$ has a slope of $\\frac{1}{4}.$\n\nMultiplying the slopes together, we have\n\n$$\n-4\\cdot \\frac{1}{4}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{1}{4}x-6$ is perpendicular to the given line."} {:db/id #edb/ref 17592186339131 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0580b746-8762-5147-b2b0-f12b49d835da" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5x+\\frac{1}{2}" :db/id #edb/ref 17592186336076} {:answer/id #uuid "127a3120-e50e-549d-820e-7d075fa15b94" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}x-8" :db/id #edb/ref 17592186336206} {:answer/id #uuid "5e214309-eabf-5b01-b42a-9feaa43f9a74" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x+4" :db/id #edb/ref 17592186336884} {:answer/id #uuid "a2d70ca5-64f0-5c52-b91c-5135dc8ca0b1" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x+2" :db/id #edb/ref 17592186337511} {:answer/id #uuid "fa75d8fe-3935-5731-a7ef-48ccfccad2ba" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186338227}] :answer-field/correct {:answer/id #uuid "127a3120-e50e-549d-820e-7d075fa15b94" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}x-8" :db/id #edb/ref 17592186336206} :answer-field/id #uuid "0ee11dc1-28ec-55a9-b0cd-bdb93597b1a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338304}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd78939d-028b-5a50-bdc4-263e2efe5102" :question/math-academy-id "q-72528" :question/problem "Which of the following lines is perpendicular to $y=-5x-2?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-5x-2$ is in slope-intercept form, and its slope is $-5.$\n\nLooking at the answer choices, the line $y=\\frac{1}{5}x-8$ has a slope of $\\frac{1}{5}.$\n\nMultiplying the slopes together, we have\n\n$$\n-5\\cdot \\frac{1}{5}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{1}{5}x-8$ is perpendicular to the given line."}] :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] [{:db/id #edb/ref 17592186110600 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110343 :question/id #uuid "b5470454-6a27-5eda-a323-74ce90259f4c" :question/math-academy-id "e-14734" :question/problem "Which of the following lines is perpendicular to $4x - 2y = 10?$\n\n- $y = \\dfrac{1}{2}x + 3$\n\n- $y = -4x + 1$\n\n- $y = -\\dfrac{1}{2}x -5$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $4x - 2y = 10,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x-2y & =10 \\\\ -2y & =-4x+10 \\\\ y & =2x-5\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $2.$\n\nLooking at the answer choices, the line $y = -\\dfrac{1}{2}x -5$ has a slope of $-\\dfrac{1}{2}.$\n\nMultiplying the slopes together, we have\n\n$$\n2 \\cdot \\left(-\\dfrac{1}{2}\\right) = -1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y = -\\dfrac{1}{2}x -5$ is perpendicular to the given line.\n\nSo, the correct answer is \"III only\"."} :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049201 :topic/math-academy-id 3725 :topic/title "Properties of Lines Given in Standard Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186111184 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} {:answer/id #uuid "2a0d4423-cdbd-59bc-9519-c02229ca242c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x+1" :db/id #edb/ref 17592186327296} {:answer/id #uuid "842c8b78-fb24-5dfb-9556-59ef1eff7a4f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}x-6" :db/id #edb/ref 17592186328076} {:answer/id #uuid "8f307607-46e6-546c-b68f-66ba5c7a0d68" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x+15" :db/id #edb/ref 17592186328184} {:answer/id #uuid "b9b36271-f849-5b31-8979-398e7e127d62" :answer/type {:db/ident :answer.type/math} :answer/value "y=-5x-1" :db/id #edb/ref 17592186328554}] :answer-field/correct {:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} :answer-field/id #uuid "637a8d42-8d66-59a6-9b11-fb936c324619" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329359}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f8ebc497-48a2-5b22-a14f-221db06dd5d2" :question/math-academy-id "q-44404" :question/problem "Which of the following lines is perpendicular to $x+5y=10?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+5y=10,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+5y & =10 \\\\ 5y & =-x+10 \\\\ y & =-\\frac{1}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{5}.$\n\nLooking at the answer choices, the line $y=5x-4$ has a slope of $5.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{5})\\cdot 5=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=5x-4$ is perpendicular to the given line."} {:db/id #edb/ref 17592186111185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025034f1-82cf-50bd-b217-59910f87c75a" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x+8" :db/id #edb/ref 17592186326958} {:answer/id #uuid "6d46dac1-4725-5672-8e65-18abeaab3525" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3x-1" :db/id #edb/ref 17592186327882} {:answer/id #uuid "925c77f0-5d4e-5125-88a3-7ce5f47a232a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{4}{5}x" :db/id #edb/ref 17592186328208} {:answer/id #uuid "c3dc36e2-5932-534f-9989-a306dcf23224" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x+3" :db/id #edb/ref 17592186328647} {:answer/id #uuid "fffad00a-4af1-5e79-90fb-855c5bcce62a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x" :db/id #edb/ref 17592186329182}] :answer-field/correct {:answer/id #uuid "c3dc36e2-5932-534f-9989-a306dcf23224" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x+3" :db/id #edb/ref 17592186328647} :answer-field/id #uuid "0d54da50-b69e-52ba-a8a3-89d79a9cdec1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329204}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b7485dae-88b3-5eea-a431-272c46bd98d6" :question/math-academy-id "q-44514" :question/problem "Which of the following lines is perpendicular to $12x-4y=5?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $12x-4y=5,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}12x-4y & =5 \\\\ -4y & =-12x+5 \\\\ y & =3x-\\frac{5}{4}\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $3.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{3}x+3$ has a slope of $-\\frac{1}{3}.$\n\nMultiplying the slopes together, we have\n\n$$\n3\\cdot (-\\frac{1}{3})=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{3}x+3$ is perpendicular to the given line."} {:db/id #edb/ref 17592186290454 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ab5f17a-ad0a-556d-a84f-4