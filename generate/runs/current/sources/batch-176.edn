math} :answer/value "-4" :db/id #edb/ref 17592186288166} {:answer/id #uuid "490f58c8-c786-5d31-8e1c-79dccd244271" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288538} {:answer/id #uuid "710f00a5-6a28-5ddc-bbc9-f671cc856f77" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288818} {:answer/id #uuid "95c00138-66e1-5e8b-a88a-99d98837093b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289032} {:answer/id #uuid "fc1f4fad-69ca-506c-bf35-61221cd5e6c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289696}] :answer-field/correct {:answer/id #uuid "13792421-9275-5651-8409-88c85398dd37" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288166} :answer-field/id #uuid "10ff23a8-ea19-544f-b919-18be2538ce3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289772}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f85820f0-0e97-5a70-b11e-7b663b24839a" :question/math-academy-id "q-237021" :question/problem "Let $c=⟨-3,\\sqrt{3},1⟩$ and $d=⟨x,0,-12⟩.$ Given that the scalar projection of $c$ onto $d$ is zero, find the value of $x.$" :question/worked-solution "Since $c$ is a nonzero vector, its scalar projection onto another nonzero vector $d$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\nc⊥d\\,⟹\\,c\\cdot d=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =(-3)\\cdot x+\\sqrt{3}\\cdot 0+1\\cdot (-12) \\\\  & =-3x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ -3x-12 & =0 \\\\ 3x & =-12 \\\\ x & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290493 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c8fa6e-ec22-57a4-ace9-9ab79eb86dfc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288485} {:answer/id #uuid "b84d2b62-4353-5f5a-a5c9-69ea117204f1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186289251} {:answer/id #uuid "d5049764-b1b5-5357-be51-767024d656d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289448} {:answer/id #uuid "dbf67f99-cbea-58b8-a183-8ed451369ef4" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289496} {:answer/id #uuid "dd4a724f-68fe-5924-b70a-bdc7366c3c49" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289506}] :answer-field/correct {:answer/id #uuid "d5049764-b1b5-5357-be51-767024d656d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289448} :answer-field/id #uuid "1dc69ae9-136f-5a66-9a05-68c04a2bca60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289806}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "487960be-d7be-5dc4-ae5e-e966e5d0db00" :question/math-academy-id "q-237022" :question/problem "Let $p=⟨3,5,x⟩$ and $q=⟨-3,1,2⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-3)+5\\cdot 1+x\\cdot 2 \\\\  & =2x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "914d3440-61a2-5cbd-915b-d851c90abbd0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291255}] :answer-field/correct {:answer/id #uuid "914d3440-61a2-5cbd-915b-d851c90abbd0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291255} :answer-field/id #uuid "da2ac539-adda-5fda-b798-5c65309f7150" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292405}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0e5cdb13-4156-58cf-ae33-5a314b89945e" :question/math-academy-id "q-275253" :question/problem "Let $p=⟨-1,2,1⟩$ and $q=⟨2,x,0⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 2+2\\cdot x+1\\cdot 0 \\\\  & =-2+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -2+2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb0079d-45e8-5b05-b410-c68104c01c2a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186290701}] :answer-field/correct {:answer/id #uuid "0eb0079d-45e8-5b05-b410-c68104c01c2a" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186290701} :answer-field/id #uuid "3af26996-2272-545c-90e4-e37f7e8325a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291933}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0b211c2b-bc36-53db-aca9-0fadea78784c" :question/math-academy-id "q-275256" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299726 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b95007d2-d2c4-5ca8-947f-ac698527e171" :answer/type {:db/ident :answer.type/math} :answer/value "-1/3" :db/id #edb/ref 17592186298357}] :answer-field/correct {:answer/id #uuid "b95007d2-d2c4-5ca8-947f-ac698527e171" :answer/type {:db/ident :answer.type/math} :answer/value "-1/3" :db/id #edb/ref 17592186298357} :answer-field/id #uuid "a8db6f26-99f0-50e3-8855-273485708ec8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299208}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "100a4e96-9db1-5d18-a7bd-1bd05f0073dc" :question/math-academy-id "q-319150" :question/problem "Let $p=⟨3,-1,2⟩$ and $q=⟨x,1,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot x+(-1)\\cdot 1+2\\cdot 1 \\\\  & =3x+1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+1 & =0 \\\\ 3x & =-1 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0452a64-927f-5d7d-b07e-4b57abd4d6a6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298259}] :answer-field/correct {:answer/id #uuid "a0452a64-927f-5d7d-b07e-4b57abd4d6a6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298259} :answer-field/id #uuid "0b238f8d-e0d9-5ffc-aee7-5172fbc4d28f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298671}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "252df411-1410-5fbc-a0ba-6a3198b7a34c" :question/math-academy-id "q-319171" :question/problem "Let $p=⟨4,1,-2⟩$ and $q=⟨1,x,3⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =4\\cdot 1+1\\cdot x+(-2)\\cdot 3 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fc4d159-66a8-552d-8401-ac5170a3b165" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297689}] :answer-field/correct {:answer/id #uuid "1fc4d159-66a8-552d-8401-ac5170a3b165" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297689} :answer-field/id #uuid "07b94070-fa19-5c0e-b7d6-fe0a4474788f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298660}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3b9e2634-f76e-5353-8b9c-ac4ebc43947e" :question/math-academy-id "q-319172" :question/problem "Let $p=⟨-2,3,4⟩$ and $q=⟨1,2,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =-2+6+4x \\\\  & =4x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 4x+4 & =0 \\\\ 4x & =-4 \\\\ x & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b09c2782-cc5c-5c6b-94f6-5ea932871845" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298323}] :answer-field/correct {:answer/id #uuid "b09c2782-cc5c-5c6b-94f6-5ea932871845" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298323} :answer-field/id #uuid "f27bc293-b846-5a95-9571-c426e151ab18" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299451}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54bac378-b09e-5746-9da1-a5edf37aafcf" :question/math-academy-id "q-319252" :question/problem "Let $p=2i-3j+k$ and $q=xi+4j.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot x+(-3)\\cdot 4+1\\cdot 0 \\\\  & =2x-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-12 & =0 \\\\ 2x & =12 \\\\ x & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299737 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1b13d9-95f4-5e20-8b5e-53f42fb2123d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297784}] :answer-field/correct {:answer/id #uuid "3b1b13d9-95f4-5e20-8b5e-53f42fb2123d" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297784} :answer-field/id #uuid "e0b7ba0f-63e5-5c5e-bfd2-b99c69925ef2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299402}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "abcc12ab-195b-5a18-8e90-22ddbe9f6e4c" :question/math-academy-id "q-319253" :question/problem "Let $p=-4i+2j-3k$ and $q=5i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8294dbd7-4cb6-51d9-8d20-d8495bf0ea10" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298117}] :answer-field/correct {:answer/id #uuid "8294dbd7-4cb6-51d9-8d20-d8495bf0ea10" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298117} :answer-field/id #uuid "2e96eb66-c582-5560-9a9e-1bb66c30da90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298798}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f7e28ce4-d965-5f90-abdd-fd4ebe18371a" :question/math-academy-id "q-319254" :question/problem "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10667f31-4ce7-5455-9b8d-d46f3fda4165" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297627}] :answer-field/correct {:answer/id #uuid "10667f31-4ce7-5455-9b8d-d46f3fda4165" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297627} :answer-field/id #uuid "c0705119-20db-5fba-b904-b479530a6dc6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299282}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c487f5aa-c96a-57d4-aea4-cb293f8d9612" :question/math-academy-id "q-319255" :question/problem "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90285a75-b811-5504-9cc1-612873c4e624" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298177}] :answer-field/correct {:answer/id #uuid "90285a75-b811-5504-9cc1-612873c4e624" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298177} :answer-field/id #uuid "f5e32c57-fed0-5cac-8815-45d1f36b47b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299467}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "82fa0dd5-2719-5c00-bc10-1f3440618fed" :question/math-academy-id "q-319256" :question/problem "Let $a=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ -4\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =(-2)\\cdot 3+5\\cdot x+1\\cdot (-4) \\\\  & =5x-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}5x-10 & =0 \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9679c15f-eb66-5f8f-bc63-1aefe179a953" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186379344} {:answer/id #uuid "0020d0a8-0606-5b18-a7a8-958973e37be8" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186379345} {:answer/id #uuid "c47bb5b3-5921-5681-9fee-e5068d117e86" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186379346} {:answer/id #uuid "8be61420-e5d2-50d1-9814-aa6788849373" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186379347} {:answer/id #uuid "f7f0dff6-0e8a-5003-9ccb-b4ae6d63b705" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186379348}] :answer-field/correct {:answer/id #uuid "f7f0dff6-0e8a-5003-9ccb-b4ae6d63b705" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186379348} :answer-field/id #uuid "67ba134b-4d9f-5cf6-b38a-1dcb5e8de13b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379343}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f76a4d7-83bc-53e9-bba0-121ef750dc15" :question/math-academy-id "q-237019" :question/problem "Let $p=i+2j+xk$ and $q=3i+6j-3k.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot 3+2\\cdot 6+x\\cdot (-3) \\\\  & =15-3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 15-3x & =0 \\\\ 3x & =15 \\\\ x & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379369 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb69b0f2-a946-5ec4-8b5a-8dc7a021c0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-8/3" :db/id #edb/ref 17592186379371}] :answer-field/correct {:answer/id #uuid "eb69b0f2-a946-5ec4-8b5a-8dc7a021c0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-8/3" :db/id #edb/ref 17592186379371} :answer-field/id #uuid "681c19f4-13bc-5301-abe1-89b3c65ef8d0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379370}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cf60000a-0fab-5712-856b-db3cc64a89f2" :question/math-academy-id "q-319257" :question/problem "Let $a=[\\begin{aligned}4 \\\\ -1 \\\\ 3\\end{aligned}]$ and $b=[\\begin{aligned}2 \\\\ 0 \\\\ x\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =4\\cdot 2+(-1)\\cdot 0+3\\cdot x \\\\  & =3x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}3x+8 & =0 \\\\ 3x & =-8 \\\\ x & =-\\frac{8}{3}.\\end{aligned}\n$$"}] :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] [{:db/id #edb/ref 17592186110599 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110334 :question/id #uuid "4cc37ad7-b382-5b7e-bcda-92b2818c5650" :question/math-academy-id "e-14359" :question/problem "Which of the following lines is perpendicular to $y= -\\dfrac{2}{5}x-3?$\n\n- $y = 5x + 1$\n\n- $y = \\dfrac{5}{2}x + 3$\n\n- $y = -\\dfrac{x}{2} + 5$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\dfrac{2}{5}x-3$ is in slope-intercept form, and its slope is $-\\dfrac{2}{5}.$\n\nLooking at the answer choices, the line $y = \\dfrac{5}{2}x + 3$ has a slope of $\\dfrac{5}{2}.$\n\nMultiplying the slopes together, we have\n\n$$\n\\left( -\\dfrac{2}{5}\\right) \\cdot \\dfrac{5}{2} = -1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y = \\dfrac{5}{2}x + 3$ is perpendicular to the given line.\n\nSo, the correct answer is \"II only\"."} :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049716 :topic/math-academy-id 1240 :topic/title "Equations of Lines in Slope-Intercept Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186111389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da24a9f5-3957-5314-9170-30b884dd9a23" :an