db/ref 17592186288971} {:answer/id #uuid "b251eb43-1e9d-55b6-850c-8b2662839755" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289210} {:answer/id #uuid "cb0819fe-16d3-5da2-9e12-f9a8552518f6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289378} {:answer/id #uuid "f278ef26-95d6-561a-bd55-6e9c6609d020" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289634}] :answer-field/correct {:answer/id #uuid "f278ef26-95d6-561a-bd55-6e9c6609d020" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289634} :answer-field/id #uuid "2a6e7ba3-1c4d-5d41-a107-43b856da8d1d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289828}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9ede3719-f0d6-5ce0-9786-3cb5498e6270" :question/math-academy-id "q-237017" :question/problem "Let $p=i-3j$ and $q=xi+2j+k.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot x+(-3)\\cdot 2+0\\cdot 1 \\\\  & =x-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-6 & =0 \\\\ x & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} {:answer/id #uuid "4be5c6a7-9473-5f8f-a76d-361e76618b03" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288557} {:answer/id #uuid "969e8fda-7e9c-55a7-bced-44ceb4371dda" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289039} {:answer/id #uuid "cbe15376-5215-5280-ae06-1a3991f84d01" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186289384} {:answer/id #uuid "eb4d7bb2-b033-5091-b1bf-ce3cd9d629f1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289590}] :answer-field/correct {:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} :answer-field/id #uuid "0bd2ffd0-af54-5576-8d75-4029636169bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289757}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "23ed6766-8e64-5c6e-b8a5-b8f25dcf697a" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290491 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341784da-b585-53fe-93fa-c3cbb0d2b032" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288377} {:answe