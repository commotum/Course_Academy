"89305420-4a86-5a40-874c-7c4df040b132" :answer/type {:db/ident :answer.type/text} :answer/value "$G$ only" :db/id #edb/ref 17592186403334} :answer-field/id #uuid "c4a02047-dca6-5775-902f-6e45faaf8157" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403329}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "69d9ccdc-d7b6-5ce9-82c3-15199547a51a" :question/math-academy-id "q-69517" :question/problem "Which of the following is a $3\\times 1$ matrix?\n\n$$\nF=[\\begin{aligned}0 & -2 & 3 \\\\ 3 & 1 & 5 \\\\ 3 & 1 & 0\\end{aligned}],\\,G=[\\begin{aligned}\\sqrt{3} \\\\ -1 \\\\ 0\\end{aligned}],\\,H=[\\begin{aligned}-2 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "- The matrix $F$ has $3$ rows and $3$ columns. So, its dimensions are $3\\times 3.$ $\\,\\times $\n\n- The matrix $G$ has $3$ rows and $1$ column. So, its dimensions are $3\\times 1.$ $\\,✓$\n\n- The matrix $H$ has $1$ row and $3$ columns. So, its dimensions are $1\\times 3.$ $\\,\\times $\n\nTherefore, only $G$ is a $3\\times 1$ matrix."}] :knowledge-point/title "Identifying a Matrix by Its Description"}] [{:db/id #edb/ref 17592186087717 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087518 :question/id #uuid "53ce2176-ae44-578d-8fba-35c5018d4162" :question/math-academy-id "e-5075" :question/problem "For the parametric curve\n\n$$\nx=3t, \\,\\,\\, y=t^3, \\quad -3\\leq t \\leq 3,\n$$\n\nfill in the following table of values.\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ |  |  |  |  |  |  |  |\n| $y$ |  |  |  |  |  |  |  |" :question/worked-solution "First, we work out the $x$-values using the formula $x=3t.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-9$ | $-6$ | $-3$ | $0$ | $3$ | $6$ | $9$ |\n| $y$ |  |  |  |  |  |  |  |\n\nNow, we work out the $y$-values using $y=t^3.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-9$ | $-6$ | $-3$ | $0$ | $3$ | $6$ | $9$ |\n| $y$ | $-27$ | $-8$ | $-1$ | $0$ | $1$ | $8$ | $27$ |"} :knowledge-point/id #uuid "bbf50e27-a8c3-52e7-be21-5d7ed61e5512" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050790 :topic/math-academy-id 95 :topic/title "Graphing Linear Equations"}] :knowledge-point/questions [{:db/id #edb/ref 17592186088269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5c9c6f1-88a9-5814-8d7f-824388fe769d" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186086269} {:answer/id #uuid "c95ef482-a715-5d27-8322-272d06aefa28" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186086270} {:answer/id #uuid "dd13ebf0-fcc4-5780-a2ef-c58a92669901" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186086271} {:answer/id #uuid "3ae5b9a5-e0be-5b47-b2de-3e04a707aebe" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186086272} {:answer/id #uuid "70b93ffd-0a6c-5e4b-a149-c7a58e10d173" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186086273}] :answer-field/id #uuid "155c89c2-1972-5fdf-8d50-c32635afc935" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086268}] :question/id #uuid "5cc3bc31-0264-5908-8539-6e444261bf21" :question/math-academy-id "q-6827" :question/problem "For the parametric curve\n$x = t^{2} + t, y = t^{2} - t,-4 \\le t \\le 4$,\nconsider the following table of values:\n\n| **$t$** | $-4$ | $-2$ | $-1$ | $0$ | $1$ | $3$ | $4$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n| $x$ | $12$ | $a$ | $0$ | $0$ | $2$ | $c$ | $20$ |\n| $y$ | $20$ | $6$ | $2$ | $b$ | $0$ | $6$ | $12$ |\n\nFind the value of $a + b + c$."} {:db/id #edb/ref 17592186088270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c987a4c-ef82-50f8-9c2f-24369b52299f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333562} {:answer/id #uuid "448c0861-60dc-5277-abf0-6324c4313b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186333623} {:answer/id #uuid "4ec62518-f2da-54a6-b78e-7803c2af25ea" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333712} {:answer/id #uuid "4f618bb1-1a30-5478-b04d-5d8c290174ad" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333716} {:answer/id #uuid "cc14822b-2861-53db-8d57-7b85cd391a64" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186334768}] :answer-field/correct {:answer/id #uuid "3c987a4c-ef82-50f8-9c2f-24369b52299f" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186333562} :answer-field/id #uuid "e19de855-513e-569d-b86d-f599dde05f25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335632}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2efd117e-aa4e-5314-8b1b-8bd86f2a35c1" :question/math-academy-id "q-6834" :question/problem "For the parametric curve\n\n$$\nx={t}^{2}-4,\\,\\,\\,y=\\frac{5}{2}-\\frac{t}{2},\\,-1\\le t\\le 5,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $a$ | $-4$ | $-3$ | $0$ | $5$ | $12$ | $21$ |\n| $y$ | $3$ | $\\frac{5}{2}$ | $b$ | $\\frac{3}{2}$ | $1$ | $\\frac{1}{2}$ | $c$ |\n\n$$\n\n$$\n\nFind the value of $a-b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-1$ into $x={t}^{2}-4.$ This gives\n\n$$\na=(-1)^{2}-4=1-4=-3.\n$$\n\n- To find the value of $b,$ we substitute $t=1$ into $y=\\frac{5}{2}-\\frac{t}{2}.$ This gives\n\n$$\nb=\\frac{5}{2}-\\frac{1}{2}=\\frac{4}{2}=2.\n$$\n\n- To find the value of $c,$ we substitute $t=5$ into $y=\\frac{5}{2}-\\frac{t}{2}.$ This gives\n\n$$\nc=\\frac{5}{2}-\\frac{5}{2}=0.\n$$\n\nFinally, we have\n\n$$\na-b+c=-3-2+0=-5.\n$$"} {:db/id #edb/ref 17592186233325 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "023f3e70-1c18-56f9-a0dc-bbd6d23f44df" :question/math-academy-id "q-123754" :question/problem "For the parametric curve\n\n$$\nx=t-4,\\,\\,\\,y=1-2{t}^{2},\\,0\\le t\\le 4,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $a$ | $-3$ | $-2$ | $-1$ | $0$ |\n| $y$ | $1$ | $-1$ | $b$ | $c$ | $-31$ |\n\n$$\n\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=0$ into $x=t-4.$ This gives\n\n$$\na=0-4=-4.\n$$\n\n- To find the value of $b,$ we substitute $t=2$ into $y=1-2{t}^{2}.$ This gives\n\n$$\nb=1-2(2)^{2}=-7.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $y=1-2{t}^{2}.$ This gives\n\n$$\nc=1-2(3)^{2}=-17\n$$\n\nFinally, we have\n\n$$\na+b+c=-4+(-7)+(-17)=-28.\n$$"} {:db/id #edb/ref 17592186233831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d258e642-b9a6-5bf1-b482-5f152ab7aaad" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186232635}] :answer-field/correct {:answer/id #uuid "d258e642-b9a6-5bf1-b482-5f152ab7aaad" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186232635} :answer-field/id #uuid "52f71c9c-2f6b-5370-8a49-95e60baaf004" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232634} {:answer-field/choices [{:answer/id #uuid "49847da4-c519-552f-850e-48e4275cefef" :answer/type {:db/ident :answer.type/math} :answer/value "213" :db/id #edb/ref 17592186232637}] :answer-field/correct {:answer/id #uuid "49847da4-c519-552f-850e-48e4275cefef" :answer/type {:db/ident :answer.type/math} :answer/value "213" :db/id #edb/ref 17592186232637} :answer-field/id #uuid "415b1ff5-fd3e-5864-b71e-dcccb0c3c658" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232636} {:answer-field/choices [{:answer/id #uuid "b3cfa260-48a2-5cf6-94ef-725c7428f7f1" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186232639}] :answer-field/correct {:answer/id #uuid "b3cfa260-48a2-5cf6-94ef-725c7428f7f1" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186232639} :answer-field/id #uuid "858a5c87-649c-59d5-a39d-60ba696bb7d6" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232638}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "16325e3c-ebce-5185-863e-0d84f168aa37" :question/math-academy-id "q-326248" :question/problem "Consider the curve with parametric equations\n\n$$\nx={t}^{3}-\\frac{1}{2}t,\\,y=1-{t}^{2},\\,1\\le t\\le 6.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $\\frac{1}{2}$ | {{field-1}} | $\\frac{51}{2}$ | $62$ | $\\frac{245}{2}$ | {{field-2}} |\n| $y$ | $0$ | $-3$ | {{field-3}} | $-15$ | $-24$ | $-35$ |" :question/worked-solution "- To find the value of $x(2),$ we substitute $t=2$ into $x={t}^{3}-\\frac{1}{2}t.$ This gives\n\n$$\nx(2)=(2)^{3}-\\frac{1}{2}(2)=8-1=7.\n$$\n\n- To find the value of $y(3),$ we substitute $t=3$ into $y=1-{t}^{2}.$ This gives\n\n$$\ny(3)=1-(3)^{2}=1-9=-8.\n$$\n\n- To find the value of $x(6),$ we substitute $t=6$ into $x={t}^{3}-\\frac{1}{2}t.$ This gives\n\n$$\nx(6)=(6)^{3}-\\frac{1}{2}(6)=216-3=213.\n$$\n\nThen the table is \n\n| **$t$** | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $\\frac{1}{2}$ | $7$ | $\\frac{51}{2}$ | $62$ | $\\frac{245}{2}$ | $213$ |\n| $y$ | $0$ | $-3$ | $-8$ | $-15$ | $-24$ | $-35$ |"} {:db/id #edb/ref 17592186234248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280e1cee-68f8-59f3-a023-f6dd1f086b41" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333358} {:answer/id #uuid "c16fb7f6-a00e-595d-a28e-2f0a7397869c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186334666} {:answer/id #uuid "d02e3a07-a9eb-5ee2-9205-057f65384e6c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186334807} {:answer/id #uuid "e4417143-3102-5cc2-b8d4-db87db4085b3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186334978} {:answer/id #uuid "eacbc418-3efa-5b4c-a585-26704419f165" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186335043}] :answer-field/correct {:answer/id #uuid "e4417143-3102-5cc2-b8d4-db87db4085b3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186334978} :answer-field/id #uuid "0b5f293a-3b57-563b-b236-87b7649c6cbf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335256}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e3d07c4f-77fc-5e25-9502-ae72735f0f26" :question/math-academy-id "q-6832" :question/problem "For the parametric curve\n\n$$\nx=\\operatorname{sin}⁡(\\frac{\\pi t}{2}),\\,\\,\\,y=\\operatorname{cos}⁡(\\frac{\\pi t}{3}),\\,-3\\le t\\le 3,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $1$ | $0$ | $b$ | $0$ | $1$ | $0$ | $c$ |\n| $y$ | $a$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ | $1$ | $\\frac{1}{2}$ | $-\\frac{1}{2}$ | $-1$ |\n\n$$\n\n$$\n\nFind the value of $-a+b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-3$ into $y=\\operatorname{cos}⁡(\\frac{\\pi t}{3}).$ This gives\n\n$$\na=\\operatorname{cos}⁡(\\frac{\\pi (-3)}{3})=\\operatorname{cos}⁡(-\\pi )=-1.\n$$\n\n- To find the value of $b,$ we substitute $t=-1$ into $y=\\operatorname{sin}⁡(\\frac{\\pi t}{2}).$ This gives\n\n$$\nb=\\operatorname{sin}⁡(\\frac{\\pi (-1)}{2})=\\operatorname{sin}⁡(-\\frac{\\pi }{2})=-1.\n$$\n\n- To find the value of $c,$ we substitute $t=3$ into $y=\\operatorname{sin}⁡(\\frac{\\pi t}{2}).$ This gives\n\n$$\nc=\\operatorname{sin}⁡(\\frac{\\pi (3)}{2})=\\operatorname{sin}⁡(\\frac{3\\pi }{2})=-1.\n$$\n\nFinally, we have\n\n$$\n-a+b+c=-(-1)+(-1)+(-1)=-1.\n$$"} {:db/id #edb/ref 17592186234256 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "28dfeac9-12f2-53c4-b4b0-03e187c89f74" :question/math-academy-id "q-69923" :question/problem "For the parametric curve\n\n$$\nx=-3t,\\,\\,\\,y=2t,\\,-5\\le t\\le 0,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-5$ | $-4$ | $-3$ | $-2$ | $-1$ | $0$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $15$ | $12$ | $9$ | $6$ | $3$ | $c$ |\n| $y$ | $-10$ | $a$ | $-6$ | $b$ | $-2$ | $0$ |\n\n$$\n\n$$\n\nFind the value of $a-b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-4$ into $y=2t.$ This gives\n\n$$\na=2(-4)=-8.\n$$\n\n- To find the value of $b,$ we substitute $t=-2$ into $y=2t.$ This gives\n\n$$\nb=2(-2)-4.\n$$\n\n- To find the value of $c,$ we substitute $t=0$ into $x=-3t.$ This gives\n\n$$\nc=-3(0)=0.\n$$\n\nFinally, we have\n\n$$\na-b+c=-8-(-4)+0=-4.\n$$"} {:db/id #edb/ref 17592186259554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3260f191-357e-5fd6-b3f9-51c178134db5" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186257221} {:answer/id #uuid "6d128ce0-efb8-56e1-8023-f299f3be850c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257742} {:answer/id #uuid "b18c0515-7610-54e6-b101-c84deb16e608" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258326} {:answer/id #uuid "f075feb5-f3f8-5129-a941-46db050b2214" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186258873} {:answer/id #uuid "f211cf5f-df49-5a9e-9bde-8f90da57b9b2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258888}] :answer-field/correct {:answer/id #uuid "b18c0515-7610-54e6-b101-c84deb16e608" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258326} :answer-field/id #uuid "7b2b0b8a-76aa-5a6d-9974-c88122a91939" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259240}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3cac2494-d877-5849-8ad0-9d49fb79c7df" :question/math-academy-id "q-123753" :question/problem "For the parametric curve\n\n$$\nx=1-{t}^{2},\\,\\,\\,y=3t+2,\\,-2\\le t\\le 2,\n$$\n\nconsider the following table of values:\n\n| **$t$** | $-2$ | $-1$ | $0$ | $1$ | $2$ |\n| --- | --- | --- | --- | --- | --- |\n| $x$ | $-3$ | $a$ | $1$ | $0$ | $c$ |\n| $y$ | $-4$ | $-1$ | $b$ | $5$ | $8$ |\n\n$$\n\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "- To find the value of $a,$ we substitute $t=-1$ into $x=1-{t}^{2}.$ This gives\n\n$$\na=1-(-1)^{2}=0.\n$$\n\n- To find the value of $b,$ we substitute $t=0$ into $y=3t+2.$ This gives\n\n$$\nb=3(0)+2=2.\n$$\n\n- To find the value of $c,$ we substitute $t=2$ into $x=1-{t}^{2}.$ This gives\n\n$$\nc=1-(2)^{2}=-3.\n$$\n\nFinally, we have\n\n$$\na+b+c=0+2+(-3)=-1.\n$$"} {:db/id #edb/ref 17592186259555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f211ed-ddd7-5784-b0dc-35bcae2cefaa" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186256825} {:answer/id #uuid "2de8a