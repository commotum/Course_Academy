 :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186300917}] :answer-field/correct {:answer/id #uuid "bf11f1c2-7e84-52d0-82eb-f0bec75d951c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186300917} :answer-field/id #uuid "909ca647-782d-5026-97c2-4f69d2dbc2de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301688} {:answer-field/choices [{:answer/id #uuid "ca352a99-e4be-5a50-b2d8-376ac2cbd696" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186300970}] :answer-field/correct {:answer/id #uuid "ca352a99-e4be-5a50-b2d8-376ac2cbd696" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{4}" :db/id #edb/ref 17592186300970} :answer-field/id #uuid "be23546a-6789-50c1-b0de-9f43e3206e3b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301847} {:answer-field/choices [{:answer/id #uuid "315f9757-1b3f-500e-b71c-be24341277dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186300203}] :answer-field/correct {:answer/id #uuid "315f9757-1b3f-500e-b71c-be24341277dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186300203} :answer-field/id #uuid "cdc547cb-e485-57de-acc6-c64ddfd515ba" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301887}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "97abe29c-aa1a-5961-b330-faf07c8841b1" :question/math-academy-id "q-326242" :question/problem "Consider the curve with parametric equations\n\n$$\nx=\\frac{3}{2}t+1,\\,y=-\\frac{5}{4}t+2,\\,-1\\le t\\le 4.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | {{field-1}} | $1$ | $\\frac{5}{2}$ | $4$ | {{field-2}} | $7$ |\n| $y$ | {{field-3}} | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |" :question/worked-solution "- To find the value of $x(-1),$ we substitute $t=-1$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(-1)=\\frac{3}{2}(-1)+1=-\\frac{3}{2}+\\frac{2}{2}=-\\frac{1}{2}.\n$$\n\n- To find the value of $y(-1),$ we substitute $t=-1$ into $y=-\\frac{5}{4}t+2.$ This gives\n\n$$\ny(-1)=-\\frac{5}{4}(-1)+2=\\frac{5}{4}+\\frac{8}{4}=\\frac{13}{4}.\n$$\n\n- To find the value of $x(3),$ we substitute $t=3$ into $x=\\frac{3}{2}t+1.$ This gives\n\n$$\nx(2)=\\frac{3}{2}(3)+1=\\frac{9}{2}+\\frac{2}{2}=\\frac{11}{2}.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $-1$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-\\frac{1}{2}$ | $1$ | $\\frac{5}{2}$ | $4$ | $\\frac{11}{2}$ | $7$ |\n| $y$ | $\\frac{13}{4}$ | $2$ | $\\frac{3}{4}$ | $-\\frac{1}{2}$ | $-\\frac{7}{4}$ | $-3$ |"} {:db/id #edb/ref 17592186302270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43263775-6a23-5d97-906a-a6f79d7a0456" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186300292}] :answer-field/correct {:answer/id #uuid "43263775-6a23-5d97-906a-a6f79d7a0456" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186300292} :answer-field/id #uuid "32519836-bf08-5075-8849-e308dea3e240" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301387} {:answer-field/choices [{:answer/id #uuid "2d011c6c-58a6-561f-ae10-6109748dcac4" :answer/type {:db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186300180}] :answer-field/correct {:answer/id #uuid "2d011c6c-58a6-561f-ae10-6109748dcac4" :answer/type {:db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186300180} :answer-field/id #uuid "57c14b01-f4ee-5c68-bf97-0b1dcdace2d4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301512} {:answer-field/choices [{:answer/id #uuid "1466bd40-3acf-591c-b003-9c0f787e6551" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300044}] :answer-field/correct {:answer/id #uuid "1466bd40-3acf-591c-b003-9c0f787e6551" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186300044} :answer-field/id #uuid "aeaa33c7-8e94-592c-baee-0f58e084a228" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301794}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "657285cd-f814-5fb4-ae66-64de44c5741c" :question/math-academy-id "q-326246" :question/problem "Consider the curve with parametric equations\n\n$$\nx={t}^{3}-2t,\\,y=-2t+\\frac{3}{2},\\,0\\le t\\le 5.\n$$\n\nFill in the blanks in the following table of values:\n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $-1$ | {{field-1}} | $21$ | $56$ | {{field-2}} |\n| $y$ | $\\frac{3}{2}$ | $-\\frac{1}{2}$ | $-\\frac{5}{2}$ | {{field-3}} | $-\\frac{13}{2}$ | $-\\frac{17}{2}$ |" :question/worked-solution "- To find the value of $x(2),$ we substitute $t=2$ into $x={t}^{3}-2t.$ This gives\n\n$$\nx(2)=(2)^{3}-2(2)=8-4=4.\n$$\n\n- To find the value of $y(3),$ we substitute $t=3$ into $y=-2t+\\frac{3}{2}.$ This gives\n\n$$\ny(3)=-2(3)+\\frac{3}{2}=-6+\\frac{3}{2}=-\\frac{12}{2}+\\frac{3}{2}=-\\frac{9}{2}.\n$$\n\n- To find the value of $x(5),$ we substitute $t=5$ into $x={t}^{3}-2t.$ This gives\n\n$$\nx(5)=(5)^{3}-2(5)=125-10=115.\n$$\n\nThen the table is \n\n \n\n| **$t$** | $0$ | $1$ | $2$ | $3$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $0$ | $-1$ | $4$ | $21$ | $56$ | $115$ |\n| $y$ | $\\frac{3}{2}$ | $-\\frac{1}{2}$ | $-\\frac{5}{2}$ | $-\\frac{9}{2}$ | $-\\frac{13}{2}$ | $-\\frac{17}{2}$ |"} {:db/id #edb/r