#{[{:db/id #edb/ref 17592186124470 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124277 :question/id #uuid "033e459e-5148-5e78-ab5c-7e455b06cd64" :question/math-academy-id "e-3695" :question/problem "If $f(x,y,z) = xz\\ln{y}$ and $\\mathbf r (t) =  t^2 \\, \\mathbf i + t  \\, \\mathbf j +t^3  \\, \\mathbf k,$ compute $\\dfrac {\\textrm d}{\\textrm d t} [f(\\mathbf r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\dfrac {\\textrm d}{\\textrm d t} [f(\\mathbf r (t))] = \\nabla f(\\mathbf r(t)) \\cdot \\mathbf r'(t).\n$$\n\nFirst, we need to compute $\\nabla f(x,y,z){:}$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(xz\\operatorname{ln}⁡y)\\,i+\\frac{∂}{∂y}(xz\\operatorname{ln}⁡y)\\,j+\\frac{∂}{∂z}(xz\\operatorname{ln}⁡y)\\,k \\\\  & =z\\operatorname{ln}⁡y\\,i+\\frac{xz}{y}\\,j+x\\operatorname{ln}⁡y\\,k\\end{aligned}\n$$\n\nNext, we substitute $x= t^2,$ $y = t$ and $z= t^3$ into the above to find $\\nabla f(\\mathbf{r}(t)){:}$\n\n$$\n\\begin{aligned}∇f(r(t)) & ={t}^{3}\\operatorname{ln}⁡t\\,i+{t}^{4}\\,j+{t}^{2}\\operatorname{ln}⁡t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,k \\\\  & =2t\\,i+\\,j+3{t}^{2}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =({t}^{3}\\operatorname{ln}⁡t\\,i+{t}^{4}\\,j+{t}^{2}\\operatorname{ln}⁡t\\,k)\\cdot (2t\\,i+\\,j+3{t}^{2}\\,k) \\\\  & =({t}^{3}\\operatorname{ln}⁡t)\\cdot 2t+({t}^{4})\\cdot 1+({t}^{2}\\operatorname{ln}⁡t)\\cdot 3{t}^{2} \\\\  & =2{t}^{4}\\operatorname{ln}⁡t+{t}^{4}+3{t}^{4}\\operatorname{ln}⁡t \\\\  & ={t}^{4}(5\\operatorname{ln}⁡t+1).\\end{aligned}\n$$"} :knowledge-point/id #uuid "112e3378-bde8-5896-822e-e815bde51501" :knowledge-point/questions [{:db/id #edb/ref 17592186124959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a27301a5-c679-526f-8d17-1cbce40107f8" :answer/type {:db/ident :answer.type/math} :answer/value "e^{t + 1} + te^{t} + e" :db/id #edb/ref 17592186122355} {:answer/id #uuid "dc847600-a9fe-5d52-a83c-b7c1a9114503" :answer/type {:db/ident :answer.type/math} :answer/value "e^{t + 1} + (1 + 2t)e^{t} + e" :db/id #edb/ref 17592186122356} {:answer/id #uuid "3de1efcc-6288-573e-8e67-2b7d12a0c3a2" :answer/type {:db/ident :answer.type/math} :answer/value "e^{t + 1} + (1 + t)e^{t} + e" :db/id #edb/ref 17592186122357} {:answer/id #uuid "527630fa-6722-5392-9b51-faae42cd275f" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{t} + 2e + t" :db/id #edb/ref 17592186122358} {:answer/id #uuid "7ef2fec2-232b-582f-aa15-ab3dc3313b49" :answer/type {:db/ident :answer.type/math} :answer/value "e^{t + 1} + (t + 1)e^{t} + 2" :db/id #edb/ref 17592186122359}] :answer-field/id #uuid "00f9b55f-9f7a-5171-8a0f-7462d539b472" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122354}] :question/id #uuid "f10e177e-2926-5cde-8e9a-4b0a99b2ff4c" :question/math-academy-id "q-36238" :question/problem "If $f(x, y, z) = xy + yz + xz$ and $r(t) = ti + e^{t}j + ek$, compute $\\frac{d}{dt}[f(r(t))]$."} {:db/id #edb/ref 17592186125250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98f9b817-55fe-5337-9917-12a57b7f32fd" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{t}\\sin t" :db/id #edb/ref 17592186124101} {:answer/id #uuid "0ae1149c-5a8d-577c-9d59-3c421a3478e0" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{t} + \\sin t + \\cos t" :db/id #edb/ref 17592186124102} {:answer/id #uuid "0f80eba8-e277-54b6-a822-397fce4bd264" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186124103} {:answer/id #uuid "1f972039-9ac7-5dd8-94b0-eea94f14f776" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{t}(\\sin t + \\cos t)" :db/id #edb/ref 17592186124104} {:answer/id #uuid "432cd37d-71ad-5244-a79d-53312dec9e11" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{t}\\cos t" :db/id #edb/ref 17592186124105}] :answer-field/id #uuid "f6d53ae6-99b0-5b9a-984f-d8cbdd57249f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124100}] :question/id #uuid "9127ceaf-3e13-50a4-b08a-89114324036d" :question/math-academy-id "q-95075" :question/problem "If $f(x, y, z) = z(x + y)$ and $r(t) = \\sin ti + \\cos tj + e^{t}k$, compute $\\frac{d}{dt}[f(r(t))]$."} {:db/id #edb/ref 17592186284584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1346c66e-add9-58bb-914d-bde230ffb97c" :answer/type {:db/ident :answer.type/math} :answer/value "3{t}^{2}+3t" :db/id #edb/ref 17592186281874} {:answer/id #uuid "5cbc6691-be3c-5174-bc33-891dad11a619" :answer/type {:db/ident :answer.type/math} :answer/value "{t}^{2}+2t" :db/id #edb/ref 17592186282476} {:answer/id #uuid "7ca6cbe6-66c9-5cdf-85f9-16bcc6c8db5b" :answer/type {:db/ident :answer.type/math} :answer/value "6{t}^{2}" :db/id #edb/ref 17592186282765} {:answer/id #uuid "c8135d32-63d4-5f0e-ba7b-566e64774dee" :answer/type {:db/ident :answer.type/math} :answer/value "3{t}^{2}" :db/id #edb/ref 17592186283438} {:answer/id #uuid "d748975e-258c-5fd7-a8c3-a751942b65a8" :answer/type {:db/ident :answer.type/math} :answer/value "{t}^{3}+3{t}^{2}" :db/id #edb/ref 17592186283565}] :answer-field/correct {:answer/id #uuid "7ca6cbe6-66c9-5cdf-85f9-16bcc6c8db5b" :answer/type {:db/ident :answer.type/math} :answer/value "6{t}^{2}" :db/id #edb/ref 17592186282765} :answer-field/id #uuid "771db56a-a84d-5c67-ab37-e76a138f7e66" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284138}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "78b6efe3-1fb5-5655-97e2-03def53db36e" :question/math-academy-id "q-167453" :question/problem "If $f(x,y,z)=x{y}^{2}+y{z}^{3}$ and $r(t)={t}^{3}\\,i+\\,j+t\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x{y}^{2}+y{z}^{3})\\,i+\\frac{∂}{∂y}(x{y}^{2}+y{z}^{3})\\,j+\\frac{∂}{∂z}(x{y}^{2}+y{z}^{3})\\,k \\\\  & ={y}^{2}\\,i+(2xy+{z}^{3})\\,j+3y{z}^{2}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{3},y=1,$ and $z=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\,i+3{t}^{3}\\,j+3{t}^{2}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(1)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =3{t}^{2}i+(0)\\,j+\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\,i+3{t}^{3}\\,j+3{t}^{2}\\,k)\\cdot (3{t}^{2}i+(0)\\,j+\\,k) \\\\  & =1\\cdot 3{t}^{2}+3{t}^{3}\\cdot 0+3{t}^{2}\\cdot 1 \\\\  & =3{t}^{2}+3{t}^{2} \\\\  & =6{t}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043ac664-b524-524e-aa72-bf1d30123527" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186357793} {:answer/id #uuid "af3ddaa4-8953-5d46-9032-e2f95ff616b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2t{cos}^{3}⁡2t" :db/id #edb/ref 17592186359275} {:answer/id #uuid "c43dfc74-6743-5922-a14e-6c2caaeb73de" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t{sin}^{3}⁡t" :db/id #edb/ref 17592186359473} {:answer/id #uuid "cc97c0a8-0127-5bdc-a492-17ba4f68be95" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359546} {:answer/id #uuid "da9c33c8-b2a5-5f98-b17d-5810e16dbeda" :answer/type {:db/ident :answer.type/math} :answer/value "{cos}^{2}⁡t" :db/id #edb/ref 17592186359665}] :answer-field/correct {:answer/id #uuid "043ac664-b524-524e-aa72-bf1d30123527" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186357793} :answer-field/id #uuid "f9feea77-0770-57d9-9bdc-bf443c95c674" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360439}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a60dcabe-5a9f-584e-9268-2f3213ceda5a" :question/math-academy-id "q-95070" :question/problem "If $f(x,y,z)={x}^{4}-{y}^{4}-\\operatorname{cos}⁡z$ and $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+2t\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}({x}^{4}-{y}^{4}-\\operatorname{cos}⁡z)\\,i+\\frac{∂}{∂y}({x}^{4}-{y}^{4}-\\operatorname{cos}⁡z)\\,j+\\frac{∂}{∂z}({x}^{4}-{y}^{4}-\\operatorname{cos}⁡z)\\,k \\\\  & =4{x}^{3}\\,i-4{y}^{3}\\,j+\\operatorname{sin}⁡z\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,$ $y=\\operatorname{cos}⁡t$ and $z=2t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =4{sin}^{3}⁡t\\,i-4{cos}^{3}⁡t\\,j+\\operatorname{sin}⁡2t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2t)\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(4{sin}^{3}⁡t\\,i-4{cos}^{3}⁡t\\,j+\\operatorname{sin}⁡2t\\,k)\\cdot (\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\,k) \\\\  & =4{sin}^{3}⁡t\\cdot \\operatorname{cos}⁡t-4{cos}^{3}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{sin}⁡2t\\cdot 2 \\\\  & =4{sin}^{3}⁡t\\operatorname{cos}⁡t+4{cos}^{3}⁡t\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t \\\\  & =4\\operatorname{sin}⁡t\\operatorname{cos}⁡t({sin}^{2}⁡t+{cos}^{2}⁡t)+2\\operatorname{sin}⁡2t \\\\  & =4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2\\operatorname{sin}⁡2t \\\\  & =2\\operatorname{sin}⁡2t+2\\operatorname{sin}⁡2t \\\\  & =4\\operatorname{sin}⁡2t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1347f5a2-01c0-5c7b-b717-680930abc12b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2t{e}^{t}+1}{t}" :db/id #edb/ref 17592186357914} {:answer/id #uuid "4c03b829-963e-5a53-bccb-1865320c6ba0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{t}+1}{t}" :db/id #edb/ref 17592186358409} {:answer/id #uuid "8e8b2be7-935d-58f9-a8d2-f58e5e602a05" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{t-1}(1-t)" :db/id #edb/ref 17592186358993} {:answer/id #uuid "a48fbdf1-c888-5cc7-ad1f-26a035cc7e15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2t+1}{t}" :db/id #edb/ref 17592186359180} {:answer/id #uuid "aa082587-0924-59bd-be2d-48ce5c0b988c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186359215}] :answer-field/correct {:answer/id #uuid "a48fbdf1-c888-5cc7-ad1f-26a035cc7e15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2t+1}{t}" :db/id #edb/ref 17592186359180} :answer-field/id #uuid "9c6ee750-c6b9-5399-bdf4-e7500571e2b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360267}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "75389de5-3518-524a-bf8a-ad60601e753c" :question/math-academy-id "q-95072" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(xyz)$ and $r(t)=t\\,i+{e}^{t-1}\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xyz))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xyz))\\,j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(xyz))\\,k \\\\  & =\\frac{yz}{xyz}\\,i+\\frac{xz}{xyz}\\,j+\\frac{xy}{xyz}\\,k \\\\  & =\\frac{1}{x}\\,i+\\frac{1}{y}\\,j+\\frac{1}{z}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y={e}^{t-1},$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{1}{t}\\,i+\\frac{1}{{e}^{t-1}}\\,j+\\frac{1}{{e}^{t}}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t-1})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =i+{e}^{t-1}\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{1}{t}\\,i+\\frac{1}{{e}^{t-1}}\\,j+\\frac{1}{{e}^{t}}\\,k)\\cdot (i+{e}^{t-1}\\,j+{e}^{t}\\,k) \\\\  & =\\frac{1}{t}+\\frac{{e}^{t-1}}{{e}^{t-1}}+\\frac{{e}^{t}}{{e}^{t}} \\\\  & =\\frac{1}{t}+2 \\\\  & =\\frac{2t+1}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d173fc-2ace-5c23-8e6c-2e1100a8bcd4" :answer/type {:db/ident :answer.type/math} :answer/value "4t(t-\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186358124} {:answer/id #uuid "55409a0b-0c25-504a-bd65-c0781332f04d" :answer/type {:db/ident :answer.type/math} :answer/value "4+4t+{t}^{2}\\operatorname{ln}⁡t" :db/id #edb/ref 17592186358492} {:answer/id #uuid "ce0052e5-1ee4-5d5c-9667-77f78de9d0a8" :answer/type {:db/ident :answer.type/math} :answer/value "4(t-\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186359564} {:answer/id #uuid "ee064399-1401-555f-b6c0-3013abc3be94" :answer/type {:db/ident :answer.type/math} :answer/value "4t(t-1)" :db/id #edb/ref 17592186359872} {:answer/id #uuid "f41185b3-09b1-59b6-88eb-3c7555fb8f88" :answer/type {:db/ident :answer.type/math} :answer/value "4(\\operatorname{ln}⁡t+1)" :db/id #edb/ref 17592186359919}] :answer-field/correct {:answer/id #uuid "f41185b3-09b1-59b6-88eb-3c7555fb8f88" :answer/type {:db/ident :answer.type/math} :answer/value "4(\\operatorname{ln}⁡t+1)" :db/id #edb/ref 17592186359919} :answer-field/id #uuid "a6daa545-65f3-5e47-b745-8aab21ef0ff5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360290}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ce5cc103-892b-5471-8317-cbb325d2454d" :question/math-academy-id "q-95142" :question/problem "If $f(x,y,z)=x({y}^{2}-{z}^{2})$ and $r(t)=\\operatorname{ln}⁡t\\,i+(t+1)\\,j+(t-1)\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}[x({y}^{2}-{z}^{2})]\\,i+\\frac{∂}{∂y}[x({y}^{2}-{z}^{2})]\\,j+\\frac{∂}{∂z}[x({y}^{2}-{z}^{2})]\\,k \\\\  & =({y}^{2}-{z}^{2})\\,i+2xy\\,j-2xz\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{ln}⁡t,$ $y=t+1$ and $z=t-1$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =[(t+1)^{2}-(t-1)^{2}]i+2\\operatorname{ln}⁡t\\cdot (t+1)\\,j-2\\operatorname{ln}⁡t\\cdot (t-1)\\,k \\\\  & =4t\\,i+2(t+1)\\operatorname{ln}⁡t\\,j-2(t-1)\\operatorname{ln}⁡t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t+1)\\,j+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,k \\\\  & =\\frac{1}{t}\\,i+\\,j+\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(4t\\,i+2(t+1)\\operatorname{ln}⁡t\\,j-2(t-1)\\operatorname{ln}⁡t\\,k)\\cdot (\\frac{1}{t}\\,i+\\,j+\\,k) \\\\  & =4t\\cdot \\frac{1}{t}+2(t+1)\\operatorname{ln}⁡t\\cdot 1-2(t-1)\\operatorname{ln}⁡t\\cdot 1 \\\\  & =4+2(t+1)\\operatorname{ln}⁡t-2(t-1)\\operatorname{ln}⁡t \\\\  & =4+4\\operatorname{ln}⁡t \\\\  & =4(\\operatorname{ln}⁡t+1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67fb2e01-985f-513d-813b-cfde3f1b377e" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2t}\\operatorname{cos}⁡t" :db/id #edb/ref 17592186358661} {:answer/id #uuid "788c776c-5597-51d2-9394-be9dfb7f75ca" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2t}" :db/id #edb/ref 17592186358792} {:answer/id #uuid "901c96ff-6cee-55e9-8211-cd0101addfb6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2t}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)" :db/id #edb/ref 17592186359007} {:answer/id #uuid "a22be918-009f-5e59-9d70-9b6808c8792a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2t}(2\\operatorname{cos}⁡{t}^{2}-\\operatorname{sin}⁡{t}^{2})" :db/id #edb/ref 17592186359167} {:answer/id #uuid "cbc10872-0c59-572a-92f2-5c00d7f80870" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2t}(\\operatorname{cos}⁡{t}^{2}-t\\operatorname{sin}⁡{t}^{2})" :db/id #edb/ref 17592186359542}] :answer-field/correct {:answer/id #uuid "cbc10872-0c59-572a-92f2-5c00d7f80870" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2t}(\\operatorname{cos}⁡{t}^{2}-t\\operatorname{sin}⁡{t}^{2})" :db/id #edb/ref 17592186359542} :answer-field/id #uuid "fef695bf-af69-5590-8e72-7ce89ea59101" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360451}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ee940918-1cef-5c23-a56c-5afe1494fd57" :question/math-academy-id "q-95146" :question/problem "If $f(x,y,z)=yz\\operatorname{cos}⁡x$ and $r(t)={t}^{2}\\,i+{e}^{t}\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(yz\\operatorname{cos}⁡x)\\,i+\\frac{∂}{∂y}(yz\\operatorname{cos}⁡x)\\,j+\\frac{∂}{∂z}(yz\\operatorname{cos}⁡x)\\,k \\\\  & =-yz\\operatorname{sin}⁡x\\,i+z\\operatorname{cos}⁡x\\,j+y\\operatorname{cos}⁡x\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2},y={e}^{t},$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =-{e}^{2t}\\operatorname{sin}⁡{t}^{2}\\,i+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,j+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =2t\\,i+{e}^{t}\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(-{e}^{2t}\\operatorname{sin}⁡{t}^{2}\\,i+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,j+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,k)\\cdot (2t\\,i+{e}^{t}\\,j+{e}^{t}\\,k) \\\\  & =-2t{e}^{2t}\\operatorname{sin}⁡{t}^{2}+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\cdot {e}^{t}+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\cdot {e}^{t} \\\\  & =-2t{e}^{2t}\\operatorname{sin}⁡{t}^{2}+2{e}^{2t}\\operatorname{cos}⁡{t}^{2} \\\\  & =2{e}^{2t}(\\operatorname{cos}⁡{t}^{2}-t\\operatorname{sin}⁡{t}^{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5305687e-83d8-5c87-af7d-a5b0a362d788" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡t+{e}^{{t}^{2}}+t" :db/id #edb/ref 17592186358466} {:answer/id #uuid "631de459-4352-5ad1-949e-8ac23d4b20f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡t+2t{e}^{{t}^{2}}" :db/id #edb/ref 17592186358613} {:answer/id #uuid "b15809fa-40bc-5563-9a51-d40e84efc938" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}" :db/id #edb/ref 17592186359292} {:answer/id #uuid "c66b80bb-3662-52ab-bf2e-dab3fb4673d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t+{e}^{{t}^{2}}-1" :db/id #edb/ref 17592186359496} {:answer/id #uuid "e0073e63-c4b1-5f0a-b806-ed90e183c49f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡t+\\frac{{e}^{{t}^{2}}}{{t}^{2}}" :db/id #edb/ref 17592186359718}] :answer-field/correct {:answer/id #uuid "b15809fa-40bc-5563-9a51-d40e84efc938" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}" :db/id #edb/ref 17592186359292} :answer-field/id #uuid "d86a4006-7e81-5ee9-a91c-4ead86d71714" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360371}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "312e3468-92a5-5996-9fc8-ac654be83975" :question/math-academy-id "q-95149" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(xz)+{e}^{y}$ and $r(t)=\\operatorname{sin}⁡t\\,i+{t}^{2}\\,j+\\frac{1}{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,k \\\\  & =\\frac{1}{x}\\,i+{e}^{y}\\,j+\\frac{1}{z}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,y={t}^{2},$ and $z=\\frac{1}{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{1}{\\operatorname{sin}⁡t}\\,i+{e}^{{t}^{2}}\\,j+t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})k \\\\  & =\\operatorname{cos}⁡t\\,i+2t\\,j-\\frac{1}{{t}^{2}}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{1}{\\operatorname{sin}⁡t}\\,i+{e}^{{t}^{2}}\\,j+t\\,k)\\cdot (\\operatorname{cos}⁡t\\,i+2t\\,j-\\frac{1}{{t}^{2}}\\,k) \\\\  & =\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+2t{e}^{{t}^{2}}-\\frac{t}{{t}^{2}} \\\\  & =\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}.\\end{aligned}\n$$"}] :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Three Variables"}] [{:db/id #edb/ref 17592186124471 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124278 :question/id #uuid "f44b6ea6-694c-5f54-94ee-4c4a699bf4eb" :question/math-academy-id "e-3696" :question/problem "Compute the rate of change of the function $f(x,y,z)=x^2-y^2-z$ with respect to $t$ along the curve $\\mathbf r (t) = \\left \\langle \\sin t, \\cos t, t  \\right \\rangle$ at the point $t=\\dfrac \\pi 4.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $\\mathbf r (t)$ is given by $\\dfrac {\\textrm d}{\\textrm d t} [f(\\mathbf r (t))] .$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\dfrac {\\textrm d}{\\textrm d t} [f(\\mathbf r (t))] = \\nabla f(\\mathbf{r}(t)) \\cdot \\mathbf{r}'(t).\n$$\n\nFirst, we need to compute $\\nabla f(x,y){:}$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}({x}^{2}-{y}^{2}-z),\\frac{∂}{∂y}({x}^{2}-{y}^{2}-z),\\frac{∂}{∂z}({x}^{2}-{y}^{2}-z)⟩ \\\\  & =⟨2x,-2y,-1⟩\\end{aligned}\n$$\n\nNext, we substitute $x = \\sin t, y=\\cos t,$ and $z=t$ into the above to find $\\nabla f(\\mathbf r(t)){:}$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨2\\operatorname{sin}⁡t,-2\\operatorname{cos}⁡t,-1⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,1⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨2\\operatorname{sin}⁡t,-2\\operatorname{cos}⁡t,-1⟩\\cdot ⟨\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,1⟩ \\\\  & =2\\operatorname{sin}⁡t\\cdot \\operatorname{cos}⁡t-2\\operatorname{cos}⁡t\\cdot (-\\operatorname{sin}⁡t)-1\\cdot 1 \\\\  & =2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t-1 \\\\  & =4\\operatorname{sin}⁡t\\operatorname{cos}⁡t-1.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $\\mathbf{r}(t)$ at $t=\\dfrac{\\pi}{4}$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\frac{\\pi }{4}))] & =4\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4})-1 \\\\  & =4\\cdot \\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{2}}{2}-1 \\\\  & =1.\\end{aligned}\n$$"} :knowledge-point/id #uuid "ea1e5a55-a957-52cd-b693-0e48770672a6" :knowledge-point/questions [{:db/id #edb/ref 17592186124960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bde96964-49e5-5f8c-9a85-bf83f3f624a6" :answer/type {:db/ident :answer.type/math} :answer/value "-17" :db/id #edb/ref 17592186122361} {:answer/id #uuid "c18873f1-6416-5e3f-84a8-30f0d1e34a57" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186122362} {:answer/id #uuid "eb8b5412-a282-5231-a52a-c430c381a304" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186122363} {:answer/id #uuid "55bd4f06-001b-5b40-9449-067e29d3fd21" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186122364} {:answer/id #uuid "5c13ba27-5c90-535c-9ea9-9232444e86bb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186122365}] :answer-field/id #uuid "30ce640c-974a-53b3-8a92-6e2b4d383ffe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122360}] :question/id #uuid "e234e1ce-e3a5-5460-9b85-a8876cb6e36c" :question/math-academy-id "q-36247" :question/problem "Compute the rate of change of the function $f(x, y, z) = x^{2} + 3xyz$ with respect to $t$ along the curve $r(t) = ⟨t^{2}, t + 1,-t⟩$ at the point $t = 1$."} {:db/id #edb/ref 17592186124961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ace15edc-01db-5886-b390-82e1ee604ab0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cos 2" :db/id #edb/ref 17592186122367} {:answer/id #uuid "b8fa671d-44d0-5673-bcc2-5869484b719b" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cos 8" :db/id #edb/ref 17592186122368} {:answer/id #uuid "0b632d6e-7a98-53fb-a62b-8c9001dbea44" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186122369} {:answer/id #uuid "256c9cc6-616a-5cb0-87f5-11a7534c3ee6" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cos 2" :db/id #edb/ref 17592186122370} {:answer/id #uuid "621b4a41-2040-513d-8f05-896248a7bf71" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos 2" :db/id #edb/ref 17592186122371}] :answer-field/id #uuid "bbe9c851-9ada-5f1b-ae5b-56517e51d11b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122366}] :question/id #uuid "8571bcaa-6cdf-5385-98c4-d1ed2624cfd7" :question/math-academy-id "q-36253" :question/problem "Compute the rate of change of the function $f(x, y) = \\sin (x - y)$ with respect to $t$ along the curve $r(t) = ⟨2\\sqrt{t}, 4t⟩$ at the point $t = 1$."} {:db/id #edb/ref 17592186284587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "945b9c04-6a85-5d2f-aac7-20fb300b68cb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186282964} {:answer/id #uuid "a0759ec4-44c2-5df4-8049-d2141efec4e2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9}" :db/id #edb/ref 17592186283086} {:answer/id #uuid "cefe4dd8-87f4-5862-998f-f2f8be85aafb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186283496} {:answer/id #uuid "ec5f7e03-4f52-5b2c-83bb-c9656091962b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186283757} {:answer/id #uuid "f0bb78c7-3837-59e6-b577-9cf297b1d8d0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283790}] :answer-field/correct {:answer/id #uuid "ec5f7e03-4f52-5b2c-83bb-c9656091962b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186283757} :answer-field/id #uuid "d53902b6-01db-5851-b51a-31934c273c12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284305}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b00d973d-5785-5a66-98c1-0a412869e903" :question/math-academy-id "q-167499" :question/problem "Compute the rate of change of the function $f(x,y)=\\frac{x}{y}$ with respect to $t$ along the curve $r(t)=⟨2t,\\sqrt{t}⟩$ at the point $t=9.$" :question/worked-solution "The rate of change of $f(x,y)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\frac{x}{y}),\\frac{∂}{∂y}(\\frac{x}{y})⟩ \\\\  & =⟨\\frac{1}{y},-\\frac{x}{{y}^{2}}⟩\\end{aligned}\n$$\n\nNext, we substitute $x=2t$ and $y=\\sqrt{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨\\frac{1}{\\sqrt{t}},-2⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨2,\\frac{1}{2\\sqrt{t}}⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨\\frac{1}{\\sqrt{t}},-2⟩\\cdot ⟨2,\\frac{1}{2\\sqrt{t}}⟩ \\\\  & =\\frac{1}{\\sqrt{t}}\\cdot 2-2\\cdot \\frac{1}{2\\sqrt{t}} \\\\  & =\\frac{2}{\\sqrt{t}}-\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{1}{\\sqrt{t}}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=9$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(9))] & =\\frac{1}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323770 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a620de-8bd0-57cc-9ca8-627d570b10b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-2}{2}" :db/id #edb/ref 17592186321285} {:answer/id #uuid "539a1518-741f-5932-ab88-ffb0b81d4bb1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}-1" :db/id #edb/ref 17592186321805} {:answer/id #uuid "6d69e5bf-08b0-519c-bd8e-5f0d93d50b2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186321997} {:answer/id #uuid "ac78bbbd-2aa6-5d72-9963-b167b6edf486" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}-4}{4}" :db/id #edb/ref 17592186322497} {:answer/id #uuid "c761e53e-5917-50ee-b4b8-03842b140243" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186322693}] :answer-field/correct {:answer/id #uuid "ac78bbbd-2aa6-5d72-9963-b167b6edf486" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}-4}{4}" :db/id #edb/ref 17592186322497} :answer-field/id #uuid "5a86fdda-9d41-5703-bec7-0aa41e4dbc4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323345}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0c3c463e-b1e6-5da9-a9e8-9ab02a63ca2d" :question/math-academy-id "q-36227" :question/problem "Compute the rate of change of the function $f(x,y)={x}^{3}+{y}^{2}$ with respect to $t$ along the curve $r(t)=⟨\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩$ at the point $t=\\frac{\\pi }{4}.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}({x}^{3}+{y}^{2}),\\frac{∂}{∂y}({x}^{3}+{y}^{2})⟩ \\\\  & =⟨3{x}^{2},2y⟩\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t$ and $y=\\operatorname{cos}⁡t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨3{sin}^{2}⁡t,2\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨3{sin}^{2}⁡t,2\\operatorname{cos}⁡t⟩\\cdot ⟨\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t⟩ \\\\  & =3{sin}^{2}⁡t\\cdot \\operatorname{cos}⁡t+2\\operatorname{cos}⁡t\\cdot (-\\operatorname{sin}⁡t) \\\\  & =3{sin}^{2}⁡t\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=\\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\frac{\\pi }{4}))] & =3{sin}^{2}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4})-2\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =3\\cdot {(\\frac{\\sqrt{2}}{2})}^{2}\\cdot \\frac{\\sqrt{2}}{2}-2\\cdot \\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{3\\sqrt{2}}{4}-1 \\\\  & =\\frac{3\\sqrt{2}-4}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65cdcc58-be4b-5338-b00a-ddcb5371bd93" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186358643} {:answer/id #uuid "6b40bd8f-7feb-594d-94b7-c6fe911edb9c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358691} {:answer/id #uuid "743c9228-cbd8-5669-88ae-262b1ab32094" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186358757} {:answer/id #uuid "93cbeb11-d6d7-50dd-9acd-c56791d17285" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359047} {:answer/id #uuid "bd23f796-bcb5-5c88-998f-bd753a03f298" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186359399}] :answer-field/correct {:answer/id #uuid "6b40bd8f-7feb-594d-94b7-c6fe911edb9c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358691} :answer-field/id #uuid "e85aac1a-a384-579c-bfda-1155a57b6d9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360406}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8defdc8d-5773-5ad6-96bf-f8efe589fed9" :question/math-academy-id "q-94884" :question/problem "Compute the rate of change of the function $f(x,y)={x}^{2}-{y}^{2}$ with respect to $t$ along the curve $r(t)=⟨{t}^{2},2t-1⟩$ at the point $t=0.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}({x}^{2}-{y}^{2}),\\frac{∂}{∂y}({x}^{2}-{y}^{2})⟩ \\\\  & =⟨2x,-2y⟩\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2}$ and $y=2t-1$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨2{t}^{2},-2(2t-1)⟩ \\\\  & =⟨2{t}^{2},2-4t⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\frac{\\text{d}}{\\text{d}t}(2t-1)⟩ \\\\  & =⟨2t,2⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨2{t}^{2},2-4t⟩\\cdot ⟨2t,2⟩ \\\\  & =2{t}^{2}\\cdot 2t+(2-4t)\\cdot 2 \\\\  & =4{t}^{3}-8t+4.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=0$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(0))] & =4(0)^{3}-8(0)+4 \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360527 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36ecb641-5c9e-59d2-9af0-e8b4b2b12cda" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186358237} {:answer/id #uuid "3913aa2e-745b-50de-97ac-427a88ec41d5" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186358256} {:answer/id #uuid "58cc3bc9-ecef-54de-9839-9c06a26426b5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186358521} {:answer/id #uuid "996b9c09-c035-53fe-ba0a-1216f4518389" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186359098} {:answer/id #uuid "dd14b83a-9e9f-5129-b7b0-19250eeeb3f4" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186359698}] :answer-field/correct {:answer/id #uuid "996b9c09-c035-53fe-ba0a-1216f4518389" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186359098} :answer-field/id #uuid "31bbcbbe-389e-5798-9aef-8032762b891a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360071}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "53f0d6f9-0bd0-5fbc-870f-a5ea8fa6cdba" :question/math-academy-id "q-94887" :question/problem "Compute the rate of change of the function $f(x,y,z)=xyz$ with respect to $t$ along the curve $r(t)=⟨2t,\\sqrt{t},3t-1⟩$ at the point $t=1.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(xyz),\\frac{∂}{∂y}(xyz),\\frac{∂}{∂z}(xyz)⟩ \\\\  & =⟨yz,xz,xy⟩\\end{aligned}\n$$\n\nNext, we substitute $x=2t,y=\\sqrt{t}$ and $z=3t-1$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨\\sqrt{t}(3t-1),2t(3t-1),2t\\sqrt{t}⟩ \\\\  & =⟨(3t-1)\\sqrt{t},6{t}^{2}-2t,2t\\sqrt{t}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}),\\frac{\\text{d}}{\\text{d}t}(3t-1)⟩ \\\\  & =⟨2,\\frac{1}{2\\sqrt{t}},3⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨(3t-1)\\sqrt{t},6{t}^{2}-2t,2t\\sqrt{t}⟩\\cdot ⟨2,\\frac{1}{2\\sqrt{t}},3⟩ \\\\  & =(3t-1)\\sqrt{t}\\cdot 2+(6{t}^{2}-2t)\\cdot \\frac{1}{2\\sqrt{t}}+2t\\sqrt{t}\\cdot 3 \\\\  & =6t\\sqrt{t}-2\\sqrt{t}+\\frac{3{t}^{2}-t}{\\sqrt{t}}+6t\\sqrt{t} \\\\  & =12t\\sqrt{t}-2\\sqrt{t}+\\frac{3{t}^{2}-t}{\\sqrt{t}}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=1$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(1))] & =12(1)\\sqrt{1}-2\\sqrt{1}+\\frac{3(1)^{2}-1}{\\sqrt{1}} \\\\  & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360528 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e78089-dc3f-5261-a0b9-838d20687d0e" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186357803} {:answer/id #uuid "50e71c08-98f9-50a2-a32b-d087d082f280" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186358447} {:answer/id #uuid "7c9f48cc-cae9-5cde-af64-d389fb6174af" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186358832} {:answer/id #uuid "b8de77d8-406c-5b9b-a817-38720fcff979" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186359354} {:answer/id #uuid "eec515f8-b1e7-52bb-b00a-3fe712040562" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186359881}] :answer-field/correct {:answer/id #uuid "b8de77d8-406c-5b9b-a817-38720fcff979" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186359354} :answer-field/id #uuid "c4f2da6b-5bbf-5958-acfc-6db810c9ab3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360333}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "102aa53b-1989-56be-b06a-9a6f6770770c" :question/math-academy-id "q-94888" :question/problem "Compute the rate of change of the function $f(x,y,z)=x{z}^{2}+{y}^{3}$ with respect to $t$ along the curve $r(t)=⟨t,4,\\sqrt{{t}^{2}-3}⟩$ at the point $t=2.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(x{z}^{2}+{y}^{3}),\\frac{∂}{∂y}(x{z}^{2}+{y}^{3}),\\frac{∂}{∂z}(x{z}^{2}+{y}^{3})⟩ \\\\  & =⟨{z}^{2},3{y}^{2},2xz⟩\\end{aligned}\n$$\n\nNext, we substitute $x=t,$ $y=4$ and $z=\\sqrt{{t}^{2}-3}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨(\\sqrt{{t}^{2}-3})^{2},3(4)^{2},2t\\sqrt{{t}^{2}-3}⟩ \\\\  & =⟨{t}^{2}-3,48,2t\\sqrt{{t}^{2}-3}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\frac{\\text{d}}{\\text{d}t}(4),\\sqrt{{t}^{2}-3}⟩ \\\\  & =⟨1,0,\\frac{t}{\\sqrt{{t}^{2}-3}}⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨{t}^{2}-3,48,2t\\sqrt{{t}^{2}-3}⟩\\cdot ⟨1,0,\\frac{t}{\\sqrt{{t}^{2}-3}}⟩ \\\\  & =({t}^{2}-3)\\cdot 1+48\\cdot 0+2t\\sqrt{{t}^{2}-3}\\cdot \\frac{t}{\\sqrt{{t}^{2}-3}} \\\\  & ={t}^{2}-3+0+2{t}^{2} \\\\  & =3{t}^{2}-3.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=2$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(2))] & =3(2)^{2}-3 \\\\  & =12-3 \\\\  & =9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b55c69-c88a-5b54-9cd7-12d2acc90eba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186358067} {:answer/id #uuid "46655cc2-46c6-57d9-aae7-530ec487a9e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{13}" :db/id #edb/ref 17592186358354} {:answer/id #uuid "5de3fd27-1a74-5e78-9c11-0753f0b2af77" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{17}" :db/id #edb/ref 17592186358573} {:answer/id #uuid "97ab5991-5eae-5b87-9b48-34164ebe108a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186359079} {:answer/id #uuid "a69903fd-123e-53f6-9cf8-6199c101e2e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186359192}] :answer-field/correct {:answer/id #uuid "97ab5991-5eae-5b87-9b48-34164ebe108a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186359079} :answer-field/id #uuid "0f8f9bfb-8eb2-5607-8ba8-b9429f52c201" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360026}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "530f5767-4f31-5ef7-a6dd-bdeac420a724" :question/math-academy-id "q-94891" :question/problem "Compute the rate of change of the function $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})$ with respect to $t$ along the curve $r(t)=⟨t-1,3,2t⟩$ at the point $t=0.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})),\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})),\\frac{∂}{∂z}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}))⟩ \\\\  & =⟨\\frac{2x}{{x}^{2}+{y}^{2}+{z}^{2}},\\frac{2y}{{x}^{2}+{y}^{2}+{z}^{2}},\\frac{2z}{{x}^{2}+{y}^{2}+{z}^{2}}⟩\\end{aligned}\n$$\n\nNext, we substitute $x=t-1,$ $y=3$ and $z=2t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨\\frac{2(t-1)}{(t-1)^{2}+(3)^{2}+(2t)^{2}},\\frac{2(3)}{(t-1)^{2}+(3)^{2}+(2t)^{2}},\\frac{2(2t)}{(t-1)^{2}+(3)^{2}+(2t)^{2}}⟩ \\\\  & =⟨\\frac{2t-2}{5{t}^{2}-2t+10},\\frac{6}{5{t}^{2}-2t+10},\\frac{4t}{5{t}^{2}-2t+10}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t-1),\\frac{\\text{d}}{\\text{d}t}(3),2t⟩ \\\\  & =⟨1,0,2⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨\\frac{2t-2}{5{t}^{2}-2t+10},\\frac{6}{5{t}^{2}-2t+10},\\frac{4t}{5{t}^{2}-2t+10}⟩\\cdot ⟨1,0,2⟩ \\\\  & =\\frac{2t-2}{5{t}^{2}-2t+10}\\cdot 1+\\frac{6}{5{t}^{2}-2t+10}\\cdot 0+\\frac{4t}{5{t}^{2}-2t+10}\\cdot 2 \\\\  & =\\frac{2t-2+8t}{5{t}^{2}-2t+10} \\\\  & =\\frac{10t-2}{5{t}^{2}-2t+10}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=0$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(0))] & =\\frac{10(0)-2}{5(0)^{2}-2(0)+10} \\\\  & =\\frac{-2}{10} \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$"}] :knowledge-point/title "Computing the Rate of Change of a Multivariable Function at a Point Using the Chain Rule"}] [{:db/id #edb/ref 17592186124472 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124283 :question/id #uuid "454d081a-fdcb-5101-9f85-0e3b27986695" :question/math-academy-id "e-3961" :question/problem "Which of the graphs below correspond to an invertible function?\n\n![](images/6f/6fbded3e0a3faefda0e1f2c8418f5e271fb116cde4082487096378f89511b695.png)" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.  \n\n![](images/50/5036479a948abee5644cd3b96632f6aaf8ee370f7473ba27e11d25bb84ddb781.png)\n\nFrom the above, we see that: \n\n- In graph IV, any horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graph IV  shows a one-to-one function. This means that the function is invertible.\n\n- For graphs I, II, and III, some horizontal lines intersect the curve more than once. So, these are not one-to-one functions. As a result, they are not invertible.\n\nTherefore, the correct answer is \"IV only\"."} :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048686 :topic/math-academy-id 756 :topic/title "Graphs of Inverse Functions"} {:db/id #edb/ref 17592186050525 :topic/math-academy-id 1886 :topic/title "One-To-One Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186124945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83c50bb0-5a30-5c78-855b-5564f93313de" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186122271} {:answer/id #uuid "cbf4ee8c-9ce5-5bf8-af60-bd5cfaf86725" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186122272} {:answer/id #uuid "3b2ce312-bc20-567f-bb2b-7d9b8d521463" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122273} {:answer/id #uuid "3b9ff3b6-a753-53c5-900e-035bfdafd68a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122274} {:answer/id #uuid "6d6a7f41-4acb-5aea-a511-2fe007ec9908" :answer/type {:db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186122275}] :answer-field/id #uuid "a4df7bfe-5317-532e-8a25-874444539327" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122270}] :question/id #uuid "75c89dd8-c054-57a5-9bbd-fa9eff000193" :question/math-academy-id "q-36000" :question/problem "![](images/8e/8e62c3485aed6c52001cc7ad8eda5c1eb09cd4873d6b740eb7595413dafa15e0.png)\n\nWhich of the graphs above correspond to an invertible function?"} {:db/id #edb/ref 17592186125018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5ab6900-c8da-56de-b62a-bf3a1d4d10d4" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186122709} {:answer/id #uuid "e2d89c4b-603f-53ac-a7b7-b89c17fd5c61" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186122710} {:answer/id #uuid "4693a105-893c-5ac9-9b6c-e651dc075271" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122711} {:answer/id #uuid "5e948606-25c1-55c6-9bde-c9158bb85ef6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122712} {:answer/id #uuid "766b5449-7ecc-5a19-ba23-f9f7d5c3156f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186122713}] :answer-field/id #uuid "db10059c-5b0b-55c3-9b