#{[{:db/id #edb/ref 17592186068695 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068547 :question/id #uuid "f12b3891-021d-5ae3-a767-f9d423408ce6" :question/math-academy-id "e-3567" :question/problem "Is the function $y=f(x),$ plotted below, continuous at $x=0?$\n\n![](images/e3/e395863ca66a7e87fa335c56e5b6aeb1ec206893e57b155bf64e5ab07be7545c.png)" :question/worked-solution "Because there is an asymptote at $x=0,$ it is impossible to draw the function in the neighborhood of $x=0$ without taking our pencil off of the paper.\n\nTherefore, the function $y=f(x)$ is not continuous at $x=0.$"} :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049534 :topic/math-academy-id 165 :topic/title "Piecewise Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186069365 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac78f8c-8c2c-5eca-b384-ae1453126b54" :answer/type {:db/ident :answer.type/image} :answer/value "images/40/4020dd89bf394f0a910c0c0ac41b702d0c07ca94f168b53d492a385ecfcc172c.png" :db/id #edb/ref 17592186327309} {:answer/id #uuid "46fa4afe-5e49-5513-9761-5d78cccbf89f" :answer/type {:db/ident :answer.type/image} :answer/value "images/4a/4a009c928e32ce14a37eacca63f932b3e18b0e699eafffd2a8627bcb2011c8c6.png" :db/id #edb/ref 17592186327552} {:answer/id #uuid "4f64a437-c3aa-51fa-b782-98d22e92092a" :answer/type {:db/ident :answer.type/image} :answer/value "images/56/56576892d082136128191d630527ec1ed8cd9344e68f2fadbf0b1f9e49bb56a6.png" :db/id #edb/ref 17592186327626} {:answer/id #uuid "9d3deefd-d7fb-5f7e-a3b0-83d254e3f178" :answer/type {:db/ident :answer.type/image} :answer/value "images/f4/f4a28f88570d49a7a4961147b9fd17cc848bde0944b6099a05af2775835c46f8.png" :db/id #edb/ref 17592186328294} {:answer/id #uuid "b23f7411-9474-56a0-a6be-b5fbd45a5802" :answer/type {:db/ident :answer.type/image} :answer/value "images/29/29ff22e9905cb9a4e4a9c4af14bce3a01042aeed7d77143b