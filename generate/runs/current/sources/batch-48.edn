pe/text} :answer/value "II and III only" :db/id #edb/ref 17592186346843} {:answer/id #uuid "bb9db866-8720-598b-af83-114dd5773144" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186346978} {:answer/id #uuid "dd80fc1e-6eab-5ddb-9563-26cba2c2d2a7" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347298} {:answer/id #uuid "f22c335d-cda9-5ae9-995c-087b8ca8dae1" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347493}] :answer-field/correct {:answer/id #uuid "aacbc7a0-b134-5a75-a87d-fd53948b0296" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346843} :answer-field/id #uuid "9b5d2966-8562-5e0a-b5f1-e9381bdd7052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347878}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ac549bb-41f9-5150-895e-d407a77f8e37" :question/math-academy-id "q-78131" :question/problem "![](images/3c/3c0dc4b8f7f45a5bc1177778431eccf9bcaac1bf6d520d605f9e6bc08d5b1d91.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\nI. $x=-2$\n\nII. $x=0$\n\nIII. $x=2$" :question/worked-solution "Let's consider each point separately.\n\n- The function $f(x)$ is not continuous at $x=-2.$ Since there is an asymptote at $x=-2,$ it is impossible to draw the function in the neighborhood of $x=-2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is continuous at $x=0.$ The graph can be drawn in the neighborhood of $x=0$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is continuous at $x=2.$ The graph can be drawn in the neighborhood of $x=2$ without taking our pencil off of the paper.\n\nHence, the correct answer is \"II and III only\"."} {:db/id #edb/ref 17592186348066 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01aeaace-3dee-5861-928d-6a23090d00f2" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345366} {:answer/id #uuid "01c007c5-b958-5f05-bcdb-d16eb849a4b8" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345367} {:answer/id #uuid "02100b32-fbcc-582d-903e-bf23af1e8c8e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345368} {:answer/id #uuid "c5a6767c-d2f1-526e-934e-fbbf34e09777" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347068} {:answer/id #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347512}] :answer-field/correct {:answer/id #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347512} :answer-field/id #uuid "01de2c48-cbc5-5a34-8784-842c895031e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5c2c6cc4-6d0f-5ca4-bd69-989208f699b4" :question/math-academy-id "q-78132" :question/problem "![](images/89/890e7eaf519a65ca19d4a90b604e7d7a8ab7054635296c4b08f000546f23b545.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\nI. $x=-2$\n\nII. $x=1$\n\nIII. $x=3$" :question/worked-solution "Let's consider each point separately.\n\n- The function $f(x)$ is continuous at $-2.$ The graph can be drawn in the neighborhood of $x=-2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is not continuous at $x=1.$ Since there is a jump at $x=1,$ it is impossible to draw the function in the neighborhood of $x=1$ without taking our pencil off of the paper.\n\n- Therefore, the function $f(x)$ is continuous $x=3.$ The graph can be drawn in the neighborhood of  $x=3$ without taking our pencil off of the paper.\n\nHence, the correct answer is  \"I and III only\".\n\n![](images/7c/7c96c401ddae0049859fd5608cb08c6ce9ae8a2e6c3db69d7d4b379b3824094e.png)"} {:db/id #edb/ref 17592186392615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5cffd7b-e09a-5e8f-9bc6-d30e9bf80623" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c6f0914f0b218164bc99fdefe7d83dffe4591a6b704e2243013d05c2b117ef17.png" :db/id #edb/ref 17592186392617} {:answer/id #uuid "3ba0ee0f-2ced-5835-84e5-0ed53e1549d3" :answer/type {:db/ident :answer.type/image} :answer/value "images/c2/c2f85d1a2becc7bfe6f71d7f6fcb178f4707f4b41956015eabb38610de95feca.png" :db/id #edb/ref 17592186392618} {:answer/id #uuid "d5853982-4adc-5148-b192-1f951c92f732" :answer/type {:db/ident :answer.type/image} :answer/value "images/14/14349b3dee80a6d451efedc55b91b5e709139f1a93fabf539d605843513f6141.png" :db/id #edb/ref 17592186392619} {:answer/id #uuid "a3c69f46-c3ba-5974-ae7f-6acba3a9675b" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/3073f651e0194c8675629f8fc52d45694a64680e3208b8fd7ef066e38d715033.png" :db/id #edb/ref 17592186392620} {:answer/id #uuid "b9c4e630-276e-54fd-922f-6f7389462a61" :answer/type {:db/ident :answer.type/image} :answer/value "images/c9/c95d9944eb569c36d0b546257b5fde5a2d8c2aa8984eb98d553df832c2b1989f.png" :db/id #edb/ref 17592186392621}] :answer-field/correct {:answer/id #uuid "e5cffd7b-e09a-5e8f-9bc6-d30e9bf80623" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c6f0914f0b218164bc99fdefe7d83dffe4591a6b704e2243013d05c2b117ef17.png" :db/id #edb/ref 17592186392617} :answer-field/id #uuid "9780e3c9-7665-5af4-99ca-1678d1cb66a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392616}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6b614a15-6e39-5d82-8606-db6fffa56cff" :question/math-academy-id "q-48082" :question/problem "Select the function that is continuous at $x=0.$" :question/worked-solution "The correct answer is shown below.  Indeed, despite the fact that the function has a discontinuity at $x=2$, the graph can be drawn in a neighborhood of $x=0$ without taking our pencil off of the paper.\n\n![](images/90/90c2fbe99d0b202e09244084d2501608018e030e6660a225f708cbc6b462dccd.png)\n\n   \n\nAll the other given graphs contain breaks at $x=0$ and it would be impossible to draw them in a neighborhood of $x=0$ without taking the pencil off of the paper."}] :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] [{:db/id #edb/ref 17592186068696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068548 :question/id #uuid "514240a0-8a38-564f-ab4c-d0bacb0c5f6b" :question/math-academy-id "e-3568" :question/problem "What are the points of discontinuity of the function $y=g(x),$ plotted below?\n\n![](images/6d/6d0d3c2cd072841546e66d70105436200e316e156901f8fe27dc150e96ff3da4.png)" :question/worked-solution "The points of discontinuity are at $x=0,$ $x=1,$ and $x=2.5.$ It is impossible to draw the function in the neighborhood of these three points without taking our pencil off of the page."} :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/questions [{:db/id #edb/ref 17592186069368 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa17146-c6c7-5f57-99cb-8b4f88241e1c" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 2$ and $x = 0$" :db/id #edb/ref 17592186067379} {:answer/id #uuid "f56223ce-52c2-5805-b123-5b321403e168" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186067380} {:answer/id #uuid "fe31fb35-056a-5723-b579-c5fcb9207404" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 2$ only" :db/id #edb/ref 17592186067381} {:answer/id #uuid 