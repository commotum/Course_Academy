26}}" :db/id #edb/ref 17592186285715} :answer-field/id #uuid "d28ece84-3df4-51e6-a121-897423efdecc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287579}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e415a913-d869-5296-88b6-0354f2046768" :question/math-academy-id "q-19143" :question/problem "Let $a=⟨2,1,-1⟩$ and $b=⟨1,4,2⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+1\\cdot 4+(-1)\\cdot 2}{\\sqrt{{1}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{21}}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{4}{\\sqrt{6}}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{\\sqrt{21}}-\\frac{4}{\\sqrt{6}} \\\\  & =\\frac{4\\sqrt{6}-4\\sqrt{21}}{\\sqrt{126}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28821f48-88e1-581d-b34d-ec1fc4f59a03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186285140} {:answer/id #uuid "49409df2-050f-52a4-8e83-0d1c45e7ad2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{5}" :db/id #edb/ref 17592186285462} {:answer/id #uuid "58358764-c4a7-5af5-92ea-b6dcb1906bdd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186285599} {:answer/id #uuid "7217bf98-ec78-513a-8e37-cb8d6a8b8ed9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{15}" :db/id #edb/ref 17592186285838} {:answer/id #uuid "e30bceea-881e-560d-b0c5-a474f1311ae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186286861}] :answer-field/correct {:answer/id #uuid "e30bceea-881e-560d-b0c5-a474f1311ae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{15}" :db/id #edb/ref 17592186286861} :answer-field/id #uuid "73a60c4c-5c55-56bb-b830-7bdc6154b85e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287389}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3ff49977-bf49-5e35-8d9c-c45493e6961d" :question/math-academy-id "q-19145" :question/problem "Let $c=⟨4,3,0⟩$ and $d=⟨2,1,2⟩.$ Find ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+3\\cdot 1+0\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{11}{\\sqrt{9}} \\\\  & =\\frac{11}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{11}{\\sqrt{{4}^{2}+{3}^{2}+{0}^{2}}} \\\\  & =\\frac{11}{\\sqrt{25}} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{11}{3}-\\frac{11}{5} \\\\  & =11(\\frac{1}{3}-\\frac{1}{5}) \\\\  & =11(\\frac{5}{15}-\\frac{3}{15}) \\\\  & =\\frac{22}{15}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1930a8b6-cd05-5bad-be3f-eae31bbbbee7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186285012} {:answer/id #uuid "b0026f8e-38dc-5c51-a2ec-b994f309e5ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{12}" :db/id #edb/ref 17592186286394} {:answer/id #uuid "d4184123-74bc-5c11-b1a2-60f3c7b8e2f7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186286715} {:answer/id #uuid "d4c28def-c746-5f59-b80d-ed038e2ec013" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{12}" :db/id #edb/ref 17592186286721} {:answer/id #uuid "fccd42d0-c67a-57fd-b47a-85f3c8797917" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287100}] :answer-field/correct {:answer/id #uuid "d4c28def-c746-5f59-b80d-ed038e2ec013" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{12}" :db/id #edb/ref 17592186286721} :answer-field/id #uuid "a60e4480-c03a-5f50-bfa4-7a3ebfb11c72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287481}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e1b2619c-accd-562b-971e-880743f34699" :question/math-academy-id "q-19146" :question/problem "Let $a=⟨-1,2,\\sqrt{11}⟩$ and $b=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149b0e75-0e0f-5b6e-898f-b91b5abc2f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{10}" :db/id #edb/ref 17592186284970} {:answer/id #uuid "539e28bb-ac48-5446-acd3-14cf0e617f7f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{29}{5}" :db/id #edb/ref 17592186285557} {:answer/id #uuid "5d2ad1eb-65e3-5cb3-8131-71ed7fbd9966" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186285642} {:answer/id #uuid "5edbada8-12de-53cc-8e94-28f1564de9d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29}{5}" :db/id #edb/ref 17592186285656} {:answer/id #uuid "9fa64933-2e58-52bb-a74a-53c5dfe77c92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186286243}] :answer-field/correct {:answer/id #uuid "5d2ad1eb-65e3-5cb3-8131-71ed7fbd9966" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186285642} :answer-field/id #uuid "1d07da54-40a4-54d3-b699-33effe67a77d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287210}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7a3ddc06-901e-5c3b-a45b-37325838cc5b" :question/math-academy-id "q-19147" :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292826 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43038c56-d384-5570-86af-704e0880166f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186290909}] :answer-field/correct {:answer/id #uuid "43038c56-d384-5570-86af-704e0880166f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186290909} :answer-field/id #uuid "6d92e0bb-bf02-560d-8309-29d74166634f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5b790374-4bad-5824-af22-323909fd339e" :question/math-academy-id "q-275244" :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c90fa25-691f-58a4-b734-448a6fca3732" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186291159}] :answer-field/correct {:answer/id #uuid "7c90fa25-691f-58a4-b734-448a6fca3732" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186291159} :answer-field/id #uuid "3c398229-da8b-56ee-b803-4aa60968cde1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291938}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "911cdd8c-0aad-54d0-80d8-17350e5cfd46" :question/math-academy-id "q-275245" :question/problem "Let $c=⟨1,2,-3⟩$ and $d=⟨2,1,2⟩.$ Find the scalar projection of $c$ onto $d.$\n\n${\\text{comp}}_{d}\\,c=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 2+2\\cdot 1+(-3)\\cdot 2}{\\sqrt{{2}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =-\\frac{2}{\\sqrt{9}} \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d7f3d04-9d9a-5db3-8121-2770a9e7e2ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186291102}] :answer-field/correct {:answer/id #uuid "6d7f3d04-9d9a-5db3-8121-2770a9e7e2ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186291102} :answer-field/id #uuid "35278910-7191-599c-8899-b91af97d2d88" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291910}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ec0f207d-cef1-5071-a74a-2301f10fe8e0" :question/math-academy-id "q-275247" :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299706 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e21be6-5288-5a39-b610-c229edf14988" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186298044}] :answer-field/correct {:answer/id #uuid "71e21be6-5288-5a39-b610-c229edf14988" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186298044} :answer-field/id #uuid "217237de-6b94-5d9f-a394-4d02f2866345" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298749}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4084d86f-eb87-5f25-b405-7c5720bf45bf" :question/math-academy-id "q-318977" :question/problem "Let $p=⟨4,-1,1⟩$ and $q=⟨1,2,2⟩.$ Find the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(4)(1)+(-1)(2)+(1)(2)}{\\sqrt{{1}^{2}+{2}^{2}+{2}^{2}}} \\\\  & =\\frac{4-2+2}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7883d86b-cdec-54e0-b22d-e3deedc52363" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186298077}] :answer-field/correct {:answer/id #uuid "7883d86b-cdec-54e0-b22d-e3deedc52363" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186298077} :answer-field/id #uuid "d1742b44-a127-5c8f-93df-71d8fba4ab73" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299348}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "aaf8f1e8-3743-57db-8cf5-200275190fd5" :question/math-academy-id "q-318979" :question/problem "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51311319-cccb-5499-b7df-82fada2209c7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297893}] :answer-field/correct {:answer/id #uuid "51311319-cccb-5499-b7df-82fada2209c7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297893} :answer-field/id #uuid "32644fe5-7234-58cb-be30-d57ff4db1d29" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298809}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7682317e-79ab-546a-b643-7edbcbe6f8ee" :question/math-academy-id "q-318981" :question/problem "Let $r=⟨-1,2,3⟩$ and $s=⟨2,0,0⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-1)(2)+(2)(0)+(3)(0)}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}} \\\\  & =\\frac{-2}{\\sqrt{4}} \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299709 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ecac01c-6f18-504a-a708-bcf3faabfed9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186297750}] :answer-field/correct {:answer/id #uuid "2ecac01c-6f18-504a-a708-bcf3faabfed9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186297750} :answer-field/id #uuid "2737ed18-d118-51f4-b5e7-ebf40846ad60" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298768}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b5e680fa-ce4a-56db-a90a-7d183fdb5f25" :question/math-academy-id "q-318987" :question/problem "Let $m=⟨6,8,0⟩$ and $n=⟨0,5,12⟩.$ Find ${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n.$\n\n${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =\\frac{m\\cdot n}{|\\,n\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{m}\\,n & =\\frac{m\\cdot n}{|\\,m\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c48ccf7-bca3-57a8-a2b5-7cdab2abc3bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186298234}] :answer-field/correct {:answer/id #uuid "9c48ccf7-bca3-57a8-a2b5-7cdab2abc3bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5}" :db/id #edb/ref 17592186298234} :answer-field/id #uuid "ce3473e6-0fcc-554b-8da2-28c6134ccc97" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299328}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c6dbc91c-6749-54fc-b502-867b88fba0c5" :question/math-academy-id "q-318988" :question/problem "Let $p=⟨9,12,0⟩$ and $q=⟨0,3,4⟩.$ Find ${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q.$\n\n${\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{(9)(0)+(12)(3)+(0)(4)}{\\sqrt{{0}^{2}+{3}^{2}+{4}^{2}}} \\\\  & =\\frac{36}{\\sqrt{25}} \\\\  & =\\frac{36}{5}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{36}{\\sqrt{{9}^{2}+{12}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{225}} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p-{\\text{comp}}_{p}\\,q & =\\frac{36}{5}-\\frac{12}{5} \\\\  & =\\frac{24}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379363 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00efebbd-b34e-5e1d-90ba-a1a1a499e767" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186379365}] :answer-field/correct {:answer/id #uuid "00efebbd-b34e-5e1d-90ba-a1a1a499e767" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186379365} :answer-field/id #uuid "0e556b82-e5e4-5c2f-9171-f94a4a3a1d96" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379364}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2aae90e0-11e3-5ee4-8f7d-d33e1592b8e6" :question/math-academy-id "q-318978" :question/problem "Let $r=⟨-3,2,4⟩$ and $s=⟨1,2,-1⟩.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =\\frac{r\\cdot s}{|\\,s\\,|} \\\\  & =\\frac{{r}_{x}{s}_{x}+{r}_{y}{s}_{y}+{r}_{z}{s}_{z}}{\\sqrt{{s}_{x}^{2}+{s}_{y}^{2}+{s}_{z}^{2}}} \\\\  & =\\frac{(-3)(1)+(2)(2)+(4)(-1)}{\\sqrt{{1}^{2}+{2}^{2}+(-1)^{2}}} \\\\  & =\\frac{-3+4-4}{\\sqrt{6}} \\\\  & =-\\frac{3}{\\sqrt{6}} \\\\  & =-\\frac{\\sqrt{6}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186379366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a08d5080-b0cc-529b-927c-57d7b8fb919c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186379368}] :answer-field/correct {:answer/id #uuid "a08d5080-b0cc-529b-927c-57d7b8fb919c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{3}}" :db/id #edb/ref 17592186379368} :answer-field/id #uuid "aedce65b-2d90-57c8-9df1-ce436a0e55d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379367}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "64a835fe-a6b3-525d-8366-194469689a7f" :question/math-academy-id "q-318984" :question/problem "Let $u=⟨3,1,-2⟩$ and $v=⟨1,1,1⟩.$ Find the scalar projection of $u$ onto $v.$\n\n${\\text{comp}}_{v}\\,u=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{v}\\,u & =\\frac{u\\cdot v}{|\\,v\\,|} \\\\  & =\\frac{{u}_{x}{v}_{x}+{u}_{y}{v}_{y}+{u}_{z}{v}_{z}}{\\sqrt{{v}_{x}^{2}+{v}_{y}^{2}+{v}_{z}^{2}}} \\\\  & =\\frac{(3)(1)+(1)(1)+(-2)(1)}{\\sqrt{{1}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{3+1-2}{\\sqrt{3}} \\\\  & =\\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Scalar Projection Using Components"}]}
