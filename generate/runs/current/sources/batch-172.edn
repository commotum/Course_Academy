#{[{:db/id #edb/ref 17592186105908 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105597 :question/id #uuid "c6f2dacc-11b0-5689-97d9-e1869c64aae1" :question/math-academy-id "e-4351" :question/problem "Find $k$ given that the vectors $\\mathbf{a}=\\langle k,2,1 \\rangle,$ $\\mathbf{b}=\\langle -2,-1,1 \\rangle,$ and $\\mathbf{c}=\\langle -1,1,2 \\rangle$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}k & 2 & 1 \\\\ -2 & -1 & 1 \\\\ -1 & 1 & 2\\end{aligned}| \\\\  & =k\\cdot |\\begin{aligned}-1 & 1 \\\\ 1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}-2 & 1 \\\\ -1 & 2\\end{aligned}|+1\\cdot |\\begin{aligned}-2 & -1 \\\\ -1 & 1\\end{aligned}| \\\\  & =k(-1\\cdot 2-1\\cdot 1)-2(-2\\cdot 2-(-1)\\cdot 1)+(-2\\cdot 1-(-1)\\cdot (-1)) \\\\  & =-3k+6-3 \\\\  & =-3k+3.\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ -3k+3 & =0 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=1$."} :knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673 :topic/math-academy-id 66 :topic/title "Solving Two-Step Equations"}] :knowledge-point/questions [{:db/id #edb/ref 17592186106094 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc44dcc3-6969-5a60-8a18-95e97d112e33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{8}" :db/id #edb/ref 17592186102441} {:answer/id #uuid "e883b87d-72f8-5f14-8f59-2baf9e4ae5d7" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186102442} {:answer/id #uuid "14d28786-6460-5a75-a3fa-c23f7eae95c1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186102443} {:answer/id #uuid "5cac3075-3c44-589e-b5a8-7fa80a0c376d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186102444} {:answer/id #uuid "712d9e14-16ae-5193-8b95-86f2de039186" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186102445}] :answer-field/id #uuid "18712464-37e4-5f7a-8b58-067e22b69002" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102440}] :question/id #uuid "32fff2ee-f94f-5f06-8837-996515d03ed2" :question/math-academy-id "q-18260" :question/problem "Find $k$ given that the vectors $a = ⟨k, 1, 1⟩$, $b = ⟨5, 0, 4⟩$, and $c = ⟨6, 2, 5⟩$ are coplanar."} {:db/id #edb/ref 17592186106095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91deb4db-6b2a-544a-ba74-25f888d469ac" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186102447} {:answer/id #uuid "c29df26f-2f8c-5d14-9196-e5107c54f911" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186102448} {:answer/id #uuid "cf8b0a72-6c5b-5545-80b7-68d22aa15109" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102449} {:answer/id #uuid "d2285774-835c-5d92-9c39-8d811ec66713" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186102450} {:answer/id #uuid "0a269770-4d2f-5b51-8afe-9049f4a722d4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186102451}] :answer-field/id #uuid "37b8f48f-b324-5fdc-82a9-632d1ad15e21" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102446}] :question/id #uuid "b990ba56-2404-5f20-a869-596a97b7f65e" :question/math-academy-id "q-18268" :question/problem "Find $t$ given that the vectors $p = ⟨3, t, t⟩$, $q = ⟨1, 3, 1⟩$, and $r = ⟨1, 1, 3⟩$ are coplanar."} {:db/id #edb/ref 17592186262894 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "002fdf74-6f71-54b2-830e-d9c31f46d601" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}" :db/id #edb/ref 17592186259874} {:answer/id #uuid "2aca00cd-0b17-53b6-983e-a2657da0646e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260251} {:answer/id #uuid "700a04d5-9011-5132-bdd4-e0be0859896c" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186260858} {:answer/id #uuid "a765a9d3-1a6b-59c4-8235-ac04896438b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{11}" :db/id #edb/ref 17592186261337} {:answer/id #uuid "c020a971-5df5-5817-a759-23a1a56b9b6f" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186261573}] :answer-field/correct {:answer/id #uuid "c020a971-5df5-5817-a759-23a1a56b9b6f" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186261573} :answer-field/id #uuid "22e9d0a6-6a14-5045-961e-92c3a61748d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262185}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "28e94f1b-b25a-5f14-a6d0-bd87b063c727" :question/math-academy-id "q-128436" :question/problem "Find $k$ given that the vectors $a=⟨k,1,4⟩,$ $b=⟨8,0,3⟩,$ and $c=⟨3,1,1⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}k & 1 & 4 \\\\ 8 & 0 & 3 \\\\ 3 & 1 & 1\\end{aligned}| \\\\  & =k\\cdot |\\begin{aligned}0 & 3 \\\\ 1 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}8 & 3 \\\\ 3 & 1\\end{aligned}|+4\\cdot |\\begin{aligned}8 & 0 \\\\ 3 & 1\\end{aligned}| \\\\  & =k(0\\cdot 1-1\\cdot 3)-(8\\cdot 1-3\\cdot 3)+4(8\\cdot 1-3\\cdot 0) \\\\  & =-3k+1+32 \\\\  & =33-3k \\\\  & =3(11-k).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 3(11-k) & =0 \\\\ 11-k & =0 \\\\ k & =11\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=11.$"} {:db/id #edb/ref 17592186262898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a7c5d9-8dc5-5287-9189-8dca5356aa94" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260178} {:answer/id #uuid "5ed1a437-b5e4-5a5b-a1d5-378ea7dd2b92" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260693} {:answer/id #uuid "9ff60d17-d510-5a62-8746-39d3d4fdeede" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186261263} {:answer/id #uuid "c622ad11-5bd8-50ea-9342-3a5d4042082b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261620} {:answer/id #uuid "c6e3045d-1419-56b9-bd4b-6b851cebb90e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261633}] :answer-field/correct {:answer/id #uuid "c622ad11-5bd8-50ea-9342-3a5d4042082b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261620} :answer-field/id #uuid "3c52dcf6-c646-5640-b426-05ef9c526397" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262232}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ff1c8b22-7226-5d88-9238-4a3a4ca77456" :question/math-academy-id "q-128454" :question/problem "Find $t$ given that the vectors $p=⟨t,t,1⟩,$ $q=⟨3,2,6⟩,$ and $r=⟨3,4,0⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}t & t & 1 \\\\ 3 & 2 & 6 \\\\ 3 & 4 & 0\\end{aligned}| \\\\  & =t\\cdot |\\begin{aligned}2 & 6 \\\\ 4 & 0\\end{aligned}|-t\\cdot |\\begin{aligned}3 & 6 \\\\ 3 & 0\\end{aligned}|+1\\cdot |\\begin{aligned}3 & 2 \\\\ 3 & 4\\end{aligned}| \\\\  & =t(2\\cdot 0-4\\cdot 6)-t(3\\cdot 0-3\\cdot 6)+(3\\cdot 4-3\\cdot 2) \\\\  & =-24t+18t+6 \\\\  & =-6t+6 \\\\  & =6(1-t).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 6(1-t) & =0 \\\\ 1-t & =0 \\\\ t & =1\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=1.$"} {:db/id #edb/ref 17592186262899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0735f2d3-4813-5f6a-8ebd-3180c4020c9a" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186259945} {:answer/id #uuid "1dd7650e-e217-51b4-8281-479af6811358" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186260132} {:answer/id #uuid "308d2e52-c1bb-5e72-989b-40a3fc41595e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186260312} {:answer/id #uuid "33903820-9a8f-5e3f-9139-32338148d2e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186260343} {:answer/id #uuid "499d6073-74e0-579f-97bb-9cb4a8239ff0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186260509}] :answer-field/correct {:answer/id #uuid "1dd7650e-e217-51b4-8281-479af6811358" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186260132} :answer-field/id #uuid "b025cca6-310c-5c80-a31c-1d52565eae81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262441}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "23db8f87-cf26-5e8b-9a16-08cc8381ac4f" :question/math-academy-id "q-128456" :question/problem "Find $t$ given that the vectors $a=⟨3,-1,7⟩,$ $b=⟨t,4,t⟩,$ and $c=⟨2,6,8⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}3 & -1 & 7 \\\\ t & 4 & t \\\\ 2 & 6 & 8\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}4 & t \\\\ 6 & 8\\end{aligned}|-(-1)\\cdot |\\begin{aligned}t & t \\\\ 2 & 8\\end{aligned}|+7\\cdot |\\begin{aligned}t & 4 \\\\ 2 & 6\\end{aligned}| \\\\  & =3(4\\cdot 8-6\\cdot t)+(t\\cdot 8-2\\cdot t)+7(t\\cdot 6-2\\cdot 4) \\\\  & =96-18t+8t-2t+42t-56 \\\\  & =30t+40 \\\\  & =10(3t+4).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 10(3t+4) & =0 \\\\ 3t+4 & =0 \\\\ t & =-\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=-\\frac{4}{3}.$"} {:db/id #edb/ref 17592186287823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20ff76ae-3310-5976-b521-37e9f161c00c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2,k=2" :db/id #edb/ref 17592186285085} {:answer/id #uuid "36a55f04-0655-55ca-bff1-1b7ac91e9f99" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3,k=3" :db/id #edb/ref 17592186285297} {:answer/id #uuid "7d71d038-0b8e-53eb-98a4-4f2424b98e1d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186285941} {:answer/id #uuid "d004be87-813b-53a7-aaa4-dec132a85008" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186286681} {:answer/id #uuid "ffa8a48c-b3c4-5cc9-a1a6-003916fe2b42" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1,k=1" :db/id #edb/ref 17592186287132}] :answer-field/correct {:answer/id #uuid "d004be87-813b-53a7-aaa4-dec132a85008" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186286681} :answer-field/id #uuid "08df0eaf-8693-5325-ba44-b70c3634becf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287163}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b9713970-1739-5ce7-ae00-abfb91e16a2c" :question/math-academy-id "q-18266" :question/problem "Find $k$ given that the vectors  $p=⟨0,-1,-{k}^{2}⟩,q=⟨2,4,8⟩$ and $r=⟨-1,-1,5⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}0 & -1 & -{k}^{2} \\\\ 2 & 4 & 8 \\\\ -1 & -1 & 5\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}4 & 8 \\\\ -1 & 5\\end{aligned}|-(-1)\\cdot |\\begin{aligned}2 & 8 \\\\ -1 & 5\\end{aligned}|+(-{k}^{2})\\cdot |\\begin{aligned}2 & 4 \\\\ -1 & -1\\end{aligned}| \\\\  & =0+(2\\cdot 5-(-1)\\cdot 8)-{k}^{2}(2\\cdot (-1)-(-1)\\cdot 4) \\\\  & =18-2{k}^{2}.\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 18-2{k}^{2} & =0 \\\\ 2{k}^{2} & =18 \\\\ {k}^{2} & =9 \\\\ k & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-3$ or $k=3.$"} {:db/id #edb/ref 17592186292841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bfef10-81ba-573e-b324-c7127dd0dcb7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290704}] :answer-field/correct {:answer/id #uuid "10bfef10-81ba-573e-b324-c7127dd0dcb7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290704} :answer-field/id #uuid "bb77c768-bf57-5c30-9432-4fac33eb1964" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292308}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4a8b31c-e171-5959-8851-e81cf194bca8" :question/math-academy-id "q-275353" :question/problem "Find $k$ given that the vectors $a=⟨-2,1,-3⟩$, $b=⟨-1,k,2⟩$, and $c=⟨3,-2,4⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 1 & -3 \\\\ -1 & k & 2 \\\\ 3 & -2 & 4\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}k & 2 \\\\ -2 & 4\\end{aligned}|-1\\cdot |\\begin{aligned}-1 & 2 \\\\ 3 & 4\\end{aligned}|+(-3)\\cdot |\\begin{aligned}-1 & k \\\\ 3 & -2\\end{aligned}| \\\\  & =-2(k\\cdot 4-(-2)\\cdot 2)-((-1)\\cdot 4-3\\cdot 2)-3((-1)\\cdot (-2)-3\\cdot k) \\\\  & =-8k-8+10-6+9k \\\\  & =k-4.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ k-4 & =0 \\\\ k & =4\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=4.$"} {:db/id #edb/ref 17592186295168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0618fdf5-9970-590e-8185-d4fd25d3af95" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186292957}] :answer-field/correct {:answer/id #uuid "0618fdf5-9970-590e-8185-d4fd25d3af95" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186292957} :answer-field/id #uuid "03def6c9-038a-52fb-8620-4828ee17ec9b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293942}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "02a24008-f4b2-51f6-bfa2-34173306dcaa" :question/math-academy-id "q-280720" :question/problem "Find $k$ given that the vectors $x=⟨2,0,k⟩$, $y=⟨1,4,3⟩$, and $z=⟨0,2,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =|\\begin{aligned}2 & 0 & k \\\\ 1 & 4 & 3 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}4 & 3 \\\\ 2 & 5\\end{aligned}|-0\\cdot |\\begin{aligned}1 & 3 \\\\ 0 & 5\\end{aligned}|+k\\cdot |\\begin{aligned}1 & 4 \\\\ 0 & 2\\end{aligned}| \\\\  & =2(4\\cdot 5-3\\cdot 2)+0+k(1\\cdot 2-4\\cdot 0) \\\\  & =2(20-6)+2k \\\\  & =28+2k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =0 \\\\ 28+2k & =0 \\\\ 2k & =-28 \\\\ k & =-14\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-14.$"} {:db/id #edb/ref 17592186295169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153692ac-17dc-5340-8ab8-c764df7ca660" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186293019}] :answer-field/correct {:answer/id #uuid "153692ac-17dc-5340-8ab8-c764df7ca660" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186293019} :answer-field/id #uuid "1b34c4d0-3f40-5fab-a961-3f1c1324f59d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294015}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "61f3e6a0-31a0-537c-a9de-e6c7ae59826e" :question/math-academy-id "q-280722" :question/problem "Find $k$ given that the vectors $a=⟨1,3,0⟩$, $b=⟨0,4,2⟩$, and $c=⟨2,k,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\na\\cdot (b\\times c)=|\\begin{aligned}1 & 3 & 0 \\\\ 0 & 4 & 2 \\\\ 2 & k & 5\\end{aligned}|\n$$\n\n$$\n\\begin{aligned} & =1\\cdot |\\begin{aligned}4 & 2 \\\\ k & 5\\end{aligned}|-3\\cdot |\\begin{aligned}0 & 2 \\\\ 2 & 5\\end{aligned}|+0\\cdot |\\begin{aligned}0 & 4 \\\\ 2 & k\\end{aligned}| \\\\  & =(4\\cdot 5-2\\cdot k)-3(0\\cdot 5-2\\cdot 2)=(20-2k)+12 \\\\  & =32-2k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 32-2k & =0 \\\\ -2k & =-32 \\\\ k & =16\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=16.$"} {:db/id #edb/ref 17592186295170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c2dab13-46de-5120-87e8-8117a287ba97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186293049}] :answer-field/correct {:answer/id #uuid "1c2dab13-46de-5120-87e8-8117a287ba97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186293049} :answer-field/id #uuid "89673c8b-815d-53a8-b014-fbcc596ce325" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294419}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee4f8503-0b7f-5200-9b9f-9ac97e166c2a" :question/math-academy-id "q-280729" :question/problem "Find $k$ given that the vectors $a=⟨1,k,k⟩$, $b=⟨0,3,2⟩$, and $c=⟨4,0,5⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & k & k \\\\ 0 & 3 & 2 \\\\ 4 & 0 & 5\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}3 & 2 \\\\ 0 & 5\\end{aligned}|-k\\cdot |\\begin{aligned}0 & 2 \\\\ 4 & 5\\end{aligned}|+k\\cdot |\\begin{aligned}0 & 3 \\\\ 4 & 0\\end{aligned}| \\\\  & =1(3\\cdot 5-2\\cdot 0)-k(0\\cdot 5-2\\cdot 4)+k(0\\cdot 0-3\\cdot 4) \\\\  & =15+8k-12k \\\\  & =15-4k\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 15-4k & =0 \\\\ 4k & =15 \\\\ k & =\\frac{15}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{15}{4}.$"} {:db/id #edb/ref 17592186295171 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1865ae1-27be-5cb9-8458-215d6d36baf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186293871}] :answer-field/correct {:answer/id #uuid "f1865ae1-27be-5cb9-8458-215d6d36baf6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186293871} :answer-field/id #uuid "4a9e2261-c7fc-53d6-9874-00c30b303f22" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294193} {:answer-field/choices [{:answer/id #uuid "99a0dde8-2f69-5f2c-aab5-cf49c4fd974f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293539}] :answer-field/correct {:answer/id #uuid "99a0dde8-2f69-5f2c-aab5-cf49c4fd974f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186293539} :answer-field/id #uuid "c8ff6522-eece-5b68-a25a-d04312e1a764" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294640}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "85dbcbc6-7e0b-5364-ba3b-2e4b14e4021a" :question/math-academy-id "q-280735" :question/problem "Find $k$ given that the vectors $a=⟨4,{k}^{2},2⟩$, $b=⟨1,5,3⟩$, and $c=⟨2,1,0⟩$ are coplanar.\n\n**In ascending order:** $\\,$\n\n$k=${{field-1}}\n$\\,$\nand\n$\\,$\n$k=${{field-2}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}4 & {k}^{2} & 2 \\\\ 1 & 5 & 3 \\\\ 2 & 1 & 0\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}5 & 3 \\\\ 1 & 0\\end{aligned}|-{k}^{2}\\cdot |\\begin{aligned}1 & 3 \\\\ 2 & 0\\end{aligned}|+2\\cdot |\\begin{aligned}1 & 5 \\\\ 2 & 1\\end{aligned}| \\\\  & =4(5\\cdot 0-3\\cdot 1)-{k}^{2}(1\\cdot 0-3\\cdot 2)+2(1\\cdot 1-5\\cdot 2) \\\\  & =4(-3)-{k}^{2}(0-6)+2(1-10) \\\\  & =-12+6{k}^{2}-18 \\\\  & =6{k}^{2}-30\\end{aligned}\n$$\n\nSet the triple product equal to 0:\n\n$$\n\\begin{aligned}6{k}^{2}-30 & =0 \\\\ 6{k}^{2} & =30 \\\\ {k}^{2} & =5 \\\\ k & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if \n$k=-\\sqrt{5}$ or $k=\\sqrt{5}.$"} {:db/id #edb/ref 17592186326925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09532a7b-1bde-5425-aa2a-a897fa63b438" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186324054} {:answe