42070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a2ef31a-319f-5526-8854-d1b97cef6f67" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186339500} {:answer/id #uuid "9e339643-b9aa-5ec5-bb9d-d0f58d998ae9" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186340554} {:answer/id #uuid "c980250c-e65e-5d17-8ea3-88bc5b175137" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186340914} {:answer/id #uuid "f2befcf1-babe-5a30-94de-07cd59778c2a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341267} {:answer/id #uuid "f570d31c-370d-5b83-a9d2-4dd414372eed" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186341294}] :answer-field/correct {:answer/id #uuid "f2befcf1-babe-5a30-94de-07cd59778c2a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341267} :answer-field/id #uuid "30f2ba25-a3d1-5f35-b797-85e2998465c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341465}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a2d9a59-591c-58a1-9378-a824f178afc5" :question/math-academy-id "q-73735" :question/problem "Find $t$ given that the vectors $p=⟨0,3,6⟩$, $q=⟨t,t,2⟩$, and $r=⟨-1,2,7⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}0 & 3 & 6 \\\\ t & t & 2 \\\\ -1 & 2 & 7\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}t & 2 \\\\ 2 & 7\\end{aligned}|-3\\cdot |\\begin{aligned}t & 2 \\\\ -1 & 7\\end{aligned}|+6\\cdot |\\begin{aligned}t & t \\\\ -1 & 2\\end{aligned}| \\\\  & =0-3(t\\cdot 7-(-1)\\cdot 2)+6(t\\cdot 2-(-1)\\cdot t) \\\\  & =-21t-6+12t+6t \\\\  & =-3t-6.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ -3t-6 & =0 \\\\ -3t & =6 \\\\ t & =-2\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=-2.$"} {:db/id #edb/ref 17592186342071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "480d8a6c-d976-500e-a7e2-36b07adb1298" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339770} {:answer/id #uuid "92b3ca28-cec3-54f5-8108-604c09001fb6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340447} {:answer/id #uuid "b5ccd3d8-500a-5a10-b8dd-140f303da80d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186340777} {:answer/id #uuid "c7936625-73aa-5282-9707-cfefef43ada2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186340898} {:answer/id #uuid "d4ddbf57-82d0-56ba-af3f-5120ce6bc488" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186341009}] :answer-field/correct {:answer/id #uuid "b5ccd3d8-500a-5a10-b8dd-140f303da80d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186340777} :answer-field/id #uuid "b9dc32f6-3810-5869-9997-de4c6edc03fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341702}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "029d2415-156a-588b-85c8-9df58fb943a2" :question/math-academy-id "q-73736" :question/problem "Find $t$ given that the vectors $p=⟨t,1,t⟩$, $q=⟨2,-1,-1⟩$, and $r=⟨3,0,1⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}t & 1 & t \\\\ 2 & -1 & -1 \\\\ 3 & 0 & 1\\end{aligned}| \\\\  & =t\\cdot |\\begin{aligned}-1 & -1 \\\\ 0 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}|+t\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}| \\\\  & =t((-1)\\cdot 1-0\\cdot (-1))-(2\\cdot 1-3\\cdot (-1))+t(2\\cdot 0-3\\cdot (-1)) \\\\  & =-t-5+3t \\\\  & =2t-5.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 2t-5 & =0 \\\\ 2t & =5 \\\\ t & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=\\frac{5}{2}.$"} {:db/id #edb/ref 17592186378566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6523e66f-3eae-532d-af4f-39b785b57f03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186378568} {:answer/id #uuid "ac0d16a7-95d1-5a5f-aa7e-734db7ae523b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186378569} {:answer/id #uuid "9365d6aa-7405-5556-acfb-cdae2d97fb83" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186378570} {:answer/id #uuid "03bf534f-e82e-5f46-aa2b-26e765dc8c2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186378571} {:answer/id #uuid "b288711d-0efe-5c03-b8d4-fcbdbce46686" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186378572}] :answer-field/correct {:answer/id #uuid "03bf534f-e82e-5f46-aa2b-26e765dc8c2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186378571} :answer-field/id #uuid "ee88383b-1dff-5bb7-9ff0-c76d09dd0d5d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378567}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "df2041e4-731a-5917-8788-670168bfca15" :question/math-academy-id "q-128453" :question/problem "Find $k$ given that the vectors $a=⟨8,4,6⟩,$ $b=⟨8,-4,5⟩,$ and $c=⟨0,2,k⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}8 & 4 & 6 \\\\ 8 & -4 & 5 \\\\ 0 & 2 & k\\end{aligned}| \\\\  & =8\\cdot |\\begin{aligned}-4 & 5 \\\\ 2 & k\\end{aligned}|-4\\cdot |\\begin{aligned}8 & 5 \\\\ 0 & k\\end{aligned}|+6\\cdot |\\begin{aligned}8 & -4 \\\\ 0 & 2\\end{aligned}| \\\\  & =8(-4\\cdot k-2\\cdot 5)-4(8\\cdot k-0\\cdot 5)+6(8\\cdot 2-0\\cdot (-4)) \\\\  & =-32k-80-32k+96 \\\\  & =16-64k \\\\  & =16(1-4k).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 16(1-4k) & =0 \\\\ 1-4k & =0 \\\\ k & =\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=\\frac{1}{4}.$"} {:db/id #edb/ref 17592186379355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8d6275c-2c2f-59ab-b7b4-5b1eda58e833" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{1}{10}}" :db/id #edb/ref 17592186379357}] :answer-field/correct {:answer/id #uuid "e8d6275c-2c2f-59ab-b7b4-5b1eda58e833" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{1}{10}}" :db/id #edb/ref 17592186379357} :answer-field/id #uuid "10207b0f-c379-5c84-8c28-c24da6e3a13b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379356} {:answer-field/choices [{:answer/id #uuid "bfbdee37-0e15-5189-bc70-8dfc3870c722" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{\\frac{1}{10}}" :db/id #edb/ref 17592186379359}] :answer-field/correct {:answer/id #uuid "bfbdee37-0e15-5189-bc70-8dfc3870c722" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{\\frac{1}{10}}" :db/id #edb/ref 17592186379359} :answer-field/id #uuid "62836b52-5826-5320-94c6-63c604cf8b0d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379358}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fe6d904a-8846-5cf7-a75e-99f480622386" :question/math-academy-id "q-280772" :question/problem "Find $k$ given that the vectors $x=⟨{k}^{2},-2,5⟩$, $y=⟨1,3,4⟩$, and $z=⟨0,-1,2⟩$ are coplanar.\n\n**In ascending order:** $\\,$\n\n$k=${{field-1}}\n$\\,$\nand\n$\\,$\n$k=${{field-2}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =|\\begin{aligned}{k}^{2} & -2 & 5 \\\\ 1 & 3 & 4 \\\\ 0 & -1 & 2\\end{aligned}| \\\\  & ={k}^{2}\\cdot |\\begin{aligned}3 & 4 \\\\ -1 & 2\\end{aligned}|-(-2)\\cdot |\\begin{aligned}1 & 4 \\\\ 0 & 2\\end{aligned}|+5\\cdot |\\begin{aligned}1 & 3 \\\\ 0 & -1\\end{aligned}| \\\\  & ={k}^{2}(3\\cdot 2-4\\cdot (-1))+2(1\\cdot 2-4\\cdot 0)+5(1\\cdot -1-3\\cdot 0) \\\\  & ={k}^{2}(6+4)+2(2)+5(-1) \\\\  & =10{k}^{2}+4-5 \\\\  & =10{k}^{2}-1\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =0 \\\\ 10{k}^{2}-1 & =0 \\\\ 10{k}^{2} & =1 \\\\ {k}^{2} & =\\frac{1}{10} \\\\ k & =\\pm \\sqrt{\\frac{1}{10}}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if \n$k=-\\sqrt{\\frac{1}{10}}$ or $k=\\sqrt{\\frac{1}{10}}.$"} {:db/id #edb/ref 17592186400338 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce1c52bd-3b80-591c-b1ee-da79ec0a2f5b" :answer/type {:db/ident :answer.type/text} :answer/value "$k=\\sqrt{6}$ only" :db/id #edb/ref 17592186400340} {:answer/id #uuid "0be7aabd-bcca-5a8a-a91e-5d1dfb6c9d3d" :answer/type {:db/ident :answer.type/text} :answer/value "$k=-6$ or $k=6$" :db/id #edb/ref 17592186400341} {:answer/id #uuid "07cf905c-bfd7-597a-b011-0bc724c98f3c" :answer/type {:db/ident :answer.type/text} :answer/value "$k=-\\sqrt{6}$ only" :db/id #edb/ref 17592186400342} {:answer/id #uuid "1c100f4f-e0f0-5fd4-9658-c15b9ace8765" :answer/type {:db/ident :answer.type/text} :answer/value "$k=-\\sqrt{6}$ or $k=\\sqrt{6}$" :db/id #edb/ref 17592186400343} {:answer/id #uuid "7316d970-6133-533d-8bfb-659fe822cc85" :answer/type {:db/ident :answer.type/text} :answer/value "$k=-\\sqrt{3}$ or $k=\\sqrt{3}$" :db/id #edb/ref 17592186400344}] :answer-field/correct {:answer/id #uuid "1c100f4f-e0f0-5fd4-9658-c15b9ace8765" :answer/type {:db/ident :answer.type/text} :answer/value "$k=-\\sqrt{6}$ or $k=\\sqrt{6}$" :db/id #edb/ref 17592186400343} :answer-field/id #uuid "d47d5cb7-6394-509c-81ff-79c6a1373831" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400339}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "41e53fe4-b06e-5150-a976-5badf29f5d4c" :question/math-academy-id "q-128461" :question/problem "Find $k$ given that the vectors $a=⟨{k}^{2},7,4⟩,$ $b=⟨6,7,4⟩,$ and $c=⟨3,0,2⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}{k}^{2} & 7 & 4 \\\\ 6 & 7 & 4 \\\\ 3 & 0 & 2\\end{aligned}| \\\\  & ={k}^{2}\\cdot |\\begin{aligned}7 & 4 \\\\ 0 & 2\\end{aligned}|-7\\cdot |\\begin{aligned}6 & 4 \\\\ 3 & 2\\end{aligned}|+4\\cdot |\\begin{aligned}6 & 7 \\\\ 3 & 0\\end{aligned}| \\\\  & ={k}^{2}(7\\cdot 2-0\\cdot 4)-7(6\\cdot 2-3\\cdot 4)+4(6\\cdot 0-3\\cdot 7) \\\\  & =14{k}^{2}+0-84 \\\\  & =14{k}^{2}-84 \\\\  & =14({k}^{2}-6).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 14({k}^{2}-6) & =0 \\\\ {k}^{2}-6 & =0 \\\\ {k}^{2} & =6 \\\\ k & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\sqrt{6}$ or $k=\\sqrt{6}.$"}] :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] [{:db/id #edb/ref 17592186105909 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105598 :question/id #uuid "4deee6cc-69e4-5da4-9c78-57bf6c988500" :question/math-academy-id "e-4352" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overrightarrow{AB},$ $\\overrightarrow{AC},$ and $\\overrightarrow{AD},$ given the points $A(3,-1,2),$ $B(2,1,1),$ $C(-1,2,1),$ and $D(4,4,2).$" :question/worked-solution "First, we find the displacement vectors $\\overrightarrow{AB},$ $\\overrightarrow{AC},$ and $\\overrightarrow{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i+j+k)-(3i-j+2k) \\\\  & =-i+2j-k \\\\  & =⟨-1,2,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-i+2j+k)-(3i-j+2k) \\\\  & =-4i+3j-k \\\\  & =⟨-4,3,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(4i+4j+2k)-(3i-j+2k) \\\\  & =i+5j \\\\  & =⟨1,5,0⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-1 & 2 & -1 \\\\ -4 & 3 & -1 \\\\ 1 & 5 & 0\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}3 & -1 \\\\ 5 & 0\\end{aligned}|-2\\cdot |\\begin{aligned}-4 & -1 \\\\ 1 & 0\\end{aligned}|+(-1)\\cdot |\\begin{aligned}-4 & 3 \\\\ 1 & 5\\end{aligned}| \\\\  & =-(3\\cdot 0-5\\cdot (-1))-2((-4)\\cdot 0-1\\cdot (-1))-((-4)\\cdot 5-1\\cdot 3) \\\\  & =-5-2+23 \\\\  & =16.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overrightarrow{AB},$ $\\overrightarrow{AC},$ and $\\overrightarrow{AD}$ is\n\n$$\nV=|16|=16.\n$$"} :knowledge-point/id #uuid "57c790ad-c7fb-596c-8b60-cddd9b4e2165" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051021 :topic/math-academy-id 1277 :topic/title "Calculating the Magnitude of Cartesian Vectors in 3D"}] :knowledge-point/questions [{:db/id #edb/ref 17592186106044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad8221b0-abe5-5ff1-bc3c-90d12161ae4d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186102151} {:answer/id #uuid "af030614-b019-5cb7-af82-49461aee453a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186102152} {:answer/id #uuid "f7689ce5-7f20-51b0-9bf1-02cf4cfa28a0" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186102153} {:answer/id #uuid "20089b8e-9e90-54c9-b1aa-d58c28a522ad" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186102154} {:answer/id #uuid "415bcf68-6460-529e-98b7-2570d358ca23" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102155}] :answer-field/id #uuid "e745e616-1f75-5e2e-88b5-a1da5a69b25d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102150}] :question/id #uuid "292a1bfa-7936-5037-9015-22a88ecb52f3" :question/math-academy-id "q-128472" :question/problem "Calculate the volume of the parallelepiped spanned by $AB^(→)$, $AC^(→)$ and $AD^(→)$, given the points $A(9, 6, 1)$, $B(9, 7, 2)$, $C(7, 5, 2)$, and $D(7, 8, 3)$."} {:db/id #edb/ref 17592186106135 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf3c4e57-2ad8-56ca-9a27-7faa2aaf1255" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186102687} {:answer/id #uuid "d07f6bfb-5502-5a87-b026-3ef84ecd878d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186102688} {:answer/id #uuid "ec1ae10b-c98c-5aea-b28d-a0931aaf66da" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186102689} {:answer/id #uuid "4b15e493-3d4c-50d7-8e36-9379740a5e5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186102690} {:answer/id #uuid "5c8d1f64-85e4-551c-8f55-38866b9af8a0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186102691}] :answer-field/id #uuid "5a8e5f2b-038e-5f94-8231-636fcf8c722e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102686}] :question/id #uuid "c6409f39-73a4-56e7-9d4f-f576ba58985d" :question/math-academy-id "q-20138" :question/problem "Calculate the volume of the parallelepiped spanned by $AB^(→)$, $AC^(→)$ and $AD^(→)$, given the points $A(1, 2,-1)$, $B(2, 3, 1)$, $C(4, 1, 2)$, and $D(1, 4, 2)$."} {:db/id #edb/ref 17592186262907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196c7bb9-2703-5d83-8058-24be71bcb43b" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186260097} {:answer/id #uuid "44662d03-7907-5288-b2f2-17f084b58313" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260471} {:answer/id #uuid "5d8121de-a71a-5f79-841e-03f4c4d8f85c" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186260679} {:answer/id #uuid "c69b8832-1644-5736-8a79-f96a8d866802" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186261625} {:answer/id #uuid "fba18045-5247-5864-b09c-6d2f59aad9bf" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186262075}] :answer-field/correct {:answer/id #uuid "44662d03-7907-5288-b2f2-17f084b58313" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260471} :answer-field/id #uuid "00e3b359-0ccd-5626-ac16-03a3053097e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262125}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1edaed17-510c-5349-a80b-092dc57c864f" :question/math-academy-id "q-128475" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(7,6,4),$ $B(8,5,9),$ $C(7,4,2),$ and $D(5,7,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(8i+5j+9k)-(7i+6j+4k) \\\\  & =i-j+5k \\\\  & =⟨1,-1,5⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(7i+4j+2k)-(7i+6j+4k) \\\\  & =-2j-2k \\\\  & =⟨0,-2,-2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(5i+7j+4k)-(7i+6j+4k) \\\\  & =-2i+j \\\\  & =⟨-2,1,0⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}1 & -1 & 5 \\\\ 0 & -2 & -2 \\\\ -2 & 1 & 0\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}-2 & -2 \\\\ 1 & 0\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}|+5\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}| \\\\  & =((-2)\\cdot 0-1\\cdot (-2))+(0\\cdot 0-(-2)\\cdot (-2))+5(0\\cdot 1-(-2)\\cdot (-2)) \\\\  & =2-4-20 \\\\  & =-22.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-22|=22.\n$$"} {:db/id #edb/ref 17592186262912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2758af71-201a-5743-a5ec-86afd2e415e2" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260219} {:answer/id #uuid "2d261462-d03d-544c-a8a9-5aadec24e0f3" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260283} {:answer/id #uuid "329c90d2-6fee-5509-8239-ab93f795292c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186260332} {:answer/id #uuid "7f3acf1f-c9af-515f-b70d-f86b50febc38" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186260981} {:answer/id #uuid "ebd8e8e6-f4f4-53d7-b173-9afee1bb078b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186261944}] :answer-field/correct {:answer/id #uuid "ebd8e8e6-f4f4-53d7-b173-9afee1bb078b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186261944} :answer-field/id #uuid "e4794f4f-7acb-5b9b-a59f-bc47efacaf2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262529}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "86e3bae5-31f6-5b6c-93f8-27d7bdeaa8bf" :question/math-academy-id "q-128483" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(5,1,4),$ $B(4,1,7),$ $C(3,1,5),$ and $D(2,3,3).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(4i+j+7k)-(5i+j+4k) \\\\  & =-i+3k \\\\  & =⟨-1,0,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+j+5k)-(5i+j+4k) \\\\  & =-2i+k \\\\  & =⟨-2,0,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+3j+3k)-(5i+j+4k) \\\\  & =-3i+2j-k \\\\  & =⟨-3,2,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-1 & 0 & 3 \\\\ -2 & 0 & 1 \\\\ -3 & 2 & -1\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}0 & 1 \\\\ 2 & -1\\end{aligned}|-0\\cdot |\\begin{aligned}-2 & 1 \\\\ -3 & -1\\end{aligned}|+3\\cdot |\\begin{aligned}-2 & 0 \\\\ -3 & 2\\end{aligned}| \\\\  & =-(0\\cdot (-1)-2\\cdot 1)-0+3((-2)\\cdot 2-(-3)\\cdot 0) \\\\  & =2-12 \\\\  & =-10.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-10|=10.\n$$"} {:db/id #edb/ref 17592186287979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b91b1ff-04f2-5241-991f-a0cc2cfb0602" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186284879} {:answer/id #uuid "5c7e0a12-c398-51c0-ac5a-185f2ba8acab" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186285635} {:answer/id #uuid "7171ef21-9125-54d8-8548-7452920c7a72" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186285829} {:answer/id #uuid "af7840a2-d107-597a-a2b9-cc938cae9f63" :answer/type {:db/ident :answer.type/math} :answer/value "29" :db/id #edb/ref 17592186286386} {:answer/id #uuid "ef5d05e0-fae6-5640-bc73-d08f6f6d4a87" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186286984}] :answer-field/correct {:answer/id #uuid "7171ef21-9125-54d8-8548-7452920c7a72" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186285829} :answer-field/id #uuid "62967656-4da8-539f-8bc8-d9d85e319b59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287356}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1d7560d3-4e5c-58e1-a4ce-975d4218030d" :question/math-academy-id "q-20145" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(2,1,2)$, $B(3,3,3)$, $C(-2,-1,3)$, and $D(4,1,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(3i+3j+3k)-(2i+j+2k) \\\\  & =i+2j+k \\\\  & =⟨1,2,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-2i-j+3k)-(2i+j+2k) \\\\  & =-4i-2j+k \\\\  & =⟨-4,-2,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(4i+j+4k)-(2i+j+2k) \\\\  & =2i+2k \\\\  & =⟨2,0,2⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}1 & 2 & 1 \\\\ -4 & -2 & 1 \\\\ 2 & 0 & 2\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}-2 & 1 \\\\ 0 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}-4 & 1 \\\\ 2 & 2\\end{aligned}|+1\\cdot |\\begin{aligned}-4 & -2 \\\\ 2 & 0\\end{aligned}| \\\\  & =((-2)\\cdot 2-0\\cdot 1)-2((-4)\\cdot 2-2\\cdot 1)+((-4)\\cdot 0-2\\cdot (-2)) \\\\  & =-4+20+4 \\\\  & =20.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|20|=20.\n$$"} {:db/id #edb/ref 17592186295127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26d8406f-9482-553b-b669-150af1e6419e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293103}] :answer-field/correct {:answer/id #uuid "26d8406f-9482-553b-b669-150af1e6419e" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186293103} :answer-field/id #uuid "884c153a-6afe-5960-8b8a-07f28b451975" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294417}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "227e2bc0-7de3-5c22-93a6-04542a843855" :question/math-academy-id "q-280314" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(1,0,-2),$ $B(3,-2,1),$ $C(-1,4,-1),$ and $D(2,1,0).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(3i-2j+k)-(i-2k) \\\\  & =2i-2j+3k \\\\  & =⟨2,-2,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-i+4j-k)-(i-2k) \\\\  & =-2i+4j+k \\\\  & =⟨-2,4,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+j)-(i-2k) \\\\  & =i+j+2k \\\\  & =⟨1,1,2⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}2 & -2 & 3 \\\\ -2 & 4 & 1 \\\\ 1 & 1 & 2\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}4 & 1 \\\\ 1 & 2\\end{aligned}|-(-2)\\cdot |\\begin{aligned}-2 & 1 \\\\ 1 & 2\\end{aligned}|+3\\cdot |\\begin{aligned}-2 & 4 \\\\ 1 & 1\\end{aligned}| \\\\  & =2(8-1)+2(-4-1)+3(-2-4) \\\\  & =14-10-18 \\\\  & =-14.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-14|=14.\n$$"} {:db/id #edb/ref 17592186295128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee18266d-e68c-52ab-82f3-47d654c336f2" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186293858}] :answer-field/correct {:answer/id #uuid "ee18266d-e68c-52ab-82f3-47d654c336f2" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186293858} :answer-field/id #uuid "fd8d3efa-1d88-5610-a5fb-f056f628a424" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294818}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0c8b632f-0961-529e-b3d4-1d020cf7c2fd" :question/math-academy-id "q-280321" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(1,-3,2),$ $B(4,-1,5),$ $C(-2,0,1),$ and $D(3,-2,3).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(4i-j+5k)-(i-3j+2k) \\\\  & =3i+2j+3k \\\\  & =⟨3,2,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-2i+k)-(i-3j+2k) \\\\  & =-3i+3j-k \\\\  & =⟨-3,3,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-2j+3k)-(i-3j+2k) \\\\  & =2i+j+k \\\\  & =⟨2,1,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}3 & 2 & 3 \\\\ -3 & 3 & -1 \\\\ 2 & 1 & 1\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}3 & -1 \\\\ 1 & 1\\end{aligned}|-2\\cdot |\\begin{aligned}-3 & -1 \\\\ 2 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}-3 & 3 \\\\ 2 & 1\\end{aligned}| \\\\  & =3(3\\cdot 1-(-1)\\cdot 1)-2((-3)\\cdot 1-(-1)\\cdot 2)+3((-3)\\cdot 1-3\\cdot 2) \\\\  & =3(3+1)-2(-3+2)+3(-3-6) \\\\  & =12+2-27 \\\\  & =-13.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-13|=13.\n$$"} {:db/id #edb/ref 17592186295173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8801f3a-9dfd-5e9f-8521-78d48c05cc43" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186293652}] :answer-field/correct {:answer/id #uuid "b8801f3a-9dfd-5e9f-8521-78d48c05cc43" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186293652} :answer-field/id #uuid "57b4cf71-7bea-51e2-9884-e3e9016b64cf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294242}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "35b9e288-8b36-5336-a7cf-8f490e426c0c" :question/math-academy-id "q-281023" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(1,0,2),$ $B(3,4,5),$ $C(6,2,4),$ and $D(5,3,6).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(3i+4j+5k)-(i+2k) \\\\  & =2i+4j+3k \\\\  & =⟨2,4,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(6i+2j+4k)-(i+2k) \\\\  & =5i+2j+2k \\\\  & =⟨5,2,2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(5i+3j+6k)-(i+2k) \\\\  & =4i+3j+4k \\\\  & =⟨4,3,4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}2 & 4 & 3 \\\\ 5 & 2 & 2 \\\\ 4 & 3 & 4\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}2 & 2 \\\\ 3 & 4\\end{aligned}|-4\\cdot |\\begin{aligned}5 & 2 \\\\ 4 & 4\\end{aligned}|+3\\cdot |\\begin{aligned}5 & 2 \\\\ 4 & 3\\end{aligned}| \\\\  & =2(2\\cdot 4-2\\cdot 3)-4(5\\cdot 4-2\\cdot 4)+3(5\\cdot 3-2\\cdot 4) \\\\  & =2(8-6)-4(20-8)+3(15-8) \\\\  & =4-48+21 \\\\  & =-23.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-23|=23.\n$$"} {:db/id #edb/ref 17592186295174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae1af4a9-9139-556a-a009-9963fb4181c3" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186293614}] :answer-field/correct {:answer/id #uuid "ae1af4a9-9139-556a-a009-9963fb4181c3" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186293614} :answer-field/id #uuid "bccf3ad9-32f3-5b0c-8104-4809c72ee239" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294597}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "143e14fb-6cbe-5d90-85cc-144627915d33" :question/math-academy-id "q-281025" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(3,0,2),$ $B(5,1,3),$ $C(4,3,5),$ and $D(3,0,5).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(5i+1j+3k)-(3i+2k) \\\\  & =2i+j+k \\\\  & =⟨2,1,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(4i+3j+5k)-(3i+2k) \\\\  & =i+3j+3k \\\\  & =⟨1,3,3⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i+5k)-(3i+2k) \\\\  & =3k \\\\  & =⟨0,0,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}2 & 1 & 1 \\\\ 1 & 3 & 3 \\\\ 0 & 0 & 3\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}3 & 3 \\\\ 0 & 3\\end{aligned}|-1\\cdot |\\begin{aligned}1 & 3 \\\\ 0 & 3\\end{aligned}|+1\\cdot |\\begin{aligned}1 & 3 \\\\ 0 & 0\\end{aligned}| \\\\  & =2(3\\cdot 3-3\\cdot 0)-1(1\\cdot 3-3\\cdot 0)+1(1\\cdot 0-3\\cdot 0) \\\\  & =2(9)-1(3)+1(0) \\\\  & =18-3+0 \\\\  & =15.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|15|=15.\n$$"} {:db/id #edb/ref 17592186295175 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cb7e495-32de-5ba1-b91b-cfaa604be24b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293432}] :answer-field/correct {:answer/id #uuid "7cb7e495-32de-5ba1-b91b-cfaa604be24b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293432} :answer-field/id #uuid "aaec393b-7696-58c0-adfd-28a0339820a5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294544}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7ad6a5b8-f3d8-5275-887d-fa59251ace92" :question/math-academy-id "q-281029" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(0,1,3),$ $B(0,5,5),$ $C(3,4,5),$ and $D(2,0,2).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(5j+5k)-(1j+3k) \\\\  & =4j+2k \\\\  & =⟨0,4,2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+4j+5k)-(1j+3k) \\\\  & =3i+3j+2k \\\\  & =⟨3,3,2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+2k)-(1j+3k) \\\\  & =2i-1j-1k \\\\  & =⟨2,-1,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}0 & 4 & 2 \\\\ 3 & 3 & 2 \\\\ 2 & -1 & -1\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}3 & 2 \\\\ -1 & -1\\end{aligned}|-4\\cdot |\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}|+2\\cdot |\\begin{aligned}3 & 3 \\\\ 2 & -1\\end{aligned}| \\\\  & =-4(3\\cdot -1-2\\cdot 2)+2(3\\cdot -1-3\\cdot 2) \\\\  & =28-18 \\\\  & =10.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|10|=10.\n$$"} {:db/id #edb/ref 17592186295176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6122a148-198a-57cc-b7dd-7fcbcaac6bb5" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186293328}] :answer-field/correct {:answer/id #uuid "6122a148-198a-57cc-b7dd-7fcbcaac6bb5" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186293328} :answer-field/id #uuid "d6bff096-9adc-55e6-b402-42dc714742c4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294687}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c74fea15-7593-5e2d-a899-51b33896c8fd" :question/math-academy-id "q-281030" :question/problem "Calculate the volume $V$ of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD},$ given the points $A(-1,0,1),$ $B(2,-3,4),$ $C(-2,-2,2),$ and $D(0,-1,5).$\n\n$V=${{field-1}}" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i-3j+4k)-(-i+1k) \\\\  & =3i-3j+3k \\\\  & =⟨3,-3,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(-2i-2j+2k)-(-i+1k) \\\\  & =-i-2j+1k \\\\  & =⟨-1,-2,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-j+5k)-(-i+1k) \\\\  & =i-j+4k \\\\  & =⟨1,-1,4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}3 & -3 & 3 \\\\ -1 & -2 & 1 \\\\ 1 & -1 & 4\\end{aligned}| \\\\  & =3\\cdot |\\begin{aligned}-2 & 1 \\\\ -1 & 4\\end{aligned}|-(-3)\\cdot |\\begin{aligned}-1 & 1 \\\\ 1 & 4\\end{aligned}|+3\\cdot |\\begin{aligned}-1 & -2 \\\\ 1 & -1\\end{aligned}| \\\\  & =3(-8+1)+3(-4-1)+3(1-(-2)) \\\\  & =-21-15+9 \\\\  & =-27.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-27|=27.\n$$"} {:db/id #edb/ref 17592186342075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22269750-3610-50c1-9f1a-e32029db2cc1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339419} {:answer/id #uuid "82067827-a66f-5c6a-aae6-789419de79b0" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186340299} {:answer/id #uuid "826586c2-1bf6-5265-9275-8aca9ef0a3ae" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340301} {:answer/id #uuid "df70070c-22ea-53f2-a484-ebf2fd57d953" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186341114} {:answer/id #uuid "fc03c5f9-9d3d-5c25-b729-1dac1a0eaf64" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186341356}] :answer-field/correct {:answer/id #uuid "82067827-a66f-5c6a-aae6-789419de79b0" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186340299} :answer-field/id #uuid "46d6930c-5eff-59bb-a41f-2cb0e35d6542" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341503}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b1acfcbc-5797-5d52-8f43-51fb0ff9335f" :question/math-academy-id "q-73744" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(1,1,0)$, $B(-2,1,0)$, $C(3,2,0)$, and $D(1,2,3).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+j)-(i+j) \\\\  & =-3i \\\\  & =⟨-3,0,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+2j)-(i+j) \\\\  & =2i+1j \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(i+2j+3k)-(i+j) \\\\  & =3j+3k \\\\  & =⟨0,1,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 1 & 3\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & 3\\end{aligned}|-0\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}| \\\\  & =-3(1\\cdot 3-1\\cdot 0)-0+0 \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-9|=9.\n$$"} {:db/id #edb/ref 17592186342076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d26a0c-7c01-5b6a-8dbe-ae3604c79b61" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186339707} {:answer/id #uuid "a94320ec-b8fb-55d4-958d-7f0d1f959771" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186340668} {:answer/id #uuid "e0f68538-632a-565b-b512-ff8470d73e8c" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186341125} {:answer/id #uuid "e65f7298-4237-5dfe-b5fe-c41469fbc270" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186341164} {:answer/id #uuid "f379ed93-ced2-52c2-a4c4-17422c45cfea" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186341274}] :answer-field/correct {:answer/id #uuid "40d26a0c-7c01-5b6a-8dbe-ae3604c79b61" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186339707} :answer-field/id #uuid "96aeb4dc-4ea9-539b-be68-45022f3c1e44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341645}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d447f611-67a9-5187-a844-7f81dc30a0cc" :question/math-academy-id "q-73745" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(1,-1,2)$, $B(-2,2,3)$, $C(1,1,1)$, and $D(-1,3,-2).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+2j+3k)-(i-j+2k) \\\\  & =-3i+3j+k \\\\  & =⟨-3,3,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j+k)-(i-j+2k) \\\\  & =2j-k \\\\  & =⟨0,2,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-i+3j-2k)-(i-j+2k) \\\\  & =-2i+4j-4k \\\\  & =⟨-2,4,-4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 3 & 1 \\\\ 0 & 2 & -1 \\\\ -2 & 4 & -4\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}2 & -1 \\\\ 4 & -4\\end{aligned}|-3\\cdot |\\begin{aligned}0 & -1 \\\\ -2 & -4\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 2 \\\\ -2 & 4\\end{aligned}| \\\\  & =-3(2\\cdot (-4)-4\\cdot (-1))-3(0\\cdot (-4)-(-2)\\cdot (-1))+(0\\cdot 4-(-2)\\cdot 2) \\\\  & =12+6+4 \\\\  & =22.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|22|=22.\n$$"} {:db/id #edb/ref 17592186342077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e68b3bb-a8f2-5479-b9ed-52016f094a6e" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186339842} {:answer/id #uuid "74595172-003f-5459-ac1c-c67762230b74" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186340167} {:answer/id #uuid "7c79963c-8405-5654-a813-6c58246f39a2" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186340249} {:answer/id #uuid "afcfce9c-9dd3-53e7-912f-479a3e8ba88d" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186340733} {:answer/id #uuid "c1713077-7d22-57aa-a570-36388f38332a" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186340849}] :answer-field/correct {:answer/id #uuid "74595172-003f-5459-ac1c-c67762230b74" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186340167} :answer-field/id #uuid "6e1f964d-62df-5320-b2e6-31249877cf9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341571}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "eae017c3-e923-584f-9dc9-ad18f462f150" :question/math-academy-id "q-73746" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(0,1,2)$, $B(-1,0,1)$, $C(1,1,0)$, and $D(3,-1,3).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-i+k)-(j+2k) \\\\  & =-i-j-k \\\\  & =⟨-1,-1,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j)-(j+2k) \\\\  & =i-2k \\\\  & =⟨1,0,-2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-j+3k)-(j+2k) \\\\  & =3i-2j+k \\\\  & =⟨3,-2,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 0 & -2 \\\\ 3 & -2 & 1\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}1 & 0 \\\\ 3 & -2\\end{aligned}| \\\\  & =-(0\\cdot 1-(-2)\\cdot (-2))+(1\\cdot 1-3\\cdot (-2))-(1\\cdot (-2)-3\\cdot 0) \\\\  & =4+7+2 \\\\  & =13.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|13|=13.\n$$"} {:db/id #edb/ref 17592186342078 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041ecafc-32e3-55b2-bd4d-16b2bb0a3485" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186339154} {:answer/id #uuid "12b4a91a-647d-55f9-aa8c-e6d3645734f5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186339293} {:answer/id #uuid "7833b55c-3b8d-5820-a478-1c02f596ba57" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186340200} {:answer/id #uuid "e9ef1d18-3b2d-548c-8803-d8c7d794cda5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341193} {:answer/id #uuid "ed939920-d631-5c81-9821-0b25e67f578f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186341223}] :answer-field/correct {:answer/id #uuid "e9ef1d18-3b2d-548c-8803-d8c7d794cda5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341193} :answer-field/id #uuid "5f32398d-38d4-52b0-b5d4-56a201268afd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341547}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b26b4535-e272-5e94-b038-84726ee96584" :question/math-academy-id "q-73748" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(2,-1,0)$, $B(-1,2,-1)$, $C(1,1,2)$, and $D(3,-1,1).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-i+2j-k)-(2i-j) \\\\  & =-3i+3j-k \\\\  & =⟨-3,3,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j+2k)-(2i-j) \\\\  & =-i+2j+2k \\\\  & =⟨-1,2,2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-j+k)-(2i-j) \\\\  & =i+k \\\\  & =⟨1,0,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 3 & -1 \\\\ -1 & 2 & 2 \\\\ 1 & 0 & 1\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =-3(2\\cdot 1-0\\cdot 2)-3((-1)\\cdot 1-1\\cdot 2)-((-1)\\cdot 0-1\\cdot 2) \\\\  & =-6+9+2 \\\\  & =5.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|\\,5\\,|=5.\n$$"} {:db/id #edb/ref 17592186342081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d62eb44-4e3a-5892-a344-22adca5fb4b2" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186339674} {:answer/id #uuid "44264ce2-e3a9-5eee-be94-e13b2e0593c7" :answer/type {:db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186339727} {:answer/id #uuid "4f8808dc-6f23-5a33-9124-c4c4fa2dbcf4" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186339852} {:answer/id #uuid "c947e433-5802-530f-8f38-59049f701448" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186340912} {:answer/id #uuid "f6f27876-a2cf-5204-a145-b4f7fba572a5" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186341314}] :answer-field/correct {:answer/id #uuid "c947e433-5802-530f-8f38-59049f701448" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186340912} :answer-field/id #uuid "ac0fe630-b555-5ba6-bee4-4141e867e478" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341679}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ed1f88a5-7f29-5728-a62d-81ac2d1ace51" :question/math-academy-id "q-73753" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(-2,1,1)$, $B(2,1,0)$, $C(1,-1,2)$, and $D(3,-2,-2).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i+j)-(-2i+j+k) \\\\  & =4i-k \\\\  & =⟨4,0,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i-j+2k)-(-2i+j+k) \\\\  & =3i-2j+k \\\\  & =⟨3,-2,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-2j-2k)-(-2i+j+k) \\\\  & =5i-3j-3k \\\\  & =⟨5,-3,-3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}4 & 0 & -1 \\\\ 3 & -2 & 1 \\\\ 5 & -3 & -3\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}-2 & 1 \\\\ -3 & -3\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 1 \\\\ 5 & -3\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ 5 & -3\\end{aligned}| \\\\  & =4((-2)\\cdot (-3)-1\\cdot (-3))-0-(3\\cdot (-3)-5\\cdot (-2)) \\\\  & =36-1 \\\\  & =35.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|35|=35.\n$$"} {:db/id #edb/ref 17592186378573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a42f150-af09-50f1-93e5-5a7ef6c3941c" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186378575} {:answer/id #uuid "0e61ab76-8c5d-5910-8b87-4c64f34d8f37" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186378576} {:answer/id #uuid "132eab41-9a12-5b05-a76e-570681089bd0" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186378577} {:answer/id #uuid "eeaa0c77-6439-57a3-810c-a0949283ed9f" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186378578} {:answer/id #uuid "9c500f0c-3011-5638-86d3-c14893131d9c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186378579}] :answer-field/correct {:answer/id #uuid "9c500f0c-3011-5638-86d3-c14893131d9c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186378579} :answer-field/id #uuid "88508ed0-7bb9-51fe-90d6-2bd0fcd3f98d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378574}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "57ae3b89-c4ab-5dbf-a8d7-b1b9339d2673" :question/math-academy-id "q-128482" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(3,0,1),$ $B(0,-1,3),$ $C(1,-2,2),$ and $D(2,2,1).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-j+3k)-(3i+k) \\\\  & =-3i-j+2k \\\\  & =⟨-3,-1,2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i-2j+2k)-(3i+k) \\\\  & =-2i-2j+k \\\\  & =⟨-2,-2,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+2j+k)-(3i+k) \\\\  & =-i+2j \\\\  & =⟨-1,2,0⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & -1 & 2 \\\\ -2 & -2 & 1 \\\\ -1 & 2 & 0\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}|-(-1)\\cdot |\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}|+2\\cdot |\\begin{aligned}-2 & -2 \\\\ -1 & 2\\end{aligned}| \\\\  & =-3((-2)\\cdot 0-2\\cdot 1)+((-2)\\cdot 0-(-1)\\cdot 1)+2((-2)\\cdot 2-(-1)\\cdot (-2)) \\\\  & =6+1-12 \\\\  & =-5.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-5|=5.\n$$"}] :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Position Vectors Given Their Coordinates"}] [{:db/id #edb/ref 17592186105916 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105488 :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $|\\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =13\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =13\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{13}{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048410 :topic/math-academy-id 629 :topic/title "Calculating Side Lengths of Right Triangles Using Trigonometry"} {:db/id #edb/ref 17592186048882 :topic/math-academy-id 1101 :topic/title "The Magnitude of a Vector"}] :knowledge-point/questions [{:db/id #edb/ref 17592186106110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab7f1702-1411-5fe5-a8ea-1636ef34a764" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186102537} {:answer/id #uuid "c1388b85-6047-59c9-a0bd-3754ff85c316" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186102538} {:answer/id #uuid "c66e78e6-af65-5cfd-90e1-b0cdc12cceeb" :answer/type {:db/ident :answer.type/math} :answer/value "7\\sqrt{3}" :db/id #edb/ref 17592186102539} {:answer/id #uuid "2680133c-34ee-54a8-8c54-68017a6c0a70" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186102540} {:answer/id #uuid "41a13b60-bbd5-5c30-aa07-28737f3e5ba3" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186102541}] :answer-field/id #uuid "62aa4579-02fb-5f2e-b93a-28a0e8d8c192" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102536}] :question/id #uuid "13abcc9b-d205-521b-b9f3-45f8e21bde00" :question/math-academy-id "q-19136" :question/problem "Suppose $\\mid c|= 14$ and the angle between vectors $c$ and $d$ is $θ = 60^{∘}$. Find the scalar projection of $c$ onto $d$."} {:db/id #edb/ref 17592186106478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41075c73-ac32-50df-b67a-219517ab45b3" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186336641} {:answer/id #uuid "73b29c73-3eff-5a83-ab61-9d41933b2487" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186337074} {:answer/id #uuid "8850099e-98d9-52f0-8325-be56acb31a03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9\\sqrt{2}}{2}" :db/id #edb/ref 17592186337261} {:answer/id #uuid "e3364816-8691-5913-b547-c8e857be5fd7" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186338013} {:answer/id #uuid "f99cc284-6430-56f2-8e82-685f9498c0ce" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186338220}] :answer-field/correct {:answer/id #uuid "41075c73-ac32-50df-b67a-219517ab45b3" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186336641} :answer-field/id #uuid "3f5fea84-d7a3-5122-bf16-1ff190f164ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186