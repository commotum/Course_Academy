-fields [{:answer-field/choices [{:answer/id #uuid "641c6f0c-3eaf-561b-8356-41cd00f60ef4" :answer/type {:db/ident :answer.type/image} :answer/value "images/d5/d5f4f2b65878b9c152b5c87e1fac0473f0e76455fc5762ba10f21555d68a60c4.png" :db/id #edb/ref 17592186386912} {:answer/id #uuid "dc9f2778-f343-5bd4-8b1f-ffa35692fd8d" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3e475d534a8f090caa9611d865e70a9717969ddc541c55d98200e19031bffe84.png" :db/id #edb/ref 17592186386913} {:answer/id #uuid "21fe63ba-ca2a-5062-b8c9-c489ae9d0da5" :answer/type {:db/ident :answer.type/image} :answer/value "images/a6/a65cbd746c3bb9abe495af168fd7c63e83ecf3d942c5fb478f3d7d312d140b4d.png" :db/id #edb/ref 17592186386914} {:answer/id #uuid "993af450-e9a5-57fb-a473-cf3bc2a14c65" :answer/type {:db/ident :answer.type/image} :answer/value "images/95/95b3d8fc43562341f93a2bccbcbe36d2a070a2dd6687606175ab5e9580f86e2f.png" :db/id #edb/ref 17592186386915} {:answer/id #uuid "6f16a9da-248f-5eb6-9d9c-67a9d932876b" :answer/type {:db/ident :answer.type/image} :answer/value "images/0d/0d14e369d621a6c2d06b4db1485ff43f6af4be2014e9d26564c9ca11e9bd38cd.png" :db/id #edb/ref 17592186386916}] :answer-field/correct {:answer/id #uuid "dc9f2778-f343-5bd4-8b1f-ffa35692fd8d" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3e475d534a8f090caa9611d865e70a9717969ddc541c55d98200e19031bffe84.png" :db/id #edb/ref 17592186386913} :answer-field/id #uuid "33aa3810-dbfd-5996-9796-56ae579de721" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386911}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a05048db-be50-5d0c-8e66-1eb6eda34260" :question/math-academy-id "q-119142" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{3(x-1)^{2}}{4}?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-\\frac{3(x-1)^{2}}{4})\\,\\text{d}x \\\\ y & =-\\frac{3}{4}\\int (x-1)^{2}\\,\\text{d}x \\\\  & =-\\frac{3}{4}(\\frac{(x-1)^{3}}{3}) \\\\  & =-\\frac{(x-1)^{3}}{4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/e0/e0ff2e64925dcd8bdf298c47815f6e2982fe6091e1ff5dea042f585c67ef1721.png)"} {:db/id #edb/ref 17592186393933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d0d86d-c06f-5faf-a0ed-e8ee4d8b2010" :answer/type {:db/ident :answer.type/image} :answer/value "images/8a/8ac5a8137dd22e9f7333315bc2f5e1120cdb46dc6fb84f938890c491563a86c7.png" :db/id #edb/ref 17592186393935} {:answer/id #uuid "7cb52152-df73-5351-900a-b8e3c2fe2eee" :answer/type {:db/ident :answer.type/image} :answer/value "images/f5/f59924b67013ab56263c9e58d283bd29b1869699488702fffc8f88d1de18e647.png" :db/id #edb/ref 17592186393936} {:answer/id #uuid "d01da734-6649-516c-965d-904f6eb30e75" :answer/type {:db/ident :answer.type/image} :answer/value "images/41/4110727f4203228259f1ee4d95593e54c92731e986eb3bdcf9cc0692cf902aa4.png" :db/id #edb/ref 17592186393937} {:answer/id #uuid "a9ccb688-6ce7-56f2-8a91-5c430e62080a" :answer/type {:db/ident :answer.type/image} :answer/value "images/be/bec2fa9f6c2673fe9bc71fbdadb8f2cbf4c37ef05a38dd2486be3fac7e2b98d2.png" :db/id #edb/ref 17592186393938} {:answer/id #uuid "b8c43a80-cb88-5719-a3f8-6293badb40f6" :answer/type {:db/ident :answer.type/image} :answer/value "images/75/757072d5f7b2edaf1eb22e3e1a1c4135a387293396c9a4213ee3a2e213102ee6.png" :db/id #edb/ref 17592186393939}] :answer-field/correct {:answer/id #uuid "b8c43a80-cb88-5719-a3f8-6293badb40f6" :answer/type {:db/ident :answer.type/image} :answer/value "images/75/757072d5f7b2edaf1eb22e3e1a1c4135a387293396c9a4213ee3a2e213102ee6.png" :db/id #edb/ref 17592186393939} :answer-field/id #uuid "fe6588a4-c656-5e02-9be8