{5}(-1-1) \\\\  & =-\\frac{2}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e98c30-1d43-5f8a-b696-0c34179f4a2f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317642}] :answer-field/correct {:answer/id #uuid "18e98c30-1d43-5f8a-b696-0c34179f4a2f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317642} :answer-field/id #uuid "c2fe00d1-0029-52ff-8d78-f242bb9ada4e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318844}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d61aaced-d2d7-58f8-932d-53be360378fb" :question/math-academy-id "q-346870" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}={e}^{x} & ⇒ & v={e}^{x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot {e}^{x}\\,\\text{d}x & =2x\\cdot {e}^{x}-\\int {e}^{x}\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x & =2x{e}^{x}\\,{|}_{0}^{1}-2{\\int }_{0}^{1}{e}^{x}\\,\\text{d}x \\\\  & =2x{e}^{x}\\,{|}_{0}^{1}-2{e}^{x}\\,{|}_{0}^{1} \\\\  & =2(1\\cdot {e}^{1}-0\\cdot {e}^{0})-2({e}^{1}-{e}^{0}) \\\\  & =2e-2(e-1) \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c377238f-b153-585f-8aa9-69ae456b7747" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9{e}^{4}+3}{4}" :db/id #edb/ref 17592186318212}] :answer-field/correct {:answer/id #uuid "c377238f-b153-585f-8aa9-69ae456b7747" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9{e}^{4}+3}{4}" :db/id #edb/ref 17592186318212} :answer-field/id #uuid "f381b13c-2394-583e-8bf6-dd424644547a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318929}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cb6faac0-b896-57ad-9d54-07d07059068d" :question/math-academy-id "q-349217" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}3x{e}^{2x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=3x & ⇒ & {u}^{′}=3 \\\\ {v}^{′}={e}^{2x} & ⇒ & v=\\frac{1}{2}{e}^{2x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 3x\\cdot {e}^{2x}\\,\\text{d}x & =3x\\cdot \\frac{1}{2}{e}^{2x}-\\int \\frac{1}{2}{e}^{2x}\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}3x{e}^{2x}\\,\\text{d}x & =\\frac{3}{2}x{e}^{2x}\\,{|}_{0}^{2}-\\frac{3}{2}{\\int }_{0}^{2}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{3}{2}x{e}^{2x}\\,{|}_{0}^{2}-\\frac{3}{4}{e}^{2x}\\,{|}_{0}^{2} \\\\  & =\\frac{3}{2}(2\\cdot {e}^{4}-0\\cdot {e}^{0})-\\frac{3}{4}({e}^{4}-{e}^{0}) \\\\  & =3{e}^{4}-\\frac{3}{4}({e}^{4}-1) \\\\  & =\\frac{9{e}^{4}+3}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4abe39b1-1acd-5859-bbde-adde947b15bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }" :db/id #edb/ref 17592186317810}] :answer-field/correct {:answer/id #uuid "4abe39b1-1acd-5859-bbde-adde947b15bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }" :db/id #edb/ref 17592186317810} :answer-field/id #uuid "ceb951fd-f6ee-51b4-b39a-e0e4ddc059fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318864}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "67ba33c4-ecff-5b0f-91ab-b446a5b2d9d2" :question/math-academy-id "q-349231" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\pi x) & ⇒ & v=-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))-\\int (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{\\pi }{\\int }_{0}^{1}\\operatorname{cos}⁡(\\pi x)\\,\\text{d}x \\\\  & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{{\\pi }^{2}}\\operatorname{sin}⁡(\\pi x)\\,{|}_{0}^{1} \\\\  & =-\\frac{4}{\\pi }(1\\cdot \\operatorname{cos}⁡(\\pi \\cdot 1)-0\\cdot \\operatorname{cos}⁡(\\pi \\cdot 0))+\\frac{4}{{\\pi }^{2}}(\\operatorname{sin}⁡(\\pi \\cdot 1)-\\operatorname{sin}⁡(\\pi \\cdot 0)) \\\\  & =-\\frac{4}{\\pi }(-1-0)+\\frac{4}{{\\pi }^{2}}(0-0) \\\\  & =\\frac{4}{\\pi }.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31043ecf-974a-5de9-96ed-984ebdd8c7d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8\\pi }{3}" :db/id #edb/ref 17592186317718}] :answer-field/correct {:answer/id #uuid "31043ecf-974a-5de9-96ed-984ebdd8c7d6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8\\pi }{3}" :db/id #edb/ref 17592186317718} :answer-field/id #uuid "c9d52bf5-cb5b-5fca-b529-dba6cdf38afd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318855}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30f0e38b-4d35-5e3a-af39-84633279075a" :question/math-academy-id "q-349253" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2\\pi }4x\\operatorname{sin}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(3x) & ⇒ & v=-\\frac{1}{3}\\operatorname{cos}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(3x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{3}\\operatorname{cos}⁡(3x))-\\int (-\\frac{1}{3}\\operatorname{cos}⁡(3x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }4x\\operatorname{sin}⁡(3x)\\,\\text{d}x & =-\\frac{4}{3}x\\operatorname{cos}⁡(3x)\\,{|}_{0}^{2\\pi }+\\frac{4}{3}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =-\\frac{4}{3}x\\operatorname{cos}⁡(3x)\\,{|}_{0}^{2\\pi }+\\frac{4}{9}\\operatorname{sin}⁡(3x)\\,{|}_{0}^{2\\pi } \\\\  & =-\\frac{4}{3}(2\\pi \\cdot \\operatorname{cos}⁡(6\\pi )-0\\cdot \\operatorname{cos}⁡(0))+\\frac{4}{9}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =-\\frac{4}{3}(2\\pi \\cdot 1-0\\cdot 1)+\\frac{4}{9}(0-0) \\\\  & =-\\frac{8\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f87a2ec9-3787-50b9-9e55-d6cd2446c049" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186318389}] :answer-field/correct {:answer/id #uuid "f87a2ec9-3787-50b9-9e55-d6cd2446c049" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186318389} :answer-field/id #uuid "3da5149a-42e0-57ab-b867-65aa7f203c05" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318551}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "615dee59-7992-5c1c-8fe1-9c3970b38307" :question/math-academy-id "q-349297" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}9x\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=9x & ⇒ & {u}^{′}=9 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{1}{3}\\operatorname{sin}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 9x\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =9x\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)-\\int \\frac{1}{3}\\operatorname{sin}⁡(3x)\\cdot 9\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}9x\\operatorname{cos}⁡(3x)\\,\\text{d}x & =3x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}-3{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =3x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}+\\operatorname{cos}⁡(3x)\\,{|}_{0}^{\\pi /3} \\\\  & =3(\\frac{\\pi }{3}\\cdot \\operatorname{sin}⁡(\\pi )-0\\cdot \\operatorname{sin}⁡(0))+(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =3(\\frac{\\pi }{3}\\cdot 0-0\\cdot 0)+(-1-1) \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f52ada2e-b967-5581-b835-fdd4ef42d1b2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186318377}] :answer-field/correct {:answer/id #uuid "f52ada2e-b967-5581-b835-fdd4ef42d1b2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186318377} :answer-field/id #uuid "43a2be7d-5b56-578e-b8ea-825b72904689" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318568}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dfc2da83-70ec-5b4d-8276-3941e4e2e19f" :question/math-academy-id "q-349305" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}(-18x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=-18x & ⇒ & {u}^{′}=-18 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{1}{3}\\operatorname{sin}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (-18x)\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =(-18x)\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)-\\int \\frac{1}{3}\\operatorname{sin}⁡(3x)\\cdot (-18)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}(-18x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & =-6x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}+6{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =-6x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}-2\\operatorname{cos}⁡(3x)\\,{|}_{0}^{\\pi /3} \\\\  & =-6(\\frac{\\pi }{3}\\cdot \\operatorname{sin}⁡(\\pi )-0\\cdot \\operatorname{sin}⁡(0))-2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-6(\\frac{\\pi }{3}\\cdot 0-0\\cdot 0)-2(-1-1) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9137fb31-7c6a-5b4c-a54b-cf399bcfa5a8" :answer/type {:db/ident :answer.type/math} :answer/value "1-4{e}^{-3}" :db/id #edb/ref 17592186318059}] :answer-field/correct {:answer/id #uuid "9137fb31-7c6a-5b4c-a54b-cf399bcfa5a8" :answer/type {:db/ident :answer.type/math} :answer/value "1-4{e}^{-3}" :db/id #edb/ref 17592186318059} :answer-field/id #uuid "c49e403e-dc95-5927-91fe-0a0152fb1039" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318848}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "fce587bb-2230-5419-afb1-775f458fc405" :question/math-academy-id "q-349348" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}9x{e}^{-3x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=9x & ⇒ & {u}^{′}=9 \\\\ {v}^{′}={e}^{-3x} & ⇒ & v=-\\frac{1}{3}{e}^{-3x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 9x\\cdot {e}^{-3x}\\,\\text{d}x & =9x\\cdot (-\\frac{1}{3}{e}^{-3x})-\\int (-\\frac{1}{3}{e}^{-3x})\\cdot 9\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}9x{e}^{-3x}\\,\\text{d}x & =-3x{e}^{-3x}\\,{|}_{0}^{1}-3{\\int }_{0}^{1}{e}^{-3x}\\,\\text{d}x \\\\  & =-3x{e}^{-3x}\\,{|}_{0}^{1}-{e}^{-3x}\\,{|}_{0}^{1} \\\\  & =-3(1\\cdot {e}^{-3}-0\\cdot {e}^{0})-({e}^{-3}-{e}^{0}) \\\\  & =-3{e}^{-3}-({e}^{-3}-1) \\\\  & =1-4{e}^{-3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25e03bb2-38fd-590c-a711-0f08ab8bba0b" :answer/type {:db/ident :answer.type/math} :answer/value "-1+{e}^{2}" :db/id #edb/ref 17592186330278} {:answer/id #uuid "9cfe119c-4c83-5685-9e72-3d7e3a36aafe" :answer/type {:db/ident :answer.type/math} :answer/value "1-3{e}^{2}" :db/id #edb/ref 17592186331355} {:answer/id #uuid "b81ff5e8-6e1a-5415-a73c-95423efd63bb" :answer/type {:db/ident :answer.type/math} :answer/value "-2-{e}^{2}" :db/id #edb/ref 17592186331574} {:answer/id #uuid "d88e6b38-60e3-55a1-b267-396d75df9e52" :answer/type {:db/ident :answer.type/math} :answer/value "-1-{e}^{2}" :db/id #edb/ref 17592186331872} {:answer/id #uuid "e8104679-8097-5d99-8871-6a598728a76b" :answer/type {:db/ident :answer.type/math} :answer/value "1+{e}^{2}" :db/id #edb/ref 17592186331985}] :answer-field/correct {:answer/id #uuid "d88e6b38-60e3-55a1-b267-396d75df9e52" :answer/type {:db/ident :answer.type/math} :answer/value "-1-{e}^{2}" :db/id #edb/ref 17592186331872} :answer-field/id #uuid "a2900df1-3dd3-5e4a-bcd5-28bec34e44ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "105b4be6-43d2-5e3c-baa6-177cc086c196" :question/math-academy-id "q-49660" :question/problem "Evaluate ${\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{-x} & ⇒ & v=-{e}^{-x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{-x}\\,\\text{d}x & =x\\cdot (-{e}^{-x})-\\int (-{e}^{-x})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}x{e}^{-x}\\,\\text{d}x & =-x{e}^{-x}{|}_{-2}^{0}+{\\int }_{-2}^{0}{e}^{-x}\\,\\text{d}x \\\\  & =-x{e}^{-x}{|}_{-2}^{0}-{e}^{-x}{|}_{-2}^{0} \\\\  & =[-0{e}^{-0}-2{e}^{2}]-[{e}^{0}-{e}^{2}] \\\\  & =-2{e}^{2}-1+{e}^{2} \\\\  & =-1-{e}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d04d3d4-1dd0-57fb-b1e2-c225a604887a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186330065} {:answer/id #uuid "10711776-d5af-58ee-a204-f0481a37ef0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186330095} {:answer/id #uuid "94d2489f-97d4-5923-a4e5-c84c3ac1206a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186331268} {:answer/id #uuid "bef58735-ea92-5021-ba86-331e3acbbeb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186331643} {:answer/id #uuid "e88ab2f9-1ace-5545-9427-562efa040d45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186331991}] :answer-field/correct {:answer/id #uuid "bef58735-ea92-5021-ba86-331e3acbbeb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186331643} :answer-field/id #uuid "05dc3940-684e-5059-b3ec-b817a2dd3311" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332204}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7b8bc1c4-8b9c-5e47-93e0-c4965c12347b" :question/math-academy-id "q-49669" :question/problem "${\\int }_{0}^{\\pi /6}2x\\operatorname{sin}⁡(3x)\\,\\text{d}x=$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{sin}⁡(3x) & ⟹\\,v=-\\frac{1}{3}\\operatorname{cos}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into  the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{sin}⁡(3x)\\,\\text{d}x & =-2x\\cdot \\frac{1}{3}\\operatorname{cos}⁡(3x)-\\int (-\\frac{1}{3}\\operatorname{cos}⁡(3x))\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}2x\\operatorname{sin}⁡(3x)\\,\\text{d}x & ={-\\frac{2x\\operatorname{cos}⁡(3x)}{3}|}_{0}^{\\pi /6}+\\frac{2}{3}{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & ={-\\frac{2x\\operatorname{cos}⁡(3x)}{3}|}_{0}^{\\pi /6}+{\\frac{2}{9}\\operatorname{sin}⁡(3x)|}_{0}^{\\pi /6} \\\\  & =-\\frac{2}{3}[\\frac{\\pi }{6}\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{6})-0\\cdot \\operatorname{cos}⁡(3\\cdot 0)] \\\\  & +\\frac{2}{9}[\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{6})-\\operatorname{sin}⁡(3\\cdot 0)] \\\\  & =-\\frac{2}{3}[0-0]+\\frac{2}{9}[\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0)] \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ac416bd-1ef2-598d-9769-0fc6af1898a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186330183} {:answer/id #uuid "92f021d2-f657-568a-9458-97dc25ae2244" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186331255} {:answer/id #uuid "b1f49c5b-b91f-5372-945d-fd51d107045f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331524} {:answer/id #uuid "bc706a10-6660-59a2-b283-dfcba28564b5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331611} {:answer/id #uuid "f6ff4fa6-edc2-533d-88c9-09406c898508" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186332119}] :answer-field/correct {:answer/id #uuid "b1f49c5b-b91f-5372-945d-fd51d107045f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186331524} :answer-field/id #uuid "e116d325-1e59-5f3b-b1ef-e63b4cf776b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332598}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b7d1b926-6342-572b-ba02-f2edcfbab3a9" :question/math-academy-id "q-49674" :question/problem "${\\int }_{-\\pi /4}^{\\pi /4}x\\operatorname{cos}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(2x) & ⇒ & v=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(2x)\\,\\text{d}x & =x\\cdot \\frac{\\operatorname{sin}⁡(2x)}{2}-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /4}^{\\pi /4}x\\operatorname{cos}⁡(2x)\\,\\text{d}x & ={\\frac{x\\operatorname{sin}⁡(2x)}{2}|}_{-\\pi /4}^{\\pi /4}-{\\int }_{-\\pi /4}^{\\pi /4}\\frac{\\operatorname{sin}⁡(2x)}{2}\\,\\text{d}x \\\\  & ={\\frac{1}{2}x\\operatorname{sin}⁡(2x)|}_{-\\pi /4}^{\\pi /4}+\\frac{1}{4}\\operatorname{cos}⁡(2x){|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}[\\frac{\\pi }{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{4}\\operatorname{sin}⁡(-\\frac{\\pi }{2})]+\\frac{1}{4}[\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(-\\frac{\\pi }{2})] \\\\  & =\\frac{1}{2}[\\frac{\\pi }{4}-\\frac{\\pi }{4}]+\\frac{1}{4}[0-0] \\\\  & =\\frac{1}{2}[0]+0 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26e6d4ed-2a95-5b96-a81c-b22982fa0499" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{12}+1" :db/id #edb/ref 17592186330291} {:answer/id #uuid "4e20740e-c6da-5ad1-a62b-85285c7d638d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\pi }{12}+\\frac{1}{2}" :db/id #edb/ref 17592186330660} {:answer/id #uuid "9f6c93f5-fe12-5a2e-9367-75108b2be7a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}\\pi }{6}-\\frac{1}{2}" :db/id #edb/ref 17592186331383} {:answer/id #uuid "e330c811-9644-5c56-b0f4-0f24b313cf8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{12}+\\frac{1}{2}" :db/id #edb/ref 17592186331956} {:answer/id #uuid "fb9e871c-2c0e-518b-a4af-68c0103a8640" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{6}-\\frac{1}{2}" :db/id #edb/ref 17592186332160}] :answer-field/correct {:answer/id #uuid "e330c811-9644-5c56-b0f4-0f24b313cf8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{12}+\\frac{1}{2}" :db/id #edb/ref 17592186331956} :answer-field/id #uuid "872a6308-1549-5a6a-ab50-2e8d6d61c150" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332438}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4518fd0-a820-5329-a38a-c80d052e166a" :question/math-academy-id "q-49676" :question/problem "Evaluate  ${\\int }_{\\pi /6}^{\\pi /2}x\\operatorname{sin}⁡x\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡x & ⟹\\,v=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡x\\,\\text{d}x & =-x\\cdot \\operatorname{cos}⁡x-\\int (-\\operatorname{cos}⁡x)\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =-x\\operatorname{cos}⁡x{|}_{\\pi /6}^{\\pi /2}+{\\int }_{\\pi /6}^{\\pi /2}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡x{|}_{\\pi /6}^{\\pi /2}+\\operatorname{sin}⁡x{|}_{\\pi /6}^{\\pi /2} \\\\  & =-[\\frac{\\pi }{2}\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\frac{\\pi }{6}\\operatorname{cos}⁡(\\frac{\\pi }{6})] \\\\  & +[\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(\\frac{\\pi }{6})] \\\\  & =[\\frac{\\pi }{2}\\cdot 0-\\frac{\\pi }{6}\\cdot \\frac{\\sqrt{3}}{2}]+[1-\\frac{1}{2}] \\\\  & =\\frac{\\sqrt{3}\\pi }{12}+\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332762 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ecbfbfa-cec6-5df3-a0c9-e11c1f67b71c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e+1}{4}" :db/id #edb/ref 17592186330075} {:answer/id #uuid "4f85b6ee-800b-57ab-a844-ec6e2709c11a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{2}+1" :db/id #edb/ref 17592186330672} {:answer/id #uuid "80f169d6-295c-563d-8914-8d2bd9999054" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{4}" :db/id #edb/ref 17592186331093} {:answer/id #uuid "ba59d7eb-18ba-53f2-95b6-75daba77e7da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186331594} {:answer/id #uuid "dc1d4456-3d28-5aa2-8934-92baec9cfff7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186331900}] :answer-field/correct {:answer/id #uuid "ba59d7eb-18ba-53f2-95b6-75daba77e7da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186331594} :answer-field/id #uuid "6a4db82c-4c9f-5857-a947-4a090d21993d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332395}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "622f5ee2-fdb3-59b2-9462-4de78b4bcda0" :question/math-academy-id "q-49677" :question/problem "Evaluate the integral  ${\\int }_{0}^{1/2}x{e}^{2x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{2x} & ⇒ & v=\\frac{{e}^{2x}}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{2x}\\,\\text{d}x & =x\\cdot \\frac{{e}^{2x}}{2}-\\int \\frac{{e}^{2x}}{2}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}x{e}^{2x}\\,\\text{d}x & =\\frac{1}{2}(x{e}^{2x}){|}_{0}^{1/2}-\\frac{1}{2}{\\int }_{0}^{1/2}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}(x{e}^{2x}){|}_{0}^{1/2}-\\frac{{e}^{2x}}{4}{|}_{0}^{1/2} \\\\  & =\\frac{1}{2}[\\frac{1}{2}{e}^{2(1/2)}-0\\cdot {e}^{2\\cdot 0}]-\\frac{1}{4}[{e}^{2(1/2)}-{e}^{2\\cdot 0}] \\\\  & =\\frac{1}{2}[\\frac{e}{2}-0]-\\frac{1}{4}[e-1] \\\\  & =\\frac{e}{4}-\\frac{e-1}{4} \\\\  & =\\frac{e-e+1}{4} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332763 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2314e2c3-071d-5d1e-bdca-e7896981bcd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186330252} {:answer/id #uuid "79f50141-9381-5317-8323-d88e90e3a8a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186331031} {:answer/id #uuid "8b21378b-3425-5e03-a842-b62254df4ffd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186331184} {:answer/id #uuid "b85d4fc1-2e09-58f6-acfa-bed34a4d5787" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186331579} {:answer/id #uuid "c25d6949-0735-57ba-84b8-0d9c36850ad6" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186