answer.type/math} :answer/value "\\frac{3e}{16}" :db/id #edb/ref 17592186362869} {:answer/id #uuid "c21264c7-8089-52ce-9a48-6dad38c7f2ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186362870} {:answer/id #uuid "ef9db4ec-3467-518d-a30c-e4d04ca7e957" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{2}" :db/id #edb/ref 17592186362871} {:answer/id #uuid "b4b710cd-dff5-5c54-9db5-d82e41461d08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186362872} {:answer/id #uuid "c0fe8a21-d6a2-507f-9611-cdd51fb00208" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186362873}] :answer-field/correct {:answer/id #uuid "c0fe8a21-d6a2-507f-9611-cdd51fb00208" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186362873} :answer-field/id #uuid "08dd7829-9567-51b3-9a69-757f02b76b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362868}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "65eb7d35-cf19-5d83-87df-2f6cd4fcb07e" :question/math-academy-id "q-114317" :question/problem "Evaluate the integral ${\\int }_{0}^{1/4}x{e}^{4x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{4x} & ⇒ & v=\\frac{{e}^{4x}}{4}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{4x}\\,\\text{d}x & =x\\cdot \\frac{{e}^{4x}}{4}-\\int (\\frac{{e}^{4x}}{4})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/4}x{e}^{4x}\\,\\text{d}x & ={\\frac{1}{4}x{e}^{4x}|}_{0}^{1/4}-\\frac{1}{4}{\\int }_{0}^{1/4}{e}^{4x}\\text{d}x \\\\  & ={\\frac{1}{4}x{e}^{4x}|}_{0}^{1/4}-{\\frac{1}{16}{e}^{4x}|}_{0}^{1/4} \\\\  & =\\frac{1}{4}[\\frac{1}{4}{e}^{4(1/4)}-0\\cdot {e}^{4\\cdot 0}]-\\frac{1}{16}[{e}^{4(1/4)}-{e}^{4\\cdot 0}] \\\\  & =\\frac{1}{4}[\\frac{e}{4}-0]-\\frac{1}{16}[e-1] \\\\  & =\\frac{e}{16}-\\frac{e}{16}+\\frac{1}{16} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186364275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31cdfcf9-98d2-5183-877d-c6911c5786e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{5}" :db/id #edb/ref 17592186364277} {:answer/id #uuid "0c65c166-229d-5e3b-933e-08d975e562bc" :answer/type {:db/ident :answer.type/math} :answer/value "12\\pi " :db/id #edb/ref 17592186364278} {:answer/id #uuid "aa2cde5a-f869-5481-8dc3-00dd3ad08d94" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi " :db/id #edb/ref 17592186364279} {:answer/id #uuid "a7d225f4-6349-507e-b1a7-f6934a27b132" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\pi }{12}" :db/id #edb/ref 17592186364280} {:answer/id #uuid "23f19c4b-e2a1-55d9-989d-819c4ed4c37f" :answer/type {:db/ident :answer.type/math} :answer/value "36\\pi " :db/id #edb/ref 17592186364281}] :answer-field/correct {:answer/id #uuid "aa2cde5a-f869-5481-8dc3-00dd3ad08d94" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi " :db/id #edb/ref 17592186364279} :answer-field/id #uuid "ce18f523-92fa-512f-8b3f-d199baff422a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364276}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d40fd3d-7b15-59ca-8ee5-88d3927298a9" :question/math-academy-id "q-49678" :question/problem "Evaluate ${\\int }_{-\\pi }^{\\pi }12x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=12x & ⇒ & {u}^{′}=12 \\\\ {v}^{′}=\\operatorname{sin}⁡(x) & ⇒ & v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 12x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =12x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 12\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{-\\pi }^{\\pi }12x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-12x\\operatorname{cos}⁡(x){|}_{-\\pi }^{\\pi }+12{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-12x\\operatorname{cos}⁡(x){|}_{-\\pi }^{\\pi }+12\\operatorname{sin}⁡(x){|}_{-\\pi }^{\\pi } \\\\  & =-12[\\pi \\operatorname{cos}⁡(\\pi )+\\pi \\operatorname{cos}⁡(-\\pi )] \\\\  & +12[\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )] \\\\  & =-12[-\\pi -\\pi ]+12[0-0] \\\\  & =-12[-2\\pi ] \\\\  & =24\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81ae3e78-b1f4-5477-8bac-c412eb3c2747" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi-4" :db/id #edb/ref 17592186431280}] :answer-field/correct {:answer/id #uuid "81ae3e78-b1f4-5477-8bac-c412eb3c2747" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi-4" :db/id #edb/ref 17592186431280} :answer-field/id #uuid "0902a00b-6972-5278-913c-8072ffb99155" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186431281}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5473d4ab-39f5-5e1e-ade8-0e74627b89e6" :question/math-academy-id "q-349299" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}4x\\operatorname{cos}⁡(x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{cos}⁡(x) & ⇒ & v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =4x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}4x\\operatorname{cos}⁡(x)\\,\\text{d}x & =4x\\operatorname{sin}⁡(x)\\,{|}_{0}^{\\pi /2}-4{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =4x\\operatorname{sin}⁡(x)\\,{|}_{0}^{\\pi /2}+4\\operatorname{cos}⁡(x)\\,{|}_{0}^{\\pi /2} \\\\  & =4(\\frac{\\pi }{2}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-0\\cdot \\operatorname{sin}⁡(0))+4(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =4(\\frac{\\pi }{2}\\cdot 1-0\\cdot 0)+4(0-1) \\\\  & =2\\pi -4.\\end{aligned}\n$$"}] :knowledge-point/title "Computing a Definite Integral Using Integration by Parts"}]}
