27b4a37-63ac-546c-b079-a486976f0966" :question/math-academy-id "q-317332" :question/problem "Find $a\\cdot (c\\times b)$, if $-3a\\cdot ((-2b)\\times (7c))=168.$\n\n$a\\cdot (c\\times b)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-3a\\cdot ((-2b)\\times (7c)) & =168 \\\\ (-3)\\cdot (-2)\\cdot 7\\cdot [a\\cdot (b\\times c)] & =168 \\\\ 42[a\\cdot (b\\times c)] & =168 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $b$ and $c$ to get\n\n$$\na\\cdot (c\\times b)\\,=\\,-4.\n$$"} {:db/id #edb/ref 17592186410422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29595116-806d-5a50-ab1b-9695013bab97" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186410234} {:answer/id #uuid "6cddf496-550e-503d-97cf-86f4c416cb41" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186410274} {:answer/id #uuid "87da3e47-9864-54d6-b40d-2913c6ae3373" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186410286} {:answer/id #uuid "ba4d127a-493d-5de0-a877-1ac772d55fad" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186410329} {:answer/id #uuid "f7d42b31-2f13-5fd5-a529-f48c87f1b72a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186410369}] :answer-field/correct {:answer/id #uuid "6cddf496-550e-503d-97cf-86f4c416cb41" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186410274} :answer-field/id #uuid "81bc68bf-9d8f-562a-bde6-27ff85778ca1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410391}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "35202296-3c02-529f-93c9-ab75d2fe58b2" :question/math-academy-id "q-128355" :question/problem "Find $c\\cdot (a\\times b),$ if $b\\times c=⟨4,3,-5⟩$ and $a=⟨-2,8,2⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,8,2⟩\\cdot ⟨4,3,-5⟩ \\\\  & =(-2)\\cdot 4+8\\cdot 3+2\\cdot (-5) \\\\  & =-8+24-10 \\\\  & =6.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-6\\end{aligned}\n$$\n\nand again we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b)=6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186419786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069decae-ea7d-53a6-9d7f-6cd1604d5e45" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186419779}] :answer-field/correct {:answer/id #uuid "069decae-ea7d-53a6-9d7f-6cd1604d5e45" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186419779} :answer-field/id #uuid "0082553f-6022-5a48-bc6b-791b1c483f07" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419782}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "944d3b7e-a470-59f8-92c4-a8abf2a8b72b" :question/math-academy-id "q-317329" :question/problem "Find $b\\cdot (c\\times a)$, if $-5a\\cdot ((6b)\\times (4c))=120.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}-5a\\cdot ((6b)\\times (4c)) & =120 \\\\ (-5)\\cdot 6\\cdot 4\\cdot [a\\cdot (b\\times c)] & =120 \\\\ (-120)[a\\cdot (b\\times c)] & =120 \\\\ a\\cdot (b\\times c) & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =1,\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-1.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}]}
