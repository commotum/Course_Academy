\\,2\\cdot |\\begin{aligned}2 & 3 \\\\ 1 & 5\\end{aligned}|\\,+\\,1\\cdot |\\begin{aligned}2 & 0 \\\\ 1 & 4\\end{aligned}| \\\\  & =0\\,(0\\cdot 5-3\\cdot 4)\\,-\\,2\\,(2\\cdot 5-3\\cdot 1)\\,+\\,1\\,(2\\cdot 4-0\\cdot 1) \\\\  & =0(-12)\\,-\\,2\\,(7)\\,+\\,1\\,(8) \\\\  & =0-14+8 \\\\  & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186408071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3276117f-c9fb-5648-baa7-3ddf01111aad" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186408047}] :answer-field/correct {:answer/id #uuid "3276117f-c9fb-5648-baa7-3ddf01111aad" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186408047} :answer-field/id #uuid "1c0686c8-e24f-53f9-b174-994346511b51" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186408065}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "40346cc1-7283-5552-9863-224be650a17a" :question/math-academy-id "q-275350" :question/problem "Let $r=⟨-4,-1,2⟩$, $q=⟨-2,3,1⟩$ and $p=⟨5,-2,-1⟩.$ Find $r\\cdot (q\\times p)$ using a determinant.\n\n$r\\cdot (q\\times p)=$\n\n$-21$" :question/worked-solution "Remember that the scalar triple product $r\\cdot (q\\times p)$ is just the determinant of the matrix whose rows are given by $r,$ $q,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}r\\cdot (q\\times p) & =|\\begin{aligned}-4 & -1 & 2 \\\\ -2 & 3 & 1 \\\\ 5 & -2 & -1\\end{aligned}| \\\\  & =(-4)\\cdot |\\begin{aligned}3 & 1 \\\\ -2 & -1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}-2 & 1 \\\\ 5 & -1\\end{aligned}|+2\\cdot |\\begin{aligned}-2 & 3 \\\\ 5 & -2\\end{aligned}| \\\\  & =(-4)(3\\cdot (-1)-(-2)\\cdot 1)+((-2)\\cdot (-1)-5\\cdot 1)+2((-2)\\cdot (-2)-5\\cdot 3) \\\\  & =(-4)(-3+2)+(2-5)+2(4-15) \\\\  & =4-3-22 \\\\  & =-21.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186408111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56ef0874-008a-597f-b2cb-02be44cd3944" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186408103} {:answer/id #uuid "6d8dcecd-d942-5c7a-b18e-cb5a2602acc6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186408104} {:answer/id #uuid "9cf98593-9506-526d-9be6-5176a031c0ec" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186408105} {:answer/id #uuid "a019b149-6685-5c94-9ead-07affcb89def" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186408106} {:answer/id #uuid "d6d39875-cd66-5fd6-9485-32650cce5157" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186408108}] :answer-field/correct {:answer/id #uuid "56ef0874-008a-597f-b2cb-02be44cd3944" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186408103} :answer-field/id #uuid "5fd432bd-eb14-5f9d-bc51-e98dfa9d5d17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186408109}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "32b7570a-855d-5799-88e4-c24fe54119de" :question/math-academy-id "q-20053" :question/problem "Let $a=⟨-2,2,-3⟩$, $b=⟨2,-1,2⟩$ and $c=⟨-2,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 2 & -3 \\\\ 2 & -1 & 2 \\\\ -2 & 1 & 1\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 1\\end{aligned}|-2\\cdot |\\begin{aligned}2 & 2 \\\\ -2 & 1\\end{aligned}|+(-3)\\cdot |\\begin{aligned}2 & -1 \\\\ -2 & 1\\end{aligned}| \\\\  & =-2((-1)\\cdot 1-1\\cdot 2)-2(2\\cdot 1-(-2)\\cdot 2)-3(2\\cdot 1-(-2)\\cdot (-1)) \\\\  & =6-12+0 \\\\  & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186408112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a28f1b85-eac0-597c-848e-a2bdbc20cee3" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186408107}] :answer-field/correct {:answer/id #uuid "a28f1b85-eac0-597c-848e-a2bdbc20cee3" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186408107} :answer-field/id #uuid "9284f3f7-2649-559e-ade1-b845ad584b38" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186408110}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "627a3422-ad6a-5d23-b76b-6cf6cb390db2" :question/math-academy-id "q-317318" :question/problem "Let $a=⟨-1,2,4⟩$, $b=⟨0,3,1⟩$ and $c=⟨2,5,0⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n\n$-15$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-1 & 2 & 4 \\\\ 0 & 3 & 1 \\\\ 2 & 5 & 0\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}3 & 1 \\\\ 5 & 0\\end{aligned}|\\,-\\,2\\cdot |\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}|\\,+\\,4\\cdot |\\begin{aligned}0 & 3 \\\\ 2 & 5\\end{aligned}| \\\\  & =(-1)\\,(3\\cdot 0-1\\cdot 5)\\,-\\,2\\,(0\\cdot 0-1\\cdot 2)\\,+\\,4\\,(0\\cdot 5-3\\cdot 2) \\\\  & =(-1)\\,(-5)\\,-\\,2\\,(-2)\\,+\\,4\\,(-6) \\\\  & =5+4-24 \\\\  & =-15.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186419785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186419781}] :answer-field/correct {:answer/id #uuid "aadbe221-860c-5e54-a0de-bd7fb0bef36e" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186419781} :answer-field/id #uuid "cea71914-4f17-5f64-8016-140e481b698d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419784}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "20209d26-6af3-5176-8409-17df2aefc0b9" :question/math-academy-id "q-317313" :question/problem "Let $a=⟨1,-3,0⟩$, $b=⟨-2,2,0⟩$ and $c=⟨2,0,-4⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -3 & 0 \\\\ -2 & 2 & 0 \\\\ 2 & 0 & -4\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & -4\\end{aligned}|\\,-\\,(-3)\\cdot |\\begin{aligned}-2 & 0 \\\\ 2 & -4\\end{aligned}|\\,+\\,0\\cdot |\\begin{aligned}-2 & 2 \\\\ 2 & 0\\end{aligned}| \\\\  & =1\\,(2\\cdot (-4)-0\\cdot 0)\\,-\\,(-3)\\,((-2)\\cdot (-4)-0\\cdot 2)\\,+\\,0\\,((-2)\\cdot 0-2\\cdot 2) \\\\  & =1\\,(-8)\\,-\\,(-3)\\,(8)\\,+\\,0\\,(-4) \\\\  & =-8+24+0 \\\\  & =16.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186419787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f56b9f8-00ca-5814-abb9-6c5a7caba35e" :answer/type {:db/ident :answer.type/math} :answer/value "-31" :db/id #edb/ref 17592186419780}] :answer-field/correct {:answer/id #uuid "3f56b9f8-00ca-5814-abb9-6c5a7caba35e" :answer/type {:db/ident :answer.type/math} :answer/value "-31" :db/id #edb/ref 17592186419780} :answer-field/id #uuid "7dd14090-bb12-5afc-8250-d9460b7c0f27" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186419783}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f15d30b5-fe4a-5207-9935-fd7503715554" :question/math-academy-id "q-317326" :question/problem "Let $a=⟨-2,0,-1⟩$, $b=⟨-3,-1,4⟩$ and $c=⟨5,-2,-2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-2 & 0 & -1 \\\\ -3 & -1 & 4 \\\\ 5 & -2 & -2\\end{aligned}| \\\\  & =(-2)\\cdot |\\begin{aligned}-1 & 4 \\\\ -2 & -2\\end{aligned}|\\,-\\,0\\cdot |\\begin{aligned}-3 & 4 \\\\ 5 & -2\\end{aligned}|\\,+\\,(-1)\\cdot |\\begin{aligned}-3 & -1 \\\\ 5 & -2\\end{aligned}| \\\\  & =(-2)\\,((-1)(-2)-4\\cdot (-2))\\,-\\,0\\,((-3)\\cdot (-2)-4\\cdot 5)\\,+\\,(-1)\\,((-3)\\cdot (-2)-(-1)\\cdot 5) \\\\  & =(-2)\\,(10)\\,-\\,0\\,(-14)\\,+\\,(-1)\\,(11) \\\\  & =-20+0-11 \\\\  & =-31.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] [{:db/id #edb/ref 17592186105737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105595 :question/id #uuid "483b758a-9b14-5a72-87e5-70f27a0acf48" :question/math-academy-id "e-4349" :question/problem "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b}),$ if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times 3c) & =5 \\\\ 2\\cdot [a\\cdot (b\\times 3c)] & =5 \\\\ 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =5 \\\\ a\\cdot (b\\times c) & =\\frac{5}{6}.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{5}{6},\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{5}{6}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/questions [{:db/id #edb/ref 17592186106128 :question/answer-fields [{:answer-field/choices 