 :db/id #edb/ref 17592186261187} {:answer/id #uuid "c2590a97-ba1f-5833-ac3a-19f3da83c3e8" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261588} {:answer/id #uuid "d4426b8c-3067-50d4-8333-34c0e794e8f8" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186261745}] :answer-field/correct {:answer/id #uuid "c2590a97-ba1f-5833-ac3a-19f3da83c3e8" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186261588} :answer-field/id #uuid "2d10b3cf-a3e7-5c1c-aafc-7abe846e273d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262203}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "55c9895d-23d4-50a7-8c21-33e1b247f3b1" :question/math-academy-id "q-128107" :question/problem "Let $a=⟨0,9,3⟩,$ $b=⟨3,2,0⟩$ and $c=⟨-1,1,1⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}0 & 9 & 3 \\\\ 3 & 2 & 0 \\\\ -1 & 1 & 1\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}|-9\\cdot |\\begin{aligned}3 & 0 \\\\ -1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}3 & 2 \\\\ -1 & 1\\end{aligned}| \\\\  & =0-9(3\\cdot 1-(-1)\\cdot 0)+3(3\\cdot 1-(-1)\\cdot 2) \\\\  & =0-27+15 \\\\  & =-12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92d23d47-b732-5d7c-8332-8dc173c69020" :answer/type {:db/ident :answer.type/math} :answer/value "-60" :db/id #edb/ref 17592186261152} {:answer/id #uuid "940b07cd-9fd6-595b-99f0-d6cb02f36aa3" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186261164} {:answer/id #uuid "c6b36382-f8ad-5f91-899f-3836e3f05ba8" :answer/type {