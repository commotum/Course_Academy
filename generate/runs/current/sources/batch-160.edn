5f9-50adcd0043cf" :question/math-academy-id "q-20059" :question/problem "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2871030f-535f-5bad-960f-2518315ab868" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186285139} {:answer/id #uuid "395873e5-15bd-53dd-8303-0a9cb00704ce" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186285327} {:answer/id #uuid "4c9995e8-b44e-5b2b-a77c-68b604f74177" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186285501} {:answer/id #uuid "c2f44045-fc84-58ca-8c0c-ea930c16cece" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286576} {:answer/id #uuid "dc4e1f02-b381-51f4-825c-11efa8be82bc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286791}] :answer-field/correct {:answer/id #uuid "c2f44045-fc84-58ca-8c0c-ea930c16cece" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286576} :answer-field/id #uuid "e0ca935c-f519-5702-93c9-2f479ee86077" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287606}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2054ccd0-385b-55a1-9e4b-6c29d327d7d8" :question/math-academy-id "q-20061" :question/problem "Find $c\\cdot (b\\times a)$, if $3a\\cdot (6b\\times c)=90.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (6b\\times c) & =90 \\\\ 3\\cdot 6\\cdot [a\\cdot (b\\times c)] & =90 \\\\ a\\cdot (b\\times c) & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c76837d-abf1-5987-8d19-edc1988fecd5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297738}] :answer-field/correct {:answer/id #uuid "2c76837d-abf1-5987-8d19-edc1988fecd5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186297738} :answer-field/id #uuid "f75cec09-3e63-55a8-bfe9-30a9430f9ad5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299474}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ef37e01-1bf6-55b3-89e8-cc90cafd078c" :question/math-academy-id "q-317343" :question/problem "Find $b\\cdot (c\\times a),$ if $b\\times c=⟨4,-1,6⟩$ and $a=⟨2,3,-1⟩.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,3,-1⟩\\cdot ⟨4,-1,6⟩ \\\\  & =2\\cdot 4+3\\cdot (-1)+(-1)\\cdot 6 \\\\  & =8-3-6 \\\\  & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=1\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a)=-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e01e90f-f2c8-529a-8475-ffe098a4dce7" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186339392} {:answer/id #uuid "2d627205-3eda-50f7-a543-2c0b44474b89" :answ