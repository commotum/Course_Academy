dot (-\\sqrt{3})+0\\cdot 10+(-2)\\cdot (-10) \\\\  & =3+0+20 \\\\  & =23.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0e5a73a-2919-5f8c-a396-7d6e2d9fe189" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291402}] :answer-field/correct {:answer/id #uuid "b0e5a73a-2919-5f8c-a396-7d6e2d9fe189" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291402} :answer-field/id #uuid "dcec4611-b8bf-5bde-af83-ce1e61831acc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292422}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ae335859-0dfa-58d7-a7ca-cf642f79ca2b" :question/math-academy-id "q-275348" :question/problem "Given that $a=⟨1,2,3⟩,$ $b=⟨-1,0,-2⟩,$ and $c=⟨0,-2,1⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & -2 \\\\ 0 & -2 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|i-|\\begin{aligned}-1 & -2 \\\\ 0 & 1\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ 0 & -2\\end{aligned}|k \\\\  & =(0\\cdot 1-(-2)\\cdot (-2))i-((-1)\\cdot 1-0\\cdot (-2))j+((-1)\\cdot (-2)-0\\cdot 0)k \\\\  & =-4i+j+2k \\\\  & =⟨-4,1,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,2,3⟩\\cdot ⟨-4,1,2⟩ \\\\  & =1\\cdot (-4)+2\\cdot 1+3\\cdot 2 \\\\  & =-4+2+6 \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a5bc8d5-e509-5863-b1b0-5d966475a48c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298152}] :answer-field/correct {:answer/id #uuid "8a5bc8d5-e509-5863-b1b0-5d966475a48c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186298152} :answer-field/id #uuid "4e520c21-8113-540a-a136-ed9d09b72c68" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298903}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e756bda8-091e-58df-91a3-7d6c4fd6790c" :question/math-academy-id "q-317302" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨\\sqrt{7},-2,5⟩$ and $b\\times c=⟨\\sqrt{7},3,-1⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨\\sqrt{7},-2,5⟩\\cdot ⟨\\sqrt{7},3,-1⟩ \\\\  & =(\\sqrt{7})(\\sqrt{7})+(-2)(3)+(5)(-1) \\\\  & =7-6-5 \\\\  & =-4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "642b83ad-84f3-53a2-ae75-f108cc2a5be0" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186297978}] :answer-field/correct {:answer/id #uuid "642b83ad-84f3-53a2-ae75-f108cc2a5be0" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186297978} :answer-field/id #uuid "cf93de4a-48e1-5dad-a599-646066d80847" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299336}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dcaa5f3b-4be2-5705-929a-5ba642430c92" :question/math-academy-id "q-317303" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨-\\sqrt{8},\\,4,\\,-3⟩$ and $b\\times c=⟨\\sqrt{8},\\,-1,\\,2⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-\\sqrt{8},\\,4,\\,-3⟩\\cdot ⟨\\sqrt{8},\\,-1,\\,2⟩ \\\\  & =(-\\sqrt{8})(\\sqrt{8})+(4)(-1)+(-3)(2) \\\\  & =-8-4-6 \\\\  & =-18.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f46a08c3-ac51-5443-9d62-4a4fdbe6834b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298591}] :answer-field/correct {:answer/id #uuid "f46a08c3-ac51-5443-9d62-4a4fdbe6834b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298591} :answer-field/id #uuid "5a67eb77-f73b-57a3-9ceb-4843468c5708" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298946}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "47306bb8-b679-542e-9111-9cf80b931f6e" :question/math-academy-id "q-317304" :question/problem "Find $a\\cdot (b\\times c)$ given that $a=⟨0,\\,5,\\,\\sqrt{11}⟩$ and $b\\times c=⟨7,\\,-2,\\,\\sqrt{11}⟩.$\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Substituting given vectors into the formula for the scalar triple product, we obtain \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨0,\\,5,\\,\\sqrt{11}⟩\\cdot ⟨7,\\,-2,\\,\\sqrt{11}⟩ \\\\  & =(0)(7)+(5)(-2)+(\\sqrt{11})(\\sqrt{11}) \\\\  & =0-10+11 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5ad400-1475-5884-8d73-aa99d98ec4d6" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186339542} {:answer/id #uuid "57d0a154-1aaa-5696-835d-3eecfa11a6d9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339929} {:answer/id #uuid "86e1fe55-454a-5121-bac4-46896aa3ba50" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186340340} {:answer/id #uuid "908c7900-9735-5a67-b556-85b9b49edab0" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186340424} {:answer/id #uuid "f836db60-b44d-5c4b-8a95-1f0a325c7eee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186341322}] :answer-field/correct {:answer/id #uuid "f836db60-b44d-5c4b-8a95-1f0a325c7eee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186341322} :answer-field/id #uuid "bd6a14fe-e999-58b2-a558-e4c85c9c9d40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341707}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03c3f067-95a3-5c61-bbcc-2fdbc5e2a97b" :question/math-academy-id "q-73457" :question/problem "Given that $a=⟨1,-3,2⟩,$ $b=⟨2,-1,-1⟩,$ and $c=⟨3,-3,0⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 2 & -1 & -1 \\\\ 3 & -3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ -3 & 0\\end{aligned}|i-|\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}|j+|\\begin{aligned}2 & -1 \\\\ 3 & -3\\end{aligned}|k \\\\  & =((-1)\\cdot 0-(-1)\\cdot (-3))i-(2\\cdot 0-(-1)\\cdot 3)j+(2\\cdot (-3)-(-1)\\cdot 3)k \\\\  & =-3i-3j-3k \\\\  & =⟨-3,-3,-3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-3,2⟩\\cdot ⟨-3,-3,-3⟩ \\\\  & =1\\cdot (-3)+(-3)\\cdot (-3)+2\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51082891-6c1b-52bb-b8ef-b6a007b87b7e" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186339869} {:answer/id #uuid "7aa28b6a-dcb5-5ac6-b93d-070512ac799c" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186340223} {:answer/id #uuid "7d205186-6df2-56a2-865f-bcd95b4af7a2" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186340256} {:answer/id #uuid "819cb18c-aae0-5874-97f5-c6cb16234ba2" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186340294} {:answer/id #uuid "d59c3afe-dcd0-50af-abf3-3623837dac03" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186341019}] :answer-field/correct {:answer/id #uuid "7d205186-6df2-56a2-865f-bcd95b4af7a2" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186340256} :answer-field/id #uuid "a1370dba-ea66-512a-8e16-f181dabee801" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341667}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3a3b3ce2-a088-5e9d-b6fc-165f8a2b77d2" :question/math-academy-id "q-73458" :question/problem "Given that $a=⟨-2,4,3⟩,$ $b=⟨-1,3,2⟩,$ and $c=⟨2,-1,4⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -1 & 3 & 2 \\\\ 2 & -1 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 2 \\\\ -1 & 4\\end{aligned}|i-|\\begin{aligned}-1 & 2 \\\\ 2 & 4\\end{aligned}|j+|\\begin{aligned}-1 & 3 \\\\ 2 & -1\\end{aligned}|k \\\\  & =(3\\cdot 4-2\\cdot (-1))i-((-1)\\cdot 4-2\\cdot 2)j+((-1)\\cdot (-1)-3\\cdot 2)k \\\\  & =14i+8j-5k \\\\  & =⟨14,8,-5⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,4,3⟩\\cdot ⟨14,8,-5⟩ \\\\  & =(-2)\\cdot 14+4\\cdot 8+3\\cdot (-5) \\\\  & =-11.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4597bbb8-2339-59d7-a89d-84e7d82e4af7" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186339746} {:answer/id #uuid "6ddbdce8-64a8-5b4c-81c7-29ded57a3090" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186340100} {:answer/id #uuid "7b08f4f2-f8e6-57a8-824a-14ba21be0f46" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340227} {:answer/id #uuid "9d2cba1e-d97d-5cb4-a610-06c9a813470e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340542} {:answer/id #uuid "f0bc4d09-f1f6-5163-96f4-651b14c60f4d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186341249}] :answer-field/correct {:answer/id #uuid "7b08f4f2-f8e6-57a8-824a-14ba21be0f46" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340227} :answer-field/id #uuid "76e5b949-55b3-5b2f-a023-770c01a2ee78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341590}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a18cd55a-1984-588f-a487-c7100ebf414c" :question/math-academy-id "q-73459" :question/problem "Given that $a=⟨-2,0,-1⟩,$ $b=⟨-2,-1,0⟩,$ and $c=⟨3,1,4⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -2 & -1 & 0 \\\\ 3 & 1 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 0 \\\\ 1 & 4\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ 3 & 4\\end{aligned}|j+|\\begin{aligned}-2 & -1 \\\\ 3 & 1\\end{aligned}|k \\\\  & =((-1)\\cdot 4-0\\cdot 1)i-((-2)\\cdot 4-0\\cdot 3)j+((-2)\\cdot 1-(-1)\\cdot 3)k \\\\  & =-4i+8j+k \\\\  & =⟨-4,8,1⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,0,-1⟩\\cdot ⟨-4,8,1⟩ \\\\  & =(-2)\\cdot (-4)+0\\cdot 8+(-1)\\cdot 1 \\\\  & =7.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] [{:db/id #edb/ref 17592186105736 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105594 :question/id #uuid "b5cf98f2-087d-580c-a2f6-c37ad2af4c2c" :question/math-academy-id "e-4348" :question/problem "Let $\\mathbf{a}=\\langle 4,2,-1 \\rangle,$ $\\mathbf{b}=\\langle 0,2,1 \\rangle,$ and $\\mathbf{c}=\\langle -1,-1,2 \\rangle.$ Find $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c}).$" :question/worked-solution "Remember that the scalar triple product $\\mathbf{a} \\cdot (\\mathbf{b} \\times \\mathbf{c})$ is just the determinant of the matrix whose rows are given by $\\mathbf{a},$ $\\mathbf{b},$ and $\\mathbf{c}.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}4 & 2 & -1 \\\\ 0 & 2 & 1 \\\\ -1 & -1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}|-2\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}|+(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ -1 & -1\\end{aligned}| \\\\  & =4\\cdot (2\\cdot 2-1\\cdot (-1))-2\\cdot (0\\cdot 2-1\\cdot (-1))+(-1)\\cdot (0\\cdot (-1)-2\\cdot (-1)) \\\\  & =20-2-2 \\\\  & =16.\\end{aligned}\n$$"} :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/questions [{:db/id #edb/ref 17592186106126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94a465ca-05a5-592e-8bad-ca37a3c2aada" :answer/type {:db/ident :answer.type/math} :answer/value "-68" :db/id #edb/ref 17592186102633} {:answer/id #uuid "a0d2f769-915c-58df-b7d4-bb3752ade6f3" :answer/type {:db/ident :answer.type/math} :answer/value "-58" :db/id #edb/ref 17592186102634} {:answer/id #uuid "eac50f40-f41a-5d0a-b308-ce29d1f377ea" :answer/type {:db/ident :answer.type/math} :answer/value "-64" :db/id #edb/ref 17592186102635} {:answer/id #uuid "00728dd2-efe2-51d0-ab82-3b59e0b1c2ae" :answer/type {:db/ident :answer.type/math} :answer/value "-72" :db/id #edb/ref 17592186102636} {:answer/id #uuid "464182a0-c3e6-5194-b73c-9efd16f5761e" :answer/type {:db/ident :a