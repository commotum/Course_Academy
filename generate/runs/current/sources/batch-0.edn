d{aligned}| & =0|\\begin{aligned}0 & -5 \\\\ -3 & 0\\end{aligned}|-7|\\begin{aligned}1 & -5 \\\\ 4 & 0\\end{aligned}|+2|\\begin{aligned}1 & 0 \\\\ 4 & -3\\end{aligned}| \\\\  & =0-7(0-(-20))+2(-3-0) \\\\  & =-7\\cdot (20)+2\\cdot (-3) \\\\  & =-140-6 \\\\  & =-146\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295136 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18a27456-d8f3-561b-bb79-e130d6872c6c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293031}] :answer-field/correct {:answer/id #uuid "18a27456-d8f3-561b-bb79-e130d6872c6c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186293031} :answer-field/id #uuid "3d897447-080d-5fa1-811f-5026bf48e4a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294141}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ee0a6b76-25b3-5557-92d9-083561656751" :question/math-academy-id "q-280390" :question/problem "If $A=[\\begin{aligned}0 & 2 & -3 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & 4\\end{aligned}],$ then $det(A)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & 2 & -3 \\\\ 0 & 0 & 5 \\\\ 0 & 0 & 4\\end{aligned}| & =0|\\begin{aligned}0 & 5 \\\\ 0 & 4\\end{aligned}|-2|\\begin{aligned}0 & 5 \\\\ 0 & 4\\end{aligned}|+(-3)|\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}| \\\\  & =0-2(0-0)-3(0-0) \\\\  & =0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1339ed7b-7b32-5f2e-97a1-9339503ac331" :answer/type {:db/ident :answer.type/math} :answer/value "87" :db/id #edb/ref 17592186293012}] :answer-field/correct {:answer/id #uuid "1339ed7b-7b32-5f2e-97a1-9339503ac331" :answer/type {:db/ident :answer.type/math} :answer/value "87" :db/id #edb/ref 17592186293012} :answer-field/id #uuid "93fac66a-4741-5f19-907d-88bd6bf67c55" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294462}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "602c9b3b-40e9-5371-929a-34e8b2aaccf1" :question/math-academy-id "q-280393" :question/problem "If $Q=[\\begin{aligned}3 & -2 & 5 \\\\ 4 & 1 & 0 \\\\ -1 & 3 & 2\\end{aligned}],$ then $det(Q)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & -2 & 5 \\\\ 4 & 1 & 0 \\\\ -1 & 3 & 2\\end{aligned}| & =3|\\begin{aligned}1 & 0 \\\\ 3 & 2\\end{aligned}|-(-2)|\\begin{aligned}4 & 0 \\\\ -1 & 2\\end{aligned}|+5|\\begin{aligned}4 & 1 \\\\ -1 & 3\\end{aligned}| \\\\  & =3(1\\cdot 2-0\\cdot 3)+2(4\\cdot 2-0\\cdot (-1))+5(4\\cdot 3-1\\cdot (-1)) \\\\  & =3(2)+2(8)+5(12+1) \\\\  & =6+16+5(13) \\\\  & =6+16+65 \\\\  & =87\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295138 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7756ac8b-4d3e-5612-bad7-e5a160c5a43f" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186293420}] :answer-field/correct {:answer/id #uuid "7756ac8b-4d3e-5612-bad7-e5a160c5a43f" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186293420} :answer-field/id #uuid "a7577202-1833-561f-80ac-32392b1ecb99" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294534}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5aadd6ce-d715-5a22-9944-d786941130cb" :question/math-academy-id "q-280394" :question/problem "If $R=[\\begin{aligned}1 & -2 & 0 \\\\ 4 & 3 & 5 \\\\ 6 & -1 & 2\\end{aligned}],$ then $det(R)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 0 \\\\ 4 & 3 & 5 \\\\ 6 & -1 & 2\\end{aligned}| & =1|\\begin{aligned}3 & 5 \\\\ -1 & 2\\end{aligned}|-(-2)|\\begin{aligned}4 & 5 \\\\ 6 & 2\\end{aligned}|+0|\\begin{aligned}4 & 3 \\\\ 6 & -1\\end{aligned}| \\\\  & =1(3\\cdot 2-5\\cdot (-1))+2(4\\cdot 2-5\\cdot 6)+0 \\\\  & =1(6+5)+2(8-30) \\\\  & =11+2(-22) \\\\  & =11-44 \\\\  & =-33\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "199cfd6b-b7c6-5ebd-9bb2-5a78fca81a8a" :answer/type {:db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186293039}] :answer-field/correct {:answer/id #uuid "199cfd6b-b7c6-5ebd-9bb2-5a78fca81a8a" :answer/type {:db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186293039} :answer-field/id #uuid "ca1eadfe-246c-5ca2-a02d-27c7056e56da" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294645}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4c583368-3601-5727-a2d2-942c7b9558d3" :question/math-academy-id "q-280400" :question/problem "If $W=[\\begin{aligned}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{aligned}],$ then $det(W)=${{field-1}}." :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}5 & -2 & 3 \\\\ -1 & 4 & 6 \\\\ 2 & -3 & 1\\end{aligned}| & =5|\\begin{aligned}4 & 6 \\\\ -3 & 1\\end{aligned}|-(-2)|\\begin{aligned}-1 & 6 \\\\ 2 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 4 \\\\ 2 & -3\\end{aligned}| \\\\  & =5(4\\cdot 1-6\\cdot (-3))+2((-1)(1)-6\\cdot 2)+3((-1)(-3)-4\\cdot 2) \\\\  & =5(4+18)+2(-1-12)+3(3-8) \\\\  & =5(22)+2(-13)+3(-5) \\\\  & =110-26-15 \\\\  & =69\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66ee7868-897f-5ab3-8d7e-e9355eee0531" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186321950} {:answer/id #uuid "6ad500fb-8c54-539b-bf4d-cd40316e5887" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186321981} {:answer/id #uuid "772ad7c2-6121-5b62-96eb-0eca3dab85ec" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186322080} {:answer/id #uuid "b5556dee-a933-508a-b4bb-1dcfb4c54712" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186322561} {:answer/id #uuid "de02e7bb-d9a4-5bb9-bf6b-5f3af8e67385" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186322882}] :answer-field/correct {:answer/id #uuid "b5556dee-a933-508a-b4bb-1dcfb4c54712" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186322561} :answer-field/id #uuid "95a9de04-2eb7-53e7-9fc6-8703030e5631" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323460}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8bac3242-8499-5338-a15f-874124048b1a" :question/math-academy-id "q-38100" :question/problem "Find the value of $|\\begin{aligned}1 & -1 & 2 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 8\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & 2 \\\\ 0 & 4 & 1 \\\\ 0 & 0 & 8\\end{aligned}| & =1|\\begin{aligned}4 & 1 \\\\ 0 & 8\\end{aligned}|-(-1)|\\begin{aligned}0 & 1 \\\\ 0 & 8\\end{aligned}|+2|\\begin{aligned}0 & 4 \\\\ 0 & 0\\end{aligned}| \\\\  & =1(32-0)+1(0-0)+2(0-0) \\\\  & =1\\cdot 32 \\\\  & =32\\end{aligned}\n$$"} {: