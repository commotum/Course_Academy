stion/id #uuid "14e05d4f-373c-5d1f-aa59-7ee52466480e" :question/math-academy-id "e-14762" :question/problem "Find the value of ![](images/8e/8e7935fce161e2a1ed706ec03bb5cd202e8c4650ba01ca5e4633f9f1c121d04a.png)" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & -3 & 6 \\\\ 8 & 8 & 8 \\\\ -6 & -12 & 1\\end{aligned}| & =0|\\begin{aligned}8 & 8 \\\\ -12 & 1\\end{aligned}|-(-3)|\\begin{aligned}8 & 8 \\\\ -6 & 1\\end{aligned}|+6|\\begin{aligned}8 & 8 \\\\ -6 & -12\\end{aligned}| \\\\  & =0(8+96)+3(8+48)+6(-96+48) \\\\  & =0+3\\cdot 56+6\\cdot (-48) \\\\  & =168-288 \\\\  & =-120\\end{aligned}\n$$"} :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048965 :topic/math-academy-id 233 :topic/title "The Minors of a 3x3 Matrix"}] :knowledge-point/questions [{:db/id #edb/ref 17592186060278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98f5e0e0-c541-5d5e-b120-030d10523d76" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186058291} {:answer/id #uuid "b4a5c589-e2fa-52d4-bdc2-98052caa1a12" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186058292} {:answer/id #uuid "050bb88d-1c57-5dcc-9cba-c9dddc9dd491" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186058293} {:answer/id #uuid "287927b3-cd33-5f0b-a23f-da8c2dcc0f8b" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186058294} {:answer/id #uuid "5a082a8b-804e-590d-a86c-ce9acb67344c" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186058295}] :answer-field/id #uuid "f30ee70b-e1cf-592b-a7b7-c7aab8026e36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref