/math} :answer/value "10" :db/id #edb/ref 17592186245736} {:answer/id #uuid "caf954cd-bb67-553d-8e8c-ae5436312352" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186246122} {:answer/id #uuid "f2f19e3a-8e8b-5a89-b39e-a28325288d1b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246459}] :answer-field/correct {:answer/id #uuid "5590a848-eae9-5089-bdc1-7f789ac62064" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186245065} :answer-field/id #uuid "5d24b5a0-aff5-5beb-bda9-0451317c58e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246711}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6b4f9a18-294f-593c-86d1-c0d405dcd6de" :question/math-academy-id "q-110544" :question/problem "Solve for $y$ where ${81}^{y}={27}^{y+5}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{y}={({3}^{3})}^{y+5}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{4y}={3}^{3(y+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3),$ we equate the exponents and solve for $y:$\n\n$$\n\\begin{aligned}4y & =3(y+5) \\\\ 4y & =3y+15 \\\\ y & =15\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304821 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0afd78c4-898a-5dcb-acd8-ccd10775c767" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186302532} {:answer/id #uuid "43924541-f7eb-59bb-bc12-3b2b676d62c0" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186302883} {:answer/id #uuid "948cfa4d-d1dc-5ad4-90ba-e697cdb0adf1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186303378} {:answer/id #uuid "a2a106f1-8046-5175-bb97-e0b1842bc7b3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186303459} {:answer/id #uuid "d63fdb98-6f65-5c38-ba7d-66e1d91d04bc" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186303787}] :answer-field/correct {:answer/id #uuid "a2a106f1-8046-5175-bb97-e0b1842bc7b3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186303459} :answer-field/id #uuid "f1518571-1884-5270-a40c-90516fff6878" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304728}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "62eb03df-7254-5fcb-be19-35dd658881b9" :question/math-academy-id "q-3304" :question/problem "Find the value of $x$ that satisfies the equation ${8}^{x}\\cdot {4}^{2x-1}=32.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $8={2}^{3}$, $4={2}^{2}$ and $32={2}^{5},$ as follows:\n\n$$\n{({2}^{3})}^{x}\\cdot {({2}^{2})}^{2x-1}={2}^{5}\n$$\n\nThen, we apply the power rule and the product rule of exponents. This gives:\n\n$$\n\\begin{aligned}{2}^{3x}\\cdot {2}^{2(2x-1)} & ={2}^{5} \\\\ {2}^{3x+2(2x-1)} & ={2}^{5}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(2)$, we equate the exponents and solve for $x:$\n\n$$\n\\begin{aligned}3x+2(2x-1) & =5 \\\\ 3x+4x-2 & =5 \\\\ 7x & =7 \\\\ x & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0789c91d-4133-552b-8e70-d28f7dc1b01d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186333064} {:answer/id #uuid "0f652d2a-88fb-598a-a277-6b88d22c44ca" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186333125} {:answer/id #uuid "22144aed-0092-5ef2-a430-b40baca139b4" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186333294} {:answer/id #uuid "3b441be5-b06c-5167-83a7-2c634e4ab505" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186333550} {:answer/id #uuid "6e070fca-f0f9-58a6-a692-9afdb70d5363" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186333988}] :answer-field/correct {:answer/id #uuid "22144aed-0092-5ef2-a430-b40baca139b4" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186333294} :answer-field/id #uuid "a9ee674c-2d31-5325-8ca0-813a6a38eaa1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335550}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8eb67dfa-3d39-5179-b6f6-641b60fb353c" :question/math-academy-id "q-66889" :question/problem "Find the value of $b$ that satisfies the equation ${16}^{b}={64}^{b+4}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $16={4}^{2}$ and $64={4}^{3},$ as follows:\n\n$$\n{({4}^{2})}^{b}={({4}^{3})}^{b+4}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{4}^{2b}={4}^{3(b+4)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(4)$, we equate the exponents and solve for $b:$\n\n$$\n\\begin{aligned}2b & =3(b+4) \\\\ 2b & =3b+12 \\\\ b & =-12\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573690ae-6cda-5d43-b52b-e9b6645c5f67" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186333783} {:answer/id #uuid "655306ca-f081-5fd5-9ed9-84da858807a1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186333910} {:answer/id #uuid "6fd009f8-6e8a-549d-9a4d-ab1bb878a030" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186334009} {:answer/id #uuid "e1c4d8a9-1010-5a2a-9648-8736181856d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186334957} {:answer/id #uuid "fcc51cc3-bdf5-5249-90fb-98347db0ac3c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186335211}] :answer-field/correct {:answer/id #uuid "6fd009f8-6e8a-549d-9a4d-ab1bb878a030" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186334009} :answer-field/id #uuid "791e39b8-d11b-5095-b01c-e7cdcd052d1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335472}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9dafb4d0-3b4b-54e8-9221-f3780f89610b" :question/math-academy-id "q-66892" :question/problem "Solve for $q$ where ${25}^{q+1}={125}^{q}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $25={5}^{2}$ and $125={5}^{3},$ as follows:\n\n$$\n{({5}^{2})}^{q+1}={({5}^{3})}^{q}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{5}^{2(q+1)}={5}^{3q}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents and solve for $q:$\n\n$$\n\\begin{aligned}2(q+1) & =3q \\\\ 2q+2 & =3q \\\\ q & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d8d4f1-069f-5999-90cd-de6a076c1b15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186333165} {:answer/id #uuid "18fcade8-3d85-57f2-9926-025f7f6bda40" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186333215} {:answer/id #uuid "c7c31d51-ffad-5ede-a608-d0a37966955d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186334728} {:answer/id #uuid "ded55b8b-cc37-5917-a902-1f995ea97dfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186334930} {:answer/id #uuid "f3f1e514-ed0c-50dc-9391-5f7fc7b497c6" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186335127}] :answer-field/correct {:answer/id #uuid "13d8d4f1-069f-5999-90cd-de6a076c1b15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186333165} :answer-field/id #uuid "0cf67bf2-60e8-5cd7-b3c5-b039e26df66d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335262}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bb40fa82-caf5-5c22-a8e0-5ae171e1b21d" :question/math-academy-id "q-66895" :question/problem "If ${81}^{3m}={27}^{m+5}$ then $m=$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{3m}={({3}^{3})}^{m+5}\\,\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{12m} & ={3}^{3(m+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents and solve for $m:$\n\n$$\n\\begin{aligned}12m & =3(m+5) \\\\ 12m & =3m+15 \\\\ 9m & =15 \\\\ m & =\\frac{5}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186410434 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "083bbb43-125e-530a-a0bf-4e386e0fef8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186410210} {:answer/id #uuid "2ebed13b-65b6-5f09-b6ac-5843bb401594" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186410238} {:answer/id #uuid "8a7cd739-dad9-5004-a078-dfdfdfb9ad48" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186410289} {:answer/id #uuid "c45e66f0-50f2-598c-b5d0-5402c3cbc44b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186410335} {:answer/id #uuid "e52fbbd7-076f-5ca8-a202-557210987158" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186410357}] :answer-field/correct {:answer/id #uuid "c45e66f0-50f2-598c-b5d0-5402c3cbc44b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186410335} :answer-field/id #uuid "2c131e70-66d3-5684-931b-600e5433ed9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410379}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b6488fce-f74c-5334-a4ac-d8d71ef00e69" :question/math-academy-id "q-3090" :question/problem "Solve for $n$ where ${16}^{2n}={8}^{n+1}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $16={2}^{4}$ and $8={2}^{3},$ as follows:\n\n$$\n{({2}^{4})}^{2n}={({2}^{3})}^{n+1}\\,\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{2}^{8n} & ={2}^{3(n+1)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(2)$, we equate the exponents and solve for $n:$\n\n$$\n\\begin{aligned}8n & =3(n+1) \\\\ 8n & =3n+3 \\\\ 5n & =3 \\\\ n & =\\frac{3}{5}\\end{aligned}\n$$"}] :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] [{:db/id #edb/ref 17592186115241 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115070 :question/id #uuid "dc6dd9b4-de7f-52d0-8ff9-a7a7f7a9abd7" :question/math-academy-id "e-4711" :question/problem "Consider the system of linear equations\n![](images/40/406033f059dc4438ea55d43d2bd00b3b79bb99365a2e4846c995f4a447acfd82.svg)\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n![](images/be/bed2784d17ee63b805917b492052daa7ef079c1682bbc78468eb10f314a92b1f.svg)\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 5 & 1 & 2 \\\\ 1 & 5 & 2 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 5 & 1 & 2 \\\\ 0 & 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 5 & 0 & -1 \\\\ 0 & 0 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now\n![](images/91/91175ab97472067cd14ffff740bb3a98718436f1e94de7a4a6d7fdfb1b35b81f.svg)\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $z,$ and we have one free variable, $y.$ That means we need to find $x$ and $z$ in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=-1-5y \\\\ y=y \\\\ z=3,\\end{aligned}\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-1-5y \\\\ y \\\\ 3\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} :knowledge-point/id #uuid "2d81e3f1-d930-59ee-b439-2a3645aebb6c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048742 :topic/math-academy-id 1049 :topic/title "Reduced Row Echelon Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186115751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a25a6cc1-d88b-5f9f-aae1-cd3eb5867629" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186113473} {:answer/id #uuid "b77df5f9-58e2-575f-bfdb-d097b57fc68f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z \\\\ 13 - 2z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113474} {:answer/id #uuid "cee3daed-dbf4-59da-87b6-fc369d2242f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}z \\\\ 13 - 2z \\\\ 6\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113475} {:answer/id #uuid "fc60f84e-4b0e-50e1-8012-0e75aaf5aef9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ 13 - 2z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113476} {:answer/id #uuid "fe885f5c-7b1a-558b-a68d-cf982e4ed839" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 - z \\\\ 13 - 2z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113477}] :answer-field/id #uuid "83a4d783-f324-5167-b920-c6eb60540d44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113472}] :question/id #uuid "d3d66d49-8ab9-5eb7-8d2f-d0c60a5c4d4a" :question/math-academy-id "q-32234" :question/problem "Consider the system of linear equations\n${x + y + 2z = 19; 3x + y + 2z = 31$.\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."} {:db/id #edb/ref 17592186115830 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d6f3fc-4b07-573d-909e-71ad76038bc7" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186113918} {:answer/id #uuid "95406019-b0d1-5bce-ac42-02cb3f8a5ec3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 - 3z \\\\ 2 + 3z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113919} {:answer/id #uuid "db029453-b2ce-50e3-ba46-3321f56ef469" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 + 3z \\\\ 2 + 3z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113920} {:answer/id #uuid "e58beddf-d9e7-5f82-bbec-ff4bc4463d84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 - 3z \\\\ 2 - 3z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113921} {:answer/id #uuid "1fd0d020-f064-5f3e-ada5-5a1b8e66bdc2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 - 3z \\\\ 3z \\\\ z\\end{bmatrix}, z ∈ (- ∞, ∞)" :db/id #edb/ref 17592186113922}] :answer-field/id #uuid "6c202514-58b0-57fd-9d4a-d9d9f27c390e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113917}] :question/id #uuid "8cd9c6c5-780e-5f01-93cc-d5e9b9533129" :question/math-academy-id "q-42040" :question/problem "Consider the system of linear equations\n${x + 3z =-2; x + y = 0$.\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."} {:db/id #edb/ref 17592186266111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d6a91da-fd38-559c-b128-19dbc7c776d0" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186263546} {:answer/id #uuid "a2aede61-88b5-5a76-9ec8-106c89064823" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{x}_{3}+1 \\\\ 5{x}_{3}-1 \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264378} {:answer/id #uuid "c1490779-e503-5831-b724-e9dbf247059f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1-3{x}_{3} \\\\ 1-5{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264677} {:answer/id #uuid "ed2aed37-0c4b-5f9c-8951-b59ecdbcba2c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{x}_{3}+1 \\\\ 1-5{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186265070} {:answer/id #uuid "ff176417-b95c-5350-be8a-fc42f217620b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{x}_{3}-1 \\\\ 5{x}_{3}+1 \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186265244}] :answer-field/correct {:answer/id #uuid "a2aede61-88b5-5a76-9ec8-106c89064823" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{x}_{3}+1 \\\\ 5{x}_{3}-1 \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264378} :answer-field/id #uuid "1999c267-61b7-5858-983a-df3e642d00c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265286}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9e0a0a65-dec2-598f-90c5-c70695152a49" :question/math-academy-id "q-131715" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+2{x}_{3}=2 \\\\ {x}_{1}-3{x}_{3}=1.\\end{aligned}\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 1 & 0 & -3 & 1\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 1 & 0 & -3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 2 \\\\ 0 & 1 & -5 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -3 & 1 \\\\ 0 & 1 & -5 & -1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n{\\begin{aligned} & {x}_{1}-3{x}_{3}=1 \\\\  & {x}_{2}-5{x}_{3}=-1.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}{x}_{1}=3{x}_{3}+1 \\\\ {x}_{2}=5{x}_{3}-1 \\\\ {x}_{3}={x}_{3},\\end{aligned}\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}3{x}_{3}+1 \\\\ 5{x}_{3}-1 \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266112 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "150b8c63-cad2-507c-af99-2caf46c53ce7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5{x}_{3}-4 \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263196} {:answer/id #uuid "65da6370-1e54-53a6-8151-ac1ec3ef9e6f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5{x}_{3}+4 \\\\ 2{x}_{3}+1 \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263881} {:answer/id #uuid "b5b758ce-eb9d-5dc8-85ff-c1262d0ecfc8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4-5{x}_{3} \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264574} {:answer/id #uuid "cc2515f8-96f9-59a1-9947-de1efbe1d2e3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5{x}_{3}-4 \\\\ 2{x}_{3}-1 \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186264787} {:answer/id #uuid "e6d4c49a-347d-549e-930b-1bad5d6bd1a9" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186265011}] :answer-field/correct {:answer/id #uuid "150b8c63-cad2-507c-af99-2caf46c53ce7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5{x}_{3}-4 \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186263196} :answer-field/id #uuid "3c1fad65-c66c-5abb-b566-f399e550fab9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265356}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "175b6895-5ce4-52f4-b20c-0c4033601e3d" :question/math-academy-id "q-131717" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}{x}_{1}+3{x}_{2}+{x}_{3}=-1 \\\\ -2{x}_{1}-5{x}_{2}=3.\\end{aligned}\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 3 & 1 & -1 \\\\ -2 & -5 & 0 & 3\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 1 & -1 \\\\ -2 & -5 & 0 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 1 & -1 \\\\ 0 & 1 & 2 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}-3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -5 & -4 \\\\ 0 & 1 & 2 & 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n{\\begin{aligned} & {x}_{1}-5{x}_{3}=-4 \\\\  & {x}_{2}+2{x}_{3}=1.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}{x}_{1}=5{x}_{3}-4 \\\\ {x}_{2}=1-2{x}_{3} \\\\ {x}_{3}={x}_{3},\\end{aligned}\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}5{x}_{3}-4 \\\\ 1-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c59c60-7047-52d5-87e2-939004f4e5df" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{y}{5}-2 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300051} {:answer/id #uuid "2f11b4f8-857a-5c20-acad-ec6bae4a9637" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186300189} {:answer/id #uuid "7456e911-694c-5708-b6ea-4413295c3756" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{2}-y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300539} {:answer/id #uuid "a14ecff4-c49b-5d5d-a419-1378eddbc09c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5-y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300774} {:answer/id #uuid "aa051ba2-8988-5b2b-a5fb-1ce37c227a56" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{2}+x \\\\ x\\end{aligned}],\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300815}] :answer-field/correct {:answer/id #uuid "7456e911-694c-5708-b6ea-4413295c3756" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{2}-y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300539} :answer-field/id #uuid "ead03c74-07ea-57d9-9500-45e44f75354b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301973}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cbdb5209-5ae6-5fea-a525-87f604e2410b" :question/math-academy-id "q-32244" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2x+2y=5 \\\\  & -10x-10y=-25 \\\\  & 8x+8y=20.\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & 2 & 5 \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 2 & 5 \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & \\frac{5}{2} \\\\ -10 & -10 & -25 \\\\ 8 & 8 & 20\\end{aligned}] & {R}_{2} & :={R}_{2}+10{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & \\frac{5}{2} \\\\ 0 & 0 & 0 \\\\ 8 & 8 & 20\\end{aligned}] & {R}_{3} & :={R}_{3}+(-8){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & \\frac{5}{2} \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n{\\begin{aligned} & x+y=\\frac{5}{2}\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=\\frac{5}{2}-y \\\\ y=y,\\end{aligned}\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}\\frac{5}{2}-y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e2124c-250c-5553-90ac-ad036367a54c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ -4-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186299936} {:answer/id #uuid "1428c74d-a417-5a13-a349-88d508754aa1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ {x}_{2} \\\\ 6+{x}_{2}\\end{aligned}],\\,{x}_{2}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300041} {:answer/id #uuid "16ebfa7c-e065-59dc-ac56-9ad2d722ea9b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300054} {:answer/id #uuid "46144e61-deb2-5eb2-93d9-1c9a051af1e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ -6+{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300311} {:answer/id #uuid "ceb22f69-ba3e-510b-bac2-26a4175bcd5e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ {x}_{2} \\\\ 6-2{x}_{2}\\end{aligned}],\\,{x}_{2}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300994}] :answer-field/correct {:answer/id #uuid "16ebfa7c-e065-59dc-ac56-9ad2d722ea9b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186300054} :answer-field/id #uuid "fcaee800-c02a-5f44-8ba8-6b7bcc06692e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302033}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a1b8b6ae-30af-5f18-a21d-8dba558350b5" :question/math-academy-id "q-32517" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2{x}_{1}+2{x}_{2}+4{x}_{3}=-4 \\\\  & {x}_{2}+2{x}_{3}=-6.\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & 2 & 4 & -4 \\\\ 0 & 1 & 2 & -6\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 2 & 4 & -4 \\\\ 0 & 1 & 2 & -6\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & -2 \\\\ 0 & 1 & 2 & -6\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 4 \\\\ 0 & 1 & 2 & -6\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now   \n\n$$\n{\\begin{aligned} & {x}_{1}=4 \\\\  & {x}_{2}+2{x}_{3}=-6.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ Since we have that ${x}_{1}=4$,  we only need to find ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}{x}_{1}=4 \\\\ {x}_{2}=-6-2{x}_{3},\\end{aligned}\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}4 \\\\ -6-2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186326924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50f9b50f-35ed-5015-90a2-abcb73e7da04" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2z \\\\ 4z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324637} {:answer/id #uuid "5aacb359-a752-57ee-91e8-49aab1c366a6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2z \\\\ -3z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324720} {:answer/id #uuid "7904e155-741c-55db-ada4-37737e9bba13" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+4z \\\\ -3z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324977} {:answer/id #uuid "9a333b0e-0c9f-57ef-9a78-652e513b4226" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+4z \\\\ 1-3z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325282} {:answer/id #uuid "e2e79639-3620-552d-af88-21e978591b1b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+4z \\\\ 3z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325961}] :answer-field/correct {:answer/id #uuid "5aacb359-a752-57ee-91e8-49aab1c366a6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+2z \\\\ -3z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324720} :answer-field/id #uuid "4ff1beeb-90d1-5401-997f-ae3e61dc47dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326353}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a7ff9f1a-cb7f-5669-aa2d-6b7ae8d5b3bd" :question/math-academy-id "q-42041" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}2x-4z=2 \\\\ 4x+y-5z=4.\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & 0 & -4 & 2 \\\\ 4 & 1 & -5 & 4\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 0 & -4 & 2 \\\\ 4 & 1 & -5 & 4\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 1 \\\\ 4 & 1 & -5 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 1 \\\\ 0 & 1 & 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-2z=1 \\\\ y+3z=0.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=1+2z \\\\ y=-3z \\\\ z=z,\\end{aligned}\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1+2z \\\\ -3z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186400625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d174f1e-8230-59a5-b790-dfbaab4e9521" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186400627} {:answer/id #uuid "244aab6d-90be-578a-8092-166a36c8c9ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4y-3 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400628} {:answer/id #uuid "83dd970a-9032-5161-9210-85e901723065" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4y+3 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400629} {:answer/id #uuid "8e7e3b2b-d1a1-5446-8ee4-32636f7b1b2e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4y-3 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400630} {:answer/id #uuid "0e38c584-fc56-5df5-a079-f3072bdddfc4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3-4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400631}] :answer-field/correct {:answer/id #uuid "244aab6d-90be-578a-8092-166a36c8c9ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4y-3 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186400628} :answer-field/id #uuid "0a4567f4-6572-5d9e-8018-4068c6812f07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400626}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b0feb9ee-8e97-5292-aff6-05655689f05b" :question/math-academy-id "q-131712" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2x+8y=-6 \\\\  & -4x-16y=12 \\\\  & 6x+24y=-18.\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & 8 & -6 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 8 & -6 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & -3 \\\\ -4 & -16 & 12 \\\\ 6 & 24 & -18\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & -3 \\\\ 0 & 0 & 0 \\\\ 6 & 24 & -18\\end{aligned}] & {R}_{3} & :={R}_{3}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & -3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n{\\begin{aligned} & x+4y=-3\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=-4y-3 \\\\ y=y,\\end{aligned}\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-4y-3 \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3ccae38-2121-52d3-adbe-774101358f5f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402011} {:answer/id #uuid "bd1763ae-5fcd-5d4b-b18a-af3a643749d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8-{x}_{3} \\\\ 3+3{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402012} {:answer/id #uuid "300bc792-b634-5ba3-8561-858fdf7d8d69" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-8{x}_{3} \\\\ 6-6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402013} {:answer/id #uuid "55911223-4948-5180-95bf-96b38f95603a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-6{x}_{3} \\\\ 10+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402014} {:answer/id #uuid "e5a39045-c764-56cd-a094-6caa0b024ef0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-{x}_{3} \\\\ 6+{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402015}] :answer-field/correct {:answer/id #uuid "c3ccae38-2121-52d3-adbe-774101358f5f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402011} :answer-field/id #uuid "94d6271a-24bd-58c0-9553-83b2dc10742e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402010}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f65d67ed-b94b-50cc-87d4-9aa7130f7547" :question/math-academy-id "q-32247" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}-2{x}_{3}=4 \\\\ -2{x}_{1}-3{x}_{2}-2{x}_{3}=-2.\\end{aligned}\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -2 & 4 \\\\ 0 & 1 & -6 & 6\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 10 & -8 \\\\ 0 & 1 & -6 & 6\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n\\{\\begin{aligned} & {x}_{1}+10{x}_{3}=-8 \\\\  & {x}_{2}-6{x}_{3}=6.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n\\{\\begin{aligned}{x}_{1}=-8-10{x}_{3} \\\\ {x}_{2}=6+6{x}_{3} \\\\ {x}_{3}={x}_{3},\\end{aligned}\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186402756 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e80e6ba-d53c-56a1-8f14-814656e252d0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-z \\\\ 0 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402758} {:answer/id #uuid "240d49db-221f-5c96-a2c7-752016dd8d06" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1-z \\\\ 0 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402759} {:answer/id #uuid "c205ae90-dae6-5981-8476-c566174adf7a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-z \\\\ z-1 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402760} {:answer/id #uuid "a7eb10d8-4da4-5dab-bc8c-4a003f7cebfb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ z-1 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402761} {:answer/id #uuid "c70e171e-d942-5f58-90b7-b6fb6a232836" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ -z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402762}] :answer-field/correct {:answer/id #uuid "a7eb10d8-4da4-5dab-bc8c-4a003f7cebfb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ z-1 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402761} :answer-field/id #uuid "0fa49e40-cb09-52a9-be51-216ec3f67938" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402757}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "013e11bb-39c0-595b-a244-03847638286f" :question/math-academy-id "q-42019" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned} & x-2y+2z=2 \\\\  & y-z=-1.\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -2 & 2 & 2 \\\\ 0 & 1 & -1 & -1\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 2 & 2 \\\\ 0 & 1 & -1 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & -1 & -1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now\n\n$$\n\\{\\begin{aligned} & x=0 \\\\  & y-z=-1.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\{\\begin{aligned}x=0 \\\\ y=z-1 \\\\ z=z,\\end{aligned}\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ z-1 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186417081 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e61892-168f-50bc-9184-3087f0aa19c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+z \\\\ -z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417072} {:answer/id #uuid "59f7a4dc-26a3-51be-9f66-57bb37e63b92" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}z \\\\ 2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417073} {:answer/id #uuid "5e341f4d-4527-53f0-a549-17a212c07c94" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+z \\\\ z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417075} {:answer/id #uuid "86d4df82-dbcb-5384-b53a-8ca94675a39a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+z \\\\ 0 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417076} {:answer/id #uuid "b3937866-2599-550e-8d7d-230111af4c2c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+z \\\\ -2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417077}] :answer-field/correct {:answer/id #uuid "b3937866-2599-550e-8d7d-230111af4c2c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2+z \\\\ -2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186417077} :answer-field/id #uuid "40f01e87-54e2-5dd2-9850-20313302577b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417080}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "32425960-ceab-536a-8061-1f2469974e99" :question/math-academy-id "q-32220" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+y+z=2 \\\\  & y+2z=0.\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & 2 & 0\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & 2 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 2 \\\\ 0 & 1 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned} & x-z=2 \\\\  & y+2z=0.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=2+z \\\\ y=-2z \\\\ z=z,\\end{aligned}\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the latter can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}2+z \\\\ -2z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"}] [{:db/id #edb/ref 17592186115242 :knowledge-point/canonical-example {:db/id #edb/ref 17592186115071 :question/id #uuid "f2c7cfd3-da43-5208-bd0e-21692357fabe" :question/math-academy-id "e-4712" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned}2x-2y=1, \\\\ 4x+ky=-3\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n![](images/6f/6fa4508463b059ce8ef9a5cfa720de9463e41ecdbfb16f4460870bb6fce444bc.svg)\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -2 & 1 \\\\ 4 & k & -3\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -2 & 1 \\\\ 0 & k+4 & -5\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n![](images/21/215ff061dc7584055bf607f48d0048cb6bde4dcb1ed028fbf4c3a4bd47d89c25.svg)\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=-5,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} :knowledge-point/id #uuid "22733f71-de4a-5058-a41c-039e66e333c5" :knowledge-point/questions [{:db/id #edb/ref 17592186115753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3248af5c-24d6-51a0-a62b-8d5ab0e0e782" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300213} {:answer/id #uuid "5ed5f31b-5757-56ca-ac90-622019b8d7e7" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{4}{3}" :db/id #edb/ref 17592186300447} {:answer/id #uuid "6b3ca3f5-57b3-5b3c-b6b4-0772e9be135c" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{3}{4}" :db/id #edb/ref 17592186300503} {:answer/id #uuid "6f2681ec-b8ae-51dc-9094-2e2bcadf6d8a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300522} {:answer/id #uuid "fad186f0-c1c8-5bcc-8cc3-09b1f4f1ed49" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{4}{3}" :db/id #edb/ref 17592186301203}] :answer-field/correct {:answer/id #uuid "5ed5f31b-5757-56ca-ac90-622019b8d7e7" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{4}{3}" :db/id #edb/ref 17592186300447} :answer-field/id #uuid "9bc72922-bebc-50a1-a8ff-483d8fbfcfc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301729}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2a9a3feb-6c16-50e8-885d-ee5cd242ab95" :question/math-academy-id "q-32246" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n\\{\\begin{aligned} & 3x+4y=12 \\\\  & x+ky=4\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & 4 & 12 \\\\ 1 & k & 4\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & 4 & 12 \\\\ 1 & k & 4\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & k & 4 \\\\ 3 & 4 & 12\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & k & 4 \\\\ 0 & 4-3k & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\{\\begin{aligned} & x+ky=4 \\\\  & (4-3k)y=0.\\end{aligned}\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=\\frac{4}{3},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=4.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=\\frac{4}{3}.$"} {:db/id #edb/ref 17592186115831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359439f2-81e1-5ced-8482-b2cf08a71409" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186425939} {:answer/id #uuid "478b28da-a8a3-51e4-963d-8ac53adc010e" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186425941} {:answer/id #uuid "545c0eb7-c35a-5d44-b8e2-b045ff203715" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186425942} {:answer/id #uuid "684ddf9d-dd44-5397-b1a8-e6e3ca6a2f95" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186425943} {:answer/id #uuid "9720657d-4e06-51f7-8e91-da074201b940" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186425945}] :answer-field/correct {:answer/id #uuid "478b28da-a8a3-51e4-963d-8ac53adc010e" :answer/type {:db/ident :answer.type/math} :answer/value "k=6" :db/id #edb/ref 17592186425941} :answer-field/id #uuid "e3a07998-8f4c-5e30-bdee-b2acbf389fbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113923}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "84cf8820-fa64-5d50-9d9c-d3a9404788a4" :question/math-academy-id "q-42059" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\{\\begin{aligned} & 2x+3y=1 \\\\  & 6x+(k+3)y=-5\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 3 & 1 \\\\ 6 & k+3 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 3 & 1 \\\\ 0 & k-6 & -8\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\{\\begin{aligned}2x+3y=1 \\\\ (k-6)y=-8.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=6,$ then the second equation is $0=-8,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=6.$"} {:db/id #edb/ref 17592186266116 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "188d8234-d927-5fa4-9649-52a3600a14ed" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263232} {:answer/id #uuid "59917889-7526-5cea-90f8-6ed9b5d31888" :answer/type {:db/ident :answer.type/math} :answer/value "k=8" :db/id #edb/ref 17592186263771} {:answer/id #uuid "84ec393a-992f-55d2-9044-1e362627ed1c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264142} {:answer/id #uuid "9556b060-0b9f-5486-b05c-79753916db1d" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264279} {:answer/id #uuid "c483c739-bc7d-5f47-8dbf-09da12b3a0b2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-14" :db/id #edb/ref 17592186264722}] :answer-field/correct {:answer/id #uuid "188d8234-d927-5fa4-9649-52a3600a14ed" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263232} :answer-field/id #uuid "4c23e17f-c925-52e8-86bd-0f648e063de0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265388}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7d3ed27b-d876-58c6-8a51-55f4b36743e6" :question/math-academy-id "q-131726" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned} & -3x+2y=1 \\\\  & 6x+(k+9)y=5\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 2 & 1 \\\\ 6 & k+9 & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 2 & 1 \\\\ 0 & k+13 & 7\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned}-3x+2y=1 \\\\ (k+13)y=7.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-13,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-13.$"} {:db/id #edb/ref 17592186266117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a4e76fd-e1c6-5cbe-93b0-49387b6d03cd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-13" :db/id #edb/ref 17592186263361} {:answer/id #uuid "c2f1c78c-35e7-5dc3-a4ea-917746946f9c" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186264698} {:answer/id #uuid "cad2e0cc-59d8-5847-8c17-7f7022f7428b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186264775} {:answer/id #uuid "ddd34857-39b4-5a84-88c6-46284b56c129" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264929} {:answer/id #uuid "f74d0318-2803-55b8-bb5b-49c8150dea17" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186265163}] :answer-field/correct {:answer/id #uuid "f74d0318-2803-55b8-bb5b-49c8150dea17" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186265163} :answer-field/id #uuid "80ce296a-26b4-5d5b-bab5-71101c246341" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265471}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0e7e4e8f-70c3-5d1c-92c5-d1d6f120ba7c" :question/math-academy-id "q-131727" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned} & x-3y=-1 \\\\  & 4x+3ky=3\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & -1 \\\\ 4 & 3k & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -1 \\\\ 0 & 3k+12 & 7\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned}x-3y=-1 \\\\ (3k+12)y=7.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-4,$ then the second equation is $0=7,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-4.$"} {:db/id #edb/ref 17592186266118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e3a6e2e-1b7a-5ad1-b366-2deecae63253" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186264216} {:answer/id #uuid "96b3aa58-5c89-5f3c-896e-547bdfeef87c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264291} {:answer/id #uuid "9c0fed83-26f2-58cf-9e61-edca1345442b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186264336} {:answer/id #uuid "bedfa238-a1cb-50f4-b26d-08ac9994d923" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264662} {:answer/id #uuid "cffb3874-d3c5-58d9-9efc-875fe9730f23" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186264822}] :answer-field/correct {:answer/id #uuid "96b3aa58-5c89-5f3c-896e-547bdfeef87c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186264291} :answer-field/id #uuid "567ae966-e7d1-5296-a3f6-661d2e59d117" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265397}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5288d9bb-0110-5357-979f-882b0ee060b3" :question/math-academy-id "q-131728" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned} & -x+4y=-2 \\\\  & -3x+(3k+15)y=-4\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 4 & -2 \\\\ -3 & 3k+15 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 4 & -2 \\\\ 0 & 3k+3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned}-x+4y=-2 \\\\ (3k+3)y=2.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-1,$ then the second equation is $0=2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-1.$"} {:db/id #edb/ref 17592186266119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427da7e5-15ac-51bd-a759-d90b6c65d454" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{2}{7}" :db/id #edb/ref 17592186263588} {:answer/id #uuid "538a47b2-6a0b-5a53-99e0-b4e09df09626" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186263720} {:answer/id #uuid "7f383d71-c4b1-501b-823d-dfdddaac22d3" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{7}{2}" :db/id #edb/ref 17592186264099} {:answer/id #uuid "b60949ed-65e4-5904-90e9-755392f2794a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{7}{2}" :db/id #edb/ref 17592186264578} {:answer/id #uuid "d7266032-5cfb-59d1-b694-4b3ac335232b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264875}] :answer-field/correct {:answer/id #uuid "b60949ed-65e4-5904-90e9-755392f2794a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{7}{2}" :db/id #edb/ref 17592186264578} :answer-field/id #uuid "446ceb46-6d4a-51ab-82b3-1f055fd41555" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265373}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "49ba50cf-14b7-5be4-8660-2e096dc4c172" :question/math-academy-id "q-131729" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n{\\begin{aligned} & -2x+7y=6 \\\\  & x+ky=-3\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}-2 & 7 & 6 \\\\ 1 & k & -3\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-2 & 7 & 6 \\\\ 1 & k & -3\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & k & -3 \\\\ -2 & 7 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & k & -3 \\\\ 0 & 2k+7 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned} & x+ky=-3 \\\\  & (2k+7)y=0.\\end{aligned}\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-\\frac{7}{2},$ then the second equation is $0=0,$ which is true for any value of $y$, and we can remove this equation from the system. As a result, the system will contain only one equation, $x+ky=-3.$ \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-\\frac{7}{2}.$"} {:db/id #edb/ref 17592186266120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5280ce29-a009-5d89-b11c-32a91956f88d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186263711} {:answer/id #uuid "a8cf5fce-3112-5b03-8cf3-0d4a08494133" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186264442} {:answer/id #uuid "bac8e055-43dd-52ec-b2ee-c1af2bc589d4" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186264621} {:answer/id #uuid "bf50ed27-034a-525d-8d4e-b76acf4ead2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186264666} {:answer/id #uuid "d2c3e1a0-f525-5859-8a97-2dbc90d7ad24" :answer/type {:db/ident :answer.type/math} :answer/value "k=-12" :db/id #edb/ref 17592186264838}] :answer-field/correct {:answer/id #uuid "5280ce29-a009-5d89-b11c-32a91956f88d" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186263711} :answer-field/id #uuid "fe108dd5-5b35-596c-94e7-349c53f9ba7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265698}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "87026642-3a4d-5af1-8cd6-01d366fc76fa" :question/math-academy-id "q-131731" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n{\\begin{aligned} & -2x+6y=-4 \\\\  & 5x+(k-6)y=10\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-2 & 6 & -4 \\\\ 5 & k-6 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{5}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 6 & -4 \\\\ 0 & k+9 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n{\\begin{aligned} & -2x+6y=-4 \\\\  & (k+9)y=0.\\end{aligned}\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=-9,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $-2x+6y=-4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=-9.$"} {:db/id #edb/ref 17592186302109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eefeb35-a93a-5693-8a54-a335560cde62" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300764} {:answer/id #uuid "a14a43e5-9b21-562f-aaa1-5f805da32173" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186300773} {:answer/id #uuid "a2621a0b-e192-593d-b62d-8165fb69e7a9" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300778} {:answer/id #uuid "b3d7fb16-c926-51ed-a5b0-cbfd28c2fab5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300857} {:answer/id #uuid "f15a5a0a-88a7-5b7b-9e41-9d091c25e2a8" :answer/type {:db/ident :answer.type/math} :answer/value "k=4" :db/id #edb/ref 17592186301152}] :answer-field/correct {:answer/id #uuid "b3d7fb16-c926-51ed-a5b0-cbfd28c2fab5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300857} :answer-field/id #uuid "0c0fdc5a-0dcc-576e-afcb-e159db8dd3fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301262}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "534e2a93-e71a-5475-894e-dfd5ca99a3a6" :question/math-academy-id "q-32245" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\{\\begin{aligned} & 2x-y=3 \\\\  & 4x+ky=4\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -1 & 3 \\\\ 4 & k & 4\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -1 & 3 \\\\ 4 & k & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}2 & -1 & 3 \\\\ 0 & k+2 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\{\\begin{aligned} & 2x-y=3 \\\\  & (k+2)y=-2.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nNow if $k=-2$, then the second equation is $0=-2,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when  $k=-2.$"} {:db/id #edb/ref 17592186302143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39edf270-ef24-52e6-8a06-10a72874478d" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300241} {:answer/id #uuid "441122b0-3b95-5e4c-ad49-ebd17ab5fd1b" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186300297} {:answer/id #uuid "7951ba97-6d77-594c-84f6-7b1ce6a00426" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186300560} {:answer/id #uuid "8713309c-6e3b-5cbf-9236-a21b2e8d5efd" :answer/type {:db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186300642} {:answer/id #uuid "99ccc30d-db87-5ff3-b366-54bc530fc04c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186300734}] :answer-field/correct {:answer/id #uuid "39edf270-ef24-52e6-8a06-10a72874478d" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186300241} :answer-field/id #uuid "7a94e5ac-1c4c-5f66-9534-54809e136ec5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301608}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5f8dda9-f72e-566e-91bc-44ecdce08b8e" :question/math-academy-id "q-32331" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned}-4x-y=2 \\\\ 8x+ky=5\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}-4 & -1 & 2 \\\\ 8 & k & 5\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-4 & -1 & 2 \\\\ 8 & k & 5\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-4 & -1 & 2 \\\\ 0 & k-2 & 9\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned}-4x-y=2 \\\\ (k-2)y=9.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=2,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=2.$"} {:db/id #edb/ref 17592186344961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9a3770-af37-58af-91e7-3430fd2463b3" :answer/type {:db/ident :answer.type/math} :answer/value "k=5" :db/id #edb/ref 17592186343154} {:answer/id #uuid "71cae964-c567-5585-ab23-7241fb114732" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186343221} {:answer/id #uuid "a8f3da90-4b17-5b45-af78-2746f79a0b95" :answer/type {:db/ident :answer.type/math} :answer/value "k=1" :db/id #edb/ref 17592186343724} {:answer/id #uuid "ad97781e-f202-56a0-803a-f17ee1a49ca9" :answer/type {:db/ident :answer.type/math} :answer/value "k=9" :db/id #edb/ref 17592186343764} {:answer/id #uuid "f0d5b11f-4138-5c57-8bc8-f9f3a404cfaa" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186344356}] :answer-field/correct {:answer/id #uuid "f0d5b11f-4138-5c57-8bc8-f9f3a404cfaa" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186344356} :answer-field/id #uuid "6517af05-6089-578f-972a-9310f8010c94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344664}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a0c28bd7-70de-59aa-93c9-933cbaca4593" :question/math-academy-id "q-74646" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned} & x+4y=2 \\\\  & 2x+(k+1)y=3\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 4 & 2 \\\\ 2 & k+1 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & 2 \\\\ 0 & k-7 & -1\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned}x+4y=2 \\\\ (k-7)y=-1.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=7,$ then the second equation is $0=-1,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=7.$"} {:db/id #edb/ref 17592186344969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30949865-bcb4-5324-b20a-5013ed16ed8b" :answer/type {:db/ident :answer.type/math} :answer/value "k=-2" :db/id #edb/ref 17592186342643} {:answer/id #uuid "b02857e6-f7e6-504c-84a4-ca08044eec2c" :answer/type {:db/ident :answer.type/math} :answer/value "k=-1" :db/id #edb/ref 17592186343786} {:answer/id #uuid "bd377e49-f3f5-59d7-82a4-fcccc36aefd5" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186343902} {:answer/id #uuid "cffbe52d-faab-5e8d-a8c2-edecdb561a49" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186344066} {:answer/id #uuid "d763087a-bc9a-5f66-ac0e-8fa93b6ecd3b" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186344130}] :answer-field/correct {:answer/id #uuid "cffbe52d-faab-5e8d-a8c2-edecdb561a49" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186344066} :answer-field/id #uuid "78098d80-b356-5405-a056-ca928a0838fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344710}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bdfa86e8-f2dc-5d19-9144-98ae43ab2ede" :question/math-academy-id "q-74688" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n{\\begin{aligned} & x+2y=-4 \\\\  & 3x+2ky=-2\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -4 \\\\ 3 & 2k & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -4 \\\\ 0 & 2k-6 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n{\\begin{aligned}x+2y=-4 \\\\ (2k-6)y=10.\\end{aligned}\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=3,$ then the second equation is $0=10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=3.$"} {:db/id #edb/ref 17592186344971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba1e46b-dcb4-5f9e-b60f-f807d3ae1d2d" :answer/type {:db/ident :answer.type/math} :answer/value "k=\\frac{1}{4}" :db/id #edb/ref 17592186342339} {:answer/id #uuid "47f4259f-5c12-50a0-8a37-001fbf58b6db" :answer/type {:db/ident :answer.type/math} :answer/value "k=-\\frac{1}{4}" :db/id #edb/ref 17592186342833} {:answer/id #uuid "761008e6-93b4-567d-8e13-46b3d3b90948" :a