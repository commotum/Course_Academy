2 & 0 \\\\ 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}6 & 7 \\\\ -2 & 1\\end{aligned}],\\,D=[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186269143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28741486-369e-5706-ae1b-b725c51b2ab6" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186266505} {:answer/id #uuid "4e31dd9f-15de-59d3-94cd-966926a7e530" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186266840} {:answer/id #uuid "533fb3ba-63f1-555e-98ed-8058779ed29c" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}0 & 1 & 0 \\\\ -1 & 2 & 3 \\\\ 0 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186266889} {:answer/id #uuid "b9bdd702-b2df-5c6c-a4c2-63341c07bd3f" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186267810} {:answer/id #uuid "eadc47d2-6d03-54da-ac2e-565204378e46" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ -5 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186268237}] :answer-field/correct {:answer/id #uuid "4e31dd9f-15de-59d3-94cd-966926a7e530" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186266840} :answer-field/id #uuid "bbef8b98-e8a0-5930-88b8-fc4e670ab6d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268740}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3f081148-4183-50c8-903b-3014f5de1d45" :question/math-academy-id "q-13760" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $A$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $B$, $C$, $D$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nB=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ -5 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 1 & 0 \\\\ -1 & 2 & 3 \\\\ 0 & -3 & 0\\end{aligned}],\\,D=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}],\\,E=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186398284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2542e69d-df39-5c64-b554-6be1595617c7" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}-2 & 0 \\\\ -3 & 5\\end{aligned}]" :db/id #edb/ref 17592186398286} {:answer/id #uuid "f60fef53-a0d6-5dc0-ab21-ab9df9058607" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}3 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 0 & -5\\end{aligned}]" :db/id #edb/ref 17592186398287} {:answer/id #uuid "cae5bb2d-1f92-5e20-ba17-23b594a7c310" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}4 & 1 & 0 \\\\ -1 & 0 & 2 \\\\ 1 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186398288} {:answer/id #uuid "25367444-9d31-5d08-911d-e0197f9f8855" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}1 & -3 \\\\ 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186398289} {:answer/id #uuid "dcecc6d5-1e1c-5114-8664-36c7f108f7a5" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}0 & -2 \\\\ 7 & 2\\end{aligned}]" :db/id #edb/ref 17592186398290}] :answer-field/correct {:answer/id #uuid "25367444-9d31-5d08-911d-e0197f9f8855" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}1 & -3 \\\\ 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186398289} :answer-field/id #uuid "0957fc2a-fd8b-5808-9041-6cd8fd6371ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398285}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7c5c71ff-a77d-5a86-8573-305cd57f3d0f" :question/math-academy-id "q-126353" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $A$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}1 & -3 \\\\ 0 & 5\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $B$, $C$, $D$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nB=[\\begin{aligned}-2 & 0 \\\\ -3 & 5\\end{aligned}],\\,C=[\\begin{aligned}3 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 0 & -5\\end{aligned}],\\,D=[\\begin{aligned}0 & -2 \\\\ 7 & 2\\end{aligned}],\\,E=[\\begin{aligned}4 & 1 & 0 \\\\ -1 & 0 & 2 \\\\ 1 & 0 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186398975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d64405d0-289f-509a-b6c2-4ddc819a550c" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186398977} {:answer/id #uuid "21195042-f7c2-5911-a358-864f5699c6dd" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186398978} {:answer/id #uuid "daa40cbf-4d3b-590b-81d0-b66a0577167e" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186398979} {:answer/id #uuid "4b82a1dd-a8a6-5b78-82c9-fa1f39c4845b" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186398980} {:answer/id #uuid "7585a86b-d9f0-55bc-8e6f-efb92e7d43c2" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186398981}] :answer-field/correct {:answer/id #uuid "7585a86b-d9f0-55bc-8e6f-efb92e7d43c2" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186398981} :answer-field/id #uuid "29184956-f54b-5670-ad89-7254d448c06c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398976}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9af406e1-4ead-558e-9219-f0bb53a377fc" :question/math-academy-id "q-74316" :question/problem "Which of the following is a lower triangular matrix?" :question/worked-solution "Notice that $B$ is a matrix for which all entries *above* the diagonal are $0$'s:\n\n$$\nB=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]\n$$\n\nHence, it is a lower triangular matrix. \n\nBy contrast, matrices $A$, $C$, $D$, and $E$ each have at least one non-zero entry above the diagonal:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}],\\,C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}],\\,E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nSo, they are not lower triangular matrices."}] :knowledge-point/title "Identifying a Triangular Matrix"}]}
