y "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402776}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1a1fe1df-e314-527e-a884-f0c092b97472" :question/math-academy-id "q-42090" :question/problem "Which of the following matrices are upper triangular matrices?\n\n$A=[\\begin{aligned}8 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & -4 & 5 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 6 \\\\ 0 & -1 & 3 \\\\ 5 & 7 & 11\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 0\\end{aligned}].$" :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =5\\ne 0 \\\\ {c}_{32} & =3\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120504 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b19292e-d665-566f-8c6f-7d83c4d69c31" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186333545} {:answer/id #uuid "7039880d-285d-542d-8eed-1662170a86ab" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}1 & 0 \\\\ 2 & 3\\end{aligned}]" :db/id #edb/ref 17592186334012} {:answer/id #uuid "7de24423-58a1-5fc2-baf5-dde65d746a91" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186334113} {:answer/id #uuid "ca309238-a2b3-5c28-8c7c-56e6c410616b" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186334750} {:answer/id #uuid "fbe722d3-8558-53eb-8a6e-850293b2db44" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 0 & 4 \\\\ 0 & 4 & 2\\end{aligned}]" :db/id #edb/ref 17592186335199}] :answer-field/correct {:answer/id #uuid "3b19292e-d665-566f-8c6f-7d83c4d69c31" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186333545} :answer-field/id #uuid "96649b7c-8415-520e-af03-f8b52df45dd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335522}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "91c8b870-01b8-5cdd-a0e6-31fdbbd32f0e" :question/math-academy-id "q-68740" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $C$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nC=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $D$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 3\\end{aligned}],\\,B=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 1 & -3\\end{aligned}],\\,D=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}],\\,E=[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 0 & 4 \\\\ 0 & 4 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186262604 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c6b28e8-0add-5ad0-82cf-ac7e0be91ff4" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186260527} {:answer/id #uuid "5d2c71d6-034e-5d67-8d45-e9d7d4b82207" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186260675} {:answer/id #uuid "9dff86a0-c614-587b-9031-05a86e29c620" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186261243} {:answer/id #uuid "b8cdf86c-5203-5bdc-8872-f4b898982bb8" :answer/type {:db/ident :answer.type/text} :answer/value "$A$, $B$, and $C$" :db/id #edb/ref 17592186261496} {:answer/id #uuid "f3f33792-3b3e-5eb9-97d4-2a7df4ab6dfa" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186262007}] :answer-field/correct {:answer/id #uuid "f3f33792-3b3e-5eb9-97d4-2a7df4ab6dfa" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186262007} :answer-field/id #uuid "b3503072-c089-5678-a094-b467dddd61b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262447}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "addfb264-5013-5ace-a74a-d9286a8c951b" :question/math-academy-id "q-126351" :question/problem "Which of the following matrices are lower triangular matrices?\n\n$A=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}5 & 0 \\\\ -1 & 2\\end{aligned}],\\,C=[\\begin{aligned}1 & -2 \\\\ 0 & 5\\end{aligned}].$" :question/worked-solution "The matrices $A$ and $B$ are lower triangular matrices since all the entries above the main diagonal are zeros.\n\nThe matrix $C$ is *not* a lower triangular matrix since it has a non-zero element above the main diagonal: \n\n$$\n\\begin{aligned}{c}_{12} & =-2\\ne 0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37c4a7a7-6201-5e3d-b83c-54214a0f73f1" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186260369} {:answer/id #uuid "5cc900a1-3450-5e9d-9935-fbf3414db9ed" :answer/type {:db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}0 & -1 \\\\ 5 & 1\\end{aligned}]" :db/id #edb/ref 17592186260670} {:answer/id #uuid "89212b5f-4485-5c4a-b4e2-c1ef65585d7b" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186261068} {:answer/id #uuid "bebca5d9-6d1a-5817-b8da-7eabbdef4d81" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}4 & 0 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186261559} {:answer/id #uuid "ffcb6a99-0bd4-51ca-8095-57e4548dde55" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186262118}] :answer-field/correct {:answer/id #uuid "37c4a7a7-6201-5e3d-b83c-54214a0f73f1" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186260369} :answer-field/id #uuid "58d1ccae-7378-52fd-94ac-13da15be20dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262276}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e2e910d3-5a56-5ffe-990b-2c75157e1876" :question/math-academy-id "q-126352" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $D$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nD=[\\begin{aligned}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $C$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=[\\begin{aligned}4 & 0 \\\\ 1 & 1\\end{aligned}],\\,B=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}0 & -1 \\\\ 5 & 1\\end{aligned}],\\,E=[\\begin{aligned}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186262606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444210f3-62f9-5