type {:db/ident :answer.type/math} :answer/value "y = 7x - 18" :db/id #edb/ref 17592186099710}] :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099705}] :question/math-academy-id "q-45896" :question/problem "![](images/f0/f0dfecd9b36eed9ae7d34d783952d7a1ae48de264b78a571f841d1bc84dc501d.png)\n\nThe circle shown above has its center at $C$, and $RS^(―)$ is a diameter of the circle. What is the equation of $l$?"} {:db/id #edb/ref 17592186101497 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/math} :answer/value "y = 2x - \\frac{1}{2}" :db/id #edb/ref 17592186100144} {:answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{1}{2}x + \\frac{3}{2}" :db/id #edb/ref 17592186100145} {:answer/type {:db/ident :answer.type/math} :answer/value "y =-2x + 5" :db/id #edb/ref 17592186100146} {:answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{1}{2}x + \\frac{7}{2}" :db/id #edb/ref 17592186100147} {:answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{1}{2}x - \\frac{5}{2}" :db/id #edb/ref 17592186100148}] :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100143}] :question/math-academy-id "q-54145" :question/problem "![](images/f6/f66c9435adad329d838cefb309e08b09b9dab5b919af99b6927b70b4235e0979.png)\n\nThe line $RS^(―)$ is the diameter of the circle centered at $C(1, 3)$. The line $l$ passes through $C$ and is perpendicular to $RS^(―)$. Find the equation of the line $l$ given that the slope of $RS^(⟷)$ is $2$."}] :knowledge-point/title "Finding the Perpendicular Bisector When the Center Is Given" :topic/_knowledge-points [{:db/id #edb/ref 17592186049564 :topic/math-academy-id 1184 :topic/title "Perpendicular Bisectors of Diameters in the Coordinate Plane"}]}]}
