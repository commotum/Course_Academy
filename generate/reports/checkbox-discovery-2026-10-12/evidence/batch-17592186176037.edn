#{[{:db/id #edb/ref 17592186176037 :knowledge-point/questions [{:db/id #edb/ref 17592186176259 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "$f_{X}(x) = {\\frac{1}{10}x + \\frac{1}{5}x^{3},\\begin{vmatrix}0 \\le x \\le 2, \\\\ 0,\\end{vmatrix}otherwise$." :db/id #edb/ref 17592186173813} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{X}(x) = {x - \\frac{1}{4}x^{3},\\begin{vmatrix}0 \\le x \\le 2, \\\\ 0,\\end{vmatrix}otherwise$." :db/id #edb/ref 17592186173814} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{X}(x) = {x^{2} + \\frac{1}{4}x^{3},\\begin{vmatrix}0 \\le x \\le 2, \\\\ 0,\\end{vmatrix}otherwise$." :db/id #edb/ref 17592186173815} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{X}(x) = {\\frac{1}{10} + \\frac{1}{5}x^{3},\\begin{vmatrix}0 \\le x \\le 2, \\\\ 0,\\end{vmatrix}otherwise$." :db/id #edb/ref 17592186173816} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{X}(x) = {2x^{2} - \\frac{1}{4}x^{3},\\begin{vmatrix}0 \\le x \\le 2, \\\\ 0,\\end{vmatrix}otherwise$." :db/id #edb/ref 17592186173817}] :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173812}] :question/math-academy-id "q-110410" :question/problem "Let $X$ and $Y$ be two continuous random variables with a joint probability density function\n\n$f(x, y) = \\frac{1}{2}xy, 0 \\le x \\le y \\le 2$.\nFind the expression for the marginal PDF $f_{X}(x)$."} {:db/id #edb/ref 17592186176364 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "$f_{Y}(y) = (1)/(π(y^{2} + 1)), - ∞ < y < ∞$." :db/id #edb/ref 17592186174443} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{Y}(y) = \\frac{1}{y^{2}}, - ∞ < y < ∞$." :db/id #edb/ref 17592186174444} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{Y}(y) = (2)/(π(4y^{4} + 1)), - ∞ < y < ∞$." :db/id #edb/ref 17592186174445} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{Y}(y) = \\frac{1}{\\sqrt{π}}e^{-y^{2}}, - ∞ < y < ∞$." :db/id #edb/ref 17592186174446} {:answer/type {:db/ident :answer.type/text} :answer/value "$f_{Y}(y) = e^{-y^{2}}, - ∞ < y < ∞$." :db/id #edb/ref 17592186174447}] :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186174442}] :question/math-academy-id "q-142856" :question/problem "Let $X$ and $Y$ be two continuous random variables with a joint probability density function\n\n$f(x, y) = \\frac{1}{πx^{2}}, y^{2} + 1 \\le x$.\n\nFind the expression for the marginal PDF $f_{Y}(y)$."}] :knowledge-point/title "Finding a Marginal Distribution From a Joint Distribution: Non-Rectangular Domains" :topic/_knowledge-points [{:db/id #edb/ref 17592186049553 :topic/math-academy-id 3636 :topic/title "Marginal Distributions for Continuous Random Variables"}]}] [{:db/id #edb/ref 17592186176038 :knowledge-point/questions [{:db/id #edb/ref 17592186176286 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/math} :answer/value "Y∼N(9, 9)" :db/id #edb/ref 17592186173975} {:answer/type {:db/ident :answer.type/math} :answer/value "Y∼N(9, 70)" :db/id #edb/ref 17592186173976} {:answer/type {:db/ident :answer.type/math} :answer/value "Y∼N(9, 3)" :db/id #edb/ref 17592186173977} {:answer/type {:db/ident :answer.type/math} :answer/value "Y∼N(3, 72)" :db/id #edb/ref 17592186173978} {:answer/type {:db/ident :answer.type/math} :answer/value "Y∼N(9, 73)" :db/id #edb/ref 17592186173979}] :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173974}] :question/math-academy-id "q-114458" :question/problem "Given that the random variables\n$X_{1}∼N(3, 4), X_{2}∼N(-1, 1), X_{3}∼N(0, 3)$\nare mutually independent, what is the distribution of $Y = 2X_{1} - 3X_{2} + 4X_{3}$?\n\n> A calculator is required to answer this question."} 