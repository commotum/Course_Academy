 :db/id #edb/ref 17592186197268}] :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186197264}] :question/math-academy-id "q-222135" :question/problem "Let $A$, $B$, and $C$ be sets. Prove that\n$(A∩C)∪(B∩C)⊆(A∪B)∩C$.\n\nGiven any $x ∈ (A∩C)∪(B∩C)$, we have the following sequence of implications:\n\n$(x ∈ A∪C)∧(x ∈ B∪C)$ {{field-1}}"} {:db/id #edb/ref 17592186198923 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "the difference of sets" :db/id #edb/ref 17592186197295} {:answer/type {:db/ident :answer.type/text} :answer/value "negation" :db/id #edb/ref 17592186197296} {:answer/type {:db/ident :answer.type/text} :answer/value "the intersection of sets" :db/id #edb/ref 17592186197297} {:answer/type {:db/ident :answer.type/text} :answer/value "the set complement" :db/id #edb/ref 17592186197298} {:answer/type {:db/ident :answer.type/text} :answer/value "the union of sets" :db/id #edb/ref 17592186197299}] :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186197294} {:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "the difference of sets" :db/id #edb/ref 17592186197301} {:answer/type {:db/ident :answer.type/text} :answer/value "the intersection of sets" :db/id #edb/ref 17592186197302} {:answer/type {:db/ident :answer.type/text} :answer/value "the union of sets" :db/id #edb/ref 17592186197303} {:answer/type {:db/ident :answer.type/text} :answer/value "the set complement" :db/id #edb/ref 17592186197304} {:answer/type {:db/ident :answer.type/text} :answer/value "negation" :db/id #edb/ref 17592186197305}] :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186197300} {:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "De Morgan's law" :db/id #edb/ref 17592186197307} {:answer/type {:db/ident :answer.type/text} :answer/value "the distributive law" :db/id #edb/ref 17592186197308} {:answer/type {:db/ident :answer.type/text} :answer/value "the idempotent law" :db/id #edb/ref 17592186197309}] :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186197306}] :question/math-academy-id "q-222182" :question/problem "Consider the following statement regarding the sets $A$, $B$, and $C$.\n\n$A∩(B∪C)⊆(A∩B)∪(A∩C)$.\n\nA proof of this statement is given below.\n\n> $L1$: $x ∈ A∩(B∪C)$\n> $L2$: $⇒(x ∈ A)∧(x ∈ B∪C)$\n> $L3$: $⇒(x ∈ A)∧((x ∈ B)∨(x ∈ C))$\n> $L4$: $⇒((x ∈ A)∧(x ∈ B))∨((x ∈ A)∧(x ∈ C))$\n> $L5$: $⇒(x ∈ (A∩B))∨(x ∈ (A∩C))$\n> $L6$: $⇒x ∈ (A∩B)∪(A∩C)$\n\nSelect the correct options in the following reasoning.\n\nLine $L4$ follows from line $L3$ by {{field-1}}\n\nLine $L5$ follows from line $L4$ by the definition of {{field-2}}\n\nLine $L6$ follows from line $L5$ by the definition of {{field-3}}"}] :knowledge-point/title "Set Inclusions: Translating Between Logical and Set Operations" :topic/_knowledge-points [{:db/id #edb/ref 17592186049912 :topic/math-academy-id 4426 :topic/title "Proving Distributive Properties of Union and Intersection"}]}]}
