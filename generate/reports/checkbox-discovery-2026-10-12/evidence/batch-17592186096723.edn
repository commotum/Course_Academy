xt} :answer/value "I and II" :db/id #edb/ref 17592186093886} {:answer/type {:db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186093887} {:answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186093888} {:answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186093889}] :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093884}] :question/math-academy-id "q-11666" :question/problem "One card is picked at random from a standard $52$-card deck.\nDefine $A$ to be the event \"the selected card is an ace.\" Which of the following statements are true regarding this event?\n\n1. $P(A) = 0.08$ to $2$ decimal places\n2. $A^{′}$ is the event \"we get a king\"\n3. $P(A^{′}) = 0.98$ to $2$ decimal places"} {:db/id #edb/ref 17592186233273 :question/math-academy-id "q-119661" :question/problem "Two fair $6$-sided dice are rolled. Define $A$ to be the event \"the sum of outcomes is a prime number\" Which of the following statements are true regarding this event?\n\nI. - $P(A)=0.42$ to $2$ decimal places\nII. - ${A}^{'}$ is the event \"the sum of the outcomes is an even number\"\nIII. - $P({A}^{'})=0.58$ to $2$ decimal places"} {:db/id #edb/ref 17592186234456 :question/math-academy-id "q-84489" :question/problem "Two fair $6$-sided dice are rolled. Define $A$ to be the event \"the sum of outcomes is equal to $5.$\" Which of the following statements are true regarding this event?\n\nI. - $P(A)=0.15$ to $2$ decimal places\nII. - ${A}^{'}$ is the event \"the sum of the outcomes is less than $5$\"\nIII. - $P({A}^{'})=0.89$ to $2$ decimal places"}] :knowledge-point/title "Identifying True Statements Regarding an Event and its Complement" :topic/_knowledge-points [{:db/id #edb/ref 17592186049642 :topic/math-academy-id 1120 :topic/title "The Complement of an Event"}]}]}
