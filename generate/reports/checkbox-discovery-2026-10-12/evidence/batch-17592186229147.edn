 17592186049727 :topic/math-academy-id 6689 :topic/title "Using the Trapezoidal Method With Newton's Method"}]}] [{:db/id #edb/ref 17592186229158 :knowledge-point/questions [{:db/id #edb/ref 17592186229633 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "II, III, and IV only" :db/id #edb/ref 17592186302472} {:answer/type {:db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186302898} {:answer/type {:db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186303232} {:answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186303259} {:answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186303829}] :answer-field/correct {:answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186303259} :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304240}] :question/math-academy-id "q-332530" :question/problem "Which of the following statements are true when testing the stability of Euler's method on the test equation ${y}^{′}=-\\lambda y$ with $y=y(x),y(0)=1,x\\ge 0,\\lambda =5,$ and step size $Δx?$\n\n- The update formula can be written as ${y}_{n+1}=(1-5Δx)^{n}{y}_{n}.$\n- The method is stable for $|1-5Δx|<1.$\n- The method is stable for step size $Δx=0.2.$\n- The method is **unstable** for step size $Δx=0.25.$"} {:db/id #edb/ref 17592186229652 :question/answer-fields [{:answer-field/choices [{:answer/type {:db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186228113} {:answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186228114} {:answer/type {:db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186228115} {:answer/type {:db/ident :answer.type/text} :answer/value "II,