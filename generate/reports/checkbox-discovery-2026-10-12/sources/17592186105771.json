              },
              ":answer/value": "\\frac{1}{4}\\displaystyle \\int_{-2}^{2}(\\frac{x^{4}}{4} - 2x^{2} + 4)dx",
              ":db/id": 17592186104388
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{1}{4}\\displaystyle \\int_{-2}^{2}(\\frac{x^{4}}{4} + 2x^{2} + 4)dx",
