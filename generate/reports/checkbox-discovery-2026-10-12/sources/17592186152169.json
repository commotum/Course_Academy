      ":question/math-academy-id": "q-65109",
      ":question/problem": "Given that $y_{1}(t) = e^{-t}$ and $y_{2}(t) = te^{-t}$ are solutions to the equation $y^{\u2033} + 2y^{\u2032} + y = 0$, which of the following must also be a solution to the equation?\n\n1. $y(t) =-3te^{-t}$\n2. $y(t) = e^{-t} - te^{-t}$\n3. $y(t) = \\frac{e^{-t}}{2}$"
    },
    {
      ":db/id": 17592186152638,
      ":question/answer-fields": [
        {
          ":answer-field/choices": [
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "y=-2{t}^{3}",
              ":db/id": 17592186333404
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "y=\\frac{t+1}{{t}^{2}}",
              ":db/id": 17592186333817
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "y=\\frac{{t}^{2}-1}{3t}",
              ":db/id": 17592186334317
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "y=\\frac{t-{t}^{2}}{2}",
              ":db/id": 17592186334677
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "y=-3t+4{t}^{2}+{t}^{3}",
              ":db/id": 17592186334772
            }
          ],
          ":answer-field/correct": {
            ":answer/type": {
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "y=\\frac{t-{t}^{2}}{2}",
            ":db/id": 17592186334677
          },
          ":answer-field/key": "selection",
          ":answer-field/type": {
            ":db/ident": ":answer-field.type/radio"
          },
          ":db/id": 17592186335624
        }
