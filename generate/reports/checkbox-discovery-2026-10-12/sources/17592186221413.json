      ":question/math-academy-id": "q-333385",
      ":question/problem": "A small perturbation away from an equilibrium causes trajectories to slowly spiral away from the equilibrium. How should the equilibrium be classified?"
    },
    {
      ":db/id": 17592186308350,
      ":question/answer-fields": [
        {
          ":answer-field/choices": [
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "Solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.",
              ":db/id": 17592186305633
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "Solutions approach the equilibrium only along specific trajectories.",
              ":db/id": 17592186305672
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "Solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.",
              ":db/id": 17592186305980
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "Solutions converge to the equilibrium only if the system is linear.",
              ":db/id": 17592186306735
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "Solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$",
              ":db/id": 17592186306980
            }
          ],
          ":answer-field/correct": {
            ":answer/type": {
              ":db/ident": ":answer.type/text"
            },
            ":answer/value": "Solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$",
            ":db/id": 17592186306980
          },
          ":answer-field/key": "selection",
          ":answer-field/type": {
