      ":question/math-academy-id": "q-161230",
      ":question/problem": "$$\n{\u222c}_{D}\\boxed{}\\,\\text{d}A,\\,D={(y,z)\\,:\\,\\boxed{}\\,}\n$$\n\nThe integral above gives the surface area of the part of the surface $x={y}^{3}+{e}^{z}$ that lies inside the elliptical cylinder $\\frac{{y}^{2}}{4}+\\frac{{z}^{2}}{9}=1.$ From left to right, what are the missing expressions?"
    },
    {
      ":db/id": 17592186278511,
      ":question/answer-fields": [
        {
          ":answer-field/choices": [
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\frac{1}{xz}\\,$ and ${x}^{2}+{z}^{2}=2$",
              ":db/id": 17592186275495
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\sqrt{1+\\frac{x+z}{{x}^{4}{z}^{4}}}\\,$ and ${x}^{2}+{z}^{2}=2$",
              ":db/id": 17592186275553
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\frac{\\sqrt{{x}^{2}+{z}^{2}}}{xz}\\,$ and ${x}^{2}+{z}^{2}\\le 2$",
              ":db/id": 17592186277233
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\sqrt{1+\\frac{{x}^{2}+{z}^{2}}{{x}^{4}{z}^{4}}}\\,$ and ${x}^{2}+{z}^{2}\\le 2$",
              ":db/id": 17592186277431
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\sqrt{1+\\frac{x+z}{{x}^{2}{z}^{2}}}\\,$ and ${x}^{2}+{z}^{2}\\ge 2$",
              ":db/id": 17592186277487
            }
          ],
          ":answer-field/correct": {
            ":answer/type": {
              ":db/ident": ":answer.type/text"
            },
            ":answer/value": "$\\sqrt{1+\\frac{{x}^{2}+{z}^{2}}{{x}^{4}{z}^{4}}}\\,$ and ${x}^{2}+{z}^{2}\\le 2$",
            ":db/id": 17592186277431
          },
          ":answer-field/key": "selection",
          ":answer-field/type": {
            ":db/ident": ":answer-field.type/radio"
          },
          ":db/id": 17592186277876
        }
      ],
      ":question/math-academy-id": "q-161443",
      ":question/problem": "$$\n{\u222c}_{D}\\boxed{}\\,\\text{d}A,\\,D={(x,z)\\,:\\,\\boxed{}\\,}\n$$\n\nThe integral above gives the surface area of the part of the surface $y=\\frac{1}{xz}$ that lies inside the cylinder ${x}^{2}+{z}^{2}=2.$ From left to right, what are the missing expressions?"
    },
