              },
              ":answer/value": "$\\sqrt{1+\\frac{16(x+y)}{{x}^{2}+{z}^{2}}}\\,$ and $\\,y\\ge 2$",
              ":db/id": 17592186415895
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\sqrt{1+\\frac{16}{{x}^{2}}+\\frac{16}{{y}^{2}}}\\,$ and $\\,{x}^{2}+{z}^{2}<4$",
              ":db/id": 17592186415900
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\sqrt{1+\\frac{16}{{x}^{2}+{z}^{2}}}\\,$ and $\\,y\\le 2$",
              ":db/id": 17592186415920
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/text"
              },
              ":answer/value": "$\\sqrt{17}\\,$ and $\\,{x}^{2}+{z}^{2}\\le \\frac{1}{4}$",
              ":db/id": 17592186415926
            }
          ],
          ":answer-field/correct": {
            ":answer/type": {
              ":db/ident": ":answer.type/text"
            },
            ":answer/value": "$\\sqrt{17}\\,$ and $\\,{x}^{2}+{z}^{2}\\le \\frac{1}{4}$",
            ":db/id": 17592186415926
          },
          ":answer-field/key": "selection",
          ":answer-field/type": {
            ":db/ident": ":answer-field.type/radio"
          },
          ":db/id": 17592186415930
        }
