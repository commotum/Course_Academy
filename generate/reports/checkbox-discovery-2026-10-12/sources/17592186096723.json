      ":question/math-academy-id": "q-18764",
      ":question/problem": "The base of a solid is the region enclosed by the curve $x = \\sqrt{2 + y}$, the $y$-axis and the horizontal lines $y =-2$ and $y = 2$. Cross-sections perpendicular to the $y$-axis are squares. Calculate the volume of the solid.\n\n> A scientific calculator is required to answer this question."
    },
    {
      ":db/id": 17592186097167,
      ":question/answer-fields": [
        {
          ":answer-field/choices": [
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "-\\displaystyle \\int_{0}^{3}(9 - y^{2})dy",
              ":db/id": 17592186094976
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{1}{3}\\displaystyle \\int_{0}^{3}(9 - y^{2})dy",
              ":db/id": 17592186094977
            },
            {
