              },
              ":answer/value": "\u03c0\\displaystyle \\int_{-1}^{0}(1 + 2y + y^{2})^{2}dy",
              ":db/id": 17592186099931
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
