      ":question/math-academy-id": "q-33860",
      ":question/problem": "Consider the curve $r(t)=\u27e82t,\\,1-3t,\\,5+6t\u27e9$, $t\\ge 0$, for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=7t.$ Find $R(s),$ the parametrization of the curve by its arc length $s.$"
    },
    {
      ":db/id": 17592186120286,
      ":question/answer-fields": [
        {
          ":answer-field/choices": [
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "(s + 1)\\cos (\\ln (s + 1))",
              ":db/id": 17592186117856
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{s + 2}{2}\\cos (\\ln (\\frac{s + 2}{2}))",
              ":db/id": 17592186117857
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{2e^{s} - 1}{2}\\cos (\\ln (\\frac{2e^{s} - 1}{2}))",
              ":db/id": 17592186117858
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{2s - 1}{2}\\cos (\\ln (\\frac{2s - 1}{2}))",
