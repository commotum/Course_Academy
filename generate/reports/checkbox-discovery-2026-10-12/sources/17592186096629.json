              },
              ":answer/value": "\\frac{1}{4n}{\\sum }_{j=1}^{n}\\operatorname{ln}\u2061(1+4j)",
              ":db/id": 17592186340269
            },
            {
              ":answer/type": {
                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{4}{n}{\\sum }_{j=1}^{n}[\\operatorname{ln}\u2061(n+4j)-\\operatorname{ln}\u2061(n)]",
