\frac{6}{11}(\\mathbf{s}-\\mathbf{r}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OV} & =\\overset{\\to }{OR}+\\overset{\\to }{RV} \\\\  & =\\mathbf{r}+\\frac{6}{11}(\\mathbf{s}-\\mathbf{r}) \\\\  & =\\frac{5}{11}\\mathbf{r}+\\frac{6}{11}\\mathbf{s}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186420465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "747da426-8469-5cfb-b9c1-0f275aa12f5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{1}{4}\\mathbf{a}+\\frac{3}{4}\\mathbf{b}" :db/id #edb/ref 17592186420450} {:answer/id #uuid "7870ed39-d3a3-5476-9037-af3a46374a41" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{5}{8}\\mathbf{a}+\\frac{3}{8}\\mathbf{b}" :db/id #edb/ref 17592186420451} {:answer/id #uuid "ac24f6e2-146b-56c4-926e-7b7b203e75f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{8}\\mathbf{a}+\\frac{5}{8}\\mathbf{b}" :db/id #edb/ref 17592186420454} {:answer/id #uuid "d4a4f00d-a543-5fec-976f-fd2b59d619f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{3}{4}\\mathbf{a}+\\frac{1}{4}\\mathbf{b}" :db/id #edb/ref 17592186420458} {:answer/id #uuid "f78f9d21-45cd-5cd7-95b8-055e70bef457" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{7}{8}\\mathbf{a}+\\frac{1}{8}\\mathbf{b}" :db/id #edb/ref 17592186420461}] :answer-field/correct {:answer/id #uuid "7870ed39-d3a3-5476-9037-af3a46374a41" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OT}=\\frac{5}{8}\\mathbf{a}+\\frac{3}{8}\\mathbf{b}" :db/id #edb/ref 17592186420451} :answer-field/id #uuid "0cd7bc1d-4953-5e13-8ab6-2c158bebc612" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420462}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6fe46ce7-a162-566e-a261-116569794a12" :quest