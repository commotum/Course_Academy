f13-af31-6202e980e423" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232532}] :answer-field/correct {:answer/id #uuid "f37ef0f4-6e25-5f13-af31-6202e980e423" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186232532} :answer-field/id #uuid "a26800fe-c174-5f19-a271-3c1a5bd102ed" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232531}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "669f8ad9-dff7-5df9-8932-67ecc42dc84c" :question/math-academy-id "q-308798" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y={x}^{2}+3x$ at the point $(-1,-2).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)={x}^{2}+3x.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}+3x)=2x+3\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-2):$\n\n$$\nm={f}^{'}(-1)=2(-1)+3=-2+3=1\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{1} \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33aed63a-b507-5f47-be6d-1ea1968fc56e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186232861}] :answer-field/correct {:answer/id #uuid "33aed63a-b507-5f47-be6d-1ea1968fc56e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186232861} :answer-field/id #uuid "f3a34980-8785-53b7-9d2d-c2704de01739" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232860}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7478ba97-dd0a-53c5-98ba-0b472abb594d" :question/math-academy-id "q-342142" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y=4-3{x}^{2}$ at the point $(1,1).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=4-3{x}^{2}.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(4-3{x}^{2})=-6x\n$$\n\nThen, we compute the slope of the tangent at the point $(1,1):$\n\n$$\nm={f}^{'}(1)=-6(1)=-6\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{(-6)} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233925 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7785e0f8-d36d-58f1-b4bb-92dad6d81157" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186232863}] :answer-field/correct {:answer/id #uuid "7785e0f8-d36d-58f1-b4bb-92dad6d81157" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186232863} :answer-field/id #uuid "ed26559a-60f3-5110-9c11-8fb12d780195" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232862}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "31e569a8-362b-51d8-8186-4764daa7d587" :question/math-academy-id "q-342147" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y=\\frac{1}{4}{x}^{5}-4{x}^{2}$ at the point $(2,-8).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{1}{4}{x}^{5}-4{x}^{2}.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{4}{x}^{5}-4{x}^{2}\\right)=\\frac{5}{4}{x}^{4}-8x\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-8):$\n\n$$\nm={f}^{'}(2)=\\frac{5}{4}({2}^{4})-8(2)=20-16=4\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91f91eef-b83d-531e-8528-82c356da256b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186232865}] :answer-field/correct {:answer/id #uuid "91f91eef-b83d-531e-8528-82c356da256b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186232865} :answer-field/id #uuid "f4685f24-ff78-51cf-b109-1a2be8dffda8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232864}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ff198fc0-46a3-5bea-900f-f995439b9d1c" :question/math-academy-id "q-342152" :question/problem "Find the slope ${m}^{'}$ of the normal line to the curve $y=2{x}^{3}-\\frac{1}{{x}^{4}}$ at the point $(-1,-3).$\n\n${m}^{'}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2{x}^{3}-\\frac{1}{{x}^{4}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(2{x}^{3}-\\frac{1}{{x}^{4}}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-{x}^{-4}) \\\\  & =6{x}^{2}+4{x}^{-5} \\\\  & =6{x}^{2}+\\frac{4}{{x}^{5}}.\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-3):$\n\n$$\nm={f}^{'}(-1)=6{(-1)}^{2}+\\frac{4}{(-1)^{5}}=6-4=2\n$$\n\nTherefore, the slope ${m}^{'}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{'} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234307 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9e0de752-0812-5082-ba75-5deee887ec8c" :question/math-academy-id "q-71525" :question/problem "Find the slope of the normal line to the curve $y=2{x}^{3}-x+3$ at the point $(1,4).$" :question/worked-solution "Let $f(x)=2{x}^{3}-x+3.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-x+3)=6{x}^{2}-1\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,4):$\n\n$$\n\\begin{aligned}m={f}^{'}(1)=6(1)-1=5\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{'}$ is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$"} {:db/id #edb/ref 17592186238012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0dfaf6-4b26-5780-916c-6b6e7cc84e78" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236012} {:answer/id #uuid "a04d6a2e-4584-529d-a61d-427012951a99" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186236818} {:answer/id #uuid "d1ea2eb4-6e83-5f3b-a04e-b53fcabdb24e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186237145} {:answer/id #uuid "e1e93d2c-4a24-59ba-9508-adf45fe9d13a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186237231} {:answer/id #uuid "ebfbd345-bc08-5590-b695-612eea6c6693" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186237303}] :answer-field/correct {:answer/id #uuid "e1e93d2c-4a24-59ba-9508-adf45fe9d13a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186237231} :answer-field/id #uuid "2fea9d47-2732-52fb-98f5-f254a1901480" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237505}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "27376e81-fcda-5685-8dbf-1c9048989040" :question/math-academy-id "q-103531" :question/problem "Find the slope of the normal line to the curve $y=2\\sqrt{{x}^{3}}-2{x}^{2}$ at the point $(1,0).$" :question/worked-solution "Let $f(x)=2\\sqrt{{x}^{3}}-2{x}^{2}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{{x}^{3}}-2{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3/2}-2{x}^{2}) \\\\  & =3{x}^{1/2}-4x.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=3(1)^{1/2}-4(1)=-1\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=1.\n$$"} {:db/id #edb/ref 17592186238013 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e61460f-455d-520d-93b5-dffbbc89788f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236320} {:answer/id #uuid "69eb4aac-b14f-57bd-a480-1ab582de3ba8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186236485} {:answer/id #uuid "6f3b9c84-9c83-5f6f-86e3-c86711996c77" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186236519} {:answer/id #uuid "86d05e0e-a4ab-5588-b9b4-148c9e0ee1d5" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186236656} {:answer/id #uuid "cb23d69f-8e38-59d2-a2f7-6d29f4a5143d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186237106}] :answer-field/correct {:answer/id #uuid "cb23d69f-8e38-59d2-a2f7-6d29f4a5143d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186237106} :answer-field/id #uuid "f9fd797f-3553-5404-8639-7c51e487bdfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237766}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "64a70883-2f1e-5226-9a93-f2c233eeb60b" :question/math-academy-id "q-103532" :question/problem "Find the slope of the normal line to the curve $y={x}^{3}-4\\sqrt{{x}^{5}}$ at the point $(1,-3).$" :question/worked-solution "Let $f(x)={x}^{3}-4\\sqrt{{x}^{5}}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}-4\\sqrt{{x}^{5}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}-4{x}^{5/2}) \\\\  & =3{x}^{2}-10{x}^{3/2}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=3(1)^{2}-10(1)^{3/2}=-7\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line  ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{7}.\n$$"} {:db/id #edb/ref 17592186238019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de724df-8b1c-5535-8e44-daf76049ece3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186235891} {:answer/id #uuid "23b48bbe-ffa7-54a8-99f9-dc3950946ae0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186236047} {:answer/id #uuid "4e607467-80e3-56bc-b439-ef24f59e6ec4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186236319} {:answer/id #uuid "b66f9765-eff6-521c-bc5e-6e7d22591dfd" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186236972} {:answer/id #uuid "ce4263ad-8b05-53b5-bdc9-5ccb768cb0a7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186237125}] :answer-field/correct {:answer/id #uuid "4e607467-80e3-56bc-b439-ef24f59e6ec4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186236319} :answer-field/id #uuid "8fef744c-c73f-546c-b977-0ab52629ab8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237630}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "602176f6-b1e0-573b-b42a-73b7532c22d1" :question/math-academy-id "q-103543" :question/problem "Find the slope of the normal line to the curve $y=\\frac{2}{{x}^{5}}+7x$ at the point $(1,9).$" :question/worked-solution "Let $f(x)=\\frac{2}{{x}^{5}}+7x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{2}{{x}^{5}}+7x\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-5}+7x) \\\\  & =-10{x}^{-6}+7.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=-10(1)^{-6}+7=-3.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{3}.\n$$"} {:db/id #edb/ref 17592186317210 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67ba581c-ebc6-55ea-99ee-e980b997d941" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186315698}] :answer-field/correct {:answer/id #uuid "67ba581c-ebc6-55ea-99ee-e980b997d941" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186315698} :answer-field/id #uuid "fea3ff45-b371-5b5e-8ab3-a1c221cf4178" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317154}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2cc6d36c-e26a-5fcd-bcb0-d88e0fe39c17" :question/math-academy-id "q-342153" :question/problem "Find the slope ${m}^{′}$ of the normal line to the curve $y=4-\\frac{1}{\\sqrt{x}}$ at the point $\\left(\\frac{1}{4},2\\right).$\n\n${m}^{′}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=4-\\frac{1}{\\sqrt{x}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(4-\\frac{1}{\\sqrt{x}}\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4-{x}^{-1/2}) \\\\  & =\\frac{1}{2\\sqrt{{x}^{3}}}.\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $\\left(\\frac{1}{4},2\\right):$\n\n$$\nm={f}^{′}\\left(\\frac{1}{4}\\right)=\\frac{1}{2\\sqrt{{x}^{3}}}=\\frac{1}{2\\sqrt{{\\left(\\frac{1}{4}\\right)}^{3}}}=4\n$$\n\nTherefore, the slope ${m}^{′}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{′} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a6c80-4207-50f6-8