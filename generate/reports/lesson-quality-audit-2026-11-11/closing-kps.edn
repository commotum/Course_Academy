-1 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757077} {:answer/id #uuid "545f8ea6-7bfe-5a58-886e-65fbbbb27775" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186757079} {:answer/id #uuid "658b8a2c-57a2-550c-a275-2c3f592e7e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757082} {:answer/id #uuid "9c3e7d4e-97d9-5fef-bcc3-748682be2d13" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757089} {:answer/id #uuid "f7b40e90-e03e-5112-a42a-000484694ff2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186757101}] :answer-field/correct {:answer/id #uuid "658b8a2c-57a2-550c-a275-2c3f592e7e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757082} :answer-field/id #uuid "2cc5abb9-498e-5603-b972-ad536b455f82" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186757075}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1a9764d6-09ea-542f-b129-d656d9efc167" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ -1 & -1 & 2 & 4 \\\\ 1 & 2 & -1 & -2\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form. Select the resulting augmented matrix." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ -1 & -1 & 2 & 4 \\\\ 1 & 2 & -1 & -2\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 0 & 1 & 3 \\\\ 1 & 2 & -1 & -2\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 1 & 0 & -1\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & -1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186757085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dcd6404-1c55-5e68-91c7-88fc60ae88cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186757088} {:answer/id #uuid "a6d52fce-ad41-5dbb-a81b-3bcc6e5174f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757091} {:answer/id #uuid "af71baf4-2e72-5252-b557-3a79d2e8a981" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186757093} {:answer/id #uuid "da32653a-e802-54de-951e-754dce23f5dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757099} {:answer/id #uuid "ffbaf815-8d3f-5efb-b110-ee7a15bb7c34" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186757103}] :answer-field/correct {:answer/id #uuid "8dcd6404-1c55-5e68-91c7-88fc60ae88cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186757088} :answer-field/id #uuid "68fb02a6-0afe-5e40-b48e-cb0e09f28811" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186757083}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "888c54a1-2842-52a9-b367-b77445d65ed8" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 1 & -2 & 0 & 1 \\\\ -1 & 3 & 0 & 0\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form. Select the resulting augmented matrix." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 1 & -2 & 0 & 1 \\\\ -1 & 3 & 0 & 0\\end{array}\\right]\n$$\n\n$R_2:=R_2+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ -1 & 3 & 0 & 0\\end{array}\\right]\n$$\n\n$R_3:=R_3+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 0 & 1 & -1 \\\\ 0 & 1 & -1 & 2\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186757090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "382e0069-911e-50d5-a15b-2a3fef037f35" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-2,0\\right)" :db/id #edb/ref 17592186757076} {:answer/id #uuid "adc42256-fbc2-5dab-b6c3-14d593f7470e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(5,3,-2\\right)" :db/id #edb/ref 17592186757092} {:answer/id #uuid "ca999b1d-20a4-5615-a84d-d5f9c335be43" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(3,1,-2\\right)" :db/id #edb/ref 17592186757095} {:answer/id #uuid "d0f1aa48-fac4-5c0d-8c12-226190008f52" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4,2,0\\right)" :db/id #edb/ref 17592186757097} {:answer/id #uuid "d12eeec4-7d1c-5819-b0e6-25a9b4528cdc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-2,-2\\right)" :db/id #edb/ref 17592186757098}] :answer-field/correct {:answer/id #uuid "adc42256-fbc2-5dab-b6c3-14d593f7470e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(5,3,-2\\right)" :db/id #edb/ref 17592186757092} :answer-field/id #uuid "1eff4e64-fc18-5628-a50d-e8a668542847" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186757073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a64a32da-52bc-5a23-8ccc-41d276244ac7" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ x-y+z &=0 \\\\ x+z &=3\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 1 & -1 & 1 & 0 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]\n$$\n\n$R_2:=R_2+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 1 & 1 & 1\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=-2 \\\\ y &=1-(1)(-2) \\\\ &=3 \\\\ x &=2-(-1)(3) \\\\ &\\quad -(0)(-2) \\\\ &=5\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(5,3,-2\\right)\n$$\n\n"} {:db/id #edb/ref 17592186757102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e588afc-3992-51b0-b44e-f8e12a2d57e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-1,-4,2\\right)" :db/id #edb/ref 17592186757071} {:answer/id #uuid "20180d75-875d-5f9b-b4ba-216ca1af45b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-5,4,-2\\right)" :db/id #edb/ref 17592186757074} {:answer/id #uuid "561f86db-e1e2-5611-8412-f5d12c1acd02" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-1,-2\\right)" :db/id #edb/ref 17592186757080} {:answer/id #uuid "8d466cb3-7536-59fa-b6ed-5bc0f5ddcfa4" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-6,1,2\\right)" :db/id #edb/ref 17592186757087} {:answer/id #uuid "cca69b9b-434e-57f4-b2d4-c5a180d69182" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-5,0,2\\right)" :db/id #edb/ref 17592186757096}] :answer-field/correct {:answer/id #uuid "0e588afc-3992-51b0-b44e-f8e12a2d57e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-1,-4,2\\right)" :db/id #edb/ref 17592186757071} :answer-field/id #uuid "4c90c7b0-6f28-51f0-970c-1a1884db7716" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186757078}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f85b4885-741b-5d33-a0ae-7c13bbdc9516" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ -1 & -1 & 0 & 5 \\\\ 1 & 2 & 2 & -5\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ -1 & -1 & 0 & 5 \\\\ 1 & 2 & 2 & -5\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & 2 \\\\ 1 & 2 & 2 & -5\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 1 & 1 & -2\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=2 \\\\ y &=-2-(1)(2) \\\\ &=-4 \\\\ x &=-3-(1)(-4) \\\\ &\\quad -(1)(2) \\\\ &=-1\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(-1,-4,2\\right)\n$$\n\n"} {:db/id #edb/ref 17592186760465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6cbbf4-5d91-5928-93d0-04cb0cbb5935" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(1,-\\frac{5}{3},2\\right)" :db/id #edb/ref 17592186760464} {:answer/id #uuid "71d538c2-8847-56f7-b339-788185693f68" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(10,\\frac{4}{3},2\\right)" :db/id #edb/ref 17592186760466} {:answer/id #uuid "87c1ea42-dcda-5c3a-9aa1-0298408180e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{17}{2},\\frac{4}{3},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760467} {:answer/id #uuid "f0c55a97-aa64-5783-90fc-feb2f4d641ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8,\\frac{7}{6},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760469} {:answer/id #uuid "f1aab4ab-a652-51a8-904d-cfad99fdf6d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-\\frac{3}{2},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760470}] :answer-field/correct {:answer/id #uuid "f1aab4ab-a652-51a8-904d-cfad99fdf6d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-\\frac{3}{2},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760470} :answer-field/id #uuid "c83bcd60-4571-5cd6-a57a-e46d8a22925e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760468}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0c142b90-4f01-5d72-88af-eb2fb9332317" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-3x+9y+3z &=-12 \\\\ -x+3y+3z &=-3 \\\\ 2x-9y-z &=13\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 9 & 3 & -12 \\\\ -1 & 3 & 3 & -3 \\\\ 2 & -9 & -1 & 13\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=-\\frac{1}{3}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ -1 & 3 & 3 & -3 \\\\ 2 & -9 & -1 & 13\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 2 & -9 & -1 & 13\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & -3 & 1 & 5\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & -3 & 1 & 5 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-\\frac{1}{3}R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{5}{3} \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\nNormalize with $R_3:=\\frac{1}{2}R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{5}{3} \\\\ 0 & 0 & 1 & \\frac{1}{2}\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{5}{3} \\\\ 0 & 0 & 1 & \\frac{1}{2}\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=\\frac{1}{2} \\\\ y &=-\\frac{5}{3}-\\left(-\\frac{1}{3}\\right)\\left(\\frac{1}{2}\\right) \\\\ &=-\\frac{3}{2} \\\\ x &=4-(-3)\\left(-\\frac{3}{2}\\right) \\\\ &\\quad -(-1)\\left(\\frac{1}{2}\\right) \\\\ &=0\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(0,-\\frac{3}{2},\\frac{1}{2}\\right)\n$$\n\n"} {:db/id #edb/ref 17592186760476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d5204c-a40c-5750-84dd-492eca6ec46f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4,\\frac{1}{2},-\\frac{3}{2}\\right)" :db/id #edb/ref 17592186760471} {:answer/id #uuid "5de78fbb-869a-590c-8fd1-2df710b73ace" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{26}{3},-\\frac{11}{6},-\\frac{3}{2}\\right)" :db/id #edb/ref 17592186760472} {:answer/id #uuid "aa01e644-6b0b-5925-83f5-3ce8c1a1f063" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{3},\\frac{7}{3},1\\right)" :db/id #edb/ref 17592186760474} {:answer/id #uuid "b6a07efd-97ed-5039-b858-00030098b7fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{19}{3},-\\frac{2}{3},1\\right)" :db/id #edb/ref 17592186760475} {:answer/id #uuid "fe00b889-a680-566e-b651-401f7b8ebf14" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{7}{3},\\frac{4}{3},-\\frac{3}{2}\\right)" :db/id #edb/ref 17592186760477}] :answer-field/correct {:answer/id #uuid "aa01e644-6b0b-5925-83f5-3ce8c1a1f063" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{3},\\frac{7}{3},1\\right)" :db/id #edb/ref 17592186760474} :answer-field/id #uuid "74ff48e3-ea77-5e0d-b520-a8e8ea034f2a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760473}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c3217a82-84e6-5b88-91bd-7219d4650961" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & -6 & 0 & -15 \\\\ -3 & -6 & 2 & -13 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & -6 & 0 & -15 \\\\ -3 & -6 & 2 & -13 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=-\\frac{1}{3}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ -3 & -6 & 2 & -13 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\n$R_2:=R_2+(3)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 0 & 2 & 2 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\n$R_3:=R_3+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 0 & 2 & 2 \\\\ 0 & -3 & 4 & -3\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & -3 & 4 & -3 \\\\ 0 & 0 & 2 & 2\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-\\frac{1}{3}R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 1 & -\\frac{4}{3} & 1 \\\\ 0 & 0 & 2 & 2\\end{array}\\right]\n$$\n\nNormalize with $R_3:=\\frac{1}{2}R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 1 & -\\frac{4}{3} & 1 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 1 & -\\frac{4}{3} & 1 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=1 \\\\ y &=1-\\left(-\\frac{4}{3}\\right)(1) \\\\ &=\\frac{7}{3} \\\\ x &=5-(2)\\left(\\frac{7}{3}\\right) \\\\ &\\quad -(0)(1) \\\\ &=\\frac{1}{3}\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(\\frac{1}{3},\\frac{7}{3},1\\right)\n$$\n\n"}] :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination with Row Exchanges"}] [{:db/id #edb/ref 17592186096701 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096495 :question/id #uuid "839ed5f5-165f-5de5-aba1-551ac605475f" :question/math-academy-id "e-5212" :question/problem "Consider the picture below.\n\n![](images/f2/f2518c2e998e7c7f551548a4cc7283720a66428ea8fa9872494a81cc3848ba9e.png)\n\nGiven that $\\mathbf{c} = \\lambda  \\mathbf{a} + 2 \\mathbf{b}$, find $\\lambda.$" :question/worked-solution "Recall that when two known vectors are not parallel, a linear combination of them is unique. So, once we rewrite $\\mathbf c$ in terms of $\\mathbf a$ and $\\mathbf b,$ we can match coefficients to determine the unknown scalar.\n\nTo find $\\lambda,$ we want to match the expression\n$$\n\\mathbf{c} = \\lambda  \\mathbf{a} + 2 \\mathbf{b} .\n$$\n\nWe are given that one of the components is $2 \\mathbf{b} .$ So, we first draw the vector $2 \\mathbf{b}$ from the origin. Then we complete the path to the point $C.$\n\n![](images/ea/ea517ac4ca8e0bcf7ba48f23e66f100323d5485f1221219aacfbea9148f4a1af.png)\n\nNote that in $△ O D C$, we have:\n\n- $D C = 2 | \\mathbf{a} |$\n\n- $\\overrightarrow{D C}$ and $\\mathbf a$ have the same direction\n\nHence, $\\overrightarrow{D C} = 2 \\mathbf{a} .$\n\nAdditionally,\n$$\n\\begin{array}{cc}\\mathbf{c} &  = \\overrightarrow{O D} + \\overrightarrow{D C} \\\\  &  = 2 \\mathbf{b} + 2 \\mathbf{a} .\\end{array}\n$$\n\nConsequently, $\\mathbf{c} = \\lambda  \\mathbf{a} + 2 \\mathbf{b} = 2 \\mathbf{b} + 2 \\mathbf{a} .$\n\nSince $\\mathbf{a} \\nparallel \\mathbf{b},$ the linear combination can only be written in one way. Equating the coefficients of $\\mathbf a,$ we get:\n$$\n\\lambda=2\n$$"} :knowledge-point/id #uuid "2fbb8f19-f35a-59c4-9b77-8f6c3542ef28" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050467 :topic/difficulty 0.9028537013288132 :topic/id #uuid "4bf7862e-8b34-577f-9a7c-1f3cc4989b50" :topic/knowledge-points [{:db/id #edb/ref 17592186096647} {:db/id #edb/ref 17592186096691} {:db/id #edb/ref 17592186096794}] :topic/math-academy-id 1102 :topic/next [{:db/id #edb/ref 17592186048780}] :topic/title "Problem Solving Using Vector Diagrams"} {:db/id #edb/ref 17592186051014 :topic/id #uuid "79fb6a4f-4564-5155-81f6-db81bd65e488" :topic/knowledge-points [{:db/id #edb/ref 17592186096650} {:db/id #edb/ref 17592186096651}] :topic/math-academy-id 1105 :topic/next [{:db/id #edb/ref 17592186048780} {:db/id #edb/ref 17592186048816}] :topic/title "Linear Combinations of Vectors and Their Properties"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186735401 :question-generator/id #uuid "ea5b5494-9f85-592b-9c3a-1050054b6b40" :question-generator/script "generators/e2/e2d568c628f23475e4e510173be2ea3d163019d7d31434d1e039466c5b1f8f9d/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00092400-4bdb-54aa-b9f7-3bbc79220342" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186284786} {:answer/id #uuid "132972e0-7a7c-5c06-9851-0cd678b28702" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186284957} {:answer/id #uuid "159ed092-bb37-575a-9d11-ee33122bcff6" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186284980} {:answer/id #uuid "4c63c7e5-c9c3-51e0-9d4a-a4807711e12e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285498} {:answer/id #uuid "caceb281-75a2-5c25-ace0-e5023bde2a8c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286636}] :answer-field/correct {:answer/id #uuid "159ed092-bb37-575a-9d11-ee33122bcff6" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186284980} :answer-field/id #uuid "518cd3fd-d07a-569f-9cb4-9c2cf6e0f0c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287328}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "767cbe5b-8f45-54bf-8422-666ebc7778f1" :question/math-academy-id "q-19338" :question/problem "![](images/81/816c4ecbfe49321bc6b2bc0d72eb61d6ddd1aeae7e76a275df0975439dde5865.png)\n\nConsider the picture above. Given that $\\mathbf{c}=\\mathbf{a}+\\lambda \\mathbf{b},$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\n\\mathbf{c}=\\mathbf{a}+\\lambda \\mathbf{b}.\n$$\n\nWe are given that one of the components is $\\mathbf{a}.$ So, we begin with the vector $\\mathbf{a},$ and then find the remaining vector needed to reach the point $C.$\n\n![](images/67/6782f2fa59056afd9022edbaf69c44a991bf12a7ac6a190bea3cc08fc7a4996c.png)\n\nNote that in $△OAC,$ we have:\n\n- $AC=2.5|\\mathbf{b}|$\n\n- $\\overset{\\to }{AC}$ and $\\mathbf{b}$ have the same direction\n\nHence, $\\overset{\\to }{AC}=2.5\\mathbf{b}.$\n\nAdditionally,\n\n$$\n\\begin{aligned}\\mathbf{c} & =\\overset{\\to }{OA}+\\overset{\\to }{AC} \\\\  & =\\mathbf{a}+2.5\\mathbf{b}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{c}=\\mathbf{a}+\\lambda \\mathbf{b}=\\mathbf{a}+2.5\\mathbf{b}.$\n\nSince $\\mathbf{a}∦\\mathbf{b},$ the linear combination can only be written in one way. Equating the coefficients of $\\mathbf{b},$ we get:\n\n$$\n\\lambda =2.5\n$$"} {:db/id #edb/ref 17592186097181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc5590c-f5cf-5e21-9a2e-5e31772b304d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186285183} {:answer/id #uuid "35a20bbd-e86d-5f6e-907f-c57e5562aefc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285280} {:answer/id #uuid "531f071e-da47-5a18-876a-8d7ce3863d67" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285552} {:answer/id #uuid "80ddc038-3db7-5447-8486-3d32260a66f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186285973} {:answer/id #uuid "b9a429df-36c3-50d3-a2b3-d9bf1a44b2dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286477}] :answer-field/correct {:answer/id #uuid "b9a429df-36c3-50d3-a2b3-d9bf1a44b2dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286477} :answer-field/id #uuid "7fd9a91d-854c-5377-a157-19bd44fd94f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287416}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7a4f66a0-1cfd-52d9-be40-ea47c3b77cf3" :question/math-academy-id "q-20435" :question/problem "![](images/4b/4b7c8c679171c1dcb6ef44b33696ba2ccce87b3f690643af979476d8dfb285ce.png)\n\nConsider the picture above. Given that $\\mathbf{c}=\\lambda \\mathbf{a}+3\\mathbf{b}$, find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\n\\mathbf{c}=\\lambda \\mathbf{a}+3\\mathbf{b}.\n$$\n\nWe are given that one of the components is $3\\mathbf{b}.$ So, we first draw the vector $3\\mathbf{b}$ from the origin. Then we complete the path to the point $C.$\n\n![](images/f6/f67af4512a7ab61f862932a60dafc25ef62bc46335b7d7df323fe889f8728e6b.png)\n\nLet $P$ be the endpoint of the vector $3\\mathbf{b}.$ Then\n\n$$\n\\mathbf{c}=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=\\frac{1}{2}|\\mathbf{a}|$\n\n- $\\overset{\\to }{PC}$ and $\\mathbf{a}$ have the same direction\n\nHence, $\\overset{\\to }{PC}=\\frac{1}{2}\\mathbf{a}.$\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{c} & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =3\\mathbf{b}+\\frac{1}{2}\\mathbf{a}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{c}=\\lambda \\mathbf{a}+3\\mathbf{b}=\\frac{1}{2}\\mathbf{a}+3\\mathbf{b}.$\n\nSince $\\mathbf{a}∦\\mathbf{b},$ the linear combination can only be written in one way. Equating the coefficients of $\\mathbf{a},$ we get:\n\n$$\n\\lambda =\\frac{1}{2}\n$$"} {:db/id #edb/ref 17592186256370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f58b1f0-a1f2-5152-8b50-a3b88cfa03ea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186253806} {:answer/id #uuid "28d1e0c0-6ce0-5a30-b308-d0185860ae28" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186254035} {:answer/id #uuid "86b0f05f-4928-50e1-9fee-05c5f1c722c5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254862} {:answer/id #uuid "c1aa28fa-00bb-55da-83ba-fd94389b454c" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186255398} {:answer/id #uuid "f72b66ba-7fc3-5027-b7a4-6cc62030c64e" :answer/type {:db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186255836}] :answer-field/cor