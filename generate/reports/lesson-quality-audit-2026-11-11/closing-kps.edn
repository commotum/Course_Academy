{10}{17}(\\mathbf{z}-\\mathbf{k}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OY} & =\\overset{\\to }{OK}+\\overset{\\to }{KY} \\\\  & =\\mathbf{k}+\\frac{10}{17}(\\mathbf{z}-\\mathbf{k}) \\\\  & =\\frac{7}{17}\\mathbf{k}+\\frac{10}{17}\\mathbf{z}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e3ab9b3-b004-5c05-861c-4429d0885514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{19}" :db/id #edb/ref 17592186300519}] :answer-field/correct {:answer/id #uuid "6e3ab9b3-b004-5c05-861c-4429d0885514" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{19}" :db/id #edb/ref 17592186300519} :answer-field/id #uuid "257374bb-4fcd-535e-9b70-c67245f5a50c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301342} {:answer-field/choices [{:answer/id #uuid "7f48c4b3-d819-50a6-a9df-d19da3ae33a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{19}" :db/id #edb/ref 17592186300593}] :answer-field/correct {:answer/id #uuid "7f48c4b3-d819-50a6-a9df-d19da3ae33a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{19}" :db/id #edb/ref 17592186300593} :answer-field/id #uuid "8cc79974-795c-5c9e-b38b-d74f3b32ec5e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301672}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d044fb8e-8045-5f46-9513-7ab06e52b140" :question/math-academy-id "q-322583" :question/problem "![](images/d0/d0e71a97dc559536c25b63fda50805875d4651166a9442ae0d3d081704edebb2.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=\\mathbf{a},$ $\\overset{\\to }{OQ}=\\mathbf{q},$ and $N$ divides $\\overline{AQ}$ in the ratio $AN:NQ=12:7.$ Express $\\overset{\\to }{ON}$ via the vectors $\\mathbf{a}$ and $\\mathbf{q}.$\n\n$\\,\\overset{\\to }{ON}=$\n{{field-1}}\n$\\mathbf{a}+$\n{{field-2}}\n$\\mathbf{q}$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{ON}=\\overset{\\to }{OA}+\\overset{\\to }{AN}.\n$$\n\nWe're told that $\\overset{\\to }{OA}=\\mathbf{a},$ so we just need to work out $\\overset{\\to }{AN}.$\n\nFirst, from $△OAQ,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AQ} & =\\overset{\\to }{AO}+\\overset{\\to }{OQ} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OQ} \\\\  & =-\\mathbf{a}+\\mathbf{q} \\\\  & =\\mathbf{q}-\\mathbf{a}.\\end{aligned}\n$$\n\nSince $AN:NQ=12:7,$ we have\n\n$$\n\\overset{\\to }{AN}=\\frac{12}{19}\\overset{\\to }{AQ}=\\frac{12}{19}(\\mathbf{q}-\\mathbf{a}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{ON} & =\\overset{\\to }{OA}+\\overset{\\to }{AN} \\\\  & =\\mathbf{a}+\\frac{12}{19}(\\mathbf{q}-\\mathbf{a}) \\\\  & =\\frac{7}{19}\\mathbf{a}+\\frac{12}{19}\\mathbf{q}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302119 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111b3502-4d20-5d31-91b8-7abbeab14d76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186300030}] :answer-field/correct {:answer/id #uuid "111b3502-4d20-5d31-91b8-7abbeab14d76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{16}" :db/id #edb/ref 17592186300030} :answer-field/id #uuid "306a4818-28a4-5233-9c68-e7e860afe61d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301379} {:answer-field/choices [{:answer/id #uuid "d103b022-3392-5699-86c4-14260174eff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186301004}] :answer-field/correct {:answer/id #uuid "d103b022-3392-5699-86c4-14260174eff5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{16}" :db/id #edb/ref 17592186301004} :answer-field/id #uuid "58d2a450-3879-51ea-99f9-5107ab896718" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301520}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "11bb7f28-c383-5b5e-983f-e1f6dfaba280" :question/math-academy-id "q-322586" :question/problem "![](images/1d/1deea2da05b0d12c7e9afbb12f0340bdbfef18ff37dc49c506929028bfeb67c4.png)\n\nConsider the diagram above, where $\\overset{\\to }{OL}=\\mathbf{l},$ $\\overset{\\to }{OP}=\\mathbf{p},$ and $Q$ divides $\\overline{LP}$ in the ratio $LQ:QP=7:9.$ Express $\\overset{\\to }{OQ}$ via the vectors $\\mathbf{l}$ and $\\mathbf{p}.$\n\n$\\,\\overset{\\to }{OQ}=$\n{{field-1}}\n$\\mathbf{l}+$\n{{field-2}}\n$\\mathbf{p}$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OQ}=\\overset{\\to }{OL}+\\overset{\\to }{LQ}.\n$$\n\nWe're told that $\\overset{\\to }{OL}=\\mathbf{l},$ so we just need to work out $\\overset{\\to }{LQ}.$\n\nFirst, from $△OLP,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{LP} & =\\overset{\\to }{LO}+\\overset{\\to }{OP} \\\\  & =-\\overset{\\to }{OL}+\\overset{\\to }{OP} \\\\  & =-\\mathbf{l}+\\mathbf{p} \\\\  & =\\mathbf{p}-\\mathbf{l}.\\end{aligned}\n$$\n\nSince $LQ:QP=7:9,$ we have\n\n$$\n\\overset{\\to }{LQ}=\\frac{7}{16}\\overset{\\to }{LP}=\\frac{7}{16}(\\mathbf{p}-\\mathbf{l}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OQ} & =\\overset{\\to }{OL}+\\overset{\\to }{LQ} \\\\  & =\\mathbf{l}+\\frac{7}{16}(\\mathbf{p}-\\mathbf{l}) \\\\  & =\\frac{9}{16}\\mathbf{l}+\\frac{7}{16}\\mathbf{p}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186329678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3b19d7-9caa-5865-b36b-62dba7ca1b49" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{1}{3}\\mathbf{u}+\\frac{2}{3}\\mathbf{v}" :db/id #edb/ref 17592186327054} {:answer/id #uuid "12bc31bd-410e-5cec-b3e8-db5ec16e6668" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}\\ma