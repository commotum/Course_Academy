Therefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OT} & =\\overset{\\to }{OA}+\\overset{\\to }{AT} \\\\  & =\\mathbf{a}+\\frac{1}{5}(\\mathbf{b}-\\mathbf{a}) \\\\  & =\\frac{4}{5}\\mathbf{a}+\\frac{1}{5}\\mathbf{b}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186514835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e73221-a6f4-5620-9c46-012b24d24806" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186514818} {:answer/id #uuid "4c858e90-f5f1-4b9c-94e3-e99f862ec853" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac45" :db/id #edb/ref 17592186760533}] :answer-field/correct {:answer/id #uuid "86e73221-a6f4-5620-9c46-012b24d24806" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186514818} :answer-field/id #uuid "06d523c6-312f-5ce1-95b9-b6d8f66784c3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514794} {:answer-field/choices [{:answer/id #uuid "13ecae95-71ad-598a-9e73-220641eedb2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186514796} {:answer/id #uuid "e5f5bd08-d4c2-41b1-98c5-d9628ca4829b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac15" :db/id #edb/ref 17592186760534}] :answer-field/correct {:answer/id #uuid "13ecae95-71ad-598a-9e73-220641eedb2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186514796} :answer-field/id #uuid "1564da73-5bc7-57e9-ad9e-cda791ab21dc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186514797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d4565f3d-ff68-5439-9aff-8354449ece8b" :question/problem "![](images/fe/fe6706b73465189953747609b4361117a28e88a566f0693dcef884ba70a4f5cb.png)\n\nConsider the diagram above, where $\\overset{\\to }{OA}=\\mathbf{a},$ $\\o