}{OV} \\\\  & =-\\mathbf{u}+\\mathbf{v} \\\\  & =\\mathbf{v}-\\mathbf{u}.\\end{aligned}\n$$\n\nSince $UW:WV=2:7,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{2}{9}\\overset{\\to }{UV}=\\frac{2}{9}(\\mathbf{v}-\\mathbf{u}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =\\mathbf{u}+\\frac{2}{9}(\\mathbf{v}-\\mathbf{u}) \\\\  & =\\frac{7}{9}\\mathbf{u}+\\frac{2}{9}\\mathbf{v}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a4ecfa-47e2-56f4-a423-468e55f93529" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{2}\\mathbf{h}+\\frac{1}{2}\\mathbf{i}" :db/id #edb/ref 17592186387003} {:answer/id #uuid "e23408c0-6a35-5afe-abe2-00bbdaf4622a" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{4}\\mathbf{h}+\\frac{1}{4}\\mathbf{i}" :db/id #edb/ref 17592186387004} {:answer/id #uuid "a498dbcf-0f77-508b-9c07-efe06b97d9ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{5}{8}\\mathbf{h}+\\frac{3}{8}\\mathbf{i}" :db/id #edb/ref 17592186387005} {:answer/id #uuid "748b1bc5-d773-5fa4-a285-111048597c9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{8}\\mathbf{h}+\\frac{3}{4}\\mathbf{i}" :db/id #edb/ref 17592186387006} {:answer/id #uuid "86f8cb36-0676-5c61-8d2f-37ebe1006578" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{8}\\mathbf{h}+\\frac{5}{8}\\mathbf{i}" :db/id #edb/ref 17592186387007}] :answer-field/correct {:answer/id #uuid "86f8cb36-0676-5c61-8d2f-37ebe1006578" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{8}\\mathbf{h}+\\frac{5}{8}\\mathbf{i}" :db/id #edb/ref 17592186387007} :answer-field/id #uuid "3c4f4208-0c8e-57ef-ad8c-1decee05823d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387002}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c0b691a2-9da7-5f9d-b601-8f5daf61f352" :question/math-academy-id "q-120304" :question/problem "![](images/65/6560a7f05ae95638cbfe902dfa022b2d8de6b07c6e1e6f85051ccf87b92ec338.png)\n\nConsider the diagram above, where $\\overset{\\to }{OH}=\\mathbf{h},$ $\\overset{\\to }{OI}=\\mathbf{i}$ and $J$ divides $\\overline{HI}$ in the ratio $HJ:JI=5:3.$ Find $\\overset{\\to }{OJ}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OJ}=\\overset{\\to }{OH}+\\overset{\\to }{HJ}.\n$$\n\nWe're told that $\\overset{\\to }{OH}=\\mathbf{h},$ so we just need to work out $\\overset{\\to }{HJ}.$\n\nFirst, from $△OHI,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HI} & =\\overset{\\to }{HO}+\\overset{\\to }{OI} \\\\  & =-\\overset{\\to }{OH}+\\overset{\\to }{OI} \\\\  & =-\\mathbf{h}+\\mathbf{i} \\\\  & =\\mathbf{i}-\\mathbf{h}.\\end{aligned}\n$$\n\nSince $HJ:JI=5:3,$ we have\n\n$$\n\\overset{\\to }{HJ}=\\frac{5}{8}\\overset{\\to }{HI}=\\frac{5}{8}(\\mathbf{i}-\\mathbf{h}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OJ} & =\\overset{\\to }{OH}+\\overset{\\to }{HJ} \\\\  & =\\mathbf{h}+\\frac{5}{8}(\\mathbf{i}-\\mathbf{h}) \\\\  & =\\frac{3}{8}\\mathbf{h}+\\frac{5}{8}\\mathbf{i}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186390558 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c08254-bcec-5457-b88b-bb1b31577752" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{6}\\mathbf{r}+\\frac{1}{6}\\mathbf{s}" :db/id #edb/ref 17592186390560} {:answer/id #uuid "86737275-5bda-5fe0-92b5-103129881f25" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{6}{11}\\mathbf{r}+\\frac{5}{11}\\mathbf{s}" :db/id #edb/ref 17592186390561} {:answer/id #uuid "361d2b59-2e0b-5aa1-b524-15d353a4c2a5" :answer/type {:db/ident :answer.type/math} :