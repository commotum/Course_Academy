b/ref 17592186336186} {:answer/id #uuid "8afbf511-93b1-574c-aea0-f719ed534072" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186337288} {:answer/id #uuid "9b55a9ee-2b2e-5710-b96a-5529ce814f84" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337440} {:answer/id #uuid "b83a05a7-995d-5078-bf9a-4b58abb10a90" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186337665} {:answer/id #uuid "e2cfabde-266f-53a5-a5bf-2a8c9659561a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186338007}] :answer-field/correct {:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} :answer-field/id #uuid "fb39a159-1af8-51a3-9955-b31d00f03bbf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338721}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0b93f0c3-f4cf-5391-8374-d4b6970c54ae" :question/math-academy-id "q-71524" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}-5$ at the point $(2,-1).$" :question/worked-solution "Let $f(x)={x}^{2}-5.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-5)=2x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-1):$\n\n$$\n\\begin{aligned}m={f}^{′}(2)=2(2)=4\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{4}.\n$$"} {:db/id #edb/ref 17592186524012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a4af37e-6b2f-57b0-a6f0-ff63aa93a160" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186523376} {:answer/id #uuid "3b6dcd76-9c75-5cab-a7e3-98ec9a075e7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186523378} {:answer/id #uuid "8e9d1766-796c-5f7e-b81b-0f2e720704a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186523551} {:answer/id #uuid "f09476ea-f87a-5f66-921f-9f3fefea5c34" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186523757} {:answer/id #uuid "fbd47810-d0f2-5cff-a8e5-e4945ca20335" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186523781}] :answer-field/correct {:answer/id #uuid "8e9d1766-796c-5f7e-b81b-0f2e720704a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186523551} :answer-field/id #uuid "7c700890-f7ec-5058-9334-5a60b70722d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523850}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ccfa4d84-7836-5556-9446-f447928d0c91" :question/math-academy-id "q-103539" :question/problem "Find the slope of the normal line to the curve $y=\\frac{1}{4{x}^{2}}+\\frac{x}{2}$ at the point $\\left(-\\frac{1}{2},\\frac{3}{4}\\right).$" :question/worked-solution "Let $f(x)=\\frac{1}{4{x}^{2}}+\\frac{x}{2}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{4{x}^{2}}+\\frac{x}{2}\\right) \\\\  & =-\\frac{1}{2}{x}^{-3}+\\frac{1}{2}.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}\\left(-\\frac{1}{2}\\right),$ which gives\n\n$$\n\\begin{aligned}{f}^{′}\\left(-\\frac{1}{2}\\right)=-\\frac{1}{2}\\cdot {\\left(-\\frac{1}{2}\\right)}^{-3}+\\frac{1}{2}=\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{2}{9}.\n$$"} {:db/id #edb/ref 17592186524021 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c886c0-75b9-56f6-8629-ffc88d7f38eb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186523425} {:answer/id #uuid "7676dc7b-ce9f-5ee4-b0f0-1d0b1d1ad93a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186523496} {:answer/id #uuid "9992b9e3-55cb-534c-8fd0-21fbd64e8078" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186523573} {:answer/id #uuid "d57dc05b-2779-515b-aecf-82edefe5f6a7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186523702} {:answer/id #uuid "f442a990-1c89-5b31-9a80-2c9fda10deea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186523763}] :answer-field/correct {:answer/id #uuid "7676dc7b-ce9f-5ee4-b0f0-1d0b1d1ad93a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186523496} :answer-field/id #uuid "fa8e2a76-bef8-546c-bf0c-5ea711bff307" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523917}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e108591f-1dbb-58f4-aca2-6f29ab0389ab" :question/math-academy-id "q-71526" :question/problem "Find the slope of the normal line to the curve $y=2{x}^{3}-7x$ at the point $(-1,5).$" :question/worked-solution "Let $f(x)=2{x}^{3}-7x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-7x)=6{x}^{2}-7\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,5):$\n\n$$\n\\begin{aligned}m={f}^{′}(-1)=6(-1)^{2}-7=-1\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(-1)}=1.\n$$"} {:db/id #edb/ref 17592186710692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0f9a14-e0cb-55fa-971a-08e33d7ad976" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186710693} {:answer/id #uuid "94eca3fc-ae43-5ca3-b806-dad759ed9995" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186710700} {:answer/id #uuid "a2565dc8-3877-5798-9f0a-7a20e48eec4e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186710701} {:answer/id #uuid "a6a01cfa-532a-58cc-bf13-3d9bc4fe5be4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186710702} {:answer/id #uuid "c67b0b94-c705-5bb1-846a-3c68755c080e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186710703}] :answer-field/correct {:answer/id #uuid "94eca3fc-ae43-5ca3-b806-dad759ed9995" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186710700} :answer-field/id #uuid "e63039b4-efb2-5ec3-b9cd-123073b36c16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710704}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1029b6ff-8883-5073-891f-983a0a0dd842" :question/problem "Find the slope of the normal line to the curve $y=x^2-5x+1$ at the point $(1,-3)$." :question/worked-solution "Let $f(x)=x^2-5x+1$. First, compute the derivative:\n\n$$\nf'(x)=2x-5.\n$$\n\nThe slope of the tangent at $(1,-3)$ is\n\n$$\nm=f'(1)=2(1)-5=-3.\n$$\n\nThe normal is perpendicular to the tangent, so its slope is the negative reciprocal:\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{-3}=\\frac{1}{3}.\n$$\n\nThe diagram shows the tangent and the dashed normal meeting at the given point.\n\n![The curve with its tangent and dashed normal at P.](images/bb/bb940c649033bddbbc6d8c3d96c73fc66c62fc4664481dabfeeb7a63daa872d4.png)"} {:db/id #edb/ref 17592186710695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ede11da-1365-53da-a4f1-25d88e85ab1f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{39}" :db/id #edb/ref 17592186710696}] :answer-field/correct {:answer/id #uuid "4ede11da-1365-53da-a4f1-25d88e85ab1f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{39}" :db/id #edb/ref 17592186710696} :answer-field/id #uuid "5c52d80b-cda4-56b7-b24f-b8483b38851d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710697}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "41907510-4e56-5323-b592-bd080fe7b53e" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=\\frac{(x-1)^2}{\\sqrt{x}},\\qquad x>0,\n$$\n\nat the point $\\left(4,\\frac{9}{2}\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\dfrac{(x-1)^2}{\\sqrt{x}}$. Expand the numerator and divide each term by $x^{1/2}$:\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{x^2-2x+1}{x^{1/2}}\\\\\n&=x^{3/2}-2x^{1/2}+x^{-1/2}.\n\\end{aligned}\n$$\n\nApply the power rule to all three terms:\n\n$$\nf'(x)=\\frac{3}{2}x^{1/2}-x^{-1/2}-\\frac{1}{2}x^{-3/2}.\n$$\n\nThe slope of the tangent at $\\left(4,\\frac{9}{2}\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(4)&=\\frac{3}{2}\\sqrt{4}-\\frac{1}{\\sqrt{4}}-\\frac{1}{2(4)^{3/2}}\\\\\n&=3-\\frac{1}{2}-\\frac{1}{16}\\\\\n&=\\frac{39}{16}.\n\\end{aligned}\n$$\n\nThe normal has the negative reciprocal slope:\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{39/16}=-\\frac{16}{39}.\n$$"} {:db/id #edb/ref 17592186710698 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c5d459e-fc67-5800-9475-effc23a28a9a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186710694}] :answer-field/correct {:answer/id #uuid "3c5d459e-fc67-5800-9475-effc23a28a9a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186710694} :answer-field/id #uuid "699f3137-302f-535e-9a25-2d62b72d6d63" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710699}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "62821c03-5ce7-5c40-8dad-648f01cba324" :question/problem "Find the slope $m'$ of the normal line to the curve $y=(x+1)(x^2-2x)$ at the point $(2,0)$.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=(x+1)(x^2-2x)$. Expand before differentiating:\n\n$$\n\\begin{aligned}\nf(x)&=x^3-2x^2+x^2-2x\\\\\n&=x^3-x^2-2x.\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^2-2x-2.\n$$\n\nThe slope of the tangent at $(2,0)$ is\n\n$$\nm=f'(2)=3(2)^2-2(2)-2=12-4-2=6.\n$$\n\nThe normal is perpendicular to the tangent. Therefore,\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{6}.\n$$"} {:db/id #edb/ref 17592186710928 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "887d9d0b-a070-5758-800a-491a7fc379b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186710938} {:answer/id #uuid "3d514e71-bd7c-4ef2-9ca8-91034d24e007" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6x}" :db/id #edb/ref 17592186760392}] :answer-field/correct {:answer/id #uuid "887d9d0b-a070-5758-800a-491a7fc379b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186710938} :answer-field/id #uuid "f1e7d706-7ec4-5336-a848-2786deb7472a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710942}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "189f6de7-6cdc-55b9-82f9-8c9a94482be0" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=3x^{2}\n$$\n\nat the point $\\left(-2,12\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=3x^{2}$.\n\nApply the power rule:\n\n$$\nf'(x)=6x\n$$\n\nThe tangent slope at $\\left(-2,12\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-2)&=6\\left(-2\\right)\\\\\n&=-12\\\\\n&=-12\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-12\\right)}\\\\\n&=\\frac{1}{12}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bc851da-6370-5083-9183-d4e9a53b4abf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186710935}] :answer-field/correct {:answer/id #uuid "6bc851da-6370-5083-9183-d4e9a53b4abf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186710935} :answer-field/id #uuid "904a35f2-0b11-5bdc-b371-366dda504f84" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710939}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "24f2d725-a991-56e8-97f8-433f79882c73" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=x^{2}-x+2\n$$\n\nat the point $\\left(2,4\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=x^{2}-x+2$.\n\nApply the power rule:\n\n$$\nf'(x)=2x-1\n$$\n\nThe tangent slope at $\\left(2,4\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(2)&=2\\left(2\\right)-1\\\\\n&=4-1\\\\\n&=3\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(3\\right)}\\\\\n&=-\\frac{1}{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710931 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c314992-062b-5890-955c-6d425dbd55c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186710930}] :answer-field/correct {:answer/id #uuid "3c314992-062b-5890-955c-6d425dbd55c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186710930} :answer-field/id #uuid "6c42c69f-56c2-546a-a501-4919ce7b8cc9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710936}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "49112d0c-3d7c-525f-9985-5e6477ab4831" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=2x^{2}+4x\n$$\n\nat the point $\\left(-2,0\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=2x^{2}+4x$.\n\nApply the power rule:\n\n$$\nf'(x)=4x+4\n$$\n\nThe tangent slope at $\\left(-2,0\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-2)&=4\\left(-2\\right)+4\\\\\n&=-8+4\\\\\n&=-4\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-4\\right)}\\\\\n&=\\frac{1}{4}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bcdb7be-aac3-5270-8a55-f400c665daea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186710937}] :answer-field/correct {:answer/id #uuid "7bcdb7be-aac3-5270-8a55-f400c665daea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186710937} :answer-field/id #uuid "56e75578-ce23-573f-89a0-df585996e8b7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710933}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b9563ef-5cbb-5c4b-94e8-911e07e06551" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=-3x^{2}-3x-1\n$$\n\nat the point $\\left(1,-7\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=-3x^{2}-3x-1$.\n\nApply the power rule:\n\n$$\nf'(x)=-6x-3\n$$\n\nThe tangent slope at $\\left(1,-7\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(1)&=-6\\left(1\\right)-3\\\\\n&=-6-3\\\\\n&=-9\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-9\\right)}\\\\\n&=\\frac{1}{9}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6903a7c7-2ab4-5b23-a072-26c2e30b900f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186710934}] :answer-field/correct {:answer/id #uuid "6903a7c7-2ab4-5b23-a072-26c2e30b900f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}" :db/id #edb/ref 17592186710934} :answer-field/id #uuid "985c8402-6ac9-5095-b6b1-c6392b50d1ad" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710940}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b614ee37-cd64-5dd4-a877-92acf81cc12b" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=x^{2}+5x+1\n$$\n\nat the point $\\left(1,7\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=x^{2}+5x+1$.\n\nApply the power rule:\n\n$$\nf'(x)=2x+5\n$$\n\nThe tangent slope at $\\left(1,7\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(1)&=2\\left(1\\right)+5\\\\\n&=2+5\\\\\n&=7\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(7\\right)}\\\\\n&=-\\frac{1}{7}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710944 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ed80582-ba8a-5f2b-a20c-6b7c23fd959e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{55}" :db/id #edb/ref 17592186710949}] :answer-field/correct {:answer/id #uuid "6ed80582-ba8a-5f2b-a20c-6b7c23fd959e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{55}" :db/id #edb/ref 17592186710949} :answer-field/id #uuid "7b608208-a9f7-5e42-af2d-6573b72464e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710950}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "13b562cc-e2c6-5d87-b19a-0abf685228cd" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=-\\frac{(x+1)^2}{\\sqrt{x}},\\qquad x>0\n$$\n\nat the point $\\left(4,-\\frac{25}{2}\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=-\\frac{(x+1)^2}{\\sqrt{x}}$. Expand the numerator and divide each term by $x^{1/2}$.\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{-x^{2}-2x-1}{x^{1/2}}\\\\\n&=-x^{\\frac{3}{2}}-2x^{\\frac{1}{2}}-x^{-\\frac{1}{2}}\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=-\\frac{3}{2}x^{\\frac{1}{2}}-x^{-\\frac{1}{2}}+\\frac{1}{2}x^{-\\frac{3}{2}}\n$$\n\nThe tangent slope at $\\left(4,-\\frac{25}{2}\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(4)&=-\\frac{3}{2}\\left(4\\right)^{\\frac{1}{2}}-\\left(4\\right)^{-\\frac{1}{2}}+\\frac{1}{2}\\left(4\\right)^{-\\frac{3}{2}}\\\\\n&=-3-\\frac{1}{2}+\\frac{1}{16}\\\\\n&=-\\frac{55}{16}\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-\\frac{55}{16}\\right)}\\\\\n&=\\frac{16}{55}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0c41fff-6dd6-5636-ae22-a23f175263e5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186710952} {:answer/id #uuid "cb8f86e3-b9d7-453c-8427-64615f8e6657" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{14+2\\sqrt3}{46}" :db/id #edb/ref 17592186760397}] :answer-field/correct {:answer/id #uuid "b0c41fff-6dd6-5636-ae22-a23f175263e5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186710952} :answer-field/id #uuid "d1627a85-1cc6-582e-8c15-1971b8792a1a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710955}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1b487f77-15da-5b78-b3ec-52fe09ab20aa" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=\\frac{(x-3)^2}{\\sqrt{x}},\\qquad x>0\n$$\n\nat the point $\\left(9,12\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{(x-3)^2}{\\sqrt{x}}$. Expand the numerator and divide each term by $x^{1/2}$.\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{x^{2}-6x+9}{x^{1/2}}\\\\\n&=x^{\\frac{3}{2}}-6x^{\\frac{1}{2}}+9x^{-\\frac{1}{2}}\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=\\frac{3}{2}x^{\\frac{1}{2}}-3x^{-\\frac{1}{2}}-\\frac{9}{2}x^{-\\frac{3}{2}}\n$$\n\nThe tangent slope at $\\left(9,12\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(9)&=\\frac{3}{2}\\left(9\\right)^{\\frac{1}{2}}-3\\left(9\\right)^{-\\frac{1}{2}}-\\frac{9}{2}\\left(9\\right)^{-\\frac{3}{2}}\\\\\n&=\\frac{9}{2}-1-\\frac{1}{6}\\\\\n&=\\frac{10}{3}\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(\\frac{10}{3}\\right)}\\\\\n&=-\\frac{3}{10}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2340e802-e6e0-588a-8a1b-6d34e4e65862" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186710946}] :answer-field/correct {:answer/id #uuid "2340e802-e6e0-588a-8a1b-6d34e4e65862" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186710946} :answer-field/id #uuid "45932cc5-5994-5471-b9ce-40bb399d9425" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710948}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bbcc2c19-ad0a-5a30-bf14-1b8dab59e864" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=\\frac{(x-2)^2}{\\sqrt{x}},\\qquad x>0\n$$\n\nat the point $\\left(4,2\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{(x-2)^2}{\\sqrt{x}}$. Expand the numerator and divide each term by $x^{1/2}$.\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{x^{2}-4x+4}{x^{1/2}}\\\\\n&=x^{\\frac{3}{2}}-4x^{\\frac{1}{2}}+4x^{-\\frac{1}{2}}\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=\\frac{3}{2}x^{\\frac{1}{2}}-2x^{-\\frac{1}{2}}-2x^{-\\frac{3}{2}}\n$$\n\nThe tangent slope at $\\left(4,2\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(4)&=\\frac{3}{2}\\left(4\\right)^{\\frac{1}{2}}-2\\left(4\\right)^{-\\frac{1}{2}}-2\\left(4\\right)^{-\\frac{3}{2}}\\\\\n&=3-1-\\frac{1}{4}\\\\\n&=\\frac{7}{4}\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(\\frac{7}{4}\\right)}\\\\\n&=-\\frac{4}{7}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4948445-996b-52ec-af10-99e8ae46667b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{54}{275}" :db/id #edb/ref 17592186710951}] :answer-field/correct {:answer/id #uuid "a4948445-996b-52ec-af10-99e8ae46667b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{54}{275}" :db/id #edb/ref 17592186710951} :answer-field/id #uuid "424bd42b-f667-5dd3-a87e-814553941f00" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710947}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c2bfa780-9936-5b1d-9e9b-31c2913c438d" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=\\frac{(x+2)^2}{\\sqrt{x}},\\qquad x>0\n$$\n\nat the point $\\left(9,\\frac{121}{3}\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=\\frac{(x+2)^2}{\\sqrt{x}}$. Expand the numerator and divide each term by $x^{1/2}$.\n\n$$\n\\begin{aligned}\nf(x)&=\\frac{x^{2}+4x+4}{x^{1/2}}\\\\\n&=x^{\\frac{3}{2}}+4x^{\\frac{1}{2}}+4x^{-\\frac{1}{2}}\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=\\frac{3}{2}x^{\\frac{1}{2}}+2x^{-\\frac{1}{2}}-2x^{-\\frac{3}{2}}\n$$\n\nThe tangent slope at $\\left(9,\\frac{121}{3}\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(9)&=\\frac{3}{2}\\left(9\\right)^{\\frac{1}{2}}+2\\left(9\\right)^{-\\frac{1}{2}}-2\\left(9\\right)^{-\\frac{3}{2}}\\\\\n&=\\frac{9}{2}+\\frac{2}{3}-\\frac{2}{27}\\\\\n&=\\frac{275}{54}\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(\\frac{275}{54}\\right)}\\\\\n&=-\\frac{54}{275}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1e857e-fa9c-547e-9986-65d580e9e1f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186710956}] :answer-field/correct {:answer/id #uuid "0d1e857e-fa9c-547e-9986-65d580e9e1f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186710956} :answer-field/id #uuid "faae9f6c-dd6e-5f95-b876-4badfc619def" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710967}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "21b31e91-7538-5cc3-90e2-12eb2f4f2d4c" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x+3)(x^{2}+x)\n$$\n\nat the point $\\left(-1,0\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=(x+3)(x^{2}+x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}+x^{2}+3x^{2}+3x\\\\\n&=x^{3}+4x^{2}+3x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}+8x+3\n$$\n\nThe tangent slope at $\\left(-1,0\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-1)&=3\\left(-1\\right)^{2}+8\\left(-1\\right)+3\\\\\n&=3-8+3\\\\\n&=-2\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-2\\right)}\\\\\n&=\\frac{1}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710960 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd2ce276-042e-576e-874b-b398f8c7af88" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186710965}] :answer-field/correct {:answer/id #uuid "cd2ce276-042e-576e-874b-b398f8c7af88" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}" :db/id #edb/ref 17592186710965} :answer-field/id #uuid "7479c0dd-fde8-5f16-a231-35d74d856bee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710961}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6acc9a6b-1408-5ff3-88af-47a8f8d86ef3" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x-2)(x^{2}+x)\n$$\n\nat the point $\\left(-2,-8\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=(x-2)(x^{2}+x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}+x^{2}-2x^{2}-2x\\\\\n&=x^{3}-x^{2}-2x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}-2x-2\n$$\n\nThe tangent slope at $\\left(-2,-8\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-2)&=3\\left(-2\\right)^{2}-2\\left(-2\\right)-2\\\\\n&=12+4-2\\\\\n&=14\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(14\\right)}\\\\\n&=-\\frac{1}{14}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4684235a-039e-55e0-a551-2d96b395ba1a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186710959} {:answer/id #uuid "c48ab8d5-24fa-4b52-8349-32f89029e2a5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac12" :db/id #edb/ref 17592186760401}] :answer-field/correct {:answer/id #uuid "4684235a-039e-55e0-a551-2d96b395ba1a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186710959} :answer-field/id #uuid "31315585-aaf4-5656-ac0b-c11d323fd370" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710958}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b303525d-fa10-553d-bfb9-c9d415e56059" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x+1)(x^{2}+2x)\n$$\n\nat the point $\\left(-2,0\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=(x+1)(x^{2}+2x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}+2x^{2}+x^{2}+2x\\\\\n&=x^{3}+3x^{2}+2x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}+6x+2\n$$\n\nThe tangent slope at $\\left(-2,0\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-2)&=3\\left(-2\\right)^{2}+6\\left(-2\\right)+2\\\\\n&=12-12+2\\\\\n&=2\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(2\\right)}\\\\\n&=-\\frac{1}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186710964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d59fcf47-af54-571d-93e8-31b1baefde00" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186710966} {:answer/id #uuid "40c93d4d-5e53-4735-9a43-3d944a65f7dc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac18" :db/id #edb/ref 17592186760404}] :answer-field/correct {:answer/id #uuid "d59fcf47-af54-571d-93e8-31b1baefde00" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186710966} :answer-field/id #uuid "965af6c2-93c4-51e9-b54a-ffd415552d5c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710962}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bb66e871-f275-5437-9e35-67e011b9fc64" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x+2)(x^{2}-2x)\n$$\n\nat the point $\\left(2,0\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}" :question/worked-solution "Let $f(x)=(x+2)(x^{2}-2x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}-2x^{2}+2x^{2}-4x\\\\\n&=x^{3}-4x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}-4\n$$\n\nThe tangent slope at $\\left(2,0\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(2)&=3\\left(2\\right)^{2}-4\\\\\n&=12-4\\\\\n&=8\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(8\\right)}\\\\\n&=-\\frac{1}{8}\n\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] [{:db/id #edb/ref 17592186092385 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091954 :question/id #uuid "df59a07a-922c-50b9-8c2c-22ed57ac2bda" :question/math-academy-id "e-149" :question/problem "Find where the normal line to the curve $f(x) = 2\\sqrt{x} -4x$ at the point $(1,-2)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{x}-4x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{1/2}-4x) \\\\  & ={x}^{-1/2}-4.\\end{aligned}\n$$\n\n     \n\nSo the slope of the tangent line is\n\n$$\nm=f'(1) = (1)^{-1/2} - 4 = -3,\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm' = -\\dfrac{1}{m} = \\dfrac 1 3.\n$$\n\nThe equation of the normal line is\n\n$$\n\\begin{aligned}y-(-2) & =\\frac{1}{3}(x-1) \\\\ y+2 & =\\frac{1}{3}(x-1) \\\\ y & =\\frac{1}{3}x-\\frac{1}{3}-2 \\\\ y & =\\frac{1}{3}x-\\frac{7}{3}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{3}x-\\frac{7}{3} & =0 \\\\ \\frac{1}{3}x & =\\frac{7}{3} \\\\ x & =7.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(7,0).$"} :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049394 :topic/id #uuid "f121c6bf-38c7-56a2-930a-199717f2bc16" :topic/knowledge-points [{:db/id #edb/ref 17592186068924} {:db/id #edb/ref 17592186068925} {:db/id #edb/ref 17592186068926} {:db/id #edb/ref 17592186068927}] :topic/math-academy-id 398 :topic/next [{:db/id #edb/ref 17592186049426} {:db/id #edb/ref 17592186049446} {:db/id #edb/ref 17592186049840} {:db/id #edb/ref 17592186050216} {:db/id #edb/ref 17592186050516} {:db/id #edb/ref 17592186051028} {:db/id #edb/ref 17592186051081}] :topic/title "Properties of Lines Given in Slope-Intercept Form"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186711042 :question-generator/id #uuid "12110b67-35d3-535e-85a6-61d54fb42aff" :question-generator/script "generators/8c/8c7c9b7f6a31571627d4059067c2755015b459b9ca26afcbe487f29fe8c67a49/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186092507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17dbb435-0cbf-53b0-b774-95a09e5dd5e2" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186241384} {:answer/id #uuid "52de3f96-3021-5e86-a521-dd5eaf2b4c3a" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186241918} {:answer/id #uuid "7aaf9455-fc42-5674-a140-8638e322d2c9" :answer/type {:db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186242258} {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} {:answer/id #uuid "aecf5e6b-c2d8-5faf-a09d-6ece73a85a07" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{16}{5},0\\right)" :db/id #edb/ref 17592186242704}] :answer-field/correct {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} :answer-field/id #uuid "562461af-5947-5911-b5fb-04453b8765df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a8debb9f-1a0f-5757-8884-2cca273ae3ea" :question/math-academy-id "q-10871" :question/problem "Find where the normal line to the curve $f(x)=2{x}^{2}+x$ at the point $(1,3)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=4(1)+1=5,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-\\frac{1}{5}(x-1) \\\\ y & =-\\frac{1}{5}x+\\frac{1}{5}+3 \\\\ y & =-\\frac{1}{5}x+\\frac{16}{5}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+\\frac{16}{5} & =0 \\\\ x & =16.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(16,0).$"} {:db/id #edb/ref 17592186092510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142b6536-fed4-529f-ac1d-8a42fc666730" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186244498} {:answer/id #uuid "65112d5b-e5af-58b2-8b42-2fafe84f3bf1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186245208} {:answer/id #uuid "6e29c4b1-5a97-5a97-bbf2-51eabed39e9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,\\frac{5}{2}\\right)" :db/id #edb/ref 17592186245289} {:answer/id #uuid "ca93f7a3-eace-5053-ae98-706828a1b4af" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,\\frac{1}{2}\\right)" :db/id #edb/ref 17592186246111} {:answer/id #uuid "d23fbfd4-1cbd-54d1-aa24-886860426aba" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186246184}] :answer-field/correct {:answer/id #uuid "d23fbfd4-1cbd-54d1-aa24-886860426aba" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186246184} :answer-field/id #uuid "816b14ca-c9ce-5b90-8b9c-06306f5bacc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246773}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "24c7ef87-44ff-5aaa-8c80-717e24087d16" :question/math-academy-id "q-11124" :question/problem "Find where the normal line to the curve $f(x)=2\\sqrt{x}$ at the point $(1,2)$ intersects the $y$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{1/2}) \\\\  & ={x}^{-1/2} \\\\  & =\\frac{1}{\\sqrt{x}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=\\frac{1}{\\sqrt{1}}=1,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-2 & =-1(x-1) \\\\ y & =-x+1+2 \\\\ y & =-x+3.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $y$-axis by setting $x=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}y & =-0+3 \\\\ y & =3.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $y$-axis at  $(0,3).$"} {:db/id #edb/ref 17592186233120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "320280fb-5733-564c-a0b0-97898bcb2bd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{6},0\\right)" :db/id #edb/ref 17592186578352} {:answer/id #uuid "370e62d9-36a9-56f9-809e-86e4e1fa8d3c" :answer/type {:db/ident :answer.type/math} :answer/value "(6,0)" :db/id #edb/ref 17592186578357} {:answer/id #uuid "8443e5df-739f-5c53-af97-6bc96212638c" :answer/type {:db/ident :answer.type/math} :answer/value "(57,0)" :db/id #edb/ref 17592186578480} {:answer/id #uuid "8af8e153-bf59-57e4-a3e0-99550ea9fc20" :answer/type {:db/ident :answer.type/math} :answer/value "(19,0)" :db/id #edb/ref 17592186578492} {:answer/id #uuid "bbc7b5d6-9a9f-57c6-ab06-259e0f50eccf" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{19}{2},0\\right)" :db/id #edb/ref 17592186578563}] :answer-field/correct {:answer/id #uuid "8443e5df-739f-5c53-af97-6bc96212638c" :answer/type {:db/ident :answer.type/math} :answer/value "(57,0)" :db/id #edb/ref 17592186578480} :answer-field/id #uuid "b41fcb6b-9a2e-5283-953f-87368d023c72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578758}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "73d11496-6181-52ca-9d4d-b27d18c44afc" :question/math-academy-id "q-10878" :question/problem "Find where the normal line to the curve $y={x}^{2}$ at the point $(3,9)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{'}(3)=2(3)=6,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-9 & =-\\frac{1}{6}(x-3) \\\\ y & =-\\frac{1}{6}x+\\frac{1}{2}+9 \\\\ y & =-\\frac{1}{6}x+\\frac{19}{2}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{6}x+\\frac{19}{2} & =0 \\\\ \\frac{19}{2} & =\\frac{1}{6}x \\\\ x & =57.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(57,0).$"} {:db/id #edb/ref 17592186233928 :question/answer-fields [{:answer-field/id #uuid "cbb07659-6477-5d10-82e6-aacdbe268de0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232870} {:answer-field/id #uuid "8c274c86-2265-560b-954c-b88302a2ca2b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232871}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2fa5d441-4b5d-54d5-8541-9752428a4a54" :question/math-academy-id "q-342222" :question/problem "Find where the normal line to the curve $y=2\\sqrt[4]{x}$ at the point $(1,2)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt[4]{x}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/4}) \\\\  & =2\\cdot \\frac{1}{4}{x}^{-3/4} \\\\  & =\\frac{1}{2\\sqrt[4]{{x}^{3}}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{'}(1)=\\frac{1}{2\\sqrt[4]{{1}^{3}}}=\\frac{1}{2},\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{\\left(\\frac{1}{2}\\right)}=-2.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-2 & =-2\\cdot (x-1) \\\\ y & =-2x+2+2 \\\\ y & =-2x+4.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-2x+4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(\\,2,0\\,).$"} {:db/id #edb/ref 17592186234308 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5576e6ce-2a23-51d7-abb9-62b7ddb98d68" :question/math-academy-id "q-71542" :question/problem "Find where the normal line to the curve $f(x)=3{x}^{2}-4x+1$ at the point $(2,5)$ intersects the $y$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-4x+1)=6x-4.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{'}(2)=6(2)-4=8,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-5 & =-\\frac{1}{8}(x-2) \\\\ y & =-\\frac{1}{8}x+\\frac{1}{4}+5 \\\\ y & =-\\frac{1}{8}x+\\frac{21}{4}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $y$-axis by setting $x=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}y & =-\\frac{1}{8}\\cdot 0+\\frac{21}{4} \\\\ y & =\\frac{21}{4}.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $y$-axis at  $\\left(0,\\frac{21}{4}\\right).$"} {:db/id #edb/ref 17592186240795 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5ae20c-b789-5249-bff8-1194daf3c008" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-20)" :db/id #edb/ref 17592186238321} {:answer/id #uuid "bdc902fd-c7c3-53b3-90a3-02661fb40990" :answer/type {:db/ident :answer.type/math} :answer/value "(0,20)" :db/id #edb/ref 17592186239711} {:answer/id #uuid "d1c92a83-db3b-57d5-87ad-2844ddc86d19" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-8)" :db/id #edb/ref 17592186239896} {:answer/id #uuid "ee996a51-be22-5564-9782-5ded740f8f13" :answer/type {:db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186240158} {:answer/id #uuid "f14cea86-7dde-5527-ac9c-2767c9873574" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186240186}] :answer-field/correct {:answer/id #uuid "bdc902fd-c7c3-53b3-90a3-02661fb40990" :answer/type {:db/ident :answer.type/math} :answer/value "(0,20)" :db/id #edb/ref 17592186239711} :answer-field/id #uuid "092d888b-3d25-51dd-8dad-08178716d6c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240342}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9348de04-831f-5ba3-963b-71f2ffb24276" :question/math-academy-id "q-104073" :question/problem "Find where the normal line to the curve $f(x)=3\\sqrt[3]{{x}^{2}}$ at the point $(8,12)$ intersects the $y$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\sqrt[3]{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2/3}) \\\\  & =2{x}^{-1/3} \\\\  & =\\frac{2}{\\sqrt[3]{x}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(8)=\\frac{2}{\\sqrt[3]{8}}=1,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-12 & =-(x-8) \\\\ y & =-x+8+12 \\\\ y & =20-x.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $y$-axis by setting $x=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}y & =20-0 \\\\ y & =20.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $y$-axis at  $(0,20).$"} {:db/id #edb/ref 17592186240796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aec5b68-893e-5d74-9a97-1f1d78197fe8" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186238434} {:answer/id #uuid "39be9afa-fb3a-514b-a31f-626575d486e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{7},0\\right)" :db/id #edb/ref 17592186238553} {:answer/id #uuid "659ab06c-c705-55e3-b1cd-020841118552" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{3},0\\right)" :db/id #edb/ref 17592186238943} {:answer/id #uuid "81f08a0b-8c19-5ecf-80ec-e6d88e15c8ff" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186239184} {:answer/id #uuid "a3667d4f-7c52-56e0-aa34-3236afb88174" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186239478}] :answer-field/correct {:answer/id #uuid "a3667d4f-7c52-56e0-aa34-3236afb88174" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186239478} :answer-field/id #uuid "f02d54c7-4347-5d6c-bb82-af5e4a1dca44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240752}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a4c51a1e-c57a-5c02-97b1-4b0a0b84934b" :question/math-academy-id "q-104075" :question/problem "Find where the normal line to the curve $f(x)=2\\sqrt{{x}^{3}}$ at the point $(1,2)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{{x}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3/2}) \\\\  & =3{x}^{1/2} \\\\  & =3\\sqrt{x}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=3\\sqrt{1}=3,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{3}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-2 & =-\\frac{1}{3}(x-1) \\\\ y & =-\\frac{1}{3}x+\\frac{1}{3}+2 \\\\ y & =-\\frac{1}{3}x+\\frac{7}{3}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{3}x+\\frac{7}{3} & =0 \\\\ x & =7.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at  $(7,0).$"} {:db/id #edb/ref 17592186297306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c44b5185-3568-53b3-8d77-c69fc2155067" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296303}] :answer-field/correct {:answer/id #uuid "c44b5185-3568-53b3-8d77-c69fc2155067" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296303} :answer-field/id #uuid "26be343c-5dfd-5031-b3d8-1563d7798319" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296704} {:answer-field/choices [{:answer/id #uuid "55838d61-7b48-5ee6-9d1d-e85a07554987" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295760}] :answer-field/correct {:answer/id #uuid "55838d61-7b48-5ee6-9d1d-e85a07554987" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295760} :answer-field/id #uuid "f48c190e-f08c-555e-ba42-c4bbbf078a30" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297131}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac03aacc-0b7e-5a7f-8554-ee3b669a879c" :question/math-academy-id "q-308823" :question/problem "Find where the normal line to the curve $y=\\frac{2}{x}+1$ at the point $(1,3)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{2}{x}+1\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1}+1) \\\\  & =-2{x}^{-2} \\\\  & =-\\frac{2}{{x}^{2}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=-\\frac{2}{(1)^{2}}=-2,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}x-\\frac{1}{2}+3 \\\\ y & =\\frac{1}{2}x+\\frac{5}{2}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{2}x+\\frac{5}{2} & =0 \\\\ x & =-5.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the  $x$-axis at $(\\,-5,0\\,).$"} {:db/id #edb/ref 17592186317215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f29a7ee8-6004-5b63-95be-61dae16a9261" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186316470}] :answer-field/correct {:answer/id #uuid "f29a7ee8-6004-5b63-95be-61dae16a9261" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186316470} :answer-field/id #uuid "a37137d9-0f3c-517e-a020-3af32e0d7118" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316927} {:answer-field/choices [{:answer/id #uuid "956a031d-532f-5607-903a-8423c21b005b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315946}] :answer-field/correct {:answer/id #uuid "956a031d-532f-5607-903a-8423c21b005b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315946} :answer-field/id #uuid "ab3b85e2-94cd-5534-8e57-152046c2fe00" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316946}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "13b0b6f2-9e09-5a5a-a8f6-564d0221d479" :question/math-academy-id "q-342200" :question/problem "Find where the normal line to the curve $y=4-{x}^{2}$ at the point $(1,3)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(4-{x}^{2})=-2x.\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=-2(1)=-2,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(-2)}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}x-\\frac{1}{2}+3 \\\\ y & =\\frac{1}{2}x+\\frac{5}{2}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{2}x+\\frac{5}{2} & =0 \\\\ \\frac{1}{2}x & =-\\frac{5}{2} \\\\ x & =-5.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(\\,-5,0\\,).$"} {:db/id #edb/ref 17592186317216 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb0d502b-d760-5a8c-9578-c9ee4ec4fcff" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186316175}] :answer-field/correct {:answer/id #uuid "bb0d502b-d760-5a8c-9578-c9ee4ec4fcff" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186316175} :answer-field/id #uuid "6e1ebef9-6d7b-5c01-bb3d-23418a788f7c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316814} {:answer-field/choices [{:answer/id #uuid "20941452-3ae7-5d6b-8a37-42ad9a21730b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315301}] :answer-field/correct {:answer/id #uuid "20941452-3ae7-5d6b-8a37-42ad9a21730b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186315301} :answer-field/id #uuid "ddf70354-1c4a-52c1-8859-6faef41810f9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317077}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2f7f3a21-7e8d-51e9-8d45-2915b0e3fe06" :question/math-academy-id "q-342201" :question/problem "Find where the normal line to the curve $y=3{x}^{2}-6x+5$ at the point $(0,5)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-6x+5)=6x-6.\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(0)=6(0)-6=-6,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{(-6)}=\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-5 & =\\frac{1}{6}(x-0) \\\\ y & =\\frac{1}{6}x+5.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{6}x+5 & =0 \\\\ \\frac{1}{6}x & =-5 \\\\ x & =-30.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(\\,-30,0\\,).$"} {:db/id #edb/ref 17592186493316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028288df-333f-57f2-9e25-7548b283399c" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186493307} {:answer/id #uuid "30a55d4b-f895-53a5-a364-ce5fddbb6ae1" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186493310} {:answer/id #uuid "59d2a5db-49a2-566c-afa9-b7bdaafa25da" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{376}{25},0\\right)" :db/id #edb/ref 17592186493313} {:answer/id #uuid "66291432-b739-52c2-992c-c3d5906e8d52" :answer/type {:db/ident :answer.type/math} :answer/value "(376,0)" :db/id #edb/ref 17592186493314} {:answer/id #uuid "cb3d8d25-8bfa-5e2a-b032-69c3782c0eb7" :answer/type {:db/ident :answer.type/math} :answer/value "(25,0)" :db/id #edb/ref 17592186493322}] :answer-field/correct {:answer/id #uuid "66291432-b739-52c2-992c-c3d5906e8d52" :answer/type {:db/ident :answer.type/math} :answer/value "(376,0)" :db/id #edb/ref 17592186493314} :answer-field/id #uuid "40ab1d54-64ea-58e4-9d91-d527f34b3bee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186493312}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7e3f1a4a-bfde-54af-80e2-4cc4e890e6fc" :question/problem "Find where the normal line to the curve $f(x)=10 x^{2} + 5 x$ at the point $(1,15)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}f'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}(10 x^{2} + 5 x)=20 x + 5.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm=f'(1)=25=25,\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{(25)}=- \\frac{1}{25}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(15)&=- \\frac{1}{25}(x-(1))\\\\y&=- \\frac{1}{25}x-\\left(- \\frac{1}{25}\\right)+(15)\\\\y&=- \\frac{1}{25}x+\\frac{376}{25}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}- \\frac{1}{25}x+\\frac{376}{25}&=0\\\\x&=376.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(376,0).$"} {:db/id #edb/ref 17592186493318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4079920d-ee6c-5086-9aa8-97eb49b915c2" :answer/type {:db/ident :answer.type/math} :answer/value "-599" :db/id #edb/ref 17592186493311}] :answer-field/correct {:answer/id #uuid "4079920d-ee6c-5086-9aa8-97eb49b915c2" :answer/type {:db/ident :answer.type/math} :answer/value "-599" :db/id #edb/ref 17592186493311} :answer-field/id #uuid "24d2eda6-5f52-58d1-8821-c19db30c5bf9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493309} {:answer-field/choices [{:answer/id #uuid "ba9c2120-ea78-56ae-b7da-fc8f913f4ff6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493320}] :answer-field/correct {:answer/id #uuid "ba9c2120-ea78-56ae-b7da-fc8f913f4ff6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493320} :answer-field/id #uuid "a11eaf98-7e1d-530f-93f1-50c6c3aa85a7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493319}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9c1268dd-9a0b-5590-983e-596506fe3286" :question/problem "Find where the normal line to the curve $y=\\frac{20}{x}+10$ at the point $(1,30)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(\\frac{20}{x}+10\\right)\\\\&=\\frac{\\mathrm{d}}{\\mathrm{d}x}\\left(10 + \\frac{20}{x}\\right)\\\\&=-20x^{-2}\\\\&=- \\frac{20}{x^{2}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm=f'(1)=-20=-20,\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{(-20)}=\\frac{1}{20}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(30)&=\\frac{1}{20}(x-(1))\\\\y&=\\frac{1}{20}x-\\left(\\frac{1}{20}\\right)+(30)\\\\y&=\\frac{1}{20}x+\\frac{599}{20}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{20}x+\\frac{599}{20}&=0\\\\x&=-599.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the  $x$-axis at $(-599,0).$"} {:db/id #edb/ref 17592186493321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93fb4c05-1e1a-5463-aeeb-5bdc06ba8f62" :answer/type {:db/ident :answer.type/math} :answer/value "-1080" :db/id #edb/ref 17592186493317}] :answer-field/correct {:answer/id #uuid "93fb4c05-1e1a-5463-aeeb-5bdc06ba8f62" :answer/type {:db/ident :answer.type/math} :answer/value "-1080" :db/id #edb/ref 17592186493317} :answer-field/id #uuid "7468eab7-aa1d-581c-b1c7-75e4eb6144f4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493315} {:answer-field/choices [{:answer/id #uuid "17fbaf02-25c3-5f36-8455-1d21e7ade415" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493308}] :answer-field/correct {:answer/id #uuid "17fbaf02-25c3-5f36-8455-1d21e7ade415" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186493308} :answer-field/id #uuid "f7f48b25-30b8-5af5-8b60-15f91577b14d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493323}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c3c9763c-f1e1-51a2-887f-38a4a610161d" :question/problem "Find where the normal line to the curve $y=18 x^{2} - 36 x + 30$ at the point $(0,30)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\nf'(x)=\\frac{\\mathrm{d}}{\\mathrm{d}x}(18 x^{2} - 36 x + 30)=36 x - 36.\n$$\n\nSo the slope of the tangent line is\n\n$$\nm=f'(0)=-36=-36,\n$$\n\nand therefore the slope of the normal line is\n\n$$\nm'=-\\frac{1}{m}=-\\frac{1}{(-36)}=\\frac{1}{36}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(30)&=\\frac{1}{36}(x-(0))\\\\y&=\\frac{1}{36}x+30.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{36}x+30&=0\\\\\\frac{1}{36}x&=-30\\\\x&=-1080.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(-1080,0).$"} {:db/id #edb/ref 17592186523994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd5c750-5279-5330-b4bd-2cd5bbc27ec7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186523442}] :answer-field/correct {:answer/id #uuid "5bd5c750-5279-5330-b4bd-2cd5bbc27ec7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186523442} :answer-field/id #uuid "49acc5c5-2120-5767-aa7d-12757fa05e62" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523826} {:answer-field/choices [{:answer/id #uuid "0d4a964b-fc42-590a-ab02-6266c93e2655" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186523281}] :answer-field/correct {:answer/id #uuid "0d4a964b-fc42-590a-ab02-6266c93e2655" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186523281} :answer-field/id #uuid "6cb1979e-e5cb-53ff-86e6-e698dd51091e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523843}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a153fbfd-b7f1-5770-9660-ea9e18ac215d" :question/math-academy-id "q-308821" :question/problem "Find where the normal line to the curve $y={x}^{3}$ at the point $(1,1)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{3})=3{x}^{2}.\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=3(1)^{2}=3,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{3}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-1 & =-\\frac{1}{3}(x-(1)) \\\\ y & =-\\frac{1}{3}x+\\frac{1}{3}+1 \\\\ y & =-\\frac{1}{3}x+\\frac{4}{3}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{3}x+\\frac{4}{3} & =0 \\\\ \\frac{1}{3}x & =\\frac{4}{3} \\\\ x & =4.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(\\,4,0\\,).$"} {:db/id #edb/ref 17592186578858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2a6764-00bd-5f28-952f-20dd216fef53" :answer/type {:db/ident :answer.type/math} :answer/value "(96,0)" :db/id #edb/ref 17592186578317} {:answer/id #uuid "6ace2d5c-ca5d-52fc-8f62-fbef69d9fba6" :answer/type {:db/ident :answer.type/math} :answer/value "(49,0)" :db/id #edb/ref 17592186578445} {:answer/id #uuid "90c5e6df-7242-5471-add4-9e72fb15748c" :answer/type {:db/ident :answer.type/math} :answer/value "(98,0)" :db/id #edb/ref 17592186578505} {:answer/id #uuid "a5f8e7b1-4e1e-50a9-a92e-4620063f5c00" :answer/type {:db/ident :answer.type/math} :answer/value "(56,0)" :db/id #edb/ref 17592186578532} {:answer/id #uuid "c8a6ad07-90a6-5d02-b9eb-b5a27c586716" :answer/type {:db/ident :answer.type/math} :answer/value "(8,0)" :db/id #edb/ref 17592186578582}] :answer-field/correct {:answer/id #uuid "90c5e6df-7242-5471-add4-9e72fb15748c" :answer/type {:db/ident :answer.type/math} :answer/value "(98,0)" :db/id #edb/ref 17592186578505} :answer-field/id #uuid "59b21907-6a2e-5305-bbec-3d26d82d800a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578724}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "aa4d3460-2748-5ad3-bd8b-990ea542e91d" :question/math-academy-id "q-10870" :question/problem "Find where the normal line to the curve $y={x}^{3}$ at the point $(2,8)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) &=\\frac{\\text{d}}{\\text{d}x}({x}^{3})=3{x}^{2}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(2)=3(2)^{2}=12,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{12}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-8 & =-\\frac{1}{12}(x-(2)) \\\\ y & =-\\frac{1}{12}x+\\frac{1}{6}+8 \\\\ y & =-\\frac{1}{12}x+\\frac{49}{6}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{12}x+\\frac{49}{6} & =0 \\\\ \\frac{1}{12}x & =\\frac{49}{6} \\\\ x & =98\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(98,0).$"} {:db/id #edb/ref 17592186710708 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cd30e36-f632-5fba-ba0a-098b15f7f61a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{2}" :db/id #edb/ref 17592186710714}] :answer-field/correct {:answer/id #uuid "9cd30e36-f632-5fba-ba0a-098b15f7f61a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{2}" :db/id #edb/ref 17592186710714} :answer-field/id #uuid "0da8f0d6-9879-5d8a-83fa-ffb37b447308" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710705} {:answer-field/choices [{:answer/id #uuid "0fad787c-23d7-5042-abcc-65fcef82701b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186710706}] :answer-field/correct {:answer/id #uuid "0fad787c-23d7-5042-abcc-65fcef82701b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186710706} :answer-field/id #uuid "ccaada5b-2b03-5f8c-971a-3b10a71f2bb8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710718}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "181f7a01-3534-5ed7-8eaf-705db6b88682" :question/problem "Let $f(x)=2\\sqrt{x}-3x+1$. Find where the normal line to the curve $y=f(x)$ at the point with $x$-coordinate $4$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "First find the point on the curve:\n\n$$\nf(4)=2\\sqrt{4}-3(4)+1=4-12+1=-7.\n$$\n\nThus the normal passes through $(4,-7)$. Differentiate both variable terms:\n\n$$\n\\begin{aligned}\nf(x)&=2x^{1/2}-3x+1,\\\\\nf'(x)&=x^{-1/2}-3=\\frac{1}{\\sqrt{x}}-3.\n\\end{aligned}\n$$\n\nThe tangent slope is\n\n$$\nf'(4)=\\frac{1}{2}-3=-\\frac{5}{2}.\n$$\n\nThe normal slope is the negative reciprocal, so\n\n$$\nm_n=-\\frac{1}{-5/2}=\\frac{2}{5}.\n$$\n\nUsing $(4,-7)$, the normal line is\n\n$$\n\\begin{aligned}\ny+7&=\\frac{2}{5}(x-4),\\\\\ny&=\\frac{2}{5}x-\\frac{8}{5}-7\\\\\n&=\\frac{2}{5}x-\\frac{43}{5}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$. Solving gives\n\n$$\n\\begin{aligned}\n0&=\\frac{2}{5}x-\\frac{43}{5},\\\\\n2x&=43,\\\\\nx&=\\frac{43}{2}.\n\\end{aligned}\n$$\n\nThe intersection is $\\left(\\frac{43}{2},0\\right)$."} {:db/id #edb/ref 17592186710717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1304e269-0ac0-5826-8b97-0f6fbb2ab300" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186710707} {:answer/id #uuid "1a2ae83b-76ca-58fa-996e-cc5cb1786a90" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186710709} {:answer/id #uuid "87b5de75-8e2f-5de4-9775-3da8f6159aa2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{2},0\\right)" :db/id #edb/ref 17592186710712} {:answer/id #uuid "b8fcd68a-1072-5461-9d6d-caf71bc3239a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{3}{2},0\\right)" :db/id #edb/ref 17592186710716} {:answer/id #uuid "ed738d5a-d84f-5508-b3f5-0d8fc54516a7" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186710719}] :answer-field/correct {:answer/id #uuid "1304e269-0ac0-5826-8b97-0f6fbb2ab300" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186710707} :answer-field/id #uuid "948d6c67-e382-5b87-ba6f-f1837d3e63b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186710713}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c6980932-bec7-5e26-bc0a-484017353e0c" :question/problem "Find where the normal line to the curve $y=x^2$ at the point $(1,1)$ intersects the $x$-axis." :question/worked-solution "Differentiating gives\n\n$$\nf'(x)=2x,\\qquad f'(1)=2.\n$$\n\nThe tangent slope is $2$, so the normal slope is its negative reciprocal:\n\n$$\nm_n=-\\frac{1}{2}.\n$$\n\nThe diagram shows the curve, its solid tangent, and its dashed normal at $(1,1)$.\n\n![The parabola y equals x squared with its tangent and perpendicular normal at (1,1).](images/31/31ba09ff14e5bd485794f283c5d6a5b087b6c21fdb9242af01b75ec8e8744e0d.png)\n\nUsing point-slope form, the normal line is\n\n$$\n\\begin{aligned}\ny-1&=-\\frac{1}{2}(x-1)\\\\\ny&=-\\frac{1}{2}x+\\frac{3}{2}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$. Therefore,\n\n$$\n0=-\\frac{1}{2}x+\\frac{3}{2},\\qquad x=3.\n$$\n\nThe intersection is $(3,0)$."} {:db/id #edb/ref 17592186710720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7a3f3e9-0f8e-5903-a2bd-cb884690b67c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{3}" :db/id #edb/ref 17592186710715}] :answer-field/correct {:answer/id #uuid "a7a3f3e9-0f8e-5903-a2bd-cb884690b67c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{3}" :db/id #edb/ref 17592186710715} :answer-field/id #uuid "27f25434-29a5-59ca-b3e6-82d0ca6de677" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710710} {:answer-field/choices [{:answer/id #uuid "78b34a44-a9ce-53b6-ac95-76363c362975" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186710711}] :answer-field/correct {:answer/id #uuid "78b34a44-a9ce-53b6-ac95-76363c362975" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186710711} :answer-field/id #uuid "fb6e064f-f92b-53e8-b7c6-fb957ecc944f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710721}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eff81607-20ad-5597-b10b-2eb15a4182f5" :question/problem "Find where the normal line to the curve $y=3\\sqrt{x}$ at the point $(4,6)$ intersects the $y$-axis.\n\nThe normal line intersects the $y$-axis at $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "Rewrite the radical as a fractional power and differentiate:\n\n$$\n\\begin{aligned}\nf(x)&=3x^{1/2},\\\\\nf'(x)&=\\frac{3}{2}x^{-1/2}=\\frac{3}{2\\sqrt{x}}.\n\\end{aligned}\n$$\n\nAt $(4,6)$, the tangent slope and normal slope are\n\n$$\nf'(4)=\\frac{3}{2\\sqrt{4}}=\\frac{3}{4},\\qquad m_n=-\\frac{1}{3/4}=-\\frac{4}{3}.\n$$\n\nThe normal passes through $(4,6)$, so\n\n$$\n\\begin{aligned}\ny-6&=-\\frac{4}{3}(x-4),\\\\\ny&=-\\frac{4}{3}x+\\frac{16}{3}+6\\\\\n&=-\\frac{4}{3}x+\\frac{34}{3}.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$, giving $y=\\frac{34}{3}$. The intersection is $\\left(0,\\frac{34}{3}\\right)$."} {:db/id #edb/ref 17592186711017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d42a46-199b-5876-a577-02df07046c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{8}" :db/id #edb/ref 17592186711021}] :answer-field/correct {:answer/id #uuid "30d42a46-199b-5876-a577-02df07046c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{8}" :db/id #edb/ref 17592186711021} :answer-field/id #uuid "30e85019-16b8-5fbd-a30d-c444bad2494a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711022} {:answer-field/choices [{:answer/id #uuid "41f7b3c9-a556-53a6-8f1b-8f8cff7c381e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711024}] :answer-field/correct {:answer/id #uuid "41f7b3c9-a556-53a6-8f1b-8f8cff7c381e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711024} :answer-field/id #uuid "3bc3f86c-4516-5f01-9ec9-8dff4027c465" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711023}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "18e6fb5a-75af-5a6c-97e9-934ada084867" :question/problem "Find where the normal line to the curve $y=\\frac{1}{x}-1$ at the point $\\left(2,- \\frac{1}{2}\\right)$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "Rewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=-1 + \\frac{1}{x}, \\\\f'(x)&=- \\frac{1}{x^{2}}=- \\frac{1}{x^{2}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(2)&=- \\frac{1}{(2)^{2}}=- \\frac{1}{4}, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{\\left(- \\frac{1}{4}\\right)}=4.\n\\end{aligned}\n$$\n\nUse point-slope form through $\\left(2,- \\frac{1}{2}\\right)$.\n\n$$\n\\begin{aligned}\ny-\\left(- \\frac{1}{2}\\right)&=4(x-(2)), \\\\y&=4 x - \\frac{17}{2}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=4x+\\left(- \\frac{17}{2}\\right), \\\\x&=\\frac{17}{8}.\n\\end{aligned}\n$$\n\nThe intersection is $\\left(\\frac{17}{8},0\\right)$."} {:db/id #edb/ref 17592186711025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ad1639f-b64a-5769-82ed-02e05839f62c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186711027}] :answer-field/correct {:answer/id #uuid "8ad1639f-b64a-5769-82ed-02e05839f62c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{3}" :db/id #edb/ref 17592186711027} :answer-field/id #uuid "bdee68f2-72fc-5bc7-985f-5b0ac15788eb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711034} {:answer-field/choices [{:answer/id #uuid "2a95b0ec-864a-50e4-94a8-d87a628dd52c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711020}] :answer-field/correct {:answer/id #uuid "2a95b0ec-864a-50e4-94a8-d87a628dd52c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711020} :answer-field/id #uuid "f06268c3-24a7-51e0-9689-f128fcc12de6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711038}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "61986396-db29-5c50-b599-1e03204a89b9" :question/problem "Find where the normal line to the curve $y=\\sqrt{x^{3}}-3$ at the point $(4,5)$ intersects the $y$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "Rewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=x^{\\frac{3}{2}} - 3, \\\\f'(x)&=\\frac{3 x^{\\frac{1}{2}}}{2}=\\frac{3 \\sqrt{x}}{2}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(4)&=\\frac{3 \\sqrt{(4)}}{2}=3, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(3)}=- \\frac{1}{3}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(4,5)$.\n\n$$\n\\begin{aligned}\ny-(5)&=- \\frac{1}{3}(x-(4)), \\\\y&=- \\frac{x}{3} + \\frac{19}{3}.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$.\n\n$$\n\\begin{aligned}\ny&=- \\frac{1}{3}\\cdot 0+\\left(\\frac{19}{3}\\right), \\\\y&=\\frac{19}{3}.\n\\end{aligned}\n$$\n\nThe intersection is $\\left(0,\\frac{19}{3}\\right)$."} {:db/id #edb/ref 17592186711030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20edf35f-4a33-5ca6-bc4a-5f935bb93ca9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{265}{16}" :db/id #edb/ref 17592186711019}] :answer-field/correct {:answer/id #uuid "20edf35f-4a33-5ca6-bc4a-5f935bb93ca9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{265}{16}" :db/id #edb/ref 17592186711019} :answer-field/id #uuid "bc22fe5f-5f84-55fc-ad97-6ac8556ab4e4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711033} {:answer-field/choices [{:answer/id #uuid "c60c85ea-4339-511d-9c52-5fc38cb0d52b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711036}] :answer-field/correct {:answer/id #uuid "c60c85ea-4339-511d-9c52-5fc38cb0d52b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711036} :answer-field/id #uuid "f4308f6f-eda3-5d2f-ade2-9a50a4b130dc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711040}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a97a2962-6ba1-5604-abc4-227d138bb2de" :question/problem "Find where the normal line to the curve $y=-3\\sqrt[4]{x}$ at the point $(16,-6)$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "Rewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=- 3 x^{\\frac{1}{4}}, \\\\f'(x)&=- \\frac{3}{4 x^{\\frac{3}{4}}}=- \\frac{3}{4 x^{\\frac{3}{4}}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(16)&=- \\frac{3}{4 (16)^{\\frac{3}{4}}}=- \\frac{3}{32}, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{\\left(- \\frac{3}{32}\\right)}=\\frac{32}{3}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(16,-6)$.\n\n$$\n\\begin{aligned}\ny-(-6)&=\\frac{32}{3}(x-(16)), \\\\y&=\\frac{32 x}{3} - \\frac{530}{3}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=\\frac{32}{3}x+\\left(- \\frac{530}{3}\\right), \\\\x&=\\frac{265}{16}.\n\\end{aligned}\n$$\n\nThe intersection is $\\left(\\frac{265}{16},0\\right)$."} {:db/id #edb/ref 17592186711039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fe8278c-d0df-516b-99d2-a2a722f9b277" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186711028}] :answer-field/correct {:answer/id #uuid "9fe8278c-d0df-516b-99d2-a2a722f9b277" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186711028} :answer-field/id #uuid "ac75c705-8a67-5f78-88e8-7c0b3efa2b72" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711031} {:answer-field/choices [{:answer/id #uuid "7bbb8880-c729-504e-8d3e-58488413cb12" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711026}] :answer-field/correct {:answer/id #uuid "7bbb8880-c729-504e-8d3e-58488413cb12" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711026} :answer-field/id #uuid "cddebd60-d727-5248-b03f-c0f5755c0555" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711037}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f0c2287a-fb5a-504a-9902-8dd3de3bd720" :question/problem "Find where the normal line to the curve $y=3\\sqrt[3]{x^{2}}-1$ at the point $(1,2)$ intersects the $y$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "Rewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=3 x^{\\frac{2}{3}} - 1, \\\\f'(x)&=\\frac{2}{x^{\\frac{1}{3}}}=\\frac{2}{\\sqrt[3]{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(1)&=\\frac{2}{\\sqrt[3]{(1)}}=2, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(2)}=- \\frac{1}{2}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(1,2)$.\n\n$$\n\\begin{aligned}\ny-(2)&=- \\frac{1}{2}(x-(1)), \\\\y&=- \\frac{x}{2} + \\frac{5}{2}.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$.\n\n$$\n\\begin{aligned}\ny&=- \\frac{1}{2}\\cdot 0+\\left(\\frac{5}{2}\\right), \\\\y&=\\frac{5}{2}.\n\\end{aligned}\n$$\n\nThe intersection is $\\left(0,\\frac{5}{2}\\right)$."} {:db/id #edb/ref 17592186711041 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4acaf63-c69c-529b-971c-629d85287a0b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186711035}] :answer-field/correct {:answer/id #uuid "c4acaf63-c69c-529b-971c-629d85287a0b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186711035} :answer-field/id #uuid "196ec8e3-35a8-51ea-9bb2-a8470f3d38d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711018} {:answer-field/choices [{:answer/id #uuid "a7c477cc-f99d-5fce-bb1a-c670118dce79" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711029}] :answer-field/correct {:answer/id #uuid "a7c477cc-f99d-5fce-bb1a-c670118dce79" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711029} :answer-field/id #uuid "b8dbbcee-9c41-5d5f-b05b-604672e44dca" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711032}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5df1698-628f-5b29-bc3b-0cab10df4b14" :question/problem "Find where the normal line to the curve $y=-\\sqrt{x}-1$ at the point $(1,-2)$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "Rewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=- x^{\\frac{1}{2}} - 1, \\\\f'(x)&=- \\frac{1}{2 x^{\\frac{1}{2}}}=- \\frac{1}{2 \\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(1)&=- \\frac{1}{2 \\sqrt{(1)}}=- \\frac{1}{2}, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{\\left(- \\frac{1}{2}\\right)}=2.\n\\end{aligned}\n$$\n\nUse point-slope form through $(1,-2)$.\n\n$$\n\\begin{aligned}\ny-(-2)&=2(x-(1)), \\\\y&=2 x - 4.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=2x+(-4), \\\\x&=2.\n\\end{aligned}\n$$\n\nThe intersection is $(2,0)$."} {:db/id #edb/ref 17592186711043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2233a791-0d98-5a06-9c9e-dab0a0739e81" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186711044}] :answer-field/correct {:answer/id #uuid "2233a791-0d98-5a06-9c9e-dab0a0739e81" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186711044} :answer-field/id #uuid "5ed5e5a9-b2bf-5471-b5e5-ed4202a40dfa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711052} {:answer-field/choices [{:answer/id #uuid "515727a8-de2e-5f42-97cc-7038e783b28c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711048}] :answer-field/correct {:answer/id #uuid "515727a8-de2e-5f42-97cc-7038e783b28c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711048} :answer-field/id #uuid "658861df-c021-510a-a673-9e1229a44b68" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711054}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1e851c6f-0845-5cf1-a0ca-d11054731d95" :question/problem "Find where the normal line to the curve $y=-4\\sqrt{x}-3x$ at the point with $x$-coordinate $4$ intersects the $y$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "First find the point on the curve.\n\n$$\nf(4)=-4\\sqrt{(4)}-3(4)=-20.\n$$\n\nThe normal passes through $(4,-20)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=- 4 x^{\\frac{1}{2}} - 3 x, \\\\f'(x)&=-3 - \\frac{2}{x^{\\frac{1}{2}}}=-3 - \\frac{2}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(4)&=-3 - \\frac{2}{\\sqrt{(4)}}=-4, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(-4)}=\\frac{1}{4}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(4,-20)$.\n\n$$\n\\begin{aligned}\ny-(-20)&=\\frac{1}{4}(x-(4)), \\\\y&=\\frac{x}{4} - 21.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$.\n\n$$\n\\begin{aligned}\ny&=\\frac{1}{4}\\cdot 0+(-21), \\\\y&=-21.\n\\end{aligned}\n$$\n\nThe intersection is $(0,-21)$."} {:db/id #edb/ref 17592186711049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3604aa08-e36f-57d0-8fdd-0d825118acff" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711046}] :answer-field/correct {:answer/id #uuid "3604aa08-e36f-57d0-8fdd-0d825118acff" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711046} :answer-field/id #uuid "5fb98af8-dfa6-5c05-9810-ea442451233a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711053} {:answer-field/choices [{:answer/id #uuid "31c59def-1c46-503f-bab4-d2801e6fa9b0" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186711045}] :answer-field/correct {:answer/id #uuid "31c59def-1c46-503f-bab4-d2801e6fa9b0" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186711045} :answer-field/id #uuid "f4bde6d5-5c30-5aac-8fbc-48e8516c5d8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711061}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "56fb83f4-29a4-552d-88c3-cb47334025ff" :question/problem "Find where the normal line to the curve $y=4\\sqrt{x}+x-1$ at the point with $x$-coordinate $1$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "First find the point on the curve.\n\n$$\nf(1)=4\\sqrt{(1)}+(1)-1=4.\n$$\n\nThe normal passes through $(1,4)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=4 x^{\\frac{1}{2}} + x - 1, \\\\f'(x)&=1 + \\frac{2}{x^{\\frac{1}{2}}}=1 + \\frac{2}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(1)&=1 + \\frac{2}{\\sqrt{(1)}}=3, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(3)}=- \\frac{1}{3}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(1,4)$.\n\n$$\n\\begin{aligned}\ny-(4)&=- \\frac{1}{3}(x-(1)), \\\\y&=- \\frac{x}{3} + \\frac{13}{3}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=- \\frac{1}{3}x+\\left(\\frac{13}{3}\\right), \\\\x&=13.\n\\end{aligned}\n$$\n\nThe intersection is $(13,0)$."} {:db/id #edb/ref 17592186711050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41226d43-6221-5465-a912-f4574ba84f75" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186711047}] :answer-field/correct {:answer/id #uuid "41226d43-6221-5465-a912-f4574ba84f75" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186711047} :answer-field/id #uuid "81dbfc34-fb1b-50df-9765-905670157b2b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711057} {:answer-field/choices [{:answer/id #uuid "fa1dbfec-feec-5504-8258-7507218ce424" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711062}] :answer-field/correct {:answer/id #uuid "fa1dbfec-feec-5504-8258-7507218ce424" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711062} :answer-field/id #uuid "e6d79bf8-26b6-51bb-a885-f8095aee7509" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711060}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5713cd06-670a-5cc1-b3cf-6916500d7e8c" :question/problem "Find where the normal line to the curve $y=2\\sqrt{x}+3x-1$ at the point with $x$-coordinate $1$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "First find the point on the curve.\n\n$$\nf(1)=2\\sqrt{(1)}+3(1)-1=4.\n$$\n\nThe normal passes through $(1,4)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=2 x^{\\frac{1}{2}} + 3 x - 1, \\\\f'(x)&=3 + \\frac{1}{x^{\\frac{1}{2}}}=3 + \\frac{1}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(1)&=3 + \\frac{1}{\\sqrt{(1)}}=4, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(4)}=- \\frac{1}{4}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(1,4)$.\n\n$$\n\\begin{aligned}\ny-(4)&=- \\frac{1}{4}(x-(1)), \\\\y&=- \\frac{x}{4} + \\frac{17}{4}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=- \\frac{1}{4}x+\\left(\\frac{17}{4}\\right), \\\\x&=17.\n\\end{aligned}\n$$\n\nThe intersection is $(17,0)$."} {:db/id #edb/ref 17592186711056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "672a3e83-d2f3-516d-ad05-e4955657a2d8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711055}] :answer-field/correct {:answer/id #uuid "672a3e83-d2f3-516d-ad05-e4955657a2d8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186711055} :answer-field/id #uuid "97e0f03e-c086-5b58-9ad3-8e7be34173cb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711058} {:answer-field/choices [{:answer/id #uuid "5731d32f-6d9c-5e8d-8dea-fd32ad0d1d2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{46}{5}" :db/id #edb/ref 17592186711051}] :answer-field/correct {:answer/id #uuid "5731d32f-6d9c-5e8d-8dea-fd32ad0d1d2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{46}{5}" :db/id #edb/ref 17592186711051} :answer-field/id #uuid "b5b31739-414a-50c0-93d4-b88fd0185e61" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186711059}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6ffc271a-c092-532f-b23f-0664c0e4304c" :question/problem "Find where the normal line to the curve $y=4\\sqrt{x}+3x+2$ at the point with $x$-coordinate $1$ intersects the $y$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values." :question/worked-solution "First find the point on the curve.\n\n$$\nf(1)=4\\sqrt{(1)}+3(1)+2=9.\n$$\n\nThe normal passes through $(1,9)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=4 x^{\\frac{1}{2}} + 3 x + 2, \\\\f'(x)&=3 + \\frac{2}{x^{\\frac{1}{2}}}=3 + \\frac{2}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(1)&=3 + \\frac{2}{\\sqrt{(1)}}=5, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(5)}=- \\frac{1}{5}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(1,9)$.\n\n$$\n\\begin{aligned}\ny-(9)&=- \\frac{1}{5}(x-(1)), \\\\y&=- \\frac{x}{5} + \\frac{46}{5}.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$.\n\n$$\n\\begin{aligned}\ny&=- \\frac{1}{5}\\cdot 0+\\left(\\frac{46}{5}\\right), \\\\y&=\\frac{46}{5}.\n\\end{aligned}\n$$\n\nThe intersection is $\\left(0,\\frac{46}{5}\\right)$."}] :knowledge-point/title "Determining the Intercepts of a Normal Line"}] [{:db/id #edb/ref 17592186096652 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096451 :question/id #uuid "dccb5bac-e528-5b42-9949-36b3870fdde1" :question/math-academy-id "e-4287" :question/problem "Consider the picture below. Given that $\\mathbf{m}=\\lambda\\mathbf{n}+\\mu\\mathbf{k}$, find $\\lambda$ and $\\mu$.\n\n![](images/b8/b8abf22d14f93a38c4d01f368b8171e4ccfe90086d932f5b58453baa46391405.png)" :question/worked-solution "![](images/76/76b9867a7c1ef484922241ebe44272f0104e406c31310bf36227a13850f50d8b.png)\n\nIn $\\bigtriangleup ONM$ shown above, we have:\n\n- $ON=2|\\mathbf{n}|$;\n\n- $\\overrightarrow{ON}$ and $\\mathbf{n}$ have the same direction\n\nHence, $\\overrightarrow{ON}=2\\mathbf{n}$.\n\nSimilarly:\n\n- $NM=2|\\mathbf{k}|$\n\n- $\\overrightarrow{NM}$ and $\\mathbf{k}$ have the same direction\n\nHence, $\\overrightarrow{NM}=2\\mathbf{k}$.\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{m} & =\\overset{\\to }{ON}+\\overset{\\to }{NM} \\\\  & =2\\mathbf{n}+2\\mathbf{k}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{m}=\\lambda\\mathbf{n}+\\mu\\mathbf{k}=2\\mathbf{n}+2\\mathbf{k}$. \n\nSince $\\mathbf{n} \\nparallel \\mathbf{k},$ the linear combination can only be written in one way. Equating the coefficients of $\\mathbf{n}$ and $\\mathbf{k}$, we get:\n\n- $\\lambda=2$ and $\\mu=2$"} :knowledge-point/id #uuid "45b6a076-8795-5510-aabc-62a925826dd0" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186760550 :question-generator/id #uuid "34a8e084-306b-590d-b35c-b4881660fab5" :question-generator/script "generators/96/9693dbd86c4e683135a9b2aabc4d866e1b53419d1d216999bc1ae223a2d73cd4/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f77c7b4-45a3-55b8-b6d7-7134a1c5b198" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =2$" :db/id #edb/ref 17592186285217} {:answer/id #uuid "4cd7c2f1-51ee-5686-91ae-4e42859d9003" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2.5$ and $\\mu =-2$" :db/id #edb/ref 17592186285505} {:answer/id #uuid "847a4d81-38dd-55d5-a14b-b622eb3de871" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =2$" :db/id #edb/ref 17592186286007} {:answer/id #uuid "ad470f62-fea2-533b-bd6f-9ee937e27815" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1.5$ and $\\mu =2$" :db/id #edb/ref 17592186286373} {:answer/id #uuid "dd53d27b-3e7e-58e0-8170-15ca40f8c8d0" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =-2$" :db/id #edb/ref 17592186286801}] :answer-field/correct {:answer/id #uuid "2f77c7b4-45a3-55b8-b6d7-7134a1c5b198" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =2$" :db/id #edb/ref 17592186285217} :answer-field/id #uuid "245a581a-aa5d-50db-805d-7bc423b9814c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287226}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1b7aee39-22ab-5444-970d-797a67e85565" :question/math-academy-id "q-19370" :question/problem "![](images/a1/a1e251e00a99520cc392d031dbd05646ce07b65319d829e2cd8fc6f80e6e29a2.png)\n\nConsider the picture above. Given that $\\mathbf{c}=\\lambda \\mathbf{a}+\\mu \\mathbf{b}$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/60/601e049067de307ef2321ae9b516d1c7306d837ca0758c080074446a8c54389d.png)\n\nIn $△OAC$ shown above, we have:\n\n- $OA=2|\\mathbf{a}|$\n\n- $\\overset{\\to }{OA}$ and $\\mathbf{a}$ have the same direction\n\nHence, $\\overset{\\to }{OA}=2\\mathbf{a}.$\n\nSimilarly:\n\n- $AC=2|\\mathbf{b}|$\n\n- $\\overset{\\to }{AC}$ and $\\mathbf{b}$ have the same direction\n\nHence, $\\overset{\\to }{AC}=2\\mathbf{b}.$\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{c} & =\\overset{\\to }{OA}+\\overset{\\to }{AC} \\\\  & =2\\mathbf{a}+2\\mathbf{b}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{c}=\\lambda \\mathbf{a}+\\mu \\mathbf{b}=2\\mathbf{a}+2\\mathbf{b}.$ \n\nSince $\\mathbf{a}∦\\mathbf{b},$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =2$ and $\\mu =2$"} {:db/id #edb/ref 17592186097241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1754eccd-ec7f-5204-806f-ed41f26894fe" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =3$" :db/id #edb/ref 17592186327138} {:answer/id #uuid "58b7e4a1-6805-552d-86f2-f1434646a625" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =3.5$" :db/id #edb/ref 17592186327711} {:answer/id #uuid "63ebdee6-5ead-50c1-9a1a-f01abc2adffe" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =2$" :db/id #edb/ref 17592186327802} {:answer/id #uuid "a67826f4-23a8-5cfb-a73c-187b9a6eec4d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =-2$" :db/id #edb/ref 17592186328374} {:answer/id #uuid "f607dfd9-32a2-5e67-932b-093b37e029ba" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-2.5$" :db/id #edb/ref 17592186329090}] :answer-field/correct {:answer/id #uuid "a67826f4-23a8-5cfb-a73c-187b9a6eec4d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =-2$" :db/id #edb/ref 17592186328374} :answer-field/id #uuid "703a83ec-ece6-50c6-955a-a6ccb5003bf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329373}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a6df187f-d344-54eb-95de-18be02ffa7f9" :question/math-academy-id "q-42670" :question/problem "![](images/01/01940c9fa894d635300a49867da35d483b873a45d2a75204c20c58e4cb84c883.png)\n\nConsider the picture above. Given that $\\mathbf{t}=\\lambda \\mathbf{r}+\\mu \\mathbf{s}$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/a0/a0d9fa1c366945e5e789b6361f929357af163db2e9be4a3ccc9023c12486aca6.png)\n\nIn $△ORT$ shown above, we have:\n\n- $OR=2|\\mathbf{r}|$\n\n- $\\overset{\\to }{OR}$ has the opposite direction to $\\mathbf{r}$\n\nHence, $\\overset{\\to }{OR}=-2\\mathbf{r}.$\n\nSimilarly:\n\n- $RT=2|\\mathbf{s}|$\n\n- $\\overset{\\to }{RT}$ has the opposite direction to $\\mathbf{s}$\n\nHence, $\\overset{\\to }{RT}=-2\\mathbf{s}.$\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{t} & =\\overset{\\to }{OR}+\\overset{\\to }{RT} \\\\  & =-2\\mathbf{r}-2\\mathbf{s}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{t}=\\lambda \\mathbf{r}+\\mu \\mathbf{s}=-2\\mathbf{r}-2\\mathbf{s}.$ \n\nSince $\\mathbf{s}∦\\mathbf{r},$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-2$ and $\\mu =-2$"} {:db/id #edb/ref 17592186256375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dcfec14-cb0a-5093-aca2-c64dcab4c730" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-2$" :db/id #edb/ref 17592186253787} {:answer/id #uuid "1272e74e-fb78-59d2-9d84-d72aa670ad11" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =-2$" :db/id #edb/ref 17592186253830} {:answer/id #uuid "3e10a9f2-1e2c-5cf1-b294-748c37da198c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-3$" :db/id #edb/ref 17592186254206} {:answer/id #uuid "cc9b310f-087d-588a-be38-6cb7b7a187b7" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =3$" :db/id #edb/ref 17592186255489} {:answer/id #uuid "cebf7021-3b8a-5c16-b5a9-e42a4a2ed96f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =-3$" :db/id #edb/ref 17592186255508}] :answer-field/correct {:answer/id #uuid "1272e74e-fb78-59d2-9d84-d72aa670ad11" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =-2$" :db/id #edb/ref 17592186253830} :answer-field/id #uuid "0d68256d-13fe-57b1-b3cf-f8ae54b5b98f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255937}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cf2e5cbf-66fb-56e7-95be-719efd096999" :question/math-academy-id "q-120268" :question/problem "![](images/25/25717d521feeec25f7b4b722ca7b8a4ee9b5fdc8423bac06953e5f2adc8eef3d.png)\n\nConsider the picture above. Given that $\\mathbf{t}=\\lambda \\mathbf{r}+\\mu \\mathbf{s}$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/d5/d585c949d7de8cc3fa2d62bfb60990af12242c32ef3390e563f7e627844c5a88.png)\n\nIn $△ORT$ shown above, we have:\n\n- $OR=3|\\mathbf{r}|$\n\n- $\\overset{\\to }{OR}$ and $\\mathbf{r}$ have the same direction\n\nHence, $\\overset{\\to }{OR}=3\\mathbf{r}.$\n\nSimilarly:\n\n- $RT=2|\\mathbf{s}|$\n\n- $\\overset{\\to }{RT}$ has the opposite direction to $\\mathbf{s}$\n\nHence, $\\overset{\\to }{RT}=-2\\mathbf{s}.$\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{t} & =\\overset{\\to }{OR}+\\overset{\\to }{RT} \\\\  & =3\\mathbf{r}-2\\mathbf{s}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{t}=\\lambda \\mathbf{r}+\\mu \\mathbf{s}=3\\mathbf{r}-2\\mathbf{s}.$ \n\nSince $\\mathbf{s}∦\\mathbf{r},$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =3$ and $\\mu =-2$"} {:db/id #edb/ref 17592186256377 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0956f584-e832-537c-9bfd-df2ed29f604c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =-4$" :db/id #edb/ref 17592186253740} {:answer/id #uuid "8e097b9e-5e91-54a9-9371-58923e289845" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =4$" :db/id #edb/ref 17592186254922} {:answer/id #uuid "b6ddd4ba-6c17-5bcf-8e2d-4f52eaf316fd" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\mu =-2$" :db/id #edb/ref 17592186255291} {:answer/id #uuid "cc1c43e3-09e0-524d-a0a4-f5fb8a9c819c" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =2$" :db/id #edb/ref 17592186255483} {:answer/id #uuid "e2fc6d53-d302-54b7-88b6-3eff72e7c370" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\mu =-4$" :db/id #edb/ref 17592186255682}] :answer-field/correct {:answer/id #uuid "b6ddd4ba-6c17-5bcf-8e2d-4f52eaf316fd" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ and $\\mu =-2$" :db/id #edb/ref 17592186255291} :answer-field/id #uuid "55a3dfd2-fcbc-54d2-80df-42dfa9700a6d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256087}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "15e9fa4b-b469-5d54-bb3e-fd8c74e844aa" :question/math-academy-id "q-120277" :question/problem "![](images/c9/c991e8d6cc9cb869db0a0a663830f255f33dd32756167a5e665b2e4318ae7014.png)\n\nConsider the picture above. Given that $\\mathbf{r}=\\lambda \\mathbf{p}+\\mu \\mathbf{q}$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/a9/a9dcb3e3cd825cf24103f3636b79418531f8b8a14a5f6c83b9b94780fdf8739b.png)\n\nIn $△OPR$ shown above, we have \n\n- $OP=4|\\mathbf{p}|$\n\n- $\\overset{\\to }{OP}$ and $\\mathbf{p}$ have the same direction\n\nHence, $\\overset{\\to }{OP}=4\\mathbf{p}.$\n\nSimilarly:\n\n- $PR=2|\\mathbf{q}|$\n\n- $\\overset{\\to }{PR}$ has the opposite direction to $\\mathbf{q}$\n\nHence, $\\overset{\\to }{PR}=-2\\mathbf{q}.$\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{r} & =\\overset{\\to }{OP}+\\overset{\\to }{PR} \\\\  & =4\\mathbf{p}-2\\mathbf{q}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{r}=\\lambda \\mathbf{p}+\\mu \\mathbf{q}=4\\mathbf{p}-2\\mathbf{q}.$\n\nSince $\\mathbf{p}∦\\mathbf{q},$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =4$ and $\\mu =-2$"} {:db/id #edb/ref 17592186256378 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3720d5ea-8c76-53f9-b41b-1454af520571" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =-1$" :db/id #edb/ref 17592186254146} {:answer/id #uuid "61a80033-8bee-5b84-b56a-7cb802b9895a" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =1$" :db/id #edb/ref 17592186254544} {:answer/id #uuid "649996fe-b9a2-51bc-9110-e9d71b6a1d00" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =-2$" :db/id #edb/ref 17592186254571} {:answer/id #uuid "af5d8017-d027-550d-b7c5-936f4606ab26" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\mu =-2$" :db/id #edb/ref 17592186255212} {:answer/id #uuid "e69bcee0-66da-5af1-bec9-f709395b6bab" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =2$" :db/id #edb/ref 17592186255700}] :answer-field/correct {:answer/id #uuid "af5d8017-d027-550d-b7c5-936f4606ab26" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\mu =-2$" :db/id #edb/ref 17592186255212} :answer-field/id #uuid "e43afca9-d6cc-50ae-85ea-bc2853cb618f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256326}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "281f178c-d09e-5385-8ce5-3504549094a9" :question/math-academy-id "q-120279" :question/problem "![](images/fc/fc7d37da99173b7fa99f2f5f0bbf1478a54505628ed827488a18b3d01535f81f.png)\n\nConsider the picture above. Given that $\\mathbf{l}=\\lambda \\mathbf{j}+\\mu \\mathbf{k}$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/6c/6c9273c0b89d4c06c8a8591b8e8e94b0c83b2d1d4bd04b64ed8cb0a185619b5f.png)\n\nIn $△OJL$ shown above, we have \n\n- $OJ=|\\mathbf{j}|$\n\n- $\\overset{\\to }{OJ}$ has the opposite direction to $\\mathbf{j}$\n\nHence, $\\overset{\\to }{OJ}=-\\mathbf{j}.$\n\nSimilarly:\n\n- $JL=2|\\mathbf{k}|$\n\n- $\\overset{\\to }{JL}$ has the opposite direction to $\\mathbf{k}$\n\nHence, $\\overset{\\to }{JL}=-2\\mathbf{k}.$\n\nAdditionally, \n\n$$\n\\begin{aligned}\\mathbf{l} & =\\overset{\\to }{OJ}+\\overset{\\to }{JL} \\\\  & =-\\mathbf{j}-2\\mathbf{k}.\\end{aligned}\n$$\n\nConsequently, $\\mathbf{l}=\\lambda \\mathbf{j}+\\mu \\mathbf{k}=-\\mathbf{j}-2\\mathbf{k}.$\n\nSince $\\mathbf{j}∦\\mathbf{k},$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-1$ and $\\mu =-2$"} {:db/id #edb/ref 17592186256379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4a9886-9cdf-527a-b227-543172b052f5" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =2$" :db/id #edb/ref 17592186253759} {:answer/id #uuid "2da17495-8691-5696-bd53-f949d4ef7fe3" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-2$" :db/id #edb/ref 17592186254079} {:a