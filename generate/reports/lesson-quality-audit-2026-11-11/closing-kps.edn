=3 - 3 x\n\\end{aligned}\n$$\n\nThus $a=-3$ and $b=3$."} {:db/id #edb/ref 17592186710893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d39adbcf-6e32-54c9-824b-deb1a4f808bf" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186710906} {:answer/id #uuid "b6cdf5fd-3a35-4f83-b186-845ef7df2b60" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186760413}] :answer-field/correct {:answer/id #uuid "d39adbcf-6e32-54c9-824b-deb1a4f808bf" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186710906} :answer-field/id #uuid "0df26ba0-d46f-56b3-b2c5-23a3fada5154" :answer-field/key "intercept" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710889} {:answer-field/choices [{:answer/id #uuid "6638c2c9-55b0-552f-80bb-a7c64bd670d3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186710898}] :answer-field/correct {:answer/id #uuid "6638c2c9-55b0-552f-80bb-a7c64bd670d3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186710898} :answer-field/id #uuid "737b0f49-01f6-575c-afd4-49572dd4916c" :answer-field/key "slope" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710900}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "370df53f-4b7b-5565-be20-ed11618953e7" :question/problem "Find the equation of the normal line to the curve $y=- \\frac{1}{x} + \\frac{1}{x^{2}}$ at $\\left(1,0\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}" :question/worked-solution "Let $f(x)=- \\frac{1}{x} + \\frac{1}{x^{2}}$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(-1x^{-1})+(1x^{-2})+(0)\\\\\nf'(x)&=\\frac{1}{x^{2}} - \\frac{2}{x^{3}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(1\\right)=\\frac{1}{\\left(1\\right)^{2}} - \\frac{2}{\\left(1\\right)^{3}}=-1\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(-1\\right)}=1.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(0\\right)&=1\\left(x-\\left(1\\right)\\right)\\\\\ny&=x+\\left(-1\\right)+\\left(0\\right)\\\\\ny&=x - 1\n\\end{aligned}\n$$\n\nThus $a=1$ and $b=-1$."} {:db/id #edb/ref 17592186710896 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b074f9b3-5ff7-5e20-b5ee-e17ecbdce27c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186710905}] :answer-field/correct {:answer/id #uuid "b074f9b3-5ff7-5e20-b5ee-e17ecbdce27c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186710905} :answer-field/id #uuid "5dce708a-cec0-5a27-b8ab-776ebfd4aa60" :answer-field/key "slope" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710897} {:answer-field/choices [{:answer/id #uuid "7a1258ec-8c2d-5304-a5cf-b515b2263b7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186710901}] :answer-field/correct {:answer/id #uuid "7a1258ec-8c2d-5304-a5cf-b515b2263b7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186710901} :answer-field/id #uuid "7c1f9066-2ce2-50f6-9b77-1b6a49c5e38c" :answer-field/key "intercept" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710902}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3da4aa6b-7924-5566-a469-98bfaa7f4a5a" :question/problem "Find the equation of the normal line to the curve $y=\\sqrt[3]{x} - x + 2$ at $\\left(1,2\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}" :question/worked-solution "Let $f(x)=\\sqrt[3]{x} - x + 2$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(1x^{\\frac{1}{3}})+(-1x^{1})+(2)\\\\\nf'(x)&=-1 + \\frac{1}{3 x^{\\frac{2}{3}}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(1\\right)=-1 + \\frac{1}{3 \\left(1\\right)^{\\frac{2}{3}}}=- \\frac{2}{3}\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(- \\frac{2}{3}\\right)}=\\frac{3}{2}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(2\\right)&=\\frac{3}{2}\\left(x-\\left(1\\right)\\right)\\\\\ny&=\\frac{3 x}{2}+\\left(- \\frac{3}{2}\\right)+\\left(2\\right)\\\\\ny&=\\frac{3 x}{2} + \\frac{1}{2}\n\\end{aligned}\n$$\n\nThus $a=\\frac{3}{2}$ and $b=\\frac{1}{2}$."} {:db/id #edb/ref 17592186710899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d27aaf8-a8b9-5c3b-8403-eeb02ac8e044" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{67}{3}" :db/id #edb/ref 17592186710895}] :answer-field/correct {:answer/id #uuid "3d27aaf8-a8b9-5c3b-8403-eeb02ac8e044" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{67}{3}" :db/id #edb/ref 17592186710895} :answer-field/id #uuid "0e9ec911-f925-5e6b-b77f-319804c27582" :answer-field/key "intercept" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710890} {:answer-field/choices [{:answer/id #uuid "97d40f7e-c650-549b-b53c-949b6a5a32ce" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{16}{3}" :db/id #edb/ref 17592186710903}] :answer-field/correct {:answer/id #uuid "97d40f7e-c650-549b-b53c-949b6a5a32ce" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{16}{3}" :db/id #edb/ref 17592186710903} :answer-field/id #uuid "9ec2359a-cc74-5634-a4da-047c270022be" :answer-field/key "slope" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710904}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6aaeaf7d-6905-59cf-a6a9-bc97eccf759d" :question/problem "Find the equation of the normal line to the curve $y=2 - \\frac{2}{x} - \\frac{1}{\\sqrt{x}}$ at $\\left(4,1\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}" :question/worked-solution "Let $f(x)=2 - \\frac{2}{x} - \\frac{1}{\\sqrt{x}}$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(-1x^{- \\frac{1}{2}})+(-2x^{-1})+(2)\\\\\nf'(x)&=\\frac{2}{x^{2}} + \\frac{1}{2 x^{\\frac{3}{2}}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(4\\right)=\\frac{2}{\\left(4\\right)^{2}} + \\frac{1}{2 \\left(4\\right)^{\\frac{3}{2}}}=\\frac{3}{16}\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(\\frac{3}{16}\\right)}=- \\frac{16}{3}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(1\\right)&=- \\frac{16}{3}\\left(x-\\left(4\\right)\\right)\\\\\ny&=- \\frac{16 x}{3}+\\left(\\frac{64}{3}\\right)+\\left(1\\right)\\\\\ny&=\\frac{67}{3} - \\frac{16 x}{3}\n\\end{aligned}\n$$\n\nThus $a=- \\frac{16}{3}$ and $b=\\frac{67}{3}$."}] :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] [{:db/id #edb/ref 17592186092384 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091953 :question/id #uuid "4a734f55-ceac-587c-a831-fa8bed578a99" :question/math-academy-id "e-148" :question/problem "Find the slope of the normal line to the curve $y = 2x^3 -x^2$ at the point $(1,1).$" :question/worked-solution "Let $f(x) = 2x^3-x^2.$ First, we compute the derivative:\n\n$$\nf'(x)  =6x^2 -2x\n$$\n\nThen, we compute the slope of the tangent at the point $(1,1)\\mathbin{:}$\n\n$$\nm=f'(1) = 6(1)^2 - 2(1) = 4\n$$\n\nTherefore, the slope of the normal line $m'$ is\n\n$$\nm' = -\\dfrac{1}{m} = -\\dfrac 1 4.\n$$"} :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/key-