\\\n\\left(-5\\right)y&=-x+\\left(1\\right)+\\left(-5\\right)\\\\\nx+\\left(-5\\right)y&=-4\n\\end{aligned}\n$$\n\nThe coefficient is $-5$ and the constant is $-4$."} {:db/id #edb/ref 17592186710847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67f1a07f-294b-533e-8022-8ccf3aaa7dab" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186710834}] :answer-field/correct {:answer/id #uuid "67f1a07f-294b-533e-8022-8ccf3aaa7dab" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186710834} :answer-field/id #uuid "3005e883-f84f-55cb-bff0-e17f047ad6a6" :answer-field/key "coefficient" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710832} {:answer-field/choices [{:answer/id #uuid "e8e019a6-dabe-54fd-9a88-f79af0ba6982" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186710849}] :answer-field/correct {:answer/id #uuid "e8e019a6-dabe-54fd-9a88-f79af0ba6982" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186710849} :answer-field/id #uuid "ba2554b0-7cec-5b82-9cf5-8c7126f5fd24" :answer-field/key "constant" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710845}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d03f313c-8bb4-5094-a138-cc4b4715cf6a" :question/problem "Find the equation of the normal line to the curve $y=- 2 x^{2} + x + 2$ at $\\left(-1,-1\\right)$.\n\nGive exact values of $a$ and $b$ in $x+ay=b$.\n\n$a=$ {{coefficient}}\n\n$b=$ {{constant}}" :question/worked-solution "Let $f(x)=- 2 x^{2} + x + 2$. Differentiate:\n\n$$\nf'(x)=1 - 4 x\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(-1\\right)=1 - 4 \\left(-1\\right)=5\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(5\\right)}=- \\frac{1}{5}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(-1\\right)&=- \\frac{1}{5}\\left(x-\\left(-1\\right)\\right)\\\\\ny&=- \\frac{x}{5}+\\left(- \\frac{1}{5}\\right)+\\left(-1\\right)\\\\\ny&=- \\frac{x}{5} - \\frac{6}{5}\\\\\n\\left(5\\right)y&=-x+\\left(-1\\right)+\\left(-5\\right)\\\\\nx+\\left(5\\right)y&=-6\n\\end{aligned}\n$$\n\nThe coefficient is $5$ and the constant is $-6$."} {:db/id #edb/ref 17592186710850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71e52866-fd7a-55b4-899f-2f6342075678" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186710836}] :answer-field/correct {:answer/id #uuid "71e52866-fd7a-55b4-899f-2f6342075678" :answer/type {:db/ident :answer.type/math} :answer/value "-22" :db/id #edb/ref 17592186710836} :answer-field/id #uuid "0b9aa683-b8b1-58ca-846d-07b7f92c9a7b" :answer-field/key "constant" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710829} {:answer-field/choices [{:answer/id #uuid "972b898d-cda6-59db-8843-f9b0ef514246" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186710838}] :answer-field/correct {:answer/id #uuid "972b898d-cda6-59db-8843-f9b0ef514246" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186710838} :answer-field/id #uuid "602fcc14-c0d1-5d8d-a81d-3f0fe7ea523f" :answer-field/key "coefficient" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186710833}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e9385658-8fe5-5ec0-96da-596e4cc0593e" :question/problem "Find the equation of the normal line to the curve $y=\\frac{x^{6}}{8} - x^{3} - 2$ at $\\left(2,-2\\right)$.\n\nGive exact values of $a$ and $b$ in $x+ay=b$.\n\n$a=$ {{coefficient}}\n\n$b=$ {{constant}}" :question/worked-solution "Let $f(x)=\\frac{x^{6}}{8} - x^{3} - 2$. Differentiate:\n\n$$\nf'(x)=\\frac{3 x^{5}}{4} - 3 x^{2}\n$$\n\nEvaluate the tangent slope 