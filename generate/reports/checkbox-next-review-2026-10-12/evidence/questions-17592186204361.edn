2%$."}] [{:db/id #edb/ref 17592186209501 :knowledge-point/_questions [{:db/id #edb/ref 17592186208602 :knowledge-point/id #uuid "c7db035b-ef49-507d-b0a5-9bacd9f1ce54" :knowledge-point/title "Identifying True Statements About Resampling" :topic/_knowledge-points [{:db/id #edb/ref 17592186050696 :topic/math-academy-id 6073 :topic/title "Interpreting Survey Data"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a5f23f9-9b75-5908-87b9-7b89d2bb1410" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186208266} {:answer/id #uuid "db324513-37a4-59f3-b63f-7a149fa45dbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186208267} {:answer/id #uuid "fb9038f4-af8e-5585-8ac6-9601f9bb2cab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186208268} {:answer/id #uuid "67435cf9-e6bc-589d-8169-b85a9b61e7a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186208269} {:answer/id #uuid "71ef1013-949b-580a-ad7b-26c39dffa82a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186208270}] :answer-field/id #uuid "bfabfcdc-a285-5091-af98-5600d2e1fd69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186208265}] :question/id #uuid "4b754e28-6015-5723-8fb0-15f7da784930" :question/math-academy-id "q-325424" :question/problem "A health department surveyed $1,000$ residents who were selected at random from a small city and asked, “Have you received a flu vaccine in the past year?” Of those surveyed, $40%$ responded “yes”.\n\nBased on this result, which of the following conclusions are appropriate?\n\n1. Of all residents in the city, approximately $40%$ have received a flu vaccine in the past year.\n2. If another $1,000$ residents selected at random from the city were surveyed, the proportion who say “yes” is likely to be close to $40%$.\n3. If $1,000$ residents selected at random from a different city were surveyed, the proportion who say “yes” is likely to be close to $40%$."}] [{:db/id #edb/ref 17592186213558 :knowledge-point/_questions [{:db/id #edb/ref 17592186213043 :knowledge-point/id #uuid "68f8ea18-e3c1-5c90-8eb2-ea6f91430061" :knowledge-point/title "Comparing Means" :topic/_knowledge-points [{:db/id #edb/ref 17592186048845 :topic/math-academy-id 6191 :topic/title "Comparing Means"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bd38872-e7eb-5c1b-b9c2-d45a82701d94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186211112} {:answer/id #uuid "abd7769e-fe9c-5abb-8bfe-907737964019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186211113} {:answer/id #uuid "e6e5abaa-50a6-5205-8def-70eeff63a16e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186211114} {:answer/id #uuid "2f8dce56-756e-5c4e-aaae-62c607cd7de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186211115} {:answer/id #uuid "60e69701-14b5-522b-8f0e-1fa79c2b6b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186211116}] :answer-field/id #uuid "c7636610-9d4c-5c97-9de8-f992e6cb11a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186211111}] :question/id #uuid "77421e76-db95-56d6-902f-9b6bf7435ef8" :question/math-academy-id "