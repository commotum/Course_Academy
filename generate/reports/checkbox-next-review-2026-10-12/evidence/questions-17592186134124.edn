 17592186048175 :topic/math-academy-id 2130 :topic/title "Type I, II, and III Regions in Three-Dimensional Space"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ead561f7-6f7a-5e66-b286-0ae0b65b83c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186133069} {:answer/id #uuid "f4d99310-f9fa-5d9f-ad44-4c854d8487aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186133070} {:answer/id #uuid "240827c5-2f3f-5a88-aac5-fd1a51e70134" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186133071} {:answer/id #uuid "2cc64f1f-c5f3-5c8a-bd3e-76ba91c27c0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186133072} {:answer/id #uuid "3fbc1f8f-f2a5-5332-b5b3-607f4c20db39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186133073}] :answer-field/id #uuid "8fec8c0b-ad53-5cec-8c04-7e0da2a1a2ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133068} {:answer-field/choices [{:answer/id #uuid "5c99b5b9-773e-5e03-a0b7-cacd872b5293" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186377676} {:answer/id #uuid "baa1bcbe-0df8-5b8b-9df6-4ff581ce1331" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186377677} {:answer/id #uuid "018baa17-0daf-5001-ae92-b085ea7a2d42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186377678} {:answer/id #uuid "f7c0618a-8015-5180-8421-5a4982e4ac5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186377679} {:answer/id #uuid "5dc53d63-74c5-56d6-87e9-4d9c67bc8bd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186377680}] :answer-field/correct {:answer/id #uuid "5c99b5b9-773e-5e03-a0b7-cacd872b5293" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186377676} :answer-field/id #uuid "cb3b72e4-1edf-5a7b-9c3f-29360f653f5d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6a2c881-3c28-538f-8375-0f4ff69a8861" :question/math-academy-id "q-73671" :question/problem "The region $R$ is bounded between the elliptic paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=2x.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{f}_{1}(x,y)\\le z\\le {f}_{2}(x,y)}\n$$\n\n \nas a type I region in three-dimensional space, which of the following statements are true?\n\n- $D={(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1}$\n- $D={(x,y)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1}$\n- ${f}_{1}(x,y)={x}^{2}+{y}^{2}$ and ${f}_{2}(x,y)=2x$" :question/worked-solution "A typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](images/05/05f940e247c6cd5d862d81fc3a34658353bef5513dfe862bbc67a120c0345838.png)\n\n \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false, while statement II is true. \n\nFirst, we find the projection of the intersection between the elliptic paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=2x$ onto $xy$-plane.\n\nNotice that the equation of the plane is already solved for $z.$ Substituting this expression for $z$ into the equation of the paraboloid, we obtain:\n\n$$\n\\begin{aligned}2x & ={x}^{2}+{y}^{2} \\\\ {x}^{2}-2x+{y}^{2} & =0 \\\\ ({x}^{2}-2x+1)+{y}^{2} & =1 \\\\ (x-1)^{2}+{y}^{2} & =1\\end{aligned}\n$$\n\n \nSo, the projection of the intersection is the circle $(x-1)^{2}+{y}^{2}=1$ centered at $(1,0)$ in the $xy$-plane. Hence, the domain $D$ is given by the following disc:\n\n$$\nD={(x,y)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1}\n$$\n\n- Statement III is true. We have that $z$ is \n\n- bounded *below* by ${f}_{1}(x,y)={x}^{2}+{y}^{2},$ and\n\n- bounded *above* by ${f}_{2}(x,y)=2x.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186134543 :knowledge-point/_questions [{:db/id #edb/ref 17592186133745 :knowledge-point/id #uuid "f0379ee2-f2ed-5a3f-b23d-b7175298b333" :knowledge-point/title "Classifying Irrational and Real Numbers" :topic/_knowledge-points [{:db/id #edb/ref 17592186050300 :topic/math-academy-id 2205 :topic/title "The Real Number System"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "958d3877-9a0a-5d95-9fe3-2b242a1204ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186133297} {:answer/id #uuid "18200be8-6821-5a0f-8230-c9930818341f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186133298} {:answer/id #uuid "4f549f3d-06c1-5579-b5c4-f914988b6ee3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186133299} {:answer/id #uuid "609e743b-cf24-5998-8c86-31535d80b85e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186133300} {:answer/id #uuid "66458952-7009-5d3e-9b2c-270c549d2944" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186133301}] :answer-field/id #uuid "89c29e48-ed09-515f-8bf9