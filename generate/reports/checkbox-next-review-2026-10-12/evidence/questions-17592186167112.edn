| ---: | ---: | ---: | ---: |\n| $z_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186172371 :knowledge-point/_questions [{:db/id #edb/ref 17592186172123 :knowledge-point/id #uuid "5d25f416-578a-58c9-a818-b3d9527682b6" :knowledge-point/title "Testing a Hypothesis Given Two Normal Populations: Two-Tailed Tests" :topic/_knowledge-points [{:db/id #edb/ref 17592186049154 :topic/math-academy-id 3310 :topic/title "Hypothesis Tests for Two Means: Known Population Variances"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c542a3d-6605-5572-845a-58dc038750e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186169090} {:answer/id #uuid "c1e1e0f4-2060-597a-9127-10513b429dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186169091} {:answer/id #uuid "c5a2bb23-8e80-58e8-9878-56b654e177ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186169092} {:answer/id #uuid "d733762d-ef37-5848-a472-4a365a73ac0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186169093} {:answer/id #uuid "47060678-efe2-54b7-adf8-373f1c0793b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186169094}] :answer-field/id #uuid "3923feeb-1850-508f-9566-7a7e988f452c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186169089}] :question/id #uuid "6abb8f44-e65a-55dd-b5f6-d97ed476a93b" :question/math-academy-id "q-159537" :question/problem "Consider two independent samples of sizes $n_{x} = 15$ and $n_{