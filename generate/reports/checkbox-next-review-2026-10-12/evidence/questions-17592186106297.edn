edb/ref 17592186109861} {:answer-field/choices [{:answer/id #uuid "1ddd0a51-517b-5bff-8885-5e9848dd116c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403194} {:answer/id #uuid "b63c130c-1a35-56cf-9996-10fcf4c15056" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403195} {:answer/id #uuid "3cf8afbd-b37b-5a43-bb4a-92e18c922a16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403196} {:answer/id #uuid "451708fb-03c6-54ef-9db8-451358a59324" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403197} {:answer/id #uuid "027fa94d-be6c-535b-aca3-7f2637554bbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403198}] :answer-field/correct {:answer/id #uuid "027fa94d-be6c-535b-aca3-7f2637554bbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403198} :answer-field/id #uuid "1896dae5-9abf-5c8e-9b50-3e787f54d53c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403193}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "183017f0-e71f-5632-89e1-4603485e8f26" :question/math-academy-id "q-65744" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\nI. $(\\frac{\\pi }{6},\\frac{1}{2})$\nII. $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3})$\nIII. $(0,2\\pi )$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\pi }{6},\\frac{1}{2}).$ We note the following:\n\n- The point $(\\frac{1}{2},\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{6},\\frac{1}{2})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\frac{\\sqrt{3}}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3})$ does lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(0,2\\pi ).$ We note the following:\n\n- The point $(2\\pi ,0)$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=2\\pi $ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(0,2\\pi )$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$"}] [{:db/id #edb/ref 17592186111360 :knowledge-point/_questions [{:db/id #edb/ref 17592186110571 :knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Sine Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186050064 :topic/math-academy-id 1483 :topic/title "Graphing the Inverse Sine Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2c68