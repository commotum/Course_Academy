b/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186385682} {:answer/id #uuid "84fa31f9-05da-5475-a573-96801110c1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186385683} {:answer/id #uuid "a5023795-1f7c-5581-a250-76ca3c12abca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186385684}] :answer-field/correct {:answer/id #uuid "ee33778f-5e87-5116-9860-f133bf9a69ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186385681} :answer-field/id #uuid "868dfbfb-36d3-5a55-a0ee-0c52dbdca758" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385679}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb09ac10-eb5c-5627-9b3a-f58793f9c5b6" :question/math-academy-id "q-80089" :question/problem "Let $n\\in Z.$ Consider the following statement:\n\n$\\,$ If $______,$ then $n>0.$\n\nWhich of the following could be placed into the blank space above to create a statement whose proof is vacuous?\n\n- $n<0$\n- $0>1$\n- ${n}^{2}<0$" :question/worked-solution "We say that an implication has a *vacuous proof* if the antecedent is always false: \n\n$$\n\\overset{\\text{Always false}}{\\overset{⏞}{P}}⇒\\,Q\n$$\n\nIt does not matter whether the consequent is true or false. \n\nWith that in mind, let's examine our antecedents in turn.\n\n- Predicate I, defined for $n\\in Z,$ is *not* always false. $\\,\\times $\n\n- Statement II is always false. $\\,✓$\n\n- Predicate III, defined for $n\\in Z,$ is always false. $\\,✓$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186157794 :knowledge-point/_questions [{:db/id #edb/ref 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements" :topic/_knowledge-points [{:db/id #edb/ref 17592186050777 :topic/math-academy-id 2821 :topic/title "Logical Equivalence"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f645c498-658b-5078-9fb6-4e4c5b6c865d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186155686} {:answer/id #uuid "1d30b730-6613-56c6-96cb-30e7c9cf7bfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186155687} {:answer/id #uuid "37edff3d-d6a2-5dac-b9ac-c83470e59018" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186155688} {:answer/id #uuid "5b1a4a6e-cc6e-544f-9226-76312cefbec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186155689} {:answer/id #uuid "6228b7ce-0356-59aa-9a37-f700694d4a29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186155690}] :answer-field/id #uuid "9bdf601c-575e-5a43-8c60-f98ff13f9d13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186155685} {:answer-field/choices [{:answer/id #uuid "253fd746-cc25-528f-9a9a-eb428ea7257f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186382422} {:answer/id #uuid "d0b49299-399f-5827-8e60-2a557bd96385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382423} {:answer/id #uuid "57f471db-18bc-5b8a-955c-57f4582b0656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186382424} {:answer/id #uuid "e620c9be-089e-57a0-938e-62ee61a9b885" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382425} {:answer/id #uuid "699674af-2abc-5447-bd05-9fb04661ec33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186382426}] :answer-field/correct {:answer/id #uuid "e620c9be-089e-57a0-938e-62ee61a9b885" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382425} :answer-field/id #uuid "fdd56378-450c-5cb3-89b8-63c00e5cdc0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382421}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7074b983-3ace-5190-bf87-4742f8c8239b" :question/math-academy-id "q-81053" :question/problem "Which of the following statements are logically equivalent?\n\n- $¬A∧B$\n- $¬(A∨¬B)$\n- $A∨¬B$" :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬A∧B\\,$ | $\\,¬(A∨¬B)\\,$ | $\\,A∨¬B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n\nWe see that only the statements $¬A∧B$ and $¬(A∨¬B)$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186157799 