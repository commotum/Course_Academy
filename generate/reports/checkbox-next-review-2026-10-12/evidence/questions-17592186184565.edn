d "a6e6f22e-26b5-5f4e-a873-f9ca00596f0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186183861} {:answer/id #uuid "0927574c-30a3-50c5-8a73-2c6bb5ed2950" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186183862} {:answer/id #uuid "383ddf70-844a-5fcc-bb56-00efd72c0c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186183863} {:answer/id #uuid "611f561b-7f0f-57f8-8fed-eef00cfee602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186183864}] :answer-field/id #uuid "8068a26c-08a3-58fc-8240-c82a523f669a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183859} {:answer-field/choices [{:answer/id #uuid "2fd18fb4-c2f9-5240-81ba-d12b6d3c47b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186368867} {:answer/id #uuid "dac9c996-7209-56c0-b8ed-0ec89ec50520" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186368868} {:answer/id #uuid "af4bae76-ebe1-52c5-977c-586c2259c13f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186368869} {:answer/id #uuid "a5d5c23e-e444-575a-9eee-78f592f0eaf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186368870} {:answer/id #uuid "cda8a187-ba93-5403-9a86-704f09239e12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186368871}] :answer-field/correct {:answer/id #uuid "af4bae76-ebe1-52c5-977c-586c2259c13f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186368869} :answer-field/id #uuid "84f3248b-13dd-5a25-b15a-8683fa2bffbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b18f54c-8c0b-56f3-8034-8d24cc9bdc28" :question/math-academy-id "q-94772" :question/problem "Which of the following statements are true?\n\n- Any $3\\times 2$ matrix $A$ has at most $3$ distinct singular values.\n- The matrix $A=[\\begin{aligned}-1 & -2 \\\\ -1 & -5\\end{aligned}]$ has one negative singular value.\n- Any $2\\times 3$ matrix $A$ has at most $3$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $3\\times 2$ matrix and ${A}^{T}$ is a $2\\times 3$ matrix, ${A}^{T}\\,A$ must be a $2\\times 2$ matrix: \n\n$$\n{{A}^{T}}_{2\\times 3}\\times {A}_{3\\times 2}={{A}^{T}\\,A}_{2\\times 2}\n$$\n\nHence, $A$ has at most $2$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is true. Since $A$ is a $2\\times 3$ matrix and ${A}^{T}$ is a $3\\times 2$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 2}\\times {A}_{2\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186188544 :knowledge-point/_questions [{:db/id #edb/ref 17592186188293 :knowledge-point/id #uuid "169f59f9-ee45-5375-a22d-4906b7a09ad0" :knowledge-point/title "Identifying Monotonic Sequences Containing Factorials" :topic/_knowledge-points [{:db/id #edb/ref 17592186050507 :topic/math-academy-id 3861 :topic/title "Identifying Monotonic Sequences Using Ratios"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2927555-29c0-50ed-9f2e-25bd421bb2c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186185545} {:answer/id #uuid "ada2e8d6-063c-562b-9117-80c4f836d053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186185546} {:answer/id #uuid "c077b14d-cc0d-5065-9828-9fe8e781c6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186185547} {:answer/id #uuid "c1df5769-e24d-5cbb-bb3f-5904cd1478d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186185548} {:answer/id #uuid "401c1eb4-e37b-53be-a27e-bb45ff88009e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186185549}] :answer-field/id #uuid "2dbe5f3d-9702-5628-bbd2-b11ff48f9947" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186185544}] :question/id #uuid "da3a9adb-061d-57dc-91c2-3a7c45da1b8c" :question/math-academy-id "q-123831" :question/problem "Given that $a_{n} = (1)/((2n)!)$ for $n \\ge 1$, which of the following statements are true?\n\n1. $\\frac{a_{n + 1}}{a_{n}} \\ge 1$ for all $n \\ge 1$\n2. $a_{n}$ is an increasing sequence\n3. $a_{n}$ is a decreasing sequence"}] [{:db/id #edb/ref 17592186188547 :knowledge-point/_questions [{:db/id #edb/ref 17592186188295 :knowledge-point/id #uuid "70824c34-6527-5fe5-a86f-2ca683231f75" :knowledge-point/title "Determining Whether Two Continuous Random Variables are Independent" :topic/_knowl