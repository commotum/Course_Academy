8b74d7c-dacb-56bb-92c4-735bc234302a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177525}] :question/id #uuid "7ab45c0e-0c7c-5664-9875-fc74cbb23147" :question/math-academy-id "q-122861" :question/problem "Which of the following are partitions of the real interval $[1, 8]$?\n\n1. $1 < 2 < 4 < 8$\n2. ${1, 3, 4, 8}$\n3. ${2, 4, 8}$"}] [{:db/id #edb/ref 17592186179980 :knowledge-point/_questions [{:db/id #edb/ref 17592186179723 :knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line" :topic/_knowledge-points [{:db/id #edb/ref 17592186049629 :topic/math-academy-id 3697 :topic/title "Partitions of Intervals"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a3bc488-a654-58e2-acea-0cde8ca417ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186177550} {:answer/id #uuid "add59b06-7aff-5f7b-8180-26392d448211" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186177551} {:answer/id #uuid "b786bbfd-7079-5e8f-98c4-4aeea35947a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186177552} {:answer/id #uuid "5668f2db-b736-55e7-ba82-255e5d7afa67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements give a partition of $[- 2, 6]$" :db/id #edb/ref 17592186177553} {:answer/id #uuid "7dd66c47-0f50-5072-838a-2f9ab0170ca8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186177554}] :answer-field/id #uuid "aced8254-1be3-536c-8537-7e94eb28d2e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177549}] :question/id #uuid "0668e0bd-4637-511c-a263-1fb809d9cda4" :question/math-academy-id "q-122923" :question/problem "Which of the following are partitions of the real interval $[- 2, 6]$?\n\n1. ${-2,-1, 0, 6}$\n2. ${0, 2, 4, 6}$\n3. $-2 < 2 < 4 < 5$"}] [{:db/id #edb/ref 17592186179988 :knowledge-point/_questions [{:db/id #edb/ref 17592186179769 :knowledge-point/id #uuid "36996ffc-7dbc-51f8-8efe-46ed2c897045" :knowledge-point/title "Determining Whether an Affine Transformation is Orientation-Preserving" :topic/_knowledge-points [{:db/id #edb/ref 17592186049035 :topic/math-academy-id 3706 :topic/title "The Image of an Affine Transformation"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "855d042b-5e19-57c1-aebd-837a4c723fa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186177598} {:answer/id #uuid "9735d708-c926-5815-8889-5570853f02e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186177599} {:answer/id #uuid "03b940a0-833c-58d6-8a18-1c3b47ecd96f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186177600} {:answer/id #uuid "4fad0e1f-267d-5afd-b2f1-2a39b852ddd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186177601} {:answer/id #uuid "6b0c01c9-a4f7-558d-8dce-b4691d12c8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186177602}] :answer-field/correct {:answer/id #uuid "03b940a0-833c-58d6-8a18-1c3b47ecd96f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186177600} :answer-field/id #uuid "f1c4f5e0-a34a-52e9-914e-f8404a6ba8c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44bbbc90-f4f2-5074-bbff-3d0cc0edc535" :question/math-academy-id "q-124004" :question/problem "Consider the affine transformation $T$ defined as\n\n$$\nx=v-u,\\,y=u+v-1.\n$$\n\nLet $A$ be the matrix representation of the linear transformation associated with $T.$\n\nWhich of the following statements are true?\n\nI. $A=[\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]$\n\nII. $det(A)=-2$\n\nIII. The transformation $T$ is orientation-preserving" :question/worked-solution "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nLet's look at each statement in turn:\n\n- Statement I is false. Notice that the given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}v-u \\\\ u+v-1\\end{aligned}] \\\\  & =[\\begin{aligned}-u+v \\\\ u+v\\end{aligned}]+[\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & ={{[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}0 \\\\ -1\\end{aligned}]}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the matrix representation of the linear transformation associated with $T$ is $A=[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}].$\n\n- Statement II is true. Computing the determinant of $A,$ we get\n\n$$\ndet(A)=|\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}|=1\\cdot (-1)-1\\cdot 1=-2.\n$$\n\n- Statement III is false. Since $det(A)<0,$ the affine transformation $T$ is not orientation-preserving.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186180017 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field" :topic/_knowledge-points [{:db/id #edb/ref 17592186049147 :topic/math-academy-id 3694 :topic/title "Interpreting Line Integrals of Vector-Valued Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b67b2e53-a0c8-5a8b-ab4b-ba652386711f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186177772} {:answer/id #uuid "ca7605c9-de7f-5827-a732-cd950df6aaf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186177773} {:answer/id #uuid "461655a4-20ba-5050-8819-a2d4ac27734d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186177774} {:answer/id #uuid "547ccee9-b44b-5235-8cd6-c0d5e5ab7f86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186177775} {:answer/id #uuid "78ac1024-eff4-5445-b74f-f7d6bacbd27a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186177776}] :answer-field/id #uuid "8b91b8c0-4c4a-59fa-a6e4-99f749af022a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177771}] :question/id #uuid "9b9b6def-9db3-53b4-b1f4-7747acfa7a70" :question/math-academy-id "q-125364" :question/problem "![](images/b7/b70d2d8824cfbebbff2807239cf9b98796b43e8cb0f74e7e43ae25eb28b79086.png)\n\nConsider the vector field $F$ shown above, and let $C$ be the path along the segment $AB^(―)$ traversed from $A$ to $B$. Which of the following statements are true?\n\n1. $\\displaystyle \\int_{C}F \\cdot dr > 0$\n2. $\\displaystyle \\int_{C}F \\cdot dr < 0$\n3. $\\displaystyle \\int_{-C}F \\cdot dr > 0$"}] [{:db/id #edb/ref 17592186180069 :knowledge-point/_questions [{:db/id #edb/ref 17592186179825 :knowledge-point/id #uuid "b0b126f4-34f6-5dca-85ad-3359d0cccacc" :knowledge-point/title "Predicting the Effect of Removing Outliers on the Mean" :topic/_knowledge-points [{:db/id #edb/ref 17592186049393 :topic/math-academy-id 3755 :topic/title "Removing Outliers"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7c1e2a3-84db-576b-8c9a-9254743a2906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186178084} {:answer/id #uuid "d7dfff0e-09ca-5881-b033-4d1aacd902c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186178085} {:answer/id #uuid "57953172-71b9-57de-9ce6-65dced342253" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186178086} {:answer/id #uuid "74fcd043-6775-580c-a2ef-3716681a0795" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186178087} {:answer/id #uuid "7a54afb6-64cf-5b2c-98de-f6e959694d2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186178088}] :answer-field/id #uuid "5100b004-388a-5775-9958-de07ae979002" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178083}] :question/id #uuid "ce27d8f9-1ae7-58cb-95dd-6b4c2607b4a8" :question/math-academy-id "q-134388" :question/problem "Consider the following data set:\n\n$400, 450, 520, 475, 20, 380, 500$\n\nWhich of the following statements are true?\n\n1. There is one outlier, which is much smaller than all the other data set values.\n2. $380$ is an outlier of the data set.\n3. If we remove the outlier, the mean of the data will decrease."}] [{:db/id #edb/ref 17592186180084 :knowledge-point/_questions [{:db/id #edb/ref 17592186179766 :knowledge-point/id #uuid "dc613be0-2d34-5253-8fbe-7d2a5fcd0840" :knowledge-point/title "Determining Cases Where a Stream Function Exists" :topic/_knowledge-points [{:db/id #edb/ref 17592186049617 :topic/math-academy-id 3717 :topic/title "Stream Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce53b018-08fb-5296-a8f1-de4a1b3e28d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186178174} {:answer/id #uuid "d892f7b3-cd48-57f5-8d5f-18605832c2a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186178175} {:answer/id #uuid "dbd65207-09d8-5bd8-81de-ff5e61d81f7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186178176} {:answer/id #uuid "fd2ab015-d675-581f-bef8-be7cea56770b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186178177} {:answer/id #uuid "7962e927-e16e-521d-b5b8-188e13452fae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186178178}] :answer-field/id #uuid "f81076c5-e8db-519b-80c1-4d5d56cf42c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178173} {:answer-field/choices [{:answer/id #uuid "4f35cc63-5f1a-5875-b8da-434758b279ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186371956} {:answer/id #uuid "a425a202-5d95-5210-a52a-28982e2461c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186371957} {:answer/id #uuid "5a58e378-0a22-5eb5-9904-caee1f9107c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186371958} {:answer/id #uuid "9a679ce4-d01b-57c5-b9df-b6c8eec5b41c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186371959} {:answer/id #uuid "22f609ae-80c3-55be-8b2d-d58768ced6a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186371960}] :answer-field/correct {:answer/id #uuid "5a58e378-0a22-5eb5-9904-caee1f9107c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186371958} :answer-field/id #uuid "f04b844f-aa9f-5061-b4ec-346bc3d7a370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371955}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3be31acc-b938-5628-8e53-a18ffa022892" :question/math-academy-id "q-161436" :question/problem "Which of the following vector fields have a stream function?\n\n- $F(x,y)=y\\,i-x\\,j$\n- $F(x,y)=xy\\,i+{y}^{2}\\,j$\n- $F(x,y)=2x\\,i-y\\,j$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=0,\\,\\frac{∂Q}{∂y} & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0+0=0\n$$\n\n- Vector field II doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=y,\\,\\frac{∂Q}{∂y} & =2y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=y+2y\\ne 0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2,\\,\\frac{∂Q}{∂y} & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2+(-1)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186180093 :knowledge-point/_questions [{:db/id #edb/ref 17592186179766 :knowledge-point/id #uuid "dc613be0-2d34-5253-8fbe-7d2a5fcd0840" :knowledge-point/title "Determining Cases Where a Stream Function Exists" :topic/_knowledge-points [{:db/id #edb/ref 17592186049617 :topic/math-academy-id 3717 :topic/title "Stream Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8719c4c1-296a-5308-8304-35f3d974ce70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186178228} {:answer/id #uuid "90a5767b-02fa-5b05-a4c9-973f6b09f516" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186178229} {:answer/id #uuid "996baf61-e5f6-5df1-aa32-1851db148914" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186178230} {:answer/id #uuid "ff342f1d-0cbd-5406-9161-19ff3ff1afe0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186178231} {:answer/id #uuid "7776b280-63fe-5dc8-85a0-f54e021ddc7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186178232}] :answer-field/id #uuid "712e9e01-c44e-5384-90fb-ae7811625631" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178227}] :question/id #uuid "58115dca-1aaa-5449-a87f-7951d165abcc" :question/math-academy-id "