92186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186123719} {:answer/id #uuid "bd078c21-9e89-58c2-b161-6274f9988ccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186123720} {:answer/id #uuid "35983e6e-a5be-5cba-9cbf-d34ea2b13e67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186123721}] :answer-field/id #uuid "b5bf7e96-15a3-56ee-abdf-35bed217e0f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123716} {:answer-field/choices [{:answer/id #uuid "ab3a2ec4-7d03-5fd9-b43e-71c965fddbc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186392933} {:answer/id #uuid "4726f0ca-9602-5e70-8d03-916ad610a1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186392934} {:answer/id #uuid "161b1a80-54db-5e3f-a437-fd14c1174f0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186392935} {:answer/id #uuid "990c2915-e8e1-5acf-b51b-9cb9541423a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186392936} {:answer/id #uuid "33e1dc34-2d44-5b08-aa60-9beea00a4855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186392937}] :answer-field/correct {:answer/id #uuid "ab3a2ec4-7d03-5fd9-b43e-71c965fddbc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186392933} :answer-field/id #uuid "3c1098e9-a9f8-57a6-bbb4-70d81d7d6df9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392932}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3caf1655-4ce4-5a5f-995b-a06e33069b3a" :question/math-academy-id "q-65127" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)={x}^{3}y-x$ and ${f}_{y}(x,y)=x{y}^{3}-y$\n- ${f}_{x}(x,y)={e}^{x+y}-2y$ and ${f}_{y}(x,y)={e}^{x+y}-2x$\n- ${f}_{x}(x,y)=\\sqrt{x-1}$ and ${f}_{y}(x,y)=-3$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({x}^{3}y-x)={x}^{3} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x{y}^{3}-y)={y}^{3}.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{x+y}-2y)={e}^{x+y}-2 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({e}^{x+y}-2x)={e}^{x+y}-2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\sqrt{x-1})=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(-3)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'."}] [{:db/id #edb