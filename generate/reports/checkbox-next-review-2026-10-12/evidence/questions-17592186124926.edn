-ae8a-5a4d74c0604b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186122493} {:answer/id #uuid "ef84e73c-8ae0-5587-af77-f07fa2c76eaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122494} {:answer/id #uuid "15517a73-fe6f-57c4-8df5-76868e5ae9fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186122495} {:answer/id #uuid "2c2a71a3-8cf8-583a-9512-469b9cdcca29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186122496} {:answer/id #uuid "48b975ac-7089-50a5-a8d3-de4221561aa9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122497}] :answer-field/id #uuid "4d3dc8c4-e767-5c1c-b3ce-6714ba799642" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122492} {:answer-field/choices [{:answer/id #uuid "8759bd98-0381-576b-82d2-594f877a7b47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186377583} {:answer/id #uuid "253260b3-04d8-59d8-ab1a-8d8052857137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186377584} {:answer/id #uuid "e6d4b030-db2f-573f-906b-3253e792ebb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186377585} {:answer/id #uuid "732119b9-2965-5ec3-977b-f0ed584afcff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186377586} {:answer/id #uuid "5260dd83-4674-5796-ab5f-1e7b83499d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186377587}] :answer-field/correct {:answer/id #uuid "732119b9-2965-5ec3-977b-f0ed584afcff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186377586} :answer-field/id #uuid "52e022b2-1095-5f77-8168-eeda179fa12a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377582}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8871194-baee-5d59-8d60-7a847fcf31fe" :question/math-academy-id "q-36403" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y\\le 2x-4},\\,∂A={(x,y)\\in {R}^{2}:y=2x-4}.\n$$\n\nWhich of the following statements are true?\n\n- The point $P(2,0)$ lies on the boundary of $A$\n- The point $P(2,0)$ belongs to $A$\n- The point $Q(1,3)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$ \n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie on or below the line $y=2x-4.$ A sketch of this region is shown below:\n\n![](images/b2/b2449c90a6565712b535df42840b8f874d6061ed240092b02ec5672152e125aa.png)\n\nLet's add the points $P(2,0)$ and $Q(1,3)$ and some neighborhoods of these points to our diagram.\n\n![](images/4a/4a176ab71239b0ec388d96f515b5e26767086ee37463119115dfe43ef190c506.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(2,0)$ satisfy the equation $y=2x-4.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. The coordinates of $P(2,0)$ satisfy the inequality $y\\le 2x-4.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. The point $Q$ is *not* an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I and II only.'"}] [{:db/id #edb/ref 17592186124996 :knowledge-point/_questions [{:db/id #edb/ref 17592186124665 :knowledge-point/id #uuid "c83da2f5-af57-5848-b646-5fc52fee649d" :knowledge-point/title "Determining Whether a Function is One-To-One From a Mapping Diagram" :topic/_knowledge-points [{:db/id #edb/ref 17592186050525 :topic/math-academy-id 1886 :topic/title "One-To-One Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef916314-b6c4-5161-9aa4-19ec3e203584" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186122577} {:answer/id #uuid "0015e62f-c0fc-5d40-866c-cdb9d21f3bbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186122578} {:answer/id #uuid "154662df-04f4-5ab0-a521-166cd05dc14d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122579} {:answer/id #uuid "60a6ed69-4ac5-533f-b5b9-f4e411c7471c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122580} {:answer