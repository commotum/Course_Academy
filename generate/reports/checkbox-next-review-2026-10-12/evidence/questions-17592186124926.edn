6128153} {:answer/id #uuid "30e6f031-8d50-57de-b491-2b8b783102ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186128154}] :answer-field/id #uuid "c1a50c50-2b60-57e8-b02f-bbbfaf5e7c4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128149}] :question/id #uuid "d19d6145-1fb1-5d51-b074-044e9b77aefd" :question/math-academy-id "q-42369" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$A = \\begin{bmatrix}2 & 0 & 1 & 0 \\\\ 0 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}, B = \\begin{bmatrix}0 & 0 & 1 & 0 & -4 & 9 \\\\ 0 & -2 & 2 & 0 & 3 & 0 \\\\ 0 & 0 & 0 & 0 & 7 & 14\\end{bmatrix}, C = \\begin{bmatrix}0 & 1 & -2 & 0 \\\\ 0 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186129843 :knowledge-point/_questions [{:db/id #edb/ref 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration" :topic/_knowledge-points [{:db/id #edb/ref 17592186050207 :topic/math-academy-id 1992 :topic/title "Double Integrals Over Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "907234f6-d41d-59c4-b707-3a4bc0a94e07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186128540} {:answer/id #uuid "e9ed8dda-c357-5308-97b6-a92c738ce5dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186128541} {:answer/id #uuid "f9741cfe-9a2e-51ba-9f5d-1bbc05258f58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186128542} {:answer/id #uuid "0b435149-51ff-523f-b255-3bdd5a506e85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186128543} {:answer/id #uuid "704224b1-5570-5b35-8983-4889e11c0891" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186128544}] :answer-field/correct {:answer/id #uuid "0b435149-51ff-523f-b255-3bdd5a506e85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186128543} :answer-field/id #uuid "1b810ea7-b064-5fb2-907f-f94838c98873" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd6a034f-87ae-5507-9abe-98641b443d7e" :question/math-academy-id "q-71930" :question/problem "Which of the following equalities are true given that\n$D=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,1\\le y\\le 3\\}.$\n\nI. ${∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{0}^{1}{\\int }_{1}^{3}y\\sqrt{x}\\,\\text{d}x\\,\\text{d}y$\n\nII. ${∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{0}^{1}{\\int }_{1}^{3}y\\sqrt{x}\\,\\text{d}y\\,\\text{d}x$\n\nIII. ${∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{1}^{3}{\\int }_{0}^{1}y\\sqrt{x}\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that:\n\n- the limits for the variable $x$ are from $0$ to $1$, and\n\n- the limits for the variable $y$ are from $1$ to $3.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}y\\sqrt{x}\\,\\text{d}A & ={\\int }_{1}^{3}[{\\int }_{0}^{1}y\\sqrt{x}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}y\\sqrt{x}\\,\\text{d}A={\\int }_{0}^{1}[{\\int }_{1}^{3}y\\sqrt{x}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186129844 :knowledge-point/_questions [{:db/id #edb/ref 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration" :topic/_knowledge-points [{:db/id #edb/ref 17592186050207 :topic/math-academy-id 1992 :topic/title "Double Integrals Over Rectangular Domains"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e907f1cb-17f5-5f79-8b8c-fafc8b9dd88f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186128546} {:answer/id #uuid "ed915b59-581f-546e-9e76-e32331a79409" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186128547} {:answer/id #uuid "f3b45218-b6e7-5d83-bf07-df2a1f0af161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186128548} {:answer/id #uuid "0a9d52d0-248f-5b53-8547-6380bf08d8c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186128549} {:answer/id #uuid "71942d25-4356-5934-94ad-5c981c7c779b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186128550}] :answer-field/id #uuid "00993a69-8b15-5aae-bf97-533352e766d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128545}] :question/id #uuid "0fb5f305-bf89-5905-8f99-f9acec9591ca" :question/math-academy-id "q-71931" :question/problem "Which of the following equalities are true given that\n$D = {(x, y): 1 \\le x \\le \\sqrt{2}, 0 \\le y \\le 1}$.\n\n1. $∬_(D)\\frac{x}{y^{2} + 1}dA = \\displaystyle \\int_{0}^{1}\\displaystyle \\int_{1}^{\\sqrt{2}}\\frac{x}{y^{2} + 1}dxdy$\n2. $∬_(D)\\frac{x}{y^{2} + 1}dA = \\displaystyle \\int_{0}^{1}\\displaystyle \\int_{1}^{\\sqrt{2}}\\frac{x}{y^{2} + 1}dydx$\n3. $∬_(D)\\frac{x}{y^{2} + 1}dA = \\displaystyle \\int_{1}^{\\sqrt{2}}\\displaystyle \\int_{0}^{1}\\frac{x}{y^{2} + 1}dydx$"}] [{:db/id #edb/ref 17592186134071 :knowledge-point/_questions [{:db/id #edb/ref 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186049881 :topic/math-academy-id 2200 :topic/title "The Four Fundamental Subspaces of a Matrix"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f723318-1709-5627-b74a-7dff4a78f566" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186130583} {:answer/id #uuid "a66a4b1c-c351-5acd-b1da-f6251c2bd06e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186130584} {:answer/id #uuid "c75753cf-6bc7-5bd4-8a4d-76c1cf2c9812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186130585} {:answer/id #uuid "cef9deb1-4305-5b47-a43d-ccfb66e6a0c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186130586} {:answer/id #uuid "7021a159-b4e4-54cf-ac01-c64d176cf7f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186130587}] :answer-field/id #uuid "22b80526-fa23-5406-a813-f92a7a484547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130582} {:answer-field/choices [{:answer/id #uuid "2995f8a9-5212-50fb-931a-2f0ccaac570c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186362644} {:answer/id #uuid "9487c552-e6e4-51f6-83b4-93c9f8421071" :answer/type {:db/id #edb/ref 