#uuid "f5277e8b-eff2-532e-a20f-1a12230fd648" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186124068} {:answer/id #uuid "7ad34e10-4ec8-52f1-8133-9d37f4f7d029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186124069}] :answer-field/id #uuid "b34b4788-ef1a-5175-ada5-7b06299f3fe6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124064}] :question/id #uuid "7a80ea94-714a-5496-91f4-d59c30bb26ff" :question/math-academy-id "q-94851" :question/problem "Consider the vector space $R_{3}[t]$ of all polynomials in the variable $t$ over $R$ with degrees at most $3$.\n\nWhich of the following statements are true?\n\n1. ${1, t, t^{3}}$ is a linearly independent set in $R_{3}[t]$\n2. $-5t^{3} + t^{2} + t$ can be expressed as a linear combination of ${1, t, t^{3}}$\n3. ${1, t, t^{3}}$ is a basis of $R_{3}[t]$"}] [{:db/id #edb/ref 17592186125259 :knowledge-point/_questions [{:db/id #edb/ref 17592186124529 :knowledge-point/id #uuid "30d1a3a3-a6f0-522c-9161-6dc0fefb2e0d" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix and Rank-Nullity Theorems" :topic/_knowledge-points [{:db/id #edb/ref 17592186050470 :topic/math-academy-id 1966 :topic/title "The Invertible Matrix Theorem in Terms of Eigenvalues"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91ffbd7c-7887-57a5-b70e-572cfc942c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186124155} {:answer/id #uuid "dee8cb1f-5142-580d-a580-f7e20b3f2c5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186124156} {:answer/id #uuid "5400a25e-6416-5941-af6f-f4111954411d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186124157} {:answer/id #uuid "5d2c2152-51c5-5767-81cf-1efec0546976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186124158} {:answer/id #uuid "791134bc-5d35-52a9-a84e-edf9f52dbc03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186124159}] :answer-field/id #uuid "c7dc85ec-6f49-51b2-8a57-586cde836ebd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124154} {:answer-field/choices [{:answer/id #uuid "a0c4a809-e595-5fe1-952a-f166e4c993ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186380360} {:answer/id #uuid "3638c2c4-9739-5713-9eea-0c30e88b91fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186380361} {:answer/id #uuid "5365f894-7e1e-52d6-8d25-e073e21a1dc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186380362} {:answer/id #uuid "c6759071-de8d-5518-9e38-39ba12543b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186380363} {:answer/id #uuid "9b65de68-98e3-5d99-8a63-3d3a9de3bf59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186380364}] :answer-field/correct {:answer/id #uuid "3638c2c4-9739-5713-9eea-0c30e88b91fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186380361} :answer-field/id #uuid "dc0c49e1-d355-54e1-898e-c5a5deb5b1ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380359}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72b961d6-3f11-54e6-b3ea-21ca6cd541b5" :question/math-academy-id "q-97974" :question/problem "If $C$ is a $3\\times 3$ matrix and $\\text{rank}(C-5I)=3,$ which of the following statements are true?\n\n- $\\text{Null}(C-5I)={0}$\n- $C-5I$ is singular\n- $\\lambda =5$ is an eigenvalue of $C$" :question/worked-solution "Given a $3\\times 3$ matrix $M,$ we have the following by the invertible matrix theorem:\n\n$M$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(M)={R}^{3} \\\\  & \\text{dim(Col}(M))=3=\\text{rank}(M) \\\\  & \\text{Null}(M)={0} \\\\  & \\text{dim(Null}(M))=0=\\text{nullity}(M)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $M$ has $3$ columns, then \n\n$$\n\\text{rank}(M)+\\text{nullity}(M)=3.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the rank-nullity theorem, \n\n$$\n\\begin{aligned}\\text{nullity}(C-5I) & =3-\\text{rank}(C-5I) \\\\  & =3-3 \\\\  & =0.\\end{aligned}\n$$\n\nAs a result, $\\text{Null}(C-5I)={0}.$\n\n- Statements II is false. By the invertible matrix theorem, since $\\text{nullity}(C-5I)=0,$ we obtain that $C-5I$ must be non-singular.\n\n- Statement III is false. Notice that if $M=C-5I$ is non-singular, then $(C-5I)x=0$ has only zero solution.  As a result, $\\lambda =5$ can not be an eigenvalue of $C.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186129416 :knowledge-point/_questions [{:db/id #edb/ref 17592186129125 :knowledge-point/id #uuid "99c4151a-d2e0-5603-b27d-d81c76a0c7ba" :knowledge-point/title "Identifying Properties of Reciprocal Curves" :topic/_knowledge-points [{:db/id #edb/ref 17592186049313 :topic/math-academy-id 2033 :topic/title "Graphing Reciprocal Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id 