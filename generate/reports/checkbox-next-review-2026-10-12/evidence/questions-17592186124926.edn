fb37f3b24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186377666} {:answer/id #uuid "3a3a8f6e-f673-50c6-adfc-b3f584da1e61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186377667}] :answer-field/correct {:answer/id #uuid "0aa85b94-e0b7-5a39-a687-25c26ac8a992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186377664} :answer-field/id #uuid "51216ded-5b95-57bb-8fa7-e64432a5fb63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377662}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e699ccb-274c-55bb-b36e-2ab5da35b953" :question/math-academy-id "q-71882" :question/problem "![](images/33/33d777f400b53d2272636fc9c465cf83c22932d8172c5d8a35bcdd2bdaae09a1.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is a boundary point of the set $M$\n- $B$ is a boundary point of the set $M$\n- $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/46/46670ef62c2afa2e5aa5c0eb4d1684493f35ab4f9a82aa5375994bf1cb2cb154.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement II is false. The point $B$ is an interior point since there exists an open neighborhood of $B$ that is fully contained inside the set $M.$\n\n- Statement III is true. Indeed, $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is 'I and III only'."}] [{:db/id #edb/ref 17592186125216 :knowledge-point/_questions [{:db/id #edb/ref 17592186124642 :knowledge-point/id #uuid "24b9af85-3717-59e0-aa72-d701f3c6b6a8" :knowledge-point/title "Identifying Interior and Boundary Points From Nonlinear Inequalities" :topic/_knowledge-points [{:db/id #edb/ref 17592186048942 :topic/math-academy-id 1930 :topic/title "Interior and Boundary Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8275c709-4ca8-5287-afb6-8d3b36f9186c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186123897} {:answer/id #uuid "a75f4cb2-f139-58b9-aa04-4ed98561c8a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186123898} {:answer/id #uuid "096c8f5d-b6c7-5d85-9db1-f7584ff8b60f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186123899} {:answer/id #uuid "33e178fa-54f8-5974-8e7a-f5f421266282" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186123900} {:answer/id #uuid "5766bcb7-fe05-5602-945f-985df6475722" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186123901}] :answer-field/id #uuid "e8eb2afe-d338-5aa0-9b42-4afd48839454" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123896}] :question/id #uuid "4f3705f6-6b05-5981-9c91-c510c442e37e" :question/math-academy-id "q-71883" :question/problem "The set $A$ and its boundary $∂A$ are given by\n$A = {(x, y) ∈ R^{2}: \\frac{x^{2}}{3} + \\frac{y^{2}}{2} \\le 1}, ∂A = {(x, y) ∈ R^{2}: \\frac{x^{2}}{3} + \\frac{y^{2}}{2} = 1}$.\n\nWhich of the following statements are true?\n\n1. The point $Q(-1, \\frac{2}{\\sqrt{3}})$ lies on the boundary of $A$\n2. The point $P(0.5, 0.5)$ belongs to $A$\n3. The point $Q(-1, \\frac{2}{\\sqrt{3}})$ is an interior point of $A$"}] [{:db/id #edb/ref 17592186125240 :knowledge-point/_questions [{:db/id #edb/ref 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186049737 :topic/math-academy-id 1906 :topic/title "Introduction to Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5e70ad6-844f-54d7-849e-1be47ec1781b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186124041} {:answer/id #uuid "d95376ed-f49f-5fdd-8e18-f3bbea85ca92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186124042} {:answer/id #uuid "2973fb07-7856-538c-983d-b0318bb543c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 1759218612404