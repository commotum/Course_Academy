7592186404609} {:answer/id #uuid "cb49a1af-87c1-5d9f-814f-b3600e3126c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186404610} {:answer/id #uuid "6dd96fc6-a365-548a-a677-09d28338ad35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186404611}] :answer-field/correct {:answer/id #uuid "df920d21-8207-5b52-a72a-8fc3592e0c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186404609} :answer-field/id #uuid "a620906d-6f92-5060-b907-57c31554da32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b755a996-db20-51e4-9f08-2f14dd2e4212" :question/math-academy-id "q-93952" :question/problem "Which of the following systems is an initial value problem?\n\nI. $(x-1)^{2}{y}^{″}+(x-1){y}^{′}+y=0$\nII. $8{y}^{″}+{y}^{′}+y=0,\\,y(1)=0,\\,{y}^{′}(2)=10$\nIII. ${x}^{2}{y}^{″}+x{y}^{′}={x}^{2}+1,\\,y(1)=0,\\,{y}^{′}(1)=5$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The second system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=1$ and $x=2$). This is a **boundary value problem.**\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)."}] [{:db/id #edb/ref 17592186152873 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces" :topic/_knowledge-points [{:db/id #edb/ref 17592186049808 :topic/math-academy-id 2759 :topic/title "Dimension in Abstract Vector Spaces"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "853d938c-e945-5b30-8504-fe583f2a7122" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186151746} {:answer/id #uuid "afc60809-c9e7-5e98-8d46-54e5e6736339" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186151747} {:answer/id #uuid "384a2c75-d8de-547d-b312-39e2194485c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186151748} {:answer/id #uuid "3b99e225-61dd-5373-b4f0-906845898561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186151749} {:answer/id #uuid "51333ea6-164b-5a29-8bbc-c3cb34f1faf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186151750}] :answer-field/id #uuid "cabec925-98e3-5904-8918-4f65bfbf1ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151745}] :question/id #uuid "cf24f132-4367-5ec7-a350-dc1b155d856e" :question/math-academy-id "q-94765" :question/problem "Which of the following vector spaces are finite-dimensional?\n\n1. $C[0, 1]$, the vector space of all continuous functions $f: [0, 1] → R$\n2. $M_{100}(R)$, the vector space of all $100 \\cdot 100$ matrices over $R$\n3. $R^{500}$"}] [{:db/id #edb/ref 17592186152