9f7cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186385608} {:answer/id #uuid "36fa22c5-e4ae-5e77-ad57-5a479df9a8f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186385609} {:answer/id #uuid "5e7101e4-3e47-56a4-ad46-6658bbcbc631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186385610} {:answer/id #uuid "4b68e157-9fd4-507e-97f4-f5d8ef17c6cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186385611}] :answer-field/correct {:answer/id #uuid "371046e5-f2a2-5985-ac73-f38e1329fb26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186385607} :answer-field/id #uuid "5a141b43-f8ca-5309-8224-ef9b7a357608" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed18a3e4-6415-576f-b0e6-2282d7b910ac" :question/math-academy-id "q-76219" :question/problem "For the function $f:R\\to R$ defined by $f(x)={x}^{2},$ which of the following  statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is false. For instance, $f(2)=4=f(-2)$, but $2\\ne -2.$ So, $f(x)$ is not an injection.\n\n- Statement II is false. For example, there is no $x\\in R$ such that $f(x)=-1.$ So, $f(x)$ is not a surjection.\n\n- Statement III is false because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186152732 :knowledge-point/_questions [{:db/id #edb/ref 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically" :topic/_knowledge-points [{:db/id #edb/ref 17592186049745 :topic/math-academy-id 2627 :topic/title "Surjections"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c460f347-b0f7-5612-a266-c07345184918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150900} {:answer/id #uuid "c83487fd-58af-56a9-bb80-4cc1d814156c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150901} {:answer/id #uuid "4a710021-50fe-558b-8fb0-543a45c224ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150902} {:answer/id #uuid "4fb8ef6c-b18e-594c-8a47-ddb36d92f11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186150903} {:answer/id #uuid "7885c6b0-a91b-5558-85b8-b5d378eb7900" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186150904}] :answer-field/id #uuid "59d080c3-d125-541e-ade1-7b315cb4989e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150899} {:answer-field/choices [{:answer/id #uuid "1b49a529-fc7a-5677-96ed-90f368302a7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I  and III only" :db/id #edb/ref 17592186382292} {:answer/id #uuid "f029e7d8-b519-5c54-b275-27694419d06c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I  and II only" :db/id #edb/ref 17592186382293} {:answer/id #uuid "6d45bd62-7dcd-5027-b021-8f44ede29800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382294} {:answer/id #uuid "a87bd1bf-54bb-5463-8068-2b7c39b6c9cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186382295} {:answer/id #uuid "ece94773-6750-5f14-b0fb-5f1424d8bd4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382296}] :answer-field/correct {:answer/id #uuid "6d45bd62-7dcd-5027-b021-8f44ede29800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382294} :answer-field/id #uuid "26255840-acbe-55db-b6c4-2bc5feb6b2a7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382291}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e0a2fe09-79e7-541d-8328-5d8abf9635ec" :question/math-academy-id "q-76236" :question/problem "Which of the following functions are surjections?\n\n- $f:R\\to (0,\\infty )$ defined by $f(x)={3}^{x}$\n- $g:Q\\to Q$ defined by $g(x)={x}^{2}$\n- $h:R\\to R$ defined by $h(x)={x}^{2}$" :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is a surjection. Given $y\\in (0,\\infty ),$ choose $x={log}_{3}⁡y\\in R.$ Then $f(x)=f({log}_{3}⁡y)={3}^{{log}_{3}⁡y}=y.$\n\n- II is *not* a surjection. As a counterexample, choose $2\\in Q.$ There is no number $x\\in Q$ such that $g(x)=2.$ The only number $x$ that satisfies $g(x)={x}^{2}=2$ is $x=\\sqrt{2}\\notin Q.$\n\n- III is *not* a surjection. As a counterexample, choose $-1\\in R.$ There is no number $x\\in R$ such that $h(x)={x}^{2}=-1.$  In fact, ${x}^{2}>0$ for all $x\\in R.$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186152735 :knowledge-point/_questions [{:db/id #edb/ref 17592186152265 :knowledge-point/id #uuid "f237343d-2f8a-5a9f-9e5f-c9f22784547a" :knowledge-point/title "Identifying Bijections For Functions Functions Defined Algebraically" :topic/_knowledge-points [{:db/id #edb/ref 17592186048139 :topic/math-academy-id 2679 :topic/title "Bijections"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99ca813-80cf-5e50-af8a-816b6743c00b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186150918} {:answer/id #uuid "32ccde7c-247f-54e9-8076-91b0ccdf2344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186150919} {:answer/id #uuid "3cb97c75-c275-5405-92f7-0155ef36a7be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186150920} {:answer/id #uuid "46da8688-11ad-5e39-8997-30a909301ed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186150921} {:answer/id #uuid "5bf26a78-81ec-522a-a43e-5ee090a0a9f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186150922}] :answer-field/id #uuid "3c92ccf7-e05d-53a6-be11-a