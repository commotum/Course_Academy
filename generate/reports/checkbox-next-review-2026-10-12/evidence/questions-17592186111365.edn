9 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186401387} {:answer/id #uuid "54876cd1-0314-5deb-ab1d-b12e5527f92e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186401388} {:answer/id #uuid "0963c530-23fc-5035-8a90-8f3a474c35e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186401389} {:answer/id #uuid "0d45bd81-d2af-5d91-9d5a-2b641a8316e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186401390}] :answer-field/correct {:answer/id #uuid "0d45bd81-d2af-5d91-9d5a-2b641a8316e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186401390} :answer-field/id #uuid "f27a5b4e-3727-5966-9e47-39feb88a654c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0151a70d-ce12-5172-8abb-638426f2b102" :question/math-academy-id "q-162747" :question/problem "![](images/b6/b698fe735caaf3bc260c1e921bb95596df8869eba67ec9ce72484b4d86cc8c69.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?" :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch regions exist for the points $A$ and $D.$ Hence $A$ and $D$ are local minimum points.\n\n**Note**: For the point $D({x}_{D},{y}_{D},{z}_{D}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{D},{y}_{D})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\ge f(a,b)$, the point $D$ does satisfy the conditions for a local minimum.\n\n![](images/0a/0a371aa559222bd28c37677bace18eb912bdc978e364bab4cb3d83f7a310de3f.png)"}] [{:db/id #edb/ref 17592186124856 :knowledge-point/_questions [{:db/id #edb/ref 17592186124676 :knowledge-point/id #uuid "12a9f9cf-06f6-51b8-ba41-a8b6300a5c2b" :knowledge-point/title "Identifying Ordinary and Singular Points" :topic/_knowledge-points [{:db/id #edb/ref 17592186049703 :topic/math-academy-id 1880 :topic/title "Regular Singular Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a58b9e33-afac-56fd-af03-d57745c83f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186121717} {:answer/id #uuid "d897b74d-52a0-5f7b-89c6-db59ba0ab4ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186121718} {:answer/id #uuid "ed31e6ee-cfeb-550a-b417-cdeae141be49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186121719} {:answer/id #uuid "30c14196-4779-5509-9e76-56d27e6f6d7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186121720} {:answer/id #uuid "786bb8b5-a157-5463-983c-3271ea26d55d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186121721}] :answer-field/id #uuid "82c5845f-6ea6-513d-9dde-1697099cb4f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121716}] :question/id #uuid "be9dd53a-f053-5bda-b574-b363602495a1" :question/math-academy-id "q-341193" :question/problem "$(x - 2)y^{″} + (x - 1