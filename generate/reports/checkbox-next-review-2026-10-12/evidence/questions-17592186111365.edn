db/ref 17592186401927}] :answer-field/correct {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} :answer-field/id #uuid "ae9fdfce-f210-5819-a39f-6d6ef14bee25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{sec}⁡x=1$\nII. $\\operatorname{sec}⁡x=2$\nIII. $\\operatorname{sec}⁡x=\\frac{1}{2}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186115738 :knowledge-point/_questions [{:db/id #edb/ref 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050576 :topic/math-academy-id 1726 :topic/title "Elementary 2x2 Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c89d58a-c775-5607-8754-ada001af1092" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186113395} {:answer/id #uuid "3cd6d02f-02aa-5e2c-bc02-c7d907a619af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186113396} {:answer/id #uuid "68af6deb-1ead-5d87-9d0e-40a52ee56971"