id "d37c94ec-2c05-5133-b412-56a48fd223bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114103} {:answer-field/choices [{:answer/id #uuid "9a831cb5-7996-50f5-a00f-9238c740dfbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$, $Q$, and $S$" :db/id #edb/ref 17592186402876} {:answer/id #uuid "965453b1-8564-5aa8-8e90-1d29787fd17c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186402877} {:answer/id #uuid "d8c136ae-153c-59f1-8f96-afd3d63f12c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $S$ only" :db/id #edb/ref 17592186402878} {:answer/id #uuid "07ca52bf-aff6-51dc-b9d9-86e513484473" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186402879} {:answer/id #uuid "4d68e0d7-29e8-5b6d-a9f0-b295aa3c7e0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $S$ only" :db/id #edb/ref 17592186402880}] :answer-field/correct {:answer/id #uuid "d8c136ae-153c-59f1-8f96-afd3d63f12c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $S$ only" :db/id #edb/ref 17592186402878} :answer-field/id #uuid "18b86fb1-d5b1-5b49-80f6-3cc05480453d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7edba7-7f03-5a91-ad50-58a8e20f5eb1" :question/math-academy-id "q-43509" :question/problem "Which of the following are elementary matrices?\n\n$$\nP=[\\begin{aligned}0 & 0 & 7 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}],\\,Q=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 7 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,S=[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$" :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $P$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\n- The matrix $Q$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{2}:=7{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=7{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 7 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =Q\\end{aligned}\n$$\n\n- The matrix $S$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{2}:={R}_{2}+7{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =S\\end{aligned}\n$$\n\nTherefore, only $Q$ and $S$ are elementary matrices."}] [{:db/id #edb/ref 17592186115887 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph" :topic/_knowledge-points [{:db/id #edb/ref 17592186048420 :topic/math-academy-id 1691 :topic/title "Continuity and Differentiability of Functions"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a5a42e8-f8f6-5ea3-843a-87d79adf7632" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186114260} {:answer/id #uuid "b2534f1a-449c-50ea-a507-d6d614bf0c1c" :an