b/id #edb/ref 17592186403213} {:answer/id #uuid "d1df0086-7f48-50cb-8ceb-18066bc865de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403214} {:answer/id #uuid "29558d43-c76b-586a-9425-52db91027e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403215} {:answer/id #uuid "c6000078-e4e1-5811-8829-82307d46879b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403216}] :answer-field/correct {:answer/id #uuid "d6bfad6c-2814-5c54-aba4-2b500b7ae26b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403212} :answer-field/id #uuid "389f0e82-b83e-5348-b35b-7ad0561fa28a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403211}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7680c22b-fa61-58ad-8d65-6ff8999855b8" :question/math-academy-id "q-65947" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\nI. $(\\frac{1}{2},\\frac{\\pi }{4})$\nII. $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4})$\nIII. $(1,0)$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points.  \n\n- First, we consider the point $(\\frac{1}{2},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},\\frac{1}{2})$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{1}{2},\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(1,0).$ We note the following:\n\n- The point $(0,1)$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=0$ lies within this range. $\\,✓$\n\nTherefore, the point $(1,0)$ lies on the graph of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186111366 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function" :topic/_knowledge-points [{:db/id #edb/ref 17592186049656 :topic/math-academy-id 1487 :topic/title "Graphing the Inverse Tangent Function"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b113f0a9-895a-56a3-8759-b6c2959ff8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186109922} {:answer/id #uuid "bf303d45-b0dd-5d6d-a581-736ceb085d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186109923} {:answer/id #uuid "c3a086e3-1d0d-522d-a5d7-a925c56f89cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186109924} {:answer/id #uuid "08f55e75-52ef-560e-b53a-8c9c154bd4b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186109925} {:answer/id #uuid "4bdf6e3b-0b34-539c-933c-fbf55734dae3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186109926}] :answer-field/id #uuid "c79a2455-4317-550b-bb8d-c5b6422cc769" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109921} {:answer-field/choices [{:answer/id #uuid "0415b469-b139-5e1a-a412-34227a3897af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403218} {:answer/id #uuid "23feee12-2b3b-5956-a66b-2f5a51f37208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186403219} {:answer/id #uuid "d3754b87-9f75-54d9-9a94-d542f1aaa946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403220} {:answer/id #uuid "4215ac44-f44e-59a5-8b63-fb6307287e01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186403221} {:answer/id #uuid "46e2afd4-b53a-541a-99a5-3d5382aea9b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403222}] :answer-field/correct {:answer/id #uuid "0415b469-b139-5e1a-a412-34227a3897af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403218} :answer-field/id #uuid "28f631db-f510-51e8-a456-9f86ddcaf626" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403217}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b81fb291-176e-5b1d-97d6-f57c92461362" :question/math-academy-id "q-65990" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nI. $(1,\\frac{\\pi }{6})$\nII. $(\\sqrt{3},\\frac{\\pi }{3})$\nIII. $(-1,-\\frac{\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(1,\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},1)$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\frac{\\pi }{6})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ does lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186111394 :knowledge-point/_questions [{:db/id #edb/ref 17592186110674 :knowledge-point/id #uuid "f67c3319-1153-51ed-a57a-f85c06c7e76c" :knowledge-point/title "Determining Whether Points on Intersecting Lines Are Collinear" :topic/_knowledge-points [{:db/id #edb/ref 17592186049892 :topic/math-academy-id 1500 :topic/title "Collinear Points"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb0faf0f-5618-54d9-89a7-80c77140df42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186110090} {:answer/id #uuid "f86d63d7-74b3-530e-91d9-8ff31f761445" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186110091} {:answer/id #uuid "479e057f-e9e5-52df-ba3d-412259c39194" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186110092} {:answer/id #uuid "6af6be9b-f51c-5bcf-b37a-cca78ef06518" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186110093} {:answer/id #uuid "6ccc7e23-2f5e-5bc7-b82f-ad9500638c6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186110094}] :answer-field/id #uuid "cfb9f9a8-0793-550e-8000-7cbb65bc3ee6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186110089}] :question/id #uuid "7d9ca7f7-8b8f-513d-9055-bfafe5f332c2" :question/math-academy-id "q-7484" :question/problem "![](images/d1/d1fd1460fe24739d1c1bf1a7cad39da6775860b0764eaa4b41fffaae073e3a50.png)\n\nGiven the picture shown above, which of the following statements are true?\n\n1. $E$, $G$ and $H$ are collinear\n2. $A$, $B$ and $G$ are **not** collinear\n3. $B$, $F$ and $H$ are collinear"}] [{:db/id #edb/ref 17592186111399