 :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186118596} {:answer/id #uuid "7200f358-dda1-5f0b-b84a-30a5d60cf73b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186118597}] :answer-field/id #uuid "58962e64-b17c-55e0-aab3-0532b5db9f7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118592}] :question/id #uuid "73859e24-723f-5cfe-bfb6-acaba3c39e8f" :question/math-academy-id "q-39313" :question/problem "Which of the three sequences below are geometric sequences?\n\n1. $-2,-16,-64, …$\n2. $5, 23, 41, …$\n3. $a_{n + 1} =-6a_{n}, a_{1} = 3, n \\ge 1$"}] [{:db/id #edb/ref 17592186120448 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule" :topic/_knowledge-points [{:db/id #edb/ref 17592186050129 :topic/math-academy-id 1775 :topic/title "Cramer's Rule for 2x2 Systems of Linear Equations"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fc4cd7d-9eb6-5394-836d-01389afe841f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186118803} {:answer/id #uuid "c7f3c696-5951-5f6d-b7ec-9c2fe110ca25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186118804} {:answer/id #uuid "cfa72ef2-be17-5172-b51c-f6deb64a9261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186118805} {:answer/id #uuid "ec39aa0f-9ae9-5158-b8e1-c1ee129803b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186118806} {:answer/id #uuid "53e7ecde-8592-5a56-8a4e-5413b7808c52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186118807}] :answer-field/correct {:answer/id #uuid "cfa72ef2-be17-5172-b51c-f6deb64a9261" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186118805} :answer-field/id #uuid "591cf863-263f-5798-a041-3edb5ac56202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118802}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38525400-a144-5244-a7f9-f068d294beba" :question/math-academy-id "q-42983" :question/problem "Let $⟨x,3⟩$ be the solution of the system of equations below. \n\n$$\n\\{\\begin{aligned}2x+3y=10 \\\\ kx-4y=12.\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\nI. $3|\\begin{aligned}2 & 3 \\\\ k & -4\\end{aligned}|=|\\begin{aligned}2 & 10 \\\\ k & 12\\end{aligned}|$\n\nII. $|\\begin{aligned}2 & 3 \\\\ k & -4\\end{aligned}|=|\\begin{aligned}2 & 10 \\\\ k & 12\\end{aligned}|$\n\nIII. $|\\begin{aligned}2 & 3 \\\\ k & -4\\end{aligned}|=3|\\begin{aligned}2 & 10 \\\\ k & 12\\end{aligned}|$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}2 & 3 \\\\ k & -4\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}2 & 10 \\\\ k & 12\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ 3 & =\\frac{|\\begin{aligned}2 & 10 \\\\ k & 12\\end{aligned}|}{|\\begin{aligned}2 & 3 \\\\ k & -4\\end{aligned}|} \\\\ 3|\\begin{aligned}2 & 3 \\\\ k & -4\\end{aligned}| & =|\\begin{aligned}2 & 10 \\\\ k & 12\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186120460 :knowledge-point/_questions [{:db/id #edb/ref 17592186119977 :knowledge-point/id #uuid "c1e3ad2c-3335-5bdd-b7ee-8abcfa4c6951" :knowledge-point/title "Determining Whether a Square Root Is a Real Number" :topic/_knowledge-points [{:db/id #edb/ref 17592186050358 :topic/math-academy-id 1822 :topic/title "The Square Root of a Perfect Square"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83ba89be-5b64-555e-a7f4-908b27ca254d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186118875} {:answer/id #uuid "b8a973e9-11d9-5a02-b9f2-8a219c36d28c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186118876} {:answer/id #uuid "bd86862a-a383-5e9c-a21a-610efb0a3d1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186118877} {:answer/id #uuid "0fea5a92-e3f0-5bdc-9c5a-269937ca147a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186118878} {:answer/id #uuid "38772f09-9994-5fec-9e14-17bcb6095a64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186118879}] :answer-field/id #uuid "1d4591ab-adaa-5931-8f18-e234f29f73f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118874}] :question/id #uuid "27a7cfaf-1bd1-5cdf-8d78-8c16efc26b73" :question/math-academy-id "q-43299" :question/problem "Which of the following square roots are real numbers?\n\n1. $\\sqrt{1}$\n2. $\\sqrt{-9}$\n3. $\\sqrt{2.4}$"}] [{:db/id #edb/ref 17592186120461 :knowledge-point/_questions [{:db/id #edb/ref 17592186119977 :