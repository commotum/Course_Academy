 #edb/ref 17592186049408 :topic/math-academy-id 2738 :topic/title "Generalized Eigenvectors"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c66c73a1-4658-5ffb-8903-536e01ba607e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186148806} {:answer/id #uuid "224b7b77-503a-5964-818a-87c3cb739154" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186148807} {:answer/id #uuid "292b5bc6-34df-5cac-87b7-df248b6c3608" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186148808} {:answer/id #uuid "3218271b-63a7-54a2-9045-7c9a38668498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186148809} {:answer/id #uuid "7bb0b4f2-acad-5af3-b169-750b5bbd69fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186148810}] :answer-field/id #uuid "a0d2a4fc-8384-5cb1-8a66-6e3f768d6c21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186148805} {:answer-field/choices [{:answer/id #uuid "365f86c2-d4b9-5658-a1ba-569f4671a8e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186362650} {:answer/id #uuid "1c03f028-fa48-554c-89ed-7e4c0c0f847e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186362651} {:answer/id #uuid "e372a422-d6fb-5a56-9316-e9f817212903" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186362652} {:answer/id #uuid "2ece5b07-a573-51b6-9c32-1fe6e61d2f17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186362653} {:answer/id #uuid "762b2273-1a91-5132-9c90-43b8d7c8cc77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186362654}] :answer-field/correct {:answer/id #uuid "1c03f028-fa48-554c-89ed-7e4c0c0f847e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186362651} :answer-field/id #uuid "a566d80a-f0df-593f-99b0-963e5ae3625b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97e51f20-5416-56f9-b5ce-2f15332c68c1" :question/math-academy-id "q-108979" :question/problem "$$\n\\begin{aligned}u\\overset{A-2I\\,}{\\to }v\\overset{A-2I\\,}{\\to }w\\overset{A-2I\\,}{\\to }0 \\\\ x\\overset{A+3I\\,}{\\to }y\\overset{A+3I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A-2I$ and $A+3I$ on the nonzero vectors $u,v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\n- $w$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n- $u$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n- $y$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-3$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\nw\\overset{A-2I\\,}{\\to }0,\n$$\n\ni.e. $A-2I$ maps $w$ to $0$ in $1$ step, \nthe vector $w$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A.$\n\n- Statement II is false. Since\n\n$$\nu\\overset{A-2I\\,}{\\to }v\\overset{A-2I\\,}{\\to }w\\overset{A-2I\\,}{\\to }0,\n$$\n\ni.e. $A-2I$ maps $u$ to $0$ in $3$ steps, \nthe vector $u$ is a generalized eigenvector of rank $3,$ not $2.$\n\n- Statement III is true. Indeed, since\n\n$$\ny\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $w$ to $0$ in $1$ step, \nthe vector $y$ is a generalized eigenvector of rank $1$ (a.k.a. an eigenvector) corresponding to the eigenvalue $\\lambda =-3$ of $A.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186152399 :knowledge-point/_questions [{:db/id #edb/ref 17592186152124 :knowledge-point/id #uuid "f0075774-6bd8-54c9-b698-4aacd499fce5" :knowledge-point/title "Classifying Numbers as Natural" :topic/_knowledge-points [{:db/id #edb/ref 17592186049935 :topic/math-academy-id 2558 :topic/title "Natural Numbers, Integers, and Rational Numbers"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2aef71c-422f-5352-96ef-8a0eb8e38dc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186148926} {:answer/id #uuid "acca590a-ab9a-575e-ad08-e1756fd54340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186148927} {:answer/id #uuid "c5a3ad49-300f-5564-8ea3-0b7f8c2e7a98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186148928} {:answer/id #uuid "ca2585e4-e11d-57f5-b95d-c25e5e588f35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 175921