06ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774}] :answer-field/correct {:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774} :answer-field/id #uuid "eab4d4b7-2252-5c08-b2b6-6e240fa0a5f2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299429}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a27ba74d-67e7-552a-808b-c86c1ab2858a" :question/math-academy-id "q-317368" :question/problem "Calculate $det(E)$ given that\n$E=[\\begin{aligned}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{aligned}].$\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =|\\begin{aligned}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{aligned}| \\\\  & =-\\frac{3}{4}\\cdot (-1)-5\\cdot 2 \\\\  & =\\frac{3}{4}-10 \\\\  & =-\\frac{37}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811}] :answer-field/correct {:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811} :answer-field/id #uuid "d3a33b9b-67e3-53e5-bc18-a48957e9fa7a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299357}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5cb8c1aa-faf5-5b19-b22a-04f7e16807fe" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$D=[\\begin{aligned}3x & 2y \\\\ -5 & x\\end{aligned}].$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}3x & 2y \\\\ -5 & x\\end{aligned}| \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299599 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787}] :answer-field/correct {:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787} :answer-field/id #uuid "5f79e083-14ad-5456-a436-b4ade461c1f1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298964}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9aa98f1a-30c2-558c-875f-c99582477892" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}|=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{aligned}| & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0feb68bf-c01c-5e15-9300-ed8a2f76be21" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186333131} {:answer/id #uuid "1b7eebe0-7cb3-5f9c-90c8-996ed14bd473" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2{z}^{2}y" :db/id #edb/ref 17592186333241} {:answer/id #uuid "62b8bc2c-0ea0-54c2-81f8-ac2379203980" :answer/type {:db/ident :answer.type/math} :answer/value "-2x-3y{z}^{2}" :db/id #edb/ref 17592186333886} {:answer/id #uuid "d6426e90-34c6-5f45-884d-afd51e4b42c3" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2{y}^{2}z" :db/id #edb/ref 17592186334865} {:answer/id #uuid "da5805d0-457f-5d06-aadd-5dc42e733cb3" :answer/type {:db/ident :answer.type/math} :answer/value "2x+3y{z}^{2}" :db/id #edb/ref 17592186334901}] :answer-field/correct {:answer/id #uuid "0feb68bf-c01c-5e15-9300-ed8a2f76be21" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186333131} :answer-field/id #uuid "61b1a4cb-aa69-5954-bf74-458e8b0b734e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335433}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1f495c11-33b3-5814-a588-ff956e62d01d" :question/math-academy-id "q-69649" :question/problem "$|\\begin{aligned}3\\sqrt{x} & {z}^{2} \\\\ 2y & -\\sqrt{x}\\end{aligned}|=$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}3\\sqrt{x} & {z}^{2} \\\\ 2y & -\\sqrt{x}\\end{aligned}| & =3\\sqrt{x}\\cdot (-\\sqrt{x})-{z}^{2}\\cdot 2y \\\\  & =-3x-2y{z}^{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "245f8b76-960f-5227-85be-1848c57026fb" :answer/type {:db/ident :answer.type/math} :answer/value "6(ru-st)" :db/id #edb/ref 17592186333328} {:answer/id #uuid "5179db59-ecf5-527f-b152-14da85049ace" :answer/type {:db/ident :answer.type/math} :answer/value "6ru-3st" :db/id #edb/ref 17592186333736} {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} {:answer/id #uuid "be3cb9cd-cb94-5657-98ff-b3d91e1ff9d6" :answer/type {:db/ident :answer.type/math} :answer/value "-6ru+3st" :db/id #edb/ref 17592186334635} {:answer/id #uuid "fa49eaa1-621e-5ca8-a141-b55927a350aa" :answer/type {:db/ident :answer.type/math} :answer/value "3(2st-ru)" :db/id #edb/ref 17592186335181}] :answer-field/correct {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} :answer-field/id #uuid "8926dc70-416f-5104-b768-f00f2078937e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335501}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3f8c0050-79c4-5426-9e5c-a8628ebc0ae0" :question/math-academy-id "q-69650" :question/problem "Calculate $det(H)$, if\n    $H=[\\begin{aligned}-2r & 3s \\\\ -2t & 3u\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =|\\begin{aligned}-2r & 3s \\\\ -2t & 3u\\end{aligned}| \\\\  & =-2r\\cdot 3u-3s\\cdot (-2t) \\\\  & =-6ru-(-6st) \\\\  & =-6ru+6st \\\\  & =6(st-ru)\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries" :topic/_knowledge-points [{:db/id #edb/ref 17592186049044 :topic/id #uuid "d58eda6d-18a9-51fc-a2ae-3720429fd25b" :topic/knowledge-points [{:db/id #edb/ref 17592186059748 :knowledge-point/canonical-example {:question/math-academy-id "e-4434" :question/problem "Calculate $\\det(A),$ if $[\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}]$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3 & 2 \\\\ 5 & 6\\end{aligned}| \\\\  & =3\\cdot 6-2\\cdot 5 \\\\  & =18-10 \\\\  & =8\\end{aligned}\n$$"} :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"} {:db/id #edb/ref 17592186059749 :knowledge-point/canonical-example {:question/math-academy-id "e-4435" :question/problem "Calculate $\\det(A),$ if $[\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}]$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}\\sqrt{2} & -2 \\\\ 0 & \\sqrt{3}\\end{aligned}| \\\\  & =\\sqrt{2}\\cdot \\sqrt{3}-(-2)\\cdot 0 \\\\  & =\\sqrt{6}\\end{aligned}\n$$"} :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"} {:db/id #edb/ref 17592186059750 :knowledge-point/canonical-example {:question/math-academy-id "e-4436" :question/problem "If\n${A} = \n    \\left\\lbrack\n    \\matrix {\n        2 & -1 \\\n        -3 & k\n    }\n    \\right\\rbrack$\nand\n$\\det({A}) = 5$, what is the value of $k?$" :question/worked-solution "For a $2 \\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & -1 \\\\ -3 & k\\end{aligned}| \\\\  & =2\\cdot k-(-1)\\cdot (-3) \\\\  & =2k-3\\end{aligned}\n$$\n\nSince $\\det(A)=5,$ we obtain:\n\n$$\n\\begin{aligned}det(A) & =5 \\\\ 2k-3 & =5 \\\\ 2k & =8 \\\\ k & =4\\end{aligned}\n$$"} :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :topic/math-academy-id 152 :topic/title "The Determinant of a 2x2 Matrix"}]}] [{:db/id #edb/ref 1759218610098