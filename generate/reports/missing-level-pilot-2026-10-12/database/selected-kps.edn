-5040-afc5-c0f0787ecc96" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}{y}^{2}" :db/id #edb/ref 17592186261256} {:answer/id #uuid "a2a8698b-73f4-57ac-a21f-031d3c8b223a" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}-3)" :db/id #edb/ref 17592186261294}] :answer-field/correct {:answer/id #uuid "61a3d195-a5ae-5921-ac90-3b4c24a6e5e9" :answer/type {:db/ident :answer.type/math} :answer/value "y(2{x}^{2}+5)" :db/id #edb/ref 17592186260716} :answer-field/id #uuid "b1e2c382-0ce2-5adc-b135-69fb578a8e4f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262444}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5adfe9df-8aee-5967-99f3-985aed9cc4da" :question/math-academy-id "q-127603" :question/problem "Calculate $det(D)$, if\n    $D=[\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}| \\\\  & =2x\\cdot xy-y\\cdot (-5) \\\\  & =2{x}^{2}y+5y \\\\  & =y(2{x}^{2}+5)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186292870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231}] :answer-field/correct {:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231} :answer-field/id #uuid "60cd938e-fe0c-506b-935f-e549ff5c73c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292029}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d53568b9-73ac-5ba0-8169-8