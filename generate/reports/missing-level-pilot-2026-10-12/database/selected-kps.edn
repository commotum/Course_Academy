 & 5 & -8 \\\\ 6 & 6 & -6 & 0 \\\\ -6 & 4 & 2 & 5\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186295089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08bbec5d-c22e-5416-941f-e614581e5ee1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292968}] :answer-field/correct {:answer/id #uuid "08bbec5d-c22e-5416-941f-e614581e5ee1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292968} :answer-field/id #uuid "6e95a709-acfb-50eb-82c6-8f68e1122c4b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294317}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e09062a5-fbd4-5002-8fc5-41df91866e41" :question/math-academy-id "q-279540" :question/problem "Find the entry ${f}_{32}$ of the matrix $F$, where \n\n$$\nF=[\\begin{aligned}4 & 5 & -2 & 0 \\\\ -2 & -1 & 2 & 5 \\\\ 3 & 4 & 0 & -3\\end{aligned}].\n$$\n\n${f}_{32}=$\n{{field-1}}" :question/worked-solution "The entry ${f}_{32}$ lies at the intersection of the $3$rd row and $2$nd column. Therefore, ${f}_{32}=4.$\n\n$$\nF=[\\begin{aligned}4 & 5 & -2 & 0 \\\\ -2 & -1 & 2 & 5 \\\\ 3 & 4 & 0 & -3\\end{aligned}].\n$$"} {:db/id #edb/ref 17592186395748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13c60e5-0749-5b32-b12e-a8ade2bfafa4" :answer/type {:db/ident :answer.type/text} :answer/value "No such entry" :db/id #edb/ref 17592186395750} {:answer/id #uuid "934f3147-a632-5a7a-90a4-6abb01c749b5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186395751} {:answer/id #uuid "75f10e54-f429-5034-a07c-5f3a477a96f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395752} {:answer/id #uuid "fc409e78-b2db-5c05-a2e5-b9108d710f88" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395753} {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754}] :answer-field/correct {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754} :answer-field/id #uuid "009a80b9-eba7-5f26-9519-cf720d746fee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395749}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d09f8217-b119-5565-bb4f-2ae4305acd87" :question/math-academy-id "q-13497" :question/problem "Find the entry ${c}_{24}$ of the matrix $C$, where \n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${c}_{24}$ should lie at the intersection of the $2$nd row and $4$th column. Therefore, ${c}_{24}=5.$\n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}]\n$$"} {:db/id #edb/ref 17592186398263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7d1ec58-4625-5961-a2e3-b5cd7345701a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398265} {:answer/id #uuid "d7bfa313-dae4-53f3-a57b-64e8da4543c6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186398266} {:answer/id #uuid "fd0fb717-3703-5718-a040-1535e3177723" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398267} {:answer/id #uuid "b38fc1a7-079a-5f48-a57c-e34f53ec5e20" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398268} {:answer/id #uuid "6542246e-6fb1-5a0a-8c66-d92b07a647e5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186398269}] :answer-field/correct {:answer/id #uuid "d7bfa313-dae4-53f3-a57b-64e8da4543c6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186398266} :answer-field/id #uuid "21415ffd-ab5b-5844-9b2a-182f8ede2fa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398264}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8904abf3-dbf2-549a-8f8b-9fbdb7308ad3" :question/math-academy-id "q-125561" :question/problem "Find the entry ${e}_{31}$ of the matrix $E$, where \n\n$$\nE=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${e}_{31}$ lies at the intersection of the $3$rd row and $1$st column. Therefore, ${e}_{31}=-3.$\n\n$$\nE=[\\begin{aligned}1 & 2 \\\\ -1 & 5 \\\\ -3 & 4\\end{aligned}]\n$$"}] :knowledge-point/title "Finding an Entry of a Matrix" :topic/_knowledge-points [{:db/id #edb/ref 17592186050163 :topic/id #uuid "3312d0c4-51f9-5d97-b0e2-ad1261c39155" :topic/knowledge-points [{:db/id #edb/ref 17592186100988 :knowledge-point/canonical-example {:question/math-academy-id "e-4371" :question/problem "Find the entry $a_{23}$ of the matrix ${A},$ where \n\n$$\n[\\begin{aligned}-1 & 1 & 2 & 1 \\\\ 0 & 1 & -3 & -1\\end{aligned}]\n$$" :question/worked-solution "The entry $a_{23}$ lies at the intersection of the $2$nd row and $3$rd column. Therefore, $a_{23}={\\color{blue}{-3}}.$\n\n$$\n[\\begin{aligned}-1 & 1 & 2 & 1 \\\\ 0 & 1 & -3 & -1\\end{aligned}]\n$$"} :knowledge-point/title "Finding an Entry of a Matrix"} {:db/id #edb/ref 17592186100989 :knowledge-point/canonical-example {:question/math-academy-id "e-4372" :question/problem "Find the entry $b_{22}$ of the matrix ${B},$ where \n\n$$\n[\\begin{aligned}-5 & 1 \\\\ 0 & 2\\end{aligned}]\n$$" :question/worked-solution "The entry $b_{22}$ lies at the intersection of the $2$nd row and $2$nd column. Therefore, $b_{22}={\\color{blue}{2}}.$\n\n$$\n[\\begin{aligned}-5 & 1 \\\\ 0 & 2\\end{aligned}]\n$$"} :knowledge-point/title "Finding an Entry of a Square Matrix"} {:db/id #edb/ref 17592186100990 :knowledge-point/canonical-example {:question/math-academy-id "e-4373" :question/problem "Consider the highlighted entry of the matrix $C$ given below. Describe it in terms of $c_{ij}.$\n\n$$\n[\\begin{aligned}0 & -2 & 5 \\\\ 34 & 5 & 1\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $1$st row and $3$rd column. Therefore, we have $c_{13}={\\bbox[lightgray, 2pt]{5}}.$"} :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] :topic/math-academy-id 1167 :topic/title "Index Notation for Matrices"}]}] [{:db/id #edb/ref 17592186110756 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110458 :question/math-academy-id "e-3484" :question/problem "![](images/e5/e50848432dd18a4a5dc64d4e5a5cfb8b3e14e9fed6231774dd83ead5552cd463.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2\\sqrt 6}{7},$ use the Pythagorean identity to find $\\csc\\theta.$" :question/worked-solution "Again, any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2\\sqrt 6}{7}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2\\sqrt 6}{7}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2\\sqrt 6}{7}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2\\sqrt{6}}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{24}{49}} \\\\  & =\\pm \\sqrt{\\frac{25}{49}} \\\\  & =\\pm \\frac{5}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. So, $\\sin\\theta = \\dfrac{5}{7}.$\n\nFinally, knowing that $\\csc\\theta = \\dfrac{1}{\\sin\\theta},$ we have\n\n$$\n\\csc\\theta = \\dfrac{1}{\\left(\\dfrac{5}{7}\\right)} = \\dfrac{7}{5}.\n$$"} :knowledge-point/id #uuid "435bc6f9-651f-511c-a972-9afe90baff32" :knowledge-point/questions [{:db/id #edb/ref 17592186110900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "221a4245-8d36-54ef-a82d-e80ee76d86ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{6}}{2}" :db/id #edb/ref 17592186257060} {:answer/id #uuid "77312d37-9886-5569-95f9-c48a271a75f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{9}" :db/id #edb/ref 17592186257837} {:answer/id #uuid "8319e688-c42a-58a8-aa2e-6c419db98208" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186257942} {:answer/id #uuid "aa4aecba-9357-5bb7-978f-a673979c6b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{12}" :db/id #edb/ref 17592186258268} {:answer/id #uuid "b24f29ad-ae26-5c1a-98cc-8488a4660ab6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{6}}{12}" :db/id #edb/ref 17592186258335}] :answer-field/correct {:answer/id #uuid "aa4aecba-9357-5bb7-978f-a673979c6b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{12}" :db/id #edb/ref 17592186258268} :answer-field/id #uuid "5ed6599f-2974-5160-b981-962e1c285d91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259194}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2755d3ad-f502-5322-8d2b-3addfcafe3f4" :question/math-academy-id "q-124750" :question/problem "![](images/bd/bd8650a856fe3136759d81a886b2d4622cf3eb463b75e6023b44083c72f63a1a.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{1}{5},$ use the Pythagorean identity to find $sec⁡\\theta .$" :question/worked-solution "![](images/73/734eef45985ddfb6450666e1dd32c6d3beab9ca3aef66c87c6ba393d6960b08b.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{1}{5}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{1}{5}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{1}{5}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{25}} \\\\  & =\\pm \\sqrt{\\frac{24}{25}} \\\\  & =\\pm \\frac{2\\sqrt{6}}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{2\\sqrt{6}}{5}.$\n\nKnowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(\\frac{2\\sqrt{6}}{5})}=\\frac{5}{2\\sqrt{6}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}sec⁡\\theta  & =\\frac{5}{2\\sqrt{6}} \\\\  & =\\frac{5}{2\\sqrt{6}}\\cdot \\frac{\\sqrt{6}}{\\sqrt{6}} \\\\  & =\\frac{5\\sqrt{6}}{2\\cdot 6} \\\\  & =\\frac{5\\sqrt{6}}{12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186111341 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9081c344-3a39-5a06-bd28-8b285c2ea9a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{5}" :db/id #edb/ref 17592186109772} {:answer/id #uuid "93524fd2-35f0-5d71-8d9e-e239e386e599" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186109773} {:answer/id #uuid "a262a04e-d822-56f0-a70e-27321fda9467" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{25}" :db/id #edb/ref 17592186109774} {:answer/id #uuid "f7b263b5-8f52-5c67-8e20-36803479f595" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186109775} {:answer/id #uuid "5e75bdf0-de4a-526f-95f5-f7ef9a319ea5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186109776}] :answer-field/id #uuid "2e52fa46-45c4-5057-a515-a4ac0eafd22d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109771}] :question/id #uuid "42d69a07-5334-57e8-884c-ddd2699ea549" :question/math-academy-id "q-65066" :question/problem "![](images/e6/e666ddc8a8eda452abd833e963446c96de5d34dfbf76e9c92564e85a48080524.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{3}{5}$, use the Pythagorean identity to find $\\sec θ$."} {:db/id #edb/ref 17592186259728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae50b4c-8d48-5e94-905d-2050bbd834e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186258142} {:answer/id #uuid "a5ae39b9-8d77-5506-95cb-36cfda6b93ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186258226} {:answer/id #uuid "b1ca8282-18dd-559f-b3d0-161a4153c226" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}}{2}" :db/id #edb/ref 17592186258329} {:answer/id #uuid "f50445f6-c5b6-5037-8d82-ae09d76d2629" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186258921} {:answer/id #uuid "f57c9ed2-c68c-53ab-85fa-4cb0d40fff12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186258925}] :answer-field/correct {:answer/id #uuid "9ae50b4c-8d48-5e94-905d-2050bbd834e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{4}" :db/id #edb/ref 17592186258142} :answer-field/id #uuid "62707eaf-bd66-53e1-b24c-8b731568b056" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259199}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "186cddc1-d1ed-556b-9213-9d3efc27c116" :question/math-academy-id "q-124743" :question/problem "![](images/02/02cb693b74f0f315389f87ceed1674da11f661b3363e4df0890bdf82d61cc60c.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{1}{3},$ use the Pythagorean identity to find $csc⁡\\theta .$" :question/worked-solution "![](images/a4/a479e8e7906a3a0dc43e925c5bccd6534b4ab2e02a289403b2d0c92d0b0eb1d9.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{1}{3}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{1}{3}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{1}{3}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{9}} \\\\  & =\\pm \\sqrt{\\frac{8}{9}} \\\\  & =\\pm \\frac{2\\sqrt{2}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So, $sin⁡\\theta =\\frac{2\\sqrt{2}}{3}.$\n\nKnowing that $csc⁡\\theta =\\frac{1}{sin⁡\\theta },$ we have\n\n$$\ncsc⁡\\theta =\\frac{1}{(\\frac{2\\sqrt{2}}{3})}=\\frac{3}{2\\sqrt{2}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}csc⁡\\theta  & =\\frac{3}{2\\sqrt{2}} \\\\  & =\\frac{3}{2\\sqrt{2}}\\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} \\\\  & =\\frac{3\\sqrt{2}}{2\\cdot 2} \\\\  & =\\frac{3\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596dbc8f-087c-5cf2-accd-e0290a3590a9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{\\sqrt{6}}" :db/id #edb/ref 17592186333808} {:answer/id #uuid "ad4202f9-1df8-5702-aa30-7ebfe4130dbb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186334517} {:answer/id #uuid "c29b3ce4-5742-5c0e-a80c-c46e912aa977" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{6}" :db/id #edb/ref 17592186334679} {:answer/id #uuid "cc5de6f1-fb22-59a3-a646-77d3c44a4d2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{\\sqrt{6}}" :db/id #edb/ref 17592186334771} {:answer/id #uuid "d1f58498-935a-53c3-af47-c294d082ad34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186334822}] :answer-field/correct {:answer/id #uuid "d1f58498-935a-53c3-af47-c294d082ad34" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{2}" :db/id #edb/ref 17592186334822} :answer-field/id #uuid "0e139d51-01cf-5ad5-af15-a0777e8b7fe3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335266}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee81fb0a-2d3c-5307-89ae-7908973bbefc" :question/math-academy-id "q-65062" :question/problem "![](images/43/43629ebfaa2f9811135ffb15f5e5a59b796b83e3a525b4ab480efb9840d40879.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{3}}{3},$ use the Pythagorean identity to find $sec⁡\\theta .$" :question/worked-solution "![](images/f5/f5219a363cdf18cfb628148ca7b9bbe6015b521799ed4487fa9b56843eaa3043.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{3}}{3}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{3}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{3}}{3}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{3}}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{3}{9}} \\\\  & =\\pm \\sqrt{\\frac{6}{9}} \\\\  & =\\pm \\frac{\\sqrt{6}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{\\sqrt{6}}{3}.$\n\nKnowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(\\frac{\\sqrt{6}}{3})}=\\frac{3}{\\sqrt{6}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}sec⁡\\theta  & =\\frac{3}{\\sqrt{6}} \\\\  & =\\frac{3}{\\sqrt{6}}\\cdot \\frac{\\sqrt{6}}{\\sqrt{6}} \\\\  & =\\frac{3\\sqrt{6}}{6} \\\\  & =\\frac{\\sqrt{6}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ffeba9c-70a6-5328-9dc3-5020e0313ad2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186333595} {:answer/id #uuid "4eafe18b-8c02-5577-a960-94ba6f971ec7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186333711} {:answer/id #uuid "7213fed3-dd70-59f5-9da6-eb714e406490" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186334021} {:answer/id #uuid "9dc0b081-37ac-56aa-8ceb-99b894130c9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{5}" :db/id #edb/ref 17592186334379} {:answer/id #uuid "fdb4516a-8d82-5f18-ae27-7aaf1618cf06" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186335220}] :answer-field/correct {:answer/id #uuid "3ffeba9c-70a6-5328-9dc3-5020e0313ad2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{2}" :db/id #edb/ref 17592186333595} :answer-field/id #uuid "b0192dd7-c731-5b69-8d4c-3c9bab7026de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335562}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "555c1e17-369e-580d-8f06-901f476b3eee" :question/math-academy-id "q-65064" :question/problem "![](images/45/455df038e550d78fc29463c1a2e22dd44838d24af7428a824f9046fecc1ac1db.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\frac{\\sqrt{15}}{5},$ use the Pythagorean identity to find $csc⁡\\theta .$" :question/worked-solution "![](images/44/44a555d222e3f6ff85208e8722a728ad240c558de7982d2a480bf9ddfb23ac6f.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{15}}{5}$ at the point $P.$ Therefore, we have\n\n$$\ncos⁡\\theta =\\frac{\\sqrt{15}}{5}.\n$$\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{\\sqrt{15}}{5}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{15}}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{15}{25}} \\\\  & =\\pm \\sqrt{\\frac{10}{25}} \\\\  & =\\pm \\frac{\\sqrt{10}}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So, $sin⁡\\theta =\\frac{\\sqrt{10}}{5}.$\n\nKnowing that $csc⁡\\theta =\\frac{1}{sin⁡\\theta },$ we have\n\n$$\n\\begin{aligned}csc⁡\\theta =\\frac{1}{(\\frac{\\sqrt{10}}{5})}=\\frac{5}{\\sqrt{10}}.\\end{aligned}\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}csc⁡\\theta  & =\\frac{5}{\\sqrt{10}} \\\\  & =\\frac{5}{\\sqrt{10}}\\cdot \\frac{\\sqrt{10}}{\\sqrt{10}} \\\\  & =\\frac{5\\sqrt{10}}{10} \\\\  & =\\frac{\\sqrt{10}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "528a08e6-b114-52bc-80b8-70909e3bcf6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186352305} {:answer/id #uuid "840edc39-ce69-5e96-a971-721e9703e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{2}" :db/id #edb/ref 17592186352722} {:answer/id #uuid "9b103a08-6e43-5cc7-a32e-70ec6d35d281" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{7}}{7}" :db/id #edb/ref 17592186352896} {:answer/id #uuid "d780a273-2e9f-579d-b951-eb5dfc8fc835" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186353437} {:answer/id #uuid "e9803a68-f2b3-5f47-b6d4-6601df336f7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186353599}] :answer-field/correct {:answer/id #uuid "d780a273-2e9f-579d-b951-eb5dfc8fc835" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{7}" :db/id #edb/ref 17592186353437} :answer-field/id #uuid "c1301c22-4c52-5421-ba45-744724340b9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354148}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5348ffc1-6c19-57de-8e72-a13dbe8b5969" :question/math-academy-id "q-85234" :question/problem "![](images/87/87635426224ded01c8bf486c7f59eeb6cacbe4e5c7db964643910bb5d142f0f3.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{2}}{3},$ use the Pythagorean identity to find $sec⁡\\theta .$" :question/worked-solution "![](images/9f/9f64bae56998bca7d825780c8c2b437ae3106486053cc9c8ed1b1fca2a88d4ab.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{2}}{3}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{2}}{3}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{2}}{3}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{2}}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{2}{9}} \\\\  & =\\pm \\sqrt{\\frac{7}{9}} \\\\  & =\\pm \\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{\\sqrt{7}}{3}.$\n\nKnowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(\\frac{\\sqrt{7}}{3})}=\\frac{3}{\\sqrt{7}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}sec⁡\\theta  & =\\frac{3}{\\sqrt{7}} \\\\  & =\\frac{3}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} \\\\  & =\\frac{3\\sqrt{7}}{7}\\end{aligned}\n$$"}] :knowledge-point/title "Computing a Reciprocal Ratio Using the Pythagorean Identity" :topic/_knowledge-points [{:db/id #edb/ref 17592186050714 :topic/id #uuid "60b97f00-f86a-5a4f-834e-1a83f8ee3cc2" :topic/knowledge-points [{:db/id #edb/ref 17592186110754 :knowledge-point/canonical-example {:question/math-academy-id "e-3480" :question/problem "The point $A$ is located in the first quadrant and lies on the unit circle. The $y$-coordinate of $A$ is $\\dfrac{5}{9}.$ What is the $x$-coordinate of $A?$" :question/worked-solution "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\nx^2+y^2=1 .\n$$\n\nSubstituting $y=\\dfrac{5}{9}$ into the above and solving for $x$ gives\n\n$$\n\\eqalign{\n\t\tx^2+y^2&=1\\[5pt]\n\t        x^2+\\left(\\dfrac{5}{9}\\right)^2&=1\\[5pt]\n\t\tx^2+\\left(\\dfrac{25}{81}\\right)&=1\\[5pt]\n\t\tx^2&= 1-\\dfrac{25}{81}\\[5pt]\n\t\tx^2&= \\dfrac{56}{81}\\[5pt]\n\t\tx&= \\sqrt{\\dfrac{56}{81}}\\[5pt]\n\t        x&= \\pm \\dfrac{2\\sqrt{14}}{9}.\n}\n$$\n\nSince $A$ lies in the first quadrant, $x$ must be positive. So, we select the positive answer. \n\nTherefore, our final answer is $x=\\dfrac{2\\sqrt{14}}{9}.$"} :knowledge-point/title "Using the Pythagorean Theorem on the Unit Circle"} {:db/id #edb/ref 17592186110755 :knowledge-point/canonical-example {:question/math-academy-id "e-3482" :question/problem "![](images/aa/aad0b38f5afb88c13039ac577a927e232d84905de40297ed824c966795ce7bb4.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2}{3},$ use the Pythagorean identity to find $\\sin\\theta.$" :question/worked-solution "Any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2}{3}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2}{3}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{9}} \\\\  & =\\pm \\sqrt{\\frac{5}{9}} \\\\  & =\\pm \\frac{\\sqrt{5}}{3}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $\\sin\\theta$ is positive in the first quadrant. \n\nSo our final answer is $\\sin\\theta = \\dfrac{\\sqrt 5}{3}.$"} :knowledge-point/title "Computing a Trigonometric Ratio Using the Pythagorean Identity"} {:db/id #edb/ref 17592186110756 :knowledge-point/canonical-example {:question/math-academy-id "e-3484" :question/problem "![](images/e5/e50848432dd18a4a5dc64d4e5a5cfb8b3e14e9fed6231774dd83ead5552cd463.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{2\\sqrt 6}{7},$ use the Pythagorean identity to find $\\csc\\theta.$" :question/worked-solution "Again, any point $(x,y)$ on the unit circle is related to the central angle $\\theta$ as follows:\n\n$$\nx = \\cos\\theta, \\qquad y = \\sin\\theta.\n$$\n\nWe're given that $x=\\dfrac{2\\sqrt 6}{7}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{2\\sqrt 6}{7}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{2\\sqrt 6}{7}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2\\sqrt{6}}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{24}{49}} \\\\  & =\\pm \\sqrt{\\frac{25}{49}} \\\\  & =\\pm \\frac{5}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. So, $\\sin\\theta = \\dfrac{5}{7}.$\n\nFinally, knowing that $\\csc\\theta = \\dfrac{1}{\\sin\\theta},$ we have\n\n$$\n\\csc\\theta = \\dfrac{1}{\\left(\\dfrac{5}{7}\\right)} = \\dfrac{7}{5}.\n$$"} :knowledge-point/title "Computing a Reciprocal Ratio Using the Pythagorean Identity"} {:db/id #edb/ref 17592186110758 :knowledge-point/canonical-example {:question/math-academy-id "e-3485" :question/problem "![](images/e6/e666ddc8a8eda452abd833e963446c96de5d34dfbf76e9c92564e85a48080524.png)\n\nThe diagram above shows the unit circle. Given that the $x$-coordinate of the point $P$ is $\\dfrac{4}{5},$ what is $\\tan\\theta?$" :question/worked-solution "We're given that $x=\\dfrac{4}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\cos\\theta = \\dfrac{4}{5}.\n$$\n\nWe can use the Pythagorean identity to find $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\cos\\theta = \\dfrac{4}{5}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{4}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{16}{25}} \\\\  & =\\pm \\sqrt{\\frac{9}{25}} \\\\  & =\\pm \\frac{3}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $\\sin\\theta$ is positive in the first quadrant. Therefore $\\sin\\theta = \\dfrac{3}{5}.$\n\nUsing the fact that\n\n$$\n\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta},\n$$\n\nwe finally get\n\n$$\n\\tan\\theta = \\dfrac{\\left(\\dfrac{3}{5}\\right)}{\\left(\\dfrac{4}{5}\\right)} = \\dfrac {3}{4}.\n$$"} :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :topic/math-academy-id 1453 :topic/title "Using the Pythagorean Identity in the First Quadrant"}]}]}
