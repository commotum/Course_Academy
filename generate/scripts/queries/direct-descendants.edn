;; One edge only, over both supported curriculum relationships.
[:find ?descendant
 :in $ [?topic ...]
 :where (or-join [?topic ?descendant]
          [?topic :topic/next ?descendant]
          (and [?kp :knowledge-point/key-prerequisites ?topic]
               [?descendant :topic/knowledge-points ?kp]))
        [?descendant :topic/id _]]
