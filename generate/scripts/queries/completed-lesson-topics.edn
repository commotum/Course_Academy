;; Task IDs are captured from this learner first; no catalog-wide history join.
[:find ?topic
 :in $ [?task ...]
 :where [?task :learner-task/status :learner-task.status/completed]
        [?task :learner-task/activity ?activity]
        [?activity :activity/type :activity.type/lesson]
        [?activity :activity/scope ?topic]
        [?topic :topic/id _]]
