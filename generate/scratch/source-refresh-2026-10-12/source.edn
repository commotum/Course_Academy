e {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186359056} {:answer/id #uuid "bda894ff-ae9d-5d5a-99bd-a1f4b7cf8342" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359402} {:answer/id #uuid "e8ddf45e-881c-5c0c-a2da-d518f976e537" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186359817}] :answer-field/correct {:answer/id #uuid "082dc2d8-bedc-5e7d-b400-565c864a2156" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186357827} :answer-field/id #uuid "796c6d71-8b6e-59df-88c9-9b3757e40cfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360192}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b64018e-8bf2-54ed-9b58-217e6e652f6c" :question/math-academy-id "q-9669" :question/problem "Find the possible values of the constant $k$ given that the matrix $[\\begin{aligned}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$ \n\n$$\n\\begin{aligned}|\\begin{aligned}2 & 1 & -4 \\\\ 2k+1 & 3 & k \\\\ 1 & 0 & 1\\end{aligned}| & =2|\\begin{aligned}3 & k \\\\ 0 & 1\\end{aligned}|-1|\\begin{aligned}2k+1 & k \\\\ 1 & 1\\end{aligned}|-4|\\begin{aligned}2k+1 & 3 \\\\ 1 & 0\\end{aligned}| \\\\  & =2(3-0)-(2k+1-k)-4(0-3) \\\\  & =2\\cdot 3-(k+1)-4\\cdot (-3) \\\\  & =6-k-1+12 \\\\  & =17-k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}17-k & =0 \\\\ k & =17\\end{aligned}\n$$\n\nTherefore, the solution is $k=17.$"} {:db/id #edb/ref 17592186060456 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c97d112-a733-50db-a3e0-14dc2721dcef" :answer/type {:db/ident :answer.type/text} :answer/value "Any value of $k$" :db/id #edb/ref 17592186059359} {:answer/id #uuid 