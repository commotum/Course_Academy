}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j+\\frac{\\mathrm{d}z}{\\mathrm{d}t}\\,k \\\\ &= \\frac{\\mathrm{d}}{\\mathrm{d}t}(t^{2})i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t + 1)j+\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t + 1)k \\\\ &= (2 t)\\,i+(2)\\,j+(3)\\,k \\\\ \\|r'(t)\\|&=\\sqrt{(\\frac{\\mathrm{d}x}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}y}{\\mathrm{d}t})^2+(\\frac{\\mathrm{d}z}{\\mathrm{d}t})^2} \\\\ &= \\sqrt{(2 t)^2+(2)^2+(3)^2} \\\\ &= \\sqrt{4 t^{2} + 13}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=3 x y - 3 z^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t))&=3\\left((t^{2})(2 t + 1)-(3 t + 1)^2\\right) \\\\ &= 3\\left(2t^3+(1)t^2-\\left(9t^2+(6)t+1\\right)\\right) \\\\ &= 6 t^{3} - 24 t^{2} - 18 t - 3.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f(x,y,z)\\,\\mathrm{d}s&=\\int_{\\frac{1}{2}}^{\\frac{3}{2}} f(r(t))\\,\\|r'(t)\\|\\,\\mathrm{d}t \\\\ &= \\int_{\\frac{1}{2}}^{\\frac{3}{2}}(6 t^{3} - 24 t^{2} - 18 t - 3)(\\sqrt{4 t^{2} + 13})\\,\\mathrm{d}t \\\\ &= \\int_{\\frac{1}{2}}^{\\frac{3}{2}}\\sqrt{4 t^{2} + 13} \\left(6 t^{3} - 24 t^{2} - 18 t - 3\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$" 13194139535899 17592186045443 true] [17592186539123 1080 "\\int_{- \\frac{3}{2}}^{2}\\frac{2 \\sqrt{5} \\left(8 t^{3} + t - 2\\right)}{5}\\,\\mathrm{d}t" 13194139535899 17592186045443 true] [17592186539123 1082 #edb/ref 17592186045498 13194139535899 17592186045443 true] [17592186539123 1083 #uuid "0228b294-5832-5825-ad8a-3bc0a9bdbe23" 13194139535899 17592186045443 true] [17592186539124 1080 "\\int_{\\frac{1}{2}}^{\\frac{7}{3}}\\frac{5 t}{4 t^{2} + 1}\\,\\mathrm{d}t" 13194139535899 17592186045443 true] [17592186539124 1082 #edb/ref 17592186045498 13194139535899 17592186045443 true] [17592186539124 1083 #uuid "04ec66b2-9271-5a86-bba6-39b76534dbf7" 13194139535899 17592186045443 true] [17592186539125 1075 #edb/ref 17592186539135 13194139535899 17592186045443 true] [17592186539125 1075 #edb/ref 17592186539163 13194139535899 17592186