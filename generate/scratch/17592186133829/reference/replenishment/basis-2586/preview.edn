c{3}{2}}(12 t^{3} + 3 t^{2} - 18 t - 27)(\\sqrt{16 t^{2} + 5})\\,\\mathrm{d}t \\\\ &= \\int_{1}^{\\frac{3}{2}}3 \\sqrt{16 t^{2} + 5} \\left(4 t^{3} + t^{2} - 6 t - 9\\right)\\,\\mathrm{d}t.\\end{aligned}\n$$" 13194139535899 17592186045443 true] [17592186539205 1080 "\\int_{\\frac{\\pi}{12}}^{\\frac{\\pi}{2}}2 t \\cos{\\left(2 t \\right)}\\,\\mathrm{d}t" 13194139535899 17592186045443 true] [17592186539205 1082 #edb/ref 17592186045498 13194139535899 17592186045443 true] [17592186539205 1083 #uuid "fe1b2043-64b1-5186-9ca4-d5be02457609" 13194139535899 17592186045443 true] [17592186539206 1168 "generate/scratch/17592186133829.py" 13194139535899 17592186045443 true] [17592186539206 1169 #uuid "dd3dfc48-9a48-5a88-b422-3e3f29557457" 13194139535899 17592186045443 true]] :edb/tempids {"021666da-2b39-563b-b7fb-5efa8b86fda8" 17592186539122 "0228b294-5832-5825-ad8a-3bc0a9bdbe23" 17592186539123 "04ec66b2-9271-5a86-bba6-39b76534dbf7" 17592186539124 "06daf866-2151-53ab-a697-9d6282e0ae9a" 17592186539125 "0f75487c-a5f1-5e36-86b8-989567defbd5" 17592186539126 "18bbf45e-712a-50fc-9c7f-3db24fc3f7da" 17592186539127 "19471cdf-9ea5-5c33-ad36-e0767c3ac883" 17592186539128 "1b6b1bd1-88e4-5d2e-9dfb-33372f16d858" 17592186539129 "1bbf7d63-fae5-55c0-b85a-adf23a9e249f" 17592186539130 "1ddac435-f4c5-5790-a848-0d7fd8aecc12" 17592186539131 "20ce0eb2-a951-5877-b687-deea0d30c7a5" 17592186539132 "278b3e92-0930-54df-8b78-9d1eb2eb134a" 17592186539133 "27d15098-9f4d-5025-b663-55253273ac10" 17592186539134 "27d55e55-4da0-5e7e-b523-3a71c34060d1" 17592186539135 "2f1da427-cfa7-5281-8204-d21535a2e929" 17592186539136 "30338bca-6ca0-51af-8f2f-96eb86969268" 17592186539137 "35771a76-e706-5927-92ab-462e6d1f85c7" 17592186539138 "36c637e7-9d1d-5a19-bf0e-0dfdcc062824" 17592186539139 "39eb83de-83c7-5476-b2e1-42b4fe358621" 17592186539140 "3a918622-26b5-5fae-b7b9-05af71744ab8" 17592186539141 "3f2e2937-ae52-5040-b66a-a5c64838d0de" 17592186539142 "4103d898-eeb8-573e-bb32-54b6347b1152" 17592186539143 "45af7fa4-3c7f-5937-a136-7