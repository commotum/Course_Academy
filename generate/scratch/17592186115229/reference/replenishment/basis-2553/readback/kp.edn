d}{B}^{2} & =B\\cdot B \\\\  & =\\begin{bmatrix}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 3 & -1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & -1 & 4 \\\\ 3 & 1 & 1 \\\\ 11 & -3 & 7\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Finding a Power of a Matrix"}]}
