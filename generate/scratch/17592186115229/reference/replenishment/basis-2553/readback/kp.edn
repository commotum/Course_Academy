 by itself:\n\n$$\n\\begin{aligned}{H}^{2} & =H\\cdot H \\\\  & =\\begin{bmatrix}5 & -2 \\\\ 1 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}5 & -2 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}23 & -18 \\\\ 9 & 14\\end{bmatrix}\\end{aligned}\n$$\n\nNow, since ${H}^{3}={H}^{2}\\cdot H,$ we get\n\n$$\n\\begin{aligned}{H}^{3} & ={H}^{2}\\cdot H \\\\  & =\\begin{bmatrix}23 & -18 \\\\ 9 & 14\\end{bmatrix}\\cdot \\begin{bmatrix}5 & -2 \\\\ 1 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}97 & -118 \\\\ 59 & 38\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "963741da-3e7c-5d02-a9fc-26b98dd6a304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186293523}] :answer-field/correct {:answer/id #uuid "963741da-3e7c-5d02-a9fc-26b98dd6a304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186293523} :answer-field/id #uuid "582f7832-de2a-531f-826f-cb247148fcac" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294243} {:answer-field/choices [{:answer/id #uuid "a0c65114-aab4-5595-9e51-98e74a8fd036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186293565}] :answer-field/correct {:answer/id #uuid "a0c65114-aab4-5595-9e51-98e74a8fd036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186293565} :answer-field/id #uuid "992d7a5a-7f0b-5666-999f-f0e5a54978cd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294477} {:answer-field/choices [{:answer/id #uuid "edf80f44-54c1-51d0-820f-8c059846be5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/