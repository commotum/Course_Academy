heta \\\\ &=3\\int_{0}^{2 \\pi}\\int_{0}^{4}r^3(\\cos^2\\theta+\\sin^2\\theta)\\,dr\\,d\\theta \\\\ &=3\\int_{0}^{2 \\pi}\\int_{0}^{4}r^3\\,dr\\,d\\theta \\\\ &=3\\int_{0}^{2 \\pi}\\left[\\frac{r^4}{4}\\right]_{0}^{4}\\,d\\theta \\\\ &=3\\int_{0}^{2 \\pi}\\left(64-0\\right)\\,d\\theta \\\\ &=3\\int_{0}^{2 \\pi}64\\,d\\theta \\\\ &=192[\\theta]_{0}^{2 \\pi} \\\\ &=192\\left(2 \\pi-0\\right) \\\\ &=384 \\pi.\\end{aligned}\n$$\n\n" 13194139536061 17592186045443 true] [17592186562809 1080 "\\frac{243 \\pi}{2}" 13194139536061 17592186045443 true] [17592186562809 1082 #edb/ref 17592186045498 13194139536061 17592186045443 true] [17592186562809 1083 #uuid "d751fde0-0034-5a42-bdad-6904561a00a1" 13194139536061 17592186045443 true] [17592186562810 1080 "32 \\pi" 13194139536061 17592186045443 true] [17592186562810 1082 #edb/ref 17592186045498 13194139536061 17592186045443 true] [17592186562810 1083 #uuid "e5b4f42c-f65a-56dd-976e-09a6674be37e" 13194139536061 17592186045443 true] [17592186562811 1080 "- \\frac{75 \\pi}{8}" 13194139536061 17592186045443 true] [17592186562811 1082 #edb/ref 17592186045498 13194139536061 17592186045443 true] [17592186562811 1083 #uuid "eadab8b3-b89c-5b00-b770-5f624dc9857c" 13194139536061 17592186045443 true] [17592186562812 1080 "486 \\pi" 13194139536061 17592186045443 true] [17592186562812 1082 #edb/ref 17592186045498 13194139536061 17592186045443 true] [17592186562812 1083 #uuid "eba33b1d-8e12-5cdc-ae2a-8c3766a6a8d1" 13194139536061 17592186045443 true] [17592186562813 1080 "\\frac{\\pi}{2}" 13194139536061 17592186045443 true] [17592186562813 1082 #edb/ref 17592186045498 13194139536061 17592186045443 true] [17592186562813 1083 #uuid "ec208b84-8a21-5c5d-ae53-9fe4aaddaacc" 13194139536061 17592186045443 true] [17592186562814 1080 "- \\frac{81 \\pi}{2}" 13194139536061 17592186045443 true] [17592186562814 1082 #edb/ref 17592186045498 13194139536061 17592186045443 true] [17592186562814 1083 #uuid "efb5810f-7897-5409-a195-83c50f8b7d7e" 13194139536061 17592