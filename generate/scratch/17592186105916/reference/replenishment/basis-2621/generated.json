    "question": {
      ":question/id": "fba4bbe3-b689-56be-8219-e32d77251473",
      ":question/problem": "Suppose $|\\,a\\,|=\\frac{3}{4}$ and the angle between vectors $a$ and $b$ is $\\theta =\\frac{5\\pi }{6}.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}",
      ":question/answer-fields": [
        {
          ":answer-field/id": "cb898007-433e-563f-888f-d36152226b68",
          ":answer-field/key": "field-1",
          ":answer-field/type": ":answer-field.type/blank",
          ":answer-field/choices": [
            {
              ":answer/id": "2c02b906-ae20-50c8-bed5-3bb797391ce4",
              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{3\\sqrt{3}}{8}"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "2c02b906-ae20-50c8-bed5-3bb797391ce4"
          ]
        }
      ],
      ":question/difficulty": ":question.difficulty/moderate",
      ":question/worked-solution": "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}\u2061\\theta  \\\\  & =\\frac{3}{4}cos\\,(\\frac{5\\pi }{6}) \\\\  & =\\frac{3}{4}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{3}}{8}.\\end{aligned}\n$$"
    },
