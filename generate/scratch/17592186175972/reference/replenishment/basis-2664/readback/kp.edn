#{[{:db/id #edb/ref 17592186175972 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175822 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "87b371d9-6172-5ac0-a105-c9887542f0a7" :knowledge-point/title "Parametrizing a Parabolic Cylinder"}] :question/id #uuid "3e65aff0-a768-58fd-b41c-ca38ce3eb0bd" :question/math-academy-id "e-8888" :question/problem "$$\n\\mathbf{f}(x,y) = \\big\\langle x, \\: y, \\: \\text{___} \\big\\rangle\n$$\n\nThe vector-valued function $\\mathbf{f}(x,y)$ above parametrizes the parabolic cylinder defined in Cartesian coordinates as $2x^2=z.$ What is the third component of $\\mathbf{f}?$" :question/worked-solution "For any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(x,y) & =⟨x,y,z⟩ \\\\  & =⟨x,\\,y,\\,2{x}^{2}⟩\\end{aligned}\n$$\n\nwhere $x \\in (-\\infty,\\infty)$ and $y \\in (-\\infty,\\infty).$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{blue} 2x^2}.$"} :knowledge-point/id #uuid "87b371d9-6172-5ac0-a105-c9887542f0a7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048259} {:db/id #edb/ref 17592186050123} {:db/id #edb/ref 17592186050769}] :knowledge-point/question-generator {:db/id #edb/ref 17592186551523 :question-generator/id #uuid "aee0d140-5140-5e6f-aca4-9e8bd57f4222" :question-generator/script "generate/scratch/17592186175972.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186176193 :knowledge-point/_questions [{:knowledge-point/id #uuid "87b371d9-6172-5ac0-a105-c9887542f0a7" :knowledge-point/title "Parametrizing a Parabolic Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d28868-6ea5-5258-ad62-ccf61505062e" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186173417} {:answer/id #uuid "fdcd3467-826b-5ced-bd9a-ae8e80c6203e" :answer/type {:db/ident :answer.type/math} :answer/value "z^{2}" :db/id #edb/ref 17592186173418} {:answer/id #uuid "2d371b83-ac6f-522d-9467-771ce7f38