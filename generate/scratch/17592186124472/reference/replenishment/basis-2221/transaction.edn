, some horizontal lines intersect the curve more than once. These are not one-to-one functions. As a result, they are not invertible." :question/difficulty :question.difficulty/moderate :question/answer-fields ["b696151c-39ef-5f32-b33f-36cfdb48a420" "2d2c5548-3df4-5db5-9aeb-2db410adb01e" "1126b642-1027-5e3b-bd61-baa2f89bad30" "41775d15-4b6f-5681-8fdb-1d1cc3eab76c"] :db/ensure :question/validate} {:db/id "9df23d33-411f-53b8-851a-3f512ba480b6" :answer/id #uuid "9df23d33-411f-53b8-851a-3f512ba480b6" :answer/type :answer.type/text :answer/value "false" :db/ensure :answer/validate} {:db/id "1311f6ae-d060-542e-8b67-83e1535c42c9" :answer/id #uuid "1311f6ae-d060-542e-8b67-83e1535c42c9" :answer/type :answer.type/text :answer/value "true" :db/ensure :answer/validate} {:db/id "b4bb823e-a419-559c-a37e-ca3fc3439201" :answer-field/id #uuid "b4bb823e-a419-559c-a37e-ca3fc3439201" :answer-field/key "I" :answer-field/type :answer-field.type/checkbox :answer-field/choices ["9df23d33-411f-53b8-851a-3f512ba480b6" "1311f6ae-d060-542e-8b67-83e1535c42c9"] :answer-field/correct "9df23d33-411f-53b8-851a-3f512ba480b6" :db/ensure :answer-field/validate} {:db/id "c6f851cf-b87b-5aaa-8d84-bf6e3bc44b75" :answer/id #uuid "c6f851cf-b87b-5aaa-8d84-bf6e3bc44b75" :answer/type :answer.type/text :answer/value "false" :db/ensure :answer/validate} {:db/id "2583872f-2179-535f-bbcd-47a45f78a77d" :answer/id #uuid "2583872f-2179-535f-bbcd-47a45f78a77d" :answer/type :answer.type/text :answer/value "true" :db/ensure :answer/validate} {:db/id "b1df0a0b-a184-59e4-9da9-3de27030e3a7" :answer-field/id #uuid "b1df0a0b-a184-59e4-9da9-3de27030e3a7" :answer-field/key "II" :answer-field/type :answer-field.type/checkbox :answer-field/choices ["c6f851cf-b87b-5aaa-8d84-bf6e3bc44b75" "2583872f-2179-535f-bbcd-47a45f78a77d"] :answer-field/correct "c6f851cf-b87b-5aaa-8d84-bf6e3bc44b75" :db/ensure :answer-field/validate} {:db/id "4a576415-10d5-5339-b397-17fc5f464166" :answer/id #uuid "4a576415-10d5-5339-b397-17fc5f464166" :answer