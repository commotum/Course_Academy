ef 17592186503880}] :answer-field/correct {:answer/id #uuid "181054c9-dbd9-5b5f-a504-255307d12709" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{7/3}}{7}" :db/id #edb/ref 17592186503880} :answer-field/id #uuid "bd4ba04d-d537-57d4-bc2d-b413bfc38584" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186503910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1ab8645-2279-57cf-bef0-772d2fda5a19" :question/problem "Find the antiderivative of $\\sqrt[3]{{x}^{4}}.$\n\nWork on $x>0$.\n\nThe antiderivative is {{field-1}} $+C$. Enter only the term before $+C$, with no additive constant." :question/worked-solution "We start by writing the root as a rational power, $\\sqrt[3]{{x}^{4}}={x}^{4/3}.$ So, we can apply the power rule with $n=\\frac{4}{3}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt[3]{{x}^{4}}\\,\\text{d}x & =\\int {x}^{4/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{4/3+1}}{(\\frac{4}{3}+1)}+C \\\\  & =\\frac{{x}^{7/3}}{(\\frac{7}{3})}+C \\\\  & =\\frac{3{x}^{7/3}}{7}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{7/3}}{7}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{3{x}^{7/3}}{7})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{3}{7}\\frac{\\text{d}}{\\text{d}x}({x}^{7/3})+0 & = \\\\ \\frac{3}{7}\\cdot \\frac{7}{3}{x}^{7/3-1} & = \\\\ {x}^{4/3}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186503914 :knowledge-point/_questions [{:knowledge-point/id #uuid "85af4ca3-5e66-522a-9e5a-6efb1c7114ba" :knowledge-point/title "Finding the Antiderivative of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b19525f-2038-5110-92f7-e19997cc0bf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{x}^{9/2}}{9}" :db/id #edb/ref 17592186503885}] :answer-field/correct {:answer/id #uuid "2b19525f-2038-5110-