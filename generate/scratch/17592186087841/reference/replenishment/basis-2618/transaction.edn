7}{4},$ the length of the vertical radius must be $b=\\sqrt{\\frac{27}{4}}=\\frac{3\\sqrt{3}}{2}.$\n\nThus, the semi-major axis has length $b=\\frac{3\\sqrt{3}}{2},$ and the semi-minor axis has length $a=\\frac{\\sqrt{5}}{2}.$\n\nTherefore, the major axis has length $2b=2\\cdot \\frac{3\\sqrt{3}}{2}=3\\sqrt{3},$ and the minor axis has length $2a=2\\cdot \\frac{\\sqrt{5}}{2}=\\sqrt{5}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["1f76cdf7-8c2e-5196-9f1e-b93f95d0b0e2" "b5baf09d-53ca-5d62-bb06-c003ce6dd6fc"] :db/ensure :question/validate} {:db/id "7693e799-17b4-580e-85ba-48cd63b488fc" :answer/id #uuid "7693e799-17b4-580e-85ba-48cd63b488fc" :answer/type :answer.type/text :answer/value "$\\frac{\\sqrt{5}}{2}$ and $\\frac{2\\sqrt{2}}{3}$" :db/ensure :answer/validate} {:db/id "317cc575-d6d9-5bf7-b402-e9f6f2aece5f" :answer/id #uuid "317cc575-d6d9-5bf7-b402-e9f6f2aece5f" :answer/type :answer.type/text :answer/value "$\\sqrt{5}$ and $\\frac{2\\sqrt{2}}{3}$" :db/ensure :answer/validate} {:db/id "f6547e1e-09da-5e3a-9109-8fd09fcf5409" :answer/id #uuid "f6547e1e-09da-5e3a-9109-8fd09fcf5409" :answer/type :answer.type/text :answer/value "$\\frac{\\sqrt{5}}{2}$ and $\\frac{\\sqrt{2}}{3}$" :db/ensure :answer/validate} {:db/id "e77191fb-4308-5ae9-92dc-890558829810" :answer/id #uuid "e77191fb-4308-5ae9-92dc-890558829810" :answer/type :answer.type/text :answer/value "$\\frac{5}{4}$ and $\\frac{2}{9}$" :db/ensure :answer/validate} {:db/id "37d68e3d-f8d6-5f13-a869-d9cdc65b796c" :answer/id #uuid "37d68e3d-f8d6-5f13-a869-d9cdc65b796c" :answer/type :answer.type/text :answer/value "$\\sqrt{5}$ and $\\frac{\\sqrt{2}}{3}$" :db/ensure :answer/validate} {:db/id "6254bf33-2529-515f-a80a-8ecdfac48523" :answer-field/id #uuid "6254bf33-2529-515f-a80a-8ecdfac48523" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["7693e799-17b4-580e-85ba-48cd63b488fc" "317cc575-d6d9-5bf7-b402-e9f6f2aece5f" "f6547e1e-09da-5e3a-9109-8fd09fcf54