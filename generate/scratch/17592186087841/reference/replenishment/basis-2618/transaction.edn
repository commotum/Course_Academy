question/validate} {:db/id "c4f06786-52b2-5301-9c27-c84a9739b589" :answer/id #uuid "c4f06786-52b2-5301-9c27-c84a9739b589" :answer/type :answer.type/math :answer/value "8" :db/ensure :answer/validate} {:db/id "8c7c7107-1beb-5ce0-af4d-c6cb96a01e5b" :answer-field/id #uuid "8c7c7107-1beb-5ce0-af4d-c6cb96a01e5b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["c4f06786-52b2-5301-9c27-c84a9739b589"] :answer-field/correct "c4f06786-52b2-5301-9c27-c84a9739b589" :db/ensure :answer-field/validate} {:db/id "ac8378fb-e823-5792-b0e8-141ffa012178" :answer/id #uuid "ac8378fb-e823-5792-b0e8-141ffa012178" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{47}}{3}" :db/ensure :answer/validate} {:db/id "50ac688e-f2ed-5c1e-b30b-f87af88a4c4e" :answer-field/id #uuid "50ac688e-f2ed-5c1e-b30b-f87af88a4c4e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/choices ["ac8378fb-e823-5792-b0e8-141ffa012178"] :answer-field/correct "ac8378fb-e823-5792-b0e8-141ffa012178" :db/ensure :answer-field/validate} {:db/id "d560ab9f-5f69-5c94-a9a1-63ff925308ba" :question/id #uuid "d560ab9f-5f69-5c94-a9a1-63ff925308ba" :question/problem "For the ellipse $\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{\\frac{47}{9}}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=16$ and ${b}^{2}=\\frac{47}{9}.$\n\n- Since ${a}^{2}=16,$ the length of the horizontal radius must be $a=\\sqrt{16}=4.$\n\n- Since ${b}^{2}=\\frac{47}{9},$ the length of the vertical radius must be $b=\\sqrt{\\frac{47}{9}}=\\frac{\\sqrt{47}}{3}.$\n\nThus, the semi-major axis has length $a=4,$ and the semi-minor axis has length $b=\\frac{\\sqrt{47}}{3}.$\n\nTherefore, the major axis has length $2a=2\\cdot 4=8,$ and the minor axis has length $2b=2\\cdot \\frac{\\sqrt{47}}{3}=\\frac{2\\sqrt{47}}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["8c7c7107-1beb-5ce0-af4d-c6cb96a01e5b" "50ac688e-f2ed-5c1e-b30b-f87af88a4c4e"] :db/ensure :question/validate} {:db/id "3b9750c6-a897-50af-bf8f-f7809c90a66d" :answer/id #uuid "3b9750c6-a897-50af-bf8f-f7809c90a66d" :answer/type :answer.type/text :answer/value "$53$ and $\\frac{13}{4}$" :db/ensure :answer/validate} {:db/id "346354a8-96ab-5ac3-afa2-7e1332833460" :answer/id #uuid "346354a8-96ab-5ac3-afa2-7e1332833460" :answer/type :answer.type/text :answer/value "$2\\sqrt{53}$ and $\\frac{\\sqrt{13}}{2}$" :db/ensure :answer/validate} {:db/id "0005c1d8-45ea-525d-a5f3-270652f70c50" :answer/id #uuid "0005c1d8-45ea-525d-a5f3-270652f70c50" :answer/type :answer.type/text :answer/value "$2\\sqrt{53}$ and $\\sqrt{13}$" :db/ensure :answer/validate} {:db/id "a21ae6c2-3d2e-5bd5-bda8-5f05bc8b8bc3" :answer/id #uuid "a21ae6c2-3d2e-5bd5-bda8-5f05bc8b8bc3" :answer/type :answer.type/text :answer/value "$\\sqrt{53}$ and $\\sqrt{13}$" :db/ensure :answer/validate} {:db/id "40f0a89a-ba5c-5eb5-a4c7-9438df455d0c" :answer/id #uuid "40f0a89a-ba5c-5eb5-a4c7-9438df455d0c" :answer/type :answer.type/text :answer/value "$\\sqrt{53}$ and $\\frac{\\sqrt{13}}{2}$" :db/ensure :answer/validate} {:db/id "73b86f1d-d066-5db0-a46a-9f0d01c45177" :answer-field/id #uuid "73b86f1d-d066-5db0-a46a-9f0d01c45177" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["3b9750c6-a897-50af-bf8f-f7809c90a66d" "346354a8-96ab-5ac3-afa2-7e1332833460" "0005c1d8-45ea-525d-a5f3-270652f70c50" "a21ae6c2-3d2e-5bd5-bda8-5f05bc8b8bc3" "40f0a89a-ba5c-5eb5-a4c7-9438df455d0c"] :answer-field/correct "0005c1d8-45ea-525d-a5f3-270652f70c50" :db/ensure :answer-field/validate} {:db/id "c3eafdd8-07a