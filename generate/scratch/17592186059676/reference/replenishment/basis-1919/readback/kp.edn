-field.type/radio} :db/id #edb/ref 17592186058338}] :question/id #uuid "229abf58-01eb-5795-a764-a066cdbded99" :question/math-academy-id "q-47905" :question/problem "Find $f^{′}(x)$ for $f(x) = \\tan x - 2\\sin x$."} {:db/id #edb/ref 17592186237973 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e29ce2-4554-5558-8c72-8422675e24c1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186236138} {:answer/id #uuid "3c164c19-1e2a-5b97-a1d5-77c725311763" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186236193} {:answer/id #uuid "66361318-9219-58c5-bcda-75129baaa714" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\sqrt{2}" :db/id #edb/ref 17592186236464} {:answer/id #uuid "8d01f3a1-7ccb-5a54-ae3f-83fd2498b7ea" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186236709} {:answer/id #uuid "b7289c68-237a-522e-b56e-57064d776048" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236980}] :answer-field/correct {:answer/id #uuid "b7289c68-237a-522e-b56e-57064d776048" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236980} :answer-field/id #uuid "88322035-f59b-5d15-97b6-79b1ff1b2397" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237621}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "721c17b8-891a-5aa8-81e5-901c21b4cfea" :question/math-academy-id "q-103081" :question/problem "The derivative of $y=x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{4}$ is" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(x-\\operatorname{tan}⁡x) \\\\  & =1-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & =1-{sec}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =1-(\\sqrt{2})^{2} \\\\  & =1-2 \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284771 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4dddb2-8ce0-518b-941e-482ca5265f7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282747} {:answer/id #uuid "bc54686a-049f-5040-b7a9-b8062cc1c750" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186283321} {:answer/id #uuid "be37be01-215e-5391-bca4-f872aefba533" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186283341} {:answer/id #uuid "ea403761-0f48-5b27-a322-4bdbfaf43080" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186283735} {:answer/id #uuid "f3762c53-5b99-5615-8c9e-e78f50dd46f8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283817}] :answer-field/correct {:answer/id #uuid "7b4dddb2-8ce0-518b-941e-482ca5265f7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282747} :answer-field/id #uuid "33d75bdd-6edb-5b58-9b7f-46c8d0ecd14e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a05f390f-2f4a-5c91-9fbd-0dbf4e6d9e1b" :question/math-academy-id "q-17912" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=-tan⁡x$ when $x=\\pi .$" :question/worked-solution "The instantaneous rate of change  when $x=\\pi $ is given by the value of the derivative ${f}^{′}(x)$ at $x=\\pi .$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-tan⁡x) \\\\  & =-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\pi ,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =-{sec}^{2}⁡\\pi  \\\\  & =-1\\cdot (-1)^{2} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,  the instantaneous rate of change is $-1.$"} {:db/id #edb/ref 17592186315107 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955}] :answer-field/correct {:answer/id #uuid "f7cb390c-e572-53a0-b9de-83c29e711d66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186313955} :answer-field/id #uuid "980400c0-8e83-5892-8b48-98f7e9a9af2a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314422}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d99ea33e-6fab-5224-901c-7ede7395140b" :question/math-academy-id "q-341495" :question/problem "Find ${f}^{′}(x)$ if $f(x)=4\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}+3tan⁡x) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =4(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{2}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317183 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044}] :answer-field/correct {:answer/id #uuid "a4265357-1f5a-572b-b951-6c8731bedf0a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186316044} :answer-field/id #uuid "01b8be81-ed30-5c06-b89b-3ae37ec6ccee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316550}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04d16541-33c4-5168-abf0-25ac42f61efd" :question/math-academy-id "q-341825" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=\\operatorname{tan}⁡x-{x}^{2}$ when $x=0.$\n\n${f}^{′}(0)=$\n{{field-1}}" :question/worked-solution "The instantaneous rate of change when $x=0$ is given by the value of the derivative ${f}^{′}(x)$ at $x=0.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x-{x}^{2}) \\\\  & ={sec}^{2}⁡x-2x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(0) & ={sec}^{2}⁡(0)-2\\cdot 0 \\\\  & ={(\\frac{1}{\\operatorname{cos}⁡(0)})}^{2}-0 \\\\  & ={(\\frac{1}{1})}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change is $1.$"} {:db/id #edb/ref 17592186317185 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bcc3b9e-9aa6-5680-ac1b-555091e408db" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186315640}] :answer-field/correct {:answer/id #uuid "5bcc3b9e-9aa6-5680-ac1b-555091e408db" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186315640} :answer-field/id #uuid "ced27d33-b811-5c5f-93ee-716aecc76bbb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317037}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "194833de-eabd-521e-a061-701c99c91a20" :question/math-academy-id "q-341858" :question/problem "Find the slope of $y=tan⁡x+2sin⁡x$ at $x=0.$\n\n${y}^{′}(0)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(tan⁡x+2sin⁡x) \\\\  & ={sec}^{2}⁡x+2cos⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & ={sec}^{2}⁡(0)+2cos⁡(0) \\\\  & =1+2(1) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope is $3.$"} {:db/id #edb/ref 17592186329845 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026a56b8-1115-5684-ac6e-ef1630e64970" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186326960} {:answer/id #uuid "0393bd6c-c00c-5794-bb05-1c8299be09b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2{sec}^{2}⁡\\sqrt{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186326972} {:answer/id #uuid "25ff194a-cfcd-58a0-adba-8bc91fdf1efe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2x{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327262} {:answer/id #uuid "44d191be-38a4-500e-8cfb-76a9d83fe2e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}sec⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327534} {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218}] :answer-field/correct {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218} :answer-field/id #uuid "39c98579-7ff9-5677-8870-c03daabb35df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db3973ed-197d-5377-b8db-60e027e16ad0" :question/math-academy-id "q-47983" :question/problem "Find the derivative of $y=\\sqrt{x}+tan⁡x.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+tan⁡x) \\\\  & =\\frac{1}{2\\sqrt{x}}+{sec}^{2}⁡x \\\\  & =\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338847 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d90aaf-3c7e-502e-a562-e8e30a2e4f44" :answer/type {:db/ident :answer.type/math} :answer/value "6-3{cos}^{2}⁡x+4" :db/id #edb/ref 17592186336237} {:answer/id #uuid "54e94de8-7041-5cb7-8ea3-b142551e7f53" :answer/type {:db/ident :answer.type/math} :answer/value "3-6{sec}^{2}⁡x" :db/id #edb/ref 17592186336815} {:answer/id #uuid "962192cb-bb3f-5f88-bfc0-61f615078d44" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2{sec}^{2}⁡x" :db/id #edb/ref 17592186337402} {:answer/id #uuid "ab1f8bc7-61bf-53fe-b692-8455b9959c1b" :answer/type {:db/ident :answer.type/math} :answer/value "6x-6{sec}^{2}⁡x" :db/id #edb/ref 17592186337577} {:answer/id #uuid "fb2a1768-76da-50c5-bba8-68baff7dd8fd" :answer/type {:db/ident :answer.type/math} :answer/value "x-3sec⁡x+4" :db/id #edb/ref 17592186338238}] :answer-field/correct {:answer/id #uuid "ab1f8bc7-61bf-53fe-b692-8455b9959c1b" :answer/type {:db/ident :answer.type/math} :answer/value "6x-6{sec}^{2}⁡x" :db/id #edb/ref 17592186337577} :answer-field/id #uuid "05962ec1-c075-566a-ac05-4eef6517c851" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338284}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d2fc325-5a17-5cde-b04c-927ac9646ab9" :question/math-academy-id "q-70911" :question/problem "Find ${y}^{′}$ for $y=3({x}^{2}-2tan⁡x)+4.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}(3({x}^{2}-2tan⁡x)+4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-6tan⁡x+4) \\\\  & =3\\cdot 2x-6{sec}^{2}⁡x+0 \\\\  & =6x-6{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483527 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "061d1324-c902-50ac-9f19-d8b4a5784809" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{2}" :db/id #edb/ref 17592186483526} {:answer/id #uuid "4b1f1314-7647-545e-b012-8ae1c258500a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186483531} {:answer/id #uuid "6dac38e5-adce-5d03-bb83-d08ba2555997" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186483533} {:answer/id #uuid "856d6ef1-16cb-533f-8b58-6fd8f077de44" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186483534} {:answer/id #uuid "89742711-38f2-5693-8a77-c2b1336920a0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186483535}] :answer-field/correct {:answer/id #uuid "6dac38e5-adce-5d03-bb83-d08ba2555997" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186483533} :answer-field/id #uuid "5fe8258d-1897-5414-82b1-02fddba2f0e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483532}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "06ead9d9-ba18-5b78-9c0b-6c3f9d9d335d" :question/problem "The derivative of $y=2x-\\operatorname{tan}⁡x$ when $x=\\frac{\\pi }{4}$ is" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\operatorname{tan}⁡x) \\\\  & =2-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{4},$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{4}) & =2-{sec}^{2}⁡(\\frac{\\pi }{4}) \\\\  & =2-(\\sqrt{2})^{2} \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483528 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488ebcb1-34b1-54b2-bb0f-d3834972fc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}x" :db/id #edb/ref 17592186483530}] :answer-field/correct {:answer/id #uuid "488ebcb1-34b1-54b2-bb0f-d3834972fc84" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}x" :db/id #edb/ref 17592186483530} :answer-field/id #uuid "c9aa3437-62e4-5f8b-b2f8-54736d53760f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16f98c04-c89a-5e4f-bf27-ed015bececed" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\sqrt{x}+2tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+2tan⁡x) \\\\  & =1\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+2\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =1(\\frac{1}{2\\sqrt{x}})+2({sec}^{2}⁡x) \\\\  & =\\frac{\\frac{1}{2}}{\\sqrt{x}}+2{sec}^{2}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186483538 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285ce513-2344-54e5-878f-50e519f82f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186483529}] :answer-field/correct {:answer/id #uuid "285ce513-2344-54e5-878f-50e519f82f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}x" :db/id #edb/ref 17592186483529} :answer-field/id #uuid "e01d02f0-76ac-5033-8fce-0f78e59a051a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186483537}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec85ab69-3759-5a26-ad41-7f26f7d7092f" :question/problem "Find ${f}^{′}(x)$ if $f(x)=\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+3tan⁡x) \\\\  & =1\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =1(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{\\frac{1}{2}}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}]}
