rix}9 & -1 \\\\ 0 & 7\\end{bmatrix}-\\begin{bmatrix}0 & 0 \\\\ 0 & -9\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9-0 & -1-0 \\\\ 0-0 & 7-(-9)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9 & -9 \\\\ -1 & -7\\end{bmatrix}-\\begin{bmatrix}9 & -1 \\\\ 0 & 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-9-9 & -9-(-1) \\\\ -1-0 & -7-16\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & -8 \\\\ -1 & -23\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6067054-7fd7-5494-afbc-63d2f1559965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186549192}] :answer-field/correct {:answer/id #uuid "f6067054-7fd7-5494-afbc-63d2f1559965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186549192} :answer-field/id #uuid "3b02cda3-58fa-5c92-bb86-7f7f1f78a064" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549164} {:answer-field/choices [{:answer/id #uuid "999ac731-f8fe-5bbb-ae2e-9746750317db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549180}] :answer-field/correct {:answer/id #uuid "999ac731-f8fe-5bbb-ae2e-9746750317db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186549180} :answer-field/id #uuid "7c8db2d3-ed99-542c-a1d7-a2a23d3ad80f" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549174} {:answer-field/choices [{:answer/id #uuid "c1f35416-70b6-5829-b9cd-2cd827d01541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186549184}] :answer-field/correct {:answer/