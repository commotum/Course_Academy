ix} \\\\  & =\\begin{bmatrix}1+(-12) & 8+(-7) \\\\ 1+15 & -4+10\\end{bmatrix} \\\\  & =\\begin{bmatrix}-11 & 1 \\\\ 16 & 6\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d78a2e84-a85a-5426-839b-d919d6d4b21d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186549187}] :answer-field/correct {:answer/id #uuid "d78a2e84-a85a-5426-839b-d919d6d4b21d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186549187} :answer-field/id #uuid "3962cc30-d68b-50e2-9773-d6aedf315071" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549163} {:answer-field/choices [{:answer/id #uuid "3791a3cb-3358-5c4f-9a27-646be33d615b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549162}] :answer-field/correct {:answer/id #uuid "3791a3cb-3358-5c4f-9a27-646be33d615b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549162} :answer-field/id #uuid "3d46fe0e-797a-5fd0-bf21-fd0f6cbd02ee" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186549166} {:answer-field/choices [{:answer/id #uuid "7f9923ef-6fcf-5a18-8db6-2620b208228a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549175}] :answer-field/correct {:answer/id #uuid "7f9923ef-6fcf-5a18-8db6-2620b208228a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186549175} :answer-field/id #uuid "7a9c1505-e38c-556b-8560-5c2cc406c445" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 175921