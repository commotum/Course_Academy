{\\text{d}y}{\\text{d}t})^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=9 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(9)(t) \\\\  & =9 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{2 \\sqrt{3}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{2 \\sqrt{3}}(9 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2 \\sqrt{3}}9 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{49}\\frac{9}{8}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{9}{8}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{49} \\\\  & =\\frac{3}{4}[(49)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{3}{4}[(343)-(1)] \\\\  & =(\\frac{1029}{4})-(\\frac{3}{4}) \\\\  & =\\frac{513}{2}\\end{aligned}\n$$" 13194139535880 17592186045443 true] [17592186536185 1068 #edb/ref 17592186536237 13194139535880 17592186045443 true] [17592186536185 1070 #edb/ref 17592186045485 13194139535880 17592186045443 true] [17592186536185 1071 "Evaluate the line integral of the function $f(x,y)=3 y$ along the curve parametrized by $r(t)=\\langle t^{2},t\\rangle$ for $t\\in [0,\\sqrt{2}].$" 13194139535880 17592186045443 true] [17592186536185 1072 #uuid "3aeb7177-27b3-5c11-a4d0-3497fd32abae" 13194139535880 17592186045443 true] [17592186536185 1074 "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t^{2})\\,i+(t)\\,j$, then along the curve we have $x=t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(2 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{(\\frac{\\text{d}x}{\\text{d}t})^2+(\\frac{\\text{d}y}{\\text{d}t})^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=3 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(3)(t) \\\\  & =3 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{2}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{2}}(3 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{2}}3 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{9}\\frac{3}{8}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{3}{8}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{9} \\\\  & =\\frac{1}{4}[(9)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{1}{4}[(27)-(1)] \\\\  & =(\\frac{27}{4})-(\\frac{1}{4}) \\\\  & =\\frac{13}{2}\\end{aligned}\n$$" 13194139535880 17592186045443 true] [17592186536186 1068 #edb/ref 17592186536205 13194139535880 17592186045443 true] [17592186536186 1070 #edb/ref 17592186045485 13194139535880 17592186045443 true] [17592186536186 1071 "Evaluate the line integral of the function $f(x,y)=11 y$ along the curve parametrized by $r(t)=\\langle t^{2},t\\rangle$ for $t\\in [0,\\sqrt{6}].$" 13194139535880 17592186045443 true] [17592186536186 1072 #uuid "3c132797-532b-531b-ac79-d0e890e2f4b0" 13194139535880 17592186045443 true] [17592186536186 1074 "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t^{2})\\,i+(t)\\,j$, then along the curve we have $x=t^{2}$, $y=t$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =(2 t)\\,i+(1)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{(\\frac{\\text{d}x}{\\text{d}t})^2+(\\frac{\\text{d}y}{\\text{d}t})^2} \\\\  & =\\sqrt{(2 t)^2+(1)^2} \\\\  & =\\sqrt{4 t^{2} + 1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=11 y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(11)(t) \\\\  & =11 t\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{6}}(11 t)(\\sqrt{4 t^{2} + 1})\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=4 t^{2} + 1$, $\\text{d}u=(8 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{6}}11 t \\sqrt{4 t^{2} + 1}\\,\\text{d}t & ={\\int }_{1}^{25}\\frac{11}{8}\\cdot u^{1/2}\\,\\text{d}u \\\\  & =\\frac{11}{8}\\cdot\\frac{2}{3}u^{3/2}\\big|_{1}^{25} \\\\  & =\\frac{11}{12}[(25)^{3/2}-(1)^{3/2}] \\\\  & =\\frac{11}{12}[(125)-(1)] \\\\  & =(\\frac{1375}{12})-(\\frac{11}{12}) \\\\  & =\\frac{341}{3}\\end{aligned}\n$$" 13194139535880 17592186045443 true] [17592186536187 1068 #edb/ref 17592186536194 13194139535880 17592186045443 true] [17592186536187 1070 #edb/ref 17592186045486 13194139535880 17592186045443 true] [17592186536187 1071 "Evaluate the line integral of the function $f(x,y,z)=\\frac{3 y + 3 z}{x}$ along the curve parametrized by $r(t)=\\langle t,t^{2},\\frac{3 t^{2}}{2}\\rangle$ for $t\\in [1,\\sqrt{2}].$" 13194139535880 17592186045443 true] [17592186536187 1072 #uuid "4598c153-f2b3-5aa3-bf7d-421ba3e4749e" 13194139535880 17592186045443 true] [17592186536187 1074 "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(t)\\,i+(t^{2})\\,j+(\\frac{3 t^{2}}{2})\\,k$, then along the curve we have $x=t$, $y=t^{2}$, $z=\\frac{3 t^{2}}{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begi