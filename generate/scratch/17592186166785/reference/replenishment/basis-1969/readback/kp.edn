sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\int\\sech^{2} (\\frac{4x}{5})\\,\\mathrm{d}x$." :question/worked-solution "Let $u=\\frac{4x}{5}$. Differentiating gives $\\mathrm{d}u=\\frac{4}{5}\\,\\mathrm{d}x$, so $\\mathrm{d}x=\\frac{5}{4}\\,\\mathrm{d}u$.\n\nUsing the substitution and $\\frac{\\mathrm{d}}{\\mathrm{d}u}\\tanh u=\\sech^2 u$,\n\n$$\\begin{aligned}\n\\int\\sech^2(\\frac{4x}{5})\\,\\mathrm{d}x\n&=\\frac{5}{4}\\int\\sech^2 u\\,\\mathrm{d}u \\\\\n&=\\frac{5}{4}\\tanh u+C \\\\\n&=\\frac{5}{4}\\tanh(\\frac{4x}{5})+C.\n\\end{aligned}$$\n\nThe argument is linear and the integrand is defined for every real $x$."} {:db/id #edb/ref 17592186490428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09cdd6b9-9bb4-523c-9e1f-29875c3517fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(\\tanh 2 - \\tanh 3)" :db/id #edb/ref 17592186490414} {:answer/id #uuid "1ac3da07-3ad3-5169-b1a5-31471ab51e27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(\\sech 3 - \\sech 2)" :db/id #edb/ref 17592186490418} {:answer/id #uuid "8238abc6-6449-561f-bc6d-68e2fe8929bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(\\sech 3 - \\sech 6)" :db/id #edb/ref 17592186490445} {:answer/id #uuid "a0e1825e-cec5-5e4c-b791-15c6486adb7d" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\sech 2 - \\sech 3)" :db/id #edb/ref 17592186490456} {:answer/id #uuid "f9495bbb-0899-5286-8537-83609957fa87" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(\\tanh^{2} 6)" :db/id #edb/ref 17592186490481}] :answer-field/correct {:answer/id #uuid "8238abc6-6449-561f-bc6d-68e2fe8929bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}(\\sech 3 - \\sech 6)" :db/id #edb/ref 17592186490445} :answer-field/id #uuid "a4907295-d54a-50ee-a142-58619f28a525" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490458}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "425fe4ba-5881-5d44-9e1e-7efac3cf1cf4" :question/problem "Evaluate the integral $\\displaystyle \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\int_{1}^{2}\\sech 3x\\tanh 3x\\,\\mathrm{d}x$." :question/worked-solution "Let $u=3x$. Then $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. When $x=1$, $u=3$; when $x=2$, $u=6$.\n\nUsing $\\frac{\\mathrm{d}}{\\mathrm{d}u}\\sech u=-\\sech u\\tanh u$,\n\n$$\\begin{aligned}\n\\int_1^2\\sech(3x)\\tanh(3x)\\,\\mathrm{d}x\n&=\\frac{1}{3}\\int_{3}^{6}\\sech u\\tanh u\\,\\mathrm{d}u \\\\\n&=\\frac{1}{3}[-\\sech u]_{3}^{6} \\\\\n&=\\frac{1}{3}(\\sech 3-\\sech 6).\n\\end{aligned}$$\n\nThe integrand is continuous on $[1,2]$, and the result is positive because $\\sech u$ decreases for $u>0$."} {:db/id #edb/ref 17592186490430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d4647a-6d5f-5a8b-afc7-b4c99985c53d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}\\csch^{2} (\\frac{3x}{5}) + C" :db/id #edb/ref 17592186490415} {:answer/id #uuid "2280ea0f-e99f-54d1-b953-8e1352531ba6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\tanh (\\frac{3x}{5})\\sech (\\frac{3x}{5}) + C" :db/id #edb/ref 17592186490421} {:answer/id #uuid "2e5e927e-132b-5ec0-8ee9-f3ec47118484" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\tanh^{2} (\\frac{3x}{5}) + C" :db/id #edb/ref 17592186490423} {:answer/id #uuid "bcfd724e-b61b-572a-adf5-c29284ca88ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\tanh (\\frac{3x}{5}) + C" :db/id #edb/ref 17592186490466} {:answer/id #uuid "f3d02798-e382-5370-91b5-fc2a625a50e0" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\tanh (\\frac{5x}{3}) + C" :db/id #edb/ref 17592186490479}] :answer-field/correct {:answer/id #uuid "bcfd724e-b61b-572a-adf5-c29284ca88ce" :an