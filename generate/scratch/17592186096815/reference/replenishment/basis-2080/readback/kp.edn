f 17592186502529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bdccfd-a872-5628-96d0-c6a02b107d79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{22}(a + b)" :db/id #edb/ref 17592186502440} {:answer/id #uuid "58542225-bd55-57fc-9250-29f88cdd5797" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}(a + b)" :db/id #edb/ref 17592186502473} {:answer/id #uuid "746a7848-54f9-53b2-a59c-3dfee6644d39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}(a + b)" :db/id #edb/ref 17592186502482} {:answer/id #uuid "97a315e2-aab2-5fd7-8089-a4d938b54333" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{244}(a + b)" :db/id #edb/ref 17592186502495} {:answer/id #uuid "9b2195bf-fc5f-5287-9b03-3994142c41cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2 \\sqrt{61}}(a + b)" :db/id #edb/ref 17592186502497}] :answer-field/correct {:answer/id #uuid "9b2195bf-fc5f-5287-9b03-3994142c41cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2 \\sqrt{61}}(a + b)" :db/id #edb/ref 17592186502497} :answer-field/id #uuid "d7f044e6-29b1-57c6-8eb2-22eae3836c28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502516}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f51ffb2c-3881-5972-b74f-4dee263fdce4" :question/problem "The vector $a$ is directed due north-east and $\\mid a|= 10$, while the vector $b$ is directed due south-east and $\\mid b|= 12$. Which of the following is a unit vector that is parallel to $a + b$?\n\n> A scientific calculator is required to answer this question." :question/worked-solution "First, we have to find $a+b$. The given directions are perpendicular, so the triangle law of addition gives a right triangle.\n\nTo find the unit vector corresponding to $a+b$, we have to divide by the magnitude:\n\n$$\nu=\\frac{a+b}{|a+b|}\n$$\n\nTo find the magnitude, we can use the Pythagorean theorem:\n\n$$\n\\begin{aligned}|a+b|^2&=|a|^2+|b|^2\\\\\n&=10^2+12^2\\\\\n&=100+144\\\\\n&=244\\end{aligned}\n$$\n\nTherefore, the magnitude is\n\n$$\n|a+b|=\\sqrt{244}=2 \\sqrt{61}\n$$\n\nand the corresponding unit vector is\n\n$$\n\\begin{aligned}u&=\\frac{a+b}{|a+b|}\\\\\n&=\\frac{1}{2 \\sqrt{61}}(a+b)\\end{aligned}\n$$"}] :knowledge-point/title "Finding a Unit Vector Parallel to a Vector Sum"}]}
