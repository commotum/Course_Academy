                ":answer/value": "N(t)=E(t)+L(t)"
              },
              {
                ":answer/id": "0ef1b856-e606-5faf-bc81-d441b2fbfdf2",
                ":answer/type": ":answer.type/math",
                ":answer/value": "N(t)=E(t)-L(t)"
              },
              {
