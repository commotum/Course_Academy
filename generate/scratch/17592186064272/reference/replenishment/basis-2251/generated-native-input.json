              {
                ":answer/id": "3a07fcac-1eb0-55fb-b21b-22d00521717b",
                ":answer/type": ":answer.type/math",
                ":answer/value": "E(t)=-a(t)"
              },
              {
                ":answer/id": "c54787f5-85be-5ad0-abc1-60d1ab544ae9",
                ":answer/type": ":answer.type/math",
