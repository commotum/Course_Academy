 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CB$, we get\n\n$$\n\\begin{aligned}CB & =\\begin{bmatrix}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{bmatrix} \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186348160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e187316-ca4b-5005-8c16-92779ad4da33" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451699} {:answer/id #uuid "4d689f5f-05dd-57b7-954c-3d17ae60ca4e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451700}] :answer-field/correct {:answer/id #uuid "4d689f5f-05dd-57b7-954c-3d17ae60ca4e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451700} :answer-field/id #uuid "73b27b52-6dbe-5ddb-bbef-45bd0b09c851" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452697} {:answer-field/choices [{:answer/id #uuid "86b0f342-4a40-5b35-b50c-a9da5c348610" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451701} {:answer/id #uuid "0ac73bcb-c0d1-5514-8e54-fcb26aa4a0a6" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451702}] :answer-field/correct {:answer/id #uuid "86b0f342-4a40-5b35-b50c-a9da5c348610" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451701} :answer-field/id #uuid "494ea162-0b29-5250-b36b-ebe80cf3f333" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452698} {:answer-field/choices [{:answer/id #uuid "b