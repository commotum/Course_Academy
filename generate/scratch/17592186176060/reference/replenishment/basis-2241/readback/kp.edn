wer/id #uuid "292ad9c3-556f-503a-b08c-b44ad1d91bac" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186272755} :answer-field/id #uuid "f7315967-925b-5233-bc2d-60b556baa525" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275069}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd48781b-b5c4-5134-ac43-371c5870ba80" :question/math-academy-id "q-158066" :question/problem "If $\\operatorname{csc}⁡a=\\sqrt{5},$ then $\\operatorname{csc}⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-a) & =-\\operatorname{csc}⁡a \\\\  & =-\\sqrt{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275439 :knowledge-point/_questions [{:knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07122d60-244d-56e3-a00b-eb96f3716142" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186272449} {:answer/id #uuid "25672e79-fe59-50ab-8635-6d7d292513d5" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186272715} {:answer/id #uuid "5e2d5e9a-aa6a-5731-9d0f-dfa77ea66bfb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273196} {:answer/id #uuid "8af6a938-9009-5120-a929-4672c7317691" :answer/type {:db/ident :answer.type/