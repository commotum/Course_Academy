ge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b95ba0-8776-5e87-8a07-fb4dd6e251e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{728}{\\operatorname{ln}⁡3}" :db/id 17592186295276} {:answer/id #uuid "36229afc-ab9a-5470-be3f-a37b681ee81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{3}" :db/id 17592186295571} {:answer/id #uuid "43ef6c71-98a2-5c12-8945-04c4d08e3cc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{\\operatorname{ln}⁡3}" :db/id 17592186295649} {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id 17592186295895} {:answer/id #uuid "8fc47e71-ee79-5542-acba-c30ea159db79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{121}{\\operatorname{ln}⁡3}" :db/id 17592186296034}] :answer-field/correct {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id 17592186295895} :answer-field/id #uuid "dcf773c9-a379-54a1-a3f0-7de93b756309" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186297089}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34a4e0e2-73c5-54dc-8277-4607c07e4179" :question/math-academy-id "q-30973" :question/problem "Evaluate the integral ${\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6$ |\n\nThen, we can write the integral in terms of  $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x & ={\\int }_{0}^{6}{3}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{0}^{6}{3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{0}^{6} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡3}(729-1) \\\\  & =\\frac{728}{6\\operatorname{ln}⁡3} \\\\  & =\\frac{364}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"} {:db/id 17592186297389 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e3c76b3-9a7e-5c31-b43e-02f9be81294d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id 17592186295533} {:answer/id #uuid "4ee811f8-8af9-53fa-be26-778f4f77cd67" :answer/type {:db/ident :answer.type/math} :answer/value "-{5}^{-x}+C" :db/id 17592186295722} {:answer/id #uuid "57a67b0f-0c05-5b5a-b5ea-792d6c56a440" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id 17592186295773} {:answer/id #uuid "5de84312-4ff6-5203-8c07-5a2dbc5c4c3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id 17592186295809} {:answer/id #uuid "c521dc80-7e50-540f-93b7-e321d21cdb8a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{5}^{x}}{\\operatorname{ln}⁡5}+C" :db/id 17592186296307}] :answer-field/correct {:answer/id #uuid "2e3c76b3-9a7e-5c31-b43e-02f9be81294d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C" :db/id 17592186295533} :answer-field/id #uuid "4944a858-6895-5891-aed1-aabff8de8a8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296769}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91e61cac-e373-57ad-92b8-00ce9bccf78c" :question/math-academy-id "q-31412" :question/problem "$\\int {5}^{-x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {5}^{-x}\\,\\text{d}x & =\\int {5}^{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int {5}^{u}\\,\\text{d}u \\\\  & =-\\frac{{5}^{u}}{\\operatorname{ln}⁡5}+C \\\\  & =-\\frac{{5}^{-x}}{\\operatorname{ln}⁡5}+C\\end{aligned}\n$$"} {:db/id 17592186297390 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0233f9ce-2764-5d65-ab16-8209abe9223a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/id 17592186295274} {:answer/id #uuid "12f09c2c-e425-5277-8d43-cc46fdd169bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5}+C" :db/id 17592186295370} {:answer/id #uuid "3076245a-c830-5476-aa4e-faa07b490fd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{\\operatorname{ln}⁡4}+C" :db/id 17592186295544} {:answer/id #uuid "60697ea3-02a7-5388-b168-e038e029d1f8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{4}^{5x-7}}{5\\operatorname{ln}⁡4}+C" :db/id 17592186295819} {:answer/id #uuid "e998d14b-9dc3-5546-a7f6-0253d13262c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{\\operatorname{ln}⁡4}+C" :db/id 17592186296510}] :answer-field/correct {:answer/id #uuid "0233f9ce-2764-5d65-ab16-8209abe9223a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/id 17592186295274} :answer-field/id #uuid "1b9605dc-1036-5199-9391-eb2590d1187e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296686}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "747ae585-9faa-50cc-acc3-b1e5b1896ba8" :question/math-academy-id "q-31413" :question/problem "$\\int {4}^{5x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=5x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {4}^{5x}\\,\\text{d}x & =\\int {4}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C\\end{aligned}\n$$"} {:db/id 17592186297396 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1277c0e2-5004-5ee3-b7fe-7022e68c6a19" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{x}}{3\\operatorname{ln}⁡6}+C" :db/id 17592186295368} {:answer/id #uuid "7cdefd48-2695-5a38-8f5d-ed070355571e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{3\\operatorname{ln}⁡6}+C" :db/id 17592186295950} {:answer/id #uuid "cd384b9e-3f21-5c93-8eef-f209d288044d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id 17592186296343} {:answer/id #uuid "d8ca43b4-033c-5cd0-a8a6-8ea7eb292ebc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x}}{\\operatorname{ln}⁡3}+C" :db/id 17592186296410} {:answer/id #uuid "e19fa8a4-2ede-5cc9-a74c-dbb6cdba1380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{\\operatorname{ln}⁡3}+C" :db/id 17592186296468}] :answer-field/correct {:answer/id #uuid "cd384b9e-3f21-5c93-8eef-f209d288044d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id 17592186296343} :answer-field/id #uuid "1db9f319-6a3e-51d1-bbc2-fd789260b0da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296690}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a2ea8a4-727a-5496-81cd-8ee505de6239" :question/math-academy-id "q-31417" :question/problem "$\\int {6}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {6}^{x/3}\\,\\text{d}x & =\\int {6}^{u}\\cdot 3\\,\\text{d}u \\\\  & =3\\int {6}^{u}\\,\\text{d}u \\\\  & =3\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C\\end{aligned}\n$$"} {:db/id 17592186319347 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9887105-989f-5006-a00d-02997b258f61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{108}{\\operatorname{ln}3}" :db/id 17592186318395}] :answer-field/correct {:answer/id #uuid "f9887105-989f-5006-a00d-02997b258f61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{108}{\\operatorname{ln}3}" :db/id 17592186318395} :answer-field/id #uuid "a4926046-d89b-5f97-a176-004edee262b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318786}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94f9e06c-ebba-5efe-8b0d-89981a71a1e9" :question/math-academy-id "q-349625" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}{3}^{7-2x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=7-2x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $2$ |\n| --- | --- | --- |\n| $u$ | $5$ | $3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{3}^{7-2x}\\,\\text{d}x & ={\\int }_{5}^{3}{3}^{u}(-\\frac{1}{2})\\text{d}u \\\\  & =-\\frac{1}{2}{\\int }_{5}^{3}{3}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{5}^{3} \\\\  & =-\\frac{1}{2\\operatorname{ln}⁡3}({3}^{3}-{3}^{5}) \\\\  & =-\\frac{1}{2\\operatorname{ln}⁡3}(27-243) \\\\  & =\\frac{108}{\\operatorname{ln}⁡3}\\end{aligned}\n$$"} {:db/id 17592186319348 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cabb7ef7-a5b4-56a3-899b-b57c3c0202b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{\\operatorname{ln}2}" :db/id 17592186318237}] :answer-field/correct {:answer/id #uuid "cabb7ef7-a5b4-56a3-899b-b57c3c0202b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{36}{\\operatorname{ln}2}" :db/id 17592186318237} :answer-field/id #uuid "b60ea954-3843-5ca8-a4a4-8f56cec4f3ce" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318818}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "84ff8262-4ace-5df5-9e7e-b8458e5e65ea" :question/math-academy-id "q-349626" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{3}3\\cdot {2}^{5-x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5-x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $1$ | $3$ |\n| --- | --- | --- |\n| $u$ | $4$ | $2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}3\\cdot {2}^{5-x}\\,\\text{d}x & ={\\int }_{4}^{2}3\\cdot {2}^{u}(-1)\\text{d}u \\\\  & =-3{\\int }_{4}^{2}{2}^{u}\\,\\text{d}u \\\\  & =-3(\\frac{{2}^{u}}{\\operatorname{ln}⁡2}){|}_{4}^{2} \\\\  & =-\\frac{3}{\\operatorname{ln}⁡2}({2}^{2}-{2}^{4}) \\\\  & =-\\frac{3}{\\operatorname{ln}⁡2}(4-16) \\\\  & =\\frac{36}{\\operatorname{ln}⁡2}\\end{aligned}\n$$"} {:db/id 17592186319349 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1e0d6d6-2adc-5995-80ee-179a5a470810" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}4}" :db/id 17592186318207}] :answer-field/correct {:answer/id #uuid "c1e0d6d6-2adc-5995-80ee-179a5a470810" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}4}" :db/id 17592186318207} :answer-field/id #uuid "7afa991a-6722-56e2-897c-813ea6c1aef9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318684}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "efb81182-b47b-5e4a-b191-d85df24ba0ef" :question/math-academy-id "q-349631" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2\\cdot {4}^{1-x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=1-x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {4}^{1-x}\\,\\text{d}x & ={\\int }_{1}^{0}2\\cdot {4}^{u}(-1)\\text{d}u \\\\  & =-2{\\int }_{1}^{0}{4}^{u}\\,\\text{d}u \\\\  & =-2(\\frac{{4}^{u}}{\\operatorname{ln}⁡4}){|}_{1}^{0} \\\\  & =-\\frac{2}{\\operatorname{ln}⁡4}({4}^{0}-{4}^{1}) \\\\  & =-\\frac{2}{\\operatorname{ln}⁡4}(1-4) \\\\  & =\\frac{6}{\\operatorname{ln}⁡4}\\end{aligned}\n$$"} {:db/id 17592186319350 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "723152d6-ad7a-5796-b242-18a007f91b9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5\\operatorname{ln}5}" :db/id 17592186317958}] :answer-field/correct {:answer/id #uuid "723152d6-ad7a-5796-b242-18a007f91b9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5\\operatorname{ln}5}" :db/id 17592186317958} :answer-field/id #uuid "58ca831c-f339-532f-9ae7-145293aca3d4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318616}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "442a9420-19fe-5c7f-9765-ddb48edbec27" :question/math-academy-id "q-349646" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}{5}^{x-1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=x-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{5}^{x-1}\\,\\text{d}x & ={\\int }_{-1}^{1}{5}^{u}\\text{d}u \\\\  & =\\frac{{5}^{u}}{\\operatorname{ln}⁡5}\\,{|}_{-1}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}({5}^{1}-{5}^{-1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}(5-\\frac{1}{5}) \\\\  & =\\frac{24}{5\\operatorname{ln}⁡5}\\end{aligned}\n$$"} {:db/id 17592186319351 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd67e3a7-28e0-5d80-ab9d-4eee46bad316" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\operatorname{ln}3}" :db/id 17592186318412}] :answer-field/correct {:answer/id #uuid "fd67e3a7-28e0-5d80-ab9d-4eee46bad316" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\operatorname{ln}3}" :db/id 17592186318412} :answer-field/id #uuid "9f378587-0bf1-5acc-baa3-21eda4addc7b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318771}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ff1abc0-7cbc-5bd4-915a-56c8cc58e75d" :question/math-academy-id "q-349648" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{1}{3}^{x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $-1$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{3}^{x+1}\\,\\text{d}x & ={\\int }_{0}^{2}{3}^{u}\\text{d}u \\\\  & =\\frac{{3}^{u}}{\\operatorname{ln}⁡3}\\,{|}_{0}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}({3}^{2}-{3}^{0}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡3}(9-1) \\\\  & =\\frac{8}{\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}
