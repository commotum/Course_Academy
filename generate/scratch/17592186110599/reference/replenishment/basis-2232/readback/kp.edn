] :answer-field/correct {:answer/id #uuid "353e9959-adb7-500d-aa93-3169ee36c6ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{10}x-9" :db/id #edb/ref 17592186514641} :answer-field/id #uuid "85e7701d-aafb-5911-9003-d9d462d822a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514666}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "af45c5c3-91a1-5607-bf89-9cfa7beab691" :question/problem "Which of the following lines is perpendicular to $y=10x+8?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=10x+8$ is in slope-intercept form, and its slope is $10.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{10}x-9$ has a slope of $-\\frac{1}{10}.$\n\nMultiplying the slopes together, we have\n\n$$\n10\\cdot -\\frac{1}{10}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{10}x-9$ is perpendicular to the given line."} {:db/id #edb/ref 17592186514689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "083e304b-73a4-5cf4-b83a-e7ebe7dc4d53" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{5}{2}x-4" :db/id #edb/ref 17592186514624} {:answer/id #uuid "2da5ce46-c8ee-58d3-b5e8-63a5b5a86a7b" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-2" :db/id #edb/ref 17592186514636} {:answer/id #uuid "561e7243-a7fc-5182-81a7-5699cf29ecd1" :answer/type {:db/ident :answer.type/math} :answer/value "y=5" :db/id #edb/ref 17592186514651} {:answer/id #uuid "589d48f7-1a7e-539d-91ca-f61a7a3fc39f" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{2}{5}x+1" :db/id #edb/ref 17592186514652} {:answer/id #uuid "94b969a1-e289-5171-81e4-7537d3b48e83" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{2}{5}x+3" :db/id #edb/ref 17592186514671}] :answer-field/correct {:answer/id #uuid "94b969a1-e289-5171-81e4-7537d3b48e83" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{2}{5}x+3" :db/id #edb/ref 17592186514671} :answer-field/id #uuid "afb82cb4-9746-5d5d-bec8-83ce19ebfb9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186514681}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d2d7efc7-1d0b-522e-8c1f-c3f30495049a" :question/problem "Which of the following lines is perpendicular to $y=-\\frac{5}{2}x+2?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\frac{5}{2}x+2$ is in slope-intercept form, and its slope is $-\\frac{5}{2}.$\n\nLooking at the answer choices, the line $y=\\frac{2}{5}x+3$ has a slope of $\\frac{2}{5}.$\n\nMultiplying the slopes together, we have\n\n$$\n-\\frac{5}{2}\\cdot \\frac{2}{5}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{2}{5}x+3$ is perpendicular to the given line."}] :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}]}
