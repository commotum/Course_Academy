{:db/id 17592186059714 :knowledge-point/canonical-example {:db/id 17592186059527 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/id #uuid "e2b211fe-d37a-55dd-bf76-9ffab2b6f128" :question/math-academy-id "e-4297" :question/problem "Let $\\mathbf{a}=\\langle -4, 6 \\rangle$. Find $\\mid \\,\\mathbf{a}\\, \\mid$." :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}\n\\mid a \\mid &= \\sqrt{a_{x}^{2} + a_{y}^{2}} \\\\\n&= \\sqrt{(-4)^{2} + (6)^{2}} \\\\\n&= \\sqrt{16 + 36} \\\\\n&= 2\\sqrt{13}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/key-prerequisites [{:db/id 17592186048882}] :knowledge-point/questions [{:db/id 17592186060029 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6b4ebe4-9baa-5ff0-847a-49d99ba69795" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "867aed2c-b35e-5007-9ac2-00eb9f789e80" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id 17592186056533} {:answer/id #uuid "b570b441-3e76-5296-a70a-898635c0d51b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186056534} {:answer/id #uuid "1e5efcaa-fda8-5f46-86a8-ec26f06edd9a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{17}" :db/id 17592186056535} {:answer/id #uuid "2fd699d3-7d66-5b5d-9684-70191f970035" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id 17592186056536} {:answer/id #uuid "56b171f0-eae2-5de6-86da-e18b78da9838" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id 17592186056537}] :answer-field/id #uuid "0c808bac-3136-50e9-88db-5847268bcea6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 1759218