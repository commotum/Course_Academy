type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186534712}] :answer-field/correct {:answer/id #uuid "8eaafbe0-875e-51ef-a1b4-485b9238f00b" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{3}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{3}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186534576} :answer-field/id #uuid "924189b9-9f44-5d21-8b15-c9796978fa53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534911}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a981750b-2a73-53da-b2bb-9bf98660a4c5" :question/math-academy-id "q-105916" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $\\frac{1}{3}$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=\\frac{1}{3}.$ Therefore, the parametric equations of the circle are \n\n$$\nx=\\frac{1}{3}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{3}\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at the Origin"}]}
