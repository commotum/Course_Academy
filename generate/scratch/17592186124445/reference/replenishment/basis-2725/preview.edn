86045443 true] [17592186560224 1083 #uuid "1f52df86-7c68-5ef2-ab8a-b6ffb44b99a4" 13194139536038 17592186045443 true] [17592186560225 1075 #edb/ref 17592186560231 13194139536038 17592186045443 true] [17592186560225 1075 #edb/ref 17592186560233 13194139536038 17592186045443 true] [17592186560225 1075 #edb/ref 17592186560235 13194139536038 17592186045443 true] [17592186560225 1075 #edb/ref 17592186560241 13194139536038 17592186045443 true] [17592186560225 1075 #edb/ref 17592186560251 13194139536038 17592186045443 true] [17592186560225 1076 #edb/ref 17592186045493 13194139536038 17592186045443 true] [17592186560225 1077 "selection" 13194139536038 17592186045443 true] [17592186560225 1078 #edb/ref 17592186560251 13194139536038 17592186045443 true] [17592186560225 1079 #uuid "32a3ba95-14d4-5176-8a6e-171c8d545d55" 13194139536038 17592186045443 true] [17592186560226 1068 #edb/ref 17592186560225 13194139536038 17592186045443 true] [17592186560226 1070 #edb/ref 17592186045485 13194139536038 17592186045443 true] [17592186560226 1071 "Given that $f(x,y)= (y + 1)\\ln (x + 4),$ find the points $(x, y)$ where $\\nabla f(x,y) = \\mathbf 0.$" 13194139536038 17592186045443 true] [17592186560226 1072 #uuid "386b29aa-4458-560c-9279-5b720c1afe27" 13194139536038 17592186045443 true] [17592186560226 1074 "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((y + 1)\\ln (x + 4)) \\\\  & =\\frac{y + 1}{x + 4} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((y + 1)\\ln (x + 4)) \\\\  & =\\ln(x + 4)\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\nabla f(x,y) = \\dfrac {y + 1}{x + 4} \\, \\mathbf i + \\ln(x + 4) \\, \\mathbf j.\n$$\n\nNow, we solve $\\nabla f(x,y) = \\mathbf 0\\mathbin{:}$\n\n$$\n\\dfrac {y + 1}{x + 4} \\, \\mathbf i + \\ln(x + 4) \\, \\mathbf j = 0 \\mathbf i + 0\\mathbf j\n$$\n\nBy equating the coefficients of $\\mathbf{i}$ on both sides of the equation (and similarly with $\\mathbf{j}$), we obtain\n\n$$\n\\{\\begin{aligned}\\frac{y + 1}{x + 4}=0 \\\\ \\ln(x + 4)=0.\\end{aligned}\n$$\n\nFrom the first equation, we get $y + 1=0,$ which means $y=-1.$ From the second equation, we obtain $\\ln(x + 4)=0,$ which means that $x=-3.$\n\nTherefore, $\\nabla f(x,y) =\\mathbf 0$ at the point $(-3,-1).$" 13194139536038 17592186045443 true] [17592186560227 1075 #edb/ref 17592186560221 13194139536038 17592186045443 true] [17592186560227 1075 #edb/ref 17592186560230 13194139536038 17592186045443 true] [17592186560227 1075 #edb/ref 17592186560236 13194139536038 17592186045443 true] [17592186560227 1075 #edb/ref 17592186560240 13194139536038 17592186045443 true] [17592186560227 1075 #edb/ref 17592186560243 13194139536038 17592186045443 true] [17592186560227 1076 #edb/ref 17592186045493 13194139536038 17592186045443 true] [17592186560227 1077 "selection" 13194139536038 17592186045443 true] [17592186560227 1078 #edb/ref 17592186560230 13194139536038 17592186045443 true] [17592186560227 1079 #uuid "3a2cba62-d6af-5479-baaa-023b4d675d28" 13194139536038 17592186045443 true] [17592186560228 1080 "(-1,0)" 13194139536038 17592186045443 true] [17592186560228 1082 #edb/ref 17592186045498 13194139536038 17592186045443 true] [17592186560228 1083 #uuid "3d754153-fc36-5a9f-8e3a-712811db4818" 13194139536038 17592186045443 true] [17592186560229 1068 #edb/ref 17592186560227 13194139536038 17592186045443 true] [17592186560229 1070 #edb/ref 17592186045485 13194139536038 17592186045443 true] [17592186560229 1071 "Given that $f(x,y)= (y - 3)\\ln (x + 2),$ find the points $(x, y)$ where $\\nabla f(x,y) = \\mathbf 0.$" 13194139536038 17592186045443 true] [17592186560229 1072 #uuid "427b5a56-3af0-5b6f-a52d-5b35601fc9cc" 13194139536038 17592186045443 true] [17592186560229 1074 "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((y - 3)\\ln (x + 2)) \\\\  & =\\frac{y - 3}{x + 2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((y - 3)\\ln (x + 2)) \\\\  & =\\ln(x + 2)\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\nabla f(x,y) = \\dfrac {y - 3}{x + 2} \\, \\mathbf i + \\ln(x + 2) \\, \\mathbf j.\n$$\n\nNow, we solve $\\nabla f(x,y) = \\mathbf 0\\mathbin{:}$\n\n$$\n\\dfrac {y - 3}{x + 2} \\, \\mathbf i + \\ln(x + 2) \\, \\mathbf j = 0 \\mathbf i + 0\\mathbf j\n$$\n\nBy equating the coefficients of $\\mathbf{i}$ on both sides of the equation (and similarly with $\\mathbf{j}$), we obtain\n\n$$\n\\{\\begin{aligned}\\frac{y - 3}{x + 2}=0 \\\\ \\ln(x + 2)=0.\\end{aligned}\n$$\n\nFrom the first equation, we get $y - 3=0,$ which means $y=3.$ From the second equation, we obtain $\\ln(x + 2)=0,$ which means that $x=-1.$\n\nTherefore, $\\nabla f(x,y) =\\mathbf 0$ at the point $(-1,3).$" 13194139536038 17592186045443 true] [17592186560230 1080 "(-1,3)" 13194139536038 17592186045443 true] [17592186560230 1082 #edb/ref 17592186045498 13194139536038 17592186045443 true] [17592186560230 1083 #uuid "5458a70e-13a8-579e-84a4-8d6dc6f7c8b3" 13194139536038 17592186045443 true] [17592186560231 1080 "(-3,1)" 13194139536038 17592186045443 true] [17592186560231 1082 #edb/ref 17592186045498 13194139536038 17592186045443 true] [17592186560231 1083 #uuid "567b3d3d-d78d-511c-9b35-cd452b837745" 13194139536038 17592186045443 true] [17592186560232 1080 "(1,-3)" 13194139536038 17592186045443 true] [17592186560232 1082 #edb/ref 17592186045498 13194139536038 17592186045443 true] [17592186560232 1083 #uuid "59449bac-6962-5a16-a33c-e8613d668c3d" 13194139536038 17592186045443 true] [17592186560233 1080 "(-3,0)" 13194139536038 17592186045443 true] [17592186560233 1082 #edb/ref 17592186045498 13194139536038 17592186045443 true] [17592186560233 1083 #uuid "69fb122d-4d8d-5d0c-8fdf-0488493b4db2" 13194139536038 17592186045443 true] [17592186560234 1080 "(3,3)" 13194139536038 17592186045443 true] [17592186560234 1082 #edb/ref 17592186045498 13194139536038 17592186045443 true] [17592186560234 1083 #uuid "6a3127d6-0562-5c26-9acf-f7f09b3aa64a" 13194139536038 17592186045443 true] [17592186560235 1080 "(-5,-1)" 13194139536038 1759218604