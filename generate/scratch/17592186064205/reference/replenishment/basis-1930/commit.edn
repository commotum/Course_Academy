{\\text{d}}{\\text{d}z}[(-9-9z)^{1/2}]+\\frac{\\text{d}}{\\text{d}z}(C) \\\\  & =-\\frac{2}{9}\\cdot \\frac{1}{2}(-9-9z)^{-1/2}\\cdot \\frac{\\text{d}}{\\text{d}z}(-9-9z)+0 \\\\  & =-\\frac{1}{9}\\cdot (-9-9z)^{-1/2}\\cdot (-9) \\\\  & =(-9-9z)^{-1/2} \\\\  & =\\frac{1}{\\sqrt{-9-9z}}\\,✓\\end{aligned}\n$$" 13194139535243 17592186045443 true] [17592186484774 1080 "\\frac{1}{5}\\sqrt{(5x-50)^{3}}+C" 13194139535243 17592186045443 true] [17592186484774 1082 #edb/ref 17592186045498 13194139535243 17592186045443 true] [17592186484774 1083 #uuid "27a0fde4-6c24-58e7-8907-6d8654047db1" 13194139535243 17592186045443 true] [17592186484775 1080 "\\frac{2}{15}\\sqrt{(5x-50)^{3}}+C" 13194139535243 17592186045443 true] [17592186484775 1082 #edb/ref 17592186045498 13194139535243 17592186045443 true] [17592186484775 1083 #uuid "395ccb33-f39e-5064-b2d3-f2afb52894fa" 13194139535243 17592186045443 true] [17592186484776 1080 "9\\sqrt{-9-9z}+C" 13194139535243 17592186045443 true] [17592186484776 1082 #edb/ref 17592186045498 13194139535243 17592186045443 true] [17592186484776 1083 #uuid "3bc1f79d-9230-53d0-94a1-8d0212d70804" 13194139535243 17592186045443 true] [17592186484777 1080 "\\frac{1}{5}\\sqrt{5x-50}+C" 13194139535243 17592186045443 true] [17592186484777 1082 #edb/ref 17592186045498 13194139535243 17592186045443 true] [17592186484777 1083 #uuid "5e1f2e80-7a1d-5bc0-972b-78c0f2b50e11" 13194139535243 17592186045443 true] [17592186484778 1080 "-\\frac{2}{9}\\sqrt{-9-9z}+C" 13194139535243 17592186045443 true] [17592186484778 1082 #edb/ref 17592186045498 13194139535243 17592186045443 true] [17592186484778 1083 #uuid "6b37e588-2985-50e0-b7f6-7cb598fa2168" 13194139535243 17592186045443 true] [17592186484779 1080 "2\\sqrt{(-9-9z)^{3}}+C" 13194139535243 17592186045443 true] [17592186484779 1082 #edb/ref 17592186045498 13194139535243 17592186045443 true] [17592186484779 1083 #uuid "81cb5d78-ddc4-5567-b381-5ebc30345f71" 13194139535243 17592186045443 true] [17592186484780 1080 "\\frac{2}{3}\\s