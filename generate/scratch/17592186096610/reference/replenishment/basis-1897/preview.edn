186045443 true] [17592186480016 1072 #uuid "5104b80b-063d-53dc-91b3-3f3e99aa0687" 13194139535210 17592186045443 true] [17592186480016 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $ln⁡7$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{5}{2}{e}^{x}+ln⁡7) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{5}{2}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(ln⁡7) \\\\  & =- \\frac{5}{2}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =- \\frac{5}{2}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡9$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡9} & ={(- \\frac{5}{2}{e}^{x})\\,|}_{x=-ln⁡9} \\\\  & =- \\frac{5}{2}{e}^{-ln⁡9} \\\\  & =- \\frac{5}{2}\\cdot \\frac{1}{9} \\\\  & =- \\frac{5}{18}.\\end{aligned}\n$$" 13194139535210 17592186045443 true] [17592186480017 1068 #edb/ref 17592186480021 13194139535210 17592186045443 true] [17592186480017 1070 #edb/ref 17592186045487 13194139535210 17592186045443 true] [17592186480017 1071 "Given that $f(x)=- \\frac{4}{3}{e}^{x}+2$, the slope of the tangent line at $x=-ln⁡2$ is{{field-1}}." 13194139535210 17592186045443 true] [17592186480017 1072 #uuid "5184f338-d6d0-533d-88bb-8b37da109e6c" 13194139535210 17592186045443 true] [17592186480017 1074 "The derivative of ${e}^{x}$ is just ${e}^{x}$ itself. On the other hand, $2$ is a constant, so its derivative is $0.$\n\nFirst, using the addition rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{4}{3}{e}^{x}+2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(- \\frac{4}{3}{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =- \\frac{4}{3}\\frac{\\text{d}}{\\text{d}x}({e}^{x})+0 \\\\  & =- \\frac{4}{3}{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-ln⁡2$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-ln⁡2} & ={(- \\frac{4}{3}{e}^{x})\\,|}_{x=-ln⁡2} \\\\  & =- \\frac{4}{3}{e}^{-ln⁡2} \\\\  & =- \\frac{4}{3}\\cdot \\frac{1}{2} \\\\  & =- \\frac{2}{3}.\\end{aligned}\n$$" 13194139535210 17592186045443 true] [17592186480018 1080 "f^{′}(x) = 2e^{x} + \\ln 2" 13194139535210 17592186045443 true] [17592186480018 1082 #edb/ref 17592186045498 13194139535210 17592186045443 true] [17592186480018 1083 #uuid "548f8af3-6988-5dcf-b7db-7042ec33f9ab" 13194139535210 17592186045443 true] [17592186480019 1075 #edb/ref 17592186480026 13194139535210 17592186045443 true] [17592186480019 1076 #edb/ref 17592186045492 13194139535210 17592186045443 true] [17592186480019 1077 "field-1" 13194139535210 17592186045443 true] [17592186480019 1078 #edb/ref 17592186480026 13194139535210 17592186045443 true] [17592186480019 1079 #uuid "56a8a426-86a3-500f-b11d-f1d5bdfd0d6b" 13194139535210 17592186045443 true] [17592186480020 1080 "\\frac{21}{8}" 13194139535210 17592186045443 true] [17592186480020 1082 #edb/ref 17592186045498 13194139535210 17592186045443 true] [17592186480020 1083 #uuid "5726971d-109b-59ca-a9ae-86038320a437" 13194139535210 17592186045443 true] [17592186480021 1075 #edb/ref 17592186480024 13194139535210 17592186045443 true] [17592186480021 1076 #edb/ref 17592186045492 13194139535210 17592186045443 true] [17592186480021 1077 "field-1" 13194139535210 17592186045443 true] [17592186480021 1078 #edb/ref 17592186480024 13194139535210 17592186045443 true] [17592186480021 1079 #uuid "59172bf7-c76f-53d2-a87d-8c7ee520c969" 13194139535210 17592186045443 true] [17592186480022 1080 "\\frac{16}{15}" 13194139535210 17592186045443 true] [17592186480022 1082 #edb/ref 17592186045498 13194139535210 17592186045443 true] [17592186480022 1083 #uuid "5cf23329-5460-51e6-917d-f464bb0d4626" 13194139535210 17592186045443 true] [17592186480023 1068 #edb/ref 17592186480037 13194139535210 17592186045443 true] [17592186480023 1070 #edb/ref 17592186045486 13194139535210 17592186045443 true] [17592186480023 1071 "Given that $f(x)=\\frac{5}{3}{e}^{x}-8$, the s