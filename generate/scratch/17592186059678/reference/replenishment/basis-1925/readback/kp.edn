correct {:answer/id #uuid "74e1d1f8-4b3b-5f18-a100-a8ccb58c59dd" :answer/type {:db/ident :answer.type/math} :answer/value "6-\\frac{8}{{x}^{3}}" :db/id #edb/ref 17592186315780} :answer-field/id #uuid "c6b14006-56d1-58f0-b9f3-8c1de5bea365" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317022}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd8f94da-36ef-5137-94da-7eeaf5cded56" :question/math-academy-id "q-342877" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{6{x}^{3}+2{x}^{2}-8}{2x}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{6{x}^{3}+2{x}^{2}-8}{2x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+x-4{x}^{-1}) \\\\  & =6x+1+(-1)(-4{x}^{-2}) \\\\  & =6x+1+4{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(6x+1+4{x}^{-2}) \\\\  & =6+0+(-2)(4{x}^{-3}) \\\\  & =6-\\frac{8}{{x}^{3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317347 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247}] :answer-field/correct {:answer/id #uuid "164f3127-7671-5404-8953-09e0fea76c35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}x" :db/id #edb/ref 17592186315247} :answer-field/id #uuid "4ead05b7-6e52-5257-883b-117555657e43" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b404face-8b9a-5dc3-b331-958133c51335" :question/math-academy-id "q-342966" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=6\\sqrt{x}+5\\operatorname{cos}⁡x.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5\\operatorname{cos}⁡x) \\\\  & =(\\frac{1}{2})\\cdot 6{x}^{-1/2}+5(-\\operatorname{sin}⁡x) \\\\  & =3{x}^{-1/2}-5\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{-1/2}-5\\operatorname{sin}⁡x) \\\\  & =(-\\frac{1}{2})\\cdot 3{x}^{-3/2}-5\\operatorname{cos}⁡x \\\\  & =-\\frac{3}{2\\sqrt{{x}^{3}}}-5\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317348 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c013f9b-32c6-561a-8bb7-5ffbeeb02352" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{3}-3\\operatorname{sin}x" :db/id #edb/ref 17592186315804}] :answer-field/correct {:answer/id #uuid "7c013f9b-32c6-561a-8bb7-5ffbeeb02352" :answer/type {:db/ident :answer.type/math} :answer/value "20{x}^{3}-3\\operatorname{sin}x" :db/id #edb/ref 17592186315804} :answer-field/id #uuid "6ab75fc2-e886-5595-bce3-c49cad6edb6a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bacdaf5-3165-55be-a1a2-4605e9c99c4f" :question/math-academy-id "q-342970" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y={x}^{5}+3\\operatorname{sin}⁡x-\\frac{1}{{x}^{2}}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$ \n{{field-1}}\n$-\\,\\frac{6}{{x}^{4}}$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+3\\operatorname{sin}⁡x-\\frac{1}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+3\\operatorname{sin}⁡x-{x}^{-2}) \\\\  & =5{x}^{4}+3\\operatorname{cos}⁡x-(-2){x}^{-3} \\\\  & =5{x}^{4}+3\\operatorname{cos}⁡x+2{x}^{-3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+3\\operatorname{cos}⁡x+2{x}^{-3}) \\\\  & =4\\cdot 5{x}^{3}+3(-\\operatorname{sin}⁡x)+(-3)\\cdot 2{x}^{-4} \\\\  & =20{x}^{3}-3\\operatorname{sin}⁡x-\\frac{6}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484409 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62a7c57a-402a-5316-967c-d531e59f7eb2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484411}] :answer-field/correct {:answer/id #uuid "62a7c57a-402a-5316-967c-d531e59f7eb2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484411} :answer-field/id #uuid "2bafd2c9-bbbc-52ec-862f-3ce38d24c0e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186484408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "37315e0b-7879-5b79-8d31-f3ffb31ff99f" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=3\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right).$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\left(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}\\right)) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\left(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}\\right)) \\\\  & =3\\left(8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2}\\right) \\\\  & =3\\left(2{x}^{7}+1+2{x}^{-3/2}\\right).\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3\\left(2{x}^{7}+1+2{x}^{-3/2}\\right)) \\\\  & =3\\left(7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2}\\right) \\\\  & =3\\left(14{x}^{6}-3{x}^{-5/2}\\right) \\\\  & =3\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186484412 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70cd9538-668f-54c8-9da5-97936e550794" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484413}] :answer-field/correct {:answer/id #uuid "70cd9538-668f-54c8-9da5-97936e550794" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}\\right)" :db/id #edb/ref 17592186484413} :answer-field/id #uuid "ef1ec59e-24d2-5