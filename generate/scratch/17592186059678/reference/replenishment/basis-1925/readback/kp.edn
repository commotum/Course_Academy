-5358-ae2f-b0968d4a0f14" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+8" :db/id #edb/ref 17592186242985}] :answer-field/correct {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} :answer-field/id #uuid "17955a33-082e-5b39-af43-2edeaac25d20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7a8a2be-ff9a-5f4a-96bd-e383a3bb4443" :question/math-academy-id "q-10903" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=5{x}^{4}+4{x}^{2}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+4{x}^{2}) \\\\  & =4\\cdot 5{x}^{3}+2\\cdot 4x \\\\  & =20{x}^{3}+8x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(20{x}^{3}+8x) \\\\  & =3\\cdot 20{x}^{2}+8 \\\\  & =60{x}^{2}+8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233603 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "443f2d86-b193-514f-8fa7-b04ad26e2b53" :question/math-academy-id "q-1873" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=-3\\operatorname{sin}x+5{x}^{3}-19.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{sin}x+5{x}^{3}-19) \\\\  & =-3\\operatorname{cos}x+3\\cdot 5{x}^{2}-0 \\\\  & =-3\\operatorname{cos}x+15{x}^{2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{cos}x+15{x}^{2}) \\\\  & =-3(-\\operatorname{sin}x)+2\\cdot 15x \\\\  & =3\\operatorname{sin}x+30x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233938 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8c3d43f-23b0-5425-88c0-fc158bde4601" :answer/type {:db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186232893}] :answer-field/correct {:answer/id #uuid "a8c3d43f-23b0-5425-88c0-fc158bde4601" :answer/type {:db/ident :answer.type/math} :answer/value "14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186232893} :answer-field/id #uuid "81d972e8-8030-589f-a30d-a41cff65da46" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232892}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0540428-ac4f-55af-ae7e-8832aecc5895" :question/math-academy-id "q-342868" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}.$\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{4}+x-\\frac{4}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{8}}{4}+x-4{x}^{-1/2}) \\\\  & =8\\cdot \\frac{{x}^{7}}{4}+1-(-\\frac{1}{2})\\cdot 4{x}^{-3/2} \\\\  & =2{x}^{7}+1+2{x}^{-3/2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7}+1+2{x}^{-3/2}) \\\\  & =7\\cdot 2{x}^{6}+0+(-\\frac{3}{2})\\cdot 2{x}^{-5/2} \\\\  & =14{x}^{6}-3{x}^{-5/2} \\\\  & =14{x}^{6}-\\frac{3}{\\sqrt{{x}^{5}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240821 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1011aa3a-954e-50dc-ae18-549fb483dc2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}}-\\frac{1}{2{x}^{4}}" :db/id #edb/ref 17592186238192} {:answer/id #uuid "37a1c828-f01a-5291-b4c3-a7df666b6ef7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{x}^{4}}+\\frac{1}{x}" :db/id #edb/ref 17592186238537} {:answer/id #uuid "624d0f96-ecbc-542d-a722-fcec02fdffb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186238921} {:answer/id #uuid "77f204bc-bb7d-50f3-9399-6ddab9bf24e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3{x}^{3}}-\\frac{2}{x}" :db/id #edb/ref 17592186239090} {:answer/id #uuid "cf221d71-61bf-50ec-ba67-26d985655f37" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{x}^{2}}-\\frac{1}{{x}^{4}}" :db/id #edb/ref 17592186239871}] :answer-field/correct {:answer/id #uuid "624d0f96-ecbc-542d-a722-fcec02fdffb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186238921} :answer-field/id #uuid "25967c04-e2d2-5d17-a034-bddf2421e5de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240397}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c5fc6aa-a9f3-5065-aa63-827da84b30b5" :question/math-academy-id "q-104191" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=ln⁡x+\\frac{1}{6{x}^{2}}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+\\frac{1}{6{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+\\frac{1}{6}{x}^{-2}) \\\\  & =\\frac{1}{x}+\\frac{1}{6}\\cdot (-2){x}^{-2-1} \\\\  & ={x}^{-1}-\\frac{1}{3}{x}^{-3}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}({x}^{-1}-\\frac{1}{3}{x}^{-3}) \\\\  & =(-1){x}^{-1-1}-\\frac{1}{3}\\cdot (-3){x}^{-3-1} \\\\  & =\\frac{1}{{x}^{4}}-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186240822 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa44a27-ef68-5389-9758-f884a5d93477" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x" :db/id #edb/ref 17592186238277} {:answer/id #uuid "2415dd70-94cd-5924-9d0e-22cf05a020c7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{{x}^{5}}}+cos⁡x" :db/id #edb/ref 17592186238374} {:answer/id #uuid "93cb1ee1-225c-5deb-b3e5-a0bf21607a98" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{{x}^{5}}-sin⁡x" :db/id #edb/ref 17592186239332} {:answer/id #uuid "9d1e2a22-2c42-5e28-96bc-5600c10b0095" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3\\sqrt{{x}^{5}}}+2sin⁡x" :db/id #edb/ref 17592186239420} {:answer/id #uuid "b15c3867-b8c6-5277-b1af-d18fc8689a91" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{{x}^{5}}-2cos⁡x" :db/id #edb/ref 17592186239603}] :answer-field/correct {:answer/id #uuid "1aa44a27-ef68-5389-9758-f884a5d93477" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x" :db/id #edb/ref 17592186238277} :answer-field/id #uuid "3465f331-8843-5ef7-b5b2-36db197078df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240427}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7aef485-7834-5512-aabf-9615a3c07b9a" :question/math-academy-id "q-104192" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=\\frac{4}{\\sqrt{x}}+2sin⁡x.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{\\sqrt{x}}+2sin⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{-1/2}+2sin⁡x) \\\\  & =4(-\\frac{1}{2}){x}^{-1/2-1}+2cos⁡x \\\\  & =-2{x}^{-3/2}+2cos⁡x.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-3/2}+2cos⁡x) \\\\  & =-2(-\\frac{3}{2}){x}^{-3/2-1}-2sin⁡x \\\\  & =\\frac{3}{\\sqrt{{x}^{5}}}-2sin⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244175 :knowledge-point/_questions [{:knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55141915-0d74-5334-b370-96432f69b95b" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}-24x-20" :db/id #edb/ref 17592186241947} {:answer/id #uuid "6306efd5-043b-539c-91ee-7e9f27e5dfbc" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+24x-22" :db/id #edb/ref 17592186242071} {:answer/id #uuid "b34c7760-3388-5d7c-98f0-4822140cb6c6" :answer/type {:db/ident :answer.type/math} :answer/value "60{x}^{3}+24x-20" :db/id #edb/ref 17592