#{[{:db/id #edb/ref 17592186096742 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096541 :question/id #uuid "b00f1213-cdaf-512c-9842-92cbee1ec63a" :question/math-academy-id "e-6100" :question/problem "Differentiate $y = \\cos^4{2x}.$" :question/worked-solution "First, we express $y$ as a composite function\n\n$$\ny = u^4, \\qquad u = \\cos{v}, \\qquad v = 2x.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = 4u^3,\\qquad \\dfrac{\\textrm{d}u}{\\textrm d v} = -\\sin{v},\\qquad \\dfrac{\\textrm{d}v}{\\textrm d x} = 2.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-\\operatorname{sin}⁡v)\\cdot (2) \\\\  & =4(\\operatorname{cos}⁡2x)^{3}\\cdot (-\\operatorname{sin}⁡2x)\\cdot (2) \\\\  & =-8{cos}^{3}⁡2x\\operatorname{sin}⁡2x.\\end{aligned}\n$$"} :knowledge-point/id #uuid "f3ee0d5d-0821-5f6b-b613-6b814e65df50" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049332} {:db/id #edb/ref 17592186050271} {:db/id #edb/ref 17592186050789} {:db/id #edb/ref 17592186051084}] :knowledge-point/questions [{:db/id #edb/ref 17592186097248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc9442cc-8d33-595e-9e41-73b4047b032d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9\\cos^{2} 3x\\sin 3x" :db/id #edb/ref 17592186095413} {:answer/id #uuid "fcdbd89b-535d-5d97-8858-715b0e7cbab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9\\cos^{2} x\\sin x" :db/id #edb/ref 17592186095414} {:answer/id #uuid "fd99476d-2a11-5897-b1d5-46451cb0f160" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sin^{2} 3x" :db/id #edb/ref 17592186095415} {:answer/id #uuid "5b1e2fac-0635-5edf-ab7e-8243187ee585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sin^{2} 3x\\cos 3x" :db/id #edb/ref 17592186095416} {:answer/id #uuid "6a521037-9532-52ff-8aae-92cf38bd8c05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\cos^{2} 3x\\sin 3x" :db/id #edb/ref 17592186095417}] :answer-field/id #uuid "1e73542d-ef52-5a7f-9676-f9cd21e1ce6b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095412}] :question/id #uuid "287eb86d-de85-5a68-b478-fc3615b0b846" :question/math-academy-id "q-48569" :question/problem "Find $f^{′}(x)$ when $f(x) = \\cos^{3} 3x$."} {:db/id #edb/ref 17592186097249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5d6aa5c-e7ec-5f27-9f30-0940fb6f5772" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sin^{2} 4x\\cos 4x" :db/id #edb/ref 17592186095419} {:answer/id #uuid "eb26a196-10da-5266-a0a6-0432f318280e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sin^{2} 4x\\cos 4x" :db/id #edb/ref 17592186095420} {:answer/id #uuid "140c8dbe-118e-5697-ab9d-2530699d840b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sin^{2} x\\cos x" :db/id #edb/ref 17592186095421} {:answer/id #uuid "52293fad-13c6-5edb-bda4-a70cc3f23bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\sin 4x\\cos 4x" :db/id #edb/ref 17592186095422} {:answer/id #uuid "6af1efa8-0299-5477-97d4-c6cf5ea116b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sin x\\cos x" :db/id #edb/ref 17592186095423}] :answer-field/id #uuid "fa0a0398-2eac-50f7-a78d-91ba28b54adb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095418}] :question/id #uuid "bf61b2d5-63df-5002-abfc-0d0c2d68ffa6" :question/math-academy-id "q-48570" :question/problem "Find $f^{′}(x)$ when $f(x) = \\sin^{3} 4x$."} {:db/id #edb/ref 17592186233557 :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d32bf1a7-eae8-544d-b18f-ee99dc9e7258" :question/math-academy-id "q-16699" :question/problem "Find ${f}^{'}(1)$ when $f(x)={cos}^{3}(5{x}^{2}+2).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{3},\\,u=\\operatorname{cos}v,\\,v=5{x}^{2}+2.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=3{u}^{2},\\,\\frac{\\text{d}u}{\\text{d}v}=-\\operatorname{sin}v,\\,\\frac{\\text{d}v}{\\text{d}x}=10x.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =3{u}^{2}\\cdot (-\\operatorname{sin}v)\\cdot 10x \\\\  & =3(\\operatorname{cos}(5{x}^{2}+2))^{2}\\cdot (-\\operatorname{sin}(5{x}^{2}+2))\\cdot 10x \\\\  & =-30x{cos}^{2}(5{x}^{2}+2)\\operatorname{sin}(5{x}^{2}+2)\\end{aligned}\n$$\n\nNow we compute ${f}^{'}(1):$\n\n$$\n\\begin{aligned}{f}^{'}(1) & =-30(1){cos}^{2}(5(1)^{2}+2)\\operatorname{sin}(5(1)^{2}+2) \\\\  & =-30{cos}^{2}7\\operatorname{sin}7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233782 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "584f034a-e243-5e92-85ec-d412187c42f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-120{x}^{2}" :db/id #edb/ref 17592186232542}] :answer-field/correct {:answer/id #uuid "584f034a-e243-5e92-85ec-d412187c42f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-120{x}^{2}" :db/id #edb/ref 17592186232542} :answer-field/id #uuid "abcda024-6128-542d-bc71-d5c1255b256a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232541}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d78ed24f-7cdd-50da-a7c5-8326d3933908" :question/math-academy-id "q-312907" :question/problem "Find ${f}^{'}(x)$ when $f(x)={cos}^{8}(5{x}^{3}).$\n\n${f}^{'}(x)=$\n{{field-1}} ${cos}^{7}(5{x}^{3})\\operatorname{sin}(5{x}^{3})$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{8},\\,u=\\operatorname{cos}v,\\,v=5{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=8{u}^{7},\\,\\frac{\\text{d}u}{\\text{d}v}=-\\operatorname{sin}v,\\,\\frac{\\text{d}v}{\\text{d}x}=15{x}^{2}.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =8{u}^{7}\\cdot (-\\operatorname{sin}v)\\cdot 15{x}^{2} \\\\  & =8{(\\operatorname{cos}(5{x}^{3}))}^{7}\\cdot (-\\operatorname{sin}(5{x}^{3}))\\cdot 15{x}^{2} \\\\  & =-120{x}^{2}{cos}^{7}(5{x}^{3})\\operatorname{sin}(5{x}^{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290520 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f0c7111-a060-5641-9f28-08ebb3f97820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54x{sin}^{2}⁡(9{x}^{2}-1)\\,\\operatorname{cos}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186288462} {:answer/id #uuid "4bff2b13-d34a-5a2a-ab84-1110b5438aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x{sin}^{2}⁡(9{x}^{2}-1)\\,{cos}^{2}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186288558} {:answer/id #uuid "9a36fc3b-3a7c-5fac-bbfb-9178461a03fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x{sin}^{2}⁡(9{x}^{2}-1)\\,{cos}^{2}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186289063} {:answer/id #uuid "b0394bcf-fb4f-5bf6-9de5-f7e8cc6ee14a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18x{sin}^{2}⁡(9{x}^{2}-1)\\,\\operatorname{cos}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186289196} {:answer/id #uuid "d6add1df-78d9-5682-b6d5-4c7d9b74e6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54x{sin}^{3}⁡(9{x}^{2}-1)\\,{cos}^{3}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186289458}] :answer-field/correct {:answer/id #uuid "3f0c7111-a060-5641-9f28-08ebb3f97820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54x{sin}^{2}⁡(9{x}^{2}-1)\\,\\operatorname{cos}⁡(9{x}^{2}-1)" :db/id #edb/ref 17592186288462} :answer-field/id #uuid "7a37d7f9-8684-5d8d-b945-6f277a28d504" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289997}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d9cfcb56-203d-51a2-aa05-78075c70500a" :question/math-academy-id "q-2397" :question/problem "Find ${f}^{′}(x)$ when $f(x)={sin}^{3}⁡(9{x}^{2}-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{3},\\,u=\\operatorname{sin}⁡v,\\,v=9{x}^{2}-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=3{u}^{2},\\,\\frac{\\text{d}u}{\\text{d}v}=\\operatorname{cos}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=18x.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =3{u}^{2}\\cdot (\\operatorname{cos}⁡v)\\cdot 18x \\\\  & =3(\\operatorname{sin}⁡(9{x}^{2}-1))^{2}\\cdot (\\operatorname{cos}⁡(9{x}^{2}-1))\\cdot 18x \\\\  & =54x{sin}^{2}⁡(9{x}^{2}-1)\\operatorname{cos}⁡(9{x}^{2}-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0480da11-736f-54eb-8f1c-b45c5eafb77b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295288} {:answer/id #uuid "656e07a7-3c98-59bf-85d3-2d52b695e711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295845} {:answer/id #uuid "9bf163c6-73b7-53e4-8558-870d5120e61c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296098} {:answer/id #uuid "a4e00c3b-4340-5c91-be7a-047cb1624ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296136} {:answer/id #uuid "c4fe8de4-4953-53e2-babf-0316522289bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296305}] :answer-field/correct {:answer/id #uuid "0480da11-736f-54eb-8f1c-b45c5eafb77b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295288} :answer-field/id #uuid "6b048a01-7c6a-5074-8040-31f2a7ab3a71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296859}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0b4e552-dbf9-536f-981b-a75efbb821de" :question/math-academy-id "q-28655" :question/problem "Find ${h}^{′}(0)$ when $h(x)={5}^{\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}.$" :question/worked-solution "First, we express $h$ as the composite function\n\n$$\nh={5}^{u},\\,u=\\operatorname{ln}⁡v\\,v=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}h}{\\text{d}u}={5}^{u}\\operatorname{ln}⁡5,\\,\\frac{\\text{d}u}{\\text{d}v}=\\frac{1}{v},\\,\\frac{\\text{d}v}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}h}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}h}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & ={5}^{u}\\operatorname{ln}⁡5\\cdot (\\frac{1}{v})\\cdot (-\\operatorname{sin}⁡x) \\\\  & ={5}^{\\operatorname{ln}⁡\\operatorname{cos}⁡x}\\operatorname{ln}⁡5\\cdot (\\frac{1}{\\operatorname{cos}⁡x})\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-{5}^{\\operatorname{ln}⁡(\\operatorname{cos}⁡x)}\\operatorname{ln}⁡5\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nNow we compute ${h}^{′}(0):$\n\n$$\n\\begin{aligned}{h}^{′}(0) & =-{5}^{\\operatorname{ln}⁡(\\operatorname{cos}⁡0)}\\operatorname{ln}⁡5\\operatorname{tan}⁡0 \\\\  & =-{5}^{\\operatorname{ln}⁡1}\\operatorname{ln}⁡5(0) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a923d0d-683f-5a22-8b67-4a4f6919866f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2(x+6){csc}^{2}⁡[(x+6)^{2}]" :db/id #edb/ref 17592186295424} {:answer/id #uuid "272999f6-d0d3-5ba0-9d45-afe5af8fefcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{csc}^{2}⁡[(x+6)^{2}]" :db/id #edb/ref 17592186295481} {:answer/id #uuid "a23f01d4-b0cf-5d81-b3a4-2e37d3003baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{csc}^{2}⁡[(x+6)^{2}]" :db/id #edb/ref 17592186296131} {:answer/id #uuid "ba4d398b-f413-539d-9058-6015c9708ad4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2(x+6)\\operatorname{csc}⁡(x+6)" :db/id #edb/ref 17592186296244} {:answer/id #uuid "e1aa6a79-375b-56fc-a7eb-84281d9d15fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(x+6)" :db/id #edb/ref 17592186296469}] :answer-field/correct {:answer/id #uuid "1a923d0d-683f-5a22-8b67-4a4f6919866f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2(x+6){csc}^{2}⁡[(x+6)^{2}]" :db/id #edb/ref 17592186295424} :answer-field/id #uuid "1cd72a85-2293-547b-8a73-3db56c2ab7b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c9a1630-1e07-5782-a0c4-5e97e3d68c4f" :question/math-academy-id "q-31352" :question/problem "Find ${y}^{′}$ when $y=\\operatorname{cot}⁡[(x+6)^{2}].$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=\\operatorname{cot}⁡u,\\,u={v}^{2},\\,v=x+6.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u,\\,\\frac{\\text{d}u}{\\text{d}v}=2v,\\,\\frac{\\text{d}v}{\\text{d}x}=1.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (2v)\\cdot 1 \\\\  & =-2(x+6){csc}^{2}⁡[(x+6)^{2}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} {:answer/id #uuid "80ac022d-2fa2-5312-b6bb-20edccc427c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186295959} {:answer/id #uuid "cfd53f52-57a0-58c2-84e5-51e7836dcaa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296358} {:answer/id #uuid "df819a99-e827-5e8d-8038-4bdc1f81e2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\operatorname{cot}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186296451} {:answer/id #uuid "f7c37201-fff5-5a86-9be9-3c9d741d2eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296584}] :answer-field/correct {:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} :answer-field/id #uuid "c18783dd-cacf-52c8-94df-17f7aaad8258" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297033}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "60550674-e8b4-5f20-9b57-5b71c82e6894" :question/math-academy-id "q-31361" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(5x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=5x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=5.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 5 \\\\  & =4(\\operatorname{cot}⁡(5x-1))^{3}\\cdot (-{csc}^{2}⁡(5x-1))\\cdot 5 \\\\  & =-20{cot}^{3}⁡(5x-1){csc}^{2}⁡(5x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-20{cot}^{3}⁡(5(0)-1){csc}^{2}⁡(5(0)-1) \\\\  & =-20{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-20(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =20{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3d2230-dda0-54b6-89ba-24372639fa9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}(2x-1)" :db/id #edb/ref 17592186315198}] :answer-field/correct {:answer/id #uuid "0d3d2230-dda0-54b6-89ba-24372639fa9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}(2x-1)" :db/id #edb/ref 17592186315198} :answer-field/id #uuid "72951b74-10fa-525b-ae61-0c5a5cf05a42" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316821}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c163105-12ab-5d59-bb79-bbc5b4799b09" :question/math-academy-id "q-342927" :question/problem "Find ${y}^{′}$ when $y=\\sqrt{\\operatorname{cos}⁡(2x-1)}.$\n\n| ${y}^{′}$ | $=$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $\\sqrt{\\operatorname{cos}⁡(2x-1)}$ |" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=\\sqrt{u},\\,u=\\operatorname{cos}⁡v,\\,v=2x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\\,\\frac{\\text{d}u}{\\text{d}v}=-\\operatorname{sin}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=2.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot (-\\operatorname{sin}⁡v)\\cdot 2 \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cos}⁡(2x-1)}}\\cdot (-\\operatorname{sin}⁡(2x-1))\\cdot 2 \\\\  & =\\frac{-2\\operatorname{sin}⁡(2x-1)}{2\\sqrt{\\operatorname{cos}⁡(2x-1)}} \\\\  & =\\frac{-\\operatorname{sin}⁡(2x-1)}{\\sqrt{\\operatorname{cos}⁡(2x-1)}}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Derivative Using Multiple Instances of the Chain Rule"}]}
