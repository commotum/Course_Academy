5536 17592186045443 true] [17592186513250 1082 #edb/ref 17592186045498 13194139535536 17592186045443 true] [17592186513250 1083 #uuid "201a36f2-6472-5952-908d-c1599bf04a01" 13194139535536 17592186045443 true] [17592186513251 1068 #edb/ref 17592186513300 13194139535536 17592186045443 true] [17592186513251 1070 #edb/ref 17592186045486 13194139535536 17592186045443 true] [17592186513251 1071 "![](images/c5/c5d4946b7a2c5953b4ce4c12dcf11273bed5e488e122b90f61dad802ffd81f7d.png)\n\nThe graph above shows $y=k({6}^{x})+c.$ Determine the values of $k$ and $c$ and find the equation of the curve." 13194139535536 17592186045443 true] [17592186513251 1072 #uuid "205d2e74-e2d5-5e18-a26f-6b9a011d134a" 13194139535536 17592186045443 true] [17592186513251 1074 "The horizontal asymptote of the curve $y=k({6}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=2.5,$ so $c=2.5.$\n\nTherefore, our function takes the form\n\n$$\ny=k({6}^{x})+2.5.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ Reading the calibrated grid, the marked point on the graph is $(0,6),$ so we substitute $x=0$ and $y=6$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({6}^{x})+2.5 \\\\ 6 & =k({6}^{0})+2.5 \\\\ 6 & =k(1)+2.5 \\\\ 6 & =k+2.5 \\\\ 3.5 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3.5({6}^{x})+2.5.$" 13194139535536 17592186045443 true] [17592186513252 1068 #edb/ref 17592186513257 13194139535536 17592186045443 true] [17592186513252 1070 #edb/ref 17592186045485 13194139535536 17592186045443 true] [17592186513252 1071 "![](images/32/3241259f78335a4b6589025e4f033ae92ab7ab82edec137e1dcb9531579fdc8a.png)\n\nThe graph above shows $y=k({2}^{x})+c.$ Find the value of $k$ and $c.$" 13194139535536 17592186045443 true] [17592186513252 1072 #uuid "233d6bb5-1ddb-5d78-a70c-c0bc5382721e" 13194139535536 17592186045443 true] [17592186513252 1074 "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-3,$ so $c=-3.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-3.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2),$ so we substitute $x=0$ and $y=2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-3 \\\\ 2 & =k({2}^{0})-3 \\\\ 2 & =k(1)-3 \\\\ 2 & =k-3 \\\\ 5 & =k\\end{aligned}\n$$\n\nTherefore, $k=5$ and $c=-3.$" 13194139535536 17592186045443 true] [17592186513253 1080 "y=2.5({4}^{x})-4" 13194139535536 17592186045443 true] [17592186513253 1082 #edb/ref 17592186045498 13194139535536 17592186045443 true] [17592186513253 1083 #uuid "25df17d6-139d-5491-8411-10a887f973ab" 13194139535536 17592186045443 true] [17592186513254 1080 "$k=0$ and $c=0$" 13194139535536 17592186045443 true] [17592186513254 1082 #edb/ref 17592186045499 13194139535536 17592186045443 true] [17592186513254 1083 #uuid "26cc6cb6-a1ce-5514-97f6-65b44f1416c1" 13194139535536 17592186045443 true] [17592186513255 1068 #edb/ref 17592186513312 13194139535536 17592186045443 true] [17592186513255 1070 #edb/ref 17592186045485 13194139535536 17592186045443 true] [17592186513255 1071 "![](images/87/87a7011de202f4e761be0684e15294fb736ebdf1bd284b4625d0475a2788b5b3.png)\n\nThe graph above shows $y=k({3}^{x})+c.$ Find the value of $k$ and $c.$" 13194139535536 17592186045443 true] [17592186513255 1072 #uuid "2b8005c7-3a74-5b35-a129-e65f3f4397cc" 13194139535536 17592186045443 true] [17592186513255 1074 "The horizontal asymptote of the curve $y=k({3}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-4,$ so $c=-4.$\n\nTherefore, our function takes the form\n\n$$\ny=k({3}^{x})-4.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,-2),$ so we substitute $x=0$ and $y=-2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({3}^{x})-4 \\\\ -2 & =k({3}^{0})-4 \\\\ -2 & =k(1)-4 \\\\ -2 & =k-4 \\\\ 2 & =k\\end{aligned}\n$$\n\nTherefore, $k=2$ and $c=-4.$" 13194139535536 17592186045443 true] [17592186513256 1068 #edb/ref 17592186513281 13194139535536 17592186045443 true] [17592186513256 1070 #edb/ref 17592186045486 13194139535536 17592186045443 true] [17592186513256 1071 "![](images/12/12b29bcde388b31bb0058dba21d728dbc058295e5d5fa1cf4468118918246b33.png)\n\nThe graph above shows $y=k({3}^{x})+c.$ Determine the values of $k$ and $c$ and find the equation of the curve." 13194139535536 17592186045443 true] [17592186513256 1072 #uuid "2d43ec8c-6bf0-5541-ae55-e7217a0478fa" 13194139535536 17592186045443 true] [17592186513256 1074 "The horizontal asymptote of the curve $y=k({3}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=0.75,$ so $c=0.75.$\n\nTherefore, our function takes the form\n\n$$\ny=k({3}^{x})+0.75.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ Reading the calibrated grid, the marked point on the graph is $(0,5),$ so we substitute $x=0$ and $y=5$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({3}^{x})+0.75 \\\\ 5 & =k({3}^{0})+0.75 \\\\ 5 & =k(1)+0.75 \\\\ 5 & =k+0.75 \\\\ 4.25 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=4.25({3}^{x})+0.75.$" 13194139535536 17592186045443 true] [17592186513257 1075 #edb/ref 17592186513277 13194139535536 17592186045443 true] [17592186513257 1075 #edb/ref 17592186513283 13194139535536 17592186045443 true] [17592186513257 1075 #edb/ref 17592186513292 13194139535536 17592186045443 true] [17592186513257 1075 #edb/ref 17592186513305 13194139535536 17592186045443 true] [17592186513257 1075 #edb/ref 17592186513306 13194139535536 17592186045443 true] [17592186513257 1076 #edb/ref 17592186045493 13194139535536 17592186045443 true] [17592186513257 1077 "selection" 13194139535536 17592186045443 true] [17592186513257 1078 #edb/ref 17592186513305 13194139535536 17592186045443 true] [17592186513257 107