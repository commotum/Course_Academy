/ident :question.difficulty/easy} :question/id #uuid "bc73c612-2a32-5b85-8989-8b463754a48c" :question/math-academy-id "q-108913" :question/problem "Which of the following equations is a Bernoulli differential equation?\n- **I.** ${y}^{′}+{x}^{-2}{y}^{3}=\\operatorname{sin}⁡y$\n- **II.** ${y}^{′}-{e}^{x}y={x}^{2}{y}^{5}$\n- **III.** ${y}^{′}+{y}^{4}\\operatorname{ln}⁡x=-x{y}^{3}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A Bernoulli differential equation has the form\n\n$$\n\\frac{dy}{dx}+p(x)y=q(x){y}^{n},\n$$\n\nwhere $n$ is a real number.\n\nWith that in mind, let's examine the given options.\n\n- Equation I is *not* a Bernoulli differential equation. It is missing both the $p(x)y$ and $q(x){y}^{n}$ terms.\n\n- Equation II is a Bernoulli differential equation. In this case, we have\n\n$$\np(x)=-{e}^{x},\\,q(x)={x}^{2},\\,n=5.\n$$\n\n- Equation III is *not* a Bernoulli differential equation. It is missing the $p(x)y$ term.\n\nTherefore, the correct answer is \"II only.\""} {:db/id 17592186244193 :knowledge-point/_questions [{:knowledge-point/id #uuid "eef27d2b-6149-5070-b711-f4dcc7db2a03" :knowledge-point/title "Identifying Bernoulli Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4188ff28-f5eb-597b-bef2-216186195b37" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461509} {:answer/id #uuid "8c7a7e04-5442-58d1-a701-5ba3498e1a2e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186461510}] :answer-field/correct {:answer/id #uuid "4188ff28-f5eb-597b-bef2-216186195b37" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461509} :answer-field/id #uuid "37ec752f-54aa-5e7c-9129-479813fba7dd" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186462508} {:answer-field/choices [{:answer/id #uuid "161adb6f-f3ba-5dde-82d7-642b483bc333" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461511} {:answer/id #uuid "e5f7c94e-4761-585a-a104-0f0a769debd8" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186461512}] :answer-field/correct {:answer/id #uuid "161adb6f-f3ba-5dde-82d7-642b483bc333" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461511} :answer-field/id #uuid "d2f3c6c8-b230-571d-b71c-668aa2d5950b" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186462509} {:answer-field/choices [{:answer/id #uuid "8e046b2a-ea43-5ad1-adc1-d3cb22c366ad" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461513} {:answer/id #uuid "09667041-9fbf-599c-8de4-f713a34ab018" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186461514}] :answer-field/correct {:answer/id #uuid "09667041-9fbf-599c-8de4-f713a34ab018" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186461514} :answer-field/id #uuid "072f6e88-7786-51e0-b297-e5c7e6409e73" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186462510}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e63ce1e7-0f23-5c8c-a5ed-4ae3fc1a265b" :question/math-academy-id "q-108914" :question/problem "Which of the following equations is a Bernoulli differential equation?\n- **I.** ${y}^{′}+\\sqrt{x}y={x}^{2}\\operatorname{ln}⁡y$\n- **II.** ${y}^{′}+{x}^{2}{y}^{2}=x{y}^{3}$\n- **III.** ${y}^{′}+{x}^{2}y=\\sqrt{\\frac{x}{y}}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A Bernoulli differential equation has the form\n\n$$\n\\frac{dy}{dx}+p(x)y=q(x){y}^{n},\n$$\n\nwhere $n$ is a real number.\n\nWith that in mind, let's examine the given options.\n\n- Equation I is *not* a Bernoulli differential equation. It is missing the $q(x){y}^{n}$ terms.\n\n- Equation II is *not* a Bernoulli differential equation. It is missing the $p(x)y$ term.\n\n- Equation III is a Bernoulli differential equation. In this case, we have\n\n$$\np(x)={x}^{2},\\,q(x)=\\sqrt{x},\\,n=-\\frac{1}{2}.\n$$\n\nTherefore, the correct answer is \"III only.\""} {:db/id 17592186244194 :knowledge-point/_questions [{:knowledge-point/id #uuid "eef27d2b-6149-5070-b711-f4dcc7db2a03" :knowledge-point/title "Identifying Bernoulli Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75270618-7af7-5381-9066-6d3469656acb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461515} {:answer/id #uuid "67390882-204b-5352-ad1e-ccec65f496a7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186461516}] :answer-field/correct {:answer/id #uuid "75270618-7af7-5381-9066-6d3469656acb" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461515} :answer-field/id #uuid "b208e569-82a8-5d09-9cd4-e626e88672d8" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186462511} {:answer-field/choices [{:answer/id #uuid "04b1fb51-971c-5aa9-804d-0ccdfcc7a696" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461517} {:answer/id #uuid "c7880ef3-333f-5868-b08a-8422f8cfd792" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186461518}] :answer-field/correct {:answer/id #uuid "04b1fb51-971c-5aa9-804d-0ccdfcc7a696" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461517} :answer-field/id #uuid "917fdd71-e52e-5156-b297-f58247d19d0f" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186462512} {:answer-field/choices [{:answer/id #uuid "5587940f-b2d2-50f4-8efe-1abc1acf4aab" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186461519} {:answer/id #uuid "41170317-0947-57dc-8