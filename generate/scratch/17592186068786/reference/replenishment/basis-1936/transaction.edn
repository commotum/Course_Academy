12-{y}^{4})}^{5}}\\,\\text{d}y & =4\\int \\frac{1}{{(12-{y}^{4})}^{5}}\\cdot {y}^{3}\\,\\text{d}y \\\\  & =4\\int \\frac{1}{{u}^{5}}\\cdot (-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{4}{4}\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-(-\\frac{1}{4{u}^{4}})+C \\\\  & =\\frac{1}{4{u}^{4}}+C \\\\  & =\\frac{1}{4{(12-{y}^{4})}^{4}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["8d111a2e-9476-57d5-8ade-195346a8bc68"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "e3862629-13a1-5e69-89a7-08fb717479fc" :question-generator/script "generate/scratch/17592186068786.py"} [:db/add 17592186068786 :knowledge-point/question-generator "generator"] {:db/id 17592186068786 :knowledge-point/questions ["99e025e4-1ea6-5d6e-812a-92d3fa45174a"]} [:db/ensure 17592186068786 :knowledge-point/validate]]
