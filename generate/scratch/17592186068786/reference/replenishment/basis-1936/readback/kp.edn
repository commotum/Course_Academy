}^{3}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259766 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "453def53-174d-5896-8e4f-7faa7466d05c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2{({x}^{2}+5)}^{8}}+C" :db/id #edb/ref 17592186257385} {:answer/id #uuid "98eb7e12-8b7e-5878-badc-a9f99309abb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258129} {:answer/id #uuid "a1b2fef7-0445-5ee0-9c9b-2663d3fb7feb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258199} {:answer/id #uuid "bdcefc88-d3ad-5c21-9ac6-75e0800e4041" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18{({x}^{2}+5)}^{8}}+C" :db/id #edb/ref 17592186258438} {:answer/id #uuid "dfeda5a9-a962-51e6-b8b1-1e93608cc2ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258733}] :answer-field/correct {:answer/id #uuid "dfeda5a9-a962-51e6-b8b1-1e93608cc2ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18{({x}^{2}+5)}^{9}}+C" :db/id #edb/ref 17592186258733} :answer-field/id #uuid "0d7f8515-44cd-5765-b9d4-3675220879f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d839b9a-ccae-57dc-9109-2e848ce0d27f" :question/math-academy-id "q-12502" :question/problem "Calculate $\\int \\frac{x}{{({x}^{2}+5)}^{10}}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+5.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{x}{{({x}^{2}+5)}^{10}}\\,\\text{d}x & =\\int \\frac{1}{{({x}^{2}+5)}^{10}}\\cdot x\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{10}}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{{u}^{10}}\\,\\text{d}u \\\\  & =\\frac{1}{2}(-\\frac{1}{9{u}^{9}})+C \\\\  & =-\\frac{1}{18{u}^{9}}+C \\\\  & =-\\frac{1}{18({x}^{2}+5)^{9}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332742 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a74f7a5-d13b-5625-8685-33bf17f81ed3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330180} {:answer/id #uuid "20943720-048e-50c7-805b-b14bda47d8c2" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330229} {:answer/id #uuid "6988d942-8c13-5520-b8de-e15f8996b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330896} {:answer/id #uuid "99cbcdb1-7b43-5aa9-9f23-79ca0088debf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{s}^{4}+1}+C" :db/id #edb/ref 17592186331329} {:answer/id #uuid "9adc4166-7d1a-5d72-a022-77854432da9a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{{s}^{4}+1}+C" :db/id #edb/ref 17592186331341}] :answer-field/correct {:answer/id #uuid "6988d942-8c13-5520-b8de-e15f8996b5c2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{{s}^{5}+1}+C" :db/id #edb/ref 17592186330896} :answer-field/id #uuid "545dd268-f619-59e2-a48a-b0dec0dece4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332359}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ab8a443f-9ff6-5aa0-97a4-a9045bf8e902" :question/math-academy-id "q-49560" :question/problem "Calculate $\\int \\frac{10{s}^{4}}{\\sqrt{{s}^{5}+1}}\\,\\text{d}s.$" :question/worked-solution "Let $u={s}^{5}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}s}=5{s}^{4}\\,⟹\\,\\frac{1}{5}\\text{d}u={s}^{4}\\,\\text{d}s,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{s}^{4}}{\\sqrt{{s}^{5}+1}}\\,\\text{d}s & =10\\int \\frac{1}{\\sqrt{{s}^{5}+1}}\\cdot {s}^{4}\\,\\text{d}s \\\\  & =10\\int \\frac{1}{\\sqrt{u}}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{10}{5}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =2\\cdot (2\\sqrt{u})+C \\\\  & =4\\sqrt{u}+C \\\\  & =4\\sqrt{{s}^{5}+1}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332743 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a0b1ce-6161-5e73-b36b-31d37e3b0b40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330112} {:answer/id #uuid "279bd955-25ed-5deb-9e91-1b260848ad7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330302} {:answer/id #uuid "4482d3ef-e1bd-52a2-968c-377e9def4806" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330566} {:answer/id #uuid "95ddf6e6-b070-55fd-b7d5-d3c0133dcc47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(1-{y}^{4})}^{5}}+C" :db/id #edb/ref 17592186331280} {:answer/id #uuid "b12013db-5592-5de5-ac15-a7f940470213" :answer/type {:db/ident :answer.type/math} :answer/value "{(1-{y}^{4})}^{5}+C" :db/id #edb/ref 17592186331516}] :answer-field/correct {:answer/id #uuid "13a0b1ce-6161-5e73-b36b-31d37e3b0b40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(1-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186330112} :answer-field/id #uuid "8d27f773-d358-573a-9ebd-6ee1d5a4748e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "052c4300-130d-5380-bb49-cade415fdcf7" :question/math-academy-id "q-49561" :question/problem "Calculate $\\int \\frac{4{y}^{3}}{{(1-{y}^{4})}^{5}}\\,\\text{d}y.$" :question/worked-solution "Let $u=1-{y}^{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=-4{y}^{3}\\,⟹\\,(-\\frac{1}{4})\\text{d}u={y}^{3}\\,\\text{d}y,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4{y}^{3}}{{(1-{y}^{4})}^{5}}\\,\\text{d}y & =4\\int \\frac{1}{{(1-{y}^{4})}^{5}}\\cdot {y}^{3}\\,\\text{d}y \\\\  & =4\\int \\frac{1}{{u}^{5}}\\cdot (-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{4}{4}\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-(-\\frac{1}{4{u}^{4}})+C \\\\  & =\\frac{1}{4{u}^{4}}+C \\\\  & =\\frac{1}{4{(1-{y}^{4})}^{4}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332747 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "088243d9-1f83-5d73-9676-61898c216f3a" :answer/type {:db/ident :answer.type/math} :answer/value "{(9-{x}^{2})}^{4}+C" :db/id #edb/ref 17592186330023} {:answer/id #uuid "19751e43-a723-581f-94f1-b9c5b12f13c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{(9-{x}^{2})}^{3}}+C" :db/id #edb/ref 17592186330169} {:answer/id #uuid "2ad52c65-7a01-580d-80a2-76c6aec15062" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8{(9-{x}^{2})}^{4}}+C" :db/id #edb/ref 17592186330330} {:answer/id #uui