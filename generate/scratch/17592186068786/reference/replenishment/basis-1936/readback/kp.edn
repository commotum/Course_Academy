\int \\frac{1}{\\sqrt{2-{x}^{6}}}\\cdot {x}^{5}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{1}{6})\\text{d}u \\\\  & =-\\frac{1}{6}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{1}{6}(2\\sqrt{u})+C \\\\  & =-\\frac{1}{3}\\sqrt{u}+C \\\\  & =-\\frac{1}{3}\\sqrt{2-{x}^{6}}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485707 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c21e6-de9d-58d9-9a51-d7f5069b72df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485704} {:answer/id #uuid "1674cd48-0238-5567-836c-df6a45c0436b" :answer/type {:db/ident :answer.type/math} :answer/value "{(12-{y}^{4})}^{5}+C" :db/id #edb/ref 17592186485705} {:answer/id #uuid "9fe2a835-68c8-5b9a-9bea-b3b00e73e23e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(12-{y}^{4})}^{5}}+C" :db/id #edb/ref 17592186485708} {:answer/id #uuid "daead01d-e38c-5120-9297-889531d9d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485709} {:answer/id #uuid "e895667b-20b9-5b21-8522-ef6dc6c60417" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485710}] :answer-field/correct {:answer/id #uuid "daead01d-e38c-5120-9297-889531d9d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{(12-{y}^{4})}^{4}}+C" :db/id #edb/ref 17592186485709} :answer-field/id #uuid "8d111a2e-9476-57d5-8ade-195346a8bc68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485706}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99e025e4-1ea6-5d6e-812a-92d3fa45174a" :question/problem "Calculate $\\int \\frac{4{y}^{3}}{{(12-{y}^{4})}^{5}}\\,\\text{d}y.$" :question/worked-solution "Let $u=12-{y}^{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=-4{y}^{3}\\,⟹\\,(-\\frac{1}{4})\\text{d}u={y}^{3}\\,\\text{d}y,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4{y}^{3}}{{(12-{y}^{4})}^{5}}\\,\\text{d}y & =4\\int \\frac{1}{{(12-{y}^{4})}^{5}}\\cdot {y}^{3}\\,\\text{d}y \\\\  & =4\\int \\frac{1}{{u}^{5}}\\cdot (-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{4}{4}\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-\\int \\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =-(-\\frac{1}{4{u}^{4}})+C \\\\  & =\\frac{1}{4{u}^{4}}+C \\\\  & =\\frac{1}{4{(12-{y}^{4})}^{4}}+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Other Fractional Expressions"}]}
