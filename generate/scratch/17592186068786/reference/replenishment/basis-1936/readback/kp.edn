#{[{:db/id #edb/ref 17592186068786 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068628 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/id #uuid "0461f8ba-c3c5-5e22-a679-32ee4f2a01b8" :question/math-academy-id "e-6149" :question/problem "$\\displaystyle \\int \\dfrac{x^2}{\\sqrt{1-x^3}} \\, \\textrm{d}x=$" :question/worked-solution "Let $u = 1 - x^3.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3x^2 \\quad \\Longrightarrow\\quad -\\dfrac{1}{3} \\textrm d u= x^2 \\, \\textrm d x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}}{\\sqrt{1-{x}^{3}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{3}}}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\cdot (-\\frac{1}{3})\\text{d}u \\\\  & =-\\frac{1}{3}\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =-\\frac{1}{3}(2\\sqrt{u})+C \\\\  & =-\\frac{2}{3}\\sqrt{u}+C \\\\  & =-\\frac{2}{3}\\sqrt{1-{x}^{3}}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/question-generator {:db/id #edb/ref 17592186485711 :question-generator/id #uuid "e3862629-13a1-5e69-89a7-08fb717479fc" :question-generator/script "generate/scratch/17592186068786.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186069174 :knowledge-point/_questions [{:knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11177df5-0483-5972-bcaf-9017710da256" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x}}{\\sqrt{{x}^{3}+7}}+C" :db/id #edb/ref 17592186288159} {:answer/id #uuid "9705b997-814b-59ba-9086-20d3695fb1fa" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{{x}^{3}+7}+C" :db/id #edb/ref 17592186289042} {:an