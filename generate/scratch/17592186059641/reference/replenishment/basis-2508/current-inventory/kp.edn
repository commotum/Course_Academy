b/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340151} {:answer/id #uuid "9e08cb06-fa94-559a-b45f-0247593ae993" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340553} {:answer/id #uuid "ce427bad-7fbf-553d-94e7-4eac1f2a458e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340960} {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} {:answer/id #uuid "ddb559b7-bf25-5a4d-8461-b1784d7b4dd7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341097}] :answer-field/correct {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} :answer-field/id #uuid "7c77d87a-34f1-5f64-8f04-06a22766d6be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341597}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5b1e203a-fce6-56f0-bd3a-5a969f3f611d" :question/math-academy-id "q-72711" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x.$" :question/worked-solution "First, we factor the expression:\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x) & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x.\n$$"} {:db/id #edb/ref 17592186529511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "069ee00b-3b81-58c4-aafb-ac5df45dfb47" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{5}{\\alpha}+2\\sin^{3}{\\alpha}\\cos^{2}{\\alpha}-3\\cos^{3}{\\alpha}" :db/id #edb/ref 17592186529506} {:answer/id #uuid "51102831-0b52-55ff-b106-4f8f5c60f7ac" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{3}{\\alpha}-3\\sin^{2}{\\alpha}\\cos^{3}{\\alpha}+3\\cos^{5}{\\alpha}" :db/id #edb/ref 17592186529519} {:answer/id #uuid "5a5efeaa-0ca8-5791-b00d-02a60878f45e" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{3}{\\alpha}+3\\cos^{3}{\\alpha}" :db/id #edb/ref 17592186529521} {:answer/id #uuid "64c082c2-46d7-5e51-9b9b-d650e53fbdc8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sin^{3}{\\alpha}-3\\cos^{3}{\\alpha}" :db/id #edb/ref 17592186529523} {:answer/id #uuid "9eb047a5-68f0-571b-8dca-deb7ceb9c09b" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{3}{\\alpha}-3\\cos^{3}{\\alpha}" :db/id #edb/ref 17592186529540}] :answer-field/correct {:answer/id #uuid "9eb047a5-68f0-571b-8dca-deb7ceb9c09b" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{3}{\\alpha}-3\\cos^{3}{\\alpha}" :db/id #edb/ref 17592186529540} :answer-field/id #uuid "4dbc1be4-16b4-5e63-b06b-5cdf8c3a1d61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529518}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "29ebbec7-da39-54fd-9ec6-bb153c034c9f" :question/problem "Simplify the trigonometric expression $-2\\sin^{5}{\\alpha}-2\\sin^{3}{\\alpha}\\cos^{2}{\\alpha}-3\\sin^{2}{\\alpha}\\cos^{3}{\\alpha}-3\\cos^{5}{\\alpha}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-2\\sin^{5}{\\alpha}-2\\sin^{3}{\\alpha}\\cos^{2}{\\alpha}-3\\sin^{2}{\\alpha}\\cos^{3}{\\alpha}-3\\cos^{5}{\\alpha}=-2\\sin^{3}{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha})-3\\cos^{3}{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha})\n$$\n\nThen, we use $\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-2\\sin^{3}{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha})-3\\cos^{3}{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha}) & =-2\\sin^{3}{\\alpha}\\cdot 1-3\\cos^{3}{\\alpha}\\cdot 1 \\\\  & =-2\\sin^{3}{\\alpha}-3\\cos^{3}{\\alpha}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-2\\sin^{5}{\\alpha}-2\\sin^{3}{\\alpha}\\cos^{2}{\\alpha}-3\\sin^{2}{\\alpha}\\cos^{3}{\\alpha}-3\\cos^{5}{\\alpha}=-2\\sin^{3}{\\alpha}-3\\cos^{3}{\\alpha}.\n$$"} {:db/id #edb/ref 17592186529517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "738330c4-4d5f-5eae-af1b-cfe8981008bb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{2}{t}\\cos{t}" :db/id #edb/ref 17592186529527} {:answer/id #uuid "754e1324-3526-51e4-9e76-7b633e24a760" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin^{2}{t}\\cos{t}" :db/id #edb/ref 17592186529530} {:answer/id #uuid "e42b7626-cf9c-5708-808c-87b2f0d03244" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin^{4}{t}\\cos{t}-4\\sin^{2}{t}\\cos^{3}{t}+4\\sin^{2}{t}\\cos{t}" :db/id #edb/ref 17592186529560} {:answer/id #uuid "e824f10c-2194-513f-808f-7584d79a36f2" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\sin^{2}{t}\\cos{t}" :db/id #edb/ref 17592186529561} {:answer/id #uuid "edca931a-8d40-5dac-a2c2-71e8b97da970" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin^{4}{t}\\cos{t}+4\\sin^{2}{t}\\cos^{3}{t}" :db/id #edb/ref 17592186529564}] :answer-field/correct {:answer/id #uuid "754e1324-3526-51e4-9e76-7b633e24a760" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin^{2}{t}\\cos{t}" :db/id #edb/ref 17592186529530} :answer-field/id #uuid "ea1a3208-3527-517f-9448-8fb7c165c3ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529562}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3ef681b0-cd16-5bbb-b438-cfbaed372727" :question/problem "Simplify the trigonometric expression $-4\\sin^{4}{t}\\cos{t}-4\\sin^{2}{t}\\cos^{3}{t}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-4\\sin^{4}{t}\\cos{t}-4\\sin^{2}{t}\\cos^{3}{t}=-4\\sin^{2}{t}\\cos{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})\n$$\n\nThen, we use $\\sin^{2}{t}+\\cos^{2}{t}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-4\\sin^{2}{t}\\cos{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t}) & =-4\\sin^{2}{t}\\cos{t}\\cdot 1 \\\\  & =-4\\sin^{2}{t}\\cos{t}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-4\\sin^{4}{t}\\cos{t}-4\\sin^{2}{t}\\cos^{3}{t}=-4\\sin^{2}{t}\\cos{t}.\n$$"} {:db/id #edb/ref 17592186529524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f156bf3-af81-5a0c-a396-3e3dcc0324cc" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin^{2}{t}\\cos{t}-2\\sin{t}+4\\cos^{3}{t}" :db/id #edb/ref 17592186529532} {:answer/id #uuid "9b2a99ad-92c9-50d3-980a-50d186cbe56d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin{t}-4\\cos{t}" :db/id #edb/ref 17592186529538} {:answer/id #uuid "9dc03acc-2ed8-58cc-8dd3-6760fa6f614a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin{t}+4\\cos{t}" :db/id #edb/ref 17592186529539} {:answer/id #uuid "b85c58fb-5b54-595e-87fa-012036fb6449" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{3}{t}+2\\sin{t}\\cos^{2}{t}-4\\cos{t}" :db/id #edb/ref 17592186529547} {:answer/id #uuid "d3f5d711-b02f-5f08-9f78-9612e39f0e89" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sin{t}-4\\cos{t}" :db/id #edb/ref 17592186529556}] :answer-field/correct {:answer/id #uuid "9b2a99ad-92c9-50d3-980a-50d186cbe56d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin{t}-4\\cos{t}" :db/id #edb/ref 17592186529538} :answer-field/id #uuid "1276cdc8-bd2f-5e34-80bb-98558c45f158" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529508}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "666f27f4-2d09-51ff-853c-bd215719ca71" :question/problem "Simplify the trigonometric expression $-2\\sin^{3}{t}-2\\sin{t}\\cos^{2}{t}-4\\sin^{2}{t}\\cos{t}-4\\cos^{3}{t}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-2\\sin^{3}{t}-2\\sin{t}\\cos^{2}{t}-4\\sin^{2}{t}\\cos{t}-4\\cos^{3}{t}=-2\\sin{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})-4\\cos{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})\n$$\n\nThen, we use $\\sin^{2}{t}+\\cos^{2}{t}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-2\\sin{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})-4\\cos{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t}) & =-2\\sin{t}\\cdot 1-4\\cos{t}\\cdot 1 \\\\  & =-2\\sin{t}-4\\cos{t}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-2\\sin^{3}{t}-2\\sin{t}\\cos^{2}{t}-4\\sin^{2}{t}\\cos{t}-4\\cos^{3}{t}=-2\\sin{t}-4\\cos{t}.\n$$"} {:db/id #edb/ref 17592186529544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d14dc8e-650b-568c-82d8-d520e06017ab" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{3}{\\theta}+4\\cos^{3}{\\theta}" :db/id #edb/ref 17592186529513} {:answer/id #uuid "3a0f6e5c-5dfc-5e25-bc4a-f5fc6b08a33f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{3}{\\theta}-4\\cos^{3}{\\theta}" :db/id #edb/ref 17592186529516} {:answer/id #uuid "7449ad0e-dd5c-5706-b13e-50b17a28a093" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin^{3}{\\theta}-4\\cos^{3}{\\theta}" :db/id #edb/ref 17592186529529} {:answer/id #uuid "8138a85f-31a1-5dc5-97e8-a820e0ba2ab3" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{5}{\\theta}-4\\sin^{3}{\\theta}\\cos^{2}{\\theta}-4\\cos^{3}{\\theta}" :db/id #edb/ref 17592186529533} {:answer/id #uuid "bc9c46a6-8042-55b2-a60d-de357655dd0f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{3}{\\theta}-4\\sin^{2}{\\theta}\\cos^{3}{\\theta}+4\\cos^{5}{\\theta}" :db/id #edb/ref 17592186529548}] :answer-field/correct {:answer/id #uuid "3a0f6e5c-5dfc-5e25-bc4a-f5fc6b08a33f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{3}{\\theta}-4\\cos^{3}{\\theta}" :db/id #edb/ref 17592186529516} :answer-field/id #uuid "56825817-31fb-5f1f-933e-bf1b55452dbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529520}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "afc41550-d29f-55c2-b1f4-ab3e1639ac16" :question/problem "Simplify the trigonometric expression $4\\sin^{5}{\\theta}+4\\sin^{3}{\\theta}\\cos^{2}{\\theta}-4\\sin^{2}{\\theta}\\cos^{3}{\\theta}-4\\cos^{5}{\\theta}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n4\\sin^{5}{\\theta}+4\\sin^{3}{\\theta}\\cos^{2}{\\theta}-4\\sin^{2}{\\theta}\\cos^{3}{\\theta}-4\\cos^{5}{\\theta}=4\\sin^{3}{\\theta}\\cdot(\\sin^{2}{\\theta}+\\cos^{2}{\\theta})-4\\cos^{3}{\\theta}\\cdot(\\sin^{2}{\\theta}+\\cos^{2}{\\theta})\n$$\n\nThen, we use $\\sin^{2}{\\theta}+\\cos^{2}{\\theta}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}4\\sin^{3}{\\theta}\\cdot(\\sin^{2}{\\theta}+\\cos^{2}{\\theta})-4\\cos^{3}{\\theta}\\cdot(\\sin^{2}{\\theta}+\\cos^{2}{\\theta}) & =4\\sin^{3}{\\theta}\\cdot 1-4\\cos^{3}{\\theta}\\cdot 1 \\\\  & =4\\sin^{3}{\\theta}-4\\cos^{3}{\\theta}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n4\\sin^{5}{\\theta}+4\\sin^{3}{\\theta}\\cos^{2}{\\theta}-4\\sin^{2}{\\theta}\\cos^{3}{\\theta}-4\\cos^{5}{\\theta}=4\\sin^{3}{\\theta}-4\\cos^{3}{\\theta}.\n$$"} {:db/id #edb/ref 17592186529545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0647a842-c5bf-5f27-91f8-c209676e7bd8" :answer/type {:db/ident :answer.type/math} :answer/value "-10\\sin^{2}{\\alpha}" :db/id #edb/ref 17592186529505} {:answer/id #uuid "0dfef94f-a919-5a95-8993-7807c69b6906" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin^{2}{\\alpha}" :db/id #edb/ref 17592186529507} {:answer/id #uuid "8cc356bc-62ee-5a9a-a462-a57bfa02a4fd" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin^{4}{\\alpha}-5\\sin^{2}{\\alpha}\\cos^{2}{\\alpha}+5\\sin^{2}{\\alpha}" :db/id #edb/ref 17592186529536} {:answer/id #uuid "c1d87336-ff8a-5303-a940-8b38ad7c2981" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin^{4}{\\alpha}+5\\sin^{2}{\\alpha}\\cos^{2}{\\alpha}" :db/id #edb/ref 17592186529550} {:answer/id #uuid "faed4766-af3a-5cde-b514-f35ca89e776e" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sin^{2}{\\alpha}" :db/id #edb/ref 17592186529567}] :answer-field/correct {:answer/id #uuid "0dfef94f-a919-5a95-8993-7807c69b6906" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin^{2}{\\alpha}" :db/id #edb/ref 17592186529507} :answer-field/id #uuid "2a10a8ad-69b6-5d7d-9515-683ae175b563" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529512}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b1aa7d9e-7196-5074-ab5d-16a877939f5e" :question/problem "Simplify the trigonometric expression $-5\\sin^{4}{\\alpha}-5\\sin^{2}{\\alpha}\\cos^{2}{\\alpha}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-5\\sin^{4}{\\alpha}-5\\sin^{2}{\\alpha}\\cos^{2}{\\alpha}=-5\\sin^{2}{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha})\n$$\n\nThen, we use $\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-5\\sin^{2}{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha}) & =-5\\sin^{2}{\\alpha}\\cdot 1 \\\\  & =-5\\sin^{2}{\\alpha}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-5\\sin^{4}{\\alpha}-5\\sin^{2}{\\alpha}\\cos^{2}{\\alpha}=-5\\sin^{2}{\\alpha}.\n$$"} {:db/id #edb/ref 17592186529551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c78ccff-14c6-5533-a289-eda1b3b30f84" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin^{3}{\\alpha}+2\\sin{\\alpha}\\cos^{2}{\\alpha}+3\\sin{\\alpha}" :db/id #edb/ref 17592186529522} {:answer/id #uuid "a2018f64-c3c7-5855-ac38-6e2dcc99f0bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin{\\alpha}" :db/id #edb/ref 17592186529541} {:answer/id #uuid "b58c94b3-3a3e-5ff8-9a20-f66306bd7d53" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin{\\alpha}" :db/id #edb/ref 17592186529546} {:answer/id #uuid "cd7da2bd-f680-5a24-a57a-44c806b2fb6c" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sin{\\alpha}" :db/id #edb/ref 17592186529554} {:answer/id #uuid "d407429a-0cb9-5745-b7bc-92adb65c01f0" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin{\\alpha}" :db/id #edb/ref 17592186529557}] :answer-field/correct {:answer/id #uuid "a2018f64-c3c7-5855-ac38-6e2dcc99f0bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin{\\alpha}" :db/id #edb/ref 17592186529541} :answer-field/id #uuid "18153b49-2b8d-5c4d-815e-e3f4cea22382" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529510}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c2187ae7-da6a-5733-bb0f-46f543060cc9" :question/problem "Simplify the trigonometric expression $-2\\sin^{3}{\\alpha}-2\\sin{\\alpha}\\cos^{2}{\\alpha}+3\\sin{\\alpha}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-2\\sin^{3}{\\alpha}-2\\sin{\\alpha}\\cos^{2}{\\alpha}+3\\sin{\\alpha}=-2\\sin{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha})+3\\sin{\\alpha}\n$$\n\nThen, we use $\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-2\\sin{\\alpha}\\cdot(\\sin^{2}{\\alpha}+\\cos^{2}{\\alpha})+3\\sin{\\alpha} & =-2\\sin{\\alpha}\\cdot 1+3\\sin{\\alpha} \\\\  & =-2\\sin{\\alpha}+3\\sin{\\alpha} \\\\  & =\\sin{\\alpha}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-2\\sin^{3}{\\alpha}-2\\sin{\\alpha}\\cos^{2}{\\alpha}+3\\sin{\\alpha}=\\sin{\\alpha}.\n$$"} {:db/id #edb/ref 17592186529552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e6fa6d8-14f9-5d7e-bc0a-c0ac762d492d" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{5}{t}+3\\sin^{3}{t}\\cos^{2}{t}+4\\cos{t}" :db/id #edb/ref 17592186529531} {:answer/id #uuid "9b2645af-aa72-5f2a-96a8-a02b386cf848" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}-4\\cos{t}" :db/id #edb/ref 17592186529537} {:answer/id #uuid "a9bff1c3-a55f-505a-b6af-8f936dcf6336" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sin^{3}{t}+4\\cos{t}" :db/id #edb/ref 17592186529543} {:answer/id #uuid "c71f33ed-a6c3-50f4-af95-943149e25f59" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}+4\\cos{t}" :db/id #edb/ref 17592186529553} {:answer/id #uuid "f0f110f6-d11f-507e-ba9c-4ea58e00874b" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}+4\\sin^{2}{t}\\cos{t}-4\\cos^{3}{t}" :db/id #edb/ref 17592186529565}] :answer-field/correct {:answer/id #uuid "c71f33ed-a6c3-50f4-af95-943149e25f59" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}+4\\cos{t}" :db/id #edb/ref 17592186529553} :answer-field/id #uuid "8bd67cb8-bc44-58c2-8091-8061dd78ff1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529534}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c643a2d3-8e99-523f-874d-9db3749f9951" :question/problem "Simplify the trigonometric expression $-3\\sin^{5}{t}-3\\sin^{3}{t}\\cos^{2}{t}+4\\sin^{2}{t}\\cos{t}+4\\cos^{3}{t}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-3\\sin^{5}{t}-3\\sin^{3}{t}\\cos^{2}{t}+4\\sin^{2}{t}\\cos{t}+4\\cos^{3}{t}=-3\\sin^{3}{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})+4\\cos{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})\n$$\n\nThen, we use $\\sin^{2}{t}+\\cos^{2}{t}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-3\\sin^{3}{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})+4\\cos{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t}) & =-3\\sin^{3}{t}\\cdot 1+4\\cos{t}\\cdot 1 \\\\  & =-3\\sin^{3}{t}+4\\cos{t}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-3\\sin^{5}{t}-3\\sin^{3}{t}\\cos^{2}{t}+4\\sin^{2}{t}\\cos{t}+4\\cos^{3}{t}=-3\\sin^{3}{t}+4\\cos{t}.\n$$"} {:db/id #edb/ref 17592186529559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13bd1fc4-9eaf-52c2-b404-e2308f82f256" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{3}{x}\\cos^{2}{x}-4\\sin{x}\\cos^{4}{x}" :db/id #edb/ref 17592186529509} {:answer/id #uuid "7407f81c-8088-5b0b-8bd9-2949a317d2d2" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sin{x}\\cos^{2}{x}" :db/id #edb/ref 17592186529528} {:answer/id #uuid "8c4d40ec-19ee-53ed-bcce-79179d290ad1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin^{3}{x}\\cos^{2}{x}+4\\sin{x}\\cos^{4}{x}-4\\sin{x}\\cos^{2}{x}" :db/id #edb/ref 17592186529535} {:answer/id #uuid "bca9221d-f021-54c0-9080-6c3992d70ff2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin{x}\\cos^{2}{x}" :db/id #edb/ref 17592186529549} {:answer/id #uuid "f5a80062-0511-5a71-bc83-b69845acfec0" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sin{x}\\cos^{2}{x}" :db/id #edb/ref 17592186529566}] :answer-field/correct {:answer/id #uuid "bca9221d-f021-54c0-9080-6c3992d70ff2" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sin{x}\\cos^{2}{x}" :db/id #edb/ref 17592186529549} :answer-field/id #uuid "ce0cec1e-bfc8-5d38-922f-fa5962556cb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529555}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "de4cfc2b-1f6d-5e13-8785-7726c5e967ba" :question/problem "Simplify the trigonometric expression $4\\sin^{3}{x}\\cos^{2}{x}+4\\sin{x}\\cos^{4}{x}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n4\\sin^{3}{x}\\cos^{2}{x}+4\\sin{x}\\cos^{4}{x}=4\\sin{x}\\cos^{2}{x}\\cdot(\\sin^{2}{x}+\\cos^{2}{x})\n$$\n\nThen, we use $\\sin^{2}{x}+\\cos^{2}{x}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}4\\sin{x}\\cos^{2}{x}\\cdot(\\sin^{2}{x}+\\cos^{2}{x}) & =4\\sin{x}\\cos^{2}{x}\\cdot 1 \\\\  & =4\\sin{x}\\cos^{2}{x}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n4\\sin^{3}{x}\\cos^{2}{x}+4\\sin{x}\\cos^{4}{x}=4\\sin{x}\\cos^{2}{x}.\n$$"} {:db/id #edb/ref 17592186529563 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "373cf1e1-2e2f-53ec-926d-b29631075e7e" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}+\\cos^{3}{t}" :db/id #edb/ref 17592186529514} {:answer/id #uuid "38170470-3470-577b-aa1d-2853d7b41017" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sin^{3}{t}-\\cos^{3}{t}" :db/id #edb/ref 17592186529515} {:answer/id #uuid "67ee417b-1209-5fd5-95e9-de28b4ecb9f8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}-\\cos^{3}{t}" :db/id #edb/ref 17592186529525} {:answer/id #uuid "a279eb83-355b-52c7-8909-482da57bef22" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{5}{t}+3\\sin^{3}{t}\\cos^{2}{t}-\\cos^{3}{t}" :db/id #edb/ref 17592186529542} {:answer/id #uuid "d895177c-6aa9-517e-a66e-17e8de422018" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}-\\sin^{2}{t}\\cos^{3}{t}+\\cos^{5}{t}" :db/id #edb/ref 17592186529558}] :answer-field/correct {:answer/id #uuid "67ee417b-1209-5fd5-95e9-de28b4ecb9f8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sin^{3}{t}-\\cos^{3}{t}" :db/id #edb/ref 17592186529525} :answer-field/id #uuid "710c80ef-9c4c-5aef-9254-157853bfdaac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186529526}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "edb7022c-1785-5002-946d-38c55cec59ac" :question/problem "Simplify the trigonometric expression $-3\\sin^{5}{t}-3\\sin^{3}{t}\\cos^{2}{t}-\\sin^{2}{t}\\cos^{3}{t}-\\cos^{5}{t}.$" :question/worked-solution "First, we factor the expression:\n\n$$\n-3\\sin^{5}{t}-3\\sin^{3}{t}\\cos^{2}{t}-\\sin^{2}{t}\\cos^{3}{t}-\\cos^{5}{t}=-3\\sin^{3}{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})-\\cos^{3}{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})\n$$\n\nThen, we use $\\sin^{2}{t}+\\cos^{2}{t}=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}-3\\sin^{3}{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t})-\\cos^{3}{t}\\cdot(\\sin^{2}{t}+\\cos^{2}{t}) & =-3\\sin^{3}{t}\\cdot 1-\\cos^{3}{t}\\cdot 1 \\\\  & =-3\\sin^{3}{t}-\\cos^{3}{t}\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n-3\\sin^{5}{t}-3\\sin^{3}{t}\\cos^{2}{t}-\\sin^{2}{t}\\cos^{3}{t}-\\cos^{5}{t}=-3\\sin^{3}{t}-\\cos^{3}{t}.\n$$"}] :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}]}
