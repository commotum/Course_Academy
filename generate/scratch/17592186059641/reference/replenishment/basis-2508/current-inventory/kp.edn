#{[{:db/id #edb/ref 17592186059641 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059469 :question/id #uuid "762e323d-62be-5cd0-ad06-7b11af56fe3f" :question/math-academy-id "e-3136" :question/problem "Simplify the trigonometric expression $\\sin^4{\\theta}+\\sin^2{\\theta}\\cos^2{\\theta}.$" :question/worked-solution "First, we factor $\\sin^2\\theta$ from the expression:\n\n$$\n\\sin^4{\\theta}+\\sin^2{\\theta}\\cos^2{\\theta} = \\sin^2{\\theta}\\cdot(\\sin^2{\\theta}+\\cos^2{\\theta})\n$$\n\nThen, we use $\\cos^2\\theta + \\sin^2\\theta = 1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}) & ={sin}^{2}⁡\\theta \\cdot 1={sin}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin^4{\\theta}+\\sin^2{\\theta}\\cos^2{\\theta} = \\sin^2\\theta.\n$$"} :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051017 :topic/math-academy-id 353 :topic/title "Factoring Polynomials Using GCFs"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186529568 :question-generator/id #uuid "19632d39-ed0e-50ea-ad48-e1f2b7b4b3ac" :question-generator/script "generate/scratch/17592186059641.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d69d271a-f3c8-56b0-b7dc-fa6812034519" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos θ" :db/id #edb/ref 17592186058687} {:answer/id #uuid "dbb0c832-08fd-5312-b076-070a25b4c05e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cos θ" :db/id #edb/ref 17592186058688} {:answer/id #uuid "dc885703-f19c-55bc-ad37-2bc6f538bea0" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cos^{2} θ" :db/id #edb/ref 17592186058689} {:answer/id #uuid "2f36f807-8f0d-5398-8106-de28bd21a7c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos^{2} θ" :db/id #e