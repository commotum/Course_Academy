[{"label": "probe", "record": {"knowledge_point": {"id": "b4ac7f7e-1e07-57d7-a82a-d6545588c2de", "db_id": 17592186092264, "title": "Differentiating a Natural Logarithm Function Using the Chain Rule"}, "question": {":question/id": "c02dab17-b62c-59db-93cb-2bb883e1c9b7", ":question/problem": "Given that $f(x)=\\ln(- 5 x^{6} + 3)$, find $\\frac{\\text{d}f}{\\text{d}x}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}", ":question/worked-solution": "First, we express $f(x)$ as the composite function\n\n$$\nf=\\ln u,\\,u=- 5 x^{6} + 3.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=- 30 x^{5}.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ &=\\frac{1}{u}\\cdot (- 30 x^{5}) \\\\ &=\\frac{1}{- 5 x^{6} + 3}\\cdot (- 30 x^{5}) \\\\ &=\\frac{- 30 x^{5}}{- 5 x^{6} + 3}.\\end{aligned}\n$$", ":question/difficulty": ":question.difficulty/moderate", ":question/answer-fields": [{":answer-field/id": "503ac368-8a4e-5f91-a718-5998133aa097", ":answer-field/key": "field-1", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "3ec8a5e6-61b0-5052-8139-d9b1c7888dbe", ":answer/type": ":answer.type/math", ":answer/value": "\\frac{30 x^{5}}{5 x^{6} - 3}"}], ":answer-field/correct": [":answer/id", "3ec8a5e6-61b0-5052-8139-d9b1c7888dbe"]}]}, "generation": {"generator_id": "f4aeeb80-4a3e-5dc6-ba00-a4d66431dbe1", "version": "ln-chain-private-2275-v1", "source_basis": 2275, "source_id": "q-341676", "template": "polynomial-blank", "difficulty": "moderate", "parameters": {"a": 3, "b": 5, "n": 6}, "bank_profile": null, "seed": 0, "mathematical_key": "5f8f6c412a31de52c9305ee6d57be3e066fc9bd3d08f02425e14a33047ea7fad", "domain": "Interval.open(-3**(1/6)*5**(5/6)/5, 3**(1/6)*5**(5/6)/5)", "dependencies": {"sympy": "1.14.0"}, "authored_changes": [], "eligible": true, "math_format": "course-academy-tex-v1"}}, "checks": [{"submitted": "\\frac{30 x^{5}}{5 x^{6} - 3}", "expected": "accepted", "purpose": "canonical"}, {"submitted": "\\frac{-60x^5}{6-10x^6}", "expected": "accepted", "purpose": "genuine scaled-fraction equivalent"}, {"submitted": "\\frac{-30x^5}{3-5x^6}+1", "expected": "rejected", "purpose": "wrong plus one"}]}]