[{"label": "not-an-id", "record": {"knowledge_point": {"id": "b4ac7f7e-1e07-57d7-a82a-d6545588c2de", "db_id": 17592186092264, "title": "Differentiating a Natural Logarithm Function Using the Chain Rule"}, "question": {":question/id": "235f9787-8f1f-526e-9e3d-4b939dea8bdf", ":question/problem": "Given that $f(x)=\\ln(8 x)$, find $\\frac{\\text{d}f}{\\text{d}x}.$", ":question/worked-solution": "Here $f(x)=\\ln(8 x)$ is a function of a function. We use the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\ln u,\\,u=8 x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8.\n$$\n\nWe now apply the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\ &=\\frac{1}{u}\\cdot (8) \\\\ &=\\frac{1}{8 x}\\cdot (8) \\\\ &=\\frac{8}{8 x} \\\\ &=\\frac{\\cancel{8}}{\\cancel{8}x} \\\\ &=\\frac{1}{x}.\\end{aligned}\n$$", ":question/difficulty": ":question.difficulty/moderate", ":question/answer-fields": [{":answer-field/id": "3246da1f-bdae-5b7d-a974-3a0079283d2b", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "c37baffa-7afb-521d-8722-7355ad1fefcb", ":answer/type": ":answer.type/math", ":answer/value": "\\frac{8}{x}"}, {":answer/id": "02986212-ed58-585e-a23e-4db661062e1f", ":answer/type": ":answer.type/math", ":answer/value": "8 \\ln{(8 x )}"}, {":answer/id": "5e2a3b23-32c4-5599-8e85-e9dd925bc258", ":answer/type": ":answer.type/math", ":answer/value": "\\frac{1}{\\ln{(8 x )}}"}, {":answer/id": "b5579894-157c-5e2f-97ec-ebaae4126749", ":answer/type": ":answer.type/math", ":answer/value": "\\frac{1}{x}"}, {":answer/id": "f3defb61-5aca-5b8e-afda-abd448775158", ":answer/type": ":answer.type/math", ":answer/value": "\\frac{1}{8 x}"}], ":answer-field/correct": [":answer/id", "b5579894-157c-5e2f-97ec-ebaae4126749"]}]}, "generation": {"generator_id": "f4aeeb80-4a3e-5dc6-ba00-a4d66431dbe1", "version": "ln-chain-private-2275-v1", "source_basis": 2275, "source_id": "q-11930", "template": "scale-radio", "difficulty": "moderate", "parameters": {"a": 8}, "bank_profile": "scale-radio-complete", "seed": 0, "mathematical_key": "d6cf67f3dacc5ae8bfb4c201f98909c7aa73e17038f99e5dae8150502578b838", "domain": "Interval.open(0, oo)", "dependencies": {"sympy": "1.14.0"}, "authored_changes": ["Corrected stale g(x) to f(x) in composite-function prose and separated joined sentence."], "eligible": true, "math_format": "course-academy-tex-v1"}}, "checks": [{"submitted": "not-an-id", "expected": "rejected", "purpose": "foreign/malformed"}]}]