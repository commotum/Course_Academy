xt{d}x}(9{x}^{1/2}-2{x}^{3/4}) \\\\  & =9\\cdot \\frac{1}{2}{x}^{-1/2}-2\\cdot \\frac{3}{4}{x}^{-1/4} \\\\  & =\\frac{9}{2}{x}^{-1/2}-\\frac{3}{2}{x}^{-1/4}.\\end{aligned}\n$$\n\nEvaluating at $x=256$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=256} & =\\frac{9}{2}\\cdot \\frac{1}{16}-\\frac{3}{2}\\cdot \\frac{1}{4} \\\\  & =-\\frac{3}{32}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(256,16)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=256}=-\\frac{3}{32}.\n$$"} {:db/id #edb/ref 17592186510691 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f99bc2f0-dc2e-52dc-9a0f-88e468f57bb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186510699}] :answer-field/correct {:answer/id #uuid "f99bc2f0-dc2e-52dc-9a0f-88e468f57bb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186510699} :answer-field/id #uuid "e512f17f-c103-5c3c-82bb-5f6973f5c51f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510697}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "99a60241-72e6-5737-aea9-72c487d2682d" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=3x-6\\sqrt{x}$ at the point $(25,45).$\n\n$m=$\n{{field-1}}" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x-6\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3x-6{x}^{1/2}) \\\\  & =3-6\\cdot \\frac{1}{2}{x}^{-1/2} \\\\  & =3-\\frac{3}{\\sqrt{x}}.\\end{aligned}\n$$\n\nEvaluating at $x=25$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=25} & =3-\\frac{3}{\\sqrt{25}} \\\\  & =3-\\frac{3}{5} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(25,45)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=25}=\\frac{12}{5}.\n$$"} {:db/id #edb/ref 17592186510692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aacfe591-5179-533b-a4db-353ac1025958" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11}{8}" :db/id #edb/ref 17592186510693}] :answer-field/correct {:answer/id #uuid "aacfe591-5179-533b-a4db-353ac1025958" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11}{8}" :db/id #edb/ref 17592186510693} :answer-field/id #uuid "ef8bb82f-c22d-5cef-a814-8ca96adebf89" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510698}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a7b32659-efdb-5f24-a94b-157e0fbb1fed" :question/problem "Find the exact value of the slope $m$ of the tangent to the curve $y=4\\sqrt{x}-8{x}^{3/4}$ at the point $(256,-448).$\n\n$m=$\n{{field-1}}" :question/worked-solution "This time, we'll use $\\frac{\\text{d}y}{\\text{d}x}$ notation. First, we compute the derivative, which gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}-8{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{1/2}-8{x}^{3/4}) \\\\  & =4\\cdot \\frac{1}{2}{x}^{-1/2}-8\\cdot \\frac{3}{4}{x}^{-1/4} \\\\  & =2{x}^{-1/2}-6{x}^{-1/4}.\\end{aligned}\n$$\n\nEvaluating at $x=256$ gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=256} & =2\\cdot \\frac{1}{16}-6\\cdot \\frac{1}{4} \\\\  & =-\\frac{11}{8}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent to the curve at the point $(256,-448)$ is\n\n$$\nm={\\frac{\\text{d}y}{\\text{d}x}|}_{x=256}=-\\frac{11}{8}.\n$$"}] :knowledge-point/title "Calculating the Slope of a Tangent Line of a Curve With Fractional Powers at a Given Point"}]}
