rect {:answer/id #uuid "d1d66349-73d9-5894-8ea5-62c18d22ca86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}x^{-2/3} + C" :db/id #edb/ref 17592186502952} :answer-field/id #uuid "8878aff2-5da1-5cae-8ac0-c802b9fa22f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502924}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "24409f16-92eb-5e3a-9a94-2612754d8d1a" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[3]{{x}^{5}}}$. Assume $x>0$." :question/worked-solution "Note that $\\frac{1}{\\sqrt[3]{{x}^{5}}}=\\frac{1}{{x}^{5/3}}={x}^{-5/3}.$ So, we can use the power rule with $n=-\\frac{5}{3}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[3]{{x}^{5}}}\\,\\text{d}x & =\\int {x}^{-5/3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/3+1}}{-\\frac{5}{3}+1}+C \\\\  & =-\\frac{3}{2}{x}^{-2/3}+C \\\\  & =-\\frac{3}{2{x}^{2/3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502879 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ca6ae77-d4eb-5628-bf2d-2ad81668a6fb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}x^{3/7} + C" :db/id #edb/ref 17592186502893} {:answer/id #uuid "4c8ee872-c2aa-5ac4-be85-d82e9c4ef936" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}x^{-11/7} + C" :db/id #edb/ref 17592186502907} {:answer/id #uuid "727e1873-0bcc-5e7f-8015-b4f278888e83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}x^{-4/7} + C" :db/id #edb/ref 17592186502919} {:answer/id #uuid "c398c1d7-925b-5ee5-a8fa-61cab36aa511" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{3}x^{3/7} + C" :db/id #edb/ref 17592186502946} {:answer/id #uuid "fa18ec9f-eb7c-5a17-b374-