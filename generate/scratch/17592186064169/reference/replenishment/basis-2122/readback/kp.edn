^{-1/5}+C \\\\  & =-\\frac{5}{{x}^{1/5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502931 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17719d5d-d1ba-5a53-82a1-927b9ba2ae7a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{6}x^{-7/6} + C" :db/id #edb/ref 17592186502869} {:answer/id #uuid "222ebe4e-7cc2-56b8-9528-6c4ba3801e4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{7}x^{-7/6} + C" :db/id #edb/ref 17592186502873} {:answer/id #uuid "45cf63b0-27c9-5a38-89d8-9b07fe0e46ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{7}x^{-7/6} + C" :db/id #edb/ref 17592186502905} {:answer/id #uuid "e2c684a2-9fa1-565b-98df-fcb0427759b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{7}x^{-13/6} + C" :db/id #edb/ref 17592186502956} {:answer/id #uuid "fb60838c-841d-5641-a911-df7407114bde" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{6}x^{-19/6} + C" :db/id #edb/ref 17592186502962}] :answer-field/correct {:answer/id #uuid "45cf63b0-27c9-5a38-89d8-9b07fe0e46ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{7}x^{-7/6} + C" :db/id #edb/ref 17592186502905} :answer-field/id #uuid "9a8e6cf9-5e9d-5592-8b0f-70404484ce19" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502932}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99719f66-3778-50b5-89e7-75e1a56079c8" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[6]{{x}^{13}}}$. Assume $x>0$." :question/worked-solution "Note that $\\frac{1}{\\sqrt[6]{{x}^{13}}}=\\frac{1}{{x}^{13/6}}={x}^{-13/6}.$ So, we can use the power rule with $n=-\\frac{13}{6}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[6]{{x}^{13}}}\\,\\text{d}x & =\\int {x}^{-13/6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-13/6+1}}{-\\frac{13}{6}+1}+C \\\\  & =-\\frac{6}{7}{x}^{-7/6}+C \\\\  & =-\\frac{6}{7{x}^{7/6}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502938 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09fcd5be-886d-5871-98a0-3b7bbee18125" :answer/type {:db/ident :answer.type/math} :answer/value "-6x^{-5} + C" :db/id #edb/ref 17592186502864} {:answer/id #uuid "17bc6fb3-f3d6-554b-b7d0-aa12f00d5ed2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}x^{-6} + C" :db/id #edb/ref 17592186502870} {:answer/id #uuid "30994037-ecf1-5233-ae47-c9184a594ed1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}x^{-5} + C" :db/id #edb/ref 17592186502881} {:answer/id #uuid "324f2843-e8c3-538b-861f-2062bfaaafcb" :answer/type {:db/ident :answer.type/math} :answer/value "-6x^{-7} + C" :db/id #edb/ref 17592186502883} {:answer/id #uuid "8968132d-f3a4-5d38-af6d-f8cb16432147" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}x^{-5} + C" :db/id #edb/ref 17592186502925}] :answer-field/correct {:answer/id #uuid "30994037-ecf1-5233-ae47-c9184a594ed1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}x^{-5} + C" :db/id #edb/ref 17592186502881} :answer-field/id #uuid "b42f636b-4503-5284-ad05-d0d8123f8de6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa70fb16-17a5-5816-9e73-90243c9b4ed6" :question/problem "What is the antiderivative of $\\frac{1}{{x}^{6}}?$ Assume $x>0$." :question/worked-solution "Note that $\\frac{1}{{x}^{6}}={x}^{-6}.$ So, we can use the power rule with $n=-6$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{6}}\\,\\text{d}x & =\\int {x}^{-6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-6+1}}{-6+1}+C \\\\  & =-\\frac{{x}^{-5}}{5}+C \\\\  & =-\\frac{1}{5{x}^{5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502948 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1821ed70-eaad-54b9-8c65-4bbb2bcf3160" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-13/6} + C" :db/id #edb/ref 17592186502871} {:answer/id #uuid "3b1a5dcb-9685-581b-a29b-34e5194a8426" :answer/type {:db/ident :answer.type/math} :answer/value "-6x^{-1/6} + C" :db/id #edb/ref 17592186502892} {:answer/id #uuid "532e1430-d266-59be-bcd5-73f6c2edc0c7" :answer/type {:db/ident :answer.type/math} :answer/value "6x^{-1/6} + C" :db/id #edb/ref 17592186502909} {:answer/id #uuid "a0474aa2-d95c-5f73-a568-2f603fd609c7" :answer/type {:db/ident :answer.type/math} :answer/value "-6x^{-7/6} + C" :db/id #edb/ref 17592186502934} {:answer/id #uuid "b62fcefc-fd59-5b42-856a-3cdec3b5280a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{6}x^{-1/6} + C" :db/id #edb/ref 17592186502941}] :answer-field/correct {:answer/id #uuid "3b1a5dcb-9685-581b-a29b-34e5194a8426" :answer/type {:db/ident :answer.type/math} :answer/value "-6x^{-1/6} + C" :db/id #edb/ref 17592186502892} :answer-field/id #uuid "4062f5dc-238e-55a5-899a-9aca06dee35f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502899}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc7d7a47-ab4b-5a3b-8ff4-ed432aa440ba" :question/problem "Calculate the integral of $\\frac{1}{\\sqrt[6]{{x}^{7}}}$. Assume $x>0$." :question/worked-solution "Note that $\\frac{1}{\\sqrt[6]{{x}^{7}}}=\\frac{1}{{x}^{7/6}}={x}^{-7/6}.$ So, we can use the power rule with $n=-\\frac{7}{6}$ and get\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt[6]{{x}^{7}}}\\,\\text{d}x & =\\int {x}^{-7/6}\\,\\text{d}x \\\\  & =\\frac{{x}^{-7/6+1}}{-\\frac{7}{6}+1}+C \\\\  & =-6{x}^{-1/6}+C \\\\  & =-\\frac{6}{{x}^{1/6}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502954 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34391ca3-ad98-50ce-8e1e-44cb8eade4a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502886} {:answer/id #uuid "401ae6af-30db-5402-a6f2-7d26f4d47d36" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-14/5} + C" :db/id #edb/ref 17592186502897} {:answer/id #uuid "5b7281c4-4d4b-5557-8aaa-96752cd38280" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-9/5} + C" :db/id #edb/ref 17592186502910} {:answer/id #uuid "c4952ea7-4ee5-5ad8-9fff-3d99d83b3d92" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{5}x^{-4/5} + C" :db/id #edb/ref 17592186502947} {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949}] :answer-field/correct {:answer/id #uuid "ccdc31d2-bc17-5147-b336-7e1539023d9d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}x^{-4/5} + C" :db/id #edb/ref 17592186502949} :answer-field/id #uuid "71958d00-8def-5201-b349-02ba63662a31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502918}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de2aa536-e15f-5af4-b511-e0e4c9d378a1" :question/problem "Given that $f(x)=\\frac{1}{{x}^{9/5}}$ and that ${F}^{'}(x)=f(x)$, calculate $F(x).$ Assume $x>0$." :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{'}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{'}(x) & =f(x) \\\\ \\int {F}^{'}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\frac{1}{{x}^{9/5}}={x}^{-9/5}.$ So, we can use the power rule with $n=-\\frac{9}{5}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-9/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{-9/5+1}}{(-\\frac{9}{5}+1)}+C \\\\  & =\\frac{{x}^{-4/5}}{(-\\frac{4}{5})}+C \\\\  & =-\\frac{5}{4}{x}^{-4/5}+C \\\\  & =-\\frac{5}{4{x}^{4/5}}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}]}
