 that $\\frac{1}{{x}^{5/4}}={x}^{-5/4}.$ So, we can use the power rule with $n=-\\frac{5}{4}$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{-5/4}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/4+1}}{(-\\frac{5}{4}+1)}+C \\\\  & =\\frac{{x}^{-1/4}}{(-\\frac{1}{4})}+C \\\\  & =-4{x}^{-1/4}+C \\\\  & =-\\frac{4}{{x}^{1/4}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186502914 :knowledge-point/_questions [{:knowledge-point/id #uuid "3174cae9-484e-5ca3-8e5c-3c9cddc86145" :knowledge-point/title "Finding the Antiderivative of a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0079a791-7df9-5dd7-bdf0-9fde624e2bc1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x^{5/7} + C" :db/id #edb/ref 17592186502860} {:answer/id #uuid "337d5a89-e1d3-5a29-83bb-5d3c21780cb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}x^{-2/7} + C" :db/id #edb/ref 17592186502884} {:answer/id #uuid "369f6c33-6557-5d15-9e0e-5f461bceaa53" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}x^{-9/7} + C" :db/id #edb/ref 17592186502888} {:answer/id #uuid "384fd8fa-5c2e-5502-b800-d8f574d73937" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{5}x^{5/7} + C" :db/id #edb/ref 17592186502890} {:answer/id #uuid "b2d5023d-868a-5e5b-8467-7a19e219606f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}x^{5/7} + C" :db/id #edb/ref 17592186502939}] :answer-field/correct {:answer/id #uuid "b2d5023d-868a-5e5b-8467-7a19e219606f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}x^{5/7} + C" :db/id #edb/ref 17592186502939} :answer-field/id #uuid "8b3ca9a2-ba9f-55a3-b9c0-c0e7936f7ddc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186502926}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ac48824-980d-5dff-8c7