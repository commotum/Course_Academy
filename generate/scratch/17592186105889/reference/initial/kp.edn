rac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(-{x}^{2}-{y}^{2})=-2x,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(-{x}^{2}-{y}^{2})=-2y.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(-2x)}^{2}+{(-2y)}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,{x}^{2}{y}^{2}(-{x}^{2}-{y}^{2})\\sqrt{1+4{x}^{2}+4{y}^{2}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\,(-{x}^{4}{y}^{2}-{x}^{2}{y}^{4})\\sqrt{1+4{x}^{2}+4{y}^{2}}\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186415979 :knowledge-point/_questions [{:knowledge-point/id #uuid "8885504f-07fb-5308-a982-608d7baa262b" :knowledge-point/title "Express Surface Integrals as Repeated Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "246b6bfe-20aa-55cc-b239-3304de81494f" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{2}y" :db/id #edb/ref 17592186415952} {:answer/id #uuid "72fa2757-f8e2-52c7-97eb-f3ea64fd0de1" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}y" :db/id #edb/ref 17592186415959} {:answer/id #uuid "a9391385-1fbe-53da-993e-c0f38007e6e4" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}{y}^{2}" :db/id #edb/ref 17592186415964} {:answer/id #uuid "abd564cc-a7f0-5f60-a224-edcb8733b99b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}y" :db/id #edb/ref 17592186415965} {:answer/id #uuid "fa49e0e8-2a63-57cc-8df5-3f02f87ef7e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}y" :db/id #edb/ref 17592186415972}] :answer-field/correct {:answer/id #uuid "abd564cc-a7f0-5f60-a224-edcb8733b99b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}y" :db/id #edb/ref 17592186415965} :answer-field/id #uuid "1a33e