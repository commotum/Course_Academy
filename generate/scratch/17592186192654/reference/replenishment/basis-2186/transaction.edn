ue}5}$, then the coefficient of $u$ will turn into $-20$, which will cancel with the coefficient of $20$ in the first equation.\n\n$$\n\\{20u + 6v = 3; (-4u + 5v = 8)\\cdot (5)\n$$\n\nNow, when we add the two equations, the variable $u$ will be eliminated:\n\n$$\n\\begin{aligned}\n20u + 6v &= 3 \\\\\n-20u + 25v &= 40 \\\\\n(6v + 25v) &= (3 + 40) \\\\\n31v &= 43\n\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n> *To eliminate $u$, multiply the $\\bbox[3pt,Gainsboro]{\\color{blue}\\text{second}}$ equation by $\\bbox[3pt,Gainsboro]{\\color{blue}5}$, and add the equations*." :question/difficulty :question.difficulty/hard :question/answer-fields ["d437a68d-9287-57f8-9d35-cc3834e5ea53" "6eb46f5a-1905-56bd-b927-28be5498f5e5"] :db/ensure :question/validate} {:db/id "6366cbf8-6f3c-59f8-85e8-afa222de7c79" :answer/id #uuid "6366cbf8-6f3c-59f8-85e8-afa222de7c79" :answer/type :answer.type/text :answer/value "second" :db/ensure :answer/validate} {:db/id "e812bb9d-85bd-5eba-96a1-00f6dcc2114f" :answer/id #uuid "e812bb9d-85bd-5eba-96a1-00f6dcc2114f" :answer/type :answer.type/text :answer/value "first" :db/ensure :answer/validate} {:db/id "ea548465-2882-50b8-a82c-88c394a407d7" :answer-field/id #uuid "ea548465-2882-50b8-a82c-88c394a407d7" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices ["6366cbf8-6f3c-59f8-85e8-afa222de7c79" "e812bb9d-85bd-5eba-96a1-00f6dcc2114f"] :answer-field/correct "6366cbf8-6f3c-59f8-85e8-afa222de7c79" :db/ensure :answer-field/validate} {:db/id "5cdd9d3f-8d36-58b4-9886-ce4ee52ed524" :answer/id #uuid "5cdd9d3f-8d36-58b4-9886-ce4ee52ed524" :answer/type :answer.type/math :answer/value "5" :db/ensure :answer/validate} {:db/id "918562c7-6c5b-59ed-b9ef-27e37857cff7" :answer/id #uuid "918562c7-6c5b-59ed-b9ef-27e37857cff7" :answer/type :answer.type/math :answer/value "-5" :db/ensure :answer/validate} {:db/id "2d4852eb-b287-5edc-94bd-5d263ed7b246" :answer/id #uuid "2d4852eb-b287-5edc-94bd-5d263ed7b246