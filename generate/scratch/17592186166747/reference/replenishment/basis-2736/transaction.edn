} e^{x y}\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =t^{5} e^{t^{5}} + e^{t^{5}} \\\\ \\frac{∂f}{∂y} & =t^{4} e^{t^{5}}\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} &=2 t,\\,\\frac{\\text{d}y}{\\text{d}t}=3 t^{2}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =(t^{5} e^{t^{5}} + e^{t^{5}})\\cdot (2 t)+(t^{4} e^{t^{5}})\\cdot (3 t^{2}) \\\\  & =2 t e^{t^{5}} + (2 t^{6} e^{t^{5}}) + (3 t^{6} e^{t^{5}}) \\\\  & =t (5 t^{5} + 2) e^{t^{5}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["95940820-fd45-5f5b-99f8-92f8a12c3bad"] :db/ensure :question/validate} {:db/id "28864dae-edc6-5897-84e2-b4f8f19a9ad8" :answer/id #uuid "28864dae-edc6-5897-84e2-b4f8f19a9ad8" :answer/type :answer.type/math :answer/value "- (2 t - 1)^{6} (8 t - 8) e^{(2 t - 2)^{2} (2 t - 1)^{3}} + 6 (2 t - 1)^{2} ((2 t - 2)^{2} (2 t - 1)^{3} e^{(2 t - 2)^{2} (2 t - 1)^{3}} + e^{(2 t - 2)^{2} (2 t - 1)^{3}})" :db/ensure :answer/validate} {:db/id "37d75164-96de-5488-990b-58d49b5c3a9f" :answer/id #uuid "37d75164-96de-5488-990b-58d49b5c3a9f" :answer/type :answer.type/math :answer/value "(2 t - 1)^{6} (8 t - 8) e^{(2 t - 2)^{2} (2 t - 1)^{3}}" :db/ensure :answer/validate} {:db/id "2cd50b34-1d20-57d9-b5aa-2865814b40a5" :answer/id #uuid "2cd50b34-1d20-57d9-b5aa-2865814b40a5" :answer/type :answer.type/math :answer/value "6 (2 t - 1)^{2} ((2 t - 2)^{2} (2 t - 1)^{3} e^{(2 t - 2)^{2} (2 t - 1)^{3}} + e^{(2 t - 2)^{2} (2 t - 1)^{3}})" :db/ensure :answer/validate} {:db/id "4a217e14-3bda-5454-bcca-c0092a1651a6" :answer/id #uuid "4a217e14-3bda-5454-bcca-c0092a1651a6" :answer