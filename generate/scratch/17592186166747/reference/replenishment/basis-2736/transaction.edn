} & =(2 t - 1)^{6} e^{(2 t - 2)^{2} (2 t - 1)^{3}}\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} &=6 (2 t - 1)^{2},\\,\\frac{\\text{d}y}{\\text{d}t}=8 t - 8.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =((2 t - 2)^{2} (2 t - 1)^{3} e^{(2 t - 2)^{2} (2 t - 1)^{3}} + e^{(2 t - 2)^{2} (2 t - 1)^{3}})\\cdot (6 (2 t - 1)^{2})+((2 t - 1)^{6} e^{(2 t - 2)^{2} (2 t - 1)^{3}})\\cdot (8 t - 8) \\\\  & =6 (2 t - 1)^{2} e^{(2 t - 2)^{2} (2 t - 1)^{3}} + (6 (2 t - 2)^{2} (2 t - 1)^{5} e^{(2 t - 2)^{2} (2 t - 1)^{3}}) + ((2 t - 1)^{6} (8 t - 8) e^{(2 t - 2)^{2} (2 t - 1)^{3}}) \\\\  & =2 (2 t - 1)^{2} (12 (t - 1)^{2} (2 t - 1)^{3} + 4 (t - 1) (2 t - 1)^{4} + 3) e^{(2 t - 2)^{2} (2 t - 1)^{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["d061cc16-2e62-5867-ac53-ca52bd6a819a"] :db/ensure :question/validate} {:db/id "0ce87af5-550b-5dba-a26e-ec8e204c383b" :answer/id #uuid "0ce87af5-550b-5dba-a26e-ec8e204c383b" :answer/type :answer.type/math :answer/value "- (t - 3)^{4} (2 t - 2) e^{(t - 3)^{2} (t - 1)^{2}} + (2 t - 6) ((t - 3)^{2} (t - 1)^{2} e^{(t - 3)^{2} (t - 1)^{2}} + e^{(t - 3)^{2} (t - 1)^{2}})" :db/ensure :answer/validate} {:db/id "73b29452-f6b2-5756-85ed-42f37daa52fd" :answer/id #uuid "73b29452-f6b2-5756-85ed-42f37daa52fd" :answer/type :answer.type/math :answer/value "- 2 (t - 3) ((t - 3)^{3} (t - 1) + (t - 3)^{2} (t - 1)^{2} + 1) e^{(t - 3)^{2} (t - 1)^{2}}" :db/ensure :answer/validate} {:db/id "034ddcd1-8433-5781-9469-3da41704071a" :answer/id #uuid "034ddcd1-8433-5781-9469-3da41704071a" :answer/type :answer.type/math :answer/value "2 (t - 3) ((t - 3)^{3} (t - 1) + (t - 3)^{2} (t - 1)^{2} + 1) e