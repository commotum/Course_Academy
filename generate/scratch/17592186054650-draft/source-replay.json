                ":answer/id": "e8c8a889-cb33-5eaf-8a1d-2f8ebafa4af5",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\begin{bmatrix}2 & -1 \\\\ -3 & 1 \\\\ 1 & -2\\end{bmatrix}"
