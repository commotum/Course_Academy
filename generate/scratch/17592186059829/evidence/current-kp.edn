#{[{:db/id #edb/ref 17592186059829 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059388 :question/id #uuid "6d4bd0a2-0961-54c1-b781-b470d420d848" :question/math-academy-id "e-10816" :question/problem "Express the inequality $1 \\le x \\le4$ in interval notation." :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $1$ and $4$ *are* included. \n\n$$\n1\\,\\, {\\color{blue}{\\le}} \\,\\, x \\,\\, {\\color{blue}{\\le}} \\,\\, 4\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n{\\color{blue}{[}}1,4{\\color{blue}{]}}\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [1,4].\n$$"} :knowledge-point/id #uuid "2f519fa9-de89-5b00-aa02-312cf8e32cba" :knowledge-point/questions [{:db/id #edb/ref 17592186059958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3d8a45-fe13-581e-9e3f-055e9482e906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-10,3)" :db/id #edb/ref 17592186482865} {:answer/id #uuid "2eee8041-f4fa-545a-a3f7-4d63c35b6ba8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10,3)" :db/id #edb/ref 17592186482892} {:answer/id #uuid "3dacba62-f7cd-5fb4-b7ac-b6a55cdc2a73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-10,3]" :db/id #edb/ref 17592186482917} {:answer/id #uuid "982b05bc-9e84-5fbb-95ab-465cc3b39a18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,3]" :db/id #edb/ref 17592186483074} {:answer/id #uuid "b9d2aab1-6872-5e77-8697-9067584fdf64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-10,3]" :db/id #edb/ref 17592186483125}] :answer-field/correct {:answer/id #uuid "b9d2aab1-6872-5e77-8697-9067584fdf64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-10,3]" :db/id #edb/ref 17592186483125} :answer-field/id #uuid "bbff7b41-8a1b-509f-91ec-dd43bc73c6e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bdfaded-c508-56ef-8657-15a990f7ff66" :question/math-academy-id "q-102200" :question/problem "The inequality $-10\\le x\\le 3$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $-10$ and $3$ *are* included. \n\n$$\n-10\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,3\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n[-10,3]\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [-10,3].\n$$"} {:db/id #edb/ref 17592186060311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f4fcf20-b761-5c35-9cb9-bc13442a9247" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 \\le x < 1" :db/id #edb/ref 17592186058489} {:answer/id #uuid "294058c7-dbb2-5a13-b2a1-2c9f829d7bfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 < x < 1" :db/id #edb/ref 17592186058490} {:answer/id #uuid "29ba0508-5e1c-5e13-bfd5-eb18298c3eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 < x \\le 1" :db/id #edb/ref 17592186058491} {:answer/id #uuid "2a3384f8-cacb-59a2-bba4-1fe80c835cd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2 \\le x \\le 1" :db/id #edb/ref 17592186058492} {:answer/id #uuid "7eb49550-8e55-5c30-a78d-936a6b38052c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x < - 2$ or $x > 1$" :db/id #edb/ref 17592186058493}] :answer-field/id #uuid "aa4d510e-000f-56ed-96ab-f3ee9e00807a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058488}] :question/id #uuid "bbd1ffa1-a464-5d62-8ff3-86fb660a92c4" :question/math-academy-id "q-59295" :question/problem "Which inequality corresponds to the interval $x ∈ [- 2, 1]$?"} {:db/id #edb/ref 17592186483384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75a68108-a8cc-5fb7-90d8-d305c41c4fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x\\le 0" :db/id #edb/ref 17592186483015} {:answer/id #uuid "943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\le x\\le 0" :db/id #edb/ref 17592186483070} {:answer/id #uuid "a18f6b94-6b53-545a-a37a-bd11450bb699" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\le x<0" :db/id #edb/ref 17592186483083} {:answer/id #uuid "a3a2c334-25f5-5b4f-b754-81cc023155a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<0" :db/id #edb/ref 17592186483089} {:answer/id #uuid "aefb8691-5a94-57f6-a7c9-d4669ca141d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -7$ or $x\\ge 0$" :db/id #edb/ref 17592186483108}] :answer-field/correct {:answer/id #uuid "943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7\\le x\\le 0" :db/id #edb/ref 17592186483070} :answer-field/id #uuid "8a0884c4-5df6-5fd3-b8ad-b0ee63b9d7ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186483294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8752fefa-3c8b-5341-99df-0d350ae12f59" :question/math-academy-id "q-154728" :question/problem "Which inequality corresponds to the interval $x\\in [-7,0]?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses $(,)$ to indicate that the endpoints are *not* included.\n\n- Brackets $[]$ to indicate that the endpoints *are* included.\n\nOur interval contains only brackets. So, the endpoints *are* included. \n\n$$\nx\\in [-7,0]\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n-7\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,0\n$$"}] :knowledge-point/title "Converting Between Intervals and Inequalities: Closed Intervals"}]}
