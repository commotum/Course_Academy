139535587 17592186045443 true] [17592186519933 1072 #uuid "5487c7b6-44fe-5e39-9226-bf0a43081f99" 13194139535587 17592186045443 true] [17592186519933 1074 "Notice that the given curve is of the form $x=x(y),$ Therefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=e^{\\frac{t}{2}}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨e^{\\frac{t}{2}},\\,t⟩,\\,0\\le t\\le \\ln{\\left(2 \\right)}\n$$\n\nNote that the domain $0\\le t\\le \\ln{\\left(2 \\right)}$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(e^{\\frac{t}{2}})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{e^{\\frac{t}{2}}}{2}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(\\frac{e^{\\frac{t}{2}}}{2})^2+1^2} \\\\  & =\\sqrt{\\frac{e^{t}}{4}+1} \\\\  & =\\sqrt{\\frac{e^{t}}{4} + 1}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=2 x^{6} e^{- 2 y},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2 \\left(e^{\\frac{t}{2}}\\right)^{6} e^{- 2 t} \\\\  & =2 e^{t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}2 x^{6} e^{- 2 y}\\,\\text{d}s & ={\\int }_{0}^{\\ln{\\left(2 \\right)}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\ln{\\left(2 \\right)}}\\left(2 e^{t}\\right)\\cdot\\left(\\sqrt{\\frac{e^{t}}{4} + 1}\\right)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\ln{\\left(2 \\right)}}\\sqrt{e^{t} + 4} e^{t}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=e^{t} + 4,$ $\\text{d}u=e^{t}\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\ln{\\left(2 \\right)}}\\sqrt{e^{t} + 4} e^{t}\\,\\text{d}t & =1{\\int }_{5}^{6}\\sqrt{u}\\cdot\\left(1\\right)\\,\\text{d}u \\\\  & ={\\int }_{5}^{6}\\sqrt{u}\\,\\text{d}u \\\\  & =\\left[1\\cdot\\frac{2}{3}u^{3/2}\\right]_{5}^{6} \\\\  & =\\left[\\frac{2 u^{\\frac{3}{2}}}{3}\\right]_{5}^{6} \\\\  & =\\left(\\left(\\frac{2 \\left(6\\right)^{\\frac{3}{2}}}{3}\\right)\\right)-\\left(\\left(\\frac{2 \\left(5\\right)^{\\frac{3}{2}}}{3}\\right)\\right) \\\\  & =\\left(\\left(4 \\sqrt{6}\\right)\\right)-\\left(\\left(\\frac{10 \\sqrt{5}}{3}\\right)\\right) \\\\  & =- \\frac{10 \\sqrt{5}}{3} + 4 \\sqrt{6}\\end{aligned}\n$$" 13194139535587 17592186045443 true] [17592186519934 1080 "2" 13194139535587 17592186045443 true] [17592186519934 1082 #edb/ref 17592186045498 13194139535587 17592186045443 true] [17592186519934 1083 #uuid "5aa47a8c-d91a-57c1-a9f1-0922f42018fa" 13194139535587 17592186045443 true] [17592186519935 1075 #edb/ref 17592186519914 13194139535587 17592186045443 true] [17592186519935 1075 #edb/ref 17592186519916 13194139535587 17592186045443 true] [17592186519935 1075 #edb/ref 17592186519945 13194139535587 17592186045443 true] [17592186519935 1075 #edb/ref 17592186519959 13194139535587 17592186045443 true] [17592186519935 1075 #edb/ref 17592186519966 13194139535587 17592186045443 true] [17592186519935 1076 #edb/ref 17592186045493 13194139535587 17592186045443 true] [17592186519935 1077 "selection" 13194139535587 17592186045443 true] [17592186519935 1078 #edb/ref 17592186519959 13194139535587 17592186045443 true] [17592186519935 1079 #uuid "5aabe041-866e-5d3f-b02e-f537a8abdf22" 13194139535587 17592186045443 true] [17592186519936 1068 #edb/ref 17592186519929 13194139535587 17592186045443 true] [17592186519936 1070 #edb/ref 17592186045486 13194139535587 17592186045443 true] [17592186519936 1071 "Evaluate the line integral\n${\\int }_{C}\\frac{6 x}{y}\\,\\text{d}s,$\nwhere $C$ is the section of the curve $y^2=6x$ from $(\\frac{7}{6},\\sqrt{7})$ to $(\\frac{8}{3},4).$" 13194139535587 17592186045443 true] [17592186519936 1072 #uuid "5b75b6c1-d336-52ca-ae2f-f314c60fb3a9" 13194139535587 17592186045443 true] [17592186519936 1074 "Notice that the given curve can be expressed in the form $x=x(y),$ as follows:\n\n$$\ny^2=6x\\,⟹\\,x=\\frac{y^{2}}{6}.\n$$\n\nTherefore, by setting $y=t,$ we have\n\n$$\nx=x(t)=\\frac{t^{2}}{6}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\nr(t)=⟨\\frac{t^{2}}{6},\\,t⟩,\\,\\sqrt{7}\\le t\\le 4\n$$\n\nNote that the domain $\\sqrt{7}\\le t\\le 4$ is defined by the $y$-coordinates of the end-points on the path.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t^{2}}{6})i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{t}{3}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(\\frac{t}{3})^2+1^2} \\\\  & =\\sqrt{\\frac{t^{2}}{9}+1} \\\\  & =\\sqrt{\\frac{t^{2}}{9} + 1}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y)=\\frac{6 x}{y},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{6 \\left(\\frac{t^{2}}{6}\\right)}{t} \\\\  & =t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{6 x}{y}\\,\\text{d}s & ={\\int }_{\\sqrt{7}}^{4}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{7}}^{4}\\left(t\\right)\\cdot\\left(\\sqrt{\\frac{t^{2}}{9} + 1}\\right)\\,\\text{d}t \\\\  & ={\\int }_{\\sqrt{7}}^{4}\\frac{t \\sqrt{t^{2} + 9}}{3}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=t^{2} + 9,$ $\\text{d}u=2 t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\sqrt{7}}^{4}\\frac{t \\sqrt{t^{2} + 9}}{3}\\,\\text{d}t & =\\frac{1}{3}{\\int }_{16}^{25}\\sqrt{u}\\cdot\\left(\\frac{1}{2}\\right)\\,\\text{d}u \\\\  & ={\\int }_{16}^{25}\\frac{\\sqrt{u}}{6}\\,\\text{d}u \\\\  & =\\left[\\frac{1}{6}\\cdot\\frac{2}{3}u^{3/2}\\right]_{16}^{25} \\\\  & =\\left[\\frac{u^{\\frac{3}{2}}}{9}\\right]_{16}^{25} \\\\  & =\\left(\\left(\\frac{\\left(25\\right)^{\\frac{3}{2}}}{9}\\right)\\right)-\\left(\\left(\\frac{\\left(16\\right)^{\\frac{3}{2}}}{9}\\right)\\right) \\\\  & =\\left(\\left(\\frac{125}{9}\\right)\\right)-\\left(\\left(\\frac{64}{9}\\right)\\right) \\\\  & =\\frac{61}{9}\\end{aligned}\n$$" 13194139535587 17592186045443 true] [17592186519937 1080 "\\frac{5 \\sqrt{5}}{2} + \\frac{343}{2}" 13194139535587 17592186045443 true] [17592186519937 1082 #edb/ref 17592186045498 13194139535587 17592186045443 true] [17592186519937 1083 #uuid "5ee718e7-8c66-5b5c-9686-158a4a052a0b" 13194139535587 17592186045443 true] [17592186519938 1075 #edb/ref 17592186519915 13194139535587 17592186045443 true] [17592186519938 1075 #edb/ref 17592186519923 13194139535587 17592186045443 true] [17592186519938 1075 #edb/ref 17592186519961 13194139535587 17592186045443 true] [17592186519938 1075 #edb/ref 17592186519973 13194139535587 17592186045443 true] [17592186519938 1075 #edb/ref 17592186519980 13194139535587 17592186045443 true] [17592186519938 1076 #edb/ref 17592186045493 13194139535587 17592186045443 true] [17592186519938 1077 "selection" 13194139535587 17592186045443 true] [17592186519938 1078 #edb/ref 17592186519973 13194139535587 17592186045443 true] [17592186519938 1079 #uuid "6400f1c6-0b7b-5401-8a4b-73a82dadcf86" 13194139535587 17592186045443 true] [17592186519939 1075 #edb/ref 17592186519937 13194139535587 17592186045443 true] [17592186519939 1075 #edb/ref 17592186519942 13194139535587 17592186045443 true] [17592186519939 1075 #edb/ref 17592186519952 13194139535587 17592186045443 true] [17592186519939 1075 #edb/ref 17592186519955 13194139535587 17592186045443 true] [17592186519939 1075 #edb/ref 17592186519962 13194139535587 17592186045443 true] [17592186519939 1076 #edb/ref 17592186045493 13194139535587 17592186045443 true] [17592186519939 1077 "selection" 13194139535587 17592186045443 true] [17592186519939 1078 #edb/ref 17592186519942 13194139535587 17592186045443 true]