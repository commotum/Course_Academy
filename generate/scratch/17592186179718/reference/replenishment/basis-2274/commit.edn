frac{1}{t}}\\right)\\,\\text{d}t \\\\  & ={\\int }_{1}^{5}16 t \\sqrt{t + 1}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we solve this using the substitution $u=4 t + 4,$ $\\text{d}u=4\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}16 t \\sqrt{t + 1}\\,\\text{d}t & =8{\\int }_{8}^{24}\\frac{u-4}{4}\\cdot\\sqrt{u}\\cdot\\frac{1}{4}\\,\\text{d}u \\\\  & ={\\int }_{8}^{24}\\frac{u^{\\frac{3}{2}}}{2} - 2 \\sqrt{u}\\,\\text{d}u \\\\  & =\\left[\\frac{1}{2}\\cdot\\left(\\frac{2}{5}u^{5/2}-(4)\\cdot\\frac{2}{3}u^{3/2}\\right)\\right]_{8}^{24} \\\\  & =\\left[\\frac{u^{\\frac{5}{2}}}{5} - \\frac{4 u^{\\frac{3}{2}}}{3}\\right]_{8}^{24} \\\\  & =\\left(\\left(\\frac{\\left(24\\right)^{\\frac{5}{2}}}{5}\\right)+\\left(- \\frac{4 \\left(24\\right)^{\\frac{3}{2}}}{3}\\right)\\right)-\\left(\\left(\\frac{\\left(8\\right)^{\\frac{5}{2}}}{5}\\right)+\\left(- \\frac{4 \\left(8\\right)^{\\frac{3}{2}}}{3}\\right)\\right) \\\\  & =\\left(\\left(\\frac{1152 \\sqrt{6}}{5}\\right)+\\left(- 64 \\sqrt{6}\\right)\\right)-\\left(\\left(\\frac{128 \\sqrt{2}}{5}\\right)+\\left(- \\frac{64 \\sqrt{2}}{3}\\right)\\right) \\\\  & =- \\frac{64 \\sqrt{2}}{15} + \\frac{832 \\sqrt{6}}{5}\\end{aligned}\n$$" 13194139535587 17592186045443 true] [17592186519980 1080 "13 \\sqrt{5}" 13194139535587 17592186045443 true] [17592186519980 1082 #edb/ref 17592186045498 13194139535587 17592186045443 true] [17592186519980 1083 #uuid "f537f4b8-eb49-5ef0-9790-4395f8071591" 13194139535587 17592186045443 true] [17592186519981 1080 "\\frac{64 \\sqrt{2}}{15} + \\frac{832 \\sqrt{6}}{5}" 13194139535587 17592186045443 true] [17592186519981 1082 #edb/ref 17592186045498 13194139535587 17592186045443 true] [17592186519981 1083 #uuid "f5509479-ec88-5363-9bf0-f7d33b99fdee" 13194139535587 17592186045443 true] [17592186519982 1080 "21 \\sqrt{5}" 13194139535587 17592186045443 true] [17592186519982 1082 #edb/ref 17592186045498 13194139535587 17592186045443 true] [17592186519982 1083 #uuid "fe15649c-aa4e-5adc-af44-f12