[{"record": {"knowledge_point": {"db_id": 17592186068780, "id": "308f3685-0a90-56f3-9653-a83cec4286d2", "title": "Solving for Some Unknowns Given the Graph of a Transformed Reciprocal Function"}, "question": {":question/problem": "![](images/01/01b742fa8f4bf42597e8653cf6b379537d95c3789743a564064a768ca343d197.png)\n\nThe graph represents the function $y=\\frac{a}{x}+k.$ What is the value of $a+k?$", ":question/difficulty": ":question.difficulty/moderate", ":question/worked-solution": "First, notice that the horizontal asymptote of the graph is $y=1.$ This means that $k=1$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}+1.\n$$\n\nAlso, we are given that the point $(1,2.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}+1 \\\\ 2.5 & =\\frac{a}{1}+1 \\\\ 1.5 & =\\frac{a}{1} \\\\ a & =1.5.\\end{aligned}\n$$\n\nFinally, $a+k=1+1.5=2.5.$", ":question/id": "8b02eeba-1b78-5560-a566-1a23f2f3e4bf", ":question/answer-fields": [{":answer-field/id": "c9b57d05-f615-5433-bc5b-2103b6435a1c", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "e7828750-2e0b-57a5-890d-9250ea98e740", ":answer/type": ":answer.type/math", ":answer/value": "1.5"}, {":answer/id": "ae251236-2dc6-5126-9525-b68c76cdaee9", ":answer/type": ":answer.type/math", ":answer/value": "2.5"}, {":answer/id": "1e801e3d-36d2-54ea-a8a0-0f1c7c33691f", ":answer/type": ":answer.type/math", ":answer/value": "5"}, {":answer/id": "a6707efb-debe-5a63-a6b2-3fc4a35e7e09", ":answer/type": ":answer.type/math", ":answer/value": "2"}, {":answer/id": "e47866f8-2070-51ec-a9ae-69bdf2d81510", ":answer/type": ":answer.type/math", ":answer/value": "-1"}], ":answer-field/correct": [":answer/id", "ae251236-2dc6-5126-9525-b68c76cdaee9"]}]}, "generation": {"version": "reciprocal-unknowns-v1", "seed": 17, "template": "moderate_sum", "profile": "raw:q-39047", "parameters": {"a": "3/2", "b": "0", "k": "1", "px": "1", "py": "5/2"}, "parameter_fingerprint": "57ce380726baad28abfc536ccff7eb3249d6b1a7c222f37e2dc5e82b9138f15d", "content_fingerprint": "ab25b2897fc72bd866850b867894f84d3d222a7008027efafd7fa571207f0d03", "source": {"database": "math", "basis": 1356, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "source_ids": ["q-39047"], "evidence_only": true, "eligible_for_learning": false, "bank_origin": "opaque observed parameterized offset mask", "authored_level": false, "python_version": "3.13.5", "sympy_version": "1.14.0", "matplotlib_version": "3.11.2", "plot": {"source_asset": "images/01/01b742fa8f4bf42597e8653cf6b379537d95c3789743a564064a768ca343d197.png", "geometry_reference": "plot-extraction.json"}, "plot_asset": "images/01/01b742fa8f4bf42597e8653cf6b379537d95c3789743a564064a768ca343d197.png", "domain": "x != b", "solution_style": "q-39047"}}, "label": "q-39047", "checks": [{"field_index": 0, "submitted_answer_id": "e7828750-2e0b-57a5-890d-9250ea98e740", "expected": "accepted", "purpose": "complete owned scalar bank"}, {"field_index": 0, "submitted_answer_id": "ae251236-2dc6-5126-9525-b68c76cdaee9", "expected": "accepted", "purpose": "complete owned scalar bank"}, {"field_index": 0, "submitted_answer_id": "1e801e3d-36d2-54ea-a8a0-0f1c7c33691f", "expected": "rejected", "purpose": "complete owned scalar bank"}, {"field_index": 0, "submitted_answer_id": "a6707efb-debe-5a63-a6b2-3fc4a35e7e09", "expected": "rejected", "purpose": "complete owned scalar bank"}, {"field_index": 0, "submitted_answer_id": "e47866f8-2070-51ec-a9ae-69bdf2d81510", "expected": "rejected", "purpose": "complete owned scalar bank"}]}]