5 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0821bfbf-d3f3-5791-86f1-89c62a946047" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186504746} {:answer/id #uuid "450ca3ad-5fc3-517b-9eb1-c3435fb1a849" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504783} {:answer/id #uuid "5b80624b-1796-588d-a524-36a238a9c3c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186504787} {:answer/id #uuid "cdd81ae2-7ef1-5cbd-bfba-d3bcbf8f27ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186504822} {:answer/id #uuid "df3d40c2-8d37-512a-94bc-0ead51b2e947" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{5}" :db/id #edb/ref 17592186504829}] :answer-field/correct {:answer/id #uuid "5b80624b-1796-588d-a524-36a238a9c3c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186504787} :answer-field/id #uuid "2687c3e4-7ba0-5797-a128-d4fd2dc3a424" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504766}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0803379b-a2dd-51ec-9c3c-dfbd721fe7b8" :question/problem "Given that $λ(5a - 25b)$ and $6a - 30b$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(5a - 25b)=λ(5)a+λ(-25)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{6}{5} = \\frac{6}{5} \\\\\nλ &= \\frac{-30}{-25} = \\frac{6}{5}\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n6a - 30b=\\frac{6}{5}(5a - 25b).\n$$\n\nTherefore,\n\n$$\nλ=\\frac{6}{5}\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504750 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed79da2-cd03-5afb-9f7b-d83a004a3e76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186504779} {:answer/id #uuid "9119d6e8-112d-5ec4-b34f-64b7967c9cc1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186504806} {:answer/id #uuid "95b4ce27-3bec-5cfb-b356-53f9f4f1cf23" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186504807} {:answer/id #uuid "d37204b9-b5ff-512b-b51f-9c30c1240fe4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186504827} {:answer/id #uuid "e4140720-5a44-55db-ba52-36637d99f99e" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504830}] :answer-field/correct {:answer/id #uuid "95b4ce27-3bec-5cfb-b356-53f9f4f1cf23" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186504807} :answer-field/id #uuid "7c3cfc3c-9090-5c9c-9996-c40a0de36ef1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0ecb5994-c9d9-519e-8505-fb41a7d19179" :question/problem "Given that $-8a - 10b$ and $λ(20a + 25b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(20a + 25b)=λ(20)a+λ(25)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-8}{20} = -\\frac{2}{5} \\\\\nλ &= \\frac{-10}{25} = -\\frac{2}{5}\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-8a - 10b=-\\frac{2}{5}(20a + 25b).\n$$\n\nTherefore,\n\n$$\nλ=-\\frac{2}{5}\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504753 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b9dcace-dd91-581c-866e-f6d1aa1b2cf3" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504770} {:answer/id #uuid "3bb644e7-b21f-5fce-8ff0-497d610ecaa8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186504775} {:answer/id #uuid "7cf206f0-3208-5daf-92b4-982429991a3e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186504798} {:answer/id #uuid "8355501f-d15e-5901-913e-d30d08a04672" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186504800} {:answer/id #uuid "a3b2c6bf-5dbe-54b3-abdf-e2d66204b501" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186504809}] :answer-field/correct {:answer/id #uuid "3bb644e7-b21f-5fce-8ff0-497d610ecaa8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186504775} :answer-field/id #uuid "64e7c313-092b-5316-b111-b5874ef1f27d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504791}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14ea91d3-f94c-5dd9-b51c-cb8c953c07f2" :question/problem "Given that $-3a - 24b$ and $λ(0.5a + 4b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + 4b)=λ(\\frac{1}{2})a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-3}{\\frac{1}{2}} = -6 \\\\\nλ &= \\frac{-24}{4} = -6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-3a - 24b=-6(\\frac{1}{2}a + 4b).\n$$\n\nTherefore,\n\n$$\nλ=-6\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504768 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3f1c2f-be82-53cd-aff4-7e5521c7167f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186504749} {:answer/id #uuid "2eca6419-7234-51d4-b873-e7f3bd1bacf5" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504772} {:answer/id #uuid "4b4d6bea-566b-5d1a-8261-205958a929e4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186504784} {:answer/id #uuid "6aeefdc9-79a6-53eb-956a-d3afdf335860" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186504794} {:answer/id #uuid "f889768d-c9e5-5cf4-906b-9103278e26a3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186504844}] :answer-field/correct {:answer/id #uuid "4b4d6bea-566b-5d1a-8261-205958a929e4" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186504784} :answer-field/id #uuid "7de5c44f-68ff-569f-b35c-cf4b217b5b0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504799}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "281e43ed-d77f-5100-ba06-3efb56464379" :question/problem "Given that $λ(0.25a - 3b)$ and $-a + 12b$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{4}a - 3b)=λ(\\frac{1}{4})a+λ(-3)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{4}} = -4 \\\\\nλ &= \\frac{12}{-3} = -4\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a + 12b=-4(\\frac{1}{4}a - 3b).\n$$\n\nTherefore,\n\n$$\nλ=-4\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504773 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41e50957-4074-51ce-b3ce-a17bd4649d40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186504781} {:answer/id #uuid "5dbf4a4b-2962-57b0-8fa0-f9e9c906d3a4" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504788} {:answer/id #uuid "8f15975b-3796-5103-bca7-e86cdd8b32d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186504804} {:answer/id #uuid "b3e8ed52-49b8-5508-83f2-0a518221e17d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186504814} {:answer/id #uuid "e6534378-b2e2-53ba-bb3b-f131517f27d4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{9}" :db/id #edb/ref 17592186504831}] :answer-field/correct {:answer/id #uuid "41e50957-4074-51ce-b3ce-a17bd4649d40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186504781} :answer-field/id #uuid "a5afbb7d-33d0-521b-8a95-85f1371b282e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504810}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "315d6a79-c820-530f-a728-86a6ee67757a" :question/problem "Given that $18a + 45b$ and $λ(4a + 10b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(4a + 10b)=λ(4)a+λ(10)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{18}{4} = \\frac{9}{2} \\\\\nλ &= \\frac{45}{10} = \\frac{9}{2}\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n18a + 45b=\\frac{9}{2}(4a + 10b).\n$$\n\nTherefore,\n\n$$\nλ=\\frac{9}{2}\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504780 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5e0638-98ae-509c-9732-628564357b11" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186504758} {:answer/id #uuid "1f0b57e6-adad-5ab1-b50c-baa08f8436f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186504759} {:answer/id #uuid "57ec9105-4d5a-545d-a1cc-a71a9c8d87ed" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186504785} {:answer/id #uuid "b784a5ac-2080-54be-91d4-3c1c534d613e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186504817} {:answer/id #uuid "ecf54d7b-b43e-54a1-a798-50b6c290222d" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504836}] :answer-field/correct {:answer/id #uuid "1e5e0638-98ae-509c-9732-628564357b11" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186504758} :answer-field/id #uuid "ba1896a9-56b0-5883-99fb-7c31d7375589" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504818}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "40a6d99d-54df-5f7a-8a53-416c89a4a6f9" :question/problem "Given that $-16a - 12b$ and $λ(20a + 15b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(20a + 15b)=λ(20)a+λ(15)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-16}{20} = -\\frac{4}{5} \\\\\nλ &= \\frac{-12}{15} = -\\frac{4}{5}\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-16a - 12b=-\\frac{4}{5}(20a + 15b).\n$$\n\nTherefore,\n\n$$\nλ=-\\frac{4}{5}\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504802 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a70bf55-c653-524c-80de-799ed5e85c32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186504748} {:answer/id #uuid "24002d8c-909b-5291-810c-e5b512ab3ea8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186504763} {:answer/id #uuid "861a84cc-037d-5823-98fb-0e7916753da5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186504801} {:answer/id #uuid "be08b6ee-3f5b-5095-bf94-57faac71a3a2" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504819} {:answer/id #uuid "d3462742-b08a-59ec-a6bb-6da7af0a2bac" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186504825}] :answer-field/correct {:answer/id #uuid "24002d8c-909b-5291-810c-e5b512ab3ea8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186504763} :answer-field/id #uuid "259cab0a-d5bb-5b13-95b4-7e9853cbe78f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504765}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "88ca6c0b-f159-58fc-adb2-cf4950ce3bfd" :question/problem "Given that $λ(3a + 4b)$ and $12a + 16b$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(3a + 4b)=λ(3)a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{12}{3} = 4 \\\\\nλ &= \\frac{16}{4} = 4\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n12a + 16b=4(3a + 4b).\n$$\n\nTherefore,\n\n$$\nλ=4\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504803 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2438aff0-ab25-5493-acd3-16779c6d559a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186504764} {:answer/id #uuid "3e5ef801-76a2-5b16-8649-284183c85297" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504778} {:answer/id #uuid "b10cffa3-7a64-5e77-8731-6a69b0a734f9" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186504812} {:answer/id #uuid "dd13527d-060a-54b9-87d8-6313be05ca35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186504828} {:answer/id #uuid "f99c1385-74f7-5705-afdf-249eede8f4bb" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186504846}] :answer-field/correct {:answer/id #uuid "b10cffa3-7a64-5e77-8731-6a69b0a734f9" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186504812} :answer-field/id #uuid "44f8d74d-ea99-52f5-8a02-cff10be0fe8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8a8aa6aa-79a2-59ee-8afa-533036e8e56c" :question/problem "Given that $λ(3a - 4b)$ and $18a - 24b$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(3a - 4b)=λ(3)a+λ(-4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{18}{3} = 6 \\\\\nλ &= \\frac{-24}{-4} = 6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n18a - 24b=6(3a - 4b).\n$$\n\nTherefore,\n\n$$\nλ=6\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504821 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157ebf7b-87d9-5d09-aeb5-68c2d360d505" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186504756} {:answer/id #uuid "657a483d-6ec3-5f79-94a7-b33528b25a40" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186504792} {:answer/id #uuid "7ca084b1-1ff1-5c1e-93e7-86baea3b3290" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504797} {:answer/id #uuid "d0dbfd45-c1e7-5e0e-b182-bd0217a71902" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186504823} {:answer/id #uuid "f75d0b77-0554-5d4c-8d8f-338361e0988a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186504842}] :answer-field/correct {:answer/id #uuid "657a483d-6ec3-5f79-94a7-b33528b25a40" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186504792} :answer-field/id #uuid "a62569f9-1eb8-5cf2-b8c2-b9c0f68eb327" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c06fdca4-9c0f-5aba-ba3a-3f0cefff0623" :question/problem "Given that $24a - 8b$ and $λ(3a - b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(3a - b)=λ(3)a+λ(-1)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{24}{3} = 8 \\\\\nλ &= \\frac{-8}{-1} = 8\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n24a - 8b=8(3a - b).\n$$\n\nTherefore,\n\n$$\nλ=8\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504832 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d92bf8b-f09a-519e-b6c2-297a8dbbae50" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186504757} {:answer/id #uuid "6742f50f-0fc1-5cef-9bfc-a345a595db6d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186504793} {:answer/id #uuid "a142d2dd-1c1e-5f0b-b6cf-e6016f0ff340" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186504808} {:answer/id #uuid "b2bea5f0-8a2f-5d26-b298-26810baae035" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186504813} {:answer/id #uuid "fd39139a-489f-500a-bb43-0430f464ded4" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504847}] :answer-field/correct {:answer/id #uuid "b2bea5f0-8a2f-5d26-b298-26810baae035" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186504813} :answer-field/id #uuid "eac2129e-641b-514b-a9a0-d474e422aab9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504833}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e813b171-b626-57db-af36-b0b2e170a174" :question/problem "Given that $λ(0.5a + 3b)$ and $-a - 6b$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + 3b)=λ(\\frac{1}{2})a+λ(3)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{2}} = -2 \\\\\nλ &= \\frac{-6}{3} = -2\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a - 6b=-2(\\frac{1}{2}a + 3b).\n$$\n\nTherefore,\n\n$$\nλ=-2\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504834 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11675813-ef33-5580-b5ab-30b652a490b8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186504751} {:answer/id #uuid "15575bb1-404d-573f-85cf-f099718e2695" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186504755} {:answer/id #uuid "2068a15d-57fe-589b-bbea-12398cf6bab3" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504761} {:answer/id #uuid "2d633287-3811-5793-aa83-ebad1786ab20" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186504771} {:answer/id #uuid "f3077d42-9f95-5118-81b0-e2f6ad381a3b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186504840}] :answer-field/correct {:answer/id #uuid "2d633287-3811-5793-aa83-ebad1786ab20" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186504771} :answer-field/id #uuid "27d995d1-9ec5-5de8-a531-1e7d78674b54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504767}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eb65d9fd-5b96-51a4-9bed-d3ab5895f629" :question/problem "Given that $4a - 8b$ and $λ(a - 2b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(a - 2b)=λ(1)a+λ(-2)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{4}{1} = 4 \\\\\nλ &= \\frac{-8}{-2} = 4\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n4a - 8b=4(a - 2b).\n$$\n\nTherefore,\n\n$$\nλ=4\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504837 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f927563-2459-5ab2-a433-1d0bcc56501a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186504760} {:answer/id #uuid "3df795cb-3775-5285-979a-53c11ed67b7b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186504776} {:answer/id #uuid "b4b02e26-0c96-5600-a671-78953befb292" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186504815} {:answer/id #uuid "d2dd740e-8630-5b84-9ac8-60031c08dffa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186504824} {:answer/id #uuid "f89d7f4b-7c08-50f7-b89e-b637afb86374" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504845}] :answer-field/correct {:answer/id #uuid "1f927563-2459-5ab2-a433-1d0bcc56501a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186504760} :answer-field/id #uuid "ec83554b-4ed5-5e70-8946-c6697faa6c4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504835}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f051a23b-4fb5-55c6-8552-3b7f053713a4" :question/problem "Given that $λ(3a + 12b)$ and $-5a - 20b$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(3a + 12b)=λ(3)a+λ(12)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-5}{3} = -\\frac{5}{3} \\\\\nλ &= \\frac{-20}{12} = -\\frac{5}{3}\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-5a - 20b=-\\frac{5}{3}(3a + 12b).\n$$\n\nTherefore,\n\n$$\nλ=-\\frac{5}{3}\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504838 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03bd2dae-9f93-5a40-8d4b-eef040995cd1" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186504744} {:answer/id #uuid "363e5073-dc2e-5bbf-8201-fe87b22042bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186504774} {:answer/id #uuid "3e2d54b2-1153-5fc4-9a0e-c048e849ed9e" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504777} {:answer/id #uuid "5fd349ad-f11c-561b-b033-1a228c5244e4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186504789} {:answer/id #uuid "b507226d-14fb-5b7f-9ec4-42ba988fbde3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186504816}] :answer-field/correct {:answer/id #uuid "5fd349ad-f11c-561b-b033-1a228c5244e4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186504789} :answer-field/id #uuid "22efb133-43d7-5ecd-b9af-451a0d3ef57a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504762}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0dc3593-c754-5805-816a-41c4fccabc8f" :question/problem "Given that $3a + 24b$ and $λ(0.5a + 4b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + 4b)=λ(\\frac{1}{2})a+λ(4)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{3}{\\frac{1}{2}} = 6 \\\\\nλ &= \\frac{24}{4} = 6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n3a + 24b=6(\\frac{1}{2}a + 4b).\n$$\n\nTherefore,\n\n$$\nλ=6\n$$\n\nThe two non-zero vectors are parallel. Their directions are the same because the factor is positive."} {:db/id #edb/ref 17592186504839 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "150e0fae-7ea0-5e55-aa28-b1cf2c56b250" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186504754} {:answer/id #uuid "63109784-3c77-52c6-a07b-5fa548fbd809" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186504790} {:answer/id #uuid "6e8036ee-262d-5fb7-9adf-3a8cb2f1b4ff" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186504795} {:answer/id #uuid "8fad182c-2996-57a2-982a-7cc91e8a14de" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186504805} {:answer/id #uuid "bf945500-ba30-51dc-a6bf-5f492b1428ad" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504820}] :answer-field/correct {:answer/id #uuid "6e8036ee-262d-5fb7-9adf-3a8cb2f1b4ff" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186504795} :answer-field/id #uuid "291021b9-5572-5413-9bb4-fde113118354" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504769}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0e435c8-cd66-5b3b-b59e-c0b5f48a6d99" :question/problem "Given that $-a - 2b$ and $λ(0.5a + b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(\\frac{1}{2}a + b)=λ(\\frac{1}{2})a+λ(1)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-1}{\\frac{1}{2}} = -2 \\\\\nλ &= \\frac{-2}{1} = -2\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-a - 2b=-2(\\frac{1}{2}a + b).\n$$\n\nTherefore,\n\n$$\nλ=-2\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."} {:db/id #edb/ref 17592186504841 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02744260-786b-581b-bebf-224559456963" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186504743} {:answer/id #uuid "09936ac2-1ed8-53d0-82ca-5a6b53627566" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186504747} {:answer/id #uuid "12e7b76d-5e1e-5390-a739-e2782334a3f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186504752} {:answer/id #uuid "5af6bbb3-8848-549e-95e8-a2f91e265cff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186504786} {:answer/id #uuid "d351f425-30a0-5241-b6f1-d174fd4ad59a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186504826}] :answer-field/correct {:answer/id #uuid "09936ac2-1ed8-53d0-82ca-5a6b53627566" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186504747} :answer-field/id #uuid "f7982156-61e4-5ee2-9ad6-4fd386440c55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186504843}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f58264c5-b24b-55b5-b334-1e81505cb790" :question/problem "Given that $-24a + 6b$ and $λ(4a - b)$ are equal (non-zero) vectors, find the scale factor $λ$." :question/worked-solution "Notice that\n\n$$\nλ(4a - b)=λ(4)a+λ(-1)b.\n$$\n\nThe same scale factor must multiply the whole non-zero vector. Comparing the two coefficients gives\n\n$$\n\\begin{aligned}\nλ &= \\frac{-24}{4} = -6 \\\\\nλ &= \\frac{6}{-1} = -6\n\\end{aligned}\n$$\n\nNotice that\n\n$$\n-24a + 6b=-6(4a - b).\n$$\n\nTherefore,\n\n$$\nλ=-6\n$$\n\nThe two non-zero vectors are parallel. Their directions are opposite because the factor is negative."}] :knowledge-point/title "Determining Whether Two Vectors are Parallel"}]}
