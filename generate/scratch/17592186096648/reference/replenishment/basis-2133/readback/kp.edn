#{[{:db/id #edb/ref 17592186096648 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096445 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/id #uuid "069b2882-f4a9-589f-a903-4e89d077cd85" :question/math-academy-id "e-4279" :question/problem "Suppose, $\\mathbf{a} \\neq \\mathbf{0}$ and $\\mathbf{b} \\neq \\mathbf{0}$. Given that $7\\mathbf{a}+14\\mathbf{b}$ and $\\lambda \\left(3\\mathbf{a}+6\\mathbf{b} \\right)$ are equal vectors, find the scalar factor $\\lambda$." :question/worked-solution "Notice that\n\n$$\n7\\mathbf{a}+14\\mathbf{b}= \\dfrac{7}{3} (3\\mathbf{a}+6\\mathbf{b})\n$$\n\nTherefore,\n\n$$\n\\lambda=\\dfrac{7}{3}\n$$"} :knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186051079}] :knowledge-point/question-generator {:db/id #edb/ref 17592186504848 :question-generator/id #uuid "7d18fadd-926e-5ea0-82ac-e7e894e439e5" :question-generator/script "generate/scratch/17592186096648.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097030 :knowledge-point/_questions [{:knowledge-point/id #uuid "27d5c96d-ca13-5c1e-83d3-0dc9f6da0f83" :knowledge-point/title "Determining Whether Two Vectors are Parallel"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9baa3219-e5ec-524d-ad2c-2cbd42340400" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186094154} {:answer/id #uuid "cfb4a605-3985-519c-8727-624a59fc1822" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186094155} {:answer/id #uuid "126be9dc-c4b5-539e-a882-43d7b90deeee" :answer/type {:db/ident :answer.type/text} :answer/value "No such $λ$" :db/id #edb/ref 17592186094156} {:answer/id #uuid "4c760e90-e2a0-509b-8ac9-fbffc078956e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 1759