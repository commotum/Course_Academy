-3))^{2} & ={8}^{2} \\\\ (x+2)^{2}+(y+3)^{2} & =64.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561455 :knowledge-point/_questions [{:knowledge-point/id #uuid "82d6988b-3220-578f-ba1c-cd86b9e3dbf9" :knowledge-point/title "Finding the Equation of a Circle Given the Center and the Radius"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fffa964-0c5d-5367-882a-37b3c5037713" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+4)^{2}=\\frac{49}{16}" :db/id #edb/ref 17592186561461} {:answer/id #uuid "24cb3f01-9a76-506d-ab3d-42942c2d3586" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+4)^{2}=\\frac{49}{16}" :db/id #edb/ref 17592186561466} {:answer/id #uuid "59dc7adf-29fb-58bf-bfc7-aa685892268e" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-4)^{2}=\\frac{7}{4}" :db/id #edb/ref 17592186561478} {:answer/id #uuid "c7113c23-1067-5a12-ab61-0e4785025a96" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-4)^{2}=\\frac{49}{16}" :db/id #edb/ref 17592186561514} {:answer/id #uuid "e8e7bc64-654c-5b65-ae5b-4883088dc630" :answer/type {:db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y-4)^{2}=\\frac{49}{16}" :db/id #edb/ref 17592186561521}] :answer-field/correct {:answer/id #uuid "c7113c23-1067-5a12-ab61-0e4785025a96" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-4)^{2}=\\frac{49}{16}" :db/id #edb/ref 17592186561514} :answer-field/id #uuid "83292d95-cf93-5acc-8655-45bf8bc97864" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561497}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "06e629ab-c275-55a6-813f-9310bf8a4b4b" :question/problem "![](images/f2/f2aba916c2a8e1513a9d1f79bbb6820559e188d3166ba9d4323cce018491f74d.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a 