ent :answer.type/math} :answer/value "(x + 2)^{2} + (y - 5)^{2} = 7" :db/id #edb/ref 17592186085907}] :answer-field/id #uuid "d070a38b-bc69-519e-9a20-5b9484c4ef9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085902}] :question/id #uuid "e11496b7-2fc3-5c53-8069-22f2e85621c0" :question/math-academy-id "q-54210" :question/problem "![](images/94/941552af685a46484581668a04525b2eaf863db242f6e797dcda8b2c3cbf4ca3.png)\n\nWhat is the equation of the circle given above?"} {:db/id #edb/ref 17592186235496 :knowledge-point/_questions [{:knowledge-point/id #uuid "82d6988b-3220-578f-ba1c-cd86b9e3dbf9" :knowledge-point/title "Finding the Equation of a Circle Given the Center and the Radius"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ea6a32f-49ef-57a9-b429-d346d779f130" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+{y}^{2}=9" :db/id #edb/ref 17592186234691}] :answer-field/correct {:answer/id #uuid "5ea6a32f-49ef-57a9-b429-d346d779f130" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}+{y}^{2}=9" :db/id #edb/ref 17592186234691} :answer-field/id #uuid "455de079-3c57-5a2c-b063-2ae6c0d12dd7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235041}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70fc8621-7b34-535c-a0b8-10d27db72e32" :question/math-academy-id "q-167932" :question/problem "Write the equation of this circle in the form $(x-a)^{2}+(y-b)^{2}={r}^{2}.$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "The equation of a circle with radius $r$  centered at the point $(a,b)$ in rectangular coordinates in standard form is\n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nIn our case, the circle is centered at $(3,0)$ and the radius of the circle is $r=3$, so\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y-0)^{2} & ={3}^{2} \\\\ (x-3)^{2}+{y}^{2} & =9.\\end{aligned}\n$$\n\nFinally, the equation of the circle in rectangular coordinates is \n\n$$\n(x-3)^{2}+{y}^{2}=9.\n$$"} {:db/id #edb/ref 17592186253292 :knowledge-point/_questions [{:knowledge-point/id #uuid "82d6988b-3220-578f-ba1c-cd86b9e3dbf9" :knowledge-point/title "Finding the Equation of a Circle Given the Center and the Radius"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f753d8c-60a5-57f8-bdf7-1dfca23922c0" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}+(y-3)^{2}=\\sqrt{6}" :db/id #edb/ref 17592186250687} {:answer/id #uuid "194d005a-074c-5528-8e5a-5c077edd8e76" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}+(y+3)^{2}=6" :db/id #edb/ref 17592186250774} {:answer/id #uuid "315ac89d-372a-5365-ae8a-8dbdf9c4b3ef" :answer/type {:db/ident :answer.type/math} :answer/value "(x+4)^{2}+(y+3)^{2}=36" :db/id #edb/ref 17592186250971} {:answer/id #uuid "85cecc42-57d3-50a8-a690-6891b14e42dc" :answer/type {:db/ident :answer.type/math} :answer/value "(x+4)^{2}+(y-3)^{2}=6" :db/id #edb/ref 17592186251673} {:answer/id #uuid "b9e225b3-c9f2-51bf-8ede-3befd132f224" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}+(y-3)^{2}=36" :db/id #edb/ref 17592186252187}] :answer-field/correct {:answer/id #uuid "315ac89d-372a-5365-ae8a-8dbdf9c4b3ef" :answer/type {:db/ident :answer.type/math} :answer/value "(x+4)^{2}+(y+3)^{2}=36" :db/id #edb/ref 17592186250971} :answ