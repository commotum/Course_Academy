      "question": {
        ":question/id": "a70ea0d9-6a8c-5712-ad03-f4df6d15bd66",
        ":question/problem": "![](images/88/887895a47cf6ce3a6f109f754ef0c46eecaa6d68763baf3a696008e014d231af.png)\n\nWhat is the equation of the circle given above?",
        ":question/answer-fields": [
          {
            ":answer-field/id": "6c89d594-634b-5efd-b983-4748663d448f",
            ":answer-field/key": "selection",
