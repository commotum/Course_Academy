              ":answer/id": "ad6dbdba-d35d-5c59-a8ec-0feaf774a414",
              ":answer/type": ":answer.type/math",
              ":answer/value": "- 7 x \\ln{\\left(x \\right)} + 1"
            }
          ]
        }
      ]
    },
