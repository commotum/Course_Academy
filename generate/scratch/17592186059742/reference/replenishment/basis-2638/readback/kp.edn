bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 & 6 \\\\ -6 & 4 & -4\\end{bmatrix}+\\begin{bmatrix}6 & -6 & 0 \\\\ 0 & 5 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2+6 & -4+(-6) & 6+0 \\\\ -6+0 & 4+5 & -4+5\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -10 & 6 \\\\ -6 & 9 & 1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547229 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21415536-23b5-59e3-b3ea-d2ed034e1e04" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & 12 \\\\ 12 & 21\\end{bmatrix}" :db/id #edb/ref 17592186547208} {:answer/id #uuid "a3de1af3-e6e5-57b3-889d-08829b8e9a78" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 12 \\\\ 6 & 15\\end{bmatrix}" :db/id #edb/ref 17592186547245} {:answer/id #uuid "b0252dde-f6db-5f88-95eb-edcaba77af5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 9 & 9\\end{bmatrix}" :db/id #edb/ref 17592186547247} {:answer/id #uuid "dfe18c6c-39e1-5a08-b2f0-70d2a2308cb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & 4 \\\\ 10 & 13\\end{bmatrix}" :db/id #edb/ref 17592186547262} {:answer/id #uuid "ec45fb1e-b5d0-517d-b656-51b14794a691" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 12 \\\\ -6 & 3\\end{bmatrix}" :db/id #edb/ref 17592186547267}] :answer-field/correct {:answer/id #uuid "21415536-23b5-59e3-b3ea-d2ed034e1e04" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & 12 \\\\ 12 & 21\\end{bmatrix}" :db/id #edb/ref 17592186547208} :answer-field/id #uuid "e0360ddf-4985-5e81-917f-7b37d4e65c4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547263}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61a4a43b-2316-5eb2-b7e7-4471b6fedae0" :question/problem "Calculate $3B+3M$, where\n$B=\\begin{bmatrix}2 & 4 \\\\ 1 & 4\\end{bmatrix}$\nand\n$M=\\begin{bmatrix}2 & 0 \\\\ 3 & 3\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $B$ by $3$ and each entry of $M$ by $3,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}3B+3M & =3\\begin{bmatrix}2 & 4 \\\\ 1 & 4\\end{bmatrix}+3\\begin{bmatrix}2 & 0 \\\\ 3 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 2 & 3\\cdot 4 \\\\ 3\\cdot 1 & 3\\cdot 4\\end{bmatrix}+\\begin{bmatrix}3\\cdot 2 & 3\\cdot 0 \\\\ 3\\cdot 3 & 3\\cdot 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 12 \\\\ 3 & 12\\end{bmatrix}+\\begin{bmatrix}6 & 0 \\\\ 9 & 9\\end{bmatrix} \\\\  & =\\begin{bmatrix}6+6 & 12+0 \\\\ 3+9 & 12+9\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & 12 \\\\ 12 & 21\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547244 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae69670-06e2-546c-8cd4-887e558707c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 15 \\\\ -15 & 2\\end{bmatrix}" :db/id #edb/ref 17592186547213} {:answer/id #uuid "3bb6cd12-fb0e-5bb8-a24d-c5a488ba4189" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 12 \\\\ -12 & 0\\end{bmatrix}" :db/id #edb/ref 17592186547217} {:answer/id #uuid "8e8f91d2-fde3-5d2a-83cf-7da3d5c22812" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547236} {:answer/id #uuid "b37fb170-4635-5979-8641-e083ac238d5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 6 \\\\ -6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547249} {:answer/id #uuid "ecaaabc2-e475-523a-ac9d-e35f29c3309f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 & -18 \\\\ 18 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547268}] :answer-field/correct {:answer/id #uuid "b37fb170-4635-5979-8641-e083ac238d5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 6 \\\\ -6 & -4\\end{bmatrix}" :db/id #edb/ref 17592186547249} :answer-field/id #uuid "c2b0de36-d947-517b-ac5f-9d13a5c03976" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547253}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1f995aa-a3a0-5af5-ac63-b17fbecfcac6" :question/problem "Calculate $-2Q+4G$, where\n$Q=\\begin{bmatrix}-2 & 3 \\\\ -3 & 2\\end{bmatrix}$\nand\n$G=\\begin{bmatrix}-1 & 3 \\\\ -3 & 0\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $Q$ by $-2$ and each entry of $G$ by $4,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}-2Q+4G & =(-2)\\begin{bmatrix}-2 & 3 \\\\ -3 & 2\\end{bmatrix}+4\\begin{bmatrix}-1 & 3 \\\\ -3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-2)\\cdot (-2) & (-2)\\cdot 3 \\\\ (-2)\\cdot (-3) & (-2)\\cdot 2\\end{bmatrix}+\\begin{bmatrix}4\\cdot (-1) & 4\\cdot 3 \\\\ 4\\cdot (-3) & 4\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & -6 \\\\ 6 & -4\\end{bmatrix}+\\begin{bmatrix}-4 & 12 \\\\ -12 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4+(-4) & -6+12 \\\\ 6+(-12) & -4+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 6 \\\\ -6 & -4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547248 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "299a064b-3bc4-547b-a7d0-c24eca4b4deb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 8 \\\\ 8 & 10\\end{bmatrix}" :db/id #edb/ref 17592186547212} {:answer/id #uuid "3ff42622-2f7e-56ba-8321-981bcc0a144f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 4 \\\\ 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186547218} {:answer/id #uuid "9a864b72-cebb-5676-996e-e69c04ff80a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 14 \\\\ 14 & 13\\end{bmatrix}" :db/id #edb/ref 17592186547240} {:answer/id #uuid "b9a5dd37-1aa8-541a-92dc-3f6ead400d51" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 & 16 \\\\ 16 & 14\\end{bmatrix}" :db/id #edb/ref 17592186547251} {:answer/id #uuid "f92aa0cf-ac0d-5ca5-8b3e-26f7bcc67c3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & 8 \\\\ 8 & 6\\end{bmatrix}" :db/id #edb/ref 17592186547272}] :answer-field/correct {:answer/id #uuid "b9a5dd37-1aa8-541a-92dc-3f6ead400d51" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}18 & 16 \\\\ 16 & 14\\end{bmatrix}" :db/id #edb/ref 17592186547251} :answer-field/id #uuid "cb89f7b2-852b-5f5c-9519-ac2c1cad12e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547256}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0adea88-04cc-5a53-88af-e806dd44e698" :question/problem "Calculate $3L+2M$, where\n$L=\\begin{bmatrix}4 & 4 \\\\ 4 & 4\\end{bmatrix}$\nand\n$M=\\begin{bmatrix}3 & 2 \\\\ 2 & 1\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $L$ by $3$ and each entry of $M$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}3L+2M & =3\\begin{bmatrix}4 & 4 \\\\ 4 & 4\\end{bmatrix}+2\\begin{bmatrix}3 & 2 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 4 & 3\\cdot 4 \\\\ 3\\cdot 4 & 3\\cdot 4\\end{bmatrix}+\\begin{bmatrix}2\\cdot 3 & 2\\cdot 2 \\\\ 2\\cdot 2 & 2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}12 & 12 \\\\ 12 & 12\\end{bmatrix}+\\begin{bmatrix}6 & 4 \\\\ 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}12+6 & 12+4 \\\\ 12+4 & 12+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}18 & 16 \\\\ 16 & 14\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547255 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f58c3564-dfde-564b-9a65-0870c4a0305b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186547270}] :answer-field/correct {:answer/id #uuid "f58c3564-dfde-564b-9a65-0870c4a0305b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186547270} :answer-field/id #uuid "100cc00a-fae2-5238-bed5-cb9e46fec419" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547199} {:answer-field/choices [{:answer/id #uuid "b8efa023-82e2-5d1f-a36c-fdbdaf7e5bad" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186547250}] :answer-field/correct {:answer/id #uuid "b8efa023-82e2-5d1f-a36c-fdbdaf7e5bad" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186547250} :answer-field/id #uuid "137004b2-1c1d-55c4-a9eb-f5faa779850a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547201} {:answer-field/choices [{:answer/id #uuid "fa01f361-fbca-5b4d-8c1d-05b48448c57d" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186547274}] :answer-field/correct {:answer/id #uuid "fa01f361-fbca-5b4d-8c1d-05b48448c57d" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186547274} :answer-field/id #uuid "2b68b469-2cdb-55e7-ab51-a9324a7ac5d9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547214} {:answer-field/choices [{:answer/id #uuid "856dcb98-d967-5b1d-8c6b-c3d8bd1c9255" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186547234}] :answer-field/correct {:answer/id #uuid "856dcb98-d967-5b1d-8c6b-c3d8bd1c9255" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186547234} :answer-field/id #uuid "bae56912-3dcd-5133-95e4-a1ca766e27ae" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186547252}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c90cd801-8b18-54b6-8ab2-396380c16785" :question/problem "Calculate $4P-\\frac{1}{2}H$, where\n$P=\\begin{bmatrix}4 & -3 & 1 & 0\\end{bmatrix}$\nand\n$H=\\begin{bmatrix}4 & 4 & 2 & 0\\end{bmatrix}.$\n\n| $4P-\\frac{1}{2}H=\\,\\,$ |  | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} |  |\n| --- | --- | --- | --- | --- | --- | --- |" :question/worked-solution "We multiply each entry of $P$ by $4$ and each entry of $H$ by $\\frac{1}{2},$ and then subtract the resulting matrices, as follows:\n\n$$\n\\begin{aligned}4P-\\frac{1}{2}H & =4\\begin{bmatrix}4 & -3 & 1 & 0\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}4 & 4 & 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4\\cdot 4 & 4\\cdot (-3) & 4\\cdot 1 & 4\\cdot 0\\end{bmatrix}-\\begin{bmatrix}\\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 2 & \\frac{1}{2}\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 & -12 & 4 & 0\\end{bmatrix}-\\begin{bmatrix}2 & 2 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}16-2 & -12-2 & 4-1 & 0-0\\end{bmatrix} \\\\  & =\\begin{bmatrix}14 & -14 & 3 & 0\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}]}
