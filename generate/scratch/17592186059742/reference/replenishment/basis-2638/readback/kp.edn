ix} \\\\  & =\\begin{bmatrix}\\frac{2}{3}\\cdot (-3) & \\frac{2}{3}\\cdot (-3) & \\frac{2}{3}\\cdot (-9) \\\\ \\frac{2}{3}\\cdot 18 & \\frac{2}{3}\\cdot (-3) & \\frac{2}{3}\\cdot 0\\end{bmatrix}+\\begin{bmatrix}2\\cdot (- \\frac{3}{2}) & 2\\cdot 3 & 2\\cdot (- \\frac{3}{2}) \\\\ 2\\cdot (-3) & 2\\cdot 2 & 2\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -2 & -6 \\\\ 12 & -2 & 0\\end{bmatrix}+\\begin{bmatrix}-3 & 6 & -3 \\\\ -6 & 4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2-3 & -2+6 & -6-3 \\\\ 12-6 & -2+4 & 0+2\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 4 & -9 \\\\ 6 & 2 & 2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547223 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cda33be-f4c6-5358-b97c-ac509dfe5e84" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 33 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547221} {:answer/id #uuid "4dc9bf0f-6dcb-5d38-bdaa-cdb63cc04f58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186547222} {:answer/id #uuid "70680470-4943-58cd-932c-8ed0d4edfaa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ -9 & 0\\end{bmatrix}" :db/id #edb/ref 17592186547231} {:answer/id #uuid "719f4497-e045-5232-a000-2c042474f432" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 0 \\\\ 21 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547232} {:answer/id #uuid "8b10ff0b-61b8-501e-81b1-d9002a417dca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 \\\\ 15 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547235}] :answer-field/correct {:answer/id #uuid "8b10ff0b-61b8-501e-81b1-d9002a417dca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}9 & 0 \\\\ 15 & 24\\end{bmatrix}" :db/id #edb/ref 17592186547235} :answer-field/id #uuid "1ba1a1ce-69bf-5937-bd9e-5f3def9e7216" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186547204}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f8a4836-e75f-52bc-a172-eb28bcaeb8fe" :question/problem "Calculate $6P + 3H$, where\n$P = \\begin{bmatrix}1 & 0 \\\\ 4 & 4\\end{bmatrix}$\nand\n$H = \\begin{bmatrix}1 & 0 \\\\ -3 & 0\\end{bmatrix}$." :question/worked-solution "We multiply each entry of $P$ by $6$ and each entry of $H$ by $3,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}6P+3H & =6\\begin{bmatrix}1 & 0 \\\\ 4 & 4\\end{bmatrix}+3\\begin{bmatrix}1 & 0 \\\\ -3 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6\\cdot 1 & 6\\cdot 0 \\\\ 6\\cdot 4 & 6\\cdot 4\\end{bmatrix}+\\begin{bmatrix}3\\cdot 1 & 3\\cdot 0 \\\\ 3\\cdot (-3) & 3\\cdot 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 0 \\\\ 24 & 24\\end{bmatrix}+\\begin{bmatrix}3 & 0 \\\\ -9 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}6+3 & 0+0 \\\\ 24+(-9) & 24+0\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 & 0 \\\\ 15 & 24\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186547224 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "619d859d-4f28-5536-a30a-b46d88e73aad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -7 & 6 \\\\ -6 & \\frac{13}{2} & - \\frac{3}{2}\\end{bmatrix}" :db/id #edb/ref 17592186547228} {:answer/id #uuid "7fa25f9c-43f4-5e03-8838-05a42ceb0d4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -12 & 9 \\\\ -9 & 11 & -1\\end{bmatrix}" :db/id #edb/ref 17592186547233} {:answer/id #uuid "ce902fb3-52f3-563a-83