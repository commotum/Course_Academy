ix}-2 & -1 \\\\ -1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186056349} {:answer/id #uuid "3785ad8e-c918-5f2c-84e5-6405e776ff0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 \\\\ -7 & 1\\end{bmatrix}" :db/id #edb/ref 17592186056350} {:answer/id #uuid "77dc669a-92cd-5dfc-bb25-c0e866cb78c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 \\\\ -1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186056351}] :answer-field/id #uuid "8891db65-2fde-5e37-9cd6-bc6e54cd03d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056346}] :question/id #uuid "f34dbc7a-866c-5249-b5bf-151f1e0c08b3" :question/math-academy-id "q-11536" :question/problem "Calculate $2P - 3Q$, where\n$P = \\begin{bmatrix}2 & 1 \\\\ -2 & -1\\end{bmatrix}$\nand\n$Q = \\begin{bmatrix}2 & 1 \\\\ 1 & -1\\end{bmatrix}$."} {:db/id #edb/ref 17592186233218 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43036e7c-a70a-56a3-8bee-031be9fe31b1" :question/math-academy-id "q-11532" :question/problem "Calculate $2H-3L$, where\n$H=\\begin{bmatrix}3 & -2 \\\\ 2 & -1\\end{bmatrix}$\nand\n$L=\\begin{bmatrix}0 & 1 \\\\ 2 & 1\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $H$ by $2$ and each entry of $L$ by $3,$ and then subtract the resulting matrices, as follows:\n\n$$\n\\begin{aligned}2H-3L & =2\\begin{bmatrix}3 & -2 \\\\ 2 & -1\\end{bmatrix}-3\\begin{bmatrix}0 & 1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}2\\cdot 3 & 2\\cdot (-2) \\\\ 2\\cdot 2 & 2\\cdot (-1)\\end{bmatrix}-\\begin{bmatrix}3\\cdot 0 & 3\\cdot 1 \\\\ 3\\cdot 2 & 3\\cdot 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & -4 \\\\ 4 & -2\\end{bmatrix}-\\begin{bmatrix}0 & 3 \\\\ 6 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6-0 & -4-3 \\\\ 4-6 & -2-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & -7 \\\\ -2 & -5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250392 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01083aba-7159-5668-975e-80fd900b5e13" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 & 9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186247420} {:answer/id #uuid "25a32a75-2be4-5aa0-b7ac-0758260d6b2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & -9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186247757} {:answer/id #uuid "67ac8976-5d43-5318-81df-5210173a511d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ 9 & -4\\end{bmatrix}" :db/id #edb/ref 17592186248354} {:answer/id #uuid "d50f4c89-9a1c-5ecd-b1ad-84d3afaca026" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ -4 & -9\\end{bmatrix}" :db/id #edb/ref 17592186249310} {:answer/id #uuid "f3fb4e17-2411-5b2c-9459-b5e5cb8fcd2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186249560}] :answer-field/correct {:answer/id #uuid "f3fb4e17-2411-5b2c-9459-b5e5cb8fcd2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}" :db/id #edb/ref 17592186249560} :answer-field/id #uuid "23d63a3b-d0b6-52cd-ba9b-48dd82439260" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249732}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e51b6e2d-bb1c-588d-8de2-5ed3d6ef6bca" :question/math-academy-id "q-11531" :question/problem "Calculate $3F+\\frac{1}{2}G$, where\n$F=\\begin{bmatrix}1 & 3 \\\\ -2 & 2\\end{bmatrix}$\nand\n$G=\\begin{bmatrix}2 & 0 \\\\ 4 & 6\\end{bmatrix}.$" :question/worked-solution "We multiply each entry of $F$ by $3$ and each entry of $G$ by $\\frac{1}{2},$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}3F+\\frac{1}{2}G & =3\\begin{bmatrix}1 & 3 \\\\ -2 & 2\\end{bmatrix}+\\frac{1}{2}\\begin{bmatrix}2 & 0 \\\\ 4 & 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}3\\cdot 1 & 3\\cdot 3 \\\\ 3\\cdot (-2) & 3\\cdot 2\\end{bmatrix}+\\begin{bmatrix}\\frac{1}{2}\\cdot 2 & \\frac{1}{2}\\cdot 0 \\\\ \\frac{1}{2}\\cdot 4 & \\frac{1}{2}\\cdot 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 9 \\\\ -6 & 6\\end{bmatrix}+\\begin{bmatrix}1 & 0 \\\\ 2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3+1 & 9+0 \\\\ -6+2 & 6+3\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 9 \\\\ -4 & 9\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262575 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d01278-cb84-5f5d-a32b-b98ca83a321c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -1 \\\\ -5 & 2\\end{bmatrix}" :db/id #edb/ref 17592186260074} {:answer/id #uuid "a75df9e5-ef98-5f15-a399-833d4c5f611f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 3 \\\\ 3 & -4\\end{bmatrix}" :db/id #edb/ref 17592186261335} {:answer/id #uuid "b146748e-e256-5c6d-9fa5-662f3fd71470" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & -5 \\\\ -4 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261440} {:answer/id #uuid "b80aadfb-906c-533d-99bd-4de8a4b77396" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & -5 \\\\ -5 & 4\\end{bmatrix}" :db/id #edb/ref 17592186261489} {:answer/id #uuid "ee25100e-908f-5ac7-adb9-fa6