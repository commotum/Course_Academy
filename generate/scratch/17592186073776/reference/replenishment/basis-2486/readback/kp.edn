c7-dc47-5ae4-88f3-b0e4338d63a9" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186070372} {:answer/id #uuid "f7cb9713-fa2b-59a2-b51d-c8360c95fceb" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186070373}] :answer-field/id #uuid "59fc212c-55f0-5857-8850-50ee3e15dd2f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186070370}] :question/id #uuid "a43ef3b0-9627-5633-9a33-9830700deff8" :question/math-academy-id "q-237046" :question/problem "Consider the following system of equations:\n\n${2x - 5y = 15; 4x - 10y =-10$\n\nThis system of equations has {{field-1}}."} {:db/id #edb/ref 17592186529261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ee3752b-c151-5d7c-b459-269e7a440470" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529275} {:answer/id #uuid "ad343ca9-8ee8-59ee-8492-d87f4e5767a3" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529312} {:answer/id #uuid "afaa3c2f-68a9-5e46-b525-4af2bb7fbccd" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529314}] :answer-field/correct {:answer/id #uuid "ad343ca9-8ee8-59ee-8492-d87f4e5767a3" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529312} :answer-field/id #uuid "431a38a6-e58c-5853-ad1f-a6fc6bb01e65" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529269}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "17e3609b-1396-5685-843a-74d27fdadf0f" :question/problem "Consider the following system of equations:\n\n$\\{-2x + y = 6; x - 2y = 6$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $2$, then we will get a $2x$ term that can cancel with the $-2x$ term in the first equation:\n\n$$\n\\{-2x + y = 6; x - 2y = 6 \\mid \\mid \\cdot (2)\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-2x + y &= 6 \\\\\n2x - 4y &= 12 \\\\\n-3y &= (6 + 12) \\\\\n-3y &= 18 \\\\\ny &= -6\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-2x + (1)(-6) &= 6 \\\\\n-2x &= 12 \\\\\nx &= -6\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(-6,-6)$."} {:db/id #edb/ref 17592186529263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71a19f9f-c97f-5b22-a3fb-3ddd84649033" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529285} {:answer/id #uuid "7968a19d-81e4-508f-8ec6-11e1b7db0381" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529288} {:answer/id #uuid "cd558f16-0c95-5532-85ce-16a34dea6a67" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529319}] :answer-field/correct {:answer/id #uuid "7968a19d-81e4-508f-8ec6-11e1b7db0381" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529288} :answer-field/id #uuid "a88aecce-0e48-579b-8ac8-fffb289b1a69" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "22c76199-015b-5355-8da5-51b3e4eb6386" :question/problem "Consider the following system of equations:\n\n$\\{y + 2x + 4 = 0; 4y - 4x + 9 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n2x + y &= -4 \\\\\n-4x + 4y &= -9\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the second equation:\n\n$$\n\\{2x + y = -4 \\mid \\mid \\cdot (2); -4x + 4y = -9\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n4x + 2y &= -8 \\\\\n-4x + 4y &= -9 \\\\\n6y &= (-8 - 9) \\\\\n6y &= -17 \\\\\ny &= - \\frac{17}{6}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n2x + (1)(- \\frac{17}{6}) &= -4 \\\\\n2x &= - \\frac{7}{6} \\\\\nx &= - \\frac{7}{12}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{7}{12},- \\frac{17}{6})$."} {:db/id #edb/ref 17592186529265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "344db828-cf79-52e5-a777-8ab84b874966" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529268} {:answer/id #uuid "95396471-ccc2-5ee9-a8d6-43bc15e844c2" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529298} {:answer/id #uuid "dcdd0cde-b36f-54e5-a018-7db85e9b5a1f" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529324}] :answer-field/correct {:answer/id #uuid "344db828-cf79-52e5-a777-8ab84b874966" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529268} :answer-field/id #uuid "65b4752f-c56d-5617-8e96-0a2d7a4fd12a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529281}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "27a6ba63-3c85-5feb-bfac-b122a5e9f9a3" :question/problem "Consider the following system of equations:\n\n$\\{-4x + 4y = -9; 2x - y = -4$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $2$, then we will get a $4x$ term that can cancel with the $-4x$ term in the first equation:\n\n$$\n\\{-4x + 4y = -9; 2x - y = -4 \\mid \\mid \\cdot (2)\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-4x + 4y &= -9 \\\\\n4x - 2y &= -8 \\\\\n2y &= (-9 - 8) \\\\\n2y &= -17 \\\\\ny &= - \\frac{17}{2}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-4x + (4)(- \\frac{17}{2}) &= -9 \\\\\n-4x &= 25 \\\\\nx &= - \\frac{25}{4}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{25}{4},- \\frac{17}{2})$."} {:db/id #edb/ref 17592186529266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbdb8ad-267a-57e1-90cb-804824fd158a" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529259} {:answer/id #uuid "31e0880c-27b5-5a13-87e6-3705af860da9" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529267} {:answer/id #uuid "8c8210fd-75fb-5771-887f-af1bb8ec8244" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529295}] :answer-field/correct {:answer/id #uuid "8c8210fd-75fb-5771-887f-af1bb8ec8244" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529295} :answer-field/id #uuid "6093ddec-b3cd-5a0b-8a78-bde2db784aa4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529278}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "31a5b8b3-2787-5aca-9212-729c0bca425f" :question/problem "Consider the following system of equations:\n\n$\\{y + 2x + 2 = 0; 4y + 8x + 8 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n2x + y &= -2 \\\\\n8x + 4y &= -8\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-8x$ term that can cancel with the $8x$ term in the second equation:\n\n$$\n\\{2x + y = -2 \\mid \\mid \\cdot (-4); 8x + 4y = -8\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-8x - 4y &= 8 \\\\\n8x + 4y &= -8 \\\\\n0 &= (8 - 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nThe statement $0=0$ is *always true*. Therefore, we conclude that the system has *infinitely many solutions*."} {:db/id #edb/ref 17592186529271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "193a9776-9522-59e8-93fb-4b3bab86a5ac" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529262} {:answer/id #uuid "ac9317b7-c236-5932-99c1-b650c3ecfd60" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529311} {:answer/id #uuid "ece64018-7584-599e-8625-2cc9d1912aa3" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529327}] :answer-field/correct {:answer/id #uuid "ece64018-7584-599e-8625-2cc9d1912aa3" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529327} :answer-field/id #uuid "e77cb455-ca55-5d77-ab3a-caef6fb910d6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529326}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "45038183-ddb8-5749-92cf-2124aeefd6a9" :question/problem "Consider the following system of equations:\n\n$\\{2x + y = 2; 4x + 2y = 5$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-2$, then we will get a $-4x$ term that can cancel with the $4x$ term in the second equation:\n\n$$\n\\{2x + y = 2 \\mid \\mid \\cdot (-2); 4x + 2y = 5\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n-4x - 2y &= -4 \\\\\n4x + 2y &= 5 \\\\\n0 &= (-4 + 5) \\\\\n0 &= 1\n\\end{aligned}\n$$\n\nThe statement $0=1$ is *always false*. Therefore, we conclude that the system has *no solutions*."} {:db/id #edb/ref 17592186529284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a6a9c04-4483-5b31-88cd-fdc0d4f8dfab" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529273} {:answer/id #uuid "6532299d-7242-529d-b584-f2d02d122b29" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529280} {:answer/id #uuid "a3bb91a8-f370-546d-8650-fc4b5ac0f2bc" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529304}] :answer-field/correct {:answer/id #uuid "a3bb91a8-f370-546d-8650-fc4b5ac0f2bc" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529304} :answer-field/id #uuid "571d0d37-8178-57f9-8598-a1a4ba418722" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529277}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6df7ea41-de66-50d4-b68f-ac8978094097" :question/problem "Consider the following system of equations:\n\n$\\{y - 3x + 1 = 0; -3y - 6x - 8 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n-3x + y &= -1 \\\\\n-6x - 3y &= 8\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $-2$, then we will get a $6x$ term that can cancel with the $-6x$ term in the second equation:\n\n$$\n\\{-3x + y = -1 \\mid \\mid \\cdot (-2); -6x - 3y = 8\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n6x - 2y &= 2 \\\\\n-6x - 3y &= 8 \\\\\n-5y &= (2 + 8) \\\\\n-5y &= 10 \\\\\ny &= -2\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-3x + (1)(-2) &= -1 \\\\\n-3x &= 1 \\\\\nx &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{1}{3},-2)$."} {:db/id #edb/ref 17592186529290 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46de5fcd-a47b-5970-9703-3a33b936c273" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529272} {:answer/id #uuid "9f4a900e-af83-5010-a4eb-550d23e0386f" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529302} {:answer/id #uuid "c4bc71c3-edaf-56da-873d-7ff9f6b2544c" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529317}] :answer-field/correct {:answer/id #uuid "9f4a900e-af83-5010-a4eb-550d23e0386f" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529302} :answer-field/id #uuid "defa217b-2cb1-5a93-8730-0a2de2c923fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529325}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7b1e2d9a-93ed-5edd-af89-794105a0828b" :question/problem "Consider the following system of equations:\n\n$\\{2x - 3y = 10; 2x - y = 6$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-1$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\{2x - 3y = 10 \\mid \\mid \\cdot (-1); 2x - y = 6\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-2x + 3y &= -10 \\\\\n2x - y &= 6 \\\\\n2y &= (-10 + 6) \\\\\n2y &= -4 \\\\\ny &= -2\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n2x + (-3)(-2) &= 10 \\\\\n2x &= 4 \\\\\nx &= 2\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(2,-2)$."} {:db/id #edb/ref 17592186529293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d893df7-d857-5192-90ce-47a99d5c6bf8" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529274} {:answer/id #uuid "60bc4533-01cd-595e-9372-f185d24aa9f1" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529279} {:answer/id #uuid "6ce6a4fc-25b3-542c-aed5-70e5fdd4a918" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529283}] :answer-field/correct {:answer/id #uuid "4d893df7-d857-5192-90ce-47a99d5c6bf8" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529274} :answer-field/id #uuid "7aa9bc9c-c996-5d30-bb22-558885c83ec4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529289}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "878a99ca-9540-5195-b258-8e98913442f4" :question/problem "Consider the following system of equations:\n\n$\\{2x - y = -2; 8x - 4y = -8$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-8x$ term that can cancel with the $8x$ term in the second equation:\n\n$$\n\\{2x - y = -2 \\mid \\mid \\cdot (-4); 8x - 4y = -8\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-8x + 4y &= 8 \\\\\n8x - 4y &= -8 \\\\\n0 &= (8 - 8) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nThe statement $0=0$ is *always true*. Therefore, we conclude that the system has *infinitely many solutions*."} {:db/id #edb/ref 17592186529294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aedf24db-2200-5c34-82c8-69e05734e790" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529313} {:answer/id #uuid "d688773d-636f-5a54-b4ee-355c9f396330" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529321} {:answer/id #uuid "f2dee143-55db-5cf5-83a5-24cd943aae58" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529329}] :answer-field/correct {:answer/id #uuid "f2dee143-55db-5cf5-83a5-24cd943aae58" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529329} :answer-field/id #uuid "f5171cd4-7721-5fe2-926b-265c33c00b33" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529330}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "88e09a62-e93a-583d-86c5-5caff22bdcbd" :question/problem "Consider the following system of equations:\n\n$\\{3x + y = 0; -3x + 5y = -2$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $1$, then we will get a $3x$ term that can cancel with the $-3x$ term in the second equation:\n\n$$\n\\{3x + y = 0 \\mid \\mid \\cdot (1); -3x + 5y = -2\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n3x + y &= 0 \\\\\n-3x + 5y &= -2 \\\\\n6y &= (0 - 2) \\\\\n6y &= -2 \\\\\ny &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n3x + (1)(- \\frac{1}{3}) &= 0 \\\\\n3x &= \\frac{1}{3} \\\\\nx &= \\frac{1}{9}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(\\frac{1}{9},- \\frac{1}{3})$."} {:db/id #edb/ref 17592186529306 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26412d41-7859-567a-8d0b-616fdfaae78b" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529264} {:answer/id #uuid "7ebeb28b-d7e8-58ed-a1ac-c3da8dc6de13" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529291} {:answer/id #uuid "ede703e4-312f-541c-9af9-a20919d7afce" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529328}] :answer-field/correct {:answer/id #uuid "7ebeb28b-d7e8-58ed-a1ac-c3da8dc6de13" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529291} :answer-field/id #uuid "43939bab-211c-5b1e-9dcd-127b5f8c732a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529270}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a7d7084c-4c14-5312-a22d-dc6fe1986a2c" :question/problem "Consider the following system of equations:\n\n$\\{-3x - y = 8; 3x + y = -6$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $1$, then we will get a $-3x$ term that can cancel with the $3x$ term in the second equation:\n\n$$\n\\{-3x - y = 8 \\mid \\mid \\cdot (1); 3x + y = -6\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n-3x - y &= 8 \\\\\n3x + y &= -6 \\\\\n0 &= (8 - 6) \\\\\n0 &= 2\n\\end{aligned}\n$$\n\nThe statement $0=2$ is *always false*. Therefore, we conclude that the system has *no solutions*."} {:db/id #edb/ref 17592186529307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5289c2-ae65-5854-8e71-5b033554cd5f" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529258} {:answer/id #uuid "81a01f27-1606-571b-a96b-5a5040320fbd" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529292} {:answer/id #uuid "9d492ab7-1bb8-5fc1-8c03-1d65e9d953d6" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529301}] :answer-field/correct {:answer/id #uuid "9d492ab7-1bb8-5fc1-8c03-1d65e9d953d6" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529301} :answer-field/id #uuid "a2ae9c90-b5af-556d-b9c0-2e84879f0db0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529303}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a81cacd7-ddb8-5f18-91b0-0d7142c96649" :question/problem "Consider the following system of equations:\n\n$\\{y - 3x - 4 = 0; -2y + 12x + 10 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n-3x + y &= 4 \\\\\n12x - 2y &= -10\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $4$, then we will get a $-12x$ term that can cancel with the $12x$ term in the second equation:\n\n$$\n\\{-3x + y = 4 \\mid \\mid \\cdot (4); 12x - 2y = -10\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-12x + 4y &= 16 \\\\\n12x - 2y &= -10 \\\\\n2y &= (16 - 10) \\\\\n2y &= 6 \\\\\ny &= 3\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-3x + (1)(3) &= 4 \\\\\n-3x &= 1 \\\\\nx &= - \\frac{1}{3}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{1}{3},3)$."} {:db/id #edb/ref 17592186529309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e4adab-f965-574b-b1b2-5412f0ac4030" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529257} {:answer/id #uuid "174a23c4-66b4-574b-ab16-58c635103256" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529260} {:answer/id #uuid "dbf0dc60-cd74-50bb-bbf6-488567b34736" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529323}] :answer-field/correct {:answer/id #uuid "174a23c4-66b4-574b-ab16-58c635103256" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529260} :answer-field/id #uuid "da21e2ad-53b7-539d-8fc6-d73ab8480a65" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529322}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a93a39cc-73b6-5e4b-80a4-1282a4d64974" :question/problem "Consider the following system of equations:\n\n$\\{y + 3x + 6 = 0; -4y - 12x - 26 = 0$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nFirst, rearrange each equation to put the variable terms on the left and the constant on the right:\n\n$$\n\\begin{aligned}\n3x + y &= -6 \\\\\n-12x - 4y &= 26\n\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $4$, then we will get a $12x$ term that can cancel with the $-12x$ term in the second equation:\n\n$$\n\\{3x + y = -6 \\mid \\mid \\cdot (4); -12x - 4y = 26\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n12x + 4y &= -24 \\\\\n-12x - 4y &= 26 \\\\\n0 &= (-24 + 26) \\\\\n0 &= 2\n\\end{aligned}\n$$\n\nThe statement $0=2$ is *always false*. Therefore, we conclude that the system has *no solutions*."} {:db/id #edb/ref 17592186529316 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72bba841-9529-5598-b921-f90b8dffbe5b" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529286} {:answer/id #uuid "b27078db-ea72-5bd8-9115-2ea5343e2f7b" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529315} {:answer/id #uuid "f96540d7-0eb1-5d77-a5ce-3fa81473a266" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529331}] :answer-field/correct {:answer/id #uuid "b27078db-ea72-5bd8-9115-2ea5343e2f7b" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529315} :answer-field/id #uuid "6c1fbec3-c232-5078-a580-2f08b5aa37e3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529282}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c0b2af50-0676-5686-aa21-aed280aaa725" :question/problem "Consider the following system of equations:\n\n$\\{-x - 5y = -12; x - 3y = -2$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $1$, then we will get a $-x$ term that can cancel with the $x$ term in the second equation:\n\n$$\n\\{-x - 5y = -12 \\mid \\mid \\cdot (1); x - 3y = -2\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-x - 5y &= -12 \\\\\nx - 3y &= -2 \\\\\n-8y &= (-12 - 2) \\\\\n-8y &= -14 \\\\\ny &= \\frac{7}{4}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\n-x + (-5)(\\frac{7}{4}) &= -12 \\\\\n-x &= - \\frac{13}{4} \\\\\nx &= \\frac{13}{4}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(\\frac{13}{4},\\frac{7}{4})$."} {:db/id #edb/ref 17592186529318 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f5d6e30-8e43-5909-9e9a-3a9af82fd1e7" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529297} {:answer/id #uuid "9c1af611-f1dc-57a7-b4ff-1cd30b5d58d9" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529300} {:answer/id #uuid "a979b510-0d7a-5573-bce5-5f77d85dffa4" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529310}] :answer-field/correct {:answer/id #uuid "8f5d6e30-8e43-5909-9e9a-3a9af82fd1e7" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529297} :answer-field/id #uuid "8eaf5b55-2fa9-5c35-a346-66798bb8f61b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529296}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c5970b8b-793c-585b-9c66-c8937f9714fc" :question/problem "Consider the following system of equations:\n\n$\\{x - 3y = -6; 4x - y = -12$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-4$, then we will get a $-4x$ term that can cancel with the $4x$ term in the second equation:\n\n$$\n\\{x - 3y = -6 \\mid \\mid \\cdot (-4); 4x - y = -12\n$$\n\nWhen we add the two equations, the $x$ terms cancel, and we can solve for $y$:\n\n$$\n\\begin{aligned}\n-4x + 12y &= 24 \\\\\n4x - y &= -12 \\\\\n11y &= (24 - 12) \\\\\n11y &= 12 \\\\\ny &= \\frac{12}{11}\n\\end{aligned}\n$$\n\nSubstituting into the first equation gives:\n\n$$\n\\begin{aligned}\nx + (-3)(\\frac{12}{11}) &= -6 \\\\\nx &= - \\frac{30}{11} \\\\\nx &= - \\frac{30}{11}\n\\end{aligned}\n$$\n\nThe system has *a single solution*, $(- \\frac{30}{11},\\frac{12}{11})$."} {:db/id #edb/ref 17592186529320 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fb0b299-f16e-54c2-a393-40d6eef9a51c" :answer/type {:db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186529276} {:answer/id #uuid "97b495fd-486c-5329-aea6-b7fef9362dc9" :answer/type {:db/ident :answer.type/text} :answer/value "a single solution" :db/id #edb/ref 17592186529299} {:answer/id #uuid "a66f4ab0-02ae-5f53-884d-c689e9f292e2" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529305}] :answer-field/correct {:answer/id #uuid "a66f4ab0-02ae-5f53-884d-c689e9f292e2" :answer/type {:db/ident :answer.type/text} :answer/value "infinitely many solutions" :db/id #edb/ref 17592186529305} :answer-field/id #uuid "766ff9b6-bfc6-59ad-af1f-7918abd24f91" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186529287}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d4bc3484-819e-515d-b935-6bb887858fab" :question/problem "Consider the following system of equations:\n\n$\\{2x - y = 4; 2x - y = 4$\n\nThis system of equations has {{field-1}}." :question/worked-solution "Let's start by solving the system using elimination.\n\nNotice that if we multiply the first equation by $-1$, then we will get a $-2x$ term that can cancel with the $2x$ term in the second equation:\n\n$$\n\\{2x - y = 4 \\mid \\mid \\cdot (-1); 2x - y = 4\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-2x + y &= -4 \\\\\n2x - y &= 4 \\\\\n0 &= (-4 + 4) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nThe statement $0=0$ is *always true*. Therefore, we conclude that the system has *infinitely many solutions*."}] :knowledge-point/title "Finding the Number of Solutions to a System"}]}
