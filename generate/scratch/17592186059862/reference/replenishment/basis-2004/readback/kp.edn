#{[{:db/id #edb/ref 17592186059862 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059441 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/id #uuid "e52f80d1-431d-51a0-9c51-950dc1a91065" :question/math-academy-id "e-138" :question/problem "Find the derivative of $f(x) = 6x^3$." :question/worked-solution "We apply the constant multiple and power rules, as follows:\n\n$$\n\\begin{aligned}\nf^{′}(x) &= \\frac{d}{dx}(6x^{3}) \\\\\n&= 6 \\cdot \\frac{d}{dx}(x^{3}) \\\\\n&= 6 \\cdot 3x^{2} \\\\\n&= 18x^{2}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593}] :knowledge-point/question-generator {:db/id #edb/ref 17592186494276 :question-generator/id #uuid "f6a5942c-0303-52ae-b08e-b1612b538707" :question-generator/script "generate/scratch/17592186059862.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060005 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88cdd62d-36a3-56b4-ad53-5ef4ae1b675a" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{7}" :db/id #edb/ref 17592186056389} {:answer/id #uuid "e1dfa5e4-a09b-590b-9c48-2a9d810b3a97" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{6}" :db/id #edb/ref 17592186056390} {:answer/id #uuid "f534d307-ad17-5cc0-a5e0-fb7193d9c6a6" :answer/type {:db/ident :answer.type/math} :answer/value "36x^{5}" :db/id #edb/ref 17592186056391} {:answer/id #uuid "20aee839-3ad1-51cc-a0bc-0bfaa6c0cf8d" :answer/type {:db/ident :answer.type/math} :answer/value "42x^{7}" :db/id #edb/ref 17592186056392} {:answer/id #uuid "49e38165-fae8-5b78-8583-4b4