17592186494235}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2107573-5dd9-5ec0-aece-60a9576c7d2f" :question/problem "Find the derivative of $f(x) = 8x^{9}$." :question/worked-solution "We apply the constant multiple and power rules, as follows:\n\n$$\n\\begin{aligned}\nf^{′}(x) &= \\frac{d}{dx}(8x^{9}) \\\\\n&= 8 \\cdot \\frac{d}{dx}(x^{9}) \\\\\n&= 8 \\cdot 9x^{8} \\\\\n&= 72x^{8}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186494268 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38c9f0a0-5dd0-51b3-9962-ec4ef67ecbf1" :answer/type {:db/ident :answer.type/math} :answer/value "17x^{5}" :db/id #edb/ref 17592186494233} {:answer/id #uuid "4d41ebae-1de7-5ada-9662-398883f7232f" :answer/type {:db/ident :answer.type/math} :answer/value "330x^{4}" :db/id #edb/ref 17592186494237} {:answer/id #uuid "572e21bb-bda7-51b3-b440-dd50f8ac9b1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11x^{7}}{6}" :db/id #edb/ref 17592186494240} {:answer/id #uuid "670527a0-c07b-5803-8457-28f66c9e97e8" :answer/type {:db/ident :answer.type/math} :answer/value "66x^{6}" :db/id #edb/ref 17592186494244} {:answer/id #uuid "c485a2a0-0af4-511e-8e5c-e34d2c2a1065" :answer/type {:db/ident :answer.type/math} :answer/value "66x^{5}" :db/id #edb/ref 17592186494261}] :answer-field/correct {:answer/id #uuid "c485a2a0-0af4-511e-8e5c-e34d2c2a1065" :answer/type {:db/ident :answer.type/math} :answer/value "66x^{5}" :db/id #edb/ref 17592186494261} :answer-field/id #uuid "91f53f82-0ac2-546a-ab66-f02a9fadebfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494255}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #u