a Power Function Using the Constant Multiple Rule"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ff473d5-a7de-5679-980c-c5fa4e5df5b9" :question/math-academy-id "q-10289" :question/problem "Find the derivative of  $f(x)=4{x}^{6}.$" :question/worked-solution "We apply the constant multiple and power rules, as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{6}) \\\\  & =4\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{6}) \\\\  & =4\\cdot 6{x}^{6-1} \\\\  & =24{x}^{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233469 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326746f8-b33a-5b7e-b97c-e73b697c6c97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186232198}] :answer-field/correct {:answer/id #uuid "326746f8-b33a-5b7e-b97c-e73b697c6c97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186232198} :answer-field/id #uuid "01e0d94b-00e1-582c-a13d-ce25783110ad" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186232197}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9342c495-5eb7-5bb2-becb-1daa8a37b8ad" :question/math-academy-id "q-142993" :question/problem "Find the derivative of $h(x).$\n\n${h}^{'}(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}y}{\\text{d}x}(\\frac{2}{3}\\sqrt{x}+3) \\\\  & =\\frac{2}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{2}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{2}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{1}{3}{x}^{-1/2} \\\\  & =\\frac{1}{3\\sqrt{x}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235441 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "472578a9-1d04-5190-ac9b-0d6d0342ccc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}" :db/id #edb/ref 17592186234653}] :answer-field/correct {:answer/id #uuid "472578a9-1d04-5190-ac9b-0d6d0342ccc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}" :db/id #edb/ref 17592186234653} :answer-field/id #uuid "5aa42daf-2adf-549a-849f-ae4b622f98c0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba3e5599-fc73-5d06-ba59-ef92cf39216b" :question/math-academy-id "q-167561" :question/problem "Find the derivative of $g(x).$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${g}^{′}(x)\\,=\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}y}{\\text{d}x}(2\\sqrt{x}-1) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =2\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & ={x}^{-1/2} \\\\  & =\\frac{1}{\\sqrt{x}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186494230 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffc1d505-17e4-5b0f-9150-506f9edb3350" :knowledge-point/title "Differentiating a Power Function Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "751ad24d-0145-5e78-b80a-5d65d0f7d999" :answer/type {:db/ident :answer.type/math} :answer/value "72x^{8}" :db/id #edb/ref 17592186494246} {:answer/id #uuid "90007b3e-d937-59b8-828d-5e7b72653874" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9x^{9}}{8}" :db/id #edb/ref 17592186494254} {:answer/id #uuid "a172e6a2-e474-564e-a9fa-1e25f4e55894" :answer/type {:db/ident :answer.type/math} :answer/value "17x^{7}" :db/id #edb/ref 17592186494257} {:answer/id #uuid "af35926b-fc60-5f65-922e-481b85e63449" :answer/type {:db/ident :answer.type/math} :answer/value "72x^{7}" :db/id #edb/ref 17592186494259} {:answer/id #uuid "d1223562-411e-570b-ae4d-04ad29e7a2f9" :answer/type {:db/ident :answer.type/math} :answer/value "504x^{6}" :db/id #edb/ref 17592186494265}] :answer-field/correct {:answer/id #uuid "af35926b-fc60-5f65-922e-481b85e63449" :answer/type {:db/ident :answer.type/math} :answer/value "72x^{7}" :db/id #edb/ref 17592186494259} :answer-field/id #uuid "4fdf2d60-1e42-5361-a0fe-cf1568a06b2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186494238}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15e2127d-c098-5e67-83ab-b40de632e719" :question/proble