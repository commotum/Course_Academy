      ":question/id": "7b5ecd4a-071c-5b82-81cd-d8156d4440c5",
      ":question/problem": "Find the derivative of $g(x)=\\frac{1}{3}\\sqrt{x}+3.$\n\n${g}^{′}(x)\\,=\\,$\n{{field-1}}",
      ":question/worked-solution": "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}\\sqrt{x}+3) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{1}{6}{x}^{-1/2} \\\\  & =\\frac{\\frac{1}{6}}{\\sqrt{x}}\\end{aligned}\n$$",
      ":question/difficulty": ":question.difficulty/moderate",
      ":question/answer-fields": [
        {
          ":answer-field/id": "a4767e1d-c3a7-5c38-9c4a-85621be24365",
          ":answer-field/key": "field-1",
          ":answer-field/type": ":answer-field.type/blank",
          ":answer-field/choices": [
            {
              ":answer/id": "28444a4f-c868-5fd4-ac98-afeb78a758b2",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\frac{1}{6}}{\\sqrt{x}}"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "28444a4f-c868-5fd4-ac98-afeb78a758b2"
