4})" 13194139535922 17592186045443 true] [17592186542511 1082 #edb/ref 17592186045498 13194139535922 17592186045443 true] [17592186542511 1083 #uuid "ff7fd8bf-f7d2-584f-a1df-b2f38182412f" 13194139535922 17592186045443 true] [17592186542512 1075 #edb/ref 17592186542459 13194139535922 17592186045443 true] [17592186542512 1075 #edb/ref 17592186542461 13194139535922 17592186045443 true] [17592186542512 1075 #edb/ref 17592186542484 13194139535922 17592186045443 true] [17592186542512 1075 #edb/ref 17592186542502 13194139535922 17592186045443 true] [17592186542512 1075 #edb/ref 17592186542506 13194139535922 17592186045443 true] [17592186542512 1076 #edb/ref 17592186045493 13194139535922 17592186045443 true] [17592186542512 1077 "selection" 13194139535922 17592186045443 true] [17592186542512 1078 #edb/ref 17592186542461 13194139535922 17592186045443 true] [17592186542512 1079 #uuid "ffc4aaed-af07-5113-8443-30d9a263ac17" 13194139535922 17592186045443 true] [17592186542513 1168 "generate/scratch/17592186073778.py" 13194139535922 17592186045443 true] [17592186542513 1169 #uuid "d5afc560-f76b-53cb-8503-781e13a207d4" 13194139535922 17592186045443 true]] :edb/tempids {"0052794e-29d0-5a14-847c-4f8656980f5a" 17592186542432 "0473f996-4e92-58c5-bd48-4ace42741c79" 17592186542433 "088c2bc7-791c-5d33-989e-2db1686f3a99" 17592186542434 "0b630dc7-b870-5e2b-85ac-37faee98683d" 17592186542435 "0bf547af-6a9e-5a7b-a100-571509ee17b5" 17592186542436 "0c60e70b-96f8-5431-90cd-a6ae562c2fa4" 17592186542437 "0e35757a-2c57-5eb8-9b8e-33ffed7823b1" 17592186542438 "0eef6127-aaa5-5be2-ac0e-d2adcd5bbbc7" 17592186542439 "0f8a0b2e-30d5-55be-9faa-704ff5f10ec6" 17592186542440 "10860ce5-13d5-5537-a83d-c826703c2441" 17592186542441 "111bc200-5458-59e4-8bff-0e4766f93526" 17592186542442 "1265d20a-0e86-57c1-9549-b3dffb34e245" 17592186542443 "1a28e7ec-e71a-5f77-bd2b-aee856b5039c" 17592186542444 "1ade77da-f05d-59b2-a201-6a199f319be8" 17592186542445 "1bbc4b58-5af2-531c-9f2a-e95c4507960c" 17592186542446 "1cef499e-0ec5-53