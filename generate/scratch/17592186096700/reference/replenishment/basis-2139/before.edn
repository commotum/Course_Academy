c7973aa8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186439577} {:answer/id #uuid "5d01b2ab-7947-576d-a108-bee40c7176e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186439578}] :answer-field/correct {:answer/id #uuid "77818547-036e-5820-90b3-2805c7973aa8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186439577} :answer-field/id #uuid "8f8b99d4-02e8-53c0-9851-f767bd829299" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186440146} {:answer-field/choices [{:answer/id #uuid "5cd7760c-3ab9-5ce4-b194-04b0897302d7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186439579} {:answer/id #uuid "bea02789-2ee5-5084-aa10-6e1747bdc77e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186439580}] :answer-field/correct {:answer/id #uuid "bea02789-2ee5-5084-aa10-6e1747bdc77e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186439580} :answer-field/id #uuid "164f90e5-4d4c-530e-a141-6cc552db0d81" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186440147} {:answer-field/choices [{:answer/id #uuid "9a5338da-66b0-55a8-93b3-d42420152e64" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186439581} {:answer/id #uuid "4a084fd2-e4fd-5068-8fe0-3868139f3e38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186439582}] :answer-field/correct {:answer/id #uuid "9a5338da-66b0-55a8-93b3-d42420152e64" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186439581} :answer-field/id #uuid "99ef090e-1ed2-5454-81c0-7319d1f4e5d7" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186440148}] :question/id #uuid "5602d163-6088-5c26-9dd7-db2402561aee" :question/math-academy-id "q-20404" :question/problem "![](images/c0/c08ee3645692aa5630bc00d8dcd619fe4e6410b050afb6875339ab0962894ed2.png)\n\nConsider the diagram that is shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $a =-c$\n- **II.** $c =-\\frac{1}{2}a$\n- **III.** $b = d$" :question/worked-solution "The grid gives a=(6,4), c=(-3,-2), b=(-3,-5), d=(3,5). Thus c=-a/2; a=-c and b=d are false."}] :knowledge-point/title "Identifying Parallel Vectors From a Diagram"}
