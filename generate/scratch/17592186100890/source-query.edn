[:find (pull ?kp
 [:db/id :knowledge-point/id :knowledge-point/title
  {:knowledge-point/canonical-example
   [:db/id :question/id :question/math-academy-id :question/problem :question/worked-solution]}
  {[:knowledge-point/questions :limit nil]
   [:db/id :question/id :question/math-academy-id :question/problem :question/worked-solution
    {:question/difficulty [:db/ident]}
    {[:question/answer-fields :limit nil]
     [:db/id :answer-field/id :answer-field/key {:answer-field/type [:db/ident]}
      {:answer-field/correct [:db/id :answer/id :answer/value {:answer/type [:db/ident]}]}
      {[:answer-field/choices :limit nil]
       [:db/id :answer/id :answer/value :answer/feedback {:answer/type [:db/ident]}]}]}]}])
 :in $ ?id
 :where [?kp :knowledge-point/id ?id]]
