#{[{:db/id #edb/ref 17592186064167 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064038 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/title "Finding the Antiderivative of a Monomial"}] :question/id #uuid "368cbbae-4eff-5eff-a8f3-d3e8359447a9" :question/math-academy-id "e-364" :question/problem "Calculate $\\displaystyle \\int x^2 \\,\\textrm d x$." :question/worked-solution "We apply the power rule with $n=2$, and we get\n\n$$\n\\int x^2 \\,\\textrm d x = \\dfrac{x^{2+1}}{2+1} + C = \\dfrac{x^3}{3}+C\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\n\\frac{d}{dx}(\\frac{x^{3}}{3} + C) &=  \\\\\n\\frac{d}{dx}(\\frac{x^{3}}{3}) + \\frac{d}{dx}(C) &=  \\\\\n\\frac{1}{3}\\frac{d}{dx}(x^{3}) + 0 &=  \\\\\n\\frac{1}{3} \\cdot 3x^{2} &=  \\\\\n&= x^{2}✓\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048593}] :knowledge-point/question-generator {:db/id #edb/ref 17592186503877 :question-generator/id #uuid "37c2252a-6248-5e94-8344-c8bd3282a4b2" :question-generator/script "generate/scratch/17592186064167.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186064554 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2a4550c-7ed7-58aa-8928-23dd1cfd0cd7" :knowledge-point/title "Finding the Antiderivative of a Monomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd9ded59-ba65-5176-b8f9-b0abbcde8e5e" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2}" :db/id #edb/ref 17592186061520} {:answer/id #uuid "06876c28-ebd0-5db2-80b3-e9af69ed8c2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}}{2} + C" :db/id #edb/ref 17592186061521} {:answer/id #uuid "1e1c848c-bcad-5a85-903a-9791288e9010" :answer/type {:db/ident :answer.type/math} :answer/value "2 + C" :db/id #edb/ref 17592186061522} {:answer/id #uuid "53a354ab-679e-