6070 17592186045443 true] [17592186563951 1080 "true" 13194139536070 17592186045443 true] [17592186563951 1082 #edb/ref 17592186045499 13194139536070 17592186045443 true] [17592186563951 1083 #uuid "6b2ceec3-2f3e-5f8a-af31-4bf0d30583a4" 13194139536070 17592186045443 true] [17592186563952 1075 #edb/ref 17592186563953 13194139536070 17592186045443 true] [17592186563952 1075 #edb/ref 17592186563955 13194139536070 17592186045443 true] [17592186563952 1076 #edb/ref 17592186408166 13194139536070 17592186045443 true] [17592186563952 1077 "III" 13194139536070 17592186045443 true] [17592186563952 1078 #edb/ref 17592186563955 13194139536070 17592186045443 true] [17592186563952 1079 #uuid "829c0450-9cce-5651-b5b3-bdafd9e37e3c" 13194139536070 17592186045443 true] [17592186563953 1080 "true" 13194139536070 17592186045443 true] [17592186563953 1082 #edb/ref 17592186045499 13194139536070 17592186045443 true] [17592186563953 1083 #uuid "85b42d95-12ac-5561-8a12-a148b416989e" 13194139536070 17592186045443 true] [17592186563954 1068 #edb/ref 17592186563948 13194139536070 17592186045443 true] [17592186563954 1068 #edb/ref 17592186563950 13194139536070 17592186045443 true] [17592186563954 1068 #edb/ref 17592186563952 13194139536070 17592186045443 true] [17592186563954 1070 #edb/ref 17592186045487 13194139536070 17592186045443 true] [17592186563954 1071 "![](images/a6/a688cf79790cde240a1fabeb768a9500c98e7affc1006c39e35b89582627fb0c.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the elliptic arc is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n\n- ${\\int }_{C}F\\cdot \\text{d}r=0$\n\n- ${\\int }_{-C}F\\cdot \\text{d}r<0$\n\nSelect all that apply." 13194139536070 17592186045443 true] [17592186563954 1072 #uuid "9a540170-78c2-57d7-83ad-e1402d5fe8aa" 13194139536070 17592186045443 true] [17592186563954 1074 "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion  of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. Since the force $F$ acts perpendicular to the motion of the particle as it moves from $A$ to $B,$ it neither helps nor hinders its motion.\n\n![](images/dc/dcc2f364085ccca85e6e6ddd8a5affac51c84f774281b817d4852bd2322bcb1b.png)\n\nSo, ${\\int }_{C}F\\cdot \\text{d}r=0$.\n\n- Statement III is false. If we reverse the orientation of $C,$ the force is still perpendicular to the motion.\n\n![](images/50/508e0ac5f67d7b119ad689ccaede8894268eefe31d9b00f148ddd6bf851de6b4.png)\n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0$.\n\nTherefore, the correct answer is \"II only.\"" 13194139536070 17592186045443 true] [17592186563955 1080 "false" 13194139536070 17592186045443 true] [17592186563955 1082 #edb/ref 17592186045499 13194139536070 17592186045443 true] [17592186563955 1083 #uuid "cc3a70a1-2772-5e12-9e1e-3be31b98e9fd" 13194139536070 17592186045443 true] [17592186563956 1168 "generate/scratch/17592186179742.py" 13194139536070 17592186045443 true] [17592186563956 1169 #uuid "fa511ed8-070e-58d5-b6f6-4ccec24b2206" 13194139536070 17592186045443 true]] :edb/tempids {"16436961-67f5-507a-8527-cfd7be7c22f4" 17592186563946 "33cabe4d-81d5-5ae5-a052-6b0f90339d00" 17592186563947 "343ee5cc-167e-5420-8b88-ea96eee350c3" 17592186563948 "391abf30-e9c8-5c80-9cec-05a5f3751aaf" 17592186563949 "3f0e32b1-d7c9-5fb8-890f-83bcffc9c539" 17592186563950 "6b2ceec3-2f3e-5f8a-af31-4bf0d30583a4" 17592186563951 "829c0450-9cce-5651-b5b3-bdafd9e37e3c" 17592186563952 "85b42d95-12ac-5561-8a12-a148b416989e" 17592186563953 "9a540170-78c2-57d7-83ad