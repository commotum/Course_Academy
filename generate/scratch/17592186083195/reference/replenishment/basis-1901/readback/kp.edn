wer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186369834} {:answer/id #uuid "0aa94db3-9838-5c69-b479-b6f20018374d" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186369835} {:answer/id #uuid "3c2956d9-8c80-503d-9229-cae165e70be6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186369836} {:answer/id #uuid "eb8a7946-143f-591d-8adc-2cd8b5beea49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186369837} {:answer/id #uuid "3a16084d-2b2d-5b1a-b8b5-8ec16f0f7978" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186369838}] :answer-field/correct {:answer/id #uuid "17054bf5-52f5-56f4-9a5d-2be749a6e48d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186369834} :answer-field/id #uuid "44437d5c-4b57-5518-9706-0e146b8ec3fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369833}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51474c0d-3481-5d2e-9a70-04762078286c" :question/math-academy-id "q-152754" :question/problem "${\\int }_{2}^{\\infty }\\frac{1}{4\\sqrt{{t}^{3}}}\\,\\text{d}t=$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{4\\sqrt{{t}^{3}}}\\,\\text{d}t & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{4\\sqrt{{t}^{3}}}\\,\\text{d}t \\\\  & =\\frac{1}{4}{lim}_{a\\to \\infty }{\\int }_{2}^{a}{t}^{-3/2}\\,\\text{d}t \\\\  & =\\frac{1}{4}{lim}_{a\\to \\infty }{[-2{t}^{-1/2}]}_{2}^{a} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt{t}}]}_{2}^{a} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt{a}}-\\frac{1}{\\sqrt{2}}) \\\\  & =-\\frac{1}{2}(0-\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\sqrt{2}}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186370627 :knowledge-point/_questions [{:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab51b940-9e47-5c28-ab31-cf2045c87ddf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370629}] :answer-field/correct {:answer/id #uuid "ab51b940-9e47-5c28-ab31-cf2045c87ddf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370629} :answer-field/id #uuid "bd5dc3c8-4f89-52e4-9fbf-7b1dcf21fbf9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1aa4c968-db06-5f2f-94f2-fe8dae20562b" :question/math-academy-id "q-350324" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{2}^{\\infty }\\frac{16}{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{16}{{x}^{3}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{16}{{x}^{3}}\\,\\text{d}x \\\\  & =16{lim}_{a\\to \\infty }{\\int }_{2}^{a}{x}^{-3}\\,\\text{d}x \\\\  & =16{lim}_{a\\to \\infty }{[(-\\frac{1}{2}{x}^{-2})]}_{2}^{a} \\\\  & =-8\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{x}^{2}}]}_{2}^{a} \\\\  & =-8\\cdot {lim}_{a\\to \\infty }(\\frac{1}{{a}^{2}}-\\frac{1}{{2}^{2}}) \\\\  & =-8(0-\\frac{1}{4}) \\\\  & =2.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit"}]}
