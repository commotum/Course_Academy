edge-point/_questions [{:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e227908-fbbc-5b4a-8f42-0cf97d435896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186330661} {:answer/id #uuid "6b518463-9db4-5b6d-8d6f-b4ca49edc399" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186330915} {:answer/id #uuid "6f15e05a-59f6-5850-8e78-27d40efca2c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186330949} {:answer/id #uuid "9a3adecf-b533-5eaa-b404-216cf5351cf7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186331334} {:answer/id #uuid "de098ac5-694b-5b16-8558-81ba1c162b6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186331912}] :answer-field/correct {:answer/id #uuid "4e227908-fbbc-5b4a-8f42-0cf97d435896" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186330661} :answer-field/id #uuid "4a3d8b9b-2b58-5c5a-b819-9cd644ee883d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7e5736b-250b-5f2d-96b7-c89915cce3dd" :question/math-academy-id "q-5962" :question/problem "${\\int }_{1}^{\\infty }\\frac{3}{{\\theta }^{3}}\\,\\text{d}\\theta =$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{3}{{\\theta }^{3}}\\,\\text{d}\\theta  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{3}{{\\theta }^{3}}\\,\\text{d}\\theta  \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}3{\\theta }^{-3}\\,\\text{d}\\theta  \\\\  & ={lim}_{a\\to \\infty }{[(-\\frac{3}{2}{\\theta }^{-2})]}_{1}^{a} \\\\  & =-\\frac{3}{2}\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{\\theta }^{2}}]}_{1}^{a} \\\\  & =-\\frac{3}{2}\\cdot {lim}_{a\\to \\infty }(\\frac{1}{{a}^{2}}-\\frac{1}{{1}^{2}}) \\\\  & =-\\frac{3}{2}(0-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235372 :knowledge-point/_questions [{:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2f49d51-a569-54b6-8499-614594a99518" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(9/2)" :db/id #edb/ref 17592186234902}] :answer-field/correct {:answer/id #uuid "e2f49d51-a569-54b6-8499-614594a99518" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(9/2)" :db/id #edb/ref 17592186234902} :answer-field/id #uuid "fb66c969-a116-55b7-83c4-7bdad75642f0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235274}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "687b0f0d-b7fc-5c94-b602-200dc9ae2630" :question/math-academy-id "q-128340" :question/problem "${\\int }_{4}^{\\infty }f(x)\\,\\text{d}x=\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "We have\n\n$$\n\\begin{aligned}{\\int }_{4}^{\\infty }f(x)\\,\\text{d}x & ={\\int }_{4}^{\\infty }\\frac{7}{2{x}^{2}-5x-3}\\,\\text{d}x \\\\  & ={\\int }_{4}^{\\infty }\\frac{\\text{d}x}{x-3}-2{\\int }_{4}^{\\infty }\\frac{\\text{d}x}{2x+1}.\\end{aligned}\n$$\n\nLet's calculate the indefinite integral first. We get\n\n$$\n\\begin{aligned}\\int f(x)\\,\\text{d}x & =\\int \\frac{\\text{d}x}{x-3}-2\\int \\frac{\\text{d}x}{2x+1} \\\\  & =\\operatorname{ln}⁡|x-3|-\\operatorname{ln}⁡|2x+1|+C.\\end{aligned}\n$$\n\nWe can simplify the result using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7}{2{x}^{2}-5x-3}\\,\\text{d}x & =\\operatorname{ln}⁡|x-3|-\\operatorname{ln}⁡|2x+1|+C \\\\  & =\\operatorname{ln}⁡|\\frac{x-3}{2x+1}|+C\\end{aligned}\n$$\n\nFinally, the improper integral is\n\n$$\n\\begin{aligned}{\\int }_{4}^{\\infty }\\frac{7}{2{x}^{2}-5x-3}\\,\\text{d}x & ={lim}_{a\\to \\infty }{[\\operatorname{ln}⁡|\\frac{x-3}{2x+1}|]}_{4}^{a} \\\\  & ={lim}_{a\\to \\infty }(\\operatorname{ln}⁡|\\frac{a-3}{2a+1}|-\\operatorname{ln}⁡|\\frac{1}{9}|) \\\\  & ={lim}_{a\\to \\infty }(\\operatorname{ln}⁡|\\frac{1-\\frac{3}{a}}{2+\\frac{1}{a}}|)-\\operatorname{ln}⁡{9}^{-1} \\\\  & =\\operatorname{ln}⁡(\\frac{1}{2})+\\operatorname{ln}⁡9 \\\\  & =\\operatorname{ln}⁡(\\frac{9}{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275290 :knowledge-point/_questions [{:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "211c0aa1-6235-5917-a6e1-5024b33bacec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186272681} {:answer/id #uuid "b2166127-ed32-5ae9-8e8b-999121c80ecf" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186273924} {:answer/id #uuid "c0875150-b445-569b-9956-6c8ff9a35327" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186274056} {:answer/id #uuid "d33934d0-d9e3-5e37-8cf8-5f828c042d18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186274238} {:answer/id #uuid "e1628935-ffab-572a-8b2d-f55a0936921e" :answer/type {:db/ident :answer.type/math} :