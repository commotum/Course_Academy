wer-field/id #uuid "69413196-ca59-537c-b270-83f81dac5f78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057570}] :question/id #uuid "14310796-c50e-535f-830b-a7d5f462ade4" :question/math-academy-id "q-19022" :question/problem "What is the value of $x$ given that $a = ⟨x,-6x, 3⟩, b = ⟨x, 1, 3⟩$ and $a⊥b$?"} {:db/id #edb/ref 17592186237827 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35170554-7491-5b34-9b67-ab6efae808e5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186236152} {:answer/id #uuid "49bebe95-7d8f-5363-8791-a41d117d2f9c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186236287} {:answer/id #uuid "77b5df1a-8495-5220-8d4a-3d2d72b7ceae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186236568} {:answer/id #uuid "84346316-be9d-55ce-ad43-19e661050d2b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186236640} {:answer/id #uuid "9da633c8-52af-507c-8a35-a65c81ee25b6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186236802}] :answer-field/correct {:answer/id #uuid "77b5df1a-8495-5220-8d4a-3d2d72b7ceae" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186236568} :answer-field/id #uuid "3f7b6300-7056-5f11-ba41-499cc6516307" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dfd0ffab-79f2-5643-9530-8f55bce579c3" :question/math-academy-id "q-101417" :question/problem "Let $u=[\\begin{aligned}9 \\\\ 2x\\end{aligned}]$ and $v=[\\begin{aligned}-2 \\\\ x\\end{aligned}].$ Given that $u⊥v$ and $x<0$, find the value of $x.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y} \\\\  & =9\\cdot (-2)+2x\\cdot x \\\\  & =-18+2{x}^{2}.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ -18+2{x}^{2} & =0 \\\\ 2{x}^{2} & =18 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $x<0.$ Therefore, $x=-3.$"} {:db/id #edb/ref 17592186269008 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6896d0d5-0d79-5756-b49d-54e6544b747c" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186267074} {:answer/id #uuid "739434d2-a34f-51ba-85b2-ecb051fb40b5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267159} {:answer/id #uuid "aa9709bd-77ac-5c62-901d-3e693169f7b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186267686} {:answer/id #uuid "d662411b-1715-5ff4-8a35-4927cc146fdd" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186268054} {:answer/id #uuid "d927e205-8536-566a-9f6c-22e1afa9f648" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186268067}] :answer-field/correct {:answer/id #uuid "739434d2-a34f-51ba-85b2-ecb051fb40b5" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267159} :answer-field/id #uuid "a6039b6c-4aa0-5bb3-9ed0-9729597efec4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "214450de-6c4e-5468-90b3-b289da0c12f3" :question/math-academy-id "q-1348" :question/problem "Let $p=[\\begin{aligned}7 \\\\ n\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$ Given that $p⊥q$, find the value of $n.$" :question/worked-solution "We know that $p⊥q$ ($p$ and $q$ are perpendicular) if and only if $p\\cdot q=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y} \\\\  & =7\\cdot 4+n\\cdot (-4) \\\\  & =28-4n.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 28-4n & =0 \\\\ 28 & =4n \\\\ n & =7\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287909 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cdf7785-cbcd-5112-bc95-0ebbc936c864" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{12}" :db/id #edb/ref 17592186285506} {:answer/id #uuid "6c3e8d51-22f5-56d9-bed9-0046f6689fee" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186285779} {:answer/id #uuid "cc2594eb-bee1-5bc9-9567-d9bdbbe0c102" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186286647} {:answer/id #uuid "cd97d40d-cba1-5ada-8396-a11d2d4f6bbe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186286658} {:answer/id #uuid "e137dd90-b672-5a36-ac92-f22334af1df6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186286837}] :answer-field/correct {:answer/id #uuid "cd97d40d-cba1-5ada-8396-a11d2d4f6bbe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{6}" :db/id #edb/ref 17592186286658} :answer-field/id #uuid "126e0055-240c-57c8-bdd7-5831adf2287c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287177}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9064a6be-d660-5dcb-af2d-9691a386096a" :question/math-academy-id "q-19023" :question/problem "Let $g=[\\begin{aligned}{r}^{2} \\\\ -1 \\\\ -6\\end{aligned}]$ and $h=[\\begin{aligned}3 \\\\ {r}^{2} \\\\ 2\\end{aligned}].$ Given that $g⊥h$ and $r<0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 3+(-1)\\cdot {r}^{2}+(-6)\\cdot 2 \\\\  & =3{r}^{2}-{r}^{2}-12 \\\\  & =2{r}^{2}-12.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-12 & =0 \\\\ 2{r}^{2} & =12 \\\\ {r}^{2} & =6 \\\\ r & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $r<0.$ Therefore, $r=-\\sqrt{6}.$"} {:db/id #edb/ref 17592186299660 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "050de492-c23d-5e5a-9515-f5292836bf29" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297577}] :answer-field/correct {:answer/id #uuid "050de492-c23d-5e5a-9515-f5292836bf29" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297577} :answer-field/id #uuid "af74f5ad-0374-5f9e-bd30-ae2ff4e64785" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299231}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6840a760-5144-5da8-bd56-8faedecfd9c9" :question/math-academy-id "q-317932" :question/problem "If $c=[\\begin{aligned}k \\\\ 2k \\\\ 4\\end{aligned}],$ $d=[\\begin{aligned}-3 \\\\ 2 \\\\ 2\\end{aligned}],$ and $c⊥d,$ then $k=${{field-1}}." :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+2k\\cdot 2+4\\cdot 2 \\\\  & =-3k+4k+8 \\\\  & =k+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ k+8 & =0 \\\\ k & =-8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299664 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc42bda9-d3c0-5507-b933-0b2f39398215" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298373}] :answer-field/correct {:answer/id #uuid "bc42bda9-d3c0-5507-b933-0b2f39398215" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298373} :answer-field/id #uuid "a0941247-a978-51c6-9a76-00d8d070c636" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299169}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d22ee02b-54e6-511a-8cc5-59280c888981" :question/math-academy-id "q-317945" :question/problem "Let $a=⟨2{x}^{2},-4⟩$ and $b=⟨8,4⟩.$ If $a⊥b$ and $x>0,$ then $x=${{field-1}}." :question/worked-solution "We know that $a⊥b$ ($a$ and $b$ are perpendicular) if and only if $a\\cdot b=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y} \\\\  & =2{x}^{2}\\cdot 8+(-4)\\cdot 4 \\\\  & =16{x}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 16{x}^{2}-16 & =0 \\\\ 16{x}^{2} & =16 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $x>0.$ Therefore, $x=1.$"} {:db/id #edb/ref 17592186345278 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bb6caf7-964e-584f-8548-449063ff8736" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186342474} {:answer/id #uuid "5c6655fa-a76a-596f-a2ad-fcfeda7271b7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186343014} {:answer/id #uuid "683aa6b1-adb6-5752-98f4-3a273931868b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186343127} {:answer/id #uuid "78d230ed-b93e-5bce-ae61-1e6e00da2e94" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186343280} {:answer/id #uuid "d7db328f-e4c7-567e-b319-dbb4a9fef103" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186344135}] :answer-field/correct {:answer/id #uuid "d7db328f-e4c7-567e-b319-dbb4a9fef103" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186344135} :answer-field/id #uuid "67145e24-54e9-57c2-bd15-3f132d50bd30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344667}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b9597aa-ca6f-577e-9d42-415936c8f19c" :question/math-academy-id "q-77152" :question/problem "Let $u=[\\begin{aligned}a \\\\ 2 \\\\ 4\\end{aligned}]$ and $v=[\\begin{aligned}a \\\\ -4 \\\\ -2\\end{aligned}].$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-4)+4\\cdot (-2) \\\\  & ={a}^{2}-16.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ {a}^{2}-16 & =0 \\\\ {a}^{2} & =16 \\\\ a & =\\pm 4\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-4.$"} {:db/id #edb/ref 17592186497648 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d15905-64e8-5d18-af76-8acc9e5d07c0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186497652} {:answer/id #uuid "4ad8e45f-0ef5-5613-af41-2fd293933b76" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186497659} {:answer/id #uuid "53d58eb0-0d8f-5cbb-9b43-03bddd83341c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186497660} {:answer/id #uuid "5d488039-835c-51f7-98f3-a614ceeaa760" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186497663} {:answer/id #uuid "5e52e799-9a4a-574e-8348-452560e7951d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186497664}] :answer-field/correct {:answer/id #uuid "53d58eb0-0d8f-5cbb-9b43-03bddd83341c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186497660} :answer-field/id #uuid "34df9243-805f-538d-a45b-1fa7022afbc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497655}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0dfb24ed-71db-576c-87d7-7b45fd0ad875" :question/problem "Let $g=[\\begin{aligned}{r}^{2} \\\\ -2 \\\\ -2\\end{aligned}]$ and $h=[\\begin{aligned}4 \\\\ {r}^{2} \\\\ 3\\end{aligned}].$ Given that $g⊥h$ and $r>0$, find the value of $r.$" :question/worked-solution "We know that $g⊥h$ ($g$ and $h$ are perpendicular) if and only if $g\\cdot h=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}g\\cdot h & ={g}_{x}\\cdot {h}_{x}+{g}_{y}\\cdot {h}_{y}+{g}_{z}\\cdot {h}_{z} \\\\  & ={r}^{2}\\cdot 4+(-2)\\cdot {r}^{2}+(-2)\\cdot 3 \\\\  & =4{r}^{2}-2{r}^{2}-6 \\\\  & =2{r}^{2}-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}g\\cdot h & =0 \\\\ 2{r}^{2}-6 & =0 \\\\ 2{r}^{2} & =6 \\\\ {r}^{2} & =3 \\\\ r & =\\pm \\sqrt{3}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are told that $r>0.$ Therefore, $r=\\sqrt{3}.$"} {:db/id #edb/ref 17592186497657 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e71aa6-0dd2-528b-82f1-c11f714a943c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186497645} {:answer/id #uuid "31546151-ec15-571b-a3a0-a043f97c6ce6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186497653} {:answer/id #uuid "8c9d1a62-29c0-5978-a42e-05d68ed3f2c6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{10}" :db/id #edb/ref 17592186497674} {:answer/id #uuid "b6def8f7-fa98-5672-a10e-3350a588cd82" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186497682} {:answer/id #uuid "cf664727-ae67-5808-8037-46c3d58535a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{10}}{10}" :db/id #edb/ref 17592186497686}] :answer-field/correct {:answer/id #uuid "8c9d1a62-29c0-5978-a42e-05d68ed3f2c6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{10}" :db/id #edb/ref 17592186497674} :answer-field/id #uuid "e7fa0ba8-9797-51f1-a1a3-612a76531ff7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497691}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38cba23b-122c-5771-b6e6-8755391889ee" :question/problem "Let $u=[\\begin{aligned}a \\\\ 2 \\\\ 3\\end{aligned}]$ and $v=[\\begin{aligned}a \\\\ -2 \\\\ -2\\end{aligned}].$ Given that $u⊥v$ and $a<0$, find the value of $a.$" :question/worked-solution "We know that $u⊥v$ ($u$ and $v$ are perpendicular) if and only if $u\\cdot v=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{x}\\cdot {v}_{x}+{u}_{y}\\cdot {v}_{y}+{u}_{z}\\cdot {v}_{z} \\\\  & =a\\cdot a+2\\cdot (-2)+3\\cdot (-2) \\\\  & ={a}^{2}-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ {a}^{2}-10 & =0 \\\\ {a}^{2} & =10 \\\\ a & =\\pm \\sqrt{10}\\end{aligned}\n$$\n\nWe disregard the positive solution since we are told that $a<0.$ Therefore, $a=-\\sqrt{10}.$"} {:db/id #edb/ref 17592186497669 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4110b4e-1a2c-578a-8eae-e4ee8ea9f987" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186497681}] :answer-field/correct {:answer/id #uuid "a4110b4e-1a2c-578a-8eae-e4ee8ea9f987" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186497681} :answer-field/id #uuid "580d3caf-8d8c-5d43-990c-bd6328480355" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186497662}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "773eaa1c-93aa-5388-970f-8375245372c9" :question/problem "If $c=[\\begin{aligned}k \\\\ 3k \\\\ -4\\end{aligned}],$ $d=[\\begin{aligned}-3 \\\\ 2 \\\\ 2\\end{aligned}],$ and $c⊥d,$ then $k=${{field-1}}." :question/worked-solution "We know that $c⊥d$ ($c$ and $d$ are perpendicular) if and only if $c\\cdot d=0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}c\\cdot d & ={c}_{x}\\cdot {d}_{x}+{c}_{y}\\cdot {d}_{y}+{c}_{z}\\cdot {d}_{z} \\\\  & =k\\cdot (-3)+3k\\cdot 2+(-4)\\cdot 2 \\\\  & =-3k+6k-8 \\\\  & =3k-8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain\n\n$$\n\\begin{aligned}c\\cdot d & =0 \\\\ 3k-8 & =0 \\\\ k & =\\frac{8}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186497671 :knowledge-point/_questions [{:knowledge-point/id #uuid "8bff08bf-0035-5f05-9607-493b301e8717" :knowledge-point/title "Solving for an Unknown Given Two Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b3972e-c239-511d-a71c-02f341be9035" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{30}}{15}" :db/id #edb/ref 17592186497646} {:answer/id #uuid "2bd291ac-ba38-5d8a-a0e8-3f5f1fe8366e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{2}" :db/id #edb/ref 17592186497650} {:answer/id #uuid "2c7913a5-a7e3-5bdd-8171-688ecb016f91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{30}}{2}" :db/id #edb/ref 17592186497651} {:answer/id #uuid "99847163-4548-58d7-8f0d-3fe13415