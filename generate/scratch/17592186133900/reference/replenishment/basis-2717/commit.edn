athrm d \\theta\\\\ & =\\int_{0}^{2 \\pi}\\int_{3}^{4}- 2 r^{3}\\,\\mathrm d r\\,\\mathrm d \\theta\\\\ & =\\int_{0}^{2 \\pi}\\,\\mathrm d \\theta\\cdot \\int_{3}^{4}- 2 r^{3}\\,\\mathrm d r\\\\ & =- 4 \\pi\\cdot \\int_{3}^{4}r^{3}\\,\\mathrm d r\\\\ & =- 4 \\pi\\cdot \\frac{r^{4}}{4}\\big|_{3}^{4}\\\\ & =- 4 \\pi\\cdot (\\left(64\\right)-\\left(\\frac{81}{4}\\right))\\\\ & =-2\\cdot\\left(\\frac{\\pi}{2}\\right)\\cdot \\left((4)^{4}-\\left((3)^{4}\\right)\\right)\\\\ & =- \\pi\\cdot \\left(256-\\left(81\\right)\\right)\\\\ & =- 175 \\pi.\\end{aligned}\n$$" 13194139536030 17592186045443 true] [17592186558944 1080 "626 \\pi" 13194139536030 17592186045443 true] [17592186558944 1082 #edb/ref 17592186045498 13194139536030 17592186045443 true] [17592186558944 1083 #uuid "637450eb-ee8e-57be-93a8-401ade0f660e" 13194139536030 17592186045443 true] [17592186558945 1080 "- \\frac{765 \\pi}{2}" 13194139536030 17592186045443 true] [17592186558945 1082 #edb/ref 17592186045498 13194139536030 17592186045443 true] [17592186558945 1083 #uuid "7602cfab-23bc-5eae-a2c4-1fbd9b5d02de" 13194139536030 17592186045443 true] [17592186558946 1080 "609 \\pi" 13194139536030 17592186045443 true] [17592186558946 1082 #edb/ref 17592186045498 13194139536030 17592186045443 true] [17592186558946 1083 #uuid "7b4d5100-ec2b-5e19-978c-eb1f7f60b5de" 13194139536030 17592186045443 true] [17592186558947 1080 "\\frac{771 \\pi}{2}" 13194139536030 17592186045443 true] [17592186558947 1082 #edb/ref 17592186045498 13194139536030 17592186045443 true] [17592186558947 1083 #uuid "7e04b873-e352-5358-9d2e-78981f827a83" 13194139536030 17592186045443 true] [17592186558948 1080 "- 156 \\pi" 13194139536030 17592186045443 true] [17592186558948 1082 #edb/ref 17592186045498 13194139536030 17592186045443 true] [17592186558948 1083 #uuid "7f9a472c-0ddd-5258-a8ab-790f0023bd6c" 13194139536030 17592186045443 true] [17592186558949 1068 #edb/ref 17592186558951 13194139536030 17592186045443 true] [17592186558949 1070 #edb/ref 17592186