peratorname{sin}⁡4t}{1+4{e}^{4t}\\sin^{4}⁡4t}\\,j)\\cdot (2{e}^{2t}\\,i+4\\operatorname{cos}⁡4t\\,j) \\\\  & =\\frac{4{e}^{2t}\\sin^{2}⁡4t}{1+4{e}^{4t}\\sin^{4}⁡4t}+\\frac{16{e}^{2t}\\operatorname{sin}⁡4t\\operatorname{cos}⁡4t}{1+4{e}^{4t}\\sin^{4}⁡4t} \\\\  & =\\frac{2{e}^{2t}(2\\sin^{2}⁡4t+8\\operatorname{sin}⁡4t\\operatorname{cos}⁡4t)}{1+4{e}^{4t}\\sin^{4}⁡4t}.\\end{aligned}\n$$" 13194139535879 17592186045443 true] [17592186536111 1075 #edb/ref 17592186536109 13194139535879 17592186045443 true] [17592186536111 1075 #edb/ref 17592186536114 13194139535879 17592186045443 true] [17592186536111 1075 #edb/ref 17592186536142 13194139535879 17592186045443 true] [17592186536111 1075 #edb/ref 17592186536154 13194139535879 17592186045443 true] [17592186536111 1075 #edb/ref 17592186536160 13194139535879 17592186045443 true] [17592186536111 1076 #edb/ref 17592186045493 13194139535879 17592186045443 true] [17592186536111 1077 "selection" 13194139535879 17592186045443 true] [17592186536111 1078 #edb/ref 17592186536109 13194139535879 17592186045443 true] [17592186536111 1079 #uuid "219519b6-e351-5891-9ab3-febd1842d844" 13194139535879 17592186045443 true] [17592186536112 1080 "\\frac{16 e^{4 t} \\sin^{2}{\\left(5 t \\right)}}{16 e^{8 t} \\sin^{4}{\\left(5 t \\right)} + 1}" 13194139535879 17592186045443 true] [17592186536112 1082 #edb/ref 17592186045498 13194139535879 17592186045443 true] [17592186536112 1083 #uuid "23479d6b-0017-5db5-a587-dd7c374c7ee8" 13194139535879 17592186045443 true] [17592186536113 1080 "\\frac{4 \\left(2 e^{2 t} + \\ln{\\left(t \\right)}\\right)}{t}" 13194139535879 17592186045443 true] [17592186536113 1082 #edb/ref 17592186045498 13194139535879 17592186045443 true] [17592186536113 1083 #uuid "25e4a664-828b-5860-8931-3f7a67e771ea" 13194139535879 17592186045443 true] [17592186536114 1080 "\\frac{\\left(t e^{2 t} + 2 t \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}\\right) e^{t}}{t}" 13194139535879 17592186045443 true] [17592186536114 1082 #edb/ref 175921