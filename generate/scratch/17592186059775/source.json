    ":knowledge-point/_canonical-example": [
      {
        ":knowledge-point/id": "a10cafc6-9da7-5ffc-a0c7-686a7638fbd9",
        ":knowledge-point/title": "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination"
