#{[{:db/id #edb/ref 17592186175912 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175740 :question/id #uuid "1e0c95a6-24fc-55d1-9c4c-bf87877b3723" :question/math-academy-id "e-14729" :question/problem "Find the equation of the line that passes through the point $(1,-1)$ and is parallel to the line passing through the points $(2,1)$ and $(6,4)$. Write your answer in **standard form**." :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(2,1)$ and $(6,4)$:\n\n$$\n\\begin{aligned}\nm &= \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} \\\\\n&= \\frac{4 - 1}{6 - 2} \\\\\n&= \\frac{3}{4}\n\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of\n\n$$\n\\dfrac{3}{4}\n$$\n\nand passes through the point $(1,-1)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - (-1) &= \\frac{3}{4}(x - 1) \\\\\ny + 1 &= \\frac{3}{4}x - \\frac{3}{4} \\\\\ny &= \\frac{3}{4}x - \\frac{7}{4}\n\\end{aligned}\n$$\n\nFinally, we write this equation in standard form.\n\n$$\n\\begin{aligned}\ny &= \\frac{3}{4}x - \\frac{7}{4} \\\\\n4y &= 3x - 7 \\\\\n- 3x + 4y &= -7 \\\\\n3x - 4y &= 7\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "1a27c6f2-b81b-5b62-bcd0-14936842fe83" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049201 :topic/math-academy-id 3725 :topic/title "Properties of Lines Given in Standard Form"}] :knowledge-point/questions [{:db/id #edb/ref 17592186176419 :question/answer-fields [{:answer-field/id #uuid "e84db149-0fdf-57ec-bf76-ee6bccc2080a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174742} {:answer-field/id #uuid "053e9052-c4d0-592f-ae8e-2395eb179ccb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174743}] :question/id #uuid "31a937d8-bfb4-5425-9660-09c37501adc3" :question/math-academy-id "q-214093" :question/problem "Find the equation of the line that passes through the point $(-2, 1)$ and is parallel to $8x + 2y = 1$. Write your answer in **standard form.** {{field-1}}\n$=$\n{{field-2}}"} {:db/id #edb/ref 17592186176425 :question/answer-fields [{:answer-field/id #uuid "ebedceec-ce46-563a-86f8-37641baa1792" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174749} {:answer-field/id #uuid "12fea534-1224-5d05-a740-0d3308290ac4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186174750}] :question/id #uuid "7da08e74-5166-5885-919a-dfff8326bc6a" :question/math-academy-id "q-216399" :question/problem "Find the equation of the line that passes through the point $(-2,-1)$ and is parallel to the line passing through the points $(3,-1)$ and $(6, 5)$. Write your answer in **standard form.** {{field-1}}\n$=$\n{{field-2}}"}] :knowledge-point/title "Working With Lines in Standard Form"}]}
