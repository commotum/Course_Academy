86482658} :answer-field/id #uuid "c7381428-e4d3-569d-8aa3-19518ccacaf6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482698}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f9dba79-4d85-500f-864d-6679c1dd4ec3" :question/problem "Find the equation of the line that passes through the point $(-2,-1)$ and is parallel to $8x + 2y = 1$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, write the given line in slope-intercept form:\n\n$$\n\\begin{aligned}8 x + 2 y &= 1 \\\\ 2 y &= 1 -8 x \\\\ y &= \\frac{1}{2} -4 x\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $-4$ and passes through the point $(-2,-1)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-1) &= -4(x-(-2)) \\\\ y-(-1) &= -4 x -8 \\\\ y &= -4 x -9\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= -4 x -9 \\\\ 4 x + y &= -9\\end{aligned}\n$$\n\nThe first blank is $4 x + y$ and the second blank is $-9$."} {:db/id 17592186482663 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "974c7431-c4bb-54d6-8f16-8e345b3010c3" :answer/type {:db/ident :answer.type/math} :answer/value "4 x + y" :db/id 17592186482687}] :answer-field/correct {:answer/id #uuid "974c7431-c4bb-54d6-8f16-8e345b3010c3" :answer/type {:db/ident :answer.type/math} :answer/value "4 x + y" :db/id 17592186482687} :answer-field/id #uuid "bac43c51-35c4-5930-92a1-fa58b760c8b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482695} {:answer-field/choices [{:answer/id #uuid "3c60047a-3cdd-5b2a-817c-3632d821b07d" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id 17592186482665}] :answer-field/correct {:answer/id #uuid "3c60047a-3cdd-5b2a-817c-3632d821b07d" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id 17592186482665} :answer-field/id #uuid "be089c35-7da0-5673-ad2d-5afefb37f7e1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482697}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18de6b0f-e0d4-57c9-8c2f-955688f324ec" :question/problem "Find the equation of the line that passes through the point $(-2,-5)$ and is parallel to $8x + 2y = 1$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, write the given line in slope-intercept form:\n\n$$\n\\begin{aligned}8 x + 2 y &= 1 \\\\ 2 y &= 1 -8 x \\\\ y &= \\frac{1}{2} -4 x\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $-4$ and passes through the point $(-2,-5)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-5) &= -4(x-(-2)) \\\\ y-(-5) &= -4 x -8 \\\\ y &= -4 x -13\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= -4 x -13 \\\\ 4 x + y &= -13\\end{aligned}\n$$\n\nThe first blank is $4 x + y$ and the second blank is $-13$."} {:db/id 17592186482667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4aa40b8-3294-55d0-b962-0a73373ca524" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id 17592186482692}] :answer-field/correct {:answer/id #uuid "b4aa40b8-3294-55d0-b962-0a73373ca524" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id 17592186482692} :answer-field/id #uuid "7c23546c-9f6f-510f-b262-3f84762c3e5e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482677} {:answer-field/choices [{:answer/id #uuid "f72d17d6-9556-5f70-9a06-7c9c878846c8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id 17592186482706}] :answer-field/correct {:answer/id #uuid "f72d17d6-9556-5f70-9a06-7c9c878846c8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id 17592186482706} :answer-field/id #uuid "d3ba4946-5218-5f0d-bdda-f87130d28c39" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482700}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "45e85c69-2915-53ec-9b6f-8e73c6118d11" :question/problem "Find the equation of the line that passes through the point $(-2,-8)$ and is parallel to the line passing through the points $(3,-1)$ and $(6, 5)$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(3,-1)$ and $(6,5)$:\n\n$$\n\\begin{aligned}m &= \\frac{y_2-y_1}{x_2-x_1} \\\\ &= \\frac{5-(-1)}{6-(3)} \\\\ &= 2\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $2$ and passes through the point $(-2,-8)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-8) &= 2(x-(-2)) \\\\ y-(-8) &= 2 x + 4 \\\\ y &= 2 x -4\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= 2 x -4 \\\\ 2 x -y &= 4\\end{aligned}\n$$\n\nThe first blank is $2 x -y$ and the second blank is $4$."} {:db/id 17592186482673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7346477-76ec-53e3-8749-86f16ad253e3" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id 17592186482688}] :answer-field/correct {:answer/id #uuid "a7346477-76ec-53e3-8749-86f16ad253e3" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id 17592186482688} :answer-field/id #uuid "6f334fab-18b8-5f48-8db5-38821108857f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482672} {:answer-field/choices [{:answer/id #uuid "0df94000-eea7-560d-be59-c18037122c7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id 17592186482660}] :answer-field/correct {:answer/id #uuid "0df94000-eea7-560d-be59-c18037122c7c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id 17592186482660} :answer-field/id #uuid "922fb1bc-9c16-5396-b62d-d471b8174bb1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482686}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "70571ec1-99d9-55ba-a9fd-658e53807f96" :question/problem "Find the equation of the line that passes through the point $(-2,-3)$ and is parallel to the line passing through the points $(3,-1)$ and $(6, 5)$. Write your answer in **standard form.** Use $Ax+By=C$ with integer $A,B,C$, $A>0$, and coprime $A$ and $B$ (their greatest common divisor is $1$). Enter $Ax+By$ in the first blank and $C$ in the second blank.\n\n{{field-1}}\n$=$\n{{field-2}}" :question/worked-solution "Since parallel lines have equal slopes, both lines should have the same slope.\n\nFirst, let's find the slope of the line passing through the points $(3,-1)$ and $(6,5)$:\n\n$$\n\\begin{aligned}m &= \\frac{y_2-y_1}{x_2-x_1} \\\\ &= \\frac{5-(-1)}{6-(3)} \\\\ &= 2\\end{aligned}\n$$\n\nTherefore, we wish to find a line that has a slope of $2$ and passes through the point $(-2,-3)$. To find the equation of this line, we use point-slope form:\n\n$$\n\\begin{aligned}y-y_1 &= m(x-x_1) \\\\ y-(-3) &= 2(x-(-2)) \\\\ y-(-3) &= 2 x + 4 \\\\ y &= 2 x + 1\\end{aligned}\n$$\n\nFinally, write the equation in standard form with coprime integer coefficients and a positive $x$-coefficient.\n\n$$\n\\begin{aligned}y &= 2 x + 1 \\\\ 2 x -y &= -1\\end{aligned}\n$$\n\nThe first blank is $2 x -y$ and the second blank is $-1$."} {:db/id 17592186482681 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55afb0bf-08cd-54b1-a958-addd72254d61" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id 17592186482669}] :answer-field/correct {:answer/id #uuid "55afb0bf-08cd-54b1-a958-addd72254d61" :answer/type {:db/ident :answer.type/math} :answer/value "2 x -y" :db/id 17592186482669} :answer-field/id #uuid "40d60afb-73c1-5f28-90c1-acb979382413" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482666} {:answer-field/choices [{:answer/id #uuid "b644eb6b-cc5b-5834-8473-f4e10310af48" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186482693}] :answer-field/correct {:answer/id #uuid "b644eb6b-cc5b-5834-8473-f4e10310af48" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186482693} :answer-field/id #uuid "e39ab48a-7bf1-5a43-afe2-eea6057a39a1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186482703}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "846babd1-34a3-52d6-8f69-b109d4d672de" :question/problem "Find the equation of the line that passes through the point $(-2,-7)$ and is parallel to the line passing through the points $(3