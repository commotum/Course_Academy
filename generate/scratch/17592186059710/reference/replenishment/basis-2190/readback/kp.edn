db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509359}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e6ddf5ce-9601-5a1e-9bc0-bc304538276a" :question/problem "Find $-3a-2(b-3c)$ if $a=-4i-6j$, $b=4i+3j$, and $c=6i-4j$." :question/worked-solution "To compute $-3a-2(b-3c),$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}\n-3a-2(b-3c) &= -3(-4i-6j)-2((4i+3j)-3(6i-4j)) \\\\\n&= -3(-4i-6j)-2(-14i+15j) \\\\\n&= 12i + 18j - 8i - 6j + 36i - 24j \\\\\n&= (12i - 8i + 36i) + (18j - 6j - 24j) \\\\\n&= 40i - 12j\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186509449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fb855d4-f6c8-52bd-beaa-88a721cf8fe5" :answer/type {:db/ident :answer.type/math} :answer/value "20i + 12j" :db/id #edb/ref 17592186509378} {:answer/id #uuid "5184c2cd-4694-572b-b016-1b3b2577bb98" :answer/type {:db/ident :answer.type/math} :answer/value "-4i - 8j" :db/id #edb/ref 17592186509379} {:answer/id #uuid "8f79ee5d-6c6c-51da-8fae-d913f3c4e101" :answer/type {:db/ident :answer.type/math} :answer/value "5i + 17j" :db/id #edb/ref 17592186509404} {:answer/id #uuid "af9d9fc3-361d-570c-9668-2c75cfade9b6" :answer/type {:db/ident :answer.type/math} :answer/value "32i + 8j" :db/id #edb/ref 17592186509418} {:answer/id #uuid "b9db951d-933e-5776-b790-f0009c5e8c73" :answer/type {:db/ident :answer.type/math} :answer/value "-4i + 20j" :db/id #edb/ref 17592186509423}] :answer-field/correct {:answer/id #uuid "b9db951d-933e-5776-b790-f0009c5e8c73" :answer/type {:db/ident :answer.type/math} :answer/value "-4i + 20j" :db/id #edb/ref 17592186509423} :answer-field/id #uuid "af3ced43-ae69-5c0e-84b0-cffaf35ce1d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509417}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fe19a4c0-0b72-5455-b676-129a73e5fad3" :question/problem "Find $-2a-2(b-(-3c))$ if $a=-6i-4j$, $b=-i-3j$, and $c=3i-j$." :question/worked-solution "To compute $-2a-2(b-(-3c)),$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}\n-2a-2(b-(-3c)) &= -2(-6i-4j)-2((-i-3j)-(-3)(3i-j)) \\\\\n&= -2(-6i-4j)-2(8i-6j) \\\\\n&= 12i + 8j + 2i + 6j - 18i + 6j \\\\\n&= (12i + 2i - 18i) + (8j + 6j + 6j) \\\\\n&= -4i + 20j\n\\end{aligned}\n$$"}] :knowledge-point/title "Addition and Scalar Multiplication of Vectors in Component Form"}]}
