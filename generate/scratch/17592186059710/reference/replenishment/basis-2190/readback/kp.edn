#{[{:db/id #edb/ref 17592186059710 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059523 :question/id #uuid "1d2717f9-b905-59eb-85d7-6db4f9c9dc7f" :question/math-academy-id "e-4292" :question/problem "Find $\\mathbf{a}-2\\mathbf{b}$ if $\\mathbf{a}=-4\\mathbf{i}+6\\mathbf{j}$ and $\\mathbf{b}=12\\mathbf{i}$." :question/worked-solution "To compute $\\mathbf{a}-2\\mathbf{b}$, we just need to compute all of the $\\mathbf{i}$'s and $\\mathbf{j}$'s, as follows:\n\n$$\n\\begin{aligned}\na - 2b &= (-4i + 6j) - 2(12i) \\\\\n&=-4i + 6j - 24i \\\\\n&= (-4i - 24i) + 6j \\\\\n&=-28i + 6j\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "d63a46dd-b963-5ecc-a96d-e0204ca480a9" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048816 :topic/math-academy-id 1165 :topic/title "Two-Dimensional Vectors Expressed in Component Form"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186509451 :question-generator/id #uuid "4916273a-a450-5dc6-ba6b-3b3f0cdb4662" :question-generator/script "generate/scratch/17592186059710.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060392 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8091513a-8f2f-5ec9-9cf7-c2d508bd8c12" :answer/type {:db/ident :answer.type/math} :answer/value "10i + 4j" :db/id #edb/ref 17592186058975} {:answer/id #uuid "87ad0660-67f4-53a4-9f17-5dc2909a9981" :answer/type {:db/ident :answer.type/math} :answer/value "-4i - 8j" :db/id #edb/ref 17592186058976} {:answer/id #uuid "cfd76fd5-06e8-5e9a-968c-ffff7b934e62" :answer/type {:db/ident :answer.type/math} :answer/value "4i - 4j" :db/id #edb/ref 17592186058977} {:answer/id #uuid "4af2f7e3-95fd-592d-b14e-b329daf8d287" :answer/type {:db/ident :answer.type/math} :answer/value "10i - 4j" :db/id #edb/ref 17592186058978} {:answer/id #uuid "7ffb53e9-fff6-5a11-a761-7671492d0bb7" :answer/type {:db/ident :answer.type/math} :answer/value "4i + 4j" :db/id #edb/ref 17592186058979}] :answer-field/id #uuid "65a33916-dac4-5621-9a49-f57851b3ad