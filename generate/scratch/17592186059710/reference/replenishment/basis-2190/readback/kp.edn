i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}\n2a-2b+4c &= 2(7i+7j) - 2(-9i-5j) + 4(-7i+9j) \\\\\n&= 14i + 14j + 18i + 10j - 28i + 36j \\\\\n&= (14i + 18i - 28i) + (14j + 10j + 36j) \\\\\n&= 4i + 60j\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186509350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e22e13-f383-5919-94e3-8a02e34518d8" :answer/type {:db/ident :answer.type/math} :answer/value "-13i - 19j" :db/id #edb/ref 17592186509347} {:answer/id #uuid "32b58d30-d72c-5472-bc5f-7693bc4f684d" :answer/type {:db/ident :answer.type/math} :answer/value "-29i - 9j" :db/id #edb/ref 17592186509364} {:answer/id #uuid "55c40865-8a8c-5e17-9019-a46c3c891566" :answer/type {:db/ident :answer.type/math} :answer/value "-29i - 19j" :db/id #edb/ref 17592186509380} {:answer/id #uuid "93f6e057-6a41-5947-bd7c-806d947e6b54" :answer/type {:db/ident :answer.type/math} :answer/value "-13i - 9j" :db/id #edb/ref 17592186509407} {:answer/id #uuid "d793672d-a3bc-57e8-959e-28e73bfaab53" :answer/type {:db/ident :answer.type/math} :answer/value "-19i - 11j" :db/id #edb/ref 17592186509431}] :answer-field/correct {:answer/id #uuid "55c40865-8a8c-5e17-9019-a46c3c891566" :answer/type {:db/ident :answer.type/math} :answer/value "-29i - 19j" :db/id #edb/ref 17592186509380} :answer-field/id #uuid "ec819f3b-9f2e-5674-b211-a95c6b204bb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186509441}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "045e65fe-705f-5b7f-8be0-d19cac68cb9c" :question/problem "Find $3a + b$ if $a = -8i - 5j$ and $b = -5i - 4j$." :question/worked-solution "To compute $3a+b,$ we just need to compute all of the $i$'s and $j$'s, as follows:\n\n$$\n\\begin{aligned}\n3a+b &= 3(-8i-5j) + (-5i-4j) \\\\\n&= -24i - 15j - 5i - 4j \\\\\n&= (-24i - 5i) + (-15j - 4j) \\\\\n&= -29i - 19j\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186509352 :question/answer-fields [{:answer-field/cho