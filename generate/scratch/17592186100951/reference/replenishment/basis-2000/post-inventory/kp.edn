7592186098294}] :answer-field/id #uuid "386faf29-f883-5197-a57f-f605f304e704" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098289}] :question/id #uuid "50fb0b0b-198a-530e-b586-9313a3c7912c" :question/math-academy-id "q-141117" :question/problem "Consider the following initial value problem\n$\\frac{dy}{dx} = y^{2}, y(1) = 4$.\n\nYou're given that $y = \\frac{1}{A - x}$ is the solution to this initial value problem. What is the value of the constant $A$?"} {:db/id #edb/ref 17592186272211 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "058d33c3-38bc-5a8a-b193-b57183edaeaf" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186269316} {:answer/id #uuid "20ca9768-8408-5d47-83d3-3cdeac15ea6a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269546} {:answer/id #uuid "3e9b3f54-9ab3-5a07-8550-6d3a6dd62a49" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186269842} {:answer/id #uuid "4db64a33-bfca-52ca-81d7-4627db1c20b9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269972} {:answer/id #uuid "ddb92157-9cb4-5dee-a5ff-fc87722216d2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186271216}] :answer-field/correct {:answer/id #uuid "ddb92157-9cb4-5dee-a5ff-fc87722216d2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186271216} :answer-field/id #uuid "8d9cca69-c36e-5a39-a987-76b027db5270" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e6c8b47-d479-53b1-8c84-47f5f3c59cd6" :question/math-academy-id "q-141107" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{4y}{x},\\,y(-1)=-1.\n$$\n\nYou're given that $y=A{x}^{4}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A{x}^{4}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-1)=-1.$\n\nSubstituting the initial condition $y(-1)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{x}^{4} \\\\ -1 & =A(-1)^{4} \\\\ -1 & =A(1) \\\\ A & =-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=(-1){x}^{4}=-{x}^{4}.\n$$"} {:db/id #edb/ref 17592186272212 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d86cd0-b610-5949-970a-9cadba494d80" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186269856} {:answer/id #uuid "59db9bef-eba4-5426-bced-b24333ab4c7c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186270070} {:answer/id #uuid "9aee7aa9-6233-54c2-97d7-0f70259781ae" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270636} {:answer/id #uuid "aa5496f6-fdf1-5cc6-a7ce-dbb55d245952" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186270789} {:answer/id #uuid "c681c4dd-1f9e-524b-b441-d45c91ba1047" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271017}] :answer-field/correct {:answer/id #uuid "c681c4dd-1f9e-524b-b441-d45c91ba1047" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271017} :answer-field/id #uuid "7ce1772f-fae9-51d4-86d3-256af231e875" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271730}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcfaf845-ee85-5f89-a0ff-887be1bdd8e1" :question/math-academy-id "q-141108" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-y,\\,y(0)=1.\n$$\n\nYou're given that $y=A{e}^{-x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A{e}^{-x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=1.$\n\nSubstituting the initial condition $y(0)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-x} \\\\ 1 & =A{e}^{-0} \\\\ 1 & =A(1) \\\\ A & =1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=1{e}^{-x}={e}^{-x}.\n$$"} {:db/id #edb/ref 17592186272213 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27af5735-67e6-5745-837d-f3e8373eb100" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269619} {:answer/id #uuid "53ea0659-8633-53a6-87c4-5c537b0142b1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270015} {:answer/id #uuid "7c9208d8-0f0e-59f5-a04d-7932257e844c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186270360} {:answer/id #uuid "cc899638-4da6-51c0-9a41-5610db689c28" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271063} {:answer/id #uuid "ce25066e-6373-56e0-8a1e-475a79635a3a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186271079}] :answer-field/correct {:answer/id #uuid "53ea0659-8633-53a6-87c4-5c537b0142b1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270015} :answer-field/id #uuid "41bf4f85-758e-5da1-abd2-08e5e4cc3f16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271631}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fca85355-bf58-5075-99c6-c35790d44507" :question/math-academy-id "q-141109" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y,\\,y(0)=2.\n$$\n\nYou're given that $y=A{e}^{-2x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A{e}^{-2x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=2.$\n\nSubstituting the initial condition $y(0)=2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-2x} \\\\ 2 & =A{e}^{-2(0)} \\\\ 2 & =A{e}^{0} \\\\ 2 & =A(1) \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2{e}^{-2x}.\n$$"} {:db/id #edb/ref 17592186272214 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "637a72ce-0d98-52b9-bd74-7454769e1306" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270150} {:answer/id #uuid "639d7aa9-6e9c-56a5-93f9-c52aa4f843af" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186270151} {:answer/id #uuid "65c55cd3-8c13-52a3-a22c-496d7ed37306" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186270176} {:answer/id #uuid "76ca705e-0bfb-57d2-b037-21e60eec8ae8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186270317} {:answer/id #uuid "952621dd-e2c2-5a13-b19f-0690051a27fe" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270575}] :answer-field/correct {:answer/id #uuid "952621dd-e2c2-5a13-b19f-0690051a27fe" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270575} :answer-field/id #uuid "499365bc-c9cb-5bfb-b557-42f54e59d06b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42cc7718-b801-5574-add3-311d9f7972bc" :question/math-academy-id "q-141111" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y\\operatorname{tan}⁡2x,\\,y(\\frac{\\pi }{8})=\\sqrt{2}.\n$$\n\nYou're given that $y=A\\operatorname{cos}⁡2x$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=A\\operatorname{cos}⁡2x$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{\\pi }{8})=\\sqrt{2}.$\n\nSubstituting the initial condition $y(\\frac{\\pi }{8})=\\sqrt{2}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A\\operatorname{cos}⁡2x \\\\ \\sqrt{2} & =A\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{8}) \\\\ \\sqrt{2} & =A\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\ \\sqrt{2} & =A(\\frac{\\sqrt{2}}{2}) \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2\\operatorname{cos}⁡2x.\n$$"} {:db/id #edb/ref 17592186272215 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba2e4d0-14d3-5e3f-a154-f23244402132" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186269372} {:answer/id #uuid "2eae9f08-f9ab-5840-be4a-f20ee77083b8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186269689} {:answer/id #uuid "72af3f51-6c6e-5bd3-b3d5-192c13e81d79" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270282} {:answer/id #uuid "d2a550bb-d2ce-54f1-bcd0-9c271a541331" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186271124} {:answer/id #uuid "f528aba0-decc-5d96-86c5-93d306efde35" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271418}] :answer-field/correct {:answer/id #uuid "2eae9f08-f9ab-5840-be4a-f20ee77083b8" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186269689} :answer-field/id #uuid "59599c50-b345-5a48-9462-d538ac1bac80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271671}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9915548e-f09c-5476-a595-046194f74c54" :question/math-academy-id "q-141114" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{x},\\,y(-1)=3.\n$$\n\nYou're given that $y=Ax$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=Ax$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-1)=3.$\n\nSubstituting the initial condition $y(-1)=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =Ax \\\\ 3 & =A(-1) \\\\ 3 & =-A \\\\ A & =-3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-3x.\n$$"} {:db/id #edb/ref 17592186319202 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57db562f-825a-5c06-9c18-a4185051c072" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317861}] :answer-field/correct {:answer/id #uuid "57db562f-825a-5c06-9c18-a4185051c072" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317861} :answer-field/id #uuid "5672edce-69fb-5725-aa5f-85f880ba3571" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318610}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95cfa877-83ba-5877-86e4-7c000e0d1f2a" :question/math-academy-id "q-347839" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y\\operatorname{cot}⁡(3x),\\,y\\,(\\frac{\\pi }{6})=1.\n$$\n\nYou are given that $y=A\\operatorname{sin}⁡(3x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We are given that $y=A\\operatorname{sin}⁡(3x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\,(\\frac{\\pi }{6})=1.$\n\nSubstituting the initial condition $y\\,(\\frac{\\pi }{6})=1$ into the solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A\\operatorname{sin}⁡(3x) \\\\ 1 & =Asin\\,(3\\cdot \\frac{\\pi }{6}) \\\\ 1 & =Asin\\,(\\frac{\\pi }{2}) \\\\ 1 & =A(1) \\\\ A & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321016 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c73f686-0fde-551d-8a04-19d55648ae19" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319861}] :answer-field/correct {:answer/id #uuid "9c73f686-0fde-551d-8a04-19d55648ae19" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186319861} :answer-field/id #uuid "1853bdf6-795c-54d2-8aca-6ddb48b65a90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320219}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c813122-41f5-5f7d-ad1c-44bd6d1ad9e7" :question/math-academy-id "q-352649" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y\\operatorname{tan}⁡(2x),\\,y\\,(\\frac{\\pi }{8})=\\sqrt{2}.\n$$\n\nYou are given that $y=A\\operatorname{cos}⁡(2x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We are given that $y=A\\operatorname{cos}⁡(2x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y\\,(\\frac{\\pi }{8})=\\sqrt{2}.$\n\nSubstituting the initial condition $y\\,(\\frac{\\pi }{8})=\\sqrt{2}$ into the solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A\\operatorname{cos}⁡(2x) \\\\ \\sqrt{2} & =Acos\\,(2\\cdot \\frac{\\pi }{8}) \\\\ \\sqrt{2} & =A\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\ \\sqrt{2} & =A\\cdot \\frac{\\sqrt{2}}{2} \\\\ A & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321017 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24dfcc68-5dea-50bf-b7a8-8e83148e7990" :answer/type {:db/ident :answer.type/math} :answer/value "5/{e}^{6}" :db/id #edb/ref 17592186319505}] :answer-field/correct {:answer/id #uuid "24dfcc68-5dea-50bf-b7a8-8e83148e7990" :answer/type {:db/ident :answer.type/math} :answer/value "5/{e}^{6}" :db/id #edb/ref 17592186319505} :answer-field/id #uuid "d41db8f8-1e2b-52a4-95d9-3d2f841c0f19" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33e8fcf6-acf7-5f2b-b8b8-b3631e5ba43c" :question/math-academy-id "q-352654" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\,y(2)=5.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=5.$\n\nSubstituting the initial condition $y(2)=5$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ 5 & =A{e}^{3\\cdot 2} \\\\ 5 & =A{e}^{6} \\\\ \\frac{5}{{e}^{6}} & =A \\\\ A & =\\frac{5}{{e}^{6}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321018 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36f58e9f-d185-562c-9c67-7e75f87623d7" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{4}" :db/id #edb/ref 17592186319560}] :answer-field/correct {:answer/id #uuid "36f58e9f-d185-562c-9c67-7e75f87623d7" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{4}" :db/id #edb/ref 17592186319560} :answer-field/id #uuid "6a793135-2916-5a04-8d25-0d156d312364" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320388}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a255cc3f-5f22-5919-beaf-e4725720aff5" :question/math-academy-id "q-352655" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y(1)=2.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=2.$\n\nSubstituting the initial condition $y(1)=2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ 2 & =A{e}^{-4\\cdot 1} \\\\ 2 & =A{e}^{-4} \\\\ 2{e}^{4} & =A \\\\ A & =2{e}^{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321019 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f8e7e8f-73cf-53bb-83a4-6766a894f35d" :answer/type {:db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186319822}] :answer-field/correct {:answer/id #uuid "8f8e7e8f-73cf-53bb-83a4-6766a894f35d" :answer/type {:db/ident :answer.type/math} :answer/value "4e" :db/id #edb/ref 17592186319822} :answer-field/id #uuid "66f2860e-a104-57a8-b392-d8993df50cb7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320376}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50e3aacc-64ad-599b-9fdb-eea729801f82" :question/math-academy-id "q-352656" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y,\\,y(-1)=4.\n$$\n\nYou're given that $y=A{e}^{x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-1)=4.$\n\nSubstituting the initial condition $y(-1)=4$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{x} \\\\ 4 & =A{e}^{-1} \\\\ 4 & =A{e}^{-1} \\\\ 4e & =A \\\\ A & =4e.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321021 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8acbb56-9fb6-58fa-a74e-030faab46fc8" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320132}] :answer-field/correct {:answer/id #uuid "f8acbb56-9fb6-58fa-a74e-030faab46fc8" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186320132} :answer-field/id #uuid "c34d4846-12a9-583c-9e1f-8c59dd074ddb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f863bf4-17d0-5519-90b1-53b7529243b1" :question/math-academy-id "q-352660" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{4y}{x},\\,y(2)=\\frac{3}{4}.\n$$\n\nYou're given that $y=\\frac{A}{{x}^{4}}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\frac{A}{{x}^{4}}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=\\frac{3}{4}.$\n\nSubstituting the initial condition $y(2)=\\frac{3}{4}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{{x}^{4}} \\\\ \\frac{3}{4} & =\\frac{A}{{2}^{4}} \\\\ \\frac{3}{4} & =\\frac{A}{16} \\\\ A & =12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321022 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc24bb63-d5ea-5647-8e74-82ebea88b815" :answer/type {:db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186320150}] :answer-field/correct {:answer/id #uuid "fc24bb63-d5ea-5647-8e74-82ebea88b815" :answer/type {:db/ident :answer.type/math} :answer/value "1/3" :db/id #edb/ref 17592186320150} :answer-field/id #uuid "bbae27ae-1c5d-5215-9548-779ff9205ad0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320549}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "baa48ee7-6d45-5298-b9b3-7a1a62413c86" :question/math-academy-id "q-352661" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={y}^{2},\\,y(0)=3.\n$$\n\nYou're given that $y=\\frac{1}{A-x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\frac{1}{A-x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=3.$\n\nSubstituting the initial condition $y(0)=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A-x} \\\\ 3 & =\\frac{1}{A-0} \\\\ 3 & =\\frac{1}{A} \\\\ A & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321023 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "303cc3dd-ed53-5fc3-801d-bfcb237bc936" :answer/type {:db/ident :answer.type/math} :answer/value "1/2" :db/id #edb/ref 17592186319544}] :answer-field/correct {:answer/id #uuid "303cc3dd-ed53-5fc3-801d-bfcb237bc936" :answer/type {:db/ident :answer.type/math} :answer/value "1/2" :db/id #edb/ref 17592186319544} :answer-field/id #uuid "f83209fb-2c55-58c7-b40d-019c31ec1356" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44f980f1-e507-5172-bd9f-13aac1021e42" :question/math-academy-id "q-352663" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3y}{x},\\,y(2)=4.\n$$\n\nYou're given that $y=A{x}^{3}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{x}^{3}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=4.$\n\nSubstituting the initial condition $y(2)=4$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{x}^{3} \\\\ 4 & =A(2)^{3} \\\\ 4 & =A(8) \\\\ A & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186373785 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60b15d99-5f73-5d71-a0a0-49f9be9df65d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186373787} {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} {:answer/id #uuid "243ba24f-c088-5741-b1dc-797cc0c88bb6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373789} {:answer/id #uuid "3ab4b002-dd36-598f-8102-522b7e368735" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186373790} {:answer/id #uuid "4a73df82-8e85-5bb1-90fc-89e5be58e836" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186373791}] :answer-field/correct {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} :answer-field/id #uuid "e02b7c91-76ce-53ed-b342-163951d05f8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373786}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8abc10be-3eb5-5e2c-9a94-244a431b287a" :question/math-academy-id "q-141112" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{y}{x},\\,y(-2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=-1.$\n\nSubstituting the initial condition $y(-2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{x} \\\\ -1 & =\\frac{A}{(-2)} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{2}{x}.\n$$"} {:db/id #edb/ref 17592186398445 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024ac53a-9f0a-5a7a-98f8-c50bcc20b4b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186398447} {:answer/id #uuid "6125d774-7a34-522e-a338-4e504b088a07" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398448} {:answer/id #uuid "5be53b7e-12b8-56ea-82fa-df826cb81389" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186398449} {:answer/id #uuid "43ee5f6e-6b96-5920-96dd-6bda4e98e633" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398450} {:answer/id #uuid "6ffa9645-4799-55ea-b858-499c63ccbd0f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186398451}] :answer-field/correct {:answer/id #uuid "5be53b7e-12b8-56ea-82fa-df826cb81389" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186398449} :answer-field/id #uuid "cdc013cf-89dd-52e2-93ec-1bd8584646b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398446}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e0065e9-3a69-5f85-ad17-2869bffc442f" :question/math-academy-id "q-141113" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{2y}{x},\\,y(2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{{x}^{2}}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{{x}^{2}}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=-1.$\n\nSubstituting the initial condition $y(2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{{x}^{2}} \\\\ -1 & =\\frac{A}{{2}^{2}} \\\\ -1 & =\\frac{A}{4} \\\\ A & =-4.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\frac{4}{{x}^{2}}.\n$$"} {:db/id #edb/ref 17592186398452 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89027aec-d449-5dca-8830-9b39f9c5fbba" :answer/type {:db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186398454} {:answer/id #uuid "d1591666-636c-5480-9f22-08f9eeec3613" :answer/type {:db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186398455} {:answer/id #uuid "b092bcb2-de91-5a2a-9a1c-b1cf1cdf0b26" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398456} {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} {:answer/id #uuid "408ad86d-b3e2-50fe-ba49-d6d10e8b89e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398458}] :answer-field/correct {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} :answer-field/id #uuid "5f0f43ae-19bf-5c26-8ca2-6e01020ad358" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398453}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e96414b2-2fe9-598e-bc15-f2c64a7b0633" :question/math-academy-id "q-141115" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=1.$\n\nSubstituting the initial condition $y(1)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(A+x) \\\\ 1 & =\\operatorname{ln}⁡(A+1) \\\\ {e}^{1} & ={e}^{\\operatorname{ln}⁡(A+1)} \\\\ e & =A+1 \\\\ A & =e-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{ln}⁡(e-1+x).\n$$"} {:db/id #edb/ref 17592186398459 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dcefcd7-21a2-550b-82e1-cdf9e8efcbda" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186398461} {:answer/id #uuid "4b4230d9-c571-50ea-9f01-98df054d2c1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186398462} {:answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398463} {:answer/id #uuid "89f9fe65-61ad-531c-91e5-0d74f2e05f24" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398464} {:answer/id #uuid "86af0317-94e9-53ec-8661-5ce6b18962d1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398465}] :answer-field/correct {:answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398463} :answer-field/id #uuid "9f0c471e-3bc9-5406-b7a8-dfcd6f763630" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea6ff592-81a4-59f3-84d6-c97bdc2e3a4f" :question/math-academy-id "q-141116" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-{y}^{2},\\,y(0)=\\frac{1}{2}.\n$$\n\nYou're given that $y=\\frac{1}{A+x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{1}{A+x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=\\frac{1}{2}.$\n\nSubstituting the initial condition $y(0)=\\frac{1}{2}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A+x} \\\\ \\frac{1}{2} & =\\frac{1}{A+0} \\\\ \\frac{1}{2} & =\\frac{1}{A} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{1}{2+x}.\n$$"} {:db/id #edb/ref 17592186493343 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7da44a5d-35ed-5356-acb1-747326fd7e62" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{6}" :db/id #edb/ref 17592186493347}] :answer-field/correct {:answer/id #uuid "7da44a5d-35ed-5356-acb1-747326fd7e62" :answer/type {:db/ident :answer.type/math} :answer/value "- e^{6}" :db/id #edb/ref 17592186493347} :answer-field/id #uuid "bfb8d739-6087-5cb0-989a-1441bdf28bf6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493362}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "602e8cc0-02ef-5eee-abee-b6d55a9699a0" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4y,\\,y(- \\frac{3}{2})=-1.\n$$\n\nYou're given that $y=A{e}^{4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(- \\frac{3}{2})=-1.$\n\nSubstituting the initial condition $y(- \\frac{3}{2})=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{4x} \\\\ -1 & =A{e}^{4\\cdot (- \\frac{3}{2})} \\\\ -1 & =A{e}^{-6} \\\\ \\frac{-1}{{e}^{-6}} & =A \\\\ A & =\\frac{-1}{{e}^{-6}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493344 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9046425d-7108-5533-ae96-d8fb15f776bf" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + e^{-2}" :db/id #edb/ref 17592186493354}] :answer-field/correct {:answer/id #uuid "9046425d-7108-5533-ae96-d8fb15f776bf" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + e^{-2}" :db/id #edb/ref 17592186493354} :answer-field/id #uuid "411892ad-13d1-53ad-85e2-b75b7b7bede9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493341}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6119d730-e0d1-5eb1-8fa9-da95fad116e4" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(2)=-2.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(2)=-2.$\n\nSubstituting the initial condition $y(2)=-2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ -2 & =\\ln(A+2) \\\\ {e}^{-2} & ={e}^{\\ln(A+2)} \\\\ e^{-2} & =A+2 \\\\ A & ={e}^{-2}-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493346 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31f1b340-a0f9-5632-b4ae-d2cd75bbbc79" :answer/type {:db/ident :answer.type/math} :answer/value "2 + e" :db/id #edb/ref 17592186493339}] :answer-field/correct {:answer/id #uuid "31f1b340-a0f9-5632-b4ae-d2cd75bbbc79" :answer/type {:db/ident :answer.type/math} :answer/value "2 + e" :db/id #edb/ref 17592186493339} :answer-field/id #uuid "1eb305ae-46db-5835-ae63-e79c838fcf97" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493338}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "630f3abe-1218-5a27-8968-d6da69e8c899" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(-2)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=1.$\n\nSubstituting the initial condition $y(-2)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ 1 & =\\ln(A+(-2)) \\\\ {e}^{1} & ={e}^{\\ln(A+(-2))} \\\\ e & =A+(-2) \\\\ A & =e+2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493350 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f87f97d4-3817-590b-83c6-b9735360b4f8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493366}] :answer-field/correct {:answer/id #uuid "f87f97d4-3817-590b-83c6-b9735360b4f8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186493366} :answer-field/id #uuid "8b6b7bd6-9678-5e5b-b378-6e9db169efb7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493352}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "85c1e723-615b-5f4b-84c8-de92ecc7344c" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={y}^{2},\\,y(1)=\\frac{1}{4}.\n$$\n\nYou're given that $y=\\frac{1}{A-x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\frac{1}{A-x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=\\frac{1}{4}.$\n\nSubstituting the initial condition $y(1)=\\frac{1}{4}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A-x} \\\\ \\frac{1}{4} & =\\frac{1}{A-1} \\\\ \\frac{1}{\\frac{1}{4}} & =A-1 \\\\ A & =5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493353 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61ba7b7d-5f48-5e29-965c-04ab9aa08574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2}}{3}" :db/id #edb/ref 17592186493345}] :answer-field/correct {:answer/id #uuid "61ba7b7d-5f48-5e29-965c-04ab9aa08574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2}}{3}" :db/id #edb/ref 17592186493345} :answer-field/id #uuid "b0151b1c-1e8e-5b0e-a19d-1ee0bcc76c89" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c629d7f-f88e-5741-a882-820e35768d0a" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y(\\frac{1}{2})=\\frac{1}{3}.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{1}{2})=\\frac{1}{3}.$\n\nSubstituting the initial condition $y(\\frac{1}{2})=\\frac{1}{3}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ \\frac{1}{3} & =A{e}^{-4\\cdot \\frac{1}{2}} \\\\ \\frac{1}{3} & =A{e}^{-2} \\\\ \\frac{\\frac{1}{3}}{{e}^{-2}} & =A \\\\ A & =\\frac{\\frac{1}{3}}{{e}^{-2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493355 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82bc69d2-5af8-5703-b435-2396b81f7637" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac{3}{2}}}{3}" :db/id #edb/ref 17592186493348}] :answer-field/correct {:answer/id #uuid "82bc69d2-5af8-5703-b435-2396b81f7637" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{\\frac{3}{2}}}{3}" :db/id #edb/ref 17592186493348} :answer-field/id #uuid "e78f8914-c568-5d01-8afc-57d32ce156cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493363}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a76133ad-ea1c-5ff4-8da8-4b052e2debb0" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\,y(- \\frac{1}{2})=\\frac{1}{3}.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(- \\frac{1}{2})=\\frac{1}{3}.$\n\nSubstituting the initial condition $y(- \\frac{1}{2})=\\frac{1}{3}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ \\frac{1}{3} & =A{e}^{3\\cdot (- \\frac{1}{2})} \\\\ \\frac{1}{3} & =A{e}^{- \\frac{3}{2}} \\\\ \\frac{\\frac{1}{3}}{{e}^{- \\frac{3}{2}}} & =A \\\\ A & =\\frac{\\frac{1}{3}}{{e}^{- \\frac{3}{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493356 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89893d2b-4533-5a43-930c-9ea6e97ff59b" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + e^{2}" :db/id #edb/ref 17592186493351}] :answer-field/correct {:answer/id #uuid "89893d2b-4533-5a43-930c-9ea6e97ff59b" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + e^{2}" :db/id #edb/ref 17592186493351} :answer-field/id #uuid "b772fdc6-384f-5b49-a09f-cd4b45cbd1a1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ad8d0c2d-b7bc-5b71-86d4-7ff2f62aac86" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=2.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=2.$\n\nSubstituting the initial condition $y(1)=2$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ 2 & =\\ln(A+1) \\\\ {e}^{2} & ={e}^{\\ln(A+1)} \\\\ e^{2} & =A+1 \\\\ A & ={e}^{2}-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493359 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae581985-6ca4-599a-9dfd-6547c92707d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + e^{-1}" :db/id #edb/ref 17592186493357}] :answer-field/correct {:answer/id #uuid "ae581985-6ca4-599a-9dfd-6547c92707d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1 + e^{-1}" :db/id #edb/ref 17592186493357} :answer-field/id #uuid "0e0c781a-362c-5b42-a085-b46bfa30fbeb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493337}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b21bbef4-9add-53b4-bc34-6d945d14d134" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=-1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=\\ln(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=-1.$\n\nSubstituting the initial condition $y(1)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\ln(A+x) \\\\ -1 & =\\ln(A+1) \\\\ {e}^{-1} & ={e}^{\\ln(A+1)} \\\\ e^{-1} & =A+1 \\\\ A & ={e}^{-1}-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493364 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbf7abd5-bfb9-5aba-b550-2a9cc3191d8e" :answer/type {:db/ident :answer.type/math} :answer/value "e^{- \\frac{9}{2}}" :db/id #edb/ref 17592186493361}] :answer-field/correct {:answer/id #uuid "bbf7abd5-bfb9-5aba-b550-2a9cc3191d8e" :answer/type {:db/ident :answer.type/math} :answer/value "e^{- \\frac{9}{2}}" :db/id #edb/ref 17592186493361} :answer-field/id #uuid "54305a96-48f3-5ac5-87e2-b0b6556ff912" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eded91b2-b55d-56c3-bb62-6b902c3a464d" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3y,\\,y(\\frac{3}{2})=1.\n$$\n\nYou're given that $y=A{e}^{3x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{3x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{3}{2})=1.$\n\nSubstituting the initial condition $y(\\frac{3}{2})=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{3x} \\\\ 1 & =A{e}^{3\\cdot \\frac{3}{2}} \\\\ 1 & =A{e}^{\\frac{9}{2}} \\\\ \\frac{1}{{e}^{\\frac{9}{2}}} & =A \\\\ A & =\\frac{1}{{e}^{\\frac{9}{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186493365 :knowledge-point/_questions [{:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403d95ef-a3ea-56f1-82e2-7d2f7984f37f" :answer/type {:db/ident :answer.type/math} :answer/value "3 e^{6}" :db/id #edb/ref 17592186493340}] :answer-field/correct {:answer/id #uuid "403d95ef-a3ea-56f1-82e2-7d2f7984f37f" :answer/type {:db/ident :answer.type/math} :answer/value "3 e^{6}" :db/id #edb/ref 17592186493340} :answer-field/id #uuid "857b5124-dc03-509b-99e1-e4e90f0a3036" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186493349}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef863447-fa5f-590c-8056-4768c8c0285e" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4y,\\,y(\\frac{3}{2})=3.\n$$\n\nYou're given that $y=A{e}^{-4x}$ is the solution to this initial value problem. What is the value of the constant $A?$\n\n$A=${{field-1}}" :question/worked-solution "We're given that $y=A{e}^{-4x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(\\frac{3}{2})=3.$\n\nSubstituting the initial condition $y(\\frac{3}{2})=3$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =A{e}^{-4x} \\\\ 3 & =A{e}^{-4\\cdot \\frac{3}{2}} \\\\ 3 & =A{e}^{-6} \\\\ \\frac{3}{{e}^{-6}} & =A \\\\ A & =\\frac{3}{{e}^{-6}}.\\end{aligned}\n$$"}] :knowledge-point/title "Identifying Solutions to Initial Value Problems"}]}
