      "question": {
        ":question/id": "d27926aa-d0e1-5118-94a6-f7e67a910a7e",
        ":question/problem": "The interval $y\\in [-1,2)$ corresponds to the inequality",
        ":question/answer-fields": [
          {
            ":answer-field/id": "f7132bf4-bf94-5b49-b29e-07beca737f5a",
            ":answer-field/key": "selection",
