7352 1072 #uuid "a5c334a0-b9d7-58f1-b30e-102327fa70dc" 13194139535565 17592186045443 true] [17592186517352 1074 "Since we want to determine the rate of decrease in the amount of charge after $10$ hours, we have $t=10.$\n\nThus, the rate of decrease of the amount of charge after $10$ hours will be\n\n$$\n\\begin{aligned}c(10) & =100\\cdot {5}^{-0.4(10)} \\\\  & =100\\cdot {5}^{-4} \\\\  & =\\frac{100}{625} \\\\  & =\\frac{4}{25}.\\end{aligned}\n$$\n\nTherefore, the rate of decrease will be $\\frac{4}{25}$ percent per hour." 13194139535565 17592186045443 true] [17592186517353 1075 #edb/ref 17592186517342 13194139535565 17592186045443 true] [17592186517353 1076 #edb/ref 17592186045492 13194139535565 17592186045443 true] [17592186517353 1077 "field-1" 13194139535565 17592186045443 true] [17592186517353 1078 #edb/ref 17592186517342 13194139535565 17592186045443 true] [17592186517353 1079 #uuid "aef7959b-ba6c-5639-93da-84cf1b9feb78" 13194139535565 17592186045443 true] [17592186517354 1080 "$156$ cars per hour" 13194139535565 17592186045443 true] [17592186517354 1082 #edb/ref 17592186045499 13194139535565 17592186045443 true] [17592186517354 1083 #uuid "b03e3130-ebeb-56a0-a735-21aa477c71ae" 13194139535565 17592186045443 true] [17592186517355 1080 "$-16$ liters per minute" 13194139535565 17592186045443 true] [17592186517355 1082 #edb/ref 17592186045499 13194139535565 17592186045443 true] [17592186517355 1083 #uuid "b0854dc4-f4cb-5adf-93b0-a9de2132efc8" 13194139535565 17592186045443 true] [17592186517356 1080 "$69$ cars per hour" 13194139535565 17592186045443 true] [17592186517356 1082 #edb/ref 17592186045499 13194139535565 17592186045443 true] [17592186517356 1083 #uuid "b20f23c0-8c87-5d2b-ba53-496addf07a38" 13194139535565 17592186045443 true] [17592186517357 1080 "$-60$ cars per hour" 13194139535565 17592186045443 true] [17592186517357 1082 #edb/ref 17592186045499 13194139535565 17592186045443 true] [17592186517357 1083 #uuid "b7d8817e-e114-506e-a9b2-a1055123a32f" 13194139