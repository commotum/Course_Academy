-bf79-cb434e44020f"] :db/ensure :question/validate} {:db/id "86f14ec9-637c-570c-8157-4e08ae58fc2d" :answer/id #uuid "86f14ec9-637c-570c-8157-4e08ae58fc2d" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}(x+8)(x+4)^{2}(x+2)^{3}(x-1)" :db/ensure :answer/validate} {:db/id "c972ba46-4242-5a26-af59-41e08f1e470b" :answer/id #uuid "c972ba46-4242-5a26-af59-41e08f1e470b" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}(x+7)(x+4)^{3}(x+2)^{3}(x-1)" :db/ensure :answer/validate} {:db/id "96288903-e05d-59e5-bf04-0896b0b0d92a" :answer/id #uuid "96288903-e05d-59e5-bf04-0896b0b0d92a" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}(x+7)(x+4)^{2}(x+2)^{3}(x-1)" :db/ensure :answer/validate} {:db/id "93e37bf6-2488-56cf-b0f3-f546191e1a68" :answer/id #uuid "93e37bf6-2488-56cf-b0f3-f546191e1a68" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}(x+7)(x+4)(x+2)^{3}(x-1)" :db/ensure :answer/validate} {:db/id "dce2e04d-e87c-54c4-a35d-4f7437218415" :answer/id #uuid "dce2e04d-e87c-54c4-a35d-4f7437218415" :answer/type :answer.type/math :answer/value "y=- \\frac{1}{20}(x+7)(x+4)^{2}(x+2)^{3}(x-1)" :db/ensure :answer/validate} {:db/id "a3ef6db2-0807-5225-bbef-5c594c8060dd" :answer-field/id #uuid "a3ef6db2-0807-5225-bbef-5c594c8060dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["86f14ec9-637c-570c-8157-4e08ae58fc2d" "c972ba46-4242-5a26-af59-41e08f1e470b" "96288903-e05d-59e5-bf04-0896b0b0d92a" "93e37bf6-2488-56cf-b0f3-f546191e1a68" "dce2e04d-e87c-54c4-a35d-4f7437218415"] :answer-field/correct "96288903-e05d-59e5-bf04-0896b0b0d92a" :db/ensure :answer-field/validate} {:db/id "64cee9e0-a74a-5e69-95d3-32b9c76015b0" :question/id #uuid "64cee9e0-a74a-5e69-95d3-32b9c76015b0" :question/problem "![](images/ad/ad08536d41ff23bed6c72b73e171ac9e6b0304a75b3ba295f5a5eef26fd3e3a8.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely four distinct roots, $x=-7$, $x=-4$, $x=-2$, and $x=1.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-7,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph just touches the $x$-axis and reverses direction at $x=-4,$ this root has even multiplicity.\n\n- Since the graph passes through $x=-2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=-2,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=1,$ this root is a simple root (the multiplicity equals $1$).\n\nFrom the given options, the only possible equation is $y=\\frac{1}{20}(x+7)(x+4)^{2}(x+2)^{3}(x-1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["a3ef6db2-0807-5225-bbef-5c594c8060dd"] :db/ensure :question/validate} {:db/id "68a6a735-29bd-5be4-aef0-d89a8c7636e2" :answer/id #uuid "68a6a735-29bd-5be4-aef0-d89a8c7636e2" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}x^{2}(x+8)^{3}(x+5)(x+2)" :db/ensure :answer/validate} {:db/id "9517d01e-01d0-511c-8643-a6b9da245078" :answer/id #uuid "9517d01e-01d0-511c-8643-a6b9da245078" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}x^{2}(x+7)^{4}(x+5)(x+2)" :db/ensure :answer/validate} {:db/id "e9cbe30b-589c-568a-9417-2607ef9e32bc" :answer/id #uuid "e9cbe30b-589c-568a-9417-2607ef9e32bc" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}x^{2}(x+7)^{3}(x+5)(x+2)" :db/ensure :answer/validate} {:db/id "dbb0027e-d864-5f40-8b77-8306e21289a0" :answer/id #uuid "dbb0027e-d864-5f40-8b77-8306e21289a0" :answer/type :answer.type/math :answer/value "y=\\frac{1}{20}x^{2}(x+7)(x+5)(x+2)" :db/ensure :answer/validate} {:db/id "c7012a73-1544-5448-b1d9-365cb9653fcc" :answer/id #uuid "c7012a73-1544-5448-b1d9-365cb9653fcc" :answer/type :answer.type/math :answer/value "y=- \\frac{1}{20}x^{2}(x+7)^{3}(x+5)(x+2)" :db/ensure :answer/validate} {:db/id "535541d7-3625-5fbb-be3d-eddefd3b53ec" :answer-field/id #uuid "535541d7-3625-5fbb-be3d-eddefd3b53ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["68a6a735-29bd-5be4-aef0-d89a8c7636e2" "9517d01e-01d0-511c-8643-a6b9da245078" "e9cbe30b-589c-568a-9417-2607ef9e32bc" "dbb0027e-d864-5f40-8b77-8306e21289a0" "c7012a73-1544-5448-b1d9-365cb9653fcc"] :answer-field/correct "e9cbe30b-589c-568a-9417-2607ef9e32bc" :db/ensure :answer-field/validate} {:db/id "bad54ec9-b055-564c-8c70-f6ac5b5e8a55" :question/id #uuid "bad54ec9-b055-564c-8c70-f6ac5b5e8a55" :question/problem "![](images/96/9625a9f85128882977b5408b831b1b7efffe7d00a063ffbf6e89a3134c1631dc.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely four distinct roots, $x=-7$, $x=-5$, $x=-2$, and $x=0.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph passes through $x=-7,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=-7,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-5,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-2,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph just touches the $x$-axis and reverses direction at $x=0,$ this root has even multiplicity.\n\nFrom the given options, the only possible equation is $y=\\frac{1}{20}x^{2}(x+7)^{3}(x+5)(x+2).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["535541d7-3625-5fbb-be3d-eddefd3b53ec"] :db/ensure :question/validate} {:db/id "c29f594f-0bb2-5587-b516-a8ce2c38b6e2" :answer/id #uuid "c29f594f-0bb2-5587-b516-a8ce2c38b6e2" :answer/type :answer.type/m