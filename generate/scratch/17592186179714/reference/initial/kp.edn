#{[{:db/id #edb/ref 17592186179714 :knowledge-point/canonical-example {:db/id #edb/ref 17592186179576 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/id #uuid "2eaebefb-6b18-5689-a746-0d5dc595991c" :question/math-academy-id "e-9453" :question/problem "Find the gradient vector field of the function $f(x,y) = e^{2x-3y}.$" :question/worked-solution "The gradient vector field of a function $f$ is given by $\\nabla f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({e}^{2x-3y}) \\\\  & =2{e}^{2x-3y} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}({e}^{2x-3y}) \\\\  & =-3{e}^{2x-3y}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =2{e}^{2x-3y}\\,i-3{e}^{2x-3y}\\,j.\\end{aligned}\n$$"} :knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050143}] :knowledge-point/questions [{:db/id #edb/ref 17592186179964 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b255ed32-00b2-5c02-8fdf-4137e45f1f94" :answer/type {:db/ident :answer.type/math} :answer/value "(x - y)i + (3y - x - 2)j" :db/id #edb/ref 17592186177454} {:answer/id #uuid "07aeabaa-1756-5d7c-b175-364dae9da70e" :answer/type {:db/ident :answer.type/math} :answer/value "(2x - y)i + (6y - x - 4)j" :db/id #edb/ref 17592186177455} {:answer/id #uuid "0ac9617b-4aa8-5c9d-9329-1e2364c1eed5" :answer/type {:db/ident :answer.type/math} :answer/value "(x - y)i + (3x - y - 2)j" :db/id #edb/ref 17592186177456} {:answer/id #uuid "56d77004-8bf3-5e3b-9345-4eb6281965f7" :answer/type {:db/ident :answer.type/math} :answer/value "(2y - x)i + (6y - y - 4)j" :db/id #edb/ref 17592186177457} {:answer/id #uuid "5732c3e7-79ac-51b8-b415-739696a1c978" :answer/type {:db/ident :answer.type/math} :answer/value "(6y - x - 4)i + (2x - y)j" :db/id #edb/ref 17592186177458}] :answer-field/id #uuid "ca579634-59cd-5d79-9ef4-86d15c0bb68b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186177453}] :question/id #uuid "9fe868ae-14fa-5f36-b879-4b4d02b56eea" :question/math-academy-id "q-122399" :question/problem "Find the gradient vector field of the function $f(x, y) = x^{2} - xy + 3y^{2} - 4y$."} {:db/id #edb/ref 17592186179965 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba475e2-be08-57e4-adec-8abff6266246" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(z-2y)\\,i+\\frac{2x}{2y-z}\\,j+\\frac{x}{z-2y}\\,k" :db/id #edb/ref 17592186253761} {:answer/id #uuid "1b833134-f253-5096-a14a-d79dffc93bf9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(z-2y)\\,i+\\frac{x}{z-2y}\\,j+\\frac{2x}{z-2y}\\,k" :db/id #edb/ref 17592186253903} {:answer/id #uuid "1d588fd7-e3d7-55a7-9d28-9f3428789f98" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(z-2y)\\,i+\\frac{x}{2y-z}\\,j+\\frac{x}{2y-z}\\,k" :db/id #edb/ref 17592186253917} {:answer/id #uuid "69fb1b09-9263-5539-88e5-0d8613d52b75" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(z-2y)\\,i+\\frac{2x}{2y-z}\\,j+\\frac{x}{z-2y}\\,k" :db/id #edb/ref 17592186254624} {:answer/id #uuid "6e94b4d4-2cb7-572a-9f0d-7088c7794500" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(z-2y)\\,i+\\frac{2x}{z-2y}\\,j+\\frac{2x}{z-2y}\\,k" :db/id #edb/ref 17592186254651}] :answer-field/correct {:answer/id #uuid "0ba475e2-be08-57e4-adec-8abff6266246" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(z-2y)\\,i+\\frac{2x}{2y-z}\\,j+\\frac{x}{z-2y}\\,k" :db/id #edb/ref 17592186253761} :answer-field/id #uuid "421569dd-cfb3-59c7-8de4-b002df6d520d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256046}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "68db203b-e688-5d3a-9ec7-9ce2f2bf5402" :question/math-academy-id "q-122404" :question/problem "Find the gradient vector field of the function $f(x,y,z)=x\\operatorname{ln}⁡(z-2y).$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡(z-2y)) \\\\  & =\\operatorname{ln}⁡(z-2y) \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡(z-2y)) \\\\  & =-\\frac{2x}{z-2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(x\\operatorname{ln}⁡(z-2y)) \\\\  & =\\frac{x}{z-2y}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\operatorname{ln}⁡(z-2y)\\,i-\\frac{2x}{z-2y}\\,j+\\frac{x}{z-2y}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256676 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0820aec6-52e0-5e49-a59a-3bbb2eaf3087" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{yz}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,i+\\frac{xz}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,j+\\frac{xy}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,k" :db/id #edb/ref 17592186253728} {:answer/id #uuid "28546720-1acd-59ba-82be-bb4ffaf85ab2" :answer/type {:db/ident :answer.type/math} :answer/value "yz\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,i+xz\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,j+xy\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,k" :db/id #edb/ref 17592186254032} {:answer/id #uuid "707b941f-3995-54da-8e24-b82c909648d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,j+\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,k" :db/id #edb/ref 17592186254666} {:answer/id #uuid "86a81cb8-c83d-53e2-85a7-df445fd4a517" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2yz}{{x}^{2}+{y}^{2}+{z}^{2}}\\,i+\\frac{2xz}{{x}^{2}+{y}^{2}+{z}^{2}}\\,j+\\frac{2xy}{{x}^{2}+{y}^{2}+{z}^{2}}\\,k" :db/id #edb/ref 17592186254861} {:answer/id #uuid "d766fd6b-8bc8-553e-b31b-478e1a2b8eac" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,i+2y\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,j+2z\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,k" :db/id #edb/ref 17592186255575}] :answer-field/correct {:answer/id #uuid "707b941f-3995-54da-8e24-b82c909648d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,j+\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,k" :db/id #edb/ref 17592186254666} :answer-field/id #uuid "96de8d74-918e-533e-ac2c-2823c4173a35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256199}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec9f81d0-f152-5c1c-b7c8-fd08eb67e7c0" :question/math-academy-id "q-122596" :question/problem "Find the gradient vector field of the function $f(x,y,z)=\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}.$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}) \\\\  & =\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}) \\\\  & =\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}) \\\\  & =\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\end{aligned}\n$$\n\n \n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,j+\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186256678 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b6a5e9d-527e-52ec-ba7f-90eb833346f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x-1}}\\,i-\\frac{1}{\\sqrt{2y+1}}\\,j" :db/id #edb/ref 17592186254187} {:answer/id #uuid "4210211b-29fa-55e2-a0b7-52ff66e974ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2x-1}}\\,i+\\frac{4}{\\sqrt{4y+1}}\\,j" :db/id #edb/ref 17592186254233} {:answer/id #uuid "445bfc7e-e291-543e-855e-38c46c84f040" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{4x-1}}\\,i-\\frac{2}{\\sqrt{2y+1}}\\,j" :db/id #edb/ref 17592186254250} {:answer/id #uuid "d1e3b28e-4aac-520e-a4d4-79a1adb3c2a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2x-1}}\\,i+\\frac{1}{\\sqrt{4y+1}}\\,j" :db/id #edb/ref 17592186255541} {:answer/id #uuid "f337cd0f-4b55-5597-858a-91b7156059ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2x-1}}\\,i-\\frac{2}{\\sqrt{4y+1}}\\,j" :db/id #edb/ref 17592186255798}] :answer-field/correct {:answer/id #uuid "f337cd0f-4b55-5597-858a-91b7156059ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2x-1}}\\,i-\\frac{2}{\\sqrt{4y+1}}\\,j" :db/id #edb/ref 17592186255798} :answer-field/id #uuid "0a0aba96-bf2c-522a-b26d-f17993fb8c81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcca6806-23f0-5850-a949-44a533788116" :question/math-academy-id "q-122607" :question/problem "Find the gradient vector field of the function $f(x,y)=\\sqrt{2x-1}-\\sqrt{4y+1}.$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\sqrt{2x-1}-\\sqrt{4y+1}) \\\\  & =\\frac{1}{\\sqrt{2x-1}} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\sqrt{2x-1}-\\sqrt{4y+1}) \\\\  & =-\\frac{2}{\\sqrt{4y+1}}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{1}{\\sqrt{2x-1}}\\,i-\\frac{2}{\\sqrt{4y+1}}\\,j.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382978 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83468821-c39c-5688-9232-e0a48bb155ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+2y}\\,i+\\frac{2}{x+2y}\\,j" :db/id #edb/ref 17592186382980} {:answer/id #uuid "c7b76065-e59a-5ca7-9bfb-b669207ba5b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x+4y}\\,i+\\frac{1}{2x+4y}\\,j" :db/id #edb/ref 17592186382981} {:answer/id #uuid "e411cee5-3a6c-5dda-a344-184fd78d28cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{2x+4y}\\,i+\\frac{2}{2x+4y}\\,j" :db/id #edb/ref 17592186382982} {:answer/id #uuid "e4cc5482-1799-5098-a009-2ed159b19110" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{x+y}\\,i+\\frac{2}{x+y}\\,j" :db/id #edb/ref 17592186382983} {:answer/id #uuid "62c2233e-e9a0-53da-b0de-07b7e76c7fa2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{2x+y}\\,i+\\frac{1}{2x+y}\\,j" :db/id #edb/ref 17592186382984}] :answer-field/correct {:answer/id #uuid "83468821-c39c-5688-9232-e0a48bb155ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+2y}\\,i+\\frac{2}{x+2y}\\,j" :db/id #edb/ref 17592186382980} :answer-field/id #uuid "b5b277d7-41a9-51d5-9221-157f88442b55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382979}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cdc51975-a7a3-5414-a1fb-3bb1994c28af" :question/math-academy-id "q-122599" :question/problem "Find the gradient vector field of the function $f(x,y)=\\operatorname{ln}⁡(2x+4y).$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(2x+4y)) \\\\  & =\\frac{1}{x+2y} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(2x+4y)) \\\\  & =\\frac{2}{x+2y}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{1}{x+2y}\\,i+\\frac{2}{x+2y}\\,j.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382985 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dc65a4b-da4d-5350-953b-f73c08bd26cd" :answer/type {:db/ident :answer.type/math} :answer/value "(z+2y)\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+(x+2y)\\operatorname{cos}⁡(xz+2y)\\,k" :db/id #edb/ref 17592186382987} {:answer/id #uuid "36b97e42-68ff-502f-862c-54abe712f096" :answer/type {:db/ident :answer.type/math} :answer/value "z\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+x\\operatorname{cos}⁡(xz+2y)\\,k" :db/id #edb/ref 17592186382988} {:answer/id #uuid "f9f60994-da11-59b0-bb31-edf3cb7c1617" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+z\\operatorname{cos}⁡(xz+2y)\\,k" :db/id #edb/ref 17592186382989} {:answer/id #uuid "344a1d8c-370f-5d8f-9dd1-49c0513501e2" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡(xz+2y)\\,i+2y\\operatorname{cos}⁡(xz+2y)\\,j+z\\operatorname{cos}⁡(xz+2y)\\,k" :db/id #edb/ref 17592186382990} {:answer/id #uuid "bb2fc14b-bb86-5f37-bc2d-be43a95e0d67" :answer/type {:db/ident :answer.type/math} :answer/value "z\\operatorname{sin}⁡(xz+2y)\\,i+2\\operatorname{sin}⁡(xz+2y)\\,j+x\\operatorname{sin}⁡(xz+2y)\\,k" :db/id #edb/ref 17592186382991}] :answer-field/correct {:answer/id #uuid "36b97e42-68ff-502f-862c-54abe712f096" :answer/type {:db/ident :answer.type/math} :answer/value "z\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+x\\operatorname{cos}⁡(xz+2y)\\,k" :db/id #edb/ref 17592186382988} :answer-field/id #uuid "f3294c69-216b-5d6f-aa53-6f52d4c57c1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cde4da3d-ec55-5f32-ac16-c33bd9acfbfc" :question/math-academy-id "q-122600" :question/problem "Find the gradient vector field of the function $f(x,y,z)=\\operatorname{sin}⁡(xz+2y).$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xz+2y)) \\\\  & =z\\operatorname{cos}⁡(xz+2y) \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xz+2y)) \\\\  & =2\\operatorname{cos}⁡(xz+2y) \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{sin}⁡(xz+2y)) \\\\  & =x\\operatorname{cos}⁡(xz+2y)\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =z\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+x\\operatorname{cos}⁡(xz+2y)\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382992 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1393202f-d724-535d-8136-babf2686d7db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{yz}{xyz+1}\\,i+\\frac{zz}{xyz+1}\\,j+\\frac{xy}{xyz+1}\\,k" :db/id #edb/ref 17592186382994} {:answer/id #uuid "a6f87687-52a9-5e53-b8e0-28200e4a81f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xyz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,i+\\frac{xyz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{xyz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k" :db/id #edb/ref 17592186382995} {:answer/id #uuid "4bb0e8f2-8c32-5a43-9f8c-3b04ae890241" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{{x}^{2}{y}^{2}{z}^{2}+1}\\,i+\\frac{y}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{z}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k" :db/id #edb/ref 17592186382996} {:answer/id #uuid "b14f2ad2-72a2-5e49-bfaf-d442c2b9f197" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{yz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,i+\\frac{xz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{xy}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k" :db/id #edb/ref 17592186382997} {:answer/id #uuid "026ff4bf-c0ad-56d4-bab2-b4e07f1395b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{2}{y}^{2}{z}^{2}+1}\\,i+\\frac{1}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{1}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k" :db/id #edb/ref 17592186382998}] :answer-field/correct {:answer/id #uuid "b14f2ad2-72a2-5e49-bfaf-d442c2b9f197" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{yz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,i+\\frac{xz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{xy}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k" :db/id #edb/ref 17592186382997} :answer-field/id #uuid "640d3877-8db5-5d72-a910-f0495ca7df56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382993}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c11364f-7b1f-5610-8765-613e6f80f65c" :question/math-academy-id "q-122601" :question/problem "Find the gradient vector field of the function $f(x,y,z)=\\operatorname{arctan}⁡(xyz).$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(xyz)) \\\\  & =\\frac{yz}{{x}^{2}{y}^{2}{z}^{2}+1} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{arctan}⁡(xyz)) \\\\  & =\\frac{xz}{{x}^{2}{y}^{2}{z}^{2}+1} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{arctan}⁡(xyz)) \\\\  & =\\frac{xy}{{x}^{2}{y}^{2}{z}^{2}+1}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{yz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,i+\\frac{zz}{{x}^{2}{y}^{2}{z}^{2}+1}\\,j+\\frac{xy}{{x}^{2}{y}^{2}{z}^{2}+1}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186382999 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "605c17ba-53c0-5224-8301-c7161947f7df" :answer/type {:db/ident :answer.type/math} :answer/value "(2xz+{y}^{3})\\,i+(6x{y}^{2}+{z}^{4})\\,j+(x-4y{z}^{3})\\,k" :db/id #edb/ref 17592186383001} {:answer/id #uuid "100cf2d7-b1cf-56bd-b4c5-b50e52dddf3e" :answer/type {:db/ident :answer.type/math} :answer/value "(xz+{y}^{3})\\,i+(3{y}^{2}-{z}^{4})\\,j+({x}^{2}-4{z}^{3})\\,k" :db/id #edb/ref 17592186383002} {:answer/id #uuid "cb18d096-f5eb-5578-ad2c-c68d07d3455d" :answer/type {:db/ident :answer.type/math} :answer/value "(2xz+{y}^{3})\\,i+(3x{y}^{2}-{z}^{4})\\,j+({x}^{2}-4y{z}^{3})\\,k" :db/id #edb/ref 17592186383003} {:answer/id #uuid "8aee926a-f13b-525d-8f4f-67de6743fd6d" :answer/type {:db/ident :answer.type/math} :answer/value "(2xz+{y}^{2})\\,i+(6xy-{z}^{4})\\,j+({x}^{2}-8{y}^{3})\\,k" :db/id #edb/ref 17592186383004} {:answer/id #uuid "5fca2b8f-91e9-5173-9378-858ea3cdc4f4" :answer/type {:db/ident :answer.type/math} :answer/value "(2x+{y}^{2})\\,i+(3xy-{z}^{4})\\,j+({x}^{2}-8y{z}^{2})\\,k" :db/id #edb/ref 17592186383005}] :answer-field/correct {:answer/id #uuid "cb18d096-f5eb-5578-ad2c-c68d07d3455d" :answer/type {:db/ident :answer.type/math} :answer/value "(2xz+{y}^{3})\\,i+(3x{y}^{2}-{z}^{4})\\,j+({x}^{2}-4y{z}^{3})\\,k" :db/id #edb/ref 17592186383003} :answer-field/id #uuid "732edbd7-fdd5-57cd-93ab-a2bf9f45302a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d9bc952c-6483-5cda-bd93-71113b0eb352" :question/math-academy-id "q-122617" :question/problem "Find the gradient vector field of the function $f(x,y,z)=z{x}^{2}+x{y}^{3}-y{z}^{4}.$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & =2xz+{y}^{3} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & =3x{y}^{2}-{z}^{4} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(z{x}^{2}+x{y}^{3}-y{z}^{4}) \\\\  & ={x}^{2}-4y{z}^{3}\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =(2xz+{y}^{3})\\,i+(3x{y}^{2}-{z}^{4})\\,j+({x}^{2}-4y{z}^{3})\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387256 :knowledge-point/_questions [{:knowledge-point/id #uuid "bd5c5fd8-409c-5b92-a0f1-4466c76cdbe0" :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbd8e3fe-9258-5fd4-ac38-46ac64db6bc7" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡(x-2y)\\,i-{sec}^{2}⁡(x-2y)\\,j" :db/id #edb/ref 17592186387258} {:answer/id #uuid "da8671ca-6c00-5ad9-a9e3-7c2197ed1890" :answer/type {:db/ident :answer.type/math} :answer/value "x{sec}^{2}⁡(x-2y)\\,i-2y{sec}^{2}⁡(x-2y)\\,j" :db/id #edb/ref 17592186387259} {:answer/id #uuid "e5372737-b3d4-5fdf-b4fd-fc53a2121ec8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(x-2y)\\,i-2\\operatorname{sec}⁡(x-2y)\\,j" :db/id #edb/ref 17592186387260} {:answer/id #uuid "0bcb5dce-0d72-5149-b95d-b553c17f8c50" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sec}⁡(x-2y)\\,i+\\operatorname{sec}⁡(x-2y)\\,j" :db/id #edb/ref 17592186387261} {:answer/id #uuid "d4e00fb2-b549-5885-b25c-39af3314dd26" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡(x-2y)\\,i-2{sec}^{2}⁡(x-2y)\\,j" :db/id #edb/ref 17592186387262}] :answer-field/correct {:answer/id #uuid "d4e00fb2-b549-5885-b25c-39af3314dd26" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡(x-2y)\\,i-2{sec}^{2}⁡(x-2y)\\,j" :db/id #edb/ref 17592186387262} :answer-field/id #uuid "b1c2ee55-5d94-5079-b34c-8536d3fd9a20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9b6323d-ff08-50ce-be1a-fa1f61c66864" :question/math-academy-id "q-122608" :question/problem "Find the gradient vector field of the function $f(x,y)=\\operatorname{tan}⁡(x-2y).$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{tan}⁡(x-2y)) \\\\  & ={sec}^{2}⁡(x-2y) \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{tan}⁡(x-2y)) \\\\  & =-2{sec}^{2}⁡(x-2y)\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & ={sec}^{2}⁡(x-2y)\\,i-2{sec}^{2}⁡(x-2y)\\,j.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Gradient Vector Field of a Function"}]}
