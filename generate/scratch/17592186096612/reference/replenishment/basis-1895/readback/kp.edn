#{[{:db/id #edb/ref 17592186096612 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/math-academy-id "e-3626" :question/problem "Given that $f(x)=3 \\cdot 2^x$, find $f'(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\eqalign{\n\t\tf'(x)      &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3 \\cdot 2^x\\right) \\\n                            &= 3 \\cdot \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(2^x\\right) \\\n                            &=  3 \\cdot 2^{x}\\ln(2) \\\n                            &=  3 \\ln(2) \\cdot 2^{x}.\n\t}\n$$"} :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/question-generator {:db/id #edb/ref 17592186479997 :question-generator/id #uuid "1a5c3131-e07d-52bf-8fa5-e96ba318a4bc" :question-generator/script "generate/scratch/17592186096612.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186096991 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d843f8b3-130e-58a5-9fbd-82ec568db2c1" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5 \\cdot 2^{x}" :db/id #edb/ref 17592186093921} {:answer/id #uuid "014e0413-2e84-53f7-b45a-ddf3de5c66ed" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\frac{5 \\cdot 2^{x}}{\\ln 2}" :db/id #edb/ref 17592186093922} {:answer/id #uuid "59ffeb59-c600-576e-b386-4238d5be4435" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\frac{5\\ln 2}{2^{x}}" :db/id #edb/ref 17592186093923} {:answer/id #uuid "6a7bb843-7ffc-5cee-ae0d-c06b53bc9748" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5\\ln 2 \\cdot 2^{x}" :db/id #edb/ref 17592186093924}] :answer-field/id #uuid "391923fc-8733-5f78-b82d-8361511793c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093920}] :question/id #uuid "991df192-1bbb-5ddd-b9f8-9c449c0a2bfd" :question/math-academy-id "q-11732" :question/problem "Given that $f(x) = 5 \\cdot 2^{x}$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186097155 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84fac42b-8598-507e-a597-b51cf44552e7" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x}\\ln 4 + 3e^{x}" :db/id #edb/ref 17592186094904} {:answer/id #uuid "9f573042-c991-5b93-95cd-f442a342ef79" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\ln 4 + 3e^{x}" :db/id #edb/ref 17592186094905} {:answer/id #uuid "a83c0a13-5121-5e13-b635-203e453d1fae" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x} - \\ln 4 + 3e^{x}" :db/id #edb/ref 17592186094906} {:answer/id #uuid "e39ac619-c915-5405-9fdf-5d74bfe05e0e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x}\\ln x + 3e^{x}" :db/id #edb/ref 17592186094907} {:answer/id #uuid "71daaeac-c06c-5a66-a1ba-95951dbcd11e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x} + 3e^{x}" :db/id #edb/ref 17592186094908}] :answer-field/id #uuid "4b148928-ba92-5c24-b71d-675d583ec080" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094903}] :question/id #uuid "e0af69f1-1a58-5ac7-90e2-c2859723b842" :question/math-academy-id "q-1917" :question/problem "Given that $f(x) = 4^{x} + 3e^{x}$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186253334 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253210}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284697 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dbb468a-9928-5c35-89ed-eaf197f78886" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186281954} {:answer/id #uuid "618693f7-594d-59ce-a534-76a8e9e2b379" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5" :db/id #edb/ref 17592186282519} {:answer/id #uuid "888a6635-e022-5c1a-a6c7-78955c8928cd" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5e" :db/id #edb/ref 17592186282867} {:answer/id #uuid "8957ae1d-f55e-532c-822e-e38dcfa2b32c" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3" :db/id #edb/ref 17592186282874} {:answer/id #uuid "956605d2-ce2e-57d7-b286-ab43b24751bd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186282979}] :answer-field/correct {:answer/id #uuid "618693f7-594d-59ce-a534-76a8e9e2b379" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5" :db/id #edb/ref 17592186282519} :answer-field/id #uuid "a7e9ba42-2c84-571b-94b9-4df571509ab4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284227}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e51c642-d912-5d35-8cf2-7c273fba130d" :question/math-academy-id "q-17388" :question/problem "Given that $f(x)={3}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}y}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+5\\frac{\\text{d}y}{\\text{d}x}({e}^{x}) \\\\  & ={3}^{x}ln⁡3+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({3}^{x}ln⁡3+5{e}^{x})|}_{x=0} \\\\  & ={3}^{0}ln⁡3+5{e}^{0} \\\\  & =1\\cdot ln⁡3+5\\cdot 1 \\\\  & =ln⁡3+5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297290 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3554bc38-45ed-5174-b2e0-b7a82dde78d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}(8){8}^{x}+12" :db/id #edb/ref 17592186295565}] :answer-field/correct {:answer/id #uuid "3554bc38-45ed-5174-b2e0-b7a82dde78d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}(8){8}^{x}+12" :db/id #edb/ref 17592186295565} :answer-field/id #uuid "0a6fdabb-ec35-5bee-8e6f-6b6e93c3ccd5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" :question/math-academy-id "q-304038" :question/problem "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(ln⁡(8){8}^{x})+12(1)+0 \\\\  & =3ln⁡(8){8}^{x}+12.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314919 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202a3876-df45-5f69-9dea-3b48cc477974" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(8){8}^{x}" :db/id #edb/ref 17592186312218} {:answer/id #uuid "4ad5377e-557d-4b02-81f5-eba612380c71" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot8^{x}\\ln8" :db/id #edb/ref 17592186409340}] :answer-field/correct {:answer/id #uuid "202a3876-df45-5f69-9dea-3b48cc477974" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(8){8}^{x}" :db/id #edb/ref 17592186312218} :answer-field/id #uuid "5168e7a2-5958-57af-b48a-ff61e1073f47" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca876738-9b8d-5832-85d7-2d09df78130a" :question/math-academy-id "q-340272" :question/problem "Given that $f(x)=7-2\\cdot {8}^{x}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(7-2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-\\frac{\\text{d}}{\\text{d}x}(2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-2\\frac{\\text{d}}{\\text{d}x}({8}^{x}) \\\\  & =0-2(ln⁡(8){8}^{x}) \\\\  & =-2ln⁡(8){8}^{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314920 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40066746-e699-53ed-82fd-0f35f8e924c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(5)+4" :db/id #edb/ref 17592186312491} {:answer/id #uuid "8688c450-e972-4ef8-abf7-296b751229f8" :answer/type {:db/ident :answer.type/math} :answer/value "5^{x}\\ln5-18x^2+4" :db/id #edb/ref 17592186409339}] :answer-field/correct {:answer/id #uuid "40066746-e699-53ed-82fd-0f35f8e924c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(5)+4" :db/id #edb/ref 17592186312491} :answer-field/id #uuid "d4ba52fe-3ccd-59f7-bca4-208b03b18375" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186314595}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3624c-f62d-5f81-b0de-c13d8e4bf17c" :question/math-academy-id "q-340280" :question/problem "Given that $f(x)={5}^{x}-6{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-6{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-6\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =ln⁡(5)\\cdot {5}^{x}-6(3{x}^{2})+4(1)-0 \\\\  & =ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4)|}_{x=0} \\\\  & =ln⁡(5)\\cdot {5}^{0}-18(0)^{2}+4 \\\\  & =ln⁡(5)\\cdot 1-0+4 \\\\  & =ln⁡(5)+4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479956 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aeb0bf4-6520-54f3-84ca-e7dbe38f5e64" :answer/type {:db/ident :answer.type/math} :answer/value "-8 + 4 \\ln{\\left(4 \\right)} + 6 \\ln{\\left(6 \\right)}" :db/id #edb/ref 17592186479957}] :answer-field/correct {:answer/id #uuid "4aeb0bf4-6520-54f3-84ca-e7dbe38f5e64" :answer/type {:db/ident :answer.type/math} :answer/value "-8 + 4 \\ln{\\left(4 \\right)} + 6 \\ln{\\left(6 \\right)}" :db/id #edb/ref 17592186479957} :answer-field/id #uuid "6313bb94-d522-5522-b2bb-4714924f3544" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479966}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4ab89b2e-90ef-5667-856a-b34e71dd8ca6" :question/problem "Given that $f(x)=1\\cdot {4}^{x}+1\\cdot {6}^{x}-4x^2+2$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {4}^{x}+1\\cdot {6}^{x}-4x^2+2) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({4}^{x})+1\\frac{\\text{d}}{\\text{d}x}({6}^{x})-4\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(2) \\\\ &=1({4}^{x}\\ln(4))+1({6}^{x}\\ln(6))-4(2x)+0 \\\\ &=1\\ln(4)\\cdot {4}^{x}+1\\ln(6)\\cdot {6}^{x}-8x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=1\\ln(4)\\cdot {4}^{(1)}+1\\ln(6)\\cdot {6}^{(1)}-8(1) \\\\ &=1(4)\\ln(4)+1(6)\\ln(6)-(8)(1) \\\\ &=-8 + 4 \\ln{\\left(4 \\right)} + 6 \\ln{\\left(6 \\right)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479960 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e51092c-d3e1-5116-8c4b-6104b8f6691c" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 6+5" :db/id #edb/ref 17592186479945} {:answer/id #uuid "1f3f4162-2d0a-5c5d-82e4-1a26519c89c5" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186479947} {:answer/id #uuid "438a7220-979d-55dc-93b4-36a1d239218c" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 6+5e" :db/id #edb/ref 17592186479954} {:answer/id #uuid "556ea93d-c41f-51e1-a3d5-3a153a74e606" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 6" :db/id #edb/ref 17592186479963} {:answer/id #uuid "c713293d-b983-5584-b151-359e1e3a8af8" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186479985}] :answer-field/correct {:answer/id #uuid "1e51092c-d3e1-5116-8c4b-6104b8f6691c" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 6+5" :db/id #edb/ref 17592186479945} :answer-field/id #uuid "380060b1-e35e-58d8-84f1-6cb9bb1b875b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50148e2c-17f0-5238-804f-16d18ed920ad" :question/problem "Given that $f(x)={6}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})+5\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={6}^{x}\\ln 6+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({6}^{x}\\ln 6+5{e}^{x})|}_{x=0} \\\\  & ={6}^{0}\\ln 6+5{e}^{0} \\\\  & =1\\cdot \\ln 6+5\\cdot 1 \\\\  & =\\ln 6+5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479964 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a365ca2-5ab7-52ee-86cd-fb394593b722" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5\\ln 6 \\cdot 6^{x}" :db/id #edb/ref 17592186479943} {:answer/id #uuid "47d06226-53d8-5941-b3c8-57f4b6d26521" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\frac{5 \\cdot 6^{x}}{\\ln 6}" :db/id #edb/ref 17592186479955} {:answer/id #uuid "4c07586b-bfcb-537a-b1fb-2b79dc2f5e73" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5 \\cdot 6^{x}" :db/id #edb/ref 17592186479959} {:answer/id #uuid "9c668813-4911-52df-9d8f-1db1a154f06d" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\frac{5\\ln 6}{6^{x}}" :db/id #edb/ref 17592186479975}] :answer-field/correct {:answer/id #uuid "1a365ca2-5ab7-52ee-86cd-fb394593b722" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5\\ln 6 \\cdot 6^{x}" :db/id #edb/ref 17592186479943} :answer-field/id #uuid "e502cf59-d006-5ace-b672-bda7877dea87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479992}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "582239d0-9d5e-5fbf-8b8c-312d6a4b25f3" :question/problem "Given that $f(x) = 5 \\cdot 6^{x}$, find $f^{′}(x)$." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f^{′}(x)&=\\frac{\\text{d}}{\\text{d}x}(5 \\cdot 6^{x}) \\\\ &=5\\frac{\\text{d}}{\\text{d}x}(6^{x}) \\\\ &=5\\cdot 6^{x}\\ln 6 \\\\ &=5\\ln 6\\cdot 6^{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479971 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0974458e-0961-5167-8ad4-e1309d0ae754" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 9^{x}\\ln 9 + 1e^{x}" :db/id #edb/ref 17592186479939} {:answer/id #uuid "5318e5a2-acb6-5e71-87f4-d99f47409c40" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 9^{x}\\ln x + 1e^{x}" :db/id #edb/ref 17592186479962} {:answer/id #uuid "7c1666d9-fc22-5280-b9e3-06885b9cb63f" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 9^{x} - \\ln 9 + 1e^{x}" :db/id #edb/ref 17592186479969} {:answer/id #uuid "919857fc-e70c-526e-a79f-525acbd3e360" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\ln 9 + 1e^{x}" :db/id #edb/ref 17592186479972} {:answer/id #uuid "c6810a92-2551-5614-8f22-f14a131a7075" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 9^{x} + 1e^{x}" :db/id #edb/ref 17592186479983}] :answer-field/correct {:answer/id #uuid "0974458e-0961-5167-8ad4-e1309d0ae754" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 9^{x}\\ln 9 + 1e^{x}" :db/id #edb/ref 17592186479939} :answer-field/id #uuid "a1c87bdf-fdd9-50e0-87ae-bfebec2cd470" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90f05299-4aec-5aef-a19d-5af09d844fc9" :question/problem "Given that $f(x) = 9^{x} + 1e^{x}$, find $f^{′}(x)$." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f^{′}(x)&=\\frac{\\text{d}}{\\text{d}x}(9^{x}+1e^{x}) \\\\ &=\\frac{\\text{d}}{\\text{d}x}(9^{x})+\\frac{\\text{d}}{\\text{d}x}(1e^{x}) \\\\ &=\\frac{\\text{d}}{\\text{d}x}(9^{x})+1\\frac{\\text{d}}{\\text{d}x}(e^{x}) \\\\ &=9^{x}\\ln 9+1e^{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479973 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4c4d6ce-eae8-5698-8a06-e802f4a7110c" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{ln}(8){8}^{x}+4" :db/id #edb/ref 17592186479995}] :answer-field/correct {:answer/id #uuid "f4c4d6ce-eae8-5698-8a06-e802f4a7110c" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{ln}(8){8}^{x}+4" :db/id #edb/ref 17592186479995} :answer-field/id #uuid "153040ec-2f1d-57f2-94a2-a6698348250e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9227db0a-2b43-5781-8e85-e3ce3701dc2c" :question/problem "Given that $f(x)=6\\cdot {8}^{x}+4x+1$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6\\cdot {8}^{x}+4x+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(4x)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({8}^{x})+4\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =6(\\ln (8){8}^{x})+4(1)+0 \\\\  & =6\\ln (8){8}^{x}+4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479974 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1effc6d0-4ffd-54ee-ae51-938082d0c759" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\ln 3-18{x}^{2}+5x-8" :db/id #edb/ref 17592186479946} {:answer/id #uuid "50810c07-9dc6-5ea3-ab5c-e7a4ec12cd3b" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\ln 3-18x+5" :db/id #edb/ref 17592186479961} {:answer/id #uuid "71e4303f-2cb8-5794-8a65-c6a5fbf5fd10" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}-18{x}^{2}+5x-8" :db/id #edb/ref 17592186479968} {:answer/id #uuid "ab5027c2-741f-585e-97b1-d190fdf7a3b6" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\ln 3-18{x}^{2}+5x" :db/id #edb/ref 17592186479979} {:answer/id #uuid "c8a51ad8-2144-5bc7-b381-0b29f932353b" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}-18x+5" :db/id #edb/ref 17592186479986}] :answer-field/correct {:answer/id #uuid "50810c07-9dc6-5ea3-ab5c-e7a4ec12cd3b" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\ln 3-18x+5" :db/id #edb/ref 17592186479961} :answer-field/id #uuid "0e72986c-3832-522f-9c7e-a509db51c3ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479940}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b5eb51d-f8f2-5555-81b1-c63476f8f13a" :question/problem "Given that $f(x)={3}^{x}-9{x}^{2}+5x-8$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}-9{x}^{2}+5x-8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})-\\frac{\\text{d}}{\\text{d}x}(9{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(5x)-\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})-9\\frac{\\text{d}}{\\text{d}x}({x}^{2})+5\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =\\ln 3\\cdot {3}^{x}-9(2x)+5(1)-0 \\\\  & ={3}^{x}\\ln 3-18x+5.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479976 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138898b9-4af5-5535-81f9-456eac6dafb1" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186479941} {:answer/id #uuid "2d633930-83b6-5170-91ee-c8b602b05717" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3" :db/id #edb/ref 17592186479949} {:answer/id #uuid "3889ffd3-bc1c-5c0b-aa43-9218149df384" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3+9e" :db/id #edb/ref 17592186479951} {:answer/id #uuid "a00ddb8a-1032-535c-b09f-538e89c0a5de" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186479977} {:answer/id #uuid "f0eb3dd0-5c98-5022-b7b6-8637f65379f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3+9" :db/id #edb/ref 17592186479994}] :answer-field/correct {:answer/id #uuid "f0eb3dd0-5c98-5022-b7b6-8637f65379f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 3+9" :db/id #edb/ref 17592186479994} :answer-field/id #uuid "4284cb3a-6e4c-5f95-ae83-be3a69e86d44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f8d11c7-1ce6-57ae-a750-00abfd861493" :question/problem "Given that $f(x)={3}^{x}+9{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+9{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+9\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={3}^{x}\\ln 3+9{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({3}^{x}\\ln 3+9{e}^{x})|}_{x=0} \\\\  & ={3}^{0}\\ln 3+9{e}^{0} \\\\  & =1\\cdot \\ln 3+9\\cdot 1 \\\\  & =\\ln 3+9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479981 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f4f1e26-0df1-5702-bdec-b5281727c6d9" :answer/type {:db/ident :answer.type/math} :answer/value "-8 + 4 \\ln{\\left(2 \\right)} + 12 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186479967}] :answer-field/correct {:answer/id #uuid "6f4f1e26-0df1-5702-bdec-b5281727c6d9" :answer/type {:db/ident :answer.type/math} :answer/value "-8 + 4 \\ln{\\left(2 \\right)} + 12 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186479967} :answer-field/id #uuid "3be937f6-63dd-586b-80ec-62e5ec5c1607" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479952}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b4aa7414-d170-5940-95df-f23e78929052" :question/problem "Given that $f(x)=2\\cdot {2}^{x}+3\\cdot {4}^{x}-4x^2+5$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {2}^{x}+3\\cdot {4}^{x}-4x^2+5) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({2}^{x})+3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-4\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(5) \\\\ &=2({2}^{x}\\ln(2))+3({4}^{x}\\ln(4))-4(2x)+0 \\\\ &=2\\ln(2)\\cdot {2}^{x}+3\\ln(4)\\cdot {4}^{x}-8x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=2\\ln(2)\\cdot {2}^{(1)}+3\\ln(4)\\cdot {4}^{(1)}-8(1) \\\\ &=2(2)\\ln(2)+3(4)\\ln(4)-(8)(1) \\\\ &=-8 + 4 \\ln{\\left(2 \\right)} + 12 \\ln{\\left(4 \\right)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479982 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4869b3d-a551-578e-a73d-73a4cf16b134" :answer/type {:db/ident :answer.type/math} :answer/value "-6 + 5 \\ln{\\left(5 \\right)} + 8 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186479980}] :answer-field/correct {:answer/id #uuid "b4869b3d-a551-578e-a73d-73a4cf16b134" :answer/type {:db/ident :answer.type/math} :answer/value "-6 + 5 \\ln{\\left(5 \\right)} + 8 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186479980} :answer-field/id #uuid "629f9d4a-7523-59be-b010-65e9c6471063" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b995540b-f7ab-55d7-8f91-c51d207d2180" :question/problem "Given that $f(x)=2\\cdot {4}^{x}+1\\cdot {5}^{x}-3x^2+4$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {4}^{x}+1\\cdot {5}^{x}-3x^2+4) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({4}^{x})+1\\frac{\\text{d}}{\\text{d}x}({5}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(4) \\\\ &=2({4}^{x}\\ln(4))+1({5}^{x}\\ln(5))-3(2x)+0 \\\\ &=2\\ln(4)\\cdot {4}^{x}+1\\ln(5)\\cdot {5}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=2\\ln(4)\\cdot {4}^{(1)}+1\\ln(5)\\cdot {5}^{(1)}-6(1) \\\\ &=2(4)\\ln(4)+1(5)\\ln(5)-(6)(1) \\\\ &=-6 + 5 \\ln{\\left(5 \\right)} + 8 \\ln{\\left(4 \\right)}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479989 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9d9676-be2e-55f1-8608-d21cf8ae6b8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6" :db/id #edb/ref 17592186479944}] :answer-field/correct {:answer/id #uuid "1a9d9676-be2e-55f1-8608-d21cf8ae6b8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6" :db/id #edb/ref 17592186479944} :answer-field/id #uuid "c6f7efb5-5352-5998-97f1-7e7dd561f8f9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479984}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cf41a068-fd0d-5f4b-9f3b-52ecb794226b" :question/problem "Given that $f(x)=1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({5}^{x})+2\\frac{\\text{d}}{\\text{d}x}({2}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ &=1({5}^{x}\\ln(5))+2({2}^{x}\\ln(2))-3(2x)+0 \\\\ &=1\\ln(5)\\cdot {5}^{x}+2\\ln(2)\\cdot {2}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=1\\ln(5)\\cdot {5}^{(-1)}+2\\ln(2)\\cdot {2}^{(-1)}-6(-1) \\\\ &=1(\\frac{1}{5})\\ln(5)+2(\\frac{1}{2})\\ln(2)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479990 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9021f83-6294-555f-bcd9-a15ccc5b51f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(7)+4" :db/id #edb/ref 17592186479988}] :answer-field/correct {:answer/id #uuid "c9021f83-6294-555f-bcd9-a15ccc5b51f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(7)+4" :db/id #edb/ref 17592186479988} :answer-field/id #uuid "c8ce2289-eac0-5c76-8dde-55e8e77cadfd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479987}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df5079ea-2748-53c3-9b3e-39ecdb2bea5f" :question/problem "Given that $f(x)={7}^{x}-7{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}-7{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({7}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({7}^{x})-7\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\ln (7)\\cdot {7}^{x}-7(3{x}^{2})+4(1)-0 \\\\  & =\\ln (7)\\cdot {7}^{x}-21{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(\\ln (7)\\cdot {7}^{x}-21{x}^{2}+4)|}_{x=0} \\\\  & =\\ln (7)\\cdot {7}^{0}-21(0)^{2}+4 \\\\  & =\\ln (7)\\cdot 1-0+4 \\\\  & =\\ln (7)+4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479993 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27addd41-1b34-5638-873b-b749efd9cbcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(9)+2" :db/id #edb/ref 17592186479948}] :answer-field/correct {:answer/id #uuid "27addd41-1b34-5638-873b-b749efd9cbcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(9)+2" :db/id #edb/ref 17592186479948} :answer-field/id #uuid "e1395a30-edad-54d2-9382-c62a8875aa3f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec00e600-a612-5a76-94ca-79ecaa3d171e" :question/problem "Given that $f(x)={9}^{x}-1{x}^{3}+2x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({9}^{x}-1{x}^{3}+2x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-\\frac{\\text{d}}{\\text{d}x}(1{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({9}^{x})-1\\frac{\\text{d}}{\\text{d}x}({x}^{3})+2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(6) \\\\  & =\\ln (9)\\cdot {9}^{x}-1(3{x}^{2})+2(1)-0 \\\\  & =\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(\\ln (9)\\cdot {9}^{x}-3{x}^{2}+2)|}_{x=0} \\\\  & =\\ln (9)\\cdot {9}^{0}-3(0)^{2}+2 \\\\  & =\\ln (9)\\cdot 1-0+2 \\\\  & =\\ln (9)+2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479996 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6645ee-3c3d-53ef-9146-60dda2be4d17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(3 \\right)}}{3} + \\frac{\\ln{\\left(6 \\right)}}{3} + 6" :db/id #edb/ref 17592186479958}] :answer-field/correct {:answer/id #uuid "4b6645ee-3c3d-53ef-9146-60dda2be4d17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(3 \\right)}}{3} + \\frac{\\ln{\\left(6 \\right)}}{3} + 6" :db/id #edb/ref 17592186479958} :answer-field/id #uuid "8d4c7dd4-b186-55cd-b20f-586c239c7e13" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186479970}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8120d99-4d4d-56ef-af5e-c92f6fe86369" :question/problem "Given that $f(x)=2\\cdot {6}^{x}+1\\cdot {3}^{x}-3x^2+2$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {6}^{x}+1\\cdot {3}^{x}-3x^2+2) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({6}^{x})+1\\frac{\\text{d}}{\\text{d}x}({3}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(2) \\\\ &=2({6}^{x}\\ln(6))+1({3}^{x}\\ln(3))-3(2x)+0 \\\\ &=2\\ln(6)\\cdot {6}^{x}+1\\ln(3)\\cdot {3}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=2\\ln(6)\\cdot {6}^{(-1)}+1\\ln(3)\\cdot {3}^{(-1)}-6(-1) \\\\ &=2(\\frac{1}{6})\\ln(6)+1(\\frac{1}{3})\\ln(3)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(3 \\right)}}{3} + \\frac{\\ln{\\left(6 \\right)}}{3} + 6.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}]}
