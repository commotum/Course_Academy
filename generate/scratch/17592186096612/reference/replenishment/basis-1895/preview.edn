\\\  & =6\\ln (8){8}^{x}+4.\\end{aligned}\n$$" 13194139535208 17592186045443 true] [17592186479974 1068 #edb/ref 17592186479940 13194139535208 17592186045443 true] [17592186479974 1070 #edb/ref 17592186045485 13194139535208 17592186045443 true] [17592186479974 1071 "Given that $f(x)={3}^{x}-9{x}^{2}+5x-8$, find ${f}^{′}(x).$" 13194139535208 17592186045443 true] [17592186479974 1072 #uuid "9b5eb51d-f8f2-5555-81b1-c63476f8f13a" 13194139535208 17592186045443 true] [17592186479974 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}-9{x}^{2}+5x-8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})-\\frac{\\text{d}}{\\text{d}x}(9{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(5x)-\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})-9\\frac{\\text{d}}{\\text{d}x}({x}^{2})+5\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =\\ln 3\\cdot {3}^{x}-9(2x)+5(1)-0 \\\\  & ={3}^{x}\\ln 3-18x+5.\\end{aligned}\n$$" 13194139535208 17592186045443 true] [17592186479975 1080 "f^{′}(x) = \\frac{5\\ln 6}{6^{x}}" 13194139535208 17592186045443 true] [17592186479975 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479975 1083 #uuid "9c668813-4911-52df-9d8f-1db1a154f06d" 13194139535208 17592186045443 true] [17592186479976 1068 #edb/ref 17592186479953 13194139535208 17592186045443 true] [17592186479976 1070 #edb/ref 17592186045487 13194139535208 17592186045443 true] [17592186479976 1071 "Given that $f(x)={3}^{x}+9{e}^{x}$, find the instantaneous rate of change at $x=0.$" 13194139535208 17592186045443 true] [17592186479976 1072 #uuid "9f8d11c7-1ce6-57ae-a750-00abfd861493" 13194139535208 17592186045443 true] [17592186479976 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+9{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}}{\\text{d}x}(9{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+9\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & ={3}^{x}\\ln 3+9{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({3}^{x}\\ln 3+9{e}^{x})|}_{x=0} \\\\  & ={3}^{0}\\ln 3+9{e}^{0} \\\\  & =1\\cdot \\ln 3+9\\cdot 1 \\\\  & =\\ln 3+9.\\end{aligned}\n$$" 13194139535208 17592186045443 true] [17592186479977 1080 "9" 13194139535208 17592186045443 true] [17592186479977 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479977 1083 #uuid "a00ddb8a-1032-535c-b09f-538e89c0a5de" 13194139535208 17592186045443 true] [17592186479978 1075 #edb/ref 17592186479939 13194139535208 17592186045443 true] [17592186479978 1075 #edb/ref 17592186479962 13194139535208 17592186045443 true] [17592186479978 1075 #edb/ref 17592186479969 13194139535208 17592186045443 true] [17592186479978 1075 #edb/ref 17592186479972 13194139535208 17592186045443 true] [17592186479978 1075 #edb/ref 17592186479983 13194139535208 17592186045443 true] [17592186479978 1076 #edb/ref 17592186045493 13194139535208 17592186045443 true] [17592186479978 1077 "selection" 13194139535208 17592186045443 true] [17592186479978 1078 #edb/ref 17592186479939 13194139535208 17592186045443 true] [17592186479978 1079 #uuid "a1c87bdf-fdd9-50e0-87ae-bfebec2cd470" 13194139535208 17592186045443 true] [17592186479979 1080 "{3}^{x}\\ln 3-18{x}^{2}+5x" 13194139535208 17592186045443 true] [17592186479979 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479979 1083 #uuid "ab5027c2-741f-585e-97b1-d190fdf7a3b6" 13194139535208 17592186045443 true] [17592186479980 1080 "-6 + 5 \\ln{\\left(5 \\right)} + 8 \\ln{\\left(4 \\right)}" 13194139535208 17592186045443 true] [17592186479980 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479980 1083 #uuid "b4869b3d-a551-578e-a73d-73a4cf16b134" 13194139535208 17592186045443 true] [17592186479981 1068 #edb/ref 17592186479952 13194139535208 17592186045443 true] [17592186479981 1070 #edb/ref 17592186045486 13194139535208 17592186045443 true] [17592186479981 1071 "Given that $f(x)=2\\cdot {2}^{x}+3\\cdot {4}^{x}-4x^2+5$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" 13194139535208 17592186045443 true] [17592186479981 1072 #uuid "b4aa7414-d170-5940-95df-f23e78929052" 13194139535208 17592186045443 true] [17592186479981 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {2}^{x}+3\\cdot {4}^{x}-4x^2+5) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({2}^{x})+3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-4\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(5) \\\\ &=2({2}^{x}\\ln(2))+3({4}^{x}\\ln(4))-4(2x)+0 \\\\ &=2\\ln(2)\\cdot {2}^{x}+3\\ln(4)\\cdot {4}^{x}-8x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=2\\ln(2)\\cdot {2}^{(1)}+3\\ln(4)\\cdot {4}^{(1)}-8(1) \\\\ &=2(2)\\ln(2)+3(4)\\ln(4)-(8)(1) \\\\ &=-8 + 4 \\ln{\\left(2 \\right)} + 12 \\ln{\\left(4 \\right)}.\\end{aligned}\n$$" 13194139535208 17592186045443 true] [17592186479982 1068 #edb/ref 17592186479965 13194139535208 17592186045443 true] [17592186479982 1070 #edb/ref 17592186045486 13194139535208 17592186045443 true] [17592186479982 1071 "Given that $f(x)=2\\cdot {4}^{x}+1\\cdot {5}^{x}-3x^2+4$, find the instantaneous rate of change at $x=1.$\n\n{{field-1}}" 13194139535208 17592186045443 true] [17592186479982 1072 #uuid "b995540b-f7ab-55d7-8f91-c51d207d2180" 13194139535208 17592186045443 true] [17592186479982 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(2\\cdot {4}^{x}+1\\cdot {5}^{x}-3x^2+4) \\\\ &=2\\frac{\\text{d}}{\\text{d}x}({4}^{x})+1\\frac{\\text{d}}{\\text{d}x}({5}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(4) \\\\ &=2({4}^{x}\\ln(4))+1({5}^{x}\\ln(5))-3(2x)+0 \\\\ &=2\\ln(4)\\cdot {4}^{x}+1\\ln(5)\\cdot {5}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is\n\n$$\n\\begin{aligned}f'(1)&=2\\ln(4)\\cdot {4}^{(1)}+1\\ln(5)\\cdot {5}^{(1)}-6(1) \\\\ &=2(4)\\ln(4)+1(5)\\ln(5)-(6)(1) \\\\ &=-6 + 5 \\ln{\\left(5 \\right)} + 8 \\ln{\\left(4 \\right)}.\\end{aligned}\n$$" 13194139535208 17592186045443 true] [17592186479983 1080 "f^{′}(x) = 9^{x} + 1e^{x}" 13194139535208 17592186045443 true] [17592186479983 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479983 1083 #uuid "c6810a92-2551-5614-8f22-f14a131a7075" 13194139535208 17592186045443 true] [17592186479984 1075 #edb/ref 17592186479944 13194139535208 17592186045443 true] [17592186479984 1076 #edb/ref 17592186045492 13194139535208 17592186045443 true] [17592186479984 1077 "field-1" 13194139535208 17592186045443 true] [17592186479984 1078 #edb/ref 17592186479944 13194139535208 17592186045443 true] [17592186479984 1079 #uuid "c6f7efb5-5352-5998-97f1-7e7dd561f8f9" 13194139535208 17592186045443 true] [17592186479985 1080 "6" 13194139535208 17592186045443 true] [17592186479985 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479985 1083 #uuid "c713293d-b983-5584-b151-359e1e3a8af8" 13194139535208 17592186045443 true] [17592186479986 1080 "{3}^{x}-18x+5" 13194139535208 17592186045443 true] [17592186479986 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479986 1083 #uuid "c8a51ad8-2144-5bc7-b381-0b29f932353b" 13194139535208 17592186045443 true] [17592186479987 1075 #edb/ref 17592186479988 13194139535208 17592186045443 true] [17592186479987 1076 #edb/ref 17592186045492 13194139535208 17592186045443 true] [17592186479987 1077 "field-1" 13194139535208 17592186045443 true] [17592186479987 1078 #edb/ref 17592186479988 13194139535208 17592186045443 true] [17592186479987 1079 #uuid "c8ce2289-eac0-5c76-8dde-55e8e77cadfd" 13194139535208 17592186045443 true] [17592186479988 1080 "\\operatorname{ln}(7)+4" 13194139535208 17592186045443 true] [17592186479988 1082 #edb/ref 17592186045498 13194139535208 17592186045443 true] [17592186479988 1083 #uuid "c9021f83-6294-555f-bcd9-a15ccc5b51f0" 13194139535208 17592186045443 true] [17592186479989 1068 #edb/ref 17592186479984 13194139535208 17592186045443 true] [17592186479989 1070 #edb/ref 17592186045486 13194139535208 17592186045443 true] [17592186479989 1071 "Given that $f(x)=1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1$, find the instantaneous rate of change at $x=-1.$\n\n{{field-1}}" 13194139535208 17592186045443 true] [17592186479989 1072 #uuid "cf41a068-fd0d-5f4b-9f3b-52ecb794226b" 13194139535208 17592186045443 true] [17592186479989 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}f'(x)&=\\frac{\\text{d}}{\\text{d}x}(1\\cdot {5}^{x}+2\\cdot {2}^{x}-3x^2+1) \\\\ &=1\\frac{\\text{d}}{\\text{d}x}({5}^{x})+2\\frac{\\text{d}}{\\text{d}x}({2}^{x})-3\\frac{\\text{d}}{\\text{d}x}(x^2)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ &=1({5}^{x}\\ln(5))+2({2}^{x}\\ln(2))-3(2x)+0 \\\\ &=1\\ln(5)\\cdot {5}^{x}+2\\ln(2)\\cdot {2}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=-1$ is\n\n$$\n\\begin{aligned}f'(-1)&=1\\ln(5)\\cdot {5}^{(-1)}+2\\ln(2)\\cdot {2}^{(-1)}-6(-1) \\\\ &=1(\\frac{1}{5})\\ln(5)+2(\\frac{1}{2})\\ln(2)-(6)(-1) \\\\ &=\\frac{\\ln{\\left(5 \\right)}}{5} + \\ln{\\left(2 \\right)} + 6.\\end{aligned}\n$$" 13194139535208 17592186045443 true] [17592186479990 1068 #edb/ref 17592186479987 13194139535208 17592186045443 true] [17592186479990 1070 #edb/ref 17592186045487 13194139535208 17592186045443 true] [17592186479990 1071 "Given that $f(x)={7}^{x}-7{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." 13194139535208 17592186045443 true] [17592186479990 1072 #uuid "df5079ea-2748-53c3-9b3e-39ecdb2bea5f" 13194139535208 17592186045443 true] [17592186479990 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}-7{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({7}^{x})-\\frac{\\text{d