{:db/id 17592186096612 :knowledge-point/canonical-example {:db/id 17592186096412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/id #uuid "16b1a91c-ae83-5e6b-a11d-bb9d78e4d218" :question/math-academy-id "e-3626" :question/problem "Given that $f(x)=3 \\cdot 2^x$, find $f'(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\eqalign{\n\t\tf'(x)      &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(3 \\cdot 2^x\\right) \\\n                            &= 3 \\cdot \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(2^x\\right) \\\n                            &=  3 \\cdot 2^{x}\\ln(2) \\\n                            &=  3 \\ln(2) \\cdot 2^{x}.\n\t}\n$$"} :knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/questions [{:db/id 17592186096991 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d843f8b3-130e-58a5-9fbd-82ec568db2c1" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5 \\cdot 2^{x}" :db/id 17592186093921} {:answer/id #uuid "014e0413-2e84-53f7-b45a-ddf3de5c66ed" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\frac{5 \\cdot 2^{x}}{\\ln 2}" :db/id 17592186093922} {:answer/id #uuid "59ffeb59-c600-576e-b386-4238d5be4435" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\frac{5\\ln 2}{2^{x}}" :db/id 17592186093923} {:answer/id #uuid "6a7bb843-7ffc-5cee-ae0d-c06b53bc9748" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 5\\ln 2 \\cdot 2^{x}" :db/id 17592186093924}] :answer-field/id #uuid "391923fc-8733-5f78-b82d-8361511793c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186093920}] :question/id #uuid "991df192-1bbb-5ddd-b9f8-9c449c0a2bfd" :question/math-academy-id "q-11732" :question/problem "Given that $f(x) = 5 \\cdot 2^{x}$, find $f^{′}(x)$."} {:db/id 17592186097155 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84fac42b-8598-507e-a597-b51cf44552e7" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x}\\ln 4 + 3e^{x}" :db/id 17592186094904} {:answer/id #uuid "9f573042-c991-5b93-95cd-f442a342ef79" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = \\ln 4 + 3e^{x}" :db/id 17592186094905} {:answer/id #uuid "a83c0a13-5121-5e13-b635-203e453d1fae" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x} - \\ln 4 + 3e^{x}" :db/id 17592186094906} {:answer/id #uuid "e39ac619-c915-5405-9fdf-5d74bfe05e0e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x}\\ln x + 3e^{x}" :db/id 17592186094907} {:answer/id #uuid "71daaeac-c06c-5a66-a1ba-95951dbcd11e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4^{x} + 3e^{x}" :db/id 17592186094908}] :answer-field/id #uuid "4b148928-ba92-5c24-b71d-675d583ec080" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186094903}] :question/id #uuid "e0af69f1-1a58-5ac7-90e2-c2859723b842" :question/math-academy-id "q-1917" :question/problem "Given that $f(x) = 4^{x} + 3e^{x}$, find $f^{′}(x)$."} {:db/id 17592186253334 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id 17592186251060} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}-10x+6" :db/id 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id 17592186252214}] :answer-field/correct {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/ident :answer.type/math} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186253210}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"} {:db/id 17592186284697 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dbb468a-9928-5c35-89ed-eaf197f78886" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id 17592186281954} {:answer/id #uuid "618693f7-594d-59ce-a534-76a8e9e2b379" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5" :db/id 17592186282519} {:answer/id #uuid "888a6635-e022-5c1a-a6c7-78955c8928cd" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5e" :db/id 17592186282867} {:answer/id #uuid "8957ae1d-f55e-532c-822e-e38dcfa2b32c" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3" :db/id 17592186282874} {:answer/id #uuid "956605d2-ce2e-57d7-b286-ab43b24751bd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id 17592186282979}] :answer-field/correct {:answer/id #uuid "618693f7-594d-59ce-a534-76a8e9e2b379" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡3+5" :db/id 17592186282519} :answer-field/id #uuid "a7e9ba42-2c84-571b-94b9-4df571509ab4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186284227}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e51c642-d912-5d35-8cf2-7c273fba130d" :question/math-academy-id "q-17388" :question/problem "Given that $f(x)={3}^{x}+5{e}^{x}$, find the instantaneous rate of change at $x=0.$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}y}{\\text{d}x}(5{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+5\\frac{\\text{d}y}{\\text{d}x}({e}^{x}) \\\\  & ={3}^{x}ln⁡3+5{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={({3}^{x}ln⁡3+5{e}^{x})|}_{x=0} \\\\  & ={3}^{0}ln⁡3+5{e}^{0} \\\\  & =1\\cdot ln⁡3+5\\cdot 1 \\\\  & =ln⁡3+5.\\end{aligned}\n$$"} {:db/id 17592186297290 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3554bc38-45ed-5174-b2e0-b7a82dde78d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}(8){8}^{x}+12" :db/id 17592186295565}] :answer-field/correct {:answer/id #uuid "3554bc38-45ed-5174-b2e0-b7a82dde78d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}(8){8}^{x}+12" :db/id 17592186295565} :answer-field/id #uuid "0a6fdabb-ec35-5bee-8e6f-6b6e93c3ccd5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186296661}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4df22161-f9b7-5077-b623-7a70a19c609f" :question/math-academy-id "q-304038" :question/problem "Given that $f(x)=3\\cdot {8}^{x}+12x+10$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x}+12x+10) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {8}^{x})+\\frac{\\text{d}}{\\text{d}x}(12x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({8}^{x})+12\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(10) \\\\  & =3(ln⁡(8){8}^{x})+12(1)+0 \\\\  & =3ln⁡(8){8}^{x}+12.\\end{aligned}\n$$"} {:db/id 17592186314919 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202a3876-df45-5f69-9dea-3b48cc477974" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(8){8}^{x}" :db/id 17592186312218} {:answer/id #uuid "4ad5377e-557d-4b02-81f5-eba612380c71" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot8^{x}\\ln8" :db/id 17592186409340}] :answer-field/correct {:answer/id #uuid "202a3876-df45-5f69-9dea-3b48cc477974" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}(8){8}^{x}" :db/id 17592186312218} :answer-field/id #uuid "5168e7a2-5958-57af-b48a-ff61e1073f47" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186314237}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca876738-9b8d-5832-85d7-2d09df78130a" :question/math-academy-id "q-340272" :question/problem "Given that $f(x)=7-2\\cdot {8}^{x}$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(7-2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-\\frac{\\text{d}}{\\text{d}x}(2\\cdot {8}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(7)-2\\frac{\\text{d}}{\\text{d}x}({8}^{x}) \\\\  & =0-2(ln⁡(8){8}^{x}) \\\\  & =-2ln⁡(8){8}^{x}.\\end{aligned}\n$$"} {:db/id 17592186314920 :knowledge-point/_questions [{:knowledge-point/id #uuid "14e68965-6c39-5947-ac05-eee99e685063" :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40066746-e699-53ed-82fd-0f35f8e924c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(5)+4" :db/id 17592186312491} {:answer/id #uuid "8688c450-e972-4ef8-abf7-296b751229f8" :answer/type {:db/ident :answer.type/math} :answer/value "5^{x}\\ln5-18x^2+4" :db/id 17592186409339}] :answer-field/correct {:answer/id #uuid "40066746-e699-53ed-82fd-0f35f8e924c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}(5)+4" :db/id 17592186312491} :answer-field/id #uuid "d4ba52fe-3ccd-59f7-bca4-208b03b18375" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186314595}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3624c-f62d-5f81-b0de-c13d8e4bf17c" :question/math-academy-id "q-340280" :question/problem "Given that $f(x)={5}^{x}-6{x}^{3}+4x-1$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-6{x}^{3}+4x-1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(4x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({5}^{x})-6\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =ln⁡(5)\\cdot {5}^{x}-6(3{x}^{2})+4(1)-0 \\\\  & =ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(ln⁡(5)\\cdot {5}^{x}-18{x}^{2}+4)|}_{x=0} \\\\  & =ln⁡(5)\\cdot {5}^{0}-18(0)^{2}+4 \\\\  & =ln⁡(5)\\cdot 1-0+4 \\\\  & =ln⁡(5)+4.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating an Exponential Function with a Base Other Than e"}