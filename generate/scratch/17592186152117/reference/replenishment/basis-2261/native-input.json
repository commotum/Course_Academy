      "question": {
        ":question/id": "07b1d066-f62b-5882-a508-7ac492a0feff",
        ":question/problem": "The least common multiple of $9(x+8)^{3}$ and $5(x+8)$ is {{field-1}}.",
        ":question/answer-fields": [
          {
            ":answer-field/id": "5f283d16-3b9e-53c7-92f6-b4d170691f6e",
            ":answer-field/key": "field-1",
            ":answer-field/type": ":answer-field.type/blank",
