7592186045443 true] [17592186517153 1082 #edb/ref 17592186045498 13194139535561 17592186045443 true] [17592186517153 1083 #uuid "65b532c4-aaff-57a9-bb71-1e14f28d0636" 13194139535561 17592186045443 true] [17592186517154 1068 #edb/ref 17592186517152 13194139535561 17592186045443 true] [17592186517154 1070 #edb/ref 17592186045485 13194139535561 17592186045443 true] [17592186517154 1071 "The point $(a,b)$ lies on the curve $y=3^{x}.$ Which of the following points **must** lie on $y=3^{x/2}-2?$" 13194139535561 17592186045443 true] [17592186517154 1072 #uuid "66562107-64e5-5b2b-99fc-50f565b62c27" 13194139535561 17592186045443 true] [17592186517154 1074 "**Method 1**\n\nTo plot $y=3^{x/2}-2,$ we apply the following steps:\n\n- First, we take the graph $y=3^{x}.$\n\n- Then, we stretch the graph by a scale factor of $2$ parallel to the $x$-axis and get the graph of $y=3^{x/2}.$ After this transformation, the point $(a,b)$ will be mapped to the point\n\n$$\n(2a,b).\n$$\n\n- Finally, we shift the result vertically by $2$ units down and obtain the graph of $y=3^{x/2}-2.$ After this transformation, the point $(2a,b)$ will be mapped to the point\n\n$$\n(2a,b-2).\n$$\n\n**Method 2**\n\nSince the point $(a,b)$ lies on the graph of $y=3^{x}$, we have that $3^{a}=b.$\n\nNow consider the graph of $y=3^{x/2}-2.$ Substituting $x=2a$, we get\n\n$$\n\\begin{aligned}y &=3^{\\frac{2a}{2}}-2 \\\\ &=3^{a}-2 \\\\ &=b-2.\\end{aligned}\n$$\n\nTherefore, the point $(2a,b-2)$ must lie on $y=3^{x/2}-2.$" 13194139535561 17592186045443 true] [17592186517155 1080 "(-1,-3)" 13194139535561 17592186045443 true] [17592186517155 1082 #edb/ref 17592186045498 13194139535561 17592186045443 true] [17592186517155 1083 #uuid "696d1a6c-6fc6-54d4-80b3-eb594b915464" 13194139535561 17592186045443 true] [17592186517156 1080 "(\\frac{a}{2},b-2)" 13194139535561 17592186045443 true] [17592186517156 1082 #edb/ref 17592186045498 13194139535561 17592186045443 true] [17592186517156 1083 #uuid "6f955108-7f48-51fc-aaaa-ed9327