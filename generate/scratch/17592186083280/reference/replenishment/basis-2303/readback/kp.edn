^{′}(\\frac{35\\pi}{12}) & =8\\ne 0, \\\\ {x}^{′}(\\frac{41\\pi}{12}) & =-8\\ne 0, \\\\ {x}^{′}(\\frac{47\\pi}{12}) & =8\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{29\\pi}{12}, \\frac{35\\pi}{12}, \\frac{41\\pi}{12}, \\frac{47\\pi}{12}.$"} {:db/id #edb/ref 17592186523064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e3498e6-008a-5057-ad9d-7ec79c9ade95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{18}" :db/id #edb/ref 17592186523037}] :answer-field/correct {:answer/id #uuid "3e3498e6-008a-5057-ad9d-7ec79c9ade95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17\\pi}{18}" :db/id #edb/ref 17592186523037} :answer-field/id #uuid "5435fa61-0ac5-5850-a883-5353217fc66d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523042} {:answer-field/choices [{:answer/id #uuid "2771ef99-a72c-56a3-8f66-5915b40c7073" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\pi}{18}" :db/id #edb/ref 17592186523032}] :answer-field/correct {:answer/id #uuid "2771ef99-a72c-56a3-8f66-5915b40c7073" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23\\pi}{18}" :db/id #edb/ref 17592186523032} :answer-field/id #uuid "7e507193-5813-543c-a568-58480e966525" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523052} {:answer-field/choices [{:answer/id #uuid "eda112aa-4599-59b4-a5ab-157f6286fa38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{9}" :db/id #edb/ref 17592186523087}] :answer-field/correct {:answer/id #uuid "eda112aa-4599-59b4-a5ab-157f6286fa38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{9}" :db/id #edb/ref 17592186523087} :answer-field/id #uuid "cabeb7bf-f695-5008-be83-5182dc2ec2c9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank}