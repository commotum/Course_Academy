frac{5\\pi}{8}, \\frac{9\\pi}{8}, \\frac{13\\pi}{8}, \\frac{17\\pi}{8}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{5\\pi}{8}) & =-12\\ne 0, \\\\ {x}^{′}(\\frac{9\\pi}{8}) & =12\\ne 0, \\\\ {x}^{′}(\\frac{13\\pi}{8}) & =-12\\ne 0, \\\\ {x}^{′}(\\frac{17\\pi}{8}) & =12\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\frac{5\\pi}{8}, \\frac{9\\pi}{8}, \\frac{13\\pi}{8}, \\frac{17\\pi}{8}.$"} {:db/id #edb/ref 17592186523026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06494210-c8fa-5ac1-8521-fd99aa96f543" :answer/type {:db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186523019} {:answer/id #uuid "396110c6-534d-5443-8986-37b860b46f5e" :answer/type {:db/ident :answer.type/math} :answer/value "t=-\\sqrt{2}" :db/id #edb/ref 17592186523035} {:answer/id #uuid "74b0388e-0ebf-588b-90b2-c0ea3143fd58" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\sqrt{2}" :db/id #edb/ref 17592186523046} {:answer/id #uuid "7e0e9c08-3a8b-5a43-becd-adfb70a329c1" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{6}" :db/id #edb/ref 17592186523051} {:answer/id #uuid "ee0cdc85-94d5-5d39-a1d6-09d8a594910f" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{2}" :db/id #edb/ref 17592186523088}] :answer-field/correct {:answer/id #uuid "ee0cdc85-94d5-5d39-a1d6-09d8a594910f" :answer/type {:db/ident :answer.type/math} :answer/value "t=\\pm \\sqrt{2}" :db/id #edb/ref 17592186523088} :answer-field/id #uuid "4a0100e9-7bd3-5c79-8b81-fc15bc3b502a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b45aef8-5aba-59a4-a0c0-7ae74ccf1ed7" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=7(t-4),\\,y=3{t}^{3}-18t,\\,-\\infty <t<\\infty .\n$$\n\nDetermine the values of $t$ at which the normal to the curve is vertical." :question/worked-solution "The normal is vertical if the tangent is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n\\begin{aligned}{x}^{′}(t)=7,\\,{y}^{′}(t)=9{t}^{2}-18.\\end{aligned}\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n9({t}^{2}-2)=0\\,⟹\\,t=\\pm \\sqrt{2}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{x}^{′}(-\\sqrt{2}) & =7\\ne 0, \\\\ {x}^{′}(\\sqrt{2}) & =7\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=\\pm \\sqrt{2}.$"} {:db/id #edb/ref 17592186523029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33356aae-e56a-5b04-9377-c9bf2dc3b354" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29\\pi}{12}" :db/id #edb/ref 17592186523034}] :answer-field/correct {:answer/id #uuid "33356aae-e56a-5b04-9377-c9bf2dc3b354" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29\\pi}{12}" :db/id #edb/ref 17592186523034} :answer-field/id #uuid "9884991f-b474-5bed-ac12-6297bbde8db8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523055} {:answer-field/choices [{:answer/id #uuid "06b5663f-ab15-59a8-aa75-83c593f9fcb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{47\\pi}{12}" :db/id #edb/ref 17592186523020}] :answer-field/correct {:answer/id #uuid "06b5663f-ab15-59a8-aa75-83c593f9fcb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{47\\pi}{12}" :db/id #edb/ref 17592186523020} :answer-field/id #uuid "aca313d6-1360-5578-942b-e8db280a47a5" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186523063} {:answer-field/choices [{:answer/id #uuid "24556c01-0a33-5acf-b303-408270710678" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{35\\pi}{12}" :db/id #