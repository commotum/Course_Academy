0 \\sqrt{3}\\right)\\right)-\\left(\\left(0\\right)\\right) \\\\\n& = 30 \\sqrt{3}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561297 :knowledge-point/_questions [{:knowledge-point/id #uuid "0bc5322f-ed04-53d2-8ce6-20ec58f73a5e" :knowledge-point/title "Evaluating Repeated Integrals Expressed in Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29076542-9b82-5313-ab48-11cd7c4ee9c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2} + \\frac{\\pi}{4}" :db/id #edb/ref 17592186561272} {:answer/id #uuid "4b44810b-e430-58ae-98d3-e30826cb8054" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\frac{\\pi}{2}" :db/id #edb/ref 17592186561281} {:answer/id #uuid "4fe657c8-5093-56cf-9869-20f9d4045c19" :answer/type {:db/ident :answer.type/math} :answer/value "2 + \\pi" :db/id #edb/ref 17592186561283} {:answer/id #uuid "5b31a55b-0e08-5b10-90d3-f415dd61d532" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{40 \\sqrt{2}}{9}" :db/id #edb/ref 17592186561288} {:answer/id #uuid "93db2af4-05d1-5ccd-83ce-6076e2bd6836" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\pi}{2} - 1" :db/id #edb/ref 17592186561293}] :answer-field/correct {:answer/id #uuid "4b44810b-e430-58ae-98d3-e30826cb8054" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\frac{\\pi}{2}" :db/id #edb/ref 17592186561281} :answer-field/id #uuid "fa93751a-e6cc-5420-b729-3e05bf739c8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561306}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9777f92-2c4b-5b38-b0d9-df6bb94b4ee3" :question/problem "Evaluate $\\int_{0}^{\\frac{\\pi}{8}} \\int_{0}^{4 \\cos{\\left(2 \\theta \\right)}} r\\,\\mathrm d r\\,\\mathrm d \\theta.$" :question/worked-solution "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}\n\\int_{0}^{\\frac{\\pi}{8}} \\int_{0}^{4 \\cos{\\left(2 \\theta \\right)}} r\\,\\mathrm d r\\,\\mathrm d \\theta & = \\int_{0}^{\\frac{\\pi}{8}} \\left[\\frac{r^{2}}{2}\\right]_{0}^{4 \\cos{\\left(2 \\theta \\right)}}\\,\\mathrm d \\theta \\\\\n& = \\int_{0}^{\\frac{\\pi}{8}} \\left(\\frac{\\left(4 \\cos{\\left(2 \\theta \\right)}\\right)^{2}-\\left(0\\right)^{2}}{2}\\right)\\,\\mathrm d \\theta \\\\\n& = \\int_{0}^{\\frac{\\pi}{8}} 8 \\cos^{2}{\\left(2 \\theta \\right)}\\,\\mathrm d \\theta\n\\end{aligned}\n$$\n\nNext, we recall the double-angle formula\n\n$$\n\\cos(2x)=2\\cos^2 x-1.\n$$\n\nSubstituting $x=2\\theta$ and rearranging, we get\n\n$$\n\\cos^2\\left(2\\theta\\right)=\\frac{1}{2}\\left(1+\\cos\\left(4\\theta\\right)\\right).\n$$\n\nFinally, we can finish our integral by integrating with respect to $\\theta,$ as follows:\n\n$$\n\\begin{aligned}\n\\int_{0}^{\\frac{\\pi}{8}} 8 \\cos^{2}{\\left(2 \\theta \\right)}\\,\\mathrm d \\theta & = \\int_{0}^{\\frac{\\pi}{8}} 4\\left(1+\\cos\\left(4\\theta\\right)\\right)\\,\\mathrm d \\theta \\\\\n& = 4\\left[\\theta + \\frac{\\sin{\\left(4 \\theta \\right)}}{4}\\right]_{0}^{\\frac{\\pi}{8}} \\\\\n& = 4\\left(\\left(\\frac{\\pi}{8}+\\frac{1}{4}\\sin\\left(\\frac{\\pi}{2}\\right)\\right)-\\left(0+\\frac{1}{4}\\sin\\left(0\\right)\\right)\\right) \\\\\n& = 4\\left(\\left(\\frac{\\pi}{8}+\\frac{1}{4} \\left(1\\right)\\right)-\\left(0+\\frac{1}{4} \\left(0\\right)\\right)\\right) \\\\\n& = 4\\left(\\left(\\frac{\\pi}{8}\\right)+\\frac{1}{4}\\left(1\\right)\\right) \\\\\n& = 1 + \\frac{\\pi}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561303 :knowledge-point/_questions [{:knowledge-point/id #uuid "0bc5322f-ed04-53d2-8ce6-20ec58f73a5e" :knowledge-point/title "Evaluating Repeated Integrals Expressed in Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4571be-9a41-5474-a5cd-6525edd5910b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{16} + \