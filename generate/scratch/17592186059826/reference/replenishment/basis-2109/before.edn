{:db/id 17592186059826 :knowledge-point/canonical-example {:db/id 17592186059385 :question/id #uuid "9096883e-6dd0-5dd1-8e9c-176775edadba" :question/math-academy-id "e-10785" :question/problem "Which inequality corresponds to the interval $x \\in (1, 5)?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only parentheses. So, the endpoints are *not* included. \n\n$$\nx\\in {\\color{red}{(}}1, 5{\\color{red}{)}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n1 \\,\\,{\\color{red}{<      }}\\,\\,      x  \\,\\,{\\color{red}{<      }}\\,\\,      5\n$$"} :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/key-prerequisites [{:db/id 17592186049051}] :knowledge-point/questions [{:db/id 17592186059959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c9b9c5-5872-51f0-b2ad-44164b111489" :answer/type {:db/ident :answer.type/math} :answer/value "(3, 7)" :db/id 17592186056114} {:answer/id #uuid "9dcdf7f5-62a7-5234-8924-0449af698d7a" :answer/type {:db/ident :answer.type/math} :answer/value "(- ∞, 7)" :db/id 17592186056115} {:answer/id #uuid "f5874e3e-f137-5f28-8fda-20b8cda0ca56" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 7]" :db/id 17592186056116} {:answer/id #uuid "f9c0db00-778f-5d41-ac1c-f6f119a2cad2" :answer/type {:db/ident :answer.type/math} :answer/value "(3, 7]" :db/id 17592186056117} {:answer/id #uuid "663e4c28-2a0b-5f40-872b-49710745b5b4" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 7)" :db/id 17592186056118}] :answer-field/id #uuid "679d3f8e-d841-5960-8ca9-0f285380842a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186056113}] :question/id #uuid "2e51d726-8467-5151-8d38-d8ff8c6150d8" :question/math-academy-id "q-102204" :question/problem "The inequality $3 < x < 7$ can be expressed in interval notation as"} {:db/id 17592186060310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5528cd6-4425-5a0e-9aa1-dd3a3d3d401f" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\le x < 4" :db/id 17592186058483} {:answer/id #uuid "f3577010-9f98-5658-8de5-d36de29225b0" :answer/type {:db/ident :answer.type/math} :answer/value "3 < x < 4" :db/id 17592186058484} {:answer/id #uuid "3338bdad-9ff8-5e4d-8587-7412d8236640" :answer/type {:db/ident :answer.type/math} :answer/value "3 < x \\le 4" :db/id 17592186058485} {:answer/id #uuid "40a996c8-c8a8-596d-a317-457ff015ab26" :answer/type {:db/ident :answer.type/text} :answer/value "$x < 3$ or $x > 4$" :db/id 17592186058486} {:answer/id #uuid "4ccfaab1-10e2-51e8-8a7f-473a858544c8" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\le x \\le 4" :db/id 17592186058487}] :answer-field/id #uuid "c182146a-27d4-534a-8de1-993e0aac23be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186058482}] :question/id #uuid "11aef963-41ca-5b95-807c-bb7602d0f434" :question/math-academy-id "q-59294" :question/problem "Which inequality corresponds to the interval $x ∈ (3, 4)$?"} {:db/id 17592186483356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53fe5584-384d-5b44-83a0-f1565841f276" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,-1]" :db/id 17592186482959} {:answer/id #uuid "631edece-fedb-545f-b23e-c597b59cd67d" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id 17592186482988} {:answer/id #uuid "7ddeac29-1350-586f-8402-4f2cd5a011bd" :answer/type {:db/ident :answer.type/math} :answer/value "(1,3)" :db/id 17592186483035} {:answer/id #uuid "bfc2ca2b-8fa1-563e-a4a9-2513bd36fe61" :answer/type {:db/ident :answer.type/math} :answer/value "[-3,-1)" :db/id 17592186483134} {:answer/id #uuid "ed26bb47-211c-5dd4-826f-0c63b9010f1e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1]" :db/id 17592186483211}] :answer-field/correct {:answer/id #uuid "631edece-fedb-545f-b23e-c597b59cd67d" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id 17592186482988} :answer-field/id #uuid "94593ba1-9997-5f67-b991-f19edf5d49e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186483299}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2f96fab2-a0f2-58ca-be0a-3d7653559b4b" :question/math-academy-id "q-1256" :question/problem "The inequality $-3<x<-1$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-3$ and $-1$ are *not* included. \n\n$$\n-3\\,\\,<\\,\\,x\\,\\,<\\,\\,-1\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-3,-1)\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-3,-1).\n$$"} {:db/id 17592186483411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ee599d9-032e-5cfa-8854-fa874620cf26" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2}]" :db/id 17592186482871} {:answer/id #uuid "466db8a9-5692-5840-8350-8a1339f4dc4d" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,\\sqrt{2})" :db/id 17592186482937} {:answer/id #uuid "631e7e91-f606-52be-bde6-7906debd7ca2" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\sqrt{2},\\sqrt{2}]" :db/id 17592186482987} {:answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id 17592186483030} {:answer/id #uuid "ea146e9c-cd0f-5d3f-a757-f080a85565c3" :answer/type {:db/ident :answer.type/math} :answer/value "[-\\sqrt{2},\\sqrt{2})" :db/id 17592186483205}] :answer-field/correct {:answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id 17592186483030} :answer-field/id #uuid "657476d4-a8fb-55ad-87cf-4c749b0e1c83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186483274}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c556bd18-7997-5c17-980e-bee5855d1c3c" :question/math-academy-id "q-154704" :question/problem "The inequality $-\\sqrt{2}<x<\\sqrt{2}$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-\\sqrt{2}$ and $\\sqrt{2}$ are *not* included. \n\n$$\n-\\sqrt{2}\\,\\,<\\,\\,x\\,\\,<\\,\\,\\sqrt{2}\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-\\sqrt{2},\\sqrt{2})\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-\\sqrt{2},\\sqrt{2}).\n$$"}] :knowledge-point/title "Converting Between Intervals and Inequalities: Open Intervals"}
