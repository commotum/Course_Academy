#{[{:db/id #edb/ref 17592186059826 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059385 :question/id #uuid "9096883e-6dd0-5dd1-8e9c-176775edadba" :question/math-academy-id "e-10785" :question/problem "Which inequality corresponds to the interval $x \\in (1, 5)?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only parentheses. So, the endpoints are *not* included. \n\n$$\nx\\in {\\color{red}{(}}1, 5{\\color{red}{)}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n1 \\,\\,{\\color{red}{<      }}\\,\\,      x  \\,\\,{\\color{red}{<      }}\\,\\,      5\n$$"} :knowledge-point/id #uuid "74f45f69-d8e7-5e79-a1ec-38d8912cbc19" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049051}] :knowledge-point/question-generator {:db/id #edb/ref 17592186502752 :question-generator/id #uuid "048c6264-9069-5382-b85b-e30c5f0c2723" :question-generator/script "generate/scratch/17592186059826.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186059959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c9b9c5-5872-51f0-b2ad-44164b111489" :answer/type {:db/ident :answer.type/math} :answer/value "(3, 7)" :db/id #edb/ref 17592186056114} {:answer/id #uuid "9dcdf7f5-62a7-5234-8924-0449af698d7a" :answer/type {:db/ident :answer.type/math} :answer/value "(- ∞, 7)" :db/id #edb/ref 17592186056115} {:answer/id #uuid "f5874e3e-f137-5f28-8fda-20b8cda0ca56" :answer/type {:db/ident :answer.type/math} :answer/value "[3, 7]" :db/id #edb/ref 17592186056116} {:answer/id #uuid "f9c0db00-778f-5d41-ac1c-f6f119a2cad2" :answer/type {:db/ident :answer.type/math} :answer/value "(3, 7]" :db/id #ed