#{[{:db/id #edb/ref 17592186124447 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124251 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/id #uuid "67e9bcb5-4bf2-56b8-8d82-95355841eaaa" :question/math-academy-id "e-3150" :question/problem "Find the gradient of the product $f(x,y) g(x,y)$ given that \n\n$$\n\\begin{aligned}f(x,y) & =xy,\\, &  & ∇f(x,y)=y\\text{ }i+x\\text{ }j, &  &  \\\\ g(x,y) & =\\sqrt{xy},\\, &  & ∇g(x,y)=\\frac{\\sqrt{xy}}{2x}\\text{ }i+\\frac{\\sqrt{xy}}{2y}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n\\nabla [fg] = g \\, \\nabla\\! f  + f \\, \\nabla\\! g.\n$$\n\nUsing the product rule shown above, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =\\sqrt{xy}(y\\text{ }i+x\\text{ }j)+xy(\\frac{\\sqrt{xy}}{2x}\\text{ }i+\\frac{\\sqrt{xy}}{2y}\\text{ }j) \\\\  & =\\sqrt{xy}(y\\text{ }i+x\\text{ }j)+\\frac{\\sqrt{xy}}{2}(y\\text{ }i+x\\text{ }j) \\\\  & =\\frac{3\\sqrt{xy}}{2}(y\\text{ }i+x\\text{ }j).\\end{aligned}\n$$"} :knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048813}] :knowledge-point/question-generator {:db/id #edb/ref 17592186524196 :question-generator/id #uuid "5f4a87e3-7b38-580b-829b-e2184a646c93" :question-generator/script "generate/scratch/17592186124447.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186124954 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f8e544-1ea9-599e-974a-71d2d151a87f" :answer/type {:db/ident :answer.type/math} :answer/value "(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j" :db/id #edb/ref 17592186321442} {:answer/id #uuid "348405b8-ded5-5a35-a88c-d99faa23725d" :answer/type {:db/ident :answer.type/math} :answer/value "-16x{y}^{3}\\text{ }i+12{x}^{4}y\\text{ }j" :db/id #edb/ref 17592186321545} {:answer/id #uuid "5942edfe-58e8-5af7-8cfa-2852eccc2bef" :answer/type {:db/ident :answer.type/math} :answer/value "(2{x}^{3}{y}^{2}-x{y}^{3})\\text{ }i+({x}^{4}y-2{x}^{2}{y}^{2})\\text{ }j" :db/id #edb/ref 17592186321851} {:answer/id #uuid "6e8e1067-ba7b-54fb-af35-6a7524d7c253" :answer/type {:db/ident :answer.type/math} :answer/value "24{x}^{3}{y}^{2}-16x{y}^{3}+12{x}^{4}y-24{x}^{2}{y}^{2}" :db/id #edb/ref 17592186322003} {:answer/id #uuid "85783609-ce00-565d-bb5e-3dd88e517710" :answer/type {:db/ident :answer.type/math} :answer/value "(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }i+(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }j" :db/id #edb/ref 17592186322203}] :answer-field/correct {:answer/id #uuid "25f8e544-1ea9-599e-974a-71d2d151a87f" :answer/type {:db/ident :answer.type/math} :answer/value "(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j" :db/id #edb/ref 17592186321442} :answer-field/id #uuid "6498a189-6a46-5093-a0ab-23fe9a246ff1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323370}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7958e50f-73b4-5252-b8f0-e891d3332089" :question/math-academy-id "q-36144" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & =3{x}^{2}-4y,\\, &  & ∇g(x,y)=6x\\text{ }i-4\\text{ }j, &  &  \\\\ h(x,y) & =2{x}^{2}{y}^{2},\\, &  & ∇h(x,y)=4x{y}^{2}\\text{ }i+4{x}^{2}y\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[gh]=h\\,∇\\,g+g\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =2{x}^{2}{y}^{2}(6x\\text{ }i-4\\text{ }j)+(3{x}^{2}-4y)(4x{y}^{2}\\text{ }i+4{x}^{2}y\\text{ }j) \\\\  & =(2{x}^{2}{y}^{2}\\cdot 6x\\text{ }i-2{x}^{2}{y}^{2}\\cdot 4\\text{ }j)+((3{x}^{2}-4y)\\cdot 4x{y}^{2}\\text{ }i+(3{x}^{2}-4y)\\cdot 4{x}^{2}y\\text{ }j) \\\\  & =12{x}^{3}{y}^{2}\\text{ }i-8{x}^{2}{y}^{2}\\text{ }j+(12{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-16{x}^{2}{y}^{2})\\text{ }j \\\\  & =(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186125073 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "823cc20e-f86a-5020-9707-c46b0aebe5ff" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2}\\ln y(2\\ln x + 1)i + x^{2}\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123039} {:answer/id #uuid "2149104b-9ef4-58ae-9dd2-d0090b43d4b4" :answer/type {:db/ident :answer.type/math} :answer/value "xy^{2}\\ln y(2\\ln x + 1)i + x^{2}y\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123040} {:answer/id #uuid "237aa152-79aa-59ca-9da8-d11107a70f8c" :answer/type {:db/ident :answer.type/math} :answer/value "xy^{2}\\ln y(\\ln x + 1)i + x^{2}y\\ln x(\\ln y + 1)j" :db/id #edb/ref 17592186123041} {:answer/id #uuid "4598fee0-272e-5114-8a2c-ded49201d59a" :answer/type {:db/ident :answer.type/math} :answer/value "2xy^{2}\\ln x\\ln yi + 2x^{2}y\\ln x\\ln yj" :db/id #edb/ref 17592186123042} {:answer/id #uuid "62496431-e87b-55ac-959c-a35896635b84" :answer/type {:db/ident :answer.type/math} :answer/value "xy\\ln y(2\\ln x + 1)i + xy\\ln x(2\\ln y + 1)j" :db/id #edb/ref 17592186123043}] :answer-field/id #uuid "570aa897-a887-5746-b026-d89e242c332b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123038}] :question/id #uuid "5428db75-6dff-5dda-b472-e2a79932ad02" :question/math-academy-id "q-37466" :question/problem "What is the gradient of the product $f(x, y)g(x, y)$ if $f(x, y) = \\ln x\\ln y$ and $g(x, y) = x^{2}y^{2}$?"} {:db/id #edb/ref 17592186262920 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d1fe3ce-e39c-5f48-af02-f843ac8fe12f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186260280} {:answer/id #uuid "45a436bb-d9d3-5ae2-86cd-61af704fb4ec" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186260482} {:answer/id #uuid "8143f91a-8754-5cf9-b946-da41a6f966ab" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}(y(1-2{x}^{2})\\text{ }i+x(1+2{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186261002} {:answer/id #uuid "8b667d91-bb69-5253-9d69-5052dedca4a2" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}(x(1-{y}^{2})\\text{ }i+xy(1-{x}^{2})\\text{ }j)" :db/id #edb/ref 17592186261091} {:answer/id #uuid "c13fe910-b536-5489-9442-be8cb1a3b3de" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({x}^{2}(1+{y}^{2})\\text{ }i+2{y}^{2}(1+{x}^{2})\\text{ }j)" :db/id #edb/ref 17592186261582}] :answer-field/correct {:answer/id #uuid "2d1fe3ce-e39c-5f48-af02-f843ac8fe12f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/id #edb/ref 17592186260280} :answer-field/id #uuid "7821d5ef-cff7-57a3-8006-a2f8c44afc3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262323}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "76e2d854-0d75-5d56-8dc4-994bd31ca49e" :question/math-academy-id "q-128521" :question/problem "What is the gradient of the product $f(x,y)g(x,y)$ if $f(x,y)=x{y}^{2}$ and $g(x,y)={e}^{-({x}^{2}+{y}^{2})}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=f∇g+g∇f.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{y}^{2})={y}^{2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{y}^{2})=2xy\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={y}^{2}\\text{ }i+2xy\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({e}^{-({x}^{2}+{y}^{2})})=-2x{e}^{-({x}^{2}+{y}^{2})} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({e}^{-({x}^{2}+{y}^{2})})=-2y{e}^{-({x}^{2}+{y}^{2})}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇g(x,y) & =\\frac{∂g}{∂x}\\text{ }i+\\frac{∂g}{∂y}\\text{ }j=-2x{e}^{-({x}^{2}+{y}^{2})}\\text{ }i-2y{e}^{-({x}^{2}+{y}^{2})}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =x{y}^{2}(-2x{e}^{-({x}^{2}+{y}^{2})}\\text{ }i-2y{e}^{-({x}^{2}+{y}^{2})}\\text{ }j)+{e}^{-({x}^{2}+{y}^{2})}({y}^{2}\\text{ }i+2xy\\text{ }j) \\\\  & ={e}^{-({x}^{2}+{y}^{2})}(-2{x}^{2}{y}^{2}\\text{ }i-2x{y}^{3}\\text{ }j)+{e}^{-({x}^{2}+{y}^{2})}({y}^{2}\\text{ }i+2xy\\text{ }j) \\\\  & ={e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262921 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f78169-2f44-5c43-87d6-b815be978a5a" :answer/type {:db/ident :answer.type/math} :answer/value "3x\\,i+{y}^{2}\\,j-2xy\\,k" :db/id #edb/ref 17592186260207} {:answer/id #uuid "296e6ebc-12ce-58be-b45b-a814a6ab10d3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}\\,i+3xy\\,k" :db/id #edb/ref 17592186260240} {:answer/id #uuid "38efeb4c-9bd1-5acf-ab43-dafd337eae24" :answer/type {:db/ident :answer.type/math} :answer/value "x\\,i-2xz\\,k" :db/id #edb/ref 17592186260381} {:answer/id #uuid "bbf61748-52a6-5ede-9896-0da38336b843" :answer/type {:db/ident :answer.type/math} :answer/value "{z}^{2}\\,j+2yz\\,k" :db/id #edb/ref 17592186261530} {:answer/id #uuid "ea736859-5ca3-578a-b099-b7d2e3d293b1" :answer/type {:db/ident :answer.type/math} :answer/value "x\\,i-{z}^{2}\\,j-2yz\\,k" :db/id #edb/ref 17592186261932}] :answer-field/correct {:answer/id #uuid "bbf61748-52a6-5ede-9896-0da38336b843" :answer/type {:db/ident :answer.type/math} :answer/value "{z}^{2}\\,j+2yz\\,k" :db/id #edb/ref 17592186261530} :answer-field/id #uuid "e3a18160-dc2f-533e-9be0-793491ff920c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "13103db1-962a-564a-a73e-3a0e51d17668" :question/math-academy-id "q-128529" :question/problem "Find the gradient of the product $f(x,y,z)h(x,y,z),$ given that \n\n$$\n\\begin{aligned}f(x,y,z) & =x{y}^{2}{z}^{3},\\, &  & ∇f(x,y,z)={y}^{2}{z}^{3}\\,i+2xy{z}^{3}\\,j+3x{y}^{2}{z}^{2}\\,k, &  &  \\\\ h(x,y,z) & =\\frac{1}{xyz},\\, &  & ∇h(x,y,z)=-\\frac{1}{{x}^{2}yz}\\,i-\\frac{1}{x{y}^{2}z}\\,j-\\frac{1}{xy{z}^{2}}\\text{ }k. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[fh]=h∇f+f∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)h(x,y,z)] & =h(x,y,z)∇f(x,y,z)+f(x,y,z)∇h(x,y,z) \\\\  & =\\frac{1}{xyz}({y}^{2}{z}^{3}\\,i+2xy{z}^{3}\\,j+3x{y}^{2}{z}^{2}\\,k)+x{y}^{2}{z}^{3}(-\\frac{1}{{x}^{2}yz}\\,i-\\frac{1}{x{y}^{2}z}\\,j-\\frac{1}{xy{z}^{2}}\\,k) \\\\  & =\\frac{{y}^{2}{z}^{3}}{xyz}\\,i+\\frac{2xy{z}^{3}}{xyz}\\,j+\\frac{3x{y}^{2}{z}^{2}}{xyz}\\,k-\\frac{x{y}^{2}{z}^{3}}{{x}^{2}yz}\\,i-\\frac{x{y}^{2}{z}^{3}}{x{y}^{2}z}\\,j-\\frac{x{y}^{2}{z}^{3}}{xy{z}^{2}}\\,k \\\\  & =\\frac{y{z}^{2}}{x}\\,i+2{z}^{2}\\,j+3yz\\,k-\\frac{y{z}^{2}}{x}\\,i-{z}^{2}\\,j-yz\\,k \\\\  & ={z}^{2}\\,j+2yz\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335800 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ef7585-f490-52ce-84d4-c14afbd71f8c" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{ln}⁡(xy)+2)\\text{ }i+x(\\operatorname{ln}⁡(xy)+2)\\text{ }j" :db/id #edb/ref 17592186333143} {:answer/id #uuid "21b12eb3-67b9-5f76-80f9-150884fc0d5e" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j" :db/id #edb/ref 17592186333290} {:answer/id #uuid "3ea7c594-0a56-5e0b-a1fd-7fd5413db99e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(xy)\\text{ }i-y\\operatorname{ln}⁡(xy)\\text{ }j" :db/id #edb/ref 17592186333580} {:answer/id #uuid "f9a4ec80-da82-5689-8ecb-e79e98294b6f" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(xy)\\text{ }i+y\\operatorname{ln}⁡(xy)\\text{ }j" :db/id #edb/ref 17592186335176} {:answer/id #uuid "fe69f0a9-435b-5c17-9a63-9c54c8b0d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(xy)\\text{ }i+x\\operatorname{ln}⁡(xy)\\text{ }j" :db/id #edb/ref 17592186335228}] :answer-field/correct {:answer/id #uuid "21b12eb3-67b9-5f76-80f9-150884fc0d5e" :answer/type {:db/ident :answer.type/math} :answer/value "y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j" :db/id #edb/ref 17592186333290} :answer-field/id #uuid "c8f1d221-bfab-57b4-bd66-7eea20107505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335609}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "838d032d-5600-5cb9-9af4-36cc70864ee1" :question/math-academy-id "q-65131" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =xy,\\, &  & ∇f(x,y)=y\\text{ }i+x\\text{ }j, &  &  \\\\ g(x,y) & =\\operatorname{ln}⁡(xy),\\, &  & ∇g(x,y)=\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by:\n\n$$\n∇[fg]=g\\,∇\\,f+f\\,∇\\,g\n$$\n\nSo, using this product rule we obtain: \n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(\\operatorname{ln}⁡(xy))(y\\text{ }i+x\\text{ }j)+xy(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j) \\\\  & =y\\operatorname{ln}⁡(xy)\\text{ }i+x\\operatorname{ln}⁡(xy)\\text{ }j+y\\text{ }i+x\\text{ }j \\\\  & =[y\\operatorname{ln}⁡(xy)\\text{ }i+y\\text{ }i]+[x\\operatorname{ln}⁡(xy)\\text{ }j+x\\text{ }j] \\\\  & =y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338952 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23400f54-8b3f-5ebc-b598-c7818f4586c2" :answer/type {:db/ident :answer.type/math} :answer/value "y\\text{ }i+x\\text{ }j" :db/id #edb/ref 17592186336361} {:answer/id #uuid "34196f13-9af3-5e84-930f-7cdc02f6b4ef" :answer/type {:db/ident :answer.type/math} :answer/value "x\\text{ }i+y\\text{ }j" :db/id #edb/ref 17592186336521} {:answer/id #uuid "78b044f0-5569-5fa2-b926-c4fa16e63d1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i+\\text{ }j" :db/id #edb/ref 17592186337118} {:answer/id #uuid "86424757-d1c0-5142-865b-bc737655d636" :answer/type {:db/ident :answer.type/math} :answer/value "-\\text{ }i+\\text{ }j" :db/id #edb/ref 17592186337246} {:answer/id #uuid "8a45146a-092c-5746-a1f7-52f22a8062eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i-\\text{ }j" :db/id #edb/ref 17592186337277}] :answer-field/correct {:answer/id #uuid "78b044f0-5569-5fa2-b926-c4fa16e63d1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i+\\text{ }j" :db/id #edb/ref 17592186337118} :answer-field/id #uuid "0fa16c79-d297-52a5-b07c-cccb5e15aa03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338305}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91443473-cbb1-5ab2-b98b-379cda895777" :question/math-academy-id "q-71476" :question/problem "Find the gradient of the product $f(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & ={x}^{2}y+x{y}^{2},\\, &  & ∇f(x,y)=(2xy+{y}^{2})\\text{ }i+({x}^{2}+2xy)\\text{ }j, &  &  \\\\ h(x,y) & =\\frac{1}{xy},\\, &  & ∇h(x,y)=-\\frac{1}{{x}^{2}y}\\text{ }i-\\frac{1}{x{y}^{2}}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=h\\,∇\\,f+f\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =h(x,y)∇f(x,y)+f(x,y)∇h(x,y) \\\\  & =\\frac{1}{xy}((2xy+{y}^{2})\\text{ }i+({x}^{2}+2xy)\\text{ }j)+({x}^{2}y+x{y}^{2})(-\\frac{1}{{x}^{2}y}\\text{ }i-\\frac{1}{x{y}^{2}}\\text{ }j) \\\\  & =(\\frac{2xy+{y}^{2}}{xy}\\text{ }i+\\frac{{x}^{2}+2xy}{xy}\\text{ }j)+(-\\frac{{x}^{2}y+x{y}^{2}}{{x}^{2}y}\\text{ }i-\\frac{{x}^{2}y+x{y}^{2}}{x{y}^{2}}\\text{ }j) \\\\  & =(\\frac{2x+y}{x}\\text{ }i+\\frac{x+2y}{y}\\text{ }j)+(-\\frac{x+y}{x}\\text{ }i-\\frac{x+y}{y}\\text{ }j) \\\\  & =(-\\frac{x+y}{x}+\\frac{2x+y}{x})\\text{ }i+(-\\frac{x+y}{y}+\\frac{x+2y}{y})\\text{ }j \\\\  & =\\text{ }i+\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383104 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763b5a77-6493-5261-b8d3-54d89d3556f5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy+2x-3y)\\,i-({x}^{2}-3xy+3x)\\,j)" :db/id #edb/ref 17592186383106} {:answer/id #uuid "35f70d4c-b368-5785-8f2b-55de44f7f968" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}((2x-3y)\\,i-3x\\,j)" :db/id #edb/ref 17592186383107} {:answer/id #uuid "02ee0e10-1bfe-5fcd-b946-23648b7beb03" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy-y)\\,i+({x}^{2}+3xy+3x)\\,j)" :db/id #edb/ref 17592186383108} {:answer/id #uuid "00dc6b24-907b-54d8-b5de-b9d4002d1f43" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy-2x-3y)\\,i+({x}^{2}+3xy+3x)\\,j)" :db/id #edb/ref 17592186383109} {:answer/id #uuid "b3105e5f-7b64-505a-a465-56ea29d0bb91" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy)\\,i-3x\\,j)" :db/id #edb/ref 17592186383110}] :answer-field/correct {:answer/id #uuid "763b5a77-6493-5261-b8d3-54d89d3556f5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x-y}(({x}^{2}-3xy+2x-3y)\\,i-({x}^{2}-3xy+3x)\\,j)" :db/id #edb/ref 17592186383106} :answer-field/id #uuid "864fbb12-509a-5c57-bdf6-96d7c651bd26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383105}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb82a957-3ae8-5e58-8924-0d152fcf4c22" :question/math-academy-id "q-128532" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & ={e}^{x-y},\\, &  & ∇g(x,y)={e}^{x-y}\\,i-{e}^{x-y}\\,j, &  &  \\\\ h(x,y) & ={x}^{2}-3xy,\\, &  & ∇h(x,y)=(2x-3y)\\,i-3x\\,j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[gh]=h∇g+g∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =({x}^{2}-3xy)({e}^{x-y}\\,i-{e}^{x-y}\\,j)+{e}^{x-y}((2x-3y)\\,i-3x\\,j) \\\\  & =(({x}^{2}-3xy){e}^{x-y}\\,i-({x}^{2}-3xy){e}^{x-y}\\,j)+((2x-3y){e}^{x-y}\\,i-3x{e}^{x-y}\\,j) \\\\  & ={e}^{x-y}({x}^{2}-3xy+2x-3y)\\,i-{e}^{x-y}({x}^{2}-3xy+3x)\\,j \\\\  & ={e}^{x-y}(({x}^{2}-3xy+2x-3y)\\,i-({x}^{2}-3xy+3x)\\,j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385550 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be7f21f4-cabe-54eb-bc85-93d694a5ed38" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{2}+2x){e}^{xy}\\text{ }i+({x}^{2}+{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385552} {:answer/id #uuid "4ec1d0e5-cc37-5321-849e-8e1b3950c06b" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385553} {:answer/id #uuid "3ad1fd13-781b-5d24-9468-b6d312c780db" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385554} {:answer/id #uuid "f82a086d-2718-5c14-b976-c8999ecd57bb" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x)\\text{ }i+({x}^{3}+x{y}^{2}+2y)\\text{ }j" :db/id #edb/ref 17592186385555} {:answer/id #uuid "2e9d2f1c-dc91-5316-9ad5-65fd3a68e1cd" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{xy}\\text{ }i+2y{e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385556}] :answer-field/correct {:answer/id #uuid "3ad1fd13-781b-5d24-9468-b6d312c780db" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385554} :answer-field/id #uuid "e3b75486-11a8-5732-8e0c-87ceee70a576" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385551}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48290c67-cc9b-570f-83c1-2b1af7db25a9" :question/math-academy-id "q-71484" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & ={e}^{xy},\\, &  & ∇g(x,y)=y{e}^{xy}\\text{ }i+x{e}^{xy}\\text{ }j, &  &  \\\\ h(x,y) & ={x}^{2}+{y}^{2},\\, &  & ∇h(x,y)=2x\\text{ }i+2y\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[gh]=h\\,∇\\,g+g\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =({x}^{2}+{y}^{2})(y{e}^{xy}\\text{ }i+x{e}^{xy}\\text{ }j)+{e}^{xy}(2x\\text{ }i+2y\\text{ }j) \\\\  & =(({x}^{2}+{y}^{2})y{e}^{xy}\\text{ }i+({x}^{2}+{y}^{2})x{e}^{xy}\\text{ }j)+(2x{e}^{xy}\\text{ }i+2y{e}^{xy}\\text{ }j) \\\\  & =({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186437018 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "caf56146-05fe-53cc-92f2-a535ba4943df" :answer/type {:db/ident :answer.type/math} :answer/value "(x+y)y{e}^{xy}\\text{ }i+x(x+y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186436998} {:answer/id #uuid "d2acb1a7-39df-54ef-82c2-34bde846d73e" :answer/type {:db/ident :answer.type/math} :answer/value "(x+y){e}^{x+y}\\text{ }i+(x+y){e}^{x+y}\\text{ }j" :db/id #edb/ref 17592186436999} {:answer/id #uuid "df8dc6a7-9339-5e43-b61c-4513120ec263" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)y{e}^{x}\\text{ }i+x(1+y){e}^{y}\\text{ }j" :db/id #edb/ref 17592186437001} {:answer/id #uuid "f072c200-9d5e-5ac5-b478-4233e499425f" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)y{e}^{x+y}\\text{ }i+x(1+y){e}^{x+y}\\text{ }j" :db/id #edb/ref 17592186437005} {:answer/id #uuid "f9e6b982-9c47-56e1-8b69-4a1e0179c1d1" :answer/type {:db/ident :answer.type/math} :answer/value "xy{e}^{xy}\\text{ }i+(x+1)(1+y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186437007}] :answer-field/correct {:answer/id #uuid "f072c200-9d5e-5ac5-b478-4233e499425f" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)y{e}^{x+y}\\text{ }i+x(1+y){e}^{x+y}\\text{ }j" :db/id #edb/ref 17592186437005} :answer-field/id #uuid "90c23b7b-1640-5aaa-b8b3-64340afb293e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437012}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5961ee6e-358e-5baa-837e-dbd941cc54b6" :question/math-academy-id "q-71515" :question/problem "What is the gradient of the product $f(x,y)h(x,y)$ if $f(x,y)=x{e}^{y}$ and $h(x,y)=y{e}^{x}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=f\\,∇\\,h+h\\,∇\\,f\\,\\,\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{e}^{y})={e}^{y} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{e}^{y})=x{e}^{y}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={e}^{y}\\text{ }i+x{e}^{y}\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(y{e}^{x})=y{e}^{x} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(y{e}^{x})={e}^{x}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇h(x,y) & =\\frac{∂h}{∂x}\\text{ }i+\\frac{∂h}{∂y}\\text{ }j=y{e}^{x}\\text{ }i+{e}^{x}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =x{e}^{y}(y{e}^{x}\\text{ }i+{e}^{x}\\text{ }j)+y{e}^{x}({e}^{y}\\text{ }i+x{e}^{y}\\text{ }j) \\\\  & =xy{e}^{x+y}\\text{ }i+x{e}^{x+y}\\text{ }j+y{e}^{x+y}\\text{ }i+xy{e}^{x+y}\\text{ }j \\\\  & =(x+1)y{e}^{x+y}\\text{ }i+x(1+y){e}^{x+y}\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524155 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c6b2e1-f84c-576c-abcb-d9a8fe842d09" :answer/type {:db/ident :answer.type/math} :answer/value "(16 x - 8 y)\\,i+(12 x - 6 y)\\,j" :db/id #edb/ref 17592186524144} {:answer/id #uuid "5a2d6953-32eb-5b84-952e-0fe7e38ff484" :answer/type {:db/ident :answer.type/math} :answer/value "(16 x + 12 y)\\,i+(- 8 x - 6 y)\\,j" :db/id #edb/ref 17592186524156} {:answer/id #uuid "82a14ca9-6156-53ff-a807-126f932fa8f8" :answer/type {:db/ident :answer.type/math} :answer/value "(- 20 y)\\,i+(20 x)\\,j" :db/id #edb/ref 17592186524167} {:answer/id #uuid "aa0406a9-d228-55a8-a225-25b047aac598" :answer/type {:db/ident :answer.type/math} :answer/value "(32 x + 4 y)\\,i+(4 x - 12 y)\\,j" :db/id #edb/ref 17592186524175} {:answer/id #uuid "beb6f1e3-1bcb-53d2-886d-ca85c879277c" :answer/type {:db/ident :answer.type/math} :answer/value "(4 x - 12 y)\\,i+(32 x + 4 y)\\,j" :db/id #edb/ref 17592186524182}] :answer-field/correct {:answer/id #uuid "aa0406a9-d228-55a8-a225-25b047aac598" :answer/type {:db/ident :answer.type/math} :answer/value "(32 x + 4 y)\\,i+(4 x - 12 y)\\,j" :db/id #edb/ref 17592186524175} :answer-field/id #uuid "cc542378-23c6-5f0d-a0d7-2fd9c737c526" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56dccd14-220e-5139-aad6-1c3d9263c553" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =4 x + 3 y,\\quad ∇f(x,y)=(4)\\,i+(3)\\,j \\\\ g(x,y) & =4 x - 2 y,\\quad ∇g(x,y)=(4)\\,i+(-2)\\,j\\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(4 x - 2 y)((4)\\,i+(3)\\,j)+(4 x + 3 y)((4)\\,i+(-2)\\,j) \\\\  & =(4 x - 2 y)(4)i+(4 x - 2 y)(3)j+(4 x + 3 y)(4)i+(4 x + 3 y)(-2)j \\\\  & =(16 x - 8 y)i+(12 x - 6 y)j+(16 x + 12 y)i+(- 8 x - 6 y)j \\\\  & =(32 x + 4 y)\\,i+(4 x - 12 y)\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524157 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36e183f3-6a67-5c16-9e23-ef10ececf338" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x - 2 y)\\,i+(6 x + 2 y)\\,j" :db/id #edb/ref 17592186524149} {:answer/id #uuid "511ca0af-e50e-5e8b-893f-12bbf8d9f4af" :answer/type {:db/ident :answer.type/math} :answer/value "(- 8 y)\\,i+(8 x)\\,j" :db/id #edb/ref 17592186524154} {:answer/id #uuid "aacd3c03-67de-503a-b3c3-1e38459c9de3" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x + 6 y)\\,i+(- 2 x + 2 y)\\,j" :db/id #edb/ref 17592186524176} {:answer/id #uuid "b0f45f57-3302-5746-b510-260125a96661" :answer/type {:db/ident :answer.type/math} :answer/value "(4 x + 4 y)\\,i+(- 12 x + 4 y)\\,j" :db/id #edb/ref 17592186524178} {:answer/id #uuid "ecc90aec-cdb8-5523-a4f3-2ae3d600632d" :answer/type {:db/ident :answer.type/math} :answer/value "(- 12 x + 4 y)\\,i+(4 x + 4 y)\\,j" :db/id #edb/ref 17592186524192}] :answer-field/correct {:answer/id #uuid "ecc90aec-cdb8-5523-a4f3-2ae3d600632d" :answer/type {:db/ident :answer.type/math} :answer/value "(- 12 x + 4 y)\\,i+(4 x + 4 y)\\,j" :db/id #edb/ref 17592186524192} :answer-field/id #uuid "3d3daa57-4d92-56f1-9dc7-324353b715ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "617022f3-6d62-5e70-ba01-a98523aa95af" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =2 x - 2 y,\\quad ∇f(x,y)=(2)\\,i+(-2)\\,j \\\\ g(x,y) & =- 3 x - y,\\quad ∇g(x,y)=(-3)\\,i+(-1)\\,j\\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(- 3 x - y)((2)\\,i+(-2)\\,j)+(2 x - 2 y)((-3)\\,i+(-1)\\,j) \\\\  & =(- 3 x - y)(2)i+(- 3 x - y)(-2)j+(2 x - 2 y)(-3)i+(2 x - 2 y)(-1)j \\\\  & =(- 6 x - 2 y)i+(6 x + 2 y)j+(- 6 x + 6 y)i+(- 2 x + 2 y)j \\\\  & =(- 12 x + 4 y)\\,i+(4 x + 4 y)\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524174 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "719a1d1a-12f8-5022-9387-d4a2458c0561" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\left(x - 3\\right) \\left(y + 4\\right) e^{x - 3} e^{y + 4} + \\left(y + 4\\right) e^{x - 3} e^{y + 4})\\,i+(\\left(x - 3\\right) \\left(y + 4\\right) e^{x - 3} e^{y + 4} - \\left(x - 3\\right) e^{x - 3} e^{y + 4})\\,j" :db/id #edb/ref 17592186524165} {:answer/id #uuid "b92588a3-3fa2-54c2-83ba-e428830f5893" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x - 2\\right) \\left(y + 4\\right) e^{x + y + 1})\\,i+(\\left(x - 3\\right) \\left(y + 5\\right) e^{x + y + 1})\\,j" :db/id #edb/ref 17592186524181} {:answer/id #uuid "c9802aa0-b1cb-55d1-b1a2-db8a145d6fee" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x - 3\\right) \\left(y + 5\\right) e^{x + y + 1})\\,i+(\\left(x - 2\\right) \\left(y + 4\\right) e^{x + y + 1})\\,j" :db/id #edb/ref 17592186524184} {:answer/id #uuid "d31f9ad0-9696-5bd1-a8fc-68d9debd7a2b" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x - 3\\right) \\left(y + 4\\right) e^{x - 3} e^{y + 4})\\,i+(\\left(x - 3\\right) e^{x - 3} e^{y + 4})\\,j" :db/id #edb/ref 17592186524188} {:answer/id #uuid "d8c2888c-5aef-520c-adff-53f362fa29ec" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(y + 4\\right) e^{x - 3} e^{y + 4})\\,i+(\\left(x - 3\\right) \\left(y + 4\\right) e^{x - 3} e^{y + 4})\\,j" :db/id #edb/ref 17592186524189}] :answer-field/correct {:answer/id #uuid "b92588a3-3fa2-54c2-83ba-e428830f5893" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x - 2\\right) \\left(y + 4\\right) e^{x + y + 1})\\,i+(\\left(x - 3\\right) \\left(y + 5\\right) e^{x + y + 1})\\,j" :db/id #edb/ref 17592186524181} :answer-field/id #uuid "6595e956-1aae-5fc1-8097-0c7c2b14064a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524160}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a18b5f63-dc6e-5c60-bea1-6d3675dd37d9" :question/problem "What is the gradient of the product $f(x,y)h(x,y)$ if $f(x,y)=(x-3){e}^{(y+4)}$ and $h(x,y)=(y+4){e}^{(x-3)}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=f\\,∇\\,h+h\\,∇\\,f\\,\\,\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((x-3){e}^{(y+4)})={e}^{(y+4)} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((x-3){e}^{(y+4)})=(x-3){e}^{(y+4)}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={e}^{(y+4)}\\text{ }i+(x-3){e}^{(y+4)}\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}((y+4){e}^{(x-3)})=(y+4){e}^{(x-3)} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}((y+4){e}^{(x-3)})={e}^{(x-3)}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇h(x,y) & =\\frac{∂h}{∂x}\\text{ }i+\\frac{∂h}{∂y}\\text{ }j=(y+4){e}^{(x-3)}\\text{ }i+{e}^{(x-3)}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =(x-3){e}^{(y+4)}((y+4){e}^{(x-3)}\\text{ }i+{e}^{(x-3)}\\text{ }j)+(y+4){e}^{(x-3)}({e}^{(y+4)}\\text{ }i+(x-3){e}^{(y+4)}\\text{ }j) \\\\  & =(x-3)(y+4){e}^{(x-3)+(y+4)}\\text{ }i+(x-3){e}^{(x-3)+(y+4)}\\text{ }j+(y+4){e}^{(x-3)+(y+4)}\\text{ }i+(x-3)(y+4){e}^{(x-3)+(y+4)}\\text{ }j \\\\  & =((x-3)+1)(y+4){e}^{(x-3)+(y+4)}\\text{ }i+(x-3)(1+(y+4)){e}^{(x-3)+(y+4)}\\text{ }j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524177 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6179bfd3-ad1a-57d5-9e85-07e8de87a9e4" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2 x y^{3} z - y z^{3}}{x y z})\\,i+(\\frac{3 x^{2} y^{2} z - x z^{3}}{x y z})\\,j+(\\frac{x^{2} y^{3} - 3 x y z^{2}}{x y z})\\,k" :db/id #edb/ref 17592186524158} {:answer/id #uuid "6544e835-303b-5d55-9ff4-bf9b2ff7f858" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{x^{2} y^{3} z - x y z^{3}}{x^{2} y z})\\,i+(- \\frac{x^{2} y^{3} z - x y z^{3}}{x y^{2} z})\\,j+(- \\frac{x^{2} y^{3} z - x y z^{3}}{x y z^{2}})\\,k" :db/id #edb/ref 17592186524159} {:answer/id #uuid "6f4a1fb2-b6f5-56ce-8ca2-8933d289d531" :answer/type {:db/ident :answer.type/math} :answer/value "(2 x y)\\,i+(y^{2})\\,j+(- 2 z)\\,k" :db/id #edb/ref 17592186524163} {:answer/id #uuid "e45afc2c-89cc-5d31-a291-04df0e43e302" :answer/type {:db/ident :answer.type/math} :answer/value "(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k" :db/id #edb/ref 17592186524190} {:answer/id #uuid "fe10362b-4bcf-503f-8c49-8dc2e3a0aca8" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2 x y^{3} z - y z^{3}}{x y z} + \\frac{x^{2} y^{3} z - x y z^{3}}{x^{2} y z})\\,i+(\\frac{3 x^{2} y^{2} z - x z^{3}}{x y z} + \\frac{x^{2} y^{3} z - x y z^{3}}{x y^{2} z})\\,j+(\\frac{x^{2} y^{3} - 3 x y z^{2}}{x y z} + \\frac{x^{2} y^{3} z - x y z^{3}}{x y z^{2}})\\,k" :db/id #edb/ref 17592186524195}] :answer-field/correct {:answer/id #uuid "e45afc2c-89cc-5d31-a291-04df0e43e302" :answer/type {:db/ident :answer.type/math} :answer/value "(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k" :db/id #edb/ref 17592186524190} :answer-field/id #uuid "28bf2288-62d0-5f23-9d2d-c0fb16e9c57f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524147}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "af2e4ace-5861-5b18-b355-92218c8fda1e" :question/problem "Find the gradient of the product $f(x,y,z)g(x,y,z),$ given that $f(x,y,z)=x^{2} y^{3} z - x y z^{3}$ and $g(x,y,z)=\\frac{1}{x y z}.$" :question/worked-solution "The gradient of the product of two functions $f(x,y,z)$ and $g(x,y,z)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x^{2} y^{3} z - x y z^{3})=2 x y^{3} z - y z^{3} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x^{2} y^{3} z - x y z^{3})=3 x^{2} y^{2} z - x z^{3} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(x^{2} y^{3} z - x y z^{3})=x^{2} y^{3} - 3 x y z^{2}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂f}{∂x}i+\\frac{∂f}{∂y}j+\\frac{∂f}{∂z}k=(2 x y^{3} z - y z^{3})\\,i+(3 x^{2} y^{2} z - x z^{3})\\,j+(x^{2} y^{3} - 3 x y z^{2})\\,k\\end{aligned}\n$$\n\nNow, we calculate the partial derivatives of $g(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{x y z})=- \\frac{1}{x^{2} y z} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{x y z})=- \\frac{1}{x y^{2} z} \\\\ \\frac{∂g}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{x y z})=- \\frac{1}{x y z^{2}}\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}∇g(x,y,z) & =\\frac{∂g}{∂x}i+\\frac{∂g}{∂y}j+\\frac{∂g}{∂z}k=(- \\frac{1}{x^{2} y z})\\,i+(- \\frac{1}{x y^{2} z})\\,j+(- \\frac{1}{x y z^{2}})\\,k\\end{aligned}\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)g(x,y,z)] & =g(x,y,z)∇f(x,y,z)+f(x,y,z)∇g(x,y,z) \\\\  & =(\\frac{1}{x y z})((2 x y^{3} z - y z^{3})\\,i+(3 x^{2} y^{2} z - x z^{3})\\,j+(x^{2} y^{3} - 3 x y z^{2})\\,k)+(x^{2} y^{3} z - x y z^{3})((- \\frac{1}{x^{2} y z})\\,i+(- \\frac{1}{x y^{2} z})\\,j+(- \\frac{1}{x y z^{2}})\\,k) \\\\  & =(\\frac{1}{x y z})(2 x y^{3} z - y z^{3})i+(\\frac{1}{x y z})(3 x^{2} y^{2} z - x z^{3})j+(\\frac{1}{x y z})(x^{2} y^{3} - 3 x y z^{2})k+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x^{2} y z})i+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x y^{2} z})j+(x^{2} y^{3} z - x y z^{3})(- \\frac{1}{x y z^{2}})k \\\\  & =(2 y^{2} - \\frac{z^{2}}{x})i+(3 x y - \\frac{z^{2}}{y})j+(\\frac{x y^{2}}{z} - 3 z)k+(- y^{2} + \\frac{z^{2}}{x})i+(- x y + \\frac{z^{2}}{y})j+(- \\frac{x y^{2}}{z} + z)k \\\\  & =(y^{2})\\,i+(2 x y)\\,j+(- 2 z)\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524179 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b12bed-f89f-57b2-8ae2-8204dcf0665f" :answer/type {:db/ident :answer.type/math} :answer/value "(- 4 y)\\,i+(4 x)\\,j" :db/id #edb/ref 17592186524146} {:answer/id #uuid "2b97234c-25d6-5347-947c-3537be088001" :answer/type {:db/ident :answer.type/math} :answer/value "(4 y)\\,i+(- 4 x)\\,j" :db/id #edb/ref 17592186524148} {:answer/id #uuid "8c1327c2-cfad-55ec-8554-d21c72bd153e" :answer/type {:db/ident :answer.type/math} :answer/value "(2 x + 2 y)\\,i+(- 2 x - 2 y)\\,j" :db/id #edb/ref 17592186524170} {:answer/id #uuid "92425297-e09b-57c4-89af-eed5f27f56b4" :answer/type {:db/ident :answer.type/math} :answer/value "(4 x)\\,i+(- 4 y)\\,j" :db/id #edb/ref 17592186524172} {:answer/id #uuid "f779ad7d-fb31-50f4-9978-b6dc57b1e6e5" :answer/type {:db/ident :answer.type/math} :answer/value "(2 x - 2 y)\\,i+(2 x - 2 y)\\,j" :db/id #edb/ref 17592186524194}] :answer-field/correct {:answer/id #uuid "92425297-e09b-57c4-89af-eed5f27f56b4" :answer/type {:db/ident :answer.type/math} :answer/value "(4 x)\\,i+(- 4 y)\\,j" :db/id #edb/ref 17592186524172} :answer-field/id #uuid "3ab0f1ac-375d-502a-af53-a56056488308" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524151}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4b60a1d-d5a3-5373-aeeb-9fd900ce0e06" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =- 2 x + 2 y,\\quad ∇f(x,y)=(-2)\\,i+(2)\\,j \\\\ g(x,y) & =- x - y,\\quad ∇g(x,y)=(-1)\\,i+(-1)\\,j\\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(- x - y)((-2)\\,i+(2)\\,j)+(- 2 x + 2 y)((-1)\\,i+(-1)\\,j) \\\\  & =(- x - y)(-2)i+(- x - y)(2)j+(- 2 x + 2 y)(-1)i+(- 2 x + 2 y)(-1)j \\\\  & =(2 x + 2 y)i+(- 2 x - 2 y)j+(2 x - 2 y)i+(2 x - 2 y)j \\\\  & =(4 x)\\,i+(- 4 y)\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524183 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c98ea29-bdf4-535c-8905-0e665688e1b9" :answer/type {:db/ident :answer.type/math} :answer/value "(- 3 x + 3 y)\\,i+(4 x - 4 y)\\,j" :db/id #edb/ref 17592186524141} {:answer/id #uuid "716903f3-1915-51b9-b21c-19085f2bd116" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x + 7 y)\\,i+(7 x - 8 y)\\,j" :db/id #edb/ref 17592186524164} {:answer/id #uuid "79fb8e43-61f5-507f-bcf8-885672627bbd" :answer/type {:db/ident :answer.type/math} :answer/value "(y)\\,i+(- x)\\,j" :db/id #edb/ref 17592186524166} {:answer/id #uuid "9ae708ac-d48e-5c03-8083-d7951c5f7722" :answer/type {:db/ident :answer.type/math} :answer/value "(- 3 x + 4 y)\\,i+(3 x - 4 y)\\,j" :db/id #edb/ref 17592186524173} {:answer/id #uuid "ccf65bb7-ba35-584e-a9ca-b15343ee8ea6" :answer/type {:db/ident :answer.type/math} :answer/value "(7 x - 8 y)\\,i+(- 6 x + 7 y)\\,j" :db/id #edb/ref 17592186524186}] :answer-field/correct {:answer/id #uuid "716903f3-1915-51b9-b21c-19085f2bd116" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x + 7 y)\\,i+(7 x - 8 y)\\,j" :db/id #edb/ref 17592186524164} :answer-field/id #uuid "135677e6-fc24-52c5-a111-90477ff87ed5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524142}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c004028d-833d-577a-87c2-e3fd0d71dbfc" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =- x + y,\\quad ∇f(x,y)=(-1)\\,i+(1)\\,j \\\\ g(x,y) & =3 x - 4 y,\\quad ∇g(x,y)=(3)\\,i+(-4)\\,j\\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(3 x - 4 y)((-1)\\,i+(1)\\,j)+(- x + y)((3)\\,i+(-4)\\,j) \\\\  & =(3 x - 4 y)(-1)i+(3 x - 4 y)(1)j+(- x + y)(3)i+(- x + y)(-4)j \\\\  & =(- 3 x + 4 y)i+(3 x - 4 y)j+(- 3 x + 3 y)i+(4 x - 4 y)j \\\\  & =(- 6 x + 7 y)\\,i+(7 x - 8 y)\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524187 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a9a90e-3590-57ce-857e-4738e4b8a96f" :answer/type {:db/ident :answer.type/math} :answer/value "(- 18 y)\\,i+(18 x)\\,j" :db/id #edb/ref 17592186524140} {:answer/id #uuid "17f10e04-4c44-5e8c-9a56-7bc02d440d7e" :answer/type {:db/ident :answer.type/math} :answer/value "(- 12 x - 12 y)\\,i+(6 x + 6 y)\\,j" :db/id #edb/ref 17592186524143} {:answer/id #uuid "65d4613a-986c-595a-b8e7-1e27d6799631" :answer/type {:db/ident :answer.type/math} :answer/value "(- 12 x + 6 y)\\,i+(- 12 x + 6 y)\\,j" :db/id #edb/ref 17592186524162} {:answer/id #uuid "898bd464-6f82-5875-8fac-53de974047ce" :answer/type {:db/ident :answer.type/math} :answer/value "(- 24 x - 6 y)\\,i+(- 6 x + 12 y)\\,j" :db/id #edb/ref 17592186524169} {:answer/id #uuid "b64fca02-3c60-59b5-9c60-0a6db140aa04" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x + 12 y)\\,i+(- 24 x - 6 y)\\,j" :db/id #edb/ref 17592186524180}] :answer-field/correct {:answer/id #uuid "898bd464-6f82-5875-8fac-53de974047ce" :answer/type {:db/ident :answer.type/math} :answer/value "(- 24 x - 6 y)\\,i+(- 6 x + 12 y)\\,j" :db/id #edb/ref 17592186524169} :answer-field/id #uuid "4bc44bad-0972-526a-a5f1-5498b898990c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2782dea-5fc4-5e05-abad-5b0c5268e377" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =4 x - 2 y,\\quad ∇f(x,y)=(4)\\,i+(-2)\\,j \\\\ g(x,y) & =- 3 x - 3 y,\\quad ∇g(x,y)=(-3)\\,i+(-3)\\,j\\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=g∇f+f∇g.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(- 3 x - 3 y)((4)\\,i+(-2)\\,j)+(4 x - 2 y)((-3)\\,i+(-3)\\,j) \\\\  & =(- 3 x - 3 y)(4)i+(- 3 x - 3 y)(-2)j+(4 x - 2 y)(-3)i+(4 x - 2 y)(-3)j \\\\  & =(- 12 x - 12 y)i+(6 x + 6 y)j+(- 12 x + 6 y)i+(- 12 x + 6 y)j \\\\  & =(- 24 x - 6 y)\\,i+(- 6 x + 12 y)\\,j\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524193 :knowledge-point/_questions [{:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39b3961c-518e-5fce-accc-1c06b8b99b28" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\left(x + 1\\right) \\left(y + 4\\right) e^{x + 1} e^{y + 4} + \\left(y + 4\\right) e^{x + 1} e^{y + 4})\\,i+(\\left(x + 1\\right) \\left(y + 4\\right) e^{x + 1} e^{y + 4} - \\left(x + 1\\right) e^{x + 1} e^{y + 4})\\,j" :db/id #edb/ref 17592186524150} {:answer/id #uuid "65a001d5-1a9b-591e-90e3-44eedf041dfc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(y + 4\\right) e^{x + 1} e^{y + 4})\\,i+(\\left(x + 1\\right) \\left(y + 4\\right) e^{x + 1} e^{y + 4})\\,j" :db/id #edb/ref 17592186524161} {:answer/id #uuid "884570ab-4fe3-58b8-bdc0-6fceffcbf5f8" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x + 1\\right) \\left(y + 5\\right) e^{x + y + 5})\\,i+(\\left(x + 2\\right) \\left(y + 4\\right) e^{x + y + 5})\\,j" :db/id #edb/ref 17592186524168} {:answer/id #uuid "913eb3b4-3e71-5d25-b83a-4d1c81d9ed5e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x + 1\\right) \\left(y + 4\\right) e^{x + 1} e^{y + 4})\\,i+(\\left(x + 1\\right) e^{x + 1} e^{y + 4})\\,j" :db/id #edb/ref 17592186524171} {:answer/id #uuid "e7f21048-bf93-5345-9339-7789610f673c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x + 2\\right) \\left(y + 4\\right) e^{x + y + 5})\\,i+(\\left(x + 1\\right) \\left(y + 5\\right) e^{x + y + 5})\\,j" :db/id #edb/ref 17592186524191}] :answer-field/correct {:answer/id #uuid "e7f21048-bf93-5345-9339-7789610f673c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\left(x + 2\\right) \\left(y + 4\\right) e^{x + y + 5})\\,i+(\\left(x + 1\\right) \\left(y + 5\\right) e^{x + y + 5})\\,j" :db/id #edb/ref 17592186524191} :answer-field/id #uuid "1d71dcf6-8f66-56fb-9f80-76a6a0f2f0b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186524145}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ed54f79d-76c2-5f18-8276-7aa2bb85a756" :question/problem "What is the gradient of the product $f(x,y)h(x,y)$ if $f(x,y)=(x+1){e}^{(y+4)}$ and $h(x,y)=(y+4){e}^{(x+1)}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=f\\,∇\\,h+h\\,∇\\,f\\,\\,\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((x+1){e}^{(y+4)})={e}^{(y+4)} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((x+1){e}^{(y+4)})=(x+1){e}^{(y+4)}\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={e}^{(y+4)}\\text{ }i+(x+1){e}^{(y+4)}\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}((y+4){e}^{(x+1)})=(y+4){e}^{(x+1)} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}((y+4){e}^{(x+1)})={e}^{(x+1)}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇h(x,y) & =\\frac{∂h}{∂x}\\text{ }i+\\frac{∂h}{∂y}\\text{ }j=(y+4){e}^{(x+1)}\\text{ }i+{e}^{(x+1)}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =(x+1){e}^{(y+4)}((y+4){e}^{(x+1)}\\text{ }i+{e}^{(x+1)}\\text{ }j)+(y+4){e}^{(x+1)}({e}^{(y+4)}\\text{ }i+(x+1){e}^{(y+4)}\\text{ }j) \\\\  & =(x+1)(y+4){e}^{(x+1)+(y+4)}\\text{ }i+(x+1){e}^{(x+1)+(y+4)}\\text{ }j+(y+4){e}^{(x+1)+(y+4)}\\text{ }i+(x+1)(y+4){e}^{(x+1)+(y+4)}\\text{ }j \\\\  & =((x+1)+1)(y+4){e}^{(x+1)+(y+4)}\\text{ }i+(x+1)(1+(y+4)){e}^{(x+1)+(y+4)}\\text{ }j\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}]}
