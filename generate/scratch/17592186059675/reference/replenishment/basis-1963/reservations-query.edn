[:find ?q :in $ ?learner ?kp :where
          [?l :learner/id ?learner] [?l :learner/activity ?t]
          [?t :learner-task/status ?status]
          (or [?status :db/ident :learner-task.status/started]
              [?status :db/ident :learner-task.status/paused])
          [?t :learner-task/activity ?a] [?a :activity/steps ?step]
          [?step :step/content ?q] [?kp :knowledge-point/questions ?q]]