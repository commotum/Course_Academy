id #uuid "24edd72b-715e-5a20-b0ca-bc6d4e2db918" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\ln \\mid 7\\coth x - 1 \\mid + C" :db/id #edb/ref 17592186482736} {:answer/id #uuid "3dbc5a37-f636-5626-9a99-a373d2b4423d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\mid 7\\csch^{2} x + 1 \\mid + C" :db/id #edb/ref 17592186482741} {:answer/id #uuid "ee541a2a-4ae9-5a6e-a578-9429f597af8c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\ln \\mid 7\\coth x + 1 \\mid + C" :db/id #edb/ref 17592186482792} {:answer/id #uuid "f4b56a90-21a3-5531-9006-1dd7d3e8aa29" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\ln \\mid \\csch^{2} x \\mid + C" :db/id #edb/ref 17592186482793}] :answer-field/correct {:answer/id #uuid "ee541a2a-4ae9-5a6e-a578-9429f597af8c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\ln \\mid 7\\coth x + 1 \\mid + C" :db/id #edb/ref 17592186482792} :answer-field/id #uuid "7302cb6a-8492-5b5f-81a1-bf9531732d52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482759}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0c398ccb-7526-5cc6-8db1-8a59a9908269" :question/problem "What is $\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displaystyle \\int\\frac{\\csch^{2} x}{7\\coth x + 1}dx$?" :question/worked-solution "$$\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\nLet $u=7\\coth x+1$. Differentiating gives\n\n$$\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-7\\csch^2 x,\n\\qquad \\csch^2 x\\,\\mathrm{d}x=-\\frac{1}{7}\\,\\mathrm{d}u.$$\n\nUsing this substitution, we obtain\n\n$$\\begin{aligned}\n\\int\\frac{\\csch^2 x}{7\\coth x+1}\\,\\mathrm{d}x\n&=-\\frac{1}{7}\\int\\frac{1}{u}\\,\\mathrm{d}u \\\\\n&=-\\frac{1}{7}\\ln|u|+C \\\\\n&=-\\frac{1}{7}\\ln|7\\coth x+1|+C.\n\\end{aligned}$$\n\nThe antiderivative is valid on each interval where $x\\ne0$ and $7\\coth x+1\\ne0$."} {:db/id #edb/ref 17592186482739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e315d9a-b4bf-5cb3-b8f6-6a0dbacad0b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\ln \\mid 5\\csch x + 1 \\mid + C" :db/id #edb/ref 17592186482751} {:answer/id #uuid "70a7f11a-d3a7-5538-881f-52fd516e4a76" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\ln \\mid 5\\coth x - 1 \\mid + C" :db/id #edb/ref 17592186482757} {:answer/id #uuid "9ac5f141-8211-574c-a6ac-c02d7bc0ee4c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\ln \\mid 5\\coth x + 1 \\mid + C" :db/id #edb/ref 17592186482768} {:answer/id #uuid "be393951-fcfe-585c-8080-6b2fa216061e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\mid 5\\csch^{2} x + 1 \\mid + C" :db/id #edb/ref 17592186482778} {:answer/id #uuid "f54cb666-0323-52f7-864c-3e9c51669b59" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\ln \\mid \\csch^{2} x \\mid + C" :db/id #edb/ref 17592186482794}] :answer-field/correct {:answer/id #uuid "9ac5f141-8211-574c-a6ac-c02d7bc0ee4c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\ln \\mid 5\\coth x + 1 \\mid + C" :db/id #edb/ref 17592186482768} :answer-field/id #uuid "ac1d5a97-9421-5ba3-bdc9-ee671f9d2143" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482773}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3bf041bc-30ad-591c-8fbb-083bb48f845f" :question/problem "What is $\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displaystyle \\int\\frac{\\csch^{2} x}{5\\coth x + 1}dx$?" :question/worked-solution "$$\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\nLet $u=5\\coth x+1$. Differentiating gives\n\n$$\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-5\\csch^2 x,\n\\qquad \\csch^2 x\\,\\mathrm{d}x=-\\frac{1}{5}\\,\\mathrm{d}u.$$\n\nUsing this substitution, we obtain\n\n$$\\begin{aligned}\n\\int\\frac{\\csch^2 x}{5\\coth x+1}\\,\\mathrm{d}x\n&=-\\frac{1}{5}\\int\\frac{1}{u}\\,\\mathrm{d}u \\\\\n&=-\\frac{1}{5}\\ln|u|+C \\\\\n&=-\\frac{1}{5}\\ln|5\\coth x+1|+C.\n\\end{aligned}$$\n\nThe antiderivative is valid on each interval where $x\\ne0$ and $5\\coth x+1\\ne0$."} {:db/id #edb/ref 17592186482745 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bb039d6-baeb-5e69-b420-94e2d9456f9d" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (\\frac{49}{50})" :db/id #edb/ref 17592186482762} {:answer/id #uuid "979a18ba-450a-529e-8453-4d3240a96c05" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 49" :db/id #edb/ref 17592186482767} {:answer/id #uuid "a14be10f-099b-5fb4-8304-fb4ccaaf3af1" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{7}{8})" :db/id #edb/ref 17592186482770} {:answer/id #uuid "c0e86b9d-0ced-5705-968a-d6339899ec18" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{3}{3})" :db/id #edb/ref 17592186482781} {:answer/id #uuid "c726e65a-fa91-52ae-81e3-33371a59bce6" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{15}{7})" :db/id #edb/ref 17592186482783}] :answer-field/correct {:answer/id #uuid "c726e65a-fa91-52ae-81e3-33371a59bce6" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{15}{7})" :db/id #edb/ref 17592186482783} :answer-field/id #uuid "1669ebf4-a235-5e7b-a7e3-4ddcf9c0f902" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482731}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "468021ed-16bf-5dbe-89e2-8150c29c2812" :question/problem "Evaluate the integral\n$\\displaystyle \\int_{0}^{\\ln 7}\\frac{\\cosh x}{3 + \\sinh x}dx$." :question/worked-solution "Let $u=3+\\sinh x$. Differentiating gives $\\mathrm{d}u=\\cosh x\\,\\mathrm{d}x$.\n\nWhen $x=0$, $u=3$. When $x=\\ln 7$,\n\n$$u=3+\\frac{e^{\\ln 7}-e^{-\\ln 7}}{2}\n=3+\\frac{7-\\frac{1}{7}}{2}=\\frac{45}{7}.$$\n\nTherefore,\n\n$$\\begin{aligned}\n\\int_0^{\\ln 7}\\frac{\\cosh x}{3+\\sinh x}\\,\\mathrm{d}x\n&=\\int_3^{\\frac{45}{7}}\\frac{1}{u}\\,\\mathrm{d}u \\\\\n&=\\left[\\ln u\\right]_3^{\\frac{45}{7}} \\\\\n&=\\ln(\\frac{45}{7})-\\ln 3 \\\\\n&=\\ln\\left(\\frac{15}{7}\\right).\n\\end{aligned}$$\n\nHere $u>0$ throughout the interval, so the logarithm and substitution are defined."} {:db/id #edb/ref 17592186482750 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c423b4-ba29-504b-943b-b80e6351bf13" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{3}{3})" :db/id #edb/ref 17592186482732} {:answer/id #uuid "1ae8ab13-9351-5caf-a0eb-f91febdbcdbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{9}{5})" :db/id #edb/ref 17592186482734} {:answer/id #uuid "7d42f666-6187-5cb4-b5d0-8327d320fcde" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (\\frac{25}{26})" :db/id #edb/ref 17592186482764} {:answer/id #uuid "894ce3d0-0c1e-5e6c-987c-24c108d13d7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 25" :db/id #edb/ref 17592186482766} {:answer/id #uuid "cae9b7bb-eaf1-53e3-a1f5-14c462bfe22e" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{5}{6})" :db/id #edb/ref 17592186482785}] :answer-field/correct {:answer/id #uuid "1ae8ab13-9351-5caf-a0eb-f91febdbcdbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{9}{5})" :db/id #edb/ref 17592186482734} :answer-field/id #uuid "4c4b3775-e454-5cf7-a860-715e66896683" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482748}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5a0bd7c9-0123-5ee5-b41e-93cdcb9f8034" :question/problem "Evaluate the integral\n$\\displaystyle \\int_{0}^{\\ln 5}\\frac{\\cosh x}{3 + \\sinh x}dx$." :question/worked-solution "Let $u=3+\\sinh x$. Differentiating gives $\\mathrm{d}u=\\cosh x\\,\\mathrm{d}x$.\n\nWhen $x=0$, $u=3$. When $x=\\ln 5$,\n\n$$u=3+\\frac{e^{\\ln 5}-e^{-\\ln 5}}{2}\n=3+\\frac{5-\\frac{1}{5}}{2}=\\frac{27}{5}.$$\n\nTherefore,\n\n$$\\begin{aligned}\n\\int_0^{\\ln 5}\\frac{\\cosh x}{3+\\sinh x}\\,\\mathrm{d}x\n&=\\int_3^{\\frac{27}{5}}\\frac{1}{u}\\,\\mathrm{d}u \\\\\n&=\\left[\\ln u\\right]_3^{\\frac{27}{5}} \\\\\n&=\\ln(\\frac{27}{5})-\\ln 3 \\\\\n&=\\ln\\left(\\frac{9}{5}\\right).\n\\end{aligned}$$\n\nHere $u>0$ throughout the interval, so the logarithm and substitution are defined."} {:db/id #edb/ref 17592186482753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35375c10-89f4-5286-9a29-9054aa291235" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 9" :db/id #edb/ref 17592186482738} {:answer/id #uuid "612c68f2-fc81-5183-8b91-8d5ad1c55cb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{3}{3})" :db/id #edb/ref 17592186482752} {:answer/id #uuid "b1dcb43b-8e7a-53e3-a1a7-24fb2641144a" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{3}{4})" :db/id #edb/ref 17592186482776} {:answer/id #uuid "bf81bce8-d9f3-5e25-82ea-a08888e56ce7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{13}{9})" :db/id #edb/ref 17592186482779} {:answer/id #uuid "ff1ca937-eec1-50ff-a64f-cfa92f36eea3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\ln (\\frac{9}{10})" :db/id #edb/ref 17592186482795}] :answer-field/correct {:answer/id #uuid "bf81bce8-d9f3-5e25-82ea-a08888e56ce7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{13}{9})" :db/id #edb/ref 17592186482779} :answer-field/id #uuid "ae79f7c7-8d52-5e34-ac4c-26c1fa3a1da9" :answ