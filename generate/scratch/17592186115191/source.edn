{:db/id 17592186115191 :knowledge-point/canonical-example {:db/id 17592186115020 :question/id #uuid "23b1cfcf-9f46-5274-b07b-66770a827409" :question/math-academy-id "e-3646" :question/problem "Find $\\dfrac {\\textrm d y} {\\textrm d x}$ if $y = 2x - 3\\cot x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x-3cot⁡x) \\\\  & =2-3(-{csc}^{2}⁡x) \\\\  & =2+3{csc}^{2}⁡x\\end{aligned}\n$$"} :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/questions [{:db/id 17592186115521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80db9b17-c00d-5d41-aaa4-fa1e51dee63f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2} x - 25x^{4} + 23\\csc^{2} x" :db/id 17592186112136} {:answer/id #uuid "9a7b81c0-8ad2-587a-a241-99c48eb7e113" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "25\\sec^{2} x - 23x^{4} + \\csc^{2} x" :db/id 17592186112137} {:answer/id #uuid "fa7e6faa-1dc6-5e22-b678-d60e43a5fb62" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2} x - 25x^{4} + \\sec^{2} x" :db/id 17592186112138} {:answer/id #uuid "782db20d-ef5b-5c18-b4e2-e4c9f20296ea" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "23\\sec^{2} x - 25x^{4} + \\csc^{2} x" :db/id 17592186112139} {:answer/id #uuid "7d39749b-c0c4-5b8f-91c6-a484f187fd97" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\sec^{2} x - 23x^{4} + \\csc^{2} x" :db/id 17592186112140}] :answer-field/id #uuid "bdce5dfa-0fbc-5104-abaa-ea3e2c51cf93" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186112135}] :question/id #uuid "1d331471-9368-5e62-8b1a-84ad6ca208e2" :question/math-academy-id "q-17639" :question/problem "Find $f^{′}(x)$ if $f(x) = 23\\tan x - 5x^{5} - \\cot x$."} {:db/id 17592186115725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95923357-a465-5fc5-a88d-f447ee68027b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\csc^{2} x" :db/id 17592186113317} {:answer/id #uuid "a19bc06b-d1f1-542e-975e-c02d34975d68" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2 - \\csc^{2} x" :db/id 17592186113318} {:answer/id #uuid "4cd529f5-560a-510a-8946-ed511fe08759" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2 - \\csc x" :db/id 17592186113319} {:answer/id #uuid "5008fe11-cf1f-5851-8702-22f39d6b2d5e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2 + \\csc x" :db/id 17592186113320} {:answer/id #uuid "64c6a260-94ff-5ad5-8c8a-dc743080aacd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2 + \\csc^{2} x" :db/id 17592186113321}] :answer-field/id #uuid "2b32474e-1717-5b6a-8b09-11e1fe8bc43c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186113316}] :question/id #uuid "ad857892-e3de-5073-9020-350ba1b93e6a" :question/math-academy-id "q-31279" :question/problem "Find $f^{′}(x)$ if $f(x) = 2x - \\cot x$."} {:db/id 17592186233781 :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73219a58-c08c-520e-96a1-4134d001c0d8" :question/math-academy-id "q-31288" :question/problem "Find ${f}^{'}(\\frac{\\pi }{6})$ if $f(x)=-6\\operatorname{cot}x.$" :question/worked-solution "First, we just take the constant out of the derivative and use the result for the derivative of $\\operatorname{cot}x,$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(-6\\operatorname{cot}x) \\\\  & =-6(-{csc}^{2}x) \\\\  & =6{csc}^{2}x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{'}(\\frac{\\pi }{6}) & =6{csc}^{2}(\\frac{\\pi }{6}) \\\\  & =6{(2)}^{2} \\\\  & =24.\\end{aligned}\n$$"} {:db/id 17592186233787 :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2bd5c98f-2174-5540-b7d6-172750f2ba2f" :question/math-academy-id "q-31355" :question/problem "Find ${f}^{'}(x)$ if $f(x)=\\frac{\\operatorname{cot}x}{{x}^{2}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{cot}x}{{x}^{2}}) \\\\  & =\\frac{(-{csc}^{2}x)\\cdot {x}^{2}-\\operatorname{cot}x\\cdot (2x)}{{x}^{4}} \\\\  & =\\frac{-x{csc}^{2}x-2\\operatorname{cot}x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$"} {:db/id 17592186241032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342af53-2f55-5c64-ada7-5e6f534a392d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}-{csc}^{2}⁡x" :db/id 17592186238108} {:answer/id #uuid "25e791c4-5e5d-54a5-a4d8-243c4ebd3551" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5-csc⁡x" :db/id 17592186238383} {:answer/id #uuid "2a8cdc06-3917-5a72-8baf-b7984c9c4345" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+csc⁡x" :db/id 17592186238429} {:answer/id #uuid "36a65434-a9ca-5879-a8bf-ac9ba0af8ece" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+{csc}^{2}⁡x" :db/id 17592186238526} {:answer/id #uuid "f072d48a-4459-559f-aaa6-60307b5cf008" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5-{csc}^{2}⁡x" :db/id 17592186240177}] :answer-field/correct {:answer/id #uuid "36a65434-a9ca-5879-a8bf-ac9ba0af8ece" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+{csc}^{2}⁡x" :db/id 17592186238526} :answer-field/id #uuid "d4627284-dc8a-5fab-aaa8-c7cf89fd3ae3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186240707}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfb4b430-487b-5445-947c-5c3c68e5ffd5" :question/math-academy-id "q-105309" :question/problem "Find ${f}^{′}(x)$ if $f(x)={5}^{x}-cot⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}-cot⁡x) \\\\  & ={5}^{x}ln⁡5-(-{csc}^{2}⁡x) \\\\  & ={5}^{x}ln⁡5+{csc}^{2}⁡x\\end{aligned}\n$$"} {:db/id 17592186314976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf4c902-f4f0-5e66-8a96-dff670ee7f7f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+3{csc}^{2}(x)" :db/id 17592186313873}] :answer-field/correct {:answer/id #uuid "edf4c902-f4f0-5e66-8a96-dff670ee7f7f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+3{csc}^{2}(x)" :db/id 17592186313873} :answer-field/id #uuid "5a999c3f-682e-5c0e-a6ed-d84ccc7c3d5d" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314265}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc3f29f8-f5c9-5816-a926-df2d0b5bf36c" :question/math-academy-id "q-340595" :question/problem "Find ${g}^{′}(x)$ for $g(x)={e}^{x}-3cot⁡(x).$\n\n${g}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}-3cot⁡(x)) \\\\  & ={e}^{x}-3(-{csc}^{2}⁡(x)) \\\\  & ={e}^{x}+3{csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id 17592186314977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e7edecf-22c1-57ae-b9db-577c0bc42b57" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cot}(x)}{x}" :db/id 17592186312992}] :answer-field/correct {:answer/id #uuid "7e7edecf-22c1-57ae-b9db-577c0bc42b57" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cot}(x)}{x}" :db/id 17592186312992} :answer-field/id #uuid "61d877e6-8bc9-5db8-855a-3075f76bd9a6" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314284}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "692c831b-b188-57f9-8d8a-25236044469a" :question/math-academy-id "q-340597" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}} $-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\operatorname{ln}⁡(x)\\operatorname{cot}⁡(x)) \\\\  & =\\frac{1}{x}\\cdot \\operatorname{cot}⁡(x)+\\operatorname{ln}⁡(x)(-{csc}^{2}⁡(x)) \\\\  & =\\frac{\\operatorname{cot}⁡(x)}{x}-\\operatorname{ln}⁡(x){csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id 17592186314978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a56c1968-5cfb-5078-ac6d-1fb92ae0c8a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id 17592186313276}] :answer-field/correct {:answer/id #uuid "a56c1968-5cfb-5078-ac6d-1fb92ae0c8a2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id 17592186313276} :answer-field/id #uuid "d98aad80-5c8a-5e64-afd9-dd37c9c06f08" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314612}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fe74bab-fbda-57cd-8d62-b0fe7ee7ec0e" :question/math-academy-id "q-340598" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=x\\operatorname{cot}⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{cot}⁡(x)\\,-$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{cot}⁡(x)) \\\\  & =1\\operatorname{cot}⁡(x)+x(-{csc}^{2}⁡(x)) \\\\  & =\\operatorname{cot}⁡(x)-x{csc}^{2}⁡(x)\\end{aligned}\n$$"} {:db/id 17592186314979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d72bf0eb-ad62-5881-9084-66b56ea503b7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}(x)" :db/id 17592186313672}] :answer-field/correct {:answer/id #uuid "d72bf0eb-ad62-5881-9084-66b56ea503b7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}(x)" :db/id 17592186313672} :answer-field/id #uuid "e5eea6c3-db40-505b-9e0d-14232418925e" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314641}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e8691b6d-0ecf-5d21-b2f3-79779cf5dbfe" :question/math-academy-id "q-340599" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{ln⁡(x)}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+{csc}^{2}⁡(x)\\,\\cdot ${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | $x{cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{ln⁡(x)}{cot⁡(x)}) \\\\  & =\\frac{cot⁡(x)\\cdot \\frac{1}{x}-ln⁡(x)(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{(\\frac{cot⁡(x)+xln⁡(x){csc}^{2}⁡(x)}{x})}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+{csc}^{2}⁡(x)\\cdot xln⁡(x)}{x{cot}^{2}⁡(x)}\\end{aligned}\n$$"} {:db/id 17592186314980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a88a36db-5e45-548d-8bfc-2a65d42b2b2f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id 17592186313297}] :answer-field/correct {:answer/id #uuid "a88a36db-5e45-548d-8bfc-2a65d42b2b2f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x{csc}^{2}(x)" :db/id 17592186313297} :answer-field/id #uuid "7bb36ddb-0276-5ac3-89fe-420e530a39fb" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314339}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e33e2c96-5cc5-507d-8909-c27b983d8b76" :question/math-academy-id "q-340603" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{x}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | ${cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x}{cot⁡(x)}) \\\\  & =\\frac{1(cot⁡(x))-x(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+x{csc}^{2}⁡(x)}{{cot}^{2}⁡(x)}\\end{aligned}\n$$"} {:db/id 17592186401805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a34f86b-faa2-5844-9680-3f6951dc4ecf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}{csc}^{2}⁡x+8{x}^{3}cot⁡x" :db/id 17592186401807} {:answer/id #uuid "63214331-a811-5bf2-8cb7-4da5c8c1d678" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}csc⁡x" :db/id 17592186401808} {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id 17592186401809} {:answer/id #uuid "5a35c415-50b4-5005-8173-6121abbd643e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}csc⁡x-8{x}^{3}cot⁡x" :db/id 17592186401810} {:answer/id #uuid "cb8e226f-a28c-5b1a-b7df-6f312bfd06a3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x+8{x}^{3}tan⁡x" :db/id 17592186401811}] :answer-field/correct {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id 17592186401809} :answer-field/id #uuid "f7aeb284-4f80-510f-8935-07a7e23c626b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186401806}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" :question/math-academy-id "q-1913" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}