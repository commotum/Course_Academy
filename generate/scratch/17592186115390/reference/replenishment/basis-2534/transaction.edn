$\n\\begin{aligned}(-2f(t)+2g(t))'&=-2f'(\\!t)+2g'(\\!t) \\\\ &=-2\\left(9 t^{2}\\,i+\\frac{3}{\\left(t + 3\\right)^{2}}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\right)+2\\left(4\\,i+2 e^{2 t}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\right) \\\\ &=\\left(- 18 t^{2}\\,i- \\frac{6}{\\left(t + 3\\right)^{2}}\\,j+8 \\sin{\\left(4 t \\right)}\\,k\\right)+\\left(8\\,i+4 e^{2 t}\\,j- 8 \\sin{\\left(4 t \\right)}\\,k\\right) \\\\ &=(8 - 18 t^{2})\\,i+(4 e^{2 t} - \\frac{6}{\\left(t + 3\\right)^{2}})\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["f573ff47-df7f-5224-8ed0-621e1426dd66"] :db/ensure :question/validate} {:db/id "8631399e-befe-5fda-89cf-04216c222ee4" :answer/id #uuid "8631399e-befe-5fda-89cf-04216c222ee4" :answer/type :answer.type/math :answer/value "(4 - 16 t)\\,i+(4 e^{2 t} - \\frac{8}{\\left(t + 3\\right)^{2}})\\,j" :db/ensure :answer/validate} {:db/id "b2ccd2c1-ee5e-53ce-8fa5-271cd400ba26" :answer/id #uuid "b2ccd2c1-ee5e-53ce-8fa5-271cd400ba26" :answer/type :answer.type/math :answer/value "(- 8 t^{2} + 4 t - 12)\\,i+\\frac{2 \\left(\\left(t + 3\\right) e^{2 t} + 4\\right)}{t + 3}\\,j" :db/ensure :answer/validate} {:db/id "777522b1-6939-5b66-8d41-4c0af7a31559" :answer/id #uuid "777522b1-6939-5b66-8d41-4c0af7a31559" :answer/type :answer.type/math :answer/value "4\\,i+4 e^{2 t}\\,j- 6 \\sin{\\left(3 t \\right)}\\,k" :db/ensure :answer/validate} {:db/id "bd9aa792-0b2d-537e-877a-bee6cb6606f9" :answer/id #uuid "bd9aa792-0b2d-537e-877a-bee6cb6606f9" :answer/type :answer.type/math :answer/value "(16 t + 4)\\,i+(4 e^{2 t} + \\frac{8}{\\left(t + 3\\right)^{2}})\\,j- 12 \\sin{\\left(3 t \\right)}\\,k" :db/ensure :answer/validate} {:db/id "dd248600-23aa-53ba-92c5-dd1baf90dce8" :answer/id #uuid "dd248600-23aa-53ba-92c5-dd1baf90dce8" :answer/type :answer.type/math :answer/value "- 16 t\\,i- \\frac{8}{\\left(t + 3\\right)^{2}}\\,j+6 \\sin{\\left(3 t \\right)}\\,k" :db/ensure :answer/validate} {:db/id "3e314097-0298-520f-9c83-0f0f