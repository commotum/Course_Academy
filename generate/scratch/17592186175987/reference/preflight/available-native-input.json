                ":answer/type": ":answer.type/math",
                ":answer/value": "{\\int }_{-\\pi }^{0}\\,{\\int }_{0}^{1}-{r}^{2}\\operatorname{cos}\u2061\\theta \\,dr\\,d\\theta "
              },
