              ":answer/value": "\\frac{196}{169}"
            },
            {
              ":answer/id": "64f03a6d-03d7-52b9-90c7-138ff14a947c",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{13}{14}"
