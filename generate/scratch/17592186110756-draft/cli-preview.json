              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\sqrt{651}}{93}"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "b27c00ce-e1aa-54e6-b270-9ea94367a550"
