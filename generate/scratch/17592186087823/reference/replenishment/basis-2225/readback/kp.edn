d "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33cc13b0-22be-5afc-8d79-11f9045a7204" :answer/type {:db/ident :answer.type/image} :answer/value "images/69/69a60fb19690650704691b6f90c568a9884113243e1b75410dceba5decb85eb1.png" :db/id #edb/ref 17592186513365} {:answer/id #uuid "731b1f6f-6067-5010-b383-045ee248dcaf" :answer/type {:db/ident :answer.type/image} :answer/value "images/ca/ca14f846df48500e4c43c77cd629b39413e1d1e457731ea5abc1023344f1e5d7.png" :db/id #edb/ref 17592186513378} {:answer/id #uuid "aa2df0a9-4391-5766-aa12-8e2b8d2476da" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b6d361387dba7ef2ff115d1203d830748b7ac24a331619ddbffa07d3897af3db.png" :db/id #edb/ref 17592186513386} {:answer/id #uuid "b334c511-094d-51f8-b6a3-379024d11225" :answer/type {:db/ident :answer.type/image} :answer/value "images/3a/3ac3c5a72642e41deff85b23952aa5eefc8394e1524da360b9ad97fb7a14bc02.png" :db/id #edb/ref 17592186513388} {:answer/id #uuid "ef77bf42-9d7c-5418-9c8d-73538b4ca6d4" :answer/type {:db/ident :answer.type/image} :answer/value "images/08/0831905d7cd624fa26afd5d6950a04be4fbbb1b78704d465513db8efd6741008.png" :db/id #edb/ref 17592186513412}] :answer-field/correct {:answer/id #uuid "aa2df0a9-4391-5766-aa12-8e2b8d2476da" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b6d361387dba7ef2ff115d1203d830748b7ac24a331619ddbffa07d3897af3db.png" :db/id #edb/ref 17592186513386} :answer-field/id #uuid "90dee5f6-34df-5283-9366-a00b41d94c80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186513383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ae90e17-1935-5ffa-9f99-a277fa5ad7f6" :question/problem "Which of the following is the graph of $y=2({10}^{x})+3?$" :question/worked-solution "First, we plot the graph of $y={10}^{x}:$\n\n![](images/df/dfba05178209ded9fe3d35eba7d647734a331a4968c42edd1b4fdc14439aa902.png)\n\nNext, we plot the graph of $y=2({10}^{x}).$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/9d/9d490d41a6b416d47f80cb026909f4e9634cad19641003c7c3a6d6405f496780.png)\n\nFinally, we plot the graph of $y=2({10}^{x})+3.$ To do this, we shift the above graph $3$ units up. The $y$-intercept moves from $(0,2)$ to $(0,5),$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/b6/b6d361387dba7ef2ff115d1203d830748b7ac24a331619ddbffa07d3897af3db.png)"} {:db/id #edb/ref 17592186513391 :knowledge-point/_questions [{:knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c9c9377-b7d1-5eeb-ae4d-12c71e0d4db8" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b63ff356015b8bf183eea613a85489ab9d0eb0193a85fe8f735c3fae38490aba.png" :db/id #edb/ref 17592186513359} {:answer/id #uuid "4bd85bba-8247-5595-832f-4b80743df791" :answer/type {:db/ident :answer.type/image} :answer/value "images/56/56500692e40074c06c3af5bf0f266bc3301b890eec36d7a3a2f0f4da715f1274.png" :db/id #edb/ref 17592186513371} {:answer/id #uuid "745e2430-cf01-57f7-9293-6978ebae3a55" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b2329ba289196d843e639dd7ef996db043c7d16d4059d050d3a647a545d56513.png" :db/id #edb/ref 17592186513379} {:answer/id #uuid "ddf54b3e-8733-5da3-b895-0038e8bee840" :answer/type {:db/ident :answer.type/image} :answer/value "images/81/814520f3d899ce2271b161f0165c2b5a9a75d06b3b9e206849c7d5292d0d16d7.png" :db/id #edb/ref 17592186513406} {:answer/id #uuid "f2d169b7-faae-5c13-bf66-8b8a0860caf9" :answer/type {:db/ident :answer.type/image} :answer/value "images/ab/ab0520786330580814795f0b26baf8b1fea0f8eef5d412ee58a924d22033d6bf.png" :db/id #edb/ref 17592186513415}] :answer-field/correct {:answer/id #uuid "f2d169b7-faae-5c13-bf66-8b8a0860caf9" :answer/type {:db/ident :answer.type/image} :answer/value "images/ab/ab0520786330580814795f0b26baf8b1fea0f8eef5d412ee58a924d22033d6bf.png" :db/id #edb/ref 17592186513415} :answer-field/id #uuid "ebc86fb2-1784-5175-81d5-a8f77889fd48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186513410}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bf1a711a-5309-5c92-bb28-c49295def6f8" :question/problem "Which of the following is the graph of $y=4.5({6}^{x})-8.5?$" :question/worked-solution "First, we plot the graph of $y={6}^{x}:$\n\n![](images/1b/1b936cf103a607a6b26a060ba747717062698ab005910923f36d54f1d002f119.png)\n\nNext, we plot the graph of $y=4.5({6}^{x}).$ To do this, we scale the graph above by a factor of $4.5.$ The $y$-intercept moves from $(0,1)$ to $(0,4.5),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/65/65b407d66afef166b041d27bdd37973d5897de96aaf1959aa2e9cceb5e4e17d5.png)\n\nFinally, we plot the graph of $y=4.5({6}^{x})-8.5.$ To do this, we shift the above graph $8.5$ units down. The $y$-intercept moves from $(0,4.5)$ to $(0,-4),$ and the horizontal asymptote moves from $y=0$ to $y=-8.5.$\n\n![](images/ab/ab0520786330580814795f0b26baf8b1fea0f8eef5d412ee58a924d22033d6bf.png)"} {:db/id #edb/ref 17592186513397 :knowledge-point/_questions [{:knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e952f4f-3e97-598f-bff9-bbd23ee2654f" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e6ba39f00ec3e15b528cf987bcaceb5328c00b70232