{:db/id 17592186059864 :knowledge-point/canonical-example {:db/id 17592186059443 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/id #uuid "72830b06-6333-5b61-8257-3967312bd178" :question/math-academy-id "e-140" :question/problem "Find $f'(x)$ for $f(x) = x^4 -\\dfrac{1}{x^2} + x$." :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}\nf^{′}(x) &= \\frac{d}{dx}(x^{4} - \\frac{1}{x^{2}} + x) \\\\\n&= \\frac{d}{dx}(x^{4} - x^{-2} + x) \\\\\n&= \\frac{d}{dx}(x^{4}) - \\frac{d}{dx}(x^{-2}) + \\frac{d}{dx}(x) \\\\\n&= 4x^{3} - (-2)x^{-3} + 1 \\\\\n&= 4x^{3} + 2x^{-3} + 1 \\\\\n&= 4x^{3} + \\frac{2}{x^{3}} + 1\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/questions [{:db/id 17592186059964 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "211bb0e5-3c78-5407-abe6-d36a7702b7f1" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}-\\frac{2}{{x}^{3}}-1" :db/id 17592186236028} {:answer/id #uuid "2b721848-7e95-5033-9e18-09f6e8945fa2" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{2}-\\frac{2}{{x}^{3}}-1" :db/id 17592186236090} {:answer/id #uuid "32dca761-7920-51b0-b217-36a70a04fd20" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}-\\frac{2}{{x}^{3}}+1" :db/id 17592186236137} {:answer/id #uuid "3f86bddf-d4bf-5ed2-9add-a90b0f3b1200" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+\\frac{2}{{x}^{3}}-1" :db/id 17592186236222} {:answer/id #uuid "ecf3d45d-887f-583c-a917-8a37435d41c4" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}-\\frac{2}{{x}^{3}}-1" :db/id 17592186237309}] :answer-field/correct {:answer/id #uuid "ecf3d45d-887f-583c-a917-8a37435d41c4" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}-\\frac{2}{{x}^{3}}-1" :db/id 17592186237309} :answer-field/id #uuid "49ccb49d-a87a-5cd3-8422-264f873526ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186237535}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "723e7a54-cfc4-55b5-8c13-7066946d5c44" :question/math-academy-id "q-10291" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{3}+\\frac{1}{{x}^{2}}-x.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3}+\\frac{1}{{x}^{2}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3{x}^{(3-1)}+(-2){x}^{(-2-1)}-1 \\\\  & =3{x}^{2}-2{x}^{-3}-1 \\\\  & =3{x}^{2}-\\frac{2}{{x}^{3}}-1.\\end{aligned}\n$$"} {:db/id 17592186060176 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86e98854-80b3-5d65-9183-9a837c517fa6" :answer/type {:db/ident :answer.type/math} :answer/value "2x - \\frac{2}{3\\sqrt[3]{x}}" :db/id 17592186057517} {:answer/id #uuid "a1356735-faf1-579b-b4eb-fba7de8c3beb" :answer/type {:db/ident :answer.type/math} :answer/value "3x + \\frac{2}{3\\sqrt[3]{x}}" :db/id 17592186057518} {:answer/id #uuid "c84452b7-68d7-504b-8780-31ddb09b2e1b" :answer/type {:db/ident :answer.type/math} :answer/value "3x + \\frac{2}{3\\sqrt[3]{x^{2}}}" :db/id 17592186057519} {:answer/id #uuid "391a4067-46ea-52ad-873b-6f9d766060f2" :answer/type {:db/ident :answer.type/math} :answer/value "2 - \\frac{2}{3\\sqrt[3]{x}}" :db/id 17592186057520} {:answer/id #uuid "62215762-a6b6-5117-8069-49f73af8a2d3" :answer/type {:db/ident :answer.type/math} :answer/value "2x - \\frac{2\\sqrt[3]{x}}{3}" :db/id 17592186057521}] :answer-field/id #uuid "7f5e9fa2-0b3d-50ce-8815-1b74c951bb17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186057516}] :question/id #uuid "f0ffe77b-9f55-5ef5-a473-aa125c24a3cf" :question/math-academy-id "q-1867" :question/problem "Find $f^{′}(x)$ for $f(x) = x^{2} - \\sqrt[3]{x^{2}}$."} {:db/id 17592186234278 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5874ca3-2b2b-5745-89a9-786e1eb30c03" :question/math-academy-id "q-70476" :question/problem "Find ${f}^{'}(x)$ for  $f(x)={x}^{2}+x-\\sqrt{x}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+x-\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}) \\\\  & =2{x}^{(2-1)}+1-\\frac{1}{2}{x}^{1/2-1} \\\\  & =2x+1-\\frac{1}{2}{x}^{-1/2} \\\\  & =2x-\\frac{1}{2\\sqrt{x}}+1.\\end{aligned}\n$$"} {:db/id 17592186234279 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f788136d-6553-588a-911f-c28a0567c565" :question/math-academy-id "q-70512" :question/problem "Find ${f}^{'}(x)$ for $f(x)=\\sqrt[5]{{x}^{3}}-\\frac{1}{{x}^{3}}.$" :question/worked-solution "The function $f(x)$ is the sum of two power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{'}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt[5]{{x}^{3}}-\\frac{1}{{x}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{3/5})-\\frac{\\text{d}}{\\text{d}x}({x}^{-3}) \\\\  & =\\frac{3}{5}{x}^{(3/5-1)}-(-3){x}^{(-3-1)} \\\\  & =\\frac{3}{5}{x}^{(-2/5)}+3{x}^{(-4)} \\\\  & =\\frac{3}{5\\sqrt[5]{{x}^{2}}}+\\frac{3}{{x}^{4}}.\\end{aligned}\n$$"} {:db/id 17592186314784 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3469bdd-a201-5219-a734-ed3caa6b039a" :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a52feee3-bcc7-5857-b3da-4e1a66f6888b" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{4}+\\frac{4}{3}{x}^{1/3}" :db/id 17592186313273}] :answer-field/correct {:answer/id #uuid "a52feee3-bcc7-5857-b3da-4e1a66f6888b" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{4}+\\frac{4}{3}{x}^{1/3}" :db/id 17592186313273} :answer-field/id #uuid "988535d9-3bde-548e-878b-500a65755625" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186314425}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d57eb0df-b672-57ca-8fc9-d0cc8d741df8" :question/math-academy-id "q-339462" :question/problem "Find ${f}^{′}(x)$ for $f(x)={x}^{5}+\\sqrt[3]{{x}^{4}}.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The function $f(x)$  is the sum of two power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+\\sqrt[3]{{x}^{4}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{4/3}) \\\\  & =5{x}^{(5-1)}+\\frac{4}{3}{x}^{(4/3-1)} \\\\  & =5{x}^{4}+\\frac{4}{3}{x}^{1/3} \\\\  & =5{x}^{4}+\\frac{4}{3}\\sqrt[3]{x}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Sum of Functions Without Constant Factors Using the Sum Rule"}
