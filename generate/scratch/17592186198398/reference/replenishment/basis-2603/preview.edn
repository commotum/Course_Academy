t)\\right) \\\\  & =6.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{\\partial(x,y,z)}{\\partial(u,v,w)}=\\left(\\frac{\\partial(u,v,w)}{\\partial(x,y,z)}\\right)^{-1}=\\frac{1}{6}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}\\iiint_R \\left(\\left(3 x - 2 y\\right) \\left(y + 2 z\\right)\\right)\\,\\mathrm{d}V & =\\iiint_\\Delta \\left(u v\\right)\\cdot \\left|\\frac{1}{6}\\right|\\,\\mathrm{d}u\\mathrm{d}v\\mathrm{d}w \\\\  & =\\iiint_\\Delta \\left(\\frac{u v}{6}\\right)\\,\\mathrm{d}u\\mathrm{d}v\\mathrm{d}w \\\\  & =\\int_{0}^{1}\\int_{0}^{3}\\int_{0}^{4}\\left(\\frac{u v}{6}\\right)\\,\\mathrm{d}w\\,\\mathrm{d}v\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\int_{0}^{3}\\left(\\left[\\frac{u v w}{6}\\right]_{w=0}^{w=4}\\right)\\,\\mathrm{d}v\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\int_{0}^{3}\\left(\\left(\\frac{u v \\left(4\\right)}{6}\\right)-\\left(\\frac{u v \\left(0\\right)}{6}\\right)\\right)\\,\\mathrm{d}v\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\int_{0}^{3}\\left(\\left(\\frac{2 u v}{3}\\right)-\\left(0\\right)\\right)\\,\\mathrm{d}v\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\int_{0}^{3}\\left(\\frac{2 u v}{3}\\right)\\,\\mathrm{d}v\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\left(\\left[\\frac{u v^{2}}{3}\\right]_{v=0}^{v=3}\\right)\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\left(\\left(\\frac{u \\left(3\\right)^{2}}{3}\\right)-\\left(\\frac{u \\left(0\\right)^{2}}{3}\\right)\\right)\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\left(\\left(3 u\\right)-\\left(0\\right)\\right)\\,\\mathrm{d}u \\\\  & =\\int_{0}^{1}\\left(3 u\\right)\\,\\mathrm{d}u \\\\  & =\\left[\\frac{3 u^{2}}{2}\\right]_{u=0}^{u=1} \\\\  & =\\left(\\frac{3 \\left(1\\right)^{2}}{2}\\right)-\\left(\\frac{3 \\left(0\\right)^{2}}{2}\\right) \\\\  & =\\left