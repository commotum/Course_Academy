}{∂y}(y) \\\\  & =3 x^{2}\\cdot (2 y)+2 x\\cdot (1) \\\\  & =6 y x^{2}+2 x\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1)} & =6 (1) (1)^{2}+2 (1) \\\\  & =6+(2) \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560297 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ea927af-1007-572a-922f-4aefb0c8767e" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186560264} {:answer/id #uuid "61615a5c-1c97-5ca0-97b9-f795b28e5c8c" :answer/type {:db/ident :answer.type/math} :answer/value "-13" :db/id #edb/ref 17592186560274} {:answer/id #uuid "64686f40-7ee7-549c-8a01-588a18b5d8b9" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186560276} {:answer/id #uuid "7176a7f5-da12-53cf-9ffd-85f92b2fb510" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186560279} {:answer/id #uuid "e1c4d2a1-1c92-5c12-9540-6b62a7ee553f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186560291}] :answer-field/correct {:answer/id #uuid "2ea927af-1007-572a-922f-4aefb0c8767e" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186560264} :answer-field/id #uuid "371473f6-d498-5af3-980f-2a37043ccdd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560268}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f71f04b5-8161-5a16-8003-15968bea5986" :question/problem "For the function $f(x,y)=3 x^{2} y^{2}+x y,$ evaluate $\\frac{∂f}{∂x}$ at the point $(-2,1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(3 x^{2} y^{2}+x y) \\\\  & =\\frac{∂}{∂x}(3 x^{2} y^{2})+\\frac{∂}{∂x}(x y) \\\\  & =3 y^{2}\\cdot \\frac{∂}{∂x}(x^{2})+y\\cdot \\frac{∂}{∂x}(x) \\\\  & =3 y^{2}\\cdot (2 x)+y\\cdot (1) \\\\  & =6 x y^{2}+y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(-2,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(-2,1)} & =6 (-2) (1)^{2}+(1) \\\\  & =-12+(1) \\\\  & =-11\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating a Partial Derivative at a Point"}]}
