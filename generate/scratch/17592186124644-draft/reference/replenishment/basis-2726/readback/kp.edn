edge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32674586-4e3a-5879-b109-f0eb8a8c0450" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}+1" :db/id #edb/ref 17592186275924} {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} {:answer/id #uuid "a7c2cdb1-d291-595f-9c08-8200c680205a" :answer/type {:db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186276990} {:answer/id #uuid "cfe844ab-c3d2-5244-a7bf-3826f1851815" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}e+1" :db/id #edb/ref 17592186277319} {:answer/id #uuid "edeb7583-0cc3-58db-a0ea-b3a8684a62fb" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186277568}] :answer-field/correct {:answer/id #uuid "3bd21982-4f35-584b-905b-d8f52b1c2efd" :answer/type {:db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186276001} :answer-field/id #uuid "64f03706-d8ba-5c00-9d36-3018e3c877be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d7d1dc5-2124-525b-9cc9-fe9b2cf1012d" :question/math-academy-id "q-159599" :question/problem "For the function $f(x,y)={e}^{x}\\operatorname{ln}⁡y+{x}^{7}y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,\\frac{1}{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y+{x}^{7}y) \\\\  & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y)+\\frac{∂}{∂y}({x}^{7}y) \\\\  & ={e}^{x}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+{x}^{7}\\cdot \\frac{∂}{∂y}(y) \\\\  & ={e}^{x}\\cdot (\\frac{1}{y})+{x}^{7}\\cdot (1) \\\\  & =\\frac{{e}^{x}}{y}+{x}^{7}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1/2)} & =\\frac{{e}^{1}}{(\\frac{1}{2})}+{1}^{7} \\\\  & =2e+1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278237 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dacf2f-9956-5eff-b30e-18510d8360b3" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186275708} {:answer/id #uuid "56d691d2-2344-50e8-b755-1515d6701246" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186276253} {:answer/id #uuid "8909b9e2-69c1-5292-8bb6-bb0f8619ca13" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186276715} {:answer/id #uuid "be12f9bb-678a-5eac-a78c-690ff881310b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186277173} {:answer/id #uuid "e7fee579-97b0-59d0-abb2-7262de5ad4e2" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277507}] :answer-field/correct {:answer/id #uuid "e7fee579-97b0-59d0-abb2-7262de5ad4e2" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186277507} :answer-field/id #uuid "16fdfad6-c4ab-5074-9d21-20b8c8a78547" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277765}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "099a0674-bec3-5a03-b0cd-02423c11a6a6" :question/math-academy-id "q-159602" :question/problem "For the function $f(x,y)=4y{x}^{2}-x{y}^{4},$ evaluate $\\frac{∂f}{∂y}$ at the point $(2,1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(4y{x}^{2}-x{y}^{4}) \\\\  & =\\frac{∂}{∂y}(4y{x}^{2})-\\frac{∂}{∂y}(x{y}^{4}) \\\\  & =4{x}^{2}\\cdot \\frac{∂}{∂y}(y)-x\\cdot \\frac{∂}{∂y}({y}^{4}) \\\\  & =4{x}^{2}\\cdot (1)-x\\cdot (4{y}^{3}) \\\\  & =4{x}^{2}-4x{y}^{3}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(2,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(2,1)} & =4\\cdot {2}^{2}-4\\cdot 2\\cdot {1}^{3} \\\\  & =16-8 \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186278238 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} {:answer/id #uuid "2307c0e9-79a7-5b71-94fb-81d1846549c4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186275789} {:answer/id #uuid "24ba32c9-8d5c-5863-b6a3-b590ddbbf12f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275808} {:answer/id #uuid "2bdb0760-9291-5b88-884e-ce3f76c09234" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275876} {:answer/id #uuid "cfdca77f-9773-5630-851d-65b8078cfedf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277318}] :answer-field/correct {:answer/id #uuid "0081d662-2a76-5db6-a085-ab046b4fb0d6" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275484} :answer-field/id #uuid "370efeef-a1d5-51c2-8154-bfdd43bcb49d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277810}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "761131e3-fd5c-5281-9b00-7e9bad552026" :question/math-academy-id "q-159607" :question/problem "For the function $f(x,y)=x\\operatorname{sec}⁡y+{x}^{4}y,$ evaluate ${f}_{y}(\\sqrt{2},\\frac{\\pi }{4}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y+{x}^{4}y) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sec}⁡y)+\\frac{∂}{∂y}({x}^{4}y) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\operatorname{sec}⁡y)+{x}^{4}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot (\\operatorname{sec}⁡y\\operatorname{tan}⁡y)+{x}^{4}\\cdot (1) \\\\  & =x\\operatorname{sec}⁡y\\operatorname{tan}⁡y+{x}^{4}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\sqrt{2},\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}{f}_{y}(\\sqrt{2},\\frac{\\pi }{4}) & =\\sqrt{2}\\cdot \\operatorname{sec}⁡(\\frac{\\pi }{4})\\cdot \\operatorname{tan}⁡(\\frac{\\pi }{4})+{(\\sqrt{2})}^{4} \\\\  & =\\sqrt{2}\\cdot \\sqrt{2}\\cdot 1+4 \\\\  & =6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381181 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383a34d-6e32-5f0f-87b8-e7ec3d81fb75" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186381183} {:answer/id #uuid "f18943a3-6ebe-57f1-9bae-7fc754040e67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/r