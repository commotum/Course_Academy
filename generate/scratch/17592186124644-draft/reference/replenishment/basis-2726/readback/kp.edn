artial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58a19112-03ca-50b8-84a1-fe692ba95087" :answer/type {:db/ident :answer.type/math} :answer/value "30\\operatorname{ln}⁡3" :db/id #edb/ref 17592186436300} {:answer/id #uuid "60c0f614-7c90-5e8c-8d18-e07fc305806f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-5" :db/id #edb/ref 17592186436301} {:answer/id #uuid "9e7a5161-9c2f-5c14-b85f-c8f0665e4971" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3" :db/id #edb/ref 17592186436308} {:answer/id #uuid "a2ff159b-22e8-5203-b53e-81a9138124a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-30" :db/id #edb/ref 17592186436311} {:answer/id #uuid "e9c6a17e-95c5-56f6-8ecd-f1ad41f668be" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-10" :db/id #edb/ref 17592186436322}] :answer-field/correct {:answer/id #uuid "a2ff159b-22e8-5203-b53e-81a9138124a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3-30" :db/id #edb/ref 17592186436311} :answer-field/id #uuid "db764a00-316f-56d9-8f40-2a0441db7ae8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436327}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90392678-f725-5c12-933c-87fa3256c47c" :question/math-academy-id "q-159609" :question/problem "For the function $f(x,y)=y\\operatorname{ln}⁡x-2{x}^{5}{e}^{y},$ evaluate ${f}_{x}(1,\\operatorname{ln}⁡3).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x-2{x}^{5}{e}^{y}) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x)-\\frac{∂}{∂x}(2{x}^{5}{e}^{y}) \\\\  & =y\\cdot \\frac{∂}{∂x}(\\operatorname{ln}⁡x)-2{e}^{y}\\cdot \\frac{∂}{∂x}({x}^{5}) \\\\  & =y\\cdot (\\frac{1}{x})-2{e}^{y}\\cdot (5{x}^{4}) \\\\  & =\\frac{y}{x}-10{x}^{4}{e}^{y}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,\\operatorname{ln}⁡3):$\n\n$$\n\\begin{aligned}{f}_{x}(1,\\operatorname{ln}⁡3) & =\\frac{\\operatorname{ln}⁡3}{1}-10\\cdot {1}^{4}\\cdot {e}^{\\operatorname{ln}⁡3} \\\\  & =\\operatorname{ln}⁡3-10\\cdot 3 \\\\  & =\\operatorname{ln}⁡3-30\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560258 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29ae3e04-d75d-5e50-a1d8-2e2f3b14548a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186560263} {:answer/id #uuid "4f8f0941-242b-56dc-acb3-8445828e2e44" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186560272} {:answer/id #uuid "6e428339-ef99-55d2-b4e3-6051ca192247" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186560278} {:answer/id #uuid "7479ca5f-2358-5e22-8cd3-5525c5bd7322" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186560280} {:answer/id #uuid "e3f4b07d-d167-52a6-8ffe-b705d15b6344" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186560293}] :answer-field/correct {:answer/id #uuid "29ae3e04-d75d-5e50-a1d8-2e2f3b14548a" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186560263} :answer-field/id #uuid "6bd013bf-07bc-5cb9-a7a8-da55318ffd08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560277}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "147e9a52-51e2-5c74-9d4e-fa093aa4d65f" :question/problem "For the function $f(x,y)=4 y^{2} x^{2}+2 y x,$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,-1).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(4 y^{2} x^{2}+2 y x) \\\\  & =\\frac{∂}{∂y}(4 y^{2} x^{2})+\\frac{∂}{∂y}(2 y x) \\\\  & =4 x^{2}\\cdot \\frac{∂}{∂y}(y^{2})+2 x\\cdot \\frac{∂}{∂y}(y) \\\\  & =4 x^{2}\\cdot (2 y)+2 x\\cdot (1) \\\\  & =8 y x^{2}+2 x\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,-1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,-1)} & =8 (-1) (1)^{2}+2 (1) \\\\  & =-8+(2) \\\\  & =-6\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560267 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "281c0703-b852-50f5-8381-792285de4691" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186560261} {:answer/id #uuid "3d071372-a702-5054-9530-d8a986bccb43" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186560269} {:answer/id #uuid "42ae0e48-13dc-5b0f-b8c1-406c19758160" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186560270} {:answer/id #uuid "bbb7a185-f349-5e40-ac52-62cecf93127c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186560282} {:answer/id #uuid "c79d2567-45d4-55eb-9a14-125790434e5a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186560285}] :answer-field/correct {:answer/id #uuid "bbb7a185-f349-5e40-ac52-62cecf93127c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186560282} :answer-field/id #uuid "34a56f04-6d05-50b3-b8ef-e1103d356ab6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186560266}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3650aa55-ef47-53fa-ba3d-5f154dc4d603" :question/problem "For the function $f(x,y)=x^{2} y^{2}+2 x y,$ evaluate $\\frac{∂f}{∂x}$ at the point $(3,1).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x^{2} y^{2}+2 x y) \\\\  & =\\frac{∂}{∂x}(x^{2} y^{2})+\\frac{∂}{∂x}(2 x y) \\\\  & =y^{2}\\cdot \\frac{∂}{∂x}(x^{2})+2 y\\cdot \\frac{∂}{∂x}(x) \\\\  & =y^{2}\\cdot (2 x)+2 y\\cdot (1) \\\\  & =2 x y^{2}+2 y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(3,1):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(3,1)} & =2 (3) (1)^{2}+2 (1) \\\\  & =6+(2) \\\\  & =8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186560283 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1974496f-78dd-5c57-b8ec-dc05525accf0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186560259} {:answer/id #uuid "31f0a8fb-fb91-5f05-a1c6-0f7919bcc8ca" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186560265} {:answer/id #uuid "61d1bf7e-2e8a-58b1-89e7-37532ce1d411" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186560275} {:answer/id #uuid "c650800f-fc8f-5c0f-87af-deec9d5ecc1f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 1