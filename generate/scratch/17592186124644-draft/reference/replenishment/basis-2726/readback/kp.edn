stions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cb46f74-a6ac-51dd-9716-053467775795" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186381197} {:answer/id #uuid "7c752b1e-3494-58b3-91b3-bc63d9070f67" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186381198} {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} {:answer/id #uuid "57c21eba-c639-589d-a590-6b2758f94e7d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186381200} {:answer/id #uuid "437f7400-06af-5d12-8795-82aceaaa029f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186381201}] :answer-field/correct {:answer/id #uuid "ba33d251-da28-523a-a29f-e0b6420aeb9c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186381199} :answer-field/id #uuid "3bc66302-048f-5b61-a77f-e57947059d3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85a0874e-f8e3-58ee-a763-3ef7eef71825" :question/math-academy-id "q-159600" :question/problem "For the function $f(x,y)=2x\\sqrt{y}-4y\\sqrt{x},$ evaluate $\\frac{∂f}{∂x}$ at the point $(1,4).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(2x\\sqrt{y}-4y\\sqrt{x}) \\\\  & =\\frac{∂}{∂x}(2x\\sqrt{y})-\\frac{∂}{∂x}(4y\\sqrt{x}) \\\\  & =2\\sqrt{y}\\cdot \\frac{∂}{∂x}(x)-4y\\cdot \\frac{∂}{∂x}(\\sqrt{x}) \\\\  & =2\\sqrt{y}\\cdot (1)-4y\\cdot (\\frac{1}{2\\sqrt{x}}) \\\\  & =2\\sqrt{y}-\\frac{2y}{\\sqrt{x}}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,4):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,4)} & =2\\sqrt{4}-\\frac{2\\cdot 4}{\\sqrt{1}} \\\\  & =4-8 \\\\  & =-4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381202 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fcd07b7-50b4-5ed1-b9d3-2a201e5d7d85" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\pi " :db/id #edb/ref 17592186381204} {:answer/id #uuid "1def416a-9115-5f32-affa-b8039b5e3e5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186381205} {:answer/id #uuid "c69f5c3f-2861-5ba1-aeb3-abdd43e0cb6c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186381206} {:answer/id #uuid "70a9f79d-b5dc-5ada-901e-3f661c7aa60d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186381207} {:answer/id #uuid "1d3a15eb-a517-5392-b575-6d93c1835d8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }-\\pi " :db/id #edb/ref 17592186381208}] :answer-field/correct {:answer/id #uuid "c69f5c3f-2861-5ba1-aeb3-abdd43e0cb6c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186381206} :answer-field/id #uuid "6a6cd008-5190-5b59-930e-c8142bae276f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381203}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b549b8fe-2ea6-52d5-aba5-f73f5834b6db" :question/math-academy-id "q-159601" :question/problem "For the function $f(x,y)=\\operatorname{cos}⁡x\\operatorname{ln}⁡y-x\\operatorname{sin}⁡y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(\\pi ,\\frac{\\pi }{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{ln}⁡y-x\\operatorname{sin}⁡y) \\\\  & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x\\operatorname{ln}⁡y)-\\frac{∂}{∂y}(x\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)-x\\cdot \\frac{∂}{∂y}(\\operatorname{sin}⁡y) \\\\  & =\\operatorname{cos}⁡x\\cdot (\\frac{1}{y})-x\\cdot (\\operatorname{cos}⁡y) \\\\  & =\\frac{\\operatorname{cos}⁡x}{y}-x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi ,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(\\pi ,\\pi /2)} & =\\frac{\\operatorname{cos}⁡\\pi }{(\\frac{\\pi }{2})}-\\pi \\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =-\\frac{2}{\\pi }-0 \\\\  & =-\\frac{2}{\\pi }\\end{aligned}\n$$"} {:db/id #edb/ref 17592186381209 :knowledge-point/_questions [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d0ef6ef-d5c2-5f7d-b007-5d1f8bcb76dd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi " :db/id #edb/ref 17592186381211} {:answer/id #uuid "d2d3c50a-be40-5168-9b60-89cddf3610ff" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\pi " :db/id #edb/ref 17592186381212} {:answer/id #uuid "885ea363-dc99-5baa-bdb0-83b42d304c47" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id #edb/ref 17592186381213} {:answer/id #uuid "7e4f7612-4c6b-5535-81d9-f5903c791c