es."} {:db/id #edb/ref 17592186528202 :knowledge-point/_questions [{:knowledge-point/id #uuid "acc86fb6-2ef4-5f8f-b204-6e1fdbbf0530" :knowledge-point/title "Calculating the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e00c69c-7140-5a91-bc25-fb3cb510ab19" :answer/type {:db/ident :answer.type/math} :answer/value "122.08" :db/id #edb/ref 17592186528166} {:answer/id #uuid "5e143c6a-45fd-5406-a2c9-ecce0e748b21" :answer/type {:db/ident :answer.type/math} :answer/value "91.56" :db/id #edb/ref 17592186528167} {:answer/id #uuid "77ed3770-e79f-5713-a011-64c855f5e1b6" :answer/type {:db/ident :answer.type/math} :answer/value "105.72" :db/id #edb/ref 17592186528179} {:answer/id #uuid "7d774cb1-e3be-5a6a-beed-71d76c37f591" :answer/type {:db/ident :answer.type/math} :answer/value "61.04" :db/id #edb/ref 17592186528181} {:answer/id #uuid "d95ff031-43b0-53d2-8493-6eae61a9079f" :answer/type {:db/ident :answer.type/math} :answer/value "211.45" :db/id #edb/ref 17592186528216}] :answer-field/correct {:answer/id #uuid "77ed3770-e79f-5713-a011-64c855f5e1b6" :answer/type {:db/ident :answer.type/math} :answer/value "105.72" :db/id #edb/ref 17592186528179} :answer-field/id #uuid "0f6847d1-f3af-5f02-b780-d2a2e0e9759a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186528146}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3432857-0428-5f87-9dca-9025817c8378" :question/problem "![](images/e2/e2f46ef29f428b654f06e042ce077aadcf763b92d1455411916bd3605c05b66d.png)\n\nFind the area of $△ABC$. Round your answer to two decimal places." :question/requires-calculator true :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere, we have\n\n$$\n\\begin{aligned}c & =AB=10.9, \\\\ b & =AC=22.4, \\\\ m∠A 