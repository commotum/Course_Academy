#edb/ref 17592186393302} {:answer/id #uuid "e2f102ba-ebea-5b42-ae75-3e35aaa4dcb9" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186393303} {:answer/id #uuid "0716f4f7-16c9-5c13-b702-47eba0dfd09b" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & \\frac{3}{2}\\end{array}\\right]" :db/id #edb/ref 17592186393304} {:answer/id #uuid "d6ec307f-5f81-58e7-8c8e-0f70f0701a1d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186393305}] :answer-field/correct {:answer/id #uuid "84dcd969-8fc8-57ef-9240-0a47ae01dcdc" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186393301} :answer-field/id #uuid "f86bf6ae-95b6-5b45-9f58-e55f64d234d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26bbee69-6c8f-5073-bf18-e5b7229f3605" :question/math-academy-id "q-73538" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x-2y &=4 \\\\ 2x-y &=2.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{array}\\right] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 2 & -1 & 2\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3}\\end{array}\\right] & {R}_{2} & :=3{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393306 :knowledge-point/_questions [{:knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7b08e6-d085-5aaa-8d73-b963955cfc39" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{array}\\right],$\n$\\,x=1$ and $y=-1$" :db/id #edb/ref 17592186393308} {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} {:answer/id #uuid "af523f5a-739c-5f31-b5eb-464880f8d7fb" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -4\\end{array}\\right],$\n$\\,x=-5$ and $y=-4$" :db/id #edb/ref 17592186393310} {:answer/id #uuid "1b343ef7-3ddf-5c6c-94e7-03e5be9701c9" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 2\\end{array}\\right],$\n$\\,x=7$ and $y=2$" :db/id #edb/ref 17592186393311} {:answer/id #uuid "374d0aef-c48a-512b-ba16-2324cb201e02" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & 4\\end{array}\\right],$\n$\\,x=11$ and $y=4$" :db/id #edb/ref 17592186393312}] :answer-field/correct {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} :answer-field/id #uuid "de9973d7-7169-5172-bb3d-d4ad9a2d6a14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393307}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e51e1e1-f4ea-594e-af90-cfd7caef02c6" :question/math-academy-id "q-73544" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y &=6 \\\\ 4x-7y &=10.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=3 \\\\ y &=-2,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$"} {:db/id #edb/ref 17592186393313 :knowledge-point/_questions [{:knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "784ffc66-edc8-51a6-ac2b-356c0e08dea7" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186393315} {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186393316} {:answer/id #uuid "12a340da-e725-5a88-a527-27d71e519f66" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186393317} {:answer/id #uuid "335c8f2c-6e1a-56c3-b0b9-94d13c9ad70f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186393318} {:answer/id #uuid "0e6a6bdb-d757-58d4-980e-64a7fa142831" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & -2 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393319}] :answer-field/correct {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186393316} :answer-field/id #uuid "240d40bc-cf1d-5886-b54c-59f3d0b765cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08ec22c2-8cd9-5dca-af3f-944499fe851c" :question/math-academy-id "q-73551" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}5x-15y &=10 \\\\ 2x-4y &=4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{array}\\right] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 2 & -4 & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 2 & 0\\end{array}\\right] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{array}\\right].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186414018 :knowledge-point/_questions [{:knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b00cee-94fc-5ef4-95de-2345a02742de" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 4\\end{array}\\right]" :db/id #edb/ref 17592186414012} {:answer/id #uuid "35507ba3-dc5e-5f36-bb3c-2cadb07fb8ff" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186414013} {:answer/id #uuid "632206dd-bb16-5704-9288-1e7bf08e0cfc" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186414014} {:answer/id #uuid "7bad20ef-df3c-52d4-a10d-b7e2a38262ad" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -4\\end{array}\\right]" :db/id #edb/ref 17592186414015} {:answer/id #uuid "92cfbdd1-6bb8-5b06-89f2-6d7a9c5e7075" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186414016}] :answer-field/correct {:answer/id #uuid "35507ba3-dc5e-5f36-bb3c-2cadb07fb8ff" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186414013} :answer-field/id #uuid "cae93ed5-7aca-5036-ae81-d4a677001210" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13eff08d-2b22-5094-8876-818462babb6f" :question/math-academy-id "q-73554" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-8y &=10 \\\\ 3x-7y &=5.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -8 & 10 \\\\ 3 & -7 & 5\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 3 & -7 & 5\\end{array}\\right] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 5 & -10\\end{array}\\right] & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & 5 \\\\ 0 & 1 & -2\\end{array}\\right].\\end{aligned}\n$$"}] :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}]}
