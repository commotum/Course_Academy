{:db/id 17592186092240 :knowledge-point/canonical-example {:db/id 17592186092083 :question/id #uuid "e405bf60-d500-55df-90be-a938dc9dfc93" :question/math-academy-id "e-6080" :question/problem "The equation of the normal line to the curve $y=x^3 - x^2$ at the point $(1,0)$ is given by $y=px+q$ where $p$ and $q$ are constants. Find the values of $p$ and $q.$" :question/worked-solution "Let $f(x)=x^3 - x^2.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{3}-{x}^{2})=3{x}^{2}-2x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1, 0){:}$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=3-2=1\\end{aligned}\n$$\n\nTherefore, the slope of the normal line $m'$ is\n\n$$\nm'=-\\dfrac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-0 & =-(x-1) \\\\ y & =-x+1.\\end{aligned}\n$$\n\nTherefore, $p=-1$ and $q=1.$"} :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/key-prerequisites [{:db/id 17592186050635}] :knowledge-point/questions [{:db/id 17592186092722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3826d54-f39e-5e45-982c-0196c96b30c9" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "77" :db/id 17592186090533} {:answer/id #uuid "bf822091-623a-5b75-a700-06562c3fa7b0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id 17592186090534} {:answer/id #uuid "c014a862-aa95-5ee5-8cc4-90a1115cf633" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id 17592186090535} {:answer/id #uuid "e535f72e-5b43-5878-a978-9a20e1d8470d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "56" :db/id 17592186090536} {:answer/id #uuid "48a27df3-0a04-52a4-9003-fd2c61c07e74" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id 17592186090537}] :answer-field/id #uuid "7907bce1-6e91-548c-bf8c-f50341390d5a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186090532}] :question/id #uuid "2a649b33-83ae-5424-9852-7d09d082fffc" :question/math-academy-id "q-47406" :question/problem "The equation of the normal line to the curve $y = 2x^{2}$ at the point $(2, 8)$ is given by $x + py = q$ where $p$ and $q$ are constants. Find the value of $p + q$."} {:db/id 17592186092724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "355be2d9-4b88-5b77-9339-b936d34c03d7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id 17592186327396} {:answer/id #uuid "464056c0-a0f2-5bfe-b408-9aa941897b3d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186327549} {:answer/id #uuid "877dfb13-75fb-5a2c-9893-61ca31652033" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id 17592186328100} {:answer/id #uuid "b7e2320c-32e8-55f4-858e-5dbe27b873eb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id 17592186328534} {:answer/id #uuid "beaa42aa-dbd3-5b01-b81b-d37b04fb64c0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id 17592186328599}] :answer-field/correct {:answer/id #uuid "464056c0-a0f2-5bfe-b408-9aa941897b3d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186327549} :answer-field/id #uuid "ebf413bf-6c88-5e40-a13e-f1edd13516cf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186329596}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1cac491-67f0-58ca-a542-a3096fac9ba0" :question/math-academy-id "q-47408" :question/problem "The equation of the normal line to the curve $y=2{x}^{5}-2x$ at the point $(1,0)$ is given by $y=ax+b$ where $a$ and $b$ are constants. Find the value of $a+b.$" :question/worked-solution "Let $f(x)=2{x}^{5}-2x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{5}-2x)=10{x}^{4}-2\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,0):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=10(1)^{4}-2=8\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-0 & =-\\frac{1}{8}(x-1) \\\\ y & =-\\frac{x}{8}+\\frac{1}{8}.\\end{aligned}\n$$\n\nTherefore, $a+b=-\\frac{1}{8}+\\frac{1}{8}=0.$"} {:db/id 17592186233912 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f08372b9-b9c4-55c6-8130-e0b8b3702f70" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186232834}] :answer-field/correct {:answer/id #uuid "f08372b9-b9c4-55c6-8130-e0b8b3702f70" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186232834} :answer-field/id #uuid "db38cb75-4a2a-5faa-9624-427353b91e8d" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186232833} {:answer-field/choices [{:answer/id #uuid "3b547da1-c70a-5896-a34a-6ec75b964807" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id 17592186232836}] :answer-field/correct {:answer/id #uuid "3b547da1-c70a-5896-a34a-6ec75b964807" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "74" :db/id 17592186232836} :answer-field/id #uuid "dd6f2a88-c9b9-5995-986d-d685474cd66d" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186232835}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "67a4f8ec-9201-5937-9164-8f60e8aa0551" :question/math-academy-id "q-340942" :question/problem "Find the equation of the normal line to the curve $y=2{x}^{2}+1$ at the point $(2,9).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=2{x}^{2}+1.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+1)=4x\n$$\n\nThen, we compute the slope of the tangent at the point $(2,9):$\n\n$$\nm={f}^{'}(2)=4(2)=8\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-9 & =-\\frac{1}{8}(x-2) \\\\ 8y-72 & =-x+2 \\\\ x+8\\cdot y & =74.\\end{aligned}\n$$"} {:db/id 17592186233927 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040d200c-28e8-5295-aed7-d520e9cd3e2a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186232867}] :answer-field/correct {:answer/id #uuid "040d200c-28e8-5295-aed7-d520e9cd3e2a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186232867} :answer-field/id #uuid "8bbf44b5-3a8a-56c7-b5b8-1662b361ece7" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186232866} {:answer-field/choices [{:answer/id #uuid "03cd55b4-a689-56b0-ad87-45efc20ee812" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186232869}] :answer-field/correct {:answer/id #uuid "03cd55b4-a689-56b0-ad87-45efc20ee812" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186232869} :answer-field/id #uuid "ed007c73-3599-5c78-af4d-81875dcfb067" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186232868}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31017300-66b4-5dbf-aba1-d07ddfcf96a8" :question/math-academy-id "q-342163" :question/problem "Find the equation of the normal line to the curve $y=4x-{x}^{3}$ at the point $(1,3).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=4x-{x}^{3}.$ First, we compute the derivative:\n\n$$\n{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(4x-{x}^{3})=4-3{x}^{2}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,3):$\n\n$$\nm={f}^{'}(1)=4-3({1}^{2})=1\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-1.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-1\\cdot (x-1) \\\\ y-3 & =-x+1 \\\\ x+1\\cdot y & =4.\\end{aligned}\n$$"} {:db/id 17592186234077 :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a936e865-c9ea-5dbc-8fe2-541cf4f4a61c" :question/math-academy-id "q-47405" :question/problem "The equation of the normal line to the curve $y=2{x}^{3}$ at the point $(2,16)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $q-p.$" :question/worked-solution "Let $f(x)=2{x}^{3}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{'}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{3})=6{x}^{2}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,16):$\n\n$$\n\\begin{aligned}m={f}^{'}(2)=6(2)^{2}=24\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{'}$ is\n\n$$\n{m}^{'}=-\\frac{1}{m}=-\\frac{1}{24}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(16) & =-\\frac{1}{24}(x-(2)) \\\\ 24y-384 & =-x+2 \\\\ x+24y & =386.\\end{aligned}\n$$\n\nTherefore, $q-p=386-24=362.$"} {:db/id 17592186235432 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b1ba0de-62d4-5250-bb47-4f2a59dfcd01" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}" :db/id 17592186234782}] :answer-field/correct {:answer/id #uuid "9b1ba0de-62d4-5250-bb47-4f2a59dfcd01" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}" :db/id 17592186234782} :answer-field/id #uuid "3c9641fb-c8f3-5eae-84db-0c0deb61bedb" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186235032}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dde111b-f4d3-5f08-91c6-efd9593de57f" :question/math-academy-id "q-167327" :question/problem "The equation of the normal to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is\n\n                            \n                                    \n                                        \n                                        $\\,y=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "When $x=\\pi ,$ we have\n\n$$\n\\begin{aligned}y(\\pi ) & =f(\\pi )\\cdot h(\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot (-4\\operatorname{sin}⁡\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nIn part 3, we found that the slope of the tangent line to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is $m=2{e}^{\\pi }.$ Therefore, the slope of the normal ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{2{e}^{\\pi }}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-0 & =-\\frac{1}{2{e}^{\\pi }}(x-\\pi ) \\\\ y & =-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}.\\end{aligned}\n$$"} {:db/id 17592186235480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4decc47b-808c-50a3-a38e-a4db1547ccf8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}" :db/id 17592186234665}] :answer-field/correct {:answer/id #uuid "4decc47b-808c-50a3-a38e-a4db1547ccf8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}" :db/id 17592186234665} :answer-field/id #uuid "1a661154-3b70-50d8-a6af-d295b9a56bb0" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186234996}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d970612-b8f0-51a2-9d52-e3fa3b8f917e" :question/math-academy-id "q-167781" :question/problem "The equation of the normal line to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        $\\,y=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "When $x=\\pi ,$ we have\n\n$$\n\\begin{aligned}y(\\pi ) & =f(\\pi )\\cdot h(\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot (-4\\operatorname{sin}⁡(\\pi )) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nIn part 3, we found that the slope of the tangent line to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is $m=2{e}^{\\pi }.$ Therefore, the slope of the normal ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{2{e}^{\\pi }}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-0 & =-\\frac{1}{2{e}^{\\pi }}(x-\\pi ) \\\\ y & =-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}.\\end{aligned}\n$$"} {:db/id 17592186238020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cc92670-1ee0-5a94-8633-ae4dbac0d967" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186236503} {:answer/id #uuid "a9f4214d-961d-587a-99f1-77840683d122" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186236888} {:answer/id #uuid "d2b8f9a0-77e0-5918-ba96-c076ccd0a4a5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186237149} {:answer/id #uuid "d8b35714-a77b-5cf7-b620-bbbde6e0b91e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id 17592186237187} {:answer/id #uuid "f71cabe8-d7a8-53fa-97ce-f3e2f21c3251" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186237376}] :answer-field/correct {:answer/id #uuid "a9f4214d-961d-587a-99f1-77840683d122" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id 17592186236888} :answer-field/id #uuid "0fc67540-c6a4-5c72-ab19-c7578f38fabe" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186237455}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf6fcd75-6ae3-55a9-acc1-22b5660350be" :question/math-academy-id "q-103546" :question/problem "The equation of the normal line to the curve $y=\\frac{4}{\\sqrt{x}}$ at the point $(1,4)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $q-p.$" :question/worked-solution "Let $f(x)=\\frac{4}{\\sqrt{x}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{-1/2}) \\\\  & =-2{x}^{-3/2} \\\\  & =-\\frac{2}{\\sqrt{{x}^{3}}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,4):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=-\\frac{2}{\\sqrt{{1}^{3}}}=-2\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-4 & =\\frac{1}{2}(x-1) \\\\ 2y-8 & =x-1 \\\\ x-2y & =-7.\\end{aligned}\n$$\n\nTherefore, $q-p=-7-(-2)=-5.$"} {:db/id 17592186315036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8aacf8a-923a-5706-a78c-108e65099a32" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186313826}] :answer-field/correct {:answer/id #uuid "e8aacf8a-923a-5706-a78c-108e65099a32" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186313826} :answer-field/id #uuid "55ac9af9-f5be-5aac-9b98-a73bb56de950" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314252} {:answer-field/choices [{:answer/id #uuid "2f398213-9b43-5009-a712-5e39a192aab2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186312352}] :answer-field/correct {:answer/id #uuid "2f398213-9b43-5009-a712-5e39a192aab2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186312352} :answer-field/id #uuid "c1e679c8-0512-5ea7-a995-5f08819c8352" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186314554}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6db0058b-56f3-5a30-bae9-0cf86c420390" :question/math-academy-id "q-340945" :question/problem "Find the equation of the normal line to the curve $y=\\frac{8}{{x}^{2}}$ at the point $(2,2).$\n\n$x\\,-$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=\\frac{8}{{x}^{2}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{8}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(8{x}^{-2}) \\\\  & =-16{x}^{-3} \\\\  & =-\\frac{16}{{x}^{3}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,2):$\n\n$$\nm={f}^{′}(2)=-\\frac{16}{(2)^{3}}=-\\frac{16}{8}=-2\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{-2}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(2) & =\\frac{1}{2}(x-2) \\\\ 2y-4 & =x-2 \\\\ x-2\\cdot y & =-2.\\end{aligned}\n$$"} {:db/id 17592186317211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8672281f-8981-5889-ae04-fc0ebe51ce35" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id 17592186315875}] :answer-field/correct {:answer/id #uuid "8672281f-8981-5889-ae04-fc0ebe51ce35" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-28" :db/id 17592186315875} :answer-field/id #uuid "076abe3c-2890-583c-ace8-ff9d99106670" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186316564} {:answer-field/choices [{:answer/id #uuid "a195177d-1813-5a16-ae86-c4c7cd7b18a7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186316028}] :answer-field/correct {:answer/id #uuid "a195177d-1813-5a16-ae86-c4c7cd7b18a7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186316028} :answer-field/id #uuid "9edf45fe-a749-5a58-b21a-dc03a59337f5" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186316914}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7217f3b7-79ba-5f9c-b811-2d79787fbad8" :question/math-academy-id "q-342162" :question/problem "Find the equation of the normal line to the curve $y=6{x}^{2}-7x+4$ at the point $(0,4).$\n\n$x\\,-$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=6{x}^{2}-7x+4.$ First, we compute the derivative:\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(6{x}^{2}-7x+4)=12x-7\n$$\n\nThen, we compute the slope of the tangent at the point $(0,4):$\n\n$$\nm={f}^{′}(0)=12(0)-7=-7\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{7}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-4 & =\\frac{1}{7}(x-0) \\\\ 7(y-4) & =x \\\\ 7y-28 & =x \\\\ x-7\\cdot y & =-28.\\end{aligned}\n$$"} {:db/id 17592186317212 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14739741-a199-5044-95db-68e615cfe350" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id 17592186315242}] :answer-field/correct {:answer/id #uuid "14739741-a199-5044-95db-68e615cfe350" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id 17592186315242} :answer-field/id #uuid "51c1804f-c3c3-527f-ad52-389c7f415fc7" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186316736} {:answer-field/choices [{:answer/id #uuid "ef369bbf-3dd9-544a-b45c-a35adc1c8bdb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186316448}] :answer-field/correct {:answer/id #uuid "ef369bbf-3dd9-544a-b45c-a35adc1c8bdb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186316448} :answer-field/id #uuid "a5cbe1d4-2ba5-517a-85ba-01b462393fb1" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186316932}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "225f0ba1-57bb-5f34-91e4-9ca304d64d6b" :question/math-academy-id "q-342168" :question/problem "Find the equation of the normal line to the curve $y=\\frac{1}{8}{x}^{6}-\\frac{7}{4}{x}^{3}$ at the point $(2,-6).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=\\frac{1}{8}{x}^{6}-\\frac{7}{4}{x}^{3}.$ First, we compute the derivative:\n\n$$\n{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{8}{x}^{6}-\\frac{7}{4}{x}^{3})=\\frac{3}{4}{x}^{5}-\\frac{21}{4}{x}^{2}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-6):$\n\n$$\nm={f}^{′}(2)=\\frac{3}{4}({2}^{5})-\\frac{21}{4}({2}^{2})=3\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{3}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(-6) & =-\\frac{1}{3}\\cdot (x-2) \\\\ -3(y+6) & =x-2 \\\\ -3y-18 & =x-2 \\\\ x+3\\cdot y & =-16.\\end{aligned}\n$$"} {:db/id 17592186317214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eaf6866-59c7-5bcf-85b0-5e039d9cf80c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id 17592186315568}] :answer-field/correct {:answer/id #uuid "4eaf6866-59c7-5bcf-85b0-5e039d9cf80c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id 17592186315568} :answer-field/id #uuid "7ee849c8-86a4-5fad-acfb-56e96048a591" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186316847} {:answer-field/choices [{:answer/id #uuid "901ca621-ed5f-5750-a913-063b18972900" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id 17592186315924}] :answer-field/correct {:answer/id #uuid "901ca621-ed5f-5750-a913-063b18972900" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id 17592186315924} :answer-field/id #uuid "b8a60e86-2a15-5a46-a72a-b8277699810a" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186316981}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "773759d8-9f76-5cef-8ffc-9fa90fd16743" :question/math-academy-id "q-342190" :question/problem "Find the equation of the normal line to the curve $y=\\frac{3}{2}\\sqrt[3]{x}$ at the point $(\\frac{1}{8},\\frac{3}{4}).$\n\n$8x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" :question/worked-solution "Let $f(x)=\\frac{3}{2}\\sqrt[3]{x}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\sqrt[3]{x}) \\\\  & =\\frac{3}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/3}) \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{3}{x}^{-2/3} \\\\  & =\\frac{1}{2\\sqrt[3]{{x}^{2}}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(\\frac{1}{8},\\frac{3}{4}):$\n\n$$\nm={f}^{′}(\\frac{1}{8})=\\frac{1}{2\\sqrt[3]{{(\\frac{1}{8})}^{2}}}=2\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-\\frac{3}{4} & =-\\frac{1}{2}(x-\\frac{1}{8}) \\\\ 16(y-\\frac{3}{4}) & =16\\cdot (-\\frac{1}{2})\\cdot (x-\\frac{1}{8}) \\\\ 16y-12 & =-8(x-\\frac{1}{8}) \\\\ 16y-12 & =-8x+1 \\\\ 8x+16\\cdot y & =13.\\end{aligned}\n$$"} {:db/id 17592186329814 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20e1490f-8a2f-5aa1-b46d-abffe2ecf67d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-35" :db/id 17592186327216} {:answer/id #uuid "2a251a8f-d542-5932-929c-cdccb0e5eaa1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id 17592186327299} {:answer/id #uuid "7c2eccf0-2aa7-5272-b036-0190d7bed899" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id 17592186328001} {:answer/id #uuid "906c08ad-b6aa-508c-9085-351bcf96badc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186328194} {:answer/id #uuid "e5f5f70f-61df-5d3d-b04a-f2eee1395813" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id 17592186328946}] :answer-field/correct {:answer/id #uuid "2a251a8f-d542-5932-929c-cdccb0e5eaa1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id 17592186327299} :answer-field/id #uuid "24cc6f6b-5575-52a5-a07a-afc26dd7d423" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186329250}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abc350e7-3687-5b2a-9ff1-fa33c7a23d64" :question/math-academy-id "q-47409" :question/problem "The equation of the normal line to the curve $y=\\frac{4}{{x}^{2}}-x$ at the point $(1,3)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p-q.$" :question/worked-solution "Let $f(x)=\\frac{4}{{x}^{2}}-x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{{x}^{2}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{-2}-x) \\\\  & =-8{x}^{-3}-1\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,3):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=-8(1)^{-3}-1=-9\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{9}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(3) & =\\frac{1}{9}(x-1) \\\\ 9y-27 & =x-1 \\\\ x-9y & =-26.\\end{aligned}\n$$\n\nTherefore, $p-q=-9-(-26)=17.$"} {:db/id 17592186392582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10131252-4695-56ed-8c59-747e545f594c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "71" :db/id 17592186392584} {:answer/id #uuid "e6984861-e3cb-5365-9e9e-1ecd4311dcb8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id 17592186392585} {:answer/id #uuid "859687f9-c59b-551f-aaa5-e7e3c04ba6c0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-81" :db/id 17592186392586} {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id 17592186392587} {:answer/id #uuid "41016988-d005-506a-b687-2940e1c88cd8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-71" :db/id 17592186392588}] :answer-field/correct {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id 17592186392587} :answer-field/id #uuid "c9549a2f-75a6-5fa7-b3e3-19c27b3b484f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186392583}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "414ee72f-747c-573a-9cad-a9cbdad6101a" :question/math-academy-id "q-47410" :question/problem "The equation of the normal line to the curve $y=3{x}^{2}+4x$ at the point $(1,7)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p+q.$" :question/worked-solution "Let $f(x)=3{x}^{2}+4x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+4x)=6x+4\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,7):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=6(1)+4=10\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{10}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(7) & =-\\frac{1}{10}(x-1) \\\\ 10y-70 & =-x+1 \\\\ x+10y & =71.\\end{aligned}\n$$\n\nTherefore, $p+q=10+71=81.$"}] :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}