 17592186253894} {:answer/id #uuid "2f133303-0ca9-5c34-9b67-603238077a30" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254086} {:answer/id #uuid "60d04bd9-3b2b-5773-af0c-28cc3399b1c2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186254536} {:answer/id #uuid "6662b8b2-0b86-5153-b706-d142f59cd08d" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{3}" :db/id #edb/ref 17592186254592} {:answer/id #uuid "7e3cc7a1-a0b3-5270-a27e-c99b62538255" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186254789}] :answer-field/correct {:answer/id #uuid "60d04bd9-3b2b-5773-af0c-28cc3399b1c2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186254536} :answer-field/id #uuid "0c66c1de-5cc3-594e-9c4d-492721e5ecfe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255935}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10f80d39-efd4-5625-821a-21dfccdb41c2" :question/math-academy-id "q-122770" :question/problem "![](images/69/69072873cb1f613ee9c2fa4a4caf3dc3409026c2a8310847b1c3dd890cc816d8.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $3$ and $6:$ \n\n![](images/d0/d0d9f0fad038f04b6d93920979161694f4e709a31b68083f20e768bf60aa1675.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{3}^{2}+{6}^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=3\\sqrt{5}.\n$$"} {:db/id #edb/ref 17592186543730 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/title "Calculating Line Integrals of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e392493-12b7-5fff-a789-f4a3cf5d01f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186543751} {:answer/id #uuid "9aa03926-e900-5999-9093-1d000b69385d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3361}}{12}" :db/id #edb/ref 17592186543772} {:answer/id #uuid "ce794cd4-db55-56f9-b983-5fa880a1168a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{71}{12}" :db/id #edb/ref 17592186543786} {:answer/id #uuid "d0828197-5b40-5c68-b0ea-1f4bd3d201a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3361}{144}" :db/id #edb/ref 17592186543788} {:answer/id #uuid "f4e59bea-6a7a-5534-bc03-1d74041599c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186543802}] :answer-field/correct {:answer/id #uuid "9aa03926-e900-5999-9093-1d000b69385d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3361}}{12}" :db/id #edb/ref 17592186543772} :answer-field/id #uuid "cee9cae6-cf06-57f3-b029-c631c50e218a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "10e20319-dae6-5423-9e86-a7cc0396d858" :question/problem "![](images/1f/1fef351611744d83aac26742bada76ee0eb7f4beef06698d8b4b02061aa8045b.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $\\frac{14}{3}$ and $\\frac{5}{4}:$ \n\n![](images/d6/d64fa6b26b1730514b90b28989773cd8996b8deda2dd80bece2e48def3859320.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{\\frac{14}{3}}^{2}+{\\frac{5}{4}}^{2}} \\\\  & =\\sqrt{\\frac{196}{9}+\\frac{25}{16}} \\\\  & =\\sqrt{\\frac{3361}{144}} \\\\  & =\\frac{\\sqrt{3361}}{12}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=\\frac{\\sqrt{3361}}{12}.\n$$"} {:db/id #edb/ref 17592186543741 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/title "Calculating Line Integrals of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44cb5b46-005a-5f87-87e4-036f25b9cd2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{2}" :db/id #edb/ref 17592186543746} {:answer/id #uuid "88fb679f-fc25-5e1a-8a27-a1730abf8244" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{45}{2}" :db/id #edb/ref 17592186543766} {:answer/id #uuid "8a51efa8-e7f2-509d-90dc-60a88a56f276" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186543767} {:answer/id #uuid "991b214a-0e87-5f60-bf23-f046455dd48d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186543770} {:answer/id #uuid "b21afb2d-be8a-572b-b7a0-4255289dca17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186543778}] :answer-field/correct {:answer/id #uuid "44cb5b46-005a-5f87-87e4-036f25b9cd2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{10}}{2}" :db/id #edb/ref 17592186543746} :answer-field/id #uuid "e32da741-eca2-5c8f-ae7d-524df68a247b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "364181e6-6962-5fb8-9d2f-01c181d8615e" :question/problem "![](images/fd/fdccb48ecbf30257f5dce2b1d8f9be79cfbc945ed804f0ceef75e519c0292f23.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $\\frac{3}{2}$ and $\\frac{9}{2}:$ \n\n![](images/3a/3ab15ec00cb05ea65a36d59f88246cb56347ea6dc61ff2e589882a4ab92f1919.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{\\frac{3}{2}}^{2}+{\\frac{9}{2}}^{2}} \\\\  & =\\sqrt{\\frac{9}{4}+\\frac{81}{4}} \\\\  & =\\sqrt{\\frac{45}{2}} \\\\  & =\\frac{3\\sqrt{10}}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=\\frac{3\\sqrt{10}}{2}.\n$$"} {:db/id #edb/ref 17592186543748 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/title "Calculating Line Integrals of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08d7bcfc-4852-5169-8210-4388508ffdd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186543729} {:answer/id #uuid "81deb0bc-0a70-56f9-9b3b-1cf10ef37f1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{91}{12}" :db/id #edb/ref 17592186543763} {:answer/id #uuid "952b20c2-980e-51b8-83f0-51f7734026ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{4201}}{12}" :db/id #edb/ref 17592186543768} {:answer/id #uuid "d2ee4a8e-4a67-5ae2-97fe-293394c49867" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4201}{144}" :db/id #edb/ref 17592186543789} {:answer/id #uuid "e58c2192-77b6-5422-a995-4b958050f4c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{4}" :db/id #edb/ref 17592186543800}] :answer-field/correct {:answer/id #u