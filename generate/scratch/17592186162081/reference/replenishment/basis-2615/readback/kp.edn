er-field/correct {:answer/id #uuid "42d6a148-88c2-5e27-b2b8-7077e4ee92a7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186254242} :answer-field/id #uuid "c8f24811-145c-5e38-85a4-66faa4942fa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "418cd3d5-ecfd-5690-a4c6-98dd1a3d29e8" :question/math-academy-id "q-122768" :question/problem "![](images/b7/b7e72ce1ab38408f04f3b8d5a228ec0a3632c60086ef0a7abeb7e18af3002e6b.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the hypotenuse of a right triangle whose legs have lengths $3$ and $4.$ Therefore, we have\n\n$$\n\\begin{aligned}L & =\\sqrt{{3}^{2}+{4}^{2}} \\\\  & =\\sqrt{9+16} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=5.\n$$"} {:db/id #edb/ref 17592186256713 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/title "Calculating Line Integrals of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ff0acc0-0e93-5334-be16-87734e65f347" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186253947} {:answer/id #uuid "267a1756-880b-503d-9cde-ec448304a42a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186254013} {:answer/id #uuid "3916ee0d-ef52-5786-a7a9-672356d765a8" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186254166} {:answer/id #uuid "5356d693-3c5b-5b4b-a259-9f59cf7f89fd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186254397} {:answer/id #uuid "f5b78f71-4853-5da1-a1f0-3fedc3d3c1bf" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186255820}] :answer-field/correct {:answer/id #uuid "5356d693-3c5b-5b4b-a259-9f59cf7f89fd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186254397} :answer-field/id #uuid "38593efc-6c98-5f7c-a0ed-dbed4bca04a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256021}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a8b286f-d065-50b6-ae53-27022484f1f9" :question/math-academy-id "q-122766" :question/problem "![](images/1a/1a46390ced6cc52c535f9f48e5e157cea83960caa339e98b23e3b64c93e0ea38.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is a line segment directed along the $y$-axis. Therefore, we have\n\n$$\n{\\int }_{C}\\,\\text{d}s=3-(-1)=4.\n$$"} {:db/id #edb/ref 17592186256714 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/title "Calculating Line Integrals of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57b9b426-71c1-5edb-9dd9-ca085fb61738" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254441} {:answer/id #uuid "77ea77f7-6a1b-56e7-8f3b-74939f184252" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186254729} {:answer/id #uuid "8943a84b-b99d-54fe-9fb1-3ac026d3d430" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186254887} {:answer/id #uuid "b2a7cf28-d7d6-5020-81cc-adfd50ba234f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255243} {:answer/id #uuid "cf01093d-6c43-52d5-8c1a-7fdd0ec9b92e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186255510}] :answer-field/correct {:answer/id #uuid "b2a7cf28-d7d6-5020-81cc-adfd50ba234f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255243} :answer-field/id #uuid "589066a3-615a-51c9-bb5d-9e742c10db6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256092}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3baa811b-dfdb-522b-86b9-2539a33b41e1" :question/math-academy-id "q-122767" :question/problem "![](images/d8/d82f445e19af6e6d343bfab6c082108e945a8feb21caa9b60a2d93da24fc3f6a.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn this case, the path $C$ is the line segment directed along the $x$-axis. Therefore, we have\n\n$$\n{\\int }_{C}\\,\\text{d}s=5-1=4.\n$$"} {:db/id #edb/ref 17592186256715 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ac9e7d-ea92-5cd3-af26-4c902196e80b" :knowledge-point/title "Calculating Line Integrals of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ce7ca60-5bcd-5786-a176-79dc33c37a12" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186254197} {:answer/id #uuid "614d3299-5ff7-52bc-9ff5-8dea36b35628" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186254542} {:answer/id #uuid "8fd81a7e-ee4a-5467-8b4d-882cd76a5836" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186254932} {:answ