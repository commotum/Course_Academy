    "question": {
      ":question/id": "b0f1730e-091f-5c51-a8d8-22da3962b13d",
      ":question/problem": "![](/home/jake/Developer/Course_Academy/generate/scratch/17592186162081/assets/d53d75d277c0e0cd8dccc311735782bd95cb721e9442229b132543b44e499ac6.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the line segment shown above.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "d4812293-b48d-5da8-b5dd-7a8ccc7895dc",
