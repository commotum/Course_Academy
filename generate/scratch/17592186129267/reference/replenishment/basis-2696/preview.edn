39536009 17592186045443 true] [17592186556290 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556290 1083 #uuid "12dbab12-164b-5680-94f9-924300098671" 13194139536009 17592186045443 true] [17592186556291 1080 "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{2 \\sqrt{6}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 8}r^{2} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " 13194139536009 17592186045443 true] [17592186556291 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556291 1083 #uuid "1a89ee8e-7e15-5633-8d7b-1924dc4d1c2f" 13194139536009 17592186045443 true] [17592186556292 1068 #edb/ref 17592186556295 13194139536009 17592186045443 true] [17592186556292 1070 #edb/ref 17592186045485 13194139536009 17592186045443 true] [17592186556292 1071 "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=17$ between the surfaces $z=0$ and $z=12.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}{z}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" 13194139536009 17592186045443 true] [17592186556292 1072 #uuid "1c4f39f6-c3b9-5ce0-9e72-9d922968c0ed" 13194139536009 17592186045443 true] [17592186556292 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/99/994f3537bf54a849e6a725c4c692a2326266d8065a742b1988308c793708827f.png)\n\nThe region $R$ is a right vertical cylinder of radius $\\sqrt{17}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=12.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le \\sqrt{17},\\,0\\le \\theta <2\\pi ,\\,0\\le z\\le 12\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}{z}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}{z}^{2}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}r{z}^{2}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{12}{r}^{2}{z}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139536009 17592186045443 true] [17592186556293 1080 "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{\\sqrt{17}}{\\int }_{0}^{r}r^{2} z^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " 13194139536009 17592186045443 true] [17592186556293 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556293 1083 #uuid "24ee5f71-37f2-50d6-ae8a-9bfa2a3e68bb" 13194139536009 17592186045443 true] [17592186556294 1080 "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{5}{\\int }_{r^{2}}^{4}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " 13194139536009 17592186045443 true] [17592186556294 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556294 1083 #uuid "2735da5a-71b8-5e58-beb0-ff742aae5ef0" 13194139536009 17592186045443 true] [17592186556295 1075 #edb/ref 17592186556293 13194139536009 17592186045443 true] [17592186556295 1075 #edb/ref 17592186556304 13194139536009 17592186045443 true] [17592186556295 1075 #edb/ref 17592186556320 13194139536009 17592186045443 true] [17592186556295 1075 #edb/ref 17592186556321 13194139536009 17592186045443 true] [17592186556295 1075 #edb/ref 17592186556329 13194139536009 17592186045443 true] [17592186556295 1076 #edb/ref 17592186045493 13194139536009 17592186045443 true] [17592186556295 1077 "selection" 13194139536009 17592186045443 true] [17592186556295 1078 #edb/ref 17592186556321 13194139536009 17592186045443 true] [17592186556295 1079 #uuid "2a37a2e4-2236-5089-9702-0aa3e56fadda" 13194139536009 17592186045443 true] [17592186556296 1068 #edb/ref 17592186556316 13194139536009 17592186045443 true] [17592186556296 1070 #edb/ref 17592186045486 13194139536009 17592186045443 true] [17592186556296 1071 "The region $R$ is enclosed inside the cylinder $x^2+y^2=5$ for $x\\le 0$ and $y\\ge 0$, between the surfaces $z=x$ and $z=y^{2} + 4$. Express the following triple integral in cylindrical polar coordinates.\n\n$$\n\\iiint_R z \\left(x^{2} - y^{2}\\right)\\,\\mathrm{d}V\n$$" 13194139536009 17592186045443 true] [17592186556296 1072 #uuid "37475e2f-873b-54fd-b9a9-28a66b2df1fd" 13194139536009 17592186045443 true] [17592186556296 1074 "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/3e/3e51a479b8fe2a00f7b51a8613fe2cb6a45d790d737637c31b7858766e0491ff.png)\n\nThe region $R$ is one-quarter of a right vertical cylinder of radius $\\sqrt{5}$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=x=r \\cos{\\left(\\theta \\right)},$ and\n\n- bounded above by $z=y^{2} + 4=r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta,z):0\\le r\\le \\sqrt{5},\\frac{\\pi}{2}\\le\\theta\\le \\pi,r \\cos{\\left(\\theta \\right)}\\le z\\le r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iiint_R z \\left(x^{2} - y^{2}\\right)\\,\\mathrm{d}V&=\\iiint_\\Delta z((r\\cos\\theta)^2-(r\\sin\\theta)^2)\\cdot r\\,dz\\,dr\\,d\\theta \\\\ &=\\iiint_\\Delta rz(r^2\\cos^2\\theta-r^2\\sin^2\\theta)\\,dz\\,dr\\,d\\theta \\\\ &=\\iiint_\\Delta r^3z(\\cos^2\\theta-\\sin^2\\theta)\\,dz\\,dr\\,d\\theta \\\\ &=\\iiint_\\Delta r^3z\\cos(2\\theta)\\,dz\\,dr\\,d\\theta \\\\ &={\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 4}r^{3} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta \\end{aligned}\n$$" 13194139536009 17592186045443 true] [17592186556297 1080 "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{17}{\\int }_{r \\cos{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)} + 12}r^{2} z \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " 13194139536009 17592186045443 true] [17592186556297 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556297 1083 #uuid "3ef1460b-69ae-51db-9b0f-38d59059ba70" 13194139536009 17592186045443 true] [17592186556298 1080 "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{\\sqrt{17}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{r^{2} \\sin^{2}{\\left(\\theta \\right)}}r^{2} \\cos{\\left(2 \\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " 13194139536009 17592186045443 true] [17592186556298 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556298 1083 #uuid "3f055e72-6e2d-5f80-9979-e2072e2c4ca5" 13194139536009 17592186045443 true] [17592186556299 1080 "{\\int }_{0}^{2 \\pi}{\\int }_{0}^{\\sqrt{5}}{\\int }_{r}^{4}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " 13194139536009 17592186045443 true] [17592186556299 1082 #edb/ref 17592186045498 13194139536009 17592186045443 true] [17592186556299 1083 #uuid "40378672-56df-5c9f-9860-e8215b6cd36d" 13194139536009 17592186045443 true]