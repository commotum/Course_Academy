ent :answer-field.type/radio} :db/id #edb/ref 17592186249936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09d61645-0832-5f0f-8786-3d306da259b5" :question/math-academy-id "q-113937" :question/problem "$\\int -4{sec}^{2}⁡z\\,\\text{d}z=$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}⁡z\\,\\text{d}z=tan⁡z+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -4{sec}^{2}⁡z\\,\\text{d}z & =-4\\int {sec}^{2}⁡z\\,\\text{d}z \\\\  & =-4(tan⁡z)+C \\\\  & =-4tan⁡z+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250144 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b761ed8-d827-5127-a59b-96c64838e7b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186247523} {:answer/id #uuid "1978ef25-89ac-5dfc-bfce-7c05e88417b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x-2{csc}^{2}⁡x+C" :db/id #edb/ref 17592186247654} {:answer/id #uuid "27db896f-aa81-596b-9d5e-21b31fe33fe3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186247780} {:answer/id #uuid "5b3c954f-316d-5079-aa75-c94190f34262" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+2\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186248250} {:answer/id #uuid "96adef65-3203-5d35-b9d8-b7f4303504d1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x+2{csc}^{2}⁡x+C" :db/id #edb/ref 17592186248764}] :answer-field/correct {:answer/id #uuid "0b761ed8-d827-5127-a59b-96c64838e7b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186247523} :answer-field/id #uuid "0b5ee590-9043-577e-ac3f-f3a6d716a608" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249689}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08d0f1cc-d4ff-5f13-b460-2feb29c2a12c" :question/math-academy-id "q-113944" :question/problem "$\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =\\int {sec}^{2}⁡x\\,\\text{d}x-2\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x-2(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290340 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd0c250-5bf4-502b-ac7f-de044cfaaa10" :answer/type {:db/ident :answer.type/math} :answer/value "4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186288340} {:answer/id #uuid "3f822d39-9367-56e2-94ac-4e46c353ca47" :answer/type {:db/ident :answer.type/math} :answer/value "-4csc⁡x-tan⁡x+C" :db/id #edb/ref 17592186288464} {:answer/id #uuid "74d923d2-3efc-5ca9-941b-f2721f9ebb87" :answer/type {:db/ident :answer.type/math} :answer/value "4csc⁡x+sec⁡x+C" :db/id #edb/ref 17592186288844} {:answer/id #uuid "abf937ba-cc12-532c-bb17-a12d2975c76f" :answer/type {:db/ident :answer.type/math} :answer/value "-4cot⁡x+tan⁡x+C" :db/id #edb/ref 17592186289171} {:answer/id #uuid "ba90d1