er.type/math} :answer/value "7cot⁡x+4sec⁡x+C" :db/id #edb/ref 17592186331724} {:answer/id #uuid "eeff4377-3048-5370-9c27-9dad4e9d4466" :answer/type {:db/ident :answer.type/math} :answer/value "7cot⁡x-4sec⁡x+C" :db/id #edb/ref 17592186332047}] :answer-field/correct {:answer/id #uuid "6d5434a6-e354-57cc-8be3-921a471e1964" :answer/type {:db/ident :answer.type/math} :answer/value "7tan⁡x+4sec⁡x+C" :db/id #edb/ref 17592186330929} :answer-field/id #uuid "f5cb83ec-ba9e-5744-a1c6-b0f47594acda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3a5d5fb-8f22-572d-9122-04a2c3a1b6ad" :question/math-academy-id "q-49122" :question/problem "Calculate $\\int sec⁡x(7sec⁡x+4tan⁡x)\\text{d}x.$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sec⁡xtan⁡x\\,\\text{d}x & =sec⁡x+C, \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =tan⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int sec⁡x(7sec⁡x+4tan⁡x)\\text{d}x & =\\int (7{sec}^{2}⁡x+4sec⁡xtan⁡x)\\text{d}x \\\\  & =\\int 7{sec}^{2}⁡x\\,\\text{d}x+\\int 4sec⁡xtan⁡x\\,\\text{d}x \\\\  & =7\\int {sec}^{2}⁡x\\,\\text{d}x+4\\int sec⁡xtan⁡x\\,\\text{d}x \\\\  & =7tan⁡x+4sec⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Secant Squared"}]}
