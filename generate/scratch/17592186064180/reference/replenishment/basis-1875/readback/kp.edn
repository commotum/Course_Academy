correct {:answer/id #uuid "0b761ed8-d827-5127-a59b-96c64838e7b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186247523} :answer-field/id #uuid "0b5ee590-9043-577e-ac3f-f3a6d716a608" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249689}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08d0f1cc-d4ff-5f13-b460-2feb29c2a12c" :question/math-academy-id "q-113944" :question/problem "$\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x+C \\\\ \\int {sec}^{2}⁡x\\,\\text{d}x & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({sec}^{2}⁡x-2\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\,\\text{d}x & =\\int {sec}^{2}⁡x\\,\\text{d}x-2\\int \\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x-2(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{tan}⁡x+2\\operatorname{csc}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290340 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd0c250-5bf4-502b-ac7f-de044cfaaa10" :answer/type {:db/ident :answer.type/math} :answer/value "4csc⁡x+tan⁡x+C" :db/id #edb/ref 17592186288340} {:answer/id #uuid "3f822d39-9367-56e2-94ac-4e46c353ca47" :answer/type {:db/ident :answer.type/math} :answer/value "-4csc⁡x-tan⁡x+C" :db/id #edb/ref 17592186288464} {:answer/id #uuid "74d923d2-3efc-5ca9-941b-f2721f9ebb87" :answer/type {:db/ident :answer.type/math} :answer/value "4csc⁡x+sec⁡x+C" :db/id #edb/ref 1759