0}^{\\pi /2}(y\\,\\frac{dx}{\\text{d}t}-x\\,\\frac{dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(\\sqrt{2}\\operatorname{sin}⁡t\\cdot (-\\sqrt{2}\\operatorname{sin}⁡t)-\\sqrt{2}\\operatorname{cos}⁡t\\cdot \\sqrt{2}\\operatorname{cos}⁡t)\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(-2{sin}^{2}⁡t-2{cos}^{2}⁡t)\\text{d}t \\\\  & =-2{\\int }_{0}^{\\pi /2}\\text{d}t \\\\  & =-2t{|}_{0}^{\\pi /2} \\\\  & =-2[\\frac{\\pi }{2}-0] \\\\  & =-\\pi \\end{aligned}\n$$"} {:db/id #edb/ref 17592186557800 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18aef37b-13fc-5985-b171-ee79226ba9c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{273 \\pi}{2}" :db/id #edb/ref 17592186557803} {:answer/id #uuid "68ea381c-9350-5902-8a2d-5365327562c7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{63 \\pi}{2}" :db/id #edb/ref 17592186557818} {:answer/id #uuid "6dfac82d-50a4-585f-89af-6ef3edfdc45e" :answer/type {:db/ident :answer.type/math} :answer/value "- 84 \\pi" :db/id #edb/ref 17592186557819} {:answer/id #uuid "8db76247-e4b0-5546-a657-8f8e6e8388d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{105 \\pi}{2}" :db/id #edb/ref 17592186557826} {:answer/id #uuid "a135d7b3-50aa-5afe-84ad-61682c19e240" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186557831}] :answer-field/correct {:answer/id #uuid "68ea381c-9350-5902-8a2d-5365327562c7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{63 \\pi}{2}" :db/id #edb/ref 17592186557818} :answer-field/id #uuid "59997270-8b69-57f0-869d-fe6b2aa3f380" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557811}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03ef4d10-8b30-5c10-920c-534b995f0855" :question/problem "Evaluate $\\int_C\\left(4 x^{2} y - 2 y\\right)\\,\\mathrm{d}x+\\left(3 x y^{2} + 2 x\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $9 x^{2} + 16 y^{2}=144$ traversed in the counterclockwise direction from the point $(4,0)$ to the point $(-4,0)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $3,$ respectively, it can be parametrized as follows:\n\n$$r(t)=4 \\cos{\\left(t \\right)}\\,i+3 \\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\pi].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 4 \\sin{\\left(t \\right)}\\,i+3 \\cos{\\left(t \\right)}\\,j.$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\\int_C\\left(4 x^{2} y - 2 y\\right)\\,\\mathrm{d}x+\\left(3 x y^{2} + 2 x\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\pi}\\left(4 x^{2} y - 2 y\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(3 x y^{2} + 2 x\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\pi}\\left(\\left(4 x^{2} y - 2 y\\right)x\\prime(t)+\\left(3 x y^{2} + 2 x\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\pi}\\left(\\left(192 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} - 6 \\sin{\\left(t \\right)}\\right)\\left(- 4 \\sin{\\left(t \\right)}\\right)+\\left(108 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)} + 8 \\cos{\\left(t \\right)}\\right)\\left(3 \\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\pi}\\left(\\left(- 768 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)+\\left(24 \\sin^{2}{\\left(t \\right)}\\right)+\\left(24 \\cos^{2}{\\left(t \\right)}\\right)+\\left(324 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\pi}\\left(- 444 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} + 24\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\pi}\\left(\\frac{111 \\cos{\\left(4 t \\right)}}{2} - \\frac{63}{2}\\right)\\,\\mathrm{d}t\\\\ & =\\left[- \\frac{63 t}{2} + \\frac{111 \\sin{\\left(4 t \\right)}}{8}\\right]_{0}^{\\pi}\\\\ & =\\left(- \\frac{63 \\left(\\pi\\right)}{2} + \\frac{111 \\sin{\\left(4 \\left(\\pi\\right) \\right)}}{8}\\right)-\\left(- \\frac{63 \\left(0\\right)}{2} + \\frac{111 \\sin{\\left(4 \\left(0\\right) \\right)}}{8}\\right)\\\\ & =\\left(\\left(- \\frac{63 \\pi}{2}\\right)+\\left(0\\right)\\right)-\\left(\\left(0\\right)+\\left(0\\right)\\right)\\\\ & =- \\frac{63 \\pi}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557802 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51f4ba88-6906-5807-8e56-38b9cac7040e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{93 \\pi}{16}" :db/id #edb/ref 17592186557808} {:answer/id #uuid "52882614-2c8f-5d4c-bf34-552065d5c6d2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\pi}{16}" :db/id #edb/ref 17592186557810} {:answer/id #uuid "6431ed13-3ebd-5c26-b688-c8a633f096b2" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\pi" :db/id #edb/ref 17592186557817} {:answer/id #uuid "f3e27914-31ba-5ff7-a5fa-85eb69175863" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{99 \\pi}{16}" :db/id #edb/ref 17592186557847} {:answer/id #uuid "f4b63cf9-e33e-5263-b5aa-e288270277d8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{99}{4}" :db/id #edb/ref 17592186557848}] :answer-field/correct {:answer/id #uuid "51f4ba88-6906-5807-8e56-38b9cac7040e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{93 \\pi}{16}" :db/id #edb/ref 17592186557808} :answer-field/id #uuid "45310c5c-a7e1-5c63-9f05-e64c2f30ae51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557807}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0faff4ca-cb6c-5f59-80aa-48ecec1fa2a8" :question/problem "Evaluate $\\int_C\\left(- 4 x^{2} y + y\\right)\\,\\mathrm{d}x+\\left(3 x y^{2} - x\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $x^{2} + 9 y^{2}=9$ traversed in the counterclockwise direction from the point $(3,0)$ to the point $(0,1)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $3$ and $1,$ respectively, it can be parametrized as follows:\n\n$$r(t)=3 \\cos{\\left(t \\right)}\\,i+\\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\frac{\\pi}{2}].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 3 \\sin{\\left(t \\right)}\\,i+\\cos{\\left(t \\right)}\\,j.$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\\int_C\\left(- 4 x^{2} y + y\\right)\\,\\mathrm{d}x+\\left(3 x y^{2} - x\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 4 x^{2} y + y\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(3 x y^{2} - x\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 4 x^{2} y + y\\right)x\\prime(t)+\\left(3 x y^{2} - x\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 36 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} + \\sin{\\left(t \\right)}\\right)\\left(- 3 \\sin{\\left(t \\right)}\\right)+\\left(9 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos{\\left(t \\right)}\\right)\\left(\\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(108 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\sin^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\cos^{2}{\\left(t \\right)}\\right)+\\left(9 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(117 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} - 3\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\frac{93}{8} - \\frac{117 \\cos{\\left(4 t \\right)}}{8}\\right)\\,\\mathrm{d}t\\\\ & =\\left[\\frac{93 t}{8} - \\frac{117 \\sin{\\left(4 t \\right)}}{32}\\right]_{0}^{\\frac{\\pi}{2}}\\\\ & =\\left(\\frac{93 \\left(\\frac{\\pi}{2}\\right)}{8} - \\frac{117 \\sin{\\left(4 \\left(\\frac{\\pi}{2}\\right) \\right)}}{32}\\right)-\\left(\\frac{93 \\left(0\\right)}{8} - \\frac{117 \\sin{\\left(4 \\left(0\\right) \\right)}}{32}\\right)\\\\ & =\\left(\\left(0\\right)+\\left(\\frac{93 \\pi}{16}\\right)\\right)-\\left(\\left(0\\right)+\\left(0\\right)\\right)\\\\ & =\\frac{93 \\pi}{16}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557820 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e7f72d-414d-53aa-8ef8-cead044d1e34" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\left(- 84 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186557804} {:answer/id #uuid "cfa7e14b-101e-5f42-b58e-9a1bd14174ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\left(78 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186557840} {:answer/id #uuid "e662a31f-cab2-56f1-9681-41eae72c7042" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\left(81 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186557844} {:answer/id #uuid "e925186a-0214-5007-b114-7ce6da66f8b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\left(- 3 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186557845} {:answer/id #uuid "eb76069a-19c5-5b49-baed-4f9249748312" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\left(- 3 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)} - 81 \\cos^{3}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186557846}] :answer-field/correct {:answer/id #uuid "cfa7e14b-101e-5f42-b58e-9a1bd14174ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\left(78 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t" :db/id #edb/ref 17592186557840} :answer-field/id #uuid "5f0404c5-2336-5ed6-a42f-c0ecfbbeabd6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557816}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73913116-384d-502d-a4e5-8830e55db474" :question/problem "Which of the following is equivalent to $\\int_C\\left(- 3 x^{2}\\right)\\,\\mathrm{d}x+\\left(- x y\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $x^{2} + 9 y^{2}=9$ traversed in the counterclockwise direction from the point $(3,0)$ to the point $(0,1)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $3$ and $1,$ respectively, it can be parametrized as follows:\n\n$$r(t)=3 \\cos{\\left(t \\right)}\\,i+\\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\frac{\\pi}{2}].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 3 \\sin{\\left(t \\right)}\\,i+\\cos{\\left(t \\right)}\\,j.$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}\\int_C\\left(- 3 x^{2}\\right)\\,\\mathrm{d}x+\\left(- x y\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 3 x^{2}\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(- x y\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 3 x^{2}\\right)x\\prime(t)+\\left(- x y\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 27 \\cos^{2}{\\left(t \\right)}\\right)\\left(- 3 \\sin{\\left(t \\right)}\\right)+\\left(- 3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}\\right)\\left(\\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(81 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(78 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\,\\mathrm{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557824 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d0826fc-9ba4-5530-9d52-a358f5c90ecc" :answer/type {:db/ident :answer.type/math} :answer/value "24 \\pi" :db/id #edb/ref 17592186557801} {:answer/id #uuid "8634f0b6-6781-50a6-9009-8b052ccd87c7" :answer/type {:db/ident :answer.type/math} :answer/value "- 15 \\pi" :db/id #edb/ref 17592186557823} {:answer/id #uuid "9583d382-ea32-56a5-9d1a-745663042e26" :answer/type {:db/ident :answer.type/math} :answer/value "- 63 \\pi" :db/id #edb/ref 17592186557828} {:answer/id #uuid "aa610211-4e68-569f-99ec-1ba9534cea16" :answer/type {:db/ident :answer.type/math} :answer/value "-252" :db/id #edb/ref 17592186557833} {:answer/id #uuid "cfb74e83-07bd-502b-b98b-06c2a15eae60" :answer/type {:db/ident :answer.type/math} :answer/value "- 39 \\pi" :db/id #edb/ref 17592186557841}] :answer-field/correct {:answer/id #uuid "8634f0b6-6781-50a6-9009-8b052ccd87c7" :answer/type {:db/ident :answer.type/math} :answer/value "- 15 \\pi" :db/id #edb/ref 17592186557823} :answer-field/id #uuid "a4c22627-b132-5666-b74d-b94aa86cc293" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557832}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8739eb28-3666-500d-b030-f6ce2af45845" :question/problem "Evaluate $\\int_C\\left(- 4 x^{2} y + y\\right)\\,\\mathrm{d}x+\\left(- 3 x y^{2} - x\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $16 x^{2} + 9 y^{2}=144$ traversed in the counterclockwise direction from the point $(3,0)$ to the point $(0,4)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $3$ and $4,$ respectively, it can be parametrized as follows:\n\n$$r(t)=3 \\cos{\\left(t \\right)}\\,i+4 \\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\frac{\\pi}{2}].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 3 \\sin{\\left(t \\right)}\\,i+4 \\cos{\\left(t \\right)}\\,j.$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\\int_C\\left(- 4 x^{2} y + y\\right)\\,\\mathrm{d}x+\\left(- 3 x y^{2} - x\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 4 x^{2} y + y\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(- 3 x y^{2} - x\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 4 x^{2} y + y\\right)x\\prime(t)+\\left(- 3 x y^{2} - x\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 144 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} + 4 \\sin{\\left(t \\right)}\\right)\\left(- 3 \\sin{\\left(t \\right)}\\right)+\\left(- 144 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos{\\left(t \\right)}\\right)\\left(4 \\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(432 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 12 \\sin^{2}{\\left(t \\right)}\\right)+\\left(- 12 \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 576 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 144 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} - 12\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(18 \\cos{\\left(4 t \\right)} - 30\\right)\\,\\mathrm{d}t\\\\ & =\\left[- 30 t + \\frac{9 \\sin{\\left(4 t \\right)}}{2}\\right]_{0}^{\\frac{\\pi}{2}}\\\\ & =\\left(- 30 \\left(\\frac{\\pi}{2}\\right) + \\frac{9 \\sin{\\left(4 \\left(\\frac{\\pi}{2}\\right) \\right)}}{2}\\right)-\\left(- 30 \\left(0\\right) + \\frac{9 \\sin{\\left(4 \\left(0\\right) \\right)}}{2}\\right)\\\\ & =\\left(\\left(- 15 \\pi\\right)+\\left(0\\right)\\right)-\\left(\\left(0\\right)+\\left(0\\right)\\right)\\\\ & =- 15 \\pi\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557830 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3847c491-e0a0-55fb-b8ed-745703409a38" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{39 \\pi}{4}" :db/id #edb/ref 17592186557806} {:answer/id #uuid "5c279f43-81b1-5048-a51f-9dec9c1853d3" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 \\pi" :db/id #edb/ref 17592186557814} {:answer/id #uuid "aecc94f3-c0b8-59f4-a6e5-f71ef3d37ec4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{63 \\pi}{4}" :db/id #edb/ref 17592186557834} {:answer/id #uuid "b9552b1b-4bf6-5bfc-8c85-7313d734f76e" :answer/type {:db/ident :answer.type/math} :answer/value "-39" :db/id #edb/ref 17592186557838} {:answer/id #uuid "d4747d89-0358-5ecd-8c62-f05dadd92f55" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{51 \\pi}{4}" :db/id #edb/ref 17592186557842}] :answer-field/correct {:answer/id #uuid "aecc94f3-c0b8-59f4-a6e5-f71ef3d37ec4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{63 \\pi}{4}" :db/id #edb/ref 17592186557834} :answer-field/id #uuid "e1ff7999-cf9a-5af9-84d4-39d73a6002f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9be25acc-1ec0-58da-aef8-6711e4d01192" :question/problem "Evaluate $\\int_C\\left(- 2 x^{2} y + 4 y\\right)\\,\\mathrm{d}x+\\left(- 2 x y^{2} - 4 x\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $9 x^{2} + 4 y^{2}=36$ traversed in the counterclockwise direction from the point $(2,0)$ to the point $(0,3)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $3,$ respectively, it can be parametrized as follows:\n\n$$r(t)=2 \\cos{\\left(t \\right)}\\,i+3 \\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\frac{\\pi}{2}].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 2 \\sin{\\left(t \\right)}\\,i+3 \\cos{\\left(t \\right)}\\,j.$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\\int_C\\left(- 2 x^{2} y + 4 y\\right)\\,\\mathrm{d}x+\\left(- 2 x y^{2} - 4 x\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 2 x^{2} y + 4 y\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(- 2 x y^{2} - 4 x\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 2 x^{2} y + 4 y\\right)x\\prime(t)+\\left(- 2 x y^{2} - 4 x\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 24 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} + 12 \\sin{\\left(t \\right)}\\right)\\left(- 2 \\sin{\\left(t \\right)}\\right)+\\left(- 36 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)} - 8 \\cos{\\left(t \\right)}\\right)\\left(3 \\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(48 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 24 \\sin^{2}{\\left(t \\right)}\\right)+\\left(- 24 \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 108 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 60 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} - 24\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\frac{15 \\cos{\\left(4 t \\right)}}{2} - \\frac{63}{2}\\right)\\,\\mathrm{d}t\\\\ & =\\left[- \\frac{63 t}{2} + \\frac{15 \\sin{\\left(4 t \\right)}}{8}\\right]_{0}^{\\frac{\\pi}{2}}\\\\ & =\\left(- \\frac{63 \\left(\\frac{\\pi}{2}\\right)}{2} + \\frac{15 \\sin{\\left(4 \\left(\\frac{\\pi}{2}\\right) \\right)}}{8}\\right)-\\left(- \\frac{63 \\left(0\\right)}{2} + \\frac{15 \\sin{\\left(4 \\left(0\\right) \\right)}}{8}\\right)\\\\ & =\\left(\\left(- \\frac{63 \\pi}{4}\\right)+\\left(0\\right)\\right)-\\left(\\left(0\\right)+\\left(0\\right)\\right)\\\\ & =- \\frac{63 \\pi}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557836 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a63d515-0ab8-5468-81ea-d6a8e74ac4ca" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{57}{4}" :db/id #edb/ref 17592186557813} {:answer/id #uuid "5e778ab1-5d99-51ad-8b59-306deab0c03f" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{57 \\pi}{16}" :db/id #edb/ref 17592186557815} {:answer/id #uuid "7ba88d97-7753-513f-a98a-5762e70fbde1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi}{16}" :db/id #edb/ref 17592186557821} {:answer/id #uuid "92409415-01eb-5113-8034-f7c988147bab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21 \\pi}{8}" :db/id #edb/ref 17592186557827} {:answer/id #uuid "987fcf17-c5ad-5319-b164-9e0a387a95d6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{15 \\pi}{16}" :db/id #edb/ref 17592186557829}] :answer-field/correct {:answer/id #uuid "7ba88d97-7753-513f-a98a-5762e70fbde1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27 \\pi}{16}" :db/id #edb/ref 17592186557821} :answer-field/id #uuid "5277df30-4b80-52ef-a167-017b9064a2dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557809}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b760d270-0b52-5110-b068-ec2545a8607e" :question/problem "Evaluate $\\int_C\\left(- 2 x^{2} y + y\\right)\\,\\mathrm{d}x+\\left(- x y^{2} - x\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $x^{2} + 9 y^{2}=9$ traversed in the counterclockwise direction from the point $(3,0)$ to the point $(0,1)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $3$ and $1,$ respectively, it can be parametrized as follows:\n\n$$r(t)=3 \\cos{\\left(t \\right)}\\,i+\\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\frac{\\pi}{2}].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 3 \\sin{\\left(t \\right)}\\,i+\\cos{\\left(t \\right)}\\,j.$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\\int_C\\left(- 2 x^{2} y + y\\right)\\,\\mathrm{d}x+\\left(- x y^{2} - x\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 2 x^{2} y + y\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(- x y^{2} - x\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 2 x^{2} y + y\\right)x\\prime(t)+\\left(- x y^{2} - x\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 18 \\sin{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} + \\sin{\\left(t \\right)}\\right)\\left(- 3 \\sin{\\left(t \\right)}\\right)+\\left(- 3 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)} - 3 \\cos{\\left(t \\right)}\\right)\\left(\\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(54 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\sin^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\cos^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(51 \\sin^{2}{\\left(t \\right)} \\cos^{2}{\\left(t \\right)} - 3\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\frac{27}{8} - \\frac{51 \\cos{\\left(4 t \\right)}}{8}\\right)\\,\\mathrm{d}t\\\\ & =\\left[\\frac{27 t}{8} - \\frac{51 \\sin{\\left(4 t \\right)}}{32}\\right]_{0}^{\\frac{\\pi}{2}}\\\\ & =\\left(\\frac{27 \\left(\\frac{\\pi}{2}\\right)}{8} - \\frac{51 \\sin{\\left(4 \\left(\\frac{\\pi}{2}\\right) \\right)}}{32}\\right)-\\left(\\frac{27 \\left(0\\right)}{8} - \\frac{51 \\sin{\\left(4 \\left(0\\right) \\right)}}{32}\\right)\\\\ & =\\left(\\left(0\\right)+\\left(\\frac{27 \\pi}{16}\\right)\\right)-\\left(\\left(0\\right)+\\left(0\\right)\\right)\\\\ & =\\frac{27 \\pi}{16}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557837 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632" :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f0336cc-9fd9-5b2d-9a57-64a24aef91a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2} - \\frac{3 \\pi}{4}" :db/id #edb/ref 17592186557805} {:answer/id #uuid "5a48c3f8-c214-51b9-b123-90b0d948c8e2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{33}{2}" :db/id #edb/ref 17592186557812} {:answer/id #uuid "7c9b686a-2146-5d69-bd8e-5d06c4ab2905" :answer/type {:db/ident :answer.type/math} :answer/value "18 - \\frac{3 \\pi}{4}" :db/id #edb/ref 17592186557822} {:answer/id #uuid "b3b5a01a-cd71-58fa-a674-5b6e3a5dec58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{39}{2} - \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186557835} {:answer/id #uuid "c8dfce80-11c9-593e-8b53-5e8284197d75" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{33 \\pi}{4}" :db/id #edb/ref 17592186557839}] :answer-field/correct {:answer/id #uuid "b3b5a01a-cd71-58fa-a674-5b6e3a5dec58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{39}{2} - \\frac{3 \\pi}{2}" :db/id #edb/ref 17592186557835} :answer-field/id #uuid "8d8f57ae-5aa7-5339-8cec-7f584bbc1313" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8886af2-15c3-5d9c-8be1-602af41bdf96" :question/problem "Evaluate $\\int_C\\left(- 4 x + y\\right)\\,\\mathrm{d}x+\\left(- x + 3 y\\right)\\,\\mathrm{d}y,$ where $C$ is part of the ellipse $x^{2} + 9 y^{2}=9$ traversed in the counterclockwise direction from the point $(3,0)$ to the point $(0,1)$." :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $3$ and $1,$ respectively, it can be parametrized as follows:\n\n$$r(t)=3 \\cos{\\left(t \\right)}\\,i+\\sin{\\left(t \\right)}\\,j,\\quad t\\in[0,\\frac{\\pi}{2}].$$\n\nThe derivative of $r(t)$ is given by\n\n$$r\\prime(t)=- 3 \\sin{\\left(t \\right)}\\,i+\\cos{\\left(t \\right)}\\,j.$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\\int_C\\left(- 4 x + y\\right)\\,\\mathrm{d}x+\\left(- x + 3 y\\right)\\,\\mathrm{d}y & =\\int_{0}^{\\frac{\\pi}{2}}\\left(- 4 x + y\\right)x\\prime(t)\\,\\mathrm{d}t+\\left(- x + 3 y\\right)y\\prime(t)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(- 4 x + y\\right)x\\prime(t)+\\left(- x + 3 y\\right)y\\prime(t)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(\\sin{\\left(t \\right)} - 12 \\cos{\\left(t \\right)}\\right)\\left(- 3 \\sin{\\left(t \\right)}\\right)+\\left(3 \\sin{\\left(t \\right)} - 3 \\cos{\\left(t \\right)}\\right)\\left(\\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\left(36 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}\\right)+\\left(- 3 \\sin^{2}{\\left(t \\right)}\\right)+\\left(- 3 \\cos^{2}{\\left(t \\right)}\\right)+\\left(3 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}\\right)\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(39 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} - 3\\right)\\,\\mathrm{d}t\\\\ & =\\int_{0}^{\\frac{\\pi}{2}}\\left(\\frac{39 \\sin{\\left(2 t \\right)}}{2} - 3\\right)\\,\\mathrm{d}t\\\\ & =\\left[- 3 t + \\frac{39 \\sin^{2}{\\left(t \\right)}}{2}\\right]_{0}^{\\frac{\\pi}{2}}\\\\ & =\\left(- 3 \\left(\\frac{\\pi}{2}\\right) + \\frac{39 \\sin^{2}{\\left(\\left(\\frac{\\pi}{2}\\right) \\right)}}{2}\\right)-\\left(- 3 \\left(0\\right) + \\frac{39 \\sin^{2}{\\left(\\left(0\\right) \\right)}}{2}\\right)\\\\ & =\\left(\\left(- \\frac{3 \\pi}{2}\\right)+\\left(\\frac{39}{2}\\right)\\right)-\\left(\\left(0\\right)+\\left(0\\right)\\right)\\\\ & =\\frac{39}{2} - \\frac{3 \\pi}{2}\\end{aligned}\n$$"}] :knowledge-point/title "Computing Line Integrals With Respect to X and Y Along Circles and Ellipses"}]}
