    "question": {
      ":question/id": "cd0c7321-e023-5633-bdad-071f1a7eccfc",
      ":question/problem": "![](images/00/0012f2c4830f5acc401b551e8421b0bbb730c2e27f68010a691d74dcfd6ea93a.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "c7e14ab2-deee-519b-b7a6-3593e9d0bdd8",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "7a61b366-e9b7-591e-8aa3-cb81c88d5dc9",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{3}{4y}"
            },
            {
              ":answer/id": "e2d2e80c-ed1d-537f-9327-a685067c2765",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{3}{4}"
            },
            {
              ":answer/id": "5e758806-41e5-566a-bd49-b8b45956c8f5",
              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{3}{4y}"
            },
            {
              ":answer/id": "f437c276-f770-525e-91cd-572b961b92ac",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{4y}{3}"
            },
            {
              ":answer/id": "57e246f3-cb19-54af-a1b3-e2c195a5e06e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{3}{2y}"
