51-838c43d39c9c" :answer/id #uuid "2f4bd4b3-9bdd-5c11-8b51-838c43d39c9c" :answer/type :answer.type/math :answer/value "-2" :db/ensure :answer/validate} {:db/id "3c4b4903-fe0a-5fb0-a751-3f0fa8df877f" :answer/id #uuid "3c4b4903-fe0a-5fb0-a751-3f0fa8df877f" :answer/type :answer.type/math :answer/value "-3" :db/ensure :answer/validate} {:db/id "0095545e-54d6-52cd-924a-d0a5a2f5a1ae" :answer/id #uuid "0095545e-54d6-52cd-924a-d0a5a2f5a1ae" :answer/type :answer.type/math :answer/value "-4" :db/ensure :answer/validate} {:db/id "337996a5-122c-53fe-a44a-810d11d9fbdc" :answer/id #uuid "337996a5-122c-53fe-a44a-810d11d9fbdc" :answer/type :answer.type/math :answer/value "1" :db/ensure :answer/validate} {:db/id "6432dee2-0978-5e2c-8294-660f6ce4dc02" :answer/id #uuid "6432dee2-0978-5e2c-8294-660f6ce4dc02" :answer/type :answer.type/math :answer/value "4" :db/ensure :answer/validate} {:db/id "d61ec2e2-631a-51c9-9a12-395b3a9c74bb" :answer-field/id #uuid "d61ec2e2-631a-51c9-9a12-395b3a9c74bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["2f4bd4b3-9bdd-5c11-8b51-838c43d39c9c" "3c4b4903-fe0a-5fb0-a751-3f0fa8df877f" "0095545e-54d6-52cd-924a-d0a5a2f5a1ae" "337996a5-122c-53fe-a44a-810d11d9fbdc" "6432dee2-0978-5e2c-8294-660f6ce4dc02"] :answer-field/correct "6432dee2-0978-5e2c-8294-660f6ce4dc02" :db/ensure :answer-field/validate} {:db/id "873b7f6f-85bd-5d73-adb8-dc5d593e552e" :question/id #uuid "873b7f6f-85bd-5d73-adb8-dc5d593e552e" :question/problem "Given the system of equations below, what is the value of $a - b$?\n\n$\\{-3a-3b=6; -4a+b=-7$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $b$:\n\n$$\n\\begin{aligned}-4a+b & =-7 \\\\ b & =-7+4a\\end{aligned}\n$$\n\nThen, we substitute $b=-7+4a$ into the first equation and solve for $a:$\n\n$$\n\\begin{aligned}-3a-3b & =6 \\\\ -3a-3(-7+4a) & =6 \\\\ -3a+21-12a & =6 \\\\ -15a+21 & =6 \\\\ -15a & =-15 \\\\ a & =1\\end{aligned}\n$$\n\nIf we now substitute $a=1$ into $b=-7+4a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =-7+4(1) \\\\ b & =-3\\end{aligned}\n$$\n\nTherefore, $a-b=1-(-3)=4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["d61ec2e2-631a-51c9-9a12-395b3a9c74bb"] :db/ensure :question/validate} {:db/id "0a525fbe-b100-56e5-b363-b84bd9a5d52e" :answer/id #uuid "0a525fbe-b100-56e5-b363-b84bd9a5d52e" :answer/type :answer.type/math :answer/value "-5" :db/ensure :answer/validate} {:db/id "b7b07809-444e-59d8-a95b-553b710baa60" :answer/id #uuid "b7b07809-444e-59d8-a95b-553b710baa60" :answer/type :answer.type/math :answer/value "4" :db/ensure :answer/validate} {:db/id "5b7578d1-6cb2-5958-9c79-b1f69ff339d7" :answer/id #uuid "5b7578d1-6cb2-5958-9c79-b1f69ff339d7" :answer/type :answer.type/math :answer/value "5" :db/ensure :answer/validate} {:db/id "eac62da3-8a0e-571b-9e13-3d68ba632045" :answer/id #uuid "eac62da3-8a0e-571b-9e13-3d68ba632045" :answer/type :answer.type/math :answer/value "3" :db/ensure :answer/validate} {:db/id "9fbaa74b-19ed-5c95-b977-ac0cc7054256" :answer/id #uuid "9fbaa74b-19ed-5c95-b977-ac0cc7054256" :answer/type :answer.type/math :answer/value "-1" :db/ensure :answer/validate} {:db/id "97f66384-4244-5039-a3bb-781c22ba011e" :answer-field/id #uuid "97f66384-4244-5039-a3bb-781c22ba011e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["0a525fbe-b100-56e5-b363-b84bd9a5d52e" "b7b07809-444e-59d8-a95b-553b710baa60" "5b7578d1-6cb2-5958-9c79-b1f69ff339d7" "eac62da3-8a0e-571b-9e13-3d68ba632045" "9fbaa74b-19ed-5c95-b977-ac0cc7054256"] :answer-field/correct "0a525fbe-b100-56e5-b363-b84bd9a5d52e" :db/ensure :answer-field/validate} {:db/id "9362a51f-6c19-5264-931e-57aaf13ce3e6" :question/id #uuid "9362a51f-6c19-5264-931e-57aaf13ce3e6" :question/problem "Given the system of equations below, what is the value of $a - b$?\n\n$\\{-2a-4b=-14; -2a+b=6$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $b$:\n\n$$\n\\begin{aligned}-2a+b & =6 \\\\ b & =6+2a\\end{aligned}\n$$\n\nThen, we substitute $b=6+2a$ into the first equation and solve for $a:$\n\n$$\n\\begin{aligned}-2a-4b & =-14 \\\\ -2a-4(6+2a) & =-14 \\\\ -2a-24-8a & =-14 \\\\ -10a-24 & =-14 \\\\ -10a & =10 \\\\ a & =-1\\end{aligned}\n$$\n\nIf we now substitute $a=-1$ into $b=6+2a,$ we can then find the value of $b:$\n\n$$\n\\begin{aligned}b & =6+2(-1) \\\\ b & =4\\end{aligned}\n$$\n\nTherefore, $a-b=-1-(4)=-5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["97f66384-4244-5039-a3bb-781c22ba011e"] :db/ensure :question/validate} {:db/id "9e04510d-2fe1-543a-ac55-911f068010c6" :answer/id #uuid "9e04510d-2fe1-543a-ac55-911f068010c6" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure :answer/validate} {:db/id "496722ff-acc0-5b76-a13e-09917012d73d" :answer-field/id #uuid "496722ff-acc0-5b76-a13e-09917012d73d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["9e04510d-2fe1-543a-ac55-911f068010c6"] :answer-field/correct "9e04510d-2fe1-543a-ac55-911f068010c6" :db/ensure :answer-field/validate} {:db/id "08a38b64-b8c2-526f-8347-6ba7980eb350" :answer/id #uuid "08a38b64-b8c2-526f-8347-6ba7980eb350" :answer/type :answer.type/math :answer/value "-\\frac{5}{3}" :db/ensure :answer/validate} {:db/id "b547fc55-eab5-5d24-ba49-2faa2df55e6a" :answer-field/id #uuid "b547fc55-eab5-5d24-ba49-2faa2df55e6a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/choices ["08a38b64-b8c2-526f-8347-6ba7980eb350"] :answer-field/correct "08a38b64-b8c2-526f-8347-6ba7980eb350" :db/ensure :answer-field/validate} {:db/id "b0966484-f411-5cf8-8677-c24b7843a43c" :question/id #uuid "b0966484-f411-5cf8-8677-c24b7843a43c" :question/problem "Find the solution $(x,y)$ to this system using the method of substitution.\n\n$\\{5x-2y=5; 2x+y=-1$\n\nThe solution is $($ {{field-1}} $, $ {{field-2}} $)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $y$:\n\n$$\n\\begin{aligned}2x+y & =-1 \\\\ y & =-1-2x\\end{aligned}\n$$\n\nThen, we substitute $y=-1-2x$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}5x-2y & =5 \\\\ 5x-2(-1-2x) & =5 \\\\ 5x+2+4x & =5 \\\\ 9x+2 & =5 \\\\ 9x & =3 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nIf we now substitute $x=\\frac{1}{3}$ into $y=-1-2x,$ we can then find the value of $y:$\n\n$$\n\\begin{aligned}y & =-1-2(\\frac{1}{3}) \\\\ y & =-\\frac{5}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=\\frac{1}{3},\\,y=-\\frac{5}{3}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["496722ff-acc0-5b76-a13e-09917012d73d" "b547fc55-eab5-5d24-ba49-2faa2df55e6a"] :db/ensure :question/validate} {:db/id "4fc36be2-1ad6-5b03-b736-d29211c26e29" :answer/id #uuid "4fc36be2-1ad6-5b03-b736-d29211c26e29" :answer/type :answer.type/math :answer/value "-\\frac{16}{5}" :db/ensure :answer/validate} {:db/id "84b6ed04-ec34-5023-a363-127985a3747a" :answer-field/id #uuid "84b6ed04-ec34-5023-a363-127985a3747a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["4fc36be2-1ad6-5b03-b736-d29211c26e29"] :answer-field/correct "4fc36be2-1ad6-5b03-b736-d29211c26e29" :db/ensure :answer-field/validate} {:db/id "61123492-b1fa-52ea-a78d-92d15eb4799a" :answer/id #uuid "61123492-b1fa-52ea-a78d-92d15eb4799a" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure :answer/validate} {:db/id "00e813eb-39d3-591a-bc56-b776bdfd2316" :answer-field/id #uuid "00e813eb-39d3-591a-bc56-b776bdfd2316" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/choices ["61123492-b1fa-52ea-a78d-92d15eb4799a"] :answer-field/correct "61123492-b1fa-52ea-a78d-92d15eb4799a" :db/ensure :answer-field/validate} {:db/id "76c476e0-406c-5751-a806-f5cbe03fe610" :question/id #uuid "76c476e0-406c-5751-a806-f5cbe03fe610" :question/problem "Find the solution $(x,y)$ to this system using the method of substitution.\n\n$\\{-3x+4y=8; -2x+y=6$\n\nThe solution is $($ {{field-1}} $, $ {{field-2}} $)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $y$:\n\n$$\n\\begin{aligned}-2x+y & =6 \\\\ y & =6+2x\\end{aligned}\n$$\n\nThen, we substitute $y=6+2x$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}-3x+4y & =8 \\\\ -3x+4(6+2x) & =8 \\\\ -3x+24+8x & =8 \\\\ 5x+24 & =8 \\\\ 5x & =-16 \\\\ x & =-\\frac{16}{5}\\end{aligned}\n$$\n\nIf we now substitute $x=-\\frac{16}{5}$ into $y=6+2x,$ we can then find the value of $y:$\n\n$$\n\\begin{aligned}y & =6+2(-\\frac{16}{5}) \\\\ y & =-\\frac{2}{5}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-\\frac{16}{5},\\,y=-\\frac{2}{5}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["84b6ed04-ec34-5023-a363-127985a3747a" "00e813eb-39d3-591a-bc56-b776bdfd2316"] :db/ensure :question/validate} {:db/id "609dae4d-f20b-597d-8d5c-bd3985bfb3ab" :answer/id #uuid "609dae4d-f20b-597d-8d5c-bd3985bfb3ab" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure :answer/validate} {:db/id "313ebe14-9bc4-580a-8ef0-cc446d43568b" :answer-field/id #uuid "313ebe14-9bc4-580a-8ef0-cc446d43568b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["609dae4d-f20b-597d-8d5c-bd3985bfb3ab"] :answer-field/correct "609dae4d-f20b-597d-8d5c-bd3985bfb3ab" :db/ensure :answer-field/validate} {:db/id "54ede735-9e0a-5b8d-8cb8-1ec5b24e8a75" :answer/id #uuid "54ede735-9e0a-5b8d-8cb8-1ec5b24e8a75" :answer/type :answer.type/math :answer/value "\\frac{17}{3}" :db/ensure :answer/validate} {:db/id "40fbd52d-5989-56ab-8589-60d240620d11" :answer-field/id #uuid "40fbd52d-5989-56ab-8589-60d240620d11" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/choices ["54ede735-9e0a-5b8d-8cb8-1ec5b24e8a75"] :answer-field/correct "54ede735-9e0a-5b8d-8cb8-1ec5b24e8a75" :db/ensure :answer-field/validate} {:db/id "ddedcc45-5aba-5229-89b3-d8e7abbe4344" :question/id #uuid "ddedcc45-5aba-5229-89b3-d8e7abbe4344" :question/problem "Find the solution $(x,y)$ to this system using the method of substitution.\n\n$\\{2x+2y=12; -2x+y=5$\n\nThe solution is $($ {{field-1}} $, $ {{field-2}} $)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $y$:\n\n$$\n\\begin{aligned}-2x+y & =5 \\\\ y & =5+2x\\end{aligned}\n$$\n\nThen, we substitute $y=5+2x$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}2x+2y & =12 \\\\ 2x+2(5+2x) & =12 \\\\ 2x+10+4x & =12 \\\\ 6x+10 & =12 \\\\ 6x & =2 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nIf we now substitute $x=\\frac{1}{3}$ into $y=5+2x,$ we can then find the value of $y:$\n\n$$\n\\begin{aligned}y & =5+2(\\frac{1}{3}) \\\\ y & =\\frac{17}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=\\frac{1}{3},\\,y=\\frac{17}{3}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["313ebe14-9bc4-580a-8ef0-cc446d43568b" "40fbd52d-5989-56ab-8589-60d240620d11"] :db/ensure :question/validate} {:db/id "3f39f41a-cfb3-5bf0-b58f-8d17841342c6" :answer/id #uuid "3f39f41a-cfb3-5bf0-b58f-8d17841342c6" :answer/type :answer.type/math :answer/value "-\\frac{17}{6}" :db/ensure :answer/validate} {:db/id "fa771fca-d97d-5b82-add7-3f2815e11284" :answer-field/id #uuid "fa771fca-d97d-5b82-add7-3f2815e11284" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["3f39f41a-cfb3-5bf0-b58f-8d17841342c6"] :answer-field/correct "3f39f41a-cfb3-5bf0-b58f-8d17841342c6" :db/ensure :answer-field/validate} {:db/id "3eb5050b-2f97-532e-b6c8-5866bcc9fa51" :answer/id #uuid "3eb5050b-2f97-532e-b6c8-5866bcc9fa51" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure :answer/validate} {:db/id "ac08740b-e844-58dd-baf4-40ef0b885178" :answer-field/id #uuid "ac08740b-e844-58dd-baf4-40ef0b885178" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/choices ["3eb5050b-2f97-532e-b6c8-5866bcc9fa51"] :answer-field/correct "3eb5050b-2f97-532e-b6c8-5866bcc9fa51" :db/ensure :answer-field/validate} {:db/id "3db3cd07-1246-5ea5-a44f-5fee48dd9a13" :question/id #uuid "3db3cd07-1246-5ea5-a44f-5fee48dd9a13" :question/problem "Find the solution $(x,y)$ to this system using the method of substitution.\n\n$\\{3x+3y=2; 3x+y=-5$\n\nThe solution is $($ {{field-1}} $, $ {{field-2}} $)$" :question/worked-solution "We will isolate a variable in one of the equations and then substitute it into the other equation. \n\nUsing the second equation, we can isolate $y$:\n\n$$\n\\begin{aligned}3x+y & =-5 \\\\ y & =-5-3x\\end{aligned}\n$$\n\nThen, we substitute $y=-5-3x$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}3x+3y & =2 \\\\ 3x+3(-5-3x) & =2 \\\\ 3x-15-9x & =2 \\\\ -6x-15 & =2 \\\\ -6x & =17 \\\\ x & =-\\frac{17}{6}\\end{aligned}\n$$\n\nIf we now substitute $x=-\\frac{17}{6}$ into $y=-5-3x,$ we can then find the value of $y:$\n\n$$\n\\begin{aligned}y & =-5-3(-\\frac{17}{6}) \\\\ y & =\\frac{7}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-\\frac{17}{6},\\,y=\\frac{7}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["fa771fca-d97d-5b82-add7-3f2815e11284" "ac08740b-e844-58dd-baf4-40ef0b885178"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "f056eadd-a598-5e78-b365-4bdfdf9e1094" :quest