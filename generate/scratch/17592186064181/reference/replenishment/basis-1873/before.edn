academy-id "q-113948" :question/problem "$\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}x\\,\\text{d}x=-\\operatorname{cot}x+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{5}{2}{csc}^{2}x\\,\\text{d}x & =-\\frac{5}{2}\\int {csc}^{2}x\\,\\text{d}x \\\\  & =-\\frac{5}{2}(-\\operatorname{cot}x)+C \\\\  & =\\frac{5}{2}\\operatorname{cot}x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id 17592186233200 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1c076ca-58d1-50c6-89b5-7409bb1c260d" :question/math-academy-id "q-113952" :question/problem "$\\int 3{csc}^{2}x-4\\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int {csc}^{2}x\\,\\text{d}x & =-\\operatorname{cot}x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 3{csc}^{2}x-4\\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =3\\int {csc}^{2}x\\,\\text{d}x-4\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3(-\\operatorname{cot}x)-4(\\operatorname{sec}x)+C \\\\  & =-3\\operatorname{cot}x-4\\operatorname{sec}x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id 17592186233201 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1dc5c87c-64df-54e7-9938-40291c767c67" :question/math-academy-id "q-113958" :question/problem "$\\int (\\operatorname{sec}x\\operatorname{tan}x-2{csc}^{2}x+\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\begin{aligned}\\int {csc}^{2}x\\,\\text{d}x & =-\\operatorname{cot}x+C, \\\\ \\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C, \\\\ \\int sin\\,\\text{d}x & =-\\operatorname{cos}x+C.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (\\operatorname{sec}x\\operatorname{tan}x-2{csc}^{2}x+\\operatorname{sin}x)\\,\\text{d}x & =\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x-2\\int {csc}^{2}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =\\operatorname{sec}x-2(-\\operatorname{cot}x)+(-\\operatorname{cos}x)+C \\\\  & =\\operatorname{sec}x+2\\operatorname{cot}x-\\operatorname{cos}x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id 17592186233488 :knowledge-point/_questions [{:knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fab2b00-89b9-5e37-acd4-cacd09480aee" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}t" :db/id 17592186232210}] :answer-field/correct {:answer/id #uuid "1fab2b00-89b9-5e37-acd4-cacd09480aee" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{cot}t" :db/id 17592186232210} :answer-field/id #uuid "741876d0-ec1d-5a78-b6aa-658f559e821f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232209}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3f30b1-6acc-552c-b509-78b7cd37e409" :question/math-academy-id "q-143522" :question/problem "$\\int v(t)\\,\\text{d}t\\,\\,=\\,${{field-1}} $+\\text{ }C$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}t\\,\\text{d}t=-\\operatorname{cot}t+C.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4{csc}^{2}t\\,\\text{d}t & =4\\int {csc}^{2}t\\,\\text{d}t \\\\  & 