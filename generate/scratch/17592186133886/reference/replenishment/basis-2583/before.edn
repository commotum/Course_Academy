s/ec/ec5ca2469ae1fd23385b27e906cb952f6b07c2bbfe02acbc42afa20284d4a122.svg)"} :knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/key-prerequisites [{:db/id 17592186050567}] :knowledge-point/questions [{:db/id 17592186134097 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074f2b27-d82e-5431-893f-5cb420b7db07" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id 17592186130739} {:answer/id #uuid "4fb000df-3f30-5d92-833d-b570ce4d2fc0" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id 17592186130740} {:answer/id #uuid "67a5cc30-ac62-56fb-b984-6bf8c55a68e5" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id 17592186130741} {:answer/id #uuid "6d1f5867-3adf-5ebd-8085-208cd0303ff9" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id 17592186130742} {:answer/id #uuid "6da1aafe-3858-50f0-8369-80cd33a8831e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id 17592186130743}] :answer-field/correct {:answer/id #uuid "074f2b27-d82e-5431-893f-5cb420b7db07" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id 17592186130739} :answer-field/id #uuid "3d6f2a4f-8215-5cfe-aa3b-409cfed8d343" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186130738}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d511ff2-5d88-51e6-9da4-d8015a261af1" :question/math-academy-id "q-126515" :question/problem "![](images/32/320a45751b2e718c66bb721cfcd78a2d206f08a9998fbbffddb1581ee995cf34.png)\n\nCalculate ${∮}_{∂D}x\\,dy-y\\,dx,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=-y$ and $Q(x,y)=x.$ So,\n\n$$\n\\frac{∂P}{∂y}=-1,\\,\\frac{∂Q}{∂x}=1.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}x\\,dy-y\\,dx & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(1-(-1))\\,\\text{d}A \\\\  & ={∬}_{D}2\\,\\text{d}A \\\\  & =2{∬}_{D}\\,\\text{d}A \\\\  & =2\\cdot \\text{Area}(D) \\\\  & =2\\cdot ({4}^{2}-{2}^{2}) \\\\  & =2\\cdot (16-4) \\\\  & =2\\cdot 12 \\\\  & =24.\\end{aligned}\n$$"} {:db/id 17592186134100 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8672bfbf-4d4d-5253-9f83-f75552aab637" :answer/type {:db/ident :answer.type/math} :answer/value "-2π" :db/id 17592186130757} {:answer/id #uuid "e05949f9-9eb7-5677-b997-22c6339b8950" :answer/type {:db/ident :answer.type/math} :answer/value "6π" :db/id 17592186130758} {:answer/id #uuid "ffdc5cdf-d5f3-58a1-ae3b-d8584e3667be" :answer/type {:db/ident :answer.type/math} :answer/value "3π" :db/id 17592186130759} {:answer/id #uuid "7bf2c260-85c4-50d2-8cbc-b06eda27ff5f" :answer/type {:db/ident :answer.type/math} :answer/value "4π" :db/id 17592186130760} {:answer/id #uuid "7d7aa802-5a2e-5905-9460-5989c7b7829e" :answer/type {:db/ident :answer.type/math} :answer/value "2π" :db/id 17592186130761}] :answer-field/id #uuid "49e8a026-4e1e-5ba9-b726-87255f49ad4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186130756} {:answer-field/choices [{:answer/id #uuid "d09c91eb-6025-563c-9e1e-422c46c45a06" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id 17592186369381} {:answer/id #uuid "f7db36f3-e726-57a8-990c-cb139c3421dd" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\pi " :db/id 17592186369382} {:answer/id #uuid "0d9cd067-f29c-5dd2-92a7-39171feb6a4c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id 17592186369383} {:answer/id #uuid "5df13d18-ed06-5111-b470-86ff1f65bc05" :answer/type {:db/ident :answer.type/math} :answer/value "6\\pi " :db/id 17592186369384} {:answer/id #uuid "3ab6388d-f385-5685-97ba-bf84a736e56a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id 17592186369385}] :answer-field/correct {:answer/id #uuid "0d9cd067-f29c-5dd2-92a7-39171feb6a4c" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi " :db/id 17592186369383} :answer-field/id #uuid "e35c2b8b-a5ba-5e72-9086-b121a2efaac4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186369380}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54b4afaf-80a9-50b2-aaaa-863d5d133db6" :question/math-academy-id "q-126578" :question/problem "![](images/52/52815b087f869769950d37ab6b95edb75accf030e742ed16b4679b6a41d7d638.png)\n\nCalculate ${∮}_{∂D}dx+x\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=1$ and $Q(x,y)=x.$ So,\n\n$$\n\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=1.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(1-0)\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\text{d}A \\\\  & =\\text{Area}(D) \\\\  & =\\pi \\cdot {2}^{2}-\\pi \\cdot {1}^{2} \\\\  & =4\\pi -\\pi  \\\\  & =3\\pi .\\end{aligned}\n$$"} {:db/id 17592186369434 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fe866fa-6339-5f10-8ce3-3d5938c3785e" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id 17592186369436} {:answer/id #uuid "0aafa5fa-6806-5c1a-bd6e-a8f0ec680d0e" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id 17592186369437} {:answer/id #uuid "b169f03c-00d2-5df3-887b-9ea86b4a1f34" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id 17592186369438} {:answer/id #uuid "2e03cd88-a4dd-5d49-b397-096aeb5b4219" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id 17592186369439} {:answer/id #uuid "8e91bdb9-02ae-5c29-aa67-a875b2bc2112" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id 17592186369440}] :answer-field/correct {:answer/id #uuid "2e03cd88-a4dd-5d49-b397-096aeb5b4219" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id 17592186369439} :answer-field/id #uuid "d2ee2d3e-bbe0-5737-8885-1738f355a09b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186369435}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32a18b85-d978-5b18-8fff-914bdccf82dc" :question/math-academy-id "q-126853" :question/problem "![](images/39/393bed476f2e8d84fc7e5dc721d77749f7f259834e03a94a48a08533ae9befa6.png)\n\nCalculate ${∮}_{∂D}2y\\,dx+4x\\,dy,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=2y$ and $Q(x,y)=4x.$ So,\n\n$$\n\\frac{∂P}{∂y}=2,\\,\\frac{∂Q}{∂x}=4.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}2y\\,dx+4x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(4-2)\\,\\text{d}A \\\\  & ={∬}_{D}2\\,\\text{d}A \\\\  & =2{∬}_{D}\\,\\text{d}A \\\\  & =2\\cdot \\text{Area}(D) \\\\  & =2\\cdot (6\\cdot 4-{2}^{2}) \\\\  & =2\\cdot (24-4) \\\\  & =2\\cdot 20 \\\\  & =40.\\end{aligned}\n$$"} {:db/id 17592186369441 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "992dce16-160e-53f6-8630-c0af64cae1cb" :answer/type {:db/ident :answer.type/math} :answer/value "9\\pi " :db/id 17592186369443} {:answer/id #uuid "2bfd9130-7a02-5b45-a0d5-85f79505dd79" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\pi " :db/id 17592186369444} {:answer/id #uuid "2ce07f1c-821c-51aa-8553-62af6bab118d" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\pi " :db/id 17592186369445} {:answer/id #uuid "905e612c-8067-5089-bf8b-dc0ca7481414" :answer/type {:db/ident :answer.type/math} :answer/value "10\\pi " :db/id 17592186369446} {:answer/id #uuid "bae5a3fa-eb19-574d-b4eb-7f975d579bd1" :answer/type {:db/ident :answer.type/math} :answer/value "6\\pi " :db/id 17592186369447}] :answer-field/correct {:answer/id #uuid "2bfd9130-7a02-5b45-a0d5-85f79505dd79" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\pi " :db/id 17592186369444} :answer-field/id #uuid "37fee2c5-b026-5dca-a84d-1a957d12aae4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186369442}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7aa45530-2cd6-5788-83f4-81c4c36b6f4b" :question/math-academy-id "q-126856" :question/problem "![](images/6b/6b52e4f2f37d6ba6971fbc8f6e1d610ab7e0c9d11341ea3b6a6772bff8f40e37.png)\n\nCalculate ${∮}_{∂D}3y\\,dx+2x\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=3y$ and $Q(x,y)=2x.$ So,\n\n$$\n\\frac{∂P}{∂y}=3,\\,\\frac{∂Q}{∂x}=2.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}3y\\,dx+2x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(2-3)\\,\\text{d}A \\\\  & ={∬}_{D}-1\\,\\text{d}A \\\\  & =-{∬}_{D}\\,\\text{d}A \\\\  & =-\\text{Area}(D) \\\\  & =-(\\pi \\cdot {3}^{2}-\\pi \\cdot {1}^{2}) \\\\  & =-(9\\pi -\\pi ) \\\\  & =-8\\pi .\\end{aligned}\n$$"} {:db/id 17592186369455 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74b43056-e8dd-536d-b56a-12ac2800c12b" :answer/type {:db/ident :answer.type/math} :answer/value "364" :db/id 17592186369457} {:answer/id #uuid "ca09836f-3c6e-5b5f-841d-68ede18363c7" :answer/type {:db/ident :answer.type/math} :answer/value "215" :db/id 17592186369458} {:answer/id #uuid "ac3caf47-5329-54b1-8c87-bcf0da3ef96b" :answer/type {:db/ident :answer.type/math} :answer/value "424" :db/id 17592186369459} {:answer/id #uuid "b9b5b1dc-7bc7-5bb9-8b23-063bc496f471" :answer/type {:db/ident :answer.type/math} :answer/value "342" :db/id 17592186369460} {:answer/id #uuid "1d2e77d0-1779-5c5c-9e64-d3cabd705415" :answer/type {:db/ident :answer.type/math} :answer/value "124" :db/id 17592186369461}] :answer-field/correct {:answer/id #uuid "74b43056-e8dd-536d-b56a-12ac2800c12b" :answer/type {:db/ident :answer.type/math} :answer/value "364" :db/id 17592186369457} :answer-field/id #uuid "175c17d1-364f-5ab7-a6b1-2ce4de237b97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186369456}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "017f8f34-6e37-562a-87cf-df5a06a7e434" :question/math-academy-id "q-126860" :question/problem "![](images/b5/b5a42039e2501a3909062fd6ed92e0879df03f58fa85a62b5e738e8abc78b903.png)\n\nCalculate ${∮}_{∂D}8x\\,dy-5y\\,dx,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=-5y$ and $Q(x,y)=8x.$ So, \n\n$$\n\\frac{∂P}{∂y}=-5,\\,\\frac{∂Q}{∂x}=8.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}8x\\,dy-5y\\,dx & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(8-(-5))\\,\\text{d}A \\\\  & ={∬}_{D}13\\,\\text{d}A \\\\  & =13{∬}_{D}\\,\\text{d}A \\\\  & =13\\cdot \\text{Area}(D) \\\\  & =13\\cdot ({8}^{2}-{6}^{2}) \\\\  & =13\\cdot (64-36) \\\\  & =13\\cdot 28 \\\\  & =364.\\end{aligned}\n$$"} {:db/id 17592186369497 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e6750b8-75e8-5604-bdf3-5b26e689ff79" :answer/type {:db/ident :answer.type/math} :answer/value "12\\pi " :db/id 17592186369499} {:answer/id #uuid "71c2554d-1b8f-50ee-904e-bf572ea954dc" :answer/type {:db/ident :answer.type/math} :answer/value "14\\pi " :db/id 17592186369500} {:answer/id #uuid "d3d1e293-45b2-553f-8738-81af539d167d" :answer/type {:db/ident :answer.type/math} :answer/value "15\\pi " :db/id 17592186369501} {:answer/id #uuid "808c516e-8fb0-5d9d-b3c3-71bd5e0c0d18" :answer/type {:db/ident :answer.type/math} :answer/value "16\\pi " :db/id 17592186369502} {:answer/id #uuid "56bd1130-5922-503b-9779-186620077dd1" :answer/type {:db/ident :answer.type/math} :answer/value "18\\pi " :db/id 17592186369503}] :answer-field/correct {:answer/id #uuid "d3d1e293-45b2-553f-8738-81af539d167d" :answer/type {:db/ident :answer.type/math} :answer/value "15\\pi " :db/id 17592186369501} :answer-field/id #uuid "4a4245ec-3053-53c4-bb04-e49df5e84b57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186369498}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3c22304-91b2-51e6-94d5-71e3689e1379" :question/math-academy-id "q-126894" :question/problem "![](images/0e/0e86380c457bc9d37d0180057d4ce8c035055986d32254d95fab3a69254531a5.png)\n\nCalculate ${∮}_{∂D}6y\\,dx+9x\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=6y$ and $Q(x,y)=9x.$ So,\n\n$$\n\\frac{∂P}{∂y}=6,\\,\\frac{∂Q}{∂x}=9.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(9-6)\\,\\text{d}A \\\\  & ={∬}_{D}3\\,\\text{d}A \\\\  & =3\\,\\text{Area}(D) \\\\  & =3\\cdot (\\pi \\cdot {3}^{2}-\\pi \\cdot {2}^{2}) \\\\  & =3\\cdot 5\\pi  \\\\  & =15\\pi .\\end{aligned}\n$$"} {:db/id 17592186431352 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220be106-05bc-5093-b00a-7db60bd8ecaa" :answer/type {:db/ident :answer.type/math} :answer/value "14\\pi " :db/id 17592186431288} {:answer/id #uuid "37256756-976d-5c9b-9621-726f21d7d740" :answer/type {:db/ident :answer.type/math} :answer/value "48\\pi " :db/id 17592186431295} {:answer/id #uuid "3add5703-5575-518a-8fb6-785fcc0ae348" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi " :db/id 17592186431297} {:answer/id #uuid "b5c51c42-3a40-510d-8c2c-1c2f6b8e0682" :answer/type {:db/ident :answer.type/math} :answer/value "42\\pi " :db/id 17592186431327} {:answer/id #uuid "ddae96ae-32de-50a4-bd74-13c0f92807b5" :answer/type {:db/ident :answer.type/math} :answer/value "84\\pi " :db/id 17592186431334}] :answer-field/correct {:answer/id #uuid "ddae96ae-32de-50a4-bd74-13c0f92807b5" :answer/type {:db/ident :answer.type/math} :answer/value "84\\pi " :db/id 17592186431334} :answer-field/id #uuid "800a953b-6548-5c1f-a6b5-8f730ae36aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186431344}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e6cffb2-428d-5a69-9a22-1115ee05f052" :question/math-academy-id "q-126891" :question/problem "![](images/e7/e71bc835596d8699688f3623f339c26d365a8bb6e888742cbea10fc9da722adc.png)\n\nCalculate ${∮}_{∂D}5y\\,dx+11x\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=5y$ and $Q(x,y)=11x.$ So,\n\n$$\n\\frac{∂P}{∂y}=5,\\,\\frac{∂Q}{∂x}=11.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(11-5)\\,\\text{d}A \\\\  & ={∬}_{D}6\\,\\text{d}A \\\\  & =6\\,\\text{Area}(D) \\\\  & =6\\cdot (\\pi \\cdot {4}^{2}-\\frac{\\pi \\cdot {2}^{2}}{2}) \\\\  & =6\\cdot 14\\pi  \\\\  & =84\\pi .\\end{aligned}\n$$"} {:db/id 17592186431354 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0918efff-3716-5e79-bc16-ce01b647dee2" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id 17592186431283} {:answer/id #uuid "0a4ab89c-0bd1-5d9d-bbfe-405c2f326073" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id 17592186431284} {:answer/id #uuid "b158c6b6-52a5-5218-9685-8e39e2b380c0" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id 17592186431323} {:answer/id #uuid "b1f98841-106f-5d7f-bf0f-b27f11e0da85" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id 17592186431324} {:answer/id #uuid "fe684fde-4550-539f-a64b-9a955faeea4b" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id 17592186431337}] :answer-field/correct {:answer/id #uuid "b1f98841-106f-5d7f-bf0f-b27f11e0da85" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id 17592186431324} :answer-field/id #uuid "1eb80ec8-d8a5-5f3b-808d-db46b94db516" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186431339}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2fd9b28-2de8-59c7-8e8c-46e14a79f680" :question/math-academy-id "q-126880" :question/problem "![](images/65/65047f9bf4f035000175fc55ee3ba6eeb4aa7ec39674a1984b95ba98a3f754f6.png)\n\nCalculate ${∮}_{∂D}8y\\,dx+13x\\,dy,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=8y$ and $Q(x,y)=13x.$ So,  \n\n$$\n\\frac{∂P}{∂y}=8,\\,\\frac{∂Q}{∂x}=13.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}8y\\,dx+13x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(13-8)\\,\\text{d}A \\\\  & ={∬}_{D}5\\,\\text{d}A \\\\  & =5\\,{∬}_{D}\\,\\text{d}A \\\\  & =5\\cdot \\text{Area}(D) \\\\  & =5\\cdot (\\frac{6\\cdot 6}{2}-{2}^{2}) \\\\  & =5\\cdot (18-4) \\\\  & =70.\\end{aligned}\n$$"} {:db/id 17592186441617 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68a479bb-7541-5424-a117-bc163a220ec5" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi " :db/id 17592186441596} {:answer/id #uuid "8eb606cd-8859-52ad-923b-4174c43b9bc1" :answer/type {:db/ident :answer.type/math} :answer/value "25\\pi " :db/id 17592186441599} {:answer/id #uuid "bab36efc-1119-58ba-bc4b-a7d41daed2a5" :answer/type {:db/ident :answer.type/math} :answer/value "40\\pi " :db/id 17592186441602} {:answer/id #uuid "d102eb68-b278-588e-9ae4-718a08bc02d5" :answer/type {:db/ident :answer.type/math} :answer/value "32\\pi " :db/id 17592186441604} {:answer/id #uuid "fbd69b33-186c-5c7d-b495-4a5c8ed20698" :answer/type {:db/ident :answer.type/math} :answer/value "30\\pi " :db/id 17592186441609}] :answer-field/correct {:answer/id #uuid "d102eb68-b278-588e-9ae4-718a08bc02d5" :answer/type {:db/ident :answer.type/math} :answer/value "32\\pi " :db/id 17592186441604} :answer-field/id #uuid "25ffc2c7-e514-54e6-8c7b-600c1de04088" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186441612}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93b19a79-b263-5685-8630-5024a89d98bd" :question/math-academy-id "q-126893" :question/problem "![](images/df/df52e2add706a17bf93236cdaa04582932b6c799d4a88a3e194a3a3788c816ff.png)\n\nCalculate ${∮}_{∂D}3y\\,dx+7x\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=3y$ and $Q(x,y)=7x.$ So,\n\n$$\n\\frac{∂P}{∂y}=3,\\,\\frac{∂Q}{∂x}=7.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(7-3)\\,\\text{d}A \\\\  & ={∬}_{D}4\\,\\text{d}A \\\\  & =4\\,\\text{Area}(D) \\\\  & =4\\cdot (\\pi \\cdot {3}^{2}-\\pi \\cdot {1}^{2}) \\\\  & =4\\cdot 8\\pi  \\\\  & =32\\pi .\\end{aligned}\n$$"} {:db/id 17592186441618 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4b95dc2-7fee-5f7c-b4ec-8675b76cbf4c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id 17592186441601} {:answer/id #uuid "c1ef271c-da7e-55bf-8af4-8d0b76cc331e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186441603} {:answer/id #uuid "d98c6427-b31b-5669-b745-810c5329aad7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id 17592186441605} {:answer/id #uuid "f4bbcaca-d001-596d-9fe9-529dd184cce3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id 17592186441607} {:answer/id #uuid "fedc8124-d82e-59e9-81de-9b44a8c6f376" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id 17592186441610}] :answer-field/correct {:answer/id #uuid "fedc8124-d82e-59e9-81de-9b44a8c6f376" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id 17592186441610} :answer-field/id #uuid "7c819006-1c8a-567c-839e-c05698400658" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186441613}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4082a24-9ee0-5ed5-bf60-7857736d7c8e" :question/math-academy-id "q-126871" :question/problem "![](images/69/69b42001c8ac5e95e18d89785e73fbba3e78554f9146e59bb50dd618b105f10c.png)\n\nCalculate ${∮}_{∂D}4y\\,dx+5x\\,dy,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=4y$ and $Q(x,y)=5x.$ So, \n\n$$\n\\frac{∂P}{∂y}=4,\\,\\frac{∂Q}{∂x}=5.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}4y\\,dx+5x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(5-4)\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\text{d}A \\\\  & =\\text{Area}(D) \\\\  & =\\frac{4\\cdot 4}{2}-\\frac{2\\cdot 2}{2} \\\\  & =8-2 \\\\  & =6.\\end{aligned}\n$$"} {:db/id 17592186498490 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb8d995d-0d7c-54d6-8c3f-aa2cc0e562a4" :answer/type {:db/ident :answer.type/math} :answer/value "48\\pi " :db/id 17592186498216} {:answer/id #uuid "ce93c3a1-776f-5631-aafd-89bd7f33c5b6" :answer/type {:db/ident :answer.type/math} :answer/value "52\\pi " :db/id 17592186498268} {:answer/id #uuid "cfe50e10-ec80-526e-8c44-4ebed28fb715" :answer/type {:db/ident :answer.type/math} :answer/value "45\\pi " :db/id 17592186498270} {:answer/id #uuid "e1f112d4-518e-59d2-a8ae-9b7896ed80c1" :answer/type {:db/ident :answer.type/math} :answer/value "60\\pi " :db/id 17592186498304} {:answer/id #uuid "e6e01110-89b2-522a-b30e-7b877b8b16ec" :answer/type {:db/ident :answer.type/math} :answer/value "54\\pi " :db/id 17592186498308}] :answer-field/correct {:answer/id #uuid "cfe50e10-ec80-526e-8c44-4ebed28fb715" :answer/type {:db/ident :answer.type/math} :answer/value "45\\pi " :db/id 17592186498270} :answer-field/id #uuid "30362ef7-7428-53da-a7f2-7fe7cc3d3d5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186498381}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09c35a82-4469-5857-aed4-331c374b8ab3" :question/math-academy-id "q-126895" :question/problem "![](images/0d/0db447407835f74476edd20ed5327ff3cc570905f744bbc6c29a66926913ecb5.png)\n\nCalculate ${∮}_{∂D}(1-4y)\\,dx+(2+5x)\\,dy,$ where $D$ is the annular region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=1-4y$ and $Q(x,y)=2+5x.$ So,\n\n$$\n\\frac{∂P}{∂y}=-4,\\,\\frac{∂Q}{∂x}=5.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(5-(-4))\\,\\text{d}A \\\\  & ={∬}_{D}9\\,\\text{d}A \\\\  & =9\\,\\text{Area}(D) \\\\  & =9\\cdot (\\pi \\cdot {3}^{2}-\\pi \\cdot {2}^{2}) \\\\  & =9\\cdot 5\\pi  \\\\  & =45\\pi .\\end{aligned}\n$$"} {:db/id 17592186519559 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0662a46f-bec7-54ca-b240-f60d5d5f1afc" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id 17592186518998} {:answer/id #uuid "0e19b2e0-2b38-57c0-b50d-3e99a4fb345c" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id 17592186519013} {:answer/id #uuid "12efe453-d9bc-5e34-bdeb-04e1a1d22aee" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id 17592186519022} {:answer/id #uuid "a0fe6c9c-6868-551d-8a19-e70fb67ab8d4" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id 17592186519256} {:answer/id #uuid "d13ea829-20bc-5000-ad9a-b878fad5ad6b" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id 17592186519334}] :answer-field/correct {:answer/id #uuid "0662a46f-bec7-54ca-b240-f60d5d5f1afc" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id 17592186518998} :answer-field/id #uuid "69041780-f401-5aab-a5e0-f58cc39dca02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186519450}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "881df761-fca2-5afa-aea8-d6a6e63a7521" :question/math-academy-id "q-126866" :question/problem "![](images/0f/0f1dd3c66e3bf7d25f286720b360d6af1d6361804ab3ff52835d94f78e5084ee.png)\n\nCalculate ${∮}_{∂D}-3y\\,dx+2x\\,dy,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=-3y$ and $Q(x,y)=2x.$ So,\n\n$$\n\\frac{∂P}{∂y}=-3,\\,\\frac{∂Q}{∂x}=2.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}-3y\\,dx+2x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(2-(-3))\\,\\text{d}A \\\\  & ={∬}_{D}5\\,\\text{d}A \\\\  & =5{∬}_{D}\\,\\text{d}A \\\\  & =5\\cdot \\text{Area}(D) \\\\  & =5\\cdot ({4}^{2}-\\frac{2\\cdot 2}{2}) \\\\  & =5\\cdot (16-2) \\\\  & =5\\cdot 14 \\\\  & =70.\\end{aligned}\n$$"}] :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}
