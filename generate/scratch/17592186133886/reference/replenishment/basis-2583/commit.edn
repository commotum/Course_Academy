egin{aligned}{∮}_{∂D}9y\\,dx+5x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(5-9)\\,\\text{d}A \\\\  & ={∬}_{D}-4\\,\\text{d}A \\\\  & =-4{∬}_{D}\\,\\text{d}A \\\\  & =-4\\cdot \\text{Area}(D) \\\\  & =-4\\cdot (16\\cdot 12-{4}^{2}-{6}^{2}) \\\\  & =-4\\cdot (192-16-36) \\\\  & =-4\\cdot 140 \\\\  & =-560.\\end{aligned}\n$$" 13194139535896 17592186045443 true] [17592186538162 1080 "1925\\pi" 13194139535896 17592186045443 true] [17592186538162 1082 #edb/ref 17592186045498 13194139535896 17592186045443 true] [17592186538162 1083 #uuid "433dda26-4bb9-5114-b487-b99e5b406903" 13194139535896 17592186045443 true] [17592186538163 1080 "-1288" 13194139535896 17592186045443 true] [17592186538163 1082 #edb/ref 17592186045498 13194139535896 17592186045443 true] [17592186538163 1083 #uuid "45b042c5-5ebd-5d31-a6cc-baf65a7e1e9c" 13194139535896 17592186045443 true] [17592186538164 1080 "1800\\pi" 13194139535896 17592186045443 true] [17592186538164 1082 #edb/ref 17592186045498 13194139535896 17592186045443 true] [17592186538164 1083 #uuid "461804c5-46bb-5d96-af8e-d970cc58a5a1" 13194139535896 17592186045443 true] [17592186538165 1080 "492\\pi" 13194139535896 17592186045443 true] [17592186538165 1082 #edb/ref 17592186045498 13194139535896 17592186045443 true] [17592186538165 1083 #uuid "4d51d6ac-4c27-54cd-b01f-880b60999800" 13194139535896 17592186045443 true] [17592186538166 1080 "-704" 13194139535896 17592186045443 true] [17592186538166 1082 #edb/ref 17592186045498 13194139535896 17592186045443 true] [17592186538166 1083 #uuid "4f0eacde-8684-5144-862a-ff9207abd200" 13194139535896 17592186045443 true] [17592186538167 1080 "27\\pi" 13194139535896 17592186045443 true] [17592186538167 1082 #edb/ref 17592186045498 13194139535896 17592186045443 true] [17592186538167 1083 #uuid "5035e854-d3a5-5790-9eb6-eb2c68c9a904" 13194139535896 17592186045443 true] [17592186538168 1080 "1700\\pi" 13194139535896 17592186045443 true] [17592186538168 1082 #edb/ref 17592186045