, we get\n\n![](images/ec/ec5ca2469ae1fd23385b27e906cb952f6b07c2bbfe02acbc42afa20284d4a122.svg)"} :knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050567}] :knowledge-point/question-generator {:db/id #edb/ref 17592186538214 :question-generator/id #uuid "e4c2e450-4ea3-5474-8dcb-399f4aa636fe" :question-generator/script "generate/scratch/17592186133886.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186134097 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074f2b27-d82e-5431-893f-5cb420b7db07" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186130739} {:answer/id #uuid "4fb000df-3f30-5d92-833d-b570ce4d2fc0" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186130740} {:answer/id #uuid "67a5cc30-ac62-56fb-b984-6bf8c55a68e5" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186130741} {:answer/id #uuid "6d1f5867-3adf-5ebd-8085-208cd0303ff9" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186130742} {:answer/id #uuid "6da1aafe-3858-50f0-8369-80cd33a8831e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186130743}] :answer-field/correct {:answer/id #uuid "074f2b27-d82e-5431-893f-5cb420b7db07" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186130739} :answer-field/id #uuid "3d6f2a4f-8215-5cfe-aa3b-409cfed8d343" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130738}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d511ff2-5d88-51e6-9da4-d8015a261af1" :question/math-academy-id "q-126515" :question/problem "![](images/32/320a45751b2e718c66bb721cfcd78a2d206f08a9998fbbffddb1581ee995cf34.png)\n\nCalculate ${∮}_{∂D}x\\,dy-y\\,dx,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=-y$ and $Q(x,y)=x.$ So,\n\n$$\n\\frac{∂P}{∂y}=-1,\\,\\frac{∂Q}{∂x}=1.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}x\\,dy-y\\,dx & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(1-(-1))\\,\\text{d}A \\\\  & ={∬}_{D}2\\,\\text{d}A \\\\  & =2{∬}_{D}\\,\\text{d}A \\\\  & =2\\cdot \\text{Area}(D) \\\\  & =2\\cdot ({4}^{2}-{2}^{2}) \\\\  & =2\\cdot (16-4) \\\\  & =2\\cdot 12 \\\\  & =24.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186134100 :knowledge-point/_questions [{:knowledge-point/id #uuid "c67da0d8-518b-5fdb-b6ba-6c1c95c22d9b" :knowledge-point/title "Applying Green's Theorem to Regions With Holes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8672bfbf-4d4d-5253-9f83-f75552aab637" :answer/type {:db/ident :answer.type/math} :answer/value "-2π" :db/id #edb/ref 17592186130757} {:answer/id #uuid "e05949f9-9eb7-5677-b997-22c6339b8950" :answer/type {:db/ident :answer.type/math} :answer/value "6π" :db/id #edb/ref 17592186130758} {:answer/id #uuid "ffdc5cdf-d5f3-58a1-ae3b-d8584e3667be" :answer/type {:db/ident :answer.type/math} :answer/value "3π" :db/id #edb/ref 17592186130759} {:answer/id #uuid "7bf2c260-85c4-50d2-8cbc-b06eda27ff5f" :answer/type {:db/ident :answer.type/math} :answer/value 