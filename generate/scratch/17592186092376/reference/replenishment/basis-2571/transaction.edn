}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2}\\,\\mathrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\frac{\\mathrm{d}x}{\\mathrm{d}t}=\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(2 \\cos{\\left(t \\right)}\\right)=- 2 \\sin{\\left(t \\right)}\n$$\n\nand\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}t}=\\frac{\\mathrm{d}}{\\mathrm{d}t}\\left(5 t + \\cos{\\left(t \\right)}\\right)=5 - \\sin{\\left(t \\right)}.\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L&=\\int_{t_1}^{t_2}\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2}\\,\\mathrm{d}t \\\\ &=\\int_{-1}^{1}\\sqrt{\\left(- 2 \\sin{\\left(t \\right)}\\right)^2+\\left(5 - \\sin{\\left(t \\right)}\\right)^2}\\,\\mathrm{d}t \\\\ &=\\int_{-1}^{1}\\sqrt{4\\sin^2(t)+25-10\\sin(t)+\\sin^2(t)}\\,\\mathrm{d}t \\\\ &=\\int_{-1}^{1}\\sqrt{5 \\sin^{2}{\\left(t \\right)} - 10 \\sin{\\left(t \\right)} + 25}\\,\\mathrm{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["2ab4e613-7957-55a0-906b-50526e244224"] :db/ensure :question/validate} {:db/id "33f965c4-fbec-5f3e-bd10-d91dfacf69b1" :answer/id #uuid "33f965c4-fbec-5f3e-bd10-d91dfacf69b1" :answer/type :answer.type/math :answer/value "\\int_{-1}^{1}\\sqrt{\\sin^{2}{\\left(t \\right)} - 12 \\sin{\\left(t \\right)} + 36}\\,\\mathrm{d}t" :db/ensure :answer/validate} {:db/id "f0ef1627-d52e-5173-88ab-e3d2d569cba3" :answer/id #uuid "f0ef1627-d52e-5173-88ab-e3d2d569cba3" :answer/type :answer.type/math :answer/value "\\int_{-1}^{1}\\sqrt{4 \\sin^{2}{\\left(t \\right)} - 6 \\sin{\\left(t \\right)} + 36}\\,\\mathrm{d}t" :db/ensure :answer/validate} {:db/id "60669a53-3aed-5918-b3f4-8e5a84fd9f6c" :answer/id #uuid "60669a53-3aed-5918-b3f4-8e5a84fd9f6c" :answer/type :answer.type/math :answer/value "\\int_{-1}^{1}\\sqrt{6 \\sin^{2}{\\left(t \\right)} - 2 \\sin{\\left(t \\right)} + 6}\\,\\mathrm{d}t"