    "question": {
      ":question/id": "49c9315b-616a-5fca-96aa-e78fd6f59d4a",
      ":question/problem": "Given that $f(x,y)=\\sqrt[3]{{x}^{2}-y},$ then $\\frac{∂f}{∂y}=$",
      ":question/answer-fields": [
        {
          ":answer-field/id": "5165879f-2ccd-5746-b77d-c94306c9b8d9",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "12759599-516c-5d7a-9dac-25ef42efa222",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y-h)}+\\sqrt[3]{{x}^{2}-y}}{h})"
            },
            {
              ":answer/id": "693edbfb-c0f4-59d7-83aa-48228b30942a",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{lim}_{h\\to 0}(\\frac{h\\sqrt[3]{{x}^{2}-y}-\\sqrt[3]{{x}^{2}-y}}{h})"
            },
            {
              ":answer/id": "f52f3283-437c-519d-a3b6-fb7efe1e39b2",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-yh}+\\sqrt[3]{{x}^{2}-y}}{h})"
            },
            {
              ":answer/id": "d1d61ee4-0cc2-5485-823d-37ad7234ee98",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-(y+h)}-\\sqrt[3]{{x}^{2}-y}}{h})"
            },
            {
              ":answer/id": "71dd04d0-3510-5144-a27d-f7b3fdcbb4c7",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{lim}_{h\\to 0}(\\frac{\\sqrt[3]{{x}^{2}-yh}-\\sqrt[3]{{x}^{2}-y}}{h})"
