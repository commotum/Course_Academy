"e34026d0-8c07-5e65-85c3-9dc96c50dbd3" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡(x(y+h))-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436320}] :answer-field/correct {:answer/id #uuid "dd8fe9b0-2dfe-5cce-8bde-270fb503d4de" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h})" :db/id #edb/ref 17592186436318} :answer-field/id #uuid "fb776df8-d18c-56c6-b0af-71e18ee9b2ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186436329}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fab082ec-08e1-574d-8102-367e3c718114" :question/math-academy-id "q-159572" :question/problem "Given that $f(x,y)=\\operatorname{sin}⁡(xy),$ then $\\frac{∂f}{∂x}=$" :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{f(x+h,y)-f(x,y)}{h}).\n$$\n\nSince $f(x)=\\operatorname{sin}⁡(xy),$  we have that \n\n$$\nf(x+h,y)=\\operatorname{sin}⁡((x+h)y).\n$$\n\nTherefore,\n\n$$\n\\frac{∂f}{∂x}={lim}_{h\\to 0}(\\frac{\\operatorname{sin}⁡((x+h)y)-\\operatorname{sin}⁡(xy)}{h}).\n$$"} {:db/id #edb/ref 17592186562819 :knowledge-point/_questions [{:knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5e0c12-1df1-526a-96c6-ab0dd18cf612" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-2(1)^{2}(1+h))-(-2(1)^{2}(1))}{h})" :db/id #edb/ref 17592186562817} {:answer/id #uuid "54dcebd4-5b21-52a1-abea-45e80438c3b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-2(1+h)^{2}(1))-(-2(1)^{2}(1))}{h})" :db/id #edb/ref 17592186562828} {:answer/id #uuid "632579ce-df9a-5c03-80b6-219fd7dfc7c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-2(1)^{2}(1))-(-2(1+h)^{2}(1))}{h})" :db/id #edb/ref 17592186562830} {:answer/id #uuid "9fcbe737-7d67-54f0-a0af-c34445d7c218" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-2(1+h)^{2}(1+h))-(-2(1)^{2}(1))}{h})" :db/id #edb/ref 17592186562837} {:answer/id #uuid "aabfb2a7-9bda-52fd-af6a-cdfe4ba02cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-2(1+h)^{2}(1))+(-2(1)^{2}(1))}{h})" :db/id #edb/ref 17592186562838}] :answer-field/correct {:answer/id #uuid "54dcebd4-5b21-52a1-abea-45e80438c3b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-2(1+h)^{2}(1))-(-2(1)^{2}(1))}{h})" :db/id #edb/ref 17592186562828} :answer-field/id #uuid "68616b5a-bbb9-56c3-8c1b-bdbfac656417" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562833}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "133d6a6b-ec9d-5351-abbd-509a18e66f7b" :question/problem "Given that $f(x,y)=-2{y}^{2}x,$ express $f_y(1,1)$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $y$ is given by the limit\n\n$$\nf_y(1,1)=\\lim_{h\\to 0}(\\frac{f(1, 1+h)-f(1,1)}{h}).\n$$\n\nSince $f(x,y)=-2{y}^{2}x,$ we have that\n\n$$\nf(1, 1+h)=-2(1+h)^{2}(1),\\qquad f(1,1)=-2(1)^{2}(1).\n$$\n\nTherefore,\n\n$$\nf_y(1,1)=\\lim_{h\\to 0}(\\frac{(-2(1+h)^{2}(1))-(-2(1)^{2}(1))}{h}).\n$$\n\nHere $h\\ne 0$ before taking the limit, and $x=1$ is held constant."} {:db/id #edb/ref 17592186562824 :knowledge-point/_questions [{:knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6c1947-d835-5c18-a01c-a8f81e230e0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-3(-2)^{2}(-2+h))-(-3(-2)^{2}(-2))}{h})" :db/id #edb/ref 17592186562822} {:answer/id #uuid "65c76a03-53cd-5585-99f3-7193eb83af98" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-3(-2+h)^{2}(-2+h))-(-3(-2)^{2}(-2))}{h})" :db/id #edb/ref 17592186562831} {:answer/id #uuid "6609cbc2-741d-54fb-ac98-8aebd8de56e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-3(-2+h)^{2}(-2))-(-3(-2)^{2}(-2))}{h})" :db/id #edb/ref 17592186562832} {:answer/id #uuid "b0aae4cc-928f-57bf-8b77-9a2911c3a705" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-3(-2)^{2}(-2))-(-3(-2+h)^{2}(-2))}{h})" :db/id #edb/ref 17592186562840} {:answer/id #uuid "ed53f686-6565-5dc4-b9f1-ccc38b09f217" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-3(-2+h)^{2}(-2))+(-3(-2)^{2}(-2))}{h})" :db/id #edb/ref 17592186562849}] :answer-field/correct {:answer/id #uuid "6609cbc2-741d-54fb-ac98-8aebd8de56e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(-3(-2+h)^{2}(-2))-(-3(-2)^{2}(-2))}{h})" :db/id #edb/ref 17592186562832} :answer-field/id #uuid "0cae743a-d164-5395-a90d-ce6590411561" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562816}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "33532890-70b2-5090-87ea-44260978f50e" :question/problem "Given that $f(x,y)=-3{x}^{2}y,$ express $f_x(-2,-2)$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit\n\n$$\nf_x(-2,-2)=\\lim_{h\\to 0}(\\frac{f(-2+h, -2)-f(-2,-2)}{h}).\n$$\n\nSince $f(x,y)=-3{x}^{2}y,$ we have that\n\n$$\nf(-2+h, -2)=-3(-2+h)^{2}(-2),\\qquad f(-2,-2)=-3(-2)^{2}(-2).\n$$\n\nTherefore,\n\n$$\nf_x(-2,-2)=\\lim_{h\\to 0}(\\frac{(-3(-2+h)^{2}(-2))-(-3(-2)^{2}(-2))}{h}).\n$$\n\nHere $h\\ne 0$ before taking the limit, and $y=-2$ is held constant."} {:db/id #edb/ref 17592186562826 :knowledge-point/_questions [{:knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ded65f-6e9b-5abc-af2a-f6ea15ffbc0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(-1+h)^{2}(-1+h))-(1(-1)^{2}(-1))}{h})" :db/id #edb/ref 17592186562818} {:answer/id #uuid "1c3853fb-b9f6-5eb0-8abe-3badc14e5532" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(-1+h)^{2}(-1))-(1(-1)^{2}(-1))}{h})" :db/id #edb/ref 17592186562821} {:answer/id #uuid "5c39a581-ebf6-5756-a15b-ee8d27855840" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(-1)^{2}(-1))-(1(-1+h)^{2}(-1))}{h})" :db/id #edb/ref 17592186562829} {:answer/id #uuid "d02c0bbd-88f0-558c-ace0-1036b9f87d32" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(-1+h)^{2}(-1))+(1(-1)^{2}(-1))}{h})" :db/id #edb/ref 17592186562845} {:answer/id #uuid "f47c17a0-6a4a-5ef5-bdcd-1970900507b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(-1)^{2}(-1+h))-(1(-1)^{2}(-1))}{h})" :db/id #edb/ref 17592186562850}] :answer-field/correct {:answer/id #uuid "1c3853fb-b9f6-5eb0-8abe-3badc14e5532" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(-1+h)^{2}(-1))-(1(-1)^{2}(-1))}{h})" :db/id #edb/ref 17592186562821} :answer-field/id #uuid "4c86581d-680b-586d-acbc-3448ad4ff62a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562827}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4ab0bfc6-d8ee-5e0d-9b62-1ad460fd0c69" :question/problem "Given that $f(x,y)=1{x}^{2}y,$ express $f_x(-1,-1)$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit\n\n$$\nf_x(-1,-1)=\\lim_{h\\to 0}(\\frac{f(-1+h, -1)-f(-1,-1)}{h}).\n$$\n\nSince $f(x,y)=1{x}^{2}y,$ we have that\n\n$$\nf(-1+h, -1)=1(-1+h)^{2}(-1),\\qquad f(-1,-1)=1(-1)^{2}(-1).\n$$\n\nTherefore,\n\n$$\nf_x(-1,-1)=\\lim_{h\\to 0}(\\frac{(1(-1+h)^{2}(-1))-(1(-1)^{2}(-1))}{h}).\n$$\n\nHere $h\\ne 0$ before taking the limit, and $y=-1$ is held constant."} {:db/id #edb/ref 17592186562835 :knowledge-point/_questions [{:knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "142263e2-ffc1-5971-aab7-a78e8fb89d3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2+h)(3)))-(\\operatorname{sin}((2)(3)))}{h})" :db/id #edb/ref 17592186562820} {:answer/id #uuid "3882cc29-e493-5280-8251-94acc6ea11be" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2+h)(3+h)))-(\\operatorname{sin}((2)(3)))}{h})" :db/id #edb/ref 17592186562825} {:answer/id #uuid "6b6269b9-5085-5358-b7f7-9136abf836c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2+h)(3)))+(\\operatorname{sin}((2)(3)))}{h})" :db/id #edb/ref 17592186562834} {:answer/id #uuid "cc0c1ad0-0809-5caa-abd0-3c394f9b2ffc" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2)(3+h)))-(\\operatorname{sin}((2)(3)))}{h})" :db/id #edb/ref 17592186562844} {:answer/id #uuid "d6d16f5b-c575-532b-8e3a-633aa682efa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2)(3)))-(\\operatorname{sin}((2+h)(3)))}{h})" :db/id #edb/ref 17592186562847}] :answer-field/correct {:answer/id #uuid "142263e2-ffc1-5971-aab7-a78e8fb89d3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2+h)(3)))-(\\operatorname{sin}((2)(3)))}{h})" :db/id #edb/ref 17592186562820} :answer-field/id #uuid "c0a173b9-7073-5910-96e4-56dae5d5791d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562842}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77fe6685-0db5-512c-a146-7a7385d90d5f" :question/problem "Given that $f(x,y)=\\operatorname{sin}(xy),$ express $f_x(2,3)$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit\n\n$$\nf_x(2,3)=\\lim_{h\\to 0}(\\frac{f(2+h, 3)-f(2,3)}{h}).\n$$\n\nSince $f(x,y)=\\operatorname{sin}(xy),$ we have that\n\n$$\nf(2+h, 3)=\\operatorname{sin}((2+h)(3)),\\qquad f(2,3)=\\operatorname{sin}((2)(3)).\n$$\n\nTherefore,\n\n$$\nf_x(2,3)=\\lim_{h\\to 0}(\\frac{(\\operatorname{sin}((2+h)(3)))-(\\operatorname{sin}((2)(3)))}{h}).\n$$\n\nHere $h\\ne 0$ before taking the limit, and $y=3$ is held constant."} {:db/id #edb/ref 17592186562843 :knowledge-point/_questions [{:knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d025d8c-206e-577a-a3ad-a8da0363314c" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(1)^{2}(2+h))-(1(1)^{2}(2))}{h})" :db/id #edb/ref 17592186562823} {:answer/id #uuid "9416a5b0-a192-5671-a21f-bcca2b4b0fd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(1+h)^{2}(2))+(1(1)^{2}(2))}{h})" :db/id #edb/ref 17592186562836} {:answer/id #uuid "accb26f0-00d4-5fc7-86a2-9d0fe347e524" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(1+h)^{2}(2))-(1(1)^{2}(2))}{h})" :db/id #edb/ref 17592186562839} {:answer/id #uuid "bd4d3e99-65ec-5e5e-9088-f66e5c8b3c07" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(1+h)^{2}(2+h))-(1(1)^{2}(2))}{h})" :db/id #edb/ref 17592186562841} {:answer/id #uuid "d0c9afb2-f2db-51a6-a151-fef4c0837b25" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(1)^{2}(2))-(1(1+h)^{2}(2))}{h})" :db/id #edb/ref 17592186562846}] :answer-field/correct {:answer/id #uuid "accb26f0-00d4-5fc7-86a2-9d0fe347e524" :answer/type {:db/ident :answer.type/math} :answer/value "\\lim_{h\\to 0}(\\frac{(1(1+h)^{2}(2))-(1(1)^{2}(2))}{h})" :db/id #edb/ref 17592186562839} :answer-field/id #uuid "dc00fb68-9f58-5d35-9fbc-d613f762f54e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562848}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c62e1658-4438-5b1a-b0a2-228bb5838b57" :question/problem "Given that $f(x,y)=1{x}^{2}y,$ express $f_x(1,2)$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit\n\n$$\nf_x(1,2)=\\lim_{h\\to 0}(\\frac{f(1+h, 2)-f(1,2)}{h}).\n$$\n\nSince $f(x,y)=1{x}^{2}y,$ we have that\n\n$$\nf(1+h, 2)=1(1+h)^{2}(2),\\qquad f(1,2)=1(1)^{2}(2).\n$$\n\nTherefore,\n\n$$\nf_x(1,2)=\\lim_{h\\to 0}(\\frac{(1(1+h)^{2}(2))-(1(1)^{2}(2))}{h}).\n$$\n\nHere $h\\ne 0$ before taking the limit, and $y=2$ is held constant."}] :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}]}
