{8}{9}.$\n\nFinally, knowing that $cot⁡\\theta =\\frac{cos⁡\\theta }{sin⁡\\theta },$ we have\n\n$$\ncot⁡\\theta =\\frac{(\\frac{\\sqrt{17}}{9})}{(\\frac{8}{9})}=\\frac{\\sqrt{17}}{8}.\n$$"} {:db/id #edb/ref 17592186510727 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249f6d39-c352-5b6e-b0a3-aad8dbe4af0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{43}}{6}" :db/id #edb/ref 17592186510728} {:answer/id #uuid "40e4413d-62c5-5cf3-8a6d-bc0951e1d6d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{83}}{6}" :db/id #edb/ref 17592186510731} {:answer/id #uuid "9ae139e3-a55e-5972-9da7-3d735e750073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{3}" :db/id #edb/ref 17592186510738} {:answer/id #uuid "cf16047a-f770-52e9-8ba0-da97bd2d6088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{258}}{6}" :db/id #edb/ref 17592186510745} {:answer/id #uuid "eaa164a1-1ef9-5a0d-9231-f146dcc770a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{258}}{43}" :db/id #edb/ref 17592186510747}] :answer-field/correct {:answer/id #uuid "cf16047a-f770-52e9-8ba0-da97bd2d6088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{258}}{6}" :db/id #edb/ref 17592186510745} :answer-field/id #uuid "af481ffe-765a-562a-87bb-3829101afbf0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2014768a-a233-5eee-b9c5-afc2675420b0" :question/problem "![](images/cc/ccdb5bb029197875aaeebfc899dff4d25597b657e64ea95d1b34d09df0a37789.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{43}}{7},$ use the Pythagorean identity to find $tan⁡\\theta .$" :question/worked-solution "![](images/af/af413350ef3c9edde0eebf49cb8f37c8b20791f4bb01e04adaacaa0c378d28a1.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{43}}{7}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{43}}{7}.\n$$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{43}}{7}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{\\sqrt{43}}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{43}{49}} \\\\  & =\\pm \\sqrt{\\frac{6}{49}} \\\\  & =\\pm \\frac{\\sqrt{6}}{7}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the first quadrant. So, $cos⁡\\theta =\\frac{\\sqrt{6}}{7}.$\n\nKnowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{(\\frac{\\sqrt{43}}{7})}{(\\frac{\\sqrt{6}}{7})}=\\frac{\\sqrt{43}}{\\sqrt{6}}.\n$$\n\nFinally, we rationalize the denominator.\n\n$$\n\\begin{aligned}tan⁡\\theta  & =\\frac{\\sqrt{43}}{\\sqrt{6}} \\\\  & =\\frac{\\sqrt{43}}{\\sqrt{6}}\\cdot \\frac{\\sqrt{6}}{\\sqrt{6}} \\\\  & =\\frac{\\sqrt{43\\cdot 6}}{6} \\\\  & =\\frac{\\sqrt{258}}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186510730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1909811c-da8d-539b-aa89-cdc5b420a83f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{7}" :db/id #edb/ref 17592186510725} {:answer/id #uuid "2fc3517e-1300-5538-b247-d948b579f7f3" :answer/type {:db/id 