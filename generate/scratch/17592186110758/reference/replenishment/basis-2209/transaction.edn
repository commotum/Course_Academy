cdot 10}}{10} \\\\  & =\\frac{\\sqrt{390}}{10}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["89a72e76-dfbf-51a2-96d4-d8c440244cee"] :db/ensure :question/validate} {:db/id "40e4413d-62c5-5cf3-8a6d-bc0951e1d6d2" :answer/id #uuid "40e4413d-62c5-5cf3-8a6d-bc0951e1d6d2" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{83}}{6}" :db/ensure :answer/validate} {:db/id "9ae139e3-a55e-5972-9da7-3d735e750073" :answer/id #uuid "9ae139e3-a55e-5972-9da7-3d735e750073" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{11}}{3}" :db/ensure :answer/validate} {:db/id "eaa164a1-1ef9-5a0d-9231-f146dcc770a4" :answer/id #uuid "eaa164a1-1ef9-5a0d-9231-f146dcc770a4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{258}}{43}" :db/ensure :answer/validate} {:db/id "249f6d39-c352-5b6e-b0a3-aad8dbe4af0e" :answer/id #uuid "249f6d39-c352-5b6e-b0a3-aad8dbe4af0e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{43}}{6}" :db/ensure :answer/validate} {:db/id "cf16047a-f770-52e9-8ba0-da97bd2d6088" :answer/id #uuid "cf16047a-f770-52e9-8ba0-da97bd2d6088" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{258}}{6}" :db/ensure :answer/validate} {:db/id "af481ffe-765a-562a-87bb-3829101afbf0" :answer-field/id #uuid "af481ffe-765a-562a-87bb-3829101afbf0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["40e4413d-62c5-5cf3-8a6d-bc0951e1d6d2" "9ae139e3-a55e-5972-9da7-3d735e750073" "eaa164a1-1ef9-5a0d-9231-f146dcc770a4" "249f6d39-c352-5b6e-b0a3-aad8dbe4af0e" "cf16047a-f770-52e9-8ba0-da97bd2d6088"] :answer-field/correct "cf16047a-f770-52e9-8ba0-da97bd2d6088" :db/ensure :answer-field/validate} {:db/id "2014768a-a233-5eee-b9c5-afc2675420b0" :question/id #uuid "2014768a-a233-5eee-b9c5-afc2675420b0" :question/problem "![](images/cc/ccdb5bb029197875aaeebfc899dff4d25597b657e64ea95d1b34d09df0a37789.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate