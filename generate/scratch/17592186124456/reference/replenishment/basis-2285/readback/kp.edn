3-526b-9513-6282f7765087" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521769} :answer-field/id #uuid "18c70ce8-f1f7-5bbc-adca-e3c29eed1cca" :answer-field/key "IV" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521764} {:answer-field/choices [{:answer/id #uuid "37b9e260-94cc-5539-a762-ef0c781c432d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521784} {:answer/id #uuid "a312f786-15df-5b00-91b3-215f9c7e7a71" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521830}] :answer-field/correct {:answer/id #uuid "a312f786-15df-5b00-91b3-215f9c7e7a71" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521830} :answer-field/id #uuid "3de24a5f-af67-5551-918b-272cb93832bb" :answer-field/key "VI" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521788} {:answer-field/choices [{:answer/id #uuid "25dc062e-44f5-5471-a146-179e82acfe66" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186521772} {:answer/id #uuid "2a4d2807-65a8-535d-b28f-d716f496cbc5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521773}] :answer-field/correct {:answer/id #uuid "2a4d2807-65a8-535d-b28f-d716f496cbc5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186521773} :answer-field/id #uuid "f01ae0ea-77c1-50d9-838c-8c96b77ae81a" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186521869}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0a0a0dc-dc0e-505f-ae57-9fc7b81e15fb" :question/problem "At which points on the curve $4 x y + 2 y^{2}=4 x^{2} + 48$ is the tangent vector to the curve perpendicular to the vector $j$?\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-2,-4)$\n- **II.** $(0,4)$\n- **III.** $(1,4)$\n- **IV.** $(2,0)$\n- **V.** $(2,2)$\n- **VI.** $(2,4)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\\begin{aligned}4 x y + 2 y^{2}&=4 x^{2} + 48\\\\- 4 x^{2} + 4 x y + 2 y^{2} - 48&=0\\end{aligned}$$\n\nIf we set $f(x,y)=- 4 x^{2} + 4 x y + 2 y^{2} - 48$, our curve can be viewed as the level curve $f(x,y)=0.$\n\nA tangent vector to the level curve can be computed as follows:\n\n$$t(x,y)=f_y(x,y)\\,i-f_x(x,y)\\,j$$\n\nSo, we calculate $t(x,y):$\n\n$$\\begin{aligned}t(x,y)&=\\frac{∂}{∂y}(- 4 x^{2} + 4 x y + 2 y^{2} - 48)\\,i-\\frac{∂}{∂x}(- 4 x^{2} + 4 x y + 2 y^{2} - 48)\\,j\\\\&=(4 x + 4 y)\\,i-(- 8 x + 4 y)\\,j\\end{aligned}$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\\begin{aligned}t(x,y)\\cdot j&=0\\\\8 x - 4 y&=0\\\\y&=2x\\end{aligned}$$\n\nSubstituting $y=2x$ into the equation of our curve gives:\n\n$$\\begin{aligned}2(2x)^{2}+4x(2x)-4x^{2}-48&=0\\\\12x^{2}-48&=0\\\\x^{2}&=4\\\\x&=\\pm 2\\end{aligned}$$\n\nFinally, the corresponding points are $(2,4)$ and $(-2,-4)$."}] :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}]}
