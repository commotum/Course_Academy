ype/text} :answer/value "true" :db/id 17592186439942}] :answer-field/correct {:answer/id #uuid "93414178-3753-5420-b4b6-1ac48e45c3b5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439941} :answer-field/id #uuid "c37025ed-9888-5ac7-953f-6d2173c4ec86" :answer-field/key "V" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440328} {:answer-field/choices [{:answer/id #uuid "e0e94f97-83d4-55d1-a4fe-2eecc3c33c28" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439943} {:answer/id #uuid "f2b286d5-0094-5d27-8122-cf59c572339d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439944}] :answer-field/correct {:answer/id #uuid "e0e94f97-83d4-55d1-a4fe-2eecc3c33c28" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439943} :answer-field/id #uuid "1a071a57-c0a2-5ff5-8488-5bd97002af7b" :answer-field/key "VI" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440329} {:answer-field/choices [{:answer/id #uuid "c7f8d1ef-4d2a-52c3-97a7-ce498c4ce11b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439945} {:answer/id #uuid "35e5554f-349d-51bb-9ccd-94b46e947c71" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439946}] :answer-field/correct {:answer/id #uuid "c7f8d1ef-4d2a-52c3-97a7-ce498c4ce11b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439945} :answer-field/id #uuid "d02f2705-c6d5-5710-8589-44dd2b88e45c" :answer-field/key "VII" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440330}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5577e429-0d55-5dd4-b588-49ac727edd6b" :question/math-academy-id "q-72440" :question/problem "At which points on the curve ${x}^{2}+2xy=-5y+4$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-4,1)$\n- **II.** $(-4,4)$\n- **III.** $(-2,4)$\n- **IV.** $(-1,1)$\n- **V.** $(-1,4)$\n- **VI.** $(1,1)$\n- **VII.** $(4,-4)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+2xy & =-5y+4 \\\\ {x}^{2}+2xy+5y & =4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+2xy+5y$, our curve can be viewed as the level curve $f(x,y)=4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+2xy+5y)i-\\frac{∂}{∂x}({x}^{2}+2xy+5y)j \\\\  & =(2x+5)\\,i-(2x+2y)\\,j\\end{aligned}\n$$\n\n  \n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+5)\\,i-(2x+2y)\\,j)\\cdot j & =0 \\\\ -(2x+2y) & =0 \\\\ x & =-y\\end{aligned}\n$$\n\nSubstituting $x=-y$ into the equation of our curve gives:    \n\n$$\n\\begin{aligned}{x}^{2}+2xy+5y & =4 \\\\ (-y)^{2}+2(-y)y+5y & =4 \\\\ {y}^{2}-2{y}^{2}+5y & =4 \\\\ -{y}^{2}+5y-4 & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0 \\\\ y & =1\\,\\text{or}\\,y=4\\end{aligned}\n$$\n\nFinally:\n\n- If $y=1$, we get $x=-1$ and the corresponding point is $(-1,1).$\n\n- If $y=4$, we get $x=-4$ and the corresponding point is $(-4,4).$"} {:db/id 17592186364316 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4b0f044-128c-5f1b-aa69-2500dbaf5ea2" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1)$ and $(0,-3)$" :db/id 17592186364318} {:answer/id #uuid "bdd3ddf3-f39a-5e23-9542-809cca8045dd" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(-1,-3)$" :db/id 17592186364319} {:answer/id #uuid "cd3c3702-cba3-57ad-b3e0-2c994913bd41" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,3)$ and $(0,-3)$" :db/id 17592186364320} {:answer/id #uuid "71ef2f17-55ba-507e-8bbc-fc7b6bfebfc5" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,0)$ and $(-1,0)$" :db/id 17592186364321} {:answer/id #uuid "9e254c1d-c4f8-51bc-9734-35d90904ed56" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ and $(1,-3)$" :db/id 17592186364322}] :answer-field/correct {:answer/id #uuid "bdd3ddf3-f39a-5e23-9542-809cca8045dd" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(-1,-3)$" :db/id 17592186364319} :answer-field/id #uuid "e462412c-3cbc-5541-9147-125fc8a64b29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186364317}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "32727d15-71dd-5c57-93a9-b5f15381c7c6" :question/math-academy-id "q-72416" :question/problem "At which points on the curve $2xy-3{x}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2xy-3{x}^{2}=-y \\\\ 2xy-3{x}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2xy-3{x}^{2}+y$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2xy-3{x}^{2}+y)i-\\frac{∂}{∂x}(2xy-3{x}^{2}+y)j \\\\  & =(2x+1)\\,i-2(y-3x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+1)\\,i-2(y-3x)\\,j)\\cdot j & =0 \\\\ -2(y-3x) & =0 \\\\ y & =3x\\end{aligned}\n$$\n\nSubstituting $y=3x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}2xy-3{x}^{2}+y & =0 \\\\ 2x(3x)-3{x}^{2}+3x & =0 \\\\ 6{x}^{2}-3{x}^{2}+3x & =0 \\\\ 3{x}^{2}+3x & =0 \\\\ 3x(x+1) & =0 \\\\ x & =0\\,\\text{or}\\,x=-1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=0$, we get $y=0$ and the corresponding point is $(0,0).$\n\n- If $x=-1$, we get $y=-3$ and the corresponding point is $(-1,-3).$"} {:db/id 17592186373757 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbb76f8-a135-56ab-98ff-95aa371de6bc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439519} {:answer/id #uuid "8c88915e-5b21-5b50-b76c-b452eb74095d" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439520}] :answer-field/correct {:answer/id #uuid "afbb76f8-a135-56ab-98ff-95aa371de6bc" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439519} :answer-field/id #uuid "cb7991eb-11ab-5be8-9cff-8cb4c831a986" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440117} {:answer-field/choices [{:answer/id #uuid "bee1c3fd-7f28-5bd0-8439-264f31d9f15a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439521} {:answer/id #uuid "aba6457d-6ee5-5643-8c8f-eae80358d7d4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439522}] :answer-field/correct {:answer/id #uuid "aba6457d-6ee5-5643-8c8f-eae80358d7d4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439522} :answer-field/id #uuid "f05aaa51-707b-51f8-bed1-c062eb9077c6" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440118} {:answer-field/choices [{:answer/id #uuid "049822ce-ef15-5b5d-9864-ade62a37ec43" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439523} {:answer/id #uuid "60358451-984b-5b61-929f-f92074afc976" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439524}] :answer-field/correct {:answer/id #uuid "60358451-984b-5b61-929f-f92074afc976" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439524} :answer-field/id #uuid "24967753-af42-5895-a050-8e8c6b225ad6" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440119} {:answer-field/choices [{:answer/id #uuid "6a274467-574a-5539-983e-4d583bc9ec92" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439525} {:answer/id #uuid "65a64ec9-6cdd-507e-9bfb-590aab6a8b2f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439526}] :answer-field/correct {:answer/id #uuid "6a274467-574a-5539-983e-4d583bc9ec92" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439525} :answer-field/id #uuid "ed98d8f5-235d-543c-a23d-ff763ed379a9" :answer-field/key "IV" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440120}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d9c5851-2645-50db-8b4e-b731824fd7d9" :question/math-academy-id "q-130225" :question/problem "At which points on the curve $2{x}^{2}-3{y}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,1)$\n- **II.** $(0,0)$\n- **III.** $(0,\\frac{1}{3})$\n- **IV.** $(1,1)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2{x}^{2}-3{y}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-3{y}^{2}+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2}+y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2}+y)\\,j \\\\  & =(-6y+1)\\,i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((-6y+1)\\,i-4x\\,j)\\cdot j & =0 \\\\ -4x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nSubstituting $x=0$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2({0}^{2})-3{y}^{2} & =-y \\\\ 3{y}^{2}-y & =0 \\\\ y(3y-1) & =0 \\\\ y & =0,\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, the corresponding points are $(0,0)$ and $(0,\\frac{1}{3}).$"} {:db/id 17592186375335 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27399e42-4acc-553e-ba4e-5998ae4da3e8" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-2)$ and $(0,1)$" :db/id 17592186375337} {:answer/id #uuid "a57c1eee-a86d-5c18-9d82-3d9e99558aee" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(1,0)$" :db/id 17592186375338} {:answer/id #uuid "bfb1fb31-2625-5bc1-9263-d7661c3e1d2b" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and $(2,0)$" :db/id 17592186375339} {:answer/id #uuid "ec3841f3-4849-5ca6-b655-2344b4b09e89" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-2)$ and $(1,0)$" :db/id 17592186375340} {:answer/id #uuid "30f0e009-0c6d-57a0-b587-090a0c1d88bd" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,0)$" :db/id 17592186375341}] :answer-field/correct {:answer/id #uuid "30f0e009-0c6d-57a0-b587-090a0c1d88bd" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,0)$" :db/id 17592186375341} :answer-field/id #uuid "079e80ed-3676-528f-b478-841f2caa3b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186375336}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "703e7046-bcfc-54c8-9bb1-c367d4d9ddb7" :question/math-academy-id "q-72427" :question/problem "At which points on the curve ${y}^{2}+2x=2xy+2y-2$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2x & =2xy+2y-2 \\\\ {y}^{2}+2x-2xy-2y & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2x-2xy-2y$, our curve can be viewed as the level curve $f(x,y)=-2.$  \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2x-2xy-2y)i-\\frac{∂}{∂x}({y}^{2}+2x-2xy-2y)j \\\\  & =(2y-2x-2)\\,i-(2-2y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2y-2x-2)\\,i-(2-2y)\\,j)\\cdot i & =0 \\\\ 2y-2x-2 & =0 \\\\ 2(y-x-1) & =0 \\\\ y & =x+1\\end{aligned}\n$$\n\nSubstituting $y=x+1$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2x-2xy-2y & =-2 \\\\ (x+1)^{2}+2x-2x(x+1)-2(x+1)+2 & =0 \\\\ (x+1)^{2}-2x(x+1)-2(x+1)+2(x+1) & =0 \\\\ (x+1)^{2}-2x(x+1)-\\cancel{2(x+1)}+\\cancel{2(x+1)} & =0 \\\\ (x+1)^{2}-2x(x+1) & =0 \\\\ (x+1)(x+1-2x) & =0 \\\\ (x+1)(-x+1) & =0 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=1$, we get $y=2$ and the corresponding point is $(1,2).$\n\n- If $x=-1$, we get $y=0$ and the corresponding point is $(-1,0).$"} {:db/id 17592186388083 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f4e581-a00c-5132-927c-1585f2f16335" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id 17592186388085} {:answer/id #uuid "a25cb316-03e0-5b80-b36c-bf23e9ecd400" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-\\frac{7}{8})" :db/id 17592186388086} {:answer/id #uuid "7ce509f6-676c-5142-b2e8-6b75044a4ae3" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-1)" :db/id 17592186388087} {:answer/id #uuid "56675fa5-8d6f-5214-9ce9-5265d8d72af6" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id 17592186388088} {:answer/id #uuid "5bff0bff-8fcd-5363-b279-0ef233e06a17" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{2},-\\frac{1}{2})" :db/id 17592186388089}] :answer-field/correct {:answer/id #uuid "a25cb316-03e0-5b80-b36c-bf23e9ecd400" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-\\frac{7}{8})" :db/id 17592186388086} :answer-field/id #uuid "368f7e81-de7f-51a5-98fc-f718da4aa1b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186388084}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f930a915-2d68-50d6-9185-efb4889fde3f" :question/math-academy-id "q-130209" :question/problem "At which point on the curve $2{x}^{2}=y+1$ is the tangent vector to the curve perpendicular to the vector $i+j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2} & =y+1 \\\\ 2{x}^{2}-y & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-y,$ our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-y)\\,j \\\\  & =-i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i+j,$ we must have $t\\cdot (i+j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (i+j) & =0 \\\\ (-i-4x\\,j)\\cdot (i+j) & =0 \\\\ -1-4x & =0 \\\\ x & =-\\frac{1}{4}\\end{aligned}\n$$\n\nSubstituting $x=-\\frac{1}{4}$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2} & =y+1 \\\\ 2{(-\\frac{1}{4})}^{2} & =y+1 \\\\ \\frac{1}{8} & =y+1 \\\\ y & =-\\frac{7}{8}.\\end{aligned}\n$$\n\nFinally, the corresponding point is $(-\\frac{1}{4},-\\frac{7}{8}).$"} {:db/id 17592186400450 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3f9a2e3-bee8-5b1b-b1c5-43ca27a9ee8a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439511} {:answer/id #uuid "f628d092-8784-5d3d-b54f-458bd5beb768" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439512}] :answer-field/correct {:answer/id #uuid "e3f9a2e3-bee8-5b1b-b1c5-43ca27a9ee8a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439511} :answer-field/id #uuid "d87136b4-f54f-5a06-86b5-cf63e992b1d1" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440113} {:answer-field/choices [{:answer/id #uuid "12fafdc0-e4b2-52e6-ae9c-99cc3b27a59b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439513} {:answer/id #uuid "d4b5298a-472b-5545-8b69-e594bf8766ea" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439514}] :answer-field/correct {:answer/id #uuid "d4b5298a-472b-5545-8b69-e594bf8766ea" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439514} :answer-field/id #uuid "4d688553-f546-5705-b1b5-e8fa688d5ccc" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440114} {:answer-field/choices [{:answer/id #uuid "d89573c1-b7fc-57e0-b937-a941c611e3b9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439515} {:answer/id #uuid "5a2526f8-dbfa-54f5-953e-68b316490ad0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439516}] :answer-field/correct {:answer/id #uuid "5a2526f8-dbfa-54f5-953e-68b316490ad0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439516} :answer-field/id #uuid "0da4e8cd-a37a-575d-b740-45d4e50ce9a5" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440115} {:answer-field/choices [{:answer/id #uuid "dcee5b74-6097-5de5-a2f9-1ef377001ba6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439517} {:answer/id #uuid "cc9ac649-f4ee-5a5e-aa1e-4df3984df146" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id 17592186439518}] :answer-field/correct {:answer/id #uuid "dcee5b74-6097-5de5-a2f9-1ef377001ba6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id 17592186439517} :answer-field/id #uuid "c9513575-9539-55dd-8564-2815f12cfbf6" :answer-field/key "IV" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id 17592186440116}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6851bbc7-80d6-5dc9-8a00-f559624fa12f" :question/math-academy-id "q-130217" :question/problem "At which points on the curve ${x}^{2}+{y}^{2}=2y-2x$ is the tangent vector to the curve perpendicular to the vector $-i+j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-2,0)$\n- **II.** $(-2,2)$\n- **III.** $(0,0)$\n- **IV.** $(0,2)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2y-2x \\\\ {x}^{2}+{y}^{2}+2x-2y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+{y}^{2}+2x-2y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+{y}^{2}+2x-2y)\\,i-\\frac{∂}{∂x}({x}^{2}+{y}^{2}+2x-2y)\\,j \\\\  & =(2y-2)\\,i-(2x+2)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $-i+j,$ we must have $t\\cdot (-i+j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (-i+j) & =0 \\\\ ((2y-2)\\,i-(2x+2)\\,j)\\cdot (-i+j) & =0 \\\\ -(2y-2)-(2x+2) & =0 \\\\ -2y-2x & =0 \\\\ y & =-x\\end{aligned}\n$$\n\nSubstituting $y=-x$ into the equation of our curve gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =2y-2x \\\\ {x}^{2}+(-x)^{2} & =2(-x)-2x \\\\ 2{x}^{2} & =-4x \\\\ 2{x}^{2}+4x & =0 \\\\ 2x(x+2) & =0 \\\\ x & =-2,0.\\end{aligned}\n$$\n\nFinally:\n\n- For $x=-2,$ we get $y=2,$ and the corresponding point is $(-2,2).$\n\n- For $x=0,$ we get $y=0,$ and the corresponding point is $(0,0).$"} {:db/id 17592186403571 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3b898a6-e9f5-51f8-8993-b6f0322af5e6" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,2)$ and $(-1,3)$" :db/id 17592186403573} {:answer/id #uuid "3acac861-9675-5531-8e0f-29301bd84beb" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1)$ and $(-1,-1)$" :db/id 17592186403574} {:answer/id #uuid "879099ba-26c3-5eca-b156-1546984f09e1" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,-2)$" :db/id 17592186403575} {:answer/id #uuid "56e7a278-62d5-5448-adb4-7672d93764ee" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(1,-2)$" :db/id 17592186403576} {:answer/id #uuid "c66b876c-2af7-5756-8122-0570c4918dbd" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,3)$ and $(3,-2)$" :db/id 17592186403577}] :answer-field/correct {:answer/id #uuid "879099ba-26c3-5eca-b156-1546984f09e1" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ and $(-1,-2)$" :db/id 17592186403575} :answer-field/id #uuid "22c59322-d13f-5287-a0fa-c2f86091a95e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186403572}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "49dc4b38-854b-53b5-ba44-1bf47c27ef1c" :question/math-academy-id "q-72412" :question/problem "At which points on the curve ${y}^{2}-4xy=-5{x}^{2}+1$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}-4xy & =-5{x}^{2}+1 \\\\ {y}^{2}-4xy+5{x}^{2} & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}-4xy+5{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}-4xy+5{x}^{2})i-\\frac{∂}{∂x}({y}^{2}-4xy+5{x}^{2})j \\\\  & =2(y-2x)\\,i-(10x-4y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ (2(y-2x)\\,i-(10x-4y)\\,j)\\cdot i & =0 \\\\ 2(y-2x) & =0 \\\\ y & =2x\\end{aligned}\n$$\n\nSubstituting $y=2x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}-4xy+5{x}^{2} & =1 \\\\ (2x)^{2}-4x(2x)+5{x}^{2} & =1 \\\\ 4{x}^{2}-8{x}^{2}+5{x}^{2} & =1 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nFinally:\n\n- If $x=1$, we get $y=2$ and the corresponding point is $(1,2).$\n\n- If $x=-1$, we get $y=-2$ and the corresponding point is $(-1,-2).$"} {:db/id 17592186447371 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "269f786d-89ec-5cd5-a946-ff7a25f5bfdc" :answer/type {:db/ident :answer.type/math} :answer/value "(2,1)" :db/id 17592186447331} {:answer/id #uuid "64cdcf40-7d0f-5cd1-9631-68535525b11a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id 17592186447337} {:answer/id #uuid "9652c686-4a06-5958-9b68-3ac0c59d9c39" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},-1)" :db/id 17592186447342} {:answer/id #uuid "c6b197ac-be86-5a79-bafe-30616fa5194f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5+\\sqrt{5}}{2},\\sqrt{5})" :db/id 17592186447349} {:answer/id #uuid "f223ad97-8210-5437-a5b5-584c17f1bb93" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{5}+1}{2},1)" :db/id 17592186447359}] :answer-field/correct {:answer/id #uuid "64cdcf40-7d0f-5cd1-9631-68535525b11a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id 17592186447337} :answer-field/id #uuid "4746e6c2-e2ff-5920-bf56-69cc85ac1d10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186447366}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2ac861e6-ea7e-53f0-b9c2-bba93cd70561" :question/math-academy-id "q-130227" :question/problem "At which point on the curve ${x}^{2}-{y}^{2}=xy$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =xy \\\\ {x}^{2}-{y}^{2}-xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}-{y}^{2}-xy,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}-{y}^{2}-xy)\\,i-\\frac{∂}{∂x}({x}^{2}-{y}^{2}-xy)\\,j \\\\  & =(-2y-x)\\,i-(2x-y)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i,$ we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((-2y-x)\\,i-(2x-y)\\,j)\\cdot i & =0 \\\\ -2y-x & =0 \\\\ x & =-2y\\end{aligned}\n$$\n\nSubstituting $x=-2y$ into the equation of our curve gives\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =xy \\\\ (-2y)^{2}-{y}^{2} & =(-2y)y \\\\ 4{y}^{2}-{y}^{2} & =-2{y}^{2} \\\\ 5{y}^{2} & =0 \\\\ y & =0.\\end{aligned}\n$$\n\nFinally, for $y=0,$ we get $x=0,$ and the corresponding point is $(0,0).$"} {:db/id 17592186447374 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be9a2db1-529d-5628-9061-7052c51aa8d2" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\frac{3}{2})" :db/id 17592186447347} {:answer/id #uuid "cc49cf9f-93a9-5729-904e-6ab3eebbf63c" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{3},3)" :db/id 17592186447352} {:answer/id #uuid "cf37dabf-a5f5-5488-94e7-124530583cd7" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1)" :db/id 17592186447353} {:answer/id #uuid "f66bf744-8b15-5c45-869d-f7226d3e3a1a" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id 17592186447360} {:answer/id #uuid "fa96e6a2-688c-5137-81fa-3a6eabc7070a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},2)" :db/id 17592186447364}] :answer-field/correct {:answer/id #uuid "cc49cf9f-93a9-5729-904e-6ab3eebbf63c" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{3},3)" :db/id 17592186447352} :answer-field/id #uuid "16678482-e75d-56bd-a681-d31f80ad72e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186447365}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "caca4712-f17f-5ed4-8f57-6c6c5c27d1ce" :question/math-academy-id "q-130213" :question/problem "At which point on the curve $x{y}^{2}=3-2y$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{y}^{2} & =3-2y \\\\ x{y}^{2}+2y & =3\\end{aligned}\n$$\n\nIf we set $f(x,y)=x{y}^{2}+2y,$ our curve can be viewed as the level curve $f(x,y)=3.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(x{y}^{2}+2y)\\,i-\\frac{∂}{∂x}(x{y}^{2}+2y)\\,j \\\\  & =(2xy+2)\\,i-{y}^{2}\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i,$ we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2xy+2)\\,i-{y}^{2}\\,j)\\cdot i & =0 \\\\ 2xy+2 & =0 \\\\ xy+1 & =0 \\\\ y & =-\\frac{1}{x}\\end{aligned}\n$$\n\nSubstituting $y=-\\frac{1}{x}$ into the equation of our curve gives\n\n$$\n\\begin{aligned}x{y}^{2} & =3-2y \\\\ x{(-\\frac{1}{x})}^{2} & =3-2(-\\frac{1}{x}) \\\\ \\frac{1}{x} & =3+\\frac{2}{x} \\\\ \\frac{1}{x} & =-3 \\\\ x & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, for $x=-\\frac{1}{3},$ we get $y=3,$ and the corresponding point is $(-\\frac{1}{3},3).$"} {:db/id 17592186459235 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041af4e2-416c-520b-860e-976073e922ac" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(0,0)$" :db/id 17592186458624} {:answer/id #uuid "0aaf9612-44d8-54bc-9d28-79d0bc49b6e9" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ only" :db/id 17592186458639} {:answer/id #uuid "726ded84-7042-51fb-99ed-92eea059caa9" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(-\\frac{1}{4},-1)$" :db/id 17592186458826} {:answer/id #uuid "96c64968-3e1c-5d8a-b152-bcd832a0e258" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,\\frac{2}{3})$ only" :db/id 17592186458892} {:answer/id #uuid "d27915a1-c3cc-5b5c-85e5-d0ff3c9758a1" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(1,\\frac{2}{3})$" :db/id 17592186458993}] :answer-field/correct {:answer/id #uuid "041af4e2-416c-520b-860e-976073e922ac" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,2)$ and $(0,0)$" :db/id 17592186458624} :answer-field/id #uuid "d42e75fa-5b9c-5ff9-b5fc-949249e16a12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186459182}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "49174b89-3c43-532e-8951-fbe13dc1efa4" :question/math-academy-id "q-130221" :question/problem "At which points on the curve $2xy=2x-y$ is the tangent vector to the curve perpendicular to the vector $2\\,i-j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2xy & =2x-y \\\\ 2xy-2x+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2xy-2x+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2xy-2x+y)\\,i-\\frac{∂}{∂x}(2xy-2x+y)\\,j \\\\  & =(2x+1)\\,i-(2y-2)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $2\\,i-j,$ we must have $t\\cdot (2\\,i-j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (2\\,i-j) & =0 \\\\ ((2x+1)\\,i-(2y-2)\\,j)\\cdot (2\\,i-j) & =0 \\\\ (4x+2)+(2y-2) & =0 \\\\ 4x+2y & =0 \\\\ y & =-2x\\end{aligned}\n$$\n\nSubstituting $y=-2x$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2xy & =2x-y \\\\ 2x(-2x) & =2x-(-2x) \\\\ -4{x}^{2} & =4x \\\\ 4{x}^{2}+4x & =0 \\\\ 4x(x+1) & =0 \\\\ x & =-1\\,\\text{or}\\,x=0\\end{aligned}\n$$\n\nFinally:\n\n- For $x=-1,$ we get $y=2,$ and the corresponding point is $(-1,2).$\n\n- For $x=0,$ we get $y=0,$ and the corresponding point is $(0,0).$"} {:db/id 17592186499527 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b1f9282-40f6-534c-9cb9-df688ee64de0" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,-1)$ only" :db/id 17592186498822} {:answer/id #uuid "9c2fce83-b1b2-5397-8cab-576be2461576" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ only" :db/id 17592186499059} {:answer/id #uuid "a70e370b-8012-5ba7-8c81-0ea9db91d6f7" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,-1)$ only" :db/id 17592186499097} {:answer/id #uuid "d553a226-27d4-508f-a4c8-4c5c6f0cd0cb" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,-1)$  and $(1,2)$" :db/id 17592186499207} {:answer/id #uuid "e67fa0c9-ee34-5eea-a810-dee87b7233d9" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,-2)$  and $(1,2)$" :db/id 17592186499253}] :answer-field/correct {:answer/id #uuid "2b1f9282-40f6-534c-9cb9-df688ee64de0" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,-1)$ only" :db/id 17592186498822} :answer-field/id #uuid "f38fea1a-0a62-5cc4-9aaa-d50dbb5879df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186499427}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b5a12ff0-24e0-5963-9f16-1e9a01270fba" :question/math-academy-id "q-72439" :question/problem "At which points on the curve ${y}^{2}-xy=x+1$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}-xy & =x+1 \\\\ {y}^{2}-xy-x & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}-xy-x$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}-xy-x)i-\\frac{∂}{∂x}({y}^{2}-xy-x)j \\\\  & =(2y-x)\\,i+(y+1)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2y-x)\\,i+(y+1)\\,j)\\cdot i & =0 \\\\ 2y-x & =0 \\\\ x & =2y\\end{aligned}\n$$\n\nSubstituting $x=2y$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}-(2y)y-(2y) & =1 \\\\ {y}^{2}-2{y}^{2}-2y-1 & =0 \\\\ -{y}^{2}-2y-1 & =0 \\\\ {y}^{2}+2y+1 & =0 \\\\ (y+1)^{2} & =0 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally:\n\n- If $y=-1$, we get $x=-2$ and the corresponding point is $(-2,-1).$"} {:db/id 17592186500338 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b0c0406-ae8d-54c8-b629-8afd582156ce" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,2)$ only" :db/id 17592186499678} {:answer/id #uuid "23b36d38-920a-5a19-90af-0d58ea66b6c1" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,2)$ only" :db/id 17592186499733} {:answer/id #uuid "4e379d7d-a44b-5b19-ae49-edc70a8dad28" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(\\sqrt[3]{4},-\\sqrt[3]{4})$" :db/id 17592186499802} {:answer/id #uuid "930ec2dc-3268-5e8c-bb20-3557f9ac1938" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(-2,-2)$" :db/id 17592186499942} {:answer/id #uuid "fd6ba7c0-fd84-5eed-9805-7ee46c6511bf" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\sqrt[3]{4},\\sqrt[3]{4})$ and $(2,2)$" :db/id 17592186500174}] :answer-field/correct {:answer/id #uuid "0b0c0406-ae8d-54c8-b629-8afd582156ce" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,2)$ only" :db/id 17592186499678} :answer-field/id #uuid "956e93fd-6df8-5b5f-8f5c-3b6f83220074" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186500239}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a5f3b132-60d1-51a8-b2e5-d8b20ae5add9" :question/math-academy-id "q-65209" :question/problem "At which points on the curve $3y{x}^{2}=48+3x{y}^{2}$ is the tangent vector to the curve perpendicular to the vector $i-j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y{x}^{2}-3x{y}^{2} & =48\\end{aligned}\n$$\n\nIf we set $f(x,y)=3y{x}^{2}-3x{y}^{2}$, our curve can be viewed as the level curve $f(x,y)=48.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(3y{x}^{2}-3x{y}^{2})i-\\frac{∂}{∂x}(3y{x}^{2}-3x{y}^{2})j \\\\  & =(3{x}^{2}-6xy)i-(6xy-3{y}^{2})j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot (i-j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (i-j) & =0 \\\\ ((3{x}^{2}-6xy)i-(6xy-3{y}^{2})j)\\cdot (i-j) & =0 \\\\ 3{x}^{2}-6xy+6xy-3{y}^{2} & =0 \\\\ 3{x}^{2}-3{y}^{2} & =0 \\\\ {x}^{2}-{y}^{2} & =0 \\\\ (x-y)(x+y) & =0\\end{aligned}\n$$\n\nTherefore, $x=y$ or $x=-y.$ Substituting $x=y$ into the equation of our curve gives:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y{y}^{2} & =48+3y{y}^{2} \\\\ 3{y}^{3} & =48+3{y}^{3} \\\\ 0 & =48\\end{aligned}\n$$\n\nSince we get a false statement, we conclude that does not exist points of the form $(x,x)$ on the curve. Substituting $x=-y$ into the equation of our curve gives:\n\n$$\n\\begin{aligned}3y{x}^{2} & =48+3x{y}^{2} \\\\ 3y(-y)^{2} & =48+3(-y){y}^{2} \\\\ 3{y}^{3} & =48-3{y}^{3} \\\\ 6{y}^{3} & =48 \\\\ {y}^{3} & =8 \\\\ y & =\\sqrt[3]{8} \\\\ y & =2\\end{aligned}\n$$\n\nFinally:\n\n- If $y=2$, we get $x=-2$ and the corresponding point is $(-2,2).$"}] :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}
