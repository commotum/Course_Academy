4\\cdot (r)^{2}[z]_{z=0}^{z=1}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{2}4\\cdot (r)^{2}((1)-(0))\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\int_0^{2}4\\cdot (r)^{2}\\,dr\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}[\\frac{4}{3}\\cdot (r)^{3}]_{r=0}^{r=2}\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(\\frac{4}{3}\\cdot ((2))^{3})-(\\frac{4}{3}\\cdot ((0))^{3})\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}(\\frac{32}{3})-(0)\\,d\\theta \\\\ &=\\int_{0}^{2\\cdot \\pi}\\frac{32}{3}\\,d\\theta \\\\ &=[\\frac{32}{3}\\cdot \\theta]_{\\theta=0}^{\\theta=2\\cdot \\pi} \\\\ &=(\\frac{64}{3}\\cdot \\pi)-(0) \\\\ &=\\frac{64}{3}\\cdot \\pi\\end{aligned}\n$$" 13194139535921 17592186045443 true] [17592186542431 1168 "generate/scratch/17592186129278.py" 13194139535921 17592186045443 true] [17592186542431 1169 #uuid "6edc76bd-ad65-59af-b3e7-ddae1eac78b5" 13194139535921 17592186045443 true]] :edb/tempids {"08dadd38-fb68-5779-a188-b784be4a6b2a" 17592186542368 "0a15b85a-ad02-5709-a268-9be5c6653c07" 17592186542369 "0f8d660b-d1ed-54c6-80fc-e62752d00c85" 17592186542370 "14d2c317-5999-5ae3-83ba-55833a642212" 17592186542371 "1b4a19c6-9237-53cb-b88d-eea0421ee991" 17592186542372 "237c1dc0-9a08-5feb-9f93-69378beb0d5a" 17592186542373 "24ddfd73-e817-5e19-bf8d-dd13eb09dba2" 17592186542374 "267fd235-ecde-531c-b2aa-2c537397b3c6" 17592186542375 "2b6f9f77-1552-57ae-884a-192b803d96da" 17592186542376 "3112b487-c350-57db-82e9-a721ed41fe97" 17592186542377 "3d825389-7a3e-5461-af4a-30fb0473dbe9" 17592186542378 "424213bf-d747-5c2b-8b1c-17e303286030" 17592186542379 "4ef0905a-bdbf-5fea-9e69-8095deb48425" 17592186542380 "5434eee3-49f9-5e43-a178-4a79f52b75aa" 17592186542381 "57e8e949-e40f-5a5f-a5fb-3d827a224266" 17592186542382 "58a3a2b3-377a-5a2e-be8b-8d442f4d4cda" 17592186542383 "6333ef2c-1cae-519e-a685-58c87c26695f" 17592186542384 "646cbcae-95be-5a16-90c4-402ea2065742" 17592186542385 "66af9ffc-ae30-5a4e-8b1b-228331e6b034" 17592186542386 "6cbee069-7a87-51d0-9392-cbeec9ec586e" 17592186542387 "73