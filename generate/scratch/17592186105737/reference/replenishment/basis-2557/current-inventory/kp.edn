#{[{:db/id #edb/ref 17592186105737 :knowledge-point/canonical-example {:db/id #edb/ref 17592186105595 :question/id #uuid "483b758a-9b14-5a72-87e5-70f27a0acf48" :question/math-academy-id "e-4349" :question/problem "Find $\\mathbf{c} \\cdot (\\mathbf{a} \\times \\mathbf{b}),$ if $2\\mathbf{a} \\cdot (\\mathbf{b} \\times 3\\mathbf{c}) = 5.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times 3c) & =5 \\\\ 2\\cdot [a\\cdot (b\\times 3c)] & =5 \\\\ 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =5 \\\\ a\\cdot (b\\times c) & =\\frac{5}{6}.\\end{aligned}\n$$\n\nThen, we swap $\\mathbf{a}$ and $\\mathbf{c}$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-\\frac{5}{6},\\end{aligned}\n$$\n\nand again we swap $\\mathbf{a}$ and $\\mathbf{b}$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =\\frac{5}{6}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/question-generator {:db/id #edb/ref 17592186535224 :question-generator/id #uuid "b346af11-5040-5067-a54d-8c00526c9b45" :question-generator/script "generate/scratch/17592186105737.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186106128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb09803-f3ce-56d0-b3f9-23e1bde62a4f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186285044} {:answer/id #uuid "5976d5d8-630e-5d9c-80c0-39d8d4f64947" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186285605} {:answer/id #uuid "7b2d9f03-1ac4-5377-aaed-2235dfcda0a8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285926} {:answer/id #uuid "842876fd-0304-54d8-ab9d-02ba81ff1c00" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186286001} {:answer/id #uuid "8c4a4717-d603-58c7-99cb-3326d366dc4f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/re