wer-fields [{:answer-field/choices [{:answer/id #uuid "3a4a0f8b-6a4e-58a2-ba3b-2c77b5f60813" :answer/type {:db/ident :answer.type/math} :answer/value "-108" :db/id #edb/ref 17592186535169} {:answer/id #uuid "6148d277-f3fd-50e0-8254-cc45eb1f58c2" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186535182} {:answer/id #uuid "79e45480-0699-5872-b6ca-b9b3a11b8ec4" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186535191} {:answer/id #uuid "e24c6cdb-2f0d-5255-ae81-7e6507e258b7" :answer/type {:db/ident :answer.type/math} :answer/value "108" :db/id #edb/ref 17592186535218} {:answer/id #uuid "f65af0a7-ee33-528c-b9b1-79bbdeaf559c" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186535222}] :answer-field/correct {:answer/id #uuid "3a4a0f8b-6a4e-58a2-ba3b-2c77b5f60813" :answer/type {:db/ident :answer.type/math} :answer/value "-108" :db/id #edb/ref 17592186535169} :answer-field/id #uuid "b9caec51-8a8d-5578-9989-3468b3cc50be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535208}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7ea92732-1301-5bdf-ab1e-e800213b2b09" :question/problem "Find $a\\cdot (3c\\times 4b)$, if $2a\\cdot (2b\\times 3c)=108.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (2b\\times 3c) & =108 \\\\ 2\\cdot 2\\cdot 3\\cdot [a\\cdot (b\\times c)] & =108 \\\\ a\\cdot (b\\times c) & =9.\\end{aligned}\n$$\n\nThen, we swap $b$ and $c$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-9.\\end{aligned}\n$$\n\nFactoring out the constants in the requested product, we get\n\n$$\n\\begin{aligned}a\\cdot (3c\\times 4b) & =3\\cdot 4[a\\cdot (c\\times b)] \\\\ & =3\\cdot 4\\cdot (-9) \\\\ & =-108.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fea73c1-d555-5ea1-80a9-39259e6a281c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186535170} {:answer/id #uuid "4e3d5ba1-f72a-5789-9346-c91a0d800836" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186535176} {:answer/id #uuid "52dbb7a3-9c01-50a8-b7d1-a653cb118755" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186535179} {:answer/id #uuid "97d03b14-dc61-575c-b118-97595bcd85db" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186535200} {:answer/id #uuid "f9ac8bfc-e6bb-5f75-bf8c-0795ed409b1f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186535223}] :answer-field/correct {:answer/id #uuid "3fea73c1-d555-5ea1-80a9-39259e6a281c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186535170} :answer-field/id #uuid "1cb6b500-8260-5af9-ace0-76e232ff77a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535160}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "95002963-a93f-5dd0-9692-59f40b345779" :question/problem "Find $b\\cdot (a\\times c)$, if $2a\\cdot (b\\times c)=2.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}2a\\cdot (b\\times c) & =2 \\\\ 2\\cdot [a\\cdot (b\\times c)] & =2 \\\\ a\\cdot (b\\times c) & =1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bbacda8-c1e8-56e4-bbff-c57fe1ebd31b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186535162} {:answer/id #uuid "31cccad3-9563-51fa-912c-9669a387c394" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186535164} {:answer/id #uuid "734de5c7-db2d-5efd-94b1-06d6249d844d" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186535189} {:answer/id #uuid "b5e5db1c-29c6-5c7b-bef0-e9a5cc83b3ec" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186535206} {:answer/id #uuid "d8c7bbf9-5c98-5950-bb11-9af71dbc186b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186535216}] :answer-field/correct {:answer/id #uuid "734de5c7-db2d-5efd-94b1-06d6249d844d" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186535189} :answer-field/id #uuid "c82e418b-65ca-5340-9b52-43c99c54f641" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535212}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a5329ad4-9065-515a-9ca0-3ada4a2d76e7" :question/problem "Find $b\\cdot (2c\\times 4a)$, if $3a\\cdot ((-5)b\\times (-3)c)=135.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot ((-5)b\\times (-3)c) & =135 \\\\ 3\\cdot (-5)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =135 \\\\ a\\cdot (b\\times c) & =3.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-3.\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =3.\\end{aligned}\n$$\n\nFactoring out the constants in the requested product, we get\n\n$$\n\\begin{aligned}b\\cdot (2c\\times 4a) & =2\\cdot 4[b\\cdot (c\\times a)] \\\\ & =2\\cdot 4\\cdot 3 \\\\ & =24.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118994f9-47f7-52b6-8a6a-1e88a42e216c" :answer/type {:db/ident :answer.type/math} :answer/value "-40" :db/id #edb/ref 17592186535157} {:answer/id #uuid "1ee28813-8b4f-5d36-b97f-0ce0abfed529" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186535161} {:answer/id #uuid "7e753899-0951-5c2a-8b00-dbdcddee98e9" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186535194} {:answer/id #uuid "8bd5e7cc-869a-5e31-a302-b6c0e08495e4" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186535196} {:answer/id #uuid "d457fd0f-56e7-5b32-9979-3fc239f21106" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186535215}] :answer-field/correct {:answer/id #uuid "8bd5e7cc-869a-5e31-a302-b6c0e08495e4" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186535196} :answer-field/id #uuid "4174397f-4745-562f-995e-4edeaf5774a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535173}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a6404a84-02a4-5714-818c-4cf7dd509add" :question/problem "Find $c\\cdot (2a\\times (-4)b)$, if $4a\\cdot ((-4)b\\times (-3)c)=-240.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot ((-4)b\\times (-3)c) & =-240 \\\\ 4\\cdot (-4)\\cdot (-3)\\cdot [a\\cdot (b\\times c)] & =-240 \\\\ a\\cdot (b\\times c) & =-5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =5.\\end{aligned}\n$$\n\nand again we swap $b$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =-5.\\end{aligned}\n$$\n\nFactoring out the constants in the requested product, we get\n\n$$\n\\begin{aligned}c\\cdot (2a\\times (-4)b) & =2\\cdot (-4)[c\\cdot (a\\times b)] \\\\ & =2\\cdot (-4)\\cdot (-5) \\\\ & =40.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}]}
