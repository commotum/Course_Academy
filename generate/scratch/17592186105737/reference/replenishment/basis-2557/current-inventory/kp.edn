e/math} :answer/value "-1" :db/id #edb/ref 17592186297738} :answer-field/id #uuid "f75cec09-3e63-55a8-bfe9-30a9430f9ad5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299474}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ef37e01-1bf6-55b3-89e8-cc90cafd078c" :question/math-academy-id "q-317343" :question/problem "Find $b\\cdot (c\\times a),$ if $b\\times c=⟨4,-1,6⟩$ and $a=⟨2,3,-1⟩.$\n\n$b\\cdot (c\\times a)=$\n{{field-1}}" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨2,3,-1⟩\\cdot ⟨4,-1,6⟩ \\\\  & =2\\cdot 4+3\\cdot (-1)+(-1)\\cdot 6 \\\\  & =8-3-6 \\\\  & =-1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c)=1\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a)=-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e01e90f-f2c8-529a-8475-ffe098a4dce7" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186339392} {:answer/id #uuid "2d627205-3eda-50f7-a543-2c0b44474b89" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186339525} {:answer/id #uuid "2ffb819c-5b7a-5670-bb5f-a7ce9ecaa93f" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186339546} {:answer/id #uuid "6c7e1618-a748-5197-8bc3-fe1f6a14f7a6" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186340086} {:answer/id #uuid "e024f0bd-062c-5cb4-83fb-f88a21111438" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186341120}] :answer-field/correct {:answer/id #uuid "1e01e90f-f2c8-529a-8475-ffe098a4dce7" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186339392} :answer-field/id