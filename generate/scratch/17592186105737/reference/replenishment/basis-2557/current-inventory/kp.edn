2 \\\\ a\\cdot (b\\times c) & =-6.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =6.\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0247d9d4-0adf-5b41-95a1-fcfebd8e0869" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186535154} {:answer/id #uuid "1ae2f448-6b56-5e4a-bfbf-61279f25e760" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186535159} {:answer/id #uuid "7d06e647-676d-5959-8639-f90018e027b1" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186535193} {:answer/id #uuid "9fd1eb97-a2fa-5e5f-bbcc-f7497c7765b1" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186535201} {:answer/id #uuid "b9be68d2-adcf-5ee3-9d21-747b5641b3b3" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186535207}] :answer-field/correct {:answer/id #uuid "b9be68d2-adcf-5ee3-9d21-747b5641b3b3" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186535207} :answer-field/id #uuid "722bea6e-7984-59f0-a1be-ce656c531cb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535187}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "371a5e09-afe1-5a22-8d4f-574703d014c6" :question/problem "Find $b\\cdot ((-4)c\\times 3a)$, if $4a\\cdot (2b\\times (-4)c)=-128.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}4a\\cdot (2b\\times (-4)c) & =-128 \\\\ 4\\cdot 2\\cdot (-4)\\cdot [a\\cdot (b\\times c)] & =-128 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\begin{aligned}b\\cdot (a\\times c) & =-4.\\end{aligned}\n$$\n\nand again we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}b\\cdot (c\\times a) & =4.\\end{aligned}\n$$\n\nFactoring out the constants in the requested product, we get\n\n$$\n\\begin{aligned}b\\cdot ((-4)c\\times 3a) & =(-4)\\cdot 3[b\\cdot (c\\times a)] \\\\ & =(-4)\\cdot 3\\cdot 4 \\\\ & =-48.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383466df-c5ed-536f-bf11-f2a14df0696c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186535168} {:answer/id #uuid "72531897-758c-5204-8d55-cd82af3177f6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186535188} {:answer/id #uuid "8fc6b665-e7e7-56e2-9545-88046850736a" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186535197} {:answer/id #uuid "c6b3e701-8074-575f-95fd-4d299fa45e09" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186535211} {:answer/id #uuid "d167d6fb-682d-5bb5-a400-582db5d26180" :answer/type {:db/ident :answer.type/math} :answer/value "-196" :db/id #edb/ref 17592186535213}] :answer-field/correct {:answer/id #uuid "383466df-c5ed-536f-bf11-f2a14df0696c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186535168} :answer-field/id #uuid "5918b47d-c8ca-5220-87e5-8ef860f5fb99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535180}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d5dd27d-8ce5-5b7e-9ce7-851473477c43" :question/problem "Find $b\\cdot (a\\times c)$, if $(-7)a\\cdot (b\\times c)=-28.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}(-7)a\\cdot (b\\times c) & =-28 \\\\ (-7)\\cdot [a\\cdot (b\\times c)] & =-28 \\\\ a\\cdot (b\\times c) & =4.\\end{aligned}\n$$\n\nThen, we swap $a$ and $b$ to get\n\n$$\n\\beg