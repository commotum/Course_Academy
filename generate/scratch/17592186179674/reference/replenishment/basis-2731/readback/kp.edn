\\\\  &={\\int }_{0}^{1}\\left(\\left(x\\right)\\frac{\\text{d}x}{\\text{d}t}+\\left(3 y\\right)\\frac{\\text{d}y}{\\text{d}t}\\right)\\,dt \\\\  &={\\int }_{0}^{1}\\left(\\left(t\\right)\\right)\\cdot \\left(1\\right)+\\left(3 \\left(3 t^{2}\\right)\\right)\\cdot \\left(6 t\\right)\\,dt \\\\  &={\\int }_{0}^{1}t+54 t^{3}\\,dt \\\\  &={\\int }_{0}^{1}54 t^{3} + t\\,dt \\\\  &=\\left[\\frac{t^{2}}{2}+\\frac{27 t^{4}}{2}\\right]_{0}^{1} \\\\  &=[\\frac{\\left(1\\right)^{2}}{2}+\\frac{27 \\left(1\\right)^{4}}{2}]-[\\frac{\\left(0\\right)^{2}}{2}+\\frac{27 \\left(0\\right)^{4}}{2}] \\\\  &=[\\frac{1}{2}+\\frac{27}{2}]-[0+0] \\\\  &=14\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561139 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f04a969-e7e0-592f-b5cd-e92fedb217a8" :knowledge-point/title "Evaluating Line Integrals With Respect to X and Y Along Cartesian Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b51235b-d773-596c-8209-d2a82308a4fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186561126} {:answer/id #uuid "9c858184-b694-5e2a-b80b-4d1a74942278" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186561130} {:answer/id #uuid "c3ab1e7c-29cf-5323-83d8-66e7cbc02cbc" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186561142} {:answer/id #uuid "d816469b-cf8f-520a-8f3a-7253e50e1889" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186561146} {:answer/id #uuid "ef0c8b07-d501-5dbf-91af-7e7ed08f35ba" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5}{2}" :db/id #edb/ref 17592186561152}] :answer-field/correct {:answer/id #uuid "7b51235b-d773-596c-8209-d2a82308a4fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186561126} :answer-field/id #uuid "cff2a487-8e9e-51dc-aacf-2e57af4a14bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561144}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b69980cc-ee42-537d-9b34-61b269c46770" :question/problem "If the path $C$ is a part of the graph $y=x^{2}$ traversed from the point $A(0,0)$ to point $B(1,1),$ then ${\\int }_C\\left(3 x\\right)\\,dx+\\left(2 y\\right)\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y=x^{2}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j=\\left(t\\right)\\,i+\\left(t^{2}\\right)\\,j,\\,t\\in [0,1]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t)&=\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=\\left(1\\right)\\,i+\\left(2 t\\right)\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_C\\left(3 x\\right)\\,dx+\\left(2 y\\right)\\,dy &={\\int }_{0}^{1}\\left(3 x\\right)\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+\\left(2 y\\right)\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  &={\\int }_{0}^{1}\\left(\\left(3 x\\right)\\frac{\\text{d}x}{\\text{d}t}+\\left(2 y\\right)\\frac{\\text{d}y}{\\text{d}t}\\right)\\,dt \\\\  &={\\int }_{0}^{1}\\left(3 \\left(t\\right)\\right)\\cdot \\left(1\\right)+\\left(2 \\left(t^{2}\\right)\\right)\\cdot \\left(2 t\\right)\\,dt \\\\  &={\\int }_{0}^{1}3 t+4 t^{3}\\,dt \\\\  &={\\int }_{0}^{1}4 t^{3} + 3 t\\,dt \\\\  &=\\left[\\frac{3 t^{2}}{2}+t^{4}\\right]_{0}^{1} \\\\  &=[\\frac{3 \\left(1\\right)^{2}}{2}+\\left(1\\right)^{4}]-[\\frac{3 \\left(0\\right)^{2}}{2}+\\left(0\\right)^{4}] \\\\  &=[\\frac{3}{2}+1]-[0+0] \\\\  &=\\frac{5}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561153 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f04a969-e7e0-592f-b5cd-e92fedb217a8" :knowledge-point/title "Evaluating Line Integrals With Respect to X and Y Along Cartesian Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "688533d7-da94-5d62-886b-1a90ca349e53" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + 52 \\pi" :db/id #edb/ref 17592186561120} {:answer/id #uuid "69684ec4-4be0-5868-aff3-3fed587c9d86" :answer/type {:db/ident :answer.type/math} :answer/value "52 \\pi" :db/id #edb/ref 17592186561121} {:answer/id #uuid "a0e57cc0-e23e-5364-8631-e13e2e412ba6" :answer/type {:db/ident :answer.type/math} :answer/value "- 52 \\pi - 2" :db/id #edb/ref 17592186561131} {:answer/id #uuid "b55dff06-4093-5a7d-8247-97e5471839db" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186561138} {:answer/id #uuid "c1ed43f6-4855-52a9-a384-1d599ac85543" :answer/type {:db/ident :answer.type/math} :answer/value "2 - 52 \\pi" :db/id #edb/ref 17592186561141}] :answer-field/correct {:answer/id #uuid "688533d7-da94-5d62-886b-1a90ca349e53" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + 52 \\pi" :db/id #edb/ref 17592186561120} :answer-field/id #uuid "a297ede3-80df-5c9e-a44a-147e80cb4715" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561132}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3771e2f-30a0-504d-a491-225f9ef42173" :question/problem "If the path $C$ is a part of the graph $y=3 \\pi x^{2}$ traversed from the point $A(1,3 \\pi)$ to point $B(3,27 \\pi),$ then ${\\int }_C\\left(\\sin{\\left(\\frac{y}{2 x^{2}} \\right)}\\right)\\,dx+\\left(x\\right)\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y=3 \\pi x^{2}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j=\\left(t\\right)\\,i+\\left(3 \\pi t^{2}\\right)\\,j,\\,t\\in [1,3]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t)&=\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=\\left(1\\right)\\,i+\\left(6 \\pi t\\right)\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_C\\left(\\sin{\\left(\\frac{y}{2 x^{2}} \\right)}\\right)\\,dx+\\left(x\\right)\\,dy &={\\int }_{1}^{3}\\left(\\sin{\\left(\\frac{y}{2 x^{2}} \\right)}\\right)\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+\\left(x\\right)\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  &={\\int }_{1}^{3}\\left(\\left(\\sin{\\left(\\frac{y}{2 x^{2}} \\right)}\\right)\\frac{\\text{d}x}{\\text{d}t}+\\left(x\\right)\\frac{\\text{d}y}{\\text{d}t}\\right)\\,dt \\\\  &={\\int }_{1}^{3}\\left(\\sin{\\left(\\frac{\\left(3 \\pi t^{2}\\right)}{2 \\left(t\\right)^{2}} \\right)}\\right)\\cdot \\left(1\\right)+\\left(\\left(t\\right)\\right)\\cdot \\left(6 \\pi t\\right)\\,dt \\\\  &={\\int }_{1}^{3}-1+6 \\pi t^{2}\\,dt \\\\  &={\\int }_{1}^{3}6 \\pi t^{2} - 1\\,dt \\\\  &=\\left[- t+2 \\pi t^{3}\\right]_{1}^{3} \\\\  &=[- \\left(3\\right)+2 \\pi \\left(3\\right)^{3}]-[- \\left(1\\right)+2 \\pi \\left(1\\right)^{3}] \\\\  &=[-3+54 \\pi]-[-1+2 \\pi] \\\\  &=-2 + 52 \\pi\\end{aligned}\n$$"}] :knowledge-point/title "Evaluating Line Integrals With Respect to X and Y Along Cartesian Curves"}]}
