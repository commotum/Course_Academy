[{"label": "c=20", "record": {"knowledge_point": {"db_id": 17592186068724, "id": "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8", "title": "Integrating a Rational Function Using Natural Logarithms"}, "question": {":question/id": "66f53551-b4f8-583a-b190-5d2f9d718096", ":question/problem": "$\\int \\frac{- 16 t}{2 t^{2} + 20}\\,\\text{d}t=\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,K.$", ":question/worked-solution": "Let $u=2 t^{2} + 20.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=4 t\\,\u27f9\\,\\frac{1}{4}\\text{d}u=t\\,\\text{d}t.\n$$\n\nWe can solve the required integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{- 16 t}{2 t^{2} + 20}\\,\\text{d}t & =-16\\int \\frac{1}{2 t^{2} + 20}\\cdot t\\,\\text{d}t \\\\  & =-16\\int \\frac{1}{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =-4\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-4\\operatorname{ln}|u|+K \\\\  & =-4\\operatorname{ln}\\left(2 t^{2} + 20\\right)+K\\end{aligned}\n$$", ":question/difficulty": ":question.difficulty/easy", ":question/answer-fields": [{":answer-field/id": "0697dbfe-fde0-570b-8b94-8f3a19b7d330", ":answer-field/key": "field-1", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "72d06d5b-a656-532c-b460-260eef64e03b", ":answer/type": ":answer.type/math", ":answer/value": "-4\\operatorname{ln}\\left(2 t^{2} + 20\\right)"}], ":answer-field/correct": [":answer/id", "72d06d5b-a656-532c-b460-260eef64e03b"]}]}, "generation": {"generator_version": "68724-v1", "template": "q-132982", "bank_profile": "q-132982", "recipes": ["k/(a*n)*ln(u)"], "seed": 0, "parameters": {"k": -16, "a": 2, "b": 0, "c": 20, "n": 2, "variable": "t"}, "domain": "real connected intervals where denominator != 0; blank positive quadratic is positive on R", "source_basis": 1934, "source_question_id": 17592186235390, "mathematical_fingerprint": "f48726dc03f40c07641009a08c12f548997c13ac6d0b25147897e91525499d2d", "sympy_version": "1.14.0", "plots": "none"}}, "checks": [{"submitted": "-4\\operatorname{ln}\\left(2 t^{2} + 20\\right)", "expected": "accepted", "purpose": "canonical blank"}, {"submitted": "-4*ln(2 t^{2} + 20)", "expected": "accepted", "purpose": "equivalent ln spelling and explicit multiplication"}, {"submitted": "-4*ln(2 t^{2} + 20)+0", "expected": "accepted", "purpose": "equivalent +0"}, {"submitted": "4*ln(2 t^{2} + 20)", "expected": "rejected", "purpose": "wrong sign"}, {"submitted": "-3*ln(2 t^{2} + 20)", "expected": "rejected", "purpose": "wrong factor"}, {"submitted": "0", "expected": "rejected", "purpose": "incorrect constant"}]}]