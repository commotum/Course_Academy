oint/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8b60ab-4072-5f31-94dd-75c493f8372d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id 17592186330332} {:answer/id #uuid "7e6534ec-42dc-57fa-b80f-40c681fa5d3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id 17592186331061} {:answer/id #uuid "ad30acb9-e2fc-5534-870a-032790c3f83f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{({x}^{2}+1)^{2}}+C" :db/id 17592186331484} {:answer/id #uuid "e1762878-a949-5466-848b-82eaa3555015" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id 17592186331941} {:answer/id #uuid "f51b2f83-41fe-5b84-b9cb-eee7ef105dd5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{({x}^{2}+1)^{2}}+C" :db/id 17592186332106}] :answer-field/correct {:answer/id #uuid "e1762878-a949-5466-848b-82eaa3555015" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{2}+1)+C" :db/id 17592186331941} :answer-field/id #uuid "1f3093a8-9026-569a-a294-190db04689b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332247}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "503a6da2-cd33-5244-b696-2a607d8e13a7" :question/math-academy-id "q-49451" :question/problem "$\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{2}+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{4x}{{x}^{2}+1}\\,\\text{d}x & =4\\int \\frac{1}{{x}^{2}+1}\\cdot x\\,\\text{d}x \\\\  & =4\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡({x}^{2}+1)+C\\end{aligned}\n$$"} {:db/id 17592186332746 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0b4bc1-823f-5e02-8034-3ccb847c8db8" :answer/type {:db/ident :answer.type/math} :answer/value "10\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id 17592186330208} {:answer/id #uuid "711aed47-9647-5934-a577-4de853e0d471" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{({x}^{10}+9)}^{2}}+C" :db/id 17592186330965} {:answer/id #uuid "975e27ea-5815-5300-8549-c6937e33edfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id 17592186331296} {:answer/id #uuid "9bff9af1-6821-53c4-a8ff-414b86f7a2aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id 17592186331346} {:answer/id #uuid "aa7dd637-4802-5b2a-8d38-50321acf836f" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id 17592186331461}] :answer-field/correct {:answer/id #uuid "9bff9af1-6821-53c4-a8ff-414b86f7a2aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C" :db/id 17592186331346} :answer-field/id #uuid "795f6c36-32ec-5092-a8d3-95ebafacee77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332420}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22468a13-74ba-5d2c-ad19-0e4459213b23" :question/math-academy-id "q-49572" :question/problem "Calculate $\\int \\frac{{x}^{9}}{{x}^{10}+9}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{10}+9.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10{x}^{9}\\,⟹\\,\\frac{1}{10}\\text{d}u={x}^{9}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{9}}{{x}^{10}+9}\\,\\text{d}x & =\\int \\frac{1}{{x}^{10}+9}\\cdot {x}^{9}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{10}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{10}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{10}\\operatorname{ln}⁡|{x}^{10}+9|+C\\end{aligned}\n$$"} {:db/id 17592186341840 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424f1750-2255-5cd3-97f1-bff8ae1f779e" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id 17592186339710} {:answer/id #uuid "64a24bd8-02d1-5da1-875a-ff8313d79449" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5(2-5{x}^{5})^{2}}+C" :db/id 17592186340018} {:answer/id #uuid "cd66158f-066f-573b-a023-86fcc42573cc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2(2-5{x}^{5})^{2}}+C" :db/id 17592186340950} {:answer/id #uuid "d40a6f74-0d5f-5192-b1f2-24adfd672a83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id 17592186341003} {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id 17592186341259}] :answer-field/correct {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id 17592186341259} :answer-field/id #uuid "c4f33047-2f0b-50bf-84ac-e403b1fabf2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341723}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "958efc2b-d91b-53e5-b712-1690bc1b7068" :question/math-academy-id "q-72605" :question/problem "$\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}
