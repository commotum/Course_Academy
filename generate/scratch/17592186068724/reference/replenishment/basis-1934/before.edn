{:db/id 17592186068724 :knowledge-point/canonical-example {:db/id 17592186068566 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/id #uuid "49f679c4-bbc4-59a5-9b0c-0f3b69d7cf57" :question/math-academy-id "e-454" :question/problem "Calculate $\\displaystyle \\int \\dfrac{x^2}{x^3+1}\\,\\textrm d x.$" :question/worked-solution "Let $u=x^3+1.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 3x^2\\quad\\Longrightarrow\\quad \\dfrac 1 3 \\textrm d u= x^2 \\, \\textrm d x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}}{{x}^{3}+1}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}+1}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|{x}^{3}+1|+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/key-prerequisites [{:db/id 17592186048557}] :knowledge-point/questions [{:db/id 17592186069031 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89cbbcfc-00ad-53c7-b1e4-f74c30e23742" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/((x^{2} - 1)^{2}) + C" :db/id 17592186065620} {:answer/id #uuid "b505fb8e-eba7-5140-a855-35f6a4f2675c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln \\mid x^{2} - 1 \\mid + C" :db/id 17592186065621} {:answer/id #uuid "b6e7b32b-88b1-5259-a368-fa1f163ed93e" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(2(x^{2} - 1)^{2}) + C" :db/id 17592186065622} {:answer/id #uuid "2dcf2fc8-01b2-5836-816b-2e75cf472f28" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln \\mid x^{2} - 1 \\mid + C" :db/id 17592186065623} {:answer/id #uuid "4f0c6e1d-f86b-5e04-a5b5-5f64b9b9d40d" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln \\mid x^{2} - 1 \\mid + C" :db/id 17592186065624}] :answer-field/id #uuid "aeff9a7e-466b-580e-a976-b234214756fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186065619}] :question/id #uuid "fe887383-d000-50e4-b251-b388a44be6d7" :question/math-academy-id "q-12500" :question/problem "Calculate $\\displaystyle \\int\\frac{x}{x^{2} - 1}dx$."} {:db/id 17592186069509 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a56f775-026e-59fc-b647-34d85fe8bf61" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|3{x}^{2}-1|+C" :db/id 17592186336275} {:answer/id #uuid "a1728457-38ba-5bbb-927c-7282a90dc1b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-1|+C" :db/id 17592186337496} {:answer/id #uuid "b51f8e66-052a-5029-8ff7-97299bdc0642" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-x|+C" :db/id 17592186337639} {:answer/id #uuid "f743a007-0c6c-5682-a772-447548f069d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|3{x}^{2}-x|+C" :db/id 17592186338200} {:answer/id #uuid "f9436168-b71c-5730-9e91-324b6cdb60f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{1}{{x}^{3}-1}|+C" :db/id 17592186338217}] :answer-field/correct {:answer/id #uuid "b51f8e66-052a-5029-8ff7-97299bdc0642" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-x|+C" :db/id 17592186337639} :answer-field/id #uuid "e9839270-94f7-5e94-999d-41a70f88e25f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186338685}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "604f6b09-192e-50e6-8477-dce586313508" :question/math-academy-id "q-72566" :question/problem "$\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{3}-x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-1\\,⟹\\,\\text{d}u=(3{x}^{2}-1)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}-x}\\cdot (3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{3}-x|+C\\end{aligned}\n$$"} {:db/id 17592186235390 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0422cb62-0c61-58da-94f7-f0c7e04bc54f" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}(2{t}^{2}+3)" :db/id 17592186234557}] :answer-field/correct {:answer/id #uuid "0422cb62-0c61-58da-94f7-f0c7e04bc54f" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}(2{t}^{2}+3)" :db/id 17592186234557} :answer-field/id #uuid "a27d93e9-cbea-537e-8fd4-f771273be507" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186235169}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7449abb3-586b-5fd3-93e0-df3f3d5afa01" :question/math-academy-id "q-132982" :question/problem "$\\int \\frac{-16t}{2{t}^{2}+3}\\,\\text{d}t=\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,K.$" :question/worked-solution "Let $u=2{t}^{2}+3.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=4t\\,⟹\\,\\frac{1}{4}\\text{d}u=t\\,\\text{d}t.\n$$\n\nWe can solve the required integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{-16t}{2{t}^{2}+3}\\,\\text{d}t & =-16\\int \\frac{1}{2{t}^{2}+3}\\cdot t\\,\\text{d}t \\\\  & =-16\\int \\frac{1}{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =-4\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-4\\operatorname{ln}⁡|u|+K \\\\  & =-4\\operatorname{ln}⁡(2{t}^{2}+3)+K\\end{aligned}\n$$"} {:db/id 17592186247399 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14c3e4e9-b986-5ba0-8bda-1e9028952e04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|1+x-{x}^{4}|}{1-4{x}^{3}}+C" :db/id 17592186244505} {:answer/id #uuid "67d9c50b-eb65-5148-adba-2cc568ed70ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{1-4{x}^{3}}{1+x-{x}^{4}}|+C" :db/id 17592186245232} {:answer/id #uuid "6bf0db7f-9d0d-5e1e-84fe-0e0a3ad04e44" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|1+x-{x}^{4}|+C" :db/id 17592186245270} {:answer/id #uuid "8f80e297-bea8-557a-a4d0-20991cf10a78" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{1+x-{x}^{4}}{1-4{x}^{3}}|+C" :db/id 17592186245565} {:answer/id #uuid "f01cc4c4-3137-5262-9a77-8fcd829c9bc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|1-4{x}^{3}|+C" :db/id 17592186246437}] :answer-field/correct {:answer/id #uuid "6bf0db7f-9d0d-5e1e-84fe-0e0a3ad04e44" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|1+x-{x}^{4}|+C" :db/id 17592186245270} :answer-field/id #uuid "449306db-0c30-5468-98a1-e16f99561f62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186246658}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5eb9147-51e3-5599-8ff3-2e89cfeea2e5" :question/math-academy-id "q-113719" :question/problem "Calculate $\\int \\frac{1-4{x}^{3}}{1+x-{x}^{4}}\\,\\text{d}x.$" :question/worked-solution "Let $u=1+x-{x}^{4}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1-4{x}^{3}\\,⟹\\,\\text{d}u=(1-4{x}^{3})\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1-4{x}^{3}}{1+x-{x}^{4}}\\,\\text{d}x & =\\int \\frac{1}{1+x-{x}^{4}}\\cdot (1-4{x}^{3})\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|1+x-{x}^{4}|+C\\end{aligned}\n$$"} {:db/id 17592186247400 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "113226f4-e18c-5de6-bd31-250ad8c9da82" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{x}^{5}-x|}{5{x}^{4}-1}+C" :db/id 17592186244473} {:answer/id #uuid "237bf824-72e9-57ab-b903-4d00af2cd730" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{{x}^{5}-x}{5{x}^{4}-1}|+C" :db/id 17592186244625} {:answer/id #uuid "7028a648-9041-5f31-bfe0-d0f0ca912266" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|5{x}^{4}-1|+C" :db/id 17592186245316} {:answer/id #uuid "a2732f81-711b-5382-a2b9-0eddcc00071c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{5{x}^{4}-1}{{x}^{5}-x}|+C" :db/id 17592186245765} {:answer/id #uuid "b1a549aa-b789-5a43-b25c-b397669d584c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{5}-x|+C" :db/id 17592186245892}] :answer-field/correct {:answer/id #uuid "b1a549aa-b789-5a43-b25c-b397669d584c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{5}-x|+C" :db/id 17592186245892} :answer-field/id #uuid "5f9cfd94-3510-53d3-bb6c-b7ca2e4db615" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186246716}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6aa87c4a-351c-586b-be53-8401152f7ab3" :question/math-academy-id "q-113720" :question/problem "Calculate $\\int \\frac{5{x}^{4}-1}{{x}^{5}-x}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{5}-x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}-1\\,⟹\\,\\text{d}u=(5{x}^{4}-1)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}-1}{{x}^{5}-x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{5}-x}\\cdot (5{x}^{4}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{5}-x|+C\\end{aligned}\n$$"} {:db/id 17592186247401 :knowledge-point/_questions [{:knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5dafea-bf81-547d-bc49-424b9dda654f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{x}^{2}+2x|}{2x+2}+C" :db/id 17592186245413} {:answer/id #uuid "99a2a79b-5577-502b-8046-72f844be5fb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|2x+2|+C" :db/id 17592186245676} {:answer/id #uuid "d24c27f7-0e1d-5d59-