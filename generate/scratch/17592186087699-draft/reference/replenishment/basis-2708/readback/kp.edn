\\begin{bmatrix}-1 & -\\frac{3}{2} \\\\ -1 & \\frac{1}{2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."} {:db/id #edb/ref 17592186557710 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1f18c79-3b49-530d-8454-86379c0b9403" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557785} {:answer/id #uuid "e9d8a19d-14c7-57f9-99cc-9cac0d153cd9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557790}] :answer-field/correct {:answer/id #uuid "e1f18c79-3b49-530d-8454-86379c0b9403" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557785} :answer-field/id #uuid "6ee91bd2-1a95-558f-be1a-abb6d916f84b" :answer-field/key "II" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557733} {:answer-field/choices [{:answer/id #uuid "9e9106c5-004e-5923-a1ee-f8a8ed480e8a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557750} {:answer/id #uuid "c2c423f1-fa46-5046-b322-201462bc9092" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557770}] :answer-field/correct {:answer/id #uuid "9e9106c5-004e-5923-a1ee-f8a8ed480e8a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557750} :answer-field/id #uuid "70d7643b-6104-537f-a2f7-ea56fddc6fea" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557734} {:answer-field/choices [{:answer/id #uuid "6daf8fd9-1eff-5d73-b495-b7b1e84dd3ca" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557731} {:answer/id #uuid "bc243859-b6cc-502a-bf95-259667fad729" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557764