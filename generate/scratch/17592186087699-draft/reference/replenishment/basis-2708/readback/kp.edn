\"."} {:db/id #edb/ref 17592186557740 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a595b9f-2009-5cbb-a94f-e043f6b53b8d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557716} {:answer/id #uuid "a8fa3fb1-f140-51b8-b6f4-7871b12200fe" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557754}] :answer-field/correct {:answer/id #uuid "3a595b9f-2009-5cbb-a94f-e043f6b53b8d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557716} :answer-field/id #uuid "012c00fa-4cb0-5960-a536-d71799c397f9" :answer-field/key "III" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557701} {:answer-field/choices [{:answer/id #uuid "7103b14f-02cf-5a7f-805e-a0dd3de7e261" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557735} {:answer/id #uuid "a027df56-7799-5590-ae3e-34bad820b71b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557752}] :answer-field/correct {:answer/id #uuid "7103b14f-02cf-5a7f-805e-a0dd3de7e261" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557735} :answer-field/id #uuid "8f42970f-4984-520d-941e-e0592ead25ff" :answer-field/key "I" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186557742} {:answer-field/choices [{:answer/id #uuid "6e1002bb-1bee-5820-8a26-10c073faf6de" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557732} {:answer/id #uuid "a6603c9f-0137-5233-b184-8534c9f0657b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186557753}] :answer-field/correct {:answer/id #uuid "6e1002bb-1bee-5820-8a26-10c073faf6de" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186557732} :answer-field/id #uuid "efc99372-454a-53a1-8310-b02c6bdf8cea" 