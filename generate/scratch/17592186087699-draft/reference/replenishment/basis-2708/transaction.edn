ng $CA$, we get\n\n$$\n\\begin{aligned}CA & =\\begin{bmatrix}-\\frac{3}{4} & -\\frac{1}{2} \\\\ \\frac{3}{4} & -\\frac{1}{2}\\end{bmatrix}\\begin{bmatrix}-\\frac{2}{3} & \\frac{2}{3} \\\\ -1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & ={I}_{2}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true. As a result, $C={A}^{-1}$ and statement III is true too.\n\nTherefore, the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["1281b5f6-888b-5076-9c9c-6a0a1e2ba68c" "9bb2ac6e-0288-5117-97c1-496add602f0a" "0010b0e8-07d9-539f-b46c-d9a9cc6cbc1b"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "b4d3504c-74c3-5399-afd4-00228a26eb68" :question-generator/script "generate/scratch/17592186087699-draft.py"} [:db/add 17592186087699 :knowledge-point/question-generator "generator"] {:db/id 17592186087699 :knowledge-point/questions ["cea6932b-4af3-5566-9df5-ff31732c88bd" "4e4b2fd5-2934-5366-b945-a26f551d05d0" "1bf116bc-02e4-562f-804b-4b92d837e3aa" "933e41fa-bbab-5d05-965d-5162035714bc" "ecbed665-223e-5e83-ba22-20dfdfec9a21" "1a0b8b2e-0993-564b-9de2-b414008b167b" "944df8b7-b85c-56ef-a0a1-42de38bae564" "bf7c0c14-0345-5afe-989a-5e55f8a33abc" "8632e960-9b86-5855-8a4e-38962f598bce" "d965e44b-0fe0-517d-adf3-cf74e76369d6"]} [:db/ensure 17592186087699 :knowledge-point/validate]]
