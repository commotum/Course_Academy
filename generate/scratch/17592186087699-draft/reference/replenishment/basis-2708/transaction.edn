2}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{4} & ∗ \\\\ ∗ & ∗\\end{bmatrix} \\\\  & \\ne {I}_{2}.\\,\\times \\end{aligned}\n$$\n\nSo, statement II is false. As a result, $C\\ne {A}^{-1}$ and statement III is true.\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["3583ba2a-bb42-5b1a-b10d-98b42a330396" "30ed5c96-6ee0-5f39-93b3-2c433c407047" "48af3418-177d-51b4-8173-40bf69d832e1"] :db/ensure :question/validate} {:db/id "c2c423f1-fa46-5046-b322-201462bc9092" :answer/id #uuid "c2c423f1-fa46-5046-b322-201462bc9092" :answer/type :answer.type/text :answer/value "false" :db/ensure :answer/validate} {:db/id "9e9106c5-004e-5923-a1ee-f8a8ed480e8a" :answer/id #uuid "9e9106c5-004e-5923-a1ee-f8a8ed480e8a" :answer/type :answer.type/text :answer/value "true" :db/ensure :answer/validate} {:db/id "70d7643b-6104-537f-a2f7-ea56fddc6fea" :answer-field/id #uuid "70d7643b-6104-537f-a2f7-ea56fddc6fea" :answer-field/key "I" :answer-field/type :answer-field.type/checkbox :answer-field/choices ["c2c423f1-fa46-5046-b322-201462bc9092" "9e9106c5-004e-5923-a1ee-f8a8ed480e8a"] :answer-field/correct "9e9106c5-004e-5923-a1ee-f8a8ed480e8a" :db/ensure :answer-field/validate} {:db/id "e9d8a19d-14c7-57f9-99cc-9cac0d153cd9" :answer/id #uuid "e9d8a19d-14c7-57f9-99cc-9cac0d153cd9" :answer/type :answer.type/text :answer/value "true" :db/ensure :answer/validate} {:db/id "e1f18c79-3b49-530d-8454-86379c0b9403" :answer/id #uuid "e1f18c79-3b49-530d-8454-86379c0b9403" :answer/type :answer.type/text :answer/value "false" :db/ensure :answer/validate} {:db/id "6ee91bd2-1a95-558f-be1a-abb6d916f84b" :answer-field/id #uuid "6ee91bd2-1a95-558f-be1a-abb6d916f84b" :answer-field/key "II" :answer-field/type :answer-field.type/checkbox :answer-field/choices ["e9d8a19d-14c7-57f9-99cc-9cac0d153cd9" "e1f18c79-3b49-530d-8454-86379c0b9403"] :answer-field/correct "e1f18c79-3b49-530d-8454-86379c0b9403" :db/ensure :answer-field/validate} {:db/