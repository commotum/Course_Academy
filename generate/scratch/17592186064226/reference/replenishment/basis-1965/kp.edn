#{[{:db/id #edb/ref 17592186064226 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064094 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/id #uuid "68d2eb66-87ab-5182-9669-376bd1f70673" :question/math-academy-id "e-474" :question/problem "Calculate $\\displaystyle \\int_0^{\\pi/3} \\dfrac{\\sin x}{\\cos^2 x}\\,\\textrm d x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int_0^{\\pi/3} \\dfrac{\\sin x}{\\cos^2 x}\\,\\textrm d x =  \\int_0^{\\pi/3} \\dfrac{1}{\\cos x}\\cdot \\dfrac{\\sin x}{\\cos x}\\,\\textrm d x.\n$$\n\nWe then use the fact that $\\dfrac{\\sin x }{\\cos x}  = \\tan x$ and $\\dfrac{1}{\\cos x} = \\sec x$ to express this as\n\n$$\n\\int_0^{\\pi/3} \\sec x\\tan x\\,\\textrm d x,\n$$\n\nwhich is a standard trigonometric integral. Therefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x{|}_{0}^{\\pi /3} \\\\  & =\\operatorname{sec}⁡(\\frac{\\pi }{3})-\\operatorname{sec}⁡(0) \\\\  & =2-1 \\\\  & =1.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/questions [{:db/id #edb/ref 17592186064858 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3541e9d4-b110-5c63-a736-7fc7f4d31791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186330422} {:answer/id #uuid "86df8515-e1e9-50e5-8ffa-c0f477c898b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331153} {:answer/id #uuid "9dec32d8-d9c0-5660-8378-5288983a6ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331364} {:answer/id #uuid "a3922fe0-a979-577b-8dba-fd55ff68e732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331416} {:answer/id #uuid "f1373522-1826-5a96-a8aa-2b1480b28e0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186332069}] :answer-field/correct {:answer/id #uuid "86df8515-e1e9-50e5-8ffa-c0f477c898b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331153} :answer-field/id #uuid "dc984231-74ce-5ee3-a0d9-26f2e71c9fc8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c589cab7-d081-524b-ae47-ab787d74dcb4" :question/math-academy-id "q-49273" :question/problem "$\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+{cot}^{2}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${cot}^{2}⁡x=\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\frac{1}{{cos}^{2}⁡x}\\cdot {cos}^{3}⁡x+\\frac{1}{{cos}^{2}⁡x}\\cdot \\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+\\frac{1}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+{csc}^{2}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186064859 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16897289-4603-55b3-85a9-7a4e51b12fc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\operatorname{tan}⁡x\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186330138} {:answer/id #uuid "351bd75d-098f-5b2a-b526-a98d2a025590" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}{tan}^{2}⁡x{sec}^{2}⁡x+C" :db/id #edb/ref 17592186330419} {:answer/id #uuid "50b59dc3-9cc4-5d56-8dae-d5fde6823b0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}{tan}^{2}⁡x+C" :db/id #edb/ref 17592186330681} {:answer/id #uuid "9532f3f6-9b3e-5893-931d-79b72c8db1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}{csc}^{2}⁡x+C" :db/id #edb/ref 17592186331272} {:answer/id #uuid "bc8968e8-f099-5f73-8828-0a36b59f6c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331612}] :answer-field/correct {:answer/id #uuid "bc8968e8-f099-5f73-8828-0a36b59f6c6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331612} :answer-field/id #uuid "6b7347c5-9c24-53ba-ae9d-867009e5aca2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f71f24a-4751-5945-a98f-4a541dbf6232" :question/math-academy-id "q-49275" :question/problem "Calculate $\\int \\frac{{tan}^{2}⁡x}{8{sin}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{tan}^{2}⁡x}{8{sin}^{2}⁡x}\\,\\text{d}x=\\frac{1}{8}\\int {tan}^{2}⁡x\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ and $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{{tan}^{2}⁡x}{8{sin}^{2}⁡x}\\,\\text{d}x & =\\frac{1}{8}\\int {tan}^{2}⁡x\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int {(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})}^{2}\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int \\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int {(\\frac{1}{\\operatorname{cos}⁡x})}^{2}\\text{d}x \\\\  & =\\frac{1}{8}\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{tan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250232 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d87cf2-ba4e-5ee2-b888-16334d204447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}-1)" :db/id #edb/ref 17592186247661} {:answer/id #uuid "1bfa8fa7-c8a9-5491-a85f-a85434d1131e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}-2)" :db/id #edb/ref 17592186247678} {:answer/id #uuid "5b42bf75-0d9b-5855-aac9-9999790d5338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-3" :db/id #edb/ref 17592186248251} {:answer/id #uuid "a03cb483-a296-5946-8a8d-952eac55cad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}+1)" :db/id #edb/ref 17592186248855} {:answer/id #uuid "aedb9126-7c6d-5c55-ad4b-869a319638e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186248989}] :answer-field/correct {:answer/id #uuid "19d87cf2-ba4e-5ee2-b888-16334d204447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(\\sqrt{2}-1)" :db/id #edb/ref 17592186247661} :answer-field/id #uuid "0416b7bd-da37-58c6-8855-48ba00ca405e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249671}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "edc6fd62-64ca-5ae7-b219-55728bf85a2e" :question/math-academy-id "q-114306" :question/problem "${\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x,$ as follows:\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =3[\\operatorname{sec}⁡(\\frac{\\pi }{4})-\\operatorname{sec}⁡0] \\\\  & =3(\\sqrt{2}-1)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250236 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2621a51d-6ea2-5c0c-b0e8-ef9a5309fa09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186247760} {:answer/id #uuid "679c8c73-db45-58a5-8311-c18d1aa796b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186248353} {:answer/id #uuid "a8bb94e3-7ab2-5067-a9f7-907364396e08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x+\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186248924} {:answer/id #uuid "cc6ee47a-69b2-58b2-804c-4404e96412f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186249242} {:answer/id #uuid "e05fabc1-bec3-5016-a5ff-3dafd2caba5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186249410}] :answer-field/correct {:answer/id #uuid "679c8c73-db45-58a5-8311-c18d1aa796b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186248353} :answer-field/id #uuid "580bbc55-c5cf-5ded-aa0f-fb666956d730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249830}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6eaf6d0-3cca-5bcd-87e4-c38716de9570" :question/math-academy-id "q-114313" :question/problem "$\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x=\\int \\frac{1}{\\operatorname{tan}⁡x}(\\operatorname{sin}⁡x-\\operatorname{csc}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{tan}⁡x}=\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}$ to express this as\n\n$$\n\\begin{aligned}\\int \\operatorname{cot}⁡x(\\operatorname{sin}⁡x-\\operatorname{csc}⁡x)\\text{d}x & =\\int (\\operatorname{cot}⁡x\\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot \\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot \\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x & =\\int (\\operatorname{cos}⁡x-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{sin}⁡x+\\operatorname{csc}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250238 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47c3019c-5b9e-5399-b786-04437705e092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186248061} {:answer/id #uuid "6f81ffd7-1892-5f9b-9320-925504438589" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}-2" :db/id #edb/ref 17592186248407} {:answer/id #uuid "89d313a8-f000-577f-a816-a34a6622496f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186248650} {:answer/id #uuid "a7092c76-1bc1-50c0-b6c7-d05f207eda48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+1}{2}" :db/id #edb/ref 17592186248909} {:answer/id #uuid "e2f08285-93fd-5b63-ade9-e4f908688cd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-2}{3}" :db/id #edb/ref 17592186249429}] :answer-field/correct {:answer/id #uuid "47c3019c-5b9e-5399-b786-04437705e092" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186248061} :answer-field/id #uuid "4a1b567b-6514-5d16-ba8c-83023f80f2da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "062977fc-037b-5a67-9a07-c0d038a63f3e" :question/math-academy-id "q-114318" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{\\pi /4}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x={\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{sin}⁡x}=\\operatorname{csc}⁡x$ and $\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\operatorname{cot}⁡x$ to express this as\n\n$$\n{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-[\\operatorname{csc}⁡(\\frac{\\pi }{2})-\\operatorname{csc}⁡(\\frac{\\pi }{4})] \\\\  & =-[1-\\sqrt{2}] \\\\  & =\\sqrt{2}-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321044 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462d7b89-af8a-5c2e-b805-e15614972827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186319600}] :answer-field/correct {:answer/id #uuid "462d7b89-af8a-5c2e-b805-e15614972827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186319600} :answer-field/id #uuid "1aa61f05-88d7-5c7e-bfdb-5df86d383bfb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320228}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af52ce4e-f719-5000-b6c3-23ef65c6c7c7" :question/math-academy-id "q-352848" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the identities $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$  and  $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x,$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\text{d}x & ={\\int }_{0}^{\\pi /6}(1-{tan}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}(1-\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}(\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{cos}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}{sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x{|}_{0}^{\\pi /6} \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{6})-\\operatorname{tan}⁡0 \\\\  & =\\frac{\\sqrt{3}}{3}-0 \\\\  & =\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321045 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b25d05e-a29c-5b3e-80ba-83d6aca552d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}+\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186319807}] :answer-field/correct {:answer/id #uuid "8b25d05e-a29c-5b3e-80ba-83d6aca552d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}+\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186319807} :answer-field/id #uuid "1884c79a-7c8a-55aa-8077-27787e875e2f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320220}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b97a69d0-fbb0-59ef-94ce-c6ff4a9fe97d" :question/math-academy-id "q-352853" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the identities $\\frac{1}{\\operatorname{sec}⁡x}=\\operatorname{cos}⁡x$  and  $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\text{d}x & ={\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\cdot (1+\\operatorname{tan}⁡x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x(1+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x){|}_{0}^{\\pi /3} \\\\  & =(\\frac{\\sqrt{3}}{2}-\\frac{1}{2})-(0-1) \\\\  & =\\frac{1}{2}+\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321046 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b125d5a-83ca-5e84-9c6c-1590eeef63a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186319660}] :answer-field/correct {:answer/id #uuid "5b125d5a-83ca-5e84-9c6c-1590eeef63a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186319660} :answer-field/id #uuid "33891e7d-5b36-5ffb-bf17-86c9a9e0a09e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320286}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32053bdd-3d3f-5ab1-835c-4a43eb611286" :question/math-academy-id "q-352858" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /8}\\frac{\\operatorname{cot}⁡4x}{\\operatorname{csc}⁡4x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /8}\\frac{\\operatorname{cot}⁡4x}{\\operatorname{csc}⁡4x}\\,\\text{d}x={\\int }_{0}^{\\pi /8}\\operatorname{cot}⁡4x\\cdot \\frac{1}{\\operatorname{csc}⁡4x}\\,\\text{d}x.\n$$\n\nThen, we use the fact that $\\operatorname{cot}⁡4x=\\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}$ and $\\frac{1}{\\operatorname{csc}⁡4x}=\\operatorname{sin}⁡4x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /8}\\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}\\cdot \\operatorname{sin}⁡4x\\,\\text{d}x & ={\\int }_{0}^{\\pi /8}\\operatorname{cos}⁡4x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=4x.$ Then $\\text{d}x=\\frac{1}{4}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=4x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi }{2}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /8}\\operatorname{cos}⁡4x\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡u{|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{4}(sin\\,(\\frac{\\pi }{2})-sin\\,(0)) \\\\  & =\\frac{1}{4}(1-0) \\\\  & =\\frac{1}{4}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321047 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa67265c-58c2-5525-a76e-07d76e4d6c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186319907}] :answer-field/correct {:answer/id #uuid "aa67265c-58c2-5525-a76e-07d76e4d6c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186319907} :answer-field/id #uuid "2de44fcf-9a78-5bd7-9b48-93e1a12d9e69" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6cc98cbb-1926-5fbd-b202-06c3cb8a795d" :question/math-academy-id "q-352867" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /10}\\frac{\\operatorname{cot}⁡5x}{\\operatorname{csc}⁡5x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We can rewrite the integral as\n\n$$\n{\\int }_{0}^{\\pi /10}\\frac{\\operatorname{cot}⁡5x}{\\operatorname{csc}⁡5x}\\,\\text{d}x={\\int }_{0}^{\\pi /10}\\operatorname{cot}⁡5x\\cdot \\frac{1}{\\operatorname{csc}⁡5x}\\,\\text{d}x.\n$$\n\nThen, we use the fact that $\\operatorname{cot}⁡5x=\\frac{\\operatorname{cos}⁡5x}{\\operatorname{sin}⁡5x}$ and $\\frac{1}{\\operatorname{csc}⁡5x}=\\operatorname{sin}⁡5x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /10}\\frac{\\operatorname{cos}⁡5x}{\\operatorname{sin}⁡5x}\\cdot \\operatorname{sin}⁡5x\\,\\text{d}x & ={\\int }_{0}^{\\pi /10}\\operatorname{cos}⁡5x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=5x.$ Then $\\text{d}x=\\frac{1}{5}\\text{d}u.$\n\nNow, we fill the table for the limits of integration, according to the rule $u=5x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{10}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi }{2}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /10}\\operatorname{cos}⁡5x\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{1}{5}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{5}\\operatorname{sin}⁡u{|}_{0}^{\\pi /2} \\\\  & =\\frac{1}{5}(sin\\,(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{5}(1-0) \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186321048 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75781285-f568-5213-b859-431f02aade49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186319746}] :answer-field/correct {:answer/id #uuid "75781285-f568-5213-b859-431f02aade49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186319746} :answer-field/id #uuid "c391ebff-e18b-5edc-94f9-bf83e99d6410" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c92829c-a2f6-56f6-ab9b-8cc246269a34" :question/math-academy-id "q-352868" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /12}\\frac{\\operatorname{tan}⁡4x}{\\operatorname{sec}⁡4x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We can rewrite the integral as\n\n$$\n{\\int }_{0}^{\\pi /12}\\frac{\\operatorname{tan}⁡4x}{\\operatorname{sec}⁡4x}\\,\\text{d}x={\\int }_{0}^{\\pi /12}\\operatorname{tan}⁡4x\\cdot \\frac{1}{\\operatorname{sec}⁡4x}\\,\\text{d}x.\n$$\n\nThen, we use the fact that $\\operatorname{tan}⁡4x=\\frac{\\operatorname{sin}⁡4x}{\\operatorname{cos}⁡4x}$ and $\\frac{1}{\\operatorname{sec}⁡4x}=\\operatorname{cos}⁡4x$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /12}\\frac{\\operatorname{sin}⁡4x}{\\operatorname{cos}⁡4x}\\cdot \\operatorname{cos}⁡4x\\,\\text{d}x & ={\\int }_{0}^{\\pi /12}\\operatorname{sin}⁡4x\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=4x.$ Then $\\text{d}x=\\frac{1}{4}\\text{d}u.$\n\nNow, we fill the table for the limits of integration, according to the rule $u=4x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{12}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi }{3}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /12}\\operatorname{sin}⁡4x\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\operatorname{cos}⁡u{|}_{0}^{\\pi /3} \\\\  & =-\\frac{1}{4}(cos\\,(\\frac{\\pi }{3})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{4}(\\frac{1}{2}-1) \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332693 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48b77ad6-2790-5fb9-ac75-c531ab004c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186330601} {:answer/id #uuid "8a571c79-fa20-5257-bd99-b3a3310b2bcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}-1" :db/id #edb/ref 17592186331178} {:answer/id #uuid "8b31c3cf-dd75-5df7-9b83-aa025a1ed598" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}-1" :db/id #edb/ref 17592186331185} {:answer/id #uuid "9549f7ba-8509-55bb-ac17-34f5f78e130c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186331274} {:answer/id #uuid "d75920df-cc3f-5f99-8620-29d4802abe07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186331854}] :answer-field/correct {:answer/id #uuid "48b77ad6-2790-5fb9-ac75-c531ab004c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186330601} :answer-field/id #uuid "075617b4-7fd7-5fe0-bba2-6157b32a856f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332206}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a78f750a-573a-57da-b09b-e012074904df" :question/math-academy-id "q-49284" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\text{d}x={\\int }_{0}^{\\pi /4}\\frac{1}{\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x\n$$\n\nWe use the fact that $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ and $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x$ to express this as\n\n$$\n{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\text{d}x & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x{|}_{0}^{\\pi /4} \\\\  & =(\\operatorname{sec}⁡(\\frac{\\pi }{4})-\\operatorname{sec}⁡(0)) \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341953 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e77e606-3fbe-52e7-aab0-b4caa65a952e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-2" :db/id #edb/ref 17592186339394} {:answer/id #uuid "1f1abc9f-f1fd-5412-8a4f-d3cc8ce84141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339400} {:answer/id #uuid "4b46d088-8900-59df-a294-e9c5fdb831c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339803} {:answer/id #uuid "caf8e344-d78b-5248-b740-b9b631236223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340926} {:answer/id #uuid "dbec64d1-1c16-522f-a4e9-422136eadbca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186341080}] :answer-field/correct {:answer/id #uuid "1f1abc9f-f1fd-5412-8a4f-d3cc8ce84141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339400} :answer-field/id #uuid "934751e0-e49e-590a-9aa0-5f8c7d1fc3cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47640681-1f63-58a5-b2bd-140af66b43bb" :question/math-academy-id "q-73361" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\text{d}x={\\int }_{0}^{\\pi /4}\\frac{1}{\\operatorname{sec}⁡x}\\cdot (1+\\operatorname{tan}⁡x)\\,\\text{d}x\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ and $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}.$ Therefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{1}{\\operatorname{sec}⁡x}\\cdot (1+\\operatorname{tan}⁡x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡x\\cdot (1+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x){|}_{0}^{\\pi /4} \\\\  & (\\operatorname{sin}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(\\frac{\\pi }{4}))-(\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0)) \\\\  & =(\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2})-(0-1) \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342192 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58575d51-ffdd-543a-bade-6634febbdd76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cot}^{2}⁡4x+C" :db/id #edb/ref 17592186339934} {:answer/id #uuid "7a186c20-1506-5364-98fb-f5f5b90eafc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}{sin}^{2}⁡4x+C" :db/id #edb/ref 17592186340219} {:answer/id #uuid "a09f4f00-858f-53bb-8ec8-28c387d75743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{csc}⁡4x+C" :db/id #edb/ref 17592186340585} {:answer/id #uuid "b49ad4dc-2081-5be8-ae64-74edb3e4c85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{csc}^{2}⁡4x+C" :db/id #edb/ref 17592186340766} {:answer/id #uuid "d84932da-0d02-599c-86d1-0c8975757cc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{cot}⁡4x+C" :db/id #edb/ref 17592186341049}] :answer-field/correct {:answer/id #uuid "a09f4f00-858f-53bb-8ec8-28c387d75743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{csc}⁡4x+C" :db/id #edb/ref 17592186340585} :answer-field/id #uuid "d2214d64-85df-5343-8f56-2f58cd99796e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341750}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6ad08b6-febc-5a5b-8528-78fb972c420b" :question/math-academy-id "q-74279" :question/problem "Calculate $\\int \\frac{\\operatorname{cos}⁡4x}{{sin}^{2}⁡4x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{\\operatorname{cos}⁡4x}{{sin}^{2}⁡4x}\\,\\text{d}x=\\int \\frac{1}{\\operatorname{sin}⁡4x}\\cdot \\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}=\\operatorname{cot}⁡4x$ and $\\frac{1}{\\operatorname{sin}⁡4x}=\\operatorname{csc}⁡4x$ to express this as\n\n$$\n\\int \\operatorname{csc}⁡4x\\operatorname{cot}⁡4x\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=4x.$ Then $\\text{d}x=\\frac{1}{4}\\text{d}u.$ Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{csc}⁡4x\\operatorname{cot}⁡4x\\,\\text{d}x & =\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\operatorname{csc}⁡u+C \\\\  & =-\\frac{1}{4}\\operatorname{csc}⁡4x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342193 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c30e3f-d29e-5013-9514-d17c3eee3460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186339466} {:answer/id #uuid "376779f8-ab66-595c-9bd0-478fd63c0239" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡x+C" :db/id #edb/ref 17592186339625} {:answer/id #uuid "447b1d64-6d6b-508d-818e-c81c4fc983e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186339733} {:answer/id #uuid "744da144-5af4-5254-8514-317a1d8d743d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡x\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186340164} {:answer/id #uuid "cf6a59f6-df8c-5517-879f-5849fb7de659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186340974}] :answer-field/correct {:answer/id #uuid "26c30e3f-d29e-5013-9514-d17c3eee3460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186339466} :answer-field/id #uuid "ede24e4d-4785-5cd1-8533-d9afadca7785" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "504ab9d3-58bf-5555-aee6-cd8fa47fea51" :question/math-academy-id "q-74281" :question/problem "Calculate $\\int \\frac{1-{cot}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{1-{cot}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x=\\int (1-{cot}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1-{cot}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x & =\\int (1-{cot}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int (1-\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int (\\frac{{sin}^{2}⁡x-{cos}^{2}⁡x}{{sin}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =-\\int (\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{sin}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =-\\int \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x\\end{aligned}\n$$\n\nNow we use the fact that $\\frac{1}{\\operatorname{sin}⁡x}=\\operatorname{csc}⁡x$ to express this as\n\n$$\n-\\int {csc}^{2}⁡x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}-\\int {csc}^{2}⁡x\\,\\text{d}x & =-(-\\operatorname{cot}⁡x)+C \\\\  & =\\operatorname{cot}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431111 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce83bb5-48a8-5755-a136-3a2157d2ef78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186431057} {:answer/id #uuid "854da0b1-b538-5abb-9128-538e7a7c49e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431075} {:answer/id #uuid "bb236701-7224-5bb8-9211-7b2730f8e9b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡x-\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186431083} {:answer/id #uuid "c6086863-df11-58f0-9fa7-5134443d4b1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431085} {:answer/id #uuid "ee6b0533-0ce9-53e9-9ea2-abb22d26246a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431093}] :answer-field/correct {:answer/id #uuid "c6086863-df11-58f0-9fa7-5134443d4b1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186431085} :answer-field/id #uuid "aca77544-0046-5524-9cef-1c8e548a94a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431105}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a4cd24e-1cbf-547b-aab3-c78dc742ec94" :question/math-academy-id "q-114308" :question/problem "$\\int \\frac{{tan}^{2}⁡x-{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{tan}^{2}⁡x-{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{sin}^{2}⁡x}({tan}^{2}⁡x-{sin}^{3}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${tan}^{2}⁡x=\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{sin}^{2}⁡x}(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}-{sin}^{3}⁡x)\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{tan}^{2}⁡x-{sin}^{3}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{sin}^{2}⁡x}(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}-{sin}^{3}⁡x)\\text{d}x \\\\  & =\\int (\\frac{1}{{sin}^{2}⁡x}\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x}-\\frac{1}{{sin}^{2}⁡x}\\cdot {sin}^{3}⁡x)\\text{d}x \\\\  & =\\int (\\frac{1}{{cos}^{2}⁡x}-\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int ({sec}^{2}⁡x-\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\operatorname{tan}⁡x-(-\\operatorname{cos}⁡x)+C \\\\  & =\\operatorname{tan}⁡x+\\operatorname{cos}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431112 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ade44e9-b6f9-500e-bc09-791aec3c4112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-1}{2}" :db/id #edb/ref 17592186431063} {:answer/id #uuid "6590c99b-1fe0-54a5-9f86-8aebcedc658b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186431071} {:answer/id #uuid "6d4d7986-64b5-5587-b804-bab2a0930585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186431072} {:answer/id #uuid "ae2dad62-d368-5197-b93b-e3e45fe17653" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186431081} {:answer/id #uuid "fd953cc5-abf5-5b0c-84f3-3e4672a326d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{3}" :db/id #edb/ref 17592186431097}] :answer-field/correct {:answer/id #uuid "6590c99b-1fe0-54a5-9f86-8aebcedc658b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186431071} :answer-field/id #uuid "e803221b-b806-5450-a5a1-2379c91d357f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49b73c78-3335-57b5-a631-c7f8dd771090" :question/math-academy-id "q-73365" :question/problem "Calculate ${\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x={\\int }_{0}^{\\pi /6}(1-{tan}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}(1-{tan}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}(1-\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}(\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{cos}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x\\end{aligned}\n$$\n\nNow we use the fact that $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ to express this as\n\n$$\n{\\int }_{0}^{\\pi /6}{sec}^{2}⁡x\\text{d}x.\n$$\n\nHence,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{1-{tan}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}{sec}^{2}⁡x\\text{d}x \\\\  & =\\operatorname{tan}⁡x{|}_{0}^{\\pi /6} \\\\  & =\\operatorname{tan}⁡(\\frac{\\pi }{6})-\\operatorname{tan}⁡0 \\\\  & =\\frac{\\sqrt{3}}{3}-0 \\\\  & =\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431113 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1161462-0f9d-545a-a5a5-27e6a35427ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}-1" :db/id #edb/ref 17592186431092}] :answer-field/correct {:answer/id #uuid "e1161462-0f9d-545a-a5a5-27e6a35427ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}-1" :db/id #edb/ref 17592186431092} :answer-field/id #uuid "5fe9e96d-c290-5de0-aea5-06fc2a18c7e7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186431102}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77e54e57-de69-5688-a9c9-dfe71c2ce5e6" :question/math-academy-id "q-352711" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the identities $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ and $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x,$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\frac{\\operatorname{sin}⁡x}{{cos}^{2}⁡x}\\text{d}x & ={\\int }_{0}^{\\pi /6}\\frac{1}{\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x{|}_{0}^{\\pi /6} \\\\  & =(\\operatorname{sec}⁡(\\frac{\\pi }{6})-\\operatorname{sec}⁡(0)) \\\\  & =\\frac{2}{\\sqrt{3}}-1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431114 :knowledge-point/_questions [{:db/id #edb/ref 17592186064226 :knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b90dc2-4752-56a7-9b8f-d500c9d40dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186431054} {:answer/id #uuid "1fc5523c-58ee-55e0-80dd-791ed4446cb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186431059} {:answer/id #uuid "a842be8e-7dd8-5330-8aa6-c7e1963f7629" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186431079} {:answer/id #uuid "c1c701b6-77f3-5b86-8e8d-cbfebc97a0af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186431084} {:answer/id #uuid "ffc2a33e-12cb-5317-9535-02af0caa9a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186431098}] :answer-field/correct {:answer/id #uuid "ffc2a33e-12cb-5317-9535-02af0caa9a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186431098} :answer-field/id #uuid "07a0cda5-2de4-5cc2-802a-a5549d6da26a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431099}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8cd683e0-e43d-570b-a907-b426c76c1c6f" :question/math-academy-id "q-114319" :question/problem "${\\int }_{0}^{\\pi /3}\\frac{\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /3}\\frac{\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x={\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{tan}⁡x\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}$ and $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ to express this as\n\n$$\n{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\cdot \\operatorname{tan}⁡x\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cos}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =-[\\operatorname{cos}⁡(\\frac{\\pi }{3})-\\operatorname{cos}⁡0] \\\\  & =-[\\frac{1}{2}-1] \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}]}
