+C" :db/id #edb/ref 17592186246540}] :answer-field/correct {:answer/id #uuid "fe7b45bc-963d-5b75-90cd-534a19df4dc1" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-2)^{8}+C" :db/id #edb/ref 17592186246540} :answer-field/id #uuid "0a68bc5e-3ec4-5e14-bd3f-0dd750983f99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3a2c849-8914-5088-a188-98bfa5cab912" :question/math-academy-id "q-113486" :question/problem "$\\int 48(3x-2)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=3x-2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 48(3x-2)^{7}\\,\\text{d}x & =\\int 48{u}^{7}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =48\\cdot \\frac{1}{3}\\int {u}^{7}\\,\\text{d}u \\\\  & =16\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =2\\cdot {u}^{8}+C \\\\  & =2(3x-2)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[2(3x-2)^{8}+C] & =\\frac{\\text{d}}{\\text{d}x}[2(3x-2)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =16(3x-2)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(3x-2)+0 \\\\  & =16(3x-2)^{7}\\cdot 3 \\\\  & =48(3x-2)^{7}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247355 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76cedac8-895d-5870-9926-547142cb0878" :answer/type {:db/ident :answer.type/math} :answer/value "6(5-3x)^{3}+C" :db/id #edb/ref 17592186245369} {:answer/id #uuid "7cb3d7f9-74fd-5833-830c-4bb663c58640" :answer/type {:db/ident :answer.type/math} :answer/value "-2(5-3x)^{3}+C" :db/id #edb/ref 17592186245406} {:answer/id #uuid "9c74adb4-1a2f-50e8-94b8-808066441c8a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}(5-3x)^{3}+C" :db/id #edb/ref 17592186245702} {:answer/id #uuid "9d96ffde-3b7c-59c4-81a4-cea06efe1c34" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}(5-3x)^{3}+C" :db/id #edb/ref 17592186245718} {:answer/id #uuid "d49f4656-7b64-54df-bf20-328340180875" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}(5-3x)^{3}+C" :db/id #edb/ref 17592186246210}] :answer-field/correct {:answer/id #uuid "9d96ffde-3b7c-59c4-81a4-cea06efe1c34" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}(5-3x)^{3}+C" :db/id #edb/ref 17592186245718} :answer-field/id #uuid "bfc4b084-cb82-5c30-a425-7b47c8dea13e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b151b1a4-88b3-56e5-8da5-20d1f21f5f65" :question/math-academy-id "q-113492" :question/problem "$\\int 6(5-3x)^{2}\\,\\text{d}x=$" :question/worked-solution "Let $u=5-3x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\,⟹\\,\\text{d}x=-\\frac{1}{3}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 6(5-3x)^{2}\\,\\text{d}x & =\\int 6{u}^{2}\\cdot (-\\frac{1}{3})\\,\\text{d}u \\\\  & =6\\cdot (-\\frac{1}{3})\\int {u}^{2}\\cdot \\,\\text{d}u \\\\  & =-2\\int {u}^{2}\\,\\text{d}u \\\\  & =-2\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =-\\frac{2}{3}{u}^{3}+C \\\\  & =-\\frac{2}{3}(5-3x)^{3}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{2}{3}(5-3x)^{3}+C] & =-\\frac{\\text{d}}{\\text{d}x}[\\frac{2}{3}(5-3x)^{3}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-2(5-3x)^{2}\\cdot \\frac{\\text{d}}{\\text{d}x}(5-3x)+0 \\\\  & =-2(5-3x)^{2}\\cdot (-3) \\\\  & =6(5-3x)^{2}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186247358 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33cd6666-68ef-5587-af38-937538b7c7d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3-2x)^{9}+C" :db/id #edb/ref 17592186244778} {:answer/id #uuid "a23e3f18-ccf0-5edd-90a9-074f7bdc257a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}(3-2x)^{9}+C" :db/id #edb/ref 17592186245761} {:answer/id #uuid "a2a116a5-5195-5bb5-8d8f-c3d5bdb58287" :answer/type {:db/ident :answer.type/math} :answer/value "9(3-2x)^{9}+C" :db/id #edb/ref 17592186245768} {:answer/id #uuid "adf08c69-5710-5d54-9609-99700fa1b4c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}(3-2x)^{9}+C" :db/id #edb/ref 17592186245866} {:answer/id #uuid "cdf80ff9-edcb-547d-a18d-0ec0592f5a18" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(3-2x)^{9}+C" :db/id #edb/ref 17592186246151}] :answer-field/correct {:answer/id #uuid "cdf80ff9-edcb-547d-a18d-0ec0592f5a18" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(3-2x)^{9}+C" :db/id #edb/ref 17592186246151} :answer-field/id #uuid "5e9dc6ab-32fe-57ad-a8b7-97d5999f7994" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4aa132c6-373a-5f63-a95e-dc8b634b917a" :question/math-academy-id "q-113503" :question/problem "$\\int 9(3-2x)^{8}\\,\\text{d}x=$" :question/worked-solution "Let $u=3-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 9(3-2x)^{8}\\,\\text{d}x & =\\int 9{u}^{8}\\cdot (-\\frac{1}{2})\\text{d}u \\\\  & =9\\cdot (-\\frac{1}{2})\\int {u}^{8}\\cdot \\,\\text{d}u \\\\  & =-\\frac{9}{2}\\int {u}^{8}\\,\\text{d}u \\\\  & =-\\frac{9}{2}\\cdot \\frac{{u}^{9}}{9}+C \\\\  & =-\\frac{1}{2}{u}^{9}+C \\\\  & =-\\frac{1}{2}(3-2x)^{9}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2}(3-2x)^{9}+C] & =-\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{2}(3-2x)^{9}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{9}{2}(3-2x)^{8}\\cdot \\frac{\\text{d}}{\\text{d}x}(3-2x)+0 \\\\  & =-\\frac{9}{2}(3-2x)^{8}\\cdot (-2) \\\\  & =9(3-2x)^{8}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186398102 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326be129-c932-54e7-bd6e-d61f8a6c1750" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{18}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398104} {:answer/id #uuid "d8f6915c-a30b-538c-be4c-c5d4feafc456" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398105} {:answer/id #uuid "d929af17-b6b6-5bb1-9948-38e8c5714648" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398106} {:answer/id #uuid "e257789f-7b07-5075-adc9-57e60483dc0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398107} {:answer/id #uuid "65143245-b12a-5ed5-a1a3-dc55de2b261a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{15}(2-5x)^{6}+C" :db/id #edb/ref 17592186398108}] :answer-field/correct {:answer/id #uuid "d8f6915c-a30b-538c-be4c-c5d4feafc456" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398105} :answer-field/id #uuid "0d582062-813e-5b4d-b116-6b4cb9d5d390" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398103}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "201b1303-edfe-5a94-b70a-3687fd03d284" :question/math-academy-id "q-113502" :question/problem "$\\int 18(2-5x)^{5}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 18(2-5x)^{5}\\,\\text{d}x & =\\int 18{u}^{5}\\cdot (-\\frac{1}{5})\\text{d}u \\\\  & =18\\cdot (-\\frac{1}{5})\\int {u}^{5}\\cdot \\,\\text{d}u \\\\  & =-\\frac{18}{5}\\int {u}^{5}\\,\\text{d}u \\\\  & =-\\frac{18}{5}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{3}{5}{u}^{6}+C \\\\  & =-\\frac{3}{5}(2-5x)^{6}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{3}{5}(2-5x)^{6}+C] & =-\\frac{\\text{d}}{\\text{d}x}[\\frac{3}{5}(2-5x)^{6}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot \\frac{\\text{d}}{\\text{d}x}(2-5x)+0 \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot (-5) \\\\  & =18(2-5x)^{5}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186398961 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} {:answer/id #uuid "615ab3c3-1cc9-56db-a561-9ade7641ace4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398964} {:answer/id #uuid "2b200597-1f86-5ecd-b8bc-18b09c132aad" :answer/type {:db/ident :answer.type/math} :answer/value "(7-2x)^{8}+C" :db/id #edb/ref 17592186398965} {:answer/id #uuid "13a3fa38-b420-5956-8a4b-2194f2d8ef30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}(7-2x)^{8}+C" :db/id #edb/ref 17592186398966} {:answer/id #uuid "5674f007-df38-5b04-ac90-1342c70182a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398967}] :answer-field/correct {:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} :answer-field/id #uuid "6ee57767-a470-5ed2-888e-e7479cb9accb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c75bb9c-44e2-5f73-9a68-3c296ae237a7" :question/math-academy-id "q-72424" :question/problem "$\\int 16(7-2x)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=7-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 16(7-2x)^{7}\\,\\text{d}x & =\\int 16{u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\int {u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\cdot (-\\frac{1}{2})\\int {u}^{7}\\,\\text{d}u \\\\  & =-8\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =-{u}^{8}+C \\\\  & =-(7-2x)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-(7-2x)^{8}+C] & =-\\frac{\\text{d}}{\\text{d}x}[(7-2x)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-8(7-2x)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(7-2x)+0 \\\\  & =-8(7-2x)^{7}\\cdot (-2) \\\\  & =16(7-2x)^{7}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485716 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7377f12f-bbc8-5b20-aa7a-f0707a87a5ac" :answer/type {:db/ident :answer.type/math} :answer/value "16(3x-7)^{8}+C" :db/id #edb/ref 17592186485725} {:answer/id #uuid "77281a58-3d49-5fd8-a3b1-1af350ca3499" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3x-7)^{8}+C" :db/id #edb/ref 17592186485726} {:answer/id #uuid "8ed06ac1-fd5a-51e5-a93c-e84caa88a78a" :answer/type {:db/ident :answer.type/math} :answer/value "8(3x-7)^{8}+C" :db/id #edb/ref 17592186485730} {:answer/id #uuid "9f78c7e8-599a-56d5-9dae-9aea344e3c62" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-7)^{8}+C" :db/id #edb/ref 17592186485732} {:answer/id #uuid "be5bbccf-1a6d-5e2d-9e42-d65a07463850" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}(3x-7)^{8}+C" :db/id #edb/ref 17592186485738}] :answer-field/correct {:answer/id #uuid "9f78c7e8-599a-56d5-9dae-9aea344e3c62" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-7)^{8}+C" :db/id #edb/ref 17592186485732} :answer-field/id #uuid "aa23e206-e2c7-5918-8bd9-348e98fbec24" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485734}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22ca9ca5-3802-5b5f-8227-216a5d3cf02e" :question/problem "$\\int 48(3x-7)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=3x-7.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 48(3x-7)^{7}\\,\\text{d}x & =\\int 48{u}^{7}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =48\\cdot \\frac{1}{3}\\int {u}^{7}\\,\\text{d}u \\\\  & =16\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =2\\cdot {u}^{8}+C \\\\  & =2(3x-7)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[2(3x-7)^{8}+C] & =\\frac{\\text{d}}{\\text{d}x}[2(3x-7)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =16(3x-7)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(3x-7)+0 \\\\  & =16(3x-7)^{7}\\cdot 3 \\\\  & =48(3x-7)^{7}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485721 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choic