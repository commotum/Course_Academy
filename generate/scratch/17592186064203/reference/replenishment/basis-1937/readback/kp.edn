db/ident :answer.type/math} :answer/value "16(3x-3)^{8}+C" :db/id #edb/ref 17592186485731} {:answer/id #uuid "bb923d54-7741-53b9-97a9-ae6d17fefaea" :answer/type {:db/ident :answer.type/math} :answer/value "8(3x-3)^{8}+C" :db/id #edb/ref 17592186485736} {:answer/id #uuid "ed546a36-da04-5b10-afcd-713ccfc4f479" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-3)^{8}+C" :db/id #edb/ref 17592186485743}] :answer-field/correct {:answer/id #uuid "ed546a36-da04-5b10-afcd-713ccfc4f479" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-3)^{8}+C" :db/id #edb/ref 17592186485743} :answer-field/id #uuid "5e794a0a-3082-5da9-8a0e-f71bd5273e3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7b871d9-2b64-5d5f-980a-acf58621c326" :question/problem "$\\int 48(3x-3)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=3x-3.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 48(3x-3)^{7}\\,\\text{d}x & =\\int 48{u}^{7}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =48\\cdot \\frac{1}{3}\\int {u}^{7}\\,\\text{d}u \\\\  & =16\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =2\\cdot {u}^{8}+C \\\\  & =2(3x-3)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[2(3x-3)^{8}+C] & =\\frac{\\text{d}}{\\text{d}x}[2(3x-3)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =16(3x-3)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(3x-3)+0 \\\\  & =16(3x-3)^{7}\\cdot 3 \\\\  & =48(3x-3)^{7}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485746 :knowledge-point/_questions [{:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c3f877-a893-5024-bb8c-047db29a33f9" :answer/type {:db/ident :answer.type/math} :answer/value "8(3x-1)^{8}+C" :db/id #edb/ref 17592186485712} {:answer/id #uuid "27297270-ed6e-5a77-b95c-b94f11821c79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}(3x-1)^{8}+C" :db/id #edb/ref 17592186485717} {:answer/id #uuid "7ae58990-6a59-5ad7-a808-52a7616ed5e7" :answer/type {:db/ident :answer.type/math} :answer/value "16(3x-1)^{8}+C" :db/id #edb/ref 17592186485727} {:answer/id #uuid "ac265dc5-84e4-5ff4-ac5a-405b42e5e55c" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-1)^{8}+C" :db/id #edb/ref 17592186485735} {:answer/id #uuid "e7cf2218-e43e-5b62-a006-74ce1a683da3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3x-1)^{8}+C" :db/id #edb/ref 17592186485740}] :answer-field/correct {:answer/id #uuid "ac265dc5-84e4-5ff4-ac5a-405b42e5e55c" :answer/type {:db/ident :answer.type/math} :answer/value "2(3x-1)^{8}+C" :db/id #edb/ref 17592186485735} :answer-field/id #uuid "e9b7264f-8376-5ba7-ab8c-5dd4567f8df3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd40cdc2-bda1-52a5-ab17-92f594c6d05e" :question/problem "$\\int 48(3x-1)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=3x-1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 48(3x-1)^{7}\\,\\text{d}x & =\\int 48{u}^{7}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =48\\cdot \\frac{1}{3}\\int {u}^{7}\\,\\text{d}u \\\\  & =16\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =2\\cdot {u}^{8}+C \\\\  & =2(3x-1)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[2(3x-1)^{8}+C] & =\\frac{\\text{d}}{\\text{d}x}[2(3x-1)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =16(3x-1)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(3x-1)+0 \\\\  & =16(3x-1)^{7}\\cdot 3 \\\\  & =48(3x-1)^{7}\\,✓\\end{aligned}\n$$"}] :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}]}
