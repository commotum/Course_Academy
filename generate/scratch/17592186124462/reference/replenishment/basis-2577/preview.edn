}_{0})$ can be written as:\n\n$$\n\\begin{aligned}(x-{x}_{0}){v}_{y}-(y-{y}_{0}){v}_{x} & =0 \\\\ (x-(-4))(0)-(y-(0))(-8) & =0 \\\\ 8 y & =0 \\\\ y & =0\\end{aligned}\n$$" 13194139535890 17592186045443 true] [17592186537085 1075 #edb/ref 17592186537094 13194139535890 17592186045443 true] [17592186537085 1075 #edb/ref 17592186537104 13194139535890 17592186045443 true] [17592186537085 1075 #edb/ref 17592186537117 13194139535890 17592186045443 true] [17592186537085 1075 #edb/ref 17592186537128 13194139535890 17592186045443 true] [17592186537085 1075 #edb/ref 17592186537132 13194139535890 17592186045443 true] [17592186537085 1076 #edb/ref 17592186045493 13194139535890 17592186045443 true] [17592186537085 1077 "selection" 13194139535890 17592186045443 true] [17592186537085 1078 #edb/ref 17592186537094 13194139535890 17592186045443 true] [17592186537085 1079 #uuid "031f356f-2821-5db9-9c7a-f7890bd14e91" 13194139535890 17592186045443 true] [17592186537086 1080 "3 x - 8 y - 18=0" 13194139535890 17592186045443 true] [17592186537086 1082 #edb/ref 17592186045498 13194139535890 17592186045443 true] [17592186537086 1083 #uuid "03eb4c04-9267-59ba-b869-c90be23347ec" 13194139535890 17592186045443 true] [17592186537087 1080 "y=0" 13194139535890 17592186045443 true] [17592186537087 1082 #edb/ref 17592186045498 13194139535890 17592186045443 true] [17592186537087 1083 #uuid "1898e89d-7f9b-5658-8c51-d493fe024120" 13194139535890 17592186045443 true] [17592186537088 1080 "2 x + 3 y + 1=0" 13194139535890 17592186045443 true] [17592186537088 1082 #edb/ref 17592186045498 13194139535890 17592186045443 true] [17592186537088 1083 #uuid "1a4413af-f625-5560-8d8d-c748e370cbfc" 13194139535890 17592186045443 true] [17592186537089 1080 "4 x + y - 2=0" 13194139535890 17592186045443 true] [17592186537089 1082 #edb/ref 17592186045498 13194139535890 17592186045443 true] [17592186537089 1083 #uuid "1b082478-c820-5762-b2a2-2a62271a3ef2" 13194139535890 17592186045443 true] [17592186537090 1080 "3 x + 4 y - 9