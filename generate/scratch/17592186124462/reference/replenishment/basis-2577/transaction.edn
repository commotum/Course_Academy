rmal vector to the curve at $(1,-1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-(1)}{6} & =\\frac{y-(-1)}{-8} \\\\ (-8)(x-(1)) & =(6)(y-(-1)) \\\\ (-4)(x-(1)) & =(3)(y-(-1)) \\\\ 4 - 4 x & =3 y + 3 \\\\ 4 x + 3 y - 1 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["23e7d9c2-c40a-577f-94ad-5274d43663ca"] :db/ensure :question/validate} {:db/id "6b145348-ee6b-5f83-a834-3612b52a8eea" :answer/id #uuid "6b145348-ee6b-5f83-a834-3612b52a8eea" :answer/type :answer.type/math :answer/value "x=0" :db/ensure :answer/validate} {:db/id "6863e39b-e96c-5223-ae3e-ba8869732589" :answer/id #uuid "6863e39b-e96c-5223-ae3e-ba8869732589" :answer/type :answer.type/math :answer/value "x + y + 4=0" :db/ensure :answer/validate} {:db/id "b325fe0e-0f75-587e-9349-5774ff912b6d" :answer/id #uuid "b325fe0e-0f75-587e-9349-5774ff912b6d" :answer/type :answer.type/math :answer/value "y=0" :db/ensure :answer/validate} {:db/id "dd9a8ba1-c9eb-55d2-9075-41f1ca7b26a6" :answer/id #uuid "dd9a8ba1-c9eb-55d2-9075-41f1ca7b26a6" :answer/type :answer.type/math :answer/value "x + 4=0" :db/ensure :answer/validate} {:db/id "80ba4577-cc56-5b55-8175-ebe29a27f6d5" :answer/id #uuid "80ba4577-cc56-5b55-8175-ebe29a27f6d5" :answer/type :answer.type/math :answer/value "y + 4=0" :db/ensure :answer/validate} {:db/id "aec42275-f52a-5401-85f4-ec74b7d1f15d" :answer-field/id #uuid "aec42275-f52a-5401-85f4-ec74b7d1f15d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["6b145348-ee6b-5f83-a834-3612b52a8eea" "6863e39b-e96c-5223-ae3e-ba8869732589" "b325fe0e-0f75-587e-9349-5774ff912b6d" "dd9a8ba1-c9eb-55d2-9075-41f1ca7b26a6" "80ba4577-cc56-5b55-8175-ebe29a27f6d5"] :answer-field/correct "b325fe0e-0f75-587e-9349-5774ff912b6d" :db/ensure :a