[{:db/id "4deadc9a-b2f2-567a-a980-49db2c37067b" :answer/id #uuid "4deadc9a-b2f2-567a-a980-49db2c37067b" :answer/type :answer.type/math :answer/value "- 2 r \\cos {\\theta}" :db/ensure :answer/validate} {:db/id "250dcc11-6c14-5c7a-8ca0-4baf461295c2" :answer/id #uuid "250dcc11-6c14-5c7a-8ca0-4baf461295c2" :answer/type :answer.type/math :answer/value "2 r \\cos {\\theta}" :db/ensure :answer/validate} {:db/id "7e03a989-2920-54d8-812f-4dcff83c2898" :answer/id #uuid "7e03a989-2920-54d8-812f-4dcff83c2898" :answer/type :answer.type/math :answer/value "2 r^{2} \\cos {\\theta}" :db/ensure :answer/validate} {:db/id "877fcc0c-4b48-5a6e-9f12-8460cbd39891" :answer/id #uuid "877fcc0c-4b48-5a6e-9f12-8460cbd39891" :answer/type :answer.type/math :answer/value "r \\cos {\\theta}" :db/ensure :answer/validate} {:db/id "8fcce618-3d7a-51a2-ad85-eb6bde2a4ecf" :answer/id #uuid "8fcce618-3d7a-51a2-ad85-eb6bde2a4ecf" :answer/type :answer.type/math :answer/value "2 r \\sin {\\theta}" :db/ensure :answer/validate} {:db/id "02ba1694-6948-5d59-ab5c-f346f0b0efa0" :answer-field/id #uuid "02ba1694-6948-5d59-ab5c-f346f0b0efa0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["4deadc9a-b2f2-567a-a980-49db2c37067b" "250dcc11-6c14-5c7a-8ca0-4baf461295c2" "7e03a989-2920-54d8-812f-4dcff83c2898" "877fcc0c-4b48-5a6e-9f12-8460cbd39891" "8fcce618-3d7a-51a2-ad85-eb6bde2a4ecf"] :answer-field/correct "250dcc11-6c14-5c7a-8ca0-4baf461295c2" :db/ensure :answer-field/validate} {:db/id "78de899d-6101-5c4a-ac37-a4bcf9390397" :question/id #uuid "78de899d-6101-5c4a-ac37-a4bcf9390397" :question/problem "Given that $f(r,\\theta)=r^{2}$, find $\\frac{∂f}{∂x}$, where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂f}{∂x}=\\frac{∂f}{∂r}\\cos \\theta-\\frac{1}{r}\\frac{∂f}{∂\\theta}\\sin \\theta.\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $r$ and $\\theta:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r}=2 r,\\,\\frac{∂f}{∂\\theta}=0\\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =(2 r)\\cos \\theta-\\frac{1}{r}(0)\\sin \\theta \\\\ & =2 r \\cos {\\theta}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["02ba1694-6948-5d59-ab5c-f346f0b0efa0"] :db/ensure :question/validate} {:db/id "e4493ba7-e108-5a71-9992-4b9775de69a7" :answer/id #uuid "e4493ba7-e108-5a71-9992-4b9775de69a7" :answer/type :answer.type/math :answer/value "- 8 r^{2} \\sin {\\theta}" :db/ensure :answer/validate} {:db/id "586adb3d-8dc3-5c10-b04c-05dd6518dacc" :answer/id #uuid "586adb3d-8dc3-5c10-b04c-05dd6518dacc" :answer/type :answer.type/math :answer/value "- 8 r \\sin {\\theta}" :db/ensure :answer/validate} {:db/id "18656e36-b360-596c-906f-c6142433c6c1" :answer/id #uuid "18656e36-b360-596c-906f-c6142433c6c1" :answer/type :answer.type/math :answer/value "- 4 r \\sin {\\theta}" :db/ensure :answer/validate} {:db/id "246038ff-e08b-58fe-a4b1-bafce1919350" :answer/id #uuid "246038ff-e08b-58fe-a4b1-bafce1919350" :answer/type :answer.type/math :answer/value "8 r \\sin {\\theta}" :db/ensure :answer/validate} {:db/id "9c4350a9-7085-544f-bc6e-0361174ad019" :answer/id #uuid "9c4350a9-7085-544f-bc6e-0361174ad019" :answer/type :answer.type/math :answer/value "- 8 r \\cos {\\theta}" :db/ensure :answer/validate} {:db/id "69718cef-56a9-51cb-be04-46c69783f886" :answer-field/id #uuid "69718cef-56a9-51cb-be04-46c69783f886" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["e4493ba7-e108-5a71-9992-4b9775de69a7" "586adb3d-8dc3-5c10-b04c-05dd6518dacc" "18656e36-b360-596c-906f-c6142433c6c1" "246038ff-e08b-58fe-a4b1-bafce1919350" "9c4350a9-7085-544f-bc6e-0361174ad019"] :answer-field/correct "586adb3d-8dc3-5c10-b04c-05dd6518dacc" :db/ensure :answer-field/validate} {:db/id "d17b89