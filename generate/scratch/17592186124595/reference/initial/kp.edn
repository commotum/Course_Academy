4\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂y} & =(\\operatorname{sin}⁡4\\theta )\\operatorname{sin}⁡\\theta +\\frac{1}{r}(4r\\operatorname{cos}⁡4\\theta )\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡4\\theta +4\\operatorname{cos}⁡4\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186368885 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60efe842-a152-5a8d-94b4-e0b50381d44a" :answer/type {:db/ident :answer.type/math} :answer/value "2r\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368887} {:answer/id #uuid "c5c358c5-25b8-5374-9d9d-f36d756d1533" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368888} {:answer/id #uuid "a2ab60a0-c20b-514b-93f7-be5b89a2ed07" :answer/type {:db/ident :answer.type/math} :answer/value "2r\\operatorname{sin}⁡\\theta -\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368889} {:answer/id #uuid "4f084c23-67fc-5831-a5d3-607d0f3f2651" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186368890} {:answer/id #uuid "c7fe4eeb-f778-583c-9aed-a3ec394140b5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186368891}] :answer-field/correct {:answer/id #uuid "c5c358c5-25b8-5374-9d9d-f36d756d1533" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186368888} :answer-field/id #uuid "208a9196-43b6-5acc-b9b2-19dc5589219d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368886}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4815c77-06a6-5342-87f5-965d49f4d616" :question/math-academy-id "q-95134" :question/problem "Given that $u(r,\\theta )=r(2+\\operatorname{sin}⁡\\theta ),$ find $\\frac{∂u}{∂x},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta )$ are the corresponding plane polar coordinates." :question/worked-solution "We will make use of the following chain rule formula:\n\n$$\n\\frac{∂u}{∂x}=\\frac{∂u}{∂r}\\operatorname{cos}⁡\\theta -\\frac{1}{r}\\frac{∂u}{∂\\theta }\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we find the partial derivatives of $u$ with respect to $r$ and $\\theta :$\n\n$$\n\\begin{aligned}\\frac{∂u}{∂r}=2+\\operatorname{sin}⁡\\theta ,\\,\\frac{∂u}{∂\\theta }=r\\operatorname{cos}⁡\\theta \\end{aligned}\n$$\n\nThen, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =(2+\\operatorname{sin}⁡\\theta )\\operatorname{cos}⁡\\theta -\\frac{1}{r}(r\\operatorname{cos}⁡\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479083 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8d5bbd-e2b1-533d-9bdd-c6ed6c668040" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta -\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta " :db/id #edb/ref 17592186478606} {:answer/id #uuid "6a2092ad-3f11-5666-b765-95bb966954f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478716} {:answer/id #uuid "6c9972e3-8762-5cb3-b03e-679f5020939c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡2\\theta -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡2\\theta " :db/id #edb/ref 17592186478720} {:answer/id #uuid "8baa2b02-1db0-5fce-a974-ddf0773d0