65} e^{2 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545056} :answer-field/id #uuid "9486b27a-eca6-5cf2-b8b3-18a79cfdeb1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545041}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "404e4eaf-6dc4-5c33-ad60-f972a5aec050" :question/problem "Which integral expression gives the arc length of the curve $r(t)=\\langle \\left(2 \\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)}\\right) e^{2 t},\\,2 t e^{2 t},\\,\\left(\\sin{\\left(3 t \\right)} - 2 \\cos{\\left(3 t \\right)}\\right) e^{2 t}\\rangle$ from $t=0$ to $t=1?$" :question/worked-solution "First, we find $r'(t)$ and $\\|r'(t)\\|:$\n\n$$\n\\begin{aligned}r'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(2 \\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)}\\right) e^{2 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t e^{2 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(\\sin{\\left(3 t \\right)} - 2 \\cos{\\left(3 t \\right)}\\right) e^{2 t})\\rangle \\\\  & =\\langle \\left(- 3 \\sin{\\left(3 t \\right)} + 6 \\cos{\\left(3 t \\right)}\\right) e^{2 t} + 2 \\left(2 \\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)}\\right) e^{2 t},\\,4 t e^{2 t} + 2 e^{2 t},\\,2 \\left(\\sin{\\left(3 t \\right)} - 2 \\cos{\\left(3 t \\right)}\\right) e^{2 t} + \\left(6 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{2 t}\\rangle \\\\ \\|r'(t)\\| & =\\sqrt{\\left(4 t e^{2 t} + 2 e^{2 t}\\right)^{2} + \\left(\\left(- 3 \\sin{\\left(3 t \\right)} + 6 \\cos{\\left(3 t \\right)}\\right) e^{2 t} + 2 \\left(2 \\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)}\\right) e^{2 t}\\right)^{2} + \\left(2 \\left(\\sin{\\left(3 t \\right)} - 2 \\cos{\\left(3 t \\right)}\\right) e^{2 t} + \\left(6 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{2 t}\\right)^{2}} \\\\  & =\\sqrt{\\left(16 t^{2} e^{4 t} + 16 t e^{4 t} + 4 e^{4 t}\\right) + \\left(e^{4 t} \\sin^{2}{\\left(3 t \\right)} + 16 e^{4 t} \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 64 e^{4 t} \\cos^{2}{\\left(3 t \\right)}\\right) + \\left(64 e^{4 t} \\sin^{2}{\\left(3 t \\right)} - 16 e^{4 t} \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + e^{4 t} \\cos^{2}{\\left(3 t \\right)}\\right)} \\\\  & =\\sqrt{\\left(4 \\left(2 t + 1\\right)^{2} + 65\\right) e^{4 t}} \\\\  & =\\sqrt{4 \\left(2 t + 1\\right)^{2} + 65} e^{2 t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{0}^{1}\\|r'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{0}^{1}\\sqrt{4 \\left(2 t + 1\\right)^{2} + 65} e^{2 t}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4101a06d-7370-54ea-a578-cd2a233220b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}81 t^{2} e^{6 t} + 54 t e^{6 t} + 180 e^{6 t} \\sin^{2}{\\left(3 t \\right)} + 180 e^{6 t} \\cos^{2}{\\left(3 t \\right)} + 9 e^{6 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545027} {:answer/id #uuid "6fe4e478-de64-5103-91be-c975e193b613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{9 t^{2} e^{6 t} + \\left(\\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right)^{2} e^{6 t} + \\left(3 \\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\right)^{2} e^{6 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545034} {:answer/id #uuid "d5a0a84c-c9a7-5b16-a650-462f9cfa4504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}3 \\sqrt{\\left(3 t + 1\\right)^{2} + 20} e^{3 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545062} {:answer/id #uuid "df780e2b-8000-5fba-b81d-b77c9189e792" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(9 t e^{3 t} + 3 e^{3 t}\\right)^{2} + \\left(\\left(- 9 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t} + 3 \\left(\\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t}\\right)^{2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545063} {:answer/id #uuid "e1ba0797-d118-5724-bab9-d39b99b5bada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}3 \\sqrt{\\left(3 t + 1\\right)^{2} + 20} e^{3 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545064}] :answer-field/correct {:answer/id #uuid "e1ba0797-d118-5724-bab9-d39b99b5bada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}3 \\sqrt{\\left(3 t + 1\\right)^{2} + 20} e^{3 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545064} :answer-field/id #uuid "f6c36c12-716e-5c69-b39f-3e47700281bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545072}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4408ab3b-dff3-543f-a797-17cac8e6bbfd" :question/problem "Which integral expression gives the arc length of the curve $r(t)=\\langle \\left(\\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t},\\,3 t e^{3 t},\\,\\left(3 \\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\right) e^{3 t}\\rangle$ from $t=0$ to $t=1?$" :question/worked-solution "First, we find $r'(t)$ and $\\|r'(t)\\|:$\n\n$$\n\\begin{aligned}r'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(\\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t e^{3 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(3 \\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\right) e^{3 t})\\rangle \\\\  & =\\langle \\left(- 9 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t} + 3 \\left(\\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t},\\,9 t e^{3 t} + 3 e^{3 t},\\,3 \\left(3 \\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\right) e^{3 t} + \\left(3 \\sin{\\left(3 t \\right)} + 9 \\cos{\\left(3 t \\right)}\\right) e^{3 t}\\rangle \\\\ \\|r'(t)\\| & =\\sqrt{\\left(9 t e^{3 t} + 3 e^{3 t}\\right)^{2} + \\left(\\left(- 9 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t} + 3 \\left(\\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right) e^{3 t}\\right)^{2} + \\left(3 \\left(3 \\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\right) e^{3 t} + \\left(3 \\sin{\\left(3 t \\right)} + 9 \\cos{\\left(3 t \\right)}\\right) e^{3 t}\\right)^{2}} \\\\  & =\\sqrt{\\left(81 t^{2} e^{6 t} + 54 t e^{6 t} + 9 e^{6 t}\\right) + \\left(36 e^{6 t} \\sin^{2}{\\left(3 t \\right)} - 144 e^{6 t} \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 144 e^{6 t} \\cos^{2}{\\left(3 t \\right)}\\right) + \\left(144 e^{6 t} \\sin^{2}{\\left(3 t \\right)} + 144 e^{6 t} \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 36 e^{6 t} \\cos^{2}{\\left(3 t \\right)}\\right)} \\\\  & =\\sqrt{\\left(9 \\left(3 t + 1\\right)^{2} + 180\\right) e^{6 t}} \\\\  & =\\sqrt{9 \\left(3 t + 1\\right)^{2} + 180} e^{3 t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{0}^{1}\\|r'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{0}^{1}3 \\sqrt{\\left(3 t + 1\\right)^{2} + 20} e^{3 t}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47764fdc-eb04-52fd-885c-29e43707001e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}\\sqrt{2} \\sqrt{32 e^{4 t} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545030} {:answer/id #uuid "9d2eb26b-ebab-5aa7-b77f-1efb0d1ad509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}64 e^{4 t} + 18 \\sin^{2}{\\left(3 t \\right)} + 18 \\cos^{2}{\\left(3 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545045} {:answer/id #uuid "cc019fe3-5be8-5132-9eef-03394daca6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}\\sqrt{2} \\sqrt{32 e^{4 t} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545059} {:answer/id #uuid "e9ba3779-d05c-5cec-81d9-ad998ebc62b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}\\sqrt{\\left(\\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\right)^{2} + \\left(\\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)}\\right)^{2} + 16 e^{4 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545066} {:answer/id #uuid "ec1d7653-c8d7-5665-9029-04b659071390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}\\sqrt{\\left(- 3 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right)^{2} + 64 e^{4 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545067}] :answer-field/correct {:answer/id #uuid "cc019fe3-5be8-5132-9eef-03394daca6a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}\\sqrt{2} \\sqrt{32 e^{4 t} + 9}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545059} :answer-field/id #uuid "ab1aa575-01cb-5151-bafd-ed7f2f05b965" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "612253f1-92b9-59a2-9311-5024c8b80216" :question/problem "Which integral expression gives the arc length of the curve $f(t)=\\langle \\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)},\\,4 e^{2 t},\\,\\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)}\\rangle$ from $t=-1$ to $t=1?$" :question/worked-solution "First, we find $f'(t)$ and $\\|f'(t)\\|:$\n\n$$\n\\begin{aligned}f'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sin{\\left(3 t \\right)} + \\cos{\\left(3 t \\right)}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(4 e^{2 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\sin{\\left(3 t \\right)} - \\cos{\\left(3 t \\right)})\\rangle \\\\  & =\\langle - 3 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)},\\,8 e^{2 t},\\,3 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\rangle \\\\ \\|f'(t)\\| & =\\sqrt{\\left(- 3 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right)^{2} + \\left(3 \\sin{\\left(3 t \\right)} + 3 \\cos{\\left(3 t \\right)}\\right)^{2} + \\left(8 e^{2 t}\\right)^{2}} \\\\  & =\\sqrt{\\left(9 \\sin^{2}{\\left(3 t \\right)} - 18 \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 9 \\cos^{2}{\\left(3 t \\right)}\\right) + \\left(9 \\sin^{2}{\\left(3 t \\right)} + 18 \\sin{\\left(3 t \\right)} \\cos{\\left(3 t \\right)} + 9 \\cos^{2}{\\left(3 t \\right)}\\right) + 64 e^{4 t}} \\\\  & =\\sqrt{18 \\left(\\sin^{2}{\\left(3 t \\right)} + \\cos^{2}{\\left(3 t \\right)}\\right) + 64 e^{4 t}} \\\\  & =\\sqrt{64 e^{4 t} + 18}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{-1}^{1}\\|f'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{-1}^{1}\\sqrt{2} \\sqrt{32 e^{4 t} + 9}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "028ace36-17d9-5ced-bf57-d5582a06f067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(t e^{t} + e^{t}\\right)^{2} + \\left(\\left(- 2 \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t} + \\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t}\\right)^{2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545012} {:answer/id #uuid "1cdfc465-4223-54d9-ab93-c84fae1558a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{t^{2} e^{2 t} + \\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right)^{2} e^{2 t} + \\left(2 \\sin{\\left(t \\right)} - \\cos{\\left(t \\right)}\\right)^{2} e^{2 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545021} {:answer/id #uuid "43b69979-26af-5246-97a5-6ab5105d4ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{\\left(t + 1\\right)^{2} + 10} e^{t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545028} {:answer/id #uuid "5f866bdf-5fec-52a8-ac39-f948f30b5dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(t + 1\\right)^{2} + 10} e^{t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545032} {:answer/id #uuid "b2ab18f1-7a35-589e-ac06-ae5adb3a9a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}t^{2} e^{2 t} + 2 t e^{2 t} + 10 e^{2 t} \\sin^{2}{\\left(t \\right)} + 10 e^{2 t} \\cos^{2}{\\left(t \\right)} + e^{2 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545052}] :answer-field/correct {:answer/id #uuid "5f866bdf-5fec-52a8-ac39-f948f30b5dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(t + 1\\right)^{2} + 10} e^{t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545032} :answer-field/id #uuid "72c75cfe-1d10-5b6c-a794-757c9b59470a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545036}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8bab0052-617a-59f3-8aa4-ef57cf4de342" :question/problem "Which integral expression gives the arc length of the curve $r(t)=\\langle \\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t},\\,t e^{t},\\,\\left(2 \\sin{\\left(t \\right)} - \\cos{\\left(t \\right)}\\right) e^{t}\\rangle$ from $t=0$ to $t=1?$" :question/worked-solution "First, we find $r'(t)$ and $\\|r'(t)\\|:$\n\n$$\n\\begin{aligned}r'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(t e^{t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(2 \\sin{\\left(t \\right)} - \\cos{\\left(t \\right)}\\right) e^{t})\\rangle \\\\  & =\\langle \\left(- 2 \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t} + \\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t},\\,t e^{t} + e^{t},\\,\\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(2 \\sin{\\left(t \\right)} - \\cos{\\left(t \\right)}\\right) e^{t}\\rangle \\\\ \\|r'(t)\\| & =\\sqrt{\\left(t e^{t} + e^{t}\\right)^{2} + \\left(\\left(- 2 \\sin{\\left(t \\right)} + \\cos{\\left(t \\right)}\\right) e^{t} + \\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t}\\right)^{2} + \\left(\\left(\\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(2 \\sin{\\left(t \\right)} - \\cos{\\left(t \\right)}\\right) e^{t}\\right)^{2}} \\\\  & =\\sqrt{\\left(t^{2} e^{2 t} + 2 t e^{2 t} + e^{2 t}\\right) + \\left(e^{2 t} \\sin^{2}{\\left(t \\right)} - 6 e^{2 t} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 9 e^{2 t} \\cos^{2}{\\left(t \\right)}\\right) + \\left(9 e^{2 t} \\sin^{2}{\\left(t \\right)} + 6 e^{2 t} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + e^{2 t} \\cos^{2}{\\left(t \\right)}\\right)} \\\\  & =\\sqrt{\\left(\\left(t + 1\\right)^{2} + 10\\right) e^{2 t}} \\\\  & =\\sqrt{\\left(t + 1\\right)^{2} + 10} e^{t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{0}^{1}\\|r'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{0}^{1}\\sqrt{\\left(t + 1\\right)^{2} + 10} e^{t}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7d923c-bb27-5fe1-b86b-77173ad54c05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{t^{2} e^{2 t} + \\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right)^{2} e^{2 t} + \\left(3 \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)}\\right)^{2} e^{2 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545022} {:answer/id #uuid "39a39418-4d43-5d0e-833a-33fb03dc013e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(t + 1\\right)^{2} + 26} e^{t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545024} {:answer/id #uuid "96903ca2-13c3-5286-acd6-09bfc47734af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(t e^{t} + e^{t}\\right)^{2} + \\left(\\left(- 3 \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t}\\right)^{2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545042} {:answer/id #uuid "a67d8782-3843-5b72-a719-5e453c4afcf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}t^{2} e^{2 t} + 2 t e^{2 t} + 26 e^{2 t} \\sin^{2}{\\left(t \\right)} + 26 e^{2 t} \\cos^{2}{\\left(t \\right)} + e^{2 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545048} {:answer/id #uuid "e534f53a-980c-5720-b886-066e09cd5697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}\\sqrt{\\left(t + 1\\right)^{2} + 26} e^{t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545065}] :answer-field/correct {:answer/id #uuid "39a39418-4d43-5d0e-833a-33fb03dc013e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(t + 1\\right)^{2} + 26} e^{t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545024} :answer-field/id #uuid "b643d9c2-91f5-5f48-971d-277a1197943f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545055}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c05312a1-0c08-577f-bd04-8c35dfc37a24" :question/problem "Which integral expression gives the arc length of the curve $r(t)=\\langle \\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t},\\,t e^{t},\\,\\left(3 \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)}\\right) e^{t}\\rangle$ from $t=0$ to $t=1?$" :question/worked-solution "First, we find $r'(t)$ and $\\|r'(t)\\|:$\n\n$$\n\\begin{aligned}r'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(t e^{t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(3 \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)}\\right) e^{t})\\rangle \\\\  & =\\langle \\left(- 3 \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t},\\,t e^{t} + e^{t},\\,\\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(3 \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)}\\right) e^{t}\\rangle \\\\ \\|r'(t)\\| & =\\sqrt{\\left(t e^{t} + e^{t}\\right)^{2} + \\left(\\left(- 3 \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t}\\right)^{2} + \\left(\\left(2 \\sin{\\left(t \\right)} + 3 \\cos{\\left(t \\right)}\\right) e^{t} + \\left(3 \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)}\\right) e^{t}\\right)^{2}} \\\\  & =\\sqrt{\\left(t^{2} e^{2 t} + 2 t e^{2 t} + e^{2 t}\\right) + \\left(e^{2 t} \\sin^{2}{\\left(t \\right)} - 10 e^{2 t} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 25 e^{2 t} \\cos^{2}{\\left(t \\right)}\\right) + \\left(25 e^{2 t} \\sin^{2}{\\left(t \\right)} + 10 e^{2 t} \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + e^{2 t} \\cos^{2}{\\left(t \\right)}\\right)} \\\\  & =\\sqrt{\\left(\\left(t + 1\\right)^{2} + 26\\right) e^{2 t}} \\\\  & =\\sqrt{\\left(t + 1\\right)^{2} + 26} e^{t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{0}^{1}\\|r'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{0}^{1}\\sqrt{\\left(t + 1\\right)^{2} + 26} e^{t}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "178909f7-4b44-5292-b56b-6f922b564885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\pi}16 t^{2} \\sin^{2}{\\left(t \\right)} + 16 t^{2} \\cos^{2}{\\left(t \\right)} + 16 \\sin^{2}{\\left(t \\right)} + 16 \\cos^{2}{\\left(t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545017} {:answer/id #uuid "8cc5e107-cb87-540a-a5e2-fc86e658f03e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\pi}\\sqrt{16 t^{2} \\sin^{2}{\\left(t \\right)} + \\left(- 4 t \\cos{\\left(t \\right)} - 2\\right)^{2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545039} {:answer/id #uuid "972534fa-f6a8-5a70-9442-e79a803a68c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\pi}\\sqrt{\\left(4 t \\cos{\\left(t \\right)} + 4 \\sin{\\left(t \\right)}\\right)^{2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545043} {:answer/id #uuid "9dbf6586-5bb8-573e-9294-bd5c024c90df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\pi}4 \\sqrt{t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545046} {:answer/id #uuid "d5930f12-e67e-5759-add4-0606edaf186d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1 + \\pi}4 \\sqrt{t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545061}] :answer-field/correct {:answer/id #uuid "9dbf6586-5bb8-573e-9294-bd5c024c90df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{\\pi}4 \\sqrt{t^{2} + 1}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545046} :answer-field/id #uuid "c148f967-914b-5a44-9dde-6d1d5884252f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f474c744-3fa7-5d1c-829f-aac54af361a6" :question/problem "![](images/35/3500678bdca0125f1796c68ad54aab04c05ece23914f2bde0a0589119d291fc8.png)\n\nWhich integral  expression gives the arc length of the curve $g(t)=\\langle 4 t \\sin{\\left(t \\right)},\\,- 4 t \\cos{\\left(t \\right)} - 2\\rangle$\nfrom  $t=0$ to $t=\\pi?$" :question/worked-solution "First, we find $g'(t)$ and $\\|g'(t)\\|:$\n\n$$\n\\begin{aligned}g'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(4 t \\sin{\\left(t \\right)}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(- 4 t \\cos{\\left(t \\right)} - 2)\\rangle \\\\  & =\\langle 4 t \\cos{\\left(t \\right)} + 4 \\sin{\\left(t \\right)},\\,4 t \\sin{\\left(t \\right)} - 4 \\cos{\\left(t \\right)}\\rangle \\\\ \\|g'(t)\\| & =\\sqrt{\\left(4 t \\sin{\\left(t \\right)} - 4 \\cos{\\left(t \\right)}\\right)^{2} + \\left(4 t \\cos{\\left(t \\right)} + 4 \\sin{\\left(t \\right)}\\right)^{2}} \\\\  & =\\sqrt{\\left(16 t^{2} \\sin^{2}{\\left(t \\right)} - 32 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 16 \\cos^{2}{\\left(t \\right)}\\right) + \\left(16 t^{2} \\cos^{2}{\\left(t \\right)} + 32 t \\sin{\\left(t \\right)} \\cos{\\left(t \\right)} + 16 \\sin^{2}{\\left(t \\right)}\\right)} \\\\  & =\\sqrt{16 t^{2} + 16}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & =\\int_{0}^{\\pi}\\|g'(t)\\|\\,\\mathrm{d}t=\\int_{0}^{\\pi}4 \\sqrt{t^{2} + 1}\\,\\mathrm{d}t\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Curve"}]}
