er.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{2{cos}^{2}⁡2t+3{sin}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391652} {:answer/id #uuid "0ec6159d-f7de-5b2f-b124-7ba4b0ab6ebc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{2{sin}^{2}⁡2t+9{cos}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391653}] :answer-field/correct {:answer/id #uuid "8acb4dd0-ab7b-50a4-bed8-752a2b64b388" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\,\\text{d}t" :db/id #edb/ref 17592186391651} :answer-field/id #uuid "438187f3-2ea9-5adc-8e76-df9ae09801fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "994d254c-8dfb-50db-8abf-3c167a677836" :question/math-academy-id "q-33728" :question/problem "![](images/d1/d162245ac19c3ef9ae63d602fb4e188ddfd241a1a604304f6c272c3902ce1e93.png)\n\nWhich integral expression gives the arc length of the curve $g(t)=⟨\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡3t⟩$ from $t=0$ to $t=\\pi ?$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡3t)⟩ \\\\  & =⟨2\\operatorname{cos}⁡2t,\\,-3\\operatorname{sin}⁡3t⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(2\\operatorname{cos}⁡2t)^{2}+(-3\\operatorname{sin}⁡3t)^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi }‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{cos}^{2}⁡2t+9{sin}^{2}⁡3t}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186120281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7002bf97-f2f4-584e-9358-9901bcdc36c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+5}\\,\\text{d}t" :db/id #edb/ref 17592186312858} {:answer/id #uuid "c02b3e07-f8b1-5a36-8107-54957d2ec5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{e}^{t}\\sqrt{{t}^{2}+2t+2}\\,\\text{d}t" :db/id #edb/ref 17592186313481} {:answer/id #uuid "db80e8bf-9842-5c6d-bd83-4583ec9425fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+4}\\,\\text{d}t" :db/id #edb/ref 17592186313702} {:answer/id #uuid "e797d87f-61ea-5692-b189-9f791eb47e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+6}\\,\\text{d}t" :db/id #edb/ref 17592186313811} {:answer/id #uuid "f08c0c47-5ca9-5225-ad0d-e2d99574aadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{e}^{t}(t+2)\\,\\text{d}t" :db/id #edb/ref 17592186313902}] :answer-field/correct {:answer/id #uuid "e797d87f-61ea-5692-b189-9f791eb47e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+6}\\,\\text{d}t" :db/id #edb/ref 17592186313811} :answer-field/id #uuid "bc1df9aa-037a-519b-b947-a899bc624f42" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314526}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3bc45ddc-02bd-5a1e-bfa3-f99f90a0c552" :question/math-academy-id "q-33862" :question/problem "Which integral  expression gives the arc length of the curve $f(t)={e}^{t}(\\,i+2\\,j+t\\,k)$ from  $t=1$ to $t=2?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,i+\\frac{\\text{d}}{\\text{d}t}(2{e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(t{e}^{t})\\,k \\\\  & ={e}^{t}\\,i+2{e}^{t}\\,j+(t{e}^{t}+{e}^{t})\\,k \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{({e}^{t})^{2}+(2{e}^{t})^{2}+({e}^{t}(t+1))^{2}} \\\\  & =\\sqrt{{e}^{2t}+4{e}^{2t}+{e}^{2t}({t}^{2}+2t+1)} \\\\  & =\\sqrt{{e}^{2t}(1+4+{t}^{2}+2t+1)} \\\\  & ={e}^{t}\\sqrt{{t}^{2}+2t+6}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}{e}^{t}\\sqrt{{t}^{2}+2t+6}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262772 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "786fd2f0-0c3d-5b7a-b5bc-a3608fc69fb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{16{cos}^{2}⁡t+9}\\,\\text{d}t" :db/id #edb/ref 17592186260929} {:answer/id #uuid "91d23bb2-32fb-5fbc-9842-9fb48c39267d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{3{cos}^{2}⁡t+4}\\,\\text{d}t" :db/id #edb/ref 17592186261143} {:answer/id #uuid "9501dc4d-d6ab-5f38-966b-90a4a703d054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{sin}^{2}⁡t+16}\\,\\text{d}t" :db/id #edb/ref 17592186261170} {:answer/id #uuid "dac1fd6a-eb18-58b7-911b-730ac1c804e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{4{sin}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186261807} {:answer/id #uuid "fe36bad1-4fa4-557e-a374-9f534fc494fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t" :db/id #edb/ref 17592186262105}] :answer-field/correct {:answer/id #uuid "fe36bad1-4fa4-557e-a374-9f534fc494fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t" :db/id #edb/ref 17592186262105} :answer-field/id #uuid "f53642b3-fa2e-5032-9340-8b9099d29395" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262549}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1a4d542-8890-5129-a744-baf652c9fc9c" :question/math-academy-id "q-127419" :question/problem "Which integral expression gives the arc length of the curve $f(t)=⟨4\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t,\\,4\\operatorname{sin}⁡t⟩$ from $t=\\frac{\\pi }{6}$ to $t=\\frac{\\pi }{4}?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-4\\operatorname{sin}⁡t,\\,3\\operatorname{cos}⁡t,\\,4\\operatorname{cos}⁡t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(3\\operatorname{cos}⁡t)^{2}+(4\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+9{cos}^{2}⁡t+16{cos}^{2}⁡t} \\\\  & =\\sqrt{16({sin}^{2}⁡t+{cos}^{2}⁡t)+9{cos}^{2}⁡t} \\\\  & =\\sqrt{9{cos}^{2}⁡t+16}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{\\pi /6}^{\\pi /4}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186262773 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "214ab720-6ecf-5a54-bbca-66e11f886130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186260158} {:answer/id #uuid "491c9a30-b37c-5794-9dfe-c72bf6a272ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{2{e}^{t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186260507} {:answer/id #uuid "741301d8-03d2-596d-99cb-dea017a15918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{{e}^{t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186260889} {:answer/id #uuid "99f9d829-a8f9-5d96-a7b8-f240b15576e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{-1}^{1}\\sqrt{2{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186261210} {:answer/id #uuid "9a64fc13-46c7-54cc-b859-06bfde01dc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186261214}] :answer-field/correct {:answer/id #uuid "214ab720-6ecf-5a54-bbca-66e11f886130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186260158} :answer-field/id #uuid "83cdb749-1449-536c-beab-38d88342a23d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae63a631-2f65-575f-9860-3fcf3ba50584" :question/math-academy-id "q-127427" :question/problem "Which integral expression gives the arc length of the curve $f(t)=⟨\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,{e}^{t},\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩$ from $t=-1$ to $t=1?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,{e}^{t},\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+({e}^{t})^{2}+{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{e}^{2t}+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t} \\\\  & =\\sqrt{{e}^{2t}+2({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\sqrt{{e}^{2t}+2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186314703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2208ccc5-5934-51e2-b52d-8ff31bed4e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186312232} {:answer/id #uuid "65d3df9b-2970-5299-ab99-547382b11901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186312777} {:answer/id #uuid "7ce9c1bd-fb44-5c82-b8e8-5b81f7969c0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186312977} {:answer/id #uuid "a95d6aed-c1ec-5c63-b9a8-8a0ba8e816ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186313302} {:answer/id #uuid "b5c14440-88e2-525d-85e7-2db79078355d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{{cos}^{2}⁡2t-{sin}^{2}⁡2t+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186313388}] :answer-field/correct {:answer/id #uuid "a95d6aed-c1ec-5c63-b9a8-8a0ba8e816ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{1}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186313302} :answer-field/id #uuid "9762ce0e-0f2a-5c5c-ad7d-6b8b6bc424c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314419}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "732ad1b9-5772-5700-8754-f590c45d555d" :question/math-academy-id "q-33857" :question/problem "Which integral  expression gives the arc length of the curve $f(t)=⟨\\operatorname{sin}⁡2t,\\operatorname{cos}⁡2t,{t}^{2}⟩$\nfrom  $t=0$ to $t=1?$" :question/worked-solution "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2})⟩ \\\\  & =⟨2\\operatorname{cos}⁡2t,\\,-2\\operatorname{sin}⁡2t,\\,2t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{(2\\operatorname{cos}⁡2t)^{2}+(-2\\operatorname{sin}⁡2t)^{2}+(2t)^{2}} \\\\  & =\\sqrt{4{cos}^{2}⁡2t+4{sin}^{2}⁡2t+4{t}^{2}} \\\\  & =\\sqrt{4({cos}^{2}⁡2t+{sin}^{2}⁡2t+{t}^{2})} \\\\  & =2\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}‖{f}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{1}2\\sqrt{1+{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186391631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e513d59-ec4b-56e0-a149-748a6164fa0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391633} {:answer/id #uuid "5b08fcdf-1c61-56cb-b330-8a9759c8a89e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186391634} {:answer/id #uuid "8210e913-8fc4-50f7-87cd-8fd56787dfec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{{t}^{2}+2t\\operatorname{sin}⁡2t}\\,\\text{d}t" :db/id #edb/ref 17592186391635} {:answer/id #uuid "d3b489bc-4e90-59af-8076-7c8a1e2ef20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+2{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391636} {:answer/id #uuid "d1c3feb9-80f0-5263-bb9b-e4994b84169c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391637}] :answer-field/correct {:answer/id #uuid "5e513d59-ec4b-56e0-a149-748a6164fa0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186391633} :answer-field/id #uuid "5ffd0d69-a63d-58b1-a22c-7c7b302f6577" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "214d5c25-f05c-5b96-87cf-f66e123da8aa" :question/math-academy-id "q-33706" :question/problem "![](images/10/10ee30ddf508bf985e1c3a41491818723b57301412a5514e4a39c3bc13518acd.png)\n\nWhich integral  expression gives the arc length of the curve $g(t)=⟨t\\operatorname{sin}⁡t,2-t\\operatorname{cos}⁡t⟩$\nfrom  $t=0$ to $t=\\pi ?$" :question/worked-solution "First, we find ${g}^{′}(t)$ and $‖{g}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2-t\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t,\\,t\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\ ‖{g}^{′}(t)‖ & =\\sqrt{(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)^{2}+(t\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+2t\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{t}^{2}{cos}^{2}⁡t+{t}^{2}{sin}^{2}⁡t-2t\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{1+{t}^{2}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L={\\int }_{0}^{\\pi }‖{g}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{\\pi }\\sqrt{1+{t}^{2}}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "917fe269-7275-5dbe-8043-5ab73f39f23b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2{sin}^{2}⁡t+{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392886} {:answer/id #uuid "c302b461-16a8-5a13-a604-48e2a5a05708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }\\sqrt{3-{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392887} {:answer/id #uuid "610e92dd-f0e2-5bea-8bb6-5a4d0d844cb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2+{sin}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392888} {:answer/id #uuid "6f4b7c1f-6178-5bb3-8bfd-e481d21ad116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2+{cos}^{2}⁡t}\\,\\text{d}t" :db/id #edb/ref 17592186392889} {:answer/id #uuid "c13bb008-eeba-55b4-aec7-73942951b937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t" :db/id #edb/ref 17592186392890}] :answer-field/correct {:answer/id #uuid "c13bb008-eeba-55b4-aec7-73942951b937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t" :db/id #edb/ref 17592186392890} :answer-field/id #uuid "e342550d-8ba6-5a84-9cad-9202991768dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "719d5fba-71fa-5184-acdb-743568f97311" :question/math-academy-id "q-64723" :question/problem "![](images/d4/d42e9c6ed71f06c2dec273a91d3a4cfbdf5c58095be9370285d7987d38f7b5a6.png)\n\nWhich integral  expression gives the arc length of the curve $h(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j+t\\,k$ from  $t=0$ to $t=2\\pi ?$" :question/worked-solution "First, we find ${h}^{′}(t)$ and $‖{h}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{h}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+1\\,k \\\\ ‖{h}^{′}(t)‖ & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+(1)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2\\pi }‖{h}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b393a27d-b443-5b97-b762-ed6603aad1e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392893} {:answer/id #uuid "66fa210a-e578-5c4d-8132-eb89718f32cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{{t}^{6}+{t}^{4}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392894} {:answer/id #uuid "85f0edfc-dff0-5ee7-a4b2-955898d40c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{8{t}^{5}+9{t}^{3}+6}\\,\\text{d}t" :db/id #edb/ref 17592186392895} {:answer/id #uuid "d8531aa7-d3a8-5834-8493-ee803adaa77f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{5}\\sqrt{16{t}^{6}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392896} {:answer/id #uuid "d88974de-cee3-50ec-af8b-a8554a2c05b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}}\\,\\text{d}t" :db/id #edb/ref 17592186392897}] :answer-field/correct {:answer/id #uuid "b393a27d-b443-5b97-b762-ed6603aad1e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t" :db/id #edb/ref 17592186392893} :answer-field/id #uuid "0e4f8290-db9f-5614-851c-76e4decb0150" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392892}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93e74816-9928-5c75-b857-debb8b7d37d0" :question/math-academy-id "q-64724" :question/problem "Which integral expression gives the arc length of the curve $r(t)={t}^{3}\\,i+3t\\,j+{t}^{4}\\,k$ from  $t=2$ to $t=5?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(3t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{4})\\,k \\\\  & =3{t}^{2}\\,i+3\\,j+4{t}^{3}\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(3{t}^{2})^{2}+(3)^{2}+(4{t}^{3})^{2}} \\\\  & =\\sqrt{9{t}^{4}+9+16{t}^{6}}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{2}^{5}‖{r}^{′}(t)‖\\,\\text{d}t={\\int }_{2}^{5}\\sqrt{16{t}^{6}+9{t}^{4}+9}\\,\\text{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1af310ae-7023-5f16-9900-50978f9e16e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2 \\pi}16 \\sin^{2}{\\left(2 t \\right)} + 16 \\cos^{2}{\\left(2 t \\right)} + 9\\,\\mathrm{d}t" :db/id #edb/ref 17592186545020} {:answer/id #uuid "7f57c269-8ee5-5c7d-b6cb-a4d338a3152b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2 \\pi}\\sqrt{25}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545037} {:answer/id #uuid "b304b7e4-a2b1-52ff-99df-b7f51d52082d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2 \\pi}\\sqrt{16 \\sin^{2}{\\left(2 t \\right)} + 16 \\cos^{2}{\\left(2 t \\right)}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545053} {:answer/id #uuid "b50eaedf-baa4-55fb-9bb1-b494ec5adc70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1 + 2 \\pi}\\sqrt{25}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545054} {:answer/id #uuid "f2f755e9-b040-599f-aeb9-456872469c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2 \\pi}\\sqrt{9 t^{2} + 4 \\sin^{2}{\\left(2 t \\right)} + 4 \\cos^{2}{\\left(2 t \\right)}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545068}] :answer-field/correct {:answer/id #uuid "7f57c269-8ee5-5c7d-b6cb-a4d338a3152b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2 \\pi}\\sqrt{25}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545037} :answer-field/id #uuid "9bb4ed09-e6a2-579b-b4db-4bd11d2de44a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545044}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "046e3d20-09a7-52f9-bb63-46259480cdfa" :question/problem "![](images/0e/0e3f80c8a0975c70ee2990dc230af59ffb9f0944bdbdc86c6fb96f693ebdac29.png)\n\nWhich integral  expression gives the arc length of the curve $h(t)=(2 \\cos{\\left(2 t \\right)})\\,i+(2 \\sin{\\left(2 t \\right)})\\,j+(3 t)\\,k$ from $t=0$ to $t=2 \\pi?$" :question/worked-solution "First, we find $h'(t)$ and $\\|h'(t)\\|:$\n\n$$\n\\begin{aligned}h'(t) & =(\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 \\cos{\\left(2 t \\right)}))\\,i+(\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 \\sin{\\left(2 t \\right)}))\\,j+(\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 t))\\,k \\\\  & =(- 4 \\sin{\\left(2 t \\right)})\\,i+(4 \\cos{\\left(2 t \\right)})\\,j+(3)\\,k \\\\ \\|h'(t)\\| & =\\sqrt{\\left(- 4 \\sin{\\left(2 t \\right)}\\right)^{2} + \\left(4 \\cos{\\left(2 t \\right)}\\right)^{2} + 3^{2}} \\\\  & =\\sqrt{16 \\sin^{2}{\\left(2 t \\right)} + 16 \\cos^{2}{\\left(2 t \\right)} + 9} \\\\  & =\\sqrt{25}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & =\\int_{0}^{2 \\pi}\\|h'(t)\\|\\,\\mathrm{d}t=\\int_{0}^{2 \\pi}\\sqrt{25}\\,\\mathrm{d}t\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1533ca-05b4-5148-9dc5-94cfe08ecb14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}2 \\sqrt{\\left(2 t + 1\\right)^{2} + 20} e^{2 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545019} {:answer/id #uuid "d51560a0-203a-5a31-a3d7-cdd5f6b23365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{4 t^{2} e^{4 t} + \\left(\\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right)^{2} e^{4 t} + \\left(3 \\sin{\\left(2 t \\right)} - \\cos{\\left(2 t \\right)}\\right)^{2} e^{4 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545060} {:answer/id #uuid "f317ccc1-b7e4-5970-a70d-7e1b8b6e3e26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{2}2 \\sqrt{\\left(2 t + 1\\right)^{2} + 20} e^{2 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545069} {:answer/id #uuid "f5bd517f-8c2a-502a-a78f-f719a5a1a68c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}\\sqrt{\\left(4 t e^{2 t} + 2 e^{2 t}\\right)^{2} + \\left(\\left(- 6 \\sin{\\left(2 t \\right)} + 2 \\cos{\\left(2 t \\right)}\\right) e^{2 t} + 2 \\left(\\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right) e^{2 t}\\right)^{2}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545071} {:answer/id #uuid "fcd510eb-31c2-5e92-a12d-5358a8554b2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}16 t^{2} e^{4 t} + 16 t e^{4 t} + 80 e^{4 t} \\sin^{2}{\\left(2 t \\right)} + 80 e^{4 t} \\cos^{2}{\\left(2 t \\right)} + 4 e^{4 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545073}] :answer-field/correct {:answer/id #uuid "1a1533ca-05b4-5148-9dc5-94cfe08ecb14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{0}^{1}2 \\sqrt{\\left(2 t + 1\\right)^{2} + 20} e^{2 t}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545019} :answer-field/id #uuid "ad1f43fd-fe6e-5f82-a170-9af58aabe5c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545050}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "122bd16a-03f5-5b18-a15c-440bca8ce5ce" :question/problem "Which integral expression gives the arc length of the curve $r(t)=\\langle \\left(\\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right) e^{2 t},\\,2 t e^{2 t},\\,\\left(3 \\sin{\\left(2 t \\right)} - \\cos{\\left(2 t \\right)}\\right) e^{2 t}\\rangle$ from $t=0$ to $t=1?$" :question/worked-solution "First, we find $r'(t)$ and $\\|r'(t)\\|:$\n\n$$\n\\begin{aligned}r'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(\\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right) e^{2 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 t e^{2 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(\\left(3 \\sin{\\left(2 t \\right)} - \\cos{\\left(2 t \\right)}\\right) e^{2 t})\\rangle \\\\  & =\\langle \\left(- 6 \\sin{\\left(2 t \\right)} + 2 \\cos{\\left(2 t \\right)}\\right) e^{2 t} + 2 \\left(\\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right) e^{2 t},\\,4 t e^{2 t} + 2 e^{2 t},\\,\\left(2 \\sin{\\left(2 t \\right)} + 6 \\cos{\\left(2 t \\right)}\\right) e^{2 t} + 2 \\left(3 \\sin{\\left(2 t \\right)} - \\cos{\\left(2 t \\right)}\\right) e^{2 t}\\rangle \\\\ \\|r'(t)\\| & =\\sqrt{\\left(4 t e^{2 t} + 2 e^{2 t}\\right)^{2} + \\left(\\left(- 6 \\sin{\\left(2 t \\right)} + 2 \\cos{\\left(2 t \\right)}\\right) e^{2 t} + 2 \\left(\\sin{\\left(2 t \\right)} + 3 \\cos{\\left(2 t \\right)}\\right) e^{2 t}\\right)^{2} + \\left(\\left(2 \\sin{\\left(2 t \\right)} + 6 \\cos{\\left(2 t \\right)}\\right) e^{2 t} + 2 \\left(3 \\sin{\\left(2 t \\right)} - \\cos{\\left(2 t \\right)}\\right) e^{2 t}\\right)^{2}} \\\\  & =\\sqrt{\\left(16 t^{2} e^{4 t} + 16 t e^{4 t} + 4 e^{4 t}\\right) + \\left(16 e^{4 t} \\sin^{2}{\\left(2 t \\right)} - 64 e^{4 t} \\sin{\\left(2 t \\right)} \\cos{\\left(2 t \\right)} + 64 e^{4 t} \\cos^{2}{\\left(2 t \\right)}\\right) + \\left(64 e^{4 t} \\sin^{2}{\\left(2 t \\right)} + 64 e^{4 t} \\sin{\\left(2 t \\right)} \\cos{\\left(2 t \\right)} + 16 e^{4 t} \\cos^{2}{\\left(2 t \\right)}\\right)} \\\\  & =\\sqrt{\\left(4 \\left(2 t + 1\\right)^{2} + 80\\right) e^{4 t}} \\\\  & =\\sqrt{4 \\left(2 t + 1\\right)^{2} + 80} e^{2 t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{0}^{1}\\|r'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{0}^{1}2 \\sqrt{\\left(2 t + 1\\right)^{2} + 20} e^{2 t}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186545025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018bb9d1-8b6e-5e66-b016-0ce25c17e4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}\\sqrt{\\left(- 4 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right)^{2} + 36 e^{4 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545011} {:answer/id #uuid "07ab1580-460d-5ba1-a2a4-335cfa6acb49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}36 e^{4 t} + 32 \\sin^{2}{\\left(2 t \\right)} + 32 \\cos^{2}{\\left(2 t \\right)}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545015} {:answer/id #uuid "2cdfeeb1-a81a-5674-8ec4-b841cd7af654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}2 \\sqrt{9 e^{4 t} + 8}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545023} {:answer/id #uuid "5d4e5997-3f41-5fd4-846a-b8332280ee36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}\\sqrt{\\left(2 \\sin{\\left(2 t \\right)} - 2 \\cos{\\left(2 t \\right)}\\right)^{2} + \\left(2 \\sin{\\left(2 t \\right)} + 2 \\cos{\\left(2 t \\right)}\\right)^{2} + 9 e^{4 t}}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545031} {:answer/id #uuid "712a627a-9a03-57f3-bac9-c73c27ed515d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{2}2 \\sqrt{9 e^{4 t} + 8}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545035}] :answer-field/correct {:answer/id #uuid "2cdfeeb1-a81a-5674-8ec4-b841cd7af654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\int_{-1}^{1}2 \\sqrt{9 e^{4 t} + 8}\\,\\mathrm{d}t" :db/id #edb/ref 17592186545023} :answer-field/id #uuid "199e8f8c-69ac-57eb-96a5-94d95b4c1b48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186545018}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3fa2498f-7a46-5998-8764-42dd89d70bc6" :question/problem "Which integral expression gives the arc length of the curve $f(t)=\\langle 2 \\sin{\\left(2 t \\right)} + 2 \\cos{\\left(2 t \\right)},\\,3 e^{2 t},\\,2 \\sin{\\left(2 t \\right)} - 2 \\cos{\\left(2 t \\right)}\\rangle$ from $t=-1$ to $t=1?$" :question/worked-solution "First, we find $f'(t)$ and $\\|f'(t)\\|:$\n\n$$\n\\begin{aligned}f'(t) & =\\langle \\frac{\\mathrm{d}}{\\mathrm{d}t}(2 \\sin{\\left(2 t \\right)} + 2 \\cos{\\left(2 t \\right)}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 e^{2 t}),\\,\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 \\sin{\\left(2 t \\right)} - 2 \\cos{\\left(2 t \\right)})\\rangle \\\\  & =\\langle - 4 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)},\\,6 e^{2 t},\\,4 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\rangle \\\\ \\|f'(t)\\| & =\\sqrt{\\left(- 4 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right)^{2} + \\left(4 \\sin{\\left(2 t \\right)} + 4 \\cos{\\left(2 t \\right)}\\right)^{2} + \\left(6 e^{2 t}\\right)^{2}} \\\\  & =\\sqrt{\\left(16 \\sin^{2}{\\left(2 t \\right)} - 32 \\sin{\\left(2 t \\right)} \\cos{\\left(2 t \\right)} + 16 \\cos^{2}{\\left(2 t \\right)}\\right) + \\left(16 \\sin^{2}{\\left(2 t \\right)} + 32 \\sin{\\left(2 t \\right)} \\cos{\\left(2 t \\right)} + 16 \\cos^{2}{\\left(2 t \\right)}\\right) + 36 e^{4 t}} \\\\  & =\\sqrt{32 \\left(\\sin^{2}{\\left(2 t \\right)} + \\cos^{2}{\\left(2 t \\right)}\\right) + 36 e^{4 t}} \\\\  & =\\sqrt{36 e^{4 t} + 32}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & =\\int_{-1}^{1}\\|f'(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_{-1}^{1}2 \\sqrt{9 e^{4 t} + 8}\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id 