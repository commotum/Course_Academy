#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101859} :activity/id #uuid "d0d06916-b04a-5057-b794-744d1e7a0e9f" :activity/scope {:db/id #edb/ref 17592186048863} :activity/steps [{:db/id #edb/ref 17592186101859 :step/content {:db/id #edb/ref 17592186101954 :tutorial/content "If we want to add (or subtract) three or more matrices, all operations should be done elementwise. For example, suppose\n\n$$\n\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}\n$$\n\nThen we can calculate ${A}+{B}-{C}$ by performing the operations on each corresponding entry, as follows:\n\n$$\n\\begin{aligned}A+B-C & =\\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}-\\begin{bmatrix}0 \\\\ 5 \\\\ -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1+(-1)-0 \\\\ 1+2-5 \\\\ -1+0-(-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ -2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$" :tutorial/id #uuid "f6d0bdee-d80b-596a-bef2-41b2d6429eeb" :tutorial/math-academy-id 2973 :tutorial/title "Introduction"} :step/id #uuid "843ddc26-4ece-5c0c-b76f-eb3b2ae356b8" :step/math-academy-id 464512 :step/next {:db/id #edb/ref 17592186101860}} {:db/id #edb/ref 17592186101860 :step/content {:db/id #edb/ref 17592186100991 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100686 :question/id #uuid "0928c2fa-a772-5d39-a638-1b1d0e71be2f" :question/math-academy-id "e-4378" :question/problem "Calculate $A-(B-C),$ where\n\n$$\n\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}\n$$" :question/worked-solution "Performing the operations on each corresponding entry, we get:\n\n$$\n\\begin{aligned}A-(B-C) & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-(\\begin{bmatrix}-1 & -1 \\\\ 2 & 0\\end{bmatrix}-\\begin{bmatrix}0 & -5 \\\\ 1 & 1\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-\\begin{bmatrix}-1-0 & -1-(-5) \\\\ 2-1 & 0-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 & 0 \\\\ 2 & -2\\end{bmatrix}-\\begin{bmatrix}-1 & 4 \\\\ 1 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1-(-1) & 0-4 \\\\ 2-1 & -2-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & -4 \\\\ 1 & -1\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "667ac53c-36b8-56a0-9699-fe27c8373c6b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049304}] :knowledge-point/question-generator {:db/id #edb/ref 17592186549194} :knowledge-point/questions [{:db/id #edb/ref 17592186101106} {:db/id #edb/ref 17592186101132} {:db/id #edb/ref 17592186292852} {:db/id #edb/ref 17592186295084} {:db/id #edb/ref 17592186295085} {:db/id #edb/ref 17592186295086} {:db/id #edb/ref 17592186295087} {:db/id #edb/ref 17592186335989} {:db/id #edb/ref 17592186549167} {:db/id #edb/ref 17592186549172} {:db/id #edb/ref 17592186549181} {:db/id #edb/ref 17592186549186}] :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices"} :step/id #uuid "407278d3-c813-5ac8-8cf6-2aa214dd6409" :step/math-academy-id 464513 :step/next {:db/id #edb/ref 17592186101861}} {:db/id #edb/ref 17592186101861 :step/content {:db/id #edb/ref 17592186101955 :tutorial/content "Since addition and subtraction of matrices are performed elementwise, they have the same properties as addition and subtraction of real numbers.\n\nFor example, if $A,$ $B,$ and $C$ are three $m \\times n$ matrices then we can add them in any order:\n\n$$\n(A+B)+C = A+(B+C) = A+B+C\n$$\n\nMoreover, we can distribute a subtraction over matrices in parentheses:\n\n$$\nA - (B + C) = A - B - C\n$$" :tutorial/id #uuid "fe03e3b3-f2de-50f5-b0cc-b62f7b295f8d" :tutorial/math-academy-id 2974 :tutorial/title "Properties of Matrix Addition and Subtraction"} :step/id #uuid "683ace4f-5219-5026-a420-485f13383a10" :step/math-academy-id 464516 :step/next {:db/id #edb/ref 17592186101862}} {:db/id #edb/ref 17592186101862 :step/content {:db/id #edb/ref 17592186100992 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100687 :question/id #uuid "1b15db42-aba2-575c-a01e-b715450329fd" :question/math-academy-id "e-4379" :question/problem "Find $A+C-(B+A)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}1 & -2 \\\\ \\sqrt{2} & 0 \\\\ 0 & -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses: \n\n$$\n\\begin{aligned}A+C-(B+A) & =A+C-B-A \\\\  & =\\cancel{A}+C-B-\\cancel{A} \\\\  & =C-B\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}C-B & =\\begin{bmatrix}3 & -1 \\\\ 1 & 2 \\\\ -6 & 1\\end{bmatrix}-\\begin{bmatrix}3 & -1 \\\\ 2 & 0 \\\\ -4 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3-3 & -1-(-1) \\\\ 1-2 & 2-0 \\\\ -6-(-4) & 1-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -1 & 2 \\\\ -2 & 0\\end{bmatrix}\\end{aligned}\n$$"} :knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049939}] :knowledge-point/question-generator {:db/id #edb/ref 17592186520657} :knowledge-point/questions [{:db/id #edb/ref 17592186101130} {:db/id #edb/ref 17592186101131} {:db/id #edb/ref 17592186233433} {:db/id #edb/ref 17592186269058} {:db/id #edb/ref 17592186295093} {:db/id #edb/ref 17592186335986} {:db/id #edb/ref 17592186335987} {:db/id #edb/ref 17592186520625} {:db/id #edb/ref 17592186520628} {:db/id #edb/ref 17592186520629} {:db/id #edb/ref 17592186520642} {:db/id #edb/ref 17592186520651}] :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"} :step/id #uuid "fe37dd78-b6d7-5cd1-8c23-51e67c1d3bbe" :step/math-academy-id 464517}] :activity/title "Properties of Matrix Addition" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186101035}]}
