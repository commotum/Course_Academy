    "lessons": [
      {
        ":activity/expected-seconds": 420.0,
        ":activity/first-step": {
          ":db/id": 17592186101859
        },
        ":activity/id": "d0d06916-b04a-5057-b794-744d1e7a0e9f",
        ":activity/scope": {
