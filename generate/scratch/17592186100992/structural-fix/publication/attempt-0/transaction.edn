eld/key "selection"] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/type :answer-field.type/radio] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/choices "4e741637-95ab-516f-aee8-fcd2a66e6254"] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/choices "b48db066-4a82-5bae-9db4-46b113c8ff81"] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/choices "bd3232b0-0ac3-5500-a087-614d4c73c3c2"] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/choices "f7e5c2a1-6d9a-59a8-9a6f-1e1491f8046e"] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/choices "fce71cf9-3f41-5874-bdc5-b6dc96bd3b69"] [:db/add "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/correct "bd3232b0-0ac3-5500-a087-614d4c73c3c2"] [:db/ensure "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5" :answer-field/validate] [:db/add "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c" :question/id #uuid "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c"] [:db/add "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}3 & 3 \\\\ 7 & 7\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}0 & 0 \\\\ 0 & 9\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}3 & 8 \\\\ 6 & 6\\end{bmatrix}$</div>\n</div>"] [:db/add "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 3 \\\\ 7 & 7\\end{bmatrix}\\end{aligned}\n$$"] [:db/add "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c" :question/difficulty :question.difficulty/moderate] [:db/add "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c" :question/answer-fields "bc409f6f-bffb-5064-b3ef-96f4fc8f7cb5"] [:db/ensure "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c" :question/validate] [:db/add 17592186100992 :knowledge-point/questions "20f028a8-5be9-58a0-a6e0-d5a47e8f3d5c"] [:db/add "082d586a-9dd4-51a4-849d-c3da3331554b" :answer/id #uuid "082d586a-9dd4-51a4-849d-c3da3331554b"] [:db/add "082d586a-9dd4-51a4-849d-c3da3331554b" :answer/type :answer.type/math] [:db/add "082d586a-9dd4-51a4-849d-c3da3331554b" :answer/value "\\begin{bmatrix}2 & 8 \\\\ 8 & 6\\end{bmatrix}"] [:db/ensure "082d586a-9dd4-51a4-849d-c3da3331554b" :answer/validate] [:db/add "c2be9156-9760-5024-a721-8cbd6233ed1f" :answer/id #uuid "c2be9156-9760-5024-a721-8cbd6233ed1f"] [:db/add "c2be9156-9760-5024-a721-8cbd6233ed1f" :answer/type :answer.type/math] [:db/add "c2be9156-9760-5024-a721-8cbd6233ed1f" :answer/value "\\begin{bmatrix}7 & 4 \\\\ 4 & 2\\end{bmatrix}"] [:db/ensure "c2be9156-9760-5024-a721-8cbd6233ed1f" :answer/validate] [:db/add "ba6402d0-e6bd-5520-aea9-838d8c4c25ff" :answer/id #uuid "ba6402d0-e6bd-5520-aea9-838d8c4c25ff"] [:db/add "ba6402d0-e6bd-5520-aea9-838d8c4c25ff" :answer/type :answer.type/math] [:db/add "ba6402d0-e6bd-5520-aea9-838d8c4c25ff" :answer/value "\\begin{bmatrix}8 & 4 \\\\ 7 & 2\\end{bmatrix}"] [:db/ensure "ba6402d0-e6bd-5520-aea9-838d8c4c25ff" :answer/validate] [:db/add "b07e6b08-3b34-5889-a2ab-0d638da21ce8" :answer/id #uuid "b07e6b08-3b34-5889-a2ab-0d638da21ce8"] [:db/add "b07e6b08-3b34-5889-a2ab-0d638da21ce8" :answer/type :answer.type/math] [:db/add "b07e6b08-3b34-5889-a2ab-0d638da21ce8" :answer/value "\\begin{bmatrix}1 & 9 \\\\ 8 & 3\\end{bmatrix}"] [:db/ensure "b07e6b08-3b34-5889-a2ab-0d638da21ce8" :answer/validate] [:db/add "53855535-ff20-5ee1-bce5-e79401c4bbdb" :answer/id #uuid "53855535-ff20-5ee1-bce5-e79401c4bbdb"] [:db/add "53855535-ff20-5ee1-bce5-e79401c4bbdb" :answer/type :answer.type/math] [:db/add "53855535-ff20-5ee1-bce5-e79401c4bbdb" :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}"] [:db/ensure "53855535-ff20-5ee1-bce5-e79401c4bbdb" :answer/validate] [:db/add "5894d023-32d1-502b-9bd1-06b4f0f386e4