d #edb/ref 17592186388347}] :answer-field/correct {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186388346} :answer-field/id #uuid "aefbe9b4-2591-5f99-bd99-dce5ef9f6719" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388342}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "60ff0898-484c-5468-ab70-2a2b8951960b" :question/math-academy-id "q-13536" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233433 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2422983-d4c6-5d6a-a655-61aaf19ac8a1" :question/math-academy-id "q-13550" :question/problem "Find $K+L-(K+J)$, if\n\n<div class=\"matrix-operands\">\n<div>$J=\\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix}$</div>\n<div>$K=\\begin{bmatrix}9 & 8 \\\\ 2 & 3\\end{bmatrix}$</div>\n<div>$L=\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}K+L-(K+J) & =K+L-K-J \\\\  & =\\cancel{K}+L-\\cancel{K}-J \\\\  & =L-J\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}L-J & =\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}-\\begin{bmatrix}5 & 2 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}6-5 & 6-2 \\\\ 6-2 & 6-1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 4 \\\\ 4 & 5\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048f24d1-178b-5552-bac6-6a3442ea9fbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 1 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186266184} {:answer/id #uuid "07274542-72df-51ae-9747-e72e289132fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 2 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186266206} {:answer/id #uuid "0d154ee7-4761-51d0-9501-6a2171925a8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 3 & 3\\end{bmatrix}" :db/id #edb/ref 17592186266262} {:answer/id #uuid "5166f1bd-1a23-5981-a02f-80311fc50264" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 2 & 4\\end{bmatrix}" :db/id #edb/ref 17592186266871} {:answer/id #uuid "7a8998f2-311c-5243-b155-02fb3a72a11c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186267225}] :answer-field/correct {:answer/id #uuid "7a8998f2-311c-5243-b155-02fb3a72a11c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 2 \\\\ 3 & 4\\end{bmatrix}" :db/id #edb/ref 17592186267225} :answer-field/id #uuid "c35cca58-1d0a-5976-b167-1406a1720c99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268755}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "52150036-21b2-593f-96c3-821ddd81a9cf" :question/math-academy-id "q-13543" :question/problem "Find $M+O-(N+M)$, if\n\n<div class=\"matrix-operands\">\n<div>$M=\\begin{bmatrix}5 & 5 \\\\ 0 & 1\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}1 & 4 \\\\ 2 & -1\\end{bmatrix}$</div>\n<div>$O=\\begin{bmatrix}8 & 6 \\\\ 5 & 3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}M+O-(N+M) & =M+O-N-M \\\\  & =\\cancel{M}+O-N-\\cancel{M} \\\\  & =O-N\\end{aligned}\n$$\n\nWe are left with a single subtraction. So, we subtract the corresponding entries of the two matrices:\n\n$$\n\\begin{aligned}O-N & =\\begin{bmatrix}8 & 6 \\\\ 5 & 3\\end{bmatrix}-\\begin{bmatrix}1 & 4 \\\\ 2 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}8-1 & 6-4 \\\\ 5-2 & 3-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}7 & 2 \\\\ 3 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186295093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec88c80f-a8ed-502a-bf82-d3f72f783c3f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293854}] :answer-field/correct {:answer/id #uuid "ec88c80f-a8ed-502a-bf82-d3f72f783c3f" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186293854} :answer-field/id #uuid "1ada07d1-b262-5536-98f4-ad7591dc1467" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294012} {:answer-field/choices [{:answer/id #uuid "db546ef4-33b1-5d16-a9a1-4f701c9e3518" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293783}] :answer-field/correct {:answer/id #uuid "db546ef4-33b1-5d16-a9a1-4f701c9e3518" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186293783} :answer-field/id #uuid "49cf1090-dc76-5f9b-9ed9-62afb95195b2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294191} {:answer-field/choices [{:answer/id #uuid