#{[{:db/id #edb/ref 17592186049939 :topic/id #uuid "20058901-3844-51ce-a107-70205a1553fb" :topic/knowledge-points [{:db/id #edb/ref 17592186054686 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054587 :question/id #uuid "7b0757c3-add5-56d5-bdb9-9aa972bc2c60" :question/math-academy-id "e-809" :question/problem "Simplify the expression $-(2x-1.3)$." :question/worked-solution "First, we rewrite the negative sign as multiplication by $(-1)\\mathbin$:\n\n$$\n\\begin{aligned} -(2x-1.3) \\\\ &= (-1)(2x-1.3) \\end{aligned}\n$$\n\nThen, we distribute the $(-1)$ to each term in the parentheses, and simplify:\n\n$$\n\\begin{aligned} (-1)(2x-1.3) \\\\ &= (-1) (2x)-(-1) (1.3) \\\\ &= -2x-(-1.3) \\\\ &= -2x+1.3 \\end{aligned}\n$$"} :knowledge-point/id #uuid "5704b343-dbff-5420-8c13-f30e316d6b8d" :knowledge-point/title "Distributing the Negative Sign over the Difference of Two Terms"} {:db/id #edb/ref 17592186054760 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054490 :question/id #uuid "25228be0-9b9e-50b6-9435-b95178ff0734" :question/math-academy-id "e-1540" :question/problem "Simplify $-\\left(-p + 2q - \\dfrac{1}{3} \\right)$." :question/worked-solution "To distribute the negative sign to the terms inside the parentheses, all we have to do is change the sign of each term.\n\n$$\n\\begin{aligned}\n- (-p + 2q - \\frac{1}{3}) &=  \\\\\n&= p - 2q + \\frac{1}{3}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "f95a482b-4222-5842-b7e3-c39c197df3e6" :knowledge-point/title "Distributing the Negative over More Than Two Terms"} {:db/id #edb/ref 17592186054765 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054493 :question/id #uuid "d95640d6-9f85-565d-9f9e-450ae09f6541" :question/math-academy-id "e-1601" :question/problem "Simplify the expression $-\\left(3n+\\dfrac{1}{2}k \\right)$." :question/worked-solution "First, we rewrite the negative sign as multiplication by $(-1)\\mathbin$:\n\n$$\n\\begin{aligned} - \\left(3n+\\dfrac{1}{2}k \\right) \\\\ &= (-1) \\left(3n+\\dfrac{1}{2}k \\right) \\end{aligned}\n$$\n\nThen, we distribute the $(-1)$ to each term in the parentheses, and simplify:\n\n$$\n\\begin{aligned} (-1) \\left(3n+\\dfrac{1}{2}k \\right) \\\\ &= (-1) (3n)+(-1) \\left(\\dfrac{1}{2}k \\right) \\\\ &= -3n+ \\left(-\\dfrac{1}{2}k \\right) \\\\ &= -3n-\\dfrac{1}{2}k \\end{aligned}\n$$"} :knowledge-point/id #uuid "dff2b5c3-149e-5f99-95e2-52d0496a232a" :knowledge-point/title "Distributing the Negative Sign over the Sum of Two Terms"}] :topic/math-academy-id 137 :topic/next [{:db/id #edb/ref 17592186048267} {:db/id #edb/ref 17592186048511} {:db/id #edb/ref 17592186048524} {:db/id #edb/ref 17592186048764} {:db/id #edb/ref 17592186048863} {:db/id #edb/ref 17592186049496} {:db/id #edb/ref 17592186049846} {:db/id #edb/ref 17592186050099} {:db/id #edb/ref 17592186050661} {:db/id #edb/ref 17592186051079}] :topic/title "Distributing the Negative Sign in a Linear Expression"}]}
