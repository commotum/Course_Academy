 & 11 \\\\ 0 & 3 & 3 & 6 & -6 \\\\ 2 & 0 & 0 & 4 & 12\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 3 & 3 & 6 & -6 \\\\ 0 & 2 & 4 & 2 & -10\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 2 & 4 & 2 & -10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 0 & 2 & -2 & -6\\end{array}\\right] & {R}_{3}:=\\frac{1}{2}{R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 1 & 2 & -2 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{2}:={R}_{2}+(-1){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & -2 & 1 & 11 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{3} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & -1 & 0 & -1 & 5 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{cccc|c}1 & 0 & 0 & 2 & 6 \\\\ 0 & 1 & 0 & 3 & 1 \\\\ 0 & 0 & 1 & -1 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2w &=6 \\\\ y+3w &=1 \\\\ z-w &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$ and $z$, and we have one free variable, $w$. That means we need to find $x$ and $y$ and $z$ in terms of $w$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2w+6 \\\\ y &=-3w+1 \\\\ z &=w-3 \\\\ w &=w,\\end{aligned}\\right.\n$$\n\nwhere $w$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z \\\\ w\\end{bmatrix}=\\begin{bmatrix}-2w+6 \\\\ -3w+1 \\\\ w-3 \\\\ w\\end{bmatrix},\\,w\\in (-\\infty ,\\infty ).\n$$" 13194139536014 17592186045443 