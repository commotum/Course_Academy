            {
              ":answer/id": "3a133a05-eec4-56f3-8f77-e16cbc3b1738",
              ":answer/type": ":answer.type/text",
              ":answer/value": "The center is $(2,3)$ and radius is $\\sqrt{6}$"
            },
            {
              ":answer/id": "05b2cecf-cf29-561e-95d6-7645b9287c05",
