    "question": {
      ":question/id": "0b87d9a6-aa4f-5b09-94af-b4fa0f1e8eb2",
      ":question/problem": "What is the center and radius of the circle with equation $(x-2)^{2}+(y-3)^{2}=6?$",
      ":question/answer-fields": [
        {
          ":answer-field/id": "d23247f6-a285-533a-9a69-7bbbf166361a",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
