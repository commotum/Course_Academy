#{[{:db/id #edb/ref 17592186087656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087464 :question/id #uuid "e2d2147e-98df-54df-a271-4c5dff362a96" :question/math-academy-id "e-3226" :question/problem "What is the center and radius of the circle with equation $(x-2)^2 + (y+4)^2 = 9?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^2 + (y-b)^2 = r^2.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-2)^{2}+(y+4)^{2} & =9 \\\\ (x-2)^{2}+(y-(-4))^{2} & ={3}^{2}.\\end{aligned}\n$$\n\nWe see that $a = 2,$ $b = - 4,$ and $r = 3.$ \n\nTherefore, the circle is centered at $(2,-4)$ and its radius is $3.$"} :knowledge-point/id #uuid "89462485-2e28-5727-82c7-7afd0cac6d77" :knowledge-point/question-generator {:db/id #edb/ref 17592186554985 :question-generator/id #uuid "759ed1f8-5608-553b-a730-0f1041f100a1" :question-generator/script "generate/scratch/17592186087656.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186088311 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0576cbfe-64f6-5bc3-a016-f311431b8cc7" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(2,3)$ and radius is $6$" :db/id #edb/ref 17592186342291} {:answer/id #uuid "2d02910a-922e-5c4c-b5fc-7dd9508107d6" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-2,-3)$ and radius is $6$" :db/id #edb/ref 17592186342614} {:answer/id #uuid "30c13b16-79f8-5389-b2ee-a0eb671325c0" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(0,0)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186342645} {:answer/id #uuid "bc241e1f-2741-5d91-8f59-ef85f94eac0e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-2,-3)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186343891} {:answer/id #uuid "c972847a-26b8-5b15-aa4d-ff0fb36da0a5" :answer/