c{3}{2})^{2}+(y-7)^{2} & =(\\sqrt{6})^{2}.\\end{aligned}\n$$\n\nWe see that $a=\\frac{3}{2},$ $b=7,$ and $r=\\sqrt{6}.$ \n\nTherefore, the circle is centered at $(\\frac{3}{2},7)$ and its radius is $\\sqrt{6}.$"} {:db/id #edb/ref 17592186554932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "273abafe-ba93-5ef4-b7d7-548062af84f0" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},8)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554926} {:answer/id #uuid "7df4ba67-f3c5-53fb-969d-e841de7a616e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},8)$ and radius is $6$" :db/id #edb/ref 17592186554949} {:answer/id #uuid "8f527fb4-56ba-530f-acb6-63dc188675c0" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{1}{3},8)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554952} {:answer/id #uuid "942a1072-d356-51c4-915d-fcd75290cdb8" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},-8)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554955} {:answer/id #uuid "dd5bb832-468d-5651-ae80-29423fd1ed60" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{1}{3},-8)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554973}] :answer-field/correct {:answer/id #uuid "273abafe-ba93-5ef4-b7d7-548062af84f0" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(\\frac{1}{3},8)$ and radius is $\\sqrt{6}$" :db/id #edb/ref 17592186554926} :answer-field/id #uuid "61a85701-a89b-5878-8449-132e740cd5e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554940}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "50d11243-b049-5342-9037-749a79e26f81" :question/problem "What is the center and radius of the circle with equation $(x-\\frac{1}{3})^{2}+(y-8)^{2}=6?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-\\frac{1}{3})^{2}+(y-8)^{2} & =6 \\\\ (x-\\frac{1}{3})^{2}+(y-8)^{2} & =(\\sqrt{6})^{2}.\\end{aligned}\n$$\n\nWe see that $a=\\frac{1}{3},$ $b=8,$ and $r=\\sqrt{6}.$ \n\nTherefore, the circle is centered at $(\\frac{1}{3},8)$ and its radius is $\\sqrt{6}.$"} {:db/id #edb/ref 17592186554938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6de55eaf-17ee-5180-b536-6e70231ca83e" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(9,- \\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554944} {:answer/id #uuid "830a7024-2eb6-5534-ae40-8621397df894" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-9,\\frac{5}{3})$ and radius is $2$" :db/id #edb/ref 17592186554950} {:answer/id #uuid "967b10dc-6bc5-53bb-a955-2d5fc10046b3" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(9,\\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554958} {:answer/id #uuid "a5998cb0-7798-5743-86e8-d75dcf141c69" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-9,\\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554960} {:answer/id #uuid "aea6b0ba-0f0a-5feb-9aab-4d96970899bc" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-9,- \\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554962}] :answer-field/correct {:answer/id #uuid "a5998cb0-7798-5743-86e8-d75dcf141c69" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-9,\\frac{5}{3})$ and radius is $\\sqrt{2}$" :db/id #edb/ref 17592186554960} :answer-field/id #uuid "5a5970ab-7ec8-5afc-a44d-1b9799c0fd60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554935}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5e262cf1-9959-5c00-9241-8356b237b6d0" :question/problem "What is the center and radius of the circle with equation $(x+9)^{2}+(y-\\frac{5}{3})^{2}=2?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+9)^{2}+(y-\\frac{5}{3})^{2} & =2 \\\\ (x-(-9))^{2}+(y-\\frac{5}{3})^{2} & =(\\sqrt{2})^{2}.\\end{aligned}\n$$\n\nWe see that $a=-9,$ $b=\\frac{5}{3},$ and $r=\\sqrt{2}.$ \n\nTherefore, the circle is centered at $(-9,\\frac{5}{3})$ and its radius is $\\sqrt{2}.$"} {:db/id #edb/ref 17592186554939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a869629-3129-5a48-b814-3ca9009f93a6" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $75$" :db/id #edb/ref 17592186554929} {:answer/id #uuid "5363a872-00c2-59dc-9aef-c1861b33c441" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},- \\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554933} {:answer/id #uuid "694d2ebd-518e-56b2-91e5-b162c47dfcdc" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},- \\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554942} {:answer/id #uuid "7039e8d1-5a0b-5709-9a54-16e8324253c3" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554945} {:answer/id #uuid "7a590015-345d-55cf-902a-d501711e512c" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(\\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554948}] :answer-field/correct {:answer/id #uuid "7039e8d1-5a0b-5709-9a54-16e8324253c3" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{3}{2},\\frac{1}{2})$ and radius is $5 \\sqrt{3}$" :db/id #edb/ref 17592186554945} :answer-field/id #uuid "c5c87030-ce63-5b8f-a2fb-928bbcbfc368" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186554969}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "61a667fa-1c17-504b-b910-d39cb45f95f5" :question/problem "What is the center and radius of the circle with equation $(x+\\frac{3}{2})^{2}+(y-\\frac{1}{2})^{2}=75?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+\\frac{3}{2})^{2}+(y-\\frac{1}{2})^{2} & =75 \\\\ (x-(- \\frac{3}{2}))^{2}+(y-\\frac{1}{2})^{2} & =(5 \\sqrt{3})^{2}.\\end{aligned}\n$$\n\nThe radius is the positive square root of the right-hand side:\n\n$$\nr=\\sqrt{75}=\\sqrt{25\\cdot 3}=5 \\sqrt{3}.\n$$\n\nWe see that $a=- \\frac{3}{2},$ $b=\\frac{1}{2},$ and $r=5 \\sqrt{3}.$ \n\nTherefore, the circle is centered at $(- \\frac{3}{2},\\frac{1}{2})$ and its radius is $5 \\sqrt{3}.$"} {:db/id #edb/ref 17592186554941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14bf130e-5183-5004-9744-fe22eba9aa52" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},\\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554921} {:answer/id #uuid "5a3b6c09-e3df-5465-b189-6b05b4e444b0" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(- \\frac{9}{2},- \\frac{1}{3})$ and radius is $2 \\sqrt{3}$" :db/id #edb/ref 17592186554934} {:answer/id #uuid "5c664509-2dac-5ad9-95fa-1d73576a