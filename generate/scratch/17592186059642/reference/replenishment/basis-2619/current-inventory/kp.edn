cdot\\left(\\operatorname{tan}⁡\\phi+\\operatorname{sec}⁡\\phi\\right)\n$$"} {:db/id #edb/ref 17592186543947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54edeba8-927f-56a7-b47f-e46bb9ab034e" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{cot}⁡\\phi" :db/id #edb/ref 17592186543925} {:answer/id #uuid "7bc3dbb2-eabc-5f51-8d0d-fe7444a83cc9" :answer/type {:db/ident :answer.type/math} :answer/value "-(8\\operatorname{tan}⁡\\phi)" :db/id #edb/ref 17592186543931} {:answer/id #uuid "9d17391d-e21d-5862-a0c0-ed1309eafc36" :answer/type {:db/ident :answer.type/math} :answer/value "(8\\operatorname{tan}⁡\\phi)\\sin \\phi" :db/id #edb/ref 17592186543941} {:answer/id #uuid "c71ec218-4a75-51eb-8d8a-dabab8c2d97c" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{tan}⁡\\phi" :db/id #edb/ref 17592186543952} {:answer/id #uuid "f36257d7-71ad-576f-96fa-5afff209087b" :answer/type {:db/ident :answer.type/math} :answer/value "2(8\\operatorname{tan}⁡\\phi)" :db/id #edb/ref 17592186543958}] :answer-field/correct {:answer/id #uuid "c71ec218-4a75-51eb-8d8a-dabab8c2d97c" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{tan}⁡\\phi" :db/id #edb/ref 17592186543952} :answer-field/id #uuid "813958db-5f62-52cd-b1f0-43bdcb335b0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186543933}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "af869c9b-07fb-5375-ae05-04154af3873f" :question/problem "Simplify the trigonometric expression $8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+{sin}^{3}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right).$" :question/worked-solution "First, we factor the numerator:\n\n$$\n8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+{sin}^{3}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right)=8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi\\cdot ({cos}^{2}⁡\\phi+{sin}^{2}⁡\\phi)}{\\operatorname{cos}⁡\\phi}\\right)\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi\\cdot ({cos}^{2}⁡\\phi+{sin}^{2}⁡\\phi)}{\\operatorname{cos}⁡\\phi}\\right) & =8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi\\cdot 1}{\\operatorname{cos}⁡\\phi}\\right) \\\\  & =8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right) \\\\  & =8\\operatorname{tan}⁡\\phi\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n8\\cdot\\left(\\frac{\\operatorname{sin}⁡\\phi{cos}^{2}⁡\\phi+{sin}^{3}⁡\\phi}{\\operatorname{cos}⁡\\phi}\\right)=8\\operatorname{tan}⁡\\phi.\n$$"} {:db/id #edb/ref 17592186543955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0dea40-078d-57fb-b788-b0b16a91c633" :answer/type {:db/ident :answer.type/math} :answer/value "2(4\\cdot\\left(\\sec \\theta\\right))" :db/id #edb/ref 17592186543908} {:answer/id #uuid "27c5b10d-1747-5f0b-bda4-57f4a1dede6d" :answer/type {:db/ident :answer.type/math} :answer/value "-(4\\cdot\\left(\\sec \\theta\\right))" :db/id #edb/ref 17592186543913} {:answer/id #uuid "2f2eb67d-b2c3-509f-8428-7cd3fdcafd43" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\cdot\\left(\\sec \\theta\\right))\\cos \\theta" :db/id #edb/ref 17592186543917} {:answer/id #uuid "302146b1-f7eb-5c30-ab81-8cc0d559242b" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot\\left(\\sec \\theta\\right)" :db/id #edb/ref 17592186543918} {:answer/id #uuid "a6da46f1-dfa8-52eb-baa0-9083808ff7cd" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot\\left(\\cos \\theta\\right)" :db/id #edb/ref 17592186543945}] :answer-field/correct {:answer/id #uuid "302146b1-f7eb-5c30-ab81-8cc0d559242b" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot\\left(\\sec \\theta\\right)" :db/id #edb/ref 17592186543918} :answer-field/i