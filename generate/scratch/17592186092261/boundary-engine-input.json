d"]}]}, "generation": {"version": "general-exponential-chain-1", "template": "q-71881", "profile": "method:q-71881", "parameters": {"b": 6, "c": 5, "a": -9, "n": 3, "k": 0, "l": -3, "d": 0}, "seed": 0, "source": {"database": "math", "basis": 1356, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "source_ids": ["q-71881"], "difficulty_design": "observed", "answer_shape": "derivative", "evidence_only": false, "eligible_for_learning": true, "presentation_and_completion_repairs": ["normalize natural-log spelling and invisible function-apply characters", "make numeric-base multiplication explicit", "authored supported full-derivative blank with matching placeholder"], "mathematical_fingerprint": "28cd481a8ebcc8f7faea84f67b8a5aefd7db5529c47f5c58872f78ccbb59bef1", "answer_math": {"719f0a6c-a9cf-53d7-beb1-5de33a88fdfd": "5*6**(-9*x**3 - 3*x)*(-27*x**2 - 3)*log(6)"}, "recipes": {"719f0a6c-a9cf-53d7-beb1-5de33a88fdfd": "correct"}, "runtime": {"python": "3.13.5", "sympy": "1.14.0"}, "plot_rating": "none"}}, "checks": [{"submitted": "5 \\cdot 6^{- 9 x^{3} - 3 x} \\left(- 27 x^{2} - 3\\right) \\ln{\\left(6 \\right)}", "expected": "accepted", "purpose": "canonical supported blank"}, {"submitted": "(- 27 x^{2} - 3)*ln(6)*(5)*(6)^(- 9 x^{3} - 3 x)", "expected": "accepted", "purpose": "equivalent unreduced chain-rule factors"}, {"submitted": "(5 \\cdot 6^{- 9 x^{3} - 3 x} \\left(- 27 x^{2} - 3\\right) \\ln{\\left(6 \\right)})+1", "expected": "rejected", "purpose": "incorrect value"}]}, {"label": "signed/q-107459", "record": {"knowledge_point": {"db_id": 17592186092261, "id": "2f4bfd24-dafd-57b3-940a-154a6e0acf3d", "title": "Differentiating a General Exponential Function Using the Chain Rule"}, "question": {":question/id": "55bd0793-8e78-5484-91eb-21170b8aeaed", ":question/problem": "Given that $y=5\\cdot {6}^{-9{x}^{2}-1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$", ":question/worked-solution": "First, we express $y$ as the composite function\n\n$$\ny=5\\cdot {6}^{u},\\,u=-9{x}^{2}-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=5\\cdot {6}^{u}\\ln6,\\,\\frac{\\text{d}u}{\\text{d}x}=-18x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =5\\cdot {6}^{u}\\ln6\\cdot (-18x) \\\\  & =-90x\\cdot {6}^{-9{x}^{2}-1}\\ln6.\\end{aligned}\n$$", ":question/difficulty": ":question.difficulty/easy", ":question/answer-fields": [{":answer-field/id": "594965be-2423-5970-b8fb-0cf009816273", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "08b30a1e-c5fd-5142-8954-d68f59a120ff", ":answer/type": ":answer.type/math", ":answer/value": "5 \\cdot 6^{- 9 x^{2} - 1} \\ln{\\left(6 \\right)}"}, {":answer/id": "50bf0786-cbf7-550d-89d5-e112edaefbe8", ":answer/type": ":answer.type/math", ":answer/value": "- 90 \\cdot 6^{- 9 x^{2} - 1} x"}, {":answer/id": "1fac099d-b02f-5aac-9786-a36795912078", ":answer/type": ":answer.type/math", ":answer/value": "- 90 \\cdot 6^{- 9 x^{2} - 1} x \\ln{\\left(6 \\right)}"}, {":answer/id": "34e10eca-8743-54f4-8355-b80973f0f689", ":answer/type": ":answer.type/math", ":answer/value": "- 90 \\cdot 6^{- 9 x^{2} - 2} x \\left(- 9 x^{2} - 1\\right)"}, {":answer/id": "c3cd6fc3-8eee-5882-b0a5-ac1f9a7e2591", ":answer/type": ":answer.type/math", ":answer/value": "90 \\cdot 6^{- 9 x^{2} - 1} x \\ln{\\left(6 \\right)}"}], ":answer-field/correct": [":answer/id", "1fac099d-b02f-5aac-9786-a36795912078"]}]}, "generation": {"version": "general-exponential-chain-1", "template": "q-107459", "profile": "method:q-107459", "parameters": {"b": 6, "c": 5, "a": -9, "n": 2, "k": 0, "l": 0, "d": -1}, "seed": 0, "source": {"database": "math", "basis": 1356, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "source_ids": ["q-107459"], "difficulty_design": "observed", "answer_shape": "derivative", "evidence_only": false, "eligible_for_learning": true, "presentation_and_completion_repairs": ["normalize natural-log spelling and invisible function-apply characters", "make numeric-base multiplication explicit"], "mathematical_fingerprint": "d43ba62d18021de08d222e1144d267ac92d63f2db7ac348a6643dcfc1d9ace11", "answer_math": {"1fac099d-b02f-5aac-9786-a36795912078": "-90*6**(-9*x**2 - 1)*x*log(6)", "50bf0786-cbf7-550d-89d5-e112edaefbe8": "-90*6**(-9*x**2 - 1)*x", "08b30a1e-c5fd-5142-8954-d68f59a120ff": "5*6**(-9*x**2 - 1)*log(6)", "c3cd6fc3-8eee-5882-b0a5-ac1f9a7e2591": "90*6**(-9*x**2 - 1)*x*log(6)", "34e10eca-8743-54f4-8355-b80973f0f689": "-90*6**(-9*x**2 - 2)*x*(-9*x**2 - 1)"}, "recipes": {"1fac099d-b02f-5aac-9786-a36795912078": "correct", "50bf0786-cbf7-550d-89d5-e112edaefbe8": "omit-natural-log", "08b30a1e-c5fd-5142-8954-d68f59a120ff": "omit-inner-derivative", "c3cd6fc3-8eee-5882-b0a5-ac1f9a7e2591": "reverse-inner-sign", "34e10eca-8743-54f4-8355-b80973f0f689": "use-power-rule-on-base-power"}, "runtime": {"python": "3.13.5", "sympy": "1.14.0"}, "plot_rating": "none"}}, "checks": [{"submitted_answer_id": "08b30a1e-c5fd-5142-8954-d68f59a120ff", "expected": "rejected", "purpose": "all radio selections"}, {"submitted_answer_id": "50bf0786-cbf7-550d-89d5-e112edaefbe8", "expected": "rejected", "purpose": "all radio selections"}, {"submitted_answer_id": "1fac099d-b02f-5aac-9786-a36795912078", "expected": "accepted", "purpose": "all radio selections"}, {"submitted_answer_id": "34e10eca-8743-54f4-8355-b80973f0f689", "expected": "rejected", "purpose": "all radio selections"}, {"submitted_answer_id": "c3cd6fc3-8eee-5882-b0a5-ac1f9a7e2591", "expected": "rejected", "purpose": "all radio selections"}]}, {"label": "signed/q-1952", "record": {"knowledge_point": {"db_id": 17592186092261, "id": "2f4bfd24-dafd-57b3-940a-154a6e0acf3d", "title": "Differentiating a General Exponential Function Using the Chain Rule"}, "question": {":question/id": "d99fb948-9ac1-5e34-899a-d5c7ac169ec9", ":question/problem": "Given that $y={6}^{-9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$", ":question/worked-solution": "First, we express $y$ as the composite function\n\n$$\ny={6}^{u},\\,u=-9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={6}^{u}\\ln6,\\,\\frac{\\text{d}u}{\\text{d}x}=-9.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}\\ln6\\cdot (-9) \\\\  & =-9\\ln6\\cdot {6}^{u} \\\\  & =-9\\ln6\\cdot {6}^{-9x}.\\end{aligned}\n$$", ":question/difficulty": ":question.difficulty/easy", ":question/answer-fields": [{":answer-field/id": "4ee599d3-c9a0-5138-9433-641dd310f3c6", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "da4eac28-7422-5fe0-acf5-d1897b1f596a", ":answer/type": ":answer.type/math", ":answer/value": "6^{- 9 x} \\ln{\\left(6 \\right)}"}, {":answer/id": "e8983cd9-c0b5-57cc-a4df-56ec33c4550d", ":answer/type": ":answer.type/math", ":answer/value": "- 9 \\cdot 6^{- 9 x}"}, {":answer/id": "1af35794-5711-5c64-9ff6-23f142bca5bc", ":answer/type": ":answer.type/math", ":answer/value": "- 9 \\cdot 6^{- 9 x} \\ln{\\left(6 \\right)}"}, {":answer/id": "441f79a2-630b-5cdb-b72c-a18b1b42dc51", ":answer/type": ":answer.type/math", ":answer/value": "81 \\cdot 6^{- 9 x - 1} x"}, {":answer/id": "2f574be9-4c66-5bb7-a9db-c6bbc30e8a33", ":answer/type": ":answer.type/math", ":answer/value": "9 \\cdot 6^{- 9 x} \\ln{\\left(6 \\right)}"}], ":answer-field/correct": [":answer/id", "1af35794-5711-5c64-9ff6-23f142bca5bc"]}]}, "generation": {"version": "general-exponential-chain-1", "template": "q-1952", "profile": "method:q-1952", "parameters": {"b": 6, "c": 1, "a": -9, "n": 1, "k": 0, "l": 0, "d": 0}, "seed": 0, "source": {"database": "math", "basis": 1356, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "source_ids": ["q-1952"], "difficulty_design": "observed", "answer_shape": "derivative", "evidence_only": false, "eligible_for_learning": true, "presentation_and_completion_repairs": ["normalize natural-log spelling and invisible function-apply characters", "make numeric-base multiplication explicit"], "mathematical_fingerprint": "e4d722ac7a461f9bee6691fd58322a9d5748ea39b010690475b081dae42198ac", "answer_math": {"1af35794-5711-5c64-9ff6-23f142bca5bc": "-9*log(6)/6**(9*x)", "e8983cd9-c0b5-57cc-a4df-56ec33c4550d": "-9/6**(9*x)", "da4eac28-7422-5fe0-acf5-d1897b1f596a": "log(6)/6**(9*x)", "2f574be9-4c66-5bb7-a9db-c6bbc30e8a33": "9*log(6)/6**(9*x)", "441f79a2-630b-5cdb-b72c-a18b1b42dc51": "81*6**(-9*x - 1)*x"}, "recipes": {"1af35794-5711-5c64-9ff6-23f142bca5bc": "correct", "e8983cd9-c0b5-57cc-a4df-56ec33c4550d": "omit-natural-log", "da4eac28-7422-5fe0-acf5-d1897b1f596a": "omit-inner-derivative", "2f574be9-4c66-5bb7-a9db-c6bbc30e8a33": "reverse-inner-sign", "441f79a2-630b-5cdb-b72c-a18b1b42dc51": "use-power-rule-on-base-power"}, "runtime": {"python": "3.13.5", "sympy": "1.14.0"}, "plot_rating": "none"}}, "checks": [{"submitted_answer_id": "da4eac28-7422-5fe0-acf5-d1897b1f596a", "expected": "rejected", "purpose": "all radio selections"}, {"submitted_answer_id": "e8983cd9-c0b5-57cc-a4df-56ec33c4550d", "expected": "rejected", "purpose": "all radio selections"}, {"submitted_answer_id": "1af35794-5711-5c64-9ff6-23f142bca5bc", "expected": "accepted", "purpose": "all radio selections"}, {"submitted_answer_id": "441f79a2-630b-5cdb-b72c-a18b1b42dc51", "expected": "rejected", "purpose": "all radio selections"}, {"submitted_answer_id": "2f574be9-4c66-5bb7-a9db-c6bbc30e8a33", "expected": "rejected", "purpose": "all radio selections"}]}]