\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430774 :knowledge-point/_questions [{:knowledge-point/id #uuid "38fd4660-39ca-585f-8e3a-5d8b569be77d" :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37e9bbb5-54b5-5e26-a0a0-50d7cf20ec9d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{25}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430735} {:answer/id #uuid "6ef3239f-a18f-5059-bc4c-90c9f800c498" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{2}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430746} {:answer/id #uuid "eb9c6068-17a0-54f3-9151-2a048c9f0abc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430759} {:answer/id #uuid "f3db7076-912a-5dca-b78b-50d779ed3d9a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{5}{r}^{2}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430761} {:answer/id #uuid "f55622cc-0b32-52f4-8ae8-9cf843cdb023" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{25}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430762}] :answer-field/correct {:answer/id #uuid "eb9c6068-17a0-54f3-9151-2a048c9f0abc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430759} :answer-field/id #uuid "e75c2f8e-ad0e-567f-ad60-4f9161bdb2d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430767}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b93ec44e-b9fb-53f6-875f-5ef36dc8b48a" :question/math-academy-id "q-161043" :question/problem "![](images/2d/2db1e29e5f911a45c4c48ab41c4ad6dc63eeb36a8112672ae66844e14342f4c0.png)\n\nThe region $D$ is the circle shown above. What is ${∬}_{D}{y}^{2}\\,\\text{d}A$ expressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\,dA={∬}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\,dr\\,d\\theta .\n$$\n\nFirst, notice that the region $D$ represents the disk of radius $5$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 5,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}{(r\\operatorname{sin}⁡\\theta )}^{2}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{5}{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535305 :knowledge-point/_questions [{:knowledge-point/id #uuid "38fd4660-39ca-585f-8e3a-5d8b569be77d" :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b7ecb05-1f77-5c9b-949f-8b550e12bba5" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535312} {:answer/id #uuid "5f024063-ee92-5cb7-978b-c79d51157378" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{3} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535316} {:answer/id #uuid "64e43474-9757-5e33-b010-824d5d3f6779" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{2 \\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535317} {:answer/id #uuid "b084bb87-f29b-5c6f-94e2-128e3b06e91d" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\pi}^{\\frac{5 \\pi}{4}}\\int_{0}^{\\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535328} {:answer/id #uuid "e7d518f6-4dab-5351-89ef-0d2c20254b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{5} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535339}] :answer-field/correct {:answer/id #uuid "4b7ecb05-1f77-5c9b-949f-8b550e12bba5" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535312} :answer-field/id #uuid "a94d5ba0-df8c-591a-8338-f599fb3218e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535326}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "304130fc-d60c-53ec-8352-d4d3005586d2" :question/problem "![](images/38/38947ad6e5f10e1e25d3d10777ad28c47aac1f0c0f311621c0194bef815331ab.png)\n\nThe region $D$ is the quarter-circle shown above. What is $\\iint_D 2 x y \\sqrt{x^{2} + y^{2}}\\,\\mathrm{d}A$ expressed in polar coordinates?\n\nChoose a change-of-variables setup with $r\\geq0$ that describes $D$ and the transformed integrand, including the Jacobian." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iint_D f(x,y)\\,\\mathrm{d}A=\\iint_\\Delta f(r\\cos\\theta,r\\sin\\theta)\\,r\\,\\mathrm{d}r\\,\\mathrm{d}\\theta.\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\sqrt{2}$ centered at the origin. In polar coordinates $(r,\\theta),$ the region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta):0\\leq r\\leq \\sqrt{2},\\ \\pi\\leq\\theta\\leq \\frac{3 \\pi}{2}\\}.\n$$\n\nSince $r\\geq0$, $\\sqrt{r^2}=r$; also $\\cos^2\\theta+\\sin^2\\theta=1$.\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iint_D 2 x y \\sqrt{x^{2} + y^{2}}\\,\\mathrm{d}A&=\\iint_\\Delta 2 (r\\cos\\theta) (r\\sin\\theta) \\sqrt{(r\\cos\\theta)^{2} + (r\\sin\\theta)^{2}}\\,r\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}2r^3\\cos\\theta\\sin\\theta\\sqrt{r^2(\\cos^2\\theta+\\sin^2\\theta)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}2r^4\\cos\\theta\\sin\\theta\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{\\pi}^{\\frac{3 \\pi}{2}}\\int_{0}^{\\sqrt{2}}r^4\\sin(2\\theta)\\,\\mathrm{d}r\\,\\mathrm{d}\\theta\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535318 :knowledge-point/_questions [{:knowledge-point/id #uuid "38fd4660-39ca-585f-8e3a-5d8b569be77d" :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "266130f7-fe7a-555d-8bc3-c644a951aa45" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{4}}\\int_{0}^{\\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535303} {:answer/id #uuid "33180dbf-afc0-5cf5-a045-d20f9c205b3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{3} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535306} {:answer/id #uuid "a958bcf2-9156-5ac1-892f-0a551baa748b" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{2 \\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535327} {:answer/id #uuid "d0307e5f-4a08-5149-9fb2-d9fdd6da4411" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535334} {:answer/id #uuid "eb76449e-7e26-50e6-90fa-e3ea350c8e4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{5} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535340}] :answer-field/correct {:answer/id #uuid "d0307e5f-4a08-5149-9fb2-d9fdd6da4411" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^{4} \\sin{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535334} :answer-field/id #uuid "416649c6-1d29-50f8-997b-94939fdfa192" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535308}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "65d15c33-14f0-5a8d-980c-cdd3dc5eab53" :question/problem "![](images/b4/b4a332a1bea58e47ab58fa47c6944213ce4caa5d26e6bfb129fea613adcd524b.png)\n\nThe region $D$ is the quarter-circle shown above. What is $\\iint_D 2 x y \\sqrt{x^{2} + y^{2}}\\,\\mathrm{d}A$ expressed in polar coordinates?\n\nChoose a change-of-variables setup with $r\\geq0$ that describes $D$ and the transformed integrand, including the Jacobian." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iint_D f(x,y)\\,\\mathrm{d}A=\\iint_\\Delta f(r\\cos\\theta,r\\sin\\theta)\\,r\\,\\mathrm{d}r\\,\\mathrm{d}\\theta.\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\sqrt{2}$ centered at the origin. In polar coordinates $(r,\\theta),$ the region can be expressed as\n\n$$\n\\Delta=\\{(r,\\theta):0\\leq r\\leq \\sqrt{2},\\ 0\\leq\\theta\\leq \\frac{\\pi}{2}\\}.\n$$\n\nSince $r\\geq0$, $\\sqrt{r^2}=r$; also $\\cos^2\\theta+\\sin^2\\theta=1$.\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\\iint_D 2 x y \\sqrt{x^{2} + y^{2}}\\,\\mathrm{d}A&=\\iint_\\Delta 2 (r\\cos\\theta) (r\\sin\\theta) \\sqrt{(r\\cos\\theta)^{2} + (r\\sin\\theta)^{2}}\\,r\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}2r^3\\cos\\theta\\sin\\theta\\sqrt{r^2(\\cos^2\\theta+\\sin^2\\theta)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}2r^4\\cos\\theta\\sin\\theta\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^4\\sin(2\\theta)\\,\\mathrm{d}r\\,\\mathrm{d}\\theta\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535320 :knowledge-point/_questions [{:knowledge-point/id #uuid "38fd4660-39ca-585f-8e3a-5d8b569be77d" :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "216605b1-8c00-525a-9c5d-7a682e81d7b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{4}}\\int_{0}^{\\sqrt{2}}r^{4} \\cos{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535302} {:answer/id #uuid "89118a1c-8cc3-5bd9-ac73-77a6bba3f97c" :answer/type {:db/ident :answer.type/math} :answer/value "\\int_{\\frac{\\pi}{2}}^{\\pi}\\int_{0}^{\\sqrt{2}}r^{4} \\cos{\\left(2 \\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186535323} {:answer/id #uuid "b6049116-ddb2-5a7e-a166-ed4e50566d53" :answer/type {:db/ident :a