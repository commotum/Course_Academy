 }_{-\\sqrt{2}}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411751} {:answer/id #uuid "adfa686a-3a9f-5c43-baff-2feb8fd0100f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{-\\sqrt{2}}^{\\sqrt{2}}r\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411769} {:answer/id #uuid "cb339401-80d8-5441-8a36-c4eb7250cbc0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411789} {:answer/id #uuid "cfda085a-1d8b-55be-bd0f-4cfdeac71375" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411794}] :answer-field/correct {:answer/id #uuid "cb339401-80d8-5441-8a36-c4eb7250cbc0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186411789} :answer-field/id #uuid "75ea2526-b966-5bc2-949f-e2b7d5c9deed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72611a88-9d34-5676-b505-ea5928bf6c8a" :question/math-academy-id "q-83500" :question/problem "![](images/55/55bbf6f55ce287321f2cc593ea48d65a78c655ca18d2a34df68b63c2bda92c8f.png)\n\nThe region $D$ is the semicircle shown above. What is\n${∬}_{D}(x+y)\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $\\sqrt{2}$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le \\sqrt{2},\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}(x+y)\\,\\text{d}A & ={∬}_{Δ}((r\\operatorname{cos}⁡\\theta )+(r\\operatorname{sin}⁡\\theta ))\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186430773 :knowledge-point/_questions [{:knowledge-point/id #uuid "38fd4660-39ca-585f-8e3a-5d8b569be77d" :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c2bf0f-9ee2-5d88-8b23-545cf4448435" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430734} {:answer/id #uuid "7c5313f3-0d47-59ad-80f4-3575ea706678" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi /2}{\\int }_{0}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430750} {:answer/id #uuid "bdef2d30-346b-534b-81e2-deb246402953" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\sqrt{3}}^{\\sqrt{3}}{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186430753} {:answer/id #uuid "ccbd5dd6-3cb9-5c6a-a847-fed35c7db186" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{-\\sqrt{3}}^{\\sqrt{3}}{r}^{2}\\operat