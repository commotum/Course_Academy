\sqrt{(r\\cos\\theta)^{2} + (r\\sin\\theta)^{2}}\\,r\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^3(\\cos^2\\theta-\\sin^2\\theta)\\sqrt{r^2(\\cos^2\\theta+\\sin^2\\theta)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^4(\\cos^2\\theta-\\sin^2\\theta)\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ &=\\int_{0}^{\\frac{\\pi}{2}}\\int_{0}^{\\sqrt{2}}r^4\\cos(2\\theta)\\,\\mathrm{d}r\\,\\mathrm{d}\\theta\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535342 :knowledge-point/_questions [{:knowledge-point/id #uuid "38fd4660-39ca-585f-8e3a-5d8b569be77d" :knowledge-point/title "Rewriting a Double Integral Over a Circle or Part-Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "490bf319-a19a-5705-874f-041fecb63bc4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{2}}r\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186535310} {:answer/id #uuid "56407af4-1fb7-53b1-86b8-13243e6095fc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2}\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186535314} {:answer/id #uuid "5d545206-ca9c-5b98-9471-863533f19aca" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{2}}\\operatorname{ln}⁡(r+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186535315} {:answer/id #uuid "71005229-4609-51a5-b252-aec7c9944620" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{2}}r\\operatorname{ln}⁡({r}^{2}+1)\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186535321} {:answer/id #uuid "b12e0871-185b-543d-bc3b-20afa90aead8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{2}\\operatorname{ln}⁡(r+1)\\,\\te