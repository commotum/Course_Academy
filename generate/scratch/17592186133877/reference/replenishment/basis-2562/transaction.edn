[{:db/id "789103f3-62e6-55d8-a195-73f4a7b6d1f2" :answer/id #uuid "789103f3-62e6-55d8-a195-73f4a7b6d1f2" :answer/type :answer.type/math :answer/value "- 14 k z" :db/ensure :answer/validate} {:db/id "8da18fb1-ae45-5312-9cdd-f5ffa291065c" :answer/id #uuid "8da18fb1-ae45-5312-9cdd-f5ffa291065c" :answer/type :answer.type/math :answer/value "2 i" :db/ensure :answer/validate} {:db/id "5056ab9e-f935-5e99-9c47-d970637a2506" :answer/id #uuid "5056ab9e-f935-5e99-9c47-d970637a2506" :answer/type :answer.type/math :answer/value "0" :db/ensure :answer/validate} {:db/id "363634aa-e8d9-52c3-bf0e-3eda14caeb18" :answer/id #uuid "363634aa-e8d9-52c3-bf0e-3eda14caeb18" :answer/type :answer.type/math :answer/value "14 j z" :db/ensure :answer/validate} {:db/id "36ba0c31-5354-56ad-8374-df8a429ac86f" :answer/id #uuid "36ba0c31-5354-56ad-8374-df8a429ac86f" :answer/type :answer.type/math :answer/value "- 14 j z + 2 k" :db/ensure :answer/validate} {:db/id "a01fff05-afdf-5fb6-a143-4ff309517c87" :answer-field/id #uuid "a01fff05-afdf-5fb6-a143-4ff309517c87" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["789103f3-62e6-55d8-a195-73f4a7b6d1f2" "8da18fb1-ae45-5312-9cdd-f5ffa291065c" "5056ab9e-f935-5e99-9c47-d970637a2506" "363634aa-e8d9-52c3-bf0e-3eda14caeb18" "36ba0c31-5354-56ad-8374-df8a429ac86f"] :answer-field/correct "363634aa-e8d9-52c3-bf0e-3eda14caeb18" :db/ensure :answer-field/validate} {:db/id "4ab6255a-2668-509c-9456-b75fdf8371c2" :question/id #uuid "4ab6255a-2668-509c-9456-b75fdf8371c2" :question/problem "Given that $F(x,y,z)=7{z}^{2}\\,i+2y\\,j+k,$ what is $\\text{curl}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 7{z}^{2} & 2y & 1\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}(1)-\\frac{∂}{∂z}(2y)]i-[\\frac{∂}{∂x}(1)-\\frac{∂}{∂z}(7{z}^{2})]j+[\\frac{∂}{∂x}(2y)-\\frac{∂}{∂y}(7{z}^{2})]k \\\\  & =(0-0)i-(0-14z)j+(0-0)k \\\\  & =14z\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["a01fff05-afdf-5fb6-a143-4ff309517c87"] :db/ensure :question/validate} {:db/id "5b318775-181f-578e-bc36-15bc47255b14" :answer/id #uuid "5b318775-181f-578e-bc36-15bc47255b14" :answer/type :answer.type/math :answer/value "- 16 k z" :db/ensure :answer/validate} {:db/id "22645390-9b31-5c8d-90c3-cc8622341dba" :answer/id #uuid "22645390-9b31-5c8d-90c3-cc8622341dba" :answer/type :answer.type/math :answer/value "2 i" :db/ensure :answer/validate} {:db/id "0ca1d623-6fb3-5bc0-b77b-f3d7f09c20b8" :answer/id #uuid "0ca1d623-6fb3-5bc0-b77b-f3d7f09c20b8" :answer/type :answer.type/math :answer/value "0" :db/ensure :answer/validate} {:db/id "d45c9920-d159-56c8-b089-9363351e511d" :answer/id #uuid "d45c9920-d159-56c8-b089-9363351e511d" :answer/type :answer.type/math :answer/value "16 j z" :db/ensure :answer/validate} {:db/id "7fabdf3d-f652-5a37-9dd1-4a79130e22e7" :answer/id #uuid "7fabdf3d-f652-5a37-9dd1-4a79130e22e7" :answer/type :answer.type/math :answer/value "- 16 j z + 2 k" :db/ensure :answer/validate} {:db/id "01ad855e-80d9-5f79-b007-f3946d4f9a68" :answer-field/id #uuid "01ad855e-80d9-5f79-b007-f3946d4f9a68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["5b318775-181f-578e-bc36-15bc47255b14" "22645390-9b31-5c8d-90c3-cc8622341dba" "0ca1d623-6fb3-5bc0-b77b-f3d7f09c20b8" "d45c9920-d159-56c8-b089-9363351e511d" "7fabdf3d-f652-5a37-9dd1-4a79130e22e7"] :answer-field/correct "d45c9920-d159-56c8-b089-9363351e511d" :db/ensure :answer-field/validate} {:db/id "45a79900-6a44-513e-8ee7-36f0f63a0a43" :question/id #uuid "45a79900-6a44-513e-8ee7-36f0f63a0a43" :question/problem "Given that $F(x,y,z)=8{z}^{2}\\,i+2y\\,j+k,$ what is $\\text{curl}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 8{z}^{2} & 2y & 1\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}(1)-\\frac{∂}{∂z}(2y)]i-[\\frac{∂}{∂x}(1)-\\frac{∂}{∂z}(8{z}^{2})]j+[\\frac{∂}{∂x}(2y)-\\frac{∂}{∂y}(8{z}^{2})]k \\\\  & =(0-0)i-(0-16z)j+(0-0)k \\\\  & =16z\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["01ad855e-80d9-5f79-b007-f3946d4f9a68"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "d26ce4bc-f3c7-5256-a009-cda5f915eed5" :question-generator/script "generate/scratch/17592186133877.py"} [:db/add 17592186133877 :knowledge-point/question-generator "generator"] {:db/id 17592186133877 :knowledge-point/questions ["4ab6255a-2668-509c-9456-b75fdf8371c2" "45a79900-6a44-513e-8ee7-36f0f63a0a43"]} [:db/ensure 17592186133877 :knowledge-point/validate]]
