  {
    "label": "7944f154-d773-5b1d-bcd3-d3995107aa13",
    "record": {
      "knowledge_point": {
        "db_id": 17592186133877,
        "id": "3ad4e453-00da-5c77-8d6a-5de4dc3d5593",
