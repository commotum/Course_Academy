}}^{2}" :db/id #edb/ref 17592186561439} {:answer/id #uuid "cc2094fc-e122-54c3-af59-c5401f10502e" :answer/type {:db/ident :answer.type/math} :answer/value "93{\\text{ mi}}^{2}" :db/id #edb/ref 17592186561440}] :answer-field/correct {:answer/id #uuid "98680abc-438b-5a01-9298-1169053f5980" :answer/type {:db/ident :answer.type/math} :answer/value "42{\\text{ mi}}^{2}" :db/id #edb/ref 17592186561429} :answer-field/id #uuid "4b04ea8d-6fd7-5257-94b3-53ca685f87b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186561410}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6f48ce8b-cecb-533a-9b78-d507db11175a" :question/problem "![](images/5c/5c90b8329b7c163cf4aff55af1bd45d21bc8487fcbf39c4b7b625b31d19bbb57.png)\n\nThe area of $ABCD$ is $102{\\text{ mi}}^{2}.$ What is the area of $△BCD$ rounded to the nearest integer?" :question/worked-solution "Let's start by finding the area of $△ABD.$ We get \n\n$$\n\\begin{aligned}{A}_{△ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}⁡A \\\\ & =\\frac{1}{2}\\cdot 16\\cdot 18\\cdot \\operatorname{sin}⁡{90}^{∘} \\\\ & =\\frac{1}{2}\\cdot 288\\cdot \\operatorname{sin}⁡{90}^{∘} \\\\ & ≈144{\\text{ mi}}^{2}\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore,\n\n$$\n\\begin{aligned}{A}_{△BCD} & ={A}_{△ABD}-{A}_{ABCD} \\\\ & =144-102 \\\\ & =42{\\text{ mi}}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186561428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1458115d-10e6-5e7e-b0fe-8e29ca308733" :answer/type {:db/ident :answer.type/math} :answer/value "71{\\text{ mm}}^{2}" :db/id #edb/ref 17592186561388} {:answer/id #uuid "2db67ade-cdab-58dd-8159-2a40d0681526" :answer/type {:db/ident :answer.type/math} :answer/value "36{\\text{ mm}}^{2}" :db/id #edb/ref 17592186561399} {:answer/id #uuid "2de89c29-484f-51e3-a5ef-