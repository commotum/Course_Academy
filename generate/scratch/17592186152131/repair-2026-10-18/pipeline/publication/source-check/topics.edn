#{[{:db/id #edb/ref 17592186049089 :topic/id #uuid "d981a0da-fc14-5387-9101-c6f311b598a6" :topic/knowledge-points [{:db/id #edb/ref 17592186152128 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151930 :question/id #uuid "85913448-bf44-5c48-a845-edf7c36b2c7d" :question/math-academy-id "e-4902" :question/problem "Write $5^{2/3}$ using radical notation." :question/worked-solution "First, using the power law for exponents, we can write our expression as\n\n$$\n5^{2/3} = 5^{2\\cdot (1/3)} = \\left(5^2\\right)^{1/3}.\n$$\n\nThe fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with our expression above, we get $x = 5^2$ and $n = 3.$ Therefore,\n\n$$\n\\left(5^2\\right)^{1/3} = \\sqrt[3]{5^2}.\n$$"} :knowledge-point/id #uuid "285a1b25-5f08-562c-8dc8-820d7de1f963" :knowledge-point/title "Converting a Fractional Exponent to a Radical"} {:db/id #edb/ref 17592186152129 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151931 :question/id #uuid "a7466252-b70d-5a77-83d5-28390c82c820" :question/math-academy-id "e-4903" :question/problem "Express $\\sqrt[3]{4^2}$ using a fractional exponent." :question/worked-solution "The radical $\\sqrt[n]{x}$ can be written using a fractional exponent as $x^{1/n}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[3]{4^2},$ we get $x = 4^2$ and $n = 3.$ Therefore,\n\n$$\n\\sqrt[3]{4^2} = \\left(4^2\\right)^{1/3}.\n$$\n\nFinally, using the power law for exponents, we have\n\n$$\n\\left(4^2\\right)^{1/3} = 4^{2/3}.\n$$"} :knowledge-point/id #uuid "bb7b6041-4844-5476-9980-d0851c95b7d0" :knowledge-point/title "Converting a Radical to a Fractional Exponent"} {:db/id #edb/ref 17592186152130 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151932 :question/id #uuid "6b1fb9cd-6d21-5649-b456-0ca8f7081141" :question/math-academy-id "e-4958" :question/problem "Write $8^{1/5}$ using radical notation." :question/worked-solution "The fractional exponent $x^{1/n}$ can be written as the radical $\\sqrt[n]{x}.$\n\nComparing $x^{1/n}$ with $8^{1/5},$ we get $x = 8$ and $n = 5.$ Therefore,\n\n$$\n8^{1/5} = \\sqrt[5]{8}.\n$$"} :knowledge-point/id #uuid "9d5152b1-c5e4-5c4a-be4f-f4193264c0d7" :knowledge-point/title "Converting a Unit Fraction Exponent to a Radical"} {:db/id #edb/ref 17592186152131 :knowledge-point/canonical-example {:db/id #edb/ref 17592186151933 :question/id #uuid "87e686a5-7b8a-529b-a8fa-17445c52e012" :question/math-academy-id "e-4959" :question/problem "Express $\\sqrt[5]{4}$ using a fractional exponent." :question/worked-solution "The radical $\\sqrt[n]{x}$ can be written using a fractional exponent as $x^{1/n}.$\n\nComparing $\\sqrt[n]{x}$ with $\\sqrt[5]{4},$ we get $x = 4$ and $n = 5.$ Therefore,\n\n$$\n\\sqrt[5]{4} = 4^{1/5}.\n$$"} :knowledge-point/id #uuid "e2d7fb12-c66c-524e-b9f6-1b86972c3520" :knowledge-point/title "Converting a Radical to a Unit Fraction Exponent"}] :topic/math-academy-id 2607 :topic/next [{:db/id #edb/ref 17592186049137} {:db/id #edb/ref 17592186049859} {:db/id #edb/ref 17592186050396} {:db/id #edb/ref 17592186050894} {:db/id #edb/ref 17592186050987}] :topic/title "Radicals as Fractional Exponents"}]}
