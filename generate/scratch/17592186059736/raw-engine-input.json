[{"label": "q-281976", "record": {"knowledge_point": {"db_id": 17592186059736, "id": "733eab11-2a26-5402-8df5-bba50c9beaf9", "title": "Calculating the Cross Product Using Determinants"}, "question": {":question/id": "709c4d48-da0f-57b4-9395-14a6b492581c", ":question/difficulty": ":question.difficulty/easy", ":question/problem": "Let $u=\u27e8\\sqrt{3},2,0\u27e9$ and $v=\u27e81,0,-1\u27e9.$ Find $u\\times v.$\n\n$u\\times v=\u27e8${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$\u27e9$", ":question/worked-solution": "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ \\sqrt{3} & 2 & 0 \\\\ 1 & 0 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ 0 & -1\\end{aligned}|i-|\\begin{aligned}\\sqrt{3} & 0 \\\\ 1 & -1\\end{aligned}|j+|\\begin{aligned}\\sqrt{3} & 2 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(2\\cdot -1-0\\cdot 0)i-(\\sqrt{3}\\cdot -1-0\\cdot 1)j+(\\sqrt{3}\\cdot 0-2\\cdot 1)k \\\\  & =-2i+\\sqrt{3}j-2k \\\\  & =\u27e8-2,\\sqrt{3},-2\u27e9.\\end{aligned}\n$$", ":question/answer-fields": [{":answer-field/id": "6f3d8e01-3620-5341-bd21-9237e68ccdf8", ":answer-field/key": "field-1", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "2e945c27-d5fe-5953-804b-6079649f6fc5", ":answer/type": ":answer.type/math", ":answer/value": "-2"}], ":answer-field/correct": [":answer/id", "2e945c27-d5fe-5953-804b-6079649f6fc5"]}, {":answer-field/id": "b94e5879-075b-5dce-99ca-3cdfd5bbd5e5", ":answer-field/key": "field-2", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "f74c6aad-7110-52c2-a687-f1f5a6676e44", ":answer/type": ":answer.type/math", ":answer/value": "\\sqrt{3}"}], ":answer-field/correct": [":answer/id", "f74c6aad-7110-52c2-a687-f1f5a6676e44"]}, {":answer-field/id": "dd9802e2-0f1a-5704-90d9-59521c9b5f12", ":answer-field/key": "field-3", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "5ca39661-ecb5-5d6c-950e-c6a9bed036dc", ":answer/type": ":answer.type/math", ":answer/value": "-2"}], ":answer-field/correct": [":answer/id", "5ca39661-ecb5-5d6c-950e-c6a9bed036dc"]}]}, "generation": {"version": "cross-determinants-1", "seed": 0, "template": "q-281976", "profile": "observed:q-281976:raw", "parameters": {"a_scale": 1, "b_scale": 1}, "mathematical_fingerprint": "1e7e11ef6fb35af2eb9d98c76245571caa34d9fe4b2c928cea5081db56879d14", "content_fingerprint": "f34b26d56b82368686cf825c03a2cb41b600c6da483211d575d2329bfc4781f4", "source": {"database": "math", "basis": 1356, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "level_origin": "observed-or-authored-default", "bank_intent": "opaque covariance; no recovered error intent"}}, "checks": [{"field_index": 0, "submitted": "-2", "expected": "accepted", "purpose": "exact original raw source blank value"}, {"field_index": 1, "submitted": "\\sqrt{3}", "expected": "accepted", "purpose": "exact original raw source blank value"}, {"field_index": 2, "submitted": "-2", "expected": "accepted", "purpose": "exact original raw source blank value"}]}, {"label": "q-281977", "record": {"knowledge_point": {"db_id": 17592186059736, "id": "733eab11-2a26-5402-8df5-bba50c9beaf9", "title": "Calculating the Cross Product Using Determinants"}, "question": {":question/id": "a36eee23-3d21-5f09-bf4d-8271509803fc", ":question/difficulty": ":question.difficulty/easy", ":question/problem": "Let $u=\u27e8\\frac{2}{3},0,1\u27e9$ and $v=\u27e81,2,-3\u27e9.$ Find $u\\times v.$\n\n$u\\times v=\u27e8${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$\u27e9$", ":question/worked-solution": "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ \\frac{2}{3} & 0 & 1 \\\\ 1 & 2 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 1 \\\\ 2 & -3\\end{aligned}|i-|\\begin{aligned}\\frac{2}{3} & 1 \\\\ 1 & -3\\end{aligned}|j+|\\begin{aligned}\\frac{2}{3} & 0 \\\\ 1 & 2\\end{aligned}|k \\\\  & =((0)(-3)-(1)(2))i-((\\frac{2}{3})(-3)-(1)(1))j+((\\frac{2}{3})(2)-(0)(1))k \\\\  & =(0-2)i-(-2-1)j+(\\frac{4}{3})k \\\\  & =-2i+3j+(\\frac{4}{3})k \\\\  & =\u27e8-2,3,\\frac{4}{3}\u27e9.\\end{aligned}\n$$", ":question/answer-fields": [{":answer-field/id": "87d4f06c-fc89-531e-90c1-b24044291276", ":answer-field/key": "field-3", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "184d7fff-d3aa-5a5a-8d69-92c21906698b", ":answer/type": ":answer.type/math", ":answer/value": "\\frac{4}{3}"}], ":answer-field/correct": [":answer/id", "184d7fff-d3aa-5a5a-8d69-92c21906698b"]}, {":answer-field/id": "01981791-4752-55be-9193-ba70a58093b4", ":answer-field/key": "field-2", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "33cf8ca1-3105-5413-8c22-ef30203dba2e", ":answer/type": ":answer.type/math", ":answer/value": "3"}], ":answer-field/correct": [":answer/id", "33cf8ca1-3105-5413-8c22-ef30203dba2e"]}, {":answer-field/id": "462d5df4-d95b-5e6e-84ca-55fbb2149d45", ":answer-field/key": "field-1", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "2c6995cd-72c7-5849-81a3-e6f23ea3fd2c", ":answer/type": ":answer.type/math", ":answer/value": "-2"}], ":answer-field/correct": [":answer/id", "2c6995cd-72c7-5849-81a3-e6f23ea3fd2c"]}]}, "generation": {"version": "cross-determinants-1", "seed": 0, "template": "q-281977", "profile": "observed:q-281977:raw", "parameters": {"a_scale": 1, "b_scale": 1}, "mathematical_fingerprint": "e2f46bc4ca70339273c868885044e6e80fafadba0a0a5cfbe7abc9a69de747bf", "content_fingerprint": "d7b057e99c9ed5229c649d50d4a0eb4f7b2546ea7121d6ec1e4856bf84f61877", "source": {"database": "math", "basis": 1356, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "level_origin": "observed-or-authored-default", "bank_intent": "opaque covariance; no recovered error intent"}}, "checks": [{"field_index": 0, "submitted": "\\frac{4}{3}", "expected": "accepted", "purpose": "exact original raw s