\,i+2\\,j)-(-i+4\\,j)] \\\\  & =(-i+4\\,j)+t(-\\frac{3}{2}\\,i-2\\,j) \\\\  & =(-\\frac{3}{2}t-1)\\,i+(4-2t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=-\\frac{3}{2}t-1$ and $y=4-2t$ along the segment.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{2}t-1)i+\\frac{\\text{d}}{\\text{d}t}(4-2t)j \\\\  & =-\\frac{3}{2}\\,i-2\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(- \\frac{3}{2})^{2}+(-2)^{2}} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2x+y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(-\\frac{3}{2}t-1)+(4-2t) \\\\  & =-5t+2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(-5t+2)\\cdot \\frac{5}{2}\\cdot \\text{d}t \\\\  & =\\frac{5}{2}{\\int }_{0}^{1}(-5t+2)\\text{d}t.\\end{aligned}\n$$" 13194139535919 17592186045443 true] [17592186542283 1080 "\\frac{\\sqrt{41}}{2}{\\int }_{0}^{1}(0-\\operatorname{cos}⁡(2t-2))\\text{d}t" 13194139535919 17592186045443 true] [17592186542283 1082 #edb/ref 17592186045498 13194139535919 17592186045443 true] [17592186542283 1083 #uuid "035fa252-c497-5441-a7a9-995b1b999642" 13194139535919 17592186045443 true] [17592186542284 1075 #edb/ref 17592186542324 13194139535919 17592186045443 true] [17592186542284 1075 #edb/ref 17592186542326 13194139535919 17592186045443 true] [17592186542284 1075 #edb/ref 17592186542332 13194139535919 17592186045443 true] [17592186542284 1075 #edb/ref 17592186542347 13194139535919 17592186045443 true] [17592186542284 1075 #edb/ref 17592186542351 13194139535919 17592186045443 true] [17592186542284 1076 #edb/ref 17592186045493 13194139535919 17592186045443 true] [