 + 2 y^{2})\\,j \\\\  & =(- 10 x + 5 y^{2})\\,i+(10 x y + 4 y)\\,j \\\\ ∇f(- \\frac{3}{2},\\frac{5}{2}) & =(- 10 (- \\frac{3}{2}) + 5 (\\frac{5}{2})^{2})\\,i+(10 (- \\frac{3}{2}) (\\frac{5}{2}) + 4 (\\frac{5}{2}))\\,j \\\\  & =(\\frac{185}{4})\\,i+(- \\frac{55}{2})\\,j \\\\  & =⟨\\frac{185}{4},- \\frac{55}{2}⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(- \\frac{3}{2},\\frac{5}{2})\\cdot ⟨x-(- \\frac{3}{2}),\\,y-(\\frac{5}{2})⟩ & =0 \\\\ ⟨\\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186521695 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21544ba6-ef06-5266-93a1-313a526067e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521685} {:answer/id #uuid "2eb23044-bcc9-5962-9105-7de29057842a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521688} {:answer/id #uuid "46b191a3-b090-5dd0-ac4f-c90400eb199a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨- \\frac{13}{3},\\frac{85}{9}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521691} {:answer/id #uuid "6c6a3182-68ef-5d3d-8b37-e9e7be34344c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨- \\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521704} {:answer/id #uuid "8b23529b-86a4-53b3-8086-beeeb9b129c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y + \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521718}] :answer-field/correct {:answer/id #uuid "2eb23044-bcc9-5962-9105-7de29057842a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/id #edb/ref 17592186521688} :answer-field/id #uuid "854ed5c8-bf23-5931-b481-8a38951b43b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521715}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4f9f3451-ede1-5210-8b07-6d5429ad7a60" :question/problem "Given the function $f(x,y)=2 x^{2} - 5 x y^{2} + 6 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(\\frac{5}{2},\\frac{1}{3}).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{5}{2},\\frac{1}{3}):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,j \\\\  & =(4 x - 5 y^{2})\\,i+(- 10 x y + 12 y)\\,j \\\\ ∇f(\\frac{5}{2},\\frac{1}{3}) & =(4 (\\frac{5}{2}) - 5 (\\frac{1}{3})^{2})\\,i+(- 10 (\\frac{5}{2}) (\\frac{1}{3}) + 12 (\\frac{1}{3}))\\,j \\\\  & =(\\frac{85}{9})\\,i+(- \\frac{13}{3})\\,j \\\\  & =⟨\\frac{85}{9},- \\frac{13}{3}⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(\\frac{5}{2},\\frac{1}{3})\\cdot ⟨x-(\\frac{5}{2}),\\,y-(\\frac{1}{3})⟩ & =0 \\\\ ⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186521716 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fa1950-a214-593e-94bb-243b690a1707" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521679} {:answer/id #uuid "710f2844-45c8-59bf-880d-fe3c26cb0832" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-49,66⟩\\cdot ⟨x + 1,\\,y + 3⟩=0" :db/id #edb/ref 17592186521706} {:answer/id #uuid "d48dac5a-1d5f-5154-aa25-33bdbfcde65c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521732} {:answer/id #uuid "df36e640-415f-58a4-bc06-4d7c4809c34d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-49,66⟩\\cdot ⟨x - 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521736} {:answer/id #uuid "e2b2b0d4-a0e4-5086-b86d-dbc7f486d746" :answer/type {:db/ident :answer.type/math} :answer/value "⟨66,-49⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521738}] :answer-field/correct {:answer/id #uuid "14fa1950-a214-593e-94bb-243b690a1707" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩=0" :db/id #edb/ref 17592186521679} :answer-field/id #uuid "7baa5690-e3d0-5579-a631-3557bc32676a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186521709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "881a79d9-03b1-51ac-8b66-c52a6345dfc8" :question/problem "Given the function $f(x,y)=2 x^{2} - 5 x y^{2} + 6 y^{2}$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(-1,3).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-1,3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,i+\\frac{∂}{∂y}(2 x^{2} - 5 x y^{2} + 6 y^{2})\\,j \\\\  & =(4 x - 5 y^{2})\\,i+(- 10 x y + 12 y)\\,j \\\\ ∇f(-1,3) & =(4 (-1) - 5 (3)^{2})\\,i+(- 10 (-1) (3) + 12 (3))\\,j \\\\  & =(-49)\\,i+(66)\\,j \\\\  & =⟨-49,66⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(-1,3)\\cdot ⟨x-(-1),\\,y-(3)⟩ & =0 \\\\ ⟨-49,66⟩\\cdot ⟨x + 1,\\,y - 3⟩ & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186521719 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08396be8-551a-56f0-be99-5d1834a0c9d8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-20,- \\frac{111}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521676} {:answer/id #uuid "10e86575-f93c-5f64-950f-c7b82d9e1364" :answer/type {:db/ident :answer.type/math} :answer/value "⟨- \\frac{111}{2},-20⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521678} {:answer/id #uuid "186cfe4b-4dfa-530b-9d0d-dd50f922acde" :answer/type {:db/ident :answer.type/math} :answer/value "⟨- \\frac{111}{2},-20⟩\\cdot ⟨x + \\frac{3}{2},\\,y + \\frac{5}{2}⟩=0" :db/id #edb/ref 17592186521680} {:answer/id #uuid "1d12fff6-b9f1-57fd-a747-267328625646" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{111}{2},-20⟩\\c