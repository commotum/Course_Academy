c{5}{2})\\cdot ⟨x-(- \\frac{3}{2}),\\,y-(\\frac{5}{2})⟩ & =0 \\\\ ⟨\\frac{185}{4},- \\frac{55}{2}⟩\\cdot ⟨x + \\frac{3}{2},\\,y - \\frac{5}{2}⟩ & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["b665079c-c019-5428-b8de-1f2f603c7242"] :db/ensure :question/validate} {:db/id "8b23529b-86a4-53b3-8086-beeeb9b129c3" :answer/id #uuid "8b23529b-86a4-53b3-8086-beeeb9b129c3" :answer/type :answer.type/math :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y + \\frac{1}{3}⟩=0" :db/ensure :answer/validate} {:db/id "46b191a3-b090-5dd0-ac4f-c90400eb199a" :answer/id #uuid "46b191a3-b090-5dd0-ac4f-c90400eb199a" :answer/type :answer.type/math :answer/value "⟨- \\frac{13}{3},\\frac{85}{9}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/ensure :answer/validate} {:db/id "6c6a3182-68ef-5d3d-8b37-e9e7be34344c" :answer/id #uuid "6c6a3182-68ef-5d3d-8b37-e9e7be34344c" :answer/type :answer.type/math :answer/value "⟨- \\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/ensure :answer/validate} {:db/id "2eb23044-bcc9-5962-9105-7de29057842a" :answer/id #uuid "2eb23044-bcc9-5962-9105-7de29057842a" :answer/type :answer.type/math :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x - \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/ensure :answer/validate} {:db/id "21544ba6-ef06-5266-93a1-313a526067e2" :answer/id #uuid "21544ba6-ef06-5266-93a1-313a526067e2" :answer/type :answer.type/math :answer/value "⟨\\frac{85}{9},- \\frac{13}{3}⟩\\cdot ⟨x + \\frac{5}{2},\\,y - \\frac{1}{3}⟩=0" :db/ensure :answer/validate} {:db/id "854ed5c8-bf23-5931-b481-8a38951b43b5" :answer-field/id #uuid "854ed5c8-bf23-5931-b481-8a38951b43b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["8b23529b-86a4-53b3-8086-beeeb9b129c3" "46b191a3-b090-5dd0-ac4f-c90400eb199a" "6c6a3182-68ef-5d3d-8b37-e9e7be34344c" "2eb23044-bcc9-5962-9105-7de29057842a" "21544ba6-ef06-5266-93a1-313a52606