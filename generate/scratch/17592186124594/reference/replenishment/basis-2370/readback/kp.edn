ft(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=8 x - y,\\,\\frac{∂w}{∂y}=- x - 6 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & =- r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂w}{∂y} & =- 6 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂\\theta} & =(- r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(- 6 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(r^{2} \\sin^{2}{\\left(\\theta \\right)} - 8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(- 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}) \\\\  & =r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526197 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "282f6b6d-7109-520e-aba8-fa9ab8b0a7a3" :answer/type {:db/ident :answer.type/math} :answer/value "3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526170} {:answer/id #uuid "3391d5eb-68ff-5f47-8cb4-841e008f9b13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526173} {:answer/id #uuid "a4d504c1-fe78-5a56-8d10-4e6193ffaa1e" :answer/type {:db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526202} {:answer/id #uuid "e346e4b3-24c9-5ab1-b792-11794c240dfa" :answer/type {:db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526218} {:answer/id #uuid "e860279b-77dd-57ba-a0d7-ecb00ace3f78" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 r \\sin^{2}{\\left(\\theta \\right)} - 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526222}] :answer-field/correct {:answer/id #uuid "a4d504c1-fe78-5a56-8d10-4e6193ffaa1e" :answer/type {:db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526202} :answer-field/id #uuid "3d102c59-1b9a-5a50-a344-4599186d21a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526175}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ba2b920-eb38-5aa2-a748-ae3fcff5a4ef" :question/problem "Given that $f(x,y)=- 2 x^{2} + 3 x y + 4 y^{2},$ find $\\frac{∂f}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $f(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =(\\frac{∂f}{∂x})(\\cos{\\left(\\theta \\right)})+(\\frac{∂f}{∂y})(\\sin{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=- 4 x + 3 y,\\,\\frac{∂f}{∂y}=3 x + 8 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =3 r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂f}{∂y} & =8 r \\sin{\\left(\\theta \\right)} + 3 r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂r} & =(3 r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)})(\\cos{\\left(\\theta \\right)})+(8 r \\sin{\\left(\\theta \\right)} + 3 r \\cos{\\left(\\theta \\right)})(\\sin{\\left(\\theta \\right)}) \\\\  & =(3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)})+(8 r \\sin^{2}{\\left(\\theta \\right)} + 3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}) \\\\  & =8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526207 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0713a1ad-ccc7-566c-8914-8e3c100172f0" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526159} {:answer/id #uuid "16e60cd4-3e70-5728-807b-4b3fe56363b0" :answer/type {:db/ident :answer.type/math} :answer/value "3 r^{2} \\sin^{2}{\\left(\\theta \\right)} + 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526160} {:answer/id #uuid "6bb1511f-fd6f-5dcb-a549-16c1fa181fbb" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526183} {:answer/id #uuid "6f531e11-04da-524b-a34c-49484bbe1b03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{- 3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526184} {:answer/id #uuid "b677097d-e76f-536a-ba5b-84dc2520444d" :answer/type {:db/ident :answer.type/math} :answer/value "2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526208}] :answer-field/correct {:answer/id #uuid "6bb1511f-fd6f-5dcb-a549-16c1fa181fbb" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526183} :answer-field/id #uuid "178906e3-57c0-56b7-986d-f2501a1f24d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526164}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b47877ef-eea0-5bca-bfa7-432b3e6a60d6" :question/problem "Given that $g(x,y)=4 x^{2} + 3 x y + y^{2},$ find $\\frac{∂g}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $g(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta} & =\\frac{∂g}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂g}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =(\\frac{∂g}{∂x})(- r \\sin{\\left(\\theta \\right)})+(\\frac{∂g}{∂y})(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $g$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x}=8 x + 3 y,\\,\\frac{∂g}{∂y}=3 x + 2 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =3 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂g}{∂y} & =2 r \\sin{\\left(\\theta \\right)} + 3 r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta} & =(3 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(2 r \\sin{\\left(\\theta \\right)} + 3 r \\cos{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(- 3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}) \\\\  & =- 3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 3 r^{2} \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526219 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fcac3a0-3569-5248-9a48-274baa2fe77a" :answer/type {:db/ident :answer.type/math} :answer/value "- r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526172} {:answer/id #uuid "b06fe44e-a0ff-5fe5-95fa-c4dddd61fddb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{- 8 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526204} {:answer/id #uuid "b9d022e8-17ef-5195-8caa-81e89fedfa62" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 r \\sin^{2}{\\left(\\theta \\right)} - r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526211} {:answer/id #uuid "c8b74784-ec66-503f-a057-72a84744d3ec" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526212} {:answer/id #uuid "f1d9b56a-a6bf-553e-bb62-342ce53e4887" :answer/type {:db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526223}] :answer-field/correct {:answer/id #uuid "c8b74784-ec66-503f-a057-72a84744d3ec" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526212} :answer-field/id #uuid "ca1ec9d8-7eed-5594-a953-25080a7536d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526213}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5a1df93-67eb-5480-ade3-3b10d1fdf3b9" :question/problem "Given that $w(x,y)=- 2 x^{2} - x y - 4 y^{2},$ find $\\frac{∂w}{∂r},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $w(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =\\frac{∂w}{∂x}\\cdot \\frac{∂x}{∂r}+\\frac{∂w}{∂y}\\cdot \\frac{∂y}{∂r} \\\\  & =(\\frac{∂w}{∂x})(\\cos{\\left(\\theta \\right)})+(\\frac{∂w}{∂y})(\\sin{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $w$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x}=- 4 x - y,\\,\\frac{∂w}{∂y}=- x - 8 y\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂x} & =- r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)}, \\\\ \\frac{∂w}{∂y} & =- 8 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂w}{∂r} & =(- r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)})(\\cos{\\left(\\theta \\right)})+(- 8 r \\sin{\\left(\\theta \\right)} - r \\cos{\\left(\\theta \\right)})(\\sin{\\left(\\theta \\right)}) \\\\  & =(- r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)})+(- 8 r \\sin^{2}{\\left(\\theta \\right)} - r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}) \\\\  & =- 8 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526224 :knowledge-point/_questions [{:knowledge-point/id #uuid "c2696e2e-7aa9-5831-9028-9adfe5889bbe" :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7623b2a1-2815-51c8-af36-c5449d7b4225" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 r^{2} \\sin^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526186} {:answer/id #uuid "a095650a-55e6-5374-a87f-11f9eca107d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526201} {:answer/id #uuid "b3de4b3d-f1b9-5b84-a580-865d3ba52584" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526206} {:answer/id #uuid "b997a104-b349-5dba-8d72-574ffb82c196" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526209} {:answer/id #uuid "e06161ba-b711-53b6-a6be-89ac2b159b29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{r \\left(3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}\\right)}" :db/id #edb/ref 17592186526217}] :answer-field/correct {:answer/id #uuid "a095650a-55e6-5374-a87f-11f9eca107d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}" :db/id #edb/ref 17592186526201} :answer-field/id #uuid "cf37e36c-be27-5f11-9b87-1e2003357f10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186526216}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fad48590-44c0-5716-af2e-ae5d36de575e" :question/problem "Given that $h(x,y)=\\ln{\\left(4 x^{2} - 4 x y + 3 y^{2} \\right)},$ find $\\frac{∂h}{∂\\theta},$ where $(x,y)$ are Cartesian coordinates and $(r,\\theta)$ are the corresponding plane polar coordinates." :question/worked-solution "Applying the multivariable chain rule for the function $h(x,y)$ with two independent variables $r$ and $\\theta,$ where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we have\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta} & =\\frac{∂h}{∂x}\\cdot \\frac{∂x}{∂\\theta}+\\frac{∂h}{∂y}\\cdot \\frac{∂y}{∂\\theta} \\\\  & =(\\frac{∂h}{∂x})(- r \\sin{\\left(\\theta \\right)})+(\\frac{∂h}{∂y})(r \\cos{\\left(\\theta \\right)})\\end{aligned}\n$$\n\nFirst, we find the partial derivatives of $h$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x}=\\frac{8 x - 4 y}{4 x^{2} - 4 x y + 3 y^{2}},\\,\\frac{∂h}{∂y}=\\frac{- 4 x + 6 y}{4 x^{2} - 4 x y + 3 y^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $r$ and $\\theta,$ we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{- 4 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}, \\\\ \\frac{∂h}{∂y} & =\\frac{6 r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂h}{∂\\theta} & =(\\frac{- 4 r \\sin{\\left(\\theta \\right)} + 8 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})(- r \\sin{\\left(\\theta \\right)})+(\\frac{6 r \\sin{\\left(\\theta \\right)} - 4 r \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(\\frac{4 r^{2} \\sin^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{8 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}})+(\\frac{6 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}} - \\frac{4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}{3 r^{2} \\sin^{2}{\\left(\\theta \\right)} - 4 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r^{2} \\cos^{2}{\\left(\\theta \\right)}}) \\\\  & =\\frac{4 \\sin^{2}{\\left(\\theta \\right)} - 2 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 \\cos^{2}{\\left(\\theta \\right)}}{3 \\sin^{2}{\\left(\\theta \\right)} - 4 \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 \\cos^{2}{\\left(\\theta \\right)}}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Derivative of a Cartesian Function With Respect to Plane Polar Coordinates"}]}
