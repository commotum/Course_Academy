#{[{:db/id #edb/ref 17592186096696 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096496 :question/id #uuid "e8b9014e-32cf-5f04-856c-7fd663bea50f" :question/math-academy-id "e-528" :question/problem "Find the general solution to the differential equation $f'(x) - 3\\sin(2x) = 0.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\nf'(x) = 3\\sin{2x}.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int 3\\operatorname{sin}⁡2x\\,\\text{d}x \\\\ f(x) & =3\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049486 :topic/math-academy-id 1181 :topic/title "Verifying Solutions of Differential Equations"} {:db/id #edb/ref 17592186050101 :topic/math-academy-id 1112 :topic/title "Integrating Exponential Functions Using Linear Substitution"} {:db/id #edb/ref 17592186050489 :topic/math-academy-id 478 :topic/title "Integrating Trigonometric Functions Using Substitution"} {:db/id #edb/ref 17592186050771 :topic/math-academy-id 443 :topic/title "Integration Using Substitution"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186496554 :question-generator/id #uuid "8d55ada4-b00a-5e14-a7fe-dba681d5ef32" :question-generator/script "generate/scratch/17592186096696.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097118 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f651d57-fd13-5223-b101-19044f5a3b48" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) =-\\frac{11}{2}x + C" :db/id #edb/ref 17592186094682} {:answer/id #uuid "0c189129-a43b-5083-8426-a8d988b5bcfc" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = \\frac{11}{2} - C" :db/id #edb/ref 17592186094683} {:answer/id #uuid "441b0a08-b772-5959-b466-9ce911e9e