eld/choices [{:answer/id #uuid "703c4065-6a5d-5d85-b097-7bbf9d11c7f6" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=3 x^{2} - 6 x+C" :db/id #edb/ref 17592186496513} {:answer/id #uuid "7702e446-2f35-5f48-8c0e-793922a67609" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x^{3} - 3 x^{2}+C" :db/id #edb/ref 17592186496516} {:answer/id #uuid "98381d2b-0c4d-53f2-aa3a-75c503cdbbe8" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 3 x^{2}+C" :db/id #edb/ref 17592186496522} {:answer/id #uuid "9c42ac33-202a-55ab-9e62-9f30f3f58fbf" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=9 x^{3} - 12 x^{2}+C" :db/id #edb/ref 17592186496525} {:answer/id #uuid "e50eaf70-2445-548f-b86c-1e9e5899495c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- x^{3} + 3 x^{2}+C" :db/id #edb/ref 17592186496542}] :answer-field/correct {:answer/id #uuid "7702e446-2f35-5f48-8c0e-793922a67609" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x^{3} - 3 x^{2}+C" :db/id #edb/ref 17592186496516} :answer-field/id #uuid "ce7f7235-e7cb-5569-b97b-caa4d45fcf30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496534}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "179f19da-330e-5f5e-a1f0-62959c022ecc" :question/problem "Find the general solution to the differential equation $f'(x)=- 6 x+3 x^{2}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=- 6 x+3 x^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 6 x+3 x^{2})\\,\\text{d}x \\\\ f(x) &=\\int (- 6 x)\\,\\text{d}x+\\int (3 x^{2})\\,\\text{d}x \\\\ &=1\\cdot \\left(- 3 x^{2}\\right)+1\\cdot \\left(x^{3}\\right)+C \\\\ &=- 3 x^{2}+x^{3}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b79c936-6102-58b3-9ac8-17efa93ea75d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{2 x^{3}}{5} + \\frac{4 x^{2}}{5}+C" :db/id #edb/ref 17592186496497} {:answer/id #uuid "42996f87-8846-58b5-ab26-947cd6e97787" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{2 x^{3}}{5} + \\frac{4 x^{2}}{5} + \\frac{e^{- 4 x}}{10}+C" :db/id #edb/ref 17592186496506} {:answer/id #uuid "9a5163bf-cda3-5ec3-bfb9-31a821690e2c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{2 x^{3}}{5} - \\frac{4 x^{2}}{5} - \\frac{e^{- 4 x}}{10}+C" :db/id #edb/ref 17592186496523} {:answer/id #uuid "d16868fe-1cee-5628-8c3f-db810e35b375" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{18 x^{3}}{5} + \\frac{16 x^{2}}{5} + \\frac{8 e^{- 4 x}}{5}+C" :db/id #edb/ref 17592186496536} {:answer/id #uuid "db703725-3204-55e9-82a3-dc14b98cb2c7" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{6 x^{2}}{5} + \\frac{8 x}{5} - \\frac{2 e^{- 4 x}}{5}+C" :db/id #edb/ref 17592186496538}] :answer-field/correct {:answer/id #uuid "42996f87-8846-58b5-ab26-947cd6e97787" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{2 x^{3}}{5} + \\frac{4 x^{2}}{5} + \\frac{e^{- 4 x}}{10}+C" :db/id #edb/ref 17592186496506} :answer-field/id #uuid "1b4cc95d-b2b6-5143-b004-a3c38fe0a2cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496496}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "26aabf44-e4b2-5317-9f49-dff75af11f88" :question/problem "Find the general solution to the differential equation $5f'(x)=8 x+6 x^{2}- 2 e^{- 4 x}.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=\\frac{8 x}{5}+\\frac{6 x^{2}}{5}- \\frac{2 e^{- 4 x}}{5}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (\\frac{8 x}{5}+\\frac{6 x^{2}}{5}- \\frac{2 e^{- 4 x}}{5})\\,\\text{d}x \\\\ f(x) &=\\frac{1}{5}\\cdot \\int (8 x)\\,\\text{d}x+\\frac{1}{5}\\cdot \\int (6 x^{2})\\,\\text{d}x+\\frac{1}{5}\\cdot \\int (- 2 e^{- 4 x})\\,\\text{d}x \\\\ &=\\frac{1}{5}\\cdot \\left(4 x^{2}\\right)+\\frac{1}{5}\\cdot \\left(2 x^{3}\\right)+\\frac{1}{5}\\cdot \\left(\\frac{e^{- 4 x}}{2}\\right)+C \\\\ &=\\frac{4 x^{2}}{5}+\\frac{2 x^{3}}{5}+\\frac{e^{- 4 x}}{10}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d32326d-f8f7-50a3-985e-b1e1d37cdc2a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{4 x^{2}}{3} + 4 e^{4 x} + \\frac{\\ln{\\left(\\left|{x - 2}\\right| \\right)}}{18}+C" :db/id #edb/ref 17592186496492} {:answer/id #uuid "1126b502-7a36-55b9-9de4-2391d8cb1c34" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{2 x}{3} + e^{4 x} + \\frac{2}{x - 2}+C" :db/id #edb/ref 17592186496493} {:answer/id #uuid "38d904cc-8188-5c23-8d1a-2ce92740dcf8" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{x^{2}}{3} - \\frac{e^{4 x}}{4} - 2 \\ln{\\left(\\left|{x - 2}\\right| \\right)}+C" :db/id #edb/ref 17592186496504} {:answer/id #uuid "478bff4b-1f38-511e-8a4f-a99b90f1c64c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{x^{2}}{3} + \\frac{e^{4 x}}{4} + 2 \\ln{\\left(\\left|{x - 2}\\right| \\right)}+C" :db/id #edb/ref 17592186496508} {:answer/id #uuid "ccda3c2e-69cf-54f3-a968-ffd12e0b8c89" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{e^{4 x}}{4} + 2 \\ln{\\left(\\left|{x - 2}\\right| \\right)}+C" :db/id #edb/ref 17592186496533}] :answer-field/correct {:answer/id #uuid "478bff4b-1f38-511e-8a4f-a99b90f1c64c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{x^{2}}{3} + \\frac{e^{4 x}}{4} + 2 \\ln{\\left(\\left|{x - 2}\\right| \\right)}+C" :db/id #edb/ref 17592186496508} :answer-field/id #uuid "f31a20d1-c2da-5d37-9f86-6795a15d4026" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496547}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3b7e5e08-6941-58d2-a73a-e51fbed395c6" :question/problem "Find the general solution to the differential equation $-3f'(x)=- \\frac{6}{x - 2}- 3 e^{4 x}+2 x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=\\frac{2}{x - 2}+e^{4 x}- \\frac{2 x}{3}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (\\frac{2}{x - 2}+e^{4 x}- \\frac{2 x}{3})\\,\\text{d}x \\\\ f(x) &=- \\frac{1}{3}\\cdot \\int (- \\frac{6}{x - 2})\\,\\text{d}x- \\frac{1}{3}\\cdot \\int (- 3 e^{4 x})\\,\\text{d}x- \\frac{1}{3}\\cdot \\int (2 x)\\,\\text{d}x \\\\ &=- \\frac{1}{3}\\cdot \\left(- 6 \\ln{\\left(\\left|{x - 2}\\right| \\right)}\\right)- \\frac{1}{3}\\cdot \\left(- \\frac{3 e^{4 x}}{4}\\right)- \\frac{1}{3}\\cdot \\left(x^{2}\\right)+C \\\\ &=2 \\ln{\\left(\\left|{x - 2}\\right| \\right)}+\\frac{e^{4 x}}{4}- \\frac{x^{2}}{3}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2781158b-ed36-5958-9c24-80295a88ff1c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 3 x - e^{4 x} - 2 \\sin{\\left(4 x \\right)}+C" :db/id #edb/ref 17592186496502} {:answer/id #uuid "2e0188b2-f462-583f-ba36-947c61640e08" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{3 x^{2}}{2} - \\frac{e^{4 x}}{4} + \\frac{\\cos{\\left(4 x \\right)}}{2}+C" :db/id #edb/ref 17592186496503} {:answer/id #uuid "c726202f-5466-5700-acb3-6b0e3ee77da0" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 6 x^{2} - 4 e^{4 x} + 8 \\cos{\\left(4 x \\right)}+C" :db/id #edb/ref 17592186496531} {:answer/id #uuid "d451bb1c-c06e-5ae1-a856-2cebff6e5005" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{e^{4 x}}{4} + \\frac{\\cos{\\left(4 x \\right)}}{2}+C" :db/id #edb/ref 17592186496537} {:answer/id #uuid "f9590a88-af9c-5623-bfb5-8c29ef8f1648" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{3 x^{2}}{2} + \\frac{e^{4 x}}{4} - \\frac{\\cos{\\left(4 x \\right)}}{2}+C" :db/id #edb/ref 17592186496551}] :answer-field/correct {:answer/id #uuid "2e0188b2-f462-583f-ba36-947c61640e08" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{3 x^{2}}{2} - \\frac{e^{4 x}}{4} + \\frac{\\cos{\\left(4 x \\right)}}{2}+C" :db/id #edb/ref 17592186496503} :answer-field/id #uuid "af408359-6cd4-50d7-8fe9-1c6c48815da1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496529}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5632b827-4db2-5a94-a24f-f0f2cc425ab3" :question/problem "Find the general solution to the differential equation $-2f'(x)=4 \\sin{\\left(4 x \\right)}+2 e^{4 x}+6 x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=- 2 \\sin{\\left(4 x \\right)}- e^{4 x}- 3 x\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 2 \\sin{\\left(4 x \\right)}- e^{4 x}- 3 x)\\,\\text{d}x \\\\ f(x) &=- \\frac{1}{2}\\cdot \\int (4 \\sin{\\left(4 x \\right)})\\,\\text{d}x- \\frac{1}{2}\\cdot \\int (2 e^{4 x})\\,\\text{d}x- \\frac{1}{2}\\cdot \\int (6 x)\\,\\text{d}x \\\\ &=- \\frac{1}{2}\\cdot \\left(- \\cos{\\left(4 x \\right)}\\right)- \\frac{1}{2}\\cdot \\left(\\frac{e^{4 x}}{2}\\right)- \\frac{1}{2}\\cdot \\left(3 x^{2}\\right)+C \\\\ &=\\frac{\\cos{\\left(4 x \\right)}}{2}- \\frac{e^{4 x}}{4}- \\frac{3 x^{2}}{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05498781-0f1b-597d-99f4-6d281558c106" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 6 \\sin{\\left(3 x \\right)}+C" :db/id #edb/ref 17592186496491} {:answer/id #uuid "1440623a-d086-5fe2-bad5-cae097e51159" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=18 \\cos{\\left(3 x \\right)}+C" :db/id #edb/ref 17592186496494} {:answer/id #uuid "43281c01-5636-511d-8e63-cebcbb43941c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2 \\cos{\\left(3 x \\right)}+C" :db/id #edb/ref 17592186496507} {:answer/id #uuid "81b44495-5ebc-5403-b11b-641127a5c037" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 2 \\cos{\\left(3 x \\right)}+C" :db/id #edb/ref 17592186496518} {:answer/id #uuid "864eb041-cbf6-5341-85f6-d4b856cc71df" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{\\cos{\\left(3 x \\right)}}{3}+C" :db/id #edb/ref 17592186496519}] :answer-field/correct {:answer/id #uuid "43281c01-5636-511d-8e63-cebcbb43941c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2 \\cos{\\left(3 x \\right)}+C" :db/id #edb/ref 17592186496507} :answer-field/id #uuid "48649361-838b-599d-b10f-05e824c45568" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496509}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "70f93883-9ca9-59c0-961f-68163c994aa7" :question/problem "Find the general solution to the differential equation $f'(x)=- 6 \\sin{\\left(3 x \\right)}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=- 6 \\sin{\\left(3 x \\right)}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 6 \\sin{\\left(3 x \\right)})\\,\\text{d}x \\\\ f(x) &=\\int (- 6 \\sin{\\left(3 x \\right)})\\,\\text{d}x \\\\ &=1\\cdot \\left(2 \\cos{\\left(3 x \\right)}\\right)+C \\\\ &=2 \\cos{\\left(3 x \\right)}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516116c9-f2ed-5c02-a0c6-89cc7b3b975f" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=4 x^{2} - 24 e^{3 x}+C" :db/id #edb/ref 17592186496510} {:answer/id #uuid "c736e002-8978-541b-a258-65d1e45fd4cd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x^{2} - \\frac{8 e^{3 x}}{3}+C" :db/id #edb/ref 17592186496532} {:answer/id #uuid "cff0d720-fa5f-5b17-a748-a1ea6d70792c" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{8 e^{3 x}}{3}+C" :db/id #edb/ref 17592186496535} {:answer/id #uuid "e42b879f-3611-5d39-b929-1caa970738d3" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- x^{2} + \\frac{8 e^{3 x}}{3}+C" :db/id #edb/ref 17592186496541} {:answer/id #uuid "ff41bc05-baef-5a3b-b44b-d8bee4309a0f" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2 x - 8 e^{3 x}+C" :db/id #edb/ref 17592186496553}] :answer-field/correct {:answer/id #uuid "c736e002-8978-541b-a258-65d1e45fd4cd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=x^{2} - \\frac{8 e^{3 x}}{3}+C" :db/id #edb/ref 17592186496532} :answer-field/id #uuid "aab4f6b8-570e-5582-8f4c-e67092f9ae5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496528}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dc21474b-d455-5fce-b538-e7ab170be80c" :question/problem "Find the general solution to the differential equation $f'(x)=- 8 e^{3 x}+2 x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=- 8 e^{3 x}+2 x\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 8 e^{3 x}+2 x)\\,\\text{d}x \\\\ f(x) &=\\int (- 8 e^{3 x})\\,\\text{d}x+\\int (2 x)\\,\\text{d}x \\\\ &=1\\cdot \\left(- \\frac{8 e^{3 x}}{3}\\right)+1\\cdot \\left(x^{2}\\right)+C \\\\ &=- \\frac{8 e^{3 x}}{3}+x^{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22c6e31d-a4ee-55ca-8606-d24f97c88073" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=16 x^{2}+C" :db/id #edb/ref 17592186496500} {:answer/id #uuid "8ad55cef-7a88-5b78-9925-d6fbeaf2e568" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=8 x+C" :db/id #edb/ref 17592186496520} {:answer/id #uuid "9b175360-a0a2-5506-8689-951930bc656e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{x^{2}}{2}+C" :db/id #edb/ref 17592186496524} {:answer/id #uuid "c4c1210f-6629-515b-9bc5-1a7b6eac482a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=4 x^{2}+C" :db/id #edb/ref 17592186496530} {:answer/id #uuid "f1a30b57-6ce0-5c54-904b-c91e933e9b7b" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 4 x^{2}+C" :db/id #edb/ref 17592186496546}] :answer-field/correct {:answer/id #uuid "c4c1210f-6629-515b-9bc5-1a7b6eac482a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=4 x^{2}+C" :db/id #edb/ref 17592186496530} :answer-field/id #uuid "71257e6a-7d7b-50aa-9c19-e6143a087bf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496515}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "efaa08c6-5d83-5f61-899a-e98ffe7a703d" :question/problem "Find the general solution to the differential equation $f'(x)=8 x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=8 x\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (8 x)\\,\\text{d}x \\\\ f(x) &=\\int (8 x)\\,\\text{d}x \\\\ &=1\\cdot \\left(4 x^{2}\\right)+C \\\\ &=4 x^{2}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "655c69d4-326e-52b0-81f2-8daf5cb15e8e" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{2 e^{3 x}}{9} - \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/id #edb/ref 17592186496512} {:answer/id #uuid "7c9bdc9d-5a36-5a24-9a03-02ad2480cd95" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{8 x^{2}}{3} + 2 e^{3 x} - \\frac{32 \\cos{\\left(4 x \\right)}}{3}+C" :db/id #edb/ref 17592186496517} {:answer/id #uuid "a3b929cc-4add-5e77-87f5-ac32c3b24552" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{2 x^{2}}{3} - \\frac{2 e^{3 x}}{9} + \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/id #edb/ref 17592186496527} {:answer/id #uuid "dfd80e8c-5c62-553a-b990-6bbd3722b045" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{2 x^{2}}{3} + \\frac{2 e^{3 x}}{9} - \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/id #edb/ref 17592186496540} {:answer/id #uuid "f8724c5b-3f9e-58d5-9ecf-89fb0aa57785" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{4 x}{3} + \\frac{2 e^{3 x}}{3} + \\frac{8 \\sin{\\left(4 x \\right)}}{3}+C" :db/id #edb/ref 17592186496550}] :answer-field/correct {:answer/id #uuid "dfd80e8c-5c62-553a-b990-6bbd3722b045" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{2 x^{2}}{3} + \\frac{2 e^{3 x}}{9} - \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/id #edb/ref 17592186496540} :answer-field/id #uuid "20ac9012-5436-5190-aee8-8281451a0097" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496499}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f75c8277-6f32-5092-acf6-0560703c8b10" :question/problem "Find the general solution to the differential equation $3f'(x)=8 \\sin{\\left(4 x \\right)}+2 e^{3 x}+4 x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=\\frac{8 \\sin{\\left(4 x \\right)}}{3}+\\frac{2 e^{3 x}}{3}+\\frac{4 x}{3}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (\\frac{8 \\sin{\\left(4 x \\right)}}{3}+\\frac{2 e^{3 x}}{3}+\\frac{4 x}{3})\\,\\text{d}x \\\\ f(x) &=\\frac{1}{3}\\cdot \\int (8 \\sin{\\left(4 x \\right)})\\,\\text{d}x+\\frac{1}{3}\\cdot \\int (2 e^{3 x})\\,\\text{d}x+\\frac{1}{3}\\cdot \\int (4 x)\\,\\text{d}x \\\\ &=\\frac{1}{3}\\cdot \\left(- 2 \\cos{\\left(4 x \\right)}\\right)+\\frac{1}{3}\\cdot \\left(\\frac{2 e^{3 x}}{3}\\right)+\\frac{1}{3}\\cdot \\left(2 x^{2}\\right)+C \\\\ &=- \\frac{2 \\cos{\\left(4 x \\right)}}{3}+\\frac{2 e^{3 x}}{9}+\\frac{2 x^{2}}{3}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186496552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d9939f3-71f9-5ef9-944c-f29e05fe4152" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{24 x^{3}}{5} - \\frac{12 x^{2}}{5} + \\frac{4 e^{2 x}}{5}+C" :db/id #edb/ref 17592186496498} {:answer/id #uuid "8deda811-4331-518b-937c-85237a299cc3" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{8 x^{3}}{15} - \\frac{3 x^{2}}{5}+C" :db/id #edb/ref 17592186496521} {:answer/id #uuid "a35314e6-3ac6-503e-9168-c5691bd336fd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{8 x^{2}}{5} - \\frac{6 x}{5} + \\frac{2 e^{2 x}}{5}+C" :db/id #edb/ref 17592186496526} {:answer/id #uuid "e84c93d9-8649-5fcb-942a-0afdb6ea40f1" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{8 x^{3}}{15} + \\frac{3 x^{2}}{5} - \\frac{e^{2 x}}{5}+C" :db/id #edb/ref 17592186496543} {:answer/id #uuid "f16cc34f-f3a2-502d-aaf6-c74e0b629fa7" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{8 x^{3}}{15} - \\frac{3 x^{2}}{5} + \\frac{e^{2 x}}{5}+C" :db/id #edb/ref 17592186496545}] :answer-field/correct {:answer/id #uuid "f16cc34f-f3a2-502d-aaf6-c74e0b629fa7" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{8 x^{3}}{15} - \\frac{3 x^{2}}{5} + \\frac{e^{2 x}}{5}+C" :db/id #edb/ref 17592186496545} :answer-field/id #uuid "f41a4546-e8c4-53b7-9d92-f0e17adf0540" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496548}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fdf2fccf-758d-5b24-a333-437fd096ef99" :question/problem "Find the general solution to the differential equation $-5f'(x)=6 x+8 x^{2}- 2 e^{2 x}.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=- \\frac{6 x}{5}- \\frac{8 x^{2}}{5}+\\frac{2 e^{2 x}}{5}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- \\frac{6 x}{5}- \\frac{8 x^{2}}{5}+\\frac{2 e^{2 x}}{5})\\,\\text{d}x \\\\ f(x) &=- \\frac{1}{5}\\cdot \\int (6 x)\\,\\text{d}x- \\frac{1}{5}\\cdot \\int (8 x^{2})\\,\\text{d}x- \\frac{1}{5}\\cdot \\int (- 2 e^{2 x})\\,\\text{d}x \\\\ &=- \\frac{1}{5}\\cdot \\left(3 x^{2}\\right)- \\frac{1}{5}\\cdot \\left(\\frac{8 x^{3}}{3}\\right)- \\frac{1}{5}\\cdot \\left(- e^{2 x}\\right)+C \\\\ &=- \\frac{3 x^{2}}{5}- \\frac{8 x^{3}}{15}+\\frac{e^{2 x}}{5}+C.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the General Solution of a Differential Equation Using Integration"}]}
