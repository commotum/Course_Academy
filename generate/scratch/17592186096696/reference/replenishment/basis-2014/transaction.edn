[{:db/id "f1a30b57-6ce0-5c54-904b-c91e933e9b7b" :answer/id #uuid "f1a30b57-6ce0-5c54-904b-c91e933e9b7b" :answer/type :answer.type/math :answer/value "f(x)=- 4 x^{2}+C" :db/ensure :answer/validate} {:db/id "22c6e31d-a4ee-55ca-8606-d24f97c88073" :answer/id #uuid "22c6e31d-a4ee-55ca-8606-d24f97c88073" :answer/type :answer.type/math :answer/value "f(x)=16 x^{2}+C" :db/ensure :answer/validate} {:db/id "8ad55cef-7a88-5b78-9925-d6fbeaf2e568" :answer/id #uuid "8ad55cef-7a88-5b78-9925-d6fbeaf2e568" :answer/type :answer.type/math :answer/value "f(x)=8 x+C" :db/ensure :answer/validate} {:db/id "c4c1210f-6629-515b-9bc5-1a7b6eac482a" :answer/id #uuid "c4c1210f-6629-515b-9bc5-1a7b6eac482a" :answer/type :answer.type/math :answer/value "f(x)=4 x^{2}+C" :db/ensure :answer/validate} {:db/id "9b175360-a0a2-5506-8689-951930bc656e" :answer/id #uuid "9b175360-a0a2-5506-8689-951930bc656e" :answer/type :answer.type/math :answer/value "f(x)=\\frac{x^{2}}{2}+C" :db/ensure :answer/validate} {:db/id "71257e6a-7d7b-50aa-9c19-e6143a087bf4" :answer-field/id #uuid "71257e6a-7d7b-50aa-9c19-e6143a087bf4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["f1a30b57-6ce0-5c54-904b-c91e933e9b7b" "22c6e31d-a4ee-55ca-8606-d24f97c88073" "8ad55cef-7a88-5b78-9925-d6fbeaf2e568" "c4c1210f-6629-515b-9bc5-1a7b6eac482a" "9b175360-a0a2-5506-8689-951930bc656e"] :answer-field/correct "c4c1210f-6629-515b-9bc5-1a7b6eac482a" :db/ensure :answer-field/validate} {:db/id "efaa08c6-5d83-5f61-899a-e98ffe7a703d" :question/id #uuid "efaa08c6-5d83-5f61-899a-e98ffe7a703d" :question/problem "Find the general solution to the differential equation $f'(x)=8 x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=8 x\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (8 x)\\,\\text{d}x \\\\ f(x) &=\\int (8 x)\\,\\text{d}x \\\\ &=1\\cdot \\left(4 x^{2}\\right)+C \\\\ &=4 x^{2}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["71257e6a-7d7b-50aa-9c19-e6143a087bf4"] :db/ensure :question/validate} {:db/id "1440623a-d086-5fe2-bad5-cae097e51159" :answer/id #uuid "1440623a-d086-5fe2-bad5-cae097e51159" :answer/type :answer.type/math :answer/value "f(x)=18 \\cos{\\left(3 x \\right)}+C" :db/ensure :answer/validate} {:db/id "864eb041-cbf6-5341-85f6-d4b856cc71df" :answer/id #uuid "864eb041-cbf6-5341-85f6-d4b856cc71df" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{\\cos{\\left(3 x \\right)}}{3}+C" :db/ensure :answer/validate} {:db/id "05498781-0f1b-597d-99f4-6d281558c106" :answer/id #uuid "05498781-0f1b-597d-99f4-6d281558c106" :answer/type :answer.type/math :answer/value "f(x)=- 6 \\sin{\\left(3 x \\right)}+C" :db/ensure :answer/validate} {:db/id "43281c01-5636-511d-8e63-cebcbb43941c" :answer/id #uuid "43281c01-5636-511d-8e63-cebcbb43941c" :answer/type :answer.type/math :answer/value "f(x)=2 \\cos{\\left(3 x \\right)}+C" :db/ensure :answer/validate} {:db/id "81b44495-5ebc-5403-b11b-641127a5c037" :answer/id #uuid "81b44495-5ebc-5403-b11b-641127a5c037" :answer/type :answer.type/math :answer/value "f(x)=- 2 \\cos{\\left(3 x \\right)}+C" :db/ensure :answer/validate} {:db/id "48649361-838b-599d-b10f-05e824c45568" :answer-field/id #uuid "48649361-838b-599d-b10f-05e824c45568" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["1440623a-d086-5fe2-bad5-cae097e51159" "864eb041-cbf6-5341-85f6-d4b856cc71df" "05498781-0f1b-597d-99f4-6d281558c106" "43281c01-5636-511d-8e63-cebcbb43941c" "81b44495-5ebc-5403-b11b-641127a5c037"] :answer-field/correct "43281c01-5636-511d-8e63-cebcbb43941c" :db/ensure :answer-field/validate} {:db/id "70f93883-9ca9-59c0-961f-68163c994aa7" :question/id #uuid "70f93883-9ca9-59c0-961f-68163c994aa7" :question/problem "Find the general solution to the differential equation $f'(x)=- 6 \\sin{\\left(3 x \\right)}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=- 6 \\sin{\\left(3 x \\right)}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 6 \\sin{\\left(3 x \\right)})\\,\\text{d}x \\\\ f(x) &=\\int (- 6 \\sin{\\left(3 x \\right)})\\,\\text{d}x \\\\ &=1\\cdot \\left(2 \\cos{\\left(3 x \\right)}\\right)+C \\\\ &=2 \\cos{\\left(3 x \\right)}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["48649361-838b-599d-b10f-05e824c45568"] :db/ensure :question/validate} {:db/id "e42b879f-3611-5d39-b929-1caa970738d3" :answer/id #uuid "e42b879f-3611-5d39-b929-1caa970738d3" :answer/type :answer.type/math :answer/value "f(x)=- x^{2} + \\frac{8 e^{3 x}}{3}+C" :db/ensure :answer/validate} {:db/id "516116c9-f2ed-5c02-a0c6-89cc7b3b975f" :answer/id #uuid "516116c9-f2ed-5c02-a0c6-89cc7b3b975f" :answer/type :answer.type/math :answer/value "f(x)=4 x^{2} - 24 e^{3 x}+C" :db/ensure :answer/validate} {:db/id "ff41bc05-baef-5a3b-b44b-d8bee4309a0f" :answer/id #uuid "ff41bc05-baef-5a3b-b44b-d8bee4309a0f" :answer/type :answer.type/math :answer/value "f(x)=2 x - 8 e^{3 x}+C" :db/ensure :answer/validate} {:db/id "c736e002-8978-541b-a258-65d1e45fd4cd" :answer/id #uuid "c736e002-8978-541b-a258-65d1e45fd4cd" :answer/type :answer.type/math :answer/value "f(x)=x^{2} - \\frac{8 e^{3 x}}{3}+C" :db/ensure :answer/validate} {:db/id "cff0d720-fa5f-5b17-a748-a1ea6d70792c" :answer/id #uuid "cff0d720-fa5f-5b17-a748-a1ea6d70792c" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{8 e^{3 x}}{3}+C" :db/ensure :answer/validate} {:db/id "aab4f6b8-570e-5582-8f4c-e67092f9ae5c" :answer-field/id #uuid "aab4f6b8-570e-5582-8f4c-e67092f9ae5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["e42b879f-3611-5d39-b929-1caa970738d3" "516116c9-f2ed-5c02-a0c6-89cc7b3b975f" "ff41bc05-baef-5a3b-b44b-d8bee4309a0f" "c736e002-8978-541b-a258-65d1e45fd4cd" "cff0d720-fa5f-5b17-a748-a1ea6d70792c"] :answer-field/correct "c736e002-8978-541b-a258-65d1e45fd4cd" :db/ensure :answer-field/validate} {:db/id "dc21474b-d455-5fce-b538-e7ab170be80c" :question/id #uuid "dc21474b-d455-5fce-b538-e7ab170be80c" :question/problem "Find the general solution to the differential equation $f'(x)=- 8 e^{3 x}+2 x.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=- 8 e^{3 x}+2 x\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 8 e^{3 x}+2 x)\\,\\text{d}x \\\\ f(x) &=\\int (- 8 e^{3 x})\\,\\text{d}x+\\int (2 x)\\,\\text{d}x \\\\ &=1\\cdot \\left(- \\frac{8 e^{3 x}}{3}\\right)+1\\cdot \\left(x^{2}\\right)+C \\\\ &=- \\frac{8 e^{3 x}}{3}+x^{2}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["aab4f6b8-570e-5582-8f4c-e67092f9ae5c"] :db/ensure :question/validate} {:db/id "9c42ac33-202a-55ab-9e62-9f30f3f58fbf" :answer/id #uuid "9c42ac33-202a-55ab-9e62-9f30f3f58fbf" :answer/type :answer.type/math :answer/value "f(x)=9 x^{3} - 12 x^{2}+C" :db/ensure :answer/validate} {:db/id "98381d2b-0c4d-53f2-aa3a-75c503cdbbe8" :answer/id #uuid "98381d2b-0c4d-53f2-aa3a-75c503cdbbe8" :answer/type :answer.type/math :answer/value "f(x)=- 3 x^{2}+C" :db/ensure :answer/validate} {:db/id "703c4065-6a5d-5d85-b097-7bbf9d11c7f6" :answer/id #uuid "703c4065-6a5d-5d85-b097-7bbf9d11c7f6" :answer/type :answer.type/math :answer/value "f(x)=3 x^{2} - 6 x+C" :db/ensure :answer/validate} {:db/id "7702e446-2f35-5f48-8c0e-793922a67609" :answer/id #uuid "7702e446-2f35-5f48-8c0e-793922a67609" :answer/type :answer.type/math :answer/value "f(x)=x^{3} - 3 x^{2}+C" :db/ensure :answer/validate} {:db/id "e50eaf70-2445-548f-b86c-1e9e5899495c" :answer/id #uuid "e50eaf70-2445-548f-b86c-1e9e5899495c" :answer/type :answer.type/math :answer/value "f(x)=- x^{3} + 3 x^{2}+C" :db/ensure :answer/validate} {:db/id "ce7f7235-e7cb-5569-b97b-caa4d45fcf30" :answer-field/id #uuid "ce7f7235-e7cb-5569-b97b-caa4d45fcf30" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["9c42ac33-202a-55ab-9e62-9f30f3f58fbf" "98381d2b-0c4d-53f2-aa3a-75c503cdbbe8" "703c4065-6a5d-5d85-b097-7bbf9d11c7f6" "7702e446-2f35-5f48-8c0e-793922a67609" "e50eaf70-2445-548f-b86c-1e9e5899495c"] :answer-field/correct "7702e446-2f35-5f48-8c0e-793922a67609" :db/ensure :answer-field/validate} {:db/id "179f19da-330e-5f5e-a1f0-62959c022ecc" :question/id #uuid "179f19da-330e-5f5e-a1f0-62959c022ecc" :question/problem "Find the general solution to the differential equation $f'(x)=- 6 x+3 x^{2}.$" :question/worked-solution "First, notice that the derivative term is already isolated on the left:\n\n$$\n\\begin{aligned}f'(x) &=- 6 x+3 x^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- 6 x+3 x^{2})\\,\\text{d}x \\\\ f(x) &=\\int (- 6 x)\\,\\text{d}x+\\int (3 x^{2})\\,\\text{d}x \\\\ &=1\\cdot \\left(- 3 x^{2}\\right)+1\\cdot \\left(x^{3}\\right)+C \\\\ &=- 3 x^{2}+x^{3}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["ce7f7235-e7cb-5569-b97b-caa4d45fcf30"] :db/ensure :question/validate} {:db/id "e84c93d9-8649-5fcb-942a-0afdb6ea40f1" :answer/id #uuid "e84c93d9-8649-5fcb-942a-0afdb6ea40f1" :answer/type :answer.type/math :answer/value "f(x)=\\frac{8 x^{3}}{15} + \\frac{3 x^{2}}{5} - \\frac{e^{2 x}}{5}+C" :db/ensure :answer/validate} {:db/id "1d9939f3-71f9-5ef9-944c-f29e05fe4152" :answer/id #uuid "1d9939f3-71f9-5ef9-944c-f29e05fe4152" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{24 x^{3}}{5} - \\frac{12 x^{2}}{5} + \\frac{4 e^{2 x}}{5}+C" :db/ensure :answer/validate} {:db/id "a35314e6-3ac6-503e-9168-c5691bd336fd" :answer/id #uuid "a35314e6-3ac6-503e-9168-c5691bd336fd" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{8 x^{2}}{5} - \\frac{6 x}{5} + \\frac{2 e^{2 x}}{5}+C" :db/ensure :answer/validate} {:db/id "f16cc34f-f3a2-502d-aaf6-c74e0b629fa7" :answer/id #uuid "f16cc34f-f3a2-502d-aaf6-c74e0b629fa7" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{8 x^{3}}{15} - \\frac{3 x^{2}}{5} + \\frac{e^{2 x}}{5}+C" :db/ensure :answer/validate} {:db/id "8deda811-4331-518b-937c-85237a299cc3" :answer/id #uuid "8deda811-4331-518b-937c-85237a299cc3" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{8 x^{3}}{15} - \\frac{3 x^{2}}{5}+C" :db/ensure :answer/validate} {:db/id "f41a4546-e8c4-53b7-9d92-f0e17adf0540" :answer-field/id #uuid "f41a4546-e8c4-53b7-9d92-f0e17adf0540" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["e84c93d9-8649-5fcb-942a-0afdb6ea40f1" "1d9939f3-71f9-5ef9-944c-f29e05fe4152" "a35314e6-3ac6-503e-9168-c5691bd336fd" "f16cc34f-f3a2-502d-aaf6-c74e0b629fa7" "8deda811-4331-518b-937c-85237a299cc3"] :answer-field/correct "f16cc34f-f3a2-502d-aaf6-c74e0b629fa7" :db/ensure :answer-field/validate} {:db/id "fdf2fccf-758d-5b24-a333-437fd096ef99" :question/id #uuid "fdf2fccf-758d-5b24-a333-437fd096ef99" :question/problem "Find the general solution to the differential equation $-5f'(x)=6 x+8 x^{2}- 2 e^{2 x}.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=- \\frac{6 x}{5}- \\frac{8 x^{2}}{5}+\\frac{2 e^{2 x}}{5}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (- \\frac{6 x}{5}- \\frac{8 x^{2}}{5}+\\frac{2 e^{2 x}}{5})\\,\\text{d}x \\\\ f(x) &=- \\frac{1}{5}\\cdot \\int (6 x)\\,\\text{d}x- \\frac{1}{5}\\cdot \\int (8 x^{2})\\,\\text{d}x- \\frac{1}{5}\\cdot \\int (- 2 e^{2 x})\\,\\text{d}x \\\\ &=- \\frac{1}{5}\\cdot \\left(3 x^{2}\\right)- \\frac{1}{5}\\cdot \\left(\\frac{8 x^{3}}{3}\\right)- \\frac{1}{5}\\cdot \\left(- e^{2 x}\\right)+C \\\\ &=- \\frac{3 x^{2}}{5}- \\frac{8 x^{3}}{15}+\\frac{e^{2 x}}{5}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["f41a4546-e8c4-53b7-9d92-f0e17adf0540"] :db/ensure :question/validate} {:db/id "7c9bdc9d-5a36-5a24-9a03-02ad2480cd95" :answer/id #uuid "7c9bdc9d-5a36-5a24-9a03-02ad2480cd95" :answer/type :answer.type/math :answer/value "f(x)=\\frac{8 x^{2}}{3} + 2 e^{3 x} - \\frac{32 \\cos{\\left(4 x \\right)}}{3}+C" :db/ensure :answer/validate} {:db/id "655c69d4-326e-52b0-81f2-8daf5cb15e8e" :answer/id #uuid "655c69d4-326e-52b0-81f2-8daf5cb15e8e" :answer/type :answer.type/math :answer/value "f(x)=\\frac{2 e^{3 x}}{9} - \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/ensure :answer/validate} {:db/id "f8724c5b-3f9e-58d5-9ecf-89fb0aa57785" :answer/id #uuid "f8724c5b-3f9e-58d5-9ecf-89fb0aa57785" :answer/type :answer.type/math :answer/value "f(x)=\\frac{4 x}{3} + \\frac{2 e^{3 x}}{3} + \\frac{8 \\sin{\\left(4 x \\right)}}{3}+C" :db/ensure :answer/validate} {:db/id "dfd80e8c-5c62-553a-b990-6bbd3722b045" :answer/id #uuid "dfd80e8c-5c62-553a-b990-6bbd3722b045" :answer/type :answer.type/math :answer/value "f(x)=\\frac{2 x^{2}}{3} + \\frac{2 e^{3 x}}{9} - \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/ensure :answer/validate} {:db/id "a3b929cc-4add-5e77-87f5-ac32c3b24552" :answer/id #uuid "a3b929cc-4add-5e77-87f5-ac32c3b24552" :answer/type :answer.type/math :answer/value "f(x)=- \\frac{2 x^{2}}{3} - \\frac{2 e^{3 x}}{9} + \\frac{2 \\cos{\\left(4 x \\right)}}{3}+C" :db/ensure :answer/validate} {:db/id "20ac9012-5436-5190-aee8-8281451a0097" :answer-field/id #uuid "20ac9012-5436-5190-aee8-8281451a0097" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["7c9bdc9d-5a36-5a24-9a03-02ad2480cd95" "655c69d4-326e-52b0-81f2-8daf5cb15e8e" "f8724c5b-3f9e-58d5-9ecf-89fb0aa57785" "dfd80e8c-5c62-553a-b990-6bbd3722b045" "a3b929cc-4add-5e77-87f5-ac32c3b24552"] :answer-field/correct "dfd80e8c-5c62-553a-b990-6bbd3722b045" :db/ensure :answer-field/validate} {:db/id "f75c8277-6f32-5092-acf6-0560703c8b10" :question/id #uuid "f75c8277-6f32-5092-acf6-0560703c8b10" :question/problem "Find the general solution to the differential equation $3f'(x)=8 \\sin{\\left(4 x \\right)}+2 e^{3 x}+4 x.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}f'(x) &=\\frac{8 \\sin{\\left(4 x \\right)}}{3}+\\frac{2 e^{3 x}}{3}+\\frac{4 x}{3}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int f\\prime(x)\\,\\text{d}x &=\\int (\\frac{8 \\sin{\\left(4 x \\right)}}{3}+\\frac{2 e^{3 x}}{3}+\\frac{4 x}{3})\\,\\text{d}x \\\\ f(x) &=\\frac{1}{3}\\cdot \\int (8 \\sin{\\left(4 x \\right)})\\,\\text{d}x+\\frac{1}{3}\\cdot \\int (2 e^{3 x})\\,\\text{d}x+\\frac{1}{3}\\cdot \\int (4 x)\\,\\text{d}x \\\\ &=\\frac{1}{3}\\cdot \\left(- 2 \\cos{\\left(4 x \\right)}\\right)+\\frac{1}{3}\\cdot \\left(\\frac{2 e^{3 x}}{3}\\right)+\\frac{1}{3}\\cdot \\left(2 x^{2}\\right)+C \\\\ &=- \\frac{2 \\cos{\\left(4 x \\right)}}{3}+\\frac{2 e^{3 x}}{9}+\\frac{2 x^{2}}{3}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["20ac9012-5436-5190-aee8-8281451a0097"] :db/ensure :question/validate} {:db/id "38d904cc-8188-5c23-8d1a-2ce92740dcf8" :answer/id #uuid "38d904cc-8188-5c23-8d1a-2ce92740dcf8" :answer/type :answer.type/math :answer/value "f(x)=\\frac{x^{2}}{3} - \\frac{e^{4 x}}{4} - 2 \\ln{\\left(\\left|{x - 2}\\right| \\right)}+C" :db/ensure :answer/validate} {:db/id "0d32326d-f8f7-50a3-985e-b1e1d37cdc2a" :answer/id #uuid "0d32326d-f8f7-50a3-985e-b1e1d37cdc2a" :answer/type :answer.type/math :answer/value "f(x)=- \\frac