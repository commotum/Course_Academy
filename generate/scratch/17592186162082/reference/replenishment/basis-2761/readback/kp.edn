#{[{:db/id #edb/ref 17592186162082 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161895 :question/id #uuid "fdab3229-66ca-59d3-ac20-8a5b3d3506fc" :question/math-academy-id "e-9471" :question/problem "![](images/84/84de7754ed9244e3d646e452f6ed6dab349c130d17eae1d4dbc94cb52bd761e1.png)\n\nCalculate $\\displaystyle\\int_C \\,\\textrm d s,$ where $C$ is the path shown above, traversed once counterclockwise." :question/worked-solution "The path $C$ is made up of three parts, as shown below:\n\n![](images/f4/f4e80a23910612bd55e7578a074f23c76535139889faff479c4dd0521e7496ff.png)\n\nNow, we make use of the following facts:\n\n- If $C = C_1 \\cup C_2 \\cup C_3$ is a piecewise-smooth curve, we have\n\n$$\n\\int_{C}f(x,y)\\,\\textrm d s =  \\int_{C_1}f(x,y)\\,\\textrm d s + \\int_{C_2}f(x,y)\\,\\textrm d s + \\int_{C_3}f(x,y)\\,\\textrm d s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n\\displaystyle\\int_C \\,\\textrm d s = L.\n$$\n\nThe path $C_1$ is a semicircle of radius $r = 3.$ Therefore, we have\n\n$$\n\\int_{C_1} \\,\\textrm ds = \\dfrac{1}{2}(2 \\pi r) = 3\\pi.\n$$\n\nThe paths $C_2$ and $C_3$ are hypotenuses of right triangles whose legs have lengths $3$ and $4.$ Therefore, we have\n\n$$\n\\int_{C_2} \\,\\textrm ds = \\int_{C_3} \\,\\textrm ds = \\sqrt{3^2 + 4^2} = 5.\n$$\n\nTherefore,\n\n$$\n\\int_C \\,\\textrm d s = 3\\pi + 5 + 5 = 3\\pi + 10.\n$$"} :knowledge-point/id #uuid "e60b3dd1-0842-562d-a72f-5adb6a60cba8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050975 :topic/math-academy-id 459 :topic/title "The Distance Formula"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186564725 :question-generator/id #uuid "1076aa62-db52-58ca-8dd8-de3aa73fab5b" :question-generator/script "generate/scratch/17592186162082.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186162327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac6987e-1443-5102-be6c-7c404cb81a29" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi +1)" :db/id #edb/ref 17592186253751} {:answer/id #uuid "4848d525-4fed-5241-aa55-e8be28361018" :answer/type {:db/ident :answer.type/math} :answer/value "4(\\pi +2)" :db/id #edb/ref 17592186254286} {:answer/id #uuid "5fb762e8-b607-526d-970c-769c2e97b12a" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi +2)" :db/id #edb/ref 17592186254526} {:answer/id #uuid "a1ab8300-d36e-5b2f-b815-bf8f3c00e075" :answer/type {:db/ident :answer.type/math} :answer/value "2(2\\pi +1)" :db/id #edb/ref 17592186255094} {:answer/id #uuid "f438f0f4-4512-5533-b108-0d1c4c07ad3a" :answer/type {:db/ident :answer.type/math} :answer/value "4(\\pi +1)" :db/id #edb/ref 17592186255807}] :answer-field/correct {:answer/id #uuid "5fb762e8-b607-526d-970c-769c2e97b12a" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi +2)" :db/id #edb/ref 17592186254526} :answer-field/id #uuid "02208297-3b6c-56a2-86c8-c39f569c53b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255921}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ef2f2e1e-2df6-5eea-a523-f7500a9f7301" :question/math-academy-id "q-122481" :question/problem "![](images/55/558dbbc424725ca0d9bad628968489cc2e32d67136102290666ff055a634bc16.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is a path that traverses a semicircle of radius $2$ once in the counterclockwise direction, as shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/82/82fedadbb33b1747832bac25d9cda8e0b6b18b0fab411a870e90bc09ce47226e.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a semi-circle of radius $r=2.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\pi r=2\\pi .\n$$\n\nThe path ${C}_{2}$ is a line segment of length $4.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=4.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=2\\pi +4=2(\\pi +2).\n$$"} {:db/id #edb/ref 17592186162328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "976609f5-9b7b-5cf5-8af9-7eda58f599e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{2} + \\sqrt{3}" :db/id #edb/ref 17592186159171} {:answer/id #uuid "f5827111-0006-5c1b-ba8a-12b199fc5f54" :answer/type {:db/ident :answer.type/math} :answer/value "π + 2\\sqrt{2}" :db/id #edb/ref 17592186159172} {:answer/id #uuid "1e127cda-f337-5d92-a559-58f2b9959529" :answer/type {:db/ident :answer.type/math} :answer/value "π + \\sqrt{2}" :db/id #edb/ref 17592186159173} {:answer/id #uuid "3f7e980f-41b3-58a9-b313-eb4e1299df8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{2} + \\sqrt{2}" :db/id #edb/ref 17592186159174} {:answer/id #uuid "68d2396c-897e-51b5-9821-0211bcf63840" :answer/type {:db/ident :answer.type/math} :answer/value "2π + 3\\sqrt{2}" :db/id #edb/ref 17592186159175}] :answer-field/id #uuid "9788a76e-e0cc-5a5d-b125-0a5dce44952b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159170}] :question/id #uuid "e7cfc0f1-43a0-55ae-a985-5e79d8a25ecd" :question/math-academy-id "q-122484" :question/problem "![](images/52/5277642b981910a5da1dd00a1b9aa4db28c7db7fcacf33faf209eea3ec1e93ab.png)\n\nCalculate $\\displaystyle \\int_{C}ds$, where $C$ is a path that traverses a circular segment of radius $2$ once in the counterclockwise direction, as shown above."} {:db/id #edb/ref 17592186256725 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "461a27ae-9bae-56e4-a290-8a9b99dd2f96" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186254262} {:answer/id #uuid "48f7a64a-5065-5b48-9afa-0c3ec86372c2" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186254296} {:answer/id #uuid "7fa5f20e-2e73-5f1c-9c2f-9b1fb94075b5" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186254799} {:answer/id #uuid "8b6906ae-426e-569c-adc9-44144d8e41a6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186254901} {:answer/id #uuid "a3313bd1-e6b1-51a4-ba38-134097b446aa" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255109}] :answer-field/correct {:answer/id #uuid "7fa5f20e-2e73-5f1c-9c2f-9b1fb94075b5" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186254799} :answer-field/id #uuid "37cd5012-6b1d-57b4-a60a-c7978b2ab3f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256019}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "23524215-604c-5fbd-8acf-4af9e94c29ca" :question/math-academy-id "q-122828" :question/problem "![](images/39/39a7cb0b31cb5d906803063597ae968be8fba90f048a4d9745225de7c3f8d6db.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of three parts, as shown below:\n\n![](images/05/058c7b33112329df321e61660df4f2d388f42ca40c0aae5b73a089a0251726e2.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{3}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe paths ${C}_{1}$ and ${C}_{3}$ are line segments of length $3.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s={\\int }_{{C}_{3}}\\,\\text{d}s=3.\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle whose legs have lengths $3$ and $4.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{3}^{2}+{4}^{2}}=5.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=3+5+3=11.\n$$"} {:db/id #edb/ref 17592186256730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48070546-d80f-5246-86a4-aa8d7aa99c50" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi +1" :db/id #edb/ref 17592186254279} {:answer/id #uuid "72a7d010-8a49-501c-a8b0-6c4408fdf75f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi +2" :db/id #edb/ref 17592186254685} {:answer/id #uuid "96002547-d724-56a8-8e09-188ad7369cdb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi +4" :db/id #edb/ref 17592186254992} {:answer/id #uuid "bb1a64fc-def5-5882-88a7-756a23766b42" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi +3" :db/id #edb/ref 17592186255336} {:answer/id #uuid "c24b4875-c3c0-55e6-b7fe-e4f60d7affdd" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi +2" :db/id #edb/ref 17592186255405}] :answer-field/correct {:answer/id #uuid "72a7d010-8a49-501c-a8b0-6c4408fdf75f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi +2" :db/id #edb/ref 17592186254685} :answer-field/id #uuid "01fb92ac-5f7f-5736-aab9-a7276e24a517" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255920}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f87f9aea-995d-5fa2-9903-84aef89b9be9" :question/math-academy-id "q-122843" :question/problem "![](images/d7/d7844777c0bb540ba337756f45c4d71a8a8e9f9c84372e01542892801efecce3.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/98/98f444851e2df505d4242d1f8e4be0d76f78babd5d9633d9ab0ec84c245fe364.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is three-quarters of a circle of radius $r=2.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\frac{3}{4}(2\\pi r)=3\\pi .\n$$\n\nThe path ${C}_{2}$ is a line segment of length $2.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=2.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=3\\pi +2.\n$$"} {:db/id #edb/ref 17592186256731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2461d307-3086-5a5c-b497-aa48ad65c133" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186253997} {:answer/id #uuid "2dbd98bc-e62d-5a92-bfa0-9c4e1787b547" :answer/type {:db/ident :answer.type/math} :answer/value "2(2+\\sqrt{5})" :db/id #edb/ref 17592186254082} {:answer/id #uuid "65e5a51e-ba13-5ae9-a263-385c9c9cf5de" :answer/type {:db/ident :answer.type/math} :answer/value "2(3+\\sqrt{5})" :db/id #edb/ref 17592186254582} {:answer/id #uuid "a1016a1d-d5a6-5066-9d4a-cb08a1cf0136" :answer/type {:db/ident :answer.type/math} :answer/value "5+2\\sqrt{5}" :db/id #edb/ref 17592186255084} {:answer/id #uuid "b2237b88-2d33-5dfc-a776-cc65d79f2e63" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255236}] :answer-field/correct {:answer/id #uuid "a1016a1d-d5a6-5066-9d4a-cb08a1cf0136" :answer/type {:db/ident :answer.type/math} :answer/value "5+2\\sqrt{5}" :db/id #edb/ref 17592186255084} :answer-field/id #uuid "a64d136c-2e50-5fe9-8693-5b8666a0d0be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256225}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "efd8621e-7cbb-5240-b849-bfa0535c815e" :question/math-academy-id "q-122845" :question/problem "![](images/68/68b3f78c29c9d7776efc2a78672ae53fe2e806d7ca6c3d663de8a16c03342132.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/27/27c19b56a24315f1105539afc441a33957dddf606b3410b86121e7cb8ed16973.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is the hypotenuse of a right triangle whose legs have lengths $3$ and $4.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\sqrt{{3}^{2}+{4}^{2}}=5.\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle whose legs have lengths $2$ and $4.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{2}^{2}+{4}^{2}}=2\\sqrt{5}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=5+2\\sqrt{5}.\n$$"} {:db/id #edb/ref 17592186256733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06fbccd3-1730-54fc-9475-ad997c5afc37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi +4\\sqrt{2}}{4}" :db/id #edb/ref 17592186253721} {:answer/id #uuid "21e53e95-7ec4-5c95-b9e3-453c9a2ed4f8" :answer/type {:db/ident :answer.type/math} :answer/value "2(2\\pi +\\sqrt{2})" :db/id #edb/ref 17592186253974} {:answer/id #uuid "44332bd0-327e-53e0-9733-797aa948733d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi +4\\sqrt{2}}{4}" :db/id #edb/ref 17592186254249} {:answer/id #uuid "6169a709-a992-502e-9cbc-f73991286538" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi +3\\sqrt{2}" :db/id #edb/ref 17592186254543} {:answer/id #uuid "819bf68a-c423-5c96-b729-706e6eb1fc6e" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi +2\\sqrt{2})" :db/id #edb/ref 17592186254817}] :answer-field/correct {:answer/id #uuid "819bf68a-c423-5c96-b729-706e6eb1fc6e" :answer/type {:db/ident :answer.type/math} :answer/value "2(\\pi +2\\sqrt{2})" :db/id #edb/ref 17592186254817} :answer-field/id #uuid "4639a58d-2fdb-5f66-8101-7eaad8afbbd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256053}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "65d60feb-29ba-53eb-9de0-464deb1c4c60" :question/math-academy-id "q-122850" :question/problem "![](images/bf/bf87c4707c0f4a8ab1b5157a13e8c7785da915833c5f9d896a2747af27f70e59.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/ff/ff52b8e83a9cc9867b25ea3c24ed0f988a27dec73f9e0ab2dfda28ddabb3238a.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above.\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a quarter of a circle of radius $r=4.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\frac{1}{4}(2\\pi r)=2\\pi .\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle where both legs have a length of $4.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{4}^{2}+{4}^{2}}=4\\sqrt{2}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=2\\pi +4\\sqrt{2}=2(\\pi +2\\sqrt{2}).\n$$"} {:db/id #edb/ref 17592186564664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254fa1aa-2b59-5f26-9246-2796d0242d88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34 \\sqrt{2}}{3}" :db/id #edb/ref 17592186564662} {:answer/id #uuid "69047681-a0ac-5878-89be-37d0746b4773" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17 \\pi}{3} + \\frac{68 \\sqrt{2}}{3}" :db/id #edb/ref 17592186564684} {:answer/id #uuid "8cf06456-320d-5f63-b850-aadf56a721fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34 \\sqrt{2}}{3} + \\frac{17 \\pi}{3}" :db/id #edb/ref 17592186564694} {:answer/id #uuid "9b7245fc-213e-5e3a-abbd-9bb84f1cd564" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34 \\sqrt{2}}{3} + \\frac{34 \\pi}{3}" :db/id #edb/ref 17592186564700} {:answer/id #uuid "aba8edfe-1ccf-5995-838b-b23e5342af2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17 \\pi}{3}" :db/id #edb/ref 17592186564706}] :answer-field/correct {:answer/id #uuid "8cf06456-320d-5f63-b850-aadf56a721fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34 \\sqrt{2}}{3} + \\frac{17 \\pi}{3}" :db/id #edb/ref 17592186564694} :answer-field/id #uuid "9ff80886-22b6-53e7-ab56-0ffaeda80cae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564702}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2bd95eb6-ed23-59fb-b84e-91c27fd5bc8c" :question/problem "![](images/42/42e881f2fea91ee9191c5b32dce49f485977ded98a9e900bfcaf51fc1e0f8ec1.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/49/494158fe124fe1c8e1f7f618695dc9846991bd074b199a45a5874ddb8ad16e86.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above.\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a quarter of a circle of radius $r=\\frac{34}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\frac{1}{4}(2\\pi r)=\\frac{17 \\pi}{3} .\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle where both legs have a length of $\\frac{34}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{\\frac{34}{3}}^{2}+{\\frac{34}{3}}^{2}}=\\frac{34 \\sqrt{2}}{3}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=\\frac{17 \\pi}{3}+\\frac{34 \\sqrt{2}}{3}=\\frac{17}{3}(\\pi+2\\sqrt{2}).\n$$"} {:db/id #edb/ref 17592186564668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4026ea-c30a-5983-ad0c-bd822a8dc3e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186564656} {:answer/id #uuid "6b37a7a3-5ba5-5693-8604-1ffbd07065d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186564685} {:answer/id #uuid "8ddab92d-89a6-5d3b-b0c5-a6454796a085" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{38}{3}" :db/id #edb/ref 17592186564696} {:answer/id #uuid "95e2ebbb-303d-51c2-9cdb-29978e161196" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{28}{3}" :db/id #edb/ref 17592186564698} {:answer/id #uuid "f63dbde9-05aa-5d77-8273-3853668871e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{3}" :db/id #edb/ref 17592186564721}] :answer-field/correct {:answer/id #uuid "f63dbde9-05aa-5d77-8273-3853668871e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{3}" :db/id #edb/ref 17592186564721} :answer-field/id #uuid "de148ad0-dd56-5670-9ba2-8c76650d62dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564714}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "37e815a8-9354-5afd-b1c1-eadfdb328f5e" :question/problem "![](images/00/00c1e8199146ddfdc1d8243eccfc5d5f44f9e67474722365a5c39c4a2226dcab.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of three parts, as shown below:\n\n![](images/a0/a0fbd1bc9dfacd406a027a0178d223dc972379a6b370b121f28975c345696f85.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{3}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe paths ${C}_{1}$ and ${C}_{3}$ are line segments of length $2.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s={\\int }_{{C}_{3}}\\,\\text{d}s=2.\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle whose legs have lengths $2$ and $\\frac{8}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{2}^{2}+{\\frac{8}{3}}^{2}}=\\frac{10}{3}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=2+\\frac{10}{3}+2=\\frac{22}{3}.\n$$"} {:db/id #edb/ref 17592186564670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1400ed01-a0a6-55a6-a62b-81de67ec5459" :answer/type {:db/ident :answer.type/math} :answer/value "12 + 12 \\pi" :db/id #edb/ref 17592186564658} {:answer/id #uuid "7ea783a3-7345-5590-afc8-e2f042480069" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186564691} {:answer/id #uuid "80997fb7-9f5a-58a7-8cc0-4a9b9477ef0f" :answer/type {:db/ident :answer.type/math} :answer/value "12 + 6 \\pi" :db/id #edb/ref 17592186564692} {:answer/id #uuid "8cf715ae-835b-59a4-ad34-21a1d762f10e" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\pi + 24" :db/id #edb/ref 17592186564695} {:answer/id #uuid "e7d5c7cb-3b29-56e2-b316-e056114bfe86" :answer/type {:db/ident :answer.type/math} :answer/value "6 \\pi" :db/id #edb/ref 17592186564719}] :answer-field/correct {:answer/id #uuid "80997fb7-9f5a-58a7-8cc0-4a9b9477ef0f" :answer/type {:db/ident :answer.type/math} :answer/value "12 + 6 \\pi" :db/id #edb/ref 17592186564692} :answer-field/id #uuid "b41b107d-cbf3-5a79-aad3-73a1033874fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564709}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3be3b093-65d3-5ad8-9987-edb100cd2356" :question/problem "![](images/69/69ff60a180694c898c1ae208d6e2dd95ef82ec0f27b7e4c1cc0256a04ae696b9.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is a path that traverses a semicircle of radius $6$ once in the counterclockwise direction, as shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/96/964e6b51949b7162cfcd71f047b85980ef6387fb8268865a93b38183c060e844.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a semi-circle of radius $r=6.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\pi r=6 \\pi .\n$$\n\nThe path ${C}_{2}$ is a line segment of length $12.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=12.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=6 \\pi+12=6(\\pi+2).\n$$"} {:db/id #edb/ref 17592186564672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "315d6a3a-bf07-5695-aa6d-9283f74a6fb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13 \\sqrt{2}}{3} + \\frac{13 \\pi}{3}" :db/id #edb/ref 17592186564665} {:answer/id #uuid "4fb601af-2f97-5f0a-9f49-9570729131f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13 \\pi}{6}" :db/id #edb/ref 17592186564676} {:answer/id #uuid "5a06c911-5b2b-5b9f-9d82-6303b8ae8fa9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13 \\sqrt{2}}{3}" :db/id #edb/ref 17592186564680} {:answer/id #uuid "67a526f3-3609-58d6-877d-5d77e6ffa487" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13 \\pi}{6} + \\frac{26 \\sqrt{2}}{3}" :db/id #edb/ref 17592186564683} {:answer/id #uuid "fa4567d7-c42b-5422-bf04-872ca010ce42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13 \\sqrt{2}}{3} + \\frac{13 \\pi}{6}" :db/id #edb/ref 17592186564722}] :answer-field/correct {:answer/id #uuid "fa4567d7-c42b-5422-bf04-872ca010ce42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13 \\sqrt{2}}{3} + \\frac{13 \\pi}{6}" :db/id #edb/ref 17592186564722} :answer-field/id #uuid "7e5e21c9-fef1-5528-9af8-b33dccbe4e58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564690}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "411a4ed7-09d4-5168-8b77-a42a36886e18" :question/problem "![](images/2a/2ae1eeb848f8d01597ec509c095d8a0307805640690d9d65102909e2b861e5d2.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/1e/1ec516fa1aa0172ba521d53fc11abd6268cac8eda4d1f221b741d5d9049dda99.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above.\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a quarter of a circle of radius $r=\\frac{13}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\frac{1}{4}(2\\pi r)=\\frac{13 \\pi}{6} .\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle where both legs have a length of $\\frac{13}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{\\frac{13}{3}}^{2}+{\\frac{13}{3}}^{2}}=\\frac{13 \\sqrt{2}}{3}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=\\frac{13 \\pi}{6}+\\frac{13 \\sqrt{2}}{3}=\\frac{13}{6}(\\pi+2\\sqrt{2}).\n$$"} {:db/id #edb/ref 17592186564673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b2c3990-098b-5ab0-9aba-fc2d02824443" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33 \\pi}{2}" :db/id #edb/ref 17592186564657} {:answer/id #uuid "26afed18-8d28-5c6b-87a4-7b956d517b25" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186564663} {:answer/id #uuid "48b164d4-5cf3-5793-85be-edf290d1e4ff" :answer/type {:db/ident :answer.type/math} :answer/value "11 + \\frac{33 \\pi}{2}" :db/id #edb/ref 17592186564675} {:answer/id #uuid "50b7e2c4-ecf8-5b64-b905-286e98efb4d2" :answer/type {:db/ident :answer.type/math} :answer/value "22 + \\frac{33 \\pi}{2}" :db/id #edb/ref 17592186564678} {:answer/id #uuid "75128e4d-afc1-58c3-a587-2af26df50270" :answer/type {:db/ident :answer.type/math} :answer/value "11 + 33 \\pi" :db/id #edb/ref 17592186564689}] :answer-field/correct {:answer/id #uuid "48b164d4-5cf3-5793-85be-edf290d1e4ff" :answer/type {:db/ident :answer.type/math} :answer/value "11 + \\frac{33 \\pi}{2}" :db/id #edb/ref 17592186564675} :answer-field/id #uuid "b38821a3-b0c7-5f00-86ae-85fd1c6ced4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564708}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "41dc3e1b-be2d-5bbc-86e9-c64fede51631" :question/problem "![](images/1a/1aad44e8db3ab56b858a003aada2ea280b879365de13842d7a41f9d7f89e822f.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/02/022aa19e71aed46d212400b6e403406fe3d21a657bd5b45eb23f00fbd32156eb.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is three-quarters of a circle of radius $r=11.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\frac{3}{4}(2\\pi r)=\\frac{33 \\pi}{2} .\n$$\n\nThe path ${C}_{2}$ is a line segment of length $11.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=11.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=\\frac{33 \\pi}{2}+11.\n$$"} {:db/id #edb/ref 17592186564679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05cb0d74-f33b-5fbe-8029-cbdbf413f5a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\pi}{3}" :db/id #edb/ref 17592186564655} {:answer/id #uuid "1e1dfdee-ccb2-5113-b159-0eb59c429284" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{2}}{3} + \\frac{8 \\pi}{3}" :db/id #edb/ref 17592186564661} {:answer/id #uuid "485709c3-2695-52d5-b4d9-a7f3aefc9bea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8 \\pi}{3} + \\frac{32 \\sqrt{2}}{3}" :db/id #edb/ref 17592186564674} {:answer/id #uuid "50087344-4e93-533f-aa5c-aea54804ca54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{2}}{3} + \\frac{16 \\pi}{3}" :db/id #edb/ref 17592186564677} {:answer/id #uuid "73948027-cf11-5670-8e1d-5170c0721d7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{2}}{3}" :db/id #edb/ref 17592186564688}] :answer-field/correct {:answer/id #uuid "1e1dfdee-ccb2-5113-b159-0eb59c429284" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{2}}{3} + \\frac{8 \\pi}{3}" :db/id #edb/ref 17592186564661} :answer-field/id #uuid "3feca9ba-462f-5a07-b949-e027880efd04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564671}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "54958be3-5ebb-5406-b88b-f50f7f7a0951" :question/problem "![](images/e0/e028416a02722d1d832c2daddddbb23a314694ddd328670ed58376681dc7c023.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/5d/5d932a90da98448134bdb2deb9b524636ef7ad9aa59a7e91f9fe0d75178f395e.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above.\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a quarter of a circle of radius $r=\\frac{16}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\frac{1}{4}(2\\pi r)=\\frac{8 \\pi}{3} .\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle where both legs have a length of $\\frac{16}{3}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{\\frac{16}{3}}^{2}+{\\frac{16}{3}}^{2}}=\\frac{16 \\sqrt{2}}{3}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=\\frac{8 \\pi}{3}+\\frac{16 \\sqrt{2}}{3}=\\frac{8}{3}(\\pi+2\\sqrt{2}).\n$$"} {:db/id #edb/ref 17592186564699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ae28349-c307-508a-868f-e8da5aff759e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{37}" :db/id #edb/ref 17592186564669} {:answer/id #uuid "6b972325-d91a-5e10-a6a0-7673280cc2a4" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186564686} {:answer/id #uuid "709a7d3e-e626-5446-b05f-99ddea8a8a89" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{37} + 10" :db/id #edb/ref 17592186564687} {:answer/id #uuid "de5cc153-16a5-5896-a764-ef96a7588c4f" :answer/type {:db/ident :answer.type/math} :answer/value "10 + 2 \\sqrt{37}" :db/id #edb/ref 17592186564715} {:answer/id #uuid "fada5617-6d0a-523e-aacd-a9ac36a57c08" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{37} + 20" :db/id #edb/ref 17592186564723}] :answer-field/correct {:answer/id #uuid "709a7d3e-e626-5446-b05f-99ddea8a8a89" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{37} + 10" :db/id #edb/ref 17592186564687} :answer-field/id #uuid "c4ae82dd-412c-55cf-9103-6de711e9a71c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564711}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "998321a9-810c-52e0-b273-f92be0787403" :question/problem "![](images/d6/d6128159e1606c72588f4881db5156ec3b73be224c160c15a0977a1eb1f824fa.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/2e/2e4d02399788c449b02d77757c66eb3be78e38289f0af5eac3ae784b5d0f2f5d.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is the hypotenuse of a right triangle whose legs have lengths $8$ and $6.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\sqrt{{8}^{2}+{6}^{2}}=10.\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle whose legs have lengths $1$ and $6.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{1}^{2}+{6}^{2}}=\\sqrt{37}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=10+\\sqrt{37}.\n$$"} {:db/id #edb/ref 17592186564707 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3458a9b8-cdbc-5786-bf2f-2b7ac0f4648d" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186564666} {:answer/id #uuid "a249052d-2b98-5d71-8cc6-7047b84e12c7" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186564703} {:answer/id #uuid "a2ac45a0-039d-5a49-a094-b47ec77bdc33" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186564704} {:answer/id #uuid "a820220a-b885-59b7-875d-3f6bb82842c2" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186564705} {:answer/id #uuid "eda40aa1-5495-5e53-b669-a9ec57816c2f" :answer/type {:db/ident :answer.type/math} :answer/value "44" :db/id #edb/ref 17592186564720}] :answer-field/correct {:answer/id #uuid "a820220a-b885-59b7-875d-3f6bb82842c2" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186564705} :answer-field/id #uuid "9f8448eb-51b3-5597-a7b5-44b390db4b5e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564701}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ac4e161a-9336-5d75-a616-039b5d8c09c1" :question/problem "![](images/26/26b263723ce79bb4ddb59ceac1f179447430b3cf8c3d14e3ea0dfc7612fc0665.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of three parts, as shown below:\n\n![](images/55/553abb9d23d0a9e5f6b980e0c6418404881db984b6180caab1f0624d2deb9397.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{3}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe paths ${C}_{1}$ and ${C}_{3}$ are line segments of length $8.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s={\\int }_{{C}_{3}}\\,\\text{d}s=8.\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle whose legs have lengths $8$ and $6.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{8}^{2}+{6}^{2}}=10.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=8+10+8=26.\n$$"} {:db/id #edb/ref 17592186564717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1298ec-a4c1-5df3-be99-ba930b16d915" :answer/type {:db/ident :answer.type/math} :answer/value "11 \\pi" :db/id #edb/ref 17592186564660} {:answer/id #uuid "376127e0-f21c-5548-b2e1-55245e36fa29" :answer/type {:db/ident :answer.type/math} :answer/value "22 + 11 \\pi" :db/id #edb/ref 17592186564667} {:answer/id #uuid "5d0f384f-05a3-5af8-9869-380f5efeb408" :answer/type {:db/ident :answer.type/math} :answer/value "11 \\pi + 44" :db/id #edb/ref 17592186564681} {:answer/id #uuid "8f9a4d3d-a7ed-5164-bc8d-a992b2ce65f6" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186564697} {:answer/id #uuid "e2a1c553-f73e-51d3-9476-761da45de6a2" :answer/type {:db/ident :answer.type/math} :answer/value "22 + 22 \\pi" :db/id #edb/ref 17592186564716}] :answer-field/correct {:answer/id #uuid "376127e0-f21c-5548-b2e1-55245e36fa29" :answer/type {:db/ident :answer.type/math} :answer/value "22 + 11 \\pi" :db/id #edb/ref 17592186564667} :answer-field/id #uuid "d5575d2e-bf63-5160-9f72-babb74586c2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564713}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e5898e01-d74e-5a4e-bea2-7c03b62c4e22" :question/problem "![](images/35/35cb0f44f9b2b88a56351a295c9b1d4de93674d10d914c3017e8fd9382d1e446.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is a path that traverses a semicircle of radius $11$ once in the counterclockwise direction, as shown above." :question/worked-solution "The path $C$ is made up of two parts, as shown below:\n\n![](images/bd/bdc6176ad2a20edab8ce185794c48dcb426828f561bceadddc3b3cb2e693fb62.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe path ${C}_{1}$ is a semi-circle of radius $r=11.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s=\\pi r=11 \\pi .\n$$\n\nThe path ${C}_{2}$ is a line segment of length $22.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=22.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=11 \\pi+22=11(\\pi+2).\n$$"} {:db/id #edb/ref 17592186564724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3cc87c-7837-5272-af3c-85f049ceebe3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{49}{2}" :db/id #edb/ref 17592186564659} {:answer/id #uuid "8bce55ea-29a7-58c1-8983-956eb2c3dd76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{37}{2}" :db/id #edb/ref 17592186564693} {:answer/id #uuid "b6211ce5-73f6-5b8d-a813-90bb24c9ada2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{2}" :db/id #edb/ref 17592186564710} {:answer/id #uuid "c9e5b32a-1bff-5228-b5b1-84ac3f3e6e60" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186564712} {:answer/id #uuid "e7adcb95-bcf9-5d59-b9d2-6219b2002b48" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186564718}] :answer-field/correct {:answer/id #uuid "8bce55ea-29a7-58c1-8983-956eb2c3dd76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{37}{2}" :db/id #edb/ref 17592186564693} :answer-field/id #uuid "5ebcd7e0-473d-5535-bde9-0ad95533cc43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564682}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fbcb1b60-1072-56e6-92d0-39f4e15df49b" :question/problem "![](images/24/249efb9fbaa6cc4f1bd923dd5aaa93d149cc07c56e23eb8ba12870b16c9108d3.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path shown above." :question/worked-solution "The path $C$ is made up of three parts, as shown below:\n\n![](images/20/20f9c299762ace89c0d0f8db158d6c8cedf266c5a08ad580c314a7d964897596.png)\n\nNow, we make use of the following facts:\n\n- If $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ is a piecewise-smooth curve, we have\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}s+{\\int }_{{C}_{3}}f(x,y)\\,\\text{d}s.\n$$\n\n- The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nThe paths ${C}_{1}$ and ${C}_{3}$ are line segments of length $6.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{1}}\\,\\text{d}s={\\int }_{{C}_{3}}\\,\\text{d}s=6.\n$$\n\nThe path ${C}_{2}$ is the hypotenuse of a right triangle whose legs have lengths $6$ and $\\frac{5}{2}.$ Therefore, we have\n\n$$\n{\\int }_{{C}_{2}}\\,\\text{d}s=\\sqrt{{6}^{2}+{\\frac{5}{2}}^{2}}=\\frac{13}{2}.\n$$\n\nTherefore,\n\n$$\n{\\int }_{C}\\,\\text{d}s=6+\\frac{13}{2}+6=\\frac{37}{2}.\n$$"}] :knowledge-point/title "Calculating Line Integrals Over Piecewise-Smooth Curves"}]}
