gned}|k \\\\  & =((-3)\\cdot (-2)-5\\cdot 1)i-(2\\cdot (-2)-5\\cdot (-1))j+(2\\cdot 1-(-3)\\cdot (-1))k \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-2,3,-5⟩\\cdot ⟨1,-1,-1⟩ \\\\  & =(-2)\\cdot 1+3\\cdot (-1)+(-5)\\cdot (-1) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["007d847d-6ae6-52b6-a497-cf60fa91c74a"] :db/ensure :question/validate} {:db/id "27b0e6ff-0fbd-5bdd-a351-5887ff0ce816" :answer/id #uuid "27b0e6ff-0fbd-5bdd-a351-5887ff0ce816" :answer/type :answer.type/math :answer/value "-20" :db/ensure :answer/validate} {:db/id "3f9669fe-7bf9-55db-8767-162819a1a311" :answer/id #uuid "3f9669fe-7bf9-55db-8767-162819a1a311" :answer/type :answer.type/math :answer/value "0" :db/ensure :answer/validate} {:db/id "80c335df-1961-5907-bf45-3069a1f3a20c" :answer/id #uuid "80c335df-1961-5907-bf45-3069a1f3a20c" :answer/type :answer.type/math :answer/value "10" :db/ensure :answer/validate} {:db/id "b5e9081b-d311-5781-aebc-80c0bc07299b" :answer/id #uuid "b5e9081b-d311-5781-aebc-80c0bc07299b" :answer/type :answer.type/math :answer/value "8" :db/ensure :answer/validate} {:db/id "cf5889ad-17bf-5a3d-b6a8-b354a97102a2" :answer/id #uuid "cf5889ad-17bf-5a3d-b6a8-b354a97102a2" :answer/type :answer.type/math :answer/value "-36" :db/ensure :answer/validate} {:db/id "7183f683-d36a-5198-94c6-00ee975122f4" :answer-field/id #uuid "7183f683-d36a-5198-94c6-00ee975122f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["27b0e6ff-0fbd-5bdd-a351-5887ff0ce816" "3f9669fe-7bf9-55db-8767-162819a1a311" "80c335df-1961-5907-bf45-3069a1f3a20c" "b5e9081b-d311-5781-aebc-80c0bc07299b" "cf5889ad-17bf-5a3d-b6a8-b354a97102a2"] :answer-field/correct "3f9669fe-7bf9-55db-8767-162819a1a311" :db/ensure :answer-field/validate} {:db/id "1f2bf46b-da63-57bb-88ab-6be57fcad23d" :question/id #uuid "1f2bf46b-da63-57bb-88ab-6be57fcad23d" :question/problem "Given that $a=⟨-1,3,-5⟩,$ $b=⟨2,-4,4⟩,$ and $c=⟨-1,3,-5⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 2 & -4 & 4 \\\\ -1 & 3 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 4 \\\\ 3 & -5\\end{aligned}|i-|\\begin{aligned}2 & 4 \\\\ -1 & -5\\end{aligned}|j+|\\begin{aligned}2 & -4 \\\\ -1 & 3\\end{aligned}|k \\\\  & =((-4)\\cdot (-5)-4\\cdot 3)i-(2\\cdot (-5)-4\\cdot (-1))j+(2\\cdot 3-(-4)\\cdot (-1))k \\\\  & =8i+6j+2k \\\\  & =⟨8,6,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-1,3,-5⟩\\cdot ⟨8,6,2⟩ \\\\  & =(-1)\\cdot 8+3\\cdot 6+(-5)\\cdot 2 \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["7183f683-d36a-5198-94c6-00ee975122f4"] :db/ensure :question/validate} {:db/id "ba2f35f2-876c-5534-b910-4f67ae6e1e85" :answer/id #uuid "ba2f35f2-876c-5534-b910-4f67ae6e1e85" :answer/type :answer.type/math :answer/value "96" :db/ensure :answer/validate} {:db/id "c817e349-9d43-5ed3-b1cd-8fc887b45b71" :answer-field/id #uuid "c817e349-9d43-5ed3-b1cd-8fc887b45b71" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["ba2f35f2-876c-5534-b910-4f67ae6e1e85"] :answer-field/correct "ba2f35f2-876c-5534-b910-4f67ae6e1e85" :db/ensure :answer-field/validate} {:db/id "d6f58672-c2d9-5b4b-a1ac-70b06c5419c6" :question/id #uuid "d6f58672-c2d9-5b4b-a1ac-70b06c5419c6" :question/problem "Given that $a=⟨4,2,-4⟩,$ $b=⟨-3,-1,-4⟩,$ and $c=⟨3,5,-4⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ -3 & -1 & -4 \\\\ 3 & 5 & -4\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -4 \\\\ 5 & -4\\end{aligned}|i-|\\begin{aligned}-3 & -4 \\\\ 3 & -4\\end{aligned}|j+|\\begin{aligned}-3 & -1 \\\\ 3 & 5\\end{aligned}|k \\\\  & =((-1)\\cdot (-4)-(-4)\\cdot 5)i-((-3)\\cdot (-4)-3\\cdot (-4))j+((-3)\\cdot 5-(-1)\\cdot 3)k \\\\  & =24i-24j-12k \\\\  & =⟨24,-24,-12⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨4,2,-4⟩\\cdot ⟨24,-24,-12⟩ \\\\  & =4\\cdot 24+2\\cdot (-24)+(-4)\\cdot (-12) \\\\  & =96-48+48 \\\\  & =96\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["c817e349-9d43-5ed3-b1cd-8fc887b45b71"] :db/ensure :question/validate} {:db/id "243dab41-484b-5283-9e99-e10e0aa94a0d" :answer/id #uuid "243dab41-484b-5283-9e99-e10e0aa94a0d" :answer/type :answer.type/math :answer/value "142" :db/ensure :answer/validate} {:db/id "0542d953-14f3-53d6-b085-2643c62fb607" :answer-field/id #uuid "0542d953-14f3-53d6-b085-2643c62fb607" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["243dab41-484b-5283-9e99-e10e0aa94a0d"] :answer-field/correct "243dab41-484b-5283-9e99-e10e0aa94a0d" :db/ensure :answer-field/validate} {:db/id "e37f57a2-326b-5f48-88f5-0e74cb3e0632" :question/id #uuid "e37f57a2-326b-5f48-88f5-0e74cb3e0632" :question/problem "Given that $a=⟨-5,-5,1⟩,$ $b=⟨1,-1,-3⟩,$ and $c=⟨5,-3,2⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 1 & -1 & -3 \\\\ 5 & -3 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -3 \\\\ -3 & 2\\end{aligned}|i-|\\begin{aligned}1 & -3 \\\\ 5 & 2\\end{aligned}|j+|\\begin{aligned}1 & -1 \\\\ 5 & -3\\end{aligned}|k \\\\  & =((-1)\\cdot 2-(-3)\\cdot (-3))i-(1\\cdot 2-5\\cdot (-3))j+(1\\cdot (-3)-(-1)\\cdot 5)k \\\\  & =-11i-17j+2k \\\\  & =⟨-11,-17,2⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨-5,-5,1⟩\\cdot ⟨-11,-17,2⟩ \\\\  & =(-5)\\cdot (-11)+(-5)\\cdot (-17)+1\\cdot 2 \\\\  & =55+85+2 \\\\  & =142\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["0542d953-14f3-53d6-b085-2643c62fb607"] :db/ensure :question/validate} {:db/id "3ca04c36-b5a0-50ad-a1b0-c6c4307ea445" :answer/id #uuid "3ca04c36-b5a0-50ad-a1b0-c6c4307ea445" :answer/type :answer.type/math :answer/value "4" :db/ensure :answer/validate} {:db/id "d0e1e523-9968-5353-aa90-7d693a6d8352" :answer/id #uuid "d0e1e523-9968-5353-aa90-7d693a6d8352" :answer/type :answer.type/math :answer/value "66" :db/ensure :answer/validate} {:db/id "64f691aa-9638-5417-ab68-e752ecd5cc64" :answer/id #uuid "64f691aa-9638-5417-ab68-e752ecd5cc64" :answer/type :answer.type/math :answer/value "40" :db/ensure :answer/validate} {:db/id "4d94f0d4-c89c-590f-80d6-5211dc248051" :answer/id #uuid "4d94f0d4-c89c-590f-80d6-5211dc248051" :answer/type :answer.type/math :answer/value "46" :db/ensure :answer/validate} {:db/id "cedecffc-9f77-54b1-a175-99d63c0ce5d5" :answer/id #uuid "cedecffc-9f77-54b1-a175-99d63c0ce5d5" :answer/type :answer.type/math :answer/value "33" :db/ensure :answer/validate} {:db/id "9678d55a-9874-5a7a-9a1a-dfdf37ee8c90" :answer-field/id #uuid "9678d55a-9874-5a7a-9a1a-dfdf37ee8c90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["3ca04c36-b5a0-50ad-a1b0-c6c4307ea445" "d0e1e523-9968-5353-aa90-7d693a6d8352" "64f691aa-9638-5417-ab68-e752ecd5cc64" "4d94f0d4-c89c-590f-80d6-5211dc248051" "cedecffc-9f77-54b1-a175-99d63c0ce5d5"] :answer-field/correct "64f691aa-9638-5417-ab68-e752ecd5cc64" :db/ensure :answer-field/validate} {:db/id "8e17b30a-856b-5ad3-9fe4-036dbdb66eb5" :question/id #uuid "8e17b30a-856b-5ad3-9fe4-036dbdb66eb5" :question/problem "Given that $a=⟨4,-3,-1⟩,$ $b=⟨-1,-5,-2⟩,$ and $c=⟨-2,-3,-3⟩,$ find $a\\cdot (b\\