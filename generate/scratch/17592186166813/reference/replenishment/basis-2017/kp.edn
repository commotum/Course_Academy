#{[{:db/id #edb/ref 17592186166813 :knowledge-point/canonical-example {:db/id #edb/ref 17592186166651 :question/id #uuid "cafdc3de-f065-5a60-be3e-8521a49929d4" :question/math-academy-id "e-8459" :question/problem "What is the order of the ordinary differential equation $2x\\dfrac{\\textrm{d}^3y}{\\textrm{d}x^3}+y^2\\dfrac{\\textrm{d}^2y}{\\textrm{d}x^2}=3x^2?$" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\dfrac{\\textrm{d}^3y}{\\textrm{d}x^3},$ which has order $3.$\n\nTherefore, the order of the ODE is $3.$"} :knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050902 :topic/math-academy-id 281 :topic/title "Second and Higher-Order Derivatives"}] :knowledge-point/questions [{:db/id #edb/ref 17592186167439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f4efdc2-0db6-5c05-93a3-dc37ed677c69" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358025} {:answer/id #uuid "259dd133-5bb9-5064-ab22-10c2ff0d0e41" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186358091} {:answer/id #uuid "51e56ff6-776f-5f56-9c5b-1b8c442dae31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186358457} {:answer/id #uuid "e0e79109-ddec-555e-b8e9-91c639217e9a" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186359730} {:answer/id #uuid "e1b99836-5aa4-5130-9573-30541e38e184" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186359745}] :answer-field/correct {:answer/id #uuid "51e56ff6-776f-5f56-9c5b-1b8c442dae31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186358457} :answer-field/id #uuid "e0ef61cf-9080-52a8-9361-8ad5a39a4f1f" :answer-field/key "selection" :answer-