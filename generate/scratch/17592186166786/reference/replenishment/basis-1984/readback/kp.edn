x^{2}) + C" :db/id #edb/ref 17592186492136} {:answer/id #uuid "71addf97-d934-5722-ba38-bfc0e95d498b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\sinh (x^{2}) + C" :db/id #edb/ref 17592186492154} {:answer/id #uuid "720cce27-0318-5bf7-8a10-83287b4bf4c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sinh (x^{2}) + C" :db/id #edb/ref 17592186492155} {:answer/id #uuid "b3faba19-8b48-53e8-af6a-aebb974dc5d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sinh (6x^{2}) + C" :db/id #edb/ref 17592186492174} {:answer/id #uuid "b575eed4-3020-5b1d-aec7-79fa0abe0f88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\sinh (3x^{2}) + C" :db/id #edb/ref 17592186492175}] :answer-field/correct {:answer/id #uuid "b575eed4-3020-5b1d-aec7-79fa0abe0f88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\sinh (3x^{2}) + C" :db/id #edb/ref 17592186492175} :answer-field/id #uuid "e1ecbc49-9055-53f1-bb80-6d44cd9721e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492189}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d3573d29-cf99-5aea-9d53-ca98353732e6" :question/problem "Calculate $\\int x\\cosh (3x^{2})dx$." :question/worked-solution "Let $u=3x^2$. Differentiating gives $\\mathrm{d}u=6x\\,\\mathrm{d}x$, so $x\\,\\mathrm{d}x=\\frac{1}{6}\\mathrm{d}u$.\n\nUsing this substitution,\n\n$$\\begin{aligned}\n\\int x\\cosh(3x^2)\\,\\mathrm{d}x\n&=\\frac{1}{6}\\int\\cosh u\\,\\mathrm{d}u \\\\\n&=\\frac{1}{6}\\sinh u+C \\\\\n&=\\frac{1}{6}\\sinh(3x^2)+C.\n\\end{aligned}$$\n\nThis antiderivative is defined for every real $x$."} {:db/id #edb/ref 17592186492188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef51396-68be-5b55-960f-bb1efbc5e38a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{3} - 1}{2e^{3} + 1}" :db/id #edb/ref 17592186492138} {:answer/id #uuid "53c49835-a6a0-51c7-a71a-07b6a549269d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1 - 2e^{3}}{e^{6} + 1}" :db/id #edb/ref 17592186492147} {:answer/id #uuid "a18cdbe1-f0ff-535c-88d0-28e57dd11492" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{3} + 1}{e^{3} - 1}" :db/id #edb/ref 17592186492166} {:answer/id #uuid "ac68bc73-c3d9-5413-a5f1-3afed5e0f6e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{6} - 1}{e^{6} + 1}" :db/id #edb/ref 17592186492171} {:answer/id #uuid "ec2075d7-56d8-52d6-bd8a-f405ee531891" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{6} + 1}{e^{6} - 1}" :db/id #edb/ref 17592186492194}] :answer-field/correct {:answer/id #uuid "ac68bc73-c3d9-5413-a5f1-3afed5e0f6e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{6} - 1}{e^{6} + 1}" :db/id #edb/ref 17592186492171} :answer-field/id #uuid "87ba9fa8-5480-5364-9fb1-1a732b1db901" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492164}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e0ed925f-25a7-5e7d-a671-aaedf814fbfd" :question/problem "Evaluate the integral $\\displaystyle \\int_{1}^{e^{3}}\\frac{1}{x}\\operatorname{sech}^{2} (\\ln x)dx$." :question/worked-solution "Let $u=\\ln x$. Differentiating gives $\\mathrm{d}u=\\frac{1}{x}\\mathrm{d}x$.\n\nThe limits change from $x=1$ to $u=0$, and from $x=e^{3}$ to $u=3$. Therefore,\n\n$$\\begin{aligned}\n\\int_1^{e^{3}}\\frac{\\operatorname{sech}^2(\\ln x)}{x}\\,\\mathrm{d}x\n&=\\int_0^{3}\\operatorname{sech}^2 u\\,\\mathrm{d}u \\\\\n&=\\left[\\tanh u\\right]_0^{3} \\\\\n&=\\tanh 3-\\tanh 0 \\\\\n&=\\frac{e^{6}-1}{e^{6}+1}.\n\\end{aligned}$$\n\nThe original interval has $x>0$, so $\\ln x$ and the substitution are defined throughout."} {:db/id #edb/ref 17592186492190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7cc7ff5d-58f0-5cde-