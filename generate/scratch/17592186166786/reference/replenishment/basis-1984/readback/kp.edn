2e^{2}}{e^{4} + 1}" :db/id #edb/ref 17592186492183} {:answer/id #uuid "fe81a5e7-9812-5081-81fe-ba84609fa6f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2} - 1}{2e^{2} + 1}" :db/id #edb/ref 17592186492200}] :answer-field/correct {:answer/id #uuid "059c2d89-8139-51ef-93ba-46d02ef4da49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{4} - 1}{e^{4} + 1}" :db/id #edb/ref 17592186492133} :answer-field/id #uuid "baf7dc1a-adbf-54ec-af73-e4ccf4c26050" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492177}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "03ae71cb-e58f-55a0-9871-9f2696aa7962" :question/problem "Evaluate the integral $\\displaystyle \\int_{1}^{e^{2}}\\frac{1}{x}\\operatorname{sech}^{2} (\\ln x)dx$." :question/worked-solution "Let $u=\\ln x$. Differentiating gives $\\mathrm{d}u=\\frac{1}{x}\\mathrm{d}x$.\n\nThe limits change from $x=1$ to $u=0$, and from $x=e^{2}$ to $u=2$. Therefore,\n\n$$\\begin{aligned}\n\\int_1^{e^{2}}\\frac{\\operatorname{sech}^2(\\ln x)}{x}\\,\\mathrm{d}x\n&=\\int_0^{2}\\operatorname{sech}^2 u\\,\\mathrm{d}u \\\\\n&=\\left[\\tanh u\\right]_0^{2} \\\\\n&=\\tanh 2-\\tanh 0 \\\\\n&=\\frac{e^{4}-1}{e^{4}+1}.\n\\end{aligned}$$\n\nThe original interval has $x>0$, so $\\ln x$ and the substitution are defined throughout."} {:db/id #edb/ref 17592186492145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb9c8e3-a64b-5439-885f-77f160027227" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{8} - 1}{e^{8} + 1}" :db/id #edb/ref 17592186492139} {:answer/id #uuid "30a56fcf-1479-5a84-b852-0eddf079b539" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{8} + 1}{e^{8} - 1}" :db/id #edb/ref 17592186492140} {:answer/id #uuid "863a4bf0-ff62-5d59-ae40-804ed970ccb9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1 - 2e^{4}}{e^{8} + 1}" :db/id #edb/re