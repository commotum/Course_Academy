ident :answer.type/math} :answer/value "\\frac{e^{5} - 1}{2e^{5} + 1}" :db/id #edb/ref 17592186492169} {:answer/id #uuid "b0ab5585-7505-53ef-b4f0-8e4fdb37a50e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{5} + 1}{e^{5} - 1}" :db/id #edb/ref 17592186492172} {:answer/id #uuid "f478b4c4-e9d2-54fb-8b28-e12bbf09c0a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{10} - 1}{e^{10} + 1}" :db/id #edb/ref 17592186492195} {:answer/id #uuid "f5e8761b-92fe-5230-b80b-862a5631a95f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{10} + 1}{e^{10} - 1}" :db/id #edb/ref 17592186492197}] :answer-field/correct {:answer/id #uuid "f478b4c4-e9d2-54fb-8b28-e12bbf09c0a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{10} - 1}{e^{10} + 1}" :db/id #edb/ref 17592186492195} :answer-field/id #uuid "b1d3a7e3-afb0-5141-bcd3-d627016f4874" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492173}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7ffb8716-eb63-5639-896c-4dc3df24fd5d" :question/problem "Evaluate the integral $\\displaystyle \\int_{1}^{e^{5}}\\frac{1}{x}\\operatorname{sech}^{2} (\\ln x)dx$." :question/worked-solution "Let $u=\\ln x$. Differentiating gives $\\mathrm{d}u=\\frac{1}{x}\\mathrm{d}x$.\n\nThe limits change from $x=1$ to $u=0$, and from $x=e^{5}$ to $u=5$. Therefore,\n\n$$\\begin{aligned}\n\\int_1^{e^{5}}\\frac{\\operatorname{sech}^2(\\ln x)}{x}\\,\\mathrm{d}x\n&=\\int_0^{5}\\operatorname{sech}^2 u\\,\\mathrm{d}u \\\\\n&=\\left[\\tanh u\\right]_0^{5} \\\\\n&=\\tanh 5-\\tanh 0 \\\\\n&=\\frac{e^{10}-1}{e^{10}+1}.\n\\end{aligned}$$\n\nThe original interval has $x>0$, so $\\ln x$ and the substitution are defined throughout."} {:db/id #edb/ref 17592186492161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a2b54c1-dadc-5eb4-8bc1-529904269fa5" :answer/type {:db/ident :answer.type/math} :a