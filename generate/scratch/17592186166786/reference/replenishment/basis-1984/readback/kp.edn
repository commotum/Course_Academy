answer.type/math} :answer/value "-\\frac{1}{2}\\sinh (x^{2}) + C" :db/id #edb/ref 17592186492141} {:answer/id #uuid "382a764a-ddfb-5fb7-9def-0ff40ca7c199" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sinh (x^{2}) + C" :db/id #edb/ref 17592186492143} {:answer/id #uuid "544ff240-bc47-5591-b393-9008a0d0fb07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sinh (14x^{2}) + C" :db/id #edb/ref 17592186492148} {:answer/id #uuid "dfe8f39a-4b32-5c7c-a9bc-e3865fab3ef5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{14}\\sinh (7x^{2}) + C" :db/id #edb/ref 17592186492187} {:answer/id #uuid "e6fea7ff-a2d7-5aa2-a685-dfe32fdd168f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}\\sinh (7x^{2}) + C" :db/id #edb/ref 17592186492191}] :answer-field/correct {:answer/id #uuid "e6fea7ff-a2d7-5aa2-a685-dfe32fdd168f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{14}\\sinh (7x^{2}) + C" :db/id #edb/ref 17592186492191} :answer-field/id #uuid "f48a2f6d-9c34-565f-936f-66db7bb30b9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186492196}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "eb00b4d8-60fc-52ce-9ab6-555418c95be5" :question/problem "Calculate $\\int x\\cosh (7x^{2})dx$." :question/worked-solution "Let $u=7x^2$. Differentiating gives $\\mathrm{d}u=14x\\,\\mathrm{d}x$, so $x\\,\\mathrm{d}x=\\frac{1}{14}\\mathrm{d}u$.\n\nUsing this substitution,\n\n$$\\begin{aligned}\n\\int x\\cosh(7x^2)\\,\\mathrm{d}x\n&=\\frac{1}{14}\\int\\cosh u\\,\\mathrm{d}u \\\\\n&=\\frac{1}{14}\\sinh u+C \\\\\n&=\\frac{1}{14}\\sinh(7x^2)+C.\n\\end{aligned}$$\n\nThis antiderivative is defined for every real $x$."}] :knowledge-point/title "Integrating Products Containing Hyperbolic Functions Using Substitution"}]}
