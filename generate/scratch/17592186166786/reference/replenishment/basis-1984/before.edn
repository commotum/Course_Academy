{:db/id 17592186166786 :knowledge-point/canonical-example {:db/id 17592186166624 :question/id #uuid "adec9fbb-c33d-5557-b1cd-dfd42d6c594d" :question/math-academy-id "e-8407" :question/problem "Evaluate the integral\n$\\displaystyle \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} {\\displaystyle \\int_{-2}^{2} x^2\\sinh{x^3}}\\, \\textrm{d}x$." :question/worked-solution "Let $u=x^3$. Differentiating, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=3x^2\\quad\\Longrightarrow\\quad \\dfrac{1}{3}\\textrm{d} u = x^2\\, \\textrm d x\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u$.\n$\\begin{bmatrix}x & -2 & 2 \\\\ u & -8 & 8\\end{bmatrix}$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\int_{-2}^{2} x^2\\sinh{x^3}\\, \\textrm{d}x &=\\int_{-2}^{2} \\sinh{x^3}\\cdot x^2\\,\\textrm{d}x \\\\[5pt] &=\\int_{-8}^{8} \\sinh{u}\\cdot\\dfrac{1}{3}\\, \\textrm{d}u \\\\[5pt] &=\\left.\\dfrac{1}{3}\\cosh u\\Big\\right|_{-8}^{8} \\\\[5pt] &=\\dfrac{1}{3}\\left(\\cosh{8} - \\cosh{(-8)}\\right) \\\\[5pt] &=\\dfrac{1}{3}\\left(\\cosh{8} - \\cosh{8}\\right) \\\\[5pt] &=\\dfrac{1}{3}\\cdot 0 \\\\[5pt] &=0 \\end{aligned}\n$$"} :knowledge-point/id #uuid "947ecbc7-e09a-58b6-916d-a2562a1e794a" :knowledge-point/key-prerequisites [{:db/id 17592186049713 :topic/math-academy-id 1362 :topic/title "Differentiating Hyperbolic Functions"}] :knowledge-point/questions [{:db/id 17592186167384 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91492421-4e01-5746-b0f8-1d9e6810c2a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sinh (x^{2}) + C" :db/id 17592186165513} {:answer/id #uuid "9a85bf73-4ea9-5b6f-890d-b9b888e13dcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\sinh (2x^{2}) + C" :db/id 17592186165514} {:answer/id #uuid "ccd1e07e-8080-5758-ae18-442b44314a3c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\sinh (2x^{2}) + C" :db/id 17592186165515} {:answer/id #uuid "2843d3bd-59e1-5c05-be99-50316de0ad0d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\sinh (x^{2}) + C" :db/id 17592186165516} {:answer/id #uuid "47b9e4e1-6df1-54a4-b59e-36da8f0d3bef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sinh (4x^{2}) + C" :db/id 17592186165517}] :answer-field/id #uuid "f91f8f8f-2b58-5bb5-ad72-8607b411262c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186165512}] :question/id #uuid "ee28a08c-e134-5d5e-b82d-9846325c8068" :question/math-academy-id "q-95537" :question/problem "Calculate $\\intx\\cosh (2x^{2})dx$."} {:db/id 17592186167385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1421ab6-995f-5597-a20e-0bf5221365c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1 - 2e}{e^{2} + 1}" :db/id 17592186165519} {:answer/id #uuid "d31c2109-bfcf-5f3c-910c-c1a7bfa1df0b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e - 1}{2e + 1}" :db/id 17592186165520} {:answer/id #uuid "f3056d0d-781c-5d97-ac03-49998e67b94e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e + 1}{e - 1}" :db/id 17592186165521} {:answer/id #uuid "40dfd0b3-feb1-5586-bc24-e30599605bb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2} - 1}{e^{2} + 1}" :db/id 17592186165522} {:answer/id #uuid "56dff616-730d-567b-9fa9-46b22f45f615" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{2} + 1}{e^{2} - 1}" :db/id 17592186165523}] :answer-field/id #uuid "522afb7c-b985-5717-b84c-5707c54341af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186165518}] :question/id #uuid "ac12edad-2456-53fc-b811-022c19232897" :question/math-academy-id "q-95543" :question/problem "Evaluate the integral $\\displaystyle \\int_{1}^{e}\\frac{1}{x}sech^{2} (\\ln x)dx$."}] :knowledge-point/title "Integrating Products Containing Hyperbolic Functions Using Substitution"}
