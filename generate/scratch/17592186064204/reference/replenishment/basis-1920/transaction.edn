}\\cdot (-1) \\\\  & =4(3-x)^{-5} \\\\  & =\\frac{4}{(3-x)^{5}}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["f44b9ca1-9b1d-5e25-9550-150b2f5c324d"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "4bf71c35-44e4-5b7f-8aec-4d660a7b2f75" :question-generator/script "generate/scratch/17592186064204.py"} [:db/add 17592186064204 :knowledge-point/question-generator "generator"] {:db/id 17592186064204 :knowledge-point/questions ["b8425667-976e-5474-9182-8785229638c8" "beed05dd-1df0-5509-b310-7367b8962226"]} [:db/ensure 17592186064204 :knowledge-point/validate]]
