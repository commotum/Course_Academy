wer.type/text} :answer/value "true" :db/id #edb/ref 17592186439778}] :answer-field/correct {:answer/id #uuid "d14b44f4-3d4a-5cb3-910a-55d6269fe2a7" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439777} :answer-field/id #uuid "b0c9f803-913c-53b9-89d7-27213f39508d" :answer-field/key "C" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440246}] :question/id #uuid "bfa79719-c636-549a-8b52-62d1b8be1bcf" :question/math-academy-id "q-44504" :question/problem "![](images/20/20e05c0af32d6fe2643af2912d51ef1b3994374260ffaa4fc22002def474c15f.png)\n\nIdentify the points on the graph that lie on the line $y = 8x - 3$.\n\nSelect all that apply." :question/worked-solution "A=(-6,5), B=(1,5), C=(6,5). Only B satisfies y=8x-3."} {:db/id #edb/ref 17592186490232 :knowledge-point/_questions [{:knowledge-point/id #uuid "3123f8ed-a1ca-52b7-8427-2f3b60d9e68a" :knowledge-point/title "Identifying Points That Lie on a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f20f4e-40c9-5a9d-8129-6ea89406c9b3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186489592} {:answer/id #uuid "2e314e93-a74f-58a2-8a61-c6709c1e6a05" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186489617} {:answer/id #uuid "2e61ea38-9adb-5df3-9e77-c49b744c8375" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186489618} {:answer/id #uuid "c8cdeb7e-9f2c-5249-a813-a2de4fe3188f" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186489951} {:answer/id #uuid "d311c0e5-165f-5e28-b3c6-245a633be859" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186489981}] :answer-field/correct {:answer/id #uuid "2e314e93-a74f-58a2-8a61-c6709c1e6a05" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186489617} :answer-field/id #uuid "73f7dd8a-46cc-50f8-8f6c-5dc06aa45a32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490141}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3250f349-fbfe-56f8-96e2-52cb212003b3" :question/math-academy-id "q-102142" :question/problem "![](images/7d/7dad50d17444096c60b129131104209b8b7371d546f80d7b0c838baec1df8b4d.png)\n\nWhich of the given points lie on the line $y=-5x+6?$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(0,5),B(1,2)$ and $C(2,-4).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(0,5)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-5x+6 \\\\ (5) & =-5(0)+6 \\\\ 5 & =6\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $A$ does *not* lie on the line.\n\n- Substituting the point $B(1,2)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =-5x+6 \\\\ (2) & =-5(1)+6 \\\\ 2 & =1\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(2,-4)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =-5x+6 \\\\ (-4) & =-5(2)+6 \\\\ -4 & =-4\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only point $C$ lies on the line."} {:db/id #edb/ref 17592186490291 :knowledge-point/_questions [{:knowledge-point/id #uuid "3123f8ed-a1ca-52b7-8427-2f3b60d9e68a" :knowledge-point/title "Identifying Points That Lie on a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4f3252-d422-5b2b-87b7-6916c51a12a0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186489550} {:answer/id #uuid "38679d57-742c-5817-a31c-101bf33ca332" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186489640} {:answer/id #uuid "685aeab1-eebd-534e-8e4a-d21630e148b9" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186489763} {:answer/id #uuid "a111be60-4cf1-5eab-b12f-bf275dc291fc" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186489871} {:answer/id #uuid "f9fd167a-76c2-572d-ac6f-8214ea48c14a" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186490058}] :answer-field/correct {:answer/id #uuid "0f4f3252-d422-5b2b-87b7-6916c51a12a0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186489550} :answer-field/id #uuid "29e6c0ec-30d3-5bc5-89e9-08b3f00c0259" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490093}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "acf0d12e-cf58-5db7-b66f-2999c47f2d4e" :question/math-academy-id "q-71829" :question/problem "![](images/c3/c33968d9b5c86e39ba35c88a5f28bb8950178004c763a5c011633b9a060e98a8.png)\n\nIdentify the points that lie on the line $y=4x+2.$" :question/worked-solution "The plotted points correspond to the $xy$-pairs $A(-1,-2)$, $B(0,1)$ and $C(1,6).$\n\nTo check whether a point lies on the line, we substitute the coordinates of the point into the equation and determine whether the resulting statement is true.\n\n- Substituting the point $A(-1,-2)$ results in a true statement:\n\n$$\n\\begin{aligned}y & =4x+2 \\\\ (-2) & =4(-1)+2 \\\\ -2 & =-2\\,✓\\end{aligned}\n$$\n\nTherefore, the point $A$ does lie on the line.\n\n- Substituting the point $B(0,1)$ results in a false statement:\n\n$$\n\\begin{aligned}y & =4x+2 \\\\ (1) & =4(0)+2 \\\\ 1 & =2\\,\\times \\end{aligned}\n$$\n\nTherefore, the point $B$ does not lie on the line.\n\n- Substituting the point $C(1,6)$ results in true statement:\n\n$$\n\\begin{aligned}y & =4x+2 \\\\ (6) & =4(1)+2 \\\\ 6 & =6\\,✓\\end{aligned}\n$$\n\nTherefore, the point $C$ does lie on the line.\n\nFinally, only points $A$ and $C$ lie on the line."}] :knowledge-point/title "Identifying Points That Lie on a Line"}]}
