-be15-5117-89a8-9b785af2738a" :question/math-academy-id "q-22405" :question/problem "![](images/c6/c63af2b4cd9209077baee74e5f4f4059bc1c8c7e4b2cdc620c872d025fe5a4e9.png)\n\nIdentify the points that lie on the line $y = x + 1$.\n\nSelect all that apply." :question/worked-solution "The plotted points are A=(2,7), B=(4,5), C=(7,2). Only B satisfies y=x+1."} {:db/id #edb/ref 17592186055296 :knowledge-point/_questions [{:knowledge-point/id #uuid "3123f8ed-a1ca-52b7-8427-2f3b60d9e68a" :knowledge-point/title "Identifying Points That Lie on a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce9210e-8c33-56d3-a143-b8194c6e7d2c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439773} {:answer/id #uuid "15d84877-db47-53cc-adf7-15e463488793" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439774}] :answer-field/correct {:answer/id #uuid "1ce9210e-8c33-56d3-a143-b8194c6e7d2c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439773} :answer-field/id #uuid "99529b71-fb0d-5b9b-adec-1b9531669fa6" :answer-field/key "A" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440244} {:answer-field/choices [{:answer/id #uuid "6b1d3092-75b5-5c45-bb6e-b7fe0a349b7f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439775} {:answer/id #uuid "e8bd57e5-7e8e-551a-ba0e-d12a020c81be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439776}] :answer-field/correct {:answer/id #uuid "e8bd57e5-7e8e-551a-ba0e-d12a020c81be" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439776} :answer-field/id #uuid "f0fe034c-e5e1-5872-82ba-0cd1c7e50825" :answer-field/key "B" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440245} {:answer-field/choices [{:answer/id #uuid "d14b44f4-3d4a-5cb3-