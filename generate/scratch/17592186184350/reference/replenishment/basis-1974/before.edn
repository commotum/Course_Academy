^{4{x}^{2}-3}\\,\\text{d}x & =4\\int {4}^{4{x}^{2}-3}\\cdot x\\,\\text{d}x \\\\  & =4\\int {4}^{u}\\cdot \\frac{1}{8}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{{4}^{u}}{2\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{4{x}^{2}-3}}{2\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$"} {:db/id 17592186342085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44e44bb8-c154-53e8-a511-57d84dae10f6" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}}{6}+C" :db/id 17592186339739} {:answer/id #uuid "a32f3101-bc9b-57c3-a094-68929983f9ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C" :db/id 17592186340607} {:answer/id #uuid "a81c8c34-1552-582a-811d-a1514ffd778a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}\\operatorname{ln}⁡6}{3}+C" :db/id 17592186340653} {:answer/id #uuid "d5de34d6-565f-582f-8f9b-77b59f891653" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{{x}^{2}+1}+C" :db/id 17592186341022} {:answer/id #uuid "ed24b164-7ced-54c2-88e8-5774ba6fa797" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{6}^{{x}^{2}+1}\\operatorname{ln}⁡3+C" :db/id 17592186341220}] :answer-field/correct {:answer/id #uuid "a32f3101-bc9b-57c3-a094-68929983f9ba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C" :db/id 17592186340607} :answer-field/id #uuid "7d2b52af-df96-5841-9a6f-c75d274f62bf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186341599}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a36ba9a8-67c3-5fc7-baaa-4765eb971f95" :question/math-academy-id "q-73801" :question/problem "Calculate the integral $\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={x}^{2}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x & =\\int {6}^{{x}^{2}+1}\\cdot 2x\\,\\text{d}x \\\\  & =\\int {6}^{u}\\cdot \\,\\text{d}u \\\\  & =\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C.\\end{aligned}\n$$"} {:db/id 17592186342086 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a820745-fb0e-5679-b09e-f71dc31ac02a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\cdot {7}^{{x}^{2}-7}}{\\operatorname{ln}⁡7}+C" :db/id 17592186339950} {:answer/id #uuid "7fe72d04-d6a6-5411-990c-4da6836f38f5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C" :db/id 17592186340278} {:answer/id #uuid "b52e44f1-74c6-506f-ab6c-8cfe82910425" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}\\operatorname{ln}⁡7}{2}+C" :db/id 17592186340770} {:answer/id #uuid "bffaf345-ce46-5b75-9f16-7441a4de004a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}}{2}+C" :db/id 17592186340843} {:answer/id #uuid "da447b58-addd-5846-8570-a5a39fd42ee5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{7}^{{x}^{2}-7}+C" :db/id 17592186341066}] :answer-field/correct {:answer/id #uuid "7fe72d04-d6a6-5411-990c-4da6836f38f5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C" :db/id 17592186340278} :answer-field/id #uuid "a80209d1-f637-5f60-b158-7892c3b85b26" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} 