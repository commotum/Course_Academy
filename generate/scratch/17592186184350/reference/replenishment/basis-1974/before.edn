{:db/id 17592186184350 :knowledge-point/canonical-example {:db/id 17592186183946 :question/id #uuid "ab4772a2-f980-5ad7-a377-34e34b95be83" :question/math-academy-id "e-14403" :question/problem "Calculate  $\\displaystyle \\int x^3\\,{3^{1-x^4}} \\, \\textrm{d}x.$" :question/worked-solution "Let's introduce the new variable $u= 1-x^4.$ Differentiating gives \n\n$$\n\\dfrac{ \\textrm{d}u}{ \\textrm{d}x} = -4x^3\\quad\\Longrightarrow\\quad x^3 \\, \\textrm{d}x = -\\dfrac{1}{4} \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\\int {x^3\\,{3^{1-x^4}} }\\, \\textrm{d}x \n&=\\int {{3^{1-x^4}}\\cdot x^3 }\\, \\textrm{d}x \\[5pt]\n&=  \\int {3^{u}} \\cdot \\left(-\\dfrac{1}{4}\\right) \\textrm{d}u\\[5pt]\n                                                     &= -\\dfrac{1}{4}\\int {3^{u}}  \\textrm{d}u\\[5pt]\n                                                     &=  -\\dfrac{1}{4}\\cdot\\dfrac{3^{u}}{\\ln 3} + C\\[5pt]\n                                                     &=   -\\dfrac{3^{1-x^4}}{4\\ln 3}+ C.\n}\n$$"} :knowledge-point/id #uuid "e8720b44-317d-590e-a251-bfcec97e0513" :knowledge-point/questions [{:db/id 17592186184746 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82507a0e-9640-5f91-baac-ab6e9c5da3e1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3x}}{2\\operatorname{ln}⁡8}+C" :db/id 17592186295968} {:answer/id #uuid "90098dd5-289f-547e-b363-0c0f0a9af66e" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{\\operatorname{ln}⁡8}+C" :db/id 17592186296038} {:answer/id #uuid "b0881961-d42a-52bd-baff-db91f2644d0f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{8}^{3{x}^{2}}}{3\\operatorname{ln}⁡8}+C" :db/id 17592186296198} {:answer/id #uuid "bd10d05c-0dcf-50d3-bed0-8065b29b1c8a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C" :