:answer/id #uuid "9b48c261-f211-55b8-86ce-65dbc47a6b39" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C" :db/id 17592186289073} :answer-field/id #uuid "cfc2fad4-566e-5ad0-af33-b685357811ca" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186290183}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75248609-ed60-597e-bc9d-cd586fbf6b38" :question/math-academy-id "q-211989" :question/problem "Calculate the integral $\\int {x}^{2}{4}^{{x}^{3}/5}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u=\\frac{{x}^{3}}{5}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{5}{x}^{2}\\,⟹\\,\\frac{5}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {x}^{2}{4}^{{x}^{3}/5}\\,\\text{d}x & =\\int {4}^{{x}^{3}/5}\\cdot {x}^{2}\\,\\text{d}x \\\\  & =\\int {4}^{u}\\cdot \\frac{5}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{5\\cdot {4}^{u}}{3\\operatorname{ln}⁡4}+C \\\\  & =\\frac{5\\cdot {4}^{{x}^{3}/5}}{3\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$"} {:db/id 17592186297397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "057e7928-c32f-5f0e-b954-8c6430e1e8a5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x-7}}{\\operatorname{ln}⁡4}+C" :db/id 17592186295291} {:answer/id #uuid "156c7585-0e2b-5c0b-a8c0-28e3ea36cf59" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{2\\operatorname{ln}⁡4}+C" :db/id 17592186295392} {:answer/id #uuid "1cb5b38c-ddae-51cd-8c03-e4ec4201cdbb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{{x}^{2}-7}}{\\operatorname{ln}⁡4}+C" :db/id 17592186295432} {:answer/id #uuid "522139ab-1225-59a8