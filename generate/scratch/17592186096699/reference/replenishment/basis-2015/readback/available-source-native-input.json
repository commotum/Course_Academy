        ":question/problem": "Find the particular solution to the differential equation $(x-3)^{2}{y}^{\u2032}=8$ that satisfies the condition $y(4)=1.$\n\n$y=\\,${{field-1}}",
        ":question/answer-fields": [
          {
            ":answer-field/id": "d45b27c8-de36-51c0-945f-12e10ef086ce",
