#{[{:db/id #edb/ref 17592186096699 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096499 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/id #uuid "29a0265e-ad88-5ac9-88fe-878aa4f0d0bf" :question/math-academy-id "e-531" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $f(0)=2.$\n\n$$\nf'(x) - \\dfrac{3}{1+x^2} = 0\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\nf'(x) = \\dfrac{3}{1+x^2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{1+{x}^{2}}\\,\\text{d}x \\\\ f(x) & =3\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =3\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x) = 3\\arctan{x} + C.$ To find a particular solution, we substitute the condition $f(0) = 2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}f(x) & =3\\operatorname{arctan}⁡(x)+C \\\\ 2 & =3\\operatorname{arctan}⁡(0)+C \\\\ 2 & =0+C \\\\ C & =2.\\end{aligned}\n$$\n\nTherefore, our particular solution is \n\n$$\nf(x)=3\\arctan x + 2.\n$$"} :knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/question-generator {:db/id #edb/ref 17592186496591 :question-generator/id #uuid "c9ab006e-829e-509e-95cb-1bb343106a60" :question-generator/script "generate/scratch/17592186096699.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097020 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2cdeff7-1bd1-52cc-b4d2-58765a1e715e" :answer/type {:db/ident :answer.type/math} :answer/value "y = - (1)/(2(x - 1)) + \\frac{3}{2}" :db/id #edb/ref 17592186094094} {:answer/id #uuid "e264582e-6aa3-5da8-b05d-657aca25a556" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{1}{x - 1} + \\frac{1}{2}" :db/id #edb/ref 17592186094095} {:answer/id #uuid "43d2def0-e7d1-54fb-834f-84b6876ea10b" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{x - 1} - 1" :db/id #edb/ref 17592186094096} {:answer/id #uuid "518e0850-647a-5199-8686-13cfd746ca8f" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{1}{x - 1}" :db/id #edb/ref 17592186094097} {:answer/id #uuid "6fc7592f-e41a-5c1f-9369-d6bc76a6ea98" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{x - 1} + 3" :db/id #edb/ref 17592186094098}] :answer-field/id #uuid "9dd411f0-cb37-5900-866e-8862a9b0a1e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094093}] :question/id #uuid "d93ad997-2d1a-586a-bd5a-d470614a6ec6" :question/math-academy-id "q-119078" :question/problem "Find the particular solution to the differential equation $(x - 1)^{2}y^{′} =-2$ that satisfies the condition $y(2) = 1$."} {:db/id #edb/ref 17592186097290 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9acd2481-0ec3-5994-9168-964cb3c474c8" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = \\frac{1}{2}e^{x} - 1" :db/id #edb/ref 17592186095665} {:answer/id #uuid "b3631b1e-e008-5fb9-a825-84c8ecba10b9" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = e^{x} - 2" :db/id #edb/ref 17592186095666} {:answer/id #uuid "c508b657-4c25-56c5-960c-217135f76315" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) =-\\frac{1}{2}e^{x} + 1" :db/id #edb/ref 17592186095667} {:answer/id #uuid "f83fba29-574c-5d24-b1a6-4adbe9283fcb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) = \\frac{1}{2}(e^{x} - 3)" :db/id #edb/ref 17592186095668} {:answer/id #uuid "38b83252-dae4-5abd-841f-1818a0da90fc" :answer/type {:db/ident :answer.type/math} :answer/value "f(x) =-\\frac{1}{2}(e^{x} + 1)" :db/id #edb/ref 17592186095669}] :answer-field/id #uuid "62dcfac4-1b46-5254-bc04-921bedd65cbf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095664}] :question/id #uuid "36f54028-9879-56b6-bec9-c97cd80fb58e" :question/math-academy-id "q-49942" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $f(0) =-1$.\n\n$2f^{′}(x) + e^{x} = 0$."} {:db/id #edb/ref 17592186253539 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42ecc69b-755b-5462-8126-6d18390bc9cd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-2\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186251113} {:answer/id #uuid "51d0ffb6-6f64-5896-abdf-17cb6f16197d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2\\operatorname{cos}⁡x-3" :db/id #edb/ref 17592186251222} {:answer/id #uuid "b403e123-9b40-51a1-b551-d4ee97aeac63" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{1}{2}\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186252131} {:answer/id #uuid "bcae2f92-0655-5e91-b689-f83acfb52de0" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2\\operatorname{sin}⁡x-3" :db/id #edb/ref 17592186252218} {:answer/id #uuid "ec6281fe-2594-5ca0-8ac1-0635fb6762ac" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-2\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186252623}] :answer-field/correct {:answer/id #uuid "42ecc69b-755b-5462-8126-6d18390bc9cd" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=-2\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186251113} :answer-field/id #uuid "5e18fea8-a6e5-5302-8876-2d446746feb0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8dd37419-0acf-5e07-951f-998d06a1d1c6" :question/math-academy-id "q-119045" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)+2\\operatorname{cos}⁡x=0$ that satisfies the condition $f(0)=-1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=-2\\operatorname{cos}⁡x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (-2\\operatorname{cos}⁡x)\\,\\text{d}x \\\\ f(x) & =-2\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-2\\operatorname{sin}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-2\\operatorname{sin}⁡x+C.$ To find a particular solution, we substitute the condition $f(0)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =-2\\operatorname{sin}⁡0+C \\\\ -1 & =-2(0)+C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=-2\\operatorname{sin}⁡x-1.\n$$"} {:db/id #edb/ref 17592186253540 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0877a493-110b-5bc5-b8f0-b95a212d57cb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}+x-4" :db/id #edb/ref 17592186250624} {:answer/id #uuid "404b89d5-fb90-54b3-9fd1-b0ed48ad3aca" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)={x}^{2}-2x" :db/id #edb/ref 17592186251087} {:answer/id #uuid "7d24a901-b539-53de-9ab1-410020de269d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)={x}^{2}+2x-4" :db/id #edb/ref 17592186251597} {:answer/id #uuid "b2cb0cc0-4925-5d83-a3b2-07b01eb84c1d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}+3x-6" :db/id #edb/ref 17592186252117} {:answer/id #uuid "c233f23d-d374-5888-ae7d-c2e80f985c8b" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}+x-1" :db/id #edb/ref 17592186252267}] :answer-field/correct {:answer/id #uuid "0877a493-110b-5bc5-b8f0-b95a212d57cb" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}+x-4" :db/id #edb/ref 17592186250624} :answer-field/id #uuid "cb5f0d15-ef01-5c2b-8b45-e12411c1710b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70e058ec-5742-5754-884d-951409c47fdc" :question/math-academy-id "q-119046" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)-4x=1$ that satisfies the condition $f(1)=-1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=4x+1.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (4x+1)\\,\\text{d}x \\\\ f(x) & =4\\int x\\,\\text{d}x+\\int \\text{d}x \\\\  & =4(\\frac{1}{2}{x}^{2})+x+C \\\\  & =2{x}^{2}+x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=2{x}^{2}+x+C.$ To find a particular solution, we substitute the condition $f(1)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =2(1)^{2}+1+C \\\\ -1 & =2+1+C \\\\ C & =-4.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=2{x}^{2}+x-4.\n$$"} {:db/id #edb/ref 17592186253544 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "063d885c-e465-53c3-8fc9-1185c7d2a24c" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{x}^{2}-2{e}^{-2x}+3" :db/id #edb/ref 17592186250604} {:answer/id #uuid "2352b722-ccc2-5fb7-b992-99d02c98a38b" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{x}^{2}+2{e}^{-2x}-1" :db/id #edb/ref 17592186250855} {:answer/id #uuid "4927258a-3e5d-57d8-ad17-4093de1cc583" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}" :db/id #edb/ref 17592186251163} {:answer/id #uuid "7cf4bda2-85a0-506d-86cb-55bb6ebcdb9d" :answer/type {:db/ident :answer.type/math} :answer/value "y=4{x}^{2}+\\frac{{e}^{-2x}}{2}-\\frac{3}{2}" :db/id #edb/ref 17592186251595} {:answer/id #uuid "febdfee4-02c6-55f5-970a-792e4ad18364" :answer/type {:db/ident :answer.type/math} :answer/value "y=4{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}" :db/id #edb/ref 17592186252790}] :answer-field/correct {:answer/id #uuid "febdfee4-02c6-55f5-970a-792e4ad18364" :answer/type {:db/ident :answer.type/math} :answer/value "y=4{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}" :db/id #edb/ref 17592186252790} :answer-field/id #uuid "4a412b91-1bde-571f-aacb-eb83ca3e461a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252937}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea7f0932-1ce6-52df-a5dc-f1855b5f815e" :question/math-academy-id "q-119075" :question/problem "Find the particular solution to the differential equation ${y}^{′}+{e}^{-2x}=8x$ that satisfies the condition $y(0)=1.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=8x-{e}^{-2x}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (8x-{e}^{-2x})\\,\\text{d}x \\\\ y & =8\\int x\\,\\text{d}x-\\int {e}^{-2x}\\,\\text{d}x \\\\  & =8(\\frac{{x}^{2}}{2})-(-\\frac{{e}^{-2x}}{2})+C \\\\  & =4{x}^{2}+\\frac{{e}^{-2x}}{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=4{x}^{2}+\\frac{{e}^{-2x}}{2}+C.$ To find a particular solution, we substitute the condition $y(0)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}1 & =4(0)^{2}+\\frac{{e}^{-2(0)}}{2}+C \\\\ 1 & =0+\\frac{1}{2}+C \\\\ C & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=4{x}^{2}+\\frac{{e}^{-2x}}{2}+\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186253545 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4861751d-591d-55c3-986e-ef2a5b44047f" :answer/type {:db/ident :answer.type/math} :answer/value "y=x-\\frac{{e}^{x/2}}{2}+\\frac{5}{2}" :db/id #edb/ref 17592186251157} {:answer/id #uuid "66412d8c-05ca-5d19-b457-71e9ce3cbc83" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{2}+2{e}^{x/2}+2" :db/id #edb/ref 17592186251394} {:answer/id #uuid "73dd9002-7420-57dd-aa1f-4e2c936b2b76" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x+{e}^{x/2}+1" :db/id #edb/ref 17592186251508} {:answer/id #uuid "906cd958-b4d4-5e47-8a8a-6773bb3989db" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{2}+2{e}^{x/2}" :db/id #edb/ref 17592186251780} {:answer/id #uuid "f2723fb9-3ffe-529a-aa32-10cf5b96b2dd" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{2}+\\frac{{e}^{x/2}}{2}+\\frac{3}{2}" :db/id #edb/ref 17592186252675}] :answer-field/correct {:answer/id #uuid "906cd958-b4d4-5e47-8a8a-6773bb3989db" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{2}+2{e}^{x/2}" :db/id #edb/ref 17592186251780} :answer-field/id #uuid "b2e489f5-5c3c-511b-8803-0c93ae9edf09" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253116}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5aa7094-d36f-5005-a0c6-3e11c04ef4b9" :question/math-academy-id "q-119083" :question/problem "Find the particular solution to the differential equation ${y}^{′}-2x={e}^{x/2}$ that satisfies the condition $y(0)=2.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=2x+{e}^{x/2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int (2x+{e}^{x/2})\\text{d}x \\\\ y & =2\\int x\\,\\text{d}x+\\int {e}^{x/2}\\,\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{2}}{2}+2{e}^{x/2}+C \\\\  & ={x}^{2}+2{e}^{x/2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y={x}^{2}+2{e}^{x/2}+C.$ To find a particular solution, we substitute the condition $y(0)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}2 & ={0}^{2}+2{e}^{0}+C \\\\ 2 & =0+2(1)+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny={x}^{2}+2{e}^{x/2}.\n$$"} {:db/id #edb/ref 17592186319203 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a99c790f-778d-5a5f-97a8-2b99e8f49b10" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}-\\frac{25}{3}" :db/id #edb/ref 17592186318143}] :answer-field/correct {:answer/id #uuid "a99c790f-778d-5a5f-97a8-2b99e8f49b10" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}-\\frac{25}{3}" :db/id #edb/ref 17592186318143} :answer-field/id #uuid "877e6d0c-39d3-53e7-b2ef-a30f289e7b59" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb49f682-fb8a-5bf1-935c-970f0a98d037" :question/math-academy-id "q-347842" :question/problem "Find the particular solution to the differential equation $8x-\\frac{\\text{d}y}{\\text{d}x}={x}^{2}$ that satisfies the condition $y(2)=5.$\n\n$y=-\\frac{{x}^{3}}{3}\\,+${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-{x}^{2}+8x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-{x}^{2}+8x)\\,\\text{d}x \\\\ y & =-\\frac{{x}^{3}}{3}+8\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =-\\frac{{x}^{3}}{3}+4{x}^{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-\\frac{{x}^{3}}{3}+4{x}^{2}+C.$ To find a particular solution, we substitute the condition $y(2)=5$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =-\\frac{{x}^{3}}{3}+4{x}^{2}+C \\\\ 5 & =-\\frac{{2}^{3}}{3}+4({2}^{2})+C \\\\ 5 & =-\\frac{8}{3}+16+C \\\\ 5 & =\\frac{40}{3}+C \\\\ C & =-\\frac{25}{3}.\\end{aligned}\n$$\n\nTherefore, our particular solution is \n\n$$\ny=-\\frac{{x}^{3}}{3}+4{x}^{2}-\\frac{25}{3}.\n$$"} {:db/id #edb/ref 17592186320948 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "203a3079-ee5c-560e-8635-760c7bf1066a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{x-3}+9" :db/id #edb/ref 17592186319489}] :answer-field/correct {:answer/id #uuid "203a3079-ee5c-560e-8635-760c7bf1066a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{8}{x-3}+9" :db/id #edb/ref 17592186319489} :answer-field/id #uuid "f74970cc-7b2d-58bc-b6f8-f2dd0e1d894a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9bd28782-0820-5dae-86e8-4965e6266454" :question/math-academy-id "q-352066" :question/problem "Find the particular solution to the differential equation $(x-3)^{2}{y}^{′}=8$ that satisfies the condition $y(4)=1.$\n\n$y=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=\\frac{8}{(x-3)^{2}}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int \\frac{8}{(x-3)^{2}}\\,\\text{d}x \\\\ y & =8\\int \\frac{1}{(x-3)^{2}}\\,\\text{d}x \\\\  & =8(-\\frac{1}{x-3})+C \\\\  & =-\\frac{8}{x-3}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=-\\frac{8}{x-3}+C.$ To find a particular solution, we substitute the condition $y(4)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}1 & =-\\frac{8}{4-3}+C \\\\ 1 & =-8+C \\\\ C & =9.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=-\\frac{8}{x-3}+9.\n$$"} {:db/id #edb/ref 17592186320949 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c11b83c6-f179-56e1-8175-cb7b2c642c20" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sqrt{x+1}-6" :db/id #edb/ref 17592186319981}] :answer-field/correct {:answer/id #uuid "c11b83c6-f179-56e1-8175-cb7b2c642c20" :answer/type {:db/ident :answer.type/math} :answer/value "8\\sqrt{x+1}-6" :db/id #edb/ref 17592186319981} :answer-field/id #uuid "320d7bcf-5061-50ea-841d-459ccafe7cbf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320280}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c687828d-8060-5328-a166-293d79967235" :question/math-academy-id "q-352068" :question/problem "Find the particular solution to the differential equation $\\sqrt{x+1}\\,{y}^{′}=4$ that satisfies the condition $y(3)=10.$\n\n$y=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{y}^{′}=\\frac{4}{\\sqrt{x+1}}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {y}^{′}\\,\\text{d}x & =\\int \\frac{4}{\\sqrt{x+1}}\\,\\text{d}x \\\\ y & =4\\int (x+1)^{-1/2}\\,\\text{d}x \\\\  & =4(2(x+1)^{1/2})+C \\\\  & =8\\sqrt{x+1}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=8\\sqrt{x+1}+C.$ To find a particular solution, we substitute the condition $y(3)=10$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}10 & =8\\sqrt{3+1}+C \\\\ 10 & =8(2)+C \\\\ C & =-6.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=8\\sqrt{x+1}-6.\n$$"} {:db/id #edb/ref 17592186320950 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98c0bcef-46b2-545e-843c-328afdee9423" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}x-1" :db/id #edb/ref 17592186319845}] :answer-field/correct {:answer/id #uuid "98c0bcef-46b2-545e-843c-328afdee9423" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}x-1" :db/id #edb/ref 17592186319845} :answer-field/id #uuid "a4fb75ca-ef4f-5f30-adaf-5e38a644e069" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320493}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f433502-a7f8-5681-8b4b-ad43723d3a55" :question/math-academy-id "q-352075" :question/problem "Find the particular solution to the differential equation ${f}^{′}(x)+3\\operatorname{sin}⁡x=0$ that satisfies the condition $f(0)=2.$\n\n$f(x)=\\,${{field-1}}" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=-3\\operatorname{sin}⁡x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (-3\\operatorname{sin}⁡x)\\,\\text{d}x \\\\ f(x) & =-3\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-3(-\\operatorname{cos}⁡x)+C \\\\  & =3\\operatorname{cos}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=3\\operatorname{cos}⁡x+C.$ To find a particular solution, we substitute the condition $f(0)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}2 & =3\\operatorname{cos}⁡0+C \\\\ 2 & =3(1)+C \\\\ C & =-1.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=3\\operatorname{cos}⁡x-1.\n$$"} {:db/id #edb/ref 17592186332796 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c2556ab-42eb-5b03-9b82-ffafb8c7bdf9" :answer/type {:db/ident :answer.type/math} :answer/value "y=6{x}^{3}+8" :db/id #edb/ref 17592186330340} {:answer/id #uuid "340e3d02-facf-523f-89ff-093dd1bcd18f" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2{x}^{2}+4" :db/id #edb/ref 17592186330411} {:answer/id #uuid "aae0e4e4-5033-5e88-827b-62d31ab7b6e4" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{3}+3" :db/id #edb/ref 17592186331464} {:answer/id #uuid "f0f11883-6eaf-55d0-bcf4-0414977256ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=3{x}^{2}-1" :db/id #edb/ref 17592186332068} {:answer/id #uuid "fdcec268-59b1-5bae-be4e-f748d99e9108" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{x}^{3}+4" :db/id #edb/ref 17592186332183}] :answer-field/correct {:answer/id #uuid "fdcec268-59b1-5bae-be4e-f748d99e9108" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{x}^{3}+4" :db/id #edb/ref 17592186332183} :answer-field/id #uuid "9815a89d-855b-59fa-9302-62052d559095" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "860439d5-1eb6-58cf-8abd-cc9242b3ec59" :question/math-academy-id "q-50044" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $y(-1)=2$\n \n\n$$\nx\\cdot \\frac{\\text{d}y}{\\text{d}x}=6{x}^{3}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=6{x}^{2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 6{x}^{2}\\,\\text{d}x \\\\ y & =6(\\frac{{x}^{3}}{3})\\,\\text{d}x \\\\  & =2{x}^{3}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=2{x}^{3}+C.$ To find a particular solution, we substitute the condition $y(-1)=2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =2{x}^{3}+C \\\\ 2 & =2(-1)^{3}+C \\\\ 2 & =-2+C \\\\ C & =4.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=2{x}^{3}+4.\n$$"} {:db/id #edb/ref 17592186332799 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8cac35-ec47-5085-bcb0-da00cb39efe3" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{3}+{x}^{2}-1" :db/id #edb/ref 17592186330181} {:answer/id #uuid "2ecb6c15-4ffb-53a5-a6a3-acd959f971df" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}" :db/id #edb/ref 17592186330360} {:answer/id #uuid "82e52b8f-937b-5b6c-bf07-b2a4477afeb9" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{3}+2{x}^{2}-2" :db/id #edb/ref 17592186331109} {:answer/id #uuid "d1cbd642-0604-55df-9d4b-e311b2299017" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}-{x}^{2}+\\frac{5}{3}" :db/id #edb/ref 17592186331810} {:answer/id #uuid "f83e9e7e-87a9-5751-b17a-60d01d2b92ac" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}+2{x}^{2}-\\frac{4}{3}" :db/id #edb/ref 17592186332131}] :answer-field/correct {:answer/id #uuid "2ecb6c15-4ffb-53a5-a6a3-acd959f971df" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}" :db/id #edb/ref 17592186330360} :answer-field/id #uuid "75e80a73-b1ef-545c-bc47-759f5717a078" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8704e7df-0e87-5dd2-a140-acb85a41ea4d" :question/math-academy-id "q-50092" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $y(1)=1.$\n\n$$\n2x+\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+4x.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+2x.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int ({x}^{2}+2x)\\,\\text{d}x \\\\ y & =\\frac{{x}^{3}}{3}+2\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{3}}{3}+{x}^{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=\\frac{{x}^{3}}{3}+{x}^{2}+C.$ To find a particular solution, we substitute the condition $y(1)=1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}y & =\\frac{{x}^{3}}{3}+{x}^{2}+C \\\\ 1 & =\\frac{{1}^{3}}{3}+{1}^{2}+C \\\\ 1 & =\\frac{4}{3}+C \\\\ C & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=\\frac{{x}^{3}}{3}+{x}^{2}-\\frac{1}{3}.\n$$"} {:db/id #edb/ref 17592186332805 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88dad183-ed2b-5a15-83b8-2f429e39030d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2\\operatorname{ln}⁡|1+2x|-2" :db/id #edb/ref 17592186331167} {:answer/id #uuid "963a6dbf-bdcb-54b7-b515-ded61ba89b6a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\operatorname{ln}⁡|1+2x|-2" :db/id #edb/ref 17592186331284} {:answer/id #uuid "bafaabc4-4fca-516b-a9d6-7ed9697af49a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\operatorname{ln}⁡|1+2x|-1" :db/id #edb/ref 17592186331598} {:answer/id #uuid "fd70074b-45df-5d86-ae50-06ecb0063c91" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2x-2" :db/id #edb/ref 17592186332179} {:answer/id #uuid "ffdab17a-cdb5-59fe-8492-3c8a1b66fd32" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=2{x}^{2}+x-2" :db/id #edb/ref 17592186332199}] :answer-field/correct {:answer/id #uuid "963a6dbf-bdcb-54b7-b515-ded61ba89b6a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\operatorname{ln}⁡|1+2x|-2" :db/id #edb/ref 17592186331284} :answer-field/id #uuid "6c1e6eb7-20e6-5c26-9817-474a9a29bb18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332400}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab41d9c4-5e4f-5845-a572-d7bd4049e427" :question/math-academy-id "q-50159" :question/problem "Find the particular solution to the differential equation below that satisfies the condition $f(0)=-2.$\n\n$$\n(1+2x){f}^{′}(x)-2=0.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n{f}^{′}(x)=\\frac{2}{1+2x}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{2}{1+2x}\\,\\text{d}x \\\\ f(x) & =\\int \\frac{2}{1+2x}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=(1+2x).$ Then $\\text{d}u=2\\,\\text{d}x.$ Therefore,\n\n$$\n\\begin{aligned}f(x) & =\\int \\frac{2}{1+2x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|1+2x|+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=\\operatorname{ln}⁡|1+2x|+C.$ To find a particular solution, we substitute the condition $f(0)=-2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡|1+2x|+C \\\\ -2 & =\\operatorname{ln}⁡|1+2\\cdot 0|+C \\\\ -2 & =\\operatorname{ln}⁡|1|+C \\\\ C & =-2.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=\\operatorname{ln}⁡|1+2x|-2.\n$$"} {:db/id #edb/ref 17592186351482 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7dc989a8-2c75-5f1c-9659-077b9b5ceeed" :answer/type {:db/ident :answer.type/math} :answer/value "y=4{x}^{2}" :db/id #edb/ref 17592186349599} {:answer/id #uuid "90451e36-0f3c-542c-9624-ec09beef5517" :answer/type {:db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186349742} {:answer/id #uuid "96633e09-e5d2-5a83-a534-6acb8fbe9b36" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x" :db/id #edb/ref 17592186349795} {:answer/id #uuid "b2d311c7-63bd-56a8-90ae-daf55b933be8" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186350028} {:answer/id #uuid "eec3251e-786c-5a1a-9eba-fcc26b7bd286" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x-2" :db/id #edb/ref 17592186350534}] :answer-field/correct {:answer/id #uuid "96633e09-e5d2-5a83-a534-6acb8fbe9b36" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x" :db/id #edb/ref 17592186349795} :answer-field/id #uuid "83e5ea7c-8d82-5535-96fc-e39fd184f9e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d35cfdf-da63-5e6d-990c-a2e5c83f1725" :question/math-academy-id "q-8311" :question/problem "Find the specific solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}+4=0$ given that $y(-1)=4.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-4.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4)\\,\\text{d}x \\\\ \\int \\,\\text{d}y & =\\int (-4)\\,\\text{d}x \\\\ y & =-4x+C\\,.\\end{aligned}\n$$\n\nSo our general solution is $y=-4x+C.$ To find a particular solution, we substitute the condition $y(-1)=4$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}4 & =-4\\cdot (-1)+C \\\\ 4 & =4+C \\\\ 0 & =C\\,.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=-4x\\,.\n$$"} {:db/id #edb/ref 17592186496555 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4ef27c0-c2ac-5049-b6d0-b6c6c30dbda8" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 x^{2} - 5 + e^{- 2 x}" :db/id #edb/ref 17592186496584}] :answer-field/correct {:answer/id #uuid "d4ef27c0-c2ac-5049-b6d0-b6c6c30dbda8" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 x^{2} - 5 + e^{- 2 x}" :db/id #edb/ref 17592186496584} :answer-field/id #uuid "7761440a-3e1f-5b63-807b-471d79bc3612" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186496571}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "055460a6-0f9b-526b-8dc4-1d9477fd930a" :question/problem "Find the particular solution to the differential equation $y'=- 6 x- 2 e^{- 2 x}$ that satisfies the condition $y(0)=-4.$\n\n$y=\\,${{field-1}}" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\ny'=- 6 x- 2 e^{- 2 x}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int y'\\,\\text{d}x & =\\int (- 6 x- 2 e^{- 2 x})\\,\\text{d}x \\\\ y & =\\int (- 6 x)\\,\\text{d}x + \\int (- 2 e^{- 2 x})\\,\\text{d}x \\\\ & =(-6)(\\frac{x^{2}}{2}) + (-2)(- \\frac{e^{- 2 x}}{2})+C \\\\ & =- 3 x^{2}+e^{- 2 x}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=- 3 x^{2}+e^{- 2 x}+C.$ To find a particular solution, we substitute the condition $y(0)=-4$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-4 & =(- 3 (0)^{2}) + (e^{- 2 (0)})+C \\\\ -4 & =(0) + (1)+C \\\\ C & =-5.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=- 3 x^{2} - 5 + e^{- 2 x}.\n$$"} {:db/id #edb/ref 17592186496558 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44d307e3-3971-5b44-8870-ec07964729c5" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=- \\frac{4 x^{3}}{3} + \\frac{e^{2 x}}{2} - 2 \\sin{(x )} - \\frac{5}{2}" :db/id #edb/ref 17592186496560} {:answer/id #uuid "6309219f-5921-50af-8d03-ceca3f9cd7cd" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=4 x^{2} - e^{2 x} + 2 \\cos{(x )} - 3" :db/id #edb/ref 17592186496565} {:answer/id #uuid "6d39cea8-f729-59fd-932b-b421f7c81e0a" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=\\frac{4 x^{3}}{3} - \\frac{e^{2 x}}{2} + 2 \\sin{(x )}" :db/id #edb/ref 17592186496566} {:answer/id #uuid "9bf52bf4-503f-518b-8224-990dfc17f0e2" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=\\frac{4 x^{3}}{3} - \\frac{e^{2 x}}{2} + 2 \\sin{(x )} - \\frac{3}{2}" :db/id #edb/ref 17592186496578} {:answer/id #uuid "d8a8c8a0-b258-57db-8417-7f4ed7dd5e10" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=\\frac{2 x^{3}}{3} - \\frac{e^{2 x}}{4} + \\sin{(x )} - \\frac{7}{4}" :db/id #edb/ref 17592186496586}] :answer-field/correct {:answer/id #uuid "9bf52bf4-503f-518b-8224-990dfc17f0e2" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=\\frac{4 x^{3}}{3} - \\frac{e^{2 x}}{2} + 2 \\sin{(x )} - \\frac{3}{2}" :db/id #edb/ref 17592186496578} :answer-field/id #uuid "b3e4d76e-d5c8-50ce-b204-2238bbc1ebf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496580}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28dcb28d-1db1-599d-9052-a43879b7d29d" :question/problem "Find the particular solution to the differential equation $g'(x)=4 x^{2}- e^{2 x}+2 \\cos{(x )}$ that satisfies the condition $g(0)=-2.$" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\ng'(x)=4 x^{2}- e^{2 x}+2 \\cos{(x )}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int g'(x)\\,\\text{d}x & =\\int (4 x^{2}- e^{2 x}+2 \\cos{(x )})\\,\\text{d}x \\\\ g(x) & =\\int (4 x^{2})\\,\\text{d}x + \\int (- e^{2 x})\\,\\text{d}x + \\int (2 \\cos{(x )})\\,\\text{d}x \\\\ & =(4)(\\frac{x^{3}}{3}) + (-1)(\\frac{e^{2 x}}{2}) + (2)(\\sin{(x )})+C \\\\ & =\\frac{4 x^{3}}{3}- \\frac{e^{2 x}}{2}+2 \\sin{(x )}+C.\\end{aligned}\n$$\n\nSo our general solution is $g(x)=\\frac{4 x^{3}}{3}- \\frac{e^{2 x}}{2}+2 \\sin{(x )}+C.$ To find a particular solution, we substitute the condition $g(0)=-2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-2 & =(\\frac{4 (0)^{3}}{3}) + (- \\frac{e^{2 (0)}}{2}) + (2 \\sin{((0) )})+C \\\\ -2 & =(0) + (- \\frac{1}{2}) + (0)+C \\\\ C & =- \\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ng(x)=\\frac{4 x^{3}}{3} - \\frac{e^{2 x}}{2} + 2 \\sin{(x )} - \\frac{3}{2}.\n$$"} {:db/id #edb/ref 17592186496559 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7a616ea-75de-59d6-9be8-1efebdcb8ea9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 x^{3}}{3} + e^{x} + 3 \\sin{(x )} - 2" :db/id #edb/ref 17592186496587}] :answer-field/correct {:answer/id #uuid "e7a616ea-75de-59d6-9be8-1efebdcb8ea9" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2 x^{3}}{3} + e^{x} + 3 \\sin{(x )} - 2" :db/id #edb/ref 17592186496587} :answer-field/id #uuid "cb17feec-f119-512b-bbc3-1c49567bcc7a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186496583}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "434627b4-46f1-5eea-a26e-ab4e978bb4fe" :question/problem "Find the particular solution to the differential equation $f'(x)=- 2 x^{2}+e^{x}+3 \\cos{(x )}$ that satisfies the condition $f(0)=-1.$\n\n$f(x)=\\,${{field-1}}" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\nf'(x)=- 2 x^{2}+e^{x}+3 \\cos{(x )}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\text{d}x & =\\int (- 2 x^{2}+e^{x}+3 \\cos{(x )})\\,\\text{d}x \\\\ f(x) & =\\int (- 2 x^{2})\\,\\text{d}x + \\int (e^{x})\\,\\text{d}x + \\int (3 \\cos{(x )})\\,\\text{d}x \\\\ & =(-2)(\\frac{x^{3}}{3}) + (1)(e^{x}) + (3)(\\sin{(x )})+C \\\\ & =- \\frac{2 x^{3}}{3}+e^{x}+3 \\sin{(x )}+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=- \\frac{2 x^{3}}{3}+e^{x}+3 \\sin{(x )}+C.$ To find a particular solution, we substitute the condition $f(0)=-1$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-1 & =(- \\frac{2 (0)^{3}}{3}) + (e^{(0)}) + (3 \\sin{((0) )})+C \\\\ -1 & =(0) + (1) + (0)+C \\\\ C & =-2.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=- \\frac{2 x^{3}}{3} + e^{x} + 3 \\sin{(x )} - 2.\n$$"} {:db/id #edb/ref 17592186496562 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89bbbb9c-5bf7-5e11-a192-421ca39a2b26" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 x^{2} - 6 + e^{- x}" :db/id #edb/ref 17592186496575}] :answer-field/correct {:answer/id #uuid "89bbbb9c-5bf7-5e11-a192-421ca39a2b26" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 x^{2} - 6 + e^{- x}" :db/id #edb/ref 17592186496575} :answer-field/id #uuid "26a9991b-4a5a-59bb-8999-d08fed4a1afe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186496557}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "540280c5-2fb8-54b1-88f4-aa5261ba0b12" :question/problem "Find the particular solution to the differential equation $g'(x)=- 4 x- e^{- x}$ that satisfies the condition $g(0)=-5.$\n\n$g(x)=\\,${{field-1}}" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\ng'(x)=- 4 x- e^{- x}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int g'(x)\\,\\text{d}x & =\\int (- 4 x- e^{- x})\\,\\text{d}x \\\\ g(x) & =\\int (- 4 x)\\,\\text{d}x + \\int (- e^{- x})\\,\\text{d}x \\\\ & =(-4)(\\frac{x^{2}}{2}) + (-1)(- e^{- x})+C \\\\ & =- 2 x^{2}+e^{- x}+C.\\end{aligned}\n$$\n\nSo our general solution is $g(x)=- 2 x^{2}+e^{- x}+C.$ To find a particular solution, we substitute the condition $g(0)=-5$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-5 & =(- 2 (0)^{2}) + (e^{- (0)})+C \\\\ -5 & =(0) + (1)+C \\\\ C & =-6.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ng(x)=- 2 x^{2} - 6 + e^{- x}.\n$$"} {:db/id #edb/ref 17592186496574 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dd041ec-76f5-576c-b5f5-4ac1e33a875d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{4 x^{3}}{3} + 3 \\sin{(x )} - \\frac{15}{2} - \\frac{e^{- 2 x}}{2}" :db/id #edb/ref 17592186496567} {:answer/id #uuid "71be9bd2-467c-544f-a86c-b94537352986" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=\\frac{4 x^{3}}{3} - 3 \\sin{(x )} - \\frac{17}{2} + \\frac{e^{- 2 x}}{2}" :db/id #edb/ref 17592186496569} {:answer/id #uuid "7a56cab2-0b3b-50dc-8fac-bc8339e5496a" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{4 x^{3}}{3} + 3 \\sin{(x )} - \\frac{e^{- 2 x}}{2}" :db/id #edb/ref 17592186496572} {:answer/id #uuid "b4c9a11e-69a9-5c57-a016-135f4ee342f3" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- 4 x^{2} + 3 \\cos{(x )} - 12 + e^{- 2 x}" :db/id #edb/ref 17592186496581} {:answer/id #uuid "b4e5a3f6-fd19-5031-bd08-3342f142ba83" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{2 x^{3}}{3} + \\frac{3 \\sin{(x )}}{2} - \\frac{31}{4} - \\frac{e^{- 2 x}}{4}" :db/id #edb/ref 17592186496582}] :answer-field/correct {:answer/id #uuid "6dd041ec-76f5-576c-b5f5-4ac1e33a875d" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)=- \\frac{4 x^{3}}{3} + 3 \\sin{(x )} - \\frac{15}{2} - \\frac{e^{- 2 x}}{2}" :db/id #edb/ref 17592186496567} :answer-field/id #uuid "94031bbf-31fa-5e35-83b6-b4b9cede32c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496576}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7efbb8af-b76c-5365-a359-23b71e692cfb" :question/problem "Find the particular solution to the differential equation $f'(x)=- 4 x^{2}+e^{- 2 x}+3 \\cos{(x )}$ that satisfies the condition $f(0)=-8.$" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\nf'(x)=- 4 x^{2}+e^{- 2 x}+3 \\cos{(x )}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int f'(x)\\,\\text{d}x & =\\int (- 4 x^{2}+e^{- 2 x}+3 \\cos{(x )})\\,\\text{d}x \\\\ f(x) & =\\int (- 4 x^{2})\\,\\text{d}x + \\int (e^{- 2 x})\\,\\text{d}x + \\int (3 \\cos{(x )})\\,\\text{d}x \\\\ & =(-4)(\\frac{x^{3}}{3}) + (1)(- \\frac{e^{- 2 x}}{2}) + (3)(\\sin{(x )})+C \\\\ & =- \\frac{4 x^{3}}{3}- \\frac{e^{- 2 x}}{2}+3 \\sin{(x )}+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x)=- \\frac{4 x^{3}}{3}- \\frac{e^{- 2 x}}{2}+3 \\sin{(x )}+C.$ To find a particular solution, we substitute the condition $f(0)=-8$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-8 & =(- \\frac{4 (0)^{3}}{3}) + (- \\frac{e^{- 2 (0)}}{2}) + (3 \\sin{((0) )})+C \\\\ -8 & =(0) + (- \\frac{1}{2}) + (0)+C \\\\ C & =- \\frac{15}{2}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=- \\frac{4 x^{3}}{3} + 3 \\sin{(x )} - \\frac{15}{2} - \\frac{e^{- 2 x}}{2}.\n$$"} {:db/id #edb/ref 17592186496577 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "544429ba-196d-56ee-8bbe-1db7b23b9340" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 x^{3}}{3} - 3 \\sin{(x )} - 6 + e^{- x}" :db/id #edb/ref 17592186496563}] :answer-field/correct {:answer/id #uuid "544429ba-196d-56ee-8bbe-1db7b23b9340" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4 x^{3}}{3} - 3 \\sin{(x )} - 6 + e^{- x}" :db/id #edb/ref 17592186496563} :answer-field/id #uuid "7b77f0f8-1f53-5123-abd8-4fb977688cb3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186496573}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9b0a6a93-71df-5af7-be4e-1bb4244efcb6" :question/problem "Find the particular solution to the differential equation $g'(x)=- 4 x^{2}- e^{- x}- 3 \\cos{(x )}$ that satisfies the condition $g(0)=-5.$\n\n$g(x)=\\,${{field-1}}" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\ng'(x)=- 4 x^{2}- e^{- x}- 3 \\cos{(x )}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int g'(x)\\,\\text{d}x & =\\int (- 4 x^{2}- e^{- x}- 3 \\cos{(x )})\\,\\text{d}x \\\\ g(x) & =\\int (- 4 x^{2})\\,\\text{d}x + \\int (- e^{- x})\\,\\text{d}x + \\int (- 3 \\cos{(x )})\\,\\text{d}x \\\\ & =(-4)(\\frac{x^{3}}{3}) + (-1)(- e^{- x}) + (-3)(\\sin{(x )})+C \\\\ & =- \\frac{4 x^{3}}{3}+e^{- x}- 3 \\sin{(x )}+C.\\end{aligned}\n$$\n\nSo our general solution is $g(x)=- \\frac{4 x^{3}}{3}+e^{- x}- 3 \\sin{(x )}+C.$ To find a particular solution, we substitute the condition $g(0)=-5$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-5 & =(- \\frac{4 (0)^{3}}{3}) + (e^{- (0)}) + (- 3 \\sin{((0) )})+C \\\\ -5 & =(0) + (1) + (0)+C \\\\ C & =-6.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ng(x)=- \\frac{4 x^{3}}{3} - 3 \\sin{(x )} - 6 + e^{- x}.\n$$"} {:db/id #edb/ref 17592186496579 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b8f3b58-8858-5461-8c2f-f3fd0569f838" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=- 2 x^{2} + \\frac{e^{2 x}}{2} - \\frac{5}{2}" :db/id #edb/ref 17592186496556} {:answer/id #uuid "57d4f7d9-ed6c-5a97-87e2-d6c53f06b31b" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=2 x^{2} - \\frac{e^{2 x}}{2} - \\frac{3}{2}" :db/id #edb/ref 17592186496564} {:answer/id #uuid "7694c46f-e60d-5d4f-a7ce-be776be3d5ca" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=2 x^{2} - \\frac{e^{2 x}}{2}" :db/id #edb/ref 17592186496570} {:answer/id #uuid "e9cac29f-14b5-5870-adf5-b3a40432c52d" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=4 x - e^{2 x} - 1" :db/id #edb/ref 17592186496588} {:answer/id #uuid "f021c66e-4c17-5d8b-b6b0-3bdb846a1345" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=x^{2} - \\frac{e^{2 x}}{4} - \\frac{7}{4}" :db/id #edb/ref 17592186496589}] :answer-field/correct {:answer/id #uuid "57d4f7d9-ed6c-5a97-87e2-d6c53f06b31b" :answer/type {:db/ident :answer.type/math} :answer/value "g(x)=2 x^{2} - \\frac{e^{2 x}}{2} - \\frac{3}{2}" :db/id #edb/ref 17592186496564} :answer-field/id #uuid "6f9b219b-9380-5027-899f-fba5ea430d76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186496568}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afdd11d0-4e3c-5120-9f08-464acb94efd0" :question/problem "Find the particular solution to the differential equation $g'(x)=4 x- e^{2 x}$ that satisfies the condition $g(0)=-2.$" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\ng'(x)=4 x- e^{2 x}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int g'(x)\\,\\text{d}x & =\\int (4 x- e^{2 x})\\,\\text{d}x \\\\ g(x) & =\\int (4 x)\\,\\text{d}x + \\int (- e^{2 x})\\,\\text{d}x \\\\ & =(4)(\\frac{x^{2}}{2}) + (-1)(\\frac{e^{2 x}}{2})+C \\\\ & =2 x^{2}- \\frac{e^{2 x}}{2}+C.\\end{aligned}\n$$\n\nSo our general solution is $g(x)=2 x^{2}- \\frac{e^{2 x}}{2}+C.$ To find a particular solution, we substitute the condition $g(0)=-2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-2 & =(2 (0)^{2}) + (- \\frac{e^{2 (0)}}{2})+C \\\\ -2 & =(0) + (- \\frac{1}{2})+C \\\\ C & =- \\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ng(x)=2 x^{2} - \\frac{e^{2 x}}{2} - \\frac{3}{2}.\n$$"} {:db/id #edb/ref 17592186496590 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4ab07a7-d1ed-5f44-8915-09e7b2418825" :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46a51229-760d-59b7-9713-62d0167e9710" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 x^{3} - 2 \\sin{(x )} - 5 + e^{- 2 x}" :db/id #edb/ref 17592186496561}] :answer-field/correct {:answer/id #uuid "46a51229-760d-59b7-9713-62d0167e9710" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 x^{3} - 2 \\sin{(x )} - 5 + e^{- 2 x}" :db/id #edb/ref 17592186496561} :answer-field/id #uuid "d54af8b6-64e9-50e8-a679-eed9f7d39cf4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186496585}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ff8b0291-a711-56fa-8ba2-9a74a6a7ab1c" :question/problem "Find the particular solution to the differential equation $y'=- 6 x^{2}- 2 e^{- 2 x}- 2 \\cos{(x )}$ that satisfies the condition $y(0)=-4.$\n\n$y=\\,${{field-1}}" :question/worked-solution "The derivative is already isolated, so we have\n\n$$\ny'=- 6 x^{2}- 2 e^{- 2 x}- 2 \\cos{(x )}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int y'\\,\\text{d}x & =\\int (- 6 x^{2}- 2 e^{- 2 x}- 2 \\cos{(x )})\\,\\text{d}x \\\\ y & =\\int (- 6 x^{2})\\,\\text{d}x + \\int (- 2 e^{- 2 x})\\,\\text{d}x + \\int (- 2 \\cos{(x )})\\,\\text{d}x \\\\ & =(-6)(\\frac{x^{3}}{3}) + (-2)(- \\frac{e^{- 2 x}}{2}) + (-2)(\\sin{(x )})+C \\\\ & =- 2 x^{3}+e^{- 2 x}- 2 \\sin{(x )}+C.\\end{aligned}\n$$\n\nSo our general solution is $y=- 2 x^{3}+e^{- 2 x}- 2 \\sin{(x )}+C.$ To find a particular solution, we substitute the condition $y(0)=-4$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}-4 & =(- 2 (0)^{3}) + (e^{- 2 (0)}) + (- 2 \\sin{((0) )})+C \\\\ -4 & =(0) + (1) + (0)+C \\\\ C & =-5.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\ny=- 2 x^{3} - 2 \\sin{(x )} - 5 + e^{- 2 x}.\n$$"}] :knowledge-point/title "Finding the Solution of a Differential Equation With a Given Condition"}]}
