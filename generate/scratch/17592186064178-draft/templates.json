  "q-71653": {
    "level": "easy",
    "parameters": {
      "a": 4
    },
    "record": {
      ":question/difficulty": ":question.difficulty/easy",
      ":question/id": "8f9e9368-db2a-5195-a33c-14fd53ecbddf",
      ":question/math-academy-id": "q-71653",
      ":question/problem": "$\\int {a}\\operatorname{cos}y\\,\\text{d}y=$",
      ":question/worked-solution": "Recall that\n\n$$\n\\int \\operatorname{cos}y\\,\\text{d}y=\\operatorname{sin}y+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int {a}\\operatorname{cos}y\\,\\text{d}y & ={a}\\int \\operatorname{cos}y\\,\\text{d}y \\\\  & ={a}(\\operatorname{sin}y)+C \\\\  & ={a}\\operatorname{sin}y+C.\\end{aligned}\\end{aligned}\n$$"
    },
    "eligible": false
  },
  "q-71654": {
    "level": "moderate",
    "parameters": {
      "a": 5
    },
    "record": {
      ":question/difficulty": ":question.difficulty/moderate",
      ":question/id": "ea9f76a8-e76e-5423-a193-fa42c402c584",
      ":question/math-academy-id": "q-71654",
      ":question/problem": "$\\int (\\operatorname{sin}x+{a}\\operatorname{cos}x)\\,\\text{d}x=$",
      ":question/worked-solution": "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{cos}x\\,\\text{d}x & =\\operatorname{sin}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sin}x+{a}\\operatorname{cos}x)\\,\\text{d}x & =\\int \\operatorname{sin}x\\,\\text{d}x+{a}\\int \\operatorname{cos}x\\,\\text{d}x \\\\  & =-\\operatorname{cos}x+{a}\\operatorname{sin}x+C.\\end{aligned}\n$$"
    },
    "eligible": false
  },
