56171 13194139536005 17592186045443 true] [17592186556129 1076 #edb/ref 17592186045493 13194139536005 17592186045443 true] [17592186556129 1077 "selection" 13194139536005 17592186045443 true] [17592186556129 1078 #edb/ref 17592186556146 13194139536005 17592186045443 true] [17592186556129 1079 #uuid "646eda7e-2147-525c-aef1-fd3fda68bebd" 13194139536005 17592186045443 true] [17592186556130 1080 "⟨0,-2,1⟩" 13194139536005 17592186045443 true] [17592186556130 1082 #edb/ref 17592186045498 13194139536005 17592186045443 true] [17592186556130 1083 #uuid "65a60baf-69b2-5fe6-90a1-c8f938f6de10" 13194139536005 17592186045443 true] [17592186556131 1080 "⟨0,-2,-1⟩" 13194139536005 17592186045443 true] [17592186556131 1082 #edb/ref 17592186045498 13194139536005 17592186045443 true] [17592186556131 1083 #uuid "72d61d09-f7e2-5f33-b750-f198d1889040" 13194139536005 17592186045443 true] [17592186556132 1068 #edb/ref 17592186556148 13194139536005 17592186045443 true] [17592186556132 1070 #edb/ref 17592186045485 13194139536005 17592186045443 true] [17592186556132 1071 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $x=1.$ Given that the point $P(1,2,-3)$ lies on $C$, and that ${f}_{y}=8$, which of the following gives a tangent vector to $C$ at $P?$" 13194139536005 17592186045443 true] [17592186556132 1072 #uuid "76fc75e5-bc34-5a11-827a-718027bfa6d6" 13194139536005 17592186045443 true] [17592186556132 1074 "The curve $C$ is the intersection of the surface with the plane $x=1.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{y}(1,2).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(1,2):$\n\n$$\n\\begin{aligned}{f}_{y}(1,2) & =8\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(1,2) & ={f}_{y}(1,2)(y-(2)) \\\\ z-(-3) & =(8)(y-(2)) \\\\ z-(-3) & =8 y - 16 \\\\ z & =8 y - 19\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(1,2,-3)$ can be given as the intersection of two planes:\n\n$$\n\\begin{aligned}\\{x=1 \\\\ z=8 y - 19\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $x=1,$ a normal vector to the plane is ${n}_{1}=⟨1,0,0⟩.$\n\n- For the plane $z=8 y - 19$ (or $8 y - z - 19=0$), a normal vector to the plane is ${n}_{2}=⟨0,8,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,0,0⟩\\times ⟨0,8,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 0 & 0 \\\\ 0 & 8 & -1\\end{aligned}\\right| \\\\  & =j + 8 k \\\\  & =⟨0,1,8⟩\\end{aligned}\n$$\n\nTherefore, a tangent vector to $C$ at $P$ is $⟨0,1,8⟩.$" 13194139536005 17592186045443 true] [17592186556133 1075 #edb/ref 17592186556108 13194139536005 17592186045443 true] [17592186556133 1075 #edb/ref 17592186556121 13194139536005 17592186045443 true] [17592186556133 1075 #edb/ref 17592186556130 13194139536005 17592186045443 true] [17592186556133 1075 #edb/ref 17592186556131 13194139536005 17592186045443 true] [17592186556133 1075 #edb/ref 17592186556165 13194139536005 17592186045443 true] [17592186556133 1076 #edb/ref 17592186045493 13194139536005 17592186045443 true] [17592186556133 1077 "selection" 13194139536005 17592186045443 true] [17592186556133 1078 #edb/ref 17592186556108 13194139536005 17592186045443 true] [17592186556133 1079 #uuid "777c8854-9f2f-5bcb-b4b6-3afe85450d1d" 13194139536005 17592186045443 true] [17592186556134 1075 #edb/ref 17592186556104 13194139536005 17592186045443 true] [17592186556134 1075 #edb/ref 17592186556117 13194139536005 17592186045443 true] [17592186556134 1075 #edb/ref 17592186556142 13194139536005 17592186045443 true] [17592186556134 1075 #edb/ref 17592186556167 13194139536005 17592186045443 true] [17592186556134 1075 #edb/ref 17592186556169 13194139536005 17592186045443 true] [17592186556134 1076 #edb/ref 17592186045493 1319413953