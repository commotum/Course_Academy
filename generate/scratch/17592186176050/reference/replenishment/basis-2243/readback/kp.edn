ath} :answer/value "-\\frac{19}{4}" :db/id #edb/ref 17592186516049} {:answer/id #uuid "8654b09c-6fca-5d4f-ad32-4d61192a7eb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{4}" :db/id #edb/ref 17592186516051} {:answer/id #uuid "dc3a3c91-4482-511f-af56-fbec6af3bafd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186516075}] :answer-field/correct {:answer/id #uuid "7fa22ead-3f1c-5d4e-9c51-f864939d6d85" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{19}{4}" :db/id #edb/ref 17592186516049} :answer-field/id #uuid "cf7bb7dd-1127-5307-b856-039fd95e6b5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9e02e9e-ce80-5bf5-babb-813fa2a720df" :question/problem "If $\\tan x=-\\frac{1}{2},$ for some $x$, find the value of $\\left(-\\frac{1}{2}\\right)\\tan (x+5\\pi )-5.$" :question/worked-solution "The period of $y=\\tan x$ is $\\pi .$ Therefore, for any integer $n,$ we have\n\n$$\n\\tan x=\\tan (x+n\\pi ).\n$$\n\nSubstituting $n=5$ into the above gives\n\n$$\n\\begin{aligned}\\tan x=\\tan (x+5\\cdot \\pi )=\\tan (x+5\\pi ).\\end{aligned}\n$$\n\nSince $\\tan x=-\\frac{1}{2},$ we get that $\\tan (x+5\\pi )=-\\frac{1}{2}.$ Therefore\n\n$$\n\\left(-\\frac{1}{2}\\right)\\tan (x+5\\pi )-5=-\\frac{1}{2}(-\\frac{1}{2})-5=\\frac{1}{4}-5=-\\frac{19}{4}.\n$$"} {:db/id #edb/ref 17592186516083 :knowledge-point/_questions [{:knowledge-point/id #uuid "eed0c7c3-0bb5-56eb-a9ca-9ec4dc7b3efe" :knowledge-point/title "Utilizing the Periodicity Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "211d0d4e-1dc9-5f9a-b3e7-0acda6d3b63d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186516025} {:answer/id #uuid "498f53b1-1ef7-5bc4-8117-c39c6a49e83e" :answer/type {:db/ident :answer.type/math} :answer/value "-16 + \\pi" :db/id #edb/ref 17592186516036} {:answer/id #uuid "8eb0c030-02ff-5ecf-afab-125368c95671" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186516052} {:answer/id #uuid "ad1bd78b-d3b5-5afe-b84e-7103509eb8c2" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186516059} {:answer/id #uuid "b34e47cb-e4c9-5da2-9a3d-035df2e2179e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186516062}] :answer-field/correct {:answer/id #uuid "ad1bd78b-d3b5-5afe-b84e-7103509eb8c2" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186516059} :answer-field/id #uuid "9017fabd-8ae2-55a4-81ef-a309fec4d9a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186516053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f77f41c9-eeea-5e4a-b04c-ebb875b80b6f" :question/problem "If $\\tan x = -16$, for some value of $x$, find the value of $\\tan (x + 1π)$." :question/worked-solution "The period of $y=\\tan x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\n\\tan x=\\tan (x+n\\pi ).\n$$\n\nSubstituting $n=1$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}\\tan x=\\tan (x+1\\cdot \\pi )=\\tan (x+1\\pi ).\\end{aligned}\n$$\n\nTherefore, if $\\tan x=-16,$ we get that $\\tan (x+1\\pi )=-16.$"}] :knowledge-point/title "Utilizing the Periodicity Property of the Tangent Function"}]}
