\\frac{1}{z} \\\\  & =\\frac{xy}{z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{y}(x,y,z)\\text{ }j+{h}_{z}(x,y,z)\\text{ }k \\\\  & =y\\operatorname{ln}⁡(z)\\text{ }i+x\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a21b9f7-4aaa-5471-bf82-f2d8ab4a05d3" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186336422} {:answer/id #uuid "71cc0d72-27c7-5788-8341-714d4d503875" :answer/type {:db/ident :answer.type/math} :answer/value "(2x+yz{e}^{xyz})\\text{ }i+(2y+xz{e}^{xyz})\\text{ }j+(2z+xy{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337049} {:answer/id #uuid "78722099-cc9a-5084-9630-ca6c5d2d30e3" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337116} {:answer/id #uuid "7a839402-601f-5953-874b-788c1ff02eff" :answer/type {:db/ident :answer.type/math} :answer/value "(x{y}^{2}{z}^{2}+yz{e}^{xyz-1})\\text{ }i+({x}^{2}y{z}^{2}+xz{e}^{xyz-1})\\text{ }j+({x}^{2}{y}^{2}z+xy{e}^{xyz-1})\\text{ }k" :db/id #edb/ref 17592186337136} {:answer/id #uuid "ac9d6b72-745e-56b9-86ea-4dab4db1e685" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+x{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+y{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+z{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337584}] :answer-field/correct {:answer/id #uuid "78722099-cc9a-5084-9630-ca6c5d2d30e3" :answer/type {:db/ident :answer.type/math} :answer/value "(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k" :db/id #edb/ref 17592186337116} :answer-field/id #uuid "df0b11fb-76fe-57a4-9209-9720c0dc1087" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338670}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d8f2390-7ede-5da9-be05-731bb79d1f06" :question/math-academy-id "q-71425" :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)={x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2x{y}^{2}{z}^{2}+yz{e}^{xyz} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2{x}^{2}y{z}^{2}+xz{e}^{xyz} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2{x}^{2}{y}^{2}z+xy{e}^{xyz}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "514f6510-65a6-5c71-8eca-34568a35dcba" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})j+{y}^{z}\\operatorname{ln}⁡y\\,k" :db/id #edb/ref 17592186383092} {:answer/id #uuid "6a1164dc-4f74-5f63-8956-517c46e081b5" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+z{y}^{z-1}\\,j+{y}^{z}\\operatorname{ln}⁡y\\,k" :db/id #edb/ref 17592186383093} {:answer/id #uuid "37e9d54a-963a-50c9-af62-5869773b3bbc" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{y}\\operatorname{ln}⁡y\\,i+{x}^{y}\\operatorname{ln}⁡x\\,j+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})k" :db/id #edb/ref 17592186383094} {:answer/id #uuid "daceaefe-76b2-57db-9142-cb9036ed18b4" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})i+{x}^{y}\\operatorname{ln}⁡y\\,j+{y}^{z}\\operatorname{ln}⁡z\\,k" :db/id #edb/ref 17592186383095} {:answer/id #uuid "b6a91458-30b5-5353-b216-4f46dc771583" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+z{y}^{z-1}\\,j+z{y}^{z-1}\\,k" :db/id #edb/ref 17592186383096}] :answer-field/correct {:answer/id #uuid "514f6510-65a6-5c71-8eca-34568a35dcba" :answer/type {:db/ident :answer.type/math} :answer/value "y{x}^{y-1}\\,i+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})j+{y}^{z}\\operatorname{ln}⁡y\\,k" :db/id #edb/ref 17592186383092} :answer-field/id #uuid "aa7309b8-5993-5bb2-9ecd-ce38b1c0b74d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383091}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf052c6a-faee-5b8c-b178-4c397426507c" :question/math-academy-id "q-127945" :question/problem "If $f(x,y,z)={x}^{y}+{y}^{z},$ find $∇f(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{y}+{y}^{z}) \\\\  & =y{x}^{y-1} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{y}+{y}^{z}) \\\\  & ={x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{y}+{y}^{z}) \\\\  & ={y}^{z}\\operatorname{ln}⁡y\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =y{x}^{y-1}\\,i+({x}^{y}\\operatorname{ln}⁡x+z{y}^{z-1})j+{y}^{z}\\operatorname{ln}⁡y\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b8c5a90-83e7-5f9f-b520-1eaae67e52b7" :answer/type {:db/ident :answer.type/math} :answer/value "e(i-\\frac{1}{2}\\,j)" :db/id #edb/ref 17592186383099} {:answer/id #uuid "de50d21e-e598-5ea9-bc0f-adeed68ca073" :answer/type {:db/ident :answer.type/math} :answer/value "e(i-\\frac{1}{2}\\,j+k)" :db/id #edb/ref 17592186383100} {:answer/id #uuid "86a0af6e-4435-566d-a878-c8e589b685c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{e}(-i+\\pi \\,j-k)" :db/id #edb/ref 17592186383101} {:answer/id #uuid "7f1d0ab5-cfea-5a4b-924a-7f3b508a6a85" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{e}(i+\\pi \\,j-k)" :db/id #edb/ref 17592186383102} {:answer/id #uuid "ce237491-8288-54ff-835f-4ec66f6ccaa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{e}(i+\\frac{1}{2}\\,j)" :db/id #edb/ref 17592186383103}] :answer-field/correct {:answer/id #uuid "ce237491-8288-54ff-835f-4ec66f6ccaa7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{e}(i+\\frac{1}{2}\\,j)" :db/id #edb/ref 17592186383103} :answer-field/id #uuid "ba2fd85f-4bd0-5b36-b61c-e043947f1967" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "804d417e-4fe8-53d3-ae3f-56da60f7d4fb" :question/math-academy-id "q-127947" :question/problem "Evaluate $∇h(x,y,z)$ at the point $(\\frac{1}{2},1,\\pi )$ if $h(x,y,z)={e}^{xy}\\operatorname{cos}⁡(yz).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}({e}^{xy}\\operatorname{cos}⁡(yz)) \\\\  & =y{e}^{xy}\\operatorname{cos}⁡(yz) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}({e}^{xy}\\operatorname{cos}⁡(yz)) \\\\  & =x{e}^{xy}\\operatorname{cos}⁡(yz)+{e}^{xy}(-\\operatorname{sin}⁡(yz))(z) \\\\  & ={e}^{xy}(x\\operatorname{cos}⁡(yz)-z\\operatorname{sin}⁡(yz)) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}({e}^{xy}\\operatorname{cos}⁡(yz)) \\\\  & =-y{e}^{xy}\\operatorname{sin}⁡(yz)\\end{aligned}\n$$\n\n \n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\,i+{h}_{x}(x,y,z)\\,j+{h}_{x}(x,y,z)\\,k \\\\  & =y{e}^{xy}\\operatorname{cos}⁡(yz)\\,i+{e}^{xy}(x\\operatorname{cos}⁡(yz)-z\\operatorname{sin}⁡(yz))\\,j-y{e}^{xy}\\operatorname{sin}⁡(yz)\\,k \\\\  & ={e}^{xy}(y\\operatorname{cos}⁡(yz)\\,i+(x\\operatorname{cos}⁡(yz)-z\\operatorname{sin}⁡(yz))\\,j-y\\operatorname{sin}⁡(yz)\\,k) \\\\ ∇h(\\frac{1}{2},1,\\pi ) & ={e}^{(1/2)(1)}(1\\operatorname{cos}⁡(1\\pi )\\,i+(\\frac{1}{2}\\operatorname{cos}⁡(1\\pi )-\\pi \\operatorname{sin}⁡(1\\pi ))\\,j-1\\operatorname{sin}⁡(1\\pi )\\,k) \\\\  & =\\sqrt{e}(-i-\\frac{1}{2}\\,j-0\\,k) \\\\  & =-\\sqrt{e}(i+\\frac{1}{2}\\,j).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94b23f6d-fcbc-5f05-bdfa-551e5a601813" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k)" :db/id #edb/ref 17592186385333} {:answer/id #uuid "5cb1b5c1-0c20-551c-a0c4-1c105471790f" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(zi+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\text{ }k)" :db/id #edb/ref 17592186385334} {:answer/id #uuid "0886912b-e3e5-5d97-a4f7-8d67907aca83" :answer/type {:db/ident :answer.type/math} :answer/value "z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k" :db/id #edb/ref 17592186385335} {:answer/id #uuid "d8f5b6bf-05e5-54bc-b294-aa5357db39ab" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)\\text{ }(zi+y\\text{ }j+x\\text{ }k)" :db/id #edb/ref 17592186385336} {:answer/id #uuid "24c26190-fbac-5847-9741-c5fdf4a37862" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(zi+y\\text{ }j+x\\text{ }k)" :db/id #edb/ref 17592186385337}] :answer-field/correct {:answer/id #uuid "94b23f6d-fcbc-5f05-bdfa-551e5a601813" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2xz}\\text{ }(z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k)" :db/id #edb/ref 17592186385333} :answer-field/id #uuid "63bf46dd-0351-5c7b-a783-d87b1b22bab9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385332}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f2c8781-0baa-5cdd-8cbc-03cc6b1166f3" :question/math-academy-id "q-35989" :question/problem "Given  $g(x,y,z)={e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)$, find $∇g(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)) \\\\  & =2z{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1) \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)) \\\\  & =2y{e}^{2xz}\\operatorname{cos}⁡({y}^{2}-1) \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)) \\\\  & =2x{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1).\\end{aligned}\n$$\n\nHence, the gradient is: \n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =2z{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)\\text{ }i+2y{e}^{2xz}\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+2x{e}^{2xz}\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k \\\\  & =2{e}^{2xz}\\text{ }(z\\operatorname{sin}⁡({y}^{2}-1)i+y\\operatorname{cos}⁡({y}^{2}-1)\\text{ }j+x\\operatorname{sin}⁡({y}^{2}-1)\\text{ }k)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "633422e1-8e43-5c9f-91f7-5f1b7bac7900" :answer/type {:db/ident :answer.type/math} :answer/value "yz\\text{ }i+xz\\text{ }j+xy\\text{ }k" :db/id #edb/ref 17592186385346} {:answer/id #uuid "c843fcb2-eb1c-505e-b82f-631646ec1f8e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k)" :db/id #edb/ref 17592186385347} {:answer/id #uuid "021bd062-132f-5e06-92b6-5a56c9d30357" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186385348} {:answer/id #uuid "3e3b7394-d1cf-599d-a5a4-871fc9682748" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(xyz)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k)" :db/id #edb/ref 17592186385349} {:answer/id #uuid "8fef3c82-4839-5c58-8b07-a4fabcf9cc44" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(\\text{ }i+\\text{ }j+\\text{ }k)" :db/id #edb/ref 17592186385350}] :answer-field/correct {:answer/id #uuid "c843fcb2-eb1c-505e-b82f-631646ec1f8e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{ln}⁡(xyz)+1)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k)" :db/id #edb/ref 17592186385347} :answer-field/id #uuid "3d7b2133-c26f-5485-a0f6-31ac0fd776d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385345}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bcc7ffb5-272b-56a1-a959-51ef6109597c" :question/math-academy-id "q-36012" :question/problem "Given $h(x,y,z)=xyz\\operatorname{ln}⁡(xyz)$, find  $∇h(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xyz\\operatorname{ln}⁡(xyz)) \\\\  & =yz\\operatorname{ln}⁡(xyz)+xyz\\frac{yz}{xyz} \\\\  & =yz(\\operatorname{ln}⁡(xyz)+1) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xyz\\operatorname{ln}⁡(xyz)) \\\\  & =xz\\operatorname{ln}⁡(xyz)+xyz\\frac{xz}{xyz} \\\\  & =xz(\\operatorname{ln}⁡(xyz)+1) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xyz\\operatorname{ln}⁡(xyz)) \\\\  & =xy\\operatorname{ln}⁡(xyz)+xyz\\frac{xy}{xyz} \\\\  & =xy(\\operatorname{ln}⁡(xyz)+1)\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{y}(x,y,z)\\text{ }j+{h}_{z}(x,y,z)\\text{ }k \\\\  & =yz(\\operatorname{ln}⁡(xyz)+1)\\text{ }i+xz(\\operatorname{ln}⁡(xyz)+1)\\text{ }j+xy(\\operatorname{ln}⁡(xyz)+1)\\text{ }k \\\\  & =(\\operatorname{ln}⁡(xyz)+1)(yz\\text{ }i+xz\\text{ }j+xy\\text{ }k).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186385529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac0e82c-e65c-52b4-92cf-ea9eef5506dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385531} {:answer/id #uuid "725ac3d7-7213-5bdb-b47f-4954c2a469c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i+\\pi \\text{ }j+\\pi \\text{ }k" :db/id #edb/ref 17592186385532} {:answer/id #uuid "44d96ff8-6e7a-5e3c-bdfc-e4fa56a64251" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i+\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385533} {:answer/id #uuid "5a3bbb8f-e6f1-5641-8261-340795b58dda" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385534} {:answer/id #uuid "fa3e1f03-a9e4-5b31-b950-95579c95df2e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\pi \\text{ }i+\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385535}] :answer-field/correct {:answer/id #uuid "7ac0e82c-e65c-52b4-92cf-ea9eef5506dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385531} :answer-field/id #uuid "7027997b-9ea2-56b2-bbd7-bdf567a4b72d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aef7acb8-89a1-5016-aa4c-ee6f59af7efc" :question/math-academy-id "q-71426" :question/problem "Evaluate $∇h(x,y,z)$ at the point $(1,-1,\\pi )$ if $h(x,y,z)=\\operatorname{sin}⁡(xyz).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xyz)) \\\\  & =yz\\operatorname{cos}⁡(xyz) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xyz)) \\\\  & =xz\\operatorname{cos}⁡(xyz) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{sin}⁡(xyz)) \\\\  & =xy\\operatorname{cos}⁡(xyz)\\end{aligned}\n$$\n\n \nHence, the gradient is\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{x}(x,y,z)\\text{ }j+{h}_{x}(x,y,z)\\text{ }k \\\\  & =yz\\operatorname{cos}⁡(xyz)\\text{ }i+xz\\operatorname{cos}⁡(xyz)\\text{ }j+xy\\operatorname{cos}⁡(xyz)\\text{ }k \\\\ ∇h(1,-1,\\pi ) & =(-1)(\\pi )\\operatorname{cos}⁡(-\\pi )\\text{ }i+(1)(\\pi )\\operatorname{cos}⁡(-\\pi )\\text{ }j+(1)(-1)\\operatorname{cos}⁡(-\\pi )\\text{ }k \\\\  & =(-\\pi )(-1)\\text{ }i+\\pi (-1)\\text{ }j-(-1)\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186437016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b7ebbbc-7508-52dc-91d2-56b705b7eccc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-12,0,8⟩" :db/id #edb/ref 17592186436986} {:answer/id #uuid "763a0475-ce2e-53a8-aa2d-9466219586f6" :answer/type {:db/ident :answer.type/math} :answer/value "⟨12,8,0⟩" :db/id #edb/ref 17592186436989} {:answer/id #uuid "bd9e8470-5c37-54ae-b712-f0a64e63b2e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,8,0⟩" :db/id #edb/ref 17592186436995} {:answer/id #uuid "c0ae3e99-1ea5-5fa4-a1e9-7139e200dfcc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-4,8⟩" :db/id #edb/ref 17592186436996} {:answer/id #uuid "e7d9044c-103d-5c75-a1cc-b44786993ed3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4,0,8⟩" :db/id #edb/ref 17592186437004}] :answer-field/correct {:answer/id #uuid "bd9e8470-5c37-54ae-b712-f0a64e63b2e2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,8,0⟩" :db/id #edb/ref 17592186436995} :answer-field/id #uuid "fe5a3950-f690-5d04-879c-231b6f838613" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186437015}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3edc7251-4f74-5afa-bcee-22e839f081a7" :question/math-academy-id "q-127946" :question/problem "Evaluate $∇h(x,y,z)$ at $(1,-2,2)$ if $h(x,y,z)={x}^{2}{z}^{2}-x{y}^{2}+2yz.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}{z}^{2}-x{y}^{2}+2yz) \\\\  & =2x{z}^{2}-{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}{z}^{2}-x{y}^{2}+2yz) \\\\  & =2z-2xy \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}{z}^{2}-x{y}^{2}+2yz) \\\\  & =2{x}^{2}z+2y\\end{aligned}\n$$\n\nTherefore, the gradient is \n\n$$\n\\begin{aligned}∇h(x,y,z) & =⟨{h}_{x}(x,y,z),\\,{h}_{y}(x,y,z),\\,{h}_{z}(x,y,z)⟩ \\\\  & =⟨2x{z}^{2}-{y}^{2},\\,2z-2xy,\\,2{x}^{2}z+2y⟩ \\\\ ∇h(1,-2,2) & =⟨2(1)(2)^{2}-(-2)^{2},\\,-2(1)(-2)+2(2),\\,2(1)^{2}(2)+2(-2)⟩ \\\\  & =⟨8-4,4+4,4-4⟩ \\\\  & =⟨4,8,0⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51b570f2-170f-50b9-b0a5-9563089e0914" :answer/type {:db/ident :answer.type/math} :answer/value "(-12)\\,\\mathbf i+(-4)\\,\\mathbf j+(-18)\\,\\mathbf k" :db/id #edb/ref 17592186551553} {:answer/id #uuid "85d95e24-11f1-5424-b411-e0cba95ba1d1" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{3}{7})\\,\\mathbf i+(- \\frac{1}{7})\\,\\mathbf j+(- \\frac{3}{7})\\,\\mathbf k" :db/id #edb/ref 17592186551566} {:answer/id #uuid "b6d64b4c-f8eb-5e52-a731-c64e6c9515d2" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{9}{49})\\,\\mathbf i+(\\frac{3}{49})\\,\\mathbf j+(\\frac{3}{49})\\,\\mathbf k" :db/id #edb/ref 17592186551579} {:answer/id #uuid "b8cf17ec-9cf4-5d4b-ac5b-642ccc70904b" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{12}{49})\\,\\mathbf i+(- \\frac{4}{49})\\,\\mathbf j+(- \\frac{18}{49})\\,\\mathbf k" :db/id #edb/ref 17592186551581} {:answer/id #uuid "eddd4ced-d849-5ca7-ab21-5aa50e4a8fb1" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{30}{49})\\,\\mathbf i+(- \\frac{10}{49})\\,\\mathbf j+(- \\frac{24}{49})\\,\\mathbf k" :db/id #edb/ref 17592186551596}] :answer-field/correct {:answer/id #uuid "b8cf17ec-9cf4-5d4b-ac5b-642ccc70904b" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{12}{49})\\,\\mathbf i+(- \\frac{4}{49})\\,\\mathbf j+(- \\frac{18}{49})\\,\\mathbf k" :db/id #edb/ref 17592186551581} :answer-field/id #uuid "c14bbab2-5183-5313-8025-08879f6edb60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551584}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "01b80278-13c1-5bc7-888c-457bedd82092" :question/problem "Evaluate $∇g(x,y,z)$ at the point $(1,3,1)$ if $g(x,y,z)=- \\frac{x y z}{3 x + y + z}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(- \\frac{x y z}{3 x + y + z}) \\\\  & =\\frac{(3 x + y + z)(- y z)-(- x y z)(3)}{(3 x + y + z)^2} \\\\  & =- \\frac{y z \\left(y + z\\right)}{\\left(3 x + y + z\\right)^{2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(- \\frac{x y z}{3 x + y + z}) \\\\  & =\\frac{(3 x + y + z)(- x z)-(- x y z)(1)}{(3 x + y + z)^2} \\\\  & =- \\frac{x z \\left(3 x + z\\right)}{\\left(3 x + y + z\\right)^{2}} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(- \\frac{x y z}{3 x + y + z}) \\\\  & =\\frac{(3 x + y + z)(- x y)-(- x y z)(1)}{(3 x + y + z)^2} \\\\  & =- \\frac{x y \\left(3 x + y\\right)}{\\left(3 x + y + z\\right)^{2}}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(\\frac{3 x y z}{\\left(3 x + y + z\\right)^{2}} - \\frac{y z}{3 x + y + z})\\,\\mathbf i+(\\frac{x y z}{\\left(3 x + y + z\\right)^{2}} - \\frac{x z}{3 x + y + z})\\,\\mathbf j+(\\frac{x y z}{\\left(3 x + y + z\\right)^{2}} - \\frac{x y}{3 x + y + z})\\,\\mathbf k \\\\ ∇g(1,3,1) & =(\\frac{(7)(-3)-(-3)(3)}{(7)^2})\\,\\mathbf i+(\\frac{(7)(-1)-(-3)(1)}{(7)^2})\\,\\mathbf j+(\\frac{(7)(-3)-(-3)(1)}{(7)^2})\\,\\mathbf k \\\\  & =(- \\frac{12}{49})\\,\\mathbf i+(- \\frac{4}{49})\\,\\mathbf j+(- \\frac{18}{49})\\,\\mathbf k \\\\  & =(- \\frac{12}{49})\\,\\mathbf i+(- \\frac{4}{49})\\,\\mathbf j+(- \\frac{18}{49})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f20dac-6288-5051-a0c9-656192ea317e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{54}{121})\\,\\mathbf i+(- \\frac{18}{121})\\,\\mathbf j+(\\frac{18}{121})\\,\\mathbf k" :db/id #edb/ref 17592186551535} {:answer/id #uuid "1b82d1e6-c06d-5bc5-a3be-ca74e8368591" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{6}{11})\\,\\mathbf i+(- \\frac{18}{11})\\,\\mathbf j+(- \\frac{6}{11})\\,\\mathbf k" :db/id #edb/ref 17592186551539} {:answer/id #uuid "2beb0246-9a96-5b86-b925-3ee4afed1adc" :answer/type {:db/ident :answer.type/math} :answer/value "(-12)\\,\\mathbf i+(-216)\\,\\mathbf j+(-48)\\,\\mathbf k" :db/id #edb/ref 17592186551541} {:answer/id #uuid "30d13711-2fa2-5805-aef5-71db8eb39744" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{12}{121})\\,\\mathbf i+(- \\frac{216}{121})\\,\\mathbf j+(- \\frac{48}{121})\\,\\mathbf k" :db/id #edb/ref 17592186551545} {:answer/id #uuid "e6e4497f-d6d4-5ce0-a5a1-5acd3a94ffb8" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{120}{121})\\,\\mathbf i+(- \\frac{180}{121})\\,\\mathbf j+(- \\frac{84}{121})\\,\\mathbf k" :db/id #edb/ref 17592186551593}] :answer-field/correct {:answer/id #uuid "30d13711-2fa2-5805-aef5-71db8eb39744" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{12}{121})\\,\\mathbf i+(- \\frac{216}{121})\\,\\mathbf j+(- \\frac{48}{121})\\,\\mathbf k" :db/id #edb/ref 17592186551545} :answer-field/id #uuid "bf24e375-8a4c-5062-b9e8-dd5c1bf1791d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551583}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2d2b5e18-84ca-5425-a8f7-9933f3d81196" :question/problem "Evaluate $∇g(x,y,z)$ at the point $(3,1,3)$ if $g(x,y,z)=- \\frac{2 x y z}{3 x - y + z}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(- \\frac{2 x y z}{3 x - y + z}) \\\\  & =\\frac{(3 x - y + z)(- 2 y z)-(- 2 x y z)(3)}{(3 x - y + z)^2} \\\\  & =\\frac{2 y z \\left(y - z\\right)}{\\left(3 x - y + z\\right)^{2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(- \\frac{2 x y z}{3 x - y + z}) \\\\  & =\\frac{(3 x - y + z)(- 2 x z)-(- 2 x y z)(-1)}{(3 x - y + z)^2} \\\\  & =- \\frac{2 x z \\left(3 x + z\\right)}{\\left(3 x - y + z\\right)^{2}} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(- \\frac{2 x y z}{3 x - y + z}) \\\\  & =\\frac{(3 x - y + z)(- 2 x y)-(- 2 x y z)(1)}{(3 x - y + z)^2} \\\\  & =- \\frac{2 x y \\left(3 x - y\\right)}{\\left(3 x - y + z\\right)^{2}}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(\\frac{6 x y z}{\\left(3 x - y + z\\right)^{2}} - \\frac{2 y z}{3 x - y + z})\\,\\mathbf i+(- \\frac{2 x y z}{\\left(3 x - y + z\\right)^{2}} - \\frac{2 x z}{3 x - y + z})\\,\\mathbf j+(\\frac{2 x y z}{\\left(3 x - y + z\\right)^{2}} - \\frac{2 x y}{3 x - y + z})\\,\\mathbf k \\\\ ∇g(3,1,3) & =(\\frac{(11)(-6)-(-18)(3)}{(11)^2})\\,\\mathbf i+(\\frac{(11)(-18)-(-18)(-1)}{(11)^2})\\,\\mathbf j+(\\frac{(11)(-6)-(-18)(1)}{(11)^2})\\,\\mathbf k \\\\  & =(- \\frac{12}{121})\\,\\mathbf i+(- \\frac{216}{121})\\,\\mathbf j+(- \\frac{48}{121})\\,\\mathbf k \\\\  & =(- \\frac{12}{121})\\,\\mathbf i+(- \\frac{216}{121})\\,\\mathbf j+(- \\frac{48}{121})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326a1a4f-342f-55b4-a110-a2709831b255" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{8})\\,\\mathbf i+(\\frac{1}{16})\\,\\mathbf j+(- \\frac{11}{16})\\,\\mathbf k" :db/id #edb/ref 17592186551546} {:answer/id #uuid "5e3bfb05-0026-500e-ab07-b20fa3d7a282" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{7}{8})\\,\\mathbf i+(\\frac{7}{16})\\,\\mathbf j+(- \\frac{13}{16})\\,\\mathbf k" :db/id #edb/ref 17592186551555} {:answer/id #uuid "7e3b866f-b033-5d4a-960c-12a16bdfb0e6" :answer/type {:db/ident :answer.type/math} :answer/value "(90)\\,\\mathbf i+(9)\\,\\mathbf j+(-99)\\,\\mathbf k" :db/id #edb/ref 17592186551562} {:answer/id #uuid "890840ec-d66a-5ea2-a525-97e6db70ac5e" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{1}{8})\\,\\mathbf i+(- \\frac{3}{16})\\,\\mathbf j+(\\frac{1}{16})\\,\\mathbf k" :db/id #edb/ref 17592186551567} {:answer/id #uuid "b54a31e3-2b50-5c38-88f2-32aebf4915c4" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{4})\\,\\mathbf i+(\\frac{1}{4})\\,\\mathbf j+(- \\frac{3}{4})\\,\\mathbf k" :db/id #edb/ref 17592186551578}] :answer-field/correct {:answer/id #uuid "326a1a4f-342f-55b4-a110-a2709831b255" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{8})\\,\\mathbf i+(\\frac{1}{16})\\,\\mathbf j+(- \\frac{11}{16})\\,\\mathbf k" :db/id #edb/ref 17592186551546} :answer-field/id #uuid "ab5196fb-11c8-5508-80c7-18d7ea226d31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551577}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "475d0eee-bd08-5379-9e3a-cbd39068cbc3" :question/problem "Evaluate $∇g(x,y,z)$ at the point $(-1,-3,1)$ if $g(x,y,z)=- \\frac{3 x y z}{- 2 x - 3 y + z}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(- \\frac{3 x y z}{- 2 x - 3 y + z}) \\\\  & =\\frac{(- 2 x - 3 y + z)(- 3 y z)-(- 3 x y z)(-2)}{(- 2 x - 3 y + z)^2} \\\\  & =\\frac{3 y z \\left(3 y - z\\right)}{\\left(2 x + 3 y - z\\right)^{2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(- \\frac{3 x y z}{- 2 x - 3 y + z}) \\\\  & =\\frac{(- 2 x - 3 y + z)(- 3 x z)-(- 3 x y z)(-3)}{(- 2 x - 3 y + z)^2} \\\\  & =\\frac{3 x z \\left(2 x - z\\right)}{\\left(2 x + 3 y - z\\right)^{2}} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(- \\frac{3 x y z}{- 2 x - 3 y + z}) \\\\  & =\\frac{(- 2 x - 3 y + z)(- 3 x y)-(- 3 x y z)(1)}{(- 2 x - 3 y + z)^2} \\\\  & =\\frac{3 x y \\left(2 x + 3 y\\right)}{\\left(2 x + 3 y - z\\right)^{2}}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(- \\frac{6 x y z}{\\left(- 2 x - 3 y + z\\right)^{2}} - \\frac{3 y z}{- 2 x - 3 y + z})\\,\\mathbf i+(- \\frac{9 x y z}{\\left(- 2 x - 3 y + z\\right)^{2}} - \\frac{3 x z}{- 2 x - 3 y + z})\\,\\mathbf j+(\\frac{3 x y z}{\\left(- 2 x - 3 y + z\\right)^{2}} - \\frac{3 x y}{- 2 x - 3 y + z})\\,\\mathbf k \\\\ ∇g(-1,-3,1) & =(\\frac{(12)(9)-(-9)(-2)}{(12)^2})\\,\\mathbf i+(\\frac{(12)(3)-(-9)(-3)}{(12)^2})\\,\\mathbf j+(\\frac{(12)(-9)-(-9)(1)}{(12)^2})\\,\\mathbf k \\\\  & =(\\frac{5}{8})\\,\\mathbf i+(\\frac{1}{16})\\,\\mathbf j+(- \\frac{11}{16})\\,\\mathbf k \\\\  & =(\\frac{5}{8})\\,\\mathbf i+(\\frac{1}{16})\\,\\mathbf j+(- \\frac{11}{16})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2534f636-728f-5cf5-84af-dcdc84233ea0" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(4 z)\\,\\mathbf k" :db/id #edb/ref 17592186551540} {:answer/id #uuid "2e1a9e97-8397-5a96-8f61-336af217a27f" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(4 z)\\,\\mathbf k" :db/id #edb/ref 17592186551544} {:answer/id #uuid "62dabc43-5bf0-5679-aa83-c9aa4bc3b568" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(4 z)\\,\\mathbf k" :db/id #edb/ref 17592186551557} {:answer/id #uuid "9253ad92-4f06-57ac-bdda-8ca58af71ba9" :answer/type {:db/ident :answer.type/math} :answer/value "(2 x^{2})\\,\\mathbf i+(2 y^{2})\\,\\mathbf j+(2 z)\\,\\mathbf k" :db/id #edb/ref 17592186551570} {:answer/id #uuid "f04ace2c-28da-5f40-9f65-67b8c99a6bc8" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(- 4 z)\\,\\mathbf k" :db/id #edb/ref 17592186551598}] :answer-field/correct {:answer/id #uuid "2e1a9e97-8397-5a96-8f61-336af217a27f" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(4 z)\\,\\mathbf k" :db/id #edb/ref 17592186551544} :answer-field/id #uuid "0e6437e4-50bc-5914-9ed8-eb13c309f091" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551537}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a201dc8-1f1f-5b87-b63b-68512a0298f7" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=2 x^{3} + 2 y^{3} + 2 z^{2}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(2 x^{3} + 2 y^{3} + 2 z^{2}) \\\\  & =(6 x^{2})+(0)+(0) \\\\  & =6 x^{2} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(2 x^{3} + 2 y^{3} + 2 z^{2}) \\\\  & =(0)+(6 y^{2})+(0) \\\\  & =6 y^{2} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(2 x^{3} + 2 y^{3} + 2 z^{2}) \\\\  & =(0)+(0)+(4 z) \\\\  & =4 z\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(4 z)\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c6f75a7-859f-5396-a003-9f5a5cf0ced9" :answer/type {:db/ident :answer.type/math} :answer/value "(- 9 x^{2})\\,\\mathbf i+(- 6 y)\\,\\mathbf j+(3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551542} {:answer/id #uuid "33cfe26e-ed4b-597a-9860-326ba2f3203a" :answer/type {:db/ident :answer.type/math} :answer/value "(9 x^{2})\\,\\mathbf i+(- 6 y)\\,\\mathbf j+(- 3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551547} {:answer/id #uuid "7796e127-39a7-5da3-9437-4640665f9876" :answer/type {:db/ident :answer.type/math} :answer/value "(9 x^{2})\\,\\mathbf i+(6 y)\\,\\mathbf j+(3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551561} {:answer/id #uuid "a6f14adf-7f6f-5747-8d85-36b5baea3154" :answer/type {:db/ident :answer.type/math} :answer/value "(3 x^{2})\\,\\mathbf i+(- 3 y)\\,\\mathbf j+(z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551575} {:answer/id #uuid "fe502b90-9d00-5050-87ec-234f3d11b647" :answer/type {:db/ident :answer.type/math} :answer/value "(9 x^{2})\\,\\mathbf i+(- 6 y)\\,\\mathbf j+(3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551601}] :answer-field/correct {:answer/id #uuid "fe502b90-9d00-5050-87ec-234f3d11b647" :answer/type {:db/ident :answer.type/math} :answer/value "(9 x^{2})\\,\\mathbf i+(- 6 y)\\,\\mathbf j+(3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551601} :answer-field/id #uuid "cb01b87a-2ca7-567f-90a9-5689440c4538" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551585}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "742ab2fb-40b9-5c49-a01c-18400e430b51" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=3 x^{3} - 3 y^{2} + z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(3 x^{3} - 3 y^{2} + z^{3}) \\\\  & =(9 x^{2})+(0)+(0) \\\\  & =9 x^{2} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(3 x^{3} - 3 y^{2} + z^{3}) \\\\  & =(0)+(- 6 y)+(0) \\\\  & =- 6 y \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(3 x^{3} - 3 y^{2} + z^{3}) \\\\  & =(0)+(0)+(3 z^{2}) \\\\  & =3 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(9 x^{2})\\,\\mathbf i+(- 6 y)\\,\\mathbf j+(3 z^{2})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05505486-92c7-55a4-9cb3-d01cdfa3a238" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{45}{64})\\,\\mathbf i+(- \\frac{75}{128})\\,\\mathbf j+(- \\frac{57}{128})\\,\\mathbf k" :db/id #edb/ref 17592186551534} {:answer/id #uuid "ab289eb6-ba72-5080-9b39-a3d30df93602" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{27}{64})\\,\\mathbf i+(- \\frac{21}{128})\\,\\mathbf j+(- \\frac{39}{128})\\,\\mathbf k" :db/id #edb/ref 17592186551576} {:answer/id #uuid "d8f42c0b-0803-5b4d-8016-ffcfa69893e6" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{9}{16})\\,\\mathbf i+(- \\frac{3}{8})\\,\\mathbf j+(- \\frac{3}{8})\\,\\mathbf k" :db/id #edb/ref 17592186551588} {:answer/id #uuid "e3b6ffbe-06e6-5a8e-aa0d-15175a4f5276" :answer/type {:db/ident :answer.type/math} :answer/value "(-108)\\,\\mathbf i+(-42)\\,\\mathbf j+(-78)\\,\\mathbf k" :db/id #edb/ref 17592186551590} {:answer/id #uuid "e84af700-5850-5c73-acbb-9a21f7272a45" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{9}{64})\\,\\mathbf i+(\\frac{27}{128})\\,\\mathbf j+(\\frac{9}{128})\\,\\mathbf k" :db/id #edb/ref 17592186551594}] :answer-field/correct {:answer/id #uuid "ab289eb6-ba72-5080-9b39-a3d30df93602" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{27}{64})\\,\\mathbf i+(- \\frac{21}{128})\\,\\mathbf j+(- \\frac{39}{128})\\,\\mathbf k" :db/id #edb/ref 17592186551576} :answer-field/id #uuid "14b7b09b-52da-5d72-b8df-bfa64684203c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551538}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "74938ef6-c9c2-59ba-827d-91ac5ff5232a" :question/problem "Evaluate $∇g(x,y,z)$ at the point $(-2,-3,-3)$ if $g(x,y,z)=\\frac{x y z}{2 x + 3 y + z}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{x y z}{2 x + 3 y + z}) \\\\  & =\\frac{(2 x + 3 y + z)(y z)-(x y z)(2)}{(2 x + 3 y + z)^2} \\\\  & =\\frac{y z \\left(3 y + z\\right)}{\\left(2 x + 3 y + z\\right)^{2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\frac{x y z}{2 x + 3 y + z}) \\\\  & =\\frac{(2 x + 3 y + z)(x z)-(x y z)(3)}{(2 x + 3 y + z)^2} \\\\  & =\\frac{x z \\left(2 x + z\\right)}{\\left(2 x + 3 y + z\\right)^{2}} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{x y z}{2 x + 3 y + z}) \\\\  & =\\frac{(2 x + 3 y + z)(x y)-(x y z)(1)}{(2 x + 3 y + z)^2} \\\\  & =\\frac{x y \\left(2 x + 3 y\\right)}{\\left(2 x + 3 y + z\\right)^{2}}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(- \\frac{2 x y z}{\\left(2 x + 3 y + z\\right)^{2}} + \\frac{y z}{2 x + 3 y + z})\\,\\mathbf i+(- \\frac{3 x y z}{\\left(2 x + 3 y + z\\right)^{2}} + \\frac{x z}{2 x + 3 y + z})\\,\\mathbf j+(- \\frac{x y z}{\\left(2 x + 3 y + z\\right)^{2}} + \\frac{x y}{2 x + 3 y + z})\\,\\mathbf k \\\\ ∇g(-2,-3,-3) & =(\\frac{(-16)(9)-(-18)(2)}{(-16)^2})\\,\\mathbf i+(\\frac{(-16)(6)-(-18)(3)}{(-16)^2})\\,\\mathbf j+(\\frac{(-16)(6)-(-18)(1)}{(-16)^2})\\,\\mathbf k \\\\  & =(- \\frac{27}{64})\\,\\mathbf i+(- \\frac{21}{128})\\,\\mathbf j+(- \\frac{39}{128})\\,\\mathbf k \\\\  & =(- \\frac{27}{64})\\,\\mathbf i+(- \\frac{21}{128})\\,\\mathbf j+(- \\frac{39}{128})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551568 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81d55087-53de-5def-b995-b769126d00f5" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551563} {:answer/id #uuid "8d95b908-a2f2-59f4-aaca-fa9ce8ef8b04" :answer/type {:db/ident :answer.type/math} :answer/value "(-6)\\,\\mathbf i+(30)\\,\\mathbf j+(30)\\,\\mathbf k" :db/id #edb/ref 17592186551569} {:answer/id #uuid "d5d497b4-435f-5624-a8cc-86c18fe21fbe" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{1}{2})\\,\\mathbf i+(\\frac{1}{3})\\,\\mathbf j+(- \\frac{1}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551587} {:answer/id #uuid "df4d1565-00b7-563a-8e03-f75c2a4a977d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{5}{6})\\,\\mathbf i+(\\frac{1}{6})\\,\\mathbf j+(\\frac{7}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551589} {:answer/id #uuid "e47b5c86-36b9-58a9-bb61-fa06357f423b" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{3})\\,\\mathbf i+(\\frac{1}{2})\\,\\mathbf j+(1)\\,\\mathbf k" :db/id #edb/ref 17592186551591}] :answer-field/correct {:answer/id #uuid "81d55087-53de-5def-b995-b769126d00f5" :answer/type {:db/ident :answer.type/math} :answer/value "(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k" :db/id #edb/ref 17592186551563} :answer-field/id #uuid "8215a9cc-2670-5708-bd8e-57a5e6c7615b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551564}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b44dc16-f32d-574a-a1bc-0e76d52e0a5c" :question/problem "Evaluate $∇g(x,y,z)$ at the point $(3,2,1)$ if $g(x,y,z)=\\frac{x y z}{3 x - 2 y + z}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{x y z}{3 x - 2 y + z}) \\\\  & =\\frac{(3 x - 2 y + z)(y z)-(x y z)(3)}{(3 x - 2 y + z)^2} \\\\  & =- \\frac{y z \\left(2 y - z\\right)}{\\left(3 x - 2 y + z\\right)^{2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\frac{x y z}{3 x - 2 y + z}) \\\\  & =\\frac{(3 x - 2 y + z)(x z)-(x y z)(-2)}{(3 x - 2 y + z)^2} \\\\  & =\\frac{x z \\left(3 x + z\\right)}{\\left(3 x - 2 y + z\\right)^{2}} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\frac{x y z}{3 x - 2 y + z}) \\\\  & =\\frac{(3 x - 2 y + z)(x y)-(x y z)(1)}{(3 x - 2 y + z)^2} \\\\  & =\\frac{x y \\left(3 x - 2 y\\right)}{\\left(3 x - 2 y + z\\right)^{2}}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(- \\frac{3 x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{y z}{3 x - 2 y + z})\\,\\mathbf i+(\\frac{2 x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{x z}{3 x - 2 y + z})\\,\\mathbf j+(- \\frac{x y z}{\\left(3 x - 2 y + z\\right)^{2}} + \\frac{x y}{3 x - 2 y + z})\\,\\mathbf k \\\\ ∇g(3,2,1) & =(\\frac{(6)(2)-(6)(3)}{(6)^2})\\,\\mathbf i+(\\frac{(6)(3)-(6)(-2)}{(6)^2})\\,\\mathbf j+(\\frac{(6)(6)-(6)(1)}{(6)^2})\\,\\mathbf k \\\\  & =(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k \\\\  & =(- \\frac{1}{6})\\,\\mathbf i+(\\frac{5}{6})\\,\\mathbf j+(\\frac{5}{6})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71d0f352-5436-5a7b-9f8e-7209188bcf4b" :answer/type {:db/ident :answer.type/math} :answer/value "(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551558} {:answer/id #uuid "84f87ee6-84ac-512f-a950-3b2c1fa07a24" :answer/type {:db/ident :answer.type/math} :answer/value "(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(- 9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551565} {:answer/id #uuid "9deaa07f-ccfb-572f-879a-a66037f1a2ad" :answer/type {:db/ident :answer.type/math} :answer/value "(- 4 x)\\,\\mathbf i+(3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551572} {:answer/id #uuid "a1432f04-c811-5d61-9930-fed90819117f" :answer/type {:db/ident :answer.type/math} :answer/value "(4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551574} {:answer/id #uuid "ef7650a3-aae8-5c47-92a2-7df98f7b92e3" :answer/type {:db/ident :answer.type/math} :answer/value "(- 2 x)\\,\\mathbf i+(- y^{2})\\,\\mathbf j+(3 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551597}] :answer-field/correct {:answer/id #uuid "71d0f352-5436-5a7b-9f8e-7209188bcf4b" :answer/type {:db/ident :answer.type/math} :answer/value "(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551558} :answer-field/id #uuid "02154e13-b680-5f7c-abaf-30774d8ae771" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551533}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d159fc9-a74b-5bd1-b271-b0154d57fc6f" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=- 2 x^{2} - y^{3} + 3 z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(- 2 x^{2} - y^{3} + 3 z^{3}) \\\\  & =(- 4 x)+(0)+(0) \\\\  & =- 4 x \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(- 2 x^{2} - y^{3} + 3 z^{3}) \\\\  & =(0)+(- 3 y^{2})+(0) \\\\  & =- 3 y^{2} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(- 2 x^{2} - y^{3} + 3 z^{3}) \\\\  & =(0)+(0)+(9 z^{2}) \\\\  & =9 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(- 4 x)\\,\\mathbf i+(- 3 y^{2})\\,\\mathbf j+(9 z^{2})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "426f4d6f-642a-5cd9-b16a-cc631e6f86ae" :answer/type {:db/ident :answer.type/math} :answer/value "(2 x^{2})\\,\\mathbf i+(- 2 y^{2})\\,\\mathbf j+(5 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551549} {:answer/id #uuid "4d57ee26-d55e-5492-9255-c4b8b94d066c" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(- 15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551552} {:answer/id #uuid "9f2ddc6e-f3c6-5eba-8696-ca36ae673a3f" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551573} {:answer/id #uuid "bef8af72-93b9-521d-a5d5-f563c2d8a9d2" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551582} {:answer/id #uuid "e4e9e0f9-babc-5eff-9c2f-c58e34b69e42" :answer/type {:db/ident :answer.type/math} :answer/value "(- 6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551592}] :answer-field/correct {:answer/id #uuid "bef8af72-93b9-521d-a5d5-f563c2d8a9d2" :answer/type {:db/ident :answer.type/math} :answer/value "(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551582} :answer-field/id #uuid "577176ee-b9f7-5420-8473-fc7dc26c6dc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551554}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce3e8301-9f22-51e6-b4bd-79ce231d33ce" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=2 x^{3} - 2 y^{3} + 5 z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(2 x^{3} - 2 y^{3} + 5 z^{3}) \\\\  & =(6 x^{2})+(0)+(0) \\\\  & =6 x^{2} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(2 x^{3} - 2 y^{3} + 5 z^{3}) \\\\  & =(0)+(- 6 y^{2})+(0) \\\\  & =- 6 y^{2} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(2 x^{3} - 2 y^{3} + 5 z^{3}) \\\\  & =(0)+(0)+(15 z^{2}) \\\\  & =15 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(6 x^{2})\\,\\mathbf i+(- 6 y^{2})\\,\\mathbf j+(15 z^{2})\\,\\mathbf k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186551595 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c128f7d-55b7-5fe3-a35b-3b916bfae8b9" :answer/type {:db/ident :answer.type/math} :answer/value "(x^{2})\\,\\mathbf i+(2 y)\\,\\mathbf j+(2 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551536} {:answer/id #uuid "3f9dc42d-4e9b-519d-865d-778adf7e4f13" :answer/type {:db/ident :answer.type/math} :answer/value "(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551548} {:answer/id #uuid "6124a3e9-e1c2-5acb-817f-8f58072e8d0b" :answer/type {:db/ident :answer.type/math} :answer/value "(3 x^{2})\\,\\mathbf i+(- 4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551556} {:answer/id #uuid "b78b0ba8-034f-5202-a5ee-87b1178a0c88" :answer/type {:db/ident :answer.type/math} :answer/value "(- 3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551580} {:answer/id #uuid "fbd7f76b-8056-5d2d-a7f3-bfc6aad16c17" :answer/type {:db/ident :answer.type/math} :answer/value "(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(- 6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551600}] :answer-field/correct {:answer/id #uuid "3f9dc42d-4e9b-519d-865d-778adf7e4f13" :answer/type {:db/ident :answer.type/math} :answer/value "(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k" :db/id #edb/ref 17592186551548} :answer-field/id #uuid "f620b0c8-071e-5fea-bd5b-cbc98758de3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551599}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed666d31-fef8-5eb5-a5ef-be7ba8d33a2a" :question/problem "Find $∇g(x,y,z)$ given that $g(x,y,z)=x^{3} + 2 y^{2} + 2 z^{3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(x^{3} + 2 y^{2} + 2 z^{3}) \\\\  & =(3 x^{2})+(0)+(0) \\\\  & =3 x^{2} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(x^{3} + 2 y^{2} + 2 z^{3}) \\\\  & =(0)+(4 y)+(0) \\\\  & =4 y \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(x^{3} + 2 y^{2} + 2 z^{3}) \\\\  & =(0)+(0)+(6 z^{2}) \\\\  & =6 z^{2}\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\,\\mathbf i+{g}_{y}(x,y,z)\\,\\mathbf j+{g}_{z}(x,y,z)\\,\\mathbf k \\\\  & =(3 x^{2})\\,\\mathbf i+(4 y)\\,\\mathbf j+(6 z^{2})\\,\\mathbf k\\end{aligned}\n$$"}] :knowledge-point/title "Calculating the Gradient of a Function of Three Variables"}]}
