#{[{:db/id #edb/ref 17592186124444 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124248 :question/id #uuid "bfade25e-065a-5c66-a554-9ee4e9559a55" :question/math-academy-id "e-3132" :question/problem "Evaluate $\\nabla g(x,y,z)$   at $(2,-1,3)$ if $g(x,y,z) = x^2 + xyz.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}+xyz) \\\\  & =2x+yz \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}+xyz) \\\\  & =0+xz \\\\  & =xz \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}+xyz) \\\\  & =0+xy \\\\  & =xy\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =(2x+yz)\\text{ }i+(xz)\\text{ }j+(xy)\\text{ }k \\\\ ∇g(2,-1,3) & =(2(2)+(-1)(3))\\text{ }i+2(3)\\text{ }j+2(-1)\\text{ }k \\\\  & =1\\text{ }i+6\\text{ }j-2\\text{ }k \\\\  & =i+6\\text{ }j-2\\text{ }k.\\end{aligned}\n$$"} :knowledge-point/id #uuid "fe2c7ce2-f053-57af-9f4d-54bd3a41648a" :knowledge-point/question-generator {:db/id #edb/ref 17592186551602 :question-generator/id #uuid "194af7fd-f43e-5bd8-9289-861bc15c4aa0" :question-generator/script "generate/scratch/17592186124444.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186125020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35a99596-2194-56d8-b34a-8cf33e24d509" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{xyz}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186321558} {:answer/id #uuid "6fa3bf93-c16d-5b28-921e-41079fe50f98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xyz}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322014} {:answer/id #uuid "bdfd3cdb-b6de-5b57-8bc2-55f6cfdc0358" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322622} {:answer/id #uuid "ce59c82e-5d51-5485-be48-7fb4d8c385b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{xyz}}{2}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/id #edb/ref 17592186322758} {:answer/id #uuid "def79f1e-967d-536d-901e-8b6506e4e5d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{xyz}(\\frac{1}{yz}\\text{ }i+\\frac{1}{xz}\\text{ }j+\\frac{1}{xz}\\text{ }k)" :db/id #edb/ref 17592186322890}] :answer-field/correct {:answer/id #uuid "bdfd3cdb-b6de-5b57-8bc2-55f6cfdc0358" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/id #edb/ref 17592186322622} :answer-field/id #uuid "b1682cef-8ea8-5e2a-8b48-c4bffce5ce2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4903eb08-1095-52c0-bd3a-a8d7c39455f8" :question/math-academy-id "q-36918" :question/problem "Given $f(x,y,z)=\\sqrt{xyz}$, find $∇f(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (yz) \\\\  & =\\frac{\\sqrt{xyz}}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xz) \\\\  & =\\frac{\\sqrt{xyz}}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xy) \\\\  & =\\frac{\\sqrt{xyz}}{2z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2x}\\text{ }i+\\frac{\\sqrt{xyz}}{2y}\\text{ }j+\\frac{\\sqrt{xyz}}{2z}\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186125022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e393b4-8a81-5128-9ba6-326770dd3c30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k" :db/id #edb/ref 17592186321197} {:answer/id #uuid "46cf9748-7a8c-51e8-a98f-bf480e7d4abd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{yz}\\text{ }j+\\frac{1}{yz}\\text{ }k" :db/id #edb/ref 17592186321705} {:answer/id #uuid "5277d147-5423-52ea-9448-c91d7f890aac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2\\sqrt{y}}\\text{ }j+\\frac{1}{2\\sqrt{z}}\\text{ }k" :db/id #edb/ref 17592186321796} {:answer/id #uuid "76d89040-9cda-5314-8747-132b54e35625" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2yz}\\text{ }j+\\frac{1}{2yz}\\text{ }k" :db/id #edb/ref 17592186322073} {:answer/id #uuid "fa45680f-55c0-5cbc-847f-d3b13a4ac29e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k" :db/id #edb/ref 17592186323119}] :answer-field/correct {:answer/id #uuid "05e393b4-8a81-5128-9ba6-326770dd3c30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k" :db/id #edb/ref 17592186321197} :answer-field/id #uuid "4bd27916-0e07-570f-8b09-3b81d2a1b865" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e287a6b3-141e-5735-ae69-360760a9ed55" :question/math-academy-id "q-36968" :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)=\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =\\frac{1}{2\\sqrt{x+2}}+0 \\\\  & =\\frac{1}{2\\sqrt{x+2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot z \\\\  & =\\frac{1}{2y} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot y \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0404f2a9-3d08-5a53-a026-f44a816bf37f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{ }i+\\frac{1}{3}\\text{ }j+k" :db/id #edb/ref 17592186321188} {:answer/id #uuid "13134d6f-499b-591c-bde5-f5b16ff56598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{ }i+\\frac{\\sqrt{6}}{6}\\text{ }j-\\frac{\\sqrt{2}}{2}\\text{ }k" :db/id #edb/ref 17592186321294} {:answer/id #uuid "39e1fd9f-c905-53ce-88ed-48a994829d3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k" :db/id #edb/ref 17592186321589} {:answer/id #uuid "457eb332-a887-58f4-9e71-5175afe5b10a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{ }i+6\\text{ }j-2\\text{ }k" :db/id #edb/ref 17592186321697} {:answer/id #uuid "6f462375-be9f-527c-9fe5-1e84d47ed3f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\text{ }i+\\frac{1}{3}\\text{ }j-k" :db/id #edb/ref 17592186322010}] :answer-field/correct {:answer/id #uuid "39e1fd9f-c905-53ce-88ed-48a994829d3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k" :db/id #edb/ref 17592186321589} :answer-field/id #uuid "c77c2c1d-e1c1-5a2d-9ca2-89a1901c372b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323562}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5313963c-57a3-55b2-bdc3-c997dcee0402" :question/math-academy-id "q-36969" :question/problem "Evaluate $∇f(x,y,z)$ at the point $(2,3,1)$ if $f(x,y,z)=\\operatorname{ln}⁡(\\sqrt{xyz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot yz \\\\  & =\\frac{1}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot xz \\\\  & =\\frac{1}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot xy \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\n \n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{x}(x,y,z)\\text{ }j+{f}_{x}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2x}\\text{ }i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k \\\\ ∇f(2,3,1) & =\\frac{1}{2\\cdot 2}\\text{ }i+\\frac{1}{2\\cdot 3}\\text{ }j+\\frac{1}{2\\cdot 1}\\text{ }k \\\\  & =\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c165a4b-7842-5080-b22d-dd998f4efc33" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡(yz+zx)\\text{ }i+y\\operatorname{ln}⁡(yz+zx)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/id #edb/ref 17592186336145} {:answer/id #uuid "546a