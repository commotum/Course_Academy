x}^{3}+6x) \\\\  & ={e}^{x}-{x}^{3}-6x\\end{aligned}\n$$\n\nUsing the addition and power rules, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}k}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}-{x}^{3}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-6\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}-3{x}^{2}-6.\\end{aligned}\n$$" 13194139535211 17592186045443 true] [17592186480093 1068 #edb/ref 17592186480066 13194139535211 17592186045443 true] [17592186480093 1070 #edb/ref 17592186045485 13194139535211 17592186045443 true] [17592186480093 1071 "Given that $g(x)=4{e}^{x}-2{x}^{2}+8$, find the slope of the tangent at $x=1.$" 13194139535211 17592186045443 true] [17592186480093 1072 #uuid "bf13a195-c5b0-5308-8807-0ec8ba1fef3d" 13194139535211 17592186045443 true] [17592186480093 1074 "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =4{e}^{x}-4x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=1} & ={(4{e}^{x}-4x)\\,|}_{x=1} \\\\  & =4{e}^{1}-4\\cdot 1 \\\\  & =-4 + 4 e.\\end{aligned}\n$$" 13194139535211 17592186045443 true] [17592186480094 1080 "- 16 x^{3} - 12 x + 4 {e}^{x}" 13194139535211 17592186045443 true] [17592186480094 1082 #edb/ref 17592186045498 13194139535211 17592186045443 true] [17592186480094 1083 #uuid "ce2ef1c3-3f13-5ad5-876a-a8446bfc2aa3" 13194139535211 17592186045443 true] [17592186480095 1080 "2 + 4 e" 13194139535211 17592186045443 true] [17592186480095 1082 #edb/ref 17592186045498 13194139535211 