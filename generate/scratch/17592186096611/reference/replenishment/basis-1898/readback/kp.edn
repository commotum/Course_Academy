2} + 11" :db/id #edb/ref 17592186093918} {:answer/id #uuid "40a2b5e2-dd64-5f79-8261-69a8583333bc" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 9e^{x} - 18x^{2} + 11x - 20" :db/id #edb/ref 17592186093919}] :answer-field/id #uuid "053a4625-88a6-57b5-8eec-5cc8d2d0e629" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093914}] :question/id #uuid "b6d07184-6bd9-5ef7-9517-a325fafb836a" :question/math-academy-id "q-11730" :question/problem "Given that $f(x) = 9e^{x} - 9x^{2} + 11x - 20$, find $f^{′}(x)$."} {:db/id #edb/ref 17592186235457 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7467eff-3284-5ff8-926d-e47188223d29" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{x}-3{x}^{2}-2" :db/id #edb/ref 17592186234908}] :answer-field/correct {:answer/id #uuid "e7467eff-3284-5ff8-926d-e47188223d29" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{x}-3{x}^{2}-2" :db/id #edb/ref 17592186234908} :answer-field/id #uuid "75fbad98-0a41-5480-ba06-edccdf81f980" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "413988df-903b-557d-87b6-8594e3b605b0" :question/math-academy-id "q-167636" :question/problem "If $k(x)=g(x)-f(x),$ where $A=2$ and $B=3,$ then $\\frac{\\text{d}k}{\\text{d}x}=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "We found that $A=2$ and $B=3$ in steps 3 and 4, respectively. Therefore, we have\n\n$$\n\\begin{aligned}y & =g(x)-f(x) \\\\  & =3{e}^{x}-({x}^{3}+2x) \\\\  & =3{e}^{x}-{x}^{3}-2x\\end{aligned}\n$$\n\nUsing the addition and power rules, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}k}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x}-{x}^{3}-2x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{e}^{x}+\\frac{\\text{d}}{\\text{d}x}(-{x}^{3})+\\frac{\\text{d}}{\\text{d}x}(-2x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-2\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3{e}^{x}-3{x}^{2}-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235471 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58606740-b081-5671-ab93-5b28309b7d77" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+2x+1" :db/id #edb/ref 17592186234683}] :answer-field/correct {:answer/id #uuid "58606740-b081-5671-ab93-5b28309b7d77" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}+2x+1" :db/id #edb/ref 17592186234683} :answer-field/id #uuid "d0bd4a86-aed0-5919-98b7-ad23d53bddbe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235226}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfc04756-ffae-5a03-8a05-d0ea5dfb5207" :question/math-academy-id "q-167694" :question/problem "For $x<1,$ ${f}^{′}(x)=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." :question/worked-solution "For $x<1,$ we use the expression $f(x)={e}^{x}+{x}^{2}+x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}+{x}^{2}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})+\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}+2x+1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272085 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/ident :answer.type/math} :answer/value "e+4" :db/id #edb/ref 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/ident :answer.type/math} :answer/value "e+8" :db/id #edb/ref 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/ident :answer.type/math} :answer/value "2e+4" :db/id #edb/ref 17592186270388}] :answer-field/correct {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272086 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1859eb59-5659-5101-b949-46d66d579831" :answer/type {:db/ident :answer.type/math} :answer/value "8e" :db/id #edb/ref 17592186269472} {:answer/id #uuid "1c0e81a7-1d07-50d3-b00e-dd0c50955d37" :answer/type {:db/ident :answer.type/math} :answer/value "2+6e" :db/id #edb/ref 17592186269501} {:answer/id #uuid "2d71f9f8-72d8-5409-b4ca-0645cd6983b2" :answer/type {:db/ident :answer.type/math} :answer/value "1+6e" :db/id #edb/ref 17592186269679} {:answer/id #uuid "c2ca486a-dc13-5bb9-932e-532847144371" :answer/type {:db/ident :answer.type/math} :answer/value "6e" :db/id #edb/ref 17592186270990} {:answer/id #uuid "c5a796d4-403d-5aad-82ff-004acd0b4a0e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186271012}] :answer-field/correct {:answer/id #uuid "c5a796d4-403d-5aad-82ff-004acd0b4a0e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186271012} :answer-field/id #uuid "d0c8b5dd-9fdc-5213-98ff-f269c094b6e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "578adda7-12d4-5f1e-a8c7-f591ce6d42cb" :question/math-academy-id "q-140432" :question/problem "Given that $f(x)={x}^{2}+2x+6{e}^{x}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+2x+6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x)+\\frac{\\text{d}}{\\text{d}x}(6{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+6\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =2x+2+6{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2x+2+6{e}^{x})\\,|}_{x=0} \\\\  & =2\\cdot 0+2+6\\cdot {e}^{0} \\\\  & =2+6\\cdot 1 \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284688 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "397833d7-9cc6-50ae-8de7-3a5674155a04" :answer/type {:db/ident :answer.type/math} :answer/value "2e-6" :db/id #edb/ref 17592186282196} {:answer/id #uuid "8d66fe18-2e0a-548c-a20c-052aa8a29cde" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186282914} {:answer/id #uuid "cfc41fd0-6fd9-5709-9af2-b2dd6b711472" :answer/type {:db/ident :answer.type/math} :answer/value "-4e" :db/id #edb/ref 17592186283503} {:answer/id #uuid "df2ebee4-e1b4-5f85-bbbc-9c810b46a256" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283637} {:answer/id #uuid "fe32be51-d0ac-5644-92b4-204731798028" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283920}] :answer-field/correct {:answer/id #uuid "df2ebee4-e1b4-5f85-bbbc-9c810b46a256" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283637} :answer-field/id #uuid "34cf92cc-bcc5-56af-93bf-714a48258bfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284027}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5816a349-a320-5d09-93fc-2ee07a9147af" :question/math-academy-id "q-17247" :question/problem "Given that $f(x)=2{e}^{x}-3{x}^{2}$, find the slope of the tangent at $x=0.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}-3{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})-3\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\  & =2{e}^{x}-3(2x) \\\\  & =2{e}^{x}-6x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(2{e}^{x}-6x)\\,|}_{x=0} \\\\  & =2{e}^{0}-6\\cdot 0 \\\\  & =2\\cdot 1-0 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284689 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54ad567a-37aa-5c67-8461-48b832a97b6d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282410} {:answer/id #uuid "84f495d5-d4be-5db4-8f35-da2bca8cfe2e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186282836} {:answer/id #uuid "9e412a36-003f-51b6-80db-13d3f13969a1" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283068} {:answer/id #uuid "a99e9fb3-9911-531b-94e1-18309a3f6530" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186283157} {:answer/id #uuid "b8bf7484-ada1-5d36-86d4-7dceaa4a2600" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283288}] :answer-field/correct {:answer/id #uuid "54ad567a-37aa-5c67-8461-48b832a97b6d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282410} :answer-field/id #uuid "114801c2-0284-5663-a95f-f2fe249472cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283967}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a7bb16ef-b727-58e4-9164-1a907f3660c1" :question/math-academy-id "q-17255" :question/problem "Given that $f(x)=11{e}^{x}+8{x}^{2}-12x-20$, find the slope of the tangent at $x=0.$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(11{e}^{x}+8{x}^{2}-12x-20) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(11{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(8{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(12x)-\\frac{\\text{d}}{\\text{d}x}(20) \\\\  & =11\\frac{\\text{d}}{\\text{d}x}({e}^{x})+8\\frac{\\text{d}}{\\text{d}x}({x}^{2})-12\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(20) \\\\  & =11{e}^{x}+8(2x)-12(1)-0 \\\\  & =11{e}^{x}+16x-12.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(11{e}^{x}+16x-12)|}_{x=0} \\\\  & =11{e}^{0}+16\\cdot 0-12 \\\\  & =11\\cdot 1+0-12 \\\\  & =11-12 \\\\  & =-1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297289 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b89210db-d5da-5a48-8355-741becb1873c" :answer/type {:db/ident :answer.type/math} :answer/value "42+\\frac{2}{e}" :db/id #edb/ref 17592186296232} {:answer/id #uuid "c4f887ee-f564-4711-a252-4f52754bf8ba" :answer/type {:db/ident :answer.type/math} :answer/value "42x^6+2e^{x}" :db/id #edb/ref 17592186409338}] :answer-field/correct {:answer/id #uuid "b89210db-d5da-5a48-8355-741becb1873c" :answer/type {:db/ident :answer.type/math} :answer/value "42+\\frac{2}{e}" :db/id #edb/ref 17592186296232} :answer-field/id #uuid "ca439fbc-124d-5dae-b8b3-a85cb6575e03" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f66d07e-3ca1-595a-b1d7-b4c775329676" :question/math-academy-id "q-304035" :question/problem "Given that $f(x)=6{x}^{7}+2{e}^{x}$, the exact value of the slope of the tangent line at $x=-1$ is{{field-1}}." :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7}+2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =6(7{x}^{6})+2{e}^{x} \\\\  & =42{x}^{6}+2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=-1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=-1} & ={(42{x}^{6}+2{e}^{x})\\,|}_{x=-1} \\\\  & =42(-1)^{6}+2{e}^{-1} \\\\  & =42\\cdot 1+\\frac{2}{e} \\\\  & =42+\\frac{2}{e}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480052 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61b7b5eb-6695-5cdb-b928-2b039d8e4cd9" :answer/type {:db/ident :answer.type/math} :answer/value "- 20 x^{4} + 3 x^{2} + 5 {e}^{x}" :db/id #edb/ref 17592186480074}] :answer-field/correct {:answer/id #uuid "61b7b5eb-6695-5cdb-b928-2b039d8e4cd9" :answer/type {:db/ident :answer.type/math} :answer/value "- 20 x^{4} + 3 x^{2} + 5 {e}^{x}" :db/id #edb/ref 17592186480074} :answer-field/id #uuid "5a6a95ad-af06-5f55-8efc-70a879f8ac32" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480072}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e3e6e3a-5c3f-5613-b235-49ab4e4951fc" :question/problem "Given that $f(x)=5{e}^{x}-4{x}^{5}+{x}^{3}$, find $f'(x)=$ {{field-1}}." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}-4{x}^{5}+{x}^{3}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{5})+\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =5{e}^{x}-4(5{x}^{4})+(3{x}^{2}) \\\\ & =5{e}^{x}-20{x}^{4}+3{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480057 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f70bcf6b-0eae-5fdb-94c5-ea8959f9943c" :answer/type {:db/ident :answer.type/math} :answer/value "- 49 x^{6} + 6 x^{2} - 2 {e}^{x}" :db/id #edb/ref 17592186480105}] :answer-field/correct {:answer/id #uuid "f70bcf6b-0eae-5fdb-94c5-ea8959f9943c" :answer/type {:db/ident :answer.type/math} :answer/value "- 49 x^{6} + 6 x^{2} - 2 {e}^{x}" :db/id #edb/ref 17592186480105} :answer-field/id #uuid "35489f8d-5df1-5e29-95eb-b93675d66f48" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480061}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2463bece-a1cd-5c87-bc99-c540684a9946" :question/problem "Given that $f(x)=-2{e}^{x}-7{x}^{7}+2{x}^{3}$, find $f'(x)=$ {{field-1}}." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}-7{x}^{7}+2{x}^{3}) \\\\ & =-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ & =-2\\frac{\\text{d}}{\\text{d}x}({e}^{x})-7\\frac{\\text{d}}{\\text{d}x}({x}^{7})+2\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =-2{e}^{x}-7(7{x}^{6})+2(3{x}^{2}) \\\\ & =-2{e}^{x}-49{x}^{6}+6{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480059 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264ccd5d-6b21-5116-803e-90fb1b12042d" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x^{3} - 4 x + 7 {e}^{x}" :db/id #edb/ref 17592186480058}] :answer-field/correct {:answer/id #uuid "264ccd5d-6b21-5116-803e-90fb1b12042d" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x^{3} - 4 x + 7 {e}^{x}" :db/id #edb/ref 17592186480058} :answer-field/id #uuid "e4b110e6-b7b5-5fac-a96e-aad7e57c2219" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480099}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "28f1a34b-c02b-5f32-a2d4-3b8647e374de" :question/problem "Given that $f(x)=7{e}^{x}-2{x}^{4}-2{x}^{2}$, find $f'(x)=$ {{field-1}}." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{4}-2{x}^{2}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{4})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{4})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\ & =7{e}^{x}-2(4{x}^{3})-2(2x) \\\\ & =7{e}^{x}-8{x}^{3}-4x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480063 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8385fd8-392a-5b32-9696-5e38de0d0d87" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x + 4 {e}^{x} - 6" :db/id #edb/ref 17592186480106}] :answer-field/correct {:answer/id #uuid "f8385fd8-392a-5b32-9696-5e38de0d0d87" :answer/type {:db/ident :answer.type/math} :answer/value "- 8 x + 4 {e}^{x} - 6" :db/id #edb/ref 17592186480106} :answer-field/id #uuid "086120ff-05da-5c65-b0da-0f61f2c27711" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39b1266c-5944-5dcf-b535-d35e41bcefcb" :question/problem "For $x<-3$, let $f(x)=4{e}^{x}-4{x}^{2}-6x$. Then $f'(x)=$ {{field-1}}." :question/worked-solution "For $x<-3,$ we use the expression $f(x)=4{e}^{x}-4{x}^{2}-6x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-4{x}^{2}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =4{e}^{x}-8x-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480079 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c077cd0-2351-59df-ad6c-8aab69280242" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x^{2} + 7 {e}^{x}" :db/id #edb/ref 17592186480051} {:answer/id #uuid "4524e138-4f75-58ce-8eac-a0ba2babd8e1" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x + 7 {e}^{x}" :db/id #edb/ref 17592186480068} {:answer/id #uuid "4c18906d-af9d-50af-a0a0-606329921b7f" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 2 x^{2} + 7 {e}^{x} + 1" :db/id #edb/ref 17592186480070} {:answer/id #uuid "e5b2aa22-455a-598e-b62b-e07e581f6245" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4 x + 7 {e}^{x}" :db/id #edb/ref 17592186480100} {:answer/id #uuid "e93b103b-69d5-54b8-8835-73ba24248ebe" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x" :db/id #edb/ref 17592186480102}] :answer-field/correct {:answer/id #uuid "4524e138-4f75-58ce-8eac-a0ba2babd8e1" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x + 7 {e}^{x}" :db/id #edb/ref 17592186480068} :answer-field/id #uuid "98e74756-78f6-5562-bfaf-b4a28a0ceae1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480086}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "715a8ac6-fd66-549a-b175-7f154dd14992" :question/problem "Given that $f(x) = 7{e}^{x} - 2{x}^{2} + 1$, find $f^{′}(x)$." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{2}+1) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(1) \\\\ & =7{e}^{x}-2(2x)+0 \\\\ & =7{e}^{x}-4x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480081 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d10f51fd-2edb-5a32-bc19-2e4a94080d55" :answer/type {:db/ident :answer.type/math} :answer/value "- 14 x - 2 {e}^{x} + 2" :db/id #edb/ref 17592186480096}] :answer-field/correct {:answer/id #uuid "d10f51fd-2edb-5a32-bc19-2e4a94080d55" :answer/type {:db/ident :answer.type/math} :answer/value "- 14 x - 2 {e}^{x} + 2" :db/id #edb/ref 17592186480096} :answer-field/id #uuid "eb7dd7ab-94a9-53fc-950b-f401d8d15a8b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480103}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79103b32-86de-5f9f-9f15-ae04d815512a" :question/problem "For $x<3$, let $g(x)=-2{e}^{x}-7{x}^{2}+2x$. Then $g'(x)=$ {{field-1}}." :question/worked-solution "For $x<3,$ we use the expression $g(x)=-2{e}^{x}-7{x}^{2}+2x,$ which is differentiable.\n\nUsing the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{x}-7{x}^{2}+2x) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(7{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =-2{e}^{x}-14x+2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480083 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a983cb6-7b72-5853-a038-1bcb9f44ec27" :answer/type {:db/ident :answer.type/math} :answer/value "- 14 x^{6} + 18 x^{2} + 4 {e}^{x}" :db/id #edb/ref 17592186480084}] :answer-field/correct {:answer/id #uuid "8a983cb6-7b72-5853-a038-1bcb9f44ec27" :answer/type {:db/ident :answer.type/math} :answer/value "- 14 x^{6} + 18 x^{2} + 4 {e}^{x}" :db/id #edb/ref 17592186480084} :answer-field/id #uuid "68161d67-8e36-5ab8-97c1-935106b031fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480076}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7f89f273-a11f-549a-8a60-c366a1c603b1" :question/problem "Given that $h(x)=4{e}^{x}-2{x}^{7}+6{x}^{3}$, find $h'(x)=$ {{field-1}}." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}h'(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{7}+6{x}^{3}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})+\\frac{\\text{d}}{\\text{d}x}(6{x}^{3}) \\\\ & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{7})+6\\frac{\\text{d}}{\\text{d}x}({x}^{3}) \\\\ & =4{e}^{x}-2(7{x}^{6})+6(3{x}^{2}) \\\\ & =4{e}^{x}-14{x}^{6}+18{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480088 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce2ef1c3-3f13-5ad5-876a-a8446bfc2aa3" :answer/type {:db/ident :answer.type/math} :answer/value "- 16 x^{3} - 12 x + 4 {e}^{x}" :db/id #edb/ref 17592186480094}] :answer-field/correct {:answer/id #uuid "ce2ef1c3-3f13-5ad5-876a-a8446bfc2aa3" :answer/type {:db/ident :answer.type/math} :answer/value "- 16 x^{3} - 12 x + 4 {e}^{x}" :db/id #edb/ref 17592186480094} :answer-field/id #uuid "3da98e02-f62f-53a4-9fc2-2f9137b0f0cc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480064}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a03b064f-d419-5044-8615-d5e461c22029" :question/problem "Given that $h(x)=4{e}^{x}-4{x}^{4}-6{x}^{2}$, find $h'(x)=$ {{field-1}}." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}h'(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-4{x}^{4}-6{x}^{2}) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{4})-\\frac{\\text{d}}{\\text{d}x}(6{x}^{2}) \\\\ & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{4})-6\\frac{\\text{d}}{\\text{d}x}({x}^{2}) \\\\ & =4{e}^{x}-4(4{x}^{3})-6(2x) \\\\ & =4{e}^{x}-16{x}^{3}-12x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480089 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f741772-bdac-5ed5-a560-d0b055af6796" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 2 x^{2} - 2 x + 7 {e}^{x} - 18" :db/id #edb/ref 17592186480055} {:answer/id #uuid "479af8c5-6a44-55dc-9ab9-2055ef1053b5" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = 4 x + 7 {e}^{x} + 2" :db/id #edb/ref 17592186480069} {:answer/id #uuid "55137985-cfd6-539f-9ec0-36464054b534" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x^{2} - 2 x + 7 {e}^{x}" :db/id #edb/ref 17592186480071} {:answer/id #uuid "6f7be2e7-06e7-59b3-88f3-f7ef84747c72" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x + 7 {e}^{x} - 2" :db/id #edb/ref 17592186480078} {:answer/id #uuid "7d0b85b2-e227-5623-8a7b-b5185e175d05" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x - 2" :db/id #edb/ref 17592186480082}] :answer-field/correct {:answer/id #uuid "6f7be2e7-06e7-59b3-88f3-f7ef84747c72" :answer/type {:db/ident :answer.type/math} :answer/value "f^{′}(x) = - 4 x + 7 {e}^{x} - 2" :db/id #edb/ref 17592186480078} :answer-field/id #uuid "aafc2dae-bc89-5829-a8cb-4b00486270c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8456306-9118-592b-ba3e-acf608603d3d" :question/problem "Given that $f(x) = 7{e}^{x} - 2{x}^{2} - 2x - 18$, find $f^{′}(x)$." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}f'(x) & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x}-2{x}^{2}-2x-18) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(7{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(18) \\\\ & =7\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-2\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(18) \\\\ & =7{e}^{x}-2(2x)-2(1)-0 \\\\ & =7{e}^{x}-4x-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480091 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efb720c-6b9b-574c-974f-4e3c638f5136" :answer/type {:db/ident :answer.type/math} :answer/value "g^{′}(x) = 8 x + 5 {e}^{x} - 1" :db/id #edb/ref 17592186480053} {:answer/id #uuid "0f356b7c-2ebf-5896-998d-b4ccddf5e0e0" :answer/type {:db/ident :answer.type/math} :answer/value "g^{′}(x) = - 8 x + 5 {e}^{x} + 1" :db/id #edb/ref 17592186480054} {:answer/id #uuid "232f1e72-6ccc-567c-9623-b031fc2f416b" :answer/type {:db/ident :answer.type/math} :answer/value "g^{′}(x) = - 8 x^{2} + x + 5 {e}^{x}" :db/id #edb/ref 17592186480056} {:answer/id #uuid "65f0319e-35aa-5bee-adbf-801f31daf544" :answer/type {:db/ident :answer.type/math} :answer/value "g^{′}(x) = 1 - 8 x" :db/id #edb/ref 17592186480075} {:answer/id #uuid "6d649614-428e-5c60-848d-c146e9ec3146" :answer/type {:db/ident :answer.type/math} :answer/value "g^{′}(x) = - 4 x^{2} + x + 5 {e}^{x} - 11" :db/id #edb/ref 17592186480077}] :answer-field/correct {:answer/id #uuid "0f356b7c-2ebf-5896-998d-b4ccddf5e0e0" :answer/type {:db/ident :answer.type/math} :answer/value "g^{′}(x) = - 8 x + 5 {e}^{x} + 1" :db/id #edb/ref 17592186480054} :answer-field/id #uuid "da9114b8-ab35-5b36-bac6-1ba9998ddc7d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480098}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bbc1984d-8d4d-5124-b526-4edb9aabc7e9" :question/problem "Given that $g(x) = 5{e}^{x} - 4{x}^{2} + x - 11$, find $g^{′}(x)$." :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}g'(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}-4{x}^{2}+x-11) \\\\ & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(11) \\\\ & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})-4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(11) \\\\ & =5{e}^{x}-4(2x)+(1)-0 \\\\ & =5{e}^{x}-8x+1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480092 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4240f985-39e5-562c-b2bb-d7717724b4ac" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 x^{2} + {e}^{x} - 6" :db/id #edb/ref 17592186480067}] :answer-field/correct {:answer/id #uuid "4240f985-39e5-562c-b2bb-d7717724b4ac" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 x^{2} + {e}^{x} - 6" :db/id #edb/ref 17592186480067} :answer-field/id #uuid "5b979ad6-5e79-5e4a-b8a8-3843a32c1653" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186480073}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd74a88f-3e9e-54af-946f-d004983e42ec" :question/problem "Let $f(x)={x}^{3}+6x$ and $g(x)={e}^{x}$. If $k(x)=g(x)-f(x)$, then $\\frac{\\text{d}k}{\\text{d}x}=$ {{field-1}}." :question/worked-solution "Using the given definitions, we have\n\n$$\n\\begin{aligned}k(x) & =g(x)-f(x) \\\\  & ={e}^{x}-({x}^{3}+6x) \\\\  & ={e}^{x}-{x}^{3}-6x\\end{aligned}\n$$\n\nUsing the addition and power rules, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}k}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{x}-{x}^{3}-6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\frac{\\text{d}}{\\text{d}x}(6x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{x})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})-6\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & ={e}^{x}-3{x}^{2}-6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480093 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378eaac1-345c-512c-a16b-58906597b996" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + 4 e" :db/id #edb/ref 17592186480062} {:answer/id #uuid "78a011dd-a74b-5bbc-b5d6-8275fe17ca27" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186480080} {:answer/id #uuid "9a5f9195-c783-5942-b1b6-5d4846b65829" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186480087} {:answer/id #uuid "d8570adb-6a59-51ea-b794-010013286008" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + e" :db/id #edb/ref 17592186480097} {:answer/id #uuid "f005995a-9e62-5f8e-8d5f-d4fb01df4d4f" :answer/type {:db/ident :answer.type/math} :answer/value "6 + 4 e" :db/id #edb/ref 17592186480104}] :answer-field/correct {:answer/id #uuid "378eaac1-345c-512c-a16b-58906597b996" :answer/type {:db/ident :answer.type/math} :answer/value "-4 + 4 e" :db/id #edb/ref 17592186480062} :answer-field/id #uuid "3e3ec696-1582-555e-9dbf-45a7fab2a2e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480066}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf13a195-c5b0-5308-8807-0ec8ba1fef3d" :question/problem "Given that $g(x)=4{e}^{x}-2{x}^{2}+8$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(-2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =4{e}^{x}-4x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=1} & ={(4{e}^{x}-4x)\\,|}_{x=1} \\\\  & =4{e}^{1}-4\\cdot 1 \\\\  & =-4 + 4 e.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186480107 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d12640e-9820-5eeb-9be9-8968cc21917d" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186480060} {:answer/id #uuid "3dec44db-d3cb-59f1-92b9-563c2b18a384" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186480065} {:answer/id #uuid "9696aa59-67e6-5f86-8201-e0fb228932fb" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186480085} {:answer/id #uuid "d0f3ab96-00df-566a-9cce-13458e6ae6ce" :answer/type {:db/ident :answer.type/math} :answer/value "2 + 4 e" :db/id #edb/ref 17592186480095} {:answer/id #uuid "ff0def7f-9d0e-59d5-9da7-e4ec2b08fa2c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186480108}] :answer-field/correct {:answer/id #uuid "9696aa59-67e6-5f86-8201-e0fb228932fb" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186480085} :answer-field/id #uuid "e7c52da8-18b7-553b-bb92-2561fc678ce5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186480101}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc8205dd-9383-5240-aa7c-245bff3c1e94" :question/problem "Given that $g(x)=4{e}^{x}-2{x}^{2}+6x+8$, find the slope of the tangent at $x=0.$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-2{x}^{2}+6x+8) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-2\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(8) \\\\  & =4{e}^{x}-2(2x)+6(1)+0 \\\\  & =4{e}^{x}-4x+6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}g}{\\text{d}x}|}_{x=0} & ={(4{e}^{x}-4x+6)\\,|}_{x=0} \\\\  & =4{e}^{0}-4\\cdot 0+6 \\\\  & =4\\cdot 1+0+6 \\\\  & =4+6 \\\\  & =10.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}]}
