∘}) \\\\  & =2(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(1,-\\sqrt{3}).$"} {:db/id #edb/ref 17592186354404 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given in Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08efb97a-0845-52d8-bdec-7bd31306c42b" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},-3\\sqrt{2})" :db/id #edb/ref 17592186351646} {:answer/id #uuid "230bc612-57e0-56e6-8eea-f9e3d483e43e" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},3\\sqrt{2})" :db/id #edb/ref 17592186351882} {:answer/id #uuid "338ca3df-505f-596c-a48d-5be76e527d0d" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},-3\\sqrt{2})" :db/id #edb/ref 17592186352044} {:answer/id #uuid "3fa18674-53ae-5117-b249-67885b2aced3" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{3}{2},-3\\sqrt{2})" :db/id #edb/ref 17592186352155} {:answer/id #uuid "4896ba6b-ce49-594f-aaf5-6386e658c01e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-\\frac{1}{2})" :db/id #edb/ref 17592186352234}] :answer-field/correct {:answer/id #uuid "230bc612-57e0-56e6-8eea-f9e3d483e43e" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},3\\sqrt{2})" :db/id #edb/ref 17592186351882} :answer-field/id #uuid "c1be8990-390c-5a17-b09b-6ffc2b3112fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354149}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f70a1b51-73cd-5475-aadd-7e2e3bee491f" :question/math-academy-id "q-8519" :question/problem "The point $P$ has polar coordinates $(6,{45}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate od $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =6\\operatorname{cos}⁡({45}^{∘}) \\\\ x & =6\\cdot \\frac{\\sqrt{2}}{2} \\\\ x & =3\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =6\\operatorname{sin}⁡({45}^{∘}) \\\\ y & =6\\cdot \\frac{\\sqrt{2}}{2} \\\\ y & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(3\\sqrt{2},3\\sqrt{2}).$"} {:db/id #edb/ref 17592186535347 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given in Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "512f8089-92f8-5ea3-b9a5-7abb978d3b44" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186535366} {:answer/id #uuid "86d506d9-bc5f-51aa-be8f-e3abef1c740a" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-1)" :db/id #edb/ref 17592186535378} {:answer/id #uuid "ca2d81cb-c461-5f7b-8450-71a4228b9f11" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186535393} {:answer/id #uuid "cf496e30-dd7f-59a1-b4ad-60477a502b95" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186535394} {:answer/id #uuid "ddf77d6c-88df-5387-9154-85de6f2f6acd" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-1)" :db/id #edb/ref 17592186535399}] :answer-field/correct {:answer/id #uuid "86d506d9-bc5f-51aa-be8f-e3abef1c740a" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-1)" :db/id #edb/ref 17592186535378} :answer-field/id #uuid "3687de83-0f94-52d2-bb3d-db934e50e31c" :answer-fi