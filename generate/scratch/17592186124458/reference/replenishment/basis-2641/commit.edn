 ⟨\\frac{2 \\sqrt{5}}{5},\\frac{\\sqrt{5}}{5}⟩ \\\\  & =\\frac{24 \\sqrt{5}}{5}.\\end{aligned}\n$$" 13194139535954 17592186045443 true] [17592186548196 1168 "generate/scratch/17592186124458.py" 13194139535954 17592186045443 true] [17592186548196 1169 #uuid "5a6664a7-9e7f-5d33-90c7-bb53400ff58e" 13194139535954 17592186045443 true]] :edb/tempids {"0819b00b-ddf8-51fd-b337-f67bbb68e05a" 17592186548189 "2d2d0946-fae9-532f-80d5-010b263a3d4a" 17592186548190 "66c7d9c2-81ae-5068-8c96-91f51d97a8ce" 17592186548191 "70e128fd-ce69-5958-8d26-3af81c7ff0b1" 17592186548192 "895ba611-f922-55ef-9624-62e08b1e4ef5" 17592186548193 "c4eef04d-da15-5f2a-aac3-6cfce868c8fb" 17592186548194 "e4d2c788-fb3a-5910-a90d-014c2de97596" 17592186548195 "generator" 17592186548196}}
