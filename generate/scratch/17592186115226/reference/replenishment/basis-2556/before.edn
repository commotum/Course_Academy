& -2 & 3 \\\\ -5 & 1 & 2\\end{bmatrix},\\,B=\\begin{bmatrix}8 & \\sqrt{3} & \\sqrt{7} \\\\ \\sqrt{5} & \\sqrt{6} & \\sqrt{2} \\\\ \\sqrt{7} & \\sqrt{2} & 1\\end{bmatrix},\\,C=\\begin{bmatrix}-1 & 3 & 1 \\\\ -4 & 2 & -3 \\\\ 5 & -1 & -2\\end{bmatrix}.\n$$" :question/worked-solution "We can apply the distributive law\n\n$$\nBA+BC=B(A+C).\n$$\n\nSo, we calculate $A+C$ first:\n\n$$\n\\begin{aligned}A+C & =\\begin{bmatrix}1 & -3 & -1 \\\\ 4 & -2 & 3 \\\\ -5 & 1 & 2\\end{bmatrix}+\\begin{bmatrix}-1 & 3 & 1 \\\\ -4 & 2 & -3 \\\\ 5 & -1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}BA+BC & =B(A+C) \\\\  & =\\begin{bmatrix}8 & \\sqrt{3} & \\sqrt{7} \\\\ \\sqrt{5} & \\sqrt{6} & \\sqrt{2} \\\\ \\sqrt{7} & \\sqrt{2} & 1\\end{bmatrix}\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186292858 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea" :knowledge-point/title "Calculating a Matrix Product Using the Distributive Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274faa62-4b23-54e2-ac7e-f2924e7c23d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186290794}] :answer-field/correct {:answer/id #uuid "274faa62-4b23-54e2-ac7e-f2924e7c23d9" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186290794} :answer-field/id #uuid "7cb19be5-4f4f-5fa0-a4c4-7913e344efe3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186292124} {:answer-field/choices [{:answer/id #uuid "93e87f28-94c9-5988-b696-19c20bdb9dab" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id 17592186291270}] :answer-field/correct {:answer/id #uuid "93e87f28-94c9-5988-b696-19c20bdb9dab" :answer/type {: