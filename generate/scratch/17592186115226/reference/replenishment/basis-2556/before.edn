4\\end{bmatrix},\\,B=\\begin{bmatrix}-3 & -6 & 1 \\\\ -3 & 8 & -2 \\\\ 0 & -5 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}2\\sqrt{5} & -1 & 3 \\\\ 0 & \\sqrt{3} & 4 \\\\ -2 & 3 & 5\\end{bmatrix}.\n$$\n\n|  |  | $8\\sqrt{5}$ | $-4$ | {{field-1}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $AC+BC=\\,\\,$ |  | $0$ | {{field-2}} | $16$ |  |\n|  |  | {{field-3}} | $12$ | $20$ |  |" :question/worked-solution "We apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =\\begin{bmatrix}7 & 6 & -1 \\\\ 3 & -4 & 2 \\\\ 0 & 5 & 4\\end{bmatrix}+\\begin{bmatrix}-3 & -6 & 1 \\\\ -3 & 8 & -2 \\\\ 0 & -5 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 4\\end{bmatrix} \\\\  & =4{I}_{3}\\end{aligned}\n$$\n\n \n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & =4{I}_{3}C \\\\  & =4C \\\\  & =\\begin{bmatrix}8\\sqrt{5} & -4 & 12 \\\\ 0 & 4\\sqrt{3} & 16 \\\\ -8 & 12 & 20\\text{ }\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id 17592186299802 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea" :knowledge-point/title "Calculating a Matrix Product Using the Distributive Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6d5cde5-f8df-5fc9-a0e0-c09bfdb02cd8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id 17592186298421}] :answer-field/correct {:answer/id #uuid "c6d5cde5-f8df-5fc9-a0e0-c09bfdb02cd8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id 17592186298421} :answer-field/id #uuid "ccab8471-735f-5ae8-b673-5e8ed001726e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186299321} {:answer-field/choices [{:answer/id #uuid "1e95aa11-9c6c-5d9d-8704-093197ed80a2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{6}" :db/id 17592186297686}] :answer-field/correct {:answer/id #uuid "1e95aa11-9c6c-5d9d-8704-093197ed80a2" :answ