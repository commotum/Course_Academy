)(1)(- \\frac{3}{4})\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=\\frac{3}{4}\\,i-2\\,j \\\\ F(1,\\frac{1}{4}) & =\\left((-1)(1)(\\frac{1}{4})\\right)\\,i+\\left((-2)(1)^{2}\\right)\\,j=-\\frac{1}{4}\\,i-2\\,j\\end{aligned}\n$$\n\nWe now draw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/8e/8e3a8f6c8b863dd68bc426baf82151476a347d231f87a763199288b93cdf585c.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["7f41bc97-1a45-5ac6-b387-80f11d2c9da4"] :db/ensure :question/validate} {:db/id "a099f06e-ecd1-50f5-8536-1f98184ff8e2" :answer/id #uuid "a099f06e-ecd1-50f5-8536-1f98184ff8e2" :answer/type :answer.type/image :answer/value "images/f6/f686e6a5920875ee373ced37fa6fcac941dc3fbd54489f16d4f27c3ff996b2e8.png" :db/ensure :answer/validate} {:db/id "0f24afde-307e-5a68-9ef6-d776f89a190a" :answer/id #uuid "0f24afde-307e-5a68-9ef6-d776f89a190a" :answer/type :answer.type/image :answer/value "images/cc/ccaa50fb2c18d3f4f320dfebfaa34522a32a50b8fa0c4bea641f158367716437.png" :db/ensure :answer/validate} {:db/id "4792412b-7e7a-5172-9926-7e53c39b704f" :answer/id #uuid "4792412b-7e7a-5172-9926-7e53c39b704f" :answer/type :answer.type/image :answer/value "images/2c/2cdf71a7faea6652cca5c0b87916f6a6ce2f622dfb5a668b386a5c1bf2567d23.png" :db/ensure :answer/validate} {:db/id "279db652-c9e6-5660-a30a-c3664e796959" :answer/id #uuid "279db652-c9e6-5660-a30a-c3664e796959" :answer/type :answer.type/image :answer/value "images/f1/f1825366a93acf5c83c83973d9689d919e5e4a27a3db7fe31bca95afe0dfef78.png" :db/ensure :answer/validate} {:db/id "5cb11845-5440-5f8e-ab38-09080147e291" :answer/id #uuid "5cb11845-5440-5f8e-ab38-09080147e291" :answer/type :answer.type/image :answer/value "images/86/866186b6f6f18cca7832b0da458fbd08f01a6cb7d618f2a904f50885eb2e3f0f.png" :db/ensure :answer/validate} {:db/id "f8b11a11-c4c5-5c9c-a8c5-b16ef6212efd" :answer-field/id #uu