aw our vectors. At each point, we draw the vector associated with that point, placing the tail end of the vector on the point itself. This gives the following diagram.\n\n![](images/98/987e9aabd76d28c679efb27b92a2536d103e99eb3f915e6731ec37c56286876f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["8c4be32b-ebec-539c-b41e-ace6fb5e23bd"] :db/ensure :question/validate} {:db/id "773a8b98-66de-5e5e-b398-a5e44ac67b13" :answer/id #uuid "773a8b98-66de-5e5e-b398-a5e44ac67b13" :answer/type :answer.type/image :answer/value "images/5d/5decd9cc7f7088571cf3eecf9f50c7ec87e2f6182df1fbc4b55caaf8bc3e73d4.png" :db/ensure :answer/validate} {:db/id "d2fa96a1-5147-5de1-b5da-a48e24f11b60" :answer/id #uuid "d2fa96a1-5147-5de1-b5da-a48e24f11b60" :answer/type :answer.type/image :answer/value "images/26/267f2a39c365664697da7256d49767c2018b3f63d94a6f55e90b566cc554a27e.png" :db/ensure :answer/validate} {:db/id "4a304352-c54f-51ef-8906-32ee9cdc8b79" :answer/id #uuid "4a304352-c54f-51ef-8906-32ee9cdc8b79" :answer/type :answer.type/image :answer/value "images/6c/6c75e8fe5ad41fd863eca4152c172bbba3084eba38b6e54c96f9e084669279ca.png" :db/ensure :answer/validate} {:db/id "67f43eb9-dbc2-5820-b523-2f926f10b9fa" :answer/id #uuid "67f43eb9-dbc2-5820-b523-2f926f10b9fa" :answer/type :answer.type/image :answer/value "images/e8/e829b1ebe911b3c3ae1a6e871d10a36931fef7f950933abda5ea226fd4c9ae66.png" :db/ensure :answer/validate} {:db/id "6f17cf54-8843-57c9-a3d9-0c5e55c95936" :answer/id #uuid "6f17cf54-8843-57c9-a3d9-0c5e55c95936" :answer/type :answer.type/image :answer/value "images/09/09fee256ed52affac40d46982cdb3b2e3957677e81ec0aa3266d9885be9e1add.png" :db/ensure :answer/validate} {:db/id "d55fcac1-f13e-5aca-8efd-d6b03f32a8f6" :answer-field/id #uuid "d55fcac1-f13e-5aca-8efd-d6b03f32a8f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["773a8b98-66de-5e5e-b398-a5e44ac67b13" "d2fa96a1-5147-5de1-b5da-a48e24f11b60" "4a304352-c54f-51e