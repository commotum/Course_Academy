owing diagram.\n\n![](images/72/72186906f29a435fb3dbb9f09d133a2343d6baea068f2ed543147e0edaf66759.png)"} {:db/id #edb/ref 17592186518814 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5b00f0c-fc7f-5262-b1a3-cdd6c1560cd6" :knowledge-point/title "Sketching a Two-Dimensional Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b187716-5c52-5154-8eba-92ea2595ebca" :answer/type {:db/ident :answer.type/image} :answer/value "images/a6/a69a9afddf3271e21e7b0a4136a84d4420238af354869085c58d931ac2e045fe.png" :db/id #edb/ref 17592186518799} {:answer/id #uuid "e6c20b29-76d4-5e38-8c58-494a801735b7" :answer/type {:db/ident :answer.type/image} :answer/value "images/ac/ac7b6358e4a38abf76e49ca6e45dd3f170dd0565e4f303fd0ba4404c277ed2ab.png" :db/id #edb/ref 17592186518828} {:answer/id #uuid "f7236076-70c6-51ad-8f1c-70ee14c70552" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b6f5ce40a52995b6b4cda770566885cfbfdc3f74cfade2d37f2bc88f6e55c6e4.png" :db/id #edb/ref 17592186518829} {:answer/id #uuid "f98bd55b-3400-51be-83c0-e4bec78eed02" :answer/type {:db/ident :answer.type/image} :answer/value "images/91/91f6b076c94322c828a689829eaab50cda96b38237e21ed6d3010ae49ef89dfc.png" :db/id #edb/ref 17592186518831} {:answer/id #uuid "fda4634f-2172-562a-acac-47e97dcdd3ed" :answer/type {:db/ident :answer.type/image} :answer/value "images/d8/d818c0db25a267f3abdda3687ac96d1bd476cae70fe1e0874c3edc15b90bf997.png" :db/id #edb/ref 17592186518832}] :answer-field/correct {:answer/id #uuid "8b187716-5c52-5154-8eba-92ea2595ebca" :answer/type {:db/ident :answer.type/image} :answer/value "images/a6/a69a9afddf3271e21e7b0a4136a84d4420238af354869085c58d931ac2e045fe.png" :db/id #edb/ref 17592186518799} :answer-field/id #uuid "8f72cb0b-a380-59f9-acdc-d02f0d8440d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186518803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficu