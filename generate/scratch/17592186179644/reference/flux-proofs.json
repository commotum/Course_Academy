{
  "outward": {
    "representative_field": "Matrix([[a*cos(t)], [b*sin(t)]])",
    "normal_ds": "Matrix([[b*cos(t)], [a*sin(t)]])",
    "dot": "a*b",
    "integral": "2*pi*a*b",
    "sign": "positive"
  },
  "inward": {
    "representative_field": "Matrix([[-a*cos(t)], [-b*sin(t)]])",
    "normal_ds": "Matrix([[b*cos(t)], [a*sin(t)]])",
    "dot": "-a*b",
    "integral": "-2*pi*a*b",
    "sign": "negative"
  },
  "tangent": {
    "representative_field": "Matrix([[a*sin(t)], [-b*cos(t)]])",
    "normal_ds": "Matrix([[b*cos(t)], [a*sin(t)]])",
    "dot": "0",
    "integral": "0",
    "sign": "zero"
  },
  "balanced-saddle": {
    "representative_field": "Matrix([[a*cos(t)], [-b*sin(t)]])",
    "normal_ds": "Matrix([[b*cos(t)], [a*sin(t)]])",
    "dot": "a*b*(1 - 2*sin(t)**2)",
    "integral": "0",
    "sign": "zero"
  }
}
