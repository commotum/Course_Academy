^{-3t}\\right)\\right)\n$$\n\n$$\nx'(t)=3e^{3t}+ 3t(3e^{3t}),\\quad y'(t)=5(2t)e^{-3t}+5(t^2+2)(-3e^{-3t})\n$$\n\n$$\nx'(t)=3(1+3t)e^{3t},\\quad y'(t)=5(2t-3(t^2+2))e^{-3t}\n$$\n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{5(2t-3(t^2+2))e^{-3t}}{3(1+3t)e^{3t}}=\\frac{5(2t-3(t^2+2))}{3(1+3t)}e^{-6t}.\n$$\n\nThis derivative is defined for $t\\ne - \\frac{1}{3}.$" 13194139535611 17592186045443 true] [17592186522902 1080 "e^{-1}" 13194139535611 17592186045443 true] [17592186522902 1082 #edb/ref 17592186045498 13194139535611 17592186045443 true] [17592186522902 1083 #uuid "3e926e96-79ee-54b0-b8f8-04808f9e654e" 13194139535611 17592186045443 true] [17592186522903 1080 "\\frac{5(2t-1(t^2+2))}{3(1+1t)}e^{-2t}" 13194139535611 17592186045443 true] [17592186522903 1082 #edb/ref 17592186045498 13194139535611 17592186045443 true] [17592186522903 1083 #uuid "499737b3-a0fe-585c-b187-55fbf62e6658" 13194139535611 17592186045443 true] [17592186522904 1075 #edb/ref 17592186522921 13194139535611 17592186045443 true] [17592186522904 1076 #edb/ref 17592186045492 13194139535611 17592186045443 true] [17592186522904 1077 "field-1" 13194139535611 17592186045443 true] [17592186522904 1078 #edb/ref 17592186522921 13194139535611 17592186045443 true] [17592186522904 1079 #uuid "4a0921ba-c3f5-5016-a00f-3a2bc8cd7e62" 13194139535611 17592186045443 true] [17592186522905 1075 #edb/ref 17592186522911 13194139535611 17592186045443 true] [17592186522905 1076 #edb/ref 17592186045492 13194139535611 17592186045443 true] [17592186522905 1077 "field-1" 13194139535611 17592186045443 true] [17592186522905 1078 #edb/ref 17592186522911 13194139535611 17592186045443 true] [17592186522905 1079 #uuid "6dfb02a6-9b02-5883-876f-ce117dbd3f4d" 13194139535611 17592186045443 true] [17592186522906 1080 "384 e" 13194139535611 17592186045443 true] [17592186522906 1082 #edb/ref 17592186045498 13194139535611 17592186045443 true] [17592186522906 1083 #uuid "794828fb-0efa-5c48-a874-43e81f7e2e58" 13194139535611 17592186045443 true] [