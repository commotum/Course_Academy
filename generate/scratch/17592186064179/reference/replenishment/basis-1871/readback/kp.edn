dge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96dcd1e4-f866-5c31-9249-b3c6a08f3b50" :question/math-academy-id "q-113923" :question/problem "$\\int (3\\operatorname{cos}x-2\\operatorname{sec}x\\,\\operatorname{tan}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}x\\,\\text{d}x & =\\operatorname{sin}x+C, \\\\ \\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x & =\\operatorname{sec}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (3\\operatorname{cos}x-2\\operatorname{sec}x\\,\\operatorname{tan}x)\\,\\text{d}x & =3\\int \\operatorname{cos}x\\,\\text{d}x-2\\int \\operatorname{sec}x\\operatorname{tan}x\\,\\text{d}x \\\\  & =3\\operatorname{sin}x-2\\operatorname{sec}x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186233195 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b17add20-e3fe-557a-b7ba-b30e3097020e" :question/math-academy-id "q-113925" :question/problem "$\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{csc}x\\operatorname{cot}x\\,\\text{d}x & =-\\operatorname{csc}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csc}x\\,\\operatorname{cot}x+\\operatorname{sin}x)\\,\\text{d}x & =2\\int \\operatorname{cos}\\operatorname{csc}x\\,\\operatorname{cot}x\\,\\text{d}x+\\int \\operatorname{sin}x\\,\\text{d}x \\\\  & =2(-\\operatorname{csc}x)+(-\\operatorname{cos}x)+C \\\\  & =-2\\operatorname{csc}x-\\operatorname{cos}x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234311 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27d3e02d-3099-56f8-b860-c654c168397f" :question/math-academy-id "q-71657" :question/problem "$\\int (-8\\operatorname{csc}y\\,\\operatorname{cot}y)\\,\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{csc}y\\operatorname{cot}y\\,\\text{d}y & =-\\operatorname{csc}y+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8\\operatorname{csc}y\\,\\operatorname{cot}y)\\,\\text{d}y & =-8\\int \\operatorname{csc}y\\operatorname{cot}y\\,\\text{d}y \\\\  & =-8(-\\operatorname{csc}y)+C \\\\  & =8\\operatorname{csc}y+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250138 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a6b2d77-6333-57e0-afd5-ae25cfed1172" :answer/type {:db/ident :answer.type/math} :answer/value "3sec⁡xcot⁡x+C" :db/id #edb/ref 17592186247800} {:answer/id #uuid "558aa8a6-6ebf-5d3f-a5a9-3b19d8e488c1" :answer/type {:db/ident :answer.type/math} :answer/value "-3csc⁡x+C" :db/id #edb/ref 17592186248195} {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} {:answer/id #uuid "a4b2a2ae-e079-58a1-a369-536f12c56dbc" :answer/type {:db/ident :answer.type/math} :answer/value "3sec⁡x+C" :db/id #edb/ref 17592186248893} {:answer/id #uuid "acbcb4c2-9b18-5aa7-84c2-3dabda9f77dd" :answer/type {:d