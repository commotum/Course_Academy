#{[{:db/id #edb/ref 17592186064179 :knowledge-point/canonical-example {:db/id #edb/ref 17592186064053 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/id #uuid "4c3342aa-dd1c-566b-9229-164e594c554c" :question/math-academy-id "e-383" :question/problem "Calculate $\\displaystyle \\int (-\\csc x\\cot x)\\,\\textrm d x.$" :question/worked-solution "Recall that\n\n$$\n\\int \\csc x \\cot x \\, \\textrm dx = - \\csc x + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-csc⁡xcot⁡x)\\,\\text{d}x & =-\\int (csc⁡xcot⁡x)\\,\\text{d}x \\\\  & =-(-csc⁡x)+C \\\\  & =csc⁡x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050985}] :knowledge-point/question-generator {:db/id #edb/ref 17592186478558 :question-generator/id #uuid "b41e7f14-d716-550f-9a7f-1dcefe9f4c35" :question-generator/script "generate/scratch/17592186064179.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186064562 :knowledge-point/_questions [{:knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96acd90a-d231-5a09-944b-db1c18040f67" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cot y + C" :db/id #edb/ref 17592186061568} {:answer/id #uuid "d1cd7d44-f9a5-5a50-ada1-809cce667211" :answer/type {:db/ident :answer.type/math} :answer/value "2\\csc y + C" :db/id #edb/ref 17592186061569} {:answer/id #uuid "49cc6178-75c6-5b80-a2b6-753df95ab935" :answer/type {:db/ident :answer.type/math} :answer/value "2\\csc^{2} y + C" :db/id #edb/ref 17592186061570} {:answer/id #uuid "4b1ad5fe-5f3d-5c84-ad29-3a7831c84ed3" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\csc y + C" :db/id #edb/ref 17592186061