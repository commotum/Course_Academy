      },
      "question": {
        ":question/id": "e57079a5-b446-561a-b004-99b65c79b5c1",
        ":question/problem": "Find $k$ given that the vectors $a=\u27e81,-3,-3\u27e9$, $b=\u27e8k,0,-2\u27e9$, and $c=\u27e8-2,-2,0\u27e9$ are coplanar.",
        ":question/answer-fields": [
          {
            ":answer-field/id": "f79832df-bc36-5b90-9a30-1d02c70c6b38",
            ":answer-field/key": "selection",
