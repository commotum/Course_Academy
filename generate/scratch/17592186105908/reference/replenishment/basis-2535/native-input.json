                ":answer/value": "\\frac{3}{8}"
              },
              {
                ":answer/id": "cde619be-078c-573e-9e89-5f8ac0f0fb94",
                ":answer/type": ":answer.type/math",
                ":answer/value": "-\\frac{8}{3}"
              },
              {
                ":answer/id": "4bf532b2-930d-5041-aafb-acc26b8eef68",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\frac{8}{3}"
              },
              {
                ":answer/id": "1a9a3bf2-bb27-55ea-9d1a-0705b0c69a18",
                ":answer/type": ":answer.type/math",
