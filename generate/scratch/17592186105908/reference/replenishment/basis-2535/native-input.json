      "question": {
        ":question/id": "c5ff0093-be96-550d-9641-06c29e3471de",
        ":question/problem": "Find $k$ given that the vectors $a=\u27e80,-1,-1\u27e9$, $b=\u27e82,0,1\u27e9$, and $c=\u27e8k,0,-2\u27e9$ are coplanar.\n\n$k=${{field-1}}",
        ":question/answer-fields": [
          {
            ":answer-field/id": "37a38844-d78a-5780-8e88-5a1d10bda758",
            ":answer-field/key": "field-1",
