6 & =0 \\\\ {k}^{2} & =6 \\\\ k & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\sqrt{6}$ or $k=\\sqrt{6}.$"} {:db/id 17592186459221 :knowledge-point/_questions [{:knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a3758c-f60c-5dae-92fa-afedc78160ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id 17592186458653} {:answer/id #uuid "1c111100-d619-5b93-b482-b6ec810b8df5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id 17592186458679} {:answer/id #uuid "3f06b20c-1420-5939-96cc-465d37b4df29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id 17592186458746} {:answer/id #uuid "856f42a7-be02-543a-b498-4b18fecdaca0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id 17592186458860} {:answer/id #uuid "96678253-6e22-571e-98ff-a64d81bbbdd4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id 17592186458889}] :answer-field/correct {:answer/id #uuid "96678253-6e22-571e-98ff-a64d81bbbdd4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id 17592186458889} :answer-field/id #uuid "0ef466f3-b445-5f7c-961a-8d3a58c07b04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186459092}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2eedb023-f05d-5365-a7fb-580375aea9cb" :question/math-academy-id "q-128442" :question/problem "Find $k$ given that the vectors $p=⟨5,-2,2⟩,$ $q=⟨3,k,1⟩,$ and $r=⟨-8,3,-4⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}5 & -2 & 2 \\\\ 3 & k & 1 \\\\ -8 & 3 & -4\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}k & 1 \\\\ 3 & -4\\end{aligned}|-(-2)\\cdot |\\begin{aligned}3 & 1 \\\\ -8 & -4\\end{aligned}|+2\\cdot |\\begin{aligned}3 & k \\\\ -8 & 3\\end{aligned}| \\\\  & =5(k\\cdot (-4)-3\\cdot 1)+2(3\\cdot (-4)-(-8)\\cdot 1)+2(3\\cdot 3-(-8)\\cdot k) \\\\  & =-20k-15-8+18+16k \\\\  & =-4k-5.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ -4k-5 & =0 \\\\ k & =-\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{5}{4}.$"} {:db/id 17592186459264 :knowledge-point/_questions [{:knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2edcbb95-8455-53f6-ab2b-7ee4b7636b26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{48}{89}" :db/id 17592186458720} {:answer/id #uuid "952a2910-c243-5005-89e0-a85dc85a351b" :answer/type {:db/ident :answer.type/math} :answer/value "-48" :db/id 17592186458888} {:answer/id #uuid "b7055a4c-b19c-53cc-bd20-a53224e1ac3d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{48}{89}" :db/id 17592186458958} {:answer/id #uuid "d351447b-72b1-5263-b183-d42c3b9c1db5" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id 17592186458996} {:answer/id #uuid "fb3fdd87-8f4b-5ed1-abd8-52ae4ff972fd" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id 17592186459073}] :answer-field/correct {:answer/id #uuid "fb3fdd87-8f4b-5ed1-abd8-52ae4ff972fd" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id 17592186459073} :answer-field/id #uuid "20c78fd9-b62d-5bc1-a554-90d9058aa00b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186459098}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1fc629c-e7ef-51c7-b925-1dba79c32351" :question/math-academy-id "q-128457" :question/problem "Find $t$ given that the vectors $p=⟨9,9,-2⟩,$ $q=⟨5,6,0⟩,$ and $r=⟨4,t,t⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}9 & 9 & -2 \\\\ 5 & 6 & 0 \\\\ 4 & t & t\\end{aligned}| \\\\  & =9\\cdot |\\begin{aligned}6 & 0 \\\\ t & t\\end{aligned}|-9\\cdot |\\begin{aligned}5 & 0 \\\\ 4 & t\\end{aligned}|+(-2)\\cdot |\\begin{aligned}5 & 6 \\\\ 4 & t\\end{aligned}| \\\\  & =9(6\\cdot t-t\\cdot 0)-9(5\\cdot t-4\\cdot 0)-2(5\\cdot t-4\\cdot 6) \\\\  & =54t-45t-10t+48 \\\\  & =48-t.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 48-t & =0 \\\\ t & =48\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=48.$"} {:db/id 17592186459308 :knowledge-point/_questions [{:knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097251b1-26d6-5cd9-bf4d-87268a9fc820" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{2}" :db/id 17592186458633} {:answer/id #uuid "1b54582f-21c1-5dbb-96a1-354563e5dd55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id 17592186458675} {:answer/id #uuid "2cada373-4b44-51da-8246-3a0563bdb1ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{2}" :db/id 17592186458715} {:answer/id #uuid "746350b5-80dc-5a7c-a6bb-5b2627a66dd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{4}" :db/id 17592186458833} {:answer/id #uuid "f5f276ab-f70a-50eb-8278-8d17070d15a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id 17592186459064}] :answer-field/correct {:answer/id #uuid "746350b5-80dc-5a7c-a6bb-5b2627a66dd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{125}{4}" :db/id 17592186458833} :answer-field/id #uuid "79226ded-2796-54ed-af2f-9b7e026caf73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186459137}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa437fb9-bfe8-5dbc-864c-e499156b0343" :question/math-academy-id "q-18261" :question/problem "Find $x$ given that the vectors $a=⟨12,-2x,1⟩$ , $b=⟨1,5,-2⟩$ and $c=⟨-9,4,8⟩$  are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}12 & -2x & 1 \\\\ 1 & 5 & -2 \\\\ -9 & 4 & 8\\end{aligned}| \\\\  & =12\\cdot |\\begin{aligned}5 & -2 \\\\ 4 & 8\\end{aligned}|-(-2x)\\cdot |\\begin{aligned}1 & -2 \\\\ -9 & 8\\end{aligned}|+1\\cdot |\\begin{aligned}1 & 5 \\\\ -9 & 4\\end{aligned}| \\\\  & =12(5\\cdot 8-4\\cdot (-2))+2x(1\\cdot 8-(-9)\\cdot (-2))+(1\\cdot 4-5\\cdot (-9)) \\\\  & =576-20x+49 \\\\  & =625-20x.\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 625-20x & =0 \\\\ 20x & =625 \\\\ x & =\\frac{125}{4}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $x=\\frac{125}{4}.$"} {:db/id 17592186484229 :knowledge-point/_questions [{:knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eea5ea1b-1584-5bf8-9c56-60e082cc3b30" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{13}" :db/id 17592186484039}] :answer-field/correct {:answer/id #uuid "eea5ea1b-1584-5bf8-9c56-60e082cc3b30" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{13}" :db/id 17592186484039} :answer-field/id #uuid "aefbe563-901b-5005-9895-d7c05a2acfbf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186484170}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "65ad1da6-49b7-5494-8267-2eea67ec5389" :question/math-academy-id "q-280747" :question/problem "Find $k$ given that the vectors $a=⟨2,k,-1⟩$, $b=⟨-3,4,5⟩$, and $c=⟨6,k,1⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & k & -1 \\\\ -3 & 4 & 5 \\\\ 6 & k & 1\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}4 & 5 \\\\ k & 1\\end{aligned}|-k\\cdot |\\begin{aligned}-3 & 5 \\\\ 6 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}-3 & 4 \\\\ 6 & k\\end{aligned}| \\\\  & =2(4\\cdot 1-5\\cdot k)-k(-3\\cdot 1-5\\cdot 6)-1(-3\\cdot k-4\\cdot 6) \\\\  & =8-10k+33k+3k+24 \\\\  & =26k+32\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 26k+32 & =0 \\\\ k & =-\\frac{16}{13}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{16}{13}.$"} {:db/id 17592186493904 :knowledge-point/_questions [{:knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc5ee62-4f20-5c54-9e5a-bbb471927bb4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id 17592186493468} {:answer/id #uuid "3135cadf-898b-5d47-89f0-df3060a008eb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id 17592186493473} {:answer/id #uuid "389cf47a-7d3c-5e4e-b0ed-207e5d8a0087" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id 17592186493485} {:answer/id #uuid "9fcfd0be-c665-50f6-b594-87f4f9162f0b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186493643} {:answer/id #uuid "ae7cc567-6679-5581-b389-e82348eb1ae3" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id 17592186493668}] :answer-field/correct {:answer/id #uuid "2cc5ee62-4f20-5c54-9e5a-bbb471927bb4" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id 17592186493468} :answer-field/id #uuid "0b436b69-27e7-557e-9669-3a80b22007ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186493806}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b5a6dbe-bec1-5af9-82e5-d252aa38eb1f" :question/math-academy-id "q-73733" :question/problem "Find $k$ given that the vectors $a=⟨-1,1,1⟩$, $b=⟨2,1,0⟩$, and $c=⟨k,-2,-3⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}-1 & 1 & 1 \\\\ 2 & 1 & 0 \\\\ k & -2 & -3\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}1 & 0 \\\\ -2 & -3\\end{aligned}|-1\\cdot |\\begin{aligned}2 & 0 \\\\ k & -3\\end{aligned}|+|\\begin{aligned}2 & 1 \\\\ k & -2\\end{aligned}| \\\\  & =-(1\\cdot (-3)-(-2)\\cdot 0)-(2\\cdot (-3)-k\\cdot 0)+(2\\cdot (-2)-k\\cdot 1) \\\\  & =3+6-4-k \\\\  & =5-k.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 5-k & =0 \\\\ k & =5\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=5.$"} {:db/id 17592186493949 :knowledge-point/_questions [{:knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a627e562-14bd-588f-a5f4-1d17e6cb6828" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{5}" :db/id 17592186493653}] :answer-field/correct {:answer/id #uuid "a627e562-14bd-588f-a5f4-1d17e6cb6828" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{5}" :db/id 17592186493653} :answer-field/id #uuid "a9d8c1a0-222c-5144-9f47-a1a87a86c092" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186493858}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b407ea24-4cac-5cb8-bbfb-b1a7b706dc73" :question/math-academy-id "q-280770" :question/problem "Find $k$ given that the vectors $x=⟨1,k,2⟩$, $y=⟨5,-2,3⟩$, and $z=⟨-4,k,1⟩$ are coplanar.\n\n$k=${{field-1}}" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =|\\begin{aligned}1 & k & 2 \\\\ 5 & -2 & 3 \\\\ -4 & k & 1\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}-2 & 3 \\\\ k & 1\\end{aligned}|-k\\cdot |\\begin{aligned}5 & 3 \\\\ -4 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}5 & -2 \\\\ -4 & k\\end{aligned}| \\\\  & =1(-2\\cdot 1-3\\cdot k)-k(5\\cdot 1-3\\cdot -4)+2(5k-(-2)(-4)) \\\\  & =-2-3k-k(5+12)+2(5k-8) \\\\  & =-2-3k-17k+10k-16 \\\\  & =-10k-18\\end{aligned}\n$$\n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}x\\cdot (y\\times z) & =0 \\\\ -10k-18 & =0 \\\\ k & =-\\frac{9}{5}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\frac{9}{5}.$"}] :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}