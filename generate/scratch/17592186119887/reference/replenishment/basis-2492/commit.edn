right) & 0 & 4\\left(2\\right) \\\\ 0 & 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 4\\left(2\\right) \\\\ 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2\\left(2u\\right) & 4\\left(2\\right) \\\\ 0 & 4\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}2\\left(2u\\right) & 0 \\\\ 0 & 3\\left(3{v}^{2}\\right)\\end{vmatrix}⟩ \\\\  & =⟨- 72 v^{2},\\,- 16 u,\\,36 u v^{2}⟩.\\end{aligned}\n$$" 13194139535805 17592186045443 true] [17592186529386 1080 "⟨0,\\,6 v^{2},\\,1⟩" 13194139535805 17592186045443 true] [17592186529386 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529386 1083 #uuid "b7590c8f-53c2-5e60-abe5-94dba4b54823" 13194139535805 17592186045443 true] [17592186529387 1080 "⟨0,\\,12 v^{2},\\,2⟩" 13194139535805 17592186045443 true] [17592186529387 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529387 1083 #uuid "b7bf49b0-96d5-5f6a-bf2a-ab30c93bed0c" 13194139535805 17592186045443 true] [17592186529388 1080 "⟨6 u,\\,0,\\,4⟩" 13194139535805 17592186045443 true] [17592186529388 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529388 1083 #uuid "bc6fc1db-b13a-5b17-a1ee-f3152ebb05c0" 13194139535805 17592186045443 true] [17592186529389 1080 "⟨12,\\,- 4 e^{v},\\,-3⟩" 13194139535805 17592186045443 true] [17592186529389 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529389 1083 #uuid "bef9218d-e0fe-5ce0-82f9-bf47cfd7d97b" 13194139535805 17592186045443 true] [17592186529390 1080 "⟨- 48 v^{2},\\,- 16 u,\\,96 u v^{2}⟩" 13194139535805 17592186045443 true] [17592186529390 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529390 1083 #uuid "c311f11d-ff39-5e16-a7cd-305794bdafae" 13194139535805 17592186045443 true] [17592186529391 1068 #edb/ref 17592186529351 13194139535805 17592186045443 true] [17592186529391 1070 #edb/ref 17592186045487 13194139535805 17592186045443 true] [17592