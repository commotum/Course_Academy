e6-fd6c-56fc-be8d-0adb41e9046a" 13194139535805 17592186045443 true] [17592186529341 1074 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨{u}^{2}+1,\\,3\\left({v}^{3}+1\\right),\\,4\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}({u}^{2}+1),\\,\\frac{∂}{∂u}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(4\\left(2u+v\\right))⟩ \\\\  & =⟨2u,\\,0,\\,8⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}({u}^{2}),\\,\\frac{∂}{∂v}(3\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(4\\left(2u+v\\right))⟩ \\\\  & =⟨0,\\,9 v^{2},\\,4⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2u & 0 & 4\\left(2\\right) \\\\ 0 & 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}0 & 4\\left(2\\right) \\\\ 3\\left(3{v}^{2}\\right) & 4\\left(1\\right)\\end{vmatrix},\\,-\\begin{vmatrix}2u & 4\\left(2\\right) \\\\ 0 & 4\\left(1\\right)\\end{vmatrix},\\,\\begin{vmatrix}2u & 0 \\\\ 0 & 3\\left(3{v}^{2}\\right)\\end{vmatrix}⟩ \\\\  & =⟨- 72 v^{2},\\,- 8 u,\\,18 u v^{2}⟩.\\end{aligned}\n$$" 13194139535805 17592186045443 true] [17592186529342 1080 "⟨0,\\,3,\\,- 4 e^{v}⟩" 13194139535805 17592186045443 true] [17592186529342 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529342 1083 #uuid "2175fd76-0c56-57b8-9174-0002272778f6" 13194139535805 17592186045443 true] [17592186529343 1080 "⟨-12,\\,4 e^{v},\\,3⟩" 13194139535805 17592186045443 true] [17592186529343 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529343 1083 #uuid "23fff28c-98c6-517d-894e-e3ade0b85cc9" 13194139535805 17592186045443 true] [17592186529344 1080 "⟨3,\\,\\sin{(v )},\\,- v \\sin{(u )}⟩" 13194139535805 17592186045443 true] [17592186529344 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529344 1083 #uuid "2d0c0d85-2f02-55dc-9473-202a33fde613" 13194139535805 17592186045443 true] [17592186529345 1068 #edb/ref 17592186529350 13194139535805 17592186045443 true] [17592186529345 1070 #edb/ref 17592186045487 13194139535805 17592186045443 true] [17592186529345 1071 "Find the fundamental vector product of the surface defined by the equations\n\n$x = 2\\left(u + v\\right), y = 3\\left(v^{2} + \\sin u\\right), z = uv$." 13194139535805 17592186045443 true] [17592186529345 1072 #uuid "2f1ae609-38a0-53f0-baa0-900f6821dc85" 13194139535805 17592186045443 true] [17592186529345 1074 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨2 u + 2 v,\\,3 v^{2} + 3 \\sin{(u )},\\,u v⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2 u + 2 v),\\,\\frac{∂}{∂u}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂u}(u v)⟩ \\\\  & =⟨2,\\,3 \\cos{(u )},\\,v⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2 u + 2 v),\\,\\frac{∂}{∂v}(3 v^{2} + 3 \\sin{(u )}),\\,\\frac{∂}{∂v}(u v)⟩ \\\\  & =⟨2,\\,6 v,\\,u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =\\begin{vmatrix}i & j & k \\\\ 2 & 3 \\cos{(u )} & v \\\\ 2 & 6 v & u\\end{vmatrix} \\\\  & =⟨\\begin{vmatrix}3 \\cos{(u )} & v \\\\ 6 v & u\\end{vmatrix},\\,-\\begin{vmatrix}2 & v \\\\ 2 & u\\end{vmatrix},\\,\\begin{vmatrix}2 & 3 \\cos{(u )} \\\\ 2 & 6 v\\end{vmatrix}⟩ \\\\  & =⟨(3 \\cos{(u )})(u)-(v)(6 v),\\,-[(2)(u)-(v)(2)],\\,(2)(6 v)-(3 \\cos{(u )})(2)⟩ \\\\  & =⟨3 u \\cos{(u )} - 6 v^{2},\\,- 2 u + 2 v,\\,12 v - 6 \\cos{(u )}⟩.\\end{aligned}\n$$" 13194139535805 17592186045443 true] [17592186529346 1080 "⟨- 48 v^{2},\\,- 12 u,\\,72 u v^{2}⟩" 13194139535805 17592186045443 true] [17592186529346 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529346 1083 #uuid "3158d5a7-3a0d-564b-b6fb-2802c49578ac" 13194139535805 17592186045443 true] [17592186529347 1080 "⟨12 v^{2},\\,12 u,\\,- 18 u v^{2}⟩" 13194139535805 17592186045443 true] [17592186529347 1082 #edb/ref 17592186045498 13194139535805 17592186045443 true] [17592186529347 1083 #uuid "328d5447-3347-5040-9526-4d0f97f066b7" 13194139535805 17592186045443 true] [17592186529348 1068 #edb/ref 17592186529376 13194139535805 17592186045443 true] [17592186529348 1070 #edb/ref 17592186045486 13194139535805 17592186045443 true] [17592186529348 1071 "Find the fundamental vector product of the surface defined by the equations \n\n$$\nx=4\\left({u}^{2}+1\\right),\\,y=4\\left({v}^{3}+1\\right),\\,z=2\\left(2u+v\\right).\n$$" 13194139535805 17592186045443 true] [17592186529348 1072 #uuid "34df8a07-4ac5-5db8-94ec-53489ab5c141" 13194139535805 17592186045443 true] [17592186529348 1074 "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nIn vector form, our surface has the equation \n\n$$\nr(u,v)=⟨4\\left({u}^{2}+1\\right),\\,4\\left({v}^{3}+1\\right),\\,2\\left(2u+v\\right)⟩.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(4\\left({u}^{2}+1\\right)),\\,\\frac{∂}{∂u}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂u}(2\\left(2u+v\\right))⟩ \\\\  & =⟨8 u,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(4\\left({u}^{2}\\right)),\\,\\frac{∂}{∂v}(4\\left({v}^{3}+1\\right)),\\,\\frac{∂}{∂v}(2\\left(2u+v\\right))⟩ \\\\  & =⟨