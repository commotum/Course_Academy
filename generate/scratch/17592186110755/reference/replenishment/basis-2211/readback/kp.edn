rac{13}{49}} \\\\  & =\\pm \\frac{\\sqrt{13}}{7}.\\end{aligned}\n$$\n\nFinally, we select the positive answer since $sin⁡\\theta $ is positive in the first quadrant. So our final answer is $sin⁡\\theta =\\frac{\\sqrt{13}}{7}.$"} {:db/id #edb/ref 17592186323955 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c73db44-2ec2-5025-9431-acb02e414916" :knowledge-point/title "Computing a Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a4cafde-db4c-54bb-bab3-013f762c6d9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186321731} {:answer/id #uuid "4e99ea8e-9a16-57a0-baea-c6ae781ca29a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186321765} {:answer/id #uuid "5cf875a9-930b-5577-b821-7ead99c40d06" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{7}" :db/id #edb/ref 17592186321884} {:answer/id #uuid "7fe73b65-ebc3-5cff-9a52-a69da7741fb3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{7}" :db/id #edb/ref 17592186322150} {:answer/id #uuid "b124652f-7ab9-5b4c-9413-d3dfdcb4c6a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186322535}] :answer-field/correct {:answer/id #uuid "4e99ea8e-9a16-57a0-baea-c6ae781ca29a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{10}}{7}" :db/id #edb/ref 17592186321765} :answer-field/id #uuid "ce29bc07-9e48-58fd-9669-3eeb517f79e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "565688d3-a42b-5b17-9265-a372de4b8754" :question/math-academy-id "q-37899" :question/problem "![](images/f4/f4fdf6f8d819a4ee043b1cc3b86d795e3166ebfe181e0958246dc084c2f9c6fc.png)\n\nThe poin