t \\right)})i+(- 3 \\cos{\\left(t \\right)})j \\\\ \\|r^{\\prime}(t)\\|&=\\sqrt{(\\frac{\\text{d}x}{\\text{d}t})^2+(\\frac{\\text{d}y}{\\text{d}t})^2} \\\\ &=\\sqrt{(- 3 \\sin{\\left(t \\right)})^2+(- 3 \\cos{\\left(t \\right)})^2} \\\\ &=\\sqrt{9\\sin^2t+9\\cos^2t} \\\\ &=\\sqrt{9(\\sin^2t+\\cos^2t)} \\\\ &=\\sqrt{9} \\\\ &=3\\end{aligned}\n$$\n\nNow, if $f(x,y)=9 - 2 x^{2}$, then we obtain\n\n$$\n\\begin{aligned}f(r(t))&=(-1)\\left(2(3 \\cos{\\left(t \\right)})^2-9\\right) \\\\ &=(-9)(2\\cos^2t-1) \\\\ &=- 9 \\cos{\\left(2 t \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\\int_C 9 - 2 x^{2}\\,\\text{d}s&=\\int_{- \\frac{\\pi}{2}}^{- \\frac{\\pi}{4}}f(r(t))\\|r^{\\prime}(t)\\|\\,\\text{d}t \\\\ &=\\int_{- \\frac{\\pi}{2}}^{- \\frac{\\pi}{4}}(- 9 \\cos{\\left(2 t \\right)})\\cdot (3)\\,\\text{d}t \\\\ &=\\int_{- \\frac{\\pi}{2}}^{- \\frac{\\pi}{4}}- 27 \\cos{\\left(2 t \\right)}\\,\\text{d}t \\\\ &=-27\\int_{- \\frac{\\pi}{2}}^{- \\frac{\\pi}{4}}\\cos 2t\\,\\text{d}t \\\\ &=(-27)\\left[\\frac{1}{2}\\sin 2t\\right]_{- \\frac{\\pi}{2}}^{- \\frac{\\pi}{4}} \\\\ &=\\left[(- \\frac{27 \\sin{\\left(2 t \\right)}}{2})\\right]_{- \\frac{\\pi}{2}}^{- \\frac{\\pi}{4}} \\\\ &=\\left((- \\frac{27 \\sin{\\left(2 (- \\frac{\\pi}{4}) \\right)}}{2})\\right)-\\left((- \\frac{27 \\sin{\\left(2 (- \\frac{\\pi}{2}) \\right)}}{2})\\right) \\\\ &=\\left((\\frac{27}{2})\\right)-\\left((0)\\right) \\\\ &=\\frac{27}{2}.\\end{aligned}\n$$" 13194139535592 17592186045443 true] [17592186520687 1080 "-2" 13194139535592 17592186045443 true] [17592186520687 1082 #edb/ref 17592186045498 13194139535592 17592186045443 true] [17592186520687 1083 #uuid "6b48cc25-c525-5393-8d7c-54a84b821d56" 13194139535592 17592186045443 true] [17592186520688 1068 #edb/ref 17592186520698 13194139535592 17592186045443 true] [17592186520688 1070 #edb/ref 17592186045485 13194139535592 17592186045443 true] [17592186520688 1071 "Evaluate the line integral of the function $f(x,y)