0 t^{\\frac{5}{2}}}{3})+(\\frac{25 t^{4}}{4})+(- \\frac{25 t^{3}}{3})+(- 25 t^{2})\\right]_{1}^{2} \\\\ &=\\left((\\frac{200 (2)^{\\frac{7}{2}}}{21})+(\\frac{40 (2)^{\\frac{5}{2}}}{3})+(\\frac{25 (2)^{4}}{4})+(- \\frac{25 (2)^{3}}{3})+(- 25 (2)^{2})\\right)-\\left((\\frac{200 (1)^{\\frac{7}{2}}}{21})+(\\frac{40 (1)^{\\frac{5}{2}}}{3})+(\\frac{25 (1)^{4}}{4})+(- \\frac{25 (1)^{3}}{3})+(- 25 (1)^{2})\\right) \\\\ &=\\left((\\frac{1600 \\sqrt{2}}{21})+(\\frac{160 \\sqrt{2}}{3})+(100)+(- \\frac{200}{3})+(-100)\\right)-\\left((\\frac{200}{21})+(\\frac{40}{3})+(\\frac{25}{4})+(- \\frac{25}{3})+(-25)\\right) \\\\ &=- \\frac{5245}{84} + \\frac{2720 \\sqrt{2}}{21}.\\end{aligned}\n$$" 13194139535592 17592186045443 true] [17592186520722 1075 #edb/ref 17592186520665 13194139535592 17592186045443 true] [17592186520722 1075 #edb/ref 17592186520677 13194139535592 17592186045443 true] [17592186520722 1075 #edb/ref 17592186520681 13194139535592 17592186045443 true] [17592186520722 1075 #edb/ref 17592186520692 13194139535592 17592186045443 true] [17592186520722 1075 #edb/ref 17592186520717 13194139535592 17592186045443 true] [17592186520722 1076 #edb/ref 17592186045493 13194139535592 17592186045443 true] [17592186520722 1077 "selection" 13194139535592 17592186045443 true] [17592186520722 1078 #edb/ref 17592186520681 13194139535592 17592186045443 true] [17592186520722 1079 #uuid "dffa612e-a99a-5518-aa59-ddebaf8c26ba" 13194139535592 17592186045443 true] [17592186520723 1080 "64 - \\frac{8704 \\sqrt{2}}{105}" 13194139535592 17592186045443 true] [17592186520723 1082 #edb/ref 17592186045498 13194139535592 17592186045443 true] [17592186520723 1083 #uuid "e19d4737-fdde-54f7-b02d-3480dff1be65" 13194139535592 17592186045443 true] [17592186520724 1068 #edb/ref 17592186520719 13194139535592 17592186045443 true] [17592186520724 1070 #edb/ref 17592186045487 13194139535592 17592186045443 true] [17592186520724 1071 "Evaluate the line integral of the function $f(x,y)=- y^{2}$ along the curve $C$ par