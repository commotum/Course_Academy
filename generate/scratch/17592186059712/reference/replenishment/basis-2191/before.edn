{:db/id 17592186059712 :knowledge-point/canonical-example {:db/id 17592186059525 :question/id #uuid "43cfef07-255d-5167-b815-267883918993" :question/math-academy-id "e-4294" :question/problem "Let $\\begin{bmatrix}1 \\\\ -5\\end{bmatrix}$ $\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}$ and $\\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}$ Find $2\\mathbf{a}-(\\mathbf{b}-5\\mathbf{c})$." :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\n2a - (b - 5c) &= 2 \\cdot \\begin{bmatrix}1 \\\\ -5\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - 5 \\cdot \\begin{bmatrix}-3 \\\\ 7\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - (\\begin{bmatrix}2 \\\\ 4\\end{bmatrix} - \\begin{bmatrix}-15 \\\\ 35\\end{bmatrix}) \\\\\n&= \\begin{bmatrix}2 \\\\ -10\\end{bmatrix} - \\begin{bmatrix}17 \\\\ -31\\end{bmatrix} \\\\\n&= \\begin{bmatrix}-15 \\\\ 21\\end{bmatrix}\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "8a21360f-af5f-5730-85b2-b617de30eaf6" :knowledge-point/questions [{:db/id 17592186060124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80c22748-96be-5547-9bb5-c095c53f1617" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 \\\\ 4\\end{bmatrix}" :db/id 17592186057103} {:answer/id #uuid "8e0c2ce4-4775-5361-93f2-15eead4dc45e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-21 \\\\ 6\\end{bmatrix}" :db/id 17592186057104} {:answer/id #uuid "a7484c4e-d068-56dc-aca8-2e2bc40974ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}34 \\\\ -8\\end{bmatrix}" :db/id 17592186057105} {:answer/id #uuid "a9c7300d-d4ef-555d-8f12-7a5c000ac874" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}34 \\\\ 4\\end{bmatrix}" :db/id 17592186057106} {:answer/id #uuid "25ad1d96-7836-5a9b-a6bb-72edaef30273" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-26 \\\\ -8\\end{bmatrix}" :db/id 17592186057107}] :answer-field/id #uuid "816127c8-ea5b-543b-bd2f-b8af95ed22d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186057102}] :question/id #uuid "22cfb88f-d04e-5906-ba67-ce3112ea3c66" :question/math-academy-id "q-18040" :question/problem "Let $a = \\begin{bmatrix}4 \\\\ -2\\end{bmatrix}$, $b = \\begin{bmatrix}3 \\\\ 3\\end{bmatrix}$ and $c = \\begin{bmatrix}-8 \\\\ 4\\end{bmatrix}$. Find $a - (2b - 3c)$."} {:db/id 17592186060125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed92333-8c57-5c5e-b38e-8d0e5bb30fc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -13\\end{bmatrix}" :db/id 17592186057109} {:answer/id #uuid "ccbccb7b-4ce6-5702-a7f1-931d4c7f5bfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 13\\end{bmatrix}" :db/id 17592186057110} {:answer/id #uuid "d185e2a7-6bd1-5423-95d8-b583726e7df8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -11\\end{bmatrix}" :db/id 17592186057111} {:answer/id #uuid "e21f0714-be11-5cce-a0c2-a1c048f9887a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -11\\end{bmatrix}" :db/id 17592186057112} {:answer/id #uuid "00c4601b-4a4c-5376-874a-5efdf36f020d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -11\\end{bmatrix}" :db/id 17592186057113}] :answer-field/id #uuid "44615549-151b-5d3d-b02b-54ab6c84a788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186057108}] :question/id #uuid "2a5c3b4f-534d-508b-a057-66300261cf45" :question/math-academy-id "q-18041" :question/problem "Let $a = \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$, $b = \\begin{bmatrix}4 \\\\ 1\\end{bmatrix}$ and $c = \\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}$. Find $a - (2b + 5c)$."} {:db/id 17592186234272 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c7102fb2-1b14-588a-bd41-c065850a33f5" :question/math-academy-id "q-70412" :question/problem "Let $a=\\begin{bmatrix}4 \\\\ -7\\end{bmatrix}$, $b=\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}$ and $c=\\begin{bmatrix}4 \\\\ -6\\end{bmatrix}.$ Find $3a-(b+4c).$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}3a-(b+4c) & =3\\cdot \\begin{bmatrix}4 \\\\ -7\\end{bmatrix}-(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}+4\\cdot \\begin{bmatrix}4 \\\\ -6\\end{bmatrix}) \\\\  & =\\begin{bmatrix}12 \\\\ -21\\end{bmatrix}-(\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}+\\begin{bmatrix}16 \\\\ -24\\end{bmatrix}) \\\\  & =\\begin{bmatrix}12 \\\\ -21\\end{bmatrix}-\\begin{bmatrix}18 \\\\ -20\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186234273 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "aad6285a-b3b6-504e-bdb1-d51f41010e44" :question/math-academy-id "q-70414" :question/problem "Let $a=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}$, $b=\\begin{bmatrix}2 \\\\ 5\\end{bmatrix}$ and $c=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}.$ Find $a+(2b-2c).$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}a+(2b-2c) & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}+(2\\cdot \\begin{bmatrix}2 \\\\ 5\\end{bmatrix}-2\\cdot \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}+(\\begin{bmatrix}4 \\\\ 10\\end{bmatrix}-\\begin{bmatrix}2 \\\\ 4\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 6\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ 7\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Sums and Scalar Multiplication of Column Vectors"}
