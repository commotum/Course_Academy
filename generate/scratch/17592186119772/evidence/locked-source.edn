}],\\,D=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}],\\,E=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices."} {:db/id #edb/ref 17592186398284 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2542e69d-df39-5c64-b554-6be1595617c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}-2 & 0 \\\\ -3 & 5\\end{aligned}]" :db/id #edb/ref 17592186398286} {:answer/id #uuid "f60fef53-a0d6-5dc0-ab21-ab9df9058607" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C=[\\begin{aligned}3 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 0 & -5\\end{aligned}]" :db/id #edb/ref 17592186398287} {:answer/id #uuid "cae5bb2d-1f92-5e20-ba17-23b594a7c310" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}4 & 1 & 0 \\\\ -1 & 0 & 2 \\\\ 1 & 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186398288} {:answer/id #uuid "25367444-9d31-5d08-911d-e0197f9f8855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}1 & -3 \\\\ 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186398289} {:answer/id #uuid "dcecc6d5-1e1c-5114-8664-36c7f108f7a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}0 & -2 \\\\ 7 & 2\\end{aligned}]" :db/id #edb/ref 17592186398290}] :answer-field/correct {:answer/id #uuid "25367444-9d31-5d08-911d-e0197f9f8855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}1 & -3 \\\\ 0 & 5\\end{aligned}]" :db/id #edb/ref 17592186398289} :answer-field/id #uuid "0957fc2a-fd8b-5808-9041-6cd8fd6371ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/ea