} + 2 t - 1 \\right)} \\\\ e^{- 2 t^{2} - 2 t + 1} \\\\ 8 t^{2} + 8 t - 4\\end{bmatrix}" :db/id #edb/ref 17592186552690} {:answer/id #uuid "5989b541-2424-535e-be0f-7649ab6dfcae" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(- 4 t - 2\\right) \\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ e^{- 2 t^{2} - 2 t + 1} \\\\ 8 t^{2} + 8 t - 4\\end{bmatrix}" :db/id #edb/ref 17592186552703} {:answer/id #uuid "59a4aba6-d2b2-5a2e-8ab6-bacd58b786ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix}" :db/id #edb/ref 17592186552704} {:answer/id #uuid "863cc186-e569-59ce-b2c7-2137d64ff8c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(- 4 t - 2\\right)^{2} \\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ \\left(- 4 t - 2\\right)^{2} e^{- 2 t^{2} - 2 t + 1} \\\\ \\left(- 4 t - 2\\right)^{2} \\left(8 t^{2} + 8 t - 4\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552713} {:answer/id #uuid "e64f8879-1ac6-5350-82c1-40dcdbd110d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(- 4 t - 2\\right) \\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ \\left(- 4 t - 2\\right) e^{- 2 t^{2} - 2 t + 1} \\\\ - 32 t^{3} - 48 t^{2} + 8\\end{bmatrix}" :db/id #edb/ref 17592186552740}] :answer-field/correct {:answer/id #uuid "e64f8879-1ac6-5350-82c1-40dcdbd110d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(- 4 t - 2\\right) \\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ \\left(- 4 t - 2\\right) e^{- 2 t^{2} - 2 t + 1} \\\\ - 32 t^{3} - 48 t^{2} + 8\\end{bmatrix}" :db/id #edb/ref 17592186552740} :answer-field/id #uuid "4316c68a-0f11-5fb6-b198-528da9ead6ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552699}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a2c35cd6-fcd6-51f9-824f-ed3e4dd0be06" :question/problem "If $f(u)=\\begin{bmatrix}\\sin{\\left(u \\right)} \\\\ e^{u} \\\\ - 2 u^{2}\\end{bmatrix}$ and $u(t)=- 2 t^{2} - 2 t + 1$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(\\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 2 u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(- 2 t^{2} - 2 t + 1\\right)=- 4 t - 2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}\\cos{\\left(u(t) \\right)} \\\\ e^{u(t)} \\\\ - 4 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}\\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ e^{- 2 t^{2} - 2 t + 1} \\\\ 8 t^{2} + 8 t - 4\\end{bmatrix}\\cdot \\left(- 4 t - 2\\right) \\\\  & =\\begin{bmatrix}\\left(- 4 t - 2\\right) \\cos{\\left(2 t^{2} + 2 t - 1 \\right)} \\\\ \\left(- 4 t - 2\\right) e^{- 2 t^{2} - 2 t + 1} \\\\ - 32 t^{3} - 48 t^{2} + 8\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ca0aba-8740-5b9c-898e-65722cfc19f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} - 3\\right) \\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ - 2 e^{2 t^{3} - 3 t - 1} \\\\ - 12 t^{3} + 18 t + 6\\end{bmatrix}" :db/id #edb/ref 17592186552686} {:answer/id #uuid "1519574d-9682-5e9c-ba48-07ec025ce7f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ - 2 e^{2 t^{3} - 3 t - 1} \\\\ - 12 t^{3} + 18 t + 6\\end{bmatrix}" :db/id #edb/ref 17592186552688} {:answer/id #uuid "34792a61-72af-5664-a42d-2f4650bbf56a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} - 3\\right) \\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ \\left(6 - 12 t^{2}\\right) e^{2 t^{3} - 3 t - 1} \\\\ - 72 t^{5} + 144 t^{3} + 36 t^{2} - 54 t - 18\\end{bmatrix}" :db/id #edb/ref 17592186552695} {:answer/id #uuid "cf0c93cb-1299-5d62-b282-0bd887d0cade" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} - 3\\right)^{2} \\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ - 2 \\left(6 t^{2} - 3\\right)^{2} e^{2 t^{3} - 3 t - 1} \\\\ - 432 t^{7} + 1080 t^{5} + 216 t^{4} - 756 t^{3} - 216 t^{2} + 162 t + 54\\end{bmatrix}" :db/id #edb/ref 17592186552732} {:answer/id #uuid "f1eb3d44-5a3b-5cf7-abe9-3b6a05ee7a15" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ - 2 e^{u} \\\\ - 6 u\\end{bmatrix}" :db/id #edb/ref 17592186552745}] :answer-field/correct {:answer/id #uuid "34792a61-72af-5664-a42d-2f4650bbf56a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(6 t^{2} - 3\\right) \\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ \\left(6 - 12 t^{2}\\right) e^{2 t^{3} - 3 t - 1} \\\\ - 72 t^{5} + 144 t^{3} + 36 t^{2} - 54 t - 18\\end{bmatrix}" :db/id #edb/ref 17592186552695} :answer-field/id #uuid "f3f7cb0b-227e-5966-a8c8-6ec07a28d40f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552746}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cb0a4ccb-6648-53ff-8160-0a617d5e7707" :question/problem "If $f(u)=\\begin{bmatrix}\\sin{\\left(u \\right)} \\\\ - 2 e^{u} \\\\ - 3 u^{2}\\end{bmatrix}$ and $u(t)=2 t^{3} - 3 t - 1$, then $(f∘u)^{′}(t)=$ Write the polynomial component in expanded form." :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(\\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 2 e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 3 u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ - 2 e^{u} \\\\ - 6 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(2 t^{3} - 3 t - 1\\right)=6 t^{2} - 3\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}\\cos{\\left(u(t) \\right)} \\\\ - 2 e^{u(t)} \\\\ - 6 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}\\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ - 2 e^{2 t^{3} - 3 t - 1} \\\\ - 12 t^{3} + 18 t + 6\\end{bmatrix}\\cdot \\left(6 t^{2} - 3\\right) \\\\  & =\\begin{bmatrix}\\left(6 t^{2} - 3\\right) \\cos{\\left(- 2 t^{3} + 3 t + 1 \\right)} \\\\ \\left(6 - 12 t^{2}\\right) e^{2 t^{3} - 3 t - 1} \\\\ - 72 t^{5} + 144 t^{3} + 36 t^{2} - 54 t - 18\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0d7356-3f98-5128-8aec-d10d76eaf0e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 t + 4\\right) \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ 2 \\left(t + 1\\right) e^{- t^{2} - 2 t - 2} \\\\ - 8 \\left(t + 1\\right) \\left(t^{2} + 2 t + 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552694} {:answer/id #uuid "61b72935-9347-5802-8cb0-e458460e44a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- 2 \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ - e^{- t^{2} - 2 t - 2} \\\\ 4 t^{2} + 8 t + 8\\end{bmatrix}" :db/id #edb/ref 17592186552707} {:answer/id #uuid "7d0b5060-590f-53e4-8868-83ce89b64d4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- 2 \\cos{\\left(u \\right)} \\\\ - e^{u} \\\\ - 4 u\\end{bmatrix}" :db/id #edb/ref 17592186552712}