 \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(- t^{2} - 2 t - 2\\right)=- 2 t - 2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}- 2 \\cos{\\left(u(t) \\right)} \\\\ - e^{u(t)} \\\\ - 4 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}- 2 \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ - e^{- t^{2} - 2 t - 2} \\\\ 4 t^{2} + 8 t + 8\\end{bmatrix}\\cdot \\left(- 2 t - 2\\right) \\\\  & =\\begin{bmatrix}\\left(4 t + 4\\right) \\cos{\\left(t^{2} + 2 t + 2 \\right)} \\\\ 2 \\left(t + 1\\right) e^{- t^{2} - 2 t - 2} \\\\ - 8 \\left(t + 1\\right) \\left(t^{2} + 2 t + 2\\right)\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552735 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6961168f-8962-5d6b-b667-08e7ea815bad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 4 \\left(t + 1\\right) e^{t^{2} + 2 t + 1} \\\\ - 4 \\left(t + 1\\right) \\left(t^{2} + 2 t + 1\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552709} {:answer/id #uuid "8aca49b6-75ff-5ca6-94f4-43c7f2d4e406" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - 2 u\\end{bmatrix}" :db/id #edb/ref 17592186552715} {:answer/id #uuid "a14e5ab9-b89c-5d93-9482-61e8df54f34e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 e^{t^{2} + 2 t + 1} \\\\ - 2 t^{2} - 4 t - 2\\end{bmatrix}" :db/id #edb/ref 17592186552721} {:answer/id #uuid "cc6980e6-f8d5-58d0-ae35-05bb1bbb5041" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 e^{t^{2} + 2 t + 1} \\\\ - 2 t^{2} - 4 t - 2\\end{bmatrix}" :db/id #edb/ref 17592186552730} {:answer/id #uuid "e4aabe13-90aa-58f1-a182-9326ea0fff3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right)^{2} \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 \\left(2 t + 2\\right)^{2} e^{t^{2} + 2 t + 1} \\\\ \\left(2 t + 2\\right)^{2} \\left(- 2 t^{2} - 4 t - 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552738}] :answer-field/correct {:answer/id #uuid "6961168f-8962-5d6b-b667-08e7ea815bad" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 4 \\left(t + 1\\right) e^{t^{2} + 2 t + 1} \\\\ - 4 \\left(t + 1\\right) \\left(t^{2} + 2 t + 1\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552709} :answer-field/id #uuid "e5865662-f353-5c7d-b42d-d8dd39e013c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552739}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "db256af9-5b21-546d-b1d7-f812a8380522" :question/problem "If $f(u)=\\begin{bmatrix}\\sin{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - u^{2}\\end{bmatrix}$ and $u(t)=t^{2} + 2 t + 1$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(\\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(2 e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}\\cos{\\left(u \\right)} \\\\ 2 e^{u} \\\\ - 2 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(t^{2} + 2 t + 1\\right)=2 t + 2\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}\\cos{\\left(u(t) \\right)} \\\\ 2 e^{u(t)} \\\\ - 2 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}\\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 2 e^{t^{2} + 2 t + 1} \\\\ - 2 t^{2} - 4 t - 2\\end{bmatrix}\\cdot \\left(2 t + 2\\right) \\\\  & =\\begin{bmatrix}\\left(2 t + 2\\right) \\cos{\\left(t^{2} + 2 t + 1 \\right)} \\\\ 4 \\left(t + 1\\right) e^{t^{2} + 2 t + 1} \\\\ - 4 \\left(t + 1\\right) \\left(t^{2} + 2 t + 1\\right)\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186552743 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01033309-8cd5-5564-9b85-b8ad716d732d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix}" :db/id #edb/ref 17592186552680} {:answer/id #uuid "28ace170-6fd7-58dc-a331-6505d0f7c033" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ e^{- t^{2} + 2 t - 2} \\\\ 4 t^{2} - 8 t + 8\\end{bmatrix}" :db/id #edb/ref 17592186552693} {:answer/id #uuid "43d877d3-6c07-5d5e-8615-c314b5f89e66" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ 2 \\left(1 - t\\right) e^{- t^{2} + 2 t - 2} \\\\ - 8 \\left(t - 1\\right) \\left(t^{2} - 2 t + 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552700} {:answer/id #uuid "8fd0e059-e8ac-5742-953f-57d50b1b8851" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ e^{- t^{2} + 2 t - 2} \\\\ 4 t^{2} - 8 t + 8\\end{bmatrix}" :db/id #edb/ref 17592186552716} {:answer/id #uuid "cd0ccd77-a0b6-5684-a613-066cc806f35b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\left(2 - 2 t\\right)^{2} \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ \\left(2 - 2 t\\right)^{2} e^{- t^{2} + 2 t - 2} \\\\ \\left(2 - 2 t\\right)^{2} \\left(4 t^{2} - 8 t + 8\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552731}] :answer-field/correct {:answer/id #uuid "43d877d3-6c07-5d5e-8615-c314b5f89e66" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ 2 \\left(1 - t\\right) e^{- t^{2} + 2 t - 2} \\\\ - 8 \\left(t - 1\\right) \\left(t^{2} - 2 t + 2\\right)\\end{bmatrix}" :db/id #edb/ref 17592186552700} :answer-field/id #uuid "5a2d3d02-f001-51c7-af88-4009d17b71e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186552705}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f1640721-8544-52da-b867-ddbed4f7a20c" :question/problem "If $f(u)=\\begin{bmatrix}2 \\sin{\\left(u \\right)} \\\\ e^{u} \\\\ - 2 u^{2}\\end{bmatrix}$ and $u(t)=- t^{2} + 2 t - 2$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}f^{′}(u) & =\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}u}\\left(2 \\sin{\\left(u \\right)}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(e^{u}\\right) \\\\ \\frac{\\text{d}}{\\text{d}u}\\left(- 2 u^{2}\\right)\\end{bmatrix}=\\begin{bmatrix}2 \\cos{\\left(u \\right)} \\\\ e^{u} \\\\ - 4 u\\end{bmatrix} \\\\ u^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(- t^{2} + 2 t - 2\\right)=2 - 2 t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =\\begin{bmatrix}2 \\cos{\\left(u(t) \\right)} \\\\ e^{u(t)} \\\\ - 4 u(t)\\end{bmatrix}\\cdot \\left(u^{′}(t)\\right) \\\\  & =\\begin{bmatrix}2 \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ e^{- t^{2} + 2 t - 2} \\\\ 4 t^{2} - 8 t + 8\\end{bmatrix}\\cdot \\left(2 - 2 t\\right) \\\\  & =\\begin{bmatrix}\\left(4 - 4 t\\right) \\cos{\\left(t^{2} - 2 t + 2 \\right)} \\\\ 2 \\left(1 - t\\right) e^{- t^{2} + 2 t - 2} \\\\ - 8 \\left(t - 1\\right) \\left(t^{2} - 2 t + 2\\right)\\end{bmatrix}\\end{aligned}\n$$"}] :knowledge-point/title "Using the Chain Rule for Differentiation"}]}
