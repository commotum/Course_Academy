194b7-a3bd-5a62-88d6-f95203c27b49" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t+1" :db/id #edb/ref 17592186333262} {:answer/id #uuid "35f8ee1e-2532-55f4-ad12-ee7fd5baa04f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t" :db/id #edb/ref 17592186333487} {:answer/id #uuid "76b09143-8785-5fd3-a8de-148adecf998d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t-1" :db/id #edb/ref 17592186334059} {:answer/id #uuid "b2496fe5-9af3-5558-80cb-2b41bd7291a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t" :db/id #edb/ref 17592186334554}] :answer-field/correct {:answer/id #uuid "0d18f305-7184-570c-9038-db639fb9c690" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t-1" :db/id #edb/ref 17592186333104} :answer-field/id #uuid "e8dd284f-c749-5630-9eb7-44cca829df55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335646}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "33f7f09b-8fbf-5a12-9433-87f274f8c827" :question/math-academy-id "q-65222" :question/problem "Simplify the trigonometric expression $\\operatorname{cos}⁡t(1-\\operatorname{cos}⁡t)-{sin}^{2}⁡t.$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡t(1-\\operatorname{cos}⁡t)-{sin}^{2}⁡t & =\\operatorname{cos}⁡t-{cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & =\\operatorname{cos}⁡t-({cos}^{2}⁡t+{sin}^{2}⁡t) \\\\  & =\\operatorname{cos}⁡t-1\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${cos}^{2}⁡t+{sin}^{2}⁡t=1.$ \n\nTherefore, we conclude that\n\n$$\n\\operatorname{cos}⁡t(1-\\operatorname{cos}⁡t)-{sin}^{2}⁡t=\\operatorname{cos}⁡t-1.\n$$"} {:db/id #edb/ref 17592186335810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29867d59-2029-5173-b108-462543ae8b12" :answer/type {:db/ident :answer.type/math} :answer/value "-1-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186333375} {:answer/id #uuid "2f0ea8ff-9e84-5428-97fe-3086a3798ddd" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡t" :db/id #edb/ref 17592186333427} {:answer/id #uuid "4661ca1a-94ef-5f31-a526-91738f843cdb" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186333641} {:answer/id #uuid "5e3f92c5-ad36-5075-a9ce-39be43e43e00" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186333851} {:answer/id #uuid "ad1ee91a-2fdf-5e88-a4b9-c50b26f48481" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186334514}] :answer-field/correct {:answer/id #uuid "5e3f92c5-ad36-5075-a9ce-39be43e43e00" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186333851} :answer-field/id #uuid "26e35aa7-20df-59e9-bd4c-4cb8baf51d6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335312}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9e0bfa0a-1f0f-581c-9a6b-34627aa91d64" :question/math-academy-id "q-65225" :question/problem "$\\operatorname{sin}⁡t(\\operatorname{sin}⁡t-1)+{cos}^{2}⁡t=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡t(\\operatorname{sin}⁡t-1)+{cos}^{2}⁡t & ={sin}^{2}⁡t-\\operatorname{sin}⁡t+{cos}^{2}⁡t \\\\  & =({sin}^{2}⁡t+{cos}^{2}⁡t)-\\operatorname{sin}⁡t \\\\  & =1-\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${cos}^{2}⁡t+{sin}^{2}⁡t=1.$ \n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡t(\\operatorname{sin}⁡t-1)+{cos}^{2}⁡t=1-\\operatorname{sin}⁡t.\n$$"} {:db/id #edb/ref 17592186556215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae87d4f-d71a-56f5-a511-d52b7388140a" :answer/type {:db/ident :answer.type/math} :answer/value "7 \\sin \\theta \\cos \\theta + 6" :db/id #edb/ref 17592186556239} {:answer/id #uuid "73ec0a2c-d4ea-506d-aea6-38ea96ab4ad7" :answer/type {:db/ident :answer.type/math} :answer/value "7 \\sin \\theta \\cos \\theta - 6" :db/id #edb/ref 17592186556247} {:answer/id #uuid "ca0afd26-2b25-5b36-b0d7-b3432052facf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin \\theta \\cos \\theta - 6" :db/id #edb/ref 17592186556273} {:answer/id #uuid "d39f59a4-e243-52e6-b07d-0ee6530350e9" :answer/type {:db/ident :answer.type/math} :answer/value "7 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556278} {:answer/id #uuid "e3714180-108c-5f1c-9483-03926dfa877b" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 \\sin^{2} \\theta + 7 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556279}] :answer-field/correct {:answer/id #uuid "73ec0a2c-d4ea-506d-aea6-38ea96ab4ad7" :answer/type {:db/ident :answer.type/math} :answer/value "7 \\sin \\theta \\cos \\theta - 6" :db/id #edb/ref 17592186556247} :answer-field/id #uuid "8f003a65-bfb4-524e-a657-98d8efa2df73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556255}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "17340d7a-f7d9-5af9-9d56-d06b4143d831" :question/problem "Simplify the trigonometric expression $\\sin \\theta(4\\cos \\theta-6\\sin \\theta)+\\cos \\theta(3\\sin \\theta-6\\cos \\theta).$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\sin \\theta(4\\cos \\theta-6\\sin \\theta)+\\cos \\theta(3\\sin \\theta-6\\cos \\theta) = 4\\sin \\theta\\cos \\theta-6\\sin^{2}\\theta+3\\sin \\theta\\cos \\theta-6\\cos^{2}\\theta\n$$\n\nNext, we group the $\\sin^2 \\theta$ and $\\cos^2 \\theta$ terms.\n\n$$\n4\\sin \\theta\\cos \\theta-6\\sin^{2}\\theta+3\\sin \\theta\\cos \\theta-6\\cos^{2}\\theta = 7\\sin \\theta\\cos \\theta-6(\\sin^{2}\\theta+\\cos^{2}\\theta)\n$$\n\nThen, we use $\\sin^2{\\theta}+\\cos^2{\\theta}=1$ to simplify the expression in the parentheses:\n\n$$\n7\\sin \\theta\\cos \\theta-6(\\sin^{2}\\theta+\\cos^{2}\\theta) = 7 \\sin \\theta \\cos \\theta - 6\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin \\theta(4\\cos \\theta-6\\sin \\theta)+\\cos \\theta(3\\sin \\theta-6\\cos \\theta) = 7 \\sin \\theta \\cos \\theta - 6.\n$$"} {:db/id #edb/ref 17592186556225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18ed5be4-3d45-545a-9d52-a05004e5beac" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\sin \\theta \\cos \\theta + 4" :db/id #edb/ref 17592186556216} {:answer/id #uuid "3231ddc1-35cf-5f76-9671-f3021df53283" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556227} {:answer/id #uuid "496ef258-197f-5b8c-a044-63e42b9882ef" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 \\sin^{2} \\theta + 5 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556235} {:answer/id #uuid "6817befa-fcdd-52fb-bbe7-b514774c3c77" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\sin \\theta \\cos \\theta - 4" :db/id #edb/ref 17592186556241} {:answer/id #uuid "c0b41444-013f-5627-a027-c7f1a88a1b82" :answer/type {:db/ident :answer.type/math} :answer/value "- 5 \\sin \\theta \\cos \\theta - 4" :db/id #edb/ref 17592186556270}] :answer-field/correct {:answer/id #uuid "6817befa-fcdd-52fb-bbe7-b514774c3c77" :answer/type {:db/ident :answer.type/math} :answer/value "5 \\sin \\theta \\cos \\theta - 4" :db/id #edb/ref 17592186556241} :answer-field/id #uuid "44441b23-220b-5075-948e-5c96be268dca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556233}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2f8a92d4-c324-5170-939e-341e5ba8eec8" :question/problem "Simplify the trigonometric expression $\\sin \\theta(5\\cos \\theta-4\\sin \\theta)-4\\cos^{2}\\theta.$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\sin \\theta(5\\cos \\theta-4\\sin \\theta)-4\\cos^{2}\\theta = 5\\sin \\theta\\cos \\theta-4\\sin^{2}\\theta-4\\cos^{2}\\theta\n$$\n\nNext, we group the $\\sin^2 \\theta$ and $\\cos^2 \\theta$ terms.\n\n$$\n5\\sin \\theta\\cos \\theta-4\\sin^{2}\\theta-4\\cos^{2}\\theta = 5\\sin \\theta\\cos \\theta-4(\\sin^{2}\\theta+\\cos^{2}\\theta)\n$$\n\nThen, we use $\\sin^2{\\theta}+\\cos^2{\\theta}=1$ to simplify the expression in the parentheses:\n\n$$\n5\\sin \\theta\\cos \\theta-4(\\sin^{2}\\theta+\\cos^{2}\\theta) = 5 \\sin \\theta \\cos \\theta - 4\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin \\theta(5\\cos \\theta-4\\sin \\theta)-4\\cos^{2}\\theta = 5 \\sin \\theta \\cos \\theta - 4.\n$$"} {:db/id #edb/ref 17592186556226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fc45ad5-b723-5e96-9b91-e584de3e4945" :answer/type {:db/ident :answer.type/math} :answer/value "- 4 \\sin \\theta \\cos \\theta - 6" :db/id #edb/ref 17592186556242} {:answer/id #uuid "83c951fc-884f-5356-a1b7-8564f381faf4" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 \\sin^{2} \\theta + 4 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556249} {:answer/id #uuid "a0f66597-1fbe-5643-ab86-fd4b5ee5de45" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sin \\theta \\cos \\theta - 6" :db/id #edb/ref 17592186556261} {:answer/id #uuid "a62fabe4-e16f-5389-88ab-1087aa9569ee" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sin \\theta \\cos \\theta" :db/id #edb/ref 17592186556262} {:answer/id #uuid "abedba6e-3fc5-5677-95b8-b73747f411cf" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sin \\theta \\cos \\theta + 6" :db/id #edb/ref 17592186556265}] :answer-field/correct {:answer/id #uuid "a0f66597-1fbe-5643-ab86-fd4b5ee5de45" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sin \\theta \\cos \\theta - 6" :db/id #edb/ref 17592186556261} :answer-field/id #uuid "0c71da57-5c7e-5a0a-a1ec-03aeaf91af42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556213}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2f9675c1-b265-56d1-a5d2-0ce163737ab3" :question/problem "Simplify the trigonometric expression $\\sin \\theta(4\\cos \\theta-6\\sin \\theta)-6\\cos^{2}\\theta.$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\sin \\theta(4\\cos \\theta-6\\sin \\theta)-6\\cos^{2}\\theta = 4\\sin \\theta\\cos \\theta-6\\sin^{2}\\theta-6\\cos^{2}\\theta\n$$\n\nNext, we group the $\\sin^2 \\theta$ and $\\cos^2 \\theta$ terms.\n\n$$\n4\\sin \\theta\\cos \\theta-6\\sin^{2}\\theta-6\\cos^{2}\\theta = 4\\sin \\theta\\cos \\theta-6(\\sin^{2}\\theta+\\cos^{2}\\theta)\n$$\n\nThen, we use $\\sin^2{\\theta}+\\cos^2{\\theta}=1$ to simplify the expression in the parentheses:\n\n$$\n4\\sin \\theta\\cos \\theta-6(\\sin^{2}\\theta+\\cos^{2}\\theta) = 4 \\sin \\theta \\cos \\theta - 6\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin \\theta(4\\cos \\theta-6\\sin \\theta)-6\\cos^{2}\\theta = 4 \\sin \\theta \\cos \\theta - 6.\n$$"} {:db/id #edb/ref 17592186556236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26409c77-3313-5dc4-80b5-91d079c09750" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186556219} {:answer/id #uuid "272c357d-71a8-569a-8654-f2a5f4137991" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186556220} {:answer/id #uuid "374beb1e-85b2-58a4-802b-e7a101b1677e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186556229} {:answer/id #uuid "51b83310-87ae-5ef1-a647-3d6de8f81daa" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186556237} {:answer/id #uuid "7945ec28-8bb