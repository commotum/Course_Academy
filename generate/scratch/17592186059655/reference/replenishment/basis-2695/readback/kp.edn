#{[{:db/id #edb/ref 17592186059655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059486 :question/id #uuid "d917e025-59a4-5df5-b412-4eb6f2c4afc7" :question/math-academy-id "e-3329" :question/problem "Simplify the expression $\\sin x(2\\cos x - \\sin x) - \\cos^2x.$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x\\operatorname{cos}⁡x-{sin}^{2}⁡x-{cos}^{2}⁡x\\end{aligned}\n$$\n\nNext, we group the $\\sin^2 x$ and $\\cos^2 x$ terms. \n\n$$\n2\\sin x\\cos x -(\\sin^2x + \\cos^2 x)\n$$\n\nThen, we use $\\sin^2{x} + \\cos^2{x} = 1$ to simplify the expression in the parentheses:\n\n$$\n2\\sin x\\cos x - 1\n$$\n\nTherefore, we conclude that\n\n$$\n\\sin x(2\\cos x - \\sin x) - \\cos^2x = 2\\sin x\\cos x - 1.\n$$"} :knowledge-point/id #uuid "ec62fd08-5729-5dc4-97b9-1a422f70109e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048867 :topic/math-academy-id 203 :topic/title "Simplifying Expressions Using Basic Trigonometric Identities"} {:db/id #edb/ref 17592186050818 :topic/math-academy-id 371 :topic/title "Multiplying Binomials"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186556287 :question-generator/id #uuid "88fa9685-85c8-511c-ad1a-9cf73f173013" :question-generator/script "generate/scratch/17592186059655.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8df8b818-0930-5639-b4a1-ad518eba7033" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186056785} {:answer/id #uuid "c693be5b-d9c6-5b58-b0cc-b463fe702aca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186056786} {:answer/id #uuid "11a72960-3ccb-5e7e-8e5b-9bae45b9e145" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186056787} {:answer/id #uuid "55372a31-da38-5d71-8d44-05c985c2e838" :answer/type {:db/ident :answer.type/math} :answer/value 