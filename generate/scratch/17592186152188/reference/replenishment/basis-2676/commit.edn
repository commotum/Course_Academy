35989 17592186045443 true] [17592186553716 1068 #edb/ref 17592186553691 13194139535989 17592186045443 true] [17592186553716 1070 #edb/ref 17592186045485 13194139535989 17592186045443 true] [17592186553716 1071 "Find the Cartesian equation of the ellipse defined by\n\n$$\n\\frac{x}{2}=\\cos\\theta,\\quad \\frac{y}{7}=\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" 13194139535989 17592186045443 true] [17592186553716 1072 #uuid "c5d09569-8769-5378-ac85-faeb959d3726" 13194139535989 17592186045443 true] [17592186553716 1074 "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $\\cos\\theta$ term in the $x$-equation, we get\n\n$$\n\\begin{aligned}\\frac{x}{2} & =\\cos\\theta \\\\ \\frac{{x}^{2}}{(2)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{4} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{7} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(7)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{49} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=1.\n$$" 13194139535989 17592186045443 true] [17592186553717 1080 "\\frac{{x}^{2}}{11}+\\frac{{y}^{2}}{4}=1" 13194139535989 17592186045443 true] [17592186553717 1082 #edb/ref 17592186045498 13194139535989 17592186045443 true] [17592186553717 1083 #uuid "cc606102-32d8-5ce3-b21a-bb23f9b354a3" 13194139535989 17592186045443 true] [17592186553718 1080 "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{2}=1" 13194139535989 17592186045443 true] [17592186553718 1082 #edb/ref 17592186045498 13194139535989 17592186045443 true] [17592186553718 1083 #uuid "d73fd73f-0590-5f6f-a4f5-edc9dba1df7a" 13194139535989 17592186045443 true] [17592186553719 1068 #edb/ref 17592186553703 13194139535989 17592186045443 true] [17592186553719 1070 #edb/ref 17592186045485 13194139535989 17592186045443 true] [17592186553719 1071 "Find the Cartesian equation of the ellipse defined by\n\n$$\n\\frac{x}{11}=\\cos\\theta,\\quad \\frac{y}{4}=\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" 13194139535989 17592186045443 true] [17592186553719 1072 #uuid "ea3ff876-21d3-588e-bcef-ab512e92b202" 13194139535989 17592186045443 true] [17592186553719 1074 "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $\\cos\\theta$ term in the $x$-equation, we get\n\n$$\n\\begin{aligned}\\frac{x}{11} & =\\cos\\theta \\\\ \\frac{{x}^{2}}{(11)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{121} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{4} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(4)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{16} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{16}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{16}=1.\n$$" 13194139535989 17592186045443 true] [17592186553720 1080 "\\frac{{x}^{2}}{121}-\\frac{{y}^{2}}{16}=1" 13194139535989 17592186045443 true] [17592186553720 1082 #edb/ref 17592186045498 13194139535989 17592186045443 true] [17592186553720 1083 #uuid "eb71c85d-2053-5194-ac88-087d8dcd6991" 13194139535989 17592186045443 true] [17592186553721 1080 "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" 13194139535989 17592186045443 true] [17592186553721 1082 #edb/ref 17592186045498 13194139535989 17592186045443 true] [17592186553721 1083 #uuid "ee4afd5f-eb46-5b6a-80e9-ddcf1dc087ac" 13194139535989 17592186045443 true] [17592186553722 1080 "\\frac{{x}^{2}}{8}+\