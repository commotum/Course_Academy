{x}^{2}}{(9)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{81} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{2} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(2)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{4} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{4}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{4}=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["412c1719-c37c-55ff-a7da-39e301f8555b"] :db/ensure :question/validate} {:db/id "ee4afd5f-eb46-5b6a-80e9-ddcf1dc087ac" :answer/id #uuid "ee4afd5f-eb46-5b6a-80e9-ddcf1dc087ac" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/ensure :answer/validate} {:db/id "b2abdd01-f402-5a52-ad58-3efffea941c3" :answer/id #uuid "b2abdd01-f402-5a52-ad58-3efffea941c3" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=1" :db/ensure :answer/validate} {:db/id "ff680fc3-ce64-528a-856e-7bfce2f117d2" :answer/id #uuid "ff680fc3-ce64-528a-856e-7bfce2f117d2" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{7}=1" :db/ensure :answer/validate} {:db/id "17e83a1b-7c09-584f-89fe-d536701f2d10" :answer/id #uuid "17e83a1b-7c09-584f-89fe-d536701f2d10" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{7}=1" :db/ensure :answer/validate} {:db/id "ae61fd26-957d-5457-962b-16a3d69306e4" :answer/id #uuid "ae61fd26-957d-5457-962b-16a3d69306e4" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{49}=1" :db/ensure :answer/validate} {:db/id "1fa1b1e5-5a41-5916-bff2-9aa7ce4c5ab3" :answer-field/id #uuid "1fa1b1e5-5a41-5916-bff2-9aa7ce4c5ab3" :answer-field/key "selection" :answer-field/type :answer-fie