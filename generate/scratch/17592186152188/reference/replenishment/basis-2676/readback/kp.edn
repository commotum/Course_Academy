\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{7} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(7)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{49} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{49}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{49}=1.\n$$"} {:db/id #edb/ref 17592186553716 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17e83a1b-7c09-584f-89fe-d536701f2d10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186553690} {:answer/id #uuid "ae61fd26-957d-5457-962b-16a3d69306e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{49}=1" :db/id #edb/ref 17592186553710} {:answer/id #uuid "b2abdd01-f402-5a52-ad58-3efffea941c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=1" :db/id #edb/ref 17592186553712} {:answer/id #uuid "ee4afd5f-eb46-5b6a-80e9-ddcf1dc087ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553721} {:answer/id #uuid "ff680fc3-ce64-528a-856e-7bfce2f117d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186553723}] :answer-field/correct {:answer/id #uuid "b2abdd01-f402-5a52-ad58-3efffea941c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=1" :db/id #edb/ref 17592186553712} :answer-field/id #uuid "1fa1b1e5-5a41-5916-bff2-9aa7ce4c5ab3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553691}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5d09569-8769-5378-ac85-faeb959d3726" :question/problem "Find the Cartesian equation of the ellipse defined by\n\n$$\n\\frac{x}{2}=\\cos\\theta,\\quad \\frac{y}{7}=\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $\\cos\\theta$ term in the $x$-equation, we get\n\n$$\n\\begin{aligned}\\frac{x}{2} & =\\cos\\theta \\\\ \\frac{{x}^{2}}{(2)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{4} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{7} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(7)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{49} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{49}=1.\n$$"} {:db/id #edb/ref 17592186553719 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a4eed1f-3af9-5976-b03d-acebc6d144a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186553695} {:answer/id #uuid "94334901-fb74-5742-be6c-6a327b7ee13e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553708} {:answer/id #uuid "c21af765-fb6e-5349-8e2a-df0c6bd18fc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{121}=1" :db/id #edb/ref 17592186553714} {:answer/id #uuid "cc606102-32d8-5ce3-b21a-bb23f9b354a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{11}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553717} {:answer/id #uuid "eb71c85d-2053-5194-ac88-087d8dcd6991" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{121}-\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186553720}] :answer-field/correct {:answer/id #uuid "4a4eed1f-3af9-5976-b03d-acebc6d144a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186553695} :answer-field/id #uuid "5fa59c2e-fd2e-57d5-9372-070e8785c69b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea3ff876-21d3-588e-bcef-ab512e92b202" :question/problem "Find the Cartesian equation of the ellipse defined by\n\n$$\n\\frac{x}{11}=\\cos\\theta,\\quad \\frac{y}{4}=\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $\\cos\\theta$ term in the $x$-equation, we get\n\n$$\n\\begin{aligned}\\frac{x}{11} & =\\cos\\theta \\\\ \\frac{{x}^{2}}{(11)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{121} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{4} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(4)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{16} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{16}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{121}+\\frac{{y}^{2}}{16}=1.\n$$"}] :knowledge-point/title "The Cartesian Equation of an Ellipse"}]}
