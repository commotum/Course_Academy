a =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+5)^{2}}{9}+\\frac{(y+2)^{2}}{36} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{(x+5)^{2}}{9}+\\frac{(y+2)^{2}}{36}=1.\n$$"} {:db/id #edb/ref 17592186541060 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fa5b866-e128-5753-a445-f1b463ce86be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(x+4)^2}{25}+\\frac{(y-2)^2}{27}" :db/id #edb/ref 17592186540742}] :answer-field/correct {:answer/id #uuid "7fa5b866-e128-5753-a445-f1b463ce86be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(x+4)^2}{25}+\\frac{(y-2)^2}{27}" :db/id #edb/ref 17592186540742} :answer-field/id #uuid "b240cd70-b283-509c-882a-a63367769e6b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186541018}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d95a82d-3596-5013-a69c-59119b644955" :question/math-academy-id "q-327800" :question/problem "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=5\\operatorname{cos}⁡\\theta -4,\\,y=3\\sqrt{3}\\,\\operatorname{sin}⁡\\theta +2,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\operatorname{cos}⁡\\theta -4 \\\\ \\frac{x+4}{5} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{(x+4)^{2}}{{5}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{(x+4)^{2}}{25} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =3\\sqrt{3}\\operatorname{sin}⁡\\theta +2 \\\\ \\frac{y-2}{3\\sqrt{3}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{(y-2)^{2}}{(3\\sqrt{3})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{(y-2)^{2}}{27} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{27} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{27}=1.\n$$"} {:db/id #edb/ref 17592186541118 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7e03f86-abab-5944-93ad-4c56076946d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2}{50}+\\frac{y^2}{63}" :db/id #edb/ref 17592186540920}] :answer-field/correct {:answer/id #uuid "e7e03f86-abab-5944-93ad-4c56076946d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^2}{50}+\\frac{y^2}{63}" :db/id #edb/ref 17592186540920} :answer-field/id #uuid "0c37ef4d-2cd6-55e8-930f-488347a97b91" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186540950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0a23b4a-b8a9-57f6-be01-ea66f5dec94e" :question/math-academy-id "q-327807" :question/problem "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=5\\sqrt{2}\\operatorname{cos}⁡\\theta ,\\,y=3\\sqrt{7}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =5\\sqrt{2}\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{5\\sqrt{2}} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{(5\\sqrt{2})^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{50} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =3\\sqrt{7}\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{3\\sqrt{7}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{(3\\sqrt{7})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{63} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\frac{{x}^{2}}{50}+\\frac{{y}^{2}}{63}={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{50}+\\frac{{y}^{2}}{63}=1.\n$$"} {:db/id #edb/ref 17592186541147 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e4db871-9264-5abb-8b35-f8cefa4d7edc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{49}-\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186540554} {:answer/id #uuid "2ca34a0e-8d0c-5de6-a6da-86fe375f2f1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1" :db/id #edb/ref 17592186540603} {:answer/id #uuid "383804ba-6e24-59d1-8b86-33a991e9821e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{16}=1" :db/id #edb/ref 17592186540617} {:answer/id #uuid "389fd57e-2d25-5ed5-a585-2bc467281b50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{7}=1" :db/id #edb/ref 17592186540619} {:answer/id #uuid "5dd2ee4e-8bd6-545a-9a0a-ae52bffe93ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{49}=1" :db/id #edb/ref 17592186540686}] :answer-field/correct {:answer/id #uuid "2ca34a0e-8d0c-5de6-a6da-86fe375f2f1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1" :db/id #edb/ref 17592186540603} :answer-field/id #uuid "4318b039-4a2e-5f72-894b-9e7f5517fbea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186540973}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7435811-f6b1-5cc6-8105-467790c4f32b" :question/math-academy-id "q-15801" :question/problem "Determine the Cartesian equation of the ellipse\n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=7\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =4\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{4} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{4}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{16} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =7\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{7} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{7}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{49} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{49}=1.\n$$"} {:db/id #edb/ref 17592186553692 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f303671-2e9e-5abb-8d28-bb66030b781a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553697} {:answer/id #uuid "5ac71fd6-aef4-521a-be30-ea15e9fd1d7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{64}-\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553702} {:answer/id #uuid "79b7ae4b-a531-5e36-9642-7063e55bfd39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{64}=1" :db/id #edb/ref 17592186553705} {:answer/id #uuid "d73fd73f-0590-5f6f-a4f5-edc9dba1df7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186553718} {:answer/id #uuid "ef7b0bc1-b548-5a45-8603-72e62b1d2cfa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186553722}] :answer-field/correct {:answer/id #uuid "4f303671-2e9e-5abb-8d28-bb66030b781a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553697} :answer-field/id #uuid "8e1dbdc3-6266-50e7-8ca0-341d52ae8cbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553707}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f24b968-c90a-5088-b77c-2d14ff47db8f" :question/problem "Find the Cartesian equation of the ellipse defined by\n\n$$\n\\frac{x}{8}=\\cos\\theta,\\quad \\frac{y}{2}=\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $\\cos\\theta$ term in the $x$-equation, we get\n\n$$\n\\begin{aligned}\\frac{x}{8} & =\\cos\\theta \\\\ \\frac{{x}^{2}}{(8)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{64} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{2} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(2)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{4} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{4}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{64}+\\frac{{y}^{2}}{4}=1.\n$$"} {:db/id #edb/ref 17592186553704 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4524d28f-034a-5b7e-8273-1db28285d123" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{81}=1" :db/id #edb/ref 17592186553694} {:answer/id #uuid "5343a329-7bfb-59e4-ae4b-2f0d39395b1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553699} {:answer/id #uuid "537e318d-1b07-5122-a845-50ebd93fbfcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{81}-\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553700} {:answer/id #uuid "a5f1c439-a4cc-5191-9808-eb4900c85251" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186553709} {:answer/id #uuid "b0a08eda-5358-5633-8b81-3f6cde1d724a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186553711}] :answer-field/correct {:answer/id #uuid "5343a329-7bfb-59e4-ae4b-2f0d39395b1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186553699} :answer-field/id #uuid "412c1719-c37c-55ff-a7da-39e301f8555b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186553693}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72794993-4291-5561-9810-697b71da5a36" :question/problem "Find the Cartesian equation of the ellipse defined by\n\n$$\n\\frac{x}{9}=\\cos\\theta,\\quad \\frac{y}{2}=\\sin\\theta,\\quad 0\\leq\\theta<2\\pi.\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy squaring the $\\cos\\theta$ term in the $x$-equation, we get\n\n$$\n\\begin{aligned}\\frac{x}{9} & =\\cos\\theta \\\\ \\frac{{x}^{2}}{(9)^{2}} & =\\cos^2\\theta \\\\ \\frac{{x}^{2}}{81} & =\\cos^2\\theta.\\end{aligned}\n$$\n\nBy squaring the $\\sin\\theta$ term in the $y$-equation, we get\n\n$$\n\\begin{aligned}\\frac{y}{2} & =\\sin\\theta \\\\ \\frac{{y}^{2}}{(2)^{2}} & =\\sin^2\\theta \\\\ \\frac{{y}^{2}}{4} & =\\sin^2\\theta.\\end{aligned}\n$$\n\nAdding the two equations and using $\\cos^2\\theta+\\sin^2\\theta=1,$ we get\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{4}=\\cos^2\\theta+\\sin^2\\theta=1.\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{4}=1.\n$$"} {:db/id #edb/ref 17592186553706 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bdd6321-be