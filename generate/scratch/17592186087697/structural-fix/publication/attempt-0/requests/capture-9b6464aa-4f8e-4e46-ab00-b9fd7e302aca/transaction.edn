b/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/id #uuid "6337a2fc-031a-539c-af7b-6662b214cb26"] [:db/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/problem "Which of the following are diagonal matrices?\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$F=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ -1 & 0 & -2\\end{bmatrix}$</div>\n<div>$H=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & -2 \\\\ 0 & 0 & 0\\end{bmatrix}$</div>\n<div>$M=\\begin{bmatrix}-2 & 0 \\\\ 0 & 3 \\\\ 0 & 0\\end{bmatrix}$</div>\n</div>\n\nSelect all that apply."] [:db/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/worked-solution "- $F$ is *not* a diagonal matrix. It is square, but an entry off the main diagonal is nonzero: ${f}_{31}=-1\\ne 0$.\n\n- $H$ is *not* a diagonal matrix. It is not a square matrix: it has 4 rows and 3 columns.\n\n- $M$ is *not* a diagonal matrix. It is not a square matrix: it has 3 rows and 2 columns.\n\nTherefore, none of the given matrices are diagonal matrices."] [:db/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/difficulty :question.difficulty/easy] [:db/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/answer-fields "df82fbf3-2164-530e-9dae-5051a9e274c4"] [:db/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/answer-fields "67d6b16c-fb26-5e65-a790-7d5ff21e79ac"] [:db/add "6337a2fc-031a-539c-af7b-6662b214cb26" :question/answer-fields "80212442-540e-59ae-9718-ae2c2c5fac1f"] [:db/ensure "6337a2fc-031a-539c-af7b-6662b214cb26" :question/validate] [:db/add 17592186087697 :knowledge-point/questions "6337a2fc-031a-539c-af7b-6662b214cb26"] [:db/add "62e696b4-4b90-522d-ab38-672b674631a6" :answer/id #uuid "62e696b4-4b90-522d-ab38-672b674631a6"] [:db/add "62e696b4-4b90-522d-ab38-672b674631a6" :answer/type :answer.type/text] [:db/add "62e696b4-4b90-522d-ab38-672b674631a6" :answer/value "false"] [:db/ensure "62e696b4-4b90-522d-ab38-672b674631a6" :answer/validate] [:db/add "a3a327e0-f999-5ee2-9922-0e59a6e6c301" :answer/id #u