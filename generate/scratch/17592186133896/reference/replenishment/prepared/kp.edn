}6{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369413 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396b8bd9-301b-51ec-aca0-06cdba5ad003" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡t\\,{e}^{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}" :db/id #edb/ref 17592186369415} {:answer/id #uuid "a8dbb119-5910-5170-9d33-e634a7d5b88b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t\\,{e}^{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}" :db/id #edb/ref 17592186369416} {:answer/id #uuid "d7ec21fa-558f-57a8-81bd-b660d625d1a6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡t\\,{e}^{2\\operatorname{cos}⁡t}" :db/id #edb/ref 17592186369417} {:answer/id #uuid "1a2f5977-a0c7-5e88-b88d-158811b0198d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t\\,{e}^{2\\operatorname{sin}⁡t}" :db/id #edb/ref 17592186369418} {:answer/id #uuid "f3580aca-f980-54b4-b266-0dffc5f943b7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t\\,{e}^{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}" :db/id #edb/ref 17592186369419}] :answer-field/correct {:answer/id #uuid "a8dbb119-5910-5170-9d33-e634a7d5b88b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t\\,{e}^{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}" :db/id #edb/ref 17592186369416} :answer-field/id #uuid "ff67740a-3837-5c9c-8e44-2824507f3d72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369414}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9ca0a08-e6bb-50c4-bb79-c63c0eceed7a" :question/math-academy-id "q-126750" :question/problem "![](images/0d/0d988bfd18a945ba96c3556775d4aebc706252e2baf02d5f76c108e5534baed1.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨{e}^{\\operatorname{sin}⁡t},\\,{e}^{\\operatorname{cos}⁡t}⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the missing part of the equation.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨\\operatorname{cos}⁡t\\,{e}^{\\operatorname{sin}⁡t},\\,-\\operatorname{sin}⁡t\\,{e}^{\\operatorname{cos}⁡t}⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={\\int }_{0}^{2\\pi }{e}^{\\operatorname{cos}⁡t}\\cdot \\operatorname{cos}⁡t\\,{e}^{\\operatorname{sin}⁡t}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡t\\,{e}^{\\operatorname{cos}⁡t+\\operatorname{sin}⁡t}\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369420 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0d281b3-5a65-5abd-9147-9fa81d7479a7" :answer/type {:db/ident :answer.type/math} :answer/value "-18\\operatorname{sin}⁡2t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186369422} {:answer/id #uuid "771eb8e2-5fd8-5c34-9cab-6baf30556342" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\operatorname{sin}⁡t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186369423} {:answer/id #uuid "1186811b-cecf-5cd1-866d-f83bda30e6d8" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{sin}⁡t\\operatorname{cos}⁡t" :db/id #edb/ref 17592186369424} {:answer/id #uuid "26818ab1-0eaf-5fec-bae5-cdb88bcda5c2" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sin}⁡2t\\operatorname{cos}⁡t" :db/id #edb/ref 17592186369425} {:answer/id #uuid "af5ef701-94c2-5be2-ab98-f0bb5078f369" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\operatorname{sin}⁡2t\\operatorname{cos}⁡t" :db/id #edb/ref 17592186369426}] :answer-field/correct {:answer/id #uuid "771eb8e2-5fd8-5c34-9cab-6baf30556342" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\operatorname{sin}⁡t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186369423} :answer-field/id #uuid "f0b9dd1e-629f-5bde-86fc-a981f5b5dd34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369421}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5399a5fd-5cdb-5780-b3c9-dad2d4175154" :question/math-academy-id "q-126751" :question/problem "![](images/81/81da86ae54a837b954bf93f8a75d93e1e7a8b64c93ba6f6b06cf74b2d8fa7ecb.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨2\\operatorname{sin}⁡t,\\,3\\operatorname{sin}⁡2t⟩$ for $t\\in [0,\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨2\\operatorname{cos}⁡t,\\,6\\operatorname{cos}⁡2t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-x\\,\\text{d}y & ={\\int }_{0}^{\\pi }(-2\\operatorname{sin}⁡t)\\cdot 6\\operatorname{cos}⁡2t\\,dt \\\\  & ={\\int }_{0}^{\\pi }-12\\operatorname{sin}⁡t\\operatorname{cos}⁡2t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186370913 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2af7955-e8f7-5d06-9494-41b60d32dda6" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sin}⁡t\\operatorname{cos}⁡t" :db/id #edb/ref 17592186370915} {:answer/id #uuid "eeb61e07-30d9-5656-b689-8f8a3ed177fb" :answer/type {:db/ident :answer.type/math} :answer/value "6({sin}^{2}⁡t-{cos}^{2}⁡t)" :db/id #edb/ref 17592186370916} {:answer/id #uuid "08be8790-c0ff-5547-af1e-b5707ffe8884" :answer/type {:db/ident :answer.type/math} :answer/value "6({cos}^{2}⁡t-{sin}^{2}⁡t)" :db/id #edb/ref 17592186370917} {:answer/id #uuid "050b2982-51ab-5396-940b-7dbb8bae2852" :answer/type {:db/ident :answer.type/math} :answer/value "6{sin}^{2}⁡t" :db/id #edb/ref 17592186370918} {:answer/id #uuid "d2c4546b-9878-58e1-b16e-060b263f44e3" :answer/type {:db/ident :answer.type/math} :answer/value "6{cos}^{2}⁡t" :db/id #edb/ref 17592186370919}] :answer-field/correct {:answer/id #uuid "d2c4546b-9878-58e1-b16e-060b263f44e3" :answer/type {:db/ident :answer.type/math} :answer/value "6{cos}^{2}⁡t" :db/id #edb/ref 17592186370919} :answer-field/id #uuid "e0c958a9-3def-549d-9734-898a0cb36e97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "784069b0-0cb9-51e0-bbfa-d48bc8a07132" :question/math-academy-id "q-41466" :question/problem "![](images/1d/1de9544b8da50f6280920adf2292da517a844b8b4143f58f646da0a01ffad16c.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨3\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩$ for $t\\in [0,2\\pi ].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation." :question/worked-solution "Our simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-3\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}x\\,dy & ={\\int }_{0}^{2\\pi }3\\operatorname{cos}⁡t\\cdot 2\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }6{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186405050 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25a141bb-7515-52e5-991a-6d1cce5fd112" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186405052} {:answer/id #uuid "15639b84-a5cd-5c57-999c-5eaa4da55cb8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡2t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186405053} {:answer/id #uuid "153703e1-22d9-5301-b881-b997b52a3787" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186405054} {:answer/id #uuid "08da98f7-5e83-58f1-9af7-d12e18b8d86a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡2t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186405055} {:answer/id #uuid "bd69317b-3202-5a07-9b1f-77c79a7cbb53" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\operatorname{sin}⁡2t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186405056}] :answer-field/correct {:answer/id #uuid "25a141bb-7515-52e5-991a-6d1cce5fd112" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡t\\operatorname{cos}⁡2t" :db/id #edb/ref 17592186405052} :answer-field/id #uuid "d59276d0-6151-587a-b33c-8bc27d781877" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186405051}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0f4b84a-3d7c-5e64-bd13-2b1a225fb6c3" :question/math-academy-id "q-126748" :question/problem "![](images/65/6571fcdf94818485c2a39e90e018d46e9c95e1acbe0a8cf2f67c688d160a347c.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨2\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡t⟩$ for $t\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{-\\pi /2}^{\\pi /2}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, piecewise smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨4\\operatorname{cos}⁡2t,\\,-\\operatorname{sin}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡t\\cdot 4\\operatorname{cos}⁡2t\\,dt \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}4\\operatorname{cos}⁡t\\operatorname{cos}⁡2t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431049 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30625b21-0638-5df6-8e7f-5ecca67ca674" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186431017} {:answer/id #uuid "31a713ed-2a9a-58c6-bfc8-e17df3a2f279" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{cos}⁡2t-\\operatorname{cos}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431018} {:answer/id #uuid "7643c9ff-155d-5092-a735-8716263f25b6" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431026} {:answer/id #uuid "a4547936-89a5-5eb1-a5c2-aca7ffed8e29" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{cos}⁡2t-\\operatorname{cos}⁡t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186431032} {:answer/id #uuid "f95f8500-94e5-5ec5-b5e0-95f0daf53e67" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431039}] :answer-field/correct {:answer/id #uuid "f95f8500-94e5-5ec5-b5e0-95f0daf53e67" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186431039} :answer-field/id #uuid "4c9269d5-fd3f-54ff-be8f-682c742d6ce4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431042}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2177a684-6e86-5255-ac01-04a426569ee5" :question/math-academy-id "q-126760" :question/problem "![](images/a9/a95b161dab89fe1245724921ef4ee36112d7a4062e7e171411e4ffe61253b91f.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡t-\\operatorname{cos}⁡2t⟩$ for $t\\in [\\frac{\\pi }{3},\\frac{5\\pi }{3}].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{\\pi /3}^{5\\pi /3}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t,\\,-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-x\\,\\text{d}y & ={\\int }_{\\pi /3}^{5\\pi /3}(-\\operatorname{sin}⁡t+\\operatorname{sin}⁡2t)\\cdot (-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t)\\,dt \\\\  & ={\\int }_{\\pi /3}^{5\\pi /3}(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(2\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186431053 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031791c1-0f2f-546c-82e8-999c8554dc97" :answer/type {:db/ident :answer.type/math} :answer/value "5{cos}^{6}⁡t{sin}^{4}⁡t" :db/id #edb/ref 17592186431012} {:answer/id #uuid "7bf73cdb-b201-56ec-9e65-ae9499b1e5c5" :answer/type {:db/ident :answer.type/math} :answer/value "-5{cos}^{5}⁡t{sin}^{5}⁡t" :db/id #edb/ref 17592186431028} {:answer/id #uuid "88f605ff-e892-57f0-8a1b-c76ad9f5a91e" :answer/type {:db/ident :answer.type/math} :answer/value "5{cos}^{5}⁡t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186431029} {:answer/id #uuid "e1ec8ccb-1292-5505-905e-84a2ec107ae8" :answer/type {:db/ident :answer.type/math} :answer/value "-5{sin}^{6}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186431037} {:answer/id #uuid "f58f79ef-051d-5166-b8fb-70ef66a978d8" :answer/type {:db/ident :answer.type/math} :answer/value "5{sin}^{6}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186431038}] :answer-field/correct {:answer/id #uuid "f58f79ef-051d-5166-b8fb-70ef66a978d8" :answer/type {:db/ident :answer.type/math} :answer/value "5{sin}^{6}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186431038} :answer-field/id #uuid "c7e0a66d-4420-5ec9-9e88-13a5cdd58112" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431045}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1f25e51-cfc7-5f63-98bf-d803b12546e2" :question/math-academy-id "q-126761" :question/problem "![](images/10/10f4094edb09afc7908bd0cd3df089387c8f5b762ea5ef86da152d1c9d08b5e4.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨{sin}^{5}⁡t,\\,{cos}^{5}⁡t⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, piecewise-smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨5{sin}^{4}⁡t\\operatorname{cos}⁡t,\\,-5{cos}^{4}⁡t\\operatorname{sin}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-x\\,\\text{d}y & ={\\int }_{0}^{2\\pi }(-{sin}^{5}⁡t)\\cdot (-5{cos}^{4}⁡t\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }5{sin}^{6}⁡t{cos}^{4}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442249 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "536ba388-fdb8-58ea-b126-38fbd2dcdb6b" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186442233} {:answer/id #uuid "b9f93b2c-abf4-5cbd-aa5b-d281bc9dc445" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{cos}⁡2t-\\operatorname{cos}⁡t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186442239} {:answer/id #uuid "ba5cc6be-612b-5620-9ea1-537324d438b6" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡2t-\\operatorname{sin}⁡t)(\\operatorname{sin}⁡t-2\\operatorname{sin}⁡2t)" :db/id #edb/ref 17592186442240} {:answer/id #uuid "c3dbd51c-9d36-5509-bb8b-877222cbaef9" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{cos}⁡t-\\operatorname{cos}⁡2t)(\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t)" :db/id #edb/ref 17592186442242} {:answer/id #uuid "de993e24-618b-5743-81ef-393206c8a109" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(\\operatorname{sin}⁡t-2\\operatorname{sin}⁡2t)" :db/id #edb/ref 17592186442243}] :answer-field/correct {:answer/id #uuid "de993e24-618b-5743-81ef-393206c8a109" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(\\operatorname{sin}⁡t-2\\operatorname{sin}⁡2t)" :db/id #edb/ref 17592186442243} :answer-field/id #uuid "53872032-3b68-54a9-b047-b5722ee1ce8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442246}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19d2b758-b269-5c92-aaaf-707449daf876" :question/math-academy-id "q-42301" :question/problem "![](images/ac/ac9f6016ee4c93aec58f8fff0a8002057f89d7c1bae589e5357a25709ae5a76c.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨\\operatorname{cos}⁡t-\\operatorname{cos}⁡2t,\\,\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t⟩$ for $t\\in [\\frac{\\pi }{3},\\frac{5\\pi }{3}].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{\\pi /3}^{5\\pi /3}\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the missing part of the equation." :question/worked-solution "Our simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t,\\,\\operatorname{cos}⁡t-2\\operatorname{cos}⁡2t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-y\\,dx & ={\\int }_{\\pi /3}^{5\\pi /3}-(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)\\cdot (-\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t)\\,dt \\\\  & ={\\int }_{\\pi /3}^{5\\pi /3}(\\operatorname{sin}⁡t-\\operatorname{sin}⁡2t)(\\operatorname{sin}⁡t-2\\operatorname{sin}⁡2t)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442250 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f00612-ca24-58a9-9a99-5bc9dff70695" :answer/type {:db/ident :answer.type/math} :answer/value "3{sin}^{3}⁡t{cos}^{2}⁡t" :db/id #edb/ref 17592186442225} {:answer/id #uuid "244e3377-d03b-59bc-9a15-821691749cc3" :answer/type {:db/ident :answer.type/math} :answer/value "3{sin}^{4}⁡t{cos}^{2}⁡t" :db/id #edb/ref 17592186442228} {:answer/id #uuid "3b19e5e7-17b2-5ecd-8bda-2f5d049ec56f" :answer/type {:db/ident :answer.type/math} :answer/value "3{sin}^{2}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186442230} {:answer/id #uuid "4ac2fdfe-d325-50d4-8f82-69274f9797ee" :answer/type {:db/ident :answer.type/math} :answer/value "3{sin}^{3}⁡t{cos}^{4}⁡t" :db/id #edb/ref 17592186442231} {:answer/id #uuid "4c93679f-96a9-5546-b831-28f2a59ed0bd" :answer/type {:db/ident :answer.type/math} :answer/value "3{sin}^{3}⁡t{cos}^{3}⁡t" :db/id #edb/ref 17592186442232}] :answer-field/correct {:answer/id #uuid "244e3377-d03b-59bc-9a15-821691749cc3" :answer/type {:db/ident :answer.type/math} :answer/value "3{sin}^{4}⁡t{cos}^{2}⁡t" :db/id #edb/ref 17592186442228} :answer-field/id #uuid "1007d99f-4a44-5eca-8672-e3953d3b25aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442245}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "30739161-7e72-5e37-b131-9975b77440f7" :question/math-academy-id "q-42315" :question/problem "![](images/bf/bfec7cbdb26a3db773ab1f6207de436ff0856b331cda183da530dbb6b91d91bd.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨{cos}^{3}⁡t,\\,{sin}^{3}⁡t⟩$ for $t\\in [0,2\\pi ].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the missing part of the equation." :question/worked-solution "Our simple, piecewise-smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-3{cos}^{2}⁡t\\operatorname{sin}⁡t,\\,3{sin}^{2}⁡t\\operatorname{cos}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-y\\,dx & ={\\int }_{0}^{2\\pi }(-{sin}^{3}⁡t)\\cdot (-3{cos}^{2}⁡t\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }3{sin}^{4}⁡t{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442252 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-5