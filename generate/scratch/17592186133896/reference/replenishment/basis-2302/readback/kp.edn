ame{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }3{sin}^{4}⁡t{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442252 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14451dd1-51ba-5cb4-a62a-0a5d4ff055bf" :answer/type {:db/ident :answer.type/math} :answer/value "9{sin}^{2}⁡t" :db/id #edb/ref 17592186442227} {:answer/id #uuid "6f80c7b4-33fd-57db-876b-025e20021ccd" :answer/type {:db/ident :answer.type/math} :answer/value "9{cos}^{2}⁡t" :db/id #edb/ref 17592186442235} {:answer/id #uuid "81dd9c9a-88ed-5edc-bb4a-ab112606e4e5" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\operatorname{sin}⁡t\\operatorname{cos}⁡t" :db/id #edb/ref 17592186442236} {:answer/id #uuid "bd4d50f5-796c-5fc2-a622-14130e42fc0e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{sin}⁡t\\operatorname{cos}⁡t" :db/id #edb/ref 17592186442241} {:answer/id #uuid "e911610a-7c47-5303-9138-bd0e5e56ae76" :answer/type {:db/ident :answer.type/math} :answer/value "-9{sin}^{2}⁡t" :db/id #edb/ref 17592186442244}] :answer-field/correct {:answer/id #uuid "6f80c7b4-33fd-57db-876b-025e20021ccd" :answer/type {:db/ident :answer.type/math} :answer/value "9{cos}^{2}⁡t" :db/id #edb/ref 17592186442235} :answer-field/id #uuid "f5a72b7a-4d2b-5cb1-bfa9-dcf075591732" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442248}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6653118e-2998-5812-b728-f3217528d405" :question/math-academy-id "q-126746" :question/problem "![](images/0a/0a60729b626e1e9e219a839898cacc18aa81ec2a9b1b445e7b92b721874c2550.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨3\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t⟩$ for $t\\in [0,2\\pi ].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation." :question/worked-solution "Our simple, smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-3\\operatorname{sin}⁡t,\\,3\\operatorname{cos}⁡t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}x\\,dy & ={\\int }_{0}^{2\\pi }3\\operatorname{cos}⁡t\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }9{cos}^{2}⁡t\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186511584 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65573630-2003-5f37-a3a0-d25c98f4401a" :answer/type {:db/ident :answer.type/math} :answer/value "3(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)(\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)" :db/id #edb/ref 17592186510996} {:answer/id #uuid "6e780ffa-2a00-5af3-b5f3-92f795812999" :answer/type {:db/ident :answer.type/math} :answer/value "3(3\\operatorname{cos}⁡t+\\operatorname{cos}⁡3t)(\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)" :db/id #edb/ref 17592186511012} {:answer/id #uuid "9dbf5317-be7f-5ed0-a334-2b540864d0af" :answer/type {:db/ident :answer.type/math} :answer/value "3(\\operatorname{sin}⁡t-\\operatorname{sin}⁡3t)(3\\operatorname{sin}⁡t-3\\operatorname{sin}⁡3t)" :db/id #edb/ref 17592186511112} {:answer/id #uuid "a5484851-2c51-5273-8db2-309d04de9b82" :answer/type {:db/ident :answer.type/math} :answer/value "-3(\\operatorname{sin}⁡t+\\operatorname{sin}⁡3t)(3\\operatorname{sin}⁡t-3\\operatorname{sin}⁡3t)" :db/id #edb/ref 17592186511130} {:answer/id #uuid "d89e0626-3b35-5c77-81ab-f0b1350e2a80" :answer/type {:db/ident :answer.type/math} :answer/value "-3(\\operatorname{sin}⁡t-\\operatorname{sin}⁡3t)(3\\operatorname{sin}⁡t-3\\operatorname{sin}⁡3t)" :db/id #edb/ref 17592186511226}] :answer-field/correct {:answer/id #uuid "65573630-2003-5f37-a3a0-d25c98f4401a" :answer/type {:db/ident :answer.type/math} :answer/value "3(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)(\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)" :db/id #edb/ref 17592186510996} :answer-field/id #uuid "a2eb735b-b5bd-5b47-b78f-f9e6cc0794cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186511400}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fdacb1ae-ddf6-5106-9485-7c1e14bd18a9" :question/math-academy-id "q-42297" :question/problem "![](images/35/35b8ad6fd40daf95ba4f77288321d6a570e2df2944d056b9445e9ba4e36f97b7.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨3\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t,\\,3\\operatorname{sin}⁡t-\\operatorname{sin}⁡3t⟩$ for $t\\in [0,2\\pi ].$ The area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the missing part of the equation." :question/worked-solution "Our simple, piecewise-smooth, closed path $C$ is positively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡3t,\\,3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡3t⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}x\\,dy & ={\\int }_{0}^{2\\pi }(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)\\cdot (3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡3t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }3(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)(\\operatorname{cos}⁡t-\\operatorname{cos}⁡3t)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522923 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34829eb7-6719-552f-8266-3bcf7f219ec0" :answer/type {:db/ident :answer.type/math} :answer/value "7 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522944} {:answer/id #uuid "8bea5321-bfba-5f11-882e-597a3ae32f10" :answer/type {:db/ident :answer.type/math} :answer/value "- 49 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522975} {:answer/id #uuid "957ec940-be00-564b-84f4-3a10e064bebc" :answer/type {:db/ident :answer.type/math} :answer/value "49 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522979} {:answer/id #uuid "baab0cd4-8a65-55f8-bca2-1b1c2c758696" :answer/type {:db/ident :answer.type/math} :answer/value "49 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522989} {:answer/id #uuid "ca345e82-08eb-5f23-8234-ec70304b7331" :answer/type {:db/ident :answer.type/math} :answer/value "98 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522997}] :answer-field/correct {:answer/id #uuid "baab0cd4-8a65-55f8-bca2-1b1c2c758696" :answer/type {:db/ident :answer.type/math} :answer/value "49 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522989} :answer-field/id #uuid "b6fa5255-2305-5def-8b7b-fbdb0735307d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522988}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0345c7e2-c321-58ac-aefe-5fccd5158803" :question/problem "![](images/19/19689860cee70dfdb45a3d2f6708bcdab42b82b3ea20ea352ee0b2060fe7be13.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨7\\sin(t),\\,7\\cos(t)⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D)&=\\iint_D\\mathrm{d}A\\\\&=\\iint_D(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\mathrm{d}A\\\\&=-\\oint_C(P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y)\\end{aligned}\n$$\n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-\\oint_C(P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y)=\\oint_Cy\\,\\mathrm{d}x.\n$$\n\nThe derivative of $r(t)$ is\n\n$$\nr'(t)=⟨7\\cos(t),\\,-7\\sin(t)⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}\\oint_Cy\\,\\mathrm{d}x&=\\int_{0}^{2 \\pi}7\\cos(t)\\cdot 7\\cos(t)\\,\\mathrm{d}t\\\\&=\\int_{0}^{2 \\pi}49\\cos^{2}(t)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522925 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a7ae7de-4b39-5199-a3af-3688452d8e8e" :answer/type {:db/ident :answer.type/math} :answer/value "12 e^{\\sin{\\left(t \\right)}} e^{\\cos{\\left(t \\right)}}" :db/id #edb/ref 17592186522936} {:answer/id #uuid "3ff9f6b2-7616-54e5-a633-bdcd628c3b44" :answer/type {:db/ident :answer.type/math} :answer/value "24 e^{\\sin{\\left(t \\right)}} e^{\\cos{\\left(t \\right)}} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522947} {:answer/id #uuid "50df1486-59c2-558a-9e12-a5e77bcb6b42" :answer/type {:db/ident :answer.type/math} :answer/value "6 e^{\\sin{\\left(t \\right)}} e^{\\cos{\\left(t \\right)}} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522952} {:answer/id #uuid "94b9da8f-4636-51b4-a729-7c089c8b493f" :answer/type {:db/ident :answer.type/math} :answer/value "- 12 e^{\\sin{\\left(t \\right)}} e^{\\cos{\\left(t \\right)}} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522978} {:answer/id #uuid "e7b0af74-9ede-5f11-9941-9a3c114b4dbe" :answer/type {:db/ident :answer.type/math} :answer/value "12 e^{\\sin{\\left(t \\right)}} e^{\\cos{\\left(t \\right)}} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186523004}] :answer-field/correct {:answer/id #uuid "e7b0af74-9ede-5f11-9941-9a3c114b4dbe" :answer/type {:db/ident :answer.type/math} :answer/value "12 e^{\\sin{\\left(t \\right)}} e^{\\cos{\\left(t \\right)}} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186523004} :answer-field/id #uuid "158cdc91-dce0-52b4-a1a1-b986b80318b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522933}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "04fa4661-86e7-5801-8b1a-25ba13abd1bf" :question/problem "![](images/e0/e0ac24d590f74a62bd45885b90190b82018372fd086d8cdda6ee8fde115d6fdd.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨6{e}^{\\sin(t)},\\,2{e}^{\\cos(t)}⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨6\\cos(t)\\,{e}^{\\sin(t)},\\,-2\\sin(t)\\,{e}^{\\cos(t)}⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={\\int }_{0}^{2\\pi }2{e}^{\\cos(t)}\\cdot 6\\cos(t)\\,{e}^{\\sin(t)}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }12\\cos(t)\\,{e}^{\\cos(t)+\\sin(t)}\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522926 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f22653-76d9-5256-9778-31f07dcd3d94" :answer/type {:db/ident :answer.type/math} :answer/value "144 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522924} {:answer/id #uuid "5c552cc3-2adb-520e-a6b3-039e7ed2d9d5" :answer/type {:db/ident :answer.type/math} :answer/value "144 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522958} {:answer/id #uuid "ab669a85-8fb2-5f65-82b9-02c289003c38" :answer/type {:db/ident :answer.type/math} :answer/value "- 144 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522986} {:answer/id #uuid "b430d3ae-454a-5f43-ac42-5b5ac3bdd892" :answer/type {:db/ident :answer.type/math} :answer/value "288 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522987} {:answer/id #uuid "c98ef4ba-9946-5878-9a9c-87565e927c27" :answer/type {:db/ident :answer.type/math} :answer/value "12 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522996}] :answer-field/correct {:answer/id #uuid "04f22653-76d9-5256-9778-31f07dcd3d94" :answer/type {:db/ident :answer.type/math} :answer/value "144 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522924} :answer-field/id #uuid "d3d47b0d-4636-5f8a-a6bc-cc39c7cfd9c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0660c121-2d4f-5acb-9dc8-3ef2b434821c" :question/problem "![](images/3f/3fc4346f3603d6d844584973c30b8ecf1e738a4d0a393ed1ab3ec62f764596cc.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨12\\sin(t),\\,12\\cos(t)⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D)&=\\iint_D\\mathrm{d}A\\\\&=\\iint_D(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\mathrm{d}A\\\\&=-\\oint_C(P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y)\\end{aligned}\n$$\n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-\\oint_C(P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y)=\\oint_Cy\\,\\mathrm{d}x.\n$$\n\nThe derivative of $r(t)$ is\n\n$$\nr'(t)=⟨12\\cos(t),\\,-12\\sin(t)⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}\\oint_Cy\\,\\mathrm{d}x&=\\int_{0}^{2 \\pi}12\\cos(t)\\cdot 12\\cos(t)\\,\\mathrm{d}t\\\\&=\\int_{0}^{2 \\pi}144\\cos^{2}(t)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522927 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "452acad0-00a0-5eec-ab27-f71c61d53934" :answer/type {:db/ident :answer.type/math} :answer/value "- 12 \\sin{\\left(t \\right)} \\sin{\\left(2 t \\right)}" :db/id #edb/ref 17592186522948} {:answer/id #uuid "58d221ae-abe3-5f2b-be11-4806b917be10" :answer/type {:db/ident :answer.type/math} :answer/value "- 48 \\sin{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186522955} {:answer/id #uuid "d51db3ba-41c7-5f75-9e3b-5a6f7020c0d5" :answer/type {:db/ident :answer.type/math} :answer/value "24 \\sin{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186523001} {:answer/id #uuid "ec1b872d-a88f-56e4-b708-d873c11f1437" :answer/type {:db/ident :answer.type/math} :answer/value "- 24 \\sin{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186523006} {:answer/id #uuid "f861190f-37e1-526c-9a49-e7857165cb5b" :answer/type {:db/ident :answer.type/math} :answer/value "- 12 \\sin{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186523011}] :answer-field/correct {:answer/id #uuid "ec1b872d-a88f-56e4-b708-d873c11f1437" :answer/type {:db/ident :answer.type/math} :answer/value "- 24 \\sin{\\left(t \\right)} \\cos{\\left(2 t \\right)}" :db/id #edb/ref 17592186523006} :answer-field/id #uuid "eeb87e21-a6e7-5c99-aa1e-16ae42bb31df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186523008}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "09703150-b035-52b8-8944-6a1032133d7c" :question/problem "![](images/70/70ef514109413878d6cafb2931b51ee1d1b48eca053d4c085f0ebe5e8170aa3e.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨2\\sin(t),\\,6\\sin(2t)⟩$ for $t\\in [0,\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=0$ and $Q(x,y)=x.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1-0=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=0$ and $Q(x,y)=x,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}-x\\,\\text{d}y.\n$$\n\n \n\nThe derivative of $r(t)$ is\n\n$$\n{r}^{′}(t)=⟨2\\cos(t),\\,12\\cos(2t)⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}-x\\,\\text{d}y & ={\\int }_{0}^{\\pi }(-2\\sin(t))\\cdot 12\\cos(2t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }-24\\sin(t)\\cos(2t)\\,dt.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522929 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7db07e3e-e784-5b35-a356-4a4537d062e2" :answer/type {:db/ident :answer.type/math} :answer/value "289 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522970} {:answer/id #uuid "8875295e-d211-5655-878b-0554596effa6" :answer/type {:db/ident :answer.type/math} :answer/value "289 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522974} {:answer/id #uuid "c2294f11-cbe4-5e90-9777-f9d314d87386" :answer/type {:db/ident :answer.type/math} :answer/value "578 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522992} {:answer/id #uuid "cbffd80c-3d58-5535-8f68-6b9a9f1c6680" :answer/type {:db/ident :answer.type/math} :answer/value "- 289 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522998} {:answer/id #uuid "de26c772-44c2-5b76-beab-921c0a0eb471" :answer/type {:db/ident :answer.type/math} :answer/value "17 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186523002}] :answer-field/correct {:answer/id #uuid "7db07e3e-e784-5b35-a356-4a4537d062e2" :answer/type {:db/ident :answer.type/math} :answer/value "289 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522970} :answer-field/id #uuid "82e2f91c-6e8b-527d-ae2d-a1c9f664fe33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522972}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e3b6a7f-6f14-5ef7-8ca4-30557ca71485" :question/problem "![](images/10/10458df45838335a3856d9758930925eea52ed6a59fb5791edab3cccff6c3e2d.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨17\\sin(t),\\,17\\cos(t)⟩$ for $t\\in [0,2\\pi ].$ \nThe area of $D$ can be written as\n\n$$\n\\text{Area}(D)={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})dA={\\int }_{0}^{2\\pi }\\boxed{}\\,dt,\n$$\n\nwhere $P(x,y)=-y$ and $Q(x,y)=0.$ Determine the pointwise integrand obtained from the given $P$, $Q$, and parametrization using Green's theorem, with the sign adjusted for the orientation of $C$.\n\n*Hint: Note that $C$ is negatively oriented.*" :question/worked-solution "Our simple, smooth, closed path $C$ is negatively oriented, and  \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D)&=\\iint_D\\mathrm{d}A\\\\&=\\iint_D(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\mathrm{d}A\\\\&=-\\oint_C(P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y)\\end{aligned}\n$$\n\nNotice that we have to take the line integral with a minus sign since the path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-\\oint_C(P\\,\\mathrm{d}x+Q\\,\\mathrm{d}y)=\\oint_Cy\\,\\mathrm{d}x.\n$$\n\nThe derivative of $r(t)$ is\n\n$$\nr'(t)=⟨17\\cos(t),\\,-17\\sin(t)⟩.\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}\\oint_Cy\\,\\mathrm{d}x&=\\int_{0}^{2 \\pi}17\\cos(t)\\cdot 17\\cos(t)\\,\\mathrm{d}t\\\\&=\\int_{0}^{2 \\pi}289\\cos^{2}(t)\\,\\mathrm{d}t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186522930 :knowledge-point/_questions [{:knowledge-point/id #uuid "8644454b-ee25-59fd-ae65-9770a0b44442" :knowledge-point/title "Expressing the Area Bounded by a Closed Curve Using Green’s Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b85814f-cef1-50ce-a0c2-e193caf5926b" :answer/type {:db/ident :answer.type/math} :answer/value "48 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522940} {:answer/id #uuid "4de1dc13-89bc-5d8f-ac26-038f1d188087" :answer/type {:db/ident :answer.type/math} :answer/value "- 24 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522951} {:answer/id #uuid "7763e82b-d4bc-51ac-a9b0-38a352a32d73" :answer/type {:db/ident :answer.type/math} :answer/value "24 \\sin{\\left(t \\right)} \\cos{\\left(t \\right)}" :db/id #edb/ref 17592186522968} {:answer/id #uuid "a8b48ef2-128e-5882-aeb3-90e0fe45e532" :answer/type {:db/ident :answer.type/math} :answer/value "12 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522985} {:answer/id #uuid "bed32c84-b998-5ffc-b9fc-2d52cb2fca72" :answer/type {:db/ident :answer.type/math} :answer/value "24 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522990}] :answer-field/correct {:answer/id #uuid "bed32c84-b998-5ffc-b9fc-2d52cb2fca72" :answer/type {:db/ident :answer.type/math} :answer/value "24 \\cos^{2}{\\left(t \\right)}" :db/id #edb/ref 17592186522990} :answer-field/id #uuid "cefab37e-fc9a-5602-b089-f4a73bceb50a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186522999}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "122914c3-d4ec-5c1f-8cab-a9260c5fdc07" :question/problem "![](images/ef/efb35e6552df72236d914018d36b1e582611a91de649cbe69c182b0469e5c15d.png)\n\nLet $D$ be the region enclosed by the curve $C$ parametrized as\n$r(t)=⟨2\\c