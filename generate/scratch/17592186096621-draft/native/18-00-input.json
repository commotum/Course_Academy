              {
                ":answer/id": "4a4547c8-1f6a-58f9-b7f4-708fd316d7ed",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\frac{\\sin x-x\\cos x}{\\sin ^{2}x}"
              }
