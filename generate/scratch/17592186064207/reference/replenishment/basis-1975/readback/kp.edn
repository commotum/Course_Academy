\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"} {:db/id #edb/ref 17592186491394 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b8025c0-ef83-5f75-a0d8-f8420d212fbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491386} {:answer/id #uuid "428fec14-68ab-5876-8d9c-23483fdd9509" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491387} {:answer/id #uuid "4fffa791-60c2-5dc3-b7e2-54d770087587" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491389} {:answer/id #uuid "938dd7b6-6b46-5343-bfa2-fcbfd6a86831" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491399} {:answer/id #uuid "b08d9aca-d6ca-58d6-8855-ca54e1bf14cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491400}] :answer-field/correct {:answer/id #uuid "3b8025c0-ef83-5f75-a0d8-f8420d212fbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)" :db/id #edb/ref 17592186491386} :answer-field/id #uuid "0efe3063-4e18-5d21-9ae8-4bb41f3b6a1a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491381}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71f9aed2-ae1d-5853-b1d1-1e76be4a49fc" :question/problem "Calculate $\\int \\frac{5}{3x+6}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+6.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{5}{3x+6}\\,\\text{d}x & =5\\int \\frac{1}{3x+6}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{u}\\cdot (\\frac{1}{3})\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{5}{3}\\operatorname{ln}⁡|3x+6|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{5}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\operatorname{ln}⁡|3x+6|+C & =\\frac{5}{3}\\operatorname{ln}⁡|3x+6|+\\frac{5}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{5}{3}(\\operatorname{ln}⁡|3x+6|+\\operatorname{ln}⁡K) \\\\  & =\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{5}{3x+6}\\,\\text{d}x=\\frac{5}{3}\\operatorname{ln}⁡(K|3x+6|).\n$$"} {:db/id #edb/ref 17592186491396 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36df3f42-9acc-59cd-9e5b-d067fde6233e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491384} {:answer/id #uuid "84692a86-4be4-5c48-a755-005930c3b402" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491397} {:answer/id #uuid "c68d87e6-c50a-56a4-a9a2-6b416918908b" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491401} {:answer/id #uuid "f10479be-37f6-55c9-9c2d-8dbee457b99a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491405} {:answer/id #uuid "fd7dcafd-2ed2-5588-8f0c-3f475682d35d" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491406}] :answer-field/correct {:answer/id #uuid "84692a86-4be4-5c48-a755-005930c3b402" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)" :db/id #edb/ref 17592186491397} :answer-field/id #uuid "cce4b3ec-222e-51ba-8ae8-114a9fa9d3d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b296cf1-22cc-51dc-9bbc-7095846c4fed" :question/problem "Calculate $\\int \\frac{1}{3-4x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3-4x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,\\text{d}x=-\\frac{1}{4}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3-4x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{4})\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡|3-4x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{4}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{4}\\operatorname{ln}⁡|3-4x|+C & =-\\frac{1}{4}\\operatorname{ln}⁡|3-4x|-\\frac{1}{4}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{4}(\\operatorname{ln}⁡|3-4x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3-4x}\\text{d}x=-\\frac{1}{4}\\operatorname{ln}⁡(K|3-4x|).\n$$"} {:db/id #edb/ref 17592186491403 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e90047e-f55c-52b5-b46c-93db0257557e" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491379} {:answer/id #uuid "13d0d069-d025-565b-a9ec-455ab0bce8a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡(\\frac{K}{|5-5x|})" :db/id #edb/ref 17592186491382} {:answer/id #uuid "3b32f0fe-afd1-5f2f-bd1e-9943f2d38376" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491385} {:answer/id #uuid "521d6737-f622-5a95-8205-2c2c5f2e0873" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{10}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491390} {:answer/id #uuid "604a9ab2-ffa7-55cc-8e05-8521cfeb2098" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491393}] :answer-field/correct {:answer/id #uuid "3b32f0fe-afd1-5f2f-bd1e-9943f2d38376" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)" :db/id #edb/ref 17592186491385} :answer-field/id #uuid "4b8ae8f2-247f-5d06-abb6-af657a1cd8b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d9f41743-b83b-587e-a674-fcd409f35761" :question/problem "Calculate $\\int \\frac{6}{5-5x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{6}{5-5x}\\,\\text{d}x & =6\\int \\frac{1}{5-5x}\\,\\text{d}x \\\\  & =6\\int \\frac{1}{u}\\cdot (-\\frac{1}{5})\\,\\text{d}u \\\\  & =-\\frac{6}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{6}{5}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|+C & =-\\frac{6}{5}\\operatorname{ln}⁡|5-5x|-\\frac{6}{5}\\operatorname{ln}⁡K \\\\  & =-\\frac{6}{5}(\\operatorname{ln}⁡|5-5x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{6}{5-5x}\\,\\text{d}x=-\\frac{6}{5}\\operatorname{ln}⁡(K|5-5x|).\n$$"} {:db/id #edb/ref 17592186491404 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed309e1-7fed-5611-88ea-d3f7f560e643" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491380} {:answer/id #uuid "2d5ba678-fb47-535d-94c1-f60655b4d9d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491383} {:answer/id #uuid "593e3a6a-f60c-5f0d-9379-e7310c6ecf8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{|6x+2|}{K})" :db/id #edb/ref 17592186491391} {:answer/id #uuid "5e575092-4b7d-5a7a-b65e-eccaca74bbfe" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491392} {:answer/id #uuid "792e0c84-eee3-5f47-9343-9bd165f08572" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{K}{6}\\operatorname{ln}⁡(|6x+2|)" :db/id #edb/ref 17592186491395}] :answer-field/correct {:answer/id #uuid "2d5ba678-fb47-535d-94c1-f60655b4d9d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)" :db/id #edb/ref 17592186491383} :answer-field/id #uuid "85668fa6-214c-50d9-8486-30cba7ace9ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186491398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5cc660e-d261-5bf0-a86d-22509ddcb061" :question/problem "Calculate $\\int \\frac{1}{6x+2}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=6x+2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{6x+2}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{6}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+C & =\\frac{1}{6}\\operatorname{ln}⁡|6x+2|+\\frac{1}{6}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{6}(\\operatorname{ln}⁡|6x+2|+\\operatorname{ln}⁡K) \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{6x+2}\\,\\text{d}x=\\frac{1}{6}\\operatorname{ln}⁡(K|6x+2|).\n$$"}] :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}]}
