5x+3|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{4}{5x+3}\\,\\text{d}x=\\frac{4}{5}\\operatorname{ln}⁡(K|5x+3|).\n$$"} {:db/id #edb/ref 17592186247368 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e50d846-83a5-5557-b9e0-c9e2e33fd996" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}\\operatorname{ln}⁡(\\frac{K}{|1-4x|})" :db/id #edb/ref 17592186244441} {:answer/id #uuid "1428e0b7-63ba-5557-869c-56f13d16708d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|)" :db/id #edb/ref 17592186244497} {:answer/id #uuid "4334ec37-8c2c-5bce-81ac-1e3f32ee7308" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|)" :db/id #edb/ref 17592186244899} {:answer/id #uuid "e4105cc0-2a87-5eb9-ae7d-408d018e5dd3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{8}\\operatorname{ln}⁡(K|1-4x|)" :db/id #edb/ref 17592186246339} {:answer/id #uuid "f14b9abf-c38d-55cc-88dc-38e6be4d4f50" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|1-4x|)" :db/id #edb/ref 17592186246442}] :answer-field/correct {:answer/id #uuid "1428e0b7-63ba-5557-869c-56f13d16708d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|)" :db/id #edb/ref 17592186244497} :answer-field/id #uuid "5750cd9b-5594-5626-a23b-cee55a8860d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55bd9be4-7ed0-5405-bc5b-6c0d4ac3a0a2" :question/math-academy-id "q-113538" :question/problem "Calculate $\\int \\frac{3}{1-4x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=1-4x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,\\text{d}x=-\\frac{1}{4}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{1-4x}\\,\\text{d}x & =3\\int \\frac{1}{1-4x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{u}\\cdot (-\\frac{1}{4})\\,\\text{d}u \\\\  & =-\\frac{3}{4}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{3}{4}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{3}{4}\\operatorname{ln}⁡|1-4x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{3}{4}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{3}{4}\\operatorname{ln}⁡|1-4x|+C & =-\\frac{3}{4}\\operatorname{ln}⁡|1-4x|-\\frac{3}{4}\\operatorname{ln}⁡K \\\\  & =-\\frac{3}{4}(\\operatorname{ln}⁡|1-4x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{3}{1-4x}\\,\\text{d}x=-\\frac{3}{4}\\operatorname{ln}⁡(K|1-4x|).\n$$"} {:db/id #edb/ref 17592186297286 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dbf09c3-18df-50a3-84f7-e6f47d2ef7a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295347} {:answer/id #uuid "6e3b22d0-1d8f-5569-b6bf-7b7599fb5580" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295876} {:answer/id #uuid "962c31da-ae4b-5022-8358-