34 17592186045443 true] [17592186559989 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559989 1083 #uuid "0b5106df-61b9-5b24-863c-2ae5e567f591" 13194139536034 17592186045443 true] [17592186559990 1080 "-8" 13194139536034 17592186045443 true] [17592186559990 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559990 1083 #uuid "0c882a41-9fb5-5aa6-bfe4-ddedb1e09450" 13194139536034 17592186045443 true] [17592186559991 1080 "4 \\pi" 13194139536034 17592186045443 true] [17592186559991 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559991 1083 #uuid "0cc3cc91-3f29-59d8-80b6-0509e2fa9b0c" 13194139536034 17592186045443 true] [17592186559992 1075 #edb/ref 17592186559996 13194139536034 17592186045443 true] [17592186559992 1075 #edb/ref 17592186560003 13194139536034 17592186045443 true] [17592186559992 1075 #edb/ref 17592186560023 13194139536034 17592186045443 true] [17592186559992 1075 #edb/ref 17592186560036 13194139536034 17592186045443 true] [17592186559992 1075 #edb/ref 17592186560039 13194139536034 17592186045443 true] [17592186559992 1076 #edb/ref 17592186045493 13194139536034 17592186045443 true] [17592186559992 1077 "selection" 13194139536034 17592186045443 true] [17592186559992 1078 #edb/ref 17592186559996 13194139536034 17592186045443 true] [17592186559992 1079 #uuid "0d783c00-550c-539f-9270-98d59cd31448" 13194139536034 17592186045443 true] [17592186559993 1068 #edb/ref 17592186559992 13194139536034 17592186045443 true] [17592186559993 1070 #edb/ref 17592186045487 13194139536034 17592186045443 true] [17592186559993 1071 "![](images/01/013cdd1ba73ee79ef51d00b7dc9f48488cee2299eb593accadfbf026981169c0.png)\n\nEvaluate the surface integral\n\n$$\\iint_S 4 x\\,\\mathrm{d}S,$$\n\nwhere $S$ is defined by $z=- x + y$ and whose domain is the right half-circle of radius $2$ centered at $O$, as shown above. Give an exact answer." 13194139536034 17592186045443 true] [17592186559993 1072 #uuid "141fe36a-507a-57e3-9528-7652085c824c" 13194139536034 17592186045443 true] [17592186559993 1074 "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\\iint_S f(x,y,z)\\,\\mathrm{d}S=\\iint_D f(x,y,g(x,y))\\sqrt{1+\\left(\\frac{\\partial z}{\\partial x}\\right)^2+\\left(\\frac{\\partial z}{\\partial y}\\right)^2}\\,\\mathrm{d}A.$$\n\nFor the partial derivatives, we have\n\n$$\\frac{\\partial z}{\\partial x}=\\frac{\\partial}{\\partial x}(- x + y)=-1,$$\n\nand\n\n$$\\frac{\\partial z}{\\partial y}=\\frac{\\partial}{\\partial y}(- x + y)=1.$$\n\nTherefore, the surface integral can be expressed as follows:\n\n$$\n\\begin{aligned}\\iint_S{4 x}\\,\\mathrm{d}S & =\\iint_D{f(x,y,g(x,y))\\sqrt{1+\\left(\\frac{\\partial z}{\\partial x}\\right)^2+\\left(\\frac{\\partial z}{\\partial y}\\right)^2}}\\,\\mathrm{d}A \\\\ & =\\iint_D{(4 x)\\cdot\\sqrt{1+(-1)^2+(1)^2}}\\,\\mathrm{d}A \\\\ & =\\iint_D{(4 x)\\cdot\\sqrt{3}}\\,\\mathrm{d}A \\\\ & =(\\sqrt{3})\\iint_D{4 x}\\,\\mathrm{d}A.\\end{aligned}\n$$\n\nNotice that in polar coordinates $(r,\\theta),$ our domain can be expressed as\n\n$$\\Delta=\\{(r,\\theta):0\\le r\\le 2,\\ - \\frac{\\pi}{2}\\le\\theta\\le \\frac{\\pi}{2}\\}.$$\n\nTherefore, using the change of variables formula for polar coordinates, where $x=r\\cos\\theta$ and $y=r\\sin\\theta,$ we obtain\n\n$$\n\\begin{aligned}(\\sqrt{3})\\iint_D{4 x}\\,\\mathrm{d}A & =(\\sqrt{3})\\iint_\\Delta{f(r\\cos\\theta,r\\sin\\theta)\\cdot r}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\iint_\\Delta{(4(r\\cos\\theta))\\cdot r}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\iint_\\Delta{4 r^{2} \\cos{\\left(\\theta \\right)}}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{- \\frac{\\pi}{2}}^{\\frac{\\pi}{2}}{(\\cos{\\left(\\theta \\right)})\\int_{0}^{2}{4 r^{2}}\\,\\mathrm{d}r}\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{- \\frac{\\pi}{2}}^{\\frac{\\pi}{2}}{(\\cos{\\left(\\theta \\right)})\\left[\\frac{4 r^{3}}{3}\\right]_{0}^{2}}\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{- \\frac{\\pi}{2}}^{\\frac{\\pi}{2}}{(\\cos{\\left(\\theta \\right)})\\left[((\\frac{32}{3}))-((0))\\right]}\\,\\mathrm{d}\\theta \\\\ & =(\\sqrt{3})\\int_{- \\frac{\\pi}{2}}^{\\frac{\\pi}{2}}{\\frac{32 \\cos{\\left(\\theta \\right)}}{3}}\\,\\mathrm{d}\\theta \\\\ & =(\\frac{32 \\sqrt{3}}{3})\\left[\\sin{\\left(\\theta \\right)}\\right]_{- \\frac{\\pi}{2}}^{\\frac{\\pi}{2}} \\\\ & =(\\frac{32 \\sqrt{3}}{3})\\left[((1))-((-1))\\right] \\\\ & =(\\frac{32 \\sqrt{3}}{3})\\cdot((1)-(-1)) \\\\ & =\\frac{64 \\sqrt{3}}{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral is $\\frac{64 \\sqrt{3}}{3}$." 13194139536034 17592186045443 true] [17592186559994 1080 "8" 13194139536034 17592186045443 true] [17592186559994 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559994 1083 #uuid "14cdfb2d-5fc7-5150-b284-439e38260d64" 13194139536034 17592186045443 true] [17592186559995 1080 "\\pi" 13194139536034 17592186045443 true] [17592186559995 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559995 1083 #uuid "1cb0f77c-0203-5719-ab9d-91ce8ca040f7" 13194139536034 17592186045443 true] [17592186559996 1080 "\\frac{64 \\sqrt{3}}{3}" 13194139536034 17592186045443 true] [17592186559996 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559996 1083 #uuid "22f90bd6-2168-5537-aea8-850bd47c55e5" 13194139536034 17592186045443 true] [17592186559997 1080 "2" 13194139536034 17592186045443 true] [17592186559997 1082 #edb/ref 17592186045498 13194139536034 17592186045443 true] [17592186559997 1083 #uuid "2417f5d3-5389-5044-b2a0-418aeb7dac86" 13194139536034 17592186045443 true] [17592186559998 1068 #edb/ref 17592186560024 13194139536034 17592186045443 true] [17592186559998 1070 #edb/ref 17592186045487 13194139536034 17592186045443 true] [17592186559998 1071 "![](images/79/79b09a881e6809e097e982b58d81a037d162f6b5820894e17295