/id #edb/ref 17592186063036}] :answer-field/id #uuid "437de520-ea14-5a91-9db3-48216a3ed68a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063031}] :question/id #uuid "65e27d8d-ce3f-5fb9-a70c-1dd4d9ab0259" :question/math-academy-id "q-48613" :question/problem "The volume of water in a pail $t$ seconds after it starts filling with water is $V(t)$ cubic centimeters. What are the units of $\\frac{dV}{dt}$?"} {:db/id #edb/ref 17592186233124 :knowledge-point/_questions [{:knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bf27617-88ec-528e-ace5-0ea42a142d27" :question/math-academy-id "q-110040" :question/problem "A website receives $v(h)$ visits every $h$ hours. What are the units of $\\frac{\\text{d}v}{\\text{d}h}?$" :question/worked-solution "We have that the time $h$ is measured in hours and the number of visits is measured in visitors. \n\n$$\n\\begin{aligned}h: & \\text{hours} \\\\ v(h): & \\text{visitors}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}v}{\\text{d}h}$ measures a change in $v$ over a change in $h.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}h}: & \\frac{\\text{visitors}}{\\text{hours}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}v}{\\text{d}h}$ is measured in \"visitors per hour \"."} {:db/id #edb/ref 17592186234316 :knowledge-point/_questions [{:knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e20bdb49-6bfd-500e-8f84-fa81ea81c70a" :question/math-academy-id "q-72091" :question/problem "A student's parents promise to reward her $R(p)$ dollars if she obtains an average of $p$ points in her exams. What are the units of $\\frac{\\text{d}R}{\\text{d}p}?$" :question/worked-solution "We have that the student's reward $R(p)$ is measured in dollars and the average exam result is measured in points. \n\n$$\n\\begin{aligned}R(p): & \\text{dollars} \\\\ p: & \\text{points}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}R}{\\text{d}p}$ measures a change in $R(p)$ over a change in $p.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}R}{\\text{d}p}: & \\frac{\\text{dollars}}{\\text{points}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}R}{\\text{d}p}$ is measured in \"dollars per point\"."} {:db/id #edb/ref 17592186247072 :knowledge-point/_questions [{:knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1432e650-2a84-5de8-9f60-1d496025ae15" :answer/type {:db/ident :answer.type/text} :answer/value "squared kilograms per cupcake" :db/id #edb/ref 17592186244499} {:answer/id #uuid "230632ba-b376-58f5-b0ba-12899458008e" :answer/type {:db/ident :answer.type/text} :answer/value "cupcakes per kilogram" :db/id #edb/ref 17592186244622} {:answer/id #uuid "9d0e3fc8-6ea7-54d4-b5a5-cd0ff85c5eb4" :answer/type {:db/ident :answer.type/text} :answer/value "kilograms per cupcake" :db/id #edb/ref 17592186245710} {:answer/id #uuid "9d75aea8-62f4-5f4d-aeb3-1c234eacd0b0" :answer/type {:db/ident :answer.type/text} :answer/value "grams per cupcake" :db/id #edb/ref 17592186245715} {:answer/id #uuid "bb7ffb51-25e8-521e-8889-98bb404c734a" :answer/type {:db/ident :answer.type/text} :answer/value "cupcakes per gram" :db/id #edb/ref 17592186245986}] :answer-field/correct {:answer/id #uuid "9d75aea8-62f4-5f4d-aeb3-1c234eacd0b0" :answer/type {:db/ident :answer.type/text} :answer/value "grams per cupcake" :db/id #edb/ref 17592186245715} :answer-field/id #uuid "3647db23-f4d0-57