{bmatrix}\\cdot \\begin{bmatrix}2 & -4 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-24 & 48 & -60\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186299815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e9a8c05-e895-5db2-be21-7ff8a989939a" :answer/type {:db/ident :answer.type/math} :answer/value "-58" :db/id 17592186298101}] :answer-field/correct {:answer/id #uuid "7e9a8c05-e895-5db2-be21-7ff8a989939a" :answer/type {:db/ident :answer.type/math} :answer/value "-58" :db/id 17592186298101} :answer-field/id #uuid "298a71ad-58e1-55a8-a4ab-0720f04e5f75" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186298777} {:answer-field/choices [{:answer/id #uuid "5f7e0eae-c541-5188-8a63-03a909e42ee0" :answer/type {:db/ident :answer.type/math} :answer/value "136" :db/id 17592186297954}] :answer-field/correct {:answer/id #uuid "5f7e0eae-c541-5188-8a63-03a909e42ee0" :answer/type {:db/ident :answer.type/math} :answer/value "136" :db/id 17592186297954} :answer-field/id #uuid "a531995d-b29d-5426-9f4b-9a89a67a333f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186299192}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7d60a4e0-4fdb-56f1-b62d-65e7bbd5fd84" :question/math-academy-id "q-320026" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}-4 & 6\\end{bmatrix},\\,B=\\begin{bmatrix}2 & -1 \\\\ 3 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}1 & 0 \\\\ -2 & 4\\end{bmatrix}.\n$$\n\n| $ABC=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}-4 & 6\\end{bmatrix}\\cdot \\begin{bmatrix}2 & -1 \\\\ 3 & 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}10 & 34\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}10 & 34\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 0 \\\\ -2 & 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}-58 & 136\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186326920 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0768e386-ed42-523a-8b81-d32778b33888" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & 18 & 9 \\\\ 21 & 7 & -42 \\\\ 8 & 2 & -6\\end{bmatrix}" :db/id 17592186324039} {:answer/id #uuid "5765f40b-6dcf-5301-9949-f4819aec1ba2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 \\\\ 42 \\\\ 9\\end{bmatrix}" :db/id 17592186324697} {:answer/id #uuid "8bca11ec-165a-537d-b134-38df44b671e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21 & 0 & 0 \\\\ 18 & 9 & -42 \\\\ 4 & 0 & -8\\end{bmatrix}" :db/id 17592186325158} {:answer/id #uuid "a36dc3f4-9f65-59e6-9311-6f889cfc4cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}" :db/id 17592186325358} {:answer/id #uuid "f31eb4fa-cff2-5b17-9422-8db3c6117a17" :answer/type {:db/ident :answer.type/math} :answer/value "-144" :db/id 17592186326112}] :answer-field/correct {:answer/id #uuid "a36dc3f4-9f65-59e6-9311-6f889cfc4cbd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}" :db/id 17592186325358} :answer-field/id #uuid "b79923e4-1da4-5e24-8a5e-c420b9db32e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186326548}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0594dca0-de16-5429-abef-c4b9b45aec7e" :question/math-academy-id "q-42001" :question/problem "Calculate $ABC$, where\n\n$$\nA=\\begin{bmatrix}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\,C=\\begin{bmatrix}-2 & 0 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 1$ matrix, and $C$ is a $1\\times 3$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 1$ matrix, which will require finding $3$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 3$ matrix, which will require finding $6$ entries.\n\nSo, we find the product $AB$ first:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 & -2 \\\\ -1 & 5 \\\\ 0 & 1\\end{bmatrix}\\cdot \\begin{bmatrix}1 \\\\ -4\\end{bmatrix} \\\\  & =\\begin{bmatrix}9 \\\\ -21 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =\\begin{bmatrix}9 \\\\ -21 \\\\ -4\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 0 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-18 & 0 & 9 \\\\ 42 & 0 & -21 \\\\ 8 & 0 & -4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id 17592186326921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d6f5d49-745b-5ede-bd5a-5fba9ad228e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-12 \\\\ 24 \\\\ 36\\end{bmatrix}" :db/id 17592186324875} {:answer/id #uuid "80a1cf50-d570-5721-9f08-cde570f35644" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-18 \\\\ 30 \\\\ 36\\end{bmatrix}" :db/id 17592186325047} {:answer/id #uuid "80e94439-3053-5945-8cd8-c5472e86cc65" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 30 & 24\\end{bmatrix}" :db/id 17592186325049} {:answer/id #uuid "831a2a1f-be35-584b-82e9-94e6bad8d512" :answer/ty