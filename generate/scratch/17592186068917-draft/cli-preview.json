      ":question/id": "514c29be-4f9d-56ca-a320-16b8a22b42f2",
      ":question/problem": "Evaluate the following integral. Give an exact answer.\n\n$\\int_{0}^{\\frac{\\sqrt{15} \\sqrt{\\pi}}{15}} 9 x \\tan{\\left(5 x^{2} \\right)} \\sec{\\left(5 x^{2} \\right)}\\,\\text{d}x=$\n{{field-1}}",
      ":question/answer-fields": [
        {
          ":answer-field/id": "f35cd38e-e597-50da-97cd-eeb4364c465d",
          ":answer-field/key": "field-1",
          ":answer-field/type": ":answer-field.type/blank",
