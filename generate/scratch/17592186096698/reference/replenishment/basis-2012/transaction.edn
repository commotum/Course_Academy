{3}}{3}\\right)+C \\\\ y & =\\frac{3 \\left(x - 2\\right)^{3}}{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](images/12/1235c9c0d6913436949a82342c89149bcd494498e6bbfd10c69aecb6b471c5c6.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["fc165c51-9611-50a2-b0e8-171538697c81"] :db/ensure :question/validate} {:db/id "335f78e7-e2ea-5a9b-a298-f76a48628524" :answer/id #uuid "335f78e7-e2ea-5a9b-a298-f76a48628524" :answer/type :answer.type/image :answer/value "images/a8/a8a38d8facf47ef51c0be050d7455b711cdc2ffe9f70982b811beca4f6eb6efc.png" :db/ensure :answer/validate} {:db/id "a1303f0d-df89-544c-b68d-5bc8dc219b34" :answer/id #uuid "a1303f0d-df89-544c-b68d-5bc8dc219b34" :answer/type :answer.type/image :answer/value "images/38/389ab31fd9cc675e64aecdfb60efa0a8adb524e9339f099a4c6f7f10382d686d.png" :db/ensure :answer/validate} {:db/id "9d258c64-fd79-52f8-a367-e6841bdd1de5" :answer/id #uuid "9d258c64-fd79-52f8-a367-e6841bdd1de5" :answer/type :answer.type/image :answer/value "images/82/82caab06e81f5d84b3a2d90c3424c38e60697d42cf8883dc366982afb06456e2.png" :db/ensure :answer/validate} {:db/id "3a47b506-3357-5439-a759-2bff00517d37" :answer/id #uuid "3a47b506-3357-5439-a759-2bff00517d37" :answer/type :answer.type/image :answer/value "images/6e/6edc37526f2955eb61e17377e014019d29bed65e47fd9ba59f9a5afc69bc7640.png" :db/ensure :answer/validate} {:db/id "cad6d72d-23a4-5418-9ece-7d5d5e47991f" :answer/id #uuid "cad6d72d-23a4-5418-9ece-7d5d5e47991f" :answer/type :answer.type/image :answer/value "images/b1/b1d00ae4be0bdd48d9c8842419eb93ce4235b220fccd4162e471d08579a0adb6.png" :db/ensure :answer/validate} {:db/id "26fb1d4f-55f0-5b2d-870e-c89f1b155e39" :answer-field/id #uuid "26fb1d4f-55f0-5b2d-870e-c89f1b155e39" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["335f78e7-e2ea-5a9b-a298-f76a48628524" "a130