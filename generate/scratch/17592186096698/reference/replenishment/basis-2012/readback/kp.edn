dent :answer.type/image} :answer/value "images/5c/5c933988eb335b7310387cfc532a6e144de3e43bfebde4c29d1e5fe76fa35027.png" :db/id #edb/ref 17592186330031} {:answer/id #uuid "7df61f71-c57b-5b3a-bb1e-71c5faddfe2f" :answer/type {:db/ident :answer.type/image} :answer/value "images/4a/4a2aefaff6332175608a37f6532bafd5be4ccb60a2aad8e4400a0f5767c4588a.png" :db/id #edb/ref 17592186331057} {:answer/id #uuid "ae78f203-25a9-5c21-a930-c1db83c7064a" :answer/type {:db/ident :answer.type/image} :answer/value "images/aa/aae99f368b61351b9163646b70ea0b085019d6935334422ccb398958a81d1e47.png" :db/id #edb/ref 17592186331492} {:answer/id #uuid "d249f656-2f38-5318-b289-f42310bd1132" :answer/type {:db/ident :answer.type/image} :answer/value "images/76/763db9d469cdd9047ec823966fc922726c97cb22e6cd848a432f26bc5e6529d6.png" :db/id #edb/ref 17592186331816} {:answer/id #uuid "f90cf1a3-9d3e-5917-a76d-9ba382f31925" :answer/type {:db/ident :answer.type/image} :answer/value "images/89/8910d0342d03d546117091ccd19378905b8cfc3644997cfe3ca7d95a3b4e7a6f.png" :db/id #edb/ref 17592186332139}] :answer-field/correct {:answer/id #uuid "097973d9-9ded-556a-9845-2e01f4285582" :answer/type {:db/ident :answer.type/image} :answer/value "images/5c/5c933988eb335b7310387cfc532a6e144de3e43bfebde4c29d1e5fe76fa35027.png" :db/id #edb/ref 17592186330031} :answer-field/id #uuid "b60cced6-9db4-5c73-bcb1-9ed58f36cdd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70caacc2-c352-5e5b-80a4-9b13475ccda0" :question/math-academy-id "q-49947" :question/problem "Which of the following shows some of the solution curves of the differential equation $x\\cdot \\frac{\\text{d}y}{\\text{d}x}=1$ for $x>0?$" :question/worked-solution "Rearranging and Integrating the equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{x} \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ y & =\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x|+C \\\\  & =\\operatorname{ln}⁡x+C,\\,x>0.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,2.$\n\n![](images/8e/8e047c3c27a000af943f50499f8c7559acceeb78cc006e796c7d353729991517.png)"} {:db/id #edb/ref 17592186332808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a36ddfca-2b14-509d-b5d4-e1b9e7e3d77a" :answer/type {:db/ident :answer.type/image} :answer/value "images/36/3670e1b40ce25af5974059a86c502cfb68f80e81746cbb162805ab7ae4a6bce2.png" :db/id #edb/ref 17592186331414} {:answer/id #uuid "cb41bf96-b7f8-5841-b2a3-e61783f9e2c2" :answer/type {:db/ident :answer.type/image} :answer/value "images/1c/1cf05351f0353e95dbdff8f620f6e920650d505be88edb3e61486676cb59357c.png" :db/id #edb/ref 17592186331752} {:answer/id #uuid "d493a642-0802-5e9f-bbcf-6f942159881d" :answer/type {:db/ident :answer.type/image} :answer/value "images/7d/7d23f940448475b1da1008ab1d3270236abec662208e81bd0de9355e85103a38.png" :db/id #edb/ref 17592186331835} {:answer/id #uuid "df729bef-a2ff-5cbe-8c4a-710c0ea5cca6" :answer/type {:db/ident :answer.type/image} :answer/value "images/90/90beec07c4d15fa823aee98c8a1a1e6c58846bb9b713b84848e010cc98cb3ca3.png" :db/id #edb/ref 17592186331922} {:answer/id #uuid "e1f097f0-5895-56e1-86a8-3d39d336d5d8" :answer/type {:db/ident :answer.type/image} :answer/value "images/18/18a0a935932bbe409ceb7e36459a2091ee46b74829c873bfc048a71f543d8eff.png" :db/id #edb/ref 17592186331948}] :answer-field/correct {:answer/id #uuid "df729bef-a2ff-5cbe-8c4a-710c0ea5cca6" :answer/type {:db/ident :answer.type/image} :answer/value "images/90/90beec07c4d15fa823aee98c8a1a1e6c58846bb9b713b84848e010cc98cb3ca3.png" :db/id #edb/ref 17592186331922} :answer-field/id #uuid "f9ca8b77-7e7d-5a41-bcb5-89f345e28085" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "33315476-f420-5411-98c9-f5414bf3df7e" :question/math-academy-id "q-50197" :question/problem "Which of the following shows some of the solution curves of the differential equation ${x}^{2}\\cdot \\frac{\\text{d}y}{\\text{d}x}+1=0$ for $x>0?$" :question/worked-solution "Rearranging and Integrating the equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{{x}^{2}} \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =-\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\ y & =-\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{x}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1$ for $x>0.$\n\n![](images/c8/c837c3b617fa49f3d081d961196a954fada99b8d7cd12b7d7f729232e16be066.png)"} {:db/id #edb/ref 17592186332809 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045fe77f-3730-5d18-925c-cda953523ffe" :answer/type {:db/ident :answer.type/image} :answer/value "images/d2/d29058f4c71941f04dd2d934f1896972f0eb41a179984ec5d3675265ee9da56c.png" :db/id #edb/ref 17592186329995} {:answer/id #uuid "105c00ce-00da-5bc3-8cf5-f61420a4738b" :answer/type {:db/ident :answer.type/image} :answer/value "images/25/25e8c2c60a948d324dc7b836815e81a0321b1353dafded0c789d53b9c73d5edc.png" :db/id #edb/ref 17592186330094} {:answer/id #uuid "618d5040-e32c-5a5e-a2bf-f639bcfc73b5" :answer/type {:db/ident :answer.type/image} :answer/value "images/5e/5e94f63a81cee566fea810265d8a37959617abaf5a8c50250c269fe44584405e.png" :db/id #edb/ref 17592186330817} {:answer/id #uuid "dd8ed54a-35d6-5d38-b1f1-c0de7905f0e1" :answer/type {:db/ident :answer.type/image} :answer/value "images/93/93c572ba14dadbcabaf218f2395d51465ceef24d1c7c4083025ea67bb36ed438.png" :db/id #edb/ref 1759