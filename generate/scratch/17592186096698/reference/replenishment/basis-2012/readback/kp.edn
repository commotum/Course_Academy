#{[{:db/id #edb/ref 17592186096698 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096498 :question/id #uuid "ab40a4d3-c418-5b64-a04c-bb017155a4d2" :question/math-academy-id "e-530" :question/problem "Solve the differential equation $y'  = 2x,$ and sketch the solution curves of this equation." :question/worked-solution "Integrating the equation, we get\n\n$$\ny = x^2+C.\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,1.$\n\n![](images/e3/e37771799ef5fadc259e6ea0073042a83e0974b5a2619d1af3e87a7467e6d780.png)"} :knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049620} {:db/id #edb/ref 17592186050294} {:db/id #edb/ref 17592186050955}] :knowledge-point/question-generator {:db/id #edb/ref 17592186496440 :question-generator/id #uuid "003dc5ed-2a5d-5d5f-b7a1-a7dcc203fda7" :question-generator/script "generate/scratch/17592186096698.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097302 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "853aeea8-65f0-5fb9-8258-80667aea2abd" :answer/type {:db/ident :answer.type/image} :answer/value "images/8b/8bd666d1415f83ff8232e39963248ef0afe62f39e66d5f3416ae18316453faa3.png" :db/id #edb/ref 17592186095737} {:answer/id #uuid "a94dc35e-7f42-58d5-bacb-d6ebe1a5ec26" :answer/type {:db/ident :answer.type/image} :answer/value "images/0a/0ab0b12088ac6816f7086e952e749ea6d4c9107cc6189ebb0efcafb904152ad0.png" :db/id #edb/ref 17592186095738} {:answer/id #uuid "efb18e51-9c8d-5683-8dc6-f9dd9a0e7082" :answer/type {:db/ident :answer.type/image} :answer/value "images/1a/1a0e6d6d025e2f8b79019036637efd78b89954d1b01b00037ece77df4c3844eb.png" :db/id #edb/ref 17592186095739} {:answer/id #uuid "fa9b1208-989e-52fe-9319-003ca0fe7916" :answer/type {:db/ident :answer.type/image} :answer/value "images/65/65ae1770ff4084d5a89fdda0f552f2a92380ae948c2b0f1ef3d3bb5d20f32713