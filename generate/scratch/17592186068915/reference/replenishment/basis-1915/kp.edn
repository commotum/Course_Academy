#{[{:db/id #edb/ref 17592186068915 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068567 :question/id #uuid "0021ae6a-8ef8-564e-9c2e-fb5f9e8f7313" :question/math-academy-id "e-464" :question/problem "Calculate the integral $\\displaystyle\\int 2 \\sin {\\left(\\dfrac x 3\\right)} \\,  \\textrm{d}x.$" :question/worked-solution "If we let $u=\\dfrac x 3,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac 1 3\\quad\\Longrightarrow\\quad \\textrm d x =3\\, \\textrm d u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2\\operatorname{sin}⁡(\\frac{x}{3})\\,\\text{d}x & =2\\int \\operatorname{sin}⁡u\\cdot 3\\,\\text{d}u \\\\  & =2\\cdot 3\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-6\\operatorname{cos}⁡u+C \\\\  & =-6\\operatorname{cos}⁡(\\frac{x}{3})+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "746d1bc6-98ec-59a1-bec6-9dcfb7081a5d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"} {:db/id #edb/ref 17592186048777 :topic/math-academy-id 285 :topic/title "Integrating Trigonometric Functions"}] :knowledge-point/questions [{:db/id #edb/ref 17592186069047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201f04d6-c002-5e0e-95fe-a7bfb6f3cd47" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266427} {:answer/id #uuid "4017a737-6567-579a-8f02-98712b431a35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266723} {:answer/id #uuid "928bb7be-da0b-5934-b68c-38f79005663e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186267450} {:answer/id #uuid "932c94aa-6652-5204-910b-18fdb3861f29" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267461} {:answer/id #uuid "99faa052-1151-586c-8bf2-0746b9af0da9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267536}] :answer-field/correct {:answer/id #uuid "4017a737-6567-579a-8f02-98712b431a35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266723} :answer-field/id #uuid "0b6fc5f0-4245-5250-93b5-36ad6b67d400" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9e8b61bc-bb4e-5bb5-ab6c-973e00e2baa2" :question/math-academy-id "q-13647" :question/problem "${\\int }_{0}^{\\pi /8}5\\operatorname{sin}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "If we let $u=4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /8$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /8}5\\operatorname{sin}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}5\\operatorname{sin}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{5}{4}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{5}{4}\\operatorname{cos}⁡u{|}_{0}^{\\pi /2} \\\\  & =-\\frac{5}{4}(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{5}{4}(0-1) \\\\  & =\\frac{5}{4}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069149 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de554e76-bfb8-5794-8ac9-2f13ece1fe32" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (5z) + C" :db/id #edb/ref 17592186066186} {:answer/id #uuid "3ad0e19c-1edb-590f-84f6-b82f05ab0eb0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{5}\\cos (5z) + C" :db/id #edb/ref 17592186066187} {:answer/id #uuid "549694b4-3d4c-5ce6-b583-5bfbafb96c9e" :answer/type