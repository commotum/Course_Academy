db/id "b5e91fc1-2ced-55cf-849f-07ffaef0ddeb" :answer/id #uuid "b5e91fc1-2ced-55cf-849f-07ffaef0ddeb" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure :answer/validate} {:db/id "77ae08f7-2b6b-5e95-8284-a321136f9e0e" :answer/id #uuid "77ae08f7-2b6b-5e95-8284-a321136f9e0e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure :answer/validate} {:db/id "4487d6e6-4e17-5c90-b1bb-1610fc9f5628" :answer-field/id #uuid "4487d6e6-4e17-5c90-b1bb-1610fc9f5628" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["19d7216e-01c1-55dc-afe1-24eba218c8fa" "d29f8cd2-dee8-59dc-a36c-2b21b5dd77d9" "e5a92fef-96fc-50b1-a22d-d70a20e3848a" "b5e91fc1-2ced-55cf-849f-07ffaef0ddeb" "77ae08f7-2b6b-5e95-8284-a321136f9e0e"] :answer-field/correct "d29f8cd2-dee8-59dc-a36c-2b21b5dd77d9" :db/ensure :answer-field/validate} {:db/id "d6b42e8b-fdca-50f0-be23-a0ae2f737155" :question/id #uuid "d6b42e8b-fdca-50f0-be23-a0ae2f737155" :question/problem "Calculate ${\\int }_{0}^{\\frac{\\pi}{27}}\\sin{\\left(9 x + \\frac{\\pi}{3} \\right)}\\,\\text{d}x.$" :question/worked-solution "If we let $u=9 x + \\frac{\\pi}{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,\\Longrightarrow\\,\\text{d}x=\\frac{1}{9}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\frac{\\pi}{27}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi}{3}$ | $\\frac{2 \\pi}{3}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{\\pi}{27}}\\sin{\\left(9 x + \\frac{\\pi}{3} \\right)}\\,\\text{d}x &= {\\int }_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}}1\\sin(u)\\cdot \\frac{1}{9}\\,\\text{d}u \\\\ &= \\frac{1}{9}{\\int }_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}}\\sin(u)\\,\\text{d}u \\\\ &= - \\frac{\\cos{\\left(u \\right)}}{9}\\big|_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}} \\\\ &= \\frac{1}{18}-(- \\frac{1}{18}) \\\\ &= \\frac{1}{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["4487d6e6-4e17-5c90-b1bb-1610fc9f5628"] :db/ensure :question/validate} {:db/id "9a46ef29-9be2-599e-9979-227efe7d3656" :answer/id #uuid "9a46ef29-9be2-599e-9979-227efe7d3656" :answer/type :answer.type/math :answer/value "\\frac{1}{2 \\pi}" :db/ensure :answer/validate} {:db/id "34cf8706-7447-5aae-95bc-1a08810cce88" :answer-field/id #uuid "34cf8706-7447-5aae-95bc-1a08810cce88" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/choices ["9a46ef29-9be2-599e-9979-227efe7d3656"] :answer-field/correct "9a46ef29-9be2-599e-9979-227efe7d3656" :db/ensure :answer-field/validate} {:db/id "b2b0e365-9687-5e65-8bbf-63ff6c2d35ea" :question/id #uuid "b2b0e365-9687-5e65-8bbf-63ff6c2d35ea" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{1}{4}}\\cos{\\left(2 \\pi x \\right)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=2 \\pi x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 \\pi\\,\\Longrightarrow\\,\\text{d}x=\\frac{1}{2 \\pi}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\frac{1}{4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi}{2}$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{1}{4}}\\cos{\\left(2 \\pi x \\right)}\\,\\text{d}x &= {\\int }_{0}^{\\frac{\\pi}{2}}1\\cos(u)\\cdot \\frac{1}{2 \\pi}\\,\\text{d}u \\\\ &= \\frac{1}{2 \\pi}{\\int }_{0}^{\\frac{\\pi}{2}}\\cos(u)\\,\\text{d}u \\\\ &= \\frac{\\sin{\\left(u \\right)}}{2 \\pi}\\big|_{0}^{\\frac{\\pi}{2}} \\\\ &= \\frac{1}{2 \\pi}-(0) \\\\ &= \\frac{1}{2 \\pi}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["34cf8706-7447-5aae-95bc-1a08810cce88"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "513f5406-21a7-5dd9-ab2a-147029c58468" :question-generator/script "generate/scratch/17592186068915