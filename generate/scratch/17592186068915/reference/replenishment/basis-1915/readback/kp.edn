#{[{:db/id #edb/ref 17592186068915 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068567 :question/id #uuid "0021ae6a-8ef8-564e-9c2e-fb5f9e8f7313" :question/math-academy-id "e-464" :question/problem "Calculate the integral $\\displaystyle\\int 2 \\sin {\\left(\\dfrac x 3\\right)} \\,  \\textrm{d}x.$" :question/worked-solution "If we let $u=\\dfrac x 3,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac 1 3\\quad\\Longrightarrow\\quad \\textrm d x =3\\, \\textrm d u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 2\\operatorname{sin}⁡(\\frac{x}{3})\\,\\text{d}x & =2\\int \\operatorname{sin}⁡u\\cdot 3\\,\\text{d}u \\\\  & =2\\cdot 3\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-6\\operatorname{cos}⁡u+C \\\\  & =-6\\operatorname{cos}⁡(\\frac{x}{3})+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "746d1bc6-98ec-59a1-bec6-9dcfb7081a5d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332 :topic/math-academy-id 1159 :topic/title "Calculating Definite Integrals Using Substitution"} {:db/id #edb/ref 17592186048777 :topic/math-academy-id 285 :topic/title "Integrating Trigonometric Functions"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186482725 :question-generator/id #uuid "513f5406-21a7-5dd9-ab2a-147029c58468" :question-generator/script "generate/scratch/17592186068915.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186069047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201f04d6-c002-5e0e-95fe-a7bfb6f3cd47" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266427} {:answer/id #uuid "4017a737-6567-579a-8f02-98712b431a35" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266723} {:answer/id #uuid "928bb7be-da0b-5934-b68c-38f79005663e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186267450} {:answer/id #