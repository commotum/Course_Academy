rrect {:answer/id #uuid "8c2ddb72-e009-5e99-a867-cfb791c5ece6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{cos}⁡(2x)+C" :db/id #edb/ref 17592186236701} :answer-field/id #uuid "7634e3a4-ccd7-565e-8a5f-dca01c9b8af9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237599}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9d8a7144-2e70-5c2c-b1c3-3e9ae0cdcfc0" :question/math-academy-id "q-10061" :question/problem "Calculate $\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "If we let $u=2x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int \\operatorname{sin}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{cos}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{cos}⁡(2x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04550c7b-0d73-5442-a8c7-725dcd4c73b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186235825} {:answer/id #uuid "15ecb00b-13f7-5f52-9f60-143f66c29fe7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186235950} {:answer/id #uuid "beed3300-67b6-5a62-834b-6d15671e04c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{cos}⁡(3-9x)+C" :db/id #edb/ref 17592186237031} {:answer/id #uuid "eeddc196-9f5f-51b9-8377-d64ab696355d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186237323} {:answer/id #uuid "fa1174cf-350f-52d8-a72f-f4777b151d43" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9}\\operatorname{cos}⁡(3-9x)+C" :db/id #edb/ref 17592186237398}] :answer-field/correct {:answer/id #uuid "15ecb00b-13f7-5f52-9f60-143f66c29fe7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186235950} :answer-field/id #uuid "bb8fc073-d58e-5e24-bfbf-924d5974b80a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237681}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7faa25b-953f-5de3-b7b5-5d74cb936a93" :question/math-academy-id "q-10064" :question/problem "Calculate $\\int \\operatorname{cos}⁡(3-9x)\\,\\text{d}x.$" :question/worked-solution "If we let $u=3-9x,$ then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-9\\,⟹\\,\\text{d}x=-\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡(3-9x)\\,\\text{d}x & =\\int \\operatorname{cos}⁡u\\cdot (-\\frac{1}{9}\\,\\text{d}u) \\\\  & =-\\frac{1}{9}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{9}\\operatorname{sin}⁡u+C \\\\  & =-\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aace116-779e-5cd7-87fe-2a773103e41b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }" :db/id #edb/ref 17592186317697}] :answer-field/correct {:answer/id #uuid "2aace116-779e-5cd7-87fe-2a773103e41b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\pi }" :db/id #edb/ref 17592186317697} :answer-field/id #uuid "c1fe8d6b-b674-5235-b645-ef3a0cb2483c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318841}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "af8d7c5c-930c-59d3-b49e-ff7666f63383" :question/math-academy-id "q-346081" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}\\operatorname{cos}⁡(\\frac{\\pi x}{4})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=\\frac{\\pi x}{4},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{\\pi }{4}\\,⟹\\,\\text{d}x=\\frac{4}{\\pi }\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi /2$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\operatorname{cos}⁡(\\frac{\\pi x}{4})\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\cdot \\frac{4}{\\pi }\\,\\text{d}u \\\\  & =\\frac{4}{\\pi }{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{4}{\\pi }\\operatorname{sin}⁡u\\,{|}_{0}^{\\pi /2} \\\\  & =\\frac{4}{\\pi }(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{4}{\\pi }(1-0) \\\\  & =\\frac{4}{\\pi }\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319362 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eadacb51-45df-579b-815c-4ee743a75466" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186318349}] :answer-field/correct {:answer/id #uuid "eadacb51-45df-579b-815c-4ee743a75466" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186318349} :answer-field/id #uuid "5c9f9e3d-f030-5ab8-bf81-f4f2a6ec193d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318623}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "60a6f7c5-9743-5406-97a4-9c3469a873e7" :question/math-academy-id "q-350040" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}9\\operatorname{sin}⁡(2x)\\,\\text{d}x=$\n\n{{field-1}}" :question/worked-solution "If we let $u=2x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\pi /2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}9\\operatorname{sin}⁡(2x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}9\\operatorname{sin}⁡u\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{9}{2}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{9}{2}\\operatorname{cos}⁡u{|}_{0}^{\\pi /2} \\\\  & =-\\frac{9}{2}(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{9}{2}(0-1) \\\\  & =\\frac{9}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186429932 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027cbe6b-cc9e-5232-a368-f7d9b5981f38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186429910} {:answer/id #uuid "4952b9e8-bbdc-5ebd-87ec-3e2a8e0abe98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186429912} {:answer/id #uuid "c99d3fe5-21ad-5042-83f6-cbfa8e3c7e98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186429920} {:answer/id #uuid "d0f5b679-6496-55a2-9c95-8d9e7d1b6239" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186429921} {:answer/id #uuid "d6fa740d-7171-561d-a05a-6cdf9a71c7c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186429922}] :answer-field/correct {:answer/id #uuid "4952b9e8-bbdc-5ebd-87ec-3e2a8e0abe98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186429912} :answer-field/id #uuid "bcc8d1e8-f376-53d7-9c0f-65db14888af4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186429927}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a41efe2e-217f-5d4e-8c40-c317692d2ec6" :question/math-academy-id "q-10574" :question/problem "Calculate ${\\int }_{0}^{\\pi /9}\\operatorname{sin}⁡(3x+\\frac{\\pi }{3})\\,\\text{d}x.$" :question/worked-solution "If we let $u=3x+\\frac{\\pi }{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi /9$ |\n| --- | --- | --- |\n| $u$ | $\\pi /3$ | $2\\pi /3$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /9}\\operatorname{sin}⁡(3x+\\frac{\\pi }{3})\\,\\text{d}x & ={\\int }_{\\pi /3}^{2\\pi /3}\\operatorname{sin}⁡u\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{\\pi /3}^{2\\pi /3}\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{cos}⁡u{|}_{\\pi /3}^{2\\pi /3} \\\\  & =-\\frac{1}{3}(\\operatorname{cos}⁡(\\frac{2\\pi }{3})-\\operatorname{cos}⁡(\\frac{\\pi }{3})) \\\\  & =-\\frac{1}{3}(-\\frac{1}{2}-\\frac{1}{2}) \\\\  & =\\frac{1}{3}\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186482716 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76973ccd-ce2c-5c47-9012-95953c70b708" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186482714}] :answer-field/correct {:answer/id #uuid "76973ccd-ce2c-5c47-9012-95953c70b708" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186482714} :answer-field/id #uuid "2ec1cc2e-eb99-5092-9662-f13d832f50bb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482710}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8f654224-65f2-57a8-af63-8ce90f4b8444" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{\\pi}{20}}9 \\sin{\\left(10 x \\right)}\\,\\text{d}x=$\n\n{{field-1}}" :question/worked-solution "If we let $u=10 x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10\\,\\Longrightarrow\\,\\text{d}x=\\frac{1}{10}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\frac{\\pi}{20}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi}{2}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{\\pi}{20}}9 \\sin{\\left(10 x \\right)}\\,\\text{d}x &= {\\int }_{0}^{\\frac{\\pi}{2}}9\\sin(u)\\cdot \\frac{1}{10}\\,\\text{d}u \\\\ &= \\frac{9}{10}{\\int }_{0}^{\\frac{\\pi}{2}}\\sin(u)\\,\\text{d}u \\\\ &= - \\frac{9 \\cos{\\left(u \\right)}}{10}\\big|_{0}^{\\frac{\\pi}{2}} \\\\ &= 0-(- \\frac{9}{10}) \\\\ &= \\frac{9}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186482718 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a46ef29-9be2-599e-9979-227efe7d3656" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2 \\pi}" :db/id #edb/ref 17592186482717}] :answer-field/correct {:answer/id #uuid "9a46ef29-9be2-599e-9979-227efe7d3656" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2 \\pi}" :db/id #edb/ref 17592186482717} :answer-field/id #uuid "34cf8706-7447-5aae-95bc-1a08810cce88" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482711}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b2b0e365-9687-5e65-8bbf-63ff6c2d35ea" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{1}{4}}\\cos{\\left(2 \\pi x \\right)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "If we let $u=2 \\pi x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2 \\pi\\,\\Longrightarrow\\,\\text{d}x=\\frac{1}{2 \\pi}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\frac{1}{4}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi}{2}$ |\n\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{1}{4}}\\cos{\\left(2 \\pi x \\right)}\\,\\text{d}x &= {\\int }_{0}^{\\frac{\\pi}{2}}1\\cos(u)\\cdot \\frac{1}{2 \\pi}\\,\\text{d}u \\\\ &= \\frac{1}{2 \\pi}{\\int }_{0}^{\\frac{\\pi}{2}}\\cos(u)\\,\\text{d}u \\\\ &= \\frac{\\sin{\\left(u \\right)}}{2 \\pi}\\big|_{0}^{\\frac{\\pi}{2}} \\\\ &= \\frac{1}{2 \\pi}-(0) \\\\ &= \\frac{1}{2 \\pi}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186482722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d7216e-01c1-55dc-afe1-24eba218c8fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186482709} {:answer/id #uuid "77ae08f7-2b6b-5e95-8284-a321136f9e0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186482715} {:answer/id #uuid "b5e91fc1-2ced-55cf-849f-07ffaef0ddeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{18}" :db/id #edb/ref 17592186482719} {:answer/id #uuid "d29f8cd2-dee8-59dc-a36c-2b21b5dd77d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186482721} {:answer/id #uuid "e5a92fef-96fc-50b1-a22d-d70a20e3848a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186482723}] :answer-field/correct {:answer/id #uuid "d29f8cd2-dee8-59dc-a36c-2b21b5dd77d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186482721} :answer-field/id #uuid "4487d6e6-4e17-5c90-b1bb-1610fc9f5628" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186482712}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d6b42e8b-fdca-50f0-be23-a0ae2f737155" :question/problem "Calculate ${\\int }_{0}^{\\frac{\\pi}{27}}\\sin{\\left(9 x + \\frac{\\pi}{3} \\right)}\\,\\text{d}x.$" :question/worked-solution "If we let $u=9 x + \\frac{\\pi}{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,\\Longrightarrow\\,\\text{d}x=\\frac{1}{9}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\frac{\\pi}{27}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\pi}{3}$ | $\\frac{2 \\pi}{3}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{\\pi}{27}}\\sin{\\left(9 x + \\frac{\\pi}{3} \\right)}\\,\\text{d}x &= {\\int }_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}}1\\sin(u)\\cdot \\frac{1}{9}\\,\\text{d}u \\\\ &= \\frac{1}{9}{\\int }_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}}\\sin(u)\\,\\text{d}u \\\\ &= - \\frac{\\cos{\\left(u \\right)}}{9}\\big|_{\\frac{\\pi}{3}}^{\\frac{2 \\pi}{3}} \\\\ &= \\frac{1}{18}-(- \\frac{1}{18}) \\\\ &= \\frac{1}{9}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186482724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55bc9615-3a10-584e-a34c-31b663bcb68a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186482713}] :answer-field/correct {:answer/id #uuid "55bc9615-3a10-584e-a34c-31b663bcb68a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186482713} :answer-field/id #uuid "c3485420-0f9b-591f-a441-d93100d3c590" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186482720}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f49ac21a-2d62-566e-a42d-88814c785a3f" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{\\pi}{48}}9 \\sin{\\left(24 x \\right)}\\,\\text{d}x=$\n\n{{field-1}}" :question/worked-solution "If we let $u=24 x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=24\\,\\Longrightarrow\\,\\text{d}x=\\frac{1}{24}\\,\\text{d}u.\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\frac{\\pi}{48}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi}{2}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\frac{\\pi}{48}}9 \\sin{\\left(24 x \\right)}\\,\\text{d}x &= {\\int }_{0}^{\\frac{\\pi}{2}}9\\sin(u)\\cdot \\frac{1}{24}\\,\\text{d}u \\\\ &= \\frac{3}{8}{\\int }_{0}^{\\frac{\\pi}{2}}\\sin(u)\\,\\text{d}u \\\\ &= - \\frac{3 \\cos{\\left(u \\right)}}{8}\\big|_{0}^{\\frac{\\pi}{2}} \\\\ &= 0-(- \\frac{3}{8}) \\\\ &= \\frac{3}{8}\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Trigonometric Functions With Linear Arguments"}]}
