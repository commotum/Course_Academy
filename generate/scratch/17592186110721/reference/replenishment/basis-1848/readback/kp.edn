t/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11383c9f-6bca-51a0-bf87-839bec637ba1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295365}] :answer-field/correct {:answer/id #uuid "11383c9f-6bca-51a0-bf87-839bec637ba1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295365} :answer-field/id #uuid "b78bfb02-4c20-5a75-811c-305086ea1983" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73256cc5-b18c-5ffc-bb1b-9018e84f6eb6" :question/math-academy-id "q-288583" :question/problem "Consider the equation\n\n$$\n2tx+(1-m)=6x+4\n$$\n\nwhere $t$ and $m$ are constants. Given that this equation has infinitely many solutions, what is the value of $t+m?$\n\n$t+m=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $t$ and $m$ such that the equation\n\n$$\n2tx+(1-m)=6x+4\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n2t=6.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=3.\n$$\n\n- Equating the constants, we get\n\n$$\n1-m=4.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\nm=-3.\n$$\n\nFinally, since $t=3$ and $m=-3,$ we have\n\n$$\nt+m=3+(-3)=0.\n$$"} {:db/id #edb/ref 17592186297195 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296621}] :answer-field/correct {:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296621} :answer-field/id #uuid "58355121-2d5d-5aa8-91c2-79f41befa005" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296811}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1e37e75-7d0c-5923-8a40-5f706dc21da1" :question/math-academy-id "q-288584" :question/problem "Consider the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nwhere $s$ and $t$ are constants. Given that this equation has infinitely many solutions, what is the value of $s+t?$\n\n$s+t=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $s$ and $t$ such that the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n-s+3=1.\n$$\n\nSolving this equation for $s,$ we get\n\n$$\ns=2.\n$$\n\n- Equating the constants, we have\n\n$$\n2t=6.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=3.\n$$\n\nFinally, since $s=2$ and $t=3,$ we have\n\n$$\ns+t=2+3=5.\n$$"} {:db/id #edb/ref 17592186297198 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26dea449-5daa-571d-bc24-21b16885571b" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186295478} {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} {:answer/id #uuid "7f368c30-e2fd-5534-8546-adacd3bdc62c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295955} {:answer/id #uuid "bb0e5e07-5208-59c1-8031-79b63eb57a08" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296248} {:answer/id #uuid "e8efa7fd-e32d-5724-96bb-c481dd8ea2c4" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296507}] :answer-field/correct {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} :answer-field/id #uuid "049c5b1b-3107-5777-ad7f-5a1a5ac925c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afc322c5-285c-5560-a114-d1da26bf18af" :question/math-academy-id "q-288622" :question/problem "Consider the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+2=7.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =5.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n5n=15.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =3.\\end{aligned}\n$$\n\nFinally, since $m=5$ and $n=3,$ we have\n\n$$\nm+n=5+3=8.\n$$"} {:db/id #edb/ref 17592186297199 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a9032f-3b49-520d-8dd2-f9561ab549a5" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186295402} {:answer/id #uuid "408f08fe-9474-5041-b518-50e39558bff0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186295635} {:answer/id #uuid "40aa1a16-e6d9-5660-9646-91aa012afb7d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id #edb/ref 17592186295636} {:answer/id #uuid "4376d57c-3e21-5f7a-9e08-da1e663ee90a" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295647} {:answer/id #uuid "f4e2b538-9abc-5649-871f-12082724e81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186296563}] :answer-field/correct {:answer/id #uuid "f4e2b538-9abc-5649-871f-12082724e81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id #edb/ref 17592186296563} :answer-field/id #uuid "a7f50aa1-8f5f-55b0-9f35-0014c59522a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296988}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48147a3d-8103-52a6-b2f5-5907d423b5d5" :question/math-academy-id "q-288623" :question/problem "Consider the equation\n\n$$\n2kx+r=9x+6\n$$\n\nwhere $k$ and $r$ are constants. Given that this equation has infinitely many solutions, what is the value of $k+r?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $k$ and $r$ such that the equation\n\n$$\n2kx+r=9x+6\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n2k=9.\n$$\n\nSolving this equation for $k,$ we get\n\n$$\n\\begin{aligned}k & =\\frac{9}{2}.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\nr=6.\n$$\n\nFinally, since $k=\\frac{9}{2}$ and $r=6,$ we have\n\n$$\nk+r=\\frac{9}{2}+6=\\frac{21}{2}.\n$$"} {:db/id #edb/ref 17592186297200 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28da790f-20c9-5875-b417-1be764fa2aeb" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295496} {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} {:answer/id #uuid "c24c121c-9aae-5ae4-989f-173c011f7cdc" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186296294} {:answer/id #uuid "c7c8cfa6-04bf-59ad-b50b-09698209ddbc" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186296316} {:answer/id #uuid "e7994d65-33f9-5bec-9e19-0969a17a2b2b" :answer/type {:db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296497}] :answer-field/correct {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} :answer-field/id #uuid "a71ebbc6-abec-50c8-b8f1-d671ed8c0cf9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296986}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f55693d-3dd0-5310-a538-5dcb7f69af97" :question/math-academy-id "q-288627" :question/problem "Consider the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p+q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $p$ and $q$ such that the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n\\frac{p}{2}=4.\n$$\n\nSolving this equation for $p,$ we get\n\n$$\n\\begin{aligned}p & =8.\\end{aligned}\n$$\n\n- Equating the constants, we get\n\n$$\nq=20.\n$$\n\nFinally, since $p=8$ and $q=20,$ we have\n\n$$\np+q=8+20=28.\n$$"} {:db/id #edb/ref 17592186477006 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f507488-4595-522d-987d-9cb1830b28d4" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186477012} {:answer/id #uuid "809ccd9d-fcfa-5f07-b35d-ba36d56528a3" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186477013} {:answer/id #uuid "85a2d72a-110b-5ef3-91a7-6c6ea19a612f" :answer/type {:db/ident :answer.type/math} :answer/value "88" :db/id #edb/ref 17592186477014} {:answer/id #uuid "b5e87be2-7f84-5050-8450-0a88afe51a84" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186477017} {:answer/id #uuid "e45d5b04-882a-57f9-a42e-18c402ad7f7b" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186477024}] :answer-field/correct {:answer/id #uuid "7f507488-4595-522d-987d-9cb1830b28d4" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186477012} :answer-field/id #uuid "fecfe7d0-ddbf-5842-ad10-352285c2f4d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186477025}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "436cab40-c84e-51f6-a518-ef754e1d23e8" :question/problem "Consider the equation\n\n$$\n(m+7)x+8n=9x+88\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+7)x+8n=9x+88\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+7=9.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =2.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n8n=88.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =11.\\end{aligned}\n$$\n\nFinally, since $m=2$ and $n=11,$ we have\n\n$$\nm+n=2+11=13.\n$$"} {:db/id #edb/ref 17592186477007 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e054d18f-0abd-534e-af79-b4becb7e8af4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186477023}] :answer-field/correct {:answer/id #uuid "e054d18f-0abd-534e-af79-b4becb7e8af4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186477023} :answer-field/id #uuid "bf404ba6-be51-5d74-9701-f28660bc675d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186477019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "475d1245-f209-5a1a-94d0-b61255568fb1" :question/problem "Consider the equation\n\n$$\n(-s+16)x+2t=7x+12\n$$\n\nwhere $s$ and $t$ are constants. Given that this equation has infinitely many solutions, what is the value of $s+t?$\n\n$s+t=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $s$ and $t$ such that the equation\n\n$$\n(-s+16)x+2t=7x+12\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n-s+16=7.\n$$\n\nSolving this equation for $s,$ we get\n\n$$\ns=9.\n$$\n\n- Equating the constants, we have\n\n$$\n2t=12.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=6.\n$$\n\nFinally, since $s=9$ and $t=6,$ we have\n\n$$\ns+t=9+6=15.\n$$"} {:db/id #edb/ref 17592186477016 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c305d1ca-2a7e-5395-b01d-7f73d8b68b81" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186477020}] :answer-field/correct {:answer/id #uuid "c305d1ca-2a7e-5395-b01d-7f73d8b68b81" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186477020} :answer-field/id #uuid "94e8a50e-ea95-52e9-9247-89cc6599449e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186477015}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af3151d7-d56f-5c03-a92e-cf11481af995" :question/problem "Consider the equation\n\n$$\n(-s+15)x+4t=3x+4\n$$\n\nwhere $s$ and $t$ are constants. Given that this equation has infinitely many solutions, what is the value of $s+t?$\n\n$s+t=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $s$ and $t$ such that the equation\n\n$$\n(-s+15)x+4t=3x+4\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n-s+15=3.\n$$\n\nSolving this equation for $s,$ we get\n\n$$\ns=12.\n$$\n\n- Equating the constants, we have\n\n$$\n4t=4.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=1.\n$$\n\nFinally, since $s=12$ and $t=1,$ we have\n\n$$\ns+t=12+1=13.\n$$"} {:db/id #edb/ref 17592186477018 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e96ccbc-fae0-58bf-a260-8810e64e49c8" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186477003} {:answer/id #uuid "6135c2cd-ed41-554f-a365-6407044708b9" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186477008} {:answer/id #uuid "64867657-b42b-5877-a7b8-d5f08508e6f0" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186477009} {:answer/id #uuid "7795fc96-bada-5d47-80e4-bcc20f479e5c" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186477011} {:answer/id #uuid "da276f27-55cf-5a27-b424-c537ddd7a3e8" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186477022}] :answer-field/correct {:answer/id #uuid "0e96ccbc-fae0-58bf-a260-8810e64e49c8" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186477003} :answer-field/id #uuid "1685aded-b577-5ed8-90cf-3a8f75f8adf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186477004}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bae891b2-2044-5361-b2ef-88211b0b3d9f" :question/problem "Consider the equation\n\n$$\n(m+8)x+8n=19x+48\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+8)x+8n=19x+48\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+8=19.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =11.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n8n=48.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =6.\\end{aligned}\n$$\n\nFinally, since $m=11$ and $n=6,$ we have\n\n$$\nm+n=11+6=17.\n$$"} {:db/id #edb/ref 17592186477021 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29420e57-07ec-566d-b584-32e9a65019be" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186477005}] :answer-field/correct {:answer/id #uuid "29420e57-07ec-566d-b584-32e9a65019be" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186477005} :answer-field/id #uuid "74d8a1c6-b3bb-5405-b5c5-2de709852649" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186477010}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2ad0a7a-e832-5a60-bb09-72e5ecf114bf" :question/problem "Consider the equation\n\n$$\n5tx+(1-m)=55x+4\n$$\n\nwhere $t$ and $m$ are constants. Given that this equation has infinitely many solutions, what is the value of $t+m?$\n\n$t+m=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $t$ and $m$ such that the equation\n\n$$\n5tx+(1-m)=55x+4\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n5t=55.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=11.\n$$\n\n- Equating the constants, we get\n\n$$\n1-m=4.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\nm=-3.\n$$\n\nFinally, since $t=11$ and $m=-3,$ we have\n\n$$\nt+m=11+(-3)=8.\n$$"}] :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}]}
