      "question": {
        ":question/id": "20515a44-66d9-5ff7-84aa-7d04800bd82f",
        ":question/problem": "Consider the ellipse centered at $(4,0)$ with horizontal radius $3$ and vertical radius $7.$ Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse?",
        ":question/answer-fields": [
          {
            ":answer-field/id": "9397b61d-948d-504f-950b-18860c8f3421",
            ":answer-field/key": "selection",
            ":answer-field/type": ":answer-field.type/radio",
