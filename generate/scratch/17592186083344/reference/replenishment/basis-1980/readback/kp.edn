/id #edb/ref 17592186253151}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bfa67a4d-773b-5a56-87ac-2e520036ce73" :question/math-academy-id "q-118618" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{({x}^{2}+1)^{3}}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u={x}^{2}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{2}+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{({x}^{2}+1)^{3}}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }{u}^{-3/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-3/2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }{[-2{u}^{-1/2}]}_{1}^{a} \\\\  & =-{lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt{u}}]}_{1}^{a} \\\\  & =-{lim}_{a\\to \\infty }(\\frac{1}{\\sqrt{a}}-1) \\\\  & =-(0-1) \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275265 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38b40290-f4b5-5a0c-be7c-96b2f991be33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186272884} {:answer/id #uuid "58e3e781-1f60-5931-b1ab-d40d34456c59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186273147} {:answer/id #uuid "cdcef9fb-9792-5a33-9834-01011e4cecef" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186274179} {:answer/id #uuid "d21993ef-a070-5549-8573-0bebbc8c466f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186274222} {:answer/id #uuid "fa381c2a-d88b-56af-ae05-33eda16e16c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186274580}] :answer-field/correct {:answer/id #uuid "58e3e781-1f60-5931-b1ab-d40d34456c59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186273147} :answer-field/id #uuid "00ce7354-3030-510c-bcbd-23e31ec43dfc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274637}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9866e046-eb23-5536-9118-9338cb3fa801" :question/math-academy-id "q-152045" :question/problem "Evaluate ${\\int }_{0}^{\\infty }\\frac{3}{\\sqrt{(2x+4)^{3}}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u=2x+4.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=2x+4$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $4$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{3}{\\sqrt{(2x+4)^{3}}}\\,\\text{d}x & ={\\int }_{4}^{\\infty }\\frac{3}{\\sqrt{{u}^{3}}}(\\frac{1}{2}\\,\\text{d}u) \\\\  & =\\frac{3}{2}{\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{3}{\\sqrt{(2x+4)^{3}}}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & =\\frac{3}{2}{\\int }_{4}^{\\infty }{u}^{-3/2}\\,\\text{d}u \\\\  & =\\frac{3}{2}{lim}_{a\\to \\infty }{\\int }_{4}^{a}{u}^{-3/2}\\,\\text{d}u \\\\  & =\\frac{3}{2}{lim}_{a\\to \\infty }{[-2{u}^{-1/2}]}_{4}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt{u}}]}_{4}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }[\\frac{1}{\\sqrt{a}}-\\frac{1}{\\sqrt{4}}] \\\\  & =-3\\cdot (0-\\frac{1}{2}) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275266 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a11a46-1ee3-5e97-8f5c-d2abb45897e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186272726} {:answer/id #uuid "3ac4135a-ba42-51f2-9589-6f253f1dccac" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186272898} {:answer/id #uuid "3d241674-25f3-586b-9f92-1ae97b73f2d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186272911} {:answer/id #uuid "82c45777-32c0-5bbe-903e-12a9832686d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186273509} {:answer/id #uuid "e43e2450-5746-5333-88fb-b2698cd7c90f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186274405}] :answer-field/correct {:answer/id #uuid "3d241674-25f3-586b-9f92-1ae97b73f2d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186272911} :answer-field/id #uuid "f9379364-a06d-5360-b86f-2168fc1e5c00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275074}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b4ebe1c-7aff-5381-8ad5-281043ebfb60" :question/math-academy-id "q-152056" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{{x}^{2}}{\\sqrt{({x}^{3}+1)^{5}}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u={x}^{3}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{3}+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{x}^{2}}{\\sqrt{({x}^{3}+1)^{5}}}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{\\sqrt{{x}^{3}+1}}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{1}^{\\infty }{u}^{-5/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-5/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}{lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3/2}]}_{1}^{a} \\\\  & =-\\frac{2}{9}{lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt{{u}^{3}}}]}_{1}^{a} \\\\  & =-\\frac{2}{9}{lim}_{a\\to \\infty }(\\frac{1}{\\sqrt{{a}^{3}}}-1) \\\\  & =-\\frac{2}{9}(0-1) \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275295 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09c25cd7-e43c-5867-9197-1ea57513487c" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186272470} {:answer/id #uuid "aa37f140-928a-5f9c-98df-08319686b282" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273858} {:answer/id #uuid "bf4f57fe-edf1-5a1a-80e8-43a57330b833" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186274040} {:answer/id #uuid "c27f9c75-c61b-5146-a432-d5051ff1cbbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186274074} {:answer/id #uuid "f8fe9d4f-ca4d-59b2-bf98-68697411b047" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186274569}] :answer-field/correct {:answer/id #uuid "aa37f140-928a-5f9c-98df-08319686b282" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186273858} :answer-field/id #uuid "826506dc-d5aa-52cf-8357-625d503add96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274858}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69ccaa61-239d-507f-a5cc-30c609c287b4" :question/math-academy-id "q-152779" :question/problem "Evaluate ${\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z.$" :question/worked-solution "First, we substitute $u=z+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=1\\,⟹\\,\\text{d}u=\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u=z+2$ is as follows:\n\n| $z$ | $-1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z={\\int }_{1}^{\\infty }\\frac{6}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z & ={\\int }_{1}^{\\infty }\\frac{6}{{u}^{4}}\\,\\text{d}u \\\\  & =6{\\int }_{1}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =6{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =6{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{1}^{3}}] \\\\  & =-2\\cdot (0-1) \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275296 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32496a0b-0230-56b7-a08f-0eacec67f0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186272838} {:answer/id #uuid "54d16173-4764-586a-9e7d-eae609ca54b7" :answer/type {:db/ident :answer.type/text} :answer/value "The Integral diverges" :db/id #edb/ref 17592186273110} {:answer/id #uuid "6e3a8ce3-a04f-549b-961f-7f4308c92010" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186273346} {:answer/id #uuid "cff5572a-a2b4-5582-bb9e-a320f544f89d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186274200} {:answer/id #uuid "fe4ae8a0-1bfb-5e1e-a786-8e51d30074fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186274623}] :answer-field/correct {:answer/id #uuid "6e3a8ce3-a04f-549b-961f-7f4308c92010" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186273346} :answer-field/id #uuid "3032f180-f025-53e0-856a-88e12dd4d4d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274720}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "12c7271a-e53c-5579-a182-e59f266fc9f5" :question/math-academy-id "q-152785" :question/problem "Evaluate the integral ${\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z.$" :question/worked-solution "First, we substitute $u={z}^{4}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=4{z}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={z}^{3}\\,\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u={z}^{4}+1$ is as follows:\n\n| $z$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & ={\\int }_{2}^{\\infty }\\frac{8}{{u}^{4}}(\\frac{1}{4}\\,\\text{d}u) \\\\  & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =2{\\int }_{2}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{2}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }(\\frac{1}{{a}^{3}}-\\frac{1}{8}) \\\\  & =-\\frac{2}{3}(0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319386 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2b84759-63fa-5697-9589-8a03b63ecdef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186318372}] :answer-field/correct {:answer/id #uuid "f2b84759-63fa-5697-9589-8a03b63ecdef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186318372} :answer-field/id #uuid "b5b766f3-690f-5bb1-b9b8-11c48d9b7aed" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ad09e6e-7d4e-5f78-9ad8-d40330d32874" :question/math-academy-id "q-350527" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{3}{(x+1)^{5}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=x+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=x+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{3}{(x+1)^{5}}\\,\\text{d}x={\\int }_{1}^{\\infty }\\frac{3}{{u}^{5}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{3}{(x+1)^{5}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{3}{{u}^{5}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }3{u}^{-5}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}3{u}^{-5}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{3}{4}{u}^{-4}]}_{1}^{a} \\\\  & =-\\frac{3}{4}\\cdot {lim}_{a\\to \\infty }{[{u}^{-4}]}_{1}^{a} \\\\  & =-\\frac{3}{4}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{4}}-\\frac{1}{{1}^{4}}] \\\\  & =-\\frac{3}{4}\\cdot (0-1) \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319387 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30bb13ff-8e84-50d3-8caf-75c51cb5c866" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{81}" :db/id #edb/ref 17592186317713}] :answer-field/correct {:answer/id #uuid "30bb13ff-8e84-50d3-8caf-75c51cb5c866" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{81}" :db/id #edb/ref 17592186317713} :answer-field/id #uuid "942bc8de-494e-59d4-aef2-b5344825d601" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18f346cd-4181-53c0-a9f8-c1ee4d65ecf8" :question/math-academy-id "q-350528" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=x+3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=x+3$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $3$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x={\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{{u}^{8}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x & ={\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{{u}^{8}}}\\,\\text{d}u \\\\  & ={\\int }_{3}^{\\infty }2{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}2{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3}]}_{3}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3}]}_{3}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{3}^{3}}] \\\\  & =-\\frac{2}{3}\\cdot (0-\\frac{1}{27}) \\\\  & =\\frac{2}{81}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319388 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc93f73c-03ee-59bf-93ed-905ccaef63cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{72}" :db/id #edb/ref 17592186318304}] :answer-field/correct {:answer/id #uuid "dc93f73c-03ee-59bf-93ed-905ccaef63cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{72}" :db/id #edb/ref 17592186318304} :answer-field/id #uuid "7f24bd57-1f42-5b26-8e2a-3e8bcc7e1d43" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d8204e3-36f5-5613-9381-17a7588e2a05" :question/math-academy-id "q-350530" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{5}{(3y+2)^{4}}\\,\\text{d}y=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=3y+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=3\\,⟹\\,\\text{d}u=3\\text{d}y.\n$$\n\nSince $u\\to \\infty $ when $y\\to \\infty ,$ the table for the limits of integration using the rule $u=3y+2$ is as follows:\n\n| $y$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{5}{(3y+2)^{4}}\\,\\text{d}y={\\int }_{2}^{\\infty }\\frac{5}{3{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{5}{(3y+2)^{4}}\\,\\text{d}y & ={\\int }_{2}^{\\infty }\\frac{5}{3{u}^{4}}\\,\\text{d}u \\\\  & ={\\int }_{2}^{\\infty }\\frac{5}{3}{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{5}{3}{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{5}{9}{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{5}{9}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{5}{9}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{2}^{3}}] \\\\  & =-\\frac{5}{9}\\cdot (0-\\frac{1}{8}) \\\\  & =\\frac{5}{72}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319389 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b355d9a6-e99e-5ef7-91c3-31ee7ef8c4e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186318171}] :answer-field/correct {:answer/id #uuid "b355d9a6-e99e-5ef7-91c3-31ee7ef8c4e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186318171} :answer-field/id #uuid "a16a7e76-2e13-5b78-a1c4-a4fc2dd41d9c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318778}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7437525-50e8-5c3a-901b-813c72ad9b69" :question/math-academy-id "q-350531" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=4t+3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=4\\,⟹\\,\\text{d}u=4\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=4t+3$ is as follows:\n\n| $t$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $3$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t={\\int }_{3}^{\\infty }\\frac{3}{2\\sqrt{{u}^{3}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t & ={\\int }_{3}^{\\infty }\\frac{3}{2\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & ={\\int }_{3}^{\\infty }\\frac{3}{2}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}\\frac{3}{2}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-3{u}^{-1/2}]}_{3}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[{u}^{-1/2}]}_{3}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }[\\frac{1}{\\sqrt{a}}-\\frac{1}{\\sqrt{3}}] \\\\  & =-3\\cdot (0-\\frac{1}{\\sqrt{3}}) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319390 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b108f43-8cc9-5ed2-849e-bf0b3ad9c65c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186317813}] :answer-field/correct {:answer/id #uuid "4b108f43-8cc9-5ed2-849e-bf0b3ad9c65c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186317813} :answer-field/id #uuid "c422af80-a92f-5eec-bc99-8a36d0097520" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab199904-ad8d-5246-bdfd-890bb0a93820" :question/math-academy-id "q-350532" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{2}{(5\\theta +1)^{3}}\\,\\text{d}\\theta =$\n{{field-1}}" :question/worked-solution "First, we substitute $u=5\\theta +1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}\\theta }=5\\,⟹\\,\\text{d}u=5\\text{d}\\theta .\n$$\n\nSince $u\\to \\infty $ when $\\theta \\to \\infty ,$ the table for the limits of integration using the rule $u=5\\theta +1$ is as follows:\n\n| $\\theta $ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2}{(5\\theta +1)^{3}}\\,\\text{d}\\theta ={\\int }_{1}^{\\infty }\\frac{2}{5{u}^{3}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{(5\\theta +1)^{3}}\\,\\text{d}\\theta  & ={\\int }_{1}^{\\infty }\\frac{2}{5{u}^{3}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }\\frac{2}{5}{u}^{-3}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{2}{5}{u}^{-3}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{5}{u}^{-2}]}_{1}^{a} \\\\  & =-\\frac{1}{5}\\cdot {lim}_{a\\to \\infty }{[{u}^{-2}]}_{1}^{a} \\\\  & =-\\frac{1}{5}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{2}}-\\frac{1}{{1}^{2}}] \\\\  & =-\\frac{1}{5}\\cdot (0-1) \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186320710 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "325cede2-6960-5085-95d8-87d16b121023" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186319547}] :answer-field/correct {:answer/id #uuid "325cede2-6960-5085-95d8-87d16b121023" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186319547} :answer-field/id #uuid "85532c92-78b7-5603-b881-ac2fb0559928" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320436}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f4fafe02-cb7d-53b6-a541-a5c4876489aa" :question/math-academy-id "q-350534" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{4{x}^{3}}{\\sqrt{({x}^{4}+2)^{3}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u={x}^{4}+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}\\,⟹\\,\\text{d}u=4{x}^{3}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{4}+2$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{4{x}^{3}}{\\sqrt{({x}^{4}+2)^{3}}}\\,\\text{d}x={\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{4{x}^{3}}{\\sqrt{({x}^{4}+2)^{3}}}\\,\\text{d}x & ={\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & ={\\int }_{2}^{\\infty }{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-2{u}^{-1/2}]}_{2}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[{u}^{-1/2}]}_{2}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{1/2}}-\\frac{1}{{2}^{1/2}}] \\\\  & =-2\\cdot (0-\\frac{1}{\\sqrt{2}}) \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186369818 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e197f9-926d-5a38-b07b-3b834b50535f" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186369820} {:answer/id #uuid "dafbddd2-29ab-58ca-9736-d248a9876ed7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186369821} {:answer/id #uuid "2f7cd5c5-dc32-5789-8e7c-5560c7a38366" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186369822} {:answer/id #uuid "6db6a9c1-e6da-5b48-a604-1d3d52519aeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186369823} {:answer/id #uuid "990bf603-9c44-51da-bab2-c8dd72364300" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186369824}] :answer-field/correct {:answer/id #uuid "990bf603-9c44-51da-bab2-c8dd72364300" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186369824} :answer-field/id #uuid "fc0112dd-0650-59f6-9f8d-f8fe5b3a18d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369819}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7f9f79e8-4c67-5d89-b4b2-6ab9cd147e21" :question/math-academy-id "q-152053" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{{x}^{2}}{{(1+{x}^{3})}^{4}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u=1+{x}^{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=1+{x}^{3}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{x}^{2}}{{(1+{x}^{3})}^{4}}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{x}^{2}}{{(1+{x}^{3})}^{4}}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =\\frac{1}{3}{\\int }_{1}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =\\frac{1}{3}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =\\frac{1}{3}{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{1}^{a} \\\\  & =-\\frac{1}{9}{lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{1}^{a} \\\\  & =-\\frac{1}{9}{lim}_{a\\to \\infty }(\\frac{1}{{a}^{3}}-1) \\\\  & =-\\frac{1}{9}(0-1) \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186370621 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "703e41a4-7d89-5c9f-bced-f0d638d7838b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186370623}] :answer-field/correct {:answer/id #uuid "703e41a4-7d89-5c9f-bced-f0d638d7838b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186370623} :answer-field/id #uuid "edbc9163-b55c-5bce-840b-693a8baab0a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370622}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "33e3355d-955a-5955-a1cd-54387f01dc2b" :question/math-academy-id "q-346591" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{1}{\\sqrt{(x+1)^{9}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=x+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=x+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{1}{\\sqrt{(x+1)^{9}}}\\,\\text{d}x={\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{9}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{1}{\\sqrt{(x+1)^{9}}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{9}}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }{u}^{-9/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-9/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{2}{7}{u}^{-7/2}]}_{1}^{a} \\\\  & =-\\frac{2}{7}\\cdot {lim}_{a\\to \\infty }{[{u}^{-7/2}]}_{1}^{a} \\\\  & =-\\frac{2}{7}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{7/2}}-\\frac{1}{{1}^{7/2}}] \\\\  & =-\\frac{2}{7}\\cdot (0-1) \\\\  & =\\frac{2}{7}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186370630 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0acdd02-a3ba-5daf-84fc-f0e64c6786e5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370632}] :answer-field/correct {:answer/id #uuid "a0acdd02-a3ba-5daf-84fc-f0e64c6786e5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370632} :answer-field/id #uuid "f8dbcc38-1fb6-5581-b775-a5c110cb46fd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370631}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae3b907d-af45-56d7-b164-a879ab5fe0cb" :question/math-academy-id "q-350533" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{3{x}^{2}}{\\sqrt{({x}^{3}+1)^{3}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u={x}^{3}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\text{d}u=3{x}^{2}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{3}+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{3{x}^{2}}{\\sqrt{({x}^{3}+1)^{3}}}\\,\\text{d}x={\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{3{x}^{2}}{\\sqrt{({x}^{3}+1)^{3}}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-2{u}^{-1/2}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[{u}^{-1/2}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{1/2}}-\\frac{1}{{1}^{1/2}}] \\\\  & =-2\\cdot (0-1) \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186377535 :knowledge-point/_questions [{:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f416306-21bf-539b-9b9c-b3c0c7c1874f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186377537}] :answer-field/correct {:answer/id #uuid "2f416306-21bf-539b-9b9c-b3c0c7c1874f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186377537} :answer-field/id #uuid "482395fb-c7fb-5370-bf50-f7fa1aec416c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186377536}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3bc676ae-5eea-5c37-8152-babd81d7b946" :question/math-academy-id "q-350536" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{10{x}^{4}}{\\sqrt{({x}^{5}+1)^{9}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u={x}^{5}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{5}+1$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{10{x}^{4}}{\\sqrt{({x}^{5}+1)^{9}}}\\,\\text{d}x={\\int }_{1}^{\\infty }\\frac{2}{\\sqrt{{u}^{9}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{10{x}^{4}}{\\sqrt{({x}^{5}+1)^{9}}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{2}{\\sqrt{{u}^{9}}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }2{u}^{-9/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}2{u}^{-9/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{4}{7}{u}^{-7/2}]}_{1}^{a} \\\\  & =-\\frac{4}{7}\\cdot {lim}_{a\\to \\infty }{[{u}^{-7/2}]}_{1}^{a} \\\\  & =-\\frac{4}{7}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{7/2}}-\\frac{1}{{1}^{7/2}}] \\\\  & =-\\frac{4}{7}\\cdot (0-1) \\\\  & =\\frac{4}{7}.\\end{aligned}\n$$"}] :knowledge-point/title "Calculating Improper Integrals With an Unbounded Upper Limit Using Substitution"}]}
