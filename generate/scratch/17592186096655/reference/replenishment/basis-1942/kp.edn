#{[{:db/id #edb/ref 17592186096655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096454 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/id #uuid "9a42787b-24fb-50c8-9f3f-9e95d35c403c" :question/math-academy-id "e-459" :question/problem "Calculate  $\\displaystyle{\\int e^{1-3x}\\, \\textrm{d}x }.$" :question/worked-solution "If we let $u=1-3x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3\\quad\\Longrightarrow\\quad \\textrm d x = -\\dfrac 1 3 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{1-3x}\\,\\text{d}x & =\\int {e}^{u}\\cdot (-\\frac{1}{3})\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}{e}^{u}+C \\\\  & =-\\frac{1}{3}{e}^{1-3x}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332} {:db/id #edb/ref 17592186048754} {:db/id #edb/ref 17592186050628}] :knowledge-point/questions [{:db/id #edb/ref 17592186097099 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83d7f849-00ec-5e56-93bd-5f9af777de2c" :answer/type {:db/ident :answer.type/math} :answer/value "-6e^{-6x} + C" :db/id #edb/ref 17592186094568} {:answer/id #uuid "86b83b6e-810a-5b7c-8d7d-dec07b441bde" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{-6x} + C" :db/id #edb/ref 17592186094569} {:answer/id #uuid "e0d45296-f41d-5260-89b5-e966f8183b9c" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-6x} + C" :db/id #edb/ref 17592186094570} {:answer/id #uuid "4c62783d-5ce8-5688-b061-43d00f936eb0" :answer/type {:db/iden