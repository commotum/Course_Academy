db/ident :answer.type/math} :answer/value "\\frac{128}{3}" :db/id #edb/ref 17592186267386} {:answer/id #uuid "cedd122e-70d9-5696-97f0-924ad1110ed1" :answer/type {:db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186267994}] :answer-field/correct {:answer/id #uuid "82cf1fb3-6525-538b-9699-a561c30abb9d" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186267295} :answer-field/id #uuid "4247852f-3c47-5cdb-ab06-85feef271aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268518}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b445bd7-4fa3-531e-a119-be633f3ce5d1" :question/math-academy-id "q-13775" :question/problem "Evaluate ${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration,  we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{6x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{6x}\\,\\text{d}u \\\\  & =4{\\int }_{0}^{6\\operatorname{ln}⁡2}{e}^{u}\\frac{1}{6}\\text{d}u \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{6})}{e}^{u}\\text{d}u \\\\  & =\\frac{2}{3}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({2}^{6})} \\\\  & =\\frac{2}{3}({e}^{\\operatorname{ln}⁡({2}^{6})}-{e}^{0}) \\\\  & =\\frac{2}{3}({2}^{6}-1) \\\\  & =\\frac{2}{3}(64-1) \\\\  & =\\frac{2}{3}\\cdot 63 \\\\  & =42\\end{aligned}\n$$"} {:db/id #edb/ref 17592186269150 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbe1e45-425c-5d24-9a2e-b0d2bc2b4422" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{9}" :db/id #edb/ref 17592186266423} {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} {:answer/id #uuid "5f41e2cc-d2de-56ef-80d2-9ac7568a671c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186266986} {:answer/id #uuid "7daa41e8-6e90-5e70-8402-bd9770caa41f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{80}{9}" :db/id #edb/ref 17592186267255} {:answer/id #uuid "a3c299e5-a721-5088-944a-c9d0c0bc8ecf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186267617}] :answer-field/correct {:answer/id #uuid "222530ab-2dcc-5d51-9809-57c96320b41e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186266449} :answer-field/id #uuid "a01b2373-b791-524c-ae21-c98d1b57c90b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268689}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e36897b-696c-54c5-85d9-3c04b5f56902" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297312 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68846e-8392-5a94-a3aa-2686ed8da072" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{25}{16}" :db/id #edb/ref 17592186295320} {:answer/id #uuid "2b89a108-9830-5765-ab37-236b6c7a436c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186295517} {:answer/id #uuid "567f2736-63ee-5f2a-b291-57227aca1813" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{16}" :db/id #edb/ref 17592186295771} {:answer/id #uuid "98a360bd-7dc7-5172-9965-33a5e01d2144" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{16}" :db/id #edb/ref 17592186296086} {:answer/id #uuid "b68c6e0c-5bad-5bf2-bfb7-247965fb865b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{25}{8}" :db/id #edb/ref 17592186296225}] :answer-field/correct {:answer/id #uuid "2b89a108-9830-5765-ab37-236b6c7a436c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{75}{32}" :db/id #edb/ref 17592186295517} :answer-field/id #uuid "f97a2636-5f46-5511-ac10-6484a8f5f52e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297145}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "38f9635e-72c4-5968-9945-fe2ceda9691e" :question/math-academy-id "q-30922" :question/problem "Evaluate the integral ${\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=-2x,$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,-\\frac{1}{2}\\text{d}u=\\,\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-2\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}-5{e}^{-2x}\\,\\text{d}x & =-5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{-2x}\\,\\text{d}u \\\\  & =-5{\\int }_{0}^{-2\\operatorname{ln}⁡4}{e}^{u}(-\\frac{1}{2}\\,\\text{d}u) \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{-2})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({4}^{-2})} \\\\  & =\\frac{5}{2}({e}^{\\operatorname{ln}⁡({4}^{-2})}-{e}^{0}) \\\\  & =\\frac{5}{2}({4}^{-2}-1) \\\\  & =\\frac{5}{2}(\\frac{1}{16}-1) \\\\  & =\\frac{5}{2}\\cdot (-\\frac{15}{16}) \\\\  & =-\\frac{75}{32}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319344 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f193d193-1bf0-5987-8095-5e68075aa685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{5}" :db/id #edb/ref 17592186318367}] :answer-field/correct {:answer/id #uuid "f193d193-1bf0-5987-8095-5e68075aa685" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{124}{5}" :db/id #edb/ref 17592186318367} :answer-field/id #uuid "cdbd4d07-bfd0-51cd-a3e5-380d16ff0679" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d36c1c11-19b9-5940-860c-a11b298fedf7" :question/math-academy-id "q-349595" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=5x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $5\\operatorname{ln}⁡2$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡2}4{e}^{5x}\\,\\text{d}x & =4{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{5x}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{5\\operatorname{ln}⁡2}{e}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{4}{5}{\\int }_{0}^{\\operatorname{ln}⁡({2}^{5})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{4}{5}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({2}^{5})} \\\\  & =\\frac{4}{5}({e}^{\\operatorname{ln}⁡({2}^{5})}-{e}^{0}) \\\\  & =\\frac{4}{5}({2}^{5}-1) \\\\  & =\\frac{4}{5}(32-1) \\\\  & =\\frac{4}{5}\\cdot 31 \\\\  & =\\frac{124}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319345 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3edf67a7-98ed-5fa7-a584-a4df28da0c03" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186317765}] :answer-field/correct {:answer/id #uuid "3edf67a7-98ed-5fa7-a584-a4df28da0c03" :answer/type {:db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186317765} :answer-field/id #uuid "96b04790-7dd5-55c7-ad74-3f32de8c4fb5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9d82eda-7286-547a-83ef-0ce6d0452b88" :question/math-academy-id "q-349596" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\operatorname{ln}⁡4}5{e}^{3x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $3\\operatorname{ln}⁡4$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡4}5{e}^{3x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡4}{e}^{3x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{3\\operatorname{ln}⁡4}{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}{\\int }_{0}^{\\operatorname{ln}⁡({4}^{3})}{e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\cdot {e}^{u}\\,{|}_{0}^{\\operatorname{ln}⁡({4}^{3})} \\\\  & =\\frac{5}{3}({e}^{\\operatorname{ln}⁡({4}^{3})}-{e}^{0}) \\\\  & =\\frac{5}{3}({4}^{3}-1) \\\\  & =\\frac{5}{3}(64-1) \\\\  & =\\frac{5}{3}(63) \\\\  & =105\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319346 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2699f10-0b6b-5d35-aaa2-36b73e978859" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9}-e" :db/id #edb/ref 17592186318120}] :answer-field/correct {:answer/id #uuid "a2699f10-0b6b-5d35-aaa2-36b73e978859" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{9}-e" :db/id #edb/ref 17592186318120} :answer-field/id #uuid "8e8ce480-0b94-536b-9ea9-402ad657f2e0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8852114f-8bc0-5518-9880-52e4b44b23ec" :question/math-academy-id "q-349601" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=4x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $9$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x & =4{\\int }_{0}^{2}{e}^{4x+1}\\,\\text{d}x \\\\  & =4{\\int }_{1}^{9}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & ={\\int }_{1}^{9}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{1}^{9} \\\\  & ={e}^{9}-{e}^{1} \\\\  & ={e}^{9}-e\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323783 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7048b4f-eab9-53d1-89fb-1d65b5316873" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{4}-3" :db/id #edb/ref 17592186322455}] :answer-field/correct {:answer/id #uuid "a7048b4f-eab9-53d1-89fb-1d65b5316873" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{4}-3" :db/id #edb/ref 17592186322455} :answer-field/id #uuid "efb3e809-f5f1-5a7d-8ffc-3c402b2e5aaa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186323641}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd07d931-c8c4-5e1c-9858-8aed94aa2f51" :question/math-academy-id "q-362689" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-1}^{0}12{e}^{-4x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=-4x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $-1$ | $0$ |\n| --- | --- | --- |\n| $u$ | $4$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}12{e}^{-4x}\\,\\text{d}x & =12{\\int }_{-1}^{0}{e}^{-4x}\\,\\text{d}x \\\\  & =12{\\int }_{4}^{0}{e}^{u}\\cdot (-\\frac{1}{4})\\,\\text{d}u \\\\  & =-3{\\int }_{4}^{0}{e}^{u}\\,\\text{d}u \\\\  & =-3\\cdot {e}^{u}\\,{|}_{4}^{0} \\\\  & =-3({e}^{0}-{e}^{4}) \\\\  & =-3(1-{e}^{4}) \\\\  & =3{e}^{4}-3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332860 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bcca4c-5187-5b94-ac7b-5d02a3f2a7a8" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2z}+C" :db/id #edb/ref 17592186330287} {:answer/id #uuid "42c0d901-d11d-559d-85ac-c32b85f2ebde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186330547} {:answer/id #uuid "b72adbd0-bb37-569b-a51f-ca71e2f21191" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186331566} {:answer/id #uuid "c2a7f69b-7b9b-5b9c-a316-48041e48b095" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2z}+C" :db/id #edb/ref 17592186331680} {:answer/id #uuid "ed5ddad8-9030-5f3c-8173-cbf15c6a73ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{z}}{2}+C" :db/id #edb/ref 17592186332034}] :answer-field/correct {:answer/id #uuid "42c0d901-d11d-559d-85ac-c32b85f2ebde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186330547} :answer-field/id #uuid "5a02851a-ae90-5a99-96af-7dadaa7d8178" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332375}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "375483c5-6d04-5b75-830f-34c3a2a176c9" :question/math-academy-id "q-51160" :question/problem "$\\int {e}^{z}{e}^{z}\\,\\text{d}z=$" :question/worked-solution "First, we notice that\n\n$$\n\\int {e}^{z}{e}^{z}\\,\\text{d}z=\\int {e}^{2z}\\,\\text{d}z.\n$$\n\nIf we let $u=2z$, then\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2\\,⟹\\,\\text{d}z=\\frac{1}{2}\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int {e}^{2z}\\,\\text{d}z & =\\int {e}^{2z}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{2z}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{2z}}{2}+C\\end{aligned}\\end{aligned}\n$$"}] :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}]}
