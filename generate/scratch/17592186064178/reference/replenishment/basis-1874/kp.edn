dent :answer.type/math} :answer/value "sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186289350}] :answer-field/correct {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} :answer-field/id #uuid "0c59fbc8-d124-507b-af30-f117e1976ad1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d70818e9-1705-53df-abe3-9e6e72f287c6" :question/math-academy-id "q-2161" :question/problem "$\\int (cos⁡x-sin⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (cos⁡x-sin⁡x)\\,\\text{d}x & =\\int cos⁡x\\,\\text{d}x-\\int sin⁡x\\,\\text{d}x \\\\  & =sin⁡x-(-cos⁡x)+C \\\\  & =sin⁡x+cos⁡x+C.\\end{aligned}\n$$"}] :knowledge-point/title "Integrating Sine and Cosine"}]}
