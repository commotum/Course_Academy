tion/math-academy-id "q-71653" :question/problem "$\\int 4\\operatorname{cos}y\\,\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{cos}y\\,\\text{d}y=\\operatorname{sin}y+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 4\\operatorname{cos}y\\,\\text{d}y & =4\\int \\operatorname{cos}y\\,\\text{d}y \\\\  & =4(\\operatorname{sin}y)+C \\\\  & =4\\operatorname{sin}y+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186234310 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea9f76a8-e76e-5423-a193-fa42c402c584" :question/math-academy-id "q-71654" :question/problem "$\\int (\\operatorname{sin}x+5\\operatorname{cos}x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}x\\,\\text{d}x & =-\\operatorname{cos}x+C, \\\\ \\int \\operatorname{cos}x\\,\\text{d}x & =\\operatorname{sin}x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sin}x+5\\operatorname{cos}x)\\,\\text{d}x & =\\int \\operatorname{sin}x\\,\\text{d}x+5\\int \\operatorname{cos}x\\,\\text{d}x \\\\  & =-\\operatorname{cos}x+5\\operatorname{sin}x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235435 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f74b2bd2-a95c-5b62-907c-ae6cda7b7089" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}x" :db/id #edb/ref 17592186234936}] :answer-field/correct {:answer/id #uuid "f74b2bd2-a95c-5b62-907c-ae6cda7b7089" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}x" :db/id #edb/ref 17592186234936} :answer-field/id #uuid "7e8b47e0-d44a-50a7-b006-cdcb0702528f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235129}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19dc50e5-0f97-5ac3-ba2b-ebf4a9bbf79f" :question/math-academy-id "q-167331" :question/problem "$\\int h(x)\\,\\text{d}x\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int h(x)\\,\\text{d}x & =\\int -4\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{cos}⁡x+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."} {:db/id #edb/ref 17592186235484 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e925cb33-a34c-536e-9ec6-fc4ac693e32a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}(x)" :db/id #edb/ref 17592186234915}] :answer-field/correct {:answer/id #uuid "e925cb33-a34c-536e-9ec6-fc4ac693e32a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{cos}(x)" :db/id #edb/ref 17592186234915} :answer-field/id #uuid "747ebec0-6972-5890-bd56-72dc24b81b4a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235103}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6da96d34-46d1-5bca-95e5-7bacca66a935" :question/math-academy-id "q-167785" :question/problem "$\\int h(x)\\,\\text{d}x\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡(x)\\,\\text{d}x=-\\operatorname{cos}⁡(x)+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int h(x)\\,\\text{d}x & =\\int -4\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =-4\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =-4(-\\operatorname{cos}⁡(x))+C \\\\  & =4\\operatorname{cos}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."} {:db/id #edb/ref 17592186250134 :knowledge-point/_questions [{:knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271c490c-5a05-5e0a-9c8e-cee6e93cd8b5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{6}cos⁡\\theta +C" :db/id #edb/ref 17592186247771} {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} {:answer/id #uuid "8369302d-e75e-5f17-a44e-47eda2ef57fa" :answer/type {:db/ident :answer.type/math} :answer/value "-6sin⁡\\theta +C" :db/id #edb/ref 17592186248585} {:answer/id #uuid "8f10e1a5-527b-5f97-860b-39eca916d8f7" :answer/type {:db/ident :answer.type/math} :answer/value "6sin⁡\\theta +C" :db/id #edb/ref 17592186248696} {:answer