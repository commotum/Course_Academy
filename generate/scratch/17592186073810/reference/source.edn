[[{:db/id 17592186073810 :knowledge-point/canonical-example {:db/id 17592186073434 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/id #uuid "2ce03c34-8e2c-5554-a129-1eaf05ad46fd" :question/math-academy-id "e-12548" :question/problem "Find the shortest distance between the point $(3,2)$ and the line $x=5.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/95/952be9b27e5350f755f0f534883f3c70516bb4e03b34e9448ab5d43950d4bad6.png)\n\nSince the line $x = 5$ is vertical, the shortest distance between this line and the point $(3,2)$ is given by the absolute value of the difference between $x$-coordinate of the point and $5.$ \n\nSo, the shortest distance is\n\n$$\nd = |3 - 5| = 2.\n$$"} :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/key-prerequisites [{:db/id 17592186049868}] :knowledge-point/questions [{:db/id 17592186074509 :knowledge-point/_questions [{:knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d480289e-ef90-5558-9b84-0a6729521a8a" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id 17592186073293} {:answer/id #uuid "d65625f4-d4bc-5a3b-9852-a97125babce7" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186073294} {:answer/id #uuid "24c69f7e-9252-5a26-9b11-a2946649c0e5" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id 17592186073295} {:answer/id #uuid "3668a275-650f-5dd2-bf9d-5272c70a2b2b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186073296} {:answer/id #uuid "517b7463-4de4-5169-8770-a72dd72837a3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id 17592186073297}