#{[{:db/id #edb/ref 17592186129123 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128880 :question/id #uuid "bfa446cd-c215-59c2-b84d-35d7897e9e34" :question/math-academy-id "e-15615" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-6$ and a maximum value of $8.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny = \\dfrac{y_{\\textrm{min}}+y_{\\textrm{max}}}{2},\n$$\n\nwhere $y_{\\textrm{min}}$ and $y_{\\textrm{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-6+8}{2} \\\\  & =\\frac{2}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the midline is $y=1.$"} :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050533}] :knowledge-point/question-generator {:db/id #edb/ref 17592186528295 :question-generator/id #uuid "9623a13b-4578-5bf9-b125-66c10695906a" :question-generator/script "generate/scratch/17592186129123.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186129561 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4da8725-8550-5cf7-8104-83fb6f684917" :answer/type {:db/ident :answer.type/math} :answer/value "y =-4" :db/id #edb/ref 17592186126844} {:answer/id #uuid "f94a10a6-5ab7-569e-8472-996b9cbd50c2" :answer/type {:db/ident :answer.type/math} :answer/value "y =-9" :db/id #edb/ref 17592186126845} {:answer/id #uuid "10dbf042-1fb5-5a2a-9c60-88dc1897734a" :answer/type {:db/ident :answer.type/math} :answer/value "y = 1" :db/id #edb/ref 17592186126846} {:answer/id #uuid "2a9ea6b3-85d6-5c26-8e00-91d959c6ea53" :answer/type {:db/ident :answer.type/math} :answer/value "y = 5" :db/id #edb/ref