#{[{:db/id #edb/ref 17592186133876 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133692 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/id #uuid "78e7cbb2-d207-5d5e-bf46-5c3b2686933f" :question/math-academy-id "e-8740" :question/problem "Consider the vector field $\\mathbf{F}=\\ln(2x+y)\\,\\mathbf{i}+ x^2e^{3y}\\,\\mathbf{j}.$ \nEvaluate $\\nabla \\cdot\\mathbf{F}$ at the point $(1,0).$" :question/worked-solution "If $\\mathbf{F}=P\\,\\mathbf{i}+Q\\,\\mathbf{j}$ is a vector field on $\\mathbb{R}^2$ and the partial derivatives of the components of $\\mathbf F$ all exist, then the divergence of $\\mathbf F$ is the scalar field given by\n\n$$\n\\nabla\\cdot\\mathbf{F}=\\textrm{div}\\,\\mathbf F=\\dfrac{\\partial P}{\\partial x}+\\dfrac{\\partial Q}{\\partial y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(2x+y))+\\frac{∂}{∂y}({x}^{2}{e}^{3y}) \\\\  & =\\frac{2}{2x+y}+3{x}^{2}{e}^{3y}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\textrm{div}\\,\\mathbf {F}$ at the point $(1,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(1,0) & =\\frac{2}{2(1)+0}+3(1)^{2}{e}^{3(0)} \\\\  & =1+3 \\\\  & =4.\\end{aligned}\n$$"} :knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048707} {:db/id #edb/ref 17592186048954}] :knowledge-point/question-generator {:db/id #edb/ref 17592186519771 :question-generator/id #uuid "2e445ab7-30bf-5bdd-8d92-9b7e60bb6006" :question-generator/script "generate/scratch/17592186133876.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186134066 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8d1e28e-5112-59c3-b028-1c974391ce13" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186130553} {:answer/id #uuid "ea0afd35-d0b9-5121-8868-93f155cf991e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186130554} {:answer/id #uuid "3d0d2587-d570-5521-a8be-6d6e03efbaa1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186130555} {:answer/id #uuid "53a7d265-98f2-5172-b447-4723f569dfa8" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186130556} {:answer/id #uuid "773479c1-d247-55ed-8fde-2e38ee1a00fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186130557}] :answer-field/id #uuid "2563952c-5ef7-53f3-b596-8bb6bcf0a4ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130552}] :question/id #uuid "68ce4c5f-1400-5d63-8353-a17b8fdc5ee9" :question/math-academy-id "q-105561" :question/problem "Consider the vector field $F = (e^{x}\\cos x)i + xe^{xy}j$.\nEvaluate $∇ \\cdot F$ at the point $(0, 1)$."} {:db/id #edb/ref 17592186134368 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07df9b30-7494-5a29-bbf7-545bfb801b62" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}+2{y}^{2}" :db/id #edb/ref 17592186324043} {:answer/id #uuid "43c82af1-e249-5406-8916-4edf2249835d" :answer/type {:db/ident :answer.type/math} :answer/value "4xy\\,i+8xy\\,j" :db/id #edb/ref 17592186324517} {:answer/id #uuid "46fbffe9-1708-536c-9450-fbf68226d2c0" :answer/type {:db/ident :answer.type/math} :answer/value "8xy" :db/id #edb/ref 17592186324544} {:answer/id #uuid "4c0d70f3-b9ef-52d9-833f-60c57b0ef2ea" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+4{y}^{2}" :db/id #edb/ref 17592186324594} {:answer/id #uuid "5ed01203-bd0d-5479-858a-f2f7671e56d4" :answer/type {:db/ident :answer.type/math} :answer/value "2{y}^{2}\\,i+4{x}^{2}\\,j" :db/id #edb/ref 17592186324762}] :answer-field/correct {:answer/id #uuid "07df9b30-7494-5a29-bbf7-545bfb801b62" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}^{2}+2{y}^{2}" :db/id #edb/ref 17592186324043} :answer-field/id #uuid "6a071631-1415-51cd-b3f7-53b385114597" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8381fb3-8431-5be5-b51b-a5d43ddf8c5f" :question/math-academy-id "q-41817" :question/problem "Given that $F=2x{y}^{2}\\,i+4{x}^{2}y\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(2x{y}^{2})+\\frac{∂}{∂y}(4{x}^{2}y) \\\\  & =2{y}^{2}+4{x}^{2} \\\\  & =4{x}^{2}+2{y}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235522 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7acc639f-801d-5826-92a1-6c80318d504e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186234734}] :answer-field/correct {:answer/id #uuid "7acc639f-801d-5826-92a1-6c80318d504e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186234734} :answer-field/id #uuid "fc6a645b-1da7-5cff-903f-cbe14bf3b0af" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235276}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00bc9b45-dbe4-5490-9350-bc28715ad92a" :question/math-academy-id "q-168113" :question/problem "The divergence $\\text{div}\\,V$ of the velocity field represents the scalar rate of expansion of the fluid per unit of area at a given point. Find the corresponding expansion rate at the point $(1,1).$\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        The required rate of expansion is $\\text{div}\\,V\\,{|}_{(1,\\,1)}=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "If $V=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $V$ all exist, then the divergence of $V$ is given by\n\n$$\n∇\\cdot V=\\text{div}\\,V=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{div}\\,V & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}({x}^{2}y)+\\frac{∂}{∂y}(2xy) \\\\  & =2xy+2x.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,V$ at the point $(1,1),$ and obtain\n\n$$\n\\begin{aligned}\\text{div}\\,V\\,{|}_{(1,\\,1)} & =2(1)(1)+2(1) \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186235529 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9930180-22d7-53b0-abba-b10baf047771" :answer/type {:db/ident :answer.type/math} :answer/value "6xy" :db/id #edb/ref 17592186234862}] :answer-field/correct {:answer/id #uuid "c9930180-22d7-53b0-abba-b10baf047771" :answer/type {:db/ident :answer.type/math} :answer/value "6xy" :db/id #edb/ref 17592186234862} :answer-field/id #uuid "744d8ba8-3ff0-5c8f-8a13-ca26a7c9ad9f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186235102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "56bffa92-10bd-58ab-b621-c50b06519fae" :question/math-academy-id "q-168601" :question/problem "$\\text{div}\\,F=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nIn part 1, we found that $a=1.$ So, \n\n$$\nF(x,y)=({y}^{3}-1)\\,i+(3x{y}^{2}+1)\\,j.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}({y}^{3}-1)+\\frac{∂}{∂y}(3x{y}^{2}+1) \\\\  & =0+6xy \\\\  & =6xy.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186241078 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b0b80fa-496f-569a-9899-ee3fbf9e50a3" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡x\\,i-2{x}^{2}\\operatorname{sin}⁡y\\,j" :db/id #edb/ref 17592186238702} {:answer/id #uuid "82fba072-abfd-5d9f-a6f8-d005dbba793d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-2\\operatorname{sin}⁡y" :db/id #edb/ref 17592186239196} {:answer/id #uuid "a289a29e-002e-5ce1-832a-10dd82584b3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x\\,i+2x{cos}^{2}⁡y\\,j" :db/id #edb/ref 17592186239467} {:answer/id #uuid "b33afbcd-dddc-52bd-b80a-39711f698a91" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡x-2{x}^{2}\\operatorname{cos}⁡y\\operatorname{sin}⁡y" :db/id #edb/ref 17592186239618} {:answer/id #uuid "b3995c52-98a6-533d-a3a3-c2e12da1579b" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡x+2x{cos}^{2}⁡y" :db/id #edb/ref 17592186239621}] :answer-field/correct {:answer/id #uuid "b33afbcd-dddc-52bd-b80a-39711f698a91" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{cos}⁡x-2{x}^{2}\\operatorname{cos}⁡y\\operatorname{sin}⁡y" :db/id #edb/ref 17592186239618} :answer-field/id #uuid "76e1c659-7566-5775-b915-e264f8844bd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240546}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ed9b106-fbec-5b47-bde6-fc871e3c0688" :question/math-academy-id "q-105554" :question/problem "Given that $F=y\\operatorname{sin}⁡x\\,i+{x}^{2}{cos}^{2}⁡y\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(y\\operatorname{sin}⁡x)+\\frac{∂}{∂y}({x}^{2}{cos}^{2}⁡y) \\\\  & =y\\operatorname{cos}⁡x-2{x}^{2}\\operatorname{cos}⁡y\\operatorname{sin}⁡y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259485 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "422204c9-b7b4-55a6-916b-a5d0d3407fa5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186257369} {:answer/id #uuid "a2804747-2634-5527-96bb-b3c58af23dad" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186258205} {:answer/id #uuid "d3206e56-97e9-5861-9e65-b3b49d2e3d33" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186258627} {:answer/id #uuid "dc0f3193-274a-5d65-b2b8-1f83dbd28580" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186258697} {:answer/id #uuid "e098e2ca-3d83-57a6-9dae-855c6bff075f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258737}] :answer-field/correct {:answer/id #uuid "e098e2ca-3d83-57a6-9dae-855c6bff075f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258737} :answer-field/id #uuid "097f1726-9179-5df6-b366-af2e18265183" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d33d1de-f1c3-54d6-8864-08f78b7ba6b7" :question/math-academy-id "q-123173" :question/problem "Consider the vector field $F=({e}^{x}\\operatorname{sin}⁡y)\\,i-({e}^{x}\\operatorname{cos}⁡y)\\,j.$ \nEvaluate $∇\\cdot F$ at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}({e}^{x}\\operatorname{sin}⁡y)+\\frac{∂}{∂y}(-{e}^{x}\\operatorname{cos}⁡y) \\\\  & ={e}^{x}\\operatorname{sin}⁡y-{e}^{x}(-\\operatorname{sin}⁡y). \\\\  & =2{e}^{x}\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point  $(0,\\frac{\\pi }{2}),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(0,\\frac{\\pi }{2}) & =2{e}^{0}\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =2\\cdot 1\\cdot 1 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266054 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd8b6ef-b59f-51f2-a593-a74e3c5113e5" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-{x}^{2}" :db/id #edb/ref 17592186263402} {:answer/id #uuid "566e4c61-c6d3-532c-a17e-0ce406ccd91a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186263746} {:answer/id #uuid "8b9f983d-c07a-58f0-b650-0ac5793162ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186264195} {:answer/id #uuid "a115c9cc-944a-5313-be2c-6a6b818c3703" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4xy}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186264372} {:answer/id #uuid "f0e44d7e-08de-533f-9742-7ba0cc548074" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-{y}^{2}}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186265114}] :answer-field/correct {:answer/id #uuid "8b9f983d-c07a-58f0-b650-0ac5793162ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/id #edb/ref 17592186264195} :answer-field/id #uuid "bfcc4b11-5a7e-59a3-82ae-a2381a5b8490" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265581}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a1d77cd-7e5d-55c7-ad70-6eac8546452e" :question/math-academy-id "q-131170" :question/problem "Given that $F=\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\frac{y}{{x}^{2}+{y}^{2}})+\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}}-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}} \\\\  & =-\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186266055 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12e1d86b-777c-5d78-8129-3e3154b25d8b" :answer/type {:db/ident :answer.type/math} :answer/value "x(y+1)" :db/id #edb/ref 17592186263179} {:answer/id #uuid "5eb1e4c7-5972-54da-b483-2639d96f6b78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+xy}{x}" :db/id #edb/ref 17592186263820} {:answer/id #uuid "655a10c4-f044-53a0-88f5-bbde9a25a28b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+{x}^{2}}{x}" :db/id #edb/ref 17592186263877} {:answer/id #uuid "97d78aa6-ea0d-5f24-a13e-67b22e7ea07b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{xy}" :db/id #edb/ref 17592186264305} {:answer/id #uuid "cdf68194-67fc-5a2b-9be9-bb9678d7eccd" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186264801}] :answer-field/correct {:answer/id #uuid "655a10c4-f044-53a0-88f5-bbde9a25a28b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+{x}^{2}}{x}" :db/id #edb/ref 17592186263877} :answer-field/id #uuid "9988210a-6613-557d-bea5-63cfe299e821" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265521}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14aba214-1cfb-5361-bc32-3c785d7a027e" :question/math-academy-id "q-131171" :question/problem "Given that $F=\\operatorname{ln}⁡(xy)\\,i+xy\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))+\\frac{∂}{∂y}(xy) \\\\  & =\\frac{1}{x}+x \\\\  & =\\frac{1+{x}^{2}}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186362533 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6f39474-a71d-5b92-bb95-057f421dbaa3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362535}] :answer-field/correct {:answer/id #uuid "d6f39474-a71d-5b92-bb95-057f421dbaa3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362535} :answer-field/id #uuid "70813cd7-ac85-5b7a-93e7-231b03c0abe9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186362534}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a60d2ff-f3ca-50d0-ba00-1dd849742b3e" :question/math-academy-id "q-169201" :question/problem "$\\text{div}\\,F\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(3x{y}^{2})+\\frac{∂}{∂y}(-{y}^{3}) \\\\  & =3{y}^{2}+(-3{y}^{2}) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383034 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2a14eda-ccab-5f7f-a719-20929206c183" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186383036} {:answer/id #uuid "7f5fbc0f-62fd-51ae-9453-284b6e551213" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186383037} {:answer/id #uuid "a64f1af0-be8c-5a44-a9cc-2fba5bb44234" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186383038} {:answer/id #uuid "78cbd39b-453a-54ac-94ad-3b0b9c0fae93" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186383039} {:answer/id #uuid "2a33efaf-3611-56e4-a949-ec2d696d451d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186383040}] :answer-field/correct {:answer/id #uuid "2a33efaf-3611-56e4-a949-ec2d696d451d" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186383040} :answer-field/id #uuid "a90f1f2e-6bea-5afb-916e-20d455797ede" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383035}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ef0a7a3-f12b-51cf-8356-485327cebc47" :question/math-academy-id "q-123175" :question/problem "Consider the vector field $F=\\operatorname{ln}⁡(x+y)\\,i+\\operatorname{ln}⁡(x-y)\\,j.$ \nEvaluate $∇\\cdot F$ at the point $(0,-1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives  of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y))+\\frac{∂}{∂y}(\\operatorname{ln}⁡(x-y)) \\\\  & =\\frac{1}{x+y}+\\frac{(-1)}{x-y} \\\\  & =-\\frac{2y}{{x}^{2}-{y}^{2}}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(0,-1),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(0,-1) & =-\\frac{2(-1)}{{0}^{2}-(-1)^{2}} \\\\  & =-\\frac{(-2)}{(-1)} \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383244 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63333efd-d822-5e6a-8874-2684764a6d34" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186383246} {:answer/id #uuid "4a7079b8-ca98-5f78-a0b6-63d45fdc3398" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186383247} {:answer/id #uuid "b10571cd-8ad7-5a71-9cc7-86e1745517db" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186383248} {:answer/id #uuid "d598bc98-2e8d-5dd9-8b10-90cffd05991d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186383249} {:answer/id #uuid "3e6fa43e-0e0d-55cd-ba9c-8dc1b7762999" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186383250}] :answer-field/correct {:answer/id #uuid "63333efd-d822-5e6a-8874-2684764a6d34" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186383246} :answer-field/id #uuid "047c58de-3cf8-57f5-9db0-76ef729a4311" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383245}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c49fed94-087c-5bc2-a0ce-0e5ce4848c8e" :question/math-academy-id "q-131173" :question/problem "Consider the vector field $F=x{e}^{y}\\,i+xy{e}^{y}\\,j.$ \nEvaluate $∇\\cdot F$ at the point $(2,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(x{e}^{y})+\\frac{∂}{∂y}(xy{e}^{y}) \\\\  & ={e}^{y}+x{e}^{y}+xy{e}^{y}. \\\\  & =(1+x+xy){e}^{y}\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(2,0) & =(1+2+2(0)){e}^{0} \\\\  & =3{e}^{0} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186383251 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86fc3b2f-e528-5aa6-b7af-f6ac8563fdab" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186383253} {:answer/id #uuid "e54145e9-4574-5349-ab5f-74b95bdfc80e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186383254} {:answer/id #uuid "c500d2b6-da10-5778-a6c4-74d2a9185191" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186383255} {:answer/id #uuid "0fe21f00-818c-554f-8500-ea894f1c8d6c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186383256} {:answer/id #uuid "945ed3b6-1c5c-5567-b83c-3afdc324a0d6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186383257}] :answer-field/correct {:answer/id #uuid "0fe21f00-818c-554f-8500-ea894f1c8d6c" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186383256} :answer-field/id #uuid "4feb22a8-b9e6-59d8-a756-c12f2d26d5cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383252}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59443564-6ec5-5ec7-a934-99dc847cb69c" :question/math-academy-id "q-131174" :question/problem "Consider the vector field $F=x\\sqrt{{x}^{2}+{y}^{2}}\\,i+y\\sqrt{{x}^{2}+{y}^{2}}\\,j.$ \nEvaluate $∇\\cdot F$ at the point $(3,4).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(x\\sqrt{{x}^{2}+{y}^{2}})+\\frac{∂}{∂y}(y\\sqrt{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{2{x}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}+\\frac{{x}^{2}+2{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{3{x}^{2}+3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =3\\sqrt{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(3,4),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(3,4) & =3\\sqrt{{3}^{2}+{4}^{2}} \\\\  & =3\\sqrt{9+16} \\\\  & =3\\sqrt{25} \\\\  & =15.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186424226 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21305c88-eeaf-5820-af29-34723d616234" :answer/type {:db/ident :answer.type/math} :answer/value "(x-y)\\sqrt{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186424199} {:answer/id #uuid "507360f0-f40d-51b4-8d0a-a73fd33bb756" :answer/type {:db/ident :answer.type/math} :answer/value "(x+y)\\sqrt{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186424205} {:answer/id #uuid "754db6a7-5db4-5e7b-9b14-ca330f6671e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+y}{\\sqrt{{x}^{2}+{y}^{2}}}" :db/id #edb/ref 17592186424210} {:answer/id #uuid "88c4b453-3bda-58b8-8fbb-6a0d6916e90a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-y}{\\sqrt{{x}^{2}+{y}^{2}}}" :db/id #edb/ref 17592186424211} {:answer/id #uuid "952b9fe9-4b9b-5eac-bcfa-e800b3b1094b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x-2y}{{x}^{2}+{y}^{2}}" :db/id #edb/ref 17592186424213}] :answer-field/correct {:answer/id #uuid "88c4b453-3bda-58b8-8fbb-6a0d6916e90a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-y}{\\sqrt{{x}^{2}+{y}^{2}}}" :db/id #edb/ref 17592186424211} :answer-field/id #uuid "fadbbb52-eaa9-5960-9164-0e7ea16514af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424225}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "162e9632-ec96-53eb-bf5e-ab2bd97ae9e0" :question/math-academy-id "q-123172" :question/problem "Given that $F=\\sqrt{{x}^{2}+{y}^{2}}\\,i-\\sqrt{{x}^{2}+{y}^{2}}\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}+{y}^{2}})+\\frac{∂}{∂y}(-\\sqrt{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}-\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{x-y}{\\sqrt{{x}^{2}+{y}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186424229 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5b1d09-1da1-519d-9990-fff8f06520f0" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\pi " :db/id #edb/ref 17592186424196} {:answer/id #uuid "2181d067-a072-5d02-8afa-0c943d7e22d4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186424200} {:answer/id #uuid "55a8bdef-6d67-5f62-8f8a-3f474c61f4a6" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{1}{\\pi }" :db/id #edb/ref 17592186424208} {:answer/id #uuid "af6e0ce3-9249-535e-9fb2-893259204ce1" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\pi " :db/id #edb/ref 17592186424214} {:answer/id #uuid "b75001d5-d554-5e4b-9dfe-3ece61afe366" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186424216}] :answer-field/correct {:answer/id #uuid "af6e0ce3-9249-535e-9fb2-893259204ce1" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\pi " :db/id #edb/ref 17592186424214} :answer-field/id #uuid "6e9bf416-fabf-5d02-bf76-781ab322815f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424222}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca50a185-e281-53e0-900c-05cc2ac6e7a5" :question/math-academy-id "q-105562" :question/problem "Consider the vector field $F={y}^{2}\\operatorname{sin}⁡(2x)\\,i+x\\operatorname{ln}⁡y\\,j.$ \nEvaluate $\\text{div}\\,F$ at the point $(\\pi ,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}({y}^{2}\\operatorname{sin}⁡(2x))+\\frac{∂}{∂y}(x\\operatorname{ln}⁡y) \\\\  & =2{y}^{2}\\operatorname{cos}⁡(2x)+\\frac{x}{y}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(\\pi ,1),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(\\pi ,1) & =2(1)^{2}\\operatorname{cos}⁡(2\\pi )+\\frac{\\pi }{1} \\\\  & =2(1)(1)+\\pi  \\\\  & =2+\\pi .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186519739 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eabca83-d18a-5405-a6c6-f497cd12ba15" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186519740} {:answer/id #uuid "69bdaec0-113c-5f67-a3b2-6bf2fec56c87" :answer/type {:db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186519746} {:answer/id #uuid "7a569ec5-a696-5d26-b706-23b4f0dc0b7e" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186519750} {:answer/id #uuid "7bcf88a3-df95-57b0-b822-5265e494325f" :answer/type {:db/ident :answer.type/math} :answer/value "-128" :db/id #edb/ref 17592186519752} {:answer/id #uuid "a3b1cbca-9a29-5208-8d71-1cb73e2a2f48" :answer/type {:db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186519757}] :answer-field/correct {:answer/id #uuid "69bdaec0-113c-5f67-a3b2-6bf2fec56c87" :answer/type {:db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186519746} :answer-field/id #uuid "2bacee1a-6cc4-552c-a4f4-a0fab52d47ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519735}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3824a288-14f7-50ee-b550-8febd725cc36" :question/problem "Consider the vector field $F=\\left(\\left(3 x + 2 y\\right)^{2}\\right)\\,i+\\left(\\left(3 x + 4 y\\right)^{2}\\right)\\,j.$ \nEvaluate $\\nabla\\cdot F$ at the point $(2,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=\\nabla\\cdot F=\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y}.\n$$\n\nWhen differentiating $P$ with respect to $x$, hold $y$ constant; when differentiating $Q$ with respect to $y$, hold $x$ constant.\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\nabla\\cdot F & =\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y} \\\\  & =\\frac{\\partial}{\\partial x}(\\left(3 x + 2 y\\right)^{2})+\\frac{\\partial}{\\partial y}(\\left(3 x + 4 y\\right)^{2}) \\\\  & =18 x + 12 y+\\left(24 x + 32 y\\right) \\\\  & =2 \\left(21 x + 22 y\\right).\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,1),$ and obtain\n\n$$\n\\begin{aligned}(\\nabla\\cdot F)(2,1) & =44 (1) + 42 (2) \\\\ & =48+\\left(80\\right) \\\\ & =128.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186519742 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8a6022-efb7-5115-88bb-57337d6e4eda" :answer/type {:db/ident :answer.type/math} :answer/value "186" :db/id #edb/ref 17592186519734} {:answer/id #uuid "430695f4-dc5a-53b0-9146-849d0305d94e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186519741} {:answer/id #uuid "ac9f0e06-8911-511e-9c02-735b11db671c" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186519758} {:answer/id #uuid "d43f4cc6-d224-5cf6-af6b-e7e47c04208c" :answer/type {:db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186519768} {:answer/id #uuid "fe8913ba-f1ef-54f0-930d-e0d7c7ed078a" :answer/type {:db/ident :answer.type/math} :answer/value "-126" :db/id #edb/ref 17592186519770}] :answer-field/correct {:answer/id #uuid "d43f4cc6-d224-5cf6-af6b-e7e47c04208c" :answer/type {:db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186519768} :answer-field/id #uuid "d0ed5189-349f-5ae2-9bec-beaf51162359" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519767}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "479cee1b-5500-5cd2-ad8c-021a17042587" :question/problem "Consider the vector field $F=\\left(\\left(3 x + 4 y\\right)^{2}\\right)\\,i+\\left(\\left(4 x + 3 y\\right)^{2}\\right)\\,j.$ \nEvaluate $\\nabla\\cdot F$ at the point $(2,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=\\nabla\\cdot F=\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y}.\n$$\n\nWhen differentiating $P$ with respect to $x$, hold $y$ constant; when differentiating $Q$ with respect to $y$, hold $x$ constant.\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\nabla\\cdot F & =\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y} \\\\  & =\\frac{\\partial}{\\partial x}(\\left(3 x + 4 y\\right)^{2})+\\frac{\\partial}{\\partial y}(\\left(4 x + 3 y\\right)^{2}) \\\\  & =18 x + 24 y+\\left(24 x + 18 y\\right) \\\\  & =42 \\left(x + y\\right).\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,1),$ and obtain\n\n$$\n\\begin{aligned}(\\nabla\\cdot F)(2,1) & =42 (1) + 42 (2) \\\\ & =60+\\left(66\\right) \\\\ & =126.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186519747 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e55554-e197-5f70-be8c-57881ebe28e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{73}{2}" :db/id #edb/ref 17592186519730} {:answer/id #uuid "11a14153-868e-557f-9e7e-a963a2420b97" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{73}{2}" :db/id #edb/ref 17592186519732} {:answer/id #uuid "675a4586-bc07-5a8e-a9c6-d9654edb99b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186519745} {:answer/id #uuid "8ff0bf56-f2aa-5cad-873f-81a3ab632ebf" :answer/type {:db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186519753} {:answer/id #uuid "e4e215ca-8076-5b63-89d2-0b7ccc3a5112" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{71}{2}" :db/id #edb/ref 17592186519769}] :answer-field/correct {:answer/id #uuid "01e55554-e197-5f70-be8c-57881ebe28e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{73}{2}" :db/id #edb/ref 17592186519730} :answer-field/id #uuid "b5d1f39b-26c1-5d7f-a544-4f6a511c0717" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519761}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "71332596-10b4-5473-a699-991346f64d01" :question/problem "Consider the vector field $F=\\left(\\ln{\\left(3 x + y \\right)}\\right)\\,i+\\left(3 x^{2} e^{3 y}\\right)\\,j.$ \nEvaluate $\\nabla\\cdot F$ at the point $(2,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=\\nabla\\cdot F=\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y}.\n$$\n\nWhen differentiating $P$ with respect to $x$, hold $y$ constant; when differentiating $Q$ with respect to $y$, hold $x$ constant.\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\nabla\\cdot F & =\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y} \\\\  & =\\frac{\\partial}{\\partial x}(\\ln{\\left(3 x + y \\right)})+\\frac{\\partial}{\\partial y}(3 x^{2} e^{3 y}) \\\\  & =\\frac{3}{3 x + y}+\\left(9 x^{2} e^{3 y}\\right) \\\\  & =\\frac{3 \\left(9 x^{3} e^{3 y} + 3 x^{2} y e^{3 y} + 1\\right)}{3 x + y}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,0),$ and obtain\n\n$$\n\\begin{aligned}(\\nabla\\cdot F)(2,0) & =\\frac{3 \\left(3 (0) (2)^{2} e^{3 (0)} + 9 (2)^{3} e^{3 (0)} + 1\\right)}{(0) + 3 (2)} \\\\ & =\\frac{1}{2}+\\left(36\\right) \\\\ & =\\frac{73}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186519751 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01282e04-9f20-5ce1-b4e5-ca694fd92ab4" :answer/type {:db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186519729} {:answer/id #uuid "071fc85e-b7ec-5343-9b00-518cdab61fb0" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186519731} {:answer/id #uuid "502b73fb-c85e-530b-b012-c7169375e747" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186519743} {:answer/id #uuid "635b253f-5fcb-5ba4-9a33-1388e6f473f9" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186519744} {:answer/id #uuid "7430b7b6-9ff9-5f42-804a-ff990dfb7f5e" :answer/type {:db/ident :answer.type/math} :answer/value "138" :db/id #edb/ref 17592186519749}] :answer-field/correct {:answer/id #uuid "071fc85e-b7ec-5343-9b00-518cdab61fb0" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186519731} :answer-field/id #uuid "328fe164-3ff3-5e5e-b76d-41619193d616" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519738}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7b8c58a8-631b-5f56-81d9-dd2355b91a3c" :question/problem "Consider the vector field $F=\\left(\\left(3 x + 2 y\\right)^{2}\\right)\\,i+\\left(\\left(2 x + 3 y\\right)^{2}\\right)\\,j.$ \nEvaluate $\\nabla\\cdot F$ at the point $(2,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=\\nabla\\cdot F=\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y}.\n$$\n\nWhen differentiating $P$ with respect to $x$, hold $y$ constant; when differentiating $Q$ with respect to $y$, hold $x$ constant.\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\nabla\\cdot F & =\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y} \\\\  & =\\frac{\\partial}{\\partial x}(\\left(3 x + 2 y\\right)^{2})+\\frac{\\partial}{\\partial y}(\\left(2 x + 3 y\\right)^{2}) \\\\  & =18 x + 12 y+\\left(12 x + 18 y\\right) \\\\  & =30 \\left(x + y\\right).\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,1),$ and obtain\n\n$$\n\\begin{aligned}(\\nabla\\cdot F)(2,1) & =30 (1) + 30 (2) \\\\ & =48+\\left(42\\right) \\\\ & =90.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186519754 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1be3be8e-6d9b-5c17-92a8-bd2de1598e04" :answer/type {:db/ident :answer.type/math} :answer/value "152" :db/id #edb/ref 17592186519733} {:answer/id #uuid "303c1efb-11a4-5345-86f6-a486861e8209" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186519737} {:answer/id #uuid "bb1af92f-76e8-5a22-99e6-90cd7abd1056" :answer/type {:db/ident :answer.type/math} :answer/value "224" :db/id #edb/ref 17592186519762} {:answer/id #uuid "bec92d70-cf32-5e22-ae2e-a02cd8bf6559" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186519763} {:answer/id #uuid "bf6ee38f-b9e3-54d6-a344-8f5ee7086794" :answer/type {:db/ident :answer.type/math} :answer/value "-152" :db/id #edb/ref 17592186519764}] :answer-field/correct {:answer/id #uuid "1be3be8e-6d9b-5c17-92a8-bd2de1598e04" :answer/type {:db/ident :answer.type/math} :answer/value "152" :db/id #edb/ref 17592186519733} :answer-field/id #uuid "ca1f744b-0571-5f1c-9cbd-a75475e65e6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519766}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9828b186-b4ee-5f2e-84cc-caeea0434078" :question/problem "Consider the vector field $F=\\left(\\left(4 x + y\\right)^{2}\\right)\\,i+\\left(\\left(3 x + 4 y\\right)^{2}\\right)\\,j.$ \nEvaluate $\\nabla\\cdot F$ at the point $(2,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=\\nabla\\cdot F=\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y}.\n$$\n\nWhen differentiating $P$ with respect to $x$, hold $y$ constant; when differentiating $Q$ with respect to $y$, hold $x$ constant.\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\nabla\\cdot F & =\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y} \\\\  & =\\frac{\\partial}{\\partial x}(\\left(4 x + y\\right)^{2})+\\frac{\\partial}{\\partial y}(\\left(3 x + 4 y\\right)^{2}) \\\\  & =32 x + 8 y+\\left(24 x + 32 y\\right) \\\\  & =8 \\left(7 x + 5 y\\right).\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(2,1),$ and obtain\n\n$$\n\\begin{aligned}(\\nabla\\cdot F)(2,1) & =40 (1) + 56 (2) \\\\ & =72+\\left(80\\right) \\\\ & =152.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186519760 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd" :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71941b2e-6492-57b3-9f15-2ea08ef07538" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186519748} {:answer/id #uuid "98de73de-134d-534b-abc3-ac5f77866e97" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186519755} {:answer/id #uuid "a1f39197-e7b1-5769-b28c-870aa6abc063" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186519756} {:answer/id #uuid "ae9a6ca6-8dbd-553d-aac4-d168e560858b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186519759} {:answer/id #uuid "c20e4615-a0de-539b-8d9d-86666c3a6a40" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186519765}] :answer-field/correct {:answer/id #uuid "71941b2e-6492-57b3-9f15-2ea08ef07538" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186519748} :answer-field/id #uuid "2ca3c765-a8cc-5f28-93ee-3d5fd340c30b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186519736}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b21cce72-05b1-50b1-986f-ae9d83039518" :question/problem "Consider the vector field $F=\\left(2 \\ln{\\left(x + y \\right)}\\right)\\,i+\\left(3 \\ln{\\left(x - y \\right)}\\right)\\,j.$ \nEvaluate $\\nabla\\cdot F$ at the point $(3,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=\\nabla\\cdot F=\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y}.\n$$\n\nWhen differentiating $P$ with respect to $x$, hold $y$ constant; when differentiating $Q$ with respect to $y$, hold $x$ constant.\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\nabla\\cdot F & =\\frac{\\partial P}{\\partial x}+\\frac{\\partial Q}{\\partial y} \\\\  & =\\frac{\\partial}{\\partial x}(2 \\ln{\\left(x + y \\right)})+\\frac{\\partial}{\\partial y}(3 \\ln{\\left(x - y \\right)}) \\\\  & =\\frac{2}{x + y}+\\left(- \\frac{3}{x - y}\\right) \\\\  & =- \\frac{x + 5 y}{\\left(x - y\\right) \\left(x + y\\right)}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(3,1),$ and obtain\n\n$$\n\\begin{aligned}(\\nabla\\cdot F)(3,1) & =- \\frac{5 (1) + (3)}{\\left(- (1) + (3)\\right) \\left((1) + (3)\\right)} \\\\ & =\\frac{1}{2}+\\left(- \\frac{3}{2}\\right) \\\\ & =-1.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Divergence of a Vector Field in Two Dimensions"}]}
