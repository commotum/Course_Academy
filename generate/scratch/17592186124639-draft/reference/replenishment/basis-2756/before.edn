ferentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y+xy) \\\\  & =\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y)+\\frac{∂}{∂x}(xy) \\\\  & =\\operatorname{sin}⁡y\\cdot \\frac{∂}{∂x}({x}^{2})+y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\operatorname{sin}⁡y\\cdot (2x)+y\\cdot (1) \\\\  & =2x\\operatorname{sin}⁡y+y\\end{aligned}\n$$"} {:db/id 17592186278239 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id 17592186275720} {:answer/id #uuid "48d4574b-09ae-5cd7-8667-6addc311e93c" :answer/type {:db/ident :answer.type/math} :answer/value "xy+\\frac{{x}^{2}}{y}" :db/id 17592186276125} {:answer/id #uuid "5524be5e-28f5-5433-a5d3-d73957b779a9" :answer/type {:db/ident :answer.type/math} :answer/value "x+{x}^{2}\\operatorname{ln}⁡y" :db/id 17592186276234} {:answer/id #uuid "60ced972-1fd7-5d9e-89b4-5b1ed89abe9f" :answer/type {:db/ident :answer.type/math} :answer/value "y+2x\\operatorname{ln}⁡y" :db/id 17592186276347} {:answer/id #uuid "c6e6df92-0fe0-52bf-ad68-64d6651fef07" :answer/type {:db/ident :answer.type/math} :answer/value "y+\\frac{2x}{y}" :db/id 17592186277246}] :answer-field/correct {:answer/id #uuid "19f6c148-0885-5d60-9101-a64f4e2c0577" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{{x}^{2}}{y}" :db/id 17592186275720} :answer-field/id #uuid "9501b870-d0cb-5b61-aa64-68a74b0b08a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186277990}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c020eea-053d-5f14-b5a2-c9f697a99828" :question/math-academy-id "q-159613" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=xy+{x}^{2}\\operatorname{ln}⁡y.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =\\frac{∂}{∂y}(xy)+\\frac{∂}{∂y}({x}^{2}\\operatorname{ln}⁡y) \\\\  & =x\\cdot \\frac{∂}{∂y}(y)+{x}^{2}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y) \\\\  & =x\\cdot 1+{x}^{2}\\cdot \\frac{1}{y} \\\\  & =x+\\frac{{x}^{2}}{y}\\end{aligned}\n$$"} {:db/id 17592186278240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb6e91c-e353-5113-a18f-0395e4a6e343" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{y}^{2}}+\\frac{2}{{x}^{3}}" :db/id 17592186276032} {:answer/id #uuid "4118aa52-6cf2-5999-9929-8a5819037289" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{y}+\\frac{2y}{{x}^{3}}" :db/id 17592186276047} {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id 17592186276416} {:answer/id #uuid "ebaecd0a-b971-5e92-b62d-28ceae190dc8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{x}{{y}^{2}}-\\frac{1}{{x}^{2}}" :db/id 17592186277539} {:answer/id #uuid "f0a09a6f-356b-5b97-85dc-4fbfa42ac95a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}-\\frac{y}{{x}^{2}}" :db/id 17592186277589}] :answer-field/correct {:answer/id #uuid "68a80167-5ca4-5b8a-9c46-29004434201b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/id 17592186276416} :answer-field/id #uuid "e473ea39-99a3-5f5a-9eb6-13ee0b150617" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186278125}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "198d06c9-ec80-5c14-815c-c9ec68f7a2d2" :question/math-academy-id "q-159616" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=\\frac{x}{y}-\\frac{y}{{x}^{2}}.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the constant multiple rule for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y}-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{y})-\\frac{∂}{∂x}(\\frac{y}{{x}^{2}}) \\\\  & =\\frac{1}{y}\\cdot \\frac{∂}{∂x}(x)-y\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{2}}) \\\\  & =\\frac{1}{y}\\cdot (1)-y\\cdot (-\\frac{2}{{x}^{3}}) \\\\  & =\\frac{1}{y}+\\frac{2y}{{x}^{3}}\\end{aligned}\n$$"} {:db/id 17592186278241 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id 17592186275545} {:answer/id #uuid "2959b683-8721-5d47-ae28-bfdae8458730" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}-16y" :db/id 17592186275851} {:answer/id #uuid "8368ea87-f533-59c5-8779-19322eca007e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡x-16y" :db/id 17592186276659} {:answer/id #uuid "bd6ef288-08fc-5b25-a851-71488d467d63" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}" :db/id 17592186277165} {:answer/id #uuid "ecc63446-669b-52c7-a4ab-fb4eec89773e" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{arcsin}⁡x" :db/id 17592186277553}] :answer-field/correct {:answer/id #uuid "06f139b4-7520-5359-86c4-cc976c2a0da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/id 17592186275545} :answer-field/id #uuid "ad8d61fd-1884-5c25-bcf8-efd036093e2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186278023}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8fe04cdb-3f03-5a9d-a32d-3dd7d276f6a2" :question/math-academy-id "q-159619" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=y\\operatorname{arcsin}⁡x-8{y}^{2}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x-8{y}^{2}) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x)-\\frac{∂}{∂x}(8{y}^{2}) \\\\  & =y\\cdot \\frac{∂}{∂x}(\\operatorname{arcsin}⁡x)-8{y}^{2}\\frac{∂}{∂x}(1) \\\\  & =y\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-0 \\\\  & =\\frac{y}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$"} {:db/id 17592186278242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d0ec142-6a42-5919-bfa1-4366a65092fd" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id 17592186275741} {:answer/id #uuid "4619d482-5733-51a3-96e0-8ad693700d75" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{2x+3y}+6x{y}^{2}" :db/id 17592186276096} {:answer/id #uuid "4c062e4a-ec8c-5adf-8963-947c77e772cf" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+6x{y}^{2}" :db/id 17592186276145} {:answer/id #uuid "733056c4-4ea1-5358-977a-a7c64e073092" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2x+3y}+2x{y}^{3}" :db/id 17592186276520} {:answer/id #uuid "ad5a9b83-408b-502e-b6e9-1db4afeef584" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id 17592186277035}] :answer-field/correct {:answer/id #uuid "ad5a9b83-408b-502e-b6e9-1db4afeef584" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/id 17592186277035} :answer-field/id #uuid "4348a5dd-f992-5c0f-a358-d3667a2d63fb" :answer-field/key "selection" :answer-field/type 