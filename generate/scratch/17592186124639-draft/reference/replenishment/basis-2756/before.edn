{:db/id 17592186124639 :knowledge-point/canonical-example {:db/id 17592186124197 :question/id #uuid "35a664b8-a895-5c52-a92f-b62c75b44744" :question/math-academy-id "e-11026" :question/problem "Find $\\dfrac{\\partial f}{\\partial y}$ given that $f(x,y) = 3x\\ln y + 2ye^x.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y+2y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y)+\\frac{∂}{∂y}(2y{e}^{x}) \\\\  & =3x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+2{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =3x\\cdot \\frac{1}{y}+2{e}^{x}\\cdot 1 \\\\  & =\\frac{3x}{y}+2{e}^{x}\\end{aligned}\n$$"} :knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/key-prerequisites [{:db/id 17592186048749} {:db/id 17592186050420} {:db/id 17592186050675} {:db/id 17592186050690}] :knowledge-point/questions [{:db/id 17592186124786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf04fd45-6472-58ca-94d4-d15d2e211452" :answer/type {:db/ident :answer.type/math} :answer/value "2xy - x^{2}\\sin y" :db/id 17592186121314} {:answer/id #uuid "e86f2714-6951-57a6-9a39-8cf927f5a779" :answer/type {:db/ident :answer.type/math} :answer/value "2y - \\sin y" :db/id 17592186121315} {:answer/id #uuid "f1c60716-d08f-5601-a61d-2122e60c3f07" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} + 2x\\sin y" :db/id 17592186121316} {:answer/id #uuid "f9c2f3ce-5cce-5e2c-9e3f-2b7a5ddf7527" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} - 2x\\sin y" :db/id 17592186121317} {:answer/id #uuid "5027f72a-8193-5afe-a1d0-c7fc0aa88343" :answer/type {:db/ident :answer.type/math} :answer/value "2xy + x^{2}\\sin y" :db/id 17592186121318}] :answer-field/id #uuid "ea625c07-3c2c-5ede-a249-984720aa8ae8" :answer-field/