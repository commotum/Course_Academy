0ae591f-fa16-5672-9d61-61d8a2e3a05d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3" :db/id 17592186381220} :answer-field/id #uuid "e9775693-9681-5414-8d66-ab2776e2f417" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186381217}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26ca0866-34da-5a8a-8819-c0314d3abbb7" :question/math-academy-id "q-159611" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)={x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y-{3}^{x+y}) \\\\  & =\\frac{∂}{∂y}({x}^{3}\\operatorname{tan}⁡y)-\\frac{∂}{∂y}({3}^{x}\\cdot {3}^{y}) \\\\  & ={x}^{3}\\cdot \\frac{∂}{∂y}(\\operatorname{tan}⁡y)-{3}^{x}\\cdot \\frac{∂}{∂y}({3}^{y}) \\\\  & ={x}^{3}\\cdot {sec}^{2}⁡y-{3}^{x}\\cdot {3}^{y}\\operatorname{ln}⁡3 \\\\  & ={x}^{3}{sec}^{2}⁡y-{3}^{x+y}\\operatorname{ln}⁡3\\end{aligned}\n$$"} {:db/id 17592186381223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cc01c4d-160a-5eea-af63-34bb0d6f5cfe" :answer/type {:db/ident :answer.type/math} :answer/value "5-2\\operatorname{cos}⁡x" :db/id 17592186381225} {:answer/id #uuid "c56e8f59-813f-5140-bc33-6355f2e8c8f2" :answer/type {:db/ident :answer.type/math} :answer/value "5-2\\operatorname{sin}⁡x" :db/id 17592186381226} {:answer/id #uuid "f4c320e0-173a-55b6-b2fe-6e2df1ef3a1a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x" :db/id 17592186381227} {:answer/id #uuid "23510347-ad72-510f-9453-61fb93eb4c94" :answer/type {:db/ident :answer.type/math} :answer/value "5y-2\\operatorname{sin}⁡x" :db/id 17592186381228} {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id 17592186381229}] :answer-field/correct {:answer/id #uuid "e9546bf2-57cd-503b-97b1-de16a6c90894" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id 17592186381229} :answer-field/id #uuid "107fee59-5ae8-5849-9751-9c38f3f036ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186381224}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a343ea27-2d89-5c6e-9038-e851b2a44521" :question/math-academy-id "q-159614" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)=5y-2\\operatorname{sin}⁡x.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(5y-2\\operatorname{sin}⁡x) \\\\  & =\\frac{∂}{∂x}(5y)-\\frac{∂}{∂x}(2\\operatorname{sin}⁡x) \\\\  & =5\\cdot \\frac{∂}{∂x}(y)-2\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & =5\\cdot (0)-2\\cdot (\\operatorname{cos}⁡x) \\\\  & =-2\\operatorname{cos}⁡x\\end{aligned}\n$$"} {:db/id 17592186381230 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42294efd-0726-56da-9ff2-aacaa739035d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{{y}^{5}}+6x" :db/id 17592186381232} {:answer/id #uuid "e692a74c-4360-52d2-9a3b-14b7bb724d4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12{x}^{2}}{{y}^{4}}+6" :db/id 17592186381233} {:answer/id #uuid "e8ed405c-d0bb-58ec-9cb0-db66e314a0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{3}}{{y}^{5}}+6y" :db/id 17592186381234} {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id 17592186381235} {:answer/id #uuid "1c43e727-621e-5491-9269-e9a7064dc12d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{2}}{{y}^{5}}+6" :db/id 17592186381236}] :answer-field/correct {:answer/id #uuid "8e0ae37b-c8dd-5e79-8516-1915e55fc497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}}{{y}^{4}}+6y" :db/id 17592186381235} :answer-field/id #uuid "88fa3ce5-5c28-5db2-ada3-b42ead245d4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186381231}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55f3a1d2-cb7d-5965-acea-2992a42840fe" :question/math-academy-id "q-159618" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=\\frac{{x}^{3}}{{y}^{4}}+6xy.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}}+6xy) \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{3}}{{y}^{4}})+\\frac{∂}{∂x}(6xy) \\\\  & =\\frac{1}{{y}^{4}}\\frac{∂}{∂x}({x}^{3})+6y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\frac{1}{{y}^{4}}\\cdot 3{x}^{2}+6y\\cdot 1 \\\\  & =\\frac{3{x}^{2}}{{y}^{4}}+6y\\end{aligned}\n$$"} {:db/id 17592186381237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6f0ef5-d53d-5837-98c8-631186129434" :answer/type {:db/ident :answer.type/math} :answer/value "32{y}^{3}-\\frac{24y}{{x}^{5}}" :db/id 17592186381239} {:answer/id #uuid "cd8e251a-8b10-5e05-b8e9-664d5a11015b" :answer/type {:db/ident :answer.type/math} :answer/value "32x{y}^{3}+\\frac{6y}{{x}^{4}}" :db/id 17592186381240} {:answer/id #uuid "b39b7828-0e78-591c-b643-6a8cdf575bd5" :answer/type {:db/ident :answer.type/math} :answer/value "32x{y}^{3}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id 17592186381241} {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id 17592186381242} {:answer/id #uuid "4b9203e9-d678-558b-b50c-6a4193709f98" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}+\\frac{6y}{{x}^{4}}" :db/id 17592186381243}] :answer-field/correct {:answer/id #uuid "20a23aa3-24e9-590f-adc4-61e10bc87a84" :answer/type {:db/ident :answer.type/math} :answer/value "8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}" :db/id 17592186381242} :answer-field/id #uuid "3225480b-17a3-5de3-a894-3b9c909ffb27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186381238}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54a3e289-7644-5884-8f3d-09b4adcf7d3d" :question/math-academy-id "q-159621" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(8x{y}^{4}+\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =\\frac{∂}{∂x}(8x{y}^{4})+\\frac{∂}{∂x}(\\frac{3{y}^{2}}{{x}^{4}}) \\\\  & =8{y}^{4}\\cdot \\frac{∂}{∂x}(x)+3{y}^{2}\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{4}}) \\\\  & =8{y}^{4}\\cdot 1+3{y}^{2}\\cdot (-\\frac{4}{{x}^{5}}) \\\\  & =8{y}^{4}-\\frac{12{y}^{2}}{{x}^{5}}\\end{aligned}\n$$"} {:db/id 17592186436330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21514dc3-fd5d-565c-a5dd-41b334024de1" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{y}+{e}^{x}" :db/id 17592186436293} {:answer/id #uuid "9023fe86-f4d4-53cf-afa7-ceab284c385c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}" :db/id 17592186436306} {:answer/id #uuid "a479ae38-298e-5258-8558-f1d904df696f" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}+y{e}^{x}" :db/id 17592186436312} {:answer/id #uuid "e1294690-bb34-5896-b0c1-f42f98fe8355" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}+{e}^{x}" :db/id 17592186436319} {:answer/id #uuid "ffa0af21-05d8-5b41-b926-c8615ac23faf" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}" :db/id 17592186436323}] :answer-field/correct {:answer/id #uuid "21514dc3-fd5d-565c-a5dd-41b334024de1" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{y}+{e}^{x}" :db/id 17592186436293} :answer-field/id #uuid "ec0f419d-2a0d-5de9-af19-f4de7b215052" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186436328}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ea23849-68e0-52dc-ba91-b8da7ebd925a" :question/math-academy-id "q-159624" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)=x{e}^{y}+y{e}^{x}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(x{e}^{y}+y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(x{e}^{y})+\\frac{∂}{∂y}(y{e}^{x}) \\\\  & =x\\cdot \\frac{∂}{∂y}({e}^{y})+{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =x\\cdot {e}^{y}+{e}^{x}\\cdot 1 \\\\  & =x{e}^{y}+{e}^{x}\\end{aligned}\n$$"} {:db/id 17592186436333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5347b519-c490-5531-86d9-c47823454ef5" :answer/type {:db/ident :answer.type/math} :answer/value "-{y}^{2}" :db/id 17592186436298} {:answer/id #uuid "55c2293e-6cda-5e44-a3be-cf42f0b0106e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arctan}⁡y-{y}^{2}" :db/id 17592186436299} {:answer/id #uuid "6d40833e-3b6e-5b26-96b6-154dbe238c17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6xy}{1+{y}^{2}}" :db/id 17592186436304} {:answer/id #uuid "a2853c1d-4c78-58f1-877e-d34353665049" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-{y}^{2}" :db/id 17592186436310} {:answer/id #uuid "ab9e0b79-350f-56ca-97e1-d432fc67e8d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-2xy" :db/id 17592186436313}] :answer-field/correct {:answer/id #uuid "ab9e0b79-350f-56ca-97e1-d432fc67e8d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{1+{y}^{2}}-2xy" :db/id 17592186436313} :answer-field/id #uuid "1ad15885-4f52-5353-a9a6-c3dae29fe5c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186436324}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca64fedb-1539-5dab-a00d-8a624f81d8c4" :question/math-academy-id "q-159612" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=3\\operatorname{arctan}⁡y-x{y}^{2}.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3\\operatorname{arctan}⁡y-x{y}^{2}) \\\\  & =\\frac{∂}{∂y}(3\\operatorname{arctan}⁡y)-\\frac{∂}{∂y}(x{y}^{2}) \\\\  & =3\\cdot \\frac{∂}{∂y}(\\operatorname{arctan}⁡y)-x\\cdot \\frac{∂}{∂y}({y}^{2}) \\\\  & =3\\cdot \\frac{1}{1+{y}^{2}}-x\\cdot 2y \\\\  & =\\frac{3}{1+{y}^{2}}-2xy\\end{aligned}\n$$"}] :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}
