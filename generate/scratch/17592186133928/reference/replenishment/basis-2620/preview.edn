 dt \\\\ & =\\int_{-1}^{0}\\left(- 36 t^{5} - 81 t^{4} - 33 t^{3} + 27 t^{2} + 15 t\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(- \\frac{81 t^{5}}{5}\\right) + \\left(- 6 t^{6}\\right) + \\left(- \\frac{33 t^{4}}{4}\\right) + \\left(\\frac{15 t^{2}}{2}\\right) + \\left(9 t^{3}\\right)\\right]_{-1}^{0} \\\\ & =\\left(\\left(0\\right) + \\left(0\\right) + \\left(0\\right) + \\left(0\\right) + \\left(0\\right)\\right)-\\left(\\left(\\frac{81}{5}\\right) + \\left(-6\\right) + \\left(- \\frac{33}{4}\\right) + \\left(\\frac{15}{2}\\right) + \\left(-9\\right)\\right) \\\\ & =- \\frac{9}{20}\\end{aligned}\n$$" 13194139535933 17592186045443 true] [17592186543968 1080 "- \\frac{5}{12}" 13194139535933 17592186045443 true] [17592186543968 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186543968 1083 #uuid "224855bd-3e30-5d44-a775-59aa99728fa6" 13194139535933 17592186045443 true] [17592186543969 1080 "- 27 \\pi" 13194139535933 17592186045443 true] [17592186543969 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186543969 1083 #uuid "27d430ae-f87b-5de5-b7dd-d5309b3c247d" 13194139535933 17592186045443 true] [17592186543970 1080 "\\frac{9}{20}" 13194139535933 17592186045443 true] [17592186543970 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186543970 1083 #uuid "2de92522-d011-54d9-8f24-13c4a24e107c" 13194139535933 17592186045443 true] [17592186543971 1080 "0" 13194139535933 17592186045443 true] [17592186543971 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186543971 1083 #uuid "338ede79-c00d-5f63-9f9d-ec76ab18164c" 13194139535933 17592186045443 true] [17592186543972 1080 "- 4 \\pi" 13194139535933 17592186045443 true] [17592186543972 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186543972 1083 #uuid "39afc945-9e03-524e-952d-a33d5ab5d753" 13194139535933 17592186045443 true] [17592186543973 1080 "12" 13194139535933 17592186045443 true] [17592186543973 1082 #edb/ref 1