\ & =6\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\\iint_S\\operatorname{curl}F\\cdot\\mathrm dS & =\\oint_C F\\cdot\\mathrm dr \\\\ & =\\int_{0}^{2 \\pi} F(r(t))\\cdot r\\prime(t)\\,\\mathrm dt \\\\ & =\\int_{0}^{2 \\pi}\\left(6\\right)\\,\\mathrm dt \\\\ & =\\left[\\left(6 t\\right)\\right]_{0}^{2 \\pi} \\\\ & =\\left(\\left(12 \\pi\\right)\\right)-\\left(\\left(0\\right)\\right) \\\\ & =12 \\pi\\end{aligned}\n$$" 13194139535933 17592186045443 true] [17592186544005 1080 "12 \\pi" 13194139535933 17592186045443 true] [17592186544005 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186544005 1083 #uuid "e2c13c2e-52fe-58db-85c2-56e596e798ee" 13194139535933 17592186045443 true] [17592186544006 1080 "4 \\pi" 13194139535933 17592186045443 true] [17592186544006 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186544006 1083 #uuid "e5d4c9aa-321f-56c7-9ef0-3a217437cb9b" 13194139535933 17592186045443 true] [17592186544007 1080 "- 6 \\pi" 13194139535933 17592186045443 true] [17592186544007 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186544007 1083 #uuid "f0a3acee-6209-5db5-8d34-42ddc39d0af2" 13194139535933 17592186045443 true] [17592186544008 1080 "0" 13194139535933 17592186045443 true] [17592186544008 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186544008 1083 #uuid "f27e1353-adf9-5977-b05b-7f5737daaa15" 13194139535933 17592186045443 true] [17592186544009 1080 "\\frac{39}{10}" 13194139535933 17592186045443 true] [17592186544009 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186544009 1083 #uuid "f5313835-42c4-5113-b72c-dc6571bae4d3" 13194139535933 17592186045443 true] [17592186544010 1080 "4" 13194139535933 17592186045443 true] [17592186544010 1082 #edb/ref 17592186045498 13194139535933 17592186045443 true] [17592186544010 1083 #uuid "f5a378c0-0e5b-55bb-98f4-df4562cc3e38" 13194139535933 17592186045443 true] [1