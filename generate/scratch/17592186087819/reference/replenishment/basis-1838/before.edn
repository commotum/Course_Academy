 $C,$ and so $c=0.$\n\nAs a result, our route matrix is the following:\n\n|  |  | To: |  |  |  |\n| --- | --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** | **D** |\n| From: | **A** | $0$ | $1$ | $0$ | $2$ |\n| **B** | $0$ | $0$ | $1$ | $0$ |  |\n| **C** | $0$ | $0$ | $0$ | $1$ |  |\n| **D** | $0$ | $0$ | $1$ | $0$ |  |\n\nTherefore, \n\n$$\na+b+c=2+1+0=3.\n$$"} {:db/id 17592186299744 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ffc48ff-1011-56e8-978d-23ac82a79306" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id 17592186297690}] :answer-field/correct {:answer/id #uuid "1ffc48ff-1011-56e8-978d-23ac82a79306" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id 17592186297690} :answer-field/id #uuid "28ebc2c3-8f30-59dc-a757-e2f3006a8b32" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186298775} {:answer-field/choices [{:answer/id #uuid "8ab4fcc6-76c4-5164-a6f8-e99687699fd9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186298155}] :answer-field/correct {:answer/id #uuid "8ab4fcc6-76c4-5164-a6f8-e99687699fd9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id 17592186298155} :answer-field/id #uuid "9e857817-9ed7-5435-956e-848cd74bf5b0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186299159} {:answer-field/choices [{:answer/id #uuid "dfcfbf74-a02e-5cd5-884b-9d1f0073aa1d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186298513}] :answer-field/correct {:answer/id #uuid "dfcfbf74-a02e-5cd5-884b-9d1f0073aa1d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id 17592186298513} :answer-field/id #uuid "f5ed9190-0d64-5ee1-84d8-1118627244ad" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186299469}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9