/ref 17592186490024} {:answer/id #uuid "fba812d1-3f67-596b-b851-fa0314c2cb48" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e6aa0661b20e4d114abb475dfc3cba6180bed5155c6051262a68c31110408a18.png" :db/id #edb/ref 17592186490062}] :answer-field/correct {:answer/id #uuid "eb6bc548-b54d-5ef3-9f0e-1da8be1a265c" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b2bb0b6f019af476eae3e76adb7ac2ef4745a6c4bdeae24cd4a40320b23f882b.png" :db/id #edb/ref 17592186490024} :answer-field/id #uuid "d17d82c6-1a23-5c4e-bb97-55ab46a58407" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f93db21-c74e-5e95-a404-6814f4df05d9" :question/math-academy-id "q-102054" :question/problem "Which of the following graphs shows the line $y=-2x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-2x \\\\  & =-2(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-2x \\\\  & =-2(1) \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the second point is $(1,-2).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-2x.$ \n\n![](images/c6/c632cc2770958b5d73f6e143de0b72d19b2099f9f656ff34f273d88acc4f9cb4.png)"} {:db/id #edb/ref 17592186490285 :knowledge-point/_questions [{:knowledge-point/id #uuid "ebeb4e5a-adbe-5a94-b05d-61933a687892" :knowledge-point/title "Sketching a Line Using Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1395c3db-95d9-5639-b9d4-30e6fc772906" :answer/type {:db/ident :answer.type/image} :answer/value "images/0c/0cfc4bba4867b40c4c38b0886c37bb5c4cd64d293530ece7c67cdb6349134013.png" :db/id #edb/ref 17592186489558} {:answer/id #uuid "3b2e4dbc-417e-567d-87f0-6c258efaf698" :answer/type {:db/ident :answer.type/image} :answer/value "images/9e/9e2977ee1faa5dde2d1bf3a427037aac75b2692486bdcb724356452765c8b661.png" :db/id #edb/ref 17592186489648} {:answer/id #uuid "73631664-2efe-5676-8831-b04bad13e778" :answer/type {:db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186489784} {:answer/id #uuid "7a5037ef-50db-500f-ac5f-db15fcc0b6b8" :answer/type {:db/ident :answer.type/image} :answer/value "images/24/24d776784e54d7e38452f9b548051d0a2015e119f7c701ac74be87ef3dbb42f9.png" :db/id #edb/ref 17592186489794} {:answer/id #uuid "c346fa15-1ab9-5397-875e-59d3c4e305eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/af/afb86fd4a7ffd591dfbbc6e8ee837b33b943972212b04b15f9040b310b0abdba.png" :db/id #edb/ref 17592186489936}] :answer-field/correct {:answer/id #uuid "73631664-2efe-5676-8831-b04bad13e778" :answer/type {:db/ident :answer.type/image} :answer/value "images/06/0678cd88949fac3a9ce58d255eee9d8a07ba8c3b91a86f90fa24d70d1510568f.png" :db/id #edb/ref 17592186489784} :answer-field/id #uuid "4ceda208-3258-5df9-a5ee-0311a1f10448" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186490120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5b958d4-e62e-522f-9fd3-554270dc7fdb" :question/math-academy-id "q-109055" :question/problem "Which of the following graphs shows the line $y=2-\\frac{1}{2}x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-\\frac{1}{2}x \\\\  & =2-\\frac{1}{2}(0) \\\\  & =2-0 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the first point is $(0,2).$\n\n- For the second point, we will let the $x$-coordinate be $x=8.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =2-\\frac{1}{2}x \\\\  & =2-\\frac{1}{2}(8) \\\\  & =2-4 \\\\  & =-2.\\end{aligned}\n$$\n\nSo, the second point is $(8,-2).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=2-\\frac{1}{2}x.$\n\n![](images/a8/a8c562212687c848e2de25b757f59acd70467a085ae2e0713fbeafa355ad5bb5.png)"}] :knowledge-point/title "Sketching a Line Using Two Points"}]}
