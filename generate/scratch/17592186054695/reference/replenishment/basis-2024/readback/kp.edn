3x \\\\  & =-3(1) \\\\  & =-3.\\end{aligned}\n$$\n\nSo, the second point is $(1,-3).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-3x.$ \n\n![](images/08/08e854b04d47ff670b197a2a0c7b51c13eb135626e0ed6cdfd24368d4032f259.png)"} {:db/id #edb/ref 17592186497764 :knowledge-point/_questions [{:knowledge-point/id #uuid "ebeb4e5a-adbe-5a94-b05d-61933a687892" :knowledge-point/title "Sketching a Line Using Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc17c22-f348-5c67-921e-bb49f7e4bc08" :answer/type {:db/ident :answer.type/image} :answer/value "images/af/afb86fd4a7ffd591dfbbc6e8ee837b33b943972212b04b15f9040b310b0abdba.png" :db/id #edb/ref 17592186497746} {:answer/id #uuid "5656dea6-87b8-5765-a05d-162629ac3306" :answer/type {:db/ident :answer.type/image} :answer/value "images/39/39ae505504b452e87f70c4b555914b597ff0d3859f54f1f4d2ed5516c73131da.png" :db/id #edb/ref 17592186497752} {:answer/id #uuid "59705c30-8f9f-56b2-8c1d-4816e1357d09" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c4d21e0fdbdb082c1efdd50936da2cd8c131be9b5ac3fa0fa85a73f8c11cf48.png" :db/id #edb/ref 17592186497753} {:answer/id #uuid "a43ac8a2-cf32-55c4-b2d4-693e23dc22b3" :answer/type {:db/ident :answer.type/image} :answer/value "images/d1/d17e0a44ef03d6110f031a8ab6f0bf63b478a263754bbab63124e880546aef28.png" :db/id #edb/ref 17592186497758} {:answer/id #uuid "cd48e67e-3c17-53e8-a38a-e16bd3b4647f" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c7577f7033f36315d50748424d7a8db635e9aecd4c88c9ed4626f3294bc6c2b.png" :db/id #edb/ref 17592186497760}] :answer-field/correct {:answer/id #uuid "59705c30-8f9f-56b2-8c1d-4816e1357d09" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c4d21e0fdbdb082c1efdd50936da2cd8c131be9b5ac3fa0fa85a73f8c11cf48.png" :db/id #edb/ref 17592186497753} :answer-field/id #uuid "77551351-5d0a-512a-acd9-8abceb71136c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186497756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffd546da-09fc-5649-b60d-749bd09256a6" :question/problem "Which of the following graphs shows the line $y=-1x?$" :question/worked-solution "We need to find two distinct points that lie on our line. Any two points will do!\n\n- For the first point, we will let the $x$-coordinate be $x=0.$ Then the $y$-coordinate is \n\n$$\n\\begin{aligned}y & =-1x \\\\  & =-1(0) \\\\  & =0.\\end{aligned}\n$$\n\nSo, the first point is $(0,0).$\n\n- For the second point, we will let the $x$-coordinate be $x=1.$ Then the $y$-coordinate is\n\n$$\n\\begin{aligned}y & =-1x \\\\  & =-1(1) \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the second point is $(1,-1).$\n\nFinally, we plot those two points on the $xy$-plane and draw a line through them. This is the graph of $y=-1x.$ \n\n![](images/73/7322801cf231391f58d39f2fad42b779e04fc1b81b686bcb3291ebfee5651226.png)"}] :knowledge-point/title "Sketching a Line Using Two Points"}]}
