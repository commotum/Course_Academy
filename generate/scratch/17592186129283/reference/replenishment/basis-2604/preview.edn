ft(v + 1\\right)^{2} - 9\\end{bmatrix},\n$$\n\nis (locally) orientation-preserving?" 13194139535917 17592186045443 true] [17592186541357 1072 #uuid "4392331f-93e6-5707-9c23-1a9fa29d3a6c" 13194139535917 17592186045443 true] [17592186541357 1074 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}v + \\left(u + 3\\right)^{2} + 1 \\\\ - 3 u - \\left(v + 1\\right)^{2} - 9\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} &=\\begin{vmatrix}2 u + 6 & 1 \\\\ -3 & - 2 v - 2\\end{vmatrix} \\\\ &=(2 u + 6)\\cdot (- 2 v - 2)-(1)\\cdot (-3) \\\\ &=- 4 u v - 4 u - 12 v - 9.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}- 4 u v - 4 u - 12 v - 9 &>0 \\\\ \\left(u + 3\\right) \\left(v + 1\\right) < \\frac{3}{4}\\end{aligned}\n$$\n\nThis gives the solution $v < -1 + \\frac{3}{4 \\left(u + 3\\right)}$ for $u>-3$ and $v > -1 + \\frac{3}{4 \\left(u + 3\\right)}$ for $u<-3.$ At $u=-3,$ the Jacobian is positive, so this line belongs to the required region.\n\nNotice that the equation\n\n$$\nv = -1 + \\frac{3}{4 \\left(u + 3\\right)}\n$$\n\ndefines a hyperbola.\n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/a7/a77c173f49ff007692a1f040708adecbe65b7b035ce776faef93de1f8ce6019a.png)" 13194139535917 17592186045443 true] [17592186541358 1080 "images/d9/d9383071f1ee1de5f6a619559bebb5c2bc60f09e74655a476dc11981e26d8b93.png" 13194139535917 17592186045443 true] [17592186541358 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541358 1083 #uuid "48f408a0-6e39-5b2c-9d7b-1e9430158db7" 13194139535917 17592186045443 true] [17592186541359 1080 "images/c6/c66e6dd0389d46178372b1cc1730b323671e6a7ea7010a8dc400866b63561409.png" 13194139535917 17592186045443 true] [17592186541359 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541359 1083 #uuid "4a4383ff-729c-5878-8348-4f2b0d1ad4b8" 13194139535917 17592186045443 true] [17592186541360 1080 "images/0d/0d6d817325324661cf7b0b3a73a89a8d63558bd90ae268c7598092d5a1354c49.png" 13194139535917 17592186045443 true] [17592186541360 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541360 1083 #uuid "54d432d4-57f5-50e0-a07b-4e0b563624ea" 13194139535917 17592186045443 true] [17592186541361 1068 #edb/ref 17592186541380 13194139535917 17592186045443 true] [17592186541361 1070 #edb/ref 17592186045485 13194139535917 17592186045443 true] [17592186541361 1071 "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}4 \\left(u + 3\\right)^{2} \\\\ 2 v + 2\\end{bmatrix},\n$$\n\nis (locally) orientation-reversing?" 13194139535917 17592186045443 true] [17592186541361 1072 #uuid "565943af-a957-5402-9505-63da18eb789f" 13194139535917 17592186045443 true] [17592186541361 1074 "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}4 \\left(u + 3\\right)^{2} \\\\ 2 v + 2\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} &=\\begin{vmatrix}8 u + 24 & 0 \\\\ 0 & 2\\end{vmatrix} \\\\ &=(8 u + 24)\\cdot (2)-(0)\\cdot (0) \\\\ &=16 u + 48.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}16 u + 48 &<0 \\\\ u < -3\\end{aligned}\n$$\n\nNotice that the equation\n\n$$\nu = -3\n$$\n\ndefines a vertical line.\n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](images/c5/c55116b6c9a7a78b548eaef6002dc56584ddf8498adb550335b3bf27593fb7ea.png)" 13194139535917 17592186045443 true] [17592186541362 1080 "images/35/3514dfa39dddf1327e2d355ecfdf0c1a54596772554c49749e6f88c4f63e1c69.png" 13194139535917 17592186045443 true] [17592186541362 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541362 1083 #uuid "57964daf-2acf-57ba-b59c-295b8fceed9e" 13194139535917 17592186045443 true] [17592186541363 1080 "images/e2/e26d4947959fefd65cf852be709eaed2ac363225442686a5f160e02de1e798b3.png" 13194139535917 17592186045443 true] [17592186541363 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541363 1083 #uuid "58432077-1e38-53b0-ac66-cd774227ddf6" 13194139535917 17592186045443 true] [17592186541364 1068 #edb/ref 17592186541379 13194139535917 17592186045443 true] [17592186541364 1070 #edb/ref 17592186045486 13194139535917 17592186045443 true] [17592186541364 1071 "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}2 v + \\left(u + 1\\right)^{2} + 2 \\\\ - u - \\left(v + 1\\right)^{2} - 1\\end{bmatrix},\n$$\n\nis (locally) orientation-preserving?" 13194139535917 17592186045443 true] [17592186541364 1072 #uuid "59add0cf-4e80-54d4-b7e4-f8be9314c117" 13194139535917 17592186045443 true] [17592186541364 1074 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}2 v + \\left(u + 1\\right)^{2} + 2 \\\\ - u - \\left(v + 1\\right)^{2} - 1\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} &=\\begin{vmatrix}2 u + 2 & 2 \\\\ -1 & - 2 v - 2\\end{vmatrix} \\\\ &=(2 u + 2)\\cdot (- 2 v - 2)-(2)\\cdot (-1) \\\\ &=- 4 u v - 4 u - 4 v - 2.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}- 4 u v - 4 u - 4 v - 2 &>0 \\\\ \\left(u + 1\\right) \\left(v + 1\\right) < \\frac{1}{2}\\end{aligned}\n$$\n\nThis gives the solution $v < -1 + \\frac{1}{2 \\left(u + 1\\right)}$ for $u>-1$ and $v > -1 + \\frac{1}{2 \\left(u + 1\\right)}$ for $u<-1.$ At $u=-1,$ the Jacobian is positive, so this line belongs to the required region.\n\nNotice that the equation\n\n$$\nv = -1 + \\frac{1}{2 \\left(u + 1\\right)}\n$$\n\ndefines a hyperbola.\n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/61/61eb7087a9aa310143a93f0dd0cf549196c66536baa0570bb3b7158b934e38ff.png)" 13194139535917 17592186045443 true] [17592186541365 1080 "images/98/98455798ceac32138f9619758059d300b0065853da4fd4bd83af8daedc69848d.png" 13194139535917 17592186045443 true] [17592186541365 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541365 1083 #uuid "5e99e166-ec0c-5b27-a479-5d9471f471ea" 13194139535917 17592186045443 true] [17592186541366 1080 "images/64/645c29d8beb5ddfe4c108002292a7fc13c6fc62dba4a6f616d2e4cbce3181278.png" 13194139535917 17592186045443 true] [17592186541366 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541366 1083 #uuid "6759a9bf-0828-5f66-a722-fd710424a2b6" 13194139535917 17592186045443 true] [17592186541367 1080 "images/26/26c6b06e7265268f7bebf6168a8c78757540cf0293ff4dd4ad05b789eb9fd40a.png" 13194139535917 17592186045443 true] [17592186541367 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541367 1083 #uuid "675f8f01-4c56-5d4a-a654-9bcd0db9ac05" 13194139535917 17592186045443 true] [17592186541368 1068 #edb/ref 17592186541397 13194139535917 17592186045443 true] [17592186541368 1070 #edb/ref 17592186045485 13194139535917 17592186045443 true] [17592186541368 1071 "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}4 u + 12 \\\\ 4 \\left(v - 3\\right)^{2}\\end{bmatrix},\n$$\n\nis (locally) orientation-preserving?" 13194139535917 17592186045443 true] [17592186541368 1072 #uuid "6b68b81d-0d26-5a45-aadd-1f07bfe3d5e1" 13194139535917 17592186045443 true] [17592186541368 1074 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0\n$$\n\nWe have\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}4 u + 12 \\\\ 4 \\left(v - 3\\right)^{2}\\end{bmatrix}.\n$$\n\nComputing the corresponding Jacobian determinant, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} &=\\begin{vmatrix}4 & 0 \\\\ 0 & 8 v - 24\\end{vmatrix} \\\\ &=(4)\\cdot (8 v - 24)-(0)\\cdot (0) \\\\ &=32 v - 96.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}32 v - 96 &>0 \\\\ v > 3\\end{aligned}\n$$\n\nNotice that the equation\n\n$$\nv = 3\n$$\n\ndefines a horizontal line.\n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/64/645c29d8beb5ddfe4c108002292a7fc13c6fc62dba4a6f616d2e4cbce3181278.png)" 13194139535917 17592186045443 true] [17592186541369 1080 "images/44/44a052682a5fc6f18580bf3c3bea2835352972a195ebb4dbfda452c7163f538b.png" 13194139535917 17592186045443 true] [17592186541369 1082 #edb/ref 17592186045497 13194139535917 17592186045443 true] [17592186541369 1083 #uuid "6cded118-0827-53b0-a109-b308dbdffd78" 13194139535917 17592186045443 true] [17592186541370 1075 #edb/ref 17592186541362 13194139535917 17592186045443 true] [17592186541370 1075 #edb/ref 17592186541386 13194139535917 17592186045443 true] [17592186541370 1075 #edb/ref 17592186541387 13194139535917 17592186045443 true] [17592186541370 1075 #edb/ref 17592186541403 13194139535917 17592186045443 true] [1759