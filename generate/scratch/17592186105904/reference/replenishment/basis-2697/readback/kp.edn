4}\\,\\text{cm}.$"} {:db/id #edb/ref 17592186556391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31587425-b010-55dd-9843-c96a4d64e79b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{3}\\,\\text{cm}" :db/id #edb/ref 17592186556360} {:answer/id #uuid "53db9127-7086-5ad7-9c28-d318c22bbce1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5324}{27}\\,\\text{cm}" :db/id #edb/ref 17592186556364} {:answer/id #uuid "59fb3605-a379-56b2-ade2-3c2c9eb97061" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\text{cm}" :db/id #edb/ref 17592186556367} {:answer/id #uuid "6fe51a8d-5b8a-5a39-a2b7-fdd14cf223b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{6}\\,\\text{cm}" :db/id #edb/ref 17592186556371} {:answer/id #uuid "e524d323-b2cd-59f8-9307-3308a883afce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}\\,\\text{cm}" :db/id #edb/ref 17592186556399}] :answer-field/correct {:answer/id #uuid "e524d323-b2cd-59f8-9307-3308a883afce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{3}\\,\\text{cm}" :db/id #edb/ref 17592186556399} :answer-field/id #uuid "7ec708fe-da2e-5933-be9e-a4bf84399625" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556374}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bcfa3740-40ac-5541-a7cc-f675d652dadd" :question/problem "![](images/27/272f91f05987c36217eeb9bcb74c4a7b9115f00dbf9358873616a09556803f4a.png)\n\nThe area of the triangle $△ABC$ is $\\frac{121\\sqrt{3}}{18}\\,\\text{cm}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{22}{3}\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={120}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{120}^{∘}=\\frac{\\sqrt{3}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{1}{2}\\cdot b\\cdot \\frac{22}{3}\\cdot \\operatorname{sin}⁡{120}^{∘} \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{1}{2}\\cdot b\\cdot \\frac{22}{3}\\cdot (\\frac{\\sqrt{3}}{2}) \\\\ \\frac{121\\sqrt{3}}{18} & =\\frac{11\\sqrt{3}}{6}b \\\\ b & =\\frac{\\frac{121\\sqrt{3}}{18}}{\\frac{11\\sqrt{3}}{6}} \\\\ b & =\\frac{11}{3}\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{11}{3}\\,\\text{cm}.$"} {:db/id #edb/ref 17592186556396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a81808-f3a7-51b7-a275-f77c8ce4630c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{37}{4}" :db/id #edb/ref 17592186556354}] :answer-field/correct {:answer/id #uuid "09a81808-f3a7-51b7-a275-f77c8ce4630c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{37}{4}" :db/id #edb/ref 17592186556354} :answer-field/id #uuid "5da2ced1-509c-5f9a-a1eb-9a312a6150a3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186556368}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d3e9f084-c5c8-5e5d-a8cd-0b8a1cdc4b6a" :question/problem "![](images/3d/3dc502507d431d52979ff26a01089d61793a9487989d9203fd2f4f9246ecb1e3.png)\n\nThe area of the triangle $△ABC$ is $\\frac{111\\sqrt{2}}{32}\\,\\text{cm}^{2}.$ Then, $AC=${{field-1}} $\\text{cm}.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{3}{2}\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{1}{2}\\cdot b\\cdot \\frac{3}{2}\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{1}{2}\\cdot b\\cdot \\frac{3}{2}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{111\\sqrt{2}}{32} & =\\frac{3\\sqrt{2}}{8}b \\\\ b & =\\frac{\\frac{111\\sqrt{2}}{32}}{\\frac{3\\sqrt{2}}{8}} \\\\ b & =\\frac{37}{4}\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{37}{4}\\,\\text{cm}.$"} {:db/id #edb/ref 17592186556400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189e4e81-e91b-541e-a713-a659dc893ccc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556357} {:answer/id #uuid "397621df-9258-5f5c-b429-ac0df048eae2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{17}\\,\\text{mm}" :db/id #edb/ref 17592186556361} {:answer/id #uuid "56329264-d12e-5e0e-a820-46d1266fc01d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556365} {:answer/id #uuid "9031717b-9f69-57af-8df6-781065968f5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1445}{27}\\,\\text{mm}" :db/id #edb/ref 17592186556377} {:answer/id #uuid "9197fd42-c5ad-5145-ad0f-670e27d991b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}\\,\\text{mm}" :db/id #edb/ref 17592186556378}] :answer-field/correct {:answer/id #uuid "56329264-d12e-5e0e-a820-46d1266fc01d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\,\\text{mm}" :db/id #edb/ref 17592186556365} :answer-field/id #uuid "e0c61827-39ef-5b85-8a67-6d3bc7f90cb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556397}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e783bc5b-9008-5bdd-9a47-991be242d917" :question/problem "![](images/77/7783777fcc75d7c12a8eaed0f703bc6a864e805fc8c814860a899e3737f71480.png)\n\nThe area of the triangle $△ABC$ is $\\frac{85\\sqrt{2}}{36}\\,\\text{mm}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=\\frac{17}{3}\\text{ mm} \\\\ b & =AC \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{1}{2}\\cdot b\\cdot \\frac{17}{3}\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{1}{2}\\cdot b\\cdot \\frac{17}{3}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{85\\sqrt{2}}{36} & =\\frac{17\\sqrt{2}}{12}b \\\\ b & =\\frac{\\frac{85\\sqrt{2}}{36}}{\\frac{17\\sqrt{2}}{12}} \\\\ b & =\\frac{5}{3}\\text{ mm}.\\end{aligned}\n$$\n\nWe conclude that $AC=\\frac{5}{3}\\,\\text{mm}.$"} {:db/id #edb/ref 17592186556401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e808f9d-31be-5a13-9482-c882618b4d13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{7}\\,\\text{cm}" :db/id #edb/ref 17592186556363} {:answer/id #uuid "6464c1a3-5522-5202-84e1-c5893469dea5" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186556369} {:answer/id #uuid "6eeeca4d-7e83-52c4-ab5b-afef0a041e6c" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186556370} {:answer/id #uuid "8f4a94f6-3016-5f60-9d0c-0d9b1512ddce" :answer/type {:db/ident :answer.type/math} :answer/value "245\\,\\text{cm}" :db/id #edb/ref 17592186556376} {:answer/id #uuid "bd849935-03e9-5534-b8df-54ec95c858b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\,\\text{cm}" :db/id #edb/ref 17592186556392}] :answer-field/correct {:answer/id #uuid "6eeeca4d-7e83-52c4-ab5b-afef0a041e6c" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{cm}" :db/id #edb/ref 17592186556370} :answer-field/id #uuid "b93faa7e-caa0-5f1e-8af9-0757c496ba0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186556387}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e802d20f-bb4d-5898-ad8c-4cb88bfe1ea8" :question/problem "![](images/6a/6a2da5468750823c21e259f6aa40a0c93342a2bebcc38a1292aa43686ca618fa.png)\n\nThe area of the triangle $△ABC$ is $\\frac{35}{4}\\,\\text{cm}^{2}.$ Use $\\sin30^{\\circ}=\\frac{1}{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=7\\text{ cm} \\\\ b & =AC \\\\ m∠A & ={30}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{30}^{∘}=\\frac{1}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{35}{4} & =\\frac{1}{2}\\cdot b\\cdot 7\\cdot \\operatorname{sin}⁡{30}^{∘} \\\\ \\frac{35}{4} & =\\frac{1}{2}\\cdot b\\cdot 7\\cdot (\\frac{1}{2}) \\\\ \\frac{35}{4} & =\\frac{7}{4}b \\\\ b & =\\frac{\\frac{35}{4}}{\\frac{7}{4}} \\\\ b & =5\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=5\\,\\text{cm}.$"}] :knowledge-point/title "Calculating an Angle or Side of a Triangle Given the Area of a Triangle"}]}
