58d2-a1b8-7cfd771764df"] [:db/add "b172cfd8-30ff-5646-9672-925044e7beef" :answer-field/correct "144251c2-9709-58d2-a1b8-7cfd771764df"] [:db/ensure "b172cfd8-30ff-5646-9672-925044e7beef" :answer-field/validate] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/id #uuid "08c38953-f704-56cc-b3e1-73f07fd4a27c"] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=\\frac{5 y}{x},\\qquad x\\ne 0\n$$\n\nLet $f(x)=- 4 x^{5}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=- 16 x^{4}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation."] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is false. Differentiating $f(x)=- 4 x^{5},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(- 4 x^{5}\\right)\\prime \\\\ &=-4\\cdot 5 x^{4} \\\\ &=- 20 x^{4} \\\\ &\\not\\equiv - 16 x^{4}\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=- 4 x^{5}$ and $y\\prime=- 20 x^{4}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}\\frac{5 y}{x} \\\\ - 20 x^{4} &\\overset{?}{=}\\frac{5\\left(- 4 x^{5}\\right)}{x} \\\\ - 20 x^{4} &=- 20 x^{4}\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=- 4 x^{5}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"II and III only.\""] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/difficulty :question.difficulty/moderate] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/answer-fields "3d5507b0-90fc-51e0-a572-7ef2530af52e"] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/answer-fields "2f0af7fc-a183-5432-8aa6-90714a3b16d0"] [:db/add "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/answer-fields "b172cfd8-30ff-5646-9672-925044e7beef"] [:db/ensure "08c38953-f704-56cc-b3e1-73f07fd4a27c" :question/validate] [:db/add 17592186100888 :knowledge-point/questions "08c38953-f704-56cc-b3e1-73f07fd4a27c"] [:db/add "923779fe-8a1d-5656-8015-eaf792fb0480" :answer/id #uuid "923779fe-8a1d-5656-8015-eaf792fb0480"] [:db/add "923779fe-8a1d-5656-8015-eaf792fb0480" :answer/type :answer.type/text] [:db/add "923779fe-8a1d-5656-8015-eaf792fb0480" :answer/value "false"] [:db/ensure "923779fe-8a1d-5656-8015-eaf792fb0480" :answer/validate] [:db/add "8e2d78a6-0098-5570-8b75-9658bac896ff" :answer/id #uuid "8e2d78a6-0098-5570-8b75-9658bac896ff"] [:db/add "8e2d78a6-0098-5570-8b75-9658bac896ff" :answer/type :answer.type/text] [:db/add "8e2d78a6-0098-5570-8b75-9658bac896ff" :answer/value "true"] [:db/ensure "8e2d78a6-0098-5570-8b75-9658bac896ff" :answer/validate] [:db/add "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/id #uuid "32dbae71-0c96-559b-b891-eaff9a25935a"] [:db/add "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/key "I"] [:db/add "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/type :answer-field.type/checkbox] [:db/add "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/choices "923779fe-8a1d-5656-8015-eaf792fb0480"] [:db/add "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/choices "8e2d78a6-0098-5570-8b75-9658bac896ff"] [:db/add "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/correct "8e2d78a6-0098-5570-8b75-9658bac896ff"] [:db/ensure "32dbae71-0c96-559b-b891-eaff9a25935a" :answer-field/validate] [:db/add "d2f9d0a1-d778-50ce-98ec-358bbfec63d8" :answer/id #uuid "d2f9d0a1-d778-50ce-98ec-358bbfec63d8"] [:db/add "d2f9d0a1-d778-50ce-98ec-358bbfec63d8" :answer/type :answer.type/text] [:db/add "d2f9d0a1-d778-50ce-98ec-35