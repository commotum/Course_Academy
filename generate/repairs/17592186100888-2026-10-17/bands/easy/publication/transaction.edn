f7-363e-506c-bec4-f379ec73747e"] [:db/add "7dbe8bcd-6fff-57bd-988f-7e5cada4b731" :answer-field/choices "dd1cdf16-a724-5637-b8f8-f29be5bb16c1"] [:db/add "7dbe8bcd-6fff-57bd-988f-7e5cada4b731" :answer-field/correct "c941adf7-363e-506c-bec4-f379ec73747e"] [:db/ensure "7dbe8bcd-6fff-57bd-988f-7e5cada4b731" :answer-field/validate] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/id #uuid "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a"] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=\\cos{\\left(2 x \\right)}\n$$\n\nLet $f(x)=\\frac{\\sin{\\left(2 x \\right)}}{4}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{\\cos{\\left(2 x \\right)}}{2}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation."] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=\\frac{\\sin{\\left(2 x \\right)}}{4},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\frac{\\sin{\\left(2 x \\right)}}{4}\\right)\\prime \\\\ &=\\frac{1}{4}\\cdot 2\\cos(2x) \\\\ &=\\frac{\\cos{\\left(2 x \\right)}}{2}\\end{aligned}\n$$\n\n- Statement II is false. Substituting $y=\\frac{\\sin{\\left(2 x \\right)}}{4}$ and $y\\prime=\\frac{\\cos{\\left(2 x \\right)}}{2}$ into the original equation gives expressions that are not identical:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}\\cos{\\left(2 x \\right)} \\\\ \\frac{\\cos{\\left(2 x \\right)}}{2} &\\not\\equiv \\cos{\\left(2 x \\right)}\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, the function $y=\\frac{\\sin{\\left(2 x \\right)}}{4}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/difficulty :question.difficulty/easy] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/answer-fields "621ceb6c-b367-53bb-a1d7-504317392b55"] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/answer-fields "d23c64dd-d8d6-5fdd-aced-ed924c331a79"] [:db/add "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/answer-fields "7dbe8bcd-6fff-57bd-988f-7e5cada4b731"] [:db/ensure "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a" :question/validate] [:db/add 17592186100888 :knowledge-point/questions "f69906ca-c5a8-50c6-b2ca-cd97ea4fc11a"] [:db/add "83796f1a-f177-5bfb-9026-ee69e4168ca1" :answer/id #uuid "83796f1a-f177-5bfb-9026-ee69e4168ca1"] [:db/add "83796f1a-f177-5bfb-9026-ee69e4168ca1" :answer/type :answer.type/text] [:db/add "83796f1a-f177-5bfb-9026-ee69e4168ca1" :answer/value "false"] [:db/ensure "83796f1a-f177-5bfb-9026-ee69e4168ca1" :answer/validate] [:db/add "11a41b91-a3e8-52ba-ba25-b21d70c222a2" :answer/id #uuid "11a41b91-a3e8-52ba-ba25-b21d70c222a2"] [:db/add "11a41b91-a3e8-52ba-ba25-b21d70c222a2" :answer/type :answer.type/text] [:db/add "11a41b91-a3e8-52ba-ba25-b21d70c222a2" :answer/value "true"] [:db/ensure "11a41b91-a3e8-52ba-ba25-b21d70c222a2" :answer/validate] [:db/add "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/id #uuid "2a41cff6-b393-54f3-8621-68b284e47ac3"] [:db/add "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/key "I"] [:db/add "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/type :answer-field.type/checkbox] [:db/add "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/choices "83796f1a-f177-5bfb-9026-ee69e4168ca1"] [:db/add "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/choices "11a41b91-a3e8-52ba-ba25-b21d70c222a2"] [:db/add "2a41cff6-b393-54f3-8621-68b284e47ac3" :answer-field/correct "837