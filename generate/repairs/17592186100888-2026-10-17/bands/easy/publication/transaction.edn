55e931510240" :answer/type :answer.type/text] [:db/add "e396c4fd-71c1-59bc-9209-55e931510240" :answer/value "false"] [:db/ensure "e396c4fd-71c1-59bc-9209-55e931510240" :answer/validate] [:db/add "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/id #uuid "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7"] [:db/add "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/type :answer.type/text] [:db/add "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/value "true"] [:db/ensure "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7" :answer/validate] [:db/add "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/id #uuid "6808e726-3826-52a1-816d-23e80ef6d446"] [:db/add "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/key "III"] [:db/add "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/type :answer-field.type/checkbox] [:db/add "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/choices "e396c4fd-71c1-59bc-9209-55e931510240"] [:db/add "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/choices "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7"] [:db/add "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/correct "e6df26ad-bd81-5aaa-81e2-ef34d75cdbe7"] [:db/ensure "6808e726-3826-52a1-816d-23e80ef6d446" :answer-field/validate] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/id #uuid "628c5962-9540-54e0-a743-71b039507ef9"] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=2 e^{- y},\\qquad 2 x - 3>0\n$$\n\nLet $f(x)=\\ln{\\left(2 x - 3 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{2}{2 x - 3}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation."] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=\\ln{\\left(2 x - 3 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\ln{\\left(2 x - 3 \\right)}\\right)\\prime \\\\ &=\\frac{1}{2 x - 3}\\cdot 2 \\\\ &=\\frac{2}{2 x - 3}\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=\\ln{\\left(2 x - 3 \\right)}$ and $y\\prime=\\frac{2}{2 x - 3}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}2 e^{- y} \\\\ \\frac{2}{2 x - 3} &\\overset{?}{=}\\frac{2}{e^{\\ln{\\left(2 x - 3 \\right)}}} \\\\ \\frac{2}{2 x - 3} &=\\frac{2}{2 x - 3}\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=\\ln{\\left(2 x - 3 \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"I, II, and III.\""] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/difficulty :question.difficulty/easy] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/answer-fields "b30d6233-d2d5-5248-b659-81906ac6d588"] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/answer-fields "7b09d08b-9296-54a5-9074-0d5f596c8957"] [:db/add "628c5962-9540-54e0-a743-71b039507ef9" :question/answer-fields "6808e726-3826-52a1-816d-23e80ef6d446"] [:db/ensure "628c5962-9540-54e0-a743-71b039507ef9" :question/validate] [:db/add 17592186100888 :knowledge-point/questions "628c5962-9540-54e0-a743-71b039507ef9"] [:db/add "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/id #uuid "66b843bb-147d-5696-b9c6-20fb6aa9e3df"] [:db/add "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/type :answer.type/text] [:db/add "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/value "false"] [:db/ensure "66b843bb-147d-5696-b9c6-20fb6aa9e3df" :answer/validate] [:db/add "07f2b71f-67b4-5220-b1f2-f9c9f3e2990b" :answer/id #uuid "07f2b71f-67b4-5220-b1f2-f9c9f3e2990b"] [:db/add "07f2b7