-e114-565a-97e3-fbb6d888f0b9" :answer-field/id #uuid "096de02a-e114-565a-97e3-fbb6d888f0b9"] [:db/add "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/key "II"] [:db/add "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/type :answer-field.type/checkbox] [:db/add "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/choices "5ea23ce8-56d6-5036-b822-761465ad590a"] [:db/add "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/choices "1fef22b4-1658-51c4-9d88-3a9f9308339c"] [:db/add "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/correct "1fef22b4-1658-51c4-9d88-3a9f9308339c"] [:db/ensure "096de02a-e114-565a-97e3-fbb6d888f0b9" :answer-field/validate] [:db/add "de6723ce-80d6-57fe-8de5-5cb46fe33516" :answer/id #uuid "de6723ce-80d6-57fe-8de5-5cb46fe33516"] [:db/add "de6723ce-80d6-57fe-8de5-5cb46fe33516" :answer/type :answer.type/text] [:db/add "de6723ce-80d6-57fe-8de5-5cb46fe33516" :answer/value "false"] [:db/ensure "de6723ce-80d6-57fe-8de5-5cb46fe33516" :answer/validate] [:db/add "2b443023-21e5-58dc-940b-af2ebf834ebf" :answer/id #uuid "2b443023-21e5-58dc-940b-af2ebf834ebf"] [:db/add "2b443023-21e5-58dc-940b-af2ebf834ebf" :answer/type :answer.type/text] [:db/add "2b443023-21e5-58dc-940b-af2ebf834ebf" :answer/value "true"] [:db/ensure "2b443023-21e5-58dc-940b-af2ebf834ebf" :answer/validate] [:db/add "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/id #uuid "e5208678-d293-56eb-9202-f5253a4e87ee"] [:db/add "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/key "III"] [:db/add "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/type :answer-field.type/checkbox] [:db/add "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/choices "de6723ce-80d6-57fe-8de5-5cb46fe33516"] [:db/add "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/choices "2b443023-21e5-58dc-940b-af2ebf834ebf"] [:db/add "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/correct "2b443023-21e5-58dc-940b-af2ebf834ebf"] [:db/ensure "e5208678-d293-56eb-9202-f5253a4e87ee" :answer-field/validate] [:db/add "77fe441e-45a2-5d51-93a8-f4ea8416fd0f" :question/id #uuid "77fe441e-45a2-5d51-93a8-f4ea8416fd0f"] [:db/add "77fe441e-45a2-5d51-93a8-f4ea8416fd0f" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=4 e^{- y},\\qquad 4 x>0\n$$\n\nLet $f(x)=\\ln{\\left(4 x \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{1}{2 x}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation."] [:db/add "77fe441e-45a2-5d51-93a8-f4ea8416fd0f" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is false. Differentiating $f(x)=\\ln{\\left(4 x \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(\\ln{\\left(4 x \\right)}\\right)\\prime \\\\ &=\\frac{1}{4 x}\\cdot 4 \\\\ &=\\frac{1}{x} \\\\ &\\not\\equiv \\frac{1}{2 x}\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=\\ln{\\left(4 x \\right)}$ and $y\\prime=\\frac{1}{x}$ into the original equation gives an identity:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}4 e^{- y} \\\\ \\frac{1}{x} &\\overset{?}{=}\\frac{4}{e^{\\ln{\\left(4 x \\right)}}} \\\\ \\frac{1}{x} &=\\frac{1}{x}\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=\\ln{\\left(4 x \\right)}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"II and III only.\""] [:db/add "77fe441e-45a2-5d51-93a8-f4ea8416fd0f" :question/difficulty :question.difficulty/easy] [:db/add "77fe441e-45a2-5d51-93a8-f4ea8416fd0f" :question/answer-fields "dd93e2fe-3095-5286-9d73-03800c413ede"] [:db/add "77fe441e-45a2-5d51-93a8-f4ea8416fd0f" :question