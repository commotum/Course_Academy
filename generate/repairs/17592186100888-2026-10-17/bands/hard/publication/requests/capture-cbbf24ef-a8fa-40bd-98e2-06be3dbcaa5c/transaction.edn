0-f344-53f9-9b87-6cfd5386e6ef"] [:db/add "9abd5e60-f344-53f9-9b87-6cfd5386e6ef" :answer/type :answer.type/text] [:db/add "9abd5e60-f344-53f9-9b87-6cfd5386e6ef" :answer/value "true"] [:db/ensure "9abd5e60-f344-53f9-9b87-6cfd5386e6ef" :answer/validate] [:db/add "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/id #uuid "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c"] [:db/add "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/key "III"] [:db/add "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/type :answer-field.type/checkbox] [:db/add "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/choices "99ad3c8a-d899-5f30-9f69-f2953849fa2e"] [:db/add "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/choices "9abd5e60-f344-53f9-9b87-6cfd5386e6ef"] [:db/add "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/correct "99ad3c8a-d899-5f30-9f69-f2953849fa2e"] [:db/ensure "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c" :answer-field/validate] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/id #uuid "a098865b-a0f4-5d9b-a304-bd75a306b510"] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/problem "Consider the following differential equation.\n\n$$\ny\\prime=6 e^{- \\frac{y}{3}},\\qquad 4 x + 4>0\n$$\n\nLet $f(x)=3 \\ln{\\left(4 x + 4 \\right)}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f\\prime(x)=\\frac{12}{4 x + 4}.$\n- **II.** Substituting $y=f(x)$ and $y\\prime=f\\prime(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation."] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in an interval where the function is defined and the equation is valid.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=3 \\ln{\\left(4 x + 4 \\right)},$ we get\n\n$$\n\\begin{aligned}f\\prime(x)&=\\left(3 \\ln{\\left(4 x + 4 \\right)}\\right)\\prime \\\\ &=3\\cdot\\frac{4}{4 x + 4} \\\\ &=\\frac{12}{4 x + 4}\\end{aligned}\n$$\n\n- Statement II is false. Substituting $y=3 \\ln{\\left(4 x + 4 \\right)}$ and $y\\prime=\\frac{12}{4 x + 4}$ into the original equation gives expressions that are not identical:\n\n$$\n\\begin{aligned}y\\prime &\\overset{?}{=}6 e^{- \\frac{y}{3}} \\\\ \\frac{12}{4 x + 4} &\\overset{?}{=}6e^{-(3 \\ln{\\left(4 x + 4 \\right)})/(3)} \\\\ \\frac{12}{4 x + 4} &\\overset{?}{=}6e^{-\\ln(4 x + 4)} \\\\ \\frac{12}{4 x + 4} &\\not\\equiv \\frac{3}{2 \\left(x + 1\\right)}\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, the function $y=3 \\ln{\\left(4 x + 4 \\right)}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/difficulty :question.difficulty/hard] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/answer-fields "61085ad0-ae6c-5fc4-974f-fb93aeef646c"] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/answer-fields "4712b020-9702-5c3c-a3ff-cabe5f1d6dfc"] [:db/add "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/answer-fields "9a3ad4a5-9e8c-538b-8578-c03c5ca4643c"] [:db/ensure "a098865b-a0f4-5d9b-a304-bd75a306b510" :question/validate] [:db/add 17592186100888 :knowledge-point/questions "a098865b-a0f4-5d9b-a304-bd75a306b510"] [:db/add "91cca939-abfa-579c-ba0f-76aed088ff08" :answer/id #uuid "91cca939-abfa-579c-ba0f-76aed088ff08"] [:db/add "91cca939-abfa-579c-ba0f-76aed088ff08" :answer/type :answer.type/text] [:db/add "91cca939-abfa-579c-ba0f-76aed088ff08" :answer/value "false"] [:db/ensure "91cca939-abfa-579c-ba0f-76aed088ff08" :answer/validate] [:db/add "3fc0976d-8848-5bc7-a8ba-c6fb66573dfe" :answer/id #uuid "3fc0976d-8848-5bc7-a8ba-c6fb66573dfe"] [:db/add "3fc0976d-8848-5bc7-a8ba-c6fb66573dfe" :answer/type :answer.type/text] [:db/add "3fc0976d-8848-5bc7-a8ba-c6fb66573dfe" :a