\\left(7 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(7^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"] [:db/add "922d3bb0-0ec2-5812-bd5a-686a0a1d2d3a" :question/difficulty :question.difficulty/easy] [:db/add "922d3bb0-0ec2-5812-bd5a-686a0a1d2d3a" :question/answer-fields "7e16e56f-f02c-5f1e-90e0-65ae4cb3b8c7"] [:db/ensure "922d3bb0-0ec2-5812-bd5a-686a0a1d2d3a" :question/validate] [:db/add 17592186096617 :knowledge-point/questions "922d3bb0-0ec2-5812-bd5a-686a0a1d2d3a"] [:db/add "73eeb177-fa56-5e28-88c3-c06d587a93db" :answer/id #uuid "73eeb177-fa56-5e28-88c3-c06d587a93db"] [:db/add "73eeb177-fa56-5e28-88c3-c06d587a93db" :answer/type :answer.type/math] [:db/add "73eeb177-fa56-5e28-88c3-c06d587a93db" :answer/value "- 2 e^{x} \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}"] [:db/ensure "73eeb177-fa56-5e28-88c3-c06d587a93db" :answer/validate] [:db/add "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec" :answer/id #uuid "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec"] [:db/add "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec" :answer/type :answer.type/math] [:db/add "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec" :answer/value "2 e^{x} \\cos{\\left(x \\right)} + \\sin{\\left(x \\right)}"] [:db/ensure "8380cb0c-f99b-5edc-8bcb-df0b4edd19ec" :answer/validate] [:db/add "1c2a69dd-025f-5be8-980e-f66236939db9" :answer/id #uuid "1c2a69dd-025f-5be8-980e-f66236939db9"] [:db/add "1c2a69dd-025f-5be8-980e-f66236939db9" :answer/type :answer.type/math] [:db/add "1c2a69dd-025f-5be8-980e-f66236939db9" :answer/value "2 e^{x} \\sin{\\left(x \\right)} + 2 e^{x} \\cos{\\left(x \\right)}"] [:db/ensure "1c2a69dd-025f-5be8-980e-f66236939db9" :answer/validate] [:db/add "eee2ca73-2f04-51ce-9964-2aff5fa07bd0" :answer/id #uuid "eee2ca73-2f04-51ce-9964-2aff5fa07bd0"] [:db/add "eee2ca73-2f04-51ce-9964-2aff5fa07bd0" :answer/type :answer.type/math] [:db/add "eee2ca73-2f04-51ce-9964-2aff5fa07bd0" :answer/value "- 2 e^{x} \\sin{\\left(x \\right)} - 2 e^{x} \\cos{\\left(x \\right)}"] [:db/ensure "eee2ca73-2f04-51ce-9964-2aff5fa07bd0" :