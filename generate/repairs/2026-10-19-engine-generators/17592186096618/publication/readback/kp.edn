c-9d0f-18e1bc3899cb" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3){log}_{3}(x)" :db/id #edb/ref 17592186298462}] :answer-field/correct {:answer/id #uuid "d2303e32-8b26-55ec-9d0f-18e1bc3899cb" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3){log}_{3}(x)" :db/id #edb/ref 17592186298462} :answer-field/id #uuid "792dd6e3-1db8-586c-a5f7-0da2170dac92" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299050}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d825ca35-2305-5442-afb6-a99517062893" :question/math-academy-id "q-320814" :question/problem "Given that $f(x)={3}^{x}{log}_{3}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)={log}_{3}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({3}^{x})}^{′}{log}_{3}⁡(x)+{3}^{x}{({log}_{3}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))({log}_{3}⁡(x))+({3}^{x})\\left(\\frac{1}{x\\operatorname{ln}⁡(3)}\\right) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3){log}_{3}⁡(x)+\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca46b1c5-ece7-5119-abe8-777dcc7ec3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{x\\operatorname{ln}(4)}" :db/id #edb/ref 17592186298433}] :answer-field/correct {:answer/id #uuid "ca46b1c5-ece7-5119-abe8-777dcc7ec3b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{x\\operatorname{ln}(4)}" :db/id #edb/ref 17592186298433} :answer-field/id #uuid "0aa44b57-7202-5d5a-9c5f-cd88604e7d86" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298669}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6161762d-7ca8-5487-95de-c569a1e07882" :question/math-academy-id "q-320815" :question/problem "Given that $f(x)={4}^{x}{log}_{4}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)={4}^{x}$ and $v(x)={log}_{4}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({4}^{x})}^{′}{log}_{4}⁡(x)+{4}^{x}{({log}_{4}⁡(x))}^{′} \\\\  & =({4}^{x}\\operatorname{ln}⁡(4))({log}_{4}⁡(x))+({4}^{x})\\left(\\frac{1}{x\\operatorname{ln}⁡(4)}\\right) \\\\  & ={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)+\\frac{{4}^{x}}{x\\operatorname{ln}⁡(4)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e34c232-975f-51cf-8ed5-ecf0f78eff8c" :answer/type {:db/ident :answer.type/math} :answer/value "-{5}^{-x}\\operatorname{ln}(5){log}_{7}(x)" :db/id #edb/ref 17592186297797} {:answer/id #uuid "8a591582-6e6f-4147-9d4d-ddb81a77153c" :answer/type {:db/ident :answer.type/math} :answer/value "-5^{-x}\\ln5\\left(\\log_7x\\right)" :db/id #edb/ref 17592186576151}] :answer-field/correct {:answer/id #uuid "3e34c232-975f-51cf-8ed5-ecf0f78eff8c" :answer/type {:db/ident :answer.type/math} :answer/value "-{5}^{-x}\\operatorname{ln}(5){log}_{7}(x)" :db/id #edb/ref 17592186297797} :answer-field/id #uuid "3b389b0c-f96f-5746-b4d1-da5e3f5fb10c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298838}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "42b535b3-90b5-5bc5-bbb3-36d4082e369c" :question/math-academy-id "q-320816" :question/problem "Given that $f(x)={5}^{-x}{log}_{7}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{5}^{-x}}{xln⁡(7)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={5}^{-x}$ and $v(x)={log}_{7}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({5}^{-x})}^{′}{log}_{7}⁡(x)+{5}^{-x}{({log}_{7}⁡(x))}^{′} \\\\  & =(-{5}^{-x}ln⁡(5))({log}_{7}⁡(x))+({5}^{-x})\\left(\\frac{1}{xln⁡(7)}\\right) \\\\  & =-{5}^{-x}ln⁡(5){log}_{7}⁡(x)+\\frac{{5}^{-x}}{xln⁡(7)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2}(x)\\log(x)" :db/id #edb/ref 17592186571265}] :answer-field/correct {:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" :answer/type {:db/ident :answer.type/math} :answer/value "\\sec^{2}(x)\\log(x)" :db/id #edb/ref 17592186571265} :answer-field/id #uuid "0af8eb9f-fc24-5d73-ad75-f548e3ea3646" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571289}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "303e2b76-22b6-55f6-abfa-1986d9ab5f9d" :question/math-academy-id "q-320820" :question/problem "Given that $f(x)=\\operatorname{tan}⁡(x)\\operatorname{log}⁡(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\operatorname{log}⁡(x)={log}_{10}⁡(x)$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{\\operatorname{tan}⁡(x)}{x\\operatorname{ln}⁡(10)}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\operatorname{tan}⁡(x)$ and $v(x)=\\operatorname{log}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{tan}⁡(x))}^{′}\\operatorname{log}⁡(x)+\\operatorname{tan}⁡(x){(\\operatorname{log}⁡(x))}^{′} \\\\  & =({sec}^{2}⁡(x))(\\operatorname{log}⁡(x))+(\\operatorname{tan}⁡(x))\\left(\\frac{1}{x\\operatorname{ln}⁡(10)}\\right) \\\\  & ={sec}^{2}⁡(x)\\operatorname{log}⁡(x)+\\frac{\\operatorname{tan}⁡(x)}{x\\operatorname{ln}⁡(10)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} {:answer/id #uuid "205ae525-2c88-43fd-ab44-a800dec93096" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\ln x+x+\\frac{3}{x}" :db/id #edb/ref 17592186576147}] :answer-field/correct {:answer/id #uuid "ddbe9744-04e5-5a13-898b-3293efe4160f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{2}+3}{x}" :db/id #edb/ref 17592186571233} :answer-field/id #uuid "b6a34341-fe46-5049-b63f-03fb79ef67af" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186571353}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f475b19b-1e35-517e-8f15-4fa3d740b6ba" :question/math-academy-id "q-320824" :question/problem "Given that $f(x)=({x}^{2}+3)\\operatorname{ln}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=2x\\operatorname{ln}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}+3$ and $v(x)=\\operatorname{ln}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2}+3)}^{′}\\operatorname{ln}⁡(x)+({x}^{2}+3){(\\operatorname{ln}⁡(x))}^{′} \\\\  & =(2x)(\\operatorname{ln}⁡(x))+({x}^{2}+3)\\left(\\frac{1}{x}\\right) \\\\  & =2x\\operatorname{ln}⁡(x)+\\frac{{x}^{2}+3}{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186586552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04e9a10c-b454-5d9e-b42d-a5b4e64d2a81" :answer/type {:db/ident :answer.type/math} :answer/value "3^x\\ln(3)\\cos(x)" :db/id #edb/ref 17592186585886}] :answer-field/correct {:answer/id #uuid "04e9a10c-b454-5d9e-b42d-a5b4e64d2a81" :answer/type {:db/ident :answer.type/math} :answer/value "3^x\\ln(3)\\cos(x)" :db/id #edb/ref 17592186585886} :answer-field/id #uuid "517709e9-f87f-51ef-86e5-3a7246853549" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186586429}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4aaf1474-44f2-53a9-ae70-2c44030b9b58" :question/math-academy-id "q-311231" :question/problem "Given that $f(x)={3}^{x}\\operatorname{cos}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $-\\,{3}^{x}\\operatorname{sin}⁡(x)$" :question/worked-solution "Here, we have the product of two functions $u(x)={3}^{x}$ and $v(x)=\\operatorname{cos}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({3}^{x})}^{′}\\operatorname{cos}⁡(x)+{3}^{x}{(\\operatorname{cos}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))\\operatorname{cos}⁡(x)+{3}^{x}(-\\operatorname{sin}⁡(x)) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3)\\operatorname{cos}⁡(x)-{3}^{x}\\operatorname{sin}⁡(x)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186586560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c287098-fdb2-58e8-8342-956a1ff9deb0" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586034} {:answer/id #uuid "612c3980-83e9-5078-8f02-eb7e2291e335" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{2{e}^{x}}{\\sqrt{x}}" :db/id #edb/ref 17592186586063} {:answer/id #uuid "81086a0e-a325-51b9-93a4-e249186b89b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586132} {:answer/id #uuid "ab530418-5692-5073-9efb-8e7255b84fd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586226} {:answer/id #uuid "b967f191-c4fe-5e66-b7f6-f73c7faf9b66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+x{e}^{x}}{\\sqrt{x}}" :db/id #edb/ref 17592186586246}] :answer-field/correct {:answer/id #uuid "ab530418-5692-5073-9efb-8e7255b84fd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186586226} :answer-field/id #uuid "3c400dff-bed5-5d41-986f-72a99df176f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186586417}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "64d86353-289c-5c4c-a5f5-b6e2b66703e2" :question/math-academy-id "q-47954" :question/problem "Given that $f(x)=\\sqrt{x}{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\sqrt{x}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\sqrt{x})^{′}\\cdot {e}^{x}+\\sqrt{x}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{2\\sqrt{x}}{e}^{x}+\\sqrt{x}{e}^{x} \\\\  & =\\frac{{e}^{x}+2x{e}^{x}}{2\\sqrt{x}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0847027d-bd26-57f8-9403-9e4eb6cdf358" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(11\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186657611} {:answer/id #uuid "3e3cc552-b13d-5424-9879-4f15ac541649" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(10\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186657615} {:answer/id #uuid "921c17d0-1976-5b3a-915c-86d80055277b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186657621} {:answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(12\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186657622} {:answer/id #uuid "bffd7eb9-1ef0-5aae-98d8-18005e448afe" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(9\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186657624}] :answer-field/correct {:answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(12\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)" :db/id #edb/ref 17592186657622} :answer-field/id #uuid "571e7da4-8bf0-538e-b7aa-3f10b987cbb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657617}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/problem "Given that $f(x) = 6\\log_{5} x\\ln x$, find $f^{′}(x)$." :question/worked-solution "Here, we have the product of two functions $u(x)=6\\log_{5} x$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(6\\log_{5} x)^{′}\\ln x+6\\log_{5} x(\\ln x)^{′} \\\\  & =(\\frac{6}{x \\ln{\\left(5 \\right)}})(\\ln x)+(6\\log_{5} x)(\\frac{1}{x}) \\\\  & =\\frac{6\\log_{5} x}{x} + \\frac{6\\ln x}{x\\ln 5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657609} {:answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657616} {:answer/id #uuid "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(0\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657626} {:answer/id #uuid "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-1\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657628} {:answer/id #uuid "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-1\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657629}] :answer-field/correct {:answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657616} :answer-field/id #uuid "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657630}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/problem "Given that $f(x) = x^{-2}\\log_{4} x$, find $f^{′}(x)$." :question/worked-solution "Here, we have the product of two functions $u(x)=x^{-2}$ and $v(x)=\\log_{4} x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(x^{-2})^{′}\\log_{4} x+x^{-2}(\\log_{4} x)^{′} \\\\  & =(- \\frac{2}{x^{3}})(\\log_{4} x)+(x^{-2})(\\frac{1}{x \\ln{\\left(4 \\right)}}) \\\\  & =x^{-3}(-2\\log_{4} x + \\frac{1}{\\ln 4})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2^{x} \\ln{\\left(2 \\right)} \\ln{\\left(x \\right)}}{\\ln{\\left(7 \\right)}}" :db/id #edb/ref 17592186657610}] :answer-field/correct {:answer/id #uuid "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2^{x} \\ln{\\left(2 \\right)} \\ln{\\left(x \\right)}}{\\ln{\\left(7 \\right)}}" :db/id #edb/ref 17592186657610} :answer-field/id #uuid "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657614}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/problem "Given that $f(x)={2}^{x}\\log _{7} (x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{2^{x}}{x \\ln{\\left(7 \\right)}}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={2}^{x}$ and $v(x)=\\log _{7} (x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({2}^{x})}^{′}\\log _{7} (x)+{2}^{x}{(\\log _{7} (x))}^{′} \\\\  & =({2}^{x}\\ln  (2))(\\log _{7} (x))+({2}^{x})(\\frac{1}{x\\ln  (7)}) \\\\  & ={2}^{x}\\ln  (2)\\log _{7} (x)+\\frac{{2}^{x}}{x\\ln  (7)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\ln{\\left(10 \\right)}}" :db/id #edb/ref 17592186657625}] :answer-field/correct {:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\ln{\\left(10 \\right)}}" :db/id #edb/ref 17592186657625} :answer-field/id #uuid "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657618}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "b796de74-72c4-529b-b038-a4d67224a125" :question/problem "Given that $f(x)=\\tan(x)\\log(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\log(x)=\\log_{10}(x)$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{\\tan{\\left(x \\right)}}{x \\ln{\\left(10 \\right)}}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\tan(x)$ and $v(x)=\\log(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\tan(x))^{′}\\log(x)+\\tan(x)(\\log(x))^{′} \\\\  & =(\\sec^{2}(x))(\\log(x))+(\\tan(x))(\\frac{1}{x\\ln(10)}) \\\\  & =\\sec^{2}(x)\\log(x)+\\frac{\\tan(x)}{x\\ln(10)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620}] :answer-field/correct {:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620} :answer-field/id #uuid "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657631}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/problem "Given that $f(x)=({x}^{3}+4)\\ln(x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=3 x^{2} \\ln{\\left(x \\right)}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=({x}^{3}+4)$ and $v(x)=\\ln(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(({x}^{3}+4))^{′}\\ln(x)+({x}^{3}+4)(\\ln(x))^{′} \\\\  & =(3{x}^{2})(\\ln(x))+({x}^{3}+4)(\\frac{1}{x}) \\\\  & =3{x}^{2}\\ln(x)+\\frac{{x}^{3}+4}{x}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}]}
