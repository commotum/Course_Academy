f5099b"] [:db/add "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/problem "Given that $f(x) = 6\\log_{5} x\\ln x$, find $f^{′}(x)$."] [:db/add "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/worked-solution "Here, we have the product of two functions $u(x)=6\\log_{5} x$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(6\\log_{5} x)^{′}\\ln x+6\\log_{5} x(\\ln x)^{′} \\\\  & =(\\frac{6}{x \\ln{\\left(5 \\right)}})(\\ln x)+(6\\log_{5} x)(\\frac{1}{x}) \\\\  & =\\frac{6\\log_{5} x}{x} + \\frac{6\\ln x}{x\\ln 5}\\end{aligned}\n$$"] [:db/add "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/difficulty :question.difficulty/easy] [:db/add "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/answer-fields "571e7da4-8bf0-538e-b7aa-3f10b987cbb7"] [:db/ensure "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/validate] [:db/add 17592186096618 :knowledge-point/questions "0bcc9f93-4f3c-5124-8641-edf082f5099b"] [:db/add "generator" :question-generator/id #uuid "660f448b-996d-51ca-96b2-1f1874f969d6"] [:db/add "generator" :question-generator/script "generators/f5/f51b9059708e5efae3794d79ff1f81534269d4843a7013759e9781a1af819e02/generator.py"] [:db/add 17592186096618 :knowledge-point/question-generator "generator"] [:db/ensure 17592186096618 :knowledge-point/validate]]
