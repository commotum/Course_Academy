[[:db/add "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c"] [:db/add "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type :answer.type/math] [:db/add "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/value "\\frac{x^{3} + 4}{x}"] [:db/ensure "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/validate] [:db/add "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/id #uuid "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1"] [:db/add "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/key "field-1"] [:db/add "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/type :answer-field.type/blank] [:db/add "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/choices "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c"] [:db/add "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/correct "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c"] [:db/ensure "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/validate] [:db/add "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/id #uuid "dd5b6598-4397-5f58-8be5-6a17f6668cbf"] [:db/add "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/problem "Given that $f(x)=({x}^{3}+4)\\ln(x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=3 x^{2} \\ln{\\left(x \\right)}\\,+$\n{{field-1}}"] [:db/add "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/worked-solution "Here, we have the product of two functions $u(x)=({x}^{3}+4)$ and $v(x)=\\ln(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(({x}^{3}+4))^{′}\\ln(x)+({x}^{3}+4)(\\ln(x))^{′} \\\\  & =(3{x}^{2})(\\ln(x))+({x}^{3}+4)(\\frac{1}{x}) \\\\  & =3{x}^{2}\\ln(x)+\\frac{{x}^{3}+4}{x}\\end{aligned}\n$$"] [:db/add "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/difficulty :question.difficulty/easy] [:db/add "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/answer-fields "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1"] [:db/ensure "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/validate] [:db/add 17592186096618 :knowledge-point/questions "dd5b6598-4397-5f58-8be5-6a17f6668cbf"] [:db/add "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/id #uuid "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b"] [:db/add "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/type :answer.type/math] [:db/add "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/value "\\left(-1\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)"] [:db/ensure "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/validate] [:db/add "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/id #uuid "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1"] [:db/add "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/type :answer.type/math] [:db/add "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(0\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)"] [:db/ensure "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/validate] [:db/add "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec"] [:db/add "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type :answer.type/math] [:db/add "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)"] [:db/ensure "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/validate] [:db/add "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/id #uuid "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe"] [:db/add "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/type :answer.type/math] [:db/add "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/value "\\left(-2\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)"] [:db/ensure "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/validate] [:db/add "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/id #uuid "e96037dc-192b-5953-9f3f-a01cce4af599"] [:db/add "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/type :answer.type/math] [:db/add "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/value "\\left(-1\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x^{3} \\ln{\\left(4 \\right)}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)"] [:db/ensure "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/validate] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/id #uuid "f6fe5e07-85dc-5fb0-a386-89122bedaa05"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/key "selection"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/type :answer-field.type/radio] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/choices "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/choices "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/choices "43131dd5-cd59-5802-b52a-0f14d66ec6ec"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/choices "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/choices "e96037dc-192b-5953-9f3f-a01cce4af599"] [:db/add "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/correct "43131dd5-cd59-5802-b52a-0f14d66ec6ec"] [:db/ensure "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/validate] [:db/add "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/id #uuid "18f3eb93-e574-5f5a-8279-040ddcf04567"] [:db/add "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/problem "Given that $f(x) = x^{-2}\\log_{4} x$, find $f^{′}(x)$."] [:db/add "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/worked-solution "Here, we have the product of two functions $u(x)=x^{-2}$ and $v(x)=\\log_{4} x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(x^{-2})^{′}\\log_{4} x+x^{-2}(\\log_{4} x)^{′} \\\\  & =(- \\frac{2}{x^{3}})(\\log_{4} x)+(x^{-2})(\\frac{1}{x \\ln{\\left(4 \\right)}}) \\\\  & =x^{-3}(-2\\log_{4} x + \\frac{1}{\\ln 4})\\end{aligned}\n$$"] [:db/add "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/difficulty :question.difficulty/easy] [:db/add "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/answer-fields "f6fe5e07-85dc-5fb0-a386-89122bedaa05"] [:db/ensure "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/validate] [:db/add 17592186096618 :knowledge-point/questions "18f3eb93-e574-5f5a-8279-040ddcf04567"] [:db/add "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0"] [:db/add "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type :answer.type/math] [:db/add "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/value "\\frac{\\ln{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\ln{\\left(10 \\right)}}"] [:db/ensure "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/validate] [:db/add "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/id #uuid "66f0f5cd-b5e5-5b2f-b843-1258c616a836"] [:db/add "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/key "field-1"] [:db/add "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/type :answer-field.type/blank] [:db/add "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/choices "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0"] [:db/add "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/correct "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0"] [:db/ensure "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/validate] [:db/add "b796de74-72c4-529b-b038-a4d67224a125" :question/id #uuid "b796de74-72c4-529b-b038-a4d67224a125"] [:db/add "b796de74-72c4-529b-b038-a4d67224a125" :question/problem "Given that $f(x)=\\tan(x)\\log(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\log(x)=\\log_{10}(x)$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{\\tan{\\left(x \\right)}}{x \\ln{\\left(10 \\right)}}$"] [:db/add "b796de74-72c4-529b-b038-a4d67224a125" :question/worked-solution "Here, we have the product of two functions $u(x)=\\tan(x)$ and $v(x)=\\log(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\tan(x))^{′}\\log(x)+\\tan(x)(\\log(x))^{′} \\\\  & =(\\sec^{2}(x))(\\log(x))+(\\tan(x))(\\frac{1}{x\\ln(10)}) \\\\  & =\\sec^{2}(x)\\log(x)+\\frac{\\tan(x)}{x\\ln(10)}\\end{aligned}\n$$"] [:db/add "b796de74-72c4-529b-b038-a4d67224a125" :question/difficulty :question.difficulty/easy] [:db/add "b796de74-72c4-529b-b038-a4d67224a125" :question/answer-fields "66f0f5cd-b5e5-5b2f-b843-1258c616a836"] [:db/ensure "b796de74-72c4-529b-b038-a4d67224a125" :question/validate] [:db/add 17592186096618 :knowledge-point/questions "b796de74-72c4-529b-b038-a4d67224a125"] [:db/add "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/id #uuid "06f8e988-371d-5570-a38a-e5d41a7860f1"] [:db/add "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/type :answer.type/math] [:db/add "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/value "\\frac{2^{x} \\ln{\\left(2 \\right)} \\ln{\\left(x \\right)}}{\\ln{\\left(7 \\right)}}"] [:db/ensure "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/validate] [:db/add "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/id #uuid "23643de0-4f04-5b7d-97e1-51f4725c1a04"] [:db/add "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/key "field-1"] [:db/add "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/type :answer-field.type/blank] [:db/add "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/choices "06f8e988-371d-5570-a38a-e5d41a7860f1"] [:db/add "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/correct "06f8e988-371d-5570-a38a-e5d41a7860f1"] [:db/ensure "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/validate] [:db/add "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/id #uuid "726b77c9-4439-577a-8549-9ccc83c65f8b"] [:db/add "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/problem "Given that $f(x)={2}^{x}\\log _{7} (x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{2^{x}}{x \\ln{\\left(7 \\right)}}$"] [:db/add "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/worked-solution "Here, we have the product of the two functions $u(x)={2}^{x}$ and $v(x)=\\log _{7} (x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({2}^{x})}^{′}\\log _{7} (x)+{2}^{x}{(\\log _{7} (x))}^{′} \\\\  & =({2}^{x}\\ln  (2))(\\log _{7} (x))+({2}^{x})(\\frac{1}{x\\ln  (7)}) \\\\  & ={2}^{x}\\ln  (2)\\log _{7} (x)+\\frac{{2}^{x}}{x\\ln  (7)}\\end{aligned}\n$$"] [:db/add "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/difficulty :question.difficulty/easy] [:db/add "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/answer-fields "23643de0-4f04-5b7d-97e1-51f4725c1a04"] [:db/ensure "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/validate] [:db/add 17592186096618 :knowledge-point/questions "726b77c9-4439-577a-8549-9ccc83c65f8b"] [:db/add "921c17d0-1976-5b3a-915c-86d80055277b" :answer/id #uuid "921c17d0-1976-5b3a-915c-86d80055277b"] [:db/add "921c17d0-1976-5b3a-915c-86d80055277b" :answer/type :answer.type/math] [:db/add "921c17d0-1976-5b3a-915c-86d80055277b" :answer/value "\\left(8\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)"] [:db/ensure "921c17d0-1976-5b3a-915c-86d80055277b" :answer/validate] [:db/add "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484"] [:db/add "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type :answer.type/math] [:db/add "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/value "\\left(12\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)"] [:db/ensure "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/validate] [:db/add "0847027d-bd26-57f8-9403-9e4eb6cdf358" :answer/id #uuid "0847027d-bd26-57f8-9403-9e4eb6cdf358"] [:db/add "0847027d-bd26-57f8-9403-9e4eb6cdf358" :answer/type :answer.type/math] [:db/add "0847027d-bd26-57f8-9403-9e4eb6cdf358" :answer/value "\\left(11\\right)\\left(\\frac{\\ln{\\left(x \\right)}}{x \\ln{\\left(5 \\right)}}\\right)"] [:db