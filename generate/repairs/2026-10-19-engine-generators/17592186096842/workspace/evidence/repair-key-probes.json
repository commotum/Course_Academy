[{"label": "-\\frac{1}{(2x-6)^{3/2}}", "record": {"knowledge_point": {"db_id": 17592186096842, "id": "2f0cdac9-57b2-5634-8d98-d6adf8a85204", "title": "Differentiating a Radical Function Using the Chain Rule"}, "question": {":question/id": "7dfd2620-cd69-500f-aa57-8533ff1cf35d", ":question/difficulty": ":question.difficulty/moderate", ":question/problem": "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{2x-6}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}", ":question/worked-solution": "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x-6.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 2 \\\\  & =-\\frac{1}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{1}{\\sqrt{(2x-6)^{3}}}.\\end{aligned}\n$$", ":question/answer-fields": [{":answer-field/id": "a9786fd5-646c-5a38-9a99-5d0d5a4a53ad", ":answer-field/key": "field-1", ":answer-field/type": ":answer-field.type/blank", ":answer-field/choices": [{":answer/id": "fa343ae8-a8f1-5266-a937-762c6aee68af", ":answer/type": ":answer.type/math", ":answer/value": "-\\frac{1}{(2x-6)^{3/2}}"}], ":answer-field/correct": [":answer/id", "fa343ae8-a8f1-5266-a937-762c6aee68af"]}]}, "generation": {"generator_version": "radical-chain-2", "template": "reciprocal_blank", "seed": 0, "parameters": {"a": 2, "b": -6}, "bank_profile": "blank", "bank_origin": "observed single expression fragment", "source": {"database": "math", "basis": 3951, "lineage": "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1"}, "source_ids": ["q-342764"], "source_repair": false, "domain": "2x-6>0", "plot_rating": "none", "parameter_fingerprint": "93c76c0d0a5a83f7954f1249efc3ebd8f