b-33de-5df5-aa85-ed357c5eb5e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{4x + 3}}" :db/id #edb/ref 17592186095475} {:answer/id #uuid "fd120f87-d6a9-56e7-ae4f-db302afd2580" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x + 3}}" :db/id #edb/ref 17592186095476} {:answer/id #uuid "7f7778bb-8979-5802-bf93-4a409e6e58b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{4x - 3}}" :db/id #edb/ref 17592186095477}] :answer-field/id #uuid "84ab9969-a822-5aa8-beea-30e48f66c60f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095472}] :question/id #uuid "ea97309c-a67a-5e7f-aa97-023276ac6669" :question/math-academy-id "q-48846" :question/problem "Given that $y = \\sqrt{4x - 3}$, find $\\frac{dy}{dx}$."} {:db/id #edb/ref 17592186244040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cec937-8f89-509c-89d8-cac2418dad31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12\\sqrt{3-6x}}" :db/id #edb/ref 17592186241525} {:answer/id #uuid "48530683-52e3-5b2d-b80c-52c96ea80021" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186241833} {:answer/id #uuid "6ea096e1-e11d-5b2f-9a38-2f0713ebe775" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186242165} {:answer/id #uuid "afef1e77-e7bb-55d4-85fd-246b46e4f2ed" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186242713} {:answer/id #uuid "eb52bd30-42b5-564a-b65a-5b27e7b61017" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\sqrt{3-6x}}" :db/id #edb/ref 17592186243264}] :answer-field/correct {:answer/id #uuid "afef1e77-e7bb-55d4-85fd-246b46e4f2ed" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{3-6x}}" :db/id #edb/ref 17592186242713} :answer-field/id #uuid "beb44a20-d166-5fe6-a7bc-aa72ceec3cb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243776}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0ce97e32-c8a9-5155-bb70-6cb7385360f5" :question/math-academy-id "q-107291" :question/problem "Given that $y=\\sqrt{3-6x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3-6x.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-6) \\\\  & =-\\frac{3}{\\sqrt{3-6x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186244048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b523831-f11c-5631-b1d0-55d429e9b570" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186241281} {:answer/id #uuid "321ef9b3-dc8b-5b99-b689-dfe8d1c4cf58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186241620} {:answer/id #uuid "501d0fb0-7ccb-548e-bb3a-b18b59d46b6f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241894} {:answer/id #uuid "8cf3df5e-c66f-522b-838e-722473ef4ed3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186242424} {:answer/id #uuid "99c71189-09eb-555b-8519-9b447439afc6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186242524}] :answer-field/correct {:answer/id #uuid "501d0fb0-7ccb-548e-bb3a-b18b59d46b6f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186241894} :answer-field/id #uuid "19320ca1-b053-535e-b992-542e4931ff17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243482}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c8b46779-d19f-5cca-987d-5f500a9de334" :question/math-academy-id "q-107360" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{1-4x}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=1-4x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-4) \\\\  & =-\\frac{2}{\\sqrt{1-4x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={\\left(-\\frac{2}{\\sqrt{1-4x}}\\right)|}_{x=-2} \\\\  & =-\\frac{2}{\\sqrt{1-4(-2)}} \\\\  & =-\\frac{2}{3}\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186297398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb26afef-455b-5297-b622-9e232fa102cc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{(2x+7)^{3}}}" :db/id #edb/ref 17592186296332} {:answer/id #uuid "80839a19-547c-4ca2-94bb-993fa3f9a75b" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186577458} {:answer/id #uuid "bdcd2965-c659-42b4-96df-25a652585597" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(2x\\right)" :db/id #edb/ref 17592186577459} {:answer/id #uuid "886e5238-5128-4041-b4c9-6957e06baf70" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(2x+7\\right)" :db/id #edb/ref 17592186577460} {:answer/id #uuid "cd0bf0d4-06da-4ccd-9691-c576056d141e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(2x+7\\right)^{-}" :db/id #edb/ref 17592186577461} {:answer/id #uuid "cab10951-ff4e-46a1-9533-9c912f129e25" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(2x+7\\right)^{-\\frac{3}{\\placeholder{}}}" :db/id #edb/ref 17592186577462} {:answer/id #uuid "fbe2d8e8-70df-4e73-95b1-9c1880cd800a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(2x+7\\right)^{-\\frac32}" :db/id #edb/ref 17592186577463}] :answer-field/correct {:answer/id #uuid "cb26afef-455b-5297-b622-9e232fa102cc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{(2x+7)^{3}}}" :db/id #edb/ref 17592186296332} :answer-field/id #uuid "69dfefe3-2eb8-5512-ab7d-eb2788925109" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296855}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2300bd8f-e3d1-544c-8ad1-127cb2f0bedc" :question/math-academy-id "q-314194" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{2x+7}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x+7.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 2 \\\\  & =-\\frac{1}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{1}{\\sqrt{(2x+7{)}^{3}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3cdb155-0bd1-58bc-961e-1bfa7707dad6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{\\sqrt{{x}^{2}-6x}}" :db/id #edb/ref 17592186316217} {:answer/id #uuid "6547e4e5-5934-4e34-acb1-3afb5ae5bf10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\left(x-3\\right)}{\\sqrt{x^2-6x}}" :db/id #edb/ref 17592186576552}] :answer-field/correct {:answer/id #uuid "c3cdb155-0bd1-58bc-961e-1bfa7707dad6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x-3}{\\sqrt{{x}^{2}-6x}}" :db/id #edb/ref 17592186316217} :answer-field/id #uuid "fd768cbb-f716-59e5-acc7-6f058b68d4ef" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317150}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1f8a23e9-b484-592c-83ed-60ed3cc8b897" :question/math-academy-id "q-342680" :question/problem "Given that $y=\\sqrt{{x}^{2}-6x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u={x}^{2}-6x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x-6.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot (2x-6) \\\\  & =\\frac{2(x-3)}{2\\sqrt{{x}^{2}-6x}} \\\\  & =\\frac{x-3}{\\sqrt{{x}^{2}-6x}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317313 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8316ace3-a7b2-57fb-a2e0-d20a2908d622" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2\\sqrt{3x+6}}" :db/id #edb/ref 17592186315844}] :answer-field/correct {:answer/id #uuid "8316ace3-a7b2-57fb-a2e0-d20a2908d622" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2\\sqrt{3x+6}}" :db/id #edb/ref 17592186315844} :answer-field/id #uuid "b7c696cc-7f33-5839-8d2a-38d27e70f63c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316978}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c93d262c-d38e-53b1-ba9c-9af520b2e82c" :question/math-academy-id "q-342683" :question/problem "Given that $y=\\sqrt{3x+6}$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3x+6.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot 3 \\\\  & =\\frac{3}{2\\sqrt{3x+6}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317321 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea0b074e-9124-53da-b940-4a0beab23775" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2\\sqrt{(5x+1)^{3}}}" :db/id #edb/ref 17592186316419} {:answer/id #uuid "4abe05c3-0f06-52ad-8909-cbe4491128f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2(5x+1)^{3/2}}" :db/id #edb/ref 17592186524509} {:answer/id #uuid "41e5e3a5-9d36-48a7-bc0f-19bdd775286f" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186576469} {:answer/id #uuid "9562bb93-b2ba-493b-b623-c0b002ef200c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac52" :db/id #edb/ref 17592186576470} {:answer/id #uuid "79ba6767-590d-47b0-8fdc-a86a2e93a19a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac52\\left(\\right)" :db/id #edb/ref 17592186576471} {:answer/id #uuid "24c1f001-0d0c-4e27-9152-530789816a6e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac52\\left(5x\\right)" :db/id #edb/ref 17592186576472} {:answer/id #uuid "f3bdc8ea-ee8f-4bfc-8c2b-63128b70751d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac52\\left(5x+1\\right)" :db/id #edb/ref 17592186576473}] :answer-field/correct {:answer/id #uuid "4abe05c3-0f06-52ad-8909-cbe4491128f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2(5x+1)^{3/2}}" :db/id #edb/ref 17592186524509} :answer-field/id #uuid "cae0bf8f-009f-5cd9-a958-5250470d215a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317025}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "65a56fb3-c803-55e2-851b-d52f4cc805e8" :question/math-academy-id "q-342764" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{5x+1}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=5x+1.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 5 \\\\  & =-\\frac{5}{2\\sqrt{{u}^{3}}} \\\\  & =-\\frac{5}{2\\sqrt{(5x+1)^{3}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186317326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22c57943-65ff-5d5d-81f8-1002a59bb417" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186315311}] :answer-field/correct {:answer/id #uuid "22c57943-65ff-5d5d-81f8-1002a59bb417" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186315311} :answer-field/id #uuid "4e7bce52-e2d7-50a5-a44d-84c8a8cc1d7d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186316728}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "febc6c25-71ff-51d9-b851-6f19e65ebcd1" :question/math-academy-id "q-342802" :question/problem "The slope of the tangent to the curve $y=\\frac{1}{\\sqrt{3{x}^{2}+12x}}$ at the point where $x=2$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+12x.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x+12.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot (6x+12) \\\\  & =-\\frac{6x+12}{2\\sqrt{(3{x}^{2}+12x{)}^{3}}}.\\end{aligned}\n$$\n\nFinally, substituting $x=2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={\\left(-\\frac{6x+12}{2\\sqrt{(3{x}^{2}+12x{)}^{3}}}\\right)|}_{x=2} \\\\  & =-\\frac{6(2)+12}{2\\sqrt{(3(2{)}^{2}+12(2){)}^{3}}} \\\\  & =-\\frac{24}{2\\sqrt{{36}^{3}}} \\\\  & =-\\frac{1}{18}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186520487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454a250f-2e0e-5eff-ad08-2e1a4569c3b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2x-1}}" :db/id #edb/ref 17592186520091} {:answer/id #uuid "4cf36f6a-ac30-5d76-9499-88f79530ef58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2x-1}}" :db/id #edb/ref 17592186520108} {:answer/id #uuid "a63c2527-a87a-5317-bb52-435b49980a68" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{2x-1}}" :db/id #edb/ref 17592186520218} {:answer/id #uuid "ceae46e6-5020-51b1-a35e-422b64ddda99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{2x-1}}" :db/id #edb/ref 17592186520281} {:answer/id #uuid "edcc6c31-a212-5340-8bdb-e1b0f8c22746" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4\\sqrt{2x-1}}" :db/id #edb/ref 17592186520341}] :answer-field/correct {:answer/id #uuid "454a250f-2e0e-5eff-ad08-2e1a4569c3b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2x-1}}" :db/id #edb/ref 17592186520091} :answer-field/id #uuid "7e463a5a-0bf7-5c15-8a84-e8fb513aab4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186520404}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "98cde390-f268-5ffd-9f2f-31f016a0c432" :question/math-academy-id "q-107303" :question/problem "Given that $y=\\sqrt{2x-1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x-1.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 2 \\\\  & =\\frac{1}{\\sqrt{u}} \\\\  & =\\frac{1}{\\sqrt{2x-1}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186520516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c7c493-bcdb-5703-aa16-7951eec23ed2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186520068} {:answer/id #uuid "961a1fb5-7dbb-4d31-93ea-cbe5abcbdc15" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x+1}}" :db/id #edb/ref 17592186576511}] :answer-field/correct {:answer/id #uuid "33c7c493-bcdb-5703-aa16-7951eec23ed2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186520068} :answer-field/id #uuid "3b694189-fec1-5a06-8456-a524e215acf6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186520382}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fa666076-05a3-50c7-be3d-b7a39d6d4f55" :question/math-academy-id "q-314192" :question/problem "The slope of the tangent to the curve $y=\\sqrt{4x+1}$ at the point where $x=0$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=4x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 4 \\\\  & =\\frac{4}{2\\sqrt{4x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=0,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={\\left(\\frac{4}{2\\sqrt{4x+1}}\\right)|}_{x=0} \\\\  & =\\frac{4}{2\\sqrt{4(0)+1}} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186524983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc8d190d-9c67-5acd-8583-f14a36220ea6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524684}] :answer-field/correct {:answer/id #uuid "bc8d190d-9c67-5acd-8583-f14a36220ea6" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186524684} :answer-field/id #uuid "f05471f2-c115-5266-86b4-2c4bebd70c45" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186524945}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "45936e93-e188-5489-9cc9-795dad15e0d6" :question/math-academy-id "q-342792" :question/problem "The slope of the tangent to the curve $y=\\sqrt{3{x}^{2}+2x}$ at the point where $x=-1$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+2x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x+2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (6x+2) \\\\  & =\\frac{6x+2}{2\\sqrt{3{x}^{2}+2x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-1,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-1} & ={\\left(\\frac{6x+2}{2\\sqrt{3{x}^{2}+2x}}\\right)|}_{x=-1} \\\\  & =\\frac{6(-1)+2}{2\\sqrt{3(-1)^{2}+2(-1)}} \\\\  & =\\frac{-4}{2\\sqrt{1}} \\\\  & =-2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186542130 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "496974f1-cd7b-5abe-b03b-8caf3c2ef7ba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186541574}] :answer-field/correct {:answer/id #uuid "496974f1-cd7b-5abe-b03b-8caf3c2ef7ba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186541574} :answer-field/id #uuid "6df6c47b-c813-591d-800c-7da989a956a4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186542020}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "316d8b52-05f5-5660-9987-6f2357a674ed" :question/math-academy-id "q-342789" :question/problem "The slope of the tangent to the curve $y=\\sqrt{-{x}^{2}+2x}$ at the point where $x=1$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-{x}^{2}+2x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2x+2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-2x+2) \\\\  & =\\frac{-2x+2}{2\\sqrt{-{x}^{2}+2x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=1,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={\\left(\\frac{-2x+2}{2\\sqrt{-{x}^{2}+2x}}\\right)|}_{x=1} \\\\  & =\\frac{-2(1)+2}{2\\sqrt{-{1}^{2}+2(1)}} \\\\  & =\\frac{0}{2\\sqrt{1}} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186542221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "365d6570-d8cb-539f-a88f-8f59a136deaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{145}{2}" :db/id #edb/ref 17592186541535} {:answer/id #uuid "a8e65a94-bc73-5511-b4e0-737b7fd4a52d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186541771} {:answer/id #uuid "ba942dc9-148d-5089-895a-5986590e89c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{289}{2}" :db/id #edb/ref 17592186541806} {:answer/id #uuid "dfa31f6a-0231-55ef-b7c1-eda435cc6895" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{73}{2}" :db/id #edb/ref 17592186541897} {:answer/id #uuid "fb45a9d2-d3cd-5774-a7e6-b9653552ab14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{33}{2}" :db/id #edb/ref 17592186541949}] :answer-field/correct {:answer/id #uuid "ba942dc9-148d-5089-895a-5986590e89c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{289}{2}" :db/id #edb/ref 17592186541806} :answer-field/id #uuid "02bb9c7f-0a51-5ad4-a60d-65bfb06add50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186541965}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ed421aa6-2e1d-544f-a145-c01b981f6e83" :question/math-academy-id "q-20181" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{x-3}+3{x}^{3}$ at the point where $x=4.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nLet $f(x)=\\sqrt{x-3}.$ We use the chain rule in the form\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=x-3.$ Then $f=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 1 \\\\  & =\\frac{1}{2\\sqrt{u}} \\\\  & =\\frac{1}{2\\sqrt{x-3}}.\\end{aligned}\n$$\n\nApplying the sum rule, we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2\\sqrt{x-3}}+9{x}^{2}.\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & =\\frac{1}{2\\sqrt{4-3}}+9(4)^{2} \\\\  & =\\frac{1}{2}+144 \\\\  & =\\frac{289}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186557259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49385517-eeac-5b31-adab-df094762881b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556593} {:answer/id #uuid "604e0e8a-a825-50c3-a298-9ae13e709a27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186556648} {:answer/id #uuid "9404be8d-cb6c-53b2-8a36-eb362e775360" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186556786} {:answer/id #uuid "95cb350d-4388-53ea-9992-f43b19639582" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186556791} {:answer/id #uuid "9b3dc5f8-2374-5afe-8f07-96ed5f7a5da8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186556807}] :answer-field/correct {:answer/id #uuid "49385517-eeac-5b31-adab-df094762881b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186556593} :answer-field/id #uuid "add9725c-6d77-5248-a0ae-02fe439fa683" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557163}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67f07fb8-cc06-5cda-9a1f-cc029f68242d" :question/math-academy-id "q-107288" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{2x+1}$ at the point where $x=4.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 2 \\\\  & =\\frac{1}{\\sqrt{2x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & ={\\left(\\frac{1}{\\sqrt{2x+1}}\\right)|}_{x=4} \\\\  & =\\frac{1}{\\sqrt{2(4)+1}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186572150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2440da94-c49c-5b97-93a3-f1f305aaf546" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571599} {:answer/id #uuid "4dfdfa0c-df5d-578c-9e5a-030e1e19fe81" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186571679} {:answer/id #uuid "67441758-f1aa-545c-a9ad-7fa7f49bf8b9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186571715} {:answer/id #uuid "fb5ed5a3-55f9-5465-8515-fdd310345cd7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186571970} {:answer/id #uuid "fd4a6f37-6e13-59de-b1f0-4ae8dde2510a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186571976}] :answer-field/correct {:answer/id #uuid "2440da94-c49c-5b97-93a3-f1f305aaf546" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186571599} :answer-field/id #uuid "5afb038d-0b31-5d55-8f54-c760388f6c4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186572027}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "87ece511-fd94-56a1-8fa2-055336c9156b" :question/math-academy-id "q-48848" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{3{x}^{2}+24}$ at the point where $x=-2.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=3{x}^{2}+24.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2\\sqrt{u}}\\cdot 6x \\\\  & =\\frac{3x}{\\sqrt{3{x}^{2}+24}}.\\end{aligned}\n$$\n\nFinally, substituting  $x=-2,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-2} & ={\\left(\\frac{3x}{\\sqrt{3{x}^{2}+24}}\\right)|}_{x=-2} \\\\  & =\\frac{(-6)}{\\sqrt{3(-2)^{2}+24}} \\\\  & =-\\frac{6}{6} \\\\  & =-1\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186597617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9590648e-813f-5f78-bbce-a306642395c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186597161}] :answer-field/correct {:answer/id #uuid "9590648e-813f-5f78-bbce-a306642395c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186597161} :answer-field/id #uuid "4a09aa38-da73-5206-b879-af0b3659206a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186597437}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "fb1316e2-9fcc-5550-830c-f3a945a647f2" :question/math-academy-id "q-342787" :question/problem "The slope of the tangent to the curve $y=\\sqrt{6x+1}$ at the point where $x=4$ is{{field-1}}." :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=6x+1.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot 6 \\\\  & =\\frac{6}{2\\sqrt{6x+1}}.\\end{aligned}\n$$\n\nFinally, substituting $x=4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=4} & ={\\left(\\frac{6}{2\\sqrt{6x+1}}\\right)|}_{x=4} \\\\  & =\\frac{6}{2\\sqrt{6(4)+1}} \\\\  & =\\frac{6}{2\\sqrt{25}} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5821db7a-52c1-5685-ac1f-a24dea525453" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2\\sqrt{4x+3}}" :db/id #edb/ref 17592186657666} {:answer/id #uuid "896f4fb3-780c-5394-a7c4-2c48f10ada9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2\\sqrt{4x+3}}" :db/id #edb/ref 17592186657673} {:answer/id #uuid "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{4x+3}}" :db/id #edb/ref 17592186657678} {:answer/id #uuid "e78062d7-2943-58e7-8f8a-56e43f8a7b3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{4x+3}}" :db/id #edb/ref 17592186657681} {:answer/id #uuid "ff390e11-93f5-5e2b-b5a0-81c8b17df467" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x+3}}" :db/id #edb/ref 17592186657683}] :answer-field/correct {:answer/id #uuid "ff390e11-93f5-5e2b-b5a0-81c8b17df467" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{4x+3}}" :db/id #edb/ref 17592186657683} :answer-field/id #uuid "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657670}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/problem "Given that $y=\\sqrt{4x+3},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=4x+3.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (4) \\\\  & =\\frac{2}{\\sqrt{u}} \\\\  & =\\frac{2}{\\sqrt{4x+3}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{(2x-6)^{3}}}" :db/id #edb/ref 17592186657669}] :answer-field/correct {:answer/id #uuid "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{(2x-6)^{3}}}" :db/id #edb/ref 17592186657669} :answer-field/id #uuid "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657661}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "99c047a7-758b-5db9-9256-347c7b790ef5" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{2x-6}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x-6.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 2 \\\\  & =-\\frac{1}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{1}{\\sqrt{(2x-6)^{3}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3441c0fe-baf2-58ec-be43-0bc6b1dc52bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(12-2x)^{\\frac{3}{2}}}" :db/id #edb/ref 17592186657663} {:answer/id #uuid "38fa11e4-1ab5-5a61-9543-a49af6fcfcde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(12-2x)^{\\frac{3}{2}}}" :db/id #edb/ref 17592186657665} {:answer/id #uuid "7194ccdf-1cf5-5662-86a2-61c314c00de0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2(12-2x)^{\\frac{3}{2}}}" :db/id #edb/ref 17592186657668} {:answer/id #uuid "8179b0e5-d27d-5436-849a-0b6a81884973" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2(12-2x)^{\\frac{3}{2}}}" :db/id #edb/ref 17592186657671} {:answer/id #uuid "d8efcb49-91d1-50ec-ad3e-649069f99598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{(12-2x)^{\\frac{3}{2}}}" :db/id #edb/ref 17592186657679}] :answer-field/correct {:answer/id #uuid "38fa11e4-1ab5-5a61-9543-a49af6fcfcde" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(12-2x)^{\\frac{3}{2}}}" :db/id #edb/ref 17592186657665} :answer-field/id #uuid "1d105e46-25ee-5153-a38b-ae7c0422f899" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657660}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ab67789f-4616-5914-aa8d-59736a54c4f6" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{-2x+12}}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-2x+12.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot (-2) \\\\  & =\\frac{1}{\\sqrt{(-2x+12{)}^{3}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35aba803-7e19-5f64-ae12-70549369c0c9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{(8x+2)^{3}}}" :db/id #edb/ref 17592186657664}] :answer-field/correct {:answer/id #uuid "35aba803-7e19-5f64-ae12-70549369c0c9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{(8x+2)^{3}}}" :db/id #edb/ref 17592186657664} :answer-field/id #uuid "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657659}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{8x+2}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=8x+2.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 8 \\\\  & =-\\frac{4}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{4}{\\sqrt{(8x+2)^{3}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657682 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ad8cba-4c43-5466-991c-8f58f1b2c414" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{-7x-6}}" :db/id #edb/ref 17592186657657} {:answer/id #uuid "31e7578d-8b52-580a-afa3-98f20764e7e7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{2\\sqrt{-7x-6}}" :db/id #edb/ref 17592186657662} {:answer/id #uuid "6da4c05a-424b-5485-beff-b0b4d9364431" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2\\sqrt{-7x-6}}" :db/id #edb/ref 17592186657667} {:answer/id #uuid "856b17f1-3e5d-5e34-99a4-069fedec4af0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{\\sqrt{-7x-6}}" :db/id #edb/ref 17592186657672} {:answer/id #uuid "96693fb7-81ed-5735-a956-5196bd2f34a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{\\sqrt{-7x-6}}" :db/id #edb/ref 17592186657675}] :answer-field/correct {:answer/id #uuid "31e7578d-8b52-580a-afa3-98f20764e7e7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{2\\sqrt{-7x-6}}" :db/id #edb/ref 17592186657662} :answer-field/id #uuid "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657658}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/problem "Given that $y=\\sqrt{-6-7x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-6-7x.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-7.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-7) \\\\  & =-\\frac{7}{2\\sqrt{-6-7x}}.\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Radical Function Using the Chain Rule"}]}
