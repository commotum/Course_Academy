d}u}{\\text{d}x}=-2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot (-2) \\\\  & =\\frac{1}{\\sqrt{(-2x+12{)}^{3}}}.\\end{aligned}\n$$"] [:db/add "ab67789f-4616-5914-aa8d-59736a54c4f6" :question/difficulty :question.difficulty/moderate] [:db/add "ab67789f-4616-5914-aa8d-59736a54c4f6" :question/answer-fields "1d105e46-25ee-5153-a38b-ae7c0422f899"] [:db/ensure "ab67789f-4616-5914-aa8d-59736a54c4f6" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "ab67789f-4616-5914-aa8d-59736a54c4f6"] [:db/add "generator" :question-generator/id #uuid "eb1e532d-86c7-511f-9e95-e418689ac150"] [:db/add "generator" :question-generator/script "generators/f2/f2e28f3a0d0677c48b52dfa4d9467314a67845f5b1a52d46a7e19b565e72c024/generator.py"] [:db/add 17592186096842 :knowledge-point/question-generator "generator"] [:db/ensure 17592186096842 :knowledge-point/validate]]
