[[:db/add "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/id #uuid "73f4d5cf-a461-500b-bfff-59db9cb0a932"] [:db/add "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/type :answer.type/math] [:db/add "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/value "-\\frac{1}{\\sqrt{(2x-6)^{3}}}"] [:db/ensure "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/validate] [:db/add "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/id #uuid "1d327192-03f4-5c34-804d-23703a9d60c8"] [:db/add "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/key "field-1"] [:db/add "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/type :answer-field.type/blank] [:db/add "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/choices "73f4d5cf-a461-500b-bfff-59db9cb0a932"] [:db/add "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/correct "73f4d5cf-a461-500b-bfff-59db9cb0a932"] [:db/ensure "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/validate] [:db/add "99c047a7-758b-5db9-9256-347c7b790ef5" :question/id #uuid "99c047a7-758b-5db9-9256-347c7b790ef5"] [:db/add "99c047a7-758b-5db9-9256-347c7b790ef5" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{2x-6}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}"] [:db/add "99c047a7-758b-5db9-9256-347c7b790ef5" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x-6.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 2 \\\\  & =-\\frac{1}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{1}{\\sqrt{(2x-6)^{3}}}.\\end{aligned}\n$$"] [:db/add "99c047a7-758b-5db9-9256-347c7b790ef5" :question/difficulty :question.difficulty/moderate] [:db/add "99c047a7-758b-5db9-9256-347c7b790ef5" :question/answer-fields "1d327192-03f4-5c34-804d-23703a9d60c8"] [:db/ensure "99c047a7-758b-5db9-9256-347c7b790ef5" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "99c047a7-758b-5db9-9256-347c7b790ef5"] [:db/add "96693fb7-81ed-5735-a956-5196bd2f34a8" :answer/id #uuid "96693fb7-81ed-5735-a956-5196bd2f34a8"] [:db/add "96693fb7-81ed-5735-a956-5196bd2f34a8" :answer/type :answer.type/math] [:db/add "96693fb7-81ed-5735-a956-5196bd2f34a8" :answer/value "-\\frac{5}{\\sqrt{-7x-6}}"] [:db/ensure "96693fb7-81ed-5735-a956-5196bd2f34a8" :answer/validate] [:db/add "31e7578d-8b52-580a-afa3-98f20764e7e7" :answer/id #uuid "31e7578d-8b52-580a-afa3-98f20764e7e7"] [:db/add "31e7578d-8b52-580a-afa3-98f20764e7e7" :answer/type :answer.type/math] [:db/add "31e7578d-8b52-580a-afa3-98f20764e7e7" :answer/value "-\\frac{7}{2\\sqrt{-7x-6}}"] [:db/ensure "31e7578d-8b52-580a-afa3-98f20764e7e7" :answer/validate] [:db/add "6da4c05a-424b-5485-beff-b0b4d9364431" :answer/id #uuid "6da4c05a-424b-5485-beff-b0b4d9364431"] [:db/add "6da4c05a-424b-5485-beff-b0b4d9364431" :answer/type :answer.type/math] [:db/add "6da4c05a-424b-5485-beff-b0b4d9364431" :answer/value "-\\frac{9}{2\\sqrt{-7x-6}}"] [:db/ensure "6da4c05a-424b-5485-beff-b0b4d9364431" :answer/validate] [:db/add "856b17f1-3e5d-5e34-99a4-069fedec4af0" :answer/id #uuid "856b17f1-3e5d-5e34-99a4-069fedec4af0"] [:db/add "856b17f1-3e5d-5e34-99a4-069fedec4af0" :answer/type :answer.type/math] [:db/add "856b17f1-3e5d-5e34-99a4-069fedec4af0" :answer/value "-\\frac{4}{\\sqrt{-7x-6}}"] [:db/ensure "856b17f1-3e5d-5e34-99a4-069fedec4af0" :answer/validate] [:db/add "00ad8cba-4c43-5466-991c-8f58f1b2c414" :answer/id #uuid "00ad8cba-4c43-5466-991c-8f58f1b2c414"] [:db/add "00ad8cba-4c43-5466-991c-8f58f1b2c414" :answer/type :answer.type/math] [:db/add "00ad8cba-4c43-5466-991c-8f58f1b2c414" :answer/value "-\\frac{3}{\\sqrt{-7x-6}}"] [:db/ensure "00ad8cba-4c43-5466-991c-8f58f1b2c414" :answer/validate] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/id #uuid "02bdd7f6-dc11-5437-83b6-6f0871573543"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/key "selection"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/type :answer-field.type/radio] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/choices "96693fb7-81ed-5735-a956-5196bd2f34a8"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/choices "31e7578d-8b52-580a-afa3-98f20764e7e7"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/choices "6da4c05a-424b-5485-beff-b0b4d9364431"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/choices "856b17f1-3e5d-5e34-99a4-069fedec4af0"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/choices "00ad8cba-4c43-5466-991c-8f58f1b2c414"] [:db/add "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/correct "31e7578d-8b52-580a-afa3-98f20764e7e7"] [:db/ensure "02bdd7f6-dc11-5437-83b6-6f0871573543" :answer-field/validate] [:db/add "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/id #uuid "f48647ea-8ebd-5583-b713-aef1cac5a291"] [:db/add "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/problem "Given that $y=\\sqrt{-6-7x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$"] [:db/add "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-6-7x.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-7.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (-7) \\\\  & =-\\frac{7}{2\\sqrt{-6-7x}}.\\end{aligned}\n$$"] [:db/add "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/difficulty :question.difficulty/moderate] [:db/add "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/answer-fields "02bdd7f6-dc11-5437-83b6-6f0871573543"] [:db/ensure "f48647ea-8ebd-5583-b713-aef1cac5a291" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "f48647ea-8ebd-5583-b713-aef1cac5a291"] [:db/add "e78062d7-2943-58e7-8f8a-56e43f8a7b3a" :answer/id #uuid "e78062d7-2943-58e7-8f8a-56e43f8a7b3a"] [:db/add "e78062d7-2943-58e7-8f8a-56e43f8a7b3a" :answer/type :answer.type/math] [:db/add "e78062d7-2943-58e7-8f8a-56e43f8a7b3a" :answer/value "\\frac{1}{2\\sqrt{4x+3}}"] [:db/ensure "e78062d7-2943-58e7-8f8a-56e43f8a7b3a" :answer/validate] [:db/add "ff390e11-93f5-5e2b-b5a0-81c8b17df467" :answer/id #uuid "ff390e11-93f5-5e2b-b5a0-81c8b17df467"] [:db/add "ff390e11-93f5-5e2b-b5a0-81c8b17df467" :answer/type :answer.type/math] [:db/add "ff390e11-93f5-5e2b-b5a0-81c8b17df467" :answer/value "\\frac{2}{\\sqrt{4x+3}}"] [:db/ensure "ff390e11-93f5-5e2b-b5a0-81c8b17df467" :answer/validate] [:db/add "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5" :answer/id #uuid "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5"] [:db/add "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5" :answer/type :answer.type/math] [:db/add "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5" :answer/value "\\frac{1}{\\sqrt{4x+3}}"] [:db/ensure "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5" :answer/validate] [:db/add "5821db7a-52c1-5685-ac1f-a24dea525453" :answer/id #uuid "5821db7a-52c1-5685-ac1f-a24dea525453"] [:db/add "5821db7a-52c1-5685-ac1f-a24dea525453" :answer/type :answer.type/math] [:db/add "5821db7a-52c1-5685-ac1f-a24dea525453" :answer/value "\\frac{3}{2\\sqrt{4x+3}}"] [:db/ensure "5821db7a-52c1-5685-ac1f-a24dea525453" :answer/validate] [:db/add "896f4fb3-780c-5394-a7c4-2c48f10ada9f" :answer/id #uuid "896f4fb3-780c-5394-a7c4-2c48f10ada9f"] [:db/add "896f4fb3-780c-5394-a7c4-2c48f10ada9f" :answer/type :answer.type/math] [:db/add "896f4fb3-780c-5394-a7c4-2c48f10ada9f" :answer/value "\\frac{5}{2\\sqrt{4x+3}}"] [:db/ensure "896f4fb3-780c-5394-a7c4-2c48f10ada9f" :answer/validate] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/id #uuid "74026f16-a351-5b82-a094-4d783b5f71be"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/key "selection"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/type :answer-field.type/radio] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/choices "e78062d7-2943-58e7-8f8a-56e43f8a7b3a"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/choices "ff390e11-93f5-5e2b-b5a0-81c8b17df467"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/choices "b3a0983b-55bc-545c-b0a0-d6ac4873d0e5"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/choices "5821db7a-52c1-5685-ac1f-a24dea525453"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/choices "896f4fb3-780c-5394-a7c4-2c48f10ada9f"] [:db/add "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/correct "ff390e11-93f5-5e2b-b5a0-81c8b17df467"] [:db/ensure "74026f16-a351-5b82-a094-4d783b5f71be" :answer-field/validate] [:db/add "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/id #uuid "90db644a-fd4a-5c58-b43a-e0452a6336d1"] [:db/add "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/problem "Given that $y=\\sqrt{4x+3},$ find $\\frac{\\text{d}y}{\\text{d}x}.$"] [:db/add "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=4x+3.$ Then $y=\\sqrt{u}={u}^{1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2}{u}^{-1/2}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (4) \\\\  & =\\frac{2}{\\sqrt{u}} \\\\  & =\\frac{2}{\\sqrt{4x+3}}.\\end{aligned}\n$$"] [:db/add "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/difficulty :question.difficulty/moderate] [:db/add "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/answer-fields "74026f16-a351-5b82-a094-4d783b5f71be"] [:db/ensure "90db644a-fd4a-5c58-b43a-e0452a6336d1" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "90db644a-fd4a-5c58-b43a-e0452a6336d1"] [:db/add "35aba803-7e19-5f64-ae12-70549369c0c9" :answer/id #uuid "35aba803-7e19-5f64-ae12-70549369c0c9"] [:db/add "35aba803-7e19-5f64-ae12-70549369c0c9" :answer/type :answer.type/math] [:db/add "35aba803-7e19-5f64-ae12-70549369c0c9" :answer/value "-\\frac{4}{\\sqrt{(8x+2)^{3}}}"] [:db/ensure "35aba803-7e19-5f64-ae12-70549369c0c9" :answer/validate] [:db/add "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/id #uuid "114eabe9-88a9-521f-991b-55f2cc647709"] [:db/add "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/key "field-1"] [:db/add "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/type :answer-field.type/blank] [:db/add "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/choices "35aba803-7e19-5f64-ae12-70549369c0c9"] [:db/add "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/correct "35aba803-7e19-5f64-ae12-70549369c0c9"] [:db/ensure "114eabe9-88a9-521f-991b-55f2cc647709" :answer-field/validate] [:db/add "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/id #uuid "e61f263e-2780-5a15-b73e-edd6546f8ecb"] [:db/add "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{8x+2}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}"] [:db/add "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=8x+2.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 8 \\\\  & =-\\frac{4}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{4}{\\sqrt{(8x+2)^{3}}}.\\end{aligned}\n$$"] [:db/add "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/difficulty :question.difficulty/moderate] [:db/add "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/answer-fields "114eabe9-88a9-521f-991b-55f2cc647709"] [:db/ensure "e61f263e-2780-5a15-b73e-edd6546f8ecb" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "e61f263e-2780-5a15-b73e-edd6546f8ecb"] [:db/add "8179b0e5-d27d-5436-849a-0b6a81884973" :answer/id #uuid "8179b0e5-d27d-5436-849a-0b6a81884973"] [:db/add "8179b0e5-d27d-5436-849a-0b6a81884973" :answer/type :answer.type/math] [:db/add "8179b0e5-d27d-5436-849a-0b6a81884973" :answer/value "\\frac{5}{2(12-2x)^{\\frac{3}{2}}}"] [:db/ensure "8179b0e5-d27d-5436-849a-0b6a81884973" :answer/validate] [:db/add "3441c0fe-baf2-58ec-be43-0bc6b1dc52bb" :answer/id #uuid "3441c0fe-baf2-58ec-be43-0bc6b1dc52bb"] [:db/add "3441c0fe-baf2-58ec-be43-0bc6b1dc52bb" :answer/type :answer.type/math] [:db/add "3441c0fe-baf2-58ec-be43-0bc6b1dc52bb" :answer/value "\\frac{3}{(12-2x)^{\\frac{3}{2}}}"] [:db/ensure "3441c0fe-baf2-58ec-be43-0bc6b1dc52bb" :answer/validate] [:db/add "38fa11e4-1ab5-5a61-9543-a49af6fcfcde" :answer/id #uuid "38fa11e4-1ab5-5a61-9543-a49af6fcfcde"] [:db/add "38fa11e4-1ab5-5a61-9543-a49af6fcfcde" :answer/type :answer.type/math] [:db/add "38fa11e4-1ab5-5a61-9543-a49af6fcfcde" :answer/value "\\frac{1}{(12-2x)^{\\frac{3}{2}}}"] [:db/ensure "38fa11e4-1ab5-5a61-9543-a49af6fcfcde" :answer/validate] [:db/add "d8efcb49-91d1-50ec-ad3e-649069f99598" :answer/id #uuid "d8efcb49-91d1-50ec-ad3e-649069f99598"] [:db/add "d8efcb49-91d1-50ec-ad3e-649069f99598" :answer/type :answer.type/math] [:db/add "d8efcb49-91d1-50ec-ad3e-649069f99598" :answer/value "\\frac{2}{(12-2x)^{\\frac{3}{2}}}"] [:db/ensure "d8efcb49-91d1-50ec-ad3e-649069f99598" :answer/validate] [:db/add "7194ccdf-1cf5-5662-86a2-61c314c00de0" :a