#{[{:db/id #edb/ref 17592186657676 :knowledge-point/_questions [{:db/id #edb/ref 17592186096842 :knowledge-point/id #uuid "2f0cdac9-57b2-5634-8d98-d6adf8a85204" :knowledge-point/title "Differentiating a Radical Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{(2x-6)^{3}}}" :db/id #edb/ref 17592186657669}] :answer-field/correct {:answer/id #uuid "73f4d5cf-a461-500b-bfff-59db9cb0a932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{(2x-6)^{3}}}" :db/id #edb/ref 17592186657669} :answer-field/id #uuid "1d327192-03f4-5c34-804d-23703a9d60c8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657661}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99c047a7-758b-5db9-9256-347c7b790ef5" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{1}{\\sqrt{2x-6}}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=2x-6.$ Then $y=\\frac{1}{\\sqrt{u}}={u}^{-1/2}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-\\frac{1}{2}{u}^{-3/2}=-\\frac{1}{2\\sqrt{{u}^{3}}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{2\\sqrt{{u}^{3}}}\\cdot 2 \\\\  & =-\\frac{1}{\\sqrt{{u}^{3}}} \\\\  & =-\\frac{1}{\\sqrt{(2x-6)^{3}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657627 :knowledge-point/_questions [{:db/id #edb/ref 17592186096618 :knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8" :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620}] :answer-field/correct {:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620} :answer-field/id #uuid "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657631}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/problem "Given that $f(x)=({x}^{3}+4)\\ln(x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=3 x^{2} \\ln{\\left(x \\right)}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=({x}^{3}+4)$ and $v(x)=\\ln(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(({x}^{3}+4))^{′}\\ln(x)+({x}^{3}+4)(\\ln(x))^{′} \\\\  & =(3{x}^{2})(\\ln(x))+({x}^{3}+4)(\\frac{1}{x}) \\\\  & =3{x}^{2}\\ln(x)+\\frac{{x}^{3}+4}{x}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657636 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c1c75b8-e26c-5124-9d8e-2b0c7d538071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\cdot 2^{- 3 x^{3} + 2 x} \\left(2 - 9 x^{2}\\right) \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186657638}] :answer-field/correct {:answer/id #uuid "4c1c75b8-e26c-5124-9d8e-2b0c7d538071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\cdot 2^{- 3 x^{3} + 2 x} \\left(2 - 9 x^{2}\\right) \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186657638} :answer-field/id #uuid "ad146e83-d809-55d5-b5d2-7a4807735ed5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11669aef-a5f9-5388-a104-0a436ef45585" :question/problem "Given that $y=4\\cdot {2}^{2x-3{x}^{3}}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$.\n\n$\\frac{\\mathrm{d}y}{\\mathrm{d}x}=$\n{{field-1}}" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=4\\cdot {2}^{u},\\,u=2x-3{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}u}=4\\cdot {2}^{u}\\ln(2),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2-9{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =\\frac{\\mathrm{d}y}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & =4\\cdot {2}^{u}\\ln(2)\\cdot (2-9{x}^{2}) \\\\ & =(2-9{x}^{2})\\cdot 4\\cdot {2}^{u}\\ln(2) \\\\ & =(8-36{x}^{2})\\cdot {2}^{2x-3{x}^{3}}\\ln(2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657591 :knowledge-point/_questions [{:db/id #edb/ref 17592186096617 :knowledge-point/id #uuid "b194bf2f-feaa-5656-a3ee-0ff466a39e77" :knowledge-point/title "Differentiating a Product Containing a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efedf7e-3d47-5ff8-8014-af7d7f1c524c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657588}] :answer-field/correct {:answer/id #uuid "0efedf7e-3d47-5ff8-8014-af7d7f1c524c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6^{x} \\cos{\\left(x \\right)}" :db/id #edb/ref 17592186657588} :answer-field/id #uuid "bd6980db-63b9-58a9-a161-58fba5aeb424" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50d8c6ab-86f9-5697-89f9-f6bea58cd673" :question/problem "Differentiate ${6}^{x}\\sin(x).$\n\n$(6^{x} \\sin{\\left(x \\right)})'=$ $6^{x} \\ln{\\left(6 \\right)} \\sin{\\left(x \\right)}\\,+$ {{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)=6^{x}$ and $v(x)=\\sin{\\left(x \\right)}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}(u(x)v(x))' &=u'(x)\\cdot v(x)+u(x)\\cdot v'(x) \\\\ &=(6^{x})'\\cdot (\\sin{\\left(x \\right)}) \\\\ &\\quad +(6^{x})\\cdot (\\sin{\\left(x \\right)})' \\\\ &=(6^{x} \\ln{\\left(6 \\right)})(\\sin{\\left(x \\right)}) \\\\ &\\quad +(6^{x})(\\cos{\\left(x \\right)}) \\\\ &=6^{x} \\ln{\\left(6 \\right)} \\sin{\\left(x \\right)} \\\\ &\\quad +(6^{x} \\cos{\\left(x \\right)})\\end{aligned}\n$$"}]}
