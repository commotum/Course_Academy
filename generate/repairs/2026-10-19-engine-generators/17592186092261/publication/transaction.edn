rm{d}u}=4\\cdot {2}^{u}\\ln(2),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-9.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}f}{\\mathrm{d}x} & =\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & =4\\cdot {2}^{u}\\ln(2)\\cdot (-9) \\\\ & =(-9)\\cdot 4\\cdot {2}^{u}\\ln(2) \\\\ & =-36\\cdot {2}^{3-9x}\\ln(2).\\end{aligned}\n$$"] [:db/add "28d91041-6f71-527c-b0ba-ad8e852f62c1" :question/difficulty :question.difficulty/easy] [:db/add "28d91041-6f71-527c-b0ba-ad8e852f62c1" :question/answer-fields "d1dcd53c-c98c-5ecf-b693-90aedb451257"] [:db/ensure "28d91041-6f71-527c-b0ba-ad8e852f62c1" :question/validate] [:db/add 17592186092261 :knowledge-point/questions "28d91041-6f71-527c-b0ba-ad8e852f62c1"] [:db/add "generator" :question-generator/id #uuid "e38a7c7e-4f5a-5d38-a6c1-7f2505ccfb41"] [:db/add "generator" :question-generator/script "generators/44/442d0e4b1af6a2ef291083bde6a9a87e6d87c5ed2c583197e098c1ca53341021/generator.py"] [:db/add 17592186092261 :knowledge-point/question-generator "generator"] [:db/ensure 17592186092261 :knowledge-point/validate]]
