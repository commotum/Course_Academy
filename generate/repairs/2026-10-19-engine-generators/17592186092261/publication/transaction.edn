n(3)\\cdot (-4) \\\\ & =(-4)\\cdot {3}^{u}\\ln(3) \\\\ & =-4\\cdot {3}^{-4x}\\ln(3).\\end{aligned}\n$$"] [:db/add "6f7f3334-06bf-5b6c-8d9b-7e1b11d303db" :question/difficulty :question.difficulty/easy] [:db/add "6f7f3334-06bf-5b6c-8d9b-7e1b11d303db" :question/answer-fields "70c563c1-28fa-57f6-9e2c-777ad735321f"] [:db/ensure "6f7f3334-06bf-5b6c-8d9b-7e1b11d303db" :question/validate] [:db/add 17592186092261 :knowledge-point/questions "6f7f3334-06bf-5b6c-8d9b-7e1b11d303db"] [:db/add "e2c2af5a-8964-54fb-89be-8cfcc69077a5" :answer/id #uuid "e2c2af5a-8964-54fb-89be-8cfcc69077a5"] [:db/add "e2c2af5a-8964-54fb-89be-8cfcc69077a5" :answer/type :answer.type/math] [:db/add "e2c2af5a-8964-54fb-89be-8cfcc69077a5" :answer/value "2 \\cdot 6^{x^{3} + 3 x} \\left(3 x^{2} + 3\\right) \\ln{\\left(6 \\right)}"] [:db/ensure "e2c2af5a-8964-54fb-89be-8cfcc69077a5" :answer/validate] [:db/add "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/id #uuid "dabf61a3-2a66-5d43-8d1a-277898ddbf85"] [:db/add "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/key "field-1"] [:db/add "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/type :answer-field.type/blank] [:db/add "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/choices "e2c2af5a-8964-54fb-89be-8cfcc69077a5"] [:db/add "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/correct "e2c2af5a-8964-54fb-89be-8cfcc69077a5"] [:db/ensure "dabf61a3-2a66-5d43-8d1a-277898ddbf85" :answer-field/validate] [:db/add "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/id #uuid "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5"] [:db/add "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/problem "Given that $y=2\\cdot {6}^{3x+{x}^{3}}$, find $\\frac{\\mathrm{d}y}{\\mathrm{d}x}$.\n\n$\\frac{\\mathrm{d}y}{\\mathrm{d}x}=$\n{{field-1}}"] [:db/add "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=2\\cdot {6}^{u},\\,u=3x+{x}^{3}.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}u}=2\\cdot {6}^{u}\\ln(6),\\,\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3+3{x}^{2}.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =\\frac{\\mathrm{d}y}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x} \\\\ & =2\\cdot {6}^{u}\\ln(6)\\cdot (3+3{x}^{2}) \\\\ & =(3+3{x}^{2})\\cdot 2\\cdot {6}^{u}\\ln(6) \\\\ & =(6+6{x}^{2})\\cdot {6}^{3x+{x}^{3}}\\ln(6).\\end{aligned}\n$$"] [:db/add "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/difficulty :question.difficulty/easy] [:db/add "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/answer-fields "dabf61a3-2a66-5d43-8d1a-277898ddbf85"] [:db/ensure "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5" :question/validate] [:db/add 17592186092261 :knowledge-point/questions "df3a7a3e-f0f6-5faf-b140-d8c0078a9bd5"] [:db/add "aa1a8145-bf09-5948-ab9e-9a0d45e521a4" :answer/id #uuid "aa1a8145-bf09-5948-ab9e-9a0d45e521a4"] [:db/add "aa1a8145-bf09-5948-ab9e-9a0d45e521a4" :answer/type :answer.type/math] [:db/add "aa1a8145-bf09-5948-ab9e-9a0d45e521a4" :answer/value "36\\cdot 2^{3 - 9 x}\\ln(2)"] [:db/ensure "aa1a8145-bf09-5948-ab9e-9a0d45e521a4" :answer/validate] [:db/add "4e0a109a-1398-5203-b687-1fca003844e1" :answer/id #uuid "4e0a109a-1398-5203-b687-1fca003844e1"] [:db/add "4e0a109a-1398-5203-b687-1fca003844e1" :answer/type :answer.type/math] [:db/add "4e0a109a-1398-5203-b687-1fca003844e1" :answer/value "-48\\cdot 2^{3 - 9 x}\\ln(2)"] [:db/ensure "4e0a109a-1398-5203-b687-1fca003844e1" :answer/validate] [:db/add "75a0a275-f824-5f1a-878e-960f624e19ae" :answer/id #uuid "75a0a275-f824-5f1a-878e-960f624e19ae"] [:db/add "75a0a275-f824-5f1a-878e-960f624e19ae" :answer/type :answer.type/math] [:db/add "75a0a275-f824-5f1a-878e-960f624e19ae" :answer/value "-85\\cdot 2^{3 - 9 x}\\ln(2)"] [:db/ensure "75a0a275-f824-5f1a-878e-960f624e19ae" :answer/validate] [:db/add "7af2cbb1-148f-5a29-b908-4002f80f58ca" :answer/id #uuid "7af2cbb1-148f-5a29-b908-4002f80f58ca"] [:db/add "7af2cbb1-148f-5a29-b908-4002f80f58ca" :answer/type 