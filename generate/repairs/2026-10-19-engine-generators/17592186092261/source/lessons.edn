#{[{:activity/expected-seconds 900.0 :activity/first-step {:db/id #edb/ref 17592186093116} :activity/id #uuid "9ed557a5-e06f-5f5a-9230-32a93a80b727" :activity/scope {:db/id #edb/ref 17592186050271} :activity/steps [{:db/id #edb/ref 17592186093116 :step/content {:db/id #edb/ref 17592186093369 :tutorial/content "The chain rule can be used to differentiate exponential functions like \n\n$$\ny = e^{3x}.\n$$\n\nFirst, notice that this function can be written as the composite function\n\n$$\ny = e^u, \\qquad u = 3x.\n$$\n\nWe can use the chain rule to compute the derivative of this composite function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}}{\\text{d}u}({e}^{u})\\cdot \\frac{\\text{d}}{\\text{d}x}(3x) \\\\  & ={e}^{u}\\cdot 3 \\\\  & =3{e}^{u}\\end{aligned}\n$$\n\nSubstituting $u=3x,$ we obtain the final result:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =3{e}^{3x}\\end{aligned}\n$$" :tutorial/id #uuid "cf67b8fb-2658-5221-b309-6cf09e93b5e7" :tutorial/math-academy-id 1268 :tutorial/title "Introduction"} :step/id #uuid "87b44f73-3af6-53c8-a8c8-61525491b5d4" :step/math-academy-id 646582 :step/next {:db/id #edb/ref 17592186093117}} {:db/id #edb/ref 17592186093117 :step/content {:db/id #edb/ref 17592186092260 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092116 :question/id #uuid "c986ab8f-a8a6-5721-bc8d-ba7ec19b95ea" :question/math-academy-id "e-727" :question/problem "Calculate $f'(x)$ if $f(x) = e^{5x +4}.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf = e^u, \\qquad u=5x+4.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d f}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =5.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot 5 \\\\  & =5{e}^{u} \\\\  & =5{e}^{5x+4}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048749} {:db/id #edb/ref 17592186051084}] :knowledge-point/question-generator {:db/id #edb/ref 17592186610472} :knowledge-point/questions [{:db/id #edb/ref 17592186092512} {:db/id #edb/ref 17592186092513} {:db/id #edb/ref 17592186233098} {:db/id #edb/ref 17592186234086} {:db/id #edb/ref 17592186314963} {:db/id #edb/ref 17592186314964} {:db/id #edb/ref 17592186329850} {:db/id #edb/ref 17592186329901} {:db/id #edb/ref 17592186329902} {:db/id #edb/ref 17592186546025} {:db/id #edb/ref 17592186546033} {:db/id #edb/ref 17592186546037} {:db/id #edb/ref 17592186546039} {:db/id #edb/ref 17592186546047} {:db/id #edb/ref 17592186546052} {:db/id #edb/ref 17592186546058} {:db/id #edb/ref 17592186546062} {:db/id #edb/ref 17592186546066} {:db/id #edb/ref 17592186546072} {:db/id #edb/ref 17592186610438} {:db/id #edb/ref 17592186610441} {:db/id #edb/ref 17592186610444} {:db/id #edb/ref 17592186610456} {:db/id #edb/ref 17592186610469}] :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"} :step/id #uuid "a179fdba-d910-50b0-81ea-369c06993adf" :step/math-academy-id 646583 :step/next {:db/id #edb/ref 17592186093120}} {:db/id #edb/ref 17592186093118 :step/content {:db/id #edb/ref 17592186092261 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092118 :question/id #uuid "775dfc95-df31-5198-aeb2-4603b8386957" :question/math-academy-id "e-728" :question/problem "Given that $y= 3\\cdot 2^{1 - x},$ find $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny = 3\\cdot 2^u, \\qquad u=1-x.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = 3\\cdot 2^u\\ln(2),\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\cdot {2}^{u}\\operatorname{ln}⁡(2)\\cdot (-1) \\\\  & =-3\\cdot {2}^{u}\\operatorname{ln}⁡(2) \\\\  & =-3\\cdot {2}^{1-x}\\operatorname{ln}⁡(2).\\end{aligned}\n$$"} :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/questions [{:db/id #edb/ref 17592186092733} {:db/id #edb/ref 17592186092735} {:db/id #edb/ref 17592186233099} {:db/id #edb/ref 17592186234314} {:db/id #edb/ref 17592186244059} {:db/id #edb/ref 17592186244060} {:db/id #edb/ref 17592186287951} {:db/id #edb/ref 17592186297340} {:db/id #edb/ref 17592186315038} {:db/id #edb/ref 17592186329903} {:db/id #edb/ref 17592186524994} {:db/id #edb/ref 17592186524997} {:db/id #edb/ref 17592186562394}] :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"} :step/id #uuid "a8a87a08-8a33-5f7d-a2ee-3bb4f46035fe" :step/math-academy-id 646589} {:db/id #edb/ref 17592186093120 :step/content {:db/id #edb/ref 17592186092263 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092119 :question/id #uuid "b15a88b5-e2c4-51c1-90d5-031c2a8c23d3" :question/math-academy-id "e-729" :question/problem "Given that $y=e^{-x^2},$ calculate $\\dfrac{\\textrm d y}{\\textrm d x}.$" :question/worked-solution "First we express $y$ as the composite function\n\n$$\ny = e^u, \\qquad u=-x^2.\n$$\n\nDifferentiating gives\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d u} = e^u,\\qquad \\dfrac{\\textrm d u}{\\textrm d x} =-2x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (-2x) \\\\  & =-2x{e}^{u} \\\\  & =-2x{e}^{-{x}^{2}}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/question-generator {:db/id #edb/ref 17592186610504} :knowledge-point/questions [{:db/id #edb/ref 17592186092618} {:db/id 