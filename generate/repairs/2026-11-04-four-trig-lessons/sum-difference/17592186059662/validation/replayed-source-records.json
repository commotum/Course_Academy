              ":answer/id": "3efdfd3b-9a51-5a14-9c9e-38bced5df1e3",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\sqrt{3}}{2}"
            }
          ],
          ":answer-field/correct": [
