[:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/key "selection"] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/type :answer-field.type/radio] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/choices "adab723c-38a1-57a8-b713-85077ef4ba73"] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/choices "3328c1d2-6efa-50ac-bfe9-b1c50039b7b2"] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/choices "d277f239-e741-54b9-a814-6854479a7ac5"] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/choices "41ac046f-7739-5958-bd31-a220fcb8b054"] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/choices "7213b353-1938-5ee2-a89b-5640e0bcc412"] [:db/add "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/correct "7213b353-1938-5ee2-a89b-5640e0bcc412"] [:db/ensure "1c7f95b1-fd71-59eb-84e3-22587da6c02b" :answer-field/validate] [:db/add "495005c7-eb12-5d76-a716-3e1056b120cd" :question/id #uuid "495005c7-eb12-5d76-a716-3e1056b120cd"] [:db/add "495005c7-eb12-5d76-a716-3e1056b120cd" :question/problem "Calculate $\\displaystyle \\int \\sqrt{x}\\left(-x+3\\right)\\,\\mathrm{d}x$ for $x>0$."] [:db/add "495005c7-eb12-5d76-a716-3e1056b120cd" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\sqrt{x}\\left(-x+3\\right)\\,\\mathrm{d}x &= \\int \\left(- x^{\\frac{3}{2}} + 3 \\sqrt{x}\\right)\\,\\mathrm{d}x \\\\ &=-\\int x^{\\frac{3}{2}}\\,\\mathrm{d}x+3\\int x^{\\frac{1}{2}}\\,\\mathrm{d}x \\\\ &=-\\left(\\frac{x^{\\frac{5}{2}}}{\\frac{5}{2}}\\right)+3\\left(\\frac{x^{\\frac{3}{2}}}{\\frac{3}{2}}\\right)+C \\\\ &=-\\frac{2\\sqrt{x^{5}}}{5}+2\\sqrt{x^{3}}+C.\\end{aligned}\n$$"] [:db/add "495005c7-eb12-5d76-a716-3e1056b120cd" :question/difficulty :question.difficulty/moderate] [:db/add "495005c7-eb12-5d76-a716-3e1056b120cd" :question/answer-fields "1c7f95b1-fd71-59eb-84e3-22587da6c02b"] [:db/ensure "495005c7-eb12-5d76-a716-3e1056b120cd" :question/validate] [: