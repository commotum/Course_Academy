wer-field/key "selection"] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/type :answer-field.type/radio] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/choices "07cf43fd-8a0c-5ee4-ac88-49fe77424a28"] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/choices "6424b0c5-4710-5ee2-992a-ed0bd6deacfa"] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/choices "7e871e26-7307-510f-86a2-758b288ac386"] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/choices "25025c0b-22c8-58be-89a1-99ae4717a596"] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/choices "55758766-cfa5-550e-b651-5f45a8c7a409"] [:db/add "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/correct "7e871e26-7307-510f-86a2-758b288ac386"] [:db/ensure "db3265bf-16ef-5b52-9a6f-ebde568d4567" :answer-field/validate] [:db/add "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/id #uuid "0b2690c2-aadf-5290-b281-50f51b5ea68c"] [:db/add "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/problem "$\\displaystyle \\int \\frac{-3x^{9}-9}{x^{4}}\\,\\mathrm{d}x=$\n\nAssume $x\\ne 0$."] [:db/add "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{-3x^{9}-9}{x^{4}}\\,\\mathrm{d}x &= \\int \\left(- 3 x^{5} - \\frac{9}{x^{4}}\\right)\\,\\mathrm{d}x \\\\ &=-3\\int x^{5}\\,\\mathrm{d}x-9\\int x^{-4}\\,\\mathrm{d}x \\\\ &=-3\\left(\\frac{x^{6}}{6}\\right)-9\\left(\\frac{x^{-3}}{-3}\\right)+C \\\\ &=-\\frac{x^{6}}{2}+\\frac{3}{x^{3}}+C.\\end{aligned}\n$$"] [:db/add "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/difficulty :question.difficulty/moderate] [:db/add "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/answer-fields "db3265bf-16ef-5b52-9a6f-ebde568d4567"] [:db/ensure "0b2690c2-aadf-5290-b281-50f51b5ea68c" :question/validate] [:db/add 17592186184154 :knowledge-point/questions "0b2690c2-aadf-5290-b281-50f51b5ea68c"] [:db/add "generator" :question-generator/i