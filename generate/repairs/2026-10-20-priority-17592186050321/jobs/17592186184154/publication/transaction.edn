c81" :answer-field/type :answer-field.type/radio] [:db/add "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/choices "d7c35a45-5ec7-5e78-aec9-ece2a7907635"] [:db/add "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/choices "89379a7b-fe01-54ed-83cf-d2a57bd45625"] [:db/add "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/choices "cb0320d4-11db-54bd-b339-eb83e7ef1f4c"] [:db/add "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/choices "c5e6be45-47be-53e1-8e43-eec6a7077b46"] [:db/add "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/choices "9d86ef84-6787-5c0f-8af8-6271f1c53f97"] [:db/add "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/correct "cb0320d4-11db-54bd-b339-eb83e7ef1f4c"] [:db/ensure "8c78264f-76ab-5bef-be89-8cfaf4782c81" :answer-field/validate] [:db/add "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/id #uuid "54cf3324-e18f-5e94-bc33-f3e67225c374"] [:db/add "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/problem "$\\displaystyle \\int \\frac{2x^{8}-6}{x^{2}}\\,\\mathrm{d}x=$\n\nAssume $x\\ne 0$."] [:db/add "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{2x^{8}-6}{x^{2}}\\,\\mathrm{d}x &= \\int \\left(2 x^{6} - \\frac{6}{x^{2}}\\right)\\,\\mathrm{d}x \\\\ &=2\\int x^{6}\\,\\mathrm{d}x-6\\int x^{-2}\\,\\mathrm{d}x \\\\ &=2\\left(\\frac{x^{7}}{7}\\right)-6\\left(\\frac{x^{-1}}{-1}\\right)+C \\\\ &=\\frac{2x^{7}}{7}+\\frac{6}{x}+C.\\end{aligned}\n$$"] [:db/add "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/difficulty :question.difficulty/moderate] [:db/add "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/answer-fields "8c78264f-76ab-5bef-be89-8cfaf4782c81"] [:db/ensure "54cf3324-e18f-5e94-bc33-f3e67225c374" :question/validate] [:db/add 17592186184154 :knowledge-point/questions "54cf3324-e18f-5e94-bc33-f3e67225c374"] [:db/add "dde38843-02ec-58cb-aa01-7203f5075161" :answer/id #uuid "dde38843-02ec-58cb-aa01-7203f5075161"] [:db/add "dde38843-02ec-58cb-aa01-7203f5075161" :answer/type :answer.type/math] [:db/add "dde38843-02ec-58cb-aa01-7203f5075161" :answer/value "3x+\\frac{6}{x}"] [:db/ensure "dde38843-02ec-58cb-aa01-7203f5075161" :answer/validate] [:db/add "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/id #uuid "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624"] [:db/add "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/key "field-1"] [:db/add "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/type :answer-field.type/blank] [:db/add "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/choices "dde38843-02ec-58cb-aa01-7203f5075161"] [:db/add "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/correct "dde38843-02ec-58cb-aa01-7203f5075161"] [:db/ensure "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624" :answer-field/validate] [:db/add "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/id #uuid "6945f52f-8fce-5ee6-bbe0-b093f818f3f6"] [:db/add "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/problem "Given $f(x)=3x^{3}-6x$ and $x\\ne 0$, calculate the integral.\n\n$\\displaystyle \\int \\frac{f(x)}{x^{3}}\\,\\mathrm{d}x=$\n{{field-1}}\n$+C.$"] [:db/add "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{f(x)}{x^{3}}\\,\\mathrm{d}x &= \\int \\frac{3x^{3}-6x}{x^{3}}\\,\\mathrm{d}x \\\\ &=\\int \\left(3 - \\frac{6}{x^{2}}\\right)\\,\\mathrm{d}x \\\\ &=3\\int 1\\,\\mathrm{d}x-6\\int x^{-2}\\,\\mathrm{d}x \\\\ &=3\\left(\\frac{x}{1}\\right)-6\\left(\\frac{x^{-1}}{-1}\\right)+C \\\\ &=3x+\\frac{6}{x}+C.\\end{aligned}\n$$\n\nThe blank excludes the constant $C$, which is already supplied."] [:db/add "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/difficulty :question.difficulty/moderate] [:db/add "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/answer-fields "b0bdbda9-b95c-57fb-8b41-b5bd02fd0624"] [:db/ensure "6945f52f-8fce-5ee6-bbe0-b093f818f3f6" :question/validate] [:db/add 17592186184154 :knowledge-point/questions "6945f52f-8fce-5ee6-bbe0-b093f818f3f6"] [:db/add "bbec5ab2-11ab-50fc-8895-cc45046a7d77" :answer/id #uuid "bbec5ab2-11ab-50fc-8895-cc45046a7d77"] [:db/add "bbec5ab2-11ab-50fc-8895-cc45046a7d77" :answer/type :answer.type/math] [:db/add "bbec5ab2-11ab-50fc-8895-cc45046a7d77" :answer/value "\\frac{2\\sqrt{x^{5}}}{5}+2\\sqrt{x^{3}}+C"] [:db/ensure "bbec5ab2-11ab-50fc-8895-cc45046a7d77" :answer/validate] [:db/add "293e410d-2a5e-5635-9967-147d3af10204" :answer/id #uuid "293e410d-2a5e-5635-9967-147d3af10204"] [:db/add "293e410d-2a5e-5635-9967-147d3af10204" :answer/type :answer.type/math] [:db/add "293e410d-2a5e-5635-9967-147d3af10204" :answer/value "\\frac{2\\sqrt{x^{3}}}{3}+\\frac{6}{\\sqrt{x}}+C"] [:db/ensure "293e410d-2a5e-5635-9967-147d3af10204" :answer/validate] [:db/add "281410b1-d1c8-583b-bde1-a2a4589ef7e7" :answer/id #uuid "281410b1-d1c8-583b-bde1-a2a4589ef7e7"] [:db/add "281410b1-d1c8-583b-bde1-a2a4589ef7e7" :answer/type :answer.type/math] [:db/add "281410b1-d1c8-583b-bde1-a2a4589ef7e7" :answer/value "\\frac{\\sqrt{x^{5}}}{5}+\\sqrt{x^{3}}+C"] [:db/ensure "281410b1-d1c8-583b-bde1-a2a4589ef7e7" :answer/validate] [:db/add "20a16b47-dc19-56f0-83b0-7d1355df4d46" :answer/id #uuid "20a16b47-dc19-56f0-83b0-7d1355df4d46"] [:db/add "20a16b47-dc19-56f0-83b0-7d1355df4d46" :answer/type :answer.type/math] [:db/add "20a16b47-dc19-56f0-83b0-7d1355df4d46" :answer/value "\\frac{5\\sqrt{x^{5}}}{2}+\\frac{9\\sqrt{x^{3}}}{2}+C"] [:db/ensure "20a16b47-dc19-56f0-83b0-7d1355df4d46" :answer/validate] [:db/add "ecff5c64-99b1-5d89-a487-6a61fd889bd2" :answer/id #uuid "ecff5c64-99b1-5d89-a487-6a61fd889bd2"] [:db/add "ecff5c64-99b1-5d89-a487-6a61fd889bd2" :answer/type :answer.type/math] [:db/add "ecff5c64-99b1-5d89-a487-6a61fd889bd2" :answer/value "\\frac{2\\sqrt{x^{3}}}{3}-\\frac{6}{\\sqrt{x}}+C"] [:db/ensure "ecff5c64-99b1-5d89-a487-6a61fd889bd2" :answer/validate] [:db/add "5cde20e6-9892-5fcd-9754-cd197b421a74" :answer-field/id #uuid "5cde20e6-9892-5fcd-9754-cd197b421a74"] [:db/add "5cde20e6-9892-5fcd-