#{[{:db/id #edb/ref 17592186048442 :topic/id #uuid "9fb9cfe0-2d6b-5be3-a023-bef57b6f3340" :topic/knowledge-points [{:db/id #edb/ref 17592186054609 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054520 :question/id #uuid "578a205e-7879-5f8e-b7b5-a91a134ec5b3" :question/math-academy-id "e-369" :question/problem "Calculate $\\displaystyle \\int \\dfrac{2}{3} x \\,\\textrm d x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{2}{3}x\\,\\text{d}x & =\\frac{2}{3}\\int x\\,\\text{d}x \\\\  & =\\frac{2}{3}\\left(\\frac{{x}^{1+1}}{1+1}\\right)+C \\\\  & =\\frac{2}{3}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{1}{3}{x}^{2}+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "add45606-39f6-5a61-9535-867d2950d183" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Power Function"} {:db/id #edb/ref 17592186054610 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054521 :question/id #uuid "24fd4536-65aa-5a8f-bb84-9134f26bc125" :question/math-academy-id "e-370" :question/problem "Calculate $\\displaystyle \\int 6 \\,\\textrm d x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int 6\\,\\text{d}x & =6\\int 1\\,\\text{d}x \\\\  & =6\\int {x}^{0}\\,\\text{d}x \\\\  & =6\\cdot \\frac{{x}^{0+1}}{0+1}+C \\\\  & =6\\cdot x+C \\\\  & =6x+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\displaystyle \\int k \\,\\textrm d x = kx + C.$"} :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :topic/math-academy-id 43 :topic/next [{:db/id #edb/ref 17592186050321}] :topic/title "The Constant Multiple Rule for Indefinite Integrals"}]}
