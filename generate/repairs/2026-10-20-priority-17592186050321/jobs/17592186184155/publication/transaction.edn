4-8c17-5b8b-bfbf-247750622cee"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/key "selection"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/type :answer-field.type/radio] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/choices "9cf31199-f10e-56b2-a2c9-e45b77728ad4"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/choices "c073f955-67ff-5a29-b461-35e9524a9203"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/choices "8ff4abb2-d739-5206-9a76-cad17736caa3"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/choices "faefdad3-fda3-5db3-8593-70d8ae260a01"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/choices "890b50df-241b-5b4f-9df5-aa96000d95d7"] [:db/add "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/correct "9cf31199-f10e-56b2-a2c9-e45b77728ad4"] [:db/ensure "344c6f14-8c17-5b8b-bfbf-247750622cee" :answer-field/validate] [:db/add "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/id #uuid "0bade6c7-cd43-5d21-823b-4952e19f42d7"] [:db/add "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/problem "Find the antiderivative of\n$-\\frac{6}{\\sqrt[7]{x^{8}}}+\\frac{1}{x^{5}}+3x^{7}.$ For real $x\\ne 0$."] [:db/add "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(-\\frac{6}{\\sqrt[7]{x^{8}}}+\\frac{1}{x^{5}}+3x^{7}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(-6x^{\\frac{-8}{7}}+x^{-5}+3x^{7}\\right)\\,\\mathrm{d}x\\\\ &= -6\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x+\\int x^{-5}\\,\\mathrm{d}x+3\\int x^{7}\\,\\mathrm{d}x\\\\ &= -6\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)+\\left(\\frac{x^{-5+1}}{(-5+1)}\\right)\\\\ &\\quad +3\\left(\\frac{x^{7+1}}{(7+1)}\\right)+C\\\\ &= \\frac{42}{\\sqrt[7]{x}}-\\frac{1}{4x^{4}}+\\frac{3x^{8}}{8}+C.\\end{aligned}\n$$"] [:db/add "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/difficulty :question.difficulty/hard] [:db/add "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/answer-fields "344c6f14-8c17-5b8b-bfbf-247750622cee"] [:db/ensure "0bade6c7-cd43-5d21-823b-4952e19f42d7" :question/validate] [:db/add 17592186184155 :knowledge-point/questions "0bade6c7-cd43-5d21-823b-4952e19f42d7"] [:db/add "83bda2a9-0e97-505b-8d64-55cc6c68264a" :answer/id #uuid "83bda2a9-0e97-505b-8d64-55cc6c68264a"] [:db/add "83bda2a9-0e97-505b-8d64-55cc6c68264a" :answer/type :answer.type/math] [:db/add "83bda2a9-0e97-505b-8d64-55cc6c68264a" :answer/value "-\\frac{3x^{4}}{2}-\\frac{4}{x^{5}}+\\frac{25}{\\sqrt[5]{x}}+C"] [:db/ensure "83bda2a9-0e97-505b-8d64-55cc6c68264a" :answer/validate] [:db/add "183f0e67-9f9e-5a65-aadf-a4bd2d8c9702" :answer/id #uuid "183f0e67-9f9e-5a65-aadf-a4bd2d8c9702"] [:db/add "183f0e67-9f9e-5a65-aadf-a4bd2d8c9702" :answer/type :answer.type/math] [:db/add "183f0e67-9f9e-5a65-aadf-a4bd2d8c9702" :answer/value "-\\frac{3x^{4}}{2}-\\frac{4}{x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C"] [:db/ensure "183f0e67-9f9e-5a65-aadf-a4bd2d8c9702" :answer/validate] [:db/add "9c172a14-5b61-55f3-b463-ddd35f75a506" :answer/id #uuid "9c172a14-5b61-55f3-b463-ddd35f75a506"] [:db/add "9c172a14-5b61-55f3-b463-ddd35f75a506" :answer/type :answer.type/math] [:db/add "9c172a14-5b61-55f3-b463-ddd35f75a506" :answer/value "-\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}+\\frac{25}{\\sqrt[5]{x}}+C"] [:db/ensure "9c172a14-5b61-55f3-b463-ddd35f75a506" :answer/validate] [:db/add "427e78cf-f9bf-5988-8bf3-c1e8d657ed24" :answer/id #uuid "427e78cf-f9bf-5988-8bf3-c1e8d657ed24"] [:db/add "427e78cf-f9bf-5988-8bf3-c1e8d657ed24" :answer/type :answer.type/math] [:db/add "427e78cf-f9bf-5988-8bf3-c1e8d657ed24" :answer/value "-\\frac{3x^{4}}{4}-\\frac{4}{x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C"] [:db/ensure "427e78cf-f9bf-5988-8bf3-c1e8d657ed24" :answer/validate] [:db/add "61d7c6dd-7f78-5df4-b99a-2a9a196d0eb7" :answer/id #uuid "61d7c6dd-7f78-5df4-b99a-2a9a196d0eb7"] [:db/add "61d7c6dd-7f78-5df4-b99a-2a9a196d0eb7" :answer/type :answer.type/math] [:db/add "61d7c6dd-7f78-5df