^{\\frac{-6}{5}+1}}{(\\frac{-6}{5}+1)}\\right)+C\\\\ &= -\\frac{3x^{4}}{4}+\\frac{4}{5x^{5}}-\\frac{5}{\\sqrt[5]{x}}+C.\\end{aligned}\n$$"] [:db/add "028aa697-e6c4-5a0e-b03d-def9695eb209" :question/difficulty :question.difficulty/hard] [:db/add "028aa697-e6c4-5a0e-b03d-def9695eb209" :question/answer-fields "082c53aa-9037-5f6d-a94c-2dd53b9d5139"] [:db/ensure "028aa697-e6c4-5a0e-b03d-def9695eb209" :question/validate] [:db/add 17592186184155 :knowledge-point/questions "028aa697-e6c4-5a0e-b03d-def9695eb209"] [:db/add "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c" :answer/id #uuid "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c"] [:db/add "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c" :answer/type :answer.type/math] [:db/add "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c" :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{8}{x}+\\frac{8x^{5}}{5}+C"] [:db/ensure "ea42f4c2-e9cb-59f7-b5a9-d14f9efacf8c" :answer/validate] [:db/add "a04f6a87-da6c-565b-b1ba-854831a2cbd6" :answer/id #uuid "a04f6a87-da6c-565b-b1ba-854831a2cbd6"] [:db/add "a04f6a87-da6c-565b-b1ba-854831a2cbd6" :answer/type :answer.type/math] [:db/add "a04f6a87-da6c-565b-b1ba-854831a2cbd6" :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{8}{x}+\\frac{8x^{5}}{5}+C"] [:db/ensure "a04f6a87-da6c-565b-b1ba-854831a2cbd6" :answer/validate] [:db/add "accba725-f75c-53a5-bdd6-67102eb3cbe6" :answer/id #uuid "accba725-f75c-53a5-bdd6-67102eb3cbe6"] [:db/add "accba725-f75c-53a5-bdd6-67102eb3cbe6" :answer/type :answer.type/math] [:db/add "accba725-f75c-53a5-bdd6-67102eb3cbe6" :answer/value "\\frac{35}{6\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C"] [:db/ensure "accba725-f75c-53a5-bdd6-67102eb3cbe6" :answer/validate] [:db/add "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/id #uuid "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588"] [:db/add "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/type :answer.type/math] [:db/add "0e7b2b6a-34b4-5d4a-b3aa-0efa636c0588" :answer/value "-\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C"] [:db/ensure "0e7b2b6a-34b4-5d4a-b3aa-0efa636c05