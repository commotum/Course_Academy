hrm{d}x\\\\ &= 5\\int x^{\\frac{-8}{7}}\\,\\mathrm{d}x-4\\int x^{-2}\\,\\mathrm{d}x+4\\int x^{4}\\,\\mathrm{d}x\\\\ &= 5\\left(\\frac{x^{\\frac{-8}{7}+1}}{(\\frac{-8}{7}+1)}\\right)-4\\left(\\frac{x^{-2+1}}{(-2+1)}\\right)\\\\ &\\quad +4\\left(\\frac{x^{4+1}}{(4+1)}\\right)+C\\\\ &= -\\frac{35}{\\sqrt[7]{x}}+\\frac{4}{x}+\\frac{4x^{5}}{5}+C.\\end{aligned}\n$$"] [:db/add "f708cae3-deab-525d-82c5-7fe0627c8526" :question/difficulty :question.difficulty/hard] [:db/add "f708cae3-deab-525d-82c5-7fe0627c8526" :question/answer-fields "a3fae9bb-8131-5df6-aad0-a2b85876eb60"] [:db/ensure "f708cae3-deab-525d-82c5-7fe0627c8526" :question/validate] [:db/add 17592186184155 :knowledge-point/questions "f708cae3-deab-525d-82c5-7fe0627c8526"] [:db/add "ee462ba7-e5d4-540e-8626-d94445e86e38" :answer/id #uuid "ee462ba7-e5d4-540e-8626-d94445e86e38"] [:db/add "ee462ba7-e5d4-540e-8626-d94445e86e38" :answer/type :answer.type/math] [:db/add "ee462ba7-e5d4-540e-8626-d94445e86e38" :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{5}}+\\frac{42}{\\sqrt[7]{x}}+C"] [:db/ensure "ee462ba7-e5d4-540e-8626-d94445e86e38" :answer/validate] [:db/add "01cafb24-a1d3-52bf-8f9d-12c3134619f5" :answer/id #uuid "01cafb24-a1d3-52bf-8f9d-12c3134619f5"] [:db/add "01cafb24-a1d3-52bf-8f9d-12c3134619f5" :answer/type :answer.type/math] [:db/add "01cafb24-a1d3-52bf-8f9d-12c3134619f5" :answer/value "\\frac{2x^{6}}{7}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C"] [:db/ensure "01cafb24-a1d3-52bf-8f9d-12c3134619f5" :answer/validate] [:db/add "4ab25325-4150-524c-9b62-51299c24dabe" :answer/id #uuid "4ab25325-4150-524c-9b62-51299c24dabe"] [:db/add "4ab25325-4150-524c-9b62-51299c24dabe" :answer/type :answer.type/math] [:db/add "4ab25325-4150-524c-9b62-51299c24dabe" :answer/value "\\frac{x^{6}}{3}-\\frac{1}{3x^{3}}+\\frac{42}{\\sqrt[7]{x}}+C"] [:db/ensure "4ab25325-4150-524c-9b62-51299c24dabe" :answer/validate] [:db/add "48985b06-1af2-5faa-b044-20977de06c7b" :answer/id #uuid "48985b06-1af2-5faa-b044-20977de06c7b"] [:db/add "48985b