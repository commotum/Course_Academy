97-ac86fba9a9f0"] [:db/add "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/problem "Find the antiderivative of\n$\\frac{6}{x^{2}}+6x^{3}+4\\sqrt[3]{x^{2}}.$ For real $x\\ne 0$."] [:db/add "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}& \\int\\left(\\frac{6}{x^{2}}+6x^{3}+4\\sqrt[3]{x^{2}}\\right)\\,\\mathrm{d}x\\\\ &= \\int\\left(6x^{-2}+6x^{3}+4x^{\\frac{2}{3}}\\right)\\,\\mathrm{d}x\\\\ &= 6\\int x^{-2}\\,\\mathrm{d}x+6\\int x^{3}\\,\\mathrm{d}x+4\\int x^{\\frac{2}{3}}\\,\\mathrm{d}x\\\\ &= 6\\left(\\frac{x^{-2+1}}{(-2+1)}\\right)+6\\left(\\frac{x^{3+1}}{(3+1)}\\right)\\\\ &\\quad +4\\left(\\frac{x^{\\frac{2}{3}+1}}{(\\frac{2}{3}+1)}\\right)+C\\\\ &= -\\frac{6}{x}+\\frac{3x^{4}}{2}+\\frac{12\\sqrt[3]{x^{5}}}{5}+C.\\end{aligned}\n$$"] [:db/add "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/difficulty :question.difficulty/hard] [:db/add "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/answer-fields "ec585ac1-4fe5-537f-8aa6-ac15a56ee933"] [:db/ensure "3891daa6-faa4-55c6-9997-ac86fba9a9f0" :question/validate] [:db/add 17592186184155 :knowledge-point/questions "3891daa6-faa4-55c6-9997-ac86fba9a9f0"] [:db/add "generator" :question-generator/id #uuid "5a2e4c25-bbc1-56a1-b9c7-bc14b9eaedd1"] [:db/add "generator" :question-generator/script "generators/16/16a993cbfe85f808da5cca312be6b10868d6f13342aa9b06b03653df6fd04293/generator.py"] [:db/add 17592186184155 :knowledge-point/question-generator "generator"] [:db/ensure 17592186184155 :knowledge-point/validate]]
