#{[{:db/id #edb/ref 17592186050321 :topic/id #uuid "3faedd4b-6445-5693-abb6-4c7947c1914f" :topic/knowledge-points [{:db/id #edb/ref 17592186184153 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184057 :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {x}^{2}+1\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{2}\\,\\text{d}x+\\int {x}^{0}\\,\\text{d}x \\\\  & =\\left(\\frac{{x}^{2+1}}{2+1}\\right)+x+C \\\\  & =\\frac{1}{3}{x}^{3}+x+C\\end{aligned}\n$$"} :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"} {:db/id #edb/ref 17592186184154 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184058 :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{3}-x\\,\\text{d}x & =2\\int {x}^{3}\\,\\text{d}x-\\int x\\,\\text{d}x \\\\  & =2\\left(\\frac{{x}^{3+1}}{3+1}\\right)-\\left(\\frac{{x}^{1+1}}{1+1}\\right)+C \\\\  & =2\\left(\\frac{{x}^{4}}{4}\\right)-\\left(\\frac{{x}^{2}}{2}\\right)+C \\\\  & =\\frac{{x}^{4}}{2}-\\frac{{x}^{2}}{2}+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"} {:db/id #edb/ref 17592186184155 :knowledge-point/canonical-example {:db/id #edb/ref 17592186184059 :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left( 5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (5(\\sqrt{x})^{3}-4{x}^{2}+5)\\,\\text{d}x & =\\int (5{x}^{3/2}-4{x}^{2}+5)\\,\\text{d}x \\\\  & =5\\int {x}^{3/2}\\,\\text{d}x-4\\int {x}^{2}\\text{d}x+5\\int 1\\,\\text{d}x \\\\  & =5\\left(\\frac{{x}^{5/2}}{\\frac{5}{2}}\\right)-4\\left(\\frac{{x}^{3}}{3}\\right)+5(x)+C \\\\  & =5\\cdot \\frac{2}{5}{x}^{5/2}-\\frac{4}{3}{x}^{3}+5x+C \\\\  & =2\\sqrt{{x}^{5}}-\\frac{4}{3}{x}^{3}+5x+C.\\end{aligned}\n$$"} :knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :topic/math-academy-id 3769 :topic/next [{:db/id #edb/ref 17592186048777} {:db/id #edb/ref 17592186049443} {:db/id #edb/ref 17592186049533} {:db/id #edb/ref 17592186049599} {:db/id #edb/ref 17592186050628}] :topic/title "The Sum Rule for Indefinite Integrals"}]}
