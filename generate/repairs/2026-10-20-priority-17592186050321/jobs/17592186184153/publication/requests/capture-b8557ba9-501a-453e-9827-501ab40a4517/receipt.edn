 1\\,\\mathrm{d}t \\\\ &= -\\frac{t^{5+1}}{(5+1)}-5\\frac{t^{0+1}}{(0+1)}+C \\\\ &= -\\frac{t^{6}}{6}-5t+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$." 13194139538631 17592186045443 true] [17592186671063 1080 "-6x+\\frac{x^{7}}{2}+C" 13194139538631 17592186045443 true] [17592186671063 1082 #edb/ref 17592186045498 13194139538631 17592186045443 true] [17592186671063 1083 #uuid "a899a0ec-a01d-5fe6-b0a7-6adc5f0f285e" 13194139538631 17592186045443 true] [17592186671064 1080 "-6x+\\frac{x^{7}}{7}+C" 13194139538631 17592186045443 true] [17592186671064 1082 #edb/ref 17592186045498 13194139538631 17592186045443 true] [17592186671064 1083 #uuid "b329d488-d81c-5863-a1d3-b5fd0268822d" 13194139538631 17592186045443 true] [17592186671065 1080 "6t-\\frac{2}{\\sqrt{t}}+C" 13194139538631 17592186045443 true] [17592186671065 1082 #edb/ref 17592186045498 13194139538631 17592186045443 true] [17592186671065 1083 #uuid "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1" 13194139538631 17592186045443 true] [17592186671066 1080 "6t-\\frac{1}{\\sqrt{t}}+C" 13194139538631 17592186045443 true] [17592186671066 1082 #edb/ref 17592186045498 13194139538631 17592186045443 true] [17592186671066 1083 #uuid "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c" 13194139538631 17592186045443 true] [17592186671067 1080 "-4x+\\frac{x^{7}}{2}+C" 13194139538631 17592186045443 true] [17592186671067 1082 #edb/ref 17592186045498 13194139538631 17592186045443 true] [17592186671067 1083 #uuid "eb50de8c-ecdb-5560-895f-fa5d14eae046" 13194139538631 17592186045443 true] [17592186671068 1168 "generators/5e/5ed063f5d00f5c4ccd92c65ae61a13cd1df03feb06b07e4fcc456361abf57f57/generator.py" 13194139538631 17592186045443 true] [17592186671068 1169 #uuid "31fd295c-1bf7-518a-82fd-8dbaeba41a46" 13194139538631 17592186045443 true]] :edb/tempids {"01a90f9a-b732-5698-877a-1b43e8e0388a" 17592186671045 "01f4f87a-a45e-52f0-8489-eb5074709047" 17592186671046 "10e82ee6-837f-5483-bbea-7