[[:db/add "8bd6e13b-e453-517b-905a-f7a3184b5e2a" :answer/id #uuid "8bd6e13b-e453-517b-905a-f7a3184b5e2a"] [:db/add "8bd6e13b-e453-517b-905a-f7a3184b5e2a" :answer/type :answer.type/math] [:db/add "8bd6e13b-e453-517b-905a-f7a3184b5e2a" :answer/value "-2t+\\frac{t^{7}}{7}"] [:db/ensure "8bd6e13b-e453-517b-905a-f7a3184b5e2a" :answer/validate] [:db/add "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/id #uuid "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc"] [:db/add "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/key "field-1"] [:db/add "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/type :answer-field.type/blank] [:db/add "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/choices "8bd6e13b-e453-517b-905a-f7a3184b5e2a"] [:db/add "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/correct "8bd6e13b-e453-517b-905a-f7a3184b5e2a"] [:db/ensure "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc" :answer-field/validate] [:db/add "10e82ee6-837f-5483-bbea-742bf32b5839" :question/id #uuid "10e82ee6-837f-5483-bbea-742bf32b5839"] [:db/add "10e82ee6-837f-5483-bbea-742bf32b5839" :question/problem "Given $y'(t)=-2+t^{6}$, find $y(t)$, the antiderivative of $y'(t)$.\n\n$y(t)=$\n{{field-1}}\n$+\\,C$"] [:db/add "10e82ee6-837f-5483-bbea-742bf32b5839" :question/worked-solution "We know that $y'(t)=-2+t^{6}$.\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-2+t^{6}\\right)\\,\\mathrm{d}t &= \\int \\left(-2+t^{6}\\right)\\,\\mathrm{d}t \\\\ &= -2\\int 1\\,\\mathrm{d}t+\\int t^{6}\\,\\mathrm{d}t \\\\ &= -2\\frac{t^{0+1}}{(0+1)}+\\frac{t^{6+1}}{(6+1)}+C \\\\ &= -2t+\\frac{t^{7}}{7}+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$."] [:db/add "10e82ee6-837f-5483-bbea-742bf32b5839" :question/difficulty :question.difficulty/moderate] [:db/add "10e82ee6-837f-5483-bbea-742bf32b5839" :question/answer-fields "23b81b98-ddee-5ebf-a2b4-d2474b1ec7fc"] [:db/ensure "10e82ee6-837f-5483-bbea-742bf32b5839" :question/validate] [:db/add 17592186184153 :knowledge-point/questions "10e82ee6-837f-5483-bbea-742bf32b5839"] [:db/add "a183bc35-1977-50a3-9ea8-d6135d3f1cf9" :answer/id #uuid "a183bc35-1977-50a3-9ea8-d6135d3f1cf9"] [:db/add "a183bc35-1977-50a3-9ea8-d6135d3f1cf9" :answer/type :answer.type/math] [:db/add "a183bc35-1977-50a3-9ea8-d6135d3f1cf9" :answer/value "-\\frac{t^{6}}{6}-5t"] [:db/ensure "a183bc35-1977-50a3-9ea8-d6135d3f1cf9" :answer/validate] [:db/add "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/id #uuid "7141dba1-52ab-5b56-8273-475b65054ed4"] [:db/add "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/key "field-1"] [:db/add "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/type :answer-field.type/blank] [:db/add "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/choices "a183bc35-1977-50a3-9ea8-d6135d3f1cf9"] [:db/add "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/correct "a183bc35-1977-50a3-9ea8-d6135d3f1cf9"] [:db/ensure "7141dba1-52ab-5b56-8273-475b65054ed4" :answer-field/validate] [:db/add "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/id #uuid "a43f7211-93e1-579c-98a5-37395b38f6c3"] [:db/add "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/problem "Given $y'(t)=-t^{5}-5$, find $y(t)$, the antiderivative of $y'(t)$.\n\n$y(t)=$\n{{field-1}}\n$+\\,C$"] [:db/add "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/worked-solution "We know that $y'(t)=-t^{5}-5$.\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-t^{5}-5\\right)\\,\\mathrm{d}t &= \\int \\left(-t^{5}-5\\right)\\,\\mathrm{d}t \\\\ &= -\\int t^{5}\\,\\mathrm{d}t-5\\int 1\\,\\mathrm{d}t \\\\ &= -\\frac{t^{5+1}}{(5+1)}-5\\frac{t^{0+1}}{(0+1)}+C \\\\ &= -\\frac{t^{6}}{6}-5t+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$."] [:db/add "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/difficulty :question.difficulty/moderate] [:db/add "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/answer-fields "7141dba1-52ab-5b56-8273-475b65054ed4"] [:db/ensure "a43f7211-93e1-579c-98a5-37395b38f6c3" :question/validate] [:db/add 17592186184153 :knowledge-point/questions "a43f7211-93e1-579c-98a5-37395b38f6c3"] [:db/add "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85" :answer/id #uuid "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85"] [:db/add "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85" :answer/type :answer.type/math] [:db/add "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85" :answer/value "3t-\\frac{2}{\\sqrt{t}}+C"] [:db/ensure "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85" :answer/validate] [:db/add "01a90f9a-b732-5698-877a-1b43e8e0388a" :answer/id #uuid "01a90f9a-b732-5698-877a-1b43e8e0388a"] [:db/add "01a90f9a-b732-5698-877a-1b43e8e0388a" :answer/type :answer.type/math] [:db/add "01a90f9a-b732-5698-877a-1b43e8e0388a" :answer/value "t-\\frac{2}{\\sqrt{t}}+C"] [:db/ensure "01a90f9a-b732-5698-877a-1b43e8e0388a" :answer/validate] [:db/add "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c" :answer/id #uuid "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c"] [:db/add "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c" :answer/type :answer.type/math] [:db/add "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c" :answer/value "6t-\\frac{1}{\\sqrt{t}}+C"] [:db/ensure "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c" :answer/validate] [:db/add "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1" :answer/id #uuid "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1"] [:db/add "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1" :answer/type :answer.type/math] [:db/add "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1" :answer/value "6t-\\frac{2}{\\sqrt{t}}+C"] [:db/ensure "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1" :answer/validate] [:db/add "3c5a129e-e655-5463-8fa5-e610d85ece00" :answer/id #uuid "3c5a129e-e655-5463-8fa5-e610d85ece00"] [:db/add "3c5a129e-e655-5463-8fa5-e610d85ece00" :answer/type :answer.type/math] [:db/add "3c5a129e-e655-5463-8fa5-e610d85ece00" :answer/value "3t-\\frac{1}{\\sqrt{t}}+C"] [:db/ensure "3c5a129e-e655-5463-8fa5-e610d85ece00" :answer/validate] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/id #uuid "5c239950-b48e-5c11-82f4-4fd02bd24fce"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/key "selection"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/type :answer-field.type/radio] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/choices "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/choices "01a90f9a-b732-5698-877a-1b43e8e0388a"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/choices "ce618bea-2ea8-5b4b-a24a-0b9b5645e22c"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/choices "c4400cd9-8fb9-5cc8-a124-a60e68afe4c1"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/choices "3c5a129e-e655-5463-8fa5-e610d85ece00"] [:db/add "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/correct "3c1b62dd-ead9-5f02-9ef2-9d6c9b599c85"] [:db/ensure "5c239950-b48e-5c11-82f4-4fd02bd24fce" :answer-field/validate] [:db/add "392bd156-a25b-55e4-bce8-37c27fa38c55" :question/id #uuid "392bd156-a25b-55e4-bce8-37c27fa38c55"] [:db/add "392bd156-a25b-55e4-bce8-37c27fa38c55" :question/problem "Find the integral of $3+\\frac{1}{\\sqrt{t^{3}}}$ for $t>0$.\n\n{{selection}}"] [:db/add "392bd156-a25b-55e4-bce8-37c27fa38c55" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(3+\\frac{1}{\\sqrt{t^{3}}}\\right)\\,\\mathrm{d}t &= \\int \\left(3+\\frac{1}{t^{\\frac{3}{2}}}\\right)\\,\\mathrm{d}t \\\\ &= 3\\int 1\\,\\mathrm{d}t+\\int t^{-\\frac{3}{2}}\\,\\mathrm{d}t \\\\ &= 3\\frac{t^{0+1}}{(0+1)}+\\frac{t^{-\\frac{3}{2}+1}}{(-\\frac{3}{2}+1)}+C \\\\ &= 3t-\\frac{2}{\\sqrt{t}}+C\\end{aligned}\n$$"] [:db/add "392bd156-a25b-55e4-bce8-37c27fa38c55" :question/difficulty :question.difficulty/moderate] [:db/add "392bd156-a25b-55e4-bce8-37c27fa38c55" :question/answer-fields "5c239950-b48e-5c11-82f4-4fd02bd24fce"] [:db/ensure "392bd156-a25b-55e4-bce8-37c27fa38c55" :question/validate] [:db/add 17592186184153 :knowledge-point/questions "392bd156-a25b-55e4-bce8-37c27fa38c55"] [:db/add "265d13c3-577d-5fac-a55b-51d15a808773" :answer/id #uuid "265d13c3-577d-5fac-a55b-51d15a808773"] [:db/add "265d13c3-577d-5fac-a55b-51d15a808773" :answer/type :answer.type/math] [:db/add "265d13c3-577d-5fac-a55b-51d15a808773" :answer/value "-\\frac{t^{3}}{3}+6t"] [:db/ensure "265d13c3-577d-5fac-a55b-51d15a808773" :answer/validate] [:db/add "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/id #uuid "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7"] [:db/add "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/key "field-1"] [:db/add "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/type :answer-field.type/blank] [:db/add "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/choices "265d13c3-577d-5fac-a55b-51d15a808773"] [:db/add "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/correct "265d13c3-577d-5fac-a55b-51d15a808773"] [:db/ensure "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7" :answer-field/validate] [:db/add "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/id #uuid "2ced7f38-807e-5a63-8102-df1f51116f7a"] [:db/add "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/problem "Given $y'(t)=-t^{2}+6$, find $y(t)$, the antiderivative of $y'(t)$.\n\n$y(t)=$\n{{field-1}}\n$+\\,C$"] [:db/add "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/worked-solution "We know that $y'(t)=-t^{2}+6$.\n\nApplying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\left(-t^{2}+6\\right)\\,\\mathrm{d}t &= \\int \\left(-t^{2}+6\\right)\\,\\mathrm{d}t \\\\ &= -\\int t^{2}\\,\\mathrm{d}t+6\\int 1\\,\\mathrm{d}t \\\\ &= -\\frac{t^{2+1}}{(2+1)}+6\\frac{t^{0+1}}{(0+1)}+C \\\\ &= -\\frac{t^{3}}{3}+6t+C\\end{aligned}\n$$\n\nAny additive constant in an antiderivative can be absorbed into the displayed arbitrary constant $C$."] [:db/add "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/difficulty :question.difficulty/moderate] [:db/add "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/answer-fields "48da94e4-b9dd-5ebb-b7ec-06b9298abbe7"] [:db/ensure "2ced7f38-807e-5a63-8102-df1f51116f7a" :question/validate] [:db/add 17592186184153 :knowledge-point/questions "2ced7f38-807e-5a63-8102-df1f51116f7a"] [:db/add "eb50de8c-ecdb-5560-895f-fa5d14eae046" :answer/id #uuid "eb50de8c-ecdb-5560-895f-fa5d14eae046"] [:db/add "eb50de8c-ecdb-5560-895f-fa5d14eae046" :answer/type :answer.type/math] [:db/add "eb50de8c-ecdb-5560-895f-fa5d14eae046" :answer/value "-4x+\\frac{x^{7}}{2}+C"] [:db/ensure "eb50de8c-ecdb-5560-895f-fa5d14eae046" :answer/validate] [:db/add "4f92e116-4a5d-5079-842a-052dddf334e5" :answer/id #uuid "4f92e116-4a5d-5079-842a-052dddf334e5"] [:db/add "4f92e116-4a5d-5079-842a-052dddf334e5" :answer/type :answer.type/math] [:db/add "4f92e116-4a5d-5079-842a-052dddf334e5" :answer/value "-3x+\\frac{x^{7}}{7}+C"] [:db/ensure "4f92e116-4a5d-5079-842a-052dddf334e5" :answer/validate] [:db/add "b329d488-d81c-5863-a1d3-b5fd0268822d" :answer/id #uuid "b329d488-d81c-5863-a1d3-b5fd0268822d"] [:db/add "b329d488-d81c-5863-a1d3-b5fd0268822d" :answer/type :answer.type/math] [:db/add "b329d488-d81c-5863-a1d3-b5fd0268822d" :answer/value "-6x+\\frac{x^{7}}{7}+C"] [:db/ensure "b329d488-d81c-5863-a1d3-b5fd0268822d" :answer/validate] [:db/add "6d31b1a8-3f52-5e00-9f1c-497c8e2400c8" :answer/id #uuid "6d31b1a8-3f52-5e00-9f1c-497c8e2400c8"] [:db/add "6d31b1a8-3f52-5e00-9f1c-497c8e2400c8" :answer/type :answer.type/math] [:db/add "6d31b1a8-3f52-5e00-9f1c-497c8e2400c8" :answer/value "-3x+\\frac{x^{7}}{2}+C"] [:db/ensure "6d31b1a8-3f52-5e00-9f1c-497c8e2400c8" :answer/validate] [:db/add "a899a0ec-a01d-5fe6-b0a7-6adc5f0f285e" :answer/id #uuid "a899a0ec-a01d-5fe6-b0a7-6adc5f0f285e"] [:db/add "a899a0ec-a01d-5fe6-b0a7-6adc5f0f285e" :answer/type :answer.type/math] [:db/add "a899a0ec-a01d-5fe6-b0a7-6adc5f0f285e" :answer/value "-6x+\\frac{x^{7}}{2}+C"] [:db/ensure "a899a0ec-a01d-5fe6-b0a7-6adc5f0f2