eae92518-1053-5bf5-997b-200b5dd97071"] [:db/add "9ea01571-ea79-5220-9446-55090a760228" :answer-field/choices "0416c6db-d849-5b0b-897c-017d1824e3b7"] [:db/add "9ea01571-ea79-5220-9446-55090a760228" :answer-field/choices "8ae9c00b-df77-5303-a41a-c1e287453f51"] [:db/add "9ea01571-ea79-5220-9446-55090a760228" :answer-field/choices "324059dc-f7c3-5824-96e8-c019ead5de9d"] [:db/add "9ea01571-ea79-5220-9446-55090a760228" :answer-field/correct "324059dc-f7c3-5824-96e8-c019ead5de9d"] [:db/ensure "9ea01571-ea79-5220-9446-55090a760228" :answer-field/validate] [:db/add "c0a22e18-faf7-5870-acc2-2cc085f612e9" :question/id #uuid "c0a22e18-faf7-5870-acc2-2cc085f612e9"] [:db/add "c0a22e18-faf7-5870-acc2-2cc085f612e9" :question/problem "Given that $y = \\frac{21}{2}\\ln x$, find $\\frac{dy}{dx}$."] [:db/add "c0a22e18-faf7-5870-acc2-2cc085f612e9" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\ln x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{21}{2}\\ln x) \\\\  & =\\frac{21}{2}\\frac{\\text{d}}{\\text{d}x}(\\ln x) \\\\  & =\\frac{21}{2}\\cdot \\frac{1}{x} \\\\  & =\\frac{21}{2x}.\\end{aligned}\n$$"] [:db/add "c0a22e18-faf7-5870-acc2-2cc085f612e9" :question/difficulty :question.difficulty/easy] [:db/add "c0a22e18-faf7-5870-acc2-2cc085f612e9" :question/answer-fields "9ea01571-ea79-5220-9446-55090a760228"] [:db/ensure "c0a22e18-faf7-5870-acc2-2cc085f612e9" :question/validate] [:db/add 17592186096613 :knowledge-point/questions "c0a22e18-faf7-5870-acc2-2cc085f612e9"] [:db/add "16790f4f-c578-5c4c-bb13-6d8167e3706a" :answer/id #uuid "16790f4f-c578-5c4c-bb13-6d8167e3706a"] [:db/add "16790f4f-c578-5c4c-bb13-6d8167e3706a" :answer/type :answer.type/math] [:db/add "16790f4f-c578-5c4c-bb13-6d8167e3706a" :answer/value "\\frac{11}{6x}"] [:db/ensure "16790f4f-c578-5c4c-bb13-6d8167e3706a" :answer/validate] [:db/add "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3" :answer-field/id #uuid "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3"] [:db/add "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3" :answer-field/key "field-1"] [:db/add "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3" :answer-field/type :answer-field.type/blank] [:db/add "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3" :answer-field/choices "16790f4f-c578-5c4c-bb13-6d8167e3706a"] [:db/add "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3" :answer-field/correct "16790f4f-c578-5c4c-bb13-6d8167e3706a"] [:db/ensure "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3" :answer-field/validate] [:db/add "4de1eb25-975c-5983-98bc-143b768ecda1" :question/id #uuid "4de1eb25-975c-5983-98bc-143b768ecda1"] [:db/add "4de1eb25-975c-5983-98bc-143b768ecda1" :question/problem "Given that $y=\\frac{11}{6}\\ln x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}"] [:db/add "4de1eb25-975c-5983-98bc-143b768ecda1" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\ln x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{6}\\ln x) \\\\  & =\\frac{11}{6}\\frac{\\text{d}}{\\text{d}x}(\\ln x) \\\\  & =\\frac{11}{6}\\cdot \\frac{1}{x} \\\\  & =\\frac{11}{6x}.\\end{aligned}\n$$"] [:db/add "4de1eb25-975c-5983-98bc-143b768ecda1" :question/difficulty :question.difficulty/easy] [:db/add "4de1eb25-975c-5983-98bc-143b768ecda1" :question/answer-fields "bd4f40a1-50bd-5844-8a18-b9a27d7bf9b3"] [:db/ensure "4de1eb25-975c-5983-98bc-143b768ecda1" :question/validate] [:db/add 17592186096613 :knowledge-point/questions "4de1eb25-975c-5983-98bc-143b768ecda1"] [:db/add "c98d7561-b6f7-5754-83d8-e9cfb5fa49fa" :answer/id #uuid "c98d7561-b6f7-5754-83d8-e9cfb5fa49fa"] [:db/add "c98d7561-b6f7-5754-83d8-e9cfb5fa49fa" :answer/type :answer.type/math] [:db/add "c98d7561-b6f7-5754-83d8-e9cfb5fa49fa" :answer/value "\\frac{1}{x}"] [:db/ensure