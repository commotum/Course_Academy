1b3"] [:db/add "697835dc-03ad-5fb5-88bf-35beb7f43aa6" :answer-field/choices "1911a5a7-f3f7-570f-9fa3-c1981c4207d2"] [:db/add "697835dc-03ad-5fb5-88bf-35beb7f43aa6" :answer-field/choices "cf3a5ea2-bbee-5c81-a219-c37346ebec71"] [:db/add "697835dc-03ad-5fb5-88bf-35beb7f43aa6" :answer-field/choices "3ee743cc-f41a-5f09-bc26-34dd01d784e7"] [:db/add "697835dc-03ad-5fb5-88bf-35beb7f43aa6" :answer-field/correct "2af3b741-0e3b-5d69-b4c9-aeec185861b3"] [:db/ensure "697835dc-03ad-5fb5-88bf-35beb7f43aa6" :answer-field/validate] [:db/add "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/id #uuid "41c093aa-391c-5ebf-acae-bdc80fe54491"] [:db/add "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-1-2x)^{3}.$"] [:db/add "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{3},\\,g=-1-2x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=3g^{2},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-2.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=3\\cdot (-2)\\cdot (-1-2x)^{2} \\\\  &=-6(-1-2x)^{2}.\\end{aligned}\n$$"] [:db/add "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/difficulty :question.difficulty/easy] [:db/add "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/answer-fields "697835dc-03ad-5fb5-88bf-35beb7f43aa6"] [:db/ensure "41c093aa-391c-5ebf-acae-bdc80fe54491" :question/validate] [:db/add 17592186096841 :knowledge-point/questions "41c093aa-391c-5ebf-acae-bdc80fe54491"] [:db/add "38f7b679-b110-593d-9a4d-48c344350489" :answer/id #uuid "38f7b679-b110-593d-9a4d-48c344350489"] [:db/add "38f7b679-b110-593d-9a4d-48c344350489" :answer/type :answer.type/math] [:db/add "38f7b679-b110-593d-9a4d-48c344350489" :answer/value "6(-9+3x)"] [:db/ensure "38f7b679-b110-593d-9a4d-48c344350489" :answer/validate] [:db/add "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/id #uuid "b127e32c-07a6-53ec-8d86-716356179dde"] [:db/add "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/key "field-1"] [:db/add "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/type :answer-field.type/blank] [:db/add "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/choices "38f7b679-b110-593d-9a4d-48c344350489"] [:db/add "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/correct "38f7b679-b110-593d-9a4d-48c344350489"] [:db/ensure "b127e32c-07a6-53ec-8d86-716356179dde" :answer-field/validate] [:db/add "4488b435-75c4-5bf8-836f-8c025405b71b" :question/id #uuid "4488b435-75c4-5bf8-836f-8c025405b71b"] [:db/add "4488b435-75c4-5bf8-836f-8c025405b71b" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-9+3x)^{2}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}"] [:db/add "4488b435-75c4-5bf8-836f-8c025405b71b" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{2},\\,g=-9+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=2g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=2g\\cdot (3) \\\\  &=6(-9+3x).\\end{aligned}\n$$"] [:db/add "4488b435-75c4-5bf8-836f-8c025405b71b" :question/difficulty :question.difficulty/easy] [:db/add "4488b435-75c4-5bf8-836f-8c025405b71b" :question/answer-fields "b127e32c-07a6-53ec-8d86-716356179dde"] [:db/ensure "4488b435-75c4-5bf8-836f-8c025405b71b" :question/validate] [:db/add 17592186096841 :knowledge-point/questions "4488b435-75c4-5bf8-836f-8c025405b71b"] [:db/add "832f82b0-8996-58d2-aa20-2768c526e9b1" :answer/id #uuid "832f82b0-8996-58d2-aa20-2768c526e9b1"] [:db/add "832f82b0-8996-58d2-aa20-2768c526e9b1" :answer/type :answer.type/math] [:db/add "832f82b0-8996-58d2-aa20-2768c526e9b1" :answer/value "12(5+3x)^{3}"] [:db/ensure "832f82b0-8996-58d2-aa20-2768c526e9b1" :answer/validate] [:db/add "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/id #uuid "de68a7e9-8973-5b5b-b7b3-263757a2e394"] [:db/add "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/key "field-1"] [:db/add "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/type :answer-field.type/blank] [:db/add "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/choices "832f82b0-8996-58d2-aa20-2768c526e9b1"] [:db/add "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/correct "832f82b0-8996-58d2-aa20-2768c526e9b1"] [:db/ensure "de68a7e9-8973-5b5b-b7b3-263757a2e394" :answer-field/validate] [:db/add "a25c900d-1561-5094-9272-47bf64ff1c06" :question/id #uuid "a25c900d-1561-5094-9272-47bf64ff1c06"] [:db/add "a25c900d-1561-5094-9272-47bf64ff1c06" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(5+3x)^{4}.$\n\n$\\frac{\\text{d}f}{\\text{d}x}=$\n{{field-1}}"] [:db/add "a25c900d-1561-5094-9272-47bf64ff1c06" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{4},\\,g=5+3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g^{3},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=4g^{3}\\cdot (3) \\\\  &=12(5+3x)^{3}.\\end{aligned}\n$$"] [:db/add "a25c900d-1561-5094-9272-47bf64ff1c06" :question/difficulty :question.difficulty/easy] [:db/add "a25c900d-1561-5094-9272-47bf64ff1c06" :question/answer-fields "de68a7e9-8973-5b5b-b7b3-263757a2e394"] [:db/ensure "a25c900d-1561-5094-9272-47bf64ff1c06" :question/validate] [:db/add 17592186096841 :knowledge-point/questions "a25c900d-1561-5094-9272-47bf64ff1c06"] [:db/add "generator" :question-generator/id #uuid "c0d476d4-c558-5650-a182-9ec33aa1342c"] [:db/add "generator" :question-generator/script "generators/68/68a154d05b07c591d4f6dd481fb850b901f687d1a158874496ccafcdb3438773/generator.py"] [:db/add 17592186096841 :knowledge-point/question-generator "generator"] [:db/ensure 17592186096841 :knowledge-point/validate]]
