swer-field/choices "f771748e-0724-5882-9ec8-fdf9ce712c4a"] [:db/add "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/choices "d3e08094-b4f8-524a-b559-837c1a01dfd8"] [:db/add "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/choices "1c35b387-63bd-565d-b5dc-feba286107ad"] [:db/add "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/choices "1afff144-faa8-5d98-8b52-2e0fcc9a7f3c"] [:db/add "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/choices "8ff15c7e-b33c-59b4-b72a-86eca43164f7"] [:db/add "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/correct "1afff144-faa8-5d98-8b52-2e0fcc9a7f3c"] [:db/ensure "eb94c143-3dce-569c-b7cf-c17c32239041" :answer-field/validate] [:db/add "c83476a7-334e-550f-a570-977c18f19b5f" :question/id #uuid "c83476a7-334e-550f-a570-977c18f19b5f"] [:db/add "c83476a7-334e-550f-a570-977c18f19b5f" :question/problem "Find $\\frac{\\text{d}f}{\\text{d}x}$ when $f(x)=(-7+6x)^{5}.$"] [:db/add "c83476a7-334e-550f-a570-977c18f19b5f" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=g^{5},\\,g=-7+6x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=5g^{4},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=6.\n$$\n\nFinally, multiplying the two together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} &=5\\cdot 6\\cdot (-7+6x)^{4} \\\\  &=30(-7+6x)^{4}.\\end{aligned}\n$$"] [:db/add "c83476a7-334e-550f-a570-977c18f19b5f" :question/difficulty :question.difficulty/easy] [:db/add "c83476a7-334e-550f-a570-977c18f19b5f" :question/answer-fields "eb94c143-3dce-569c-b7cf-c17c32239041"] [:db/ensure "c83476a7-334e-550f-a570-977c18f19b5f" :question/validate] [:db/add 17592186096841 :knowledge-point/questions "c83476a7-334e-550f-a570-977c18f19b5f"] [:db/add "685dc9ff-3893-53af-a4fe-684701e82263" :answer/id #uuid "685dc9ff-3893-53