2d0285-39be-5f4b-8137-eea61ed52b9b"] [:db/add "c28412ef-227e-5ded-9964-e41d96174b86" :answer-field/choices "80cc6b4d-e037-5552-9468-63b241864f23"] [:db/add "c28412ef-227e-5ded-9964-e41d96174b86" :answer-field/choices "3af54b83-704e-55d5-a89d-14d9c5f3ff86"] [:db/add "c28412ef-227e-5ded-9964-e41d96174b86" :answer-field/correct "e031eaae-76f9-58af-b3e6-50abf25c826b"] [:db/ensure "c28412ef-227e-5ded-9964-e41d96174b86" :answer-field/validate] [:db/add "e8ccbb82-8efb-534c-acab-7f6468bd8bed" :question/id #uuid "e8ccbb82-8efb-534c-acab-7f6468bd8bed"] [:db/add "e8ccbb82-8efb-534c-acab-7f6468bd8bed" :question/problem "Find the slope of the tangent to the curve $y=\\sqrt{37+7x}$ at the point where $x=-4.$"] [:db/add "e8ccbb82-8efb-534c-acab-7f6468bd8bed" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=37+7x.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}}\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=7.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot (7) \\\\  & =\\frac{7}{2\\sqrt{37+7x}}.\\end{aligned}\n$$\n\nFinally, substituting $x=-4,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=-4} & ={(\\frac{7}{2\\sqrt{37+7x}})|}_{x=-4} \\\\  & =\\frac{7}{2\\sqrt{37+7(-4)}} \\\\  & =\\frac{7}{2\\sqrt{9}} \\\\  & =\\frac{7}{6}.\\end{aligned}\n$$"] [:db/add "e8ccbb82-8efb-534c-acab-7f6468bd8bed" :question/difficulty :question.difficulty/easy] [:db/add "e8ccbb82-8efb-534c-acab-7f6468bd8bed" :question/answer-fields "c28412ef-227e-5ded-9964-e41d96174b86"] [:db/ensure "e8ccbb82-8efb-534c-acab-7f6468bd8bed" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "e8ccbb82-8efb-534c-acab-7f6468bd8bed"] [:db/add "255f9156-287e-5cc9-b8ed-eb31b15e83ce" :answer/id #uuid "255f9156-287e-5cc9-b8ed-eb31b15e83ce"] [:db/add "255f9156-287e-5cc9-b8ed-eb31b15e83ce" :answer/type :answer.type/math] [:db/add "255f9156-287e-5cc9-b8ed-eb31b15e83ce" :answer/value "-\\frac{7}{8}"] [:db/ensure "255f9156-287e-5cc9-b8ed-eb31b15e83ce" :answer/validate] [:db/add "b024a65a-2e57-571c-a34d-025276659956" :answer-field/id #uuid "b024a65a-2e57-571c-a34d-025276659956"] [:db/add "b024a65a-2e57-571c-a34d-025276659956" :answer-field/key "field-1"] [:db/add "b024a65a-2e57-571c-a34d-025276659956" :answer-field/type :answer-field.type/blank] [:db/add "b024a65a-2e57-571c-a34d-025276659956" :answer-field/choices "255f9156-287e-5cc9-b8ed-eb31b15e83ce"] [:db/add "b024a65a-2e57-571c-a34d-025276659956" :answer-field/correct "255f9156-287e-5cc9-b8ed-eb31b15e83ce"] [:db/ensure "b024a65a-2e57-571c-a34d-025276659956" :answer-field/validate] [:db/add "0a831727-2211-5532-89c4-e5a4ccb9ae4a" :question/id #uuid "0a831727-2211-5532-89c4-e5a4ccb9ae4a"] [:db/add "0a831727-2211-5532-89c4-e5a4ccb9ae4a" :question/problem "The slope of the tangent to the curve $y=\\sqrt{-7x+16}$ at the point where $x=0$ is{{field-1}}."] [:db/add "0a831727-2211-5532-89c4-e5a4ccb9ae4a" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nWe use the chain rule in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x}.\n$$\n\nLet $u=-7x+16.$ Then $y=\\sqrt{u}.$ Differentiating, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{2\\sqrt{u}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-7.\n$$\n\nMultiplying the two together gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\sqrt{u}}\\cdot -7 \\\\  & =-\\frac{7}{2\\sqrt{-7x+16}}.\\end{aligned}\n$$\n\nFinally, substituting $x=0,$ we get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=0} & ={(-\\frac{7}{2\\sqrt{-7x+16}})|}_{x=0} \\\\  & =\\frac{-7}{2\\sqrt{-7(0)+16}} \\\\  & =\\frac{-7}{2\\sqrt{16}} \\\\  & =-\\frac{7}{8}.\\end{aligned}\n$$"] [:db/add "0a831727-2211-5532-89c4-e5a4ccb9ae4a" :question/difficulty :question.difficulty/easy] [:db/add "0a831727-2211-5532-89c4-e5a4ccb9ae4a" :question/answer-fields "b024a65a-2e57-571c-a34d-025276659956"] [:db/ensure "0a831727-2211-5532-89c4-e5a4ccb9ae4a" :question/validate] [:db/add 17592186096842 :knowledge-point/questions "0a831727-2211-5532-89c4-e5a4ccb9ae4a"] [:db/add "generator" :question-generator/id #uuid "0030c640-dd5e-5cb2-bf79-63ca005b1fd0"] [:db/add "generator" :question-generator/script "generators/80/80a655d232caba2d99e4963f0264d5db31957c47ea6a75ac1b4cdef521a2e06b/generator.py"] [:db/add 17592186096842 :knowledge-point/question-generator "generator"] [:db/ensure 17592186096842 :knowledge-point/validate]]
