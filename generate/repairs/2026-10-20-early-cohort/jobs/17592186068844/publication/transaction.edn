[[:db/add "f9a2174b-195b-5b75-a33b-e70cd25e9c31" :answer/id #uuid "f9a2174b-195b-5b75-a33b-e70cd25e9c31"] [:db/add "f9a2174b-195b-5b75-a33b-e70cd25e9c31" :answer/type :answer.type/math] [:db/add "f9a2174b-195b-5b75-a33b-e70cd25e9c31" :answer/value "\\left(y - 6\\right)^{\\frac{3}{2}}=- \\left(x - 3\\right)^{\\frac{3}{2}}+C"] [:db/ensure "f9a2174b-195b-5b75-a33b-e70cd25e9c31" :answer/validate] [:db/add "3b0ca276-9e95-579e-8f2a-a9c6b5a9df45" :answer/id #uuid "3b0ca276-9e95-579e-8f2a-a9c6b5a9df45"] [:db/add "3b0ca276-9e95-579e-8f2a-a9c6b5a9df45" :answer/type :answer.type/math] [:db/add "3b0ca276-9e95-579e-8f2a-a9c6b5a9df45" :answer/value "\\left(y - 6\\right)^{\\frac{3}{2}}=3 \\left(x - 3\\right)^{\\frac{3}{2}}+C"] [:db/ensure "3b0ca276-9e95-579e-8f2a-a9c6b5a9df45" :answer/validate] [:db/add "458ec8b8-a147-5276-9b8b-caafcc4876ae" :answer/id #uuid "458ec8b8-a147-5276-9b8b-caafcc4876ae"] [:db/add "458ec8b8-a147-5276-9b8b-caafcc4876ae" :answer/type :answer.type/math] [:db/add "458ec8b8-a147-5276-9b8b-caafcc4876ae" :answer/value "\\left(y - 6\\right)^{\\frac{3}{2}}=2 \\left(x - 3\\right)^{\\frac{3}{2}}+C"] [:db/ensure "458ec8b8-a147-5276-9b8b-caafcc4876ae" :answer/validate] [:db/add "6310a5d0-5e6e-58a0-9e28-f8ce43f9ddda" :answer/id #uuid "6310a5d0-5e6e-58a0-9e28-f8ce43f9ddda"] [:db/add "6310a5d0-5e6e-58a0-9e28-f8ce43f9ddda" :answer/type :answer.type/math] [:db/add "6310a5d0-5e6e-58a0-9e28-f8ce43f9ddda" :answer/value "\\left(y - 6\\right)^{\\frac{3}{2}}=\\left(x - 3\\right)^{\\frac{3}{2}}+C"] [:db/ensure "6310a5d0-5e6e-58a0-9e28-f8ce43f9ddda" :answer/validate] [:db/add "297b530e-20d7-5e81-b425-fa1768707754" :answer/id #uuid "297b530e-20d7-5e81-b425-fa1768707754"] [:db/add "297b530e-20d7-5e81-b425-fa1768707754" :answer/type :answer.type/math] [:db/add "297b530e-20d7-5e81-b425-fa1768707754" :answer/value "\\left(y - 6\\right)^{\\frac{3}{2}}=- 2 \\left(x - 3\\right)^{\\frac{3}{2}}+C"] [:db/ensure "297b530e-20d7-5e81-b425-fa1768707754" :answer/validate] [:db/add "c6c7faae-0ae2-