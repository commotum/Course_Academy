2})\\,\\text{d}y & =\\int (3 x^{2} + 2)\\,\\text{d}x \\\\ \\int y^2\\,\\text{d}y & =\\int 3x^2\\,\\text{d}x+\\int 2\\,\\text{d}x \\\\ \\frac{y^3}{3} & =\\frac{3x^3}{3}+2x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{3}}{3}=x^{3} + 2 x+C.\n$$"} {:db/id #edb/ref 17592186564774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ea46271-1e0d-5eaf-af58-a267c3db915c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + y=2 x^{3} - 4 x+C" :db/id #edb/ref 17592186564744} {:answer/id #uuid "532d93fd-ed95-5be0-ac7c-7fd43a28776b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + y=x^{3} - 2 x+C" :db/id #edb/ref 17592186564746} {:answer/id #uuid "7be0e9de-48e1-5993-83d4-2be68f47c612" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=x^{3} - 2 x+C" :db/id #edb/ref 17592186564760} {:answer/id #uuid "9eed1bd1-5b75-5b79-b72d-b4b5fed96f52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + y=x^{3}+C" :db/id #edb/ref 17592186564772} {:answer/id #uuid "bfd94d8d-7a81-5c65-982c-c9c5bad861c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + y=- x^{3} + 2 x+C" :db/id #edb/ref 17592186564780}] :answer-field/correct {:answer/id #uuid "532d93fd-ed95-5be0-ac7c-7fd43a28776b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + y=x^{3} - 2 x+C" :db/id #edb/ref 17592186564746} :answer-field/id #uuid "db7efe8d-6fd2-5eb0-9e1f-d2844da57cf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564786}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ad5ae15e-bae7-5cbe-9a05-a2959a8a0793" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=\\frac{3 x^{2} - 2}{y^{2} + 1}.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{3 x^{2} - 2}{y^{2} + 1} \\\\ (y^{2} + 1)\\,\\frac{\\text{d}y}{\\text{d}x} & =3 x^{2} - 2\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int (y^{2} + 1)\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (3 x^{2} - 2)\\,\\text{d}x \\\\ \\int (y^{2} + 1)\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int (3 x^{2} - 2)\\,\\text{d}x \\\\ \\int (y^{2} + 1)\\,\\text{d}y & =\\int (3 x^{2} - 2)\\,\\text{d}x \\\\ \\int y^2\\,\\text{d}y+\\int 1\\,\\text{d}y & =\\int 3x^2\\,\\text{d}x-\\int 2\\,\\text{d}x \\\\ \\frac{y^3}{3}+1y & =\\frac{3x^3}{3}-2x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{3}}{3} + y=x^{3} - 2 x+C.\n$$"} {:db/id #edb/ref 17592186564776 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f40e511-9162-550c-9ca2-45069c532860" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + 2 y=\\frac{2 x^{3}}{3} - 4 x+C" :db/id #edb/ref 17592186564728} {:answer/id #uuid "5e5b365d-b010-5d40-ae9b-7cdf2bc9fef7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + 2 y=\\frac{4 x^{3}}{3} - 8 x+C" :db/id #edb/ref 17592186564748} {:answer/id #uuid "5e654d84-87a6-5c4a-b50f-52951169e736" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + 2 y=- \\frac{2 x^{3}}{3} + 4 x+C" :db/id #edb/ref 17592186564749} {:answer/id #uuid "928f0b31-f944-5f57-a0b8-e69268c93db4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=\\frac{2 x^{3}}{3} - 4 x+C" :db/id #edb/ref 17592186564767} {:answer/id #uuid "d900b285-6248-5c1b-87a5-f18bdbb83a2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + 2 y=\\frac{2 x^{3}}{3}+C" :db/id #edb/ref 17592186564784}] :answer-field/correct {:answer/id #uuid "0f40e511-9162-550c-9ca2-45069c532860" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3} + 2 y=\\frac{2 x^{3}}{3} - 4 x+C" :db/id #edb/ref 17592186564728} :answer-field/id #uuid "813d9f9a-fa68-5dc1-9e51-8ed9878f3c04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564762}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b65718d4-b12a-5895-93fb-8677bffa9b3c" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=\\frac{2 x^{2} - 4}{y^{2} + 2}.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2 x^{2} - 4}{y^{2} + 2} \\\\ (y^{2} + 2)\\,\\frac{\\text{d}y}{\\text{d}x} & =2 x^{2} - 4\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int (y^{2} + 2)\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2 x^{2} - 4)\\,\\text{d}x \\\\ \\int (y^{2} + 2)\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int (2 x^{2} - 4)\\,\\text{d}x \\\\ \\int (y^{2} + 2)\\,\\text{d}y & =\\int (2 x^{2} - 4)\\,\\text{d}x \\\\ \\int y^2\\,\\text{d}y+\\int 2\\,\\text{d}y & =\\int 2x^2\\,\\text{d}x-\\int 4\\,\\text{d}x \\\\ \\frac{y^3}{3}+2y & =\\frac{2x^3}{3}-4x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{3}}{3} + 2 y=\\frac{2 x^{3}}{3} - 4 x+C.\n$$"} {:db/id #edb/ref 17592186564781 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a80263b-0173-50c1-8dde-6c3cfba6f1ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=- \\frac{2 x^{3}}{3} + 4 x+C" :db/id #edb/ref 17592186564733} {:answer/id #uuid "43098fc8-a701-552a-8369-84c5e4b393e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=\\frac{4 x^{3}}{3} - 8 x+C" :db/id #edb/ref 17592186564743} {:answer/id #uuid "9672fd10-89cb-571c-8f61-a39749abc788" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2}=\\frac{2 x^{3}}{3} - 4 x+C" :db/id #edb/ref 17592186564768} {:answer/id #uuid "cccfbb02-c9ff-5a31-8add-f1c2e35d57c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=\\frac{2 x^{3}}{3}+C" :db/id #edb/ref 17592186564782} {:answer/id #uuid "e62dc35a-2c8a-5355-936e-f363e3f97dcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=\\frac{2 x^{3}}{3} - 4 x+C" :db/id #edb/ref 17592186564789}] :answer-field/correct {:answer/id #uuid "e62dc35a-2c8a-5355-936e-f363e3f97dcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=\\frac{2 x^{3}}{3} - 4 x+C" :db/id #edb/ref 17592186564789} :answer-field/id #uuid "9a317931-280d-5d7f-9352-0a157680e251" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564770}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c08898da-32ad-5a3c-a964-0cd90dc6de56" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=\\frac{2 x^{2} - 4}{y^{2}}.$ Work on an interval where $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2 x^{2} - 4}{y^{2}} \\\\ (y^{2})\\,\\frac{\\text{d}y}{\\text{d}x} & =2 x^{2} - 4\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int (y^{2})\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2 x^{2} - 4)\\,\\text{d}x \\\\ \\int (y^{2})\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int (2 x^{2} - 4)\\,\\text{d}x \\\\ \\int (y^{2})\\,\\text{d}y & =\\int (2 x^{2} - 4)\\,\\text{d}x \\\\ \\int y^2\\,\\text{d}y & =\\int 2x^2\\,\\text{d}x-\\int 4\\,\\text{d}x \\\\ \\frac{y^3}{3} & =\\frac{2x^3}{3}-4x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{3}}{3}=\\frac{2 x^{3}}{3} - 4 x+C.\n$$"} {:db/id #edb/ref 17592186564787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3414c5d2-20cf-5914-a9a9-332d71670cb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=x^{3} - 2 x+C" :db/id #edb/ref 17592186564736} {:answer/id #uuid "397ebe0f-f377-53d2-bd21-fce260323bf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=x^{3}+C" :db/id #edb/ref 17592186564739} {:answer/id #uuid "6894bf98-eb66-522e-979d-33a00c26d36b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=- x^{3} + 2 x+C" :db/id #edb/ref 17592186564752} {:answer/id #uuid "79ced1aa-6ded-5a07-87bd-71bc6d94480b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=2 x^{3} - 4 x+C" :db/id #edb/ref 17592186564759} {:answer/id #uuid "bb910cc9-69e7-5653-ace0-42a53998a788" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2}=x^{3} - 2 x+C" :db/id #edb/ref 17592186564779}] :answer-field/correct {:answer/id #uuid "3414c5d2-20cf-5914-a9a9-332d71670cb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y^{3}}{3}=x^{3} - 2 x+C" :db/id #edb/ref 17592186564736} :answer-field/id #uuid "6be49230-b2e0-5bf2-9f22-b2261d348685" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186564754}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e3a102d8-6b1a-53a5-a710-b6fa6cc5a594" :question/problem "Find the general solution to the differential equation (in implicit form) $\\frac{\\text{d}y}{\\text{d}x}=\\frac{3 x^{2} - 2}{y^{2}}.$ Work on an interval where $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned