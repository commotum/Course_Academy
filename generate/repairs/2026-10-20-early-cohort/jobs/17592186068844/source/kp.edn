int \\text{d}x \\\\ \\operatorname{arcsin}⁡y & =x+C.\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{arcsin}⁡y=x+C.\n$$"} {:db/id #edb/ref 17592186253525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae3c5e0-1352-56fd-ba70-9a98aacdb051" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡y={e}^{x}+C" :db/id #edb/ref 17592186250782} {:answer/id #uuid "3b8d8918-9739-590c-9fbc-5d363870224a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡y={e}^{2x}+C" :db/id #edb/ref 17592186251048} {:answer/id #uuid "7590b4e3-175b-5973-b9a4-23a24a9d8b1e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡y={e}^{2x}+C" :db/id #edb/ref 17592186251521} {:answer/id #uuid "d65bc188-62c5-5f03-8494-a8fcd839865a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡y=2{e}^{x}+C" :db/id #edb/ref 17592186252450} {:answer/id #uuid "dbcc7213-5543-5c22-a097-9b55ce7076ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡y={e}^{x}+C" :db/id #edb/ref 17592186252486}] :answer-field/correct {:answer/id #uuid "dbcc7213-5543-5c22-a097-9b55ce7076ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡y={e}^{x}+C" :db/id #edb/ref 17592186252486} :answer-field/id #uuid "d173063d-47e4-520d-a7a8-338e552ab61b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253168}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a130453a-6065-5959-8de8-bb802e7d41f1" :question/math-academy-id "q-118885" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{x}{cos}^{2}⁡y$ for $0<y<\\frac{\\pi }{2}.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}{cos}^{2}⁡y \\\\ \\frac{1}{{cos}^{2}⁡y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x} \\\\ {sec}^{2}⁡y\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {sec}^{2}⁡y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {sec}^{2}⁡y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {sec}^{2}⁡y\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ \\operatorname{tan}⁡y & ={e}^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{tan}⁡y={e}^{x}+C.\n$$"} {:db/id #edb/ref 17592186272345 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17b4d2f7-6de2-5196-b879-a739a65217f9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}=\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186269464} {:answer/id #uuid "6d70ab15-788c-5c79-a3c0-32dd56d91377" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|={e}^{x}+C" :db/id #edb/ref 17592186270240} {:answer/id #uuid "9562133f-63b5-500a-8c0d-b36151b151b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|={e}^{\\sqrt{x}}+C" :db/id #edb/ref 17592186270580} {:answer/id #uuid "d007c7f5-5f1d-5941-b941-1b46c8f9d226" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{\\sqrt{x}}+C" :db/id #edb/ref 17592186271095} {:answer/id #uuid "e3317b49-f544-53b2-a03e-5508bdec7af7" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{x}+C" :db/id #edb/ref 17592186271269}] :answer-field/correct {:answer/id #uuid "6d70ab15-788c-5c79-a3c0-32dd56d91377" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|={e}^{x}+C" :db/id #edb/ref 17592186270240} :answer-field/id #uuid "df0697db-7cb2-5930-925b-39436791038a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271900}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c8ed818f-2b3f-54cd-b6b2-99b0955850e8" :question/math-academy-id "q-14246" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y{e}^{x}$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y{e}^{x} \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & ={e}^{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|={e}^{x}+C\n$$"} {:db/id #edb/ref 17592186275322 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a0c82e4-a410-5545-aba6-e6bc3809dd5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡y=x+C" :db/id #edb/ref 17592186272760} {:answer/id #uuid "632f8488-1426-51de-b79c-859a00953830" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186273240} {:answer/id #uuid "8f09bfeb-fa40-5b8c-a65a-f33bf93f0996" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡y=\\sqrt{x}+C" :db/id #edb/ref 17592186273624} {:answer/id #uuid "9fa6a988-751b-5fc3-92dd-5e4dfbf0e530" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡y=\\sqrt{x}+C" :db/id #edb/ref 17592186273767} {:answer/id #uuid "df59ea5f-fed1-54