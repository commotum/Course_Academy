              ":answer/value": "1"
            },
            {
              ":answer/id": "b3a29e12-eb16-530a-8064-b4ca9c5a2a9e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "3"
            },
            {
              ":answer/id": "582e7398-565a-57ca-9abe-a015cf0c0caa",
              ":answer/type": ":answer.type/math",
              ":answer/value": "4"
            },
            {
              ":answer/id": "abc76b0b-f8a5-5041-b78c-e890edcd3434",
