ion/math-academy-id "q-49450" :question/problem "$\\int \\frac{1}{x-1}\\,\\text{d}x=$" :question/worked-solution "First, let $u=x-1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x-1}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|x-1|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332719 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1769bd13-d55d-5f6a-9446-919c53c722cf" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186330148} {:answer/id #uuid "54869286-b971-57b4-815f-5bbbdc7c4d50" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186330712} {:answer/id #uuid "7f11a40a-6408-5a1b-9034-2e0d3b330be3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331071} {:answer/id #uuid "84440df1-9b77-5a93-ac20-596184b2ec9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331124} {:answer/id #uuid "dba89aaa-0aa6-5aba-a139-c4ea916ad0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331897}] :answer-field/correct {:answer/id #uuid "dba89aaa-0aa6-5aba-a139-c4ea916ad0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C" :db/id #edb/ref 17592186331897} :answer-field/id #uuid "595a4b0f-ad62-571b-b6da-2d943ad48b26" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332373}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2da03267-825e-5f39-863f-d7f53abceed7" :question/math-academy-id "q-49452" :question/problem "$\\int \\frac{1}{2-3x}\\,\\text{d}x=$" :question/worked-solution "First, let $u=2-3x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\,⟹\\,\\text{d}x=-\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u$, solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{2-3x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{3}\\,\\text{d}u) \\\\  & =-\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|2-3x|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186332720 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a085972-1baf-5648-867f-fa22e0ba0ea8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330175} {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} {:answer/id #uuid "903c6656-2cfe-57a6-9d04-bf4558a5f1f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331233} {:answer/id #uuid "b84ce15d-f916-5272-a13b-c0e2002f591a" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331578} {:answer/id #uuid "c7f98b80-b189-5486-9209-b6f6b685306a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186331720}] :answer-field/correct {:answer/id #uuid "333a8449-f54e-51ed-9268-4a29c687d042" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡|x+4|+C" :db/id #edb/ref 17592186330401} :answer-field/id #uuid "e906895e-8048-51d8-952c-ac1ed3e3bf3a" :answer-field/ke