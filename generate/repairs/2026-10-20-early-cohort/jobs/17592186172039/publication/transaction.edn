6e6" :answer/value "true"] [:db/ensure "d1867bd6-b714-5f29-8114-28ddc8ae26e6" :answer/validate] [:db/add "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/id #uuid "4c172603-3c76-5401-bda5-a92ee01ca639"] [:db/add "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/key "None of the above"] [:db/add "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/type :answer-field.type/checkbox] [:db/add "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/choices "1de02087-3c61-50b7-b52b-577a820446ec"] [:db/add "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/choices "d1867bd6-b714-5f29-8114-28ddc8ae26e6"] [:db/add "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/correct "1de02087-3c61-50b7-b52b-577a820446ec"] [:db/ensure "4c172603-3c76-5401-bda5-a92ee01ca639" :answer-field/validate] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/id #uuid "f9e7f7af-d580-538d-a616-31dc4ee6d3fd"] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=5xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply."] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/worked-solution "First, we define $f(x,y)=5xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement “At every point in the second quadrant, the slope of the slope field is negative” is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement “At every point in the first quadrant, the slope of the slope field is positive” is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement “At every point in the third quadrant, the slope of the slope field is negative” is false. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\nTherefore, the correct answer is “At every point in the second quadrant, the slope of the slope field is negative”; “At every point in the first quadrant, the slope of the slope field is positive”."] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/difficulty :question.difficulty/moderate] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/answer-fields "6d6ed8a6-7d75-5550-8a8c-2db9c82f28df"] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/answer-fields "5df2f3d5-a35f-57fb-96e7-3b6d678716d3"] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/answer-fields "d8fc5edf-b284-52a8-811a-3db53d1a274c"] [:db/add "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/answer-fields "4c172603-3c76-5401-bda5-a92ee01ca639"] [:db/ensure "f9e7f7af-d580-538d-a616-31dc4ee6d3fd" :question/validate] [:db/add 17592186172039 :knowledge-point/questions "f9e7f7af-d580-538d-a616-31dc4ee6d3fd"] [:db/add "10647332-68a0-5e56-928b-58e3ecb6ff5b" :answer/id #uuid "10647332-68a0-5e56-928b-58e3ecb6ff5b"] [:db/add "10647332-68a0-5e56-928b-58e3ecb6ff5b" :answer/type :answer.type/text] [:db/add "10647332-68a0-5e56-928b-58e3ecb6ff5b" :answer/value "false"] [:db/ensure "10647332-68a0-5e56-928b-58e3ecb6ff5b" :answer/validate] [:db/