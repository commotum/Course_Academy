#{[{:db/id #edb/ref 17592186050404 :topic/id #uuid "46172e8e-6e68-554f-baaa-252a31973372" :topic/knowledge-points [{:db/id #edb/ref 17592186133722 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133501 :question/id #uuid "127ac025-aa32-505a-98d8-27721a37fdbe" :question/math-academy-id "e-12829" :question/problem "What is the value of $\\sqrt{126}$ rounded to $3$ decimal places?" :question/worked-solution "Using a calculator, we find that\n\n$$\n\\sqrt{126}=11.224\\,972\\,160\\,...\n$$\n\nNow, we round to $3$ decimal places:\n\n$$\n\\sqrt{126} \\approx 11.225\n$$"} :knowledge-point/id #uuid "2c606764-287a-500f-aa91-e6a68bec8860" :knowledge-point/title "Finding a Decimal Approximation of a Square Root Surd"} {:db/id #edb/ref 17592186133723 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133500 :question/id #uuid "0b823033-1f76-5656-a284-b94f33f3e359" :question/math-academy-id "e-12828" :question/problem "Which of the following numbers are surds?\n\n$$\n\\sqrt{2},\\qquad \\sqrt{8},\\qquad \\sqrt{16}\n$$" :question/worked-solution "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt{2}$ is a surd. Using a calculator, we find that $\\sqrt{2}=1.414\\,213\\,562\\,...$\n\n- $\\sqrt{8}$ is a surd. Using a calculator, we find that $\\sqrt{8}=2.828\\,427\\,124\\,...$\n\n- $\\sqrt{16}$ is **NOT** a surd. Since $16$ is a perfect square, we can get rid of the square root symbol ($\\sqrt{\\phantom{x}}$) and obtain a whole number:\n\n$$\n\\sqrt{16}=\\sqrt{4^2}=4\n$$\n\nTherefore, the correct answer is: $\\sqrt{2}$ and $\\sqrt{8}$ only."} :knowledge-point/id #uuid "bf6ecc42-d84a-584f-9ccc-d6a987c89394" :knowledge-point/title "Identifying Surds: Square Roots of Integers"} {:db/id #edb/ref 17592186133724 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133515 :question/id #uuid "12b5f86f-9e86-5c1b-8773-38e2b69a6417" :question/math-academy-id "e-13357" :question/problem "Which of the following numbers are surds?\n\n$$\n\\sqrt{\\dfrac{5}{12}}, \\qquad \\sqrt{\\dfrac{64}{81}}, \\qquad \\sqrt{\\dfrac{10}{7}}\n$$" :question/worked-solution "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt{\\dfrac{5}{12}}$ is a surd. Using a calculator, we find that $\\sqrt{\\dfrac{5}{12}} = 0.645\\,497\\,\\ldots$\n\n- $\\sqrt{\\dfrac{64}{81}}$ is **NOT** a surd. Since $64$ and $81$ are perfect squares, we can get rid of the square root symbol $(\\sqrt{\\phantom{0}})$ and obtain a regular fraction.\n\n$$\n\\begin{aligned}\\sqrt{\\frac{64}{81}} & =\\sqrt{\\frac{{8}^{2}}{{9}^{2}}} \\\\  & =\\sqrt{\\frac{8\\cdot 8}{9\\cdot 9}} \\\\  & =\\sqrt{\\frac{8}{9}\\cdot \\frac{8}{9}} \\\\  & =\\sqrt{{\\left(\\frac{8}{9}\\right)}^{2}} \\\\  & =\\frac{8}{9}\\end{aligned}\n$$\n\n- $\\sqrt{\\dfrac{10}{7}}$ is a surd. Using a calculator, we find that $\\sqrt{\\dfrac{10}{7}} = 1.195\\,228\\,\\ldots$\n\nTherefore, the correct answer is: $\\sqrt{\\dfrac{5}{12}}$ and $\\sqrt{\\dfrac{10}{7}}$ only."} :knowledge-point/id #uuid "7b1e6bea-5399-5dba-b2b1-f59441915324" :knowledge-point/title "Identifying Surds: Square Roots of Fractions"} {:db/id #edb/ref 17592186133725 :knowledge-point/canonical-example {:db/id #edb/ref 17592186133502 :question/id #uuid "9e145904-a9bf-59fc-9070-339b0e133de9" :question/math-academy-id "e-12830" :question/problem "Which of the following numbers are surds?\n\n$$\n\\sqrt[3]{2},\\qquad \\sqrt[3]{\\dfrac{1}{27}},\\qquad \\sqrt[3]{11}\n$$" :question/worked-solution "A surd is a number containing a radical symbol $\\sqrt{\\phantom{0}}$ that cannot be written as a positive or negative whole number or fraction.\n\nSurds can be square roots $\\sqrt{\\phantom{0}}$, cube roots $\\sqrt[3]{\\phantom{0}},$ or higher roots such as $\\sqrt[4]{\\phantom{0}}, \\sqrt[5]{\\phantom{0}},\\ldots,$ etc.\n\nWith that in mind, let's look at each number in turn.\n\n- $\\sqrt[3]{2}$ is a surd. Using a calculator, we find that $\\sqrt[3]{2} = 1.259\\,921\\,\\ldots$\n\n- $\\sqrt[3]{\\dfrac{1}{27}}$ is **NOT** a surd. Since $1$ and $27$ are perfect cubes, we can get rid of the cube root symbol $(\\sqrt[3]{\\phantom{0}})$ and obtain a regular fraction.\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{1}{27}} & =\\sqrt[3]{\\frac{{1}^{3}}{{3}^{3}}} \\\\  & =\\sqrt[3]{\\frac{1\\cdot 1\\cdot 1}{3\\cdot 3\\cdot 3}} \\\\  & =\\sqrt[3]{\\frac{1}{3}\\cdot \\frac{1}{3}\\cdot \\frac{1}{3}} \\\\  & =\\sqrt[3]{{\\left(\\frac{1}{3}\\right)}^{3}} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\n- $\\sqrt[3]{11}$ is a surd. Using a calculator, we find that $\\sqrt[3]{11} = 2.223\\,980\\,\\ldots$\n\nTherefore, the correct answer is: $\\sqrt[3]{2}$ and $\\sqrt[3]{11}$ only."} :knowledge-point/id #uuid "115ee606-48f2-5a63-a5c6-fd8e3e1dbec0" :knowledge-point/title "Identifying Cube Root Surds"}] :topic/math-academy-id 2204 :topic/next [{:db/id #edb/ref 17592186048896} {:db/id #edb/ref 17592186049162} {:db/id #edb/ref 17592186049299} {:db/id #edb/ref 17592186049923} {:db/id #edb/ref 17592186050015} {:db/id #edb/ref 17592186050300} {:db/id #edb/ref 17592186050315}] :topic/title "Surds"}]}
