/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/id #uuid "68c72f0a-65e2-56fe-82e3-72824b7a97b5"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/key "selection"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/type :answer-field.type/radio] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/choices "b8e3ed97-bf7f-5b34-b279-c97fd94002d6"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/choices "2bb5f7ba-f70f-56d8-b156-55d1430c841f"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/choices "26df92e3-988b-5df6-ba53-422e333c817f"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/choices "dcc42b79-e51c-599e-b009-ba59470c42bd"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/choices "4e721f05-03da-5b8a-ad50-2d1b49465988"] [:db/add "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/correct "dcc42b79-e51c-599e-b009-ba59470c42bd"] [:db/ensure "68c72f0a-65e2-56fe-82e3-72824b7a97b5" :answer-field/validate] [:db/add "3cf19cc1-07eb-5993-9bf4-76492a205588" :question/id #uuid "3cf19cc1-07eb-5993-9bf4-76492a205588"] [:db/add "3cf19cc1-07eb-5993-9bf4-76492a205588" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{(-2)x+(-2)y}{4}?$"] [:db/add "3cf19cc1-07eb-5993-9bf4-76492a205588" :question/worked-solution "We have to sketch the slope field at the points $(-2,3)$,$(-1,-1)$,$(-3,-1)$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,3)}=\\frac{(-2)(-2)+(-2)(3)}{4}=- \\frac{1}{2}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-1)}=\\frac{(-2)(-1)+(-2)(-1)}{4}=1, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-3,-1)}=\\frac{(-2)(-3)+(-2)(-1)}{4}=2.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/f5/f51fb78a12bc37626954936b6f001ff807b97c0c55279314ec60f61ecbfde501.png)"] [:db/add "3cf19cc1-07eb-5993-9bf4-76492a205588" :question/difficulty :question.difficulty/easy] [:db/add "3cf19cc1-07eb-5993-9bf4-76492a205588" :question/answer-fields "68c72f0a-65e2-56fe-82e3-72824b7a97b5"] [:db/ensure "3cf19cc1-07eb-5993-9bf4-76492a205588" :question/validate] [:db/add 17592186172038 :knowledge-point/questions "3cf19cc1-07eb-5993-9bf4-76492a205588"] [:db/add "1532a0cc-56c3-55b3-9723-046ecc0679fe" :answer/id #uuid "1532a0cc-56c3-55b3-9723-046ecc0679fe"] [:db/add "1532a0cc-56c3-55b3-9723-046ecc0679fe" :answer/type :answer.type/image] [:db/add "1532a0cc-56c3-55b3-9723-046ecc0679fe" :answer/value "images/dd/dde7cf2388af8e602ca6308eeedd2560dc09e1a6062166ce3cef4f69d62d0643.png"] [:db/ensure "1532a0cc-56c3-55b3-9723-046ecc0679fe" :answer/validate] [:db/add "69b99694-a609-53a7-b152-6496f8a3e0b7" :answer/id #uuid "69b99694-a609-53a7-b152-6496f8a3e0b7"] [:db/add "69b99694-a609-53a7-b152-6496f8a3e0b7" :answer/type :answer.type/image] [:db/add "69b99694-a609-53a7-b152-6496f8a3e0b7" :answer/value "images/0e/0ee119f4b38461acc0fdb9e529e7e7b53f74c7ead8097e82adcf5fabf1247ede.png"] [:db/ensure "69b99694-a609-53a7-b152-6496f8a3e0b7" :answer/validate] [:db/add "52188b34-0248-5085-a960-b7d7eec72d11" :answer/id #uuid "52188b34-0248-5085-a960-b7d7eec72d11"] [:db/add "52188b34-0248-5085-a960-b7d7eec72d11" :answer/type :answer.type/image] [:db/add "52188b34-0248-5085-a960-b7d7eec72d11" :answer/value "images/42/42df4bf8c25e644e5ddfc47623e2e7a391d897ed8ceeb72b429f0b29e5fca2f1.png"] [:db/ensure "52188b34-0248-5085-a960-b7d7eec72d11" :answer/validate] [:db/add "123e4d64-73d1-5418-876b-e5811c5c14d4" :answer/id #uuid "123e4d64-73d1-5418-876b-e5811c5c14d4"] [:db/add "123e4d64-73d1-5418-876b-e5811c5c14d4" :answer/type :answer.type/image] [:db/add "123e4d64-73d1-5418-876b-e5811c5c14d4" :answer/value "images/e1/e1a05ebab1bd4eeba5fc91126badf4600fed0cb7e6fc19b848d91e0