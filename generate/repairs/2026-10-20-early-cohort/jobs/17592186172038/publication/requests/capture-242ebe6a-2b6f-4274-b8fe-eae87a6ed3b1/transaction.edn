a0-b824a54272e1"] [:db/add "bcfa9b0d-38a3-51ff-9ca0-b824a54272e1" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{(-2)x+(2)y}{3}?$"] [:db/add "bcfa9b0d-38a3-51ff-9ca0-b824a54272e1" :question/worked-solution "We have to sketch the slope field at the points $(2,3)$,$(-1,2)$,$(-2,3)$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,3)}=\\frac{(-2)(2)+(2)(3)}{3}=\\frac{2}{3}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,2)}=\\frac{(-2)(-1)+(2)(2)}{3}=2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,3)}=\\frac{(-2)(-2)+(2)(3)}{3}=\\frac{10}{3}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/f3/f3e9db617e68f21ff03b3d5bf57764da9d6a0ddd81f18f718cc2c47b60c35eac.png)"] [:db/add "bcfa9b0d-38a3-51ff-9ca0-b824a54272e1" :question/difficulty :question.difficulty/easy] [:db/add "bcfa9b0d-38a3-51ff-9ca0-b824a54272e1" :question/answer-fields "3a7cf8f3-cfdc-56de-beb7-f60dffef252c"] [:db/ensure "bcfa9b0d-38a3-51ff-9ca0-b824a54272e1" :question/validate] [:db/add 17592186172038 :knowledge-point/questions "bcfa9b0d-38a3-51ff-9ca0-b824a54272e1"] [:db/add "6f0aa562-4688-530b-b347-e9b9102470e6" :answer/id #uuid "6f0aa562-4688-530b-b347-e9b9102470e6"] [:db/add "6f0aa562-4688-530b-b347-e9b9102470e6" :answer/type :answer.type/image] [:db/add "6f0aa562-4688-530b-b347-e9b9102470e6" :answer/value "images/e1/e1be85524cc3bf86663fead888ea9ebdcaa20f428b874158b90f00910457cbd8.png"] [:db/ensure "6f0aa562-4688-530b-b347-e9b9102470e6" :answer/validate] [:db/add "7440c7af-6b05-50b5-9966-ccd777778058" :answer/id #uuid "7440c7af-6b05-50b5-9966-ccd777778058"] [:db/add "7440c7af-6b05-50b5-9966-ccd777778058" :answer/type :answer.type/image] [:db/add "7440c7af-6b05-50b5-996