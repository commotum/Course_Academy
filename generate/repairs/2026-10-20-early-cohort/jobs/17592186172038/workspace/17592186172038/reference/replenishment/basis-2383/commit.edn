2},\\frac{1}{2})$,$(- \\frac{1}{2},\\frac{7}{2})$,$(\\frac{5}{2},\\frac{7}{2})$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{1}{2},\\frac{1}{2})}=\\frac{3}{4}\\frac{(\\frac{1}{2})^{2}}{(- \\frac{1}{2})}=\\frac{3}{4}\\frac{\\frac{1}{4}}{- \\frac{1}{2}}=- \\frac{3}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{1}{2},\\frac{7}{2})}=\\frac{3}{4}\\frac{(\\frac{7}{2})^{2}}{(- \\frac{1}{2})}=\\frac{3}{4}\\frac{\\frac{49}{4}}{- \\frac{1}{2}}=- \\frac{147}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{5}{2},\\frac{7}{2})}=\\frac{3}{4}\\frac{(\\frac{7}{2})^{2}}{(\\frac{5}{2})}=\\frac{3}{4}\\frac{\\frac{49}{4}}{\\frac{5}{2}}=\\frac{147}{40}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/6f/6f51322b58e190508f4b6ead0e7512547b50f7c293497323e21d1780e7a7d116.png)" 13194139535696 17592186045443 true] [17592186526306 1068 #edb/ref 17592186526331 13194139535696 17592186045443 true] [17592186526306 1070 #edb/ref 17592186045486 13194139535696 17592186045443 true] [17592186526306 1071 "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{4}\\frac{y^{2}}{x}?$" 13194139535696 17592186045443 true] [17592186526306 1072 #uuid "176dca9e-c92b-5518-bb45-2af2a9af41ac" 13194139535696 17592186045443 true] [17592186526306 1074 "We have to sketch the slope field at the points $(\\frac{3}{2},\\frac{5}{2})$,$(- \\frac{5}{2},- \\frac{7}{2})$,$(\\frac{7}{2},- \\frac{3}{2})$.\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{3}{2},\\frac{5}{2})}=\\frac{3}{4}\\frac{(\\frac{5}{2})^{2}}{(\\frac{3}{2})}=\\frac{3}{4}\\frac{\\frac{25}{4}}{\\frac{3}{2}}=\\frac{25}{8}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(- \\frac{5}{2},- \\frac{7}{2})}=\\frac{3}{4}\\frac{(- \\frac{7}{2})^{2}}{(- \\frac{5}{2})}=\\frac{3}{4}\\frac{\\frac{49}{4}}{- \\frac{5}{2}}=- \\frac{147}{40}, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(\\frac{7}{2},- \\frac{3}{2})}=\\frac{3}{4}\\frac{(- \\frac{3}{2})^{2}}{(\\frac{7}{2})}=\\frac{3}{4}\\frac{\\frac{9}{4}}{\\frac{7}{2}}=\\frac{27}{56}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](images/9d/9ddc3615a868cd3a04cdf8cbfa2ba3b6bc640cc48708c858442b9dfe3d28a8fc.png)" 13194139535696 17592186045443 true] [17592186526307 1080 "images/91/91dddfed00aa9c1047292407ca068904f9c07f8ec701474260124fd24619a084.png" 13194139535696 17592186045443 true] [17592186526307 1082 #edb/ref 17592186045497 13194139535696 17592186045443 true] [17592186526307 1083 #uuid "19f6c079-3992-57f7-9b4d-e6bdf896381c" 13194139535696 17592186045443 true] [17592186526308 1080 "images/08/0822ae8783ee9c8c8743ecade2d6404c868d32cc60a2f15fb1d7ba102da88523.png" 13194139535696 17592186045443 true] [17592186526308 1082 #edb/ref 17592186045497 13194139535696 17592186045443 true] [17592186526308 1083 #uuid "1e24712f-ed6c-5421-a806-f628b23f4b22" 13194139535696 17592186045443 true] [17592186526309 1080 "images/c2/c285ad3d0e1131020ff3a769c7984a65bf64de4b0902821f1db46c8ffab2d3db.png" 13194139535696 17592186045443 true] [17592186526309 1082 #edb/ref 17592186045497 13194139535696 17592186045443 true] [17592186526309 1083 #uuid "1f81ed22-0259-5ba8-83a9-3990a9bfb9ba" 13194139535696 17592186045443 true] [17592186526310 1080 "images/8a/8a75b01ca6c1c2e1b2bc1662d3c5a4bb27b3786a1fbb45ce3ed5b75753d08786.png" 13194139535696 17592186045443 true] [17592186526310 1082 #edb/ref 17592186045497 13194139535696 17592186045443 true] [17592186526310 1083 #uuid "20490b0a-fd14-554e-ade2-63c10b011887" 13194139535696 17592186045443 true] [17592186526311 1080 "images/f5/f