efef86e1" :question/difficulty :question.difficulty/hard] [:db/add "9f15caae-aa3e-5ba0-a0bf-5830efef86e1" :question/answer-fields "5de3ef7c-3847-55e2-8098-ac96a65492d1"] [:db/ensure "9f15caae-aa3e-5ba0-a0bf-5830efef86e1" :question/validate] [:db/add 17592186059774 :knowledge-point/questions "9f15caae-aa3e-5ba0-a0bf-5830efef86e1"] [:db/add "bc08a434-b53c-5022-9e6a-60180dfc207c" :answer/id #uuid "bc08a434-b53c-5022-9e6a-60180dfc207c"] [:db/add "bc08a434-b53c-5022-9e6a-60180dfc207c" :answer/type :answer.type/math] [:db/add "bc08a434-b53c-5022-9e6a-60180dfc207c" :answer/value "{R}_{1}↔{R}_{3}"] [:db/ensure "bc08a434-b53c-5022-9e6a-60180dfc207c" :answer/validate] [:db/add "0331a0b8-aedf-58a7-92f8-f80f0dcee584" :answer/id #uuid "0331a0b8-aedf-58a7-92f8-f80f0dcee584"] [:db/add "0331a0b8-aedf-58a7-92f8-f80f0dcee584" :answer/type :answer.type/math] [:db/add "0331a0b8-aedf-58a7-92f8-f80f0dcee584" :answer/value "{R}_{1}↔{R}_{2}"] [:db/ensure "0331a0b8-aedf-58a7-92f8-f80f0dcee584" :answer/validate] [:db/add "640ac43d-49ca-51c9-860a-2c5219c9f508" :answer/id #uuid "640ac43d-49ca-51c9-860a-2c5219c9f508"] [:db/add "640ac43d-49ca-51c9-860a-2c5219c9f508" :answer/type :answer.type/math] [:db/add "640ac43d-49ca-51c9-860a-2c5219c9f508" :answer/value "{R}_{1}:={R}_{1}+(-2){R}_{3}"] [:db/ensure "640ac43d-49ca-51c9-860a-2c5219c9f508" :answer/validate] [:db/add "4c7fee6d-0c81-5fbc-9878-246aa321351c" :answer/id #uuid "4c7fee6d-0c81-5fbc-9878-246aa321351c"] [:db/add "4c7fee6d-0c81-5fbc-9878-246aa321351c" :answer/type :answer.type/math] [:db/add "4c7fee6d-0c81-5fbc-9878-246aa321351c" :answer/value "{R}_{1}:=(-2){R}_{1}"] [:db/ensure "4c7fee6d-0c81-5fbc-9878-246aa321351c" :answer/validate] [:db/add "db04a030-39a3-5378-8395-3b4de68be990" :answer/id #uuid "db04a030-39a3-5378-8395-3b4de68be990"] [:db/add "db04a030-39a3-5378-8395-3b4de68be990" :answer/type :answer.type/math] [:db/add "db04a030-39a3-5378-8395-3b4de68be990" :answer/value "{R}_{1}:={R}_{1}+2{R}_{2}"] [:db/ensure "db04a030-39a3-5378-83