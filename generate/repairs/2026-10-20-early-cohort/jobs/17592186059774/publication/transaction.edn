1}:={R}_{1}+(-2){R}_{3}.\n$$"] [:db/add "5b556bc8-7407-5b8d-b4ea-535c77ae36ef" :question/difficulty :question.difficulty/hard] [:db/add "5b556bc8-7407-5b8d-b4ea-535c77ae36ef" :question/answer-fields "58d9a2b1-b8f7-5536-86b0-2cbf14871a24"] [:db/ensure "5b556bc8-7407-5b8d-b4ea-535c77ae36ef" :question/validate] [:db/add 17592186059774 :knowledge-point/questions "5b556bc8-7407-5b8d-b4ea-535c77ae36ef"] [:db/add "generator" :question-generator/id #uuid "e89e6a26-7198-50e7-8623-7c1f2cf664db"] [:db/add "generator" :question-generator/script "generators/3c/3cb151489e3b31b854e1d6787ebada2640702f6d7f8cb3c014dac7b85c18467d/generator.py"] [:db/add 17592186059774 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059774 :knowledge-point/validate]]
