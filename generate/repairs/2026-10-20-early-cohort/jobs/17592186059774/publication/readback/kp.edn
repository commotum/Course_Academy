{1}+(-2){R}_{3}.\n$$\n\nAt the requested entry, this gives\n\n$$\na_{13}=-8+(-2)\\cdot (-4)=0.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}X &=\\begin{bmatrix}-5 & 8 & -8 \\\\ 1 & 9 & 2 \\\\ -7 & 3 & -4\\end{bmatrix}\\qquad {R}_{1}:={R}_{1}+(-2){R}_{3} \\\\ &\\sim \\begin{bmatrix}9 & 2 & 0 \\\\ 1 & 9 & 2 \\\\ -7 & 3 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+(-2){R}_{3}.\n$$"} {:db/id #edb/ref 17592186671648 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f7b670a-27c9-504d-b195-66bc00b2765e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{2}{R}_{2}" :db/id #edb/ref 17592186671632} {:answer/id #uuid "8b8b99c8-7343-57d2-8874-462ed8c59d14" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186671645} {:answer/id #uuid "91cacbba-0a51-539e-a0fc-70bec4e5a7f6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=(-1){R}_{1}" :db/id #edb/ref 17592186671646} {:answer/id #uuid "a4586411-f64a-54e0-ac7e-1db5a89cb3b6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186671651} {:answer/id #uuid "d90aaef2-93bb-5405-89f8-0921e65e2e0d" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+(-2){R}_{2}" :db/id #edb/ref 17592186671655}] :answer-field/correct {:answer/id #uuid "a4586411-f64a-54e0-ac7e-1db5a89cb3b6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+{R}_{2}" :db/id #edb/ref 17592186671651} :answer-field/id #uuid "6089b46a-28c5-5311-87d6-9cdee5844e6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671640}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "95dd800a-583c-55f8-9bdb-46852468696f" :question/problem "Given that\n\n$$\nC=\\begin{bmatrix}9 & 7 & 4 \\\\ -4 & -7 & -5 \\\\ 1 & -5 & 4\\end{bmatrix}\n$$\n\nwhich of the following elementary row operations makes $a_{12}=0$?" :question/worked-solution "Of the given options, we consider the row operation\n\n$$\n{R}_{1}:={R}_{1}+{R}_{2}.\n$$\n\nAt the requested entry, this gives\n\n$$\na_{12}=7+(1)\\cdot (-7)=0.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C &=\\begin{bmatrix}9 & 7 & 4 \\\\ -4 & -7 & -5 \\\\ 1 & -5 & 4\\end{bmatrix}\\qquad {R}_{1}:={R}_{1}+{R}_{2} \\\\ &\\sim \\begin{bmatrix}5 & 0 & -1 \\\\ -4 & -7 & -5 \\\\ 1 & -5 & 4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:={R}_{1}+{R}_{2}.\n$$"} {:db/id #edb/ref 17592186671649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a5d1c2-ac12-5473-9713-c2344a9eb27e" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186671625} {:answer/id #uuid "176f0630-8227-50b5-8d7b-4cbff4cebbd7" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+\\frac{1}{3}{R}_{3}" :db/id #edb/ref 17592186671626} {:answer/id #uuid "4a53d888-aa9d-56e8-b1db-a12aec933d59" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-{R}_{2}" :db/id #edb/ref 17592186671634} {:answer/id #uuid "4caea0c7-220a-5402-a213-302ae04364fc" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186671636} {:answer/id #uuid "616277bc-d846-5a1f-be35-95e931f5b8d9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}+(-2){R}_{3}" :db/id #edb/ref 17592186671641}] :answer-field/correct {:answer/id #uuid "4a53d888-aa9d-56e8-b1db-a12aec933d59" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-{R}_{2}" :db/id #edb/ref 17592186671634} :answer-field/id #uuid "797508c3-ea61-5c45-bf88-e25968afbd18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671644}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "966cbd2b-509b-557c-934a-d13f8e717b40" :question/problem "Given that\n\n$$\nS=\\begin{bmatrix}7 & -4 & -8 \\\\ -3 & -4 & 3 \\\\ -3 & 7 & -9\\end{bmatrix}\n$$\n\nwhich of the following elementary row operations makes $a_{31}=0$?" :question/worked-solution "Of the given options, we consider the row operation\n\n$$\n{R}_{3}:={R}_{3}-{R}_{2}.\n$$\n\nAt the requested entry, this gives\n\n$$\na_{31}=-3+(-1)\\cdot (-3)=0.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}S &=\\begin{bmatrix}7 & -4 & -8 \\\\ -3 & -4 & 3 \\\\ -3 & 7 & -9\\end{bmatrix}\\qquad {R}_{3}:={R}_{3}-{R}_{2} \\\\ &\\sim \\begin{bmatrix}7 & -4 & -8 \\\\ -3 & -4 & 3 \\\\ 0 & 11 & -12\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:={R}_{3}-{R}_{2}.\n$$"} {:db/id #edb/ref 17592186671650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e67747f-d28b-5592-ad31-d9aca6c6185a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186671627} {:answer/id #uuid "277af03b-53d6-5fc8-82f2-b256e2f4d434" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{3}" :db/id #edb/ref 17592186671629} {:answer/id #uuid "302ee7fe-62d9-51d2-8240-0fdd8c7f744c" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{2}" :db/id #edb/ref 17592186671631} {:answer/id #uuid "456e246a-4dc4-534c-b577-5b10d5a73fdc" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{3}{R}_{2}" :db/id #edb/ref 17592186671633} {:answer/id #uuid "63813890-a69b-51d9-8c58-c7e1560fa962" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}-{R}_{3}" :db/id #edb/ref 17592186671642}] :answer-field/correct {:answer/id #uuid "1e67747f-d28b-5592-ad31-d9aca6c6185a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}"