 17592186629460}] :answer-field/correct {:answer/id #uuid "b9161518-9bb8-5c41-850b-c7c0ab66882b" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{3}" :db/id #edb/ref 17592186629451} :answer-field/id #uuid "04e6ac57-0b67-5d12-b1fe-a5f4f9ace543" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186629427}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0efc2e50-f7fe-5d96-9ccf-9a091a1c5eb4" :question/problem "Given that\n\n$$\nD=\\begin{bmatrix}-6 & 5 & 9 \\\\ -3 & -5 & -8 \\\\ 8 & -2 & -4\\end{bmatrix}\n$$\n\nwhich of the following elementary row operations makes $a_{23}=0$?" :question/worked-solution "Of the given options, we consider the row operation\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$\n\nAt the requested entry, this gives\n\n$$\na_{23}=-8+(-2)\\cdot (-4)=0.\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}D &=\\begin{bmatrix}-6 & 5 & 9 \\\\ -3 & -5 & -8 \\\\ 8 & -2 & -4\\end{bmatrix}\\qquad {R}_{2}:={R}_{2}+(-2){R}_{3} \\\\ &\\sim \\begin{bmatrix}-6 & 5 & 9 \\\\ -19 & -1 & 0 \\\\ 8 & -2 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$"} {:db/id #edb/ref 17592186629442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256e62d6-c487-59bb-a67f-ec683b969f10" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186629434} {:answer/id #uuid "6355bcd4-fdf2-5657-b102-1406e4dcde4a" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=(-1){R}_{2}" :db/id #edb/ref 17592186629439} {:answer/id #uuid "7666dd94-5502-5868-a365-0aec8f1b33ec" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{1}" :db/id #edb/ref 17592186629441} {:answer/id #uuid "a8962bc4-2638-50ea-a933-31037ea1fada" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{1}" :db/id #edb/ref 17592186629448} {:answer/id #uuid "ca8d225c-99de-5a1d-848b-16f303fbb667" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1}" :db/id #edb/ref 17592186629453}] :answer-field/correct {:answer/id #uuid "256e62d6-c487-59bb-a67f-ec683b969f10" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186629434} :answer-field/id #uuid "dece754e-ea12-55cd-8ab6-208b0d94a39f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186629457}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7857cadc-8c2c-5686-bf69-70edfa35aa94" :question/problem "Given that\n\n$$\nC=\\begin{bmatrix}3 & -10 & 6 \\\\ -1 & -8 & -4 \\\\ -9 & 0 & 7\\end{bmatrix}\n$$\n\nwhich of the following elementary row operations makes $a_{22}=0$?" :question/worked-solution "Of the given options, we consider the row operation\n\n$$\n{R}_{2}↔{R}_{3}.\n$$\n\nThe entry in row $3$, column $2$ is $0$. Switching rows $2$ and $3$ therefore makes $a_{22}=0$.\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}C &=\\begin{bmatrix}3 & -10 & 6 \\\\ -1 & -8 & -4 \\\\ -9 & 0 & 7\\end{bmatrix}\\qquad {R}_{2}↔{R}_{3} \\\\ &\\sim \\begin{bmatrix}3 & -10 & 6 \\\\ -9 & 0 & 7 \\\\ -1 & -8 & -4\\end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}↔{R}_{3}.\n$$"} {:db/id #edb/ref 17592186629445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e86325d-eefe-5d7c-b0a4-ea0a681ed857" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{3}:=(-2){R}_{3}" :db/id #edb/ref 17592186629429} {:answer/id #uuid "0f5ec7fc-181a-531c-a4ac-ec75b829e7b5" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186629431} {:answer/id #uuid "4e2d7d51-6c92-50db-b467-fbcea026193e" :answer/type {:db/ident :answer.ty