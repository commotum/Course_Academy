end{bmatrix}\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+(-2){R}_{3}.\n$$"} {:db/id #edb/ref 17592186060204 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbacce2f-e401-55d5-b198-479ced06aab8" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=\\frac{1}{3}R_{2}" :db/id #edb/ref 17592186057685} {:answer/id #uuid "ed4da000-e209-5984-82b2-47dcd76ab0db" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=(-1)R_{2}" :db/id #edb/ref 17592186057686} {:answer/id #uuid "fee2cb51-1eff-502c-8aef-dc646f0368ce" :answer/type {:db/ident :answer.type/math} :answer/value "R_{3}↔R_{1}" :db/id #edb/ref 17592186057687} {:answer/id #uuid "19035f05-2f9f-5ad0-9df1-b300d9f2846b" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + R_{1}" :db/id #edb/ref 17592186057688} {:answer/id #uuid "5e83af35-57c0-56fe-9662-1c2a19b19f93" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}:=R_{2} + (-1)R_{1}" :db/id #edb/ref 17592186057689}] :answer-field/id #uuid "f82aec7f-6798-5202-809c-fbb9a0d39797" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057684}] :question/id #uuid "45680acf-db20-5a6f-9386-10731c57b3e2" :question/math-academy-id "q-20392" :question/problem "Given that\n$$\nX = \\begin{bmatrix}1 & -2 & 1 \\\\ -1 & 5 & 4 \\\\ 2 & 8 & 3\\end{bmatrix}\n$$,\nwhich of the following elementary row operations makes $a_{21} = 0$?"} {:db/id #edb/ref 17592186265873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9cbb2b-c328-5b94-8a04-615184baa2e2" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+2{R}_{3}" :db/id #edb/ref 17592186263251} {:answer/id #uuid "47c34f74-3078-5aab-874c-153fd2ea83b0" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{1}:=(-2){R}_{1}" :db/id #edb/ref 17592186263619} {:answer/id #uuid "4ebcdfac-f7e3-56d7-98ca-ee5a39972d58" :answer/type {:d