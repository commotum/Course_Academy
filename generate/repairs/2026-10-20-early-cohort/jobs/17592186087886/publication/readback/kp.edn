d/choices [{:answer/id #uuid "37195fe4-1e69-5e29-9f64-88c2decbd220" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\left(\\frac{1}{v}\\right)\\frac{\\text{d}v}{\\text{d}x}=-\\frac{2}{x}" :db/id #edb/ref 17592186355158} {:answer/id #uuid "d7944865-4cd9-5653-8711-296c10bff723" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sin}⁡v}\\frac{\\text{d}v}{\\text{d}x}=-\\frac{2}{x}" :db/id #edb/ref 17592186356552} {:answer/id #uuid "dbb55cc2-621e-5cbe-9cd9-9ff6c96826e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sin}⁡v}\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186356599} {:answer/id #uuid "dbb8b2a1-b08b-5a4b-bd39-b2a6e5fddc52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{v-2\\operatorname{sin}⁡v}\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186356600} {:answer/id #uuid "e91d297a-9ec5-5912-aa6d-9d3765e8b68f" :answer/type {:db/ident :answer.type/math} :answer/value "(2v-\\operatorname{sin}⁡\\left(\\frac{1}{v}\\right))\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186356704}] :answer-field/correct {:answer/id #uuid "d7944865-4cd9-5653-8711-296c10bff723" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sin}⁡v}\\frac{\\text{d}v}{\\text{d}x}=-\\frac{2}{x}" :db/id #edb/ref 17592186356552} :answer-field/id #uuid "b02fb817-012c-5fd8-afd9-ec9e45613dab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357240}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "647415db-3b65-5b2e-8b3d-f70381af49e3" :question/math-academy-id "q-90601" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{x}-2\\operatorname{sin}⁡\\left(\\frac{y}{x}\\right).\n$$\n\nIf the transformation $y=v(x)x$ is applied to the differential equation, what is the resulting equation?" :question/worked-solution "Using the transformation $y=vx$ (where $v=v(x)$), we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the given differential equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{y}{x}-2\\operatorname{sin}⁡\\left(\\frac{y}{x}\\right) \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{vx}{x}-2\\operatorname{sin}⁡\\left(\\frac{vx}{x}\\right) \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =v-2\\operatorname{sin}⁡v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =-2\\operatorname{sin}⁡v \\\\ \\frac{1}{\\operatorname{sin}⁡v}\\frac{\\text{d}v}{\\text{d}x} & =-\\frac{2}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186650988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60e62c85-c566-5596-aeac-6a35161edf2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{v}{{v}^{2}+3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186650593} {:answer/id #uuid "7027b7c0-7c21-5d8c-9fe2-36b2b2a2c598" :answer/type {:db/ident :answer.type/math} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{x}" :db/id #edb/ref 17592186650618} {:answer/id #uuid "a034791d-9f5d-5ee2-9fc6-27b076b86a88" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{v}{v+1}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{x}" :db/id #edb/ref 17592186650697} {:answer/id #uuid "e0c23df8-2c98-54d9-bc30-2be4b43ef609" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{v+1}{3{v}^{2}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186650797} {:answer/id #uuid "e9aba5bb-d415-5654-ae17-def064e5f000" :answer/type {:db/ident :answer.type/math} :answer/value "3v\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{2}}" :db/id #edb/ref 17592186650810}] :answer-field/correct {:answer/id #uuid "7027b7c0-7c21-5d8c-9fe2-36b2b2a2c598" :answer/type {:db/ident :answer.type/math} :answer/value "v\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{x}" :db/id #edb/ref 17592186650618} :answer-field/id #uuid "e1bf3348-64f3-5a21-8d0a-ec72df9b6d5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186650914}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e1385b74-52ff-53cd-91df-70b0f0ad6473" :question/math-academy-id "q-90600" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}+3{x}^{2}}{xy}.\n$$\n\nIf the transformation $y=v(x)x$ is applied to the differential equation, what is the resulting equation?" :question/worked-solution "Using the transformation $y=vx$ (where $v=v(x)$), we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the given differential equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{2}+3{x}^{2}}{xy} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{(vx)^{2}+3{x}^{2}}{x(vx)} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{x}^{2}({v}^{2}+3)}{{x}^{2}v} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{\\cancel{{x}^{2}}({v}^{2}+3)}{\\cancel{{x}^{2}}v} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{v}^{2}+3}{v} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =v+\\frac{3}{v} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{3}{v} \\\\ v\\frac{\\text{d}v}{\\text{d}x} & =\\frac{3}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186673462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b7ed29-4110-5439-9fea-1fe2b4583f85" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{v + 4 \\sin{\\left(v \\right)}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #e