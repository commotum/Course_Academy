ac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the given differential equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =- 4 \\sin{\\left(\\frac{y}{x} \\right)} + \\frac{3 y}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =3 v - 4 \\sin{\\left(v \\right)} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =3 v - 4 \\sin{\\left(v \\right)} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =2 v - 4 \\sin{\\left(v \\right)} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =2 v - 4 \\sin{\\left(v \\right)} \\\\ \\left(\\frac{1}{2 v - 4 \\sin{\\left(v \\right)}}\\right)\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186673463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61513150-7cee-53e3-a880-9c941cc085cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{v^{2} + 1}{v^{2} - v + 3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673466} {:answer/id #uuid "8c2d19bf-82f4-529a-bb11-0355361a26e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{v^{2} + 1}{v^{3} + v^{2} + 3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673470} {:answer/id #uuid "8e1dc5ba-fca7-57d0-bf9f-ccc6a737a032" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{- v^{2} - 1}{3 v^{3} - v^{2} + 4 v - 3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673471} {:answer/id #uuid "9ea65024-06bf-5c9e-90f7-b27f6baf4a3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{- v^{2} - 1}{v^{3} - v^{2} + 2 v - 3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673477} {:answer/id #uuid "caf06db2-5371-5393-9a4a-7a1c5fcd5938" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{- v^{2} - 1}{2 v^{3} - v^{2} + 3 v - 3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673483}] :answer-field/correct {:answer/id #uuid "9ea65024-06bf-5c9e-90f7-b27f6baf4a3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{- v^{2} - 1}{v^{3} - v^{2} + 2 v - 3}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673477} :answer-field/id #uuid "dd2d9f09-fd5b-5b85-ae01-0b084a69cbaf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673486}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "467974b8-3dec-53ec-b6d7-428e15add07c" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3 x^{2} - x y + y^{2}}{x^{2} + y^{2}}.\n$$\n\nIf the transformation $y=v(x)x$ is applied to the differential equation, what is the resulting equation?" :question/worked-solution "Using the transformation $y=vx$ (where $v=v(x)$), we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the given differential equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{3 x^{2} - x y + y^{2}}{x^{2} + y^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{v^{2} x^{2} - v x^{2} + 3 x^{2}}{v^{2} x^{2} + x^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{v^{2} - v + 3}{v^{2} + 1} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =- v + \\frac{v^{2} - v + 3}{v^{2} + 1} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{- v^{3} + v^{2} - 2 v + 3}{v^{2} + 1} \\\\ \\left(\\frac{- v^{2} - 1}{v^{3} - v^{2} + 2 v - 3}\\right)\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186673469 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9835353f-47a9-50dd-bea7-c7e5c1fd97bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{v + e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673475} {:answer/id #uuid "ad34913f-f4d8-5ec1-803c-4a152c51395b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673479} {:answer/id #uuid "b9b73026-e5d3-5ecd-a3fc-9e97e058f89d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(e^{- \\sin{\\left(4 v \\right)}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673481} {:answer/id #uuid "d187a694-b484-5f75-b414-beb952203ef1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{3 v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673485} {:answer/id #uuid "f7d6d6dc-76da-566d-a8ea-649b26e0f1d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{2 v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673487}] :answer-field/correct {:answer/id #uuid "d187a694-b484-5f75-b414-beb952203ef1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{3 v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673485} :answer-field/id #uuid "b80ca885-09c2-5723-879f-aa276818f477" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673480}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7ccdf364-5a39-524d-81ba-a51238dcb753" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=e^{\\sin{\\left(\\frac{4 y}{x} \\right)}} - \\frac{2 y}{x}.\n$$\n\nIf the transformation $y=v(x)x$ is applied to the differential equation, what is the resulting equation?" :question/worked-solution "Using the transformation $y=vx$ (where $v=v(x)$), we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the given differential equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =e^{\\sin{\\left(\\frac{4 y}{x} \\right)}} - \\frac{2 y}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =- 2 v + e^{\\sin{\\left(4 v \\right)}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =- 2 v + e^{\\sin{\\left(4 v \\right)}} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =- 3 v + e^{\\sin{\\left(4 v \\right)}} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =- 3 v + e^{\\sin{\\left(4 v \\right)}} \\\\ \\left(- \\frac{1}{3 v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186673472 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0971104e-1df2-59ea-b87d-7cd78122cf76" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{v + e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673454} {:answer/id #uuid "3e5f0442-4438-535f-886a-9d1680990fc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{3 v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673459} {:answer/id #uuid "3fb4cb01-32b9-5648-a9c2-4708e176d91c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(e^{- \\sin{\\left(4 v \\right)}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673461} {:answer/id #uuid "4f98df25-e0ca-5a59-84b5-5838c1c63dd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(- \\frac{1}{v - e^{\\sin{\\left(4 v \\right)}}}\\right)\\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{x}" :db/id #edb/ref 17592186673465} {:answer/id #uuid "c7d73034-6