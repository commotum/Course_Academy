              ":answer/type": ":answer.type/math",
              ":answer/value": "A=\\begin{bmatrix}3 & 0 \\\\ 0 & -4\\end{bmatrix}"
            },
            {
              ":answer/id": "a6f69afb-e155-53f8-b6a4-00747ccd0ba7",
