              ":answer/value": "B=\\begin{bmatrix}1 & 0 & 0 \\\\ 5 & 2 & 0 \\\\ -2 & 0 & 9\\end{bmatrix}"
            },
            {
              ":answer/id": "6810f4e7-e9a2-5ed2-b79c-bb4a382c5d7e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "E=\\begin{bmatrix}7 & -11 \\\\ 5 & 9\\end{bmatrix}"
