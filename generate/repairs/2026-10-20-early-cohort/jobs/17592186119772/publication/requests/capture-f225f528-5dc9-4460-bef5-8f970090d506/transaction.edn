2-b94a-57b2-97a6-d3c1ccd59ed1" :question/answer-fields "9aadb963-ce05-5ab6-b4ff-034251c189f7"] [:db/ensure "f6da1c92-b94a-57b2-97a6-d3c1ccd59ed1" :question/validate] [:db/add 17592186119772 :knowledge-point/questions "f6da1c92-b94a-57b2-97a6-d3c1ccd59ed1"] [:db/add "e835a288-1792-5930-8436-de1365d432dc" :answer/id #uuid "e835a288-1792-5930-8436-de1365d432dc"] [:db/add "e835a288-1792-5930-8436-de1365d432dc" :answer/type :answer.type/math] [:db/add "e835a288-1792-5930-8436-de1365d432dc" :answer/value "C=\\begin{bmatrix}-2 & 0 & 2 \\\\ 0 & 0 & 10 \\\\ 0 & -4 & 8\\end{bmatrix}"] [:db/ensure "e835a288-1792-5930-8436-de1365d432dc" :answer/validate] [:db/add "f2135390-4d61-534d-9454-2480cae73b40" :answer/id #uuid "f2135390-4d61-534d-9454-2480cae73b40"] [:db/add "f2135390-4d61-534d-9454-2480cae73b40" :answer/type :answer.type/math] [:db/add "f2135390-4d61-534d-9454-2480cae73b40" :answer/value "B=\\begin{bmatrix}1 & 0 & 0 \\\\ 5 & 2 & 0 \\\\ -2 & 0 & 9\\end{bmatrix}"] [:db/ensure "f2135390-4d61-534d-9454-2480cae73b40" :answer/validate] [:db/add "0ea2d0b9-b13f-520b-8eaf-d72dd4d3ae8f" :answer/id #uuid "0ea2d0b9-b13f-520b-8eaf-d72dd4d3ae8f"] [:db/add "0ea2d0b9-b13f-520b-8eaf-d72dd4d3ae8f" :answer/type :answer.type/math] [:db/add "0ea2d0b9-b13f-520b-8eaf-d72dd4d3ae8f" :answer/value "E=\\begin{bmatrix}7 & -11 \\\\ 5 & 9\\end{bmatrix}"] [:db/ensure "0ea2d0b9-b13f-520b-8eaf-d72dd4d3ae8f" :answer/validate] [:db/add "2ed58cc2-3767-5524-ae7a-394cc94ae0aa" :answer/id #uuid "2ed58cc2-3767-5524-ae7a-394cc94ae0aa"] [:db/add "2ed58cc2-3767-5524-ae7a-394cc94ae0aa" :answer/type :answer.type/math] [:db/add "2ed58cc2-3767-5524-ae7a-394cc94ae0aa" :answer/value "D=\\begin{bmatrix}-1 & -11 \\\\ -8 & 8\\end{bmatrix}"] [:db/ensure "2ed58cc2-3767-5524-ae7a-394cc94ae0aa" :answer/validate] [:db/add "6df1ce27-8e16-5f6e-bfc7-eb38c6e70edc" :answer/id #uuid "6df1ce27-8e16-5f6e-bfc7-eb38c6e70edc"] [:db/add "6df1ce27-8e16-5f6e-bfc7-eb38c6e70edc" :answer/type :answer.type/math] [:db/add "6df1ce27-8e16-5f6e-b