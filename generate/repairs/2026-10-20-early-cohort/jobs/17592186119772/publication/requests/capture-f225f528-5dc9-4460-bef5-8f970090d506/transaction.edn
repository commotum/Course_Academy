begin{bmatrix}-1 & -11 \\\\ -8 & 8\\end{bmatrix}\n$$\n\n$$\nE=\\begin{bmatrix}7 & -11 \\\\ 5 & 9\\end{bmatrix}\n$$\n\nSo, they are not lower triangular matrices."] [:db/add "2796bb49-1753-5471-934b-32aac10e51c9" :question/difficulty :question.difficulty/easy] [:db/add "2796bb49-1753-5471-934b-32aac10e51c9" :question/answer-fields "4afa49a2-ba2a-5f52-8d73-4806b474d901"] [:db/ensure "2796bb49-1753-5471-934b-32aac10e51c9" :question/validate] [:db/add 17592186119772 :knowledge-point/questions "2796bb49-1753-5471-934b-32aac10e51c9"] [:db/add "33c6f380-f960-52cb-b2ad-6ce4d77fed19" :answer/id #uuid "33c6f380-f960-52cb-b2ad-6ce4d77fed19"] [:db/add "33c6f380-f960-52cb-b2ad-6ce4d77fed19" :answer/type :answer.type/math] [:db/add "33c6f380-f960-52cb-b2ad-6ce4d77fed19" :answer/value "A=\\begin{bmatrix}5 & -7 & 0 \\\\ 0 & -5 & 0 \\\\ 8 & 0 & 9\\end{bmatrix}"] [:db/ensure "33c6f380-f960-52cb-b2ad-6ce4d77fed19" :answer/validate] [:db/add "10846f3f-a743-535d-9cf7-a009fd88137b" :answer/id #uuid "10846f3f-a743-535d-9cf7-a009fd88137b"] [:db/add "10846f3f-a743-535d-9cf7-a009fd88137b" :answer/type :answer.type/math] [:db/add "10846f3f-a743-535d-9cf7-a009fd88137b" :answer/value "B=\\begin{bmatrix}10 & -11 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & -3 & -1\\end{bmatrix}"] [:db/ensure "10846f3f-a743-535d-9cf7-a009fd88137b" :answer/validate] [:db/add "bd25f5fc-6e2f-54a7-bd63-93716131a7b5" :answer/id #uuid "bd25f5fc-6e2f-54a7-bd63-93716131a7b5"] [:db/add "bd25f5fc-6e2f-54a7-bd63-93716131a7b5" :answer/type :answer.type/math] [:db/add "bd25f5fc-6e2f-54a7-bd63-93716131a7b5" :answer/value "C=\\begin{bmatrix}8 & 0 & 5 \\\\ -11 & 9 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}"] [:db/ensure "bd25f5fc-6e2f-54a7-bd63-93716131a7b5" :answer/validate] [:db/add "e9ecc8fd-cb5a-5d10-ac0f-f39443214236" :answer/id #uuid "e9ecc8fd-cb5a-5d10-ac0f-f39443214236"] [:db/add "e9ecc8fd-cb5a-5d10-ac0f-f39443214236" :answer/type :answer.type/math] [:db/add "e9ecc8fd-cb5a-5d10-ac0f-f39443214236" :answer/value "D=\\begin{bmatrix}10 & 0 \\\\ 0 & -