                ":answer/value": "E=\\begin{bmatrix}9 & 11 \\\\ 0 & 8\\end{bmatrix}"
              },
              {
                ":answer/id": "2d6eccb3-6690-5642-b32c-7c39168cc0ab",
                ":answer/type": ":answer.type/math",
