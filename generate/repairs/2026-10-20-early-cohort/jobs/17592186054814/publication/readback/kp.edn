eld.type/checkbox} :db/id #edb/ref 17592186460707} {:answer-field/choices [{:answer/id #uuid "8e64b691-f599-5ad1-8f86-36f0d56190ca" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459683} {:answer/id #uuid "f97968ed-96ae-5c5b-81f3-7c37c47bc453" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459684}] :answer-field/correct {:answer/id #uuid "8e64b691-f599-5ad1-8f86-36f0d56190ca" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459683} :answer-field/id #uuid "def1656c-545d-5cfa-a67e-9b8e056e29f2" :answer-field/key "Real numbers ($R$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460708} {:answer-field/choices [{:answer/id #uuid "2722381f-88ef-56ef-a90e-bfc76e1d1ba4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459685} {:answer/id #uuid "07815c18-f8cd-571f-9d19-35dea685dd79" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459686}] :answer-field/correct {:answer/id #uuid "2722381f-88ef-56ef-a90e-bfc76e1d1ba4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459685} :answer-field/id #uuid "8af4482e-9012-5e8b-8245-fe732b4fca3e" :answer-field/key "Integers ($Z$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460709}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d88d3c9d-ec93-5bf2-a49b-0b326607c0ea" :question/math-academy-id "q-181441" :question/problem "To which of the following sets does the number $\\sqrt{-1}$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-1}=\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-1}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-1}$ is nonzero, it does not belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-1}\\notin N,\\,\\sqrt{-1}\\notin Z,\\,\\sqrt{-1}\\notin Q,\\,\\sqrt{-1}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\""} {:db/id #edb/ref 17592186055498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8033c9e3-c167-5119-a217-ce9eec57c783" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460245} {:answer/id #uuid "f0870cf1-e547-5b1d-817f-0b15545b8bcc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460246}] :answer-field/correct {:answer/id #uuid "f0870cf1-e547-5b1d-817f-0b15545b8bcc" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460246} :answer-field/id #uuid "91596938-2de0-53f3-b399-4d048fffca5c" :answer-field/key "Complex numbers ($C$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460989} {:answer-field/choices [{:answer/id #uuid "6bcfc6c9-1d2c-5958-b70b-a2b0f362879d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460247} {:answer/id #uuid "75ea4269-161a-59d3-bde9-3ebf268c93bf" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460248}] :answer-field/correct {:answer/id #uuid "6bcfc6c9-1d2c-5958-b70b-a2b0f362879d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460247} :answer-field/id #uuid "45d4a4b3-a093-570b-99fe-21035c9fee69" :answer-field/key "Natural numbers ($N$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460990} {:answ