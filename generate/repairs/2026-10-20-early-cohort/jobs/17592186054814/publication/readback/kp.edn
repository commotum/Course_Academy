r.type/text} :answer/value "false" :db/id #edb/ref 17592186622939} {:answer/id #uuid "c8440ce2-7fb6-500e-a3b1-1ff1f352ba96" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622995}] :answer-field/correct {:answer/id #uuid "c8440ce2-7fb6-500e-a3b1-1ff1f352ba96" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622995} :answer-field/id #uuid "f076b3ff-72d5-584e-8462-cce0f8985df7" :answer-field/key "Real numbers ($R$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623008}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c11859c0-209d-51d0-8520-9580e3214e65" :question/problem "To which of the following sets does the number $\\pi$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**.\n\nWith that in mind, we note the following:\n\n- The number $\\pi$ is not an integer, so it does *not* belong to $Z$ nor to $N.$ We can write\n\n$$\n\\pi\\notin N\\qquad \\pi\\notin Z\n$$\n\n- Also, $\\pi$ is a known irrational number. It cannot be written as the ratio of two integers, so it does *not* belong to $Q$ either:\n\n$$\n\\pi\\notin Q\n$$\n\n- Every irrational number is both a real number and a complex number. Consequently, $\\pi$ belongs to both $R$ and $C,$ and we can write\n\n$$\n\\pi\\in R\\qquad \\pi\\in C\n$$\n\nTherefore, the correct answer is $R, C$ only."} {:db/id #edb/ref 17592186622994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "918b749d-210f-57b6-9c31-7d547bb1015b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622979} {:answer/id #uuid "ca7c3401-3f0d-5266-b9a5-40ed1e0cd1cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186622996}] :answer-field/correct {:answer/id #uuid "ca7c3401-3f0d-5266-b9a5-40ed1e0cd1cd" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186622996} :answer-field/id #uuid "1da334f4-0b07-5df7-9410-6d6b92064431" :answer-field/key "Natural numbers ($N$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186622940} {:answer-field/choices [{:answer/id #uuid "566bd1d5-64f1-5241-8261-fd146fc509b7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622961} {:answer/id #uuid "d78e309f-2134-5c75-b60a-412bde9e8611" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186622999}] :answer-field/correct {:answer/id #uuid "566bd1d5-64f1-5241-8261-fd146fc509b7" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622961} :answer-field/id #uuid "880c11f1-8a54-569d-9e4b-d1a17e924a3f" :answer-field/key "Integers ($Z$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186622973} {:answer-field/choices [{:answer/id #uuid "13ba1192-be5b-5105-b8c1-19727623d033" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186622935} {:answer/id #uuid "ebb9115c-218a-5f3a-a4dd-72d2ed26b6d4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623005}] :answer-field/correct {:answer/id #uuid "ebb9115c-218a-5f3a-a4dd-72d2ed26b6d4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623005} :answer-field/id #uuid "b2293fba-68b3-5ed9-8ddb-c9c374bf94d9" :answer-field/key "Real numbers ($R$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186622988} {:answer-field/choices [{:answer/id #uuid "4a1c3792-ce69-524a-ac55-45d4bc177b5f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186622955} {:answer/id #uuid "d2d99e3c-57f7-5b71-9017-da2fe88cb3ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622997}] :answer-field/correct {:answer/id #uuid "d2d99e3c-57f7-5b71-9017-da2fe88cb3ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186622997} :answer-field/id #uuid "bbbc37e8-2ac6-5072-aad4-985814059eae" :answer-field/key "Complex numbers ($C$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186622990} {:answer-field/choices [{:answer/id #uuid "d906d288-85ef-5e53-a2c9-a95987bc681f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623000} {:answer/id #uuid "f25d2b53-1372-5c67-b4da-1da8a5b18ec8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186623009}] :answer-field/correct {:answer/id #uuid "d906d288-85ef-5e53-a2c9-a95987bc681f" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186623000} :answer-field/id #uuid "da27c7cd-4c4d-52ac-91fe-4d9f55410cb1" :answer-field/key "Rational numbers ($Q$)" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186623001}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7b47ebe-cbbc-5725-9d9e-438ad6bb93cf" :question/problem "To which of the following sets does the number $-12.00$ belong?\n\nSelect all that apply." :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**.\n\nWith that in mind, we note the following:\n\n- The number $-12.00=-12$ is negative, so it does *not* belong to $N,$ and we can write\n\n$$\n-12.00\\notin N\n$$\n\n- However, $-12$ is an integer, so it does belong to $Z,$ and we can write\n\n$$\n-12.00\\in Z\n$$\n\n- Every integer is a rational, real, and complex number. Consequently, $-12.00$ belongs to $Q,R,$ and $C,$ and we can write\n\n$$\n\\begin{gathered}-12.00\\in Q\\qquad -12.00\\in R \\\\ -12.00\\in C\\end{gathered}\n$$\n\nTherefore, the correct answer is $Z, Q, R, C$ only."} {:db/id #edb/ref 17592186637261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bde64d4-f779-5f48-a53b-4453079ed281" :answer/type {:db/ident :answer.type/text} :answer/value "$Z$ only" :db/id #edb/ref 17592186636697} {:answer/id #uuid "5fe3f948-25ac-5e44-9f8b-2076b3001d3b" :answer/type {:db/ident :answer.type/text} :answer/value "$Z,Q,R,$ and $C$ only" :db/id #edb/ref 17592186636836} {:answer/id #uuid "845bcaa2-2ef9-5e63-8044-3f42da7609a3" :answer/type {:db/ident :answer.type/text} :answer/value "$Z$ and $Q$ only" :db/id #edb/ref 17592186636893} {:answer/id #uuid "8526ff7b-1c3c-5fd3-bf4a-ff88ae66ef6c" :answer/type {:db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186636895} {:answer/id #uuid "b9195393-2272-5d39-8160-a62db98a7add" :answer/type {:db/ident :answer.type/text} :answer/value "$N,Z,Q,R,$ and $C$" :db/id #edb/ref 17592186636991}] :answer-field/correct {:answer/id #uuid "5fe3f948-25ac-5e44-9f8b-2076b3001d3b" :answer/type {:db/ident :answer.type/text} :answer/value "$Z,Q,R,$ and $C$ only" :db/id #edb/ref 17592186636836} :answer-field/id #uuid "21ac85ae-3f3f-5553-ba8b-984f16493575" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637127}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "48a2ffd6-1280-5b24-8f5a-4c13ac5f0fae" :question/math-academy-id "q-104562" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $-18$ belong?" :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- The number $-18$ is negative, so it does *not* belong to $N,$ and we can write\n\n$$\n-18\\notin N.\n$$\n\n- However, $-18$ is an integer, so it does belong to $Z,$ and we can write\n\n$$\n-18\\in Z.\n$$\n\n- Every integer is a rational, real, and complex number. Consequently, $-18$ belongs to $Q,R,$ and $C,$ and we can write\n\n$$\n-18\\in Q,\\,-18\\in R,\\,-18\\in C.\n$$\n\nTherefore, the correct answer is \"$Z,Q,R,$ and $C$ only.\""} {:db/id #edb/ref 17592186637267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed47beb-171d-5ca8-973c-32efe888bdfa" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186636701} {:answer/id #uuid "2a5aa38f-2d9b-508c-a8e1-afad4e378e52" :answer/type {:db/ident :answer.type/text} :answer/value "$N$ and $Z$ only" :db/id #edb/ref 17592186636746} {:answer/id #uuid "5f45207b-83f0-5033-88be-34e12aa5d1e5" :answer/type {:db/ident :answer.type/text} :answer/value "$N,Z,Q,R,$ and $C$" :db/id #edb/ref 17592186636834} {:answer/id #uuid "cea81ea7-eab2-595b-bd2a-e0c1f1a88c62" :answer/type {:db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186637030} {:answer/id #uuid "fc89ca81-90b5-59c9-8155-89719208aa21" :answer/type {:db/ident :answer.type/text} :answer/value "$Q,R,$ and $C$ only" :db/id #edb/ref 17592186637113}] :answer-field/correct {:answer/id #uuid "0ed47beb-171d-5ca8-973c-32efe888bdfa" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186636701} :answer-field/id #uuid "f4603dd7-a9e6-5ac2-93e1-ca9584575ee4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637221}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5356b463-f0e3-5b2b-9ffc-35df47ad119b" :question/math-academy-id "q-181527" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\sqrt{-2}$ belong?" :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-2}=\\sqrt{2}\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-2}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-2}$ is nonzero, it does *not* belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-2}\\notin N,\\,\\sqrt{-2}\\notin Z,\\,\\sqrt{-2}\\notin Q,\\,\\sqrt{-2}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\""} {:db/id #edb/ref 17592186673676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0512ad6c-caa6-56c7-8b05-a754ce853945" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673667} {:answer/id #uuid "0839d601-73c7-5e64-8fd9-c7aa9f987b3a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186673668}] :answer-field/correct {:answer/id #uuid "0512ad6c-caa6-56c7-8b05-a754ce853945" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186673667} :answer-field/id #uuid "36b38c97-6274-57a7-8864-4b64c37ca47b" :answer-field/key "Natural numbers ($N$)" :