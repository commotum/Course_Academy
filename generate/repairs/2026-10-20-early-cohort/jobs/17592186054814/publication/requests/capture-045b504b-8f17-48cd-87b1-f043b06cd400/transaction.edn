b75f2b4d-f6ac-52ca-b287-2a40de836000" :answer/validate] [:db/add "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/id #uuid "4962bc3a-6f6e-5c80-8805-f93da809bfb6"] [:db/add "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/key "Integers ($Z$)"] [:db/add "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/type :answer-field.type/checkbox] [:db/add "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/choices "5ff8d076-7e4d-56d8-8916-6e951db778ca"] [:db/add "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/choices "b75f2b4d-f6ac-52ca-b287-2a40de836000"] [:db/add "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/correct "5ff8d076-7e4d-56d8-8916-6e951db778ca"] [:db/ensure "4962bc3a-6f6e-5c80-8805-f93da809bfb6" :answer-field/validate] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/id #uuid "8f541e25-e4dd-5415-ad10-5dcd34f06844"] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/problem "To which of the following sets does the number $\\sqrt{-83}$ belong?\n\nSelect all that apply."] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**.\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-83}=\\sqrt{83}\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-83}\\in C\n$$\n\n- Since the imaginary part of $\\sqrt{-83}$ is nonzero, it does *not* belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\begin{gathered}\\sqrt{-83}\\notin N\\qquad \\sqrt{-83}\\notin Z \\\\ \\sqrt{-83}\\notin Q\\qquad \\sqrt{-83}\\notin R\\end{gathered}\n$$\n\nTherefore, the correct answer is $C$ only."] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/difficulty :question.difficulty/easy] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/answer-fields "368c57fd-a92c-5555-8ca7-bbde855ddb54"] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/answer-fields "ff0e4910-6fca-53d3-b2ea-c127920973d4"] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/answer-fields "4a66ff1e-9bf7-58ec-8baf-39cf7f391d1a"] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/answer-fields "5e92461d-828b-5108-b79e-19dd902819c7"] [:db/add "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/answer-fields "4962bc3a-6f6e-5c80-8805-f93da809bfb6"] [:db/ensure "8f541e25-e4dd-5415-ad10-5dcd34f06844" :question/validate] [:db/add 17592186054814 :knowledge-point/questions "8f541e25-e4dd-5415-ad10-5dcd34f06844"] [:db/add "5caf4d8c-96aa-5341-8538-089a394325cf" :answer/id #uuid "5caf4d8c-96aa-5341-8538-089a394325cf"] [:db/add "5caf4d8c-96aa-5341-8538-089a394325cf" :answer/type :answer.type/text] [:db/add "5caf4d8c-96aa-5341-8538-089a394325cf" :answer/value "false"] [:db/ensure "5caf4d8c-96aa-5341-8538-089a394325cf" :answer/validate] [:db/add "08f0c0dc-be78-59c2-9e1b-c01dc8cdb068" :answer/id #uuid "08f0c0dc-be78-59c2-9e1b-c01dc8cdb068"] [:db/add "08f0c0dc-be78-59c2-9e1b-c01dc8cdb068" :answer/type :answer.type/text] [:db/add "08f0c0dc-be78-59c2-9e1b-c01dc8cdb068" :answer/value "true"] [:db/ensure "08f0c0dc-be78-59c2-9e1b-c01dc8cdb068" :answer/validate] [:db/add "60608016-edaa-58ad-9f98-22cf0c3bf796" :answer-field/id #uuid "60608016-edaa-58ad-9f98-22cf0c3bf796"] [:db/add "60608016-edaa-58ad-9f98-22cf0c3bf796" :answer-field/key "Natural numbers ($N$)"] [:db/add "60608016-edaa-58ad-9f98-22cf0c3bf796" :answer-field/type :answer-field.type/checkbox] [:db/add "60608016-edaa-58ad-9f98-22cf0c3bf796" :answer-field/choices "5caf4d8c-96aa-5341-8538-089a394325cf"] [:db/add "60608016-edaa-58ad-9f98-22cf0c3bf796" :answer-field/choices "08f0c0dc-be78-59c2-9e1b-c01dc8cdb068"] [:db/add "60608016-edaa-58ad-9f98-22cf0c3bf796" :answer-field/correct "0