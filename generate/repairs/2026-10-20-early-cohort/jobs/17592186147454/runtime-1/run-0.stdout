              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\frac{2}{2 \\cdot C \\cdot e^{\\left(x+5\\right)^{2}} + 1}"
            },
            {
              ":answer/id": "528f79e1-af98-5c09-a6c8-390402d39513",
              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\frac{2}{2 \\cdot C \\cdot e^{\\left(x+5\\right)^{2}} - 1}"
            },
            {
              ":answer/id": "c6b21588-d4a0-5ace-ba25-438947875824",
              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\frac{1}{C \\cdot e^{\\frac{3 \\cdot \\left(x+5\\right)^{2}}{2}} + 1}"
            },
            {
              ":answer/id": "62abb92d-b6ff-544f-8f8b-6b5c5bd365ea",
