              ":answer/id": "dbf1c30e-dbf9-5a00-b1cb-abc2c2a80fbc",
              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\sqrt[3]{\\frac{C-{e}^{3{(x-1)}^{2}}}{(x-1)}}"
            },
            {
              ":answer/id": "2a8d6996-aabe-50f9-a3c1-4ed9245ef8a1",
              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\sqrt[5]{\\frac{C{e}^{5{(x-1)}^{3}}-1}{3}}"
            },
            {
              ":answer/id": "7c6a600c-bc63-555e-b37d-4604d931247a",
              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\sqrt[5]{\\frac{C{e}^{(x-1)}-1}{3}}"
