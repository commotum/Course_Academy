db/add "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/id #uuid "a1c24042-b870-5f0a-80ac-f4818e90caf5"] [:db/add "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/key "$\\text{Col}(A)$ is a $5$-dimensional subspace of ${R}^{5}.$"] [:db/add "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/type :answer-field.type/checkbox] [:db/add "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/choices "d0b668ec-e524-508e-93cd-8eb84b3df602"] [:db/add "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/choices "08e87190-2841-5611-9c70-dc6033a40400"] [:db/add "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/correct "08e87190-2841-5611-9c70-dc6033a40400"] [:db/ensure "a1c24042-b870-5f0a-80ac-f4818e90caf5" :answer-field/validate] [:db/add "d7e4d0f2-e20d-593d-8147-2516d450feb0" :answer/id #uuid "d7e4d0f2-e20d-593d-8147-2516d450feb0"] [:db/add "d7e4d0f2-e20d-593d-8147-2516d450feb0" :answer/type :answer.type/text] [:db/add "d7e4d0f2-e20d-593d-8147-2516d450feb0" :answer/value "false"] [:db/ensure "d7e4d0f2-e20d-593d-8147-2516d450feb0" :answer/validate] [:db/add "3d4fbbca-395d-5779-ad55-5f2dfe894b9b" :answer/id #uuid "3d4fbbca-395d-5779-ad55-5f2dfe894b9b"] [:db/add "3d4fbbca-395d-5779-ad55-5f2dfe894b9b" :answer/type :answer.type/text] [:db/add "3d4fbbca-395d-5779-ad55-5f2dfe894b9b" :answer/value "true"] [:db/ensure "3d4fbbca-395d-5779-ad55-5f2dfe894b9b" :answer/validate] [:db/add "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/id #uuid "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d"] [:db/add "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/key "$\\text{nullity}(A)=5$"] [:db/add "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/type :answer-field.type/checkbox] [:db/add "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/choices "d7e4d0f2-e20d-593d-8147-2516d450feb0"] [:db/add "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/choices "3d4fbbca-395d-5779-ad55-5f2dfe894b9b"] [:db/add "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/correct "3d4fbbca-395d-5779-ad55-5f2dfe894b9b"] [:db/ensure "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d" :answer-field/validate] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/id #uuid "01c27acc-5739-59f4-8fe9-e2185b961d5f"] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/problem "Which of the following statements are true given that $A$ is a $5\\times 5$ matrix which has only $5$ non-pivot column?\n\nSelect all that apply."] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible\n\n$$\n\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\operatorname{Col}(A) &=\\mathbb{R}^{5} \\\\ \\dim(\\operatorname{Col}(A)) &=5=\\operatorname{rank}(A) \\\\ \\operatorname{Null}(A) &=\\{0\\} \\\\ \\dim(\\operatorname{Null}(A)) &=0=\\operatorname{nullity}(A)\\end{aligned}\\right.\n$$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nThe 5 non-pivot columns give $\\text{nullity}(A)=5.$\n\nBy the rank-nullity theorem,\n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\n$$\n\\text{rank}(A)+5=5,\\qquad \\text{rank}(A)=5-5=0.\n$$\n\nHence $\\text{rank}(A)=0$ and $\\text{nullity}(A)=5$. Since rank is less than the number of columns, $A$ is not invertible and $\\det(A)=0$. Also, $\\text{Col}(A)$ has dimension 0. The number of pivot columns is 0, and the number of non-pivot columns is 5.\n\n- Statement “$A$ is invertible” is false. The rank is less than the number of columns.\n\n- Statement “$\\text{Col}(A)$ is a $5$-dimensional subspace of ${R}^{5}.$” is false. $\\dim(\\text{Col}(A))=0$.\n\n- Statement “$\\text{nullity}(A)=5$” is true. $\\text{nullity}(A)=5$.\n\nTherefore, the correct answer is $\\text{nullity}(A)=5$."] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/difficulty :question.difficulty/moderate] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/answer-fields "ba2b51a4-1c12-534c-8dce-a26aa8889459"] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/answer-fields "a1c24042-b870-5f0a-80ac-f4818e90caf5"] [:db/add "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/answer-fields "659ec4e5-fea1-5cd9-a3bc-edb596a4a35d"] [:db/ensure "01c27acc-5739-59f4-8fe9-e2185b961d5f" :question/validate] [:db/add 17592186184172 :knowledge-point/questions "01c27acc-5739-59f4-8fe9-e2185b961d5f"] [:db/add "d8369a5b-132b-5815-ac55-3ca829df5152" :answer/id #uuid "d8369a5b-132b-5815-ac55-3ca829df5152"] [:db/add "d8369a5b-132b-5815-ac55-3ca829df5152" :answer/type :answer.type/text] [:db/add "d8369a5b-132b-5815-ac55-3ca829df5152" :answer/value "I, II, and III"] [:db/ensure "d8369a5b-132b-5815-ac55-3ca829df5152" :answer/validate] [:db/add "12f8229f-ef39-5cfa-a4bd-a0f2f936e940" :answer/id #uuid "12f8229f-ef39-5cfa-a4bd-a0f2f936e940"] [:db/add "12f8229f-ef39-5cfa-a4bd-a0f2f936e940" :answer/type :answer.type/text] [:db/add "12f8229f-ef39-5cfa-a4bd-a0f2f936e940" :answer/value "I and III only"] [:db/ensure "12f8229f-ef39-5cfa-a4bd-a0f2f936e940" :answer/validate] [:db/add "47514b44-7fec-5627-8a5b-bcce4012cc85" :answer/id #uuid "47514b44-7fec-5627-8a5b-bcce4012cc85"] [:db/add "47514b44-7fec-5627-8a5b-bcce4012cc85" :answer/type :answer.type/text] [:db/add "47514b44-7fec-5627-8a5b-bcce4012cc85" :answer/value "II only"] [:db/ensure "47514b44-7fec-5627-8a5b-bcce4012cc85" :answer/validate] [:db/add "a327f0df-7451-5065-ba8a-d07d7567aa5a" :answer/id #uuid "a327f0df-7451-5065-ba8a-d07d7567aa5a"] [:db/add "a327f0df-7451-5065-ba8a-d07d7567aa5a" :answer/type :answer.type/text] [:db/add "a327f0df-7451-5065-ba8a-d07d7567aa5a" :answer/value "I and II only"] [:db/ensure "a327f0df-7451-5065-ba8a-d07d7567aa5a" :answer/validate] [:db/add "de9acc3e-1ada-5d6a-9abe-29947f31aa9b" :answer/id #uuid "de9acc3e-1ada-5d6a-9abe-29947f31aa9b"] [:db/add "de9acc3e-1ada-5d6a-9abe-29947f31aa9b" :answer/type :answer.type/text] [:db/add "de9acc3e-1ada-5d6a-9abe-29947f31aa9b" :answer/value "III only"] [:db/ensure "de9acc3e-1ada-5d6a-9abe-29947f31aa9b" :answer/validate] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/id #uuid "08b95a80-6d17-56c6-be43-c7d7451f84eb"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/key "selection"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/type :answer-field.type/radio] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/choices "d8369a5b-132b-5815-ac55-3ca829df5152"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/choices "12f8229f-ef39-5cfa-a4bd-a0f2f936e940"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/choices "47514b44-7fec-5627-8a5b-bcce4012cc85"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/choices "a327f0df-7451-5065-ba8a-d07d7567aa5a"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/choices "de9acc3e-1ada-5d6a-9abe-29947f31aa9b"] [:db/add "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/correct "47514b44-7fec-5627-8a5b-bcce4012cc85"] [:db/ensure "08b95a80-6d17-56c6-be43-c7d7451f84eb" :answer-field/validate] [:db/add "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb" :question/id #uuid "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb"] [:db/add "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb" :question/problem "Which of the following statements are true given that $A$ is a $8\\times 8$ matrix with $3$ pivot columns?\n\nI. $\\text{rank}(A)=5$\n\nII. $A$ is not invertible\n\nIII. $\\text{nullity}(A)=1$"] [:db/add "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb" :question/worked-solution "Since $A$ is a $8\\times 8$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible\n\n$\\,⇔\\,\\left\\{\\begin{aligned}\\text{Col}(A) &={R}^{8} \\\\ \\text{dim(Col}(A)) &=8=\\text{rank}(A) \\\\ \\text{Null}(A) &=\\{0\\} \\\\ \\text{dim(Null}(A)) &=0=\\text{nullity}(A)\\end{aligned}\\right.$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nThe 3 pivot columns give $\\text{rank}(A)=3.$\n\nBy the rank-nullity theorem,\n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\n$$\n3+\\text{nullity}(A)=8,\\qquad \\text{nullity}(A)=8-3=5.\n$$\n\nHence $\\text{rank}(A)=3$ and $\\text{nullity}(A)=5$. Since rank is less than the number of columns, $A$ is not invertible and $\\det(A)=0$. Also, $\\text{Col}(A)$ has dimension 3. The number of pivot columns is 3, and the number of non-pivot columns is 5.\n\n- Statement I is false. $\\text{rank}(A)=3$.\n\n- Statement II is true. The rank is less than the number of columns.\n\n- Statement III is false. $\\text{nullity}(A)=5$.\n\nTherefore, the correct answer is II only."] [:db/add "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb" :question/difficulty :question.difficulty/moderate] [:db/add "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb" :question/answer-fields "08b95a80-6d17-56c6-be43-c7d7451f84eb"] [:db/ensure "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb" :question/validate] [:db/add 17592186184172 :knowledge-point/questions "1c93f8c9-c546-50e4-a1df-c54e8f82f0eb"] [:db/add "5cd61621-e086-56a9-ae64-6d28ed6d1944" :answer/id #uuid "5cd61621-e086-56a9-ae64-6d28ed6d1944"] [:db/add "5cd61621-e086-56a9-ae64-6d28ed6d1944" :answer/type :answer.type/text] [:db/add "5cd61621-e086-56a9-ae64-6d28ed6d1944" :answer/value "false"] [:db/ensure "5cd61621-e086-56a9-ae64-6d28ed6d1944" :answer/validate] [:db/add "8ad663d6-03d5-593b-8d23-be79be698d83" :answer/id #uuid "8ad663d6-03d5-593b-8d23-be79be698d83"] [:db/add "8ad663d6-03d5-593b-8d23-be79be698d83" :answer/type :answer.type/text] [:db/add "8ad663d6-03d5-593b-8d23-be79be698d83" :answer/value "true"] [:db/ensure "8ad663d6-03d5-593b-8d23-be79be698d83" :answer/validate] [:db/add "54107d25-70b8-589c-83d0-fde2f4e5a0fb" :answer-field/id #uuid "54107d25-70b8-589c-83d0-fde2f4e5a0fb"] [:db/add "54107d25-70b8-589c-83d0-fde2f4e5a0fb" :answer-field/key "$A$ is not invertible"] [:db/add "54107d25-70b8-589c-83d0-fde2f4e5a0fb" :answer-field/type :answer-field.type/check