750 17592186045443 true] [17592186673199 1075 #edb/ref 17592186673212 13194139538750 17592186045443 true] [17592186673199 1075 #edb/ref 17592186673224 13194139538750 17592186045443 true] [17592186673199 1076 #edb/ref 17592186408166 13194139538750 17592186045443 true] [17592186673199 1077 "$\\text{dim(Null}(A))=1$" 13194139538750 17592186045443 true] [17592186673199 1078 #edb/ref 17592186673224 13194139538750 17592186045443 true] [17592186673199 1079 #uuid "35642cd1-9c6c-5719-b955-e0c0c6035e72" 13194139538750 17592186045443 true] [17592186673200 1080 "I and II only" 13194139538750 17592186045443 true] [17592186673200 1082 #edb/ref 17592186045499 13194139538750 17592186045443 true] [17592186673200 1083 #uuid "37ae6200-8724-50c0-b709-2ecc0e3f8794" 13194139538750 17592186045443 true] [17592186673201 1068 #edb/ref 17592186673207 13194139538750 17592186045443 true] [17592186673201 1068 #edb/ref 17592186673211 13194139538750 17592186045443 true] [17592186673201 1068 #edb/ref 17592186673213 13194139538750 17592186045443 true] [17592186673201 1068 #edb/ref 17592186673229 13194139538750 17592186045443 true] [17592186673201 1070 #edb/ref 17592186045487 13194139538750 17592186045443 true] [17592186673201 1071 "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and $$\n\\text{Null}(A)=\\{\\begin{bmatrix}-2{x}_{1} \\\\ 2{x}_{1} \\\\ 4{x}_{2} \\\\ {x}_{2} \\\\ 0\\end{bmatrix}\\mid {x}_{1},{x}_{2}\\in\\mathbb{R}\\}?\n$$\n\nSelect all that apply." 13194139538750 17592186045443 true] [17592186673201 1072 #uuid "430a54b8-0a61-5fcc-ba8f-8099feede2af" 13194139538750 17592186045443 true] [17592186673201 1074 "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{5} \\\\ \\text{rank}(A)&=5 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe supplied nullspace can be written as the span of the independent vectors in\n\n$${x}_{1}\\begin{bmatrix}-2 \\\\ 2 \\\\ 0 \\\\ 0 \\\\ 0\\end{bmatrix} + {x}_{2}\\begin{bmatrix}0 \\\\ 0 \\\\ 4 \\\\ 1 \\\\ 0\\end{bmatrix}$$\n\nHence $\\text{dim(Null}(A))=2$, so $A$ is not invertible.\n\nWe have $\\text{rank}(A)<5$, $\\text{nullity}(A)>0$, $\\text{Null}(A)\\ne\\{0\\}$, and $\\text{Col}(A)\\ne\\mathbb{R}^{5}$. In particular, $\\text{rank}(A)=3$ and $\\text{nullity}(A)=2$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement $\\text{dim(Null}(A))=5$ is false. $\\text{nullity}(A)=2$.\n\n- Statement $A\\text{ is invertible}$ is false. $A$ is not invertible.\n\n- Statement $\\text{Col}(A)\\ne {R}^{5}$ is true. $\\text{Col}(A)\\ne \\mathbb{R}^{5}$.\n\nTherefore, the correct answer is $\\text{Col}(A)\\ne {R}^{5}$ only." 13194139538750 17592186045443 true] [17592186673202 1075 #edb/ref 17592186673205 13194139538750 17592186045443 true] [17592186673202 1075 #edb/ref 17592186673214 13194139538750 17592186045443 true] [17592186673202 1076 #edb/ref 17592186408166 13194139538750 17592186045443 true] [17592186673202 1077 "$\\text{dim(Null}(A))=1$" 13194139538750 17592186045443 true] [17592186673202 1078 #edb/ref 17592186673214 13194139538750 17592186045443 true] [17592186673202 1079 #uuid "460aa660-c8cb-5c14-a7a7-344c954cf7ea" 13194139538750 17592186045443 true] [17592186673203 1080 "false" 13194139538750 17592186045443 true] [17592186673203 1082 #edb/ref 17592186045499 13194139538750 17592186045443 true] [17592186673203 1083 #uuid "475b0073-903b-5909-957b-c2bf958a0e51" 13194139538750 17592186045443 true] [17592186673204 1068 #edb/ref 17592186673222 13194139538750 17592186045443 true] [17592186673204 1070 #edb/ref 17592186045487 13194139538750 17592186045443 true] [17592186673204 1071 "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $$\n\\text{Null}(A)=\\{\\begin{bmatrix}-4{x}_{2} \\\\ {x}_{2} \\\\ {x}_{1} \\\\ 3{x}_{1}\\end{bmatrix}\\mid {x}_{1},{x}_{2}\\in\\mathbb{R}\\}?\n$$\n\nI. $\\text{dim(Null}(A))=2$\n\nII. $A\\text{ is not invertible}$\n\nIII. $\\text{Col}(A)={R}^{4}$" 13194139538750 17592186045443 true] [17592186673204 1072 #uuid "4d55ab29-1e9c-54fa-b4c5-045bb2cab9cc" 13194139538750 17592186045443 true] [17592186673204 1074 "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{4} \\\\ \\text{rank}(A)&=4 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe supplied nullspace can be written as the span of the independent vectors in\n\n$${x}_{1}\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ 3\\end{bmatrix} + {x}_{2}\\begin{bmatrix}-4 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}$$\n\nHence $\\text{dim(Null}(A))=2$, so $A$ is not invertible.\n\nWe have $\\text{rank}(A)<4$, $\\text{nullity}(A)>0$, $\\text{Null}(A)\\ne\\{0\\}$, and $\\text{Col}(A)\\ne\\mathbb{R}^{4}$. In particular, $\\text{rank}(A)=2$ and $\\text{nullity}(A)=2$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true: $\\text{dim(Null}(A))=2$. $\\text{nullity}(A)=2$.\n\n- Statement II is true: $A\\text{ is not invertible}$. $A$ is not invertible.\n\n- Statement III is false: $\\text{Col}(A)={R}^{4}$. $\\text{Col}(A)\\ne \\mathbb{R}^{4}$.\n\nTherefore, the correct answer is I and II only." 13194139538750 17592186045443 true] [17592186673205 1080 "true" 13194139538750 17592186045443 true] [17592186673205 1082 #edb/ref 17592186045499 13194139538750 17592186045443 true] [17592186673205 1083 #uuid "5b15f975-67ea-5476-8f03-c7f74f2dc017" 13194139538750 17592186045443 true] [17592186673206 1075 #edb/ref 17592186673203 13194139538750 17592186045443 true] [17592186673206 1075 #edb/ref 17592186673233 13194139538750 17592186045443 true] [17592186673206 1076 #edb/ref 17592186408166 13194139538750 17592186045443 true] [17592186673206 1077 "$\\text{rank}(A)=5$" 131941395