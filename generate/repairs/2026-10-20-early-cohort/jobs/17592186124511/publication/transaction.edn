/choices "f15e8fed-707c-5062-8e6e-f4b9c86ecce0"] [:db/add "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/choices "e8fcdf25-49f6-5816-a304-cabb301b89ee"] [:db/add "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/choices "2ffd11b0-8235-5f25-9175-bc26be2367d9"] [:db/add "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/choices "9a07f16e-b808-5228-b981-8548b21f279e"] [:db/add "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/choices "c1f98da1-d3b1-5d5c-ba1c-d1627336a904"] [:db/add "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/correct "9a07f16e-b808-5228-b981-8548b21f279e"] [:db/ensure "2419e9a9-f037-57a7-8ce3-aadb27452f7c" :answer-field/validate] [:db/add "e41f879e-5e60-5636-a17a-b03256796798" :question/id #uuid "e41f879e-5e60-5636-a17a-b03256796798"] [:db/add "e41f879e-5e60-5636-a17a-b03256796798" :question/problem "Which of the following statements are true, given that $A$ is a $7\\times 7$ matrix and $\\text{rank}(A)=7$?\n\nI. $A\\text{ is invertible}$\n\nII. $\\text{Col}(A)\\ne {R}^{7}$\n\nIII. $\\text{dim(Null}(A))=0$"] [:db/add "e41f879e-5e60-5636-a17a-b03256796798" :question/worked-solution "Since $A$ is a $7\\times 7$ matrix, the invertible matrix theorem states the following:\n\n$$ A\\text{ is invertible}\\quad\\Longleftrightarrow\\quad\\left\\{\\begin{aligned}\\text{Col}(A)&=\\mathbb{R}^{7} \\\\ \\text{rank}(A)&=7 \\\\ \\text{Null}(A)&=\\{0\\} \\\\ \\text{nullity}(A)&=0\\end{aligned}\\right. $$\n\nThe given full rank implies that $A$ is invertible.\n\nWe have $\\text{rank}(A)=7$, $\\text{nullity}(A)=0$, $\\text{Null}(A)=\\{0\\}$, and $\\text{Col}(A)=\\mathbb{R}^{7}$.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true: $A\\text{ is invertible}$. $A$ is invertible.\n\n- Statement II is false: $\\text{Col}(A)\\ne {R}^{7}$. $\\text{Col}(A)=\\mathbb{R}^{7}$.\n\n- Statement III is true: $\\text{dim(Null}(A))=0$. $\\text{nullity}(A)=0$.\n\nTherefore, the correct answer is I and III only."] [:db/add "e41f879e-5e60-5636-a17a-b03256796798" :question/difficulty :question.difficulty/moderate] [:db/add "e41f879e-5e60-5636-a17a-b03256796798" :question/answer-fields "2419e9a9-f037-57a7-8ce3-aadb27452f7c"] [:db/ensure "e41f879e-5e60-5636-a17a-b03256796798" :question/validate] [:db/add 17592186124511 :knowledge-point/questions "e41f879e-5e60-5636-a17a-b03256796798"] [:db/add "475b0073-903b-5909-957b-c2bf958a0e51" :answer/id #uuid "475b0073-903b-5909-957b-c2bf958a0e51"] [:db/add "475b0073-903b-5909-957b-c2bf958a0e51" :answer/type :answer.type/text] [:db/add "475b0073-903b-5909-957b-c2bf958a0e51" :answer/value "false"] [:db/ensure "475b0073-903b-5909-957b-c2bf958a0e51" :answer/validate] [:db/add "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3" :answer/id #uuid "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3"] [:db/add "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3" :answer/type :answer.type/text] [:db/add "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3" :answer/value "true"] [:db/ensure "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3" :answer/validate] [:db/add "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/id #uuid "62ecaf89-7f8c-5743-8190-377e5b4987a1"] [:db/add "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/key "$\\text{rank}(A)=5$"] [:db/add "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/type :answer-field.type/checkbox] [:db/add "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/choices "475b0073-903b-5909-957b-c2bf958a0e51"] [:db/add "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/choices "f14c2be7-6d66-59ed-8e7e-b0e8ed2d34b3"] [:db/add "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/correct "475b0073-903b-5909-957b-c2bf958a0e51"] [:db/ensure "62ecaf89-7f8c-5743-8190-377e5b4987a1" :answer-field/validate] [:db/add "8bebcac0-8f6e-5792-b15e-d22a8c0de5f6" :answer/id #uuid "8bebcac0-8f6e-5792-b15e-d22a8c0de5f6"] [:db/add "8bebcac0-8f6e-5792-b15e-d22a8c0de5f6" :answer/type :answer.type/text] [:db/add "8bebcac0-8f6e-5792-b15e-d22a8c0de5f6" :answer/value "false"] [:db/ensure "8bebcac0-8f6e-5792-b15e-d22a