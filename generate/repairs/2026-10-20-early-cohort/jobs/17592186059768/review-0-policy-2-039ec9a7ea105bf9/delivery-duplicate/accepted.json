              ":answer/id": "2c5a189b-46d8-5436-bb7a-38c1288f3320",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\left[\\begin{array}{cc|c}7 & -1 & 7 \\\\ 22 & 1 & -12\\end{array}\\right]"
