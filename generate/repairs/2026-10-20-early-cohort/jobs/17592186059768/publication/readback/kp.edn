b/ref 17592186510675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f98d3f2-bc3d-52e1-8dcc-fa5a0219067b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -16 & 23 \\\\ 10 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510635} {:answer/id #uuid "4a3a67cc-ef37-5732-873b-6fd492481549" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ -19 & 1 & -10\\end{array}\\right]" :db/id #edb/ref 17592186510646} {:answer/id #uuid "5bf0aa0f-6704-529c-a699-c9547357a20a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -19 & 0 \\\\ -23 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186510650} {:answer/id #uuid "767d9066-c236-5dc7-bb56-8ca4a0ea4197" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & 23 & 16 \\\\ 10 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510659} {:answer/id #uuid "dc2f7c86-2c5f-5db7-876e-f04d95786fd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ 10 & 1 & 19\\end{array}\\right]" :db/id #edb/ref 17592186510678}] :answer-field/correct {:answer/id #uuid "4a3a67cc-ef37-5732-873b-6fd492481549" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ -19 & 1 & -10\\end{array}\\right]" :db/id #edb/ref 17592186510646} :answer-field/id #uuid "5a9ae83c-4e44-5ec5-ab7c-3d0bd8eafbfb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510649}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c623f24b-cc19-5f11-8d33-9360241906f8" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\\left\\{\\begin{aligned}8x-16 &=23y \\\\ 10+y &=19x\\end{aligned}\\right.$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\\left\\{\\begin{aligned}8x-23y &=16 \\\\ -19x+y &=-10\\end{aligned}\\right.$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}8 & -23 \\\\ -19 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n\\left[\\begin{array}{cc|c}8 & -23 & 16 \\\\ -19 & 1 & -10\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186639189 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "013cd717-34e8-551f-bd1b-fd054e234e64" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 4 & 2 & 9 \\\\ 0 & 4 & 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186638625} {:answer/id #uuid "9a632174-8e0c-5b0b-8555-66ca167b74e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 4 & -2 \\\\ 0 & 4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186638899} {:answer/id #uuid "cbcb8bea-8039-52b3-8976-44467a37217a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 4 & -2 & 9 \\\\ 0 & 4 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186638986} {:answer/id #uuid "d15749c8-085f-5d51-8f7b-c9b0b5b0fc11" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 4 & 2 & 9 \\\\ 0 & 4 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186638996} {:answer/id #uuid "ec2b453a-c79f-50e4-a331-ff02d67a4782" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 4 & 2 & -9 \\\\ 0 & 4 & 2 & 0\\end{bmatrix}" :db/id #edb/ref 17592186639037}] :answer-field/correct {:answer/id #uuid "d15749c8-085f-5d51-8f7b-c9b0b5b0fc11" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 4 & 2 & 9 \\\\ 0 & 4 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186638996} :answer-field/id #uuid "73bce267-001a-5836-a5a1-f0dc1dc5971c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639121}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3760f817-76ad-5963-aefb-d389b1f60dfd" :question/math-academy-id "q-1068" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}15x+4y-9+2z &=0 \\\\ 2z &=1-4y\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}15x+4y+2z &=9 \\\\ 0x+4y+2z &=1\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}15 & 4 & 2 \\\\ 0 & 4 & 2\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\begin{bmatrix}15 & 4 & 2 & 9 \\\\ 0 & 4 & 2 & 1\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186639196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "274f142b-654c-5545-8256-1245a942b306" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -2 & 3 & 10 \\\\ 0 & -1 & 4 & 20 \\\\ 9 & 3 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186638702} {:answer/id #uuid "772b3e51-27c3-585b-a3e7-c1f2ec57f030" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 10 & 3 & 2 \\\\ 20 & -4 & 1 & 0 \\\\ 3 & 9 & 12 & 0\\end{bmatrix}" :db/id #edb/ref 17592186638835} {:answer/id #uuid "a0043bb2-f12a-5bde-bf46-9f355e32f612" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -2 & 3 & 10 \\\\ 0 & -1 & 4 & -20 \\\\ 9 & 3 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186638909} {:answer/id #uuid "dadcb440-3334-52c5-96e1-92dbc72e5f1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 2 & 3 & 10 \\\\ 0 & 1 & 4 & -20 \\\\ 9 & 3 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186639007} {:answer/id #uuid "f5867a2c-d156-528a-83d9-db3aa1f868fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -2 & 3 & 10 \\\\ 0 & -1 & -4 & -20 \\\\ 9 & 3 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186639056}] :answer-field/correct {:answer/id #uuid "f5867a2c-d156-528a-83d9-db3aa1f868fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & -2 & 3 & 10 \\\\ 0 & -1 & -4 & -20 \\\\ 9 & 3 & 0 & 12\\end{bmatrix}" :db/id #edb/ref 17592186639056} :answer-field/id #uuid "350df678-e27e-5f04-9652-0a07bd301825" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639092}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "415575f6-a7fc-537e-9b84-fc64413cee34" :question/math-academy-id "q-1053" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}6x-10+3z &=2y \\\\ 20-4z &=y \\\\ 3y+9x &=12\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient: \n\n$$\n\\left\\{\\begin{aligned}6x-2y+3z &=10 \\\\ 0x-y-4z &=-20 \\\\ 9x+3y+0z &=12\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}6 & -2 & 3 \\\\ 0 & -1 & -4 \\\\ 9 & 3 & 0\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations: \n\n$$\n\\begin{bmatrix}6 & -2 & 3 & 10 \\\\ 0 & -1 & -4 & -20 \\\\ 9 & 3 & 0 & 12\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186639268 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b43c874-68b3-5edb-b41b-e2ca3c58748d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -8 & 0 & 11 \\\\ -5 & 4 & 4 & -9 \\\\ -5 & 0 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186638649} {:answer/id #uuid "44f40f5b-05c0-56a7-95bc-325e48893349" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -8 & 1 & 11 \\\\ -5 & 4 & 4 & -9 \\\\ -5 & 1 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186638751} {:answer/id #uuid "94212f4f-70ec-53b4-883f-5482de09797d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -8 & 0 & 11 \\\\ 4 & 4 & 5 & -9 \\\\ 1 & -5 & 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186638884} {:answer/id #uuid "e63d094b-a78b-5800-bb7d-0497b33f66c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -8 & 11 & 0 \\\\ 4 & 4 & 9 & 5 \\\\ 1 & -5 & 3 & 0\\end{bmatrix}" :db/id #edb/ref 17592186639033} {:answer/id #uuid "f43d606d-b203-5e85-b8c0-53fe6b9eb381" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & 8 & 1 & 11 \\\\ 5 & 4 & 4 & 9 \\\\ 5 & 1 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186639052}] :answer-field/correct {:answer/id #uuid "0b43c874-68b3-5edb-b41b-e2ca3c58748d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 & -8 & 0 & 11 \\\\ -5 & 4 & 4 & -9 \\\\ -5 & 0 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186638649} :answer-field/id #uuid "6e79c0f8-6131-5d1c-a639-9702ccee8cb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639119}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ff919820-9ae8-5522-9a28-975841dc4965" :question/math-academy-id "q-129128" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}7x-8y &=11 \\\\ 4z+4y+9 &=5x \\\\ z-5x &=3\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y,z$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}7x-8y+0z &=11 \\\\ -5x+4y+4z &=-9 \\\\ -5x+0y+z &=3\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}7 & -8 & 0 \\\\ -5 & 4 & 4 \\\\ -5 & 0 & 1\\end{bmatrix}\n$$\n\nThe augmented matrix  is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\begin{bmatrix}7 & -8 & 0 & 11 \\\\ -5 & 4 & 4 & -9 \\\\ -5 & 0 & 1 & 3\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186671393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fb62d08-c0e8-51b8-a88b-60b9651a3067" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-23 & 1 & 11 \\\\ -21 & -1 & -14\\end{array}\\right]" :db/id #edb/ref 17592186671403} {:answer/id #uuid "7167ccfb-ea49-5dbd-bb4c-ecf8968a491e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & 1 & 11 \\\\ -14 & -23 & -21\\end{array}\\right]" :db/id #edb/ref 17592186671405} {:answer/id #uuid "72c730ac-9e86-503f-8e76-f231450cd92a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-14 & 11 & 1 \\\\ -21 & -23 & -1\\end{array}\\right]" :db/id #edb/ref 17592186671406} {:answer/id #uuid "ac17c3e1-c405-5725-b09b-813a57cf6568" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-14 & 1 & 11 \\\\ -23 & -1 & -21\\end{array}\\right]" :db/id #edb/ref 17592186671414} {:answer/id #uuid "e2026e3f-9cad-5640-8b7d-f64da833e752" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-21 & 1 & 11 \\\\ -1 & -23 & -14\\end{array}\\right]" :db/id #edb/ref 17592186671421}] :answer-field/correct {:answer/id #uuid "ac17c3e1-c405-5725-b09b-813a57cf6568" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-14 & 1 & 11 \\\\ -23 & -1 & -21\\end{array}\\right]" :db/id #edb/ref 17592186671414} :answer-field/id #uuid "7ff4a49b-f382-58a2-bc81-4448def09e70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671408}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0ee64f2f-6856-5d3c-8781-4f80f3b5d79f" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\left\\{\\begin{aligned}y-14x-11 &=0 \\\\ -23x &=-21+y\\end{aligned}\\right.\n$$" :question/worked-solution "First, we organize the system so that the variables are ordered $x,y$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient:\n\n$$\n\\left\\{\\begin{aligned}-14x+y &=11 \\\\ -23x-y &=-21\\end{aligned}\\right.\n$$\n\nThe coefficient matrix consists of the coefficients of the variables:\n\n$$\n\\begin{bmatrix}-14 & 1 \\\\ -23 & -1\\end{bmatrix}\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n\\left[\\begin{array}{cc|c}-14 & 1 & 11 \\\\ -23 & -1 & -21\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186671411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d753ff-6760-5408-b431-ad6a05c97a8a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & -1 & 12 \\\\ -1 & 1 & -23\\end{array}\\right]" :db/id #edb/ref 17592186671394} {:answer/id #uuid "19cc5457-a5a2-58a2-9be6-995bb3733c82" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & -1 & 1 \\\\ -1 & 12 & -23\\end{array}\\right]" :db/id #edb/ref 17592186671395} {:answer/id #uuid "3ff3a68c-8a12-50a5-a06b-f1e63175980c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-23 & -1 & 12 \\\\ -1 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186671400} {:answer/id #uuid "b1d4c05c-e153-56e5-ada5