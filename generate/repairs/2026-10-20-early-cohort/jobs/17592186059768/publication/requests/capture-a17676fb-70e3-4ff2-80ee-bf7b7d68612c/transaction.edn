\\end{array}\\right]\n$$"] [:db/add "a6514075-5e1b-5b6a-8d47-de1bbc1fd027" :question/difficulty :question.difficulty/easy] [:db/add "a6514075-5e1b-5b6a-8d47-de1bbc1fd027" :question/answer-fields "6cfd0861-4364-545d-9f35-4d91addef576"] [:db/ensure "a6514075-5e1b-5b6a-8d47-de1bbc1fd027" :question/validate] [:db/add 17592186059768 :knowledge-point/questions "a6514075-5e1b-5b6a-8d47-de1bbc1fd027"] [:db/add "9cfcd050-570b-5f3c-bdc4-70b84ec5f1de" :answer/id #uuid "9cfcd050-570b-5f3c-bdc4-70b84ec5f1de"] [:db/add "9cfcd050-570b-5f3c-bdc4-70b84ec5f1de" :answer/type :answer.type/math] [:db/add "9cfcd050-570b-5f3c-bdc4-70b84ec5f1de" :answer/value "\\left[\\begin{array}{cc|c}-1 & -1 & -14 \\\\ -18 & 15 & 1\\end{array}\\right]"] [:db/ensure "9cfcd050-570b-5f3c-bdc4-70b84ec5f1de" :answer/validate] [:db/add "e4572d2e-302f-5f59-93a1-69608bdd5b35" :answer/id #uuid "e4572d2e-302f-5f59-93a1-69608bdd5b35"] [:db/add "e4572d2e-302f-5f59-93a1-69608bdd5b35" :answer/type :answer.type/math] [:db/add "e4572d2e-302f-5f59-93a1-69608bdd5b35" :answer/value "\\left[\\begin{array}{cc|c}-1 & -14 & -18 \\\\ -1 & 15 & 1\\end{array}\\right]"] [:db/ensure "e4572d2e-302f-5f59-93a1-69608bdd5b35" :answer/validate] [:db/add "d14f8415-8258-57c0-abfe-cd5cfbd5cff3" :answer/id #uuid "d14f8415-8258-57c0-abfe-cd5cfbd5cff3"] [:db/add "d14f8415-8258-57c0-abfe-cd5cfbd5cff3" :answer/type :answer.type/math] [:db/add "d14f8415-8258-57c0-abfe-cd5cfbd5cff3" :answer/value "\\left[\\begin{array}{cc|c}-1 & -1 & -18 \\\\ -14 & 1 & 15\\end{array}\\right]"] [:db/ensure "d14f8415-8258-57c0-abfe-cd5cfbd5cff3" :answer/validate] [:db/add "3afb3734-02a1-532a-b5cd-dd1f0339ffde" :answer/id #uuid "3afb3734-02a1-532a-b5cd-dd1f0339ffde"] [:db/add "3afb3734-02a1-532a-b5cd-dd1f0339ffde" :answer/type :answer.type/math] [:db/add "3afb3734-02a1-532a-b5cd-dd1f0339ffde" :answer/value "\\left[\\begin{array}{cc|c}-1 & -18 & -1 \\\\ -14 & 15 & 1\\end{array}\\right]"] [:db/ensure "3afb3734-02a1-532a-b5cd-dd1f0339ffde" :answer/validate] [:db/add "f