              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}y}{\\text{d}x} - 6 y e^{- 5 x}=- 5 x e^{- 10 x}"
            },
            {
              ":answer/id": "a97688ee-8e85-5c68-86b2-0bb9a421598e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}y}{\\text{d}x} - 7 y e^{- 5 x}=- 3 x e^{- 10 x}"
