              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}y}{\\text{d}x} + 8 x y=- 6 x^{2}"
            },
            {
              ":answer/id": "823b9382-10e4-5ea2-8874-a88ff95e440a",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 7 x^{2}"
            },
            {
              ":answer/id": "a73e207f-db41-5a62-bddc-65ebfcbcdbac",
