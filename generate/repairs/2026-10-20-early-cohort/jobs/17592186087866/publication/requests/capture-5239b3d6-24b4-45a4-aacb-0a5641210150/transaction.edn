[[:db/add "ca591e24-d59c-51c4-a500-165195f0aa99" :answer/id #uuid "ca591e24-d59c-51c4-a500-165195f0aa99"] [:db/add "ca591e24-d59c-51c4-a500-165195f0aa99" :answer/type :answer.type/math] [:db/add "ca591e24-d59c-51c4-a500-165195f0aa99" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 5 x y=- 2 x^{2}"] [:db/ensure "ca591e24-d59c-51c4-a500-165195f0aa99" :answer/validate] [:db/add "7ac72dde-6f9d-5d06-868f-0e4f50ab6370" :answer/id #uuid "7ac72dde-6f9d-5d06-868f-0e4f50ab6370"] [:db/add "7ac72dde-6f9d-5d06-868f-0e4f50ab6370" :answer/type :answer.type/math] [:db/add "7ac72dde-6f9d-5d06-868f-0e4f50ab6370" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 8 x y=- 7 x^{2}"] [:db/ensure "7ac72dde-6f9d-5d06-868f-0e4f50ab6370" :answer/validate] [:db/add "94bbae5a-5c35-5193-8952-f4496b15cf35" :answer/id #uuid "94bbae5a-5c35-5193-8952-f4496b15cf35"] [:db/add "94bbae5a-5c35-5193-8952-f4496b15cf35" :answer/type :answer.type/math] [:db/add "94bbae5a-5c35-5193-8952-f4496b15cf35" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 6 x^{2}"] [:db/ensure "94bbae5a-5c35-5193-8952-f4496b15cf35" :answer/validate] [:db/add "10367d2c-ff74-56dd-803d-d14273cb6ee2" :answer/id #uuid "10367d2c-ff74-56dd-803d-d14273cb6ee2"] [:db/add "10367d2c-ff74-56dd-803d-d14273cb6ee2" :answer/type :answer.type/math] [:db/add "10367d2c-ff74-56dd-803d-d14273cb6ee2" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + x y=- 3 x^{2}"] [:db/ensure "10367d2c-ff74-56dd-803d-d14273cb6ee2" :answer/validate] [:db/add "b6359046-12c0-58dc-8f12-74a984edaed1" :answer/id #uuid "b6359046-12c0-58dc-8f12-74a984edaed1"] [:db/add "b6359046-12c0-58dc-8f12-74a984edaed1" :answer/type :answer.type/math] [:db/add "b6359046-12c0-58dc-8f12-74a984edaed1" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 6 x y=- 4 x^{2}"] [:db/ensure "b6359046-12c0-58dc-8f12-74a984edaed1" :answer/validate] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/id #uuid "38b44e5e-a74e-57f0-99e7-438980fc708c"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/key "selection"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/type :answer-field.type/radio] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/choices "ca591e24-d59c-51c4-a500-165195f0aa99"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/choices "7ac72dde-6f9d-5d06-868f-0e4f50ab6370"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/choices "94bbae5a-5c35-5193-8952-f4496b15cf35"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/choices "10367d2c-ff74-56dd-803d-d14273cb6ee2"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/choices "b6359046-12c0-58dc-8f12-74a984edaed1"] [:db/add "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/correct "94bbae5a-5c35-5193-8952-f4496b15cf35"] [:db/ensure "38b44e5e-a74e-57f0-99e7-438980fc708c" :answer-field/validate] [:db/add "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/id #uuid "af3535bf-626a-5961-8a1e-6a3e608fbdff"] [:db/add "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x} y + 6 x^{2} y=- 3 x y^{2}\\,.\n$$\n\nAssume $y\\ne 0$."] [:db/add "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{gathered}\\frac{\\text{d}y}{\\text{d}x} y + 6 x^{2} y=- 3 x y^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} y + 6 x^{2} y + 3 x y^{2}=0 \\\\ y (\\frac{\\text{d}y}{\\text{d}x} + 6 x^{2} + 3 x y)=0 \\\\ \\frac{\\text{d}y}{\\text{d}x} + 6 x^{2} + 3 x y=0 \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(3 x)}_{P(x)}y=\\underbrace{- 6 x^{2}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 6 x^{2}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=3 x$ and $Q(x)=- 6 x^{2}.$"] [:db/add "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/difficulty :question.difficulty/easy] [:db/add "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/answer-fields "38b44e5e-a74e-57f0-99e7-438980fc708c"] [:db/ensure "af3535bf-626a-5961-8a1e-6a3e608fbdff" :question/validate] [:db/add 17592186087866 :knowledge-point/questions "af3535bf-626a-5961-8a1e-6a3e608fbdff"] [:db/add "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb" :answer/id #uuid "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb"] [:db/add "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb" :answer/type :answer.type/math] [:db/add "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{8 y \\sin{(x )}}{3}=- \\frac{4 \\cos{(x )}}{3} - 1"] [:db/ensure "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb" :answer/validate] [:db/add "de43eed0-eaf1-5d07-b400-ee4ea9b82ee0" :answer/id #uuid "de43eed0-eaf1-5d07-b400-ee4ea9b82ee0"] [:db/add "de43eed0-eaf1-5d07-b400-ee4ea9b82ee0" :answer/type :answer.type/math] [:db/add "de43eed0-eaf1-5d07-b400-ee4ea9b82ee0" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{2 y \\sin{(x )}}{3}=- \\frac{4 \\cos{(x )}}{3} - \\frac{2}{3}"] [:db/ensure "de43eed0-eaf1-5d07-b400-ee4ea9b82ee0" :answer/validate] [:db/add "6376964f-d081-5983-9b10-9b12603b899d" :answer/id #uuid "6376964f-d081-5983-9b10-9b12603b899d"] [:db/add "6376964f-d081-5983-9b10-9b12603b899d" :answer/type :answer.type/math] [:db/add "6376964f-d081-5983-9b10-9b12603b899d" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{y \\sin{(x )}}{3}=- \\frac{4 \\cos{(x )}}{3} - \\frac{1}{3}"] [:db/ensure "6376964f-d081-5983-9b10-9b12603b899d" :answer/validate] [:db/add "d2fb24c6-7ead-548c-b887-b77069b73dbb" :answer/id #uuid "d2fb24c6-7ead-548c-b887-b77069b73dbb"] [:db/add "d2fb24c6-7ead-548c-b887-b77069b73dbb" :answer/type :answer.type/math] [:db/add "d2fb24c6-7ead-548c-b887-b77069b73dbb" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{5 y \\sin{(x )}}{3}=- \\frac{4 \\cos{(x )}}{3} - \\frac{4}{3}"] [:db/ensure "d2fb24c6-7ead-548c-b887-b77069b73dbb" :answer/validate] [:db/add "8791ba5f-b229-580a-9e9a-6d1f402f7a26" :answer/id #uuid "8791ba5f-b229-580a-9e9a-6d1f402f7a26"] [:db/add "8791ba5f-b229-580a-9e9a-6d1f402f7a26" :answer/type :answer.type/math] [:db/add "8791ba5f-b229-580a-9e9a-6d1f402f7a26" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + \\frac{4 y \\sin{(x )}}{3}=- \\frac{4 \\cos{(x )}}{3} - \\frac{5}{3}"] [:db/ensure "8791ba5f-b229-580a-9e9a-6d1f402f7a26" :answer/validate] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/id #uuid "53688c10-d900-5346-9d66-c6fc7b7252a8"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/key "selection"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/type :answer-field.type/radio] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/choices "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/choices "de43eed0-eaf1-5d07-b400-ee4ea9b82ee0"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/choices "6376964f-d081-5983-9b10-9b12603b899d"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/choices "d2fb24c6-7ead-548c-b887-b77069b73dbb"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/choices "8791ba5f-b229-580a-9e9a-6d1f402f7a26"] [:db/add "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/correct "db46e7a2-8e85-5c98-a2f7-0d516be6fbeb"] [:db/ensure "53688c10-d900-5346-9d66-c6fc7b7252a8" :answer-field/validate] [:db/add "58d10461-8feb-51d8-b688-d9835924b3d8" :question/id #uuid "58d10461-8feb-51d8-b688-d9835924b3d8"] [:db/add "58d10461-8feb-51d8-b688-d9835924b3d8" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n3 \\frac{\\text{d}y}{\\text{d}x} + 4 \\cos{(x )}=- 8 y \\sin{(x )} - 3\\,.\n$$"] [:db/add "58d10461-8feb-51d8-b688-d9835924b3d8" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{gathered}3 \\frac{\\text{d}y}{\\text{d}x} + 4 \\cos{(x )}=- 8 y \\sin{(x )} - 3 \\\\ 3 \\frac{\\text{d}y}{\\text{d}x} + 8 y \\sin{(x )}=- 4 \\cos{(x )} - 3 \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(\\frac{8 \\sin{(x )}}{3})}_{P(x)}y=\\underbrace{- \\frac{4 \\cos{(x )}}{3} - 1}_{Q(x)}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=\\frac{8 \\sin{(x )}}{3}$ and $Q(x)=- \\frac{4 \\cos{(x )}}{3} - 1.$"] [:db/add "58d10461-8feb-51d8-b688-d9835924b3d8" :question/difficulty :question.difficulty/easy] [:db/add "58d10461-8feb-51d8-b688-d9835924b3d8" :question/answer-fields "53688c10-d900-5346-9d66-c6fc7b7252a8"] [:db/ensure "58d10461-8feb-51d8-b688-d9835924b3d8" :question/validate] [:db/add 17592186087866 :knowledge-point/questions "58d10461-8feb-51d8-b688-d9835924b3d8"] [:db/add "311d4078-1c96-5336-b790-e518138524eb" :answer/id #uuid "311d4078-1c96-5336-b790-e518138524eb"] [:db/add "311d4078-1c96-5336-b790-e518138524eb" :answer/type :answer.type/math] [:db/add "311d4078-1c96-5336-b790-e518138524eb" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 4 y \\tan{(6 x )}=- 4 \\sin{(6 x )}"] [:db/ensure "311d4078-1c96-5336-b790-e518138524eb" :answer/validate] [:db/add "97ce91ec-57ab-58d6-a70d-3b5dd8cad439" :answer/id #uuid "97ce91ec-57ab-58d6-a70d-3b5dd8cad439"] [:db/add "97ce91ec-57ab-58d6-a70d-3b5dd8cad439" :answer/type :answer.type/math] [:db/add "97ce91ec-57ab-58d6-a70d-3b5dd8cad439" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 5 y \\tan{(6 x )}=- 12 \\sin{(6 x )}"] [:db/ensure "97ce91ec-57ab-58d6-a70d-3b5dd8cad439" :answer/validate] [:db/add "17208af5-6a7d-5c6f-af89-2d091f5fbb84" :answer/id #uuid "17208af5-6a7d-5c6f-af89-2d091f5fbb84"] [:db/add "17208af5-6a7d-5c6f-af89-2d091f5fbb84" :answer/type :answer.type/math] [:db/add "17208af5-6a7d-5c6f-af89-2d091f5fbb84" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 6 y \\tan{(6 x )}=- 8 \\sin{(6 x )}"] [:db/ensure "17208af5-6a7d-5c6f-af89-2d091f5fbb84" :answer/validate] [:db/add "ab19ae44-9d58-55e7-b811-2122760db6cd" :answer/id #uuid "ab19ae44-9d58-55e7-b811-2122760db6cd"] [:db/add "ab19ae44-9d58-55e7-b811-2122760db6cd" :answer/type :answer.type/math] [:db/add "ab19ae44-9d58-55e7-b811-2122760db6cd" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 2 y \\tan{(6 x )}=- 16 \\sin{(6 x )}"] [:db/ensure "ab19ae44-9d58-55e7-b811-2122760db6cd" :answer/validate] [:db/add "167d2b3a-404d-5c09-a5fc-3d47d0be25b4" :answer/id #uuid "167d2b3a-404d-5c09-a5fc-3d47d0be25b4"] [:db/add "167d2b3a-404d-5c09-a5fc-3d47d0be25b4" :answer/type :answer.type/math] [:db/add "167d2b3a-404d-5c09-a5fc-3d47d0be25b4" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 y \\tan{(6 x )}=- 10 \\sin{(6 x )}"] [:db/ensure "167d2b3a-404d-5c09-a5fc-3d47d0be25b4" :answer/validate] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/id #uuid "e893acbd-985d-5d61-923c-cc5dd028eea1"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/key "selection"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/type :answer-field.type/radio] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/choices "311d4078-1c96-5336-b790-e518138524eb"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/choices "97ce91ec-57ab-58d6-a70d-3b5dd8cad439"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/choices "17208af5-6a7d-5c6f-af89-2d091f5fbb84"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/choices "ab19ae44-9d58-55e7-b811-2122760db6cd"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/choices "167d2b3a-404d-5c09-a5fc-3d47d0be25b4"] [:db/add "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/correct "17208af5-6a7d-5c6f-af89-2d091f5fbb84"] [:db/ensure "e893acbd-985d-5d61-923c-cc5dd028eea1" :answer-field/validate] [:db/add "90279bae-a817-5170-8c2a-84168513553a" :question/id #uuid "90279bae-a817-5170-8c2a-84168513553a"] [:db/add "90279bae-a817-5170-8c2a-84168513553a" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x} \\cos{(6 x )} + 6 y \\sin{(6 x )} + 4 \\sin{(12 x )}=0\\,.\n$$\n\nAssume $\\cos{(6 x )}\\ne 0$."] [:db/add "90279bae-a817-5170-8c2a-84168513553a" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{gathered}\\frac{\\text{d}y}{\\text{d}x} \\cos{(6 x )} + 6 y \\sin{(6 x )} + 4 \\sin{(12 x )}=0 \\\\ \\frac{\\text{d}y}{\\text{d}x} \\cos{(6 x )} + 6 y \\sin{(6 x )}=- 4 \\sin{(12 x )} \\\\ \\frac{\\text{d}y}{\\text{d}x} + \\frac{6 y \\sin{(6 x )}}{\\cos{(6 x )}}=- \\frac{4 \\sin{(12 x )}}{\\cos{(6 x )}} \\\\ \\frac{\\text{d}y}{\\text{d}x} + 6 y \\tan{(6 x )}=\\frac{- 8 \\sin{(6 x )}\\cos{(6 x )}}{\\cos{(6 x )}} \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(6 \\tan{(6 x )})}_{P(x)}y=\\underbrace{- 8 \\sin{(6 x )}}_{Q(x)}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=6 \\tan{(6 x )}$ and $Q(x)=- 8 \\sin{(6 x )}.$"] [:db/add "90279bae-a817-5170-8c2a-84168513553a" :question/difficulty :question.difficulty/easy] [:db/add "90279bae-a817-5170-8c2a-84168513553a" :question/answer-fields "e893acbd-985d-5d61-923c-cc5dd028eea1"] [:db/ensure "90279bae-a817-5170-8c2a-84168513553a" :question/validate] [:db/add 17592186087866 :knowledge-point/questions "90279bae-a817-5170-8c2a-84168513553a"] [:db/add "d3c50cbf-15a8-50fa-a40a-e9338f50a145" :answer/id #uuid "d3c50cbf-15a8-50fa-a40a-e9338f50a145"] [:db/add "d3c50cbf-15a8-50fa-a40a-e9338f50a145" :answer/type :answer.type/math] [:db/add "d3c50cbf-15a8-50fa-a40a-e9338f50a145" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 5 x y=- 4 x^{2}"] [:db/ensure "d3c50cbf-15a8-50fa-a40a-e9338f50a145" :answer/validate] [:db/add "878cca54-7f5d-58c4-bee3-c51799ce383a" :answer/id #uuid "878cca54-7f5d-58c4-bee3-c51799ce383a"] [:db/add "878cca54-7f5d-58c4-bee3-c51799ce383a" :answer/type :answer.type/math] [:db/add "878cca54-7f5d-58c4-bee3-c51799ce383a" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 8 x y=- 6 x^{2}"] [:db/ensure "878cca54-7f5d-58c4-bee3-c51799ce383a" :answer/validate] [:db/add "b7a08845-2f23-5672-a741-af3649d4cd58" :answer/id #uuid "b7a08845-2f23-5672-a741-af3649d4cd58"] [:db/add "b7a08845-2f23-5672-a741-af3649d4cd58" :answer/type :answer.type/math] [:db/add "b7a08845-2f23-5672-a741-af3649d4cd58" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 7 x^{2}"] [:db/ensure "b7a08845-2f23-5672-a741-af3649d4cd58" :answer/validate] [:db/add "d98d84b7-87a3-5a5a-bea4-c8f35276027f" :answer/id #uuid "d98d84b7-87a3-5a5a-bea4-c8f35276027f"] [:db/add "d98d84b7-87a3-5a5a-bea4-c8f35276027f" :answer/type :answer.type/math] [:db/add "d98d84b7-87a3-5a5a-bea4-c8f35276027f" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 2 x y=- 2 x^{2}"] [:db/ensure "d98d84b7-87a3-5a5a-bea4-c8f35276027f" :answer/validate] [:db/add "0897b3b2-91af-5ead-86ad-53a74af25290" :answer/id #uuid "0897b3b2-91af-5ead-86ad-53a74af25290"] [:db/add "0897b3b2-91af-5ead-86ad-53a74af25290" :answer/type :answer.type/math] [:db/add "0897b3b2-91af-5ead-86ad-53a74af25290" :answer/value "\\frac{\\text{d}y}{\\text{d}x} + 6 x y=- 8 x^{2}"] [:db/ensure "0897b3b2-91af-5ead-86ad-53a74af25290" :answer/validate] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/id #uuid "3865e8e6-fa47-5660-8790-ee947653c12c"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/key "selection"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/type :answer-field.type/radio] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/choices "d3c50cbf-15a8-50fa-a40a-e9338f50a145"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/choices "878cca54-7f5d-58c4-bee3-c51799ce383a"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/choices "b7a08845-2f23-5672-a741-af3649d4cd58"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/choices "d98d84b7-87a3-5a5a-bea4-c8f35276027f"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/choices "0897b3b2-91af-5ead-86ad-53a74af25290"] [:db/add "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/correct "b7a08845-2f23-5672-a741-af3649d4cd58"] [:db/ensure "3865e8e6-fa47-5660-8790-ee947653c12c" :answer-field/validate] [:db/add "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/id #uuid "a9aa3ffa-4834-541b-babc-7d728ab4346e"] [:db/add "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n\\left(\\frac{1}{x^{2}}\\right)\\frac{\\text{d}y}{\\text{d}x}=\\frac{- 7 x - 3 y}{x}\\,.\n$$\n\nAssume $x\\ne 0$."] [:db/add "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/worked-solution "A first order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\\,,\n$$\n\nwhere $P(x)$ and $Q(x)$ do not depend on $y.$\n\nWe have\n\n$$\n\\begin{gathered}\\left(\\frac{1}{x^{2}}\\right)\\frac{\\text{d}y}{\\text{d}x}=\\frac{- 7 x - 3 y}{x} \\\\ \\frac{\\text{d}y}{\\text{d}x}=x^{2}\\left(\\frac{- 7 x - 3 y}{x}\\right) \\\\ \\frac{\\text{d}y}{\\text{d}x}=x (- 7 x - 3 y) \\\\ \\frac{\\text{d}y}{\\text{d}x}=- 7 x^{2} - 3 x y \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\underbrace{(3 x)}_{P(x)}y=\\underbrace{- 7 x^{2}}_{Q(x)} \\\\ \\frac{\\text{d}y}{\\text{d}x} + 3 x y=- 7 x^{2}\\end{gathered}\n$$\n\nNow, the equation is written in standard form with $P(x)=3 x$ and $Q(x)=- 7 x^{2}.$"] [:db/add "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/difficulty :question.difficulty/easy] [:db/add "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/answer-fields "3865e8e6-fa47-5660-8790-ee947653c12c"] [:db/ensure "a9aa3ffa-4834-541b-babc-7d728ab4346e" :question/validate] [:db/add 17592186087866 :knowledge-point/questions "a9aa3ffa-4834-541b-babc-7d728ab4346e"] [:db/add "e116c84b-8db8-58f6-91a0-af61616586e4" :answer/id #uuid "e116c84b-8db8-58f6-91a0-af61616586e4"] [:db/add "e116c84b-8db8-58f6-91a0-af61616586e4" :answer/type :answer.type/math] [:db/add "e116c84b-8db8-58f6-91a0-af61616586e4" :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 3 y e^{- 5 x}=- 7 x e^{- 10 x}"] [:db/ensure "e116c84b-8db8-58f6-91a0-af61616586e4" :answer/validate] [:db/add "c02d6db2-de0e-5ab4-8c0a-4228e71dd3f4" :answer/id #uuid "c02d6db2-de0e-5ab4-8c0a-4228e71dd3f4"] [:db/add "c02d6db2-de0e-5ab4-8c0a-4228e71dd3f4" :answer/type :answer.type/math] [:db/add "c02d6db2-de0e-5ab4-8c0a-4228e71dd3f4" :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 6 y e^{- 5 x}=- 5 x e^{- 10 x}"] [:db/ensure "c02d6db2-de0e-5ab4-8c0a-4228e71dd3f4" :answer/validate] [:db/add "7f470d72-c1fb-5ec3-8493-11bf5b11a73a" :answer/id #uuid "7f470d72-c1fb-5ec3-8493-11bf5b11a73a"] [:db/add "7f470d72-c1fb-5ec3-8493-11bf5b11a73a" :answer/type :answer.type/math] [:db/add "7f470d72-c1fb-5ec3-8493-11bf5b11a73a" :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 7 y e^{- 5 x}=- 3 x e^{- 10 x}"] [:db/ensure "7f470d72-c1fb-5ec3-8493-11bf5b11a73a" :answer/validate] [:db/add "f9177a5d-58a0-52dd-bdf2-8a523a7167e3" :answer/id #uuid "f9177a5d-58a0-52dd-bdf2-8a523a7167e3"] [:db/add "f9177a5d-58a0-52dd-bdf2-8a523a7167e3" :answer/type :answer.type/math] [:db/add "f9177a5d-58a0-52dd-bdf2-8a523a7167e3" :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 8 y e^{- 5 x}=- 8 x e^{- 10 x}"] [:db/ensure "f9177a5d-58a0-52dd-bdf2-8a523a7167e3" :answer/validate] [:db/add "4810508c-2449-5b67-a5b9-d70a867e0383" :answer/id #uuid "4810508c-2449-5b67-a5b9-d70a867e0383"] [:db/add "4810508c-2449-5b67-a5b9-d70a867e0383" :answer/type :answer.type/math] [:db/add "4810508c-2449-5b67-a5b9-d70a867e0383" :answer/value "\\frac{\\text{d}y}{\\text{d}x} - 2 y e^{- 5 x}=- x e^{- 10 x}"] [:db/ensure "4810508c-2449-5b67-a5b9-d70a867e0383" :answer/validate] [:db/add "878777a7-c1ab-58a6-b992-c2ef8406bd2c" :answer-field/id #uuid "878777a7-c1ab-58a6-b992-c2ef8406bd2c"] [:db/add "878777a7-c1ab-58a6-b992-c2ef8406bd2c" :answer-field/key "selection"] [:db/add "878777a7-c1ab-58a6-b