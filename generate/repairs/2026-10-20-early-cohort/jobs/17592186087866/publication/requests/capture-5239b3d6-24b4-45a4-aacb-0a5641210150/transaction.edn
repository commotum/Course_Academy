b850da4670" :question/validate] [:db/add 17592186087866 :knowledge-point/questions "e87f0e4c-26c4-59c6-b25c-b7b850da4670"] [:db/add "generator" :question-generator/id #uuid "bd60924a-0fbb-5f5f-b527-837193d05477"] [:db/add "generator" :question-generator/script "generators/65/65cc49ddd7254ae054f5311ecc68d4ff00a26f645d155e31c4227d8471d3e8be/17592186087866.py"] [:db/add 17592186087866 :knowledge-point/question-generator "generator"] [:db/ensure 17592186087866 :knowledge-point/validate]]
