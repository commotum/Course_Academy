fa4671c2856d"] [:db/add "314fd2be-ee25-534b-9545-406ab2b9929c" :answer-field/choices "4f37d1e9-d6d5-511b-929e-5daabee10b71"] [:db/add "314fd2be-ee25-534b-9545-406ab2b9929c" :answer-field/choices "6351df06-c300-5540-806e-03612f39131f"] [:db/add "314fd2be-ee25-534b-9545-406ab2b9929c" :answer-field/choices "417aced3-cecd-5c6e-9b54-620ed0fa7d66"] [:db/add "314fd2be-ee25-534b-9545-406ab2b9929c" :answer-field/choices "87965bcd-038d-55e8-b8b1-063cfb5cbc32"] [:db/add "314fd2be-ee25-534b-9545-406ab2b9929c" :answer-field/correct "87965bcd-038d-55e8-b8b1-063cfb5cbc32"] [:db/ensure "314fd2be-ee25-534b-9545-406ab2b9929c" :answer-field/validate] [:db/add "c4f3ac65-f5aa-5829-9c88-6306ff37a902" :question/id #uuid "c4f3ac65-f5aa-5829-9c88-6306ff37a902"] [:db/add "c4f3ac65-f5aa-5829-9c88-6306ff37a902" :question/problem "Consider the vectors\n\n$$\n{c}_{1}=\\begin{bmatrix}1 \\\\ 4 \\\\ 4\\end{bmatrix},\\,{c}_{2}=\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix},\\,d=\\begin{bmatrix}-5 \\\\ -15 \\\\ -17\\end{bmatrix}.\n$$\n\nIf ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then what is ${x}_{1}+{x}_{2}?$\n."] [:db/add "c4f3ac65-f5aa-5829-9c88-6306ff37a902" :question/worked-solution "If ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d$, then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}1 \\\\ 4 \\\\ 4\\end{bmatrix}+{x}_{2}\\begin{bmatrix}2 \\\\ -1 \\\\ 1\\end{bmatrix} &=\\begin{bmatrix}-5 \\\\ -15 \\\\ -17\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1} \\\\ 4{x}_{1} \\\\ 4{x}_{1}\\end{bmatrix}+\\begin{bmatrix}2{x}_{2} \\\\ -{x}_{2} \\\\ {x}_{2}\\end{bmatrix} &=\\begin{bmatrix}-5 \\\\ -15 \\\\ -17\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{1}+2{x}_{2} \\\\ 4{x}_{1}-{x}_{2} \\\\ 4{x}_{1}+{x}_{2}\\end{bmatrix} &=\\begin{bmatrix}-5 \\\\ -15 \\\\ -17\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{2} &=-5 \\\\ 4{x}_{1}-{x}_{2} &=-15 \\\\ 4{x}_{1}+{x}_{2} &=-17\\end{aligned}\\right.\n$$\n\nAdding the second and the third equations we get\n\n$$\n\\begin{aligned}8{x}_{1} &=-32 \\\\ {x}_{1} &=-4\\end{aligned}\n$$\n\nSubstituting ${x}_{1}=-4$ into the third equation, we get\n\n$$\n\\begin{aligned}4{x}_{1}+{x}_{2} &=-17 \\\\ 4(-4)+{x}_{2} &=-17 \\\\ {x}_{2} &=-1 \\\\ {x}_{2} &=-1\\end{aligned}\n$$\n\nFinally, we substitute ${x}_{1}=-4$ and ${x}_{2}=-1$ into the first equation to get\n\n$$\n\\begin{aligned}{x}_{1}+2{x}_{2} &=-5 \\\\ (-4)+2(-1) &=-5 \\\\ -6 &=-5\\end{aligned}\n$$\n\nwhich gives a false statement.\n\nSo, the system has no solution."] [:db/add "c4f3ac65-f5aa-5829-9c88-6306ff37a902" :question/difficulty :question.difficulty/moderate] [:db/add "c4f3ac65-f5aa-5829-9c88-6306ff37a902" :question/answer-fields "314fd2be-ee25-534b-9545-406ab2b9929c"] [:db/ensure "c4f3ac65-f5aa-5829-9c88-6306ff37a902" :question/validate] [:db/add 17592186119807 :knowledge-point/questions "c4f3ac65-f5aa-5829-9c88-6306ff37a902"] [:db/add "9577515d-8125-5a94-b2f4-965d1a3c08de" :answer/id #uuid "9577515d-8125-5a94-b2f4-965d1a3c08de"] [:db/add "9577515d-8125-5a94-b2f4-965d1a3c08de" :answer/type :answer.type/math] [:db/add "9577515d-8125-5a94-b2f4-965d1a3c08de" :answer/value "12"] [:db/ensure "9577515d-8125-5a94-b2f4-965d1a3c08de" :answer/validate] [:db/add "66dff891-db73-59a6-bb1d-8da004d792e4" :answer/id #uuid "66dff891-db73-59a6-bb1d-8da004d792e4"] [:db/add "66dff891-db73-59a6-bb1d-8da004d792e4" :answer/type :answer.type/math] [:db/add "66dff891-db73-59a6-bb1d-8da004d792e4" :answer/value "7"] [:db/ensure "66dff891-db73-59a6-bb1d-8da004d792e4" :answer/validate] [:db/add "95e226f3-d08f-5664-af9c-1f72c5002c53" :answer/id #uuid "95e226f3-d08f-5664-af9c-1f72c5002c53"] [:db/add "95e226f3-d08f-5664-af9c-1f72c5002c53" :answer/type :answer.type/text] [:db/add "95e226f3-d08f-5664-af9c-1f72c5002c53" :answer/value "No solution"] [:db/ensure "95e226f3-d08f-5664-af9c-1f72c5002c53" :answer/validate] [:db/add "7c8d7203-c465-54cd-8a86-a85b87824924" :answer/id #uuid "7c8d7203-c465-54cd-8a86-a85b87824924"] [:db/add "7c8d