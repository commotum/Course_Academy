-c51e4621dcc9"] [:db/add "36c4941a-359f-5703-b0fb-263c9065b383" :answer-field/choices "fed86eaa-9594-5449-97ea-1ed3e3d20abb"] [:db/add "36c4941a-359f-5703-b0fb-263c9065b383" :answer-field/choices "14203d7c-5c1b-519d-a6d8-01ee09812ea9"] [:db/add "36c4941a-359f-5703-b0fb-263c9065b383" :answer-field/choices "5022b2c1-4ff2-51b3-aeab-4053ab5569ae"] [:db/add "36c4941a-359f-5703-b0fb-263c9065b383" :answer-field/choices "0481921c-737c-512b-9287-7a7e7cb48246"] [:db/add "36c4941a-359f-5703-b0fb-263c9065b383" :answer-field/correct "0481921c-737c-512b-9287-7a7e7cb48246"] [:db/ensure "36c4941a-359f-5703-b0fb-263c9065b383" :answer-field/validate] [:db/add "31a35ba8-70d4-56fd-99b3-1c7e27df0350" :question/id #uuid "31a35ba8-70d4-56fd-99b3-1c7e27df0350"] [:db/add "31a35ba8-70d4-56fd-99b3-1c7e27df0350" :question/problem "Consider the vectors\n\n$$\na_1=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix},\\quad a_2=\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix},\\quad a_3=\\begin{bmatrix}2 \\\\ 0 \\\\ 5\\end{bmatrix},\\quad b=\\begin{bmatrix}-2 \\\\ -1 \\\\ -4\\end{bmatrix}\n$$\n\nIf $x_1a_1+x_2a_2+x_3a_3=b,$ then what is $x_{1} + x_{2} + x_{3}?$"] [:db/add "31a35ba8-70d4-56fd-99b3-1c7e27df0350" :question/worked-solution "If $x_1a_1+x_2a_2+x_3a_3=b$, then we have\n\n$$\n\\begin{aligned}x_1\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}+x_2\\begin{bmatrix}-1 \\\\ 1 \\\\ 1\\end{bmatrix}+x_3\\begin{bmatrix}2 \\\\ 0 \\\\ 5\\end{bmatrix}&=\\begin{bmatrix}-2 \\\\ -1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} \\\\ 0 \\\\ x_{1}\\end{bmatrix}+\\begin{bmatrix}- x_{2} \\\\ x_{2} \\\\ x_{2}\\end{bmatrix}+\\begin{bmatrix}2 x_{3} \\\\ 0 \\\\ 5 x_{3}\\end{bmatrix}&=\\begin{bmatrix}-2 \\\\ -1 \\\\ -4\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} - x_{2} + 2 x_{3} \\\\ x_{2} \\\\ x_{1} + x_{2} + 5 x_{3}\\end{bmatrix}&=\\begin{bmatrix}-2 \\\\ -1 \\\\ -4\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}x_{1} - x_{2} + 2 x_{3} &=-2 \\\\ x_{2} &=-1 \\\\ x_{1} + x_{2} + 5 x_{3} &=-4\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & 2 & -2 \\\\ 0 & 1 & 0 & -1 \\\\ 1 & 1 & 5 & -4\\end{array}\\right]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M&=\\left[\\begin{array}{ccc|c}1 & -1 & 2 & -2 \\\\ 0 & 1 & 0 & -1 \\\\ 1 & 1 & 5 & -4\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 2 & -2 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 2 & 3 & -2\\end{array}\\right] && R_{3}:=R_{3}+(-1)R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 2 & -2 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 3 & 0\\end{array}\\right] && R_{3}:=R_{3}+(-2)R_{2} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 2 & -2 \\\\ 0 & 1 & 0 & -1 \\\\ 0 & 0 & 1 & 0\\end{array}\\right] && R_{3}:=\\left(\\frac{1}{3}\\right)R_{3}\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x_{1} - x_{2} + 2 x_{3} &=-2 \\\\ x_{2} &=-1 \\\\ x_{3} &=0\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $x_3=0.$ Substituting this value into the second equation, we get\n\n$$\n1x_2+(0)(0)=-1\\quad\\Rightarrow\\quad x_2=-1\n$$\n\nFinally, substituting these values into the first equation, we obtain\n\n$$\nx_1+(-1)(-1)+(2)(0)=-2\\quad\\Rightarrow\\quad x_1=-3\n$$\n\nSo, the solution of the system is $x_1=-3$, $x_2=-1$, $x_3=0$, which means\n\n$$\n-3a_1+(-1)a_2+(0)a_3=b.\n$$\n\nConsequently,\n\n$$\nx_{1} + x_{2} + x_{3}=(-3)+(-1)+(0)=-4.\n$$\n\n"] [:db/add "31a35ba8-70d4-56fd-99b3-1c7e27df0350" :question/difficulty :question.difficulty/moderate] [:db/add "31a35ba8-70d4-56fd-99b3-1c7e27df0350" :question/answer-fields "36c4941a-359f-5703-b0fb-263c9065b383"] [:db/ensure "31a35ba8-70d4-56fd-99b3-1c7e27df0350" :question/validate] [:db/add 17592186119854 :knowledge-point/questions "31a35ba8-70d4-56fd-99b3-1c7e27df0350"] [:db/add "473b0fed-1baf-5b21-8e59-e7583c7470aa" :answer/id #uuid "473b0fed-1baf-5b21-8e59-e7583c7470aa"] [:db/add "473b0fed-1baf-5b21-8e59-e7583c7470aa" :answer/type :answer.type/text] [:db/add "473b0fed-1baf-5b21-8e59-e7583c7470aa" :answer/value "No solution"] [:db/ensure "473b0fed-1baf-5b21-8e59-e7583c7470aa" :answer/validate] [:db/add "a59128fb-80fd-5aa7-aaad-a02e92b6bcc1" :answer/id #uuid "a59128fb-80fd-5aa7-aaad-a02e92b6bcc1"] [:db/add "a59128fb-80fd-5aa7-aaad-a02e92b6bcc1" :answer/type :answer.type/math] [:db/add "a59128fb-80fd-5aa7-aaad-a02e92b6bcc1" :answer/value "-8"] [:db/ensure "a59128fb-80fd-5aa7-aaad-a02e92b6bcc1" :answer/validate] [:db/add "27085e70-0921-54c4-85d2-4628ee37e871" :answer/id #uuid "27085e70-0921-54c4-85d2-4628ee37e871"] [:db/add "27085e70-0921-54c4-85d2-4628ee37e871" :answer/type :answer.type/math] [:db/add "27085e70-0921-54c4-85d2-4628ee37e871" :answer/value "-10"] [:db/ensure "27085e70-0921-54c4-85d2-4628ee37e871" :answer/validate] [:db/add "a333a6a9-cc20-5abc-aa8c-51674d9728ac" :answer/id #uuid "a333a6a9-cc20-5abc-aa8c-51674d9728ac"] [:db/add "a333a6a9-cc20-5abc-aa8c-51674d9728ac" :answer/type :answer.type/math] [:db/add "a333a6a9-cc20-5abc-aa8c-51674d9728ac" :answer/value "-7"] [:db/ensure "a333a6a9-cc20-5abc-aa8c-51674d9728ac" :answer/validate] [:db/add "6782314a-88a0-519e-a91f-9d0a9cae538e" :answer/id #uuid "6782314a-88a0-519e-a91f-9d0a9cae538e"] [:db/add "6782314a-88a0-519e-a91f-9d0a9cae538e" :answer/type :answer.type/math] [:db/add "6782314a-88a0-519e-a91f-9d0a9cae538e" :answer/value "-12"] [:db/ensure "6782314a-88a0-519e-a91f-9d0a9cae538e" :answer/validate] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/id #uuid "6ad272bb-8da8-521d-847d-0e83e30ff80e"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/key "selection"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/type :answer-field.type/radio] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/choices "473b0fed-1baf-5b21-8e59-e7583c7470aa"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/choices "a59128fb-80fd-5aa7-aaad-a02e92b6bcc1"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/choices "27085e70-0921-54c4-85d2-4628ee37e871"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/choices "a333a6a9-cc20-5abc-aa8c-51674d9728ac"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/choices "6782314a-88a0-519e-a91f-9d0a9cae538e"] [:db/add "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/correct "a333a6a9-cc20-5abc-aa8c-51674d9728ac"] [:db/ensure "6ad272bb-8da8-521d-847d-0e83e30ff80e" :answer-field/validate] [:db/add "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e" :question/id #uuid "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e"] [:db/add "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e" :question/problem "Consider the vectors\n\n$$\na_1=\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix},\\quad a_2=\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix},\\quad a_3=\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix},\\quad b=\\begin{bmatrix}-3 \\\\ 4 \\\\ 6\\end{bmatrix}\n$$\n\nIf $x_1a_1+x_2a_2+x_3a_3=b,$ then what is $x_{1} + x_{2} + x_{3}?$"] [:db/add "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e" :question/worked-solution "If $x_1a_1+x_2a_2+x_3a_3=b$, then we have\n\n$$\n\\begin{aligned}x_1\\begin{bmatrix}1 \\\\ 0 \\\\ 2\\end{bmatrix}+x_2\\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}+x_3\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}&=\\begin{bmatrix}-3 \\\\ 4 \\\\ 6\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} \\\\ 0 \\\\ 2 x_{1}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ x_{2} \\\\ - x_{2}\\end{bmatrix}+\\begin{bmatrix}x_{3} \\\\ - 2 x_{3} \\\\ 0\\end{bmatrix}&=\\begin{bmatrix}-3 \\\\ 4 \\\\ 6\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} + x_{3} \\\\ x_{2} - 2 x_{3} \\\\ 2 x_{1} - x_{2}\\end{bmatrix}&=\\begin{bmatrix}-3 \\\\ 4 \\\\ 6\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}x_{1} + x_{3} &=-3 \\\\ x_{2} - 2 x_{3} &=4 \\\\ 2 x_{1} - x_{2} &=6\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & -3 \\\\ 0 & 1 & -2 & 4 \\\\ 2 & -1 & 0 & 6\\end{array}\\right]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M&=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & -3 \\\\ 0 & 1 & -2 & 4 \\\\ 2 & -1 & 0 & 6\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 1 & -3 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & -1 & -2 & 12\\end{array}\\right] && R_{3}:=R_{3}+(-2)R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 1 & -3 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & -4 & 16\\end{array}\\right] && R_{3}:=R_{3}+(1)R_{2} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 1 & -3 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 1 & -4\\end{array}\\right] && R_{3}:=\\left(- \\frac{1}{4}\\right)R_{3}\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x_{1} + x_{3} &=-3 \\\\ x_{2} - 2 x_{3} &=4 \\\\ x_{3} &=-4\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $x_3=-4.$ Substituting this value into the second equation, we get\n\n$$\n1x_2+(-2)(-4)=4\\quad\\Rightarrow\\quad x_2=-4\n$$\n\nFinally, substituting these values into the first equation, we obtain\n\n$$\nx_1+(0)(-4)+(1)(-4)=-3\\quad\\Rightarrow\\quad x_1=1\n$$\n\nSo, the solution of the system is $x_1=1$, $x_2=-4$, $x_3=-4$, which means\n\n$$\n1a_1+(-4)a_2+(-4)a_3=b.\n$$\n\nConsequently,\n\n$$\nx_{1} + x_{2} + x_{3}=(1)+(-4)+(-4)=-7.\n$$\n\n"] [:db/add "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e" :question/difficulty :question.difficulty/moderate] [:db/add "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e" :question/answer-fields "6ad272bb-8da8-521d-847d-0e83e30ff80e"] [:db/ensure "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e" :question/validate] [:db/add 17592186119854 :knowledge-point/questions "4812b027-a24c-5d1f-aaeb-b5ef962ecb5e"] [:db/add "d77ad7b5-901d-5523-9f2f-306a8c425f04" :answer/id #uuid "d77ad7b5-901d-5523-9f2f-306a8c425f04"] [:db/add "d77ad7b5-901d-5523-9f2f-306a8c4