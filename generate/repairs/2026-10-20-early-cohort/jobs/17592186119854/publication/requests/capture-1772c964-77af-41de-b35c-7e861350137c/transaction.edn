99b124cf" :answer-field/choices "1c48c943-fba7-5b25-a278-0c2fba2a8b98"] [:db/add "444e2302-60e7-53c5-9812-499b99b124cf" :answer-field/choices "7ef92015-0f8a-5cc1-8bcb-6b3de588b866"] [:db/add "444e2302-60e7-53c5-9812-499b99b124cf" :answer-field/choices "bec23894-6e76-568c-bb56-0bc2a4971e38"] [:db/add "444e2302-60e7-53c5-9812-499b99b124cf" :answer-field/correct "d77ad7b5-901d-5523-9f2f-306a8c425f04"] [:db/ensure "444e2302-60e7-53c5-9812-499b99b124cf" :answer-field/validate] [:db/add "12013e4b-0191-5e66-95f1-55d982cbb9e2" :question/id #uuid "12013e4b-0191-5e66-95f1-55d982cbb9e2"] [:db/add "12013e4b-0191-5e66-95f1-55d982cbb9e2" :question/problem "Consider the vectors\n\n$$\na_1=\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix},\\quad a_2=\\begin{bmatrix}-3 \\\\ -8 \\\\ 6\\end{bmatrix},\\quad a_3=\\begin{bmatrix}2 \\\\ 5 \\\\ -3\\end{bmatrix},\\quad b=\\begin{bmatrix}-4 \\\\ -10 \\\\ 8\\end{bmatrix}\n$$\n\nIf $x_1a_1+x_2a_2+x_3a_3=b,$ then what is $x_{1} + x_{2} + x_{3}?$"] [:db/add "12013e4b-0191-5e66-95f1-55d982cbb9e2" :question/worked-solution "If $x_1a_1+x_2a_2+x_3a_3=b$, then we have\n\n$$\n\\begin{aligned}x_1\\begin{bmatrix}1 \\\\ 3 \\\\ -2\\end{bmatrix}+x_2\\begin{bmatrix}-3 \\\\ -8 \\\\ 6\\end{bmatrix}+x_3\\begin{bmatrix}2 \\\\ 5 \\\\ -3\\end{bmatrix}&=\\begin{bmatrix}-4 \\\\ -10 \\\\ 8\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} \\\\ 3 x_{1} \\\\ - 2 x_{1}\\end{bmatrix}+\\begin{bmatrix}- 3 x_{2} \\\\ - 8 x_{2} \\\\ 6 x_{2}\\end{bmatrix}+\\begin{bmatrix}2 x_{3} \\\\ 5 x_{3} \\\\ - 3 x_{3}\\end{bmatrix}&=\\begin{bmatrix}-4 \\\\ -10 \\\\ 8\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} - 3 x_{2} + 2 x_{3} \\\\ 3 x_{1} - 8 x_{2} + 5 x_{3} \\\\ - 2 x_{1} + 6 x_{2} - 3 x_{3}\\end{bmatrix}&=\\begin{bmatrix}-4 \\\\ -10 \\\\ 8\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}x_{1} - 3 x_{2} + 2 x_{3} &=-4 \\\\ 3 x_{1} - 8 x_{2} + 5 x_{3} &=-10 \\\\ - 2 x_{1} + 6 x_{2} - 3 x_{3} &=8\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -4 \\\\ 3 & -8 & 5 & -10 \\\\ -2 & 6 & -3 & 8\\end{array}\\right]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M&=\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -4 \\\\ 3 & -8 & 5 & -10 \\\\ -2 & 6 & -3 & 8\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -3 & 2 & -4 \\\\ 0 & 1 & -1 & 2 \\\\ -2 & 6 & -3 & 8\\end{array}\\right] && R_{2}:=R_{2}+(-3)R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -3 & 2 & -4 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & 0\\end{array}\\right] && R_{3}:=R_{3}+(2)R_{1}\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x_{1} - 3 x_{2} + 2 x_{3} &=-4 \\\\ x_{2} - x_{3} &=2 \\\\ x_{3} &=0\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $x_3=0.$ Substituting this value into the second equation, we get\n\n$$\n1x_2+(-1)(0)=2\\quad\\Rightarrow\\quad x_2=2\n$$\n\nFinally, substituting these values into the first equation, we obtain\n\n$$\nx_1+(-3)(2)+(2)(0)=-4\\quad\\Rightarrow\\quad x_1=2\n$$\n\nSo, the solution of the system is $x_1=2$, $x_2=2$, $x_3=0$, which means\n\n$$\n2a_1+(2)a_2+(0)a_3=b.\n$$\n\nConsequently,\n\n$$\nx_{1} + x_{2} + x_{3}=(2)+(2)+(0)=4.\n$$\n\n"] [:db/add "12013e4b-0191-5e66-95f1-55d982cbb9e2" :question/difficulty :question.difficulty/moderate] [:db/add "12013e4b-0191-5e66-95f1-55d982cbb9e2" :question/answer-fields "444e2302-60e7-53c5-9812-499b99b124cf"] [:db/ensure "12013e4b-0191-5e66-95f1-55d982cbb9e2" :question/validate] [:db/add 17592186119854 :knowledge-point/questions "12013e4b-0191-5e66-95f1-55d982cbb9e2"] [:db/add "acecb867-93ec-5a33-b47e-b1744d7aa73b" :answer/id #uuid "acecb867-93ec-5a33-b47e-b1744d7aa73b"] [:db/add "acecb867-93ec-5a33-b47e-b1744d7aa73b" :answer/type :answer.type/math] [:db/add "acecb867-93ec-5a33-b47e-b1744d7aa73b" :answer/value "9"] [:db/ensure "acecb867-93ec-5a33-b