b0-5ce9-9e7b-4518d00bd4f9" :answer-field/choices "225cb7ae-802c-53b3-874f-adfcf2c89545"] [:db/add "f1a678d7-68b0-5ce9-9e7b-4518d00bd4f9" :answer-field/choices "7860edbf-5a69-5a5a-94cb-322b35426715"] [:db/add "f1a678d7-68b0-5ce9-9e7b-4518d00bd4f9" :answer-field/choices "6ae87310-261b-52d6-824c-4b7bd87268b3"] [:db/add "f1a678d7-68b0-5ce9-9e7b-4518d00bd4f9" :answer-field/correct "6ae87310-261b-52d6-824c-4b7bd87268b3"] [:db/ensure "f1a678d7-68b0-5ce9-9e7b-4518d00bd4f9" :answer-field/validate] [:db/add "147eac2c-3a83-52e6-bae8-a772d5a224e2" :question/id #uuid "147eac2c-3a83-52e6-bae8-a772d5a224e2"] [:db/add "147eac2c-3a83-52e6-bae8-a772d5a224e2" :question/problem "Consider the vectors\n\n$$\na_1=\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix},\\quad a_2=\\begin{bmatrix}-1 \\\\ 5 \\\\ 2\\end{bmatrix},\\quad a_3=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix},\\quad b=\\begin{bmatrix}0 \\\\ 29 \\\\ 25\\end{bmatrix}\n$$\n\nIf $x_1a_1+x_2a_2+x_3a_3=b,$ then what is $x_{1} + x_{2} + x_{3}?$"] [:db/add "147eac2c-3a83-52e6-bae8-a772d5a224e2" :question/worked-solution "If $x_1a_1+x_2a_2+x_3a_3=b$, then we have\n\n$$\n\\begin{aligned}x_1\\begin{bmatrix}1 \\\\ 0 \\\\ 3\\end{bmatrix}+x_2\\begin{bmatrix}-1 \\\\ 5 \\\\ 2\\end{bmatrix}+x_3\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}&=\\begin{bmatrix}0 \\\\ 29 \\\\ 25\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} \\\\ 0 \\\\ 3 x_{1}\\end{bmatrix}+\\begin{bmatrix}- x_{2} \\\\ 5 x_{2} \\\\ 2 x_{2}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ x_{3} \\\\ 0\\end{bmatrix}&=\\begin{bmatrix}0 \\\\ 29 \\\\ 25\\end{bmatrix} \\\\ \\begin{bmatrix}x_{1} - x_{2} \\\\ 5 x_{2} + x_{3} \\\\ 3 x_{1} + 2 x_{2}\\end{bmatrix}&=\\begin{bmatrix}0 \\\\ 29 \\\\ 25\\end{bmatrix}\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}x_{1} - x_{2} &=0 \\\\ 5 x_{2} + x_{3} &=29 \\\\ 3 x_{1} + 2 x_{2} &=25\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 0 \\\\ 0 & 5 & 1 & 29 \\\\ 3 & 2 & 0 & 25\\end{array}\\right]\n$$\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M&=\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 0 \\\\ 0 & 5 & 1 & 29 \\\\ 3 & 2 & 0 & 25\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 0 & 0 \\\\ 0 & 5 & 1 & 29 \\\\ 0 & 5 & 0 & 25\\end{array}\\right] && R_{3}:=R_{3}+(-3)R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 0 & 0 \\\\ 0 & 5 & 1 & 29 \\\\ 0 & 0 & -1 & -4\\end{array}\\right] && R_{3}:=R_{3}+(-1)R_{2} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 0 & 0 \\\\ 0 & 1 & \\frac{1}{5} & \\frac{29}{5} \\\\ 0 & 0 & -1 & -4\\end{array}\\right] && R_{2}:=\\left(\\frac{1}{5}\\right)R_{2} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -1 & 0 & 0 \\\\ 0 & 1 & \\frac{1}{5} & \\frac{29}{5} \\\\ 0 & 0 & 1 & 4\\end{array}\\right] && R_{3}:=(-1)R_{3}\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\left\\{\\begin{aligned}x_{1} - x_{2} &=0 \\\\ x_{2} + \\frac{x_{3}}{5} &=\\frac{29}{5} \\\\ x_{3} &=4\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $x_3=4.$ Substituting this value into the second equation, we get\n\n$$\n1x_2+\\left(\\frac{1}{5}\\right)(4)=\\frac{29}{5}\\quad\\Rightarrow\\quad x_2=5\n$$\n\nFinally, substituting these values into the first equation, we obtain\n\n$$\nx_1+(-1)(5)+(0)(4)=0\\quad\\Rightarrow\\quad x_1=5\n$$\n\nSo, the solution of the system is $x_1=5$, $x_2=5$, $x_3=4$, which means\n\n$$\n5a_1+(5)a_2+(4)a_3=b.\n$$\n\nConsequently,\n\n$$\nx_{1} + x_{2} + x_{3}=(5)+(5)+(4)=14.\n$$\n\n"] [:db/add "147eac2c-3a83-52e6-bae8-a772d5a224e2" :question/difficulty :question.difficulty/moderate] [:db/add "147eac2c-3a83-52e6-bae8-a772d5a224e2" :question/answer-fields "f1a678d7-68b0-5ce9-9e7b-4518d00bd4f9"] [:db/ensure "147eac2c-3a83-52e6-bae8-a772d5a224e2" :question/validate] [:db/add 17592186119854 :knowledge-point/questions "147eac2c-3a83-52e6-bae8-a772d5a224e2"] [:db/