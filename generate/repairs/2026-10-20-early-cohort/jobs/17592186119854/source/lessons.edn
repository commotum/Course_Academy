#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186120672} :activity/id #uuid "6ede3e68-1ff6-5e3c-afed-499bb387f9a1" :activity/scope {:db/id #edb/ref 17592186048499} :activity/steps [{:db/id #edb/ref 17592186120672 :step/content {:db/id #edb/ref 17592186121034 :tutorial/content "Consider a vector $\\mathbf{u}$ which is given in terms of the vectors $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n{\\color{red}3}{\\color{blue}\\mathbf{v_1}}+({\\color{red}-2}){\\color{blue}\\mathbf{v_2}} = \\mathbf{u}\n$$\n\nHere, we say that $\\mathbf{u}$ is a **linear combination** of the vectors ${\\color{blue}\\mathbf{v_1}}$ and ${\\color{blue}\\mathbf{v_2}}$ with coefficients ${\\color{red}3}$ and ${\\color{red}-2}$ respectively. \n\nIn general, a linear combination of $n$ vectors $\\mathbf{v_1},\\mathbf{v_2},\\dots,\\mathbf{v_n}$ is the *weighted sum*\n\n$$\n{\\color{red}x_1}\\mathbf{\\color{blue}v_1}+{\\color{red}x_2}\\mathbf{\\color{blue}v_2}+\\cdots + {\\color{red}x_n}\\mathbf{\\color{blue}v_n} = \\mathbf{u},\n$$\n\nwhere ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n}\\in\\mathbb{R}.$ We say that $\\mathbf{u}$ is a linear combination of the vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\dots,\\mathbf{\\color{blue}v_n}$ with coefficients (or *weights*) ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n},$ respectively.\n\nFor instance, \n\n\n$$\n{\\color{red}2} \\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_1} + {\\color{red}0} \\cdot \\underbrace{\\begin{bmatrix}\\sqrt{2} \\\\ 3\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_2} + {\\color{red}\\dfrac{1}{2}} \\cdot \\underbrace{\\begin{bmatrix}8 \\\\ 0\\end{bmatrix}}_{\\large\\color{blue}\\mathbf{v}_3}\n$$\n\n\nis the linear combination of vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\mathbf{\\color{blue}v_3}$ with coefficients ${\\color{red}2}, {\\color{red}0}, {\\color{red}\\dfrac{1}{2}},$ respectively." :tutorial/id #uuid "229ae855-226b-5f95-b050-b98257747800" :tutorial/math-academy-id 3186 :tutorial/title "Introduction"} :step/id #uuid "b14c637b-1418-59f5-9ac3-37a07d6ad580" :step/math-academy-id 17456 :step/next {:db/id #edb/ref 17592186120673}} {:db/id #edb/ref 17592186120673 :step/content {:db/id #edb/ref 17592186119805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119616 :question/id #uuid "fd3cb5b1-f16e-5a52-82e4-25bbbd1c4fe7" :question/math-academy-id "e-4789" :question/problem "Find $s,$ if $3\\mathbf{a_1}+s\\mathbf{a_2} = \\mathbf{b}$ and\n\n\n$$\n\\mathbf{a_1}=\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix}, \\quad \\mathbf{a_2}=\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix}, \\quad \\mathbf{b}=\\begin{bmatrix}13 \\\\ 6 \\\\ -5\\end{bmatrix}.\n$$\n\n" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $s$ term, we get\n\n$$\n\\begin{aligned}3{a}_{1}+s{a}_{2} & =b \\\\ 3\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix}+s\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}13 \\\\ 6 \\\\ -5\\end{bmatrix} \\\\ s\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}13 \\\\ 6 \\\\ -5\\end{bmatrix}-3\\begin{bmatrix}-1 \\\\ 2 \\\\ 1\\end{bmatrix} \\\\ s\\begin{bmatrix}4 \\\\ 0 \\\\ -2\\end{bmatrix} & =\\begin{bmatrix}16 \\\\ 0 \\\\ -8\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $s=4.$"} :knowledge-point/id #uuid "33586620-e110-5a37-874f-a92103c5e9fb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049814}] :knowledge-point/question-generator {:db/id #edb/ref 17592186672911} :knowledge-point/questions [{:db/id #edb/ref 17592186120311} {:db/id #edb/ref 17592186120312} {:db/id #edb/ref 17592186240984} {:db/id #edb/ref 17592186240985} {:db/id #edb/ref 17592186314967} {:db/id #edb/ref 17592186317257} {:db/id #edb/ref 17592186319044} {:db/id #edb/ref 17592186319045} {:db/id #edb/ref 17592186319047} {:db/id #edb/ref 17592186419107} {:db/id #edb/ref 17592186542353} {:db/id #edb/ref 17592186542366} {:db/id #edb/ref 17592186562406} {:db/id #edb/ref 17592186562438} {:db/id #edb/ref 17592186562512} {:db/id #edb/ref 17592186672884} {:db/id #edb/ref 17592186672895} {:db/id #edb/ref 17592186672900} {:db/id #edb/ref 17592186672906} {:db/id #edb/ref 17592186672910}] :knowledge-point/title "Solving for One Coefficient in a Linear Combination"} :step/id #uuid "c7323a52-d0b1-55ea-81f4-41623766b9db" :step/math-academy-id 17458 :step/next {:db/id #edb/ref 17592186120674}} {:db/id #edb/ref 17592186120674 :step/content {:db/id #edb/ref 17592186119806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119617 :question/id #uuid "548ef945-392b-5e75-9b60-14f4e2de6261" :question/math-academy-id "e-4790" :question/problem "Find $\\mathbf{x},$ if $\\mathbf{a}+2\\mathbf{x} = \\mathbf{b}$ and\n\n\n$$\n\\mathbf{a}=\\begin{bmatrix}12 \\\\ -11 \\\\ -5\\end{bmatrix}, \\quad \\mathbf{b}=\\begin{bmatrix}24 \\\\ -9 \\\\ 13\\end{bmatrix}.\n$$\n\n" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $\\mathbf{x},$ we get\n\n$$\n\\begin{aligned}a+2x & =b \\\\ 2x & =b-a \\\\ x & =\\frac{1}{2}(b-a) \\\\ x & =\\frac{1}{2}(\\begin{bmatrix}24 \\\\ -9 \\\\ 13\\end{bmatrix}-\\begin{bmatrix}12 \\\\ -11 \\\\ -5\\end{bmatrix}) \\\\ x & =\\frac{1}{2}\\begin{bmatrix}12 \\\\ 2 \\\\ 18\\end{bmatrix} \\\\ x & =\\begin{bmatrix}6 \\\\ 1 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/question-generator {:db/id #edb/ref 17592186518762} :knowledge-point/questions [{:db/id #edb/ref 17592186120310} {:db/id #edb/ref 17592186120351} {:db/id #edb/ref 17592186240986} {:db/id #edb/ref 17592186240987} {:db/id #edb/ref 17592186240988} {:db/id #edb/ref 17592186314969} {:db/id #edb/ref 17592186319046} {:db/id #edb/ref 17592186342110} {:db/id #edb/ref 17592186342111} {:db/id #edb/ref 17592186386134} {:db/id #edb/ref 17592186391790} {:db/id #edb/ref 17592186393376} {:db/id #edb/ref 17592186393383} {:db/id #edb/ref 17592186435824} {:db/id #edb/ref 17592186562449}] :knowledge-point/title "Solving for a Vector in a Linear Combination"} :step/id #uuid "fd939fe8-9699-5d8a-9dce-0e749d48075e" :step/math-academy-id 17460 :step/next {:db/id #edb/ref 17592186120675}} {:db/id #edb/ref 17592186120675 :step/content {:db/id #edb/ref 17592186119807 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119618 :question/id #uuid "13ebde04-8518-5837-9420-c9487debc562" :question/math-academy-id "e-4791" :question/problem "Consider the vectors\n\n\n\n$$\n\\mathbf{c_1}=\\begin{bmatrix}4 \\\\ -1 \\\\ 3\\end{bmatrix}, \\quad \\mathbf{c_2}=\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix}, \\quad \\mathbf{d}=\\begin{bmatrix}5 \\\\ -5 \\\\ 0\\end{bmatrix}.\n$$\n\n\n\nIf $x_1 \\mathbf{c}_1 + x_2\\mathbf{c}_2  = \\mathbf d,$ then what is $x_1+x_2?$" :question/worked-solution "If $x_1 \\mathbf{c}_1 + x_2\\mathbf{c}_2  = \\mathbf d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}4 \\\\ -1 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -5 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}4{x}_{1}+{x}_{2} \\\\ -{x}_{1} \\\\ 3{x}_{1}+{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ -5 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}4{x}_{1}+{x}_{2} &=5 \\\\ -{x}_{1} &=-5 \\\\ 3{x}_{1}+{x}_{2} &=0\\end{aligned}\\right.\n$$\n\nFrom the second equation, we obtain $x_1=5,$ which we substitute into the first equation to get \n\n$$\n\\begin{aligned}4{x}_{1}+{x}_{2} & =5 \\\\ 4(5)+{x}_{2} & =5 \\\\ {x}_{2} & =-15.\\end{aligned}\n$$\n\nFinally, we substitute $x_1=5$ and $x_2=-15$ into the third equation to get\n\n$$\n\\begin{aligned}3{x}_{1}+{x}_{2} & =0 \\\\ 3(5)+(-15) & =0 \\\\ 0 & =0,\\end{aligned}\n$$\n\nwhich gives a true statement. \n\nSo the solution of the system is $x_1=5$ and $x_2=-15,$ which means\n\n$$\n5 \\mathbf{c_1}-15 \\mathbf{c_2} = \\mathbf{d}.\n$$\n\nConsequently,\n\n$$\nx_1+x_2=5-15=-10.\n$$"} :knowledge-point/id #uuid "92e5e826-3121-500a-9103-e618cb16c5b2" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/question-generator {:db/id #edb/ref 17592186672947} :knowledge-point/questions [{:db/id #edb/ref 17592186120293} {:db/id #edb/ref 17592186120350} {:db/id #edb/ref 17592186240990} {:db/id #edb/ref 17592186240991} {:db/id #edb/ref 17592186317259} {:db/id #edb/ref 17592186342116} {:db/id #edb/ref 17592186342117} {:db/id #edb/ref 17592186342118} {:db/id #edb/ref 17592186342123} {:db/id #edb/ref 17592186435825} {:db/id #edb/ref 17592186562514} {:db/id #edb/ref 17592186573888} {:db/id #edb/ref 17592186643114} {:db/id #edb/ref 17592186643126} {:db/id #edb/ref 17592186672929} {:db/id #edb/ref 17592186672930} {:db/id #edb/ref 17592186672933} {:db/id #edb/ref 17592186672939} {:db/id #edb/ref 17592186672942}] :knowledge-point/title "Solving for Two Coefficients in a Linear Combination"} :step/id #uuid "fd740ffd-227c-5f9c-9418-4c54bf1616ff" :step/math-academy-id 17464 :step/next {:db/id #edb/ref 17592186120748}} {:db/id #edb/ref 17592186120748 :step/content {:db/id #edb/ref 17592186119854 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119669 :question/id #uuid "d9beff9d-db58-540f-811e-a07fb77d3d92" :question/math-academy-id "e-6191" :question/problem "Consider the vectors\n\n\n\n$$\n\\mathbf{a_1}=\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}, \\quad \\mathbf{a_2}=\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}, \\quad \\mathbf{a_3}=\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix}, \\quad \\mathbf{b}=\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix}.\n$$\n\n\n\nIf $x_1 \\mathbf{a}_1 + x_2\\mathbf{a}_2 + x_3\\mathbf{a}_3 = \\mathbf b,$ then what is $x_1+x_2+x_3?$" :question/worked-solution "Since $\\mathbf{b}$ is a linear combination of vectors $\\mathbf{a_1}, \\,\\mathbf{a_2}$ and $\\mathbf{a_3}$ with coefficients $x_1,\\, x_2$ and $x_3,$ respectively, we have\n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}+{x}_{3}\\begin{bmatrix}1 \\\\ 2 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}0 \\\\ {x}_{1} \\\\ 0\\end{bmatrix}+\\begin{bmatrix}{x}_{2} \\\\ 0 \\\\ -{x}_{2}\\end{bmatrix}+\\begin{bmatrix}{x}_{3} \\\\ 2{x}_{3} \\\\ 3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix} \\\\ \\begin{bmatrix}{x}_{2}+{x}_{3} \\\\ {x}_{1}+2{x}_{3} \\\\ -{x}_{2}+3{x}_{3}\\end{bmatrix} & =\\begin{bmatrix}1 \\\\ 1 \\\\ 7\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\left\\{\\begin{aligned}{x}_{2}+{x}_{3} &=1 \\\\ {x}_{1}+2{x}_{3} &=1 \\\\ -{x}_{2}+3{x}_{3} &=7\\end{aligned}\\right.\n$$\n\nWe will solve this system using Gaussian elimination. First, we write the augmented matrix for this system:\n\n\n\n$$\nM= \\left[ \\begin{array}{ccc|c}0 & 1 & 1 & 1 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & -1 & 3 & 7\\end{array} \\right]\n$$\n\n\n\nRow-reducing the augmented matrix, we get\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}0 & 1 & 1 & 1 \\\\ 1 & 0 & 2 & 1 \\\\ 0 & -1 & 3 & 7\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & -1 & 3 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 4 & 8\\end{bmatrix} & {R}_{3} & :=\\frac{1}{4}{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}.\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+2{x}_{3} &=1 \\\\ {x}_{2}+{x}_{3} &=1 \\\\ {x}_{3} &=2.\\end{aligned}\\right.\n$$\n\nFrom the third equation, we get $x_3 = 2.$ Substituting this into the second equation, we get\n\n$$\nx_2+(2) = 1 \\quad\\Rightarrow\\quad x_2 = -1,\n$$\n\nand substituting $x_3=2$ into the first equation, we get\n\n$$\nx_1+2(2) = 1 \\quad\\Rightarrow\\quad x_1 = -3.\n$$\n\nSo the solution of the system is $x_1=-3, x_2=-1, x_3=2,$ which means\n\n$$\n-3 \\mathbf{a_1}- \\mathbf{a_2} +2 \\mathbf{a_3}= \\mathbf{b}.\n$$\n\nConsequently,\n\n$$\nx_1+x_2+x_3=-3-1+2=-2.\n$$"} :knowledge-point/id #uuid "13a44dc8-4699-519f-8cb1-87ad77471ebe" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049058} {:db/id #edb/ref 17592186050178}] :knowledge-point/question-generator {:db/id #edb/ref 17592186538215} :knowledge-point/questions [{:db/id #edb/ref 17592186120309} {:db/id #edb/ref 17592186120349} {:db/id #edb/ref 17592186240992} {:db/id #edb/ref 17592186240993} {:db/id #edb/ref 17592186240994} {:db/id #edb/ref 17592186240995} {:db/id #edb/ref 17592186342126} {:db/id #edb/ref 17592186342130} {:db/id #edb/ref 17592186342132} {:db/id #edb/ref 17592186342133} {:db/id #edb/ref 17592186342134} {:db/id #edb/ref 17592186342138} {:db/id #edb/ref 17592186371499} {:db/id #edb/ref 17592186573926} {:db/id #edb/ref 17592186573932}] :knowledge-point/title "Solving for Three Coefficients in a Linear Combination"} :step/id #uuid "d59e4b4d-f7e2-5722-8cf4-a309ea8ac925" :step/math-academy-id 23175}] :activity/title "Linear Combinations of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186120045}]}
