    "question": {
      ":question/id": "f358965a-8b4e-558e-aeb4-ada8bc133f14",
      ":question/problem": "A coolant reservoir in a manufacturing plant can hold up to $500\\,\\text{gal}$ of liquid. Initially, it contains $330\\,\\text{gal}$ of coolant solution with $66\\,\\text{lb}$ of dissolved corrosion inhibitor. A more concentrated coolant solution with concentration $0.8\\,\\text{lb/gal}$ flows into the reservoir at a rate of $30\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $20\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of inhibitor in the reservoir at the moment it begins to overflow.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "9fa2c51f-fe80-509d-97cc-6d9a9d8d08d1",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "4fea6573-f115-5f8a-a9de-720d8a4931ff",
              ":answer/type": ":answer.type/math",
              ":answer/value": "400.0\\,\\text{lb}"
            },
            {
              ":answer/id": "c242740d-478d-5293-9cd0-f8e51859154e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "269.3\\,\\text{lb}"
            },
            {
              ":answer/id": "7c63ef56-1205-578c-8d34-5f69694e9f36",
              ":answer/type": ":answer.type/math",
              ":answer/value": "313.8\\,\\text{lb}"
            },
            {
              ":answer/id": "68b5b043-c1fd-54db-a752-0aeaac243486",
              ":answer/type": ":answer.type/math",
              ":answer/value": "285.0\\,\\text{lb}"
            },
            {
              ":answer/id": "451cc6d5-89da-576a-ab00-254842fd1995",
              ":answer/type": ":answer.type/math",
              ":answer/value": "343.1\\,\\text{lb}"
