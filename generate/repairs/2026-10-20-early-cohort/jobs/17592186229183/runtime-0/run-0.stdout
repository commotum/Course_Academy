    "question": {
      ":question/id": "69394800-9c31-5d83-99d0-17b8b57afea0",
      ":question/problem": "A saline reservoir for a medical research lab can hold up to $287\\,\\text{gal}$ of solution. Initially, it contains $105\\,\\text{gal}$ of saline solution with $42\\,\\text{lb}$ of dissolved salt. A more concentrated saline solution with concentration $1.2\\,\\text{lb/gal}$ flows into the reservoir at a rate of $21\\,\\text{gal/min},$ while the completely mixed solution drains out at a rate of $14\\,\\text{gal/min}.$ Rounded to one decimal place, find the amount of salt in the reservoir at the moment it begins to overflow.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "0a154ba3-39ae-569f-bf78-13462ee0dbd6",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "77e38ee1-37cc-54ef-9c0f-4efa15614a48",
              ":answer/type": ":answer.type/math",
              ":answer/value": "327.5\\,\\text{lb}"
            },
            {
              ":answer/id": "0f11a508-d345-55b2-bbb3-ac8693939b4c",
              ":answer/type": ":answer.type/math",
              ":answer/value": "333.2\\,\\text{lb}"
            },
            {
              ":answer/id": "558a2b2e-7737-50eb-ad7c-ff590d7d5860",
              ":answer/type": ":answer.type/math",
              ":answer/value": "340.3\\,\\text{lb}"
            },
            {
              ":answer/id": "b6b9b6db-a29e-5054-9b22-0c14fc15f8bb",
              ":answer/type": ":answer.type/math",
