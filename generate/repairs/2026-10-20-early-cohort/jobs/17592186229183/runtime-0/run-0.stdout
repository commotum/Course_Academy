    "question": {
      ":question/id": "bcbe6037-e333-50da-82dd-5ada3aa05147",
      ":question/problem": "A nutrient tank for a hydroponic greenhouse can hold up to $680gal$ of solution. Initially, it contains $240gal$ of nutrient solution with $60lb$ of dissolved nutrient. A more concentrated solution with concentration $0.5lb/gal$ flows into the tank at a rate of $30gal/min$, while the completely mixed solution drains out at a rate of $20gal/min$. Rounded to one decimal place, find the amount of nutrient in the tank at the moment it begins to overflow.\n\n> A scientific calculator is required to answer this question.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "9b327b3f-9ce4-5f91-931d-7dde0d37c6a4",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "c1b0a611-7f4a-55db-aee4-dea469fbc3e5",
              ":answer/type": ":answer.type/math",
              ":answer/value": "325.1\\,\\text{lb}"
            },
            {
              ":answer/id": "1609106b-5ca8-56ea-bd14-947429b3fe64",
              ":answer/type": ":answer.type/math",
              ":answer/value": "340.0\\,\\text{lb}"
            },
            {
              ":answer/id": "a0ef03e5-e920-5d09-9856-f3d1cd8906ac",
              ":answer/type": ":answer.type/math",
              ":answer/value": "332.5\\,\\text{lb}"
            },
            {
              ":answer/id": "4911003f-4a87-57bd-9e43-92c6584c2daa",
              ":answer/type": ":answer.type/math",
              ":answer/value": "337.4\\,\\text{lb}"
