#{[{:db/id #edb/ref 17592186096669 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096456 :question/id #uuid "201a713a-83ca-5e31-9a4f-257795d7eb1b" :question/math-academy-id "e-4690" :question/problem "Solve the following system of equations:\n![](images/31/31969ec4b2fc35f5175b3cfd114b79b5b9ba608241aa1d9c45f1a7c37484fd21.svg)" :question/worked-solution "The third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+(2)=2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 2-2 = 0.\n$$\n\nNow, we substitute both $z=2$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(2)=3\n\t\\qquad\\Longrightarrow\\qquad\n\tx = 3-2 = 1.\n$$\n\nTherefore, the solution is $x = 1,$ $y=0,$ and $z = 2.$ Or, in vector form, the solution is $\\langle 1,0,2 \\rangle.$"} :knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826}] :knowledge-point/questions [{:db/id #edb/ref 17592186097178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "695338bb-4da1-5faf-b753-959b613daad8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{5}{2},1,\\frac{5}{2}⟩" :db/id #edb/ref 17592186285754} {:answer/id #uuid "719f80eb-51f2-50dd-8e7b-13f521243e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{2},\\frac{1}{2},2⟩" :db/id #edb/ref 17592186285832} {:answer/id #uuid "84516b49-073b-5f18-b135-9aa643836e7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\frac{3}{2},2⟩" :db/id #edb/ref 17592186286005} {:answer/id #uuid "ccd996ba-4964-5d4a-a821-ef89b01d7243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},2,-\\frac{3}{2}⟩" :db/id #edb/ref 17592186286651} {:answer/id #uuid "e407230a-178a-5f9c-b60e-0df1ecb88b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{5}{2},\\frac{5}{2},2⟩" :db/id #edb/ref 17592186286872}] :answer-field/correct {:answer/id #uuid "e407230a-178a-5f9c-b60e-0df1ecb88b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{5}{2},\\frac{5}{2},2⟩" :db/id #edb/ref 17592186286872} :answer-field/id #uuid "869e299b-3a68-5e32-b000-3d7a40178137" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287431}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2386cda0-88d9-5e63-84f4-46ef34183090" :question/math-academy-id "q-20418" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=3 \\\\ {x}_{2}-{x}_{3} &=\\frac{1}{2} \\\\ {x}_{3} &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-(2)=\\frac{1}{2}\\,⟹\\,{x}_{2}=\\frac{1}{2}+2=\\frac{5}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{5}{2}$ and ${x}_{3}=2$ into the first equation to get\n\n$$\n{x}_{1}+(\\frac{5}{2})-(2)=3\\,⟹\\,{x}_{1}=3+2-\\frac{5}{2}=\\frac{5}{2}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{5}{2}$, ${x}_{2}=\\frac{5}{2}$, and ${x}_{3}=2.$ In vector form, the solution can be written as $⟨\\frac{5}{2},\\frac{5}{2},2⟩.$"} {:db/id #edb/ref 17592186097182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8673fa34-a351-5b2b-8750-c223539ddef0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{13}{2} \\\\ -\\frac{1}{2} \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186095066} {:answer/id #uuid "8c6f8189-874f-58c6-8d6f-36986cca908e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{11}{2} \\\\ \\frac{5}{2} \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186095067} {:answer/id #uuid "eca1acee-f3b0-50a0-8ee6-9c93de4e467f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{11}{2} \\\\ -\\frac{5}{2} \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186095068} {:answer/id #uuid "fe242dc5-4ca6-5065-b9da-4c974f1b250f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{17}{2} \\\\ -\\frac{1}{2} \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186095069} {:answer/id #uuid "3e243973-1bea-5473-ba05-a5c7c46e6835" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-\\frac{15}{2} \\\\ -\\frac{1}{3} \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186095070}] :answer-field/id #uuid "325532ae-1cfd-52e0-a27c-551596f86226" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095065}] :question/id #uuid "70997ce6-220b-549c-98e9-efc6f042a03f" :question/math-academy-id "q-20451" :question/problem "Solve the following system of equations:\n$\\left\\{\\begin{aligned}x_{1} + 3x_{2} - 2x_{3} &=-5 \\\\ x_{2} - x_{3} &=\\frac{3}{2} \\\\ x_{3} &=-4\\end{aligned}\\right.$"} {:db/id #edb/ref 17592186237857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07dcf4b7-f078-5a2e-a735-3b20d8605b65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{2},1,2⟩" :db/id #edb/ref 17592186235851} {:answer/id #uuid "655a2955-9481-5b82-b696-403148efe58f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{3}{2},-1,2⟩" :db/id #edb/ref 17592186236461} {:answer/id #uuid "b88af444-ebe4-538f-b36d-7d631ef9bcbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186236998} {:answer/id #uuid "eacaf34b-cf8f-52ab-b1bd-50892fbd8315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{2},1,2⟩" :db/id #edb/ref 17592186237293} {:answer/id #uuid "ed095146-97be-5a52-a3bb-a25e4678bcb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186237311}] :answer-field/correct {:answer/id #uuid "b88af444-ebe4-538f-b36d-7d631ef9bcbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186236998} :answer-field/id #uuid "4cd55584-3d52-5dd3-a238-228e2f11f49c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbce6ae8-46c9-5589-9b0d-0bac9aaa8725" :question/math-academy-id "q-10195" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x+y+z &=\\frac{1}{2} \\\\ y+z &=1 \\\\ z &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that  $z=2.$ Substituting this into the second equation, we get \n\n$$\ny+2=1\\,⟹\\,y=1-2=-1.\n$$\n\nNow, we substitute $z=2$ and $y=-1$into the first equation to get\n\n$$\nx+(-1)+(2)=\\frac{1}{2}\\,⟹\\,x=\\frac{1}{2}-2+1=-\\frac{1}{2}.\n$$\n\nTherefore, the solution is $x=-\\frac{1}{2}$, $y=-1$, and $z=2.$ In vector form, the solution can be written as $⟨-\\frac{1}{2},-1,2⟩.$"} {:db/id #edb/ref 17592186237858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "418397a8-ca20-5208-a2bb-6066a446a213" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-3,2⟩" :db/id #edb/ref 17592186236236} {:answer/id #uuid "5eaf7d04-f51d-5c86-af6c-0fe6d7a1eb48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,2,3⟩" :db/id #edb/ref 17592186236413} {:answer/id #uuid "6fe2798b-2a68-5abc-aa64-6ed662a282a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-3,0⟩" :db/id #edb/ref 17592186236525} {:answer/id #uuid "fad59403-63cb-58ee-b950-20cb6ce4d6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,3,2⟩" :db/id #edb/ref 17592186237405} {:answer/id #uuid "fdf30cbf-422b-515c-a75e-4057b61a31c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,3,-2⟩" :db/id #edb/ref 17592186237432}] :answer-field/correct {:answer/id #uuid "5eaf7d04-f51d-5c86-af6c-0fe6d7a1eb48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,2,3⟩" :db/id #edb/ref 17592186236413} :answer-field/id #uuid "17173592-acd5-5ded-8170-20e399ecf8d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e84c628-87b9-5d74-b46c-f0558ebf65c9" :question/math-academy-id "q-10196" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3} &=1 \\\\ {x}_{2}-{x}_{3} &=-1 \\\\ {x}_{3} &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=3.$ Substitute this into the second equation to get\n\n$$\n{x}_{2}-(3)=-1\\,⟹\\,{x}_{2}=-1+3=2.\n$$\n\nNow, we substitute ${x}_{3}=3$ and ${x}_{2}=2$ into the first equation to get\n\n$$\n{x}_{1}-(2)+(3)=1\\,⟹\\,{x}_{1}=1-3+2=0.\n$$\n\nTherefore, the solution is ${x}_{1}=0$,  ${x}_{2}=2$, and ${x}_{3}=3.$ In vector form, the solution can be written as $⟨0,2,3⟩.$"} {:db/id #edb/ref 17592186237860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42b32625-e9e5-563b-839b-42adeb20be73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{11}{2},1,\\frac{1}{2}⟩" :db/id #edb/ref 17592186236242} {:answer/id #uuid "4df95115-ebe6-57f1-95ca-f41c99471efc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{9}{2},1,2⟩" :db/id #edb/ref 17592186236315} {:answer/id #uuid "5f06f67c-d421-5bdd-a544-bd3b46e1f841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{9}{2},2,\\frac{1}{2}⟩" :db/id #edb/ref 17592186236415} {:answer/id #uuid "7cbe9c28-bf2a-5e90-8453-b0d39a6514ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,\\frac{9}{2},-\\frac{1}{2}⟩" :db/id #edb/ref 17592186236596} {:answer/id #uuid "c8ade3ad-b14b-5699-bf42-c67e2fd932b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186237088}] :answer-field/correct {:answer/id #uuid "42b32625-e9e5-563b-839b-42adeb20be73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{11}{2},1,\\frac{1}{2}⟩" :db/id #edb/ref 17592186236242} :answer-field/id #uuid "8d4de894-66e9-5d27-878e-0a6e914b403a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237624}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "498c3ac6-7680-54fc-be56-c8179953d99f" :question/math-academy-id "q-10197" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=4 \\\\ y+2z &=2 \\\\ z &=\\frac{1}{2}\\end{aligned}\\right.\n$$" :question/worked-solution "he third equation states that  $z=\\frac{1}{2}.$ Substituting this into the second equation, we get\n\n$$\ny+2(\\frac{1}{2})=2\\,⟹\\,y=2-1=1.\n$$\n\nNow, we substitute $z=\\frac{1}{2}$ and $y=1$ into the first equation to get\n\n$$\nx-(1)-(\\frac{1}{2})=4\\,⟹\\,x=4+1+\\frac{1}{2}=\\frac{11}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{11}{2}$,  $y=1$, and $z=\\frac{1}{2}.$  In vector form, the solution can be written as $⟨\\frac{11}{2},1,\\frac{1}{2}⟩.$"} {:db/id #edb/ref 17592186237861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0947bcb2-124b-5a9b-8c2d-caaf1dd4d78e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨12,-3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186235859} {:answer/id #uuid "4b19167d-8908-5eb5-b1b2-35217d6c79d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,-3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236299} {:answer/id #uuid "6b66fc33-4c80-5b0f-8c9f-716a423a5b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨11,3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236494} {:answer/id #uuid "ae0a4fc5-1033-5109-8969-8d7ba972a0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨9,2,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236922} {:answer/id #uuid "d095b16d-d82d-5f43-b45a-419f5d3af373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨11,3,3⟩" :db/id #edb/ref 17592186237139}] :answer-field/correct {:answer/id #uuid "6b66fc33-4c80-5b0f-8c9f-716a423a5b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨11,3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236494} :answer-field/id #uuid "be1426b6-aff3-5cb0-a4a0-23caf436597b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcc22116-bc14-5a39-b8c2-56ca9a77cd3e" :question/math-academy-id "q-10198" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+3{x}_{3} &=9 \\\\ {x}_{2}-3{x}_{3} &=2 \\\\ {x}_{3} &=\\frac{1}{3}\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that  ${x}_{3}=\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-3(\\frac{1}{3})=2\\,⟹\\,{x}_{2}=2+1=3.\n$$\n\nNow, we substitute ${x}_{3}=\\frac{1}{3}$ and ${x}_{2}=3$ into the first equation to get\n\n$$\n{x}_{1}-(3)+3(\\frac{1}{3})=9\\,⟹\\,{x}_{1}=9+3-1=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=\\frac{1}{3}.$ In vector form, the solution can be written as $⟨11,3,\\frac{1}{3}⟩.$"} {:db/id #edb/ref 17592186237863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a79906-5cb4-5bef-b514-16249233d145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,2,1⟩" :db/id #edb/ref 17592186236034} {:answer/id #uuid "41297e90-8727-58fb-b8d8-b13a27897e7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,3,-1⟩" :db/id #edb/ref 17592186236234} {:answer/id #uuid "94381ccc-fa56-5aa0-ae60-fbb397e8306f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,3,1⟩" :db/id #edb/ref 17592186236757} {:answer/id #uuid "a806f01f-bf60-51b5-8cbb-3a06ecf8e20a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,2,0⟩" :db/id #edb/ref 17592186236868} {:answer/id #uuid "b7b6597e-1433-50b9-96f9-108bb74b9d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-2,-1⟩" :db/id #edb/ref 17592186236985}] :answer-field/correct {:answer/id #uuid "94381ccc-fa56-5aa0-ae60-fbb397e8306f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,3,1⟩" :db/id #edb/ref 17592186236757} :answer-field/id #uuid "2c171bbc-c203-5bbd-9cf1-043a83a74293" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d50aa8dd-507e-51de-8c65-c56ceae864d0" :question/math-academy-id "q-10199" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=3 \\\\ y-z &=2 \\\\ z &=1\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=1.$ Substituting this into the second equation, we get\n\n$$\ny-(1)=2\\,⟹\\,y=2+1=3.\n$$\n\nNow, we substitute $z=1$ and $y=3$ into the first equation to get\n\n$$\nx-(3)-(1)=3\\,⟹\\,x=3+4=7.\n$$\n\nThus, the solution is $x=7$,  $y=3$,  and $z=1.$ In vector form, the solution can be written as $⟨7,3,1⟩.$"} {:db/id #edb/ref 17592186265729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c11278a-a1e9-521c-8e8b-63cb64cbc9b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263657} {:answer/id #uuid "53dcbf06-1cbe-5c03-8acd-dfd116927d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263724} {:answer/id #uuid "67ee26c7-aa79-54e7-bb6c-da2cbb6aa207" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,-\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263896} {:answer/id #uuid "b3ccb4f9-e91b-5c5f-8631-fab1ffd18bc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,-\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186264544} {:answer/id #uuid "f84f6f46-07f3-5a35-aae2-92b02c84f290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-\\frac{3}{2},-1⟩" :db/id #edb/ref 17592186265173}] :answer-field/correct {:answer/id #uuid "4c11278a-a1e9-521c-8e8b-63cb64cbc9b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186263657} :answer-field/id #uuid "62d7fc5b-0d95-51be-9907-cd6c773cab26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7e933dd-83fd-54e7-932e-d388f7f7060c" :question/math-academy-id "q-129447" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}+{x}_{3} &=2 \\\\ {x}_{2}+{x}_{3} &=-\\frac{1}{2} \\\\ {x}_{3} &=-1\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-1.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-1)=-\\frac{1}{2}\\,⟹\\,{x}_{2}=-\\frac{1}{2}+1=\\frac{1}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{1}{2}$ and ${x}_{3}=-1$ into the first equation to get\n\n$$\n{x}_{1}-2(\\frac{1}{2})+(-1)=2\\,⟹\\,{x}_{1}=2+1+1=4.\n$$\n\nTherefore, the solution is ${x}_{1}=4$, ${x}_{2}=\\frac{1}{2}$, and ${x}_{3}=-1.$ In vector form, the solution can be written as $⟨4,\\frac{1}{2},-1⟩.$"} {:db/id #edb/ref 17592186265730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12383fa6-1be7-5faa-98b0-50c492b27020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{15}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263173} {:answer/id #uuid "1482ccf9-247e-547f-978e-1785125b302f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{2} \\\\ \\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263191} {:answer/id #uuid "36c944a4-efa5-527c-b4b4-15c498f39d84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263486} {:answer/id #uuid "5e9ae90d-a61d-502f-a079-6171d561d548" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} \\\\ -\\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263818} {:answer/id #uuid "e5272ebd-57ab-5c9a-943c-aa4636f76330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{15}{2} \\\\ -\\frac{5}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186264993}] :answer-field/correct {:answer/id #uuid "36c944a4-efa5-527c-b4b4-15c498f39d84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186263486} :answer-field/id #uuid "7f470e8a-d3f0-56a1-9405-dc8785df05d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265468}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffbc1914-8f55-58fc-9939-7cf601faf78b" :question/math-academy-id "q-129452" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x+y-z &=2 \\\\ y-z &=\\frac{1}{2} \\\\ z &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=3.$ Substituting this into the second equation, we get\n\n$$\ny-3=\\frac{1}{2}\\,⟹\\,y=\\frac{1}{2}+3=\\frac{7}{2}.\n$$\n\nNow, we substitute $y=\\frac{7}{2}$ and $z=3$ into the first equation to get\n\n$$\nx+\\frac{7}{2}-3=2\\,⟹\\,x=2-\\frac{7}{2}+3=\\frac{3}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{3}{2}$, $y=\\frac{7}{2}$, and $z=3.$ In vector form, the solution can be written as\n$\\begin{bmatrix}\\frac{3}{2} \\\\ \\frac{7}{2} \\\\ 3\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265731 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a172890-3f87-5a80-964d-e89a1fb78934" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-4,-2⟩" :db/id #edb/ref 17592186263777} {:answer/id #uuid "d768f9e7-ff33-529d-9697-e0257e01235f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,-4,-2⟩" :db/id #edb/ref 17592186264879} {:answer/id #uuid "e4666737-b082-581c-a226-b9480b7e82c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,4,-2⟩" :db/id #edb/ref 17592186264985} {:answer/id #uuid "eac5eddd-1434-5977-8e97-e4df1980cf72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,0,-2⟩" :db/id #edb/ref 17592186265045} {:answer/id #uuid "ffdbfc12-7648-502a-bc1c-5a7448cf96b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,0,-2⟩" :db/id #edb/ref 17592186265251}] :answer-field/correct {:answer/id #uuid "e4666737-b082-581c-a226-b9480b7e82c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,4,-2⟩" :db/id #edb/ref 17592186264985} :answer-field/id #uuid "5bdc74f4-4bcc-59f6-8302-2fdbc15d6835" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265408}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3719eef8-ec9e-5d13-b3ad-dc6ee7926695" :question/math-academy-id "q-129453" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}-{x}_{3} &=4 \\\\ {x}_{2}+{x}_{3} &=2 \\\\ {x}_{3} &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-2.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-2)=2\\,⟹\\,{x}_{2}=2+2=4.\n$$\n\nNow, we substitute ${x}_{2}=4$ and ${x}_{3}=-2$ into the first equation to get\n\n$$\n{x}_{1}-4-(-2)=4\\,⟹\\,{x}_{1}=4+4-2=6.\n$$\n\nTherefore, the solution is ${x}_{1}=6$, ${x}_{2}=4$, and ${x}_{3}=-2.$ In vector form, the solution can be written as $⟨6,4,-2⟩.$"} {:db/id #edb/ref 17592186265732 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bb7eb03-f9e4-5c84-825e-4af3dc459a1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263370} {:answer/id #uuid "3267cac5-e192-561d-abb2-9c349b094047" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{3} \\\\ -1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263433} {:answer/id #uuid "379c045a-17f7-55f6-b610-cc58a5bf28a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{8}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263502} {:answer/id #uuid "39fe00c8-2263-5a88-8044-ac8d9246b900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ 0 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263517} {:answer/id #uuid "421302c0-ff7e-5cd9-98df-d7ad54cd1916" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{5}{3} \\\\ 0 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263585}] :answer-field/correct {:answer/id #uuid "2bb7eb03-f9e4-5c84-825e-4af3dc459a1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}" :db/id #edb/ref 17592186263370} :answer-field/id #uuid "abadbea5-ec63-5456-93e5-7d951e9c42cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bdb97edb-fdd8-52f8-9de8-da5dc252cf96" :question/math-academy-id "q-129455" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3} &=2 \\\\ {x}_{2}-6{x}_{3} &=3 \\\\ {x}_{3} &=-\\frac{1}{3}\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-6(-\\frac{1}{3})=3\\,⟹\\,{x}_{2}=3-2=1.\n$$\n\nNow, we substitute ${x}_{3}=-\\frac{1}{3}$ and ${x}_{2}=1$ into the first equation to get\n\n$$\n{x}_{1}+1-(-\\frac{1}{3})=2\\,⟹\\,{x}_{1}=2-1-\\frac{1}{3}=\\frac{2}{3}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{2}{3}$, ${x}_{2}=1$, and ${x}_{3}=-\\frac{1}{3}.$ In vector form, the solution can be written as\n$\\begin{bmatrix}\\frac{2}{3} \\\\ 1 \\\\ -\\frac{1}{3}\\end{bmatrix}.$"} {:db/id #edb/ref 17592186413953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1ba396-d863-536b-b63f-89da9c93622a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ -2 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413947} {:answer/id #uuid "91fdb22c-ce3c-5047-b232-a746c92c76b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413948} {:answer/id #uuid "f25b4ba1-98cc-5dc7-9732-a2c78c54931c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}7 \\\\ 0 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413949} {:answer/id #uuid "f69db92d-7316-5f7d-b669-23f831b82506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}8 \\\\ 1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413950} {:answer/id #uuid "f9dee24f-b474-52fc-80d0-88800792c747" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ -1 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186413951}] :answer-field/correct {:answer/id #uuid "91fdb22c-ce3c-5047-b232-a746c92c76b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186413948} :answer-field/id #uuid "35113197-e3aa-5c52-abd1-3a40104e5631" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e70385a-e12c-5845-86a7-e3cc76809c15" :question/math-academy-id "q-20421" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=4 \\\\ y+z &=2 \\\\ z &=3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=3.$ Substituting this into the second equation, we get  \n\n$$\ny+(3)=2\\,⟹\\,y=2-3=-1.\n$$\n\n \n\nNow, we substitute $z=3$ and $y=-1$ into the first equation to get\n\n$$\nx-(-1)-(3)=4\\,⟹\\,x=4-1+3=6.\n$$\n\n \n\nTherefore, the solution is $x=6$, $y=-1$, and $z=3.$ In vector form, the solution can be written as\n$\\begin{bmatrix}6 \\\\ -1 \\\\ 3\\end{bmatrix}.$"}] :knowledge-point/title "Solving a System of Equations Using Back Substitution"}]}
