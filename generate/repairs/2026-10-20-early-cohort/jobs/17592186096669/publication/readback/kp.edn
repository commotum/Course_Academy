$ into the first equation to get\n\n$$\n{x}_{1}-2\\left(\\frac{7}{2}\\right)-(5)=\\frac{1}{2}\\,⟹\\,{x}_{1}=\\frac{1}{2}+5+7=\\frac{25}{2}.\n$$\n\nTherefore, the solution is ${x}_{1}=\\frac{25}{2}$, ${x}_{2}=\\frac{7}{2}$, and ${x}_{3}=5.$ In vector form, the solution can be written as\n$=\\begin{bmatrix}\\frac{25}{2} \\\\ \\frac{7}{2} \\\\ 5\\end{bmatrix}.$"} {:db/id #edb/ref 17592186674016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0688e6a0-d82b-5af3-bcbe-e1d1ac6551c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -1 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186674014} {:answer/id #uuid "3990cfb0-cbff-5f72-bd38-c7fa260c7970" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 \\\\ -2 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186674025} {:answer/id #uuid "8e92af9b-5c92-5bee-8fa9-0870b452b896" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186674033} {:answer/id #uuid "95e3a4c5-3d93-5a0d-b94a-c4d9b0ec3031" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ -1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186674036} {:answer/id #uuid "b11e48ad-9933-5ab4-8de7-4ff5a9d11f86" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ -3 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186674040}] :answer-field/correct {:answer/id #uuid "8e92af9b-5c92-5bee-8fa9-0870b452b896" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 0 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186674033} :answer-field/id #uuid "c444cb95-0304-58c2-9c8e-b011a6cb6412" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674042}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "166ea0f3-064e-5e9b-9546-4a95c84c5be3" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=-1 \\\\ y+z &=-2 \\\\ z &=-2\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that $z=-2.$ Substituting this into the second equation, we get\n\n$$\ny+(-2)=-2.\n$$\n\n$$\ny=-2-(-2)=0.\n$$\n\nNow, we substitute $y=0$ and $z=-2$ into the first equation to get\n\n$$\nx-(0)-(-2)=-1.\n$$\n\n$$\nx=-1-(0)-(2)=-3.\n$$\n\nTherefore, the solution is $x=-3$, $y=0$, and $z=-2.$ In vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}-3 \\\\ 0 \\\\ -2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186674027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3851a9f2-0b5d-53dd-93d7-ca309444885e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{27}{2} \\\\ - \\frac{3}{2} \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186674023} {:answer/id #uuid "6eed8781-b826-5b49-ad6d-8dddc59fbde8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{17}{2} \\\\ - \\frac{11}{2} \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186674030} {:answer/id #uuid "7e43f1cc-a0f5-53b0-9743-3a6e0a11befe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{27}{2} \\\\ \\frac{3}{2} \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186674032} {:answer/id #uuid "d0e4363c-4a28-568b-a4bd-3a866763e340" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{7}{2} \\\\ - \\frac{5}{2} \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186674043} {:answer/id #uuid "e91c3a86-7c5b-570d-a0d0-abbaafe6b6de" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{23}{2} \\\\ \\frac{1}{2} \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186674046}] :answer-field/correct {:answer/id #uuid "7e43f1cc-a0f5-53b0-9743-3a6e0a11befe" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}- \\frac{27}{2} \\\\ \\frac{3}{2} \\\\ -3\\end{bmatrix}" :db/id #edb/ref 17592186674032} :answer-field/id #uuid "a19a8de7-aa28-5572-9f4f-30ab4d594c04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674038}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4f4e7729-4448-5202-a479-0d1795c351cb" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-2{x}_{2}-{x}_{3} &=- \\frac{27}{2} \\\\ {x}_{2}-{x}_{3} &=\\frac{9}{2} \\\\ {x}_{3} &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-3.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-(-3)=\\frac{9}{2}.\n$$\n\n$$\n{x}_{2}=\\frac{9}{2}-(3)=\\frac{3}{2}.\n$$\n\nNow, we substitute ${x}_{2}=\\frac{3}{2}$ and ${x}_{3}=-3$ into the first equation to get\n\n$$\n{x}_{1}-2(\\frac{3}{2})-(-3)=- \\frac{27}{2}.\n$$\n\n$$\n{x}_{1}=- \\frac{27}{2}-(-3)-(3)=- \\frac{27}{2}.\n$$\n\nTherefore, the solution is ${x}_{1}=- \\frac{27}{2}$, ${x}_{2}=\\frac{3}{2}$, and ${x}_{3}=-3.$ In vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}- \\frac{27}{2} \\\\ \\frac{3}{2} \\\\ -3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186674029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b22c5c4-bfad-55dc-ac70-aed391abe940" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-4,4⟩" :db/id #edb/ref 17592186674018} {:answer/id #uuid "1fc31bfc-5104-5fe3-8723-61480212f4d4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,2,0⟩" :db/id #edb/ref 17592186674019} {:answer/id #uuid "2314d12c-dcae-56ee-81ee-47aa277e102e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,2,4⟩" :db/id #edb/ref 17592186674020} {:answer/id #uuid "3876f800-9417-5f3b-8c5d-8a04a95c0c80" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2,1,5⟩" :db/id #edb/ref 17592186674024} {:answer/id #uuid "f39b5886-cee2-5de0-9d26-5d10dfeef2db" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-4,2⟩" :db/id #edb/ref 17592186674047}] :answer-field/correct {:answer/id #uuid "1b22c5c4-bfad-55dc-ac70-aed391abe940" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-4,4⟩" :db/id #edb/ref 17592186674018} :answer-field/id #uuid "92ae6fdb-be68-5393-bd84-0b3d09ce8201" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674035}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "678a7444-7b47-530a-afba-3b15ed69e474" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3} &=7 \\\\ {x}_{2}-{x}_{3} &=-8 \\\\ {x}_{3} &=4\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=4.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-(4)=-8.\n$$\n\n$$\n{x}_{2}=-8-(-4)=-4.\n$$\n\nNow, we substitute ${x}_{2}=-4$ and ${x}_{3}=4$ into the first equation to get\n\n$$\n{x}_{1}-(-4)+(4)=7.\n$$\n\n$$\n{x}_{1}=7-(4)-(4)=-1.\n$$\n\nTherefore, the solution is ${x}_{1}=-1$, ${x}_{2}=-4$, and ${x}_{3}=4.$ In vector form, the solution can be written as\n\n$$\n⟨-1,-4,4⟩.\n$$"} {:db/id #edb/ref 17592186674031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14dddab4-9127-58fe-aed6-2ade26096ff7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,1,-3⟩" :db/id #edb/ref 17592186674015} {:answer/id #uuid "2a9490d7-19f9-5a3a-a817-73b9dd1c3f5d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,1,-3⟩" :db/id #edb/ref 17592186674022} {:answer/id #uuid "a56723be-62bc-5b74-94dd-48abab18d85c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-3,-3⟩" :db/id #edb/ref 17592186674039} {:answer/id #uuid "bf4c8b3c-943e-5bb9-8c71-1b37d67d61ef" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,-3,-3⟩" :db/id #edb/ref 17592186674041} {:answer/id #uuid "de3b97dd-40a5-5108-bbea-0b08f3a75042" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,5,-3⟩" :db/id #edb/ref 17592186674045}] :answer-field/correct {:answer/id #uuid "2a9490d7-19f9-5a3a-a817-73b9dd1c3f5d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,1,-3⟩" :db/id #edb/ref 17592186674022} :answer-field/id #uuid "430bcd4d-ba17-5def-86e2-57fa8758caab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674026}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "79dbb8fb-c783-5b6f-9895-ea55f900e0bb" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}-{x}_{3} &=4 \\\\ {x}_{2}+{x}_{3} &=-2 \\\\ {x}_{3} &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-3.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-3)=-2.\n$$\n\n$$\n{x}_{2}=-2-(-3)=1.\n$$\n\nNow, we substitute ${x}_{2}=1$ and ${x}_{3}=-3$ into the first equation to get\n\n$$\n{x}_{1}-(1)-(-3)=4.\n$$\n\n$$\n{x}_{1}=4-(-1)-(3)=2.\n$$\n\nTherefore, the solution is ${x}_{1}=2$, ${x}_{2}=1$, and ${x}_{3}=-3.$ In vector form, the solution can be written as\n\n$$\n⟨2,1,-3⟩.\n$$"} {:db/id #edb/ref 17592186674044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b0bd7c1-09a5-5720-aa3f-0cad933a45a8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,-1,-3⟩" :db/id #edb/ref 17592186674017} {:answer/id #uuid "23c8c069-2771-5514-8447-703dfa3827ab" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,-5,-3⟩" :db/id #edb/ref 17592186674021} {:answer/id #uuid "65572018-68fd-5cbb-af18-1aeb63cd8492" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,-5,-3⟩" :db/id #edb/ref 17592186674028} {:answer/id #uuid "9036ab0d-837d-50f6-acd5-421276357947" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,3,-3⟩" :db/id #edb/ref 17592186674034} {:answer/id #uuid "9895daf9-f2ef-5fe1-8f2d-20b32698c544" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,-1,-3⟩" :db/id #edb/ref 17592186674037}] :answer-field/correct {:answer/id #uuid "65572018-68fd-5cbb-af18-1aeb63cd8492" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,-5,-3⟩" :db/id #edb/ref 17592186674028} :answer-field/id #uuid "f4e90e0f-4db6-57f8-9781-cc97cf571d9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674048}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d1c7badd-1fca-5018-a733-b0b166ddd5f5" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}-{x}_{3} &=16 \\\\ {x}_{2}+{x}_{3} &=-8 \\\\ {x}_{3} &=-3\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that ${x}_{3}=-3.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(-3)=-8.\n$$\n\n$$\n{x}_{2}=-8-(-3)=-5.\n$$\n\nNow, we substitute ${x}_{2}=-5$ and ${x}_{3}=-3$ into the first equation to get\n\n$$\n{x}_{1}-(-5)-(-3)=16.\n$$\n\n$$\n{x}_{1}=16-(5)-(3)=8.\n$$\n\nTherefore, the solution is ${x}_{1}=8$, ${x}_{2}=-5$, and ${x}_{3}=-3.$ In vector form, the solution can be written as\n\n$$\n⟨8,-5,-3⟩.\n$$"}] :knowledge-point/title "Solving a System of Equations Using Back Substitution"}]}
