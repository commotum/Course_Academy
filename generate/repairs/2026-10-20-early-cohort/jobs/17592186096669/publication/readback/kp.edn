#{[{:db/id #edb/ref 17592186096669 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096456 :question/id #uuid "201a713a-83ca-5e31-9a4f-257795d7eb1b" :question/math-academy-id "e-4690" :question/problem "Solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}x+y+z &=3 \\\\ y+z &=2 \\\\ z &=2\\end{aligned}\\right.\n$$\n\n" :question/worked-solution "The third equation states that $z=2.$ Substituting this into the second equation, we get\n\n$$\ny+(2)=2 \n\t\\qquad\\Longrightarrow\\qquad\n\ty = 2-2 = 0.\n$$\n\nNow, we substitute both $z=2$ and $y=0$ into the first equation to get\n\n$$\nx+(0)+(2)=3\n\t\\qquad\\Longrightarrow\\qquad\n\tx = 3-2 = 1.\n$$\n\nTherefore, the solution is $x = 1,$ $y=0,$ and $z = 2.$ Or, in vector form, the solution is $\\langle 1,0,2 \\rangle.$"} :knowledge-point/id #uuid "b8f8937b-de15-5d4c-aa77-1d45595fc7af" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048826 :topic/id #uuid "c375d3cc-e398-5a47-a69f-ddc853431752" :topic/knowledge-points [{:db/id #edb/ref 17592186073752} {:db/id #edb/ref 17592186073753}] :topic/math-academy-id 487 :topic/next [{:db/id #edb/ref 17592186048216} {:db/id #edb/ref 17592186048646} {:db/id #edb/ref 17592186048873} {:db/id #edb/ref 17592186048975} {:db/id #edb/ref 17592186048991} {:db/id #edb/ref 17592186049144} {:db/id #edb/ref 17592186049198} {:db/id #edb/ref 17592186049869} {:db/id #edb/ref 17592186050326} {:db/id #edb/ref 17592186050365} {:db/id #edb/ref 17592186050564} {:db/id #edb/ref 17592186050661} {:db/id #edb/ref 17592186050754} {:db/id #edb/ref 17592186050788} {:db/id #edb/ref 17592186050926} {:db/id #edb/ref 17592186050964} {:db/id #edb/ref 17592186050974} {:db/id #edb/ref 17592186050984} {:db/id #edb/ref 17592186051014}] :topic/title "Solving Systems of Equations by Substitution"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186674049 :question-generator/id #uuid "c0a684ad-6874-5aab-8d86-6761ed7768ce" :question-generator/script "generators/1e/1ea