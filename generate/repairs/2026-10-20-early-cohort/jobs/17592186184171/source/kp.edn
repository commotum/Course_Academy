\\,|\\,\\,{x}_{2},{x}_{3}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =4 \\\\ \\text{rank}(A) & =4-2 \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186184760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abafdde9-cae5-582c-8e9f-4abfcfbcb322" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186183170} {:answer/id #uuid "d1d831b4-ce0f-5ab0-a85d-095692b8ec9c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186183171} {:answer/id #uuid "e3aec90e-a80b-5dc9-8aa0-32459cfe2ca8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186183172} {:answer/id #uuid "ed949a79-7417-534c-9f56-fa03f1c6bc81" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186183173} {:answer/id #uuid "15b05d56-f68c-51c4-80b9-8c5988ed2e38" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186183174}] :answer-field/correct {:answer/id #uuid "ed949a79-7417-534c-9f56-fa03f1c6bc81" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186183173} :answer-field/id #uuid "45888489-94ed-541f-8e81-9c58b0bb07c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183169}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a160f7a5-3a4d-5809-8834-75195b7301e7" :question/math-academy-id "q-35433" :question/problem "Let $A$ be a $3\\times 6$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-3 \\\\ \\text{dim(Null}(A)) & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272246 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4635be5a-a6fe-56a4-8e10-c0910f4f8147" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269912} {:answer/id #uuid "576e17c2-77cc-5c9e-8c7f-5cabff8304b1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270041} {:answer/id #uuid "8f2da899-b45f-50aa-9e21-fab69ff8ebb1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270515} {:answer/id #uuid "bd9f5d43-13bc-582f-a5e7-f913ae058dca" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270942} {:answer/id #uuid "c477f438-c42e-5781-b4a7-0e3f12c0401c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271002}] :answer-field/correct {:answer/id #uuid "576e17c2-77cc-5c9e-8c7f-5cabff8304b1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270041} :answer-field/id #uuid "c5e20045-d23c-5279-aabf-98a4858337d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271871}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a8591660-5b8e-5e5d-b7c5-293cb529794e" :question/math-academy-id "q-141230" :question/problem "Let $A$ be a $5\\times 7$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3},{b}_{4}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=7,$ and since $B$ is formed by $4$ vectors, $\\text{rank}(A)=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =7 \\\\ \\text{nullity}(A) & =7-4 \\\\ \\text{dim(Null}(A)) & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "295aaa3d-02f9-502b-856c-5b79aa304483" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269642} {:answer/id #uuid "5bf9e0d1-e59a-5902-b41c-61bc06c16323" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270088} {:answer/id #uuid "a2102907-c48c-583f-b07b-cfefcb31941d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270710} {:answer/id #uuid "b85d4793-7c22-5269-b369-5e14e06b8c46" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270898} {:answer/id #uuid "be8ca00f-5f9e-5c25-9e3a-981fad762995" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270953}] :answer-field/correct {:answer/id #uuid "a2102907-c48c-583f-b07b-cfefcb31941d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270710} :answer-field/id #uuid "9e5105b9-0ef8-5a81-b1bd-983e0c7a616f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271790}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c5556444-b76f-5774-b94f-93b8f2189ca9" :question/math-academy-id "q-142486" :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\left\\{\\begin{bmatrix}{x}_{1} \\\\ {x}_{2}-{x}_{1} \\\\ {x}_{3} \\\\ {x}_{1}-{x}_{3}\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\right\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\left\\{{x}_{1}\\begin{bmatrix}1 \\\\ -1 \\\\ 0 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}0 \\\\ 0 \\\\ 1 \\\\ -1\\end{bmatrix}\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\right\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=3.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =4 \\\\ \\text{rank}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2009a374-1d2a-5ba2-ad4a-1a48347f5e96" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186269535} {:answer/id #uuid "38917204-aa38-58c1-8e36-7ab9157fb604" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186269781} {:answer/id #uuid "3bf4f2c6-2da0-56d1-945e-c8611cf17b6b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269817} {:answer/id #uuid "cf5d7214-9d8d-575e-b4ca-31a2e1ea8f35" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271087} {:answer/id #uuid "ff2483b0-86f4-51c4-a8a9-ebc036bb88de" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186271500}] :answer-field/correct {:answer/id #uuid "3bf4f2c6-2da0-56d1-945e-c8611cf17b6b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186269817} :answer-field/id #uuid "5d4dce18-e14e-53dd-b0f4-b089ee7b76ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271676}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7d182fc6-16c7-589f-980f-eb790356faa5" :question/math-academy-id "q-142487" :question/problem "Let $A$ be a $6\\times 8$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3},{b}_{4},{b}_{5}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-soluti