[{"label": "c621ad54-b70e-5c26-a7e6-994853057b17", "record": {"knowledge_point": {"db_id": 17592186184171, "id": "d562ea0c-94f3-5fe6-ba82-c651a51d0bbe", "title": "Finding the Rank or Nullity of a Matrix Given a Description of the Column or Null Space"}, "question": {":question/id": "c621ad54-b70e-5c26-a7e6-994853057b17", ":question/difficulty": ":question.difficulty/easy", ":question/problem": "Let $A$ be a $5\\times 7$ matrix. If $B=\\{{b}_{1}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$", ":question/worked-solution": "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=7,$ and since $B$ is formed by $1$ vectors, $\\text{rank}(A)=1.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 1+\\text{nullity}(A) & =7 \\\\ \\text{nullity}(A) & =7-1 \\\\ \\text{dim(Null}(A)) & =6.\\end{aligned}\n$$", ":question/answer-fields": [{":answer-field/id": "79bc96af-5c01-5b91-b379-255233c10668", ":answer-field/key": "selection", ":answer-field/type": ":answer-field.type/radio", ":answer-field/choices": [{":answer/id": "16a5c990-d5f9-55e4-8859-6e62134ac95d", ":answer/type": ":answer.type/math", ":answer/value": "0"}, {":answer/id": "7a4a2e1a-8844-579e-a709-6e238cf8c9a4", ":answer/type": ":answer.type/math", ":answer/value": "1"}, {":answer/id": "ef0153ef-3159-5673-b9b0-4d17cafa8d3d", ":answer/type": ":answer.type/math", ":answer/value": "5"}, {":answer/id": "2fafa3c3-e27d-5d04-b7f7-b3ac82aebb30", ":answer/type": ":answer.type/math", ":answer/value": "6"}, {":answer/id": "ea5c388a-ee83-5884-bd70-bd45e8ea16dc", ":answer/type": ":answer.type/math", ":answer/value": "7"}], ":answer-field/correct": [":answer/id", "2fafa3c3-e27d-5d04-b7f7-b3ac82aebb30"]}]}, "generation": {"version": "rank-nullity-description-v1", "seed": 718113666, "template": "column-basis", "profile": "dimensions", "parameters": {"m": 5, "n": 7, "k": 1}, "corre