:db/add "0537ecce-0c55-5408-8a08-1ac83ae596f3" :answer-field/correct "91bc1c9e-f662-536a-be42-a42da3ffc4fa"] [:db/ensure "0537ecce-0c55-5408-8a08-1ac83ae596f3" :answer-field/validate] [:db/add "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d" :question/id #uuid "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d"] [:db/add "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d" :question/problem "Let $A$ be a $4\\times 4$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$"] [:db/add "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-3 \\\\ \\text{dim(Null}(A)) & =1.\\end{aligned}\n$$"] [:db/add "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d" :question/difficulty :question.difficulty/easy] [:db/add "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d" :question/answer-fields "0537ecce-0c55-5408-8a08-1ac83ae596f3"] [:db/ensure "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d" :question/validate] [:db/add 17592186184171 :knowledge-point/questions "71bd3c83-e5a8-5d4f-9040-c22d8efaee0d"] [:db/add "835f6eb8-fa9e-5f98-82d7-8a0003d75e45" :answer/id #uuid "835f6eb8-fa9e-5f98-82d7-8a0003d75e45"] [:db/add "835f6eb8-fa9e-5f98-82d7-8a0003d75e45" :answer/type :answer.type/math] [:db/add "835f6eb8-fa9e-5f98-82d7-8a0003d75e45" :answer/value "5"] [:db/ensure "835f6eb8-fa9e-5f98-82d7-8a0003d75e45" :answer/validate] [:db/add "72d41f31-0e71-5ee5-bd90-e54a23a314db" :answer/id #uuid "72d41f31-0e71-5ee5-bd90-e54a23a314db"] [:db/add "72d41f31-0e71-5ee5-bd90-e54a23a314db" :answer/type :answer.type/math] [:db/add "72d41f31-0e71-5ee5-bd90-e54a23a314db" :answer/value "7"] [:db/ensure "72d41f31-0e71-5ee5-bd90-e54a23a314db" :answer/validate] [