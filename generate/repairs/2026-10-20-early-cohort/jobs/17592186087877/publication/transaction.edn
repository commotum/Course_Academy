t P(x)\\,dx} \\\\  & =e^{\\int \\left(- \\frac{5}{2}\\right)\\,dx} \\\\  & =e^{- \\frac{5 x}{2}}\\end{aligned}\n$$\n\nNow, we multiply our differential equation through by $I(x)=e^{- \\frac{5 x}{2}}$ as follows:\n\n$$\n\\begin{aligned}\\left(e^{- \\frac{5 x}{2}}\\right)\\cdot \\left(\\frac{dy}{dx}-\\left(\\frac{5}{2}\\right)\\cdot y\\right) & =\\left(e^{- \\frac{5 x}{2}}\\right)\\cdot \\left(\\cos{\\left(4 x \\right)}\\right) \\\\ \\left(e^{- \\frac{5 x}{2}}\\right)\\cdot \\frac{dy}{dx}-\\left(\\frac{5}{2}\\right)\\cdot \\left(e^{- \\frac{5 x}{2}}\\right)\\cdot y & =\\left(e^{- \\frac{5 x}{2}}\\right)\\cdot \\left(\\cos{\\left(4 x \\right)}\\right)\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x)):$\n\n$$\n\\begin{aligned}\\frac{d}{dx}\\left(y\\cdot \\left(e^{- \\frac{5 x}{2}}\\right)\\right) & =\\left(e^{- \\frac{5 x}{2}}\\right)\\cdot \\left(\\cos{\\left(4 x \\right)}\\right)\\end{aligned}\n$$"] [:db/add "34ac2e02-a12f-5cc4-8239-e8e5387b0f1f" :question/difficulty :question.difficulty/easy] [:db/add "34ac2e02-a12f-5cc4-8239-e8e5387b0f1f" :question/answer-fields "b76c9b72-cfa7-545f-8b6a-053f48007a90"] [:db/ensure "34ac2e02-a12f-5cc4-8239-e8e5387b0f1f" :question/validate] [:db/add 17592186087877 :knowledge-point/questions "34ac2e02-a12f-5cc4-8239-e8e5387b0f1f"] [:db/add "efbc24a7-fe90-5c36-873d-4a7845114573" :answer/id #uuid "efbc24a7-fe90-5c36-873d-4a7845114573"] [:db/add "efbc24a7-fe90-5c36-873d-4a7845114573" :answer/type :answer.type/math] [:db/add "efbc24a7-fe90-5c36-873d-4a7845114573" :answer/value "\\frac{d}{dx}\\left(y\\cdot \\left(e^{- 3 x}\\right)\\right)=\\left(e^{- 3 x}\\right)\\cdot \\left(e^{3 x}\\right)"] [:db/ensure "efbc24a7-fe90-5c36-873d-4a7845114573" :answer/validate] [:db/add "37fd9fa0-313a-5948-869a-7bb48ef556ca" :answer/id #uuid "37fd9fa0-313a-5948-869a-7bb48ef556ca"] [:db/add "37fd9fa0-313a-5948-869a-7bb48ef556ca" :answer/type :answer.type/math] [:db/add "37fd9fa0-313a-5948-869a-7bb48ef5