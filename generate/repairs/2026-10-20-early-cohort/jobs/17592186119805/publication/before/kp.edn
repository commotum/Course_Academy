ulty/easy} :question/id #uuid "1c4f9063-8349-57ea-b235-d134f5cba639" :question/math-academy-id "q-34572" :question/problem "Find $q$, if $2{a}_{1}+q{a}_{2}=b$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}2 \\\\ -3\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}7 \\\\ 5\\end{bmatrix},\\,b=\\begin{bmatrix}18 \\\\ 4\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $q$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+q{a}_{2} & =b \\\\ 2\\begin{bmatrix}2 \\\\ -3\\end{bmatrix}+q\\begin{bmatrix}7 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}18 \\\\ 4\\end{bmatrix} \\\\ q\\begin{bmatrix}7 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}18 \\\\ 4\\end{bmatrix}-2\\begin{bmatrix}2 \\\\ -3\\end{bmatrix} \\\\ q\\begin{bmatrix}7 \\\\ 5\\end{bmatrix} & =\\begin{bmatrix}14 \\\\ 10\\end{bmatrix}.\\end{aligned}\n$$\n\nFrom the final equation above, we can tell that $q=2.$"} {:db/id #edb/ref 17592186562438 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027b8325-bddf-5f10-927c-27e8a8d93f7f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186561588} {:answer/id #uuid "7b39a89b-9b8d-52a3-9357-588262651bee" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186561886} {:answer/id #uuid "91df5346-a42d-5fd9-a5ba-0704fb0cc455" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186561947} {:answer/id #uuid "c3245f41-6987-5e17-b6c5-0c173f25056e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186562072} {:answer/id #uuid "e217e4b1-a0b0-5f52-9881-b8ba9a5204d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186562140}] :answer-field/correct {:answer/id #uuid "7b39a89b-9b8d-52a3-9357-588262651bee" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186561886} :answer-field/id #uuid "a8913bcd-9ea3-5176-be5c-767230b5bdc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186562331}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6154ace2-6af4-581c-9596-72c7ea4a622a" :question/math-academy-id "q-105156" :question/problem "Find $t$, if $2{a}_{1}+t{a}_{2}=0$ and\n\n$$\n{a}_{1}=\\begin{bmatrix}8 \\\\ 1 \\\\ -6\\end{bmatrix},\\,{a}_{2}=\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}.\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate the $t$ term, we get\n\n$$\n\\begin{aligned}2{a}_{1}+t{a}_{2} & =0 \\\\ 2\\begin{bmatrix}8 \\\\ 1 \\\\ -6\\end{bmatrix}+t\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\ t\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0 \\\\ 0\\end{bmatrix}-2\\begin{bmatrix}8 \\\\ 1 \\\\ -6\\end{bmatrix} \\\\ t\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}-16 \\\\ -2 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the first components, we get \n\n$$\n-4t=-16\\,⟹\\,t=4.\n$$\n\nBut then \n\n$$\n\\begin{aligned}4\\begin{bmatrix}-4 \\\\ -1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}-16 \\\\ -4 \\\\ 12\\end{bmatrix}\\ne \\begin{bmatrix}-16 \\\\ -2 \\\\ 12\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, there is no $t$ such that \n $2{a}_{1}+t{a}_{2}=0.$"} {:db/id #edb/ref 17592186562512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "000e2b43-7a32-5785-9d4a-cc0099f8dbd2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186561578} {:answer/id #uuid "09a68c36-28bf-56b7-82ce-363a6cd0aec1" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186561611} {:answer/id #uuid "1609e0df-99da-5341-bdc8-02d9d8eee654" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186561648} {:answer/id #u