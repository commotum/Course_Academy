              ":answer/value": "III only"
            },
            {
              ":answer/id": "a3dd72c1-35bf-5350-bb70-f4274e2316fe",
              ":answer/type": ":answer.type/text",
              ":answer/value": "II only"
            },
            {
              ":answer/id": "2eb6a8a3-2a1f-586f-aa3b-772c41142847",
