d0" :question/difficulty :question.difficulty/easy] [:db/add "661a7058-4c65-5a30-b8f9-ac514756f5d0" :question/answer-fields "a8e3cb13-8209-58e7-a963-901f51301d74"] [:db/add "661a7058-4c65-5a30-b8f9-ac514756f5d0" :question/answer-fields "f7a03a01-df01-5196-9182-972bcfe4a9fb"] [:db/add "661a7058-4c65-5a30-b8f9-ac514756f5d0" :question/answer-fields "b6ad806b-4081-57f0-b624-6054573b3747"] [:db/add "661a7058-4c65-5a30-b8f9-ac514756f5d0" :question/answer-fields "f1b9fb8d-6125-5635-9aba-ce2be4acfd40"] [:db/add "661a7058-4c65-5a30-b8f9-ac514756f5d0" :question/answer-fields "19dd3a7c-7c14-5989-b66f-eb788c7b89d9"] [:db/ensure "661a7058-4c65-5a30-b8f9-ac514756f5d0" :question/validate] [:db/add 17592186054815 :knowledge-point/questions "661a7058-4c65-5a30-b8f9-ac514756f5d0"] [:db/add "8d148df9-1392-5595-b8f0-dec18241011b" :answer/id #uuid "8d148df9-1392-5595-b8f0-dec18241011b"] [:db/add "8d148df9-1392-5595-b8f0-dec18241011b" :answer/type :answer.type/text] [:db/add "8d148df9-1392-5595-b8f0-dec18241011b" :answer/value "III only"] [:db/ensure "8d148df9-1392-5595-b8f0-dec18241011b" :answer/validate] [:db/add "0eb925af-5e42-5331-a8c1-d1dde0f5e62b" :answer/id #uuid "0eb925af-5e42-5331-a8c1-d1dde0f5e62b"] [:db/add "0eb925af-5e42-5331-a8c1-d1dde0f5e62b" :answer/type :answer.type/text] [:db/add "0eb925af-5e42-5331-a8c1-d1dde0f5e62b" :answer/value "II and III only"] [:db/ensure "0eb925af-5e42-5331-a8c1-d1dde0f5e62b" :answer/validate] [:db/add "29ce430c-2e6a-52f0-932c-8a135d810c0d" :answer/id #uuid "29ce430c-2e6a-52f0-932c-8a135d810c0d"] [:db/add "29ce430c-2e6a-52f0-932c-8a135d810c0d" :answer/type :answer.type/text] [:db/add "29ce430c-2e6a-52f0-932c-8a135d810c0d" :answer/value "II and III and IV only"] [:db/ensure "29ce430c-2e6a-52f0-932c-8a135d810c0d" :answer/validate] [:db/add "8ae86643-947b-534f-8144-30eb9ae358fc" :answer/id #uuid "8ae86643-947b-534f-8144-30eb9ae358fc"] [:db/add "8ae86643-947b-534f-8144-30eb9ae358fc" :answer/type :answer.type/text] [:db/add "8ae86643-947b-534f-8144-30