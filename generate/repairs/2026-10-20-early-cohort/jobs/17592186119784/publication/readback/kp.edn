 & -1 & 0\\end{bmatrix}\n$$\n\n- $A$ is upper triangular: **False.** This fails because $A$ has non-zero entries below the main diagonal\n\n$$\nA=\\begin{bmatrix}7 & 0 & 0 \\\\ -2 & 0 & 0 \\\\ 0 & 1 & 1\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $A$ is lower triangular."} {:db/id #edb/ref 17592186335970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9d2a661-7d90-525c-9631-0c05ef108b03" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438454} {:answer/id #uuid "5deab4fd-cb30-5b98-a484-4483eb06b0c4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438455}] :answer-field/correct {:answer/id #uuid "a9d2a661-7d90-525c-9631-0c05ef108b03" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438454} :answer-field/id #uuid "89c02379-086d-5617-b96e-c2e3ec7d9a9b" :answer-field/key "$A$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439256} {:answer-field/choices [{:answer/id #uuid "69513619-f7d9-5728-9237-83bd49e641c5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438456} {:answer/id #uuid "ab7677e6-30d1-5eff-a3c5-95011127b77e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438457}] :answer-field/correct {:answer/id #uuid "69513619-f7d9-5728-9237-83bd49e641c5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438456} :answer-field/id #uuid "675400e7-a720-59bf-af25-ecd415319950" :answer-field/key "$A$ is lower triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439257} {:answer-field/choices [{:answer/id #uuid "63de0a7e-308e-5ca3-bfc3-0ba27b3a202e" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438458} {:answer/id #uuid "179fafc0-1ae3-5917-a9f8-eae561e2b95b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438459}] :answer-field/correct {:answer/id #uuid "179fafc0-1ae3-5917-a9f8-eae561e2b95b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438459} :answer-field/id #uuid "d0b333bd-888b-5051-81d0-d4f153ba848c" :answer-field/key "$A+{A}^{T}$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439258}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "deb97145-eaf3-5dcc-a36b-24fae2c52b5c" :question/math-academy-id "q-68754" :question/problem "Consider the matrix\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $A$ is upper triangular: **False.** This fails because $A$ has non-zero entries below the main diagonal:\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\n- $A$ is lower triangular: **False.** This fails because $A$ has non-zero entries above the main diagonal:\n\n$$\nA=\\begin{bmatrix}0 & -2 & -7 \\\\ 2 & -1 & 8 \\\\ 7 & -8 & 1\\end{bmatrix}\n$$\n\n- $A+{A}^{T}$ is upper triangular: **True.** This holds because the result of $A+{A}^{T}$ has all the entries below the main diagonal equal to zero:\n\n$$\nA+{A}^{T}=\\begin{bmatrix}0 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $A+{A}^{T}$ is upper triangular."} {:db/id #edb/ref 17592186342194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5292e9e-deab-5423-81ea-859716c87e84" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438502} {:answer/id #uuid "6e553caf-cc56-5f3d-be8a-245cca543780" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438503}] :answer-field/correct {