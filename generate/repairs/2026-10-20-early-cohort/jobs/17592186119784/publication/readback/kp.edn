-9b94-fa52ef460fa0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438307}] :answer-field/correct {:answer/id #uuid "26cce80e-998b-5997-9b94-fa52ef460fa0" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438307} :answer-field/id #uuid "f8e98b2f-07d9-5dce-aec0-dbf12be54818" :answer-field/key "${A}^{T}$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "39d12d09-6555-5993-ad4c-5e191be1b0c7" :question/math-academy-id "q-42091" :question/problem "Consider the matrix\n\n$$\nA=\\begin{bmatrix}4 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 5 & 3\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $A$ is upper triangular: **False.** This fails because $A$ has non-zero entries below the main diagonal:\n\n$$\nA=\\begin{bmatrix}4 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 5 & 3\\end{bmatrix}\n$$\n\n- $A$ is lower triangular: **True.** All the entries above the main diagonal of $A$ are zeros:\n\n$$\nA=\\begin{bmatrix}4 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 5 & 3\\end{bmatrix}\n$$\n\n- ${A}^{T}$ is upper triangular: **True.** All the entries below the main diagonal of ${A}^{T}$ are zeros:\n\n$$\n{A}^{T}=\\begin{bmatrix}4 & 2 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 3\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $A$ is lower triangular.\n- ${A}^{T}$ is upper triangular."} {:db/id #edb/ref 17592186120426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76bc55da-83d7-5857-aa45-f67452354c98" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439761} {:answer/id #uuid "04de8af5-832b-52ca-a350-f0f854ef704b" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439762}] :answer-field/correct {:answe