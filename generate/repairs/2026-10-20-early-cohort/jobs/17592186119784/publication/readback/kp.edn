answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668071}] :answer-field/correct {:answer/id #uuid "a8e2f05f-4412-5c5d-8920-4f4f8678b6e4" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668070} :answer-field/id #uuid "fe029848-52ee-5058-b382-20d29c573d7a" :answer-field/key "None of the above" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668312}] :question/id #uuid "64e75667-2ca8-5517-b38f-4bfa5cf4e995" :question/math-academy-id "q-42115" :question/problem "Consider the matrix\n\n$$\nA=\\begin{bmatrix}-3 & 1 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "$A$ is neither upper nor lower triangular because $a_{12}=1$ and $a_{21}=-1$ are both nonzero. However,\n\n$$\nA^{T}+A=\\begin{bmatrix}-6 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 10\\end{bmatrix}\n$$\n\nis diagonal, so $A^{T}+A$ is upper triangular."} {:db/id #edb/ref 17592186262616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12919bee-30a9-5706-b50b-8d68bb9ec18f" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437740} {:answer/id #uuid "bf178365-d264-5e92-b9fa-13b65028e647" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437741}] :answer-field/correct {:answer/id #uuid "bf178365-d264-5e92-b9fa-13b65028e647" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437741} :answer-field/id #uuid "4fea4c98-9183-5469-a75e-5f3f42402c15" :answer-field/key "$B$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438899} {:answer-field/choices [{:answer/id #uuid "9c11d7ef-9785-5af7-9c0c-e9bd1c6a90b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437742} {:answer/id #uuid "9223ddb4-98d2-5931-a218-a09a74ddf7ab" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437743}] :answer-field/correct {:answer/id #uuid "9c11d7ef-9785-5af7-9c0c-e9bd1c6a90b6" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437742} :answer-field/id #uuid "d0b3decd-5ac4-5039-a12b-8665619852b6" :answer-field/key "$B$ is lower triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438900} {:answer-field/choices [{:answer/id #uuid "a52ffa70-0c3f-53a1-ac44-7af5faba118b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437744} {:answer/id #uuid "cc394039-cc55-5bf1-8409-56c46c0c7d51" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437745}] :answer-field/correct {:answer/id #uuid "a52ffa70-0c3f-53a1-ac44-7af5faba118b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437744} :answer-field/id #uuid "ecc05fd9-552e-52c7-aa2c-c25a1903c6fd" :answer-field/key "$B-{B}^{T}$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438901}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d3df39a1-3dce-5051-9bb1-2a36ee3c62ca" :question/math-academy-id "q-126477" :question/problem "Consider the matrix\n\n$$\nB=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & -3 & -1 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $B$ is upper triangular: **True.** This holds because all the entries below the main diagonal equal to zero:\n\n$$\nB=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & -3 & -1 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}\n$$\n\n- $B$ is lower triangular: **False.** This fails because $B$ has non-zero entries above the main diagonal:\n\n$$\nB=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 0 & -3 & -1 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}\n$$\n\n- $B-{B}^{T}$ is upper triangular: **False.** This fails because the result of $B-{B}^{T}$ has non-zero entries below the main diagonal:\n\n$$\nB-{B}^{T}=\\begin{bmatrix}0 & 0 & 0 & 0 \\\\ 0 & 0 & -1 & 1 \\\\ 0 & 1 & 0 & 5 \\\\ 0 & -1 & -5 & 0\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $B$ is upper triangular."} {:db/id #edb/ref 17592186262617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb56e3e4-d13e-506f-b457-467943ab9482" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437746} {:answer/id #uuid "86262feb-536d-5ef8-afcc-c7b14bc45026" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437747}] :answer-field/correct {:answer/id #uuid "86262feb-536d-5ef8-afcc-c7b14bc45026" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437747} :answer-field/id #uuid "1080d492-9821-5364-8530-4c7dbd0bd3c0" :answer-field/key "$C$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438902} {:answer-field/choices [{:answer/id #uuid "0a0f61d8-2bc9-5ba5-8d56-d3b975c8bf07" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437748} {:answer/id #uuid "0e783ddd-e977-54e7-8580-da07e92b8e98" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437749}] :answer-field/correct {:answer/id #uuid "0e783ddd-e977-54e7-8580-da07e92b8e98" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437749} :answer-field/id #uuid "771187b2-e28f-5a7d-a91d-34f73489e1ad" :answer-field/key "$C$ is lower triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438903} {:answer-field/choices [{:answer/id #uuid "520ef5db-e43e-5e23-92a0-3ed7c62386b8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437750} {:answer/id #uuid "6e998b87-0e1c-59a3-830c-e099cf52d227" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437751}] :answer-field/correct {:answer/id #uuid "6e998b87-0e1c-59a3-830c-e099cf52d227" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437751} :answer-field/id #uuid "c1bcc754-87e4-5cec-9f4e-5a5e7e36cb54" :answer-field/key "${C}^{T}$ is upper triangular." :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438904}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f41ff7d0-b754-5033-a620-53eef8a376e3" :question/math-academy-id "q-126479" :question/problem "Consider the matrix\n\n$$\nC=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "Let's analyze each statement in turn.\n\n- $C$ is upper triangular: **True.** All the entries below the main diagonal of $C$ are zeros:\n\n$$\nC=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\n- $C$ is lower triangular: **True.** All the entries above the main diagonal of $C$ are zeros:\n\n$$\nC=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\n- ${C}^{T}$ is upper triangular: **True.** All the entries below the main diagonal of ${C}^{T}$ are zeros:\n\n$$\n{C}^{T}=\\begin{bmatrix}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{bmatrix}\n$$\n\nThe true statements are:\n\n- $C$ is upper triangular.\n- $C$ is lower triangular.\n- ${C}^{T}$ is upper triangular."} {:db/id #edb/ref 17592186262618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbb2fac-47b6-5bca-8490-fe78f86c36be" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437752} {:answer/id #uuid "a79d2921-bc2e-5