8-80fc-55f1-9bc7-fcff66f2138c" :answer-field/validate] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/id #uuid "f17fa087-7a1a-5de4-a036-5f759d023d70"] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/problem "Consider the matrix\n\n$$\nA=\\begin{bmatrix}-4 & 0 & 0 \\\\ -8 & 3 & 0 \\\\ 0 & -7 & -2\\end{bmatrix}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply."] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/worked-solution "- $A$ is upper triangular: **false**. The entry in row 2, column 1 is $-8\\ne 0$, below the main diagonal.\n\n$$\nA=\\begin{bmatrix}-4 & 0 & 0 \\\\ -8 & 3 & 0 \\\\ 0 & -7 & -2\\end{bmatrix}\n$$\n\n- $A$ is lower triangular: **true**. All entries above the main diagonal are zero.\n\n$$\nA=\\begin{bmatrix}-4 & 0 & 0 \\\\ -8 & 3 & 0 \\\\ 0 & -7 & -2\\end{bmatrix}\n$$\n\n- ${A}^{T}$ is upper triangular: **true**. All entries below the main diagonal are zero.\n\n$$\n{A}^{T}=\\begin{bmatrix}-4 & -8 & 0 \\\\ 0 & 3 & -7 \\\\ 0 & 0 & -2\\end{bmatrix}\n$$"] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/difficulty :question.difficulty/moderate] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/answer-fields "4b3d184b-9ce8-5780-b9d3-5608f317c342"] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/answer-fields "a2335a1e-48e5-537a-b076-b538fb589490"] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/answer-fields "bacc9f58-1e90-5499-ad3a-c9c6b2008d9b"] [:db/add "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/answer-fields "ec515bf8-80fc-55f1-9bc7-fcff66f2138c"] [:db/ensure "f17fa087-7a1a-5de4-a036-5f759d023d70" :question/validate] [:db/add 17592186119784 :knowledge-point/questions "f17fa087-7a1a-5de4-a036-5f759d023d70"] [:db/add "generator" :question-generator/id #uuid "65b656af-317b-55d4-8995-aca98cc80994"] [:db/add "generator" :question-generator/script "generators/ad/ad4ebd2df3c0852fe2516230c45e5edc6443c3e93b4ad1e7cdce495064322860/17592186119784.py"] [:db/add 175