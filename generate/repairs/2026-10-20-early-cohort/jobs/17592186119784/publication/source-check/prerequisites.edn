#{[{:db/id #edb/ref 17592186050727 :topic/difficulty 1.0 :topic/id #uuid "6197c039-5830-56a2-b171-eac0f7516ad1" :topic/knowledge-points [{:db/id #edb/ref 17592186059743 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059552 :question/id #uuid "e3d1f202-a3d6-561f-bd4b-3e886142e5a0" :question/math-academy-id "e-4386" :question/problem "Find $C^T,$ if \n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$C =\\begin{bmatrix}-1 & 1 \\\\ 0 & 2 \\\\ -2 & -3\\end{bmatrix}$</div>\n</div>" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n\n\n$$\nC^T =\n\t\\begin{bmatrix}-1 & 0 & -2 \\\\ 1 & 2 & -3\\end{bmatrix}\n$$"} :knowledge-point/id #uuid "57187716-c00b-5428-a83a-18836d6b3d04" :knowledge-point/title "Finding the Transpose of a Matrix"} {:db/id #edb/ref 17592186059744 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059553 :question/id #uuid "c8ca81da-04d3-532f-94f4-5f43703c7216" :question/math-academy-id "e-4387" :question/problem "If\n    \n\n$$\n{A} = \n    \\begin{bmatrix}\n        5 & -1 & 0  \\end{bmatrix},\n$$\n\nthen what is ${A^T} ?$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{A}^T = \n    \t\t\\begin{bmatrix}\n    5  \\\\\n    -1  \\\\\n    0  \\end{bmatrix}\n$$"} :knowledge-point/id #uuid "4cf627a0-6921-58ee-91c0-2f225d425711" :knowledge-point/title "Finding the Transpose of a Row Vector or Column Vector"} {:db/id #edb/ref 17592186059745 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059554 :question/id #uuid "02372092-ed41-5533-8238-0361856b731d" :question/math-academy-id "e-4388" :question/problem "Consider the matrix\n    \n\n$$\n{B} = \n    \\begin{bmatrix}\n        1 & 2 & 4 & 2 \\\\\n        4 & 4 & 1 & 1 \\\\\n        3 & -3 & 0 & -1\n    \\end{bmatrix}.\n$$\n\nWhat are the dimensions of ${B}^T?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $N \\times M$ to $M \\times N.$\n\nSo, since $B$ is a $3 \\times 4$ matrix, the transpose ${B}^T$ is a $4\\times3$ matrix."} :knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321" :knowledge-point/title "Determining the Dimensions of the Transpose of a Matrix"}] :topic/math-academy-id 232 :topic/next [{:db/id #edb/ref 17592186048122} {:db/id #edb/ref 17592186049043} {:db/id #edb/ref 17592186049970} {:db/id #edb/ref 17592186050021} {:db/id #edb/ref 17592186050283} {:db/id #edb/ref 17592186050911} {:db/id #edb/ref 17592186050972}] :topic/title "The Transpose of a Matrix"}]}
