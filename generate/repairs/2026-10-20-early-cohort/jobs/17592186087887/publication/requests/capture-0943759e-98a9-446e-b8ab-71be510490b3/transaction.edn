e6c932a9-2118-59f3-8667-5bfbd109a495"] [:db/add "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/choices "7257744d-baf9-52bb-a667-330bb49fec45"] [:db/add "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/choices "678f298c-c478-5daf-ab27-245bae154add"] [:db/add "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/choices "cf1f52c1-9e2f-5703-bbf2-35294a1c9263"] [:db/add "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/choices "26f12a2c-f5f0-5b38-80c9-b115d206af76"] [:db/add "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/correct "678f298c-c478-5daf-ab27-245bae154add"] [:db/ensure "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/validate] [:db/add "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/id #uuid "30cc31fb-987b-53e1-a0e0-f17337bbd938"] [:db/add "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-5x+2y}{x}\n$$"] [:db/add "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-5x+2(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=-5+2v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=-5+v \\\\ \\frac{1}{-5+v}\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\frac{1}{-5+v}\\,\\mathrm{d}v&=\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\ln|v-5|&=\\ln|x|+C_1 \\\\ |v-5|&=e^{C_1}|x| \\\\ v-5&=Cx \\\\ v&=Cx+5\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=Cx+5 \\\\ y&=Cx^2+5x\\end{aligned}\n$$\n\nThe signed constant $C$ absorbs $e^{C_1}$. Division by $v-5$ excluded $v=+5$; restoring it permits $C=0$, giving $y=+5x$.\n\nThe solution is used on intervals where $x\\ne0$."] [:db/add "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/difficulty :question.difficulty/easy] [:db/add "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/answer-fields "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097"] [:db/ensure "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/validate] [:db/add 17592186087887 :knowledge-point/questions "30cc31fb-987b-53e1-a0e0-f17337bbd938"] [:db/add "1d51935d-6604-58ea-9402-f93f14a1c15e" :answer/id #uuid "1d51935d-6604-58ea-9402-f93f14a1c15e"] [:db/add "1d51935d-6604-58ea-9402-f93f14a1c15e" :answer/type :answer.type/math] [:db/add "1d51935d-6604-58ea-9402-f93f14a1c15e" :answer/value "y=-9x\\ln|x|+Cx"] [:db/ensure "1d51935d-6604-58ea-9402-f93f14a1c15e" :answer/validate] [:db/add "baeffd52-c01a-5250-bb6e-0e51261e9b11" :answer/id #uuid "baeffd52-c01a-5250-bb6e-0e51261e9b11"] [:db/add "baeffd52-c01a-5250-bb6e-0e51261e9b11" :answer/type :answer.type/math] [:db/add "baeffd52-c01a-5250-bb6e-0e51261e9b11" :answer/value "y=-8x\\ln|x|+Cx"] [:db/ensure "baeffd52-c01a-5250-bb6e-0e51261e9b11" :answer/validate] [:db/add "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade" :answer/id #uuid "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade"] [:db/add "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade" :answer/type :answer.type/math] [:db/add "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade" :answer/value "y=8x\\ln|x|+Cx"] [:db/ensure "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade" :answer/validate] [:db/add "e1537f74-01c8-5e66-9e68-8eea3359ff5b" :answer/id #uuid "e1537f74-01c8-5e66-9e68-8eea3359ff5b"] [:db/add "e1537f74-01c8-5e66-9e68-8eea3359ff5b" :answer/type :answer.type/math] [:db/add "e1537f74-01c8-5e66-9e68-8eea3359ff5b" :answer/value "y=-7x\\ln|x|+Cx"] [:db/ensure "e1537f74-01c8-5e66-9e68-8eea3359ff5b" :answer/validate] [:db/add "514c5fa7-4317-5fce-b10d-b459d799ef56" :answer/id #uuid "514c5fa7-4317-5fce-b10d-b459d799ef56"] [:db/add "514c5fa7-4317-5fce-b10d-b459d799ef56" :answer/type :answer.type/math] [:db/add "514c5fa7-4317-5fce-b10d-b459d799ef56" :answer/value "y=9x\\ln|x|+Cx"] [:db/ensure "514c5fa7-4317-5fce-b10d-b459d799ef56" :answer/validate] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/id #uuid "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/key "selection"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/type :answer-field.type/radio] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/choices "1d51935d-6604-58ea-9402-f93f14a1c15e"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/choices "baeffd52-c01a-5250-bb6e-0e51261e9b11"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/choices "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/choices "e1537f74-01c8-5e66-9e68-8eea3359ff5b"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/choices "514c5fa7-4317-5fce-b10d-b459d799ef56"] [:db/add "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/correct "baeffd52-c01a-5250-bb6e-0e51261e9b11"] [:db/ensure "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/validate] [:db/add "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/id #uuid "4b4c00e1-aa47-5602-bd0d-168e84572944"] [:db/add "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-8x+y}{x}\n$$"] [:db/add "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-8x+(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=-8+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=-8 \\\\ \\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-8}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\mathrm{d}v&=-8\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ v&=-8\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=-8\\ln|x|+C \\\\ y&=-8x\\ln|x|+Cx\\end{aligned}\n$$\n\n\n\nThe solution is used on intervals where $x\\ne0$."] [:db/add "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/difficulty :question.difficulty/easy] [:db/add "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/answer-fields "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae"] [:db/ensure "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/validate] [:db/add 17592186087887 :knowledge-point/questions "4b4c00e1-aa47-5602-bd0d-168e84572944"] [:db/add "38955d01-ccd4-560b-9139-6c453f5555a2" :answer/id #uuid "38955d01-ccd4-560b-9139-6c453f5555a2"] [:db/add "38955d01-ccd4-560b-9139-6c453f5555a2" :answer/type :answer.type/math] [:db/add "38955d01-ccd4-560b-9139-6c453f5555a2" :answer/value "y=x\\sqrt[3]{9\\ln|x|+C}"] [:db/ensure "38955d01-ccd4-560b-9139-6c453f5555a2" :answer/validate] [:db/add "9981dd32-3989-5e26-909d-46df1a93e73a" :answer/id #uuid "9981dd32-3989-5e26-909d-46df1a93e73a"] [:db/add "9981dd32-3989-5e26-909d-46df1a93e73a" :answer/type :answer.type/math] [:db/add "9981dd32-3989-5e26-909d-46df1a93e73a" :answer/value "y=x\\sqrt[3]{12\\ln|x|+C}"] [:db/ensure "9981dd32-3989-5e26-909d-46df1a93e73a" :answer/validate] [:db/add "d9893475-8584-50b4-b9fe-32d8380fbe44" :answer/id #uuid "d9893475-8584-50b4-b9fe-32d8380fbe44"] [:db/add "d9893475-8584-50b4-b9fe-32d8380fbe44" :answer/type :answer.type/math] [:db/add "d9893475-8584-50b4-b9fe-32d8380fbe44" :answer/value "y=x\\sqrt[3]{15\\ln|x|+C}"] [:db/ensure "d9893475-8584-50b4-b9fe-32d8380fbe44" :answer/validate] [:db/add "4898faf8-30ee-573e-bf75-852d9288d67c" :answer/id #uuid "4898faf8-30ee-573e-bf75-852d9288d67c"] [:db/add "4898faf8-30ee-573e-bf75-852d9288d67c" :answer/type :answer.type/math] [:db/add "4898faf8-30ee-573e-bf75-852d9288d67c" :answer/value "y=x\\sqrt[3]{18\\ln|x|+C}"] [:db/ensure "4898faf8-30ee-573e-bf75-852d9288d67c" :answer/validate] [:db/add "0378c6c1-1689-51b3-8e5d-fb43415a1974" :answer/id #uuid "0378c6c1-1689-51b3-8e5d-fb43415a1974"] [:db/add "0378c6c1-1689-51b3-8e5d-fb43415a1974" :answer/type :answer.type/math] [:db/add "0378c6c1-1689-51b3-8e5d-fb43415a1974" :answer/value "y=x\\sqrt[3]{6\\ln|x|+C}"] [:db/ensure "0378c6c1-1689-51b3-8e5d-fb43415a1974" :answer/validate] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/id #uuid "ec11a14d-eb08-534c-9e8f-f43faa60a50b"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/key "selection"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/type :answer-field.type/radio] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/choices "38955d01-ccd4-560b-9139-6c453f5555a2"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/choices "9981dd32-3989-5e26-909d-46df1a93e73a"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/choices "d9893475-8584-50b4-b9fe-32d8380fbe44"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/choices "4898faf8-30ee-573e-bf75-852d9288d67c"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/choices "0378c6c1-1689-51b3-8e5d-fb43415a1974"] [:db/add "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/correct "4898faf8-30ee-573e-bf75-852d9288d67c"] [:db/ensure "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/validate] [:db/add "ab3a19b0-a384-5471-b89f-af5746a38437" :question/id #uuid "ab3a19b0-a384-5471-b89f-af5746a38437"] [:db/add "ab3a19b0-a384-5471-b89f-af5746a38437" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{6x^3+y^3}{xy^2}\n$$"] [:db/add "ab3a19b0-a384-5471-b89f-af5746a38437" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{6x^3+(vx)^3}{x(vx)^2} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{6+v^3}{v^2}=\\frac{6}{v^2}+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{6}{v^2} \\\\ v^2\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{6}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v^2\\,\\mathrm{d}v&=6\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\frac{v^3}{3}&=6\\ln|x|+C_1 \\\\ v^3&=18\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\left(\\frac{y}{x}\\right)^3&=18\\ln|x|+C \\\\ y^3&=x^3(18\\ln|x|+C) \\\\ y&=x\\sqrt[3]{18\\ln|x|+C}\\end{aligned}\n$$\n\nHere $C=3C_1$ and the cube root is real. Restrict the solution to intervals where $y\\ne0$.\n\nThe solution is used on intervals where $x\\ne0$ and $y\\ne0$."] [:db/add "ab3a19b0-a384-5471-b89f-af5746a38437" :question/difficulty :question.difficulty/easy] [:db/add "ab3a19b0-a384-5471-b89f-af5746a38437" :question/answer-fields "ec11a14d-eb08-534c-9e8f-f43faa60a50b"] [:db/ensure "ab3a19b0-a384-5471-b89f-af5746a38437" :question/validate] [:db/add 17592186087887 :knowledge-point/questions "ab3a19b0-a384-5471-b89f-af5746a38437"] [:db/add "e3b1ebf6-4ad9-5386-b26a-47040c79f52d" :answer/id #uuid "e3b1ebf6-4ad9-5386-b26a-47040c79