}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{9x+(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=9+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=9 \\\\ \\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{9}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\mathrm{d}v&=9\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ v&=9\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=9\\ln|x|+C \\\\ y&=9x\\ln|x|+Cx\\end{aligned}\n$$\n\n\n\nThe solution is used on intervals where $x\\ne0$."] [:db/add "d2255ee7-abce-50d0-aa0c-7b7dbf70082c" :question/difficulty :question.difficulty/easy] [:db/add "d2255ee7-abce-50d0-aa0c-7b7dbf70082c" :question/answer-fields "81a5f1e5-e390-5a6a-aea6-e93552d4299b"] [:db/ensure "d2255ee7-abce-50d0-aa0c-7b7dbf70082c" :question/validate] [:db/add 17592186087887 :knowledge-point/questions "d2255ee7-abce-50d0-aa0c-7b7dbf70082c"] [:db/add "generator" :question-generator/id #uuid "9b358f5d-2964-5463-92d4-c7614fd5d130"] [:db/add "generator" :question-generator/script "generators/ee/eeb61e663594cae87380188d0d01120e80d858174ac6d0664aa50ba1404423f0/generator.py"] [:db/add 17592186087887 :knowledge-point/question-generator "generator"] [:db/ensure 17592186087887 :knowledge-point/validate]]
