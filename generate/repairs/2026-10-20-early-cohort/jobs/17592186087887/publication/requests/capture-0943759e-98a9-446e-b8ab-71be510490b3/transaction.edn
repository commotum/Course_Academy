6-b26a-47040c79f52d"] [:db/add "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/choices "3138456f-b7f9-5b66-bc73-30e7df6c24f4"] [:db/add "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/choices "108d7439-bcd1-5e26-9eb1-5a008b73b1f9"] [:db/add "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/choices "161567f2-2d20-5482-884c-b7b6aeb3f280"] [:db/add "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/choices "37c60102-735e-5f3f-a2f1-f9c0cf04a103"] [:db/add "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/correct "161567f2-2d20-5482-884c-b7b6aeb3f280"] [:db/ensure "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/validate] [:db/add "6b425fb8-4418-5edc-933b-1ae101a41660" :question/id #uuid "6b425fb8-4418-5edc-933b-1ae101a41660"] [:db/add "6b425fb8-4418-5edc-933b-1ae101a41660" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-3x^3+y^3}{xy^2}\n$$"] [:db/add "6b425fb8-4418-5edc-933b-1ae101a41660" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-3x^3+(vx)^3}{x(vx)^2} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-3+v^3}{v^2}=\\frac{-3}{v^2}+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-3}{v^2} \\\\ v^2\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-3}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v^2\\,\\mathrm{d}v&=-3\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\frac{v^3}{3}&=-3\\ln|x|+C_1 \\\\ v^3&=-9\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\left(\\frac{y}{x}\\right)^3&=-9\\ln|x|+C \\\\ y^3&=x^3(-9\\ln|x|+C) \\\\ y&=x\\sqrt[3]{-9\\ln|x|+C}\\end{aligned}\n$$\n\nHere $C=3C_1$ and the cube root is real. Restrict the solution to intervals where $y\\ne0$.\n\nThe solution is used on intervals where $x\\ne0$ and $y\\ne0$."] [:db/add "6b425fb8-4418-5edc-933b-1ae101a41660" :question/difficulty :question.difficulty/easy] [:db/add "6b425fb8-4418-5edc-933b-1ae101a41660" :question/answer-fields "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa"] [:db/ensure "6b425fb8-4418-5edc-933b-1ae101a41660" :question/validate] [:db/add 17592186087887 :knowledge-point/questions "6b425fb8-4418-5edc-933b-1ae101a41660"] [:db/add "0a7aa767-09c1-5f33-beee-56d2dc091085" :answer/id #uuid "0a7aa767-09c1-5f33-beee-56d2dc091085"] [:db/add "0a7aa767-09c1-5f33-beee-56d2dc091085" :answer/type :answer.type/math] [:db/add "0a7aa767-09c1-5f33-beee-56d2dc091085" :answer/value "y=9x\\ln|x|+Cx"] [:db/ensure "0a7aa767-09c1-5f33-beee-56d2dc091085" :answer/validate] [:db/add "0af3e1f8-e33c-58bd-8211-dc7a53c2e32e" :answer/id #uuid "0af3e1f8-e33c-58bd-8211-dc7a53c2e32e"] [:db/add "0af3e1f8-e33c-58bd-8211-dc7a53c2e32e" :answer/type :answer.type/math] [:db/add "0af3e1f8-e33c-58bd-8211-dc7a53c2e32e" :answer/value "y=-9x\\ln|x|+Cx"] [:db/ensure "0af3e1f8-e33c-58bd-8211-dc7a53c2e32e" :answer/validate] [:db/add "9efd76df-fb57-5448-8be0-69dfed592e9b" :answer/id #uuid "9efd76df-fb57-5448-8be0-69dfed592e9b"] [:db/add "9efd76df-fb57-5448-8be0-69dfed592e9b" :answer/type :answer.type/math] [:db/add "9efd76df-fb57-5448-8be0-69dfed592e9b" :answer/value "y=-7x\\ln|x|+Cx"] [:db/ensure "9efd76df-fb57-5448-8be0-69dfed592e9b" :answer/validate] [:db/add "aec599be-75e7-5ce7-b9ec-a7bb418c544b" :answer/id #uuid "aec599be-75e7-5ce7-b9ec-a7bb418c544b"] [:db/add "aec599be-75e7-5ce7-b9ec-a7bb418c544b" :answer/type :answer.type/math] [:db/add "aec599be-75e7-5ce7-b9ec-a7bb418c544b" :answer/value "y=-8x\\ln|x|+Cx"] [:db/ensure "aec599be-75e7-5ce7-b