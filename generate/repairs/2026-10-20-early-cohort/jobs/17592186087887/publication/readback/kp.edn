#{[{:db/id #edb/ref 17592186087887 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087457 :question/id #uuid "89b7276c-ef41-5123-ad31-b54753656111" :question/math-academy-id "e-2302" :question/problem "Find the general solution to the equation\n![](images/12/12aec388c94c8c4d4f2099b98f5a489d110fa3ef0d58e7895d9a425e49f8eb77.png)" :question/worked-solution "We note that this equation is a homogeneous first-order differential equation because\n![](images/c3/c3215663fd1a332f750b8af4049404061e2b1c64726c81572d1a1e76816bb718.png)\n\nThe given equation is not separable, but we can transform it into a separable equation by carrying out the substitution\n![](images/7c/7c57d5a7c4003269ba9eacf6240394f508347989a9d75665c7070e31cbdad701.png)\n\nCarrying out the substitution and separating variables, we have\n![](images/8a/8ad7a31876bc67fa69ff24ed41badcf6531ddf52b2d1847af4b0b75595ab5bcd.png)\n\nIntegrating both sides, we get\n![](images/7a/7a6577d6ac4f3f1fc100a2767d77509fbe211f7d3e7bc7a2bba027080e7e6ccd.png)\nwhere ![](images/42/4247e7a16afb46979bc6ecfc9ae10dc6c92d0f5f1ff5e1b2a1f412ec86a48a83.png) (with ![](images/9e/9e71f72815a80396d1186bfed1047662e1d507561c7160d1c2d89c2f23421c09.png)) and ![](images/01/012dd077bd0f68f82ae37fa50d493e97bd67ac5ff9f301e48ca29e91b1af16ab.png) \n\nFinally, substituting ![](images/f7/f74fcd854fc4be51cd8eed8f4d0649bcc7cf11089a7aa2a7e7edd8d306693f78.png) and simplifying, we get\n![](images/05/05eae130ba10a3386a1c8621ecc3e3d3ec0bb7af352fb4c928cf8bf2d88c21a3.png)\nwhere ![](images/89/8939a3ee49356a0cc8515cce98d84ecf10279dad9d2f76fac07660d0f99a0d7b.png) Therefore, the general solution is\n![](images/18/185e5a72b055183d70fb6d9dbc0227190a8114b80b2dc4193d8f542d5c85c0d7.png)"} :knowledge-point/id #uuid "49eaf082-07de-5468-a2d7-4cdfce27a553" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048697 :topic/difficulty 0.7855885097363628 :topic/id #uuid "b5d86240-2aa3-5be2-b9a5-9ed16336f711" :topic/knowledge-points [{:db/id #edb/ref 17592186068840} {:db/id #edb/ref 17592186068841} {:db/id #edb/ref 17592186068842} {:db/id #edb/ref 17592186068844}] :topic/math-academy-id 466 :topic/next [{:db/id #edb/ref 17592186048894} {:db/id #edb/ref 17592186049102} {:db/id #edb/ref 17592186049562} {:db/id #edb/ref 17592186050905} {:db/id #edb/ref 17592186050995}] :topic/title "Solving First-Order ODEs Using Separation of Variables"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186673525 :question-generator/id #uuid "9b358f5d-2964-5463-92d4-c7614fd5d130" :question-generator/script "generators/ee/eeb61e663594cae87380188d0d01120e80d858174ac6d0664aa50ba1404423f0/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186088444 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f095d9d-73ca-5510-90d9-13b6f42d391c" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} = Kx^{4} - 3x^{3}" :db/id #edb/ref 17592186087318} {:answer/id #uuid "14ce0339-1417-5b9c-b34f-15d48bba12ca" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} = Kx^{3} - x^{2}" :db/id #edb/ref 17592186087319} {:answer/id #uuid "23493c53-f790-52b7-8d4b-a2a247c6a8df" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} = Kx^{3} + 2x^{2}" :db/id #edb/ref 17592186087320} {:answer/id #uuid "3c5f3ce3-6b89-5309-ab95-65da4990d433" :answer/type {:db/ident :answer.type/math} :answer/value "y^{3} = Kx^{3} - x" :db/id #edb/ref 17592186087321} {:answer/id #uuid "5e069116-da75-542a-b369-bd8e185c2346" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} = Kx^{4} + x^{2}" :db/id #edb/ref 17592186087322}] :answer-field/id #uuid "6f5a5051-ab3a-58d2-839d-37c5299136cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087317}] :question/id #uuid "ecc5b0a4-8e5a-5917-a8c3-d4ab3b2b520d" :question/math-academy-id "q-8843" :question/problem "Use the transformation $y = v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$\\frac{dy}{dx} = \\frac{x^{2} + 3y^{2}}{2xy}$"} {:db/id #edb/ref 17592186088445 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "033b5955-1071-5d95-b2f7-c2bd33d3768d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=x\\operatorname{ln}⁡(C{x}^{3}+x)" :db/id #edb/ref 17592186351594} {:answer/id #uuid "16da157c-25e8-539b-972d-839e07401032" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-{x}^{3}+C{x}^{2}" :db/id #edb/ref 17592186351768} {:answer/id #uuid "44d00c81-de3d-54d8-a887-f6cce43dbe9c" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=x\\operatorname{ln}⁡x+C{x}^{3}" :db/id #edb/ref 17592186352200} {:answer/id #uuid "5ec6f001-1f40-5e1d-8eaf-f6d17c1f89cd" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{2}\\operatorname{ln}⁡({x}^{2}+Cx)" :db/id #edb/ref 17592186352407} {:answer/id #uuid "d8863625-e75e-5388-909d-087df892fe66" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-{x}^{2}\\operatorname{ln}⁡{x}^{2}+C{x}^{2}" :db/id #edb/ref 17592186353447}] :answer-field/correct {:answer/id #uuid "d8863625-e75e-5388-909d-087df892fe66" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-{x}^{2}\\operatorname{ln}⁡{x}^{2}+C{x}^{2}" :db/id #edb/ref 17592186353447} :answer-field/id #uuid "3026f036-9a48-51a7-b01d-a4f3f08da8e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353897}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "19530196-afb6-5c10-98a9-988afc75a28c" :question/math-academy-id "q-8844" :question/problem "Find the general solution of the following differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}-{x}^{2}}{xy}\n$$" :question/worked-solution "This is a homogeneous equation because it is written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y),\n$$\n\nand we notice that all terms in the numerator and denominator of $f(x,y)$ are of order $2$ (i.e., they are quadratic).\n\nUsing the transformation $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{2}-{x}^{2}}{xy} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{(vx)^{2}-{x}^{2}}{x(vx)} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{x}^{2}({v}^{2}-1)}{v{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{{v}^{2}-1}{v}-v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{{v}^{2}-1-{v}^{2}}{v} \\\\ v\\frac{\\text{d}v}{\\text{d}x} & =-\\frac{1}{x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int v\\,\\text{d}v & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\frac{{v}^{2}}{2} & =-\\operatorname{ln}⁡|x|+{C}_{1} \\\\ {v}^{2} & =-2\\operatorname{ln}⁡|x|+2{C}_{1} \\\\ {v}^{2} & =-2\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$\n\nNotice that we introduced $C=2{C}_{1}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nFinally, substituting the above into our solution, we obtain\n\n$$\n\\begin{aligned}{\\left(\\frac{y}{x}\\right)}^{2} & =-2\\operatorname{ln}⁡|x|+C \\\\ \\frac{{y}^{2}}{{x}^{2}} & =-\\operatorname{ln}⁡{x}^{2}+C \\\\ {y}^{2} & =-{x}^{2}\\operatorname{ln}⁡{x}^{2}+C{x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275108 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4240f0e5-b1a6-5f98-993e-7c328c878785" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|y|-\\frac{y}{x}=C" :db/id #edb/ref 17592186272953} {:answer/id #uuid "62bc8038-4d46-561e-ab4d-c5512986257f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{{x}^{3}}{y}|+2\\frac{y}{x}=C" :db/id #edb/ref 17592186273236} {:answer/id #uuid "78fcca57-3793-54d9-9ed6-e1885a1fdd95" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{{y}^{2}}{{x}^{3}}|-\\frac{{x}^{2}}{{y}^{2}}=C" :db/id #edb/ref 17592186273426} {:answer/id #uuid "7ed55e10-2aae-5111-b574-774642465adf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|y|-\\frac{{x}^{2}}{{y}^{2}}=C" :db/id #edb/ref 17592186273475} {:answer/id #uuid "aec77027-a6c4-54d9-8f83-8cb3685f4304" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\frac{y}{{x}^{2}}|+\\frac{{y}^{2}}{{x}^{2}}=C" :db/id #edb/ref 17592186273896}] :answer-field/correct {:answer/id #uuid "7ed55e10-2aae-5111-b574-774642465adf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|y|-\\frac{{x}^{2}}{{y}^{2}}=C" :db/id #edb/ref 17592186273475} :answer-field/id #uuid "729c88dd-5291-5373-98f6-d82abc2b83bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274829}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c139f739-608f-51ea-bcb4-01f8a92a8c21" :question/math-academy-id "q-14318" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{yx}{{y}^{2}+{x}^{2}}\n$$" :question/worked-solution "With $y=v(x)x$, we have:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{yx}{{y}^{2}+{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{(vx)x}{(vx)^{2}+{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{v{x}^{2}}{{x}^{2}({v}^{2}+1)} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{v}{{v}^{2}+1}-v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{v-{v}^{3}-v}{{v}^{2}+1} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{-{v}^{3}}{{v}^{2}+1} \\\\ \\frac{{v}^{2}+1}{{v}^{3}}\\frac{\\text{d}v}{\\text{d}x} & =-\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain:\n\n$$\n\\begin{aligned}\\int \\frac{{v}^{2}+1}{{v}^{3}}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int (\\frac{1}{v}+\\frac{1}{{v}^{3}})\\,\\text{d}v & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|v|-\\frac{1}{2{v}^{2}} & =-\\operatorname{ln}⁡|x|+{C}_{1} \\\\ 2\\operatorname{ln}⁡|v|-\\frac{1}{{v}^{2}} & =-2\\operatorname{ln}⁡|x|+2{C}_{1} \\\\ 2\\operatorname{ln}⁡|v|-\\frac{1}{{v}^{2}} & =-2\\operatorname{ln}⁡|x|+C\\end{aligned}\n$$\n\nNotice that we introduced $C=2{C}_{1}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain:\n\n$$\n\\begin{aligned}2\\operatorname{ln}⁡|\\frac{y}{x}|-\\frac{{x}^{2}}{{y}^{2}} & =-2\\operatorname{ln}⁡|x|+C \\\\ 2\\operatorname{ln}⁡|\\frac{y}{x}|+2\\operatorname{ln}⁡|x|-\\frac{{x}^{2}}{{y}^{2}} & =C \\\\ 2\\operatorname{ln}⁡|y|-\\frac{{x}^{2}}{{y}^{2}} & =C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186275110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d9fe79d-af55-52cc-807d-fdf8ff575196" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=x(\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186273336} {:answer/id #uuid "7a705b5a-78f9-5bf4-bce8-236b06ad49a3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}(2\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186273438} {:answer/id #uuid "83d1456f-a5d0-5b18-8867-aafba772b364" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}(-\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186273519} {:answer/id #uuid "9c5879f0-7e3a-5185-9b2f-9e9609b66dc4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=x(-2\\operatorname{ln}⁡|x|)+C" :db/id #edb/ref 17592186273742} {:answer/id #uuid "e17a8c50-895e-531b-acd7-eacf19bd14fc" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}(\\operatorname{ln}⁡|x|)+C" :db/id #edb/ref 17592186274376}] :answer-field/correct {:answer/id #uuid "7a705b5a-78f9-5bf4-bce8-236b06ad49a3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}={x}^{2}(2\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186273438} :answer-field/id #uuid "35568be0-5728-557a-8bc2-7bde66432758" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274727}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "30f68eaf-916e-557d-ad03-5e30a2efe0b7" :question/math-academy-id "q-14321" :question/problem "Find the general solution of the following differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{3}+x{y}^{2}+{x}^{2}y+{x}^{3}}{x{y}^{2}+{x}^{2}y}\n$$" :question/worked-solution "This is a homogeneous equation because it is written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y),\n$$\n\nand we notice that all terms in the numerator and denominator of $f(x,y)$ are of order $3$ (i.e., they are cubic).\n\nUsing the transformation $y=v(x)x$, we have:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v\\,.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{3}+x{y}^{2}+{x}^{2}y+{x}^{3}}{x{y}^{2}+{x}^{2}y} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{(vx)^{3}+x(vx)^{2}+{x}^{2}(vx)+{x}^{3}}{x(vx)^{2}+{x}^{2}(vx)} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{x}^{3}({v}^{3}+{v}^{2}+v+1)}{{x}^{3}({v}^{2}+v)} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{v}^{3}+{v}^{2}+v+1}{{v}^{2}+v} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{{v}^{3}+{v}^{2}+v+1}{{v}^{2}+v}-v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{{v}^{3}+{v}^{2}+v+1-{v}^{3}-{v}^{2}}{{v}^{2}+v} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{v+1}{v(v+1)} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{v} \\\\ v\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain:\n\n$$\n\\begin{aligned}\\int v\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int v\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\frac{{v}^{2}}{2} & =\\operatorname{ln}⁡|x|+{C}_{1} \\\\ {v}^{2} & =2\\operatorname{ln}⁡|x|+2{C}_{1} \\\\ {v}^{2} & =2\\operatorname{ln}⁡|x|+C\\end{aligned}\n$$\n\nNotice that we introduced $C=2{C}_{1}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}\\,.\n$$\n\nFinally, substituting the above into our solution, we obtain:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{{x}^{2}} & =2\\operatorname{ln}⁡|x|+C \\\\ {y}^{2} & ={x}^{2}(2\\operatorname{ln}⁡|x|+C)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186354644 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31321e37-1d8f-571b-93be-de318d95581f" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{2}+{e}^{Kx}" :db/id #edb/ref 17592186352023} {:answer/id #uuid "5d5509a4-9f52-54c9-a17c-80239e35bbab" :answer/type {:db/ident :answer.type/math} :answer/value "y=K{e}^{x}" :db/id #edb/ref 17592186352393} {:answer/id #uuid "91cfd736-1c68-561f-a5b9-ea0cbbe64c88" :answer/type {:db/ident :answer.type/math} :answer/value "y=K(2+{e}^{3x})" :db/id #edb/ref 17592186352829} {:answer/id #uuid "a325eecd-f037-58fb-8914-e5fc2b454b6b" :answer/type {:db/ident :answer.type/math} :answer/value "y=x{e}^{Kx}" :db/id #edb/ref 17592186352960} {:answer/id #uuid "dff7fb2b-7bf1-5f3a-9233-5a286fcbeca6" :answer/type {:db/ident :answer.type/math} :answer/value "y=K{x}^{2}+{e}^{x}" :db/id #edb/ref 17592186353514}] :answer-field/correct {:answer/id #uuid "a325eecd-f037-58fb-8914-e5fc2b454b6b" :answer/type {:db/ident :answer.type/math} :answer/value "y=x{e}^{Kx}" :db/id #edb/ref 17592186352960} :answer-field/id #uuid "f3b6679e-da5e-570b-8272-44a851986baa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354240}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b284307a-7bac-5101-a812-75d87d197409" :question/math-academy-id "q-8845" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{x}(\\operatorname{ln}⁡\\left(\\frac{y}{x}\\right)+1)\n$$" :question/worked-solution "With $y=v(x)x$, we have:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v\\,.\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{y}{x}(\\operatorname{ln}⁡\\left(\\frac{y}{x}\\right)+1) \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{vx}{x}(\\operatorname{ln}⁡\\left(\\frac{vx}{x}\\right)+1) \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =v(\\operatorname{ln}⁡v+1) \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =v\\operatorname{ln}⁡v+v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =v\\operatorname{ln}⁡v \\\\ \\frac{1}{v\\operatorname{ln}⁡v}\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain:\n\n$$\n\\begin{aligned}\\int \\frac{1}{v\\operatorname{ln}⁡v}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int \\frac{1}{v\\operatorname{ln}⁡v}\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nTo evaluate the integral on the left-hand side, we use integration by substitution with\n\n$$\nu=\\operatorname{ln}⁡v,\\,\\frac{\\text{d}u}{\\text{d}v}=\\frac{1}{v}.\n$$\n\nWe now proceed to solve the equation:\n\n$$\n\\begin{aligned}\\int \\frac{1}{v\\operatorname{ln}⁡v}\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int \\frac{1}{u}\\frac{\\text{d}u}{\\text{d}v}\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|u| & =\\operatorname{ln}⁡|x|+C \\\\ \\operatorname{ln}⁡|\\operatorname{ln}⁡v| & =\\operatorname{ln}⁡|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}\\,.\n$$\n\nSubstituting the above into our solution, we finally obtain:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|\\operatorname{ln}⁡v| & =\\operatorname{ln}⁡|x|+C \\\\ \\operatorname{ln}⁡|\\operatorname{ln}⁡\\frac{y}{x}| & =\\operatorname{ln}⁡|x|+C \\\\ \\operatorname{ln}⁡|\\operatorname{ln}⁡\\frac{y}{x}| & =\\operatorname{ln}⁡|x|+\\operatorname{ln}⁡{e}^{C} \\\\ \\operatorname{ln}⁡|\\operatorname{ln}⁡\\frac{y}{x}| & =\\operatorname{ln}⁡({e}^{C}|x|) \\\\ |\\operatorname{ln}⁡\\frac{y}{x}| & =|x|{e}^{C} \\\\ \\operatorname{ln}⁡\\frac{y}{x} & =\\pm {e}^{C}x \\\\ \\operatorname{ln}⁡\\frac{y}{x} & =Kx \\\\ \\frac{y}{x} & ={e}^{Kx} \\\\ y & =x{e}^{Kx}\\end{aligned}\n$$\n\nNotice that we introduced the new constant of integration:\n\n$$\nK=\\pm {e}^{C}\n$$"} {:db/id #edb/ref 17592186357461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "433c74fb-43f7-5727-9983-010f8c211f6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{4}}{C-\\operatorname{ln}⁡({y}^{2})}=2x" :db/id #edb/ref 17592186355264} {:answer/id #uuid "55a4be35-898b-5439-adca-7b36f1ff4970" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{C+\\operatorname{ln}⁡({y}^{2})}={x}^{2}" :db/id #edb/ref 17592186355425} {:answer/id #uuid "a96d1ec6-5cb0-56d5-9973-2123a3ad4d14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{C-\\operatorname{ln}⁡({y}^{2})}={x}^{2}" :db/id #edb/ref 17592186356163} {:answer/id #uuid "cc536521-0c37-5947-8b9c-28f5c636543e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{C+\\operatorname{ln}⁡({y}^{2})}=2{x}^{3}" :db/id #edb/ref 17592186356447} {:answer/id #uuid "fcb3678b-a603-59dc-9e12-878859c35e40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{C-\\operatorname{ln}⁡({y}^{2})}=4x" :db/id #edb/ref 17592186356876}] :answer-field/correct {:answer/id #uuid "a96d1ec6-5cb0-56d5-9973-2123a3ad4d14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{C-\\operatorname{ln}⁡({y}^{2})}={x}^{2}" :db/id #edb/ref 17592186356163} :answer-field/id #uuid "dd025383-e1bb-5f14-a031-96c47932a3f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357310}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "51ab68ae-6386-58f8-941d-fb2c589605a8" :question/math-academy-id "q-90688" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{3}}{x{y}^{2}+{x}^{3}}.\n$$" :question/worked-solution "Using the transformation $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{3}}{x{y}^{2}+{x}^{3}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{(vx)^{3}}{x(vx)^{2}+{x}^{3}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{v}^{3}{x}^{3}}{({v}^{2}+1){x}^{3}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{v}^{3}}{{v}^{2}+1} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{{v}^{3}}{{v}^{2}+1}-v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{{v}^{3}-{v}^{3}-v}{{v}^{2}+1} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =-\\frac{v}{{v}^{2}+1} \\\\ \\frac{{v}^{2}+1}{v}\\frac{\\text{d}v}{\\text{d}x} & =-\\frac{1}{x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int \\frac{{v}^{2}+1}{v}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int (v+\\frac{1}{v})\\,\\text{d}v & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\frac{{v}^{2}}{2}+\\operatorname{ln}⁡|v| & =-\\operatorname{ln}⁡|x|+{C}_{1} \\\\ {v}^{2}+2\\operatorname{ln}⁡|v| & =-2\\operatorname{ln}⁡|x|+2{C}_{1} \\\\ {v}^{2}+\\operatorname{ln}⁡({v}^{2}) & =-\\operatorname{ln}⁡({x}^{2})+C.\\end{aligned}\n$$\n\nNotice that we introduced $C=2{C}_{1}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nFinally, substituting the above into our solution, we obtain\n\n$$\n\\begin{aligned}{\\left(\\frac{y}{x}\\right)}^{2}+\\operatorname{ln}⁡{\\left(\\frac{y}{x}\\right)}^{2} & =-\\operatorname{ln}⁡({x}^{2})+C \\\\ \\frac{{y}^{2}}{{x}^{2}}+\\operatorname{ln}⁡\\left(\\frac{{y}^{2}}{{x}^{2}}\\right) & =-\\operatorname{ln}⁡({x}^{2})+C \\\\ \\frac{{y}^{2}}{{x}^{2}}+\\operatorname{ln}⁡({y}^{2})-\\operatorname{ln}⁡({x}^{2}) & =-\\operatorname{ln}⁡({x}^{2})+C \\\\ \\frac{{y}^{2}}{{x}^{2}}+\\operatorname{ln}⁡({y}^{2}) & =C \\\\ \\frac{{y}^{2}}{{x}^{2}} & =C-\\operatorname{ln}⁡({y}^{2}) \\\\ \\frac{{y}^{2}}{C-\\operatorname{ln}⁡({y}^{2})} & ={x}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "324d9632-b193-587f-bfb5-d3128eedb441" :answer/type {:db/ident :answer.type/math} :answer/value "y=x(3\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186355105} {:answer/id #uuid "4ea6a89a-49ac-5d60-8c9f-b573869dd1fb" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt{\\operatorname{ln}⁡|x|+C}" :db/id #edb/ref 17592186355366} {:answer/id #uuid "a748de52-875c-59b6-9078-bb8480995243" :answer/type {:db/ident :answer.type/math} :answer/value "y=x{(2\\operatorname{ln}⁡|x|+C)}^{2}" :db/id #edb/ref 17592186356146} {:answer/id #uuid "b93929bd-c6ff-5cde-a0dc-c9ed5ef022e6" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{3\\operatorname{ln}⁡|x|+C}" :db/id #edb/ref 17592186356286} {:answer/id #uuid "f9a14662-7280-54dd-9109-57e225b61eb1" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{2}(3\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186356844}] :answer-field/correct {:answer/id #uuid "b93929bd-c6ff-5cde-a0dc-c9ed5ef022e6" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{3\\operatorname{ln}⁡|x|+C}" :db/id #edb/ref 17592186356286} :answer-field/id #uuid "cfa93ac0-f184-5991-a79d-78c9b1ef6575" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357295}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2b4ed6f3-beb2-5be5-83cb-e8d41e7b8f3b" :question/math-academy-id "q-90691" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{x}^{3}+{y}^{3}}{x{y}^{2}}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{3}+{y}^{3}}{x{y}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{x}^{3}+(vx)^{3}}{x(vx)^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{x}^{3}(1+{v}^{3})}{{v}^{2}{x}^{3}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{1+{v}^{3}}{{v}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{1}{{v}^{2}}+v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{{v}^{2}} \\\\ {v}^{2}\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int {v}^{2}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int {v}^{2}\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\frac{{v}^{3}}{3}\\,\\text{d}v & =\\operatorname{ln}⁡|x|+{C}_{1} \\\\ {v}^{3} & =3\\operatorname{ln}⁡|x|+3{C}_{1} \\\\ {v}^{3} & =3\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$\n\nNote that we have let $C=3{C}_{1}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}\\,.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}{\\left(\\frac{y}{x}\\right)}^{3} & =3\\operatorname{ln}⁡|x|+C \\\\ \\frac{{y}^{3}}{{x}^{3}} & =3\\operatorname{ln}⁡|x|+C \\\\ {y}^{3} & ={x}^{3}(3\\operatorname{ln}⁡|x|+C) \\\\ y & =x\\sqrt[3]{3\\operatorname{ln}⁡|x|+C}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0230625f-08fa-547b-9a26-94bd2ec91119" :answer/type {:db/ident :answer.type/math} :answer/value "y=C{x}^{3}-{x}^{2}" :db/id #edb/ref 17592186354675} {:answer/id #uuid "30fd4d79-be88-5dd8-9bab-ff864e0801bd" :answer/type {:db/ident :answer.type/math} :answer/value "y=C{x}^{3}-2x" :db/id #edb/ref 17592186355093} {:answer/id #uuid "351f175f-a66a-537e-a899-d5e28a2bf51f" :answer/type {:db/ident :answer.type/math} :answer/value "y=C{x}^{3}+x" :db/id #edb/ref 17592186355136} {:answer/id #uuid "9738c27c-b600-5b8d-bf29-19ef94ea0e0c" :answer/type {:db/ident :answer.type/math} :answer/value "y=C{x}^{2}-x" :db/id #edb/ref 17592186355991} {:answer/id #uuid "ab45bf3d-adde-5478-b43f-fad1e155bfef" :answer/type {:db/ident :answer.type/math} :answer/value "y=C{x}^{2}+2x" :db/id #edb/ref 17592186356182}] :answer-field/correct {:answer/id #uuid "9738c27c-b600-5b8d-bf29-19ef94ea0e0c" :answer/type {:db/ident :answer.type/math} :answer/value "y=C{x}^{2}-x" :db/id #edb/ref 17592186355991} :answer-field/id #uuid "008bd79e-26b4-5414-8726-6a649de49016" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356909}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ed854c8a-5a47-5533-b48c-04deb7b81625" :question/math-academy-id "q-90692" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+2y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+2y}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{x+2(vx)}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{x(1+2v)}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =1+2v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =1+v \\\\ \\frac{1}{1+v}\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int \\frac{1}{1+v}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int \\frac{1}{1+v}\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|v+1| & =\\operatorname{ln}⁡|x|+{C}_{1} \\\\ \\operatorname{ln}⁡|v+1| & =\\operatorname{ln}⁡|x|+\\operatorname{ln}⁡({e}^{{C}_{1}}) \\\\ \\operatorname{ln}⁡|v+1| & =\\operatorname{ln}⁡({e}^{{C}_{1}}|x|) \\\\ |v+1| & ={e}^{{C}_{1}}|x| \\\\ v+1 & =\\pm {e}^{{C}_{1}}x \\\\ v+1 & =Cx \\\\ v & =Cx-1.\\end{aligned}\n$$\n\nNote that we have let $C=\\pm {e}^{{C}_{1}}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}\\,.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x} & =Cx-1 \\\\ y & =C{x}^{2}-x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186357464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3db1daca-94f7-5fc9-a2ae-4b63f7bd12e5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡|x|+C{x}^{2}" :db/id #edb/ref 17592186355215} {:answer/id #uuid "4053804e-1ea5-55b1-bd74-16ff29c5bfb3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡|x|+Cx" :db/id #edb/ref 17592186355239} {:answer/id #uuid "538b21c4-4f74-52e0-9fdc-8f28be2e423d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{ln}⁡|x|+Cx" :db/id #edb/ref 17592186355407} {:answer/id #uuid "8aa45948-76de-50a2-ab36-7a90839c9027" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186355890} {:answer/id #uuid "a42f0e08-13ac-59b0-9899-3b551131684e" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x\\operatorname{ln}⁡|x|+C{x}^{2}" :db/id #edb/ref 17592186356120}] :answer-field/correct {:answer/id #uuid "538b21c4-4f74-52e0-9fdc-8f28be2e423d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{ln}⁡|x|+Cx" :db/id #edb/ref 17592186355407} :answer-field/id #uuid "6a371f5e-aae2-5ed7-90ed-8749fc23270a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357101}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "73b06f86-eb7f-5333-916f-45bb6952f791" :question/math-academy-id "q-90693" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v.\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+y}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{x+(vx)}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{x(1+v)}{x} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =1+v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =1 \\\\ \\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int \\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ v & =\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}\\,.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x} & =\\operatorname{ln}⁡|x|+C \\\\ y & =x\\operatorname{ln}⁡|x|+Cx.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567154 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3c17f1-f814-5b07-b43e-943e91349a7d" :answer/type {:db/ident :answer.type/math} :answer/value "y=14x\\ln|x|+Cx^2" :db/id #edb/ref 17592186567155} {:answer/id #uuid "1ac7af4b-1410-5e5d-8017-81bae574ddb8" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x\\ln|x|+C" :db/id #edb/ref 17592186567158} {:answer/id #uuid "509ae4d5-c63f-5f05-948e-50319104d5bf" :answer/type {:db/ident :answer.type/math} :answer/value "y=7\\ln|x|+Cx^2" :db/id #edb/ref 17592186567163} {:answer/id #uuid "5379b768-1beb-5eff-8735-b067756a5b5e" :answer/type {:db/ident :answer.type/math} :answer/value "y=7\\ln|x|+Cx" :db/id #edb/ref 17592186567164} {:answer/id #uuid "9d6edc00-118b-5935-bf52-4378edc2c1fe" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x\\ln|x|+Cx" :db/id #edb/ref 17592186567179}] :answer-field/correct {:answer/id #uuid "9d6edc00-118b-5935-bf52-4378edc2c1fe" :answer/type {:db/ident :answer.type/math} :answer/value "y=7x\\ln|x|+Cx" :db/id #edb/ref 17592186567179} :answer-field/id #uuid "037f8ee7-d7a4-57d7-a847-a86c53618745" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567153}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "044bf3fa-78d9-52d3-92f7-f8c3e8e8fe40" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{7x+y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{7x+(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=7+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=7 \\\\ \\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{7}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\mathrm{d}v&=7\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ v&=7\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=7\\ln|x|+C \\\\ y&=7x\\ln|x|+Cx\\end{aligned}\n$$\n\n\n\nThe solution is used on intervals where $x\\ne0$."} {:db/id #edb/ref 17592186567157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de07726-58f6-5f73-b863-f8afab4e1c8f" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt{-2\\ln|x|+C}" :db/id #edb/ref 17592186567174} {:answer/id #uuid "a1875a7a-51e4-5a07-9308-9735d0a1dde6" :answer/type {:db/ident :answer.type/math} :answer/value "y=x(-4\\ln|x|+C)^2" :db/id #edb/ref 17592186567181} {:answer/id #uuid "d8d0200b-aa5b-5a87-8ab2-2668e57d18fc" :answer/type {:db/ident :answer.type/math} :answer/value "y=x(-6\\ln|x|+C)" :db/id #edb/ref 17592186567183} {:answer/id #uuid "e40fe086-141b-59ea-bb51-36d8df716744" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-6\\ln|x|+C}" :db/id #edb/ref 17592186567185} {:answer/id #uuid "ee631a80-54cd-5f8e-9d1a-a43791010e05" :answer/type {:db/ident :answer.type/math} :answer/value "y=x^2(-6\\ln|x|+C)" :db/id #edb/ref 17592186567186}] :answer-field/correct {:answer/id #uuid "e40fe086-141b-59ea-bb51-36d8df716744" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-6\\ln|x|+C}" :db/id #edb/ref 17592186567185} :answer-field/id #uuid "441e14d4-c75f-58ce-99d2-6eda7fa138a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567162}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "14c59b9c-9898-5981-8eeb-e3c3847c9e85" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-2x^3+y^3}{xy^2}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-2x^3+(vx)^3}{x(vx)^2} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-2+v^3}{v^2}=\\frac{-2}{v^2}+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-2}{v^2} \\\\ v^2\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-2}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v^2\\,\\mathrm{d}v&=-2\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\frac{v^3}{3}&=-2\\ln|x|+C_1 \\\\ v^3&=-6\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\left(\\frac{y}{x}\\right)^3&=-6\\ln|x|+C \\\\ y^3&=x^3(-6\\ln|x|+C) \\\\ y&=x\\sqrt[3]{-6\\ln|x|+C}\\end{aligned}\n$$\n\nHere $C=3C_1$ and the cube root is real. Restrict the solution to intervals where $y\\ne0$.\n\nThe solution is used on intervals where $x\\ne0$ and $y\\ne0$."} {:db/id #edb/ref 17592186567160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14b066f4-4aed-54e4-ac8e-dda7e0de8355" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{12\\ln|x|+C}" :db/id #edb/ref 17592186567156} {:answer/id #uuid "1f2c49bd-7234-5991-b192-bafd8e3ae024" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt{4\\ln|x|+C}" :db/id #edb/ref 17592186567159} {:answer/id #uuid "7302a1d3-6f54-5755-b057-1f9a8eb5c77e" :answer/type {:db/ident :answer.type/math} :answer/value "y=x(8\\ln|x|+C)^2" :db/id #edb/ref 17592186567170} {:answer/id #uuid "9d1fa502-efec-5568-818f-b442c164f06f" :answer/type {:db/ident :answer.type/math} :answer/value "y=x(12\\ln|x|+C)" :db/id #edb/ref 17592186567178} {:answer/id #uuid "d3e8de7f-11cc-50d1-96ac-1a3238c95b38" :answer/type {:db/ident :answer.type/math} :answer/value "y=x^2(12\\ln|x|+C)" :db/id #edb/ref 17592186567182}] :answer-field/correct {:answer/id #uuid "14b066f4-4aed-54e4-ac8e-dda7e0de8355" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{12\\ln|x|+C}" :db/id #edb/ref 17592186567156} :answer-field/id #uuid "95eba5e4-d1fe-5b11-ada8-85aabed1f8dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567177}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "2575ad75-ecae-5053-bd6f-925ac6982583" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{4x^3+y^3}{xy^2}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{4x^3+(vx)^3}{x(vx)^2} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{4+v^3}{v^2}=\\frac{4}{v^2}+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{4}{v^2} \\\\ v^2\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{4}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v^2\\,\\mathrm{d}v&=4\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\frac{v^3}{3}&=4\\ln|x|+C_1 \\\\ v^3&=12\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\left(\\frac{y}{x}\\right)^3&=12\\ln|x|+C \\\\ y^3&=x^3(12\\ln|x|+C) \\\\ y&=x\\sqrt[3]{12\\ln|x|+C}\\end{aligned}\n$$\n\nHere $C=3C_1$ and the cube root is real. Restrict the solution to intervals where $y\\ne0$.\n\nThe solution is used on intervals where $x\\ne0$ and $y\\ne0$."} {:db/id #edb/ref 17592186567161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a54a25e-c2da-560f-944f-0aa251938d3d" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4\\ln|x|+Cx" :db/id #edb/ref 17592186567166} {:answer/id #uuid "798be044-79ad-575c-9a9c-79ea53d43171" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x\\ln|x|+C" :db/id #edb/ref 17592186567171} {:answer/id #uuid "7be5f568-a6f3-513f-af44-19d3adcdf073" :answer/type {:db/ident :answer.type/math} :answer/value "y=-8x\\ln|x|+Cx^2" :db/id #edb/ref 17592186567172} {:answer/id #uuid "91cb8bb6-c80a-5286-ba98-3a7085744f62" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4\\ln|x|+Cx^2" :db/id #edb/ref 17592186567175} {:answer/id #uuid "a027748e-15f1-5e67-8fba-ccf0922fd80b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x\\ln|x|+Cx" :db/id #edb/ref 17592186567180}] :answer-field/correct {:answer/id #uuid "a027748e-15f1-5e67-8fba-ccf0922fd80b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4x\\ln|x|+Cx" :db/id #edb/ref 17592186567180} :answer-field/id #uuid "7097afc5-ccdc-5d12-8650-7ab04dfb6cc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567169}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "42363691-301e-5615-be59-d0f1dea51b33" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-4x+y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-4x+(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=-4+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=-4 \\\\ \\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-4}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\mathrm{d}v&=-4\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ v&=-4\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=-4\\ln|x|+C \\\\ y&=-4x\\ln|x|+Cx\\end{aligned}\n$$\n\n\n\nThe solution is used on intervals where $x\\ne0$."} {:db/id #edb/ref 17592186567173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "011cc7e9-984a-5e87-9d00-e574f53f42be" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2-6x" :db/id #edb/ref 17592186567152} {:answer/id #uuid "69e6cea4-2f9f-5b0a-ab0c-77cd1fbc615c" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^3+6x" :db/id #edb/ref 17592186567167} {:answer/id #uuid "6ac73021-fbb0-59bd-a82c-a377e9ceb430" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^3-6x^2" :db/id #edb/ref 17592186567168} {:answer/id #uuid "943a18de-d8dc-53f7-93bb-efbd8d79fcc0" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^3-12x" :db/id #edb/ref 17592186567176} {:answer/id #uuid "e35b6663-8b09-584d-9cd8-c852a4db108b" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+12x" :db/id #edb/ref 17592186567184}] :answer-field/correct {:answer/id #uuid "011cc7e9-984a-5e87-9d00-e574f53f42be" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2-6x" :db/id #edb/ref 17592186567152} :answer-field/id #uuid "5839d98f-4e19-5d79-84da-c6787f331cd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186567165}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8370ea02-6e2b-5cde-a685-02002fe09af6" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{6x+2y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{6x+2(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=6+2v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=6+v \\\\ \\frac{1}{6+v}\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\frac{1}{6+v}\\,\\mathrm{d}v&=\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\ln|v+6|&=\\ln|x|+C_1 \\\\ |v+6|&=e^{C_1}|x| \\\\ v+6&=Cx \\\\ v&=Cx-6\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=Cx-6 \\\\ y&=Cx^2-6x\\end{aligned}\n$$\n\nThe signed constant $C$ absorbs $e^{C_1}$. Division by $v+6$ excluded $v=-6$; restoring it permits $C=0$, giving $y=-6x$.\n\nThe solution is used on intervals where $x\\ne0$."} {:db/id #edb/ref 17592186650967 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b7acbc-ba6a-5373-90f8-1fb1bd746430" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186650530} {:answer/id #uuid "387b9173-140e-51ee-b3e6-e1dd1f2434a2" :answer/type {:db/ident :answer.type/math} :answer/value "y=-x\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|)+C" :db/id #edb/ref 17592186650537} {:answer/id #uuid "83b435d0-9f48-5153-bb92-4c0a31c49b2d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{tan}⁡(-\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186650660} {:answer/id #uuid "90886ce9-1908-561a-8fdd-59f0e5653d7f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|)+C" :db/id #edb/ref 17592186650681} {:answer/id #uuid "b4bc2ca8-f09c-5b57-a98e-525c2e2afc32" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{tan}⁡(x+C)" :db/id #edb/ref 17592186650735}] :answer-field/correct {:answer/id #uuid "31b7acbc-ba6a-5373-90f8-1fb1bd746430" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|+C)" :db/id #edb/ref 17592186650530} :answer-field/id #uuid "7ba406f9-2b25-5984-adac-d96cc5a5c6b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186650864}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "854d0d8e-36ce-595c-94d3-8225f1bb08f7" :question/math-academy-id "q-14320" :question/problem "Find the general solution of the following differential equation.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}+yx+{x}^{2}}{{x}^{2}}\n$$" :question/worked-solution "This is a homogeneous equation because it is written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y),\n$$\n\nand we notice that all terms in the numerator and denominator of $f(x,y)$ are of order $2$ (i.e., they are quadratic).\n\nUsing the transformation $y=v(x)x$, we have:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{y}^{2}+yx+{x}^{2}}{{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{(vx)^{2}+(vx)x+{x}^{2}}{{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{{x}^{2}({v}^{2}+v+1)}{{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & ={v}^{2}+v+1-v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & ={v}^{2}+1 \\\\ \\frac{1}{{v}^{2}+1}\\frac{\\text{d}v}{\\text{d}x} & =\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain:\n\n$$\n\\begin{aligned}\\int \\frac{1}{{v}^{2}+1}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int \\frac{1}{{v}^{2}+1}\\,\\text{d}v & =\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\operatorname{arctan}⁡(v) & =\\operatorname{ln}⁡|x|+C \\\\ v & =\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|+C)\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}\\,.\n$$\n\nFinally, substituting the above into our solution, we obtain:\n\n$$\n\\begin{aligned}\\frac{y}{x} & =\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|+C) \\\\ y & =x\\operatorname{tan}⁡(\\operatorname{ln}⁡|x|+C)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186673498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26f12a2c-f5f0-5b38-80c9-b115d206af76" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+6x" :db/id #edb/ref 17592186673497} {:answer/id #uuid "678f298c-c478-5daf-ab27-245bae154add" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+5x" :db/id #edb/ref 17592186673506} {:answer/id #uuid "7257744d-baf9-52bb-a667-330bb49fec45" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+3x" :db/id #edb/ref 17592186673508} {:answer/id #uuid "cf1f52c1-9e2f-5703-bbf2-35294a1c9263" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+7x" :db/id #edb/ref 17592186673517} {:answer/id #uuid "e6c932a9-2118-59f3-8667-5bfbd109a495" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+4x" :db/id #edb/ref 17592186673522}] :answer-field/correct {:answer/id #uuid "678f298c-c478-5daf-ab27-245bae154add" :answer/type {:db/ident :answer.type/math} :answer/value "y=Cx^2+5x" :db/id #edb/ref 17592186673506} :answer-field/id #uuid "103a8f1e-4f0f-51ce-a8a6-ea01b09f1097" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673493}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "30cc31fb-987b-53e1-a0e0-f17337bbd938" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-5x+2y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-5x+2(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=-5+2v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=-5+v \\\\ \\frac{1}{-5+v}\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\frac{1}{-5+v}\\,\\mathrm{d}v&=\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\ln|v-5|&=\\ln|x|+C_1 \\\\ |v-5|&=e^{C_1}|x| \\\\ v-5&=Cx \\\\ v&=Cx+5\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=Cx+5 \\\\ y&=Cx^2+5x\\end{aligned}\n$$\n\nThe signed constant $C$ absorbs $e^{C_1}$. Division by $v-5$ excluded $v=+5$; restoring it permits $C=0$, giving $y=+5x$.\n\nThe solution is used on intervals where $x\\ne0$."} {:db/id #edb/ref 17592186673503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d51935d-6604-58ea-9402-f93f14a1c15e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9x\\ln|x|+Cx" :db/id #edb/ref 17592186673496} {:answer/id #uuid "514c5fa7-4317-5fce-b10d-b459d799ef56" :answer/type {:db/ident :answer.type/math} :answer/value "y=9x\\ln|x|+Cx" :db/id #edb/ref 17592186673504} {:answer/id #uuid "baeffd52-c01a-5250-bb6e-0e51261e9b11" :answer/type {:db/ident :answer.type/math} :answer/value "y=-8x\\ln|x|+Cx" :db/id #edb/ref 17592186673515} {:answer/id #uuid "e1537f74-01c8-5e66-9e68-8eea3359ff5b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-7x\\ln|x|+Cx" :db/id #edb/ref 17592186673520} {:answer/id #uuid "ea5127ff-9fd8-5f23-9d65-d6cda4e06ade" :answer/type {:db/ident :answer.type/math} :answer/value "y=8x\\ln|x|+Cx" :db/id #edb/ref 17592186673523}] :answer-field/correct {:answer/id #uuid "baeffd52-c01a-5250-bb6e-0e51261e9b11" :answer/type {:db/ident :answer.type/math} :answer/value "y=-8x\\ln|x|+Cx" :db/id #edb/ref 17592186673515} :answer-field/id #uuid "c79074eb-ac8b-5c2b-8b93-3c38f1b8a9ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673516}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b4c00e1-aa47-5602-bd0d-168e84572944" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-8x+y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-8x+(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=-8+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=-8 \\\\ \\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-8}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\mathrm{d}v&=-8\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ v&=-8\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=-8\\ln|x|+C \\\\ y&=-8x\\ln|x|+Cx\\end{aligned}\n$$\n\n\n\nThe solution is used on intervals where $x\\ne0$."} {:db/id #edb/ref 17592186673507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d7439-bcd1-5e26-9eb1-5a008b73b1f9" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-15\\ln|x|+C}" :db/id #edb/ref 17592186673494} {:answer/id #uuid "161567f2-2d20-5482-884c-b7b6aeb3f280" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-9\\ln|x|+C}" :db/id #edb/ref 17592186673495} {:answer/id #uuid "3138456f-b7f9-5b66-bc73-30e7df6c24f4" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-12\\ln|x|+C}" :db/id #edb/ref 17592186673499} {:answer/id #uuid "37c60102-735e-5f3f-a2f1-f9c0cf04a103" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-6\\ln|x|+C}" :db/id #edb/ref 17592186673500} {:answer/id #uuid "e3b1ebf6-4ad9-5386-b26a-47040c79f52d" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-3\\ln|x|+C}" :db/id #edb/ref 17592186673521}] :answer-field/correct {:answer/id #uuid "161567f2-2d20-5482-884c-b7b6aeb3f280" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{-9\\ln|x|+C}" :db/id #edb/ref 17592186673495} :answer-field/id #uuid "ba1e2ba0-cc10-5fde-aafd-f3afb52730fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673514}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6b425fb8-4418-5edc-933b-1ae101a41660" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{-3x^3+y^3}{xy^2}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-3x^3+(vx)^3}{x(vx)^2} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{-3+v^3}{v^2}=\\frac{-3}{v^2}+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-3}{v^2} \\\\ v^2\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{-3}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v^2\\,\\mathrm{d}v&=-3\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\frac{v^3}{3}&=-3\\ln|x|+C_1 \\\\ v^3&=-9\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\left(\\frac{y}{x}\\right)^3&=-9\\ln|x|+C \\\\ y^3&=x^3(-9\\ln|x|+C) \\\\ y&=x\\sqrt[3]{-9\\ln|x|+C}\\end{aligned}\n$$\n\nHere $C=3C_1$ and the cube root is real. Restrict the solution to intervals where $y\\ne0$.\n\nThe solution is used on intervals where $x\\ne0$ and $y\\ne0$."} {:db/id #edb/ref 17592186673512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0378c6c1-1689-51b3-8e5d-fb43415a1974" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{6\\ln|x|+C}" :db/id #edb/ref 17592186673490} {:answer/id #uuid "38955d01-ccd4-560b-9139-6c453f5555a2" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{9\\ln|x|+C}" :db/id #edb/ref 17592186673501} {:answer/id #uuid "4898faf8-30ee-573e-bf75-852d9288d67c" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{18\\ln|x|+C}" :db/id #edb/ref 17592186673502} {:answer/id #uuid "9981dd32-3989-5e26-909d-46df1a93e73a" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{12\\ln|x|+C}" :db/id #edb/ref 17592186673510} {:answer/id #uuid "d9893475-8584-50b4-b9fe-32d8380fbe44" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{15\\ln|x|+C}" :db/id #edb/ref 17592186673519}] :answer-field/correct {:answer/id #uuid "4898faf8-30ee-573e-bf75-852d9288d67c" :answer/type {:db/ident :answer.type/math} :answer/value "y=x\\sqrt[3]{18\\ln|x|+C}" :db/id #edb/ref 17592186673502} :answer-field/id #uuid "ec11a14d-eb08-534c-9e8f-f43faa60a50b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673524}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ab3a19b0-a384-5471-b89f-af5746a38437" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{6x^3+y^3}{xy^2}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{6x^3+(vx)^3}{x(vx)^2} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{6+v^3}{v^2}=\\frac{6}{v^2}+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{6}{v^2} \\\\ v^2\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{6}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int v^2\\,\\mathrm{d}v&=6\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ \\frac{v^3}{3}&=6\\ln|x|+C_1 \\\\ v^3&=18\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\left(\\frac{y}{x}\\right)^3&=18\\ln|x|+C \\\\ y^3&=x^3(18\\ln|x|+C) \\\\ y&=x\\sqrt[3]{18\\ln|x|+C}\\end{aligned}\n$$\n\nHere $C=3C_1$ and the cube root is real. Restrict the solution to intervals where $y\\ne0$.\n\nThe solution is used on intervals where $x\\ne0$ and $y\\ne0$."} {:db/id #edb/ref 17592186673518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7aa767-09c1-5f33-beee-56d2dc091085" :answer/type {:db/ident :answer.type/math} :answer/value "y=9x\\ln|x|+Cx" :db/id #edb/ref 17592186673491} {:answer/id #uuid "0af3e1f8-e33c-58bd-8211-dc7a53c2e32e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9x\\ln|x|+Cx" :db/id #edb/ref 17592186673492} {:answer/id #uuid "649a7d8b-200a-5233-af08-7df509c94bad" :answer/type {:db/ident :answer.type/math} :answer/value "y=-6x\\ln|x|+Cx" :db/id #edb/ref 17592186673505} {:answer/id #uuid "9efd76df-fb57-5448-8be0-69dfed592e9b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-7x\\ln|x|+Cx" :db/id #edb/ref 17592186673511} {:answer/id #uuid "aec599be-75e7-5ce7-b9ec-a7bb418c544b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-8x\\ln|x|+Cx" :db/id #edb/ref 17592186673513}] :answer-field/correct {:answer/id #uuid "0a7aa767-09c1-5f33-beee-56d2dc091085" :answer/type {:db/ident :answer.type/math} :answer/value "y=9x\\ln|x|+Cx" :db/id #edb/ref 17592186673491} :answer-field/id #uuid "81a5f1e5-e390-5a6a-aea6-e93552d4299b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673509}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2255ee7-abce-50d0-aa0c-7b7dbf70082c" :question/problem "Use the transformation $y=v(x)x$ to find the general solution of the following homogeneous differential equation.\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x}=\\frac{9x+y}{x}\n$$" :question/worked-solution "With $y=v(x)x$, we have\n\n$$\n\\begin{aligned}\\frac{\\mathrm{d}y}{\\mathrm{d}x}&=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\frac{\\mathrm{d}}{\\mathrm{d}x}(x) \\\\ &=x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=\\frac{9x+(vx)}{x} \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}+v&=9+v \\\\ x\\frac{\\mathrm{d}v}{\\mathrm{d}x}&=9 \\\\ \\frac{\\mathrm{d}v}{\\mathrm{d}x}&=\\frac{9}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain\n\n$$\n\\begin{aligned}\\int\\mathrm{d}v&=9\\int\\frac{1}{x}\\,\\mathrm{d}x \\\\ v&=9\\ln|x|+C\\end{aligned}\n$$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}&=9\\ln|x|+C \\\\ y&=9x\\ln|x|+Cx\\end{aligned}\n$$\n\n\n\nThe solution is used on intervals where $x\\ne0$."}] :knowledge-point/title "Solving a Homogeneous Differential Equation"}]}
