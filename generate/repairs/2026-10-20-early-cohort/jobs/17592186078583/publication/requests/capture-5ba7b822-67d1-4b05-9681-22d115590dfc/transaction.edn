difficulty :question.difficulty/easy] [:db/add "b5ef480f-cab8-56b2-b101-1cd236aefb8b" :question/answer-fields "67689e41-dfd8-5c25-9e22-2f29da1c6a06"] [:db/ensure "b5ef480f-cab8-56b2-b101-1cd236aefb8b" :question/validate] [:db/add 17592186078583 :knowledge-point/questions "b5ef480f-cab8-56b2-b101-1cd236aefb8b"] [:db/add "1549dbdf-903f-520c-95cf-de4580ba5f86" :answer/id #uuid "1549dbdf-903f-520c-95cf-de4580ba5f86"] [:db/add "1549dbdf-903f-520c-95cf-de4580ba5f86" :answer/type :answer.type/math] [:db/add "1549dbdf-903f-520c-95cf-de4580ba5f86" :answer/value "{T}^{′}(t)=-k(T-12)"] [:db/ensure "1549dbdf-903f-520c-95cf-de4580ba5f86" :answer/validate] [:db/add "89dc4e2b-c511-5563-b3cc-24a3ff4732dc" :answer/id #uuid "89dc4e2b-c511-5563-b3cc-24a3ff4732dc"] [:db/add "89dc4e2b-c511-5563-b3cc-24a3ff4732dc" :answer/type :answer.type/math] [:db/add "89dc4e2b-c511-5563-b3cc-24a3ff4732dc" :answer/value "{T}^{′}(t)=-k(T+12)"] [:db/ensure "89dc4e2b-c511-5563-b3cc-24a3ff4732dc" :answer/validate] [:db/add "91ae9a0e-69e4-53c4-b072-1d2d9e000d86" :answer/id #uuid "91ae9a0e-69e4-53c4-b072-1d2d9e000d86"] [:db/add "91ae9a0e-69e4-53c4-b072-1d2d9e000d86" :answer/type :answer.type/math] [:db/add "91ae9a0e-69e4-53c4-b072-1d2d9e000d86" :answer/value "{T}^{′}(t)=kT(T+12)"] [:db/ensure "91ae9a0e-69e4-53c4-b072-1d2d9e000d86" :answer/validate] [:db/add "1df47aa2-06b7-5590-b63f-6c526362e681" :answer/id #uuid "1df47aa2-06b7-5590-b63f-6c526362e681"] [:db/add "1df47aa2-06b7-5590-b63f-6c526362e681" :answer/type :answer.type/math] [:db/add "1df47aa2-06b7-5590-b63f-6c526362e681" :answer/value "{T}^{′}(t)=kT(T-12)"] [:db/ensure "1df47aa2-06b7-5590-b63f-6c526362e681" :answer/validate] [:db/add "50100a02-dd89-53f4-b9ea-de267bdc2ed6" :answer/id #uuid "50100a02-dd89-53f4-b9ea-de267bdc2ed6"] [:db/add "50100a02-dd89-53f4-b9ea-de267bdc2ed6" :answer/type :answer.type/math] [:db/add "50100a02-dd89-53f4-b9ea-de267bdc2ed6" :answer/value "{T}^{′}(t)=k(T-12)"] [:db/ensure "50100a02-dd89-53f4-b9ea-de267bdc2ed6" :answer/vali