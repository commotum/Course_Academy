-field/correct {:answer/id #uuid "640702b5-3be2-50a4-92d4-b39d3a3bb8b0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624693} :answer-field/id #uuid "4b3ea1f2-240b-50c6-825e-e8787a3d9850" :answer-field/key "$\\mathbb{Q}^{+}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624689} {:answer-field/choices [{:answer/id #uuid "40d732ed-b2cf-531c-a205-f49b31dfae31" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624686} {:answer/id #uuid "7e69335e-6008-5b7f-9600-3dde433a1161" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624703}] :answer-field/correct {:answer/id #uuid "7e69335e-6008-5b7f-9600-3dde433a1161" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624703} :answer-field/id #uuid "6c3f675f-bf6e-5134-bd4b-e180f3bf6929" :answer-field/key "$\\mathbb{R}_0^{-}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624695} {:answer-field/choices [{:answer/id #uuid "757947ac-9933-53a3-9c9d-2fcaea91c9f9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624700} {:answer/id #uuid "f6a3a4a4-9f54-578f-a657-29d14b589a98" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624725}] :answer-field/correct {:answer/id #uuid "757947ac-9933-53a3-9c9d-2fcaea91c9f9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624700} :answer-field/id #uuid "bb06c69f-9c84-5cff-97f1-855600e236ee" :answer-field/key "$\\mathbb{N}_0$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624713}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "05128974-4082-5f79-84f1-a525d461411d" :question/problem "To which of the following sets do all the negative integers belong?\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "We must check whether each set contains all the negative integers.\n\n- The set $\\mathbb{Q}^{+}$ contains the positive rational numbers. For instance, $-1$ is in the given class but not in $\\mathbb{Q}^{+}$. Therefore, this set does not contain all the negative integers.\n\n- The set $\\mathbb{R}_0^{-}$ contains the nonpositive real numbers. By the number-set hierarchy and the sign restrictions, every member of the given class belongs to $\\mathbb{R}_0^{-}$.\n\n- The set $\\mathbb{R}^{+}$ contains the positive real numbers. For instance, $-1$ is in the given class but not in $\\mathbb{R}^{+}$. Therefore, this set does not contain all the negative integers.\n\n- The set $\\mathbb{N}_0$ contains the nonnegative integers. For instance, $-1$ is in the given class but not in $\\mathbb{N}_0$. Therefore, this set does not contain all the negative integers.\n\nTherefore, select $\\mathbb{R}_0^{-}$ only."} {:db/id #edb/ref 17592186624674 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046c4ea1-b4f1-55f0-8566-85776362a1b9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624667} {:answer/id #uuid "da90a2a4-472e-51f0-af6d-146a05e6f5af" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186624718}] :answer-field/correct {:answer/id #uuid "046c4ea1-b4f1-55f0-8566-85776362a1b9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624667} :answer-field/id #uuid "12073a69-2860-5e80-81a7-a1e64a078884" :answer-field/key "$\\mathbb{Q}^{-}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186624671} {:answer-field/choices [{:answer/id #uuid "fbdb537f-c3ce-5af4-a4aa-fc6cf9135e2c" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186624728} {:answer/id #uuid "fd7c41ab-5faf-534a-872c-c2f33073633b" :answer/type {:db/ident :answer.type/te