fore, $-\\sqrt{82}$ does not belong to $\\mathbb{Z}^{-}$.\n\n- The set $\\mathbb{Z}_0^{+}$ contains the nonnegative integers. Therefore, $-\\sqrt{82}$ does not belong to $\\mathbb{Z}_0^{+}$.\n\n- The set $\\mathbb{C}$ contains all complex numbers. Therefore, $-\\sqrt{82}$ belongs to $\\mathbb{C}$.\n\nTherefore, select \"I and IV only\"."] [:db/add "779d1976-b41d-58cd-bc38-74c04af91388" :question/difficulty :question.difficulty/easy] [:db/add "779d1976-b41d-58cd-bc38-74c04af91388" :question/answer-fields "f23578cb-4a78-5d47-9911-99c2966d4ddd"] [:db/ensure "779d1976-b41d-58cd-bc38-74c04af91388" :question/validate] [:db/add 17592186054816 :knowledge-point/questions "779d1976-b41d-58cd-bc38-74c04af91388"] [:db/add "018b1ce0-253d-546b-8b4b-23fba2a1dd1a" :answer/id #uuid "018b1ce0-253d-546b-8b4b-23fba2a1dd1a"] [:db/add "018b1ce0-253d-546b-8b4b-23fba2a1dd1a" :answer/type :answer.type/text] [:db/add "018b1ce0-253d-546b-8b4b-23fba2a1dd1a" :answer/value "false"] [:db/ensure "018b1ce0-253d-546b-8b4b-23fba2a1dd1a" :answer/validate] [:db/add "f025a4b3-3a0a-5999-be24-f36b3a6e7051" :answer/id #uuid "f025a4b3-3a0a-5999-be24-f36b3a6e7051"] [:db/add "f025a4b3-3a0a-5999-be24-f36b3a6e7051" :answer/type :answer.type/text] [:db/add "f025a4b3-3a0a-5999-be24-f36b3a6e7051" :answer/value "true"] [:db/ensure "f025a4b3-3a0a-5999-be24-f36b3a6e7051" :answer/validate] [:db/add "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f" :answer-field/id #uuid "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f"] [:db/add "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f" :answer-field/key "$\\mathbb{R}$"] [:db/add "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f" :answer-field/type :answer-field.type/checkbox] [:db/add "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f" :answer-field/choices "018b1ce0-253d-546b-8b4b-23fba2a1dd1a"] [:db/add "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f" :answer-field/choices "f025a4b3-3a0a-5999-be24-f36b3a6e7051"] [:db/add "82f47dc6-ad18-58cb-ae9d-9e41fb01c64f" :answer-field/correct "f025a4b3-3a0a-5999-be24-f36b3a6e7051"] [:db/ensure "82f47dc