f9a74758da2a"] [:db/add "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/choices "d2bfed6c-1442-581c-bcee-c562de96f9ba"] [:db/add "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/choices "211cd47c-316a-5b1e-bd34-917a872f8104"] [:db/add "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/choices "382bad1b-8bd7-5a2c-91b2-a839a24eb03a"] [:db/add "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/choices "78bfd2d2-c99e-5e73-89ba-284716020227"] [:db/add "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/correct "d2bfed6c-1442-581c-bcee-c562de96f9ba"] [:db/ensure "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/validate] [:db/add "c5af106b-33d7-5d3d-bade-0ced92682383" :question/id #uuid "c5af106b-33d7-5d3d-bade-0ced92682383"] [:db/add "c5af106b-33d7-5d3d-bade-0ced92682383" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-3 \\\\ 3x+ky &=0\\end{aligned}\\right.\n$$"] [:db/add "c5af106b-33d7-5d3d-bade-0ced92682383" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 3 & k & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 3 & k & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 0 & k+9 & 9\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-3 \\\\ (k+9)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-9,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-9.$"] [:db/add "c5af106b-33d7-5d3d-bade-0ced92682383" :question/difficulty :question.difficulty/easy] [:db/add "c5af106b-33d7-5d3d-bade-0ced92682383" :question/answer-fields "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7"] [:db/ensure "c5af106b-33d7-5d3d-bade-0ced92682383" :question/validate] [:db/add 17592186115242 :knowledge-point/questions "c5af106b-33d7-5d3d-bade-0ced92682383"] [:db/add "879ad630-9d2f-568c-8679-659f0ddc56fc" :answer/id #uuid "879ad630-9d2f-568c-8679-659f0ddc56fc"] [:db/add "879ad630-9d2f-568c-8679-659f0ddc56fc" :answer/type :answer.type/math] [:db/add "879ad630-9d2f-568c-8679-659f0ddc56fc" :answer/value "k=-18"] [:db/ensure "879ad630-9d2f-568c-8679-659f0ddc56fc" :answer/validate] [:db/add "25a84b70-9245-5d97-a4d9-55045854331f" :answer/id #uuid "25a84b70-9245-5d97-a4d9-55045854331f"] [:db/add "25a84b70-9245-5d97-a4d9-55045854331f" :answer/type :answer.type/math] [:db/add "25a84b70-9245-5d97-a4d9-55045854331f" :answer/value "k=-12"] [:db/ensure "25a84b70-9245-5d97-a4d9-55045854331f" :answer/validate] [:db/add "4116de3c-ec2b-537f-a54c-e14f8c2d7871" :answer/id #uuid "4116de3c-ec2b-537f-a54c-e14f8c2d7871"] [:db/add "4116de3c-ec2b-537f-a54c-e14f8c2d7871" :answer/type :answer.type/math] [:db/add "4116de3c-ec2b-537f-a54c-e14f8c2d7871" :answer/value "k=-10"] [:db/ensure "4116de3c-ec2b-537f-a54c-e14f8c2d7871" :answer/validate] [:db/add "c3161b92-ed93-588e-b5d8-221d41adb4bc" :answer/id #uuid "c3161b92-ed93-588e-b5d8-221d41adb4bc"] [:db/add "c3161b92-ed93-588e-b5d8-221d41adb4bc" :answer/type :answer.type/math] [:db/add "c3161b92-ed93-588e-b5d8-221d41adb4bc" :answer/value "k=-14"] [:db/ensure "c3161b92-ed93-588e-b5d8-221d41adb4bc" :answer/validate] [:db/add "2d9d77cc-bf23-57d7-922e-1fb20688eb3b" :answer/id #uuid "2d9d77cc-bf23-57d7-922e-1fb20688eb3b"] [:db/add "2d9d77cc-bf23-57d7-922e-1fb20688eb3b" :answer/type :answer.type/math] [:db/add "2d9d77cc-bf23-57d7-922e-1fb20688eb3b" :answer/value "k=-16"] [:db/ensure "2d9d77cc-bf23-57d7-922e-1fb20688eb3b" :answer/validate] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/id #uuid "7ee32c4a-a732-5943-9bdb-dec719ab233a"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/key "selection"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/type :answer-field.type/radio] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/choices "879ad630-9d2f-568c-8679-659f0ddc56fc"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/choices "25a84b70-9245-5d97-a4d9-55045854331f"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/choices "4116de3c-ec2b-537f-a54c-e14f8c2d7871"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/choices "c3161b92-ed93-588e-b5d8-221d41adb4bc"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/choices "2d9d77cc-bf23-57d7-922e-1fb20688eb3b"] [:db/add "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/correct "25a84b70-9245-5d97-a4d9-55045854331f"] [:db/ensure "7ee32c4a-a732-5943-9bdb-dec719ab233a" :answer-field/validate] [:db/add "8ed86d41-824a-5162-a0b1-66e0498bfd9d" :question/id #uuid "8ed86d41-824a-5162-a0b1-66e0498bfd9d"] [:db/add "8ed86d41-824a-5162-a0b1-66e0498bfd9d" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-3 \\\\ 3x+ky &=0\\end{aligned}\\right.\n$$"] [:db/add "8ed86d41-824a-5162-a0b1-66e0498bfd9d" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -4 & -3 \\\\ 3 & k & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -4 & -3 \\\\ 3 & k & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & -3 \\\\ 0 & k+12 & 9\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-4y &=-3 \\\\ (k+12)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-12,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-12.$"] [:db/add "8ed86d41-824a-5162-a0b1-66e0498bfd9d" :question/difficulty :question.difficulty/easy] [:db/add "8ed86d41-824a-5162-a0b1-66e0498bfd9d" :question/answer-fields "7ee32c4a-a732-5943-9bdb-dec719ab233a"] [:db/ensure "8ed86d41-824a-5162-a0b1-66e0498bfd9d" :question/validate] [:db/add 17592186115242 :knowledge-point/questions "8ed86d41-824a-5162-a0b1-66e0498bfd9d"] [:db/add "044d5930-e9c2-5606-a6c3-a9b35fdcaf64" :answer/id #uuid "044d5930-e9c2-5606-a6c3-a9b35fdcaf64"] [:db/add "044d5930-e9c2-5606-a6c3-a9b35fdcaf64" :answer/type :answer.type/math] [:db/add "044d5930-e9c2-5606-a6c3-a9b35fdcaf64" :answer/value "k=10"] [:db/ensure "044d5930-e9c2-5606-a6c3-a9b35fdcaf64" :answer/validate] [:db/add "1fb6ed59-3b1b-5e76-8348-af3553644638" :answer/id #uuid "1fb6ed59-3b1b-5e76-8348-af3553644638"] [:db/add "1fb6ed59-3b1b-5e76-8348-af3553644638" :answer/type :answer.type/math] [:db/add "1fb6ed59-3b1b-5e76-8348-af3553644638" :answer/value "k=13"] [:db/ensure "1fb6ed59-3b1b-5e76-8348-af3553644638" :answer/validate] [:db/add "483b361a-fa4f-569e-9ee3-9a27510e751b" :answer/id #uuid "483b361a-fa4f-569e-9ee3-9a27510e751b"] [:db/add "483b361a-fa4f-569e-9ee3-9a27510e751b" :answer/type :answer.type/math] [:db/add "483b361a-fa4f-569e-9ee3-9a27510e751b" :answer/value "k=12"] [:db/ensure "483b361a-fa4f-569e-9ee3-9a27510e751b" :answer/validate] [:db/add "f0daf48f-38d9-5ace-b9ce-998b60036b8f" :answer/id #uuid "f0daf48f-38d9-5ace-b9ce-998b60036b8f"] [:db/add "f0daf48f-38d9-5ace-b9ce-998b60036b8f" :answer/type :answer.type/math] [:db/add "f0daf48f-38d9-5ace-b9ce-998b60036b8f" :answer/value "k=11"] [:db/ensure "f0daf48f-38d9-5ace-b9ce-998b60036b8f" :answer/validate] [:db/add "3fb5c6d1-171c-5fac-96b5-ed6bc2cb9d60" :answer/id #uuid "3fb5c6d1-171c-5fac-96b5-ed6bc2cb9d60"] [:db/add "3fb5c6d1-171c-5fac-96b5-ed6bc2cb9d60" :answer/type :answer.type/math] [:db/add "3fb5c6d1-171c-5fac-96b5-ed6bc2cb9d60" :answer/value "k=9"] [:db/ensure "3fb5c6d1-171c-5fac-96b5-ed6bc2cb9d60" :answer/validate] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/id #uuid "30e37415-1b5c-5c67-9e63-cfb4eac11039"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/key "selection"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/type :answer-field.type/radio] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/choices "044d5930-e9c2-5606-a6c3-a9b35fdcaf64"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/choices "1fb6ed59-3b1b-5e76-8348-af3553644638"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/choices "483b361a-fa4f-569e-9ee3-9a27510e751b"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/choices "f0daf48f-38d9-5ace-b9ce-998b60036b8f"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/choices "3fb5c6d1-171c-5fac-96b5-ed6bc2cb9d60"] [:db/add "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/correct "483b361a-fa4f-569e-9ee3-9a27510e751b"] [:db/ensure "30e37415-1b5c-5c67-9e63-cfb4eac11039" :answer-field/validate] [:db/add "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3" :question/id #uuid "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3"] [:db/add "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x+4y &=0 \\\\ 3x+ky &=3\\end{aligned}\\right.\n$$"] [:db/add "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & 4 & 0 \\\\ 3 & k & 3\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & 4 & 0 \\\\ 3 & k & 3\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 4 & 0 \\\\ 0 & k-12 & 3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x+4y &=0 \\\\ (k-12)y &=3.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=12,$ then the second equation is $0=3,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=12.$"] [:db/add "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3" :question/difficulty :question.difficulty/easy] [:db/add "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3" :question/answer-fields "30e37415-1b5c-5c67-9e63-cfb4eac11039"] [:db/ensure "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3" :question/validate] [:db/add 17592186115242 :knowledge-point/questions "a517c468-3f32-5c1a-8a0c-9837c0f8f4a3"] [:db/add "67823551-800c-5cf7-948d-beb12cd02bf4" :answer/id #uuid "67823551-800c-5cf7-948d-beb12cd02bf4"] [:db/add "67823551-800c-5cf7-948d-beb12cd02bf4" :answer/type :answer.type/math] [:db/add "67823551-800c-5cf7-948d-beb12cd02bf4" :answer/value "k=8"] [:db/ensure "67823551-800c-5cf7-948d-beb12cd02bf4" :answer/validate] [:db/add "c4f936e8-86b0-5f40-9374-4f0caee0a413" :answer/id #uuid "c4f936e8-86b0-5f40-9374-4f0caee0a413"] [:db/add "c4f936e8-86b0-5f40-9374-4f0caee0a413" :answer/type :answer.type/math] [:db/add "c4f936e8-86b0-5f40-9374-4f0caee0a413" :answer/value "k=5"] [:db/ensure "c4f936e8-86b0-5f40-9374-4f0caee0a413" :answer/validate] [:db/add "8b8fa752-119c-51a0-b6e2-66d7985075e0" :answer/id #uuid "8b8fa752-119c-51a0-b6e2-66d7985075e0"] [:db/add "8b8fa752-119c-51a0-b6e2-66d7985075e0" :answer/type :answer.type/math] [:db/add "8b8fa752-119c-51a0-b6e2-66d7985075e0" :answer/value "k=6"] [:db/ensure "8b8fa752-119c-51a0-b6e2-66d7985075e0" :answer/validate] [:db/add "1efe90b4-562a-5953-a6a1-cc05ec46980b" :answer/id #uuid "1efe90b4-562a-5953-a6a1-cc05ec46980b"] [:db/add "1efe90b4-562a-5953-a6a1-cc05ec46980b" :answer/type :answer.type/math] [:db/add "1efe90b4-562a-5953-a6a1-cc05ec46980b" :answer/value "k=7"] [:db/ensure "1efe90b4-562a-5953-a6a1-cc05ec46980b" :answer/validate] [:db/add "98c304e3-a115-5ace-9fab-90964849999e" :answer/id #uuid "98c304e3-a115-5ace-9fab-90964849999e"] [:db/add "98c304e3-a115-5ace-9fab-90964849999e" :answer/type :answer.type/math] [:db/add "98c304e3-a115-5ace-9fab-90964849999e" :answer/value "k=4"] [:db/ensure "98c304e3-a115-5ace-9fab-90964849999e" :answer/validate] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/id #uuid "65831a37-c7e4-528e-a925-5b3e241729ff"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/key "selection"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/type :answer-field.type/radio] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/choices "67823551-800c-5cf7-948d-beb12cd02bf4"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/choices "c4f936e8-86b0-5f40-9374-4f0caee0a413"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/choices "8b8fa752-119c-51a0-b6e2-66d7985075e0"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/choices "1efe90b4-562a-5953-a6a1-cc05ec46980b"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/choices "98c304e3-a115-5ace-9fab-90964849999e"] [:db/add "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/correct "98c304e3-a115-5ace-9fab-90964849999e"] [:db/ensure "65831a37-c7e4-528e-a925-5b3e241729ff" :answer-field/validate] [:db/add "81014666-3726-55af-9dd0-135ed4dcb4b9" :question/id #uuid "81014666-3726-55af-9dd0-135ed4dcb4b9"] [:db/add "81014666-3726-55af-9dd0-135ed4dcb4b9" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-2y &=-2 \\\\ -2x+ky &=-8\\end{aligned}\\right.\n$$"] [:db/add "81014666-3726-55af-9dd0-135ed4dcb4b9" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -2 & -2 \\\\ -2 & k & -8\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -2 & -2 \\\\ -2 & k & -8\\end{array}\\right] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -2 \\\\ 0 & k-4 & -12\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=-2 \\\\ (k-4)y &=-12.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=4,$ then the second equation is $0=-12,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=4.$"] [:db/add "81014666-3726-55af-9dd0-135ed4dcb4b9" :question/difficulty :question.difficulty/easy] [:db/add "81014666-3726-55af-9dd0-135ed4dcb4b9" :question/answer-fields "65831a37-c7e4-528e-a925-5b3e241729ff"] [:db/ensure "81014666-3726-55af-9dd0-135ed4dcb4b9" :question/validate] [:db/add 17592186115242 :knowledge-point/questions "81014666-3726-55af-9dd0-135ed4dcb4b9"] [:db/add "6aee5c58-e2b4-5f01-b8e0-82c1d4d6fae3" :answer/id #uuid "6aee5c58-e2b4-5f01-b8e0-82c1d4d6fae3"] [:db/add "6aee5c58-e2b4-5f01-b8e0-82c1d4d6fae3" :answer/type :answer.type/math] [:db/add "6aee5c58-e2b4-5f01-b8e0-82c1d4d6fae3" :answer/value "k=-11"] [:db/ensure "6aee5c58-e2b4-5f01-b8e0-82c1d4d6fae3" :answer/validate] [:db/add "dbfaa07e-0f58-59c2-893c-21f92247653a" :answer/id #uuid "dbfaa07e-0f58-59c2-893c-21f92247653a"] [:db/add "dbfaa07e-0f58-59c2-893c-21f92247653a" :answer/type :answer.type/math] [:db/add "dbfaa07e-0f58-59c2-893c-21f92247653a" :answer/value "k=-10"] [:db/ensure "dbfaa07e-0f58-59c2-893c-21f92247653a" :answer/validate] [:db/add "fe4de40d-50a1-5d55-88c4-b30849d049d7" :answer/id #uuid "fe4de40d-50a1-5d55-88c4-b30849d049d7"] [:db/add "fe4de40d-50a1-5d55-88c4-b30849d049d7" :answer/type :answer.type/math] [:db/add "fe4de40d-50a1-5d55-88c4-b30849d049d7" :answer/value "k=-9"] [:db/ensure "fe4de40d-50a1-5d55-88c4-b30849d049d7" :answer/validate] [:db/add "c538572d-fdb5-5531-91f3-68a9da295fe9" :answer/id #uuid "c538572d-fdb5-5531-91f3-68a9da295fe9"] [:db/add "c538572d-fdb5-5531-91f3-68a9da295fe9" :answer/type :answer.type/math] [:db/add "c538572d-fdb5-5531-91f3-68a9da295fe9" :answer/value "k=-8"] [:db/ensure "c538572d-fdb5-5531-91f3-68a9da295fe9" :answer/validate] [:db/add "222d2288-8ec8-5e6d-a4d8-095077c48bf0" :answer/id #uuid "222d2288-8ec8-5e6d-a4d8-095077c48bf0"] [:db/add "222d2288-8ec8-5e6d-a4d8-095077c48bf0" :answer/type :answer.type/math] [:db/add "222d2288-8ec8-5e6d-a4d8-095077c48bf0" :answer/value "k=-12"] [:db/ensure "222d2288-8ec8-5e6d-a4d8-095077c48bf0" :answer/validate] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/id #uuid "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/key "selection"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/type :answer-field.type/radio] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/choices "6aee5c58-e2b4-5f01-b8e0-82c1d4d6fae3"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/choices "dbfaa07e-0f58-59c2-893c-21f92247653a"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/choices "fe4de40d-50a1-5d55-88c4-b30849d049d7"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/choices "c538572d-fdb5-5531-91f3-68a9da295fe9"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/choices "222d2288-8ec8-5e6d-a4d8-095077c48bf0"] [:db/add "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/correct "c538572d-fdb5-5531-91f3-68a9da295fe9"] [:db/ensure "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b" :answer-field/validate] [:db/add "6a93d453-0c6e-55ff-bedb-71deca93f8cf" :question/id #uuid "6a93d453-0c6e-55ff-bedb-71deca93f8cf"] [:db/add "6a93d453-0c6e-55ff-bedb-71deca93f8cf" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-4y &=-3 \\\\ 2x+ky &=4\\end{aligned}\\right.\n$$"] [:db/add "6a93d453-0c6e-55ff-bedb-71deca93f8cf" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -4 & -3 \\\\ 2 & k & 4\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -4 & -3 \\\\ 2 & k & 4\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -4 & -3 \\\\ 0 & k+8 & 10\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-4y &=-3 \\\\ (k+8)y &=10.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-8,$ then the second equation is $0=10,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-8.$"] [:db/add "6a93d453-0c6e-55ff-bedb-71deca93f8cf" :question/difficulty :question.difficulty/easy] [:db/add "6a93d453-0c6e-55ff-bedb-71deca93f8cf" :question/answer-fields "c3f58f00-49ce-5578-a2fd-f96ec70eeb0b"] [:db/ensure "6a93d453-0c6e-55ff-bedb-71deca93f8cf" :question/validate] [:db/add 17592186115242 :knowledge-point/questions "6a93d453-0c6e-55ff-bedb-71deca93f8cf"] [:db/add "generator" :question-generator/id #uuid "e083cdd9-caa3-54b0-9d5e-a4fa6ea10ea4"] [:db/add "generator" :question-generator/script "generators/4b/4b1dc96d53691c1e5d73bda23fa8a419c1ca37c02f592bebce091e68f48e79a2/17592186115242.py"] [:db/add 17592186115242 :knowledge-point/question-generator "generator"] [:db/ensure 17592186115242 :knowledge-point/validate]]
