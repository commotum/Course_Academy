/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186673950} {:answer/id #uuid "78bfd2d2-c99e-5e73-89ba-284716020227" :answer/type {:db/ident :answer.type/math} :answer/value "k=-3" :db/id #edb/ref 17592186673958} {:answer/id #uuid "7a99227a-c092-5ab1-ac9c-f9a74758da2a" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186673959} {:answer/id #uuid "d2bfed6c-1442-581c-bcee-c562de96f9ba" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186673973}] :answer-field/correct {:answer/id #uuid "d2bfed6c-1442-581c-bcee-c562de96f9ba" :answer/type {:db/ident :answer.type/math} :answer/value "k=-9" :db/id #edb/ref 17592186673973} :answer-field/id #uuid "a86b78ff-93f2-5f04-8d17-24d0dbd30fe7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186673967}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c5af106b-33d7-5d3d-bade-0ced92682383" :question/problem "Determine the value of $k$ for which the following system of linear equations is inconsistent:\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-3 \\\\ 3x+ky &=0\\end{aligned}\\right.\n$$" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 3 & k & 0\\end{array}\\right].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 3 & k & 0\\end{array}\\right] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -3 \\\\ 0 & k+9 & 9\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-3 \\\\ (k+9)y &=9.\\end{aligned}\\right.\n$$\n\nThe system is inconsistent if it has no solutions. For the system to have no solutions, one of the equations above must be false.\n\nIf $k=-9,$ then the second equation is $0=9,$ which is false, and the system will have no solution.\n\nTherefore, our system is inconsistent when $k=-9.$"}] :knowledge-point/title "Determining the Value of a Constant for Which a Given Linear System Is Consistent or Inconsistent"}]}
