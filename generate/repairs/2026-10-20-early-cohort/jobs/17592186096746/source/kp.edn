$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ -4 & -8 & 12 & -4 \\\\ 2 & 4 & -6 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 4 & -6 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186610166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f7e6c5-bcb1-5241-96d9-13c9e610ba18" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -7 & 10 & 8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610170} {:answer/id #uuid "2a968a91-4521-5fa6-ba45-577d37f796ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 7 & 10 & 8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610172} {:answer/id #uuid "4d445022-2a0d-56ba-a956-c0c0818abae0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 7 & -10 & 8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610175} {:answer/id #uuid "b39afe8e-8bdd-5fec-b01f-a6f008253d68" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -7 & 10 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610188} {:answer/id #uuid "bb21bc03-8383-5527-ae2e-2ce152135f26" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -7 & -10 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610190}] :answer-field/correct {:answer/id #uuid "b39afe8e-8bdd-5fec-b01f-a6f008253d68" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -7 & 10 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610188} :answer-field/id #uuid "20e10e91-06a6-586f-aab6-8c22bbb6153c" :answer-field/ke