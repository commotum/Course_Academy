nM\\sim \\left[\\begin{array}{ccc|c}1 & 7 & -3 & -5 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 14 & -6 & -10\\end{array}\\right].\n$$\n\n\n\n$$\nR_3:=R_3+(-2)R_1\n$$\n\n\n\n$$\nM\\sim \\left[\\begin{array}{ccc|c}1 & 7 & -3 & -5 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right].\n$$\n\n"] [:db/add "fba1b1c0-5b87-50fd-be09-4ef573df8b90" :question/difficulty :question.difficulty/easy] [:db/add "fba1b1c0-5b87-50fd-be09-4ef573df8b90" :question/answer-fields "5ee55e5e-8e9b-5f3c-bba4-5d72822acd05"] [:db/ensure "fba1b1c0-5b87-50fd-be09-4ef573df8b90" :question/validate] [:db/add 17592186096746 :knowledge-point/questions "fba1b1c0-5b87-50fd-be09-4ef573df8b90"] [:db/add "20ecc5f3-596c-52c0-bdea-14ebf9a5246b" :answer/id #uuid "20ecc5f3-596c-52c0-bdea-14ebf9a5246b"] [:db/add "20ecc5f3-596c-52c0-bdea-14ebf9a5246b" :answer/type :answer.type/math] [:db/add "20ecc5f3-596c-52c0-bdea-14ebf9a5246b" :answer/value "\\begin{bmatrix}1 & 9 & 9 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}"] [:db/ensure "20ecc5f3-596c-52c0-bdea-14ebf9a5246b" :answer/validate] [:db/add "9950eb78-3570-5733-9b81-d341c350fd73" :answer/id #uuid "9950eb78-3570-5733-9b81-d341c350fd73"] [:db/add "9950eb78-3570-5733-9b81-d341c350fd73" :answer/type :answer.type/math] [:db/add "9950eb78-3570-5733-9b81-d341c350fd73" :answer/value "\\begin{bmatrix}1 & 3 & 10 & -7 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}"] [:db/ensure "9950eb78-3570-5733-9b81-d341c350fd73" :answer/validate] [:db/add "383ab0dd-d03d-50db-bbe9-50a8fb1ae66c" :answer/id #uuid "383ab0dd-d03d-50db-bbe9-50a8fb1ae66c"] [:db/add "383ab0dd-d03d-50db-bbe9-50a8fb1ae66c" :answer/type :answer.type/math] [:db/add "383ab0dd-d03d-50db-bbe9-50a8fb1ae66c" :answer/value "\\begin{bmatrix}1 & 8 & 1 & -16 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}"] [:db/ensure "383ab0dd-d03d-50db-bbe9-50a8fb1ae66c" :answer/validate] [:db/add "382e1442-5163-5159-979b-135132d12ee5" :answer/id #uuid "382e1442-5163-5159-979b-135132d12ee5"] [:db/add "382e1442-5163-5159-979b-1