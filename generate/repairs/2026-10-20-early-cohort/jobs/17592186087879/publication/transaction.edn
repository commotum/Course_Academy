8eeb-5db3216a077f"] [:db/add "5e4c852a-b5a7-5548-86f3-4fdcbc57ec84" :answer-field/choices "5d2841dd-cab1-595c-837a-44463c1f1faa"] [:db/add "5e4c852a-b5a7-5548-86f3-4fdcbc57ec84" :answer-field/choices "361427c9-4829-5d8d-a97c-f0c8ad00572f"] [:db/add "5e4c852a-b5a7-5548-86f3-4fdcbc57ec84" :answer-field/correct "914e5098-b46c-5412-8eeb-5db3216a077f"] [:db/ensure "5e4c852a-b5a7-5548-86f3-4fdcbc57ec84" :answer-field/validate] [:db/add "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/id #uuid "dcf5ddd4-bac2-5722-b4c3-fac589abf42a"] [:db/add "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+\\left(3\\right)y=18,\\quad y(0)=4\n$$\n\nSelect the correct options below.\n\nAn integrating factor for this equation is $I(x)=$ {{field-1}}.\n\nThe solution to the initial value problem is $y(x)=$ {{field-2}}."] [:db/add "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=3$ and $Q(x)=18.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 3\\,\\text{d}x} \\\\  & =e^{3 x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{3 x}$ yields\n\n$$\n\\begin{aligned}e^{3 x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+3y) & =e^{3 x}\\cdot 18 \\\\ e^{3 x}\\frac{\\text{d}y}{\\text{d}x}+3 e^{3 x}y & =18 e^{3 x} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{3 x}) & =18 e^{3 x}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{3 x})\\,\\text{d}x & =\\int 18 e^{3 x}\\,\\text{d}x \\\\ ye^{3 x} & =18\\left(\\frac{1}{3} e^{3 x}\\right)+C \\\\ ye^{3 x} & =6 e^{3 x}+C \\\\ y & =\\left(C + 6 e^{3 x}\\right) e^{- 3 x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=4$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(6 e^{3 (0)})+C}{(e^{3 (0)})} \\\\ 4 & =\\frac{6+C}{1} \\\\ C & =-2\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=6 - 2 e^{- 3 x}.\n$$"] [:db/add "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/difficulty :question.difficulty/easy] [:db/add "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/answer-fields "926f24ce-5a73-57d8-ba32-8bac04a8abe5"] [:db/add "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/answer-fields "5e4c852a-b5a7-5548-86f3-4fdcbc57ec84"] [:db/ensure "dcf5ddd4-bac2-5722-b4c3-fac589abf42a" :question/validate] [:db/add 17592186087879 :knowledge-point/questions "dcf5ddd4-bac2-5722-b4c3-fac589abf42a"] [:db/add "6a376b60-4f6b-5e61-b2d8-7e002ec2f00a" :answer/id #uuid "6a376b60-4f6b-5e61-b2d8-7e002ec2f00a"] [:db/add "6a376b60-4f6b-5e61-b2d8-7e002ec2f00a" :answer/type :answer.type/math] [:db/add "6a376b60-4f6b-5e61-b2d8-7e002ec2f00a" :answer/value "e^{6 x}"] [:db/ensure "6a376b60-4f6b-5e61-b2d8-7e002ec2f00a" :answer/validate] [:db/add "7c13b83d-5054-579c-911e-6a3fe51b142b" :answer/id #uuid "7c13b83d-5054-579c-911e-6a3fe51b142b"] [:db/add "7c13b83d-5054-579c-911e-6a3fe51b142b" :answer/type :answer.type/math] [:db/add "7c13b83d-5054-579c-911e-6a3fe51b142b" :answer/value "e^{4 x}"] [:db/ensure "7c13b83d-5054-579c-911e-6a3fe51b142b" :answer/validate] [:db/add "afe1cba0-cf81-5828-8f37-ff2041d05dad" :answer/id #uuid "afe1cba0-cf81-5828-8f37-ff2041d05dad"] [:db/add "afe1cba0-cf81-5828-8f37-ff2041d05dad" :answer/type :answer.type/math] [:db/add "afe1cba0-cf81-5828-8f37-ff2041d05dad" :answer/value "e^{x}"] [:db/ensure "afe1cba0-cf81-5828-8f37-ff2041d05dad" :answer/validate] [:db/add "4f75ca8f-b87a-5ad6-873e-1e043d50179a" :answer/id #uuid "4f75ca8f-b87a-5ad6-873e-1e043d50179a"] [:db/add "4f75ca8f-b87a-5ad6-873e-1e043d50179a" :answer/type :answer.type/math] [:db/add "4f75ca8f-b87a-5ad6-873e-1e043d50179a" :answer/value "e^{3 x}"] [