4e07f3e0" :answer-field/validate] [:db/add "349ca8c0-aa18-5536-91e2-5228615e320b" :question/id #uuid "349ca8c0-aa18-5536-91e2-5228615e320b"] [:db/add "349ca8c0-aa18-5536-91e2-5228615e320b" :question/problem "Find the general solution to the differential equation $y′=\\frac{6 x - 12}{3 y^{2}}.$ Work on intervals where $y\\ne 0$; cube roots are real."] [:db/add "349ca8c0-aa18-5536-91e2-5228615e320b" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\frac{6 x - 12}{3 y^{2}} \\\\ 3 y^{2}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =6 x - 12\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3 y^{2}\\,\\mathrm{d}y & =\\int 6 x - 12\\,\\mathrm{d}x \\\\ y^{3} & =3 \\left(x - 2\\right)^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ny^{3}=3 \\left(x - 2\\right)^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\sqrt[3]{C + 3 \\left(x - 2\\right)^{2}}.\n$$\n\nHere $C$ is an arbitrary real constant."] [:db/add "349ca8c0-aa18-5536-91e2-5228615e320b" :question/difficulty :question.difficulty/easy] [:db/add "349ca8c0-aa18-5536-91e2-5228615e320b" :question/answer-fields "60de23b9-01a7-5c81-a3ec-22524e07f3e0"] [:db/ensure "349ca8c0-aa18-5536-91e2-5228615e320b" :question/validate] [:db/add 17592186068840 :knowledge-point/questions "349ca8c0-aa18-5536-91e2-5228615e320b"] [:db/add "generator" :question-generator/id #uuid "b3dbf88a-2512-5834-bad2-4223c41b025d"] [:db/add "generator" :question-generator/script "generators/89/89015ef9fd221785f4ba65ced7fbce8b46a46b5219335ed046db08d45e044791/17592186068840.py"] [:db/add 17592186068840 :knowledge-point/question-generator "generator"] [:db/ensure 17592186068840 :knowledge-point/validate]]
