[:db/add "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/choices "623c0c49-9e21-57ef-89e7-a97e9e53c353"] [:db/add "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/choices "85b3ccab-157b-52d4-ad5b-5ceacfd368dc"] [:db/add "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/choices "0290a6d7-2380-5108-8789-71bfb77109ab"] [:db/add "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/choices "4ed6957e-4f4f-56e4-b4ca-d10746070f85"] [:db/add "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/choices "8d322dc8-4070-5f87-8b51-bfa4b0de44ec"] [:db/add "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/correct "623c0c49-9e21-57ef-89e7-a97e9e53c353"] [:db/ensure "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/validate] [:db/add "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/id #uuid "a959a07a-ae37-59fb-85ec-1a2785aa394a"] [:db/add "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/problem "Find the general solution to the differential equation $y′=- \\frac{4 x}{3 y^{2}}.$ Work on intervals where $y\\ne 0$; cube roots are real."] [:db/add "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =- \\frac{4 x}{3 y^{2}} \\\\ 3 y^{2}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =- 4 x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3 y^{2}\\,\\mathrm{d}y & =\\int - 4 x\\,\\mathrm{d}x \\\\ y^{3} & =- 2 x^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ny^{3}=- 2 x^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\sqrt[3]{C - 2 x^{2}}.\n$$\n\nHere $C$ is an arbitrary real constant."] [:db/add "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/difficulty :question.difficulty/easy] [:db/add "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/answer-fields "bb033a9e-00be-5d83-9371-6ce820188add"] [:db/ensure "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/validate] [:db/add 17592186068840 :knowledge-point/questions "a959a07a-ae37-59fb-85ec-1a2785aa394a"] [:db/add "4cc19ee9-085a-53a3-9ebd-784a3aa3752f" :answer/id #uuid "4cc19ee9-085a-53a3-9ebd-784a3aa3752f"] [:db/add "4cc19ee9-085a-53a3-9ebd-784a3aa3752f" :answer/type :answer.type/math] [:db/add "4cc19ee9-085a-53a3-9ebd-784a3aa3752f" :answer/value "y=\\left(C - \\left(x + 7\\right)^{2}\\right)^{3}"] [:db/ensure "4cc19ee9-085a-53a3-9ebd-784a3aa3752f" :answer/validate] [:db/add "389dcd83-3be6-5ae7-8536-11e51af3d592" :answer/id #uuid "389dcd83-3be6-5ae7-8536-11e51af3d592"] [:db/add "389dcd83-3be6-5ae7-8536-11e51af3d592" :answer/type :answer.type/math] [:db/add "389dcd83-3be6-5ae7-8536-11e51af3d592" :answer/value "y=\\left(C + \\left(x + 7\\right)^{2}\\right)^{3}"] [:db/ensure "389dcd83-3be6-5ae7-8536-11e51af3d592" :answer/validate] [:db/add "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c" :answer/id #uuid "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c"] [:db/add "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c" :answer/type :answer.type/math] [:db/add "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c" :answer/value "y=\\left(C - 2 \\left(x + 7\\right)^{2}\\right)^{3}"] [:db/ensure "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c" :answer/validate] [:db/add "08259c26-cd01-57fc-8bd4-97710fe61f79" :answer/id #uuid "08259c26-cd01-57fc-8bd4-97710fe61f79"] [:db/add "08259c26-cd01-57fc-8bd4-97710fe61f79" :answer/type :answer.type/math] [:db/add "08259c26-cd01-57fc-8bd4-97710fe61f79" :answer/value "y=\\left(C + 3 \\left(x + 7\\right)^{2}\\right)^{3}"] [:db/ensure "08259c26-cd01-57fc-8bd4-97710fe61f79" :answer/validate] [:db/add "ba88b057-eed7-5cc6-bd3a-e13e9089e059" :answer/id #uuid "ba88b057-eed7-5cc6-bd3a-e13e9089e059"] [:db/add "ba88b057-eed7-5cc6-bd3a-e13e9089e059" :answer/type :answer.type/math] [:db/add "ba88b057-eed7-5cc6-bd3a-e13e9089e059" :answer/value "y=\\left(C + 2 \\left(x + 7\\right)^{2}\\right)^{3}"] [:db/ensure "ba88b057-eed7-5cc6-bd3a-e13e9089e059" :answer/validate] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/id #uuid "d446d84a-f723-5bc5-9258-11f27b7d620c"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/key "selection"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/type :answer-field.type/radio] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/choices "4cc19ee9-085a-53a3-9ebd-784a3aa3752f"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/choices "389dcd83-3be6-5ae7-8536-11e51af3d592"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/choices "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/choices "08259c26-cd01-57fc-8bd4-97710fe61f79"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/choices "ba88b057-eed7-5cc6-bd3a-e13e9089e059"] [:db/add "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/correct "389dcd83-3be6-5ae7-8536-11e51af3d592"] [:db/ensure "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/validate] [:db/add "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/id #uuid "1b625cbe-e98e-52a2-876f-b8846d653bd3"] [:db/add "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/problem "Find the general solution to the differential equation $y′=\\left(6 x + 42\\right)\\sqrt[3]{y^2}.$ Work on intervals where $y\\ne 0$; cube roots are real."] [:db/add "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\left(6 x + 42\\right)\\sqrt[3]{y^2} \\\\ \\frac{1}{3\\sqrt[3]{y^2}}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =2 x + 14\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{3\\sqrt[3]{y^2}}\\,\\mathrm{d}y & =\\int 2 x + 14\\,\\mathrm{d}x \\\\ \\sqrt[3]{y} & =\\left(x + 7\\right)^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\n\\sqrt[3]{y}=\\left(x + 7\\right)^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\left(C + \\left(x + 7\\right)^{2}\\right)^{3}.\n$$\n\nHere $C$ is an arbitrary real constant."] [:db/add "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/difficulty :question.difficulty/easy] [:db/add "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/answer-fields "d446d84a-f723-5bc5-9258-11f27b7d620c"] [:db/ensure "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/validate] [:db/add 17592186068840 :knowledge-point/questions "1b625cbe-e98e-52a2-876f-b8846d653bd3"] [:db/add "b00f57f9-5b2b-5444-9f23-46a31d7ebdbb" :answer/id #uuid "b00f57f9-5b2b-5444-9f23-46a31d7ebdbb"] [:db/add "b00f57f9-5b2b-5444-9f23-46a31d7ebdbb" :answer/type :answer.type/math] [:db/add "b00f57f9-5b2b-5444-9f23-46a31d7ebdbb" :answer/value "y=\\ln{\\left(C - \\left(x - 8\\right)^{2} \\right)}"] [:db/ensure "b00f57f9-5b2b-5444-9f23-46a31d7ebdbb" :answer/validate] [:db/add "6a024c65-98cf-5df3-a7c1-9fef172fd026" :answer/id #uuid "6a024c65-98cf-5df3-a7c1-9fef172fd026"] [:db/add "6a024c65-98cf-5df3-a7c1-9fef172fd026" :answer/type :answer.type/math] [:db/add "6a024c65-98cf-5df3-a7c1-9fef172fd026" :answer/value "y=\\ln{\\left(C - \\frac{\\left(x - 8\\right)^{2}}{2} \\right)}"] [:db/ensure "6a024c65-98cf-5df3-a7c1-9fef172fd026" :answer/validate] [:db/add "90385026-40d1-5b70-9910-305c6baa74f7" :answer/id #uuid "90385026-40d1-5b70-9910-305c6baa74f7"] [:db/add "90385026-40d1-5b70-9910-305c6baa74f7" :answer/type :answer.type/math] [:db/add "90385026-40d1-5b70-9910-305c6baa74f7" :answer/value "y=\\ln{\\left(C + \\frac{3 \\left(x - 8\\right)^{2}}{2} \\right)}"] [:db/ensure "90385026-40d1-5b70-9910-305c6baa74f7" :answer/validate] [:db/add "031a129f-52d6-5681-914e-7769e63f4f73" :answer/id #uuid "031a129f-52d6-5681-914e-7769e63f4f73"] [:db/add "031a129f-52d6-5681-914e-7769e63f4f73" :answer/type :answer.type/math] [:db/add "031a129f-52d6-5681-914e-7769e63f4f73" :answer/value "y=\\ln{\\left(C + \\left(x - 8\\right)^{2} \\right)}"] [:db/ensure "031a129f-52d6-5681-914e-7769e