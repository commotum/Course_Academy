ext{d}x}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{arcsin}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{arcsin}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{arcsin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{arcsin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{arcsin}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{arcsin}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{arcsin}⁡x}.\n$$"} {:db/id #edb/ref 17592186275412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3089ac08-c20b-5f5f-8fde-8ef85e86835d" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{\\operatorname{sec}⁡x}+K" :db/id #edb/ref 17592186272818} {:answer/id #uuid "5193c1ee-640a-53fa-9486-21c5e01f0389" :answer/type {:db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{tan}⁡x}" :db/id #edb/ref 17592186273081} {:answer/id #uuid "6af3d8bf-0ef9-53e9-85b8-da693e7f5bb7" :answer/type {:db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sec}⁡x}" :db/id #edb/ref 17592186273308} {:answer/id #uuid "c058c6a7-887f-54ce-82c3-dd19e85fedb8" :answer/type {:db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186274054} {:answer/id #uuid "f21cb61e-e665-5306-836b-7113089e955b" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{\\operatorname{tan}⁡x}+K" :db/id #edb/ref 17592186274525}] :answer-field/correct {:answer/id #uuid "6af3d8bf-0ef9-53e9-85b8-da693e7f5bb7" :answer/type {:db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sec}⁡x}" :db/id #edb/ref 17592186273308} :answer-field/id #uuid "ec8a4df6-eb47-5a40-a63c-fffc51d10f75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275051}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "594ba672-eefa-575c-8c38-2d0804124171" :question/math-academy-id "q-158017" :question/problem "Find the general solution to the differential equation ${y}^{′}=y\\operatorname{sec}⁡x\\operatorname{tan}⁡x$ for $y\\ne 0$ and $-\\frac{\\pi }{2}<x<\\frac{\\pi }{2}.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y\\operatorname{sec}⁡x\\operatorname{tan}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sec}⁡x\\operatorname{tan}⁡x \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{sec}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{sec}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{sec}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sec}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sec}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{sec}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{sec}⁡x}.\n$$"} {:db/id #edb/ref 17592186326685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "640f91af-9af3-58fc-8a63-9b8699619aae" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{\\operatorname{ln}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186324801} {:answer/id #uuid "a2b6266a-0178-58c9-afc0-b11ab26e4082" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{x}^{2}}{2}\\right)+C" :db/id #edb/ref 17592186325351} {:answer/id #uuid "d6bbf60c-21a8-5de6-bc41-6cabb8ede0a7" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{x}^{2}}{2}+C)" :db/id #edb/ref 17592186325839} {:answer/id #uuid "ede03381-3d73-5674-a3cc-1b91d88fe642" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{x}{2}\\right)+C" :db/id #edb/ref 17592186326063} {:answer/id #uuid "ef576b5f-b070-572f-99c9-6414e6f1049a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186326082}] :answer-field/correct {:answer/id #uuid "d6bbf60c-21a8-5de6-bc41-6cabb8ede0a7" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{x}^{2}}{2}+C)" :db/id #edb/ref 17592186325839} :answer-field/id #uuid "40ee238c-35a5-5dad-bb56-ba165c7577fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326326}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "12b9ca6b-0ddb-5ee4-aeb2-e1fcfdc8bcb6" :question/math-academy-id "q-3850" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x{e}^{-y}.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x{e}^{-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{x}{{e}^{y}} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int x\\,\\text{d}x \\\\ {e}^{y} & =\\frac{{x}^{2}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{e}^{y}=\\frac{{x}^{2}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\operatorname{ln}⁡(\\frac{{x}^{2}}{2}+C).\n$$"} {:db/id #edb/ref 17592186332867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0f0659a-f269-52ef-b304-c23cad84d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=({x}^{2}+C)^{3}" :db/id #edb/ref 17592186331661} {:answer/id #uuid "ca35de27-d1e1-59d0-a2a9-f78785b1444e" :answer/type {:db/ident :answer.type/math} :answer/value "y={x}^{6}+C" :db/id #edb/ref 17592186331740} {:answer/id #uuid "e7b4f4c9-b558-5ee4-a800-ef30f1c79326" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{6x+C}" :db/id #edb/ref 17592186331982} {:answer/id #uuid "f2c90cf3-26dd-5a81-914f-55f2cb12af11" :answer/type {:db/ident :answer.type/math} :answer/value "y=(6x+C)^{3}" :db/id #edb/ref 17592186332088} {:answer/id #uuid "f83e8a13-c62b-51fd-8ed2-ddfc18d4dd51" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{{x}^{2}+C}" :db/id #edb/ref 17592186332130}] :answer-field/correct {:answer/id #uuid "c0f0659a-f269-52ef-b304-c23cad84d0ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=({x}^{2}+C)^{3}" :db/id #edb/ref 17592186331661} :answer-field/id #uuid "441c0ad2-d7c0-5882-98f9-ea5796307051" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332314}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a67e182b-8e5b-5502-83c8-9d36e701587d" :question/math-academy-id "q-51256" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=6x\\sqrt[3]{{y}^{2}}$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =6x\\sqrt[3]{{y}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2x\\cdot 3\\sqrt[3]{{y}^{2}} \\\\ \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x \\\\ \\int \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\text{d}y & =\\int 2x\\,\\text{d}x \\\\ \\frac{1}{3}\\int {y}^{-2/3}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ {y}^{1/3} & ={x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{y}^{1/3}={x}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=({x}^{2}+C)^{3}.\n$$"} {:db/id #edb/ref 17592186551605 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ae2311-48e4-512d-bc98-e93ee56b201e" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\frac{5 \\left(x - 4\\right)^{4}}{4}" :db/id #edb/ref 17592186551604} {:answer/id #uuid "296f39b6-dbd2-59f0-a5e9-b253bd51c990" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C - \\frac{5 \\left(x - 4\\right)^{4}}{2}}" :db/id #edb/ref 17592186551607} {:answer/id #uuid "4c6099ee-3b46-5070-8667-d71d5f0c9b4a" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\frac{\\sqrt{10} \\left(x - 4\\right)^{2}}{2}" :db/id #edb/ref 17592186551613} {:answer/id #uuid "54fc91e8-26b5-58b2-83d7-c34a6bd9e3bc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + 10 \\left(x - 4\\right)^{3}}" :db/id #edb/ref 17592186551615} {:answer/id #uuid "58c86c6d-7619-5b7c-b416-96c1c1700e10" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + \\frac{5 \\left(x - 4\\right)^{4}}{2}}" :db/id #edb/ref 17592186551617}] :answer-field/correct {:answer/id #uuid "58c86c6d-7619-5b7c-b416-96c1c1700e10" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + \\frac{5 \\left(x - 4\\right)^{4}}{2}}" :db/id #edb/ref 17592186551617} :answer-field/id #uuid "efb1736c-eeee-5a04-88e4-57a3ff9c1730" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551642}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "16bf90c3-d378-588a-9105-03dc1e2fe7d8" :question/problem "Find the general solution to the differential equation $y′=\\frac{5 \\left(x - 4\\right)^{3}}{y}.$ Assume $x-4>0.$ Take both sign branches on intervals where the radicand is positive and $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\frac{5 \\left(x - 4\\right)^{3}}{y} \\\\ y\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =5 \\left(x - 4\\right)^{3}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x}\\,\\mathrm{d}x & =\\int 5 \\left(x - 4\\right)^{3}\\,\\mathrm{d}x \\\\ \\int y\\,\\mathrm{d}y & =\\int 5 \\left(x - 4\\right)^{3}\\,\\mathrm{d}x \\\\ \\frac{y^{2}}{2} & =\\frac{5 \\left(x - 4\\right)^{4}}{4}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{2}}{2}=\\frac{5 \\left(x - 4\\right)^{4}}{4}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}y^2 & =\\frac{5 \\left(x - 4\\right)^{4}}{2}+2C \\\\ y & =\\pm\\sqrt{\\frac{5 \\left(x - 4\\right)^{4}}{2}+2C} \\\\ y & =\\pm\\sqrt{\\frac{5 \\left(x - 4\\right)^{4}}{2}+K}\\end{aligned}\n$$\n\nwhere $K=2C$ is an arbitrary real constant. Use either sign consistently on each interval where the radicand is positive."} {:db/id #edb/ref 17592186551618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d258e30-3d6d-563a-8e22-e40f19619bec" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\frac{4 \\left(x - 3\\right)^{3}}{3}" :db/id #edb/ref 17592186551608} {:answer/id #uuid "8326b7c5-af1b-5b98-acb4-56a14bab405e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C - \\frac{8 \\left(x - 3\\right)^{3}}{3}}" :db/id #edb/ref 17592186551622} {:answer/id #uuid "8fe94f93-9195-5b19-a02c-bdfda83b3401" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + 8 \\left(x - 3\\right)^{2}}" :db/id #edb/ref 17592186551624} {:answer/id #uuid "cfd48dc4-1af4-5e7f-b474-e8e828e55194" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\frac{2 \\sqrt{6} \\sqrt{\\left(x - 3\\right)^{3}}}{3}" :db/id #edb/ref 17592186551634} {:answer/id #uuid "ff007452-3669-5b86-be23-b90eb6bb7e32" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + \\frac{8 \\left(x - 3\\right)^{3}}{3}}" :db/id #edb/ref 17592186551644}] :answer-field/correct {:answer/id #uuid "ff007452-3669-5b86-be23-b90eb6bb7e32" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + \\frac{8 \\left(x - 3\\right)^{3}}{3}}" :db/id #edb/ref 17592186551644} :answer-field/id #uuid "a37bede3-b9e4-5f1a-9f47-4fbe78c42aae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551626}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "63e2b730-0d9e-5375-bfbb-085f883671f1" :question/problem "Find the general solution to the differential equation $y′=\\frac{4 \\left(x - 3\\right)^{2}}{y}.$ Assume $x-3>0.$ Take both sign branches on intervals where the radicand is positive and $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\frac{4 \\left(x - 3\\right)^{2}}{y} \\\\ y\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =4 \\left(x - 3\\right)^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x}\\,\\mathrm{d}x & =\\int 4 \\left(x - 3\\right)^{2}\\,\\mathrm{d}x \\\\ \\int y\\,\\mathrm{d}y & =\\int 4 \\left(x - 3\\right)^{2}\\,\\mathrm{d}x \\\\ \\frac{y^{2}}{2} & =\\frac{4 \\left(x - 3\\right)^{3}}{3}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{2}}{2}=\\frac{4 \\left(x - 3\\right)^{3}}{3}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}y^2 & =\\frac{8 \\left(x - 3\\right)^{3}}{3}+2C \\\\ y & =\\pm\\sqrt{\\frac{8 \\left(x - 3\\right)^{3}}{3}+2C} \\\\ y & =\\pm\\sqrt{\\frac{8 \\left(x - 3\\right)^{3}}{3}+K}\\end{aligned}\n$$\n\nwhere $K=2C$ is an arbitrary real constant. Use either sign consistently on each interval where the radicand is positive."} {:db/id #edb/ref 17592186551619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f4aed0-0189-5761-a8c4-d17ec0b87bfc" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + 2 e^{- 2 x}" :db/id #edb/ref 17592186551609} {:answer/id #uuid "965559e9-7c44-561c-9ece-8571d647452a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C - 2 e^{- 2 x} \\right)}" :db/id #edb/ref 17592186551625} {:answer/id #uuid "b419a8ce-d303-52a8-b3ae-0aa9ef7de6c4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C - 4 e^{- 2 x} \\right)}" :db/id #edb/ref 17592186551627} {:answer/id #uuid "e20a6d5a-33a8-5f4f-9479-452bf0556b5a" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\ln{\\left(2 e^{- 2 x} \\right)}" :db/id #edb/ref 17592186551638} {:answer/id #uuid "e48d62c7-effb-500b-862f-6ecda5060a74" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + 2 e^{- 2 x} \\right)}" :db/id #edb/ref 17592186551639}] :answer-field/correct {:answer/id #uuid "e48d62c7-effb-500b-862f-6ecda5060a74" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + 2 e^{- 2 x} \\right)}" :db/id #edb/ref 17592186551639} :answer-field/id #uuid "b58179cf-e8c5-5fe4-81b8-8f5378386268" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551628}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "682503a5-3ea4-50fd-b2dd-c4f6cf554fa9" :question/problem "Find the general solution to the differential equation $y′=- 4 e^{- 2 x - y}.$ Work on intervals where the logarithm argument is positive." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =- 4 e^{- 2 x - y} \\\\ e^{y}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =- 4 e^{- 2 x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int e^{y}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x}\\,\\mathrm{d}x & =\\int - 4 e^{- 2 x}\\,\\mathrm{d}x \\\\ \\int e^{y}\\,\\mathrm{d}y & =\\int - 4 e^{- 2 x}\\,\\mathrm{d}x \\\\ e^{y} & =2 e^{- 2 x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\ne^{y}=2 e^{- 2 x}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\ln{\\left(C + 2 e^{- 2 x} \\right)}.\n$$\n\nThe logarithm argument must be positive on the solution interval; $C$ is an arbitrary real constant."} {:db/id #edb/ref 17592186551620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49b0f93b-d0f2-54df-af0f-6e0cc2394918" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + \\left(x + 4\\right)^{4}}" :db/id #edb/ref 17592186551611} {:answer/id #uuid "c1ed890a-083e-5305-9bea-9bb4d1bea815" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\left(x + 4\\right)^{2}" :db/id #edb/ref 17592186551629} {:answer/id #uuid "cd687bcf-b772-5d76-b218-eacadbaa3087" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\frac{\\left(x + 4\\right)^{4}}{2}" :db/id #edb/ref 17592186551631} {:answer/id #uuid "ce78f957-3274-584e-a365-02e56aa1f20a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C - \\left(x + 4\\right)^{4}}" :db/id #edb/ref 17592186551632} {:answer/id #uuid "d6b9854f-6601-5d3b-be97-cf8c696cb8a6" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + 4 \\left(x + 4\\right)^{3}}" :db/id #edb/ref 17592186551636}] :answer-field/correct {:answer/id #uuid "49b0f93b-d0f2-54df-af0f-6e0cc2394918" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{C + \\left(x + 4\\right)^{4}}" :db/id #edb/ref 17592186551611} :answer-field/id #uuid "f7b6f6a4-ce2c-5b81-be6e-83b1e8a1e485" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551643}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6fa1db63-f18e-583d-ab37-46117a1bf486" :question/problem "Find the general solution to the differential equation $y′=\\frac{2 \\left(x + 4\\right)^{3}}{y}.$ Assume $x+4>0.$ Take both sign branches on intervals where the radicand is positive and $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\frac{2 \\left(x + 4\\right)^{3}}{y} \\\\ y\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =2 \\left(x + 4\\right)^{3}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x}\\,\\mathrm{d}x & =\\int 2 \\left(x + 4\\right)^{3}\\,\\mathrm{d}x \\\\ \\int y\\,\\mathrm{d}y & =\\int 2 \\left(x + 4\\right)^{3}\\,\\mathrm{d}x \\\\ \\frac{y^{2}}{2} & =\\frac{\\left(x + 4\\right)^{4}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{2}}{2}=\\frac{\\left(x + 4\\right)^{4}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}y^2 & =\\left(x + 4\\right)^{4}+2C \\\\ y & =\\pm\\sqrt{\\left(x + 4\\right)^{4}+2C} \\\\ y & =\\pm\\sqrt{\\left(x + 4\\right)^{4}+K}\\end{aligned}\n$$\n\nwhere $K=2C$ is an arbitrary real constant. Use either sign consistently on each interval where the radicand is positive."} {:db/id #edb/ref 17592186551630 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f2d4e20-8550-5507-a465-b5397eb28c15" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C - e^{- 2 x} \\right)}" :db/id #edb/ref 17592186551603} {:answer/id #uuid "1c425710-1266-581c-9722-fa8759833776" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\ln{\\left(\\frac{e^{- 2 x}}{2} \\right)}" :db/id #edb/ref 17592186551606} {:answer/id #uuid "4a018cae-2c2d-5c98-a82e-2dc47956d7c2" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C - \\frac{e^{- 2 x}}{2} \\right)}" :db/id #edb/ref 17592186551612} {:answer/id #uuid "55f667be-d4d4-5b14-b0fd-af942503ac45" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + \\frac{e^{- 2 x}}{2} \\right)}" :db/id #edb/ref 17592186551616} {:answer/id #uuid "d2892e08-e36f-52af-b525-ad4181822f25" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\frac{e^{- 2 x}}{2}" :db/id #edb/ref 17592186551635}] :answer-field/correct {:answer/id #uuid "55f667be-d4d4-5b14-b0fd-af942503ac45" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + \\frac{e^{- 2 x}}{2} \\right)}" :db/id #edb/ref 17592186551616} :answer-field/id #uuid "88407400-d880-51d2-a70f-2e5e595f4faa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551623}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c36638cc-24f6-505b-b8ac-375828a36d26" :question/problem "Find the general solution to the differential equation $y′=- e^{- 2 x - y}.$ Work on intervals where the logarithm argument is positive." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =- e^{- 2 x - y} \\\\ e^{y}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =- e^{- 2 x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int e^{y}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x}\\,\\mathrm{d}x & =\\int - e^{- 2 x}\\,\\mathrm{d}x \\\\ \\int e^{y}\\,\\mathrm{d}y & =\\int - e^{- 2 x}\\,\\mathrm{d}x \\\\ e^{y} & =\\frac{e^{- 2 x}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\ne^{y}=\\frac{e^{- 2 x}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\ln{\\left(C + \\frac{e^{- 2 x}}{2} \\right)}.\n$$\n\nThe logarithm argument must be positive on the solution interval; $C$ is an arbitrary real constant."} {:db/id #edb/ref 17592186551637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fb015f5-5a0e-5d78-85c8-9bb2368af69d" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\left(x + 7\\right)^{2}" :db/id #edb/ref 17592186551610} {:answer/id #uuid "50b41076-bc6b-5adf-a489-2df6a1b6896c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + \\left(x + 7\\right)^{2}}" :db/id #edb/ref 17592186551614} {:answer/id #uuid "83105ce1-a627-537e-90fa-45472b86b72a" :answer/type {:db/ident :answer.type/math} :answer/value "y=C + \\left|{x + 7}\\right|^{\\frac{2}{3}}" :db/id #edb/ref 17592186551621} {:answer/id #uuid "ce90e750-d37b-538c-ba68-db863eb52201" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - \\left(x + 7\\right)^{2}}" :db/id #edb/ref 17592186551633} {:answer/id #uuid "e8bad0ce-f595-50d5-af1a-7fffa40a1d48" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 2 x + 14}" :db/id #edb/ref 17592186551640}] :answer-field/correct {:answer/id #uuid "50b41076-bc6b-5adf-a489-2df6a1b6896c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + \\left(x + 7\\right)^{2}}" :db/id #edb/ref 17592186551614} :answer-field/id #uuid "eddef3a2-c678-55ce-b1af-956ae057b5f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186551641}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e1bf8ae5-5934-5cc9-9596-ee1587453d65" :question/problem "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{2(x+7)}{3{y}^{2}}.$ Assume $x+7>0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2(x+7)}{3{y}^{2}} \\\\ 3{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =2(x+7)\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2(x+7)\\,\\text{d}x \\\\ \\int 3{y}^{2}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2(x+7)\\,\\text{d}x \\\\ \\int 3{y}^{2}\\,\\text{d}y & =\\int 2(x+7)\\,\\text{d}x \\\\ {y}^{3} & ={(x+7)}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{y}^{3}={(x+7)}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\sqrt[3]{{(x+7)}^{2}+C}.\n$$\n\nUse the real cube root, on intervals where $y\\ne 0.$"} {:db/id #edb/ref 17592186608990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2adf94cb-7729-58d4-8793-1c388aa09662" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{2+6x}+K" :db/id #edb/ref 17592186608492} {:answer/id #uuid "9387ef1a-4ba5-57ee-8855-974c04fb7687" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{2x+3+K}" :db/id #edb/ref 17592186608650} {:answer/id #uuid "a47bc7e5-4700-5718-8711-560af91dd168" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{{x}^{2}+3x+K}" :db/id #edb/ref 17592186608681} {:answer/id #uuid "a7eac54b-c2a3-5fd1-ad57-3948ea949514" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{2{x}^{2}+6}+K" :db/id #edb/ref 17592186608685} {:answer/id #uuid "c1d63037-846d-55fb-ad22-48cbc1f061ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{2{x}^{2}+6x+K}" :db/id #edb/ref 17592186608740}] :answer-field/correct {:answer/id #uuid "c1d63037-846d-55fb-ad22-48cbc1f061ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\sqrt{2{x}^{2}+6x+K}" :db/id #edb/ref 17592186608740} :answer-field/id #uuid "991e65cc-3f69-5d2f-904a-a7052482fcc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186608893}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9faaedf3-7c41-5002-95a6-335a2235c1fc" :question/math-academy-id "q-14251" :question/problem "Find the general solution to the differential equation ${y}^{′}=\\frac{2x+3}{y}.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{2x+3}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x+3}{y} \\\\ y\\,\\frac{\\text{d}y}{\\text{d}x} & =2x+3\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\text{d}y}{\\text{d}x}\\text{d}x & =\\int (2x+3)\\,\\text{d}x \\\\ \\int y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\cancel{\\text{d}x} & =\\int (2x+3)\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int (2x+3)\\,\\text{d}x \\\\ \\frac{{y}^{2}}{2} & ={x}^{2}+3x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{{y}^{2}}{2}={x}^{2}+3x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{2} & ={x}^{2}+3x+C \\\\ {y}^{2} & =2{x}^{2}+6x+2C \\\\ y & =\\pm \\sqrt{2{x}^{2}+6x+2C} \\\\ y & =\\pm \\sqrt{2{x}^{2}+6x+K}\\end{aligned}\n$$\n\nwhere $K=2C.$"} {:db/id #edb/ref 17592186617845 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de48994-427c-519d-aa76-f53aecd9f00d" :answer/type {:db/ident :answer.type/math} :answer/value "-2t" :db/id #edb/ref 17592186617277}] :answer-field/correct {:answer/id #uuid "0de48994-427c-519d-aa76-f53aecd9f00d" :answer/type {:db/ident :answer.type/math} :answer/value "-2t" :db/id #edb/ref 17592186617277} :answer-field/id #uuid "697d83b8-cc1b-5fa5-82b6-d02f8194e336" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186617702}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b5785d45-e79c-5188-8c0a-65a380b832ea" :question/math-academy-id "q-168070" :question/problem "Find the general solution to the differential equation in part 1 for $s\\ne 0.$\n\n$s\\,=\\,($\n{{field-1}}$+K)^{-1}$\n$\\,\\,$where $K$ is an arbitrary constant." :question/worked-solution "To find the general solution, we separate variables and integrate both sides with respect to $t,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}s}{\\text{d}t} & =2{s}^{2} \\\\ \\frac{1}{{s}^{2}}\\cdot \\frac{\\text{d}s}{\\text{d}t} & =2 \\\\ \\int \\frac{1}{{s}^{2}}\\cdot \\frac{\\text{d}s}{\\text{d}t}\\,\\text{d}t & =\\int 2\\,\\text{d}t \\\\ \\int \\frac{\\text{d}s}{{s}^{2}} & =2\\int \\,\\text{d}t \\\\ -\\frac{1}{s} & =2t+C.\\end{aligned}\n$$\n\nThis is a perfectly valid general solution. However, if we want to write $s=s(t)$ explicitly, then we can solve for $s.$ This gives\n\n$$\n\\begin{aligned}-\\frac{1}{s} & =2t+C \\\\ s & =-\\frac{1}{2t+C} \\\\ s & =\\frac{1}{-2t+K} \\\\ s & =(-2t+K)^{-1}\\end{aligned}\n$$\n\nwhere $K=-C$ is an arbitrary constant."} {:db/id #edb/ref 17592186623673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3aa684e-0c6b-5d69-a653-42d133bba623" :answer/type {:db/ident :answer.type/math} :answer/value "3t" :db/id #edb/ref 17592186623459}] :answer-field/correct {:answer/id #uuid "d3aa684e-0c6b-5d69-a653-42d133bba623" :answer/type {:db/ident :answer.type/math} :answer/value "3t" :db/id #edb/ref 17592186623459} :answer-field/id #uuid "e2200e8c-e0ce-5195-bdce-39c5e7c37cf0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186623609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b071164a-d7dc-50ad-9600-bbe303de9fa0" :question/math-academy-id "q-168084" :question/problem "Find the general solution to the differential equation in part 1.\n\n$p\\,=\\operatorname{ln}⁡(\\,$\n{{field-1}}$+C)$\n$\\,\\,$where $C$ is an arbitrary positive constant." :question/worked-solution "To find the general solution, we separate variables and integrate both sides with respect to $t,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}p}{\\text{d}t} & =\\frac{3}{{e}^{p}} \\\\ {e}^{p}\\cdot \\frac{\\text{d}p}{\\text{d}t} & =3 \\\\ \\int {e}^{p}\\cdot \\frac{\\text{d}p}{\\text{d}t}\\,\\text{d}t & =\\int 3\\,\\text{d}t \\\\ \\int {e}^{p}\\text{d}p & =3\\int \\,\\text{d}t \\\\ {e}^{p} & =3t+C.\\end{aligned}\n$$\n\nThis is a perfectly valid general solution. However, if we want to write $p=p(t)$ explicitly, then we can solve for $p.$ This gives\n\n$$\n\\begin{aligned}{e}^{p} & =3t+C \\\\ p & =\\operatorname{ln}⁡(3t+C)\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary positive constant."} {:db/id #edb/ref 17592186671842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08259c26-cd01-57fc-8bd4-97710fe61f79" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\left(C + 3 \\left(x + 7\\right)^{2}\\right)^{3}" :db/id #edb/ref 17592186671841} {:answer/id #uuid "389dcd83-3be6-5ae7-8536-11e51af3d592" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\left(C + \\left(x + 7\\right)^{2}\\right)^{3}" :db/id #edb/ref 17592186671847} {:answer/id #uuid "4cc19ee9-085a-53a3-9ebd-784a3aa3752f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\left(C - \\left(x + 7\\right)^{2}\\right)^{3}" :db/id #edb/ref 17592186671849} {:answer/id #uuid "91cc18a4-7ab7-5560-9d49-5e0a4fc0d29c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\left(C - 2 \\left(x + 7\\right)^{2}\\right)^{3}" :db/id #edb/ref 17592186671864} {:answer/id #uuid "ba88b057-eed7-5cc6-bd3a-e13e9089e059" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\left(C + 2 \\left(x + 7\\right)^{2}\\right)^{3}" :db/id #edb/ref 17592186671868}] :answer-field/correct {:answer/id #uuid "389dcd83-3be6-5ae7-8536-11e51af3d592" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\left(C + \\left(x + 7\\right)^{2}\\right)^{3}" :db/id #edb/ref 17592186671847} :answer-field/id #uuid "d446d84a-f723-5bc5-9258-11f27b7d620c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671871}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1b625cbe-e98e-52a2-876f-b8846d653bd3" :question/problem "Find the general solution to the differential equation $y′=\\left(6 x + 42\\right)\\sqrt[3]{y^2}.$ Work on intervals where $y\\ne 0$; cube roots are real." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\left(6 x + 42\\right)\\sqrt[3]{y^2} \\\\ \\frac{1}{3\\sqrt[3]{y^2}}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =2 x + 14\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{3\\sqrt[3]{y^2}}\\,\\mathrm{d}y & =\\int 2 x + 14\\,\\mathrm{d}x \\\\ \\sqrt[3]{y} & =\\left(x + 7\\right)^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\n\\sqrt[3]{y}=\\left(x + 7\\right)^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\left(C + \\left(x + 7\\right)^{2}\\right)^{3}.\n$$\n\nHere $C$ is an arbitrary real constant."} {:db/id #edb/ref 17592186671846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1efe4088-e51b-5797-a073-9e5ef1be0ff5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 2 \\left(x - 2\\right)^{2}}" :db/id #edb/ref 17592186671844} {:answer/id #uuid "7de0ecca-e5d6-59cb-8703-a77d18534315" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - \\left(x - 2\\right)^{2}}" :db/id #edb/ref 17592186671859} {:answer/id #uuid "8563ce9a-2222-580d-a85a-03e7321d082a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - 2 \\left(x - 2\\right)^{2}}" :db/id #edb/ref 17592186671860} {:answer/id #uuid "9a2f0086-02ae-5d62-b506-2977900faf52" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + \\left(x - 2\\right)^{2}}" :db/id #edb/ref 17592186671865} {:answer/id #uuid "de910995-243e-53a6-b31f-d50546e6b6dd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 3 \\left(x - 2\\right)^{2}}" :db/id #edb/ref 17592186671872}] :answer-field/correct {:answer/id #uuid "de910995-243e-53a6-b31f-d50546e6b6dd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 3 \\left(x - 2\\right)^{2}}" :db/id #edb/ref 17592186671872} :answer-field/id #uuid "60de23b9-01a7-5c81-a3ec-22524e07f3e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671853}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "349ca8c0-aa18-5536-91e2-5228615e320b" :question/problem "Find the general solution to the differential equation $y′=\\frac{6 x - 12}{3 y^{2}}.$ Work on intervals where $y\\ne 0$; cube roots are real." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\frac{6 x - 12}{3 y^{2}} \\\\ 3 y^{2}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =6 x - 12\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3 y^{2}\\,\\mathrm{d}y & =\\int 6 x - 12\\,\\mathrm{d}x \\\\ y^{3} & =3 \\left(x - 2\\right)^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ny^{3}=3 \\left(x - 2\\right)^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\sqrt[3]{C + 3 \\left(x - 2\\right)^{2}}.\n$$\n\nHere $C$ is an arbitrary real constant."} {:db/id #edb/ref 17592186671850 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031a129f-52d6-5681-914e-7769e63f4f73" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + \\left(x - 8\\right)^{2} \\right)}" :db/id #edb/ref 17592186671840} {:answer/id #uuid "66f1a978-e987-5bc7-8d12-bb049ca62af8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + \\frac{\\left(x - 8\\right)^{2}}{2} \\right)}" :db/id #edb/ref 17592186671855} {:answer/id #uuid "6a024c65-98cf-5df3-a7c1-9fef172fd026" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C - \\frac{\\left(x - 8\\right)^{2}}{2} \\right)}" :db/id #edb/ref 17592186671856} {:answer/id #uuid "90385026-40d1-5b70-9910-305c6baa74f7" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + \\frac{3 \\left(x - 8\\right)^{2}}{2} \\right)}" :db/id #edb/ref 17592186671863} {:answer/id #uuid "b00f57f9-5b2b-5444-9f23-46a31d7ebdbb" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C - \\left(x - 8\\right)^{2} \\right)}" :db/id #edb/ref 17592186671867}] :answer-field/correct {:answer/id #uuid "66f1a978-e987-5bc7-8d12-bb049ca62af8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\ln{\\left(C + \\frac{\\left(x - 8\\right)^{2}}{2} \\right)}" :db/id #edb/ref 17592186671855} :answer-field/id #uuid "263632f2-df73-5f67-9e44-f172ab629be2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671845}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4e2e674b-0850-5368-88f6-14e03d6bfda5" :question/problem "Find the general solution to the differential equation $y′=\\left(x - 8\\right) e^{- y}.$ Work on intervals where the logarithm argument is positive." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\left(x - 8\\right) e^{- y} \\\\ e^{y}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =x - 8\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int e^{y}\\,\\mathrm{d}y & =\\int x - 8\\,\\mathrm{d}x \\\\ e^{y} & =\\frac{\\left(x - 8\\right)^{2}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ne^{y}=\\frac{\\left(x - 8\\right)^{2}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\ln{\\left(C + \\frac{\\left(x - 8\\right)^{2}}{2} \\right)}.\n$$\n\nHere $C$ is an arbitrary real constant."} {:db/id #edb/ref 17592186671852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40de40ea-de47-5945-83e5-48552756376d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 3 \\left(x + 4\\right)^{2}}" :db/id #edb/ref 17592186671848} {:answer/id #uuid "6c337c3f-e451-5f2b-8028-cc25f22de1ac" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - \\left(x + 4\\right)^{2}}" :db/id #edb/ref 17592186671857} {:answer/id #uuid "7c3af1fe-7854-5d59-8d54-20802f3b93c4" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + \\left(x + 4\\right)^{2}}" :db/id #edb/ref 17592186671858} {:answer/id #uuid "c676eb7d-d036-56b0-9476-a8bc8f71b959" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - 2 \\left(x + 4\\right)^{2}}" :db/id #edb/ref 17592186671870} {:answer/id #uuid "fbc6ce09-69ed-5a62-9eb1-12cde5e864b8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 2 \\left(x + 4\\right)^{2}}" :db/id #edb/ref 17592186671873}] :answer-field/correct {:answer/id #uuid "c676eb7d-d036-56b0-9476-a8bc8f71b959" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - 2 \\left(x + 4\\right)^{2}}" :db/id #edb/ref 17592186671870} :answer-field/id #uuid "1cb0fb69-bacc-5d3c-a375-f02460cca2ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671843}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "56a509c2-c05b-5e8a-a692-10fa903b3237" :question/problem "Find the general solution to the differential equation $y′=\\frac{- 4 x - 16}{3 y^{2}}.$ Work on intervals where $y\\ne 0$; cube roots are real." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =\\frac{- 4 x - 16}{3 y^{2}} \\\\ 3 y^{2}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =- 4 x - 16\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3 y^{2}\\,\\mathrm{d}y & =\\int - 4 x - 16\\,\\mathrm{d}x \\\\ y^{3} & =- 2 \\left(x + 4\\right)^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ny^{3}=- 2 \\left(x + 4\\right)^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\sqrt[3]{C - 2 \\left(x + 4\\right)^{2}}.\n$$\n\nHere $C$ is an arbitrary real constant."} {:db/id #edb/ref 17592186671866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0290a6d7-2380-5108-8789-71bfb77109ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 2 x^{2}}" :db/id #edb/ref 17592186671839} {:answer/id #uuid "4ed6957e-4f4f-56e4-b4ca-d10746070f85" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - x^{2}}" :db/id #edb/ref 17592186671851} {:answer/id #uuid "623c0c49-9e21-57ef-89e7-a97e9e53c353" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - 2 x^{2}}" :db/id #edb/ref 17592186671854} {:answer/id #uuid "85b3ccab-157b-52d4-ad5b-5ceacfd368dc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + x^{2}}" :db/id #edb/ref 17592186671861} {:answer/id #uuid "8d322dc8-4070-5f87-8b51-bfa4b0de44ec" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C + 3 x^{2}}" :db/id #edb/ref 17592186671862}] :answer-field/correct {:answer/id #uuid "623c0c49-9e21-57ef-89e7-a97e9e53c353" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\sqrt[3]{C - 2 x^{2}}" :db/id #edb/ref 17592186671854} :answer-field/id #uuid "bb033a9e-00be-5d83-9371-6ce820188add" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186671869}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a959a07a-ae37-59fb-85ec-1a2785aa394a" :question/problem "Find the general solution to the differential equation $y′=- \\frac{4 x}{3 y^{2}}.$ Work on intervals where $y\\ne 0$; cube roots are real." :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y′ & =- \\frac{4 x}{3 y^{2}} \\\\ 3 y^{2}\\,\\frac{\\mathrm{d}y}{\\mathrm{d}x} & =- 4 x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3 y^{2}\\,\\mathrm{d}y & =\\int - 4 x\\,\\mathrm{d}x \\\\ y^{3} & =- 2 x^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution in implicit form is\n\n$$\ny^{3}=- 2 x^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ Solving for $y$ gives\n\n$$\ny=\\sqrt[3]{C - 2 x^{2}}.\n$$\n\nHere $C$ is an arbitrary real constant."}] :knowledge-point/title "Finding a General Solution in Explicit Form"}]}
