3}+2C \\\\ y & =\\pm\\sqrt{\\frac{8 \\left(x - 3\\right)^{3}}{3}+2C} \\\\ y & =\\pm\\sqrt{\\frac{8 \\left(x - 3\\right)^{3}}{3}+K}\\end{aligned}\n$$\n\nwhere $K=2C$ is an arbitrary real constant. Use either sign consistently on each interval where the radicand is positive." :question/difficulty :question.difficulty/hard :question/answer-fields ["a37bede3-b9e4-5f1a-9f47-4fbe78c42aae"] :db/ensure :question/validate} {:db/id "c1ed890a-083e-5305-9bea-9bb4d1bea815" :answer/id #uuid "c1ed890a-083e-5305-9bea-9bb4d1bea815" :answer/type :answer.type/math :answer/value "y=C + \\left(x + 4\\right)^{2}" :db/ensure :answer/validate} {:db/id "d6b9854f-6601-5d3b-be97-cf8c696cb8a6" :answer/id #uuid "d6b9854f-6601-5d3b-be97-cf8c696cb8a6" :answer/type :answer.type/math :answer/value "y=\\pm \\sqrt{C + 4 \\left(x + 4\\right)^{3}}" :db/ensure :answer/validate} {:db/id "ce78f957-3274-584e-a365-02e56aa1f20a" :answer/id #uuid "ce78f957-3274-584e-a365-02e56aa1f20a" :answer/type :answer.type/math :answer/value "y=\\pm \\sqrt{C - \\left(x + 4\\right)^{4}}" :db/ensure :answer/validate} {:db/id "cd687bcf-b772-5d76-b218-eacadbaa3087" :answer/id #uuid "cd687bcf-b772-5d76-b218-eacadbaa3087" :answer/type :answer.type/math :answer/value "y=C + \\frac{\\left(x + 4\\right)^{4}}{2}" :db/ensure :answer/validate} {:db/id "49b0f93b-d0f2-54df-af0f-6e0cc2394918" :answer/id #uuid "49b0f93b-d0f2-54df-af0f-6e0cc2394918" :answer/type :answer.type/math :answer/value "y=\\pm \\sqrt{C + \\left(x + 4\\right)^{4}}" :db/ensure :answer/validate} {:db/id "f7b6f6a4-ce2c-5b81-be6e-83b1e8a1e485" :answer-field/id #uuid "f7b6f6a4-ce2c-5b81-be6e-83b1e8a1e485" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["c1ed890a-083e-5305-9bea-9bb4d1bea815" "d6b9854f-6601-5d3b-be97-cf8c696cb8a6" "ce78f957-3274-584e-a365-02e56aa1f20a" "cd687bcf-b772-5d76-b218-eacadbaa3087" "49b0f93b-d0f2-54df-af0f-6e0cc2394918"] :answer-field/correct "49b0f93b-d0f2-54df-af0f-6e0cc2394918" :db/ensure :answe