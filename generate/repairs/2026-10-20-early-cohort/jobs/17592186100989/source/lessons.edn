#{[{:activity/expected-seconds 420.0 :activity/first-step {:db/id #edb/ref 17592186101854} :activity/id #uuid "8d861dcd-02c5-53fa-858a-2be900cad05a" :activity/scope {:db/id #edb/ref 17592186050163} :activity/steps [{:db/id #edb/ref 17592186101854 :step/content {:db/id #edb/ref 17592186101952 :tutorial/content "Suppose we are given the following matrix:\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A =\\begin{bmatrix}2 & -1 & 0 \\\\ -5 & 0 & -2 \\\\ -1 & 8 & 1 \\\\ 0 & 3 & -7\\end{bmatrix}$</div>\n</div>\n\nWe denote the entry that lies at the intersection of the $\\color{blue}3$rd row and $\\color{red}2$nd column using the notation $a_{{\\color{blue}3}\\color{red}2}.$\n\nThe first subscript represents the row and the second subscript represents the column. So $a_{{\\color{blue}3}\\color{red}2}=8,$ as shown below.\n\n$$\n\\begin{bmatrix}2 & -1 & 0 \\\\ -5 & 0 & -2 \\\\ -1 & \\boxed{8} & 1 \\\\ 0 & 3 & -7\\end{bmatrix}\n$$\n\nWe can denote every entry of a matrix in this way.\nFor instance, $a_{{\\color{blue}4}\\color{red}1}$ denotes the entry that lies at the intersection of the $\\color{blue}4$th row and $\\color{red}1$st column.\n\n$$\n\\begin{bmatrix}{a}_{11} & {a}_{12} & {a}_{13} \\\\ {a}_{21} & {a}_{22} & {a}_{23} \\\\ {a}_{31} & {a}_{32} & {a}_{33} \\\\ {a}_{41} & {a}_{42} & {a}_{43}\\end{bmatrix}\n$$" :tutorial/id #uuid "34f3a63d-a273-50fb-b26a-ae172c7e93e9" :tutorial/math-academy-id 2969 :tutorial/title "Introduction"} :step/id #uuid "71c4da2c-9ba7-5b55-a1fc-62db722468f0" :step/math-academy-id 462030 :step/next {:db/id #edb/ref 17592186101855}} {:db/id #edb/ref 17592186101855 :step/content {:db/id #edb/ref 17592186100988 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100683 :question/id #uuid "622baf41-fe35-55ee-bfc6-f1e6a2cb089a" :question/math-academy-id "e-4371" :question/problem "Find the entry $a_{23}$ of the matrix ${A},$ where \n\n$$\n{A}\n=\\begin{bmatrix}-1 & 1 & 2 & 1 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}.\n$$" :question/worked-solution "The entry $a_{23}$ lies at the intersection of the $2$nd row and $3$rd column. Therefore, $a_{23}={\\color{blue}{-3}}.$\n\n$$\n\\begin{bmatrix}-1 & 1 & 2 & 1 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}\n$$"} :knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048896}] :knowledge-point/question-generator {:db/id #edb/ref 17592186490498} :knowledge-point/questions [{:db/id #edb/ref 17592186101123} {:db/id #edb/ref 17592186101125} {:db/id #edb/ref 17592186295053} {:db/id #edb/ref 17592186295088} {:db/id #edb/ref 17592186295089} {:db/id #edb/ref 17592186395748} {:db/id #edb/ref 17592186398263}] :knowledge-point/title "Finding an Entry of a Matrix"} :step/id #uuid "557b3c46-5feb-5a02-969f-d023d0d4b18f" :step/math-academy-id 462031 :step/next {:db/id #edb/ref 17592186101856}} {:db/id #edb/ref 17592186101856 :step/content {:db/id #edb/ref 17592186100989 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100684 :question/id #uuid "fe56a988-49e9-5f33-b0a5-f43d33984c1d" :question/math-academy-id "e-4372" :question/problem "Find the entry $b_{22}$ of the matrix ${B},$ where \n\n$$\n{B}\n=\\begin{bmatrix}-5 & 1 \\\\ 0 & 2\\end{bmatrix}.\n$$" :question/worked-solution "The entry $b_{22}$ lies at the intersection of the $2$nd row and $2$nd column. Therefore, $b_{22}={\\color{blue}{2}}.$\n\n$$\n\\begin{bmatrix}-5 & 1 \\\\ 0 & 2\\end{bmatrix}\n$$"} :knowledge-point/id #uuid "ecd07ea0-767d-55f0-a61c-da49dd320f89" :knowledge-point/question-generator {:db/id #edb/ref 17592186487554} :knowledge-point/questions [{:db/id #edb/ref 17592186101124} {:db/id #edb/ref 17592186101128} {:db/id #edb/ref 17592186269010} {:db/id #edb/ref 17592186295090} {:db/id #edb/ref 17592186398270} {:db/id #edb/ref 17592186400191}] :knowledge-point/title "Finding an Entry of a Square Matrix"} :step/id #uuid "f3dc9f2c-54de-514f-806c-13cfc1cafb33" :step/math-academy-id 462034 :step/next {:db/id #edb/ref 17592186101857}} {:db/id #edb/ref 17592186101857 :step/content {:db/id #edb/ref 17592186101953 :tutorial/content "In general, we denote the entry of a matrix $A$ that lies at the intersection of the $\\color{blue}i$th row and $\\color{red}j$th column by $a_{{\\color{blue}i}\\color{red}j}.$\n\nIf $A$ is an $m\\times n$ matrix, we can write it as\n\n$$\n\\begin{bmatrix}{a}_{11} & {a}_{12} & \\cdots & {a}_{1n} \\\\ {a}_{21} & {a}_{22} & \\cdots & {a}_{2n} \\\\ \\vdots & \\vdots & \\ddots & \\vdots \\\\ {a}_{m1} & {a}_{m2} & \\cdots & {a}_{mn}\\end{bmatrix}\n$$\n\nwhere each entry $a_{ij}$ is defined for $i = 1,2,\\ldots,m$ and $j =1,2,\\ldots,n.$" :tutorial/id #uuid "775ac64e-8b63-5c51-824d-1d99d17a2a0a" :tutorial/math-academy-id 2970 :tutorial/title "General Form of a Matrix"} :step/id #uuid "bd3801a8-679e-5a33-b62a-575a32786880" :step/math-academy-id 462037 :step/next {:db/id #edb/ref 17592186101858}} {:db/id #edb/ref 17592186101858 :step/content {:db/id #edb/ref 17592186100990 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100685 :question/id #uuid "432a6a1a-ba9d-5aa0-b758-d4d32e9992f3" :question/math-academy-id "e-4373" :question/problem "Consider the highlighted entry of the matrix $C$ given below. Describe it in terms of $c_{ij}.$\n\n$$\n\\begin{bmatrix}0 & -2 & \\boxed{5} \\\\ 34 & 5 & 1\\end{bmatrix}\n$$" :question/worked-solution "The entry lies at the intersection of the $1$st row and $3$rd column. Therefore, we have $c_{13}={\\bbox[lightgray, 2pt]{5}}.$"} :knowledge-point/id #uuid "1cc70bda-40cf-5860-9a47-25f290c71041" :knowledge-point/question-generator {:db/id #edb/ref 17592186493305} :knowledge-point/questions [{:db/id #edb/ref 17592186101126} {:db/id #edb/ref 17592186101127} {:db/id #edb/ref 17592186235399} {:db/id #edb/ref 17592186269009} {:db/id #edb/ref 17592186295091} {:db/id #edb/ref 17592186295092} {:db/id #edb/ref 17592186400198} {:db/id #edb/ref 17592186400702} {:db/id #edb/ref 17592186493306} {:db/id #edb/ref 17592186625547}] :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"} :step/id #uuid "456e8474-5f06-554c-9b60-c29b26039234" :step/math-academy-id 462038}] :activity/title "Index Notation for Matrices" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186101034}]}
