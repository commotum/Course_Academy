{
  "manifest_dependencies": {
    "python": "3.13.5",
    "packages": {
      "sympy": "1.14.0"
    }
  },
  "actual_dependencies": {
    "python": "3.13.5",
    "packages": {
      "sympy": "1.14.0"
    }
  },
  "deterministic": true,
  "batch_seed_replay": false,
  "invalid_parameters": [
    {
      "case": "row_zero",
      "rejected": true,
      "message": "Existing integer position required"
    },
    {
      "case": "row_outside",
      "rejected": true,
      "message": "Existing integer position required"
    },
    {
      "case": "ragged",
      "rejected": true,
      "message": "Rectangular nonempty matrix required"
    },
    {
      "case": "float",
      "rejected": true,
      "message": "Entry integers -34..34 required"
    },
    {
      "case": "lower_label",
      "rejected": true,
      "message": "Single uppercase matrix letter required"
    },
    {
      "case": "too_large_entry",
      "rejected": true,
      "message": "Normal scan entries are single-digit integers -9..9"
    }
  ],
  "external_assets": "No generated assets; matrices rendered as TeX."
}
