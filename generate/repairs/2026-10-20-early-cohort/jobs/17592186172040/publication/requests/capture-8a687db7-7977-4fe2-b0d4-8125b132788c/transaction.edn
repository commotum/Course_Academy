/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/id #uuid "4aa0cb81-8ccb-5018-a172-c96f75885a19"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/key "selection"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/type :answer-field.type/radio] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/choices "64b09f26-5125-5bb1-86ce-245c311d6a64"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/choices "6ecaace0-6337-534d-9498-1f6bb8670d95"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/choices "1ce89826-843b-5b5a-bbfe-823377327882"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/choices "adb45e93-fcac-5161-9e28-3a46004ae73d"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/choices "a69e0588-6047-5c0b-b996-f08741325d30"] [:db/add "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/correct "adb45e93-fcac-5161-9e28-3a46004ae73d"] [:db/ensure "4aa0cb81-8ccb-5018-a172-c96f75885a19" :answer-field/validate] [:db/add "c31adba8-c6b1-541d-aaf8-78dacb5d88cf" :question/id #uuid "c31adba8-c6b1-541d-aaf8-78dacb5d88cf"] [:db/add "c31adba8-c6b1-541d-aaf8-78dacb5d88cf" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=e^{- x y}?$"] [:db/add "c31adba8-c6b1-541d-aaf8-78dacb5d88cf" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/05/050e4af62def2e0bb11dd6da685802bc83f91c661db9d9620e0a68e07f0e4404.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/06/06b074da3c2c38c1676ad172a8fb2dad5657e6450e59dc675ea45df2e5397477.png)"] [:db/add "c31adba8-c6b1-541d-aaf8-78dacb5d88cf" :question/difficulty :question.difficulty/moderate] [:db/add "c31adba8-c6b1-541d-aaf8-78dacb5d88cf" :question/answer-fields "4aa0cb81-8ccb-5018-a172-c96f75885a19"] [:db/ensure "c31adba8-c6b1-541d-aaf8-78dacb5d88cf" :question/validate] [:db/add 17592186172040 :knowledge-point/questions "c31adba8-c6b1-541d-aaf8-78dacb5d88cf"] [:db/add "979f43b5-94cc-5aca-95b6-20f35dd6f900" :answer/id #uuid "979f43b5-94cc-5aca-95b6-20f35dd6f900"] [:db/add "979f43b5-94cc-5aca-95b6-20f35dd6f900" :answer/type :answer.type/image] [:db/add "979f43b5-94cc-5aca-95b6-20f35dd6f900" :answer/value "images/20/2001bcc57f69aa456ebddb97c8e9cf323e11af1565f85eab09f353a19d68f007.png"] [:db/ensure "979f43b5-94cc-5aca-95b6-20f35dd6f900" :answer/validate] [:db/add "b0d268e6-66fe-5d02-a582-599ca3883dc8" :answer/id #uuid "b0d268e6-66fe-5d02-a582-599ca3883dc8"] [:db/add "b0d268e6-66fe-5d02-a582-599ca3883dc8" :answer/type :answer.type/image] [:db/add "b0d268e6-66fe-5d02-a582-599ca3883dc8" :answer/value "images/f0/f0430c1209d30d5f1b554c571ed3ce145a1f9f7654b74fdf75173536993b26c4.png"] [:db/ensure "b0d268e6-66fe-5d02-a582-599ca3883dc8" :answer/validate] [:db/add "0f6123c2-455c-5236-b708-ceb735e2ed80" :answer/id #uuid "0f6123c2-455c-5236-b708-ceb735e2ed80"] [:db/add "0f6123c2-455c-5236-b708-ceb735e2ed80" :answer/type :answer.type/image] [:db/add "0f6123c2-455c-5236-b708-ceb735e2ed80" :answer/value "images/f5/f58b76d8b0a4f9687f30d23227d03982d97b7467a3389749633e2ab92c1fb419.png"] [:db/ensure "0f6123c2-455c-5236-b708-ceb735e2ed80" :answer/validate] [:db/add "a35b6266-7651-5ef8-b781-3f63d87c3f01" :answer/id #uuid "a35b6266-7651-5ef8-b781-3f63d87c3f01"] [:db/add "a35b6266-7651-5ef8-b781-3f63d87c3f01" :answer/type :answer.type/image] [:db/add "a35b6266-7651-5ef8-b781-3f63d87c3f01" :answer/value "images/43/43d8cc77fa0e6b149b8e8653e6a1ce25a403bf5b9fda0a70d2299f5d48b58d05.png"] [:db/ensure "a35b6266-7651-5ef8-b781-3f63d87c3f01" :answer/validate] [:db/add "