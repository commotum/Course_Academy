ven slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](images/f0/f0430c1209d30d5f1b554c571ed3ce145a1f9f7654b74fdf75173536993b26c4.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](images/97/97a94428cc8ecf07e6dc2a7f17cdacf9ce9f519df31070d117f4162f1d2c7da8.png)"] [:db/add "3e4a806b-05cd-5ef9-82e1-43352c2520cb" :question/difficulty :question.difficulty/moderate] [:db/add "3e4a806b-05cd-5ef9-82e1-43352c2520cb" :question/answer-fields "67e4d9e9-0642-5d51-a9b3-6c502d7d2c3b"] [:db/ensure "3e4a806b-05cd-5ef9-82e1-43352c2520cb" :question/validate] [:db/add 17592186172040 :knowledge-point/questions "3e4a806b-05cd-5ef9-82e1-43352c2520cb"] [:db/add "b3becfa8-16c0-526d-b409-dffbba22294f" :answer/id #uuid "b3becfa8-16c0-526d-b409-dffbba22294f"] [:db/add "b3becfa8-16c0-526d-b409-dffbba22294f" :answer/type :answer.type/image] [:db/add "b3becfa8-16c0-526d-b409-dffbba22294f" :answer/value "images/b3/b3238f0e3d45edb43f59c23b1001ee3718b7c72aa26825d93d717311ce2ae3f0.png"] [:db/ensure "b3becfa8-16c0-526d-b409-dffbba22294f" :answer/validate] [:db/add "1b29d425-ec5f-55cd-9de6-0fe57fd7132d" :answer/id #uuid "1b29d425-ec5f-55cd-9de6-0fe57fd7132d"] [:db/add "1b29d425-ec5f-55cd-9de6-0fe57fd7132d" :answer/type :answer.type/image] [:db/add "1b29d425-ec5f-55cd-9de6-0fe57fd7132d" :answer/value "images/87/87c3d4a40e0d94900f9b10581eb4a50b657c8c6ee442e5d89273ad4c8b773d99.png"] [:db/ensure "1b29d425-ec5f-55cd-9de6-0fe57fd7132d" :answer/validate] [:db/add "4799f795-c10b-5b31-9e4d-238f423692ac" :answer/id #uuid "4799f795-c10b-5b31-9e4d-238f423692ac"] [:db/add "4799f795-c10b-5b31-9e4d-238f423692ac" :answer/type :answer.type/image] [:db/add "4799f795-c10b-5b31-9e4d-238f423692ac" :answer/value "images/84/84aa74afe6fc14f57f01f96080d961a09a3063d5beaf6cde311f5ba29c2b31be.png"] [:db/ensure "4799f795-c10b-5b31-9e4d-238f423692ac" :answer/validate] [:db/add "40cb05