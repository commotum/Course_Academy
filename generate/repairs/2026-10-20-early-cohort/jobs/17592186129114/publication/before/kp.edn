0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{22}\\ne 0$ (condition II is violated). \n\n$$\nC=\\begin{bmatrix}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{bmatrix}\n$$\n\nTherefore, only $C$ is **not** in row echelon form."} {:db/id #edb/ref 17592186413824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47c544f2-0094-5efb-b9d7-430a6628b03a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473118} {:answer/id #uuid "d6421a79-149e-5798-8b1f-119bfea53fe3" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473119}] :answer-field/correct {:answer/id #uuid "47c544f2-0094-5efb-b9d7-430a6628b03a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473118} :answer-field/id #uuid "fafc7937-f74b-546b-b87e-a22ca804ac3f" :answer-field/key "$A=\\begin{bmatrix}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473954} {:answer-field/choices [{:answer/id #uuid "a89bbf83-2e3e-5555-a6d5-981a9278f764" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473120} {:answer/id #uuid "cea56d01-fdfe-5736-816e-b8204e960080" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473121}] :answer-field/correct {:answer/id #uuid "a89bbf83-2e3e-5555-a6d5-981a9278f764" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473120} :answer-field/id #uuid "8372ee30-4548-5d83-9957-bf0d65799b1f" :answer-field/key "$B=\\begin{bmatrix}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473955} {:answer-field/choices [{:answer/id #uuid "fc580dff-bc2e-5878-b7a7-f48a863b4636" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473122} {:answer/id #uuid "2be2d645-5052-599b-a84f-9d2d9883a16a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473123}] :answer-field/correct {:answer/id #uuid "2be2d645-5052-599b-a84f-9d2d9883a16a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473123} :answer-field/id #uuid "4d08e1cd-2808-5a00-b091-ce22e53c0263" :answer-field/key "$C=\\begin{bmatrix}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473956}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "72e836b6-2968-5b2e-8666-6c15080ad3e0" :question/math-academy-id "q-42005" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{32}\\ne 0$ (condition  II is violated). \n\n$$\nA=\\begin{bmatrix}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{21}\\ne 0$ (condition II is violated). \n\n$$\nB=\\begin{bmatrix}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{bmatrix}\n$$\n\nTherefore, only $C$ is in row echelon form."} {:db/id #edb/ref 17592186618992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "531a4030-c66f-58d5-a359-012bc46b8f6a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619002} {:answer/id #uuid "94026d9d-2826-5c2a-8ff7-dd0db156e038" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186619014}] :answer-field/correct {:answer/id #uuid "94026d9d-2826-5c2a-8ff7-dd0db156e038" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186619014} :answer-field/id #uuid "9e9ed11d-ce27-54db-a6a3-e8dda19a169c" :answer-field/key "$B=\\begin{bmatrix}-2 & -6 & -7 \\\\ 0 & 1 & 9 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186619018} {:answer-field/choices [{:answer/id #uuid "daf0364a-a566-5707-8969-d1c463b19c37" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619032} {:answer/id #uuid "e69af3c1-6b1e-5d09-86cc-96341ebfc12b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186619037}] :answer-field/correct {:answer/id #uuid "e69af3c1-6b1e-5d09-86cc-96341ebfc12b" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186619037} :answer-field/id #uuid "ddce10a9-700f-5512-9eaf-6c8e706f0c7c" :answer-field/key "$A=\\begin{bmatrix}5 & 1 & 1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186619036} {:answer-field/choices [{:answer/id #uuid "9c915d88-2e11-5c90-8a2e-bef8d13e1924" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186619017} {:answer/id #uuid "ad284a24-e866-58b6-8b6b-c92774ec9a81" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619020}] :answer-field/correct {:answer/id #uuid "ad284a24-e866-58b6-8b6b-c92774ec9a81" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186619020} :answer-field/id #uuid "f00270b5-88d5-57de-8ec6-5e4a504e67d3" :answer-field/key "$C=\\begin{bmatrix}9 & -3 & 7 \\\\ -9 & -6 & 9 \\\\ 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186619039}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "12be4e7e-490f-5ebf-b05f-bec415d51350" :question/problem "Which of the following matrices are **not** in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}5 & 1 & 1 \\\\ 0 & 0 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}-2 & -6 & -7 \\\\ 0 & 1 & 9 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry $c_{21}=-9$ is in the same column as the leading entry $c_{11}=9$ (condition II is violated).\n\n$$\nC=\\begin{bmatrix}9 & -3 & 7 \\\\ -9 & -6 & 9 \\\\ 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, only $C$ is **not** in row echelon form."} {:db/id #edb/ref 17592186618996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "293297e0-85d2-5132-9ed3-5a1e