-a2fe-a0e0b650426e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459962}] :answer-field/correct {:answer/id #uuid "3337fae3-8c3b-5ced-a2fe-a0e0b650426e" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459962} :answer-field/id #uuid "da567c2d-7ca3-5ce0-9d1f-676b0894d8d6" :answer-field/key "$C=\\begin{bmatrix}1 & 0 & 0 & 0 & 3 & 9 \\\\ 0 & 0 & 2 & 5 & 8 & 0 \\\\ 0 & 0 & 0 & 0 & 1 & 3\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460847}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "181e77e0-d595-5539-baef-b4986d4c678b" :question/math-academy-id "q-42024" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply." :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 7 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 4\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}0 & 3 & 6 & 12 \\\\ 0 & 0 & 4 & 8 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}1 & 0 & 0 & 0 & 3 & 9 \\\\ 0 & 0 & 2 & 5 & 8 & 0 \\\\ 0 & 0 & 0 & 0 & 1 & 3\\end{bmatrix}\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."} {:db/id #edb/ref 17592186129778 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3496ac3-8437-5e13-