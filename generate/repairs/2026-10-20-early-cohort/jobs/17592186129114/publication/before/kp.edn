 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{bmatrix}\n$$\n\nTherefore, only $B$ is in row echelon form."} {:db/id #edb/ref 17592186400408 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c011bf74-4e03-5659-a095-597e0524fce9" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472586} {:answer/id #uuid "e64784ae-73a3-527e-a9ca-515e7c49ea94" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472587}] :answer-field/correct {:answer/id #uuid "e64784ae-73a3-527e-a9ca-515e7c49ea94" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472587} :answer-field/id #uuid "129c2acd-23b9-5242-b875-c0ced1c0d4f2" :answer-field/key "$A=\\begin{bmatrix}-2 & 0 & 3 & 1 \\\\ 0 & 5 & 0 & -4 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473688} {:answer-field/choices [{:answer/id #uuid "6839a05c-d515-556e-8ab4-1b643298e3ef" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472588} {:answer/id #uuid "56dd2d05-be36-50c6-ba0a-273536e978cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472589}] :answer-field/correct {:answer/id #uuid "56dd2d05-be36-50c6-ba0a-273536e978cd" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472589} :answer-field/id #uuid "30de0c38-b03c-53b4-9e5a-aecafb7542d8" :answer-field/key "$B=\\begin{bmatrix}0 & -1 & 2 & -5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 7\\end{bmatrix}$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473689} {:answer-field/choices [{:answer/id #uuid "4aa9083a-2e35-58cc-aa7f-4cb905ebf3a5" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472590} {:answer/id #uuid "474b59f6-2c15-5712-8de6-b7b3cc94ba29" :answer/type {:db/ident :answer.typ