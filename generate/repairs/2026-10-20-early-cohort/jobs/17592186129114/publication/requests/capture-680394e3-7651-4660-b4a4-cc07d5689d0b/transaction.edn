alue "false"] [:db/ensure "8f753424-ae12-5970-98c7-5f86a4171614" :answer/validate] [:db/add "76afffb5-bf08-5c63-b0f3-fba0879d9913" :answer/id #uuid "76afffb5-bf08-5c63-b0f3-fba0879d9913"] [:db/add "76afffb5-bf08-5c63-b0f3-fba0879d9913" :answer/type :answer.type/text] [:db/add "76afffb5-bf08-5c63-b0f3-fba0879d9913" :answer/value "true"] [:db/ensure "76afffb5-bf08-5c63-b0f3-fba0879d9913" :answer/validate] [:db/add "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/id #uuid "2a973d5f-1391-52a2-b204-fe7de7086042"] [:db/add "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/key "$C=\\begin{bmatrix}5 & -1 & -8 & -6 \\\\ 0 & -6 & -1 & -3 \\\\ 0 & 0 & -9 & -3 \\\\ 0 & 0 & 2 & 3\\end{bmatrix}$"] [:db/add "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/type :answer-field.type/checkbox] [:db/add "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/choices "8f753424-ae12-5970-98c7-5f86a4171614"] [:db/add "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/choices "76afffb5-bf08-5c63-b0f3-fba0879d9913"] [:db/add "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/correct "8f753424-ae12-5970-98c7-5f86a4171614"] [:db/ensure "2a973d5f-1391-52a2-b204-fe7de7086042" :answer-field/validate] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/id #uuid "6e88a4db-817b-5e45-8a00-9e1c457af22c"] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply."] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}1 & 3 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & -6 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $B$ is not in row echelon form since the leading entry $b_{21}=-5$ is in the same column as the leading entry $b_{11}=9$ (condition II is violated).\n\n$$\nB=\\begin{bmatrix}9 & 9 & -9 \\\\ -5 & 9 & -2 \\\\ 0 & -4 & 4\\end{bmatrix}\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry $c_{43}=2$ is in the same column as the leading entry $c_{33}=-9$ (condition II is violated).\n\n$$\nC=\\begin{bmatrix}5 & -1 & -8 & -6 \\\\ 0 & -6 & -1 & -3 \\\\ 0 & 0 & -9 & -3 \\\\ 0 & 0 & 2 & 3\\end{bmatrix}\n$$\n\nTherefore, only $A$ is in row echelon form."] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/difficulty :question.difficulty/easy] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/answer-fields "2e3f113c-d757-5c2d-be11-b7891594eeb0"] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/answer-fields "6ccccf15-45ed-5712-9209-36614e588dcb"] [:db/add "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/answer-fields "2a973d5f-1391-52a2-b204-fe7de7086042"] [:db/ensure "6e88a4db-817b-5e45-8a00-9e1c457af22c" :question/validate] [:db/add 17592186129114 :knowledge-point/questions "6e88a4db-817b-5e45-8a00-9e1c457af22c"] [:db/add "7f0df1bf-a53f-55de-a82e-9f34186e0504" :answer/id #uuid "7f0df1bf-a53f-55de-a82e-9f34186e0504"] [:db/add "7f0df1bf-a53f-55de-a82e-9f34186e0504" :answer/type :answer.type/text] [:db/add "7f0df1bf-a53f-55de-a82e-9f34186e0504" :answer/value "false"] [:db/ensure "7f0df1bf-a53f-55de-a82e-9f34186e0504" :answer/validate] [:db/add "6fe947ea-b518-51fc-8928-e80bd6054061" :answer/id #uuid "6fe947ea-b518-51fc-8928-e80bd6054061"] [:db/add "6fe947ea-b518-51fc-8928-e80bd6054061" :answer/type :answer.type/text] [:db/add "6fe947ea-b518-51fc-8928-e80bd6054061" :answer/value "true"] [:db/ensure "6fe947ea-b518-51fc-8928-e80bd6054061" :answer/validate] [:db/add "bd9cbc5e-ee6a-5ea6-993b-3e03ce865ffc" :answer-field/id #uuid "bd9c