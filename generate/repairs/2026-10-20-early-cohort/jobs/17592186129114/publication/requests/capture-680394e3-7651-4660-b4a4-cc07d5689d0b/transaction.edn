es "aeef4123-234e-5283-bff4-9f38400c4d50"] [:db/add "1de4a327-fc87-5015-95d8-a87b0fb6cfe1" :answer-field/choices "fe538932-1f19-50f2-9b17-c83ed91fa23d"] [:db/add "1de4a327-fc87-5015-95d8-a87b0fb6cfe1" :answer-field/correct "fe538932-1f19-50f2-9b17-c83ed91fa23d"] [:db/ensure "1de4a327-fc87-5015-95d8-a87b0fb6cfe1" :answer-field/validate] [:db/add "a77779e7-0516-5cd6-8893-9d653ccca335" :question/id #uuid "a77779e7-0516-5cd6-8893-9d653ccca335"] [:db/add "a77779e7-0516-5cd6-8893-9d653ccca335" :question/problem "Which of the following matrices are in row echelon form?\n\nSelect all that apply."] [:db/add "a77779e7-0516-5cd6-8893-9d653ccca335" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=\\begin{bmatrix}2 & -2 & 8 & -2 \\\\ 0 & 1 & -8 & -7 \\\\ 0 & 0 & 5 & 4 \\\\ 0 & 0 & 0 & -5\\end{bmatrix}\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=\\begin{bmatrix}-4 & 7 & -8 & 9 \\\\ 0 & 4 & -8 & -3 \\\\ 0 & 0 & -6 & 3 \\\\ 0 & 0 & 0 & 9 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=\\begin{bmatrix}0 & -7 & 2 & -6 \\\\ 0 & 0 & 0 & -4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, $A,$ $B,$ and $C$ are in row echelon form."] [:db/add "a77779e7-0516-5cd6-8893-9d653ccca335" :question/difficulty :question.difficulty/easy] [:db/add "a77779e7-0516-5cd6-8893-9d653ccca335" :question/answer-fields "396ddbf5-2861-5ef6-94b8-5a04be269bfe"] [:db/add "a77779e7-0516-5cd6-8893-9d653ccca335" :question/answer-fields "57007f54-6c15-5a21-96f4-c191b62a2290"] [: