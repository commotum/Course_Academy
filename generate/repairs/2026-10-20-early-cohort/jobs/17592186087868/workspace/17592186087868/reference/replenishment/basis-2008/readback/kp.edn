type/text} :answer/value "true" :db/id #edb/ref 17592186438141}] :answer-field/correct {:answer/id #uuid "b48480a2-0492-52d3-a196-2a8da93df95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438141} :answer-field/id #uuid "03434b70-7877-52d6-9480-68bedbdb7560" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cb41985-a448-5edf-ac16-5140f9df994f" :question/math-academy-id "q-331727" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}+{x}^{2}y=-3y$\n- **II.** ${y}^{′}+{x}^{2}y=x$\n- **III.** ${y}^{′}+{x}^{2}y=0$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=-3y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{2}y & =-3y \\\\ {y}^{′}+{x}^{2}y+3y & =0 \\\\ {y}^{′}+({x}^{2}+3)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is \"I and III only.\""} {:db/id #edb/ref 17592186304938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "614bde2f-3b34-55b7-8979-0bbe0e0e8d06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438142} {:answer/id #uuid "2440c20b-4602-5338-a005-b76f98501570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438143}] :answer-field/correct {:answer/id #uuid "2440c20b-4602-5338-a005-b76f98501570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438143} :answer-field/id #uuid "e1a50845-014d-5d37-b7ad-8ae39954a63e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439100} {:answer-field/choices [{:answer/id #uuid "50f411e6-4387-5475-b44a-3ebe176b8d0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438144} {:answer/id #uuid "acaef6e2-a03c-5a66-aae6-11b882603afd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438145}] :answer-field/correct {:answer/id #uuid "acaef6e2-a03c-5a66-aae6-11b882603afd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438145} :answer-field/id #uuid "3c7d2e1e-2a32-5f22-89f7-d692d818f8c4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439101} {:answer-field/choices [{:answer/id #uuid "d1bd087a-665c-563f-a5fa-648107296f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438146} {:answer/id #uuid "f1acffb4-55b8-551e-b237-9deee744667f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438147}] :answer-field/correct {:answer/id #uuid "d1bd087a-665c-563f-a5fa-648107296f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438146} :answer-field/id #uuid "c735e342-a746-5fcf-8d38-1e9b66bb4050" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70f3dd1b-d16f-5aa1-9eba-10b4e0fd71e9" :question/math-academy-id "q-331728" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}-4xy=y$\n- **II.** ${y}^{′}-4xy=0$\n- **III.** ${y}^{′}-4xy=9$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}-4xy=y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}-4xy & =y \\\\ {y}^{′}-4xy-y & =0 \\\\ {y}^{′}-(4x+1)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}-4xy=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}-4xy=9.\n$$\n\nThe presence of the constant term $9$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186304939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "659f5dad-d96d-572c-bc0e-6839e5d2f979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438148} {:answer/id #uuid "26b77c0c-415c-551c-9af2-e73c88f28745" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438149}] :answer-field/correct {:answer/id #uuid "659f5dad-d96d-572c-bc0e-6839e5d2f979" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438148} :answer-field/id #uuid "8612dfff-4796-54a5-a331-df6cd79613e9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439103} {:answer-field/choices [{:answer/id #uuid "dbc86210-2f25-55e4-979f-8cd8499bd6a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438150} {:answer/id #uuid "4eafb62b-02d1-5dba-aea3-5813048a7402" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438151}] :answer-field/correct {:answer/id #uuid "4eafb62b-02d1-5dba-aea3-5813048a7402" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438151} :answer-field/id #uuid "581545d9-353d-50b3-8961-7af4bb789164" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439104} {:answer-field/choices [{:answer/id #uuid "46b6717f-cd6d-5839-8478-f93130f282fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438152} {:answer/id #uuid "cdc30338-2228-5ddc-91d4-fa268dd71886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438153}] :answer-field/correct {:answer/id #uuid "cdc30338-2228-5ddc-91d4-fa268dd71886" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438153} :answer-field/id #uuid "b69443e9-7deb-5890-aee3-96bd29b55c46" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439105}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f8cfe21c-18ac-5f6d-9859-3a5cbe483542" :question/math-academy-id "q-331729" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}+7xy=5$\n\n- **II.** ${y}^{′}+7xy=0$\n\n- **III.** ${y}^{′}+7xy=-2y$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+7xy=5.\n$$\n\nThe presence of the constant term $5$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+7xy=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+7xy=-2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+7xy & =-2y \\\\ {y}^{′}+7xy+2y & =0 \\\\ {y}^{′}+(7x+2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186304940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "667d5f81-9239-59f3-bd64-e30a13824e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438154} {:answer/id #uuid "320f233a-3b54-548f-96cb-6b5c4aa6ac98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438155}] :answer-field/correct {:answer/id #uuid "320f233a-3b54-548f-96cb-6b5c4aa6ac98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438155} :answer-field/id #uuid "1c546fc3-85f8-5495-bac0-790330521078" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439106} {:answer-field/choices [{:answer/id #uuid "5cc51b98-5b0c-5884-b8ee-f552971ac473" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438156} {:answer/id #uuid "f499baaa-7017-54d1-957c-4660554066fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438157}] :answer-field/correct {:answer/id #uuid "5cc51b98-5b0c-5884-b8ee-f552971ac473" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438156} :answer-field/id #uuid "03137208-0438-51b2-9ef5-6db630037564" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439107} {:answer-field/choices [{:answer/id #uuid "345d36c9-0fc8-53ad-b297-f2466b7f6b87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438158} {:answer/id #uuid "749d5e36-3386-5223-bb66-49011d5f7f6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438159}] :answer-field/correct {:answer/id #uuid "345d36c9-0fc8-53ad-b297-f2466b7f6b87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438158} :answer-field/id #uuid "093b0f41-e3f6-5616-abd6-6d38edcb4b50" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e88e764-3128-53c6-9d2a-d1f58dae12a8" :question/math-academy-id "q-331738" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}+4xy=2$\n- **II.** ${y}^{′}+4xy=0$\n- **III.** ${y}^{′}+4xy=y$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+4xy=2.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=2$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+4xy=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+4xy=y.\n$$\n\nWe collect the $y$-terms on the left side:\n\n$$\n\\begin{aligned}{y}^{′}+4xy & =y \\\\ {y}^{′}+4xy-y & =0 \\\\ {y}^{′}+(4x-1)y & =0.\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186304941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60013046-6869-55cf-91f7-48420115bedd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438160} {:answer/id #uuid "1722b0bf-64b9-51d2-999e-515e7b90211b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438161}] :answer-field/correct {:answer/id #uuid "1722b0bf-64b9-51d2-999e-515e7b90211b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438161} :answer-field/id #uuid "a97231ab-1b29-58c9-ac31-9f761a81bcc6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439109} {:answer-field/choices [{:answer/id #uuid "826ce20d-1cce-5586-9508-6cbc2e7afe87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438162} {:answer/id #uuid "795a6de7-fdd5-572b-8fcb-d6f2d8543bee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438163}] :answer-field/correct {:answer/id #uuid "826ce20d-1cce-5586-9508-6cbc2e7afe87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438162} :answer-field/id #uuid "a9a1df3e-533f-5e3d-84b5-f5af94ba6d6e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439110} {:answer-field/choices [{:answer/id #uuid "9dda6491-25bc-5b4a-9996-e5ade3c17097" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438164} {:answer/id #uuid "2bb81709-b7ca-5a51-98e8-419baa95af13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438165}] :answer-field/correct {:answer/id #uuid "9dda6491-25bc-5b4a-9996-e5ade3c17097" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438164} :answer-field/id #uuid "d3f50ef3-6ae4-5f6f-855a-f7c193330d33" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f4b9025a-0c2a-511c-b23e-f617ee7031f9" :question/math-academy-id "q-331739" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}-{x}^{2}y={x}^{3}$\n- **II.** ${y}^{′}-{x}^{2}y=y$\n- **III.** ${y}^{′}-{x}^{2}y=0$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}-{x}^{2}y={x}^{3}.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)={x}^{3}$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}-{x}^{2}y=y.\n$$\n\nWe collect the $y$-terms on the left side:\n\n$$\n\\begin{aligned}{y}^{′}-{x}^{2}y & =y \\\\ {y}^{′}-{x}^{2}y-y & =0 \\\\ {y}^{′}-({x}^{2}+1)y & =0.\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}-{x}^{2}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is \"I only.\""} {:db/id #edb/ref 17592186304942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8061805c-8cd8-5cc7-bb13-3ad6f9b44f94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438166} {:answer/id #uuid "21688abb-cb3b-5a82-a801-8feb6d03c650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438167}] :answer-field/correct {:answer/id #uuid "8061805c-8cd8-5cc7-bb13-3ad6f9b44f94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438166} :answer-field/id #uuid "343bed01-1c21-5af3-bf76-63d75646e463" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439112} {:answer-field/choices [{:answer/id #uuid "4441feeb-02b9-5ed8-bcf7-76369fb709ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438168} {:answer/id #uuid "b00c337c-80cb-57cb-9d4a-4a84e893786c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438169}] :answer-field/correct {:answer/id #uuid "b00c337c-80cb-57cb-9d4a-4a84e893786c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438169} :answer-field/id #uuid "ef31dc0a-a2e6-5f82-be3b-19b7341583d4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439113} {:answer-field/choices [{:answer/id #uuid "2cc31299-2229-5ec9-aa16-a216dd4411f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438170} {:answer/id #uuid "4fb79f69-b06c-55a2-a77c-653ce60b8e57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438171}] :answer-field/correct {:answer/id #uuid "2cc31299-2229-5ec9-aa16-a216dd4411f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438170} :answer-field/id #uuid "ce053aea-15b4-561f-8d1f-f208bfa7025d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439114}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca0875e1-4252-5a69-bfc7-c43bf6770e82" :question/math-academy-id "q-331742" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}+2y=y$\n- **II.** ${y}^{′}+2y=x$\n- **III.** ${y}^{′}+2y=0$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+2y=y.\n$$\n\nWe collect the $y$-terms on the left side:\n\n$$\n\\begin{aligned}{y}^{′}+2y & =y \\\\ {y}^{′}+2y-y & =0 \\\\ {y}^{′}+y & =0.\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+2y=x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+2y=0.\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\nTherefore, the correct answer is \"II only.\""} {:db/id #edb/ref 17592186304943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de390821-11f1-5f36-9802-7d4b56d82028" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438172} {:answer/id #uuid "d04a28d1-2ea2-50b4-af54-7f274cf2e92c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438173}] :answer-field/correct {:answer/id #uuid "d04a28d1-2ea2-50b4-af54-7f274cf2e92c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438173} :answer-field/id #uuid "23121eb7-b5f4-5882-9338-16b6fc23ce13" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439115} {:answer-field/choices [{:answer/id #uuid "e9d53b05-9b80-586f-9265-75256fd575c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438174} {:answer/id #uuid "d5a199eb-df36-5457-bf67-8f218b663119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438175}] :answer-field/correct {:answer/id #uuid "e9d53b05-9b80-586f-9265-75256fd575c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438174} :answer-field/id #uuid "ae73da4d-fa51-5351-b7c6-87495ce3cf51" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439116} {:answer-field/choices [{:answer/id #uuid "57b9dd9c-e174-5c3a-baa9-4fa6ecadc55f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438176} {:answer/id #uuid "f01d4288-b6aa-54b7-91cc-7165a1615c2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438177}] :answer-field/correct {:answer/id #uuid "57b9dd9c-e174-5c3a-baa9-4fa6ecadc55f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438176} :answer-field/id #uuid "cf46d30a-3628-5fcf-8a13-6888631fa4e5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439117}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26251e42-10da-5a5f-8853-15a03bb82549" :question/math-academy-id "q-331743" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\nSelect all that apply.\n\n- **I.** ${y}^{′}+{x}^{2}y=-2$\n- **II.** ${y}^{′}+{x}^{2}y=y$\n- **III.** ${y}^{′}+{x}^{2}y=0$" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nA first-order linear differential equation is inhomogeneous if it is not homogeneous, i.e., if it can be written as\n\n$$\n{y}^{′}+P(x)y=Q(x)\n$$\n\nwhere $Q$ is not identical to zero.\n\nTo determine which equations are inhomogeneous, we examine each one in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=-2.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-2$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=y.\n$$\n\nWe collect the $y$-terms on the left side:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{2}y & =y \\\\ {y}^{′}+{x}^{2}y-y & =0 \\\\ {y}^{′}+({x}^{2}-1)y & =0.\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$  Therefore, this equation *is* homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{2}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is \"I only.\""}] :knowledge-point/title "Identifying Homogeneous and Inhomogeneous ODEs"}]}
