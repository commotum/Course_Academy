b92b-9d597b7061e7" :answer-field/key "${y}^{′}+4xy={x}^{3}$"] [:db/add "a916be7d-2c5c-5232-b92b-9d597b7061e7" :answer-field/type :answer-field.type/checkbox] [:db/add "a916be7d-2c5c-5232-b92b-9d597b7061e7" :answer-field/choices "95d22fdd-50a8-58bc-ba28-8ea3cc513275"] [:db/add "a916be7d-2c5c-5232-b92b-9d597b7061e7" :answer-field/choices "3eea5aa8-c67d-5ad3-911c-0f9b71c1f33e"] [:db/add "a916be7d-2c5c-5232-b92b-9d597b7061e7" :answer-field/correct "95d22fdd-50a8-58bc-ba28-8ea3cc513275"] [:db/ensure "a916be7d-2c5c-5232-b92b-9d597b7061e7" :answer-field/validate] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/id #uuid "32e86b1c-ca7c-583b-acda-148bc8829f40"] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply."] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+4xy=2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+4xy & =2y \\\\ {y}^{′}+4xy-2y & =0 \\\\ {y}^{′}+(4x-2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+4xy=3x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=3x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+4xy={x}^{3}.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)={x}^{3}$ is not identically zero. Therefore, this equation is inhomogeneous.\n\nTherefore, the correct answer is ${y}^{′}+4xy=2y$ only."] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/difficulty :question.difficulty/easy] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/answer-fields "df3928d3-9553-5b66-b88b-336095f3c563"] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/answer-fields "c970d060-b960-5030-b61d-6b1ddad40818"] [:db/add "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/answer-fields "a916be7d-2c5c-5232-b92b-9d597b7061e7"] [:db/ensure "32e86b1c-ca7c-583b-acda-148bc8829f40" :question/validate] [:db/add 17592186087868 :knowledge-point/questions "32e86b1c-ca7c-583b-acda-148bc8829f40"] [:db/add "ce96936f-8d93-5d74-84f7-cba7f5c9d74b" :answer/id #uuid "ce96936f-8d93-5d74-84f7-cba7f5c9d74b"] [:db/add "ce96936f-8d93-5d74-84f7-cba7f5c9d74b" :answer/type :answer.type/text] [:db/add "ce96936f-8d93-5d74-84f7-cba7f5c9d74b" :answer/value "false"] [:db/ensure "ce96936f-8d93-5d74-84f7-cba7f5c9d74b" :answer/validate] [:db/add "e7142a29-9310-5bc9-9b7b-532824bb0e33" :answer/id #uuid "e7142a29-9310-5bc9-9b7b-532824bb0e33"] [:db/add "e7142a29-9310-5bc9-9b7b-532824bb0e33" :answer/type :answer.type/text] [:db/add "e7142a29-9310-5bc9-9b7b-532824bb0e33" :answer/value "true"] [:db/ensure "e7142a29-9310-5bc9-9b7b-532824bb0e33" :answer/validate] [:db/add "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/id #uuid "33b0716a-3a08-565d-ab4d-7ef439c1f8bd"] [:db/add "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/key "${y}^{′}+{x}^{3}y=0$"] [:db/add "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/type :answer-field.type/checkbox] [:db/add "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/choices "ce96936f-8d93-5d74-84f7-cba7f5c9d74b"] [:db/add "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/choices "e7142a29-9310-5bc9-9b7b-532824bb0e33"] [:db/add "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/correct "e7142a29-9310-5bc9-9b7b-532824bb0e33"] [:db/ensure "33b0716a-3a08-565d-ab4d-7ef439c1f8bd" :answer-field/validate] [:db/add "c959746e-3371-5185-af4b-5cb2e865cf30" :answer/id #uuid "c959746e-3371-5185-af4b-5cb2e865cf30"] [:db/add "c959746e-3371-5185-af4b-5cb2e865cf30" :answer/type :answer.type/text] [:db/add "c959746e-3371-5185-af4b-5cb2e865cf30" :answer/value "false"] [:db/ensure "c959746e-3371-5185-af4b-5cb2e865cf30" :answer/validate] [:db/add "09e9dea5-b7d0-57c3-9af6-d37ced5b1167" :answer/id #uuid "09e9dea5-b7d0-57c3-9af6-d37ced5b1167"] [:db/add "09e9dea5-b7d0-57c3-9af6-d37ced5b1167" :answer/type :answer.type/text] [:db/add "09e9dea5-b7d0-57c3-9af6-d37ced5b1167" :answer/value "true"] [:db/ensure "09e9dea5-b7d0-57c3-9af6-d37ced5b1167" :answer/validate] [:db/add "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/id #uuid "da2b1882-93e1-5f9f-b4e8-6d22449e2db3"] [:db/add "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/key "${y}^{′}+{x}^{3}y=2$"] [:db/add "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/type :answer-field.type/checkbox] [:db/add "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/choices "c959746e-3371-5185-af4b-5cb2e865cf30"] [:db/add "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/choices "09e9dea5-b7d0-57c3-9af6-d37ced5b1167"] [:db/add "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/correct "c959746e-3371-5185-af4b-5cb2e865cf30"] [:db/ensure "da2b1882-93e1-5f9f-b4e8-6d22449e2db3" :answer-field/validate] [:db/add "9cde3418-92ae-5e09-8723-e8ae6a876edc" :answer/id #uuid "9cde3418-92ae-5e09-8723-e8ae6a876edc"] [:db/add "9cde3418-92ae-5e09-8723-e8ae6a876edc" :answer/type :answer.type/text] [:db/add "9cde3418-92ae-5e09-8723-e8ae6a876edc" :answer/value "false"] [:db/ensure "9cde3418-92ae-5e09-8723-e8ae6a876edc" :answer/validate] [:db/add "687d2052-ac77-5d7c-a136-f6f8c22b92d1" :answer/id #uuid "687d2052-ac77-5d7c-a136-f6f8c22b92d1"] [:db/add "687d2052-ac77-5d7c-a136-f6f8c22b92d1" :answer/type :answer.type/text] [:db/add "687d2052-ac77-5d7c-a136-f6f8c22b92d1" :answer/value "true"] [:db/ensure "687d2052-ac77-5d7c-a136-f6f8c22b92d1" :answer/validate] [:db/add "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/id #uuid "5c1d467f-a28a-579f-bc4b-7a801f7e6849"] [:db/add "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/key "${y}^{′}+{x}^{3}y=-2y$"] [:db/add "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/type :answer-field.type/checkbox] [:db/add "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/choices "9cde3418-92ae-5e09-8723-e8ae6a876edc"] [:db/add "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/choices "687d2052-ac77-5d7c-a136-f6f8c22b92d1"] [:db/add "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/correct "687d2052-ac77-5d7c-a136-f6f8c22b92d1"] [:db/ensure "5c1d467f-a28a-579f-bc4b-7a801f7e6849" :answer-field/validate] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/id #uuid "5f661f26-2894-5b15-9e23-c052d8e0ebda"] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply."] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=0.\n$$\n\nThe right-hand side is already zero, so the equation directly matches the form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=2.\n$$\n\nThe presence of the constant term $2$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=-2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =-2y \\\\ {y}^{′}+{x}^{3}y+2y & =0 \\\\ {y}^{′}+({x}^{3}+2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+{x}^{3}y=0$; ${y}^{′}+{x}^{3}y=-2y$ only."] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/difficulty :question.difficulty/easy] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/answer-fields "33b0716a-3a08-565d-ab4d-7ef439c1f8bd"] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/answer-fields "da2b1882-93e1-5f9f-b4e8-6d22449e2db3"] [:db/add "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/answer-fields "5c1d467f-a28a-579f-bc4b-7a801f7e6849"] [:db/ensure "5f661f26-2894-5b15-9e23-c052d8e0ebda" :question/validate] [:db/add 17592186087868 :knowledge-point/questions "5f661f26-2894-5b15-9e23-c052d8e0ebda"] [:db/add "1d186eeb-24d9-5746-81b4-03bdfbb3946c" :answer/id #uuid "1d186eeb-24d9-5746-81b4-03bdfbb3946c"] [:db/add "1d186eeb-24d9-5746-81b4-03bdfbb3946c" :answer/type :answer.type/text] [:db/add "1d186eeb-24d9-5746-81b4-03bdfbb3946c" :answer/value "false"] [:db/ensure "1d186eeb-24d9-5746-81b4-03bdfbb3946c" :answer/validate] [:db/add "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f" :answer/id #uuid "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f"] [:db/add "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f" :answer/type :answer.type/text] [:db/add "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f" :answer/value "true"] [:db/ensure "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f" :answer/validate] [:db/add "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/id #uuid "2bff5616-0cc4-5b8a-938e-76f98cb89377"] [:db/add "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/key "${y}^{′}+2{x}^{2}y=-5$"] [:db/add "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/type :answer-field.type/checkbox] [:db/add "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/choices "1d186eeb-24d9-5746-81b4-03bdfbb3946c"] [:db/add "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/choices "c7dd9cd2-9a9a-53b4-84ad-b91d884d609f"] [:db/add "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/correct "1d186eeb-24d9-5746-81b4-03bdfbb3946c"] [:db/ensure "2bff5616-0cc4-5b8a-938e-76f98cb89377" :answer-field/validate] [:db/add "d140c08d-bd6c-5e13-8631-f0e85f27c412" :answer/id #uuid "d140c08d-bd6c-5e13-8631-f0e85f27c412"] [:db/add "d140c08d-bd6c-5e13-8631-f0e85f27c412" :answer/type :answer.type/text] [:db/add "d140c08d-bd6c-5e13-8631-f0e85f27c412" :answer/value "false"] [:db/ensure "d140c08d-bd6c-5e13-8631-f0e85f27c412" :answer/validate] [:db/add "0f60f433-4104-544d-ba20-53ce8d39c651" :answer/id #uuid "0f60f433-4104-544d-ba20-53ce8d39c651"] [:db/add "0f60f433-4104-544d-ba20-53ce8d39c651" :answer/type :answer.type/text] [:db/add "0f60f433-4104-544d-ba20-53ce8d39c651" :answer/value "true"] [:db/ensure "0f60f433-4104-544d-ba20-53ce8d39c651" :answer/validate] [:db/add "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/id #uuid "d8c9ac1a-1072-5be9-af56-7872d02f01e2"] [:db/add "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/key "${y}^{′}+2{x}^{2}y=3y$"] [:db/add "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/type :answer-field.type/checkbox] [:db/add "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/choices "d140c08d-bd6c-5e13-8631-f0e85f27c412"] [:db/add "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/choices "0f60f433-4104-544d-ba20-53ce8d39c651"] [:db/add "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/correct "0f60f433-4104-544d-ba20-53ce8d39c651"] [:db/ensure "d8c9ac1a-1072-5be9-af56-7872d02f01e2" :answer-field/validate] [:db/add "885f97b2-8116-577a-b4c8-2fb47506a1a7" :answer/id #uuid "885f97b2-8116-577a-b4c8-2fb47506a1a7"] [:db/add "885f97b2-8116-577a-b4c8-2fb47506a1a7" :answer/type :answer.type/text] [:db/add "885f97b2-8116-577a-b4c8-2fb47506a1a7" :answer/value "false"] [:db/ensure "885f97b2-8116-577a-b4c8-2fb47506a1a7" :answer/validate] [:db/add "930d61a1-63ff-581c-8958-e9e1eb4da95b" :answer/id #uuid "930d61a1-63ff-581c-8958-e9e1eb4da95b"] [:db/add "930d61a1-63ff-581c-8958-e9e1eb4da95b" :answer/type :answer.type/text] [:db/add "930d61a1-63ff-581c-8958-e9e1eb4da95b" :answer/value "true"] [:db/ensure "930d61a1-63ff-581c-8958-e9e1eb4da95b" :answer/validate] [:db/add "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/id #uuid "17a8d885-5fc2-5eaf-9a04-ecea73a2524b"] [:db/add "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/key "${y}^{′}+2{x}^{2}y=-4y$"] [:db/add "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/type :answer-field.type/checkbox] [:db/add "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/choices "885f97b2-8116-577a-b4c8-2fb47506a1a7"] [:db/add "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/choices "930d61a1-63ff-581c-8958-e9e1eb4da95b"] [:db/add "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/correct "930d61a1-63ff-581c-8958-e9e1eb4da95b"] [:db/ensure "17a8d885-5fc2-5eaf-9a04-ecea73a2524b" :answer-field/validate] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/id #uuid "fa221a93-5c26-51e7-9d03-310306b15d77"] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply."] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+2{x}^{2}y=-5.\n$$\n\nThe presence of the constant term $-5$ means the right-hand side is not zero, and so it cannot be rewritten in homogeneous form. Thus, this equation is *not* homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+2{x}^{2}y=3y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+2{x}^{2}y & =3y \\\\ {y}^{′}+2{x}^{2}y-3y & =0 \\\\ {y}^{′}+(2{x}^{2}-3)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+2{x}^{2}y=-4y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+2{x}^{2}y & =-4y \\\\ {y}^{′}+2{x}^{2}y+4y & =0 \\\\ {y}^{′}+(2{x}^{2}+4)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\nTherefore, the correct answer is ${y}^{′}+2{x}^{2}y=3y$; ${y}^{′}+2{x}^{2}y=-4y$ only."] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/difficulty :question.difficulty/easy] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/answer-fields "2bff5616-0cc4-5b8a-938e-76f98cb89377"] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/answer-fields "d8c9ac1a-1072-5be9-af56-7872d02f01e2"] [:db/add "fa221a93-5c26-51e7-9d03-310306b15d77" :question/answer-fields "17a8d885-5fc2-5eaf-9a04-ecea73a2524b"] [:db/ensure "fa221a93-5c26-51e7-9d03-310306b15d77" :question/validate] [:db/add 17592186087868 :knowledge-point/questions "fa221a93-5c26-51e7-9d03-310306b15d77"] [:db/add "generator" :question-generator/id #uuid "9ce90597-a632-53d0-a825-e919fcd5b202"] [:db/add "generator" :question-generator/script "generators/89/89da60eff9352611289e3b33adaef5c15c4a340472ea492d7e6427c578d5713d/17592186087868.py"] [:db/add 17592186087868 :knowledge-point/question-generator "generator"] [:db/ensure 17592186087868 :knowledge-point/validate]]
