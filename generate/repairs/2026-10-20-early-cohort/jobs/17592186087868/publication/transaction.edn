] [:db/add "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/id #uuid "297a4864-aebf-59c7-846e-7447703e47f1"] [:db/add "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/key "${y}^{′}+{x}^{3}y=y$"] [:db/add "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/type :answer-field.type/checkbox] [:db/add "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/choices "d97c0712-5fce-5698-9472-de0d852a558a"] [:db/add "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/choices "4a514407-d3f3-575f-b9fa-d8b32140637f"] [:db/add "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/correct "4a514407-d3f3-575f-b9fa-d8b32140637f"] [:db/ensure "297a4864-aebf-59c7-846e-7447703e47f1" :answer-field/validate] [:db/add "ac19d693-0584-57d9-8388-b68867ed895f" :answer/id #uuid "ac19d693-0584-57d9-8388-b68867ed895f"] [:db/add "ac19d693-0584-57d9-8388-b68867ed895f" :answer/type :answer.type/text] [:db/add "ac19d693-0584-57d9-8388-b68867ed895f" :answer/value "false"] [:db/ensure "ac19d693-0584-57d9-8388-b68867ed895f" :answer/validate] [:db/add "16487eca-6999-56b0-bb66-0b337dab9a14" :answer/id #uuid "16487eca-6999-56b0-bb66-0b337dab9a14"] [:db/add "16487eca-6999-56b0-bb66-0b337dab9a14" :answer/type :answer.type/text] [:db/add "16487eca-6999-56b0-bb66-0b337dab9a14" :answer/value "true"] [:db/ensure "16487eca-6999-56b0-bb66-0b337dab9a14" :answer/validate] [:db/add "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/id #uuid "d8a783f1-a1ca-57de-8005-1d3eed47500d"] [:db/add "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/key "${y}^{′}+{x}^{3}y=-4x$"] [:db/add "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/type :answer-field.type/checkbox] [:db/add "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/choices "ac19d693-0584-57d9-8388-b68867ed895f"] [:db/add "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/choices "16487eca-6999-56b0-bb66-0b337dab9a14"] [:db/add "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/correct "ac19d693-0584-57d9-8388-b68867ed895f"] [:db/ensure "d8a783f1-a1ca-57de-8005-1d3eed47500d" :answer-field/validate] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/id #uuid "ea086a0d-6281-50e8-9859-feb937690d11"] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/problem "Which of the following first-order linear differential equations are homogeneous?\n\nSelect all that apply."] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/worked-solution "A first-order linear differential equation is homogeneous if it can be written in the form\n\n$$\n{y}^{′}+P(x)y=0.\n$$\n\nNow, let's consider each equation in turn.\n\n- First, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=2y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =2y \\\\ {y}^{′}+{x}^{3}y-2y & =0 \\\\ {y}^{′}+({x}^{3}-2)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Next, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=y.\n$$\n\nWe move the term involving $y$ to the left side so that all $y$-terms are together:\n\n$$\n\\begin{aligned}{y}^{′}+{x}^{3}y & =y \\\\ {y}^{′}+{x}^{3}y-y & =0 \\\\ {y}^{′}+({x}^{3}-1)y & =0\\end{aligned}\n$$\n\nThis matches the homogeneous form ${y}^{′}+P(x)y=0.$ Therefore, this equation is homogeneous.\n\n- Finally, we consider the equation\n\n$$\n{y}^{′}+{x}^{3}y=-4x.\n$$\n\nNotice that this is written in the form ${y}^{′}+P(x)y=Q(x)$ where $Q(x)=-4x$ is not identically zero. Therefore, this equation is inhomogeneous.\n\nTherefore, the correct answer is ${y}^{′}+{x}^{3}y=2y$; ${y}^{′}+{x}^{3}y=y$ only."] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/difficulty :question.difficulty/easy] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/answer-fields "80dc1c91-c0e8-5a0e-9813-9a770574905c"] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/answer-fields "297a4864-aebf-59c7-846e-7447703e47f1"] [:db/add "ea086a0d-6281-50e8-9859-feb937690d11" :question/answer-fields "d8a783f1-a1ca-57de-8005-1d3eed47500d"] [:db/ensure "ea086a0d-6281-50e8-9859-feb937690d11" :question/validate] [:db/add 17592186087868 :knowledge-point/questions "ea086a0d-6281-50e8-9859-feb937690d11"] [:db/add "d330c53d-36a0-5743-9be6-dd2c47e5129a" :answer/id #uuid "d330c53d-36a0-5743-9be6-dd2c47e5129a"] [:db/add "d330c53d-36a0-5743-9be6-dd2c47e5129a" :answer/type :answer.type/text] [:db/add "d330c53d-36a0-5743-9be6-dd2c47e5129a" :answer/value "false"] [:db/ensure "d330c53d-36a0-5743-9be6-dd2c47e5129a" :answer/validate] [:db/add "362509b0-7f13-5268-9882-b7458181febd" :answer/id #uuid "362509b0-7f13-5268-9882-b7458181febd"] [:db/add "362509b0-7f13-5268-9882-b7458181febd" :answer/type :answer.type/text] [:db/add "362509b0-7f13-5268-9882-b7458181febd" :answer/value "true"] [:db/ensure "362509b0-7f13-5268-9882-b7458181febd" :answer/validate] [:db/add "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/id #uuid "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de"] [:db/add "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/key "${y}^{′}+8{x}^{3}y=4y$"] [:db/add "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/type :answer-field.type/checkbox] [:db/add "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/choices "d330c53d-36a0-5743-9be6-dd2c47e5129a"] [:db/add "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/choices "362509b0-7f13-5268-9882-b7458181febd"] [:db/add "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/correct "362509b0-7f13-5268-9882-b7458181febd"] [:db/ensure "d9234d2f-f7ae-5ff4-b1cf-c005b486a2de" :answer-field/validate] [:db/add "c27b9007-5b5b-5a6f-b4cf-fe3bd9a381dc" :answer/id #uuid "c27b9007-5b5b-5a6f-b4cf-fe3bd9a381dc"] [:db/add "c27b9007-5b5b-5a6f-b4cf-fe3bd9a381dc" :answer/type :answer.type/text] [:db/add "c27b9007-5b5b-5a6f-b4cf-fe3bd9a381dc" :answer/value "false"] [:db/ensure "c27b9007-5b5b-5a6f-b4cf-fe3bd9a381dc" :answer/validate] [:db/add "95337301-0306-5473-a840-a3665a504b75" :answer/id #uuid "95337301-0306-5473-a