2 & 0 & 4 & -6\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 2 & 0 & 4 & -6\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 2 & 6 & 10\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & -1 & -8 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -3 \\\\ 0 & 1 & 3 & 5 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2z &=-3 \\\\ y+3z &=5.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2z-3 \\\\ y &=-3z+5 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557569 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ce1dc0c-75ef-52c2-bd4b-bf75d5f2e8dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4z+6 \\\\ 3z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557510} {:answer/id #uuid "3bf6b08b-6231-5a56-a8e3-c43b285af62d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z-4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557516} {:answer/id #uuid "86cd4be6-2d2c-56d7-b46a-2c157bb80402" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557537} {:answer/id #uuid "d2124629-8825-54e6-8828-d3638950e6b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557559} {:answer/id #uuid "ea30a4a7-e209-5d31-bfc9-6aaf3dccb98b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564}] :answer-field/correct {:answer/id #uuid "ea30a4a7-e209-5d31-bfc9-6aaf3dccb98b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557564} :answer-field/id #uuid "33817d11-0d35-5223-ad95-222c9e4cd34e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186557514}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f6291f54-74fa-5018-8da1-0d69f2fed16a" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-2y+2z &=-4 \\\\ -2x+5y-14z &=22 \\\\ 2x-4y+10z &=-16.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}2 & -2 & 2 & -4 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ -2 & 5 & -14 & 22 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 3 & -12 & 18 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{2}:=\\frac{1}{3}{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 2 & -4 & 10 & -16\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & -2 & 8 & -12\\end{array}\\right] & {R}_{3}:={R}_{3}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -2 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -3 & 4 \\\\ 0 & 1 & -4 & 6 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-3z &=4 \\\\ y-4z &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3z+4 \\\\ y &=4z+6 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}3z+4 \\\\ 4z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186569961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75022ec7-7eef-58e8-96f6-520f1f5efd33" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186569637} {:answer/id #uuid "7cff60bc-e993-580b-aba0-33e3b2b248dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5z-2 \\\\ 1-3z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569649} {:answer/id #uuid "955edd2d-0a8c-5d20-84d7-cf5a92e290b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5z+2 \\\\ 3z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569678} {:answer/id #uuid "98404353-5e33-5e35-891f-c0850dff8c0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5z+2 \\\\ 3z+1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569686} {:answer/id #uuid "b6f517b4-7123-5de7-839e-f81b3c72b151" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2z+5 \\\\ z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569735}] :answer-field/correct {:answer/id #uuid "955edd2d-0a8c-5d20-84d7-cf5a92e290b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5z+2 \\\\ 3z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569678} :answer-field/id #uuid "38a28058-8837-5c47-bd4f-999f7f79529b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569867}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0d9a8a04-d6f4-5dae-8ede-86bd3b61ce86" :question/math-academy-id "q-131714" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+z &=4 \\\\ y-3z &=-1.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -2 & 1 & 4 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 1 & 4 \\\\ 0 & 1 & -3 & -1\\end{bmatrix} & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -5 & 2 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-5z &=2 \\\\ y-3z &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=5z+2 \\\\ y &=3z-1 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5z+2 \\\\ 3z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186569978 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06bab61c-40c1-5534-b5a3-b01a2dbdfa45" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569456} {:answer/id #uuid "542610ce-dff1-581e-80ae-2cef01f7f353" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569566} {:answer/id #uuid "6d65baaa-b447-55bf-9ca2-d0463511c9a4" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186569618} {:answer/id #uuid "d677f02b-fbae-5fc9-ab27-d903e38bc1fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569780} {:answer/id #uuid "d860981f-7d25-50fb-9bda-57a830f77a4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2y+1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569783}] :answer-field/correct {:answer/id #uuid "d860981f-7d25-50fb-9bda-57a830f77a4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2y+1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186569783} :answer-field/id #uuid "5be30950-b64e-577a-ae02-66dc69074ea6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186569881}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "35e39332-390d-57d5-8a71-b2e823ef2c1d" :question/math-academy-id "q-131713" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-x+2y &=-1 \\\\ 4x-8y &=4 \\\\ -4x+8y &=-4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 2 & -1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 2 & -1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{bmatrix} & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 0 & 0 \\\\ -4 & 8 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-2y &=1\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2y+1 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2y+1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e0a1ce-fb3d-5959-9754-60384a5c2762" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{3}{2}+\\frac{y}{2} \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186641848} {:answer/id #uuid "5353ee39-6188-5e67-ab0b-4d1f690e47c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186641957} {:answer/id #uuid "87a4a255-4fb4-5f02-9fea-0e5ff192cd90" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186642041} {:answer/id #uuid "bd3373af-51e0-5b24-b6c7-ef393c877d3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}x \\\\ \\frac{x}{2}+\\frac{3}{2}\\end{bmatrix},\\,x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186642102} {:answer/id #uuid "c980099c-8f7b-5947-b9bd-2307e49d9d71" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186642122}] :answer-field/correct {:answer/id #uuid "5353ee39-6188-5e67-ab0b-4d1f690e47c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186641957} :answer-field/id #uuid "c4cef5ee-e616-5845-861c-fd824bd96d1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642271}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3c835c9f-7022-5bdf-9b7d-f5a905e41275" :question/math-academy-id "q-42062" :question/problem "Solve the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}3x-6y &=9 \\\\ -2x+4y &=-6 \\\\ x-2y &=3.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "Consider the system of linear equations\n\n$$\nM=\\begin{bmatrix}3 & -6 & 9 \\\\ -2 & 4 & -6 \\\\ 1 & -2 & 3\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}3 & -6 & 9 \\\\ -2 & 4 & -6 \\\\ 1 & -2 & 3\\end{bmatrix} & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 \\\\ -2 & 4 & -6 \\\\ 1 & -2 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 0 & 0 \\\\ 1 & -2 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-2y &=3\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=3+2y \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}3+2y \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"}]}
