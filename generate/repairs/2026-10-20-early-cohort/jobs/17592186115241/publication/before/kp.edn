2 & -5 & -12 & -18\\end{array}\\right] & {R}_{3}:={R}_{3}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & -1 & -4 & -2\\end{array}\\right] & {R}_{3}:={R}_{3}+(1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & -4 & -8 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right] & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 4 & -4 \\\\ 0 & 1 & 4 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+4z &=-4 \\\\ y+4z &=2.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-4z-4 \\\\ y &=-4z+2 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-4z-4 \\\\ -4z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"} {:db/id #edb/ref 17592186557567 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c0da7ae-0be2-5a15-bb78-e9aa6a4e73bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557526} {:answer/id #uuid "7271e45f-8553-5ce0-acb1-6c300273e818" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z+3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557533} {:answer/id #uuid "8ccb0a70-9168-5376-aab3-e2bf68061d3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2z-3 \\\\ -3z+5 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186557538} {:answer/id #uuid "b8b