52b7" :answer-field/id #uuid "c0f3fb18-f297-5663-8048-eb91eaf152b7"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/key "selection"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/type :answer-field.type/radio] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/choices "03f5ee2e-ff11-50e2-826b-9348a6ab569e"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/choices "60e746a6-fed6-5d84-93f7-d86e324d7677"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/choices "465ddf68-f324-5407-b26e-541e1ce5b482"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/choices "5eba9f32-f244-5d64-b641-f6e07e477eaa"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/choices "bdaaa831-8fd9-537c-ac73-e66540ddfd38"] [:db/add "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/correct "5eba9f32-f244-5d64-b641-f6e07e477eaa"] [:db/ensure "c0f3fb18-f297-5663-8048-eb91eaf152b7" :answer-field/validate] [:db/add "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/id #uuid "f091c69d-43f7-5c7b-b8fe-1f53f7129aec"] [:db/add "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x+4y &=12 \\\\ -x-2y &=-6 \\\\ -x-2y &=-6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."] [:db/add "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & 4 & 12 \\\\ -1 & -2 & -6 \\\\ -1 & -2 & -6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{cc|c}2 & 4 & 12 \\\\ -1 & -2 & -6 \\\\ -1 & -2 & -6\\end{array}\\right] \\\\ & {R}_{1}:=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 6 \\\\ -1 & -2 & -6 \\\\ -1 & -2 & -6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 6 \\\\ 0 & 0 & 0 \\\\ -1 & -2 & -6\\end{array}\\right] \\\\ & {R}_{3}:={R}_{3}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 2 & 6 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y &=6.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$, and we have one free variable, $y$. That means we need to find $x$ in terms of $y$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-2y+6 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}-2y+6 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\n$$"] [:db/add "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/difficulty :question.difficulty/easy] [:db/add "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/answer-fields "c0f3fb18-f297-5663-8048-eb91eaf152b7"] [:db/ensure "f091c69d-43f7-5c7b-b8fe-1f53f7129aec" :question/validate] [:db/add 17592186115241 :knowledge-point/questions "f091c69d-43f7-5c7b-b8fe-1f53f7129aec"] [:db/add "79f58e54-41b6-587a-9d2e-44385101fe4b" :answer/id #uuid "79f58e54-41b6-587a-9d2e-44385101fe4b"] [:db/add "79f58e54-41b6-587a-9d2e-44385101fe4b" :answer/type :answer.type/math] [:db/add "79f58e54-41b6-587a-9d2e-44385101fe4b" :answer/value "\\begin{bmatrix}4 \\\\ 5z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "79f58e54-41b6-587a-9d2e-44385101fe4b" :answer/validate] [:db/add "b39971e0-7379-52c4-877a-96d4d3201a22" :answer/id #uuid "b39971e0-7379-52c4-877a-96d4d3201a22"] [:db/add "b39971e0-7379-52c4-877a-96d4d3201a22" :answer/type :answer.type/math] [:db/add "b39971e0-7379-52c4-877a-96d4d3201a22" :answer/value "\\begin{bmatrix}-1 \\\\ -2z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "b39971e0-7379-52c4-877a-96d4d3201a22" :answer/validate] [:db/add "b2b703ac-4c72-50f7-870c-97a25a13e8f3" :answer/id #uuid "b2b703ac-4c72-50f7-870c-97a25a13e8f3"] [:db/add "b2b703ac-4c72-50f7-870c-97a25a13e8f3" :answer/type :answer.type/math] [:db/add "b2b703ac-4c72-50f7-870c-97a25a13e8f3" :answer/value "\\begin{bmatrix}-5 \\\\ -2z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "b2b703ac-4c72-50f7-870c-97a25a13e8f3" :answer/validate] [:db/add "e594b817-7d8c-514c-9a16-3fd1b3742032" :answer/id #uuid "e594b817-7d8c-514c-9a16-3fd1b3742032"] [:db/add "e594b817-7d8c-514c-9a16-3fd1b3742032" :answer/type :answer.type/math] [:db/add "e594b817-7d8c-514c-9a16-3fd1b3742032" :answer/value "\\begin{bmatrix}-1 \\\\ z+4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "e594b817-7d8c-514c-9a16-3fd1b3742032" :answer/validate] [:db/add "c82b412f-edb1-541c-8856-100f8d2765be" :answer/id #uuid "c82b412f-edb1-541c-8856-100f8d2765be"] [:db/add "c82b412f-edb1-541c-8856-100f8d2765be" :answer/type :answer.type/math] [:db/add "c82b412f-edb1-541c-8856-100f8d2765be" :answer/value "\\begin{bmatrix}-5 \\\\ 5z+2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "c82b412f-edb1-541c-8856-100f8d2765be" :answer/validate] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/id #uuid "621cf056-8a1e-5b66-ab2e-ed06618540e7"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/key "selection"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/type :answer-field.type/radio] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/choices "79f58e54-41b6-587a-9d2e-44385101fe4b"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/choices "b39971e0-7379-52c4-877a-96d4d3201a22"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/choices "b2b703ac-4c72-50f7-870c-97a25a13e8f3"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/choices "e594b817-7d8c-514c-9a16-3fd1b3742032"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/choices "c82b412f-edb1-541c-8856-100f8d2765be"] [:db/add "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/correct "b39971e0-7379-52c4-877a-96d4d3201a22"] [:db/ensure "621cf056-8a1e-5b66-ab2e-ed06618540e7" :answer-field/validate] [:db/add "c88342e4-8236-5f70-ad12-bf716689c179" :question/id #uuid "c88342e4-8236-5f70-ad12-bf716689c179"] [:db/add "c88342e4-8236-5f70-ad12-bf716689c179" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+y+2z &=-5 \\\\ -2x-y-2z &=6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."] [:db/add "c88342e4-8236-5f70-ad12-bf716689c179" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -5 \\\\ -2 & -1 & -2 & 6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -5 \\\\ -2 & -1 & -2 & 6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 1 & 2 & -5 \\\\ 0 & 1 & 2 & -4\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & -1 \\\\ 0 & 1 & 2 & -4\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x &=-1 \\\\ y+2z &=-4.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-1 \\\\ y &=-2z-4 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ -2z-4 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"] [:db/add "c88342e4-8236-5f70-ad12-bf716689c179" :question/difficulty :question.difficulty/easy] [:db/add "c88342e4-8236-5f70-ad12-bf716689c179" :question/answer-fields "621cf056-8a1e-5b66-ab2e-ed06618540e7"] [:db/ensure "c88342e4-8236-5f70-ad12-bf716689c179" :question/validate] [:db/add 17592186115241 :knowledge-point/questions "c88342e4-8236-5f70-ad12-bf716689c179"] [:db/add "cf5e0c44-aefa-5a79-87b3-8309bd783595" :answer/id #uuid "cf5e0c44-aefa-5a79-87b3-8309bd783595"] [:db/add "cf5e0c44-aefa-5a79-87b3-8309bd783595" :answer/type :answer.type/math] [:db/add "cf5e0c44-aefa-5a79-87b3-8309bd783595" :answer/value "\\begin{bmatrix}z-1 \\\\ -5z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "cf5e0c44-aefa-5a79-87b3-8309bd783595" :answer/validate] [:db/add "8339a1ff-5c08-56b3-96b5-b386fd988e3e" :answer/id #uuid "8339a1ff-5c08-56b3-96b5-b386fd988e3e"] [:db/add "8339a1ff-5c08-56b3-96b5-b386fd988e3e" :answer/type :answer.type/math] [:db/add "8339a1ff-5c08-56b3-96b5-b386fd988e3e" :answer/value "\\begin{bmatrix}-z+6 \\\\ -5z+6 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "8339a1ff-5c08-56b3-96b5-b386fd988e3e" :answer/validate] [:db/add "5755dfa1-c68b-54cf-a6d1-3071dc214e89" :answer/id #uuid "5755dfa1-c68b-54cf-a6d1-3071dc214e89"] [:db/add "5755dfa1-c68b-54cf-a6d1-3071dc214e89" :answer/type :answer.type/math] [:db/add "5755dfa1-c68b-54cf-a6d1-3071dc214e89" :answer/value "\\begin{bmatrix}z-1 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "5755dfa1-c68b-54cf-a6d1-3071dc214e89" :answer/validate] [:db/add "5410998f-d23f-5516-830a-8390a4f91ab9" :answer/id #uuid "5410998f-d23f-5516-830a-8390a4f91ab9"] [:db/add "5410998f-d23f-5516-830a-8390a4f91ab9" :answer/type :answer.type/math] [:db/add "5410998f-d23f-5516-830a-8390a4f91ab9" :answer/value "\\begin{bmatrix}-z-4 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "5410998f-d23f-5516-830a-8390a4f91ab9" :answer/validate] [:db/add "d50c5f05-e908-5f07-b3d4-9cc37031fd70" :answer/id #uuid "d50c5f05-e908-5f07-b3d4-9cc37031fd70"] [:db/add "d50c5f05-e908-5f07-b3d4-9cc37031fd70" :answer/type :answer.type/math] [:db/add "d50c5f05-e908-5f07-b3d4-9cc37031fd70" :answer/value "\\begin{bmatrix}-z-4 \\\\ -4z+1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "d50c5f05-e908-5f07-b3d4-9cc37031fd70" :answer/validate] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/id #uuid "99da23b8-dde7-5386-ba20-c4c0fc8a1222"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/key "selection"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/type :answer-field.type/radio] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/choices "cf5e0c44-aefa-5a79-87b3-8309bd783595"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/choices "8339a1ff-5c08-56b3-96b5-b386fd988e3e"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/choices "5755dfa1-c68b-54cf-a6d1-3071dc214e89"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/choices "5410998f-d23f-5516-830a-8390a4f91ab9"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/choices "d50c5f05-e908-5f07-b3d4-9cc37031fd70"] [:db/add "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/correct "5755dfa1-c68b-54cf-a6d1-3071dc214e89"] [:db/ensure "99da23b8-dde7-5386-ba20-c4c0fc8a1222" :answer-field/validate] [:db/add "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/id #uuid "906765ba-0e3a-569b-aee3-1e04419ce12f"] [:db/add "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+2y+3z &=-7 \\\\ -x-y-z &=4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."] [:db/add "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & 3 & -7 \\\\ -1 & -1 & -1 & 4\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 2 & 3 & -7 \\\\ -1 & -1 & -1 & 4\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(1){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 2 & 3 & -7 \\\\ 0 & 1 & 2 & -3\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & -1 & -1 \\\\ 0 & 1 & 2 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-z &=-1 \\\\ y+2z &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=z-1 \\\\ y &=-2z-3 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}z-1 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"] [:db/add "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/difficulty :question.difficulty/easy] [:db/add "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/answer-fields "99da23b8-dde7-5386-ba20-c4c0fc8a1222"] [:db/ensure "906765ba-0e3a-569b-aee3-1e04419ce12f" :question/validate] [:db/add 17592186115241 :knowledge-point/questions "906765ba-0e3a-569b-aee3-1e04419ce12f"] [:db/add "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315" :answer/id #uuid "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315"] [:db/add "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315" :answer/type :answer.type/math] [:db/add "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315" :answer/value "\\begin{bmatrix}-5z-3 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315" :answer/validate] [:db/add "2c841829-54bc-5dec-8ff2-9cf3ebf4da02" :answer/id #uuid "2c841829-54bc-5dec-8ff2-9cf3ebf4da02"] [:db/add "2c841829-54bc-5dec-8ff2-9cf3ebf4da02" :answer/type :answer.type/math] [:db/add "2c841829-54bc-5dec-8ff2-9cf3ebf4da02" :answer/value "\\begin{bmatrix}z-5 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "2c841829-54bc-5dec-8ff2-9cf3ebf4da02" :answer/validate] [:db/add "5aa72fb9-733a-5615-abc1-29cadc7f36a0" :answer/id #uuid "5aa72fb9-733a-5615-abc1-29cadc7f36a0"] [:db/add "5aa72fb9-733a-5615-abc1-29cadc7f36a0" :answer/type :answer.type/math] [:db/add "5aa72fb9-733a-5615-abc1-29cadc7f36a0" :answer/value "\\begin{bmatrix}3z-3 \\\\ 2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "5aa72fb9-733a-5615-abc1-29cadc7f36a0" :answer/validate] [:db/add "3bcfd52c-d90f-5f20-abe2-50e7e46b69db" :answer/id #uuid "3bcfd52c-d90f-5f20-abe2-50e7e46b69db"] [:db/add "3bcfd52c-d90f-5f20-abe2-50e7e46b69db" :answer/type :answer.type/math] [:db/add "3bcfd52c-d90f-5f20-abe2-50e7e46b69db" :answer/value "\\begin{bmatrix}z-5 \\\\ 2z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "3bcfd52c-d90f-5f20-abe2-50e7e46b69db" :answer/validate] [:db/add "b10d29e3-983c-5645-8076-547fdcfca1d4" :answer/id #uuid "b10d29e3-983c-5645-8076-547fdcfca1d4"] [:db/add "b10d29e3-983c-5645-8076-547fdcfca1d4" :answer/type :answer.type/math] [:db/add "b10d29e3-983c-5645-8076-547fdcfca1d4" :answer/value "\\begin{bmatrix}-5z-3 \\\\ 4z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )"] [:db/ensure "b10d29e3-983c-5645-8076-547fdcfca1d4" :answer/validate] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/id #uuid "385620c0-d1f6-501c-b19b-012b356148dd"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/key "selection"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/type :answer-field.type/radio] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/choices "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/choices "2c841829-54bc-5dec-8ff2-9cf3ebf4da02"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/choices "5aa72fb9-733a-5615-abc1-29cadc7f36a0"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/choices "3bcfd52c-d90f-5f20-abe2-50e7e46b69db"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/choices "b10d29e3-983c-5645-8076-547fdcfca1d4"] [:db/add "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/correct "235c15a5-e15f-5d2e-b9a7-0f4e7b5b4315"] [:db/ensure "385620c0-d1f6-501c-b19b-012b356148dd" :answer-field/validate] [:db/add "446bb426-185b-5200-b6db-b7020b61fbe9" :question/id #uuid "446bb426-185b-5200-b6db-b7020b61fbe9"] [:db/add "446bb426-185b-5200-b6db-b7020b61fbe9" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+15z &=-3 \\\\ -2x+5y-35z &=6.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."] [:db/add "446bb426-185b-5200-b6db-b7020b61fbe9" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ -2 & 5 & -35 & 6\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ -2 & 5 & -35 & 6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ 0 & 1 & -5 & 0\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 5 & -3 \\\\ 0 & 1 & -5 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+5z &=-3 \\\\ y-5z &=0.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-5z-3 \\\\ y &=5z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-5z-3 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$"] [:db/add "446bb426-185b-5200-b6db-b7020b61fbe9" :question/difficulty :question.difficulty/easy] [:db/add "446bb426-185b-5200-b6db-b7020b61fbe9" :question/answer-fields "385620c0-d1f6-501c-b19b-012b356148dd"] [:db/ensure "446bb426-185b-5200-b6db-b7020b61fbe9" :question/validate] [:db/add 17592186115241 :knowledge-point/questions "446bb426-185b-5200-b6db-b7020b61fbe9"] [:db/add "b5a58a29-a610-5a34-90b3-f2ff2a2d150a" :answer/id #uuid "b5a58a29-a610-5a34-90b3-f2ff2a2d150a"] [:db/add "b5a58a29-a610-5a34-90b3-f2ff2a2d150a" :answer/type :answer.type/math] [:db/add "b5a58a29-a610-5a34-90b3-f2ff2a2d150a" :answer/value "\\begin{bmatrix}5y-4 \\\\ y \\\\ -3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )"] [:db/ensure "b5a58a29-a610-5a34-90b3-f2ff2a2d150a" :answer/validate] [:db/add "91126e15-a29f-5475-b30c-4e052d32d23e" :answer/id #uuid "91126e15-a29f-5475-b30c-4e052d32d23e"] [:db/add "91126e15-a29f-5475-b30c-4e052d32d23e" :answer/type :answer.type/math] [:db/add "91126e15-a29f-5475-b30c-4e052d32d23e" :answer/value "\\begin{bmatrix}y-5 \\\\ y \\\\ -3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )"] [:db/ensure "91126e15-a29f-5475-b30c-4e052d32d23e" :answer/validate] [:db/add "7542f303-28df-5793-a36f-88ceb76973d8" :answer/id #uuid "7542f303-28df-5793-a36f-88ceb76973d8"] [:db/add "7542f303-28df-5793-a36f-88ceb76973d8" :answer/type :answer.type/math] [:db/add "7542f303-28df-5793-a36f-88ceb76973d8" :answer/value "\\begin{bmatrix}-2y-2 \\\\ y \\\\ 2\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )"] [:db/ensure "7542f303-28df-5793-a36f-88ceb76973d8" :answer/validate] [:db/add "39af486b-84be-58f8-825b-2fa72172319a" :answer/id #uuid "39af486b-84be-58f8-825b-2fa72172319a"] [:db/add "39af486b-84be-58f8-825b-2fa72172319a" :answer/type :answer.type/math] [:db/add "39af486b-84be-58f8-825b-2fa72172319a" :answer/value "\\begin{bmatrix}5y-4 \\\\ y \\\\ 2\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )"] [:db/ensure "39af486b-84be-58f8-825b-2fa72172319a" :answer/validate] [:db/add "7a660858-41e1-51e0-a2c7-c95ea07132d3" :answer/id #uuid "7a660858-41e1-51e0-a2c7-c95ea07132d3"] [:db/add "7a660858-41e1-51e0-a2c7-c95ea07132d3" :answer/type :answer.type/math] [:db/add "7a660858-41e1-51e0-a2c7-c95ea07132d3" :answer/value "\\begin{bmatrix}-2y-2 \\\\ y \\\\ 3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )"] [:db/ensure "7a660858-41e1-51e0-a2c7-c95ea07132d3" :answer/validate] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/id #uuid "6bd8ae67-ff94-503b-b712-3c38b55cd981"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/key "selection"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/type :answer-field.type/radio] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/choices "b5a58a29-a610-5a34-90b3-f2ff2a2d150a"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/choices "91126e15-a29f-5475-b30c-4e052d32d23e"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/choices "7542f303-28df-5793-a36f-88ceb76973d8"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/choices "39af486b-84be-58f8-825b-2fa72172319a"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/choices "7a660858-41e1-51e0-a2c7-c95ea07132d3"] [:db/add "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/correct "91126e15-a29f-5475-b30c-4e052d32d23e"] [:db/ensure "6bd8ae67-ff94-503b-b712-3c38b55cd981" :answer-field/validate] [:db/add "8805faad-2210-5845-9d51-28bb144681d1" :question/id #uuid "8805faad-2210-5845-9d51-28bb144681d1"] [:db/add "8805faad-2210-5845-9d51-28bb144681d1" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-y+z &=-8 \\\\ 2x-2y+3z &=-19.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system."] [:db/add "8805faad-2210-5845-9d51-28bb144681d1" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -8 \\\\ 2 & -2 & 3 & -19\\end{array}\\right].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -8 \\\\ 2 & -2 & 3 & -19\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(-2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 1 & -8 \\\\ 0 & 0 & 1 & -3\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(-1){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -1 & 0 & -5 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-y &=-5 \\\\ z &=-3.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $z$, and we have one free variable, $y$. That means we need to find $x$ and $z$ in terms of $y$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=y-5 \\\\ y &=y \\\\ z &=-3,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}y-5 \\\\ y \\\\ -3\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\n$$"] [:db/add "8805faad-2210-5845-9d51-28bb144681d1" :question/difficulty :question.difficulty/easy] [:db/add "8805faad-2210-5845-9d51-28bb144681d1" :question/answer-fields "6bd8ae67-ff94-503b-b712-3c38b55cd981"] [:db/ensure "8805faad-2210-5845-9d51-28bb144681d1" :question/validate] [:db/add 17592186115241 :knowledge-point/questions "8805faad-2210-5845-9d51-28bb144681d1"] [:db/add "generator" :question-generator/id #uuid "75d852d2-75d7-5913-a006-9f3a0b2ce329"] [:db/add "generator" :question-generator/script "generators/19/19bdd0f3d6292c6e8df6b13c4362f6fd0ba53f3022bbfabf2c21e78b2bf06fc4/17592186115241.py"] [:db/add 17592186115241 :knowledge-point/question-generator "generator"] [:db/ensure 17592186115241 :knowledge-point/validate]]
