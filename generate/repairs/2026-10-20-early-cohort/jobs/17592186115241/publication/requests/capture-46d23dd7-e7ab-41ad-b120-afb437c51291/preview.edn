 & -3 \\\\ -2 & 5 & -35 & 6\\end{array}\\right] \\\\ & {R}_{2}:={R}_{2}+(2){R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 15 & -3 \\\\ 0 & 1 & -5 & 0\\end{array}\\right] \\\\ & {R}_{1}:={R}_{1}+(2){R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 5 & -3 \\\\ 0 & 1 & -5 & 0\\end{array}\\right]\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+5z &=-3 \\\\ y-5z &=0.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y$, and we have one free variable, $z$. That means we need to find $x$ and $y$ in terms of $z$.\n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=-5z-3 \\\\ y &=5z \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}-5z-3 \\\\ 5z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\n$$" 13194139538693 17592186045443 true] [17592186672515 1080 "\\begin{bmatrix}4y-1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty )" 13194139538693 17592186045443 true] [17592186672515 1082 #edb/ref 17592186045498 13194139538693 17592186045443 true] [17592186672515 1083 #uuid "465ddf68-f324-5407-b26e-541e1ce5b482" 13194139538693 17592186045443 true] [17592186672516 1080 "\\begin{bmatrix}-z-4 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" 13194139538693 17592186045443 true] [17592186672516 1082 #edb/ref 17592186045498 13194139538693 17592186045443 true] [17592186672516 1083 #uuid "5410998f-d23f-5516-830a-8390a4f91ab9" 13194139538693 17592186045443 true] [17592186672517 1080 "\\begin{bmatrix}z-1 \\\\ -2z-3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" 13194139538693 17592186045443 true] [17592186672517 1082 #edb/ref 17592186045498 13194139538693 17592186045443 true] [17592186672517 1083 #uuid "5755dfa1-c68b-54cf-a6d1-3071dc214e89" 13194