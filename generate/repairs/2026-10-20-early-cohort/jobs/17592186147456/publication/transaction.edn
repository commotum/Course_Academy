d/id #uuid "a491c228-bac9-5413-a905-66f5521c9aed"] [:db/add "a491c228-bac9-5413-a905-66f5521c9aed" :answer-field/key "None of the above"] [:db/add "a491c228-bac9-5413-a905-66f5521c9aed" :answer-field/type :answer-field.type/checkbox] [:db/add "a491c228-bac9-5413-a905-66f5521c9aed" :answer-field/choices "067b47fe-5b13-5372-b6e1-c325e897caf5"] [:db/add "a491c228-bac9-5413-a905-66f5521c9aed" :answer-field/choices "4acceec2-cd60-5eef-a392-4bcdd647f18d"] [:db/add "a491c228-bac9-5413-a905-66f5521c9aed" :answer-field/correct "067b47fe-5b13-5372-b6e1-c325e897caf5"] [:db/ensure "a491c228-bac9-5413-a905-66f5521c9aed" :answer-field/validate] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/id #uuid "b1f3c08b-d01d-52cf-889e-bfab6bc22038"] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/problem "Which of the following equations is a Bernoulli differential equation?\n\nWork on intervals where $x>0$ and $y>0$, and where the displayed coefficients are defined.\n\n- **I.** $y' + \\frac{3 \\cdot y^{3}}{x^{2}} = 2 \\cdot \\sin{\\left(y \\right)}$\n- **II.** $y' - 2 \\cdot y \\cdot e^{x} = 5 \\cdot x^{2} \\cdot y^{5}$\n- **III.** $y' + 5 \\cdot y^{4} \\cdot \\log{\\left(x \\right)} = - 3 \\cdot x \\cdot y^{3}$\n\nSelect all that apply."] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/worked-solution "A Bernoulli differential equation has the form\n\n$$\ny'+p(x)y=q(x)y^n.\n$$\n\nWith that in mind, let's examine the given options. Work on the stated positive domain, so dividing by powers of $y$ is valid.\n\n- Equation I is *not* a Bernoulli differential equation. The normalized equation contains a function of $y$ that is not a single power of $y$.\n\n- Equation II is a Bernoulli differential equation. In this case, we have\n\n$$\np(x)=- 2 \\cdot e^{x},\\quad q(x)=5 \\cdot x^{2},\\quad n=5.\n$$\n\n- Equation III is *not* a Bernoulli differential equation. The normalized equation contains two different powers of $y$, neither with exponent 1.\n\nTherefore, select II."] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/difficulty :question.difficulty/easy] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/answer-fields "68139657-37fb-5b7f-8bc3-a31a0439a6b6"] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/answer-fields "83828be7-2c54-5978-884d-97e3f1d955c8"] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/answer-fields "7c182660-bc4a-512c-b057-a9ec5bffd5ff"] [:db/add "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/answer-fields "a491c228-bac9-5413-a905-66f5521c9aed"] [:db/ensure "b1f3c08b-d01d-52cf-889e-bfab6bc22038" :question/validate] [:db/add 17592186147456 :knowledge-point/questions "b1f3c08b-d01d-52cf-889e-bfab6bc22038"] [:db/add "d39d9fd9-39e5-55ec-b475-909b87cede12" :answer/id #uuid "d39d9fd9-39e5-55ec-b475-909b87cede12"] [:db/add "d39d9fd9-39e5-55ec-b475-909b87cede12" :answer/type :answer.type/text] [:db/add "d39d9fd9-39e5-55ec-b475-909b87cede12" :answer/value "I and II only"] [:db/ensure "d39d9fd9-39e5-55ec-b475-909b87cede12" :answer/validate] [:db/add "60f6cf2b-cb8b-581e-9cd2-f58c0a392854" :answer/id #uuid "60f6cf2b-cb8b-581e-9cd2-f58c0a392854"] [:db/add "60f6cf2b-cb8b-581e-9cd2-f58c0a392854" :answer/type :answer.type/text] [:db/add "60f6cf2b-cb8b-581e-9cd2-f58c0a392854" :answer/value "I only"] [:db/ensure "60f6cf2b-cb8b-581e-9cd2-f58c0a392854" :answer/validate] [:db/add "ffb4a1e2-03e8-5eb5-850f-d8e300e725e3" :answer/id #uuid "ffb4a1e2-03e8-5eb5-850f-d8e300e725e3"] [:db/add "ffb4a1e2-03e8-5eb5-850f-d8e300e725e3" :answer/type :answer.type/text] [:db/add "ffb4a1e2-03e8-5eb5-850f-d8e300e725e3" :answer/value "II only"] [:db/ensure "ffb4a1e2-03e8-5eb5-850f-d8e300e725e3" :answer/validate] [:db/add "80b50f4b-e31b-5c72-8ea9-8b66bc54af27" :answer/id #uuid "80b50f4b-e31b-5c72-8ea9-8b66bc54af27"] [:db/add "80b50f4b-e31b-5c72-8ea9-8b66bc54af27" :answer/type :answer.type/text] [:db/add "80b50f4b-e31b-5c72-8ea9-8b66bc54af27" :answer/value "I, II and III"] [:db/ensure "80b50f4b-e31b-5c72-8ea9-8b66bc54af27" :answer/validate] [:db/add "17959be2-0094-5728-b212-3ff4d86ffaaa" :answer/id #uuid "17959be2-0094-5728-b212-3ff4d86ffaaa"] [:db/add "17959be2-0094-5728-b212-3ff4d86ffaaa" :answer/type :answer.type/text] [:db/add "17959be2-0094-5728-b212-3ff4d86ffaaa" :answer/value "II and III only"] [:db/ensure "17959be2-0094-5728-b212-3ff4d86ffaaa" :answer/validate] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/id #uuid "c85ea21a-7e26-5b36-98d8-b205f1402eb5"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/key "selection"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/type :answer-field.type/radio] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/choices "d39d9fd9-39e5-55ec-b475-909b87cede12"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/choices "60f6cf2b-cb8b-581e-9cd2-f58c0a392854"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/choices "ffb4a1e2-03e8-5eb5-850f-d8e300e725e3"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/choices "80b50f4b-e31b-5c72-8ea9-8b66bc54af27"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/choices "17959be2-0094-5728-b212-3ff4d86ffaaa"] [:db/add "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/correct "60f6cf2b-cb8b-581e-9cd2-f58c0a392854"] [:db/ensure "c85ea21a-7e26-5b36-98d8-b205f1402eb5" :answer-field/validate] [:db/add "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e" :question/id #uuid "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e"] [:db/add "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e" :question/problem "Which of the following equations is a Bernoulli differential equation?\n\nWork on intervals where $x>0$ and $y>0$, and where the displayed coefficients are defined.\n\n- **I.** $y' + 5 \\cdot x^{3} \\cdot y = - \\frac{2}{\\sqrt{y}}$\n- **II.** $y' - 3 \\cdot y^{3} \\cdot \\sin{\\left(x \\right)} = 3 \\cdot y^{2} \\cdot \\cos{\\left(x \\right)}$\n- **III.** $y' + y^{2} = \\frac{4 \\cdot \\sec{\\left(x \\right)}}{y^{2}}$"] [:db/add "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e" :question/worked-solution "A Bernoulli differential equation has the form\n\n$$\ny'+p(x)y=q(x)y^n.\n$$\n\nWith that in mind, let's examine the given options. Work on the stated positive domain, so dividing by powers of $y$ is valid.\n\n- Equation I is a Bernoulli differential equation. In this case, we have\n\n$$\np(x)=5 \\cdot x^{3},\\quad q(x)=-2,\\quad n=- \\frac{1}{2}.\n$$\n\n- Equation II is *not* a Bernoulli differential equation. The normalized equation contains two different powers of $y$, neither with exponent 1.\n\n- Equation III is *not* a Bernoulli differential equation. The normalized equation contains two different powers of $y$, neither with exponent 1.\n\nTherefore, select I."] [:db/add "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e" :question/difficulty :question.difficulty/easy] [:db/add "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e" :question/answer-fields "c85ea21a-7e26-5b36-98d8-b205f1402eb5"] [:db/ensure "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e" :question/validate] [:db/add 17592186147456 :knowledge-point/questions "2938e4d7-2e80-5c3d-b78b-8780ba6b4c9e"] [:db/add "generator" :question-generator/id #uuid "4e3c414c-4dd0-51b9-b084-ab7a83a08be2"] [:db/add "generator" :question-generator/script "generators/81/817661fd049b4719afce611d8ce785c1779fbb39f852d598235d33a0f2c0f687/17592186147456.py"] [:db/add 17592186147456 :knowledge-point/question-generator "generator"] [:db/ensure 17592186147456 :knowledge-point/validate]]
