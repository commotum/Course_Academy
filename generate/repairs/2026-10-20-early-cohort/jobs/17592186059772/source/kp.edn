(-1)(-2) & 7+(-1)(6) \\\\ -1 & 9 & -2 & 6\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}9 & 0 & 5 & 7 \\\\ 5 & -5 & 8 & 1 \\\\ -1 & 9 & -2 & 6\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47342003-0f7a-57c7-8078-e0f5b89cbe17" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 9 & 1 \\\\ 0 & -3 & 3 & 0 \\\\ 0 & 1 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186339758} {:answer/id #uuid "4a4e65ba-c319-5c08-b0e3-c9aebf3725a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & -2\\end{array}\\right]" :db/id #edb/ref 17592186339797} {:answer/id #uuid "aa16b685-af65-56c2-863d-85ebb28720ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186340679} {:answer/id #uuid "ac12c08c-7cda-5cfc-92cd-fec65f15dc5c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}0 & -2 & 1 & 4 \\\\ 1 & 0 & 2 & 3 \\\\ 1 & 1 & 0 & 2\\end{array}\\right]" :db/id #edb/ref 17592186340698} {:answer/id #uuid "d50c28fb-2517-5de6-83c6-0fda23c711b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186341011}] :answer-field/correct {:answer/id #uuid "aa16b685-af65-56c2-863d-85ebb28720ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186340679} :answer-field/id #uuid "4f29d7cf-1107-533f-a29c-b3d47d877104" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341519}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7de40719-e1b7-5230-a137-1dc3c55de0ef" :question/math-academy-id "q-72763" :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1 & -1 & 1 & 2\\end{array}\\right]\\,{R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 1+(-1)(1) & -1+(-1)(0) & 1+(-1)(2) & 2+(-1)(3)\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & 3 \\\\ 0 & -2 & 1 & 4 \\\\ 0 & -1 & -1 & -1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "059aa882-887d-5963-939d-82931aef6767" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & 1 & -3 & 10\\end{array}\\right]" :db/id #edb/ref 17592186339173} {:answer/id #uuid "4b0bec89-af06-5c39-a6ae-0b90c1b29c8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & 2 & -3 & 10\\end{array}\\right]" :db/id #edb/ref 17592186339802} {:answer/id #uuid "5eeb714f-153e-596d-a218-51cd00bee02c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{array}\\right]" :db/id #edb/ref 17592186339971} {:answer/id #uuid "6a24ab21-f606-59a2-ae94-25e33a5c5d35" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & -3 & 10\\end{array}\\right]" :db/id #edb/ref 17592186340069} {:answer/id #uuid "8d2c9e9c-f924-5be6-803e-89dd2685301d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & -2 & 2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 1 & 3 & -7\\end{array}\\right]" :db/id #edb/ref 17592186340394}] :answer-field/correct {:answer/id #uuid "5eeb714f-153e-596d-a218-51cd00bee02c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{array}\\right]" :db/id #edb/ref 17592186339971} :answer-field/id #uuid "71d01fb6-6a2b-5600-96a6-bbb4758f192b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341576}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4f7e0cb8-b82b-5c57-8695-0b8e08268369" :question/math-academy-id "q-72786" :question/problem "Consider the augmented matrix $U,$ given by\n\n$$\nU=\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $U?$\n\n$$\n\\begin{aligned}{R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\ {R}_{3} & :={R}_{3}+{R}_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:=\\frac{1}{2}{R}_{2}$ means that we need to multiply the second row of the matrix by $\\frac{1}{2}.$\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}U & =\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 2 & 0 & 6 \\\\ 0 & -1 & -3 & 4\\end{array}\\right]\\,{R}_{2}:=\\frac{1}{2}\\cdot {R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & -1 & -3 & 4\\end{array}\\right]\\,{R}_{3}:={R}_{3}+{R}_{2} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0+0 & -1+1 & -3+0 & 4+3\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 2 & -2 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -3 & 7\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5228249-42b4-5b6c-a34b-688628cf3c23" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -\\frac{8}{3} & -1 \\\\ 7 & 1 & 3 & 4 \\\\ 6 & -3 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388071} {:answer/id #uuid "0df908b7-b9cf-5d37-aca8-7f00b46a2051" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388072} {:answer/id #uuid "afd3402b-d0f0-5d8e-92cd-42bc4ac1d793" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388073} {:answer/id #uuid "269dae98-aadc-597a-82e7-371420d4533a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -1 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388074} {:answer/id #uuid "1ee9af5a-41eb-5f3b-a278-9fcb76973748" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & -3 & 9 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388075}] :answer-field/correct {:answer/id #uuid "afd3402b-d0f0-5d8e-92cd-42bc4ac1d793" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186388073} :answer-field/id #uuid "95465894-f1f7-5a8d-84b8-f2ad025aafe5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388070}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f08a2c2-eb16-5d85-a714-beb36e4a0c94" :question/math-academy-id "q-130071" :question/problem "Consider the augmented matrix $A,$ given by\n\n$$\nA=\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ on $A?$" :question/worked-solution "The operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ means that we need to multiply the third row of the matrix by $-\\frac{1}{3}.$\n\nMultiplying the $3$rd row by $-\\frac{1}{3}$, we obtain the following:\n\n$$\n\\begin{aligned}A & =\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{array}\\right]\\,{R}_{3}:=\\left(-\\frac{1}{3}\\right)\\cdot {R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ \\left(-\\frac{1}{3}\\right)\\cdot 6 & \\left(-\\frac{1}{3}\\right)\\cdot (-3) & \\left(-\\frac{1}{3}\\right)\\cdot 9 & \\left(-\\frac{1}{3}\\right)\\cdot 0\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393222 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756ed00-330f-5c8c-8a4d-fbb86cdc2c8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 5 & 4\\end{array}\\right]" :db/id #edb/ref 17592186393224} {:answer/id #uuid "8dfcb35e-95c9-5403-a320-dcd7face84d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & -5 & -4\\end{array}\\right]" :db/id #edb/ref 17592186393225} {:answer/id #uuid "d3557d97-0c1d-5853-b9fd-91ee81522e54" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & -5\\end{array}\\right]" :db/id #edb/ref 17592186393226} {:answer/id #uuid "7936a577-d3bd-55bd-b9c4-bfcbd8d64f15" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & -4 & 5\\end{array}\\right]" :db/id #edb/ref 17592186393227} {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{array}\\right]" :db/id #edb/ref 17592186393228}] :answer-field/correct {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{array}\\right]" :db/id #edb/ref 17592186393228} :answer-field/id #uuid "43860d4a-16fb-54d3-8d76-5164ce10d9b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393223}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7e529998-60b8-53c0-bae5-50351fb55c46" :question/math-academy-id "q-72757" :question/problem "Consider the augmented matrix $T,$ given by\n\n$$\nT=\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ on $T?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+2{R}_{1}$ means that we need to add $2$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:  \n\n$$\n\\begin{aligned}T & =\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ -2+(2)(1) & -2+(2)(3) & 1+(2)(2)\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393229 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76e35e5d-3d96-5355-b632-9dcb08a7d598" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 2 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393231} {:answer/id #uuid "37c197ca-a8a9-536c-8b89-25989a9a892c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393232} {:answer/id #uuid "3f1549bb-38c0-5786-af6b-6a9b6ef9bf0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393233} {:answer/id #uuid "c179bedb-d3a8-5e87-84d3-747a29243083" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 3 & 4 & -2 & 3 \\\\ 0 & 2 & -3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393234} {:answer/id #uuid "eaff7f31-1a3f-5265-bb26-9a65dd39c96f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 1 & 2 \\\\ 1 & 5 & 2 & -1 \\\\ 3 & 4 & 3 & -2\\end{array}\\right]" :db/id #edb/ref 17592186393235}] :answer-field/correct {:answer/id #uuid "37c197ca-a8a9-536c-8b89-25989a9a892c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]" :db/id #edb/ref 17592186393232} :answer-field/id #uuid "af067c4c-af32-5a6c-b8af-bc4ef4997af6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393230}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4f1ba7f0-e4f6-511d-875d-abce33676c37" :question/math-academy-id "q-72760" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 1+(-1)(1) & 5+(-1)(3) & -1+(-1)(2) & 2+(-1)(1) \\\\ 3 & 4 & -2 & 3\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756e234a-8217-5c8b-abaa-69ea121a0c6c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393238} {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393239} {:answer/id #uuid "1a9cf17b-a149-5bc6-9345-792b1cc2a3c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & -5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393240} {:answer/id #uuid "1d4576b0-5970-52fb-8377-b193cb931a98" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393241} {:answer/id #uuid "4cfa023b-7905-5d00-83b5-528df496267c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393242}] :answer-field/correct {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]" :db/id #edb/ref 17592186393239} :answer-field/id #uuid "bdfc7f8f-fcd9-55fe-82a8-5f2ff5b50086" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393237}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2facacda-0611-5507-a35e-091ce7069bfa" :question/math-academy-id "q-72781" :question/problem "Consider the augmented matrix $N,$ given by\n\n$$\nN=\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ on $N?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ means that we need to add $-2$ times the first row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}N & =\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 2+(-2)(1) & 1+(-2)(-2) & 2+(-2)(1) & 3+(-2)(-1) \\\\ 7 & -1 & 3 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186409514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4ab753-6b82-5ab8-ba3d-7608aa4c916d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409502} {:answer/id #uuid "194870f0-6df3-5b30-a6cd-f6757f9664e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 2 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409503} {:answer/id #uuid "1b67b21e-36ae-5c1e-8349-3329a2526d09" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -2 & 0 & -2 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409504} {:answer/id #uuid "d17d40c5-c1fa-5dba-9197-d5e6fe380c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409509} {:answer/id #uuid "ded53cb4-d3ae-5aa7-b6fd-20bffcd08576" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -2 & 0 & -1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409510}] :answer-field/correct {:answer/id #uuid "d17d40c5-c1fa-5dba-9197-d5e6fe380c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]" :db/id #edb/ref 17592186409509} :answer-field/id #uuid "7dcb6b06-d72f-52cd-bd8f-33eb7f67405b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186409512}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "56624c75-a028-5dc9-962f-9700b721674f" :question/math-academy-id "q-72785" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 4 & 3 & 2 & 1 \\\\ 1 & -1 & 0 & 3\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $V?$\n\n$$\n\\begin{aligned}{R}_{2} & ↔{R}_{3} \\\\ {R}_{2} & :={R}_{2}+(-1)\\cdot {R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}↔{R}_{3}$ means that we need to swap the second and third rows.\n\n- The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}V & =\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 4 & 3 & 2 & 1 \\\\ 1 & -1 & 0 & 3\\end{array}\\right]\\,{R}_{2}↔{R}_{3} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 1 & -1 & 0 & 3 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 1+(-1)(1) & -1+(-1)(0) & 0+(-1)(0) & 3+(-1)(2) \\\\ 4 & 3 & 2 & 1\\end{array}\\right] \\\\  & ∼\\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & -1 & 0 & 1 \\\\ 4 & 3 & 2 & 1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186628660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4603b59b-d633-5b51-9710-3879a23b9dd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-9 & 6 & -8 \\\\ -5 & -9 & 6 \\\\ 4 & 9 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628656} {:answer/id #uuid "b1ca262f-4605-5582-8e45-c20584375f17" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-9 & 6 & -8 \\\\ 4 & 9 & 0 \\\\ -5 & -9 & 6\\end{array}\\right]" :db/id #edb/ref 17592186628670} {:answer/id #uuid "bb830658-aa77-5f87-9a5e-15f82aa88212" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-5 & -9 & 6 \\\\ -9 & 6 & -8 \\\\ 4 & 9 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628674} {:answer/id #uuid "c5182608-399b-5053-b8f0-0d8a817fd03c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}4 & 9 & 0 \\\\ -5 & -9 & 6 \\\\ -9 & 6 & -8\\end{array}\\right]" :db/id #edb/ref 17592186628675} {:answer/id #uuid "f305feaa-a785-5985-a8c9-9c435a2a1fe8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}4 & 9 & 0 \\\\ -9 & 6 & -8 \\\\ -5 & -9 & 6\\end{array}\\right]" :db/id #edb/ref 17592186628680}] :answer-field/correct {:answer/id #uuid "f305feaa-a785-5985-a8c9-9c435a2a1fe8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}4 & 9 & 0 \\\\ -9 & 6 & -8 \\\\ -5 & -9 & 6\\end{array}\\right]" :db/id #edb/ref 17592186628680} :answer-field/id #uuid "a78f2735-b21f-5683-9ddc-f3b1bb2d6984" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186628669}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "66d21b6d-f994-5110-8711-c4af0fc5da8e" :question/problem "Consider the augmented matrix $A,$ given by\n\n$$\nA=\\left[\\begin{array}{cc|c}-5 & -9 & 6 \\\\ -9 & 6 & -8 \\\\ 4 & 9 & 0\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{1}\\leftrightarrow R_{3}$ on $A?$" :question/worked-solution "The operation $R_{1}\\leftrightarrow R_{3}$ means that we need to swap the first and third rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}A &= \\left[\\begin{array}{cc|c}-5 & -9 & 6 \\\\ -9 & 6 & -8 \\\\ 4 & 9 & 0\\end{array}\\right]\\,R_{1}\\leftrightarrow R_{3} \\\\ &\\sim \\left[\\begin{array}{cc|c}4 & 9 & 0 \\\\ -9 & 6 & -8 \\\\ -5 & -9 & 6\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186628661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284402fb-0cb7-5519-8bd2-ca533e58b805" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-3 & 4 & 1 \\\\ 8 & -6 & 9 \\\\ 6 & 6 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628653} {:answer/id #uuid "5d5a1a96-6f43-5c5c-b649-277a024385f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -6 & 9 \\\\ 6 & 6 & 0 \\\\ -3 & 4 & 1\\end{array}\\right]" :db/id #edb/ref 17592186628659} {:answer/id #uuid "7280b8ca-7d64-52ad-a964-a07a40981462" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-3 & 4 & 1 \\\\ 6 & 6 & 0 \\\\ 8 & -6 & 9\\end{array}\\right]" :db/id #edb/ref 17592186628662} {:answer/id #uuid "8df50bf4-1950-55cc-815d-98756d3e21af" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -6 & 9 \\\\ -3 & 4 & 1 \\\\ 6 & 6 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628666} {:answer/id #uuid "b7a7e09d-514c-50f5-b067-8177c697f026" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 6 & 0 \\\\ -3 & 4 & 1 \\\\ 8 & -6 & 9\\end{array}\\right]" :db/id #edb/ref 17592186628672}] :answer-field/correct {:answer/id #uuid "8df50bf4-1950-55cc-815d-98756d3e21af" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}8 & -6 & 9 \\\\ -3 & 4 & 1 \\\\ 6 & 6 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628666} :answer-field/id #uuid "b688416f-8f6b-598e-b8e8-00b641fd9bd1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186628671}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6e91d6a4-4270-5591-93c5-d3c928192b4e" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=\\left[\\begin{array}{cc|c}6 & 6 & 0 \\\\ -3 & 4 & 1 \\\\ 8 & -6 & 9\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{1}\\leftrightarrow R_{3}$ on $X?$" :question/worked-solution "The operation $R_{1}\\leftrightarrow R_{3}$ means that we need to swap the first and third rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X &= \\left[\\begin{array}{cc|c}6 & 6 & 0 \\\\ -3 & 4 & 1 \\\\ 8 & -6 & 9\\end{array}\\right]\\,R_{1}\\leftrightarrow R_{3} \\\\ &\\sim \\left[\\begin{array}{cc|c}8 & -6 & 9 \\\\ -3 & 4 & 1 \\\\ 6 & 6 & 0\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186628664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045ab507-78ca-5ede-9bf1-2074564c4428" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-8 & -5 & -6 \\\\ -1 & -7 & -6 \\\\ 6 & 1 & -7\\end{array}\\right]" :db/id #edb/ref 17592186628649} {:answer/id #uuid "0d871c2f-85e8-52ce-9b3d-60746740b926" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 1 & -7 \\\\ -8 & -5 & -6 \\\\ -1 & -7 & -6\\end{array}\\right]" :db/id #edb/ref 17592186628650} {:answer/id #uuid "248cd58d-b2b3-5163-81d4-882cdbdfd4c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-8 & -5 & -6 \\\\ 6 & 1 & -7 \\\\ -1 & -7 & -6\\end{array}\\right]" :db/id #edb/ref 17592186628652} {:answer/id #uuid "48d3ce63-1586-5757-b96d-22dc398865e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}6 & 1 & -7 \\\\ -1 & -7 & -6 \\\\ -8 & -5 & -6\\end{array}\\right]" :db/id #edb/ref 17592186628657} {:answer/id #uuid "57629d81-ac34-52fd-9f89-340c816fe78b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-1 & -7 & -6 \\\\ 6 & 1 & -7 \\\\ -8 & -5 & -6\\end{array}\\right]" :db/id #edb/ref 17592186628658}] :answer-field/correct {:answer/id #uuid "248cd58d-b2b3-5163-81d4-882cdbdfd4c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{cc|c}-8 & -5 & -6 \\\\ 6 & 1 & -7 \\\\ -1 & -7 & -6\\end{array}\\right]" :db/id #edb/ref 17592186628652} :answer-field/id #uuid "bb828b66-ebcb-57a5-8381-7e7d70a885f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186628673}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8117d441-e520-5b6a-b459-8e41c98755c6" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=\\left[\\begin{array}{cc|c}-1 & -7 & -6 \\\\ 6 & 1 & -7 \\\\ -8 & -5 & -6\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{1}\\leftrightarrow R_{3}$ on $X?$" :question/worked-solution "The operation $R_{1}\\leftrightarrow R_{3}$ means that we need to swap the first and third rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X &= \\left[\\begin{array}{cc|c}-1 & -7 & -6 \\\\ 6 & 1 & -7 \\\\ -8 & -5 & -6\\end{array}\\right]\\,R_{1}\\leftrightarrow R_{3} \\\\ &\\sim \\left[\\begin{array}{cc|c}-8 & -5 & -6 \\\\ 6 & 1 & -7 \\\\ -1 & -7 & -6\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186628665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14520f6b-77ad-552b-ab6b-d8b3d58a84ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -36 & -18 & 18 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628651} {:answer/id #uuid "7f487f17-4848-5bdc-9078-8c4999800167" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -42 & -21 & 21 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628663} {:answer/id #uuid "da81ad41-adf0-5700-b354-860862cd4e32" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -6 & -3 & 3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628677} {:answer/id #uuid "dbaa7895-ca7d-5665-b0f6-5a2d9ad9db00" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -12 & -6 & 6 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628678} {:answer/id #uuid "fcd7fe4e-0e39-5d52-8dc4-e8dc642b4528" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ 2 & 1 & -1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628682}] :answer-field/correct {:answer/id #uuid "da81ad41-adf0-5700-b354-860862cd4e32" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -6 & -3 & 3 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628677} :answer-field/id #uuid "021dcf23-2551-5896-9c64-de58bb89afa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186628648}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "84af82af-36d7-5515-95f6-9be0da8d0f18" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=\\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ 6 & 3 & -3 & 0\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{3}:=-1R_{3}$ on $V?$" :question/worked-solution "The operation $R_{3}:=-1R_{3}$ means that we need to multiply the third row of the matrix by $-1.$\n\nMultiplying the $3$rd row by $-1$, we obtain the following:\n\n$$\n\\begin{aligned}V &= \\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ 6 & 3 & -3 & 0\\end{array}\\right]\\,R_{3}:=-1R_{3} \\\\ &\\sim \\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -1\\cdot 6 & -1\\cdot 3 & -1\\cdot (-3) & -1\\cdot 0\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}-4 & -1 & -1 & -3 \\\\ 5 & 7 & -7 & 1 \\\\ -6 & -3 & 3 & 0\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186628667 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35364592-7ad8-569a-879d-5cb407331a32" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}2 & 2 & 0 & -2 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628654} {:answer/id #uuid "4185275a-6f68-5c0e-b541-0b4f205ab7a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}48 & 48 & 0 & -48 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628655} {:answer/id #uuid "cfe48e4f-9d4f-5a3b-a2e0-8f2adec3d6a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-42 & -42 & 0 & 42 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628676} {:answer/id #uuid "edf59bfc-048f-59ed-8e75-1c2048c8b541" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}18 & 18 & 0 & -18 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628679} {:answer/id #uuid "f62a1b90-751a-5648-b9d5-d1a52cade145" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-3 & -3 & 0 & 3 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628681}] :answer-field/correct {:answer/id #uuid "f62a1b90-751a-5648-b9d5-d1a52cade145" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-3 & -3 & 0 & 3 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]" :db/id #edb/ref 17592186628681} :answer-field/id #uuid "a1054aea-12a0-5b49-b02a-d37cd945a2f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186628668}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "9a93a829-8e1d-5d0a-9b12-6c2b80d92be0" :question/problem "Consider the augmented matrix $M,$ given by\n\n$$\nM=\\left[\\begin{array}{ccc|c}-6 & -6 & 0 & 6 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{1}:=\\frac{1}{2}R_{1}$ on $M?$" :question/worked-solution "The operation $R_{1}:=\\frac{1}{2}R_{1}$ means that we need to multiply the first row of the matrix by $\\frac{1}{2}.$\n\nMultiplying the $1$st row by $\\frac{1}{2}$, we obtain the following:\n\n$$\n\\begin{aligned}M &= \\left[\\begin{array}{ccc|c}-6 & -6 & 0 & 6 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]\\,R_{1}:=\\frac{1}{2}R_{1} \\\\ &\\sim \\left[\\begin{array}{ccc|c}\\frac{1}{2}\\cdot (-6) & \\frac{1}{2}\\cdot (-6) & \\frac{1}{2}\\cdot 0 & \\frac{1}{2}\\cdot 6 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}-3 & -3 & 0 & 3 \\\\ 8 & -5 & 7 & 6 \\\\ -8 & -5 & 0 & 0\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186629463 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b47bb76-7c64-522c-959e-2f653a3f28e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ -13 & 13 & 19 & -1\\end{array}\\right]" :db/id #edb/ref 17592186629465} {:answer/id #uuid "4ad8e309-8ecd-5367-b335-973988a3ab08" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ -18 & 15 & 28 & -1\\end{array}\\right]" :db/id #edb/ref 17592186629467} {:answer/id #uuid "555fece9-ce62-5f2e-9324-8775444aaf0e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ 12 & 3 & -26 & -1\\end{array}\\right]" :db/id #edb/ref 17592186629468} {:answer/id #uuid "c8b8ff97-f7a2-58ff-a624-624e19b3e7c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-3 & 9 & 1 & -1 \\\\ 5 & -2 & -9 & 0 \\\\ -2 & 20 & 4 & 4\\end{array}\\right]" :db/id #edb/ref 17592186629473} {:answer/id #uuid "f41667f2-8e9a-5595-84a4-8ae4ecc2b2b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-3 & 9 & 1 & -1 \\\\ 5 & -2 & -9 & 0 \\\\ 16 & -34 & -2 & 10\\end{array}\\right]" :db/id #edb/ref 17592186629476}] :answer-field/correct {:answer/id #uuid "4ad8e309-8ecd-5367-b335-973988a3ab08" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ -18 & 15 & 28 & -1\\end{array}\\right]" :db/id #edb/ref 17592186629467} :answer-field/id #uuid "6017f377-2001-5376-bcfa-fee88111ad6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186629469}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1da40b2e-70ac-5bee-872f-948fe9767cb3" :question/problem "Consider the augmented matrix $V,$ given by\n\n$$\nV=\\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ -3 & 9 & 1 & -1 \\\\ 7 & -7 & 1 & 7\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $V?$\n\n$$\n\\begin{aligned}R_{2} &\\leftrightarrow R_{3} \\\\ R_{3} &:=R_{3}+(-3)\\cdot R_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation $R_{2}\\leftrightarrow R_{3}$ means that we need to swap the second and third rows.\n\n- The operation $R_{3}:=R_{3}+(-3)\\cdot R_{1}$ means that we need to add $-3$ times the first row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}V &= \\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ -3 & 9 & 1 & -1 \\\\ 7 & -7 & 1 & 7\\end{array}\\right]\\,R_{2}\\leftrightarrow R_{3} \\\\ &\\sim \\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ -3 & 9 & 1 & -1\\end{array}\\right]\\,R_{3}:=R_{3}+(-3)\\cdot R_{1} \\\\ &\\sim {\\scriptsize \\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ -3+(-3)(5) & 9+(-3)(-2) & 1+(-3)(-9) & -1+(-3)(0)\\end{array}\\right]} \\\\ &\\sim \\left[\\begin{array}{ccc|c}5 & -2 & -9 & 0 \\\\ 7 & -7 & 1 & 7 \\\\ -18 & 15 & 28 & -1\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186629464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44b9d04a-886a-5857-a8b5-0e0e776a66e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & -6 & -1 & 7 \\\\ 3 & -7 & -9 & -6 \\\\ -5 & 12 & 26 & 5\\end{array}\\right]" :db/id #edb/ref 17592186629466} {:answer/id #uuid "bcc5bad4-e412-52a8-91d5-291fd8cb7f85" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & -6 & -1 & 7 \\\\ 3 & -7 & -9 & -6 \\\\ 10 & -23 & -19 & -25\\end{array}\\right]" :db/id #edb/ref 17592186629471} {:answer/id #uuid "c4d4b288-1068-534d-9074-9a7c2cea7afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}3 & -7 & -9 & -6 \\\\ 1 & -2 & 8 & -7 \\\\ 6 & 0 & -25 & 28\\end{array}\\right]" :db/id #edb/ref 17592186629472} {:answer/id #uuid "d0db3a79-1195-5ad3-9363-9c85005dff79" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}3 & -7 & -9 & -6 \\\\ 1 & -2 & 8 & -7 \\\\ 10 & -8 & 7 & 0\\end{array}\\right]" :db/id #edb/ref 17592186629474} {:answer/id #uuid "ddd93109-8345-54ee-b41d-6395d200c46c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & -6 & -1 & 7 \\\\ 3 & -7 & -9 & -6 \\\\ 7 & -16 & -10 & -19\\end{array}\\right]" :db/id #edb/ref 17592186629475}] :answer-field/correct {:answer/id #uuid "d0db3a79-1195-5ad3-9363-9c85005dff79" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}3 & -7 & -9 & -6 \\\\ 1 & -2 & 8 & -7 \\\\ 10 & -8 & 7 & 0\\end{array}\\right]" :db/id #edb/ref 17592186629474} :answer-field/id #uuid "838915cd-252e-5d8e-bfa7-e7fd46978c52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186629470}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "30da651d-7305-59c6-b7f9-24ee29150d5f" :question/problem "Consider the augmented matrix $T,$ given by\n\n$$\nT=\\left[\\begin{array}{ccc|c}9 & -6 & -1 & 7 \\\\ 1 & -2 & 8 & -7 \\\\ 3 & -7 & -9 & -6\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the following row operations on $T?$\n\n$$\n\\begin{aligned}R_{1} &\\leftrightarrow R_{3} \\\\ R_{3} &:=R_{3}+(1)\\cdot R_{2}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation $R_{1}\\leftrightarrow R_{3}$ means that we need to swap the first and third rows.\n\n- The operation $R_{3}:=R_{3}+(1)\\cdot R_{2}$ means that we need to add $1$ times the second row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}T &= \\left[\\begin{array}{ccc|c}9 & -6 & -1 & 7 \\\\ 1 & -2 & 8 & -7 \\\\ 3 & -7 & -9 & -6\\end{array}\\right]\\,R_{1}\\leftrightarrow R_{3} \\\\ &\\sim \\left[\\begin{array}{ccc|c}3 & -7 & -9 & -6 \\\\ 1 & -2 & 8 & -7 \\\\ 9 & -6 & -1 & 7\\end{array}\\right]\\,R_{3}:=R_{3}+(1)\\cdot R_{2} \\\\ &\\sim {\\scriptsize \\left[\\begin{array}{ccc|c}3 & -7 & -9 & -6 \\\\ 1 & -2 & 8 & -7 \\\\ 9+(1)(1) & -6+(1)(-2) & -1+(1)(8) & 7+(1)(-7)\\end{array}\\right]} \\\\ &\\sim \\left[\\begin{array}{ccc|c}3 & -7 & -9 & -6 \\\\ 1 & -2 & 8 & -7 \\\\ 10 & -8 & 7 & 0\\end{array}\\right]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186630307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26cd85ee-3609-586d-8aff-5605c1ac297a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}9 & 4 & 20 & -13 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]" :db/id #edb/ref 17592186630303} {:answer/id #uuid "29c602e2-7fe4-5383-a18d-36413bee5bd0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-18 & -5 & -1 & -7 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]" :db/id #edb/ref 17592186630304} {:answer/id #uuid "2e375390-f2dc-5bf5-8cad-dd3d3255a387" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}18 & 7 & 27 & -15 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]" :db/id #edb/ref 17592186630305} {:answer/id #uuid "79e9fa3c-7c5b-5876-97a6-857eecf60226" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-27 & -8 & -8 & -5 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]" :db/id #edb/ref 17592186630306} {:answer/id #uuid "9b8a7d55-ac6c-5d35-bdf4-923dd5acb922" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}-36 & -11 & -15 & -3 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]" :db/id #edb/ref 17592186630308}] :answer-field/correct {:answer/id #uuid "2e375390-f2dc-5bf5-8cad-dd3d3255a387" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}18 & 7 & 27 & -15 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]" :db/id #edb/ref 17592186630305} :answer-field/id #uuid "f2e651d9-1b95-5bef-94f8-701c737a8542" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186630309}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "839b0e06-639d-5c37-b65a-946c60ba942d" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=\\left[\\begin{array}{ccc|c}-9 & -2 & 6 & -9 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{1}:=R_{1}+(3)\\cdot R_{3}$ on $X?$" :question/worked-solution "The operation $R_{1}:=R_{1}+(3)\\cdot R_{3}$ means that we need to add $3$ times the third row to the first row.\n\nApplying this row operation, we obtain the following:\n\n$$\nX=\\left[\\begin{array}{ccc|c}-9 & -2 & 6 & -9 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]\\,R_{1}:=R_{1}+(3)\\cdot R_{3}\n$$\n\n$$\n\\sim {\\scriptsize \\left[\\begin{array}{ccc|c}-9+(3)(9) & -2+(3)(3) & 6+(3)(7) & -9+(3)(-2) \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]}\n$$\n\n$$\n\\sim \\left[\\begin{array}{ccc|c}18 & 7 & 27 & -15 \\\\ 1 & -3 & -9 & -5 \\\\ 9 & 3 & 7 & -2\\end{array}\\right]\n$$"} {:db/id #edb/ref 17592186639186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0930acbc-df69-576b-87d7-072b49518f33" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -1 & 2 \\\\ 0 & -1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186638644} {:answer/id #uuid "28a55372-