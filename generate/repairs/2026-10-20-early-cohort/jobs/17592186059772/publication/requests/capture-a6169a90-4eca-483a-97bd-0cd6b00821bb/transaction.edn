86e-bcb4-56ce-bc69-5a9fe7feeab8" :answer/validate] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/id #uuid "f6a1264e-4248-55d2-8d2f-9287a3519416"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/key "selection"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/type :answer-field.type/radio] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/choices "1e8f318a-4b05-5483-b9f8-a69edf57ca91"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/choices "553aa0fc-4c86-59a9-adba-cb55f57f2a34"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/choices "151bdf79-6ffb-50d8-84ae-8eb6a65a37b1"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/choices "1beb0786-7dfb-57d9-b4cb-5d327992955c"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/choices "5755e86e-bcb4-56ce-bc69-5a9fe7feeab8"] [:db/add "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/correct "1e8f318a-4b05-5483-b9f8-a69edf57ca91"] [:db/ensure "f6a1264e-4248-55d2-8d2f-9287a3519416" :answer-field/validate] [:db/add "19d1001c-79db-5e40-a7ba-fcae25a87df9" :question/id #uuid "19d1001c-79db-5e40-a7ba-fcae25a87df9"] [:db/add "19d1001c-79db-5e40-a7ba-fcae25a87df9" :question/problem "Consider the augmented matrix $N,$ given by\n\n$$\nN=\\left[\\begin{array}{cc|c}-1 & -9 & 3 \\\\ -3 & 2 & 5 \\\\ 3 & 5 & -9\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{1}\\leftrightarrow R_{2}$ on $N?$"] [:db/add "19d1001c-79db-5e40-a7ba-fcae25a87df9" :question/worked-solution "The operation $R_{1}\\leftrightarrow R_{2}$ means that we need to swap the first and second rows.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}N &= \\left[\\begin{array}{cc|c}-1 & -9 & 3 \\\\ -3 & 2 & 5 \\\\ 3 & 5 & -9\\end{array}\\right]\\,R_{1}\\leftrightarrow R_{2} \\\\ &\\sim \\left[\\begin{array}{cc|c}-3 & 2 & 5 \\\\ -1 & -9 & 3 \\\\ 3 & 5 & -9\\end{array}\\right]\\end{aligned}\n$$"] [:db/add "19d1001c-79db-5e40-a7ba-fcae25a87df9" :question/difficulty :question.difficulty/easy] [:db/add "19d1001c-79db-5e40-a7ba-fcae25a87df9" :question/answer-fields "f6a1264e-4248-55d2-8d2f-9287a3519416"] [:db/ensure "19d1001c-79db-5e40-a7ba-fcae25a87df9" :question/validate] [:db/add 17592186059772 :knowledge-point/questions "19d1001c-79db-5e40-a7ba-fcae25a87df9"] [:db/add "dee7c693-a223-5ef5-bea8-6ece9198d75c" :answer/id #uuid "dee7c693-a223-5ef5-bea8-6ece9198d75c"] [:db/add "dee7c693-a223-5ef5-bea8-6ece9198d75c" :answer/type :answer.type/math] [:db/add "dee7c693-a223-5ef5-bea8-6ece9198d75c" :answer/value "\\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ -27 & -9 & 0 & 18 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]"] [:db/ensure "dee7c693-a223-5ef5-bea8-6ece9198d75c" :answer/validate] [:db/add "6afdfbdf-01a6-5077-b8c8-7ef06201794c" :answer/id #uuid "6afdfbdf-01a6-5077-b8c8-7ef06201794c"] [:db/add "6afdfbdf-01a6-5077-b8c8-7ef06201794c" :answer/type :answer.type/math] [:db/add "6afdfbdf-01a6-5077-b8c8-7ef06201794c" :answer/value "\\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ 36 & 12 & 0 & -24 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]"] [:db/ensure "6afdfbdf-01a6-5077-b8c8-7ef06201794c" :answer/validate] [:db/add "766f908b-32f6-5b4a-92ac-88873dd5c7d0" :answer/id #uuid "766f908b-32f6-5b4a-92ac-88873dd5c7d0"] [:db/add "766f908b-32f6-5b4a-92ac-88873dd5c7d0" :answer/type :answer.type/math] [:db/add "766f908b-32f6-5b4a-92ac-88873dd5c7d0" :answer/value "\\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ 9 & 3 & 0 & -6 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]"] [:db/ensure "766f908b-32f6-5b4a-92ac-88873dd5c7d0" :answer/validate] [:db/add "32ad9b6d-f93a-5099-8f3e-b31c2f33b994" :answer/id #uuid "32ad9b6d-f93a-5099-8f3e-b31c2f33b994"] [:db/add "32ad9b6d-f93a-5099-8f3e-b31c2f33b994" :answer/type :answer.type/math] [:db/add "32ad9b6d-f93a-5099-8f3e-b31c2f33b994" :answer/value "\\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ 45 & 15 & 0 & -30 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]"] [:db/ensure "32ad9b6d-f93a-5099-8f3e-b31c2f33b994" :answer/validate] [:db/add "4d4e6880-9a4f-5506-8267-4d9fcc322aa1" :answer/id #uuid "4d4e6880-9a4f-5506-8267-4d9fcc322aa1"] [:db/add "4d4e6880-9a4f-5506-8267-4d9fcc322aa1" :answer/type :answer.type/math] [:db/add "4d4e6880-9a4f-5506-8267-4d9fcc322aa1" :answer/value "\\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ 3 & 1 & 0 & -2 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]"] [:db/ensure "4d4e6880-9a4f-5506-8267-4d9fcc322aa1" :answer/validate] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/id #uuid "614086b5-913f-5449-8046-ab3d4067612b"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/key "selection"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/type :answer-field.type/radio] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/choices "dee7c693-a223-5ef5-bea8-6ece9198d75c"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/choices "6afdfbdf-01a6-5077-b8c8-7ef06201794c"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/choices "766f908b-32f6-5b4a-92ac-88873dd5c7d0"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/choices "32ad9b6d-f93a-5099-8f3e-b31c2f33b994"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/choices "4d4e6880-9a4f-5506-8267-4d9fcc322aa1"] [:db/add "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/correct "32ad9b6d-f93a-5099-8f3e-b31c2f33b994"] [:db/ensure "614086b5-913f-5449-8046-ab3d4067612b" :answer-field/validate] [:db/add "7a7d5b18-2dba-53d5-9965-48c9cc187cd5" :question/id #uuid "7a7d5b18-2dba-53d5-9965-48c9cc187cd5"] [:db/add "7a7d5b18-2dba-53d5-9965-48c9cc187cd5" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=\\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ -9 & -3 & 0 & 6 \\\\ 9 & 0 & -8 & 2\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{2}:=-5R_{2}$ on $X?$"] [:db/add "7a7d5b18-2dba-53d5-9965-48c9cc187cd5" :question/worked-solution "The operation $R_{2}:=-5R_{2}$ means that we need to multiply the second row of the matrix by $-5.$\n\nMultiplying the $2$nd row by $-5$, we obtain the following:\n\n$$\n\\begin{aligned}X &= \\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ -9 & -3 & 0 & 6 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]\\,R_{2}:=-5R_{2} \\\\ &\\sim \\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ -5\\cdot (-9) & -5\\cdot (-3) & -5\\cdot 0 & -5\\cdot 6 \\\\ 9 & 0 & -8 & 2\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}9 & -2 & -6 & -2 \\\\ 45 & 15 & 0 & -30 \\\\ 9 & 0 & -8 & 2\\end{array}\\right]\\end{aligned}\n$$"] [:db/add "7a7d5b18-2dba-53d5-9965-48c9cc187cd5" :question/difficulty :question.difficulty/easy] [:db/add "7a7d5b18-2dba-53d5-9965-48c9cc187cd5" :question/answer-fields "614086b5-913f-5449-8046-ab3d4067612b"] [:db/ensure "7a7d5b18-2dba-53d5-9965-48c9cc187cd5" :question/validate] [:db/add 17592186059772 :knowledge-point/questions "7a7d5b18-2dba-53d5-9965-48c9cc187cd5"] [:db/add "6c00b5b8-36c1-55d0-9477-27265416dbc9" :answer/id #uuid "6c00b5b8-36c1-55d0-9477-27265416dbc9"] [:db/add "6c00b5b8-36c1-55d0-9477-27265416dbc9" :answer/type :answer.type/math] [:db/add "6c00b5b8-36c1-55d0-9477-27265416dbc9" :answer/value "\\left[\\begin{array}{ccc|c}-15 & 10 & -10 & -5 \\\\ -7 & 5 & 7 & -9 \\\\ 4 & 7 & 8 & -7\\end{array}\\right]"] [:db/ensure "6c00b5b8-36c1-55d0-9477-27265416dbc9" :answer/validate] [:db/add "320495cd-b91e-5ab4-9636-a2cb8d05472b" :answer/id #uuid "320495cd-b91e-5ab4-9636-a2cb8d05472b"] [:db/add "320495cd-b91e-5ab4-9636-a2cb8d05472b" :answer/type :answer.type/math] [:db/add "320495cd-b91e-5ab4-9636-a2cb8d05472b" :answer/value "\\left[\\begin{array}{ccc|c}-21 & 14 & -14 & -7 \\\\ -7 & 5 & 7 & -9 \\\\ 4 & 7 & 8 & -7\\end{array}\\right]"] [:db/ensure "320495cd-b91e-5ab4-9636-a2cb8d05472b" :answer/validate] [:db/add "6084677b-5c08-5b50-81c3-ddab45a25eb9" :answer/id #uuid "6084677b-5c08-5b50-81c3-ddab45a25eb9"] [:db/add "6084677b-5c08-5b50-81c3-ddab45a25eb9" 