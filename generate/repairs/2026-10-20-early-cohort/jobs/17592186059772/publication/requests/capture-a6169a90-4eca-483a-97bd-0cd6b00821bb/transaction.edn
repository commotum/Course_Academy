 & 2\\end{array}\\right]"] [:db/ensure "6f521d2f-f281-5d43-b16c-eda612ef8e53" :answer/validate] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/id #uuid "a6729897-9bd7-550f-b7ee-b3398801fd49"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/key "selection"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/type :answer-field.type/radio] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/choices "29db2372-9d9c-5285-9fb1-23ab8ab39578"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/choices "a9e03b59-2317-54f4-9ca4-19f17c3f6f5d"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/choices "9a37d427-ba38-52de-b2fb-008eed6dea59"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/choices "1741e930-88c5-59a2-8eab-994a49471201"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/choices "6f521d2f-f281-5d43-b16c-eda612ef8e53"] [:db/add "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/correct "9a37d427-ba38-52de-b2fb-008eed6dea59"] [:db/ensure "a6729897-9bd7-550f-b7ee-b3398801fd49" :answer-field/validate] [:db/add "48b182ad-5f37-5978-a79b-c33454ac67cb" :question/id #uuid "48b182ad-5f37-5978-a79b-c33454ac67cb"] [:db/add "48b182ad-5f37-5978-a79b-c33454ac67cb" :question/problem "Consider the augmented matrix $U,$ given by\n\n$$\nU=\\left[\\begin{array}{ccc|c}1 & -2 & -9 & -6 \\\\ 0 & -6 & 6 & -6 \\\\ -4 & 8 & 8 & 2\\end{array}\\right].\n$$\n\nWhat matrix results from carrying out the row operation $R_{2}:=\\frac{1}{2}R_{2}$ on $U?$"] [:db/add "48b182ad-5f37-5978-a79b-c33454ac67cb" :question/worked-solution "The operation $R_{2}:=\\frac{1}{2}R_{2}$ means that we need to multiply the second row of the matrix by $\\frac{1}{2}.$\n\nMultiplying the $2$nd row by $\\frac{1}{2}$, we obtain the following:\n\n$$\n\\begin{aligned}U &= \\left[\\begin{array}{ccc|c}1 & -2 & -9 & -6 \\\\ 0 & -6 & 6 & -6 \\\\ -4 & 8 & 8 & 2\\end{array}\\right]\\,R_{2}:=\\frac{1}{2}R_{2} \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -2 & -9 & -6 \\\\ \\frac{1}{2}\\cdot 0 & \\frac{1}{2}\\cdot (-6) & \\frac{1}{2}\\cdot 6 & \\frac{1}{2}\\cdot (-6) \\\\ -4 & 8 & 8 & 2\\end{array}\\right] \\\\ &\\sim \\left[\\begin{array}{ccc|c}1 & -2 & -9 & -6 \\\\ 0 & -3 & 3 & -3 \\\\ -4 & 8 & 8 & 2\\end{array}\\right]\\end{aligned}\n$$"] [:db/add "48b182ad-5f37-5978-a79b-c33454ac67cb" :question/difficulty :question.difficulty/easy] [:db/add "48b182ad-5f37-5978-a79b-c33454ac67cb" :question/answer-fields "a6729897-9bd7-550f-b7ee-b3398801fd49"] [:db/ensure "48b182ad-5f37-5978-a79b-c33454ac67cb" :question/validate] [:db/add 17592186059772 :knowledge-point/questions "48b182ad-5f37-5978-a79b-c33454ac67cb"] [:db/add "generator" :question-generator/id #uuid "22e48032-2e30-520e-ad95-11b695a10c56"] [:db/add "generator" :question-generator/script "generators/7b/7b5219ae418b99e2d871c04735da74eeee316a0a80b73eeefb085c5811a387eb/generator.py"] [:db/add 17592186059772 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059772 :knowledge-point/validate]]
