7b8e-125b-5fb2-bef1-4f975e2143e4" :answer-field/choices "43c21da3-ea72-5125-be19-3be6a575a8f3"] [:db/add "a2f37b8e-125b-5fb2-bef1-4f975e2143e4" :answer-field/correct "78871fa2-3d48-5d31-a760-6b331565db36"] [:db/ensure "a2f37b8e-125b-5fb2-bef1-4f975e2143e4" :answer-field/validate] [:db/add "7220076f-7a8f-59d7-a472-6fa27abeba93" :question/id #uuid "7220076f-7a8f-59d7-a472-6fa27abeba93"] [:db/add "7220076f-7a8f-59d7-a472-6fa27abeba93" :question/problem "The temperature $T(t),$ in degrees Celsius, of a cooling iron can be modeled by the differential equation\n\n$$\n\\frac{dT}{dt}=-0.15(T-34)\n$$\n\nwhere $t>0$ is the time, measured in minutes. If the initial temperature of the iron is ${176}^{∘}C,$ calculate its temperature after $7$ minutes. Round your answer to the nearest integer."] [:db/add "7220076f-7a8f-59d7-a472-6fa27abeba93" :question/worked-solution "We're told that the temperature of the cooling iron is modeled by the inhibited decay equation\n\n$$\n\\frac{dT}{dt}=-0.15(T-34).\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-34} & =-0.15\\,dt \\\\ \\int \\frac{dT}{T-34} & =-\\int 0.15\\,\\text{d}t \\\\ \\operatorname{ln}⁡|T-34| & =-0.15t+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-34>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-34 & ={e}^{-0.15t+C} \\\\ T-34 & ={e}^{C}{e}^{-0.15t} \\\\ T-34 & =K{e}^{-0.15t} \\\\ T & =34+K{e}^{-0.15t}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nWe're told that the initial temperature of the iron was ${176}^{∘}C.$ So, we apply the initial condition $T(0)=176,$ and solve for $K:$\n\n$$\n\\begin{aligned}176 & =34+K{e}^{0} \\\\ 176 & =34+K \\\\ K & =142\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is\n\n$$\nT(t)=34+142{e}^{-0.15t}.\n$$\n\nFinally, the temperature of the iron after $t=7$ minutes is\n\n$$\nT(7)=34+142{e}^{-0.15\\cdot 7}≈{84}^{∘}\\text{C},\n$$\n\nrounded to the nearest integer."] [:db/add "7220076f-7a8f-59d7-a472-6fa27abeba93" :question/difficulty :question.difficulty/easy] [:db/add "7220076f-7a8f-59d7-a472-6fa27abeba93" :question/answer-fields "a2f37b8e-125b-5fb2-bef1-4f975e2143e4"] [:db/ensure "7220076f-7a8f-59d7-a472-6fa27abeba93" :question/validate] [:db/add 17592186078584 :knowledge-point/questions "7220076f-7a8f-59d7-a472-6fa27abeba93"] [:db/add "generator" :question-generator/id #uuid "32b627c5-e61d-57f4-8f7b-9a852b6b827d"] [:db/add "generator" :question-generator/script "generators/ea/ea9f9c395ebf21346cc1ef90721fc8984affd1005b9b760d96cdc910ae4ca0be/17592186078584.py"] [:db/add 17592186078584 :knowledge-point/question-generator "generator"] [:db/ensure 17592186078584 :knowledge-point/validate]]
