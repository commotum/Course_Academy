              ":answer/type": ":answer.type/math",
              ":answer/value": "y=6 \\left(x - 1\\right)^{2} + \\ln{\\left(\\sin{\\left(x - 1 \\right)} \\right)} - \\frac{\\pi^{2}}{2}"
            },
            {
              ":answer/id": "06fadc6d-ff38-5166-9b59-377788f5c87b",
              ":answer/type": ":answer.type/math",
              ":answer/value": "y=\\left(x - 1\\right)^{2} + \\ln{\\left(\\sin{\\left(x - 1 \\right)} \\right)} - 3 + \\frac{3 \\pi^{2}}{4}"
            },
            {
