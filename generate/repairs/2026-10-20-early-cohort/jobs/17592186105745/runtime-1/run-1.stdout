              ":answer/id": "2fbdb83e-d1c8-5955-ade2-674c6b8cb588",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\u27e8-2y-4,y\u27e9,\\,y\\in (-\\infty ,\\infty )"
            },
            {
