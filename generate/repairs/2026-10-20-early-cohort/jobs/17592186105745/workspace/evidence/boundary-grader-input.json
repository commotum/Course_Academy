              },
              {
                ":answer/id": "eed1ca60-8f38-5218-8ccf-1717dfbbe4ba",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\begin{aligned}\\begin{bmatrix}x \\\\  y \\end{bmatrix}=\\begin{bmatrix} -3y-4 \\\\  y \\end{bmatrix},\\,y\\in (-\\infty ,\\infty )\\end{aligned}"
