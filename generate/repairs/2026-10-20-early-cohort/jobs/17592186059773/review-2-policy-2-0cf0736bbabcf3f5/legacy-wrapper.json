                ":answer/value": "{R}_{1}:={R}_{1}+(-2)\\cdot {R}_{2}"
              },
              {
                ":answer/id": "9676dd32-1b5f-5110-a01b-928502f70e81",
                ":answer/type": ":answer.type/math",
                ":answer/value": "{R}_{1}:=\\frac{1}{5}\\cdot {R}_{1}"
              },
              {
