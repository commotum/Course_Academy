            {
              ":answer/id": "eea22eb7-5af3-59d0-b7c4-443dee9d5de9",
              ":answer/type": ":answer.type/math",
              ":answer/value": "{R}_{3}:={R}_{3}+(-6)\\cdot {R}_{1}"
            }
          ],
          ":answer-field/correct": [
