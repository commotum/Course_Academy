\n$$\n\\begin{aligned}A & =\\begin{bmatrix}5 & 3 & -3 \\\\ 10 & 5 & -5 \\\\ -8 & 0 & 2\\end{bmatrix} & {R}_{2}:={R}_{2}+{R}_{3} \\\\ & \\sim\\begin{bmatrix}5 & 3 & -3 \\\\ 2 & 5 & -3 \\\\ -8 & 0 & 2\\end{bmatrix} \\\\ & =B.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+{R}_{3}.\n$$"] [:db/add "3b112fa4-2d62-5d19-bdb9-e39600ac6198" :question/difficulty :question.difficulty/moderate] [:db/add "3b112fa4-2d62-5d19-bdb9-e39600ac6198" :question/answer-fields "5b02d08c-cfee-5b56-8574-19bf8c040f1e"] [:db/ensure "3b112fa4-2d62-5d19-bdb9-e39600ac6198" :question/validate] [:db/add 17592186059773 :knowledge-point/questions "3b112fa4-2d62-5d19-bdb9-e39600ac6198"] [:db/add "9b1373af-ae99-5e57-8250-c2d265f45de7" :answer/id #uuid "9b1373af-ae99-5e57-8250-c2d265f45de7"] [:db/add "9b1373af-ae99-5e57-8250-c2d265f45de7" :answer/type :answer.type/math] [:db/add "9b1373af-ae99-5e57-8250-c2d265f45de7" :answer/value "{R}_{1}:={R}_{1}-\\frac{1}{2}{R}_{2}"] [:db/ensure "9b1373af-ae99-5e57-8250-c2d265f45de7" :answer/validate] [:db/add "e85f7e18-d560-538d-a750-738066cab38a" :answer/id #uuid "e85f7e18-d560-538d-a750-738066cab38a"] [:db/add "e85f7e18-d560-538d-a750-738066cab38a" :answer/type :answer.type/math] [:db/add "e85f7e18-d560-538d-a750-738066cab38a" :answer/value "{R}_{1}:=-\\frac{1}{4}{R}_{1}"] [:db/ensure "e85f7e18-d560-538d-a750-738066cab38a" :answer/validate] [:db/add "bb136ff1-ecc3-56cc-ad4a-0cfca57e4014" :answer/id #uuid "bb136ff1-ecc3-56cc-ad4a-0cfca57e4014"] [:db/add "bb136ff1-ecc3-56cc-ad4a-0cfca57e4014" :answer/type :answer.type/math] [:db/add "bb136ff1-ecc3-56cc-ad4a-0cfca57e4014" :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}"] [:db/ensure "bb136ff1-ecc3-56cc-ad4a-0cfca57e4014" :answer/validate] [:db/add "d1920ff3-3a5b-54f2-baa5-16ea00b8eee0" :answer/id #uuid "d1920ff3-3a5b-54f2-baa5-16ea00b8eee0"] [:db/add "d1920ff3-3a5b-54f2-baa5-16ea00b8eee0" :answer/type :answer.type/math] [:db/add "d1920ff3-3a5b-54f2-baa5-16ea00b8eee0" :answer/value "