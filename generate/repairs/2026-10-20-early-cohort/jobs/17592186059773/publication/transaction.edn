ed}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{3}:=(-2)\\cdot {R}_{3}.\n$$"] [:db/add "917ce506-b633-5916-a853-d9133948ab25" :question/difficulty :question.difficulty/moderate] [:db/add "917ce506-b633-5916-a853-d9133948ab25" :question/answer-fields "c31cc8a2-1b91-5fe7-adee-4dc3048a6f1e"] [:db/ensure "917ce506-b633-5916-a853-d9133948ab25" :question/validate] [:db/add 17592186059773 :knowledge-point/questions "917ce506-b633-5916-a853-d9133948ab25"] [:db/add "64ea44c0-db47-5ed6-99ee-955368123b1b" :answer/id #uuid "64ea44c0-db47-5ed6-99ee-955368123b1b"] [:db/add "64ea44c0-db47-5ed6-99ee-955368123b1b" :answer/type :answer.type/math] [:db/add "64ea44c0-db47-5ed6-99ee-955368123b1b" :answer/value "{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}"] [:db/ensure "64ea44c0-db47-5ed6-99ee-955368123b1b" :answer/validate] [:db/add "22bcb123-7d72-5b64-a9d1-49e5003cae80" :answer/id #uuid "22bcb123-7d72-5b64-a9d1-49e5003cae80"] [:db/add "22bcb123-7d72-5b64-a9d1-49e5003cae80" :answer/type :answer.type/math] [:db/add "22bcb123-7d72-5b64-a9d1-49e5003cae80" :answer/value "{R}_{2}:=\\frac{1}{5}\\cdot {R}_{2}"] [:db/ensure "22bcb123-7d72-5b64-a9d1-49e5003cae80" :answer/validate] [:db/add "a244187c-fe78-518c-99b1-f110e580f3ee" :answer/id #uuid "a244187c-fe78-518c-99b1-f110e580f3ee"] [:db/add "a244187c-fe78-518c-99b1-f110e580f3ee" :answer/type :answer.type/math] [:db/add "a244187c-fe78-518c-99b1-f110e580f3ee" :answer/value "{R}_{2}:={R}_{2}+{R}_{3}"] [:db/ensure "a244187c-fe78-518c-99b1-f110e580f3ee" :answer/validate] [:db/add "ce559007-a651-5962-8b8c-6d51295dd50b" :answer/id #uuid "ce559007-a651-5962-8b8c-6d51295dd50b"] [:db/add "ce559007-a651-5962-8b8c-6d51295dd50b" :answer/type :answer.type/math] [:db/add "ce559007-a651-5962-8b8c-6d51295dd50b" :answer/value "{R}_{3}:={R}_{3}+{R}_{2}"] [:db/ensure "ce559007-a651-5962-8b8c-6d51295dd50b" :answer/validate] [:db/add "4648f90c-5318-5e25-b2d8-6822bbf29913" :answer/id #uuid "4648f90c-5318-5e25-b2d8-6822bbf29913"] [:db/add "4648f90c-5318-5e25-