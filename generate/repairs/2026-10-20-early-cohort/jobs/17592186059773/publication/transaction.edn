 -3 \\\\ 0 & 0 & 5\\end{bmatrix}\n$$\n\n$$\nW=\\begin{bmatrix}2 & 6 & 10 \\\\ 1 & -1 & 22 \\\\ 0 & 0 & 5\\end{bmatrix}?\n$$"] [:db/add "028b9f80-be4b-514f-96c8-bf8a675f4496" :question/worked-solution "First, notice that the $1$st and $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row.\n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =\\begin{bmatrix}2 & 6 & 10 \\\\ 1 & -1 & -3 \\\\ 0 & 0 & 5\\end{bmatrix} & {R}_{2}:={R}_{2}+5{R}_{3} \\\\ & \\sim\\begin{bmatrix}2 & 6 & 10 \\\\ 1 & -1 & 22 \\\\ 0 & 0 & 5\\end{bmatrix} \\\\ & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+5{R}_{3}.\n$$"] [:db/add "028b9f80-be4b-514f-96c8-bf8a675f4496" :question/difficulty :question.difficulty/moderate] [:db/add "028b9f80-be4b-514f-96c8-bf8a675f4496" :question/answer-fields "5dc204c9-6b30-5cbf-8de6-152dbeb14a54"] [:db/ensure "028b9f80-be4b-514f-96c8-bf8a675f4496" :question/validate] [:db/add 17592186059773 :knowledge-point/questions "028b9f80-be4b-514f-96c8-bf8a675f4496"] [:db/add "generator" :question-generator/id #uuid "03c044da-3662-5fe7-a3af-aaa1a52b13de"] [:db/add "generator" :question-generator/script "generators/c7/c778b1566106f5f6757b13df5ed739a8a523d068d91b2401754647e7b307e4c9/17592186059773.py"] [:db/add 17592186059773 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059773 :knowledge-point/validate]]
