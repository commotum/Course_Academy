1c25f2" :question/answer-fields "7e01e701-0059-51a9-91ba-a1ac7a2e2db4"] [:db/ensure "0ba0ede5-480d-55fc-9235-01f8261c25f2" :question/validate] [:db/add 17592186059773 :knowledge-point/questions "0ba0ede5-480d-55fc-9235-01f8261c25f2"] [:db/add "41d478ae-6352-5a3e-a219-fbf4a65d8339" :answer/id #uuid "41d478ae-6352-5a3e-a219-fbf4a65d8339"] [:db/add "41d478ae-6352-5a3e-a219-fbf4a65d8339" :answer/type :answer.type/math] [:db/add "41d478ae-6352-5a3e-a219-fbf4a65d8339" :answer/value "{R}_{3}:=(-2)\\cdot {R}_{3}"] [:db/ensure "41d478ae-6352-5a3e-a219-fbf4a65d8339" :answer/validate] [:db/add "157adabb-6058-57f9-a6ee-0c851514695a" :answer/id #uuid "157adabb-6058-57f9-a6ee-0c851514695a"] [:db/add "157adabb-6058-57f9-a6ee-0c851514695a" :answer/type :answer.type/math] [:db/add "157adabb-6058-57f9-a6ee-0c851514695a" :answer/value "{R}_{3}:=\\left(-\\frac{1}{2}\\right)\\cdot {R}_{3}"] [:db/ensure "157adabb-6058-57f9-a6ee-0c851514695a" :answer/validate] [:db/add "88feb840-1dc0-5203-ae30-a4fdaddc1ddf" :answer/id #uuid "88feb840-1dc0-5203-ae30-a4fdaddc1ddf"] [:db/add "88feb840-1dc0-5203-ae30-a4fdaddc1ddf" :answer/type :answer.type/math] [:db/add "88feb840-1dc0-5203-ae30-a4fdaddc1ddf" :answer/value "{R}_{3}:={R}_{3}+(-6)\\cdot {R}_{2}"] [:db/ensure "88feb840-1dc0-5203-ae30-a4fdaddc1ddf" :answer/validate] [:db/add "091647ca-c642-5f03-aa53-6f1303d9f212" :answer/id #uuid "091647ca-c642-5f03-aa53-6f1303d9f212"] [:db/add "091647ca-c642-5f03-aa53-6f1303d9f212" :answer/type :answer.type/math] [:db/add "091647ca-c642-5f03-aa53-6f1303d9f212" :answer/value "{R}_{2}:={R}_{2}+2\\cdot {R}_{3}"] [:db/ensure "091647ca-c642-5f03-aa53-6f1303d9f212" :answer/validate] [:db/add "062ca529-bed3-5bbf-88ee-2b4408303fc8" :answer/id #uuid "062ca529-bed3-5bbf-88ee-2b4408303fc8"] [:db/add "062ca529-bed3-5bbf-88ee-2b4408303fc8" :answer/type :answer.type/math] [:db/add "062ca529-bed3-5bbf-88ee-2b4408303fc8" :answer/value "{R}_{3}:={R}_{3}+(-6)\\cdot {R}_{1}"] [:db/ensure "062ca529-bed3-5bbf-88ee-2b4408303fc8" :ans