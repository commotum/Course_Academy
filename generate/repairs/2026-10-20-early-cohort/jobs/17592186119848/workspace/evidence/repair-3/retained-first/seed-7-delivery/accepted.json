              ":answer/value": "B=\\begin{bmatrix}10 & -2 \\\\ 0 & 6\\end{bmatrix}"
            },
            {
              ":answer/id": "d95dfab0-0ac4-5d3b-abd0-59d25871e02e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "A=\\begin{bmatrix}4 & 2 & 0 & 2 & 0 \\\\ 0 & -2 & 0 & 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "5b73eddc-711b-5f4c-a658-e5b3298c685b",
              ":answer/type": ":answer.type/math",
              ":answer/value": "C=\\begin{bmatrix}4 & 2 & 6 & 2 & 0 \\\\ 0 & -2 & 0 & 4 & 2 \\\\ 0 & 0 & 0 & 0 & 4 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "91a911ec-2b71-506b-963d-31999ed48bf2",
              ":answer/type": ":answer.type/math",
              ":answer/value": "E=\\begin{bmatrix}-2 & 4 \\\\ 0 & 2 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "a4f55fd7-7566-53dd-96fe-b8ceb61b78d3",
              ":answer/type": ":answer.type/math",
              ":answer/value": "D=\\begin{bmatrix}6 & 4 & 2 \\\\ 0 & -2 & 4 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}"
            }
          ],
