              ":answer/type": ":answer.type/math",
              ":answer/value": "E=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 4 & 2 & 0 & 0 \\\\ 2 & 6 & 2 & 0 \\\\ 0 & 0 & 0 & 2\\end{bmatrix}"
