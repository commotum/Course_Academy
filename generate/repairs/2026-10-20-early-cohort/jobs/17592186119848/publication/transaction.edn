\""] [:db/add "73b14aa6-7c98-5a49-b139-dd7836712968" :question/difficulty :question.difficulty/easy] [:db/add "73b14aa6-7c98-5a49-b139-dd7836712968" :question/answer-fields "0a44ba50-4fc7-5d72-9e43-4c1e485bea6c"] [:db/add "73b14aa6-7c98-5a49-b139-dd7836712968" :question/answer-fields "50dd0c61-e592-5614-8a75-92be24f4b6ba"] [:db/add "73b14aa6-7c98-5a49-b139-dd7836712968" :question/answer-fields "b1d87291-e04e-5677-b2bc-8cd98b406c60"] [:db/add "73b14aa6-7c98-5a49-b139-dd7836712968" :question/answer-fields "869c4012-a572-52fa-8a07-5cf505e88cb9"] [:db/ensure "73b14aa6-7c98-5a49-b139-dd7836712968" :question/validate] [:db/add 17592186119848 :knowledge-point/questions "73b14aa6-7c98-5a49-b139-dd7836712968"] [:db/add "generator" :question-generator/id #uuid "5507c331-3ba6-5473-8f7f-dcefe1bcafa0"] [:db/add "generator" :question-generator/script "generators/a1/a14b108c3d7a1dcdba9047d72bef9e3e6a818e1676dd216c2be4c566b53233c5/17592186119848.py"] [:db/add 17592186119848 :knowledge-point/question-generator "generator"] [:db/ensure 17592186119848 :knowledge-point/validate]]
