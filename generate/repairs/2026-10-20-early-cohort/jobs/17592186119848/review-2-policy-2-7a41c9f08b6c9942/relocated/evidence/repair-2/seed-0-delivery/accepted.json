              ":answer/type": ":answer.type/math",
              ":answer/value": "D=\\begin{bmatrix}2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 6 \\\\ 2 & 0 & 0 \\\\ 0 & 2 & 2\\end{bmatrix}"
            },
            {
              ":answer/id": "60729a58-5391-576e-ba86-22fe8b8b5c64",
              ":answer/type": ":answer.type/math",
              ":answer/value": "B=\\begin{bmatrix}-4 & 0 & 0 & 0 \\\\ 4 & -2 & 0 & 0 \\\\ 2 & 6 & 6 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "c76db9a9-4ee4-5a1f-8643-ce9cf14cc0d0",
              ":answer/type": ":answer.type/math",
              ":answer/value": "E=\\begin{bmatrix}2 & 0 & 0 & 0 \\\\ 4 & 2 & 0 & 0 \\\\ 2 & 6 & 2 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "d26b93c6-b2ff-594e-a19f-2c9c7390ab40",
              ":answer/type": ":answer.type/math",
              ":answer/value": "A=\\begin{bmatrix}2 & 0 & 2 & 0 & 0 \\\\ 0 & -2 & 0 & 2 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "669f71a3-5996-50f6-9dd8-9b3214f34160",
