              ":answer/value": "C=\\begin{bmatrix}-4 & 0 & 0 & 0 & 0 \\\\ 4 & -2 & 0 & 0 & 0 \\\\ 2 & 6 & 6 & 0 & 0 \\\\ 4 & 4 & 2 & 6 & 0\\end{bmatrix}"
            }
