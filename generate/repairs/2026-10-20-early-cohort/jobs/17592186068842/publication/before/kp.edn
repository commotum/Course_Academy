db/ref 17592186274233} {:answer/id #uuid "dae5896a-987c-5514-adf7-468aaa639a3a" :answer/type {:db/ident :answer.type/math} :answer/value "(x+1)\\cdot \\frac{\\text{d}y}{\\text{d}x}=x{y}^{2}" :db/id #edb/ref 17592186274301}] :answer-field/correct {:answer/id #uuid "a06b58e1-28a4-50ed-ac87-373471256b9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{x}{x+1}" :db/id #edb/ref 17592186273777} :answer-field/id #uuid "5e8a4da3-858c-5210-bec3-9666fbd56e66" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274797}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8143064d-a592-5c44-b653-c218df46c5ef" :question/math-academy-id "q-154678" :question/problem "Separate the variables in the following differential equation: \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{x{y}^{2}}{x+1}\n$$" :question/worked-solution "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\frac{1}{g(y)}\\cdot \\frac{\\text{d}y}{\\text{d}x}=h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\left(\\frac{x}{x+1}\\right)\\cdot {y}^{2}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{x}{x+1}\n$$"} {:db/id #edb/ref 17592186069084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e77e3fa-7a98-5a4a-9335-fb5a9f98bf16" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{y}" :db/id #edb/ref 17592186272515} {:answer/id #uuid "906a19fb-54f7-5ead-a262-6733d9f69200" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273642} {:answer/id #uuid "9846b861-4f4c-519d-bc42-8a2277d230d8" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-x}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{-y}" :db/id #edb/ref 17592186273708} {:answer/id #uuid "afdd8e19-abad-54b2-bfa7-482a77bcdc82" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273909} {:answer/id #uuid "df16c227-374f-5cca-a61d-8e29808d4fe6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-x}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{y}" :db/id #edb/ref 17592186274355}] :answer-field/correct {:answer/id #uuid "afdd8e19-abad-54b2-bfa7-482a77bcdc82" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273909} :answer-field/id #uuid "e9e1947f-3803-54c7-8228-b7ab54db07e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275046}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0ed05f1b-222f-5d8f-b307-8248e81b3d7f" :question/math-academy-id "q-157692" :question/problem "Separate the variables in the following differential equation: \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{x+y}\n$$" :question/worked-solution "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\frac{1}{g(y)}\\cdot \\frac{\\text{d}y}{\\text{d}x}=h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{x}\\cdot {e}^{y}\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{e}^{y}}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x},\n$$\n\nor, equivalently,\n\n$