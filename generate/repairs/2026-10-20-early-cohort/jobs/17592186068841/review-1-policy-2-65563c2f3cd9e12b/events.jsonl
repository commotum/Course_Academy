{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1960,2020p' /home/jake/Developer/Course_Academy/engine/rust/learning.rs\ncat /home/jake/Developer/Course_Academy/engine/rust/question_selection.rs | head -220\ncat /home/jake/Developer/Course_Academy/generate/repairs/2026-10-20-early-cohort/jobs/17592186068841/review-0-policy-2-75766812ae9ead5b/reproduce_failures.py\"","aggregated_output":"}\n\nfn displayed_integration_constant(prompt: &str, key: &str) -> bool {\n    if key.is_empty() || requires_answer_form(prompt)\n        || !(prompt.contains(\"antiderivative\") || prompt.contains(\"indefinite integral\") || prompt.contains(\"\\\\int\"))\n        || prompt.contains(\"\\\\int_\") || prompt.contains(\"\\\\int^\")\n        || [\"zero constant term\", \"constant term is zero\", \"constant term is 0\"]\n            .iter().any(|text| prompt.contains(text))\n    {\n        return false;\n    }\n    let marker = format!(\"{{{{{}}}}}\", key.to_lowercase());\n    let Some((_, suffix)) = prompt.split_once(&marker) else { return false; };\n    let suffix = suffix.replace([ '$', '\\n', '\\r' ], \" \")\n        .replace(\"\\\\(\", \" \").replace(\"\\\\)\", \" \")\n        .replace(\"\\\\,\", \" \").replace(\"\\\\!\", \" \").replace(\"\\\\;\", \" \")\n        .replace(\"\\\\quad\", \" \").replace(\"\\\\qquad\", \" \");\n    let Some(after_plus) = suffix.trim_start().strip_prefix('+') else { return false; };\n    let Some(after_c) = after_plus.trim_start().strip_prefix('c') else { return false; };\n    after_c.chars().next().is_none_or(|c| !c.is_alphanumeric() && !\"_^({\".contains(c))\n}\n\n/// A whole additive blank inside (blank + K) has the same constant freedom\n/// even when that group is subsequently inverted, rooted, or exponentiated.\n/// Require both an explicit general-ODE-solution contract and the arbitrary\n/// constant adjacent to this field. Merely mentioning K elsewhere is not enough.\nfn displayed_solution_family_constant(prompt: &str, key: &str) -> bool {\n    if key.is_empty() || requires_answer_form(prompt)\n        || !prompt.contains(\"general solution\") || !prompt.contains(\"differential equation\")\n        || [\"zero constant term\", \"constant term is zero\", \"constant term is 0\", \"nonconstant polynomial term\"]\n            .iter().any(|text| prompt.contains(text))\n    {\n        return false;\n    }\n    let compact = normalize_math(prompt).replace('$', \"\").to_lowercase();\n    let marker = format!(\"{{{{{}}}}}\", key.to_lowercase());\n    let Some((prefix, suffix)) = compact.split_once(&marker) else { return false; };\n    if suffix.contains(&marker) { return false; }\n    // An immediately preceding group opener makes the field a whole additive\n    // term. This excludes x*blank+K and blank^2+K, whose shifts do not commute\n    // with addition of K. Outer transformations of the whole group are safe.\n    let close = match prefix.chars().last() {\n        Some('(') => ')',\n        Some('{') => '}',\n        _ => return false,\n    };\n    let Some((_, outer)) = prefix.rsplit_once('=') else { return false; };\n    ['c', 'k'].iter().any(|constant| {\n        // The same parameter elsewhere in the outer expression would couple\n        // its occurrences, so a shift of this one occurrence is not enough.\n        suffix.starts_with(&format!(\"+{constant}{close}\"))\n            && !outer.contains(*constant) && !suffix[2..].contains(*constant)\n            && compact.contains(&format!(\"{constant}isanarbitraryconstant\"))\n    })\n}\n\n/// Error-preserving comparison shared by grading and content reconciliation.\npub fn compare_math_in_context(\n    a: &str,\n    b: &str,\n    prompt: &str,\n//! Difficulty-first sampling. A task and its completed prefix seed a stable\n//! draw, so rereading or retrying a continuation cannot reshuffle its question.\nuse crate::{Result, schema::EntitySnapshot};\nuse sha2::{Digest, Sha256};\nuse std::collections::BTreeSet;\n\nconst BANDS: [&str; 3] = [\"easy\", \"moderate\", \"hard\"];\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Phase {\n    Initial,\n    Remedial,\n}\n\n/// Lessons and reviews use their existing question-count phase rules.\n/// Assessments must request a phase explicitly: a long quiz is not remedial.\npub fn weights(\n    s: &EntitySnapshot,\n    policy: u64,\n    activity_type: &str,\n    answered: usize,\n) -> Result<Option<[f64; 3]>> {\n    let initial_count = match activity_type {\n        \"lesson\" => 2,\n        \"review\" => 3,\n        _ => return Err(\"question-count phases support lessons and reviews; assessments require an explicit phase\".into()),\n    };\n    weights_for_phase(\n        s,\n        policy,\n        activity_type,\n        if answered < initial_count {\n            Phase::Initial\n        } else {\n            Phase::Remedial\n        },\n    )\n}\n\npub fn weights_for_phase(\n    s: &EntitySnapshot,\n    policy: u64,\n    activity_type: &str,\n    phase: Phase,\n) -> Result<Option<[f64; 3]>> {\n    if !matches!(activity_type, \"lesson\" | \"review\" | \"assessment\") {\n        return Err(\"unsupported question-weight activity type\".into());\n    }\n    let selected_phase = match phase {\n        Phase::Initial => \"initial\",\n        Phase::Remedial => \"remedial\",\n    };\n    let mut types = BTreeSet::new();\n    let mut selected = None;\n    for child in s.refs(policy, \"policy/question-selection-weights\")? {\n        if s.owners(child, \"policy/question-selection-weights\")? != [policy] {\n            return Err(\"question weights must have exactly one policy owner\".into());\n        }\n        let kind = s.ident(&serde_json::json!(\n            s.reference(child, \"question-weights/activity-type\")?\n        ))?;\n        if !matches!(\n            kind.as_str(),\n            \"activity.type/lesson\" | \"activity.type/review\" | \"activity.type/assessment\"\n        ) || !types.insert(kind.clone())\n        {\n            return Err(\n                \"policy needs at most one question-weight record per supported activity type\"\n                    .into(),\n            );\n        }\n        for phase in [\"initial\", \"remedial\"] {\n            let mut distribution = [0.0; 3];\n            for (index, band) in BANDS.iter().enumerate() {\n                let key = format!(\"question-weights/{phase}-{band}\");\n                distribution[index] = s\n                    .entity(child)?\n                    .get(&key)\n                    .and_then(|v| v.as_f64())\n                    .filter(|v| v.is_finite() && *v >= 0.0)\n                    .ok_or_else(|| format!(\"{key} must be finite and nonnegative\"))?;\n            }\n            let total: f64 = distribution.iter().sum();\n            if !total.is_finite() || total <= 0.0 {\n                return Err(\n                    \"each question-weight distribution needs a positive finite total\".into(),\n                );\n            }\n            if kind == format!(\"activity.type/{activity_type}\") && phase == selected_phase {\n                selected = Some(distribution);\n            }\n        }\n    }\n    Ok(selected)\n}\n\npub fn active_policy(s: &EntitySnapshot) -> Result<u64> {\n    let policies = s.entities.with_attribute(\"policy/id\");\n    match policies.as_slice() {\n        [policy] => Ok(*policy),\n        _ => Err(\"question selection requires exactly one configured policy\".into()),\n    }\n}\n\n/// Exclude previous tasks; the caller separately excludes its current prefix.\n/// This also lets completion validate an already-reserved current question.\npub fn seen_before_task(s: &EntitySnapshot, learner: u64, task: u64) -> Result<BTreeSet<u64>> {\n    let mut seen = BTreeSet::new();\n    for other in s.refs(learner, \"learner/activity\")? {\n        if other == task {\n            continue;\n        }\n        for item in s.refs(other, \"learner-task/items\")? {\n            if let Some(content) = s.optional_ref(item, \"task-item/content\")? {\n                seen.insert(content);\n            }\n        }\n    }\n    Ok(seen)\n}\n\n/// Candidates must already be fresh and usable. Unknown ratings are a uniform\n/// fallback only when no eligible, positively weighted rated band remains.\n/// Explicitly zero-weight rated bands are never used as that fallback.\npub fn select(\n    s: &EntitySnapshot,\n    candidates: &[u64],\n    distribution: Option<[f64; 3]>,\n    seed: &str,\n) -> Result<Option<u64>> {\n    let candidates: Vec<_> = candidates\n        .iter()\n        .copied()\n        .collect::<BTreeSet<_>>()\n        .into_iter()\n        .collect();\n    // Preserve old, unconfigured policies; the default policy supplies weights.\n    let Some(distribution) = distribution else {\n        return Ok(candidates.first().copied());\n    };\n    if distribution.iter().any(|w| !w.is_finite() || *w < 0.0)\n        || !distribution.iter().sum::<f64>().is_finite()\n        || distribution.iter().sum::<f64>() <= 0.0\n    {\n        return Err(\"invalid question-weight distribution\".into());\n    }\n    let mut bands: [Vec<u64>; 3] = std::array::from_fn(|_| vec![]);\n    let mut unrated = vec![];\n    for q in candidates {\n        let Some(value) = s\n            .entity(q)?\n            .get(\"question/difficulty\")\n            .filter(|v| !v.is_null())\n        else {\n            unrated.push(q);\n            continue;\n        };\n        let difficulty = s.ident(value)?;\n        let band = BANDS\n            .iter()\n            .position(|b| difficulty == format!(\"question.difficulty/{b}\"))\n            .ok_or(\"question has an unsupported difficulty enum\")?;\n        bands[band].push(q);\n    }\n    let digest = Sha256::digest(format!(\"course-academy/question-selection/v1/{seed}\"));\n    let uniform = |offset| {\n        let bits = u64::from_be_bytes(digest[offset..offset + 8].try_into().unwrap()) >> 11;\n        bits as f64 / (1u64 << 53) as f64\n    };\n    let total: f64 = distribution\n        .iter()\n        .enumerate()\n        .filter(|(i, _)| !bands[*i].is_empty())\n        .map(|(_, w)| *w)\n        .sum();\n    let pool = if total > 0.0 {\n        let mut draw = uniform(0) * total;\n        let mut chosen = None;\n        for (i, w) in distribution.iter().enumerate() {\n            if bands[i].is_empty() || *w == 0.0 {\n                continue;\n            }\n            chosen = Some(i);\n            if draw < *w {\n                break;\n            }\n            draw -= *w;\n        }\n        &bands[chosen.unwrap()]\n    } else {\n        &unrated\n    };\n    Ok(if pool.is_empty() {\n        None\n    } else {\n        Some(pool[(uniform(8) * pool.len() as f64) as usize])\n    })\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use serde_json::json;\n    use std::collections::BTreeMap;\n\n    fn snapshot() -> EntitySnapshot {\n        let mut e = BTreeMap::new();\n        for (id, band) in BANDS.iter().enumerate() {\n            e.insert(\n                id as u64 + 1,\n                json!({\"db/ident\":{\"$keyword\":format!(\"question.difficulty/{band}\")}})\n                    .as_object()\n                    .unwrap()\n                    .clone(),\n            );\n        }\n        for q in 10..110 {\n            e.insert(\n                q,\n                json!({\"question/difficulty\":if q == 10 {1} else if q == 11 {2} else {3}})\n\"\"\"Run only the concrete review counterexamples. No package or DB writes.\nUse: PYTHONDONTWRITEBYTECODE=1 /home/jake/Developer/Course_Academy/.venv/bin/python reproduce_failures.py\nThe reported defects make strict assertions fail; exit 1 is expected until repaired.\n\"\"\"\nimport sys,json,re,subprocess\nfrom pathlib import Path\nsys.dont_write_bytecode=True\nfrom review import module,save,ROOT,REPO\nfrom coverage import leak\nm=module();out=[];samples=[]\ntry:\n r=m.generate_moderate(730033,template='q-128198',parameters={'a':1},profile='observed');samples.append(r);out.append({'finding':'missing source family','passed':True})\nexcept Exception as e:out.append({'finding':'missing source family','passed':False,'source_id':'8363d7a8-d552-504e-a21c-ebf886d548c2','error':repr(e)})\nfor name in ['q-79665','q-8304']:\n r=m.generate_moderate(730061,template=name,parameters={'a':1});samples.append(r);v=leak(r);out.append({'finding':'interval copies integrated answer','passed':not v['correct'],'case':v})\nr=m.generate_moderate(730033,template='q-128191',parameters={'a':1},profile='observed');samples.append(r)\ncases=[{'label':'source blank arbitrary-constant equivalence','record':r,'checks':[{'submitted':'x^2+5','expected':'accepted','purpose':'K+5 is an arbitrary constant whenever K is arbitrary'}]}];save('minimal-grader-input.json',cases)\ncmd=[str(REPO/'generate/runs/current/check-engine'),str(ROOT/'minimal-grader-input.json'),str(ROOT/'minimal-grader-report.json')];p=subprocess.run(cmd,capture_output=True,text=True);out.append({'finding':'missing family-equivalence grading','passed':p.returncode==0,'command':cmd,'returncode':p.returncode,'stdout':p.stdout,'stderr':p.stderr})\n# Raw default blank family reproduces the known actual-UI code-block problem.\nr=m.generate_moderate(730033,template='q-128191',parameters={'a':1});samples.append(r)\nrender=[r];save('minimal-render-input.json',render)\n# Use the shared real renderer, not TeX approximation. All writes stay below evidence.\ncmd=[str(REPO/'.venv/bin/python'),str(REPO/'generate/pipeline/render_preview.py'),'--input',str(ROOT/'minimal-render-input.json'),'--output',str(ROOT/'minimal-render'),'--asset-root',str(ROOT)]\np=subprocess.run(cmd,capture_output=True,text=True);html=(ROOT/'minimal-render/question-001.html').read_text() if (ROOT/'minimal-render/question-001.html').exists() else '';blocks=re.findall(r'<pre.*?</pre>',html,re.S)\nout.append({'finding':'blank scaffold is literal code','passed':p.returncode==0 and not any('$y=' in b or '$+K)' in b for b in blocks),'command':cmd,'returncode':p.returncode,'stdout':p.stdout,'stderr':p.stderr,'literal_code_blocks':blocks})\nsave('minimal-failure-records.json',samples);save('minimal-failures.json',out)\nprint(json.dumps([{'finding':x['finding'],'passed':x['passed']} for x in out]));sys.exit(0 if all(x['passed'] for x in out) else 1)\n","exit_code":0,"status":"completed"}}
