1 jake jake  19559 Oct 21 09:51 prompt.txt\ndrwxrwxr-x  3 jake jake   4096 Oct 21 09:50 relocated-package\n-rw-rw-r--  1 jake jake   8248 Oct 21 09:58 relocation-samples.json\ndrwxrwxr-x  2 jake jake   4096 Oct 21 09:55 render\ndrwxrwxr-x  2 jake jake   4096 Oct 21 09:57 render-all\n-rw-rw-r--  1 jake jake    196 Oct 21 09:57 render-all-command.log\n-rw-rw-r--  1 jake jake    191 Oct 21 09:55 render-command.log\n-rw-rw-r--  1 jake jake  56728 Oct 21 09:54 render-input.json\n-rw-rw-r--  1 jake jake   1847 Oct 21 10:00 rendering-inspection.json\n-rw-rw-r--  1 jake jake  11209 Oct 21 10:04 report.json\n-rw-rw-r--  1 jake jake   2851 Oct 21 10:00 reproduce_failures.py\n-rw-rw-r--  1 jake jake   7335 Oct 21 10:05 result.json\n-rw-rw-r--  1 jake jake    188 Oct 21 10:04 review-integrity.json\n-rw-rw-r--  1 jake jake   4993 Oct 21 09:53 review.py\n-rw-rw-r--  1 jake jake    930 Oct 21 09:55 run_delivery.py\n-rw-rw-r--  1 jake jake   1775 Oct 21 09:54 runtime.json\n-rw-rw-r--  1 jake jake      3 Oct 21 09:54 sampling-errors.json\n-rw-rw-r--  1 jake jake    785 Oct 21 10:04 session-state.md\n-rw-rw-r--  1 jake jake  54913 Oct 21 09:51 source-analysis.json\n-rw-rw-r--  1 jake jake   6168 Oct 21 09:58 source-bank-comparison.json\n-rw-rw-r--  1 jake jake   2602 Oct 21 09:54 source-replay-results.json\n-rw-rw-r--  1 jake jake  60675 Oct 21 09:54 source-replay.json\n-rw-rw-r--  1 jake jake   2240 Oct 21 10:04 validate_contract.py\n-rw-rw-r--  1 jake jake  19911 Oct 21 10:04 write_report.py\nsource/source.json\n{\n  \"database\": \"math\",\n  \"lineage\": \"01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1\",\n  \"basis\": 5369,\n  \"kp_id\": 17592186068841,\n  \"material\": {\n    \"kp\": {\n      \":db/id\": 17592186068841,\n      \":knowledge-point/canonical-example\": {\n        \":db/id\": 17592186068448,\n        \":question/id\": \"23d66cc8-8e5a-5a33-a7a1-c43f5facdcbc\",\n        \":question/math-academy-id\": \"e-10833\",\n        \":question/problem\": \"Find the general solution to the differential equation $y' + 2xy = 0$ for $y\\\\neq 0.$\",\n        \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032}+2xy & =0 \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x}+2xy & =0 \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =-2xy \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =-2x\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x{:}$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (-2x)\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =-2\\\\int x\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =-{x}^{2}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\ln \\\\vert y \\\\vert = -x^2 + C.\\n$$\\n\\nWe're required to write the solution in the form $y = y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & =-{x}^{2}+C \\\\\\\\ |y| & ={e}^{-{x}^{2}+C} \\\\\\\\ |y| & ={e}^{-{x}^{2}}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{-{x}^{2}}\\\\end{aligned}\\n$$\\n\\nwhere $K = e^C$  and $K > 0.$ \\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny = Ke^{-x^2}.\\n$$\"\n      },\n      \":knowledge-point/id\": \"74b784e1-ad0e-5cf2-8b02-604a7098c6a9\",\n      \":knowledge-point/questions\": [\n        {\n          \":db/id\": 17592186069532,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"121b603b-942f-556e-b445-2d681ee1ce18\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={\\\\left(\\\\frac{{x}^{2}+x+C}{2}\\\\right)}^{2}\",\n                  \":db/id\": 17592186348602\n                },\n                {\n                  \":answer/id\": \"500546dd-32e0-5461-ae4c-5e5a7455b919\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={x}^{2}+x+C\",\n                  \":db/id\": 17592186349173\n                },\n                {\n                  \":answer/id\": \"6e22fd1e-737c-5a35-9366-28fb7f8a36bc\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=({x}^{2}+x)^{2}\",\n                  \":db/id\": 17592186349458\n                },\n                {\n                  \":answer/id\": \"da4666f1-e8ca-5840-a41a-ead889cfbef8\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=({x}^{2}+x+C)^{2}\",\n                  \":db/id\": 17592186350361\n                },\n                {\n                  \":answer/id\": \"f06bf25f-3d03-5f76-a7ea-8ddc6224884a\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={\\\\left(\\\\frac{{x}^{2}+x}{2}\\\\right)}^{2}\",\n                  \":db/id\": 17592186350551\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"121b603b-942f-556e-b445-2d681ee1ce18\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y={\\\\left(\\\\frac{{x}^{2}+x+C}{2}\\\\right)}^{2}\",\n                \":db/id\": 17592186348602\n              },\n              \":answer-field/id\": \"8e1d264b-d2af-5bb5-bbc0-5706b21c43ca\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186350948\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/moderate\"\n          },\n          \":question/id\": \"679701a5-b0c3-5865-adfd-e49e046da668\",\n          \":question/math-academy-id\": \"q-8303\",\n          \":question/problem\": \"Find the general solution to the differential equation ${y}^{\\u2032}-\\\\sqrt{y}=2x\\\\sqrt{y}$ for $y\\\\ne 0.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032}-\\\\sqrt{y} & =2x\\\\sqrt{y} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x}-\\\\sqrt{y} & =2x\\\\sqrt{y} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =2x\\\\sqrt{y}+\\\\sqrt{y} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =(2x+1)\\\\sqrt{y} \\\\\\\\ \\\\frac{1}{\\\\sqrt{y}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =(2x+1)\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{\\\\sqrt{y}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (2x+1)\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{\\\\sqrt{y}}\\\\,\\\\text{d}y & =\\\\int (2x+1)\\\\,\\\\text{d}x \\\\\\\\ 2\\\\sqrt{y} & ={x}^{2}+x+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n2\\\\sqrt{y}={x}^{2}+x+C\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}y & ={\\\\left(\\\\frac{{x}^{2}+x+C}{2}\\\\right)}^{2}.\\\\end{aligned}\\n$$\"\n        },\n        {\n          \":db/id\": 17592186069533,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"610604c1-be04-5ae1-8759-b50654e72419\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{-\\\\operatorname{cos}\\u2061x}\",\n                  \":db/id\": 17592186349333\n                },\n                {\n                  \":answer/id\": \"6b4f4cea-17dd-5832-b0a8-70627738c306\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={e}^{-\\\\operatorname{cos}\\u2061x}+K\",\n                  \":db/id\": 17592186349434\n                },\n                {\n                  \":answer/id\": \"6c66c47e-a365-5d7e-8cc6-1deb04431c20\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={e}^{\\\\operatorname{sin}\\u2061x}+K\",\n                  \":db/id\": 17592186349447\n                },\n                {\n                  \":answer/id\": \"759561ba-3f4a-5157-8283-98918b52bdbb\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\operatorname{cos}\\u2061x}\",\n                  \":db/id\": 17592186349529\n                },\n                {\n                  \":answer/id\": \"dc2e52a7-5613-5624-ab39-0ecff616a3c4\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\operatorname{sin}\\u2061x}\",\n                  \":db/id\": 17592186350372\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"dc2e52a7-5613-5624-ab39-0ecff616a3c4\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=K{e}^{\\\\operatorname{sin}\\u2061x}\",\n                \":db/id\": 17592186350372\n              },\n              \":answer-field/id\": \"26a2711c-7312-535e-b8ec-1d2da18482c4\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186350780\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/hard\"\n          },\n          \":question/id\": \"b946e806-cd3a-503b-8b7c-fe17b0906080\",\n          \":question/math-academy-id\": \"q-8305\",\n          \":question/problem\": \"Find the general solution to the differential equation $\\\\frac{\\\\text{d}y}{\\\\text{d}x}-(\\\\operatorname{cos}\\u2061x)y=0$ for $y\\\\ne 0.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}y}{\\\\text{d}x}-(\\\\operatorname{cos}\\u2061x)y & =0 \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =(\\\\operatorname{cos}\\u2061x)y \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\operatorname{cos}\\u2061x\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{cos}\\u2061x\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int \\\\operatorname{cos}\\u2061x\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{sin}\\u2061x+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|=\\\\operatorname{sin}\\u2061x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{sin}\\u2061x+C \\\\\\\\ |y| & ={e}^{\\\\operatorname{sin}\\u2061x+C} \\\\\\\\ |y| & ={e}^{\\\\operatorname{sin}\\u2061x}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{\\\\operatorname{sin}\\u2061x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny=K{e}^{\\\\operatorname{sin}\\u2061x}.\\n$$\"\n        },\n        {\n          \":db/id\": 17592186235351,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"f680649b-aad0-5c21-b454-2962d171cc58\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"{x}^{2}\",\n                  \":db/id\": 17592186234935\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"f680649b-aad0-5c21-b454-2962d171cc58\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"{x}^{2}\",\n                \":db/id\": 17592186234935\n              },\n              \":answer-field/id\": \"94bd198b-189e-5b43-a53b-df64554d3cd5\",\n              \":answer-field/key\": \"field-1\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/blank\"\n              },\n              \":db/id\": 17592186235152\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/moderate\"\n          },\n          \":question/id\": \"778dd5ee-c1ff-5286-be7b-93fe7ada6aaf\",\n          \":question/math-academy-id\": \"q-128191\",\n          \":question/problem\": \"Find the general solution to the differential equation ${y}^{\\u2032}=x{y}^{2}.$ Assume that $y\\\\ne 0$ and $K$ is an arbitrary constant.\\n\\n                            \\n                                    \\n                                        \\n                                            \\n\\n                                                \\n\\n                                        \\n                                        \\n                                        \\n\\n                                    \\n                                \\n                                    \\n                                        \\n                                        $y=-2($ \\n\\n                                    \\n                                \\n                                    \\n                            \\n                                        {{field-1}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        $+K)^{-1}$\",\n          \":question/worked-solution\": \"First, we separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =x{y}^{2} \\\\\\\\ \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =x\\\\end{aligned}\\n$$\\n\\nNext, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int x\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{{y}^{2}}\\\\,\\\\text{d}y & =\\\\int x\\\\,\\\\text{d}x \\\\\\\\ -\\\\frac{1}{y} & =\\\\frac{{x}^{2}}{2}+C\\\\end{aligned}\\n$$\\n\\nFinally, we solve for $y.$ This gives\\n\\n$$\\n\\\\begin{aligned}-\\\\frac{1}{y} & =\\\\frac{{x}^{2}}{2}+C \\\\\\\\ -\\\\frac{1}{y} & =\\\\frac{{x}^{2}+2C}{2} \\\\\\\\ \\\\frac{1}{y} & =-\\\\frac{{x}^{2}+2C}{2} \\\\\\\\ y & =-\\\\frac{2}{{x}^{2}+2C} \\\\\\\\ y & =-\\\\frac{2}{{x}^{2}+K} \\\\\\\\ y & =-2{({x}^{2}+K)}^{-1},\\\\end{aligned}\\n$$\\n\\nwhere $K=2C$ is an arbitrary constant.\"\n        },\n        {\n          \":db/id\": 17592186272346,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"4bbb69e0-08ac-541f-a0c9-781e5adaf93d\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\sqrt{{x}^{2}+2}}\",\n                  \":db/id\": 17592186269951\n                },\n                {\n                  \":answer/id\": \"a64073d1-36b3-54ce-9da0-185ff798ba5a\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{{x}^{2}+2x}\",\n                  \":db/id\": 17592186270756\n                },\n                {\n                  \":answer/id\": \"caeda8f1-2556-5b04-bcc7-d9ae17db2b41\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\sqrt{{x}^{3}+x}}\",\n                  \":db/id\": 17592186271051\n                },\n                {\n                  \":answer/id\": \"d6d54641-37a1-5f1b-b411-9374e6a99c0c\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{{x}^{3}+x}\",\n                  \":db/id\": 17592186271154\n                },\n                {\n                  \":answer/id\": \"f24d04bd-5257-5f28-8f9a-f8dfa0f53d86\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{3{x}^{2}+x}\",\n                  \":db/id\": 17592186271398\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"d6d54641-37a1-5f1b-b411-9374e6a99c0c\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=K{e}^{{x}^{3}+x}\",\n                \":db/id\": 17592186271154\n              },\n              \":answer-field/id\": \"f58bc506-2ce6-5f14-8138-f2c78e5c6cec\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186271934\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/hard\"\n          },\n          \":question/id\": \"8f251269-fa35-5ece-9af4-5538cedc8207\",\n          \":question/math-academy-id\": \"q-14247\",\n          \":question/problem\": \"Find the general solution to the differential equation ${y}^{\\u2032}=y+3y{x}^{2}$ for $y\\\\ne 0.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032} & =y+3y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y+3y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y(1+3{x}^{2}) \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =1+3{x}^{2}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (1+3{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int (1+3{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =x+{x}^{3}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|={x}^{3}+x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & ={x}^{3}+x+C \\\\\\\\ |y| & ={e}^{{x}^{3}+x+C} \\\\\\\\ |y| & ={e}^{{x}^{3}+x}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{{x}^{3}+x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny=K{e}^{{x}^{3}+x}.\\n$$\"\n        },\n        {\n          \":db/id\": 17592186272353,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"67122d50-92e9-5dbf-990c-0216ba86e1b0\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=-\\\\frac{1}{2x+C}\",\n                  \":db/id\": 17592186270187\n                },\n                {\n                  \":answer/id\": \"74a6e407-2886-5e8a-b215-c668e4499333\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=-\\\\frac{1}{{x}^{2}+x}+C\",\n                  \":db/id\": 17592186270298\n                },\n                {\n                  \":answer/id\": \"8f18500b-635a-52f2-ad08-9cfecc92fe33\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\frac{1}{2{x}^{2}+x}+C\",\n                  \":db/id\": 17592186270513\n                },\n                {\n                  \":answer/id\": \"afaac117-d7de-54cf-b4d2-12a4f27ad185\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\frac{1}{{x}^{3}+C}\",\n                  \":db/id\": 17592186270833\n                },\n                {\n                  \":answer/id\": \"fe67ce39-75d8-5a64-817a-e44f388af12a\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=-\\\\frac{1}{{x}^{2}+x+C}\",\n                  \":db/id\": 17592186271497\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"fe67ce39-75d8-5a64-817a-e44f388af12a\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=-\\\\frac{1}{{x}^{2}+x+C}\",\n                \":db/id\": 17592186271497\n              },\n              \":answer-field/id\": \"df104af1-2216-5c05-8160-ea3f0cd58c3f\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186271901\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/moderate\"\n          },\n          \":question/id\": \"de6a882e-022d-59c5-adf8-2e2394047b45\",\n          \":question/math-academy-id\": \"q-14253\",\n          \":question/problem\": \"Find the general solution to the differential equation $\\\\frac{\\\\text{d}y}{\\\\text{d}x}={y}^{2}+2{y}^{2}x$ for $y\\\\ne 0.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}y}{\\\\text{d}x} & ={y}^{2}+2{y}^{2}x \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & ={y}^{2}(1+2x) \\\\\\\\ \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =1+2x\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (1+2x)\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{{y}^{2}}\\\\,\\\\text{d}y & =\\\\int (1+2x)\\\\,\\\\text{d}x \\\\\\\\ -\\\\frac{1}{y} & =x+{x}^{2}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n-\\\\frac{1}{y}={x}^{2}+x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\ny=-\\\\frac{1}{{x}^{2}+x+C}.\\n$$\"\n        },\n        {\n          \":db/id\": 17592186275405,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"053ca9da-737f-5368-b54e-24f96cafcde5\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{-3/x}\",\n                  \":db/id\": 17592186272436\n                },\n                {\n                  \":answer/id\": \"0bac610d-2d04-5604-ae64-cf06296f12ec\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{-x}-3\",\n                  \":db/id\": 17592186272493\n                },\n                {\n                  \":answer/id\": \"41cc209a-81ce-50b5-9b00-4dc750c10cf0\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{1/x}+3\",\n                  \":db/id\": 17592186272947\n                },\n                {\n                  \":answer/id\": \"c69d7489-94d3-50a5-a31f-01511961f376\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{x}+3\",\n                  \":db/id\": 17592186274110\n                },\n                {\n                  \":answer/id\": \"fe66c8fc-fdf6-5a64-96a6-a35189bbdf14\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{-1/x}-3\",\n                  \":db/id\": 17592186274625\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"fe66c8fc-fdf6-5a64-96a6-a35189bbdf14\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=K{e}^{-1/x}-3\",\n                \":db/id\": 17592186274625\n              },\n              \":answer-field/id\": \"15153a99-fd23-5390-abfe-dedc4885900e\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186274673\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/hard\"\n          },\n          \":question/id\": \"e0c7db14-c9c5-588a-b927-09334c1e0842\",\n          \":question/math-academy-id\": \"q-158009\",\n          \":question/problem\": \"Find the general solution to the differential equation ${x}^{2}\\\\,{y}^{\\u2032}-y=3$ for $y\\\\ne -3.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{x}^{2}\\\\,{y}^{\\u2032}-y & =3 \\\\\\\\ {x}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x}-y & =3 \\\\\\\\ {x}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y+3 \\\\\\\\ \\\\frac{1}{y+3}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\frac{1}{{x}^{2}}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y+3}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y+3}\\\\,\\\\text{d}y & =\\\\int \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y+3| & =-\\\\frac{1}{x}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y+3|=-\\\\frac{1}{x}+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y+3| & =-\\\\frac{1}{x}+C \\\\\\\\ |y+3| & ={e}^{-1/x+C} \\\\\\\\ |y+3| & ={e}^{-1/x}\\\\cdot {e}^{C} \\\\\\\\ |y+3| & =K{e}^{-1/x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\n\\\\begin{aligned}|y+3| & =K{e}^{-1/x} \\\\\\\\ y+3 & =K{e}^{-1/x} \\\\\\\\ y & =K{e}^{-1/x}-3.\\\\end{aligned}\\n$$\"\n        },\n        {\n          \":db/id\": 17592186275406,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"3e906697-63fe-5f9c-9695-47b9d1159642\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{1/\\\\sqrt{1-{x}^{2}}}\",\n                  \":db/id\": 17592186272921\n                },\n                {\n                  \":answer/id\": \"491e2dd7-2197-5bca-8669-100af83cb2d4\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\operatorname{arcsin}\\u2061x}\",\n                  \":db/id\": 17592186273009\n                },\n                {\n                  \":answer/id\": \"4a2b0b18-1859-5892-ace0-8191af79d18f\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\operatorname{arctan}\\u2061x}\",\n                  \":db/id\": 17592186273016\n                },\n                {\n                  \":answer/id\": \"92ec8453-5e27-5368-9ac0-a98e23834e02\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\operatorname{sin}\\u2061x}\",\n                  \":db/id\": 17592186273663\n                },\n                {\n                  \":answer/id\": \"b8730d08-4ef6-5d55-ade2-a86a1a24e46f\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{\\\\sqrt{1-{x}^{2}}}\",\n                  \":db/id\": 17592186273986\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"491e2dd7-2197-5bca-8669-100af83cb2d4\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=K{e}^{\\\\operatorname{arcsin}\\u2061x}\",\n                \":db/id\": 17592186273009\n              },\n              \":answer-field/id\": \"115fa6bc-8cbf-507c-a94a-1255297d1654\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186274666\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/hard\"\n          },\n          \":question/id\": \"6f88ec76-892c-5986-98b6-3866ba9a8457\",\n          \":question/math-academy-id\": \"q-158010\",\n          \":question/problem\": \"Find the general solution to the differential equation $\\\\sqrt{1-{x}^{2}}\\\\,{y}^{\\u2032}-y=0$ for $y\\\\ne 0$ and $|x|<1.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\sqrt{1-{x}^{2}}\\\\,{y}^{\\u2032}-y & =0 \\\\\\\\ \\\\sqrt{1-{x}^{2}}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x}-y & =0 \\\\\\\\ \\\\sqrt{1-{x}^{2}}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\frac{1}{\\\\sqrt{1-{x}^{2}}}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{\\\\sqrt{1-{x}^{2}}}\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int \\\\frac{1}{\\\\sqrt{1-{x}^{2}}}\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{arcsin}\\u2061x+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|=\\\\operatorname{arcsin}\\u2061x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{arcsin}\\u2061x+C \\\\\\\\ |y| & ={e}^{\\\\operatorname{arcsin}\\u2061x+C} \\\\\\\\ |y| & ={e}^{\\\\operatorname{arcsin}\\u2061x}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{\\\\operatorname{arcsin}\\u2061x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\n\\\\begin{aligned}y & =K{e}^{\\\\operatorname{arcsin}\\u2061x}.\\\\end{aligned}\\n$$\"\n        },\n        {\n          \":db/id\": 17592186326690,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"36403495-4819-509a-932f-4c97f8aa7b1f\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={e}^{{x}^{2}}+{e}^{{x}^{3}}+K\",\n                  \":db/id\": 17592186324413\n                },\n                {\n                  \":answer/id\": \"4fd5ef59-50c9-5c92-95c9-4ed4edd2d608\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=K{e}^{{x}^{2}+{x}^{3}/3}\",\n                  \":db/id\": 17592186324625\n                },\n                {\n                  \":answer/id\": \"5fa29fba-6a67-5365-afb0-3f19aca8c7ce\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y={x}^{2}+\\\\frac{{x}^{3}}{3}+K\",\n                  \":db/id\": 17592186324770\n                },\n                {\n                  \":answer/id\": \"c652480f-f0c2-5459-9c4e-e7870338385a\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\operatorname{ln}\\u2061{x}^{2}+\\\\operatorname{ln}\\u2061\\\\frac{{x}^{3}}{3}+K\",\n                  \":db/id\": 17592186325684\n                },\n                {\n                  \":answer/id\": \"d4dff042-5ffc-5451-8cbe-3ca7735819e1\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\operatorname{ln}\\u2061{x}^{2}+\\\\operatorname{ln}\\u2061{x}^{3}+K\",\n                  \":db/id\": 17592186325823\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"4fd5ef59-50c9-5c92-95c9-4ed4edd2d608\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=K{e}^{{x}^{2}+{x}^{3}/3}\",\n                \":db/id\": 17592186324625\n              },\n              \":answer-field/id\": \"7d052acb-260c-5495-945e-851283aac703\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":db/ident\": \":answer-field.type/radio\"\n              },\n              \":db/id\": 17592186326446\n            }\n          ],\n          \":question/difficulty\": {\n            \":db/ident\": \":question.difficulty/hard\"\n          },\n          \":question/id\": \"f1ee3e58-1671-5aa8-8cb2-98c85793fdad\",\n          \":question/math-academy-id\": \"q-3854\",\n          \":question/problem\": \"Find the general solution to the differential equation ${y}^{\\u2032}=2yx+y{x}^{2}$ for $y\\\\ne 0.$\",\n          \":question/worked-solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032} & =2yx+y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =2yx+y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y(2x+{x}^{2}) \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =2x+{x}^{2}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (2x+{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int (2x+{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & ={x}^{2}+\\\\frac{{x}^{3}}{3}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|={x}^{2}+\\\\frac{{x}^{3}}{3}+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & ={x}^{2}+\\\\frac{{x}^{3}}{3}+C \\\\\\\\ |y| & ={e}^{{x}^{2}+{x}^{3}/3+C} \\\\\\\\ |y| & ={e}^{{x}^{2}+{x}^{3}/3}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{{x}^{2}+{x}^{3}/3}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny=K{e}^{{x}^{2}+{x}^{3}/3}.\\n$$\"\n        },\n        {\n          \":db/id\": 17592186348250,\n          \":question/answer-fields\": [\n            {\n              \":answer-field/choices\": [\n                {\n                  \":answer/id\": \"0e364992-7edc-53f1-910c-f390251a729e\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\sqrt[3]{\\\\frac{K}{x}+1}\",\n                  \":db/id\": 17592186345466\n                },\n                {\n                  \":answer/id\": \"22166d6d-c75b-5d4d-95dd-c959a62939dc\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\sqrt[3]{K-\\\\frac{1}{x}}\",\n                  \":db/id\": 17592186345656\n                },\n                {\n                  \":answer/id\": \"a530df5f-1758-5257-88f9-0923a1b1b0c8\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\sqrt{K+\\\\frac{1}{x}}\",\n                  \":db/id\": 17592186346791\n                },\n                {\n                  \":answer/id\": \"c7fec27b-d196-52e9-95f2-c4377198d22c\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\sqrt{K-\\\\frac{2}{x}}\",\n                  \":db/id\": 17592186347091\n                },\n                {\n                  \":answer/id\": \"d8069f30-9bf0-5b4e-9f9e-9c10ba0b9d32\",\n                  \":answer/type\": {\n                    \":db/ident\": \":answer.type/math\"\n                  },\n                  \":answer/value\": \"y=\\\\sqrt[3]{K-\\\\frac{3}{x}}\",\n                  \":db/id\": 17592186347253\n                }\n              ],\n              \":answer-field/correct\": {\n                \":answer/id\": \"d8069f30-9bf0-5b4e-9f9e-9c10ba0b9d32\",\n                \":answer/type\": {\n                  \":db/ident\": \":answer.type/math\"\n                },\n                \":answer/value\": \"y=\\\\sqrt[3]{K-\\\\frac{3}{x}}\",\n                \":db/id\": 17592186347253\n              },\n              \":answer-field/id\": \"316512c9-9dd3-57da-a367-ec001996e486\",\n              \":answer-field/key\": \"selection\",\n              \":answer-field/type\": {\n                \":\nreview-0-policy-2-75766812ae9ead5b/source-analysis.json\n{\n  \"skill\": \"Finding explicit general solutions of first-order separable ODEs by algebraic rearrangement, separation, integration and solving for y.\",\n  \"learner_operation\": \"Infer h(x) and g(y), separate dy/g(y)=h(x)dx, integrate with an arbitrary constant, then invert to obtain the requested explicit solution or missing expression and distinguish plausible incorrect integrals/forms.\",\n  \"reasoning_steps\": [\n    \"Rearrange/factor the ODE and honor its nonzero and interval restrictions.\",\n    \"Separate x and y and integrate each side.\",\n    \"Solve for y, absorb nonzero scales into arbitrary constants, select branches from the domain.\",\n    \"Select one of five complete expressions, or enter the missing expression in the given explicit solution scaffold.\"\n  ],\n  \"invariants\": [\n    \"First-order separable equations with elementary antiderivatives; no initial-value fitting, integrating factors or nonseparable equations.\",\n    \"Preserve source radio versus blank response contract and complete distractor families at replay.\",\n    \"Preserve nonzero/domain/branch assumptions. Nonzero exponential solutions require nonzero K.\",\n    \"Requested easy difficulty has no captured easy exercise: canonical polynomial example is the nearest conservative difficulty anchor; do not relabel inverse-trigonometric/involved power forms easy.\"\n  ],\n  \"permitted_variations\": [\n    \"Change signed small coefficients, linear/quadratic monomial powers and additive terms while retaining the same integration method and workload.\",\n    \"Change the coefficient sign so the antiderivative/exponent/denominator must change, rather than preserving a sign pattern as an incidental answer cue.\",\n    \"For supported trigonometric families vary supported sine/cosine roles and signs with dependent antiderivatives; for shifted y family vary the shift coherently.\",\n    \"Vary which bank member is correct and its position; do not fix a uniquely recognizable expression shape unless it follows from the intended mathematics.\",\n    \"Vary the missing polynomial term/coefficient in source blank scaffolds; x^2 is an example assignment, not an invariant.\",\n    \"The positive branch in q-79666 follows y>0; changing a valid branch assumption must change the explicit answer.\"\n  ],\n  \"source_refs\": [\n    \"canonical e-10833 / 23d66cc8-8e5a-5a33-a7a1-c43f5facdcbc: y\\u2032+2xy=0, ln|y|=-x^2+C, y=Ke^{-x^2}\",\n    \"tutorial 6767 / 56fc1c96-3599-5022-8d83-60d4188ccf07: dy/dx=h(x)g(y); separated (1/g(y))dy/dx=h(x); require g(y) != 0\",\n    \"tutorial 6766 / dfb65111-b319-54c6-84cc-f60506595a69: separate e^{x-y}, integrate e^y=e^x+C, explicit y=ln(e^x+C)\"\n  ],\n  \"source_cases\": [\n    {\n      \"id\": \"679701a5-b0c3-5865-adfd-e49e046da668\",\n      \"ma_id\": \"q-8303\",\n      \"difficulty\": \":question.difficulty/moderate\",\n      \"prompt\": \"Find the general solution to the differential equation ${y}^{\\u2032}-\\\\sqrt{y}=2x\\\\sqrt{y}$ for $y\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"121b603b-942f-556e-b445-2d681ee1ce18\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={\\\\left(\\\\frac{{x}^{2}+x+C}{2}\\\\right)}^{2}\",\n              \":db/id\": 17592186348602\n            },\n            {\n              \":answer/id\": \"500546dd-32e0-5461-ae4c-5e5a7455b919\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={x}^{2}+x+C\",\n              \":db/id\": 17592186349173\n            },\n            {\n              \":answer/id\": \"6e22fd1e-737c-5a35-9366-28fb7f8a36bc\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=({x}^{2}+x)^{2}\",\n              \":db/id\": 17592186349458\n            },\n            {\n              \":answer/id\": \"da4666f1-e8ca-5840-a41a-ead889cfbef8\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=({x}^{2}+x+C)^{2}\",\n              \":db/id\": 17592186350361\n            },\n            {\n              \":answer/id\": \"f06bf25f-3d03-5f76-a7ea-8ddc6224884a\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={\\\\left(\\\\frac{{x}^{2}+x}{2}\\\\right)}^{2}\",\n              \":db/id\": 17592186350551\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"121b603b-942f-556e-b445-2d681ee1ce18\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y={\\\\left(\\\\frac{{x}^{2}+x+C}{2}\\\\right)}^{2}\",\n            \":db/id\": 17592186348602\n          },\n          \":answer-field/id\": \"8e1d264b-d2af-5bb5-bbc0-5706b21c43ca\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186350948\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032}-\\\\sqrt{y} & =2x\\\\sqrt{y} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x}-\\\\sqrt{y} & =2x\\\\sqrt{y} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =2x\\\\sqrt{y}+\\\\sqrt{y} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =(2x+1)\\\\sqrt{y} \\\\\\\\ \\\\frac{1}{\\\\sqrt{y}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =(2x+1)\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{\\\\sqrt{y}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (2x+1)\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{\\\\sqrt{y}}\\\\,\\\\text{d}y & =\\\\int (2x+1)\\\\,\\\\text{d}x \\\\\\\\ 2\\\\sqrt{y} & ={x}^{2}+x+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n2\\\\sqrt{y}={x}^{2}+x+C\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}y & ={\\\\left(\\\\frac{{x}^{2}+x+C}{2}\\\\right)}^{2}.\\\\end{aligned}\\n$$\"\n    },\n    {\n      \"id\": \"b946e806-cd3a-503b-8b7c-fe17b0906080\",\n      \"ma_id\": \"q-8305\",\n      \"difficulty\": \":question.difficulty/hard\",\n      \"prompt\": \"Find the general solution to the differential equation $\\\\frac{\\\\text{d}y}{\\\\text{d}x}-(\\\\operatorname{cos}\\u2061x)y=0$ for $y\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"610604c1-be04-5ae1-8759-b50654e72419\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{-\\\\operatorname{cos}\\u2061x}\",\n              \":db/id\": 17592186349333\n            },\n            {\n              \":answer/id\": \"6b4f4cea-17dd-5832-b0a8-70627738c306\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={e}^{-\\\\operatorname{cos}\\u2061x}+K\",\n              \":db/id\": 17592186349434\n            },\n            {\n              \":answer/id\": \"6c66c47e-a365-5d7e-8cc6-1deb04431c20\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={e}^{\\\\operatorname{sin}\\u2061x}+K\",\n              \":db/id\": 17592186349447\n            },\n            {\n              \":answer/id\": \"759561ba-3f4a-5157-8283-98918b52bdbb\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\operatorname{cos}\\u2061x}\",\n              \":db/id\": 17592186349529\n            },\n            {\n              \":answer/id\": \"dc2e52a7-5613-5624-ab39-0ecff616a3c4\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\operatorname{sin}\\u2061x}\",\n              \":db/id\": 17592186350372\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"dc2e52a7-5613-5624-ab39-0ecff616a3c4\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=K{e}^{\\\\operatorname{sin}\\u2061x}\",\n            \":db/id\": 17592186350372\n          },\n          \":answer-field/id\": \"26a2711c-7312-535e-b8ec-1d2da18482c4\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186350780\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}y}{\\\\text{d}x}-(\\\\operatorname{cos}\\u2061x)y & =0 \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =(\\\\operatorname{cos}\\u2061x)y \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\operatorname{cos}\\u2061x\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{cos}\\u2061x\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int \\\\operatorname{cos}\\u2061x\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{sin}\\u2061x+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|=\\\\operatorname{sin}\\u2061x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{sin}\\u2061x+C \\\\\\\\ |y| & ={e}^{\\\\operatorname{sin}\\u2061x+C} \\\\\\\\ |y| & ={e}^{\\\\operatorname{sin}\\u2061x}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{\\\\operatorname{sin}\\u2061x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny=K{e}^{\\\\operatorname{sin}\\u2061x}.\\n$$\"\n    },\n    {\n      \"id\": \"778dd5ee-c1ff-5286-be7b-93fe7ada6aaf\",\n      \"ma_id\": \"q-128191\",\n      \"difficulty\": \":question.difficulty/moderate\",\n      \"prompt\": \"Find the general solution to the differential equation ${y}^{\\u2032}=x{y}^{2}.$ Assume that $y\\\\ne 0$ and $K$ is an arbitrary constant.\\n\\n                            \\n                                    \\n                                        \\n                                            \\n\\n                                                \\n\\n                                        \\n                                        \\n                                        \\n\\n                                    \\n                                \\n                                    \\n                                        \\n                                        $y=-2($ \\n\\n                                    \\n                                \\n                                    \\n                            \\n                                        {{field-1}}                \\n                                    \\n                                \\n                                    \\n                                        \\n                                        $+K)^{-1}$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"f680649b-aad0-5c21-b454-2962d171cc58\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"{x}^{2}\",\n              \":db/id\": 17592186234935\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"f680649b-aad0-5c21-b454-2962d171cc58\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"{x}^{2}\",\n            \":db/id\": 17592186234935\n          },\n          \":answer-field/id\": \"94bd198b-189e-5b43-a53b-df64554d3cd5\",\n          \":answer-field/key\": \"field-1\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/blank\"\n          },\n          \":db/id\": 17592186235152\n        }\n      ],\n      \"worked_solution\": \"First, we separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =x{y}^{2} \\\\\\\\ \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =x\\\\end{aligned}\\n$$\\n\\nNext, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int x\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{{y}^{2}}\\\\,\\\\text{d}y & =\\\\int x\\\\,\\\\text{d}x \\\\\\\\ -\\\\frac{1}{y} & =\\\\frac{{x}^{2}}{2}+C\\\\end{aligned}\\n$$\\n\\nFinally, we solve for $y.$ This gives\\n\\n$$\\n\\\\begin{aligned}-\\\\frac{1}{y} & =\\\\frac{{x}^{2}}{2}+C \\\\\\\\ -\\\\frac{1}{y} & =\\\\frac{{x}^{2}+2C}{2} \\\\\\\\ \\\\frac{1}{y} & =-\\\\frac{{x}^{2}+2C}{2} \\\\\\\\ y & =-\\\\frac{2}{{x}^{2}+2C} \\\\\\\\ y & =-\\\\frac{2}{{x}^{2}+K} \\\\\\\\ y & =-2{({x}^{2}+K)}^{-1},\\\\end{aligned}\\n$$\\n\\nwhere $K=2C$ is an arbitrary constant.\"\n    },\n    {\n      \"id\": \"8f251269-fa35-5ece-9af4-5538cedc8207\",\n      \"ma_id\": \"q-14247\",\n      \"difficulty\": \":question.difficulty/hard\",\n      \"prompt\": \"Find the general solution to the differential equation ${y}^{\\u2032}=y+3y{x}^{2}$ for $y\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"4bbb69e0-08ac-541f-a0c9-781e5adaf93d\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\sqrt{{x}^{2}+2}}\",\n              \":db/id\": 17592186269951\n            },\n            {\n              \":answer/id\": \"a64073d1-36b3-54ce-9da0-185ff798ba5a\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{{x}^{2}+2x}\",\n              \":db/id\": 17592186270756\n            },\n            {\n              \":answer/id\": \"caeda8f1-2556-5b04-bcc7-d9ae17db2b41\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\sqrt{{x}^{3}+x}}\",\n              \":db/id\": 17592186271051\n            },\n            {\n              \":answer/id\": \"d6d54641-37a1-5f1b-b411-9374e6a99c0c\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{{x}^{3}+x}\",\n              \":db/id\": 17592186271154\n            },\n            {\n              \":answer/id\": \"f24d04bd-5257-5f28-8f9a-f8dfa0f53d86\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{3{x}^{2}+x}\",\n              \":db/id\": 17592186271398\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"d6d54641-37a1-5f1b-b411-9374e6a99c0c\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=K{e}^{{x}^{3}+x}\",\n            \":db/id\": 17592186271154\n          },\n          \":answer-field/id\": \"f58bc506-2ce6-5f14-8138-f2c78e5c6cec\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186271934\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032} & =y+3y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y+3y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y(1+3{x}^{2}) \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =1+3{x}^{2}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (1+3{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int (1+3{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =x+{x}^{3}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|={x}^{3}+x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & ={x}^{3}+x+C \\\\\\\\ |y| & ={e}^{{x}^{3}+x+C} \\\\\\\\ |y| & ={e}^{{x}^{3}+x}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{{x}^{3}+x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny=K{e}^{{x}^{3}+x}.\\n$$\"\n    },\n    {\n      \"id\": \"de6a882e-022d-59c5-adf8-2e2394047b45\",\n      \"ma_id\": \"q-14253\",\n      \"difficulty\": \":question.difficulty/moderate\",\n      \"prompt\": \"Find the general solution to the differential equation $\\\\frac{\\\\text{d}y}{\\\\text{d}x}={y}^{2}+2{y}^{2}x$ for $y\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"67122d50-92e9-5dbf-990c-0216ba86e1b0\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=-\\\\frac{1}{2x+C}\",\n              \":db/id\": 17592186270187\n            },\n            {\n              \":answer/id\": \"74a6e407-2886-5e8a-b215-c668e4499333\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=-\\\\frac{1}{{x}^{2}+x}+C\",\n              \":db/id\": 17592186270298\n            },\n            {\n              \":answer/id\": \"8f18500b-635a-52f2-ad08-9cfecc92fe33\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\frac{1}{2{x}^{2}+x}+C\",\n              \":db/id\": 17592186270513\n            },\n            {\n              \":answer/id\": \"afaac117-d7de-54cf-b4d2-12a4f27ad185\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\frac{1}{{x}^{3}+C}\",\n              \":db/id\": 17592186270833\n            },\n            {\n              \":answer/id\": \"fe67ce39-75d8-5a64-817a-e44f388af12a\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=-\\\\frac{1}{{x}^{2}+x+C}\",\n              \":db/id\": 17592186271497\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"fe67ce39-75d8-5a64-817a-e44f388af12a\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=-\\\\frac{1}{{x}^{2}+x+C}\",\n            \":db/id\": 17592186271497\n          },\n          \":answer-field/id\": \"df104af1-2216-5c05-8160-ea3f0cd58c3f\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186271901\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}y}{\\\\text{d}x} & ={y}^{2}+2{y}^{2}x \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & ={y}^{2}(1+2x) \\\\\\\\ \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =1+2x\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{{y}^{2}}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (1+2x)\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{{y}^{2}}\\\\,\\\\text{d}y & =\\\\int (1+2x)\\\\,\\\\text{d}x \\\\\\\\ -\\\\frac{1}{y} & =x+{x}^{2}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n-\\\\frac{1}{y}={x}^{2}+x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\ny=-\\\\frac{1}{{x}^{2}+x+C}.\\n$$\"\n    },\n    {\n      \"id\": \"e0c7db14-c9c5-588a-b927-09334c1e0842\",\n      \"ma_id\": \"q-158009\",\n      \"difficulty\": \":question.difficulty/hard\",\n      \"prompt\": \"Find the general solution to the differential equation ${x}^{2}\\\\,{y}^{\\u2032}-y=3$ for $y\\\\ne -3.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"053ca9da-737f-5368-b54e-24f96cafcde5\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{-3/x}\",\n              \":db/id\": 17592186272436\n            },\n            {\n              \":answer/id\": \"0bac610d-2d04-5604-ae64-cf06296f12ec\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{-x}-3\",\n              \":db/id\": 17592186272493\n            },\n            {\n              \":answer/id\": \"41cc209a-81ce-50b5-9b00-4dc750c10cf0\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{1/x}+3\",\n              \":db/id\": 17592186272947\n            },\n            {\n              \":answer/id\": \"c69d7489-94d3-50a5-a31f-01511961f376\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{x}+3\",\n              \":db/id\": 17592186274110\n            },\n            {\n              \":answer/id\": \"fe66c8fc-fdf6-5a64-96a6-a35189bbdf14\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{-1/x}-3\",\n              \":db/id\": 17592186274625\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"fe66c8fc-fdf6-5a64-96a6-a35189bbdf14\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=K{e}^{-1/x}-3\",\n            \":db/id\": 17592186274625\n          },\n          \":answer-field/id\": \"15153a99-fd23-5390-abfe-dedc4885900e\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186274673\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{x}^{2}\\\\,{y}^{\\u2032}-y & =3 \\\\\\\\ {x}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x}-y & =3 \\\\\\\\ {x}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y+3 \\\\\\\\ \\\\frac{1}{y+3}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\frac{1}{{x}^{2}}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y+3}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y+3}\\\\,\\\\text{d}y & =\\\\int \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y+3| & =-\\\\frac{1}{x}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y+3|=-\\\\frac{1}{x}+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y+3| & =-\\\\frac{1}{x}+C \\\\\\\\ |y+3| & ={e}^{-1/x+C} \\\\\\\\ |y+3| & ={e}^{-1/x}\\\\cdot {e}^{C} \\\\\\\\ |y+3| & =K{e}^{-1/x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\n\\\\begin{aligned}|y+3| & =K{e}^{-1/x} \\\\\\\\ y+3 & =K{e}^{-1/x} \\\\\\\\ y & =K{e}^{-1/x}-3.\\\\end{aligned}\\n$$\"\n    },\n    {\n      \"id\": \"6f88ec76-892c-5986-98b6-3866ba9a8457\",\n      \"ma_id\": \"q-158010\",\n      \"difficulty\": \":question.difficulty/hard\",\n      \"prompt\": \"Find the general solution to the differential equation $\\\\sqrt{1-{x}^{2}}\\\\,{y}^{\\u2032}-y=0$ for $y\\\\ne 0$ and $|x|<1.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"3e906697-63fe-5f9c-9695-47b9d1159642\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{1/\\\\sqrt{1-{x}^{2}}}\",\n              \":db/id\": 17592186272921\n            },\n            {\n              \":answer/id\": \"491e2dd7-2197-5bca-8669-100af83cb2d4\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\operatorname{arcsin}\\u2061x}\",\n              \":db/id\": 17592186273009\n            },\n            {\n              \":answer/id\": \"4a2b0b18-1859-5892-ace0-8191af79d18f\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\operatorname{arctan}\\u2061x}\",\n              \":db/id\": 17592186273016\n            },\n            {\n              \":answer/id\": \"92ec8453-5e27-5368-9ac0-a98e23834e02\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\operatorname{sin}\\u2061x}\",\n              \":db/id\": 17592186273663\n            },\n            {\n              \":answer/id\": \"b8730d08-4ef6-5d55-ade2-a86a1a24e46f\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\sqrt{1-{x}^{2}}}\",\n              \":db/id\": 17592186273986\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"491e2dd7-2197-5bca-8669-100af83cb2d4\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=K{e}^{\\\\operatorname{arcsin}\\u2061x}\",\n            \":db/id\": 17592186273009\n          },\n          \":answer-field/id\": \"115fa6bc-8cbf-507c-a94a-1255297d1654\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186274666\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}\\\\sqrt{1-{x}^{2}}\\\\,{y}^{\\u2032}-y & =0 \\\\\\\\ \\\\sqrt{1-{x}^{2}}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x}-y & =0 \\\\\\\\ \\\\sqrt{1-{x}^{2}}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\frac{1}{\\\\sqrt{1-{x}^{2}}}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{\\\\sqrt{1-{x}^{2}}}\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int \\\\frac{1}{\\\\sqrt{1-{x}^{2}}}\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{arcsin}\\u2061x+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|=\\\\operatorname{arcsin}\\u2061x+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & =\\\\operatorname{arcsin}\\u2061x+C \\\\\\\\ |y| & ={e}^{\\\\operatorname{arcsin}\\u2061x+C} \\\\\\\\ |y| & ={e}^{\\\\operatorname{arcsin}\\u2061x}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{\\\\operatorname{arcsin}\\u2061x}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\n\\\\begin{aligned}y & =K{e}^{\\\\operatorname{arcsin}\\u2061x}.\\\\end{aligned}\\n$$\"\n    },\n    {\n      \"id\": \"f1ee3e58-1671-5aa8-8cb2-98c85793fdad\",\n      \"ma_id\": \"q-3854\",\n      \"difficulty\": \":question.difficulty/hard\",\n      \"prompt\": \"Find the general solution to the differential equation ${y}^{\\u2032}=2yx+y{x}^{2}$ for $y\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"36403495-4819-509a-932f-4c97f8aa7b1f\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={e}^{{x}^{2}}+{e}^{{x}^{3}}+K\",\n              \":db/id\": 17592186324413\n            },\n            {\n              \":answer/id\": \"4fd5ef59-50c9-5c92-95c9-4ed4edd2d608\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{{x}^{2}+{x}^{3}/3}\",\n              \":db/id\": 17592186324625\n            },\n            {\n              \":answer/id\": \"5fa29fba-6a67-5365-afb0-3f19aca8c7ce\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y={x}^{2}+\\\\frac{{x}^{3}}{3}+K\",\n              \":db/id\": 17592186324770\n            },\n            {\n              \":answer/id\": \"c652480f-f0c2-5459-9c4e-e7870338385a\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\operatorname{ln}\\u2061{x}^{2}+\\\\operatorname{ln}\\u2061\\\\frac{{x}^{3}}{3}+K\",\n              \":db/id\": 17592186325684\n            },\n            {\n              \":answer/id\": \"d4dff042-5ffc-5451-8cbe-3ca7735819e1\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\operatorname{ln}\\u2061{x}^{2}+\\\\operatorname{ln}\\u2061{x}^{3}+K\",\n              \":db/id\": 17592186325823\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"4fd5ef59-50c9-5c92-95c9-4ed4edd2d608\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=K{e}^{{x}^{2}+{x}^{3}/3}\",\n            \":db/id\": 17592186324625\n          },\n          \":answer-field/id\": \"7d052acb-260c-5495-945e-851283aac703\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186326446\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}{y}^{\\u2032} & =2yx+y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =2yx+y{x}^{2} \\\\\\\\ \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =y(2x+{x}^{2}) \\\\\\\\ \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x} & =2x+{x}^{2}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{1}{y}\\\\cdot \\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int (2x+{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\int \\\\frac{1}{y}\\\\,\\\\text{d}y & =\\\\int (2x+{x}^{2})\\\\,\\\\text{d}x \\\\\\\\ \\\\operatorname{ln}\\u2061|y| & ={x}^{2}+\\\\frac{{x}^{3}}{3}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\operatorname{ln}\\u2061|y|={x}^{2}+\\\\frac{{x}^{3}}{3}+C.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{ln}\\u2061|y| & ={x}^{2}+\\\\frac{{x}^{3}}{3}+C \\\\\\\\ |y| & ={e}^{{x}^{2}+{x}^{3}/3+C} \\\\\\\\ |y| & ={e}^{{x}^{2}+{x}^{3}/3}\\\\cdot {e}^{C} \\\\\\\\ |y| & =K{e}^{{x}^{2}+{x}^{3}/3}\\\\end{aligned}\\n$$\\n\\nwhere $K={e}^{C}$ and $K>0.$\\n\\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\\n\\n$$\\ny=K{e}^{{x}^{2}+{x}^{3}/3}.\\n$$\"\n    },\n    {\n      \"id\": \"7875009d-90d4-5d80-94fc-0c8d789c5fc8\",\n      \"ma_id\": \"q-79660\",\n      \"difficulty\": \":question.difficulty/moderate\",\n      \"prompt\": \"Find the general solution to the differential equation $(xy)^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x}=1$ for $x\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"0e364992-7edc-53f1-910c-f390251a729e\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\sqrt[3]{\\\\frac{K}{x}+1}\",\n              \":db/id\": 17592186345466\n            },\n            {\n              \":answer/id\": \"22166d6d-c75b-5d4d-95dd-c959a62939dc\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\sqrt[3]{K-\\\\frac{1}{x}}\",\n              \":db/id\": 17592186345656\n            },\n            {\n              \":answer/id\": \"a530df5f-1758-5257-88f9-0923a1b1b0c8\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\sqrt{K+\\\\frac{1}{x}}\",\n              \":db/id\": 17592186346791\n            },\n            {\n              \":answer/id\": \"c7fec27b-d196-52e9-95f2-c4377198d22c\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\sqrt{K-\\\\frac{2}{x}}\",\n              \":db/id\": 17592186347091\n            },\n            {\n              \":answer/id\": \"d8069f30-9bf0-5b4e-9f9e-9c10ba0b9d32\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=\\\\sqrt[3]{K-\\\\frac{3}{x}}\",\n              \":db/id\": 17592186347253\n            }\n          ],\n          \":answer-field/correct\": {\n            \":answer/id\": \"d8069f30-9bf0-5b4e-9f9e-9c10ba0b9d32\",\n            \":answer/type\": {\n              \":db/ident\": \":answer.type/math\"\n            },\n            \":answer/value\": \"y=\\\\sqrt[3]{K-\\\\frac{3}{x}}\",\n            \":db/id\": 17592186347253\n          },\n          \":answer-field/id\": \"316512c9-9dd3-57da-a367-ec001996e486\",\n          \":answer-field/key\": \"selection\",\n          \":answer-field/type\": {\n            \":db/ident\": \":answer-field.type/radio\"\n          },\n          \":db/id\": 17592186347686\n        }\n      ],\n      \"worked_solution\": \"To find the general solution, we first separate the variables:\\n\\n$$\\n\\\\begin{aligned}(xy)^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =1 \\\\\\\\ {x}^{2}{y}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =1 \\\\\\\\ {y}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x} & =\\\\frac{1}{{x}^{2}}\\\\end{aligned}\\n$$\\n\\nThen, we integrate both sides with respect to $x:$\\n\\n$$\\n\\\\begin{aligned}\\\\int {y}^{2}\\\\,\\\\frac{\\\\text{d}y}{\\\\text{d}x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\ \\\\int {y}^{2}\\\\,\\\\text{d}y & =\\\\int \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\ \\\\frac{1}{3}{y}^{3} & =-\\\\frac{1}{x}+C\\\\end{aligned}\\n$$\\n\\nTherefore, the general solution to the differential equation (in implicit form) is\\n\\n$$\\n\\\\frac{1}{3}{y}^{3}=C-\\\\frac{1}{x}.\\n$$\\n\\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\\n\\n$$\\n\\\\begin{aligned}\\\\frac{1}{3}{y}^{3} & =C-\\\\frac{1}{x} \\\\\\\\ {y}^{3} & =3C-\\\\frac{3}{x} \\\\\\\\ y & =\\\\sqrt[3]{3C-\\\\frac{3}{x}} \\\\\\\\ y & =\\\\sqrt[3]{K-\\\\frac{3}{x}}\\\\end{aligned}\\n$$\\n\\nwhere $K=3C.$\"\n    },\n    {\n      \"id\": \"723d85e2-15cf-520f-80d9-dfe4f98e64df\",\n      \"ma_id\": \"q-79663\",\n      \"difficulty\": \":question.difficulty/hard\",\n      \"prompt\": \"Find the general solution to the differential equation ${y}^{\\u2032}-2xy=3{x}^{2}y$ for $y\\\\ne 0.$\",\n      \"fields\": [\n        {\n          \":answer-field/choices\": [\n            {\n              \":answer/id\": \"0a97ce8d-6961-5e39-bc06-a013c948432b\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\sqrt{{x}^{3}+{x}^{2}}}\",\n              \":db/id\": 17592186345433\n            },\n            {\n              \":answer/id\": \"5564c19a-cbe2-58bc-ba00-963c24b8358a\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{\\\\sqrt{3{x}^{2}+2x}}\",\n              \":db/id\": 17592186346075\n            },\n            {\n              \":answer/id\": \"614aee15-ac05-53b6-ba2c-564ddddc0d85\",\n              \":answer/type\": {\n                \":db/ident\": \":answer.type/math\"\n              },\n              \":answer/value\": \"y=K{e}^{{x}^{3}+{x}^{2}}\",\n              \":db/id\": 17592186346195\n            },\n            {\n              \":answer/id\": \"7a0a5e6f-53c5-57f6\n","exit_code":0,"status":"completed"}}
