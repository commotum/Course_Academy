oices "fbe8bee5-4fc4-5696-a87a-7c22a9798075"] [:db/add "1763bee1-cfb8-5a3e-9de0-c430dd931519" :answer-field/choices "dc36d5d0-64d5-5ada-8fb7-841e9841e414"] [:db/add "1763bee1-cfb8-5a3e-9de0-c430dd931519" :answer-field/correct "fcabaf0c-d3ac-5e0a-ae3b-aa11ef9021e5"] [:db/ensure "1763bee1-cfb8-5a3e-9de0-c430dd931519" :answer-field/validate] [:db/add "673675bd-5c68-5cda-a7b2-bd4261ad478c" :question/id #uuid "673675bd-5c68-5cda-a7b2-bd4261ad478c"] [:db/add "673675bd-5c68-5cda-a7b2-bd4261ad478c" :question/problem "Find the general solution to the differential equation $y'-xy=0$ for $y\\ne0.$"] [:db/add "673675bd-5c68-5cda-a7b2-bd4261ad478c" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y'-xy=0 \\\\ \\frac{\\text{d}y}{\\text{d}x}-xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =xy \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (x)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (x)\\,\\text{d}x \\\\ \\ln|y| & =\\frac{x^{2}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln|y|=\\frac{x^{2}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\ln|y| & =\\frac{x^{2}}{2}+C \\\\ |y| & =e^{\\frac{x^{2}}{2}+C} \\\\ |y| & =e^{\\frac{x^{2}}{2}}\\cdot e^C \\\\ |y| & =K e^{\\frac{x^{2}}{2}}\\end{aligned}\n$$\n\nwhere $K=e^C$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K e^{\\frac{x^{2}}{2}}.\n$$"] [:db/add "673675bd-5c68-5cda-a7b2-bd4261ad478c" :question/difficulty :question.difficulty/easy] [:db/add "673675bd-5c68-5cda-a7b2-bd4261ad478c" :question/answer-fields "1763bee1-cfb8-5a3e-9de0-c430dd931519"] [:db/ensure "673675bd-5c68-5cda-a7b2-bd4261ad478c" :question/validate] [:db/add 17592186068841 :knowledge-point/questions "673675bd-5c68-5cda-a7b2-bd4261ad478c"] [:db/add "a065ca85-23b9-57a2-9c4f-19506037b638" :answer/id #uuid "a065ca85-23b9-57a2-9c4f-19506037b638"] [:db/add "a065ca85-23b9-57a2-9c4f-19506037b638" :answer/type :answer.type/math] [:db/add "a065ca85-23b9-57a2-9c4f-19506037b638" :answer/value "y=K e^{\\frac{x^{2}}{2}}"] [:db/ensure "a065ca85-23b9-57a2-9c4f-19506037b638" :answer/validate] [:db/add "d56f3b88-010b-54af-b551-06716606f0b5" :answer/id #uuid "d56f3b88-010b-54af-b551-06716606f0b5"] [:db/add "d56f3b88-010b-54af-b551-06716606f0b5" :answer/type :answer.type/math] [:db/add "d56f3b88-010b-54af-b551-06716606f0b5" :answer/value "y=K + e^{- \\frac{x^{2}}{2}}"] [:db/ensure "d56f3b88-010b-54af-b551-06716606f0b5" :answer/validate] [:db/add "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b" :answer/id #uuid "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b"] [:db/add "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b" :answer/type :answer.type/math] [:db/add "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b" :answer/value "y=K e^{- \\frac{x^{2}}{2}}"] [:db/ensure "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b" :answer/validate] [:db/add "56ae88cd-afef-5b6b-abda-e32d3d00029b" :answer/id #uuid "56ae88cd-afef-5b6b-abda-e32d3d00029b"] [:db/add "56ae88cd-afef-5b6b-abda-e32d3d00029b" :answer/type :answer.type/math] [:db/add "56ae88cd-afef-5b6b-abda-e32d3d00029b" :answer/value "y=K e^{- x}"] [:db/ensure "56ae88cd-afef-5b6b-abda-e32d3d00029b" :answer/validate] [:db/add "10613b20-4546-5c4a-aa07-4879beaa6a0c" :answer/id #uuid "10613b20-4546-5c4a-aa07-4879beaa6a0c"] [:db/add "10613b20-4546-5c4a-aa07-4879beaa6a0c" :answer/type :answer.type/math] [:db/add "10613b20-4546-5c4a-aa07-4879beaa6a0c" :answer/value "y=K - \\frac{x^{2}}{2}"] [:db/ensure "10613b20-4546-5c4a-aa07-4879beaa6a0c" :answer/validate] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/id #uuid "10cb28d7-d622-5eda-905c-fd0e046fd019"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/key "selection"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/type :answer-field.type/radio] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/choices "a065ca85-23b9-57a2-9c4f-19506037b638"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/choices "d56f3b88-010b-54af-b551-06716606f0b5"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/choices "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/choices "56ae88cd-afef-5b6b-abda-e32d3d00029b"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/choices "10613b20-4546-5c4a-aa07-4879beaa6a0c"] [:db/add "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/correct "a9e0e78d-dfa5-5ef8-a0a3-a891d60b5f3b"] [:db/ensure "10cb28d7-d622-5eda-905c-fd0e046fd019" :answer-field/validate] [:db/add "63d7f230-b140-54c5-82dd-72d37987d264" :question/id #uuid "63d7f230-b140-54c5-82dd-72d37987d264"] [:db/add "63d7f230-b140-54c5-82dd-72d37987d264" :question/problem "Find the general solution to the differential equation $y'+xy=0$ for $y\\ne0.$"] [:db/add "63d7f230-b140-54c5-82dd-72d37987d264" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y'+xy=0 \\\\ \\frac{\\text{d}y}{\\text{d}x}+xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =- xy \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =- x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (- x)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (- x)\\,\\text{d}x \\\\ \\ln|y| & =- \\frac{x^{2}}{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln|y|=- \\frac{x^{2}}{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\ln|y| & =- \\frac{x^{2}}{2}+C \\\\ |y| & =e^{- \\frac{x^{2}}{2}+C} \\\\ |y| & =e^{- \\frac{x^{2}}{2}}\\cdot e^C \\\\ |y| & =K e^{- \\frac{x^{2}}{2}}\\end{aligned}\n$$\n\nwhere $K=e^C$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K e^{- \\frac{x^{2}}{2}}.\n$$"] [:db/add "63d7f230-b140-54c5-82dd-72d37987d264" :question/difficulty :question.difficulty/easy] [:db/add "63d7f230-b140-54c5-82dd-72d37987d264" :question/answer-fields "10cb28d7-d622-5eda-905c-fd0e046fd019"] [:db/ensure "63d7f230-b140-54c5-82dd-72d37987d264" :question/validate] [:db/add 17592186068841 :knowledge-point/questions "63d7f230-b140-54c5-82dd-72d37987d264"] [:db/add "generator" :question-generator/id #uuid "87137881-764d-5f91-a1e4-b84f2e3fac4c"] [:db/add "generator" :question-generator/script "generators/93/93cc5e18f727aad29c2363e48c2ecbd2a03f4a27ea2e4a885a6ac5fb57ae69ab/17592186068841.py"] [:db/add 17592186068841 :knowledge-point/question-generator "generator"] [:db/ensure 17592186068841 :knowledge-point/validate]]
