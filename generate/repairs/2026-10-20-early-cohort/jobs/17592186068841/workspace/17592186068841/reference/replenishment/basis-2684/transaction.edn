text{d}y & =\\int (- 10 x)\\,\\text{d}x \\\\ \\ln|y| & =- 5 x^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln|y|=- 5 x^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\ln|y| & =- 5 x^{2}+C \\\\ |y| & =e^{- 5 x^{2}+C} \\\\ |y| & =e^{- 5 x^{2}}\\cdot e^C \\\\ |y| & =K e^{- 5 x^{2}}\\end{aligned}\n$$\n\nwhere $K=e^C$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K e^{- 5 x^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["d485564e-e2b5-5d4a-867b-67459d0784ea"] :db/ensure :question/validate} {:db/id "a8de1130-c0a9-59bd-a338-4887563a0037" :answer/id #uuid "a8de1130-c0a9-59bd-a338-4887563a0037" :answer/type :answer.type/math :answer/value "y=K e^{- 2 x}" :db/ensure :answer/validate} {:db/id "b7f6b842-e80e-541c-9ec3-28a2725bc8b9" :answer/id #uuid "b7f6b842-e80e-541c-9ec3-28a2725bc8b9" :answer/type :answer.type/math :answer/value "y=K e^{2}" :db/ensure :answer/validate} {:db/id "abb416b9-0fa8-57dd-a01e-e19606f19afd" :answer/id #uuid "abb416b9-0fa8-57dd-a01e-e19606f19afd" :answer/type :answer.type/math :answer/value "y=K + 2 x" :db/ensure :answer/validate} {:db/id "95d62561-ff51-58c3-b0d5-acccd5a59f19" :answer/id #uuid "95d62561-ff51-58c3-b0d5-acccd5a59f19" :answer/type :answer.type/math :answer/value "y=K + e^{2 x}" :db/ensure :answer/validate} {:db/id "3f7b053c-d923-595c-8436-02149b0390ee" :answer/id #uuid "3f7b053c-d923-595c-8436-02149b0390ee" :answer/type :answer.type/math :answer/value "y=K e^{2 x}" :db/ensure :answer/validate} {:db/id "86288c86-69a9-5332-8284-b2e77b50cc38" :answer-field/id #uuid "86288c86-69a9-5332-8284-b2e77b50cc38" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["a8de1130-c0a9-59bd-a338-4887563a0037" "b7f6b842-e80e-541c-9ec3-28a2725bc8b9" "abb416b9-0fa8-57dd-a01e-e19606f19afd" "95d62561-ff51-58c3-b0d5-acccd5a59f19" "3f7b053c-d923-595c-8436-02149b0390ee"] :answer-field/correct "3f7b053c-d923-595c-8436-02149b0390ee" :db/ensure :answer-field/validate} {:db/id "927a0bdd-b0c8-54e0-a421-a7cb95e37402" :question/id #uuid "927a0bdd-b0c8-54e0-a421-a7cb95e37402" :question/problem "Find the general solution to the differential equation $y'-2y=0$ for $y\\ne0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}y'-2y=0 \\\\ \\frac{\\text{d}y}{\\text{d}x}-2y & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2y \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =2\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (2)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (2)\\,\\text{d}x \\\\ \\ln|y| & =2 x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln|y|=2 x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\ln|y| & =2 x+C \\\\ |y| & =e^{2 x+C} \\\\ |y| & =e^{2 x}\\cdot e^C \\\\ |y| & =K e^{2 x}\\end{aligned}\n$$\n\nwhere $K=e^C$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K e^{2 x}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["86288c86-69a9-5332-8284-b2e77b50cc38"] :db/ensure :question/validate} {:db/id "ac436b3f-83c2-5c6e-ab75-9264f928e89f" :answer/id #uuid "ac436b3f-83c2-5c6e-ab75-9264f928e89f" :answer/type :answer.type/math :answer/value "y=K - x" :db/ensure :answer/validate} {:db/id "053a30cb-744f-52a3-aaa9-5e9e81bf11f5" :answer/id #uuid "053a30cb-744f-52a3-aaa9-5e9e81bf11f5" :answer/type :answer.type/math :answer/value "y=K + e^{- x}" :d