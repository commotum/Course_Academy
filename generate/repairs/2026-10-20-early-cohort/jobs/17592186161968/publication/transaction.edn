ementary column operations are\n\n$C_{1}:=C_{1}-3C_{2}$ and $C_{3}:=C_{3}-C_{2}$."] [:db/add "1528ed9f-5ac2-5cfd-9630-b9d3abaef72f" :question/difficulty :question.difficulty/easy] [:db/add "1528ed9f-5ac2-5cfd-9630-b9d3abaef72f" :question/answer-fields "a3340420-750a-5ae5-9503-605384343430"] [:db/ensure "1528ed9f-5ac2-5cfd-9630-b9d3abaef72f" :question/validate] [:db/add 17592186161968 :knowledge-point/questions "1528ed9f-5ac2-5cfd-9630-b9d3abaef72f"] [:db/add "26a5125a-c078-55fd-b668-32bf54036c1a" :answer/id #uuid "26a5125a-c078-55fd-b668-32bf54036c1a"] [:db/add "26a5125a-c078-55fd-b668-32bf54036c1a" :answer/type :answer.type/text] [:db/add "26a5125a-c078-55fd-b668-32bf54036c1a" :answer/value "$C_{1}:=C_{1}-C_{2}$ and $C_{3}:=C_{3}+8C_{2}$"] [:db/ensure "26a5125a-c078-55fd-b668-32bf54036c1a" :answer/validate] [:db/add "283619b9-be04-5be3-b9ea-fd5d9a59c671" :answer/id #uuid "283619b9-be04-5be3-b9ea-fd5d9a59c671"] [:db/add "283619b9-be04-5be3-b9ea-fd5d9a59c671" :answer/type :answer.type/text] [:db/add "283619b9-be04-5be3-b9ea-fd5d9a59c671" :answer/value "$C_{1}:=C_{1}+2C_{2}$ and $C_{3}:=C_{3}+8C_{2}$"] [:db/ensure "283619b9-be04-5be3-b9ea-fd5d9a59c671" :answer/validate] [:db/add "d7074098-da01-5d5d-a4f6-783ea4b0c9ce" :answer/id #uuid "d7074098-da01-5d5d-a4f6-783ea4b0c9ce"] [:db/add "d7074098-da01-5d5d-a4f6-783ea4b0c9ce" :answer/type :answer.type/text] [:db/add "d7074098-da01-5d5d-a4f6-783ea4b0c9ce" :answer/value "$C_{1}:=C_{1}-2C_{2}$ and $C_{3}:=C_{3}+8C_{2}$"] [:db/ensure "d7074098-da01-5d5d-a4f6-783ea4b0c9ce" :answer/validate] [:db/add "33c3d908-3939-53e3-b840-449680d2556a" :answer/id #uuid "33c3d908-3939-53e3-b840-449680d2556a"] [:db/add "33c3d908-3939-53e3-b840-449680d2556a" :answer/type :answer.type/text] [:db/add "33c3d908-3939-53e3-b840-449680d2556a" :answer/value "$C_{1}:=C_{1}-2C_{2}$ and $C_{3}:=C_{3}-8C_{2}$"] [:db/ensure "33c3d908-3939-53e3-b840-449680d2556a" :answer/validate] [:db/add "84c5bef2-f13e-559c-8d04-ed6b5d127188" :answer/id #uuid "84c5bef2-f13e