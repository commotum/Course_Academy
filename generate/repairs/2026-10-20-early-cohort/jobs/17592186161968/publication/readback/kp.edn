C_{1}-C_{3}$ and $C_{2}:=C_{2}-8C_{3}$."} {:db/id #edb/ref 17592186674153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cfb99d6-961e-58c2-adda-8509425df5d8" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1}+5C_{3}$ and $C_{2}:=C_{2}+8C_{3}$" :db/id #edb/ref 17592186674162} {:answer/id #uuid "76e31e90-b398-5dd6-8f1c-4293e6c6eccb" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1}-5C_{3}$ and $C_{2}:=C_{2}+8C_{3}$" :db/id #edb/ref 17592186674167} {:answer/id #uuid "bc3e91a2-91dd-599a-8953-d74ca27a0e96" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1}-8C_{3}$ and $C_{2}:=C_{2}+5C_{3}$" :db/id #edb/ref 17592186674174} {:answer/id #uuid "d3583de6-bb0f-5165-9712-d804b2aec7a2" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1}+5C_{3}$ and $C_{2}:=C_{2}-8C_{3}$" :db/id #edb/ref 17592186674177} {:answer/id #uuid "f2af2423-d530-54cd-94dd-43b23dd96faa" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1}-5C_{3}$ and $C_{2}:=C_{2}-8C_{3}$" :db/id #edb/ref 17592186674182}] :answer-field/correct {:answer/id #uuid "d3583de6-bb0f-5165-9712-d804b2aec7a2" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1}+5C_{3}$ and $C_{2}:=C_{2}-8C_{3}$" :db/id #edb/ref 17592186674177} :answer-field/id #uuid "f007f1a8-dba6-5b61-850e-3c476c5903c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186674180}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f0ff450-b16b-5ec7-ac37-e676fe9b92db" :question/problem "$$\nA=\\begin{bmatrix}5 & -7 & 9 \\\\ -5 & 8 & 1 \\\\ -5 & 7 & -1\\end{bmatrix},\\,B=\\begin{bmatrix}50 & -79 & 9 \\\\ 0 & 0 & 1 \\\\ -10 & 15 & -1\\end{bmatrix}\n$$\n\nBy applying elementary column operations of the form $C_i:=C_i+kC_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solu