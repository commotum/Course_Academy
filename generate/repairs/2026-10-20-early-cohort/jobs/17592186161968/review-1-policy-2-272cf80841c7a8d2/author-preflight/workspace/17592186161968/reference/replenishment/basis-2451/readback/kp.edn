 elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}+{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+4{C}_{1}.$"} {:db/id #edb/ref 17592186265939 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14dacd30-9d3f-53cb-b0f9-9d2f9507316d" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}+5{C}_{2}$" :db/id #edb/ref 17592186263193} {:answer/id #uuid "156b2cc8-ac27-5d0b-85cb-de0cf638abe8" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}+3{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}+5{C}_{2}$" :db/id #edb/ref 17592186263200} {:answer/id #uuid "322f025a-079b-5cfc-90c1-6a75a02f73bf" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-5{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}+3{C}_{2}$" :db/id #edb/ref 17592186263430} {:answer/id #uuid "5da97601-cba3-510d-90a7-f99d3bd64765" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-5{C}_{2}$" :db/id #edb/ref 17592186263813} {:answer/id #uuid "ea2b375e-cb9d-5388-b4c5-104e0f651bdb" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}+3{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}-5{C}_{2}$" :db/id #edb/ref 17592186265039}] :answer-field/correct {:answer/id #uuid "14dacd30-9d3f-53cb-b0f9-9d2f9507316d" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-3{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}+5{C}_{2}$" :db/id #edb/ref 17592186263193} :answer-field/id #uuid "922b672c-88e3-5cd0-aa28-4833f6413211" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265508}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5b6d005-cac9-5d71-a15c