 & -4 \\\\ 8 & 8 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 5 & 0 \\\\ -7 & 3 & -1 \\\\ -8 & 8 & 8\\end{bmatrix}\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{2},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left and to the right of ${a}_{12}=5$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}10 & 5 & -5 \\\\ -1 & 3 & -4 \\\\ 8 & 8 & 0\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{1}: &={C}_{1}-2{C}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 5 & -5 \\\\ -7 & 3 & -4 \\\\ -8 & 8 & 0\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{3}: &={C}_{3}+{C}_{2}\\end{aligned} \\\\  & ∼\\begin{bmatrix}0 & 5 & 0 \\\\ -7 & 3 & -1 \\\\ -8 & 8 & 8\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-2{C}_{2}\\,$ and $\\,{C}_{3}:={C}_{3}+{C}_{2}.$"} {:db/id #edb/ref 17592186265938 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a6a529-cbbd-5a0e-aaf2-1d24fe040a9e" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+4{C}_{1}$" :db/id #edb/ref 17592186263338} {:answer/id #uuid "ac06dd13-879b-59f5-8b67-9f915ecfa721" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}+4{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+{C}_{1}$" :db/id #edb/ref 17592186264476} {:answer/id #uuid "ae4a7f32-e0d8-5b97-bf06-e077a7dc03db" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{2}:={C}_{2}-{C}_{1}\\,$ and $\\,{C}_{3}:={C}_{3}+4{C}_{1}$" :db/id #edb/ref 17592186264498} {:answer/id #uuid "b09ef022-