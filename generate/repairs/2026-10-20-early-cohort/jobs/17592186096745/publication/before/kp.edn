& 6 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}-2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 14 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186422479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee5bd89-c4e9-5aea-ba6a-3f045af5c0e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 11 & -14 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186422467} {:answer/id #uuid "75130a5b-9607-5217-b80c-6757c94daf70" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 11 & -14 \\\\ 0 & 1 & 3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186422471} {:answer/id #uuid "8076b85b-1614-5135-bb4c-2ab5d41377da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -7 & -14 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186422472} {:answer/id #uuid "d64479b7-f216-5594-be33-53f9d09c2c72" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -7 & -14 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186422473} {:answer/id #uuid "f1ebe9c7-57ca-5f13-b184-b18fa5a512d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 & -14 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}" :db/id #edb/ref 17592186422475}] :answer-field/correct {:answer/id #uuid "8076b85b-1614-5135-bb4c-2ab5d41377da" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -7 & -14 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186422472} :answer-field/id #uuid "a4a2cf38-1593-52f1-9b63-551383c8a50f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186422477}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "df6c8a6d-153a-5484-848d-1043ee95c582" :question/math-academy-id "q-74621" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}4x-11y+5z &=-1 \\\\ x-3y+2z &=1 \\\\ -3x+9y-6z &=-3\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}4 & -11 & 5 & -1 \\\\ 1 & -3 & 2 & 1 \\\\ -3 & 9 & -6 & -3\\end{bmatrix}.\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}4 & -11 & 5 & -1 \\\\ 1 & -3 & 2 & 1 \\\\ -3 & 9 & -6 & -3\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 1 \\\\ 4 & -11 & 5 & -1 \\\\ -3 & 9 & -6 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 1 \\\\ 0 & 1 & -3 & -5 \\\\ -3 & 9 & -6 & -3\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 2 & 1 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only. This gives,\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & -3 & 2 & 1 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -7 & -14 \\\\ 0 & 1 & -3 & -5 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186567107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18553473-fde9-5635-a056-b0f27fc9366e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -11 & 3 \\\\ 0 & 1 & 4 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186566411} {:answer/id #uuid "59fdd091-3425-54b2-aefb-ad6ef9eb6945" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -11 & 5 \\\\ 0 & 1 & 4 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186566533} {:answer/id #uuid "c5bcc49b-3304-5434-9cf7-3203f1d7d9a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -5 & 3 \\\\ 0 & 1 & 4 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186566755} {:answer/id #uuid "c862ab8f-695d-58e1-83af-785682adeec6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -11 & 5 \\\\ 0 & 1 & 4 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186566758} {:answer/id #uuid "ef183592-3341-5295-ac04-e087d87746ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -5 & 5 \\\\ 0 & 1 & 4 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186566845}] :answer-field/correct {:answer/id #uuid "59fdd091-3425-54b2-aefb-ad6ef9eb6945" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -11 & 5 \\\\ 0 & 1 & 4 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186566533} :answer-field/id #uuid "c7fb2a2a-5c00-5b94-88e0-900ed9cc6436" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566971}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f4d9e7f7-49ef-5deb-a765-86f4061f3e86" :question/math-academy-id "q-131630" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+2y-3z &=1 \\\\ 3x+8y-z &=-1 \\\\ 2x+4y-6z &=2\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 3 & 8 & -1 & -1 \\\\ 2 & 4 & -6 & 2\\end{bmatrix}.\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 3 & 8 & -1 & -1 \\\\ 2 & 4 & -6 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 0 & 2 & 8 & -4 \\\\ 2 & 4 & -6 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 0 & 2 & 8 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 0 & 1 & 4 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only. This gives,\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 2 & -3 & 1 \\\\ 0 & 1 & 4 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}-2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -11 & 5 \\\\ 0 & 1 & 4 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186610100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bce4211-b817-54dc-a8bb-28d457f451d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -3 & 1 \\\\ 0 & 1 & -3 & 4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610108} {:answer/id #uuid "54204215-ac78-55e6-8e8c-75ebd5027c18" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 4 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610112} {:answer/id #uuid "7020da23-8fe5-52ae-a8d4-a1983638c374" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 0 & 1 & 3 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610116} {:answer/id #uuid "7b187283-279d-5ccd-84e8-6af4edc44c4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 & -2 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610119} {:answer/id #uuid "8743da5a-94ef-5f43-824e-f1b6c0f69610" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 2 & -2 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610121}] :answer-field/correct {:answer/id #uuid "7020da23-8fe5-52ae-a8d4-a1983638c374" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 0 & 1 & 3 & -3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610116} :answer-field/id #uuid "43c5cf95-f12b-50fb-bf4f-18cc1a529c9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610106}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "03a789c8-9b37-5dee-9a03-af4e121c3206" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x - y - 5 z &=6 \\\\ x + 2 y + 4 z &=-3 \\\\ - 2 x + 2 y + 10 z &=-12\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & -1 & -5 & 6 \\\\ 1 & 2 & 4 & -3 \\\\ -2 & 2 & 10 & -12\\end{array}\\right]\n$$\n\nFirst reduce the matrix to row echelon form, making each pivot equal to $1$.\n\n$$\nR_{2}:=R_{2}+\\left(-1\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -1 & -5 & 6 \\\\ 0 & 3 & 9 & -9 \\\\ -2 & 2 & 10 & -12\\end{array}\\right]\n$$\n\n\n\n$$\nR_{3}:=R_{3}+\\left(2\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -1 & -5 & 6 \\\\ 0 & 3 & 9 & -9 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}:=\\left(\\frac{1}{3}\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -1 & -5 & 6 \\\\ 0 & 1 & 3 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only.\n\n$$\nR_{1}:=R_{1}+\\left(1\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & -2 & 3 \\\\ 0 & 1 & 3 & -3 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186610110 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177b9846-6a2f-5577-87d5-a74170f470e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ 2 - 3 z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610102} {:answer/id #uuid "7818cd97-3a2f-586c-8222-4343b66ffe0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 - 3 z \\\\ 2 z - 3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610117} {:answer/id #uuid "9b075dd0-ee27-57c2-8b68-9d5c215114ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 z + 2 \\\\ 4 - 2 z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610125} {:answer/id #uuid "c76fa561-2a80-5335-b55f-400931f7a074" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 - z \\\\ -1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610127} {:answer/id #uuid "e8fe9e48-d364-5316-893d-b5a61df3b6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 - 3 z \\\\ z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610130}] :answer-field/correct {:answer/id #uuid "e8fe9e48-d364-5316-893d-b5a61df3b6ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 - 3 z \\\\ z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610130} :answer-field/id #uuid "ee6bcc4b-53ee-517f-a1ab-655420d711de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610133}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "51609fc9-aab2-5e76-b417-9f8f95fa11f7" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}2 x - 5 y + 11 z &=4 \\\\ - 2 x + 10 y - 16 z &=-4 \\\\ x - 5 y + 8 z &=2\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -5 & 11 & 4 \\\\ -2 & 10 & -16 & -4 \\\\ 1 & -5 & 8 & 2\\end{array}\\right]\n$$\n\nFirst reduce the matrix to row echelon form, making each pivot equal to $1$.\n\n$$\nR_{1}\\leftrightarrow R_{3}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -5 & 8 & 2 \\\\ -2 & 10 & -16 & -4 \\\\ 2 & -5 & 11 & 4\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}:=R_{2}+\\left(2\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -5 & 8 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & -5 & 11 & 4\\end{array}\\right]\n$$\n\n\n\n$$\nR_{3}:=R_{3}+\\left(-2\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -5 & 8 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 5 & -5 & 0\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}\\leftrightarrow R_{3}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -5 & 8 & 2 \\\\ 0 & 5 & -5 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}:=\\left(\\frac{1}{5}\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -5 & 8 & 2 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only.\n\n$$\nR_{1}:=R_{1}+\\left(5\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 3 & 2 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x + 3 z &=2 \\\\ y - z &=0 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe final equation is $0=0$, so it imposes no restriction. The basic variables are $x$ and $y$, and the free variable is $z$. Find $x$ and $y$ in terms of $z$. Therefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2 - 3 z \\\\ y &=z \\\\ z &=z\\end{aligned}\\right.\n$$\n\nwhere $z$ is an arbitrary real number. In vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 - 3 z \\\\ z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )\n$$\n\n"} {:db/id #edb/ref 17592186610111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bb839e5-86a8-5dbe-b928-191994bfde95" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 z - 2 \\\\ 1 - z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610105} {:answer/id #uuid "66e5347c-972b-53cc-a089-63415a332479" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 - z \\\\ 3 - 3 z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610114} {:answer/id #uuid "7aadcd85-d076-5715-828d-2f0a5ddbed44" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 - z \\\\ 2 z \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610118} {:answer/id #uuid "9268d6c9-bd65-5ff4-8dbc-2d4834656d88" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 z + 2 \\\\ - 2 z - 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610123} {:answer/id #uuid "ee037444-2a01-51a4-8847-d6163291d405" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ z - 3 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610132}] :answer-field/correct {:answer/id #uuid "9268d6c9-bd65-5ff4-8dbc-2d4834656d88" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 z + 2 \\\\ - 2 z - 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186610123} :answer-field/id #uuid "cc4851ef-76b5-5933-98a6-59d17fdf85d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610128}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5204bbe1-d0e2-591d-91be-020cd618f104" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x + 2 y + 2 z &=-2 \\\\ - 3 x - 6 y - 6 z &=6 \\\\ 2 x + 5 y + 6 z &=-6\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & 2 & -2 \\\\ -3 & -6 & -6 & 6 \\\\ 2 & 5 & 6 & -6\\end{array}\\right]\n$$\n\nFirst reduce the matrix to row echelon form, making each pivot equal to $1$.\n\n$$\nR_{2}:=R_{2}+\\left(3\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & 2 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & 5 & 6 & -6\\end{array}\\right]\n$$\n\n\n\n$$\nR_{3}:=R_{3}+\\left(-2\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & 2 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 1 & 2 & -2\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}\\leftrightarrow R_{3}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & 2 & -2 \\\\ 0 & 1 & 2 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only.\n\n$$\nR_{1}:=R_{1}+\\left(-2\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & -2 & 2 \\\\ 0 & 1 & 2 & -2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x - 2 z &=2 \\\\ y + 2 z &=-2 \\\\ 0 &=0\\end{aligned}\\right.\n$$\n\nThe final equation is $0=0$, so it imposes no restriction. The basic variables are $x$ and $y$, and the free variable is $z$. Find $x$ and $y$ in terms of $z$. Therefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2 z + 2 \\\\ y &=- 2 z - 2 \\\\ z &=z\\end{aligned}\\right.\n$$\n\nwhere $z$ is an arbitrary real number. In vector form, the solution can be written as\n\n$$\n\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}2 z + 2 \\\\ - 2 z - 2 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )\n$$\n\n"} {:db/id #edb/ref 17592186610124 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f471f2f-1657-5c5b-86f4-6a2ef9331234" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 2 & 0 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610101} {:answer/id #uuid "1bc616d3-73cf-51a3-b108-784335ba337e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 1 & -1 \\\\ 0 & 1 & 2 & 1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610103} {:answer/id #uuid "4407d457-9cfc-5be1-bda3-482eee4147c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -1 & 2 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610107} {:answer/id #uuid "9206c326-e9fe-5802-ae12-031b4fa256fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 1 \\\\ 0 & 1 & -3 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610122} {:answer/id #uuid "c568d0d0-c122-5a0a-80e3-0ac8c1f9968d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -1 & 4 \\\\ 0 & 1 & -3 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610126}] :answer-field/correct {:answer/id #uuid "c568d0d0-c122-5a0a-80e3-0ac8c1f9968d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -1 & 4 \\\\ 0 & 1 & -3 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610126} :answer-field/id #uuid "690829a6-390e-552a-9845-1c48f8474c1a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610115}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9375f891-71d6-5bf1-9d69-88ac2d5602c6" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}4 x - 11 y + 29 z &=-6 \\\\ x - 3 y + 8 z &=-2 \\\\ - 3 x + 9 y - 24 z &=6\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}4 & -11 & 29 & -6 \\\\ 1 & -3 & 8 & -2 \\\\ -3 & 9 & -24 & 6\\end{array}\\right]\n$$\n\nFirst reduce the matrix to row echelon form, making each pivot equal to $1$.\n\n$$\nR_{1}\\leftrightarrow R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -3 & 8 & -2 \\\\ 4 & -11 & 29 & -6 \\\\ -3 & 9 & -24 & 6\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}:=R_{2}+\\left(-4\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -3 & 8 & -2 \\\\ 0 & 1 & -3 & 2 \\\\ -3 & 9 & -24 & 6\\end{array}\\right]\n$$\n\n\n\n$$\nR_{3}:=R_{3}+\\left(3\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & -3 & 8 & -2 \\\\ 0 & 1 & -3 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only.\n\n$$\nR_{1}:=R_{1}+\\left(3\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & -1 & 4 \\\\ 0 & 1 & -3 & 2 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186610134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21391fde-7333-5be7-93c3-f26390121d7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 & -3 \\\\ 0 & 1 & -2 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610104} {:answer/id #uuid "4d20ecd6-5e50-582f-8eec-4b41cd58d4ff" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 2 & 1 \\\\ 0 & 1 & 2 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610109} {:answer/id #uuid "5ef6d292-02ae-5eed-8a92-0d8b67b0fc33" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -3 & 3 \\\\ 0 & 1 & -1 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610113} {:answer/id #uuid "7f681190-0782-5638-a91d-8c329ca2f7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 & 0 \\\\ 0 & 1 & -3 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610120} {:answer/id #uuid "d40dde6b-eab5-5a02-8b9b-e835bc316e3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 & -3 \\\\ 0 & 1 & 2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610129}] :answer-field/correct {:answer/id #uuid "21391fde-7333-5be7-93c3-f26390121d7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -2 & -3 \\\\ 0 & 1 & -2 & -4 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186610104} :answer-field/id #uuid "ea23efbb-f3c7-5c1a-8585-71fb4caacf68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186610131}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f855becb-3466-53a2-87a2-10461c1b9f01" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x + 2 y - 6 z &=-11 \\\\ x + y - 4 z &=-7 \\\\ - 4 x - 8 y + 24 z &=44\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & -6 & -11 \\\\ 1 & 1 & -4 & -7 \\\\ -4 & -8 & 24 & 44\\end{array}\\right]\n$$\n\nFirst reduce the matrix to row echelon form, making each pivot equal to $1$.\n\n$$\nR_{2}:=R_{2}+\\left(-1\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & -6 & -11 \\\\ 0 & -1 & 2 & 4 \\\\ -4 & -8 & 24 & 44\\end{array}\\right]\n$$\n\n\n\n$$\nR_{3}:=R_{3}+\\left(4\\right)R_{1}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & -6 & -11 \\\\ 0 & -1 & 2 & 4 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n\n\n$$\nR_{2}:=\\left(-1\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & -6 & -11 \\\\ 0 & 1 & -2 & -4 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only.\n\n$$\nR_{1}:=R_{1}+\\left(-2\\right)R_{2}\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & -2 & -3 \\\\ 0 & 1 & -2 & -4 \\\\ 0 & 0 & 0 & 0\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186642343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c9f454b-9874-59cf-9683-9c6260dc18a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 5 & -8 \\\\ 0 & 1 & 2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641874} {:answer/id #uuid "1d925835-4560-5fe7-b478-69ed24ed729a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -5 & 8 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641875} {:answer/id #uuid "28497492-f8d5-5ed3-9ed1-5d0feb81e0cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 & 8 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186641894} {:answer/id #uuid "38e022a7-abd8-5b4b-a593-079b1f84c938" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 & 8 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641925} {:answer/id #uuid "67d6ca7b-bfa0-557f-8611-b0dfd933c728" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -5 & 8 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186641988}] :answer-field/correct {:answer/id #uuid "1d925835-4560-5fe7-b478-69ed24ed729a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & -5 & 8 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641875} :answer-field/id #uuid "165d1d3d-b7da-5893-a27a-622c1387bc00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642212}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8e9b3735-f721-557c-bd19-98de1fb72ed8" :question/math-academy-id "q-74625" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x-3y+z &=-1 \\\\ y-2z &=3 \\\\ -5x+15y-5z &=5\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -3 & 1 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ -5 & 15 & -5 & 5\\end{bmatrix}.\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & -3 & 1 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ -5 & 15 & -5 & 5\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 1 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only. This gives,\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & -3 & 1 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -5 & 8 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186642366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "127a40db-874b-55b7-89c5-b7b99557d9df" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & -1 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641852} {:answer/id #uuid "1e3c5ff3-f790-5427-9482-39e85981ab58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641879} {:answer/id #uuid "8f201362-def3-5636-b65f-05b948c01b02" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186642052} {:answer/id #uuid "b1163bf1-8610-59d5-8dc1-a1372c7205b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & 3 & 6 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186642091} {:answer/id #uuid "f7d26910-570d-54fe-8717-90bb1b6d3120" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & 3 & 3 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186642185}] :answer-field/correct {:answer/id #uuid "1e3c5ff3-f790-5427-9482-39e85981ab58" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186641879} :answer-field/id #uuid "d5debf8d-6709-5ded-9e77-6cbfa5eef2b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186642278}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c0791632-977c-5714-8eb6-2845fc127f35" :question/math-academy-id "q-131634" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}x+3z &=3 \\\\ -x+3y &=3 \\\\ -2x-6z &=-6\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ -1 & 3 & 0 & 3 \\\\ -2 & 0 & -6 & -6\\end{bmatrix}.\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ -1 & 3 & 0 & 3 \\\\ -2 & 0 & -6 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 3 & 3 & 6 \\\\ -2 & 0 & -6 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 3 & 3 & 6 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 3 & 3 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Reduced Row Echelon Form of a Singular 3x3 System With Two Pivots"}]}
