\\\ 5 & 16 & -1 & 9 \\\\ 5 & 26 & 7 & -9 \\\\ 3 & 0 & -3 & 15\\end{bmatrix}\n\\xrightarrow{C_{3}:=C_{3}+C_{1}}\\begin{bmatrix}6 & 33 & 9 & -5 \\\\ 5 & 16 & 4 & 9 \\\\ 5 & 26 & 12 & -9 \\\\ 3 & 0 & 0 & 15\\end{bmatrix}\n\\xrightarrow{C_{4}:=C_{4}-5C_{1}}\\begin{bmatrix}6 & 33 & 9 & -35 \\\\ 5 & 16 & 4 & -16 \\\\ 5 & 26 & 12 & -34 \\\\ 3 & 0 & 0 & 0\\end{bmatrix}=B\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$C_{2}:=C_{2}+5C_{1}$ and $C_{4}:=C_{4}-5C_{1}$."] [:db/add "6e29c615-0a47-5a63-addf-703234967cc0" :question/difficulty :question.difficulty/moderate] [:db/add "6e29c615-0a47-5a63-addf-703234967cc0" :question/answer-fields "86996638-1bf7-52f2-99c4-4fbe9d4d0307"] [:db/ensure "6e29c615-0a47-5a63-addf-703234967cc0" :question/validate] [:db/add 17592186161966 :knowledge-point/questions "6e29c615-0a47-5a63-addf-703234967cc0"] [:db/add "fc158ff2-6f9d-58cd-8684-c054bce2b163" :answer/id #uuid "fc158ff2-6f9d-58cd-8684-c054bce2b163"] [:db/add "fc158ff2-6f9d-58cd-8684-c054bce2b163" :answer/type :answer.type/text] [:db/add "fc158ff2-6f9d-58cd-8684-c054bce2b163" :answer/value "$C_{2}:=C_{2}-2C_{4}$ and $C_{3}:=C_{3}+3C_{4}$"] [:db/ensure "fc158ff2-6f9d-58cd-8684-c054bce2b163" :answer/validate] [:db/add "58889107-f3ac-59ba-bae5-118c27b2aac4" :answer/id #uuid "58889107-f3ac-59ba-bae5-118c27b2aac4"] [:db/add "58889107-f3ac-59ba-bae5-118c27b2aac4" :answer/type :answer.type/text] [:db/add "58889107-f3ac-59ba-bae5-118c27b2aac4" :answer/value "$C_{2}:=C_{2}-2C_{4}$ and $C_{3}:=C_{3}+C_{4}$"] [:db/ensure "58889107-f3ac-59ba-bae5-118c27b2aac4" :answer/validate] [:db/add "0dd86afe-781f-5886-9f69-edfa06c8f077" :answer/id #uuid "0dd86afe-781f-5886-9f69-edfa06c8f077"] [:db/add "0dd86afe-781f-5886-9f69-edfa06c8f077" :answer/type :answer.type/text] [:db/add "0dd86afe-781f-5886-9f69-edfa06c8f077" :answer/value "$C_{2}:=C_{2}+3C_{4}$ and $C_{3}:=C_{3}-2C_{4}$"] [:db/ensure "0dd86afe-781f-5886-9f69-edfa06c8f077" :answer/validate] [:db/add "7b52372e-0ef9-5cc7-9627-246