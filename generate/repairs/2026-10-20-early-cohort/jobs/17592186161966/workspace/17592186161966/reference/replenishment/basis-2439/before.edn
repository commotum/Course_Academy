x}7 & 0 & 2 & 7 \\\\ -3 & -7 & -4 & -6 \\\\ 0 & 3 & 1 & 2 \\\\ 4 & 7 & 2 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{2}: &={C}_{2}-3{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}7 & -6 & 2 & 7 \\\\ -3 & 5 & -4 & -6 \\\\ 0 & 0 & 1 & 2 \\\\ 4 & 1 & 2 & 3\\end{bmatrix} &  & \\,\\begin{aligned}{C}_{4}: &={C}_{4}-2{C}_{3}\\end{aligned} \\\\  & ∼\\begin{bmatrix}7 & -6 & 2 & 3 \\\\ -3 & 5 & -4 & 2 \\\\ 0 & 0 & 1 & 0 \\\\ 4 & 1 & 2 & -1\\end{bmatrix} \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the corresponding elementary column operations are\n\n$\\,$ ${C}_{2}:={C}_{2}-3{C}_{3}\\,$ and $\\,{C}_{4}:={C}_{4}-2{C}_{3}.$"} {:db/id 17592186162574 :knowledge-point/_questions [{:knowledge-point/id #uuid "958cdcf3-aaba-5275-85f8-9531f10b3d0e" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 4x4 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5b212e7-ab71-55e8-b4ac-1d3753094d3d" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 5C_{4}$ and $C_{3}:=C_{3} - 3C_{4}$" :db/id 17592186160737} {:answer/id #uuid "a63f6b02-0d77-5c0f-9259-8c2dd72d0b7b" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 5C_{4}$ and $C_{3}:=C_{3} - 2C_{4}$" :db/id 17592186160738} {:answer/id #uuid "b660cd55-bfdf-5a54-a239-bf2d0f7a69b2" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 5C_{4}$ and $C_{3}:=C_{3} + 3C_{4}$" :db/id 17592186160739} {:answer/id #uuid "c7e48b7b-9d32-58bb-b26a-4ddbb6993d92" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} - 5C_{4}$ and $C_{3}:=C_{3} + 3C_{4}$" :db/id 17592186160740} {:answer/id #uuid "267b2c2f-7e7b-5e9a-874a-20cae1bf2617" :answer/type {:db/ident :answer.type/text} :answer/value "$C_{1}:=C_{1} + 3C_{4}$ and $C_{3}:=C_{3} - 5C_{4}$" :db/id 17592186160741}] :answer-field/id #uuid "8fd571ca-3c1d-5127-9033-d39e92e39f85" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 1759218