[
  {
    "knowledge_point": {
      "db_id": 17592186124674,
      "id": "53776591-13cc-549e-9f32-c5abaeced1dc",
      "title": "Modeling Inhibited Growth"
    },
    "question": {
      ":question/id": "b116bcd6-ecf5-59fa-822c-ad5d56530bb4",
      ":question/problem": "A school administrator observed that the growth of the number of students enrolled in a program is directly proportional to the difference between the program’s maximum enrollment capacity and the current number of students enrolled. Let $S(t)$ be the number of students enrolled, measured in students, and let $t\\ge 0$ be the time in years. If the maximum number of students the program can support is $363$ students, which differential equation could be used to model the number of students enrolled in the program? Assume that $k>0$ is a constant of proportionality.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "455364ab-4546-502d-9a73-cc4e3e60b478",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "6457a583-5913-53aa-a72e-e7cb7fd9a808",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}S}{\\text{d}t}=-k(431-S)"
            },
            {
              ":answer/id": "ed500f79-5607-5427-befa-944d0404f65a",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}S}{\\text{d}t}=k(363-S)"
            },
            {
              ":answer/id": "022b4cf1-852a-560d-b618-060356148aeb",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}S}{\\text{d}t}=k(111-S)"
            },
            {
              ":answer/id": "c4f3eac4-8c56-5297-84fd-aced83adc690",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}S}{\\text{d}t}=-k(292+S)"
            },
            {
              ":answer/id": "662dbe85-f80b-5444-a557-cefe34723340",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}S}{\\text{d}t}=k(369-S)"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "ed500f79-5607-5427-befa-944d0404f65a"
          ]
        }
      ],
      ":question/difficulty": ":question.difficulty/easy",
      ":question/worked-solution": "The rate at which the number of students enrolled $S(t)$ in the program changes is proportional to the difference between the maximum number of students the program can support and the current number of students enrolled. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=k(a-S),\n$$\n\nwhere $a$ is the maximum number of students the program can support, and $k>0$ is a constant of proportionality.\n\nIn our case, $a=363\\text{ students},$ and we have\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=k(363-S).\n$$"
    },
