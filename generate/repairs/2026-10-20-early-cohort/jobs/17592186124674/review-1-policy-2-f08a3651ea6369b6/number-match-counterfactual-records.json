          ":answer-field/choices": [
            {
              ":answer/id": "769d800d-650e-5423-a8d3-551ee017d1f7",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}N}{\\text{d}t}=k(60-N)"
            },
            {
              ":answer/id": "f46888e6-c469-5911-b71f-89d5ed6a9c91",
