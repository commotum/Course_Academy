            {
              ":answer/id": "ca47c515-9f7e-5d32-b355-12681b3c57f8",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}N}{\\text{d}t}=k{N}^{2}(412-N)"
