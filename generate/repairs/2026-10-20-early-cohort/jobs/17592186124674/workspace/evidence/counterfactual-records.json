[
  {
    "knowledge_point": {
      "db_id": 17592186124674,
      "id": "53776591-13cc-549e-9f32-c5abaeced1dc",
      "title": "Modeling Inhibited Growth"
    },
    "question": {
      ":question/id": "af56a79c-d704-5a7b-bb90-6dd90345820d",
      ":question/problem": "A tutoring center currently has $10$ enrolled students. The number of students in the center $T(t)$ increases at a rate that obeys an inhibited growth model, where $t\\ge 0$ is the time in months. If the maximum capacity of the tutoring center is $95$ students, which differential equation could be used to model the student population of the center? Assume that $k>0$ is a constant of proportionality.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "5810ab4a-4dc3-5fa4-8812-e9a2135fb555",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "61fe1228-059e-502e-b20b-9bdf76c74e37",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}T}{\\text{d}t}=k(950-T)"
            },
            {
              ":answer/id": "11004cb2-ddf2-5b48-8e31-221884d85049",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}T}{\\text{d}t}=k(95-T)"
            },
            {
              ":answer/id": "565aa983-95d0-538d-9340-d354f0a965d9",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}T}{\\text{d}t}=k(100-T)"
            },
            {
              ":answer/id": "46545d16-80c6-5bb8-baf3-19c3c401e1cf",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}T}{\\text{d}t}=k(30-T)"
            },
            {
              ":answer/id": "8b364576-d615-5aa1-88f4-dee47687077e",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}T}{\\text{d}t}=k(60-T)"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "11004cb2-ddf2-5b48-8e31-221884d85049"
          ]
        }
      ],
      ":question/difficulty": ":question.difficulty/easy",
      ":question/worked-solution": "Since the number of students in the center obeys an inhibited growth model, the rate at which the number of students changes is proportional to the difference between the maximum capacity and the number of students in the center. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=k(a-T),\n$$\n\nwhere $a$ is the maximum capacity of the tutoring center, and $k>0$ is a constant of proportionality.\n\nIn our case, $a=95$ students, and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=k(95-T).\n$$"
    },
