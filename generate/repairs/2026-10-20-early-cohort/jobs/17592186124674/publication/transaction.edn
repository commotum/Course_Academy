-24c7-5adb-ab5b-40b569e8a676" :answer-field/type :answer-field.type/radio] [:db/add "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/choices "c84291f5-061a-557f-a30a-61f760e718be"] [:db/add "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/choices "21146af2-5811-55dc-806d-385ae7389530"] [:db/add "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/choices "b8161142-c7b3-5cc7-877f-cd3be70c5a7b"] [:db/add "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/choices "52185f51-7b2b-5a1f-8289-22e102dd8d47"] [:db/add "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/choices "ef261b24-85ae-5d42-8b83-24d63ccd2c37"] [:db/add "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/correct "52185f51-7b2b-5a1f-8289-22e102dd8d47"] [:db/ensure "8964b28f-24c7-5adb-ab5b-40b569e8a676" :answer-field/validate] [:db/add "d4e2b098-d563-5151-aa29-2eb6c6d7ccda" :question/id #uuid "d4e2b098-d563-5151-aa29-2eb6c6d7ccda"] [:db/add "d4e2b098-d563-5151-aa29-2eb6c6d7ccda" :question/problem "An engineer observed that the growth of the number of solar panels installed at a facility is directly proportional to the difference between the facility’s maximum number of solar panels and the current number installed. Let $P(t)$ be the number of solar panels, measured in panels, and let $t\\ge 0$ be the time in years. If the maximum number of solar panels the facility can support is $77$ panels, which differential equation could be used to model the number of solar panels installed? Assume that $k>0$ is a constant of proportionality."] [:db/add "d4e2b098-d563-5151-aa29-2eb6c6d7ccda" :question/worked-solution "The rate at which the number of solar panels $P(t)$ installed changes is proportional to the difference between the maximum number of solar panels the facility can support and the current number of solar panels. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=k(a-P),\n$$\n\nwhere $a$ is the maximum number of solar panels the facility can support, and $k>0$ is a constant of proportionality.\n\nIn our case, $a=77\\text{ panels},$ and we have\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=k(77-P).\n$$"] [:db/add "d4e2b098-d563-5151-aa29-2eb6c6d7ccda" :question/difficulty :question.difficulty/easy] [:db/add "d4e2b098-d563-5151-aa29-2eb6c6d7ccda" :question/answer-fields "8964b28f-24c7-5adb-ab5b-40b569e8a676"] [:db/ensure "d4e2b098-d563-5151-aa29-2eb6c6d7ccda" :question/validate] [:db/add 17592186124674 :knowledge-point/questions "d4e2b098-d563-5151-aa29-2eb6c6d7ccda"] [:db/add "3f1baecc-44a1-5f72-ab09-9cd717b2aa17" :answer/id #uuid "3f1baecc-44a1-5f72-ab09-9cd717b2aa17"] [:db/add "3f1baecc-44a1-5f72-ab09-9cd717b2aa17" :answer/type :answer.type/math] [:db/add "3f1baecc-44a1-5f72-ab09-9cd717b2aa17" :answer/value "\\frac{\\text{d}P}{\\text{d}t}=k(P-156)"] [:db/ensure "3f1baecc-44a1-5f72-ab09-9cd717b2aa17" :answer/validate] [:db/add "a6b9125a-b797-5012-84c0-7677861babcc" :answer/id #uuid "a6b9125a-b797-5012-84c0-7677861babcc"] [:db/add "a6b9125a-b797-5012-84c0-7677861babcc" :answer/type :answer.type/math] [:db/add "a6b9125a-b797-5012-84c0-7677861babcc" :answer/value "\\frac{\\text{d}P}{\\text{d}t}=k(156-P)"] [:db/ensure "a6b9125a-b797-5012-84c0-7677861babcc" :answer/validate] [:db/add "a8207f34-a886-5676-97a7-86d9906b6cea" :answer/id #uuid "a8207f34-a886-5676-97a7-86d9906b6cea"] [:db/add "a8207f34-a886-5676-97a7-86d9906b6cea" :answer/type :answer.type/math] [:db/add "a8207f34-a886-5676-97a7-86d9906b6cea" :answer/value "\\frac{\\text{d}P}{\\text{d}t}=k(202-P)"] [:db/ensure "a8207f34-a886-5676-97a7-86d9906b6cea" :answer/validate] [:db/add "a625ebea-06cc-5b3c-8122-12f1ba7b7493" :answer/id #uuid "a625ebea-06cc-5b3c-8122-12f1ba7b7493"] [:db/add "a625ebea-06cc-5b3c-8122-12f1ba7b7493" :answer/type :answer.type/math] [:db/add "a625ebea-06cc-5b3c-8122-12f1ba7b7493" :answer/value "\\frac{\\text{d}P}{\\text{d}t}=k(P-202)"] [:db/ensure "a625ebea-06cc-5b3c-8122-12f1ba7b7493" :answer/validate] [:db/add "fd1096c6-798b-5dee-b3be-0457fe09b40c" :answer/i