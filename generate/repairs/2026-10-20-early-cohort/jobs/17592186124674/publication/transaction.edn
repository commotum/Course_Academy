744f4936b4c" :answer-field/choices "cc7bb81f-16ec-5b16-aeff-f352e138bc9b"] [:db/add "d4787f96-44e5-5fbd-b936-b744f4936b4c" :answer-field/correct "cc7bb81f-16ec-5b16-aeff-f352e138bc9b"] [:db/ensure "d4787f96-44e5-5fbd-b936-b744f4936b4c" :answer-field/validate] [:db/add "2be35662-b24d-5c89-874e-5c3591e8d395" :question/id #uuid "2be35662-b24d-5c89-874e-5c3591e8d395"] [:db/add "2be35662-b24d-5c89-874e-5c3591e8d395" :question/problem "A factory's management noted that the growth of the unit production is directly proportional to the difference between the maximum number of units a factory worker can produce and the current production quantity. Let $P(t)$ be the production quantity, measured in units produced, and let $t\\ge 0$ be the time in days. If the maximum number of units that a worker can produce is $34$ $\\text{units}$, which differential equation could be used to model the factory's production? Assume that $k>0$ is a constant of proportionality."] [:db/add "2be35662-b24d-5c89-874e-5c3591e8d395" :question/worked-solution "The rate at which the production $P(t)$ of the factory changes is proportional to the difference between the maximum number of units a factory worker can produce and the current production quantity. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=k(a-P),\n$$\n\nwhere $a$ is the maximum number of units a factory worker can produce, and $k>0$ is a constant of proportionality.\n\nIn our case, $a=34\\text{ units},$ and we have\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=k(34-P).\n$$"] [:db/add "2be35662-b24d-5c89-874e-5c3591e8d395" :question/difficulty :question.difficulty/easy] [:db/add "2be35662-b24d-5c89-874e-5c3591e8d395" :question/answer-fields "d4787f96-44e5-5fbd-b936-b744f4936b4c"] [:db/ensure "2be35662-b24d-5c89-874e-5c3591e8d395" :question/validate] [:db/add 17592186124674 :knowledge-point/questions "2be35662-b24d-5c89-874e-5c3591e8d395"] [:db/add "4988d6b2-6cc8-58b8-937b-37187a3c0ccd" :answer/id #uuid "4988d6b2-6cc8-58b8-937b-37187a3c0ccd"] [:db/add "4988d6b2-6cc8-58b8-937b-37187a3c0ccd" :answer/type :answer.type/math] [:db/add "4988d6b2-6cc8-58b8-937b-37187a3c0ccd" :answer/value "\\frac{\\text{d}N}{\\text{d}t}=k(N-95)"] [:db/ensure "4988d6b2-6cc8-58b8-937b-37187a3c0ccd" :answer/validate] [:db/add "1bb9aec7-3fe0-5379-b3be-a5cced948ca5" :answer/id #uuid "1bb9aec7-3fe0-5379-b3be-a5cced948ca5"] [:db/add "1bb9aec7-3fe0-5379-b3be-a5cced948ca5" :answer/type :answer.type/math] [:db/add "1bb9aec7-3fe0-5379-b3be-a5cced948ca5" :answer/value "\\frac{\\text{d}N}{\\text{d}t}=k(N-58)"] [:db/ensure "1bb9aec7-3fe0-5379-b3be-a5cced948ca5" :answer/validate] [:db/add "e0e7cb22-1ac3-5509-bcc5-5a8cd2ed8e7b" :answer/id #uuid "e0e7cb22-1ac3-5509-bcc5-5a8cd2ed8e7b"] [:db/add "e0e7cb22-1ac3-5509-bcc5-5a8cd2ed8e7b" :answer/type :answer.type/math] [:db/add "e0e7cb22-1ac3-5509-bcc5-5a8cd2ed8e7b" :answer/value "\\frac{\\text{d}N}{\\text{d}t}=-k(58+N)"] [:db/ensure "e0e7cb22-1ac3-5509-bcc5-5a8cd2ed8e7b" :answer/validate] [:db/add "fd8932f3-6f63-564d-8f3a-a114cb7b2c2f" :answer/id #uuid "fd8932f3-6f63-564d-8f3a-a114cb7b2c2f"] [:db/add "fd8932f3-6f63-564d-8f3a-a114cb7b2c2f" :answer/type :answer.type/math] [:db/add "fd8932f3-6f63-564d-8f3a-a114cb7b2c2f" :answer/value "\\frac{\\text{d}N}{\\text{d}t}=k(58-N)"] [:db/ensure "fd8932f3-6f63-564d-8f3a-a114cb7b2c2f" :answer/validate] [:db/add "5651368d-8257-5fa4-83ce-3bee80076ba4" :answer/id #uuid "5651368d-8257-5fa4-83ce-3bee80076ba4"] [:db/add "5651368d-8257-5fa4-83ce-3bee80076ba4" :answer/type :answer.type/math] [:db/add "5651368d-8257-5fa4-83ce-3bee80076ba4" :answer/value "\\frac{\\text{d}N}{\\text{d}t}=k(95-N)"] [:db/ensure "5651368d-8257-5fa4-83ce-3bee80076ba4" :answer/validate] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/id #uuid "22b51cd9-5343-564b-8294-8af293032250"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/key "selection"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/type :answer-field.type/radio] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/choices "4988d6b2-6cc8-58b8-937b-37187a3c0ccd"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/choices "1bb9aec7-3fe0-5379-b3be-a5cced948ca5"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/choices "e0e7cb22-1ac3-5509-bcc5-5a8cd2ed8e7b"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/choices "fd8932f3-6f63-564d-8f3a-a114cb7b2c2f"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/choices "5651368d-8257-5fa4-83ce-3bee80076ba4"] [:db/add "22b51cd9-5343-564b-8294-8af293032250" :answer-field/correct "5651368d-8257-5fa4-83ce-3bee80076ba4"] [:db/ensure "22b51cd9-5343-564b-8294-8af293032250" :answer-field/validate] [:db/add "2667e815-917c-5f12-9c28-0d9309162349" :question/id #uuid "2667e815-917c-5f12-9c28-0d9309162349"] [:db/add "2667e815-917c-5f12-9c28-0d9309162349" :question/problem "A wildlife manager noted that the growth of the number of deer in a protected forest is directly proportional to the difference between the forest’s maximum deer population and the current population. Let $N(t)$ be the deer population, measured in number of deer, and let $t\\ge 0$ be the time in years. If the maximum deer population that the forest can support is $95$ deer, which differential equation could be used to model the forest’s deer population? Assume that $k>0$ is a constant of proportionality."] [:db/add "2667e815-917c-5f12-9c28-0d9309162349" :question/worked-solution "The rate at which the deer population $N(t)$ of the forest changes is proportional to the difference between the maximum deer population the forest can support and the current deer population. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}N}{\\text{d}t}=k(a-N),\n$$\n\nwhere $a$ is the maximum deer population the forest can support, and $k>0$ is a constant of proportionality.\n\nIn our case, $a=95\\text{ deer},$ and we have\n\n$$\n\\frac{\\text{d}N}{\\text{d}t}=k(95-N).\n$$"] [:db/add "2667e815-917c-5f12-9c28-0d9309162349" :question/difficulty :question.difficulty/easy] [:db/add "2667e815-917c-5f12-9c28-0d9309162349" :question/answer-fields "22b51cd9-5343-564b-8294-8af293032250"] [:db/ensure "2667e815-917c-5f12-9c28-0d9309162349" :question/validate] [:db/add 17592186124674 :knowledge-point/questions "2667e815-917c-5f12-9c28-0d9309162349"] [:db/add "generator" :question-generator/id #uuid "c2111404-0d78-5b8d-8e47-3d25ea16863c"] [:db/add "generator" :question-generator/script "generators/1a/1a1f9029ed7958a87ad7814fa3deebf614071fed95ff79c8d1e5bf6c7b0285dc/17592186124674.py"] [:db/add 17592186124674 :knowledge-point/question-generator "generator"] [:db/ensure 17592186124674 :knowledge-point/validate]]
