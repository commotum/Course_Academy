      "title": "Modeling Inhibited Growth"
    },
    "question": {
      ":question/id": "87141569-6717-56d7-8aa5-b890565a05fc",
      ":question/problem": "The growth of the number of deer in a protected forest is directly proportional to the difference between its maximum capacity and its current population. Let $N(t)$ be the number of deer, and let $t\\ge 0$ be the time in years. If the maximum capacity is $60$ deer, which differential equation models this population? Assume that $k>0$ is a constant of proportionality.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "f1e8c695-d376-53f4-b78d-e9f0c15f8c68",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "9e1fab19-9c41-53fe-b04f-e012cf5ed8eb",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}N}{\\text{d}t}=k(60-N)"
            },
            {
              ":answer/id": "f924cbf3-c5b8-52f0-bf7d-d33323d5d3ca",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}N}{\\text{d}t}=k(N-60)"
            },
            {
              ":answer/id": "ae3bb683-402b-52fd-8adc-0fccde960a5b",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}N}{\\text{d}t}=k(N-66)"
            },
            {
              ":answer/id": "dac97248-b185-589e-add6-fb14c800be16",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}N}{\\text{d}t}=kN(60-N)"
            },
            {
