    "question": {
      ":question/id": "81de6d5b-27af-5bb8-8c28-2dd11b0430b6",
      ":question/problem": "The growth of the number of cultures in a laboratory incubator is directly proportional to the difference between its maximum capacity and its current population. Let $B(t)$ be the number of cultures, and let $t\\ge 0$ be the time in days. If the maximum capacity is $452$ cultures, which differential equation models this population? Assume that $k>0$ is a constant of proportionality.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "2852a1e8-2925-54da-9817-4a406e5e99c1",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "e82a5c0a-e9aa-5d5e-aa06-30efb72ba990",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}B}{\\text{d}t}=kB(452-B)"
            },
            {
              ":answer/id": "601ede32-bf28-5b05-88df-83b608c48e9f",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}B}{\\text{d}t}=-k(452-B)"
            },
            {
              ":answer/id": "9a699607-71ef-505b-93fc-5a9a3fde04fb",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}B}{\\text{d}t}=k(452-B)"
            },
            {
              ":answer/id": "a25119fc-d0d1-5ed4-a709-e890bfa25a97",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{\\text{d}B}{\\text{d}t}=-k(452+B)"
