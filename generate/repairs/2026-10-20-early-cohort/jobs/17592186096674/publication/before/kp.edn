8 & 90 \\\\ 0 & 1 & 4 & 50 \\\\ 0 & 0 & 1 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-4){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 2 & 8 & 90 \\\\ 0 & 1 & 0 & 10 \\\\ 0 & 0 & 1 & 10\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-8){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 2 & 0 & 10 \\\\ 0 & 1 & 0 & 10 \\\\ 0 & 0 & 1 & 10\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -10 \\\\ 0 & 1 & 0 & 10 \\\\ 0 & 0 & 1 & 10\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x &=-10 \\\\ y &=10 \\\\ z &=10.\\end{aligned}\\right.\n$$\n\nSo, we have the solution $x=-10$, $y=10$, and $z=10.$ Or, in vector form $⟨-10,10,10⟩.$"} {:db/id #edb/ref 17592186288005 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3215ca92-c4e0-5002-b3c8-66b96dc6778d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 0 & 0 & 76 \\\\ 0 & 1 & 0 & 19 \\\\ 0 & 0 & 1 & -19\\end{bmatrix}" :db/id #edb/ref 17592186285242} {:answer/id #uuid "6b9f631d-06f9-545e-9bf2-c1eab306c717" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 0 & 0 & 76 \\\\ 0 & 1 & 0 & -19 \\\\ 0 & 0 & 1 & -19\\end{bmatrix}" :db/id #edb/ref 17592186285776} {:answer/id #uuid "7a7a3103-43f6-54df-9d5c-c93bfcf11f7c" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 0 & 0 & 76 \\\\ 0 & 1 & 0 & 19 \\\\ 0 & 0 & 1 & 19\\end{bmatrix}" :db/id #edb/ref 17592186285920} {:answer/id #uuid "9822bb48-3a3f-5e3a-bf03-64065192415c" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 0 & 0 & -76 \\\\ 0 & 1 & 0 & -19 \\\\ 0 & 0 & 1 & 19\\end{bmatrix}" :db/id #edb/ref 17592186286182} {:answer/id #uuid "ca7fbd3f-0afe-5586-b33a-f23ea98de501" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 0 & 0 & -76 \\\\ 0 & 1 & 0 & 19 \\\\ 0 & 0 & 1 & -19\\end{bmatrix}" :db/id #edb/ref 17592186286634}] :answer-field/correct {:answer/id #uuid "7a7a3103-43