y}{ccc|c}1 & 5 & 0 & 55 \\\\ 0 & 1 & 0 & 10 \\\\ 0 & 0 & 1 & 3\\end{array}\\right].\n$$\n\n$$\nR_{1}:=R_{1}-5R_{2},\\qquad M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 0 & 5 \\\\ 0 & 1 & 0 & 10 \\\\ 0 & 0 & 1 & 3\\end{array}\\right].\n$$"] [:db/add "3a955a91-3803-51cb-b81a-9b5dc9d57ef1" :question/difficulty :question.difficulty/easy] [:db/add "3a955a91-3803-51cb-b81a-9b5dc9d57ef1" :question/answer-fields "32b7d993-463a-594d-b6bb-bf979265f30a"] [:db/ensure "3a955a91-3803-51cb-b81a-9b5dc9d57ef1" :question/validate] [:db/add 17592186096674 :knowledge-point/questions "3a955a91-3803-51cb-b81a-9b5dc9d57ef1"] [:db/add "bfef7560-6c81-51e9-92a0-5beba6d41f73" :answer/id #uuid "bfef7560-6c81-51e9-92a0-5beba6d41f73"] [:db/add "bfef7560-6c81-51e9-92a0-5beba6d41f73" :answer/type :answer.type/math] [:db/add "bfef7560-6c81-51e9-92a0-5beba6d41f73" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 0 & 1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]"] [:db/ensure "bfef7560-6c81-51e9-92a0-5beba6d41f73" :answer/validate] [:db/add "8713155c-151f-5bf7-b7a5-7a0587f7ea13" :answer/id #uuid "8713155c-151f-5bf7-b7a5-7a0587f7ea13"] [:db/add "8713155c-151f-5bf7-b7a5-7a0587f7ea13" :answer/type :answer.type/math] [:db/add "8713155c-151f-5bf7-b7a5-7a0587f7ea13" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 0 & 2 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]"] [:db/ensure "8713155c-151f-5bf7-b7a5-7a0587f7ea13" :answer/validate] [:db/add "4145879a-2f11-5ccd-ae55-d2c7fd327de6" :answer/id #uuid "4145879a-2f11-5ccd-ae55-d2c7fd327de6"] [:db/add "4145879a-2f11-5ccd-ae55-d2c7fd327de6" :answer/type :answer.type/math] [:db/add "4145879a-2f11-5ccd-ae55-d2c7fd327de6" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 0 & 1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]"] [:db/ensure "4145879a-2f11-5ccd-ae55-d2c7fd327de6" :answer/validate] [:db/add "463c0fae-3cbf-5054-a5df-7f9d255515ca" :answer/id #uuid "463c0fae-3cbf-5054-a5df-7f9d255515ca"] [:db/add 