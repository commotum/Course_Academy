              ":answer/value": "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 0 & 5 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]"
            },
            {
