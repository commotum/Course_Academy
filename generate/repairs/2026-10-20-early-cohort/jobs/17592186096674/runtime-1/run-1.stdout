              ":answer/type": ":answer.type/math",
              ":answer/value": "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 0 & 5 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 9\\end{array}\\right]"
            },
            {
