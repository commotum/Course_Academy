              ":answer/type": ":answer.type/text",
              ":answer/value": "$$\nM\u223c\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & 0\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=0$"
            },
            {
              ":answer/id": "f00ae17c-61a2-56f6-b8f6-72c7b7e95a7e",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$$\nM\u223c\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-5$ and $y=-2$"
            },
            {
              ":answer/id": "a8b2d282-c6b8-54c3-8dbe-64f63c873a3e",
