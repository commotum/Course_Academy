f" :answer-field/id #uuid "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/key "selection"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/type :answer-field.type/radio] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/choices "ff066c3f-fe9e-57af-9a0e-b297d7c6b279"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/choices "0c5df759-5429-57c1-8988-5ccda4c7b53f"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/choices "d4699fbe-9aa4-5253-9880-a1604fd95b29"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/choices "7b1d861a-201b-59e0-8ebe-410f485f22d7"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/choices "289e2ffe-8f18-537c-a0e0-2c55bbd9348f"] [:db/add "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/correct "d4699fbe-9aa4-5253-9880-a1604fd95b29"] [:db/ensure "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f" :answer-field/validate] [:db/add "bce37014-02de-516a-b20e-2a6fdf141288" :question/id #uuid "bce37014-02de-516a-b20e-2a6fdf141288"] [:db/add "bce37014-02de-516a-b20e-2a6fdf141288" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y &=0 \\\\ 4x-7y &=-1.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [:db/add "bce37014-02de-516a-b20e-2a6fdf141288" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -4 & 0 \\\\ 4 & -7 & -1\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -4 & 0 \\\\ 4 & -7 & -1\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 0 \\\\ 4 & -7 & -1\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & 0 \\\\ 0 & 1 & -1\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=0 \\\\ y &=-1,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=-1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-1)=0\\,⇒\\,x=-2.\n$$\n\nThus, the solution is $x=-2$ and $y=-1.$"] [:db/add "bce37014-02de-516a-b20e-2a6fdf141288" :question/difficulty :question.difficulty/easy] [:db/add "bce37014-02de-516a-b20e-2a6fdf141288" :question/answer-fields "6667ad8a-8ce9-537f-a69c-3a1e5e867d9f"] [:db/ensure "bce37014-02de-516a-b20e-2a6fdf141288" :question/validate] [:db/add 17592186059776 :knowledge-point/questions "bce37014-02de-516a-b20e-2a6fdf141288"] [:db/add "700c9a27-3fb2-5def-a135-86689bc17624" :answer/id #uuid "700c9a27-3fb2-5def-a135-86689bc17624"] [:db/add "700c9a27-3fb2-5def-a135-86689bc17624" :answer/type :answer.type/math] [:db/add "700c9a27-3fb2-5def-a135-86689bc17624" :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 13 \\\\ 0 & 1 & -1\\end{array}\\right]"] [:db/ensure "700c9a27-3fb2-5def-a135-86689bc17624" :answer/validate] [:db/add "4ccfdb77-3ab1-5eaf-a9e8-c096b75cf1de" :answer/id #uuid "4ccfdb77-3ab1-5eaf-a9e8-c096b75cf1de"] [:db/add "4ccfdb77-3ab1-5eaf-a9e8-c096b75cf1de" :answer/type :answer.type/math] [:db/add "4ccfdb77-3ab1-5eaf-a9e8-c096b75cf1de" :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 13 \\\\ 0 & 1 & 0\\end{array}\\right]"] [:db/ensure "4ccfdb77-3ab1-5eaf-a9e8-c096b75cf1de" :answer/validate] [:db/add "58d98875-b850-5435-9fd7-5db1b4a649c8" :answer/id #uuid "58d98875-b850-5435-9fd7-5db1b4a649c8"] [:db/add "58d98875-b850-5435-9fd7-5db1b4a649c8" :answer/type :answer.type/math] [:db/add "58d98875-b850-5435-9fd7-5db1b4a649c8" :answer/value "M∼\\left[\\begin{array}{cc|c}1 & -3 & 13 \\\\ 0 & 1 & -3\\end{array}\\right]"] [:db/ensure "58d98875-b850-5435-9fd7-5db1b4a649c8" :answer/validate] [:db/add "7a3d49b7-a081-53b9-88f5-c99f54d4bb41" :answer/id #uuid "7a3d49b7-a081-53