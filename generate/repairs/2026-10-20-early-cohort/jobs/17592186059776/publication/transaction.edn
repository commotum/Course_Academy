[[:db/add "c86d7748-3086-56d2-8fe9-01a6c4561822" :answer/id #uuid "c86d7748-3086-56d2-8fe9-01a6c4561822"] [:db/add "c86d7748-3086-56d2-8fe9-01a6c4561822" :answer/type :answer.type/text] [:db/add "c86d7748-3086-56d2-8fe9-01a6c4561822" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & 0\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=0$"] [:db/ensure "c86d7748-3086-56d2-8fe9-01a6c4561822" :answer/validate] [:db/add "0b1a4873-bdf8-5a70-a7b2-5c4ad5b6ec5e" :answer/id #uuid "0b1a4873-bdf8-5a70-a7b2-5c4ad5b6ec5e"] [:db/add "0b1a4873-bdf8-5a70-a7b2-5c4ad5b6ec5e" :answer/type :answer.type/text] [:db/add "0b1a4873-bdf8-5a70-a7b2-5c4ad5b6ec5e" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & -1\\end{array}\\right],\n$$\n$\\,x=-3$ and $y=-1$"] [:db/ensure "0b1a4873-bdf8-5a70-a7b2-5c4ad5b6ec5e" :answer/validate] [:db/add "a0fae440-177b-584c-badd-9e3b7a78240e" :answer/id #uuid "a0fae440-177b-584c-badd-9e3b7a78240e"] [:db/add "a0fae440-177b-584c-badd-9e3b7a78240e" :answer/type :answer.type/text] [:db/add "a0fae440-177b-584c-badd-9e3b7a78240e" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & -2\\end{array}\\right],\n$$\n$\\,x=-5$ and $y=-2$"] [:db/ensure "a0fae440-177b-584c-badd-9e3b7a78240e" :answer/validate] [:db/add "bfdf73ed-2dc5-53c2-a7c1-643ba67f0f66" :answer/id #uuid "bfdf73ed-2dc5-53c2-a7c1-643ba67f0f66"] [:db/add "bfdf73ed-2dc5-53c2-a7c1-643ba67f0f66" :answer/type :answer.type/text] [:db/add "bfdf73ed-2dc5-53c2-a7c1-643ba67f0f66" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=3$ and $y=2$"] [:db/ensure "bfdf73ed-2dc5-53c2-a7c1-643ba67f0f66" :answer/validate] [:db/add "36f4a4b8-039e-5993-98a4-db034075b073" :answer/id #uuid "36f4a4b8-039e-5993-98a4-db034075b073"] [:db/add "36f4a4b8-039e-5993-98a4-db034075b073" :answer/type :answer.type/text] [:db/add "36f4a4b8-039e-5993-98a4-db034075b073" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & 1\\end{array}\\right],\n$$\n$\\,x=1$ and $y=1$"] [:db/ensure "36f4a4b8-039e-5993-98a4-db034075b073" :answer/validate] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/id #uuid "3b2f6b1d-6611-535a-8c2d-bb150971c102"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/key "selection"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/type :answer-field.type/radio] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/choices "c86d7748-3086-56d2-8fe9-01a6c4561822"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/choices "0b1a4873-bdf8-5a70-a7b2-5c4ad5b6ec5e"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/choices "a0fae440-177b-584c-badd-9e3b7a78240e"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/choices "bfdf73ed-2dc5-53c2-a7c1-643ba67f0f66"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/choices "36f4a4b8-039e-5993-98a4-db034075b073"] [:db/add "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/correct "36f4a4b8-039e-5993-98a4-db034075b073"] [:db/ensure "3b2f6b1d-6611-535a-8c2d-bb150971c102" :answer-field/validate] [:db/add "22f5a49d-093c-5c2d-bc11-d9f90e179350" :question/id #uuid "22f5a49d-093c-5c2d-bc11-d9f90e179350"] [:db/add "22f5a49d-093c-5c2d-bc11-d9f90e179350" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}2x-4y &=-2 \\\\ 4x-7y &=-3.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [:db/add "22f5a49d-093c-5c2d-bc11-d9f90e179350" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}2 & -4 & -2 \\\\ 4 & -7 & -3\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}2 & -4 & -2 \\\\ 4 & -7 & -3\\end{array}\\right] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 4 & -7 & -3\\end{array}\\right] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -2 & -1 \\\\ 0 & 1 & 1\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-2y &=-1 \\\\ y &=1,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=1$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(1)=-1\\,⇒\\,x=1.\n$$\n\nThus, the solution is $x=1$ and $y=1.$"] [:db/add "22f5a49d-093c-5c2d-bc11-d9f90e179350" :question/difficulty :question.difficulty/easy] [:db/add "22f5a49d-093c-5c2d-bc11-d9f90e179350" :question/answer-fields "3b2f6b1d-6611-535a-8c2d-bb150971c102"] [:db/ensure "22f5a49d-093c-5c2d-bc11-d9f90e179350" :question/validate] [:db/add 17592186059776 :knowledge-point/questions "22f5a49d-093c-5c2d-bc11-d9f90e179350"] [:db/add "b9c8c0c4-3637-54ba-860f-7bb82b897013" :answer/id #uuid "b9c8c0c4-3637-54ba-860f-7bb82b897013"] [:db/add "b9c8c0c4-3637-54ba-860f-7bb82b897013" :answer/type :answer.type/text] [:db/add "b9c8c0c4-3637-54ba-860f-7bb82b897013" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 1 & 4\\end{array}\\right],\n$$\n$\\,x=-1$ and $y=4$"] [:db/ensure "b9c8c0c4-3637-54ba-860f-7bb82b897013" :answer/validate] [:db/add "8850f3e9-6b29-55a4-9bc2-e85219be1e17" :answer/id #uuid "8850f3e9-6b29-55a4-9bc2-e85219be1e17"] [:db/add "8850f3e9-6b29-55a4-9bc2-e85219be1e17" :answer/type :answer.type/text] [:db/add "8850f3e9-6b29-55a4-9bc2-e85219be1e17" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 1 & 3\\end{array}\\right],\n$$\n$\\,x=-4$ and $y=3$"] [:db/ensure "8850f3e9-6b29-55a4-9bc2-e85219be1e17" :answer/validate] [:db/add "62a7abcd-39b7-5507-9487-b2c7cbc53469" :answer/id #uuid "62a7abcd-39b7-5507-9487-b2c7cbc53469"] [:db/add "62a7abcd-39b7-5507-9487-b2c7cbc53469" :answer/type :answer.type/text] [:db/add "62a7abcd-39b7-5507-9487-b2c7cbc53469" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 1 & 0\\end{array}\\right],\n$$\n$\\,x=-13$ and $y=0$"] [:db/ensure "62a7abcd-39b7-5507-9487-b2c7cbc53469" :answer/validate] [:db/add "4411a7a5-4d7b-5cf8-aea6-845c3438d9e4" :answer/id #uuid "4411a7a5-4d7b-5cf8-aea6-845c3438d9e4"] [:db/add "4411a7a5-4d7b-5cf8-aea6-845c3438d9e4" :answer/type :answer.type/text] [:db/add "4411a7a5-4d7b-5cf8-aea6-845c3438d9e4" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 1 & 2\\end{array}\\right],\n$$\n$\\,x=-7$ and $y=2$"] [:db/ensure "4411a7a5-4d7b-5cf8-aea6-845c3438d9e4" :answer/validate] [:db/add "6e43b947-26ac-524d-8851-1a66f3f5a9e3" :answer/id #uuid "6e43b947-26ac-524d-8851-1a66f3f5a9e3"] [:db/add "6e43b947-26ac-524d-8851-1a66f3f5a9e3" :answer/type :answer.type/text] [:db/add "6e43b947-26ac-524d-8851-1a66f3f5a9e3" :answer/value "$$\nM∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 1 & 1\\end{array}\\right],\n$$\n$\\,x=-10$ and $y=1$"] [:db/ensure "6e43b947-26ac-524d-8851-1a66f3f5a9e3" :answer/validate] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/id #uuid "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/key "selection"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/type :answer-field.type/radio] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/choices "b9c8c0c4-3637-54ba-860f-7bb82b897013"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/choices "8850f3e9-6b29-55a4-9bc2-e85219be1e17"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/choices "62a7abcd-39b7-5507-9487-b2c7cbc53469"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/choices "4411a7a5-4d7b-5cf8-aea6-845c3438d9e4"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/choices "6e43b947-26ac-524d-8851-1a66f3f5a9e3"] [:db/add "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/correct "b9c8c0c4-3637-54ba-860f-7bb82b897013"] [:db/ensure "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1" :answer-field/validate] [:db/add "41e257a6-c5ae-5b7a-8b67-a792cbbe038b" :question/id #uuid "41e257a6-c5ae-5b7a-8b67-a792cbbe038b"] [:db/add "41e257a6-c5ae-5b7a-8b67-a792cbbe038b" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-3y &=-13 \\\\ 2x+4y &=14.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [:db/add "41e257a6-c5ae-5b7a-8b67-a792cbbe038b" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 2 & 4 & 14\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 2 & 4 & 14\\end{array}\\right] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 10 & 40\\end{array}\\right] & {R}_{2} & :=\\frac{1}{10}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & -3 & -13 \\\\ 0 & 1 & 4\\end{array}\\right].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\left\\{\\begin{aligned}x-3y &=-13 \\\\ y &=4,\\end{aligned}\\right.\n$$\n\nand we can apply back substitution. The final equation $y=4$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-3(4)=-13\\,⇒\\,x=-1.\n$$\n\nTherefore, the solution is $x=-1$ and $y=4.$"] [:db/add "41e257a6-c5ae-5b7a-8b67-a792cbbe038b" :question/difficulty :question.difficulty/easy] [:db/add "41e257a6-c5ae-5b7a-8b67-a792cbbe038b" :question/answer-fields "4fa0bd2b-32b3-57bf-a15b-2085944fe8f1"] [:db/ensure "41e257a6-c5ae-5b7a-8b67-a792cbbe038b" :question/validate] [:db/add 17592186059776 :knowledge-point/questions "41e257a6-c5ae-5b7a-8b67-a792cbbe038b"] [:db/add "ff066c3f-fe9e-57af-9a0e-b297d7c6b279" :answer/id #uuid "ff066c3f-fe9e-57af-9a0e-b297d7c6b279"] [:db/add "ff066c3f-fe9e-57af-9a0e-b297d7c6b279" :answer/type :answer.ty