 :answer-field/choices "b92760d5-851f-5ab6-96a3-7fd3dc65b975"] [:db/add "aa6e8537-2201-532e-8fdb-82679aaa3f06" :answer-field/correct "b92760d5-851f-5ab6-96a3-7fd3dc65b975"] [:db/ensure "aa6e8537-2201-532e-8fdb-82679aaa3f06" :answer-field/validate] [:db/add "7495f74d-d174-524d-93f5-c13027b8d7be" :question/id #uuid "7495f74d-d174-524d-93f5-c13027b8d7be"] [:db/add "7495f74d-d174-524d-93f5-c13027b8d7be" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}4x+12y &=-40 \\\\ 5x+11y &=-34.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [:db/add "7495f74d-d174-524d-93f5-c13027b8d7be" :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\left[\\begin{array}{cc|c}4 & 12 & -40 \\\\ 5 & 11 & -34\\end{array}\\right].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\left[\\begin{array}{cc|c}4 & 12 & -40 \\\\ 5 & 11 & -34\\end{array}\\right] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -10 \\\\ 5 & 11 & -34\\end{array}\\right] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -10 \\\\ 0 & -4 & 16\\end{array}\\right] & {R}_{2} & :=-\\frac{1}{4}{R}_{2} \\\\  & ∼\\left[\\begin{array}{cc|c}1 & 3 & -10 \\\\ 0 & 1 & -4\\end{array}\\right].\\end{aligned}\n$$"] [:db/add "7495f74d-d174-524d-93f5-c13027b8d7be" :question/difficulty :question.difficulty/easy] [:db/add "7495f74d-d174-524d-93f5-c13027b8d7be" :question/answer-fields "aa6e8537-2201-532e-8fdb-82679aaa3f06"] [:db/ensure "7495f74d-d174-524d-93f5-c13027b8d7be" :question/validate] [:db/add 17592186059776 :knowledge-point/questions "7495f74d-d174-524d-93f5-c13027b8d7be"] [:db/add "generator" :question-generator/id #uuid "e025bb87-2266-559e-9a36-b57f24e7788b"] [:db/add "generator" :question-generator/script "generators/f2/f20c7bad1a8dc88a564dec180d6a117f42acef5a265d9816bf3774945beeb8b1/175