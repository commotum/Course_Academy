 \\\\ 6 & 8 & 12 \\\\ -7 & -8 & 4\\end{bmatrix}\n\\xrightarrow{R_{2}:=R_{2}-8R_{1}}\\begin{bmatrix}-6 & 1 & 4 \\\\ 54 & 0 & -20 \\\\ -7 & -8 & 4\\end{bmatrix}\n\\xrightarrow{R_{3}:=R_{3}+8R_{1}}\\begin{bmatrix}-6 & 1 & 4 \\\\ 54 & 0 & -20 \\\\ -55 & 0 & 36\\end{bmatrix}=B\n$$\n\nTherefore, the elementary row operations are\n\n$R_{2}:=R_{2}-8R_{1}$ and $R_{3}:=R_{3}+8R_{1}$."] [:db/add "8e675264-2c5d-5bcf-8354-77499d1aa442" :question/difficulty :question.difficulty/easy] [:db/add "8e675264-2c5d-5bcf-8354-77499d1aa442" :question/answer-fields "b06ff4ca-7660-56b5-a252-334e68f698e6"] [:db/ensure "8e675264-2c5d-5bcf-8354-77499d1aa442" :question/validate] [:db/add 17592186161967 :knowledge-point/questions "8e675264-2c5d-5bcf-8354-77499d1aa442"] [:db/add "2e3f87ff-e2c3-58b5-9d3b-2dd11b14310f" :answer/id #uuid "2e3f87ff-e2c3-58b5-9d3b-2dd11b14310f"] [:db/add "2e3f87ff-e2c3-58b5-9d3b-2dd11b14310f" :answer/type :answer.type/text] [:db/add "2e3f87ff-e2c3-58b5-9d3b-2dd11b14310f" :answer/value "$R_{2}:=R_{2}-R_{1}$ and $R_{3}:=R_{3}+4R_{1}$"] [:db/ensure "2e3f87ff-e2c3-58b5-9d3b-2dd11b14310f" :answer/validate] [:db/add "e2a99230-268a-50f2-985a-aae5f5b69022" :answer/id #uuid "e2a99230-268a-50f2-985a-aae5f5b69022"] [:db/add "e2a99230-268a-50f2-985a-aae5f5b69022" :answer/type :answer.type/text] [:db/add "e2a99230-268a-50f2-985a-aae5f5b69022" :answer/value "$R_{2}:=R_{2}+R_{1}$ and $R_{3}:=R_{3}+4R_{1}$"] [:db/ensure "e2a99230-268a-50f2-985a-aae5f5b69022" :answer/validate] [:db/add "cb813314-6b96-5320-b8ee-b25ca182d2e5" :answer/id #uuid "cb813314-6b96-5320-b8ee-b25ca182d2e5"] [:db/add "cb813314-6b96-5320-b8ee-b25ca182d2e5" :answer/type :answer.type/text] [:db/add "cb813314-6b96-5320-b8ee-b25ca182d2e5" :answer/value "$R_{2}:=R_{2}-R_{1}$ and $R_{3}:=R_{3}-4R_{1}$"] [:db/ensure "cb813314-6b96-5320-b8ee-b25ca182d2e5" :answer/validate] [:db/add "cace9511-7e3b-5f67-aae2-fedfa670999b" :answer/id #uuid "cace9511-7e3b-5f67-aae2-fedfa670999b"] [:db/add "cace9511-7e3b-5f67-aae2-fedfa670999b" 