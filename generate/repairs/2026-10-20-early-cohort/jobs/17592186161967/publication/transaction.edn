] [:db/add "8913954a-abf2-5cba-a2f3-cdac64ea6f71" :question/difficulty :question.difficulty/easy] [:db/add "8913954a-abf2-5cba-a2f3-cdac64ea6f71" :question/answer-fields "8dd8a445-5d0b-56c5-8773-4dc38aeda6f8"] [:db/ensure "8913954a-abf2-5cba-a2f3-cdac64ea6f71" :question/validate] [:db/add 17592186161967 :knowledge-point/questions "8913954a-abf2-5cba-a2f3-cdac64ea6f71"] [:db/add "723fa547-dbe4-5f86-9099-933fdc9da4bd" :answer/id #uuid "723fa547-dbe4-5f86-9099-933fdc9da4bd"] [:db/add "723fa547-dbe4-5f86-9099-933fdc9da4bd" :answer/type :answer.type/text] [:db/add "723fa547-dbe4-5f86-9099-933fdc9da4bd" :answer/value "$R_{2}:=R_{2}+8R_{1}$ and $R_{3}:=R_{3}-8R_{1}$"] [:db/ensure "723fa547-dbe4-5f86-9099-933fdc9da4bd" :answer/validate] [:db/add "22d6ce5d-342d-5026-8e99-a8e4954b7fc2" :answer/id #uuid "22d6ce5d-342d-5026-8e99-a8e4954b7fc2"] [:db/add "22d6ce5d-342d-5026-8e99-a8e4954b7fc2" :answer/type :answer.type/text] [:db/add "22d6ce5d-342d-5026-8e99-a8e4954b7fc2" :answer/value "$R_{2}:=R_{2}-8R_{1}$ and $R_{3}:=R_{3}+8R_{1}$"] [:db/ensure "22d6ce5d-342d-5026-8e99-a8e4954b7fc2" :answer/validate] [:db/add "654786f0-c6cf-527c-8bf8-5736a24e9c70" :answer/id #uuid "654786f0-c6cf-527c-8bf8-5736a24e9c70"] [:db/add "654786f0-c6cf-527c-8bf8-5736a24e9c70" :answer/type :answer.type/text] [:db/add "654786f0-c6cf-527c-8bf8-5736a24e9c70" :answer/value "$R_{2}:=R_{2}+8R_{1}$ and $R_{3}:=R_{3}+8R_{1}$"] [:db/ensure "654786f0-c6cf-527c-8bf8-5736a24e9c70" :answer/validate] [:db/add "34aa0bf3-e182-5bf0-9f00-ad5b8722cb12" :answer/id #uuid "34aa0bf3-e182-5bf0-9f00-ad5b8722cb12"] [:db/add "34aa0bf3-e182-5bf0-9f00-ad5b8722cb12" :answer/type :answer.type/text] [:db/add "34aa0bf3-e182-5bf0-9f00-ad5b8722cb12" :answer/value "$R_{2}:=R_{2}-8R_{1}$ and $R_{3}:=R_{3}-8R_{1}$"] [:db/ensure "34aa0bf3-e182-5bf0-9f00-ad5b8722cb12" :answer/validate] [:db/add "bbbd4eea-ab74-5e32-9584-bdec794f2ff9" :answer/id #uuid "bbbd4eea-ab74-5e32-9584-bdec794f2ff9"] [:db/add "bbbd4eea-ab74-5e32-9584-bdec794f2ff9" :answer