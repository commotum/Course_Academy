f-5c47-b280-b29ef9dcacec" :question/problem "Find the exact solution of the equation $7^{x+5}=20.$"] [:db/add "5c4943ae-854f-5c47-b280-b29ef9dcacec" :question/worked-solution "First, we take $\\log_{7}$ of both sides of the equation:\n\n$$\n\\begin{aligned}7^{x+5}&=20\\\\\\log_{7}(7^{x+5})&=\\log_{7}(20)\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b(b^c)=c$ to simplify the left-hand side. This gives:\n\n$$\nx+5=\\log_{7}(20).\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x+5&=\\log_{7}(20)\\\\x&=\\log_{7}(20)-5\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\log_{7}(20)-5$."] [:db/add "5c4943ae-854f-5c47-b280-b29ef9dcacec" :question/difficulty :question.difficulty/easy] [:db/add "5c4943ae-854f-5c47-b280-b29ef9dcacec" :question/answer-fields "0bf32041-f68d-5645-8e41-4a054e8a9a2f"] [:db/ensure "5c4943ae-854f-5c47-b280-b29ef9dcacec" :question/validate] [:db/add 17592186110593 :knowledge-point/questions "5c4943ae-854f-5c47-b280-b29ef9dcacec"] [:db/add "82daa7c3-9d37-5089-8dae-d710f8dd15ac" :answer/id #uuid "82daa7c3-9d37-5089-8dae-d710f8dd15ac"] [:db/add "82daa7c3-9d37-5089-8dae-d710f8dd15ac" :answer/type :answer.type/math] [:db/add "82daa7c3-9d37-5089-8dae-d710f8dd15ac" :answer/value "x=\\log_{3}(16)"] [:db/ensure "82daa7c3-9d37-5089-8dae-d710f8dd15ac" :answer/validate] [:db/add "d72339ad-ce21-57a4-b1a6-92b1794ce27b" :answer/id #uuid "d72339ad-ce21-57a4-b1a6-92b1794ce27b"] [:db/add "d72339ad-ce21-57a4-b1a6-92b1794ce27b" :answer/type :answer.type/math] [:db/add "d72339ad-ce21-57a4-b1a6-92b1794ce27b" :answer/value "x=\\log_{3}(11)"] [:db/ensure "d72339ad-ce21-57a4-b1a6-92b1794ce27b" :answer/validate] [:db/add "87650e62-518e-56e9-b7f5-54ae89d192b2" :answer/id #uuid "87650e62-518e-56e9-b7f5-54ae89d192b2"] [:db/add "87650e62-518e-56e9-b7f5-54ae89d192b2" :answer/type :answer.type/math] [:db/add "87650e62-518e-56e9-b7f5-54ae89d192b2" :answer/value "x=\\log_{9}(10)"] [:db/ensure "87650e62-518e-56e9-b7f5-54ae89d192b2" :answer/validate] [:db