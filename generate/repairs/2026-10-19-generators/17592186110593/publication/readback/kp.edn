#{[{:db/id #edb/ref 17592186110593 :knowledge-point/canonical-example {:db/id #edb/ref 17592186110494 :question/id #uuid "7c937587-dc81-5ee9-aa66-a509a87433e2" :question/math-academy-id "e-4067" :question/problem "Find the exact solution of the equation $2^{x+1}=3.$" :question/worked-solution "First, we take $\\log_2$ of both sides of the equation:\n\n$$\n\\begin{aligned}{2}^{x+1} & =3 \\\\ {log}_{2}⁡({2}^{x+1}) & ={log}_{2}⁡(3)\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b \\left( b^c \\right) = c$ to simplify the left-hand side. This gives\n\n$$\nx+1 = \\log_2 \\left( 3 \\right).\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x+1 & ={log}_{2}⁡(3) \\\\ x & ={log}_{2}⁡(3)-1\\end{aligned}\n$$\n\nTherefore, the solution is $x= \\log_2 \\left( 3 \\right) - 1.$"} :knowledge-point/id #uuid "34f4b65e-b93a-51e8-b943-b3b53d47fffb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048725 :topic/id #uuid "b8bf3ca3-98f8-5ec7-8c13-6f1988c58838" :topic/knowledge-points [{:db/id #edb/ref 17592186054781} {:db/id #edb/ref 17592186054782} {:db/id #edb/ref 17592186054783} {:db/id #edb/ref 17592186054784}] :topic/math-academy-id 65 :topic/next [{:db/id #edb/ref 17592186048671} {:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049986}] :topic/title "Solving One-Step Addition and Subtraction Equations"}] :knowledge-point/question-generator {:db/id #edb/ref 17592186655675 :question-generator/id #uuid "4b8231de-e247-5303-a70e-d37eb94134d9" :question-generator/script "generators/7e/7e9be724d650b526e887ebd0aca4d468f79ecb7ae9eae693ab6531d7348cf528/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186111048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd912690-9404-550b-aba4-589ca100a0a7" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\log_{3} (6) - 2" :db/id #edb/ref 17592186108047} {:answer/id #uuid "faffe04e-ba23-54cf-b9ac-8fad1be7c554" :answer/type {:db/ident :answer.type/math} :answer