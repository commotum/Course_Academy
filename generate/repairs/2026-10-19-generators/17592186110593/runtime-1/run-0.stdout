    "knowledge_point": {
      "db_id": 17592186110593,
      "id": "34f4b65e-b93a-51e8-b943-b3b53d47fffb",
      "title": "Finding Exact Solutions to Exponential Equations Using Logarithms"
    },
    "question": {
      ":question/id": "56dc4093-8769-53bf-b894-7ae077e1a075",
      ":question/difficulty": ":question.difficulty/easy",
      ":question/problem": "Find the exact solution of the equation $5^{x-2}=20.$",
      ":question/worked-solution": "First, we take $\\log_{5}$ of both sides of the equation:\n\n$$\n\\begin{aligned}5^{x-2}&=20\\\\\\log_{5}(5^{x-2})&=\\log_{5}(20)\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b(b^c)=c$ to simplify the left-hand side. This gives:\n\n$$\nx-2=\\log_{5}(20).\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-2&=\\log_{5}(20)\\\\x&=\\log_{5}(20)+2\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\log_{5}(20)+2$.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "8e594364-9624-55d3-b7f0-274b937cecd9",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
