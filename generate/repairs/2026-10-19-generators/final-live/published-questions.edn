#{[{:db/id #edb/ref 17592186655660 :knowledge-point/_questions [{:db/id #edb/ref 17592186110593 :knowledge-point/id #uuid "34f4b65e-b93a-51e8-b943-b3b53d47fffb" :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10bc9205-05dc-5109-86d3-766644bba1b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\log_{5}(20)+2" :db/id #edb/ref 17592186655642} {:answer/id #uuid "656c2561-23ae-578b-93a6-ada4db3ca262" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\log_{6}(20)+2" :db/id #edb/ref 17592186655652} {:answer/id #uuid "8f034615-0d9a-5afd-8b8f-c892030a731c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\log_{6}(24)-3" :db/id #edb/ref 17592186655661} {:answer/id #uuid "d0689f58-d64b-5ec3-8c75-8b469ecee346" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\log_{6}(24)+2" :db/id #edb/ref 17592186655668} {:answer/id #uuid "f1381e5d-e150-5938-9a74-6348c18dd2c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\log_{6}(24)+3" :db/id #edb/ref 17592186655673}] :answer-field/correct {:answer/id #uuid "10bc9205-05dc-5109-86d3-766644bba1b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\log_{5}(20)+2" :db/id #edb/ref 17592186655642} :answer-field/id #uuid "c9399b1a-3983-57ac-895e-34f484b8fe50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186655666}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bcda31d-628f-5bb0-87e5-685461ff59ea" :question/problem "Find the exact solution of the equation $5^{x-2}=20.$" :question/worked-solution "First, we take $\\log_{5}$ of both sides of the equation:\n\n$$\n\\begin{aligned}5^{x-2}&=20\\\\\\log_{5}(5^{x-2})&=\\log_{5}(20)\\end{aligned}\n$$\n\nNow, we use the fact that $\\log_b(b^c)=c$ to simplify the left-hand side. This gives:\n\n$$\nx-2=\\log_{5}(20).\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-2&=\\log_{5}(20)\\\\x&=\\log_{5}(20)+2\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\log_{5}(20)+2$."}] [{:db/id #edb/ref 17592186656355 :knowledge-point/_questions [{:db/id #edb/ref 17592186054622 :knowledge-point/id #uuid "4dc94edb-007d-5fe5-b9ca-9ed754adc457" :knowledge-point/title "Rewriting an Expression Using the Product and Power Rules of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31394b5a-0a89-50ee-a198-98ed5f8215e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186656331} {:answer/id #uuid "6070547e-e428-529e-a84b-1df9799fa82c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186656336} {:answer/id #uuid "8b536607-fa87-5ffd-8d2a-cbd2339f179b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186656345} {:answer/id #uuid "b78bd294-14c4-5e96-b82c-9bb5132bd072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186656350} {:answer/id #uuid "c6d5a6b7-ce02-5c4e-9888-7cb1f9950dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186656354}] :answer-field/correct {:answer/id #uuid "6070547e-e428-529e-a84b-1df9799fa82c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186656336} :answer-field/id #uuid "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186656341}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/problem "If $\\log_{10}\\left(y\\right)=6$ and $\\log_{10}\\left(x\\right)=-5$, then $\\log_{10}\\left(x^{3}y^{5}\\right)=$" :question/worked-solution "The laws of logarithms are:\n\n- $\\log_n(a)+\\log_n(b)=\\log_n(ab)$ - the product rule\n\n- $\\log_n(a)-\\log_n(b)=\\log_n(\\frac{a}{b})$ - the quotient rule\n\n- $\\log_n(c^m)=m\\log_n(c)$ - the power rule\n\nNote that $\\log_{10}\\left(x^{3}y^{5}\\right)$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}\\log_{10}\\left(x^{3}y^{5}\\right) &=\\log_{10}\\left(x^{3}\\right)+\\log_{10}\\left(y^{5}\\right) \\\\ &=3\\log_{10}\\left(x\\right)+5\\log_{10}\\left(y\\right)\\end{aligned}\n$$\n\nNow, since $\\log_{10}\\left(y\\right)=6$ and $\\log_{10}\\left(x\\right)=-5$, we conclude that\n\n$$\n3\\log_{10}\\left(x\\right)+5\\log_{10}\\left(y\\right)=3\\cdot (-5)+5\\cdot 6=15.\n$$\n\nTherefore,\n\n$$\n\\log_{10}\\left(x^{3}y^{5}\\right)=15.\n$$"}] [{:db/id #edb/ref 17592186655627 :knowledge-point/_questions [{:db/id #edb/ref 17592186087689 :knowledge-point/id #uuid "4d8c6c93-9d15-5482-8130-25bb9cabf008" :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe295dc-42be-5410-9879-ca4e8b0d06b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln(15)-9}{3}" :db/id #edb/ref 17592186655630}] :answer-field/correct {:answer/id #uuid "3fe295dc-42be-5410-9879-ca4e8b0d06b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln(15)-9}{3}" :db/id #edb/ref 17592186655630} :answer-field/id #uuid "2d88a33d-d45c-582d-8283-57add652b29b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186655628}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2173e1ab-fd0e-53d9-84cc-76ed56aa32a5" :question/problem "Find the **exact** solution of the equation $e^{3t+9}=15.$\n\n$t=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(\\ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}e^{3t+9}&=15 \\\\ \\ln(e^{3t+9})&=\\ln(15)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln(e^u)=u$ to simplify the left-hand side. This gives\n\n$$\n3t+9=\\ln(15).\n$$\n\nFinally, we solve for $t,$ as follows:\n\n$$\n\\begin{aligned}3t+9&=\\ln(15) \\\\ 3t&=\\ln(15)-9 \\\\ t&=\\frac{1}{3}\\left(\\ln(15)-9\\right) \\\\ t&=-3+\\frac{1}{3}\\ln(15)\\end{aligned}\n$$\n\nTherefore, the solution is $t=-3+\\frac{1}{3}\\ln(15).$"}]}
