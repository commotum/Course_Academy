academy-id "q-66590" :question/problem "Find the exact solution of the equation $e^{t} = 6$."} {:db/id #edb/ref 17592186088255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1ae6ed6-1773-5667-8a90-995b231bd3e0" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln (10) - 2)/(3)" :db/id #edb/ref 17592186086185} {:answer/id #uuid "f92fc296-c5a8-537f-ace5-dbcec0f6c222" :answer/type {:db/ident :answer.type/math} :answer/value "(2 - \\ln (10))/(3)" :db/id #edb/ref 17592186086186} {:answer/id #uuid "0f2c4ccf-75ec-5d36-ab27-b70ae54e29f5" :answer/type {:db/ident :answer.type/math} :answer/value "2 - \\ln (10)" :db/id #edb/ref 17592186086187} {:answer/id #uuid "24c98431-2c1f-5e18-b7a2-7aa468155362" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (10) - 2" :db/id #edb/ref 17592186086188} {:answer/id #uuid "39702368-9e5d-55cf-a1ef-6c5a235384ab" :answer/type {:db/ident :answer.type/math} :answer/value "6 - 3\\ln (10)" :db/id #edb/ref 17592186086189}] :answer-field/id #uuid "e9ebf692-2cd5-5dcc-983a-a7b211eecf44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086184}] :question/id #uuid "ebbad0b2-c71f-5884-ae51-5d0945e65a81" :question/math-academy-id "q-66595" :question/problem "If $e^{2 - 3x} = 10$ then $x =$"} {:db/id #edb/ref 17592186233027 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f297140b-f9f4-5397-9403-cc5c9d6b1ffc" :question/math-academy-id "q-100282" :question/problem "Find the exact solution of the equation ${e}^{t}=11.$" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{t} & =11 \\\\ \\operatorname{ln}({e}^{t}) & =\\operatorname{ln}(11)\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\nt=\\operatorname{ln}(11)\n$$\n\nTherefore, the solution is $t=\\operatorname{ln}(11).$"} {:db/id #edb/ref 17592186234220 :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "92f78b35-314c-56cd-8815-b47ddfe81b49" :question/math-academy-id "q-66963" :question/problem "What is the value of $x$ if ${e}^{2x+3}=\\sqrt[5]{7}?$" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{2x+3} & =\\sqrt[5]{7} \\\\ \\operatorname{ln}({e}^{2x+3}) & =\\operatorname{ln}(\\sqrt[5]{7})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n2x+3=\\operatorname{ln}(\\sqrt[5]{7})\n$$\n\nNext, we write $\\sqrt[5]{7}$ as ${7}^{1/5}.$ So, we get:\n\n$$\n2x+3=\\operatorname{ln}({7}^{1/5})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}2x+3 & =\\operatorname{ln}({7}^{1/5}) \\\\ 2x+3 & =\\frac{1}{5}\\operatorname{ln}(7) \\\\ 2x & =\\frac{1}{5}\\operatorname{ln}(7)-3 \\\\ x & =\\frac{1}{2}(\\frac{1}{5}\\operatorname{ln}(7)-3) \\\\ x & =\\frac{1}{10}\\operatorname{ln}7-\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{10}\\operatorname{ln}7-\\frac{3}{2}.$"} {:db/id #edb/ref 17592186546961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143cf35a-845a-521f-9117-ce3541756c04" :answer/type {:db/ident :answer.type/math} :answer/value "y=7-\\frac{1}{10}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546293} {:answer/id #uuid "63b2ed40-cb9c-56e8-a73c-1fb3a500de4b" :answer/type {:db/ident :answer.type/math} :answer/value "y=10+\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546470} {:answer/id #uuid "7f8797e5-9480-5a81-814e-1bfb99aec85f" :answer/type {:db/ident :answer.type/math} :answer/value "y=7-\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546536} {:answer/id #uuid "de0f44c4-a8d6-56ea-afc9-b58f1f9e5239" :answer/type {:db/ident :answer.type/math} :answer/value "y=1-\\frac{1}{10}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546741} {:answer/id #uuid "e7d5168f-0f24-5fcf-8392-ea9fd185e22d" :answer/type {:db/ident :answer.type/math} :answer/value "y=1+\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546770}] :answer-field/correct {:answer/id #uuid "7f8797e5-9480-5a81-814e-1bfb99aec85f" :answer/type {:db/ident :answer.type/math} :answer/value "y=7-\\frac{1}{7}\\operatorname{ln}⁡(10)" :db/id #edb/ref 17592186546536} :answer-field/id #uuid "4636930a-45e4-5386-a94d-82184908cb41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546855}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "06bb1232-0a8a-5e1c-9d8b-cb06e8535b98" :question/math-academy-id "q-100280" :question/problem "What is the value of $y$ if ${e}^{7-y}=\\sqrt[7]{10}?$" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{7-y} & =\\sqrt[7]{10} \\\\ \\operatorname{ln}⁡({e}^{7-y}) & =\\operatorname{ln}⁡(\\sqrt[7]{10})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n7-y=\\operatorname{ln}⁡(\\sqrt[7]{10})\n$$\n\nNext, we write $\\sqrt[7]{10}$ as ${10}^{1/7}.$ So, we get:\n\n$$\n7-y=\\operatorname{ln}⁡({10}^{1/7})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}7-y & =\\operatorname{ln}⁡({10}^{1/7}) \\\\ 7-y & =\\frac{1}{7}\\operatorname{ln}⁡(10) \\\\ -y & =\\frac{1}{7}\\operatorname{ln}⁡(10)-7 \\\\ y & =7-\\frac{1}{7}\\operatorname{ln}⁡(10)\\end{aligned}\n$$\n\nTherefore, the solution is $y=7-\\frac{1}{7}\\operatorname{ln}⁡(10).$"} {:db/id #edb/ref 17592186547056 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02492c1c-263a-53d5-a2ab-a44b808ad394" :answer/type {:db/ident :answer.type/math} :answer/value "y=3-\\frac{1}{14}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546257} {:answer/id #uuid "110732bb-df28-569e-8e30-9e1291e4a0dd" :answer/type {:db/ident :answer.type/math} :answer/value "y=5+\\frac{1}{7}\\operatorname{ln}⁡(4)" :db/id #edb/ref 17592186546284} {:answer/id #uuid "13714b98-7f8c-58e4-884c-b96dd8f0deff" :answer/type {:db/ident :answer.type/math} :answer/value "y=5-\\frac{1}{4}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546292} {:answer/id #uuid "4066d5e8-82e4-5526-876f-28005ec446fb" :answer/type {:db/ident :answer.type/math} :answer/value "y=5-\\frac{1}{4}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186546398} {:answer/id #uuid "e39eb702-bd3e-5d40-bf2a-84989610b7f7" :answer/type {:db/ident :answer.type/math} :answer/value "y=5+\\frac{1}{2}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546758}] :answer-field/correct {:answer/id #uuid "13714b98-7f8c-58e4-884c-b96dd8f0deff" :answer/type {:db/ident :answer.type/math} :answer/value "y=5-\\frac{1}{4}\\operatorname{ln}⁡(7)" :db/id #edb/ref 17592186546292} :answer-field/id #uuid "a12fa105-d919-568d-aa42-9d5dd1b4d2a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186546898}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "d0fb4c30-2477-5421-b3da-f8a97304168e" :question/math-academy-id "q-100276" :question/problem "What is the value of $y$ if ${e}^{5-y}=\\sqrt[4]{7}?$" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{5-y} & =\\sqrt[4]{7} \\\\ \\operatorname{ln}⁡({e}^{5-y}) & =\\operatorname{ln}⁡(\\sqrt[4]{7})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n5-y=\\operatorname{ln}⁡(\\sqrt[4]{7})\n$$\n\nNext, we write $\\sqrt[4]{7}$ as ${7}^{1/4}.$ So, we get:\n\n$$\n5-y=\\operatorname{ln}⁡({7}^{1/4})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}5-y & =\\operatorname{ln}⁡({7}^{1/4}) \\\\ 5-y & =\\frac{1}{4}\\operatorname{ln}⁡(7) \\\\ -y & =\\frac{1}{4}\\operatorname{ln}⁡(7)-5 \\\\ y & =5-\\frac{1}{4}\\operatorname{ln}⁡(7)\\end{aligned}\n$$\n\nTherefore, the solution is $y=5-\\frac{1}{4}\\operatorname{ln}⁡(7).$"} {:db/id #edb/ref 17592186601933 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8d3e896-ae85-59c3-ae5a-ea114672508e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4-\\ln(21)}{5}" :db/id #edb/ref 17592186601787}] :answer-field/correct {:answer/id #uuid "e8d3e896-ae85-59c3-ae5a-ea114672508e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4-\\ln(21)}{5}" :db/id #edb/ref 17592186601787} :answer-field/id #uuid "c6945d30-a88e-5f1a-9972-9bab12f14245" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186601869}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ba9070de-c707-5661-a14c-cac1b4371745" :question/math-academy-id "q-263058" :question/problem "Find the **exact** solution of the equation  ${e}^{4-5y}=21.$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{4-5y} & =21 \\\\ \\operatorname{ln}⁡({e}^{4-5y}) & =\\operatorname{ln}⁡(21)\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives\n\n$$\n4-5y=\\operatorname{ln}⁡(21).\n$$\n\nFinally, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4-5y & =\\operatorname{ln}⁡(21) \\\\ -5y & =\\operatorname{ln}⁡(21)-4 \\\\ y & =-\\frac{1}{5}(\\operatorname{ln}⁡(21)-4) \\\\ y & =\\frac{4}{5}-\\frac{1}{5}\\operatorname{ln}⁡(21)\\end{aligned}\n$$\n\nTherefore, the solution is $y=\\frac{4}{5}-\\frac{1}{5}\\operatorname{ln}⁡(21).$"} {:db/id #edb/ref 17592186655623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "977dc879-7c17-5a36-b2e3-e91bc3520255" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-7-\\ln(24)}{3}" :db/id #edb/ref 17592186655636}] :answer-field/correct {:answer/id #uuid "977dc879-7c17-5a36-b2e3-e91bc3520255" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-7-\\ln(24)}{3}" :db/id #edb/ref 17592186655636} :answer-field/id #uuid "900f6ed8-142b-5e76-bda0-cbbfbeaca9ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186655635}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "01270321-8636-5598-bf7d-e85808ad23b0" :question/problem "Find the **exact** solution of the equation $e^{-3y-7}=24.$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(\\ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}e^{-3y-7}&=24 \\\\ \\ln(e^{-3y-7})&=\\ln(24)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln(e^u)=u$ to simplify the left-hand side. This gives\n\n$$\n-3y-7=\\ln(24).\n$$\n\nFinally, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}-3y-7&=\\ln(24) \\\\ -3y&=\\ln(24)+7 \\\\ y&=\\frac{1}{-3}\\left(\\ln(24)+7\\right) \\\\ y&=-\\frac{7}{3}-\\frac{1}{3}\\ln(24)\\end{aligned}\n$$\n\nTherefore, the solution is $y=-\\frac{7}{3}-\\frac{1}{3}\\ln(24).$"} {:db/id #edb/ref 17592186655624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e9398dd-c94b-56d8-9bc6-4772b399fb19" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(25)-4}{4}" :db/id #edb/ref 17592186655634}] :answer-field/correct {:answer/id #uuid "8e9398dd-c94b-56d8-9bc6-4772b399fb19" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(25)-4}{4}" :db/id #edb/ref 17592186655634} :answer-field/id #uuid "38cacea6-d6f6-563e-be53-65ff3b067af4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186655629}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0d5857fb-0238-5a41-804e-93aaf70c5113" :question/problem "Find the **exact** solution of the equation $e^{4+4y}=25.$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(\\ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}e^{4+4y}&=25 \\\\ \\ln(e^{4+4y})&=\\ln(25)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln(e^u)=u$ to simplify the left-hand side. This gives\n\n$$\n4+4y=\\ln(25).\n$$\n\nFinally, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}4+4y&=\\ln(25) \\\\ 4y&=\\ln(25)-4 \\\\ y&=\\frac{1}{4}\\left(\\ln(25)-4\\right) \\\\ y&=-1+\\frac{1}{4}\\ln(25)\\end{aligned}\n$$\n\nTherefore, the solution is $y=-1+\\frac{1}{4}\\ln(25).$"} {:db/id #edb/ref 17592186655625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49c9950d-5415-5b47-8499-e4c25278d5ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(10)-3}{2}" :db/id #edb/ref 17592186655632}] :answer-field/correct {:answer/id #uuid "49c9950d-5415-5b47-8499-e4c25278d5ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(10)-3}{2}" :db/id #edb/ref 17592186655632} :answer-field/id #uuid "4585e6cc-0f8b-59e0-8f70-300fdb24aab2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186655631}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "116eef0d-fc21-56c3-88da-a38fa1536d37" :question/problem "Find the **exact** solution of the equation $e^{3+2y}=10.$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(\\ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}e^{3+2y}&=10 \\\\ \\ln(e^{3+2y})&=\\ln(10)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln(e^u)=u$ to simplify the left-hand side. This gives\n\n$$\n3+2y=\\ln(10).\n$$\n\nFinally, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}3+2y&=\\ln(10) \\\\ 2y&=\\ln(10)-3 \\\\ y&=\\frac{1}{2}\\left(\\ln(10)-3\\right) \\\\ y&=-\\frac{3}{2}+\\frac{1}{2}\\ln(10)\\end{aligned}\n$$\n\nTherefore, the solution is $y=-\\frac{3}{2}+\\frac{1}{2}\\ln(10).$"} {:db/id #edb/ref 17592186655627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe295dc-42be-5410-9879-ca4e8b0d06b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(15)-9}{3}" :db/id #edb/ref 17592186655630}] :answer-field/correct {:answer/id #uuid "3fe295dc-42be-5410-9879-ca4e8b0d06b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(15)-9}{3}" :db/id #edb/ref 17592186655630} :answer-field/id #uuid "2d88a33d-d45c-582d-8283-57add652b29b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186655628}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2173e1ab-fd0e-53d9-84cc-76ed56aa32a5" :question/problem "Find the **exact** solution of the equation $e^{3t+9}=15.$\n\n$t=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(\\ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}e^{3t+9}&=15 \\\\ \\ln(e^{3t+9})&=\\ln(15)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln(e^u)=u$ to simplify the left-hand side. This gives\n\n$$\n3t+9=\\ln(15).\n$$\n\nFinally, we solve for $t,$ as follows:\n\n$$\n\\begin{aligned}3t+9&=\\ln(15) \\\\ 3t&=\\ln(15)-9 \\\\ t&=\\frac{1}{3}\\left(\\ln(15)-9\\right) \\\\ t&=-3+\\frac{1}{3}\\ln(15)\\end{aligned}\n$$\n\nTherefore, the solution is $t=-3+\\frac{1}{3}\\ln(15).$"} {:db/id #edb/ref 17592186655637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69814916-fde3-5a92-a267-34531a131146" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(11)+9}{5}" :db/id #edb/ref 17592186655633}] :answer-field/correct {:answer/id #uuid "69814916-fde3-5a92-a267-34531a131146" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln(11)+9}{5}" :db/id #edb/ref 17592186655633} :answer-field/id #uuid "2113adec-9496-52e2-9fa0-ad2cda8f3357" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186655626}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f9755790-72b4-5435-8b21-7c99371dbf69" :question/problem "Find the **exact** solution of the equation $e^{5y-9}=11.$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we find the natural logarithm $(\\ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}e^{5y-9}&=11 \\\\ \\ln(e^{5y-9})&=\\ln(11)\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln(e^u)=u$ to simplify the left-hand side. This gives\n\n$$\n5y-9=\\ln(11).\n$$\n\nFinally, we solve for $y,$ as follows:\n\n$$\n\\begin{aligned}5y-9&=\\ln(11) \\\\ 5y&=\\ln(11)+9 \\\\ y&=\\frac{1}{5}\\left(\\ln(11)+9\\right) \\\\ y&=\\frac{9}{5}+\\frac{1}{5}\\ln(11)\\end{aligned}\n$$\n\nTherefore, the solution is $y=\\frac{9}{5}+\\frac{1}{5}\\ln(11).$"}] :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"}]}
