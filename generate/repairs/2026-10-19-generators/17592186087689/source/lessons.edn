#{[{:activity/expected-seconds 480.0 :activity/first-step {:db/id #edb/ref 17592186088508} :activity/id #uuid "42a5638e-ae95-59db-93c5-895568bf8257" :activity/scope {:db/id #edb/ref 17592186050649} :activity/steps [{:db/id #edb/ref 17592186088508 :step/content {:db/id #edb/ref 17592186088885 :tutorial/content "Suppose we are given an equation containing an exponential function, such as\n\n$$\ne^{t}= 12.\n$$\n\nWe can solve it in the same way that we usually solve exponential equations, by taking the log on both sides where the base of the logarithm is the base of the exponential.\n\nHere, the base of the exponential is $e,$ so we take the *natural* logarithm of both sides, since\n\n$$\n\\log_e{x} = \\ln{x}.\n$$\n\nTaking the natural logarithm of both sides, we have that\n\n$$\n\\begin{aligned}{e}^{t} & =12 \\\\ \\operatorname{ln}⁡({e}^{t}) & =\\operatorname{ln}⁡(12).\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln \\left( e^a \\right) = a$ to simplify the left-hand side. This gives\n\n$$\nt = \\ln (12).\n$$\n\nThis is the solution! We often present the solution of an exponential equation as an exact solution in logarithmic form." :tutorial/id #uuid "0f1cb099-7970-59ba-ad74-7052da9f2872" :tutorial/math-academy-id 2806 :tutorial/title "Introduction"} :step/id #uuid "3e65faf1-635c-5bbb-91ce-53b8a40b35a6" :step/math-academy-id 14672 :step/next {:db/id #edb/ref 17592186088509}} {:db/id #edb/ref 17592186088509 :step/content {:db/id #edb/ref 17592186087689 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087494 :question/id #uuid "5e22ac55-3e84-5cb4-8231-5f882da9240e" :question/math-academy-id "e-4103" :question/problem "What is the value of $x$ if $e^{x - 3}=2^5?$" :question/worked-solution "First, we take the natural logarithm $\\left(\\ln\\right)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{x-3} & ={2}^{5} \\\\ \\operatorname{ln}⁡({e}^{x-3}) & =\\operatorname{ln}⁡({2}^{5})\\end{aligned}\n$$\n\nNow, we use the fact that $\\ln \\left( e^a \\right) = a$ to simplify the left-hand side. This gives\n\n$$\nx-3 = \\ln \\left( 2^5 \\right).\n$$\n\nFinally, we solve for $x$ and rewrite the right-hand side using the power law of logarithms, as follows:\n\n$$\n\\begin{aligned}x-3 & =\\operatorname{ln}⁡({2}^{5}) \\\\ x & =\\operatorname{ln}⁡({2}^{5})+3 \\\\ x & =5\\operatorname{ln}⁡(2)+3\\end{aligned}\n$$\n\nTherefore, the solution is $x=5\\ln (2) + 3.$"} :knowledge-point/id #uuid "4d8c6c93-9d15-5482-8130-25bb9cabf008" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049053} {:db/id #edb/ref 17592186049589} {:db/id #edb/ref 17592186049879}] :knowledge-point/questions [{:db/id #edb/ref 17592186088253} {:db/id #edb/ref 17592186088255} {:db/id #edb/ref 17592186233027} {:db/id #edb/ref 17592186234220} {:db/id #edb/ref 17592186546961} {:db/id #edb/ref 17592186547056} {:db/id #edb/ref 17592186601933}] :knowledge-point/title "Finding Exact Solutions to Exponential Equations Using the Natural Logarithm"} :step/id #uuid "632071a8-82e8-5443-8212-3e2e2ffa7ee6" :step/math-academy-id 14673 :step/next {:db/id #edb/ref 17592186088510}} {:db/id #edb/ref 17592186088510 :step/content {:db/id #edb/ref 17592186087690 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087495 :question/id #uuid "ccf59ef2-a5dd-5a56-9af8-1878376dea16" :question/math-academy-id "e-4104" :question/problem "Find the solution to the equation $e^{2-4x} = 2$ rounded to $3$ decimal places." :question/worked-solution "First, we take the natural logarithm $(\\ln)$ of both sides of the equation and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{e}^{2-4x} & =2 \\\\ \\operatorname{ln}⁡({e}^{2-4x}) & =\\operatorname{ln}⁡(2) \\\\ 2-4x & =\\operatorname{ln}⁡(2) \\\\ -4x & =\\operatorname{ln}⁡(2)-2 \\\\ x & =\\frac{1}{2}-\\frac{\\operatorname{ln}⁡(2)}{4}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx  \\approx 0.327\n$$\n\nrounded to $3$ decimal places."} :knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/questions [{:db/id #edb/ref 17592186088254} {:db/id #edb/ref 17592186088264} {:db/id #edb/ref 17592186233646} {:db/id #edb/ref 17592186233696} {:db/id #edb/ref 17592186290441} {:db/id #edb/ref 17592186292617} {:db/id #edb/ref 17592186292618} {:db/id #edb/ref 17592186292619} {:db/id #edb/ref 17592186547080} {:db/id #edb/ref 17592186562427}] :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"} :step/id #uuid "81c5f02d-5078-5c6d-87e6-c8b57b026759" :step/math-academy-id 14675 :step/next {:db/id #edb/ref 17592186088511}} {:db/id #edb/ref 17592186088511 :step/content {:db/id #edb/ref 17592186087691 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087496 :question/id #uuid "12eedc57-11a6-540c-bdc9-bf5df777de60" :question/math-academy-id "e-4105" :question/problem "Given that $e^{x+1} + 1 = 3,$ what is the value of $x$?" :question/worked-solution "First, we isolate the exponential, as follows:\n\n$$\n\\begin{aligned}{e}^{x+1}+1 & =3 \\\\ {e}^{x+1} & =2\\end{aligned}\n$$\n\nThen, we find the natural logarithm $\\left(\\ln\\right)$ of both sides of the equation and solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{e}^{x+1} & =2 \\\\ \\operatorname{ln}⁡({e}^{x+1}) & =\\operatorname{ln}⁡(2) \\\\ x+1 & =\\operatorname{ln}⁡(2) \\\\ x & =\\operatorname{ln}⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $x =\\ln\\left(2\\right) -1.$"} :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/questions [{:db/id #edb/ref 17592186088256} {:db/id #edb/ref 17592186088263} {:db/id #edb/ref 17592186233028} {:db/id #edb/ref 17592186234217} {:db/id #edb/ref 17592186234218} {:db/id #edb/ref 17592186247135} {:db/id #edb/ref 17592186292626} {:db/id #edb/ref 17592186292627} {:db/id #edb/ref 17592186292628} {:db/id #edb/ref 17592186335918} {:db/id #edb/ref 17592186547019}] :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"} :step/id #uuid "f0ead52e-70c8-5090-85fd-195f595064bf" :step/math-academy-id 14676}] :activity/title "Solving Equations Containing the Exponential Function" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186087935}]}
