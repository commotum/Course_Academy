5"] [:db/add "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/choices "c6d5a6b7-ce02-5c4e-9888-7cb1f9950dba"] [:db/add "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/choices "b78bd294-14c4-5e96-b82c-9bb5132bd072"] [:db/add "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/choices "8b536607-fa87-5ffd-8d2a-cbd2339f179b"] [:db/add "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/choices "6070547e-e428-529e-a84b-1df9799fa82c"] [:db/add "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/correct "6070547e-e428-529e-a84b-1df9799fa82c"] [:db/ensure "7a715ff5-d21b-522c-a600-5e9414794bfb" :answer-field/validate] [:db/add "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/id #uuid "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d"] [:db/add "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/problem "If $\\log_{10}\\left(y\\right)=6$ and $\\log_{10}\\left(x\\right)=-5$, then $\\log_{10}\\left(x^{3}y^{5}\\right)=$"] [:db/add "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/worked-solution "The laws of logarithms are:\n\n- $\\log_n(a)+\\log_n(b)=\\log_n(ab)$ - the product rule\n\n- $\\log_n(a)-\\log_n(b)=\\log_n(\\frac{a}{b})$ - the quotient rule\n\n- $\\log_n(c^m)=m\\log_n(c)$ - the power rule\n\nNote that $\\log_{10}\\left(x^{3}y^{5}\\right)$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}\\log_{10}\\left(x^{3}y^{5}\\right) &=\\log_{10}\\left(x^{3}\\right)+\\log_{10}\\left(y^{5}\\right) \\\\ &=3\\log_{10}\\left(x\\right)+5\\log_{10}\\left(y\\right)\\end{aligned}\n$$\n\nNow, since $\\log_{10}\\left(y\\right)=6$ and $\\log_{10}\\left(x\\right)=-5$, we conclude that\n\n$$\n3\\log_{10}\\left(x\\right)+5\\log_{10}\\left(y\\right)=3\\cdot (-5)+5\\cdot 6=15.\n$$\n\nTherefore,\n\n$$\n\\log_{10}\\left(x^{3}y^{5}\\right)=15.\n$$"] [:db/add "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/difficulty :question.difficulty/hard] [:db/add "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/answer-fields "7a715ff5-d21b-522c-a600-5e9414794bfb"] [:db/ensure "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d" :question/validate] [:db/add 17592186054622 :knowledge-point/questions "dbf69bc5-72a9-5eeb-b7a8-7c8cd5feae2d"] [:db/add "1f35321b-ebb6-5b19-8034-e3adaf3e93c1" :answer/id #uuid "1f35321b-ebb6-5b19-8034-e3adaf3e93c1"] [:db/add "1f35321b-ebb6-5b19-8034-e3adaf3e93c1" :answer/type :answer.type/math] [:db/add "1f35321b-ebb6-5b19-8034-e3adaf3e93c1" :answer/value "k+15"] [:db/ensure "1f35321b-ebb6-5b19-8034-e3adaf3e93c1" :answer/validate] [:db/add "2d6fa17e-2ce8-5435-b086-2c5c2b2f576e" :answer/id #uuid "2d6fa17e-2ce8-5435-b086-2c5c2b2f576e"] [:db/add "2d6fa17e-2ce8-5435-b086-2c5c2b2f576e" :answer/type :answer.type/math] [:db/add "2d6fa17e-2ce8-5435-b086-2c5c2b2f576e" :answer/value "k+30"] [:db/ensure "2d6fa17e-2ce8-5435-b086-2c5c2b2f576e" :answer/validate] [:db/add "c623e038-ece1-5c3a-b8a1-6c63962d212f" :answer/id #uuid "c623e038-ece1-5c3a-b8a1-6c63962d212f"] [:db/add "c623e038-ece1-5c3a-b8a1-6c63962d212f" :answer/type :answer.type/math] [:db/add "c623e038-ece1-5c3a-b8a1-6c63962d212f" :answer/value "k+4"] [:db/ensure "c623e038-ece1-5c3a-b8a1-6c63962d212f" :answer/validate] [:db/add "eba6ce4e-9667-5721-9a14-4d9b87d68e93" :answer/id #uuid "eba6ce4e-9667-5721-9a14-4d9b87d68e93"] [:db/add "eba6ce4e-9667-5721-9a14-4d9b87d68e93" :answer/type :answer.type/math] [:db/add "eba6ce4e-9667-5721-9a14-4d9b87d68e93" :answer/value "k+12"] [:db/ensure "eba6ce4e-9667-5721-9a14-4d9b87d68e93" :answer/validate] [:db/add "7f1ec20a-1204-5bd9-811d-b421989c9e65" :answer/id #uuid "7f1ec20a-1204-5bd9-811d-b421989c9e65"] [:db/add "7f1ec20a-1204-5bd9-811d-b421989c9e65" :answer/type :answer.type/math] [:db/add "7f1ec20a-1204-5bd9-811d-b421989c9e65" :answer/value "k+25"] [:db/ensure "7f1ec20a-1204-5bd9-811d-b421989c9e65" :answer/validate] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/id #uuid "c2837859-88f8-5f3d-b770-7b6159f0de3b"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/key "selection"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/type :answer-field.type/radio] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/choices "1f35321b-ebb6-5b19-8034-e3adaf3e93c1"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/choices "2d6fa17e-2ce8-5435-b086-2c5c2b2f576e"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/choices "c623e038-ece1-5c3a-b8a1-6c63962d212f"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/choices "eba6ce4e-9667-5721-9a14-4d9b87d68e93"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/choices "7f1ec20a-1204-5bd9-811d-b421989c9e65"] [:db/add "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/correct "7f1ec20a-1204-5bd9-811d-b421989c9e65"] [:db/ensure "c2837859-88f8-5f3d-b770-7b6159f0de3b" :answer-field/validate] [:db/add "81ba7524-c55c-55c4-befa-65fc65e1d586" :question/id #uuid "81ba7524-c55c-55c4-befa-65fc65e1d586"] [:db/add "81ba7524-c55c-55c4-befa-65fc65e1d586" :question/problem "If $\\log_{3}\\left(y\\right)=k$ and $\\log_{3}\\left(x\\right)=5$, then $\\log_{3}\\left(x^{5}y\\right)=$"] [:db/add "81ba7524-c55c-55c4-befa-65fc65e1d586" :question/worked-solution "The laws of logarithms are:\n\n- $\\log_n(a)+\\log_n(b)=\\log_n(ab)$ - the product rule\n\n- $\\log_n(a)-\\log_n(b)=\\log_n(\\frac{a}{b})$ - the quotient rule\n\n- $\\log_n(c^m)=m\\log_n(c)$ - the power rule\n\nNote that $\\log_{3}\\left(x^{5}y\\right)$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}\\log_{3}\\left(x^{5}y\\right) &=\\log_{3}\\left(x^{5}\\right)+\\log_{3}\\left(y\\right) \\\\ &=5\\log_{3}\\left(x\\right)+\\log_{3}\\left(y\\right)\\end{aligned}\n$$\n\nNow, since $\\log_{3}\\left(y\\right)=k$ and $\\log_{3}\\left(x\\right)=5$, we conclude that\n\n$$\n5\\log_{3}\\left(x\\right)+\\log_{3}\\left(y\\right)=5\\cdot 5+k=k+25.\n$$\n\nTherefore,\n\n$$\n\\log_{3}\\left(x^{5}y\\right)=k+25.\n$$"] [:db/add "81ba7524-c55c-55c4-befa-65fc65e1d586" :question/difficulty :question.difficulty/hard] [:db/add "81ba7524-c55c-55c4-befa-65fc65e1d586" :question/answer-fields "c2837859-88f8-5f3d-b770-7b6159f0de3b"] [:db/ensure "81ba7524-c55c-55c4-befa-65fc65e1d586" :question/validate] [:db/add 17592186054622 :knowledge-point/questions "81ba7524-c55c-55c4-befa-65fc65e1d586"] [:db/add "76ece62c-ce60-569b-9a0e-3c322a1cf0b5" :answer/id #uuid "76ece62c-ce60-569b-9a0e-3c322a1cf0b5"] [:db/add "76ece62c-ce60-569b-9a0e-3c322a1cf0b5" :answer/type :answer.type/math] [:db/add "76ece62c-ce60-569b-9a0e-3c322a1cf0b5" :answer/value "6"] [:db/ensure "76ece62c-ce60-569b-9a0e-3c322a1cf0b5" :answer/validate] [:db/add "663d9a2e-6940-50df-bd10-d976166405db" :answer/id #uuid "663d9a2e-6940-50df-bd10-d976166405db"] [:db/add "663d9a2e-6940-50df-bd10-d976166405db" :answer/type :answer.type/math] [:db/add "663d9a2e-6940-50df-bd10-d976166405db" :answer/value "2"] [:db/ensure "663d9a2e-6940-50df-bd10-d976166405db" :answer/validate] [:db/add "0f65777d-80f7-5e88-a5e4-42ab702c4e06" :answer/id #uuid "0f65777d-80f7-5e88-a5e4-42ab702c4e06"] [:db/add "0f65777d-80f7-5e88-a5e4-42ab702c4e06" :answer/type :answer.type/math] [:db/add "0f65777d-80f7-5e88-a5e4-42ab702c4e06" :answer/value "-8"] [:db/ensure "0f65777d-80f7-5e88-a5e4-42ab702c4e06" :answer/validate] [:db/add "46624c46-3543-55f5-8f52-a8707e99b9b4" :answer/id #uuid "46624c46-3543-55f5-8f52-a8707e99b9b4"] [:db/add "46624c46-3543-55f5-8f52-a8707e99b9b4" :answer/type :answer.type/math] [:db/add "46624c46-3543-55f5-8f52-a8707e99b9b4" :answer/value "9"] [:db/ensure "46624c46-3543-55f5-8f52-a8707e99b9b4" :answer/validate] [:db/add "befe5896-389c-569b-b84d-45d2c3144414" :answer/id #uuid "befe5896-389c-569b-b84d-45d2c3144414"] [:db/add "befe5896-389c-569b-b84d-45d2c3144414" :answer/type :answer.type/math] [:db/add "befe5896-389c-569b-b84d-45d2c3144414" :answer/value "-14"] [:db/ensure "befe5896-389c-569b-b84d-45d2c3144414" :answer/validate] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/id #uuid "b59222b9-b874-5166-afe6-714c00276c20"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/key "selection"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/type :answer-field.type/radio] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/choices "76ece62c-ce60-569b-9a0e-3c322a1cf0b5"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/choices "663d9a2e-6940-50df-bd10-d976166405db"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/choices "0f65777d-80f7-5e88-a5e4-42ab702c4e06"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/choices "46624c46-3543-55f5-8f52-a8707e99b9b4"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/choices "befe5896-389c-569b-b84d-45d2c3144414"] [:db/add "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/correct "663d9a2e-6940-50df-bd10-d976166405db"] [:db/ensure "b59222b9-b874-5166-afe6-714c00276c20" :answer-field/validate] [:db/add "382ed20b-83b3-5caf-8ca1-a3baabb17216" :question/id #uuid "382ed20b-83b3-5caf-8ca1-a3baabb17216"] [:db/add "382ed20b-83b3-5caf-8ca1-a3baabb17216" :question/problem "If $\\log_{7}\\left(y\\right)=2$ and $\\log_{7}\\left(x\\right)=-2$, then $\\log_{7}\\left(x^{2}y^{3}\\right)=$"] [:db/add "382ed20b-83b3-5caf-8ca1-a3baabb17216" :question/worked-solution "The laws of logarithms are:\n\n- $\\log_n(a)+\\log_n(b)=\\log_n(ab)$ - the product rule\n\n- $\\log_n(a)-\\log_n(b)=\\log_n(\\frac{a}{b})$ - the quotient rule\n\n- $\\log_n(c^m)=m\\log_n(c)$ - the power rule\n\nNote that $\\log_{7}\\left(x^{2}y^{3}\\right)$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}\\log_{7}\\left(x^{2}y^{3}\\right) &=\\log_{7}\\left(x^{2}\\right)+\\log_{7}\\left(y^{3}\\right) \\\\ &=2\\log_{7}\\left(x\\right)+3\\log_{7}\\left(y\\right)\\end{aligned}\n$$\n\nNow, since $\\log_{7}\\left(y\\right)=2$ and $\\log_{7}\\left(x\\right)=-2$, we conclude that\n\n$$\n2\\log_{7}\\left(x\\right)+3\\log_{7}\\left(y\\right)=2\\cdot (-2)+3\\cdot 2=2.\n$$\n\nTherefore,\n\n$$\n\\log_{7}\\left(x^{2}y^{3}\\right)=2.\n$$"] [:db/add "382ed20b-83b3-5caf-8ca1-a3baabb17216" :question/difficulty :question.difficulty/hard] [:db/add "382ed20b-83b3-5caf-8ca1-a3baabb17216" :question/answer-fields "b59222b9-b874-5166-afe6-714c00276c20"] [:db/ensure "382ed20b-83b3-5caf-8ca1-a3baabb17216" :question/validate] [:db/add 17592186054622 :knowledge-point/questions "382ed20b-83b3-5caf-8ca1-a3baabb17216"] [:db/add "926b2305-5427-5cb4-bd90-523bbf663857" :answer/id #uuid "926b2305-5427-5cb4-bd90-523bbf663857"] [:db/add "926b2305-5427-5cb4-bd90-523bbf663857" :answer/type :answer.type/math] [:db/add "926b2305-5427-5cb4-bd90-523bbf663857" :answer/value "22"] [:db/ensure "926b2305-5427-5cb4-bd90-523bbf663857" :answer/validate] [:db/add "02672d6a-6b09-5256-a2a9-8c433d6cf9eb" :answer/id #uuid "02672d6a-6b09-5256-a2a9-8c433d6cf9eb"] [:db/add "02672d6a-6b09-5256-a2a9-8c433d6cf9eb" :answer/type :answer.type/math] [:db/add "02672d6a-6b09-5256-a2a9-8c433d6cf9eb" :answer/value "40"] [:db/ensure "02672d6a-6b09-5256-a2a9-8c433d6cf9eb" :answer/validate] [:db/add "15a2f4e5-6249-5bd1-be1a-c260c42fad17" :answer/id #uuid "15a2f4e5-6249-5bd1-be1a-c260c42fad17"] [:db/add "15a2f4e5-6249-5bd1-be1a-c260c42fad17" :answer/type :answer.type/math] [:db/add "15a2f4e5-6249-5bd1-be1a-c260c42fad17" :answer/value "29"] [:db/ensure "15a2f4e5-6249-5bd1-be1a-c260c42fad17" :answer/validate] [:db/add "f31c7c54-b5ce-5646-a6f2-42af59004b6f" :answer/id #uuid "f31c7c54-b5ce-5646-a6f2-42af59004b6f"] [:db/add "f31c7c54-b5ce-5646-a6f2-42af59004b6f" :answer/type :answer.type/math] [:db/add "f31c7c54-b5ce-5646-a6f2-42af59004b6f" :answer/value "23"] [:db/ensure "f31c7c54-b5ce-5646-a6f2-42af59004b6f" :answer/validate] [:db/add "76535ebc-b6b2-5fab-bce3-525acccc81b7" :answer/id #uuid "76535ebc-b6b2-5fab-bce3-525acccc81b7"] [:db/add "76535ebc-b6b2-5fab-bce3-525acccc81b7" :answer/type :answer.type/math] [:db/add "76535ebc-b6b2-5fab-bce3-525acccc81b7" :answer/value "34"] [:db/ensure "76535ebc-b6b2-5fab-bce3-525acccc81b7" :answer/val