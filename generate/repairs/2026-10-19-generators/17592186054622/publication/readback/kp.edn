#{[{:db/id #edb/ref 17592186054622 :knowledge-point/canonical-example {:db/id #edb/ref 17592186054537 :question/id #uuid "5a566673-4529-57b8-87c9-d5a6118e0398" :question/math-academy-id "e-4082" :question/problem "Express $\\log(3)+4\\log(y)$ as a single logarithm." :question/worked-solution "Using the power rule for logarithms, we can rewrite the second term to obtain\n\n$$\n\\log(3)+4\\log(y)=\\log(3)+\\log(y^4).\n$$\n\nNow, using the product rule for logarithms, we can combine the two terms to get\n\n$$\n\\log(3)+\\log(y^4)=\\log\\left(3y^4\\right).\n$$\n\nTherefore,\n\n$$\n\\log(3)+4\\log(y)=\\log\\left(3y^4\\right).\n$$"} :knowledge-point/id #uuid "4dc94edb-007d-5fe5-b9ca-9ed754adc457" :knowledge-point/question-generator {:db/id #edb/ref 17592186656359 :question-generator/id #uuid "33a4cdc9-e943-50f2-abcd-36b03a740756" :question-generator/script "generators/ea/ea5bf4c583efd1a855456476011fb40fd7bca88355902fc4c7a666a189b4df9f/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186055334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "836b26c6-e71f-567d-8221-8c62a7c0b563" :answer/type {:db/ident :answer.type/math} :answer/value "\\log (5 + 3p)" :db/id #edb/ref 17592186053242} {:answer/id #uuid "bbd90f34-5cd8-524c-afb3-57baf8d9e332" :answer/type {:db/ident :answer.type/math} :answer/value "\\log (5) + 3\\log (p)" :db/id #edb/ref 17592186053243} {:answer/id #uuid "e497610b-8dfc-561a-8ab1-ff1625b83c48" :answer/type {:db/ident :answer.type/math} :answer/value "3\\log (5)\\log (p)" :db/id #edb/ref 17592186053244} {:answer/id #uuid "0af93dca-9ea9-554b-be8a-ab21b2baa2b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\log (5 + p^{3})" :db/id #edb/ref 17592186053245} {:answer/id #uuid "276cfea8-c055-59b5-b36c-fde052bc3775" :answer/type {:db/ident :answer.type/math} :answer/value "\\log (5) + p\\log (3)" :db/id #edb/ref 17592186053246}] :answer-field/id #uuid "f3f48f5c-1442-59d4-b822-da365c027d68" :answer-field/key "selection" :