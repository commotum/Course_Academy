{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "accepted",
        "revise",
        "unsupported"
      ]
    },
    "summary": {
      "type": "string"
    },
    "source_analysis": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string"
        },
        "reasoning_steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required learner choices, recall, inference and calculation before feedback, independently reconstructed from target evidence."
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permitted_variations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "skill",
        "reasoning_steps",
        "invariants",
        "permitted_variations",
        "source_refs",
        "evidence_paths"
      ],
      "additionalProperties": false,
      "description": "Final substantive account. Accepted reviews cite preserved source-analysis.json with these same five substantive fields. If revised, also cite source-analysis-amendments.json binding initial_sha256, final_source_analysis and justified evidence-linked amendments; do not overwrite the initial account."
    },
    "checks": {
      "type": "object",
      "properties": {
        "source_replay": {
          "$ref": "#/$defs/check"
        },
        "math": {
          "$ref": "#/$defs/check"
        },
        "variety": {
          "$ref": "#/$defs/check"
        },
        "scope": {
          "$ref": "#/$defs/check"
        },
        "grading": {
          "$ref": "#/$defs/check"
        },
        "rendering": {
          "$ref": "#/$defs/check"
        },
        "packaging": {
          "$ref": "#/$defs/check"
        },
        "decision_variation": {
          "$ref": "#/$defs/check"
        },
        "progression": {
          "$ref": "#/$defs/check"
        }
      },
      "required": [
        "source_replay",
        "math",
        "variety",
        "scope",
        "grading",
        "rendering",
        "packaging",
        "decision_variation",
        "progression"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "restriction",
              "drift",
              "math",
              "grading",
              "rendering",
              "source_fidelity",
              "packaging",
              "evidence",
              "decision_shortcut",
              "inventory"
            ]
          },
          "description": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reproduction": {
            "type": "string"
          },
          "requested_change": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "description",
          "source_refs",
          "reproduction",
          "requested_change"
        ],
        "additionalProperties": false
      }
    },
    "band_verification": {
      "type": "object",
      "properties": {
        "easy": {
          "$ref": "#/$defs/band_verification"
        },
        "moderate": {
          "$ref": "#/$defs/band_verification"
        },
        "hard": {
          "$ref": "#/$defs/band_verification"
        }
      },
      "required": [
        "easy",
        "moderate",
        "hard"
      ],
      "additionalProperties": false,
      "description": "All three final bands. Each cites matching final-batch delivery evidence plus recognized grading and rendering reports on actual raw or delivered final records; representative coverage must be justified by the reviewer."
    }
  },
  "required": [
    "verdict",
    "summary",
    "source_analysis",
    "checks",
    "findings",
    "band_verification"
  ],
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Root-relative nonempty evidence. Accepted grading/rendering checks cite recognized native-grader/renderer reports; decision_variation links a recognized delivery report. Formal evidence validity does not establish pedagogical truth."
        },
        "details": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "evidence_paths",
        "details"
      ],
      "additionalProperties": false
    },
    "band_verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "batch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "batch_sha256",
        "evidence_paths",
        "details"
      ],
      "additionalProperties": false
    }
  }
}
