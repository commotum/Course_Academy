{
  "type": "object",
  "properties": {
    "learner_operation": {
      "type": "string",
      "minLength": 1
    },
    "fixed_features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "feature",
          "justification"
        ],
        "additionalProperties": false
      }
    },
    "answer_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "eligible_variation": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "eligible_variation",
          "observed"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case": {
            "type": "string",
            "minLength": 1
          },
          "sample_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case",
          "sample_refs",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "counterfactuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "relevant",
              "irrelevant"
            ]
          },
          "change": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_applicable"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "sample_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "kind",
          "change",
          "expected",
          "observed",
          "status",
          "justification",
          "sample_refs"
        ],
        "additionalProperties": false
      }
    },
    "shortcut_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "cue": {
            "type": "string",
            "minLength": 1
          },
          "subgroup": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "overall",
              "within_template",
              "other_recognizable_subgroup"
            ]
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "correct": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 1
          },
          "baseline": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "disposition": {
            "enum": [
              "not_predictive",
              "intended_skill",
              "defect"
            ]
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "sample_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "cue",
          "subgroup",
          "scope",
          "strategy",
          "correct",
          "total",
          "baseline",
          "disposition",
          "conclusion",
          "sample_refs"
        ],
        "additionalProperties": false
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "stages_examined": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "sample_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stages_examined",
        "sample_refs",
        "result"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "learner_operation",
    "fixed_features",
    "answer_roles",
    "coverage",
    "counterfactuals",
    "shortcut_probes",
    "delivery",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
