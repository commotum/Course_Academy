{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Move Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_text",
    "core_move",
    "recognition_cue",
    "target_output",
    "prerequisite_floor",
    "failure_modes",
    "variant_axes"
  ],
  "properties": {
    "problem_text": { "type": "string", "minLength": 1 },
    "correct_answer": { "type": "string" },
    "core_move": { "type": "string", "minLength": 1 },
    "recognition_cue": { "type": "string", "minLength": 1 },
    "target_output": { "type": "string", "minLength": 1 },
    "given_structure": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prerequisite_floor": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "variant_axes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
