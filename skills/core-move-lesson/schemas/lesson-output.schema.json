{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core Move Lesson Output Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "has_table_of_contents",
    "has_prerequisites",
    "section_count",
    "quiz_block_count",
    "validated"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "has_table_of_contents": { "type": "boolean", "const": true },
    "has_prerequisites": { "type": "boolean", "const": true },
    "section_count": { "type": "integer", "minimum": 2 },
    "quiz_block_count": { "type": "integer", "minimum": 1 },
    "validated": { "type": "boolean", "const": true },
    "validation_command": { "type": "string" },
    "notes": { "type": "string" }
  }
}
