// Current queue reading and observation storage, traced 2026-10-10.
// Scope: page observations and their interpretation. Ranking, choosing, and starting
// an activity are separate components and are not drawn here.
// Sources, relative to Course_Academy/capture/v2/:
// ../../scripts/question_capture/browser.py: EXTRACT_QUEUE, CaptureBrowser.queue
// ../../scripts/question_capture/dashboard.py: EXTRACT_STATS, record
// ../../scripts/question_capture/core.py: assessment_requirement
// ../../scripts/question_capture/retry_policy.py: update_policy
// ../../scripts/question_capture/capture.py: observe_queue
// Render: dot -Tsvg 1-queue-processing.dots -o 1-queue-processing.svg
// Solid arrows show reading order; dotted arrows connect data with stored records.
// dashboard.record writes before queue-card expansion. Browser.queue returns the
// queue in memory; observe_queue writes selection/queue.json and journal.jsonl AFTER
// selecting an activity. The chart shows only the observation fields of those files.
// Their selected, priority_scores, unranked_topics, and reassigned_lessons fields
// belong to the later comparison/selection component, not this diagram.
// Page selectors: #coursePercentComplete; a#courseNameLink / a.courseNameLink;
// #completedTasks .taskCompleted; visible #incompleteTasks .taskUnlocked.
// Completed Lesson/Review outcome extraction requires task/topic IDs and signed XP
// before a slash. The dashboard accepts either an earned/base pair or a single award.
// Diagnostic/Multistep expansion depends on a missing href, not Start-button visibility.
// Assessment expansion skips in-progress cards. All queue rows remain in page order;
// unsupported/in-progress records are retained, not filtered out here.

digraph QueueProcessing {
  graph [label="1. Read and record the queue\nWhat the capture script learns from Math Academy's activity page",
    labelloc=t, labeljust=l, fontname="DejaVu Sans", fontsize=23,
    bgcolor="white", rankdir=TB, nodesep=0.40, ranksep=0.52,
    pad=0.35, splines=polyline, outputorder=edgesfirst, newrank=true];
  node [shape=box, style=filled, fillcolor="#f3f4f6", color="#374151",
    fontcolor="#111827", fontname="DejaVu Sans", fontsize=13,
    margin="0.18,0.13", penwidth=1.1];
  edge [color="#64748b", arrowsize=0.7, penwidth=1.1,
    fontname="DejaVu Sans", fontsize=10, fontcolor="#475569"];

  Open [label="Open this account's activity page\nWait for the queue to load",
    fillcolor="#111827", fontcolor=white, fontsize=15];

  subgraph cluster_overview {
    label="Read the course summary and completed activities";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    Overview [label="Read the course completion percentage\nand the link identifying the current course"];
    Completed [label="Read the completed activities already shown on the page\nActivity name, type, Math Academy ID, date/time shown, and XP\nThese cards are read without expanding them"];
    Totals [label="Update today's XP totals and activity counts\nKeep a list of the 20 most recent recorded activities",
      fillcolor="#dbeafe", URL="../../scripts/question_capture/dashboard.py"];
    Outcomes [label="Also collect completed lesson/review results\nActivity ID, topic ID, and XP earned\nRemember any negative XP for the repeat-activity record"];
    Overview -> Completed -> Totals -> Outcomes;
  }
  Open -> Overview;

  subgraph cluster_cards {
    label="Read the unfinished activities";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    FirstRead [label="Read the visible, unlocked cards in page order\nCheck each activity's type, Start link, and progress",
      URL="../../scripts/question_capture/browser.py"];
    Lessons [label="Lessons and reviews\nLeave their cards as they are\nThe queue reader does not expand them", fillcolor="#eef2ff"];
    Tests [label="Assessments / quizzes\nIf unstarted and the details are closed, expand the card\nRead the detail rows, including question count,\ntime limit, and Math Academy's Notes", fillcolor="#eef2ff"];
    Parts [label="Multisteps and diagnostics\nExpand the card only if its Start link\ncannot yet be read from the page", fillcolor="#eef2ff"];
    Reread [label="Read all the cards again after opening those details\nKeep the same order as the page\nKeep records even for activities already underway\nor activity types the script cannot handle"];
    Common [label="For every activity, record:\l- Its name, type, and Math Academy activity ID\l- Its card and Start-button IDs, and the Start link\l- Its progress number and whether it has already started\l- Whether its type and link match something the script can handle\l",
      fillcolor="#dbeafe"];
    Extra [label="Also record the details specific to each type:\l- Lesson / review: topic ID\l- Assessment: test ID, all detail rows, and the card's HTML\l- Multistep: multistep ID and the card's HTML\l- Diagnostic: diagnostic ID, card HTML, and current course name/ID\l",
      fillcolor="#dbeafe"];
    FirstRead -> Lessons;
    FirstRead -> Tests;
    FirstRead -> Parts;
    Lessons -> Reread; Tests -> Reread; Parts -> Reread;
    Reread -> Common -> Extra;
    { rank=same; Lessons; Tests; Parts; }
    Lessons -> Tests -> Parts [style=invis, weight=20];
  }
  Outcomes -> FirstRead;

  subgraph cluster_meaning {
    label="Work out what the assessment notes mean";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    Meaning [label="Label each assessment as required, optional, or unclear\nRecord the XP still allowed before it becomes required\nRecord whether the title or Notes call it a retake\nKeep the original Notes alongside those labels",
      URL="../../scripts/question_capture/core.py"];
    Rules [label="How those labels are worked out\l'Optional until N more XP' means optional while N is above zero.\lAt zero, or when the Notes say it must be taken, it is required.\lThe script also treats it as required when it is the only activity,\lhas no Notes, and shows a question count and time limit.\lOtherwise, its requirement stays unclear.\l",
      shape=note, fillcolor="#eff6ff", fontsize=12];
    Meaning -> Rules [style=dotted, arrowhead=none];
    { rank=same; Meaning; Rules; }
  }
  Extra -> Meaning;
  Ready [label="The queue details are ready\nNext comes choosing which activity to do",
    shape=oval, fillcolor="#111827", fontcolor=white, fontsize=15];
  Meaning -> Ready;

  subgraph cluster_saved {
    label="Where these observations are saved";
    fontname="DejaVu Sans"; fontsize=17; color="#cbd5e1"; style=rounded;
    DashboardFiles [label="In this account's state folder:\ldashboard.json - course percentage and today's totals\ldaily-xp.json - today's XP entries, kept by activity ID\lrecent-activities.json - the 20 recent activity records\l",
      shape=folder, fillcolor="#eff6ff", fontsize=12];
    RepeatFile [label="perfect-retakes.json\nRemembers lessons/reviews that lost XP\nso a later repeat can aim for every answer correct",
      shape=folder, fillcolor="#eff6ff", fontsize=12];
    QueueFiles [label="The full queue and the lesson/review results go into:\lselection/queue.json - the latest queue observation\ljournal.jsonl - a history of queue observations\lqueue-after.json - also saved inside the completed activity's folder\lwhen this queue read follows an activity\l",
      shape=folder, fillcolor="#eff6ff", fontsize=12];
    Timing [label="The current script saves the queue together with its eventual\lactivity choice. This chart shows the observations in those files.\lThese are local files; reading the queue does not transact them into EDB.\l",
      shape=note, fillcolor=white, color="#cbd5e1", fontsize=12];
    DashboardFiles -> RepeatFile -> QueueFiles [style=invis];
    QueueFiles -> Timing [style=invis];
  }
  Totals -> DashboardFiles [style=dotted, label="saved during the page read", constraint=false];
  Outcomes -> RepeatFile [style=dotted, label="saved when the queue reader returns", constraint=false];
  Ready -> QueueFiles [style=dotted, label="observations included in these files"];
}
