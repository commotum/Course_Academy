;; An expected or candidate answer value owned by a field.
;; Evaluation belongs to application code; this schema describes content.
[
 ;; Enum values: answer representation.
 {:db/ident :answer.type/math}
 {:db/ident :answer.type/text}
 {:db/ident :answer.type/image}

 ;; Answer attributes and validation.
 {:db/ident :answer/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of an answer value owned by one field."}

 {:db/ident :answer/type
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Representation: answer.type/math, answer.type/text, or answer.type/image."}

 {:db/ident :answer/value
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Answer content interpreted using answer/type: LaTeX without Markdown delimiters for math, plain textual content for text, or an image path or URI for image answers."}

 {:db/ident :answer/validate
  :db.entity/attrs [:answer/id :answer/type :answer/value]
  :db/doc "Requires identity, type, and a string value when explicitly ensured. Supported answer types, nonempty and correctly formatted values, and image availability require application validation."}
]
