;; Reusable scenario with an ordered sequence of dependent questions; distinct from a multi-blank question.
;; Entity specs check required attributes only and must be explicitly ensured.
;; Relationship, enum, range, and delivery rules below are application contracts.
[
 {:db/ident :multistep/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable local identity assigned by the application, independent of external source identifiers."}

 {:db/ident :multistep/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Name of the scenario or combined-skill exercise."}

 {:db/ident :multistep/context
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional shared setup in Markdown with LaTeX and image links. Required before delivery if the questions rely on it; some captured results omit this setup."}

 {:db/ident :multistep/steps
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned ordered question placements. Sort by multistep-step/index; the set itself is unordered. Validate each placement separately."}

 {:db/ident :multistep/validate
  :db.entity/attrs [:multistep/id :multistep/title :multistep/steps]
  :db/doc "Requires identity, title, and ordered placements. Derive covered topics through each step's question and its knowledge-point membership. Check single ownership and unique positive step indexes. Preserve shared questions with ordinary refs and do not treat multiple blanks as separate multistep stages."}
]
