;; An instructional placement owned through :lesson/steps.
;; Request :db/ensure [:lesson-step/validate] when writing a step.
[
 {:db/ident :lesson-step/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of an instructional placement in one lesson."}

 {:db/ident :lesson-step/math-academy-id
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Optional MA placement ID: step-id in Steps.csv or stepid in source HTML."}

 {:db/ident :lesson-step/index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "1-based instructional order, positive and unique within the lesson."}

 {:db/ident :lesson-step/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "The tutorial or knowledge point placed here. This ordinary ref preserves content when the step is deleted. Validate the referenced entity separately."}

 {:db/ident :lesson-step/validate
  :db.entity/attrs [:lesson-step/id :lesson-step/index :lesson-step/content]
  :db/doc "Requires identity, index, and content when explicitly ensured. The MA ID is optional. Target type, ordering, ownership, and topic/KP membership require additional validation."}
]
