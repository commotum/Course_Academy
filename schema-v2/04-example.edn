;; A demonstrated problem and its worked explanation, referenced by a KP.
;; The KP title names the skill or case demonstrated by this example.
;; Request :db/ensure [:example/validate] when writing an example.
[
 {:db/ident :example/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of worked-example content, independent of its placement in a lesson or association with a KP."}

 {:db/ident :example/problem
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Problem demonstrated by the worked example, corresponding to captured example_question content. Stored as Markdown supporting LaTeX and image links. This is problem text, not a reference to a gradable question entity."}

 {:db/ident :example/explanation
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Required worked solution and instructional explanation, corresponding to captured example_explanation content. Stored as Markdown supporting LaTeX and image links. A machine-checkable answer and response interface are not required for a demonstration."}

 {:db/ident :example/validate
  :db.entity/attrs [:example/id :example/problem :example/explanation]
  :db/doc "Native EDB specification requiring identity, demonstrated problem, and worked explanation when explicitly ensured. Nonempty content, valid assets, and mathematical correctness require additional validation."}
]
