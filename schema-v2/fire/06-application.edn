;; Operational event application receipt, separate from observations and current state.
;; Request :db/ensure on writes; embedded EDN, ranges and reference targets require application validation.
[
 {:db/ident :fire-application/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of one event application to a model state."}

 {:db/ident :fire-application/event
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Direct observed event interpreted."}

 {:db/ident :fire-application/event-hash
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Fingerprint of exact engine Event payload. Same learner/event ID with a different hash is rejected."}

 {:db/ident :fire-application/policy
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Exact immutable policy used; policy ID matches the engine fingerprint."}

 {:db/ident :fire-application/graph
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Exact immutable encompassing graph used; graph ID matches the engine fingerprint."}

 {:db/ident :fire-application/calibration
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Exact topic-difficulty calibration set used; retain the map whose fingerprint is the engine receipt's difficulty_id."}

 {:db/ident :fire-application/applied-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Processing time, distinct from event time."}

 {:db/ident :fire-application/input-state-edn
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Exact input bundle encoded as EDN text: learner topic states, global ability, latest accepted time, and configured ability neighborhoods/initialization inputs. Include explicit defaults; topic states alone do not reproduce initial priors."}

 {:db/ident :fire-application/updates
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned per-target applied or skipped updates. An unlearned target can retain ability changes without receiving retention credit."}

 {:db/ident :fire-update/topic
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Topic updated or considered for a skipped update."}

 {:db/ident :fire-update/trace-edn
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Exact engine update dictionary encoded as EDN text. Applied records include direct flag, coverage, memory-before-decay/now, discount, raw_delta, speed, failure multiplier, implicit gate, before/after state, due_at. Skipped records retain their explicit reason. Application parses/validates payload."}

 {:db/ident :fire-application/validate
  :db.entity/attrs [:fire-application/id :fire-application/event :fire-application/event-hash :fire-application/policy :fire-application/graph :fire-application/calibration :fire-application/applied-at :fire-application/input-state-edn]
  :db/doc "Atomically apply receipt, learner clock, and state updates. An identical retry never credits twice; alternate-policy experiments use isolated state."}

 {:db/ident :fire-update/validate
  :db.entity/attrs [:fire-update/topic :fire-update/trace-edn]
  :db/doc "Preserves complete applied/skipped transition record; its shape depends on outcome."}
]
