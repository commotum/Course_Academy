;; Local FIRe reconstruction configuration; not recovered MA parameters.
;; Required-attribute specs are opt-in: request :db/ensure on each write.
;; Ranges, reference targets, formulas, and immutable-use rules are application contracts.
[
 {:db/ident :fire-policy/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable configuration identity. Once referenced by an application receipt, use a new identity for changed settings."}

 {:db/ident :fire-policy/algorithm
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Identifies the executable local algorithm and interpretation, including memory-update ordering."}

 {:db/ident :fire-policy/parameters-edn
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Complete validated EDN map encoded as a string. Include interval growth/cap, due threshold, accuracy prior/update, speed mapping/clamps, early discount, failure decay, propagation/override rules, and initialization. EDB does not execute or validate this embedded map."}

 {:db/ident :fire-policy/description
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Human explanation of the reconstruction choices and intended calibration."}

 {:db/ident :fire-policy/validate
  :db.entity/attrs [:fire-policy/id :fire-policy/algorithm :fire-policy/parameters-edn]
  :db/doc "Requires configuration identity, algorithm identifier, and the full parameter payload; no particular values are claimed to be MA's."}
]

