;; One ordered occurrence of a unit, module, or topic in a course map.
;; The map owns this entry; content remains independently owned.
;; Request :db/ensure [:course-map-entry/validate] when writing an entry.
[
 {:db/ident :course-map-entry/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of an entry in one course map, distinct from the identity of its referenced content."}

 {:db/ident :course-map-entry/index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "1-based position in the entire course map. Must be positive and unique within that map. Repeated content has a separate entry at each position."}

 {:db/ident :course-map-entry/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Unit, module, or topic placed at this position. A unit starts a new unit section, a module belongs to the latest unit, and a topic belongs to the latest module. The ordinary ref preserves shared content when the map is deleted."}

 {:db/ident :course-map-entry/validate
  :db.entity/attrs [:course-map-entry/id :course-map-entry/index :course-map-entry/content]
  :db/doc "Requires identity, position, and content ref when explicitly ensured. Application validation checks supported target types, position uniqueness, sequence, and membership. Validate referenced curriculum entities separately."}
]
