;; Knowledge-point model for EDB. Install before creating KP entities.
;; Request :db/ensure [:knowledge-point/validate] when writing a KP.
;; MA describes a KP as a worked example with associated active practice.
;; Topic membership is stored through :topic/knowledge-points.
;; Instructional order will be defined separately.
[
 {:db/ident :knowledge-point/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of the knowledge point, independent of an individual learner's progress or question occurrences."}

 {:db/ident :knowledge-point/math-academy-id
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Optional original Math Academy knowledge-point identifier, populated only when the source mapping is verified. An observed activity KP link uses the associated example's content_id, not its lesson step_id. Steps.csv does not directly provide a KP identifier; do not substitute step-id. Omit for independently created KPs or unverified mappings."}

 {:db/ident :knowledge-point/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Name of the instructional skill or case demonstrated by the worked example, corresponding to captured example titles."}

 {:db/ident :knowledge-point/key-prerequisites
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Optional references to prerequisite topics whose skills are most directly used in this KP, supporting targeted remedial reviews. Distinct from the containing topic's general prerequisites. These ordinary refs do not establish ownership; omit when no links are known."}

 {:db/ident :knowledge-point/example
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Required reference to the worked example demonstrating this KP, with its problem and explanation stored together. This ordinary ref permits instructional content reuse without cascading deletion. Writers must also ensure example/validate; this reference does not make the example a practice question."}

 {:db/ident :knowledge-point/questions
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Required question pool containing at least one question associated with this KP. Lesson practice, reviews, and assessments select appropriate items from the pool using learner history. This collection is unordered; question selection and avoidance of already-answered lesson items belong to the engine."}

 {:db/ident :knowledge-point/question-generator
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional reference to a question-generator entity holding a Python script that produces new questions for this KP. The application invokes the generator when more questions are needed, validates its output, and adds accepted questions to the KP's pool."}

 {:db/ident :knowledge-point/validate
  :db.entity/attrs [:knowledge-point/id
                    :knowledge-point/title
                    :knowledge-point/example
                    :knowledge-point/questions]
  :db/doc "Native EDB specification requiring KP identity, title, an example ref, and at least one question ref when explicitly ensured. Writers must also ensure example/validate and question/validate for the referenced content, along with its child specifications. Reference target types, mathematical correctness, and question selection rules require additional validation."}
]
