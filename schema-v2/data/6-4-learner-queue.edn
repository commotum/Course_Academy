;; One up-next entry owned through learner/queue. Find its learner through the reverse ref.
;; Entries describe scheduling intent; activity records describe performed work.
;; Entity specs check required attributes only and must be explicitly ensured.
[
 {:db/ident :queue.selection/recommended}
 {:db/ident :queue.selection/self-selected}

 {:db/ident :queue/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of this queue entry. Reordering updates the entry rather than creating a new one."}

 {:db/ident :queue/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Lesson, review, assessment, multistep, diagnostic, or supplemental-diagnostic definition proposed for study. Derive its category and intended topics from this shared content. Validate that it is complete and eligible before starting an activity."}

 {:db/ident :queue/index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Positive position unique within this learner's current queue; smaller indexes come first. The application updates positions when priorities change. The learner/queue ref set itself is unordered."}

 {:db/ident :queue/selection
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Who selected this work: queue.selection/recommended for the engine, or queue.selection/self-selected for the learner. Both routes use the same grading and learning updates."}

 {:db/ident :queue/reason
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Human-readable explanation of why this content is queued, such as a due review, remediation, preparation for an assignment, or the next eligible lesson. Explains the scheduler's decision; application code does not parse this text to decide what to serve."}

 {:db/ident :queue/course
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional course context that motivated this entry. Shared topics can support several courses, so this context cannot always be inferred from content membership. Omit for general study or when no single course motivated the choice."}

 {:db/ident :queue/added-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Optional time this entry was added to the learner's queue. Reordering does not reset it."}

 {:db/ident :queue/validate
  :db.entity/attrs [:queue/id :queue/content :queue/index :queue/selection :queue/reason]
  :db/doc "Requires identity, content, order, selection route, and explanation. The writer separately checks exactly one learner owner, positive unique positions, supported selection values, nonblank reasons, and valid reference targets. Remove an entry when launched or dismissed; activity history is separate. This current queue does not provide a permanent scheduling-decision record."}
]
