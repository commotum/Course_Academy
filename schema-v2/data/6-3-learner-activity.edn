;; One learner activity, owned logically through learner/activity. No duplicate learner ref.
;; Entity specs check required attributes only and must be explicitly ensured.
;; Relationship, enum, range, and delivery rules below are application contracts.
[
 {:db/ident :activity.status/planned}
 {:db/ident :activity.status/in-progress}
 {:db/ident :activity.status/paused}
 {:db/ident :activity.status/completed}
 {:db/ident :activity.status/abandoned}

 {:db/ident :activity.outcome/passed}
 {:db/ident :activity.outcome/failed}

 {:db/ident :activity.selection/recommended}
 {:db/ident :activity.selection/self-selected}

 {:db/ident :activity/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable local identity assigned by the application, independent of external source identifiers."}

 {:db/ident :activity/math-academy-id
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional taskId from the completed activity URL, not a question, topic, or test-definition ID. Imports reconcile it within the learner history; global uniqueness across learners is not assumed."}

 {:db/ident :activity/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Title of this attempt, including a displayed Retake label when present. Quiz and multistep titles are not topic names."}

 {:db/ident :activity/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Reference to the lesson, review, assessment, multistep, diagnostic, or supplemental-diagnostic definition being attempted. Derive the activity category from the target's identifying attribute, such as review/id or assessment/id. Incomplete imports may reference an identity-only content placeholder, or omit this ref when content is unknown. Local delivery requires complete, validated content."}

 {:db/ident :activity/course
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional course context for this attempt. Preserve the basis of inferred CSV course attribution in source-notes; never copy the current sidebar course onto historical work."}

 {:db/ident :activity/topic
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional main task topic, observed for lessons/reviews. Multi-topic activities use their item topic refs; do not invent a single topic from an exam or scenario title."}

 {:db/ident :activity/status
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Lifecycle state. Completed is observed in all current CSV rows; the other status enum values are local runtime design. Completed does not mean passed or mastered."}

 {:db/ident :activity/outcome
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional explicit pass/fail decision from the activity controller. Omit when only completion or XP was observed; diagnostics need not have a pass/fail outcome."}

 {:db/ident :activity/selection
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional entry route, recommended or self-selected. Both use the same grading and learning updates. Historical captures do not establish the route."}

 {:db/ident :activity/retake
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Optional explicit retake indicator, including a captured Retake label. Allows known retake status when the prior activity cannot be identified."}

 {:db/ident :activity/retake-of
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional prior activity being retaken by this learner. Validate same owner and compatible assessment scope; a new activity has its own results and XP."}

 {:db/ident :activity/remediation-for
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional earlier activity whose difficulty or errors caused this activity to be assigned. Distinct from a retake; the engine supplies this causal relationship."}

 {:db/ident :activity/started-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Optional actual start instant when known. Do not reconstruct from the earliest displayed question label or from XP."}

 {:db/ident :activity/completed-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Optional actual completion instant with a supported date and timezone. Completed imports can omit it when only a local clock time is known."}

 {:db/ident :activity/elapsed-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional nonnegative finite wall-clock duration from start to finish, including pauses. Store only when measured or reliably derived from both instants; not the sum of question times."}

 {:db/ident :activity/active-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional nonnegative finite measured engaged time, excluding tracked pauses/background time. Never relabel imported elapsed values as active time."}

 {:db/ident :activity/expected-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional positive finite workload estimate when the task was assigned. Used for scheduling or workload calibration, not measured learner time."}

 {:db/ident :activity/time-limit-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional positive finite limit actually applied to this attempt. A limit is not its elapsed duration, baseline XP, or proof that a missing answer was a timeout."}

 {:db/ident :activity/xp-earned
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional signed XP actually awarded, including negative values, zero, and bonuses above the baseline. Absence is unknown, not zero. Record once per activity; retries must not award it twice."}

 {:db/ident :activity/xp-base
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional nonnegative displayed baseline or engine-assigned base XP. The CSV calls this xp-possible, but it is not a maximum. Diagnostics in the current data omit it."}

 {:db/ident :activity/groups
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Optional owned lesson KP groups, ordered by activity-group/index. Grouping is not a separate attempt and need not expose a recoverable KP ID."}

 {:db/ident :activity/items
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned presentation occurrences, ordered by activity-item/index. Questions can recur with separate occurrence IDs. Tutorial/example presentations can also be logged; question counts are derived by filtering item type."}

 {:db/ident :activity/results-complete
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Optional confirmation that all presented questions and their final outcomes are recorded. True requires known runtime or extraction completeness; absent means unknown. Does not require recorded submissions or tutorial-view logs. A completed header alone is not sufficient."}

 {:db/ident :activity/source-url
  :db/valueType :db.type/uri
  :db/cardinality :db.cardinality/one
  :db/doc "Optional source activity URL, such as the Math Academy completed task page."}

 {:db/ident :activity/completed-local
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional source local completion date/time when a UTC instant is not justified, such as 2026-09-24 17:05 from progress.csv. Does not imply a timezone."}

 {:db/ident :activity/source-notes
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional compact provenance notes for inferred courses, timestamp ambiguity, extraction coverage, and missing data. Canonical activity fields remain separate from source interpretations."}

 {:db/ident :activity/validate
  :db.entity/attrs [:activity/id :activity/title :activity/status]
  :db/doc "Requires core attempt identity and lifecycle fields. Find the learner through learner/_activity; require exactly one owner and unique external task IDs within that history in the writer. Separately ensure groups/items/submissions. Validate supported enums, target types, nonnegative timings, chronological known instants, index uniqueness, retake ownership, and signed XP semantics. Partial historical imports may omit content, item details, timestamps, duration, and XP. This required-attribute spec does not enforce those relationships."}

 {:db/ident :activity/ready-validate
  :db.entity/attrs [:activity/id :activity/title :activity/status :activity/content]
  :db/doc "Requires a content ref in addition to the core record. Before local delivery, the controller separately validates that the target identifies exactly one supported activity category and satisfies that content schema's complete spec, plus ownership and scheduling rules. An identity-only placeholder is not ready to serve."}
]
