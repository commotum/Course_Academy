;; Module model for EDB. Install before creating module entities.
;; Request :db/ensure [:module/identity-validate] for an ID-only placeholder.
;; Request :db/ensure [:module/validate] when its required data is ready.
;; Unit membership is stored through :unit/modules.
[
 {:db/ident :module/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable module identity assigned by our application, independent of Math Academy's identifier and the module's order within its unit."}

 {:db/ident :module/math-academy-id
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Optional original Math Academy module identifier, taken from module-id in DATA/Modules.csv. Omit for independently created modules."}

 {:db/ident :module/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Module title, taken from module-name in DATA/Modules.csv, for example Operations on Numbers."}

 {:db/ident :module/topics
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Topics belonging to this module. At least one is required when module/validate is explicitly ensured. These ordinary refs permit topic reuse across modules without cascading deletion. References define unordered membership; topic/next supplies direct downstream dependencies across the shared topic graph. Referenced topics must also ensure topic/validate."}

 {:db/ident :module/next
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Optional direct downstream modules for curriculum navigation. Ordinary refs preserve shared modules; reverse lookup supplies preceding modules. These links present progression between topic collections. Topic/next remains the authoritative prerequisite graph; module links do not impose additional completion requirements."}

 {:db/ident :module/identity-validate
  :db.entity/attrs [:module/id]
  :db/doc "Requires only identity for a placeholder module when explicitly ensured. Use module/validate after filling in its required data."}

 {:db/ident :module/validate
  :db.entity/attrs [:module/id :module/title :module/topics]
  :db/doc "Requires our identity, a title, and at least one topic ref when explicitly ensured. The Math Academy identifier and next modules are optional. Nonempty titles, reference target types, and prevention of self-links and cycles require application validation. Referenced topics must be validated separately."}
]
