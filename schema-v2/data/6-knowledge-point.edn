;; Knowledge-point model for EDB. Install before creating KP entities.
;; Request :db/ensure [:knowledge-point/identity-validate] for an ID-only placeholder.
;; Request :db/ensure [:knowledge-point/validate] when its required data is ready.
;; MA describes a KP as a worked example with associated active practice.
;; Topic membership is stored through :topic/knowledge-points.
;; Instructional order is stored through lesson steps.
[
 {:db/ident :knowledge-point/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of the knowledge point, independent of an individual learner's progress or question occurrences."}

 {:db/ident :knowledge-point/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Name of the instructional skill or case demonstrated by the worked example, corresponding to captured example titles."}

 {:db/ident :knowledge-point/key-prerequisites
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Optional references to prerequisite topics whose skills are most directly used in this KP, supporting targeted remedial reviews. Distinct from the containing topic's general prerequisites. These ordinary refs do not establish ownership; omit when no links are known."}

 {:db/ident :knowledge-point/canonical-example
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Required reference to the canonical worked example question demonstrating this KP. The target must have question/id, a problem, and a nonempty worked solution. This reference establishes its worked-example role. This ordinary ref permits content reuse without cascading deletion. Canonical-example targets cannot belong to any KP practice question pool."}

 {:db/ident :knowledge-point/questions
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Required pool containing at least one ordinary gradable question associated with this KP. Any question referenced through knowledge-point/canonical-example is excluded, including examples of other KPs. Lesson practice, reviews, and assessments select appropriate items from the pool using learner history. This collection is unordered; question selection and avoidance of already-answered lesson items belong to the engine."}

 {:db/ident :knowledge-point/question-generator
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional reference to a question-generator entity holding a Python script that produces new questions for this KP. The application invokes the generator when more questions are needed, validates its output, and adds accepted questions to the KP's pool."}

 {:db/ident :knowledge-point/identity-validate
  :db.entity/attrs [:knowledge-point/id]
  :db/doc "Requires only identity for a placeholder knowledge point when explicitly ensured. Use knowledge-point/validate after filling in its required data."}

 {:db/ident :knowledge-point/validate
  :db.entity/attrs [:knowledge-point/id
                    :knowledge-point/title
                    :knowledge-point/canonical-example
                    :knowledge-point/questions]
  :db/doc "Native EDB specification requiring KP identity, title, a canonical example question ref, and at least one practice question ref when explicitly ensured. Writers ensure question/validate for both examples and practice questions, along with child specifications. The application checks target types, nonempty canonical worked solutions, disjointness of all canonical targets from every practice pool, mathematical correctness, and selection rules."}
]
