;; Curriculum sequence owned through :course/map.
;; Membership remains in course/units, unit/modules, and module/topics.
;; Request :db/ensure [:course-map/validate] when writing a map.
[
 {:db/ident :course-map/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of a curriculum map owned by one course."}

 {:db/ident :course-map/entries
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned flat sequence of unit, module, and topic entries. Sort by course-map-entry/index to read the course map. Writers must separately ensure course-map-entry/validate on every entry."}

 {:db/ident :course-map/validate
  :db.entity/attrs [:course-map/id :course-map/entries]
  :db/doc "Requires identity and at least one entry when explicitly ensured. Application validation checks positive indexes unique across this map, unit-to-module-to-topic sequence, and membership coverage through course/units, unit/modules, and module/topics."}
]
