;; A weighted relationship owned through :topic/encompasses.
;; The containing topic supplies the source; no separate source attribute is needed.
;; Request :db/ensure [:encompassing/validate] when writing a relationship.
[
 {:db/ident :encompassing/topic
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "The component topic whose skills are practiced implicitly. This ordinary ref preserves the topic when the encompassing record is deleted. Validate the referenced topic separately."}

 {:db/ident :encompassing/weight
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Coverage fraction from 0 to 1 describing how much practice the containing topic provides for the component topic. Distinct from learner accuracy and final repetition credit; the engine applies performance and timing rules separately."}

 {:db/ident :encompassing/rationale
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional explanation of which component skills the containing topic exercises and why this coverage weight was chosen."}

 {:db/ident :encompassing/validate
  :db.entity/attrs [:encompassing/topic :encompassing/weight]
  :db/doc "Requires a component topic and weight when explicitly ensured. A valid topic target, finite weight in [0,1], and relationship consistency require additional validation."}
]
