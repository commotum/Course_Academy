;; Targeted placement evidence after curriculum or knowledge-graph changes.
;; Entity specs check required attributes only and must be explicitly ensured.
;; Relationship, enum, range, and delivery rules below are application contracts.
[
 {:db/ident :supplemental-diagnostic/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable local identity assigned by the application, independent of external source identifiers."}

 {:db/ident :supplemental-diagnostic/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Name of the exam definition. This title is not a catalog topic identity."}

 {:db/ident :supplemental-diagnostic/course
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Course whose knowledge and prerequisite foundations are being diagnosed. Does not imply an enrollment change."}

 {:db/ident :supplemental-diagnostic/topics
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Optional explicit target scope within the course and its foundations. For supplemental work, identifies gaps in diagnostic evidence selected by the engine; poor performance alone is not the established trigger."}

 {:db/ident :supplemental-diagnostic/time-limit-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional positive finite limit if this exam is actually configured with one. The captures do not establish a universal diagnostic timer."}

 {:db/ident :supplemental-diagnostic/validate
  :db.entity/attrs [:supplemental-diagnostic/id :supplemental-diagnostic/title :supplemental-diagnostic/course]
  :db/doc "Requires identity, title, and course. Validate scope and timings in application code. Diagnostic selection, evidence propagation, stopping, placement, and XP are algorithm behavior; completed attempts store the observed answers independently of inferred knowledge."}
]
