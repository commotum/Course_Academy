;; Proposed reusable review definition. A performed review is an activity record.
;; Entity specs check required attributes only and must be explicitly ensured.
;; Relationship, enum, range, and delivery rules below are application contracts.
[
 {:db/ident :review/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable local identity assigned by the application, independent of external source identifiers."}

 {:db/ident :review/topic
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Topic to retrieve and practice. This ordinary ref preserves shared curriculum when the definition is deleted."}

 {:db/ident :review/knowledge-points
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Optional subset of the topic knowledge points to target. Omit to let the engine select across the topic. Does not establish a second question bank."}

 {:db/ident :review/validate
  :db.entity/attrs [:review/id :review/topic]
  :db/doc "Requires identity and target topic. Check target types and that any selected KPs belong to the topic. Questions, order, termination, pass/fail, and XP are determined by application code and recorded on the activity; no universal five-question rule is asserted."}
]
