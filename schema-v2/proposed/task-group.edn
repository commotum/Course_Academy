;; A lesson knowledge-point grouping owned through learner-task/groups.
;; Entity specs check required attributes only and must be explicitly ensured.
;; Relationship, enum, range, and delivery rules below are application contracts.
[
 {:db/ident :task-group/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable local identity assigned by the application, independent of external source identifiers."}

 {:db/ident :task-group/index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Positive group order unique within the learner-task. Displayed KP 1 is an ordinal, not a source knowledge-point ID."}

 {:db/ident :task-group/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional displayed group title, useful when the KP identity has not been recovered."}

 {:db/ident :task-group/knowledge-point
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional verified local KP associated with this group."}

 {:db/ident :task-group/lesson-step
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional instructional placement identifying the KP stage in the delivered lesson."}

 {:db/ident :task-group/outcome
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional learner-task.outcome pass/fail decision for this KP stage. Only populate from an explicit controller decision; question sequences and completed headers alone do not establish it."}

 {:db/ident :task-group/validate
  :db.entity/attrs [:task-group/id :task-group/index]
  :db/doc "Requires identity and order. Check exactly one task owner, unique group indexes, and compatible KP/lesson-step context. This draft does not currently link individual task items to groups."}
]
