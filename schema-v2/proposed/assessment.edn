;; Proposed quiz or assessment definition; learner results belong on task records.
;; Entity specs check required attributes only and must be explicitly ensured.
;; Relationship, enum, range, and delivery rules below are application contracts.
[
 {:db/ident :assessment/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable local identity assigned by the application, independent of external source identifiers."}

 {:db/ident :assessment/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Name of the assessment, such as Quiz 4 or Quiz 4 (Retake)."}

 {:db/ident :assessment/questions
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Questions selected for this assessment. Ordinary refs preserve the questions when the assessment is deleted. Topics are available through question-bank membership; presentation order belongs to the application."}

 {:db/ident :assessment/time-limit-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional positive finite time limit for this definition. Do not infer a limit from XP or hard-code fifteen minutes for all assessments."}

 {:db/ident :assessment/expected-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional positive expected workload used for assembly and scheduling. Distinct from the enforced limit and the learner actual elapsed time."}

 {:db/ident :assessment/validate
  :db.entity/attrs [:assessment/id :assessment/title :assessment/questions]
  :db/doc "Requires identity, title, and at least one question ref. The application validates question targets and positive finite timings, assembles the assessment, and determines grading and XP. Each attempt is a task whose items record the questions actually presented and their results."}
]
