[
;; One learner-specific task at a shared activity, linked through learner/activity.
;; Find the learner through the reverse reference.
;; Required-attribute specs are opt-in; application code checks relationship and value rules.
 {:db/ident :learner-task.status/locked}
 {:db/ident :learner-task.status/unlocked}
 {:db/ident :learner-task.status/started}
 {:db/ident :learner-task.status/paused}
 {:db/ident :learner-task.status/completed}
 {:db/ident :learner-task.status/failed}

 {:db/ident :learner-task/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of this attempt, independent of external identifiers."}

 {:db/ident :learner-task/math-academy-id
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional Math Academy taskId. Reconcile within the learner's history; global uniqueness across learners is not established."}

 {:db/ident :learner-task/activity
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Shared activity definition for this learner task. Resolve its title, type, and intended scope through this reference."}

 {:db/ident :learner-task/status
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Locked means not yet eligible for an engine-selected start; unlocked means engine-eligible but not started. Explicit self-directed queue selections may start a prepared locked task directly without an intermediate unlock. Preparation does not start a clock or establish mastery. Started means in progress; paused means suspended and unfinished, including a lesson route whose completed presentations retain deferred practice markers while waiting for fresh questions. Completed means finished under the activity's completion rules; failed means an explicit task-level failure condition ended the attempt. Status transaction history supplies calendar timestamps, including the first start and terminal transition. Pausing does not extend a timed exam's deadline. Question correctness is recorded by task-item/status; no separate task outcome is stored."}

 {:db/ident :learner-task/priority
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Numerical scheduling priority; higher values are served first. Eligible unfinished tasks at or above the application's threshold are required. The application calculates finite values and defines the scale and threshold."}

 {:db/ident :learner-task/elapsed-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Accumulated working seconds, calculated by summing task-item/elapsed-seconds across this task's items. The application updates this total with the item durations; it is not an independently edited value or the timed-exam deadline. Omit when durations are unknown."}

 {:db/ident :learner-task/xp-earned
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "XP awarded for this attempt, including penalties and bonuses. May be negative or exceed xp-base. Omit when unknown."}

 {:db/ident :learner-task/xp-base
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional nonnegative baseline XP for this attempt, before bonuses or penalties. The displayed denominator is not a maximum."}

 {:db/ident :learner-task/items
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned question, tutorial, and example presentations, linked in order through task-item/next. The reference collection itself is unordered. Repeated presentations have separate item identities."}

 {:db/ident :learner-task/validate
  :db.entity/attrs [:learner-task/id :learner-task/activity :learner-task/status]
  :db/doc "Requires identity, activity, and lifecycle state. The application checks one learner association, valid content, enums, and timing; validate child records separately."}

;; One learner-specific presentation of a question (including a worked example) or tutorial.
;; Owned through learner-task/items; content refers to the shared item presented.
 {:db/ident :task-item.status/started}
 {:db/ident :task-item.status/paused}
 {:db/ident :task-item.status/completed}
 {:db/ident :task-item.status/skipped}
 {:db/ident :task-item.status/correct}
 {:db/ident :task-item.status/incorrect}

 {:db/ident :task-item/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of this presentation, separate from the content ID."}

 {:db/ident :task-item/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Question, worked example question, or tutorial presented. May be absent when historical content identity is unknown."}

 {:db/ident :task-item/status
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Started means actively working; paused suspends the working timer. Completed ends a tutorial or worked example question; correct, incorrect, and skipped end an ordinary question attempt. Retained status transaction history supplies start, pause, resume, and finish timestamps. Questions never presented do not create task items. Reference targets and valid transitions require application validation."}

 {:db/ident :task-item/responses
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Answer entities supplied for this question, for both entered blank values and selected radio/select options. Recover each answer's field through the reverse answer-field/choices ownership ref. The application checks field membership and at most one response per field, deduplicates entered values within their field, and preserves referenced answer values. These ordinary refs do not own answers."}

 {:db/ident :task-item/elapsed-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Accumulated seconds spent in started, calculated from this item's status transaction history. Paused intervals are excluded. The application updates this value and the parent task's elapsed total together, with at most one actively timed item per learner. Imported observed durations may be retained when their status history is unavailable."}

 {:db/ident :task-item/performance
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Calculated performance magnitude used by the engine. Positive and finite; may exceed one. Distinct from correctness and XP. Omit until evaluated; the application checks the range."}

 {:db/ident :task-item/next
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional next presentation in the same learner task. Omit on the last item. This ordinary ref orders the task's existing members; learner-task/items remains their component owner. Derive the first item from the member with no incoming next link. The application checks that all members form one chain without cycles, merges, or links outside the task."}

 {:db/ident :task-item/deferred-step
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Authored knowledge-point stage deferred after this completed example or answered question because no fresh gradable questions were available. Keeps the practice unfinished while later lesson stages proceed; never a skip, failure, or mastery assertion. Application validates same-activity membership and exhaustion."}

 {:db/ident :task-item/resumed-step
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Authored knowledge-point stage revisited by this canonical-example presentation after finishing a lesson route with deferred practice. Replay resumes only outstanding stages and retains prior question outcomes and exposure history. Application validates that the stage was deferred in this task."}

 {:db/ident :task-item/validate
  :db.entity/attrs [:task-item/id :task-item/status]
  :db/doc "Requires presentation identity and status. The next link is optional; historical content may be unknown. Task membership, chain consistency, status transitions, and derived elapsed totals require application validation."}
]
