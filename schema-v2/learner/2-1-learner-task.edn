;; One learner attempt at a shared activity, linked through learner/activity.
;; Find the learner through the reverse reference.
;; Required-attribute specs are opt-in; application code checks relationship and value rules.
[
 {:db/ident :learner-task.status/planned}
 {:db/ident :learner-task.status/in-progress}
 {:db/ident :learner-task.status/paused}
 {:db/ident :learner-task.status/completed}
 {:db/ident :learner-task.status/abandoned}

 {:db/ident :learner-task.outcome/passed}
 {:db/ident :learner-task.outcome/failed}

 {:db/ident :learner-task/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of this attempt, independent of external identifiers."}

 {:db/ident :learner-task/math-academy-id
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional Math Academy taskId. Reconcile within the learner's history; global uniqueness across learners is not established."}

 {:db/ident :learner-task/activity
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Shared lesson, review, assessment, multistep, or diagnostic being attempted. Resolve its title, category, and intended scope through this reference."}

 {:db/ident :learner-task/status
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Lifecycle state: planned, in-progress, paused, completed, or abandoned. Completion does not establish success."}

 {:db/ident :learner-task/outcome
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional overall pass/fail decision. Individual question results remain separate; omit when no task-level decision applies or is known."}

 {:db/ident :learner-task/started-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Actual start time, when known. Together with completed-at, determines wall-clock duration including pauses."}

 {:db/ident :learner-task/completed-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Actual completion time, when known. Imported dates require a supported timezone."}

 {:db/ident :learner-task/xp-earned
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "XP awarded for this attempt, including penalties and bonuses. May be negative or exceed xp-base. Omit when unknown."}

 {:db/ident :learner-task/xp-base
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Optional nonnegative baseline XP for this attempt, before bonuses or penalties. The displayed denominator is not a maximum."}

 {:db/ident :learner-task/items
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned question, tutorial, and example presentations, ordered by task-item/index. Repeated presentations have separate item identities."}

 {:db/ident :learner-task/validate
  :db.entity/attrs [:learner-task/id :learner-task/activity :learner-task/status]
  :db/doc "Requires identity, activity, and lifecycle state. The application checks one learner association, valid content, enums, and timing; validate child records separately."}
]
