;; Course Academy: clean application schema for EDB.
;; Install this transaction first, then 02-entity-specs.edn.
;; All enum domains, reference targets, units and conditional rules in db/doc
;; are application contracts unless EDB itself declares the constraint.
[

 ;; Shared identity and current rich content
 {:db/ident :entity/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable application UUID. Reuse it when updating the same entity."}
 {:db/ident :entity/kinds
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Entity specifications this entity implements; references :kind/* entities. Writers must explicitly request db/ensure."}
 {:db/ident :entity/created-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Creation time, when known."}
 {:db/ident :entity/updated-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Last edit time for current authored data; not a content revision identifier."}
 {:db/ident :content/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Human-readable title. Titles are not identities."}
 {:db/ident :content/summary
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Short rich-text description."}
 {:db/ident :content/body
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Current rich-text body, prompt, statement, or explanation. Markdown bodies may contain TeX and asset:UUID links."}
 {:db/ident :content/format
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Body syntax: :content.format/markdown, /html, or /plain. This is distinct from question interaction format."}
 {:db/ident :content/status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Authoring status: :content.status/draft, /ready, or /retired. Ready requires application validation."}
 {:db/ident :content/tags
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Search and organization tags; not prerequisites or mastery evidence."}
 {:db/ident :content/assets
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Assets used by this content, including inline rich-text references."}
 {:db/ident :placement/parent
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Container: course, unit, topic, lesson, section, example, assignment, problem, collection, or assessment blueprint. Units may nest to represent modules."}
 {:db/ident :placement/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Child content at this location. Question placements inside a lesson must agree with question/lesson, including through nested sections. Assessment placement is a candidate delivery location, not another instructional owner."}
 {:db/ident :placement/position
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Zero-based order within this parent; application enforces unique nonnegative positions."}
 {:db/ident :placement/role
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Contextual role such as :placement.role/tutorial, /example, /practice, /question, /part, /unit, /module, /topic, /lesson, or /solution-step."}
 {:db/ident :placement/label
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Contextual heading, alias, or problem number without renaming the content."}
 {:db/ident :placement/group
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional group heading within this ordered container."}
 {:db/ident :placement/required?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Whether this child is required to complete the containing activity; omission leaves this to policy."}
 {:db/ident :placement/points
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Nonnegative score weight for this occurrence of a problem/question in an assignment or fixed assessment."}

 ;; Curriculum, lessons, and knowledge points
 {:db/ident :course/code
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Human course code; not globally unique."}
 {:db/ident :course/subject
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Subjects covered, for example :subject/mathematics or :subject/electrical-engineering."}
 {:db/ident :course/level
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Descriptive curriculum level."}
 {:db/ident :course/description
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Scope and intended audience."}
 {:db/ident :unit/objectives
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Learning objectives for a curriculum unit."}
 {:db/ident :topic/objectives
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Topic-level competencies."}
 {:db/ident :topic/difficulty
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional calibrated topic difficulty. Its scale is defined by the referenced difficulty model, not by question E/M/H labels."}
 {:db/ident :topic/difficulty-model
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Policy defining the topic difficulty scale and calibration."}
 {:db/ident :knowledge-point/competency
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Precise assessable skill, independent of a tutorial or worked example."}
 {:db/ident :knowledge-point/topics
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Topics containing or using this knowledge point; supports shared skills across courses."}
 {:db/ident :knowledge-point/misconceptions
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Known misconceptions or failure modes."}
 {:db/ident :lesson/topics
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Topics taught by this lesson."}
 {:db/ident :lesson/knowledge-points
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Knowledge points explicitly taught. Sections define instructional order using placements."}
 {:db/ident :lesson/objectives
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Intended learning outcomes."}
 {:db/ident :lesson/core-move
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Central operation the learner should recognize and perform."}
 {:db/ident :lesson/recognition-cue
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "What signals that the core move is useful."}
 {:db/ident :lesson/given-structure
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Mathematical or physical structure assumed in the prompt."}
 {:db/ident :lesson/target-output
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Form of the desired result."}
 {:db/ident :lesson/prerequisite-floor
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Minimum prerequisite competency in prose, including requirements not yet represented as graph nodes."}
 {:db/ident :lesson/failure-modes
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Likely mistakes that instruction should address."}
 {:db/ident :lesson/variation-axes
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Dimensions varied across examples and practice."}
 {:db/ident :lesson/expected-seconds
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Positive expected total working time, separate from question difficulty and XP."}
 {:db/ident :section/role
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Instructional role: :section.role/tutorial, /worked-example, /practice, /summary, or /check."}
 {:db/ident :section/knowledge-points
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Knowledge points addressed by this section."}
 {:db/ident :section/learning-goal
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Local instructional objective."}
 {:db/ident :section/variation
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "New variation introduced in this section."}
 {:db/ident :section/practice-model
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Specification for practice that supports this section."}
 {:db/ident :section/distractor-strategy
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Mistakes that authored distractors should expose."}
 {:db/ident :example/knowledge-points
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/index true
  :db/doc "Skills demonstrated by this worked example."}
 {:db/ident :example/solution
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text worked solution. Ordered solution-step sections can be used when step granularity is needed."}
 {:db/ident :example/conclusion
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Result and takeaway."}
 {:db/ident :example/problem
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional school problem illustrated by this example."}

 ;; Questions, response parts, reusable options, and grading
 {:db/ident :question/lesson
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Single instructional home for an item in a lesson's question pool. Required with primary-knowledge-point by :spec/lesson-question. Reviews and assessments may select an eligible item from this pool without changing its owner. Standalone school problems or unclassified drafts may omit both ownership fields."}
 {:db/ident :question/primary-knowledge-point
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Primary assessed knowledge point within the owning lesson. Additional assessed/incidental skills use question-skill links. Together with question/lesson this identifies a logical question pool, independent of the activity in which an item is delivered."}
 {:db/ident :question/format
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Interaction: :question.format/radio, /checkbox, /blank, /free, /select, /multi-select, or /noodle. Multi-select means several dropdowns."}
 {:db/ident :question/option-bank
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Default shared option bank; response parts may supply their own banks."}
 {:db/ident :question/parts
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned response parts. Order is response-part/position, never ref collection order."}
 {:db/ident :question/explanation
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text solution or explanation shown according to delivery policy."}
 {:db/ident :question/difficulty-band
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/index true
  :db/doc "Optional authored :difficulty/easy, /medium, or /hard. Unknown is absent."}
 {:db/ident :question/difficulty
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Optional calibrated numeric item difficulty on a named model scale."}
 {:db/ident :question/difficulty-model
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Policy defining numeric question difficulty; not a learner ability or topic difficulty."}
 {:db/ident :question/expected-seconds
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Positive expected answering time under specified delivery policy."}
 {:db/ident :question/shuffle-choices?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Default option-shuffling preference; actual delivered order is stored per task item."}
 {:db/ident :question/gated?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Author preference to hide the question until the learner explicitly starts it. Delivery policy controls timing and answer exposure separately."}
 {:db/ident :question/one-to-one?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Matching constraint for noodle: each option may match at most one response part."}
 {:db/ident :question/calculator-policy
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":calculator/allowed, /forbidden, or /required; a task may further constrain it."}
 {:db/ident :question/hint
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Optional rich-text hint; using it must be recorded as evidence context."}
 {:db/ident :question/feedback-correct
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text feedback for an entirely correct answer."}
 {:db/ident :question/feedback-incorrect
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text feedback for an incorrect answer."}
 {:db/ident :question/generator
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Generator capable of creating this kind of item, when applicable."}
 {:db/ident :question/parameters-edn
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Concrete parameter map for this generated question, serialized as EDN text; never an arbitrary map value."}
 {:db/ident :question/generation-run
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Generation job that produced this current question, when applicable."}
 {:db/ident :option-bank/choices
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned choices; choice/position specifies authored order."}
 {:db/ident :choice/position
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Zero-based authored order in the owning bank."}
 {:db/ident :choice/feedback
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text feedback when this choice is selected."}
 {:db/ident :response-part/position
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Zero-based part order in the owning question."}
 {:db/ident :response-part/key
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Stable key within the question, also used by {{part:key}} prompt placeholders."}
 {:db/ident :response-part/input
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Input control: :input/choice, /text, /math, /number, or /file."}
 {:db/ident :response-part/option-bank
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Part-specific bank; overrides the question default. Required for distinct dropdown banks."}
 {:db/ident :response-part/grading-rule
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Evaluator and accepted answer for this response part."}
 {:db/ident :response-part/weight
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Positive relative contribution to question score; policy defines defaults when absent."}
 {:db/ident :response-part/feedback
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text feedback for this part."}
 {:db/ident :grading-rule/method
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":grading/choice-set, /text, /numeric, /symbolic, /manual, or /reveal. Reveal does not assert correctness."}
 {:db/ident :grading-rule/accepted-choices
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Correct choice set using stable choice entities, never displayed letters."}
 {:db/ident :grading-rule/accepted-texts
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Alternative accepted text answers for text grading."}
 {:db/ident :grading-rule/expected-number
  :db/valueType :db.type/bigdec
  :db/cardinality :db.cardinality/one
  :db/doc "Exact decimal target for numeric grading. Symbolic/rational targets use expected-expression."}
 {:db/ident :grading-rule/expected-expression
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Machine-readable mathematical expression under the named evaluator."}
 {:db/ident :grading-rule/evaluator
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Evaluator identifier for a supported expression language or grading implementation."}
 {:db/ident :grading-rule/absolute-tolerance
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Nonnegative numeric tolerance in the answer units."}
 {:db/ident :grading-rule/relative-tolerance
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Nonnegative dimensionless relative tolerance."}
 {:db/ident :grading-rule/unit
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Expected physical units; conversion behavior must be defined by the evaluator."}
 {:db/ident :grading-rule/domain-edn
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Variable domains and assumptions serialized as EDN text."}
 {:db/ident :grading-rule/case-sensitive?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Case behavior for text grading."}
 {:db/ident :grading-rule/normalize-whitespace?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Whitespace normalization for text grading."}
 {:db/ident :grading-rule/partial-credit?
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Whether the evaluator may award a fractional score; exact rules belong in parameters-edn."}
 {:db/ident :grading-rule/reference-answer
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rich-text model answer for display, independently of machine grading."}
 {:db/ident :grading-rule/rubric
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Rubric for human or self assessment."}
 {:db/ident :grading-rule/required-features
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Required answer features for rubric or structural checks."}
 {:db/ident :grading-rule/parameters-edn
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Additional evaluator-specific options serialized as EDN text, validated by that evaluator."}

