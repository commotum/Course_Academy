;; Explicit local starting FIRe policy and question-selection distributions.
;; These reconstruction defaults are not claimed to be Math Academy parameters.
;; Install once before local learning; later edits update the existing owned records.
;; Selection weights are rounded E/M/H proportions informed by
;; reference/question-difficulty-observations-2026-10-03.json, not recovered MA parameters.
;; Initial: first two questions per lesson KP; first three per review.
;; This transaction creates configuration only, never learner history or progress.
[
 {:policy/id #uuid "f6218cf2-e157-5240-93c6-faafa321cfcd"
  :policy/base-half-life-days 1.0
  :policy/interval-growth 2.0
  :policy/maximum-half-life-days 36500.0
  :policy/review-threshold 0.5
  :policy/initial-retention 1.0
  :policy/early-practice-discount-power 1.0
  :policy/initial-accuracy 0.8
  :policy/accuracy-update-rate 0.2
  :policy/speed-exponent 2.0
  :policy/minimum-speed 0.25
  :policy/maximum-speed 4.0
  :policy/overdue-failure-slope 1.0
  :policy/maximum-failure-multiplier 4.0
  :policy/gate-slow-implicit true
  :policy/retention-update-order :policy.retention-update/decay-before-add
  :policy/future-horizon-days 7.0
  :policy/question-selection-weights
  [{:question-weights/activity-type :activity.type/lesson
    :question-weights/initial-easy 60.0
    :question-weights/initial-moderate 30.0
    :question-weights/initial-hard 10.0
    :question-weights/remedial-easy 45.0
    :question-weights/remedial-moderate 55.0
    :question-weights/remedial-hard 0.0
    :db/ensure :question-weights/validate}
   {:question-weights/activity-type :activity.type/review
    :question-weights/initial-easy 40.0
    :question-weights/initial-moderate 40.0
    :question-weights/initial-hard 20.0
    :question-weights/remedial-easy 90.0
    :question-weights/remedial-moderate 10.0
    :question-weights/remedial-hard 0.0
    :db/ensure :question-weights/validate}]
  :db/ensure :policy/validate}
]
