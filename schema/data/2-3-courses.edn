     :course-outcome/index 3
     :course-outcome/text "Describe vector spaces, subspaces, bases, dimension, rank, and null spaces, and apply the rank–nullity theorem."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "a37dbad7-9dc9-5b4f-bcb9-77a0365de020"
     :course-outcome/index 4
