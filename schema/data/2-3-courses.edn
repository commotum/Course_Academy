     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "b6778ac4-21f5-5aac-8189-013eed68f728"
     :course-outcome/index 6
     :course-outcome/text "Apply eigenvalue methods to analyze oscillatory systems and normal modes."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "1a3e83e5-5aa5-58d7-be20-eaeeca1d15e3"
     :course-outcome/index 7
     :course-outcome/text "Analyze multivariable functions using limits, continuity, partial derivatives, and higher-order derivatives."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "326a8202-ed44-5a7c-ab0c-1044958f5713"
     :course-outcome/index 8
     :course-outcome/text "Compute gradients, directional derivatives, and tangent planes to describe geometric and physical properties of surfaces."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "2a78b87a-ce5c-539e-a892-964b08b47748"
     :course-outcome/index 9
     :course-outcome/text "Apply coordinate transformations and Jacobians when analyzing transformations of regions."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "174d3d46-1688-5c3e-8745-005b0cd74920"
     :course-outcome/index 10
     :course-outcome/text "Work with vector-valued functions to describe motion, including velocity, acceleration, curvature, and geometric properties of curves."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "06a766e7-0927-5e52-b3e0-a45d2b87eb1d"
     :course-outcome/index 11
