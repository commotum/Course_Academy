    {:course-outcome/id #uuid "5859a1c7-ca7d-581b-a027-28dce462a49f"
     :course-outcome/index 16
     :course-outcome/text "Explore power series and Taylor polynomials, radius and intervals of convergence, Maclaurin and Taylor series, finding Maclaurin representations of functions using known power series, differentiating power series, and approximating integrals using Taylor series."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "263755b9-3aca-5977-a437-d9e2274c5597"
     :course-outcome/index 17
     :course-outcome/text "Gain proficiency in using graphing calculators for evaluating expressions, finding roots, intersections, extrema, derivatives, definite integrals, improper integrals, and exploring functions and curves."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "0b3505bd-5042-59ba-a98f-61cceacd99da"
     :course-outcome/index 18
     :course-outcome/text "Apply calculus concepts to real-world problems in physics, engineering, economics, and more."
     :db/ensure :course-outcome/validate}
   ]
