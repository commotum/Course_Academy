     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "aadf6e3d-5933-5047-9b60-a7d4848c7679"
     :course-outcome/index 13
     :course-outcome/text "Apply probability and continuous random variables to model uncertainty in physical systems."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "ddf92674-55b5-54ff-a05a-1e27a89015ed"
