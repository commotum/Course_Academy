    {:course-outcome/id #uuid "fc3dc12b-77f6-5698-81d4-1c01077f3195"
     :course-outcome/index 5
     :course-outcome/text "Understand how differentiation can be used to approximate functions and solve optimization problems."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "a04b8527-fc9c-52c1-a90c-5300feb91f56"
