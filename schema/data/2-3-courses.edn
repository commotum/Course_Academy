     :course-outcome/index 15
     :course-outcome/text "Model physical processes such as motion under drag, gravitational interaction, and electrical circuits using differential equations."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "e598cc1c-143b-56f9-896d-a36a441f5c9c"
