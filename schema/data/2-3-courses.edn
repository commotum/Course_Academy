     :course-outcome/index 3
     :course-outcome/text "Master determinants, including Laplace expansions, properties of determinants, Cramer's rule, computing determinants using row and column operations, and partitioned and block matrices."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "c8deb03c-161f-5719-b8b3-c80d890e60b2"
