     :course-outcome/index 9
     :course-outcome/text "Learn techniques for approximating definite integrals, such as using Riemann sums and the trapezoidal Rule."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "05e28cec-97ad-5182-ba3c-0145bc770b39"
     :course-outcome/index 10
     :course-outcome/text "Master the techniques for evaluating indefinite and definite integrals, including substitution, trigonometric identities, polynomial division, and completing the square."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "b5e35a9f-1792-5032-a8b9-641bdc3088cd"
