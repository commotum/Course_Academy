     :course-outcome/category "Integration Methods"
     :course-outcome/text "Approximate definite integrals using basic numerical integration rules."
     :db/ensure :course-outcome/validate}
    {:course-outcome/id #uuid "94786ab2-4a1a-5c1e-b76f-4f4f7bf220ca"
     :course-outcome/index 6
     :course-outcome/category "Integration Methods"
     :course-outcome/text "Evaluate improper integrals using limits and determine whether they converge."
