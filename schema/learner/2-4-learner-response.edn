;; One value entered by the learner for an answer field.
;; Linked through task-item/responses; selected choices reference answer entities directly.
[
 {:db/ident :learner-response/field
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Answer field receiving the learner's entered value."}

 {:db/ident :learner-response/value
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Text or LaTeX entered by the learner."}

 {:db/ident :learner-response/validate
  :db.entity/attrs [:learner-response/field :learner-response/value]
  :db/doc "Requires the answered field and entered value. The application checks that the field belongs to the presented question."}
]
