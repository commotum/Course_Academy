;; One learner-specific presentation of a question (including a worked example) or tutorial.
;; Owned through learner-task/items; content refers to the shared item presented.
[
 {:db/ident :task-item.status/started}
 {:db/ident :task-item.status/paused}
 {:db/ident :task-item.status/completed}
 {:db/ident :task-item.status/skipped}
 {:db/ident :task-item.status/correct}
 {:db/ident :task-item.status/incorrect}

 {:db/ident :task-item/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of this presentation, separate from the content ID."}

 {:db/ident :task-item/content
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Question, worked example question, or tutorial presented. May be absent when historical content identity is unknown."}

 {:db/ident :task-item/status
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Started means actively working; paused suspends the working timer. Completed ends a tutorial, worked example, or submitted question containing free fields whose responses are saved without automatic grading. Correct, incorrect, and skipped end automatically evaluated ordinary question attempts. Retained status history supplies timing. Free response completion does not assert correctness, performance, or mastery credit. Questions never presented do not create task items. Valid transitions and type-specific completion require application validation."}

 {:db/ident :task-item/responses
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "Answer entities submitted for this question: entered blank/free values, selected radio/select options, and explicit true or false answers for every checkbox field. Unchecked checkbox options submit false and are not unanswered. Recover each answer's field through reverse answer-field/choices ownership. At most one response per field; identical typed entered values are reused within that field and original strings are preserved. These ordinary refs do not own answers. A free response does not itself assert correct or incorrect."}

 {:db/ident :task-item/elapsed-seconds
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Accumulated seconds spent in started, calculated from this item's status transaction history. Paused intervals are excluded. The application updates this value and the parent task's elapsed total together, with at most one actively timed item per learner. Imported observed durations may be retained when their status history is unavailable."}

 {:db/ident :task-item/performance
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Calculated performance magnitude used by the engine. Positive and finite; may exceed one. Distinct from correctness and XP. Omit until evaluated; the application checks the range."}

 {:db/ident :task-item/working-periods
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Server-observed work intervals for asynchronously saved presentations. These intervals time learner work independently of delayed database commit times."}
 {:db/ident :working-period/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :working-period/started-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one}
 {:db/ident :working-period/ended-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one}

 {:db/ident :task-item/working-ended-at
  :db/valueType :db.type/instant
  :db/cardinality :db.cardinality/one
  :db/doc "Optional server-observed submission instant for a terminal question item. Working time ends here, excluding subsequent admission, grading, and database waits even when the status transaction commits later. Absent on older items. Imported duration checkpoints already contain this cutoff when present; dated summaries only count observed started intervals up to this instant."}

 {:db/ident :task-item/next
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional next presentation in the same learner task. Omit on the last item. This ordinary ref orders the task's existing members; learner-task/items remains their component owner. Derive the first item from the member with no incoming next link. The application checks that all members form one chain without cycles, merges, or links outside the task."}

 {:db/ident :task-item/deferred-step
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Authored knowledge-point stage deferred after this completed example or answered question because no fresh gradable questions were available. Keeps the practice unfinished while later lesson stages proceed; never a skip, failure, or mastery assertion. Application validates same-activity membership and exhaustion."}

 {:db/ident :task-item/resumed-step
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Authored knowledge-point stage revisited by this canonical-example presentation after finishing a lesson route with deferred practice. Replay resumes only outstanding stages and retains prior question outcomes and exposure history. Application validates that the stage was deferred in this task."}

 {:db/ident :task-item/validate
  :db.entity/attrs [:task-item/id :task-item/status]
  :db/doc "Requires presentation identity and status. The next link is optional; historical content may be unknown. Task membership, chain consistency, status transitions, and derived elapsed totals require application validation."}
]
