;; Question model for EDB. Install before creating question entities.
;; Request :db/ensure [:question/validate] when writing any question or worked example.
;; KP question-bank membership is stored through :knowledge-point/questions.
;; Answer fields are defined in 5-answer-field.edn; answer values are defined in 6-answer.edn.
;; Learner answers, timing, outcomes, and exposure history belong to task-item data.
;; Enum identities and attributes share one schema transaction.
[
 ;; Enum values: observed E/M/H difficulty categories.
 {:db/ident :question.difficulty/easy}
 {:db/ident :question.difficulty/moderate}
 {:db/ident :question.difficulty/hard}

 ;; Question attributes and validation.
 {:db/ident :question/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of a question or worked example. Individual presentations and submissions have separate identities; changing option order does not create a new question."}

 {:db/ident :question/math-academy-id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Optional prefixed Math Academy content identifier: q-N for a source question ID or e-N for a source example content ID. The prefixes prevent overlap in this unique attribute. Identifies content, not a presentation or learner attempt. Omit for independently created content."}

 {:db/ident :question/is-example
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "True for a demonstrated worked example; false for an ordinary gradable question. Worked examples require a worked solution but may have no answer fields. The application checks this flag and excludes examples from practice pools."}

 {:db/ident :question/difficulty
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional reference to an E/M/H difficulty enum entity observed in completed MA activity: :question.difficulty/easy, /moderate, or /hard. This is distinct from aggregate topic difficulty and learner ability. Omit when unknown; allowed values require validation."}

 {:db/ident :question/requires-calculator
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "Whether a calculator is required to answer the question. Captured MA instructions all express a requirement, sometimes specifying a scientific or graphing calculator. This boolean records the requirement only. False means not required, not forbidden; omit when unknown. Absence of a captured instruction alone does not establish false."}

 {:db/ident :question/problem
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Problem statement, stored as Markdown supporting LaTeX and image links. For gradable questions, named field locations correspond to answer-field/key on this question's fields. For examples, this is the demonstrated problem."}

 {:db/ident :question/answer-fields
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "Owned answer fields, required for ordinary gradable questions and optional for worked examples. A question may mix radio, blank, and select fields. Field keys identify their locations in the problem; example fields are read-only."}

 {:db/ident :question/worked-solution
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Worked solution for the whole problem, stored as Markdown supporting LaTeX and image links. Required for worked examples; optional for ordinary questions."}

 {:db/ident :question/validate
  :db.entity/attrs [:question/id :question/is-example :question/problem]
  :db/doc "Requires identity, example flag, and problem when explicitly ensured. The application conditionally requires answer fields for ordinary questions or a worked solution for examples, validates any present fields and answer values, and excludes examples from practice pools."}
]
