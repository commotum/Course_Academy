;; One answer field identifying a response location in a question.
;; Request :db/ensure [:answer-field/validate] for every field.
;; Writers and previews must register course-academy.answer-field/valid?.
[
 {:db/ident :answer-field.type/radio}
 {:db/ident :answer-field.type/blank}
 {:db/ident :answer-field.type/select}
 {:db/ident :answer-field.type/checkbox}
 {:db/ident :answer-field.type/free}

 {:db/ident :answer-field/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of a field owned by one question."}

 {:db/ident :answer-field/type
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Interaction type for this field: :answer-field.type/radio, /checkbox, /blank, /select, or /free. The application checks supported enum membership and type-specific interaction rules. Registering a type does not supply application rendering or evaluation."}

 {:db/ident :answer-field/key
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Key unique within the question, binding the field to a problem location such as x or y. A single radio field can use selection without an inline placeholder."}

 {:db/ident :answer-field/choices
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/isComponent true
  :db/doc "All answer values owned by this field, including authored options, canonical or reference answers, and verbatim learner-entered blank/free responses. Each answer belongs to one field; reuse identical typed values within that field. Radio/select display authored options; blank/free display editors without the bank. Each checkbox option is a separate field owning two text values, true and false. An optional free reference, or the required canonical answer for another type, must belong to this bank. An unanswered free field may have no bank members. Preserve values referenced by task-item/responses."}

 {:db/ident :answer-field/correct
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "One canonical answer, required for radio, select, blank, and checkbox fields; optional reference answer for a free field. When present, it must belong to the field's choices bank. Free references are revealed for comparison without automatic grading. This ordinary ref does not add ownership."}

 {:db/ident :answer-field/validate
  :db.entity/attrs [:answer-field/id :answer-field/key :answer-field/type]
  :db.entity/preds [course-academy.answer-field/valid?]
  :db/doc "Requires identity, key, and type when explicitly ensured. The type-specific predicate validates owned answer values and canonical membership. Radio, select, blank, and checkbox require a nonempty bank and one canonical answer. Free permits an empty bank and no reference answer. Checkbox banks contain exactly two text answers, true and false. Writers also ensure answer/validate. Question field-key uniqueness, immutable referenced values, entered-answer reuse, and response completeness require application handling."}
]
