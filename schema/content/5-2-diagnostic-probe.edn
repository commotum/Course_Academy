;; One question and its outcome branches, owned through diagnostic/probes.
;; Branches reference other probes in the same diagnostic, not bare questions.
;; Request :db/ensure [:diagnostic-probe/validate] when writing a probe.
[
 {:db/ident :diagnostic-probe/id
  :db/valueType :db.type/uuid
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Stable identity of a probe in one diagnostic, distinct from its question's identity."}

 {:db/ident :diagnostic-probe/question
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Question presented by this probe. Derive its topic through knowledge-point/questions and topic/knowledge-points. This ordinary ref preserves question-bank content when the probe is deleted."}

 {:db/ident :diagnostic-probe/on-correct
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Next probe after a correct answer. Omit when this outcome ends the diagnostic."}

 {:db/ident :diagnostic-probe/on-incorrect
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Next probe after an incorrect answer when no retry is taken. Omit when this outcome ends the diagnostic."}

 {:db/ident :diagnostic-probe/on-skipped
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Next probe when the learner explicitly skips the presented question. Omit when this outcome ends the diagnostic. Unpresented questions do not take this branch."}

 {:db/ident :diagnostic-probe/on-silly-mistake
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "Optional alternate probe taken when the learner accepts a retry after a submitted incorrect answer. Use a different question on the same topic at the same difficulty, distinguishable from the ordinary incorrect continuation. The completed retry replaces the original result for frontier placement; both presentations remain in history. The application offers the available retry without a timing gate; skips receive no retry. Omit this branch on the alternate probe to allow only one retry."}

 {:db/ident :diagnostic-probe/validate
  :db.entity/attrs [:diagnostic-probe/id :diagnostic-probe/question]
  :db/doc "Requires identity and question when explicitly ensured. All branches, including on-silly-mistake, are optional. Missing correct, incorrect, or skipped branches end the diagnostic for that outcome; a missing silly-mistake branch means no retry is offered. The application checks that the question resolves to one topic, branch targets belong to the same diagnostic, retries use an appropriate alternate, and paths terminate. Validate referenced content separately."}
]
