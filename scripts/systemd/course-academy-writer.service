[Unit]
Description=Course Academy math EDB writer
Wants=course-academy-math-postgres.service
After=course-academy-math-postgres.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=%h/Developer/Course_Academy
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment=EDB_DATABASE=math
Environment=EDB_ENDPOINT=/tmp/edb-math/writer.sock
ExecStart=/bin/bash %h/Developer/Course_Academy/scripts/start_local_edb.sh --writer
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45
KillMode=mixed
UMask=0077
