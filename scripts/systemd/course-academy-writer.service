[Unit]
Description=Course Academy EDB writer
Wants=course-academy-postgres.service
After=course-academy-postgres.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=%h/Developer/Course_Academy
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment=EDB_DATABASE=course-academy-v2
Environment=EDB_ENDPOINT=/tmp/course-academy-edb-v2/writer.sock
ExecStart=/usr/bin/python3 %h/Developer/Course_Academy/scripts/run_local_edb_service.py
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=45
KillMode=mixed
UMask=0077
