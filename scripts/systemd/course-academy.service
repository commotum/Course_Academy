[Unit]
Description=Course Academy study app
Wants=course-academy-writer.service
After=course-academy-writer.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Developer/Course_Academy
Environment="PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/Developer/Course_Academy/scripts/serve_graph_explorer.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=default.target
