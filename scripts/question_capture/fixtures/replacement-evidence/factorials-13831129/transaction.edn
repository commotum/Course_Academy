{:db/id [:question/math-academy-id "q-5371"] :question/difficulty :question.difficulty/easy :question/worked-solution "First, notice that $6!=6\\cdot 5\\cdot 4\\cdot 3!\\,.$ Then, we can cancel the $3!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{6!}{3!} & =\\frac{6\\cdot 5\\cdot 4\\cdot 3!}{3!} \\\\ & =\\frac{6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\ & =\\frac{6\\cdot 5\\cdot 4}{1} \\\\ & =120\\end{aligned}\n$$" :db/ensure [:question/validate]}
{:db/id "q-73014" :question/id #uuid "1408bd84-c96c-5280-b5b8-d6e145ac8562" :question/math-academy-id "q-73014" :question/is-example false :question/problem "Evaluate $\\frac{11!}{8!}$." :question/difficulty :question.difficulty/easy :question/worked-solution "First, notice that $11!=11\\cdot 10\\cdot 9\\cdot 8!\\,.$ Then, we can cancel the $8!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{11!}{8!} & =\\frac{11\\cdot 10\\cdot 9\\cdot 8!}{8!} \\\\ & =\\frac{11\\cdot 10\\cdot 9\\cdot \\cancel{8!}}{\\cancel{8!}} \\\\ & =\\frac{11\\cdot 10\\cdot 9}{1} \\\\ & =990\\end{aligned}\n$$" :question/answer-fields [{:answer-field/id #uuid "5d9e3c3a-cd67-5442-a661-07d01a361455" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices [{:db/id "q-73014-value-0" :answer/id #uuid "6b482424-a210-524a-905d-ff86d23c78f4" :answer/type :answer.type/math :answer/value "990" :db/ensure [:answer/validate]} {:db/id "q-73014-value-1" :answer/id #uuid "7343e1da-4882-5e1f-99e8-82ad53f31338" :answer/type :answer.type/math :answer/value "110" :db/ensure [:answer/validate]} {:db/id "q-73014-value-2" :answer/id #uuid "3942336f-78e5-5f38-9523-e4863e476409" :answer/type :answer.type/math :answer/value "7920" :db/ensure [:answer/validate]} {:db/id "q-73014-value-3" :answer/id #uuid "4bcad94d-4edb-5ca4-90ff-9342077bfedb" :answer/type :answer.type/math :answer/value "39916800" :db/ensure [:answer/validate]}] :answer-field/correct "q-73014-value-0" :db/ensure [:answer-field/validate]}] :db/ensure [:question/validate]}
