{:db/id "q-124403" :question/id #uuid "7fe8b4ea-8f5a-578f-ae1f-c044f9390105" :question/math-academy-id "q-124403" :question/is-example false :question/problem "$4!+0!=$" :question/difficulty :question.difficulty/easy :question/worked-solution "The given expression is a sum of two factorials.\n\n- Computing $4!$ using the definition, we get\n\n$$\n4!=4\\cdot 3\\cdot 2\\cdot 1=24.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0!=1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}4!+0! & =24+1=25\\end{aligned}\n$$" :question/answer-fields [{:answer-field/id #uuid "fbe364c4-9a7b-5efa-993b-9ec0b7348b2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices [{:db/id "q-124403-value-0" :answer/id #uuid "964bae73-043c-5b99-8c7a-412a5337b4b8" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-124403-value-1" :answer/id #uuid "90f0d15b-a777-51ce-a012-0042eccd4411" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-124403-value-2" :answer/id #uuid "8a2cb0af-6e10-5233-a1bf-500305a1d903" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-124403-value-3" :answer/id #uuid "9919add7-e9a8-5cb3-9390-1e74a2699822" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-124403-value-4" :answer/id #uuid "85389526-c1e7-58a5-bb36-42b1d19078a7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]}] :answer-field/correct "q-124403-value-0" :db/ensure [:answer-field/validate]}] :db/ensure [:question/validate]}
