{:db/id "q-124400" :question/id #uuid "fd7f5187-ef6d-5c98-91bb-10694ffccd55" :question/math-academy-id "q-124400" :question/is-example false :question/problem "$0!\\,7!=$" :question/difficulty :question.difficulty/easy :question/worked-solution "The given expression is a product of two factorials.\n\n- Computing $7!$ using the definition, we get\n\n$$\n7!=7\\cdot 6\\cdot 5\\cdot 4\\cdot 3\\cdot 2\\cdot 1=5\\,040.\n$$\n\n- By definition, the factorial of zero equals one:\n\n$$\n0!=1\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}0!\\,7! & =1\\cdot 5\\,040=5\\,040\\end{aligned}\n$$" :question/answer-fields [{:answer-field/id #uuid "c462fc22-6895-547e-ade6-95adfe08139c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices [{:db/id "q-124400-value-0" :answer/id #uuid "e58c0039-72cf-5264-88f5-01aaa886315d" :answer/type :answer.type/math :answer/value "5040" :db/ensure [:answer/validate]} {:db/id "q-124400-value-1" :answer/id #uuid "3700f772-8137-52fb-bfba-0ae0a17ad744" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-124400-value-2" :answer/id #uuid "598ce88b-ac8c-5218-9159-6a29d5d64a98" :answer/type :answer.type/math :answer/value "5041" :db/ensure [:answer/validate]} {:db/id "q-124400-value-3" :answer/id #uuid "18564d10-5fa3-5ab7-8cc9-8cd4bd4caf81" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-124400-value-4" :answer/id #uuid "37410c65-1be8-5bd1-b46a-828705213dc3" :answer/type :answer.type/math :answer/value "40320" :db/ensure [:answer/validate]}] :answer-field/correct "q-124400-value-0" :db/ensure [:answer-field/validate]}] :db/ensure [:question/validate]}
