{:db/id "q-122033" :question/id #uuid "498a4446-b5b5-5f82-b6ba-bdfe24dcd449" :question/math-academy-id "q-122033" :question/is-example false :question/problem "$3!\\,4!=$" :question/difficulty :question.difficulty/moderate :question/worked-solution "The given expression is a product of two factorials.\n\n- Computing $3!$ using the definition, we get\n\n$$\n3!=3\\cdot 2\\cdot 1=6.\n$$\n\n- Computing $4!$ using the definition, we get\n\n$$\n4!=4\\cdot 3\\cdot 2\\cdot 1=24.\n$$\n\nFinally, we can evaluate the given expression:\n\n$$\n\\begin{aligned}3!\\,4! & =3!\\cdot 4! \\\\ & =6\\cdot 24 \\\\ & =144\\end{aligned}\n$$" :question/answer-fields [{:answer-field/id #uuid "81a90f5b-b763-5a75-a2d0-d3a42f8f7280" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices [{:db/id "q-122033-value-0" :answer/id #uuid "de5043c0-839f-5080-a482-f0bc6ad91224" :answer/type :answer.type/math :answer/value "144" :db/ensure [:answer/validate]} {:db/id "q-122033-value-1" :answer/id #uuid "f352b9db-f851-5436-8e15-9b609849d221" :answer/type :answer.type/math :answer/value "72" :db/ensure [:answer/validate]} {:db/id "q-122033-value-2" :answer/id #uuid "c56dab15-0057-5af9-8505-fc627450caea" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-122033-value-3" :answer/id #uuid "c271dc59-0268-59bf-843b-65544beca73c" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-122033-value-4" :answer/id #uuid "6666d504-3659-517b-b324-6d0750aaa850" :answer/type :answer.type/math :answer/value "5040" :db/ensure [:answer/validate]}] :answer-field/correct "q-122033-value-0" :db/ensure [:answer-field/validate]}] :db/ensure [:question/validate]}
