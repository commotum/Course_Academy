\  & =-18 + 48 e^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["50f558ba-5ac1-5f2d-94f2-8f408ce11078"] :db/ensure :question/validate} {:db/id "generator" :question-generator/id #uuid "c0f94114-d881-5eba-937b-16347aa0a14c" :question-generator/script "generate/scratch/17592186133878.py"} [:db/add 17592186133878 :knowledge-point/question-generator "generator"] {:db/id 17592186133878 :knowledge-point/questions ["cb2e2e55-8936-54d7-a33c-03469d398524" "10952efb-f91e-5efa-8836-2bdfa5e4547d" "7f288c44-ccaa-54db-bd90-19654202c121" "cd1bb89c-9ca9-5d27-95e0-43a9165543a7" "55b9003c-2f9b-5f89-8acf-67ac21d03597" "edc4ddd0-1255-518c-9176-4cb2e8db04ff"]} [:db/ensure 17592186133878 :knowledge-point/validate]]
