t(-1\\right) \\\\  & =3 - 8 e.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["7a696714-c0a6-58d5-a9b9-4ec27d224ce0"] :db/ensure :question/validate} {:db/id "48fd3aa2-5c7d-540a-8ffd-5be89dfb1429" :answer/id #uuid "48fd3aa2-5c7d-540a-8ffd-5be89dfb1429" :answer/type :answer.type/math :answer/value "10 + 4 e" :db/ensure :answer/validate} {:db/id "cd403008-fbc5-583c-96a7-a0c78f2b027d" :answer/id #uuid "cd403008-fbc5-583c-96a7-a0c78f2b027d" :answer/type :answer.type/math :answer/value "2 + 4 e" :db/ensure :answer/validate} {:db/id "9c99bae7-2dc2-5b64-885b-d754ce59bea4" :answer/id #uuid "9c99bae7-2dc2-5b64-885b-d754ce59bea4" :answer/type :answer.type/math :answer/value "4" :db/ensure :answer/validate} {:db/id "29a2220e-715f-57f8-8743-057e266ca318" :answer/id #uuid "29a2220e-715f-57f8-8743-057e266ca318" :answer/type :answer.type/math :answer/value "- 4 e - 2" :db/ensure :answer/validate} {:db/id "6546aaf9-7cff-56ea-b59f-85e4aeb74c05" :answer/id #uuid "6546aaf9-7cff-56ea-b59f-85e4aeb74c05" :answer/type :answer.type/math :answer/value "6 + 4 e" :db/ensure :answer/validate} {:db/id "7c5d2f31-c569-5ce6-b4d2-c54ef953da59" :answer-field/id #uuid "7c5d2f31-c569-5ce6-b4d2-c54ef953da59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["48fd3aa2-5c7d-540a-8ffd-5be89dfb1429" "cd403008-fbc5-583c-96a7-a0c78f2b027d" "9c99bae7-2dc2-5b64-885b-d754ce59bea4" "29a2220e-715f-57f8-8743-057e266ca318" "6546aaf9-7cff-56ea-b59f-85e4aeb74c05"] :answer-field/correct "cd403008-fbc5-583c-96a7-a0c78f2b027d" :db/ensure :answer-field/validate} {:db/id "55b9003c-2f9b-5f89-8acf-67ac21d03597" :question/id #uuid "55b9003c-2f9b-5f89-8acf-67ac21d03597" :question/problem "Let $f(x,y,z)=x y^{2} + 3 x y z.$ Given that $C$ is the path along the curve $r(t)=⟨e^{t},t + 1,e^{- t}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨1,1,1⟩ \\\\ r(1) & =⟨e,2,e^{-1}⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(1,1,1)$ and $(e,2,e^{-1}).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(e,2,e^{-1})-f(1,1,1) \\\\  & =\\left(\\left(e\\right) \\left(2\\right)^{2} + 3 \\left(e\\right) \\left(2\\right) \\left(e^{-1}\\right)\\right)-\\left(\\left(1\\right) \\left(1\\right)^{2} + 3 \\left(1\\right) \\left(1\\right) \\left(1\\right)\\right) \\\\  & =\\left(6 + 4 e\\right)-\\left(4\\right) \\\\  & =2 + 4 e.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["7c5d2f31-c569-5ce6-b4d2-c54ef953da59"] :db/ensure :question/validate} {:db/id "16055ec6-dd35-5ae8-b9b2-8fae66b219d5" :answer/id #uuid "16055ec6-dd35-5ae8-b9b2-8fae66b219d5" :answer/type :answer.type/math :answer/value "-18 + 48 e^{2}" :db/ensure :answer/validate} {:db/id "f1b76274-e3bf-518f-9866-77422b19ef84" :answer/id #uuid "f1b76274-e3bf-518f-9866-77422b19ef84" :answer/type :answer.type/math :answer/value "6" :db/ensure :answer/validate} {:db/id "29033b82-e62d-5eff-869f-6e3c77aa79fc" :answer/id #uuid "29033b82-e62d-5eff-869f-6e3c77aa79fc" :answer/type :answer.type/math :answer/value "-6 + 48 e^{2}" :db/ensure :answer/validate} {:db/id "d22d355c-0046-5ecf-842d-6e656cb61b45" :answer/id #uuid "d22d355c-0046-5ecf-842d-6e656cb61b45" :answer/type :answer.type/math :answer/value "18 - 48 e^{2}" :db/ensure :answer/validate} {:db/id "557cbc89-6a9c-59ae-af39-2498105ed609" :answer/id #uuid "557cbc89-6a9c-59a