} - 1}{y^{2} + 3}.$" 13194139536075 17592186045443 true] [17592186564735 1072 #uuid "3215c48d-3351-57bf-9ea3-261b833ecac9" 13194139536075 17592186045443 true] [17592186564735 1074 "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{3 x^{2} - 1}{y^{2} + 3} \\\\ (y^{2} + 3)\\,\\frac{\\text{d}y}{\\text{d}x} & =3 x^{2} - 1\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int (y^{2} + 3)\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (3 x^{2} - 1)\\,\\text{d}x \\\\ \\int (y^{2} + 3)\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int (3 x^{2} - 1)\\,\\text{d}x \\\\ \\int (y^{2} + 3)\\,\\text{d}y & =\\int (3 x^{2} - 1)\\,\\text{d}x \\\\ \\int y^2\\,\\text{d}y+\\int 3\\,\\text{d}y & =\\int 3x^2\\,\\text{d}x-\\int 1\\,\\text{d}x \\\\ \\frac{y^3}{3}+3y & =\\frac{3x^3}{3}-1x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{y^{3}}{3} + 3 y=x^{3} - x+C.\n$$" 13194139536075 17592186045443 true] [17592186564736 1080 "\\frac{y^{3}}{3}=x^{3} - 2 x+C" 13194139536075 17592186045443 true] [17592186564736 1082 #edb/ref 17592186045498 13194139536075 17592186045443 true] [17592186564736 1083 #uuid "3414c5d2-20cf-5914-a9a9-332d71670cb0" 13194139536075 17592186045443 true] [17592186564737 1080 "\\frac{y^{3}}{3} + y=- \\frac{5 x^{3}}{3} - x+C" 13194139536075 17592186045443 true] [17592186564737 1082 #edb/ref 17592186045498 13194139536075 17592186045443 true] [17592186564737 1083 #uuid "350cacb7-df00-5ad5-a272-e0602f516b58" 13194139536075 17592186045443 true] [17592186564738 1080 "\\frac{y^{3}}{3} + 3 y=2 x^{3} - 2 x+C" 13194139536075 17592186045443 true] [17592186564738 1082 #edb/ref 17592186045498 13194139536075 17592186045443 true] [17592186564738 1083 #uuid "353ed623-65d6-5d33-a582-bf0bcd71ae20" 13194139536075 17592186045443 true] [17592186564739 1080 "\\frac{y^{3}