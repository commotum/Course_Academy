2}) \\\\  & =2\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =2(-1) \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(0,-2).$"} {:db/id #edb/ref 17592186284681 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7d1dc9-08a0-5c97-af85-8958c4f26edc" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-2\\sqrt{3})" :db/id #edb/ref 17592186281972} {:answer/id #uuid "630c3a59-ef83-541f-b9f3-e86f0db79abb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,\\sqrt{3})" :db/id #edb/ref 17592186282540} {:answer/id #uuid "6d760ce6-7b53-5b17-95f0-2a701da851f0" :answer/type {:db/ident :answer.type/math} :answer/value "(2,\\sqrt{3})" :db/id #edb/ref 17592186282625} {:answer/id #uuid "6fda8237-6723-59bd-aa75-aa04c8fefcec" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186282646} {:answer/id #uuid "8297ba5c-921d-5ae0-bd90-2ee58b877b3a" :answer/type {:db/ident :answer.type/math} :answer/value "(2,2\\sqrt{3})" :db/id #edb/ref 17592186282817}] :answer-field/correct {:answer/id #uuid "6fda8237-6723-59bd-aa75-aa04c8fefcec" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186282646} :answer-field/id #uuid "684d27ef-fb36-5be2-9f3b-9d537878d018" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284107}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0cbc4e4b-2d27-5640-8947-f02e086abba5" :question/math-academy-id "q-17134" :question/problem "Given that the distance from a point $P$ to the origin is $4,$ and that $P$ makes an angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=4,\\,\\theta =\\frac{4\\pi }{3}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =4\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\ x & =4(-\\frac{1}{2}) \\\\ x & =-2\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =4\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\ y & =4(-\\frac{\\sqrt{3}}{2}) \\\\ y & =-2\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2,-2\\sqrt{3}).$"} {:db/id #edb/ref 17592186284682 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0068e4a5-cb28-5519-9eed-397f1fd495ba" :answer/type {:db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186281690} {:answer/id #uuid "24c5f2d9-5d73-5dfb-8877-22831e9dfcc2" :answer/type {:db/ident :answer.type/math} :answer/value "(7,1)" :db/id #edb/ref 17592186282010} {:answer/id #uuid "2fc39e53-d504-5253-a096-83f4724ee131" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186282113} {:answer/id #uuid "62a281e2-ead9-5741-8c03-34eb83922464" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186282534} {:answer/id #uuid "eba4daee-0b6f-57bd-8eb5-6f8a3b202d40" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,0)" :db/id #edb/ref 17592186283748}] :answer-field/correct {:answer/id #uuid "2fc39e53-d504-5253-a096-83f4724ee131" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186282113} :answer-field/id #uuid "f111caec-f6e3-5cc4-a5b9-929e5f8a60b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284361}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dbe89916-9884-50d0-99bb-1478386ff8b6" :question/math-academy-id "q-17137" :question/problem "Given that the distance from a point $P$ to the origin is $7,$ and that $P$ makes an angle of $0$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=7,\\,\\theta =0.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =7\\operatorname{cos}⁡(0) \\\\ x & =7\\cdot 1 \\\\ x & =7\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =7\\operatorname{sin}⁡(0) \\\\ y & =7\\cdot 0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(7,0).$"} {:db/id #edb/ref 17592186294874 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ac03d3b-2532-57c0-b9b4-500023e08f39" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186293241}] :answer-field/correct {:answer/id #uuid "4ac03d3b-2532-57c0-b9b4-500023e08f39" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186293241} :answer-field/id #uuid "5dfdbeb0-5188-55a0-995a-50f79130fd12" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294263} {:answer-field/choices [{:answer/id #uuid "bad2a675-9325-5f9e-98e8-a2644c41a27d" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186293659}] :answer-field/correct {:answer/id #uuid "bad2a675-9325-5f9e-98e8-a2644c41a27d" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186293659} :answer-field/id #uuid "a5869a77-39c9-5092-ba56-1653742daea3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3bdc99cf-7f58-58bc-8d19-759a3c38b4ba" :question/math-academy-id "q-276786" :question/problem "If the distance from a point $P$ to the origin is $8,$ and that $P$ makes an angle of $\\frac{7\\pi }{4}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=8,\\,\\theta =\\frac{7\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\cdot \\operatorname{cos}⁡(\\frac{7\\pi }{4}) \\\\  & =8\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\cdot \\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =8\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(4\\sqrt{2},-4\\sqrt{2}).$"} {:db/id #edb/ref 17592186294876 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8687607-80ff-5873-a6e5-4e7b5b0a8602" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293711}] :answer-field/correct {:answer/id #uuid "c8687607-80ff-5873-a6e5-4e7b5b0a8602" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186293711} :answer-field/id #uuid "687ed8c9-f3bb-5447-b65d-0661ab582ddb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294295} {:answer-field/choices [{:answer/id #uuid "9f01dce6-e066-51e9-8e04-c9e737fc1a0f" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186293562}] :answer-field/correct {:answer/id #uuid "9f01dce6-e066-51e9-8e04-c9e737fc1a0f" :answer/type {:db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186293562} :answer-field/id #uuid "f1e1cb57-225d-5cba-8410-44dfe2c60e0f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294776}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bfa9ea2c-dfab-54c2-ba47-4e82fd54912f" :question/math-academy-id "q-276791" :question/problem "If the distance from a point $P$ to the origin is $12,$ and that $P$ makes an angle of ${60}^{∘}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=12,\\,\\theta ={60}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\cdot \\operatorname{cos}⁡({60}^{∘}) \\\\  & =12\\cdot (\\frac{1}{2}) \\\\  & =6\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\cdot \\operatorname{sin}⁡({60}^{∘}) \\\\  & =12\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =6\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(6,6\\sqrt{3}).$"} {:db/id #edb/ref 17592186294878 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76b9b4bb-41ee-5123-9c9a-81ee28b29a2c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186293419}] :answer-field/correct {:answer/id #uuid "76b9b4bb-41ee-5123-9c9a-81ee28b29a2c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186293419} :answer-field/id #uuid "62f664e1-3397-5fc8-8997-d85966d501de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294281} {:answer-field/choices [{:answer/id #uuid "3e8a5a4c-630b-516e-b8e0-968782ed3ec0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186293182}] :answer-field/correct {:answer/id #uuid "3e8a5a4c-630b-516e-b8e0-968782ed3ec0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186293182} :answer-field/id #uuid "9ff41a97-f9b0-5355-aeb2-b3b9a775f59b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186294507}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a88a0577-f66a-514f-9dd3-d71688a75644" :question/math-academy-id "q-276798" :question/problem "If the distance from a point $P$ to the origin is $3,$ and that $P$ makes an angle of ${240}^{∘}$ with the positive $x$-axis, then the Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta )$, where\n\n$$\nr=3,\\,\\theta ={240}^{∘}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\cdot \\operatorname{cos}⁡({240}^{∘}) \\\\  & =3\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\cdot \\operatorname{sin}⁡({240}^{∘}) \\\\  & =3\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{3}{2},-\\frac{3\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186354398 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040aa995-2a95-5978-ae2e-5bf3e64df54b" :answer/type {:db/ident :answer.type/math} :answer/value "(4\\sqrt{3},2\\sqrt{3})" :db/id #edb/ref 17592186351604} {:answer/id #uuid "327eef0b-6d33-56b7-b7fa-65647e6064b0" :answer/ty