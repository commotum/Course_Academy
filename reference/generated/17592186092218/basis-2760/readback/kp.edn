edge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "753543d7-b063-5cf6-b128-a80a7409bfa6" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{\\sqrt{2}}{4},-\\frac{\\sqrt{2}}{4})" :db/id #edb/ref 17592186282693} {:answer/id #uuid "76d18bf0-adc0-56ad-a666-eb6830554a32" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{\\sqrt{2}}{2},-\\frac{\\sqrt{2}}{2})" :db/id #edb/ref 17592186282705} {:answer/id #uuid "9e0cfff2-f165-5112-84b4-84ef6d0d16d8" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{\\sqrt{2}}{3},-\\frac{\\sqrt{2}}{3})" :db/id #edb/ref 17592186283067} {:answer/id #uuid "b46da797-d4b1-5e93-b5d2-956b71f67813" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{\\sqrt{2}}{6},-\\frac{\\sqrt{2}}{6})" :db/id #edb/ref 17592186283252} {:answer/id #uuid "e9302e03-d1d5-5540-a03c-b0e2ce178144" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{\\sqrt{2}}{5},-\\frac{\\sqrt{2}}{5})" :db/id #edb/ref 17592186283723}] :answer-field/correct {:answer/id #uuid "b46da797-d4b1-5e93-b5d2-956b71f67813" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{\\sqrt{2}}{6},-\\frac{\\sqrt{2}}{6})" :db/id #edb/ref 17592186283252} :answer-field/id #uuid "24c6099d-d0ba-56c6-9aa9-eadf358e9b15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8753c4e-3481-5eda-bb21-d60f3fd06725" :question/math-academy-id "q-17124" :question/problem "Given that the distance from a point $P$ to the origin is $\\frac{1}{3},$ and that $P$ makes an angle of $\\frac{5\\pi }{4}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=\\frac{1}{3},\\,\\theta =\\frac{5\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =\\frac{1}{3}\\operatorname{cos}⁡(\\frac{5\\pi }{4}) \\\\ x & =\\frac{1}{3}(\\frac{-\\sqrt{2}}{2}) \\\\ x & =-\\frac{\\sqrt{2}}{6}\\end{aligned}\n$$\n\nThen we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =\\frac{1}{3}\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\ y & =\\frac{1}{3}(\\frac{-\\sqrt{2}}{2}) \\\\ y & =-\\frac{\\sqrt{2}}{6}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{\\sqrt{2}}{6},-\\frac{\\sqrt{2}}{6}).$"} {:db/id #edb/ref 17592186284679 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6579eacc-068b-5cac-8c3b-3d0005500a11" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186282560} {:answer/id #uuid "77f0a4c2-79c0-54cd-8fc3-9692d5df1551" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186282714} {:answer/id #uuid "88c83019-e455-582f-ae36-d2343335742f" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},-\\sqrt{3})" :db/id #edb/ref 17592186282869} {:answer/id #uuid "9919d5ba-4b95-5580-84fc-627c631faff2" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\sqrt{2},-\\sqrt{2})" :db/id #edb/ref 17592186283018} {:answer/id #uuid "baa4a7a7-5652-5d2b-84aa-4fd087f99b43" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},-\\sqrt{2})" :db/id #edb/ref 17592186283299}] :answer-field/correct {:answer/id #uuid "baa4a7a7-5652-5d2b-84aa-4fd087f99b43" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2},-\\sqrt{2})" :db/id #edb/ref 17592186283299} :answer-field/id #uuid "6fa5c78f-ca4a-5dae-af0e-6861f5fb66c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284121}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6312ff71-6d99-5de0-8860-37b893c00f52" :question/math-academy-id "q-17126" :question/problem "Given that the distance from a point $P$ to the origin is $2,$ and that $P$ makes an angle of $\\frac{7\\pi }{4}$ with the positive $x$-axis, what are the Cartesian coordinates of $P?$" :question/worked-solution "We notice that the point $P$ is described using polar coordinates $(r,\\theta ),$ where\n\n$$\nr=2,\\,\\theta =\\frac{7\\pi }{4}.\n$$\n\nTo convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\ x & =2\\operatorname{cos}⁡(\\frac{7\\pi }{4}) \\\\ x & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\ x & =\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\ y & =2\\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\ y & =2(-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(\\sqrt{2},-\\sqrt{2}).$"} {:db/id #edb/ref 17592186284680 :knowledge-point/_questions [{:knowledge-point/id #uuid "87f80908-037b-56ae-a2b5-59bdc49f0acb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given a Description of the Radius and Angle"}] :question/answer-fields [{:answer-fie