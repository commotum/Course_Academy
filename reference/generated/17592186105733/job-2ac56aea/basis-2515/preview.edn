pective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{705}}{2}.\n$$" 13194139535828 17592186045443 true] [17592186530849 1080 "2" 13194139535828 17592186045443 true] [17592186530849 1082 #edb/ref 17592186045498 13194139535828 17592186045443 true] [17592186530849 1083 #uuid "f8083c90-dd25-532f-a683-fbef59b2240d" 13194139535828 17592186045443 true] [17592186530850 1080 "1" 13194139535828 17592186045443 true] [17592186530850 1082 #edb/ref 17592186045498 13194139535828 17592186045443 true] [17592186530850 1083 #uuid "fdd39de1-2821-5e1a-ac29-859d1dc8b192" 13194139535828 17592186045443 true] [17592186530851 1168 "generate/scratch/17592186105733.py" 13194139535828 17592186045443 true] [17592186530851 1169 #uuid "4931185c-6c35-575c-b06d-98c6fa966ef6" 13194139535828 17592186045443 true]] :edb/tempids {"00b5a4a1-037c-5c23-ab2f-91d5e2368598" 17592186530781 "086b28b8-2f00-5cb7-9a9b-33a0bb35a463" 17592186530782 "0996cec4-943d-5dc2-aad8-fb7a8fd031b4" 17592186530783 "09d88d5b-ce0e-5f1d-83e8-14d31db29346" 17592186530784 "0aba964f-912f-5c11-ba41-4f08d7d851a0" 17592186530785 "1a3aec82-ec8f-58f2-b9b2-fdff35886aa6" 17592186530786 "1c91fca4-1a47-542b-92ef-c0df31262767" 17592186530787 "1f716af9-0180-5b87-b139-f9ae40fa13c3" 17592186530788 "1fc0d6d3-68d3-53c1-9126-183c39fa054f" 17592186530789 "1fe13558-c04f-55d0-9b8b-2599812b93b7" 17592186530790 "239f428d-4367-5f63-8950-0dae6f9df5dc" 17592186530791 "2dde6928-3f9f-5db5-a31c-0089fe841550" 17592186530792 "33802d27-dd89-5a46-aaaf-65bd2ba0847d" 17592186530793 "3421f176-ac70-50d9-9c98-b8851842557d" 17592186530794 "370af184-fb4c-5e45-b1c5-eae2346255f4" 17592186530795 "39fca8c4-ffab-5662-910d-94763a8cdf68" 17592186530796 "3b685097-5fff-5c5d-9a28-b20462013563" 17592186530797 "3c255ebd-4d34-5ced-b13a-f051713a6fb7" 17592186530798 "443c0fc9-7bb8-5490-a6e4-cec9131ff874" 17592186530799 "472aa6f2-32cd-5acd-ad50-82088699ad78" 17592186530800 "56bbec4c-fba7-5b9f-84f8-58792e66d75b" 17592186530801 "5816e6f4-de9c-59d6-8