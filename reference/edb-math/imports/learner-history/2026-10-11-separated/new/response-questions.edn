#{["q-103560" {:db/id #edb/ref 17592186087969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13a4f93-e1f9-5884-a39c-c79a4bcb3e3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\frac{dy}{dx} - x^{2}y = x\\sin x" :db/id #edb/ref 17592186084549} {:answer/id #uuid "c3444d68-c1e5-5947-a906-9f7391cdd707" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dx} - \\frac{e^{x}}{x}y = x^{3}" :db/id #edb/ref 17592186084550} {:answer/id #uuid "d6b4eab8-6e07-5ae7-96d3-a9034a47b11e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\frac{dy}{dx} - 4xy = \\sqrt{x}" :db/id #edb/ref 17592186084551} {:answer/id #uuid "2f0bf6cc-cd01-5352-adcb-7f989d4f9813" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dx} - x^{2} = \\frac{1}{1 - y}" :db/id #edb/ref 17592186084552} {:answer/id #uuid "511a9ab3-97fa-5de3-a077-f939d6fb35ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{dy}{dx} - (\\tan x)y = \\sec x" :db/id #edb/ref 17592186084553}] :answer-field/id #uuid "0c68cfab-095b-58cc-9da7-ba0916b77f5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186084548}] :question/id #uuid "8d7eb342-85c3-52e0-b57f-d62a1be729ce" :question/math-academy-id "q-103560" :question/problem "Which of the following is **NOT** a first order linear ordinary differential equation?"}] ["q-105256" {:db/id #edb/ref 17592186241022 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0442097d-1b68-55b7-9cb8-c462931d1330" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238117} {:answer/id #uuid "0e522cac-c75a-5c1f-9bac-01ed6857debd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{ln⁡5}" :db/id #edb/ref 17592186238178} {:answer/id #uuid "44b6755c-aead-5542-8a1b-64818f1fbff2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186238650} {:answer/id #uuid "461da220-919b-5435-93cc-a2ea3dad39d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{7}^{x}ln⁡7+\\frac{1}{x}" :db/id #edb/ref 17592186238664} {:answer/id #uuid "ffca6930-a453-5efc-ba11-64e5e1be934c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{4}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/id #edb/ref 17592186240327}] :answer-field/correct {:db/id #edb/ref 17592186238117} :answer-field/id #uuid "7bea711e-203a-5f4c-8d6c-0248b489ff5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186240554}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a3193e7-39e5-59fc-a3d8-c6e491fa4479" :question/math-academy-id "q-105256" :question/problem "Find ${f}^{′}(x)$ for $f(x)={7}^{x}+{log}_{5}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}+{log}_{5}⁡x) \\\\  & ={7}^{x}\\cdot ln⁡7+\\frac{1}{xln⁡5} \\\\  & ={7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}.\\end{aligned}\\end{aligned}\n$$"}] ["q-10737" {:db/id #edb/ref 17592186059974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbe7d686-fceb-5893-8824-fa874f02fc9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{36}{x^{7}}" :db/id #edb/ref 17592186056203} {:answer/id #uuid "d39f9463-ac37-5073-9bd0-1c581c32bc5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36x^{6}" :db/id #edb/ref 17592186056204} {:answer/id #uuid "04d9595d-edc4-5313-ac43-3dca55608c3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12x^{5}" :db/id #edb/ref 17592186056205} {:answer/id #uuid "10cd59df-624f-539a-877b-a604f947553a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{36}{x^{7}}" :db/id #edb/ref 17592186056206} {:answer/id #uuid "249afd6c-aac5-5c78-b111-d1096dacdfe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{36}{x^{5}}" :db/id #edb/ref 17592186056207}] :answer-field/id #uuid "b3900d9b-b037-5571-8ce9-f4acb088f7bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186056202}] :question/id #uuid "af71cdb8-8b5c-5075-89d8-624e1e63c073" :question/math-academy-id "q-10737" :question/problem "If $y = \\frac{6}{x^{6}}$, find $\\frac{dy}{dx}$."}] ["q-11735" {:db/id #edb/ref 17592186253334 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3232bdcf-d781-5e59-bb5b-56c10f0d7fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x" :db/id #edb/ref 17592186250976} {:answer/id #uuid "37865371-b061-54aa-9810-81e59d0b835b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{x}-10{x}^{2}+6x-19" :db/id #edb/ref 17592186251009} {:answer/id #uuid "3d09661f-ce26-5e19-a8b8-2ae50263662e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{x}ln⁡6-10x+6" :db/id #edb/ref 17592186251060} {:answer/id #uuid "9007950f-ce55-5f0c-a1f6-d3963f0294f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{x}-10x+6" :db/id #edb/ref 17592186251775} {:answer/id #uuid "bbf32e0c-8341-5060-b67e-c44870ab4cd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{6}^{x}ln⁡6-10{x}^{2}+6x-19" :db/id #edb/ref 17592186252214}] :answer-field/correct {:db/id #edb/ref 17592186251060} :answer-field/id #uuid "e849ca6e-9bda-5244-a669-0f22826facaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253210}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "50678a5c-afcb-522f-98fb-80e9680afca6" :question/math-academy-id "q-11735" :question/problem "Given that $f(x)={6}^{x}-5{x}^{2}+6x-19$, find ${f}^{′}(x).$" :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =ln⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}ln⁡6-10x+6.\\end{aligned}\n$$"}] ["q-118786" {:db/id #edb/ref 17592186233254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72a71df0-c1f3-5b09-87e2-03d28dcff804" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186251497} {:answer/id #uuid "7a0a569c-63ca-58be-b58a-82f10a235728" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186251569} {:answer/id #uuid "92613281-1dd4-5bc5-9d74-331121e7cd48" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II, and III" :db/id #edb/ref 17592186251805} {:answer/id #uuid "a23e2128-2cb2-5e2b-bd36-5cda47badacf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186251951} {:answer/id #uuid "b39f6185-b1d3-5317-8c72-41a88ba25ea4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of those listed" :db/id #edb/ref 17592186252127}] :answer-field/correct {:db/id #edb/ref 17592186251497} :answer-field/id #uuid "97b7d650-0be2-5452-8b3f-6b34fa085297" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253070}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7775ce93-f97a-564e-ab19-6ca38ffa6f3f" :question/math-academy-id "q-118786" :question/problem "Which of the following systems is a first-order initial value problem?\n\n- $(1+{x}^{2}){y}^{′}=8y,\\,y(-1)=3$\n- $8{y}^{′}-xy=3$\n- $3{y}^{″}=4y,\\,y(-1)=0,\\,{y}^{′}(-1)=1$" :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System I is a first-order initial value problem. It consists of a first-order differential equation $(1+{x}^{2}){y}^{′}=8y$ together with the initial condition $y(-1)=3.$\n\n- System II is not a first-order initial value problem. We have a first-order ordinary differential equation, but there is no initial condition.\n\n- System III is not a first-order initial value problem. It consists of a *second*-order differential equation $3{y}^{″}=4y$ together with *two* initial conditions $y(-1)=0,\\,{y}^{′}(-1)=1.$ This is a second-order initial value problem.\n\nTherefore, the correct answer is \"I only.\""}] ["q-118869" {:db/id #edb/ref 17592186253523 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06cb9eed-b128-5baf-a6ef-6264db0751b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I, II and III" :db/id #edb/ref 17592186250607} {:answer/id #uuid "166ce4d7-7cb0-5417-9912-96973353838a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186250745} {:answer/id #uuid "23b62090-f1be-5651-855a-e9e83de03d12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186250860} {:answer/id #uuid "332486c7-fce9-5267-827f-8efc6c8ebcd1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186250982} {:answer/id #uuid "d324f459-0823-529b-9901-a4f4bef19942" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186252422}] :answer-field/correct {:db/id #edb/ref 17592186252422} :answer-field/id #uuid "9c4b5e39-6b12-5c74-8707-65e7e8a70568" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253079}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f1c949f8-b9ab-5207-8749-bf7052ce14f4" :question/math-academy-id "q-118869" :question/problem "Which of the following are **not** autonomous ordinary differential equations?\n\n- $\\frac{{y}^{′}}{y}+\\frac{1}{\\operatorname{arctan}⁡y+2\\pi }=0$\n- ${y}^{′}+{y}^{2}={x}^{2}$\n- ${y}^{′}=\\operatorname{sin}⁡x$" :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation I is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}\\frac{{y}^{′}}{y}+\\frac{1}{\\operatorname{arctan}⁡y+2\\pi } & =0 \\\\ {y}^{′} & =-\\frac{y}{\\operatorname{arctan}⁡y+2\\pi } \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=-\\frac{y}{\\operatorname{arctan}⁡y+2\\pi }.$\n\n- Equation II is *not* an autonomous differential equation. If we isolate the derivative term, we get \n\n$$\n\\begin{aligned}{y}^{′}+{y}^{2} & ={x}^{2} \\\\ {y}^{′} & ={x}^{2}-{y}^{2} \\\\ {y}^{′} & =f(x,y)\\end{aligned}\n$$\n\nwhere $f(x,y)={x}^{2}-{y}^{2}.$ So, it is not possible to write the equation in the form ${y}^{′}=f(y).$\n\n- Equation III is *not* an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\nTherefore, the correct answer is \"II and III only.\""}] ["q-118870" {:db/id #edb/ref 17592186253524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16f980f2-1577-5537-be57-943a8ca18c14" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186250752} {:answer/id #uuid "5559e3f6-f3c1-51db-b891-67bcbea95dd1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186251252} {:answer/id #uuid "58f44adc-fe68-5d69-a276-6b4ee99d3987" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186251284} {:answer/id #uuid "80518909-a16e-5896-bc3a-0a5ebcf2ed97" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186251633} {:answer/id #uuid "dea23c9f-51f5-52ab-a86a-5e2aae041f93" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186252514}] :answer-field/correct {:db/id #edb/ref 17592186251284} :answer-field/id #uuid "a970fe1e-cf80-5fbc-a811-06ed3857f0bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186253101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1e075483-5dc5-5bbb-be2d-e2d1164eea57" :question/math-academy-id "q-118870" :question/problem "Which of the following are **not** autonomous ordinary differential equations?\n\n- ${y}^{′}={e}^{3-y}-2$\n- $y{y}^{′}+\\operatorname{cos}⁡y=1$\n- ${y}^{′}=\\operatorname{tan}⁡(x+y)$" :question/worked-solution "An ordinary differential equation with dependent variable $y$ and independent variable $x$ is said to be autonomous if it can be written in the form $\\frac{\\text{d}y}{\\text{d}x}=f(y),$ or equivalently, ${y}^{′}=f(y).$\n\nWith that in mind, let's check each of the differential equations:\n\n- Equation I is an autonomous differential equation. It is of the form ${y}^{′}=f(y),$ where $f(y)={e}^{3-y}-2.$\n\n- Equation II is an autonomous differential equation. Writing the equation in the form ${y}^{′}=f(y),$ we get\n\n$$\n\\begin{aligned}y{y}^{′}+\\operatorname{cos}⁡y & =1 \\\\ {y}^{′} & =\\frac{1-\\operatorname{cos}⁡y}{y} \\\\ {y}^{′} & =f(y)\\end{aligned}\n$$\n\nwhere $f(y)=\\frac{1-\\operatorname{cos}⁡y}{y}.$\n\n- Equation III is *not* an autonomous differential equation. It is not of the form ${y}^{′}=f(y).$\n\nTherefore, the correct answer is \"III only.\""}] ["q-11900" {:db/id #edb/ref 17592186253529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010fae26-d218-5d85-80be-b5da7fa03138" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{xln⁡4}" :db/id #edb/ref 17592186250562} {:answer/id #uuid "1d7274d3-9d6c-566f-8ab0-5d6dadc206db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{4x}" :db/id #edb/ref 17592186250801} {:answer/id #uuid "3fea77d7-dd38-54a3-ab38-de4a5e6af670" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{xln⁡5}" :db/id #edb/ref 17592186251082} {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788} {:answer/id #uuid "e56177c0-fb1c-54a8-8c75-934ef63a1c08" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186252561}] :answer-field/correct {:db/id #edb/ref 17592186251788} :answer-field/id #uuid "35ef16c9-7f8c-57e6-86fd-b4dbee5a6bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186252894}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b9de855f-8e10-5bff-89a6-c3649ce380b6" :question/math-academy-id "q-11900" :question/problem "Given that $y=5{log}_{4}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{4}⁡x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x) \\\\  & =5\\cdot \\frac{1}{xln⁡4} \\\\  & =\\frac{5}{xln⁡4}.\\end{aligned}\n$$"}] ["q-119078" {:db/id #edb/ref 17592186097020 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2cdeff7-1bd1-52cc-b4d2-58765a1e715e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = - (1)/(2(x - 1)) + \\frac{3}{2}" :db/id #edb/ref 17592186094094} {:answer/id #uuid "e264582e-6aa3-5da8-b05d-657aca25a556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = \\frac{1}{x - 1} + \\frac{1}{2}" :db/id #edb/ref 17592186094095} {:answer/id #uuid "43d2def0-e7d1-54fb-834f-84b6876ea10b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = \\frac{2}{x - 1} - 1" :db/id #edb/ref 17592186094096} {:answer/id #uuid "518e0850-647a-5199-8686-13cfd746ca8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = \\frac{1}{x - 1}" :db/id #edb/ref 17592186094097} {:answer/id #uuid "6fc7592f-e41a-5c1f-9369-d6bc76a6ea98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y = \\frac{2}{x - 1} + 3" :db/id #edb/ref 17592186094098}] :answer-field/id #uuid "9dd411f0-cb37-5900-866e-8862a9b0a1e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186094093}] :question/id #uuid "d93ad997-2d1a-586a-bd5a-d470614a6ec6" :question/math-academy-id "q-119078" :question/problem "Find the particular solution to the differential equation $(x - 1)^{2}y^{′} =-2$ that satisfies the condition $y(2) = 1$."}] ["q-11911" {:db/id #edb/ref 17592186253547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bf5cf8-eaf1-5b10-8d2a-662c31b3b508" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186250885} {:answer/id #uuid "783b0f4c-199c-5928-b08e-dcb4df838be4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2+\\frac{2}{x}" :db/id #edb/ref 17592186251549} {:answer/id #uuid "89f1e417-01f6-5b82-ba77-84fd142edcc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186251714} {:answer/id #uuid "e0afa8a6-a60b-5d30-b8a6-b2c