#{[{:db/id #edb/ref 17592186045450 :db/ident :answer-field.type/radio}] [{:db/id #edb/ref 17592186045453 :db/ident :answer.type/math}] [{:db/id #edb/ref 17592186045454 :db/ident :answer.type/text}] [{:db/id #edb/ref 17592186045466 :db/ident :task-item.status/completed}] [{:db/id #edb/ref 17592186045467 :db/ident :task-item.status/correct}] [{:db/id #edb/ref 17592186045468 :db/ident :task-item.status/incorrect}] [{:db/id #edb/ref 17592186045469 :db/ident :task-item.status/paused}] [{:course/code "MF2" :course/description "Mathematical Foundations II is the second course in a sequence specially crafted for adults seeking the most direct path to prepare for university math courses. Building on the basic algebra covered in Mathematical Foundations I , students in Mathematical Foundations II generalize their understanding of algebra to more advanced functions (including trigonometry) and become acquainted with limits and derivatives in calculus. Upon completing the course, students will be prepared for Mathematical Foundations III , the final stepping stone in preparing for university-level math." :course/id #uuid "b5d8b420-892a-5b6a-8150-ba3c70c4d779" :course/math-academy-id 111 :course/next [{:db/id #edb/ref 17592186046280}] :course/outcomes [{:course-outcome/category "Complex Numbers and Vectors" :course-outcome/id #uuid "8ec34320-0836-5c46-9dda-dd78eed48629" :course-outcome/index 23 :course-outcome/text "Manipulate complex numbers algebraically and visualize them geometrically in the complex plane." :db/id #edb/ref 17592186046251} {:course-outcome/category "Complex Numbers and Vectors" :course-outcome/id #uuid "5967ca2f-a422-568f-b23e-d06e4e639686" :course-outcome/index 24 :course-outcome/text "Generalize prior intuitions about arithmetic to vectors." :db/id #edb/ref 17592186046252} {:course-outcome/category "Graphing Polynomials and Rational Functions" :course-outcome/id #uuid "cb161187-01a6-5203-aa13-d398d8b53f7b" :course-outcome/index 15 :course-outcome/text "Sketch graphs of rational functions by identifying asymptotes." :db/id #edb/ref 17592186046253} {:course-outcome/category "Graphing Polynomials and Rational Functions" :course-outcome/id #uuid "eab4ddc9-51b3-5fab-ad7b-9fa14f8429f4" :course-outcome/index 13 :course-outcome/text "Understand how the multiplicity of a root of a polynomial relates to the shape of the graph near the root." :db/id #edb/ref 17592186046254} {:course-outcome/category "Graphing Polynomials and Rational Functions" :course-outcome/id #uuid "08432010-3f46-5adb-831d-ca3dbca5a64a" :course-outcome/index 14 :course-outcome/text "Sketch graphs of polynomial functions by identifying end behavior, roots, and behavior near roots." :db/id #edb/ref 17592186046255} {:course-outcome/category "Limits, Derivatives, and Integrals" :course-outcome/id #uuid "bb103c92-c0fc-5298-820a-220685f1ca14" :course-outcome/index 17 :course-outcome/text "Identify continuous functions from graphs and define continuity in terms of limits." :db/id #edb/ref 17592186046256} {:course-outcome/category "Limits, Derivatives, and Integrals" :course-outcome/id #uuid "c9deb708-d968-5d38-aff3-060768a92883" :course-outcome/index 18 :course-outcome/text "Interpret the derivative as the instantaneous rate of change or the slope of the tangent line." :db/id #edb/ref 17592186046257} {:course-outcome/category "Limits, Derivatives, and Integrals" :course-outcome/id #uuid "1eb8cd84-5428-5b64-8b01-2a37ad15055d" :course-outcome/index 20 :course-outcome/text "Evaluate indefinite integrals by finding antiderivatives." :db/id #edb/ref 17592186046258} {:course-outcome/category "Limits, Derivatives, and Integrals" :course-outcome/id #uuid "4f50f054-5d6a-544a-8975-3065c2d0d545" :course-outcome/index 19 :course-outcome/text "Apply rules to compute derivatives of a variety of algebraic functions, including higher-order derivatives." :db/id #edb/ref 17592186046259} {:course-outcome/category "Limits, Derivatives, and Integrals" :course-outcome/id #uuid "584df487-0521-5215-8f1a-3cba4dd7639b" :course-outcome/index 16 :course-outcome/text "Estimate limits from graphs and compute limits using algebraic manipulation." :db/id #edb/ref 17592186046260} {:course-outcome/category "Logarithms" :course-outcome/id #uuid "98b3e5ae-35f8-5881-9621-005eed36d923" :course-outcome/index 1 :course-outcome/text "Understand the relationship between logarithms and exponents and use this understanding to evaluate logarithms." :db/id #edb/ref 17592186046261} {:course-outcome/category "Nonlinear Equations and Graphing" :course-outcome/id #uuid "95deb45a-4b91-555c-82e0-071c1f390bc3" :course-outcome/index 6 :course-outcome/text "Leverage factoring and the quadratic formula as complementary techniques for solving quadratic equations and graphing quadratic functions." :db/id #edb/ref 17592186046262} {:course-outcome/category "Nonlinear Equations and Graphing" :course-outcome/id #uuid "ee92f948-d36c-5993-bb1e-0b7a21f3848e" :course-outcome/index 7 :course-outcome/text "Extend previous knowledge of algebraic techniques to solve nonlinear equations involving polynomials, radicals, exponents, and logarithms." :db/id #edb/ref 17592186046263} {:course-outcome/category "Nonlinear Equations and Graphing" :course-outcome/id #uuid "7e456ca8-d017-5c1b-a539-ed19d21de704" :course-outcome/index 8 :course-outcome/text "Understand how transformations affect the shape of a function's graph and use this understanding to graph transformed quadratic, absolute value, exponential, radical, logarithmic, and trigonometric functions." :db/id #edb/ref 17592186046264} {:course-outcome/category "Polynomial Division and Factoring" :course-outcome/id #uuid "9216091f-a93a-540b-bd57-d22bc5b359f8" :course-outcome/index 12 :course-outcome/text "Leverage the rational roots theorem as a strategy to factor polynomials." :db/id #edb/ref 17592186046265} {:course-outcome/category "Polynomial Division and Factoring" :course-outcome/id #uuid "d3155e66-3206-5a08-9fe7-ce9105071b0c" :course-outcome/index 9 :course-outcome/text "Understand the relationship between zeros and factors of polynomials." :db/id #edb/ref 17592186046266} {:course-outcome/category "Polynomial Division and Factoring" :course-outcome/id #uuid "1e3dfe42-c54f-55e3-be4a-a7330d514e3a" :course-outcome/index 11 :course-outcome/text "Understand the relationship between the value of a polynomial at a given input and the remainder obtained when dividing the polynomial by the corresponding binomial." :db/id #edb/ref 17592186046267} {:course-outcome/category "Polynomial Division and Factoring" :course-outcome/id #uuid "7f598d50-3285-51c9-ae89-6cd243029a1c" :course-outcome/index 10 :course-outcome/text "Divide polynomials using synthetic and long division." :db/id #edb/ref 17592186046268} {:course-outcome/category "Probability and Statistics" :course-outcome/id #uuid "941664a9-92db-544f-9609-aeceaf352804" :course-outcome/index 26 :course-outcome/text "Apply combinatorial techniques to compute probabilities in real-world modeling contexts." :db/id #edb/ref 17592186046269} {:course-outcome/category "Probability and Statistics" :course-outcome/id #uuid "d107f0c3-d218-5cd7-baeb-26d7d527bdad" :course-outcome/index 29 :course-outcome/text "Fit a linear regression to a data set and use it to make predictions." :db/id #edb/ref 17592186046270} {:course-outcome/category "Probability and Statistics" :course-outcome/id #uuid "11a20e4e-a7d8-5e4a-8ef3-dcfe28ca9b9c" :course-outcome/index 28 :course-outcome/text "Compute statistical measures of the center and spread of a data set." :db/id #edb/ref 17592186046271} {:course-outcome/category "Probability and Statistics" :course-outcome/id #uuid "14ad9903-7cd1-5078-967f-33b540051694" :course-outcome/index 27 :course-outcome/text "Understand independent events both conceptually and quantitatively from the perspective of conditional probability." :db/id #edb/ref 17592186046272} {:course-outcome/category "Probability and Statistics" :course-outcome/id #uuid "6b13d872-5252-5992-8502-402d491cc1f0" :course-outcome/index 25 :course-outcome/text "Define probability using the formal language of sets." :db/id #edb/ref 17592186046273} {:course-outcome/category "Sequences" :course-outcome/id #uuid "80dd970d-8566-5dfe-a9ae-890addf8cc7f" :course-outcome/index 22 :course-outcome/text "Determine the formula of an arithmetic or geometric sequence." :db/id #edb/ref 17592186046274} {:course-outcome/category "Sequences" :course-outcome/id #uuid "e176419b-4275-5627-8cbb-2b822d5d4822" :course-outcome/index 21 :course-outcome/text "Evaluate terms of a sequence and compute sums given in sigma notation." :db/id #edb/ref 17592186046275} {:course-outcome/category "Trigonometry" :course-outcome/id #uuid "922b6e42-58a7-52dd-95d3-c1fc39c49a60" :course-outcome/index 2 :course-outcome/text "Apply trigonometric functions to solve for unknown sides and angles in right triangles." :db/id #edb/ref 17592186046276} {:course-outcome/category "Trigonometry" :course-outcome/id #uuid "e4a756f9-cfcb-5150-beed-383ba1ef38d7" :course-outcome/index 4 :course-outcome/text "Graph and describe properties of trigonometric functions by relating them to the unit circle." :db/id #edb/ref 17592186046277} {:course-outcome/category "Trigonometry" :course-outcome/id #uuid "42893ba7-9582-507f-904a-46f9ce68faa6" :course-outcome/index 3 :course-outcome/text "Leverage the unit circle as a conceptual framework for evaluating special trigonometric ratios." :db/id #edb/ref 17592186046278} {:course-outcome/category "Trigonometry" :course-outcome/id #uuid "7c5aff17-8e27-50fa-bf20-428572743cbe" :course-outcome/index 5 :course-outcome/text "Use the law of sines and the law of cosines to solve for unknown angles and sides in general triangles." :db/id #edb/ref 17592186046279}] :course/overview "Master the algebra of advanced functions including quadratics, logarithms, and trigonometry. Dive deep into the theory of polynomials, learn the basics of limits, derivatives, and integrals from calculus, an