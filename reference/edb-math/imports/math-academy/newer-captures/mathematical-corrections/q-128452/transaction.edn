[[:db/retract 17592186305622 :question/answer-fields 17592186305623] {:db/id "q-128452/mathematical-correction-v1/selection/answer-0" :answer/id #uuid "666d0943-d962-5343-b8b8-584d547cecb6" :answer/type :answer.type/math :answer/value "⟨-1,\\pi ,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/mathematical-correction-v1/selection/answer-1" :answer/id #uuid "2bf663e2-ab37-5760-8f98-b6bf2245f3c8" :answer/type :answer.type/math :answer/value "⟨-1,0,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/mathematical-correction-v1/selection/answer-2" :answer/id #uuid "40b45b28-7d4c-5c26-acf2-22c77fbe8a93" :answer/type :answer.type/math :answer/value "⟨-1,0,-2⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/mathematical-correction-v1/selection/answer-3" :answer/id #uuid "7f5fcda8-94e0-5680-9724-baadb419019e" :answer/type :answer.type/math :answer/value "⟨-1,4\\pi ,1⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/mathematical-correction-v1/selection/answer-4" :answer/id #uuid "c7f74fa6-e400-517d-b831-8393b1be5955" :answer/type :answer.type/math :answer/value "⟨1,1,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/mathematical-correction-v1/selection" :answer-field/id #uuid "67fc88b4-87c5-5184-9df4-c543d7d6b38d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-128452/mathematical-correction-v1/selection/answer-0" "q-128452/mathematical-correction-v1/selection/answer-1" "q-128452/mathematical-correction-v1/selection/answer-2" "q-128452/mathematical-correction-v1/selection/answer-3" "q-128452/mathematical-correction-v1/selection/answer-4"] :answer-field/correct "q-128452/mathematical-correction-v1/selection/answer-1" :db/ensure [:answer-field/validate]} {:db/id 17592186305622 :question/problem "Find the value of $(2f(t)-g(t))^{′}$ at $t=-1,$ if \n\n$$\n\\begin{aligned}f(t) & =⟨8\\sqrt{3-t},\\,\\operatorname{sin}⁡(\\pi t),\\,\\ln|2t|⟩, \\\\ g(t) & =⟨{t}^{2}-t,\\,\\pi {t}^{2},\\,1-{t}^{2}⟩.\\end{aligned}\n$$" :question/worked-solution "Since $t=-1$ lies in an open interval where $t<0$ and $3-t>0$, all components are differentiable there. In particular, $\\ln|2t|=\\ln(-2t)$ near $t=-1$, so its derivative is $1/t$.\n\nDifferentiate each vector component:\n\n$$\n\\mathbf f'(t)=\\left\\langle-\\frac{4}{\\sqrt{3-t}},\\pi\\cos(\\pi t),\\frac1t\\right\\rangle,\n\\qquad\n\\mathbf g'(t)=\\langle 2t-1,2\\pi t,-2t\\rangle.\n$$\n\nThe sum and constant multiple rules give\n\n$$\n(2\\mathbf f-\\mathbf g)'(t)=2\\mathbf f'(t)-\\mathbf g'(t).\n$$\n\nAt $t=-1$,\n\n$$\n\\mathbf f'(-1)=\\langle-2,-\\pi,-1\\rangle,\n\\qquad\n\\mathbf g'(-1)=\\langle-3,-2\\pi,2\\rangle.\n$$\n\nTherefore,\n\n$$\n(2\\mathbf f-\\mathbf g)'(-1)\n=2\\langle-2,-\\pi,-1\\rangle-\\langle-3,-2\\pi,2\\rangle\n=\\boxed{\\langle-1,0,-4\\rangle}.\n$$" :question/answer-fields ["q-128452/mathematical-correction-v1/selection"] :db/ensure [:question/validate]}]
