#{[{:db/id #edb/ref 17592186328320 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "179dede6-5b04-58bf-a1e7-21b80fd01fdd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328322} {:answer/id #uuid "5e409c45-1ccd-5923-a127-7664c2de19e2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328323} {:answer/id #uuid "6400e3ab-6c70-5278-bfca-a0962f17e481" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328324} {:answer/id #uuid "00abc4c9-f9b1-575b-8794-8874828aecc1" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328325} {:answer/id #uuid "30bd559f-9d08-5288-ad54-c9ae60b7a556" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328326}] :answer-field/correct {:answer/id #uuid "30bd559f-9d08-5288-ad54-c9ae60b7a556" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328326} :answer-field/id #uuid "034ae56c-bed7-531e-8adb-eb0c1a952cec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328321}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "80bfbd6a-391f-520f-a0ad-dc736395685b" :question/math-academy-id "q-72175" :question/problem "Which of the following equalities are true given that\n$D={(x,y)\\,:\\,0\\le x\\le \\sqrt{2},\\,-\\sqrt{3}\\le y\\le 2}.$\n\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{0}^{\\sqrt{2}}{\\int }_{-\\sqrt{3}}^{2}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x$\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{-\\sqrt{3}}^{2}{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}x\\,\\text{d}y$\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{-\\sqrt{3}}^{2}{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that:  \n\n- the limits for the variable $x$ are from $0$ to $\\sqrt{2}$, and\n\n- the limits for the variable $y$ are from $-\\sqrt{3}$ to $2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A & ={\\int }_{-\\sqrt{3}}^{2}[{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{0}^{\\sqrt{2}}[{\\int }_{-\\sqrt{3}}^{2}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"I and II only\"."}]}
