#{[{:db/id #edb/ref 17592186332144 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ddcff62-d052-51fd-9e2b-50358fa02de5" :knowledge-point/title "Finding the Singular Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d43b3e6d-b73a-5814-852b-fd6910b29bea" :answer/type {:db/ident :answer.type/math} :answer/value "y=3{x}^{2}" :db/id #edb/ref 17592186332146} {:answer/id #uuid "87f19102-4df1-52f8-b58a-f73c5c67901c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186332147} {:answer/id #uuid "16e123d2-23a7-5390-9302-77d8719ca933" :answer/type {:db/ident :answer.type/math} :answer/value "y=3x+1" :db/id #edb/ref 17592186332148} {:answer/id #uuid "6175c781-349c-5a15-8ba5-d768492675fd" :answer/type {:db/ident :answer.type/math} :answer/value "y=1-3x" :db/id #edb/ref 17592186332149} {:answer/id #uuid "68866aea-92bb-5b43-a8a0-03e92d95f059" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3x" :db/id #edb/ref 17592186332150}] :answer-field/correct {:answer/id #uuid "87f19102-4df1-52f8-b58a-f73c5c67901c" :answer/type {:db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186332147} :answer-field/id #uuid "ae52fd74-1018-55c2-ac7b-11a61a0463e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332145}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dc429d1e-7f4f-50b6-bac7-a69f2082aa23" :question/math-academy-id "q-334452" :question/problem "Find the constant particular solution to the following Clairaut differential equation:\n\n$$\ny=x{y}^{′}+{y}^{′}-3.\n$$" :question/worked-solution "A constant particular solution has $y'=0$. Substituting this into\n\n$$y=xy'+y'-3$$\n\ngives $y=-3$. Its derivative is zero, and direct substitution verifies\n\n$$-3=x\\cdot0+0-3.$$\n\nTherefore, the constant particular solution is $y=-3$.\n\nTo distinguish this from a singular solution, write $p=y'$. The equation becomes $y=(x+1)p-3$, and differentiation gives $0=(x+1)p'$. The ordinary straight-line family is\n\n$$y=c(x+1)-3,$$\n\nwith arbitrary constant $c$. The envelope condition obtained by differentiating this family with respect to $c$ is $x+1=0$. It forces $x=-1$ and $y=-3$, giving a single point rather than a singular graph $y(x)$. The constant solution $y=-3$ is the ordinary family member $c=0$; it is not a separate singular solution."}]}
