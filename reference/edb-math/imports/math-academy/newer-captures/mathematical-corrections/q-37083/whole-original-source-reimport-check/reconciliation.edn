"ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" nil "attribute" "question/worked-solution" "value" "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(2,-1):$\n\n$$\n\\begin{aligned}-∇\\,f(x,y) & =-\\frac{∂}{∂x}((x+y)\\operatorname{ln}⁡(x+y))\\text{ }i-\\frac{∂}{∂y}((x+y)\\operatorname{ln}⁡(x+y))\\text{ }j \\\\  & =(\\operatorname{ln}⁡(x+y)+1)\\text{ }i+(\\operatorname{ln}⁡(x+y)+1)\\text{ }j \\\\ -∇\\,f(2,-1) & =-(\\operatorname{ln}⁡(2-1)+1)i-(\\operatorname{ln}⁡(2-1)+1)j \\\\  & =-i-j\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(2,-1)$ in the direction of $-∇f(2,-1)$ is given by\n\n$$\n\\begin{aligned}‖-∇\\,f(2,-1)‖ & =‖-i-j‖ \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/activity-metadata.json" "file_sha256" "c362cd907fb85830ab3320317ae756b56808309a5fb6a6d98274061b8fc74a3f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2\\sqrt{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-37083" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\sqrt{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" nil "attribute" "question/problem" "value" "Consider the function $g(x,y)=\\frac{x}{y}+\\frac{y}{x}.$ What is the rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of the vector $v=⟨1,-\\sqrt{2}⟩?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" nil "attribute" "question/worked-solution" "value" "The rate of change of $g(x,y)$ at the point $(-1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(-1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{1}^{2}+(-\\sqrt{2})^{2}}=\\sqrt{3} \\\\ u & =\\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇g(x,y)$ and evaluate it at the point $(-1,1):$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{x}{y}+\\frac{y}{x}),\\,\\frac{∂}{∂y}(\\frac{x}{y}+\\frac{y}{x})⟩ \\\\  & =⟨\\frac{1}{y}-\\frac{y}{{x}^{2}},\\,\\frac{1}{x}-\\frac{x}{{y}^{2}}⟩ \\\\ ∇g(-1,1) & =⟨\\frac{1}{1}-\\frac{1}{(-1)^{2}},\\frac{1}{(-1)}-\\frac{(-1)}{{1}^{2}}⟩ \\\\  & =⟨0,0⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(-1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(-1,1) & =∇g(-1,1)\\cdot u \\\\  & =⟨0,0⟩\\cdot \\frac{1}{\\sqrt{3}}⟨1,-\\sqrt{2}⟩ \\\\  & =\\frac{0(1)+0(-\\sqrt{2})}{\\sqrt{3}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/activity-metadata.json" "file_sha256" "c362cd907fb85830ab3320317ae756b56808309a5fb6a6d98274061b8fc74a3f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "0"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130801" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" nil "attribute" "question/problem" "value" "Consider the function $g(x,y)=2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x.$ What is the rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4})$ in the direction of the vector $v=⟨-1,1⟩?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" nil "attribute" "question/worked-solution" "value" "The rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4})$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(\\frac{\\pi }{4},\\frac{\\pi }{4}).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{(-1)^{2}+{1}^{2}}=\\sqrt{2} \\\\ u & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇\\,g(x,y)$ and evaluate it at the point $(\\frac{\\pi }{4},\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x),\\,\\frac{∂}{∂y}(2x\\operatorname{tan}⁡y-2y\\operatorname{tan}⁡x)⟩ \\\\  & =⟨2\\operatorname{tan}⁡y-2y{sec}^{2}⁡x,\\,2x{sec}^{2}⁡y-2\\operatorname{tan}⁡x⟩ \\\\ ∇\\,g(\\frac{\\pi }{4},\\frac{\\pi }{4}) & =⟨2\\operatorname{tan}⁡(\\frac{\\pi }{4})-2\\cdot \\frac{\\pi }{4}\\cdot {sec}^{2}⁡(\\frac{\\pi }{4}),\\,2\\cdot \\frac{\\pi }{4}\\cdot {sec}^{2}⁡(\\frac{\\pi }{4})-2\\operatorname{tan}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨2\\cdot 1-\\frac{\\pi }{2}\\cdot 2,\\frac{\\pi }{2}\\cdot 2-2\\cdot 1⟩ \\\\  & =⟨2-\\pi ,\\,\\pi -2⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(\\frac{\\pi }{4},\\frac{\\pi }{4})$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(\\frac{\\pi }{4},\\frac{\\pi }{4}) & =∇\\,g(\\frac{\\pi }{4},\\frac{\\pi }{4})\\cdot u \\\\  & =⟨2-\\pi ,\\pi -2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{(2-\\pi )\\cdot (-1)+(\\pi -2)\\cdot 1}{\\sqrt{2}} \\\\  & =\\frac{2\\pi -4}{\\sqrt{2}} \\\\  & =\\sqrt{2}(\\pi -2).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/activity-metadata.json" "file_sha256" "c362cd907fb85830ab3320317ae756b56808309a5fb6a6d98274061b8fc74a3f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2(\\pi +2)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2(\\pi -2)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\pi -\\sqrt{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{2}(\\pi +2)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{2}(\\pi -2)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83613" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\sqrt{2}(\\pi -2)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" nil "attribute" "question/problem" "value" "Consider the function $g(x,y)=\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy.$ What is the rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of the vector $v=⟨-2,2⟩?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" nil "attribute" "question/worked-solution" "value" "The rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{(-2)^{2}+{2}^{2}}=2\\sqrt{2} \\\\ u & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇\\,g(x,y)$ and evaluate it at the point $(1,1):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy),\\,\\frac{∂}{∂y}(\\frac{\\operatorname{sin}⁡(\\pi x)}{y}+\\pi xy)⟩ \\\\  & =⟨\\frac{\\pi \\operatorname{cos}⁡(\\pi x)}{y}+\\pi y,\\,-\\frac{\\operatorname{sin}⁡(\\pi x)}{{y}^{2}}+\\pi x⟩ \\\\ ∇\\,g(1,1) & =⟨\\frac{\\pi \\operatorname{cos}⁡(\\pi \\cdot 1)}{1}+\\pi \\cdot 1,\\,-\\frac{\\operatorname{sin}⁡(\\pi \\cdot 1)}{{1}^{2}}+\\pi \\cdot 1⟩ \\\\  & =⟨-\\pi +\\pi ,0+\\pi ⟩ \\\\  & =⟨0,\\pi ⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(1,1) & =∇\\,g(1,1)\\cdot u \\\\  & =⟨0,\\pi ⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{0\\cdot (-1)+\\pi \\cdot 1}{\\sqrt{2}} \\\\  & =\\frac{\\pi }{\\sqrt{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/activity-metadata.json" "file_sha256" "c362cd907fb85830ab3320317ae756b56808309a5fb6a6d98274061b8fc74a3f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-2\\pi "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{\\pi }{\\sqrt{2}}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{\\sqrt{2}}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-83608" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\pi \\sqrt{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" nil "attribute" "question/problem" "value" "Consider the function $f(x,y)=2xy+{e}^{3x-y}.$ What is the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction in which the function decreases most rapidly?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" nil "attribute" "question/worked-solution" "value" "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(1,3):$\n\n$$\n\\begin{aligned}-∇\\,f(x,y) & =-\\frac{∂}{∂x}(2xy+{e}^{3x-y})\\text{ }i-\\frac{∂}{∂y}(2xy+{e}^{3x-y})\\text{ }j \\\\  & =-(2y+3{e}^{3x-y})\\text{ }i-(2x-{e}^{3x-y})\\text{ }j \\\\ -∇\\,f(1,3) & =-(2\\cdot 3+3\\cdot {e}^{3\\cdot 1-3})\\text{ }i-(2\\cdot 1-{e}^{3\\cdot 1-3})\\text{ }j \\\\  & =-9\\text{ }i-\\text{ }j\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction of $-∇f(1,3)$ is given by\n\n$$\n\\begin{aligned}‖-∇\\,f(1,3)‖ & =‖-9\\text{ }i-\\text{ }j‖ \\\\  & =\\sqrt{(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{82}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/activity-metadata.json" "file_sha256" "c362cd907fb85830ab3320317ae756b56808309a5fb6a6d98274061b8fc74a3f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "9"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{10}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{80}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{82}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{8}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-36300" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\sqrt{82}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "e-3377" "field" nil "attribute" "question/problem" "value" "Find the directional derivative of the function $g(x, y) =3x^2+4xy$ at the point $A(0,1)$ in the direction towards the point $B(1,4).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/example-3377.json" "file_sha256" "4b5d0ce2f6dac2876855391d7dad8b4e7ca965fdf5d6157c9b9717f539e87849" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "e-3377" "field" nil "attribute" "question/worked-solution" "value" "The directional derivative $g'_{\\mathbf u}(a,b)$ of a function $g(x,y)$ at the point $(a,b)$ in the direction of the vector $\\mathbf v$ is given by\n\n$$\ng'_{\\mathbf u}(a,b) = \\nabla g(a,b)\\cdot\\mathbf u\n$$\n\nwhere $\\mathbf u$ is a unit vector in the direction of $\\mathbf v.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨1,4⟩-⟨0,1⟩ \\\\  & =⟨1,3⟩ \\\\ u & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{{1}^{2}+{3}^{2}}}⟨1,3⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨1,3⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $\\nabla g(x,y)$ and evaluate it at the point $A(0,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(3{x}^{2}+4xy),\\frac{∂}{∂y}(3{x}^{2}+4xy)⟩ \\\\  & =⟨6x+4y,\\,4x⟩ \\\\ ∇g(0,1) & =⟨6\\cdot 0+4\\cdot 1,\\,4\\cdot 0⟩ \\\\  & =⟨4,0⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(0,1) & =∇g(0,1)\\cdot u \\\\  & =⟨4,0⟩\\cdot ⟨\\frac{1}{\\sqrt{10}},\\frac{3}{\\sqrt{10}}⟩ \\\\  & =\\frac{4}{\\sqrt{10}} \\\\  & =\\frac{4\\sqrt{10}}{10} \\\\  & =\\frac{2\\sqrt{10}}{5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/example-3377.json" "file_sha256" "4b5d0ce2f6dac2876855391d7dad8b4e7ca965fdf5d6157c9b9717f539e87849" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "e-3381" "field" nil "attribute" "question/problem" "value" "In what direction does the function $f (x, y) = \\ln (x^2y)$ decrease most rapidly at the point $(2, 1)?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/example-3381.json" "file_sha256" "fb6b6c86b31a4ce60405fda2214b9c9207b598810976e988aaa6517afd62ed36" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "e-3381" "field" nil "attribute" "question/worked-solution" "value" "At a given point, a function $f(x,y)$ decreases most rapidly in the direction opposite to that of its gradient.\n\nSo, we compute $-\\nabla f(x,y)$ and evaluate it at the point $(2,1)\\mathbin{:}$\n\n$$\n\\begin{aligned}-∇f(x,y) & =-\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}y))\\text{ }i-\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}y))\\text{ }j \\\\  & =-\\frac{1}{{x}^{2}y}\\cdot 2xy\\text{ }i-\\frac{1}{{x}^{2}y}\\cdot {x}^{2}j \\\\  & =-\\frac{2}{x}\\text{ }i-\\frac{1}{y}\\text{ }j \\\\ -∇f(2,1) & =-\\frac{2}{2}\\text{ }i-\\frac{1}{1}\\text{ }j \\\\  & =-i-j\\end{aligned}\n$$\n\nTherefore, the function decreases most rapidly in the direction of $- \\, \\mathbf i - \\mathbf j.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/example-3381.json" "file_sha256" "fb6b6c86b31a4ce60405fda2214b9c9207b598810976e988aaa6517afd62ed36" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "e-3382" "field" nil "attribute" "question/problem" "value" "Consider the function $g (x, y) = \\ln \\left(\\sqrt {xy^3}\\right).$ What is the rate of change of $g$ at the point $\\left(\\dfrac 12, \\dfrac 32 \\right)$ in the direction in which the function increases most rapidly?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/example-3382.json" "file_sha256" "4e464914cb6ae71045d3ab7a37b627f7bc84630eb6db147fbc54bd5c659a3259" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "e-3382" "field" nil "attribute" "question/worked-solution" "value" "At a given point, a function $g(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nIn our case, we compute $\\nabla g(x,y)$ and evaluate it at the point $\\left(\\dfrac 12, \\dfrac 32 \\right)\\!\\mathbin{:}$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{ln}⁡(\\sqrt{x{y}^{3}})),\\,\\frac{∂}{∂y}(\\operatorname{ln}⁡(\\sqrt{x{y}^{3}}))⟩ \\\\  & =⟨\\frac{1}{\\sqrt{x{y}^{3}}}\\cdot \\frac{{y}^{3}}{2\\sqrt{x{y}^{3}}},\\,\\frac{1}{\\sqrt{x{y}^{3}}}\\cdot \\frac{3x{y}^{2}}{2\\sqrt{x{y}^{3}}}⟩ \\\\  & =⟨\\frac{1}{2x},\\,\\frac{3}{2y}⟩ \\\\ ∇g(\\frac{1}{2},\\frac{3}{2}) & =⟨\\frac{1}{2\\cdot (\\frac{1}{2})},\\frac{3}{2\\cdot (\\frac{3}{2})}⟩ \\\\  & =⟨1,1⟩\\end{aligned}\n$$\n\nFinally, the rate of change of $g(x,y)$ at the point $\\left(\\dfrac 12, \\dfrac 32 \\right)$ in the direction of $\\nabla g\\left(\\dfrac 12, \\dfrac 32 \\right)$ is given by\n\n$$\n\\begin{aligned}‖∇g(\\frac{1}{2},\\frac{3}{2})‖ & =‖⟨1,1⟩‖ \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/example-3382.json" "file_sha256" "4e464914cb6ae71045d3ab7a37b627f7bc84630eb6db147fbc54bd5c659a3259" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"}] "sources" [] "usage" {"e-3382" [] "q-36300" [] "q-130263" [] "e-3377" [] "q-86537" [] "e-3381" [] "q-130276" [] "q-83613" [] "q-36305" [] "q-130801" [] "q-37080" [] "q-37083" [] "q-83554" [] "q-83608" [] "q-86429" [] "q-130260" [] "q-36290" [] "q-130257" []} "basis" 2395 "retractions" [] "immutable_answers" [17592186362333 17592186362334 17592186362335 17592186362336 17592186362337 17592186362340 17592186362341 17592186362342 17592186362343 17592186362344 17592186362347 17592186362348 17592186362349 17592186362350 17592186362351 17592186362354 17592186362355 17592186362356 17592186362357 17592186362358 17592186362361 17592186362362 17592186362363 17592186362364 17592186362365 17592186362368 17592186362369 17592186362370 17592186362371 17592186362372 17592186362375 17592186362376 17592186362377 17592186362378 17592186362379 17592186362381 17592186362382 17592186362383 17592186362384 17592186362385 17592186362388 17592186362389 17592186362390 17592186362391 17592186362392 17592186362395 17592186362396 17592186362397 17592186362398 17592186362399 17592186362402 17592186362403 17592186362404 17592186362405 17592186362406 17592186362409 17592186362410 17592186362411 17592186362412 17592186362413 17592186362416 17592186362417 17592186362418 17592186362419 17592186362420 17592186362423 17592186362424 17592186362425 17592186362426 17592186362427 17592186362430 17592186362431 17592186362432 17592186362433 17592186362434] "immutable_fields" [[17592186362332 :answer-field/correct] [17592186362332 :answer-field/id] [17592186362332 :answer-field/key] [17592186362332 :answer-field/type] [17592186362339 :answer-field/correct] [175921863