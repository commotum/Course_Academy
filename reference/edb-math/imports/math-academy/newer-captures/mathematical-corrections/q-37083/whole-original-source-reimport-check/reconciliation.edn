662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130276" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/activity-metadata.json" "file_sha256" "c362cd907fb85830ab3320317ae756b56808309a5fb6a6d98274061b8fc74a3f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130276" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130276" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2\\,i+j"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/state.json" "file_sha256" "abc84f7aef8805102238c63265050a108257d205b44bbf08f3fcd9e3a1c4529f" "basis" 2394 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069662/edb-import/verification.json"} {"question" "q-130276" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "3\\,i-5\\,j"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-captu