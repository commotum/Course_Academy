#{[{:db/id #edb/ref 17592186347614 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e" :knowledge-point/title "Finding the Volume of a Solid Given in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "903a36b0-2df4-5939-b9bd-0873e6e07dcc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186347616} {:answer/id #uuid "cb041ec0-9c6c-5ad5-9495-7ff8c30ef3f5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186347617} {:answer/id #uuid "ecdb8e8e-1ead-5c2f-8d11-87110257f63d" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186347618} {:answer/id #uuid "a87a5d93-f289-5dda-942b-2017705bfade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186347619} {:answer/id #uuid "aed7bd19-f8b0-597d-b737-419d7e9b3deb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186347620}] :answer-field/correct {:answer/id #uuid "a87a5d93-f289-5dda-942b-2017705bfade" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186347619} :answer-field/id #uuid "9d3ca650-3e2b-5b33-bd49-57b9bd062470" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347615}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "9ab8e166-680c-5883-9f97-66afbfcc44a9" :question/math-academy-id "q-161659" :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,-2\\le x\\le 2,\\,0\\le z\\le \\sqrt{2-{x}^{2}},\\,0\\le y\\le 2z}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{2-{x}^{2}}}{\\int }_{0}^{2z}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{2-{x}^{2}}}[y]_{y=0}^{y=2z}\\,dz\\,dx \\\\  & ={\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{2-{x}^{2}}}2z\\,dz\\,dx \\\\  & ={\\int }_{-2}^{2}{[{z}^{2}]}_{z=-0}^{z=\\sqrt{2-{x}^{2}}}\\,dx \\\\  & ={\\int }_{-2}^{2}{(\\sqrt{2-{x}^{2}})}^{2}-0\\,dx \\\\  & ={\\int }_{-2}^{2}2-{x}^{2}\\,dx \\\\  & ={[2x-\\frac{1}{3}{x}^{3}]}_{x=-2}^{x=2} \\\\  & =(2(2)-\\frac{1}{3}(2)^{3})-(2(-2)-\\frac{1}{3}(-2)^{3}) \\\\  & =(4-\\frac{8}{3})-(-4+\\frac{8}{3}) \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$"}]}
