32f3ad8a49ff32334e626619bf744c2b93b2dacf8a0d6a3562c3a3f5c1" "basis" 2418 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/edb-import/verification.json"} {"question" "q-84592" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$a=2,$ $b=3,$ and $c=13$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/state.json" "file_sha256" "0d072232f3ad8a49ff32334e626619bf744c2b93b2dacf8a0d6a3562c3a3f5c1" "basis" 2418 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/edb-import/verification.json"} {"question" "q-83697" "field" nil "attribute" "question/problem" "value" "Consider the matrix $A$ for which ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=-2,$ ${\\lambda }_{3}=2$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=[\\begin{aligned}a & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & b & -1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & c & 0 \\\\ 0 & 0 & 2\\end{aligned}]{[\\begin{aligned}a & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & b & -1\\end{aligned}]}^{-1}?\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/state.json" "file_sha256" "0d072232f3ad8a49ff32334e626619bf744c2b93b2dacf8a0d6a3562c3a3f5c1" "basis" 2418 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/edb-import/verification.json"} {"question" "q-83697" "field" nil "attribute" "question/worked-solution" "value" "Since the eigenvalues of the matrix are ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=-2,$ ${\\lambda }_{3}=2,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=1,$\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-2,$ and\n\n- the $3$rd column is the eigenvector corresponding to ${\\lambda }_{3}=-2.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}2 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & -1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nA=[\\begin{aligned}2 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & -1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 2\\end{aligned}]{[\\begin{aligned}2 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & -1\\end{aligned}]}^{-1}.\n$$\n\nIn conclusion, we get $a=2,$ $b=1,$ and $c=-2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/state.json" "file_sha256" "0d072232f3ad8a49ff32334e626619bf744c2b93b2dacf8a0d6a3562c3a3f5c1" "basis" 2418 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/edb-import/verification.json"} {"question" "q-83697" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/activity-metadata.json" "file_sha256" "6fba20b775935b352073a60c9f679b7174472b2490f4ea3737700991b80c2658" "basis" 2418 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14069769/edb-import/verification.json"} {"question" "q-83697" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy