29e862488dd7a8" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164580" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{3}\\operatorname{cosh}⁡ϕ\\operatorname{cos}⁡\\theta "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/state.json" "file_sha256" "3710e4c5d31ce4e3f9a675ffa398abacc80a1ab3c7038e133629e862488dd7a8" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164580" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{3}\\operatorname{sin}⁡\\theta "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/state.json" "file_sha256" "3710e4c5d31ce4e3f9a675ffa398abacc80a1ab3c7038e133629e862488dd7a8" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164580" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\operatorname{cosh}⁡ϕ"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/state.json" "file_sha256" "3710e4c5d31ce4e3f9a675ffa398abacc80a1ab3c7038e133629e862488dd7a8" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164586" "field" nil "attribute" "question/problem" "value" "The vector-valued function $f(\\theta ,ϕ),$ given by\n\n$$\nf(\\theta ,ϕ)=⟨3\\operatorname{cosh}⁡ϕ,\\,4\\operatorname{sinh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,\\text{_____}⟩\n$$\n\nparametrizes one sheet of the hyperboloid of two sheets defined in Cartesian coordinates as \n\n$$\n-\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{16}+\\frac{{z}^{2}}{4}=-1.\n$$\n\n \n\nBy first considering the transformations\n\n$$\nx=3Z,\\,y=4Y,\\,z=2X\n$$\n\nand writing the resulting system in cylindrical polar coordinates, determine the third component of $f.$\n\n*Hint: You may use the fact that the hyperbola ${Z}^{2}-{r}^{2}={k}^{2}$ can be parametrized as $⟨Z,r⟩=⟨k\\operatorname{cosh}⁡ϕ,\\,k\\operatorname{sinh}⁡ϕ⟩$* for $ϕ\\in R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/state.json" "file_sha256" "3710e4c5d31ce4e3f9a675ffa398abacc80a1ab3c7038e133629e862488dd7a8" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164586" "field" nil "attribute" "question/worked-solution" "value" "First, substituting the transformations\n\n$$\nx=3Z,\\,y=4Y,\\,z=2X\n$$\n\ninto our equation, we get\n\n$$\n{X}^{2}+{Y}^{2}-{Z}^{2}=-1.\n$$\n\nIf $(r,\\theta ,Z)$ are the cylindrical coordinates of a point and $(X,Y,Z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nX=r\\operatorname{cos}⁡\\theta ,\\,Y=r\\operatorname{sin}⁡\\theta ,\\,Z=Z.\n$$\n\nSubstituting this into our equation, we get\n\n$$\n\\begin{aligned}{X}^{2}+{Y}^{2}-{Z}^{2} & =-1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}-{Z}^{2} & =-1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-{Z}^{2} & =-1 \\\\ {r}^{2}-{Z}^{2} & =-1 \\\\ {Z}^{2}-{r}^{2} & =1.\\end{aligned}\n$$\n\nHere, the hyperbola ${Z}^{2}-{r}^{2}=1$ represents the intersection of our hyperboloid with the plane that passes through the $Z$-axis and makes the angle of $\\theta $ with the positive $X$-axis. Using the hint, a parametrization of such hyperbola can be given as\n\n$$\n⟨Z,r⟩=⟨\\operatorname{cosh}⁡ϕ,\\,\\operatorname{sinh}⁡ϕ⟩,\\,ϕ\\in R.\n$$\n\nNow, for any point $(x,y,z)$ on our surface, we obtain the following:\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨x,y,z⟩ \\\\  & =⟨3Z,4Y,2X⟩ \\\\  & =⟨3Z,\\,4r\\operatorname{sin}⁡\\theta ,\\,2r\\operatorname{cos}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ,\\,4(\\operatorname{sinh}⁡ϕ)\\operatorname{sin}⁡\\theta ,\\,2(\\operatorname{sinh}⁡ϕ)\\operatorname{cos}⁡\\theta ⟩ \\\\  & =⟨3\\operatorname{cosh}⁡ϕ,\\,4\\operatorname{sinh}⁡ϕ\\operatorname{sin}⁡\\theta ,\\,2\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in R.$\n\nTherefore, the third component of $f$ is $2\\operatorname{sinh}⁡ϕ\\operatorname{cos}⁡\\theta .$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/state.json" "file_sha256" "3710e4c5d31ce4e3f9a675ffa398abacc80a1ab3c7038e133629e862488dd7a8" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164586" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/activity-metadata.json" "file_sha256" "6c82fe7814da75f780ed20aabef787d42b88088ae491cb3047a018b2fc098949" "basis" 2812 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/edb-import/verification.json"} {"question" "q-164586" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077759/state.json" "file_sha256" "