′}(1,2) & =⟨0,\\,2(2),\\,1⟩ \\\\  & =⟨0,\\,4,\\,1⟩\\end{aligned}\n$$\n\nTherefore, a normal vector to the surface is\n\n$$\n\\begin{aligned}n & ={r}_{u}^{′}(1,2)\\times {r}_{v}^{′}(1,2) \\\\  & =|\\begin{aligned}i & j & k \\\\ 2 & 0 & 2 \\\\ 0 & 4 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 2 \\\\ 4 & 1\\end{aligned}|,\\,-|\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}2 & 0 \\\\ 0 & 4\\end{aligned}|⟩ \\\\  & =⟨-8,\\,-2,\\,8⟩.\\end{aligned}\n$$\n\nFinally, the equation of the tangent plane is\n\n$$\n\\begin{aligned}n\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ⟨-8,\\,-2,\\,8⟩\\cdot ⟨x-1,\\,y-4,\\,z-2⟩ & =0 \\\\ (-8)\\cdot (x-1)+(-2)\\cdot (y-4)+8\\cdot (z-2) & =0 \\\\ -8x-2y+8z & =0 \\\\ 4x+y-4z & =0.\\end{aligned}\n$$" 13194139533394 17592186045585 true] [17592186247059 1068 #edb/ref 17592186246583 13194139533394 17592186045585 true] [17592186247059 1069 "q-109831" 13194139533394 17592186045585 true] [17592186247059 1070 #edb/ref 17592186045486 13194139533394 17592186045585 true] [17592186247059 1071 "Find the equation of the tangent plane to the surface defined by the equations\n\n$$\nx=u\\operatorname{sin}⁡v,\\,y={u}^{2},\\,z=2u\\operatorname{cos}⁡v,\\,u\\ge 0,\\,0\\le v<2\\pi ,\n$$\n\nat the point $(0,1,-2).$" 13194139533394 17592186045585 true] [17592186247059 1072 #uuid "9cc67a3d-04a9-55ab-887a-f7eda1e1b5b8" 13194139533394 17592186045585 true] [17592186247059 1074 "In vector form, our surface has the equation \n\n$$\nr(u,v)=⟨u\\operatorname{sin}⁡v,\\,{u}^{2},\\,2u\\operatorname{cos}⁡u⟩,\\,u\\ge 0,\\,0\\le v<2\\pi .\n$$\n\nFirst, notice that since $(0,1,-2)$ lies on the surface, we obtain\n\n$$\n{\\begin{aligned}u\\operatorname{sin}⁡v=0 \\\\ {u}^{2}=1 \\\\ 2u\\operatorname{cos}⁡v=-2\\end{aligned}\\,⟹\\,{\\begin{aligned}u=1 \\\\ v=\\pi .\\end{aligned}\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′}(u,v) & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u\\operatorname{sin}⁡v),\\,\\frac{∂}{∂u}({u}^{2}),\\,\\frac{∂}{∂u}(2u\\operatorname{cos}⁡v)⟩ \\\\  & =⟨\\operatorname{sin}⁡v,\\,2u,\\,2\\operatorname{cos}⁡v⟩ \\\\ {r}_{v}^{′}(u,v) & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u\\operatorname{sin}⁡v),\\,\\frac{∂}{∂v}({u}^{2}),\\,\\frac{∂}{∂v}(2u\\operatorname{cos}⁡v)⟩ \\\\  & =⟨u\\operatorname{cos}⁡v,\\,0,\\,-2u\\operatorname{sin}⁡v⟩\\end{aligned}\n$$\n\nNext, we evaluate these tangent vectors when $u=1$ and $v=\\pi :$\n\n$$\n\\begin{aligned}{r}_{u}^{′}(1,\\pi ) & =⟨\\operatorname{sin}⁡\\pi ,\\,2(1),\\,2\\operatorname{cos}⁡\\pi ⟩ \\\\  & =⟨0,\\,2,\\,-2⟩ \\\\ {r}_{v}^{′}(1,\\pi ) & =⟨1\\operatorname{cos}⁡\\pi ,\\,0,\\,-2(1)\\operatorname{sin}⁡\\pi ⟩ \\\\  & =⟨-1,\\,0,\\,0⟩\\end{aligned}\n$$\n\nTherefore, a normal vector to the surface is\n\n$$\n\\begin{aligned}n & ={r}_{u}^{′}(1,\\pi )\\times {r}_{v}^{′}(1,\\pi ) \\\\  & =|\\begin{aligned}i & j & k \\\\ 0 & 2 & -2 \\\\ -1 & 0 & 0\\end{aligned}| \\\\  & =⟨|\\begin{aligned}2 & -2 \\\\ 0 & 0\\end{aligned}|,\\,-|\\begin{aligned}0 & -2 \\\\ -1 & 0\\end{aligned}|,\\,|\\begin{aligned}0 & 2 \\\\ -1 & 0\\end{aligned}|⟩ \\\\  & =⟨0,\\,2,\\,2⟩.\\end{aligned}\n$$\n\nFinally, the equation of the tangent plane is\n\n$$\n\\begin{aligned}n\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ⟨0,\\,2,\\,2⟩\\cdot ⟨x,\\,y-1,\\,z+2⟩ & =0 \\\\ 0\\cdot x+2\\cdot (y-1)+2\\cdot (z+2) & =0 \\\\ 2y+2z+2 & =0 \\\\ y+z & =-1.\\end{aligned}\n$$" 13194139533394 17592186045585 true] [17592186247060 1068 #edb/ref 17592186246862 13194139533394 17592186045585 true] [17592186247060 1069 "q-10984" 13194139533394 17592186045585 true] [17592186247060 1070 #edb/ref 17592186045487 13194139533394 17592186045585 true] [17592186247060 1071 "Express $\\frac{44x+48}{(x+6)(x-3)(x+2)}$ as a sum of partial fractions." 13194139533394 17592186045585 true] [17592186247060 1072 #uuid "80991169-b0aa-5b28-add3-7bd898e48ab0" 13194139533394 17592186045585 true] [17592186247060 1074 "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{44x+48}{(x+6)(x-3)(x+2)} & =\\frac{A}{(x+6)}+\\frac{B}{(x-3)}+\\frac{C}{(x+2)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+6)(x-3)(x+2)$ gives\n\n$$\n44x+48=A(x-3)(x+2)+B(x+6)(x+2)+C(x+6)(x-3).\n$$\n\nFor $x=-6$, we get \n\n$$\n\\begin{aligned}44(-6)+48 & =A(-6-3)(-6+2) \\\\  & \\,+B(-6+6)(-6+2) \\\\  & \\,+C(-6+6)(-6-3) \\\\ -264+48 & =A(36) \\\\ A & =\\frac{-216}{36} \\\\ A & =-6.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}44(3)+48 & =A(3-3)(3+2) \\\\  & \\,+B(3+6)(3+2) \\\\  & \\,+C(3+6)(3-3) \\\\ 132+48 & =B(45) \\\\ B & =\\frac{180}{45} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=-2$, we get \n\n$$\n\\begin{aligned}44(-2)+48 & =A(-2-3)(-2+2) \\\\  & \\,+B(-2+6)(-2+2) \\\\  & \\,+C(-2+6)(-2-3) \\\\ -88+48 & =C(-20) \\\\ C & =\\frac{-40}{-20} \\\\ C & =2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{44x+48}{(x+6)(x-3)(x+2)}=-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}.\n$$" 13194139533394 17592186045585 true] [17592186247061 1068 #edb/ref 17592186246820 13194139533394 17592186045585 true] [17592186247061 1069 "q-10986" 13194139533394 17592186045585 true] [17592186247061 1070 #edb/ref 17592186045487 13194139533394 17592186045585 true] [17592186247061 1071 "Express $\\frac{22x-38}{(3-x)(2-x)(x+1)}$ as a sum of partial fractions." 13194139533394 17592186045585 true] [17592186247061 1072 #uuid "400ab8c9-505d-514d-9b8b-a37c002e9bd9" 13194139533394 17592186045585 true] [17592186247061 1074 "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{22x-38}{(3-x)(2-x)(x+1)} & =\\frac{A}{(3-x)}+\\frac{B}{(2-x)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3-x)(2-x)(x+1)$ gives\n\n$$\n22x-38=A(2-x)(x+1)+B(3-x)(x+1)+C(3-x)(2-x).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}22(3)-38 & =A(2-3)(3+1) \\\\  & \\,+B(3-3)(3+1) \\\\  & \\,+C(3-3)(2-3) \\\\ 66-38 & =A(-4) \\\\ A & =\\frac{28}{-4} \\\\ A & =-7.\\end{aligned}\n$$\n\nFor