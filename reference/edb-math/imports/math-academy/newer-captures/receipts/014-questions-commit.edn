}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=1$ and ${y}_{n}=5$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{i} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={5}^{2}-{1}^{2} \\\\  & =24.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256772 1068 #edb/ref 17592186256106 13194139533397 17592186045585 true] [17592186256772 1069 "q-122986" 13194139533397 17592186045585 true] [17592186256772 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256772 1071 "Let $P={{z}_{0},{z}_{1},…,{z}_{q}}$ be a partition of the interval $[-2,2].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" 13194139533397 17592186045585 true] [17592186256772 1072 #uuid "e1dc4455-1721-5a2f-b1a2-2964a49d4a5d" 13194139533397 17592186045585 true] [17592186256772 1074 "We can simplify the given summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-2$ and ${z}_{q}=2$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={2}^{2}-(-2)^{2} \\\\  & =0.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256773 1068 #edb/ref 17592186256346 13194139533397 17592186045585 true] [17592186256773 1069 "q-122988" 13194139533397 17592186045585 true] [17592186256773 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256773 1071 "Let $P={{y}_{0},{y}_{1},…,{y}_{n}}$ be a partition of the interval $[5,10].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" 13194139533397 17592186045585 true] [17592186256773 1072 #uuid "d3ce5690-a02d-5b4c-86c1-6cec41864c00" 13194139533397 17592186045585 true] [17592186256773 1074 "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=5$ and ${y}_{n}=10$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{i} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={10}^{2}-{5}^{2} \\\\  & =75.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256774 1068 #edb/ref 17592186256247 13194139533397 17592186045585 true] [17592186256774 1069 "q-122992" 13194139533397 17592186045585 true] [17592186256774 1070 #edb/ref 17592186045486 13194139533397 17592186045585 true] [17592186256774 1071 "Let $P={{z}_{0},{z}_{1},…,{z}_{q}}$ be a partition of the interval $[-2,4].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" 13194139533397 17592186045585 true] [17592186256774 1072 #uuid "e65ff59b-de1e-50f4-9c3d-679e5004d29d" 13194139533397 17592186045585 true] [17592186256774 1074 "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}=-2{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.\n$$\n\nWe can simplify the summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-2$ and ${z}_{q}=4$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={4}^{2}-(-2)^{2} \\\\  & =12.\\end{aligned}\n$$\n\n  \n\nFinally, we have\n\n$$\n-2{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}=(-2)\\cdot 12=-24.\n$$" 13194139533397 17592186045585 true] [17592186256775 1068 #edb/ref 17592186256069 13194139533397 17592186045585 true] [17592186256775 1069 "q-123003" 13194139533397 17592186045585 true] [17592186256775 1070 #edb/ref 17592186045485 13194139533397 17592186045585 true] [17592186256775 1071 "A curve has parametric equations $x={t}^{2}-10,\\,y=4{t}^{6}+5.$ Given that $\\frac{\\text{d}y}{\\text{d}x}=12{t}^{4},$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at the point where $t=1.$" 13194139533397 17592186045585 true] [17592186256775 1072 #uuid "9d9e720b-9be0-5b91-a998-bd0d620bd59e" 13194139533397 17592186045585 true] [17592186256775 1074 "To compute $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=12{t}^{4},$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}({t}^{2}-10)=2t.\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(12{t}^{4})}{2t} \\\\  & =\\frac{48{t}^{3}}{2t} \\\\  & =24{t}^{2}.\\end{aligned}\n$$\n\nFinally, we evaluate at $t=1,$ and we get\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{t=1}=24\\cdot {1}^{2}=24.\n$$" 13194139533397 17592186045585 true] [17592186256776 1068 #edb/ref 17592186256003 13194139533397 17592186045585 true] [17592186256776 1069 "q-123005" 13194139533397 17592186045585 true] [17592186256776 1070 #edb/ref 17592186045485 13194139533397 17592186045585 true] [17592186256776 1071 "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-8,\\,y={t}^{4}+5t$\nfrom $t=-2$ to $t=3$ ?" 13194139533397 17592186045585 true] [17592186256776 1072 #uuid "1ac06717-3d6e-5cb8-bb53-88e2680a811e" 13194139533397 17592186045585 true] [17592186256776 1074 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-8)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{4}+5t)=4{t}^{3}+5\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{{(3{t}^{2})}^{2}+{(4{t}^{3}+5)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{9{t}^{4}+16{t}^{6}+40{t}^{3}+25}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{3}\\sqrt{16{t}^{6}+9{t}^{4}+40{t}^{3}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256777 1068 #edb/ref 17592186256285 13194139533397 17592186045585 true] [17592186256777 1069 "q-123019" 13194139533397 17592186045585 true] [17592186256777 1070 #edb/ref 17592186045485 13194139533397 17592186045585 true] [17592186256777 1071 "![](images/0a/0a58808ee9b20e201d1ea8a31683f742e02f739127640de2fea87ce4757e7901.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{2},\\,y=5t$\nfrom $t=0$ to $t=1$ (shown above)?" 13194139533397 17592186045585 true] [17592186256777 1072 #uuid "a6c68291-2bb7-56b1-a306-1312ff237a63" 13194139533397 17592186045585 true] [17592186256777 1074 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5t)=5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(6t)^{2}+(5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256778 1068 #edb/ref 17592186255956 13194139533397 17592186045585 true] [17592186256778 1069 "q-123025" 13194139533397 17592186045585 true] [17592186256778 1070 #edb/ref 17592186045485 13194139533397 17592186045585 true] [17592186256778 1071 "Which of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{3}+5,\\,y={t}^{2}-5t$\nfrom $t=-1$ to $t=2$ ?" 13194139533397 17592186045585 true] [17592186256778 1072 #uuid "a0cda492-f891-5b24-90a6-900da47a3f8d" 13194139533397 17592186045585 true] [17592186256778 1074 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+5)=9{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-5t)=2t-5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{(9{t}^{2})^{2}+(2t-5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256779 1068 #edb/ref 17592186256035 13194139533397 17592186045585 true] [17592186256779 1069 "q-123049" 13194139533397 17592186045585 true] [17592186256779 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256779 1071 "![](images/76/76654da8bebc4a156a55bcb6cc7411f4977dfa14634fbceb6e1a7f8e32b2d5b0.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139533397 17592186045585 true] [17592186256779 1072 #uuid "df57e019-b35b-55c6-b523-1f5636c88e0f" 13194139533397 17592186045585 true] [17592186256779 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $3$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{31}\\cdot \\text{Area}({R}_{31}).\n$$\n\nNow, notice that\n\n$$\n\\begin{aligned}\\text{Area}({R}_{11})=6, \\\\ \\text{Area}({R}_{21})=2,\\end{aligned}\n$$\n\nand\n\n$$\n\\text{Area}({R}_{31})=4.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =6\\cdot {M}_{11}+2\\cdot {M}_{21}+4\\cdot {M}_{31} \\\\  & =6{M}_{11}+2{M}_{21}+4{M}_{31}.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256780 1068 #edb/ref 17592186256357 13194139533397 17592186045585 true] [17592186256780 1069 "q-123050" 13194139533397 17592186045585 true] [17592186256780 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256780 1071 "![](images/f7/f77ec60f3208cd221570e30ed8f4c1684607dc54567435071dd34ccf76ea5227.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139533397 17592186045585 true] [17592186256780 1072 #uuid "8fd2d25a-9510-5330-8510-208614ffeb11" 13194139533397 17592186045585 true] [17592186256780 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $2$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{12}\\cdot \\text{Area}({R}_{12}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=1\n$$\n\nand\n\n$$\n\\text{Area}({R}_{12})=3.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & ={M}_{11}+3\\cdot {M}_{12} \\\\  & ={M}_{11}+3{M}_{12}.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256781 1068 #edb/ref 17592186256049 13194139533397 17592186045585 true] [17592186256781 1069 "q-123051" 13194139533397 17592186045585 true] [17592186256781 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256781 1071 "![](images/c1/c11167f3e67f712b894cc56aef96897e5a75b1a3e0d1e3ca214f2fd48a70febb.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139533397 17592186045585 true] [17592186256781 1072 #uuid "02f5c727-8aeb-5f80-9f7e-beab173a39f9" 13194139533397 17592186045585 true] [17592186256781 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $3$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{13}\\cdot \\text{Area}({R}_{13}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{13})=1\n$$\n\nand\n\n$$\n\\text{Area}({R}_{12})=2.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & ={M}_{11}+2\\cdot {M}_{12}+{M}_{13} \\\\  & ={M}_{11}+2{M}_{12}+{M}_{13}.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256782 1068 #edb/ref 17592186256038 13194139533397 17592186045585 true] [17592186256782 1069 "q-123054" 13194139533397 17592186045585 true] [17592186256782 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256782 1071 "![](images/0b/0b41aab14e66fe196a2720e65d4f814da55acfdb0c7b8338ff9e44acfe808785.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139533397 17592186045585 true] [17592186256782 1072 #uuid "6295d61a-f5d6-515b-be88-ad4b4df51414" 13194139533397 17592186045585 true] [17592186256782 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $2$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=2\n$$\n\nand\n\n$$\n\\text{Area}({R}_{21})=10.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =2\\cdot {M}_{11}+10\\cdot {M}_{21} \\\\  & =2{M}_{11}+10{M}_{21}.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256783 1068 #edb/ref 17592186256365 13194139533397 17592186045585 true] [17592186256783 1069 "q-123069" 13194139533397 17592186045585 true] [17592186256783 1070 #edb/ref 17592186045485 13194139533397 17592186045585 true] [17592186256783 1071 "Consider the following partitions:\n\n- ${P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}}$ is a partition of the interval $[0,3]$\n\n- ${P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}}$ is a partition of the interval $[4,8]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" 13194139533397 17592186045585 true] [17592186256783 1072 #uuid "ecb6ed16-6d45-5080-8683-a8fbdb3fa178" 13194139533397 17592186045585 true] [17592186256783 1074 "Using the product rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j}={\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ and ${\\sum }_{j=1}^{n}Δ{y}_{j}$ are just the lengths of the intervals $[0,3]$ and $[4,8]$ respectively. So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =3-0=3, \\\\ {\\sum }_{j=1}^{n}Δ{y}_{j} & =8-4=4.\\end{aligned}\n$$\n\nCombining our results, we have\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}=3\\cdot 4=12.\n$$" 13194139533397 17592186045585 true] [17592186256784 1068 #edb/ref 17592186255946 13194139533397 17592186045585 true] [17592186256784 1069 "q-123104" 13194139533397 17592186045585 true] [17592186256784 1070 #edb/ref 17592186045486 13194139533397 17592186045585 true] [17592186256784 1071 "Consider the following partitions:\n\n- ${P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}}$ is a partition of the interval $[-1,1]$\n\n- ${P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}}$ is a partition of the interval $[-1,1]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}10({y}_{j}+{y}_{j-1})Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" 13194139533397 17592186045585 true] [17592186256784 1072 #uuid "0ba241ca-59af-54b9-bd13-904d2982cd6a" 13194139533397 17592186045585 true] [17592186256784 1074 "Using the constant multiple and product rules, we can write the summation as\n\n$$\n10{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[-1,1].$ So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i}=1-(-1) & =2.\\end{aligned}\n$$\n\nFor the sum over $j,$ we evaluate it as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{x}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}\\,+\\,{y}_{0})({y}_{1}\\,-\\,{y}_{0})\\,+\\,({y}_{2}\\,+\\,{y}_{1})({y}_{2}\\,-\\,{y}_{1})\\,+\\,⋯\\,+\\,({y}_{n}\\,+\\,{y}_{n-1})({y}_{n}\\,-\\,{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={1}^{2}-(-1)^{2} \\\\  & =0\\end{aligned}\n$$\n\nCombining our results, we finally arrive at\n\n$$\n10{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.=10\\cdot 2\\cdot 0=0.\n$$" 13194139533397 17592186045585 true] [17592186256785 1068 #edb/ref 17592186256323 13194139533397 17592186045585 true] [17592186256785 1069 "q-123132" 13194139533397 17592186045585 true] [17592186256785 1070 #edb/ref 17592186045486 13194139533397 17592186045585 true] [17592186256785 1071 "Let $R=[1,7]\\times [1,6]$ be a region in the $xy$-plane, and let $f(x,y)=xy.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}={1,3,5,7},\\,{P}_{2}={1,6},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" 13194139533397 17592186045585 true] [17592186256785 1072 #uuid "e4225c9b-f9c3-509c-8faa-46e65d5c864c" 13194139533397 17592186045585 true] [17592186256785 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/68/68270610704b1ef132469193e7948f54e548fa22223b6fc49b693753f998f874.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{31}\\cdot \\text{Area}({R}_{31}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=10$ for all $3$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =10\\cdot {M}_{11}+10\\cdot {M}_{21}+10\\cdot {M}_{31} \\\\  & =10({M}_{11}+{M}_{21}+{M}_{31}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=xy$ increases as $x$ increases, and\n\n- $f(x,y)=xy$ increases as $y$ increases.\n\n![](images/76/7611c64cc460db725893156f6043644b34962a04f2aacef0b19cf99c5769cda3.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/75/75f378700ce6593a7ed9577b34e093cbbfe702e9512e9962e0d6f7f681694842.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(3,6)=18 \\\\ {M}_{21} & =f(5,6)=30 \\\\ {M}_{31} & =f(7,6)=42\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =10(18+30+42) \\\\  & =900.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256786 1068 #edb/ref 17592186256114 13194139533397 17592186045585 true] [17592186256786 1069 "q-123145" 13194139533397 17592186045585 true] [17592186256786 1070 #edb/ref 17592186045485 13194139533397 17592186045585 true] [17592186256786 1071 "Which of the following is equivalent to ${\\int }_{C}3y\\,\\text{d}s,$ where $C$ is the ellipse $49{x}^{2}+{y}^{2}=49,$ traversed once in the counterclockwise direction?" 13194139533397 17592186045585 true] [17592186256786 1072 #uuid "0fec02e0-b697-5c02-8381-19cf8f50796e" 13194139533397 17592186045585 true] [17592186256786 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{7}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $7,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨\\operatorname{cos}⁡t,\\,7\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(7\\operatorname{sin}⁡t)j \\\\  & =-\\operatorname{sin}⁡t\\,i+7\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(7\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+49{cos}^{2}⁡t} \\\\  & =\\sqrt{48{cos}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{48{cos}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)=3y,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3(7\\operatorname{sin}⁡t)=21\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}3y\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }21\\operatorname{sin}⁡t\\sqrt{48{cos}^{2}⁡t+1}\\,\\text{d}t \\\\  & =21{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\sqrt{48{cos}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256787 1068 #edb/ref 17592186255948 13194139533397 17592186045585 true] [17592186256787 1069 "q-123150" 13194139533397 17592186045585 true] [17592186256787 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256787 1071 "Which of the following is equivalent to ${\\int }_{C}2xy\\,\\text{d}s,$ where $C$ is the ellipse $8{x}^{2}+2{y}^{2}=16,$ traversed once in the counterclockwise direction?" 13194139533397 17592186045585 true] [17592186256787 1072 #uuid "ba96e982-97fe-5a69-b758-ecab420f15cc" 13194139533397 17592186045585 true] [17592186256787 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{(\\sqrt{2})^{2}}+\\frac{{y}^{2}}{(2\\sqrt{2})^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $\\sqrt{2}$ and $2\\sqrt{2},$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨\\sqrt{2}\\operatorname{cos}⁡t,\\,2\\sqrt{2}\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}\\operatorname{sin}⁡t)j \\\\  & =-\\sqrt{2}\\operatorname{sin}⁡t\\,i+2\\sqrt{2}\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\sqrt{2}\\operatorname{sin}⁡t)^{2}+(2\\sqrt{2}\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{2{sin}^{2}⁡t+8{cos}^{2}⁡t} \\\\  & =\\sqrt{6{cos}^{2}⁡t+2({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{6{cos}^{2}⁡t+2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2xy,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2(\\sqrt{2}\\operatorname{cos}⁡t)(2\\sqrt{2}\\operatorname{sin}⁡t) \\\\  & =8\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =4\\cdot 2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =4\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}2xy\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{sin}⁡2t\\sqrt{6{cos}^{2}⁡t+2}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡2t\\sqrt{6{cos}^{2}⁡t+2}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256788 1068 #edb/ref 17592186256117 13194139533397 17592186045585 true] [17592186256788 1069 "q-123154" 13194139533397 17592186045585 true] [17592186256788 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256788 1071 "Which of the following is equivalent to ${\\int }_{C}({x}^{2}-8{y}^{2})\\,\\text{d}s,$ where $C$ is the ellipse ${x}^{2}+8{y}^{2}=8,$ traversed once in the counterclockwise direction?" 13194139533397 17592186045585 true] [17592186256788 1072 #uuid "225dcca1-72c4-569d-848c-f9b3a115bc27" 13194139533397 17592186045585 true] [17592186256788 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\frac{{x}^{2}}{(2\\sqrt{2})^{2}}+\\frac{{y}^{2}}{{1}^{2}}=1.\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2\\sqrt{2}$ and $1,$ respectively. Therefore, it can be parametrized as \n\n$$\nr(t)=⟨2\\sqrt{2}\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,0\\le t<2\\pi .\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j \\\\  & =-2\\sqrt{2}\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\sqrt{2}\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{8{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{7{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{7{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y)={x}^{2}-8{y}^{2},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(2\\sqrt{2}\\operatorname{cos}⁡t)^{2}-8(\\operatorname{sin}⁡t)^{2} \\\\  & =8{cos}^{2}⁡t-8{sin}^{2}⁡t \\\\  & =8({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\  & =8\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-8{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }8\\operatorname{cos}⁡2t\\sqrt{7{sin}^{2}⁡t+1}\\,\\text{d}t \\\\  & =8{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\sqrt{7{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533397 17592186045585 true] [17592186256789 1068 #edb/ref 17592186256135 13194139533397 17592186045585 true] [17592186256789 1069 "q-123167" 13194139533397 17592186045585 true] [17592186256789 1070 #edb/ref 17592186045487 13194139533397 17592186045585 true] [17592186256789 1071 "Given that $r(t)=⟨2\\operatorname{cos}⁡t,\\,{t}^{2}-t⟩,$ ${r}^{″}(t)=$" 13194139533397 17592186045585 true] [17592186256789 1072 #uuid "a571f70a-2498-5266-8661-d093b5f70776" 13194139533397 17592186045585 true] [17592186256789 1074 "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=2\\operatorname{cos}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-2\\operatorname{sin}⁡t \\\\ {x}^{″}(t) & =-2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\n- For $y(t)={t}^{2}-t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =2t-1 \\\\ {y}^{″}(t) & =2.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨-2\\operatorname{cos}⁡t,\\,2⟩.\\end{aligned}\n$$" 13194139533397 17592186045585 true]] :edb/tempids {"answer-002229b1-88a6-5891-80aa-21a9135ac8fb" 17592186253676 "answer-00678095-4785-5a48-bfd2-04906406b23d" 17592186253677 "answer-0082a5a1-ff4e-5a5d-a854-686f95ef6e42" 17592186253678 "answer-00b9a956-9780-57a0-92e9-f915756e4ff6" 17592186253679 "answer-00d68e7d-4ff7-5d3b-b960-356fcbec56d2" 17592186253680 "answer-00e873e7-a226-5f91-ae9b-124d88492e60" 17592186253681 "answer-01148ac2-6ac0-5e04-93a7-3196fa35ad68" 17592186253682 "answer-013d96a5-eea9-5479-a562-ce19153a10ba" 17592186253683 "answer-01457f0f-a114-52b0-8b99-dee62a99298a" 17592186253684 "answer-01587212-44f3-5dc7-bbfa-cf64be2bc5c0" 17592186253685 "answer-016a3368-f9d5-58aa-ab05-aad63edb1b18" 17592186253686 "answer-016b2c7d-35aa-5156-bbe5-bdb33c41c5e3" 17592186253687 "answer-0178b8a9-3976-50b5-b0b3-04d4b34c54a8" 17592186253688 "answer-01fe97b2-1a6a-5d0e-bee4-d2b03774906f" 17592186253689 "answer-020a2da6-4a5e-575f-ad8f-819547ac3b1f" 17592186253690 "answer-026f45f2-3480-501a-b813-16b2c86698bd" 17592186253691 "answer-0290f627-3c83-5afe-b636-ad528f0fe312" 17592186253692 "answer-02d2e661-d903-501c-a426-b35992d3d8f8" 17592186253693 "answer-02d61f17-a73a-559a-b50b-18f6f240d4bb" 17592186253694 "answer-02e27451-1c93-5939-a2aa-3ad5c9f224d1" 17592186253695 "answer-02e4f7f5-c8e8-5c4d-b7bc-c93fd5990393" 17592186253696 "answer-02ff9959-ca10-5d50-995e-9e7fc0a2ad71" 17592186253697 "answer-0301f345-dbc9-5380-a22d-4413a6606644" 17592186253698 "answer-032c1aed-5869-5996-b874-ec60376b4b7c" 17592186253699 "answer-0335560b-a354-5aa4-b231-eab70eea8ddf" 17592186253700 "answer-0347aedb-eae9-55e3-a006-0204054791d3" 17592186253701 "answer-0363b5d