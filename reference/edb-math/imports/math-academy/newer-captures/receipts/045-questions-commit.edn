\\\ 3-2\\text{i} & \\text{i} & 0\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-2+\\text{i}} & \\overset{―}{4} & \\overset{―}{-\\text{i}} \\\\ \\overset{―}{-5\\text{i}} & \\overset{―}{7-5\\text{i}} & \\overset{―}{1} \\\\ \\overset{―}{3-2\\text{i}} & \\overset{―}{\\text{i}} & \\overset{―}{0}\\end{aligned}] \\\\  & =[\\begin{aligned}-2-\\text{i} & 4 & \\text{i} \\\\ 5\\text{i} & 7+5\\text{i} & 1 \\\\ 3+2\\text{i} & -\\text{i} & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{13}+{b}_{31}=\\text{i}+(3+2\\text{i})=3+3\\text{i}.$" 13194139533428 17592186045585 true] [17592186345173 1068 #edb/ref 17592186344585 13194139533428 17592186045585 true] [17592186345173 1069 "q-76056" 13194139533428 17592186045585 true] [17592186345173 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345173 1071 "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2},{b}_{3}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ 2 \\\\ 5\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 3 \\\\ -1\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" 13194139533428 17592186045585 true] [17592186345173 1072 #uuid "b9b1c708-0429-5e44-9bc9-a554cb44ed9a" 13194139533428 17592186045585 true] [17592186345173 1074 "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 2 \\\\ 5\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ 3 \\\\ -1\\end{aligned}]+{x}_{3}[\\begin{aligned}-1 \\\\ 1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}1 \\\\ -2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 1 & -1 & 1 \\\\ 2 & 3 & 1 & -2 \\\\ 5 & -1 & 2 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & -1 & 1 \\\\ 0 & 1 & 3 & -4 \\\\ 5 & -1 & 2 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-5){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & -1 & 1 \\\\ 0 & 1 & 3 & -4 \\\\ 0 & -6 & 7 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}+6{R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 1 & -1 & 1 \\\\ 0 & 1 & 3 & -4 \\\\ 0 & 0 & 25 & -25\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}-{x}_{3}=1 \\\\ {x}_{2}+3{x}_{3}=-4 \\\\ 25{x}_{3}=-25.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting this into the second   equation yields\n\n$$\n{x}_{2}+3(-1)=-4\\,⟹\\,{x}_{2}=-1.\n$$\n\n Finally,  by substituting ${x}_{2}=-1$ and ${x}_{3}=-1$ into the first equation we obtain\n\n$$\n{x}_{1}+(-1)-(-1)=1\\,⟹\\,{x}_{1}=1.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}].$\n\nSo, we have \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=1+(-1)+(-1)=-1.\n$$" 13194139533428 17592186045585 true] [17592186345174 1068 #edb/ref 17592186344631 13194139533428 17592186045585 true] [17592186345174 1069 "q-76057" 13194139533428 17592186045585 true] [17592186345174 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345174 1071 "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}9-7\\text{i} & -2\\text{i} & 6-\\text{i} \\\\ -7 & 5-\\text{i} & \\text{i} \\\\ 6 & -\\text{i} & 0\\end{aligned}].$ What is the value of ${b}_{21}+{b}_{32}?$" 13194139533428 17592186045585 true] [17592186345174 1072 #uuid "aad215f0-b1cf-5385-a89c-46aa554c6d26" 13194139533428 17592186045585 true] [17592186345174 1074 "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}9-7\\text{i} & -2\\text{i} & 6-\\text{i} \\\\ -7 & 5-\\text{i} & \\text{i} \\\\ 6 & -\\text{i} & 0\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{9-7\\text{i}} & \\overset{―}{-2\\text{i}} & \\overset{―}{6-\\text{i}} \\\\ \\overset{―}{-7} & \\overset{―}{5-\\text{i}} & \\overset{―}{\\text{i}} \\\\ \\overset{―}{6} & \\overset{―}{-\\text{i}} & \\overset{―}{0}\\end{aligned}] \\\\  & =[\\begin{aligned}9+7\\text{i} & 2\\text{i} & 6+\\text{i} \\\\ -7 & 5+\\text{i} & -\\text{i} \\\\ 6 & \\text{i} & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{21}+{b}_{32}=-7+\\text{i}.$" 13194139533428 17592186045585 true] [17592186345175 1068 #edb/ref 17592186344752 13194139533428 17592186045585 true] [17592186345175 1069 "q-76059" 13194139533428 17592186045585 true] [17592186345175 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345175 1071 "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}7-\\text{i} & 6+4\\text{i} \\\\ 7-4\\text{i} & 4+9\\text{i}\\end{aligned}].$ What is the value of ${b}_{12}-{b}_{21}?$" 13194139533428 17592186045585 true] [17592186345175 1072 #uuid "49c6019f-3c20-53a6-9816-199ae4484ce7" 13194139533428 17592186045585 true] [17592186345175 1074 "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}7-\\text{i} & 6+4\\text{i} \\\\ 7-4\\text{i} & 4+9\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{7-\\text{i}} & \\overset{―}{6+4\\text{i}} \\\\ \\overset{―}{7-4\\text{i}} & \\overset{―}{4+9\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}7+\\text{i} & 6-4\\text{i} \\\\ 7+4\\text{i} & 4-9\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}-{b}_{21}=(6-4\\text{i})-(7+4\\text{i})=-1-8\\text{i}.$" 13194139533428 17592186045585 true] [17592186345176 1068 #edb/ref 17592186344717 13194139533428 17592186045585 true] [17592186345176 1069 "q-76061" 13194139533428 17592186045585 true] [17592186345176 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345176 1071 "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}5+4\\text{i} & -6\\text{i} \\\\ -5+7\\text{i} & 8-3\\text{i}\\end{aligned}].$ What is the value of ${b}_{21}-{b}_{22}?$" 13194139533428 17592186045585 true] [17592186345176 1072 #uuid "3500d72d-18ba-52aa-afec-29c407f01547" 13194139533428 17592186045585 true] [17592186345176 1074 "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}5+4\\text{i} & -6\\text{i} \\\\ -5+7\\text{i} & 8-3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{5+4\\text{i}} & \\overset{―}{-6\\text{i}} \\\\ \\overset{―}{-5+7\\text{i}} & \\overset{―}{8-3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}5-4\\text{i} & 6\\text{i} \\\\ -5-7\\text{i} & 8+3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{21}-{b}_{22}=(-5-7\\text{i})-(8+3\\text{i})=-13-10\\text{i}.$" 13194139533428 17592186045585 true] [17592186345177 1068 #edb/ref 17592186344594 13194139533428 17592186045585 true] [17592186345177 1069 "q-76063" 13194139533428 17592186045585 true] [17592186345177 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345177 1071 "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}-3+6\\text{i} & 2+7\\text{i} \\\\ 9 & 9-5\\text{i}\\end{aligned}].$ What is the value of ${b}_{12}+{b}_{22}?$" 13194139533428 17592186045585 true] [17592186345177 1072 #uuid "b7c1df80-7eb0-5daa-99fe-321f16fa32cd" 13194139533428 17592186045585 true] [17592186345177 1074 "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}-3+6\\text{i} & 2+7\\text{i} \\\\ 9 & 9-5\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-3+6\\text{i}} & \\overset{―}{2+7\\text{i}} \\\\ \\overset{―}{9} & \\overset{―}{9-5\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-3-6\\text{i} & 2-7\\text{i} \\\\ 9 & 9+5\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}+{b}_{22}=(2-7\\text{i})+(9+5\\text{i})=11-2\\text{i}.$" 13194139533428 17592186045585 true] [17592186345178 1068 #edb/ref 17592186344665 13194139533428 17592186045585 true] [17592186345178 1069 "q-76065" 13194139533428 17592186045585 true] [17592186345178 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345178 1071 "Determine the largest interval on which the function $f(x)=\\sqrt{18+3x}$ is continuous." 13194139533428 17592186045585 true] [17592186345178 1072 #uuid "313dbc47-39d4-5483-8967-1b586fc0a27b" 13194139533428 17592186045585 true] [17592186345178 1074 "Our function is a radical function, so it is continuous over all points in its domain.\n\nTo find the domain of $\\sqrt{18+3x}$, we set the expression under the radical to be greater than or equal to zero:\n\n$$\n\\begin{aligned}18+3x\\ge 0\\,⟹\\,3x\\ge -18\\,⟹\\, & \\,x\\ge -6\\end{aligned}\n$$\n\nTherefore, the domain of $f(x)$ is $[-6,\\infty )$, and the function is continuous on this interval." 13194139533428 17592186045585 true] [17592186345179 1068 #edb/ref 17592186344861 13194139533428 17592186045585 true] [17592186345179 1069 "q-76067" 13194139533428 17592186045585 true] [17592186345179 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345179 1071 "Determine the largest interval on which the function $f(x)=\\sqrt{6+x}+\\sqrt{5x+10}$ is continuous." 13194139533428 17592186045585 true] [17592186345179 1072 #uuid "a4448830-b102-5b0e-8785-87819bbce0fa" 13194139533428 17592186045585 true] [17592186345179 1074 "Our function consists of two radical functions, so it is continuous over all points in its domain.\n\n- To find the domain of $\\sqrt{6+x}$, we set the expression under the radical to be greater than or equal to zero:\n\n$$\n\\begin{aligned}6+x\\ge 0\\,⟹\\,x\\ge -6\\end{aligned}\n$$\n\n- To find the domain of $\\sqrt{5x+10}$, we set the expression under the radical to be greater than or equal to zero:\n\n$$\n\\begin{aligned}5x+10\\ge 0\\,⟹\\,5x\\ge -10\\,⟹\\,x\\ge -2\\end{aligned}\n$$\n\nThe domain of $f(x)$ is given by the intersection of the domain of our radical functions:\n\n$$\n[-6,\\infty )\\cap [-2,\\infty )=[-2,\\infty ),\n$$\n\nand the function is continuous on this interval." 13194139533428 17592186045585 true] [17592186345180 1068 #edb/ref 17592186344568 13194139533428 17592186045585 true] [17592186345180 1069 "q-76069" 13194139533428 17592186045585 true] [17592186345180 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345180 1071 "Determine the largest union of intervals on which the function $f(x)=\\frac{x-2}{4{x}^{2}-16x+16}$ is continuous." 13194139533428 17592186045585 true] [17592186345180 1072 #uuid "93c4f9ce-9d85-5806-8532-dd3e07cb9302" 13194139533428 17592186045585 true] [17592186345180 1074 "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-2}{4{x}^{2}-16x+16} \\\\  & =\\frac{x-2}{4({x}^{2}-4x+4)} \\\\  & =\\frac{x-2}{4(x-2)^{2}} \\\\  & =\\frac{1}{4(x-2)}\\end{aligned}\n$$\n\n \n\nThis function is continuous everywhere except at the excluded point $x=2.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,2)$ and $(2,\\infty ),$ namely\n\n$$\n(-\\infty ,2)\\cup (2,\\infty )\n$$\n\nand the function is also continuous on these intervals." 13194139533428 17592186045585 true] [17592186345181 1068 #edb/ref 17592186344827 13194139533428 17592186045585 true] [17592186345181 1069 "q-76070" 13194139533428 17592186045585 true] [17592186345181 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345181 1071 "Find the largest interval of continuity for the function $f(x)=\\operatorname{ln}⁡(\\frac{3x-12}{{x}^{2}+1}).$" 13194139533428 17592186045585 true] [17592186345181 1072 #uuid "df30d89a-58a8-55cb-b4e5-f7285000fdf4" 13194139533428 17592186045585 true] [17592186345181 1074 "Our function is a logarithmic function, so it is continuous over all points in its domain.\n\nTo find the domain of $\\operatorname{ln}⁡(\\frac{3x-12}{{x}^{2}+1}),$ we set the expression under the logarithm to be greater than zero:\n\n$$\n\\begin{aligned}\\frac{3x-12}{{x}^{2}+1}>0\\,⟹\\,3x-12>0\\,⟹\\,x>4\\end{aligned}\n$$\n\nTherefore, the domain of $f(x)=\\operatorname{ln}⁡(\\frac{3x-12}{{x}^{2}+1})$ is $(4,\\infty ),$ and it is also continuous on this interval." 13194139533428 17592186045585 true] [17592186345182 1068 #edb/ref 17592186344526 13194139533428 17592186045585 true] [17592186345182 1069 "q-76071" 13194139533428 17592186045585 true] [17592186345182 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345182 1071 "Find the largest interval of continuity for the function $f(x)={log}_{2}⁡(\\frac{2x+2}{3+{2}^{x}}).$" 13194139533428 17592186045585 true] [17592186345182 1072 #uuid "39454c83-6327-5d97-8cd7-df542c8ec3d9" 13194139533428 17592186045585 true] [17592186345182 1074 "Our function is a logarithmic function, so it is continuous over all points in its domain.\n\nTo find the domain of ${log}_{2}⁡(\\frac{2x+2}{3+{2}^{x}}),$ we set the expression under the logarithm to be greater than zero:\n\n$$\n\\begin{aligned}\\frac{2x+2}{3+{2}^{x}}>0\\,⟹\\,2x+2>0\\,⟹\\,x>-1\\end{aligned}\n$$\n\nTherefore, the domain of $f(x)={log}_{2}⁡(\\frac{2x+2}{3+{2}^{x}})$ is $(-1,\\infty ),$ and it is also continuous on this interval." 13194139533428 17592186045585 true] [17592186345183 1068 #edb/ref 17592186344900 13194139533428 17592186045585 true] [17592186345183 1069 "q-76072" 13194139533428 17592186045585 true] [17592186345183 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345183 1071 "Find the largest interval of continuity for the function $f(x)={log}_{3}⁡(\\frac{x-2}{{5}^{x}}).$" 13194139533428 17592186045585 true] [17592186345183 1072 #uuid "c926102b-c216-5ff1-91c1-7bb60a1ded88" 13194139533428 17592186045585 true] [17592186345183 1074 "Our function is a logarithmic function, so it is continuous over all points in its domain.\n\nTo find the domain of ${log}_{3}⁡(\\frac{x-2}{{5}^{x}}),$ we set the expression under the logarithm to be greater than zero:\n\n$$\n\\begin{aligned}\\frac{x-2}{{5}^{x}}>0\\,⟹\\,x-2>0\\,⟹\\,x>2\\end{aligned}\n$$\n\nTherefore, the domain of $f(x)={log}_{3}⁡(\\frac{x-2}{{5}^{x}})$ is $(2,\\infty ),$ and it is also continuous on this interval." 13194139533428 17592186045585 true] [17592186345184 1068 #edb/ref 17592186344949 13194139533428 17592186045585 true] [17592186345184 1069 "q-7608" 13194139533428 17592186045585 true] [17592186345184 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345184 1071 "![](images/20/202dec2a2e75aa6720181eb925f98999031453f8f1f8822dd86d7a2baab21396.png)\n\nWhat is the equation of the ellipse given above?" 13194139533428 17592186045585 true] [17592186345184 1072 #uuid "efae30e0-3c67-576a-b125-57ed6ed688b6" 13194139533428 17592186045585 true] [17592186345184 1074 "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{25} & =1.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345185 1068 #edb/ref 17592186344683 13194139533428 17592186045585 true] [17592186345185 1069 "q-76106" 13194139533428 17592186045585 true] [17592186345185 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345185 1071 "Consider the function $f(x)=\\sqrt{2x-1}.$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(3).$" 13194139533428 17592186045585 true] [17592186345185 1072 #uuid "9c47b28a-2993-50a5-9de3-ebf5581e87c8" 13194139533428 17592186045585 true] [17592186345185 1074 "To determine $({f}^{-1})^{′}(3),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(3)=\\frac{1}{{f}^{′}({f}^{-1}(3))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(3).$ To do this, we solve the equation ${f}^{-1}(3)=x.$ For $x>\\frac{1}{2}$, this gives\n\n$$\n\\begin{aligned}{f}^{-1}(3) & =x \\\\ f(x) & =3 \\\\ \\sqrt{2x-1} & =3 \\\\ 2x-1 & =9 \\\\ 2x & =10 \\\\ x & =5.\\end{aligned}\n$$\n\nNow, we calculate ${f}^{′}(5),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{2x-1} \\\\ {f}^{′}(x) & =\\frac{1}{\\sqrt{2x-1}} \\\\ {f}^{′}(5) & =\\frac{1}{\\sqrt{2\\cdot 5-1}} \\\\ {f}^{′}(5) & =\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(3) & =\\frac{1}{{f}^{′}({f}^{-1}(3))} \\\\  & =\\frac{1}{{f}^{′}(5)} \\\\  & =\\frac{1}{(\\frac{1}{3})} \\\\  & =3.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345186 1068 #edb/ref 17592186344792 13194139533428 17592186045585 true] [17592186345186 1069 "q-7611" 13194139533428 17592186045585 true] [17592186345186 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345186 1071 "What is the center of the ellipse  $\\frac{(x-3)^{2}}{16}+\\frac{(y-2)^{2}}{9}=1?$" 13194139533428 17592186045585 true] [17592186345186 1072 #uuid "6d9ee209-5d2d-5150-b267-1736ad1830f6" 13194139533428 17592186045585 true] [17592186345186 1074 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=3$ and $k=2,$ so the center is located at $(3,2).$" 13194139533428 17592186045585 true] [17592186345187 1068 #edb/ref 17592186344796 13194139533428 17592186045585 true] [17592186345187 1069 "q-76112" 13194139533428 17592186045585 true] [17592186345187 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345187 1071 "Consider the function $f(x)=(x+2)\\operatorname{ln}⁡(2x+1).$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(0).$" 13194139533428 17592186045585 true] [17592186345187 1072 #uuid "bf2118c1-1a12-50d3-8679-f4bc4826e598" 13194139533428 17592186045585 true] [17592186345187 1074 "To determine $({f}^{-1})^{′}(0),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(0)=\\frac{1}{{f}^{′}({f}^{-1}(0))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(0).$ To do this, we solve the equation ${f}^{-1}(0)=x.$ This gives\n\n$$\n\\begin{aligned}{f}^{-1}(0) & =x \\\\ f(x) & =0 \\\\ (x+2)\\operatorname{ln}⁡(2x+1) & =0 \\\\ x & =-2,\\,0.\\end{aligned}\n$$\n\nWe discard $x=-2$ since the logarithm is not defined for negative numbers. Therefore, ${f}^{-1}(0)=0.$\n\nNow, we calculate ${f}^{′}(0),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =(x+2)\\operatorname{ln}⁡(2x+1) \\\\ {f}^{′}(x) & =\\operatorname{ln}⁡(2x+1)+\\frac{2(x+2)}{2x+1} \\\\ {f}^{′}(0) & =\\operatorname{ln}⁡(2\\cdot 0+1)+\\frac{2(0+2)}{2\\cdot 0+1} \\\\ {f}^{′}(0) & =0+4 \\\\ {f}^{′}(0) & =4\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(0)} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345188 1068 #edb/ref 17592186344747 13194139533428 17592186045585 true] [17592186345188 1069 "q-76115" 13194139533428 17592186045585 true] [17592186345188 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345188 1071 "Consider the function $f(x)=\\frac{1}{\\sqrt{2x-1}}.$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(1).$" 13194139533428 17592186045585 true] [17592186345188 1072 #uuid "f7615d87-ff46-5839-a075-3229075fb3df" 13194139533428 17592186045585 true] [17592186345188 1074 "To determine $({f}^{-1})^{′}(1),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(1)=\\frac{1}{{f}^{′}({f}^{-1}(1))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(1).$ To do this, we solve the equation ${f}^{-1}(1)=x.$ For $x>\\frac{1}{2},$ this gives\n\n$$\n\\begin{aligned}{f}^{-1}(1) & =x \\\\ f(x) & =1 \\\\ \\frac{1}{\\sqrt{2x-1}} & =1 \\\\ 1 & =\\sqrt{2x-1} \\\\ 1 & =2x-1 \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, ${f}^{-1}(1)=1.$\n\nNow, we calculate ${f}^{′}(1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{\\sqrt{2x-1}} \\\\ {f}^{′}(x) & =-\\frac{1}{(2x-1)^{3/2}} \\\\ {f}^{′}(1) & =-\\frac{1}{(2\\cdot 1-1)^{3/2}} \\\\ {f}^{′}(1) & =-1\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(1) & =\\frac{1}{{f}^{′}({f}^{-1}(1))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =-1\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345189 1068 #edb/ref 17592186344691 13194139533428 17592186045585 true] [17592186345189 1069 "q-76124" 13194139533428 17592186045585 true] [17592186345189 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345189 1071 "![](images/04/04dcf34ee71d47a340cf46334ba08ae2c010bf9c284fc79188ff13ff5d42b243.png)\n\nOn which of the following intervals is the function $y=f(x)$ above continuous?" 13194139533428 17592186045585 true] [17592186345189 1072 #uuid "9689ce94-60f2-5a60-9383-c0bcd97eb2c8" 13194139533428 17592186045585 true] [17592186345189 1074 "The function is continuous on the open intervals $(-2,1),$ $(1,3)$ and $(3,\\infty ).$\n\nAdditionally, the function is right-continuous at $x=-2$ and left-continuous at $x=1.$ Hence, it is continuous on the closed interval $[-2,1].$\n\nTherefore, we can say that the function is continuous on the intervals $[-2,1]$ $(1,3)$ and $(3,\\infty ).$ It is also continuous on any subinterval of these intervals.\n\nAmong the answer choices, the correct one is the following:\n\n$\\,$ $[-2,1]$ \n\nNotice that:\n\n- $[-2,2]$ and $[0,2]$ contain the point $x=1,$ but the function is not right-continuous at this point.\n\n- $[2,3]$ and $[2,4]$ contain the point $x=3$ at which the function is not defined, so the function is not continuous on these intervals." 13194139533428 17592186045585 true] [17592186345190 1068 #edb/ref 17592186344804 13194139533428 17592186045585 true] [17592186345190 1069 "q-76128" 13194139533428 17592186045585 true] [17592186345190 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345190 1071 "Consider the function $f(x)=1+2{e}^{x+1}.$ Given that $y=f(x)$ is invertible throughout its domain, determine $({f}^{-1})^{′}(3).$" 13194139533428 17592186045585 true] [17592186345190 1072 #uuid "336c725c-310d-59e4-a4d6-4266c4a334d7" 13194139533428 17592186045585 true] [17592186345190 1074 "To determine $({f}^{-1})^{′}(3),$ we use the following formula:\n\n$$\n{({f}^{-1})}^{′}(3)=\\frac{1}{{f}^{′}({f}^{-1}(3))}\n$$\n\nFirst, we calculate the value of ${f}^{-1}(3).$ To do this, we solve the equation ${f}^{-1}(3)=x.$ This gives\n\n$$\n\\begin{aligned}{f}^{-1}(3) & =x \\\\ f(x) & =3 \\\\ 1+2{e}^{x+1} & =3 \\\\ 2{e}^{x+1} & =2 \\\\ {e}^{x+1} & =1 \\\\ x+1 & =0 \\\\ x & =-1.\\end{aligned}\n$$\n\nTherefore, ${f}^{-1}(3)=-1.$\n\nNow, we calculate ${f}^{′}(-1),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =1+2{e}^{x+1} \\\\ {f}^{′}(x) & =2{e}^{x+1} \\\\ {f}^{′}(-1) & =2{e}^{0} \\\\ {f}^{′}(-1) & =2\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}{({f}^{-1})}^{′}(3) & =\\frac{1}{{f}^{′}({f}^{-1}(3))} \\\\  & =\\frac{1}{{f}^{′}(-1)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345191 1068 #edb/ref 17592186344701 13194139533428 17592186045585 true] [17592186345191 1069 "q-76130" 13194139533428 17592186045585 true] [17592186345191 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345191 1071 "![](images/5d/5d90e9eb29955babde9d3af1ccd690b9d6b8fae6c07ad14da3867318b8487d90.png)\n\nOn which of the following intervals is the function $y=f(x)$ above continuous?" 13194139533428 17592186045585 true] [17592186345191 1072 #uuid "d82b2cb4-540b-5251-ae04-161e624e2cac" 13194139533428 17592186045585 true] [17592186345191 1074 "The function is continuous on the open intervals  $(-5,0),$ and  $(0,2\\pi ).$ \n\nAdditionally, the function is right-continuous at $x=0$ and at $x=-5.$  \n\nTherefore, we can say that the function is continuous on the intervals $[-5,0)$  and  $[0,2\\pi ).$ It is also continuous on any subinterval of these intervals.\n\nAmong the answer choices, the correct one is the following:\n\n$\\,$ $[0,\\pi ]$ \n\nNotice that:\n\n- $[0,2\\pi ]$ and $[\\pi ,2\\pi ]$ contain the point $x=2\\pi ,$ but the function is not defined at this point, so it can't be continuous on these intervals.\n\n- $[-5,0]$ and $[-2,\\pi ]$  contain the point of discontinuity $x=0,$ so the function is not continuous on these intervals." 13194139533428 17592186045585 true] [17592186345192 1068 #edb/ref 17592186344640 13194139533428 17592186045585 true] [17592186345192 1069 "q-76154" 13194139533428 17592186045585 true] [17592186345192 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345192 1071 "Which of the following functions is continuous on the interval $[-1,2]?$" 13194139533428 17592186045585 true] [17592186345192 1072 #uuid "95861a86-913a-521b-bbf4-e4f8fea5b0bd" 13194139533428 17592186045585 true] [17592186345192 1074 "The correct answer is the following. \n\n![](images/8b/8bfb5e934d6ce86fc478c5ff200db616f65c95956030ccfb247e526551ee8a37.png)\n\n  \n\nIndeed, this function is continuous on the open intervals $(-\\infty ,-\\sqrt{3}),$ $(-\\sqrt{3},2),$ and $(2,6).$\n\nAdditionally, the function is left-continuous at $x=2.$ Hence, it is continuous on the interval $(-\\sqrt{3},2].$\n\nSo, we can say that the function is continuous on the intervals $(-\\infty ,\\sqrt{3}),$ $(-\\sqrt{3},2],$ and $(2,6).$ It is also continuous on any subinterval of these intervals.\n\nTherefore, this function is continuous on $[-1,2],$ because $[-1,2]$ is contained inside the interval $(-\\sqrt{3},2].$\n\nNotice that:\n\n- $q(x)$ is not left-continuous at $x=2,$ so it is not continuous on the interval $[-1,2].$\n\n- $f(x)$ is not defined at $x=0,$ and so it is not continuous on the interval $[-1,2].$\n\n- $g(x)$ has a removable discontinuity at some point in the interval $(0,2).$  So it is not continuous on the interval $[-1,2].$\n\n- $h(x)$ is not defined at $x=-1,$ and so it is not continuous on the interval $[-1,2].$" 13194139533428 17592186045585 true] [17592186345193 1068 #edb/ref 17592186344620 13194139533428 17592186045585 true] [17592186345193 1069 "q-76158" 13194139533428 17592186045585 true] [17592186345193 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345193 1071 "Which of the following functions is continuous on the interval $(-2,2]?$" 13194139533428 17592186045585 true] [17592186345193 1072 #uuid "e510a0f6-dd04-5bd8-9a12-207ae85954ae" 13194139533428 17592186045585 true] [17592186345193 1074 "The correct answer is the following.\n\n![](images/22/221f7b64094910a5c1037e7071826f27f2ea0472ea93a612e9d38f3c46f5ad27.png)\n\nIndeed, we have that $q(x)$ is continuous on the open interval $(-2,2).$ \n\nAdditionally, the function is left-continuous at $x=2.$ Hence, it is continuous on the interval $(-2,2].$\n\nNotice that:\n\n- $f(x)$ is not left-continuous at $x=2.$\n\n- $g(x)$, $h(x)$, and $p(x)$ are not continuous at some point that lies inside the interval $(-2,2).$" 13194139533428 17592186045585 true] [17592186345194 1068 #edb/ref 17592186344921 13194139533428 17592186045585 true] [17592186345194 1069 "q-7619" 13194139533428 17592186045585 true] [17592186345194 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345194 1071 "![](images/2b/2bc4b82c6cfae63026f221dd49cdc74a9ce3884443e933cae02c36f6d732707e.png)\n\nWhat is the equation of the ellipse given above?" 13194139533428 17592186045585 true] [17592186345194 1072 #uuid "25c67443-abb8-58a6-bbc2-b7f961d0e0ed" 13194139533428 17592186045585 true] [17592186345194 1074 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-2,4),$ the horizontal radius has length $a=1,$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-2))^{2}}{{1}^{2}}+\\frac{(y-4)^{2}}{{3}^{2}} & =1 \\\\ (x+2)^{2}+\\frac{(y-4)^{2}}{9} & =1.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345195 1068 #edb/ref 17592186344516 13194139533428 17592186045585 true] [17592186345195 1069 "q-76201" 13194139533428 17592186045585 true] [17592186345195 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345195 1071 "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}]\\,$ then what is the value of $cd+gh?$" 13194139533428 17592186045585 true] [17592186345195 1072 #uuid "bd4340c5-cc43-5fc5-a905-42e6c2bd59d0" 13194139533428 17592186045585 true] [17592186345195 1074 "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 0+5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -1 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $c=1,d=0,g=1$ and $h=5.$ Therefore,\n\n$$\ncd+gh=1\\cdot 0+1\\cdot 5=5.\n$$" 13194139533428 17592186045585 true] [17592186345196 1068 #edb/ref 17592186344619 13194139533428 17592186045585 true] [17592186345196 1069 "q-76202" 13194139533428 17592186045585 true] [17592186345196 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345196 1071 "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}8 & 1-6\\text{i} \\\\ 3+\\text{i} & 4+2\\text{i}\\end{aligned}]\\,$ then what is the value of $bc+eg?$" 13194139533428 17592186045585 true] [17592186345196 1072 #uuid "f7450ea4-ef6e-5340-ac53-138f6702e426" 13194139533428 17592186045585 true] [17592186345196 1074 "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}8 & 1-6\\text{i} \\\\ 3+\\text{i} & 4+2\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}8+0\\text{i} & 1-6\\text{i} \\\\ 3+\\text{i} & 4+2\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}8 & 1 \\\\ 3 & 4\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}0 & -6 \\\\ 1 & 2\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $b=1,c=3,e=0$ and $g=1.$ Therefore,\n\n$$\nbc+eg=1\\cdot 3+0\\cdot 1=3.\n$$" 13194139533428 17592186045585 true] [17592186345197 1068 #edb/ref 17592186344905 13194139533428 17592186045585 true] [17592186345197 1069 "q-76203" 13194139533428 17592186045585 true] [17592186345197 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345197 1071 "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}-3\\text{i} & 5\\text{i} \\\\ -4 & 5\\end{aligned}]\\,$ then what is the value of $ah-cf?$" 13194139533428 17592186045585 true] [17592186345197 1072 #uuid "ec506ad6-de50-599d-8a2a-07eff3ab4556" 13194139533428 17592186045585 true] [17592186345197 1074 "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3\\text{i} & 5\\text{i} \\\\ -4 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}0-3\\text{i} & 0+5\\text{i} \\\\ -4+0\\text{i} & 5+0\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}0 & 0 \\\\ -4 & 5\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & 5 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=0,c=-4,f=5$ and $h=0.$ Therefore,\n\n$$\nah-cf=0\\cdot 0-(-4)\\cdot 5=20.\n$$" 13194139533428 17592186045585 true] [17592186345198 1068 #edb/ref 17592186344927 13194139533428 17592186045585 true] [17592186345198 1069 "q-76207" 13194139533428 17592186045585 true] [17592186345198 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345198 1071 "Find the imaginary part of the matrix $A=[\\begin{aligned}8+\\text{i} & 3-4\\text{i} \\\\ 9 & \\text{i}\\end{aligned}].$" 13194139533428 17592186045585 true] [17592186345198 1072 #uuid "ee75bb73-f205-5858-a7b6-5d0fd3c5399e" 13194139533428 17592186045585 true] [17592186345198 1074 "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}8+\\text{i} & 3-4\\text{i} \\\\ 9 & \\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}8+\\text{i} & 3-4\\text{i} \\\\ 9+0\\text{i} & 0+\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}8 & 3 \\\\ 9 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Im}(A)=[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}].$" 13194139533428 17592186045585 true] [17592186345199 1068 #edb/ref 17592186344629 13194139533428 17592186045585 true] [17592186345199 1069 "q-76208" 13194139533428 17592186045585 true] [17592186345199 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345199 1071 "![](images/ab/abfd15c8ed134a30ad719f6a857268427511e7f1f15ecfe0d27e5026b5401a83.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-2)$\n- $x\\in [-2,3)$\n- $x\\in [3,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." 13194139533428 17592186045585 true] [17592186345199 1072 #uuid "ca01d454-a476-5d37-9896-aa972462aa23" 13194139533428 17592186045585 true] [17592186345199 1074 "Let's examine each statement.\n\n- The function is continuous on the open interval $(-\\infty ,-2).$\n\n- The function is continuous on $[-2,3).$ It is continuous on $(-2,3)$ and also right continuous at $x=-2.$\n\n- The function is continuous on $[3,\\infty ).$ It is continuous on $(3,\\infty )$ and also right continuous at $x=3.$\n\nTherefore, the correct answer is \"I, II, and III.\"" 13194139533428 17592186045585 true] [17592186345200 1068 #edb/ref 17592186344545 13194139533428 17592186045585 true] [17592186345200 1069 "q-76209" 13194139533428 17592186045585 true] [17592186345200 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345200 1071 "If $\\,A=[\\begin{aligned}\\text{i} & 2-\\text{i} \\\\ 1-2\\text{i} & 2\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}1+2\\text{i} \\\\ 1-\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" 13194139533428 17592186045585 true] [17592186345200 1072 #uuid "82f57748-6b87-5651-91c7-3bf42146ea1a" 13194139533428 17592186045585 true] [17592186345200 1074 "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}\\text{i} & 2-\\text{i} \\\\ 1-2\\text{i} & 2\\end{aligned}]\\cdot [\\begin{aligned}1+2\\text{i} \\\\ 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}\\text{i}(1+2\\text{i})+(2-\\text{i})(1-\\text{i}) \\\\ (1-2\\text{i})(1+2\\text{i})+2(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(\\text{i}-2)+(1-3\\text{i}) \\\\ 5+(2-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-2\\text{i} \\\\ 7-2\\text{i}\\end{aligned}].\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345201 1068 #edb/ref 17592186344681 13194139533428 17592186045585 true] [17592186345201 1069 "q-76210" 13194139533428 17592186045585 true] [17592186345201 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345201 1071 "![](images/5e/5e787dda0cccdafaa6a93176daea5f954b1cd1da0beaff410a6563536459208e.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-1]$\n- $x\\in [-2,0]$\n- $x\\in [-1,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." 13194139533428 17592186045585 true] [17592186345201 1072 #uuid "d16a77c7-8df1-5b6e-bc46-f6c511c4b268" 13194139533428 17592186045585 true] [17592186345201 1074 "Let's examine each statement.\n\n- The function is continuous on $(-\\infty ,-1].$ It is continuous on $(-\\infty ,-1)$ and also left continuous at $x=-1.$\n\n- The function is *not* continuous on $[-2,0]$ because it contains a discontinuity at $x=-1.$\n\n- The function is *not* continuous on $[-1,\\infty ).$ Although the function is continuous on $(-1,\\infty ),$ it is not right-continuous at $x=-1.$\n\nTherefore, the correct answer is \"I only.\"" 13194139533428 17592186045585 true] [17592186345202 1068 #edb/ref 17592186344779 13194139533428 17592186045585 true] [17592186345202 1069 "q-76211" 13194139533428 17592186045585 true] [17592186345202 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345202 1071 "If $\\,A=[\\begin{aligned}3+\\text{i} & -\\text{i} & 1-4\\text{i} \\\\ 1-\\text{i} & 1+\\text{i} & 2\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}1+\\text{i} \\\\ 1-\\text{i} \\\\ 1+4\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" 13194139533428 17592186045585 true] [17592186345202 1072 #uuid "bcf7a35e-4489-5535-b3fb-5d3c1842698d" 13194139533428 17592186045585 true] [17592186345202 1074 "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}3+\\text{i} & -\\text{i} & 1-4\\text{i} \\\\ 1-\\text{i} & 1+\\text{i} & 2\\end{aligned}]\\cdot [\\begin{aligned}1+\\text{i} \\\\ 1-\\text{i} \\\\ 1+4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(3+\\text{i})(1+\\text{i})+(-\\text{i})(1-\\text{i})+(1-4\\text{i})(1+4\\text{i}) \\\\ (1-\\text{i})(1+\\text{i})+(1+\\text{i})(1-\\text{i})+2(1+4\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(2+4\\text{i})+(-\\text{i}-1)+17 \\\\ 2+2+(2+8\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}18+3\\text{i} \\\\ 6+8\\text{i}\\end{aligned}].\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345203 1068 #edb/ref 17592186344635 13194139533428 17592186045585 true] [17592186345203 1069 "q-76218" 13194139533428 17592186045585 true] [17592186345203 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345203 1071 "![](images/18/186ac941080da34b7c149534a2e255852241b28855c0ef15db2beee2d692007a.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,3]$\n- $x\\in (-\\infty ,5)$\n- $x\\in (4,6)$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." 13194139533428 17592186045585 true] [17592186345203 1072 #uuid "a8275053-44d7-522b-8662-3358231e9c18" 13194139533428 17592186045585 true] [17592186345203 1074 "Let's examine each statement.\n\n- The function is *not* continuous on $(-\\infty ,3].$ Although the function is continuous on $(-\\infty ,3),$ it is not left-continuous at $x=3.$\n\n- The function is *not* continuous on $(-\\infty ,5)$ because it contains a discontinuity at $x=3.$\n\n- The function is continuous on $(4,6).$ It is continuous on $[3,\\infty )$ and this contains the interval $(4,6).$\n\nTherefore, the correct answer is \"III only.\"" 13194139533428 17592186045585 true] [17592186345204 1068 #edb/ref 17592186344841 13194139533428 17592186045585 true] [17592186345204 1069 "q-76222" 13194139533428 17592186045585 true] [17592186345204 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345204 1071 "If $\\,A=[\\begin{aligned}2-\\text{i} & 3+\\text{i} \\\\ 1+2\\text{i} & 1+\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}1+\\text{i} & 2+\\text{i} \\\\ -2+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" 13194139533428 17592186045585 true] [17592186345204 1072 #uuid "13486772-1c45-5ec5-b469-19ab32b75956" 13194139533428 17592186045585 true] [17592186345204 1074 "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}2-\\text{i} & 3+\\text{i} \\\\ 1+2\\text{i} & 1+\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}1+\\text{i} & 2+\\text{i} \\\\ -2+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(2-\\text{i})(1+\\text{i})+(3+\\text{i})(-2+\\text{i}) & (2-\\text{i})(2+\\text{i})+(3+\\text{i})(1-\\text{i}) \\\\ (1+2\\text{i})(1+\\text{i})+(1+\\text{i})(-2+\\text{i}) & (1+2\\text{i})(2+\\text{i})+(1+\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(3+\\text{i})+(-7+\\text{i}) & 5+(4-2\\text{i}) \\\\ (-1+3\\text{i})+(-3-\\text{i}) & 2+5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-4+2\\text{i} & 9-2\\text{i} \\\\ -4+2\\text{i} & 2+5\\text{i}\\end{aligned}].\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345205 1068 #edb/ref 17592186344647 13194139533428 17592186045585 true] [17592186345205 1069 "q-76223" 13194139533428 17592186045585 true] [17592186345205 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345205 1071 "If $\\,A=[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" 13194139533428 17592186045585 true] [17592186345205 1072 #uuid "b1863dff-00b9-5c27-973f-de3c6f3a56d9" 13194139533428 17592186045585 true] [17592186345205 1074 "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-3\\text{i})(3-\\text{i})+(-1+2\\text{i})(-1+\\text{i}) & (1-3\\text{i})(3+\\text{i})+(-1+2\\text{i})(1-\\text{i}) \\\\ (2+2\\text{i})(3-\\text{i})+(1-\\text{i})(-1+\\text{i}) & (2+2\\text{i})(3+\\text{i})+(1-\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-10\\text{i}+(-1-3\\text{i}) & (6-8\\text{i})+(1+3\\text{i}) \\\\ (8+4\\text{i})+2\\text{i} & (4+8\\text{i})+(-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}].\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345206 1068 #edb/ref 17592186344721 13194139533428 17592186045585 true] [17592186345206 1069 "q-76247" 13194139533428 17592186045585 true] [17592186345206 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345206 1071 "Find the least common multiple of $6(x-5),$ $\\,4(x-5)^{3},$ and $8(x-5)^{4}.$" 13194139533428 17592186045585 true] [17592186345206 1072 #uuid "25ffefd8-10f4-54c8-b9ee-5cba63be1ad4" 13194139533428 17592186045585 true] [17592186345206 1074 "To find the least common multiple ($\\text{LCM}$) of three polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(6,4,8):$\n\n- Multiples of $6:$ $\\,6,\\,12,\\,18,\\,24,…$\n\n- Multiples of $4:$ $\\,4,\\,8,\\,12,\\,16,\\,20,\\,24,…$\n\n- Multiples of $8:$ $\\,8,\\,16,\\,24,\\,32,…$\n\nSo, $\\text{LCM}(6,4,8)=24.$\n\nTo find the $\\text{LCM}$ of $(x-5),$ $(x-5)^{3},$ and $(x-5)^{4},$ we raise $(x-5)$ to the largest power that appears in all these expressions, which is $4.$ Therefore,\n\n$$\n\\text{LCM}((x-5),\\,(x-5)^{3},\\,(x-5)^{4})=(x-5)^{4}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(6(x-5),\\,4(x-5)^{3},\\,8(x-5)^{4})=24\\cdot (x-5)^{4}=24(x-5)^{4}.\n$$" 13194139533428 17592186045585 true] [17592186345207 1068 #edb/ref 17592186344687 13194139533428 17592186045585 true] [17592186345207 1069 "q-76252" 13194139533428 17592186045585 true] [17592186345207 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345207 1071 "Given the matrix $A=[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1}\n$$" 13194139533428 17592186045585 true] [17592186345207 1072 #uuid "4b9b1ca3-35b5-5530-8cc0-a288c252189f" 13194139533428 17592186045585 true] [17592186345207 1074 "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ -3+\\frac{3}{1+\\text{i}}\\cdot (1+\\text{i}) & \\text{i}\\end{aligned}] \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}].\n$$" 13194139533428 17592186045585 true] [17592186345208 1068 #edb/ref 17592186344637 13194139533428 17592186045585 true] [17592186345208 1069 "q-76254" 13194139533428 17592186045585 true] [17592186345208 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345208 1071 "Given the matrix $A=[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{7}{\\text{i}}{R}_{1}\n$$" 13194139533428 17592186045585 true] [17592186345208 1072 #uuid "a88b6c4c-7d86-59b8-a20e-ef073aed49d7" 13194139533428 17592186045585 true] [17592186345208 1074 "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{7}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7+(-\\text{i})\\cdot \\frac{7}{\\text{i}} & \\text{(}3-2\\text{i})+i\\cdot \\frac{7}{\\text{i}}\\end{aligned}] \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}].\n$$" 13194139533428 17592186045585 true] [17592186345209 1068 #edb/ref 17592186344767 13194139533428 17592186045585 true] [17592186345209 1069 "q-76255" 13194139533428 17592186045585 true] [17592186345209 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345209 1071 "Given the matrix $A=[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 3\\text{i} & -2\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+(-\\frac{3\\text{i}}{2-\\text{i}}){R}_{1}\n$$" 13194139533428 17592186045585 true] [17592186345209 1072 #uuid "373bfa7c-f3cf-5be4-9a31-c2d8cf824718" 13194139533428 17592186045585 true] [17592186345209 1074 "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-\\text{i} & 2\\text{+}1 \\\\ 3\\text{i} & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{3\\text{i}}{2-\\text{i}}){R}_{1} \\\\  & ∼[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 3\\text{i}+(-\\frac{3\\text{i}(2-\\text{i})}{2-\\text{i}}) & -2+(-\\frac{3\\text{i}(2\\text{i}+1)}{2-\\text{i}})\\end{aligned}] \\\\  & =[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 0 & \\frac{(-4+2\\text{i})+(6-3\\text{i})}{2-\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 0 & 1\\end{aligned}].\n$$" 13194139533428 17592186045585 true] [17592186345210 1068 #edb/ref 17592186344513 13194139533428 17592186045585 true] [17592186345210 1069 "q-76256" 13194139533428 17592186045585 true] [17592186345210 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345210 1071 "Given the matrix $A=[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i} & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operation:\n\n$$\n{R}_{2}:={R}_{2}+\\frac{2-\\text{i}}{1+2\\text{i}}{R}_{1}\n$$" 13194139533428 17592186045585 true] [17592186345210 1072 #uuid "f9e8415b-7827-5393-a148-9368e6831399" 13194139533428 17592186045585 true] [17592186345210 1074 "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i} & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{2-\\text{i}}{1+2\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ -2+\\text{i}+\\frac{(2-\\text{i})(1+2\\text{i})}{1+2\\text{i}} & \\text{i}+\\frac{(2-\\text{i})(1+\\text{i})}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & \\frac{(\\text{i}-2)+(3+\\text{i})}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+2\\text{i} & 1+\\text{i} \\\\ 0 & 1\\end{aligned}].\n$$" 13194139533428 17592186045585 true] [17592186345211 1068 #edb/ref 17592186344799 13194139533428 17592186045585 true] [17592186345211 1069 "q-7632" 13194139533428 17592186045585 true] [17592186345211 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345211 1071 "Determine the center of the ellipse whose equation is $5{x}^{2}+9{y}^{2}-10x-36y=4.$" 13194139533428 17592186045585 true] [17592186345211 1072 #uuid "b972a86c-4480-5828-a8e2-d62f9765dca2" 13194139533428 17592186045585 true] [17592186345211 1074 "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}+9{y}^{2}-10x-36y & =4 \\\\ (5{x}^{2}-10x)+(9{y}^{2}-36y) & =4\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(5{x}^{2}-10x)+(9{y}^{2}-36y) & =4 \\\\ 5[{x}^{2}-2x]+9[{y}^{2}-4y] & =4 \\\\ 5[(x-1)^{2}-{1}^{2}]+9[(y-2)^{2}-{2}^{2}] & =4 \\\\ 5[(x-1)^{2}-1]+9[(y-2)^{2}-4] & =4 \\\\ 5(x-1)^{2}-5+9(y-2)^{2}-36 & =4\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}5(x-1)^{2}-5+9(y-2)^{2}-36 & =4 \\\\ 5(x-1)^{2}+9(y-2)^{2} & =4+5+36 \\\\ 5(x-1)^{2}+9(y-2)^{2} & =45 \\\\ \\frac{(x-1)^{2}}{9}+\\frac{(y-2)^{2}}{5} & =1 \\\\ \\frac{(x-1)^{2}}{{3}^{2}}+\\frac{(y-2)^{2}}{(\\sqrt{5})^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(1,2).$" 13194139533428 17592186045585 true] [17592186345212 1068 #edb/ref 17592186344588 13194139533428 17592186045585 true] [17592186345212 1069 "q-76322" 13194139533428 17592186045585 true] [17592186345212 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345212 1071 "The vectors ${a}_{1},$ ${a}_{2},$ and ${a}_{3}$ are given below. Determine whether $B={{a}_{1},{a}_{2}}$ is a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ If that is the case, find ${x}_{1}\\cdot {x}_{2},$ where ${a}_{3}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 6\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}8 \\\\ 12\\end{aligned}]\n$$" 13194139533428 17592186045585 true] [17592186345212 1072 #uuid "22366352-9de1-515d-ad32-c51e7aed6aa3" 13194139533428 17592186045585 true] [17592186345212 1074 "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ So, we want to find ${x}_{1},{x}_{2}\\in R$ such that \n\n$$\n{x}_{1}{{[\\begin{aligned}1 \\\\ -3\\end{aligned}]}_{⏟}}_{{a}_{1}}+{x}_{2}{{[\\begin{aligned}2 \\\\ 6\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}8 \\\\ 12\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}=8 \\\\ -3{x}_{1}+6{x}_{2}=12\\end{aligned}\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,[\\begin{aligned}1 & 2 & 8 \\\\ -3 & 6 & 12\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 8 \\\\ 0 & 12 & 36\\end{aligned}] & {R}_{2} & :=\\frac{1}{12}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 8 \\\\ 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 2 \\\\ 0 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$\nAlso, the matrix tells us that ${x}_{1}=2$ and ${x}_{2}=3,$ meaning that\n\n$$\n2\\cdot {{[\\begin{aligned}1 \\\\ -3\\end{aligned}]}_{⏟}}_{{a}_{1}}+3\\cdot {{[\\begin{aligned}2 \\\\ 6\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}8 \\\\ 12\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=2\\cdot 3=6.$" 13194139533428 17592186045585 true] [17592186345213 1068 #edb/ref 17592186344696 13194139533428 17592186045585 true] [17592186345213 1069 "q-76327" 13194139533428 17592186045585 true] [17592186345213 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345213 1071 "The vectors ${a}_{1},$ ${a}_{2},$ and ${a}_{3}$ are given below. Determine whether $B={{a}_{1},{a}_{2}}$ is a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ If that is the case, find ${x}_{1}\\cdot {x}_{2},$ where ${a}_{3}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-6 \\\\ -10\\end{aligned}]\n$$" 13194139533428 17592186045585 true] [17592186345213 1072 #uuid "40af98fe-8e4f-539d-b55b-52163dd7e4ff" 13194139533428 17592186045585 true] [17592186345213 1074 "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ So, we want to find ${x}_{1},{x}_{2}\\in R$ such that \n\n$$\n{x}_{1}{{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{{a}_{1}}+{x}_{2}{{[\\begin{aligned}1 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}-6 \\\\ -10\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{2}=-6 \\\\ {x}_{1}+2{x}_{2}=-10\\end{aligned}\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,[\\begin{aligned}1 & 1 & -6 \\\\ 1 & 2 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & -6 \\\\ 0 & 1 & -4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 \\\\ 0 & 1 & -4\\end{aligned}]\\end{aligned}\n$$\n\nFrom the RREF matrix above, we see that the pivot columns are the $1$st and $2$nd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$\nAlso, the matrix tells us that ${x}_{1}=-2$ and ${x}_{2}=-4,$ meaning that\n\n$$\n(-2)\\cdot {{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{{a}_{1}}+(-4)\\cdot {{[\\begin{aligned}1 \\\\ 2\\end{aligned}]}_{⏟}}_{{a}_{2}}={{[\\begin{aligned}-6 \\\\ -10\\end{aligned}]}_{⏟}}_{{a}_{3}}.\n$$\n\nTherefore, ${x}_{1}\\cdot {x}_{2}=(-2)\\cdot (-4)=8.$" 13194139533428 17592186045585 true] [17592186345214 1068 #edb/ref 17592186344802 13194139533428 17592186045585 true] [17592186345214 1069 "q-76343" 13194139533428 17592186045585 true] [17592186345214 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345214 1071 "Find the characteristic equation of the matrix $N=[\\begin{aligned}-2 & 3 \\\\ 3 & -1\\end{aligned}].$" 13194139533428 17592186045585 true] [17592186345214 1072 #uuid "3d955282-7504-58a3-b804-21dff055f0dc" 13194139533428 17592186045585 true] [17592186345214 1074 "First, we find the matrix $\\,N-\\lambda I:$\n﻿﻿﻿\n\n$$\nN-\\lambda I=[\\begin{aligned}-2-\\lambda  & 3 \\\\ 3 & -1-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(N-\\lambda I) & =0 \\\\ |\\begin{aligned}-2-\\lambda  & 3 \\\\ 3 & -1-\\lambda \\end{aligned}| & =0 \\\\ (-2-\\lambda )(-1-\\lambda )-3\\cdot 3 & =0 \\\\ 2+2\\lambda +\\lambda +{\\lambda }^{2}-9 & =0 \\\\ {\\lambda }^{2}+3\\lambda -7 & =0.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345215 1068 #edb/ref 17592186344654 13194139533428 17592186045585 true] [17592186345215 1069 "q-76364" 13194139533428 17592186045585 true] [17592186345215 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345215 1071 "Find all real eigenvalues of the matrix\n$N=[\\begin{aligned}-\\sqrt{7} & 6 \\\\ 0 & 0\\end{aligned}].$" 13194139533428 17592186045585 true] [17592186345215 1072 #uuid "2bc82201-7ba0-52f3-ae7d-a7d3c009ab95" 13194139533428 17592186045585 true] [17592186345215 1074 "Let's start by writing the matrix $N-\\lambda I:$\n﻿﻿﻿\n\n$$\nN-\\lambda I=[\\begin{aligned}-\\sqrt{7}-\\lambda  & 6 \\\\ 0 & 0-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(N-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(N-\\lambda I) & =0 \\\\ |\\begin{aligned}-\\sqrt{7}-\\lambda  & 6 \\\\ 0 & -\\lambda \\end{aligned}| & =0 \\\\ (-\\sqrt{7}-\\lambda )(-\\lambda )-0\\cdot 6 & =0 \\\\ \\lambda (\\lambda +\\sqrt{7}) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =0$ and $\\lambda =-\\sqrt{7}.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal." 13194139533428 17592186045585 true] [17592186345216 1068 #edb/ref 17592186344645 13194139533428 17592186045585 true] [17592186345216 1069 "q-76369" 13194139533428 17592186045585 true] [17592186345216 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345216 1071 "Find the radius and center of the circle whose equation is\n${x}^{2}-x+{y}^{2}-4y=-2.$" 13194139533428 17592186045585 true] [17592186345216 1072 #uuid "9155ce6a-a592-5aef-9c65-bf69cca03a69" 13194139533428 17592186045585 true] [17592186345216 1074 "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}-x+{y}^{2}-4y & =-2 \\\\ ({x}^{2}-x)+({y}^{2}-4y) & =-2 \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =-2+{(\\frac{1}{2})}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{9}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & =\\frac{9}{4} \\\\ {(x-\\frac{1}{2})}^{2}+{(y-2)}^{2} & ={(\\frac{3}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{1}{2},2)$ and its radius is $\\frac{3}{2}.$" 13194139533428 17592186045585 true] [17592186345217 1068 #edb/ref 17592186344522 13194139533428 17592186045585 true] [17592186345217 1069 "q-76370" 13194139533428 17592186045585 true] [17592186345217 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345217 1071 "Find the radius and center of the circle whose equation is\n${x}^{2}+3x+{y}^{2}-y=-\\frac{9}{4}.$" 13194139533428 17592186045585 true] [17592186345217 1072 #uuid "385da02b-d681-50b2-a172-67bb1e6a6af1" 13194139533428 17592186045585 true] [17592186345217 1074 "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+3x+{y}^{2}-y & =-\\frac{9}{4} \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =-\\frac{9}{4} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =-\\frac{9}{4}+{(\\frac{3}{2})}^{2}+{(\\frac{1}{2})}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{(\\frac{1}{2})}^{2}) & =\\frac{1}{4}.\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2} \\\\ {(x-(-\\frac{3}{2}))}^{2}+{(y-\\frac{1}{2})}^{2} & ={(\\frac{1}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{1}{2}$" 13194139533428 17592186045585 true] [17592186345218 1068 #edb/ref 17592186344680 13194139533428 17592186045585 true] [17592186345218 1069 "q-76376" 13194139533428 17592186045585 true] [17592186345218 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345218 1071 "Find the first term of an arithmetic series if its $17$th term is $33$ and the sum of the first $30$ terms is $1\\,080.$" 13194139533428 17592186045585 true] [17592186345218 1072 #uuid "63be1e3e-0c7e-532a-83da-c37dcd016580" 13194139533428 17592186045585 true] [17592186345218 1074 "We are given one term of the series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nSubstituting $N=30$ and ${S}_{N}=1\\,080$ into the formula for the sum of an arithmetic series, we have\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{N}{2}(2{a}_{1}+(N-1)d) \\\\ 1\\,080 & =\\frac{30}{2}(2{a}_{1}+(30-1)d) \\\\ 1\\,080 & =15(2{a}_{1}+29d) \\\\ \\frac{1\\,080}{15} & =2{a}_{1}+29d \\\\ 72 & =2{a}_{1}+29d.\\end{aligned}\n$$\n\nAlso, we can write an equation for the $17$th term of the arithmetic series  and substitute in its known value:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\ {a}_{17} & ={a}_{1}+(17-1)d \\\\ 33 & ={a}_{1}+16d\\end{aligned}\n$$\n\nAs a result, we obtain the following system of equations:\n\n$$\n{\\begin{aligned}33={a}_{1}+16d \\\\ 72=2{a}_{1}+29d\\end{aligned}\n$$\n\nTo solve this system, we multiply the first equation by $-2$ and add the result to the second equation:\n\n$$\n\\begin{aligned}-66 & =-2{a}_{1}-32d \\\\ 72 & =2{a}_{1}+29d \\\\ 6 & =-3d \\\\ d & =-2\\end{aligned}\n$$\n\nFinally, substituting $d=-2$ into the first equation, we obtain\n\n$$\n\\begin{aligned}33 & ={a}_{1}+16(-2) \\\\ 33 & ={a}_{1}-32 \\\\ {a}_{1} & =65.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345219 1068 #edb/ref 17592186344575 13194139533428 17592186045585 true] [17592186345219 1069 "q-76377" 13194139533428 17592186045585 true] [17592186345219 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345219 1071 "Which of the following is equivalent to ${\\int }_{C}f(x,y,z)\\,\\text{d}s,$ where $f(x,y,z)=2x-{y}^{2}-{z}^{2}$ and the curve $C$ is parametrized by $r(t)=⟨{t}^{2},\\,t-1,\\,t+1⟩$ for $t\\in [0,3]?$" 13194139533428 17592186045585 true] [17592186345219 1072 #uuid "e477990a-d15e-595b-a078-39c7382f9c05" 13194139533428 17592186045585 true] [17592186345219 1074 "Since $r(t)=⟨{t}^{2},\\,t-1,\\,t+1⟩,$ then along the curve we have $x={t}^{2},$ $y=t-1,$ and $z=t+1.$ \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(t-1)j+\\frac{\\text{d}}{\\text{d}t}(t+1)k \\\\  & =2t\\,i+j+k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(2t)^{2}+{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{4{t}^{2}+2}\\end{aligned}\n$$\n\n  \n\nNow, since $f(x,y,z)=2x-{y}^{2}-{z}^{2}$, we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =2({t}^{2})-(t-1)^{2}-(t+1)^{2} \\\\  & =2{t}^{2}-({t}^{2}-2t+1)-({t}^{2}+2t+1) \\\\  & =2{t}^{2}-{t}^{2}+2t-1-{t}^{2}-2t-1 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y,z)\\,\\text{d}s & ={\\int }_{0}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}(-2)\\cdot \\sqrt{4{t}^{2}+2}\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{3}(-2)\\cdot \\sqrt{2(2{t}^{2}+1)}\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{3}(-2)\\cdot \\sqrt{2}\\cdot \\sqrt{2{t}^{2}+1}\\,\\text{d}t \\\\  & =-2\\sqrt{2}{\\int }_{0}^{3}\\sqrt{2{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345220 1068 #edb/ref 17592186344682 13194139533428 17592186045585 true] [17592186345220 1069 "q-76401" 13194139533428 17592186045585 true] [17592186345220 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345220 1071 "Express $3{cos}^{2}⁡(\\frac{\\pi }{12})-3{sin}^{2}⁡(\\frac{\\pi }{12})$ as a single trigonometric ratio." 13194139533428 17592186045585 true] [17592186345220 1072 #uuid "4796dc75-cdb4-53f9-8768-a4a7b1757c4c" 13194139533428 17592186045585 true] [17592186345220 1074 "Our expression can be factored as follows:\n\n$$\n3({cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12}))\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{6}).\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}3({cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12})) & =3\\operatorname{cos}⁡(\\frac{\\pi }{6}).\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345221 1068 #edb/ref 17592186344621 13194139533428 17592186045585 true] [17592186345221 1069 "q-76409" 13194139533428 17592186045585 true] [17592186345221 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345221 1071 "Find the least common multiple of $10(y+1)$ and $15(y+1).$" 13194139533428 17592186045585 true] [17592186345221 1072 #uuid "a0aeedc6-9345-53e2-9356-b127ab780aee" 13194139533428 17592186045585 true] [17592186345221 1074 "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((y+1),\\,(y+1))=(y+1).\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1),\\,15(y+1))=30\\cdot (y+1)=30(y+1).\n$$" 13194139533428 17592186045585 true] [17592186345222 1068 #edb/ref 17592186344657 13194139533428 17592186045585 true] [17592186345222 1069 "q-76414" 13194139533428 17592186045585 true] [17592186345222 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345222 1071 "Which of the following is equivalent to the integral ${\\int }_{C}y{e}^{x}\\,\\text{d}s,$ where $C$ is the section of the curve $y=5x+2$ for $\\,0\\le x\\le 1?$" 13194139533428 17592186045585 true] [17592186345222 1072 #uuid "0d30373c-bec9-57f2-8b55-adb3bc1e9678" 13194139533428 17592186045585 true] [17592186345222 1074 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=5t+2.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,5t+2⟩,\\,0\\le t\\le 1\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(5t+2)j \\\\  & =i+5\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{5}^{2}} \\\\  & =\\sqrt{26}\\end{aligned}\n$$\n\nNow, since $f(x,y)=y{e}^{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(5t+2){e}^{t}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(5t+2){e}^{t}\\cdot \\sqrt{26}\\cdot \\text{d}t \\\\  & =\\sqrt{26}{\\int }_{0}^{1}(5t+2){e}^{t}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345223 1068 #edb/ref 17592186344828 13194139533428 17592186045585 true] [17592186345223 1069 "q-76431" 13194139533428 17592186045585 true] [17592186345223 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345223 1071 "Evaluate the integral ${\\int }_{C}\\frac{y}{x}\\,\\text{d}s,$ where the curve $C$ is given by $y=\\frac{{x}^{2}}{4},$ $\\,0\\le x\\le 4\\sqrt{6}.$" 13194139533428 17592186045585 true] [17592186345223 1072 #uuid "2497006d-58cf-53a4-9f8c-593f6d881048" 13194139533428 17592186045585 true] [17592186345223 1074 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\frac{{t}^{2}}{4}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,\\frac{{t}^{2}}{4}⟩,\\,0\\le t\\le 4\\sqrt{6}\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{4})j \\\\  & =i+\\frac{t}{2}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{(\\frac{t}{2})}^{2}} \\\\  & =\\sqrt{1+\\frac{{t}^{2}}{4}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{y}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(\\frac{{t}^{2}}{4})}{t}=\\frac{t}{4}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y}{x}\\,\\text{d}s & ={\\int }_{0}^{4\\sqrt{6}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{4\\sqrt{6}}\\frac{t}{4}\\cdot \\sqrt{1+\\frac{{t}^{2}}{4}}\\cdot \\text{d}t \\\\  & =\\frac{1}{4}{\\int }_{0}^{4\\sqrt{6}}t\\sqrt{1+\\frac{{t}^{2}}{4}}\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+\\frac{{t}^{2}}{4}$, $\\text{d}u=\\frac{t}{2}\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}\\frac{1}{4}{\\int }_{0}^{4\\sqrt{6}}t\\sqrt{1+\\frac{{t}^{2}}{4}}\\text{d}t & =\\frac{1}{2}{\\int }_{1}^{25}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{{u}^{3/2}}{3}{|}_{1}^{25} \\\\  & =\\frac{1}{3}({25}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{1}{3}(125-1) \\\\  & =\\frac{124}{3}\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345224 1068 #edb/ref 17592186344519 13194139533428 17592186045585 true] [17592186345224 1069 "q-76433" 13194139533428 17592186045585 true] [17592186345224 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345224 1071 "Evaluate the integral ${\\int }_{C}{y}^{2}\\,\\text{d}s,$ where $C$ is the curve parametrized by $r(t)=2\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j$ for $0\\le t\\le \\frac{\\pi }{4}.$" 13194139533428 17592186045585 true] [17592186345224 1072 #uuid "5649582e-ddb6-5db4-a7c3-699a007eaafe" 13194139533428 17592186045585 true] [17592186345224 1074 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nSince $r(t)=2\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j,$ then along the curve we have $x=2\\operatorname{cos}⁡t$ and $y=2\\operatorname{sin}⁡t.$  \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\n \n\nNow, if $f(x,y)={y}^{2}$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & ={(2\\operatorname{sin}⁡t)}^{2}=4{sin}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}4{sin}^{2}⁡t\\cdot 2\\cdot \\text{d}t \\\\  & =8{\\int }_{0}^{\\pi /4}{sin}^{2}⁡t\\,\\text{d}t \\\\  & =8{\\int }_{0}^{\\pi /4}(\\frac{1-\\operatorname{cos}⁡2t}{2})\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi /4}(1-\\operatorname{cos}⁡2t)\\text{d}t \\\\  & =4{[t-\\frac{\\operatorname{sin}⁡2t}{2}]}_{0}^{\\pi /4} \\\\  & =4[(\\frac{\\pi }{4}-\\frac{1}{2})-0] \\\\  & =\\pi -2.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345225 1068 #edb/ref 17592186344886 13194139533428 17592186045585 true] [17592186345225 1069 "q-76434" 13194139533428 17592186045585 true] [17592186345225 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345225 1071 "Evaluate the line integral of the function $f(x,y)=\\frac{1}{y-x}$ along the curve $C$ parametrized by $r(t)=⟨t,\\,t-4⟩$ for $t\\in [0,4].$" 13194139533428 17592186045585 true] [17592186345225 1072 #uuid "a7a51cb6-cac0-57a7-bccc-fcb3f00d4af4" 13194139533428 17592186045585 true] [17592186345225 1074 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nSince $r(t)=⟨t,\\,t-4⟩,$ then along the curve we have $x=t$ and $y=t-4.$     \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}r(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t-4)j \\\\  & =i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{1}{y-x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{1}{t-(4-t)}=-\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{4}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}-\\frac{1}{4}\\cdot \\sqrt{2}\\,\\cdot \\,\\text{d}t \\\\  & =-\\frac{\\sqrt{2}}{4}{\\int }_{0}^{4}\\text{d}t \\\\  & =-\\frac{\\sqrt{2}}{4}t\\,{|}_{0}^{4} \\\\  & =-\\frac{\\sqrt{2}}{4}\\cdot (4-0) \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345226 1068 #edb/ref 17592186344825 13194139533428 17592186045585 true] [17592186345226 1069 "q-76447" 13194139533428 17592186045585 true] [17592186345226 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345226 1071 "Evaluate the integral ${\\int }_{C}({x}^{3}-2{y}^{3})\\,\\text{d}s,$ where $C$ is the curve parametrized by $r(t)=4{t}^{2}\\,i+3{t}^{2}\\,j$ for $0\\le t\\le 1.$" 13194139533428 17592186045585 true] [17592186345226 1072 #uuid "a6c30ef5-4b00-5501-a5b6-18892cf4af06" 13194139533428 17592186045585 true] [17592186345226 1074 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nSince $r(t)=4{t}^{2}\\,i+3{t}^{2}\\,j,$ then along the curve we have $x=4{t}^{2}$ and $y=3{t}^{2}.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})j \\\\  & =8t\\,i+6t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(8t)^{2}+(6t)^{2}} \\\\  & =\\sqrt{64{t}^{2}+36{t}^{2}} \\\\  & =\\sqrt{100{t}^{2}} \\\\  & =10|t| \\\\  & =10t.\\end{aligned}\n$$\n\nNotice that $|t|=t$ since $t>0$ along the path of $C.$ \n\nNow, if $f(x,y)={x}^{3}-2{y}^{3}$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & ={(4{t}^{2})}^{3}-2{(3{t}^{2})}^{3} \\\\  & ={4}^{3}{t}^{6}-2\\cdot {3}^{3}{t}^{6} \\\\  & =64{t}^{6}-54{t}^{6} \\\\  & =10{t}^{6}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{3}-{y}^{3})\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}10{t}^{6}\\cdot 10t\\cdot \\text{d}t \\\\  & =100{\\int }_{0}^{1}{t}^{7}\\,\\text{d}t \\\\  & =100\\cdot \\frac{{t}^{8}}{8}\\,{|}_{0}^{1} \\\\  & =100[\\frac{{1}^{8}}{8}+\\frac{{0}^{8}}{8}] \\\\  & =100\\cdot \\frac{1}{8} \\\\  & =12.5.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345227 1068 #edb/ref 17592186344728 13194139533428 17592186045585 true] [17592186345227 1069 "q-76457" 13194139533428 17592186045585 true] [17592186345227 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345227 1071 "Find the least common multiple of $10(y+1)^{6}$ and $15(y+1)^{4}.$" 13194139533428 17592186045585 true] [17592186345227 1072 #uuid "6fe6c820-9683-5a7a-b33c-5f323f0359af" 13194139533428 17592186045585 true] [17592186345227 1074 "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nTo find the $\\text{LCM}$ of $(y+1)^{6}$ and $(y+1)^{4},$ we raise $(y+1)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((y+1)^{6},\\,(y+1)^{4})=(y+1)^{6}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1)^{6},\\,15(y+1)^{4})=30\\cdot (y+1)^{6}=30(y+1)^{6}.\n$$" 13194139533428 17592186045585 true] [17592186345228 1068 #edb/ref 17592186344569 13194139533428 17592186045585 true] [17592186345228 1069 "q-76475" 13194139533428 17592186045585 true] [17592186345228 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345228 1071 "Find the least common multiple of the polynomials $20{x}^{7}(y+2),$ $\\,10{x}^{6}(y+2)^{3},$ and $12{x}^{4}(y+2)^{2}.$" 13194139533428 17592186045585 true] [17592186345228 1072 #uuid "288f9264-3705-5ed8-96fa-98d1f57e896b" 13194139533428 17592186045585 true] [17592186345228 1074 "To find the least common multiple ($\\text{LCM}$) of three polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of each variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(20,10,12):$\n\n- Multiples of $20:$ $\\,20,\\,40,\\,60,\\,80,\\,100,\\,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,\\,50,\\,60,\\,70,\\,…$\n\n- Multiples of $12:$ $\\,12,\\,24,\\,36,\\,48,\\,60,\\,72,…$\n\nSo, $\\text{LCM}(20,10,12)=60.$\n\nTo find the $\\text{LCM}$ of ${x}^{7}(y+2),{x}^{6}(y+2)^{3},$ and ${x}^{4}(y+2)^{2},$ we find the largest powers for $x$ and $(y+2)$ that appear in all these expressions:\n\n- For ${x}^{7},\\,{x}^{6},$ and ${x}^{4},$ the largest power is $7.$\n\n- For $(y+2),(y+2)^{3},$ and $(y+2)^{2},$ the largest power is $3.$\n\nNow, we raise $x$ and $(y+2)$ to the corresponding largest powers. Therefore,\n\n$$\n\\text{LCM}({x}^{7}(y+2),\\,{x}^{6}(y+2)^{3},\\,{x}^{4}(y+2)^{2})={x}^{7}\\cdot (y+2)^{3}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\begin{aligned}\\text{LCM}(20{x}^{7}(y+2),\\,10{x}^{6}(y+2)^{3},\\,12{x}^{4}(y+2)^{2}) & = \\\\ 60\\cdot {x}^{7}\\cdot (y+2)^{3} & = \\\\ 60{x}^{7}(y+2)^{3} & .\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345229 1068 #edb/ref 17592186344844 13194139533428 17592186045585 true] [17592186345229 1069 "q-76479" 13194139533428 17592186045585 true] [17592186345229 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345229 1071 "Evaluate the line integral of the function $f(x,y)=\\operatorname{cos}⁡x$  along the curve $C$ parametrized by $r(t)={t}^{2}\\,i-{t}^{2}\\,j$ for $0<t<\\sqrt{\\pi /2}.$" 13194139533428 17592186045585 true] [17592186345229 1072 #uuid "5d73cf87-1a19-5cca-88b7-764818d04cb6" 13194139533428 17592186045585 true] [17592186345229 1074 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nSince $r(t)={t}^{2}\\,i-{t}^{2}\\,j,$ then along the curve we have $x={t}^{2}$ and $y=-{t}^{2}.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(-{t}^{2})\\,j \\\\  & =2t\\,j-2t\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(2t)^{2}+(-2t)^{2}} \\\\  & =\\sqrt{8{t}^{2}} \\\\  & =2\\sqrt{2}|t| \\\\  & =2\\sqrt{2}t\\end{aligned}\n$$\n\nNotice that $|t|=t$ because $t>0$ along the path of $C.$\n\nNow, since $f(x,y)=\\operatorname{cos}⁡x$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\operatorname{cos}⁡{t}^{2}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{\\sqrt{\\pi /2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{\\pi /2}}\\operatorname{cos}⁡{t}^{2}\\cdot 2\\sqrt{2}\\,t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u={t}^{2}$, $\\text{d}u=2t\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{\\pi /2}}\\operatorname{cos}⁡{t}^{2}\\cdot 2\\sqrt{2}\\,t\\,\\text{d}t & =\\sqrt{2}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡u\\,\\,\\text{d}u \\\\  & =\\sqrt{2}\\,\\operatorname{sin}⁡u\\,{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{2}(1-0) \\\\  & =\\sqrt{2}\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345230 1068 #edb/ref 17592186344882 13194139533428 17592186045585 true] [17592186345230 1069 "q-76480" 13194139533428 17592186045585 true] [17592186345230 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345230 1071 "Evaluate the integral ${\\int }_{C}\\frac{4{y}^{2}}{{x}^{3}}\\,\\text{d}s,$ where the curve $C$ is given by $y=\\frac{1}{x},$ $\\,1\\le x\\le \\sqrt[4]{2}.$" 13194139533428 17592186045585 true] [17592186345230 1072 #uuid "0d9906db-a501-54d2-bbd1-292e69086032" 13194139533428 17592186045585 true] [17592186345230 1074 "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\frac{1}{t}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\,\\frac{1}{t}⟩,\\,1\\le t\\le \\sqrt[4]{2}\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(u) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})j \\\\  & =i-\\frac{1}{{t}^{2}}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{(-\\frac{1}{{t}^{2}})}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{{t}^{4}}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{4{y}^{2}}{{x}^{3}}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4{(\\frac{1}{t})}^{2}}{{t}^{3}}=\\frac{4}{{t}^{5}}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}3{x}^{5}{y}^{2}\\,\\text{d}s & ={\\int }_{1}^{\\sqrt[4]{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{\\sqrt[4]{2}}\\frac{4}{{t}^{5}}\\cdot \\sqrt{1+\\frac{1}{{t}^{4}}}\\cdot \\text{d}t \\\\  & =4{\\int }_{1}^{\\sqrt[4]{2}}\\frac{1}{{t}^{5}}\\,\\sqrt{1+\\frac{1}{{t}^{4}}}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+\\frac{1}{{t}^{4}}$, $\\text{d}u=-\\frac{4}{{t}^{5}}\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}4{\\int }_{1}^{\\sqrt[4]{2}}\\frac{1}{{t}^{5}}\\,\\sqrt{1+\\frac{1}{{t}^{4}}}\\,\\text{d}t & =-{\\int }_{2}^{3/2}{u}^{1/2}\\,\\text{d}u \\\\  & =-\\frac{2}{3}{u}^{3/2}{|}_{2}^{3/2} \\\\  & =-\\frac{2}{3}(\\sqrt{{(\\frac{3}{2})}^{3}}-\\sqrt{{2}^{3}}) \\\\  & =-\\frac{2}{3}(\\frac{3\\sqrt{6}}{4}-2\\sqrt{2}) \\\\  & =\\frac{1}{6}(8\\sqrt{2}-3\\sqrt{6})\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345231 1068 #edb/ref 17592186344633 13194139533428 17592186045585 true] [17592186345231 1069 "q-76484" 13194139533428 17592186045585 true] [17592186345231 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345231 1071 "Evaluate the line integral of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{5},$ along the curve parametrized by $r(t)=⟨4\\operatorname{sin}⁡t,\\,-3\\operatorname{sin}⁡t⟩$ for $t\\in [0,\\frac{\\pi }{2}].$" 13194139533428 17592186045585 true] [17592186345231 1072 #uuid "8ffd2389-f864-5810-9cd3-9a41b1f9dc53" 13194139533428 17592186045585 true] [17592186345231 1074 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nSince $r(t)=⟨4\\operatorname{sin}⁡t,\\,-3\\operatorname{sin}⁡t⟩,$ then along the curve we have $x=4\\operatorname{sin}⁡t$ and $y=-3\\operatorname{sin}⁡t.$   \n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}r(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(-3\\operatorname{sin}⁡t)j \\\\  & =4\\operatorname{cos}⁡t\\,i-3\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(4\\operatorname{cos}⁡t)^{2}+(-3\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{cos}^{2}+9{cos}^{2}⁡t} \\\\  & =\\sqrt{25{cos}^{2}⁡t} \\\\  & =5|\\operatorname{cos}⁡t| \\\\  & =5\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nNotice that $|\\operatorname{cos}⁡t|=\\operatorname{cos}⁡t$ because $\\operatorname{cos}⁡t\\ge 0$ when $t\\in [0,\\frac{\\pi }{2}].$\n\nNow, since $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{5}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{16{sin}^{2}⁡t+9{sin}^{2}⁡t}{5} \\\\  & =\\frac{25{sin}^{2}⁡t}{5} \\\\  & =5{sin}^{2}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}5{sin}^{2}⁡t\\cdot 5\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =25{\\int }_{0}^{\\pi /2}{sin}^{2}⁡t\\cdot \\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\n   \n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡t,$ $\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}25{\\int }_{0}^{\\pi /2}{sin}^{2}⁡t\\cdot \\operatorname{cos}⁡t\\,\\text{d}t & =25{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =25\\cdot {\\frac{{u}^{3}}{3}|}_{0}^{1} \\\\  & =25(\\frac{1}{3}-0) \\\\  & =\\frac{25}{3}\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345232 1068 #edb/ref 17592186344934 13194139533428 17592186045585 true] [17592186345232 1069 "q-76488" 13194139533428 17592186045585 true] [17592186345232 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345232 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=-\\frac{2}{\\sqrt{3}}$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533428 17592186045585 true] [17592186345232 1072 #uuid "bc662357-bb5a-5c14-b4f2-075042070ad7" 13194139533428 17592186045585 true] [17592186345232 1074 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{(-\\frac{2}{\\sqrt{3}})}=-\\frac{\\sqrt{3}}{2}.\n$$\n\nWe find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(-\\frac{\\sqrt{3}}{2})={150}^{∘}\n$$\n\nSince ${150}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={150}^{∘}.$\n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/d6/d61c6dbd94be14f2a455791a584a00f19ab7b52452b3acda984c5b278a5e39ed.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{30}^{∘} \\\\  & ={210}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x={150}^{∘},{210}^{∘}.$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=150\\cdot 210=31\\,500.\n$$" 13194139533428 17592186045585 true] [17592186345233 1068 #edb/ref 17592186344718 13194139533428 17592186045585 true] [17592186345233 1069 "q-76490" 13194139533428 17592186045585 true] [17592186345233 1070 #edb/ref 17592186045485 13194139533428 17592186045585 true] [17592186345233 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=6$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" 13194139533428 17592186045585 true] [17592186345233 1072 #uuid "20b45040-332b-5b0d-9817-efef67df2755" 13194139533428 17592186045585 true] [17592186345233 1074 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{6}.\n$$\n\nFirst, we find the principal value of $x$:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{1}{6})=1.403\\,348…≈1.403\\,3.\\end{aligned}\n$$\n\nSince $1.403\\,3$ lies inside the given domain, our first solution is ${x}_{1}=1.403\\,3.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=1.403\\,3.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=1.403\\,3.$\n\n![](images/9b/9b3d60be42ec916f0e62f3a86cb1ce2aa628482c97f68f0df7c6ab533b919102.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -1.403\\,3 \\\\  & ≈4.879\\,9\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈1.403\\,3\\,\\cdot 4.879\\,9≈6.8\n$$\n\nrounded to one decimal place." 13194139533428 17592186045585 true] [17592186345234 1068 #edb/ref 17592186344835 13194139533428 17592186045585 true] [17592186345234 1069 "q-76496" 13194139533428 17592186045585 true] [17592186345234 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345234 1071 "Evaluate the line integral ${\\int }_{C}\\frac{y+z}{x}\\,\\text{d}s,$ where the curve $C$ is parametrized by $r(t)=t\\,i+\\frac{{t}^{2}}{2}\\,j+\\frac{{t}^{2}}{2}\\,k$\nfor $1<t<\\sqrt{2}.$" 13194139533428 17592186045585 true] [17592186345234 1072 #uuid "004b67de-a618-52fc-b8e0-1a45d41d2be5" 13194139533428 17592186045585 true] [17592186345234 1074 "To calculate the line integral, we will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{a}^{b}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t.\n$$\n\n \n\nSince $r(t)=t\\,i+\\frac{{t}^{2}}{2}\\,j+\\frac{{t}^{2}}{2}\\,k,$ then along the curve we have $x=t,$ $y=\\frac{{t}^{2}}{2},$ and $z=\\frac{{t}^{2}}{2}.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{2})\\,k \\\\  & =i+t\\,j+t\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{t}^{2}+{t}^{2}} \\\\  & =\\sqrt{1+2{t}^{2}}\\end{aligned}\n$$\n\nNow, if $f(x,y)=\\frac{y+z}{x}$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{\\frac{{t}^{2}}{2}+\\frac{{t}^{2}}{2}}{t}=t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y+z}{x}\\,\\text{d}s & ={\\int }_{1}^{\\sqrt{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{\\sqrt{2}}t\\sqrt{1+2{t}^{2}}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+2{t}^{2}$, $\\text{d}u=4t\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}{\\int }_{1}^{\\sqrt{2}}t\\sqrt{1+2{t}^{2}}\\,\\text{d}t & ={\\int }_{3}^{5}\\sqrt{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{3}^{5}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{2}{3}{u}^{3/2}\\,{|}_{3}^{5} \\\\  & =\\frac{1}{6}({5}^{3/2}-{3}^{3/2}) \\\\  & =\\frac{5\\sqrt{5}-3\\sqrt{3}}{6}\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345235 1068 #edb/ref 17592186344574 13194139533428 17592186045585 true] [17592186345235 1069 "q-76499" 13194139533428 17592186045585 true] [17592186345235 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345235 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=-\\frac{2}{\\sqrt{3}}$ for $-2\\pi <x<0,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533428 17592186045585 true] [17592186345235 1072 #uuid "d978c8fd-7c4e-51e3-a8f6-ce9bb51f0bbe" 13194139533428 17592186045585 true] [17592186345235 1074 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=-\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(-\\frac{\\sqrt{3}}{2})=\\frac{5\\pi }{6}\n$$\n\nNote that $x=\\frac{5\\pi }{6}$ is not in the domain $-2\\pi <x<0.$ To get the first solution within the required domain, we subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{1} & =\\frac{5\\pi }{6}-2\\pi =-\\frac{7\\pi }{6}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/af/afb20de50d2fa92c6550d1e5357b2aaf07311177e3ed82e1a15facccf2c0f0db.png)\n\nA second solution $X$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nHowever, this value does not lie in the required domain. To get the solution that's within the given domain, we subtract $2\\pi :$\n\n$$\n\\begin{aligned}{x}_{2} & =\\frac{7\\pi }{6}-2\\pi =-\\frac{5\\pi }{6}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-\\frac{7\\pi }{6},-\\frac{5\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}=-\\frac{7\\pi }{6}\\cdot (-\\frac{5\\pi }{6})=\\frac{35{\\pi }^{2}}{36}.\n$$" 13194139533428 17592186045585 true] [17592186345236 1068 #edb/ref 17592186344944 13194139533428 17592186045585 true] [17592186345236 1069 "q-76564" 13194139533428 17592186045585 true] [17592186345236 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345236 1071 "Evaluate the integral of the function $f(x,y)=xy$ along the line segment from $(1,2)$ to $(4,7).$" 13194139533428 17592186045585 true] [17592186345236 1072 #uuid "1bfd19a9-a685-5ea5-8c9a-dcf991921379" 13194139533428 17592186045585 true] [17592186345236 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{t}_{a}}^{{t}_{b}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(1,2)$ to $(4,7).$\n\nThe position vectors of the endpoints of our line segment are $a=i+2\\,j$ and $b=4\\,i+7j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(i+2\\,j)+t[4\\,i+7j-(i+2\\,j)] \\\\  & =(i+2\\,j)+t(3i+5j) \\\\  & =(1+3t)\\,i+(2+5t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=1+3t$ and $y=2+5t$ along the segment.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1+3t)i+\\frac{\\text{d}}{\\text{d}t}(2+5t)j \\\\  & =3i+5j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{3}^{2}+{5}^{2}} \\\\  & =\\sqrt{34}\\end{aligned}\n$$\n\nNow, since $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(1+3t)(2+5t) \\\\  & =15{t}^{2}+11t+2.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(15{t}^{2}+11t+2)\\cdot \\sqrt{34}\\cdot \\text{d}t \\\\  & =\\sqrt{34}{\\int }_{0}^{1}(15{t}^{2}+11t+2)\\,\\text{d}t \\\\  & =\\sqrt{34}{[5{t}^{3}+\\frac{11}{2}{t}^{2}+2t]}_{0}^{1} \\\\  & =\\sqrt{34}(5+\\frac{11}{2}+2)-0 \\\\  & =\\frac{25\\sqrt{34}}{2}.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345237 1068 #edb/ref 17592186344685 13194139533428 17592186045585 true] [17592186345237 1069 "q-76569" 13194139533428 17592186045585 true] [17592186345237 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345237 1071 "Evaluate the integral ${\\int }_{C}x{y}^{2}\\,\\text{d}s$ along the line segment from $(1,2,0)$ to $(2,1,3).$" 13194139533428 17592186045585 true] [17592186345237 1072 #uuid "27ad0c20-f0d9-5a56-ac84-89e9373c74a6" 13194139533428 17592186045585 true] [17592186345237 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y,z)\\,\\text{d}s={\\int }_{{t}_{a}}^{{t}_{b}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from$(1,2,0)$ to $(2,1,3).$\n\nThe position vectors of the endpoints of our line segment are $a=i+2\\,j$ and $b=2\\,i+j+3\\,k.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(i+2\\,j)+t[(2\\,i+j+3\\,k)-(i+2\\,j)] \\\\  & =(i+2\\,j)+t(i-j+3\\,k) \\\\  & =(1+t)\\,i+(2-t)\\,j+3t\\,k\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=1+t,$ $y=2-t,$ and $z=3t$ along the segment.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1+t)i+\\frac{\\text{d}}{\\text{d}t}(2-t)j+\\frac{\\text{d}}{\\text{d}t}(3t)k \\\\  & =i-j+3\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-1)^{2}+{3}^{2}} \\\\  & =\\sqrt{11}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(1+t)(2-t)^{2} \\\\  & ={t}^{3}-3{t}^{2}+4.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{3}-3{t}^{2}+4)\\cdot \\sqrt{11}\\,\\text{d}t \\\\  & =\\sqrt{11}{\\int }_{0}^{1}({t}^{3}-3{t}^{2}+4)\\,\\text{d}t \\\\  & =\\sqrt{11}{[\\frac{{t}^{4}}{4}-{t}^{3}+4t]}_{0}^{1} \\\\  & =\\sqrt{11}(\\frac{1}{4}-1+4)-0 \\\\  & =\\frac{13\\sqrt{11}}{4}.\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345238 1068 #edb/ref 17592186344946 13194139533428 17592186045585 true] [17592186345238 1069 "q-76577" 13194139533428 17592186045585 true] [17592186345238 1070 #edb/ref 17592186045486 13194139533428 17592186045585 true] [17592186345238 1071 "Evaluate the integral ${\\int }_{C}\\operatorname{cos}⁡(\\frac{\\pi }{4}(x+z))\\,\\text{d}s$ along the line segment from $(-1,2,1)$ to $(1,2,5).$" 13194139533428 17592186045585 true] [17592186345238 1072 #uuid "07d5db28-c47d-5f6c-be75-b0e883a1921b" 13194139533428 17592186045585 true] [17592186345238 1074 "We will use the formula\n\n$$\n{\\int }_{C}f(x,y,z)\\,\\text{d}s={\\int }_{{t}_{a}}^{{t}_{b}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(-1,2,1)$ to $(1,2,5).$ \n\nThe position vectors of the endpoints of our line segment are $a=-i+2\\,j+k$ and $b=i+2\\,j+5\\,k.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(-i+2\\,j+k)+t[(i+2\\,j+5\\,k)-(-i+2\\,j+k)] \\\\  & =(-i+2\\,j+k)+t(2\\,i+4\\,k) \\\\  & =(-1+2t)\\,i+2\\,j+(1+4t)\\,k\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=-1+2t,$ $y=2,$ and $z=1+4t$ along the segment.\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-1+2t)i+\\frac{\\text{d}}{\\text{d}t}(2)j+\\frac{\\text{d}}{\\text{d}t}(1+4t)k \\\\  & =2\\,i+0+4\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{2}^{2}+{0}^{2}+{4}^{2}} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y,z)=\\operatorname{cos}⁡(\\frac{\\pi }{4}(x+z))$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\operatorname{cos}⁡(\\frac{\\pi }{4}((-1+2t)+(1+4t))) \\\\  & =\\operatorname{cos}⁡(\\frac{3\\pi t}{2}).\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{cos}⁡(\\frac{\\pi }{4}(x+z))\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\operatorname{cos}⁡(\\frac{3\\pi t}{2})\\cdot 2\\sqrt{5}\\cdot \\text{d}t \\\\  & =2\\sqrt{5}{\\int }_{0}^{1}\\operatorname{cos}⁡(\\frac{3\\pi t}{2})\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\frac{3\\pi t}{2}$, $\\text{d}u=\\frac{3\\pi }{2}\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}2\\sqrt{5}{\\int }_{0}^{1}\\operatorname{cos}⁡(\\frac{3\\pi t}{2})\\,\\text{d}t & =\\frac{4\\sqrt{5}}{3\\pi }{\\int }_{0}^{3\\pi /2}\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{4\\sqrt{5}}{3\\pi }\\operatorname{sin}⁡u\\,{|}_{0}^{3\\pi /2} \\\\  & =\\frac{4\\sqrt{5}}{3\\pi }(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{4\\sqrt{5}}{3\\pi }(-1-0) \\\\  & =-\\frac{4\\sqrt{5}}{3\\pi }\\end{aligned}\n$$" 13194139533428 17592186045585 true] [17592186345239 1068 #edb/ref 17592186344848 13194139533428 17592186045585 true] [17592186345239 1069 "q-76597" 13194139533428 17592186045585 true] [17592186345239 1070 #edb/ref 17592186045487 13194139533428 17592186045585 true] [17592186345239 1071 "If $\\,u(t)=[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find