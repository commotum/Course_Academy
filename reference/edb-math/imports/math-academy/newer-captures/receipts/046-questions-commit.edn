 0 & 1 & 0 & 0 \\\\ 0 & 1 & 0 & 0 & \\frac{1}{3} & 0 \\\\ 0 & 0 & 1 & 5 & -\\frac{2}{3} & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{3}:={R}_{3}+5{R}_{1},\\,{R}_{2}:=\\frac{1}{3}{R}_{2}.\n$$\n\nThe matrix ${F}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{F}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{1}{3} & 0 \\\\ 5 & -\\frac{2}{3} & 1\\end{aligned}].\n$$" 13194139533429 17592186045585 true] [17592186348118 1068 #edb/ref 17592186347922 13194139533429 17592186045585 true] [17592186348118 1069 "q-78807" 13194139533429 17592186045585 true] [17592186348118 1070 #edb/ref 17592186045486 13194139533429 17592186045585 true] [17592186348118 1071 "The inverse of the matrix $C$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[C\\,|\\,I] & =[\\begin{aligned}3 & 0 & 0 & 1 & 0 & 0 \\\\ 4 & 1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & \\frac{1}{3} & 0 & 0 \\\\ 4 & 1 & 2 & 0 & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & \\frac{1}{3} & 0 & 0 \\\\ 0 & 1 & 2 & -\\frac{4}{3} & 1 & 0 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & \\frac{1}{3} & 0 & 0 \\\\ 0 & 1 & 0 & -\\frac{4}{3} & 1 & -2 \\\\ 0 & 0 & 1 & 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$" 13194139533429 17592186045585 true] [17592186348118 1072 #uuid "3ddf3732-c832-53cb-9988-da798b4f3949" 13194139533429 17592186045585 true] [17592186348118 1074 "We write down $C$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $C$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[C