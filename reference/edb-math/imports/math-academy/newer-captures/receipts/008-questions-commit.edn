}\\right)^2}\\,\\textrm d t\n$$\n\nTherefore, we will use\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} y \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t\n$$\n\nWe are told that the limits of integration are from $t_1=0$ to $t_2=\\pi$.\n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\n\\frac{dx}{dt} &= \\frac{d}{dt}(t - \\sin t) = 1 - \\cos t \\\\\n\\frac{dy}{dt} &= \\frac{d}{dt}(1 - \\cos t) = \\sin t\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nS &= 2π\\int_{t_{1}}^{t_{2}}y\\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}}dt \\\\\n&= 2π\\int_{0}^{π}(1 - \\cos t)\\sqrt{(1 - \\cos t)^{2} + (\\sin t)^{2}}dt \\\\\n&= 2π\\int_{0}^{π}(1 - \\cos t)\\sqrt{1 - 2\\cos t + \\cos^{2} t + \\sin^{2} t}dt\n\\end{aligned}\n$$\n\nNow, using the identity\n\n$$\n\\sin^2 t +\\cos^2 t= 1\n$$\n\nwe can rewrite our integral as follows:\n\n$$\n\\begin{aligned}\nS &= 2π\\int_{0}^{π}(1 - \\cos t)\\sqrt{1 - 2\\cos t + (\\sin^{2} t + \\cos^{2} t)}dt \\\\\n&= 2π\\int_{0}^{π}(1 - \\cos t)\\sqrt{1 - 2\\cos t + 1}dt \\\\\n&= 2π\\int_{0}^{π}(1 - \\cos t)\\sqrt{2 - 2\\cos t}dt \\\\\n&= 2π\\int_{0}^{π}(1 - \\cos t)\\sqrt{2(1 - \\cos t)}dt \\\\\n&= 2π\\int_{0}^{π}(1 - \\cos t) \\cdot \\sqrt{2} \\cdot \\sqrt{1 - \\cos t}dt \\\\\n&= 2\\sqrt{2}π\\int_{0}^{π}\\sqrt{(1 - \\cos t)^{3}}dt\n\\end{aligned}\n$$" 13194139533391 17592186045585 false] [17592186129079 1074 "We can find the surface area generated when a curve is rotated $2\\pi$ radians about the $x$-axis using the formula\n\n$$\nS = \\int 2\\pi y\\,\\textrm d s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\textrm d s = \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t.\n$$\n\nTherefore, we will use\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} y \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t.\n$$\n\nWe are told that the limits of integration are from $t_1=0$ to $t_2=\\pi.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡t)=1-\\operatorname{cos}⁡t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-\\operatorname{cos}⁡t)=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\sqrt{{(1-\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\sqrt{1-2\\operatorname{cos}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, using the identity $\\sin^2 t +\\cos^2 t= 1,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\sqrt{1-2\\operatorname{cos}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\sqrt{1-2\\operatorname{cos}⁡t+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\sqrt{2-2\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\sqrt{2(1-\\operatorname{cos}⁡t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡t)\\cdot \\sqrt{2}\\cdot \\sqrt{1-\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & =2\\sqrt{2}\\pi {\\int }_{0}^{\\pi }\\sqrt{(1-\\operatorname{cos}⁡t)^{3}}\\,\\text{d}t\\end{aligned}\n$$" 13194139533391 17592186045585 true] [17592186129080 1071 "Consider the curve defined parametrically as\n$x = \\sin t, \\quad y = e^t, \\quad t\\in \\left[0,1\\right]$.\nWhat integral gives the surface area generated when this curve is rotated $2\\pi$ radians about the $y$-axis?" 13194139533391 17592186045585 false] [17592186129080 1071 "Consider the curve defined parametrically as \n\n$$\nx = \\sin t, \\quad y = e^t, \\quad t\\in \\left[0,1\\right].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi$ radians about the $y$-axis?" 13194139533391 17592186045585 true] [17592186129080 1074 "We can find the surface area generated when a curve is rotated $2\\pi$ radians about the $y$-axis using the formula\n\n$$\nS = \\int 2\\pi x\\,\\textrm d s\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\textrm d s = \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t\n$$\n\nTherefore, we will use\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} x \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t\n$$\n\nWe are told that the limits of integration are from $t_1=0$ to $t_2=1$.\n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\n\\frac{dx}{dt} &= \\frac{d}{dt}(\\sin t) = \\cos t \\\\\n\\frac{dy}{dt} &= \\frac{d}{dt}(e^{t}) = e^{t}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nS &= 2π\\int_{t_{1}}^{t_{2}}x\\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}}dt \\\\\n&= 2π\\int_{0}^{1}\\sin t\\sqrt{(\\cos t)^{2} + (e^{t})^{2}}dt \\\\\n&= 2π\\int_{0}^{1}\\sin t\\sqrt{\\cos^{2} t + e^{2t}}dt\n\\end{aligned}\n$$" 13194139533391 17592186045585 false] [17592186129080 1074 "We can find the surface area generated when a curve is rotated $2\\pi$ radians about the $y$-axis using the formula\n\n$$\nS = \\int 2\\pi x\\,\\textrm d s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\textrm d s = \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t.\n$$\n\nTherefore, we will use\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} x \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t.\n$$\n\nWe are told that the limits of integration are from $t_1=0$ to $t_2=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}\\operatorname{sin}⁡t\\sqrt{{(\\operatorname{cos}⁡t)}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}\\operatorname{sin}⁡t\\sqrt{{cos}^{2}⁡t+{e}^{2t}}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533391 17592186045585 true] [17592186129081 1071 "Consider the curve defined parametrically as\n$x = 1+3t, \\quad y = 2t^{3/2}, \\quad t\\in \\left[0,1\\right]$.\nCalculate the surface area generated when this curve is rotated $2\\pi$ radians about the $y$-axis." 13194139533391 17592186045585 false] [17592186129081 1071 "Consider the curve defined parametrically as \n\n$$\nx = 1+3t, \\quad y = 2t^{3/2}, \\quad t\\in \\left[0,1\\right].\n$$\n\nCalculate the surface area generated when this curve is rotated $2\\pi$ radians about the $y$-axis." 13194139533391 17592186045585 true] [17592186129081 1074 "We can find the surface area generated when a curve is rotated $2\\pi$ radians about the $y$-axis using the formula\n\n$$\nS = \\int 2\\pi x\\,\\textrm d s\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\textrm d s = \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t\n$$\n\nTherefore, we will use\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} x \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t\n$$\n\nWe are told that the limits of integration are from $t_1=0$ to $t_2=1$.\n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\n\\frac{dx}{dt} &= \\frac{d}{dt}(1 + 3t) = 3 \\\\\n\\frac{dy}{dt} &= \\frac{d}{dt}(2t^{3/2}) = 3t^{1/2}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nS &= 2π\\int_{t_{1}}^{t_{2}}x\\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}}dt \\\\\n&= 2π\\int_{0}^{1}(1 + 3t)\\sqrt{(3)^{2} + (3t^{1/2})^{2}}dt \\\\\n&= 2π\\int_{0}^{1}(1 + 3t)\\sqrt{9 + 9t}dt \\\\\n&= 2π\\int_{0}^{1}(1 + 3t)\\sqrt{9(1 + t)}dt \\\\\n&= 2π\\int_{0}^{1}(1 + 3t) \\cdot 3\\sqrt{1 + t}dt \\\\\n&= 6π\\int_{0}^{1}(1 + 3t)\\sqrt{1 + t}dt\n\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution\n\n$$\nu = 1+t\n$$\n\nThen,\n\n$$\n1+3t=3u-2\n$$\n\nand\n\n$$\n\\textrm{d}u = \\textrm d t\n$$\n\nWe also need to compute new limits, given below.\n\n| **$t$** | $0$ | $1$ |\n| --- | ---: | ---: |\n| $u$ | $1$ | $2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}\nS &= 6π\\int_{0}^{1}(1 + 3t)\\sqrt{1 + t}dt \\\\\n&= 6π\\int_{1}^{2}(3u - 2)\\sqrt{u}du \\\\\n&= 6π\\int_{1}^{2}(3u^{3/2} - 2u^{1/2})du \\\\\n&= 6π \\cdot [\\frac{6u^{5/2}}{5} - \\frac{4u^{3/2}}{3}]_{1}^{2} \\\\\n&= 6π[((6(2^{5/2}))/(5) - (4(2^{3/2}))/(3)) - (\\frac{6}{5} - \\frac{4}{3})] \\\\\n&= 6π[(\\frac{24\\sqrt{2}}{5} - \\frac{8\\sqrt{2}}{3}) - (\\frac{6}{5} - \\frac{4}{3})] \\\\\n&= 6π[\\frac{32\\sqrt{2}}{15} + \\frac{2}{15}] \\\\\n&= \\frac{4π}{5}(16\\sqrt{2} + 1)\n\\end{aligned}\n$$" 13194139533391 17592186045585 false] [17592186129081 1074 "We can find the surface area generated when a curve is rotated $2\\pi$ radians about the $y$-axis using the formula\n\n$$\nS = \\int 2\\pi x\\,\\textrm d s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\textrm d s = \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t.\n$$\n\nTherefore, we will use\n\n$$\nS = 2\\pi \\int_{t_1}^{t_2} x \\sqrt{\\left(\\dfrac{\\textrm d x}{\\textrm d t}\\right)^2+\\left(\\dfrac{\\textrm d y}{\\textrm d t}\\right)^2}\\,\\textrm d t.\n$$\n\nWe are told that the limits of integration are from $t_1=0$ to $t_2=1.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1+3t)=3 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3/2})=3{t}^{1/2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}x\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(1+3t)\\sqrt{{(3)}^{2}+{(3{t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(1+3t)\\sqrt{9+9t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(1+3t)\\sqrt{9(1+t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}(1+3t)\\cdot 3\\sqrt{1+t}\\,\\text{d}t \\\\  & =6\\pi {\\int }_{0}^{1}(1+3t)\\sqrt{1+t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u = 1+t.$ Then, $1+3t=3u-2$ and $\\textrm{d}u = \\textrm d t.$ We also need to compute new limits, given below.\n\n| **$t$** | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =6\\pi {\\int }_{0}^{1}(1+3t)\\sqrt{1+t}\\,\\text{d}t \\\\  & =6\\pi {\\int }_{1}^{2}(3u-2)\\sqrt{u}\\,\\text{d}u \\\\  & =6\\pi {\\int }_{1}^{2}(3{u}^{3/2}-2{u}^{1/2})\\,\\text{d}u \\\\  & =6\\pi \\cdot {[\\frac{6{u}^{5/2}}{5}-\\frac{4{u}^{3/2}}{3}]}_{1}^{2} \\\\  & =6\\pi [(\\frac{6({2}^{5/2})}{5}-\\frac{4({2}^{3/2})}{3})-(\\frac{6}{5}-\\frac{4}{3})] \\\\  & =6\\pi [(\\frac{24\\sqrt{2}}{5}-\\frac{8\\sqrt{2}}{3})-(\\frac{6}{5}-\\frac{4}{3})] \\\\  & =6\\pi [\\frac{32\\sqrt{2}}{15}+\\frac{2}{15}] \\\\  & =\\frac{4\\pi }{5}(16\\sqrt{2}+1).\\end{aligned}\n$$" 13194139533391 17592186045585 true] [17592186129084 1071 "![](images/26/2683c694582a7c2dbe1c95cce6af22ef941a1e77b54721151a935e81ec2b3b1a.png)\n\nA part of the graph of a polynomial $p(x)$ is given above. Which of the following statements is true?\n\n- $x=-4$ is a multiple root of odd multiplicity\n\n- $x=-4$ is a multiple root of even multiplicity\n\n- $x=-4$ is a simple root" 13194139533391 17592186045585 true] [17592186129084 1071 "![](images/26/2683c694582a7c2dbe1c95cce6af22ef941a1e77b54721151a935e81ec2b3b1a.png)\n\nA part of the graph of a polynomial $p(x)$ is given above. Which of the following statements is true?\n\n- $x=-4$ is a multiple root of odd multiplicity\n- $x=-4$ is a multiple root of even multiplicity\n- $x=-4$ is a simple root" 13194139533391 17592186045585 false] [17592186129084 1074 "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *tangent* to the $x$-axis at $x=-4.$ So, $x=-4$ is a *multiple* root. \n\nFurthermore, the graph touches the $x$-axis and reverses direction at $x=-4.$ So, $x=-4$ has *even* multiplicity.\n\nTherefore, $x=-4$ is a multiple root of even multiplicity." 13194139533391 17592186045585 true] [17592186129084 1074 "| Multiplicity | Sketch | Sketch |\n| --- | ---: | ---: |\n| $1$<br><br>(Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$<br><br>(Multiple Root)<br><br>Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$<br><br>(Multiple Root)<br><br>Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a$, we have a *simple* root $x=a$.\n- If the graph is *tangent* to the $x$-axis at $x=a$, we have a *multiple* root $x=a$. Furthermore:If the graph touches the $x$-axis and reverses direction at $x=a$, the multiplicity of a root $x=a$ is *even*. If the graph crosses the $x$-axis at $x=a$, the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *tangent* to the $x$-axis at $x=-4$. So, $x=-4$ is a *multiple* root.\n\nFurthermore, the graph touches the $x$-axis and reverses direction at $x=-4$. So, $x=-4$ has *even* multiplicity.\n\nTherefore, $x=-4$ is a multiple root of even multiplicity." 13194139533391 17592186045585 false] [17592186129130 1038 #edb/ref 17592186238058 13194139533391 17592186045585 true] [17592186129164 1038 #edb/ref 17592186237946 13194139533391 17592186045585 true] [17592186129164 1038 #edb/ref 17592186237947 13194139533391 17592186045585 true] [17592186129165 1038