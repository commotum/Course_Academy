\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-4\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{16{sin}^{2}⁡t+{cos}^{2}⁡t} \\\\  & =\\sqrt{15{sin}^{2}⁡t+({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{15{sin}^{2}⁡t+1}\\end{aligned}\n$$\n\nNow, since $f(x,y) = \\dfrac{x}{y},$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{4\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}=4\\operatorname{cot}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{x}{y}\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\operatorname{cot}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cot}⁡t\\sqrt{15{sin}^{2}⁡t+1}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186179584 1074 "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s = \\int\\limits_a^b f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t\n$$\n\nNote that we can write the equation of our ellipse in the form\n\n$$\n\\dfrac{x^2}{4^2} + \\dfrac{y^2}{1^2} = 1\n$$\n\nSo, the curve $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $4$ and $1$, respectively. Therefore, it can be parametrized as\n\n$$\n\\mathbf{r}(t) = \\left\\langle 4\\cos{t}, \\: \\sin{t} \\right\\rangle, \\qquad 0 \\le t \\lt 2\\pi\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|$, we get following:\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j \\\\\n&= \\frac{d}{dt}(4\\cos t)i + \\frac{d}{dt}(\\sin t)j \\\\\n&=-4\\sin ti + \\cos tj \\\\\n‖r^{′}(t)‖ &= \\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}} \\\\\n&= \\sqrt{(-4\\sin t)^{2} + (\\cos t)^{2}} \\\\\n&= \\sqrt{16\\sin^{2} t + \\cos^{2} t} \\\\\n&= \\sqrt{15\\sin^{2} t + (\\sin^{2} t + \\cos^{2} t)} \\\\\n&= \\sqrt{15\\sin^{2} t + 1}\n\\end{aligned}\n$$\n\nNow, since\n\n$$\nf(x,y) = \\dfrac{x}{y}\n$$\n\nwe obtain\n\n$$\n\\begin{aligned}\nf(r(t)) &= \\frac{4\\cos t}{\\sin t} = 4\\cot t\n\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\n\\int_(C)\\frac{x}{y}ds &= \\int_{0}^{2π}f(r(t))‖r^{′}(t)‖dt \\\\\n&= \\int_{0}^{2π}4\\cot t\\sqrt{15\\sin^{2} t + 1}dt \\\\\n&= 4\\int_{0}^{2π}\\cot t\\sqrt{15\\sin^{2} t + 1}dt\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186179585 1071 "Evaluate the line integral of the function $f(x,y) =x^2-2$ along the circle $C$ with equation $x^2 + y^2 = 4$." 13194139533390 17592186045585 false] [17592186179585 1071 "Evaluate the line integral of the function $f(x,y) =x^2-2$ along the circle $C$ with equation $x^2 + y^2 = 4.$" 13194139533390 17592186045585 true] [17592186179585 1074 "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  = \\int\\limits_a^b  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t.\n$$\n\n \n\nThe curve $C$ is a circle of radius $2$ centered at $O.$ It can be parametrized as \n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad 0 \\le t \\le 2\\pi.\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)j \\\\  & =-2\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-2\\operatorname{sin}⁡t)^{2}+(2\\operatorname{cos}⁡t)^{2}} \\\\  & =\\sqrt{4{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $f(x,y) = x^2-2,$ we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =(2\\operatorname{cos}⁡t)^{2}-2 \\\\  & =4{cos}^{2}⁡t-2 \\\\  & =2(2{cos}^{2}⁡t-1) \\\\  & =2\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }2\\operatorname{cos}⁡2t\\cdot 2\\cdot \\text{d}t \\\\  & =4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t,$ $\\textrm d u=2\\,\\textrm d t$ as follows:\n\n$$\n\\begin{aligned}4{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡2t\\,\\text{d}t & =2{\\int }_{0}^{4\\pi }\\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =2\\operatorname{sin}⁡u{|}_{0}^{4\\pi } \\\\  & =2(0-0) \\\\  & =0\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186179585 1074 "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s = \\int\\limits_a^b f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t\n$$\n\nThe curve $C$ is a circle of radius $2$ centered at $O$. It can be parametrized as\n\n$$\n\\mathbf{r}(t) = \\big\\langle 2\\cos{t}, \\: 2\\sin{t} \\big\\rangle, \\qquad 0 \\le t \\le 2\\pi\n$$\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|$, we get the following:\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j \\\\\n&= \\frac{d}{dt}(2\\cos t)i + \\frac{d}{dt}(2\\sin t)j \\\\\n&=-2\\sin ti + 2\\cos tj \\\\\n‖r^{′}(t)‖ &= \\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}} \\\\\n&= \\sqrt{(-2\\sin t)^{2} + (2\\cos t)^{2}} \\\\\n&= \\sqrt{4\\sin^{2} t + 4\\cos^{2} t} \\\\\n&= \\sqrt{4(\\sin^{2} t + \\cos^{2} t)} \\\\\n&= 2\n\\end{aligned}\n$$\n\nNow, since\n\n$$\nf(x,y) = x^2-2\n$$\n\nwe obtain\n\n$$\n\\begin{aligned}\nf(r(t)) &= (2\\cos t)^{2} - 2 \\\\\n&= 4\\cos^{2} t - 2 \\\\\n&= 2(2\\cos^{2} t - 1) \\\\\n&= 2\\cos 2t\n\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\n\\int_(C)f(x, y)ds &= \\int_{0}^{2π}f(r(t))‖r^{′}(t)‖dt \\\\\n&= \\int_{0}^{2π}2\\cos 2t \\cdot 2 \\cdot dt \\\\\n&= 4\\int_{0}^{2π}\\cos 2tdt\n\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t$,\n\n$$\n\\textrm d u=2\\,\\textrm d t\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n4\\int_{0}^{2π}\\cos 2tdt &= 2\\int_{0}^{4π}\\cos udu \\\\\n&= \\left.2\\sin u\\right|_{0}^{4π} \\\\\n&= 2(0 - 0) \\\\\n&= 0\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186179586 1071 "![](images/d0/d0cebdd804ff244d037e14df6ec33efb86b522644f7b4addc688e27fd6a57e95.png)\n\nEvaluate the line integral\n$\\displaystyle \\int\\limits_{C} y^3e^{-x} \\: \\textrm{d}s$,\nwhere $C$ is the section of the curve $x = \\ln{y}$ from $(0, 1)$ to $\\left(\\dfrac32\\ln 2, 2\\sqrt{2}\\right)$, as shown above." 13194139533390 17592186045585 false] [17592186179586 1071 "![](images/d0/d0cebdd804ff244d037e14df6ec33efb86b522644f7b4addc688e27fd6a57e95.png)\n\nEvaluate the line integral\n$\\displaystyle \\int\\limits_{C} y^3e^{-x} \\: \\textrm{d}s,$\nwhere $C$ is the section of the curve $x = \\ln{y}$ from $(0, 1)$ to $\\left(\\dfrac32\\ln 2 , 2\\sqrt{2}\\right),$ as shown above." 13194139533390 17592186045585 true] [17592186179586 1074 "Notice that the given curve is of the form $x = x(y)$. Therefore, by setting $y=t$, we have\n\n$$\nx = x(t) = \\ln{t}\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t) = \\left\\langle \\ln{t}, \\: t \\right\\rangle, \\qquad 1 \\leq t \\leq 2\\sqrt{2}\n$$\n\nNote that the domain\n\n$$\n1 \\leq t \\leq 2\\sqrt{2}\n$$\n\nis defined by the $y$-coordinates of the endpoints on the path.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|$, we get the following:\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j \\\\\n&= \\frac{d}{dt}(\\ln t)i + \\frac{d}{dt}(t)j \\\\\n&= \\frac{1}{t}i + j \\\\\n‖r^{′}(t)‖ &= \\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}} \\\\\n&= \\sqrt{(\\frac{1}{t})^{2} + 1^{2}} \\\\\n&= \\sqrt{\\frac{1}{t^{2}} + 1} \\\\\n&= \\sqrt{\\frac{t^{2} + 1}{t^{2}}} \\\\\n&= \\frac{\\sqrt{t^{2} + 1}}{\\mid t \\mid} \\\\\n&= \\frac{\\sqrt{t^{2} + 1}}{t}\n\\end{aligned}\n$$\n\nNow, if\n\n$$\nf(x,y) = y^3e^{-x}\n$$\n\nthen we obtain\n\n$$\n\\begin{aligned}\nf(r(t)) &= t^{3}e^{-\\ln t} \\\\\n&= t^{3} \\cdot \\frac{1}{t} \\\\\n&= t^{2}\n\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\n\\int_(C)y^{3}e^{-x}ds &= \\int_{1}^{2\\sqrt{2}}f(r(t))‖r^{′}(t)‖dt \\\\\n&= \\int_{1}^{2\\sqrt{2}}t^{2} \\cdot \\frac{\\sqrt{t^{2} + 1}}{t}dt \\\\\n&= \\int_{1}^{2\\sqrt{2}}t\\sqrt{t^{2} + 1}dt\n\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution\n\n$$\nu = t^2 + 1\n$$\n\n$$\n\\textrm{d}u = 2t \\, \\textrm{d}t\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n\\int_{1}^{2\\sqrt{2}}t\\sqrt{t^{2} + 1}dt &= \\int_{2}^{9}\\sqrt{u} \\cdot \\frac{1}{2}du \\\\\n&= \\frac{1}{2} \\cdot \\left.\\frac{2}{3}\\sqrt{u^{3}}\\right|_{2}^{9} \\\\\n&= \\frac{1}{3}[\\sqrt{9^{3}} - \\sqrt{2^{3}}] \\\\\n&= \\frac{27 - 2\\sqrt{2}}{3}\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186179586 1074 "Notice that the given curve is of the form $x = x(y).$ Therefore, by setting $y=t,$ we have\n\n$$\nx = x(t) = \\ln{t}.\n$$\n\nThis gives the following parametrization of the curve:\n\n$$\n\\mathbf{r}(t) = \\left\\langle \\ln{t}, \\: t \\right\\rangle, \\qquad 1 \\leq t \\leq 2\\sqrt{2}\n$$\n\nNote that the domain $1 \\leq t \\leq 2\\sqrt{2}$ is defined by the $y$-coordinates of the endpoints on the path.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following: \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =\\frac{1}{t}\\,i+j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{(\\frac{1}{t})}^{2}+{1}^{2}} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}+1} \\\\  & =\\sqrt{\\frac{{t}^{2}+1}{{t}^{2}}} \\\\  & =\\frac{\\sqrt{{t}^{2}+1}}{|t|} \\\\  & =\\frac{\\sqrt{{t}^{2}+1}}{t}\\end{aligned}\n$$\n\n \n\nNow, if  $f(x,y) = y^3e^{-x},$ then we obtain \n\n$$\n\\begin{aligned}f(r(t)) & ={t}^{3}{e}^{-\\operatorname{ln}⁡t} \\\\  & ={t}^{3}\\cdot \\frac{1}{t} \\\\  & ={t}^{2}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}{y}^{3}{e}^{-x}\\,\\text{d}s & ={\\int }_{1}^{2\\sqrt{2}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2\\sqrt{2}}{t}^{2}\\cdot \\frac{\\sqrt{{t}^{2}+1}}{t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2\\sqrt{2}}t\\sqrt{{t}^{2}+1}\\,\\text{d}t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u = t^2 + 1,$ $\\textrm{d}u = 2t \\, \\textrm{d}t$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2\\sqrt{2}}t\\sqrt{{t}^{2}+1}\\,\\text{d}t & ={\\int }_{2}^{9}\\sqrt{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\sqrt{{u}^{3}}\\,{|}_{2}^{9} \\\\  & =\\frac{1}{3}[\\sqrt{{9}^{3}}-\\sqrt{{2}^{3}}] \\\\  & =\\frac{27-2\\sqrt{2}}{3}\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186179587 1071 "![](images/f9/f9de4a1c2dfb6b8939b2440930eefb8b7020947bd7b943021214adf4cbfce735.png)\n\n    \n\nWhich of the above diagrams represents the gradient vector field of the function $f(x,y) = 2y^2-x^2?$" 13194139533390 17592186045585 true] [17592186179587 1071 "![](images/f9/f9de4a1c2dfb6b8939b2440930eefb8b7020947bd7b943021214adf4cbfce735.png)\n\nWhich of the above diagrams represents the gradient vector field of the function $f(x,y) = 2y^2-x^2$?" 13194139533390 17592186045585 false] [17592186179587 1074 "The gradient vector field of a function $f$ is given by $\\nabla f$.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\nf_{x}(x, y) &= \\frac{∂}{∂x}(2y^{2} - x^{2}) \\\\\n&=-2x \\\\\nf_{y}(x, y) &= \\frac{∂}{∂y}(2y^{2} - x^{2}) \\\\\n&= 4y\n\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}\n∇f(x, y) &= f_{x}(x, y)i + f_{y}(x, y)j \\\\\n&=-2xi + 4yj\n\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(2,1)$, $(-2,1)$, and $(1,-1)$.\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $\\nabla f$.\n\n$$\n\\begin{aligned}\n∇f(2, 1) &= -2 \\cdot 2i + 4 \\cdot 1j =-4i + 4j \\\\\n∇f(-2, 1) &= -2 \\cdot (-2)i + 4 \\cdot 1j = 4i + 4j \\\\\n∇f(1,-1) &= -2 \\cdot 1i + 4 \\cdot (-1)j =-2i - 4j\n\\end{aligned}\n$$\n\nNow, we draw the vectors at their corresponding points and obtain the following diagram:\n\n![](images/b8/b88c62b154cecaace206248b62f72b8aa1f71662c0427adfbbabd5c2b4738a6b.png)" 13194139533390 17592186045585 false] [17592186179587 1074 "The gradient vector field of a function $f$ is given by $\\nabla f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(2{y}^{2}-{x}^{2}) \\\\  & =-2x \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(2{y}^{2}-{x}^{2}) \\\\  & =4y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =-2x\\,i+4y\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(2,1),$ $(-2,1),$ and $(1,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $\\nabla f.$\n\n$$\n\\begin{aligned}∇f(2,1) & =-2\\cdot 2\\,i+4\\cdot 1\\,j=-4\\,i+4\\,j \\\\ ∇f(-2,1) & =-2\\cdot (-2)\\,i+4\\cdot 1\\,j=4\\,i+4\\,j \\\\ ∇f(1,-1) & =-2\\cdot 1\\,i+4\\cdot (-1)\\,j=-2\\,i-4\\,j\\end{aligned}\n$$\n\nNow, we draw the vectors at their corresponding points and obtain the following diagram:\n\n![](images/b8/b88c62b154cecaace206248b62f72b8aa1f71662c0427adfbbabd5c2b4738a6b.png)" 13194139533390 17592186045585 true] [17592186179588 1071 "Let $P= \\left\\{y_0, y_1, \\ldots, y_n\\right\\}$ be a partition of the interval $[-3, 5]$. If $\\Delta y_j = y_j - y_{j-1}$, calculate $\\displaystyle \\sum_{j=1}^n {3}\\Delta y_j$." 13194139533390 17592186045585 false] [17592186179588 1071 "Let $P= \\left\\{y_0, y_1, \\ldots, y_n\\right\\}$ be a partition of the interval $[-3, 5].$ If $\\Delta y_j = y_j - y_{j-1},$ calculate $\\displaystyle \\sum_{j=1}^n {3}\\Delta y_j.$" 13194139533390 17592186045585 true] [17592186179588 1074 "First, we take the factor $3$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}3Δ{y}_{j}=3{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that $\\displaystyle \\sum_{j=1}^n \\Delta y_j$ is just the length of the interval $[-3, 5],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =Δ{y}_{1}+Δ{y}_{2}+Δ{y}_{3}+⋯+Δ{y}_{n} \\\\  & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =5-(-3) \\\\  & =5+3 \\\\  & =8.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{3}\\sum_{j=1}^n \\Delta y_j = 3 \\cdot 8 = 24.\n$$" 13194139533390 17592186045585 true] [17592186179588 1074 "First, we take the factor $3$ outside the summation:\n\n$$\n∑_(j = 1)^(n)3Δy_{j} = 3∑_(j = 1)^(n)Δy_{j}\n$$\n\nNote that\n\n$$\n\\displaystyle \\sum_{j=1}^n \\Delta y_j\n$$\n\nis just the length of the interval $[-3, 5]$, because\n\n$$\n\\begin{aligned}\n∑_(j = 1)^(n)Δy_{j} &= Δy_{1} + Δy_{2} + Δy_{3} + ⋯ + Δy_{n} \\\\\n&= (y_{1} - y_{0}) + (y_{2} - y_{1}) + (y_{3} - y_{2}) + ⋯ + (y_{n} - y_{n - 1}) \\\\\n&= (y_{1} - y_{0}) + (y_{2} - y_{1}) + (y_{3} - y_{2}) + ⋯ + (y_{n} - y_{n - 1}) \\\\\n&=-y_{0} + y_{n} \\\\\n&= y_{n} - y_{0} \\\\\n&= 5 - (-3) \\\\\n&= 5 + 3 \\\\\n&= 8\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{3}\\sum_{j=1}^n \\Delta y_j = 3 \\cdot 8 = 24\n$$" 13194139533390 17592186045585 false] [17592186179589 1071 "Let $P = \\left\\{x_0, x_1, \\ldots, x_m\\right\\}$ be a partition of the interval $[-3, 4]$. If $\\Delta x_i = x_i - x_{i-1}$, calculate $\\displaystyle\\sum_{i=1}^m (x_i + x_{i-1})\\Delta x_i$." 13194139533390 17592186045585 false] [17592186179589 1071 "Let $P = \\left\\{x_0, x_1, \\ldots, x_m\\right\\}$ be a partition of the interval $[-3, 4].$ If $\\Delta x_i = x_i - x_{i-1},$ calculate $\\displaystyle\\sum_{i=1}^m (x_i + x_{i-1})\\Delta x_i .$" 13194139533390 17592186045585 true] [17592186179589 1074 "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}\n∑_(i = 1)^(m)(x_{i} + x_{i - 1})Δx_{i} &= (x_{1} + x_{0})Δx_{1} + (x_{2} + x_{1})Δx_{2} + ⋯ + (x_{m} + x_{m - 1})Δx_{m} \\\\\n&= (x_{1} + x_{0})(x_{1} - x_{0}) + (x_{2} + x_{1})(x_{2} - x_{1}) + ⋯ + (x_{m} + x_{m - 1})(x_{m} - x_{m - 1}) \\\\\n&= (x_{1}^{2} - x_{0}^{2}) + (x_{2}^{2} - x_{1}^{2}) + ⋯ + (x_{m}^{2} - x_{m - 1}^{2}) \\\\\n&= (x_{1}^{2} - x_{0}^{2}) + (x_{2}^{2} - x_{1}^{2}) + ⋯ + (x_{m}^{2} - x_{m - 1}^{2}) \\\\\n&=-x_{0}^{2} + x_{m}^{2} \\\\\n&= x_{m}^{2} - x_{0}^{2}\n\\end{aligned}\n$$\n\nNow, since $x_0 = -3$ and $x_m = 4$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}\n∑_(i = 1)^(m)(x_{i} + x_{i - 1})Δx_{i} &= x_{m}^{2} - x_{0}^{2} \\\\\n&= 4^{2} - (-3)^{2} \\\\\n&= 7\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186179589 1074 "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{m} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since $x_0 = -3$ and $x_m = 4$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={4}^{2}-(-3)^{2} \\\\  & =7.\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186179590 1071 "Consider the following partitions:\n\n- $P_1 = \\left\\{x_0, x_1, \\ldots, x_m\\right\\}$ is a partition of the interval $[-1, 2]$\n\n- $P_2 = \\left\\{y_0, y_1, \\ldots, y_n\\right\\}$ is a partition of the interval $[2, 3]$\n\nCalculate $\\displaystyle \\sum_{i=1}^m\\sum_{j=1}^n {3} \\Delta x_i \\Delta y_j,$ where $\\Delta x_i = x_i - x_{i-1}$ and $\\Delta y_j = y_j - y_{j-1}.$" 13194139533390 17592186045585 true] [17592186179590 1071 "Consider the following partitions:\n\n- $P_1 = \\left\\{x_0, x_1, \\ldots, x_m\\right\\}$ is a partition of the interval $[-1, 2]$\n- $P_2 = \\left\\{y_0, y_1, \\ldots, y_n\\right\\}$ is a partition of the interval $[2, 3]$\n\nCalculate $\\displaystyle \\sum_{i=1}^m\\sum_{j=1}^n {3} \\Delta x_i \\Delta y_j$, where $\\Delta x_i = x_i - x_{i-1}$ and $\\Delta y_j = y_j - y_{j-1}$." 13194139533390 17592186045585 false] [17592186179590 1074 "Using the constant multiple and product rules, we can write the summation as\n\n$$\n\\begin{aligned}\n∑_(i = 1)^(m)∑_(j = 1)^(n)3Δx_{i}Δy_{j} &= 3∑_(i = 1)^(m)∑_(j = 1)^(n)Δx_{i}Δy_{j} \\\\\n&= 3∑_(i = 1)^(m)Δx_{i}∑_(j = 1)^(n)Δy_{j}\n\\end{aligned}\n$$\n\nNote that\n\n$$\n\\displaystyle \\sum_{i=1}^m\\Delta x_i\n$$\n\nand\n\n$$\n\\displaystyle \\sum_{j=1}^n\\Delta y_j\n$$\n\nare just the lengths of the intervals $[-1, 2]$ and $[2,3]$ respectively. So, we have\n\n$$\n\\begin{aligned}\n∑_(i = 1)^(m)Δx_{i} &= 2 - (-1) = 3, \\\\\n∑_(j = 1)^(n)Δy_{j} &= 3 - 2 = 1\n\\end{aligned}\n$$\n\nCombining our results, we have\n\n$$\n3 \\sum_{i=1}^m \\Delta x_i \\sum_{j=1}^n \\Delta y_j = 3 \\cdot 3 \\cdot 1 = 9\n$$" 13194139533390 17592186045585 false] [17592186179590 1074 "Using the constant multiple and product rules, we can write the summation as\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}3Δ{x}_{i}Δ{y}_{j} & =3{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j} \\\\  & =3{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}.\\end{aligned}\n$$\n\nNote that $\\displaystyle \\sum_{i=1}^m\\Delta x_i$ and $\\displaystyle \\sum_{j=1}^n\\Delta y_j$ are just the lengths of the intervals $[-1, 2]$ and $[2,3]$ respectively. So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =2-(-1)=3, \\\\ {\\sum }_{j=1}^{n}Δ{y}_{j} & =3-2=1.\\end{aligned}\n$$\n\nCombining our results, we have\n\n$$\n3 \\sum_{i=1}^m \\Delta x_i \\sum_{j=1}^n \\Delta y_j = 3 \\cdot 3 \\cdot 1 = 9.\n$$" 13194139533390 17592186045585 true] [17592186179591 1071 "Which of the following are partitions of the real interval $[1,9]$?\n\n1. $\\{1, 4, 5, 8\\}$\n2. $\\{1, 3, 4, 9\\}$\n3. $1 < 2 < 9$" 13194139533390 17592186045585 false] [17592186179591 1071 "Which of the following are partitions of the real interval $[1,9]?$\n\n- $\\{1, 4, 5, 8\\}$\n\n- $\\{1, 3, 4, 9\\}$\n\n- $1 <     2  <    9$" 13194139533390 17592186045585 true] [17592186179591 1074 "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na = x_0 <      x_1<      x_2 <      \\ldots <      x_n = b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{x_0,x_1,\\ldots,x_n\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[1,9]$ since it does not include the right endpoint $b=9.$\n\n- Statement II is a partition of $[1,9].$\n\n- Statement III is a partition of $[1,9].$\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533390 17592186045585 true] [17592186179591 1074 "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na = x_0 < x_1< x_2 < \\ldots < x_n = b\\,\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{x_0,x_1,\\ldots,x_n\\}\n$$\n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[1,9]$ since it does not include the right endpoint $b=9$.\n- Statement II is a partition of $[1,9]$.\n- Statement III is a partition of $[1,9]$.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533390 17592186045585 false] [17592186179592 1071 "Find a definite integral that is equivalent to the line integral of the function $f(x,y) = x+\\sin{y}$, traversed along the line segment from $(1,0)$ to $(1,1)$." 13194139533390 17592186045585 false] [17592186179592 1071 "Find a definite integral that is equivalent to the line integral of the function $f(x,y) = x+\\sin{y},$ traversed along the line segment from $(1,0)$ to $(1,1).$" 13194139533390 17592186045585 true] [17592186179592 1074 "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s  =  \\int\\limits_{t_a}^{t_b}  f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t,\n$$\n\n \n\nwhere $C$ is the line segment from $(1,0)$ to $(1,1).$ \n\nThe position vectors of the endpoints of our line segment are $\\mathbf{a}=\\mathbf{i}$ and $\\mathbf{b}=\\mathbf{i}+\\mathbf{j}.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+t[(i+j)-i] \\\\  & =i+t\\,j\\end{aligned}\n$$\n\nwhere $0 \\le t \\le 1.$ Thus, we have that $x=1$ and $y=t$ along the segment.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1)i+\\frac{\\text{d}}{\\text{d}t}(t)j \\\\  & =0\\,i+j \\\\  & =j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{0}^{2}+{1}^{2}} \\\\  & =1\\end{aligned}\n$$\n\nNow, since $f(x,y) = x+\\sin{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =1+\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(1+\\operatorname{sin}⁡t)\\cdot 1\\cdot \\text{d}t \\\\  & ={\\int }_{0}^{1}(1+\\operatorname{sin}⁡t)\\text{d}t.\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186179592 1074 "We will use the formula\n\n$$\n\\int\\limits_C f(x, y) \\, \\textrm{d}s = \\int\\limits_{t_a}^{t_b} f(\\mathbf r(t)) \\, \\| \\mathbf r'(t) \\| \\, \\textrm{d}t\n$$\n\nwhere $C$ is line segment from $(1,0)$ to $(1,1)$.\n\nThe position vectors of the endpoints of our line segment are\n\n$$\n\\mathbf{a}=\\mathbf{i}\n$$\n\nand\n\n$$\n\\mathbf{b}=\\mathbf{i}+\\mathbf{j}\n$$\n\nSo, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}\nr(t) &= a + t(b - a) \\\\\n&= i + t[(i + j) - i] \\\\\n&= i + tj\n\\end{aligned}\n$$\n\nwhere\n\n$$\n0 \\le t \\le 1\n$$\n\nThus, we have that $x=1$ and $y=t$ along the segment.\n\nComputing $\\mathbf{r}'(t)$ and $\\| \\mathbf{r}'(t) \\|$, we get the following:\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j \\\\\n&= \\frac{d}{dt}(1)i + \\frac{d}{dt}(t)j \\\\\n&= 0i + j \\\\\n&= j \\\\\n‖r^{′}(t)‖ &= \\sqrt{(\\frac{dx}{dt})^{2} + (\\frac{dy}{dt})^{2}} \\\\\n&= \\sqrt{0^{2} + 1^{2}} \\\\\n&= 1\n\\end{aligned}\n$$\n\nNow, since\n\n$$\nf(x,y) = x+\\sin{y}\n$$\n\n, we obtain\n\n$$\n\\begin{aligned}\nf(r(t)) &= 1 + \\sin t\n\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}\n\\int_(C)f(x, y)ds &= \\int_{0}^{1}f(r(t))‖r^{′}(t)‖dt \\\\\n&= \\int_{0}^{1}(1 + \\sin t) \\cdot 1 \\cdot dt \\\\\n&= \\int_{0}^{1}(1 + \\sin t)dt\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186184093 1071 "Let $f(x) = \\sin{x}$. Calculate the fourth-degree Taylor polynomial for $f(x)$ about $x=\\dfrac{\\pi}{2}$." 13194139533390 17592186045585 false] [17592186184093 1071 "Let $f(x) = \\sin{x}.$ Calculate the fourth-degree Taylor polynomial for $f(x)$ about $x=\\dfrac{\\pi}{2}.$" 13194139533390 17592186045585 true] [17592186184093 1074 "The fourth-degree Taylor polynomial of $f(x)$ about $x=a$ is given by\n\n$$\nP_4(x) = f(a) + f'(a)(x-a) + \\dfrac{f''(a)}{2!}(x-a)^2 + \\dfrac{f'''(a)}{3!}(x-a)^3 + \\dfrac{f^{(4)}(a)}{4!}(x-a)^4\n$$\n\nHere, we have\n\n$$\na=\\dfrac{\\pi}{2}\n$$\n\nso\n\n$$\n\\begin{aligned}\nP_{4}(x) &= f(\\frac{π}{2}) + f^{′}(\\frac{π}{2})(x - \\frac{π}{2}) + (f^{″}(\\frac{π}{2}))/(2!)(x - \\frac{π}{2})^{2} \\\\\n&= + (f^{‴}(\\frac{π}{2}))/(3!)(x - \\frac{π}{2})^{3} + (f^{(4)}(\\frac{π}{2}))/(4!)(x - \\frac{π}{2})^{4}\n\\end{aligned}\n$$\n\nSo we need to work out\n\n$$\nf\\left(\\dfrac{\\pi}{2}\\right)\n$$\n\n$$\nf'\\left(\\dfrac{\\pi}{2}\\right)\n$$\n\n$$\nf''\\left(\\dfrac{\\pi}{2}\\right)\n$$\n\n$$\nf'''\\left(\\dfrac{\\pi}{2}\\right)\n$$\n\nand\n\n$$\nf^{(4)}\\left(\\dfrac{\\pi}{2}\\right)\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}f(x) &= \\sin x & ⟹ & f(\\frac{π}{2})|= 1 \\\\ f^{′}(x)|= \\cos x & ⟹ & f^{′}(\\frac{π}{2})|= 0 \\\\ f^{″}(x)|=-\\sin x & ⟹ & f^{″}(\\frac{π}{2})|=-1 \\\\ f^{‴}(x)|=-\\cos x & ⟹ & f^{‴}(\\frac{π}{2})|= 0 \\\\ f^{(4)}(x)|= \\sin x & ⟹ & f^{(4)}(\\frac{π}{2})|= 1\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, $P_4(x)$ is given by\n\n$$\n\\begin{aligned}\nP_{4}(x) &= 1 - \\frac{1}{2!}(x - \\frac{π}{2})^{2} + \\frac{1}{4!}(x - \\frac{π}{2})^{4} \\\\\n&= 1 - \\frac{1}{2}(x - \\frac{π}{2})^{2} + \\frac{1}{24}(x - \\frac{π}{2})^{4}\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186184093 1074 "The fourth-degree Taylor polynomial of $f(x)$ about $x=a$ is given by\n\n$$\nP_4(x) = f(a) + f'(a)(x-a) + \\dfrac{f''(a)}{2!}(x-a)^2 + \\dfrac{f'''(a)}{3!}(x-a)^3 + \\dfrac{f^{(4)}(a)}{4!}(x-a)^4.\n$$\n\nHere, we have $a=\\dfrac{\\pi}{2},$ so\n\n$$\n\\begin{aligned}{P}_{4}(x) & =f(\\frac{\\pi }{2})+{f}^{′}(\\frac{\\pi }{2})(x-\\frac{\\pi }{2})+\\frac{{f}^{″}(\\frac{\\pi }{2})}{2!}{(x-\\frac{\\pi }{2})}^{2} \\\\  & \\,\\,\\,\\,+\\frac{{f}^{‴}(\\frac{\\pi }{2})}{3!}{(x-\\frac{\\pi }{2})}^{3}+\\frac{{f}^{(4)}(\\frac{\\pi }{2})}{4!}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$\n\nSo we need to work out $f\\left(\\dfrac{\\pi}{2}\\right),$ $f'\\left(\\dfrac{\\pi}{2}\\right),$ $f''\\left(\\dfrac{\\pi}{2}\\right),$ $f'''\\left(\\dfrac{\\pi}{2}\\right)$ and $f^{(4)}\\left(\\dfrac{\\pi}{2}\\right),$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡x & ⟹ &  & f(\\frac{\\pi }{2}) & =1 \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡x & ⟹ &  & {f}^{′}(\\frac{\\pi }{2}) & =0 \\\\ {f}^{″}(x) & =-\\operatorname{sin}⁡x & ⟹ &  & {f}^{″}(\\frac{\\pi }{2}) & =-1 \\\\ {f}^{‴}(x) & =-\\operatorname{cos}⁡x & ⟹ &  & {f}^{‴}(\\frac{\\pi }{2}) & =0 \\\\ {f}^{(4)}(x) & =\\operatorname{sin}⁡x & ⟹ &  & {f}^{(4)}(\\frac{\\pi }{2}) & =1.\\end{aligned}\n$$\n\nTherefore, $P_4(x)$ is given by\n\n$$\n\\begin{aligned}{P}_{4}(x) & =1-\\frac{1}{2!}{(x-\\frac{\\pi }{2})}^{2}+\\frac{1}{4!}{(x-\\frac{\\pi }{2})}^{4} \\\\  & =1-\\frac{1}{2}{(x-\\frac{\\pi }{2})}^{2}+\\frac{1}{24}{(x-\\frac{\\pi }{2})}^{4}.\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186184094 1071 "The fourth-degree Taylor polynomial of $f(x)$ about $x=0$ is given by\n\n$$\nP_4(x) = 1+2x-3x^2+4x^3-5x^4.\n$$\n\nWhat is $f^{(4)}(0)?$" 13194139533390 17592186045585 true] [17592186184094 1071 "The fourth-degree Taylor polynomial of $f(x)$ about $x=0$ is given by\n\n$P_4(x) = 1+2x-3x^2+4x^3-5x^4$.\n\nWhat is $f^{(4)}(0)$?" 13194139533390 17592186045585 false] [17592186184094 1074 "The coefficient of $x^4$ is given by\n\n$$\n\\dfrac{f^{(4)}(0)}{4!}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n(f^{(4)}(0))/(4!) &= -5 \\\\\n(f^{(4)}(0))/(24) &= -5 \\\\\nf^{(4)}(0) &= -120\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186184094 1074 "The coefficient of $x^4$ is given by $\\dfrac{f^{(4)}(0)}{4!}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{{f}^{(4)}(0)}{4!} & =-5 \\\\ \\frac{{f}^{(4)}(0)}{24} & =-5 \\\\ {f}^{(4)}(0) & =-120.\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186184095 1071 "Find the first four non-zero terms in the Taylor expansion of $e^{-x}$ centered about the point $x=3$." 13194139533390 17592186045585 false] [17592186184095 1071 "Find the first four non-zero terms in the Taylor expansion of $e^{-x}$ centered about the point $x=3.$" 13194139533390 17592186045585 true] [17592186184095 1074 "We use Taylor's theorem in the form\n\n$$\nf(x)\t= f(a) + f'(a)(x-a) + \\frac{f''(a)}{2!}(x-a)^2 +\\frac{f'''(a)}{3!}(x-a)^3+\\cdots,\n$$\n\nwith $f(x)=e^{-x}$ and $a=3.$\n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & ={e}^{-x} \\\\ f(3) & ={e}^{-3} \\\\ {f}^{′}(x) & =-{e}^{-x} \\\\ {f}^{′}(3) & =-{e}^{-3} \\\\ {f}^{″}(x) & ={e}^{-x} \\\\ {f}^{″}(3) & ={e}^{-3} \\\\ {f}^{‴}(x) & =-{e}^{-x} \\\\ {f}^{‴}(3) & =-{e}^{-3}\\,.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{e}^{-x} & ={e}^{-3}+(-{e}^{-3})(x-3)+\\frac{({e}^{-3})}{2!}(x-3)^{2}+\\frac{(-{e}^{-3})}{3!}(x-3)^{3}+⋯ \\\\  & ={e}^{-3}-{e}^{-3}(x-3)+\\frac{{e}^{-3}}{2}(x-3)^{2}-\\frac{{e}^{-3}}{6}(x-3)^{3}+⋯\\,.\\end{aligned}\n$$" 13194139533390 17592186045585 true] [17592186184095 1074 "We use Taylor's theorem in the form\n\n$$\nf(x) = f(a) + f'(a)(x-a) + \\frac{f''(a)}{2!}(x-a)^2 +\\frac{f'''(a)}{3!}(x-a)^3+\\cdots\n$$\n\nwith\n\n$$\nf(x)=e^{-x}\n$$\n\nand $a=3$.\n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}\nf(x) &= e^{-x} \\\\\nf(3) &= e^{-3} \\\\\nf^{′}(x) &= -e^{-x} \\\\\nf^{′}(3) &= -e^{-3} \\\\\nf^{″}(x) &= e^{-x} \\\\\nf^{″}(3) &= e^{-3} \\\\\nf^{‴}(x) &= -e^{-x} \\\\\nf^{‴}(3) &= -e^{-3}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\ne^{-x} &= e^{-3} + (-e^{-3})(x - 3) + ((e^{-3}))/(2!)(x - 3)^{2} + ((-e^{-3}))/(3!)(x - 3)^{3} + ⋯ \\\\\n&= e^{-3} - e^{-3}(x - 3) + \\frac{e^{-3}}{2}(x - 3)^{2} - \\frac{e^{-3}}{6}(x - 3)^{3} + ⋯\n\\end{aligned}\n$$" 13194139533390 17592186045585 false] [17592186184096 1071 "Use the first three terms of the Taylor expansion for $f(x) = \\sqrt x$ about $x=9$ to approximate the value of $\\sqrt{9.1}$." 13194139533390 17592186045585 false] [17592186184096 1071 "Use the first three terms of the Taylor expansion for $f(x) = \\sqrt x$ about $x=9$ to approximate the value of $\\sqrt{9.1}.$" 13194139533390 17592186045585 true] [17592186184096 1074 "We use Taylor's theorem in the form\n\n$$\nf(x)\t= f(a) + f'(a)(x-a) + \\frac{f''(a)}{2!}(x-a)^2 +\\cdots,\n$$\n\nwith $a=9.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{1/2} \\\\ f(9) & =3 \\\\ {f}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(9) & =\\frac{1}{6} \\\\ {f}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2} \\\\ {f}^{″}(9) & =-\\frac{1}{108}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\sqrt{x} & =3+\\frac{1}{6}(x-9)+\\frac{1}{2}(-\\frac{1}{108})(x-9)^{2}+⋯ \\\\  & =3+\\frac{1}{6}(x-9)-\\frac{1}{216}(x-9)^{2}+⋯.\\end{aligned}\n$$\n\nWe substitute $x = 9.1$ into the above to approximate $\\sqrt{9.1}.$ We get\n\n$$\n\\begin{aligned}\\sqrt{9.1} & ≈3+\\frac{1}{6}(9.1-9)-\\frac{1}{216}(9.1-9)^{2} \\\\  & ≈3+\\frac{1}{6}(0.1)-\\frac{1}{216}(0.1)^{2} \\\\  & =3.016\\,620,\\end{aligned}\n$$\n\nto six decimal places. \n\n**Note:** The exact value of $\\sqrt{9.1}$ is $3.016\\,621$ to six decimal places. So, our approximation is very good!" 13194139533390 17592186045585 true] [17592186184096 1074 "We use Taylor's theorem in the form\n\n$$\nf(x) = f(a) + f'(a)(x-a) + \\frac{f''(a)}{2!}(x-a)^2 +\\cdots\n$$\n\nwith $a=9$.\n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}\nf(x) &= x^{1/2} \\\\\nf(9) &= 3 \\\\\nf^{′}(x) &= \\frac{1}{2}x^{-1/2} \\\\\nf^{′}(9) &= \\frac{1}{6} \\\\\nf^{″}(x) &= -\\frac{1}{4}x^{-3/2} \\\\\nf^{″}(9) &= -\\frac{1}{108}\n\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\n\\sqrt{x} &= 3 + \\frac{1}{6}(x - 9) + \\frac{1}{2}(-\\frac{1}{108})(x - 9)^{2} + ⋯ \\\\\n&= 3 + \\frac{1}{6}(x - 9) - \\frac{1}{216}(x - 9)^{2} + ⋯\n\\end{aligned}\n$$\n\nWe substitute $x = 9.1$ into the above to approximate $\\sqrt{9.1}$. We get\n\n$$\n\\sqrt{9.1} \\mid \\approx 3 + \\frac{1}{6}(9.1 - 9) - \\frac{1}{216}(9.1 - 9)^{2}; \\approx 3 + \\frac{1}{6}(0.1) - \\frac{1}{216}(0.1)^{2}; = 3.016620\n$$\n\nto six decimal places.\n\n**Note:** The exact value of $\\sqrt{9.1}$ is $3.016\\,621$ to six decimal places. So, our approximation is very good!" 13194139533390 17592186045585 false] [17592186184100 1071 "Let $V$ be the set of all real polynomials of degree exactly $3$, equipped with the usual addition and scalar multiplication operations. Complete the following sentence:\n\n*$V$ is **not** a vector space because $\\textrm{_________}\\,.$*\n\n- the sum of two polynomials of degree $3$ may not be a polynomial of degree $3$\n\n- $V$ does not contain the polynomial $-p(x)$ for every $p(x) \\in V$\n\n- addition of polynomials is not commutative" 13194139533390 17592186045585 true] [17592186184100 1071 "Let $V$ be the set of all real polynomials of degree exactly $3$, equipped with the usual addition and scalar multiplication operations. Complete the following sentence:\n\n> *$V$ is **not** a vector space because $\\textrm{_________}\\,$.*\n\n1. the sum of two polynomials of degree $3$ may not be a polynomial of degree $3$\n2. $V$ does not contain the polynomial $-p(x)$ for every $p(x) \\in V$\n3. addition of polynomials is not commutative" 13194139533390 17592186045585 false] [17592186184100 1074 "The correct answer  is as follows:\n\n*$V$ is **not** a vector space because **the sum of two polynomials of degree $3$ may not be a polynomial of degree $3$.** *\n\nFor instance, if $p(x) = 1 +x^3$ and $q(x) = 1-x^3$, then $p(x)$ and $q(x)$ are in $V.$ However  \n\n$$\n\\begin{aligned}p(x)+q(x) & =(1+{x}^{3})+(1-{x}^{3}) \\\\  & =2\\notin V.\\end{aligned}\n$$\n\nOn the other hand:\n\n- Addition of polynomials is commutative.\n\n- For any polynomial $p(x)$ of degree $3$, the corresponding negative polynomial $-p(x)$ also has degree $3.$" 13194139533390 17592186045585 true] [17592186184100 1074 "The correct answer is as follows:\n\n> *$V$ is **not** a vector space because **the sum of two polynomials of degree $3$ may not be a polynomial of degree $3$.***\n\nFor instance, if\n\n$$\np(x) = 1 +x^3\n$$\n\nand\n\n$$\nq(x) = 1-x^3\n$$\n\n, then $p(x)$ and $q(x)$ are in $V$. However\n\n$$\n\\begin{aligned}\np(x) + q(x) &= (1 + x^{3}) + (1 - x^{3}) \\\\\n&= 2 ∉ V\n\\end{aligned}\n$$\n\nOn the other hand:\n\n- Addition of polynomials is commutative.\n- For any polynomial $p(x)$ of degree $3$, the corresponding negative polynomial $-p(x)$ also has degree $3$." 13194139533390 17592186045585 false] [17592186198244 1071 "Consider a thin plate $D$ that has the mass density function $\\lambda (x,y) = x+y$ and is enclosed between the curve $y=x$ and the $x$-axis for $0 \\leq x \\leq 1$. Given that the mass of the plate is $\\dfrac{1}{2}$ units and its center of mass is located at $(\\overline{x}, \\overline{y})$, what is the value of $\\overline{y}$?" 13194139533390 17592186045585 false] [17592186198244 1071 "Consider a thin plate $D$ that has the mass density function $\\lambda (x,y) = x+y$ and is enclosed between the curve $y=x$ and the $x$-axis for $0 \\leq x \\leq 1.$ Given that the mass of the plate is $\\dfrac{1}{2}$ units and its center of mass is located at $( \\overline{x}, \\overline{y} ),$ what is the value of $\\overline{y}?$" 13194139533390 17592186045585 true] [17592186198244 1074 "The center of mass of a lamina $D$ with the mass density function $\\lambda(x,y)$ is given by\n\n$$\n(\\overline{x},\\overline{y}) = \\left(\\dfrac{M_y}{m}, \\dfrac{M_x}{m} \\right)\n$$\n\nwhere\n\n- $\\displaystyle m = \\iint \\limits_D \\lambda (x,y) \\: \\textrm{d}A$ is the mass of the lamina,\n- $\\displaystyle M_x = \\iint\\limits_D y \\, \\lambda (x,y) \\: \\textrm{d}A$ is the moment of the lamina about the $x$-axis, and\n- $\\displaystyle M_y = \\iint\\limits_D x \\, \\lambda (x,y) \\: \\textrm{d}A$ is the moment of the lamina about the $y$-axis.\n\nNotice that $D$ is a type I plane region:\n\n![](images/b8/b872242423692a20a9d50658c9