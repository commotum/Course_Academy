& 0 \\\\ 0 & 0 & -3\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}B=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}B & =U \\\\ {E}_{1}B & ={E}_{2}^{-1}U \\\\ B & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ B & ={[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -0.25 & 1\\end{aligned}]}^{-1}U \\\\ B & =([\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{aligned}])U \\\\ B & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0.25 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 1 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -3\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{32}=0.25,{u}_{33}=-3,$ and ${l}_{32}\\cdot {u}_{33}=-0.75.$" 13194139533413 17592186045585 true] [17592186302335 1068 #edb/ref 17592186301316 13194139533413 17592186045585 true] [17592186302335 1069 "q-32722" 13194139533413 17592186045585 true] [17592186302335 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302335 1071 "Given that\n$K=[\\begin{aligned}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{aligned}]$\nhas the LU decomposition $K=LU,$ then $L=$" 13194139533413 17592186045585 true] [17592186302335 1072 #uuid "b1cd1efa-f609-59d5-a15c-c2a561c4fae4" 13194139533413 17592186045585 true] [17592186302335 1074 "To find the matrices $L$ and $U,$ we reduce the matrix $K$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $K$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}K & =[\\begin{aligned}4 & 4 & 0 \\\\ 7 & 0 & -1 \\\\ 0 & 7 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{7}{4}){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot K \\\\  & ∼[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 7 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot K \\\\  & ∼[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}K=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}K & =U \\\\ {E}_{1}K & ={E}_{2}^{-1}U \\\\ K & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ K & ={[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]}^{-1}U \\\\ K & =([\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}])U \\\\ K & ={{[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{7}{4} & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 4 & 0 \\\\ 0 & -7 & -1 \\\\ 0 & 0 & 2\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$" 13194139533413 17592186045585 true] [17592186302336 1068 #edb/ref 17592186301724 13194139533413 17592186045585 true] [17592186302336 1069 "q-327247" 13194139533413 17592186045585 true] [17592186302336 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302336 1071 "Find the exact value of ${(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2}.$\n\n${(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2}=$\n{{field-1}}" 13194139533413 17592186045585 true] [17592186302336 1072 #uuid "5fc8ff6e-fc33-5efd-ab02-f17a877d633b" 13194139533413 17592186045585 true] [17592186302336 1074 "First, we expand the parentheses and use the Pythagorean identity.\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,{(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2} & ={sin}^{2}⁡(\\frac{\\pi }{8})+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})+{cos}^{2}⁡(\\frac{\\pi }{8}) \\\\  & =[{sin}^{2}⁡(\\frac{\\pi }{8})+{cos}^{2}⁡(\\frac{\\pi }{8})]+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) \\\\  & =1+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\end{aligned}\n$$\n\nLet's recall the double-angle formula for sine:\n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡(2x)\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=1+\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡(\\frac{\\pi }{8})+\\operatorname{cos}⁡(\\frac{\\pi }{8}))}^{2}=1+\\frac{\\sqrt{2}}{2}.\n$$" 13194139533413 17592186045585 true] [17592186302337 1068 #edb/ref 17592186301857 13194139533413 17592186045585 true] [17592186302337 1069 "q-32727" 13194139533413 17592186045585 true] [17592186302337 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302337 1071 "Calculate the determinant of the matrix\n$S=[\\begin{aligned}0 & 2 & 0 & 0 \\\\ 1 & 0 & 0 & 0 \\\\ 1 & 2 & -5 & 4 \\\\ 4 & 0 & 2 & 2\\end{aligned}].$" 13194139533413 17592186045585 true] [17592186302337 1072 #uuid "f43456bf-f295-5e3b-a9b3-15b153a5e800" 13194139533413 17592186045585 true] [17592186302337 1074 "We use the cofactor expansion along the first row:\n\n$$\n\\begin{aligned}det(S) & ={s}_{11}{C}_{11}+{s}_{12}{C}_{12}+{s}_{13}{C}_{13}+{s}_{14}{C}_{14} \\\\  & =0\\cdot {C}_{11}+2\\cdot {C}_{12}+0\\cdot {C}_{13}+0\\cdot {C}_{14} \\\\  & =2{C}_{12} \\\\  & =2\\cdot |\\begin{aligned}∗ & 2 & ∗ & ∗ \\\\ 1 & ∗ & 0 & 0 \\\\ 1 & ∗ & -5 & 4 \\\\ 4 & ∗ & 2 & 2\\end{aligned}| \\\\  & =2(-1)^{1+2}|\\begin{aligned}1 & 0 & 0 \\\\ 1 & -5 & 4 \\\\ 4 & 2 & 2\\end{aligned}| \\\\  & =-2(1\\cdot |\\begin{aligned}-5 & 4 \\\\ 2 & 2\\end{aligned}|-0\\cdot |\\begin{aligned}1 & 4 \\\\ 4 & 2\\end{aligned}|+0\\cdot |\\begin{aligned}1 & -5 \\\\ 4 & 2\\end{aligned}|) \\\\  & =-2((-5\\cdot 2-4\\cdot 2)-0+0) \\\\  & =-2\\cdot (-18) \\\\  & =36\\end{aligned}\n$$" 13194139533413 17592186045585 true] [17592186302338 1068 #edb/ref 17592186301376 13194139533413 17592186045585 true] [17592186302338 1069 "q-327277" 13194139533413 17592186045585 true] [17592186302338 1070 #edb/ref 17592186045486 13194139533413 17592186045585 true] [17592186302338 1071 "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}.$\n\n$\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=$\n{{field-1}}" 13194139533413 17592186045585 true] [17592186302338 1072 #uuid "c456891a-3eac-5005-ae95-48c26bfb98c5" 13194139533413 17592186045585 true] [17592186302338 1074 "First, we note that:\n\n$$\n\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\cdot \\frac{1}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\operatorname{cos}⁡(\\frac{3\\pi }{8})\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡(2x)\n$$\n\nSubstituting $x=\\frac{3\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\operatorname{cos}⁡(\\frac{3\\pi }{8}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{8}) \\\\  & =\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\operatorname{sin}⁡(\\frac{3\\pi }{8})\\operatorname{cos}⁡(\\frac{3\\pi }{8})=\\frac{\\sqrt{2}}{4}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sin}⁡(\\frac{3\\pi }{8})}{\\operatorname{sec}⁡(\\frac{3\\pi }{8})}=\\frac{\\sqrt{2}}{4}.\n$$" 13194139533413 17592186045585 true] [17592186302339 1068 #edb/ref 17592186301462 13194139533413 17592186045585 true] [17592186302339 1069 "q-32741" 13194139533413 17592186045585 true] [17592186302339 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302339 1071 "$$\nB=[\\begin{aligned}1 & -3 & 2 \\\\ 5 & -10 & 7 \\\\ -3 & 9 & 1\\end{aligned}]\n$$\n\nIf $B=LU$ is the LU decomposition of the matrix $B$ given above, what is the value of ${l}_{21}\\cdot {u}_{23}?$" 13194139533413 17592186045585 true] [17592186302339 1072 #uuid "f0553810-b9c7-5e42-a78c-d0ffc60684a6" 13194139533413 17592186045585 true] [17592186302339 1074 "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $B$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & -3 & 2 \\\\ 5 & -10 & 7 \\\\ -3 & 9 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ \\,\\,5\\,\\, & 5 & -3 \\\\ -3 & 9 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ \\,\\,5\\,\\, & 5 & -3 \\\\ -3 & 0 & 7\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}],\\,U=[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 5 & -3 \\\\ 0 & 0 & 7\\end{aligned}].\n$$\n\nFinally, since ${l}_{21}=5$ and ${u}_{23}=-3,$ we get\n\n$$\n{l}_{21}\\cdot {u}_{23}=5\\cdot (-3)=-15.\n$$" 13194139533413 17592186045585 true] [17592186302340 1068 #edb/ref 17592186301442 13194139533413 17592186045585 true] [17592186302340 1069 "q-32742" 13194139533413 17592186045585 true] [17592186302340 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302340 1071 "$$\nC=[\\begin{aligned}-1 & -2 & -2 \\\\ 4 & 2 & 1 \\\\ 0 & 3 & \\frac{1}{2}\\end{aligned}]\n$$\n\nIf $C=LU$ is the LU decomposition of the matrix $C$ given above, what is the value of ${l}_{32}\\cdot {u}_{22}?$" 13194139533413 17592186045585 true] [17592186302340 1072 #uuid "0bc11750-a747-519f-92bc-e4276b877d58" 13194139533413 17592186045585 true] [17592186302340 1074 "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $C$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}-1 & -2 & -2 \\\\ 4 & 2 & 1 \\\\ 0 & 3 & \\frac{1}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -2 & -2 \\\\ -4 & -6 & -7 \\\\ 0 & 3 & \\frac{1}{2}\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -2 & -2 \\\\ -4 & -6 & -7 \\\\ \\,\\,0\\,\\, & -\\frac{1}{2} & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 0 & -\\frac{1}{2} & 1\\end{aligned}],\\,U=[\\begin{aligned}-1 & -2 & -2 \\\\ 0 & -6 & -7 \\\\ 0 & 0 & -3\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=-\\frac{1}{2}$ and ${u}_{22}=-6,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{22}=(-\\frac{1}{2})\\cdot (-6)=3.\n$$" 13194139533413 17592186045585 true] [17592186302341 1068 #edb/ref 17592186301294 13194139533413 17592186045585 true] [17592186302341 1069 "q-32749" 13194139533413 17592186045585 true] [17592186302341 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302341 1071 "$$\nD=[\\begin{aligned}3 & 4 & 5 \\\\ -9 & -6 & -6 \\\\ -3 & -2 & -2\\end{aligned}]\n$$\n\nIf $D=LU$ is the LU decomposition of the matrix $D$ given above, what is the value of ${l}_{32}\\cdot {u}_{23}?$" 13194139533413 17592186045585 true] [17592186302341 1072 #uuid "27eaf5c2-ea09-500f-97aa-b8eb299f8da3" 13194139533413 17592186045585 true] [17592186302341 1074 "Let's apply our standard LU factorization algorithm.\n\nWe reduce the matrix $D$ to row echelon form to obtain the matrix $U,$ as usual. However, instead of writing zeros below the main diagonal, we will instead write down the entries of the matrix $L.$\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}3 & 4 & 5 \\\\ -9 & -6 & -6 \\\\ -3 & -2 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -3 & -2 & -2\\end{aligned}] & {R}_{3} & :={R}_{3}+1{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -1 & 2 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{3}){R}_{2} \\\\  & ∼[\\begin{aligned}3 & 4 & 5 \\\\ -3 & 6 & 9 \\\\ -1 & \\,\\frac{1}{3}\\, & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\nL=[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ -1 & \\frac{1}{3} & 1\\end{aligned}],\\,U=[\\begin{aligned}3 & 4 & 5 \\\\ 0 & 6 & 9 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\nFinally, since ${l}_{32}=\\frac{1}{3}$ and ${u}_{23}=9,$ we get\n\n$$\n{l}_{32}\\cdot {u}_{23}=\\frac{1}{3}\\cdot 9=3.\n$$" 13194139533413 17592186045585 true] [17592186302342 1068 #edb/ref 17592186301980 13194139533413 17592186045585 true] [17592186302342 1069 "q-327582" 13194139533413 17592186045585 true] [17592186302342 1070 #edb/ref 17592186045485 13194139533413 17592186045585 true] [17592186302342 1071 "Consider the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(0)=1\n$$\n\nfor some function $f(x,y).$ The table below shows the intermediate quantities computed in the first iteration of the Runge-Kutta (RK4) method.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $4$ | $-2$ | $-1$ | $\\frac{1}{2}$ |  |\n\nGiven that the step size is $Δx=\\frac{1}{4},$ at which of the following points is the function $f$ evaluated during this iteration?\n\n- $(\\frac{1}{8},\\frac{3}{2})$\n- $(\\frac{1}{8},\\frac{3}{4})$\n- $(\\frac{1}{2},\\frac{5}{8})$" 13194139533413 17592186045585 true] [17592186302342 1072 #uuid "72c780dd-c7ca-58af-8e2e-0a4e9d41e44d" 13194139533413 17592186045585 true] [17592186302342 1074 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nNow, we have the following table of values:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $4$ | $-2$ | $-1$ | $\\frac{1}{2}$ |  |\n\nWith this in mind, let's find each point at which the slope is evaluated in turn using the values given in the table.\n\n- The slope ${y}^{′}$ is evaluated at the initial point $(x,y)=({x}_{0},{y}_{0})=(0,1).$\n\n- The estimated slope ${y}_{1}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{1},{y}_{1}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot \\frac{1}{4},\\,1+\\frac{1}{2}\\cdot 4\\cdot \\frac{1}{4}) \\\\  & =(\\frac{1}{8},\\frac{3}{2}).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{2}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot \\frac{1}{4},\\,1+\\frac{1}{2}\\cdot (-2)\\cdot \\frac{1}{4}) \\\\  & =(\\frac{1}{8},\\frac{3}{4}).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{3}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{4},\\,1+(-1)\\cdot \\frac{1}{4}) \\\\  & =(\\frac{1}{4},\\frac{3}{4}).\\end{aligned}\n$$\n\nTherefore, of the given options, the slope is evaluated at the points \"I and II only\"." 13194139533413 17592186045585 true] [17592186302343 1068 #edb/ref 17592186301638 13194139533413 17592186045585 true] [17592186302343 1068 #edb/ref 17592186301713 13194139533413 17592186045585 true] [17592186302343 1068 #edb/ref 17592186301898 13194139533413 17592186045585 true] [17592186302343 1068 #edb/ref 17592186302042 13194139533413 17592186045585 true] [17592186302343 1069 "q-327660" 13194139533413 17592186045585 true] [17592186302343 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302343 1071 "Given that a curve is defined parametrically as\n\n$$\nx=t-5,\\,y=\\sqrt{\\,t+4\\,}+1,\\,t\\ge -4,\n$$\n\ndetermine the ranges of $x$ and $y.$\n\n$x$\n{{field-1}}{{field-2}}$,\\,y$\n{{field-3}}{{field-4}}" 13194139533413 17592186045585 true] [17592186302343 1072 #uuid "56d92d39-c171-5d6f-a809-79e1212e0b56" 13194139533413 17592186045585 true] [17592186302343 1074 "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $t-5\\ge -9$ for all $t\\ge -4.$ Consequently, the range of $x$ is\n\n$$\nx\\ge -9.\n$$\n\n- To find the range of $y,$ note that $\\sqrt{t+4}\\ge 0$ for all $t\\ge -4.$ Consequently, the range of $y$ is\n\n$$\ny\\ge 1.\n$$" 13194139533413 17592186045585 true] [17592186302344 1068 #edb/ref 17592186301301 13194139533413 17592186045585 true] [17592186302344 1069 "q-327669" 13194139533413 17592186045585 true] [17592186302344 1070 #edb/ref 17592186045485 13194139533413 17592186045585 true] [17592186302344 1071 "Given that the expression $7\\operatorname{sin}⁡x+6\\sqrt{2}\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with $R>0,$ what is the value of $R?$\n\n$R=$ \n{{field-1}}" 13194139533413 17592186045585 true] [17592186302344 1072 #uuid "2008ce5d-336f-581b-8cfd-ae901047e3d3" 13194139533413 17592186045585 true] [17592186302344 1074 "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n7\\operatorname{sin}⁡x+6\\sqrt{2}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n7\\operatorname{sin}⁡x+6\\sqrt{2}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=7 \\\\ R\\operatorname{sin}⁡ϕ=6\\sqrt{2}\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={7}^{2}+(6\\sqrt{2})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =49+72 \\\\ {R}^{2} & =121 \\\\ R & =11.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$" 13194139533413 17592186045585 true] [17592186302345 1068 #edb/ref 17592186302033 13194139533413 17592186045585 true] [17592186302345 1069 "q-327678" 13194139533413 17592186045585 true] [17592186302345 1070 #edb/ref 17592186045487 13194139533413 17592186045585 true] [17592186302345 1071 "Given that the expression $9\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x-ϕ)$ with $R>0,$ what is the value of $R?$\n\n$R=$ \n{{field-1}}" 13194139533413 17592186045585 true] [17592186302345 1072 #uuid "3c8d389f-2866-55ff-a326-43d633b38963" 13194139533413 17592186045585 true] [17592186302345 1074 "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n9\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n9\\operatorname{sin}⁡x-3\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=9 \\\\ R\\operatorname{sin}⁡ϕ=3\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={9}^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =81+9 \\\\ {R}^{2} & =90 \\\\ R & =\\sqrt{90} \\\\  & =3\\sqrt{10}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$" 13194139533413 17592186045585 true] [17592186302346 1068 #edb/ref 17592186301488 13194139533413 17592186045585 true] [17592186302346 1069 "q-327702" 13194139533413 17592186045585 true] [17592186302346 1070 #edb/ref 17592186045486 13194139533413 17592186045585 true] [17592186302346 1071 "Given that the expression $4\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)$ can be written as $R\\operatorname{sin}⁡(2x+ϕ)$ with $R>0$, what is the value of $R?$\n\n$R=$ \n{{field-1}}" 13194139533413 17592186045585 true] [17592186302346 1072 #uuid "ae3053e1-ef66-54e3-a77c-5b0dc0738ff3" 13194139533413 17592186045585 true] [17592186302346 1074 "The sum formula for sine gives \n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(2x+ϕ) & =R(\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡(2x)+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡(2x)\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)=R\\operatorname{sin}⁡(2x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(2x)+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(2x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(2x),$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=4 \\\\ R\\operatorname{sin}⁡ϕ=3\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={4}^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =16+9 \\\\ {R}^{2} & =25 \\\\ R & =5.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$" 13194139533413 17592186045585 true] [17592186302347 1068 #edb/ref 17592186301450 13194139533413 17592186045585 true] [17592186302347 1069 "q-327703" 13194139533413 17592186045585 true] [17592186302347 1070 #edb/ref 17592186045486 13194139533413 17592186045585 true] [17592186302347 1071 "Given that the expression $3\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)$ can be written as $R\\operatorname{sin}⁡(2x+ϕ)$ with $R>0$, what is the value of $R?$\n\n$R=$ \n{{field-1}}" 13194139533413 17592186045585 true] [17592186302347 1072 #uuid "f53dbaee-2ae9-5ecf-8882-7a17ab88ebf8" 13194139533413 17592186045585 true] [17592186302347 1074 "The sum formula for sine gives \n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(2x+ϕ) & =R(\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡(2x)+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡(2x)\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n3\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)=R\\operatorname{sin}⁡(2x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n3\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(2x)+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(2x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(2x),$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=3 \\\\ R\\operatorname{sin}⁡ϕ=3\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={3}^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =9+9 \\\\ {R}^{2} & =18 \\\\ R & =3\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$" 13194139533413 17592186045585 true] [17592186302348 1068 #edb/ref 17592186301533 13194139533413 17592186045585 true] [17592186302348 1069 "q-327713" 13194139533413 17592186045585 true] [17592186302348 1070 #edb/ref 17592186045485 13194139533413 17592186045585 true] [17592186302348 1071 "Given that the expression $2(\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x)$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0$, what is the value of $ϕ?$\n\n$ϕ=$ \n{{field-1}}${}^{∘}$" 13194139533413 17592186045585 true] [17592186302348 1072 #uuid "1a7bb729-fb4b-54b7-b0c8-1d595ce737f5" 13194139533413 17592186045585 true] [17592186302348 1074 "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2(\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x)=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2(\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2 \\\\ R\\operatorname{sin}⁡ϕ=2\\sqrt{3}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2\\sqrt{3}}{2} \\\\ \\operatorname{tan}⁡ϕ & =\\sqrt{3} \\\\ ϕ & =\\operatorname{arctan}⁡(\\sqrt{3}) \\\\ ϕ & =60\\,{\\,}^{∘}.\\end{aligned}\n$$" 13194139533413 17592186045585 true] [17592186302349 1068 #edb/ref 17592186302045 13194139533413 17592186045585 true] [17592186302349 1069 "q-327714" 13194139533413 17592186045585 true] [17592186302349 1070 #edb/ref 17592186045485 13194139533413 17592186045585 true] [17592186302349 1071 "Given that the expression $\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0$, what is the value of $ϕ?$\n\n$ϕ=$ \n{{field-1}}${}^{∘}$" 13194139533413 17592186045585 true] [17592186302349 1072 #uuid "e82816cb-fa9a-5239-a243-6d4c247f2e0f" 13194139533413 17592186045585 true] [17592186302349 1074 "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{6}\\operatorname{sin}⁡x+\\sqrt{2}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{6} \\\\ R\\operatorname{sin}⁡ϕ=\\sqrt{2}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{2}}{\\sqrt{6}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{1}{\\sqrt{3}} \\\\ ϕ & =arctan\\,(\\frac{1}{\\sqrt{3}}) \\\\ ϕ & =30\\,{\\,}^{∘}.\\end{aligned}\n$$" 13194139533413 17592186045585 true] [17592186302350 1068 #edb/ref 17592186301502 13194139533413 17592186045585 true] [17592186302350 1069 "q-327716" 13194139533413 17592186045585 true] [17592186302350 1070 #edb/ref 17592186045486 13194139533413 17592186045585 true] [17592186302350 1071 "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})}.$\n\n$\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})}=$\n{{field-1}}" 13194139533413 17592186045585 true] [17592186302350 1072 #uuid "6a88295e-a9f4-5381-9209-7cdc6c3b161d" 13194139533413 17592186045585 true] [17592186302350 1074 "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{24}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{24})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})=\\operatorname{sin}⁡(\\frac{\\pi }{12})\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{12})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{12}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{24})\\operatorname{cos}⁡(\\frac{\\pi }{24})}{\\operatorname{sec}⁡(\\frac{\\pi }{12})} & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12}) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12}) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" 13194139533413 17592186045585 true] [17592186302351 1068 #edb/ref 17592186301537 13194139533413 17592186045585 true] [17592186302351 1069 "q-327723" 13194139533413 17592186045585 true] [17592186302351 1070 #edb/ref 17592186045486 13194139533413 17592186045585 true] [17592186302351 1071 "Given that the expression $5\\operatorname{sin}⁡(5x)+2\\operatorname{cos}⁡(5x)$ can be written as $R\\operatorname{sin}⁡(5x+ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0$, what is the **exact** value of $ϕ?$\n\n$ϕ=\\operatorname{arctan}⁡