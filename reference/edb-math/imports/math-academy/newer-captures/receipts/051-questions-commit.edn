34 13194139533434 17592186045585 true] [17592186362212 1075 #edb/ref 17592186361229 13194139533434 17592186045585 true] [17592186362212 1075 #edb/ref 17592186361609 13194139533434 17592186045585 true] [17592186362212 1075 #edb/ref 17592186361812 13194139533434 17592186045585 true] [17592186362212 1076 #edb/ref 17592186045493 13194139533434 17592186045585 true] [17592186362212 1077 "selection" 13194139533434 17592186045585 true] [17592186362212 1079 #edb/ref 17592186360934 13194139533434 17592186045585 true] [17592186362212 1080 #uuid "fac17182-9478-5c05-be5c-4dd690a7c368" 13194139533434 17592186045585 true] [17592186362213 1075 #edb/ref 17592186360851 13194139533434 17592186045585 true] [17592186362213 1075 #edb/ref 17592186360855 13194139533434 17592186045585 true] [17592186362213 1075 #edb/ref 17592186361056 13194139533434 17592186045585 true] [17592186362213 1075 #edb/ref 17592186361115 13194139533434 17592186045585 true] [17592186362213 1075 #edb/ref 17592186361683 13194139533434 17592186045585 true] [17592186362213 1076 #edb/ref 17592186045493 13194139533434 17592186045585 true] [17592186362213 1077 "selection" 13194139533434 17592186045585 true] [17592186362213 1079 #edb/ref 17592186361115 13194139533434 17592186045585 true] [17592186362213 1080 #uuid "fd49cbaa-d57f-5e0e-9cec-db71bf257efe" 13194139533434 17592186045585 true] [17592186362214 1075 #edb/ref 17592186360847 13194139533434 17592186045585 true] [17592186362214 1075 #edb/ref 17592186360879 13194139533434 17592186045585 true] [17592186362214 1075 #edb/ref 17592186361010 13194139533434 17592186045585 true] [17592186362214 1075 #edb/ref 17592186361152 13194139533434 17592186045585 true] [17592186362214 1075 #edb/ref 17592186361511 13194139533434 17592186045585 true] [17592186362214 1076 #edb/ref 17592186045493 13194139533434 17592186045585 true] [17592186362214 1077 "selection" 13194139533434 17592186045585 true] [17592186362214 1079 #edb/ref 17592186360847 13194139533434 17592186045585 true] [17592186362214 1080 #uuid "fd80af4f-beaa-58df-a298-1315b616dfc7" 13194139533434 17592186045585 true] [17592186362215 1068 #edb/ref 17592186362128 13194139533434 17592186045585 true] [17592186362215 1069 "q-97519" 13194139533434 17592186045585 true] [17592186362215 1070 #edb/ref 17592186045485 13194139533434 17592186045585 true] [17592186362215 1071 "Given $X∼B(7,0.9),$ compute $P(5\\le X\\le 6).$ Round your final answer to $4$ decimal places." 13194139533434 17592186045585 true] [17592186362215 1072 #uuid "00ca7976-03b9-5638-95d5-695719b36e13" 13194139533434 17592186045585 true] [17592186362215 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.9),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.9)^{x}(0.1)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(5\\le X\\le 6) & =P(X\\in {5,6}) \\\\  & =f(5)+f(6) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{5})(0.9)^{5}(0.1)^{7-5}+(\\genfrac{}{}{0pt}{}{7}{6})(0.9)^{6}(0.1)^{7-6} \\\\  & =21(0.9)^{5}(0.1)^{2}+7(0.9)^{6}(0.1) \\\\  & ≈0.4960\\end{aligned}\n$$\n\nto $4$ decimal places." 13194139533434 17592186045585 true] [17592186362216 1068 #edb/ref 17592186362160 13194139533434 17592186045585 true] [17592186362216 1069 "q-97521" 13194139533434 17592186045585 true] [17592186362216 1070 #edb/ref 17592186045487 13194139533434 17592186045585 true] [17592186362216 1071 "Given that $X∼B(7,0.5),$ compute $P(X\\le 6).$ Round your final answer to $4$ decimal places." 13194139533434 17592186045585 true] [17592186362216 1072 #uuid "cd0fa54f-0d49-5cf3-b205-811b4116ac34" 13194139533434 17592186045585 true] [17592186362216 1074 "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.5),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.5)^{x}(0.5)^{7-x}.\n$$\n\nComputing $P(X\\le 6)$ will require us to compute $f(x)$ at $x=0,1,2,…,6.$ However, if we compute the complement $P(X>6)$ instead, then we will only have to compute $f(x)$ at $x=7,$ which will result in a much faster computation.\n\nComputing $P(X>6),$ we get\n\n$$\n\\begin{aligned}P(X>6) & =P(X\\in {7}) \\\\  & =f(7) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{7})(0.5)^{7}(0.5)^{7-7} \\\\  & =(0.5)^{7} \\\\  & ≈0.0078\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 6) & =1-P(X>6) \\\\  & ≈1-0.0078 \\\\  & =0.9922\\end{aligned}\n$$\n\nrounded to $4$ decimal places." 13194139533434 17592186045585 true] [17592186362217 1068 #edb/ref 17592186362177 13194139533434 17592186045585 true] [17592186362217 1069 "q-97534" 13194139533434 17592186045585 true] [17592186362217 1070 #edb/ref 17592186045486 13194139533434 17592186045585 true] [17592186362217 1071 "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x-1)(y-1)^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<1$ and $y<1,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x>1$ and $y<1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>1$ and $y>1,$ the slope of the slope field is positive" 13194139533434 17592186045585 true] [17592186362217 1072 #uuid "3ca0f65d-7276-53ff-adf8-200ee3f85dcc" 13194139533434 17592186045585 true] [17592186362217 1074 "First, we define $f(x,y)=(x-1)(y-1)^{2}.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=1$ or $y=1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](images/07/075264fa042adc64e160a83f03a2b125dd5a9b0927fc3ed318778c0004689ec4.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](images/57/5716d59a745fc148b504a4db523286d7c7209fe793fcf369a90d220125f7e9fb.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $x<1$ and $y<1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement II is false. If $x>1$ and $y<1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x>1$ and $y>1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region." 13194139533434 17592186045585 true] [17592186362218 1068 #edb/ref 17592186362107 13194139533434 17592186045585 true] [17592186362218 1069 "q-97546" 13194139533434 17592186045585 true] [17592186362218 1070 #edb/ref 17592186045487 13194139533434 17592186045585 true] [17592186362218 1071 "Consider the basis $B={{b}_{1},{b}_{2},{b}_{3}}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC={[\\begin{aligned}1 \\\\ -3\\end{aligned}],[\\begin{aligned}3 \\\\ -8\\end{aligned}]}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}-2 \\\\ 2\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}1 \\\\ 4\\end{aligned}],\\,T({b}_{3})=[\\begin{aligned}-3 \\\\ -1\\end{aligned}].\n$$" 13194139533434 17592186045585 true] [17592186362218 1072 #uuid "3bee1727-159a-56ba-a287-64ee12b34699" 13194139533434 17592186045585 true] [17592186362218 1074 "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2,3.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=[\\begin{aligned}| & | & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & |\\end{aligned}].\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & -2 & 1 & -3 \\\\ -3 & -8 & 2 & 4 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 & 1 & -3 \\\\ 0 & 1 & -4 & 7 & -10\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+(-3){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 10 & -20 & 27 \\\\ 0 & 1 & -4 & 7 & -10\\end{aligned}]\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}10 & -20 & 27 \\\\ -4 & 7 & -10\\end{aligned}]\n$$" 13194139533434 17592186045585 true] [17592186362219 1068 #edb/ref 17592186362103 13194139533434 17592186045585 true] [17592186362219 1069 "q-97547" 13194139533434 17592186045585 true] [17592186362219 1070 #edb/ref 17592186045487 13194139533434 17592186045585 true] [17592186362219 1071 "Consider the basis $B={{b}_{1},{b}_{2},{b}_{3}}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC={[\\begin{aligned}1 \\\\ 3\\end{aligned}],[\\begin{aligned}2 \\\\ 4\\end{aligned}]}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}3 \\\\ 1\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}-1 \\\\ -1\\end{aligned}],\\,T({b}_{3})=[\\begin{aligned}1 \\\\ -3\\end{aligned}].\n$$" 13194139533434 17592186045585 true] [17592186362219 1072 #uuid "3b1325e9-c5e3-51ac-b916-564fb08a6786" 13194139533434 17592186045585 true] [17592186362219 1074 