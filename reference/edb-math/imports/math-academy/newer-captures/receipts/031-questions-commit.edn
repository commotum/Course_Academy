}(t)+3{x}_{2}(t)-2}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=L{{x}_{1}(t)}+4L{1} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-L{{x}_{1}(t)}+3L{{x}_{2}(t)}-2L{1}\\end{aligned}\n$$\n\nFinally, using the result\n\n$$\nL{1}=\\frac{1}{s},\n$$\n\n we can write our system as follows:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-1={X}_{1}(s)+\\frac{4}{s} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+3{X}_{2}(s)-\\frac{2}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." 13194139533414 17592186045585 true] [17592186305131 1068 #edb/ref 17592186304128 13194139533414 17592186045585 true] [17592186305131 1068 #edb/ref 17592186304463 13194139533414 17592186045585 true] [17592186305131 1068 #edb/ref 17592186304658 13194139533414 17592186045585 true] [17592186305131 1069 "q-332825" 13194139533414 17592186045585 true] [17592186305131 1070 #edb/ref 17592186045486 13194139533414 17592186045585 true] [17592186305131 1071 "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+2\\operatorname{cos}⁡(3t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t)-1,\\end{aligned}\\,x(0)=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}{{field-1}}={{field-2}} \\\\ s{X}_{2}(s)-2=-{X}_{1}(s)+3{X}_{2}(s)-{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." 13194139533414 17592186045585 true] [17592186305131 1072 #uuid "4e6b1f5b-6e82-58ee-bdcb-b2a029c71d13" 13194139533414 17592186045585 true] [17592186305131 1074 "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t