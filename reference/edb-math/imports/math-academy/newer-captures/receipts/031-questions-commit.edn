1}(t) \\\\ {x}_{2}(t)\\end{aligned}].$" 13194139533414 17592186045585 true] [17592186305070 1068 #edb/ref 17592186304741 13194139533414 17592186045585 true] [17592186305070 1069 "q-332592" 13194139533414 17592186045585 true] [17592186305070 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305070 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" 13194139533414 17592186045585 true] [17592186305070 1072 #uuid "715c8db5-9658-59b2-aaca-2ca3230e5135" 13194139533414 17592186045585 true] [17592186305070 1074 "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=2$ with the corresponding eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- Eigenvalue ${\\lambda }_{2}=5$ with the corresponding eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{5t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis. Since ${e}^{2t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{5t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis. Since ${e}^{5t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/89/897778556ebc80f44cf48e17c4fc085c08c45b93358dec9fb0c958de3105c98d.png)" 13194139533414 17592186045585 true] [17592186305071 1068 #edb/ref 17592186304495 13194139533414 17592186045585 true] [17592186305071 1069 "q-332596" 13194139533414 17592186045585 true] [17592186305071 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305071 1071 "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}]x(t)+\\operatorname{cos}⁡(7t)[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nA complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(5t) \\\\ \\operatorname{sin}⁡(5t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(5t) \\\\ \\operatorname{cos}⁡(5t)\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as $x(t)={x}_{c}(t)+{x}_{p}(t),$ where ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" 13194139533414 17592186045585 true] [17592186305071 1072 #uuid "90563aa8-f75c-5dbd-bf48-373762e1d6c9" 13194139533414 17592186045585 true] [17592186305071 1074 "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n\\operatorname{cos}⁡(7t)[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is sinusoidal. Therefore, we assume that the particular solution is also sinusoidal, i.e.\n\n$$\n{x}_{p}(t)=\\operatorname{cos}⁡(7t)[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]+\\operatorname{sin}⁡(7t)[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2}$ are constants that are to be determined." 13194139533414 17592186045585 true] [17592186305072 1068 #edb/ref 17592186304138 13194139533414 17592186045585 true] [17592186305072 1069 "q-33260" 13194139533414 17592186045585 true] [17592186305072 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305072 1071 "If $f(u)={e}^{u+1}\\,i+{e}^{2u}\\,j+\\frac{1}{e}\\,k$ and $u(t)=2{t}^{2}$ then $(f∘u)^{′}(t)=$" 13194139533414 17592186045585 true] [17592186305072 1072 #uuid "30bcefa5-8086-5c62-ab2e-eb5b519248a2" 13194139533414 17592186045585 true] [17592186305072 1074 "By the chain rule, we have\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}({e}^{u+1})\\,i+\\frac{\\text{d}}{\\text{d}u}({e}^{2u})\\,j+\\frac{\\text{d}}{\\text{d}u}\\frac{1}{e}\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2u}\\,j+0\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2t}\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})=4t\\end{aligned}\n$$\n\n \nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\ (f∘u)^{′}(t) & =({e}^{2{t}^{2}+1}\\,i+2{e}^{4{t}^{2}}\\,j)4t \\\\  & =4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j\\end{aligned}\n$$" 13194139533414 17592186045585 true] [17592186305073 1068 #edb/ref 17592186304646 13194139533414 17592186045585 true] [17592186305073 1069 "q-332603" 13194139533414 17592186045585 true] [17592186305073 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305073 1071 "Given $X∼\\text{Geom}(0.7),$ compute the value of $P(X\\le 5).$ Round your answer to $4$ decimal places.\n\n$P(X\\le 5)≈$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305073 1072 #uuid "d1738d29-f170-5642-b543-a444e1367312" 13194139533414 17592186045585 true] [17592186305073 1074 "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}(0.3)^{x-1}(0.7), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 5) & =P(X\\in {1,2,3,4,5}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4)+P(X=5) \\\\  & =f(1)+f(2)+f(3)+f(4)+f(5) \\\\  & =(0.3)^{0}(0.7)+(0.3)^{1}(0.7)+(0.3)^{2}(0.7)+(0.3)^{3}(0.7)+(0.3)^{4}(0.7) \\\\  & ≈0.9976.\\end{aligned}\n$$" 13194139533414 17592186045585 true] [17592186305074 1068 #edb/ref 17592186304363 13194139533414 17592186045585 true] [17592186305074 1069 "q-332607" 13194139533414 17592186045585 true] [17592186305074 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305074 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=-3x(t)+y(t) \\\\ {y}^{′}(t)=2x(t)+4y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above and its trajectory passing through the point $(-1,2)$ in the phase space of the system. What is the tangent vector to the trajectory at this point?" 13194139533414 17592186045585 true] [17592186305074 1072 #uuid "bbb7c5a8-8019-5513-97b1-79df2dce9bf2" 13194139533414 17592186045585 true] [17592186305074 1074 "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nIn our case, the trajectory (solution) passes through the point $(x,y)=(-1,2)$ in the phase space. Substituting the coordinates of this point into the equations of our system, we obtain the following:\n\n$$\n\\begin{aligned}{x}^{′} & =-3x+y \\\\  & =-3(-1)+2 \\\\  & =3+2 \\\\  & =5 \\\\ {y}^{′} & =2x+4y \\\\  & =2(-1)+4(2) \\\\  & =-2+8 \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the tangent vector to the trajectory is\n\n$$\n[\\begin{aligned}{x}^{′} \\\\ {y}^{′}\\end{aligned}]=[\\begin{aligned}5 \\\\ 6\\end{aligned}].\n$$" 13194139533414 17592186045585 true] [17592186305075 1068 #edb/ref 17592186304156 13194139533414 17592186045585 true] [17592186305075 1069 "q-332612" 13194139533414 17592186045585 true] [17592186305075 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305075 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t)+y(t) \\\\ {y}^{′}(t)=-x(t)+3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above and its trajectory passing through the point $(-1,-2)$ in the phase space of the system. What is the tangent vector to the trajectory at this point?" 13194139533414 17592186045585 true] [17592186305075 1072 #uuid "d224fa0d-c666-58fc-b9ce-f9b761da417b" 13194139533414 17592186045585 true] [17592186305075 1074 "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nIn our case, the trajectory (solution) passes through the point $(x,y)=(-1,-2)$ in the phase space. Substituting the coordinates of this point into the equations of our system, we obtain the following:\n\n$$\n\\begin{aligned}{x}^{′} & =2x+y \\\\  & =2(-1)+(-2) \\\\  & =-2-2 \\\\  & =-4 \\\\ {y}^{′} & =-x+3y \\\\  & =-(-1)+3(-2) \\\\  & =1-6 \\\\  & =-5\\end{aligned}\n$$\n\nTherefore, the tangent vector to the trajectory is\n\n$$\n[\\begin{aligned}{x}^{′} \\\\ {y}^{′}\\end{aligned}]=[\\begin{aligned}-4 \\\\ -5\\end{aligned}].\n$$" 13194139533414 17592186045585 true] [17592186305076 1068 #edb/ref 17592186304205 13194139533414 17592186045585 true] [17592186305076 1069 "q-332613" 13194139533414 17592186045585 true] [17592186305076 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305076 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=-x(t)+4y(t) \\\\ {y}^{′}(t)=2x(t)+2y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above and its trajectory passing through the point $(3,-1)$ in the phase space of the system. What is the tangent vector to the trajectory at this point?" 13194139533414 17592186045585 true] [17592186305076 1072 #uuid "2afa676a-abb9-5d12-aece-9211e3985b3d" 13194139533414 17592186045585 true] [17592186305076 1074 "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nIn our case, the trajectory (solution) passes through the point $(x,y)=(3,-1)$ in the phase space. Substituting the coordinates of this point into the equations of our system, we obtain the following:\n\n$$\n\\begin{aligned}{x}^{′} & =-x+4y \\\\  & =-3+4(-1) \\\\  & =-3-4 \\\\  & =-7 \\\\ {y}^{′} & =2x+2y \\\\  & =2(3)+2(-1) \\\\  & =6-2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the tangent vector to the trajectory is\n\n$$\n[\\begin{aligned}{x}^{′} \\\\ {y}^{′}\\end{aligned}]=[\\begin{aligned}-7 \\\\ 4\\end{aligned}].\n$$" 13194139533414 17592186045585 true] [17592186305077 1068 #edb/ref 17592186304420 13194139533414 17592186045585 true] [17592186305077 1069 "q-332614" 13194139533414 17592186045585 true] [17592186305077 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305077 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=3x(t)-2y(t) \\\\ {y}^{′}(t)=-4x(t)+y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above and its trajectory passing through the point $(0,-2)$ in the phase space of the system. What is the tangent vector to the trajectory at this point?" 13194139533414 17592186045585 true] [17592186305077 1072 #uuid "7ff3e0a8-326c-5726-b35a-ede39fe9f714" 13194139533414 17592186045585 true] [17592186305077 1074 "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nIn our case, the trajectory (solution) passes through the point $(x,y)=(0,-2)$ in the phase space. Substituting the coordinates of this point into the equations of our system, we obtain the following:\n\n$$\n\\begin{aligned}{x}^{′} & =3x-2y \\\\  & =3(0)-2(-2) \\\\  & =0+4 \\\\  & =4 \\\\ {y}^{′} & =-4x+y \\\\  & =-4(0)+(-2) \\\\  & =0-2 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the tangent vector to the trajectory is\n\n$$\n[\\begin{aligned}{x}^{′} \\\\ {y}^{′}\\end{aligned}]=[\\begin{aligned}4 \\\\ -2\\end{aligned}].\n$$" 13194139533414 17592186045585 true] [17592186305078 1068 #edb/ref 17592186304719 13194139533414 17592186045585 true] [17592186305078 1069 "q-332618" 13194139533414 17592186045585 true] [17592186305078 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305078 1071 "$$\n{x}^{′}(t)=[\\begin{aligned}2 & 1 \\\\ 0 & 3\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,x(t)={e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{e}^{3t}[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nConsider the initial value problem and its solution given above. What is the tangent vector to the solution curve at the point corresponding to $t=\\operatorname{ln}⁡2?$" 13194139533414 17592186045585 true] [17592186305078 1072 #uuid "16aaff9d-1094-5d86-8806-bdb9ead1fd45" 13194139533414 17592186045585 true] [17592186305078 1074 "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nFirst, we compute the point that corresponds to $t=\\operatorname{ln}⁡2$ on the given trajectory:\n\n$$\n\\begin{aligned}x(\\operatorname{ln}⁡2) & ={e}^{2(\\operatorname{ln}⁡2)}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{e}^{3(\\operatorname{ln}⁡2)}[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =4[\\begin{aligned}1 \\\\ 0\\end{aligned}]+8[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 0\\end{aligned}]+[\\begin{aligned}8 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}12 \\\\ 8\\end{aligned}]\\end{aligned}\n$$\n\nSubstituting this into the equation of our system, we obtain the tangent vector to the trajectory.\n\n$$\n\\begin{aligned}{x}^{′}(\\operatorname{ln}⁡2) & =[\\begin{aligned}2 & 1 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}12 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}2(12)+1(8) \\\\ 0(12)+3(8)\\end{aligned}] \\\\  & =[\\begin{aligned}24+8 \\\\ 0+24\\end{aligned}] \\\\  & =[\\begin{aligned}32 \\\\ 24\\end{aligned}]\\end{aligned}\n$$" 13194139533414 17592186045585 true] [17592186305079 1068 #edb/ref 17592186304678 13194139533414 17592186045585 true] [17592186305079 1069 "q-332622" 13194139533414 17592186045585 true] [17592186305079 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305079 1071 "Given that the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+4y=8\\operatorname{sin}⁡x\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-4x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305079 1072 #uuid "de559633-2354-54c9-aca2-820a96fd0d5e" 13194139533414 17592186045585 true] [17592186305079 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nThe right-hand side of the inhomogeneous equation is $8\\operatorname{sin}⁡x.$ So, we assume the particular solution to be \n\n$$\n{y}_{p}(x)=\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x,\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x)+4(\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x)=8\\operatorname{sin}⁡x.\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n(4\\alpha +\\beta )\\operatorname{cos}⁡x+(-\\alpha +4\\beta )\\operatorname{sin}⁡x=8\\operatorname{sin}⁡x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}4\\alpha +\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡x) \\\\ -\\alpha +4\\beta =8\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-\\frac{8}{17},\\beta =\\frac{32}{17}.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-\\frac{8}{17}\\operatorname{cos}⁡(x)+\\frac{32}{17}\\operatorname{sin}⁡(x).\n$$" 13194139533414 17592186045585 true] [17592186305080 1068 #edb/ref 17592186304666 13194139533414 17592186045585 true] [17592186305080 1069 "q-332627" 13194139533414 17592186045585 true] [17592186305080 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305080 1071 "$$\n{x}^{′}(t)=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}2 \\\\ 0\\end{aligned}],\\,x(t)={e}^{2t}[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem and its solution given above. What is the tangent vector to the solution curve at the point corresponding to $t=\\operatorname{ln}⁡3?$" 13194139533414 17592186045585 true] [17592186305080 1072 #uuid "c44dc777-c533-5984-b45f-de5fb3637699" 13194139533414 17592186045585 true] [17592186305080 1074 "Recall that the $xy$-coordinate plane is called the *phase plane* of the system. A particular solution of an initial value problem is called a *trajectory* (or *orbit*).\n\nFirst, we compute the point that corresponds to $t=\\operatorname{ln}⁡3$ on the given trajectory:\n\n$$\n\\begin{aligned}x(\\operatorname{ln}⁡3) & ={e}^{2(\\operatorname{ln}⁡3)}[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =9[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}9 \\\\ 9\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}10 \\\\ 8\\end{aligned}]\\end{aligned}\n$$\n\nSubstituting this into the equation of our system, we obtain the tangent vector to the trajectory.\n\n$$\n\\begin{aligned}{x}^{′}(\\operatorname{ln}⁡3) & =[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}10 \\\\ 8\\end{aligned}] \\\\  & =[\\begin{aligned}1(10)+1(8) \\\\ 1(10)+1(8)\\end{aligned}] \\\\  & =[\\begin{aligned}18 \\\\ 18\\end{aligned}]\\end{aligned}\n$$" 13194139533414 17592186045585 true] [17592186305081 1068 #edb/ref 17592186304288 13194139533414 17592186045585 true] [17592186305081 1068 #edb/ref 17592186304682 13194139533414 17592186045585 true] [17592186305081 1069 "q-332634" 13194139533414 17592186045585 true] [17592186305081 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305081 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=-2x(t)+4y(t) \\\\ {y}^{′}(t)=x(t)-y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.\n$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." 13194139533414 17592186045585 true] [17592186305081 1072 #uuid "3c782024-64b0-58c7-9205-ffc4beaa0f2c" 13194139533414 17592186045585 true] [17592186305081 1074 "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n-2x+4y=0\\,⇒\\,y=\\frac{1}{2}x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\nx-y=0\\,⇒\\,y=x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/19/19c33a634af36765142e2f4b85df1b9209d3f1abf105a131b629b3249bd91c2c.png)" 13194139533414 17592186045585 true] [17592186305082 1068 #edb/ref 17592186304274 13194139533414 17592186045585 true] [17592186305082 1069 "q-332642" 13194139533414 17592186045585 true] [17592186305082 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305082 1071 "Consider the differential equation\n\n$$\n{y}^{′}+6y=-5{x}^{2}+4x-7.\n$$\n\nFind the complementary solution ${y}_{c}(x)$ to this equation, where $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305082 1072 #uuid "4d6b71e9-a6d0-5a90-9c45-dfeb0fa27c30" 13194139533414 17592186045585 true] [17592186305082 1074 "To find the complementary solution, we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+6{y}_{c}=0.\n$$\n\nNotice that this differential equation is separable since we can write it as\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}=-6{y}_{c}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}_{c}}\\cdot \\frac{\\text{d}{y}_{c}}{\\text{d}x}=-6\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}_{c}}\\,\\frac{\\text{d}{y}_{c}}{\\text{d}x}\\,\\text{d}x & =\\int -6\\,\\text{d}x \\\\ \\int \\frac{1}{{y}_{c}}\\,\\text{d}{y}_{c} & =\\int -6\\,\\text{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =-6x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{-6x+C} \\\\  & ={e}^{-6x}{e}^{C} \\\\  & =K{e}^{-6x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-6x},\n$$\n\nwhere $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305083 1068 #edb/ref 17592186304081 13194139533414 17592186045585 true] [17592186305083 1068 #edb/ref 17592186304241 13194139533414 17592186045585 true] [17592186305083 1069 "q-332643" 13194139533414 17592186045585 true] [17592186305083 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305083 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=-4x(t)+y(t) \\\\ {y}^{′}(t)=2x(t)+2y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.\n$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." 13194139533414 17592186045585 true] [17592186305083 1072 #uuid "d9aa4786-b289-52ac-a652-d60b5c9f4391" 13194139533414 17592186045585 true] [17592186305083 1074 "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n-4x+y=0\\,⇒\\,y=4x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n2x+2y=0\\,⇒\\,y=-x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/1c/1c701d81ab131757758e19c3c1d9813f1e8cda3ff069843c9105dd125d1caf97.png)" 13194139533414 17592186045585 true] [17592186305084 1068 #edb/ref 17592186304466 13194139533414 17592186045585 true] [17592186305084 1069 "q-332644" 13194139533414 17592186045585 true] [17592186305084 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305084 1071 "Given that the differential equation \n\n$$\n3\\frac{\\text{d}y}{\\text{d}x}-6y=9{e}^{4x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{2x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305084 1072 #uuid "b0a6279e-623c-5e5d-bfce-194a9b63b40e" 13194139533414 17592186045585 true] [17592186305084 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $9{e}^{4x},$ and ${e}^{4x}$ is not a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{4x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=4\\alpha {e}^{4x}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}3(4\\alpha {e}^{4x})-6(\\alpha {e}^{4x}) & =9{e}^{4x} \\\\ (12-6)\\alpha {e}^{4x} & =9{e}^{4x} \\\\ 6\\alpha {e}^{4x} & =9{e}^{4x} \\\\ \\alpha  & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=\\frac{3}{2}{e}^{4x}.\n$$" 13194139533414 17592186045585 true] [17592186305085 1068 #edb/ref 17592186304451 13194139533414 17592186045585 true] [17592186305085 1068 #edb/ref 17592186304566 13194139533414 17592186045585 true] [17592186305085 1069 "q-332647" 13194139533414 17592186045585 true] [17592186305085 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305085 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t)+4y(t) \\\\ {y}^{′}(t)=-x(t)+y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.\n\n$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." 13194139533414 17592186045585 true] [17592186305085 1072 #uuid "5714cb19-05a6-5cf5-86c3-beaae7a045c5" 13194139533414 17592186045585 true] [17592186305085 1074 "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n2x+4y=0\\,⇒\\,y=-\\frac{1}{2}x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n-x+y=0\\,⇒\\,y=x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/59/59a731b27e2333fef2bfa48e9e61a7075548ddd74782c1fadf1dd98f68ef2a7e.png)" 13194139533414 17592186045585 true] [17592186305086 1068 #edb/ref 17592186304119 13194139533414 17592186045585 true] [17592186305086 1069 "q-332655" 13194139533414 17592186045585 true] [17592186305086 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305086 1071 "Given that the differential equation \n\n$$\n5\\frac{\\text{d}y}{\\text{d}x}-20y=15{e}^{-x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{4x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305086 1072 #uuid "6e8b85e6-cf06-5623-ab71-a62bf6c263eb" 13194139533414 17592186045585 true] [17592186305086 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $15{e}^{-x},$ and ${e}^{-x}$ is not a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{-x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=-\\alpha {e}^{-x}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}5(-\\alpha {e}^{-x})-20(\\alpha {e}^{-x}) & =15{e}^{-x} \\\\ (-5-20)\\alpha {e}^{-x} & =15{e}^{-x} \\\\ -25\\alpha {e}^{-x} & =15{e}^{-x} \\\\ \\alpha  & =-\\frac{3}{5}\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-\\frac{3}{5}{e}^{-x}.\n$$" 13194139533414 17592186045585 true] [17592186305087 1068 #edb/ref 17592186304529 13194139533414 17592186045585 true] [17592186305087 1068 #edb/ref 17592186304644 13194139533414 17592186045585 true] [17592186305087 1069 "q-332656" 13194139533414 17592186045585 true] [17592186305087 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305087 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)-3y(t) \\\\ {y}^{′}(t)=4x(t)+y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.\n$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." 13194139533414 17592186045585 true] [17592186305087 1072 #uuid "fb793a6e-77d1-560d-be3b-23bba0c8f1f4" 13194139533414 17592186045585 true] [17592186305087 1074 "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\nx-3y=0\\,⇒\\,y=\\frac{1}{3}x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n4x+y=0\\,⇒\\,y=-4x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/1d/1dd7f0c522e3b4d8daaf25ea45ac21c01508cf4c969d3d00638604e9686b7e68.png)" 13194139533414 17592186045585 true] [17592186305088 1068 #edb/ref 17592186304393 13194139533414 17592186045585 true] [17592186305088 1068 #edb/ref 17592186304757 13194139533414 17592186045585 true] [17592186305088 1069 "q-332658" 13194139533414 17592186045585 true] [17592186305088 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305088 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=-x(t)-y(t) \\\\ {y}^{′}(t)=3x(t)-2y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.\n$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." 13194139533414 17592186045585 true] [17592186305088 1072 #uuid "53b44641-b1d4-5c33-944d-87af37e9c891" 13194139533414 17592186045585 true] [17592186305088 1074 "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n-x-y=0\\,⇒\\,y=-x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n3x-2y=0\\,⇒\\,y=\\frac{3}{2}x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/3b/3b064f5f1b2e1a2c8bc3146b4b44a8d2e7b0ab7a83856488bde00ac6ab875efe.png)" 13194139533414 17592186045585 true] [17592186305089 1068 #edb/ref 17592186304676 13194139533414 17592186045585 true] [17592186305089 1069 "q-332659" 13194139533414 17592186045585 true] [17592186305089 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305089 1071 "Given that the differential equation \n\n$$\n6\\frac{\\text{d}y}{\\text{d}x}-18y=24{e}^{-2x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{3x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305089 1072 #uuid "f2ab75a0-6cd5-582d-bf4b-82f239086002" 13194139533414 17592186045585 true] [17592186305089 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $24{e}^{-2x},$ and ${e}^{-2x}$ is not a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{-2x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=-2\\alpha {e}^{-2x}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}6(-2\\alpha {e}^{-2x})-18(\\alpha {e}^{-2x}) & =24{e}^{-2x} \\\\ (-12-18)\\alpha {e}^{-2x} & =24{e}^{-2x} \\\\ -30\\alpha {e}^{-2x} & =24{e}^{-2x} \\\\ \\alpha  & =-\\frac{4}{5}\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-\\frac{4}{5}{e}^{-2x}.\n$$" 13194139533414 17592186045585 true] [17592186305090 1068 #edb/ref 17592186304242 13194139533414 17592186045585 true] [17592186305090 1068 #edb/ref 17592186304388 13194139533414 17592186045585 true] [17592186305090 1069 "q-332660" 13194139533414 17592186045585 true] [17592186305090 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305090 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t)-y(t) \\\\ {y}^{′}(t)=-x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." 13194139533414 17592186045585 true] [17592186305090 1072 #uuid "47dee5c3-cb2f-5d65-8cb6-ba6e6b4bb63b" 13194139533414 17592186045585 true] [17592186305090 1074 "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n2x-y=0\\,⇒\\,y=2x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n-x-3y=0\\,⇒\\,y=-\\frac{1}{3}x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/a9/a9c0fb2365806ddb02ff8c60a618aabf4cc825917c29fb472ee3bab2492b9033.png)" 13194139533414 17592186045585 true] [17592186305091 1068 #edb/ref 17592186304677 13194139533414 17592186045585 true] [17592186305091 1069 "q-332664" 13194139533414 17592186045585 true] [17592186305091 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305091 1071 "Given that the differential equation \n\n$$\n7\\frac{\\text{d}y}{\\text{d}x}+14y=21{e}^{-5x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-2x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305091 1072 #uuid "81fa1809-9925-54c1-9732-91934088476a" 13194139533414 17592186045585 true] [17592186305091 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $21{e}^{-5x},$ and ${e}^{-5x}$ is not a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{-5x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=-5\\alpha {e}^{-5x}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}7(-5\\alpha {e}^{-5x})+14(\\alpha {e}^{-5x}) & =21{e}^{-5x} \\\\ (-35+14)\\alpha {e}^{-5x} & =21{e}^{-5x} \\\\ -21\\alpha {e}^{-5x} & =21{e}^{-5x} \\\\ \\alpha  & =-1\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-{e}^{-5x}.\n$$" 13194139533414 17592186045585 true] [17592186305092 1068 #edb/ref 17592186304545 13194139533414 17592186045585 true] [17592186305092 1069 "q-332667" 13194139533414 17592186045585 true] [17592186305092 1070 #edb/ref 17592186045486 13194139533414 17592186045585 true] [17592186305092 1071 "Given that the differential equation \n\n$$\n4\\frac{\\text{d}y}{\\text{d}x}+8y=5{e}^{2x}+3{e}^{3x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-2x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305092 1072 #uuid "1545356e-4e65-553c-8118-fc733c23efcc" 13194139533414 17592186045585 true] [17592186305092 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $5{e}^{2x}+3{e}^{3x},$ and neither ${e}^{2x}$ nor ${e}^{3x}$ is a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{2x}+\\beta {e}^{3x},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha {e}^{2x}+3\\beta {e}^{3x}.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}4(2\\alpha {e}^{2x}+3\\beta {e}^{3x})+8(\\alpha {e}^{2x}+\\beta {e}^{3x}) & =5{e}^{2x}+3{e}^{3x} \\\\ (8\\alpha +8\\alpha ){e}^{2x}+(12\\beta +8\\beta ){e}^{3x} & =5{e}^{2x}+3{e}^{3x} \\\\ 16\\alpha {e}^{2x}+20\\beta {e}^{3x} & =5{e}^{2x}+3{e}^{3x}\\end{aligned}\n$$\n\nEquating coefficients of ${e}^{2x}$ and ${e}^{3x},$ respectively, gives\n\n$$\n16\\alpha =5,\\,\\,20\\beta =3.\n$$\n\nSo, we have\n\n$$\n\\alpha =\\frac{5}{16},\\,\\,\\beta =\\frac{3}{20}.\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=\\frac{5}{16}{e}^{2x}+\\frac{3}{20}{e}^{3x}.\n$$" 13194139533414 17592186045585 true] [17592186305093 1068 #edb/ref 17592186304266 13194139533414 17592186045585 true] [17592186305093 1069 "q-332668" 13194139533414 17592186045585 true] [17592186305093 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305093 1071 "Given that the differential equation \n\n$$\n3\\frac{\\text{d}y}{\\text{d}x}+9y=7{e}^{x}+4{e}^{4x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-3x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305093 1072 #uuid "2ded7c26-5423-5b6f-b536-de9fa660d3cd" 13194139533414 17592186045585 true] [17592186305093 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $7{e}^{x}+4{e}^{4x},$ and neither ${e}^{x}$ nor ${e}^{4x}$ is a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{x}+\\beta {e}^{4x},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=\\alpha {e}^{x}+4\\beta {e}^{4x}.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}3(\\alpha {e}^{x}+4\\beta {e}^{4x})+9(\\alpha {e}^{x}+\\beta {e}^{4x}) & =7{e}^{x}+4{e}^{4x} \\\\ (3\\alpha +9\\alpha ){e}^{x}+(12\\beta +9\\beta ){e}^{4x} & =7{e}^{x}+4{e}^{4x} \\\\ 12\\alpha {e}^{x}+21\\beta {e}^{4x} & =7{e}^{x}+4{e}^{4x}\\end{aligned}\n$$\n\nEquating coefficients of ${e}^{x}$ and ${e}^{4x},$ respectively, gives\n\n$$\n12\\alpha =7\\,\\text{and}\\,21\\beta =4,\n$$\n\nSo, we have\n\n$$\n\\alpha =\\frac{7}{12}\\,\\text{and}\\,\\beta =\\frac{4}{21}.\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=\\frac{7}{12}{e}^{x}+\\frac{4}{21}{e}^{4x}.\n$$" 13194139533414 17592186045585 true] [17592186305094 1068 #edb/ref 17592186304292 13194139533414 17592186045585 true] [17592186305094 1069 "q-332669" 13194139533414 17592186045585 true] [17592186305094 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305094 1071 "Given that the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+3y=2{e}^{2x}+{e}^{5x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-3x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305094 1072 #uuid "6adfa911-36fb-57ce-b523-2914b62bca69" 13194139533414 17592186045585 true] [17592186305094 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $2{e}^{2x}+{e}^{5x},$ and neither ${e}^{2x}$ nor ${e}^{5x}$ is a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{2x}+\\beta {e}^{5x},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha {e}^{2x}+5\\beta {e}^{5x}.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(2\\alpha {e}^{2x}+5\\beta {e}^{5x})+3(\\alpha {e}^{2x}+\\beta {e}^{5x}) & =2{e}^{2x}+{e}^{5x} \\\\ (2\\alpha +3\\alpha ){e}^{2x}+(5\\beta +3\\beta ){e}^{5x} & =2{e}^{2x}+{e}^{5x} \\\\ 5\\alpha {e}^{2x}+8\\beta {e}^{5x} & =2{e}^{2x}+{e}^{5x}.\\end{aligned}\n$$\n\nEquating coefficients of ${e}^{2x}$ and ${e}^{5x},$ respectively, gives\n\n$$\n5\\alpha =2,\\,8\\beta =1.\n$$\n\nSo, we have\n\n$$\n\\alpha =\\frac{2}{5},\\,\\beta =\\frac{1}{8}.\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=\\frac{2}{5}{e}^{2x}+\\frac{1}{8}{e}^{5x}.\n$$" 13194139533414 17592186045585 true] [17592186305095 1068 #edb/ref 17592186304632 13194139533414 17592186045585 true] [17592186305095 1069 "q-332670" 13194139533414 17592186045585 true] [17592186305095 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305095 1071 "Given that the differential equation \n\n$$\n2\\frac{\\text{d}y}{\\text{d}x}-6y=3{e}^{x}-2{e}^{2x}\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{3x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305095 1072 #uuid "945e99ed-3594-5be0-95b2-a2681c44f43f" 13194139533414 17592186045585 true] [17592186305095 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $3{e}^{x}-2{e}^{2x},$ and neither ${e}^{x}$ nor ${e}^{2x}$ is a term in the complementary solution, so we assume a particular solution of the form\n\n$$\n{y}_{p}=\\alpha {e}^{x}+\\beta {e}^{2x},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=\\alpha {e}^{x}+2\\beta {e}^{2x}.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}2(\\alpha {e}^{x}+2\\beta {e}^{2x})-6(\\alpha {e}^{x}+\\beta {e}^{2x}) & =3{e}^{x}-2{e}^{2x} \\\\ (2\\alpha -6\\alpha ){e}^{x}+(4\\beta -6\\beta ){e}^{2x} & =3{e}^{x}-2{e}^{2x} \\\\ -4\\alpha {e}^{x}-2\\beta {e}^{2x} & =3{e}^{x}-2{e}^{2x}\\end{aligned}\n$$\n\nEquating coefficients of ${e}^{x}$ and ${e}^{2x},$ respectively, gives\n\n$$\n-4\\alpha =3,\\,\\,-2\\beta =-2.\n$$\n\nSo, we have\n\n$$\n\\alpha =-\\frac{3}{4},\\,\\,\\beta =1.\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-\\frac{3}{4}{e}^{x}+{e}^{2x}.\n$$" 13194139533414 17592186045585 true] [17592186305096 1068 #edb/ref 17592186304580 13194139533414 17592186045585 true] [17592186305096 1069 "q-332674" 13194139533414 17592186045585 true] [17592186305096 1070 #edb/ref 17592186045486 13194139533414 17592186045585 true] [17592186305096 1071 "Let $f(t)$ be a piecewise function defined on $[0,\\infty )$ with exponential order $a,$ and consider its Laplace transform \n\n$$\nF(s)=L{f(t)},\\,s>a.\n$$\n\nWhich of the following statements are true?\n\n- If $f(t)$ contains a discontinuity for some value of $t>0,$ we have $F(s)=0$ for all $s>a.$\n- $F(s)$ is infinitely differentiable on $s>a.$\n- The Laplace transform converts a non-smooth $f(t)$ into a smooth function of $s.$" 13194139533414 17592186045585 true] [17592186305096 1072 #uuid "0df5f53a-0779-5ce7-90dc-03bd51afb4c5" 13194139533414 17592186045585 true] [17592186305096 1074 "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. \n\nThe smoothness property states that, for each integer $n\\ge 0$ and $s>a,$ we have\n\n$$\n{F}^{(n)}(s)=(-1)^{n}\\,L{{t}^{n}f(t)}.\n$$\n\nLet's consider each statement in turn.\n\n- Statement I is false. Smoothness has no bearing on whether the Laplace transform vanishes.\nA function of exponential order always has a well-defined Laplace transform for $s>a$, and there is no reason for that transform to be identically zero.\n\n- Statement II is true. The smoothness theorem states that for $f(t)$ of exponential order, the Laplace transform\n\n$$\nF(s)=L{f}(s)\n$$\n\nis infinitely differentiable at every point in its region of convergence, and we have\n\n$$\n{F}^{(n)}(s)=(-1)^{n}\\,L{{t}^{n}f(t)}(s).\n$$\n\n- Statement III is true. The Laplace transform $F(s)$ of a function $f(t)$ is always infinitely differentiable in its region of convergence, even if $f(t)$ is non-smooth.\n\nTherefore, the answer is \"II and III only.\"" 13194139533414 17592186045585 true] [17592186305097 1068 #edb/ref 17592186304453 13194139533414 17592186045585 true] [17592186305097 1069 "q-332676" 13194139533414 17592186045585 true] [17592186305097 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305097 1071 "Given that the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+3y=8\\operatorname{cos}⁡x\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-3x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305097 1072 #uuid "a6f0670b-7554-570f-aed3-adb3d36e01ba" 13194139533414 17592186045585 true] [17592186305097 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nThe right-hand side of the inhomogeneous equation is $8\\operatorname{cos}⁡x.$ So, we assume the particular solution to be \n\n$$\n{y}_{p}(x)=\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x,\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x)+3(\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x)=8\\operatorname{cos}⁡x.\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n(3\\alpha +\\beta )\\operatorname{cos}⁡x+(-\\alpha +3\\beta )\\operatorname{sin}⁡x=8\\operatorname{cos}⁡x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}3\\alpha +\\beta =8\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡x) \\\\ -\\alpha +3\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =\\frac{12}{5},\\beta =\\frac{4}{5}.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=\\frac{12}{5}\\operatorname{cos}⁡(x)+\\frac{4}{5}\\operatorname{sin}⁡(x).\n$$" 13194139533414 17592186045585 true] [17592186305098 1068 #edb/ref 17592186304707 13194139533414 17592186045585 true] [17592186305098 1069 "q-332677" 13194139533414 17592186045585 true] [17592186305098 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305098 1071 "Given that the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+5y=10\\operatorname{cos}⁡x\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-5x}$, find the particular solution ${y}_{p}(x)$ to this equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305098 1072 #uuid "969c9d9a-b9d8-5a82-ab6a-a2021265dcab" 13194139533414 17592186045585 true] [17592186305098 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nThe right-hand side of the inhomogeneous equation is $10\\operatorname{cos}⁡x.$ So, we assume the particular solution to be \n\n$$\n{y}_{p}(x)=\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x,\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x.\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(-\\alpha \\operatorname{sin}⁡x+\\beta \\operatorname{cos}⁡x)+5(\\alpha \\operatorname{cos}⁡x+\\beta \\operatorname{sin}⁡x)=10\\operatorname{cos}⁡x.\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n(5\\alpha +\\beta )\\operatorname{cos}⁡x+(-\\alpha +5\\beta )\\operatorname{sin}⁡x=10\\operatorname{cos}⁡x.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}5\\alpha +\\beta =10\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡x) \\\\ -\\alpha +5\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡x)\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =\\frac{25}{13},\\beta =\\frac{5}{13}.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=\\frac{25}{13}\\operatorname{cos}⁡(x)+\\frac{5}{13}\\operatorname{sin}⁡(x).\n$$" 13194139533414 17592186045585 true] [17592186305099 1068 #edb/ref 17592186304343 13194139533414 17592186045585 true] [17592186305099 1069 "q-332678" 13194139533414 17592186045585 true] [17592186305099 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305099 1071 "$$\n{\\begin{aligned}{x}^{′}(t)=3x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" 13194139533414 17592186045585 true] [17592186305099 1072 #uuid "14b93aa5-65d3-5ddc-9724-ab937ea4f1a2" 13194139533414 17592186045585 true] [17592186305099 1074 "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}3 & 0 \\\\ 0 & -5\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=3$ with the corresponding eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- Eigenvalue ${\\lambda }_{2}=-5$ with the corresponding eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{-5t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis. Since ${e}^{3t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{-5t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis. Since ${e}^{-5t}\\to 0$ as $t\\to \\infty ,$ these solutions approach the origin as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n\\\n\n![](images/3f/3facfdf59a92a9202d834cd77d14e009c4ec69c5f1b7bd5f12bd17ea1bbc338b.png)" 13194139533414 17592186045585 true] [17592186305100 1068 #edb/ref 17592186304211 13194139533414 17592186045585 true] [17592186305100 1069 "q-332686" 13194139533414 17592186045585 true] [17592186305100 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305100 1071 "Given that the differential equation \n\n$$\n{y}^{′}+4y=8{e}^{-4x},\n$$\n\nhas the complementary solution ${y}_{c}(x)=A{e}^{-4x}$, find the particular solution to the equation.\n\n${y}_{p}(x)=$\n{{field-1}}" 13194139533414 17592186045585 true] [17592186305100 1072 #uuid "9bf6129e-2981-5234-ae00-0e47f458eaf3" 13194139533414 17592186045585 true] [17592186305100 1074 "To find the general solution of an inhomogeneous first-order linear equation with constant coefficients on the left-hand side, we must find the sum of the complementary and particular solutions.\n\nWe see that the right-hand side is $8{e}^{-4x},$ and ${e}^{-4x}$ is a term in the complementary solution, so we assume that a particular solution takes the form \n\n$$\n{y}_{p}=\\alpha x{e}^{-4x},\n$$\n\nwhere $\\alpha $ is a constant that is to be determined.\n\nWe calculate the first derivative of ${y}_{p}$ using the product rule for differentiation:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =(\\alpha x{e}^{-4x})^{′} \\\\  & =\\alpha (x{e}^{-4x})^{′} \\\\  & =\\alpha ({e}^{-4x}-4x{e}^{-4x}) \\\\  & =\\alpha (1-4x){e}^{-4x}\\end{aligned}\n$$\n\nTo find the value of $\\alpha ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\begin{aligned}(\\alpha (1-4x){e}^{-4x})+4\\alpha x{e}^{-4x} & =8{e}^{-4x} \\\\ (1-4x+4x)\\alpha {e}^{-4x} & =8{e}^{-4x} \\\\ \\alpha {e}^{-4x} & =8{e}^{-4x} \\\\ \\alpha  & =8\\end{aligned}\n$$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=8x{e}^{-4x}.\n$$" 13194139533414 17592186045585 true] [17592186305101 1068 #edb/ref 17592186304158 13194139533414 17592186045585 true] [17592186305101 1069 "q-332689" 13194139533414 17592186045585 true] [17592186305101 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305101 1071 "Consider the differential equation\n\n$$\n{y}^{′}+3y=-4{x}^{2}+x-6.\n$$\n\nFind the complementary solution ${y}_{c}(x)$ to this equation, where $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305101 1072 #uuid "c3e6a346-bb46-5dab-be9a-8771fc015c42" 13194139533414 17592186045585 true] [17592186305101 1074 "To find the complementary solution, we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+3{y}_{c}=0.\n$$\n\nNotice that this differential equation is separable since we can write it as\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}=-3{y}_{c}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}_{c}}\\cdot \\frac{\\text{d}{y}_{c}}{\\text{d}x}=-3\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}_{c}}\\,\\frac{\\text{d}{y}_{c}}{\\text{d}x}\\,\\text{d}x & =\\int -3\\,\\text{d}x \\\\ \\int \\frac{1}{{y}_{c}}\\,\\text{d}{y}_{c} & =\\int -3\\,\\text{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =-3x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{-3x+C} \\\\  & ={e}^{-3x}{e}^{C} \\\\  & =K{e}^{-3x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-3x},\n$$\n\nwhere $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305102 1068 #edb/ref 17592186304674 13194139533414 17592186045585 true] [17592186305102 1069 "q-332692" 13194139533414 17592186045585 true] [17592186305102 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305102 1071 "![](images/aa/aaeba63f6237121fe226eb30e5378d3e93129bb2782b9c8acb8d73ac719676b3.png)\n\nConsider the phase portrait for a decoupled system above.\nWhich of the following systems could correspond to the given portrait?" 13194139533414 17592186045585 true] [17592186305102 1072 #uuid "05eed77e-6ddf-5b27-b62c-35f5a73a8482" 13194139533414 17592186045585 true] [17592186305102 1074 "Writing a decoupled system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are parallel to the axes. These correspond to so-called straight-line solutions of the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The tangents along the $x$-axis are pointing away from the origin, meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nmust approach infinity as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}>0.$\n\n- The tangents along the $y$-axis are pointing toward the origin, meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nmust approach the origin as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}<0.$\n\nAmong the options, the only system that satisfies ${\\lambda }_{1}>0$ and ${\\lambda }_{2}<0$ is the following:\n\n$$\n{\\begin{aligned}{x}^{′}(t)=4x(t) \\\\ {y}^{′}(t)=-y(t)\\end{aligned}\n$$" 13194139533414 17592186045585 true] [17592186305103 1068 #edb/ref 17592186304511 13194139533414 17592186045585 true] [17592186305103 1069 "q-332695" 13194139533414 17592186045585 true] [17592186305103 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305103 1071 "Consider the differential equation\n\n$$\n{y}^{′}-3y=9{x}^{2}-12x+2.\n$$\n\nFind the complementary solution ${y}_{c}(x)$ to this equation, where $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305103 1072 #uuid "54e47d9d-c03c-54b0-9905-262b86988d90" 13194139533414 17592186045585 true] [17592186305103 1074 "To find the complementary solution, we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-3{y}_{c}=0.\n$$\n\nNotice that this differential equation is separable since we can write it as\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}=3{y}_{c}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}_{c}}\\cdot \\frac{\\text{d}{y}_{c}}{\\text{d}x}=3\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}_{c}}\\,\\frac{\\text{d}{y}_{c}}{\\text{d}x}\\,\\text{d}x & =\\int 3\\,\\text{d}x \\\\ \\int \\frac{1}{{y}_{c}}\\,\\text{d}{y}_{c} & =\\int 3\\,\\text{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =3x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{3x+C} \\\\  & ={e}^{3x}{e}^{C} \\\\  & =K{e}^{3x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{3x},\n$$\n\nwhere $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305104 1068 #edb/ref 17592186304765 13194139533414 17592186045585 true] [17592186305104 1069 "q-332704" 13194139533414 17592186045585 true] [17592186305104 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305104 1071 "Consider the differential equation\n\n$$\n{y}^{′}-4y=-x+6.\n$$\n\nFind the complementary solution ${y}_{c}(x)$ to this equation, where $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305104 1072 #uuid "bb37ab85-9873-5502-a2e7-935faf5d824e" 13194139533414 17592186045585 true] [17592186305104 1074 "To find the complementary solution, we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-4{y}_{c}=0.\n$$\n\nNotice that this differential equation is separable since we can write it as\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}=4{y}_{c}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}_{c}}\\cdot \\frac{\\text{d}{y}_{c}}{\\text{d}x}=4\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}_{c}}\\,\\frac{\\text{d}{y}_{c}}{\\text{d}x}\\,\\text{d}x & =\\int 4\\,\\text{d}x \\\\ \\int \\frac{1}{{y}_{c}}\\,\\text{d}{y}_{c} & =\\int 4\\,\\text{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =4x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{4x+C} \\\\  & ={e}^{4x}{e}^{C} \\\\  & =K{e}^{4x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{4x},\n$$\n\nwhere $A$ is an arbitrary constant." 13194139533414 17592186045585 true] [17592186305105 1068 #edb/ref 17592186304234 13194139533414 17592186045585 true] [17592186305105 1069 "q-332705" 13194139533414 17592186045585 true] [17592186305105 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305105 1071 "![](images/98/98ffa8fec669ce09d22b5b904b710632314f7b22e0eb5098719c41147c186975.png)\n\nConsider the phase portrait for a decoupled system above.\nWhich of the following systems could correspond to the given portrait?" 13194139533414 17592186045585 true] [17592186305105 1072 #uuid "f20c0d44-466d-592f-adfd-5535d1164b77" 13194139533414 17592186045585 true] [17592186305105 1074 "Writing a decoupled system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are parallel to the axes. These correspond to so-called straight-line solutions of the form\n\n$$\n{c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\,\\text{and}\\,{c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The tangents along the $x$-axis are pointing away from the origin, meaning that the solutions of the form \n${c}_{1}{e}^{{\\lambda }_{1}t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nmust approach infinity as $t\\to \\infty .$ So, we must have ${\\lambda }_{1}>0.$\n\n- The tangents along the $y$-axis are also pointing away from the origin, meaning that the solutions of the form \n${c}_{2}{e}^{{\\lambda }_{2}t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nmust also approach infinity as $t\\to \\infty .$ So, we must have ${\\lambda }_{2}>0.$\n\nAmong the options, the only system that satisfies ${\\lambda }_{1}>0$ and ${\\lambda }_{2}>0$ is the following:\n\n$$\n{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=5y(t)\\end{aligned}\n$$" 13194139533414 17592186045585 true] [17592186305106 1068 #edb/ref 17592186304117 13194139533414 17592186045585 true] [17592186305106 1069 "q-332707" 13194139533414 17592186045585 true] [17592186305106 1070 #edb/ref 17592186045485 13194139533414 17592186045585 true] [17592186305106 1071 "![](images/52/5243b22ebef45709f214ac2422cfb72528f24fd5