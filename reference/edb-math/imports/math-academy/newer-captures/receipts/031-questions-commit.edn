t} \\\\ \\frac{3}{2}-\\frac{7}{2}{e}^{4t}\\end{aligned}]=[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]+[\\begin{aligned}\\frac{7}{2} \\\\ -\\frac{7}{2}\\end{aligned}]{e}^{4t}.\n$$" 13194139533414 17592186045585 true] [17592186305042 1068 #edb/ref 17592186304088 13194139533414 17592186045585 true] [17592186305042 1068 #edb/ref 17592186304491 13194139533414 17592186045585 true] [17592186305042 1068 #edb/ref 17592186304514 13194139533414 17592186045585 true] [17592186305042 1068 #edb/ref 17592186304533 13194139533414 17592186045585 true] [17592186305042 1069 "q-332436" 13194139533414 17592186045585 true] [17592186305042 1070 #edb/ref 17592186045487 13194139533414 17592186045585 true] [17592186305042 1071 "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}5 \\\\ 3\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{4}{s}+\\frac{1}{s-6},\\,{X}_{2}(s)=L{{x}_{2}(t)}=\\frac{4}{s}-\\frac{1}{s-6}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{6t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" 13194139533414 17592186045585 true] [17592186305042 1072 #uuid "11bc6671-f60f-5e8a-924a-ddb4eef9ace3" 13194139533414 17592186045585 true] [17592186305042 1074 "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}{{X}_{1}(s)} \\\\  & ={L}^{-1}{\\frac{4}{s}+\\frac{1}{s-6}} \\\\  & =4{L}^{-1}{\\frac{1}{s}}+{L}^{-1}{\\frac{1}{s-6}} \\\\  & =4\\cdot 1+{e}^{6\\cdot t} \\\\  & =4+{e}^{6t} \\