1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -1\\end{aligned}]+\\frac{1}{13}[\\begin{aligned}-9 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{30}{13} \\\\ -\\frac{11}{13}\\end{aligned}] \\\\  & ≈[\\begin{aligned}2.308 \\\\ -0.846\\end{aligned}],\\end{aligned}\n$$\n\nrounded to three decimal places." 13194139533386 17592186045585 true] [17592186203832 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $\\boldsymbol{f}: \\mathbb{R}^n \\to \\mathbb{R}^n$ is\n\n$$\n\\mathbf{x}_{n+1} = \\mathbf{x}_n - [J_\\boldsymbol{f}(\\mathbf{x}_n)]^{-1} \\boldsymbol{f}(\\mathbf{x}_n)\n$$\n\nwhere $J_\\boldsymbol{f}(\\mathbf{x}_n)$ is the Jacobian of $\\boldsymbol f$ evaluated at $\\mathbf{x}_n$.\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}\nJ_{f}(x) &= \\begin{bmatrix}\\frac{∂}{∂x}(x^{2} + y - 4) & \\frac{∂}{∂y}(x^{2} + y - 4) \\\\ \\frac{∂}{∂x}(x + y^{2} - 3) & \\frac{∂}{∂y}(x + y^{2} - 3)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2x & 1 \\\\ 1 & 2y\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n\\begin{bmatrix}2x & 1 \\\\ 1 & 2y\\end{bmatrix}\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}\nx_{2} &= x_{1} - \\begin{bmatrix}2x & 1 \\\\ 1 & 2y\\end{bmatrix}_{x_{1}}^{-1}\\begin{bmatrix}x^{2} + y - 4 \\\\ x + y^{2} - 3\\end{bmatrix}_{x_{1}} \\\\\n&= \\begin{bmatrix}3 \\\\ -1\\end{bmatrix} - \\begin{bmatrix}2(3) & 1 \\\\ 1 & 2(-1)\\end{bmatrix}^{-1}\\begin{bmatrix}3^{2} + (-1) - 4 \\\\ 3 + (-1)^{2} - 3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}3 \\\\ -1\\end{bmatrix} - \\begin{bmatrix}6 & 1 \\\\ 1 & -2\\end{bmatrix}^{-1}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}3 \\\\ -1\\end{bmatrix} - (1)/(6 \\cdot (-2) - 1 \\cdot 1)\\begin{bmatrix}-2 & -1 \\\\ -1 & 6\\end{bmatrix}\\begin{bmatrix}4 \\\\ 1\\end{bmatrix} \\\\\n&= \\begin{bmatrix}3 \\\\ -1\\end{bmatrix} + \\frac{1}{13}\\begin{bmatrix}-9 \\\\ 2\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{30}{13} \\\\ -\\frac{11}{