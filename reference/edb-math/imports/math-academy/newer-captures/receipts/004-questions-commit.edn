d}x}(3{x}^{4}+5x+\\sqrt{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+5x+{x}^{1/2}) \\\\  & =3(4){x}^{3}+5+\\frac{1}{2}{x}^{-1/2} \\\\  & =12{x}^{3}+5+\\frac{1}{2}{x}^{-1/2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{3}+5+\\frac{1}{2}{x}^{-1/2}) \\\\  & =12(3){x}^{2}+0+\\frac{1}{2}(-\\frac{1}{2}){x}^{-3/2} \\\\  & =36{x}^{2}-\\frac{1}{4}{x}^{-3/2}.\\end{aligned}\n$$" 13194139533387 17592186045585 true] [17592186059513 1071 "Given $y = \\dfrac {3 x^2 + x - 1} x$, find $\\dfrac {\\textrm d^{3} y} {\\textrm d x^3}$." 13194139533387 17592186045585 false] [17592186059513 1071 "Given $y = \\dfrac {3 x^2 + x - 1} x$, find $\\dfrac {\\textrm d^{3} y} {\\textrm d x^3}.$" 13194139533387 17592186045585 true] [17592186059513 1074 "First, notice that we can rewrite the function as the sum of powers of $x$, as follows:\n\n$$\n\\begin{aligned}\ny &= \\frac{3x^{2} + x - 1}{x} \\\\\n&= \\frac{3x^{2}}{x} + \\frac{x}{x} - \\frac{1}{x} \\\\\n&= 3x + 1 - x^{-1}\n\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(3x + 1 - x^{-1}) \\\\\n&= 3 + 0 - (-1)x^{-2} \\\\\n&= 3 + x^{-2}\n\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= \\frac{d}{dx}(3 + x^{-2}) \\\\\n&= 0 + (-2)x^{-3} \\\\\n&=-2x^{-3}\n\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}\n\\frac{d^{3}y}{dx^{3}} &= \\frac{d}{dx}(-2x^{-3}) \\\\\n&=-2(-3)x^{-4} \\\\\n&= 6x^{-4}\n\\end{aligned}\n$$" 13194139533387 17592186045585 false] [17592186059513 1074 "First, notice that we can rewrite the function as the sum of powers of $x,$ as follows:\n\n$$\n\\begin{aligned}y & =\\frac{3{x}^{2}+x-1}{x} \\\\  & =\\frac{3{x}^{2}}{x}+\\frac{x}{x}-\\frac{1}{x} \\\\  & =3x+1-{x}^{-1}\\end{aligned}\n$$\n\nNow, computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x+1-{x}^{-1}) \\\\  & =3+0-(-1){x}^{-2} \\\\  & =3+{x}^{-2}.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(3+{x}^{-2}) \\\\  & =0+(-2){x}^{-3} \\\\  & =-2{x}^{-3}.\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{-3}) \\\\  & =-2(-3){x}^{-4} \\\\  & =6{x}^{-4}.\\end{aligned}\n$$" 13194139533387 17592186045585 true] [17592186059549 1071 "Let $\\mathbf{a}=\\langle 0,-0.4,11 \\rangle$ and $\\mathbf{b}=\\langle 2,5,2 \\rangle$. Find $\\mathbf{a} \\cdot \\mathbf{b}$." 13194139533387 17592186045585 false] [17592186059549 1071 "Let $\\mathbf{a}=\\langle 0,-0.4,11 \\rangle$ and $\\mathbf{b}=\\langle 2,5,2 \\rangle.$ Find $\\mathbf{a} \\cdot \\mathbf{b}.$" 13194139533387 17592186045585 true] [17592186059549 1074 "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}\na \\cdot b &= a_{x} \\cdot b_{x} + a_{y} \\cdot b_{y} + a_{z} \\cdot b_{z} \\\\\n&= 0 \\cdot 2 + (-0.4) \\cdot 5 + 11 \\cdot 2 \\\\\n&= 0 - 2 + 22 \\\\\n&= 20\n\\end{aligned}\n$$" 13194139533387 17592186045585 false] [17592186059549 1074 "Summing up the products of corresponding components, we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 2+(-0.4)\\cdot 5+11\\cdot 2 \\\\  & =0-2+22 \\\\  & =20\\end{aligned}\n$$" 13194139533387 17592186045585 true] [17592186059550 1071 "Let $[\\begin{aligned}4 \\\\ -2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 5 \\\\ t\\end{aligned}]$. Given that $\\mathbf{a} \\perp \\mathbf{b}$, find the value of $t$." 13194139533387 17592186045585 true] [17592186059550 1071 "Let $\\begin{bmatrix}4 \\\\ -2 \\\\ 1\\end{bmatrix}$ and $\\begin{bmatrix}-2 \\\\ 5 \\\\ t\\end{bmatrix}$. Given that $\\mathbf{a} \\perp \\mathbf{b}$, find the value of $t$." 13194139533387 17592186045585 false] [17592186059550 1074 "We know that $\\mathbf{a} \\perp \\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are perpendicular) if and only if\n\n$$\n\\mathbf{a} \\cdot \\mathbf{b} = 0\n$$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}\na \\cdot b &= a_{x} \\cdot b_{x} + a_{y} \\cdot b_{y} + a_{z} \\cdot b_{z} \\\\\n&= 4 \\cdot (-2) + (-2) \\cdot 5 + 1 \\cdot t \\\\\n&=-8 - 10 + t \\\\\n&= t - 18\n\\end{aligned}\n$$\n\nSetting the dot product equal to $0$, we obtain:\n\n$$\n\\begin{aligned}\na \\cdot b &= 0 \\\\\nt - 18 &= 0 \\\\\nt &= 18\n\\end{aligned}\n$$" 13194139533387 17592186045585 false] [17592186059550 1074 "We know that $\\mathbf{a} \\perp \\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are perpendicular) if and only if $\\mathbf{a} \\cdot \\mathbf{b} = 0.$\n\nComputing the dot product, we have\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =4\\cdot (-2)+(-2)\\cdot 5+1\\cdot t \\\\  & =-8-10+t \\\\  & =t-18.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we obtain:\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ t-18 & =0 \\\\ t & =18\\end{aligned}\n$$" 13194139533387 17592186045585 true] [17592186059551 1071 "Let $\\mathbf{a}=\\langle 3,-4,1 \\rangle$ and $\\mathbf{b}=\\langle -7,0,2 \\rangle$. Find $\\mathbf{a} \\times \\mathbf{b}$." 13194139533387 17592186045585 false] [17592186059551 1071 "Let $\\mathbf{a}=\\langle 3,-4,1 \\rangle$ and $\\mathbf{b}=\\langle -7,0,2 \\rangle.$ Find $\\mathbf{a} \\times \\mathbf{b}.$" 13194139533387 17592186045585 true] [17592186059551 1074 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\na \\cdot b &= \\begin{vmatrix}i & j & k \\\\ 3 & -4 & 1 \\\\ -7 & 0 & 2\\end{vmatrix} \\\\\n&=\\begin{vmatrix}-4 & 1 \\\\ 0 & 2\\end{vmatrix}i -\\begin{vmatrix}3 & 1 \\\\ -7 & 2\\end{vmatrix}j +\\begin{vmatrix}3 & -4 \\\\ -7 & 0\\end{vmatrix}k \\\\\n&= ((-4) \\cdot 2 - 1 \\cdot 0)i - (3 \\cdot 2 - 1 \\cdot (-7))j + (3 \\cdot 0 - (-4) \\cdot (-7))k \\\\\n&=-8i - 13j - 28k \\\\\n&= ⟨ - 8,-13,-28⟩\n\\end{aligned}\n$$" 13194139533387 17592186045585 false] [17592186059551 1074 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 3 & -4 & 1 \\\\ -7 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}-4 & 1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}3 & 1 \\\\ -7 & 2\\end{aligned}|j+|\\begin{aligned}3 & -4 \\\\ -7 & 0\\end{aligned}|k \\\\  & =((-4)\\cdot 2-1\\cdot 0)i-(3\\cdot 2-1\\cdot (-7))j+(3\\cdot 0-(-4)\\cdot (-7))k \\\\  & =-8i-13j-28k \\\\  & =⟨-8,-13,-28⟩.\\end{aligned}\n$$" 13194139533387 17592186045585 true] [17592186059552 1071 "Let $\\mathbf{a}=\\langle 3, 1, 2x \\rangle$, $\\mathbf{b}=\\langle 0,1,x \\rangle$, and $\\mid \\,\\mathbf{a} \\times \\mathbf{b}\\, \\mid = \\sqrt{19}$. Find $x$." 13194139533387 17592186045585 false] [17592186059552 1071 "Let $\\mathbf{a}=\\langle 3, 1, 2x \\rangle,$ $\\mathbf{b}=\\langle 0,1,x \\rangle,$ and $|\\,\\mathbf{a} \\times \\mathbf{b}\\,| = \\sqrt{19}.$ Find $x.$" 13194139533387 17592186045585 true] [17592186059552 1074 "Using the determinant formula, we get\n\n$$\n\\begin{aligned}\na \\cdot b &= \\begin{vmatrix}i & j & k \\\\ 3 & 1 & 2x \\\\ 0 & 1 & x\\end{vmatrix} \\\\\n&=\\begin{vmatrix}1 & 2x \\\\ 1 & x\\end{vmatrix}i -\\begin{vmatrix}3 & 2x \\\\ 0 & x\\end{vmatrix}j +\\begin{vmatrix}3 & 1 \\\\ 0 & 1\\end{vmatrix}k \\\\\n&=-xi - 3xj + 3k \\\\\n&= ⟨ - x,-3x, 3⟩\n\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}\n\\mid a \\cdot b \\mid &= \\sqrt{(-x)^{2} + (-3x)^{2} + 3^{2}} \\\\\n&= \\sqrt{10x^{2} + 9}\n\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}\n\\mid a \\cdot b &= \\sqrt{19} \\\\\n&= \\sqrt{10x^{2} + 9} = \\sqrt{19} \\\\\n&= 10x^{2} + 9 = 19 \\\\\n&= 10x^{2} = 10 \\\\\n&= x^{2} = 1\n\\end{