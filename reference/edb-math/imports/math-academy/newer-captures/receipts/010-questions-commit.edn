1, 2)$, traversed counterclockwise, and the region $D$ bounded by $C$. Express $∮_(C)xy^{2}dx + 2x^{2}ydy$ as a repeated integral." 13194139533393 17592186045585 false] [17592186134074 1071 "Consider the triangle $C$ in the plane with vertices $(0,0),(1,0)$ and $(1,2),$ traversed counterclockwise, and the region $D$ bounded by $C.$ Express ${∮}_{C}x{y}^{2}\\,dx+2{x}^{2}y\\,dy$ as a repeated integral." 13194139533393 17592186045585 true] [17592186134074 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D$, then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/2e/2e63a57e50b60d7f0c6a3ce12d164716e2cba71c6bd4c6df10460a35beba4209.png)\n\nWe have that $P(x,y)=x{y}^{2}$ and $Q(x,y)=2{x}^{2}y.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2xy,\\,\\frac{∂Q}{∂x}=4xy.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):0\\le x\\le 1,0\\le y\\le 2x}\n$$\n\nTherefore, applying Green's Theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}x{y}^{2}\\,dx+2{x}^{2}y\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(4xy-2xy)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2x}2xy\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" 13194139533393 17592186045585 true] [17592186134075 1068 #edb/ref 17592186130576 13194139533393 17592186045585 false] [17592186134075 1068 #edb/ref 17592186243636 13194139533393 17592186045585 true] [17592186134075 1070 #edb/ref 17592186045485 13194139533393 17592186045585 true] [17592186134075 1071 "Consider the square $C$ in the plane with vertices $(0, 0), (0, 1), (1, 0)$ and $(1, 1)$, and the region $D$ bounded by $C$. According to Green's theorem,\n$∮_(C)y^{2}dx + x^{2}dy = ∬_(D)f(x, y)dA$,\nwhere $C$ is traversed counterclockwise. Calculate the function $f(x, y)$." 13194139533393 17592186045585 false] [17592186134075 1071 "Consider the square $C$ in the plane with vertices $(0,0),(0,1),(1,0)$ and $(1,1),$ and the region $D$ bounded by $C.$ According to Green's theorem, \n\n$$\n{∮}_{C}{y}^{2}\\,dx+{x}^{2}\\,dy={∬}_{D}f(x,y)\\,\\text{d}A,\n$$\n\nwhere $C$ is traversed counterclockwise. Calculate the function $f(x,y).$" 13194139533393 17592186045585 true] [17592186134075 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D$, then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/aa/aa60dd35a920d166f7cc3238a366bde93bd2c33e1b39b0a38313ab46a8de2d8b.png)\n\nWe have that $P(x,y)={y}^{2}$ and $Q(x,y)={x}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}{y}^{2}\\,dx+{x}^{2}\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(2x-2y)\\,\\text{d}A \\\\  & ={∬}_{D}2(x-y)\\,\\text{d}A\\end{aligned}\n$$\n\nHence, $f(x,y)=2(x-y).$" 13194139533393 17592186045585 true] [17592186134080 1068 #edb/ref 17592186130606 13194139533393 17592186045585 false] [17592186134080 1068 #edb/ref 17592186243477 13194139533393 17592186045585 true] [17592186134080 1070 #edb/ref 17592186045486 13194139533393 17592186045585 true] [17592186134080 1071 "Use Green's theorem to evaluate ${∮}_{C}({e}^{x}-2{x}^{2}y)\\,dx+({e}^{y}+2x{y}^{2})\\,dy,$ where $C$ is the boundary of the triangle with vertices at $(0,0),$ $(2,2)$ and $(-2,2),$ traversed counterclockwise." 13194139533393 17592186045585 true] [17592186134080 1071 "Use Green's theorem to evaluate $∮_(C)(e^{x} - 2x^{2}y)dx + (e^{y} + 2xy^{2})dy$, where $C$ is the boundary of the triangle with vertices at $(0, 0)$, $(2, 2)$ and $(-2, 2)$, traversed counterclockwise." 13194139533393 17592186045585 false] [17592186134080 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D$, then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n![](images/7c/7ca4b6fe3a5a16c4004c75b0e4524cc3b42550cb2413d5b8e1c21a1d53cee902.png)\n\nWe have that $P(x,y)={e}^{x}-2{x}^{2}y$ and $Q(x,y)={e}^{y}+2x{y}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-2{x}^{2},\\,\\frac{∂Q}{∂x} & =2{y}^{2}.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type II region as follows:\n\n$$\nD={(x,y):-y\\le x\\le y,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's Theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x}-2{x}^{2}y)\\,dx+({e}^{y}+2x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2{y}^{2}+2{x}^{2})\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-y}^{y}(2{x}^{2}+2{y}^{2})\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}2{[\\frac{{x}^{3}}{3}+x{y}^{2}]}_{-y}^{y}\\,dy \\\\  & =2{\\int }_{0}^{2}(\\frac{{y}^{3}}{3}+{y}^{3}+\\frac{{y}^{3}}{3}+{y}^{3})dy \\\\  & =2{\\int }_{0}^{2}\\frac{8{y}^{3}}{3}\\,dy \\\\  & =\\frac{16}{3}{\\int }_{0}^{2}{y}^{3}\\,dy \\\\  & =\\frac{4}{3}{[{y}^{4}]}_{0}^{2} \\\\  & =\\frac{4}{3}\\cdot {2}^{4} \\\\  & =\\frac{64}{3}.\\end{aligned}\n$$" 13194139533393 17592186045585 true] [17592186134081 1068 #edb/ref 17592186130612 13194139533393 17592186045585 false] [17592186134081 1068 #edb/ref 17592186243522 13194139533393 17592186045585 true] [17592186134081 1070 #edb/ref 17592186045485 13194139533393 175