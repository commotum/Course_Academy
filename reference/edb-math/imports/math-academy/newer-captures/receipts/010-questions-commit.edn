orname{sin}⁡2y\\,\\text{d}A\\end{aligned}\n$$\n\nHence, $f(x,y)=3{e}^{x}\\operatorname{sin}⁡2y.$" 13194139533393 17592186045585 true] [17592186138482 1038 #edb/ref 17592186244138 13194139533393 17592186045585 true] [17592186138482 1038 #edb/ref 17592186244140 13194139533393 17592186045585 true] [17592186138482 1038 #edb/ref 17592186244141 13194139533393 17592186045585 true] [17592186138483 1038 #edb/ref 17592186244142 13194139533393 17592186045585 true] [17592186138483 1038 #edb/ref 17592186244143 13194139533393 17592186045585 true] [17592186138484 1038 #edb/ref 17592186244144 13194139533393 17592186045585 true] [17592186138484 1038 #edb/ref 17592186244145 13194139533393 17592186045585 true] [17592186147459 1038 #edb/ref 17592186244216 13194139533393 17592186045585 true] [17592186147459 1038 #edb/ref 17592186244217 13194139533393 17592186045585 true] [17592186147459 1038 #edb/ref 17592186244218 13194139533393 17592186045585 true] [17592186147459 1038 #edb/ref 17592186244220 13194139533393 17592186045585 true] [17592186147459 1038 #edb/ref 17592186244221 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244222 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244223 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244224 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244225 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244246 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244252 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244253 13194139533393 17592186045585 true] [17592186147460 1038 #edb/ref 17592186244254 13194139533393 17592186045585 true] [17592186147462 1038 #edb/ref 17592186244197 13194139533393 17592186045585 true] [17592186147462 1038 #edb/ref 17592186244198 13194139533393 17592186045585 true] [17592186147462 1038 #edb/ref 17592186244199 13194139533393 17592186045585 true] [17