⁡(0.3)-0.943 \\\\  & ≈0.012.\\end{aligned}\n$$\n\n- The GTE of the second step is\n\n$$\n\\begin{aligned}{e}_{2} & =y({x}_{2})-{y}_{2} \\\\  & =\\operatorname{cos}⁡(0.6)-0.793 \\\\  & ≈0.032.\\end{aligned}\n$$\n\n- The GTE of the third step is\n\n$$\n\\begin{aligned}{e}_{3} & =y({x}_{3})-{y}_{3} \\\\  & =\\operatorname{cos}⁡(0.9)-0.595 \\\\  & ≈0.027.\\end{aligned}\n$$\n\nTherefore, the completed table is as given below.\n\n| $n$ | ${x}_{n}$ | ${y}_{n}$ | $y({x}_{n})$ | ${e}_{n}$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $0$ | $1$ | $1$ | $0$ |\n| $1$ | $0.3$ | $0.943$ | $\\operatorname{cos}⁡(0.3)$ | $0.012$ |\n| $2$ | $0.6$ | $0.793$ | $\\operatorname{cos}⁡(0.6)$ | $0.032$ |\n| $3$ | $0.9$ | $0.595$ | $\\operatorname{cos}⁡(0.9)$ | $0.027$ |" 13194139533415 17592186045585 true] [17592186217244 1038 #edb/ref 17592186308545 13194139533415 17592186045585 true] [17592186217244 1038 #edb/ref 17592186308572 13194139533415 17592186045585 true] [17592186217244 1038 #edb/ref 17592186308573 13194139533415 17592186045585 true] [17592186217244 1038 #edb/ref 17592186308576 13194139533415 17592186045585 true] [17592186217245 1038 #edb/ref 17592186308582 13194139533415 17592186045585 true] [17592186217245 1038 #edb/ref 17592186308583 13194139533415 17592186045585 true] [17592186217245 1038 #edb/ref 17592186308584 13194139533415 17592186045585 true] [17592186217245 1038 #edb/ref 17592186308585 13194139533415 17592186045585 true] [17592186217245 1038 #edb/ref 17592186308586 13194139533415 17592186045585 true] [17592186217245 1038 #edb/ref 17592186308594 13194139533415 17592186045585 true] [17592186217246 1038 #edb/ref 17592186308618 13194139533415 17592186045585 true] [17592186217246 1038 #edb/ref 17592186308625 13194139533415 17592186045585 true] [17592186217246 1038 #edb/ref 17592186308626 13194139533415 17592186045585 true] [17592186217246 1038 #edb/ref 17592186308627 13194139533415 17592186045585 true] [17592186217246 1038 #edb/ref 17592186308628 13194139533415 17592186045585 