{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(4{x}^{2}y+4({x}_{\\text{new}})^{2}{y}_{\\text{new}})\\cdot 0.5 \\\\  & ={x}^{2}y+({x}_{\\text{new}})^{2}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+{x}^{2}y+({x}_{\\text{new}})^{2}{y}_{\\text{new}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-({x}_{\\text{new}})^{2}{y}_{\\text{new}}-y-{x}^{2}y.\n$$" 13194139533415 17592186045585 true] [17592186308558 1068 #edb/ref 17592186307787 13194139533415 17592186045585 true] [17592186308558 1069 "q-334070" 13194139533415 17592186045585 true] [17592186308558 1070 #edb/ref 17592186045485 13194139533415 17592186045585 true] [17592186308558 1071 "Consider the following initial value problem:\n\n$$\n{y}^{′}=5{x}^{3}y,\\,y(0)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=0.5,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" 13194139533415 17592186045585 true] [17592186308558 1072 #uuid "5f055e80-81ea-55eb-ae51-846a4bd0843f" 13194139533415 17592186045585 true] [17592186308558 1074 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(5{x}^{3}y+5({x}_{\\text{new}})^{3}{y}_{\\text{new}})\\cdot 0.5 \\\\  & =\\frac{5}{4}{x}^{3}y+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{5}{4}{x}^{3}y+\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.5$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-\\frac{5}{4}({x}_{\\text{new}})^{3}{y}_{\\text{new}}-y-\\frac{5}{4}{x}^{3}y.\n$$" 13194139533415 17592186045585 true] [17592186308559 1068 #edb/ref 17592186307943 13194139533415 17592186045585 true] [17592186308559 1069 "q-334072" 13194139533415 17592186045585 true] [17592186308559 1070 #edb/ref 17592186045485 13194139533415 17592186045585 true] [17592186308559 1071 "Consider the following initial value problem:\n\n$$\n{y}^{′}=6\\sqrt{x}\\,{y}^{2},\\,y(1)=2\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **general form** of $g({y}_{\\text{new}})$ in terms of the new values ${x}_{\\text{new}}$ and ${y}_{\\text{new}},$ and the current values $x$ and $y?$" 13194139533415 17592186045585 true] [17592186308559 1072 #uuid "113a0a61-21ac-5c28-bc2b-027553b8fdc6" 13194139533415 17592186045585 true] [17592186308559 1074 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(6\\sqrt{x}\\,{y}^{2}+6\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2})\\cdot 1 \\\\  & =3\\sqrt{x}\\,{y}^{2}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+3\\sqrt{x}\\,{y}^{2}+3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-3\\sqrt{{x}_{\\text{new}}}\\,{y}_{\\text{new}}^{2}-y-3\\sqrt{x}\\,{y}^{2}.\n$$" 13194139533415 17592186045585 true] [17592186308560 1068 #edb/ref 17592186307564 13194139533415 17592186045585 true] [17592186308560 1069 "q-334075" 13194139533415 17592186045585 true] [17592186308560 1070 #edb/ref 17592186045487 13194139533415 17592186045585 true] [17592186308560 1071 "Consider the following initial value problem:\n\n$$\n{y}^{′}=4{x}^{2}{y}^{2},\\,y(1)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" 13194139533415 17592186045585 true] [17592186308560 1072 #uuid "b0104341-0b06-5315-92aa-0e7d14a32551" 13194139533415 17592186045585 true] [17592186308560 1074 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(4{x}^{2}{y}^{2}+4{x}_{\\text{new}}^{2}({y}_{\\text{new}})^{2})\\cdot 1 \\\\  & =2{x}^{2}{y}^{2}+2{x}_{\\text{new}}^{2}({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+2{x}^{2}{y}^{2}+2{x}_{\\text{new}}^{2}({y}_{\\text{new}})^{2},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{y}_{\\text{new}}-2{x}_{\\text{new}}^{2}({y}_{\\text{new}})^{2}-y-2{x}^{2}{y}^{2}=0.\n$$\n\nSo, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-2{x}_{\\text{new}}^{2}({y}_{\\text{new}})^{2}-y-2{x}^{2}{y}^{2}.\n$$\n\nNow, in the first step, the new $x$ value is\n\n$$\n{x}_{\\text{new}}=x+Δx=1+1=2.\n$$\n\n Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-2(2)^{2}({y}_{\\text{new}})^{2}-1-2(1)^{2}(1)^{2} \\\\  & ={y}_{\\text{new}}-8({y}_{\\text{new}})^{2}-3.\\end{aligned}\n$$" 13194139533415 17592186045585 true] [17592186308561 1068 #edb/ref 17592186307798 13194139533415 17592186045585 true] [17592186308561 1069 "q-334080" 13194139533415 17592186045585 true] [17592186308561 1070 #edb/ref 17592186045487 13194139533415 17592186045585 true] [17592186308561 1071 "Consider the following initial value problem:\n\n$$\n{y}^{′}={x}^{2}-y,\\,y(1)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" 13194139533415 17592186045585 true] [17592186308561 1072 #uuid "0755b082-c081-5233-b79a-1dd852af7280" 13194139533415 17592186045585 true] [17592186308561 1074 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example  $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(({x}^{2}-y)+({x}_{\\text{new}}^{2}-{y}_{\\text{new}}))\\cdot 1 \\\\  & =\\frac{1}{2}({x}^{2}-y+{x}_{\\text{new}}^{2}-{y}_{\\text{new}}).\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{2}({x}^{2}-y+{x}_{\\text{new}}^{2}-{y}_{\\text{new}}),\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{y}_{\\text{new}}-y-\\frac{1}{2}({x}^{2}-y+{x}_{\\text{new}}^{2}-{y}_{\\text{new}})=0.\n$$\n\nSo, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-y-\\frac{1}{2}({x}^{2}-y+{x}_{\\text{new}}^{2}-{y}_{\\text{new}}).\n$$\n\nNow, in the first step, the new $x$ value is\n\n$$\n{x}_{\\text{new}}=x+Δx=1+1=2.\n$$\n\nTherefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-1-\\frac{1}{2}({1}^{2}-1+{2}^{2}-{y}_{\\text{new}}) \\\\  & ={y}_{\\text{new}}-1-\\frac{1}{2}(0+4-{y}_{\\text{new}}) \\\\  & =\\frac{3}{2}{y}_{\\text{new}}-3.\\end{aligned}\n$$" 13194139533415 17592186045585 true] [17592186308562 1068 #edb/ref 17592186308236 13194139533415 17592186045585 true] [17592186308562 1069 "q-334096" 13194139533415 17592186045585 true] [17592186308562 1070 #edb/ref 17592186045485 13194139533415 17592186045585 true] [17592186308562 1071 "Given that ${y}_{0}(x)=x+1$ is a particular solution of the Riccati differential equation\n\n$$\n{y}^{′}=3{y}^{2}-6(x+1)y+3{x}^{2}+6x+4\n$$\n\n \n\nfind the general solution of the equation." 13194139533415 17592186045585 true] [17592186308562 1072 #uuid "17bcba41-0878-5706-839e-70ba7080e7b5" 13194139533415 17592186045585 true] [17592186308562 1074 "The equation\n\n$$\n{y}^{′}=3{y}^{2}-6(x+1)y+3{x}^{2}+6x+4,\n$$\n\nis a Riccati differential equation of the form\n\n$$\n{y}^{′}=a(x){y}^{2}+b(x)y+c(x),\n$$\n\nwhere\n\n$$\na(x)=3,\\,b(x)=-6(x+1),\\,c(x)=3{x}^{2}+6x+4.\n$$\n\nTo reduce the given Riccati equation to a Bernoulli equation, we use the substitution\n\n$$\ny(x)=z(x)+{y}_{0}(x),\n$$\n\nwhere ${y}_{0}(x)$ is a known particular solution.\nDifferentiating gives\n\n$$\n{y}^{′}(x)={z}^{′}(x)+{y}_{0}^{′}(x).\n$$\n\nIn our case, ${y}_{0}(x)=x+1.$ Since ${y}_{0}^{′}(x)=1$, we have\n\n$$\ny=z+x+1\\,⇒\\,{y}^{′}={z}^{′}+1.\n$$\n\nLet's substitute these expressions into our Riccati equation:\n\n$$\n{z}^{′}+1=3(z+x+1)^{2}-6(x+1)(z+x+1)+3{x}^{2}+6x+4.\n$$\n\nNow, we expand the right-hand side, and simplify:\n\n$$\n\\begin{aligned}{z}^{′}+1 & =3((x+1)^{2}+2(x+1)z+{z}^{2})-6(x+1)(z+x+1)+3{x}^{2}+6x+4 \\\\ {z}^{′}+1 & =3{z}^{2}+1 \\\\ {z}^{′} & =3{z}^{2}\\end{aligned}\n$$\n\nWe can solve the obtained equation using separation of variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x} & =3{z}^{2} \\\\ \\frac{1}{{z}^{2}}\\frac{\\text{d}z}{\\text{d}x} & =3 \\\\ \\int \\frac{1}{{z}^{2}}\\frac{\\text{d}z}{\\text{d}x}\\,\\text{d}x & =\\int 3\\,\\text{d}x \\\\ \\int {z}^{-2}\\,\\text{d}z & =\\int 3\\,\\text{d}x \\\\ -\\frac{1}{z} & =3x+C \\\\ z & =-\\frac{1}{3x+C}\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant.\n\nFinally, let's substitute $z=y-(x+1)$ to recover the initial variable $y:$\n\n$$\n\\begin{aligned}z & =-\\frac{1}{3x+C} \\\\ y-(x+1) & =-\\frac{1}{3x+C} \\\\ y & =-\\frac{1}{3x+C}+x+1 \\\\  & =x+1-\\frac{1}{3x+C}\\end{aligned}\n$$" 13194139533415 17592186045585 true] [17592186308563 1068 #edb/ref 17592186308177 13194139533415 17592186045585 true] [17592186308563 1069 "q-334103" 13194139533415 17592186045585 true] [17592186308563 1070 #edb/ref 17592186045485 13194139533415 17592186045585 true] [17592186308563 1071 "$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ -1 & 4\\end{aligned}]x(t)\n$$\n\nConsider the system of linear differential equations above.\nFind the unknown function $f(t)$ in the general solution to the system, shown below.\n\n$$\n\\text{x}(t)={c}_{1}[\\begin{aligned}\\operatorname{sin}⁡t \\\\ f(t)\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{4t}\n$$\n\n*Hint: One of the eigenvalues of the matrix is ${\\lambda }_{1}=4+\\text{i}.$*" 13194139533415 17592186045585 true] [17592186308563 1072 #uuid "78ae1104-266d-589e-8326-583eecd00f87" 13194139533415 17592186045585 true] [17592186308563 1074 "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}4 & 1 \\\\ -1 & 4\\end{aligned}].$ \n\nWe are given that the eigenvalue is ${\\lambda }_{1}=4+\\text{i}.$ \n\nLet's go through the process of finding the eigenvectors. For ${\\lambda }_{1}=4+\\text{i},$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-\\text{i} & 1 \\\\ -1 & -\\text{i}\\end{aligned}]∼[\\begin{aligned}1 & \\text{i} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=4+\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}