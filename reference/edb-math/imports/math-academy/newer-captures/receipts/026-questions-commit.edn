{x}^{3}+{y}^{3}-1) & \\frac{∂}{∂y}({x}^{3}+{y}^{3}-1)\\end{aligned}] \\\\  & =[\\begin{aligned}4x & 2y \\\\ 3{x}^{2} & 3{y}^{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{[\\begin{aligned}4x & 2y \\\\ 3{x}^{2} & 3{y}^{2}\\end{aligned}]}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{[\\begin{aligned}2{x}^{2}+{y}^{2}-2 \\\\ {x}^{3}+{y}^{3}-1\\end{aligned}]}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}{[\\begin{aligned}4x & 2y \\\\ 3{x}^{2} & 3{y}^{2}\\end{aligned}]}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{[\\begin{aligned}2{x}^{2}+{y}^{2}-2 \\\\ {x}^{3}+{y}^{3}-1\\end{aligned}]}_{{x}_{0}} \\\\ [\\begin{aligned}4(1) & 2(1) \\\\ 3(1)^{2} & 3(1)^{2}\\end{aligned}]({x}_{1}-{x}_{0}) & =-[\\begin{aligned}2(1)^{2}+(1)^{2}-2 \\\\ (1)^{3}+(1)^{3}-1\\end{aligned}] \\\\ [\\begin{aligned}4 & 2 \\\\ 3 & 3\\end{aligned}]({x}_{1}-{x}_{0}) & =[\\begin{aligned}-1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nSolving this system of equations, we get $({x}_{1}-{x}_{0})=[\\begin{aligned}-0.166\\,66… \\\\ -0.166\\,66…\\end{aligned}].$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}+[\\begin{aligned}-0.166\\,66… \\\\ -0.166\\,66…\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}-0.166\\,66… \\\\ -0.166\\,66…\\end{aligned}] \\\\  & ≈[\\begin{aligned}0.833 \\\\ 0.833\\end{aligned}],\\end{aligned}\n$$\n\nrounded to three decimal places." 13194139533409 17592186045585 true] [17592186204504 1068 #edb/ref 17592186202987 13194139533409 17592186045585 false] [17592186204504 1068 #edb/ref 17592186291968 13194139533409 17592186045585 true] [17592186204504 1070 #edb/ref 17592186045485 13194139533409 17592186045585 true] [17592186204504 1071 "Suppose we wish to find a zero of the function $f(x, y)$ in the region $[- 2, 0] \\cdot [- 2, 0]⊆R^{2}$, where\n$f(x, y) = \\begin{bmatrix}xy - 1 \\\\ y^{3} + 3xy^{4} + 3\\end{bmatrix}$.\nCalculate one iteration of the Newton-Raphson process that starts with $x_{0} = [- 1,-1]^{T}$. Round your answer to three decimal places (if needed).$x_{1} \\approx [$\n{{field-1}}\n$]$$-0.917$" 13194139533409 17592186045585 false] [17592186204504 1071 "Suppose we wish to find a zero of the function $f(x,y)$ in the region $[-2,0]\\times [-2,0]⊆{R}^{2},$ where\n\n$$\nf(x,y)=[\\begin{aligned}xy-1 \\\\ {y}^{3}+3x{y}^{4}+3\\end{aligned}].\n$$\n\nCalculate one iteration of the Newton-Raphson process that starts with ${x}_{0}=[-1,\\,-1]^{T}.$ Round your answer to three decimal places (if needed).\n\n| ${x}_{1}≈[$ | {{field-1}} | $]$ |\n| --- | --- | --- |\n| $-0.917$ |  |  |" 13194139533409 17592186045585 true] [17592186204504 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $f:{R}^{n}\\to {R}^{n}$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{J}_{f}({x}_{n})]^{-1}f({x}_{n}),\n$$\n\nwhere ${J}_{f}({x}_{n})$ is the Jacobian of $f$ evaluated at ${x}_{n}.$\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}{J}_{f}(x) & =[\\begin{aligned}\\frac{∂}{∂x}(xy-1) & \\frac{∂}{∂y}(xy-1) \\\\ \\frac{∂}{∂x}({y}^{3}+3x{y}^{4}+3) & \\frac{∂}{∂y}({y}^{3}+3x{y}^{4}+3)\\end{aligned}] \\\\  & =[\\begin{aligned}y & x \\\\ 3{y}^{4} & 3{y}^{2}+12x{y}^{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{[\\begin{aligned}y & x \\\\ 3{y}^{4} & 3{y}^{2}+12x{y}^{3}\\end{aligned}]}_{{x}_{n}}^{-1}{[\\begin{aligned}xy-1 \\\\ {y}^{3}+3x{y}^{4}+3\\end{aligned}]}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=[\\begin{aligned}-1 \\\\ -1\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{[\\begin{aligned}y & x \\\\ 3{y}^{4} & 3{y}^{2}+12x{y}^{3}\\end{aligned}]}_{{x}_{0}}^{-1}{[\\begin{aligned}xy-1 \\\\ {y}^{3}+3x{y}^{4}+3\\end{aligned}]}_{{x}_{0}} \\\\  & =[\\begin{aligned}-1 \\\\ -1\\end{aligned}]-{[\\begin{aligned}-1 & -1 \\\\ 3(-1)^{4} & 3(-1)^{2}+12(-1)(-1)^{3}\\end{aligned}]}^{-1}[\\begin{aligned}(-1)(-1)-1 \\\\ (-1)^{3}+3(-1)(-1)^{4}+3\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -1\\end{aligned}]-{[\\begin{aligned}-1 & -1 \\\\ 3 & 15\\end{aligned}]}^{-1}[\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -1\\end{aligned}]-\\frac{1}{(-1)\\cdot 15-(-1)\\cdot 3}[\\begin{aligned}15 & 1 \\\\ -3 & -1\\end{aligned}][\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -1\\end{aligned}]+\\frac{1}{12}[\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{13}{12} \\\\ -\\frac{11}{12}\\end{aligned}] \\\\  & ≈[\\begin{aligned}-1.083 \\\\ -0.917\\end{aligned}],\\end{aligned}\n$$\n\nrounded to three decimal places." 13194139533409 17592186045585 true] [17592186204506 1068 #edb/ref 17592186202989 13194139533409 17592186045585 false] [17592186204506 1068 #edb/ref 17592186202990 13194139533409 17592186045585 false] [17592186204506 1068 #edb/ref 17592186292197 13194139533409 17592186045585 true] [17592186204506 1068 #edb/ref 17592186292267 13194139533409 17592186045585 true] [17592186204506 1070 #edb/ref 17592186045487 13194139533409 17592186045585 true] [17592186204506 1071 "Suppose we wish to find a zero of the function $f(x, y)$ in the region $[1, 2] \\cdot [0, 1]⊆R^{2}$, where\n$f(x, y) = \\begin{bmatrix}x^{2} + y - xy - 3 \\\\ x^{2} - x + y - 2\\end{bmatrix}$.\nCalculate the second iteration of the Newton-Raphson process that starts at $x_{0} = [1, 0]^{T}$ if the first iteration of the algorithm gives $x_{1} = [2, 1]^{T}$. Round your final answer to three decimal places (if needed).$x_{2} \\approx [$\n{{field-1}}\n$]$\n{{field-2}}" 13194139533409 17592186045585 false] [17592186204506 1071 "Suppose we wish to find a zero of the function $f(x,y)$ in the region $[1,2]\\times [0,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)=[\\begin{aligned}{x}^{2}+y-xy-3 \\\\ {x}^{2}-x+y-2\\end{aligned}].\n$$\n\nCalculate the second iteration of the Newton-Raphson process that starts at ${x}_{0}=[1,\\,0]^{T}$ if the first iteration of the algorithm gives ${x}_{1}=[2,\\,1]^{T}.$ Round your final answer to three decimal places (if needed).\n\n| ${x}_{2}≈[$ | {{field-1}} | $]$ |\n| --- | --- | --- |\n| {{field-2}} |  |  |" 13194139533409 17592186045585 true] [17592186204506 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $f:{R}^{n}\\to {R}^{n}$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{J}_{f}({x}_{n})]^{-1}f({x}_{n}),\n$$\n\nwhere ${J}_{f}({x}_{n})$ is the Jacobian of $f$ evaluated at ${x}_{n}.$\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}{J}_{f}(x) & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}+y-xy-3) & \\frac{∂}{∂y}({x}^{2}+y-xy-3) \\\\ \\frac{∂}{∂x}({x}^{2}-x+y-2) & \\frac{∂}{∂y}({x}^{2}-x+y-2)\\end{aligned}] \\\\  & =[\\begin{aligned}2x-y & 1-x \\\\ 2x-1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{[\\begin{aligned}2x-y & 1-x \\\\ 2x-1 & 1\\end{aligned}]}_{{x}_{n}}^{-1}{[\\begin{aligned}{x}^{2}+y-xy-3 \\\\ {x}^{2}-x+y-2\\end{aligned}]}_{{x}_{n}}.\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{[\\begin{aligned}2x-y & 1-x \\\\ 2x-1 & 1\\end{aligned}]}_{{x}_{1}}^{-1}{[\\begin{aligned}{x}^{2}+y-xy-3 \\\\ {x}^{2}-x+y-2\\end{aligned}]}_{{x}_{1}} \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}]-{[\\begin{aligned}2(2)-(1) & 1-(2) \\\\ 2(2)-1 & 1\\end{aligned}]}^{-1}[\\begin{aligned}(2)^{2}+(1)-(2)(1)-3 \\\\ (2)^{2}-(2)+(1)-2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}]-{[\\begin{aligned}3 & -1 \\\\ 3 & 1\\end{aligned}]}^{-1}[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}]-\\frac{1}{3\\cdot 1-(-1)\\cdot 3}[\\begin{aligned}1 & 1 \\\\ -3 & 3\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}]-\\frac{1}{6}[\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{11}{6} \\\\ \\frac{1}{2}\\end{aligned}] \\\\  & ≈[\\begin{aligned}1.833 \\\\ 0.5\\end{aligned}],\\end{aligned}\n$$\n\nrounded to three decimal places." 13194139533409 17592186045585 true] [17592186204508 1068 #edb/ref 17592186202997 13194139533409 17592186045585 false] [17592186204508 1068 #edb/ref 17592186202998 13194139533409 17592186045585 false] [17592186204508 1068 #edb/ref 17592186202999 13194139533409 17592186045585 false] [17592186204508 1068 #edb/ref 17592186292150 13194139533409 17592186045585 true] [17592186204508 1068 #edb/ref 17592186292225 13194139533409 17592186045585 true] [17592186204508 1068 #edb/ref 17592186292307 13194139533409 17592186045585 true] [17592186204508 1070 #edb/ref 17592186045485 13194139533409 17592186045585 true] [17592186204508 1071 "Suppose we wish to find a zero of the function $f(x, y)$ in the region $[0, 1] \\cdot [1, 2]⊆R^{2}$, where\n$f(x, y) = \\begin{bmatrix}x^{3}y - 5y + 8 \\\\ xy^{2} - 3\\end{bmatrix}$.\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[1, 1]^{T}$.$[$$3$$-4$$](x_{1} - x_{0}) = [$\n{{field-1}}\n$]$.\n{{field-2}}\n\n{{field-3}}\n$2$" 13194139533409 17592186045585 false] [17592186204508 1071 "Suppose we wish to find a zero of the function $f(x,y)$ in the region $[0,1]\\times [1,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)=[\\begin{aligned}{x}^{3}y-5y+8 \\\\ x{y}^{2}-3\\end{aligned}].\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[1,\\,1]^{T}.$\n\n| $[$ | $3$ | $-4$ | $]({x}_{1}-{x}_{0})\\,=[$ | {{field-1}} | $].$ |\n| --- | --- | --- | --- | --- | --- |\n| {{field-2}} | {{field-3}} | $2$ |  |  |  |" 13194139533409 17592186045585 true] [17592186204508 1074 "The Newton-Raphson method of finding the zeros of a multivariable function $f:{R}^{n}\\to {R}^{n}$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{J}_{f}({x}_{n})]^{-1}f({x}_{n}),\n$$\n\nwhere ${J}_{f}({x}_{n})$ is the Jacobian of $f$ evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be re-written as\n\n$$\n{J}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-f({x}_{n}).\n$$\n\nIn our case, the Jacobian is\n\n$$\n\\begin{aligned}{J}_{f}(x) & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{3}y-5y+8) & \\frac{∂}{∂y}({x}^{3}y-5y+8) \\\\ \\frac{∂}{∂x}(x{y}^{2}-3) & \\frac{∂}{∂y}(x{y}^{2}-3)\\end{aligned}] \\\\  & =[\\begin{aligned}3{x}^{2}y & {x}^{3}-5 \\\\ {y}^{2} & 2xy\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{[\\begin{aligned}3{x}^{2}y & {x}^{3}-5 \\\\ {y}^{2} & 2xy\\end{aligned}]}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{[\\begin{aligned}{x}^{3}y-5y+8 \\\\ x{y}^{2}-3\\end{aligned}]}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}{[\\begin{aligned}3{x}^{2}y & {x}^{3}-5 \\\\ {y}^{2} & 2xy\\end{aligned}]}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{[\\begin{aligned}{x}^{3}y-5y+8 \\\\ x{y}^{2}-3\\end{aligned}]}_{{x}_{0}} \\\\ [\\begin{aligned}3(1)^{2}(1) & (1)^{3}-5 \\\\ (1)^{2} & 2(1)(1)\\end{aligned}]({x}_{1}-{x}_{0}) & =-[\\begin{aligned}(1)^{3}(1)-5(1)+8 \\\\ (1)(1)^{2}-3\\end{aligned}] \\\\ [\\begin{aligned}3 & -4 \\\\ 1 & 2\\end{aligned}]({x}_{1}-{x}_{0}) & =[\\begin{aligned}-4 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" 13194139533409 17592186045585 true] [17592186204516 1068 #edb/ref 17592186203021 13194139533409 17592186045585 false] [17592186204516 1068 #edb/ref 17592186291809 13194139533409 17592186045585 true] [17592186204516 1070 #edb/ref 17592186045485 13194139533409 17592186045585 true] [17592186204516 1071 "Suppose we wish to find a critical point of the function $f(x, y)$ in the region $[0, 2] \\cdot [0, 2]⊆R^{2}$, where\n$f(x, y) = x^{2}y - 2x - y^{2} + 1$.\nCalculate one iteration of the Newton-Raphson process for optimization that starts at $x_{0} = [1, 1]^{T}$. Round your final answer to three decimal places (if needed).$x_{1} = [$\n$1.25$\n$]$\n{{field-1}}" 13194139533409 17592186045585 false] [17592186204516 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,2]\\times [0,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)={x}^{2}y-2x-{y}^{2}+1.\n$$\n\nCalculate one iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[1,\\,1]^{T}.$ Round your final answer to three decimal places (if needed).\n\n| ${x}_{1}=[$ | $1.25$ | $]$ |\n| --- | --- | --- |\n| {{field-1}} |  |  |" 13194139533409 17592186045585 true] [17592186204516 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}y-2x-{y}^{2}+1) \\\\ \\frac{∂}{∂y}({x}^{2}y-2x-{y}^{2}+1)\\end{aligned}] \\\\  & =[\\begin{aligned}2xy-2 \\\\ {x}^{2}-2y\\end{aligned}],\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =[\\begin{aligned}\\frac{∂}{∂x}(2xy-2) & \\frac{∂}{∂x}({x}^{2}-2y) \\\\ \\frac{∂}{∂y}(2xy-2) & \\frac{∂}{∂y}({x}^{2}-2y)\\end{aligned}] \\\\  & =[\\begin{aligned}2y & 2x \\\\ 2x & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{[\\begin{aligned}2y & 2x \\\\ 2x & -2\\end{aligned}]}_{{x}_{n}}^{-1}{[\\begin{aligned}2xy-2 \\\\ {x}^{2}-2y\\end{aligned}]}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{[\\begin{aligned}2y & 2x \\\\ 2x & -2\\end{aligned}]}_{{x}_{0}}^{-1}{[\\begin{aligned}2xy-2 \\\\ {x}^{2}-2y\\end{aligned}]}_{{x}_{0}} \\\\  & =[\\begin{aligned}1 \\\\ 1\\end{aligned}]-{[\\begin{aligned}2(1) & 2(1) \\\\ 2(1) & -2\\end{aligned}]}^{-1}[\\begin{aligned}2(1)(1)-2 \\\\ (1)^{2}-2(1)\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1\\end{aligned}]-{[\\begin{aligned}2 & 2 \\\\ 2 & -2\\end{aligned}]}^{-1}[\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned