}_{2}=2 \\\\ 2{x}_{1}-{x}_{2}=5 \\\\ 3{x}_{1}+6{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -1 & 2 \\\\ 2 & -1 & 5 \\\\ 3 & 6 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 3 & 6 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 0 & 9 & k-6\\end{aligned}] & {R}_{3} & :={R}_{3}-9{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & k-15\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-15.$ Therefore, the system has a solution only if\n\n$$\n0=k-15\\,⇒\\,k=15.\n$$" 13194139533427 17592186045585 true] [17592186342235 1068 #edb/ref 17592186341781 13194139533427 17592186045585 true] [17592186342235 1069 "q-74557" 13194139533427 17592186045585 true] [17592186342235 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342235 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 7\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ 5 \\\\ k\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342235 1072 #uuid "6c201285-f84a-584f-bd1b-b67204ad9977" 13194139533427 17592186045585 true] [17592186342235 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ -4\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 7\\end{aligned}] & =[\\begin{aligned}3 \\\\ 5 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}=3 \\\\ {x}_{2}=5 \\\\ -4{x}_{1}+7{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -1 & 3 \\\\ 0 & 1 & 5 \\\\ -4 & 7 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 3 \\\\ 0 & 1 & 5 \\\\ 0 & 3 & k+12\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 3 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & k-3\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-3.$ Therefore, the system has a solution only if\n\n$$\n0=k-3\\,⇒\\,k=3.\n$$" 13194139533427 17592186045585 true] [17592186342236 1068 #edb/ref 17592186341715 13194139533427 17592186045585 true] [17592186342236 1069 "q-74558" 13194139533427 17592186045585 true] [17592186342236 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342236 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 3 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-4 \\\\ -5 \\\\ -4\\end{aligned}],\\,b=[\\begin{aligned}0 \\\\ 1 \\\\ k\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342236 1072 #uuid "cef0a842-c20f-55db-9989-525f1aca72a5" 13194139533427 17592186045585 true] [17592186342236 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}2 \\\\ 3 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}-4 \\\\ -5 \\\\ -4\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}2{x}_{1}-4{x}_{2}=0 \\\\ 3{x}_{1}-5{x}_{2}=1 \\\\ 2{x}_{1}-4{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -4 & 0 \\\\ 3 & -5 & 1 \\\\ 2 & -4 