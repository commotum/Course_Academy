cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{csc}⁡\\theta +\\operatorname{cos}⁡\\theta -\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta +\\operatorname{cos}⁡\\theta -\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342239 1068 #edb/ref 17592186341676 13194139533427 17592186045585 true] [17592186342239 1069 "q-74575" 13194139533427 17592186045585 true] [17592186342239 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342239 1071 "Simplify $\\frac{{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}.$" 13194139533427 17592186045585 true] [17592186342239 1072 #uuid "ea168c27-f5a7-59a8-ab75-3dcd4e8a5c95" 13194139533427 17592186045585 true] [17592186342239 1074 "First, let's recall the following identity: \n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -1} & =\\frac{{csc}^{2}⁡\\theta -1}{\\operatorname{csc}⁡\\theta -1} \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +1)(\\operatorname{csc}⁡\\theta -1)}{\\operatorname{csc}⁡\\theta -1} \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +1)\\cancel{(\\operatorname{csc}⁡\\theta -1)}}{\\cancel{\\operatorname{csc}⁡\\theta -1}} \\\\  & =\\operatorname{csc}⁡\\theta +1.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342240 1068 #edb/ref 17592186341816 13194139533427 17592186045585 true] [17592186342240 1069 "q-74578" 13194139533427 17592186045585 true] [17592186342240 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342240 1071 "Simplify $\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta .$" 13194139533427 17592186045585 true] [17592186342240 1072 #uuid "33f5d56a-c4c8-5821-9c1c-b1084abe2a12" 13194139533427 17592186045585 true] [17592186342240 1074 "First, let's recall the following identity: \n\n$$\n1={csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta \n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta  & =\\frac{{csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }-\\operatorname{cot}⁡\\theta  \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )\\,\\cancel{(\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta )}}{\\cancel{\\operatorname{csc}⁡\\theta -\\operatorname{cot}⁡\\theta }}-\\operatorname{cot}⁡\\theta  \\\\  & =(\\operatorname{csc}⁡\\theta +\\operatorname{cot}⁡\\theta )-\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342241 1068 #edb/ref 17592186341700 13194139533427 17592186045585 true] [17592186342241 1069 "q-74579" 13194139533427 17592186045585 true] [17592186342241 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342241 1071 "Simplify $\\frac{\\operatorname{csc}⁡\\theta +1}{{cot}^{2}⁡\\theta }.$" 13194139533427 17592186045585 true] [17592186342241 1072 #uuid "7e48e65b-0fce-5299-ad3b-522922f59cff" 13194139533427 17592186045585 true] [17592186342241 1074 "First, let's recall the following identity: \n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{\\operatorname{csc}⁡\\theta +1}{{cot}^{2}⁡\\theta } & =\\frac{\\operatorname{csc}⁡\\theta +1}{{csc}^{2}⁡\\theta -1} \\\\  & =\\frac{\\operatorname{csc}⁡\\theta +1}{(\\operatorname{csc}⁡\\theta +1)(\\operatorname{csc}⁡\\theta -1)} \\\\  & =\\frac{\\cancel{\\operatorname{csc}⁡\\theta +1}}{\\cancel{(\\operatorname{csc}⁡\\theta +1)}(\\operatorname{csc}⁡\\theta -1)} \\\\  & =\\frac{1}{\\operatorname{csc}⁡\\theta -1}.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342242 1068 #edb/ref 17592186341594 13194139533427 17592186045585 true] [17592186342242 1069 "q-74580" 13194139533427 17592186045585 true] [17592186342242 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342242 1071 "Simplify $\\frac{2\\operatorname{csc}⁡\\theta -2}{{cot}^{2}⁡\\theta }.$" 13194139533427 17592186045585 true] [17592186342242 1072 #uuid "8c7806b4-cfa6-5e4a-a2f7-87bfd93f2721" 13194139533427 17592186045585 true] [17592186342242 1074 "First, let's recall the following identity: \n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{2\\operatorname{csc}⁡\\theta -2}{{cot}^{2}⁡\\theta } & =\\frac{2(\\operatorname{csc}⁡\\theta -1)}{{csc}^{2}⁡\\theta -1} \\\\  & =\\frac{2(\\operatorname{csc}⁡\\theta -1)}{(\\operatorname{csc}⁡\\theta +1)(\\operatorname{csc}⁡\\theta -1)} \\\\  & =\\frac{2\\cancel{\\operatorname{csc}⁡\\theta -1}}{\\cancel{(\\operatorname{csc}⁡\\theta -1)}(\\operatorname{csc}⁡\\theta +1)} \\\\  & =\\frac{2}{\\operatorname{csc}⁡\\theta +1}.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342243 1068 #edb/ref 17592186341569 13194139533427 17592186045585 true] [17592186342243 1069 "q-74594" 13194139533427 17592186045585 true] [17592186342243 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342243 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}],\\,b=[\\begin{aligned}9 \\\\ -5 \\\\ k\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342243 1072 #uuid "e12a2efc-9d88-56c5-96b5-ec530d76269d" 13194139533427 17592186045585 true] [17592186342243 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 2 \\\\ -1\\end{aligned}] & =[\\begin{aligned}9 \\\\ -5 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{2}=9 \\\\ 3{x}_{1}+2{x}_{2}=-5 \\\\ 2{x}_{1}-{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 9 \\\\ 3 & 2 & -5 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 8 & -32 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 8 & -32 \\\\ 0 & 3 & k-18\\end{aligned}] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 1 & -4 \\\\ 0 & 3 & k-18\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 9 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & k-6\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-6.$ Therefore, the system has a solution only if\n\n$$\n0=k-6\\,⇒\\,k=6.\n$$" 13194139533427 17592186045585 true] [17592186342244 1068 #edb/ref 17592186341728 13194139533427 17592186045585 true] [17592186342244 1069 "q-74596" 13194139533427 17592186045585 true] [17592186342244 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342244 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}6 \\\\ -2 \\\\ 10\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-8 \\\\ 3 \\\\ -12\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ -9 \\\\ k\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342244 1072 #uuid "329f79c0-9230-5c7a-8435-3cce24f63578" 13194139533427 17592186045585 true] [17592186342244 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}6 \\\\ -2 \\\\ 10\\end{aligned}]+{x}_{2}[\\begin{aligned}-8 \\\\ 3 \\\\ -12\\end{aligned}] & =[\\begin{aligned}-3 \\\\ -9 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}6{x}_{1}-8{x}_{2}=-3 \\\\ -2{x}_{1}+3{x}_{2}=-9 \\\\ 10{x}_{1}-12{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}6 & -8 & -3 \\\\ -2 & 3 & -9 \\\\ 10 & -12 & k\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 3 & -9 \\\\ 6 & -8 & -3 \\\\ 10 & -12 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 10 & -12 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼[\\begin{aligned}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 0 & 3 & k-45\\end{aligned}] & {R}_{3} & :={R}_{3}-3{R}_{2} \\\\  & ∼[\\begin{aligned}-2 & 3 & -9 \\\\ 0 & 1 & -30 \\\\ 0 & 0 & k+45\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+45.$ Therefore, the system has a solution only if\n\n$$\n0=k+45\\,⟹\\,k=-45.\n$$" 13194139533427 17592186045585 true] [17592186342245 1068 #edb/ref 17592186341743 13194139533427 17592186045585 true] [17592186342245 1069 "q-74597" 13194139533427 17592186045585 true] [17592186342245 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342245 1071 "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342245 1072 #uuid "d5c520f5-835e-5cc8-a0fb-53c3d5239f5d" 13194139533427 17592186045585 true] [17592186342245 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}5{x}_{1}+{x}_{2}=-3 \\\\ {x}_{1}-{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 & 1 & -3 \\\\ 1 & -1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 5 & 1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{2} & :=\\frac{1}{6}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k+4\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+4.$ Therefore, the system has a solution only if\n\n$$\n0=k+4\\,⇒\\,k=-4.\n$$" 13194139533427 17592186045585 true] [17592186342246 1068 #edb/ref 17592186341738 13194139533427 17592186045585 true] [17592186342246 1069 "q-74598" 13194139533427 17592186045585 true] [17592186342246 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342246 1071 "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨-1,2,3⟩$, $c=⟨3,-7,-9⟩$, and  $u=⟨2,-3,-6⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" 13194139533427 17592186045585 true] [17592186342246 1072 #uuid "55c44296-8bfb-53c1-b37c-07eab30d99a8" 13194139533427 17592186045585 true] [17592186342246 1074 "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ -7 \\\\ -9\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ -6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s+3t=2 \\\\ 2s-7t=-3 \\\\ 3s-9t=-6\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 3 & 2 \\\\ 2 & -7 & -3 \\\\ 3 & -9 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & -1 & 1 \\\\ 3 & -9 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s+3t=2 \\\\ -t=1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-t=1\\,⟹\\,t=-1.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+3t & =2 \\\\ -s+3(-1) & =2 \\\\ -s & =5 \\\\ s & =-5.\\end{aligned}\n$$\n\nSince we found a solution $s=-5,\\,t=-1,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-5b-c.\n$$\n\nFinally, $s\\cdot t=(-5)\\cdot (-1)=5.$" 13194139533427 17592186045585 true] [17592186342247 1068 #edb/ref 17592186341534 13194139533427 17592186045585 true] [17592186342247 1069 "q-74599" 13194139533427 17592186045585 true] [17592186342247 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342247 1071 "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨-1,4,3⟩$, $c=⟨1,-6,-7⟩$, and  $u=⟨1,-10,-15⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" 13194139533427 17592186045585 true] [17592186342247 1072 #uuid "d6c3f74b-5a27-519e-8d22-1736702759dc" 13194139533427 17592186045585 true] [17592186342247 1074 "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 4 \\\\ 3\\end{aligned}]+t[\\begin{aligned}1 \\\\ -6 \\\\ -7\\end{aligned}] & =[\\begin{aligned}1 \\\\ -10 \\\\ -15\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-s+t=1 \\\\ 4s-6t=-10 \\\\ 3s-7t=-15\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 1 & 1 \\\\ 4 & -6 & -10 \\\\ 3 & -7 & -15\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 3 & -7 & -15\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 0 & -4 & -12\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{2} \\\\  & ∼[\\begin{aligned}-1 & 1 & 1 \\\\ 0 & -2 & -6 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}-s+t=1 \\\\ -2t=-6 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-2t=-6\\,⟹\\,t=3.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+t & =1 \\\\ -s+3 & =1 \\\\ -s & =-2 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=3,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b+3c.\n$$\n\nFinally, $s\\cdot t=2\\cdot 3=6.$" 13194139533427 17592186045585 true] [17592186342248 1068 #edb/ref 17592186341794 13194139533427 17592186045585 true] [17592186342248 1069 "q-74601" 13194139533427 17592186045585 true] [17592186342248 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342248 1071 "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+2y-z=3 \\\\  & -2x-3y+2z=0 \\\\  & 2x+3y-z=3\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." 13194139533427 17592186045585 true] [17592186342248 1072 #uuid "a1acb1c2-35d8-56f8-bcad-3b6d0c4f6e46" 13194139533427 17592186045585 true] [17592186342248 1074 "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -2 & -3 & 2 & 0 \\\\ 2 & 3 & -1 & 3\\end{aligned}].\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -2 & -3 & 2 & 0 \\\\ 2 & 3 & -1 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 2 & 3 & -1 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & -1 & 1 & -3\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 0 & 6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -6 \\\\ 0 & 1 & 0 & 6 \\\\ 0 & 0 & 1 & 3\\end{aligned}].\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342249 1068 #edb/ref 17592186341661 13194139533427 17592186045585 true] [17592186342249 1069 "q-74602" 13194139533427 17592186045585 true] [17592186342249 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342249 1071 "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨1,7,-6⟩$, $c=⟨-2,-10,12⟩$, and  $u=⟨2,11,-12⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" 13194139533427 17592186045585 true] [17592186342249 1072 #uuid "dcb29558-7233-531f-8a7f-7d0b5b7173b6" 13194139533427 17592186045585 true] [17592186342249 1074 "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ 7 \\\\ -6\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -10 \\\\ 12\\end{aligned}] & =[\\begin{aligned}2 \\\\ 11 \\\\ -12\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s-2t=2 \\\\ 7s-10t=11 \\\\ -6s+12t=-12\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 2 \\\\ 7 & -10 & 11 \\\\ -6 & 12 & -12\\end{aligned}] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 4 & -3 \\\\ -6 & 12 & -12\\end{aligned}] & {R}_{3} & :={R}_{3}+6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & 4 & -3 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}s-2t=2 \\\\ 4t=-3 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n4t=-3\\,⟹\\,t=-\\frac{3}{4}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-2t & =2 \\\\ s-2(-\\frac{3}{4}) & =2 \\\\ s+\\frac{3}{2} & =2 \\\\ s & =2-\\frac{3}{2} \\\\ s & =\\frac{1}{2}.\\end{aligned}\n$$\n\nSince we found a solution $s=\\frac{1}{2},\\,t=-\\frac{3}{4},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=\\frac{1}{2}b-\\frac{3}{4}c.\n$$\n\nFinally, $s\\cdot t=\\frac{1}{2}\\cdot (-\\frac{3}{4})=-\\frac{3}{8}.$" 13194139533427 17592186045585 true]] :edb/tempids {"answer-001b03a5-87c0-50e2-80c7-d0bda161da50" 17592186339141 "answer-00d5e468-bffd-5584-a784-ecfb449532a1" 17592186339142 "answer-00da50d5-06aa-555b-b932-f57f9775becc" 17592186339143 "answer-00ea0212-0c8f-50de-a9e9-986f267bdb5a" 17592186339144 "answer-0122f81d-14c1-5cc7-89e6-42dfd3041d3e" 17592186339145 "answer-0132169e-f42a-5220-a69a-7c30d86438b6" 17592186339146 "answer-016e7d36-e0da-51ad-a618