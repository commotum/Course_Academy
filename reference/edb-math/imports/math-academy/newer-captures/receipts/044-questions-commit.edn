& 0 & -8 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & -8 & 0\\end{aligned}] & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 & 2 & 0 & 3 \\\\ 0 & 0 & 3 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0 & 8 & -1 \\\\ 0 & 0 & 0 & 0 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $2$nd, $3$rd, $5$th and $6$th columns." 13194139533427 17592186045585 true] [17592186342053 1068 #edb/ref 17592186341561 13194139533427 17592186045585 true] [17592186342053 1069 "q-73642" 13194139533427 17592186045585 true] [17592186342053 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342053 1071 "Find the inverse of the elementary matrix \n$G=[\\begin{aligned}-\\frac{3}{2} & 0 \\\\ 0 & 1\\end{aligned}].$" 13194139533427 17592186045585 true] [17592186342053 1072 #uuid "ffb15942-22d3-5f36-91a0-c39f9d76e946" 13194139533427 17592186045585 true] [17592186342053 1074 "We write down $G$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[G\\,|\\,I\\,] & =[\\begin{aligned}-\\frac{3}{2} & 0 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:=-\\frac{2}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -\\frac{2}{3} & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{G}^{-1}=[\\begin{aligned}-\\frac{2}{3} & 0 \\\\ 0 & 1\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342054 1068 #edb/ref 17592186341741 13194139533427 17592186045585 true] [17592186342054 1069 "q-73646" 13194139533427 17592186045585 true] [17592186342054 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342054 1071 "Find the inverse of the elementary matrix \n$K=[\\begin{aligned}1 & 0 \\\\ 8 & 1\\end{aligned}].$" 13194139533427 17592186045585 true] [17592186342054 1072 #uuid "1ae3d569-e0d6-5d3d-9c5e-94e5b9fd437b" 13194139533427 17592186045585 true] [17592186342054 1074 "We write down $K$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[K\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 8 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+(-8){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -8 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe inverse is obtained on the right-hand side of our big matrix after the transformation. Therefore, \n\n$$\n{K}^{-1}=[\\begin{aligned}1 & 0 \\\\ -8 & 1\\end{aligned}].\n$$" 13194139533427 17592186045585 true] [17592186342055 1068 #edb/ref 17592186341782 13194139533427 17592186045585 true] [17592186342055 1069 "q-73651" 13194139533427 17592186045585 true] [17592186342055 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342055 1071 "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & -\\frac{1}{4}\\end{aligned}].\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342055 1072 #uuid "cd46d64d-aaae-5435-b750-329b869c363c" 13194139533427 17592186045585 true] [17592186342055 1074 "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -\\frac{1}{4} & 0 & 1\\end{aligned}] &  & {R}_{2}:=(-4){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & 0 & -4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{2}^{-1} & =[\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 3 & -4\\end{aligned}]\n$$" 13194139533427 17592186045585 true] [17592186342056 1068 #edb/ref 17592186341536 13194139533427 17592186045585 true] [17592186342056 1069 "q-73653" 13194139533427 17592186045585 true] [17592186342056 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342056 1071 "What is the value of ${\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x?$" 13194139533427 17592186045585 true] [17592186342056 1072 #uuid "67b1cc06-52db-594d-af64-fc96a02b017c" 13194139533427 17592186045585 true] [17592186342056 1074 "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{4{log}_{4}⁡x}{x}\\,\\text{d}x & =4{\\int }_{1}^{4}{log}_{4}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =4{\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =4\\operatorname{ln}⁡4\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =2\\operatorname{ln}⁡4\\cdot (1-0) \\\\  & =2\\operatorname{ln}⁡4 \\\\  & =4\\operatorname{ln}⁡2\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342057 1068 #edb/ref 17592186341404 13194139533427 17592186045585 true] [17592186342057 1069 "q-73655" 13194139533427 17592186045585 true] [17592186342057 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342057 1071 "What is the value of ${\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x?$" 13194139533427 17592186045585 true] [17592186342057 1072 #uuid "46fc463a-0e37-5adb-8efe-657661cd9784" 13194139533427 17592186045585 true] [17592186342057 1074 "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $16$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x & =2{\\int }_{2}^{4}\\frac{1}{{log}_{4}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡4\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡({2}^{2})\\operatorname{ln}⁡2 \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342058 1068 #edb/ref 17592186341449 13194139533427 17592186045585 true] [17592186342058 1069 "q-73656" 13194139533427 17592186045585 true] [17592186342058 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342058 1071 "What is the value of ${\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x?$" 13194139533427 17592186045585 true] [17592186342058 1072 #uuid "3ddbff7e-d3cb-563f-8731-6916af8ccc56" 13194139533427 17592186045585 true] [17592186342058 1074 "Let $u={log}_{8}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡8}\\,⟹\\,\\operatorname{ln}⁡8\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $8$ | $64$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{8}^{64}\\frac{1}{x\\sqrt{{log}_{8}⁡x}}\\,\\text{d}x & ={\\int }_{8}^{64}\\frac{1}{\\sqrt{{log}_{8}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡8\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8{\\int }_{1}^{2}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡8(2\\sqrt{u}){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡8(\\sqrt{2}-\\sqrt{1}) \\\\  & =2(\\sqrt{2}-1)\\operatorname{ln}⁡8\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342059 1068 #edb/ref 17592186341581 13194139533427 17592186045585 true] [17592186342059 1069 "q-73658" 13194139533427 17592186045585 true] [17592186342059 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342059 1071 "What is the value of ${\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x?$" 13194139533427 17592186045585 true] [17592186342059 1072 #uuid "f9fa12f0-8b86-59fd-acb9-b45aae5f88d9" 13194139533427 17592186045585 true] [17592186342059 1074 "Let $u={log}_{7}⁡(\\frac{x}{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡7}\\cdot \\frac{1}{3}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $21$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x & ={\\int }_{3}^{21}{log}_{7}⁡(\\frac{x}{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot (1-0) \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342060 1068 #edb/ref 17592186341749 13194139533427 17592186045585 true] [17592186342060 1069 "q-73662" 13194139533427 17592186045585 true] [17592186342060 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342060 1071 "$\\int (4x-1){e}^{2{x}^{2}-x}\\,\\text{d}x=$" 13194139533427 17592186045585 true] [17592186342060 1072 #uuid "775fc84f-28a7-5997-a00c-a935e8817172" 13194139533427 17592186045585 true] [17592186342060 1074 "Let's introduce the new variable $u=2{x}^{2}-x.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4x-1\\,⟹\\,\\text{d}u=(4x-1)\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int (4x-1){e}^{2{x}^{2}-x}\\,\\text{d}x & =\\int {e}^{2{x}^{2}-x}\\cdot (4x-1)\\text{d}x \\\\  & =\\int {e}^{u}\\,\\text{d}u \\\\  & ={e}^{2{x}^{2}-x}+C\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342061 1068 #edb/ref 17592186341491 13194139533427 17592186045585 true] [17592186342061 1069 "q-73664" 13194139533427 17592186045585 true] [17592186342061 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342061 1071 "$\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\,\\text{d}x=$" 13194139533427 17592186045585 true] [17592186342061 1072 #uuid "78eb8eca-5e7f-5422-8275-d4d9278c8f6b" 13194139533427 17592186045585 true] [17592186342061 1074 "Let's introduce the new variable $u=5-2{x}^{3}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-6{x}^{2}\\,⟹\\,-\\text{d}u=6{x}^{2}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 6{x}^{2}{e}^{5-2{x}^{3}}\\,\\text{d}x & =\\int {e}^{5-2{x}^{3}}\\cdot 6{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\,(-\\text{d}u) \\\\  & =-\\int {e}^{u}\\,\\text{d}u \\\\  & =-{e}^{u}+C \\\\  & =-{e}^{5-2{x}^{3}}+C.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342062 1068 #edb/ref 17592186341687 13194139533427 17592186045585 true] [17592186342062 1069 "q-73665" 13194139533427 17592186045585 true] [17592186342062 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342062 1071 "Calculate the integral $\\int 4x\\,{4}^{4{x}^{2}-3}\\,\\text{d}x.$" 13194139533427 17592186045585 true] [17592186342062 1072 #uuid "d173a2c0-da03-5423-8e61-e66122941f23" 13194139533427 17592186045585 true] [17592186342062 1074 "Let's introduce the new variable $u=4{x}^{2}-3.$ Differentiating gives \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8x\\,⟹\\,\\frac{1}{8}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 4x\\,{4}^{4{x}^{2}-3}\\,\\text{d}x & =4\\int {4}^{4{x}^{2}-3}\\cdot x\\,\\text{d}x \\\\  & =4\\int {4}^{u}\\cdot \\frac{1}{8}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{{4}^{u}}{2\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{4{x}^{2}-3}}{2\\operatorname{ln}⁡4}+C.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342063 1068 #edb/ref 17592186341649 13194139533427 17592186045585 true] [17592186342063 1069 "q-73669" 13194139533427 17592186045585 true] [17592186342063 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342063 1071 "Calculate the integral $\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x.$" 13194139533427 17592186045585 true] [17592186342063 1072 #uuid "4d8e2bdb-04c0-5bb8-8174-6e672a971ff9" 13194139533427 17592186045585 true] [17592186342063 1074 "Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={2}^{x}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{x}\\,\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x & =\\int 2\\cdot {2}^{x}\\sqrt{{2}^{x}-5}\\,\\text{d}x \\\\  & =2\\int \\sqrt{{2}^{x}-5}\\cdot {2}^{x}\\,\\text{d}x \\\\  & =2\\int \\sqrt{u}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342064 1068 #edb/ref 17592186341761 13194139533427 17592186045585 true] [17592186342064 1069 "q-73674" 13194139533427 17592186045585 true] [17592186342064 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342064 1071 "Calculate the integral $\\int \\frac{y\\operatorname{cos}⁡({y}^{2})}{\\operatorname{sin}⁡({y}^{2})}\\,\\text{d}y.$" 13194139533427 17592186045585 true] [17592186342064 1072 #uuid "0b965c69-7854-507b-827e-0b6fbbb52fef" 13194139533427 17592186045585 true] [17592186342064 1074 "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sin}⁡({y}^{2}))=2y\\operatorname{cos}⁡({y}^{2}).\n$$\n\nSo, let $u=\\operatorname{sin}⁡({y}^{2}).$ Differentiating, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=2y\\operatorname{cos}⁡({y}^{2})\\,⟹\\,\\frac{1}{2}\\,\\text{d}u=y\\operatorname{cos}⁡({y}^{2})\\,\\text{d}y.\n$$\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{y\\operatorname{cos}⁡({y}^{2})}{\\operatorname{sin}⁡({y}^{2})}\\,\\text{d}y & =\\int \\frac{1}{\\operatorname{sin}⁡({y}^{2})}\\cdot (y\\operatorname{cos}⁡({y}^{2}))\\,\\text{d}y \\\\  & =\\int \\frac{1}{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{sin}⁡({y}^{2})|+C\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342065 1068 #edb/ref 17592186341537 13194139533427 17592186045585 true] [17592186342065 1069 "q-73686" 13194139533427 17592186045585 true] [17592186342065 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342065 1071 "Consider the system of equations \n\n$$\n{\\begin{aligned}3y-2z=4 \\\\ -2x-3y=-6 \\\\ x+4z=1.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=\\frac{{D}_{y}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{y}=$" 13194139533427 17592186045585 true] [17592186342065 1072 #uuid "dceddfaf-57df-5ca9-a79f-af2de59df96b" 13194139533427 17592186045585 true] [17592186342065 1074 "We are given the system\n\n$$\n{\\begin{aligned}0x+3y+(-2)z=4 \\\\ (-2)x+(-3)y+0z=-6 \\\\ 1x+0y+4z=1.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}0 & 3 & -2 \\\\ -2 & -3 & 0 \\\\ 1 & 0 & 4\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{y}$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{y}=|\\begin{aligned}0 & 4 & -2 \\\\ -2 & -6 & 0 \\\\ 1 & 1 & 4\\end{aligned}|.\n$$" 13194139533427 17592186045585 true] [17592186342066 1068 #edb/ref 17592186341584 13194139533427 17592186045585 true] [17592186342066 1069 "q-73690" 13194139533427 17592186045585 true] [17592186342066 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342066 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}x+y+3z=-2 \\\\ 2x-y=3 \\\\ -x-2y+z=6\\end{aligned}\n$$\n\nGiven that the determinant of the coefficient matrix is equal to $-18,$ then $x=$" 13194139533427 17592186045585 true] [17592186342066 1072 #uuid "71e182d9-57b6-5440-abac-bce2707f571b" 13194139533427 17592186045585 true] [17592186342066 1074 "First, let's rewrite the system to reveal the coefficients:\n\n$$\n{\\begin{aligned}1x+1y+3z=-2 \\\\ 2x+(-1)y+0z=3 \\\\ (-1)x+(-2)y+1z=6.\\end{aligned}\n$$\n\nWe start by writing the determinant of the coefficients matrix, as follows:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & 1 & 3 \\\\ 2 & -1 & 0 \\\\ -1 & -2 & 1\\end{aligned}|=-18.\\end{aligned}\n$$\n\nNow, to find ${D}_{x}$, we replace the first column by the right-hand side of the system, and calculate the determinant:\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-2 & 1 & 3 \\\\ 3 & -1 & 0 \\\\ 6 & -2 & 1\\end{aligned}| & =-2\\cdot |\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}3 & 0 \\\\ 6 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -1 \\\\ 6 & -2\\end{aligned}| \\\\  & =-2(-1-0)-(3-0)-(-6+6) \\\\  & =2-3-0 \\\\  & =-1.\\end{aligned}\n$$\n\nFinally, applying Cramer's rule, we get\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D}=\\frac{-1}{-18}=\\frac{1}{18}.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342067 1068 #edb/ref 17592186341591 13194139533427 17592186045585 true] [17592186342067 1069 "q-73694" 13194139533427 17592186045585 true] [17592186342067 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342067 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+3y+z=3 \\\\ x-z=k \\\\ x-2y+2z=1\\end{aligned}\n$$\n\nGiven that $z=2$ and that the determinant of the coefficient matrix is equal to $-15,$ find the value of $k.$" 13194139533427 17592186045585 true] [17592186342067 1072 #uuid "209a5a36-a432-55a5-bdf5-16c608d27113" 13194139533427 17592186045585 true] [17592186342067 1074 "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 1 \\\\ 1 & 0 & -1 \\\\ 1 & -2 & 2\\end{aligned}|=-15\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $z$ is given by $z=\\frac{{D}_{z}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{z}=|\\begin{aligned}2 & 3 & 3 \\\\ 1 & 0 & k \\\\ 1 & -2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}0 & k \\\\ -2 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}1 & k \\\\ 1 & 1\\end{aligned}|+3\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & -2\\end{aligned}| \\\\  & =2(0+2k)-3(1-k)+3(-2-0) \\\\  & =4k-3+3k-6 \\\\  & =7k-9.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nz=\\frac{{D}_{z}}{D}=\\frac{7k-9}{-15}.\n$$\n\nFrom the problem statement, we know that $z=2.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{7k-9}{-15} & =2 \\\\ 7k-9 & =-30 \\\\ 7k & =-21 \\\\ k & =-3.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342068 1068 #edb/ref 17592186341541 13194139533427 17592186045585 true] [17592186342068 1069 "q-73697" 13194139533427 17592186045585 true] [17592186342068 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342068 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}x-y+5z=-1 \\\\ 2x+3y+2z=0 \\\\ x+4y=k\\end{aligned}\n$$\n\nGiven that $x=-4$ and that the determinant of the coefficient matrix is equal to $15,$ find the value of $k.$" 13194139533427 17592186045585 true] [17592186342068 1072 #uuid "0e7d5f36-83df-59b5-b06e-da52c530f2e8" 13194139533427 17592186045585 true] [17592186342068 1074 "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}1 & -1 & 5 \\\\ 2 & 3 & 2 \\\\ 1 & 4 & 0\\end{aligned}|=15\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x}=|\\begin{aligned}-1 & -1 & 5 \\\\ 0 & 3 & 2 \\\\ k & 4 & 0\\end{aligned}| & =-1\\cdot |\\begin{aligned}3 & 2 \\\\ 4 & 0\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & 2 \\\\ k & 0\\end{aligned}|+5\\cdot |\\begin{aligned}0 & 3 \\\\ k & 4\\end{aligned}| \\\\  & =-(0-8)+(0-2k)+5(0-3k) \\\\  & =8-2k-15k \\\\  & =8-17k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nx=\\frac{{D}_{x}}{D}=\\frac{8-17k}{15}.\n$$\n\nFrom the problem statement, we know that $x=-4.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}\\frac{8-17k}{15} & =-4 \\\\ 8-17k & =-60 \\\\ -17k & =-68 \\\\ k & =4.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342069 1068 #edb/ref 17592186341395 13194139533427 17592186045585 true] [17592186342069 1069 "q-73698" 13194139533427 17592186045585 true] [17592186342069 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342069 1071 "Let $⟨x,y,z⟩$ be the unique solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+3y+2z=k \\\\ x+y=-1 \\\\ y+z=2\\end{aligned}\n$$\n\nGiven that $y=-5$ and that the determinant of the coefficient matrix is equal to $1,$ find the value of $k.$" 13194139533427 17592186045585 true] [17592186342069 1072 #uuid "606431ba-b0b3-579d-ac68-261fcff208d1" 13194139533427 17592186045585 true] [17592186342069 1074 "First, let's write the determinant of the coefficients matrix:\n\n$$\n\\begin{aligned}D=|\\begin{aligned}2 & 3 & 2 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}|=1\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y}=|\\begin{aligned}2 & k & 2 \\\\ 1 & -1 & 0 \\\\ 0 & 2 & 1\\end{aligned}| & =2\\cdot |\\begin{aligned}-1 & 0 \\\\ 2 & 1\\end{aligned}|-k\\cdot |\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}| \\\\  & =2(-1-0)-k(1-0)+2(2-0) \\\\  & =-2-k+4 \\\\  & =2-k.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\ny=\\frac{{D}_{y}}{D}=\\frac{2-k}{1}=2-k.\n$$\n\nFrom the problem statement, we know that $y=-5.$ So, we can solve for $k$ as follows:\n\n$$\n\\begin{aligned}2-k & =-5 \\\\ k & =7.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342070 1068 #edb/ref 17592186341709 13194139533427 17592186045585 true] [17592186342070 1069 "q-73712" 13194139533427 17592186045585 true] [17592186342070 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342070 1071 "$\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\text{d}x=$" 13194139533427 17592186045585 true] [17592186342070 1072 #uuid "279b83c3-9e48-526a-b453-9a5fa23b12aa" 13194139533427 17592186045585 true] [17592186342070 1074 "Let's rewrite our integral as follows:   \n\n$$\n\\begin{aligned}\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =\\frac{8}{3}\\int \\frac{1}{\\sqrt{4\\cdot (1-{x}^{2}/4)}}\\,\\text{d}x \\\\  & =\\frac{8}{3}\\cdot \\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{x}^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$ \n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\n \n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x \\\\  & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (2\\,\\text{d}u) \\\\  & =\\frac{8}{3}\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{8}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C\\end{aligned}\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342071 1068 #edb/ref 17592186341424 13194139533427 17592186045585 true] [17592186342071 1069 "q-73714" 13194139533427 17592186045585 true] [17592186342071 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342071 1071 "$\\int \\frac{3}{36+{x}^{2}}\\,\\text{d}x=$" 13194139533427 17592186045585 true] [17592186342071 1072 #uuid "93802a48-b09b-52e0-870e-185ec5edc9c1" 13194139533427 17592186045585 true] [17592186342071 1074 "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{36+{x}^{2}}\\,\\text{d}x & =\\int \\frac{3}{36\\cdot (1+{x}^{2}/36)}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\int \\frac{1}{1+{x}^{2}/36}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\int \\frac{1}{1+(x/6)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{6})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{6}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{6}\\,⟹\\,\\text{d}x=6\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{36+{x}^{2}}\\,\\text{d}x & =\\frac{1}{12}\\int \\frac{1}{1+(x/6)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\int \\frac{1}{1+{u}^{2}}\\cdot (6\\,\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{6})+C\\end{aligned}\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342072 1068 #edb/ref 17592186341734 13194139533427 17592186045585 true] [17592186342072 1069 "q-73715" 13194139533427 17592186045585 true] [17592186342072 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342072 1071 "$\\int \\frac{3\\,\\text{d}x}{|6x|\\sqrt{(6x)^{2}-1}}=$" 13194139533427 17592186045585 true] [17592186342072 1072 #uuid "8cd85d7e-9002-5474-aae0-35e5eb480c8e" 13194139533427 17592186045585 true] [17592186342072 1074 "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{3\\,\\text{d}x}{|6x|\\sqrt{(6x)^{2}-1}}=3\\int \\frac{\\text{d}x}{|6x|\\sqrt{(6x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $6x.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}3\\int \\frac{1}{|6x|\\sqrt{(6x)^{2}-1}}\\text{d}x & =3\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{2}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(6x)}{2}+C\\end{aligned}\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342073 1068 #edb/ref 17592186341770 13194139533427 17592186045585 true] [17592186342073 1069 "q-73716" 13194139533427 17592186045585 true] [17592186342073 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342073 1071 "$\\int \\frac{\\text{d}x}{|4x|\\sqrt{(4x)^{2}-1}}=$" 13194139533427 17592186045585 true] [17592186342073 1072 #uuid "78df4070-47af-5dba-93f4-a34eb10c085e" 13194139533427 17592186045585 true] [17592186342073 1074 "This integral resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $4x.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|4x|\\sqrt{(4x)^{2}-1}}\\text{d}x & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{4}\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{4}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342074 1068 #edb/ref 17592186341408 13194139533427 17592186045585 true] [17592186342074 1069 "q-73718" 13194139533427 17592186045585 true] [17592186342074 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342074 1071 "$\\int \\frac{1}{5|x|\\sqrt{25{x}^{2}-1}}\\,\\text{d}x=$" 13194139533427 17592186045585 true] [17592186342074 1072 #uuid "6b1a4da5-f80f-5816-895f-0dc3214bccc3" 13194139533427 17592186045585 true] [17592186342074 1074 "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{5|x|\\sqrt{25{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|5x|\\sqrt{(5x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $5x.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{5|x|\\sqrt{25{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|5x|\\sqrt{(5x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{5}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342075 1068 #edb/ref 17592186341786 13194139533427 17592186045585 true] [17592186342075 1069 "q-73719" 13194139533427 17592186045585 true] [17592186342075 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342075 1071 "Find the midpoint of the line segment with endpoints $(3a,-4b)$ and $(-5a,6b).$" 13194139533427 17592186045585 true] [17592186342075 1072 #uuid "001cd694-a8a8-5d9b-919a-07105b0a3c0e" 13194139533427 17592186045585 true] [17592186342075 1074 "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(3a,-4b)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-5a,6b)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{3a+(-5a)}{2},\\frac{-4b+6b}{2}) \\\\  & =(\\frac{3a-5a}{2},\\frac{-4b+6b}{2}) \\\\  & =(\\frac{-2a}{2},\\frac{2b}{2}) \\\\  & =(-a,b).\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342076 1068 #edb/ref 17592186341471 13194139533427 17592186045585 true] [17592186342076 1069 "q-73735" 13194139533427 17592186045585 true] [17592186342076 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342076 1071 "Find $t$ given that the vectors $p=⟨0,3,6⟩$, $q=⟨t,t,2⟩$, and $r=⟨-1,2,7⟩$ are coplanar." 13194139533427 17592186045585 true] [17592186342076 1072 #uuid "3a2d9a59-591c-58a1-9378-a824f178afc5" 13194139533427 17592186045585 true] [17592186342076 1074 "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}0 & 3 & 6 \\\\ t & t & 2 \\\\ -1 & 2 & 7\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}t & 2 \\\\ 2 & 7\\end{aligned}|-3\\cdot |\\begin{aligned}t & 2 \\\\ -1 & 7\\end{aligned}|+6\\cdot |\\begin{aligned}t & t \\\\ -1 & 2\\end{aligned}| \\\\  & =0-3(t\\cdot 7-(-1)\\cdot 2)+6(t\\cdot 2-(-1)\\cdot t) \\\\  & =-21t-6+12t+6t \\\\  & =-3t-6.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ -3t-6 & =0 \\\\ -3t & =6 \\\\ t & =-2\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=-2.$" 13194139533427 17592186045585 true] [17592186342077 1068 #edb/ref 17592186341708 13194139533427 17592186045585 true] [17592186342077 1069 "q-73736" 13194139533427 17592186045585 true] [17592186342077 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342077 1071 "Find $t$ given that the vectors $p=⟨t,1,t⟩$, $q=⟨2,-1,-1⟩$, and $r=⟨3,0,1⟩$ are coplanar." 13194139533427 17592186045585 true] [17592186342077 1072 #uuid "029d2415-156a-588b-85c8-9df58fb943a2" 13194139533427 17592186045585 true] [17592186342077 1074 "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}t & 1 & t \\\\ 2 & -1 & -1 \\\\ 3 & 0 & 1\\end{aligned}| \\\\  & =t\\cdot |\\begin{aligned}-1 & -1 \\\\ 0 & 1\\end{aligned}|-1\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}|+t\\cdot |\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}| \\\\  & =t((-1)\\cdot 1-0\\cdot (-1))-(2\\cdot 1-3\\cdot (-1))+t(2\\cdot 0-3\\cdot (-1)) \\\\  & =-t-5+3t \\\\  & =2t-5.\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 2t-5 & =0 \\\\ 2t & =5 \\\\ t & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=\\frac{5}{2}.$" 13194139533427 17592186045585 true] [17592186342078 1068 #edb/ref 17592186341597 13194139533427 17592186045585 true] [17592186342078 1069 "q-73738" 13194139533427 17592186045585 true] [17592186342078 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342078 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -3 & -2 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." 13194139533427 17592186045585 true] [17592186342078 1072 #uuid "f00ce7fb-f804-52bb-ae27-0431b21c7460" 13194139533427 17592186045585 true] [17592186342078 1074 "The system corresponding to $M$ is \n\n$$\n{\\begin{aligned}x-3y=-2 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-3y=-2.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=-2+3y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=-2+3y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2+3y \\\\ y\\end{aligned}]=⟨-2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342079 1068 #edb/ref 17592186341630 13194139533427 17592186045585 true] [17592186342079 1069 "q-73742" 13194139533427 17592186045585 true] [17592186342079 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342079 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}3 & -9 & 6 \\\\ 4 & -12 & 8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." 13194139533427 17592186045585 true] [17592186342079 1072 #uuid "9dd0d4fd-091a-5d63-898d-8efe81821dbb" 13194139533427 17592186045585 true] [17592186342079 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -9 & 6 \\\\ 4 & -12 & 8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 4 & -12 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342080 1068 #edb/ref 17592186341607 13194139533427 17592186045585 true] [17592186342080 1069 "q-73743" 13194139533427 17592186045585 true] [17592186342080 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342080 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}3 & -2 & 1 \\\\ 6 & -4 & 2\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." 13194139533427 17592186045585 true] [17592186342080 1072 #uuid "f7492471-0301-5306-8f40-5431247eb08f" 13194139533427 17592186045585 true] [17592186342080 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -2 & 1 \\\\ 6 & -4 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{1}{3} \\\\ 6 & -4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{1}{3} \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342081 1068 #edb/ref 17592186341509 13194139533427 17592186045585 true] [17592186342081 1069 "q-73744" 13194139533427 17592186045585 true] [17592186342081 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342081 1071 "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(1,1,0)$, $B(-2,1,0)$, $C(3,2,0)$, and $D(1,2,3).$" 13194139533427 17592186045585 true] [17592186342081 1072 #uuid "b1acfcbc-5797-5d52-8f43-51fb0ff9335f" 13194139533427 17592186045585 true] [17592186342081 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+j)-(i+j) \\\\  & =-3i \\\\  & =⟨-3,0,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+2j)-(i+j) \\\\  & =2i+1j \\\\  & =⟨2,1,0⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(i+2j+3k)-(i+j) \\\\  & =3j+3k \\\\  & =⟨0,1,3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 1 & 3\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}1 & 0 \\\\ 1 & 3\\end{aligned}|-0\\cdot |\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}|+0\\cdot |\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}| \\\\  & =-3(1\\cdot 3-1\\cdot 0)-0+0 \\\\  & =-9.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-9|=9.\n$$" 13194139533427 17592186045585 true] [17592186342082 1068 #edb/ref 17592186341651 13194139533427 17592186045585 true] [17592186342082 1069 "q-73745" 13194139533427 17592186045585 true] [17592186342082 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342082 1071 "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(1,-1,2)$, $B(-2,2,3)$, $C(1,1,1)$, and $D(-1,3,-2).$" 13194139533427 17592186045585 true] [17592186342082 1072 #uuid "d447f611-67a9-5187-a844-7f81dc30a0cc" 13194139533427 17592186045585 true] [17592186342082 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i+2j+3k)-(i-j+2k) \\\\  & =-3i+3j+k \\\\  & =⟨-3,3,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j+k)-(i-j+2k) \\\\  & =2j-k \\\\  & =⟨0,2,-1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(-i+3j-2k)-(i-j+2k) \\\\  & =-2i+4j-4k \\\\  & =⟨-2,4,-4⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 3 & 1 \\\\ 0 & 2 & -1 \\\\ -2 & 4 & -4\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}2 & -1 \\\\ 4 & -4\\end{aligned}|-3\\cdot |\\begin{aligned}0 & -1 \\\\ -2 & -4\\end{aligned}|+1\\cdot |\\begin{aligned}0 & 2 \\\\ -2 & 4\\end{aligned}| \\\\  & =-3(2\\cdot (-4)-4\\cdot (-1))-3(0\\cdot (-4)-(-2)\\cdot (-1))+(0\\cdot 4-(-2)\\cdot 2) \\\\  & =12+6+4 \\\\  & =22.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|22|=22.\n$$" 13194139533427 17592186045585 true] [17592186342083 1068 #edb/ref 17592186341577 13194139533427 17592186045585 true] [17592186342083 1069 "q-73746" 13194139533427 17592186045585 true] [17592186342083 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342083 1071 "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(0,1,2)$, $B(-1,0,1)$, $C(1,1,0)$, and $D(3,-1,3).$" 13194139533427 17592186045585 true] [17592186342083 1072 #uuid "eae017c3-e923-584f-9dc9-ad18f462f150" 13194139533427 17592186045585 true] [17592186342083 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-i+k)-(j+2k) \\\\  & =-i-j-k \\\\  & =⟨-1,-1,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j)-(j+2k) \\\\  & =i-2k \\\\  & =⟨1,0,-2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-j+3k)-(j+2k) \\\\  & =3i-2j+k \\\\  & =⟨3,-2,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-1 & -1 & -1 \\\\ 1 & 0 & -2 \\\\ 3 & -2 & 1\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}|-(-1)\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}1 & 0 \\\\ 3 & -2\\end{aligned}| \\\\  & =-(0\\cdot 1-(-2)\\cdot (-2))+(1\\cdot 1-3\\cdot (-2))-(1\\cdot (-2)-3\\cdot 0) \\\\  & =4+7+2 \\\\  & =13.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|13|=13.\n$$" 13194139533427 17592186045585 true] [17592186342084 1068 #edb/ref 17592186341553 13194139533427 17592186045585 true] [17592186342084 1069 "q-73748" 13194139533427 17592186045585 true] [17592186342084 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342084 1071 "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(2,-1,0)$, $B(-1,2,-1)$, $C(1,1,2)$, and $D(3,-1,1).$" 13194139533427 17592186045585 true] [17592186342084 1072 #uuid "b26b4535-e272-5e94-b038-84726ee96584" 13194139533427 17592186045585 true] [17592186342084 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-i+2j-k)-(2i-j) \\\\  & =-3i+3j-k \\\\  & =⟨-3,3,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i+j+2k)-(2i-j) \\\\  & =-i+2j+2k \\\\  & =⟨-1,2,2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-j+k)-(2i-j) \\\\  & =i+k \\\\  & =⟨1,0,1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-3 & 3 & -1 \\\\ -1 & 2 & 2 \\\\ 1 & 0 & 1\\end{aligned}| \\\\  & =(-3)\\cdot |\\begin{aligned}2 & 2 \\\\ 0 & 1\\end{aligned}|-3\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 1\\end{aligned}|+(-1)\\cdot |\\begin{aligned}-1 & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =-3(2\\cdot 1-0\\cdot 2)-3((-1)\\cdot 1-1\\cdot 2)-((-1)\\cdot 0-1\\cdot 2) \\\\  & =-6+9+2 \\\\  & =5.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|\\,5\\,|=5.\n$$" 13194139533427 17592186045585 true] [17592186342085 1068 #edb/ref 17592186341696 13194139533427 17592186045585 true] [17592186342085 1069 "q-73751" 13194139533427 17592186045585 true] [17592186342085 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342085 1071 "Consider the system of linear equations\n\n$$\n{\\begin{aligned}5x-10y=-5 \\\\ 2x-4y=2.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." 13194139533427 17592186045585 true] [17592186342085 1072 #uuid "b0b4636b-3357-5697-b846-0e6a1da3fd28" 13194139533427 17592186045585 true] [17592186342085 1074 "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}5 & -10 & -5 \\\\ 2 & -4 & 2\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}5 & -10 & -5 \\\\ 2 & -4 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 2 & -4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -1 \\\\ 0 & 0 & 4\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-2y=-1 \\\\ 0x+0y=4.\\end{aligned}\n$$\n\nHowever, the final equation $0x+0y=4$ has no solution. It simplifies to $0=4,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." 13194139533427 17592186045585 true] [17592186342086 1068 #edb/ref 17592186341698 13194139533427 17592186045585 true] [17592186342086 1069 "q-73752" 13194139533427 17592186045585 true] [17592186342086 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342086 1071 "Consider the system of linear equations\n\n$$\n{\\begin{aligned}2x-6y=10 \\\\ -x+3y=-5.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." 13194139533427 17592186045585 true] [17592186342086 1072 #uuid "824eec75-5ee7-5066-9e8b-de6f124de7ef" 13194139533427 17592186045585 true] [17592186342086 1074 "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}2 & -6 & 10 \\\\ -1 & 3 & -5\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -6 & 10 \\\\ -1 & 3 & -5\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 5 \\\\ -1 & 3 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 5 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-3y=5 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-3y=5.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=5+3y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=5+3y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342087 1068 #edb/ref 17592186341685 13194139533427 17592186045585 true] [17592186342087 1069 "q-73753" 13194139533427 17592186045585 true] [17592186342087 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342087 1071 "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB}$, $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD}$, given the points $A(-2,1,1)$, $B(2,1,0)$, $C(1,-1,2)$, and $D(3,-2,-2).$" 13194139533427 17592186045585 true] [17592186342087 1072 #uuid "ed1f88a5-7f29-5728-a62d-81ac2d1ace51" 13194139533427 17592186045585 true] [17592186342087 1074 "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(2i+j)-(-2i+j+k) \\\\  & =4i-k \\\\  & =⟨4,0,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(i-j+2k)-(-2i+j+k) \\\\  & =3i-2j+k \\\\  & =⟨3,-2,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(3i-2j-2k)-(-2i+j+k) \\\\  & =5i-3j-3k \\\\  & =⟨5,-3,-3⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}4 & 0 & -1 \\\\ 3 & -2 & 1 \\\\ 5 & -3 & -3\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}-2 & 1 \\\\ -3 & -3\\end{aligned}|-0\\cdot |\\begin{aligned}3 & 1 \\\\ 5 & -3\\end{aligned}|+(-1)\\cdot |\\begin{aligned}3 & -2 \\\\ 5 & -3\\end{aligned}| \\\\  & =4((-2)\\cdot (-3)-1\\cdot (-3))-0-(3\\cdot (-3)-5\\cdot (-2)) \\\\  & =36-1 \\\\  & =35.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelpiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|35|=35.\n$$" 13194139533427 17592186045585 true] [17592186342088 1068 #edb/ref 17592186341470 13194139533427 17592186045585 true] [17592186342088 1069 "q-73766" 13194139533427 17592186045585 true] [17592186342088 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342088 1071 "Find the points of intersection of the parabola ${x}^{2}=\\frac{3}{7}(y+4)$ with the $x$-axis." 13194139533427 17592186045585 true] [17592186342088 1072 #uuid "c2fa3d96-17f7-5218-92d8-92a735657de2" 13194139533427 17592186045585 true] [17592186342088 1074 "When the parabola intersects the $x$-axis, we must have $y=0.$ So, we set $y=0$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}{x}^{2} & =\\frac{3}{7}(0+4) \\\\ {x}^{2} & =\\frac{12}{7} \\\\ x & =\\pm \\sqrt{\\frac{12}{7}}\\end{aligned}\n$$\n\nTherefore, the coordinates of the intersection points are\n $(\\sqrt{\\frac{12}{7}},0)$ and $(-\\sqrt{\\frac{12}{7}},0).$" 13194139533427 17592186045585 true] [17592186342089 1068 #edb/ref 17592186341819 13194139533427 17592186045585 true] [17592186342089 1069 "q-73767" 13194139533427 17592186045585 true] [17592186342089 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342089 1071 "Find the points of intersection of the parabola ${y}^{2}=-5(x-10)$ with the $y$-axis." 13194139533427 17592186045585 true] [17592186342089 1072 #uuid "0c831fc6-238d-5f62-9885-b52dd424efb2" 13194139533427 17592186045585 true] [17592186342089 1074 "When the parabola intersects the $y$-axis, we must have $x=0.$ So, we set $x=0$ and solve the resulting equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2} & =-5(0-10) \\\\ {y}^{2} & =50 \\\\ y & =\\pm \\sqrt{50} \\\\ y & =\\pm 5\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the parabola intersects the $y$-axis at $(0,5\\sqrt{2})$ and $(0,-5\\sqrt{2}).$" 13194139533427 17592186045585 true] [17592186342090 1068 #edb/ref 17592186341821 13194139533427 17592186045585 true] [17592186342090 1069 "q-73798" 13194139533427 17592186045585 true] [17592186342090 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342090 1071 "$\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\,\\text{d}x=$" 13194139533427 17592186045585 true] [17592186342090 1072 #uuid "936e31ed-13cd-5404-9ab8-85dcf93e8b28" 13194139533427 17592186045585 true] [17592186342090 1074 "Let's introduce the new variable $u=3{x}^{3}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u=3{x}^{2}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 3{x}^{2}{e}^{3{x}^{3}+1}\\,\\text{d}x & =\\int {e}^{3{x}^{3}+1}\\cdot 3{x}^{2}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{e}^{u}+C \\\\  & =\\frac{1}{3}{e}^{3{x}^{3}+1}+C.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342091 1068 #edb/ref 17592186341605 13194139533427 17592186045585 true] [17592186342091 1069 "q-73801" 13194139533427 17592186045585 true] [17592186342091 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342091 1071 "Calculate the integral $\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x.$" 13194139533427 17592186045585 true] [17592186342091 1072 #uuid "a36ba9a8-67c3-5fc7-baaa-4765eb971f95" 13194139533427 17592186045585 true] [17592186342091 1074 "Let's introduce the new variable $u={x}^{2}+1.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 2x{6}^{{x}^{2}+1}\\,\\text{d}x & =\\int {6}^{{x}^{2}+1}\\cdot 2x\\,\\text{d}x \\\\  & =\\int {6}^{u}\\cdot \\,\\text{d}u \\\\  & =\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{{6}^{{x}^{2}+1}}{\\operatorname{ln}⁡6}+C.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342092 1068 #edb/ref 17592186341678 13194139533427 17592186045585 true] [17592186342092 1069 "q-73802" 13194139533427 17592186045585 true] [17592186342092 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342092 1071 "Calculate the integral $\\int x{7}^{{x}^{2}-7}\\,\\text{d}x.$" 13194139533427 17592186045585 true] [17592186342092 1072 #uuid "202ad664-ec55-5adf-8b56-f5a9d840cb98" 13194139533427 17592186045585 true] [17592186342092 1074 "Let's introduce the new variable $u={x}^{2}-7.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{7}^{{x}^{2}-7}\\,\\text{d}x & =\\int {7}^{{x}^{2}-7}\\cdot x\\,\\text{d}x \\\\  & =\\int {7}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {7}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\frac{{7}^{u}}{\\operatorname{ln}⁡7}+C \\\\  & =\\frac{{7}^{{x}^{2}-7}}{2\\operatorname{ln}⁡7}+C.\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342093 1068 #edb/ref 17592186341433 13194139533427 17592186045585 true] [17592186342093 1069 "q-73831" 13194139533427 17592186045585 true] [17592186342093 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342093 1071 "![](images/0a/0a9d728a5927f380bbc88445c6a409974d94050040f23000cce50f70de436917.png)\n\nWhat are the $x$-intercepts of the parabola shown above?" 13194139533427 17592186045585 true] [17592186342093 1072 #uuid "9fb00539-5721-5d8a-80d7-0dcf285c8845" 13194139533427 17592186045585 true] [17592186342093 1074 "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-3,-1)$ and passes through the point $(-6,8).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(-3,-1)$ into the above gives\n\n$$\n\\begin{aligned}(x+3)^{2} & =4p(y+1).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-6,8),$ we substitute $x=-6$ and $y=8$ into the equation and get\n\n$$\n\\begin{aligned}(-6+3)^{2} & =4p(8+1) \\\\ 9 & =4p(9) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x+3)^{2} & =(y+1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x+3)^{2} & =(0+1) \\\\ x+3 & =\\pm 1 \\\\ x & =\\pm 1-3\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $-4$ and $-2.$" 13194139533427 17592186045585 true] [17592186342094 1068 #edb/ref 17592186341785 13194139533427 17592186045585 true] [17592186342094 1069 "q-73833" 13194139533427 17592186045585 true] [17592186342094 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342094 1071 "![](images/9a/9a7f256ae77447f4b426612a3e136ccb60ebd172a6eb472c9fa9948e324b3085.png)\n\nWhat is the $x$-intercept of the parabola shown above?" 13194139533427 17592186045585 true] [17592186342094 1072 #uuid "fe98c5cc-1b07-5c7a-9070-12e0a5555ab3" 13194139533427 17592186045585 true] [17592186342094 1074 "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-8,-3)$ and passes through the point $(-2,-6).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(-8,-3)$ into the above gives\n\n$$\n(y+3)^{2}=4p(x+8).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,-6),$ we substitute $x=-2$ and $y=-6$ into the equation and get\n\n$$\n\\begin{aligned}(-6+3)^{2} & =4p(-2+8) \\\\ 9 & =4p(6) \\\\ p & =\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+3)^{2} & =\\frac{3}{2}(x+8).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(0+3)^{2} & =\\frac{3}{2}(x+8) \\\\ 9 & =\\frac{3}{2}(x+8) \\\\ \\frac{18}{3} & =x+8 \\\\ x & =6-8 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $-2.$" 13194139533427 17592186045585 true] [17592186342095 1068 #edb/ref 17592186341838 13194139533427 17592186045585 true] [17592186342095 1069 "q-73839" 13194139533427 17592186045585 true] [17592186342095 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342095 1071 "Find the equation of the tangent plane to the surface $z=x{y}^{2}+{x}^{2}y$ at the point $(1,1,2).$" 13194139533427 17592186045585 true] [17592186342095 1072 #uuid "b6181a62-0baf-50f0-8d87-05c9f12e5c17" 13194139533427 17592186045585 true] [17592186342095 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{y}^{2}+{x}^{2}y) \\\\  & ={y}^{2}+2xy \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{y}^{2}+{x}^{2}y) \\\\  & =2xy+{x}^{2}\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(1,1) & ={1}^{2}+2(1)(1)=3 \\\\ \\frac{∂f}{∂y}(1,1) & =2(1)(1)+{1}^{2}=3\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent plane:\n\n$$\n\\begin{aligned}z-2 & =(x-1)\\frac{∂f}{∂x}(1,1)+(y-1)\\frac{∂f}{∂y}(1,1) \\\\ z-2 & =3(x-1)+3(y-1) \\\\ z-2 & =3x+3y-6 \\\\ -3x-3y+z+4 & =0 \\\\ 3x+3y-z-4 & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342096 1068 #edb/ref 17592186341768 13194139533427 17592186045585 true] [17592186342096 1069 "q-73841" 13194139533427 17592186045585 true] [17592186342096 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342096 1071 "Find the equation of the tangent plane to the surface $z=\\sqrt{xy}+xy$ at the point $(2,2,6).$" 13194139533427 17592186045585 true] [17592186342096 1072 #uuid "1591ca64-8d01-58ee-bc18-245abf67ebe8" 13194139533427 17592186045585 true] [17592186342096 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\sqrt{xy}+xy) \\\\  & =\\frac{y}{2\\sqrt{xy}}+y \\\\  & =\\frac{\\sqrt{y}}{2\\sqrt{x}}+y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\sqrt{xy}+xy) \\\\  & =\\frac{x}{2\\sqrt{xy}}+x \\\\  & =\\frac{\\sqrt{x}}{2\\sqrt{y}}+x\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y)=(2,2):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(2,2) & =\\frac{\\sqrt{2}}{2\\sqrt{2}}+2=\\frac{5}{2} \\\\ \\frac{∂f}{∂y}(2,2) & =\\frac{\\sqrt{2}}{2\\sqrt{2}}+2=\\frac{5}{2}\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent plane:\n\n$$\n\\begin{aligned}z-6 & =(x-2)\\frac{∂f}{∂x}(2,2)+(y-2)\\frac{∂f}{∂y}(2,2) \\\\ z-6 & =\\frac{5}{2}(x-2)+\\frac{5}{2}(y-2) \\\\ z-6 & =\\frac{5x}{2}+\\frac{5y}{2}-10 \\\\ 2z-12 & =5x+5y-20 \\\\ -5x-5y+2z+8 & =0 \\\\ 5x+5y-2z-8 & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342097 1068 #edb/ref 17592186341481 13194139533427 17592186045585 true] [17592186342097 1069 "q-73842" 13194139533427 17592186045585 true] [17592186342097 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342097 1071 "Find the equation of the tangent plane to the surface $z=y\\operatorname{ln}⁡x+x\\operatorname{ln}⁡y+1$ at the point $(1,1,1).$" 13194139533427 17592186045585 true] [17592186342097 1072 #uuid "f18efd9d-f823-53b1-9b52-0bc881b7962b" 13194139533427 17592186045585 true] [17592186342097 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(y\\operatorname{ln}⁡x+x\\operatorname{ln}⁡y+1) \\\\  & =\\frac{y}{x}+\\operatorname{ln}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(y\\operatorname{ln}⁡x+x\\operatorname{ln}⁡y+1) \\\\  & =\\operatorname{ln}⁡x+\\frac{x}{y}\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(1,1) & =\\frac{1}{1}+\\operatorname{ln}⁡1=1 \\\\ \\frac{∂f}{∂y}(1,1) & =\\operatorname{ln}⁡1+\\frac{1}{1}=1\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent plane:\n\n$$\n\\begin{aligned}z-1 & =(x-1)\\frac{∂f}{∂x}(1,1)+(y-1)\\frac{∂f}{∂y}(1,1) \\\\ z-1 & =1\\cdot (x-1)+1\\cdot (y-1) \\\\ z-1 & =x+y-2 \\\\ -x-y+z+1 & =0 \\\\ x+y-z-1 & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342098 1068 #edb/ref 17592186341722 13194139533427 17592186045585 true] [17592186342098 1069 "q-73847" 13194139533427 17592186045585 true] [17592186342098 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342098 1071 "Find the points of intersection of the parabola ${y}^{2}=3(x-2)$ with the $y$-axis." 13194139533427 17592186045585 true] [17592186342098 1072 #uuid "6253cbd5-f5b5-5898-ac4f-5142a7aaca73" 13194139533427 17592186045585 true] [17592186342098 1074 "When the parabola intersects the $y$-axis, we must have $x=0.$ So, we set $x=0$ and solve the resulting equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2} & =3(0-2) \\\\ {y}^{2} & =-6.\\end{aligned}\n$$\n\nTherefore, as the equation ${y}^{2}=-6$ has no solutions, we conclude that there are no intersection points." 13194139533427 17592186045585 true] [17592186342099 1068 #edb/ref 17592186341674 13194139533427 17592186045585 true] [17592186342099 1069 "q-73851" 13194139533427 17592186045585 true] [17592186342099 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342099 1071 "Find the equation of the tangent hyperplane to the hypersurface $w=\\operatorname{sin}⁡(xyz)$ at the point $(1,1,\\pi ,0).$" 13194139533427 17592186045585 true] [17592186342099 1072 #uuid "de6bd964-56b9-511c-9d67-ed8d06732a08" 13194139533427 17592186045585 true] [17592186342099 1074 "The Cartesian equation of the tangent plane to the hypersurface $w=f(x,y,z)$ at the point $({x}_{0},{y}_{0},{z}_{0},{w}_{0})$ on the hypersurface can be written as\n\n$$\nw-{w}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0},{z}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0},{z}_{0})+(z-{z}_{0})\\frac{∂f}{∂z}({x}_{0},{y}_{0},{z}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xyz))=yz\\operatorname{cos}⁡(xyz) \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xyz))=xz\\operatorname{cos}⁡(xyz) \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\operatorname{sin}⁡(xyz))=xy\\operatorname{cos}⁡(xyz)\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y,z)=(1,1,\\pi ):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(1,1,\\pi ) & =(1)(\\pi )\\operatorname{cos}⁡(1\\cdot 1\\cdot \\pi )=-\\pi  \\\\ \\frac{∂f}{∂y}(1,1,\\pi ) & =(1)(\\pi )\\operatorname{cos}⁡(1\\cdot 1\\cdot \\pi )=-\\pi  \\\\ \\frac{∂f}{∂z}(1,1,\\pi ) & =(1)(1)\\operatorname{cos}⁡(1\\cdot 1\\cdot \\pi )=-1\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-0 & =(x-1)\\frac{∂f}{∂x}(1,1,\\pi )+(y-1)\\frac{∂f}{∂y}(1,1,\\pi )+(z-\\pi )\\frac{∂f}{∂z}(1,1,\\pi ) \\\\ w & =-\\pi (x-1)-\\pi (y-1)-(z-\\pi ) \\\\ w & =-\\pi x+\\pi -\\pi y+\\pi -z+\\pi  \\\\ \\pi x+\\pi y+z+w-3\\pi  & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342100 1068 #edb/ref 17592186341526 13194139533427 17592186045585 true] [17592186342100 1069 "q-73852" 13194139533427 17592186045585 true] [17592186342100 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342100 1071 "Find the equation of the tangent hyperplane to the hypersurface $w=\\sqrt{xy}+\\sqrt{yz}+\\sqrt{zx}$ at the point $(2,2,2,6).$" 13194139533427 17592186045585 true] [17592186342100 1072 #uuid "9a68ff90-b820-5db0-8c2c-29ec6a4e0d46" 13194139533427 17592186045585 true] [17592186342100 1074 "The Cartesian equation of the tangent plane to the hypersurface $w=f(x,y,z)$ at the point $({x}_{0},{y}_{0},{z}_{0},{w}_{0})$ on the hypersurface can be written as\n\n$$\nw-{w}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0},{z}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0},{z}_{0})+(z-{z}_{0})\\frac{∂f}{∂z}({x}_{0},{y}_{0},{z}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\sqrt{xy}+\\sqrt{yz}+\\sqrt{zx})=\\frac{\\sqrt{y}}{2\\sqrt{x}}+\\frac{\\sqrt{z}}{2\\sqrt{x}} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\sqrt{xy}+\\sqrt{yz}+\\sqrt{zx})=\\frac{\\sqrt{x}}{2\\sqrt{y}}+\\frac{\\sqrt{z}}{2\\sqrt{y}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\sqrt{xy}+\\sqrt{yz}+\\sqrt{zx})=\\frac{\\sqrt{y}}{2\\sqrt{z}}+\\frac{\\sqrt{x}}{2\\sqrt{z}}\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y,z)=(2,2,2):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(2,2,2) & =\\frac{\\sqrt{2}}{2\\sqrt{2}}+\\frac{\\sqrt{2}}{2\\sqrt{2}}=1 \\\\ \\frac{∂f}{∂y}(2,2,2) & =\\frac{\\sqrt{2}}{2\\sqrt{2}}+\\frac{\\sqrt{2}}{2\\sqrt{2}}=1 \\\\ \\frac{∂f}{∂z}(2,2,2) & =\\frac{\\sqrt{2}}{2\\sqrt{2}}+\\frac{\\sqrt{2}}{2\\sqrt{2}}=1\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-6 & =(x-2)\\frac{∂f}{∂x}(2,2,2)+(y-2)\\frac{∂f}{∂y}(2,2,2)+(z-2)\\frac{∂f}{∂z}(2,2,2) \\\\ w-6 & =(x-2)+(y-2)+(z-2) \\\\ w-6 & =x+y+z-6 \\\\ -x-y-z+w & =0 \\\\ x+y+z-w & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342101 1068 #edb/ref 17592186341573 13194139533427 17592186045585 true] [17592186342101 1069 "q-73853" 13194139533427 17592186045585 true] [17592186342101 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342101 1071 "Find the equation of the tangent hyperplane to the hypersurface $w={x}^{2}yz+x{y}^{2}z+xy{z}^{2}$ at the point $(1,-1,1,-1).$" 13194139533427 17592186045585 true] [17592186342101 1072 #uuid "4142a5f1-3da0-59f6-9d01-2beeae09fd8e" 13194139533427 17592186045585 true] [17592186342101 1074 "The Cartesian equation of the tangent plane to the hypersurface $w=f(x,y,z)$ at the point $({x}_{0},{y}_{0},{z}_{0},{w}_{0})$ on the hypersurface can be written as\n\n$$\nw-{w}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0},{z}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0},{z}_{0})+(z-{z}_{0})\\frac{∂f}{∂z}({x}_{0},{y}_{0},{z}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}yz+x{y}^{2}z+xy{z}^{2})=2xyz+{y}^{2}z+y{z}^{2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}yz+x{y}^{2}z+xy{z}^{2})={x}^{2}z+2xyz+x{z}^{2} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}({x}^{2}yz+x{y}^{2}z+xy{z}^{2})={x}^{2}y+x{y}^{2}+2xyz\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y,z)=(1,-1,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(1,-1,1) & =2(1)(-1)(1)+(-1)^{2}(1)+(-1)(1)^{2}=-2 \\\\ \\frac{∂f}{∂y}(1,-1,1) & =(1)^{2}(1)+2(1)(-1)(1)+(1)(1)^{2}=0 \\\\ \\frac{∂f}{∂z}(1,-1,1) & =(1)^{2}(-1)+(1)(-1)^{2}+2(1)(-1)(1)=-2\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-(-1) & =(x-1)\\frac{∂f}{∂x}(1,-1,1)+(y-(-1))\\frac{∂f}{∂y}(1,-1,1)+(z-1)\\frac{∂f}{∂z}(1,-1,1) \\\\ w+1 & =-2(x-1)+0\\cdot (y+1)-2(z-1) \\\\ w+1 & =-2x-2z+4 \\\\ 2x+2z+w-3 & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342102 1068 #edb/ref 17592186341624 13194139533427 17592186045585 true] [17592186342102 1069 "q-73854" 13194139533427 17592186045585 true] [17592186342102 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342102 1071 "Find the equation of the tangent hyperplane to the hypersurface $w=\\sqrt{xyz}$ at the point $(2,2,4,4).$" 13194139533427 17592186045585 true] [17592186342102 1072 #uuid "f93b9177-85da-5370-94ac-b27b761710c2" 13194139533427 17592186045585 true] [17592186342102 1074 "The Cartesian equation of the tangent plane to the hypersurface $w=f(x,y,z)$ at the point $({x}_{0},{y}_{0},{z}_{0},{w}_{0})$ on the hypersurface can be written as\n\n$$\nw-{w}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0},{z}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0},{z}_{0})+(z-{z}_{0})\\frac{∂f}{∂z}({x}_{0},{y}_{0},{z}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\sqrt{xyz})=\\frac{\\sqrt{yz}}{2\\sqrt{x}} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\sqrt{xyz})=\\frac{\\sqrt{xz}}{2\\sqrt{y}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\sqrt{xyz})=\\frac{\\sqrt{xy}}{2\\sqrt{z}}\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y,z)=(2,2,4):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(2,2,4) & =\\frac{\\sqrt{2\\cdot 4}}{2\\sqrt{2}}=1 \\\\ \\frac{∂f}{∂y}(2,2,4) & =\\frac{\\sqrt{2\\cdot 4}}{2\\sqrt{2}}=1 \\\\ \\frac{∂f}{∂z}(2,2,4) & =\\frac{\\sqrt{2\\cdot 2}}{2\\sqrt{4}}=\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-4 & =(x-2)\\frac{∂f}{∂x}(2,2,4)+(y-2)\\frac{∂f}{∂y}(2,2,4)+(z-4)\\frac{∂f}{∂z}(2,2,4) \\\\ w-4 & =(x-2)+(y-2)+\\frac{1}{2}(z-4) \\\\ w-4 & =x+y+\\frac{z}{2}-6 \\\\ -x-y-\\frac{z}{2}+w+2 & =0 \\\\ 2x+2y+z-2w-4 & =0\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342103 1068 #edb/ref 17592186341793 13194139533427 17592186045585 true] [17592186342103 1069 "q-73857" 13194139533427 17592186045585 true] [17592186342103 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342103 1071 "At which points on the surface $z={x}^{2}-2x+{y}^{2}+6y+10$ is the tangent plane horizontal?" 13194139533427 17592186045585 true] [17592186342103 1072 #uuid "c589653c-432a-5bb8-acb2-94698429fbb4" 13194139533427 17592186045585 true] [17592186342103 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}-2x+{y}^{2}+6y+10) \\\\  & =2x-2 \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}-2x+{y}^{2}+6y+10) \\\\  & =2y+6\\end{aligned}\n$$\n\n \n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨2x-2,\\,2y+6,\\,-1⟩.\n$$\n\nNote that the tangent plane is horizontal if and only if the normal vector is vertical. This means that the $x$- and $y$-components of the vector must be $0:$\n\n$$\n{\\begin{aligned}\\frac{∂f}{∂x}=0 \\\\ \\frac{∂f}{∂y}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}2x-2=0 \\\\ 2y+6=0\\end{aligned}\n$$\n\n \n\nFrom the first equation, we get $x=1$ while the second equation gives $y=-3.$ \n\nFinally, substituting $x=1$ and $y=-3$ into our function, we get\n\n$$\nz={1}^{2}-2(1)+(-3)^{2}+6(-3)+10=0.\n$$\n\nTherefore, the point where the tangent plane is horizontal is $(1,-3,0).$" 13194139533427 17592186045585 true] [17592186342104 1068 #edb/ref 17592186341739 13194139533427 17592186045585 true] [17592186342104 1069 "q-73862" 13194139533427 17592186045585 true] [17592186342104 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342104 1071 "Find the saddle point of the hyperbolic paraboloid $z-3=\\frac{(x+2)^{2}}{2}-\\frac{(y-4)^{2}}{4}.$" 13194139533427 17592186045585 true] [17592186342104 1072 #uuid "d959e918-e9be-5939-a2a7-015f4bbb6f1c" 13194139533427 17592186045585 true] [17592186342104 1074 "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z-3 & =\\frac{(x+2)^{2}}{2}-\\frac{(y-4)^{2}}{4} \\\\ z-3 & =\\frac{(x-(-2))^{2}}{2}-\\frac{(y-4)^{2}}{4}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(-2,4,3).$" 13194139533427 17592186045585 true] [17592186342105 1068 #edb/ref 17592186341495 13194139533427 17592186045585 true] [17592186342105 1069 "q-73864" 13194139533427 17592186045585 true] [17592186342105 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342105 1071 "Find the saddle point of the hyperbolic paraboloid $z+8={x}^{2}-(y+9)^{2}.$" 13194139533427 17592186045585 true] [17592186342105 1072 #uuid "60f0667a-58e4-5e3e-ac71-292417e67feb" 13194139533427 17592186045585 true] [17592186342105 1074 "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+8 & ={x}^{2}-(y+9)^{2} \\\\ z-(-8) & =\\frac{(x-0)^{2}}{1}-\\frac{(y-(-9))^{2}}{1}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(0,-9,-8).$" 13194139533427 17592186045585 true] [17592186342106 1068 #edb/ref 17592186341427 13194139533427 17592186045585 true] [17592186342106 1069 "q-73868" 13194139533427 17592186045585 true] [17592186342106 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342106 1071 "At which points on the surface $z=x\\operatorname{ln}⁡y+{y}^{2}$ is the tangent plane perpendicular to the vector  $v\\,=\\,⟨0,2,-2⟩?$" 13194139533427 17592186045585 true] [17592186342106 1072 #uuid "9d930cb5-4a33-5f68-a149-002500eed8d0" 13194139533427 17592186045585 true] [17592186342106 1074 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}),\n$$\n\nwhere $⟨\\frac{∂f}{∂x}({x}_{0},{y}_{0}),\\frac{∂f}{∂y}({x}_{0},{y}_{0}),-1⟩$ represents a normal vector to the tangent plane.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y+{y}^{2}) \\\\  & =\\operatorname{ln}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x\\operatorname{ln}⁡y+{y}^{2}) \\\\  & =\\frac{x}{y}+2y\\end{aligned}\n$$\n\nHence, the normal vector to the tangent plane is \n\n$$\n⟨\\operatorname{ln}⁡y,\\,\\frac{x}{y}+2y,\\,-1⟩\n$$\n\nOur tangent plane should be perpendicular to $⟨0,2,-2⟩.$ So, the normal vector of that plane must be parallel to that vector. In other words, for some constant $c$, we must have\n\n$$\nc\\cdot ⟨\\operatorname{ln}⁡y,\\,\\frac{x}{y}+2y,\\,-1⟩=⟨0,2,-2⟩.\n$$\n\nEquating the corresponding coordinates, we obtain the following system:\n\n$$\n{\\begin{aligned}c\\operatorname{ln}⁡y=0 \\\\ \\frac{cx}{y}+2cy=2 \\\\ -c=-2\\end{aligned}\n$$\n\nFrom the third equation, we get $c=2.$ Substituting this into the first equation, we obtain \n\n$$\n2\\operatorname{ln}⁡y=0\\,⟹\\,y=1.\n$$\n\nAnd substituting $c=2$ and $y=1$ into the second equation, we have \n\n$$\n\\frac{2x}{1}+2(2)(1)=2\\,⟹\\,x=-1.\n$$\n\nFinally, substituting $x=-1$ and $y=1$ into our function, we get\n\n$$\n\\begin{aligned}z & =(-1)\\operatorname{ln}⁡1+{1}^{2} \\\\  & =0+1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the tangent plane is perpendicular to the vector $v$ at $(-1,1,1).$" 13194139533427 17592186045585 true] [17592186342107 1068 #edb/ref 17592186341430 13194139533427 17592186045585 true] [17592186342107 1069 "q-73871" 13194139533427 17592186045585 true] [17592186342107 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342107 1071 "Solve the inequality $-2\\le 3x-5<4.$" 13194139533427 17592186045585 true] [17592186342107 1072 #uuid "c68675d1-b204-5417-95e5-6247b6b7938e" 13194139533427 17592186045585 true] [17592186342107 1074 "We isolate $x$ by applying the addition and multiplication principles:\n\n$$\n\\begin{aligned}-2 & \\le 3x-5<4 \\\\ -2+5 & \\le 3x-5+5<4+5 \\\\ 3 & \\le 3x<9 \\\\ \\frac{3}{3} & \\le \\frac{3x}{3}<\\frac{9}{3} \\\\ 1 & \\le x<3\\end{aligned}\n$$\n\nTherefore, the solution is $1\\le x<3.$" 13194139533427 17592186045585 true] [17592186342108 1068 #edb/ref 17592186341445 13194139533427 17592186045585 true] [17592186342108 1069 "q-73876" 13194139533427 17592186045585 true] [17592186342108 1070 #edb/ref 17592186045486 13194139533427 17592186045585 true] [17592186342108 1071 "Which of the following number lines gives the solution to $-3\\le \\frac{-1-4x}{3}\\le 1?$" 13194139533427 17592186045585 true] [17592186342108 1072 #uuid "0ee87523-8b97-5d1d-a0e7-2e661675b4e7" 13194139533427 17592186045585 true] [17592186342108 1074 "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-3 & \\le \\frac{-1-4x}{3}\\le 1 \\\\ -3\\cdot 3 & \\le \\frac{-1-4x}{3}\\cdot 3\\le 1\\cdot 3 \\\\ -9 & \\le -1-4x\\le 3 \\\\ -9+1 & \\le -1-4x+1\\le 3+1 \\\\ -8 & \\le -4x\\le 4\\end{aligned}\n$$\n\nAt this point, we need to divide by $-4.$ However, because we are dividing by a negative, we also need to flip the inequality signs.\n\n$$\n\\begin{aligned}-8 & \\le -4x\\le 4 \\\\ \\frac{-8}{-4} & \\ge \\frac{-4x}{-4}\\ge \\frac{4}{-4} \\\\ 2 & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $2\\ge x\\ge -1$,  but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le 2\n$$\n\nTherefore, the representation of the solution in a number line is the following.\n\n![](images/c9/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png)" 13194139533427 17592186045585 true] [17592186342109 1068 #edb/ref 17592186341747 13194139533427 17592186045585 true] [17592186342109 1069 "q-73912" 13194139533427 17592186045585 true] [17592186342109 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342109 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}-1 & 3 & -5 & 6 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." 13194139533427 17592186045585 true] [17592186342109 1072 #uuid "f224ea6c-a3b0-5c69-a134-e6c7eff7fb67" 13194139533427 17592186045585 true] [17592186342109 1074 "The system corresponding to $M$ is\n\n$$\n{\\begin{aligned}-x+3y-5z=6 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\n-x+3y-5z=6\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=-6+3y-5z.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=-6+3y-5z \\\\ y=y \\\\ z=z,\\end{aligned}\n$$\n\nwhere $y$, $z$ (free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-6+3y-5z \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-6 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-5 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342110 1068 #edb/ref 17592186341609 13194139533427 17592186045585 true] [17592186342110 1069 "q-73913" 13194139533427 17592186045585 true] [17592186342110 1070 #edb/ref 17592186045485 13194139533427 17592186045585 true] [17592186342110 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -2 & 7 & -9 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." 13194139533427 17592186045585 true] [17592186342110 1072 #uuid "061b9ba7-cf18-55a3-aa89-28e4ebe56a2a" 13194139533427 17592186045585 true] [17592186342110 1074 "The system corresponding to $M$ is\n\n$$\n{\\begin{aligned}x-2y+7z=-9 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx-2y+7z=-9\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=-9+2y-7z.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=-9+2y-7z \\\\ y=y \\\\ z=z,\\end{aligned}\n$$\n\nwhere $y$, $z$ (free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-9+2y-7z \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-9 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-7 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342111 1068 #edb/ref 17592186341489 13194139533427 17592186045585 true] [17592186342111 1069 "q-73915" 13194139533427 17592186045585 true] [17592186342111 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342111 1071 "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -1 & -2 & 1 & -3 \\\\ 8 & 16 & -8 & 24\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." 13194139533427 17592186045585 true] [17592186342111 1072 #uuid "b928310c-eb01-592d-b214-59e2de82f6b4" 13194139533427 17592186045585 true] [17592186342111 1074 "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ -1 & -2 & 1 & -3 \\\\ 8 & 16 & -8 & 24\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 8 & 16 & -8 & 24\\end{aligned}] & {R}_{3} & :={R}_{3}+(-8){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+2y-z=3 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx+2y-z=3\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=3-2y+z.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=3-2y+z \\\\ y=y \\\\ z=z\\end{aligned}\n$$\n\nwhere $y,z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}3-2y+z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342112 1068 #edb/ref 17592186341766 13194139533427 17592186045585 true] [17592186342112 1069 "q-73917" 13194139533427 17592186045585 true] [17592186342112 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342112 1071 "Consider the system\n\n$$\n{\\begin{aligned}-{x}_{1}+2{x}_{3}=2 \\\\ -3{x}_{1}+6{x}_{3}=6 \\\\ 4{x}_{1}-8{x}_{3}=-8.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." 13194139533427 17592186045585 true] [17592186342112 1072 #uuid "3d037d1d-0cc4-5132-92cf-ed832f1634b8" 13194139533427 17592186045585 true] [17592186342112 1074 "The augmented matrix for the system is\n\n$$\nM=[\\begin{aligned}-1 & 0 & 2 & 2 \\\\ -3 & 0 & 6 & 6 \\\\ 4 & 0 & -8 & -8\\end{aligned}].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 0 & 2 & 2 \\\\ -3 & 0 & 6 & 6 \\\\ 4 & 0 & -8 & -8\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & -2 \\\\ -3 & 0 & 6 & 6 \\\\ 4 & 0 & -8 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 4 & 0 & -8 & -8\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & -2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" 13194139533427 17592186045585 true] [17592186342113 1068 #edb/ref 17592186341421 13194139533427 17592186045585 true] [17592186342113 1069 "q-73918" 13194139533427 17592186045585 true] [17592186342113 1070 #edb/ref 17592186045487 13194139533427 17592186045585 true] [17592186342113 1071 "Consider the system\n\n$$\n{\\begin{aligned}-{x}_{1}+4{x}_{2}-2{x}_{3}=8 \\\\ -5{x}_{1}+20{x}_{2}-10{x}_{3}=40 \\\\ \\frac{1}{2}{x}_{1}-2{x}_{2}+{x}_{3}=-4.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." 13194139533427 17592186045585 true] [17592186342113 1072 #uuid "5afdcd66-6368-5354-bd74-a259df30653f" 13194139533427 17592186045585 true] [17592186342113 1074 "The augmented matrix for the system is\n\n$$\nM=[\\begin{aligned}-1 & 4 & -2 & 8 \\\\ -5 & 20 & -10 & 40 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{aligned}].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & 4 & -2 & 8 \\\\ -5 & 20 & -10 & 40 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 2 & -8 \\\\ -5 & 20 & -10 & 40 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 2 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\