297483 13194139533411 17592186045585 true] [17592186105740 1038 #edb/ref 17592186297497 13194139533411 17592186045585 true] [17592186105740 1038 #edb/ref 17592186297498 13194139533411 17592186045585 true] [17592186105740 1038 #edb/ref 17592186297499 13194139533411 17592186045585 true] [17592186105855 1038 #edb/ref 17592186297270 13194139533411 17592186045585 true] [17592186105855 1038 #edb/ref 17592186297271 13194139533411 17592186045585 true] [17592186105855 1038 #edb/ref 17592186297272 13194139533411 17592186045585 true] [17592186105860 1038 #edb/ref 17592186297266 13194139533411 17592186045585 true] [17592186105911 1038 #edb/ref 17592186297166 13194139533411 17592186045585 true] [17592186105911 1038 #edb/ref 17592186297167 13194139533411 17592186045585 true] [17592186105912 1038 #edb/ref 17592186297168 13194139533411 17592186045585 true] [17592186105912 1038 #edb/ref 17592186297169 13194139533411 17592186045585 true] [17592186105912 1038 #edb/ref 17592186297170 13194139533411 17592186045585 true] [17592186105912 1038 #edb/ref 17592186297171 13194139533411 17592186045585 true] [17592186106288 1068 #edb/ref 17592186103846 13194139533411 17592186045585 false] [17592186106288 1068 #edb/ref 17592186297117 13194139533411 17592186045585 true] [17592186106288 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186106288 1071 "Find the total area of the region bounded by the graph of the curve $y = \\mid x \\mid e^{-x^{2}}$ and the $x$-axis." 13194139533411 17592186045585 false] [17592186106288 1071 "Find the total area of the region bounded by the graph of the curve $y=|x|{e}^{-{x}^{2}}$ and the $x$-axis." 13194139533411 17592186045585 true] [17592186106288 1074 "We find the area of the region bounded by the graph of the curve and the $x$-axis by calculating the integral\n\n$$\nA={\\int }_{-\\infty }^{\\infty }|x|{e}^{-{x}^{2}}\\,\\text{d}x.\n$$\n\nWe break up the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }|x|{e}^{-{x}^{2}}\\text{d}x={\\int }_{-\\infty }^{0}|x|{e}^{-{x}^{2}}\\text{d}x+{\\int }_{0}^{\\infty }|x|{e}^{-{x}^{2}}\\text{d}x\\end{aligned}\n$$\n\nWe start by calculating the first of these integrals:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}|x|{e}^{-{x}^{2}}\\text{d}x=-{\\int }_{-\\infty }^{0}x{e}^{-{x}^{2}}\\text{d}x\\end{aligned}\n$$\n\nWe calculate the antiderivative using a substitution. Let  $u=-{x}^{2}$,  then $\\text{d}u=-2x\\text{d}x.$ Hence,\n\n$$\n\\begin{aligned}\\int x{e}^{-{x}^{2}}\\text{d}x & =-\\frac{1}{2}\\int {e}^{u}\\text{d}u \\\\  & =-\\frac{1}{2}{e}^{u}+C \\\\  & =-\\frac{1}{2}{e}^{-{x}^{2}}+C.\\end{aligned}\n$$\n\nWe now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}|x|{e}^{-{x}^{2}}\\text{d}x & =-{\\int }_{-\\infty }^{0}x{e}^{-{x}^{2}}\\text{d}x \\\\  & =-{lim}_{a\\to -\\infty }{\\int }_{a}^{0}x{e}^{-{x}^{2}}\\text{d}x \\\\  & =-{lim}_{a\\to -\\infty }({-\\frac{1}{2}{e}^{-{x}^{2}}|}_{a}^{0}) \\\\  & =\\frac{1}{2}{lim}_{a\\to -\\infty }({e}^{0}-{e}^{-{a}^{2}}) \\\\  & =\\frac{1}{2}(1-0) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nNow, notice that the integrand $|x|{e}^{-{x}^{2}}$ is an **even** function. This means that we can immediately deduce that\n\n$$\n{\\int }_{0}^{\\infty }|x|{e}^{-{x}^{2}}\\,\\text{d}x=\\frac{1}{2}.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }|x|{e}^{-{x}^{2}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}|x|{e}^{-{x}^{2}}\\text{d}x+{\\int }_{0}^{\\infty }|x|{e}^{-{x}^{2}}\\text{d}x \\\\  & =\\frac{1}{2}+\\frac{1}{2} \\\\  & =1.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186110589 1038 #edb/ref 17592186297458 13194139533411 17592186045585 true] [17592186110606 1038 #edb/ref 17592186297162 13194139533411 17592186045585 true] [17592186110658 1038 #edb/ref 17592186297241 13194139533411 17592186045585 true] [17592186110673 1038 #edb/ref 17592186297228 13194139533411 17592186045585 true] [17592186110723 1038 #edb/ref 17592186297309 13194139533411 17592186045585 true] [17592186110724 1038 #edb/ref 17592186297308 13194139533411 17592186045585 true] [17592186110725 1038 #edb/ref 17592186297187 13194139533411 17592186045585 true] [17592186110725 1038 #edb/ref 17592186297188 13194139533411 17592186045585 true] [17592186110725 1038 #edb/ref 17592186297202 13194139533411 17592186045585 true] [17592186110726 1038 #edb/ref 17592186297176 13194139533411 17592186045585 true] [17592186110726 1038 #edb/ref 17592186297189 13194139533411 17592186045585 true] [17592186110726 1038 #edb/ref 17592186297190 13194139533411 17592186045585 true] [17592186110727 1038 #edb/ref 17592186297200 13194139533411 17592186045585 true] [17592186110727 1038 #edb/ref 17592186297201 13194139533411 17592186045585 true] [17592186110727 1038 #edb/ref 17592186297204 13194139533411 17592186045585 true] [17592186110727 1038 #edb/ref 17592186297205 13194139533411 17592186045585 true] [17592186110727 1038 #edb/ref 17592186297206 13194139533411 17592186045585 true] [17592186111139 1068 #edb/ref 17592186108544 13194139533411 17592186045585 false] [17592186111139 1068 #edb/ref 17592186296860 13194139533411 17592186045585 true] [17592186111139 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186111139 1071 "Which of the following equations has infinitely many solutions?\n\n- $2x=x+1$\n- $2x+1=2x+1$\n- $2x+1=2x+3$" 13194139533411 17592186045585 true] [17592186111139 1071 "Which of the following equations has infinitely many solutions?\n\n1. $2x = x + 1$\n2. $2x + 1 = 2x + 1$\n3. $2x + 1 = 2x + 3$" 13194139533411 17592186045585 false] [17592186111139 1074 "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}2x & =x+1 \\\\ 2x-x & =x+1-x \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the equation $2x=x+1$ has the unique solution $x=1.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}2x+1 & =2x+1 \\\\ 2x+1-2x & =2x+1-2x \\\\ 1 & =1.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $2x+1=2x+1$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}2x+1 & =2x+3 \\\\ 2x+1-2x & =2x+3-2x \\\\ 1 & =3.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\"" 13194139533411 17592186045585 true] [17592186111140 1068 #edb/ref 17592186108550 13194139533411 17592186045585 false] [17592186111140 1068 #edb/ref 17592186296886 13194139533411 17592186045585 true] [17592186111140 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186111140 1071 "Consider the equation\n\n$$\n2px=3x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" 13194139533411 17592186045585 true] [17592186111140 1071 "Consider the equation\n$2px = 3x$\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p$?" 13194139533411 17592186045585 false] [17592186111140 1074 "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=2p,\\,b=3.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n2p=3.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=\\frac{3}{2}.\n$$" 13194139533411 17592186045585 true] [17592186111141 1068 #edb/ref 17592186108556 13194139533411 17592186045585 false] [17592186111141 1068 #edb/ref 17592186296685 13194139533411 17592186045585 true] [17592186111141 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186111141 1071 "Consider the equation\n\n$$\n(p-3)x=4x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" 13194139533411 17592186045585 true] [17592186111141 1071 "Consider the equation\n$(p - 3)x = 4x$\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p$?" 13194139533411 17592186045585 false] [17592186111141 1074 "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=p-3,\\,b=4.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\np-3=4.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=7.\n$$" 13194139533411 17592186045585 true] [17592186111144 1068 #edb/ref 17592186108569 13194139533411 17592186045585 false] [17592186111144 1068 #edb/ref 17592186296759 13194139533411 17592186045585 true] [17592186111144 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186111144 1071 "Which of the following equations has infinitely many solutions?\n\n- $3x=2x+5$\n- $4x-2=4x-2$\n- $5x+3=5x+1$" 13194139533411 17592186045585 true] [17592186111144 1071 "Which of the following equations has infinitely many solutions?\n\n1. $3x = 2x + 5$\n2. $4x - 2 = 4x - 2$\n3. $5x + 3 = 5x + 1$" 13194139533411 17592186045585 false] [17592186111144 1074 "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x & =2x+5 \\\\ 3x-2x & =2x+5-2x \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the equation $3x=2x+5$ has the unique solution $x=5.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}4x-2 & =4x-2 \\\\ 4x-2-4x & =4x-2-4x \\\\ -2 & =-2.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $4x-2=4x-2$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}5x+3 & =5x+1 \\\\ 5x+3-5x & =5x+1-5x \\\\ 3 & =1.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\"" 13194139533411 17592186045585 true] [17592186111147 1068 #edb/ref 17592186108587 13194139533411 17592186045585 false] [17592186111147 1068 #edb/ref 17592186296758 13194139533411 17592186045585 true] [17592186111147 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186111147 1071 "Which of the following statements are true in relation to the function $f(x) = (\\frac{2}{7})^{x}$?\n\n1. Its domain is $x ∈ (- ∞, ∞)$\n2. Its range is $y ∈ (0, ∞)$\n3. It is a decreasing function" 13194139533411 17592186045585 false] [17592186111147 1071 "Which of the following statements are true in relation to the function $f(x)={(\\frac{2}{7})}^{x}?$\n\n- Its domain is $x\\in (-\\infty ,\\infty )$\n- Its range is $y\\in (0,\\infty )$\n- It is a decreasing function" 13194139533411 17592186045585 true] [17592186111147 1074 "Let's start by recalling the graph of ${(\\frac{2}{7})}^{x}.$\n\n![](images/c1/c1bbffed32708d30355ed3592deae845d1a84cd1f1772ef1d0fae7ac39518295.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The function $f(x)={(\\frac{2}{7})}^{x}$ is defined for all input values $x.$\n\n- Statement II is true. The set of possible outputs of $f(x)={(\\frac{2}{7})}^{x}$ consists of all the positive numbers.\n\n- Statement III is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\nIn conclusion, statements I, II, and III are true." 13194139533411 17592186045585 true] [17592186115185 1038 #edb/ref 17592186297227 13194139533411 17592186045585 true] [17592186115185 1038 #edb/ref 17592186297229 13194139533411 17592186045585 true] [17592186115185 1038 #edb/ref 17592186297233 13194139533411 17592186045585 true] [17592186115188 1038 #edb/ref 17592186297230 13194139533411 17592186045585 true] [17592186115190 1038 #edb/ref 17592186297234 13194139533411 17592186045585 true] [17592186115191 1038 #edb/ref 17592186297235 13194139533411 17592186045585 true] [17592186115191 1038 #edb/ref 17592186297247 13194139533411 17592186045585 true] [17592186115196 1038 #edb/ref 17592186297381 13194139533411 17592186045585 true] [17592186115206 1038 #edb/ref 17592186297331 13194139533411 17592186045585 true] [17592186115216 1038 #edb/ref 17592186297445 13194139533411 17592186045585 true] [17592186115218 1038 #edb/ref 17592186297253 13194139533411 17592186045585 true] [17592186115226 1038 #edb/ref 17592186297300 13194139533411 17592186045585 true] [17592186115229 1038 #edb/ref 17592186297237 13194139533411 17592186045585 true] [17592186115290 1038 #edb/ref 17592186297163 13194139533411 17592186045585 true] [17592186115291 1038 #edb/ref 17592186297164 13194139533411 17592186045585 true] [17592186115375 1038 #edb/ref 17592186297239 13194139533411 17592186045585 true] [17592186115377 1038 #edb/ref 17592186297282 13194139533411 17592186045585 true] [17592186115404 1038 #edb/ref 17592186297342 13194139533411 17592186045585 true] [17592186115405 1038 #edb/ref 17592186297344 13194139533411 17592186045585 true] [17592186115407 1038 #edb/ref 17592186297343 13194139533411 17592186045585 true] [17592186115696 1068 #edb/ref 17592186113112 13194139533411 17592186045585 false] [17592186115696 1068 #edb/ref 17592186297092 13194139533411 17592186045585 true] [17592186115696 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115696 1071 "A quadratic equation with real coefficients has a root $x = 3 - \\textrm{i}$. What is the other root?" 13194139533411 17592186045585 false] [17592186115696 1071 "A quadratic equation with real coefficients has a root $x=3-\\text{i}.$ What is the other root?" 13194139533411 17592186045585 true] [17592186115696 1074 "We're given that the quadratic equation has real coefficients and that $x=3-\\text{i}$ is a root. Therefore, its complex conjugate $x=3+\\text{i}$ is also a root." 13194139533411 17592186045585 true] [17592186115699 1068 #edb/ref 17592186113130 13194139533411 17592186045585 false] [17592186115699 1068 #edb/ref 17592186296797 13194139533411 17592186045585 true] [17592186115699 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115699 1071 "A quadratic equation in the variable $x$ with real coefficients has a root $x = 2\\textrm{i}$. Given that the coefficient of $x^{2}$ in the equation is $3$, find the equation." 13194139533411 17592186045585 false] [17592186115699 1071 "A quadratic equation in the variable $x$ with real coefficients has a root $x=2\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $3$, find the equation." 13194139533411 17592186045585 true] [17592186115699 1074 "Since the quadratic equation has real coefficients and  $x=2\\text{i}$ is a root, its conjugate  $x=-2\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-2\\text{i})(x+2\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(2\\text{i})^{2} & =0 \\\\ {x}^{2}-4(-1) & =0 \\\\ {x}^{2}+4 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm 2\\text{i},$ but the coefficient of ${x}^{2}$ is not $3.$ Therefore, to find the desired equation, we multiply the equation above by $3.$ This gives\n\n$$\n\\begin{aligned}3({x}^{2}+4) & =0 \\\\ 3{x}^{2}+12 & =0.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186115700 1068 #edb/ref 17592186113136 13194139533411 17592186045585 false] [17592186115700 1068 #edb/ref 17592186297055 13194139533411 17592186045585 true] [17592186115700 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115700 1071 "A quadratic equation in the variable $x$ with real coefficients has a root $x =-\\textrm{i}$. Given that the coefficient of $x^{2}$ in the equation is $-2$, find the equation." 13194139533411 17592186045585 false] [17592186115700 1071 "A quadratic equation in the variable $x$ with real coefficients has a root $x=-\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $-2$, find the equation." 13194139533411 17592186045585 true] [17592186115700 1074 "Since the quadratic equation has real coefficients and  $x=-\\text{i}$ is a root, its conjugate  $x=\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-\\text{i})(x+\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(\\text{i})^{2} & =0 \\\\ {x}^{2}-(-1) & =0 \\\\ {x}^{2}+1 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\text{i},$ but the coefficient of ${x}^{2}$ is not $-2.$ Therefore, to find the desired equation, we multiply the equation above by $-2.$ This gives\n\n$$\n\\begin{aligned}-2({x}^{2}+1) & =0 \\\\ -2{x}^{2}-2 & =0.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186115702 1068 #edb/ref 17592186113148 13194139533411 17592186045585 false] [17592186115702 1068 #edb/ref 17592186296978 13194139533411 17592186045585 true] [17592186115702 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115702 1071 "Which of the following is the graph of $y =-5^{x} - 3$?" 13194139533411 17592186045585 false] [17592186115702 1071 "Which of the following is the graph of $y=-{5}^{x}-3?$" 13194139533411 17592186045585 true] [17592186115702 1074 "To plot the given function, we follow these steps:\n\n- We take the curve $y={5}^{x}.$\n\n![](images/e8/e85f2f0f042f85b5f7c8162b744a5c9d4688a93faf4ccddbad82ca1a9db47f93.png)\n\n- Reflect it on the $x$-axis to give $y=-{5}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/97/971d4cf0310cced68f72be500d65fff26163a7e2bd5cee005e25e92ca3fb931e.png)\n\n- Then, vertically shift it by $3$ units down to give $y=-{5}^{x}-3.$ The point $(0,-1)$ moves to $(0,-4)$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/8d/8d4dd11693eda60dc0ed7eb041bdb94c90757f6bb75be3523ce77d01d28534de.png)" 13194139533411 17592186045585 true] [17592186115707 1068 #edb/ref 17592186113178 13194139533411 17592186045585 false] [17592186115707 1068 #edb/ref 17592186296808 13194139533411 17592186045585 true] [17592186115707 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115707 1071 "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\csc x = \\frac{2\\sqrt{3}}{3}$ for $0 \\le x < 2π$, what is the value of $x_{1} \\cdot x_{2}$?\n\n> A calculator is required to answer this question." 13194139533411 17592186045585 false] [17592186115707 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{2\\sqrt{3}}{3}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533411 17592186045585 true] [17592186115707 1074 "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\text{arcsin}(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{3}.\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the  first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/4c/4cbf970747a9eddbcffe6fd3ba46d13c43e5f17ca56e52747c797229dbc74d48.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{2\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{2\\pi }{3}=\\frac{2{\\pi }^{2}}{9}.\n$$" 13194139533411 17592186045585 true] [17592186115710 1068 #edb/ref 17592186113196 13194139533411 17592186045585 false] [17592186115710 1068 #edb/ref 17592186297016 13194139533411 17592186045585 true] [17592186115710 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115710 1071 "Which of the following equations has no solutions for $0 \\le x < 2π$?\n\n1. $\\csc x = 10\\frac{1}{2}$\n2. $\\csc x = \\frac{1}{2}\\frac{1}{2}$\n3. $\\csc x =-1\\frac{1}{2}$" 13194139533411 17592186045585 false] [17592186115710 1071 "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\n- $\\operatorname{csc}⁡x=10$\n- $\\operatorname{csc}⁡x=\\frac{1}{2}$\n- $\\operatorname{csc}⁡x=-1$" 13194139533411 17592186045585 true] [17592186115710 1074 "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation II has no solutions." 13194139533411 17592186045585 true] [17592186115712 1068 #edb/ref 17592186113208 13194139533411 17592186045585 false] [17592186115712 1068 #edb/ref 17592186296693 13194139533411 17592186045585 true] [17592186115712 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115712 1071 "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\sec x = 2$ for $-180^{∘} \\le x < 180^{∘}$, what is the numerical value of $x_{1} \\cdot x_{2}$?\n\n> A calculator is required to answer this question." 13194139533411 17592186045585 false] [17592186115712 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=2$ for $-{180}^{∘}\\le x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533411 17592186045585 true] [17592186115712 1074 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}\n$$\n\nSince ${60}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={60}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](images/9c/9c8adbb0a1594ae5bacfab7f1f92993c67659839599e10ab46d5cf98896e3ec7.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get the second solution ${x}_{2}$ that's within the given domain, we subtract ${360}^{∘}:$\n\n$$\n{x}_{2}={300}^{∘}-{360}^{∘}=-{60}^{∘}.\n$$\n\nSo, the solutions are $x={60}^{∘},-{60}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=60\\cdot (-60)=-3\\,600.\n$$" 13194139533411 17592186045585 true] [17592186115714 1068 #edb/ref 17592186113220 13194139533411 17592186045585 false] [17592186115714 1068 #edb/ref 17592186296794 13194139533411 17592186045585 true] [17592186115714 1070 #edb/ref 17592186045486 13194139533411 17592186045585 true] [17592186115714 1071 "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $5\\cot x = 11 + \\cot x$ for $0^{∘} \\le x < 360^{∘}$, what is the numerical value of $x_{1} \\cdot x_{2}$, rounded to the nearest integer?\n\n> A scientific calculator is required to answer this question." 13194139533411 17592186045585 false] [17592186115714 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation  $5\\operatorname{cot}⁡x=11+\\operatorname{cot}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" 13194139533411 17592186045585 true] [17592186115714 1074 "First, we rearrange the equation and isolate $\\operatorname{cot}⁡x$:\n\n$$\n\\begin{aligned}5\\operatorname{cot}⁡x & =11+\\operatorname{cot}⁡x \\\\ 4\\operatorname{cot}⁡x & =11 \\\\ \\operatorname{cot}⁡x & =\\frac{11}{4}\\end{aligned}\n$$\n\nRecall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{4}{11}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(\\frac{4}{11})=(19.983\\,1…)^{∘}≈{19.983}^{∘}\\end{aligned}\n$$\n\nSince ${19.983}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={19.983}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n{x}_{2}={180}^{∘}+x={180}^{∘}+{19.983}^{∘}={199.983}^{∘}.\n$$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is\n\n$$\n19.983\\cdot 199.983≈3\\,996\n$$\n\nrounded to the nearest integer." 13194139533411 17592186045585 true] [17592186115716 1068 #edb/ref 17592186113232 13194139533411 17592186045585 false] [17592186115716 1068 #edb/ref 17592186297038 13194139533411 17592186045585 true] [17592186115716 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115716 1071 "Which of the following is the graph of $y = - (\\frac{1}{2})^{x} + 8$?" 13194139533411 17592186045585 false] [17592186115716 1071 "Which of the following is the graph of $y=-{(\\frac{1}{2})}^{x}+8?$" 13194139533411 17592186045585 true] [17592186115716 1074 "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{1}{2})}^{x}.$\n\n![](images/1a/1adec10c20862d7015466efc5ded1e966e959ac3f6141163afa26802b502d49e.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{(\\frac{1}{2})}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/96/9651fab70ad189764143d92f89938cff1293a390bfca693c567bb33220ff859e.png)\n\n- Then, vertically shift it by $8$ units up to give $y=-{(\\frac{1}{2})}^{x}+8.$ The point $(0,-1)$ moves to $(0,7)$ and the horizontal asymptote moves from from $y=0$ to $y=8.$\n\n![](images/1d/1d41ded0d251b46ad6f137b6686e31bfdad299c62a1496e0782ada5d400780bf.png)" 13194139533411 17592186045585 true] [17592186115721 1068 #edb/ref 17592186113262 13194139533411 17592186045585 false] [17592186115721 1068 #edb/ref 17592186296934 13194139533411 17592186045585 true] [17592186115721 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186115721 1071 "Given that $x_{1}$ and $x_{2}$ are the solutions to the equation $\\cot x = \\sqrt{3}$ for $- π < x < π$, what is the value of $x_{1} \\cdot x_{2}$?\n\n> A scientific calculator is required to answer this question." 13194139533411 17592186045585 false] [17592186115721 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=\\sqrt{3}$ for $-\\pi <x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533411 17592186045585 true] [17592186115721 1074 "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{\\sqrt{3}}=\\frac{\\sqrt{3}}{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nTo generate more solutions, we add or subtract integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-\\pi =\\frac{\\pi }{6}-\\pi =-\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{5\\pi }{6},\\frac{\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot (-\\frac{5\\pi }{6})=-\\frac{5{\\pi }^{2}}{36}.\n$$" 13194139533411 17592186045585 true] [17592186115725 1068 #edb/ref 17592186113286 13194139533411 17592186045585 false] [17592186115725 1068 #edb/ref 17592186297013 13194139533411 17592186045585 true] [17592186115725 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186115725 1071 "${\\int }_{1}^{16}(\\frac{10}{\\sqrt[4]{{x}^{3}}}+\\frac{x}{10})\\,\\text{d}x=$" 13194139533411 17592186045585 true] [17592186115725 1071 "What is $\\displaystyle \\int_{1}^{16}(\\frac{10}{\\sqrt[4]{x^{3}}} + \\frac{x}{10})dx$?" 13194139533411 17592186045585 false] [17592186115725 1074 "First, we rewrite the integral as\n\n$$\n{\\int }_{1}^{16}(\\frac{10}{\\sqrt[4]{{x}^{3}}}+\\frac{x}{10})\\,\\text{d}x={\\int }_{1}^{16}(10{x}^{-3/4}+\\frac{1}{10}x)\\,\\text{d}x.\n$$\n\nThen, we split the integral into the difference of two integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}(10{x}^{-3/4}+\\frac{1}{10}x)\\,\\text{d}x & =10{\\int }_{1}^{16}{x}^{-3/4}\\,\\text{d}x+\\frac{1}{10}{\\int }_{1}^{16}x\\,\\text{d}x \\\\  & =10\\cdot 4{x}^{1/4}\\,{|}_{1}^{16}+\\frac{1}{10}\\cdot \\frac{{x}^{2}}{2}\\,{|}_{1}^{16} \\\\  & =40{x}^{1/4}\\,{|}_{1}^{16}+\\frac{1}{20}{x}^{2}\\,{|}_{1}^{16} \\\\  & =40({16}^{1/4}-{1}^{1/4})+\\frac{1}{20}({16}^{2}-{1}^{2}) \\\\  & =40(2-1)+\\frac{1}{20}(256-1) \\\\  & =40+\\frac{51}{4} \\\\  & =\\frac{211}{4}.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186115733 1068 #edb/ref 17592186113334 13194139533411 17592186045585 false] [17592186115733 1068 #edb/ref 17592186297126 13194139533411 17592186045585 true] [17592186115733 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186115733 1071 "Find $f^{′}(x)$ if $f(x) = x^{2} - 6\\csc x$." 13194139533411 17592186045585 false] [17592186115733 1071 "Find ${f}^{′}(x)$ if $f(x)={x}^{2}-6csc⁡x.$" 13194139533411 17592186045585 true] [17592186115733 1074 "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186119945 1038 #edb/ref 17592186297351 13194139533411 17592186045585 true] [17592186119947 1038 #edb/ref 17592186297352 13194139533411 17592186045585 true] [17592186124668 1038 #edb/ref 17592186297276 13194139533411 17592186045585 true] [17592186124669 1038 #edb/ref 17592186297277 13194139533411 17592186045585 true] [17592186124669 1038 #edb/ref 17592186297278 13194139533411 17592186045585 true] [17592186129100 1038 #edb/ref 17592186297290 13194139533411 17592186045585 true] [17592186129102 1038 #edb/ref 17592186297291 13194139533411 17592186045585 true] [17592186129106 1038 #edb/ref 17592186297242 13194139533411 17592186045585 true] [17592186129106 1038 #edb/ref 17592186297243 13194139533411 17592186045585 true] [17592186129107 1038 #edb/ref 17592186297238 13194139533411 17592186045585 true] [17592186129581 1068 #edb/ref 17592186126941 13194139533411 17592186045585 false] [17592186129581 1068 #edb/ref 17592186297071 13194139533411 17592186045585 true] [17592186129581 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186129581 1071 "Which of the following expressions gives all of the vertical asymptotes of the function $f(x) = \\tan (3x) + 2$? Assume that $n$ is an integer." 13194139533411 17592186045585 false] [17592186129581 1071 "Which of the following expressions gives all of the vertical asymptotes of the function $f(x)=\\operatorname{tan}⁡(3x)+2?$ Assume that $n$ is an integer." 13194139533411 17592186045585 true] [17592186129581 1074 "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the expression\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the asymptotes of $\\operatorname{tan}⁡(3x)+2,$ we replace the $x$ on the left-hand side of the above with $(3x).$ This gives\n\n$$\n3x=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}3x & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{6}+\\frac{n\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, we conclude that the expression giving all the vertical asymptotes is $x=\\frac{\\pi }{6}+\\frac{n\\pi }{3},$ where $n$ is an integer." 13194139533411 17592186045585 true] [17592186152236 1038 #edb/ref 17592186297431 13194139533411 17592186045585 true] [17592186152245 1038 #edb/ref 17592186297435 13194139533411 17592186045585 true] [17592186157404 1038 #edb/ref 17592186297456 13194139533411 17592186045585 true] [17592186166873 1038 #edb/ref 17592186297366 13194139533411 17592186045585 true] [17592186175945 1038 #edb/ref 17592186297428 13194139533411 17592186045585 true] [17592186176055 1038 #edb/ref 17592186297174 13194139533411 17592186045585 true] [17592186176055 1038 #edb/ref 17592186297244 13194139533411 17592186045585 true] [17592186176105 1038 #edb/ref 17592186297429 13194139533411 17592186045585 true] [17592186184158 1038 #edb/ref 17592186297336 13194139533411 17592186045585 true] [17592186184158 1038 #edb/ref 17592186297338 13194139533411 17592186045585 true] [17592186184158 1038 #edb/ref 17592186297340 13194139533411 17592186045585 true] [17592186184244 1038 #edb/ref 17592186297283 13194139533411 17592186045585 true] [17592186184246 1038 #edb/ref 17592186297284 13194139533411 17592186045585 true] [17592186184246 1038 #edb/ref 17592186297286 13194139533411 17592186045585 true] [17592186184356 1038 #edb/ref 17592186297403 13194139533411 17592186045585 true] [17592186184356 1038 #edb/ref 17592186297406 13194139533411 17592186045585 true] [17592186184357 1038 #edb/ref 17592186297416 13194139533411 17592186045585 true] [17592186184357 1038 #edb/ref 17592186297417 13194139533411 17592186045585 true] [17592186184358 1038 #edb/ref 17592186297319 13194139533411 17592186045585 true] [17592186184358 1038 #edb/ref 17592186297321 13194139533411 17592186045585 true] [17592186184743 1068 #edb/ref 17592186183042 13194139533411 17592186045585 false] [17592186184743 1068 #edb/ref 17592186296958 13194139533411 17592186045585 true] [17592186184743 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186184743 1074 "The border-line is a vertical line passing through the point $(-4,0).$ Therefore, the line has the equation $x=-4.$\n\nNow, we need to decide which inequality symbol to use. Since the line is dashed, we will use a strict inequality. Since the shaded region is to the *right* of the line, the inequality refers to the $x$-values that are *greater than* those on the line $x=-4.$\n\nTherefore, the corresponding inequality is\n\n$$\nx>-4.\n$$" 13194139533411 17592186045585 true] [17592186184748 1068 #edb/ref 17592186183072 13194139533411 17592186045585 false] [17592186184748 1068 #edb/ref 17592186297051 13194139533411 17592186045585 true] [17592186184748 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186184748 1071 "Find the solution of $x^{2} \\ge 5x + 6$." 13194139533411 17592186045585 false] [17592186184748 1071 "Find the solution of ${x}^{2}\\ge 5x+6.$" 13194139533411 17592186045585 true] [17592186184748 1074 "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$\n\n$$\n\\begin{aligned}{x}^{2} & \\ge 5x+6 \\\\ {x}^{2}-5x-6 & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y={x}^{2}-5x-6$ lies above the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}{x}^{2}-5x-6 & =0 \\\\ (x+1)(x-6) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-1$ and $x=6,$ and we can graph the parabola as follows:\n\n![](images/51/51c7484f806696105dd570684f8b194d3c1b7fc3ea27d85a1a17f53e6f7d0a64.png)\n\nSince we are interested in solving \n\n$$\n{x}^{2}-5x-6\\ge 0,\n$$\n\nwe look for the part of the parabola that is above the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $x\\le -1$ or $x\\ge 6.$ \n\nUsing interval notation, we write $x\\in (-\\infty ,-1]\\cup [6,\\infty ).$" 13194139533411 17592186045585 true] [17592186184749 1068 #edb/ref 17592186183078 13194139533411 17592186045585 false] [17592186184749 1068 #edb/ref 17592186296901 13194139533411 17592186045585 true] [17592186184749 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186184749 1071 "![](images/9f/9fe57341b631d34a9dfa41619a29f816b00b41b3b07f450fd333808230835e2c.png)\n\nThe graph of the second derivative $y = f^{″}(x)$ of the function $f(x)$ is shown above.\nFind the intervals on which the function $f(x)$ is concave up." 13194139533411 17592186045585 false] [17592186184749 1071 "![](images/9f/9fe57341b631d34a9dfa41619a29f816b00b41b3b07f450fd333808230835e2c.png)\n\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ is shown above. \nFind the intervals on which the function $f(x)$ is concave up." 13194139533411 17592186045585 true] [17592186184749 1074 "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the interval $(0,4)$ only. \n\nTherefore, the function $f(x)$ is concave up on the interval $(0,4)$ only." 13194139533411 17592186045585 true] [17592186184750 1068 #edb/ref 17592186183084 13194139533411 17592186045585 false] [17592186184750 1068 #edb/ref 17592186296674 13194139533411 17592186045585 true] [17592186184750 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186184750 1071 "![](images/38/3891159e9d53769e4f95176a2585e339ca347e39aa91c9df8cd6456f8d3155da.png)\n\nThe graph of the second derivative $y = g^{″}(x)$ of the function $g(x)$ is shown above.\nFind the intervals on which the function $g(x)$ is concave down." 13194139533411 17592186045585 false] [17592186184750 1071 "![](images/38/3891159e9d53769e4f95176a2585e339ca347e39aa91c9df8cd6456f8d3155da.png)\n\nThe graph of the second derivative $y={g}^{″}(x)$ of the function $g(x)$ is shown above. \nFind the intervals on which the function $g(x)$ is concave down." 13194139533411 17592186045585 true] [17592186184750 1074 "A function $g(x)$ is concave down over an interval $(a,b)$ if ${g}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={g}^{″}(x),$ we can see that ${g}^{″}(x)<0$ on the intervals $(-7,-6)$ and $(2,5).$ \n\nTherefore, the function $g(x)$ is concave down on the intervals $(-7,-6)$ and $(2,5).$" 13194139533411 17592186045585 true] [17592186184752 1068 #edb/ref 17592186183091 13194139533411 17592186045585 false] [17592186184752 1068 #edb/ref 17592186297133 13194139533411 17592186045585 true] [17592186184752 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186184752 1071 "Calculate the integral $\\int x{8}^{3{x}^{2}}\\,\\text{d}x.$" 13194139533411 17592186045585 true] [17592186184752 1071 "Calculate the integral $\\intx8^{3x^{2}}dx$." 13194139533411 17592186045585 false] [17592186184752 1074 "Let's introduce the new variable $u=3{x}^{2}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6x\\,⟹\\,\\frac{1}{6}\\text{d}u=x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int x{8}^{3{x}^{2}}\\,\\text{d}x & =\\int {8}^{3{x}^{2}}\\cdot x\\,\\text{d}x \\\\  & =\\int {8}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\int {8}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\frac{{8}^{u}}{\\operatorname{ln}⁡8}+C \\\\  & =\\frac{{8}^{3{x}^{2}}}{6\\operatorname{ln}⁡8}+C.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186192768 1038 #edb/ref 17592186297424 13194139533411 17592186045585 true] [17592186192780 1038 #edb/ref 17592186297383 13194139533411 17592186045585 true] [17592186192780 1038 #edb/ref 17592186297384 13194139533411 17592186045585 true] [17592186198254 1038 #edb/ref 17592186297430 13194139533411 17592186045585 true] [17592186204095 1038 #edb/ref 17592186297178 13194139533411 17592186045585 true] [17592186204095 1038 #edb/ref 17592186297179 13194139533411 17592186045585 true] [17592186204095 1038 #edb/ref 17592186297180 13194139533411 17592186045585 true] [17592186204095 1038 #edb/ref 17592186297181 13194139533411 17592186045585 true] [17592186204095 1038 #edb/ref 17592186297182 13194139533411 17592186045585 true] [17592186204096 1038 #edb/ref 17592186297183 13194139533411 17592186045585 true] [17592186204096 1038 #edb/ref 17592186297184 13194139533411 17592186045585 true] [17592186204096 1038 #edb/ref 17592186297185 13194139533411 17592186045585 true] [17592186204096 1038 #edb/ref 17592186297203 13194139533411 17592186045585 true] [17592186204097 1038 #edb/ref 17592186297207 13194139533411 17592186045585 true] [17592186204097 1038 #edb/ref 17592186297208 13194139533411 17592186045585 true] [17592186204097 1038 #edb/ref 17592186297209 13194139533411 17592186045585 true] [17592186204097 1038 #edb/ref 17592186297210 13194139533411 17592186045585 true] [17592186204098 1038 #edb/ref 17592186297211 13194139533411 17592186045585 true] [17592186204098 1038 #edb/ref 17592186297212 13194139533411 17592186045585 true] [17592186204098 1038 #edb/ref 17592186297213 13194139533411 17592186045585 true] [17592186204098 1038 #edb/ref 17592186297214 13194139533411 17592186045585 true] [17592186204098 1038 #edb/ref 17592186297215 13194139533411 17592186045585 true] [17592186204603 1068 #edb/ref 17592186203502 13194139533411 17592186045585 false] [17592186204603 1068 #edb/ref 17592186296781 13194139533411 17592186045585 true] [17592186204603 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186204603 1071 "Consider the equation in the variable $x$, given by\n$2(p - 4)x + 2 = 5$\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p$?$p =$\n{{field-1}}" 13194139533411 17592186045585 false] [17592186204603 1071 "Consider the equation in the variable $x,$ given by\n\n$$\n2(p-4)x+2=5\n$$\n\nwhere $p$ is a constant. Given that this equation has no solution, what is the value of $p?$\n\n$p=$\n{{field-1}}" 13194139533411 17592186045585 true] [17592186204603 1074 "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nFirst, let's write our equation in the form $ax=b:$\n\n$$\n\\begin{aligned}2(p-4)x+2 & =5 \\\\ 2(p-4)x+2-2 & =5-2 \\\\ {{2(p-4)}_{⏟}}_{a}x & ={{3}_{⏟}}_{b}\\end{aligned}\n$$\n\nTherefore, the equation has no solution if\n\n$$\n2(p-4)=0.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}2(p-4) & =0 \\\\ \\frac{2(p-4)}{2} & =\\frac{0}{2} \\\\ p-4 & =0 \\\\ p & =4.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186204608 1068 #edb/ref 17592186203522 13194139533411 17592186045585 false] [17592186204608 1068 #edb/ref 17592186296852 13194139533411 17592186045585 true] [17592186204608 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186204608 1071 "Consider the equation in the variable $y$, given by\n$(q - 1)y = 4$\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q$?" 13194139533411 17592186045585 false] [17592186204608 1071 "Consider the equation in the variable $y,$ given by\n\n$$\n(q-1)y=4\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" 13194139533411 17592186045585 true] [17592186204608 1074 "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=q-1,\\,b=4.\n$$\n\nTherefore, the equation has no solution if\n\n$$\nq-1=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}q-1 & =0 \\\\ q & =1.\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186204611 1068 #edb/ref 17592186203535 13194139533411 17592186045585 false] [17592186204611 1068 #edb/ref 17592186296998 13194139533411 17592186045585 true] [17592186204611 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186204611 1071 "Which expression gives all of the zeros of $y = 3\\cos (x + 45^{∘})$? Assume that $n$ is an integer." 13194139533411 17592186045585 false] [17592186204611 1071 "Which expression gives all of the zeros of $y=3\\operatorname{cos}⁡(x+{45}^{∘})?$ Assume that $n$ is an integer." 13194139533411 17592186045585 true] [17592186204611 1074 "First, let's start by defining a new variable $X$ as\n\n$$\nX=x+{45}^{∘}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=3\\operatorname{cos}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘}-{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘}-{45}^{∘} \\\\ x & ={45}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x={45}^{∘}+n\\cdot {180}^{∘},$ where $n$ is any integer." 13194139533411 17592186045585 true] [17592186213009 1038 #edb/ref 17592186297177 13194139533411 17592186045585 true] [17592186213009 1038 #edb/ref 17592186297186 13194139533411 17592186045585 true] [17592186213009 1038 #edb/ref 17592186297191 13194139533411 17592186045585 true] [17592186213009 1038 #edb/ref 17592186297192 13194139533411 17592186045585 true] [17592186213009 1038 #edb/ref 17592186297193 13194139533411 17592186045585 true] [17592186213010 1038 #edb/ref 17592186297194 13194139533411 17592186045585 true] [17592186213010 1038 #edb/ref 17592186297195 13194139533411 17592186045585 true] [17592186213010 1038 #edb/ref 17592186297196 13194139533411 17592186045585 true] [17592186213010 1038 #edb/ref 17592186297197 13194139533411 17592186045585 true] [17592186213010 1038 #edb/ref 17592186297198 13194139533411 17592186045585 true] [17592186213011 1038 #edb/ref 17592186297199 13194139533411 17592186045585 true] [17592186213011 1038 #edb/ref 17592186297216 13194139533411 17592186045585 true] [17592186213011 1038 #edb/ref 17592186297217 13194139533411 17592186045585 true] [17592186213443 1068 #edb/ref 17592186210530 13194139533411 17592186045585 false] [17592186213443 1068 #edb/ref 17592186297044 13194139533411 17592186045585 true] [17592186213443 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186213443 1071 "The following equation is true for all values of $x$.\n\n$4x^{2} + bx + 1 = 4x^{2} + 9x + 1$\n\nWhat is the value of the constant $b$?" 13194139533411 17592186045585 false] [17592186213443 1071 "The following equation is true for all values of $x.$\n\n$$\n4{x}^{2}+bx+1=4{x}^{2}+9x+1\n$$\n\nWhat is the value of the constant $b?$" 13194139533411 17592186045585 true] [17592186213443 1074 "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nWe compare the linear terms on both sides. On the left-hand side, the coefficient of $x$ is $b.$ On the right-hand side, the coefficient of $x$ is $9.$\n\nSo, we have\n\n$$\nb=9.\n$$" 13194139533411 17592186045585 true] [17592186213447 1068 #edb/ref 17592186210544 13194139533411 17592186045585 false] [17592186213447 1068 #edb/ref 17592186296969 13194139533411 17592186045585 true] [17592186213447 1070 #edb/ref 17592186045485 13194139533411 17592186045585 true] [17592186213447 1071 "The equation\n$k(x^{2} + 7x + 10) = 5x^{2} + 35x + 50$\n\nis true for all values of $x$, where $k$ is a constant. What is the value of $k$?" 13194139533411 17592186045585 false] [17592186213447 1071 "The equation \n\n$$\nk({x}^{2}+7x+10)=5{x}^{2}+35x+50\n$$\n\nis true for all values of $x,$ where $k$ is a constant. What is the value of $k?$" 13194139533411 17592186045585 true] [17592186213447 1074 "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means that after distributing $k$ on the left-hand side, the coefficients of the matching powers of $x$ must be equal.\n\nLet's expand the left-hand side:\n\n$$\nk({x}^{2}+7x+10)=k{x}^{2}+7kx+10k\n$$\n\nThis must equal the right-hand side. So, we have\n\n$$\nk{x}^{2}+7kx+10k=5{x}^{2}+35x+50.\n$$\n\nNow, we compare the coefficients of corresponding terms. \n\nComparing the ${x}^{2}$ terms, we have\n\n$$\nk=5.\n$$\n\nLet's verify that value $k=5$ produces the correct linear coefficient and constant term:\n\n- $7k=7(5)=35\\,✓$\n\n- $10k=10(5)=50\\,✓$\n\nSo, our solution is valid." 13194139533411 17592186045585 true] [17592186213448 1068 #edb/ref 17592186210550 13194139533411 17592186045585 false] [17592186213448 1068 #edb/ref 17592186296964 13194139533411 17592186045585 true] [17592186213448 1070 #edb/ref 17592186045486 13194139533411 17592186045585 true] [17592186213448 1071 "The equation\n\n$$\n(ax+4)(x+b)=2{x}^{2}+14x+20\n$$\n\nis true for all values of $x,$ where $a$ and $b$ are constants. What is the value of $a+b?$\n\n$a+b=$\n{{field-1}}" 13194139533411 17592186045585 true] [17592186213448 1071 "The equation\n$(ax + 4)(x + b) = 2x^{2} + 14x + 20$\n\nis true for all values of $x$, where $a$ and $b$ are constants. What is the value of $a + b$?\n\n$a + b =$\n{{field-1}}" 13194139533411 17592186045585 false] [17592186213448 1074 "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the product on the left-hand side must expand to match the right-hand side.\n\nFirst, let's expand the left-hand side:\n\n$$\n\\begin{aligned}(ax+4)(x+b) & =a{x}^{2}+abx+4x+4b \\\\  & =a{x}^{2}+(ab+4)x+4b.\\end{aligned}\n$$\n\nNext, we equate the expanded form to the right-hand side:\n\n$$\na{x}^{2}+(ab+4)x+4b=2{x}^{2}+14x+20.\n$$\n\nNow, we compare the coefficients of corresponding terms.\n\n- Equating the coefficients of ${x}^{2},$ we get\n\n$$\na=2.\n$$\n\n- Equating the constant terms, we get\n\n$$\n4b=20\\,⇒\\,b=5.\n$$\n\nLet's verify that values $a=2$ and $b=5$ produce the correct linear coefficient:\n\n$$\n\\begin{aligned}ab+4 & =2\\cdot 5+4 \\\\  & =10+4 \\\\  & =14\\,✓\\end{aligned}\n$$\n\nwhich matches the coefficient of $x$ on the right-hand side. So, our solution is valid.\n\nFinally, we compute the value of $a+b:$\n\n$$\n\\begin{aligned}a+b & =2+5 \\\\  & =7\\end{aligned}\n$$" 13194139533411 17592186045585 true] [17592186217159 1038 #edb/ref 17592186297173 13194139533411 17592186045585 true] [17592186217159 1038 #edb/ref 17592186297240 13194139533411 17592186045585 true] [17592186217416 1068 #edb/ref 17592186214767 13194139533411 17592186045585 false] [17592186217416 1068 #edb/ref 17592186296791 13194139533411 17592186045585 true] [17592186217416 1070 #edb/ref 17592186045487 13194139533411 17592186045585 true] [17592186217416 1071 "Which of the following is the graph of  $y=-{(\\frac{1}{10})}^{x-3}?$" 13194139533411 17592186045585 true] [17592186217416 1071 "Which of the following is the graph of $y = - (\\frac{1}{10})^{x - 3}$?" 13194139533411 17592186045585 false] [17592186217416 1074 "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{1}{10})}^{x}.$\n\n![](images/d6/d61528c7868baa92a1adbb2c4b4b23f5c975df80dbbabfeb449ad73acea97802.png)\n\n \n\n- Horizontally shift it by $3$ units to the right to give $y={(\\frac{1}{10})}^{x-3}.$ The $y$-intercept moves from $(0,1)$ to $(3,1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/3a/3a4e3b5a90900d204c3265187d01343233bcaa76d811276464742fa447e4543a.png)\n\n- Then, reflect it on the $x$-axis to give $y=-{(\\frac{1}{10})}^{x-3}.$ The point $(3,1)$ moves to $(3,-1)$ and the horizontal asymptote stays at $y=0.$\n\n![](images/09/0936975d549f0f94f4c4139b9543142308c2cc56d38d1bba2c94dc6c681b3d99.png)" 13194139533411 17592186045585 true] [17592186233750 1068 #edb/ref 17592186296921 13194139533411 17592186045585 true] [17592186233751 1068 #edb/ref 17592186296996 13194139533411 17592186045585 true] [17592186233786 1068 #edb/ref 17592186296846 13194139533411 17592186045585 true] [17592186233786 1074 "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{'}}{[{x}^{2}]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{'}}{[2x]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$" 13194139533411 17592186045585 false] [17592186233786 1074 "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{′}}{[{x}^{2}]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{′}}{[2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$" 13194139