{j-1}-5{x}_{i}-1\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the lower Riemann sum is\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(4{y}_{j-1}-5{x}_{i}-1)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $4{y}_{j-1}-5{x}_{i}-1.$" 13194139533398 17592186045585 true] [17592186259541 1068 #edb/ref 17592186259197 13194139533398 17592186045585 true] [17592186259541 1069 "q-123520" 13194139533398 17592186045585 true] [17592186259541 1070 #edb/ref 17592186045487 13194139533398 17592186045585 true] [17592186259541 1071 "${\\int }_{1}^{16}⟨\\frac{1}{5\\sqrt{t}},\\,\\sqrt{t-1}⟩\\text{d}t=$" 13194139533398 17592186045585 true] [17592186259541 1072 #uuid "c60f5cb4-8994-525e-b7a9-d8f4480892c7" 13194139533398 17592186045585 true] [17592186259541 1074 "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{1}^{16}⟨\\frac{1}{5\\sqrt{t}},\\,\\sqrt{t-1}⟩\\text{d}t & =⟨{\\int }_{1}^{16}\\frac{1}{5\\sqrt{t}}\\,\\text{d}t,{\\int }_{1}^{16}\\sqrt{t-1}\\,\\text{d}t⟩ \\\\  & =⟨\\frac{2}{5}\\sqrt{t}\\,\\,{|}_{1}^{16},\\,\\frac{2\\sqrt{(t-1)^{3}}}{3}\\,\\,{|}_{1}^{16}⟩ \\\\  & =⟨\\frac{2}{5}\\cdot \\sqrt{16}-\\frac{2}{5}\\cdot \\sqrt{1},\\,\\frac{2\\sqrt{(16-1)^{3}}}{3}-\\frac{2\\sqrt{(1-1)^{3}}}{3}⟩ \\\\  & =⟨\\frac{6}{5},\\,10\\sqrt{15}⟩\\end{aligned}\n$$" 13194139533398 17592186045585 true] [17592186259542 1068 #edb/ref 17592186259352 13194139533398 17592186045585 true] [17592186259542 1069 "q-123587" 13194139533398 17592186045585 true] [17592186259542 1070 #edb/ref 17592186045487 13194139533398 17592186045585 true] [17592186259542 1071 "![](images/99/994b8cd2134d6d1e9a1e89559e462128c05fd5d3e7f4755c51931f3cf7f37268.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r={\\theta }^{2}\\,$ for $0\\le \\theta \\le \\pi ,$ shown above." 13194139533398 17592186045585 true] [17592186259542 1072 #uuid "f5451ce0-d618-51ea-8499-28c757a17f08" 13194139533398 17592186045585 true] [17592186259542 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={\\theta }^{2},$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{({\\theta }^{2})}^{2}+{(2\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{\\theta }^{4}+4{\\theta }^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{\\theta }^{2}(4+{\\theta }^{2})}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\theta \\sqrt{4+{\\theta }^{2}}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }2\\theta \\sqrt{4+{\\theta }^{2}}\\,\\text{d}\\theta  \\\\  & ={\\frac{{(4+{\\theta }^{2})}^{3/2}}{3}|}_{0}^{\\pi } \\\\  & =\\frac{{({\\pi }^{2}+4)}^{3/2}-8}{3}\\end{aligned}\n$$" 13194139533398 17592186045585 true] [17592186259543 1068 #edb/ref 17592186259277 13194139533398 17592186045585 true] [17592186259543 1069 "q-123589" 13194139533398 17592186045585 true] [17592186259543 1070 #edb/ref 17592186045486 13194139533398 17592186045585 true] [17592186259543 1071 "Let $R=[0,1]\\times [1,2]$ be a region in the $xy$-plane, and let $f(x,y)=5y-x.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}},\\,{P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" 13194139533398 17592186045585 true] [17592186259543 1072 #uuid "c0562b9d-b571-5335-94ed-dcbe9cf7bfdd" 13194139533398 17592186045585 true] [17592186259543 1074 "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below.\n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=5y-x$ decreases as $x$ increases, and\n\n- $f(x,y)=5y-x$ increases as $y$ increases.\n\n![](images/ff/ffa57d3e7fed08212f12d4b9d7c2e0a4d33a3aac71c8b8a03d1a9a7364484deb.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *largest* possible $y.$ This is the value at the *top left corner* of each subregion.\n\n![](images/74/74d546d91e145efea49b70af56cb472e8bbbd1417725cd7fa92a3a278cad75ea.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i-1},{y}_{j})=5{y}_{j}-{x}_{i-1}\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(5{y}_{j}-{x}_{i-1})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $5{y}_{j}-{x}_{i-1}.$" 1319413953339