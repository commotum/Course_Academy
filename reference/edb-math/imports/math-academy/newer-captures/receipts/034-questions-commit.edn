\\text{i}}\\cdot \\frac{1}{s-3\\text{i}}-\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s+3\\text{i}} \\\\  & =\\frac{1}{2\\text{i}}(\\frac{1}{s-3\\text{i}}-\\frac{1}{s+3\\text{i}}) \\\\  & =\\frac{1}{2\\text{i}}(\\frac{(s+3\\text{i})-(s-3\\text{i})}{(s-3\\text{i})(s+3\\text{i})}) \\\\  & =\\frac{1}{2\\text{i}}(\\frac{6\\text{i}}{{s}^{2}+9}) \\\\  & =\\frac{3}{{s}^{2}+9},\\end{aligned}\n$$\n\ndefined for $s>0.$" 13194139533417 17592186045585 true] [17592186152282 1038 #edb/ref 17592186314705 13194139533417 17592186045585 true] [17592186152282 1038 #edb/ref 17592186314706 13194139533417 17592186045585 true] [17592186152282 1038 #edb/ref 17592186314769 13194139533417 17592186045585 true] [17592186152282 1038 #edb/ref 17592186314770 13194139533417 17592186045585 true] [17592186152287 1038 #edb/ref 17592186314707 13194139533417 17592186045585 true] [17592186152287 1038 #edb/ref 17592186314714 13194139533417 17592186045585 true] [17592186152288 1038 #edb/ref 17592186314716 13194139533417 17592186045585 true] [17592186152288 1038 #edb/ref 17592186314717 13194139533417 17592186045585 true] [17592186152288 1038 #edb/ref 17592186314718 13194139533417 17592186045585 true] [17592186152288 1038 #edb/ref 17592186314719 13194139533417 17592186045585 true] [17592186152288 1038 #edb/ref 17592186314720 13194139533417 17592186045585 true] [17592186152288 1038 #edb/ref 17592186314721 13194139533417 17592186045585 true] [17592186152289 1038 #edb/ref 17592186314727 13194139533417 17592186045585 true] [17592186152289 1038 #edb/ref 17592186314728 13194139533417 17592186045585 true] [17592186152289 1038 #edb/ref 17592186314730 13194139533417 17592186045585 true] [17592186152289 1038 #edb/ref 17592186314731 13194139533417 17592186045585 true] [17592186152300 1038 #edb/ref 17592186314884 13194139533417 17592186045585 true] [17592186152300 1038 #edb/ref 17592186314885 13194139533417 17592186045585 true] [17592186152300 1038 #edb/ref 17592186314886 13194139533417 17592186045585 true] [17592186152584 10