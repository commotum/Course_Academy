}^{′} & {y}_{2}^{′}\\end{aligned}|.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=\\frac{1}{1+{x}^{2}}.$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}=1,\\,{y}_{2}={e}^{-3x},\\,{y}_{3}={e}^{4x}.\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =|\\begin{aligned}1 & {e}^{-3x} & {e}^{4x} \\\\ 0 & -3{e}^{-3x} & 4{e}^{4x} \\\\ 0 & 9{e}^{-3x} & 16{e}^{4x}\\end{aligned}| \\\\  & =(1\\cdot {e}^{-3x}\\cdot {e}^{4x})|\\begin{aligned}1 & 1 & 1 \\\\ 0 & -3 & 4 \\\\ 0 & 9 & 16\\end{aligned}| \\\\  & ={e}^{x}[1(-48-36)-1(0-0)+1(0-0)] \\\\  & =-84{e}^{x}.\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent.\n\nNow, to find ${u}_{1},$ we compute the determinant\n\n$$\n\\begin{aligned}{W}_{1}(x) & ={W}_{1}({y}_{2},{y}_{3}) \\\\  & =|\\begin{aligned}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{-3x} & {e}^{4x} \\\\ -3{e}^{-3x} & 4{e}^{4x}\\end{aligned}| \\\\  & =4{e}^{x}-(-3{e}^{x}) \\\\  & =7{e}^{x}.\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}{u}_{1}(x) & =(-1)^{3-1}\\int \\frac{g(x){W}_{1}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{(\\frac{1}{1+{x}^{2}})(7{e}^{x})}{(-84{e}^{x})}\\,\\text{d}x \\\\  & =-\\frac{1}{12}\\int (\\frac{1}{1+{x}^{2}})\\,\\text{d}x \\\\  & =-\\frac{1}{12}\\operatorname{arctan}⁡x.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317533 1068 #edb/ref 17592186316596 13194139533418 17592186045585 true] [17592186317533 1069 "q-344688" 13194139533418 17592186045585 true] [17592186317533 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317533 1071 "$$\n{y}^{‴}+6{y}^{″}-{y}^{′}-30y=35{e}^{2x}\\operatorname{cos}⁡x,\\,{{y}_{1}={e}^{-5x},\\,{y}_{2}={e}^{-3x},\\,{y}_{3}={e}^{2x}}\n$$\n\nConsider the differential equation and the set of fundamental solutions of the corresponding homogeneous equation above. \nUsing the method of variation of parameters, the particular solution of the equation can be written in the form\n\n$$\n{y}_{p}(x)={u}_{1}(x){e}^{-5x}+{u}_{2}(x){e}^{-3x}+{u}_{3}(x){e}^{2x}.\n$$\n\nWhat is the function ${u}_{3}(x)?$" 13194139533418 17592186045585 true] [17592186317533 1072 #uuid "21f103d8-98ed-5b42-bb5c-843576342514" 13194139533418 17592186045585 true] [17592186317533 1074 "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=|\\begin{aligned}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{aligned}|,\\,{W}_{2}(x)=|\\begin{aligned}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{aligned}|,\\,{W}_{3}(x)=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=35{e}^{2x}\\operatorname{cos}⁡x.$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}={e}^{-5x},\\,{y}_{2}={e}^{-3x},\\,{y}_{3}={e}^{2x}.\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =|\\begin{aligned}{e}^{-5x} & {e}^{-3x} & {e}^{2x} \\\\ -5{e}^{-5x} & -3{e}^{-3x} & 2{e}^{2x} \\\\ 25{e}^{-5x} & 9{e}^{-3x} & 4{e}^{2x}\\end{aligned}| \\\\  & =({e}^{-5x}\\cdot {e}^{-3x}\\cdot {e}^{2x})|\\begin{aligned}1 & 1 & 1 \\\\ -5 & -3 & 2 \\\\ 25 & 9 & 4\\end{aligned}| \\\\  & ={e}^{-6x}[1(-12-18)-1(-20-50)+1(-45+75)] \\\\  & ={e}^{-6x}(-30-(-70)+30) \\\\  & =70{e}^{-6x}\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{3},$ we compute the determinant\n\n$$\n\\begin{aligned}{W}_{3}(x) & ={W}_{3}({y}_{1},{y}_{2}) \\\\  & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{-5x} & {e}^{-3x} \\\\ -5{e}^{-5x} & -3{e}^{-3x}\\end{aligned}| \\\\  & =-3{e}^{-8x}-(-5{e}^{-8x}) \\\\  & =2{e}^{-8x}.\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}{u}_{3}(x) & =(-1)^{3-3}\\int \\frac{g(x){W}_{3}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{(35{e}^{2x}\\operatorname{cos}⁡x)(2{e}^{-8x})}{70{e}^{-6x}}\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317534 1068 #edb/ref 17592186316722 13194139533418 17592186045585 true] [17592186317534 1069 "q-344695" 13194139533418 17592186045585 true] [17592186317534 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317534 1071 "Find the average value ${f}_{\\text{avg}}$ of the function $f(x)=\\operatorname{sin}⁡(3x)$ on the interval $[0,\\frac{\\pi }{3}].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317534 1072 #uuid "ce1dc838-ac3c-58a3-9be3-5a30e3211516" 13194139533418 17592186045585 true] [17592186317534 1074 "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{(\\frac{\\pi }{3}-0)}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{3}{\\pi }{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={\\frac{3}{\\pi }(-\\frac{\\operatorname{cos}⁡(3x)}{3})|}_{0}^{\\pi /3} \\\\  & =\\frac{3}{\\pi }[(-\\frac{1}{3}\\operatorname{cos}⁡(\\pi ))-(-\\frac{1}{3}\\operatorname{cos}⁡(0))] \\\\  & =\\frac{3}{\\pi }[(-\\frac{1}{3}\\cdot (-1))-(-\\frac{1}{3}\\cdot 1)] \\\\  & =\\frac{3}{\\pi }(\\frac{1}{3}+\\frac{1}{3}) \\\\  & =\\frac{3}{\\pi }\\cdot \\frac{2}{3} \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317535 1068 #edb/ref 17592186316725 13194139533418 17592186045585 true] [17592186317535 1069 "q-344699" 13194139533418 17592186045585 true] [17592186317535 1070 #edb/ref 17592186045486 13194139533418 17592186045585 true] [17592186317535 1071 "A biologist found that the population $P$ of some algae in a container can be modeled by the function $P(t)=150+10\\operatorname{sin}⁡(\\frac{\\pi t}{3}),$ where $t$ is the number of hours after $9$ a.m. Find the average number of algae during the period from $9$ a.m. to $3$ p.m. Do not round the answer.\n\n${P}_{\\text{avg}}=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317535 1072 #uuid "74174cfe-6c69-5c75-8eeb-a70591a0502f" 13194139533418 17592186045585 true] [17592186317535 1074 "Since the function is valid starting from $9$ A.M., we can conclude our interval is $[0,6].$\n\nApplying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{P}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}P(t)\\,\\text{d}t \\\\  & =\\frac{1}{6-0}{\\int }_{0}^{6}(150+10\\operatorname{sin}⁡(\\frac{\\pi t}{3}))\\text{d}t \\\\  & ={\\frac{1}{6}(150t-\\frac{30}{\\pi }\\operatorname{cos}⁡(\\frac{\\pi \\,t}{3}))|}_{0}^{6} \\\\  & =\\frac{1}{6}[(150\\cdot 6-\\frac{30}{\\pi }\\operatorname{cos}⁡(\\frac{\\pi \\cdot 6}{3}))-(150\\cdot 0-\\frac{30}{\\pi }\\operatorname{cos}⁡(\\frac{\\pi \\cdot 0}{3}))] \\\\  & =\\frac{1}{6}[(900-\\frac{30}{\\pi }\\operatorname{cos}⁡(2\\pi ))-(-\\frac{30}{\\pi }\\operatorname{cos}⁡(0))] \\\\  & =\\frac{1}{6}[(900-\\frac{30}{\\pi }\\cdot 1)+\\frac{30}{\\pi }\\cdot 1] \\\\  & =\\frac{1}{6}(900) \\\\  & =150.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317536 1068 #edb/ref 17592186316555 13194139533418 17592186045585 true] [17592186317536 1069 "q-344702" 13194139533418 17592186045585 true] [17592186317536 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317536 1071 "![](images/8d/8ddd8493662174e0ddaf9bdd63b0ec382f6bb25c9079f1a339b71400b8cf3860.png)\n\nThe graph of the function $f(x),$ which is defined on $[-6,6],$ is shown above. The areas of the regions between the graph and the $x$-axis are $15$, $60$ and $9,$ respectively (from left to right). \n\nFind the average value of $f(x)$ on $[-6,6].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317536 1072 #uuid "043f4540-5631-5529-81bc-a5f341154556" 13194139533418 17592186045585 true] [17592186317536 1074 "The average value of a function on a given interval is\n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nHere, we see that\n\n$$\n{\\int }_{-6}^{6}f(x)\\,\\text{d}x=-15+60-9=36.\n$$\n\nSo, applying the average value formula, we find that the average value is\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{6-(-6)}\\cdot (36) \\\\  & =\\frac{36}{12} \\\\  & =3.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317537 1068 #edb/ref 17592186317092 13194139533418 17592186045585 true] [17592186317537 1069 "q-344708" 13194139533418 17592186045585 true] [17592186317537 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317537 1071 "![](images/c2/c2e43e711a8c3973e080da7ee0e547b3fdec20ba4536ff7f79f21e8e4683c493.png)\n\nThe graph of the function $f(x),$ which is defined on $[-1,10],$ is shown above. It consists of three line segments and the arc of the semi-circle centered at $(7,0)$ with radius $2.$ \n\nFind the average value ${f}_{\\text{avg}}$ of $f(x)$ on $[1,9].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317537 1072 #uuid "36fcc17b-f182-5712-9f24-ef5d7e7bc1f2" 13194139533418 17592186045585 true] [17592186317537 1074 "The average value of a function on a given interval $[a,b]$ is \n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{1}^{9}f(x)\\,\\text{d}x={{{\\int }_{1}^{5}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{5}^{9}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,5].$ The corresponding region consists of two right triangles, so we find the total area by adding their areas:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}\\cdot 4\\cdot 3 \\\\  & =6\\end{aligned}\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [5,9].$ The corresponding region is a semi-circle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {2}^{2} \\\\  & =2\\pi .\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{5}^{9}f(x)\\,\\text{d}x=-{A}_{2}=-2\\pi .\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2} \\\\  & =6-2\\pi \\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{9-1}\\cdot (6-2\\pi ) \\\\  & =\\frac{6-2\\pi }{8} \\\\  & =\\frac{3-\\pi }{4}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317538 1068 #edb/ref 17592186316818 13194139533418 17592186045585 true] [17592186317538 1069 "q-344715" 13194139533418 17592186045585 true] [17592186317538 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317538 1071 "![](images/df/dfa665cf99f35e5cd2edef04b3f334f0054bbce7fc9b66c519d59d30e77ba2a1.png)\n\nThe graph of the function $f(x),$ which is defined on $[0,10],$ is shown above. It consists of line segments.\n\nFind the average value ${f}_{\\text{avg}}$ of $f(x)$ on $[1,9].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317538 1072 #uuid "f0199315-7b83-568e-8a38-7bc403eadc2a" 13194139533418 17592186045585 true] [17592186317538 1074 "The average value of a function on a given interval $[a,b]$ is \n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{1}^{9}f(x)\\,\\text{d}x={{{\\int }_{1}^{5}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{1}}+{{{\\int }_{5}^{9}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,5].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{1}^{5}f(x)\\,\\text{d}x=-{A}_{1}=-4.\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [5,9].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 3 \\\\  & =6.\\end{aligned}\n$$\n\nSo, we have \n\n$$\n{\\int }_{5}^{9}f(x)\\,\\text{d}x={A}_{2}=6.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}f(x)\\,\\text{d}x & =-{A}_{1}+{A}_{2} \\\\  & =-4+6 \\\\  & =2.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{9-1}\\cdot 2 \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317539 1068 #edb/ref 17592186316895 13194139533418 17592186045585 true] [17592186317539 1069 "q-344716" 13194139533418 17592186045585 true] [17592186317539 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317539 1071 "![](images/10/101c319f12d73a4efaef385850b81b79402aaa5a1b900f1876837ff7045b0dd5.png)\n\nThe graph of the function $f(x),$ which is defined on $[-3,7],$ is shown above. It consists of line segments.\n\nFind the average value ${f}_{\\text{avg}}$ of $f(x)$ on $[-2,6].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317539 1072 #uuid "6a9b3690-5bff-58f7-9210-58693a026b5b" 13194139533418 17592186045585 true] [17592186317539 1074 "The average value of a function on a given interval $[a,b]$ is \n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{-2}^{6}f(x)\\,\\text{d}x={{{\\int }_{-2}^{2}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{2}^{6}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,2].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 1 \\\\  & =2.\\end{aligned}\n$$\n\nSo, we have \n\n$$\n{\\int }_{-2}^{2}f(x)\\,\\text{d}x={A}_{1}=2.\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [2,6].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we have \n\n$$\n{\\int }_{2}^{6}f(x)\\,\\text{d}x=-{A}_{2}=-4.\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{6}f(x)\\,\\text{d}x & ={A}_{1}-{A}_{2} \\\\  & =2-4 \\\\  & =-2.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{6-(-2)}\\cdot (-2) \\\\  & =-\\frac{2}{8} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317540 1068 #edb/ref 17592186316942 13194139533418 17592186045585 true] [17592186317540 1068 #edb/ref 17592186316955 13194139533418 17592186045585 true] [17592186317540 1069 "q-344720" 13194139533418 17592186045585 true] [17592186317540 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317540 1071 "Use calculus to find the coordinates of the closest point to $P(5,-3)$ that is equidistant to the points $A(-2,1)$ and $B(6,1).$\n\nThe coordinates of the required point are\n$($\n{{field-1}}$,$\n{{field-2}}\n$).$" 13194139533418 17592186045585 true] [17592186317540 1072 #uuid "66c79b5d-947b-54d0-a712-f92b4498886c" 13194139533418 17592186045585 true] [17592186317540 1074 "Let's sketch the situation.\n\n![](images/a8/a86fbc456930e18159b1745f5a71fe82bf7075f3aa6d9fd4307a71a583a37a7a.png)\n\nNote the following:\n\n- The dotted line is the *perpendicular bisector* of the segment $\\overset{―}{AB}.$\n\n- All the points on this perpendicular bisector are equidistant to $A$ and $B.$\n\n- Our task is to find the point $Q$ on this line that's closest to $P.$\n\nFirst, we create a function $S$ which represents the *squared* distance between the point $P(5,-3)$ and a general point $Q(x,y),$ as follows:\n\n$$\n\\begin{aligned}S(x,y) & =(x-5)^{2}+(y-(-3))^{2} \\\\  & =(x-5)^{2}+(y+3)^{2} \\\\  & ={x}^{2}+{y}^{2}-10x+6y+34\\end{aligned}\n$$\n\nThe required point $Q(x,y)$ is equidistant to the points $A(-2,1)$ and $B(6,1).$ So, by writing down $(QA)^{2}=(QB)^{2},$ we have the following constraint equation:\n\n$$\n\\begin{aligned}{{(x+2)^{2}+(y-1)^{2}}_{⏟}}_{(QA)^{2}} & ={{(x-6)^{2}+(y-1)^{2}}_{⏟}}_{(QB)^{2}}\\end{aligned}\n$$\n\nWe make $x$ the subject in the constraint equation, as follows:\n\n$$\n\\begin{aligned}(x+2)^{2}+(y-1)^{2} & =(x-6)^{2}+(y-1)^{2} \\\\ {x}^{2}+4x+4+(y-1)^{2} & ={x}^{2}-12x+36+(y-1)^{2} \\\\ \\cancel{{x}^{2}}+\\cancel{(y-1)^{2}}+4x+4 & =\\cancel{{x}^{2}}-12x+36+\\cancel{(y-1)^{2}} \\\\ 4x+12x & =36-4 \\\\ x & =2\\end{aligned}\n$$\n\nSubstituting the above into our expression for $S(x,y),$ we get\n\n$$\n\\begin{aligned}S(y) & =(2)^{2}+{y}^{2}-10(2)+6y+34 \\\\  & =4+{y}^{2}-20+6y+34 \\\\  & ={y}^{2}+6y+18.\\end{aligned}\n$$\n\nNow, we calculate the first derivative,\n\n$$\n{S}^{′}(y)=2y+6,\n$$\n\nand solve ${S}^{′}(y)=0$ to find the stationary point:\n\n$$\n\\begin{aligned}{S}^{′}(y) & =0 \\\\ 2y+6 & =0 \\\\ y & =-3\\end{aligned}\n$$\n\nLet's verify that this stationary point is a minimum. Taking the second derivative, we find\n\n$$\n{S}^{″}(-3)=2>0.\n$$\n\nWe conclude that the stationary point $y=-3$ indeed minimizes the squared distance. \n\nTherefore, the required point is $(\\,2,-3\\,).$" 13194139533418 17592186045585 true] [17592186317541 1068 #edb/ref 17592186316640 13194139533418 17592186045585 true] [17592186317541 1068 #edb/ref 17592186316825 13194139533418 17592186045585 true] [17592186317541 1069 "q-344721" 13194139533418 17592186045585 true] [17592186317541 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317541 1071 "Use calculus to find the coordinates of the closest point to $P(4,5)$ that is equidistant to the points $A(-7,2)$ and $B(3,2).$\n\nThe coordinates of the required point are\n$($\n{{field-1}}$,$\n{{field-2}}\n$).$" 13194139533418 17592186045585 true] [17592186317541 1072 #uuid "61beecde-909c-5434-809a-2f22effdd077" 13194139533418 17592186045585 true] [17592186317541 1074 "Let's sketch the situation.\n\n![](images/e2/e283660466c42f7723d9e044bb2eefe148c468f7dae5a1b5882e2589e7e5f60a.png)\n\nNote the following:\n\n- The dotted line is the *perpendicular bisector* of the segment $\\overset{―}{AB}.$\n\n- All the points on this perpendicular bisector are equidistant to $A$ and $B.$\n\n- Our task is to find the point $Q$ on this line that's closest to $P.$\n\nFirst, we create a function $S$ which represents the *squared* distance between the point $P(4,5)$ and a general point $Q(x,y),$ as follows:\n\n$$\n\\begin{aligned}S(x,y) & =(x-4)^{2}+(y-5)^{2} \\\\  & =(x-4)^{2}+(y-5)^{2} \\\\  & ={x}^{2}+{y}^{2}-8x-10y+41\\end{aligned}\n$$\n\nThe required point $Q(x,y)$ is equidistant to the points $A(-7,2)$ and $B(3,2).$ So, by writing down $(QA)^{2}=(QB)^{2},$ we have the following constraint equation:\n\n$$\n\\begin{aligned}{{(x+7)^{2}+(y-2)^{2}}_{⏟}}_{(QA)^{2}} & ={{(x-3)^{2}+(y-2)^{2}}_{⏟}}_{(QB)^{2}}\\end{aligned}\n$$\n\nWe make $x$ the subject in the constraint equation, as follows:\n\n$$\n\\begin{aligned}(x+7)^{2}+(y-2)^{2} & =(x-3)^{2}+(y-2)^{2} \\\\ {x}^{2}+14x+49+(y-2)^{2} & ={x}^{2}-6x+9+(y-2)^{2} \\\\ \\cancel{{x}^{2}}+\\cancel{(y-2)^{2}}+14x+49 & =\\cancel{{x}^{2}}-6x+9+\\cancel{(y-2)^{2}} \\\\ 14x+6x & =9-49 \\\\ x & =-2\\end{aligned}\n$$\n\nSubstituting the above into our expression for $S(x,y),$ we get\n\n$$\n\\begin{aligned}S(y) & =(-2)^{2}+{y}^{2}-8(-2)-10y+41 \\\\  & =4+{y}^{2}+16-10y+41 \\\\  & ={y}^{2}-10y+61.\\end{aligned}\n$$\n\nNow, we calculate the first derivative,\n\n$$\n{S}^{′}(y)=2y-10,\n$$\n\nand solve ${S}^{′}(y)=0$ to find the stationary point:\n\n$$\n\\begin{aligned}{S}^{′}(y) & =0 \\\\ 2y-10 & =0 \\\\ y & =5\\end{aligned}\n$$\n\nLet's verify that this stationary point is a minimum. Taking the second derivative, we find\n\n$$\n{S}^{″}(5)=2>0.\n$$\n\nWe conclude that the stationary point $y=5$ indeed minimizes the squared distance. \n\nTherefore, the required point is $(\\,-2,5\\,).$" 13194139533418 17592186045585 true] [17592186317542 1068 #edb/ref 17592186317033 13194139533418 17592186045585 true] [17592186317542 1069 "q-344724" 13194139533418 17592186045585 true] [17592186317542 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317542 1071 "![](images/7c/7cfd87cefcfc8d89330ba08f41c1a90392a2cea68550c1bb648362a8f65e68b6.png)\n\nA circular ripple spreads on the surface of a pond in a circular shape. The area of the ripple is increasing at a rate of $6\\pi \\,{\\text{ft}}^{2}\\,/\\text{s}.$ How fast is the radius of the ripple increasing at the moment when the radius is $4\\,\\text{ft}?$ Do not round the answer.\n\nThe radius of the ripple is increasing at a rate of\n{{field-1}}\n$\\text{ft}/\\text{s}.$" 13194139533418 17592186045585 true] [17592186317542 1072 #uuid "c2a090b5-19fc-5fa9-8a7f-20167d785630" 13194139533418 17592186045585 true] [17592186317542 1074 "In this situation, we want to find $\\frac{\\text{d}r}{\\text{d}t}$ at the moment when $r=4,$ and we are also told that $\\frac{\\text{d}A}{\\text{d}t}=6\\pi .$\n\nTo start, let's write down the area formula for the circle and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}A & =\\pi {r}^{2} \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 2\\pi r.\\end{aligned}\n$$\n\nNow, we substitute the given information $\\frac{\\text{d}A}{\\text{d}t}=6\\pi $ and $r=4,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}6\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 2\\pi (4) \\\\ 6\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 8\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{3}{4}.\\end{aligned}\n$$\n\nWe conclude that the radius is increasing at a rate of $\\frac{3}{4}\\,\\text{ft}/\\text{s}.$" 13194139533418 17592186045585 true] [17592186317543 1068 #edb/ref 17592186316724 13194139533418 17592186045585 true] [17592186317543 1069 "q-344744" 13194139533418 17592186045585 true] [17592186317543 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317543 1071 "![](images/98/9854b8b086ef6f60f02a37f2a0885cbcdd41ec24d5548abe1aa2d6fbebe8dbfe.png)\n\nA spherical balloon is being inflated, causing its enclosed volume to increase at a rate of $128\\pi \\text{ }{\\text{cm}}^{3}/\\text{s}.$ How fast is the radius increasing at the moment when the radius is $4\\text{ }\\text{cm}?$ Do not round the answer.\n\nThe radius of the balloon is increasing at a rate of \n{{field-1}} $\\text{cm}/\\text{s}.$" 13194139533418 17592186045585 true] [17592186317543 1072 #uuid "d0ce4b2b-546b-5d49-899e-91e594c8d459" 13194139533418 17592186045585 true] [17592186317543 1074 "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=128\\pi \\,{\\text{cm}}^{3}/\\text{s},\n$$\n\nand we want to find $\\frac{\\text{d}r}{\\text{d}t}$ when $r=4\\,\\text{cm}.$\n\nTo start, let's write down the formula for the volume of a sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=128\\pi $ and $r=4,$ and solve for $\\frac{\\text{d}r}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}128\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi (4)^{2} \\\\ 128\\pi  & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 64\\pi  \\\\ \\frac{\\text{d}r}{\\text{d}t} & =2.\\end{aligned}\n$$\n\nTherefore, when the radius of the balloon is $4\\,\\text{cm},$ the radius is increasing at a rate of $2$ $\\text{ }\\,\\text{cm}/\\text{s}.$" 13194139533418 17592186045585 true] [17592186317544 1068 #edb/ref 17592186316730 13194139533418 17592186045585 true] [17592186317544 1069 "q-344749" 13194139533418 17592186045585 true] [17592186317544 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317544 1071 "![](images/e1/e1aafeb4abd5ee1ee545474ed353bccbfb0986cefccb33779fa5744d735d1bdd.png)\n\nA spherical balloon is inflated at the rate of $48{\\text{ cm}}^{3}\\text{/s}.$ If at a particular moment the balloon's radius is changing at the rate $\\frac{3}{4\\pi }\\text{ cm/s},$ then what is the radius of the balloon at this moment? Do not round the answer.\n\n$r=$\n{{field-1}} $\\text{cm}$" 13194139533418 17592186045585 true] [17592186317544 1072 #uuid "2dafc830-96ac-5240-a52a-f840915b50b8" 13194139533418 17592186045585 true] [17592186317544 1074 "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=48{\\text{ cm}}^{3}\\text{/s},\n$$\n\nand we want to find $r$ when $\\frac{\\text{d}r}{\\text{d}t}=\\frac{3}{4\\pi }\\text{ cm/s}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}V}{\\text{d}t}=48$ and $\\frac{\\text{d}r}{\\text{d}t}=\\frac{3}{4\\pi },$ and solve for $r.$ We get\n\n$$\n\\begin{aligned}48 & =\\frac{3}{4\\pi }\\cdot 4\\pi (r)^{2} \\\\ 48 & =3{r}^{2} \\\\ r & =\\sqrt{16} \\\\ r & =4.\\end{aligned}\n$$\n\nTherefore, the radius at that moment is $4\\text{ }\\text{ cm}.$" 13194139533418 17592186045585 true] [17592186317545 1068 #edb/ref 17592186316866 13194139533418 17592186045585 true] [17592186317545 1069 "q-344751" 13194139533418 17592186045585 true] [17592186317545 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317545 1071 "![](images/28/287add661cff085d1090295f67f87ee80eeaa3d8301ee6632ab54a812a6cd119.png)\n\nA spherical hailstone is melting uniformly, causing its radius to change at a rate of $\\frac{1}{6\\pi }\\,\\text{mm}\\text{/s}.$ If the radius at a certain moment is $15\\,\\text{mm},$ what is the rate at which the surface area is decreasing?\n\nThe surface area of the hailstone is decreasing at a rate of\n{{field-1}} ${\\text{mm}}^{2}\\text{/s}.$" 13194139533418 17592186045585 true] [17592186317545 1072 #uuid "a6cc0140-a8eb-5088-99b0-8b7a894e4ee5" 13194139533418 17592186045585 true] [17592186317545 1074 "Let $r$ be the radius of the hailstone and $A$ its surface area. Both $r$ and $A$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}r}{\\text{d}t}=-\\frac{1}{6\\pi }\\,\\text{mm}\\text{/s},\n$$\n\nand we want to find $\\frac{\\text{d}A}{\\text{d}t}$ when $r=15\\,\\text{mm}.$\n\nTo start, let's write down the surface area formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}A & =4\\pi {r}^{2} \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(4\\pi {r}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(4\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}8\\pi r.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=-\\frac{1}{6\\pi }$ and $r=15.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =-\\frac{1}{6\\pi }\\cdot 8\\pi (15) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =-20.\\end{aligned}\n$$\n\nWe conclude that the surface area of the hailstone is decreasing at a rate of $20{\\text{ mm}}^{2}\\text{/s}.$" 13194139533418 17592186045585 true] [17592186317546 1068 #edb/ref 17592186316681 13194139533418 17592186045585 true] [17592186317546 1069 "q-344761" 13194139533418 17592186045585 true] [17592186317546 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317546 1071 "The function $p(x)$ is continuous over $x\\in [-6,5].$ Some values of $p(x)$ are given in the table below. \n\n| $x$ | $-6$ | $-2$ | $5$ |\n| --- | --- | --- | --- |\n| $p(x)$ | $4$ | $-1$ | $-3$ |\n\nWhat is the smallest possible number of solutions to the equation $p(x)=2?$\n\nThe equation $p(x)=2$ has at least {{field-1}} solutions." 13194139533418 17592186045585 true] [17592186317546 1072 #uuid "9f368f3a-06db-598d-8b7b-f68ccf3faca3" 13194139533418 17592186045585 true] [17592186317546 1074 "Since $p$ is a continuous function on $[-6,5],$ we can apply the Intermediate Value Theorem (IVT) in each subinterval of $[-6,5].$\n\nWe will go through each subinterval of $[-6,5]$ and check if the IVT guarantees a solution to the equation $p(x)=2$ on this interval.\n\n- On the subinterval $[-6,-2],$ we have $p(-6)=4$ and $p(-2)=-1.$ Since $2\\in [-1,4],$ the IVT *does* guarantee a solution to the equation $p(x)=2$ on this subinterval.\n\n- On the subinterval $[-2,5],$ we have $p(-2)=-1$ and $p(5)=-3.$ Since $2\\notin [-3,-1],$ the IVT does *not* guarantee a solution to the equation $p(x)=2$ on this subinterval.\n\nThe IVT guarantees solutions to $p(x)=2$ on $[-6,-2].$  \n\nTherefore, $p(x)=2$ has at least $1$ solutions." 13194139533418 17592186045585 true] [17592186317547 1068 #edb/ref 17592186316554 13194139533418 17592186045585 true] [17592186317547 1068 #edb/ref 17592186316946 13194139533418 17592186045585 true] [17592186317547 1069 "q-344765" 13194139533418 17592186045585 true] [17592186317547 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317547 1071 "![](images/56/56265e4a47a878233f27b1e265158dc766aa410144dfe95a20ce7f672b797802.png)\n\nThe function $f(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ intersects the $x$-axis at the points $x=-4$ and $x=1,$ as shown above. Find the interval on which the function $f(x)$ is concave up.\n\n$f(x)$ is concave up on the interval\n$(${{field-1}}$,$\n{{field-2}}$).$" 13194139533418 17592186045585 true] [17592186317547 1072 #uuid "fda9cc9a-9238-5f8a-a69e-3345e04cfb7b" 13194139533418 17592186045585 true] [17592186317547 1074 "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nFrom the plotted graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the interval $(-4,1).$\n\nTherefore, the function $f(x)$ is concave up on the interval $(\\,-4,1\\,).$" 13194139533418 17592186045585 true] [17592186317548 1068 #edb/ref 17592186316727 13194139533418 17592186045585 true] [17592186317548 1068 #edb/ref 17592186317056 13194139533418 17592186045585 true] [17592186317548 1069 "q-344777" 13194139533418 17592186045585 true] [17592186317548 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317548 1071 "![](images/f0/f03d1f23687273ff94bb2ea4ee45991600c75a237bf4c0a1fdb955d0f00b9b3d.png)\n\nThe function $f(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ intersects the $x$-axis at the points $x=-2$ and $x=3,$ as shown above. Find the interval on which the function $f(x)$ is concave down.\n\n$f(x)$  is concave down on the interval\n$(${{field-1}}$,$\n{{field-2}}$).$" 13194139533418 17592186045585 true] [17592186317548 1072 #uuid "c8c5b0b7-0183-5743-88be-99a5e15c02c6" 13194139533418 17592186045585 true] [17592186317548 1074 "A function $f(x)$ is concave down over an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nFrom the plotted graph of $y={f}^{″}(x)$, we can  see that ${f}^{″}(x)<0$ on the interval   $(-2,3)$ \n\nTherefore, the function $f(x)$ is concave down on the interval $(\\,-2,3\\,).$" 13194139533418 17592186045585 true] [17592186317549 1068 #edb/ref 17592186316645 13194139533418 17592186045585 true] [17592186317549 1068 #edb/ref 17592186316754 13194139533418 17592186045585 true] [17592186317549 1068 #edb/ref 17592186317040 13194139533418 17592186045585 true] [17592186317549 1068 #edb/ref 17592186317144 13194139533418 17592186045585 true] [17592186317549 1069 "q-344779" 13194139533418 17592186045585 true] [17592186317549 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317549 1071 "![](images/a5/a554b63796bbf63daa8fafccb26cec460ec3bf871c4c6c751ee07b0c343d5105.png)\n\nThe function $g(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={g}^{″}(x)$ of the function $g(x)$ intersects the $x$-axis at the points $x=-3,$ $x=-1,$ $x=1,$ $x=3,$ and $x=5,$ as shown above. The intervals on which the function $g(x)$ is concave down are\n\n$(-\\infty ,$\n{{field-1}}$),\\,(${{field-2}}$,$\n{{field-3}}$),\\,(${{field-4}}$,5).$" 13194139533418 17592186045585 true] [17592186317549 1072 #uuid "b20ea425-8620-5685-b919-3cbac659b08f" 13194139533418 17592186045585 true] [17592186317549 1074 "A function $g(x)$ is concave down over an interval $(a,b)$ if ${g}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={g}^{″}(x)$, we can see that ${g}^{″}(x)<0$ on the intervals $(-\\infty ,-3),$ $(-1,1),$ and $(3,5).$ \n\nTherefore, the function $g(x)$ is concave down on the intervals \n\n$$\n(\\,-\\infty ,-3\\,),\\,(\\,-1,1\\,),\\,(\\,3,5\\,).\n$$" 13194139533418 17592186045585 true] [17592186317550 1068 #edb/ref 17592186316658 13194139533418 17592186045585 true] [17592186317550 1068 #edb/ref 17592186316667 13194139533418 17592186045585 true] [17592186317550 1068 #edb/ref 17592186316824 13194139533418 17592186045585 true] [17592186317550 1068 #edb/ref 17592186316912 13194139533418 17592186045585 true] [17592186317550 1069 "q-344783" 13194139533418 17592186045585 true] [17592186317550 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317550 1071 "![](images/34/345b36f79184e0857bfc63693b2be0a968ba308035af9548136c5b7ba692ab52.png)\n\nThe function $g(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={g}^{″}(x)$ of the function $g(x)$ intersects the $x$-axis at the points $x=-5,$ $x=-1,$ $x=1,$ $x=4,$ and $x=6,$ as shown above. The intervals on which the function $g(x)$ is concave up are\n\n$(${{field-1}}$,-5),\\,(${{field-2}}$,$\n{{field-3}}$),\\,(${{field-4}}$,6).$" 13194139533418 17592186045585 true] [17592186317550 1072 #uuid "e9c73842-7356-5343-890f-5fb6e3fc49e7" 13194139533418 17592186045585 true] [17592186317550 1074 "A function $g(x)$ is concave up over an interval $(a,b)$ if ${g}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={g}^{″}(x)$, we can see that ${g}^{″}(x)>0$ on the intervals $(-\\infty ,-5),$ $(-1,1),$ and $(4,6).$ \n\nTherefore, the function $g(x)$ is concave up on the intervals \n\n$$\n(\\,-\\infty ,-5\\,),\\,(\\,-1,1\\,),\\,(\\,4,6\\,).\n$$" 13194139533418 17592186045585 true] [17592186317551 1068 #edb/ref 17592186316666 13194139533418 17592186045585 true] [17592186317551 1069 "q-344797" 13194139533418 17592186045585 true] [17592186317551 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317551 1071 "![](images/c0/c08030e85efbf78256febe491d700aa11a577d76f2a596066cd0fbdc961f320e.png)\n\nThe graph of the function $y=f(x)$ is given above. Find ${f}^{′}(1.5).$\n\n${f}^{′}(1.5)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317551 1072 #uuid "19b2c92b-987c-58cd-99aa-187fa8666394" 13194139533418 17592186045585 true] [17592186317551 1074 "To compute ${f}^{′}(1.5),$ we need to find the slope of the tangent to $f(x)$ at $x=1.5.$\n\nLet's consider the graph of $y=f(x)$ for $x\\in [-1,3].$ Notice that $x=1.5$ lies in this interval.\n\n![](images/56/56cb6eb057efc5bf73e92fea0a78bacdf4bdd1ac43fdd28b23b08bbbbdff346c.png)\n\nThe slope of $y=f(x)$ on $x\\in (-1,3)$ is constant and equals\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{0-2}{3-(-1)}=\\frac{-2}{4}=-0.5.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(1.5)=-0.5.$" 13194139533418 17592186045585 true] [17592186317552 1068 #edb/ref 17592186317145 13194139533418 17592186045585 true] [17592186317552 1069 "q-344798" 13194139533418 17592186045585 true] [17592186317552 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317552 1071 "![](images/b7/b76e1349bb1f32e3d42918c07c8d7a4d07d9d44c834af09e1286356fe1fc77af.png)\n\nThe graph of the function $y=f(x)$ is given above. Find ${f}^{′}(-2).$\n\n${f}^{′}(-2)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317552 1072 #uuid "ce06ffcf-3c56-5b30-acbc-f11d20dae81b" 13194139533418 17592186045585 true] [17592186317552 1074 "To compute ${f}^{′}(-2),$ we need to find the slope of the tangent to $f(x)$ at $x=-2.$\n\nLet's consider the graph of $y=f(x)$ for $x\\in [-5,0].$ Notice that $x=-2$ lies in this interval.\n\n![](images/2f/2f46cbe001623cacc7e7ae8f54d73f2bbc9ce685a9f75ffa93d78a9c621722fe.png)\n\nThe slope of $y=f(x)$ on $x\\in (-5,-1)$ is constant and equals\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{-2-3}{-1-(-5)}=\\frac{-5}{4}=-1.25.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(-2)=-1.25.$" 13194139533418 17592186045585 true] [17592186317553 1068 #edb/ref 17592186316941 13194139533418 17592186045585 true] [17592186317553 1069 "q-344820" 13194139533418 17592186045585 true] [17592186317553 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317553 1071 "Find the $x$-coordinate of the point on the curve $y=\\sqrt{4x+5}+2$ that is closest to the point $(3,2).$ Do not round the answer.\n\n$x=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317553 1072 #uuid "1ea86871-677f-5018-8b77-218ef3d8c222" 13194139533418 17592186045585 true] [17592186317553 1074 "Let us consider the *squared* distance $S$ between $(3,2)$ and a general point $P(x,y)$:\n\n$$\nS=(x-3)^{2}+(y-2)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{4x+5}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-3)^{2}+(y-2)^{2} \\\\  & =(x-3)^{2}+(\\sqrt{4x+5}+2-2)^{2} \\\\  & =(x-3)^{2}+4x+5 \\\\  & ={x}^{2}-6x+9+4x+5 \\\\  & ={x}^{2}-2x+14.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-2 & =0 \\\\ 2x & =2 \\\\ x & =1\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=1$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=1.$" 13194139533418 17592186045585 true] [17592186317554 1068 #edb/ref 17592186316978 13194139533418 17592186045585 true] [17592186317554 1069 "q-344828" 13194139533418 17592186045585 true] [17592186317554 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317554 1071 "$$\n{y}^{‴}+9{y}^{′}=3{e}^{x},\\,{{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(3x),\\,{y}_{3}=\\operatorname{sin}⁡(3x)}\n$$\n\nConsider the differential equation and the set of fundamental solutions of the corresponding homogeneous equation above. \nUsing the method of variation of parameters, the general solution of the equation can be written in the form\n\n$$\ny(x)=A+B\\operatorname{cos}⁡(3x)+C\\operatorname{sin}⁡(3x)+{u}_{1}(x)+{u}_{2}(x)\\operatorname{cos}⁡(3x)+{u}_{3}(x)\\operatorname{sin}⁡(3x).\n$$\n\nWhat is the function ${u}_{1}(x)?$" 13194139533418 17592186045585 true] [17592186317554 1072 #uuid "0af48b1e-a4d2-52ef-83e7-39ee42e46562" 13194139533418 17592186045585 true] [17592186317554 1074 "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=|\\begin{aligned}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{aligned}|,\\,{W}_{2}(x)=|\\begin{aligned}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{aligned}|,\\,{W}_{3}(x)=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=3{e}^{x}.$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(3x),\\,{y}_{3}=\\operatorname{sin}⁡(3x).\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =|\\begin{aligned}1 & \\operatorname{cos}⁡(3x) & \\operatorname{sin}⁡(3x) \\\\ 0 & -3\\operatorname{sin}⁡(3x) & 3\\operatorname{cos}⁡(3x) \\\\ 0 & -9\\operatorname{cos}⁡(3x) & -9\\operatorname{sin}⁡(3x)\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}-3\\operatorname{sin}⁡(3x) & 3\\operatorname{cos}⁡(3x) \\\\ -9\\operatorname{cos}⁡(3x) & -9\\operatorname{sin}⁡(3x)\\end{aligned}| \\\\  & =27{sin}^{2}⁡(3x)-(-27{cos}^{2}⁡(3x)) \\\\  & =27{sin}^{2}⁡(3x)+27{cos}^{2}⁡(3x) \\\\  & =27[{sin}^{2}⁡(3x)+{cos}^{2}⁡(3x)] \\\\  & =27\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{1},$ we compute the determinant ${W}_{1}(x)$:\n\n$$\n\\begin{aligned}{W}_{1}(x) & =|\\begin{aligned}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{cos}⁡(3x) & \\operatorname{sin}⁡(3x) \\\\ -3\\operatorname{sin}⁡(3x) & 3\\operatorname{cos}⁡(3x)\\end{aligned}| \\\\  & =3{cos}^{2}⁡(3x)+3{sin}^{2}⁡(3x) \\\\  & =3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{1}(x) & =(-1)^{3-1}\\int \\frac{g(x){W}_{1}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{3{e}^{x}\\cdot 3}{27}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{3}{e}^{x}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317555 1068 #edb/ref 17592186317089 13194139533418 17592186045585 true] [17592186317555 1069 "q-344831" 13194139533418 17592186045585 true] [17592186317555 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317555 1071 "![](images/be/be3108802cde61c1ffcc5fdf603e97255b4082541f20f628aedd1a01127c05b7.png)\n\nFind the $y$-coordinate of the point on the curve $y=-{x}^{2}+6x$ that is closest to the point $(3,0).$ Do not round the answer.\n\n$y=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317555 1072 #uuid "f99cd707-a840-52a9-bcde-9bf68eca8ff0" 13194139533418 17592186045585 true] [17592186317555 1074 "Let us consider the *squared* distance $S$ between $(3,0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-3)^{2}+(y-0)^{2} \\\\  & ={x}^{2}-6x+9+{y}^{2} \\\\  & ={x}^{2}-6x+{y}^{2}+9\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=-{x}^{2}+6x.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(y) & =-y+{y}^{2}+9 \\\\  & ={y}^{2}-y+9.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(y)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(y)=2y-1 & =0 \\\\ 2y & =1 \\\\ y & =\\frac{1}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(y)=2>0.$ Therefore, $y=\\frac{1}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $y=\\frac{1}{2}.$" 13194139533418 17592186045585 true] [17592186317556 1068 #edb/ref 17592186317079 13194139533418 17592186045585 true] [17592186317556 1069 "q-344832" 13194139533418 17592186045585 true] [17592186317556 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317556 1071 "$$\n{y}^{‴}-2{y}^{″}+4{y}^{′}-8y=(8x+4){e}^{2x},\\,{{y}_{1}={e}^{2x},\\,{y}_{2}=\\operatorname{cos}⁡(2x),\\,{y}_{3}=\\operatorname{sin}⁡(2x)}\n$$\n\nConsider the differential equation and the set of fundamental solutions of the corresponding homogeneous equation above. \nUsing the method of variation of parameters, the general solution of the equation can be written in the form\n\n$$\ny(x)=A{e}^{2x}+B\\operatorname{cos}⁡(2x)+C\\operatorname{sin}⁡(2x)+{u}_{1}(x){e}^{2x}+{u}_{2}(x)\\operatorname{cos}⁡(2x)+{u}_{3}(x)\\operatorname{sin}⁡(2x).\n$$\n\nWhat is the function ${u}_{1}(x)?$" 13194139533418 17592186045585 true] [17592186317556 1072 #uuid "67108ae4-1b19-5925-a524-1cd85ae9a3ef" 13194139533418 17592186045585 true] [17592186317556 1074 "According to the method of variation of parameters, the particular solution is\n\n$$\n{y}_{p}={u}_{1}{y}_{1}+{u}_{2}{y}_{2}+{u}_{3}{y}_{3},\\,{u}_{i}=(-1)^{3-i}\\int \\frac{g(x){W}_{i}(x)}{W(x)}\\,\\text{d}x,\\,i=1,2,3,\n$$\n\nwhere $g(x)$ is the forcing term, $W(x)$ is the Wronskian of ${y}_{1},{y}_{2},{y}_{3},$ and\n\n$$\n\\begin{aligned}{W}_{1}(x)=|\\begin{aligned}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{aligned}|,\\,{W}_{2}(x)=|\\begin{aligned}{y}_{1} & {y}_{3} \\\\ {y}_{1}^{′} & {y}_{3}^{′}\\end{aligned}|,\\,{W}_{3}(x)=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|.\\end{aligned}\n$$\n\nIn our case, the forcing term is $g(x)=(8x+4){e}^{2x}.$ Additionally, we're given the fundamental solutions\n\n$$\n{y}_{1}={e}^{2x},\\,{y}_{2}=\\operatorname{cos}⁡(2x),\\,{y}_{3}=\\operatorname{sin}⁡(2x).\n$$\n\nFirst, let's verify that the fundamental solutions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are independent by computing the Wronskian:\n\n$$\n\\begin{aligned}W(x) & =W({y}_{1},{y}_{2},{y}_{3}) \\\\  & =|\\begin{aligned}{e}^{2x} & \\operatorname{cos}⁡(2x) & \\operatorname{sin}⁡(2x) \\\\ 2{e}^{2x} & -2\\operatorname{sin}⁡(2x) & 2\\operatorname{cos}⁡(2x) \\\\ 4{e}^{2x} & -4\\operatorname{cos}⁡(2x) & -4\\operatorname{sin}⁡(2x)\\end{aligned}| \\\\  & ={e}^{2x}\\cdot |\\begin{aligned}1 & \\operatorname{cos}⁡(2x) & \\operatorname{sin}⁡(2x) \\\\ 2 & -2\\operatorname{sin}⁡(2x) & 2\\operatorname{cos}⁡(2x) \\\\ 4 & -4\\operatorname{cos}⁡(2x) & -4\\operatorname{sin}⁡(2x)\\end{aligned}| \\\\  & ={e}^{2x}[(8{sin}^{2}⁡(2x)+8{cos}^{2}⁡(2x))-2(-4\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x)+4\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(2x))+4(2{sin}^{2}⁡(2x)+2{cos}^{2}⁡(2x))] \\\\  & ={e}^{2x}[8-2(0)+4(2)] \\\\  & =16{e}^{2x}\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions ${y}_{1},$ ${y}_{2},$ and ${y}_{3}$ are linearly independent. \n\nNow, to find ${u}_{1},$ we compute the determinant ${W}_{1}(x)$:\n\n$$\n\\begin{aligned}{W}_{1}(x) & =|\\begin{aligned}{y}_{2} & {y}_{3} \\\\ {y}_{2}^{′} & {y}_{3}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{cos}⁡(2x) & \\operatorname{sin}⁡(2x) \\\\ -2\\operatorname{sin}⁡(2x) & 2\\operatorname{cos}⁡(2x)\\end{aligned}| \\\\  & =2{cos}^{2}⁡(2x)+2{sin}^{2}⁡(2x) \\\\  & =2[{cos}^{2}⁡(2x)+{sin}^{2}⁡(2x)] \\\\  & =2\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{1}(x) & =(-1)^{3-1}\\int \\frac{g(x){W}_{1}(x)}{W(x)}\\,\\text{d}x \\\\  & =\\int \\frac{(8x+4){e}^{2x}\\cdot 2}{16{e}^{2x}}\\,\\text{d}x \\\\  & =\\frac{1}{8}\\int (8x+4)\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int (2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{2}({x}^{2}+x).\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317557 1068 #edb/ref 17592186316624 13194139533418 17592186045585 true] [17592186317557 1069 "q-344837" 13194139533418 17592186045585 true] [17592186317557 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317557 1071 "$$\n{y}^{‴}+{y}^{′}=-{sec}^{3}⁡(x),\\,{{y}_{1}=1,\\,{y}_{2}=\\operatorname{cos}⁡(x),\\,{y}_{3}=\\operatorname{sin}⁡(x)}\n$$\n\nConsider the differential equation and the set of fundamental solutions of the corresponding homogeneous equation above. \nUsing the method of variation of parameters, the general solution of the equation can be written in the form\n\n$$\ny(x)=A+B\\operatorname{cos}⁡(x)+C\\operatorname{sin}⁡(x)+{u}_{1}(x)+{u}_{2}(x)\\operatorname{cos}⁡(x)+{u}_{3}(x