{′} & {y}_{3}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & \\operatorname{sin}⁡(x) \\\\ 0 & \\operatorname{cos}⁡(x)\\end{aligned}| \\\\  & =\\operatorname{cos}⁡(x)-0 \\\\  & =\\operatorname{cos}⁡(x)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{u}_{2}(x) & =(-1)^{3-2}\\int \\frac{g(x){W}_{2}(x)}{W(x)}\\,\\text{d}x \\\\  & =-\\int \\frac{(-{sec}^{3}⁡(x))\\operatorname{cos}⁡(x)}{1}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡(x)\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡(x).\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317558 1068 #edb/ref 17592186316684 13194139533418 17592186045585 true] [17592186317558 1069 "q-344839" 13194139533418 17592186045585 true] [17592186317558 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317558 1071 "![](images/41/4108c44d3fac12cc38c0aab73ed1600f034ad88c1c50be91ea7bb29145ce4dd7.png)\n\nFind the least distance $d$ between the curve $y=\\sqrt{|x-1|}+3$ and the point $(3,3).$ Do not round the answer.\n\n$d=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317558 1072 #uuid "ec33b4cc-e601-5542-983e-0d1fb7c5da6f" 13194139533418 17592186045585 true] [17592186317558 1074 "Let us consider the *squared* distance $S$ between $(3,3)$ and a general point $P(x,y)$:\n\n$$\nS=(x-3)^{2}+(y-3)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{|x-1|}+3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-3)^{2}+(y-3)^{2} \\\\  & =(x-3)^{2}+(\\sqrt{|x-1|}+3-3)^{2} \\\\  & =(x-3)^{2}+(\\sqrt{|x-1|})^{2} \\\\  & =(x-3)^{2}+|x-1|.\\end{aligned}\n$$\n\nFor $x\\ge 1,$ we have $|x-1|=x-1,$ so\n\n$$\n\\begin{aligned}S(x) & =(x-3)^{2}+(x-1) \\\\  & ={x}^{2}-6x+9+x-1 \\\\  & ={x}^{2}-5x+8.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0,$ so $x=\\frac{5}{2}$ gives a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{5}{2}$ is given by\n\n$$\nd=\\sqrt{S\\,(\\frac{5}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(\\frac{5}{2})} \\\\  & =\\sqrt{{(\\frac{5}{2})}^{2}-5(\\frac{5}{2})+8} \\\\  & =\\frac{\\sqrt{7}}{2}\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317559 1068 #edb/ref 17592186316787 13194139533418 17592186045585 true] [17592186317559 1068 #edb/ref 17592186316854 13194139533418 17592186045585 true] [17592186317559 1069 "q-344841" 13194139533418 17592186045585 true] [17592186317559 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317559 1071 "In **ascending order**, the critical points of the function $f(x)={e}^{{x}^{3}-6{x}^{2}}$ are\n\n$x=$\n{{field-1}}\n$\\,$ and $\\,x=$\n{{field-2}}." 13194139533418 17592186045585 true] [17592186317559 1072 #uuid "08ca6181-71e5-5832-a319-13c2fa0f0221" 13194139533418 17592186045585 true] [17592186317559 1074 "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{{x}^{3}-6{x}^{2}}) \\\\  & ={({x}^{3}-6{x}^{2})}^{′}{e}^{{x}^{3}-6{x}^{2}} \\\\  & =(3{x}^{2}-12x){e}^{{x}^{3}-6{x}^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}(3{x}^{2}-12x){e}^{{x}^{3}-6{x}^{2}} & =0\\end{aligned}\n$$\n\nSince ${e}^{{x}^{3}-6{x}^{2}}\\ne 0$ for all $x,$ we can divide this equation by ${e}^{{x}^{3}-6{x}^{2}}$ and solve the resulting equation.\n\n$$\n\\begin{aligned}3{x}^{2}-12x & =0 \\\\ 3x(x-4) & =0 \\\\ x & =0,\\,4\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=0$ and $x=4.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, in ascending order, the critical points of $f(x)$ are  $x=0$ and  $x=4.$" 13194139533418 17592186045585 true] [17592186317560 1068 #edb/ref 17592186316803 13194139533418 17592186045585 true] [17592186317560 1068 #edb/ref 17592186317087 13194139533418 17592186045585 true] [17592186317560 1069 "q-344842" 13194139533418 17592186045585 true] [17592186317560 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317560 1071 "In **ascending order**, the critical points of the function $f(x)={e}^{{x}^{3}-15{x}^{2}/2+12x}$ are\n\n$x=$\n{{field-1}}\n$\\,$ and $\\,x=$\n{{field-2}}." 13194139533418 17592186045585 true] [17592186317560 1072 #uuid "04a4e002-f8db-5f15-9950-79b6717520bb" 13194139533418 17592186045585 true] [17592186317560 1074 "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{{x}^{3}-15{x}^{2}/2+12x}) \\\\  & ={({x}^{3}-\\frac{15}{2}{x}^{2}+12x)}^{′}{e}^{{x}^{3}-15{x}^{2}/2+12x} \\\\  & =(3{x}^{2}-15x+12){e}^{{x}^{3}-15{x}^{2}/2+12x}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}(3{x}^{2}-15x+12){e}^{{x}^{3}-15{x}^{2}/2+12x} & =0\\end{aligned}\n$$\n\nSince ${e}^{{x}^{3}-15{x}^{2}/2+12x}\\ne 0$ for all $x,$ we can divide this equation by ${e}^{{x}^{3}-15{x}^{2}/2+12x}$ and solve the resulting equation.\n\n$$\n\\begin{aligned}3{x}^{2}-15x+12 & =0 \\\\ 3({x}^{2}-5x+4) & =0 \\\\ 3(x-1)(x-4) & =0 \\\\ x & =1,\\,4\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=1$ and $x=4.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, in ascending order, the critical points of $f(x)$ are  $x=1$ and  $x=4.$" 13194139533418 17592186045585 true] [17592186317561 1068 #edb/ref 17592186316923 13194139533418 17592186045585 true] [17592186317561 1069 "q-344845" 13194139533418 17592186045585 true] [17592186317561 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317561 1071 "Find the least distance between the curve $y=\\sqrt{2x+2}+1$ and the point $P(3,1).$ Do not round the answer.\n\n$d=$ \n{{field-1}}" 13194139533418 17592186045585 true] [17592186317561 1072 #uuid "122c6cee-bf10-5dae-9026-d36e3c1571ad" 13194139533418 17592186045585 true] [17592186317561 1074 "Let us consider the *squared* distance $S$ between $(3,1)$ and a general point $P(x,y):$\n\n$$\n\\begin{aligned}S & =(x-3)^{2}+(y-1)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{2x+2}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-3)^{2}+(y-1)^{2} \\\\  & =(x-3)^{2}+{(\\sqrt{2x+2}+1-1)}^{2} \\\\  & =(x-3)^{2}+(\\sqrt{2x+2})^{2} \\\\  & =(x-3)^{2}+2x+2 \\\\  & ={x}^{2}-6x+9+2x+2 \\\\  & ={x}^{2}-4x+11.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=2$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=2$ is given by\n\n$$\nd=\\sqrt{S\\,(2)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(2)} \\\\  & =\\sqrt{(2)^{2}-4(2)+11} \\\\  & =\\sqrt{4-8+11} \\\\  & =\\sqrt{7}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317562 1068 #edb/ref 17592186317121 13194139533418 17592186045585 true] [17592186317562 1069 "q-344846" 13194139533418 17592186045585 true] [17592186317562 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317562 1071 "Find the least distance between the curve $y=\\sqrt{(x-1)^{2}+4}+2$ and the point $P(1,2).$ Do not round the answer.\n\n$d=$ \n{{field-1}}" 13194139533418 17592186045585 true] [17592186317562 1072 #uuid "f8d58508-0e94-5f28-a4e6-94f008c58ecf" 13194139533418 17592186045585 true] [17592186317562 1074 "Let us consider the *squared* distance $S$ between $(1,2)$ and a general point $P(x,y):$\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-2)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{(x-1)^{2}+4}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-2)^{2} \\\\  & =(x-1)^{2}+{(\\sqrt{(x-1)^{2}+4}+2-2)}^{2} \\\\  & =(x-1)^{2}+(\\sqrt{(x-1)^{2}+4})^{2} \\\\  & =(x-1)^{2}+(x-1)^{2}+4 \\\\  & =2{x}^{2}-4x+6.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=4x-4 & =0 \\\\ 4x & =4 \\\\ x & =1\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=4>0.$ Therefore, $x=1$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=1$ is given by\n\n$$\nd=\\sqrt{S\\,(1)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(1)} \\\\  & =\\sqrt{2(1)^{2}-4(1)+6} \\\\  & =\\sqrt{2-4+6} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317563 1068 #edb/ref 17592186316662 13194139533418 17592186045585 true] [17592186317563 1068 #edb/ref 17592186316693 13194139533418 17592186045585 true] [17592186317563 1069 "q-344857" 13194139533418 17592186045585 true] [17592186317563 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317563 1071 "In **ascending order**, the critical points of the function $f(x)=(x+1)^{3}{e}^{x-1}$ are\n\n$x=$\n{{field-1}}\n$\\,$ and $\\,x=$\n{{field-2}}." 13194139533418 17592186045585 true] [17592186317563 1072 #uuid "f07da4ca-ba53-5445-a99b-ad0e59702ec6" 13194139533418 17592186045585 true] [17592186317563 1074 "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}((x+1)^{3}{e}^{x-1}) \\\\  & ={((x+1)^{3})}^{′}{e}^{x-1}+(x+1)^{3}{({e}^{x-1})}^{′} \\\\  & =3(x+1)^{2}{e}^{x-1}+(x+1)^{3}{e}^{x-1} \\\\  & =[3(x+1)^{2}+(x+1)^{3}]{e}^{x-1} \\\\  & =(x+1)^{2}(x+4){e}^{x-1}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)^{2}(x+4){e}^{x-1} & =0\\end{aligned}\n$$\n\nSince ${e}^{x-1}\\ne 0$ for all $x,$ we can divide this equation by ${e}^{x-1}$ and solve the resulting equation.\n\n$$\n\\begin{aligned}(x+1)^{2}(x+4) & =0 \\\\ x & =-4,\\,-1\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-4$ and $x=-1.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, in ascending order, the critical points of $f(x)$ are\n\n$$\nx=-4\\,\\text{and}\\,x=-1.\n$$" 13194139533418 17592186045585 true] [17592186317564 1068 #edb/ref 17592186316691 13194139533418 17592186045585 true] [17592186317564 1068 #edb/ref 17592186316739 13194139533418 17592186045585 true] [17592186317564 1068 #edb/ref 17592186317063 13194139533418 17592186045585 true] [17592186317564 1069 "q-344861" 13194139533418 17592186045585 true] [17592186317564 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317564 1071 "In **ascending order**, the critical points of the function  $f(x)=({x}^{2}-1){e}^{-{x}^{2}}$ are\n\n$x=$\n{{field-1}}$,\\,x=$\n{{field-2}}$,\\,$ and $\\,x=$\n{{field-3}}." 13194139533418 17592186045585 true] [17592186317564 1072 #uuid "1461dec5-7f28-597e-9eeb-b3c3d50ac155" 13194139533418 17592186045585 true] [17592186317564 1074 "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(({x}^{2}-1){e}^{-{x}^{2}}) \\\\  & ={({x}^{2}-1)}^{′}{e}^{-{x}^{2}}+({x}^{2}-1){({e}^{-{x}^{2}})}^{′} \\\\  & =2x{e}^{-{x}^{2}}+({x}^{2}-1)(-2x){e}^{-{x}^{2}} \\\\  & =2x{e}^{-{x}^{2}}(1-({x}^{2}-1)) \\\\  & =2x(2-{x}^{2}){e}^{-{x}^{2}} \\\\  & =-2x({x}^{2}-2){e}^{-{x}^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}-2x({x}^{2}-2){e}^{-{x}^{2}} & =0\\end{aligned}\n$$\n\nSince ${e}^{-{x}^{2}}\\ne 0$ for all $x,$ we can divide this equation by ${e}^{-{x}^{2}}$ and solve the resulting equation.\n\n$$\n\\begin{aligned}-2x({x}^{2}-2) & =0 \\\\ -2x(x-\\sqrt{2})(x+\\sqrt{2}) & =0 \\\\ x & =-\\sqrt{2},\\,0,\\,\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-\\sqrt{2},$ $x=0,$ and $x=\\sqrt{2}.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, in ascending order, the critical points of $f(x)$ are\n\n$$\nx=-\\sqrt{2},\\,x=0,\\,\\text{and}\\,x=\\sqrt{2}.\n$$" 13194139533418 17592186045585 true] [17592186317565 1068 #edb/ref 17592186316962 13194139533418 17592186045585 true] [17592186317565 1068 #edb/ref 17592186317051 13194139533418 17592186045585 true] [17592186317565 1069 "q-344867" 13194139533418 17592186045585 true] [17592186317565 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317565 1071 "In **ascending order**, the critical points of the function  $f(x)=\\frac{x+1}{{x}^{2}+8}$ are\n\n$x=$\n{{field-1}}\n$\\,$ and $\\,x=$\n{{field-2}}." 13194139533418 17592186045585 true] [17592186317565 1072 #uuid "aad5d828-6e42-525d-9e43-aca27206e282" 13194139533418 17592186045585 true] [17592186317565 1074 "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{d}{dx}\\,(\\frac{x+1}{{x}^{2}+8}) \\\\  & =\\frac{(x+1)^{′}\\cdot ({x}^{2}+8)-(x+1)\\cdot ({x}^{2}+8)^{′}}{({x}^{2}+8)^{2}} \\\\  & =\\frac{(1)\\cdot ({x}^{2}+8)-(x+1)\\cdot (2x)}{({x}^{2}+8)^{2}} \\\\  & =\\frac{{x}^{2}+8-(2{x}^{2}+2x)}{({x}^{2}+8)^{2}} \\\\  & =\\frac{-{x}^{2}-2x+8}{({x}^{2}+8)^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}\\frac{-{x}^{2}-2x+8}{({x}^{2}+8)^{2}} & =0 \\\\ -{x}^{2}-2x+8 & =0 \\\\ {x}^{2}+2x-8 & =0 \\\\ (x+4)(x-2) & =0 \\\\ x & =-4,\\,2\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-4$ and $x=2.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So, $f(x)$ has no non-stationary critical points.\n\nTherefore, in ascending order, the critical points of $f(x)$ are \n\n$$\nx=-4\\,\\text{and}\\,x=2.\n$$" 13194139533418 17592186045585 true] [17592186317566 1068 #edb/ref 17592186316758 13194139533418 17592186045585 true] [17592186317566 1068 #edb/ref 17592186316909 13194139533418 17592186045585 true] [17592186317566 1068 #edb/ref 17592186316929 13194139533418 17592186045585 true] [17592186317566 1069 "q-344876" 13194139533418 17592186045585 true] [17592186317566 1070 #edb/ref 17592186045486 13194139533418 17592186045585 true] [17592186317566 1071 "![](images/4f/4fde1cad718fe9630dfa1ee1a498139b5b4dbebedf2139acd6eb43c84336b9cb.png)\n\nThe graph above shows $y={f}^{″}(x).$ The intervals on which the function $f(x)$ is concave up are\n\n$($\n{{field-1}}$,1)\\,$\nand \n$\\,(${{field-2}}$,$\n{{field-3}}$).$" 13194139533418 17592186045585 true] [17592186317566 1072 #uuid "d1e79021-19cd-52ab-bc74-853cff092a0d" 13194139533418 17592186045585 true] [17592186317566 1074 "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the intervals  $(0,1)$ and  $(1,2).$  Therefore, the function $f(x)$ is concave up on the intervals\n\n$$\n(\\,0,1\\,)\\,\\text{and}\\,(\\,1,2\\,).\n$$" 13194139533418 17592186045585 true] [17592186317567 1068 #edb/ref 17592186316731 13194139533418 17592186045585 true] [17592186317567 1069 "q-344884" 13194139533418 17592186045585 true] [17592186317567 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317567 1071 "![](images/33/338c4ecb15136af6f7dca3eb9cf01e396ba1df7f64525bebeaa435cb800b618b.png)\n\nThe graphs of the functions $y=f(x)$ and $y=g(x)$ are given above. Find ${h}^{′}(-2)$ where $h(x)=2f(x)-3g(x).$\n\n${h}^{′}(-2)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317567 1072 #uuid "04470b7c-bb69-568e-b6bb-5495f6330af4" 13194139533418 17592186045585 true] [17592186317567 1074 "The addition and constant multiple rules for derivatives give\n\n$$\n{h}^{′}(x)=2{f}^{′}(x)-3{g}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(-2)=2{f}^{′}(-2)-3{g}^{′}(-2).\n$$\n\nAlso, notice that $x=-2$ corresponds to\n\n- the interval $x\\in (-3,0)$ for the function $f,$ and\n\n- the interval $x\\in (-3,0)$ for the function $g,$\n\nas shown below.\n\n![](images/97/97303b0f041d638b25388c322828f59bb335a8bf20a7641a62edcbae87490c64.png)\n\n- The slope of $y=f(x)$ is constant on $x\\in (-3,0)$ and equals\n\n$$\n\\frac{Δf}{Δx}=\\frac{2-(-1)}{0-(-3)}=1.\n$$\n\nTherefore, ${f}^{′}(-2)=1.$\n\n- The slope of $y=g(x)$ is constant on $x\\in (-3,0)$ and equals\n\n$$\n\\frac{Δg}{Δx}=\\frac{0-3}{0-(-3)}=-1.\n$$\n\nTherefore, ${g}^{′}(-2)=-1.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(-2) & =2{f}^{′}(-2)-3{g}^{′}(-2) \\\\  & =2(1)-3(-1) \\\\  & =5.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317568 1068 #edb/ref 17592186316628 13194139533418 17592186045585 true] [17592186317568 1069 "q-344894" 13194139533418 17592186045585 true] [17592186317568 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317568 1071 "![](images/bd/bd78704be61e30879d4e659a255f93f5c8b6e560951d06b23cf547c8846b01ee.png)\n\nThe graphs of the functions $y=f(x)$ and $y=h(x)$ are given above. Find ${p}^{′}(2)$ where $p(x)=f(x)h(x).$\n\n${p}^{′}(2)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317568 1072 #uuid "685db69b-5eb1-53eb-860a-8d2e205a080e" 13194139533418 17592186045585 true] [17592186317568 1074 "The product rule for derivatives gives\n\n$$\n{p}^{′}(x)={f}^{′}(x)\\cdot h(x)+f(x)\\cdot {h}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{p}^{′}(2)={f}^{′}(2)\\cdot h(2)+f(2)\\cdot {h}^{′}(2).\n$$\n\nFrom the graphs above, we obtain that $f(2)=\\frac{3}{2}$ and $h(2)=0.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (1,3)$ equals $\\frac{1}{2}.$ So, ${f}^{′}(2)=\\frac{1}{2}.$\n\n- The slope of $h(x)$ on $x\\in (1,3)$ equals $2.$ So, ${h}^{′}(2)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{p}^{′}(2) & ={f}^{′}(2)\\cdot h(2)+f(2)\\cdot {h}^{′}(2) \\\\  & =(\\frac{1}{2})\\cdot 0+(\\frac{3}{2})\\cdot 2 \\\\  & =3.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317569 1068 #edb/ref 17592186316647 13194139533418 17592186045585 true] [17592186317569 1069 "q-344896" 13194139533418 17592186045585 true] [17592186317569 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317569 1071 "![](images/84/847d1ae3ff7602ae8793ec356dd3034650d8ba85adcb3be579097e46728667a0.png)\n\nThe graphs of the functions $y=f(x)$ and $y=g(x)$ are given above. Find ${p}^{′}(3)$ where $p(x)=f(x)g(x).$\n\n${p}^{′}(3)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317569 1072 #uuid "a3365bab-5c03-5432-8787-0f1fa7a1200c" 13194139533418 17592186045585 true] [17592186317569 1074 "The product rule for derivatives gives\n\n$$\n{p}^{′}(x)={f}^{′}(x)\\cdot g(x)+f(x)\\cdot {g}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{p}^{′}(3)={f}^{′}(3)\\cdot g(3)+f(3)\\cdot {g}^{′}(3).\n$$\n\nFrom the graphs above, we obtain that $f(3)=\\frac{1}{2}$ and $g(3)=1.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (2,4)$ equals $\\frac{1}{2}.$ So, ${f}^{′}(3)=\\frac{1}{2}.$\n\n- The slope of $g(x)$ on $x\\in (2,4)$ equals $2.$ So, ${g}^{′}(3)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{p}^{′}(3) & ={f}^{′}(3)\\cdot g(3)+f(3)\\cdot {g}^{′}(3) \\\\  & =(\\frac{1}{2})\\cdot 1+(\\frac{1}{2})\\cdot 2 \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317570 1068 #edb/ref 17592186316619 13194139533418 17592186045585 true] [17592186317570 1069 "q-344897" 13194139533418 17592186045585 true] [17592186317570 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317570 1071 "![](images/7a/7af6b87184781cf0f6a3132f375e7917bf4f4cd8ef8b0a4979ab949ac9d6b6c7.png)\n\nThe graphs of the functions $y=f(x)$ and $y=h(x)$ are given above. Find ${p}^{′}(2)$ where $p(x)=f(x)h(x).$\n\n${p}^{′}(2)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317570 1072 #uuid "982f2951-5071-5227-bbfa-016bc05059cf" 13194139533418 17592186045585 true] [17592186317570 1074 "The product rule for derivatives gives\n\n$$\n{p}^{′}(x)={f}^{′}(x)\\cdot h(x)+f(x)\\cdot {h}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{p}^{′}(2)={f}^{′}(2)\\cdot h(2)+f(2)\\cdot {h}^{′}(2).\n$$\n\nFrom the graphs above, we obtain that $f(2)=1$ and $h(2)=-1.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (1,3)$ equals $-1.$ So, ${f}^{′}(2)=-1.$\n\n- The slope of $h(x)$ on $x\\in (1,3)$ equals $-2.$ So, ${h}^{′}(2)=-2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{p}^{′}(2) & ={f}^{′}(2)\\cdot h(2)+f(2)\\cdot {h}^{′}(2) \\\\  & =(-1)\\cdot (-1)+1\\cdot (-2) \\\\  & =-1.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317571 1068 #edb/ref 17592186316769 13194139533418 17592186045585 true] [17592186317571 1069 "q-344901" 13194139533418 17592186045585 true] [17592186317571 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317571 1071 "![](images/2d/2d98be8a4f23dd7c8708fd6b9b5b5956b58ceb33bf5223c6eee5222735ccc10e.png)\n\nThe graphs of the functions $y=f(x)$ and $y=h(x)$ are given above. Find ${p}^{′}(0)$ where $p(x)=f(x)h(x).$\n\n${p}^{′}(0)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317571 1072 #uuid "10c39016-49f7-50ea-942b-69df9d1476fc" 13194139533418 17592186045585 true] [17592186317571 1074 "The product rule for derivatives gives\n\n$$\n{p}^{′}(x)={f}^{′}(x)\\cdot h(x)+f(x)\\cdot {h}^{′}(x).\n$$\n\nAs a result, we have that\n\n$$\n{p}^{′}(0)={f}^{′}(0)\\cdot h(0)+f(0)\\cdot {h}^{′}(0).\n$$\n\nFrom the graphs above, we obtain that $f(0)=-1$ and $h(0)=-3.$\n\nAdditionally,\n\n- The slope of $f(x)$ on $x\\in (-2,1)$ equals $-1.$ So, ${f}^{′}(0)=-1.$\n\n- The slope of $h(x)$ on $x\\in (-2,1)$ equals $-1.$ So, ${h}^{′}(0)=-1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{p}^{′}(0) & ={f}^{′}(0)\\cdot h(0)+f(0)\\cdot {h}^{′}(0) \\\\  & =(-1)\\cdot (-3)+(-1)\\cdot (-1) \\\\  & =4.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317572 1068 #edb/ref 17592186316609 13194139533418 17592186045585 true] [17592186317572 1069 "q-344910" 13194139533418 17592186045585 true] [17592186317572 1070 #edb/ref 17592186045486 13194139533418 17592186045585 true] [17592186317572 1071 "![](images/9d/9d7feec44f6c49abea5029cc733540f96b4e0f044aaf55dd1a38cf0f76a51a54.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(2)$ where $h(x)=\\frac{f(x)}{g(x)}.$\n\n${h}^{′}(2)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317572 1072 #uuid "bcba86ad-05e3-5468-b385-b88fe093d97c" 13194139533418 17592186045585 true] [17592186317572 1074 "The quotient rule for derivatives gives\n\n$$\n{h}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(2)=\\frac{{f}^{′}(2)\\cdot g(2)-f(2)\\cdot {g}^{′}(2)}{(g(2))^{2}}.\n$$\n\nFrom the graphs above, we obtain that $f(2)=3$ and $g(2)=-2.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (1,3)$ equals $0.$ So, ${f}^{′}(2)=0.$\n\n- The slope of $g(x)$ on $x\\in (1,3)$ equals $2.$ So, ${g}^{′}(2)=2.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(2) & =\\frac{{f}^{′}(2)\\cdot g(2)-f(2)\\cdot {g}^{′}(2)}{(g(2))^{2}} \\\\  & =\\frac{0\\cdot (-2)-3\\cdot 2}{{(-2)}^{2}} \\\\  & =\\frac{-6}{4} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317573 1068 #edb/ref 17592186316663 13194139533418 17592186045585 true] [17592186317573 1069 "q-344914" 13194139533418 17592186045585 true] [17592186317573 1070 #edb/ref 17592186045486 13194139533418 17592186045585 true] [17592186317573 1071 "![](images/f2/f23d8acd8b59e630987fd9a04b71a5e0813f5c084f22489af342ba04c34eb003.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(-1)$ where $h(x)=\\frac{f(x)}{g(x)}.$\n\n${h}^{′}(-1)=$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317573 1072 #uuid "204c07af-7a93-54e7-bec3-21115302d481" 13194139533418 17592186045585 true] [17592186317573 1074 "The quotient rule for derivatives gives\n\n$$\n{h}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(-1)=\\frac{{f}^{′}(-1)\\cdot g(-1)-f(-1)\\cdot {g}^{′}(-1)}{(g(-1))^{2}}.\n$$\n\nFrom the graphs above, we obtain that $f(-1)=1$ and $g(-1)=2.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (-3,1)$ equals $1.$ So, ${f}^{′}(-1)=1.$\n\n- The slope of $g(x)$ on $x\\in (-3,1)$ equals $\\frac{1}{2}.$ So, ${g}^{′}(-1)=\\frac{1}{2}.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(-1) & =\\frac{{f}^{′}(-1)\\cdot g(-1)-f(-1)\\cdot {g}^{′}(-1)}{(g(-1))^{2}} \\\\  & =\\frac{1\\cdot 2-1\\cdot (\\frac{1}{2})}{(2)^{2}} \\\\  & =\\frac{\\frac{3}{2}}{4} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317574 1068 #edb/ref 17592186316736 13194139533418 17592186045585 true] [17592186317574 1069 "q-345027" 13194139533418 17592186045585 true] [17592186317574 1070 #edb/ref 17592186045485 13194139533418 17592186045585 true] [17592186317574 1071 "![](images/e8/e81e7d9d60e38c52f86c5eee784ebcfdeb91d4445b6539cc01a6ac9f5ededa89.png)\n\nThe area under the curve $y=\\frac{6}{x}$ between $x=1$, $x=6$ and the $x$-axis is approximated using a left Riemann sum, as shown above. What is the expression for the left Riemann sum ${S}_{L}$ in sigma notation?\n\n*Hint: Write down the expression in terms of $k.$*\n\n${S}_{L}={\\sum }_{k=0}^{4}$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317574 1072 #uuid "c672e36d-a443-5d10-a208-7447fea574e2" 13194139533418 17592186045585 true] [17592186317574 1074 "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{S}_{L}={\\sum }_{k=0}^{n-1}f({x}_{k})Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ with $Δx=\\frac{b-a}{n}.$\n\nFrom the diagram, we see that there are $n=5$ rectangles. The endpoints indicate that $a=1$ and $b=6,$ so the step size is\n\n$$\nΔx=\\frac{6-1}{5}=1.\n$$\n\nTherefore, using sigma notation, the left Riemann sum ${S}_{L}$ can be expressed as\n\n$$\n\\begin{aligned}{S}_{L}={\\sum }_{k=0}^{n-1}f({x}_{k})Δx & ={\\sum }_{k=0}^{n-1}f(a+kΔx)Δx \\\\  & ={\\sum }_{k=0}^{5-1}f(1+k\\cdot 1)\\cdot 1 \\\\  & ={\\sum }_{k=0}^{4}f(1+k) \\\\  & ={\\sum }_{k=0}^{4}\\frac{6}{1+k}.\\end{aligned}\n$$" 13194139533418 17592186045585 true] [17592186317575 1068 #edb/ref 17592186316690 13194139533418 17592186045585 true] [17592186317575 1069 "q-345037" 13194139533418 17592186045585 true] [17592186317575 1070 #edb/ref 17592186045487 13194139533418 17592186045585 true] [17592186317575 1071 "The area under the curve $y=\\sqrt{4x+8}$ between $x=-2$ and $x=2$ and the $x$-axis is approximated by a right Riemann sum using $8$ subintervals of equal length. What is the expression for the right Riemann sum ${S}_{R}$ in sigma notation?\n\n*Hint: Write down the expression in terms of $i.$*\n\n${S}_{R}=\\frac{1}{2}{\\sum }_{i=1}^{8}$\n{{field-1}}" 13194139533418 17592186045585 true] [17592186317575 1072 #uuid "262ea3e2-0286-569e-9bb1-c84346f66411" 13194139533418 17592186045585 true] [17592186317575 1074 "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is   \n\n$$\n{S}_{R}={\\sum }_{i=1}^{n}f({x}_{i})Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nWe're told that there are $n=8$ subintervals. The endpoints indicate that $a=-2$ and $b=2.$ So, the step size is\n\n$$\nΔx=\\frac{2-(-2)}{8}=\\frac{4}{8}=\\frac{1}{2}.\n$$\n\nTherefore, using sigma notation, the right Riemann sum ${S}_{R}$ can be expressed as\n\n$$\n\\begin{aligned}{S}_{R}={\\sum }_{i=1}^{n}f({x}_{i})Δx & ={\\sum }_{i=1}^{n}f(a+iΔx)Δx \\\\  & ={\\sum }_{i=1}^{n}f(-2+i\\cdot \\frac{1}{2})\\cdot \\frac{1}{2} \\\\  & ={\\sum }_{i=1}^{8}f(-2+\\frac{i}{2})\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{2}{\\sum }_{i=1}^{8}\\,\\sqrt{4\\,(-2+\\frac{i}{2})+8} \\\\  & =\\frac{1}{2}{\\sum }_{i=1}^{8}\\,\\sqrt{2i}.\\end{aligned}\n$$" 13194139533418 17592186045585 true]] :edb/tempids {"answer-000aed7e-35ac-576a-a3d7-c9129bf6c269" 17592186315117 "answer-001d17a1-87cd-5834-a656-b3f42b9b78f7" 17592186315118 "answer-002a8adc-95e9-5fd0-9071-7bcfbfd23cbb" 17592186315119 "answer-0037eb03-213e-5d10-a8b1-2c3b156f0fd9" 17592186315120 "answer-006d79e5-194b-5928-a454-a9e6ef2988ee" 17592186315121 "answer-008c957b-5932-51e6-82e7-283ff77f4652" 17592186315122 "answer-009076e7-87b7-576e-bbb7-5638940d7dfc" 17592186315123 "answer-00c15c0d-3f63-5626-8437-1d07dfb1c869" 17592186315124 "answer-00fee262-72db-540e-b20a-2e832d975d