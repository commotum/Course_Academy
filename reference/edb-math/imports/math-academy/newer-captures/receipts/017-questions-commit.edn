′}(\\pi ),$ and $‖{r}^{′}(\\pi )‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t,\\,{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t⟩ \\\\  & ={e}^{-t}⟨-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩ \\\\ {r}^{′}(\\pi ) & ={e}^{-\\pi }⟨-\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi ,\\,\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi ⟩ \\\\  & ={e}^{-\\pi }⟨1,\\,-1⟩ \\\\ ‖{r}^{′}(\\pi )‖ & ={e}^{-\\pi }\\sqrt{{1}^{2}+(-1)^{2}} \\\\  & ={e}^{-\\pi }\\sqrt{2}\\end{aligned}\n$$\n\nNow, we calculate ${r}^{″}(t)$ and evaluate it at $t=\\pi :$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨2{e}^{-t}\\operatorname{sin}⁡t,\\,-2{e}^{-t}\\operatorname{cos}⁡t⟩ \\\\  & =2{e}^{-t}⟨\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t⟩ \\\\ {r}^{″}(\\pi ) & =2{e}^{-\\pi }⟨\\operatorname{sin}⁡\\pi ,\\,-\\operatorname{cos}⁡\\pi ⟩ \\\\  & =2{e}^{-\\pi }⟨0,\\,1⟩\\end{aligned}\n$$\n\nNext, we compute the cross product by considering ${r}^{′}(\\pi )$ and ${r}^{″}(\\pi )$ as $3$-dimensional vectors with zero $z$-components:\n\n$$\n\\begin{aligned}{r}^{′}(\\pi )\\times {r}^{″}(\\pi ) & ={e}^{-\\pi }⟨1,\\,-1,\\,0⟩\\times 2{e}^{-\\pi }⟨0,\\,1,\\,0⟩ \\\\  & =2{e}^{-2\\pi }\\,\\left|\\begin{aligned}i & j & k \\\\ 1 & -1 & 0 \\\\ 0 & 1 & 0\\end{aligned}\\right| \\\\  & =2{e}^{-2\\pi }\\,\\left|\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}\\right|\\,k \\\\  & =2{e}^{-2\\pi }k \\\\ ‖{r}^{′}(\\pi )\\times {r}^{″}(\\pi )‖ & =2{e}^{-2\\pi }\\end{aligned}\n$$\n\nTherefore, the radius of curvature at $t=\\pi $ is\n\n$$\n\\begin{aligned}R(\\pi ) & =\\frac{‖{r}^{′}(\\pi ){‖}^{3}}{‖{r}^{′}(\\pi )\\times {r}^{″}(\\pi )‖} \\\\  & =\\frac{({e}^{-\\pi }\\sqrt{2})^{3}}{2{e}^{-2\\pi }} \\\\  & =\\frac{2\\sqrt{2}{e}^{-3\\pi }}{2{e}^{-2\\pi }} \\\\  & =\\sqrt{2}{e}^{-\\pi }.\\end{aligned}\n$$" 13194139533400 17592186045585 true] [17592186266147 1068 #edb/ref 17592186265678 13194139533400 17592186045585 true] [17592186266147 1069 "q-132130" 13194139533400 17592186045585 true] [17592186266147 1070 #edb/ref 17592186045486 13194139533400 17592186045585 true] [17592186266147 1071 "Find the radius of the osculating circle at the point where $t=0$ for the curve $r(t)=⟨t\\operatorname{cos}⁡t,\\,t\\operatorname{sin}⁡t⟩.$" 13194139533400 17592186045585 true] [17592186266147 1072 #uuid "cf0c275d-135e-528b-bd00-cb3abdf966eb" 13194139533400 17592186045585 true] [17592186266147 1074 "Since we are given only the curve $r(t)$, we will use the cross product formula to find the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t){‖}^{3}}{‖{r}^{′}(t)\\times {r}^{″}(t)‖}\n$$\n\nFirst, we calculate ${r}^{′}(t)$, ${r}^{′}(0),$ and $‖{r}^{′}(0)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t,\\,\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t⟩ \\\\ {r}^{′}(0) & =⟨\\operatorname{cos}⁡0-0\\operatorname{sin}⁡0,\\,\\operatorname{sin}⁡0+0\\operatorname{cos}⁡0⟩ \\\\  & =⟨1,\\,0⟩ \\\\ ‖{r}^{′}(0)‖ & =1\\end{aligned}\n$$\n\nNow, we calculate ${r}^{″}(t)$ and evaluate it at $t=0:$\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)⟩ \\\\  & =⟨-2\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t⟩ \\\\ {r}^{″}(0) & =⟨-2\\operatorname{sin}⁡0-0\\operatorname{cos}⁡0,\\,2\\operatorname{cos}⁡0-0\\operatorname{sin}⁡0⟩ \\\\  & =⟨0,\\,2⟩\\en