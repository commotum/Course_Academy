torname{cos}⁡t & 0 \\\\ -2\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t & 2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t & 0\\end{aligned}\\right| \\\\  & =\\left|\\begin{aligned}\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t & \\operatorname{sin}⁡t+t\\operatorname{cos}⁡t \\\\ -2\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t & 2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t\\end{aligned}\\right|\\,k \\\\  & =[(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)]k \\\\  & =[2{cos}^{2}⁡t-3t\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{t}^{2}{sin}^{2}⁡t+2{sin}^{2}⁡t+3t\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{t}^{2}{cos}^{2}⁡t]k \\\\  & =(2({cos}^{2}⁡t+{sin}^{2}⁡t)+{t}^{2}({sin}^{2}⁡t+{cos}^{2}⁡t))k \\\\  & =({t}^{2}+2)k\\end{aligned}\n$$\n\nSo, the magnitude of the cross product is\n\n$$\n‖{r}^{′}(t)\\times {r}^{″}(t)‖={t}^{2}+2.\n$$\n\nTherefore, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{r}^{′}(t)\\times {r}^{″}(t)‖}{‖{r}^{′}(t){‖}^{3}} \\\\  & =\\frac{{t}^{2}+2}{{(\\sqrt{{t}^{2}+1})}^{3}} \\\\  & =\\frac{{t}^{2}+2}{({t}^{2}+1)^{3/2}}.\\end{aligned}\n$$" 13194139533400 17592186045585 true] [17592186266135 1068 #edb/ref 17592186265454 13194139533400 17592186045585 true] [17592186266135 1069 "q-132077" 13194139533400 17592186045585 true] [17592186266135 1070 #edb/ref 17592186045485 13194139533400 17592186045585 true] [17592186266135 1071 "Find $f(x,y)$ such that $∇f=F,$ where $F(x,y)=(\\operatorname{cos}⁡(x+y)+y)\\,i+(\\operatorname{cos}⁡(x+y)+x)\\,j.$" 13194139533400 17592186045585 true] [17592186266135 1072 #uuid "57b858a9-b536-522e-9275-67da69f513d4" 13194139533400 17592186045585 true] [17592186266135 1074 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n∇f(x,y)=\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j.\n$$\n\nSince $∇f(x,y)=F(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=\\operatorname{cos}⁡(x+y)+y,\\,\\frac{∂f}{∂y}=\\operatorname{cos}⁡(x+y)+x\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡(x+y)+y)\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡(x+y)+xy+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=\\operatorname{cos}⁡(x+y)+x+{g}^{′}(y).\n$$\n\nTaking  $\\frac{∂f}{∂y}=\\operatorname{cos}⁡(x+y)+x$ into account, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+y)+x+{g}^{′}(y) & =\\operatorname{cos}⁡(x+y)+x \\\\ {g}^{′}(y) & =0 \\\\ g(y) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)=C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)=\\operatorname{sin}⁡(x+y)+xy+C.\n$$" 13194139533400 17592186045585 true] [17592186266136 1068 #edb/ref 17592186265586 13194139533400 17592186045585 true] [17592186266136 1069 "q-132079" 13194139533400 17592186045585 true] [17592186266136 1070 #edb/ref 17592186045485 13194139533400 17592186045585 true] [17592186266136 1071 "Find $f(x,y)$ such that $∇f=F,$ where $F(x,y)=({e}^{y}-y\\operatorname{sin}⁡x)\\,i+(x{e}^{y}+\\operatorname{cos}⁡x)\\,j.$" 13194139533400 17592186045585 true] [17592186266136 1072 #uuid "e7b637df-9182-5d4f-997d-44163c023403" 13194139533400 17592186045585 true] [17592186266136 1074 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n∇f(x,y)=\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j.\n$$\n\nSince $∇f(x,y)=F(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}={e}^{y}-y\\operatorname{sin}⁡x,\\,\\frac{∂f}{∂y}=x{e}^{y}+\\operatorname{cos}⁡x\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int ({e}^{y}-y\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =x{e}^{y}+y\\operatorname{cos}⁡x+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x{e}^{y}+\\operatorname{cos}⁡x+{g}^{′}(y).\n$$\n\nTaking  $\\frac{∂f}{∂y}=x{e}^{y}+\\operatorname{cos}⁡x$ into account, we obtain\n\n$$\n\\begin{aligned}x{e}^{y}+\\operatorname{cos}⁡x+{g}^{′}(y) & =x{e}^{y}+\\operatorname{cos}⁡x \\\\ {g}^{′}(y) & =0 \\\\ g(y) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)=C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)=x{e}^{y}+y\\operatorname{cos}⁡x+C.\n$$" 13194139533400 17592186045585 true] [17592186266137 1068 #edb/ref 17592186265519 13194139533400 17592186045585 true] [17592186266137 1069 "q-132080" 13194139533400 17592186045585 true] [17592186266137 1070 #edb/ref 17592186045485 13194139533400 17592186045585 true] [17592186266137 1071 "Find $f(x,y)$ such that $∇f=F,$ where $F(x,y)={e}^{y}\\,i+(x{e}^{y}+2y)\\,j.$" 13194139533400 17592186045585 true] [17592186266137 1072 #uuid "74939473-4e44-5a23-a29d-cf0a790a9021" 13194139533400 17592186045585 true] [17592186266137 1074 "The gradient of the function $f(x,y)$ is defined as\n\n$$\n∇f(x,y)=\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j.\n$$\n\nSince $∇f(x,y)=F(x,y),$ the function $f(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}={e}^{y},\\,\\frac{∂f}{∂y}=x{e}^{y}+2y\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}f(x,y) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int {e}^{y}\\,\\text{d}x \\\\  & =x{e}^{y}+g(y)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x{e}^{y}+{g}^{′}(y).\n$$\n\nTaking  $\\frac{∂f}{∂y}=x{e}^{y}+2y$ into account, we obtain\n\n$$\n\\begin{aligned}x{e}^{y}+{g}^{′}(y) & =x{e}^{y}+2y \\\\ {g}^{′}(y) & =2y \\\\ g(y) & ={y}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nFinally, substituting $g(y)={y}^{2}+C$ into our expression for $f(x,y),$ we get\n\n$$\nf(x,y)=x{e}^{y}+{y}^{2}+C.\n$$" 13194139533400 17592186045585 true] [17592186266138 1068 #edb/ref 17592186265538 13194139533400 17592186045585 true] [17592186266138 1069 "q-132100" 13194139533400 17592186045585 true] [17592186266138 1070 #edb/ref 17592186045486 13194139533400 17592186045585 true] [17592186266138 1071 "Find $f(x,y,z)$ such that $∇f(x,y,z)=F(x,y,z),$ where $F(x,y,z)=(\\operatorname{ln}⁡y+1)\\,i+(\\frac{x}{y}-{z}^{2})\\,j-2yz\\,k.$" 13194139533400 17592186045585 true] [17592186266138 1072 #uuid "062ec003-5729-5fe0-9819-864cef26e212" 13194139533400 17592186045585 true] [17592186266138 1074 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n∇f(x,y,z)=\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k.\n$$\n\nSince $∇f(x,y,z)=F(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=\\operatorname{ln}⁡y+1,\\,\\frac{∂f}{∂y}=\\frac{x}{y}-{z}^{2},\\,\\frac{∂f}{∂z}=-2yz\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (\\operatorname{ln}⁡y+1)\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡y+x+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=\\frac{x}{y}+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=\\frac{x}{y}-{z}^{2}$ into account, we obtain\n\n$$\n\\begin{aligned}\\frac{x}{y}+\\frac{∂g}{∂y} & =\\frac{x}{y}-{z}^{2} \\\\ \\frac{∂g}{∂y} & =-{z}^{2}\\end{aligned}\n$$\n\nNow, we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int (-{z}^{2})\\,\\text{d}y \\\\  & =-y{z}^{2}+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=-y{z}^{2}+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)=x\\operatorname{ln}⁡y+x-y{z}^{2}+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}=-2yz+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=-2yz$ into account, we obtain\n\n$$\n\\begin{aligned}-2yz & =-2yz+{h}^{′}(z) \\\\ {h}^{′}(z) & =0 \\\\ h(z) & =C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=x\\operatorname{ln}⁡y+x-y{z}^{2}+C.\n$$" 13194139533400 17592186045585 true] [17592186266139 1068 #edb/ref 17592186265630 13194139533400 17592186045585 true] [17592186266139 1069 "q-132103" 13194139533400 17592186045585 true] [17592186266139 1070 #edb/ref 17592186045486 13194139533400 17592186045585 true] [17592186266139 1071 "Find $f(x,y,z)$ such that $∇f(x,y,z)=F(x,y,z),$ where $F(x,y,z)=(2x+y{e}^{z})\\,i+(x{e}^{z}+1)\\,j+(xy{e}^{z}-2z)\\,k.$" 13194139533400 17592186045585 true] [17592186266139 1072 #uuid "6b7d90b3-0384-5231-a89f-b7683283ef28" 13194139533400 17592186045585 true] [17592186266139 1074 "The gradient of the function $f(x,y,z)$ is defined as\n\n$$\n∇f(x,y,z)=\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j+\\frac{∂f}{∂z}\\,k.\n$$\n\nSince $∇f(x,y,z)=F(x,y,z),$ the function $f(x,y,z)$ must satisfy the following system:\n\n$$\n\\frac{∂f}{∂x}=2x+y{e}^{z},\\,\\frac{∂f}{∂y}=x{e}^{z}+1,\\,\\frac{∂f}{∂z}=xy{e}^{z}-2z\n$$\n\nFirst, we integrate $\\frac{∂f}{∂x}$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y$ and $z:$\n\n$$\n\\begin{aligned}f(x,y,z) & =\\int \\frac{∂f}{∂x}\\,\\text{d}x \\\\  & =\\int (2x+y{e}^{z})\\,\\text{d}x \\\\  & ={x}^{2}+xy{e}^{z}+g(y,z)\\end{aligned}\n$$\n\nNow, differentiating the above expression with respect to $y,$ we obtain\n\n$$\n\\frac{∂f}{∂y}=x{e}^{z}+\\frac{∂g}{∂y}\n$$\n\nTaking $\\frac{∂f}{∂y}=x{e}^{z}+1$ into account, we obtain\n\n$$\n\\begin{aligned}x{e}^{z}+\\frac{∂g}{∂y} & =x{e}^{z}+1 \\\\ \\frac{∂g}{∂y} & =1\\end{aligned}\n$$\n\nNow, we integrate $\\frac{∂g}{∂y}$ with respect to $y.$ Note that the solution should contain an arbitrary function of $z:$\n\n$$\n\\begin{aligned}g(y,z) & =\\int \\frac{∂g}{∂y}\\,\\text{d}y \\\\  & =\\int \\,\\text{d}y \\\\  & =y+h(z)\\end{aligned}\n$$\n\nSubstituting $g(y,z)=y+h(z)$ in the expression for $f(x,y,z),$ we get\n\n$$\nf(x,y,z)={x}^{2}+xy{e}^{z}+y+h(z).\n$$\n\nTo determine the function $h(z),$ we differentiate $f(x,y,z)$ with respect to $z.$ This gives\n\n$$\n\\frac{∂f}{∂z}=xy{e}^{z}+{h}^{′}(z).\n$$\n\nTaking $\\frac{∂f}{∂z}=xy{e}^{z}-2z$ into account, we obtain\n\n$$\n\\begin{aligned}xy{e}^{z}-2z & =xy{e}^{z}+{h}^{′}(z) \\\\ {h}^{′}(z) & =-2z \\\\ h(z) & =-{z}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nConsequently,\n\n$$\nf(x,y,z)=xy{e}^{z}+{x}^{2}+y-{z}^{2}+C.\n$$" 13194139533400 17592186045585 true] [17592186266140 1068 #edb/ref 17592186265271 13194139533400 17592186045585 true] [17592186266140 1069 "q-132105" 13194139533400 17592186045585 true] [17592186266140 1070 #edb/ref 17592186045485 13194139533400 17592186045585 true] [17592186266140 1071 "Consider a curve $r(s)$ parametrized by its arc length $s.$ Find the radius of curvature of $r(s)$ at an arbitrary point knowing that its unit tangent vector $T(s)$ is given by\n\n$$\nT(s)=\\frac{1}{\\sqrt{2}}⟨-\\operatorname{sin}⁡s,\\,-\\operatorname{sin}⁡s,\\,\\sqrt{2}\\operatorname{cos}⁡s⟩.\n$$" 13194139533400 17592186045585 true] [17592186266140 1072 #uuid "1ac67b14-8558-510c-8d38-cf5ff7d90671" 13194139533400 17592186045585 true] [17592186266140 1074 "Since the curve $r(s)$ and its unit tangent vector $T(s)$ are both parametrized by arc length $s$, we will use the following formula for the radius of curvature:\n\n$$\nR(s)=\\frac{1}{κ(s)}=\\frac{1}{‖{T}^{′}(s)‖}\n$$\n\nWe differentiate $T(s)$ with respect to $s$ and calculate its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(s) & =\\frac{1}{\\sqrt{2}}⟨\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡s),\\,\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{cos}⁡s)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡s,\\,-\\operatorname{cos}⁡s,\\,-\\sqrt{2}\\operatorname{sin}⁡s⟩ \\\\ ‖{T}^{′}(s)‖ & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{{(-\\operatorname{cos}⁡s)}^{2}+{(-\\operatorname{cos}⁡s)}^{2}+{(-\\sqrt{2}\\operatorname{sin}⁡s)}^{2}} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{{cos}^{2}⁡s+{cos}^{2}⁡s+2{sin}^{2}⁡s} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{2{cos}^{2}⁡s+2{sin}^{2}⁡s} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{2({cos}^{2}⁡s+{sin}^{2}⁡s)} \\\\  & =\\frac{1}{\\sqrt{2}}\\cdot \\sqrt{2} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the radius of curvature is\n\n$$\nR(s)=\\frac{1}{‖{T}^{′}(s)‖}=\\frac{1}{1}=1.\n$$" 13194139533400 17592186045585 true] [17592186266141 1068 #edb/ref 17592186265574 13194139533400 17592186045585 true] [17592186266141 1069 "q-132110" 13194139533400 17592186045585 true] [17592186266141 1070 #edb/ref 17592186045485 13194139533400 17592186045585 true] [17592186266141 1071 "Consider a curve $r(s)$ parametrized by its arc length $s.$ Find the radius of curvature of $r(s)$ at an arbitrary point knowing that its unit tangent vector $T(s)$ is given by\n\n$$\nT(s)=\\frac{1}{2}⟨\\operatorname{cos}⁡\\sqrt{s},\\,\\operatorname{sin}⁡\\sqrt{s},\\,\\sqrt{3}⟩.\n$$" 13194139533400 17592186045585 true] [17592186266141 1072 #uuid "f5eb3832-8b64-51ad-af13-7886aea1f298" 13194139533400 17592186045585 true] [17592186266141 1074 "Since the curve $r(s)$ and its unit tangent vector $T(s)$ are both parametrized by arc length $s$, we will use the following formula for the radius of curvature:\n\n$$\nR(s)=\\frac{1}{κ(s)}=\\frac{1}{‖{T}^{′}(s)‖}\n$$\n\nWe differentiate $T(s)$ with respect to $s$ and calculate its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(s) & =\\frac{1}{2}⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡\\sqrt{s}),\\,\\frac{\\text{d}}{\\text{d}s}(\\operatorname{sin}⁡\\sqrt{s}),\\,\\frac{\\text{d}}{\\text{d}s}(\\sqrt{3})⟩ \\\\  & =\\frac{1}{2}⟨-\\frac{\\operatorname{sin}⁡\\sqrt{s}}{2\\sqrt{s}},\\,\\frac{\\operatorname{cos}⁡\\sqrt{s}}{2\\sqrt{s}},\\,0⟩ \\\\  & =\\frac{1}{4\\sqrt{s}}⟨-\\operatorname{sin}⁡\\sqrt{s},\\,\\operatorname{cos}⁡\\sqrt{s},\\,0⟩ \\\\ ‖{T}^{′}(s)‖ & =\\frac{1}{4\\sqrt{s}}\\cdot \\sqrt{{(-\\operatorname{sin}⁡\\sqrt{s})}^{2}+{(\\operatorname{cos}⁡\\sqrt{s})}^{2}+{(0)}^{2}} \\\\  & =\\frac{1}{4\\sqrt{s}}\\cdot \\sqrt{{sin}^{2}⁡\\sqrt{s}+{cos}^{2}⁡\\sqrt{s}} \\\\  & =\\frac{1}{4\\sqrt{s}}\\cdot 1 \\\\  & =\\frac{1}{4\\sqrt{s}}\\end{aligned}\n$$\n\nTherefore, the radius of curvature is\n\n$$\nR(s)=\\frac{1}{‖{T}^{′}(s)‖}=\\frac{1}{(\\frac{1}{4\\sqrt{s}})}=4\\sqrt{s}.\n$$" 13194139533400 17592186045585 true] [17592186266142 1068 #edb/ref 17592186265342 13194139533400 17592186045585 true] [17592186266142 1069 "q-132112" 13194139533400 17592186045585 true] [17592186266142 1070 #edb/ref 17592186045487 13194139533400 17592186045585 true] [17592186266142 1071 "Find the radius of curvature for the curve $r(t)$ at the point $r(\\pi )$ if the curve and the derivative ${T}^{′}(t)$ of the corresponding unit tangent vector are given by\n\n$$\nr(t)=⟨\\operatorname{sin}⁡t,\\,4,\\,\\operatorname{cos}⁡t⟩,\\,{T}^{′}(t)=⟨-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{cos}⁡t⟩.\n$$" 13194139533400 17592186045585 true] [17592186266142 1072 #uuid "700d118c-0927-554d-9106-fd23a8f63322" 13194139533400 17592186045585 true] [17592186266142 1074 "Since we are given both the curve $r(t)$ and the derivative ${T}^{′}(t)$ of the unit tangent, we will use the following formula for the radius of curvature:\n\n$$\nR(t)=\\frac{1}{κ(t)}=\\frac{‖{r}^{′}(t)‖}{‖{T}^{′}(t)‖}\n$$\n\nFirst, we find ${r}^{′}(t)$, ${r}^{′}(\\pi ),$ and $‖{r}^{′}(\\pi )‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(4),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t,\\,0,\\,-\\operatorname{sin}⁡t⟩ 