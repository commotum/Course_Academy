^{3}}{3})\\,{|}_{0}^{3} \\\\  & =(3+\\frac{27}{3})-0 \\\\  & =12.\\end{aligned}\n$$" 13194139533420 17592186045585 true] [17592186320864 1068 #edb/ref 17592186320232 13194139533420 17592186045585 true] [17592186320864 1069 "q-351508" 13194139533420 17592186045585 true] [17592186320864 1070 #edb/ref 17592186045487 13194139533420 17592186045585 true] [17592186320864 1071 "![](images/a6/a61d1a169971b5e0af320372885cdcbae794d163ab767685ef5b688a083aaadb.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2+4t,\\,y=\\frac{8}{3}{t}^{3/2},\\,t\\in [0,2].\n$$\n\n$L=$\n{{field-1}}" 13194139533420 17592186045585 true] [17592186320864 1072 #uuid "ad2ad837-fe00-5eb7-ab02-db6f230cbbfd" 13194139533420 17592186045585 true] [17592186320864 1074 "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2+4t)=4,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{8}{3}{t}^{3/2})=4{t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2}\\sqrt{{4}^{2}+{(4{t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{16+16t}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{2}(1+t)^{1/2}\\,\\text{d}t \\\\  & =4\\cdot \\frac{2}{3}(1+t)^{3/2}\\,{|}_{0}^{2} \\\\  & =\\frac{8}{3}({3}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{8}{3}(3\\sqrt{3}-1) \\\\  & =8\\sqrt{3}-\\frac{8}{3}.\\end{aligned}\n$$" 13194139533420 17592186045585 true] [17592186320865 1068 #edb/ref 17592186320281 13194139533420 17592186045585 true] [17592186320865 1069 "q-351511" 13194139533420 17592186045585 true] [17592186320865 1070 #edb/ref 17592186045487 1319413953342