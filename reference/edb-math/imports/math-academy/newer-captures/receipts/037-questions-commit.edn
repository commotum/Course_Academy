}⁡e)^{2}-2\\operatorname{ln}⁡e+2)]-[1((\\operatorname{ln}⁡1)^{2}-2\\operatorname{ln}⁡1+2)] \\\\  & =[e(1-2+2)]-[1(0-0+2)] \\\\  & =e-2\\end{aligned}\n$$" 13194139533420 17592186045585 true] [17592186320952 1068 #edb/ref 17592186320483 13194139533420 17592186045585 true] [17592186320952 1069 "q-352049" 13194139533420 17592186045585 true] [17592186320952 1070 #edb/ref 17592186045486 13194139533420 17592186045585 true] [17592186320952 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/3}^{e/3}243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x=$\n{{field-1}}" 13194139533420 17592186045585 true] [17592186320952 1072 #uuid "63f87158-db44-5db5-9c59-fd71fce3385d" 13194139533420 17592186045585 true] [17592186320952 1074 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(3x))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(3x)}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=243{x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 243{x}^{2}\\,\\text{d}x=81{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡(3x))}^{2}(81{x}^{3})-\\int (81{x}^{3})(\\frac{2\\operatorname{ln}⁡(3x)}{x})\\,\\text{d}x \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{1}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162(\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{{x}^{3}}{9}+D) \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-54{x}^{3}\\operatorname{ln}⁡(3x)+18{x}^{3}-162D \\\\  & ={x}^{3}(81{(\\operatorname{ln}⁡(3x))}^{2}-54\\operatorname{ln}⁡(3x)+18)+C,\\end{aligned}\n$$\n\nwhere $C=-162D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e/3}243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\text{d}x & ={[{x}^{3}(81{(\\operatorname{ln}⁡(3x))}^{2}-54\\operatorname{ln}⁡(3x)+18)]}_{1/3}^{e/3} \\\\  & =[{(\\frac{e}{3})}^{3}(81{(\\operatorname{ln}⁡(3\\cdot \\frac{e}{3}))}^{2}-54\\operatorname{ln}⁡(3\\cdot \\frac{e}{3})+18)] \\\\  & \\,-[{(\\frac{1}{3})}^{3}(81{(\\operatorname{ln}⁡(3\\cdot \\frac{1}{3}))}^{2}-54\\operatorname{ln}⁡(3\\cdot \\frac{1}{3})+18)] \\\\  & =[\\frac{{e}^{3}}{27}(81{(\\operatorname{ln}⁡e)}^{2}-54\\operatorname{ln}⁡e+18)]-[\\frac{1}{27}(81{(\\operatorname{ln}⁡1)}^{2}-54\\operatorname{ln}⁡1+18)] \\\\  & =[\\frac{{e}^{3}}{27}(81-54+18)]-\\frac{1}{27}\\cdot 18 \\\\  & =\\frac{5{e}^{3}-2}{3}\\end{aligned}\n$$" 1319413953342