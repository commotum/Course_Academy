}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1) & ={\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{a}_{ij}+{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{b}_{ij}-{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1 \\\\  & =200+175-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) \\\\  & =375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1).\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) & =375-(10\\cdot 25) \\\\  & =375-250 \\\\  & =125.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1)=125.\n$$" 13194139533403 17592186045585 true] [17592186275233 1068 #edb/ref 17592186274979 13194139533403 17592186045585 true] [17592186275233 1069 "q-149675" 13194139533403 17592186045585 true] [17592186275233 1070 #edb/ref 17592186045487 13194139533403 17592186045585 true] [17592186275233 1071 "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}=25,\\,{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij}=20.\n$$" 13194139533403 17592186045585 true] [17592186275233 1072 #uuid "5cc7d933-5ca2-5eea-a9c4-0e7be18017da" 13194139533403 17592186045585 true] [17592186275233 1074 "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij}) & ={\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}2{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+2{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+25+40 \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65 & =8\\cdot 10+65 \\\\  & =80+65 \\\\  & =145.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})=145.\n$$" 13194139533403 17592186045585 true] [17592186275234 1068 #edb/ref 17592186274741 13194139533403 17592186045585 true] [17592186275234 1069 "q-149676" 13194139533403 17592186045585 true] [17592186275234 1070 #edb/ref 17592186045487 13194139533403 17592186045585 true] [17592186275234 1071 "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}({a}_{ij}+{b}_{ij}-2)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}{a}_{ij}=300,\\,{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}{b}_{ij}=250.\n$$" 13194139533403 17592186045585 true] [17592186275234 1072 #uuid "f734ef27-c15e-5fba-9fca-e94f9a86d030" 13194139533403 17592186045585 true] [17592186275234 1074 "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\s