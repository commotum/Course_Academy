frac{3{t}^{2}}{1+25{t}^{6}}\\,\\text{d}t & ={\\int }_{-\\infty }^{0}\\frac{1}{1+25{u}^{2}}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{3{t}^{2}}{1+25{t}^{6}}\\,\\text{d}t & ={\\int }_{-\\infty }^{0}\\frac{1}{1+25{u}^{2}}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{1+25{u}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{1}{5}\\cdot \\operatorname{arctan}⁡(5u)]}_{a}^{0} \\\\  & =\\frac{1}{5}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(5u)]_{a}^{0} \\\\  & =\\frac{1}{5}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(0)-\\operatorname{arctan}⁡(5a)] \\\\  & =-\\frac{1}{5}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(5a)]\\end{aligned}\n$$\n\nFinally, recall the end behavior of the function $y=\\operatorname{arctan}⁡(5x),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡(5x)]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡(5x)]=\\frac{\\pi }{2}$\n\n![](images/06/06f99111a041ff564ece3019e7dba5331bb4f225d224dff07bb92d83f4e33eb2.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{3{t}^{2}}{1+25{t}^{6}}\\,\\text{d}t & =-\\frac{1}{5}\\cdot {lim}_{a\\to -\\infty }[\\operatorname{arctan}⁡(5a)] \\\\  & =-\\frac{1}{5}\\cdot (-\\frac{\\pi }{2}) \\\\  & =\\frac{\\pi }{10}.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275296 1068 #edb/ref 17592186274900 13194139533403 17592186045585 true] [17592186275296 1069 "q-152755" 13194139533403 17592186045585 true] [17592186275296 1070 #edb/ref 17592186045485 13194139533403 17592186045585 true] [17592186275296 1071 "${\\int }_{1}^{\\infty }\\frac{2}{{\\theta }^{6}}\\,\\text{d}\\theta =$" 13194139533403 17592186045585 true] [17592186275296 1072 #uuid "ce005079-2956-5000-9ad8-11b835eb244d" 13194139533403 17592186045585 true] [17592186275296 1074 "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{2}{{\\theta }^{6}}\\,\\text{d}\\theta  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{2}{{\\theta }^{6}}\\,\\text{d}\\theta  \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}2{\\theta }^{-6}\\,\\text{d}\\theta  \\\\  & ={lim}_{a\\to \\infty }{[(-\\frac{2}{5}{\\theta }^{-5})]}_{1}^{a} \\\\  & =-\\frac{2}{5}\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{\\theta }^{5}}]}_{1}^{a} \\\\  & =-\\frac{2}{5}\\cdot {lim}_{a\\to \\infty }(\\frac{1}{{a}^{5}}-\\frac{1}{{1}^{5}}) \\\\  & =-\\frac{2}{5}(0-1) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275297 1068 #edb/ref 17592186274724 13194139533403 17592186045585 true] [17592186275297 1069 "q-152757" 13194139533403 17592186045585 true] [17592186275297 1070 #edb/ref 17592186045485 13194139533403 17592186045585 true] [17592186275297 1071 "Evaluate ${lim}_{x\\to \\,0}(2x\\operatorname{arcsin}⁡(x)).$" 13194139533403 17592186045585 true] [17592186275297 1072 #uuid "4600f6b6-af0e-5a27-9674-77c932b69191" 13194139533403 17592186045585 true] [17592186275297 1074 "Let's sketch the graph of $y=\\operatorname{arcsin}⁡(x):$ \n\n![](images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)\n\nThe domain of $\\operatorname{arcsin}⁡(x)$ is $x\\in [-1,1].$  \n\nNow, substituting $x=0$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,0}(2x\\operatorname{arcsin}⁡(x)) & =2\\cdot 0\\cdot \\operatorname{arcsin}⁡(0) \\\\  & =2\\cdot 0\\cdot 0 \\\\  & =0.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275298 1068 #edb/ref 17592186274927 13194139533403 17592186045585 true] [17592186275298 1069 "q-152758" 13194139533403 17592186045585 true] [17592186275298 1070 #edb/ref 17592186045485 13194139533403 17592186045585 true] [17592186275298 1071 "Evaluate the integral ${\\int }_{3}^{\\infty }\\frac{5}{{x}^{2}}\\,\\text{d}x.$" 13194139533403 17592186045585 true] [17592186275298 1072 #uuid "103cebc3-520a-5f54-9772-ff15188c450f" 13194139533403 17592186045585 true] [17592186275298 1074 "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{3}^{\\infty }\\frac{5}{{x}^{2}}\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}\\frac{5}{{x}^{2}}\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}5{x}^{-2}\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[(-5{x}^{-1})]}_{3}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{x}]}_{3}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }(\\frac{1}{a}-\\frac{1}{3}) \\\\  & =-5\\cdot (0-\\frac{1}{3}) \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275299 1068 #edb/ref 17592186275088 13194139533403 17592186045585 true] [17592186275299 1069 "q-152761" 13194139533403 17592186045585 true] [17592186275299 1070 #edb/ref 17592186045487 13194139533403 17592186045585 true] [17592186275299 1071 "What is the value of ${lim}_{x\\to \\,3/2}\\frac{(\\operatorname{arccos}⁡(x)-\\pi )^{2}}{2x}?$" 13194139533403 17592186045585 true] [17592186275299 1072 #uuid "22320af9-cc16-5c9e-9fef-986e76a188d4" 13194139533403 17592186045585 true] [17592186275299 1074 "Let's sketch the graph of $y=\\operatorname{arccos}⁡(x):$\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$ Since $\\frac{3}{2}\\notin [-1,1],$ this means that $\\operatorname{arccos}⁡(\\frac{3}{2})$ is undefined.\n\nTherefore, our limit is undefined, too." 13194139533403 17592186045585 true] [17592186275300 1068 #edb/ref 17592186274666 13194139533403 17592186045585 true] [17592186275300 1069 "q-152762" 13194139533403 17592186045585 true] [17592186275300 1070 #edb/ref 17592186045487 13194139533403 17592186045585 true] [17592186275300 1071 "Evaluate ${\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z.$" 13194139533403 17592186045585 true] [17592186275300 1072 #uuid "907b2362-3732-5d22-8020-cc9e89939dae" 13194139533403 17592186045585 true] [17592186275300 1074 "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z & ={lim}_{a\\to \\infty }{\\int }_{8}^{a}\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{8}^{a}{z}^{-4/3}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{[-3{z}^{-1/3}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{z}}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{a}}-\\frac{1}{\\sqrt[3]{8}}) \\\\  & =-6(0-\\frac{1}{2}) \\\\  & =3.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275301 1068 #edb/ref 17592186274864 13194139533403 17592186045585 true] [17592186275301 1069 "q-152779" 13194139533403 17592186045585 true] [17592186275301 1070 #edb/ref 17592186045487 13194139533403 17592186045585 true] [17592186275301 1071 "Evaluate ${\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z.$" 13194139533403 17592186045585 true] [17592186275301 1072 #uuid "69ccaa61-239d-507f-a5cc-30c609c287b4" 13194139533403 17592186045585 true] [17592186275301 1074 "First, we substitute $u=z+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=1\\,⟹\\,\\text{d}u=\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u=z+2$ is as follows:\n\n| $z$ | $-1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z={\\int }_{1}^{\\infty }\\frac{6}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z & ={\\int }_{1}^{\\infty }\\frac{6}{{u}^{4}}\\,\\text{d}u \\\\  & =6{\\int }_{1}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =6{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =6{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{1}^{3}}] \\\\  & =-2\\cdot (0-1) \\\\  & =2.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275302 1068 #edb/ref 17592186274726 13194139533403 17592186045585 true] [17592186275302 1069 "q-152785" 13194139533403 17592186045585 true] [17592186275302 1070 #edb/ref 17592186045486 13194139533403 17592186045585 true] [17592186275302 1071 "Evaluate the integral ${\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z.$" 13194139533403 17592186045585 true] [17592186275302 1072 #uuid "12c7271a-e53c-5579-a182-e59f266fc9f5" 13194139533403 17592186045585 true] [17592186275302 1074 "First, we substitute $u={z}^{4}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=4{z}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={z}^{3}\\,\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u={z}^{4}+1$ is as follows:\n\n| $z$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & ={\\int }_{2}^{\\infty }\\frac{8}{{u}^{4}}(\\frac{1}{4}\\,\\text{d}u) \\\\  & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =2{\\int }_{2}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{2}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }(\\frac{1}{{a}^{3}}-\\frac{1}{8}) \\\\  & =-\\frac{2}{3}(0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275303 1068 #edb/ref 17592186274751 13194139533403 17592186045585 true] [17592186275303 1069 "q-152804" 13194139533403 17592186045585 true] [17592186275303 1070 #edb/ref 17592186045485 13194139533403 17592186045585 true] [17592186275303 1071 "Evaluate ${lim}_{x\\to \\,\\sqrt{3}/2}(\\frac{3\\pi }{2}+3\\operatorname{arccos}⁡(x)).$" 13194139533403 17592186045585 true] [17592186275303 1072 #uuid "0d3f86bb-64f3-5ac2-a42e-d712ccf5da77" 13194139533403 17592186045585 true] [17592186275303 1074 "Let's sketch the graph of $y=\\operatorname{arccos}⁡(x):$ \n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)\n\nThe domain of $\\operatorname{arccos}⁡(x)$ is $x\\in [-1,1].$   \n\nNow, substituting $x=\\sqrt{3}/2$ directly into the limit, we have  \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\sqrt{3}/2}(\\frac{3\\pi }{2}+3\\operatorname{arccos}⁡(x)) & =\\frac{3\\pi }{2}+3\\cdot \\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{3\\pi }{2}+3\\cdot (\\frac{\\pi }{6}) \\\\  & =2\\pi .\\end{aligned}\n$$" 13194139533403 17592186045585 true] [17592186275304 1068 #edb/ref 17592186274850 13194139533403 17592186045585 true] [17592186275304 1069 "q-152806" 13194139533403 17592186045585 true] [17592186275304 1070 #edb/ref 17592186045487 13194139