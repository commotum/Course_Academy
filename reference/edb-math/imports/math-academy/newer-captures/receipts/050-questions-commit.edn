 \\\\ -1 & 3\\end{aligned}]\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360761 1068 #edb/ref 17592186360031 13194139533433 17592186045585 true] [17592186360761 1069 "q-97120" 13194139533433 17592186045585 true] [17592186360761 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360761 1071 "$$\nB={[\\begin{aligned}1 \\\\ 1\\end{aligned}],[\\begin{aligned}6 \\\\ 5\\end{aligned}]},\\,[T]_{B}=[\\begin{aligned}-4 & -3 \\\\ 1 & 2\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" 13194139533433 17592186045585 true] [17592186360761 1072 #uuid "18ca38eb-405c-519d-860c-9cd4de1b59e4" 13194139533433 17592186045585 true] [17592186360761 1074 "The connection between the matrices of our linear transformation $T$ relative to the basis $B$ and standard basis $S$ is given by the following diagram:\n\n![](images/db/dbd020362f950fe8bfb4c592652b9e78a73610fa01a247b0b7ead6f201bf9ea5.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{S}={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1},\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}1 & 6 \\\\ 1 & 5\\end{aligned}].\n$$\n\nFirst, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{B\\to S}^{-1} & ={[\\begin{aligned}1 & 6 \\\\ 1 & 5\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{5\\cdot 1-1\\cdot 6}[\\begin{aligned}5 & -6 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 6 \\\\ 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =[\\begin{aligned}1 & 6 \\\\ 1 & 5\\end{aligned}][\\begin{aligned}-4 & -3 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}-5 & 6 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 9 \\\\ 1 & 7\\end{aligned}][\\begin{aligned}-5 & 6 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 3 \\\\ 2 & -1\\end{aligned}]\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360762 1068 #edb/ref 17592186360128 13194139533433 17592186045585 true] [17592186360762 1069 "q-97122" 13194139533433 17592186045585 true] [17592186360762 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360762 1071 "$$\nB={[\\begin{aligned}2 \\\\ 5\\end{aligned}],[\\begin{aligned}-1 \\\\ -2\\end{aligned}]},\\,[T]_{B}=[\\begin{aligned}2 & 3 \\\\ 3 & 6\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" 13194139533433 17592186045585 true] [17592186360762 1072 #uuid "1b879b1b-6896-5c9b-8a36-8fd36dfcc350" 13194139533433 17592186045585 true] [17592186360762 1074 "The connection between the matrices of our linear transformation $T$ relative to the basis $B$ and standard basis $S$ is given by the following diagram:\n\n![](images/db/dbd020362f950fe8bfb4c592652b9e78a73610fa01a247b0b7ead6f201bf9ea5.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{S}={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1},\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}2 & -1 \\\\ 5 & -2\\end{aligned}].\n$$\n\nFirst, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{B\\to S}^{-1} & ={[\\begin{aligned}2 & -1 \\\\ 5 & -2\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot 2-(-1)\\cdot 5}[\\begin{aligned}-2 & 1 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ -5 & 2\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =[\\begin{aligned}2 & -1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}2 & 3 \\\\ 3 & 6\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 4 & 3\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 1 \\\\ -23 & 10\\end{aligned}]\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360763 1068 #edb/ref 17592186360190 13194139533433 17592186045585 true] [17592186360763 1069 "q-97127" 13194139533433 17592186045585 true] [17592186360763 1070 #edb/ref 17592186045485 13194139533433 17592186045585 true] [17592186360763 1071 "Given $X∼\\text{Geom}(0.15),$ compute $P(X=7).$  Round your final answer to $4$ decimal places." 13194139533433 17592186045585 true] [17592186360763 1072 #uuid "ed9cf7bd-ec59-5fb2-9e4a-bbb1076eead3" 13194139533433 17592186045585 true] [17592186360763 1074 "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.15),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.85)}^{x-1}(0.15), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=7) & =f(7) \\\\  & ={(0.85)}^{6}(0.15) \\\\  & ≈0.0566.\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360764 1068 #edb/ref 17592186360179 13194139533433 17592186045585 true] [17592186360764 1069 "q-97146" 13194139533433 17592186045585 true] [17592186360764 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360764 1071 "Given $X∼\\text{Geom}(0.64),$ compute $P(X<5).$  Round your final answer to $4$ decimal places." 13194139533433 17592186045585 true] [17592186360764 1072 #uuid "621e9ca9-d97c-5efd-b4c9-3065ab44a298" 13194139533433 17592186045585 true] [17592186360764 1074 "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.64),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.36)}^{x-1}(0.64), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in {1,2,3,4}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(0.36)}^{0}(0.64)+{(0.36)}^{1}(0.64)+{(0.36)}^{2}(0.64)+{(0.36)}^{3}(0.64) \\\\  & ≈0.9832.\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360765 1068 #edb/ref 17592186360247 13194139533433 17592186045585 true] [17592186360765 1069 "q-97149" 13194139533433 17592186045585 true] [17592186360765 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360765 1071 "Consider the standard Hermitian inner product $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ over $C.$ \nWhich of the following statements are true? \n\n- $⟨a,a⟩>0$ for any $a\\in {C}^{n}$\n- $⟨a,b⟩\\in R$ for any $a,b\\in {C}^{n}$\n- $⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩$ for any $a,b\\in {C}^{n}$ and any $\\alpha \\in C$" 13194139533433 17592186045585 true] [17592186360765 1072 #uuid "3b24ab75-1f17-54d0-bd60-01447f2e1769" 13194139533433 17592186045585 true] [17592186360765 1074 "Recall that the standard Hermitian inner product over $C$ satisfies the following properties:\n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Notice that if $a=0$ then $⟨a,a⟩=0.$\n\n- Statement II is false. The inner product over $C$ is a complex number in general.\n\n- Statement III is true. Indeed, the inner product in ${C}^{n}$ is linear in the first argument. So, a constant multiple from the first argument can be factored out.\n\nTherefore, the correct answer is \"III only.\"" 13194139533433 17592186045585 true] [17592186360766 1068 #edb/ref 17592186360306 13194139533433 17592186045585 true] [17592186360766 1069 "q-97155" 13194139533433 17592186045585 true] [17592186360766 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360766 1071 "Given that $X∼\\text{Geom}(0.23),$ compute $P(3<X<7)$ rounded to $4$ decimal places." 13194139533433 17592186045585 true] [17592186360766 1072 #uuid "a90f56db-3bf1-5904-b2af-586397c0fc70" 13194139533433 17592186045585 true] [17592186360766 1074 "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.23),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.77)}^{x-1}(0.23), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3<X<7) & =P(X\\in {4,5,6}) \\\\  & =P(X=4)+P(X=5)+P(X=6) \\\\  & =f(4)+f(5)+f(6) \\\\  & ={(0.77)}^{3}(0.23)+{(0.77)}^{4}(0.23)+{(0.77)}^{5}(0.23) \\\\  & ≈0.2481.\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360767 1068 #edb/ref 17592186360214 13194139533433 17592186045585 true] [17592186360767 1069 "q-97159" 13194139533433 17592186045585 true] [17592186360767 1070 #edb/ref 17592186045486 13194139533433 17592186045585 true] [17592186360767 1071 "Given that $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ is the standard Hermitian inner product over $C,$ find $⟨a,\\,6b+c⟩$ if   \n\n$\\,$ $⟨b,a⟩=2+3\\text{i}\\,$ and $\\,⟨a,c⟩=3+8\\text{i}.$" 13194139533433 17592186045585 true] [17592186360767 1072 #uuid "e5cc7f04-77b2-544c-b6f7-4b258e1d90be" 13194139533433 17592186045585 true] [17592186360767 1074 "Recall that the inner product over $C$ satisfies the following properties. \n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nFirst, we use the fact that the inner product over $C$ is antilinear in the second argument:  \n\n$$\n\\begin{aligned}⟨a,\\,6b+c⟩ & =⟨a,6b⟩+⟨a,c⟩ \\\\  & =\\overset{―}{6}⟨a,b⟩+⟨a,c⟩ \\\\  & =6⟨a,b⟩+⟨a,c⟩\\end{aligned}\n$$\n\n  \n\nNext, we use the fact that the inner product over $C$ has conjugate symmetry: \n\n$$\n\\begin{aligned}6⟨a,b⟩+⟨a,c⟩ & =6\\overset{―}{⟨b,a⟩}+⟨a,c⟩\\end{aligned}\n$$\n\nFinally, we substitute the values for $⟨b,a⟩$ and $⟨a,c⟩:$\n\n$$\n\\begin{aligned}6\\overset{―}{⟨b,a⟩}+⟨a,c⟩ & =6(\\overset{―}{2+3\\text{i}})+(3+8\\text{i}) \\\\  & =6(2-3\\text{i})+(3+8\\text{i}) \\\\  & =12-18\\text{i}+3+8\\text{i} \\\\  & =15-10\\text{i}\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360768 1068 #edb/ref 17592186360100 13194139533433 17592186045585 true] [17592186360768 1069 "q-97167" 13194139533433 17592186045585 true] [17592186360768 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360768 1071 "Given that $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ is the standard Hermitian inner product over $C,$ find $⟨2a-b,\\,c⟩$ if \n\n$\\,$ $⟨a,c⟩=8+\\text{i}\\,$ and $\\,⟨c,b⟩=4-5\\text{i}.$" 13194139533433 17592186045585 true] [17592186360768 1072 #uuid "3a91bc49-3d19-5dec-a80e-2f4ee3937c14" 13194139533433 17592186045585 true] [17592186360768 1074 "Recall that the inner product over $C$ satisfies the following properties. \n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nFirst, we use the fact that the inner product over $C$ is linear in the first argument: \n\n$$\n\\begin{aligned}⟨2a-b,\\,c⟩ & =⟨2a,c⟩-⟨b,c⟩ \\\\  & =2⟨a,c⟩-⟨b,c⟩\\end{aligned}\n$$\n\n \n\nNext, we use the fact that the inner product over $C$ has conjugate symmetry: \n\n$$\n\\begin{aligned}2⟨a,c⟩-⟨b,c⟩ & =2⟨a,c⟩-\\overset{―}{⟨c,b}⟩\\end{aligned}\n$$\n\nFinally, we substitute the values for $⟨a,c⟩$ and $⟨c,b⟩:$    \n\n$$\n\\begin{aligned}2⟨a,c⟩-\\overset{―}{⟨c,b}⟩ & =2(8+\\text{i})-(\\overset{―}{4-5\\text{i}}) \\\\  & =2(8+\\text{i})-(4+5\\text{i}) \\\\  & =16+2\\text{i}-4-5\\text{i} \\\\  & =12-3\\text{i}\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360769 1068 #edb/ref 17592186360185 13194139533433 17592186045585 true] [17592186360769 1069 "q-97176" 13194139533433 17592186045585 true] [17592186360769 1070 #edb/ref 17592186045486 13194139533433 17592186045585 true] [17592186360769 1071 "Given $X∼\\text{Geom}(0.7),$ compute $P(X>3).$" 13194139533433 17592186045585 true] [17592186360769 1072 #uuid "65a05d9a-51ee-5dbc-9b7f-08a37f4016a8" 13194139533433 17592186045585 true] [17592186360769 1074 "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.3)}^{x-1}(0.7), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>3.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X>3) & =1-P(X\\le 3)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X\\in {1,2,3}) \\\\  & =P(X=1)+P(X=2)+P(X=3) \\\\  & =f(1)+f(2)+f(3) \\\\  & ={(0.3)}^{0}(0.7)+{(0.3)}^{1}(0.7)+{(0.3)}^{2}(0.7) \\\\  & =0.973.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>3) & =1-P(X\\le 3) \\\\  & =1-0.973 \\\\  & =0.027.\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360770 1068 #edb/ref 17592186360386 13194139533433 17592186045585 true] [17592186360770 1069 "q-97178" 13194139533433 17592186045585 true] [17592186360770 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360770 1071 "Given $X∼\\text{Geom}(0.4),$ compute $P(X\\ge 4)$ rounded to $3$ decimal places." 13194139533433 17592186045585 true] [17592186360770 1072 #uuid "94d366d7-3864-5a66-9dc0-0af2554041d2" 13194139533433 17592186045585 true] [17592186360770 1074 "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)={\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.4),$ so the distribution of $X$ in this case is\n\n$$\nf(x)={\\begin{aligned}{(0.6)}^{x-1}(0.4), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 4.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 4) & =1-P(X<4)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\in {1,2,3}) \\\\  & =P(X=1)+P(X=2)+P(X=3) \\\\  & =f(1)+f(2)+f(3) \\\\  & ={(0.6)}^{0}(0.4)+{(0.6)}^{1}(0.4)+{(0.6)}^{2}(0.4) \\\\  & =0.784.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 4) & =1-P(X<4) \\\\  & =1-0.784 \\\\  & =0.216.\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360771 1068 #edb/ref 17592186360390 13194139533433 17592186045585 true] [17592186360771 1069 "q-97180" 13194139533433 17592186045585 true] [17592186360771 1070 #edb/ref 17592186045486 13194139533433 17592186045585 true] [17592186360771 1071 "Given that $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ is the standard Hermitian inner product over $C,$ find $⟨a,\\,b+(2+5\\text{i})c⟩$ if \n\n$\\,$ $⟨b,a⟩=3-\\text{i}\\,$ and $\\,⟨a,c⟩=\\text{i}.$" 13194139533433 17592186045585 true] [17592186360771 1072 #uuid "926d966b-0333-5eff-ad69-722d66b05ff2" 13194139533433 17592186045585 true] [17592186360771 1074 "Recall that the inner product over $C$ satisfies the following properties. \n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nFirst, we use the fact that the inner product over $C$ is antilinear in the second argument:\n\n$$\n\\begin{aligned}⟨a,\\,b+(2+5\\text{i})c⟩ & =⟨a,b⟩+⟨a,(2+5\\text{i})c⟩ \\\\  & =⟨a,b⟩+(\\overset{―}{2+5\\text{i}})⟨a,c⟩ \\\\  & =⟨a,b⟩+(2-5\\text{i})⟨a,c⟩\\end{aligned}\n$$\n\nNow, we use the fact that the inner product over $C$ has conjugate symmetry:\n\n$$\n\\begin{aligned}⟨a,b⟩+(2-5\\text{i})⟨a,c⟩ & =\\overset{―}{⟨b,a⟩}+(2-5\\text{i})⟨a,c⟩\\end{aligned}\n$$\n\nFinally, we substitute the values for $⟨b,a⟩$ and $⟨a,c⟩:$\n\n$$\n\\begin{aligned}\\overset{―}{⟨b,a⟩}+(2-5\\text{i})⟨a,c⟩ & =\\overset{―}{3-\\text{i}}+(2-5\\text{i})\\cdot \\text{i} \\\\  & =3+\\text{i}+(2-5\\text{i})\\cdot \\text{i} \\\\  & =3+\\text{i}+2\\text{i}-5(-1) \\\\  & =8+3\\text{i}\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360772 1068 #edb/ref 17592186360235 13194139533433 17592186045585 true] [17592186360772 1069 "q-97186" 13194139533433 17592186045585 true] [17592186360772 1070 #edb/ref 17592186045486 13194139533433 17592186045585 true] [17592186360772 1071 "Given that $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ is the standard Hermitian inner product over $C,$ find $⟨a,\\,(3+2\\text{i})b+c⟩$ if  \n\n$\\,$ $⟨b,a⟩=2\\text{i}\\,$ and $\\,⟨c,a⟩=1+\\text{i}.$" 13194139533433 17592186045585 true] [17592186360772 1072 #uuid "8d00705f-7416-5b50-99d0-3761146c6278" 13194139533433 17592186045585 true] [17592186360772 1074 "Recall that the inner product over $C$ satisfies the following properties. \n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nFirst, we use the fact that the inner product over $C$ is antilinear in the second argument:\n\n$$\n\\begin{aligned}⟨a,\\,(3+2\\text{i})b+c⟩ & =⟨a,(3+2\\text{i})b⟩+⟨a,c⟩ \\\\  & =(\\overset{―}{3+2\\text{i}})⟨a,b⟩+⟨a,c⟩ \\\\  & =(3-2\\text{i})⟨a,b⟩+⟨a,c⟩\\end{aligned}\n$$\n\nNow, we use the fact that the inner product over $C$ has conjugate symmetry:\n\n$$\n\\begin{aligned}(3-2\\text{i})⟨a,b⟩+⟨a,c⟩ & =(3-2\\text{i})\\overset{―}{⟨b,a⟩}+\\overset{―}{⟨c,a⟩}\\end{aligned}\n$$\n\nFinally, we substitute the values for $⟨b,a⟩$ and $⟨c,a⟩:$ \n\n$$\n\\begin{aligned}(3-2\\text{i})\\overset{―}{⟨b,a⟩}+\\overset{―}{⟨c,a⟩} & =(3-2\\text{i})\\cdot \\overset{―}{2\\text{i}}+\\overset{―}{1+\\text{i}} \\\\  & =(3-2\\text{i})\\cdot (-2\\text{i})+(1-\\text{i}) \\\\  & =-6\\text{i}+4{\\text{i}}^{2}+1-\\text{i} \\\\  & =-6\\text{i}+4(-1)+1-\\text{i} \\\\  & =-3-7\\text{i}\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360773 1068 #edb/ref 17592186360279 13194139533433 17592186045585 true] [17592186360773 1069 "q-97193" 13194139533433 17592186045585 true] [17592186360773 1070 #edb/ref 17592186045486 13194139533433 17592186045585 true] [17592186360773 1071 "Given that $⟨\\,\\cdot \\,,\\,\\cdot \\,⟩$ is the standard Hermitian inner product over $C,$ find $⟨a,\\,(4-\\text{i})b+c⟩$ if  \n\n$\\,$ $⟨b,a⟩=-1-\\text{i}\\,$ and $\\,⟨a,c⟩=5.$" 13194139533433 17592186045585 true] [17592186360773 1072 #uuid "34140471-4f5c-5a2d-9e46-e76840a3d73f" 13194139533433 17592186045585 true] [17592186360773 1074 "Recall that the inner product over $C$ satisfies the following properties. \n\n- It is linear in the first argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a+b,c⟩=⟨a,c⟩+⟨b,c⟩\\,$ and $\\,⟨\\alpha a,b⟩=\\alpha ⟨a,b⟩.$\n\n- It is antilinear in the second argument. For any $a,b,c\\in {C}^{n}$ and any $\\alpha \\in C,$ we have\n\n$\\,$ $⟨a,b+c⟩=⟨a,b⟩+⟨a,c⟩\\,$ and $\\,⟨a,\\alpha b⟩=\\overset{―}{\\alpha }⟨a,b⟩.$\n\n- It has conjugate symmetry. For any $a,b\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,b⟩=\\overset{―}{⟨b,a⟩}.$\n\n- It is positive-definite. For any $a\\in {C}^{n},$ we have\n\n$\\,$ $⟨a,a⟩$ is a non-negative real number, and $⟨a,a⟩=0$ if and only if $a=0.$\n\nFirst, we use the fact that the inner product over $C$ is antilinear in the second argument:\n\n$$\n\\begin{aligned}⟨a,\\,(4-\\text{i})b+c⟩ & =⟨a,(4-\\text{i})b⟩+⟨a,c⟩ \\\\  & =(\\overset{―}{4-\\text{i}})⟨a,b⟩+⟨a,c⟩ \\\\  & =(4+\\text{i})⟨a,b⟩+⟨a,c⟩\\end{aligned}\n$$\n\nNow, we use the fact that the inner product over $C$ has conjugate symmetry:\n\n$$\n\\begin{aligned}(4+\\text{i})⟨a,b⟩+⟨a,c\\text{ }⟩ & =(4+\\text{i})\\overset{―}{⟨b,a⟩}+⟨a,c⟩\\end{aligned}\n$$\n\nFinally, we substitute the values for $⟨b,a⟩$ and $⟨a,c⟩:$  \n\n$$\n\\begin{aligned}(4+\\text{i})\\overset{―}{⟨b,a⟩}+⟨a,c⟩ & =(4+\\text{i})\\cdot (\\overset{―}{-1-\\text{i}})+5 \\\\  & =(4+\\text{i})\\cdot (-1+\\text{i})+5 \\\\  & =-5+3\\text{i}+5 \\\\  & =3\\text{i}\\end{aligned}\n$$" 13194139533433 17592186045585 true] [17592186360774 1068 #edb/ref 17592186360090 13194139533433 17592186045585 true] [17592186360774 1069 "q-9720" 13194139533433 17592186045585 true] [17592186360774 1070 #edb/ref 17592186045487 13194139533433 17592186045585 true] [17592186360774 1071 "The system of equations\n\n$$\n\\begin{aligned}{\\begin{aligned}y+2z-x=1 \\\\ 6y+3x-2z=2 \\\\ x+3z-y=-3\\end{aligned}\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n$$\n[\\begin{aligned}a & 1 & 2 \\\\ 3 & b & -2 \\\\ 1 & -1 & 3\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}1 \\\\ 2 \\\\ c\\end{aligned}].\n$$\n\nWhat are the values of $a,b$ and $c?$" 13194139533433 17592186045585 true] [17592186360774 1072 #uuid "b4913b2d-3ba5-5e48-86c0-076ebc0464a0" 13194139533433 17592186045585 true] [17592186360774 1074 "First, let's write the system so that $x$, $y$, and $z$ appear in each equation in the correct order and all constants are on the right-hand side of the system:\n\n$$\n\\begin{aligned}{\\begin{aligned}-x+y+2z=1 \\\\ 3x+6y-2z=2 \\\\ x-y+3z=-3\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system 