1}^{2}) \\\\  & =3{e}^{2}+3.\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096482 1071 "Calculate $\\displaystyle \\int \\dfrac{\\log_4{x}}{x^3} \\,\\textrm{d}x$." 13194139533388 17592186045585 false] [17592186096482 1071 "Calculate $\\displaystyle \\int \\dfrac{\\log_4{x}}{x^3} \\,\\textrm{d}x.$" 13194139533388 17592186045585 true] [17592186096482 1074 "We define\n\n$$\n\\begin{aligned}u={log}_{4}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ {v}^{′}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\,\\frac{1}{2{x}^{2}}\\,.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{4}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u{v}^{′}\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{4}⁡x(-\\,\\frac{1}{2{x}^{2}})-\\int (-\\,\\frac{1}{2{x}^{2}})\\frac{1}{x\\operatorname{ln}⁡4}\\,\\text{d}x \\\\  & =-\\frac{1}{2{x}^{2}}\\,{log}_{4}⁡x+\\frac{1}{2\\operatorname{ln}⁡4}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡x}{2{x}^{2}\\operatorname{ln}⁡4}+\\frac{1}{2\\operatorname{ln}⁡4}(-\\,\\frac{1}{2{x}^{2}})+C \\\\  & =-\\frac{\\operatorname{ln}⁡x}{2{x}^{2}\\operatorname{ln}⁡4}-\\frac{1}{4{x}^{2}\\operatorname{ln}⁡4}+C \\\\  & =-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{2}\\operatorname{ln}⁡4}+C,\\end{aligned}\n$$\n\nNote that in the above calculation we used the change of base formula $\\log_4{x}=\\dfrac{\\ln{x}}{\\ln{4}}.$" 13194139533388 17592186045585 true] [17592186096482 1074 "We define\n\n$$\n\\begin{bmatrix}u = \\log_{4} x & ⟹u^{′} = \\frac{1}{x\\ln 4} \\\\ v^{′} = \\frac{1}{x^{3}} & ⟹v = \\int\\frac{1}{x^{3}}dx =-\\frac{1}{2x^{2}}\\end{bmatrix}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{\\log_{4} x}{x^{3}}dx &= \\intuv^{′}dx \\\\\n&= uv - \\intvu^{′}dx \\\\\n&= \\log_{4} x(-\\frac{1}{2x^{2}}) - \\int(-\\frac{1}{2x^{2}})\\frac{1}{x\\ln 4}dx \\\\\n&=-\\frac{1}{2x^{2}}\\log_{4} x + \\frac{1}{2\\ln 4}\\int\\frac{1}{x^{3}}dx \\\\\n&=-\\frac{\\ln x}{2x^{2}\\ln 4} + \\frac{1}{2\\ln 4}(-\\frac{1}{2x^{2}}) + C \\\\\n&=-\\frac{\\ln x}{2x^{2}\\ln 4} - \\frac{1}{4x^{2}\\ln 4} + C \\\\\n&=-\\frac{2\\ln x + 1}{4x^{2}\\ln 4} + C\n\\end{aligned}\n$$\n\nNote that in the above calculation we used the change of base formula\n\n$$\n\\log_4{x}=\\dfrac{\\ln{x}}{\\ln{4}}\n$$" 13194139533388 17592186045585 false] [17592186096489 1074 "Our task is to find $A$ and $B$ such that\n\n$$\n\\dfrac{2x-1}{(x+2)(x-3)} = \\dfrac{A}{(x+2)} +\\dfrac{B}{(x-3)}\n$$\n\nMultiplying the above expression through by $(x+2)(x-3)$ gives\n\n$$\n2x-1= A(x-3)+B(x+2)\n$$\n\nPlugging in $x=-2$ gets rid of the $B$ term and allows us to solve for $A$. We get\n\n$$\n\\begin{aligned}\n2(-2) - 1 &= A(-2 - 3) + B(-2 + 2) \\\\\n- 5 &= A(-5) + B(0) \\\\\nA &= 1\n\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=3$ gets rid of the $A$ term and allows us to solve for $B$. We get\n\n$$\n\\begin{aligned}\n2(3) - 1 &= A(3 - 3) + B(3 + 2) \\\\\n5 &= A(0) + B(5) \\\\\nB &= 1\n\\end{aligned}\n$$\n\nKnowing that $A=1$ and $B=1$, we have\n\n$$\n\\dfrac{2x-1}{(x+2)(x-3)} = \\dfrac{1}{(x+2)} +\\dfrac{1}{(x-3)}\n$$" 13194139533388 17592186045585 false] [17592186096489 1074 "Our task is to find $A$ and $B$ such that\n\n$$\n\\dfrac{2x-1}{(x+2)(x-3)} = \\dfrac{A}{(x+2)} +\\dfrac{B}{(x-3)}.\n$$\n\nMultiplying the above expression through by $(x+2)(x-3)$ gives\n\n$$\n2x-1= A(x-3)+B(x+2).\n$$\n\nPlugging in $x=-2$ gets rid of the $B$ term and allows us to solve for $A.$ We get\n\n$$\n\\begin{aligned}2(-2)-1 & =A(-2-3)+B(-2+2) \\\\ -5 & =A(-5)+B(0) \\\\ A & =1.\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=3$ gets rid of the $A$ term and allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}2(3)-1 & =A(3-3)+B(3+2) \\\\ 5 & =A(0)+B(5) \\\\ B & =1.\\end{aligned}\n$$\n\nKnowing that $A=1$ and $B=1,$ we have\n\n$$\n\\dfrac{2x-1}{(x+2)(x-3)} = \\dfrac{1}{(x+2)} +\\dfrac{1}{(x-3)}.\n$$" 13194139533388 17592186045585 true] [17592186096492 1071 "![](images/24/2420154d44b786c6aad54212760e9a37ce67dbdce94a7043039f0e824c5ef9bc.png)\n\nIn parallelogram $ABCD$ shown above, which of the following equalities are true?\n\n- $\\overrightarrow{CB}+\\overrightarrow{BA}=\\overrightarrow{CA}$\n\n- $\\overrightarrow{CB}-\\overrightarrow{AB}=\\overrightarrow{AC}$\n\n- $\\overrightarrow{DC}=\\overrightarrow{BA}$" 13194139533388 17592186045585 true] [17592186096492 1071 "![](images/24/2420154d44b786c6aad54212760e9a37ce67dbdce94a7043039f0e824c5ef9bc.png)\n\nIn parallelogram $ABCD$ shown above, which of the following equalities are true?\n\n1. $\\overrightarrow{CB}+\\overrightarrow{BA}=\\overrightarrow{CA}$\n2. $\\overrightarrow{CB}-\\overrightarrow{AB}=\\overrightarrow{AC}$\n3. $\\overrightarrow{DC}=\\overrightarrow{BA}$" 13194139533388 17592186045585 false] [17592186096492 1074 "- Equality I is true. Indeed, $\\overrightarrow{CB}+\\overrightarrow{BA}=\\overrightarrow{CA}$.\n- Equality II is false. Indeed,\n$CB^(→) - AB^(→)|= CB^(→) + BA^(→); = CA^(→); \\ne AC^(→)$\nsince $\\overrightarrow{CA}$ and $\\overrightarrow{AC}$ have opposite directions.\n- Equality III is false. Indeed, $\\overrightarrow{DC}\\neq\\overrightarrow{BA}$ since they have opposite directions.\n\nTherefore, the correct answer is \"I only.\"" 13194139533388 17592186045585 false] [17592186096492 1074 "- Equality I is true. Indeed, $\\overrightarrow{CB}+\\overrightarrow{BA}=\\overrightarrow{CA}.$\n\n- Equality II is false. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{CB}-\\overset{\\to }{AB} & =\\overset{\\to }{CB}+\\overset{\\to }{BA} \\\\  & =\\overset{\\to }{CA} \\\\  & \\ne \\overset{\\to }{AC}\\end{aligned}\n$$\n\nsince $\\overrightarrow{CA}$ and $\\overrightarrow{AC}$ have opposite directions.\n\n- Equality III is false. Indeed, $\\overrightarrow{DC}\\neq\\overrightarrow{BA}$ since they have opposite directions.\n\nTherefore, the correct answer is \"I only.\"" 13194139533388 17592186045585 true] [17592186096493 1074 "Our task is to find $A$, $B$, and $C$ such that\n\n$$\n\\dfrac{2x^2+5x+7}{(x+2)(x-3)(x+1)} = \\dfrac{A}{x+2} + \\dfrac{B}{x-3} + \\dfrac{C}{x+1}\n$$\n\nFirst, we multiply both sides of the equation by $(x+2)(x-3)(x+1)$ to clear the fractions:\n\n$$\n2x^2+5x+7= A(x-3)(x+1)+B(x+2)(x+1)+C(x+2)(x-3)\n$$\n\nPlugging in $x=-2$ gets rid of the $B$ and $C$ terms and allows us to solve for $A$. We get\n\n$$\n\\begin{aligned}\n2(-2)^{2} + 5(-2) + 7 &= A(-2 - 3)(-2 + 1) \\\\\n5 &= A(5) \\\\\nA &= 1\n\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=3$ gets rid of the $A$ and $C$ terms and allows us to solve for $B$. We get\n\n$$\n\\begin{aligned}\n2(3)^{2} + 5(3) + 7 &= B(3 + 2)(3 + 1) \\\\\n40 &= B(20) \\\\\nB &= 2\n\\end{aligned}\n$$\n\nFinally, plugging in $x=-1$ gets rid of the $A$ and $B$ terms and allows us to solve for $C$. We get\n\n$$\n\\begin{aligned}\n2(-1)^{2} + 5(-1) + 7 &= C(-1 + 2)(-1 - 3) \\\\\n4 &= C(-4) \\\\\nC &= -1\n\\end{aligned}\n$$\n\nKnowing that $A=1$, $B=2$, and $C=-1$, we have\n\n$$\n\\dfrac{2x^2+5x+7}{(x+2)(x-3)(x+1)} = \\dfrac{1}{x+2} +\\dfrac{2}{x-3} -\\dfrac{1}{x+1}\n$$" 13194139533388 17592186045585 false] [17592186096493 1074 "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\dfrac{2x^2+5x+7}{(x+2)(x-3)(x+1)} = \\dfrac{A}{x+2} + \\dfrac{B}{x-3} + \\dfrac{C}{x+1}.\n$$\n\nFirst, we multiply both sides of the equation by $(x+2)(x-3)(x+1)$ to clear the fractions:\n\n$$\n2x^2+5x+7= A(x-3)(x+1)+B(x+2)(x+1)+C(x+2)(x-3)\n$$\n\nPlugging in $x=-2$ gets rid of the $B$ and $C$ terms and allows us to solve for $A.$ We get\n\n$$\n\\begin{aligned}2(-2)^{2}+5(-2)+7 & =A(-2-3)(-2+1) \\\\ 5 & =A(5) \\\\ A & =1.\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=3$ gets rid of the $A$ and $C$ terms and allows us to solve for $B.$ We get\n\n$$\n\\begin{aligned}2(3)^{2}+5(3)+7 & =B(3+2)(3+1) \\\\ 40 & =B(20) \\\\ B & =2.\\end{aligned}\n$$\n\nFinally, plugging in $x=-1$ gets rid of the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}2(-1)^{2}+5(-1)+7 & =C(-1+2)(-1-3) \\\\ 4 & =C(-4) \\\\ C & =-1.\\end{aligned}\n$$\n\nKnowing that $A=1,$ $B=2,$ and $C=-1,$ we have\n\n$$\n\\dfrac{2x^2+5x+7}{(x+2)(x-3)(x+1)} = \\dfrac{1}{x+2} +\\dfrac{2}{x-3} -\\dfrac{1}{x+1}.\n$$" 13194139533388 17592186045585 true] [17592186096494 1074 "Our task is to find $A$, $B$ and $C$ such that\n\n$$\n\\begin{aligned}\n(2x + 3)/((x^{2} + 4)(x - 1)) &= \\frac{Ax + B}{x^{2} + 4} + \\frac{C}{x - 1}\n\\end{aligned}\n$$\n\nNote that since $x^2+4$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $(x^2+4)(x-1)$ and get\n\n$$\n\\begin{aligned}\n2x + 3 &= (Ax + B)(x - 1) + C(x^{2} + 4)\n\\end{aligned}\n$$\n\nPlugging in $x=1$ eliminates the $A$ and $B$ terms and allows us to solve for $C$. We get\n\n$$\n\\begin{aligned}\n2(1) + 3 &= (A(1) + B)(1 - 1) + C(1^{2} + 4) \\\\\n5 &= 5C \\\\\nC &= 1\n\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B$. We get\n\n$$\n\\begin{aligned}\n2(0) + 3 &= (A(0) + B)(0 - 1) + C(0^{2} + 4) \\\\\n3 &= -B + 4C \\\\\n3 &= -B + 4(1) \\\\\nB &= 1\n\\end{aligned}\n$$\n\nFinally, to solve for $A$, we choose $x=2$ and use our results for $B$ and $C$. We get\n\n$$\n\\begin{aligned}\n2(2) + 3 &= (A(2) + B)(2 - 1) + C(2^{2} + 4) \\\\\n7 &= 2A + B + 8C \\\\\n7 &= 2A + 1 + 8(1) \\\\\n2A &= -2 \\\\\nA &= -1\n\\end{aligned}\n$$\n\nSo we have $A=-1$, $B=1$, and $C=1$. Therefore, our final result is\n\n$$\n\\dfrac{2x+3}{(x^2+4)(x-1)} = \\dfrac{1-x}{x^2+4} +\\dfrac{1}{x-1}\n$$" 13194139533388 17592186045585 false] [17592186096494 1074 "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{2x+3}{({x}^{2}+4)(x-1)} & =\\frac{Ax+B}{{x}^{2}+4}+\\frac{C}{x-1}.\\end{aligned}\n$$\n\nNote that since $x^2+4$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $(x^2+4)(x-1)$ and get\n\n$$\n\\begin{aligned}2x+3 & =(Ax+B)(x-1)+C({x}^{2}+4).\\end{aligned}\n$$\n\nPlugging in $x=1$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}2(1)+3 & =(A(1)+B)(1-1)+C({1}^{2}+4) \\\\ 5 & =5C \\\\ C & =1.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}2(0)+3 & =(A(0)+B)(0-1)+C({0}^{2}+4) \\\\ 3 & =-B+4C \\\\ 3 & =-B+4(1) \\\\ B & =1.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=2$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}2(2)+3 & =(A(2)+B)(2-1)+C({2}^{2}+4) \\\\ 7 & =2A+B+8C \\\\ 7 & =2A+1+8(1) \\\\ 2A & =-2 \\\\ A & =-1.\\end{aligned}\n$$\n\nSo we have $A=-1,$ $B=1,$ and $C=1.$ Therefore, our final result is\n\n$$\n\\dfrac{2x+3}{(x^2+4)(x-1)} = \\dfrac{1-x}{x^2+4} +\\dfrac{1}{x-1}.\n$$" 13194139533388 17592186045585 true] [17592186096495 1071 "![](images/73/7304e120f4b4ddccfc08fd789becff6e3c3308c4c67f82b229819afa4bc11c04.png)\n\n  \n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 true] [17592186096495 1071 "![](images/73/7304e120f4b4ddccfc08fd789becff6e3c3308c4c67f82b229819afa4bc11c04.png)\n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 false] [17592186096495 1074 "From the diagram we see that the parabola is downward-opening, has its vertex at $(0,0)$, and passes through the point $(6,-4)$.\n\nFor any upward or downward-opening parabola whose vertex is $(0,0)$, the general standard equation is given by\n\n$$\nx^2 = 4py\n$$\n\nwhere $p$ is a constant.\n\nWe know that the given parabola passes through the point $(6,-4)$, so we can substitute $x = 6$ and $y = -4$ into the standard equation and solve for $p$:\n\n$$\n\\begin{aligned}\nx^{2} &= 4py \\\\\n6^{2} &= 4p(-4) \\\\\n36 &= -16p \\\\\np &= -\\frac{9}{4}\n\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}\nx^{2} &= 4py \\\\\nx^{2} &= 4(-\\frac{9}{4})y \\\\\nx^{2} &= -9y\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096495 1074 "From the diagram we see that the parabola is downward-opening, has its vertex at $(0,0),$ and passes through the point $(6,-4).$\n\nFor any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\nx^2 = 4py\n$$\n\nwhere $p$ is a constant.\n\nWe know that the given parabola passes through the point $(6,-4),$ so we can substitute $x = 6$ and $y = -4$ into the standard equation and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {6}^{2} & =4p(-4) \\\\ 36 & =-16p \\\\ p & =-\\frac{9}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-\\frac{9}{4})y \\\\ {x}^{2} & =-9y.\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096496 1071 "Find the equation of the downward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(2,-4)$." 13194139533388 17592186045585 false] [17592186096496 1071 "Find the equation of the downward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(2,-4).$" 13194139533388 17592186045585 true] [17592186096496 1074 "We know that for any upward or downward-opening parabola whose vertex is $(0,0)$, the general standard equation is given by\n\n$$\nx^2 = 4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(2,-4)$, so we can substitute $x = 2$ and $y = -4$ into the standard equation and solve for $p$:\n\n$$\n\\begin{aligned}\nx^{2} &= 4py \\\\\n2^{2} &= 4p(-4) \\\\\n4 &= -16p \\\\\np &= -\\frac{1}{4}\n\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}\nx^{2} &= 4py \\\\\nx^{2} &= 4(-\\frac{1}{4})y \\\\\nx^{2} &= -y\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096496 1074 "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\nx^2 = 4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(2,-4),$ so we can substitute $x = 2$ and $y = -4$ into the standard equation and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {2}^{2} & =4p(-4) \\\\ 4 & =-16p \\\\ p & =-\\frac{1}{4}\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-\\frac{1}{4})y \\\\ {x}^{2} & =-y.\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096497 1071 "![](images/1a/1aa2a01a01db6b9e2c4ca7ca1b8319eb29de920ce5d28997f42cb494f9f74a21.png)\n\n  \n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 true] [17592186096497 1071 "![](images/1a/1aa2a01a01db6b9e2c4ca7ca1b8319eb29de920ce5d28997f42cb494f9f74a21.png)\n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 false] [17592186096497 1074 "From the diagram we see that the parabola is downward-opening, has its vertex at $(0,4)$, and passes through the point $(4,2)$.\n\nWe know that for any upward or downward-opening parabola with its vertex at $(h,k)$, the general standard equation is given by\n\n$$\n(x-h)^2 = 4p(y-k)\n$$\n\nHere, the vertex has coordinates\n\n$$\n(h,k) = (0,4)\n$$\n\nSubstituting these into the general standard equation, we get\n\n$$\nx^2 = 4p(y-4)\n$$\n\nWe are left to find the value of $p$. We know that the given parabola also passes through the point $(4,2)$, so we can substitute $x = 4$ and $y = 2$ into the standard equation and solve for $p$:\n\n$$\n\\begin{aligned}\nx^{2} &= 4p(y - 4) \\\\\n4^{2} &= 4p(2 - 4) \\\\\n16 &= -8p \\\\\np &= -2\n\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}\nx^{2} &= 4p(y - 4) \\\\\nx^{2} &= 4(-2)(y - 4) \\\\\nx^{2} &= -8(y - 4)\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096497 1074 "From the diagram we see that the parabola is downward-opening, has its vertex at $(0,4),$ and passes through the point $(4,2).$\n\nWe know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^2 = 4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k) = (0,4).$ Substituting these into the general standard equation, we get\n\n$$\nx^2  = 4p(y-4).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,2),$ so we can substitute $x = 4$ and $y = 2$ into the standard equation and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{2} & =4p(y-4) \\\\ {4}^{2} & =4p(2-4) \\\\ 16 & =-8p \\\\ p & =-2\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4p(y-4) \\\\ {x}^{2} & =4(-2)(y-4) \\\\ {x}^{2} & =-8(y-4).\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096498 1071 "Find the equation of the upward-opening parabola that has its vertex at $(0,-2)$ and which passes through the point $(4,6)$." 13194139533388 17592186045585 false] [17592186096498 1071 "Find the equation of the upward-opening parabola that has its vertex at $(0,-2)$ and which passes through the point $(4,6).$" 13194139533388 17592186045585 true] [17592186096498 1074 "For any upward or downward-opening parabola with its vertex at $(h,k)$, the general standard equation is given by\n\n$$\n(x-h)^2 = 4p(y-k)\n$$\n\nHere, the vertex has coordinates\n\n$$\n(h,k) = (0,-2)\n$$\n\nSubstituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}\n(x - 0)^{2} &= 4p(y - (-2)) \\\\\nx^{2} &= 4p(y + 2)\n\\end{aligned}\n$$\n\nWe are left to find the value of $p$. We know that the given parabola also passes through the point $(4,6)$, so we can substitute $x = 4$ and $y = 6$ into the standard equation and solve for $p$:\n\n$$\n\\begin{aligned}\nx^{2} &= 4p(y + 2) \\\\\n(4)^{2} &= 4p(6 + 2) \\\\\n16 &= 32p \\\\\np &= \\frac{1}{2}\n\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}\nx^{2} &= 4p(y + 2) \\\\\nx^{2} &= 4(\\frac{1}{2})(y + 2) \\\\\nx^{2} &= 2(y + 2)\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096498 1074 "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^2 = 4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k) = (0,-2).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-0)^{2} & =4p(y-(-2)) \\\\ {x}^{2} & =4p(y+2).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(4,6),$ so we can substitute $x = 4$ and $y = 6$ into the standard equation and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{2} & =4p(y+2) \\\\ (4)^{2} & =4p(6+2) \\\\ 16 & =32p \\\\ p & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4p(y+2) \\\\ {x}^{2} & =4(\\frac{1}{2})(y+2) \\\\ {x}^{2} & =2(y+2).\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096501 1071 "Consider the picture below.\n\n![](images/f2/f2518c2e998e7c7f551548a4cc7283720a66428ea8fa9872494a81cc3848ba9e.png)\n\nGiven that ![](images/c6/c6714d0a6eaa5c7d354d46e8d6d60da7f3d2011df0fc75773036cf7ae510c5e3.png), find ![](images/24/24878591902884f45f14f5c447bc326586a411a8870b205fc12825a4ab2c738a.png)" 13194139533388 17592186045585 true] [17592186096501 1071 "Consider the picture below. Given that $\\mathbf{c}=\\mathbf{a}+\\lambda\\mathbf{b}$, find $\\lambda$.\n\n![](images/dd/dd358560a9ecba6402d312d7b1367141adf34806411f4af91e8c2c92480ee94f.png)" 13194139533388 17592186045585 false] [17592186096501 1074 "![](images/55/556562c46c6cff51b22397e4903fe3a750a0c88469acdcfe73eaf07f903a601b.png)\n\nIn $\\bigtriangleup OAC$, we have:\n\n- $AC=2 \\mid \\mathbf{b} \\mid$\n- $\\overrightarrow{AC}$ and $\\mathbf{b}$ have the same direction\n\nHence,\n\n$$\n\\overrightarrow{AC}=2\\mathbf{b}\n$$\n\nAdditionally,\n\n$$\n\\begin{aligned}\nc &= OA^(→) + AC^(→) \\\\\n&= a + 2b\n\\end{aligned}\n$$\n\nConsequently,\n\n$$\n\\mathbf{c}=\\mathbf{a}+\\lambda\\mathbf{b}=\\mathbf{a}+2\\mathbf{b}\n$$\n\nSince $\\mathbf{a} \\nparallel \\mathbf{b}$, the linear combination can only be written in one way. Equating the coefficients of $\\mathbf{b}$, we get:\n$\\lambda=2$" 13194139533388 17592186045585 false] [17592186096501 1074 "Recall that when two known vectors are not parallel, a linear combination of them is unique. So, once we rewrite ![](images/5c/5c644b15efcf5a4274de23242a722604ead2ff800ea29ba7a650729227fefdf0.png) in terms of ![](images/27/27f36b1d1846e12e3c50b7d4e47f5745727792d52a48e4d85b689ec36e3d25a0.png) and ![](images/a7/a7b9033c421072576aaf959980d778c319a8ed0f849e08db644b63bc6994088c.png) we can match coefficients to determine the unknown scalar.\n\nTo find ![](images/16/166c90a9c29f99347bff6b397f31d705ec6407a19b4d71246f98308bbd7a5473.png) we want to match the expression\n![](images/fc/fc79367916dd7671c17de4f40b3d83f91d41c2f9988645964de0b53e5b11ab9b.png)\n\nWe are given that one of the components is ![](images/91/91f686c6ca02e85c386cb0f9e80b66beface446d3a541952e0ac91738ad0db37.png) So, we first draw the vector ![](images/d5/d54b9a8919c7b6106fcf5770c62b1823605d7be98a55d5333e73bcfb7528997a.png) from the origin. Then we complete the path to the point ![](images/6e/6e1bbbe9eb66856824ff70d16cc2c077519d361546b226a67146e20f15a24dd0.png)\n\n![](images/ea/ea517ac4ca8e0bcf7ba48f23e66f100323d5485f1221219aacfbea9148f4a1af.png)\n\nNote that in ![](images/f1/f1c944e6afa4e9cd84bc68004a2bfd918d81498a727aeb7c56ec627806bf93f6.png), we have:\n\n- ![](images/b7/b7ac390c4e43b2fa2fbb4063632f98869256cea877caa5e5dad4aad33ae94722.png)\n\n- ![](images/7e/7e5f2b01647ab01052fff18ab760273eebe19d47b56051b1953adf587d7f9fb3.png) and ![](images/78/784225d11bf94b7fbd67f8e2395695141eb75b1cb44f89d49b29bb3a2031534b.png) have the same direction\n\nHence, ![](images/21/21261c8ad0d86a9e7300ffc58c57fd76beef9f627492bcfe2051d5e3cfd82a4e.png)\n\nAdditionally,\n![](images/ae/ae9c98ded3aa4317a729571710ad38d973a2d67b5faeb9ad26af7c24ee5c3193.png)\n\nConsequently, ![](images/ae/aee3287ad64a654880216142756811bd4d5232b3dba2f48378b8b1c5241e4316.png)\n\nSince ![](images/46/466863f8c7522ac89896a4233a823be02940535097c28328fa2c9e9e1f4bc3d8.png) the linear combination can only be written in one way. Equating the coefficients of ![](images/37/3720c5887713d3f7a29be384fe5e883390935b2b9b469af626a8dba968f4da8b.png) we get:\n![](images/4a/4ac145b710c5354b44a4ea1dc820d70f54b5c17985f078fce6313b671ec26fd9.png)" 13194139533388 17592186045585 true] [17592186096502 1071 "Find the general solution to the differential equation $f'(x) - 3\\sin(2x) = 0$." 13194139533388 17592186045585 false] [17592186096502 1071 "Find the general solution to the differential equation $f'(x) - 3\\sin(2x) = 0.$" 13194139533388 17592186045585 true] [17592186096502 1074 "First, we rearrange the equation to give\n\n$$\nf'(x) = 3\\sin{2x}\n$$\n\nThen, we integrate both sides of the equation with respect to $x$, and get\n\n$$\n\\begin{aligned}\n\\intf^{′}(x)dx &= \\int3\\sin 2xdx \\\\\nf(x) &= 3\\int\\sin 2xdx \\\\\n&=-\\frac{3}{2}\\cos 2x + C\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096502 1074 "First, we rearrange the equation to give\n\n$$\nf'(x) = 3\\sin{2x}.\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int 3\\operatorname{sin}⁡2x\\,\\text{d}x \\\\ f(x) & =3\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096503 1071 "Solve the differential equation\n\n$$\n\\dfrac{\\textrm d^2 y}{\\textrm d x^2} = x.\n$$" 13194139533388 17592186045585 true] [17592186096503 1071 "Solve the differential equation\n$\\dfrac{\\textrm d^2 y}{\\textrm d x^2} = x$." 13194139533388 17592186045585 false] [17592186096503 1074 "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{d^{2}y}{dx^{2}}dx &= \\intxdx \\\\\n\\frac{dy}{dx} &= \\frac{1}{2}x^{2} + C\n\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{dy}{dx}dx &= \\int(\\frac{1}{2}x^{2} + C)dx \\\\\ny &= \\frac{1}{6}x^{3} + Cx + D\n\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D$. We cannot combine them, because $C$ is being multiplied by $x$ while $D$ is not." 13194139533388 17592186045585 false] [17592186096503 1074 "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2}{x}^{2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (\\frac{1}{2}{x}^{2}+C)\\,\\text{d}x \\\\ y & =\\frac{1}{6}{x}^{3}+Cx+D\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$ We cannot combine them, because $C$ is being multiplied by $x$ while $D$ is not." 13194139533388 17592186045585 true] [17592186096504 1071 "Solve the differential equation $y'  = 2x,$ and sketch the solution curves of this equation." 13194139533388 17592186045585 true] [17592186096504 1071 "Solve the differential equation $y' = 2x$, and sketch the solution curves of this equation." 13194139533388 17592186045585 false] [17592186096504 1074 "Integrating the equation, we get\n\n$$\ny = x^2+C\n$$\n\nWe can now plot the solution curves by selecting different values for $C$. The sketch below shows the solution curves for $C=-2,0,1$.\n\n![](images/e3/e37771799ef5fadc259e6ea0073042a83e0974b5a2619d1af3e87a7467e6d780.png)" 13194139533388 17592186045585 false] [17592186096504 1074 "Integrating the equation, we get\n\n$$\ny = x^2+C.\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,1.$\n\n![](images/e3/e37771799ef5fadc259e6ea0073042a83e0974b5a2619d1af3e87a7467e6d780.png)" 13194139533388 17592186045585 true] [17592186096505 1071 "Find the particular solution to the differential equation below that satisfies the condition $f(0)=2$.\n$f'(x) - \\dfrac{3}{1+x^2} = 0$" 13194139533388 17592186045585 false] [17592186096505 1071 "Find the particular solution to the differential equation below that satisfies the condition $f(0)=2.$\n\n$$\nf'(x) - \\dfrac{3}{1+x^2} = 0\n$$" 13194139533388 17592186045585 true] [17592186096505 1074 "First, we rearrange the equation to give\n\n$$\nf'(x) = \\dfrac{3}{1+x^2}\n$$\n\nThen, we integrate both sides with respect to $x$, and get\n\n$$\n\\begin{aligned}\n\\intf^{′}(x)dx &= \\int\\frac{3}{1 + x^{2}}dx \\\\\nf(x) &= 3\\int\\frac{1}{1 + x^{2}}dx \\\\\n&= 3\\arctan x + C\n\\end{aligned}\n$$\n\nSo our general solution is\n\n$$\nf(x) = 3\\arctan{x} + C\n$$\n\nTo find a particular solution, we substitute the condition\n\n$$\nf(0) = 2\n$$\n\ninto our solution and obtain a value for $C$, as follows:\n\n$$\n\\begin{aligned}\nf(x) &= 3\\arctan (x) + C \\\\\n2 &= 3\\arctan (0) + C \\\\\n2 &= 0 + C \\\\\nC &= 2\n\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\nf(x)=3\\arctan x + 2\n$$" 13194139533388 17592186045585 false] [17592186096505 1074 "First, we rearrange the equation to give\n\n$$\nf'(x) = \\dfrac{3}{1+x^2}.\n$$\n\nThen, we integrate both sides with respect to $x,$ and get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{1+{x}^{2}}\\,\\text{d}x \\\\ f(x) & =3\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =3\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$\n\nSo our general solution is $f(x) = 3\\arctan{x} + C.$ To find a particular solution, we substitute the condition $f(0) = 2$ into our solution and obtain a value for $C,$ as follows:\n\n$$\n\\begin{aligned}f(x) & =3\\operatorname{arctan}⁡(x)+C \\\\ 2 & =3\\operatorname{arctan}⁡(0)+C \\\\ 2 & =0+C \\\\ C & =2.\\end{aligned}\n$$\n\nTherefore, our particular solution is \n\n$$\nf(x)=3\\arctan x + 2.\n$$" 13194139533388 17592186045585 true] [17592186096506 1071 "![](images/70/70ff1c84aa4a9a2adc393fc1dcf684ee0bcf161671b15f9061e2319f5d7e0a39.png)\n\n  \n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 true] [17592186096506 1071 "![](images/70/70ff1c84aa4a9a2adc393fc1dcf684ee0bcf161671b15f9061e2319f5d7e0a39.png)\n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 false] [17592186096506 1074 "From the diagram, we see that the arms of the parabola open to the left. The parabola has its vertex at $(0,0)$ and passes through the point $(-8,4)$.\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n$y^2 = 4px$.\n\nSince we know the given parabola passes through the point $(-8,4)$, we can substitute $x = -8$ and $y = 4$ into the standard equation and solve for $p$:\n\n$$\n\\begin{aligned}\ny^{2} &= 4px \\\\\n4^{2} &= 4p(-8) \\\\\n16 &= -32p \\\\\np &= -\\frac{1}{2}\n\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}\ny^{2} &= 4px \\\\\ny^{2} &= 4(-\\frac{1}{2})x \\\\\ny^{2} &= -2x\n\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since\n\n$$\np = -\\dfrac{1}{2}\n$$\n\nis negative." 13194139533388 17592186045585 false] [17592186096506 1074 "From the diagram, we see that the arms of the parabola open to the left. The parabola has its vertex at $(0,0)$ and passes through the point $(-8,4).$\n\nThe general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\ny^2  = 4px.\n$$\n\nSince we know the given parabola passes through the point $(-8,4),$ we can substitute $x = -8$ and $y = 4$ into the standard equation and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {4}^{2} & =4p(-8) \\\\ 16 & =-32p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{2})x \\\\ {y}^{2} & =-2x.\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p = -\\dfrac{1}{2}$ is negative." 13194139533388 17592186045585 true] [17592186096507 1071 "Find the equation of the right-opening parabola that has its vertex at $(0,0)$ and passes through the point $(4,4)$." 13194139533388 17592186045585 false] [17592186096507 1071 "Find the equation of the right-opening parabola that has its vertex at $(0,0)$ and passes through the point $(4,4).$" 13194139533388 17592186045585 true] [17592186096507 1074 "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\ny^2  = 4px.\n$$\n\nSince we know the given parabola passes through the point $(4,4),$ we can substitute $x=4$ and $y=4$ into the standard equation and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {4}^{2} & =4p(4) \\\\ 16 & =16p \\\\ p & =1\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(1)x \\\\ {y}^{2} & =4x.\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096507 1074 "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n$y^2 = 4px$.\n\nSince we know the given parabola passes through the point $(4,4)$, we can substitute $x=4$ and $y=4$ into the standard equation and solve for $p$:\n\n$$\n\\begin{aligned}\ny^{2} &= 4px \\\\\n4^{2} &= 4p(4) \\\\\n16 &= 16p \\\\\np &= 1\n\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}\ny^{2} &= 4px \\\\\ny^{2} &= 4(1)x \\\\\ny^{2} &= 4x\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096508 1071 "![](images/55/55651f756b31405e08cd96b097101528ffabff1e6411d3fcae9f40f747f607b4.png)\n\n  \n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 true] [17592186096508 1071 "![](images/55/55651f756b31405e08cd96b097101528ffabff1e6411d3fcae9f40f747f607b4.png)\n\nWhat is the equation of the parabola shown above?" 13194139533388 17592186045585 false] [17592186096508 1074 "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(4,2)$ and passes through the point $(0,6)$.\n\nThe general standard equation of a parabola whose vertex is $(h, k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}\n(y - k)^{2} &= 4p(x - h)\n\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at\n\n$$\n(h, k) = (4,2)\n$$\n\nwe substitute $h=4$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}\n(y - 2)^{2} &= 4p(x - 4)\n\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(0,6)$, so we can substitute $x=0$ and $y=6$ into the equation above and solve for $p$:\n\n$$\n\\begin{aligned}\n(y - 2)^{2} &= 4p(x - 4) \\\\\n(6 - 2)^{2} &= 4p(0 - 4) \\\\\n16 &= -16p \\\\\np &= -1\n\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}\n(y - 2)^{2} &= 4p(x - 4) \\\\\n(y - 2)^{2} &= 4(-1)(x - 4) \\\\\n(y - 2)^{2} &= -4(x - 4)\n\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p = -1$ is negative." 13194139533388 17592186045585 false] [17592186096508 1074 "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(4,2)$ and passes through the point $(0,6).$\n\nThe general standard equation of a parabola whose vertex is $(h, k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h, k) = (4,2),$ we substitute $h=4$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(0,6),$ so we can substitute $x=0$ and $y=6$ into the equation above and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4) \\\\ (6-2)^{2} & =4p(0-4) \\\\ 16 & =-16p \\\\ p & =-1\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x-4) \\\\ (y-2)^{2} & =4(-1)(x-4) \\\\ (y-2)^{2} & =-4(x-4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p = -1$ is negative." 13194139533388 17592186045585 true] [17592186096509 1071 "Find the equation of the left-opening parabola that has its vertex at $(2,-2)$ and passes through the point $(-6,2)$." 13194139533388 17592186045585 false] [17592186096509 1071 "Find the equation of the left-opening parabola that has its vertex at $(2,-2)$ and passes through the point $(-6,2).$" 13194139533388 17592186045585 true] [17592186096509 1074 "The general standard equation of a parabola whose vertex is $(h, k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}\n(y - k)^{2} &= 4p(x - h)\n\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at\n\n$$\n(h, k) = (2,-2)\n$$\n\nwe substitute $h=2$ and $k=-2$ into the equation above and get\n\n$$\n\\begin{aligned}\n(y + 2)^{2} &= 4p(x - 2)\n\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-6, 2)$, so we can substitute $x=-6$ and $y=2$ into the equation above and solve for $p$:\n\n$$\n\\begin{aligned}\n(y + 2)^{2} &= 4p(x - 2) \\\\\n(2 + 2)^{2} &= 4p(-6 - 2) \\\\\n16 &= -32p \\\\\np &= -\\frac{1}{2}\n\\end{aligned}\n$$\n\nSo, the equation of the parabola is\n\n$$\n\\begin{aligned}\n(y + 2)^{2} &= 4p(x - 2) \\\\\n(y + 2)^{2} &= 4(-\\frac{1}{2})(x - 2) \\\\\n(y + 2)^{2} &= -2(x - 2)\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186096509 1074 "The general standard equation of a parabola whose vertex is $(h, k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h, k) = (2,-2),$ we substitute $h=2$ and $k=-2$ into the equation above and get\n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x-2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-6, 2),$ so we can substitute $x=-6$ and $y=2$ into the equation above and solve for $p\\mathbin{:}$\n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x-2) \\\\ (2+2)^{2} & =4p(-6-2) \\\\ 16 & =-32p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x-2) \\\\ (y+2)^{2} & =4(-\\frac{1}{2})(x-2) \\\\ (y+2)^{2} & =-2(x-2).\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186096510 1071 "![](images/7d/7d1bf0d7128d5e1fffab3f4323f4f4c3ef3b7cae0e041a0cb2a510045d570f40.png)\n\n \n\nWhat is the $x$-intercept of the parabola shown above?" 13194139533388 17592186045585 true] [17592186096510 1071 "![](images/7d/7d1bf0d7128d5e1fffab3f4323f4f4c3ef3b7cae0e041a0cb2a510045d570f40.png)\n\nWhat is the $x$-intercept of the parabola shown above?" 13194139533388 17592186045585 false] [17592186096510 1074 "First, we need to find the equation of the parabola. The diagram shows that the parabola has a vertex at $(14,2)$ and passes through the point\n\n$$\n\\left(12,6\\right)\n$$\n\nThe equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^2 = 4p(x-h)\n$$\n\nSubstituting\n\n$$\n(h,k) = (14,2)\n$$\n\ninto the above gives\n\n$$\n(y-2)^2 = 4p(x-14)\n$$\n\nNow, we need to find $p$. Since the parabola passes through the point $(12,6)$, we substitute $x=12$ and $y=6$ into the equation and get\n\n$$\n\\begin{aligned}\n(6 - 2)^{2} &= 4p(12 - 14) \\\\\n16 &= 4p(-2) \\\\\np &= -2\n\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}\n(y - 2)^{2} &= -8(x - 14)\n\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y= 0$. So, we substitute $y=0$ into the equation of the parabola and solve for $x{:}$\n\n$$\n\\begin{aligned}\n(y - 2)^{2} &= -8(x - 14) \\\\\n(0 - 2)^{2} &= -8(x - 14) \\\\\n4 &= -8(x - 14) \\\\\nx - 14 &= -\\frac{1}{2} \\\\\nx &= -\\frac{1}{2} + 14 \\\\\nx &= \\frac{27}{2}\n\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is\n\n$$\n\\dfrac{27}{2}\n$$" 13194139533388 17592186045585 false] [17592186096510 1074 "First, we need to find the equation of the parabola. The diagram shows that the parabola has a vertex at $(14,2)$ and passes through the point $\\left(12,6\\right).$\n\nThe equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^2 = 4p(x-h).\n$$\n\nSubstituting $(h,k) = (14,2)$ into the above gives\n\n$$\n(y-2)^2 = 4p(x-14).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(12,6),$ we substitute $x=12$ and $y=6$ into the equation and get\n\n$$\n\\begin{aligned}(6-2)^{2} & =4p(12-14) \\\\ 16 & =4p(-2) \\\\ p & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-2)^{2} & =-8(x-14).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y= 0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x{:}$\n\n$$\n\\begin{aligned}(y-2)^{2} & =-8(x-14) \\\\ (0-2)^{2} & =-8(x-14) \\\\ 4 & =-8(x-14) \\\\ x-14 & =-\\frac{1}{2} \\\\ x & =-\\frac{1}{2}+14 \\\\ x & =\\frac{27}{2}\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $\\dfrac{27}{2}.$" 13194139533388 17592186045585 true] [17592186096511 1074 "To find the points of intersection of the parabola with the $y$-axis, we set $x=0$ and solve the resulting equation for $y$:\n\n$$\n\\begin{aligned}\n(y - 2)^{2} &= 4(x + 1) \\\\\n(y - 2)^{2} &= 4(0 + 1) \\\\\n(y - 2)^{2} &= 4 \\\\\ny - 2 &