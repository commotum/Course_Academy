^{2}}{36} &= \\sec^{2} t\n\\end{aligned}\n$$\n\n- Isolating the $\\tan{t}$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}\ny &= 4\\sqrt{2}\\tan t \\\\\n\\frac{y}{4\\sqrt{2}} &= \\tan t \\\\\n(\\frac{y}{4\\sqrt{2}})^{2} &= (\\tan t)^{2} \\\\\n(y^{2})/((4\\sqrt{2})^{2}) &= \\tan^{2} t \\\\\n\\frac{y^{2}}{32} &= \\tan^{2} t\n\\end{aligned}\n$$\n\nSubstituting the two equations into the identity\n\n$$\n\\tan^2{t} + 1 = \\sec^2{t}\n$$\n\nand rearranging, we get\n\n$$\n\\begin{aligned}\n\\tan^{2} t + 1 &= \\sec^{2} t \\\\\n\\frac{y^{2}}{32} + 1 &= \\frac{x^{2}}{36} \\\\\n\\frac{x^{2}}{36} - \\frac{y^{2}}{32} &= 1\n\\end{aligned}\n$$" 13194139533388 17592186045585 false] [17592186087563 1074 "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\sec t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =6\\operatorname{sec}⁡t \\\\ \\frac{x}{6} & =\\operatorname{sec}⁡t \\\\ {(\\frac{x}{6})}^{2} & ={(\\operatorname{sec}⁡t)}^{2} \\\\ \\frac{{x}^{2}}{{6}^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{36} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\tan{t}$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =4\\sqrt{2}\\operatorname{tan}⁡t \\\\ \\frac{y}{4\\sqrt{2}} & =\\operatorname{tan}⁡t \\\\ {(\\frac{y}{4\\sqrt{2}})}^{2} & ={(\\operatorname{tan}⁡t)}^{2} \\\\ \\frac{{y}^{2}}{{(4\\sqrt{2})}^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{32} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity $\\tan^2{t} + 1 = \\sec^2{t}$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{32}+1 & =\\frac{{x}^{2}}{36} \\\\ \\frac{{x}^{2}}{36}-\\frac{{y}^{2}}{32} & =1.\\end{aligned}\n$$" 13194139533388 17592186045585 true] [17592186087567 1071 "Suppose that the population $P(t)$ of a town after $t$ years can be modeled by the differential equation\n\n$$\n\\dfrac {\\textrm{d}P} {\\textrm{d}t} = 0.02P.\n$$\n\nIf there are currently $500$ people in the town, what will be the town's population in $3$ years?" 13194139533388 17592186045585 true] [17592186087567 1071 "Suppose that the population $P(t)$ of a town after $t$ years can be modeled by the differential equation\n\n$\\dfrac {\\textrm{d}P} {\\textrm{d}t} = 0.02P$.\n\nIf there are currently $500$ people in the town, what will be the town's population in $3$ years?" 13194139533388 17592186045585 false] [17592186087567 1074 "We note that this is an exponential growth differential equation with $r = 0.02$. Therefore, the solution to this equation is\n\n$$\nP(t) = P_0\\,e^{0.02t}\n$$\n\nwhere $P_0$ is the initial value.\n\nWe're told that the population is currently $500$, so we have $P_0 = 500$.\n\nTherefore, the population of the town at time $t$ is\n\n$$\nP(t) = 500\\,e^{0.02t}\n$$\n\nFinally, to find the population after $3$ years, we substitute $t=3$ into the above, as follows:\n\n$$\n\\begin{aligned}\nP(3) &= 500e^{0.02 \\cdot 3} \\\\\n&= 500e^{0.06} \\\\\n&\\approx 531\n\\end{aligned}\n$$\n\nTherefore, we conclude that the population will be approximately $531$ after $3$ years." 13194139533388 17592186045585 false] [17592186087567 1074 "We note that this is an exponential growth differential equation with $r = 0.02$. Therefore, the solution to this equation is\n\n$$\nP(t) = P_0\\,e^{0.02t},\n$$\n\nwhere $P_0$ is the initial value.\n\nWe're told that the population is currently $500,$ so we have $P_0 = 500.$ \n\nTherefore, the population of the town at time $t$ is\n\n$$\nP(t) = 500\\,e^{0.02t}.\n$$\n\nFinally, to find the population after $3$ years, we substitute $t=3$ into the above, as follows:\n\n$$\n\\begin{aligned}P(3) & =500\\,{e}^{0.02\\cdot 3} \\\\  & =500\\,{e}^{0.06} \\\\  & ≈531\\end{aligned}\n$$\n\nTherefore, we conclude that the population will be approximately $531$ after $3$ years." 13194139533388 17592186045585 true] [17592186087568 1071 "Are the following transformations linear?\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$" 13194139533388 17592186045585 true] [17592186087568 1071 "Are the following transformations linear?\n$\\begin{bmatrix}x \\\\ y\\end{bmatrix}$" 13194139533388 17592186045585 false] [17592186087568 1074 "A linear transformation $\\mathbf{T}$ satisfies two properties:\n\n$$\nT\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} = kT\\begin{bmatrix}x \\\\ y\\end{bmatrix},; T\\begin{bmatrix}x_{1} + x_{2} \\\\ y_{1} + y_{2}\\end{bmatrix} = T\\begin{bmatrix}x_{1} \\\\ y_{1}\\end{bmatrix} + T\\begin{bmatrix}x_{2} \\\\ y_{2}\\end{bmatrix}\n$$\n\nFirst, let's consider $\\mathbf{T}_1$. Checking the first condition, we have\n\n$$\n\\begin{aligned}\nT_{1}\\begin{bmatrix}kx \\\\ ky\\end{bmatrix} &= \\begin{bmatrix}(kx)^{2} \\\\ (kx)(ky)\\end{bmatrix} \\\\\n&= \\begin{bmatrix}k^{2}x^{2} \\\\ k^{2}xy\\end{bmatrix} \\\\\n&= k\\begin{bmatrix}kx^{2} \\\\ kxy\\end{bmatrix} \\\\\n&\\ne kT_{1}\\begin{bmatrix}x \\\\ y\\end{bmatrix}.\\cdot\n\\end{aligned}\n$$\n\nTherefore, $\\textbf{T}_1$ is not a linear transformation.\n\nNow, let's consider $\\mathbf{T}_2$.\n\n- Checking the first condition, we have\n$T_{2}\\begin{bmatrix}kx \\\\ ky\\end{bmatrix}|= \\begin{bmatrix}3kx \\\\ kx + 2ky\\end{bmatrix}; = \\begin{bmatrix}k(3x) \\\\ k(x + 2y)\\end{bmatrix}; = k\\begin{bmatrix}3x \\\\ x + 2y\\end{bmatrix}; = kT_{2}\\begin{bmatrix}x \\\\ y\\end{bmatrix}.✓$\n\n- Checking the second condition, we have\n$T_{2}\\begin{bmatrix}x_{1} + x_{2} \\\\ y_{1} + y_{2}\\end{bmatrix}|= \\begin{bmatrix}3(x_{1} + x_{2}) \\\\ (x_{1} + x_{2}) + 2(y_{1} + y_{2})\\end{bmatrix}; = \\begin{bmatrix}3x_{1} + 3x_{2} \\\\ (x_{1} + 2y_{1}) + (x_{2} + 2y_{2})\\end{bmatrix}; = \\begin{bmatrix}3x_{1} \\\\ x_{1} + 2y_{1}\\end{bmatrix} + \\begin{bmatrix}3x_{2} \\\\ x_{2} + 2y_{2}\\end{bmatrix}; = T_{2}\\begin{bmatrix}x_{1} \\\\ y_{1}\\end{bmatrix} + T_{2}\\begin{bmatrix}x_{2} \\\\ y_{2}\\end{bmatrix}.✓$\n\nTherefore, $\\textbf{T}_2$ is a linear transformation." 13194139533388 17592186045585 false] [17592186087568 1074 "A linear transformation $\\mathbf{T}$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nFirst, let's consider $\\mathbf{T}_1.$ Checking the first condition, we have\n\n$$\n\\begin{aligned}{T}_{1}[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}(kx)^{2} \\\\ (kx)(ky)\\end{aligned}] \\\\  & =[\\begin{aligned}{k}^{2}{x}^{2} \\\\ {k}^{2}xy\\end{aligned}] \\\\  & =k[\\begin{aligned}k{x}^{2} \\\\ kxy\\end{aligned}] \\\\  & \\ne k{T}_{1}[\\begin{aligned}x \\\\ y\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\textbf{T}_1$ is not a linear transformation.\n\nNow, let's consider $\\mathbf{T}_2.$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}{T}_{2}[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}3kx \\\\ kx+2ky\\end{aligned}] \\\\  & =[\\begin{aligned}k(3x) \\\\ k(x+2y)\\end{aligned}] \\\\  & =k[\\begin{aligned}3x \\\\ x+2y\\end{aligned}] \\\\  & =k{T}_{2}[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}{T}_{2}[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}3({x}_{1}+{x}_{2}) \\\\ ({x}_{1}+{x}_{2})+2({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}3{x}_{1}+3{x}_{2} \\\\ ({x}_{1}+2{y}_{1})+({x}_{2}+2{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}3{x}_{1} \\\\ {x}_{1}+2{y}_{1}\\end{aligned}]+[\\begin{aligned}3{x}_{2} \\\\ {x}_{2}+2{y}_{2}\\end{aligned}] \\\\  & ={T}_{2}[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+{T}_{2}[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\te