_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299744 1068 #edb/ref 17592186298804 13194139533412 17592186045585 true] [17592186299744 1069 "q-319254" 13194139533412 17592186045585 true] [17592186299744 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299744 1071 "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" 13194139533412 17592186045585 true] [17592186299744 1072 #uuid "f7e28ce4-d965-5f90-abdd-fd4ebe18371a" 13194139533412 17592186045585 true] [17592186299744 1074 "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299745 1068 #edb/ref 17592186299288 13194139533412 17592186045585 true] [17592186299745 1069 "q-319255" 13194139533412 17592186045585 true] [17592186299745 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299745 1071 "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" 13194139533412 17592186045585 true] [17592186299745 1072 #uuid "c487f5aa-c96a-57d4-aea4-cb293f8d9612" 13194139533412 17592186045585 true] [17592186299745 1074 "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299746 1068 #edb/ref 17592186299473 13194139533412 17592186045585 true] [17592186299746 1069 "q-319256" 13194139533412 17592186045585 true] [17592186299746 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299746 1071 "Let $a=[\\begin{aligned}-2 \\\\ 5 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ x \\\\ -4\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" 13194139533412 17592186045585 true] [17592186299746 1072 #uuid "82fa0dd5-2719-5c00-bc10-1f3440618fed" 13194139533412 17592186045585 true] [17592186299746 1074 "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =(-2)\\cdot 3+5\\cdot x+1\\cdot (-4) \\\\  & =5x-10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}5x-10 & =0 \\\\ 5x & =10 \\\\ x & =2.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299747 1068 #edb/ref 17592186298923 13194139533412 17592186045585 true] [17592186299747 1068 #edb/ref 17592186299364 13194139533412 17592186045585 true] [17592186299747 1069 "q-319310" 13194139533412 17592186045585 true] [17592186299747 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299747 1071 "Let $K=[\\begin{aligned}1 & 0 & -2 & 3 & -1 \\\\ 0 & -1 & 4 & 0 & 2 \\\\ 5 & -3 & 0 & -\\sqrt{3} & 0 \\\\ 0 & 2 & -1 & \\frac{1}{3} & -4 \\\\ -2 & 0 & 0 & 6 & \\sqrt{2}\\end{aligned}].$ \nThe dimensions of the matrix $K$ are{{field-1}}\n$\\times $\n{{field-2}}." 13194139533412 17592186045585 true] [17592186299747 1072 #uuid "e3a38efe-eb84-5e2d-ad2a-4f06e69038f1" 13194139533412 17592186045585 true] [17592186299747 1074 "The matrix $K$ has $5$ rows and $5$ columns. Therefore, its dimensions are $5\\times 5.$" 13194139533412 17592186045585 true] [17592186299748 1068 #edb/ref 17592186298708 13194139533412 17592186045585 true] [17592186299748 1068 #edb/ref 17592186299378 13194139533412 17592186045585 true] [17592186299748 1069 "q-319329" 13194139533412 17592186045585 true] [17592186299748 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299748 1071 "Let $S=[\\begin{aligned}2 \\\\ -\\sqrt{7} \\\\ 0 \\\\ 4\\end{aligned}].$ \nThe dimensions of the matrix $S$ are{{field-1}}\n$\\times $\n{{field-2}}." 13194139533412 17592186045585 true] [17592186299748 1072 #uuid "36b4959b-d3fe-588a-b154-f58e94b04b02" 13194139533412 17592186045585 true] [17592186299748 1074 "The matrix $S$ has $4$ rows and $1$ column. Therefore, its dimensions are $4\\times 1.$" 13194139533412 17592186045585 true] [17592186299749 1068 #edb/ref 17592186299040 13194139533412 17592186045585 true] [17592186299749 1068 #edb/ref 17592186299120 13194139533412 17592186045585 true] [17592186299749 1069 "q-319338" 13194139533412 17592186045585 true] [17592186299749 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299749 1071 "Let $E=[\\begin{aligned}\\frac{2}{3} \\\\ -\\sqrt{3} \\\\ 5 \\\\ 0 \\\\ -4\\end{aligned}].$ \nThe dimensions of the matrix $E$ are{{field-1}}\n$\\times $\n{{field-2}}." 13194139533412 1759218