})}^{′}{log}_{3}⁡(x)+{3}^{x}{({log}_{3}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))({log}_{3}⁡(x))+({3}^{x})(\\frac{1}{x\\operatorname{ln}⁡(3)}) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3){log}_{3}⁡(x)+\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299913 1068 #edb/ref 17592186298675 13194139533412 17592186045585 true] [17592186299913 1069 "q-320815" 13194139533412 17592186045585 true] [17592186299913 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299913 1071 "Given that $f(x)={4}^{x}{log}_{4}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)\\,+$\n{{field-1}}" 13194139533412 17592186045585 true] [17592186299913 1072 #uuid "6161762d-7ca8-5487-95de-c569a1e07882" 13194139533412 17592186045585 true] [17592186299913 1074 "Here, we have the product of the two functions $u(x)={4}^{x}$ and $v(x)={log}_{4}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({4}^{x})}^{′}{log}_{4}⁡(x)+{4}^{x}{({log}_{4}⁡(x))}^{′} \\\\  & =({4}^{x}\\operatorname{ln}⁡(4))({log}_{4}⁡(x))+({4}^{x})(\\frac{1}{x\\operatorname{ln}⁡(4)}) \\\\  & ={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)+\\frac{{4}^{x}}{x\\operatorname{ln}⁡(4)}\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299914 1068 #edb/ref 17592186298844 13194139533412 17592186045585 true] [17592186299914 1069 "q-320816" 13194139533412 17592186045585 true] [17592186299914 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299914 1071 "Given that $f(x)={5}^{-x}{log}_{7}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{5}^{-x}}{xln⁡(7)}$" 13194139533412 17592186045585 true] [17592186299914 1072 #uuid "42b535b3-90b5-5bc5-bbb3-36d4082e369c" 13194139533412 17592186045585 true] [17592186299914 1074 "Here, we have the product of the two functions $u(x)={5}^{-x}$ and $v(x)={log}_{7}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({5}^{-x})}^{′}{log}_{7}⁡(x)+{5}^{-x}{({log}_{7}⁡(x))}^{′} \\\\  & =(-{5}^{-x}ln⁡(5))({log}_{7}⁡(x))+({5}^{-x})(\\frac{1}{xln⁡(7)}) \\\\  & =-{5}^{-x}ln⁡(5){log}_{7}⁡(x)+\\frac{{5}^{-x}}{xln⁡(7)}\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299915 1068 #edb/ref 17592186298830 13194139533412 17592186045585 true] [17592186299915 1068 #edb/ref 17592186298963 13194139533412 17592186045585 true] [17592186299915 1068 #edb/ref 17592186299317 13194139533412 17592186045585 true] [17592186299915 1069 "q-320836" 13194139533412 17592186045585 true] [17592186299915 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299915 1071 "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}4x+8=0 \\\\ x=7+3y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | $-3$ | $0$ |  |\n| --- | --- | --- | --- |\n|  | $-1$ | {{field-2}} |  | |  |  |  | |  | {{field-3}} |  |\n| --- | --- | --- |\n|  | $7$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | $-3$ | $0$ |  |  |  |\n|  | $-1$ | {{field-2}} |  |  |  |\n|  | {{field-3}} |  |  |  |  |\n|  | $7$ |  |  |  |  |" 13194139533412 17592186045585 true] [17592186299915 1072 #uuid "4fd1af2b-5abb-5719-b412-392f65801ff2" 13194139533412 17592186045585 true] [17592186299915 1074 "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}4x+0y=-8 \\\\ x-3y=7.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}4 & 0 \\\\ 1 & -3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-8 \\\\ 7\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}4 & 0 \\\\ 1 & -3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot (-3)-1\\cdot 0}[\\begin{aligned}-3 & 0 \\\\ -1 & 4\\end{aligned}] \\\\  & =-\\frac{1}{12}[\\begin{aligned}-3 & 0 \\\\ -1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{12}[\\begin{aligned}-3 & 0 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}-8 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299916 1068 #edb/ref 17592186298831 13194139533412 17592186045585 true] [17592186299916 1068 #edb/ref 17592186298969 13194139533412 17592186045585 true] [17592186299916 1068 #edb/ref 17592186299260 13194139533412 17592186045585 true] [17592186299916 1069 "q-320842" 13194139533412 17592186045585 true] [17592186299916 1070 #edb/ref 17592186045486 13194139533412 17592186045585 true] [17592186299916 1071 "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}3y-2x=5 \\\\ x=-1-4y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-3$ |  |\n| --- | --- | --- | --- |\n|  | {{field-3}} | $-2$ |  | |  |  |  | |  | $5$ |  |\n| --- | --- | --- |\n|  | $-1$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-3$ |  |  |  |\n|  | {{field-3}} | $-2$ |  |  |  |\n|  | $5$ |  |  |  |  |\n|  | $-1$ |  |  |  |  |" 13194139533412 17592186045585 true] [17592186299916 1072 #uuid "47e2d599-891b-5344-82a3-b9ce814d6215" 13194139533412 17592186045585 true] [17592186299916 1074 "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}-2x+3y=5 \\\\ x+4y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}-2 & 3 \\\\ 1 & 4\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5 \\\\ -1\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & 4\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-2)\\cdot 4-1\\cdot 3}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}] \\\\  & =-\\frac{1}{11}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{11}[\\begin{aligned}4 & -3 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299917 1068 #edb/ref 17592186299007 13194139533412 17592186045585 true] [17592186299917 1068 #edb/ref 17592186299127 13194139533412 17592186045585 true] [17592186299917 1068 #edb/ref 17592186299441 13194139533412 17592186045585 true] [17592186299917 1069 "q-320847" 13194139533412 17592186045585 true] [17592186299917 1070 #edb/ref 17592186045486 13194139533412 17592186045585 true] [17592186299917 1071 "The solution to the system of linear equations\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ 4x=6-y\\end{aligned}\n$$\n\ncan be represented using matrix notation as\n\n| $x=$ {{field-1}} |\n| --- |\n\n| |  | {{field-2}} | $-2$ |  |\n| --- | --- | --- | --- |\n|  | $-4$ | {{field-3}} |  | |  |  |  | |  | $-1$ |  |\n| --- | --- | --- |\n|  | $6$ |  | | . |\n| --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} | $-2$ |  |  |  |\n|  | $-4$ | {{field-3}} |  |  |  |\n|  | $-1$ |  |  |  |  |\n|  | $6$ |  |  |  |  |" 13194139533412 17592186045585 true] [17592186299917 1072 #uuid "9e717507-c51a-5c1c-8601-5f1355a3dc79" 13194139533412 17592186045585 true] [17592186299917 1074 "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ 4x+y=6.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 2 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 6\\end{aligned}]\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & 2 \\\\ 4 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 1-4\\cdot 2}[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}] \\\\  & =-\\frac{1}{7}[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{7}[\\begin{aligned}1 & -2 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 6\\end{aligned}]\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299918 1068 #edb/ref 17592186298934 13194139533412 17592186045585 true] [17592186299918 1068 #edb/ref 17592186299191 13194139533412 17592186045585 true] [17592186299918 1069 "q-320869" 13194139533412 17592186045585 true] [17592186299918 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299918 1071 "Given that $x=3$ and $x=-2$ are solutions to the equation ${x}^{4}-3{x}^{3}+{x}^{2}+7x-30=0,$ find the remaining solutions in the form $a\\pm b\\,\\text{i},$ where $b$ is **non-negative** number.\n\n$x=$\n{{field-1}}\n$\\pm $\n{{field-2}}$\\text{i}$" 13194139533412 17592186045585 true] [17592186299918 1072 #uuid "d08e4df3-3ff4-5343-a353-88cc7cdc23e7" 13194139533412 17592186045585 true] [17592186299918 1074 "Let $f(x)={x}^{4}-3{x}^{3}+{x}^{2}+7x-30.$ Since ${x}_{1}=3$ and ${x}_{2}=-2$ are roots of $f(x),$ then according to the factor theorem, \n\n$$\n(x-3)(x+2)={x}^{2}-x-6\n$$\n\nis a factor of $f(x).$\n\nNext, we find the quotient when $f(x)$ is divided by ${x}^{2}-x-6$ using polynomial division.\n\n$$\n\\begin{aligned} & \\,{x}^{2}-2x+5 \\\\ {x}^{2}-x-6 & \\,\\enclose{longdiv}{\\,\\,{x}^{4}-3{x}^{3}+{x}^{2}+7x-30\\,\\,} \\\\  & \\,{{x}^{4}-{x}^{3}-6{x}^{2}}_{―} \\\\  & \\,-2{x}^{3}+7{x}^{2}+7x-30 \\\\  & \\,{\\,-\\,2{x}^{3}+2{x}^{2}+12x}_{―} \\\\  & \\,5{x}^{2}-5x-30 \\\\  & \\,{5{x}^{2}-5x-30}_{―} \\\\  & \\,0\\end{aligned}\n$$\n\nThus, $f(x)=({x}^{2}-x-6)({x}^{2}-2x+5).$\n\nTo find the remaining two roots, we solve ${x}^{2}-2x+5=0:$\n\n$$\n\\begin{aligned}{x}^{2}-2x+5 & =0 \\\\ ({x}^{2}-2x+1)+5-1 & =0 \\\\ (x-1)^{2}+4 & =0 \\\\ (x-1)^{2} & =-4 \\\\ x-1 & =\\pm 2\\text{i} \\\\ x & =1\\pm 2\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the remaining solutions to our original equation, apart from $x=3$ and $x=-2,$ are $x=1\\pm 2\\,\\text{i}.$" 13194139533412 17592186045585 true] [17592186299919 1068 #edb/ref 17592186298795 13194139533412 17592186045585 true] [17592186299919 1069 "q-320871" 13194139533412 17592186045585 true] [17592186299919 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299919 1071 "Consider the curve defined parametrically as\n\n$$\nx=t-2,\\,\\,\\,y={t}^{2}-4,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}." 13194139533412 17592186045585 true] [17592186299919 1072 #uuid "0c26af88-186d-5e0b-b417-96d3412f3929" 13194139533412 17592186045585 true] [17592186299919 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=t-2\\,⇒\\,t=x+2\\end{aligned}\n$$\n\nNow, substituting $t=x+2$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(x+2)^{2}-4 \\\\ y & ={x}^{2}+4x\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is \n$y={x}^{2}+4x.$" 13194139533412 17592186045585 true] [17592186299920 1068 #edb/ref 17592186299309 13194139533412 17592186045585 true] [17592186299920 1069 "q-320888" 13194139533412 17592186045585 true] [17592186299920 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299920 1071 "Expressed in degrees, $4\\operatorname{arcsin}⁡(-\\frac{\\sqrt{3}}{2})=${{field-1}}${}^{∘}.$" 13194139533412 17592186045585 true] [17592186299920 1072 #uuid "d45e6ce8-b2ee-563e-a4c3-f801246a5e65" 13194139533412 17592186045585 true] [17592186299920 1074 "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](images/ca/ca39c4cde40b99fd40a11746a31398d82814268b2df706e3101ee88648c9e2d4.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}⁡({300}^{∘})=-\\frac{\\sqrt{3}}{2}.\n$$\n\nHowever, ${300}^{∘}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with ${300}^{∘}$ that lies within the range of $\\theta ,$ we subtract ${360}^{∘}.$\n\n$$\n{300}^{∘}-{360}^{∘}=-{60}^{∘}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}⁡(-\\frac{\\sqrt{3}}{2})=-{60}^{∘}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}4\\operatorname{arcsin}⁡(-\\frac{\\sqrt{3}}{2}) & =4\\cdot (-{60}^{∘}) \\\\  & ={-240}^{∘}.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299921 1068 #edb/ref 17592186299414 13194139533412 17592186045585 true] [17592186299921 1069 "q-320891" 13194139533412 17592186045585 true] [17592186299921 1070 #edb/ref 17592186045486 13194139533412 17592186045585 true] [17592186299921 1071 "Write $16{x}^{4}+8{x}^{2}+1$ in factored form as $(a+bi)^{2}(a-bi)^{2}.$ Use $i$ to denote the imaginary unit.\n\n$16{x}^{4}+8{x}^{2}+1=$\n{{field-1}}" 13194139533412 17592186045585 true] [17592186299921 1072 #uuid "6f199e40-eab4-5809-b9ac-8aa8b3508685" 13194139533412 17592186045585 true] [17592186299921 1074 "First, let's factor the expression as a perfect square trinomial in ${b}^{2}.$ We have\n\n$$\n\\begin{aligned}16{x}^{4}+8{x}^{2}+1 & ={(4{x}^{2})}^{2}+2\\cdot (4{x}^{2})\\cdot 1+{1}^{2} \\\\  & ={(4{x}^{2}+1)}^{2}.\\end{aligned}\n$$\n\nNow, we need to factor the sum of squares in the parentheses. To do this, we first write it as a difference. Then, we rewrite the second term using ${i}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}4{x}^{2}+1 & =4{x}^{2}-(-1) \\\\  & =4{x}^{2}-({i}^{2}) \\\\  & ={(2x)}^{2}-{(i)}^{2} \\\\  & =(2x+i)(2x-i)\\end{aligned}\n$$\n\nFinally, substituting this back into our main expression, we get\n\n$$\n\\begin{aligned}16{x}^{4}+8{x}^{2}+1 & ={(4{x}^{2}+1)}^{2} \\\\  & ={((2x+i)(2x-i))}^{2} \\\\  & ={(2x+i)}^{2}{(2x-i)}^{2}.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299922 1068 #edb/ref 17592186298746 13194139533412 17592186045585 true] [17592186299922 1069 "q-320893" 13194139533412 17592186045585 true] [17592186299922 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299922 1071 "Expressed in degrees, $4\\operatorname{arcsin}⁡(-\\frac{\\sqrt{2}}{2})=${{field-1}}${}^{∘}.$" 13194139533412 17592186045585 true] [17592186299922 1072 #uuid "c57ca0c5-d54f-5168-9beb-5c05c79c12db" 13194139533412 17592186045585 true] [17592186299922 1074 "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](images/ca/ca39c4cde40b99fd40a11746a31398d82814268b2df706e3101ee88648c9e2d4.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}⁡({315}^{∘})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nHowever, ${315}^{∘}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with ${315}^{∘}$ that lies within the range of $\\theta ,$ we subtract ${360}^{∘}.$\n\n$$\n{315}^{∘}-{360}^{∘}=-{45}^{∘}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}⁡(-\\frac{\\sqrt{2}}{2})=-{45}^{∘}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}4\\operatorname{arcsin}⁡(-\\frac{\\sqrt{2}}{2}) & =4\\cdot (-{45}^{∘}) \\\\  & ={-180}^{∘}.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299923 1068 #edb/ref 17592186298974 13194139533412 17592186045585 true] [17592186299923 1069 "q-320894" 13194139533412 17592186045585 true] [17592186299923 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299923 1071 "Consider the equation ${x}^{4}-4{x}^{3}+20{x}^{2}-64x+64=0.$ Given that $x=2$ is a solution of multiplicity $2,$ find the remaining solutions in the form $\\pm b\\,\\text{i},$ where $b$ is **non-negative** number.\n\n$x=\\pm $\n{{field-1}}$\\text{i}$" 13194139533412 17592186045585 true] [17592186299923 1072 #uuid "95793dac-ef28-5753-8504-8e1a693dd609" 13194139533412 17592186045585 true] [17592186299923 1074 "Let $f(x)={x}^{4}-4{x}^{3}+20{x}^{2}-64x+64.$ Since ${x}_{1,2}=2$ is a root of multiplicity $2,$ according to the factor theorem, \n\n$$\n(x-2)^{2}={x}^{2}-4x+4\n$$\n\nis a factor of $f(x).$ \n\nNow, we find the quotient when $f(x)$ is divided by ${x}^{2}-4x+4$ using polynomial division.\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{x}^{2}+16 \\\\  & {x}^{2}-4x+4\\,\\enclose{longdiv}{\\,\\,{x}^{4}-4{x}^{3}+20{x}^{2}-64x+64\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{{x}^{4}-4{x}^{3}+4{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,16{x}^{2}-64x+64 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{16{x}^{2}-64x+64}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,0\\end{aligned}\n$$\n\nThus, $f(x)=({x}^{2}-4x+4)({x}^{2}+16).$\n\nTo find the remaining two roots, we solve ${x}^{2}+16=0:$\n\n$$\n\\begin{aligned}{x}^{2}+16 & =0 \\\\ {x}^{2} & =-16 \\\\ x & =\\pm 4\\text{i}\\end{aligned}\n$$\n\nTherefore, the remaining solutions to our original equation, apart from ${x}_{1,2}=2,$ are $x=\\pm 4\\,\\text{i}.$" 13194139533412 17592186045585 true] [17592186299924 1068 #edb/ref 17592186298858 13194139533412 17592186045585 true] [17592186299924 1068 #edb/ref 17592186299272 13194139533412 17592186045585 true] [17592186299924 1068 #edb/ref 17592186299491 13194139533412 17592186045585 true] [17592186299924 1069 "q-320923" 13194139533412 17592186045585 true] [17592186299924 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299924 1071 "Given that $x=3-4\\,\\text{i}$ is a solution to the equation ${x}^{4}-2{x}^{3}+5{x}^{2}+76x+100=0,$ find the remaining solutions.\n\n$x=$\n{{field-1}}\n$+$\n{{field-2}}$\\text{i},$ \n and $\\,x=$\n{{field-3}}" 13194139533412 17592186045585 true] [17592186299924 1072 #uuid "91897446-1754-5080-9957-8518f9958792" 13194139533412 17592186045585 true] [17592186299924 1074 "First, we let $f(x)={x}^{4}-2{x}^{3}+5{x}^{2}+76x+100.$ \n\nSince $f(x)$ has real coefficients and ${x}_{1}=3-4\\,\\text{i}$ is a root of $f(x),$ the complex conjugate \n\n$$\n\\overset{―}{{x}_{1}}=\\overset{―}{3-4\\,\\text{i}}=3+4\\,\\text{i}\n$$\n\nmust also be a root of $f(x).$\n\nNow, according to the factor theorem, $(x-(3-4\\,\\text{i}))(x-(3+4\\,\\text{i}))$\nis a factor of $f(x).$ Expanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-(3-4\\,\\text{i}))(x-(3+4\\,\\text{i})) & ={x}^{2}-(3+4\\,\\text{i})x-(3-4\\,\\text{i})x+(3-4\\,\\text{i})(3+4\\,\\text{i}) \\\\  & ={x}^{2}-6x+({3}^{2}-(4\\text{i})^{2}) \\\\  & ={x}^{2}-6x+25.\\end{aligned}\n$$\n\nNext, we find the quotient when $f(x)$ is divided by ${x}^{2}-6x+25$ using polynomial division.\n\n$$\n\\begin{aligned} & \\,{x}^{2}+4x+4 \\\\ {x}^{2}-6x+25 & \\,\\enclose{longdiv}{\\,\\,{x}^{4}-2{x}^{3}+5{x}^{2}+76x+100\\,\\,} \\\\  & \\,{{x}^{4}-6{x}^{3}+25{x}^{2}}_{―} \\\\  & \\,\\,\\,4{x}^{3}-20{x}^{2}+76x \\\\  & \\,{\\,\\,4{x}^{3}-24{x}^{2}+100x}_{―} \\\\  & \\,\\,\\,4{x}^{2}-24x+100 \\\\  & \\,\\,\\,{4{x}^{2}-24x+100}_{―} \\\\  & \\,\\,\\,0\\end{aligned}\n$$\n\nThus, $f(x)=({x}^{2}-6x+25)({x}^{2}+4x+4).$\n\nTo find the remaining two roots, we solve ${x}^{2}+4x+4=0:$\n\n$$\n\\begin{aligned}{x}^{2}+4x+4 & =0 \\\\ (x+2)(x+2) & =0 \\\\ (x+2)^{2} & =0 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the remaining solutions to our original equation, apart from $x=3-4\\,\\text{i},$ are\n$x=3+4\\,\\text{i}$\nand\n$x=-2.$" 13194139533412 17592186045585 true] [17592186299925 1068 #edb/ref 17592186299351 13194139533412 17592186045585 true] [17592186299925 1068 #edb/ref 17592186299356 13194139533412 17592186045585 true] [17592186299925 1069 "q-320926" 13194139533412 17592186045585 true] [17592186299925 1070 #edb/ref 17592186045486 13194139533412 17592186045585 true] [17592186299925 1071 "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{t+3},\\,\\,\\,y=\\frac{t}{-2t+1},\\,t\\ne -3,\\,\\,\\,t\\ne \\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}$,\\,\\,\\,x\\ne 0.$" 13194139533412 17592186045585 true] [17592186299925 1072 #uuid "80110151-a320-56a4-96e5-9888e94599a9" 13194139533412 17592186045585 true] [17592186299925 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{t+3}\\,⇒\\,t=-3+\\frac{1}{x}\n$$\n\nNow, substituting $t=-3+\\frac{1}{x}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{(-3+\\frac{1}{x})}{(-2\\,(-3+\\frac{1}{x})+1)} \\\\  & =\\frac{(-3+\\frac{1}{x})}{(6-\\frac{2}{x}+1)} \\\\  & =\\frac{(-3+\\frac{1}{x})}{(7-\\frac{2}{x})} \\\\  & =\\frac{-3x+1}{\\cancel{x}}\\cdot \\frac{\\cancel{x}}{7x-2} \\\\  & =\\frac{1-3x}{7x-2}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{1-3x}{7x-2}.$\n\nFinally, since $t\\ne \\frac{1}{2}$ and $x=\\frac{1}{t+3}$ has range $x\\ne 0,$ we must have \n$x\\ne \\frac{2}{7},\\text{ }0.$ \n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{1-3x}{7x-2},\\,x\\ne \\frac{2}{7},\\,\\,\\,x\\ne 0.\n$$" 13194139533412 17592186045585 true] [17592186299926 1068 #edb/ref 17592186299057 13194139533412 17592186045585 true] [17592186299926 1069 "q-320929" 13194139533412 17592186045585 true] [17592186299926 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299926 1071 "Expressed in degrees, $\\operatorname{arcsin}⁡(-1)=${{field-1}}${}^{∘}.$" 13194139533412 17592186045585 true] [17592186299926 1072 #uuid "11cd048e-6154-59df-bb6a-f5ab4796c94a" 13194139533412 17592186045585 true] [17592186299926 1074 "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}⁡({270}^{∘})=-1.\n$$\n\nHowever, ${270}^{∘}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with ${270}^{∘}$ that lies within the range of $\\theta ,$ we subtract ${360}^{∘}.$\n\n$$\n{270}^{∘}-{360}^{∘}=-{90}^{∘}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}⁡(-1)={-90}^{∘}.\n$$" 13194139533412 17592186045585 true] [17592186299927 1068 #edb/ref 17592186298668 13194139533412 17592186045585 true] [17592186299927 1068 #edb/ref 17592186299212 13194139533412 17592186045585 true] [17592186299927 1068 #edb/ref 17592186299345 13194139533412 17592186045585 true] [17592186299927 1069 "q-320934" 13194139533412 17592186045585 true] [17592186299927 1070 #edb/ref 17592186045486 13194139533412 17592186045585 true] [17592186299927 1071 "Given that $x=-2-5\\text{i}$ is a solution to the equation ${x}^{4}-2{x}^{3}+18{x}^{2}-122x+377=0,$ find the remaining solutions in the form $a\\pm b\\,\\text{i},$ where $b$ is **non-negative** number.\n\n$x=-2\\,+$\n{{field-1}}$\\text{i}\\,$ and $\\,x=$\n{{field-2}}\n$\\pm $\n{{field-3}}$\\text{i}$" 13194139533412 17592186045585 true] [17592186299927 1072 #uuid "904cd4ba-c36d-5742-a009-8cc190370e5b" 13194139533412 17592186045585 true] [17592186299927 1074 "First, we let $f(x)={x}^{4}-2{x}^{3}+18{x}^{2}-122x+377.$ \n\nSince $f(x)$ has real coefficients and ${x}_{1}=-2-5\\text{i}$ is a root of $f(x),$ the complex conjugate \n\n$$\n\\overset{―}{{x}_{1}}=\\overset{―}{-2-5\\text{i}}=-2+5\\text{i}\n$$\n\nmust also be a root of $f(x).$\n\nNow, according to the factor theorem, \n$(x-(-2+5\\text{i}))(x-(-2-5\\text{i}))$\nis a factor of $f(x).$ Expanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-(-2+5\\text{i}))(x-(-2-5\\text{i})) & ={x}^{2}-(-2-5\\text{i})x-(-2+5\\text{i})x+(-2-5\\text{i})(-2+5\\text{i}) \\\\  & ={x}^{2}+4x+((-2)^{2}-(5\\text{i})^{2}) \\\\  & ={x}^{2}+4x+29.\\end{aligned}\n$$\n\nNext, we find the quotient when $f(x)$ is divided by ${x}^{2}+4x+29$ using polynomial division.\n\n$$\n\\begin{aligned} & \\,{x}^{2}-6x+13 \\\\ {x}^{2}+4x+29 & \\,\\enclose{longdiv}{\\,\\,{x}^{4}-2{x}^{3}+18{x}^{2}-122x+377\\,\\,} \\\\  & \\,{{x}^{4}+4{x}^{3}+29{x}^{2}}_{―} \\\\  & \\,-6{x}^{3}-11{x}^{2}-122x \\\\  & \\,\\,\\,{-6{x}^{3}-24{x}^{2}-174x}_{―} \\\\  & \\,\\,\\,13{x}^{2}+52x+377 \\\\  & \\,\\,\\,{13{x}^{2}+52x+377}_{―} \\\\  & \\,\\,\\,0\\end{aligned}\n$$\n\nThus, $f(x)=({x}^{2}+4x+29)({x}^{2}-6x+13).$\n\nTo find the other two roots, we solve ${x}^{2}-6x+13=0:$\n\n$$\n\\begin{aligned}{x}^{2}-6x+13 & =0 \\\\ ({x}^{2}-6x+9)+13-9 & =0 \\\\ (x-3)^{2}+4 & =0 \\\\ (x-3)^{2} & =-4 \\\\ x-3 & =\\pm 2\\text{i} \\\\ x & =3\\pm 2\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the remaining solutions to our original equation, apart from $x=-2-5\\text{i},$ are\n$x=-2+5\\,\\text{i}$\nand\n$x=3\\pm 2\\,\\text{i}.$" 13194139533412 17592186045585 true] [17592186299928 1068 #edb/ref 17592186298662 13194139533412 17592186045585 true] [17592186299928 1069 "q-320946" 13194139533412 17592186045585 true] [17592186299928 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299928 1071 "Consider the curve defined parametrically as\n\n$$\nx=3\\operatorname{sin}⁡t,\\,\\,\\,y=\\operatorname{cos}⁡t-2,\\,t\\in [0,2\\pi ).\n$$\n\nThe Cartesian equation of this curve is\n\n{{field-1}}$=1.$" 13194139533412 17592186045585 true] [17592186299928 1072 #uuid "4923000b-5c5c-55b7-9b95-5a7082500328" 13194139533412 17592186045585 true] [17592186299928 1074 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=3\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{3} \\\\ y=\\operatorname{cos}⁡t-2\\, & ⇒\\,\\operatorname{cos}⁡t=y+2\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{(\\frac{x}{3})}^{2}+(y+2)^{2} & =1 \\\\ \\frac{1}{9}{x}^{2}+(y+2)^{2} & =1.\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299929 1068 #edb/ref 17592186299192 13194139533412 17592186045585 true] [17592186299929 1069 "q-321074" 13194139533412 17592186045585 true] [17592186299929 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299929 1071 "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{t+1}{3},\\,\\,\\,y=({t}^{2}-4)(1-t)^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n$y=$\n{{field-1}}." 13194139533412 17592186045585 true] [17592186299929 1072 #uuid "49a7b1ee-edb5-5cfe-b0e7-c77c9612e0b8" 13194139533412 17592186045585 true] [17592186299929 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{t+1}{3}\\,⇒\\,t=3x-1\\end{aligned}\n$$\n\nNow, substituting $t=3x-1$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((3x-1)^{2}-4){(1-(3x-1))}^{2} \\\\  & =(9{x}^{2}-6x+1-4)(2-3x)^{2} \\\\  & =(9{x}^{2}-6x-3)(2-3x)^{2} \\\\  & =3(3{x}^{2}-2x-1)(2-3x)^{2} \\\\  & =3(3x+1)(x-1)(2-3x)^{2}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=3(3x+1)(x-1)(2-3x)^{2}.$" 13194139533412 17592186045585 true] [17592186299930 1068 #edb/ref 17592186299466 13194139533412 17592186045585 true] [17592186299930 1069 "q-321075" 13194139533412 17592186045585 true] [17592186299930 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299930 1071 "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1-t}{4},\\,\\,\\,y=({t}^{2}-1)(1+t)^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n$y=$\n{{field-1}}." 13194139533412 17592186045585 true] [17592186299930 1072 #uuid "4084c354-7618-56fc-b268-f7034497a330" 13194139533412 17592186045585 true] [17592186299930 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{1-t}{4}\\,⇒\\,t=1-4x\\end{aligned}\n$$\n\nNow, substituting $t=1-4x$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((1-4x)^{2}-1)((1+(1-4x))^{2}) \\\\  & =(1-8x+16{x}^{2}-1)((2-4x)^{2}) \\\\  & =(-8x+16{x}^{2})(4)(1-2x)^{2} \\\\  & =8x(2x-1)(2-4x)^{2} \\\\  & =8x(2x-1)\\cdot 4(1-2x)^{2} \\\\  & =32x(2x-1)^{3}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=32x(2x-1)^{3}.$" 13194139533412 17592186045585 true] [17592186299931 1068 #edb/ref 17592186299276 13194139533412 17592186045585 true] [17592186299931 1069 "q-321084" 13194139533412 17592186045585 true] [17592186299931 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299931 1071 "Consider the curve defined parametrically as\n\n$$\nx=\\sqrt{\\,t+1\\,},\\,\\,\\,y=t(4-t),\\,t\\ge 0.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ge 1.$" 13194139533412 17592186045585 true] [17592186299931 1072 #uuid "78ac25c2-7c10-5369-8ba8-e6189caf0a34" 13194139533412 17592186045585 true] [17592186299931 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\sqrt{\\,t+1\\,}\\,⇒\\,t={x}^{2}-1\\end{aligned}\n$$\n\nNow, substituting $t={x}^{2}-1$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =({x}^{2}-1)(4-({x}^{2}-1)) \\\\  & =({x}^{2}-1)(5-{x}^{2})\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=({x}^{2}-1)(5-{x}^{2}).$\n\nFinally, since $t\\ge 0$ and $t={x}^{2}-1,$ we must have ${x}^{2}-1\\ge 0,$ i.e., $x\\ge 1.$\n\nTherefore, the complete Cartesian equation is $y=({x}^{2}-1)(5-{x}^{2}),\\,x\\ge 1.$" 13194139533412 17592186045585 true] [17592186299932 1068 #edb/ref 17592186299087 13194139533412 17592186045585 true] [17592186299932 1069 "q-321090" 13194139533412 17592186045585 true] [17592186299932 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299932 1071 "Consider the curve defined parametrically as\n\n$$\nx=\\sqrt{{t}^{2}-9},\\,\\,\\,y=3{t}^{2},\\,t\\ge 3.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ge 0.$" 13194139533412 17592186045585 true] [17592186299932 1072 #uuid "7fac9ad7-3b23-560c-8033-d32b15e29ec7" 13194139533412 17592186045585 true] [17592186299932 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for ${t}^{2}:$\n\n$$\nx=\\sqrt{{t}^{2}-9}\\,⇒\\,{t}^{2}={x}^{2}+9\n$$\n\nNow, substituting ${t}^{2}={x}^{2}+9$ into our expression for $y,$ we get\n\n$$\ny=3({x}^{2}+9)=3{x}^{2}+27.\n$$\n\nSo, the Cartesian equation of the given curve is $y=3{x}^{2}+27.$\n\nFinally, since $t\\ge 3$ and $x=\\sqrt{{t}^{2}-9},$ we must have $x\\ge 0.$\n\nTherefore, the complete Cartesian equation is $y=3{x}^{2}+27,\\,x\\ge 0.$" 13194139533412 17592186045585 true] [17592186299933 1068 #edb/ref 17592186299469 13194139533412 17592186045585 true] [17592186299933 1069 "q-321100" 13194139533412 17592186045585 true] [17592186299933 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299933 1071 "Expressed in radians, $arcsin\\,(-\\frac{\\sqrt{2}}{2})=${{field-1}}." 13194139533412 17592186045585 true] [17592186299933 1072 #uuid "7e55b33f-c2bb-5990-8ae0-14349507bd3a" 13194139533412 17592186045585 true] [17592186299933 1074 "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](images/a3/a33ea7c6d1aa7cd7e54376aefb2af4347da59a61ecaabdbf4964d41b9661870a.png)\n\nFrom the values in the unit circle, we see that\n\n$$\nsin\\,(\\frac{7\\pi }{4})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nHowever, $\\frac{7\\pi }{4}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with $\\frac{7\\pi }{4}$ that lies within the range of $\\theta ,$ we subtract $2\\pi .$\n\n$$\n\\frac{7\\pi }{4}-2\\pi =-\\frac{\\pi }{4}.\n$$\n\nHence,\n\n$$\narcsin\\,(-\\frac{\\sqrt{2}}{2})=-\\frac{\\pi }{4}.\n$$" 13194139533412 17592186045585 true] [17592186299934 1068 #edb/ref 17592186299146 13194139533412 17592186045585 true] [17592186299934 1069 "q-321120" 13194139533412 17592186045585 true] [17592186299934 1070 #edb/ref 17592186045487 13194139533412 17592186045585 true] [17592186299934 1071 "Expressed in radians, $9\\operatorname{arcsin}⁡(-\\frac{\\sqrt{3}}{2})=${{field-1}}." 13194139533412 17592186045585 true] [17592186299934 1072 #uuid "d69d5404-b3a2-5817-ae30-04fc0f7ba2c2" 13194139533412 17592186045585 true] [17592186299934 1074 "First, note that the range of $\\theta =\\operatorname{arcsin}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](images/a3/a33ea7c6d1aa7cd7e54376aefb2af4347da59a61ecaabdbf4964d41b9661870a.png)\n\nFrom the values in the unit circle, we see that\n\n$$\n\\operatorname{sin}⁡(\\frac{5\\pi }{3})=-\\frac{\\sqrt{3}}{2}.\n$$\n\nHowever, $\\frac{5\\pi }{3}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with $\\frac{5\\pi }{3}$ that lies within the range of $\\theta ,$ we subtract $2\\pi .$\n\n$$\n\\frac{5\\pi }{3}-2\\pi =-\\frac{\\pi }{3}.\n$$\n\nHence,\n\n$$\narcsin\\,(-\\frac{\\sqrt{3}}{2})=-\\frac{\\pi }{3}.\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}9arcsin\\,(-\\frac{\\sqrt{3}}{2}) & =9(-\\frac{\\pi }{3}) \\\\  & =-3\\pi .\\end{aligned}\n$$" 13194139533412 17592186045585 true] [17592186299935 1068 #edb/ref 17592186298741 13194139533412 17592186045585 true] [17592186299935 1068 #edb/ref 17592186299439 13194139533412 17592186045585 true] [17592186299935 1069 "q-321141" 13194139533412 17592186045585 true] [17592186299935 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299935 1071 "Consider the curve defined parametrically as\n\n$$\nx=\\frac{1}{2t+1},\\,\\,\\,y=(t+1)^{2},\\,t\\ne -\\frac{1}{2}.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ne $\n{{field-2}}." 13194139533412 17592186045585 true] [17592186299935 1072 #uuid "ce51648f-7c56-5fd1-a391-8983dd27aa88" 13194139533412 17592186045585 true] [17592186299935 1074 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\nx=\\frac{1}{2t+1}\\,⇒\\,2t+1=\\frac{1}{x}\\,⇒\\,t=\\frac{1}{2x}-\\frac{1}{2}.\n$$\n\nNow, substituting $t=\\frac{1}{2x}-\\frac{1}{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & ={(\\frac{1}{2x}-\\frac{1}{2}+1)}^{2} \\\\  & ={(\\frac{1}{2x}+\\frac{1}{2})}^{2} \\\\  & ={(\\frac{1+x}{2x})}^{2} \\\\  & =\\frac{(1+x)^{2}}{4{x}^{2}}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=\\frac{(1+x)^{2}}{4{x}^{2}}.$\n\nFinally, since $t\\ne -\\frac{1}{2}$ and $x=\\frac{1}{2t+1}$ we must have $x\\ne 0.$\n\nTherefore, the complete Cartesian equation is\n\n$$\ny=\\frac{(1+x)^{2}}{4{x}^{2}},\\,x\\ne 0.\n$$" 13194139533412 17592186045585 true] [17592186299936 1068 #edb/ref 17592186299197 13194139533412 17592186045585 true] [17592186299936 1069 "q-321147" 13194139533412 17592186045585 true] [17592186299936 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299936 1071 "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{3+4y\\,{e}^{xy}}{3y-4x\\,{e}^{xy}},\n$$\n\nwith the initial condition $y(0)=1.$" 13194139533412 17592186045585 true] [17592186299936 1072 #uuid "5fa18d3e-44c1-5bdd-8073-b5de69417d5e" 13194139533412 17592186045585 true] [17592186299936 1074 "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3+4y\\,{e}^{xy}}{3y-4x\\,{e}^{xy}},\\end{aligned}\n$$\n\nwe first multiply through by $(3y-4x\\,{e}^{xy})\\,\\text{d}x$:\n\n$$\n(3y-4x\\,{e}^{xy})\\,\\text{d}y=(3+4y\\,{e}^{xy})\\,\\text{d}x\n$$\n\nThen, we rearrange the terms:\n\n$$\n(3+4y\\,{e}^{xy})\\,\\text{d}x+(4x\\,{e}^{xy}-3y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=3+4y\\,{e}^{xy},\\,Q(x,y)=4x\\,{e}^{xy}-3y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(3+4y\\,{e}^{xy}) \\\\  & =4{e}^{xy}+4xy\\,{e}^{xy}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(4x\\,{e}^{xy}-3y) \\\\  & =4{e}^{xy}+4xy\\,{e}^{xy}\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\n \nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (3+4y\\,{e}^{xy})\\,\\text{d}x+f(y) \\\\  & =3x+4{e}^{xy}+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (4x\\,{e}^{xy}-3y)\\,\\text{d}y+g(x) \\\\  & =4{e}^{xy}-\\frac{3}{2}{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=3x,\\,f(y)=-\\frac{3}{2}{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=1$ when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x & =c \\\\ 4{e}^{0\\cdot 1}-\\frac{3}{2}(1)^{2}+3\\cdot 0 & =c \\\\ c & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x=\\frac{5}{2}.\n$$" 13194139533412 17592186045585 true] [17592186299937 1068 #edb/ref 17592186299103 13194139533412 17592186045585 true] [17592186299937 1069 "q-321203" 13194139533412 17592186045585 true] [17592186299937 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299937 1071 "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{2+{x}^{4}{y}^{5}}{2y-{x}^{5}{y}^{4}}.\n$$" 13194139533412 17592186045585 true] [17592186299937 1072 #uuid "5168ce0a-8a11-5366-8599-b3a807752143" 13194139533412 17592186045585 true] [17592186299937 1074 "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2+{x}^{4}{y}^{5}}{2y-{x}^{5}{y}^{4}},\\end{aligned}\n$$\n\nwe first multiply through by $(2y-{x}^{5}{y}^{4})\\,\\text{d}x$:\n\n$$\n(2y-{x}^{5}{y}^{4})\\,\\text{d}y=(2+{x}^{4}{y}^{5})\\,\\text{d}x\n$$\n\nThen, we  rearrange the terms:\n\n$$\n(2+{x}^{4}{y}^{5})\\,\\text{d}x+({x}^{5}{y}^{4}-2y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=2+{x}^{4}{y}^{5},\\,Q(x,y)={x}^{5}{y}^{4}-2y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(2+{x}^{4}{y}^{5}) \\\\  & =5{x}^{4}{y}^{4}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}({x}^{5}{y}^{4}-2y) \\\\  & =5{x}^{4}{y}^{4}\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (2+{x}^{4}{y}^{5})\\,\\text{d}x+f(y) \\\\  & =2x+\\frac{{x}^{5}{y}^{5}}{5}+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int ({x}^{5}{y}^{4}-2y)\\,\\text{d}y+g(x) \\\\  & =\\frac{{x}^{5}{y}^{5}}{5}-{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=2x,\\,f(y)=-{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\frac{{x}^{5}{y}^{5}}{5}-{y}^{2}+2x=c.\n$$" 13194139533412 17592186045585 true] [17592186299938 1068 #edb/ref 17592186298943 13194139533412 17592186045585 true] [17592186299938 1069 "q-321269" 13194139533412 17592186045585 true] [17592186299938 1070 #edb/ref 17592186045485 13194139533412 17592186045585 true] [17592186299938 1071 "Expressed in degrees, $arccos\\,(\\frac{\\sqrt{2}}{2})=${{field-1}}${}^{∘}.$" 13194139533412 17592186045585 true] [17592186299938 1072 #uuid "2641ea1e-dafb-594a-8a7a-dc35ec436fc1" 13194139533412 17592186045585 true] [17592186299938 1074 "First, note that the range of $\\theta =\\operatorname{arccos}⁡x$ is given by\n\n$$\n{0}^{∘}\\le \\theta \\le {180}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and second quadrants.\n\nSince $\\frac{\\sqrt{2}}{2}$ is positive, our answer is an angle that lies in the first quadrant, where cosine is positive.\n\n![](images/ca/ca39c4cde40b99fd40a11746a31398d82814268b2df706e3101ee88648c9e2d4.png)\n\nFrom the values in the first quadrant, we see that\n\n$$\n\\operatorname{cos}⁡({45}^{∘})=\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore,\n\n$$\narccos\\,(\\frac{\\sqrt{2}}{2})={45}^{∘}.\n$$" 13194139533412 17592186045585 true]] :edb/tempids {"answer-00426a5f-5693-523d-95f8-32b44823a154" 17592186297555 "answer-00578b3d-0fe5-5f60-9bbd-5f64e29784da" 17592186297556 "answer-006c4d37-009e-5065-aa0e-e789bc12caf9" 17592186297557 "answer-00ceebbc-8a68-5fa8-98d9-171cf8eb58b5" 17592186297558 "answer-00f85809-939f-5696-b20f-6a24d1b3a8b7" 17592186297559 "answer-00fcbb30-cca1-53c0-ba0b-03de4416d46d" 17592186297560 "answer-00fe05f8-cdae-51cb-b147-6b8edef0408d" 17592186297561 "answer-01348264-a81e-56c3-895f-616259a8e027" 17592186297562 "answer-0160d63e-87bd-5b5e-b053-0997bcbc468e" 17592186297563 "answer-018204bf-8c90-52f6-b4f7-0aab1473756c" 17592186297564 "answer-018b0772-7906-5ed4-91d5-2693ab4e9442" 17592186297565 "answer-01a0cf46-9fd3-531f-a687-e8d3cdf64026" 17592186297566 "answer-01a620d5-26b0-5a35-aa9a-17d8aef365b2" 17592186297567 "answer-01b4c241-89d7-5723-976f-fb8d0183a465" 17592186297568 "answer-01c8c348-ad59-5343-9782-d47363a1ff45" 17592186297569 "answer-01da6c86-7841-54b6-8286-996845ba4832" 17592186297570 "answer-01e36101-1add-5385-ad32-61448be10dbe" 17592186297571 "answer-01f2322a-148e-5026-8d94-f7a8eba14014" 17592186297572 "answer-0205a153-f729-5484-8f03-54e60c79db41" 17592186297573 "answer-020e0f0d-d42c-5b5c-8257-252945685d7e" 17592186297574 "answer-022e6234-3d4c-5534-b14b-8dd9bdb81787" 17592186297575 "answer-02bab4d3-6b3c-53df-9fc7-544789b896ef" 17592186297576 "answer-02e5a2b3-a867-5397-ab80-253d2fd741fa" 17592186297577 "answer-0394f679-9a1c-5b87-94ed-5055b0ccff99" 17592186297578 "answer-03f937e9-01af-5f0e-a9da-f22975340e6d" 17592186297579 "answer-046b4aa9-f266-5cb3-a468-76fe7b4e0c64" 17592186297580 "answer-047e0e53-2be2-5f84-874f-e465efdea2d7" 17592186297581 "answer-04cca41b-96b6-5473-9aca-86b0db2b84ed" 17592186297582 "answer-050de492-c23d-5e5a-95