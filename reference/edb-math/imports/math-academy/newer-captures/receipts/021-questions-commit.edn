ta \\end{aligned}|,\\,-|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f{f}^{′})^{2}+(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}x \\\\  & ={\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nSince $f(x)=\\frac{x}{x+1},$ we obtain ${f}^{′}(x)=\\frac{1}{(x+1)^{2}}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{0}^{4}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x & =2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+{(\\frac{1}{(x+1)^{2}})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{4}\\frac{x}{x+1}\\sqrt{1+\\frac{1}{(x+1)^{4}}}\\,\\text{d}x.\\end{aligned}\n$$" 13194139533404 17592186045585 true] [17592186278382 1068 #edb/ref 17592186278067 13194139533404 17592186045585 true] [17592186278382 1069 "q-161094" 13194139533404 17592186045585 true] [1759