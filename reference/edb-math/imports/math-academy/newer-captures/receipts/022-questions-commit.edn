n}⁡z)/2}^{\\pi /4}{\\int }_{0}^{2yz}\\operatorname{sin}⁡(\\frac{x}{z})\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡2y}{\\int }_{0}^{2yz}\\operatorname{sin}⁡(\\frac{x}{z})\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡2y}[{\\int }_{0}^{2yz}\\operatorname{sin}⁡(\\frac{x}{z})\\,\\text{d}x]\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡2y}{[-z\\operatorname{cos}⁡(\\frac{x}{z})]}_{x=0}^{x=2yz}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡2y}(-z\\operatorname{cos}⁡2y+z)\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{0}^{\\operatorname{sin}⁡2y}z(1-\\operatorname{cos}⁡2y)\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}[(1-\\operatorname{cos}⁡2y){\\int }_{0}^{\\operatorname{sin}⁡2y}z\\,\\text{d}z]\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}(1-\\operatorname{cos}⁡2y){[\\frac{1}{2}{z}^{2}]}_{0}^{\\operatorname{sin}⁡2y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}\\frac{1}{2}(1-\\operatorname{cos}⁡2y){sin}^{2}⁡2y\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /4}{sin}^{2}⁡2y\\,\\text{d}y-\\frac{1}{2}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2y\\,{sin}^{2}⁡2y\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{\\pi /4}(1-\\operatorname{cos}⁡4y)\\,\\text{d}y-\\frac{1}{2}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2y\\,{sin}^{2}⁡2y\\,\\text{d}y \\\\  & =\\frac{1}{4}{[y-\\frac{1}{4}\\operatorname{sin}⁡4y]}_{0}^{\\pi /4}-\\frac{1}{12}[{sin}^{3}⁡2y]_{0}^{\\pi /4} \\\\  & =\\frac{1}{4}(\\frac{\\pi }{4}-0)-\\frac{1}{12}(1-0) \\\\  & =\\frac{3\\pi -4}{48}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281448 1068 #edb/ref 17592186281033 13194139533405 17592186045585 true] [17592186281448 1069 "q-162333" 13194139533405 17592186045585 true] [17592186281448 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281448 1071 "By changing the order of integration, find the missing limits in the following repeated integral.\n\n$$\n{\\int }_{-2}^{0}{\\int }_{({x}^{2}-4)/2}^{(x+2)^{3}/4}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{p}^{0}{\\int }_{q}^{0}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{2}{\\int }_{r}^{0}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$" 13194139533405 17592186045585 true] [17592186281448 1072 #uuid "73e5572f-235a-5e15-b5b3-79a8db2b1c73" 13194139533405 17592186045585 true] [17592186281448 1074 "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y+{\\int }_{c}^{d}{\\int }_{{v}_{3}(y)}^{{v}_{4}(y)}{\\int }_{{u}_{3}(x,y)}^{{u}_{4}(x,y)}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,-2\\le x\\le 0,\\,\\,\\frac{1}{2}({x}^{2}-4)\\le y\\le \\frac{1}{4}(x+2)^{3},\\,\\,x\\le z\\le {y}^{2}}\n$$\n\nSince all repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{\\int }_{-2}^{0}{\\int }_{({x}^{2}-4)/2}^{(x+2)^{3}/4}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y+{\\int }_{c}^{d}{\\int }_{{v}_{3}(y)}^{{v}_{4}(y)}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/a3/a38afc63496b487803590ccd57e2ab92ad4061524007e8bb4fb6277ff952dde2.png)\n\nThe region $D$ is a type I region in the $xz$-plane:\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 0,\\,\\frac{1}{2}({x}^{2}-4)\\le y\\le \\frac{1}{4}(x+2)^{3}}.\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}z\\,\\text{d}x\\,\\text{d}y,$ we split $D$ into two type II regions.\n\n![](images/9b/9bbaf6d9ce11ecbd988954365e9693f7f3f175c1dd0f944cc85b73773beca047.png)\n\nNotice that the bottom and top boundaries of the lower region, written in the form $x=x(y),$ are\n\n$\\,$ $x=-\\sqrt{2y+4}\\,$ and $\\,x=0.$\n\nAlso, the bottom and top boundaries of the upper region, written in the form $x=x(y),$ are\n\n$\\,$ $x=\\sqrt[3]{4y}-2\\,$ and $\\,x=0.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}={(x,y)\\,:\\,-2\\le y\\le 0,\\,-\\sqrt{2y+4}\\le x\\le 0}\n$$\n\nand\n\n$$\n{D}_{2}={(x,y)\\,:\\,0\\le y\\le 2,\\,\\sqrt[3]{4y}-2\\le x\\le 0}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}{\\int }_{-\\sqrt{2y+4}}^{0}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{2}{\\int }_{\\sqrt[3]{4y}-2}^{0}{\\int }_{x}^{{y}^{2}}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281449 1068 #edb/ref 17592186280846 13194139533405 17592186045585 true] [17592186281449 1069 "q-162334" 13194139533405 17592186045585 true] [17592186281449 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281449 1071 "Evaluate\n${\\int }_{1}^{e}{\\int }_{\\operatorname{ln}⁡z}^{1}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.$\n\n*Hint: First change the order of integration to $\\text{d}x\\,\\text{d}z\\,\\text{d}y.$*" 13194139533405 17592186045585 true] [17592186281449 1072 #uuid "11b88039-dcd3-5fe3-9ad3-e8f58ab164bd" 13194139533405 17592186045585 true] [17592186281449 1074 "We wish to find the limits of integration such that our integral can be expressed as \n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR={(x,y,z)\\,:\\,1\\le z\\le e,\\,\\,\\operatorname{ln}⁡z\\le y\\le 1,\\,\\,0\\le x\\le \\sqrt{3}y}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/14/14c67512e143995cbfcfcf9e80c8d0975bbbc42368c97aa29956bd2d3f3454a8.png)\n\nThe region $D$ is type II region in the $yz$-plane:\n\n$$\nD={(y,z)\\,:\\,1\\le z\\le e,\\,\\operatorname{ln}⁡z\\le y\\le 1}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we write $D$ as a type I region.\n\nNotice that the bottom boundary of the region $D$ is\n\n$$\nz=1\n$$\n\nand the top boundary of the region $D,$ written in the form $z=z(y),$ is\n\n$$\ny=\\operatorname{ln}⁡z\\,⟹\\,z={e}^{y}.\n$$\n\nThen, the type I representation of the region is\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 1,\\,1\\le z\\le {e}^{y}},\n$$\n\nas shown in the diagram below.\n\n![](images/d1/d18470b45d21b4734187c1f639784a4e75924ed212e3fa4c7a214d19eaeb6022.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{\\int }_{\\operatorname{ln}⁡z}^{1}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}[{\\int }_{0}^{\\sqrt{3}y}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}x]\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}{[\\operatorname{arctan}⁡(\\frac{x}{y})]}_{x=0}^{x=\\sqrt{3}y}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}\\operatorname{arctan}⁡\\sqrt{3}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{{e}^{y}}\\frac{\\pi }{3}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[\\frac{\\pi }{3}{\\int }_{1}^{{e}^{y}}\\text{d}z]\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{\\pi }{3}[z]_{1}^{{e}^{y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{\\pi }{3}({e}^{y}-1)\\,\\text{d}y \\\\  & =\\frac{\\pi }{3}[{e}^{y}-y]_{0}^{1} \\\\  & =\\frac{\\pi }{3}(e-1-1+0) \\\\  & =\\frac{\\pi (e-2)}{3}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281450 1068 #edb/ref 17592186280956 13194139533405 17592186045585 true] [17592186281450 1069 "q-162335" 13194139533405 17592186045585 true] [17592186281450 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281450 1071 "By changing the order of integration, find the missing limits in the following repeated integral.\n\n$$\n{\\int }_{-1}^{1}{\\int }_{\\sqrt[3]{y}-2}^{y}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y={\\int }_{-3}^{p}{\\int }_{-1}^{q}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x+{\\int }_{-1}^{1}{\\int }_{r}^{1}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$" 13194139533405 17592186045585 true] [17592186281450 1072 #uuid "43a54158-19f6-5d55-9dc8-679c0f39a2ff" 13194139533405 17592186045585 true] [17592186281450 1074 "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x+{\\int }_{c}^{d}{\\int }_{{v}_{3}(y)}^{{v}_{4}(y)}{\\int }_{{u}_{3}(x,y)}^{{u}_{4}(x,y)}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,-1\\le y\\le 1,\\,\\,\\sqrt[3]{y}-2\\le x\\le y,\\,\\,\\frac{y}{2}\\le z\\le x+4}\n$$\n\nSince all repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{\\int }_{-1}^{1}{\\int }_{\\sqrt[3]{y}-2}^{y}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x+{\\int }_{c}^{d}{\\int }_{{v}_{3}(x)}^{{v}_{4}(x)}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/c9/c92ab09dc71043ac3f5265202f36e38110e5e8db9f2dd115ab006721ed66d4c0.png)\n\nThe region $D$ is a type II region in the $xy$-plane:\n\n$$\nD={(x,y)\\,:\\,-1\\le y\\le 1,\\,\\sqrt[3]{y}-2\\le x\\le y}.\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}x\\,\\text{d}y$ to $\\text{d}z\\,\\text{d}y\\,\\text{d}x,$ we split $D$ into two type I regions.\n\n![](images/8a/8ac0e7631d0baa8ba3b4c37ebe2b2b1d8efa650495d197f425aba093f342a9d3.png)\n\nNotice that the bottom and top boundaries of the left region, written in the form $y=y(x),$ are\n\n$\\,$ $y=-1\\,$ and $\\,y=(x+2)^{3}.$\n\nAlso, the bottom and top boundaries of the right region, written in the form $y=y(x),$ are\n\n$\\,$ $y=x\\,$ and $\\,y=1.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}={(x,y)\\,:\\,-3\\le x\\le -1,\\,-1\\le y\\le (x+2)^{3}}\n$$\n\nand\n\n$$\n{D}_{2}={(x,y)\\,:\\,-1\\le x\\le 1,\\,x\\le y\\le 1}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}{\\int }_{-1}^{(x+2)^{3}}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x+{\\int }_{-1}^{1}{\\int }_{x}^{1}{\\int }_{y/2}^{x+4}\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281451 1068 #edb/ref 17592186281240 13194139533405 17592186045585 true] [17592186281451 1069 "q-162337" 13194139533405 17592186045585 true] [17592186281451 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281451 1071 "The cube root of unity ${e}^{4\\pi \\text{i}/3}$ can be written as \n\n$$\n{e}^{4\\pi \\text{i}/3}={z}^{p},\n$$\n\nwhere $z$ is the principal cube root of unity. What is the value of $p?$" 13194139533405 17592186045585 true] [17592186281451 1072 #uuid "7d9e7b63-cec2-5612-8c0d-cae848ff921e" 13194139533405 17592186045585 true] [17592186281451 1074 "Recall that any cube root of unity can be written in the form\n\n$$\n{e}^{2k\\pi \\text{i}/3}\n$$\n\nwhere $k=0,1,2.$ \n\nWe obtain the *principal* cube root of unity by substituting $k=1:$\n\n$$\nz={e}^{2\\cdot 1\\cdot \\pi \\text{i}/3}={e}^{2\\pi \\text{i}/3}\n$$\n\nWe can write the given root of unity as a power of the principal root as follows:\n\n$$\n\\begin{aligned}{e}^{4\\pi \\text{i}/3} & =({e}^{2\\pi \\text{i}/3})^{2}\\end{aligned}\n$$\n\nTherefore, $p=2.$" 13194139533405 17592186045585 true] [17592186281452 1068 #edb/ref 17592186280880 13194139533405 17592186045585 true] [17592186281452 1069 "q-162343" 13194139533405 17592186045585 true] [17592186281452 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281452 1071 "The $6$th root of unity ${e}^{4\\pi \\text{i}/3}$ can be written as \n\n$$\n{e}^{4\\pi \\text{i}/3}={z}^{p},\n$$\n\nwhere $z$ is the principal $6$th root of unity. What is the value of $p?$" 13194139533405 17592186045585 true] [17592186281452 1072 #uuid "5358c811-fb51-54cc-b39e-4cede46315bc" 13194139533405 17592186045585 true] [17592186281452 1074 "Recall that the $6$th roots of unity can be written in the form\n\n$$\n{e}^{2k\\pi \\text{i}/6}\n$$\n\nwhere $k=0,1,…,5.$ \n\nWe obtain the *principal* $6$th root of unity by substituting $k=1:$\n\n$$\nz={e}^{2\\cdot 1\\cdot \\pi \\text{i}/6}={e}^{\\pi \\text{i}/3}\n$$\n\nWe can write the given root of unity as a power of the principal root as follows:\n\n$$\n\\begin{aligned}{e}^{4\\pi \\text{i}/3} & =({e}^{\\pi \\text{i}/3})^{4}\\end{aligned}\n$$\n\nTherefore, $p=4.$" 13194139533405 17592186045585 true] [17592186281453 1068 #edb/ref 17592186281235 13194139533405 17592186045585 true] [17592186281453 1069 "q-162346" 13194139533405 17592186045585 true] [17592186281453 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281453 1071 "Let $z$ and $w$ be $4$th roots of unity. Which of the following statements are true?\n\n- ${w}^{4}+1=1$\n- ${(\\frac{z}{w})}^{4}=1$\n- $\\frac{z}{w}$ is a $4$th root of unity" 13194139533405 17592186045585 true] [17592186281453 1072 #uuid "46fbce01-7db5-5630-8364-44d4a151bbf9" 13194139533405 17592186045585 true] [17592186281453 1074 "Let's examine our statements in turn.\n\n- Statement I is false. If $z$ and $w$ are $4$th roots of unity, then (by definition) we have that \n\n$$\n{z}^{4}={w}^{4}=1.\n$$\n\nHence\n\n$$\n{w}^{4}+1=1+1=2\\ne 1.\n$$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{(\\frac{z}{w})}^{4} & =\\frac{{z}^{4}}{{w}^{4}} \\\\  & =\\frac{1}{1} \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. From statement II, we have that ${(\\frac{z}{w})}^{4}=1,$ which means that $\\frac{z}{w}$ is a $4$th root of unity. \n\nIn general, the quotient of $n$th roots of unity is an $n$th root of unity.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533405 17592186045585 true] [17592186281454 1068 #edb/ref 17592186281070 13194139533405 17592186045585 true] [17592186281454 1069 "q-162347" 13194139533405 17592186045585 true] [17592186281454 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281454 1071 "Let $z$ be a $6$th root of unity. Which of the following statements are true?\n\n- $({z}^{3})^{2}=-1$\n- ${z}^{3}$ is a $6$th root of unity\n- ${z}^{3}$ is a square root of unity" 13194139533405 17592186045585 true] [17592186281454 1072 #uuid "b77c81df-773f-534f-b1e3-2174eb2531c1" 13194139533405 17592186045585 true] [17592186281454 1074 "Let's examine our statements in turn.\n\n- Statement I is false. We obtain\n\n$$\n\\begin{aligned}({z}^{3})^{2}={z}^{6}=1.\\end{aligned}\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}({z}^{3})^{6} & =({z}^{6})^{3} \\\\  & =(1)^{3} \\\\  & =1.\\end{aligned}\n$$\n\nThis means that (by definition) ${z}^{3}$ is a $6$th root of unity.\n\n- Statement III is true. From statement I, we have that \n\n$$\n({z}^{3})^{2}=1.\n$$\n\nThis means that (by definition) ${z}^{3}$ is a square root of unity.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533405 17592186045585 true] [17592186281455 1068 #edb/ref 17592186280928 13194139533405 17592186045585 true] [17592186281455 1069 "q-162348" 13194139533405 17592186045585 true] [17592186281455 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281455 1071 "Let $z$ and $w$ be $8$th roots of unity. Which of the following statements are true?\n\n- ${z}^{8}=1$\n- $(zw)^{8}=1$\n- $zw$ is an $8$th root of unity" 13194139533405 17592186045585 true] [17592186281455 1072 #uuid "5b299b05-4c26-5412-a581-f913a340d791" 13194139533405 17592186045585 true] [17592186281455 1074 "Let's examine our statements in turn.\n\n- Statement I is true. Indeed, if $z$ and $w$ are $8$th roots of unity, then (by definition) we have that \n\n$$\n{z}^{8}={w}^{8}=1.\n$$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}(zw)^{8} & ={z}^{8}{w}^{8} \\\\  & =1\\cdot 1 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is true. From statement II, we have that $(zw)^{8}=1,$ which means that $zw$ is an $8$th root of unity. \n\nIn general, the product of $n$th roots of unity is an $n$th root of unity.\n\nTherefore, the correct answer is \"I, II, and III.\"" 13194139533405 17592186045585 true] [17592186281456 1068 #edb/ref 17592186281244 13194139533405 17592186045585 true] [17592186281456 1069 "q-162349" 13194139533405 17592186045585 true] [17592186281456 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281456 1071 "Let $z$ be an $8$th root of unity. Which of the following statements are true?\n\n- $({z}^{4})^{2}=-1$\n- ${z}^{4}$ is an $8$th root of unity\n- ${z}^{4}$ is a square root of unity" 13194139533405 17592186045585 true] [17592186281456 1072 #uuid "4a65d62e-3083-571b-b429-c51c7b117795" 13194139533405 17592186045585 true] [17592186281456 1074 "Let's examine our statements in turn.\n\n- Statement I is false. We obtain\n\n$$\n\\begin{aligned}{({z}^{4})}^{2}={z}^{8}=1.\\end{aligned}\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}({z}^{4})^{8} & =({z}^{8})^{4} \\\\  & =(1)^{4} \\\\  & =1.\\end{aligned}\n$$\n\nThis means that (by definition) ${z}^{4}$ is a $8$th root of unity.\n\n- Statement III is true. From statement I, we have that \n\n$$\n({z}^{4})^{2}=1.\n$$\n\nThis means that (by definition) ${z}^{4}$ is a square root of unity.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533405 17592186045585 true] [17592186281457 1068 #edb/ref 17592186281227 13194139533405 17592186045585 true] [17592186281457 1069 "q-162350" 13194139533405 17592186045585 true] [17592186281457 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281457 1071 "Let $z$ and $w$ be $4$th roots of unity. Which of the following statements are true?\n\n- ${z}^{4}=-1$\n- $(zw)^{4}=0$\n- $zw$ is a $4$th root of unity" 13194139533405 17592186045585 true] [17592186281457 1072 #uuid "ec73ee18-5d78-5b94-8905-bcb7e7e3a771" 13194139533405 17592186045585 true] [17592186281457 1074 "Let's examine our statements in turn.\n\n- Statement I is false. If $z$ and $w$ are $4$th roots of unity, then (by definition) we have that \n\n$$\n{z}^{4}={w}^{4}=1.\n$$\n\n- Statement II is false. Indeed, \n\n$$\n\\begin{aligned}(zw)^{4} & ={z}^{4}{w}^{4} \\\\  & =1\\cdot 1 \\\\  & =1 \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is true. Indeed, we have seen above that $(zw)^{4}=1,$ which means that $zw$ is a $4$th root of unity. \n\nIn general, the product of $n$th roots of unity is an $n$th root of unity.\n\nTherefore, the correct answer is \"III only.\"" 13194139533405 17592186045585 true] [17592186281458 1068 #edb/ref 17592186280860 13194139533405 17592186045585 true] [17592186281458 1069 "q-162351" 13194139533405 17592186045585 true] [17592186281458 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281458 1071 "Let $z$ and $w$ be cube roots of unity. Which of the following statements are true?\n\n- ${z}^{3}=1$\n- $(z+z)^{3}=8$\n- $w+w=2w$ is a cube root of unity" 13194139533405 17592186045585 true] [17592186281458 1072 #uuid "6154f21e-3dc4-5e29-9ac5-5bb6e4c1043c" 13194139533405 17592186045585 true] [17592186281458 1074 "Let's examine our statements in turn.\n\n- Statement I is true. If $z$ and $w$ are cube roots of unity, then (by definition) we have that \n\n$$\n{z}^{3}={w}^{3}=1.\n$$\n\n- Statement II is true. We obtain \n\n$$\n\\begin{aligned}(z+z)^{3} & =(2z)^{3} \\\\  & ={2}^{3}\\cdot {z}^{3} \\\\  & =8\\cdot 1 \\\\  & =8.\\end{aligned}\n$$\n\n- Statement III is false. From statement II, we have that $(w+w)^{3}=8\\ne 1,$ which means that $w+w=2w$ is *not* a cube root of unity. \n\nIn general, the sum of $n$th roots of unity is *not* an $n$th root of unity.\n\nTherefore, the correct answer is \"I and II only.\"" 13194139533405 17592186045585 true] [17592186281459 1068 #edb/ref 17592186280843 13194139533405 17592186045585 true] [17592186281459 1069 "q-162361" 13194139533405 17592186045585 true] [17592186281459 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281459 1071 "Let $C$ be the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x-y=1,$ $x=0,$ and $y=0.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨y,\\,-x,\\,1⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" 13194139533405 17592186045585 true] [17592186281459 1072 #uuid "240db9c9-76c2-5c97-8e69-9ca188d1d1d5" 13194139533405 17592186045585 true] [17592186281459 1074 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z=1+{x}^{2}+2{y}^{2}$ and the boundary of our infinite vertical column. One such surface is our paraboloid $S$ with the equation \n\n$$\nz=g(x,y)=1+{x}^{2}+2{y}^{2}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(1+{x}^{2}+2{y}^{2})=2x \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(1+{x}^{2}+2{y}^{2})=4y\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨y,\\,-x,\\,1⟩{|}_{z=1+{x}^{2}+2{y}^{2}} \\\\  & =⟨y,\\,-x,\\,1⟩ \\\\  & =⟨{{y}_{⏟}}_{P},\\,{{-x}_{⏟}}_{Q},\\,{{1}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (2x)-(-x)\\cdot (4y)+1)\\,\\text{d}A \\\\  & ={∬}_{D}(2xy+1)\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/d8/d84b3ecc79c58a128d2f7ea262692d9f66dd9882ff244fb7c3dadd2b2571b550.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(2xy+1)\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{x-1}^{0}\\,2xy+1\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281460 1068 #edb/ref 17592186280921 13194139533405 17592186045585 true] [17592186281460 1069 "q-162366" 13194139533405 17592186045585 true] [17592186281460 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281460 1071 "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨-x{e}^{z},\\,0,\\,{e}^{z}⟩,$ and $C$ is the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ The curve $C$ is oriented counter-clockwise when viewed from above." 13194139533405 17592186045585 true] [17592186281460 1072 #uuid "ae18124e-1564-593a-8b3e-a861867113b8" 13194139533405 17592186045585 true] [17592186281460 1074 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the paraboloid $z={x}^{2}+{y}^{2}$ and the plane $z=4.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=4.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(4)=0 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(4)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨-x{e}^{z},\\,0,\\,{e}^{z}⟩{|}_{z=4} \\\\  & =⟨{{-x{e}^{4}}_{⏟}}_{P},\\,{{0}_{⏟}}_{Q},\\,{{{e}^{4}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-x{e}^{4})-0\\cdot 0+{e}^{4})\\,\\text{d}A \\\\  & ={∬}_{D}{e}^{4}\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=4$ with radius $2$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{4}\\,\\text{d}A & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{e}^{4}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={e}^{4}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\cdot {\\int }_{0}^{2}r\\,\\text{d}r \\\\  & ={e}^{4}[\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{{r}^{2}}{2}]}_{r=0}^{r=2} \\\\  & ={e}^{4}(2\\pi -0)\\cdot (2-0) \\\\  & =4\\pi {e}^{4}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281461 1068 #edb/ref 17592186281228 13194139533405 17592186045585 true] [17592186281461 1069 "q-162368" 13194139533405 17592186045585 true] [17592186281461 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281461 1071 "Let $z$ be a $4$th root of unity. Which of the following statements are true?\n\n- ${z}^{4}=-1$\n- $(z+z)^{4}=16$\n- $z+z=2z$  is not a $4$th root of unity" 13194139533405 17592186045585 true] [17592186281461 1072 #uuid "10662523-d7b1-54f8-907f-f332605eaff8" 13194139533405 17592186045585 true] [17592186281461 1074 "Let's examine our statements in turn.\n\n- Statement I is false. If $z$ is a  $4$th root of unity, then (by definition) we have that\n\n$$\n{z}^{4}=1.\n$$\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{aligned}(z+z)^{4} & =(2z)^{4} \\\\  & ={2}^{4}\\cdot {z}^{4} \\\\  & =16\\cdot 1 \\\\  & =16.\\end{aligned}\n$$\n\n- Statement III is true. From statement II, we have that $(z+z)^{4}\\ne 1,$ which means that $z+z=2z$ is *not* a $4$th root of unity.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533405 17592186045585 true] [17592186281462 1068 #edb/ref 17592186280963 13194139533405 17592186045585 true] [17592186281462 1069 "q-162369" 13194139533405 17592186045585 true] [17592186281462 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281462 1071 "Let $z$ and $w$ be $6$th roots of unity. Which of the following statements are true?\n\n- $z{w}^{6}=w$\n- $(zw)^{6}=1$\n- $zw$ is not a $6$th root of unity" 13194139533405 17592186045585 true] [17592186281462 1072 #uuid "4b7bc6df-b3cb-50da-83fc-955ab52a05f9" 13194139533405 17592186045585 true] [17592186281462 1074 "Let's examine our statements in turn.\n\n- Statement I is false. Indeed,  since $z$ and $w$ are $6$th roots of unity, then (by definition) we have\n\n$$\n{z}^{6}={w}^{6}=1.\n$$\n\nHence\n\n$$\nz{w}^{6}=z\\cdot 1=z\\ne w.\n$$\n\n- Statement II is true. We have \n\n$$\n\\begin{aligned}(zw)^{6} & ={z}^{6}{w}^{6} \\\\  & =1\\cdot 1 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. We have seen above that $(zw)^{6}=1,$ which means that $zw$ is a $6$th root of unity.  \n\nIn general, the product of $n$th roots of unity is an $n$th root of unity.\n\nTherefore, the correct answer is \"II  only.\"" 13194139533405 17592186045585 true] [17592186281463 1068 #edb/ref 17592186281071 13194139533405 17592186045585 true] [17592186281463 1069 "q-162374" 13194139533405 17592186045585 true] [17592186281463 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281463 1071 "Use Stokes' theorem to evaluate \n\n$$\n{∮}_{C}F\\cdot dr,\n$$\n\nwhere $\\text{curl}\\,F=⟨0,\\,z,\\,x⟩,$ and $C$  is the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ The curve $C$ is oriented counter-clockwise when viewed from above." 13194139533405 17592186045585 true] [17592186281463 1072 #uuid "db5de703-3efe-5274-901b-09592c12a8ca" 13194139533405 17592186045585 true] [17592186281463 1074 "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the cylinder ${x}^{2}+{y}^{2}=1$ and the plane $z=x.$ One such surface would be the plane $S$ with the equation \n\n$$\nz=g(x,y)=x.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x)=0\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into the expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨0,\\,z,\\,x⟩{|}_{z=x} \\\\  & =⟨{{0}_{⏟}}_{P},\\,{{x}_{⏟}}_{Q},\\,{{x}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot 1-x\\cdot 0+x))\\,\\text{d}A \\\\  & ={∬}_{D}x\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane.\n\nNotice that the projection of $C$ onto the $xy$-plane is the circle ${x}^{2}+{y}^{2}=1$ with radius $1$ centered at the origin. Therefore, using the change of variables to polar coordinates\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\text{d}A=r\\,\\text{d}r\\text{d}\\theta ,\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}{∬}_{D}x\\,\\text{d}A & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }r\\operatorname{cos}⁡\\theta \\cdot r\\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2\\pi }{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\,\\text{d}r \\\\  & ={\\int }_{0}^{1}{[{r}^{2}\\operatorname{sin}⁡\\theta ]}_{0}^{2\\pi }\\,\\text{d}r \\\\  & =0.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281464 1068 #edb/ref 17592186281269 13194139533405 17592186045585 true] [17592186281464 1069 "q-162379" 13194139533405 17592186045585 true] [17592186281464 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281464 1071 "Let $N$ be the set of all functions $f:R\\to R$ such that $f(0)=0.$ Which of the following statements are true?\n\n- $p(x)\\in N,$ where $p(x)={x}^{3}-1.$\n- For any $f(x),g(x)\\in N$, we have $f(x)+g(x)\\in N.$\n- The set is closed under addition." 13194139533405 17592186045585 true] [17592186281464 1072 #uuid "d62a3796-3a93-54ec-8c55-9e54ca670215" 13194139533405 17592186045585 true] [17592186281464 1074 "Let's verify the statements one by one.\n\n- Statement I is false. We have, $p(x)={x}^{3}-1\\notin N$ because\n\n$$\np(0)=(0)^{3}-1=-1\\ne 0.\n$$\n\n- Statement II is true. Indeed, suppose $f(x),g(x)\\in N,$ where $f(0)=0$ and $g(0)=0.$ Then,\n\n$$\nf(0)+g(0)=0+0=0.\n$$\n\nHence $f(x)+g(x)\\in N.$\n\n- Statement III is true. Since statement II is true, the set is closed under addition.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533405 17592186045585 true] [17592186281465 1068 #edb/ref 17592186281173 13194139533405 17592186045585 true] [17592186281465 1069 "q-162383" 13194139533405 17592186045585 true] [17592186281465 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281465 1071 "![](images/59/5907cf8a9103cc9a639fd8078da3646cc0395d28827f58c0f1beef0a1c06645b.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{y}{\\int }_{0}^{{y}^{2}-{x}^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nRewrite this repeated integral by integrating first with respect to $z,$ then $y,$ and then $x.$" 13194139533405 17592186045585 true] [17592186281465 1072 #uuid "99dda29f-f8a7-5c86-a8ac-12847a6a9f07" 13194139533405 17592186045585 true] [17592186281465 1074 "From the given repeated integral, we see that $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le x\\le y,\\,\\,0\\le z\\le {y}^{2}-{x}^{2}}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nSince both repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{0}^{{y}^{2}-{x}^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/a8/a89646433c8851f66c94092b75fae7b46b01f31c69ca03d338464b87bd7f5df4.png)\n\nThe region $D$ is a type II region in the $xy$-plane:\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,\\,0\\le x\\le y}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}x\\,\\text{d}y$ to $\\text{d}z\\,\\text{d}y\\,\\text{d}x,$ we write $D$ as a type I region.\n\nNotice that the bottom boundary of the region, written in the form $y=y(x),$ is \n\n$$\nx=y\\,⟹\\,y=x\n$$\n\nand the top boundary of the region is\n\n$$\ny=1.\n$$\n\nThen, the type I representation of the region $D$ is\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,\\,x\\le y\\le 1},\n$$\n\nas shown below.\n\n![](images/16/1604e44050208cfb3b4dd81d35bff9769c7498d8304583d5ba92ad4b2f62fd05.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{{y}^{2}-{x}^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$" 13194139533405 17592186045585 true] [17592186281466 1068 #edb/ref 17592186281090 13194139533405 17592186045585 true] [17592186281466 1069 "q-162387" 13194139533405 17592186045585 true] [17592186281466 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281466 1071 "The curvature of the plane curve $r(t)=-t\\,i+({t}^{2}+1)\\,j$ is given by \n\n$$\nκ(t)=\\frac{2}{}.\n$$\n\n \nWhat is the missing part of the expression?" 13194139533405 17592186045585 true] [17592186281466 1072 #uuid "403596be-2359-5c63-ab91-df8ada08654f" 13194139533405 17592186045585 true] [17592186281466 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nAlong our curve, we have\n\n$$\nx(t)=-t,\\,y(t)={t}^{2}+1.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-1,\\, & {y}^{′}(t) & =2t \\\\ {x}^{″}(t) & =0,\\, & {y}^{″}(t) & =2\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|(-1)\\cdot 2-2t\\cdot 0|}{{((-1)^{2}+(2t)^{2})}^{3/2}} \\\\  & =\\frac{|-2|}{{(1+4{t}^{2})}^{3/2}} \\\\  & =\\frac{2}{\\sqrt{{(1+4{t}^{2})}^{3}}}\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281467 1068 #edb/ref 17592186280994 13194139533405 17592186045585 true] [17592186281467 1069 "q-162388" 13194139533405 17592186045585 true] [17592186281467 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281467 1071 "The curvature of the plane curve $r(t)={e}^{t}\\,i+2t\\,j$ is given by \n\n$$\nκ(t)=\\frac{2{e}^{t}}{}.\n$$\n\n \nWhat is the missing part of the expression?" 13194139533405 17592186045585 true] [17592186281467 1072 #uuid "9e34cb96-b8bc-52b1-b1de-e832f51c9600" 13194139533405 17592186045585 true] [17592186281467 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nAlong our curve, we have\n\n$$\nx(t)={e}^{t},\\,y(t)=2t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & ={e}^{t},\\, & {y}^{′}(t) & =2 \\\\ {x}^{″}(t) & ={e}^{t},\\, & {y}^{″}(t) & =0\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|{e}^{t}\\cdot 0-2\\cdot {e}^{t}|}{{(({e}^{t})^{2}+{2}^{2})}^{3/2}} \\\\  & =\\frac{|-2{e}^{t}|}{{({e}^{2t}+4)}^{3/2}} \\\\  & =\\frac{2{e}^{t}}{\\sqrt{({e}^{2t}+4)^{3}}}\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281468 1068 #edb/ref 17592186281265 13194139533405 17592186045585 true] [17592186281468 1069 "q-16239" 13194139533405 17592186045585 true] [17592186281468 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281468 1071 "In degrees, find the general solution to the equation $\\operatorname{tan}⁡x=-\\frac{\\sqrt{3}}{3}.$  Assume that $n$ is an integer." 13194139533405 17592186045585 true] [17592186281468 1072 #uuid "9c430e98-b261-5e82-9f7b-b768850b5575" 13194139533405 17592186045585 true] [17592186281468 1074 "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-{30}^{∘}\n$$\n\nThe tangent function has a period of ${180}^{∘}.$  Hence, the general solution for the given equation is: \n\n$$\nx=-{30}^{∘}+n\\cdot {180}^{∘}.\n$$" 13194139533405 17592186045585 true] [17592186281469 1068 #edb/ref 17592186281260 13194139533405 17592186045585 true] [17592186281469 1069 "q-162391" 13194139533405 17592186045585 true] [17592186281469 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281469 1071 "Let $S$ be the set of all $2\\times 2$ matrices with real entries and determinant different from $0.$ Which of the following statements are true?  \n\n- The  matrix $[\\begin{aligned}2 & 2 \\\\ 1 & 1\\end{aligned}]$ belongs to $S.$\n- For any $A\\in S,$ we can find the corresponding negative matrix $-A\\in S$ such that $A+(-A)=O.$\n- For any $A,B,C\\in S,$ we have $A+(B-C)=(A+B)-C.$" 13194139533405 17592186045585 true] [17592186281469 1072 #uuid "f9060a6c-635e-5bea-91ee-1f014ee29783" 13194139533405 17592186045585 true] [17592186281469 1074 "Let's examine each statement in turn.\n\n- Statement I is false. Indeed, we have\n\n$$\n|\\begin{aligned}2 & 2 \\\\ 1 & 1\\end{aligned}|=2\\cdot 1-2\\cdot 1=0.\n$$\n\n- Statement II is true. Indeed, for any $2\\times 2$ matrix $A$ with real entries,   there is a corresponding negative matrix $-A$ such that\n\n$$\nA+(-A)=A-A=O.\n$$\n\nNotice if $A\\in S$ then \n\n$$\n|-A|=|-1\\cdot A|=(-1)^{2}\\cdot |A|=1\\cdot |A|=|A|\\ne 0,\n$$\n\nhence $-A\\in S.$\n\n- Statement III is true. Indeed, for any matrices $A,B\\in S,$ we obtain that \n\n$$\nA+(B-C)=A+(B+(-C))=(A+B)+(-C)=(A+B)-C\n$$\n\nsince matrix addition is associative.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533405 17592186045585 true] [17592186281470 1068 #edb/ref 17592186281003 13194139533405 17592186045585 true] [17592186281470 1069 "q-162392" 13194139533405 17592186045585 true] [17592186281470 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281470 1071 "Let $U$ be the set of polynomials of the form $a{x}^{3}+b{x}^{2},$ where $a,b\\in R.$ Which of the following statements are true?\n\n- The zero-polynomial belongs to $U.$\n- For any $p(x),q(x)\\in U,$ we have $p(x)-q(x)=q(x)-p(x).$\n- There are polynomials $p(x),q(x),r(x)\\in U$ such that $[p(x)+q(x)]+r(x)\\ne p(x)+[q(x)+r(x)].$" 13194139533405 17592186045585 true] [17592186281470 1072 #uuid "5b2f6345-ac14-55a4-a687-5a14893fcf90" 13194139533405 17592186045585 true] [17592186281470 1074 "Let's examine each statement in turn.\n\n- Statement I is true. Indeed, the zero-polynomial can be represented as \n\n$$\n0=0\\cdot {x}^{3}+0\\cdot {x}^{2}.\n$$\n\n \nHence, $0\\in U.$\n\n- Statement II is false. For example, consider the polynomials $p(x)={x}^{3}\\in U$ and the zero-polynomial $q(x)=0\\in U.$ Then \n\n$$\np(x)-q(x)=p(x)-0={x}^{3}\n$$\n\nwhile \n\n$$\nq(x)-p(x)=0-p(x)=-{x}^{3}\\ne {x}^{3}.\n$$\n\n- Statement III is false. For any polynomials $p(x),q(x)\\in U,$ we have \n\n$$\n[p(x)+q(x)]+r(x)=p(x)+[q(x)+r(x)],\n$$\n\nsince polynomial addition is associative.\n\nTherefore, the correct answer is \"I only.\"" 13194139533405 17592186045585 true] [17592186281471 1068 #edb/ref 17592186281023 13194139533405 17592186045585 true] [17592186281471 1069 "q-162397" 13194139533405 17592186045585 true] [17592186281471 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281471 1071 "Find the radius of the curvature for the curve $r(t)=⟨{t}^{3},\\,1-t⟩$ at $t=1.$" 13194139533405 17592186045585 true] [17592186281471 1072 #uuid "394c8fec-2d21-5f70-acbd-8f636bfaf360" 13194139533405 17592186045585 true] [17592186281471 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)={t}^{3},\\,y(t)=1-t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =3{t}^{2},\\, & {y}^{′}(t) & =-1 \\\\ {x}^{″}(t) & =6t,\\, & {y}^{″}(t) & =0\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|3{t}^{2}\\cdot 0-(-1)\\cdot 6t|}{{((3t)^{2}+(1)^{2})}^{3/2}} \\\\  & =\\frac{6|t|}{{(9{t}^{2}+1)}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=1$ is\n\n$$\n\\begin{aligned}κ(1) & =\\frac{6|1|}{{(9(1)^{2}+1)}^{3/2}} \\\\  & =\\frac{6}{{(10)}^{3/2}} \\\\  & =\\frac{3}{5\\sqrt{10}}\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=1$ is\n\n$$\n\\begin{aligned}R(1) & =\\frac{1}{κ(1)}=\\frac{5\\sqrt{10}}{3}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281472 1068 #edb/ref 17592186281218 13194139533405 17592186045585 true] [17592186281472 1069 "q-162398" 13194139533405 17592186045585 true] [17592186281472 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281472 1071 "![](images/9f/9f4f24dd100758466d8a06eee113bada8b1bede4b48c0a3e694e4c1e3f1c2371.png)\n\nChange the order of integration in the integral\n\n$$\n{\\int }_{0}^{4}{\\int }_{0}^{1-x/4}{\\int }_{0}^{1-x/4-z}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\nso that it is integrated first with respect to $z,$ then over a region $D$ in the $xy$-plane. The integration region $R$ is shown above." 13194139533405 17592186045585 true] [17592186281472 1072 #uuid "983866d1-ed27-5899-96c5-1da8f2e2d802" 13194139533405 17592186045585 true] [17592186281472 1074 "We wish to find the limits of integration ${u}_{1}(y,z)$ and ${u}_{2}(y,z)$ such that\n\n$$\n{\\int }_{0}^{4}{\\int }_{0}^{1-x/4}{\\int }_{0}^{1-x/4-z}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x={∬}_{D}[{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z]\\text{d}A.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type III region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 4,\\,\\,0\\le z\\le 1-\\frac{x}{4},\\,\\,0\\le y\\le 1-\\frac{x}{4}-z}\n$$\n\nTo change the order of integration from $\\text{d}y\\,\\text{d}z\\,\\text{d}x$ to $\\text{d}z\\,\\text{d}A,$ we write $R$ as a type I region. \n\nTo visualize this, imagine firing an arrow through the region parallel to the $z$-axis and in the direction of increasing $z,$ as shown below.\n\n![](images/dc/dc1a9b6371456f635cd4b73fe99301fa349ceeec1341b9bd3b86f6bcd7ad8ba2.png)\n\nThe arrow enters the region through the bottom boundary and leaves through the top boundary:\n\n- The top boundary of the region, written in the form $z=z(x,y),$ is\n\n$$\ny=1-\\frac{x}{4}-z\\,⟹\\,z=1-\\frac{x}{4}-y.\n$$\n\n- The bottom boundary of the region is\n\n$$\nz=0.\n$$\n\nTherefore, the type I representation of $R$ is \n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 1-\\frac{x}{4}-y},\n$$\n\nas shown in the diagram below.\n\n![](images/07/07c4ee04dfba186348b3bd56b182477cec9ca1a581e37bb0eb4ab9a3d64ee515.png)\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $z$ and then over $D,$ we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}{\\int }_{0}^{1-x/4}{\\int }_{0}^{1-x/4-z}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x & ={∬}_{D}[{\\int }_{0}^{1-x/4-y}f(x,y,z)\\,dz]dA.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281473 1068 #edb/ref 17592186281190 13194139533405 17592186045585 true] [17592186281473 1069 "q-162400" 13194139533405 17592186045585 true] [17592186281473 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281473 1071 "![](images/bd/bd69636822b7a3f68805273a4ffd72c7011a4f945a3ebbac8dcd99191e7ea730.png)\n\nChange the order of integration in the integral\n\n$$\n{\\int }_{0}^{3}{\\int }_{0}^{(3-x)/3}{\\int }_{0}^{3-x-3y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nso that it is integrated first with respect to $x,$ then over a region $D$ in the $yz$-plane. The integration region $R$ is shown above." 13194139533405 17592186045585 true] [17592186281473 1072 #uuid "cb6d9a08-be0b-5825-877a-5462026de7df" 13194139533405 17592186045585 true] [17592186281473 1074 "We wish to find the limits of integration ${u}_{1}(y,z)$ and ${u}_{2}(y,z)$ such that\n\n$$\n{\\int }_{0}^{3}{\\int }_{0}^{(3-x)/3}{\\int }_{0}^{3-x-3y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={∬}_{D}[{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x]\\text{d}A.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 3,\\,\\,0\\le y\\le \\frac{3-x}{3},\\,\\,0\\le z\\le 3-x-3y}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}x\\,\\text{d}A,$ we write $R$ as a type II region. \n\nTo visualize this, imagine firing an arrow through the region parallel to the $x$-axis and in the direction of increasing $x,$ as shown below.\n\n![](images/d2/d26a7cc2c643b300226136a223be0fdebed4e17c99c2e562d1cc209caa023ea5.png)\n\nThe arrow enters the region through the back boundary and leaves through the front boundary:\n\n- The front boundary of the region, written in the form $x=x(y,z),$ is\n\n$$\nz=3-x-3y\\,⟹\\,x=3-3y-z.\n$$\n\n- The back boundary of the region is\n\n$$\nx=0.\n$$\n\nTherefore, the type II representation of $R$ is \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 3-3y-z},\n$$\n\nas shown in the diagram below.\n\n![](images/56/5641e6fc83054a355a2010084e1c8be2cd2d8144eae2aad0706704247f03b258.png)\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $x$ and then over $D,$ we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{0}^{(3-x)/3}{\\int }_{0}^{3-x-3y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x & ={∬}_{D}[{\\int }_{0}^{3-3y-z}f(x,y,z)\\,dx]dA.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281474 1068 #edb/ref 17592186280910 13194139533405 17592186045585 true] [17592186281474 1069 "q-162403" 13194139533405 17592186045585 true] [17592186281474 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281474 1071 "Find the radius of the curvature for the curve $r(t)=⟨{e}^{2t},\\,{e}^{-t}⟩$ at $t=0.$" 13194139533405 17592186045585 true] [17592186281474 1072 #uuid "9bbbf354-282e-5ba3-92a4-09b0417fb35b" 13194139533405 17592186045585 true] [17592186281474 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)={e}^{2t},\\,y(t)={e}^{-t}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2{e}^{2t},\\, & {y}^{′}(t) & =-{e}^{-t} \\\\ {x}^{″}(t) & =4{e}^{2t},\\, & {y}^{″}(t) & ={e}^{-t}\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2{e}^{2t}\\cdot {e}^{-t}-(-{e}^{-t})\\cdot 4{e}^{2t}|}{{((2{e}^{2t})^{2}+(-{e}^{-t})^{2})}^{3/2}} \\\\  & =\\frac{6{e}^{t}}{{(4{e}^{4t}+{e}^{-2t})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{6{e}^{(0)}}{{(4{e}^{4(0)}+{e}^{-2(0)})}^{3/2}} \\\\  & =\\frac{6}{{5}^{3/2}} \\\\  & =\\frac{6}{5\\sqrt{5}}\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=\\frac{5\\sqrt{5}}{6}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281475 1068 #edb/ref 17592186281094 13194139533405 17592186045585 true] [17592186281475 1069 "q-162404" 13194139533405 17592186045585 true] [17592186281475 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281475 1071 "Find the radius of curvature for the curve $r(t)=({t}^{2}-1)\\,i+(1-t)\\,j$ at $t=\\frac{1}{2}.$" 13194139533405 17592186045585 true] [17592186281475 1072 #uuid "b29a950e-ff6a-53c6-9c95-7f20926ddb5b" 13194139533405 17592186045585 true] [17592186281475 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)={t}^{2}-1,\\,y(t)=1-t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2t,\\, & {y}^{′}(t) & =-1 \\\\ {x}^{″}(t) & =2,\\, & {y}^{″}(t) & =0\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2t\\cdot 0-(-1)\\cdot 2|}{{((2t)^{2}+(-1)^{2})}^{3/2}} \\\\  & =\\frac{2}{{(4{t}^{2}+1)}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=\\frac{1}{2}$ is\n\n$$\n\\begin{aligned}κ(\\frac{1}{2}) & =\\frac{2}{{(4{(\\frac{1}{2})}^{2}+1)}^{3/2}} \\\\  & =\\frac{2}{{(1+1)}^{3/2}} \\\\  & =\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=\\frac{1}{2}$ is\n\n$$\n\\begin{aligned}R(\\frac{1}{2}) & =\\frac{1}{κ(\\frac{1}{2})}=\\sqrt{2}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281476 1068 #edb/ref 17592186280857 13194139533405 17592186045585 true] [17592186281476 1069 "q-162405" 13194139533405 17592186045585 true] [17592186281476 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281476 1071 "Find the radius of curvature for the curve $r(t)=(1+t)^{2}\\,i+(1-t)^{2}\\,j$ at $t=0.$" 13194139533405 17592186045585 true] [17592186281476 1072 #uuid "50a33905-a851-5486-97da-7aeac90d1eed" 13194139533405 17592186045585 true] [17592186281476 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)=(1+t)^{2},\\,y(t)=(1-t)^{2}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2(1+t),\\, & {y}^{′}(t) & =-2(1-t) \\\\ {x}^{″}(t) & =2,\\, & {y}^{″}(t) & =2\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2(1+t)\\cdot 2-(-2(1-t))\\cdot 2|}{{(\\,(2(1+t))^{2}+(2(1-t))^{2})}^{3/2}} \\\\  & =\\frac{8}{{(8+8{t}^{2})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{8}{{(8+8(0)^{2})}^{3/2}} \\\\  & =\\frac{8}{{(8+0)}^{3/2}} \\\\  & =\\frac{1}{2\\sqrt{2}}.\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=2\\sqrt{2}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281477 1068 #edb/ref 17592186281254 13194139533405 17592186045585 true] [17592186281477 1069 "q-162406" 13194139533405 17592186045585 true] [17592186281477 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281477 1071 "![](images/fc/fcc776a63cd1ac9fc5ec91157652ce9e75c6ee515eca8c6223309521cc300b61.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{1}^{4}{\\int }_{-4/x}^{-1}{\\int }_{0}^{2+xy/2}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nRewrite this repeated integral by integrating first with respect to $z,$ then $x,$ and then $y.$" 13194139533405 17592186045585 true] [17592186281477 1072 #uuid "726ab4df-5736-52e2-9270-ee1e24205504" 13194139533405 17592186045585 true] [17592186281477 1074 "From the given repeated integral, we see that $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,1\\le x\\le 4,\\,\\,-\\frac{4}{x}\\le y\\le -1,\\,\\,0\\le z\\le 2+\\frac{xy}{2}}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nSince both repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{2+xy/2}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/1f/1f30c28c7c048faae864da08a5a6d67d0c6346b27c00a9e7726234531f2f0783.png)\n\nThe region $D$ is a type I region in the $xy$-plane:\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 4,\\,\\,-\\frac{4}{x}\\le y\\le -1}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}z\\,\\text{d}x\\,\\text{d}y,$ we write $D$ as a type II region.\n\nNotice that the right boundary of the region, written in the form $x=x(y),$ is \n\n$$\ny=-\\frac{4}{x}\\,⟹\\,x=-\\frac{4}{y}\n$$\n\nand the left boundary of the region is\n\n$$\nx=1.\n$$\n\nThen, the type II representation of the region $D$ is\n\n$$\nD={(x,y)\\,:\\,-4\\le y\\le -1,\\,\\,1\\le x\\le -\\frac{4}{y}},\n$$\n\nas shown below.\n\n![](images/ac/acc210f36bccb873526172149b85941bd42bc1648a464862562723fedca27bcb.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{-4}^{-1}{\\int }_{1}^{-4/y}{\\int }_{0}^{2+xy/2}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\n$$" 13194139533405 17592186045585 true] [17592186281478 1068 #edb/ref 17592186281055 13194139533405 17592186045585 true] [17592186281478 1069 "q-162420" 13194139533405 17592186045585 true] [17592186281478 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281478 1071 "The signed curvature of the plane curve $r(t)=⟨-\\operatorname{ln}⁡t,\\,t⟩$ is given by\n\n$$\nk(t)=\\frac{}{\\sqrt{(1+{t}^{2})^{3}}},\\,t>0.\n$$\n\nWhat is the missing part of the expression?" 13194139533405 17592186045585 true] [17592186281478 1072 #uuid "6dfb755c-e24f-56dd-8031-41a97c382abf" 13194139533405 17592186045585 true] [17592186281478 1074 "The signed curvature $k(t)$ of a plane curve $r(t)=⟨x(t),y(t)⟩$ is given by\n\n$$\nk(t)=\\frac{{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nAlong our curve, we have\n\n$$\nx(t)=-\\operatorname{ln}⁡t,\\,y(t)=t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-{t}^{-1},\\, & {y}^{′}(t) & =1 \\\\ {x}^{″}(t) & ={t}^{-2},\\, & {y}^{″}(t) & =0\\end{aligned}\n$$\n\nSubstituting these into the formula for the signed curvature, we get:\n\n$$\n\\begin{aligned}k(t) & =\\frac{-{t}^{-1}\\cdot 0-1\\cdot ({t}^{-2})}{{((-{t}^{-1})^{2}+(1)^{2})}^{3/2}} \\\\  & =\\frac{-{t}^{-2}}{{({t}^{-2}+1)}^{3/2}} \\\\  & =\\frac{-{t}^{-2}\\cdot ({t}^{2})^{3/2}}{{(1+{t}^{2})}^{3/2}} \\\\  & =\\frac{-{t}^{-2}\\cdot |t{|}^{3}}{{(1+{t}^{2})}^{3/2}} \\\\  & =\\frac{-{t}^{-2}\\cdot {t}^{3}}{{(1+{t}^{2})}^{3/2}} \\\\  & =\\frac{-t}{\\sqrt{(1+{t}^{2})^{3}}}\\end{aligned}\n$$\n\nNotice that we removed the absolute value because $t>0.$" 13194139533405 17592186045585 true] [17592186281479 1068 #edb/ref 17592186281209 13194139533405 17592186045585 true] [17592186281479 1069 "q-162424" 13194139533405 17592186045585 true] [17592186281479 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281479 1071 "Find the radius of curvature for the curve $r(t)=2{e}^{t}\\,i+{e}^{2t}\\,j$ at $t=0.$" 13194139533405 17592186045585 true] [17592186281479 1072 #uuid "c9434c2d-4cb6-586b-bed8-8562887abbb6" 13194139533405 17592186045585 true] [17592186281479 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)=2{e}^{t},\\,y(t)={e}^{2t}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2{e}^{t},\\, & {y}^{′}(t) & =2{e}^{2t} \\\\ {x}^{″}(t) & =2{e}^{t},\\, & {y}^{″}(t) & =4{e}^{2t}\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2{e}^{t}\\cdot 4{e}^{2t}-2{e}^{2t}\\cdot 2{e}^{t}|}{{((2{e}^{t})^{2}+(2{e}^{2t})^{2})}^{3/2}} \\\\  & =\\frac{4{e}^{3t}}{{(4{e}^{2t}+4{e}^{4t})}^{3/2}} \\\\  & =\\frac{1}{2{(1+{e}^{2t})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{1}{2{(1+{e}^{2(0)})}^{3/2}} \\\\  & =\\frac{1}{2{(1+1)}^{3/2}} \\\\  & =\\frac{1}{4\\sqrt{2}}.\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=4\\sqrt{2}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281480 1068 #edb/ref 17592186281179 13194139533405 17592186045585 true] [17592186281480 1069 "q-162425" 13194139533405 17592186045585 true] [17592186281480 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281480 1071 "Find the radius of the curvature for the curve $r(t)=⟨(1+t)^{2},\\,{t}^{2}⟩$ at $t=0.$" 13194139533405 17592186045585 true] [17592186281480 1072 #uuid "15565b8a-5294-5ab0-b61a-5e955c22994f" 13194139533405 17592186045585 true] [17592186281480 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)=(1+t)^{2},\\,y(t)={t}^{2}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2(1+t),\\, & {y}^{′}(t) & =2t \\\\ {x}^{″}(t) & =2,\\, & {y}^{″}(t) & =2\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2(1+t)\\cdot 2-2t\\cdot 2|}{{(\\,(2(1+t))^{2}+(2t)^{2})}^{3/2}} \\\\  & =\\frac{4}{8{((1+t)^{2}+{t}^{2})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $t=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{1}{2{((1+(0))^{2}+(0)^{2})}^{3/2}} \\\\  & =\\frac{1}{2(1+0)^{3/2}} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=0$ is\n\n$$\n\\begin{aligned}R(0) & =\\frac{1}{κ(0)}=2.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281481 1068 #edb/ref 17592186280879 13194139533405 17592186045585 true] [17592186281481 1069 "q-16245" 13194139533405 17592186045585 true] [17592186281481 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281481 1071 "![](images/35/350458d29c8d214f44b175e28a6f43accd7ce064187cf755324cbe99d53eb7ad.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{tan}⁡x$ and $y=-1.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." 13194139533405 17592186045585 true] [17592186281481 1072 #uuid "62746e40-0193-5ca9-870e-c828dbc32d5d" 13194139533405 17592186045585 true] [17592186281481 1074 "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{tan}⁡x=-1.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(-1)=-\\frac{\\pi }{4}\n$$\n\nThe tangent function has a period of $\\pi .$  Hence, the general solution for the given equation is\n\n$$\nx=-\\frac{\\pi }{4}+n\\pi .\n$$" 13194139533405 17592186045585 true] [17592186281482 1068 #edb/ref 17592186281041 13194139533405 17592186045585 true] [17592186281482 1069 "q-16246" 13194139533405 17592186045585 true] [17592186281482 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281482 1071 "![](images/f6/f6e3ee6eed44a5ecb7e037e9cd8401a95b3e2a4640bd4454f60019f5bd9d1e67.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{sin}⁡x$ and the line $y=\\frac{1}{2}.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." 13194139533405 17592186045585 true] [17592186281482 1072 #uuid "8e7354de-3336-5f3b-9f0e-c5e5d8b1917d" 13194139533405 17592186045585 true] [17592186281482 1074 "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{sin}⁡x=\\frac{1}{2}.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arcsin}⁡(\\frac{1}{2})=\\frac{\\pi }{6}.\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/00/00d540b1f6412e4af2617452fbf0c58750d01e844d89d0d92cfacc0cb3e45e32.png)\n\nSince the second solution ${x}_{2}$  lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nHence, the general solution for the given equation is\n\n$$\nx=\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{5\\pi }{6}+2n\\pi .\n$$" 13194139533405 17592186045585 true] [17592186281483 1068 #edb/ref 17592186280873 13194139533405 17592186045585 true] [17592186281483 1069 "q-162476" 13194139533405 17592186045585 true] [17592186281483 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281483 1071 "Find the radius of the curvature for the curve $r(t)=⟨\\operatorname{sin}⁡(2t),\\,\\operatorname{cos}⁡(2t)⟩$ at $t=\\frac{\\pi }{2}.$" 13194139533405 17592186045585 true] [17592186281483 1072 #uuid "a7c93d46-b6af-5493-bffe-c7cad1a03b63" 13194139533405 17592186045585 true] [17592186281483 1074 "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nThe radius of curvature $R$ is defined as\n$R(t)=\\frac{1}{κ(t)}.$\n\nAlong our curve, we have\n\n$$\nx(t)=\\operatorname{sin}⁡(2t),\\,y(t)=\\operatorname{cos}⁡(2t).\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2\\operatorname{cos}⁡(2t),\\, & {y}^{′}(t) & =-2\\operatorname{sin}⁡(2t) \\\\ {x}^{″}(t) & =-4\\operatorname{sin}⁡(2t),\\, & {y}^{″}(t) & =-4\\operatorname{cos}⁡(2t)\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|2\\operatorname{cos}⁡(2t)\\cdot (-4\\operatorname{cos}⁡(2t))-(-2\\operatorname{sin}⁡(2t))\\cdot (-4\\operatorname{sin}⁡(2t))|}{{((2\\operatorname{cos}⁡(2t))^{2}+(-2\\operatorname{sin}⁡(2t))^{2})}^{3/2}} \\\\  & =\\frac{|-8{cos}^{2}⁡(2t)-8{sin}^{2}⁡(2t)|}{{(4{cos}^{2}⁡(2t)+4{sin}^{2}⁡(2t))}^{3/2}} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the curvature at $t=\\frac{\\pi }{2}$ is \n\n$$\n\\begin{aligned}κ(\\frac{\\pi }{2}) & =1\\end{aligned}\n$$\n\nFinally, the radius of curvature at $t=\\frac{\\pi }{2}$ is\n\n$$\n\\begin{aligned}R(\\frac{\\pi }{2}) & =\\frac{1}{κ(\\frac{\\pi }{2})}=1.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281484 1068 #edb/ref 17592186281029 13194139533405 17592186045585 true] [17592186281484 1069 "q-162481" 13194139533405 17592186045585 true] [17592186281484 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281484 1071 "![](images/d7/d76d928d43054c7d5c026cc25b95fb55855c7a8cbdb5fb35b5ae1f1d39a35c90.png)\n\nChange the order of integration in the integral\n\n$$\n{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{(y-1)^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nso that it is integrated first with respect to $y,$ then over a region $D$ in the $xz$-plane. The integration region $R$ is shown above." 13194139533405 17592186045585 true] [17592186281484 1072 #uuid "1231b246-7edf-5a0e-97f9-c87459102255" 13194139533405 17592186045585 true] [17592186281484 1074 "We wish to find the limits of integration ${u}_{1}(x,z)$ and ${u}_{2}(x,z)$ such that\n\n$$\n{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{(y-1)^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={∬}_{D}[{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y]\\text{d}A.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 1,\\,\\,0\\le z\\le (y-1)^{2}}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}y\\,\\text{d}A,$ we write $R$ as a type III region. \n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/11/116ae6061410bca820b3c89869b23a36b5cef47e4fe483e390ee43d1e52ff726.png)\n\nThe arrow enters the region through the back boundary and leaves through the front boundary:\n\n- The front boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nz=(y-1)^{2}\\,⟹\\,y=1-\\sqrt{z}.\n$$\n\n- The back boundary of the region is\n\n$$\ny=0.\n$$\n\nTherefore, the type III representation of $R$ is \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 1-\\sqrt{z}},\n$$\n\nas shown in the diagram below.\n\n![](images/56/5613cb5b9718914e35f7259e3fe9dfd69ce128a861d19995e2c836c2b76d0f58.png)\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $y$ and then over $D,$ we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{(y-1)^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x & ={∬}_{D}[{\\int }_{0}^{1-\\sqrt{z}}f(x,y,z)\\,dy]dA.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281485 1068 #edb/ref 17592186281247 13194139533405 17592186045585 true] [17592186281485 1069 "q-162482" 13194139533405 17592186045585 true] [17592186281485 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281485 1071 "![](images/19/192cb96645cef0340e99769af3126b9d7e3775ed419e8414e3ad1ed683e919e3.png)\n\nChange the order of integration in the integral\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{2x}{\\int }_{0}^{1-x}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nso that it is integrated first with respect to $x,$ then $z,$ and then $y.$ The integration region $R$ is shown above." 13194139533405 17592186045585 true] [17592186281485 1072 #uuid "4f5b1d02-5004-52a1-b833-f3c606e282e9" 13194139533405 17592186045585 true] [17592186281485 1074 "We wish to find limits of integration ${u}_{1}(y,z),$ ${u}_{2}(y,z),$ ${v}_{1}(y),$ ${v}_{2}(y),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{2x}{\\int }_{0}^{1-x}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le 2x,\\,\\,0\\le z\\le 1-x}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}x\\,\\text{d}z\\,\\text{d}y,$ we write $R$ as a type II region and its projection $D$ onto the $yz$-plane as a type I *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $x$-axis and in the direction of increasing $x,$ as shown below.\n\n![](images/60/60f61df1520d366f6cbcac0b87e7e5eb453e8f011ff046b29a61cdae41624ddf.png)\n\nThe arrow enters the region through the rear boundary and leaves through the front boundary:\n\n- The front boundary of the region, written in the form $x=x(y,z),$ is\n\n$$\nz=1-x\\,⟹\\,x=1-z.\n$$\n\n- The rear boundary of the region is\n\n$$\ny=2x\\,⟹\\,x=\\frac{y}{2}.\n$$\n\nTherefore, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,\\frac{y}{2}\\le x\\le 1-z},\n$$\n\nas shown in the diagram below.\n\n![](images/02/02bbf0de5dad7ff72970ef5a939ac66fd05dfc06c31a23c37b6204042e1859b8.png)\n\nNow, we consider the projection $D$ as a type I plane region in the $yz$-plane with the top curve given by\n\n$$\n{\\begin{aligned}x=1-z \\\\ x=\\frac{y}{2}\\end{aligned}\\,⟹\\,\\frac{y}{2}=1-z\\,⟹\\,z=1-\\frac{y}{2}.\n$$\n\n![](images/2e/2eea77ae3d1ae7a459dba98c98b20fabbec6b1d3a6cacb718b32688bd4ad11d7.png)\n\nHence, we have that\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1-\\frac{y}{2}}.\n$$\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $x,$ then $z,$ and then $y,$ we obtain\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{2x}{\\int }_{0}^{1-x}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{0}^{2}{\\int }_{0}^{1-y/2}{\\int }_{y/2}^{1-z}f(x,y,z)\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y.\n$$" 13194139533405 17592186045585 true] [17592186281486 1068 #edb/ref 17592186281157 13194139533405 17592186045585 true] [17592186281486 1069 "q-162488" 13194139533405 17592186045585 true] [17592186281486 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281486 1071 "![](images/38/380b44a8baf8ed15eb3eb4e66e77b820f5bc51a73be840526db67d96f6d763ed.png)\n\nEvaluate ${\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{y/2}\\frac{1}{(1+{x}^{2})(1-x)}\\,dx\\,dy\\,dz.$ The region of integration is shown above.\n\n*Hint: Change the order of integration to $\\text{d}y\\,\\text{d}x\\,\\text{d}z.$*" 13194139533405 17592186045585 true] [17592186281486 1072 #uuid "1bc956f3-e819-5ca7-bdbc-7e5248ab84f1" 13194139533405 17592186045585 true] [17592186281486 1074 "We cannot integrate the given integral because we cannot find a simple antiderivative of the integrand. So, we change the order of integration.\n\nWe wish to find the limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(z),$ ${v}_{2}(z),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{y/2}\\frac{1}{(1+{x}^{2})(1-x)}\\,dx\\,dy\\,dz={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}\\frac{1}{(1+{x}^{2})(1-x)}\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type II region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,0\\le y\\le 2,\\,\\,0\\le x\\le \\frac{1}{2}y}\n$$\n\nThe region $R$ is shown below.\n\n![](images/18/185f85445f95382afdd9516351f0cce3c4d2b11d99f65da2d5a36db0fc853215.png)\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}y\\,\\text{d}x\\,\\text{d}z,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type II *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/6a/6aeba17b071bd275be7147ffb925b488881a2fb8de5f544dbffe8caab5c036e4.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nx=\\frac{1}{2}y\\,⟹\\,y=2x.\n$$\n\n- The right boundary of the region is\n\n$$\ny=2.\n$$\n\nTherefore, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,2x\\le y\\le 2},\n$$\n\nas shown in the diagram below.\n\n![](images/be/be089ef60080ad9181db8a5dacccf6abe382bef492369342fa15761134b507d2.png)\n\nNow, we consider the projection $D$ as a type II plane region in the $xz$-plane with the right curve given by $x=\\frac{1}{2}(2)=1.$\n\n![](images/88/885b884fee574cae3c2f62ac0092e64b9be1731ae8510f6e910d0a101ffa3f20.png)\n\nHence,\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 1}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{y/2}\\frac{1}{(1+{x}^{2})(1-x)}\\,dx\\,dy\\,dz & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{2x}^{2}\\frac{1}{(1+{x}^{2})(1-x)}\\,dy\\,dx\\,dz \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\frac{1}{(1+{x}^{2})(1-x)}[{\\int }_{2x}^{2}\\text{d}y]\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\frac{1}{(1+{x}^{2})(1-x)}[y]_{2x}^{2}\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\frac{2-2x}{(1+{x}^{2})(1-x)}\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}\\frac{2(1-x)}{(1+{x}^{2})(1-x)}\\,\\text{d}x\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}\\frac{2}{1+{x}^{2}}\\,\\text{d}x]\\text{d}z \\\\  & ={\\int }_{0}^{1}{[2\\operatorname{arctan}⁡x]}_{0}^{1}\\,\\text{d}z \\\\  & ={\\int }_{0}^{1}2\\cdot \\frac{\\pi }{4}\\,\\text{d}z \\\\  & =\\frac{\\pi }{2}[z]_{0}^{1} \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281487 1068 #edb/ref 17592186281096 13194139533405 17592186045585 true] [17592186281487 1069 "q-162500" 13194139533405 17592186045585 true] [17592186281487 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281487 1071 "${\\int }_{0}^{\\pi /2}{\\int }_{0}^{{\\pi }^{2}/4}{\\int }_{\\sqrt{x}}^{\\pi /2}\\frac{z}{y}\\,\\operatorname{cos}⁡(\\frac{x}{y})\\,dy\\,dx\\,dz=$\n\n*Hint: Change the order of integration to $\\text{d}x\\,\\text{d}y\\,\\text{d}z.$*" 13194139533405 17592186045585 true] [17592186281487 1072 #uuid "7f366230-b238-5167-9be4-c77ac1ad35fd" 13194139533405 17592186045585 true] [17592186281487 1074 "We cannot integrate the given integral because we cannot find a simple antiderivative of the integrand. So, we change the order of integration.\n\nWe wish to find the limits of integration ${u}_{1}(y,z),$ ${u}_{2}(y,z),$ ${v}_{1}(z),$ ${v}_{2}(z),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{\\pi /2}{\\int }_{0}^{{\\pi }^{2}/4}{\\int }_{\\sqrt{x}}^{\\pi /2}\\frac{z}{y}\\operatorname{cos}⁡(\\frac{x}{y})\\,dy\\,dx\\,dz={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\frac{z}{y}\\operatorname{cos}⁡(\\frac{x}{y})\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type III region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le z\\le \\frac{\\pi }{2},\\,\\,0\\le x\\le \\frac{{\\pi }^{2}}{4},\\,\\,\\sqrt{x}\\le y\\le \\frac{\\pi }{2}}\n$$\n\nNow, let's sketch the region. Since it is a type III region, we first sketch the projection onto the $xz$-plane, given by\n\n$$\nE={(x,z)\\,:\\,0\\le x\\le \\frac{{\\pi }^{2}}{4},\\,\\,0\\le z\\le \\frac{\\pi }{2}}\n$$\n\nas shown below.\n\n![](images/29/29c722bce3c23c2af628f18dfaf16695f9ec5beac68b0d16ce93d6a993d6fb8c.png)\n\nThen, the region $R$ is shown in the diagram below, where $\\sqrt{x}\\le y\\le \\frac{\\pi }{2}.$\n\n![](images/cd/cdc8fb2c7f6ef9a28b01094ef3bf18089297a6ef9a431c5152311e5e92cd2557.png)\n\nTo change the order of integration from $\\text{d}y\\,\\text{d}x\\,\\text{d}z$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we write $R$ as a type II region and its projection $D$ onto the $yz$-plane as a type II *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $x$-axis and in the direction of increasing $x,$ as shown below.\n\n![](images/d8/d805df26c5a471323d855194b41e052142e711e7f7f9ddf910d792ae74cbc2c6.png)\n\nThe arrow enters the region through the back boundary and leaves through the front boundary:\n\n- The back boundary of the region is\n\n$$\nx=0.\n$$\n\n- The front boundary of the region, written in the form $x=x(y,z),$ is\n\n$$\ny=\\sqrt{x}\\,⟹\\,x={y}^{2}.\n$$\n\nTherefore, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le {y}^{2}},\n$$\n\nas shown in the diagram below.\n\n![](images/4d/4d40e420abeec633cd145dca33071d6459e4b4009e4c6cfc871d6c6150be51e4.png)\n\nNow, we consider the projection $D$ as a type II plane region in the $yz$-plane with the left curve given by $y=\\sqrt{0}=0.$\n\n![](images/81/81782a6c847e5369dfed7524619de354ff7676a856685fb4340d09cf61dca339.png)\n\nHence,\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le \\frac{\\pi }{2},\\,\\,0\\le z\\le \\frac{\\pi }{2}}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{{\\pi }^{2}/4}{\\int }_{\\sqrt{x}}^{\\pi /2}\\frac{z}{y}\\,\\operatorname{cos}⁡(\\frac{x}{y})\\,dy\\,dx\\,dz & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{{y}^{2}}\\frac{z}{y}\\,\\operatorname{cos}⁡(\\frac{x}{y})\\,dx\\,dy\\,dz \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}\\frac{z}{y}[{\\int }_{0}^{{y}^{2}}\\operatorname{cos}⁡(\\frac{x}{y})\\,\\text{d}x]\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}\\frac{z}{y}{[y\\operatorname{sin}⁡(\\frac{x}{y})]}_{x=0}^{x={y}^{2}}\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}\\frac{z}{y}(y\\operatorname{sin}⁡y-0)\\,\\text{d}y\\,\\text{d}z \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}z\\operatorname{sin}⁡y\\,\\text{d}y\\,\\text{d}z \\\\  & =[{\\int }_{0}^{\\pi /2}z\\,\\text{d}z]\\cdot [{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡y\\,\\text{d}y] \\\\  & ={[\\frac{1}{2}{z}^{2}]}_{0}^{\\pi /2}\\cdot [-\\operatorname{cos}⁡y]_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}\\cdot (\\frac{{\\pi }^{2}}{4}-0)\\cdot (-0+1) \\\\  & =\\frac{{\\pi }^{2}}{8}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281488 1068 #edb/ref 17592186280938 13194139533405 17592186045585 true] [17592186281488 1069 "q-162501" 13194139533405 17592186045585 true] [17592186281488 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281488 1071 "![](images/70/7094d1527f7feb9dac54cbd90e595dcbb71c11d5c0a32d1371c3c63c54127899.png)\n\nChange the order of integration in the integral\n\n$$\n{\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{1-y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nso that it is integrated first with respect to $y,$ then $z,$ and then $x.$ The integration region $R$ is shown above." 13194139533405 17592186045585 true] [17592186281488 1072 #uuid "b12fbb51-60f6-5feb-ac33-154862c51309" 13194139533405 17592186045585 true] [17592186281488 1074 "We wish to find limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(x),$ ${v}_{2}(x),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{1-y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,x\\le y\\le 1,\\,\\,0\\le z\\le 1-y}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type I *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/c4/c48de52085373361c4e4de3010ebe36c1da702f0efec45b455dff891869086f2.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nx=y\\,⟹\\,y=x\n$$\n\n- The right boundary of the region is\n\n$$\nz=1-y\\,⟹\\,y=1-z.\n$$\n\nTherefore, the type II representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,x\\le y\\le 1-z},\n$$\n\nas shown in the diagram below.\n\n![](images/fd/fd5d71a6d6509851e5131fe458b9672d59eb7ff6c07499949ae199b45f4ddae0.png)\n\nNow, we consider the projection $D$ as a type I plane region in the $xz$-plane with the top curve given by\n\n$$\n{\\begin{aligned}y=1-z \\\\ y=x\\end{aligned}\\,⟹\\,x=1-z\\,⟹\\,z=1-x.\n$$\n\n![](images/12/12743c492a7f7883a2ecd8d3ca73138a324a53040cb8936f4794f9e8d84c8fd5.png)\n\nHence, we have that\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 1-x}.\n$$\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $y,$ then $z,$ and then $x,$ we obtain\n\n$$\n{\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{1-y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{0}^{1}{\\int }_{0}^{1-x}{\\int }_{x}^{1-z}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$" 13194139533405 17592186045585 true] [17592186281489 1068 #edb/ref 17592186281024 13194139533405 17592186045585 true] [17592186281489 1069 "q-162509" 13194139533405 17592186045585 true] [17592186281489 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281489 1071 "Change the order of integration in the integral\n\n$$\n{\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{\\sqrt{1-{y}^{2}}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nso that it is integrated first with respect to $y,$ then $z,$ and then $x.$" 13194139533405 17592186045585 true] [17592186281489 1072 #uuid "b1bb039b-4cd8-57a5-990b-24a4599182d8" 13194139533405 17592186045585 true] [17592186281489 1074 "We wish to find limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(x),$ ${v}_{2}(x),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{\\sqrt{y}}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,x\\le y\\le 1,\\,\\,0\\le z\\le \\sqrt{1-{y}^{2}}}\n$$\n\nNow, let's sketch the region. Since it is a type I region, we first sketch the projection onto the $xy$-plane, given by\n\n$$\nE={(x,y)\\,:\\,0\\le x\\le 1,\\,\\,x\\le y\\le 1}.\n$$\n\nas shown below.\n\n![](images/87/87b2dd6f4b527f2b709f3e5ede2add7e71d87145c1a15bcc4dbf7066ee41cde1.png)\n\nThen, the region $R$ is shown in the diagram below, where $0\\le z\\le \\sqrt{1-{y}^{2}}.$\n\n![](images/1a/1ad3b88cc426acf67beba4298eb889ce986879b1ae894d5f95ab8d8f3e7b7cf2.png)\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type I *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/b4/b401109bb512f5ad13ccef3346fd3cf2c51eb70eced978aa995f3db597408196.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nx=y\\,⟹\\,y=x.\n$$\n\n- The right boundary of the region is\n\n$$\nz=\\sqrt{1-{y}^{2}}\\,⟹\\,y=\\sqrt{1-{z}^{2}}.\n$$\n\nTherefore, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,x\\le y\\le \\sqrt{1-{z}^{2}}},\n$$\n\nas shown in the diagram below.\n\n![](images/23/2393b79260273fa658f846ed9013156dbc280195b8d7a0e9b0aeca6cd46e545d.png)\n\nNow, we consider the projection $D$ as a type I plane region in the $xz$-plane with the top curve given by\n\n$$\n{\\begin{aligned}y=x \\\\ y=\\sqrt{1-{z}^{2}}\\end{aligned}\\,⟹\\,x=\\sqrt{1-{z}^{2}}\\,⟹\\,z=\\sqrt{1-{x}^{2}}.\n$$\n\n![](images/f1/f14c08f7d809bbb9eb83dc6f34bfd69ed93963c5dab219d7e6fb16720204ae61.png)\n\nHence, we have that\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le \\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $y,$ then $z,$ then $x,$ we obtain\n\n$$\n{\\int }_{0}^{1}{\\int }_{x}^{1}{\\int }_{0}^{\\sqrt{1-{y}^{2}}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{\\int }_{x}^{\\sqrt{1-{z}^{2}}}f(x,y,z)\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$" 13194139533405 17592186045585 true] [17592186281490 1068 #edb/ref 17592186280977 13194139533405 17592186045585 true] [17592186281490 1069 "q-16252" 13194139533405 17592186045585 true] [17592186281490 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281490 1071 "Consider the following trigonometric equation: \n\n$$\n\\operatorname{sin}⁡(3x+{30}^{∘})=-\\frac{\\sqrt{2}}{2}\n$$\n\n  \n\nThe general solution of this equation can be expressed as\n\n$$\nx=-{25}^{∘}+{120}^{∘}n,\\,x=b+{120}^{∘}n,\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $b?$" 13194139533405 17592186045585 true] [17592186281490 1072 #uuid "fd4af320-f0b3-5259-8843-d51dc80e6ed5" 13194139533405 17592186045585 true] [17592186281490 1074 "The general solution to our equation is\n\n$$\n\\begin{aligned}3x+{30}^{∘} & =-{45}^{∘}+{360}^{∘}n, & \\, & \\, & 3x+{30}^{∘} & =-{135}^{∘}+{360}^{∘}n.\\end{aligned}\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\n\\begin{aligned}3x & =-{30}^{∘}-{45}^{∘}+{360}^{∘}n & \\, & \\, & 3x & =-{30}^{∘}-{135}^{∘}+{360}^{∘}n \\\\ 3x & =-{75}^{∘}+{360}^{∘}n & \\, & \\, & 3x & =-{165}^{∘}+{360}^{∘}n \\\\ x & =-{25}^{∘}+{120}^{∘}n & \\, & \\, & x & =-{55}^{∘}+{120}^{∘}n\\end{aligned}\n$$\n\nTherefore, we have that $b=-{55}^{∘}.$" 13194139533405 17592186045585 true] [17592186281491 1068 #edb/ref 17592186281072 13194139533405 17592186045585 true] [17592186281491 1069 "q-162525" 13194139533405 17592186045585 true] [17592186281491 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281491 1071 "Find the curvature of the curve $y={x}^{3}-2{x}^{2}$ at $x=-1.$" 13194139533405 17592186045585 true] [17592186281491 1072 #uuid "5cd5ce7b-a731-529f-9a0d-e737d8086206" 13194139533405 17592186045585 true] [17592186281491 1074 "The curvature $κ(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nκ(x)=\\frac{|{y}^{″}(x)|}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & =3{x}^{2}-4x,\\, & {y}^{″}(x) & =6x-4\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(x) & =\\frac{|6x-4|}{{[1+{(3{x}^{2}-4x)}^{2}]}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=-1$ is\n\n$$\n\\begin{aligned}κ(-1) & =\\frac{|6(-1)-4|}{{(1+{(3(-1)^{2}-4(-1))}^{2})}^{3/2}} \\\\  & =\\frac{|-10|}{{(1+{7}^{2})}^{3/2}} \\\\  & =\\frac{10}{{(50)}^{3/2}} \\\\  & =\\frac{10}{50\\sqrt{50}} \\\\  & =\\frac{\\sqrt{2}}{50}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281492 1068 #edb/ref 17592186281161 13194139533405 17592186045585 true] [17592186281492 1069 "q-162526" 13194139533405 17592186045585 true] [17592186281492 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281492 1071 "Find the curvature of the curve $y=x\\operatorname{sin}⁡x$ at $x=0.$" 13194139533405 17592186045585 true] [17592186281492 1072 #uuid "ef4a3d99-d223-509e-9ad1-4a5b346a7377" 13194139533405 17592186045585 true] [17592186281492 1074 "The curvature $κ(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nκ(x)=\\frac{|{y}^{″}(x)|}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x,\\, & {y}^{″}(x) & =2\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(x) & =\\frac{|2\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x|}{{[1+{(\\operatorname{sin}⁡x+x\\operatorname{cos}⁡x)}^{2}]}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=0$ is\n\n$$\n\\begin{aligned}κ(0) & =\\frac{|2\\operatorname{cos}⁡0-0|}{{(1+0)}^{3/2}} \\\\  & =2.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281493 1068 #edb/ref 17592186281177 13194139533405 17592186045585 true] [17592186281493 1069 "q-162530" 13194139533405 17592186045585 true] [17592186281493 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281493 1071 "The region $R$ is bounded between the cone $x=\\sqrt{{y}^{2}+{z}^{2}}$ and the paraboloid $x=\\sqrt{2y}.$ Given its representation \n\n$$\nR={(x,y,z)\\,:\\,a\\le y\\le b,\\,{g}_{1}(y)\\le z\\le {g}_{2}(y),\\,{f}_{1}(y,z)\\le x\\le {f}_{2}(y,z)}\n$$\n\n \nas a type II region in three-dimensional space, which of the following statements are true?\n\n- ${f}_{1}(y,z)=\\sqrt{2y}$ and ${f}_{2}(y,z)=\\sqrt{{y}^{2}+{z}^{2}}$\n- ${g}_{1}(y)=-\\sqrt{1-(y-1)^{2}}$ and ${g}_{2}(y)=\\sqrt{1-(y-1)^{2}}$\n- $a=-1$ and $b=1$" 13194139533405 17592186045585 true] [17592186281493 1072 #uuid "4b6ba3e9-8414-5dea-8a72-007f56c21b5a" 13194139533405 17592186045585 true] [17592186281493 1074 "A typical three-dimensional region of type II can be visualized schematically, as shown below.\n\n![](images/e4/e4c9cbbad2f13e9cc125ddbb89125ed2d734eee3f80737125961f4af1846a972.png)\n\n \n\nLet's find a type II representation of our region.\n\n**Step 1.** We start by finding the surfaces ${f}_{1}(y,z)$ and ${f}_{2}(y,z).$ Since all $x$ in the region are bounded *below* by $x=\\sqrt{{y}^{2}+{z}^{2}}$ and *above* by $x=\\sqrt{2y},$ we have\n\n$$\n{{\\sqrt{{y}^{2}+{z}^{2}}}_{⏟}}_{{f}_{1}(y,z)}\\le x\\le {{\\sqrt{2y}}_{⏟}}_{{f}_{2}(y,z)}.\n$$\n\nSo, statement I is false.\n\n**Step 2.** We find the projection of the intersection between the cone $x=\\sqrt{{y}^{2}+{z}^{2}}$ and the paraboloid $x=\\sqrt{2y}$ onto the $yz$-plane.\n\nNotice that the equation of the cone is already solved for $x.$ Substituting this expression for $x$ into the equation of the paraboloid, we obtain: \n\n$$\n\\begin{aligned}\\sqrt{{y}^{2}+{z}^{2}} & =\\sqrt{2y} \\\\ {y}^{2}+{z}^{2} & =2y \\\\ {y}^{2}-2y+{z}^{2} & =0 \\\\ {y}^{2}-2y+1+{z}^{2} & =1 \\\\ (y-1)^{2}+{z}^{2} & =1\\end{aligned}\n$$\n\n \n\nSo, the projection of the intersection is the circle $(y-1)^{2}+{z}^{2}=1$ centered at $(1,0)$ in the $yz$-plane. \n\n![](images/d6/d6db5f2d27787c5414f92c2525398b3810d0b0d192ea6837f7cdf483531f48e9.png)\n\nThe region is bounded *below* by $z=-\\sqrt{1-(y-1)^{2}}$ and bounded *above* by $z=\\sqrt{1-(y-1)^{2}}.$ Therefore,\n\n$$\n{{-\\sqrt{1-(y-1)^{2}}}_{⏟}}_{{g}_{1}(y)}\\le z\\le {{\\sqrt{1-(y-1)^{2}}}_{⏟}}_{{g}_{2}(y)}.\n$$\n\nSo, statement II is true.\n\n**Step 3.** We find the bounds for $y.$ From the diagram, $y$ is bounded *below* by $y=0$ and bounded *above* by $y=2.$ Therefore,\n\n$$\n{{0}_{⏟}}_{a}\\le y\\le {{2}_{⏟}}_{b}.\n$$\n\nSo, statement III is false.\n\nFinally, the correct answer is \"II only.\"" 13194139533405 17592186045585 true] [17592186281494 1068 #edb/ref 17592186281047 13194139533405 17592186045585 true] [17592186281494 1069 "q-162532" 13194139533405 17592186045585 true] [17592186281494 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281494 1071 "Find the signed curvature of the curve $y=x-\\operatorname{cos}⁡x$ at $x=\\pi .$" 13194139533405 17592186045585 true] [17592186281494 1072 #uuid "679cf01a-6df5-52ff-aad5-1d8bd0b5acca" 13194139533405 17592186045585 true] [17592186281494 1074 "The signed curvature $k(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nk(x)=\\frac{{y}^{″}(x)}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n{y}^{′}(x)=1+\\operatorname{sin}⁡x,\\,{y}^{″}(x)=\\operatorname{cos}⁡x\n$$\n\nSubstituting these into the formula for the signed curvature, we get the following:\n\n$$\n\\begin{aligned}k(x) & =\\frac{\\operatorname{cos}⁡x}{{[1+{(1+\\operatorname{sin}⁡x)}^{2}]}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=\\pi $ is\n\n$$\n\\begin{aligned}k(0) & =\\frac{\\operatorname{cos}⁡(\\pi )}{{[1+{(1+\\operatorname{sin}⁡(\\pi ))}^{2}]}^{3/2}} \\\\  & =\\frac{-1}{{2}^{3/2}} \\\\  & =-\\frac{\\sqrt{2}}{4}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281495 1068 #edb/ref 17592186281159 13194139533405 17592186045585 true] [17592186281495 1069 "q-162534" 13194139533405 17592186045585 true] [17592186281495 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281495 1071 "Find the signed curvature of the curve $y={2}^{x}$ at $x=-1.$" 13194139533405 17592186045585 true] [17592186281495 1072 #uuid "d2059e5f-93a8-5b5f-ab4e-bc10c8876989" 13194139533405 17592186045585 true] [17592186281495 1074 "The signed curvature $k(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nk(x)=\\frac{{y}^{″}(x)}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n{y}^{′}(x)={2}^{x}\\operatorname{ln}⁡2,\\,{y}^{″}(x)={2}^{x}{ln}^{2}⁡2\n$$\n\nSubstituting these into the formula for the signed curvature, we get the following:\n\n$$\n\\begin{aligned}k(x) & =\\frac{{2}^{x}{ln}^{2}⁡2}{{[1+{({2}^{x}\\operatorname{ln}⁡2)}^{2}]}^{3/2}} \\\\  & =\\frac{{2}^{x}{ln}^{2}⁡2}{{(1+{2}^{2x}{ln}^{2}⁡2)}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=-1$ is\n\n$$\n\\begin{aligned}k(-1) & =\\frac{{2}^{-1}{ln}^{2}⁡2}{{(1+{2}^{2(-1)}{ln}^{2}⁡2)}^{3/2}} \\\\  & =\\frac{(\\frac{{ln}^{2}⁡2}{2})}{{(\\frac{4+{ln}^{2}⁡2}{4})}^{3/2}} \\\\  & =\\frac{4{ln}^{2}⁡2}{(4+{ln}^{2}⁡2)^{3/2}}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281496 1068 #edb/ref 17592186281149 13194139533405 17592186045585 true] [17592186281496 1069 "q-162535" 13194139533405 17592186045585 true] [17592186281496 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281496 1071 "Find the signed curvature of the curve $y=x-{e}^{x}$ at $x=1.$" 13194139533405 17592186045585 true] [17592186281496 1072 #uuid "7fbc67aa-6887-5c1b-ba6e-44712c2e9cc1" 13194139533405 17592186045585 true] [17592186281496 1074 "The signed curvature $k(x)$ of a plane curve $y=y(x)$ is given by\n\n$$\nk(x)=\\frac{{y}^{″}(x)}{(1+[{y}^{′}(x)]^{2})^{3/2}}.\n$$\n\nFirst, we calculate ${y}^{′}(x)$ and ${y}^{″}(x):$\n\n$$\n{y}^{′}(x)=1-{e}^{x},\\,{y}^{″}(x)=-{e}^{x}\n$$\n\nSubstituting these into the formula for the signed curvature, we get the following:\n\n$$\n\\begin{aligned}k(x) & =\\frac{-{e}^{x}}{{[1+{(1-{e}^{x})}^{2}]}^{3/2}} \\\\  & =-\\frac{{e}^{x}}{{(1+1+{e}^{2x}-2{e}^{x})}^{3/2}} \\\\  & =-\\frac{{e}^{x}}{{(2+{e}^{2x}-2{e}^{x})}^{3/2}}\\end{aligned}\n$$\n\nTherefore, the curvature at $x=1$ is\n\n$$\n\\begin{aligned}k(1) & =-\\frac{{e}^{(1)}}{{(2+{e}^{2(1)}-2{e}^{(1)})}^{3/2}} \\\\  & =-\\frac{e}{({e}^{2}-2e+2)^{3/2}}.\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281497 1068 #edb/ref 17592186281085 13194139533405 17592186045585 true] [17592186281497 1069 "q-162536" 13194139533405 17592186045585 true] [17592186281497 1070 #edb/ref 17592186045485 13194139533405 17592186045585 true] [17592186281497 1071 "${\\int }_{0}^{2}{\\int }_{0}^{x}{\\int }_{0}^{y}xyz\\,dz\\,dy\\,dx=$" 13194139533405 17592186045585 true] [17592186281497 1072 #uuid "60d0f515-ef2a-55b6-9d6c-4873b2c1adce" 13194139533405 17592186045585 true] [17592186281497 1074 "First, we evaluate the inner integral by integrating with respect to $z,$ treating $x$ and $y$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{x}{\\int }_{0}^{y}xyz\\,dz\\,dy\\,dx & ={\\int }_{0}^{2}{\\int }_{0}^{x}[{\\int }_{0}^{y}xyz\\,dz]dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{x}{[\\frac{1}{2}xy{z}^{2}]}_{z=0}^{z=y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{x}\\frac{1}{2}xy({y}^{2}-0)\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{x}\\frac{1}{2}x{y}^{3}\\,dy\\,dx\\end{aligned}\n$$\n\nNext, we evaluate the inner integral by integrating with respect to $y,$ treating $x$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{x}\\frac{1}{2}x{y}^{3}\\,dy\\,dx & ={\\int }_{0}^{2}[{\\int }_{0}^{x}\\frac{1}{2}x{y}^{3}\\,dy]dx \\\\  & ={\\int }_{0}^{2}{[\\frac{1}{8}x{y}^{4}]}_{y=0}^{y=x}\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{1}{8}x({x}^{4}-0)\\,dx \\\\  & =\\frac{1}{8}{\\int }_{0}^{2}{x}^{5}\\,dx\\end{aligned}\n$$\n\nFinally, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{8}{\\int }_{0}^{2}{x}^{5}\\,dx & =\\frac{1}{8}{[\\frac{1}{6}{x}^{6}]}_{x=0}^{x=2} \\\\  & =\\frac{1}{48}(64-0) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281498 1068 #edb/ref 17592186280914 13194139533405 17592186045585 true] [17592186281498 1069 "q-162540" 13194139533405 17592186045585 true] [17592186281498 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281498 1071 "Consider the vector field $F(x,y,z)=⟨z,\\,-y,\\,4x+3⟩$ and the surface $S$ defined in Cartesian coordinates as $z=x+2y+1$ for $0\\le x\\le 2$ and $0\\le y\\le 1.$ Calculate the flux of $F$ through $S$ with respect to the upward-pointing unit normal vector $n.$\n\n*Hint: You're given that the fundamental vector product of $S$ with respect to its canonical parametrization is $||{r}_{x}\\times {r}_{y}||=\\sqrt{6}.$*" 13194139533405 17592186045585 true] [17592186281498 1072 #uuid "4adb65fe-96f0-5d44-a083-7671cd65bedb" 13194139533405 17592186045585 true] [17592186281498 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=x+2y+1$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-1,\\,-2,\\,1⟩}_{⏟}}_{\\overset{~}{n}}=1,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨1,\\,2,\\,-1⟩}_{⏟}}_{-\\overset{~}{n}}=-1.\n$$\n\nSince we require an upward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is positive. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨-1,\\,-2,\\,1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨-1,\\,-2,\\,1⟩}{\\sqrt{(-1)^{2}+(-2)^{2}+{1}^{2}}} \\\\  & =\\frac{1}{\\sqrt{6}}⟨-1,\\,-2,\\,1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=x+2y+1$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,-y,\\,4x+3⟩\\cdot \\frac{1}{\\sqrt{6}}⟨-1,\\,-2,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨x+2y+1,\\,-y,\\,4x+3⟩\\cdot ⟨-1,\\,-2,\\,1⟩ \\\\  & =\\frac{1}{\\sqrt{6}}(-x-2y-1+2y+4x+3) \\\\  & =\\frac{1}{\\sqrt{6}}(3x+2).\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\frac{1}{\\sqrt{6}}(3x+2)\\,\\text{d}S \\\\  & ={∬}_{D}\\frac{1}{\\sqrt{6}}(3x+2)\\cdot ||{r}_{x}\\times {r}_{y}||\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{\\sqrt{6}}(3x+2)\\cdot \\sqrt{6}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{\\cancel{\\sqrt{6}}}(3x+2)\\cdot \\cancel{\\sqrt{6}}\\,\\text{d}A \\\\  & ={∬}_{D}(3x+2)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}(3x+2)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\,\\text{d}y\\cdot {\\int }_{0}^{2}(3x+2)\\,\\text{d}x \\\\  & =[y]_{0}^{1}\\cdot {[\\frac{3}{2}{x}^{2}+2x]}_{0}^{2} \\\\  & =1\\cdot 10 \\\\  & =10\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281499 1068 #edb/ref 17592186280932 13194139533405 17592186045585 true] [17592186281499 1069 "q-162543" 13194139533405 17592186045585 true] [17592186281499 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281499 1071 "![](images/7c/7ca9996f6d0185d99752ccf5201b5300e0e5149ad674bb9676cf8c716b71a171.png)\n\nConsider the vector field $F(x,y,z)=⟨0,\\,2y\\sqrt{25-{x}^{2}-{z}^{2}},\\,0⟩$ and the surface $S$ defined by the bounding region of a right circular cylinder of height $3$ whose base is a circle of radius $3$ centered at the origin, as shown above. Calculate the flux of $F$ through $S.$" 13194139533405 17592186045585 true] [17592186281499 1072 #uuid "9dd906e8-cb51-59ae-a963-a23ed28e4195" 13194139533405 17592186045585 true] [17592186281499 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $y$-component of $F=⟨0,\\,2y\\sqrt{25-{x}^{2}-{z}^{2}},\\,0⟩$ is non-zero. Since the lateral side of $S$ is parallel to the $y$-axis, the flux of $F$ through $S$ will be non-zero only at the left and right sides. \n\n![](images/32/320e0c3333aa59f4e856d7d869d6fece09b178ac1abb3acd402621977df9b496.png)\n\nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the right surface. On this surface, we have $y=3$ for ${x}^{2}+{z}^{2}\\le 9.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,1,\\,0⟩.\n$$\n\nUsing the fact that $y=3$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨0,\\,2y\\sqrt{25-{x}^{2}-{z}^{2}},\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =⟨0,\\,2(3)\\sqrt{25-{x}^{2}-{z}^{2}},\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =⟨0,\\,6\\sqrt{25-{x}^{2}-{z}^{2}},\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =6\\sqrt{25-{x}^{2}-{z}^{2}}.\\end{aligned}\n$$\n\nTherefore, the flux of $F$ across ${S}_{1}$ is given by\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}6\\sqrt{25-{x}^{2}-{z}^{2}}\\,\\text{d}S \\\\  & =6{∬}_{D}\\sqrt{25-{x}^{2}-{z}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nApplying a change of variables $(x,z)\\to (r,\\theta ),\\text{d}A=r\\,\\text{d}r\\,\\text{d}\\theta ,$ we have\n\n$$\n\\begin{aligned}6{∬}_{D}\\sqrt{25-{x}^{2}-{z}^{2}}\\,\\text{d}A & =6{∬}_{D}\\sqrt{25-{r}^{2}}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =6{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}r\\sqrt{25-{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =6{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta {\\int }_{0}^{3}r\\sqrt{25-{r}^{2}}\\,\\text{d}r \\\\  & =6\\cdot 2\\pi \\cdot {[-\\frac{1}{3}{(25-{r}^{2})}^{3/2}]}_{0}^{3} \\\\  & =-4\\pi (64-125) \\\\  & =-4\\pi (-61) \\\\  & =244\\pi .\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the left surface. On this surface, we have $y=0$ for ${x}^{2}+{z}^{2}\\le 9.$ Therefore, for everywhere on ${S}_{2},$ we have\n\n$$\nF(x,0,z)=⟨0,\\,2(0)\\sqrt{25-{x}^{2}-{z}^{2}},\\,0⟩=⟨0,\\,0,\\,0⟩.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S & ={∬}_{{S}_{2}}0\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}0\\,\\text{d}S \\\\  & =0.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =244\\pi +0 \\\\  & =244\\pi .\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281500 1068 #edb/ref 17592186281049 13194139533405 17592186045585 true] [17592186281500 1069 "q-162546" 13194139533405 17592186045585 true] [17592186281500 1070 #edb/ref 17592186045486 13194139533405 17592186045585 true] [17592186281500 1071 "Consider the vector field $F(x,y,z)=⟨y,\\,x,\\,z⟩$ and the surface $S$ defined in Cartesian coordinates as $z=3x-y$ for $0\\le x\\le 1$ and $0\\le y\\le 2.$ Calculate the flux of $F$ through $S$ with respect to the *downward*-pointing unit normal vector $n.$\n\n*Hint: You're given that the fundamental vector product of $S$ with respect to its canonical parametrization is $||{r}_{x}\\times {r}_{y}||=\\sqrt{11}.$*" 13194139533405 17592186045585 true] [17592186281500 1072 #uuid "39723672-6400-50eb-bf48-dba5cb75604c" 13194139533405 17592186045585 true] [17592186281500 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that our surface $z=3x-y$ can be written using the dot product as \n\n$$\n⟨x,\\,y,\\,z⟩\\cdot {{⟨-3,\\,1,\\,1⟩}_{⏟}}_{-\\overset{~}{n}}=0,\\,\\text{or}\\,⟨x,\\,y,\\,z⟩\\cdot {{⟨3,\\,-1,\\,-1⟩}_{⏟}}_{\\overset{~}{n}}=0.\n$$\n\nSince we require a downward-pointing normal vector to our surface $S,$ we must select one where the $z$-component is negative. This gives us the normal vector\n\n$$\n\\overset{~}{n}=⟨3,\\,-1,\\,-1⟩.\n$$\n\nNormalizing this vector, we get\n\n$$\n\\begin{aligned}n & =\\frac{\\overset{~}{n}}{‖\\overset{~}{n}‖} \\\\  & =\\frac{⟨3,\\,-1,\\,-1⟩}{\\sqrt{{3}^{2}+(-1)^{2}+(-1)^{2}}} \\\\  & =\\frac{1}{\\sqrt{11}}⟨3,\\,-1,\\,-1⟩.\\end{aligned}\n$$\n\nUsing the fact that $z=3x-y$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨y,\\,x,\\,z⟩\\cdot \\frac{1}{\\sqrt{11}}⟨3,\\,-1,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{11}}⟨y,\\,x,\\,3x-y⟩\\cdot ⟨3,\\,-1,\\,-1⟩ \\\\  & =\\frac{1}{\\sqrt{11}}(3y-x-(3x-y)) \\\\  & =\\frac{1}{\\sqrt{11}}(4y-4x).\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\frac{1}{\\sqrt{11}}(4y-4x)\\,\\text{d}S \\\\  & ={∬}_{D}\\frac{1}{\\sqrt{11}}(4y-4x)\\cdot ||{r}_{x}\\times {r}_{y}||\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{\\sqrt{11}}(4y-4x)\\cdot \\sqrt{11}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{\\cancel{\\sqrt{11}}}(4y-4x)\\cdot \\cancel{\\sqrt{11}}\\,\\text{d}A \\\\  & ={∬}_{D}(4y-4x)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(4y-4x)\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{[4xy-2{x}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}(4y-2)\\,\\text{d}y \\\\  & ={[2{y}^{2}-2y]}_{0}^{2} \\\\  & =4\\end{aligned}\n$$" 13194139533405 17592186045585 true] [17592186281501 1068 #edb/ref 17592186281128 13194139533405 17592186045585 true] [17592186281501 1069 "q-162547" 13194139533405 17592186045585 true] [17592186281501 1070 #edb/ref 17592186045487 13194139533405 17592186045585 true] [17592186281501 1071 "![](images/de/dedd58b5eeeba8b2874c740543132026f95157597dd12ad31fbaa476a3d77c2e.png)\n\nConsider the vector field $F(x,y,z)=⟨0,{y}^{2}(6-{x}^{2}-{z}^{2}),\\,0⟩$ and the surface $S$ defined by the bounding region of a right circular cylinder of height $4$ whose base is a circle of radius $3$ centered at the origin, as shown above. Calculate the flux of $F$ through $S.$" 13194139533405 17592186045585 true] [17592186281501 1072 #uuid "6aee075a-fd15-5236-b83e-02176157c22a" 13194139533405 17592186045585 true] [17592186281501 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $y$-component of $F=⟨0,{y}^{2}(6-{x}^{2}-{z}^{2}),\\,0⟩$ is non-zero. Since the lateral side of $S$ is parallel to the $y$-axis, the flux of $F$ through $S$ will be non-zero only at the left and right sides. \n\n![](images/9f/9ffcdd701a8ac6b12cd62773e1cabfd2ce95f9a809e18d087c4bf4f4a22eadb5.png)\n\nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the right surface. On this surface, we have $y=4$ for ${x}^{2}+{z}^{2}\\le 9.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,1,\\,0⟩.\n$$\n\nUsing the fact that $y=4$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨0,\\,{y}^{2}(6-{x}^{2}-{z}^{2}),\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =⟨0,\\,({4}^{2})(6-{x}^{2}-{z}^{2}),\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =⟨0,\\,16(6-{x}^{2}-{z}^{2}),\\,0⟩\\cdot ⟨0,\\,1,\\,0⟩ \\\\  & =16(6-{x}^{2}-{z}^{2}).\\end{aligned}\n$$\n\nTherefore, the flux of $F$ across ${S}_{1}$ is given by\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}16(6-{x}^{2}-{z}^{2})\\,\\text{d}S \\\\  & =16{∬}_{D}(6-{x}^{2}-{z}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nApplying a change of variables $(x,z)\\to (r,\\theta ),\\text{d}A=r\\,\\text{d}r\\,\\text{d}\\theta ,$ we have\n\n$$\n\\begin{aligned}16{∬}_{D}(6-{x}^{2}-{z}^{2})\\,\\text{d}A & =16{∬}_{D}(6-{r}^{2})\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =16{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}r(6-{r}^{2})\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =16{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}(6r-{r}^{3})\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =16{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta {\\int }_{0}^{3}(6r-{r}^{3})\\,\\text{d}r \\\\  & =16\\cdot 2\\pi \\cdot {[3{r}^{2}-\\frac{1}{4}{r}^{4}]}_{0}^{3} \\\\  & =32\\pi (27-\\frac{81}{4}) \\\\  & =32\\pi (\\frac{27}{4}) \\\\  & =216\\pi .\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the left surface. On this surface, we have $y=0$ for ${x}^{2}+{z}^{2}\\le 9.$ Therefore, for everywhere on ${S}_{2},$ we have\n\n$$\nF(x,0,z)=⟨0,\\,{0}^{2}(6-{x}^{2}-{z}^{2}),\\,0⟩=⟨0,\\,0,\\,0⟩.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S & ={∬}_{{S}_{2}}0\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}0\\,\\text{d}S \\\\  & =0.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =216\\pi +0 \\\\  & =216\\pi .\\end{aligned}\n$$" 13194139533405 17592186