^{2}⁡t} \\\\  & =\\sqrt{9{cos}^{2}⁡t+16}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{\\pi /6}^{\\pi /4}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\sqrt{9{cos}^{2}⁡t+16}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262779 1068 #edb/ref 17592186262353 13194139533399 17592186045585 true] [17592186262779 1069 "q-127427" 13194139533399 17592186045585 true] [17592186262779 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262779 1071 "Which integral expression gives the arc length of the curve $f(t)=⟨\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,{e}^{t},\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩$ from $t=-1$ to $t=1?$" 13194139533399 17592186045585 true] [17592186262779 1072 #uuid "ae63a631-2f65-575f-9860-3fcf3ba50584" 13194139533399 17592186045585 true] [17592186262779 1074 "First, we find ${f}^{′}(t)$ and $‖{f}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,{e}^{t},\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩ \\\\ ‖{f}^{′}(t)‖ & =\\sqrt{{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+({e}^{t})^{2}+{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{e}^{2t}+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t} \\\\  & =\\sqrt{{e}^{2t}+2({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\sqrt{{e}^{2t}+2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{f}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{e}^{2t}+2}\\,\\text{d}t.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262780 1068 #edb/ref 17592186262232 13194139533399 17592186045585 true] [17592186262780 1069 "q-127454" 13194139533399 17592186045585 true] [17592186262780 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262780 1071 "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}-3 \\\\ 5 \\\\ 0\\end{aligned}]+t[\\begin{aligned}7 \\\\ 0 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" 13194139533399 17592186045585 true] [17592186262780 1072 #uuid "5ca9c758-73dc-58e9-9495-123d55df1262" 13194139533399 17592186045585 true] [17592186262780 1074 "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{7}=\\frac{y-5}{0}=\\frac{z}{2}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{7}=\\frac{y-5}{0}=\\frac{z}{2},\n$$\n\nwhich is problematic because $\\frac{y-5}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $y$ component always maintains the constant value of $y=5:$\n\n$$\nr=[\\begin{aligned}-3+7t \\\\ 5 \\\\ 2t\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{y-5}{0}$ part and instead write $y=5$, as follows:\n\n$$\n\\frac{x+3}{7}=\\frac{z}{2},\\,y=5\n$$" 13194139533399 17592186045585 true] [17592186262781 1068 #edb/ref 17592186262354 13194139533399 17592186045585 true] [17592186262781 1069 "q-127461" 13194139533399 17592186045585 true] [17592186262781 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262781 1071 "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}3 \\\\ 0 \\\\ -2\\end{aligned}]+t[\\begin{aligned}-5 \\\\ 1 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" 13194139533399 17592186045585 true] [17592186262781 1072 #uuid "bc58b647-06b9-513c-a89e-a6d58119d8ec" 13194139533399 17592186045585 true] [17592186262781 1074 "Using the usual formula, we get\n\n$$\n\\frac{x-3}{-5}=\\frac{y-0}{1}=\\frac{z-(-2)}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-3}{-5}=\\frac{y}{1}=\\frac{z+2}{0},\n$$\n\nwhich is problematic because $\\frac{z+2}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=-2:$\n\n$$\nr=[\\begin{aligned}3-5t \\\\ t \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z+2}{0}$ part and instead write $z=-2,$ as follows:\n\n$$\n\\frac{x-3}{-5}=\\frac{y}{1},\\,z=-2\n$$" 13194139533399 17592186045585 true] [17592186262782 1068 #edb/ref 17592186262558 13194139533399 17592186045585 true] [17592186262782 1069 "q-127466" 13194139533399 17592186045585 true] [17592186262782 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262782 1071 "![](images/16/1647eb5cca32c6fdc99e23507db151a8299b29bfa70ebfbaa941e17fe4638586.png)\n\nFind a Cartesian equation of the line shown in the figure above." 13194139533399 17592186045585 true] [17592186262782 1072 #uuid "137b0f7e-9478-507b-9673-19fabe3f3d94" 13194139533399 17592186045585 true] [17592186262782 1074 "We know that the line passes through the points $P(-1,4,5)$ and $Q(7,-1,2).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨7,-1,2⟩-⟨-1,4,5⟩ \\\\  & =⟨8,-5,-3⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-(-1)}{8}=\\frac{y-4}{-5}=\\frac{z-5}{-3}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+1}{8}=\\frac{y-4}{-5}=\\frac{z-5}{-3}.\n$$" 13194139533399 17592186045585 true] [17592186262783 1068 #edb/ref 17592186262257 13194139533399 17592186045585 true] [17592186262783 1069 "q-127493" 13194139533399 17592186045585 true] [17592186262783 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262783 1071 "![](images/f2/f24d078ca0dc57ebd12778b7862683b0289e9c0d4c664639bd210dcc1f7c6d1b.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." 13194139533399 17592186045585 true] [17592186262783 1072 #uuid "fdc8e2a5-3885-5dd5-9725-cf793a052578" 13194139533399 17592186045585 true] [17592186262783 1074 "Since our circle is centered at the origin and has a radius of $4,$ its equation is given by\n\n$$\n{x}^{2}+{y}^{2}={4}^{2}\\,⟹\\,{x}^{2}+{y}^{2}=16.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(16) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2x+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262784 1068 #edb/ref 17592186262319 13194139533399 17592186045585 true] [17592186262784 1069 "q-127497" 13194139533399 17592186045585 true] [17592186262784 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262784 1071 "![](images/a3/a3ca092dc7c0668ac465d4832b91a2b831af057ff22e357b4e7105bfb454ea18.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." 13194139533399 17592186045585 true] [17592186262784 1072 #uuid "270ef110-70fe-5fce-83a6-6d6bf6a5f7cf" 13194139533399 17592186045585 true] [17592186262784 1074 "Since our circle is centered at $(1,0)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-1)^{2}+(y-0)^{2}={2}^{2}\\,⟹\\,(x-1)^{2}+{y}^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x-1)^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x-1)^{2})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ 2(x-1)+2y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2(x-1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1-x}{y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262785 1068 #edb/ref 17592186262495 13194139533399 17592186045585 true] [17592186262785 1069 "q-127499" 13194139533399 17592186045585 true] [17592186262785 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262785 1071 "![](images/2f/2f08e0a0d1fd855f2d179ac65dbdf5d022f3488b85c78b5cbb507f12bd69487e.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." 13194139533399 17592186045585 true] [17592186262785 1072 #uuid "d49ad33a-9c4d-534a-b2d2-deca2d37a9d8" 13194139533399 17592186045585 true] [17592186262785 1074 "Since our circle is centered at $(-1,1)$ and has a radius of $1,$ its equation is given by\n\n$$\n(x-(-1))^{2}+(y-1)^{2}={1}^{2}\\,⟹\\,(x+1)^{2}+(y-1)^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+1)^{2}+(y-1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+1)^{2})+\\frac{\\text{d}}{\\text{d}x}((y-1)^{2}) & =0 \\\\ 2(x+1)+2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y-1)\\frac{\\text{d}y}{\\text{d}x} & =-2(x+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{y-1} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{x+1}{1-y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262786 1068 #edb/ref 17592186262369 13194139533399 17592186045585 true] [17592186262786 1069 "q-127500" 13194139533399 17592186045585 true] [17592186262786 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262786 1071 "![](images/78/78ad1a6835bb71441f77a3ca2bbdc93a42635e0386cda35fbe5fc9b0c9f48677.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." 13194139533399 17592186045585 true] [17592186262786 1072 #uuid "8fba4c03-ae99-5394-bb2d-645b07038e02" 13194139533399 17592186045585 true] [17592186262786 1074 "Since our circle is centered at $(-3,-2)$ and has a radius of $2,$ its equation is given by\n\n$$\n(x-(-3))^{2}+(y-(-2))^{2}={2}^{2}\\,⟹\\,(x+3)^{2}+(y+2)^{2}=4.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}((x+3)^{2}+(y+2)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}((x+3)^{2})+\\frac{\\text{d}}{\\text{d}x}((y+2)^{2}) & =0 \\\\ 2(x+3)+2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =-2(x+3) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+3}{y+2}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262787 1068 #edb/ref 17592186262374 13194139533399 17592186045585 true] [17592186262787 1069 "q-127502" 13194139533399 17592186045585 true] [17592186262787 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262787 1071 "![](images/81/812f88e913650b7924fc13acc7adde999819d0011fa547a7e0ad73cb37e3939f.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the circle shown above." 13194139533399 17592186045585 true] [17592186262787 1072 #uuid "49f66e90-d770-50de-8b81-b5c4a9d9e022" 13194139533399 17592186045585 true] [17592186262787 1074 "Since our circle is centered at $(0,-2)$ and has a radius of $3,$ its equation is given by\n\n$$\n(x-0)^{2}+(y-(-2))^{2}={3}^{2}\\,⟹\\,{x}^{2}+(y+2)^{2}=9.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+(y+2)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}((y+2)^{2}) & =0 \\\\ 2x+2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+2)\\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{y+2}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262788 1068 #edb/ref 17592186262261 13194139533399 17592186045585 true] [17592186262788 1069 "q-127510" 13194139533399 17592186045585 true] [17592186262788 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262788 1071 "![](images/e0/e0d18f7db92cfbe372f998e69d2395f2d586eb36cd25773588149c4ccf678eba.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above." 13194139533399 17592186045585 true] [17592186262788 1072 #uuid "d5970e3a-67be-579a-8f6a-680fce2bb7ff" 13194139533399 17592186045585 true] [17592186262788 1074 "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(3,6).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(3,6)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=3$ and $y=6$ into the equation above, we get\n\n$$\n\\begin{aligned}(6)^{2} & =4p(3) \\\\ 36 & =12p \\\\ p & =3.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=12x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =12 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6}{y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262789 1068 #edb/ref 17592186262560 13194139533399 17592186045585 true] [17592186262789 1069 "q-127511" 13194139533399 17592186045585 true] [17592186262789 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262789 1071 "![](images/c0/c0295c7cdc1abc16273efda842a0aa7a892ece2f5dda5e29f7baab25320b23ec.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262789 1072 #uuid "adf3739c-b726-56b2-925a-36974745f33e" 13194139533399 17592186045585 true] [17592186262789 1074 "Since our ellipse is centered at the origin and has semiaxes $1$ and $2,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1\\,⟹\\,{x}^{2}+\\frac{{y}^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{4}) & =0 \\\\ 2x+\\frac{2y}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4x}{y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262790 1068 #edb/ref 17592186262130 13194139533399 17592186045585 true] [17592186262790 1069 "q-127512" 13194139533399 17592186045585 true] [17592186262790 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262790 1071 "![](images/43/43e8ed1ee117ccd10f0e3aa03fc8db8ec1db6c076689e9072e1e22e048dfc279.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262790 1072 #uuid "4ab32aff-f9ee-5a7b-b7ab-1cf6d27aabda" 13194139533399 17592186045585 true] [17592186262790 1074 "Since our ellipse is centered at the origin and has semiaxes $5$ and $3,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{5}^{2}}+\\frac{{y}^{2}}{{3}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{25}+\\frac{{y}^{2}}{9}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{25})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{9}) & =0 \\\\ \\frac{2x}{25}+\\frac{2y}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2y}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x}{25} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{9x}{25y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262791 1068 #edb/ref 17592186262173 13194139533399 17592186045585 true] [17592186262791 1069 "q-127513" 13194139533399 17592186045585 true] [17592186262791 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262791 1071 "![](images/f8/f8effaf21270245ed6f8df63d2e430483756f47537b1c7325e88acc5286544db.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262791 1072 #uuid "fb8ad6d7-f6da-5fbc-be48-a49f26e33603" 13194139533399 17592186045585 true] [17592186262791 1074 "Since our ellipse is centered at the origin and has semiaxes $2$ and $5,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{5}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{25}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{25}) & =0 \\\\ \\frac{2x}{4}+\\frac{2y}{25}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2y}{25}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{25x}{4y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262792 1068 #edb/ref 17592186262363 13194139533399 17592186045585 true] [17592186262792 1069 "q-127514" 13194139533399 17592186045585 true] [17592186262792 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262792 1071 "![](images/54/547b79b566d2914db4a63997cd5fc9f02dd1517b8dcd5e53cde8c07ac5ca05a2.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262792 1072 #uuid "9b971938-bd81-5d73-bed8-1323d79a80ec" 13194139533399 17592186045585 true] [17592186262792 1074 "Since our ellipse is centered at the origin and has semiaxes $3$ and $1,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{9}+{y}^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{9}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{9})+\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =0 \\\\ \\frac{2x}{9}+2y\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2y\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2x}{9} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{9y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262793 1068 #edb/ref 17592186262263 13194139533399 17592186045585 true] [17592186262793 1069 "q-127515" 13194139533399 17592186045585 true] [17592186262793 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262793 1071 "![](images/5e/5eedb15e515993bdc8a2ee37ab4c7c0e0225b9d2118d5d60e8593de5ea56f199.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above." 13194139533399 17592186045585 true] [17592186262793 1072 #uuid "b2ff195e-41e9-5105-9c9e-ed134d28a53d" 13194139533399 17592186045585 true] [17592186262793 1074 "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-1,2).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-1$ and $y=2$ into the equation above, we get\n\n$$\n\\begin{aligned}(2)^{2} & =4p(-1) \\\\ 4 & =-4p \\\\ p & =-1.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-4x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-4x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-4 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2}{y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262794 1068 #edb/ref 17592186262568 13194139533399 17592186045585 true] [17592186262794 1069 "q-127520" 13194139533399 17592186045585 true] [17592186262794 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262794 1071 "![](images/60/60987d053d138d4a26cbc05adccb0da23810f97243f9399d3fe401a0202394b0.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the left-opening parabola shown above." 13194139533399 17592186045585 true] [17592186262794 1072 #uuid "72fb768f-c740-5cf4-b10e-4551f1d715de" 13194139533399 17592186045585 true] [17592186262794 1074 "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(-8,4).$\n\nThe general equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=-8$ and $y=4$ into the equation above, we get\n\n$$\n\\begin{aligned}(4)^{2} & =4p(-8) \\\\ 16 & =-32p \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=-2x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(-2x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =-2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262795 1068 #edb/ref 17592186262534 13194139533399 17592186045585 true] [17592186262795 1069 "q-127523" 13194139533399 17592186045585 true] [17592186262795 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262795 1071 "![](images/eb/ebef81911a434828ab94e643007d06b677538cdf0995198c7a065e35a8f81996.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262795 1072 #uuid "8af60131-dadd-5b8a-b5a0-d50b94e5f35b" 13194139533399 17592186045585 true] [17592186262795 1074 "Since our ellipse is centered at $(-1,-1)$ and has semiaxes $2$ and $1,$ its equation is given by\n\n$$\n\\frac{(x-(-1))^{2}}{{2}^{2}}+\\frac{(y-(-1))^{2}}{{1}^{2}}=1\\,⟹\\,\\frac{(x+1)^{2}}{4}+(y+1)^{2}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{4}+(y+1)^{2}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x+1)^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}((y+1)^{2}) & =0 \\\\ \\frac{2(x+1)}{4}+2(y+1)\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ 2(y+1)\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x+1}{4(y+1)}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262796 1068 #edb/ref 17592186262383 13194139533399 17592186045585 true] [17592186262796 1069 "q-127525" 13194139533399 17592186045585 true] [17592186262796 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262796 1071 "![](images/eb/eb0fbc8f57621946a5ec5168e8c607d230269e0c6a64b4c86c835c110f0f6288.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262796 1072 #uuid "3bb11842-6e3d-5501-86bf-db20e32986e2" 13194139533399 17592186045585 true] [17592186262796 1074 "Since our ellipse is centered at $(0,1)$ and has semiaxes $2$ and $3,$ its equation is given by\n\n$$\n\\frac{(x-0)^{2}}{{2}^{2}}+\\frac{(y-1)^{2}}{{3}^{2}}=1\\,⟹\\,\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{9}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{9}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{2}}{4})+\\frac{\\text{d}}{\\text{d}x}(\\frac{(y-1)^{2}}{9}) & =0 \\\\ \\frac{2x}{4}+\\frac{2(y-1)}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2(y-1)}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{x}{2} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{9x}{4(y-1)}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262797 1068 #edb/ref 17592186262466 13194139533399 17592186045585 true] [17592186262797 1069 "q-127526" 13194139533399 17592186045585 true] [17592186262797 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262797 1071 "![](images/e4/e4c39b409f6049a4fdead506c329d232820876c37ede9540adfeade2d7c1b9dc.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." 13194139533399 17592186045585 true] [17592186262797 1072 #uuid "32df6ca6-168d-529a-bf6d-352a5419e7a1" 13194139533399 17592186045585 true] [17592186262797 1074 "Since our ellipse is centered at $(3,0)$ and has semiaxes $3$ and $2,$ its equation is given by\n\n$$\n\\frac{(x-3)^{2}}{{3}^{2}}+\\frac{(y-0)^{2}}{{2}^{2}}=1\\,⟹\\,\\frac{(x-3)^{2}}{9}+\\frac{{y}^{2}}{4}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{(x-3)^{2}}{9}+\\frac{{y}^{2}}{4}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{(x-3)^{2}}{9})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{4}) & =0 \\\\ \\frac{2(x-3)}{9}+\\frac{2y}{4}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{y}{2}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{2(x-3)}{9} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{4(x-3)}{9y}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262798 1068 #edb/ref 17592186262175 13194139533399 17592186045585 true] [17592186262798 1069 "q-127527" 13194139533399 17592186045585 true] [17592186262798 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262798 1071 "![](images/87/8722b93655e069e2f35147b572c16ed7af408a86f8a88597c79aea8fe59e9c4d.png)\n\nFind a Cartesian equation of the line shown in the figure above." 13194139533399 17592186045585 true] [17592186262798 1072 #uuid "b6f2a4e2-bb20-56c7-957d-47666291e84e" 13194139533399 17592186045585 true] [17592186262798 1074 "We know that the line passes through the points $P(2,-1,3)$ and $Q(4,-3,3).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨4,-3,3⟩-⟨2,-1,3⟩ \\\\  & =⟨2,-2,0⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-2}{2}=\\frac{y-(-1)}{-2}=\\frac{z-3}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-2}{2}=\\frac{y+1}{-2}=\\frac{z-3}{0}.\n$$\n\nBut the above equation is problematic because $\\frac{z-3}{0}$ involves division by zero.\n\nHowever, in our line, the $z$ component always maintains the constant value of $z=3.$ For example, our two points $P(2,-1,3)$ and $Q(4,-3,3)$ both have $z$-coordinates of $z=3.$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-3}{0}$ part and instead write $z=3,$ as follows:\n\n$$\n\\frac{x-2}{2}=\\frac{y+1}{-2},\\,z=3.\n$$" 13194139533399 17592186045585 true] [17592186262799 1068 #edb/ref 17592186262137 13194139533399 17592186045585 true] [17592186262799 1069 "q-127535" 13194139533399 17592186045585 true] [17592186262799 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262799 1071 "![](images/44/44b0b683358bb448229380402717f396d13f82d2904bbf1ece1fcf9fd4567f14.png)\n\nFind a Cartesian equation of the line shown in the figure above." 13194139533399 17592186045585 true] [17592186262799 1072 #uuid "b51977f5-581a-5b22-a0d4-d5e01eee808b" 13194139533399 17592186045585 true] [17592186262799 1074 "We know that the line passes through the points $P(7,-2,4)$ and $Q(1,1,4).$ Now, we need to find a vector parallel to the given line. Let's consider the vector $\\overset{\\to }{PQ}$ which is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,4⟩-⟨7,-2,4⟩ \\\\  & =⟨-6,3,0⟩.\\end{aligned}\n$$\n\nUsing the point $P$ and the vector $\\overset{\\to }{PQ}$, we have that the Cartesian (canonical) equation of the given line is given by\n\n$$\n\\frac{x-7}{-6}=\\frac{y-(-2)}{3}=\\frac{z-4}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-7}{-6}=\\frac{y+2}{3}=\\frac{z-4}{0}.\n$$\n\nBut the above equation is problematic because $\\frac{z-4}{0}$ involves division by zero.\n\nHowever, in our line, the $z$ component always maintains the constant value of $z=4.$ For example, our two points $P(7,-2,4)$ and $Q(1,1,4)$ both have $z$-coordinates of $z=4.$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-4}{0}$ part and instead write $z=4,$ as follows:\n\n$$\n\\frac{x-7}{-6}=\\frac{y+2}{3},\\,z=4\n$$" 13194139533399 17592186045585 true] [17592186262800 1068 #edb/ref 17592186262506 13194139533399 17592186045585 true] [17592186262800 1069 "q-127573" 13194139533399 17592186045585 true] [17592186262800 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262800 1071 "![](images/16/162c0d0310cbbb533c30af373820751fc6c5a447127958486571224d7f8ac07a.png)\n\nFind the arc length of the curve $r(t)=⟨{e}^{t}\\operatorname{cos}⁡t,\\,{e}^{t}\\operatorname{sin}⁡t⟩$ from $t=0$ to $t=\\frac{\\pi }{2}.$" 13194139533399 17592186045585 true] [17592186262800 1072 #uuid "76702025-335e-5381-8404-f40fe3fd7dfd" 13194139533399 17592186045585 true] [17592186262800 1074 "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)⟩ \\\\  & =⟨{e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\,{e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)⟩ \\\\  & ={e}^{t}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =|{e}^{t}|\\sqrt{{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)}^{2}} \\\\  & ={e}^{t}\\sqrt{{cos}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t} \\\\  & ={e}^{t}\\sqrt{2({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\sqrt{2}{e}^{t}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2}{e}^{t}\\,\\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}{e}^{t}\\,\\text{d}t \\\\  & =\\sqrt{2}{e}^{t}\\,{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{2}({e}^{\\pi /2}-{e}^{0}) \\\\  & =\\sqrt{2}({e}^{\\pi /2}-1).\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262801 1068 #edb/ref 17592186262222 13194139533399 17592186045585 true] [17592186262801 1069 "q-127577" 13194139533399 17592186045585 true] [17592186262801 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262801 1071 "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{{t}^{2}+1}\\cdot q(t).\n$$\n\nFind the principal normal vector at the point where $t=1$, if \n\n$$\n\\begin{aligned}q(1)=-i+j+\\sqrt{2}\\,k,\\,{q}^{′}(1)=2\\,j+\\sqrt{2}\\,k.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262801 1072 #uuid "305931b7-f480-5c73-a2a4-acb7adfcdb55" 13194139533399 17592186045585 true] [17592186262801 1074 "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=1:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{t}^{2}+1}\\cdot q(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{t}^{2}+1})\\cdot q(t)+\\frac{1}{{t}^{2}+1}\\cdot \\frac{\\text{d}}{\\text{d}t}(q(t)) \\\\  & =-\\frac{2t}{({t}^{2}+1)^{2}}\\cdot q(t)+\\frac{1}{{t}^{2}+1}\\cdot {q}^{′}(t) \\\\  \\\\ {T}^{′}(1) & =-\\frac{2(1)}{({1}^{2}+1)^{2}}\\cdot q(1)+\\frac{1}{{1}^{2}+1}\\cdot {q}^{′}(1) \\\\  & =-\\frac{1}{2}(-i+j+\\sqrt{2}\\,k)+\\frac{1}{2}(2\\,j+\\sqrt{2}\\,k) \\\\  & =\\frac{1}{2}(i+j)\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(1):$\n\n$$\n\\begin{aligned}‖{T}^{′}(1)‖ & =|\\frac{1}{2}|\\sqrt{(1)^{2}+(1)^{2}+(0)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(1)$ and obtain the principal normal to the curve at the point where $t=1:$\n\n$$\n\\begin{aligned}N(1) & =\\frac{{T}^{′}(1)}{‖{T}^{′}(1)‖} \\\\  & =\\frac{\\frac{1}{2}(i+j)}{(\\frac{\\sqrt{2}}{2})} \\\\  & =\\frac{1}{\\sqrt{2}}(i+j)\\end{aligned}\n$$\n\nNote that when we find the scalar product of $N$ and $T$ at the point where $t=1,$ we get\n\n$$\n\\begin{aligned}T(1)\\cdot N(1) & =\\frac{1}{2}q(1)\\cdot \\frac{1}{\\sqrt{2}}(i+j) \\\\  & =\\frac{1}{2}(-i+j+\\sqrt{2}\\,k)\\cdot \\frac{1}{\\sqrt{2}}(i+j) \\\\  & =\\frac{1}{2\\sqrt{2}}(-1+1+0) \\\\  & =0.\\,✓\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262802 1068 #edb/ref 17592186262505 13194139533399 17592186045585 true] [17592186262802 1069 "q-127578" 13194139533399 17592186045585 true] [17592186262802 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262802 1071 "$|\\begin{aligned}5 & -9 \\\\ -3 & 7\\end{aligned}|=$" 13194139533399 17592186045585 true] [17592186262802 1072 #uuid "1ea8f2b8-d1da-5f6e-96c2-1f49a78fce12" 13194139533399 17592186045585 true] [17592186262802 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}5 & -9 \\\\ -3 & 7\\end{aligned}| & =5\\cdot 7-(-9)\\cdot (-3) \\\\  & =35-27 \\\\  & =8\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262803 1068 #edb/ref 17592186262352 13194139533399 17592186045585 true] [17592186262803 1069 "q-127580" 13194139533399 17592186045585 true] [17592186262803 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262803 1071 "$|\\begin{aligned}-1 & -10 \\\\ -2 & 5\\end{aligned}|=$" 13194139533399 17592186045585 true] [17592186262803 1072 #uuid "bcfbc0ab-8a2a-5b55-a599-576a8e82d92e" 13194139533399 17592186045585 true] [17592186262803 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}|\\begin{aligned}-1 & -10 \\\\ -2 & 5\\end{aligned}| & =-1\\cdot 5-(-10)\\cdot (-2) \\\\  & =-5-20 \\\\  & =-25\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262804 1068 #edb/ref 17592186262519 13194139533399 17592186045585 true] [17592186262804 1069 "q-127585" 13194139533399 17592186045585 true] [17592186262804 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262804 1071 "![](images/c4/c4aa91668440687bbae4b1f85672f5cbaf7ce00d978049c7558eed99b7361d1a.png)\n\nFind the arc length of the curve $r(t)=⟨3t-{t}^{3},\\,3{t}^{2}⟩$ from $t=-1$ to $t=1.$" 13194139533399 17592186045585 true] [17592186262804 1072 #uuid "1f15b24c-9b34-54f4-8404-a1b55cbcfc8d" 13194139533399 17592186045585 true] [17592186262804 1074 "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3t-{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨3-3{t}^{2},\\,6t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3-3{t}^{2})}^{2}+{(6t)}^{2}} \\\\  & =\\sqrt{9-18{t}^{2}+9{t}^{4}+36{t}^{2}} \\\\  & =\\sqrt{9{t}^{4}+18{t}^{2}+9} \\\\  & =3\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =3\\sqrt{({t}^{2}+1)^{2}} \\\\  & =3({t}^{2}+1)\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{1}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}3({t}^{2}+1)\\,\\text{d}t \\\\  & =3{\\int }_{-1}^{1}({t}^{2}+1)\\,\\text{d}t \\\\  & =3(\\frac{{t}^{3}}{3}+t){|}_{-1}^{1} \\\\  & =3(\\frac{{1}^{3}}{3}+1-[\\frac{(-1)^{3}}{3}+(-1)]) \\\\  & =3(\\frac{1}{3}+1+\\frac{1}{3}+1) \\\\  & =3(\\frac{8}{3}) \\\\  & =8\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262805 1068 #edb/ref 17592186262228 13194139533399 17592186045585 true] [17592186262805 1069 "q-127595" 13194139533399 17592186045585 true] [17592186262805 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262805 1071 "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{\\sqrt{1+4t}}\\cdot q(t).\n$$\n\nFind the principal normal vector at the point where $t=2,$ if \n\n$$\n\\begin{aligned}q(2)=⟨1,2\\sqrt{2}⟩,\\,{q}^{′}(2)=⟨0,\\frac{\\sqrt{2}}{2}⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262805 1072 #uuid "dc8e8967-4072-5705-809d-5e532a5002c5" 13194139533399 17592186045585 true] [17592186262805 1074 "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=2:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{1+4t}}\\cdot q(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{1+4t}})\\cdot q(t)+\\frac{1}{\\sqrt{1+4t}}\\cdot \\frac{\\text{d}}{\\text{d}t}(q(t)) \\\\  & =-\\frac{2}{(1+4t)^{3/2}}\\cdot q(t)+\\frac{1}{\\sqrt{1+4t}}\\cdot {q}^{′}(t) \\\\  \\\\ {T}^{′}(2) & =-\\frac{2}{(1+4(2))^{3/2}}\\cdot q(2)+\\frac{1}{\\sqrt{1+4(2)}}\\cdot {q}^{′}(2) \\\\  & =-\\frac{2}{27}⟨1,2\\sqrt{2}⟩+\\frac{1}{3}⟨0,\\frac{\\sqrt{2}}{2}⟩ \\\\  & =\\frac{1}{27}(-2⟨1,2\\sqrt{2}⟩+9⟨0,\\frac{\\sqrt{2}}{2}⟩) \\\\  & =\\frac{1}{27}⟨-2,\\frac{\\sqrt{2}}{2}⟩ \\\\  & =\\frac{1}{54}⟨-4,\\sqrt{2}⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(2):$\n\n$$\n\\begin{aligned}‖{T}^{′}(2)‖ & =\\frac{1}{54}\\sqrt{(-4)^{2}+(\\sqrt{2})^{2}} \\\\  & =\\frac{1}{54}\\cdot \\sqrt{18} \\\\  & =\\frac{\\sqrt{2}}{18}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(2)$ and obtain the principal normal to the curve at the point where $t=2:$\n\n$$\n\\begin{aligned}N(2) & =\\frac{{T}^{′}(2)}{‖{T}^{′}(2)‖} \\\\  & =\\frac{\\frac{1}{54}⟨-4,\\sqrt{2}⟩}{(\\frac{\\sqrt{2}}{18})} \\\\  & =\\frac{1}{3\\sqrt{2}}⟨-4,\\sqrt{2}⟩ \\\\  & =\\frac{1}{3}⟨-2\\sqrt{2},1⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=2,$ we get\n\n$$\n\\begin{aligned}T(2)\\cdot N(2) & =\\frac{1}{3}q(2)\\cdot \\frac{1}{3}⟨-2\\sqrt{2},1⟩ \\\\  & =\\frac{1}{3}⟨1,2\\sqrt{2}⟩\\cdot \\frac{1}{3}⟨-2\\sqrt{2},1⟩ \\\\  & =\\frac{1}{9}(1\\cdot (-2\\sqrt{2})+2\\sqrt{2}\\cdot 1) \\\\  & =\\frac{1}{9}(-2\\sqrt{2}+2\\sqrt{2}) \\\\  & =0.\\,✓\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262806 1068 #edb/ref 17592186262287 13194139533399 17592186045585 true] [17592186262806 1069 "q-127601" 13194139533399 17592186045585 true] [17592186262806 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262806 1071 "Calculate $det(C)$, if\n    $C=[\\begin{aligned}-x & -2y \\\\ \\frac{x}{2} & 5y\\end{aligned}].$" 13194139533399 17592186045585 true] [17592186262806 1072 #uuid "26e4f5d9-b2df-5b89-afc1-259e97c4e9b0" 13194139533399 17592186045585 true] [17592186262806 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(C) & =|\\begin{aligned}-x & -2y \\\\ \\frac{x}{2} & 5y\\end{aligned}| \\\\  & =-x\\cdot 5y-(-2y)\\cdot \\frac{x}{2} \\\\  & =-5xy+xy \\\\  & =-4xy\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262807 1068 #edb/ref 17592186262431 13194139533399 17592186045585 true] [17592186262807 1069 "q-127602" 13194139533399 17592186045585 true] [17592186262807 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262807 1071 "![](images/33/33412629fc30584cf4a1726eef7e4f23f623ae4439d25045d61e36f68914dacd.png)\n\nFind the arc length of the curve $r(t)=⟨t,\\,\\frac{1}{3}({t}^{2}+2)^{3/2}⟩$ from $t=-1$ to $t=2.$" 13194139533399 17592186045585 true] [17592186262807 1072 #uuid "3244e29a-ed4a-595a-8cf3-8bd475ff4af0" 13194139533399 17592186045585 true] [17592186262807 1074 "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}({t}^{2}+2)^{3/2})⟩ \\\\  & =⟨1,\\,t\\sqrt{{t}^{2}+2}⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{1}^{2}+{(t\\sqrt{{t}^{2}+2})}^{2}} \\\\  & =\\sqrt{1+{t}^{2}({t}^{2}+2)} \\\\  & =\\sqrt{{t}^{4}+2{t}^{2}+1} \\\\  & =\\sqrt{({t}^{2}+1)^{2}} \\\\  & ={t}^{2}+1\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{2}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}({t}^{2}+1)\\text{d}t \\\\  & =(\\frac{{t}^{3}}{3}+t){|}_{-1}^{2} \\\\  & =(\\frac{{2}^{3}}{3}+2)-(\\frac{(-1)^{3}}{3}+(-1)) \\\\  & =\\frac{8}{3}+2+\\frac{1}{3}+1 \\\\  & =6.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262808 1068 #edb/ref 17592186262450 13194139533399 17592186045585 true] [17592186262808 1069 "q-127603" 13194139533399 17592186045585 true] [17592186262808 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262808 1071 "Calculate $det(D)$, if\n    $D=[\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}].$" 13194139533399 17592186045585 true] [17592186262808 1072 #uuid "5adfe9df-8aee-5967-99f3-985aed9cc4da" 13194139533399 17592186045585 true] [17592186262808 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}| \\\\  & =2x\\cdot xy-y\\cdot (-5) \\\\  & =2{x}^{2}y+5y \\\\  & =y(2{x}^{2}+5)\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262809 1068 #edb/ref 17592186262252 13194139533399 17592186045585 true] [17592186262809 1069 "q-127604" 13194139533399 17592186045585 true] [17592186262809 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262809 1071 "If\n    $U=[\\begin{aligned}3 & -5 \\\\ 2k & -k+2\\end{aligned}]$\nand\n$\\text{det}(U)=-1$, what is the value of $k?$" 13194139533399 17592186045585 true] [17592186262809 1072 #uuid "eb9b1b8a-cede-5e44-9f81-ee8a71692716" 13194139533399 17592186045585 true] [17592186262809 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =|\\begin{aligned}3 & -5 \\\\ 2k & -k+2\\end{aligned}| \\\\  & =3\\cdot (-k+2)-(-5)\\cdot 2k \\\\  & =7k+6\\end{aligned}\n$$\n\nSince $det(U)=-1$, we get:\n\n$$\n\\begin{aligned}det(U) & =-1 \\\\ 7k+6 & =-1 \\\\ 7k & =-1-6 \\\\ 7k & =-7 \\\\ k & =-1\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262810 1068 #edb/ref 17592186262148 13194139533399 17592186045585 true] [17592186262810 1069 "q-127606" 13194139533399 17592186045585 true] [17592186262810 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262810 1071 "If\n$T=[\\begin{aligned}v & 2v \\\\ 2 & v+8\\end{aligned}]$\nand $det(T)=-4$, what is the value of $v?$" 13194139533399 17592186045585 true] [17592186262810 1072 #uuid "7bb355a7-6406-51ad-b4a4-0aaf09eca17d" 13194139533399 17592186045585 true] [17592186262810 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}v & 2v \\\\ 2 & v+8\\end{aligned}| \\\\  & =v\\cdot (v+8)-2v\\cdot 2 \\\\  & ={v}^{2}+4v\\end{aligned}\n$$\n\nSince $det(T)=-4$, we obtain:\n\n$$\n\\begin{aligned}det(T) & =-4 \\\\ {v}^{2}+4v & =-4 \\\\ {v}^{2}+4v+4 & =0 \\\\ (v+2)^{2} & =0 \\\\ v & =-2\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262811 1068 #edb/ref 17592186262255 13194139533399 17592186045585 true] [17592186262811 1069 "q-127607" 13194139533399 17592186045585 true] [17592186262811 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262811 1071 "If\n$P=[\\begin{aligned}r-3 & r \\\\ 3 & r\\end{aligned}]$\nand $det(P)=-9$, what is the value of $r?$" 13194139533399 17592186045585 true] [17592186262811 1072 #uuid "612dd17c-57fb-5f36-b33a-8e40d39733fb" 13194139533399 17592186045585 true] [17592186262811 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(P) & =|\\begin{aligned}r-3 & r \\\\ 3 & r\\end{aligned}| \\\\  & =(r-3)\\cdot r-r\\cdot 3 \\\\  & ={r}^{2}-6r\\end{aligned}\n$$\n\nSince $det(P)=-9$, we obtain:\n\n$$\n\\begin{aligned}det(P) & =-9 \\\\ {r}^{2}-6r & =-9 \\\\ {r}^{2}-6r+9 & =0 \\\\ (r-3)^{2} & =0 \\\\ r & =3\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262812 1068 #edb/ref 17592186262272 13194139533399 17592186045585 true] [17592186262812 1069 "q-127608" 13194139533399 17592186045585 true] [17592186262812 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262812 1071 "If\n$B=[\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}]$\nand $det(B)=1$, what is the value of $p?$" 13194139533399 17592186045585 true] [17592186262812 1072 #uuid "4e03a4dd-5246-5c91-8e03-9d7ad64d917d" 13194139533399 17592186045585 true] [17592186262812 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(B) & =|\\begin{aligned}5-p & p \\\\ 3 & p\\end{aligned}| \\\\  & =(5-p)\\cdot p-p\\cdot 3 \\\\  & =-{p}^{2}+2p\\end{aligned}\n$$\n\nSince $det(B)=1$, we obtain:\n\n$$\n\\begin{aligned}det(B) & =1 \\\\ -{p}^{2}+2p & =1 \\\\ -{p}^{2}+2p-1 & =0 \\\\ {p}^{2}-2p+1 & =0 \\\\ (p-1)^{2} & =0 \\\\ p & =1\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262813 1068 #edb/ref 17592186262420 13194139533399 17592186045585 true] [17592186262813 1069 "q-127609" 13194139533399 17592186045585 true] [17592186262813 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262813 1071 "If\n$A=[\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}]$\nand $det(A)=-27$, what is the value of $y?$" 13194139533399 17592186045585 true] [17592186262813 1072 #uuid "41f9cebe-1261-5298-9d1d-10bd7138212b" 13194139533399 17592186045585 true] [17592186262813 1074 "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}3y & y \\\\ 3 & y-5\\end{aligned}| \\\\  & =3y\\cdot (y-5)-y\\cdot 3 \\\\  & =3{y}^{2}-18y\\end{aligned}\n$$\n\nSince $det(A)=-27$, we obtain:\n\n$$\n\\begin{aligned}det(A) & =-27 \\\\ 3{y}^{2}-18y & =-27 \\\\ 3{y}^{2}-18y+27 & =0 \\\\ {y}^{2}-6y+9 & =0 \\\\ (y-3)^{2} & =0 \\\\ y & =3\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262814 1068 #edb/ref 17592186262350 13194139533399 17592186045585 true] [17592186262814 1069 "q-127616" 13194139533399 17592186045585 true] [17592186262814 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262814 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{2}⟨\\operatorname{sin}⁡(t+2),\\sqrt{3},\\operatorname{cos}⁡(t+2)⟩, \\\\ N(t) & =⟨\\operatorname{cos}⁡(t+2),0,-\\operatorname{sin}⁡(t+2)⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." 13194139533399 17592186045585 true] [17592186262814 1072 #uuid "81cbf55e-aaa5-5f25-a671-b11e1a67f1ca" 13194139533399 17592186045585 true] [17592186262814 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{2}⟨\\operatorname{sin}⁡(t+2),\\sqrt{3},\\operatorname{cos}⁡(t+2)⟩\\times ⟨\\operatorname{cos}⁡(t+2),0,-\\operatorname{sin}⁡(t+2)⟩ \\\\  & =\\frac{1}{2}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{sin}⁡(t+2) & \\sqrt{3} & \\operatorname{cos}⁡(t+2) \\\\ \\operatorname{cos}⁡(t+2) & 0 & -\\operatorname{sin}⁡(t+2)\\end{aligned}\\right| \\\\  & =\\frac{1}{2}[\\text{ }\\left|\\begin{aligned}\\sqrt{3} & \\operatorname{cos}⁡(t+2) \\\\ 0 & -\\operatorname{sin}⁡(t+2)\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{sin}⁡(t+2) & \\operatorname{cos}⁡(t+2) \\\\ \\operatorname{cos}⁡(t+2) & -\\operatorname{sin}⁡(t+2)\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{sin}⁡(t+2) & \\sqrt{3} \\\\ \\operatorname{cos}⁡(t+2) & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{2}⟨-\\sqrt{3}\\operatorname{sin}⁡(t+2)-0,-(-{sin}^{2}⁡(t+2)-{cos}^{2}⁡(t+2)),0-\\sqrt{3}\\operatorname{cos}⁡(t+2)⟩ \\\\  & =\\frac{1}{2}⟨-\\sqrt{3}\\operatorname{sin}⁡(t+2),1,-\\sqrt{3}\\operatorname{cos}⁡(t+2)⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262815 1068 #edb/ref 17592186262166 13194139533399 17592186045585 true] [17592186262815 1069 "q-127632" 13194139533399 17592186045585 true] [17592186262815 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262815 1071 "Find an equation of the plane that contains the point $P(\\sqrt{5},-1,2)$ and is perpendicular to the vector $n=\\sqrt{5}i-3j+2k.$" 13194139533399 17592186045585 true] [17592186262815 1072 #uuid "c5600d5c-cd95-56af-a0e8-ae34bd21b34c" 13194139533399 17592186045585 true] [17592186262815 1074 "First, we note that the position vector of $P$ is $p=\\sqrt{5}i-j+2k,$ and $n=\\sqrt{5}i-3j+2k$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot (\\sqrt{5}i-3j+2k) & =(\\sqrt{5}i-j+2k)\\cdot (\\sqrt{5}i-3j+2k) \\\\ r\\cdot (\\sqrt{5}i-3j+2k) & =12.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262816 1068 #edb/ref 17592186262491 13194139533399 17592186045585 true] [17592186262816 1069 "q-127635" 13194139533399 17592186045585 true] [17592186262816 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262816 1071 "Find the arc length of the curve $r(t)=⟨2t,\\,\\frac{1}{3}{t}^{3},\\,{t}^{2}⟩$ from $t=-1$ to $t=0.$" 13194139533399 17592186045585 true] [17592186262816 1072 #uuid "6796746e-0500-559b-91cc-a530cd306e54" 13194139533399 17592186045585 true] [17592186262816 1074 "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}))⟩ \\\\  & =⟨2,\\,{t}^{2},\\,2t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(2)}^{2}+{({t}^{2})}^{2}+{(2t)}^{2}} \\\\  & =\\sqrt{{t}^{4}+4{t}^{2}+4} \\\\  & =\\sqrt{({t}^{2}+2)^{2}} \\\\  & ={t}^{2}+2\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{-1}^{0}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{-1}^{0}({t}^{2}+2)\\,\\text{d}t \\\\  & =(\\frac{1}{3}{t}^{3}+2t){|}_{-1}^{0} \\\\  & =(\\frac{{0}^{3}}{3}+2(0))-(\\frac{(-1)^{3}}{3}+2(-1)) \\\\  & =\\frac{1}{3}+2 \\\\  & =\\frac{7}{3}\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262817 1068 #edb/ref 17592186262498 13194139533399 17592186045585 true] [17592186262817 1069 "q-127687" 13194139533399 17592186045585 true] [17592186262817 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262817 1071 "Consider the curve $r(t)=\\frac{\\sqrt{2}}{2}⟨{e}^{t}\\operatorname{sin}⁡t,\\,{e}^{t}\\operatorname{cos}⁡t⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s={e}^{t}-1.$ Given that $R(s)$ is the parametrization of the given curve by its arc length $s,$ what is the $x$-component of $R?$" 13194139533399 17592186045585 true] [17592186262817 1072 #uuid "10934b16-caa8-5843-93a5-554278b82678" 13194139533399 17592186045585 true] [17592186262817 1074 "First, since $s={e}^{t}-1,$ we have that $t=\\operatorname{ln}⁡(s+1).$\n\nThe vector function that pametrizes the curve $r(t)$ by its arc length $s,$ with $s\\ge 0,$ is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\operatorname{ln}⁡(s+1)) \\\\  & =\\frac{\\sqrt{2}}{2}⟨{e}^{\\operatorname{ln}⁡(s+1)}\\operatorname{sin}⁡[\\operatorname{ln}⁡(s+1)],\\,{e}^{\\operatorname{ln}⁡(s+1)}\\operatorname{cos}⁡[\\operatorname{ln}⁡(s+1)]⟩ \\\\  & =⟨\\frac{\\sqrt{2}}{2}(s+1)\\operatorname{sin}⁡[\\operatorname{ln}⁡(s+1)],\\,\\frac{\\sqrt{2}}{2}(s+1)\\operatorname{cos}⁡[\\operatorname{ln}⁡(s+1)]⟩.\\end{aligned}\n$$\n\n \n\nSo, the $x$-component of $R$ is\n\n$$\n\\frac{\\sqrt{2}}{2}(s+1)\\operatorname{sin}⁡[\\operatorname{ln}⁡(s+1)].\n$$" 13194139533399 17592186045585 true] [17592186262818 1068 #edb/ref 17592186262432 13194139533399 17592186045585 true] [17592186262818 1069 "q-127698" 13194139533399 17592186045585 true] [17592186262818 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262818 1071 "Calculate the minor of the entry ${d}_{23}$ in the matrix\n$D=[\\begin{aligned}10 & 2 & 5 \\\\ -12 & 44 & -33 \\\\ 25 & 30 & 41\\end{aligned}].$" 13194139533399 17592186045585 true] [17592186262818 1072 #uuid "a621bb9c-ea55-573d-8770-6ecb74ad88cd" 13194139533399 17592186045585 true] [17592186262818 1074 "The minor of ${d}_{23}=-33$ (second row, third column) is the determinant of the remaining entries when the column and row containing $-33$ are removed: \n\n$$\nD=[\\begin{aligned}10 & 2 & ∗ \\\\ ∗ & ∗ & -33 \\\\ 25 & 30 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${d}_{23}=-33$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}10 & 2 \\\\ 25 & 30\\end{aligned}] & =|\\begin{aligned}10 & 2 \\\\ 25 & 30\\end{aligned}| \\\\  & =10\\cdot 30-2\\cdot 25 \\\\  & =300-50 \\\\  & =250.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262819 1068 #edb/ref 17592186262321 13194139533399 17592186045585 true] [17592186262819 1069 "q-127699" 13194139533399 17592186045585 true] [17592186262819 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262819 1071 "Calculate the minor of the entry ${p}_{31}$ in the matrix\n$P=[\\begin{aligned}-11 & 7 & -9 \\\\ 2 & -2 & 9 \\\\ 8 & -5 & 72\\end{aligned}].$" 13194139533399 17592186045585 true] [17592186262819 1072 #uuid "e6b3d7cf-2cb2-50b5-b1d2-b03ab67b5161" 13194139533399 17592186045585 true] [17592186262819 1074 "The minor of ${p}_{31}=8$ (third row, first column) is the determinant of the remaining entries when the column and row containing $8$ are removed: \n\n$$\nP=[\\begin{aligned}∗ & 7 & -9 \\\\ ∗ & -2 & 9 \\\\ 8 & ∗ & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${p}_{31}=8$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}7 & -9 \\\\ -2 & 9\\end{aligned}] & =|\\begin{aligned}7 & -9 \\\\ -2 & 9\\end{aligned}| \\\\  & =7\\cdot 9-(-9)\\cdot (-2) \\\\  & =63-18 \\\\  & =45.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262820 1068 #edb/ref 17592186262314 13194139533399 17592186045585 true] [17592186262820 1069 "q-127703" 13194139533399 17592186045585 true] [17592186262820 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262820 1071 "Given the curve $r(t)=⟨{sin}^{2}⁡t,\\,{cos}^{2}⁡t,\\,\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡2t⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=\\sqrt{2}\\,t,$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" 13194139533399 17592186045585 true] [17592186262820 1072 #uuid "48e81d02-16d7-55d6-a98f-68b5d97b5c32" 13194139533399 17592186045585 true] [17592186262820 1074 "First, since $s=\\sqrt{2}\\,t,$ we have that $t=\\frac{s}{\\sqrt{2}}.$\n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\frac{s}{\\sqrt{2}}) \\\\  & =⟨{sin}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,{cos}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(2\\cdot \\frac{s}{\\sqrt{2}})⟩ \\\\  & =⟨{sin}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,{cos}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(\\sqrt{2}\\,s)⟩.\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parametrized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n \n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =⟨\\frac{\\text{d}}{\\text{d}s}({sin}^{2}⁡(\\frac{s}{\\sqrt{2}})),\\,\\frac{\\text{d}}{\\text{d}s}({cos}^{2}⁡(\\frac{s}{\\sqrt{2}})),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(\\sqrt{2}\\,s))⟩ \\\\  & =⟨\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(2\\cdot \\frac{s}{\\sqrt{2}}),\\,-\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(2\\cdot \\frac{s}{\\sqrt{2}}),\\,\\operatorname{cos}⁡(\\sqrt{2}\\,s)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,-\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}\\,s)⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262821 1068 #edb/ref 17592186262235 13194139533399 17592186045585 true] [17592186262821 1069 "q-127706" 13194139533399 17592186045585 true] [17592186262821 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262821 1071 "Given the curve $r(t)=\\frac{\\sqrt{5}}{5}⟨{t}^{2},\\,-2{t}^{2},\\,-2⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s={t}^{2},$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" 13194139533399 17592186045585 true] [17592186262821 1072 #uuid "f31cef9a-4812-584e-981f-6607695a83a2" 13194139533399 17592186045585 true] [17592186262821 1074 "First, since $s={t}^{2},$ we have that $t=\\sqrt{s}.$\n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\sqrt{s}) \\\\  & =\\frac{\\sqrt{5}}{5}⟨{(\\sqrt{s})}^{2},\\,-2{(\\sqrt{s})}^{2},\\,-2⟩ \\\\  & =\\frac{\\sqrt{5}}{5}⟨s,\\,-2s,\\,-2⟩.\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parameterized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =\\frac{\\sqrt{5}}{5}⟨\\frac{\\text{d}}{\\text{d}s}(s),\\,\\frac{\\text{d}}{\\text{d}s}(-2s),\\,\\frac{\\text{d}}{\\text{d}s}(-2)⟩ \\\\  & =\\frac{\\sqrt{5}}{5}⟨1,\\,-2,\\,0⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262822 1068 #edb/ref 17592186262273 13194139533399 17592186045585 true] [17592186262822 1069 "q-127727" 13194139533399 17592186045585 true] [17592186262822 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262822 1071 "What is the parametrization of the curve $r(t)=\\frac{1}{\\sqrt{2}}⟨-{e}^{t}\\operatorname{cos}⁡t,\\,{e}^{t}\\operatorname{sin}⁡t⟩,$ $t\\ge 0,$ by its arc length $s?$" 13194139533399 17592186045585 true] [17592186262822 1072 #uuid "999b990e-ea1c-50d5-96ba-0de0624dc088" 13194139533399 17592186045585 true] [17592186262822 1074 "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{1}{\\sqrt{2}}⟨\\frac{\\text{d}}{\\text{d}t}(-{e}^{t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨{e}^{t}\\operatorname{sin}⁡t-{e}^{t}\\operatorname{cos}⁡t,\\,{e}^{t}\\operatorname{sin}⁡t+{e}^{t}\\operatorname{cos}⁡t⟩ \\\\  & =\\frac{{e}^{t}}{\\sqrt{2}}⟨\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t+\\operatorname{cos}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =|\\frac{{e}^{t}}{\\sqrt{2}}|\\sqrt{{(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)}^{2}+{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\frac{{e}^{t}}{\\sqrt{2}}\\sqrt{{sin}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\frac{{e}^{t}}{\\sqrt{2}}\\sqrt{2({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\frac{{e}^{t}}{\\sqrt{2}}\\cdot \\sqrt{2} \\\\  & ={e}^{t}\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{0}^{t} \\\\  & ={e}^{t}-1\\end{aligned}\n$$\n\nSince $s={e}^{t}-1,$ we have\n\n$$\n\\begin{aligned}{e}^{t}-1 & =s \\\\ {e}^{t} & =s+1 \\\\ t & =\\operatorname{ln}⁡(s+1).\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\operatorname{ln}⁡(s+1)) \\\\  & =\\frac{1}{\\sqrt{2}}⟨-{e}^{\\operatorname{ln}⁡(s+1)}\\operatorname{cos}⁡[\\operatorname{ln}⁡(s+1)],\\,{e}^{\\operatorname{ln}⁡(s+1)}\\operatorname{sin}⁡[\\operatorname{ln}⁡(s+1)]⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-(s+1)\\operatorname{cos}⁡[\\operatorname{ln}⁡(s+1)],\\,(s+1)\\operatorname{sin}⁡[\\operatorname{ln}⁡(s+1)]⟩ \\\\  & =\\frac{s+1}{\\sqrt{2}}⟨-\\operatorname{cos}⁡[\\operatorname{ln}⁡(s+1)],\\,\\operatorname{sin}⁡[\\operatorname{ln}⁡(s+1)]⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262823 1068 #edb/ref 17592186262510 13194139533399 17592186045585 true] [17592186262823 1069 "q-127732" 13194139533399 17592186045585 true] [17592186262823 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262823 1071 "What is the parametrization of the curve $r(t)=⟨3\\operatorname{cos}⁡t-2,\\,1-3\\operatorname{sin}⁡t⟩,$ $t\\ge 0,$ by its arc length $s?$" 13194139533399 17592186045585 true] [17592186262823 1072 #uuid "40071fab-d489-5d46-9356-22b420cd3a67" 13194139533399 17592186045585 true] [17592186262823 1074 "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-2),\\,\\frac{\\text{d}}{\\text{d}t}(1-3\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-3\\operatorname{sin}⁡t,\\,-3\\operatorname{cos}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(-3\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\sqrt{9{sin}^{2}⁡t+9{cos}^{2}⁡t} \\\\  & =\\sqrt{9({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}3\\,\\text{d}u \\\\  & =3u\\,{|}_{0}^{t} \\\\  & =3t\\end{aligned}\n$$\n\nSince $s=3t,$ we have that $t=\\frac{s}{3}.$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\frac{s}{3}) \\\\  & =⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262824 1068 #edb/ref 17592186262398 13194139533399 17592186045585 true] [17592186262824 1069 "q-127735" 13194139533399 17592186045585 true] [17592186262824 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262824 1071 "What is the parametrization of the curve $r(t)=⟨1-{t}^{2},\\,2{t}^{2},\\,\\frac{\\sqrt{5}}{2}{t}^{2}⟩,$ $t\\ge 0,$ by its arc length $s?$" 13194139533399 17592186045585 true] [17592186262824 1072 #uuid "9f26bb6f-b90d-5486-851d-abcaa7a7af51" 13194139533399 17592186045585 true] [17592186262824 1074 "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{\\sqrt{5}}{2}{t}^{2})⟩ \\\\  & =⟨-2t,\\,4t,\\,\\sqrt{5}t⟩ \\\\  & =t⟨-2,\\,4,\\,\\sqrt{5}⟩ \\\\ ‖{r}^{′}(t)‖ & =|t|\\sqrt{{(-2)}^{2}+{(4)}^{2}+(\\sqrt{5})^{2}} \\\\  & =t\\sqrt{4+16+5} \\\\  & =t\\sqrt{25} \\\\  & =5t\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}5u\\,\\text{d}u \\\\  & =5{\\int }_{0}^{t}u\\,\\text{d}u \\\\  & =\\frac{5}{2}{u}^{2}\\,{|}_{0}^{t} \\\\  & =\\frac{5}{2}{t}^{2}\\end{aligned}\n$$\n\nSince $s=\\frac{5}{2}{t}^{2},$ we have\n\n$$\n\\begin{aligned}\\frac{5}{2}{t}^{2} & =s \\\\ {t}^{2} & =\\frac{2s}{5} \\\\ t & =\\sqrt{\\frac{2s}{5}}.\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\sqrt{\\frac{2s}{5}}) \\\\  & =⟨1-{(\\sqrt{\\frac{2s}{5}})}^{2},\\,2{(\\sqrt{\\frac{2s}{5}})}^{2},\\,\\frac{\\sqrt{5}}{2}{(\\sqrt{\\frac{2s}{5}})}^{2}⟩ \\\\  & =⟨1-\\frac{2s}{5},\\,\\frac{4s}{5},\\,\\frac{s\\sqrt{5}}{5}⟩ \\\\  & =\\frac{1}{5}⟨5-2s,\\,4s,\\,s\\sqrt{5}⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262825 1068 #edb/ref 17592186262260 13194139533399 17592186045585 true] [17592186262825 1069 "q-127739" 13194139533399 17592186045585 true] [17592186262825 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262825 1071 "What is the parametrization of the curve $r(t)=⟨{t}^{4},\\,\\frac{1}{2}{t}^{4}+2,\\,3-{t}^{4}⟩,$ $t\\ge 0,$ by its arc length $s?$" 13194139533399 17592186045585 true] [17592186262825 1072 #uuid "35d19d31-9377-5a1f-a9f6-e8ea15486111" 13194139533399 17592186045585 true] [17592186262825 1074 "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{4}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{4}+2),\\,\\frac{\\text{d}}{\\text{d}t}(3-{t}^{4})⟩ \\\\  & =⟨4{t}^{3},\\,2{t}^{3},\\,-4{t}^{3}⟩ \\\\  & =2{t}^{3}⟨2,\\,1,\\,-2⟩ \\\\ ‖{r}^{′}(t)‖ & =|2{t}^{3}|\\sqrt{{(2)}^{2}+{(1)}^{2}+(-2)^{2}} \\\\  & =2{t}^{3}\\sqrt{4+1+4} \\\\  & =6{t}^{3}\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}6{u}^{3}\\,\\text{d}u \\\\  & =6{\\int }_{0}^{t}{u}^{3}\\,\\text{d}u \\\\  & =\\frac{3}{2}{u}^{4}\\,{|}_{0}^{t} \\\\  & =\\frac{3}{2}{t}^{4}\\end{aligned}\n$$\n\nSince $s=\\frac{3}{2}{t}^{4}$ and $t\\ge 0,$ we have\n\n$$\n\\begin{aligned}\\frac{3}{2}{t}^{4} & =s \\\\ {t}^{4} & =\\frac{2s}{3} \\\\ t & =\\sqrt[4]{\\frac{2s}{3}}.\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\sqrt[4]{\\frac{2s}{3}}) \\\\  & =⟨{(\\sqrt[4]{\\frac{2s}{3}})}^{4},\\,\\frac{1}{2}{(\\sqrt[4]{\\frac{2s}{3}})}^{4}+2,\\,3-{(\\sqrt[4]{\\frac{2s}{3}})}^{4}⟩ \\\\  & =⟨\\frac{2s}{3},\\,\\frac{s}{3}+2,\\,3-\\frac{2s}{3}⟩ \\\\  & =\\frac{1}{3}⟨2s,\\,s+6,\\,9-2s⟩.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262826 1068 #edb/ref 17592186262561 13194139533399 17592186045585 true] [17592186262826 1069 "q-127742" 13194139533399 17592186045585 true] [17592186262826 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262826 1071 "Calculate ${B}^{-1}$, where \n$B=[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}].$" 13194139533399 17592186045585 true] [17592186262826 1072 #uuid "f956f6a8-fa50-55df-aecf-a4883333e21d" 13194139533399 17592186045585 true] [17592186262826 1074 "Given a $2\\times 2$ matrix\n\n$$\nB=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $B$ can be found using the following formula:\n\n$$\n\\begin{aligned}{B}^{-1} & =\\frac{1}{det(B)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(B)=2\\cdot 0-1\\cdot 1=-1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{B}^{-1} & =\\frac{1}{det(B)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{(-1)}[\\begin{aligned}0 & -1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}B{B}^{-1} & =[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {B}^{-1}B & =[\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262827 1068 #edb/ref 17592186262366 13194139533399 17592186045585 true] [17592186262827 1069 "q-127744" 13194139533399 17592186045585 true] [17592186262827 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262827 1071 "Calculate ${C}^{-1}$, where\n$C=[\\begin{aligned}3 & 3 \\\\ 1 & 0\\end{aligned}].$" 13194139533399 17592186045585 true] [17592186262827 1072 #uuid "298737fa-66e8-531a-9405-d90ed3d1ecd2" 13194139533399 17592186045585 true] [17592186262827 1074 "Given a $2\\times 2$ matrix\n\n$$\nC=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $C$ can be found using the following formula:\n\n$$\n\\begin{aligned}{C}^{-1} & =\\frac{1}{det(C)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(C)=3\\cdot 0-1\\cdot 3=-3\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{C}^{-1} & =\\frac{1}{det(C)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{(-3)}[\\begin{aligned}0 & -3 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}0 & 3 \\\\ 1 & -3\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}C{C}^{-1} & =[\\begin{aligned}3 & 3 \\\\ 1 & 0\\end{aligned}]\\cdot \\frac{1}{3}[\\begin{aligned}0 & 3 \\\\ 1 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {C}^{-1}C & =\\frac{1}{3}[\\begin{aligned}0 & 3 \\\\ 1 & -3\\end{aligned}][\\begin{aligned}3 & 3 \\\\ 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262828 1068 #edb/ref 17592186262530 13194139533399 17592186045585 true] [17592186262828 1069 "q-127751" 13194139533399 17592186045585 true] [17592186262828 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262828 1071 "Which of the matrices below are singular?\n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,C=[\\begin{aligned}-2 & 3 \\\\ -3 & 5\\end{aligned}].\n$$" 13194139533399 17592186045585 true] [17592186262828 1072 #uuid "9987fa7a-d96a-5001-a5b8-b5e558e85078" 13194139533399 17592186045585 true] [17592186262828 1074 "- For the matrix $A$, we have\n\n$$\ndet(A)=(-1)\\cdot 0-1\\cdot 0=0.\n$$\n\nBecause $det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $2\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=(-2)\\cdot 5-(-3)\\cdot (3)=-1.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular." 13194139533399 17592186045585 true] [17592186262829 1068 #edb/ref 17592186262492 13194139533399 17592186045585 true] [17592186262829 1069 "q-127755" 13194139533399 17592186045585 true] [17592186262829 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262829 1071 "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}1 & 0\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 1 \\\\ 2 & 2\\end{aligned}].\n$$" 13194139533399 17592186045585 true] [17592186262829 1072 #uuid "2e8059f3-ef63-587d-911b-0d0c0a784873" 13194139533399 17592186045585 true] [17592186262829 1074 "- The matrix $A$ is a $1\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=0\\cdot 0-(-1)\\cdot 1=1.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 2-2\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse." 13194139533399 17592186045585 true] [17592186262830 1068 #edb/ref 17592186262147 13194139533399 17592186045585 true] [17592186262830 1069 "q-127757" 13194139533399 17592186045585 true] [17592186262830 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262830 1071 "Which of the matrices below are singular?\n\n$$\nS=[\\begin{aligned}1 & 0 \\\\ -1 & -1\\end{aligned}],\\,T=[\\begin{aligned}2 & -3 \\\\ 4 & -6\\end{aligned}],\\,U=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" 13194139533399 17592186045585 true] [17592186262830 1072 #uuid "87b20497-ceac-5d64-8634-616821707ef5" 13194139533399 17592186045585 true] [17592186262830 1074 "- For the matrix $S$, we have\n\n$$\ndet(S)=1\\cdot (-1)-(-1)\\cdot 0=-1.\n$$\n\nBecause $det(S)\\ne 0,$ we conclude that $S$ is invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot (-6)-4\\cdot (-3)=0.\n$$\n\nBecause $det(T)=0,$ we conclude that $T$ is not invertible. Since $T$ is a square matrix that is not invertible, we also say that $T$ is singular.\n\n- For the matrix $U$, we have\n\n$$\ndet(U)=0\\cdot 0-1\\cdot (-1)=1.\n$$\n\nBecause $det(U)\\ne 0,$ we conclude that $U$ is invertible.\n\nTherefore, only $T$ is singular." 13194139533399 17592186045585 true] [17592186262831 1068 #edb/ref 17592186262227 13194139533399 17592186045585 true] [17592186262831 1069 "q-127762" 13194139533399 17592186045585 true] [17592186262831 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262831 1071 "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}1 & 5 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}4 & 3 \\\\ -2 & -1\\end{aligned}],\\,C=[\\begin{aligned}4 & 12 \\\\ 3 & 9\\end{aligned}].\n$$" 13194139533399 17592186045585 true] [17592186262831 1072 #uuid "c7dc44ce-440a-5f50-b6a8-db3db16e9582" 13194139533399 17592186045585 true] [17592186262831 1074 "- The matrix $A$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=4\\cdot (-1)-(-2)\\cdot 3=2.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=4\\cdot 9-3\\cdot 12=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse." 13194139533399 17592186045585 true] [17592186262832 1068 #edb/ref 17592186262150 13194139533399 17592186045585 true] [17592186262832 1069 "q-127821" 13194139533399 17592186045585 true] [17592186262832 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262832 1071 "Which of the matrices below are singular?\n\n$$\nA=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}],\\,B=[\\begin{aligned}-3 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 \\\\ 7 & 5\\end{aligned}].\n$$" 13194139533399 17592186045585 true] [17592186262832 1072 #uuid "7be51f92-4cc3-51a8-b911-c18f52c55601" 13194139533399 17592186045585 true] [17592186262832 1074 "- For the matrix $A$, we have\n\n$$\ndet(A)=-2\\cdot (-3)-1\\cdot 6=0.\n$$\n\nBecause $det(A)=0,$ we conclude that $A$ is not invertible. Since $A$ is a square matrix that is not invertible, we also say that $A$ is singular.\n\n- The matrix $B$ is a $1\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 5-7\\cdot 0=5.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ is singular." 13194139533399 17592186045585 true] [17592186262833 1068 #edb/ref 17592186262423 13194139533399 17592186045585 true] [17592186262833 1069 "q-127834" 13194139533399 17592186045585 true] [17592186262833 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262833 1071 "The vector $a$ has magnitude $2$, the vector $b$ has magnitude $9$, the angle between $a$ and $b$ is ${45}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$" 13194139533399 17592186045585 true] [17592186262833 1072 #uuid "536caa73-ea8f-5d84-a997-afc4e7d9c694" 13194139533399 17592186045585 true] [17592186262833 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =2\\cdot 9\\cdot \\operatorname{sin}⁡{45}^{∘}\\cdot n \\\\  & =18\\cdot \\frac{\\sqrt{2}}{2}\\cdot n \\\\  & =9\\sqrt{2}n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262834 1068 #edb/ref 17592186262359 13194139533399 17592186045585 true] [17592186262834 1069 "q-127838" 13194139533399 17592186045585 true] [17592186262834 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262834 1071 "The vector $u$ has magnitude $6$, the vector $v$ has magnitude $4$, the angle between $u$ and $v$ is ${30}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$" 13194139533399 17592186045585 true] [17592186262834 1072 #uuid "df9bf4cc-ed2e-5d0a-a887-8bffcc2cbf98" 13194139533399 17592186045585 true] [17592186262834 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =6\\cdot 4\\cdot \\operatorname{sin}⁡{30}^{∘}\\cdot n \\\\  & =24\\cdot \\frac{1}{2}\\cdot n \\\\  & =12n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262835 1068 #edb/ref 17592186262270 13194139533399 17592186045585 true] [17592186262835 1069 "q-127839" 13194139533399 17592186045585 true] [17592186262835 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262835 1071 "The vector $a$ has magnitude $7$, the vector $b$ has magnitude $2$, the angle between $a$ and $b$ is ${135}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$" 13194139533399 17592186045585 true] [17592186262835 1072 #uuid "e3bc2525-e0ae-57a6-836d-7bcf12539585" 13194139533399 17592186045585 true] [17592186262835 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =7\\cdot 2\\cdot \\operatorname{sin}⁡{135}^{∘}\\cdot n \\\\  & =14\\cdot \\frac{\\sqrt{2}}{2}\\cdot n \\\\  & =7\\sqrt{2}n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262836 1068 #edb/ref 17592186262240 13194139533399 17592186045585 true] [17592186262836 1069 "q-127841" 13194139533399 17592186045585 true] [17592186262836 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262836 1071 "The vector $u$ has magnitude $5$, the vector $v$ has magnitude $3,$ the angle between $u$ and $v$ is ${90}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$" 13194139533399 17592186045585 true] [17592186262836 1072 #uuid "bf6a3fd8-9d4e-5cd0-83c5-0d33a2370f19" 13194139533399 17592186045585 true] [17592186262836 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =5\\cdot 3\\cdot \\operatorname{sin}⁡{90}^{∘}\\cdot n \\\\  & =15\\cdot 1\\cdot n \\\\  & =15n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262837 1068 #edb/ref 17592186262140 13194139533399 17592186045585 true] [17592186262837 1069 "q-127844" 13194139533399 17592186045585 true] [17592186262837 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262837 1071 "The vector $u$ has magnitude $1$, the vector $v$ has magnitude $11,$ the angle between $u$ and $v$ is ${27}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to the nearest integer where appropriate." 13194139533399 17592186045585 true] [17592186262837 1072 #uuid "2612da3a-65ce-5b2d-b9c0-e7b20ab8fe68" 13194139533399 17592186045585 true] [17592186262837 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =1\\cdot 11\\cdot \\operatorname{sin}⁡{27}^{∘}\\cdot n \\\\  & =11\\cdot (0.453\\,99…)\\cdot n \\\\  & =(4.993\\,89…)\\cdot n \\\\  & ≈5n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262838 1068 #edb/ref 17592186262243 13194139533399 17592186045585 true] [17592186262838 1069 "q-127846" 13194139533399 17592186045585 true] [17592186262838 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262838 1071 "The vector $a$ has magnitude $3$, the vector $b$ has magnitude $15,$ the angle between $a$ and $b$ is ${40}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$ Round your final answer to one decimal place where appropriate." 13194139533399 17592186045585 true] [17592186262838 1072 #uuid "c82f8a89-f925-5da0-abbf-d7bdbd694605" 13194139533399 17592186045585 true] [17592186262838 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =3\\cdot 15\\cdot \\operatorname{sin}⁡{40}^{∘}\\cdot n \\\\  & =45\\cdot (0.642\\,78…)\\cdot n \\\\  & =(28.925\\,44…)\\cdot n \\\\  & ≈28.9n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262839 1068 #edb/ref 17592186262206 13194139533399 17592186045585 true] [17592186262839 1069 "q-127849" 13194139533399 17592186045585 true] [17592186262839 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262839 1071 "The vector $u$ has magnitude $7$, the vector $v$ has magnitude $7,$ the angle between $u$ and $v$ is ${117}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to one decimal place where appropriate." 13194139533399 17592186045585 true] [17592186262839 1072 #uuid "dec81709-4d57-533e-9540-a3bae9092291" 13194139533399 17592186045585 true] [17592186262839 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =7\\cdot 7\\cdot \\operatorname{sin}⁡{117}^{∘}\\cdot n \\\\  & =49\\cdot (0.891\\,00…)\\cdot n \\\\  & =(43.659\\,31…)\\cdot n \\\\  & ≈43.7n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262840 1068 #edb/ref 17592186262488 13194139533399 17592186045585 true] [17592186262840 1069 "q-127852" 13194139533399 17592186045585 true] [17592186262840 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262840 1071 "The vector $u$ has magnitude $5$, the vector $v$ has magnitude $4,$ the angle between $u$ and $v$ is ${160}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to one decimal place where appropriate." 13194139533399 17592186045585 true] [17592186262840 1072 #uuid "8871f8bf-8906-54f0-b023-954154ec26c2" 13194139533399 17592186045585 true] [17592186262840 1074 "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =5\\cdot 4\\cdot \\operatorname{sin}⁡{160}^{∘}\\cdot n \\\\  & =20\\cdot (0.342\\,02…)\\cdot n \\\\  & =(6.840\\,40…)\\cdot n \\\\  & ≈6.8n.\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262841 1068 #edb/ref 17592186262552 13194139533399 17592186045585 true] [17592186262841 1069 "q-127861" 13194139533399 17592186045585 true] [17592186262841 1070 #edb/ref 17592186045486 13194139533399 17592186045585 true] [17592186262841 1071 "Find $(3b-c)\\times (9a-2b)$, if $a\\times b=⟨0,0,1⟩$, $a\\times c=⟨0,-1,3⟩$ and $c\\times b=⟨0,2,0⟩.$" 13194139533399 17592186045585 true] [17592186262841 1072 #uuid "afcc8d33-fe9b-5c65-a7f2-97b6d0a1032f" 13194139533399 17592186045585 true] [17592186262841 1074 "First, recall that:\n\n- The cross product distributes over addition/subtraction:\n\n$$\n\\begin{aligned}(a\\pm b)\\times c & =a\\times c\\pm b\\times c \\\\ c\\times (a\\pm b) & =c\\times a\\pm c\\times b\\end{aligned}\n$$\n\n- The cross product is associative with respect to scalar multiplication:\n\n$$\n\\begin{aligned}(\\lambda a)\\times b & =\\lambda (a\\times b) \\\\ a\\times (\\lambda b) & =\\lambda (a\\times b)\\end{aligned}\n$$\n\n- The cross product of parallel vectors equals the zero vector. In particular,\n\n$$\na\\times a=0.\n$$\n\n- The cross product is anticommutative:\n\n$$\n\\begin{aligned}a\\times b & =-b\\times a\\end{aligned}\n$$\n\nWith that in mind, let's evaluate our expression:\n\n- First, we use the distributive property:\n\n$$\n\\begin{aligned}(3b-c)\\times (9a-2b) & = \\\\ ((3b)\\times (9a))-((3b)\\times (2b))-(c\\times (9a))+(c\\times (2b))\\end{aligned}\n$$\n\n- Next, we factor out the scalars:\n\n$$\n\\begin{aligned}(3b-c)\\times (9a-2b) & = \\\\ ((3b)\\times (9a))-((3b)\\times (2b))-(c\\times (9a))+(c\\times (2b)) & = \\\\ (3\\cdot 9)(b\\times a)-(3\\cdot 2)(b\\times b)-9(c\\times a)+2(c\\times b) & = \\\\ 27(b\\times a)-6(b\\times b)-9(c\\times a)+2(c\\times b)\\end{aligned}\n$$\n\n- Then, we use anticommutativity, and the fact that $b\\times b=0:$\n\n$$\n\\begin{aligned}27(b\\times a)-6(b\\times b)-9(c\\times a)+2(c\\times b) & = \\\\ -27(a\\times b)-6(0)+9(a\\times c)+2(c\\times b) & = \\\\ -27(a\\times b)+9(a\\times c)+2(c\\times b)\\end{aligned}\n$$\n\n- Finally, we substitute the given values and simplify:\n\n$$\n\\begin{aligned}-27(a\\times b)+9(a\\times c)+2(c\\times b) & = \\\\ -27⟨0,0,1⟩+9⟨0,-1,3⟩+2⟨0,2,0⟩ & = \\\\ ⟨0,0,-27⟩+⟨0,-9,27⟩+⟨0,4,0⟩ & = \\\\ ⟨0,-5,0⟩\\end{aligned}\n$$" 13194139533399 17592186045585 true] [17592186262842 1068 #edb/ref 17592186262309 13194139533399 17592186045585 true] [17592186262842 1069 "q-127866" 13194139533399 17592186045585 true] [17592186262842 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262842 1071 "Calculate the area of the $△\\,ABC,$ if $A(5,0,5),$ $B(6,-1,4),$ $C(9,1,0).$" 13194139533399 17592186045585 true] [17592186262842 1072 #uuid "6f81e690-5559-586b-a65b-10e4fedf8848" 13194139533399 17592186045585 true] [17592186262842 1074 "First, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(6i-j+4k)-(5i+5k) \\\\  & =i-j-k \\\\  & =⟨1,-1,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(9i+j)-(5i+5k) \\\\  & =4i+j-5k \\\\  & =⟨4,1,-5⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =|\\begin{aligned}i & j & k \\\\ 1 & -1 & -1 \\\\ 4 & 1 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ 1 & -5\\end{aligned}|i-|\\begin{aligned}1 & -1 \\\\ 4 & -5\\end{aligned}|j+|\\begin{aligned}1 & -1 \\\\ 4 & 1\\end{aligned}|k \\\\  & =((-1)\\cdot (-5)-1\\cdot (-1))i-(1\\cdot (-5)-4\\cdot (-1))j+(1\\cdot 1-4\\cdot (-1))k \\\\  & =6i+j+5k \\\\  & =⟨6,1,5⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{6}^{2}+{1}^{2}+{5}^{2}} \\\\  & =\\sqrt{62}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{62}}{2}.\n$$" 13194139533399 17592186045585 true] [17592186262843 1068 #edb/ref 17592186262244 13194139533399 17592186045585 true] [17592186262843 1069 "q-127873" 13194139533399 17592186045585 true] [17592186262843 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262843 1071 "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨-3,1,-2⟩=7.$ What is the value of $\\frac{b}{c}?$" 13194139533399 17592186045585 true] [17592186262843 1072 #uuid "1e0d1c80-eb5c-5bda-b21b-a06adaec16d2" 13194139533399 17592186045585 true] [17592186262843 1074 "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨-3,1,-2⟩=7$ of the plane, we get the normal vector $n=⟨-3,1,-2⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨-3,1,-2⟩ & =0 \\\\ -3{t}_{1}+{t}_{2}-2{t}_{3} & =0 \\\\ {t}_{2} & =3{t}_{1}+2{t}_{3}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,3{t}_{1}+2{t}_{3},\\,{t}_{3}⟩,\n$$\n\nwhere ${t}_{1},{t}_{3}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{3}\\ne 0.$ For example, setting ${t}_{3}=1$, we get\n\n$$\nv=⟨0,\\,2,\\,1⟩.\n$$\n\nTherefore, $\\frac{b}{c}=2.$" 13194139533399 17592186045585 true] [17592186262844 1068 #edb/ref 17592186262412 13194139533399 17592186045585 true] [17592186262844 1069 "q-127888" 13194139533399 17592186045585 true] [17592186262844 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262844 1071 "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}.$ What is the value of $\\frac{b}{c}?$" 13194139533399 17592186045585 true] [17592186262844 1072 #uuid "1298261d-fd1d-57fd-8c0d-689d1739fab9" 13194139533399 17592186045585 true] [17592186262844 1074 "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}$ of the plane, we get the normal vector $n=⟨3,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,2,-1⟩ & =0 \\\\ 3{t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & =3{t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,3{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$" 13194139533399 17592186045585 true] [17592186262845 1068 #edb/ref 17592186262515 13194139533399 17592186045585 true] [17592186262845 1069 "q-127899" 13194139533399 17592186045585 true] [17592186262845 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262845 1071 "If $A=[\\begin{aligned}k-1 & k-1 \\\\ 3 & -1\\end{aligned}]$ is a singular matrix, calculate the value of $k.$" 13194139533399 17592186045585 true] [17592186262845 1072 #uuid "524e74d6-0355-574f-af8e-7809bad3676c" 13194139533399 17592186045585 true] [17592186262845 1074 "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =(k-1)\\cdot (-1)-(k-1)\\cdot 3 \\\\  & =-k+1-3k+3 \\\\  & =-4k+4\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}-4k+4 & =0 \\\\ k & =1\\end{aligned}\n$$\n\nTherefore, the value of $k$ is $k=1.$" 13194139533399 17592186045585 true] [17592186262846 1068 #edb/ref 17592186262385 13194139533399 17592186045585 true] [17592186262846 1069 "q-127900" 13194139533399 17592186045585 true] [17592186262846 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262846 1071 "If $A=[\\begin{aligned}k & 3 \\\\ 27 & k\\end{aligned}]$ is a singular matrix, calculate the value(s) of $k.$" 13194139533399 17592186045585 true] [17592186262846 1072 #uuid "49be873f-6aae-5fe9-b9e9-08cc0609f50a" 13194139533399 17592186045585 true] [17592186262846 1074 "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =k\\cdot k-27\\cdot 3 \\\\  & ={k}^{2}-81.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $k:$\n\n$$\n\\begin{aligned}{k}^{2}-81 & =0 \\\\ {k}^{2} & =81 \\\\ k & =\\pm 9\\end{aligned}\n$$\n\nTherefore, the values of $k$ are $k=\\pm 9.$" 13194139533399 17592186045585 true] [17592186262847 1068 #edb/ref 17592186262459 13194139533399 17592186045585 true] [17592186262847 1069 "q-127901" 13194139533399 17592186045585 true] [17592186262847 1070 #edb/ref 17592186045487 13194139533399 17592186045585 true] [17592186262847 1071 "If $A=[\\begin{aligned}48 & a \\\\ a & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $a.$" 13194139533399 17592186045585 true] [17592186262847 1072 #uuid "54a4b93b-d93e-5ce6-98ac-7b0ed79d28ef" 13194139533399 17592186045585 true] [17592186262847 1074 "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =48\\cdot 3-a\\cdot a \\\\  & =144-{a}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $a:$\n\n$$\n\\begin{aligned}144-{a}^{2} & =0 \\\\ {a}^{2} & =144 \\\\ a & =\\pm 12\\end{aligned}\n$$\n\nTherefore, the values of $a$ are $a=\\pm 12.$" 13194139533399 17592186045585 true] [17592186262848 1068 #edb/ref 17592186262494 13194139533399 17592186045585 true] [17592186262848 1069 "q-127903" 13194139533399 17592186045585 true] [17592186262848 1070 #edb/ref 17592186045485 13194139533399 17592186045585 true] [17592186262848 1071 "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" 13194139533399 17592186045585 true] [17592186262848 