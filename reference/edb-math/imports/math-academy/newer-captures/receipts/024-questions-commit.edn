533407 17592186045585 false] [17592186198775 1071 "Which set is equivalent to $A={k\\in Z:{k}^{2}+1\\le 5}?$" 13194139533407 17592186045585 true] [17592186198775 1074 "The elements of the given set are the integers that satisfy the inequality ${k}^{2}+1\\le 5.$ \n\nSo, we first need to solve our inequality for $k:$\n\n$$\n\\begin{aligned}{k}^{2}+1 & \\le 5 \\\\ {k}^{2} & \\le 4 \\\\ \\sqrt{{k}^{2}} & \\le \\sqrt{4} \\\\ |k| & \\le 2 \\\\ -2\\le k & \\le 2\\end{aligned}\n$$\n\nThe integer solutions of the inequality above are $0,\\pm 1,\\pm 2.$ Therefore, the given set can be written as \n\n$$\nA={0,\\pm 1,\\pm 2}.\n$$" 13194139533407 17592186045585 true] [17592186198776 1068 #edb/ref 17592186195306 13194139533407 17592186045585 false] [17592186198776 1068 #edb/ref 17592186287219 13194139533407 17592186045585 true] [17592186198776 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198776 1071 "Which set is equivalent to $A = {x ∈ R: \\mid 2x + 5|= 13}$?" 13194139533407 17592186045585 false] [17592186198776 1071 "Which set is equivalent to $A={x\\in R:|2x+5|=13}?$" 13194139533407 17592186045585 true] [17592186198776 1074 "The elements of the given set are the real numbers that satisfy the equation $|2x+5|=13.$ So, we first need to solve for $x:$\n\n$$\n\\begin{aligned}|2x+5| & =13 \\\\ 2x+5 & =\\pm 13 \\\\ 2x & =-5\\pm 13 \\\\ x & =\\frac{-5\\pm 13}{2} \\\\ x & =-9,4\\end{aligned}\n$$\n\nThe solutions are $x=-9$ and $x=4,$ and both of these solutions are real numbers.\n\nTherefore, we can write the given set as\n\n$$\nA={-9,4}.\n$$" 13194139533407 17592186045585 true] [17592186198779 1068 #edb/ref 17592186195345 13194139533407 17592186045585 false] [17592186198779 1068 #edb/ref 17592186287181 13194139533407 17592186045585 true] [17592186198779 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198779 1071 "Which set is equivalent to $A = {x ∈ Q: \\sin (2πx) = 0}$?" 13194139533407 17592186045585 false] [17592186198779 1071 "Which set is equivalent to $A={x\\in Q\\,:\\,\\operatorname{sin}⁡(2\\pi x)=0}?$" 13194139533407 17592186045585 true] [17592186198779 1074 "Notice that the solutions to the equation\n\n$$\n\\operatorname{sin}⁡(2\\pi x)=0\n$$\n\n are given by\n\n$$\n\\begin{aligned}2\\pi x & =n\\pi  \\\\ 2x & =n \\\\ x & =\\frac{n}{2}\\end{aligned}\n$$\n\nwhere $n\\in Z.$ \n\nSubstituting different values of $n,$ we see that the solutions are\n\n$$\nx=0,\\,\\pm \\frac{1}{2},\\,\\pm 1,\\,\\pm \\frac{3}{2},\\,…\n$$\n\nTherefore, our set $A$ is equivalent to \n\n$$\nA={0,\\,\\pm \\frac{1}{2},\\,\\pm 1,\\,\\pm \\frac{3}{2},\\,…}.\n$$" 13194139533407 17592186045585 true] [17592186198780 1068 #edb/ref 17592186195351 13194139533407 17592186045585 false] [17592186198780 1068 #edb/ref 17592186195356 13194139533407 17592186045585 false] [17592186198780 1068 #edb/ref 17592186287161 13194139533407 17592186045585 true] [17592186198780 1068 #edb/ref 17592186287352 13194139533407 17592186045585 true] [17592186198780 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198780 1071 "![](images/5c/5c4ffbb64a754df9a6100fda3fd6eaf4a68f28ac59de4dfb716c2c8b1f2847ab.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,{x}^{2}}\n$$" 13194139533407 17592186045585 true] [17592186198780 1071 "![](images/5c/5c4ffbb64a754df9a6100fda3fd6eaf4a68f28ac59de4dfb716c2c8b1f2847ab.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n$R$ {{field-1}} {{field-2}}" 13194139533407 17592186045585 false] [17592186198780 1074 "The points in our set include all those that lie *below* the curve $y={x}^{2}.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<{x}^{2}\n$$\n\nWe must also include the curve $y={x}^{2}$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\le {x}^{2}\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\le {x}^{2}}.\n$$" 13194139533407 17592186045585 true] [17592186198782 1068 #edb/ref 17592186195368 13194139533407 17592186045585 false] [17592186198782 1068 #edb/ref 17592186287565 13194139533407 17592186045585 true] [17592186198782 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198782 1071 "Which set is equivalent to $A = {x ∈ R: \\cos (2x) = 1}$?" 13194139533407 17592186045585 false] [17592186198782 1071 "Which set is equivalent to $A={x\\in R:\\operatorname{cos}⁡(2x)=1}?$" 13194139533407 17592186045585 true] [17592186198782 1074 "Notice that the solutions to the equation\n\n$$\n\\operatorname{cos}⁡(2x)=1\n$$\n\n are given by\n\n$$\n\\begin{aligned}2x & =2n\\pi  \\\\ x & =n\\pi \\end{aligned}\n$$\n\nwhere $n\\in Z.$ \n\nSubstituting different values of $n,$ we see that the solutions are\n\n$$\nx=0,\\,\\pm \\pi ,\\,\\pm 2\\pi ,\\,\\pm 3\\pi ,\\,…\n$$\n\nTherefore, our set $A$ is equivalent to \n\n$$\nA={0,\\pm \\pi ,\\pm 2\\pi ,\\pm 3\\pi ,…}.\n$$" 13194139533407 17592186045585 true] [17592186198783 1068 #edb/ref 17592186195374 13194139533407 17592186045585 false] [17592186198783 1068 #edb/ref 17592186195380 13194139533407 17592186045585 false] [17592186198783 1068 #edb/ref 17592186287167 13194139533407 17592186045585 true] [17592186198783 1068 #edb/ref 17592186287600 13194139533407 17592186045585 true] [17592186198783 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198783 1071 "![](images/f0/f00499aad7b915267fe99bde8c13665a325cf6409e2e856466e9cdc90e4a8b8a.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,2x-3}\n$$" 13194139533407 17592186045585 true] [17592186198783 1071 "![](images/f0/f00499aad7b915267fe99bde8c13665a325cf6409e2e856466e9cdc90e4a8b8a.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$R$ {{field-1}} {{field-2}}" 13194139533407 17592186045585 false] [17592186198783 1074 "The points in our set include all those that lie *below* the line $y=2x-3.$\n\nTherefore, a point $P(x,y)$ lies *inside* the shaded region if the following condition is satisfied:\n\n$$\ny<2x-3\n$$\n\nWe must also include the line $y=2x-3$ since the boundary is included in the set (the curve is solid). So, we change the inequality symbol above as follows:\n\n$$\ny\\le 2x-3\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\le 2x-3}.\n$$" 13194139533407 17592186045585 true] [17592186198785 1068 #edb/ref 17592186195391 13194139533407 17592186045585 false] [17592186198785 1068 #edb/ref 17592186287480 13194139533407 17592186045585 true] [17592186198785 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198785 1071 "Which of the following is a representation of the set $S = N \\cdot N$ in the Cartesian plane?" 13194139533407 17592186045585 false] [17592186198785 1071 "Which of the following is a representation of the set $S=N\\times N$ in the Cartesian plane?" 13194139533407 17592186045585 true] [17592186198785 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS=N\\times N\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is a natural number and whose $y$-coordinate is a natural number.\n\n$$\nS={(x,y)\\,:\\,x\\in N,\\,y\\in N}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate equals $1$ and whose $y$-coordinate is any natural number.\n\n$$\n{S}_{1}={(1,y)\\,:\\,y\\in N}.\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/34/34f779801b1bb52d5834ab4e04c91d92585af9876f5ea687ad59cb6931e0144c.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate equals $2$ and whose $y$-coordinate is any natural number.\n\n$$\n{S}_{2}={(2,y)\\,:\\,y\\in N}.\n$$\n\nWe can represent ${S}_{2}$ in the plane as follows:\n\n![](images/38/387709ae58ce7716338785f82e9159ce8570b046518554edd820c3ed31a23c53.png)\n\nWe can create the subsets ${S}_{3},{S}_{4},{S}_{5},…$ similarly. Our Cartesian product $S$ is the *union* of these subsets:\n\n$$\n\\begin{aligned}S & ={S}_{1}\\cup {S}_{2}\\cup {S}_{3}\\cup … \\\\  & ={⋃}_{i\\in N}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $N\\times N$ as the set of points in the diagram below.\n\n![](images/14/141d0b84041957cf8415db4673c999f5213ff23553e57ab7e0e9120e648f306c.png)" 13194139533407 17592186045585 true] [17592186198790 1068 #edb/ref 17592186195438 13194139533407 17592186045585 false] [17592186198790 1068 #edb/ref 17592186287666 13194139533407 17592186045585 true] [17592186198790 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198790 1071 "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,{n}^{2}-5n+6>0}$\n- $B={m\\in Z\\,:\\,{m}^{2}-5m+6<0}$\n- $C={q\\in Q\\,:\\,{q}^{2}-5q+6<0}$" 13194139533407 17592186045585 true] [17592186198790 1071 "Which of the following sets are infinite?\n\n1. $A = {n ∈ Z: n^{2} - 5n + 6 > 0}$\n2. $B = {m ∈ Z: m^{2} - 5m + 6 < 0}$\n3. $C = {q ∈ Q: q^{2} - 5q + 6 < 0}$" 13194139533407 17592186045585 false] [17592186198790 1074 "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y={x}^{2}-5x+6$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}{x}^{2}-5x+6 & =0 \\\\ (x-2)(x-3) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=2$ and $x=3,$ and we can graph the parabola as follows:\n\n![](images/0a/0a42815f626652c332862a38a3812463a9407605329bd81df25f11274b26ce6f.png)\n\nTherefore:\n\n- The solution to the inequality ${x}^{2}-5x+6>0$ for $x\\in R$ is \n\n$$\nx<2\\,\\text{or}\\,x>3\n$$\n\nand can be expressed as $x\\in {I}_{1}=(-\\infty ,2)\\cup (3,\\infty ).$\n\n- Similarly, the solution to the inequality ${x}^{2}-5x+6<0$ for $x\\in R$ is \n\n$$\n2<x<3\n$$\n\nand can be expressed as $x\\in {I}_{2}=(2,3).$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is infinite. If $n\\in Z,$ the solutions to the inequality ${n}^{2}-5n+6>0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={…,0,1}\\cup {4,5,…}.\n$$\n\n- The set $B$ is finite. If $m\\in Z,$ the solutions to the inequality ${m}^{2}-5m+6<0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={}.\n$$\n\nConsequently, $|B|=0,$ which is finite.\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to ${q}^{2}-5q+6<0$ are all the rational numbers that lie in the interval ${I}_{2}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A$ and $C$ only.\"" 13194139533407 17592186045585 true] [17592186198792 1068 #edb/ref 17592186195450 13194139533407 17592186045585 false] [17592186198792 1068 #edb/ref 17592186287628 13194139533407 17592186045585 true] [17592186198792 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198792 1071 "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,\\operatorname{sin}⁡(2n\\pi )=1}$\n- $B={q\\in Q\\,:\\,\\operatorname{sin}⁡(2q\\pi )=1}$\n- $C={x\\in R\\,:\\,\\operatorname{sin}⁡(2x\\pi )=1}$" 13194139533407 17592186045585 true] [17592186198792 1071 "Which of the following sets are infinite?\n\n1. $A = {n ∈ Z: \\sin (2nπ) = 1}$\n2. $B = {q ∈ Q: \\sin (2qπ) = 1}$\n3. $C = {x ∈ R: \\sin (2xπ) = 1}$" 13194139533407 17592186045585 false] [17592186198792 1074 "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nWe start by finding the solutions to the equation $\\operatorname{sin}⁡(2x\\pi )=1$ for $x\\in R:$\n\n$$\n\\begin{aligned}2x\\pi  & =\\frac{\\pi }{2}+2m\\pi  \\\\ x & =\\frac{1}{4}+m,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. There are no values of $m\\in Z$ such that $\\frac{1}{4}+m\\in Z.$ Therefore,\n\n$$\nA={}.\n$$\n\nConsequently, $|A|=0,$ which is finite.\n\n- The set $B$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nB={…,-\\frac{3}{4},\\frac{1}{4},\\frac{5}{4},\\frac{9}{4},…}.\n$$\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\"" 13194139533407 17592186045585 true] [17592186198793 1068 #edb/ref 17592186195456 13194139533407 17592186045585 false] [17592186198793 1068 #edb/ref 17592186287629 13194139533407 17592186045585 true] [17592186198793 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198793 1071 "Which of the following sets are infinite?\n\n- $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({x}^{2})\\,:\\,n\\in {N}_{0}}$\n- $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{ln}⁡x)\\,:\\,n\\in {N}_{0}}$\n- $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\sqrt{x})\\,:\\,n\\in {N}_{0}}$" 13194139533407 17592186045585 true] [17592186198793 1071 "Which of the following sets are infinite?\n\n1. $A = {f^{(n)}(x) = \\frac{d^{n}}{dx^{n}}(x^{2}): n ∈ N_{0}}$\n2. $B = {g^{(n)}(x) = \\frac{d^{n}}{dx^{n}}(\\ln x): n ∈ N_{0}}$\n3. $C = {h^{(n)}(x) = \\frac{d^{n}}{dx^{n}}(\\sqrt{x}): n ∈ N_{0}}$" 13194139533407 17592186045585 false] [17592186198793 1074 "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\n- The set $A$ is finite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & ={x}^{2} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})=2x \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x)=2 \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(2)=0 \\\\ {f}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(0)=0 \\\\  & ⋮\\end{aligned}\n$$\n\nThus, for $n>3,$ we have ${f}^{(n)}(x)=0.$ Listing a few elements of our set, we have the following:\n\n$$\nA={{x}^{2},2x,2,0}.\n$$\n\nConsequently, $|A|=4,$ which is finite.\n\n- The set $B$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =\\operatorname{ln}⁡x=\\operatorname{ln}⁡x \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)=\\frac{1}{x} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})=-\\frac{1}{{x}^{2}} \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{{x}^{2}})=\\frac{2}{{x}^{3}} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={\\operatorname{ln}⁡x,\\frac{1}{x},-\\frac{1}{{x}^{2}},-\\frac{2}{{x}^{3}},…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is infinite. Similar to the previous case, listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =\\sqrt{x} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})=\\frac{1}{2\\sqrt{x}} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2\\sqrt{x}})=-\\frac{1}{4\\sqrt{{x}^{3}}} \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{4\\sqrt{{x}^{3}}})=\\frac{3}{8\\sqrt{{x}^{5}}} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={\\sqrt{x},\\frac{1}{2\\sqrt{x}},-\\frac{1}{4\\sqrt{{x}^{3}}},\\frac{3}{8\\sqrt{{x}^{5}}},…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\"" 13194139533407 17592186045585 true] [17592186198794 1068 #edb/ref 17592186195462 13194139533407 17592186045585 false] [17592186198794 1068 #edb/ref 17592186195468 13194139533407 17592186045585 false] [17592186198794 1068 #edb/ref 17592186195474 13194139533407 17592186045585 false] [17592186198794 1068 #edb/ref 17592186287171 13194139533407 17592186045585 true] [17592186198794 1068 #edb/ref 17592186287492 13194139533407 17592186045585 true] [17592186198794 1068 #edb/ref 17592186287567 13194139533407 17592186045585 true] [17592186198794 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198794 1071 "![](images/83/83ebd6f5d742a869b267a0cead4a9a94ae17fa534ca3e1cfddbb495c67390ecf.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,-x\\,{{field-2}}\\,y\\,{{field-3}}\\,2}\n$$" 13194139533407 17592186045585 true] [17592186198794 1071 "![](images/da/da42d49074b3b9b16b4ab49dfaa36f5d240ba1a69056169213f8f51a5b84900d.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$R$ {{field-1}} {{field-2}} {{field-3}}" 13194139533407 17592186045585 false] [17592186198794 1074 "The points in our set include all those that lie *above* the line $y=-x$ and *below* the line $y=2.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>-x,\\,y<2.\n$$\n\nCombining this into a single condition, we have\n\n$$\n-x<y<2.\n$$\n\nWe must also include the line $y=-x$ since the boundary is included in the set (the curve is solid). So, we change the corresponding inequality symbol above as follows:\n\n$$\n-x\\le y<2\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,-x\\le y<2}.\n$$" 13194139533407 17592186045585 true] [17592186198795 1068 #edb/ref 17592186195480 13194139533407 17592186045585 false] [17592186198795 1068 #edb/ref 17592186195481 13194139533407 17592186045585 false] [17592186198795 1068 #edb/ref 17592186287350 13194139533407 17592186045585 true] [17592186198795 1068 #edb/ref 17592186287537 13194139533407 17592186045585 true] [17592186198795 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198795 1071 "Find the missing coefficients in the conditional definition of the set ${3,4}$ given below.\n\n${3,4}={n\\in Z\\,:\\,2{n}^{2}\\,-$\n{{field-1}}\n$n\\,+$\n{{field-2}}\n$=0}$" 13194139533407 17592186045585 true] [17592186198795 1071 "Find the missing coefficients in the constructive definition of the set ${3, 4}$ given below.${3, 4} = {n ∈ Z: 2n^{2} -$\n{{field-1}}\n$n +$\n{{field-2}}\n$= 0}$" 13194139533407 17592186045585 false] [17592186198795 1074 "The given set contains the roots $n\\in Z$ of some quadratic polynomial $p(n).$\n\nSince the polynomial has roots ${n}_{1}=3$ and ${n}_{2}=4,$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(n) & =a(n-{n}_{1})(n-{n}_{2}) \\\\  & =2(n-3)(n-4) \\\\  & =2({n}^{2}-7n+12) \\\\  & =2{n}^{2}-14n+24\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n{3,4}={n\\in Z\\,:\\,2{n}^{2}-14n+24=0}\n$$" 13194139533407 17592186045585 true] [17592186198796 1068 #edb/ref 17592186195482 13194139533407 17592186045585 false] [17592186198796 1068 #edb/ref 17592186195483 13194139533407 17592186045585 false] [17592186198796 1068 #edb/ref 17592186195484 13194139533407 17592186045585 false] [17592186198796 1068 #edb/ref 17592186287227 13194139533407 17592186045585 true] [17592186198796 1068 #edb/ref 17592186287290 13194139533407 17592186045585 true] [17592186198796 1068 #edb/ref 17592186287472 13194139533407 17592186045585 true] [17592186198796 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198796 1071 "![](images/fb/fbd778f48199acd5b731e739cb527a990ba28a8d88981d50554d135e853f8815.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:\n\n${(x,y)\\in {R}^{2}\\,:\\,$\n{{field-1}}\n${x}^{2}\\,+\\,$\n{{field-2}}\n${y}^{2}$\n{{field-3}}\n\n$36$\n\n$}$" 13194139533407 17592186045585 true] [17592186198796 1071 "![](images/fb/fbd778f48199acd5b731e739cb527a990ba28a8d88981d50554d135e853f8815.png)\n\nUse set builder notation to describe the shaded region given in the diagram above:${(x, y) ∈ R^{2}$:\n{{field-1}}\n$x^{2} +$\n{{field-2}}\n$y^{2}$\n{{field-3}}\n$36$\n$}$" 13194139533407 17592186045585 false] [17592186198796 1074 "The equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the elliptical boundary of our region has horizontal radius $a=3$ and vertical radius $b=2.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4} & =1,\\end{aligned}\n$$\n\nwhich we can write as\n\n$$\n4{x}^{2}+9{y}^{2}=36.\n$$\n\nWe're interested in describing all points that lie *inside* the ellipse. So, let's pick any point inside the region, say, $(0,0).$ Substituting its coordinates into the equation of the boundary, we obtain\n\n$$\n4(0)^{2}+9(0)^{2}\\,<\\,36.\n$$\n\nAs a result, the points $P(x,y)$ in our region are any real numbers that satisfy the condition\n\n$$\n4{x}^{2}+9{y}^{2}<36.\n$$\n\nNotice that we use $<$ since the boundary is excluded from the set (the boundary curve is dashed).\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,4{x}^{2}+9{y}^{2}<36}.\n$$" 13194139533407 17592186045585 true] [17592186198798 1068 #edb/ref 17592186195491 13194139533407 17592186045585 false] [17592186198798 1068 #edb/ref 17592186287289 13194139533407 17592186045585 true] [17592186198798 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198798 1071 "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,\\operatorname{cos}⁡n=0}$\n- $B={q\\in Q\\,:\\,\\operatorname{cos}⁡q=0}$\n- $C={x\\in R\\,:\\,\\operatorname{cos}⁡x=0}$\n\nHint: The arguments of the trigonometric functions are in radians." 13194139533407 17592186045585 true] [17592186198798 1071 "Which of the following sets are infinite?\n\n1. $A = {n ∈ Z: \\cos n = 0}$\n2. $B = {q ∈ Q: \\cos q = 0}$\n3. $C = {x ∈ R: \\cos x = 0}$\n\nHint: The arguments of the trigonometric functions are in radians." 13194139533407 17592186045585 false] [17592186198798 1074 "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nWe start by writing down the solutions to the equation $\\operatorname{cos}⁡x=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}x=\\frac{\\pi }{2}+m\\pi ,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. There are no values of $m\\in Z$ such that $\\frac{\\pi }{2}+m\\pi \\in Z.$ Therefore,\n\n$$\nA={}.\n$$\n\nConsequently, $|A|=0,$ which is finite.\n\n- The set $B$ is finite. Similar to the above, there are no values of $m\\in Z$ such that $\\frac{\\pi }{2}+m\\pi \\in Q.$ Therefore,\n\n$$\nB={}.\n$$\n\nConsequently, $|B|=0,$ which is finite.\n\n- The set $C$ is infinite. Listing the elements of $C$ for different values of $m,$ we have\n\n$$\nC={…,-\\frac{3\\pi }{2},-\\frac{\\pi }{2},\\frac{\\pi }{2},\\frac{3\\pi }{2},…}.\n$$\n\nTherefore, the correct answer is \"$C$ only.\"" 13194139533407 17592186045585 true] [17592186198799 1068 #edb/ref 17592186195497 13194139533407 17592186045585 false] [17592186198799 1068 #edb/ref 17592186195503 13194139533407 17592186045585 false] [17592186198799 1068 #edb/ref 17592186195509 13194139533407 17592186045585 false] [17592186198799 1068 #edb/ref 17592186287479 13194139533407 17592186045585 true] [17592186198799 1068 #edb/ref 17592186287495 13194139533407 17592186045585 true] [17592186198799 1068 #edb/ref 17592186287511 13194139533407 17592186045585 true] [17592186198799 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198799 1071 "![](images/0f/0f95f6b259237816a5a3da041452cfd9458f0852b1ae717a044738b6f310ab5d.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,3\\,{{field-2}}\\,y\\,{{field-3}}\\,2x+3}\n$$" 13194139533407 17592186045585 true] [17592186198799 1071 "![](images/cd/cdc9f92050a3fa818432204ca8d14aad172313d26caa0805ba4b629989f8b543.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$R$ {{field-1}} {{field-2}} {{field-3}}" 13194139533407 17592186045585 false] [17592186198799 1074 "The points in our set include all those that lie *above* the line $y=3$ and *below* the line $y=2x+3.$\n\nA point $P(x,y)$ lies *inside* the shaded region if the following conditions are satisfied:\n\n$$\ny>3,\\,y<2x+3.\n$$\n\nCombining this into a single condition, we have\n\n$$\n3<y<2x+3.\n$$\n\nWe must also include the lines $y=3$ and $y=2x+3$ since the boundaries are included in the set (the lines are solid). So, we change the corresponding inequality symbols above as follows:\n\n$$\n3\\le y\\le 2x+3\n$$\n\nMoreover, since we're considering *every* real value in this region, $x\\in R,y\\in R,$ and therefore \n\n$$\n(x,y)\\in R\\times R={R}^{2}.\n$$\n\nTherefore, we can write the set as\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,3\\le y\\le 2x+3}.\n$$" 13194139533407 17592186045585 true] [17592186198800 1068 #edb/ref 17592186195515 13194139533407 17592186045585 false] [17592186198800 1068 #edb/ref 17592186195516 13194139533407 17592186045585 false] [17592186198800 1068 #edb/ref 17592186287493 13194139533407 17592186045585 true] [17592186198800 1068 #edb/ref 17592186287615 13194139533407 17592186045585 true] [17592186198800 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198800 1071 "Find the missing coefficients in the conditional definition of the set ${-1,\\frac{1}{3}}$ given below.\n\n${-1,\\frac{1}{3}}={q\\in Q\\,:\\,3{q}^{2}\\,+$\n{{field-1}}\n$q\\,-$\n{{field-2}}\n$=0}$" 13194139533407 17592186045585 true] [17592186198800 1071 "Find the missing coefficients in the constructive definition of the set ${-1, \\frac{1}{3}}$ given below.${-1, \\frac{1}{3}} = {q ∈ Q: 3q^{2} +$\n{{field-1}}\n$q -$\n{{field-2}}\n$= 0}$" 13194139533407 17592186045585 false] [17592186198800 1074 "The given set contains the roots $q\\in Q$ of some quadratic polynomial $p(q).$\n\nSince the quadratic polynomial has roots ${q}_{1}=-1$ and ${q}_{2}=\\frac{1}{3},$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}p(q) & =a(q-{q}_{1})(q-{q}_{2}) \\\\  & =3\\cdot (q-(-1))(q-\\frac{1}{3}) \\\\  & =3(q+1)(q-\\frac{1}{3}) \\\\  & =3({q}^{2}+\\frac{2}{3}q-\\frac{1}{3}) \\\\  & =3{q}^{2}+2q-1\\end{aligned}\n$$\n\nTherefore, we can express the given set as follows:\n\n$$\n{-1,\\frac{1}{3}}={q\\in Q\\,:\\,3{q}^{2}+2q-1=0}\n$$" 13194139533407 17592186045585 true] [17592186198803 1068 #edb/ref 17592186195521 13194139533407 17592186045585 false] [17592186198803 1068 #edb/ref 17592186287553 13194139533407 17592186045585 true] [17592186198803 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198803 1071 "Which of the following sets are infinite?\n\n- $A={n\\in Z\\,:\\,|2n|>5}$\n- $B={q\\in Q\\,:\\,|2q|>5}$\n- $C={x\\in R\\,:\\,|2x|>5}$" 13194139533407 17592186045585 true] [17592186198803 1071 "Which of the following sets are infinite?\n\n1. $A = {n ∈ Z: \\mid 2n \\mid > 5}$\n2. $B = {q ∈ Q: \\mid 2q \\mid > 5}$\n3. $C = {x ∈ R: \\mid 2x \\mid > 5}$" 13194139533407 17592186045585 false] [17592186198803 1074 "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nWe start by solving the following inequality for $x\\in R:$\n\n$$\n\\begin{aligned}|2x|>5 \\\\ 2|x|>5 \\\\ |x|>\\frac{5}{2}\\end{aligned}\n$$\n\nwhich gives\n\n$$\nx<-\\frac{5}{2}\\,\\text{or}\\,x>\\frac{5}{2}\n$$\n\nand can be expressed as $x\\in I=(-\\infty ,-\\frac{5}{2})\\cup (\\frac{5}{2},\\infty ).$ \n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is infinite. If $n\\in Z,$ the solutions to the inequality $|2n|>5$ are all the integers that lie in the interval $I.$ Therefore, \n\n$$\nA={…,-4,-3}\\cup {3,4,…}.\n$$\n\n- The set $B$ is infinite. If $q\\in Q,$ the solutions to $|2q|>5$ are all the rational numbers that lie in the interval $I.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊂C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A,B,$ and $C.$\"" 13194139533407 17592186045585 true] [17592186198808 1068 #edb/ref 17592186195566 13194139533407 17592186045585 false] [17592186198808 1068 #edb/ref 17592186287518 13194139533407 17592186045585 true] [17592186198808 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198808 1071 "Which of the following is a representation of the set $S = {0, 1, 2} \\cdot {-1, 1}$ in the Cartesian plane?" 13194139533407 17592186045585 false] [17592186198808 1071 "Which of the following is a representation of the set $S={0,1,2}\\times {-1,1}$ in the Cartesian plane?" 13194139533407 17592186045585 true] [17592186198808 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, computing ${0,1,2}\\times {-1,1}$ gives the following set:\n\n$$\nS={(0,-1),(0,1),(1,-1),(1,1),(2,-1),(2,1)}.\n$$\n\nOur visualization of this set is shown in the diagram below.\n\n![](images/c5/c5fdae9b803df3873ee7deef4a36678e0d8274dd256fe331360261f1fe6dd492.png)" 13194139533407 17592186045585 true] [17592186198811 1068 #edb/ref 17592186195614 13194139533407 17592186045585 false] [17592186198811 1068 #edb/ref 17592186195621 13194139533407 17592186045585 false] [17592186198811 1068 #edb/ref 17592186287178 13194139533407 17592186045585 true] [17592186198811 1068 #edb/ref 17592186287550 13194139533407 17592186045585 true] [17592186198811 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198811 1071 "![](images/cc/cce16725dddcfc83098ee2323576b8e01bbc3f2625d17cb7e6030826ad9fbcd8.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$$\n{(x,y)\\in {{field-1}}\\,:\\,y\\,{{field-2}}\\,x-1}\n$$" 13194139533407 17592186045585 true] [17592186198811 1071 "![](images/cc/cce16725dddcfc83098ee2323576b8e01bbc3f2625d17cb7e6030826ad9fbcd8.png)\n\nDescribe the shaded region shown above using set-builder notation.\n\n$Z$ {{field-1}} {{field-2}}" 13194139533407 17592186045585 false] [17592186198811 1074 "Since all points $P(x,y)$ in our set lie at integer values of $x$ and $y,$ we have $x\\in Z,y\\in Z,$ and therefore \n\n$$\n(x,y)\\in Z\\times Z={Z}^{2}.\n$$\n\nThe points in our set include all those that lie *below* the line $y=x-1.$ For those points, the following condition is satisfied:\n\n$$\ny<x-1\n$$\n\nSince the boundary is *not* included in the set (the curve is *not* solid),  no further action must be taken, so we have\n\n$$\ny<x-1.\n$$\n\nTherefore, we can write the set as follows:\n\n$$\n{(x,y)\\in {Z}^{2}\\,:\\,y<x-1}\n$$" 13194139533407 17592186045585 true] [17592186198812 1068 #edb/ref 17592186195627 13194139533407 17592186045585 false] [17592186198812 1068 #edb/ref 17592186287272 13194139533407 17592186045585 true] [17592186198812 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198812 1071 "Which of the following represents the set $S = [- 1, 1] \\cdot [0, 1]$ in the Cartesian plane?" 13194139533407 17592186045585 false] [17592186198812 1071 "Which of the following represents the set $S=[-1,1]\\times [0,1]$ in the Cartesian plane?" 13194139533407 17592186045585 true] [17592186198812 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set\n\n$$\nS=[-1,1]\\times [0,1]\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate is any real number in the interval $[0,1].$\n\n$$\nS={(x,y)\\,:\\,x\\in [-1,1],\\,y\\in [0,1]}.\n$$\n\nTo visualize $S$, consider ${S}_{0}⊂S$ containing all points whose $x$-coordinate equals $0$ and whose $y$-coordinate is any real number in the interval $[0,1].$\n\n$$\n{S}_{0}={(0,y)\\,:\\,y\\in [0,1]}\n$$\n\nWe can represent ${S}_{0}$ in the plane as follows:\n\n![](images/1c/1cc30fcc7543bfbbf8c5c59d1436eb3b1a0799d60c9ad1d899957e8fd17d58ab.png)\n\nNow, consider a general ${S}_{i}⊂S$ containing all points whose $x$-coordinate equals some $i\\in [-1,1]$ and whose $y$-coordinate is any real number in the interval $[0,1].$\n\n$$\n{S}_{i}={(i,y)\\,:\\,y\\in [0,1]}\n$$\n\nFor each $i\\in [-1,1],$ ${S}_{i}$ is a vertical line segment from the point $(i,0)$ to the point $(i,1).$\n\n![](images/49/494c9d77b0ff339b90792270c9d641054a03a2918e3c56a93747b42a77ee3ccf.png)\n\nOur Cartesian product $S$ is the union of these subsets over $I=[-1,1]:$\n\n$$\nS={⋃}_{i\\in I}{S}_{i}.\n$$\n\nAs $i$ runs over $I,$ these line segments sweep the following rectangle that represents the union ${⋃}_{i\\in I}{S}_{i}:$\n\n![](images/7c/7c5ac5dad0aaacb4347c260d634e6bcd2d6102b25d51813fe106803417cc7539.png)" 13194139533407 17592186045585 true] [17592186198813 1068 #edb/ref 17592186195633 13194139533407 17592186045585 false] [17592186198813 1068 #edb/ref 17592186287490 13194139533407 17592186045585 true] [17592186198813 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198813 1071 "Which of the following is a representation of the set $S = {1, 2} \\cdot (-1, 1)$ in the Cartesian plane?" 13194139533407 17592186045585 false] [17592186198813 1071 "Which of the following is a representation of the set $S={1,2}\\times (-1,1)$ in the Cartesian plane?" 13194139533407 17592186045585 true] [17592186198813 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS={1,2}\\times (-1,1)\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is either $1$ or $2$ and whose $y$-coordinate is any real number in the interval $(-1,1).$\n\n$$\nS={(x,y)\\,:\\,x\\in {1,2},\\,y\\in (-1,1)}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate equals $1$ and whose $y$-coordinate is any real number in the interval $(-1,1).$\n\n$$\n{S}_{1}={(1,y)\\,:\\,y\\in (-1,1)}\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/11/11522acdfeaad022847fedbcf6052424216587f99f2691e80ed96152f30818a4.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate equals $2$ and whose $y$-coordinate is any real number in the interval $(-1,1).$\n\n$$\n{S}_{2}={(2,y)\\,:\\,y\\in (-1,1)}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/90/90b6a9c00d366e4a03c8c974476fdf06bc9fa73c9c26e9a0cd6ba9a4bda8e66d.png)\n\nOur Cartesian product is the *union* of these subsets:\n\n$$\nS={S}_{1}\\cup {S}_{2}\n$$\n\nTherefore, $S$ can be represented by the two line segments shown below.\n\n![](images/bb/bbf0d5ecc57bc30c7a3f4db7a1d30b27633e4586b2768e315715df72ce41333f.png)" 13194139533407 17592186045585 true] [17592186198849 1068 #edb/ref 17592186196099 13194139533407 17592186045585 false] [17592186198849 1068 #edb/ref 17592186196105 13194139533407 17592186045585 false] [17592186198849 1068 #edb/ref 17592186287372 13194139533407 17592186045585 true] [17592186198849 1068 #edb/ref 17592186287664 13194139533407 17592186045585 true] [17592186198849 1070 #edb/ref 17592186045485 13194139533407 17592186045585 true] [17592186198849 1071 "Describe the set $S = {3, 5, 7, 9, 11,...}$ using a constructive definition.\n\n$2n + 1$ {{field-1}} {{field-2}}" 13194139533407 17592186045585 false] [17592186198849 1071 "Describe the set $S={3,5,7,9,11,...}$ using a constructive definition.\n\n$$\nS={{{field-1}}\\,:\\,n\\,{{field-2}}}\n$$" 13194139533407 17592186045585 true] [17592186198849 1074 "Notice that the elements of our set\n\n$$\n3,\\,5,\\,7,\\,11,\\,…\n$$\n\nform an arithmetic sequence with common difference $d=2:$\n\n$$\n\\begin{aligned}d & =2 \\\\  & =5-3 \\\\  & =7-5 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, the $n$th term ${a}_{n}$ of our sequence for $n\\in N,n\\ge 1$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =3+(n-1)\\cdot 2 \\\\  & =3+2n-2 \\\\  & =2n+1.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={2n+1\\,:\\,n\\in N}\n$$" 13194139533407 17592186045585 true] [17592186198878 1068 #edb/ref 17592186196491 13194139533407 17592186045585 false] [17592186198878 1068 #edb/ref 17592186196496 13194139533407 17592186045585 false] [17592186198878 1068 #edb/ref 17592186287172 13194139533407 17592186045585 true] [17592186198878 1068 #edb/ref 17592186287563 13194139533407 17592186045585 true] [17592186198878 1070 #edb/ref 17592186045487 13194139533407 17592186045585 true] [17592186198878 1071 "Describe the set $S = {...,-4,-2, 0, 2, 4,...}$ using a constructive definition.\n\n*Hint: Take $a_{1} = 2$ in the sequence that generates the elements of $S$.*\n\n$2n$ {{field-1}} {{field-2}}" 13194139533407 17592186045585 false] [17592186198878 1071 "Describe the set $S={...,-4,-2,0,2,4,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=2$ in the sequence that generates the elements of $S.$*\n\n$$\n2n+1\n$$" 13194139533407 17592186045585 true] [17592186198878 1074 "Notice that the elements of our set\n\n$$\n…,\\,-4,\\,-2,\\,0,\\,2,\\,4,\\,…\n$$\n\nform a two-way infinite arithmetic sequence with common difference $d=2:$\n\n$$\n\\begin{aligned}d & =2 \\\\  & =-2-(-4) \\\\  & =0-(-2) \\\\  & =2-0 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=2,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =2+(n-1)\\cdot 2 \\\\  & =2+2n-2 \\\\  & =2n.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={2n\\,:\\,n\\in Z}\n$$" 13194139533407 17592186045585 true] [17592186203903 1038 #edb/ref 17592186287960 13194139533407 17592186045585 true] [17592186203903 1038 #edb/ref 17592186287961 13194139533407 17592186045585 true] [17592186203904 1038 #edb/ref 17592186287962 13194139533407 17592186045585 true] [17592186233624 1068 #edb/ref 17592186232295 13194139533407 17592186045585 false] [17592186233624 1068 #edb/ref 17592186287427 13194139533407 17592186045585 true] [17592186233625 1068 #edb/ref 17592186232301 13194139533407 17592186045585 false] [17592186233625 1068 #edb/ref 17592186287185 13194139533407 17592186045585 true] [17592186284792 1081 "-2" 13194139533407 17592186045585 true] [17592186284792 1083 #edb/ref 17592186045499 13194139533407 17592186045585 true] [17592186284792 1084 #uuid "00092400-4bdb-54aa-b9f7-3bbc79220342" 13194139533407 17592186045585 true] [17592186284793 1081 "14" 13194139533407 17592186045585 true] [17592186284793 1083 #edb/ref 17592186045499 13194139533407 17592186045585 true] [17592186284793 1084 #uuid "000e3561-1544-5dc9-8c11-17c48b422a41" 13194139533407 17592186045585 true] [17592186284794 1081 "{66}^{∘}" 13194139533407 17592186045585 true] [17592186284794 1083 #edb/ref 17592186045499 13194139533407 17592186045585 true] [17592186284794 1084 #uuid "00143ce8-e44c-5e38-977e-83fe2bce5b90" 13194139533407 17592186045585 true] [17592186284795 1081 "{R}^{2}" 13194139533407 175921