{d}s \\\\  & =-3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-3{\\int }_{{C}_{2}}y\\,\\text{d}s & =-3{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=-12.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot 8+2\\cdot (-12)=-8.\n$$" 13194139533408 17592186045585 true] [17592186290439 1068 #edb/ref 17592186289832 13194139533408 17592186045585 true] [17592186290439 1069 "q-22615" 13194139533408 17592186045585 true] [17592186290439 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290439 1071 "For the function $f(x)=x+2\\operatorname{sin}⁡x,$ defined on the closed interval $0\\le x\\le \\pi ,$ which of the following statements are true?\n\n- The global maximum value is $\\frac{\\pi }{2}+\\sqrt{3}$\n- The global maximum value is $\\frac{2\\pi }{3}+\\sqrt{3}$\n- The global minimum value is $0$" 13194139533408 17592186045585 true] [17592186290439 1072 #uuid "b73efa01-82ab-533b-98f8-7ad100b1bc59" 13194139533408 17592186045585 true] [17592186290439 1074 "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=x+2\\operatorname{sin}⁡x,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =1+2\\operatorname{cos}⁡x,\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n1+2\\operatorname{cos}⁡x=0\\,⟹\\,x=\\frac{2\\pi }{3}+2\\pi n,\\,\\,\\,\\frac{4\\pi }{3}+2\\pi n,\n$$\n\nwhere $n$ is an integer. We discard all solutions except $x=\\frac{2\\pi }{3}$ since it is the only value that belongs to the given interval.\n\nSo, the critical points are $x=\\frac{2\\pi }{3},$ and the endpoints $x=0,\\pi $ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(0) & =0+2\\operatorname{sin}⁡(0)=0 \\\\ f(\\frac{2\\pi }{3}) & =\\frac{2\\pi }{3}+2\\operatorname{sin}⁡(\\frac{2\\pi }{3})=\\frac{2\\pi }{3}+\\sqrt{3}≈3.8 \\\\ f(\\pi ) & =\\pi +2\\operatorname{sin}⁡(\\pi )=\\pi ≈3.1\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(\\frac{2\\pi }{3})=\\frac{2\\pi }{3}+\\sqrt{3},$ so the global maximum is $\\frac{2\\pi }{3}+\\sqrt{3}.$\n\n- The smallest value is $f(0)=0,$ so the global minimum is $0.$\n\nTherefore, the correct answer is \"II and III only.\"\n\n![](images/53/539dc4ccd2f1b20f521ae0f70bb5d95b8c5f9d1a006ff102baf43ac13ce19660.png)" 13194139533408 17592186045585 true] [17592186290440 1068 #edb/ref 17592186289788 13194139533408 17592186045585 true] [17592186290440 1069 "q-226150" 13194139533408 17592186045585 true] [17592186290440 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290440 1071 "![](images/80/80cc5e165f78bc1fc8cc7f83644fd00ca4a8f4e05e69d97b654bb2f1450d9b99.png)\n\nConsider the vector field $F=-x\\,i+3y\\,j$ and a rectangle $C$ with base $6$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" 13194139533408 17592186045585 true] [17592186290440 1072 #uuid "6848eb02-e01e-5364-9fcf-7d0ce934cecc" 13194139533408 17592186045585 true] [17592186290440 1074 "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/51/511bae61d710c3362bb18618717b3d44ef5dcedece5f669e0b5237b7b524a054.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-x\\,i+3y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=3i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-{\\int }_{{C}_{1}}x\\,\\text{d}s & =-{\\int }_{-2}^{2}3\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-3{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-3)\\cdot 4 \\\\  & =-12.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-12.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-x\\,i+3y\\,j)\\cdot j\\,\\text{d}s \\\\  & =3{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-3,3].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}3{\\int }_{{C}_{2}}y\\,\\text{d}s & =3{\\int }_{-3}^{3}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =6{\\int }_{-3}^{3}\\text{d}t \\\\  & =6\\cdot 6 \\\\  & =36.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=36.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-12)+2\\cdot 36=48.\n$$" 13194139533408 17592186045585 true] [17592186290441 1068 #edb/ref 17592186290090 13194139533408 17592186045585 true] [17592186290441 1069 "q-226152" 13194139533408 17592186045585 true] [17592186290441 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290441 1071 "![](images/0a/0ac0fa01b3e09d268115a604a53ca6247c9e26d88603482223aa43927df20561.png)\n\nConsider the vector field $F=-2x\\,i+5y\\,j$ and a rectangle $C$ with base $2$ and height $4$ centered at $O,$ as shown above. Calculate the flux of $F$ across $C.$\n\n*Hint: You may use the fact that, due to symmetry, the flux is equal across the vertical sides, and similarly for the horizontal sides.*" 13194139533408 17592186045585 true] [17592186290441 1072 #uuid "a69a7a8b-52c6-5396-ab13-a2f6e97bdfa1" 13194139533408 17592186045585 true] [17592186290441 1074 "If $F$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ In this case, we have\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s+{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s+{\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s+{\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s,\n$$\n\nwhere the sides ${C}_{i}$ and unit vectors ${n}_{i}$ are shown below.\n\n![](images/29/29f4b57751e27f01539fb48acf115b6e255d47a04ee647ef85aa496731b266c8.png)\n\nWe compute this integral in two stages. \n\n- First, consider the side ${C}_{1}.$ We have that ${n}_{1}=i,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s & ={\\int }_{{C}_{1}}(-2x\\,i+5y\\,j)\\cdot i\\,\\text{d}s \\\\  & =-2{\\int }_{{C}_{1}}x\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{1},$ we have\n\n$$\nr(t)=i+t\\,j,\\,⇒\\,{r}^{′}(t)=j,\\,t\\in [-2,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}-2{\\int }_{{C}_{1}}x\\,\\text{d}s & =-2{\\int }_{-2}^{2}1\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =-2{\\int }_{-2}^{2}\\text{d}t \\\\  & =(-2)\\cdot 4 \\\\  & =-8.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{3}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{1}}F\\cdot {n}_{1}\\,\\text{d}s={\\int }_{{C}_{3}}F\\cdot {n}_{3}\\,\\text{d}s=-8.\n$$\n\n- Next, we consider the side ${C}_{2}.$ We have that ${n}_{2}=j,$ and therefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s & ={\\int }_{{C}_{2}}(-2x\\,i+5y\\,j)\\cdot j\\,\\text{d}s \\\\  & =5{\\int }_{{C}_{2}}y\\,\\text{d}s.\\end{aligned}\n$$\n\nThis is a line integral with respect to arc length, which we can evaluate in the usual way. Parameterizing the side ${C}_{2},$ we have\n\n$$\nr(t)=t\\,i+2\\,j,\\,⇒\\,{r}^{′}(t)=i,\\,t\\in [-1,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}5{\\int }_{{C}_{2}}y\\,\\text{d}s & =5{\\int }_{-1}^{1}2\\cdot ||{r}^{′}(t)||\\,\\text{d}t \\\\  & =10{\\int }_{-1}^{1}\\text{d}t \\\\  & =10\\cdot 2 \\\\  & =20.\\end{aligned}\n$$\n\nBy symmetry, the flux integral across the side ${C}_{4}$ must be the same. Therefore,\n\n$$\n{\\int }_{{C}_{2}}F\\cdot {n}_{2}\\,\\text{d}s={\\int }_{{C}_{4}}F\\cdot {n}_{4}\\,\\text{d}s=20.\n$$\n\nFinally, then\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s=2\\cdot (-8)+2\\cdot 20=24.\n$$" 13194139533408 17592186045585 true] [17592186290442 1068 #edb/ref 17592186289777 13194139533408 17592186045585 true] [17592186290442 1069 "q-22754" 13194139533408 17592186045585 true] [17592186290442 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290442 1071 "For the function $f(x)=\\frac{x-1}{{x}^{2}-2x+2},$ which of the following statements are true?\n\n- $x=0$ is a local minimum\n- $x=1$ is a local minimum\n- $x=2$ is a local maximum" 13194139533408 17592186045585 true] [17592186290442 1072 #uuid "52b51aa0-5a9a-5119-8333-c08e35e82d61" 13194139533408 17592186045585 true] [17592186290442 1074 "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{(1)\\cdot ({x}^{2}-2x+2)-(x-1)\\cdot (2x-2)}{({x}^{2}-2x+2)^{2}} \\\\  & =\\frac{{x}^{2}-2x+2-2{x}^{2}+4x-2}{({x}^{2}-2x+2)^{2}} \\\\  & =\\frac{-{x}^{2}+2x}{({x}^{2}-2x+2)^{2}}.\\end{aligned}\n$$\n\nSolving ${f}^{′}(x)=0$ gives\n\n$$\n\\begin{aligned}\\frac{-{x}^{2}+2x}{({x}^{2}-2x+2)^{2}} & =0 \\\\ -{x}^{2}+2x & =0 \\\\ x(2-x) & =0 \\\\ x & =0,2.\\end{aligned}\n$$\n\nSo $x=0$ and $x=2$ are stationary points. Next, to determine whether these points are local maxima or minima, we use the first derivative test.\n\nLet's choose the test points $x=-1,1,3$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =\\frac{-(-1)^{2}+2(-1)}{((-1)^{2}-2(-1)+2)^{2}}=-\\frac{3}{25}<0 \\\\ {f}^{′}(1) & =\\frac{-(1)^{2}+2(1)}{((1)^{2}-2(1)+2)^{2}}=1>0 \\\\ {f}^{′}(3) & =\\frac{-(3)^{2}+2(3)}{((3)^{2}-2(3)+2)^{2}}=-\\frac{3}{25}<0\\end{aligned}\n$$\n\nWe summarize the information in the table shown below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,2)$ | $2$ | $(2,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| Test Point | $-1$ |  | $1$ |  | $3$ |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n| $f$ | $↘$ | min | $↗$ | max | $↘$ |\n\nFinally, let's use the table above to classify the critical points.\n\n- At $x=0,$ the first derivative changes sign from negative to positive. Therefore, $x=0$ is a local minimum.\n\n- At $x=2,$ the first derivative changes sign from positive to negative. Therefore, $x=2$ is a local maximum.\n\nTherefore, the correct answer is \"I and III only.\"" 13194139533408 17592186045585 true] [17592186290443 1068 #edb/ref 17592186289970 13194139533408 17592186045585 true] [17592186290443 1069 "q-2277" 13194139533408 17592186045585 true] [17592186290443 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290443 1071 "$\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x=$" 13194139533408 17592186045585 true] [17592186290443 1072 #uuid "e3b4a92d-a353-507a-becb-bee354a44152" 13194139533408 17592186045585 true] [17592186290443 1074 "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x & =5\\int {e}^{x}\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290444 1068 #edb/ref 17592186289883 13194139533408 17592186045585 true] [17592186290444 1069 "q-2281" 13194139533408 17592186045585 true] [17592186290444 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290444 1071 "$\\int ({9}^{x}+3{e}^{x})\\,\\text{d}x=$" 13194139533408 17592186045585 true] [17592186290444 1072 #uuid "58d4516f-1cdf-5b1c-9320-38f5fe340903" 13194139533408 17592186045585 true] [17592186290444 1074 "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({9}^{x}+3{e}^{x})\\,\\text{d}x & =\\int {9}^{x}\\,\\text{d}x+3\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{{9}^{x}}{\\operatorname{ln}⁡9}+3{e}^{x}+C.\\end{aligned}\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290445 1068 #edb/ref 17592186289887 13194139533408 17592186045585 true] [17592186290445 1069 "q-22820" 13194139533408 17592186045585 true] [17592186290445 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290445 1071 "For which value of $x$ does the function $f(x)={e}^{-{x}^{2}/2}$ have a local maximum?" 13194139533408 17592186045585 true] [17592186290445 1072 #uuid "2e0059b5-82bb-5804-9901-5b360e187e5c" 13194139533408 17592186045585 true] [17592186290445 1074 "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=(-\\frac{1}{2})\\cdot (2x){e}^{-{x}^{2}/2}=-x{e}^{-{x}^{2}/2}.\\end{aligned}\n$$\n\nSolving for ${f}^{′}(x)=0$ gives\n\n$$\n\\begin{aligned}-x{e}^{-{x}^{2}/2} & =0 \\\\ x & =0.\\end{aligned}\n$$\n\nSo $x=0$ is a stationary point. Next, to determine whether this point is a local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=-1,1$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =-(-1){e}^{-(-1)^{2}/2}={e}^{-1/2}>0 \\\\ {f}^{′}(1) & =-(1){e}^{-(1)^{2}/2}=-{e}^{-1/2}<0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $-1$ |  | $1$ |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | max | $↘$ |\n\nFinally, let's use the table above to classify the critical point.\n\n- At $x=0,$ the first derivative changes sign from positive to negative. Therefore, $x=0$ is a local maximum.\n\nWe conclude that $f(x)$ has a local maximum at $x=0.$" 13194139533408 17592186045585 true] [17592186290446 1068 #edb/ref 17592186289881 13194139533408 17592186045585 true] [17592186290446 1069 "q-22826" 13194139533408 17592186045585 true] [17592186290446 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290446 1071 "Consider the function $f(x)={x}^{2}-\\frac{1}{x}$ defined on $x\\in (0,\\infty ).$ Which of the following statements are true?\n\n- $f(x)$ is concave up on $(0,1)$\n- $f(x)$ is concave down on $(0,1)$\n- $f(x)$ is concave down on $(1,\\infty )$" 13194139533408 17592186045585 true] [17592186290446 1072 #uuid "c687bf7b-334e-54f3-b20c-cd4bb1895323" 13194139533408 17592186045585 true] [17592186290446 1074 "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2x+\\frac{1}{{x}^{2}} \\\\ {f}^{″}(x) & =2-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}2-\\frac{2}{{x}^{3}} & >0 \\\\ 2 & >\\frac{2}{{x}^{3}} \\\\ {x}^{3} & >1 \\\\ x & >1\\end{aligned}\n$$\n\nNote that we used the fact that $x>0.$\n\nHence, ${f}^{″}(x)>0$ when $x>1.$ So the graph is concave up on the interval $(1,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $2-\\frac{2}{{x}^{3}}<0,$ which has the solution $(0,1).$\n\nTherefore, the correct answer is \" II only.\"" 13194139533408 17592186045585 true] [17592186290447 1068 #edb/ref 17592186289811 13194139533408 17592186045585 true] [17592186290447 1069 "q-228897" 13194139533408 17592186045585 true] [17592186290447 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290447 1071 "If ${e}^{x}=6,$ then $x≈${{field-1}}, rounded to $3$ decimal places." 13194139533408 17592186045585 true] [17592186290447 1072 #uuid "b8de7fdc-d84b-57e9-af41-b859fe4ea824" 13194139533408 17592186045585 true] [17592186290447 1074 "First, we take $ln$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{x} & =6 \\\\ ln⁡({e}^{x}) & =ln⁡(6) \\\\ x & =ln⁡(6)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈1.792\n$$\n\nrounded to $3$ decimal places." 13194139533408 17592186045585 true] [17592186290448 1068 #edb/ref 17592186289877 13194139533408 17592186045585 true] [17592186290448 1069 "q-2289" 13194139533408 17592186045585 true] [17592186290448 1070 #edb/ref 17592186045486 13194139533408 17592186045585 true] [17592186290448 1071 "Given that  $y-{2}^{y}=3{x}^{2},$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" 13194139533408 17592186045585 true] [17592186290448 1072 #uuid "623f14ca-5670-5819-81c3-5ed253df18c6" 13194139533408 17592186045585 true] [17592186290448 1074 "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$ \n\n$$\n\\begin{aligned}\\begin{aligned}y-{2}^{y} & =3{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(y-{2}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}({2}^{y}) & =6x \\\\ (1-\\operatorname{ln}⁡(2){2}^{y})(\\frac{\\text{d}y}{\\text{d}x}) & =6x\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(1-\\operatorname{ln}⁡(2)\\,{2}^{y}) & =6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}\\end{aligned}\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290449 1068 #edb/ref 17592186289770 13194139533408 17592186045585 true] [17592186290449 1069 "q-2290" 13194139533408 17592186045585 true] [17592186290449 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290449 1071 "Given that $\\operatorname{tan}⁡(3x)-{y}^{2}=y,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" 13194139533408 17592186045585 true] [17592186290449 1072 #uuid "610d7896-a073-528d-972b-ac6b8950750a" 13194139533408 17592186045585 true] [17592186290449 1074 "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\begin{aligned}\\operatorname{tan}⁡(3x)-{y}^{2} & =y \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x)-{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡(3x))-\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(y) \\\\ 3{sec}^{2}⁡(3x)-2y(\\frac{\\text{d}y}{\\text{d}x}) & =(\\frac{\\text{d}y}{\\text{d}x})\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}3{sec}^{2}⁡(3x) & =\\frac{\\text{d}y}{\\text{d}x}(2y+1) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3{sec}^{2}⁡(3x)}{2y+1}\\end{aligned}\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290450 1068 #edb/ref 17592186290041 13194139533408 17592186045585 true] [17592186290450 1069 "q-22978" 13194139533408 17592186045585 true] [17592186290450 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290450 1071 "Which angle is coterminal with $-{175}^{∘}?$" 13194139533408 17592186045585 true] [17592186290450 1072 #uuid "5c16f62f-e5ed-5bc6-871e-930389ab5f42" 13194139533408 17592186045585 true] [17592186290450 1074 "To find the coterminal angles of a given angle $\\theta $ (in degrees), we add and subtract integer multiples of ${360}^{∘}$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{175}^{∘}$:\n\n- $-{175}^{∘}+{360}^{∘}={185}^{∘}$\n\n- $-{175}^{∘}+2\\cdot {360}^{∘}={545}^{∘}\\,✓$\n\nThere are no answer choices larger than ${545}^{∘},$ so we can stop here.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{175}^{∘}$:\n\n- $-{175}^{∘}-{360}^{∘}=-{535}^{∘}$\n\n- $-{175}^{∘}-2\\cdot {360}^{∘}=-{895}^{∘}$\n\nThere are no answer choices smaller than $-{895}^{∘},$ so we can stop here.\n\nSo the correct answer is ${545}^{∘}.$" 13194139533408 17592186045585 true] [17592186290451 1068 #edb/ref 17592186289841 13194139533408 17592186045585 true] [17592186290451 1069 "q-22979" 13194139533408 17592186045585 true] [17592186290451 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290451 1071 "Which of the following angles are coterminal with $\\theta =-{95}^{∘}?$\n\n- ${625}^{∘}$\n- ${160}^{∘}$\n- $-{455}^{∘}$" 13194139533408 17592186045585 true] [17592186290451 1072 #uuid "ca248134-22cf-5031-924c-1fcc047804dc" 13194139533408 17592186045585 true] [17592186290451 1074 "To find the coterminal angles of a given angle $\\theta $, we add and subtract integer multiples of ${360}^{∘}:$\n\nLet's start by adding multiples of ${360}^{∘}$ to $-{95}^{∘}$:\n\n- $-{95}^{∘}+{360}^{∘}={265}^{∘}$\n\n- $-{95}^{∘}+2\\cdot {360}^{∘}={625}^{∘}\\,✓$\n\nOf the given values, there is no angle greater than ${625}^{∘}.$ So we can stop there.\n\nNow, let's subtract multiples of ${360}^{∘}$ from $-{95}^{∘}$\n\n- $-{95}^{∘}-{360}^{∘}=-{455}^{∘}\\,✓$\n\nOf the given angles, only ${625}^{∘}$ and $-{455}^{∘}$ are coterminal with $-{95}^{∘}.$\n\nSo the correct answer is I and III only." 13194139533408 17592186045585 true] [17592186290452 1068 #edb/ref 17592186289925 13194139533408 17592186045585 true] [17592186290452 1069 "q-22997" 13194139533408 17592186045585 true] [17592186290452 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290452 1071 "![](images/70/701c883ef9f721f9dad8fb59236fbbd297cfac3d3d8845a18d3493d788f8d8a8.png)\n\nPaint is leaking from a tank and is forming a circle on the floor. If the area of the circle is increasing at the rate of $12\\pi \\,{\\text{mm}}^{2}/\\text{min}$, how fast is the circumference of the circle increasing at the moment when the radius is $4\\,\\text{mm}?$" 13194139533408 17592186045585 true] [17592186290452 1072 #uuid "f026249b-e7ad-5955-bed7-719a23da6a3a" 13194139533408 17592186045585 true] [17592186290452 1074 "In this situation, we want to find $\\frac{\\text{d}C}{\\text{d}t}$ at the moment when $r=4,$ and we are also told that  $\\frac{\\text{d}A}{\\text{d}t}=12\\pi .$\n\nTo start, let's set up an equation relating the area $A$ and the circumference $C$ of the circle. Since $C=2\\pi r$ and $A=\\pi {r}^{2},$ the relationship between $A$ and $C$ is\n\n$$\nA=\\pi {r}^{2}=\\pi {(\\frac{C}{2\\pi })}^{2}=\\frac{{C}^{2}}{4\\pi }.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{C}^{2}}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}C}(\\frac{{C}^{2}}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{C}{2\\pi }.\\end{aligned}\n$$\n\nWhen $r=4\\,\\text{mm},$ $C=2\\pi (4)=8\\pi \\text{ mm}.$ Hence, substituting $\\frac{\\text{d}A}{\\text{d}t}=12\\pi $ and $C=8\\pi $, and solving for $\\frac{\\text{d}A}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}12\\pi  & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{8\\pi }{2\\pi } \\\\ 12\\pi  & =\\frac{\\text{d}C}{\\text{d}t}\\cdot 4 \\\\ \\frac{\\text{d}C}{\\text{d}t} & =\\frac{12\\pi }{4} \\\\ \\frac{\\text{d}C}{\\text{d}t} & =3\\pi .\\end{aligned}\n$$\n\nWe conclude that the circumference is increasing at a rate of $3\\pi \\text{ mm/min}.$" 13194139533408 17592186045585 true] [17592186290453 1068 #edb/ref 17592186290020 13194139533408 17592186045585 true] [17592186290453 1069 "q-2305" 13194139533408 17592186045585 true] [17592186290453 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290453 1071 "Find the values of $c$ that satisfy the mean value theorem for  $f(x)=3{x}^{2}+x-2$ on the interval $[-1,2].$" 13194139533408 17592186045585 true] [17592186290453 1072 #uuid "c15c8a07-d217-56eb-8e6f-77808e46bc56" 13194139533408 17592186045585 true] [17592186290453 1074 "The function $f(x)$ is continuous on $[-1,2]$ and differentiable on $(-1,2),$ hence we can apply the mean value theorem. \n\nSo, the mean value theorem states that there exists a $c\\in (-1,2)$ such that\n\n$$\n{f}^{′}(c)=\\frac{f(b)-f(a)}{b-a}.\n$$\n\nPlugging in $a=-1$ and $b=2$ into the above gives\n\n$$\n\\begin{aligned}{f}^{′}(c) & =\\frac{f(2)-f(-1)}{2-(-1)} \\\\  & =\\frac{(3\\cdot {2}^{2}+2-2)-(3\\cdot (-1)^{2}+(-1)-2)}{2+1} \\\\  & =\\frac{12-0}{3} \\\\  & =4.\\end{aligned}\n$$\n\nDifferentiating the function, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+x-2)=6x+1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{f}^{′}(c)=6c+1.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}6c+1 & =4 \\\\ 6c & =3 \\\\ c & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290454 1068 #edb/ref 17592186289907 13194139533408 17592186045585 true] [17592186290454 1069 "q-2317" 13194139533408 17592186045585 true] [17592186290454 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290454 1071 "Find the values of $c$ that satisfy the mean value theorem for  $f(x)={x}^{3}$ on the interval $[0,1].$" 13194139533408 17592186045585 true] [17592186290454 1072 #uuid "945b5e9b-022f-593e-8b4b-b524c293ff36" 13194139533408 17592186045585 true] [17592186290454 1074 "The function $f(x)$ is continuous on $[0,1]$ and differentiable on $(0,1),$ hence we can apply the mean value theorem. \n\nSo, the mean value theorem states that there exists a $c\\in (0,1)$ such that\n\n$$\n{f}^{′}(c)=\\frac{f(b)-f(a)}{b-a}.\n$$\n\nPlugging in $a=0$ and $b=1$ into the above gives\n\n$$\n\\begin{aligned}{f}^{′}(c) & =\\frac{f(1)-f(0)}{1-0} \\\\  & =\\frac{{1}^{3}-{0}^{3}}{1} \\\\  & =1.\\end{aligned}\n$$\n\nDifferentiating the function, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})=3{x}^{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{f}^{′}(c)=3{c}^{2}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}3{c}^{2} & =1 \\\\ {c}^{2} & =\\frac{1}{3} \\\\ c & =\\pm \\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nSince $c\\in (0,1)$, we discard the negative value, therefore $c=\\frac{\\sqrt{3}}{3}.$" 13194139533408 17592186045585 true] [17592186290455 1068 #edb/ref 17592186289952 13194139533408 17592186045585 true] [17592186290455 1069 "q-23216" 13194139533408 17592186045585 true] [17592186290455 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290455 1071 "The point $A$ is located in the first quadrant and lies on the unit circle. The $x$-coordinate of $A$ is $\\frac{1}{4}.$ What is the $y$-coordinate of $A?$" 13194139533408 17592186045585 true] [17592186290455 1072 #uuid "122300d6-48f4-52e5-9b3e-da4687523cb3" 13194139533408 17592186045585 true] [17592186290455 1074 "Since the point $A$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $x=\\frac{1}{4}$ into the above and solving for $y$ gives,\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {(\\frac{1}{4})}^{2}+{y}^{2} & =1 \\\\ \\frac{1}{16}+{y}^{2} & =1 \\\\ {y}^{2} & =1-\\frac{1}{16} \\\\ {y}^{2} & =\\frac{15}{16} \\\\ y & =\\sqrt{\\frac{15}{16}} \\\\ y & =\\pm \\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$\n\nSince $A$ lies in the first quadrant, $y$ must be positive, so we select the positive answer. Therefore, our final answer is $y=\\frac{\\sqrt{15}}{4}.$" 13194139533408 17592186045585 true] [17592186290456 1068 #edb/ref 17592186290069 13194139533408 17592186045585 true] [17592186290456 1069 "q-23289" 13194139533408 17592186045585 true] [17592186290456 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290456 1071 "![](images/89/8904a5ebafade54a46cee77a2e20cac255c888d257ef1c208b2def32d247f2cd.png)\n\nThe point $P$ is located on the unit circle, as shown above. The $y$-coordinate of $P$ is $\\frac{11}{12}.$ What is the $x$-coordinate of $P?$" 13194139533408 17592186045585 true] [17592186290456 1072 #uuid "808fb241-7b41-5e43-96f3-08a62164f95c" 13194139533408 17592186045585 true] [17592186290456 1074 "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{11}{12}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{11}{12})}^{2} & =1 \\\\ {x}^{2}+(\\frac{121}{144}) & =1 \\\\ {x}^{2} & =1-\\frac{121}{144} \\\\ {x}^{2} & =\\frac{23}{144} \\\\ x & =\\pm \\sqrt{\\frac{23}{144}} \\\\ x & =\\pm \\frac{\\sqrt{23}}{12}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the second quadrant. So our final answer is $x=-\\frac{\\sqrt{23}}{12}.$" 13194139533408 17592186045585 true] [17592186290457 1068 #edb/ref 17592186290147 13194139533408 17592186045585 true] [17592186290457 1069 "q-23307" 13194139533408 17592186045585 true] [17592186290457 1070 #edb/ref 17592186045486 13194139533408 17592186045585 true] [17592186290457 1071 "If $cos⁡\\theta =-\\frac{1}{2}$ and ${180}^{∘}<\\theta <{270}^{∘},$ then what is the value of $tan⁡\\theta ?$" 13194139533408 17592186045585 true] [17592186290457 1072 #uuid "0ca170ad-d931-5618-b051-e0ab68f9da15" 13194139533408 17592186045585 true] [17592186290457 1074 "Let's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/78/7873579bb5dd1976330ec24f13b30dd384f916cf23bbf48aac4b2a522ee9548a.png)\n\nWe're given that $cos⁡\\theta =-\\frac{1}{2}.$ We can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =-\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(-\\frac{1}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe select the negative answer since $sin⁡\\theta $ is negative in the third quadrant. So, $sin⁡\\theta =-\\frac{\\sqrt{3}}{2}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{(-\\frac{\\sqrt{3}}{2})}{(-\\frac{1}{2})}=\\sqrt{3}.\n$$" 13194139533408 17592186045585 true] [17592186290458 1068 #edb/ref 17592186290102 13194139533408 17592186045585 true] [17592186290458 1069 "q-233244" 13194139533408 17592186045585 true] [17592186290458 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290458 1071 "Expressed in terms of natural logarithms, determine the value of $x$ that satisfies the equation ${5}^{x-2}={7}^{3-2x}.$\n\n$x=$\n{{field-1}}" 13194139533408 17592186045585 true] [17592186290458 1072 #uuid "2b63ab50-7f2c-5d55-8681-27c1f53f06a2" 13194139533408 17592186045585 true] [17592186290458 1074 "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{5}^{x-2} & ={7}^{3-2x} \\\\ \\operatorname{ln}⁡({5}^{x-2}) & =\\operatorname{ln}⁡({7}^{3-2x})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives\n\n$$\n(x-2)\\operatorname{ln}⁡(5)=(3-2x)\\operatorname{ln}⁡(7).\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}(x-2)\\operatorname{ln}⁡(5) & =(3-2x)\\operatorname{ln}⁡(7) \\\\ x\\operatorname{ln}⁡(5)-2\\operatorname{ln}⁡(5) & =3\\operatorname{ln}⁡(7)-2x\\operatorname{ln}⁡(7) \\\\ x\\operatorname{ln}⁡(5)+2x\\operatorname{ln}⁡(7) & =3\\operatorname{ln}⁡(7)+2\\operatorname{ln}⁡(5) \\\\ x(\\operatorname{ln}⁡(5)+2\\operatorname{ln}⁡(7)) & =2\\operatorname{ln}⁡(5)+3\\operatorname{ln}⁡(7) \\\\ x & =\\frac{2\\operatorname{ln}⁡(5)+3\\operatorname{ln}⁡(7)}{\\operatorname{ln}⁡(5)+2\\operatorname{ln}⁡(7)}\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290459 1068 #edb/ref 17592186290084 13194139533408 17592186045585 true] [17592186290459 1069 "q-2333" 13194139533408 17592186045585 true] [17592186290459 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290459 1071 "Find the equation of the tangent to the curve $y=2\\sqrt{{x}^{7}}-{x}^{2}$ at the point $(1,1).$" 13194139533408 17592186045585 true] [17592186290459 1072 #uuid "8244d6b7-49d6-530a-9f58-a05206122c7c" 13194139533408 17592186045585 true] [17592186290459 1074 "Let $f(x)=2\\sqrt{{x}^{7}}-{x}^{2}.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2\\sqrt{{x}^{7}}-{x}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7/2}-{x}^{2}) \\\\  & =7{x}^{5/2}-2x.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=7(1)^{5/2}-2(1)=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,1),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =5(x-1) \\\\ y & =5x-5+1 \\\\ y & =5x-4.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290460 1068 #edb/ref 17592186290026 13194139533408 17592186045585 true] [17592186290460 1069 "q-23378" 13194139533408 17592186045585 true] [17592186290460 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290460 1071 "Which of the following lines is perpendicular to $5x-y=7?$" 13194139533408 17592186045585 true] [17592186290460 1072 #uuid "8f4b2fab-afe0-5fd3-a151-d84c2b56dabe" 13194139533408 17592186045585 true] [17592186290460 1074 "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $5x-y=7,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}5x-y & =7 \\\\ -y & =-5x+7 \\\\ y & =5x-7\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $5.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{5}x-6$ has a slope of $-\\frac{1}{5}.$\n\nMultiplying the slopes together, we have\n\n$$\n5\\cdot (-\\frac{1}{5})=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{5}x-6$ is perpendicular to the given line." 13194139533408 17592186045585 true] [17592186290461 1068 #edb/ref 17592186290050 13194139533408 17592186045585 true] [17592186290461 1069 "q-23386" 13194139533408 17592186045585 true] [17592186290461 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290461 1071 "$\\operatorname{sin}⁡(\\frac{2\\pi }{3})=$" 13194139533408 17592186045585 true] [17592186290461 1072 #uuid "eada5d72-6d70-5c39-a9a3-abb525221d5d" 13194139533408 17592186045585 true] [17592186290461 1074 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{2\\pi }{3}$ corresponds to the point $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{2\\pi }{3})=\\frac{\\sqrt{3}}{2}.$" 13194139533408 17592186045585 true] [17592186290462 1068 #edb/ref 17592186289825 13194139533408 17592186045585 true] [17592186290462 1069 "q-233995" 13194139533408 17592186045585 true] [17592186290462 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290462 1071 "If the sum of the first $29$ terms of an arithmetic series is ${S}_{29}=319,$ and the common difference is $d=-3,$ then the first term of the series is ${a}_{1}=${{field-1}}." 13194139533408 17592186045585 true] [17592186290462 1072 #uuid "7c4316ce-cfcd-52f4-977b-5ea74198a3e7" 13194139533408 17592186045585 true] [17592186290462 1074 "We are given the common difference of the series. So, to find the first term, we use the formula for the sum of an arithmetic series in the form\n\n$$\n{S}_{N}=\\frac{N}{2}(2{a}_{1}+(N-1)d),\n$$\n\nwhere ${a}_{1}$ is the first term, $d$ is the common difference, and $N$ is the number of terms.\n\nSubstituting $N=29$, $d=-3$, and ${S}_{N}=319$ into the formula above, we have\n\n$$\n\\begin{aligned}319 & =\\frac{29}{2}(2{a}_{1}+(29-1)(-3)) \\\\ 638 & =29(2{a}_{1}-84) \\\\ 22 & =2{a}_{1}-84 \\\\ 106 & =2{a}_{1} \\\\ {a}_{1} & =53.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290463 1068 #edb/ref 17592186290013 13194139533408 17592186045585 true] [17592186290463 1069 "q-234003" 13194139533408 17592186045585 true] [17592186290463 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290463 1071 "Find, in ascending powers of $a,$ the **first three terms** of the binomial expansion of ${(1-\\frac{3a}{4})}^{4}.$\n\n${(1-\\frac{3a}{4})}^{4}=$\n{{field-1}}$\\,+\\,⋯$" 13194139533408 17592186045585 true] [17592186290463 1072 #uuid "a495ff01-2ceb-5e8e-8461-144b7298fb64" 13194139533408 17592186045585 true] [17592186290463 1074 "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{3a}{4}$ and $n=4$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{3a}{4})}^{4} & =1+4\\cdot (-\\frac{3a}{4})+\\frac{4(4-1)}{2!}\\cdot {(-\\frac{3a}{4})}^{2}+⋯ \\\\  & =1-3a+\\frac{4\\cdot 3}{2}\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+6\\cdot \\frac{9{a}^{2}}{16}+⋯ \\\\  & =1-3a+\\frac{27}{8}{a}^{2}+⋯.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290464 1068 #edb/ref 17592186290153 13194139533408 17592186045585 true] [17592186290464 1069 "q-234172" 13194139533408 17592186045585 true] [17592186290464 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290464 1071 "Use the first three terms of the binomial expansion of $(1+x)^{5}$ in ascending powers of $x$ to approximate $(1.19)^{5}.$ Round your answer to three decimal places.\n\n$(1.19)^{5}≈$ \n{{field-1}}" 13194139533408 17592186045585 true] [17592186290464 1072 #uuid "da7cc7ad-ec8c-56fe-991e-9b745b9ef682" 13194139533408 17592186045585 true] [17592186290464 1074 "Recall that when $n$ is a positive integer, \n\n$$\n(1+x)^{n}=1+nx+\\frac{1}{2!}n(n-1){x}^{2}+⋯+{x}^{n}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{(1+x)}^{5} & =1+5x+\\frac{1}{2}\\cdot 5\\cdot 4\\cdot {x}^{2}+⋯+{x}^{5} \\\\  & =1+5x+10{x}^{2}+⋯+{x}^{5}.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(1+x)}^{5}≈1+5x+10{x}^{2}.\n$$\n\nFinally, we substitute $x=0.19$ into the above approximation of $(1+x)^{5}:$ \n\n$$\n\\begin{aligned}(1.19)^{5} & =(1+0.19)^{5} \\\\  & ≈1+5(0.19)+10(0.19)^{2} \\\\  & =1+5(0.19)+10(0.036\\,1) \\\\  & =1+0.95+0.361 \\\\  & ≈2.311,\\end{aligned}\n$$\n\nrounded to three decimal places." 13194139533408 17592186045585 true] [17592186290465 1068 #edb/ref 17592186289948 13194139533408 17592186045585 true] [17592186290465 1069 "q-2342" 13194139533408 17592186045585 true] [17592186290465 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290465 1071 "Find the values of $c$ that satisfy the mean value theorem for \n $f(x)={x}^{2}-2x+5$ on the interval $[1,4].$" 13194139533408 17592186045585 true] [17592186290465 1072 #uuid "fff73f04-f965-5171-bca1-917e7258f29b" 13194139533408 17592186045585 true] [17592186290465 1074 "The function $f(x)$ is continuous on $[1,4]$ and differentiable on $(1,4),$ hence we can apply the mean value theorem. \n\nSo, the mean value theorem states that there exists a $c\\in (1,4)$ such that\n\n$$\n{f}^{′}(c)=\\frac{f(b)-f(a)}{b-a}.\n$$\n\nPlugging in $a=1$ and $b=4$ into the above gives\n\n$$\n\\begin{aligned}{f}^{′}(c) & =\\frac{f(4)-f(1)}{4-1} \\\\  & =\\frac{({4}^{2}-2\\cdot 4+5)-({1}^{2}-2\\cdot 1+5)}{3} \\\\  & =\\frac{13-4}{3} \\\\  & =3.\\end{aligned}\n$$\n\nDifferentiating the function, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-2x+5)=2x-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{f}^{′}(c)=2c-2.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}2c-2 & =3 \\\\ 2c & =5 \\\\ c & =\\frac{5}{2}.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290466 1068 #edb/ref 17592186290172 13194139533408 17592186045585 true] [17592186290466 1069 "q-23453" 13194139533408 17592186045585 true] [17592186290466 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290466 1071 "Find the equation of the line that passes through the point $(0,-3)$ and is perpendicular to the line passing through the points $(1,7)$ and $(-5,-1).$" 13194139533408 17592186045585 true] [17592186290466 1072 #uuid "e6cef704-dc0c-5ab7-9bc9-e3a20f725642" 13194139533408 17592186045585 true] [17592186290466 1074 "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,7)$ and $(-5,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-7}{-5-1} \\\\  & =\\frac{-8}{-6} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{4}{3})=-1\\,⇒\\,m=-\\frac{3}{4}.\n$$\n\nWe know that the line passes through the point $(0,-3).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-3) & =-\\frac{3}{4}(x-0) \\\\ y+3 & =-\\frac{3}{4}x \\\\ y & =-\\frac{3}{4}x-3\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290467 1068 #edb/ref 17592186289999 13194139533408 17592186045585 true] [17592186290467 1069 "q-23526" 13194139533408 17592186045585 true] [17592186290467 1070 #edb/ref 17592186045486 13194139533408 17592186045585 true] [17592186290467 1071 "$\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=$" 13194139533408 17592186045585 true] [17592186290467 1072 #uuid "d60ea30f-16e8-5e44-938b-3986249a44fc" 13194139533408 17592186045585 true] [17592186290467 1074 "Since both fractions are over a common denominator, we can add them. This gives\n\n$$\n\\begin{aligned}\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1-2{cos}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$\n\nThen, we use ${cos}^{2}⁡\\theta =1-{sin}^{2}⁡\\theta $ to simplify the expression in the numerator:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\\operatorname{sin}⁡\\theta .\n$$" 13194139533408 17592186045585 true] [17592186290468 1068 #edb/ref 17592186290188 13194139533408 17592186045585 true] [17592186290468 1069 "q-2355" 13194139533408 17592186045585 true] [17592186290468 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290468 1071 "The displacement (in meters) of a particle moving in a straight line is given by the equation $s(t)={t}^{3}-{t}^{2}-15$ where $t$ is measured in seconds.  Find the velocity after $t=3\\,\\text{s}.$" 13194139533408 17592186045585 true] [17592186290468 1072 #uuid "30eaba42-419a-57c9-84f6-50c96a1f5f32" 13194139533408 17592186045585 true] [17592186290468 1073 true 13194139533408 17592186045585 true] [17592186290468 1074 "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2}-15) \\\\  & =3{t}^{2}-2t\\end{aligned}\n$$\n\nTo calculate the velocity at $t=3\\,\\text{s},$ we substitute $t=3$ into the velocity function above:\n\n$$\n\\begin{aligned}v(3) & =3(3)^{2}-2(3) \\\\  & =27-6 \\\\  & =21\\,\\text{m/s}\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290469 1068 #edb/ref 17592186289803 13194139533408 17592186045585 true] [17592186290469 1068 #edb/ref 17592186290178 13194139533408 17592186045585 true] [17592186290469 1069 "q-235868" 13194139533408 17592186045585 true] [17592186290469 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290469 1071 "Rewrite the following expression as the sum of a perfect square and a constant.\n\n$({x}^{2}-8x+16)+5=(${{field-1}}${)}^{2}\\,+$\n{{field-2}}" 13194139533408 17592186045585 true] [17592186290469 1072 #uuid "f5a002e3-457b-5ed4-86c1-c1cd792a678a" 13194139533408 17592186045585 true] [17592186290469 1074 "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-8x+16 & = \\\\ {x}^{2}-2\\cdot 4x+{4}^{2} & = \\\\ (x-4{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-8x+16)+5 & = \\\\ (x-4{)}^{2}+5 & .\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290470 1068 #edb/ref 17592186289913 13194139533408 17592186045585 true] [17592186290470 1069 "q-23597" 13194139533408 17592186045585 true] [17592186290470 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290470 1071 "Simplify $(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1).$" 13194139533408 17592186045585 true] [17592186290470 1072 #uuid "88ca457f-2b23-5dac-9e86-c6ad9814fd4a" 13194139533408 17592186045585 true] [17592186290470 1074 "First, we expand the parentheses:\n\n$$\n(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1)={sec}^{2}⁡\\theta -1\n$$\n\nThen, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n{sec}^{2}⁡\\theta -1={tan}^{2}⁡\\theta \n$$\n\nTherefore, we conclude that\n\n$$\n(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1)={tan}^{2}⁡\\theta .\n$$" 13194139533408 17592186045585 true] [17592186290471 1068 #edb/ref 17592186290212 13194139533408 17592186045585 true] [17592186290471 1069 "q-2360" 13194139533408 17592186045585 true] [17592186290471 1070 #edb/ref 17592186045486 13194139533408 17592186045585 true] [17592186290471 1071 "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)=3{t}^{2}-24t+45.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $0\\,{\\text{m/s}}^{2}.$" 13194139533408 17592186045585 true] [17592186290471 1072 #uuid "584c803a-1f46-5744-b2b9-cdc9630fd64e" 13194139533408 17592186045585 true] [17592186290471 1074 "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-24t+45) \\\\  & =6t-24\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=0,$ we substitute this into the above:\n\n$$\n\\begin{aligned}0 & =6t-24 \\\\ 6t & =24 \\\\ t & =4\\end{aligned}\n$$\n\nThen, to calculate the velocity at time $t=4,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(4) & =3(4)^{2}-24(4)+45 \\\\  & =48-96+45 \\\\  & =-3\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=0\\,{\\text{m/s}}^{2}$ is $-3\\,\\text{m/s}.$" 13194139533408 17592186045585 true] [17592186290472 1068 #edb/ref 17592186290105 13194139533408 17592186045585 true] [17592186290472 1069 "q-2361" 13194139533408 17592186045585 true] [17592186290472 1070 #edb/ref 17592186045486 13194139533408 17592186045585 true] [17592186290472 1071 "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)=4{t}^{2}-16t+15.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $0\\,{\\text{m/s}}^{2}.$" 13194139533408 17592186045585 true] [17592186290472 1072 #uuid "df553b92-e7eb-5bae-8500-5506ac0ebe3f" 13194139533408 17592186045585 true] [17592186290472 1074 "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}-16t+15) \\\\  & =8t-16\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=0,$ we substitute this into the above:\n\n$$\n\\begin{aligned}0 & =8t-16 \\\\ 8t & =16 \\\\ t & =2\\end{aligned}\n$$\n\nThen, to calculate the velocity at time $t=2,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(2) & =4(2)^{2}-16(2)+15 \\\\  & =16-32+15 \\\\  & =-1\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=0\\,{\\text{m/s}}^{2}$ is $-1\\,\\text{m/s}.$" 13194139533408 17592186045585 true] [17592186290473 1068 #edb/ref 17592186290095 13194139533408 17592186045585 true] [17592186290473 1069 "q-23618" 13194139533408 17592186045585 true] [17592186290473 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290473 1071 "Which of the following lines is perpendicular to $8x-y=2?$" 13194139533408 17592186045585 true] [17592186290473 1072 #uuid "10634cc5-0e61-5b63-a591-be33d692e732" 13194139533408 17592186045585 true] [17592186290473 1074 "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $8x-y=2,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}8x-y & =2 \\\\ -y & =-8x+2 \\\\ y & =8x-2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $8.$\n\nLooking at the answer choices, the line $y=-\\frac{1}{8}x+8$ has a slope of $-\\frac{1}{8}.$\n\nMultiplying the slopes together, we have\n\n$$\n8\\cdot (-\\frac{1}{8})=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-\\frac{1}{8}x+8$ is perpendicular to the given line." 13194139533408 17592186045585 true] [17592186290474 1068 #edb/ref 17592186290077 13194139533408 17592186045585 true] [17592186290474 1069 "q-23621" 13194139533408 17592186045585 true] [17592186290474 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290474 1071 "Which of the following lines is perpendicular to $x+3y=6?$" 13194139533408 17592186045585 true] [17592186290474 1072 #uuid "d4eec6d2-1c29-5a4c-9b34-ea67f65dce06" 13194139533408 17592186045585 true] [17592186290474 1074 "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+3y=6,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+3y & =6 \\\\ 3y & =-x+6 \\\\ y & =-\\frac{1}{3}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{3}.$\n\nLooking at the answer choices, the line $y=3x$ has a slope of $3.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{3})\\cdot 3=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=3x$ is perpendicular to the given line." 13194139533408 17592186045585 true] [17592186290475 1068 #edb/ref 17592186290255 13194139533408 17592186045585 true] [17592186290475 1069 "q-23628" 13194139533408 17592186045585 true] [17592186290475 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290475 1071 "Find the equation of the line that passes through the point $(1,-2)$ and is perpendicular to $x=3.$" 13194139533408 17592186045585 true] [17592186290475 1072 #uuid "a7ae4cd4-1e82-505c-b059-ac7b09715ab6" 13194139533408 17592186045585 true] [17592186290475 1074 "Since the line $x=3$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(1,-2),$ which has a $y$-coordinate of $-2.$ So, the perpendicular line is $y=-2.$" 13194139533408 17592186045585 true] [17592186290476 1068 #edb/ref 17592186290229 13194139533408 17592186045585 true] [17592186290476 1069 "q-23631" 13194139533408 17592186045585 true] [17592186290476 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290476 1071 "Find the equation of the line containing the point $(-1,1)$ that is perpendicular to $2x-3y=-5.$" 13194139533408 17592186045585 true] [17592186290476 1072 #uuid "96f3c704-d5cd-55de-a550-62294d23b6d6" 13194139533408 17592186045585 true] [17592186290476 1074 "First, we write the equation $2x-3y=-5$ in its slope-intercept form, as follows:\n\n$$\n\\begin{aligned}2x-3y & =-5 \\\\ -3y & =-2x-5 \\\\ y & =\\frac{2}{3}x+\\frac{5}{3}\\end{aligned}\n$$\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of the new line should be the negative reciprocal of the slope of the given line $y=\\frac{2}{3}x+\\frac{5}{3}.$ The given line has a slope of $\\frac{2}{3},$ so our perpendicular line must have a slope of $-\\frac{3}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{3}{2}$ and pass through the point $({x}_{1},{y}_{1})=(-1,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{3}{2}(x-(-1)) \\\\ y-1 & =-\\frac{3}{2}(x+1) \\\\ y-1 & =-\\frac{3}{2}x-\\frac{3}{2} \\\\ y & =-\\frac{3}{2}x-\\frac{1}{2} \\\\ 2y & =-3x-1 \\\\ 3x+2y & =-1\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290477 1068 #edb/ref 17592186290204 13194139533408 17592186045585 true] [17592186290477 1069 "q-23640" 13194139533408 17592186045585 true] [17592186290477 1070 #edb/ref 17592186045486 13194139533408 17592186045585 true] [17592186290477 1071 "Simplify ${csc}^{4}⁡x-2{csc}^{2}⁡x\\cdot {cot}^{2}⁡x+{cot}^{4}⁡x.$" 13194139533408 17592186045585 true] [17592186290477 1072 #uuid "8dd70fdd-1e42-5626-9c90-56ff228e6dc2" 13194139533408 17592186045585 true] [17592186290477 1074 "First,  notice that the given expression is a perfect square:\n\n$$\n\\begin{aligned}{csc}^{4}⁡x-2{csc}^{2}⁡x\\,\\cdot \\,{cot}^{2}⁡x+{cot}^{4}⁡x & ={({csc}^{2}⁡x-{cot}^{2}⁡x)}^{2}\\end{aligned}\n$$\n\nNow, using the  identity ${csc}^{2}⁡x-{cot}^{2}⁡x=1$, we have\n\n$$\n\\begin{aligned}{({csc}^{2}⁡x-{cot}^{2}⁡x)}^{2} & =(1)^{2} \\\\  & =1.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290478 1068 #edb/ref 17592186289894 13194139533408 17592186045585 true] [17592186290478 1069 "q-23641" 13194139533408 17592186045585 true] [17592186290478 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290478 1071 "Simplify $4{csc}^{2}⁡(2x)+4{csc}^{2}⁡(2x)\\cdot {cot}^{2}⁡(2x).$" 13194139533408 17592186045585 true] [17592186290478 1072 #uuid "b551a57b-8ebe-5d22-82e3-03b19ea7ac17" 13194139533408 17592186045585 true] [17592186290478 1074 "First, we factor the $4{csc}^{2}⁡(2x)$ from the first two terms:\n\n$$\n\\begin{aligned}4{csc}^{2}⁡(2x)+4{csc}^{2}⁡(2x)\\cdot {cot}^{2}⁡(2x) & =4{csc}^{2}⁡(2x)\\cdot (1+{cot}^{2}⁡(2x))\\end{aligned}\n$$\n\nNow, using the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ we have\n\n$$\n\\begin{aligned}4{csc}^{2}⁡(2x)\\cdot (1+{cot}^{2}⁡(2x)) & =4{csc}^{2}⁡(2x)\\cdot {csc}^{2}⁡(2x) \\\\  & =4{csc}^{4}⁡(2x).\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290479 1068 #edb/ref 17592186289976 13194139533408 17592186045585 true] [17592186290479 1069 "q-23642" 13194139533408 17592186045585 true] [17592186290479 1070 #edb/ref 17592186045487 13194139533408 17592186045585 true] [17592186290479 1071 "Simplify ${csc}^{4}⁡\\theta -{cot}^{4}⁡\\theta -2{cot}^{2}⁡\\theta .$" 13194139533408 17592186045585 true] [17592186290479 1072 #uuid "4adf28a2-e005-5bdd-b207-f7c30d8f8ad8" 13194139533408 17592186045585 true] [17592186290479 1074 "First, let's recall the following identity:\n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, we get\n\n$$\n\\begin{aligned}{csc}^{4}⁡\\theta -{cot}^{4}⁡\\theta -2{cot}^{2}⁡\\theta  & ={csc}^{4}⁡\\theta -{({cot}^{2}⁡\\theta )}^{2}-2{cot}^{2}⁡\\theta  \\\\  & ={csc}^{4}⁡\\theta -({csc}^{2}⁡\\theta -1)^{2}-2({csc}^{2}⁡\\theta -1) \\\\  & ={csc}^{4}⁡\\theta -({csc}^{4}⁡\\theta -2{csc}^{2}⁡\\theta +1)-2{csc}^{2}⁡\\theta +2 \\\\  & ={csc}^{4}⁡\\theta -{csc}^{4}⁡\\theta +2{csc}^{2}⁡\\theta -1-2{csc}^{2}⁡\\theta +2 \\\\  & =\\cancel{{csc}^{4}⁡\\theta }-\\cancel{{csc}^{4}⁡\\theta }+\\cancel{2{csc}^{2}⁡\\theta }-1-\\cancel{2{csc}^{2}⁡\\theta }+2 \\\\  & =1.\\end{aligned}\n$$" 13194139533408 17592186045585 true] [17592186290480 1068 #edb/ref 17592186290066 13194139533408 17592186045585 true] [17592186290480 1069 "q-236890" 13194139533408 17592186045585 true] [17592186290480 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290480 1071 "Find the equation of the midline for a transformed sine function with a minimum value of $2$ and a maximum value of $10.$" 13194139533408 17592186045585 true] [17592186290480 1072 #uuid "2b9b62cc-429e-52b2-9f37-7f9e4fb21a23" 13194139533408 17592186045585 true] [17592186290480 1074 "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{2+10}{2} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the midline is $y=6.$" 13194139533408 17592186045585 true] [17592186290481 1068 #edb/ref 17592186289821 13194139533408 17592186045585 true] [17592186290481 1069 "q-236893" 13194139533408 17592186045585 true] [17592186290481 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290481 1071 "Find the equation of the midline for a transformed sine function with a minimum value of $-7$ and a maximum value of $3.$" 13194139533408 17592186045585 true] [17592186290481 1072 #uuid "250619d1-370b-5c0d-af5b-ed64a801198a" 13194139533408 17592186045585 true] [17592186290481 1074 "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-7+3}{2} \\\\  & =\\frac{-4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-2.$" 13194139533408 17592186045585 true] [17592186290482 1068 #edb/ref 17592186289826 13194139533408 17592186045585 true] [17592186290482 1069 "q-236899" 13194139533408 17592186045585 true] [17592186290482 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290482 1071 "Find the equation of the midline for a transformed cosine function with a minimum value of $6$ and a maximum value of $10.$" 13194139533408 17592186045585 true] [17592186290482 1072 #uuid "19d7902b-1be6-510b-930b-715d7217e72b" 13194139533408 17592186045585 true] [17592186290482 1074 "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{6+10}{2} \\\\  & =\\frac{16}{2} \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, the midline is $y=8.$" 13194139533408 17592186045585 true] [17592186290483 1068 #edb/ref 17592186290248 13194139533408 17592186045585 true] [17592186290483 1069 "q-236901" 13194139533408 17592186045585 true] [17592186290483 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290483 1071 "Find the equation of the midline for a transformed cosine function with a minimum value of $3$ and a maximum value of $15.$" 13194139533408 17592186045585 true] [17592186290483 1072 #uuid "d0c4be84-8850-5ae2-a033-a27a5aa083d4" 13194139533408 17592186045585 true] [17592186290483 1074 "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{3+15}{2} \\\\  & =\\frac{18}{2} \\\\  & =9.\\end{aligned}\n$$\n\nTherefore, the midline is $y=9.$" 13194139533408 17592186045585 true] [17592186290484 1068 #edb/ref 17592186289745 13194139533408 17592186045585 true] [17592186290484 1069 "q-236971" 13194139533408 17592186045585 true] [17592186290484 1070 #edb/ref 17592186045485 13194139533408 17592186045585 true] [17592186290484 1071 "Consider the function $f(x)=\\frac{2}{3}\\operatorname{sin}⁡(3x).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its maximum value? Assume that $n$ is an integer." 13194139533408 17592186045585 true] [17592186290484 1072 #uuid "7caa2144-9fd2-5d73-bd9e-432e5c2fb4d1" 13194139533408 17592186045585 true] [17592186290484 1074 "First, let's start by defining a new variable $X$ as\n\n$$\nX=3x.\n$$\n\nSo, we need to calculate $X$-values at the maxima of\n\n$$\ny=\\frac{2}{3}\\operatorname{sin}⁡X.\n$$\n\n \n\nThe $X$-values at the maxima are given by the following expression:\n\n$$\nX={90}^{∘}+{360}^{∘}\\cdot n\n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the maxima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+{360}^{∘}\\cdot n \\\\ 3x & ={90}^{∘}+{360}^{∘}\\cdot n \\\\ x & ={30}^{∘}+{120}^{∘}\\cdot n\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that maximize $f(x)$ are given by $x={30}^{∘}+{120}^{∘}\\cdot n,$ where $n$ is an integer." 13194139533408 17592186045585 true] [17592186290485 1068 #edb/ref 17592186289835 13194139533408 17592186045585 true] [17592186290485 1068 #edb/ref 17592186289838 13194139533408 17592186045585 true] [17592186290485 1068 #edb/