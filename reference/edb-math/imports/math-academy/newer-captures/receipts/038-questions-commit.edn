4}) \\\\  & =-3(1-{e}^{4}) \\\\  & =3{e}^{4}-3\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323790 1068 #edb/ref 17592186323286 13194139533421 17592186045585 true] [17592186323790 1068 #edb/ref 17592186323353 13194139533421 17592186045585 true] [17592186323790 1068 #edb/ref 17592186323416 13194139533421 17592186045585 true] [17592186323790 1069 "q-362768" 13194139533421 17592186045585 true] [17592186323790 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323790 1071 "Find the second-degree Taylor polynomial ${P}_{2}(x)$ of $f(x)=\\operatorname{arctan}⁡(1+2x)$ about $x=0.$\n\n${P}_{2}(x)=$\n{{field-1}}\n$+$\n{{field-2}}\n$x\\,\\,-$\n{{field-3}}\n${x}^{2}$" 13194139533421 17592186045585 true] [17592186323790 1072 #uuid "6f2d8d45-de04-5902-9fa1-4ed5cdd61e7c" 13194139533421 17592186045585 true] [17592186323790 1074 "To find the second-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(0)+{f}^{′}(0)(x-0)+\\frac{1}{2}{f}^{″}(0)(x-0)^{2}.\n$$\n\nSo, we need to work out $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0):$ \n\n$$\n\\begin{aligned}f(x) & =\\operatorname{arctan}⁡(1+2x) & ⟹ &  & f(0) & =\\frac{\\pi }{4} \\\\ {f}^{′}(x) & =\\frac{2}{1+(1+2x)^{2}} & ⟹ &  & {f}^{′}(0) & =1 \\\\ {f}^{″}(x) & =-\\frac{8(1+2x)}{(1+(1+2x)^{2})^{2}} & ⟹ &  & {f}^{″}(0) & =-2\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =\\frac{\\pi }{4}+x+\\frac{(-2)}{2}{x}^{2} \\\\  & =\\frac{\\pi }{4}+1\\,x-1\\,{x}^{2}.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323791 1068 #edb/ref 17592186323607 13194139533421 17592186045585 true] [17592186323791 1069 "q-362769" 13194139533421 17592186045585 true] [17592186323791 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323791 1071 "Find the coefficient of $(x-1)^{2}$ in the second-degree Taylor polynomial of $f(x)={e}^{2x}$ at $x=1.$ Do not round the answer.\n\nThe coefficient of $(x-1)^{2}$ is\n{{field-1}}." 13194139533421 17592186045585 true] [17592186323791 1072 #uuid "18160831-71f3-5052-93e3-782ef1ddb3b9" 13194139533421 17592186045585 true] [17592186323791 1074 "The second-degree Taylor polynomial of $f(x)$ about $x=1$ is given by\n\n$$\n{P}_{2}(x)=f(1)+{f}^{′}(1)(x-1)+\\frac{{f}^{″}(1)}{2}(x-1)^{2}.\n$$\n\nThe coefficient of $(x-1)^{2}$ in the above Taylor polynomial is\n\n$$\n\\frac{{f}^{″}(1)}{2}.\n$$\n\nTo find this coefficient, we start by computing the second derivative ${f}^{″}(x):$\n\n$$\n\\begin{aligned}f(x) & ={e}^{2x} \\\\ {f}^{′}(x) & =2{e}^{2x} \\\\ {f}^{″}(x) & =4{e}^{2x}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{″}(x)$ at $x=1.$ This gives\n\n$$\n{f}^{″}(1)=4{e}^{2\\cdot 1}=4{e}^{2}.\n$$\n\nFinally, we determine the coefficient of $(x-1)^{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{{f}^{″}(1)}{2}=\\frac{4{e}^{2}}{2}=2{e}^{2}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323792 1068 #edb/ref 17592186323555 13194139533421 17592186045585 true] [17592186323792 1069 "q-362771" 13194139533421 17592186045585 true] [17592186323792 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323792 1071 "What is the coefficient of ${(x+1)}^{2}$ in the second-degree Taylor polynomial of $f(x)={e}^{-2x}$ at $x=-1?$\n\nThe coefficient of ${(x+1)}^{2}$ is\n{{field-1}}." 13194139533421 17592186045585 true] [17592186323792 1072 #uuid "d1820771-3f11-505d-8882-7301bc9a6bac" 13194139533421 17592186045585 true] [17592186323792 1074 "The second-degree Taylor polynomial of $f(x)$ about $x=-1$ is given by\n\n$$\n\\begin{aligned}{P}_{2}(x) & =f(-1)+{f}^{′}(-1)(x+1)+\\frac{{f}^{″}(-1)}{2}{(x+1)}^{2}.\\end{aligned}\n$$\n\nThe coefficient of ${(x+1)}^{2}$ in the above Taylor polynomial is \n\n$$\n\\frac{{f}^{″}(-1)}{2}.\n$$\n\nTo find this coefficient, we start by computing the second derivative ${f}^{″}(x):$ \n\n$$\n\\begin{aligned}f(x) & ={e}^{-2x} \\\\ {f}^{′}(x) & =-2{e}^{-2x} \\\\ {f}^{″}(x) & =4{e}^{-2x}\\end{aligned}\n$$\n\nThen, we evaluate ${f}^{″}(x)$ at $x=-1.$ This gives\n\n$$\n{f}^{″}(-1)=4{e}^{-2(-1)}=4{e}^{2}.\n$$\n\nFinally, we determine the coefficient of ${(x+1)}^{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{{f}^{″}(-1)}{2} & =\\frac{4{e}^{2}}{2}=2{e}^{2}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323793 1068 #edb/ref 17592186323252 13194139533421 17592186045585 true] [17592186323793 1069 "q-362804" 13194139533421 17592186045585 true] [17592186323793 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323793 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{{csc}^{4}⁡x-1}{{csc}^{2}⁡x+1}\\,\\text{d}x=$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323793 1072 #uuid "053d1129-5ad9-5392-8059-7eab09c97e80" 13194139533421 17592186045585 true] [17592186323793 1074 "In this case, we have to use the identity\n\n$$\n1+{cot}^{2}⁡x={csc}^{2}⁡x\\,⟹\\,{cot}^{2}⁡x={csc}^{2}⁡x-1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{{csc}^{4}⁡x-1}{{csc}^{2}⁡x+1}\\,\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{({csc}^{2}⁡x-1)({csc}^{2}⁡x+1)}{{csc}^{2}⁡x+1}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x}({csc}^{2}⁡x-1)\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x}\\cdot {cot}^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /4}\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\,{|}_{\\pi /6}^{\\pi /4} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4})-\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{2}}{2}-\\frac{1}{2} \\\\  & =\\frac{\\sqrt{2}-1}{2}.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323794 1068 #edb/ref 17592186323350 13194139533421 17592186045585 true] [17592186323794 1069 "q-362808" 13194139533421 17592186045585 true] [17592186323794 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323794 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\sqrt{e-1}}\\frac{x}{{csc}^{2}⁡x+{x}^{2}-{cot}^{2}⁡x}\\,\\text{d}x=$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323794 1072 #uuid "5dff4098-444a-5a55-8bfc-1532ab8b0e5e" 13194139533421 17592186045585 true] [17592186323794 1074 "In this case, we have to use the identity\n\n$$\n1+{cot}^{2}⁡x={csc}^{2}⁡x\\,⟹\\,{csc}^{2}⁡x-{cot}^{2}⁡x=1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\sqrt{e-1}}\\frac{x}{{csc}^{2}⁡x+{x}^{2}-{cot}^{2}⁡x}\\,\\text{d}x & ={\\int }_{1}^{\\sqrt{e-1}}\\frac{x}{({csc}^{2}⁡x-{cot}^{2}⁡x)+{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\sqrt{e-1}}\\frac{x}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(1+{x}^{2})\\,{|}_{1}^{\\sqrt{e-1}} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(1+(\\sqrt{e-1})^{2})-\\frac{1}{2}\\operatorname{ln}⁡(1+(1)^{2}) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(1+e-1)-\\frac{1}{2}\\operatorname{ln}⁡(1+1) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(e)-\\frac{1}{2}\\operatorname{ln}⁡(2) \\\\  & =\\frac{1}{2}(1)-\\frac{\\operatorname{ln}⁡2}{2} \\\\  & =\\frac{1-\\operatorname{ln}⁡2}{2}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323795 1068 #edb/ref 17592186323464 13194139533421 17592186045585 true] [17592186323795 1069 "q-362813" 13194139533421 17592186045585 true] [17592186323795 1070 #edb/ref 17592186045486 13194139533421 17592186045585 true] [17592186323795 1071 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}[3{x}^{2}{csc}^{2}⁡(3x-\\frac{\\pi }{4})-3{x}^{2}{cot}^{2}⁡(3x-\\frac{\\pi }{4})]\\,\\text{d}x=$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323795 1072 #uuid "b1121df9-77eb-53e7-89a0-4484c3b94fe1" 13194139533421 17592186045585 true] [17592186323795 1074 "From the identity ${csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta =1$ with $\\theta =3x-\\frac{\\pi }{4},$ we get \n\n$$\n{csc}^{2}⁡(3x-\\frac{\\pi }{4})-{cot}^{2}⁡(3x-\\frac{\\pi }{4})=1.\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[3{x}^{2}{csc}^{2}⁡(3x-\\frac{\\pi }{4})-3{x}^{2}{cot}^{2}⁡(3x-\\frac{\\pi }{4})]\\,\\text{d}x & ={\\int }_{0}^{1}3{x}^{2}[{csc}^{2}⁡(3x-\\frac{\\pi }{4})-{cot}^{2}⁡(3x-\\frac{\\pi }{4})]\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}(1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}\\,\\text{d}x \\\\  & ={x}^{3}\\,{|}_{0}^{1} \\\\  & ={1}^{3}-{0}^{3} \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323796 1068 #edb/ref 17592186323623 13194139533421 17592186045585 true] [17592186323796 1069 "q-36290" 13194139533421 17592186045585 true] [17592186323796 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323796 1071 "Find the directional derivative of the function $f(x,y)=x{e}^{y}+{x}^{2}y$ at the point $A(1,0)$ in the direction towards the point $B(0,1).$" 13194139533421 17592186045585 true] [17592186323796 1072 #uuid "0cd131d3-dbf5-532a-a1c1-f69d113636a0" 13194139533421 17592186045585 true] [17592186323796 1074 "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,1⟩-⟨1,0⟩ \\\\  & =⟨-1,1⟩ \\\\ u & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}}}⟨-1,1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $∇f(x,y)$ and evaluate it at the point $A(1,0):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =⟨\\frac{∂}{∂x}(x{e}^{y}+{x}^{2}y),\\,\\frac{∂}{∂y}(x{e}^{y}+{x}^{2}y)⟩ \\\\  & =⟨{e}^{y}+2xy,\\,x{e}^{y}+{x}^{2}⟩ \\\\ ∇\\,f(1,0) & =⟨{e}^{0}+2\\cdot 1\\cdot 0,\\,1\\cdot {e}^{0}+{1}^{2}⟩ \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is:\n\n$$\n\\begin{aligned}{f}_{u}^{′}(1,0) & =∇f(1,0)\\cdot u \\\\  & =⟨1,\\,2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323797 1068 #edb/ref 17592186323482 13194139533421 17592186045585 true] [17592186323797 1069 "q-36300" 13194139533421 17592186045585 true] [17592186323797 1070 #edb/ref 17592186045486 13194139533421 17592186045585 true] [17592186323797 1071 "Consider the function $f(x,y)=2xy+{e}^{3x-y}.$ What is the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction in which the function decreases most rapidly?" 13194139533421 17592186045585 true] [17592186323797 1072 #uuid "a13cba05-5f4a-5d75-8f65-f72eb54e0d73" 13194139533421 17592186045585 true] [17592186323797 1074 "At a given point, a function $f(x,y)$ decreases most rapidly in the opposite direction of its gradient at that point.\n\nIn our case, we compute $-∇f(x,y)$ and evaluate it at the point $(1,3):$\n\n$$\n\\begin{aligned}-∇\\,f(x,y) & =-\\frac{∂}{∂x}(2xy+{e}^{3x-y})\\text{ }i-\\frac{∂}{∂y}(2xy+{e}^{3x-y})\\text{ }j \\\\  & =-(2y+3{e}^{3x-y})\\text{ }i-(2x-{e}^{3x-y})\\text{ }j \\\\ -∇\\,f(1,3) & =-(2\\cdot 3+3\\cdot {e}^{3\\cdot 1-3})\\text{ }i-(2\\cdot 1-{e}^{3\\cdot 1-3})\\text{ }j \\\\  & =-9\\text{ }i-\\text{ }j\\end{aligned}\n$$\n\nFinally, the rate of change of $f(x,y)$ at the point $(1,3)$ in the direction of $-∇f(1,3)$ is given by\n\n$$\n\\begin{aligned}‖-∇\\,f(1,3)‖ & =‖-9\\text{ }i-\\text{ }j‖ \\\\  & =\\sqrt{(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{82}.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323798 1068 #edb/ref 17592186323345 13194139533421 17592186045585 true] [17592186323798 1069 "q-36301" 13194139533421 17592186045585 true] [17592186323798 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323798 1071 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $x=-2.$ Given that the point $P(-2,0,8)$ lies on $C$, and that ${f}_{y}=x\\operatorname{cos}⁡y+4y+x$, find the equations of the tangent line to $C$ at $P.$" 13194139533421 17592186045585 true] [17592186323798 1072 #uuid "daecb367-4754-591f-93db-eaa083b20ffe" 13194139533421 17592186045585 true] [17592186323798 1074 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=-2.$ Hence, the slope of the tangent to the curve at the point $P(-2,0,8)$ will be given by the partial derivative $\\frac{∂z}{∂y}{|}_{(-2,0)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂y}$ at $(-2,0):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂y}{|}_{(-2,0)} & =(-2)\\operatorname{cos}⁡0+4(0)+(-2) \\\\  & =-2-2 \\\\  & =-4\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(-2,0)} & =\\frac{∂z}{∂y}{|}_{(-2,0)}(y-0) \\\\ z-8 & =-4(y-0) \\\\ z & =-4y+8\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(-2,0,8)$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}x=-2 \\\\ z=-4y+8\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323799 1068 #edb/ref 17592186323391 13194139533421 17592186045585 true] [17592186323799 1069 "q-36333" 13194139533421 17592186045585 true] [17592186323799 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323799 1071 "Given the function $f(x,y,z)=\\frac{{x}^{2}}{2}+{y}^{2}-{z}^{2}$, find the equation of the tangent plane to the level surface that passes through the point where $(x,y,z)=(4,-1,3).$" 13194139533421 17592186045585 true] [17592186323799 1072 #uuid "7c0d0984-d156-5a55-aaf0-4f9f76ce0b35" 13194139533421 17592186045585 true] [17592186323799 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(4,-1,3):$  \n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{2}}{2}+{y}^{2}-{z}^{2})i+\\frac{∂}{∂y}(\\frac{{x}^{2}}{2}+{y}^{2}-{z}^{2})j+\\frac{∂}{∂z}(\\frac{{x}^{2}}{2}+{y}^{2}-{z}^{2})k \\\\  & =x\\text{ }i+2y\\text{ }j-2z\\text{ }k \\\\ ∇f(4,-1,3) & =(4)\\text{ }i+2(-1)\\text{ }j-2(3)\\text{ }k \\\\  & =4i-2j-6k \\\\  & =⟨4,\\,-2,\\,-6⟩\\end{aligned}\n$$\n\n \n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(4,-1,3)\\cdot ⟨x-4,\\,y-(-1),\\,z-3⟩ & =0 \\\\ ⟨4,\\,-2,\\,-6⟩\\cdot ⟨x-4,\\,y+1,\\,z-3⟩ & =0 \\\\ 4(x-4)-2(y+1)-6(z-3) & =0 \\\\ 4x-2y-6z & =0 \\\\ 2x-y-3z & =0\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323800 1068 #edb/ref 17592186323605 13194139533421 17592186045585 true] [17592186323800 1069 "q-36346" 13194139533421 17592186045585 true] [17592186323800 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323800 1071 "Find a unit normal vector to the level curve of the function $g(x,y)=\\operatorname{ln}⁡(xy)$ that passes through the point where $(x,y)=(1,1).$" 13194139533421 17592186045585 true] [17592186323800 1072 #uuid "51e044b0-3c0e-5644-831b-0d5fd92a4af2" 13194139533421 17592186045585 true] [17592186323800 1074 "A normal vector to the level curve that passes through the point  where $(x,y)=(1,1)$, can be found by computing $∇g(1,1).$ \n\nSo, we first find the gradient of $g(x,y)$ and evaluate it at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}∇g(x,y) & ={g}_{x}(x,y)\\,i+{g}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))\\,j \\\\  & =\\frac{1}{xy}\\cdot y\\,i+\\frac{1}{xy}\\cdot x\\,j \\\\  & =\\frac{1}{x}\\,i+\\frac{1}{y}\\,j \\\\ ∇g(1,1) & =\\frac{1}{(1)}\\,i+\\frac{1}{(1)}\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇g(1,1):$\n\n$$\n\\begin{aligned}\\frac{∇g(1,1)}{‖∇g(1,1)‖} & =\\frac{i+j}{\\sqrt{{1}^{2}+{1}^{2}}} \\\\  & =\\frac{\\sqrt{2}}{2}(i+j)\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323801 1068 #edb/ref 17592186323487 13194139533421 17592186045585 true] [17592186323801 1069 "q-36347" 13194139533421 17592186045585 true] [17592186323801 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323801 1071 "Consider the plane curve $2xy+6{y}^{2}=x-2.$  Find the equation of the normal line to the curve at the point $(8,-3).$" 13194139533421 17592186045585 true] [17592186323801 1072 #uuid "66ea4a99-e9fe-52c8-93b3-5bc45407e7da" 13194139533421 17592186045585 true] [17592186323801 1074 "First, we bring all variables to one side: \n\n$$\n\\begin{aligned}2xy+6{y}^{2} & =x-2 \\\\ 2xy+6{y}^{2}-x & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)=2xy+6{y}^{2}-x$, our curve can be viewed as the level curve $f(x,y)=-2.$   \n\nA normal vector to the level curve that passes through the point $(8,-3)$ can be found by computing $∇f(8,-3).$ \n\nSo, we find the gradient and evaluate it at $(8,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2xy+6{y}^{2}-x)\\,i+\\frac{∂}{∂y}(2xy+6{y}^{2}-x)\\,j \\\\  & =(2y-1)\\,i+(2x+12y)\\,j \\\\ ∇f(8,-3) & =(2(-3)-1)\\,i+(2(8)+12(-3))\\,j \\\\  & =-7\\,i-20\\,j \\\\  & =⟨-7,-20⟩\\end{aligned}\n$$\n\n Hence, $∇f(8,-3)=⟨-7,-20⟩$ is a normal vector to the curve at $(8,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as: \n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-8}{-7} & =\\frac{y-(-3)}{-20} \\\\ -20(x-8) & =-7(y+3) \\\\ -20x+7y+160+21 & =0 \\\\ -20x+7y+181 & =0\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323802 1068 #edb/ref 17592186323369 13194139533421 17592186045585 true] [17592186323802 1069 "q-363485" 13194139533421 17592186045585 true] [17592186323802 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323802 1071 "Use the first three non-zero terms of the Taylor expansion of $f(x)={2}^{x}$ about $x=2$ to approximate the value of ${2}^{2.1}.$ Round your answer to **two decimal places**.\n\n${2}^{2.1}≈$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323802 1072 #uuid "81c9f782-ecf0-5e7b-a8aa-08e741da57f8" 13194139533421 17592186045585 true] [17592186323802 1074 "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)={2}^{x}$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & ={2}^{x} \\\\ f(2) & =4 \\\\ {f}^{′}(x) & ={2}^{x}\\operatorname{ln}⁡2 \\\\ {f}^{′}(2) & =4\\operatorname{ln}⁡2 \\\\ {f}^{″}(x) & ={2}^{x}(\\operatorname{ln}⁡2)^{2} \\\\ {f}^{″}(2) & =4(\\operatorname{ln}⁡2)^{2}.\\end{aligned}\n$$\n\nSo, the Taylor expansion is\n\n$$\n{2}^{x}=4+4(\\operatorname{ln}⁡2)(x-2)+\\frac{4(\\operatorname{ln}⁡2)^{2}}{2!}(x-2)^{2}+⋯,\n$$\n\nwhich simplifies to\n\n$$\n{2}^{x}=4+4(\\operatorname{ln}⁡2)(x-2)+2(\\operatorname{ln}⁡2)^{2}(x-2)^{2}+⋯.\n$$\n\nWe substitute $x=2.1.$ Since $2.1-2=0.1=\\frac{1}{10},$ we obtain\n\n$$\n\\begin{aligned}{2}^{2.1} & ≈4+4(\\operatorname{ln}⁡2)(\\frac{1}{10})+2(\\operatorname{ln}⁡2)^{2}{(\\frac{1}{10})}^{2} \\\\  & ≈4.29.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{2}^{2.1}≈4.29.\n$$" 13194139533421 17592186045585 true] [17592186323803 1068 #edb/ref 17592186323385 13194139533421 17592186045585 true] [17592186323803 1069 "q-363486" 13194139533421 17592186045585 true] [17592186323803 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323803 1071 "Use the first three non-zero terms of the Taylor expansion of $f(x)={5}^{x}$ about $x=1$ to approximate the value of ${5}^{1.3}.$ Round your answer to **one decimal place**.\n\n${5}^{1.3}≈$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323803 1072 #uuid "d857d55e-0426-522a-bbf3-e599533bce03" 13194139533421 17592186045585 true] [17592186323803 1074 "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)={5}^{x}$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & ={5}^{x} \\\\ f(1) & =5 \\\\ {f}^{′}(x) & ={5}^{x}\\operatorname{ln}⁡5 \\\\ {f}^{′}(1) & =5\\operatorname{ln}⁡5 \\\\ {f}^{″}(x) & ={5}^{x}(\\operatorname{ln}⁡5)^{2} \\\\ {f}^{″}(1) & =5(\\operatorname{ln}⁡5)^{2}.\\end{aligned}\n$$\n\nSo, the Taylor expansion is\n\n$$\n{5}^{x}=5+5(\\operatorname{ln}⁡5)(x-1)+\\frac{5(\\operatorname{ln}⁡5)^{2}}{2!}(x-1)^{2}+⋯,\n$$\n\nwhich simplifies to\n\n$$\n{5}^{x}=5+5(\\operatorname{ln}⁡5)(x-1)+\\frac{5(\\operatorname{ln}⁡5)^{2}}{2}(x-1)^{2}+⋯.\n$$\n\nWe substitute $x=1.3.$ Since $1.3-1=0.3=\\frac{3}{10},$ we obtain\n\n$$\n\\begin{aligned}{5}^{1.3} & ≈5+5(\\operatorname{ln}⁡5)(\\frac{3}{10})+\\frac{5(\\operatorname{ln}⁡5)^{2}}{2}{(\\frac{3}{10})}^{2} \\\\  & ≈8.0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{5}^{1.3}≈8.0.\n$$" 13194139533421 17592186045585 true] [17592186323804 1068 #edb/ref 17592186323509 13194139533421 17592186045585 true] [17592186323804 1069 "q-363490" 13194139533421 17592186045585 true] [17592186323804 1070 #edb/ref 17592186045486 13194139533421 17592186045585 true] [17592186323804 1071 "For the parametric curve \n\n$$\nx={e}^{3/t},\\,y=\\frac{1}{\\sqrt{{t}^{2}+4}},\\,0<t<\\infty ,\n$$\n\ncalculate the slope $m$ of the tangent to the curve at the point where $t=1.$ Do not round the answer.\n\n$m=$ \n{{field-1}}" 13194139533421 17592186045585 true] [17592186323804 1072 #uuid "ae92af54-aa04-5ea8-bfcd-575703012570" 13194139533421 17592186045585 true] [17592186323804 1074 "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-\\frac{3}{{t}^{2}}{e}^{3/t},\\,{y}^{′}(t)=-\\frac{t}{({t}^{2}+4)^{3/2}}.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(-\\frac{t}{({t}^{2}+4)^{3/2}})}{(-\\frac{3}{{t}^{2}}{e}^{3/t})} \\\\  & =\\frac{{t}^{3}}{3({t}^{2}+4)^{3/2}\\,{e}^{3/t}}.\\end{aligned}\n$$\n\nTherefore, when $t=1,$ the slope $m$ of the tangent to the curve is\n\n$$\n\\begin{aligned}m=\\frac{dy}{dx}\\,{|}_{t\\,=\\,1} & =\\frac{{1}^{3}}{3({1}^{2}+4)^{3/2}\\,{e}^{3}} \\\\  & =\\frac{1}{3(5)^{3/2}\\,{e}^{3}} \\\\  & =\\frac{1}{15\\sqrt{5}\\,{e}^{3}} \\\\  & =\\frac{\\sqrt{5}}{75{e}^{3}}.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323805 1068 #edb/ref 17592186323599 13194139533421 17592186045585 true] [17592186323805 1069 "q-36355" 13194139533421 17592186045585 true] [17592186323805 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323805 1071 "Let $B={{b}_{1},{b}_{2}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{2}.$ If ${b}_{1}=5{c}_{2}-3{c}_{1}$ and ${b}_{2}=2{c}_{1}-4{c}_{2},$ find the change-of-coordinates matrix ${P}_{B\\to C}$ from $B$ to $C.$" 13194139533421 17592186045585 true] [17592186323805 1072 #uuid "b80daa7e-24b9-50c1-a8b6-05bfcb214049" 13194139533421 17592186045585 true] [17592186323805 1074 "The coordinates of the vectors in $B$ relative to the basis $C$ are\n\n$$\n[{b}_{1}]_{C}=[\\begin{aligned}-3 \\\\ 5\\end{aligned}]\\,[{b}_{2}]_{C}=[\\begin{aligned}2 \\\\ -4\\end{aligned}].\n$$\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose respective columns are the coordinates of the vectors of $B$ relative to the basis $C.$ \n\nTherefore, we obtain\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-3 & 2 \\\\ 5 & -4\\end{aligned}].\n$$" 13194139533421 17592186045585 true] [17592186323806 1068 #edb/ref 17592186323330 13194139533421 17592186045585 true] [17592186323806 1068 #edb/ref 17592186323404 13194139533421 17592186045585 true] [17592186323806 1068 #edb/ref 17592186323628 13194139533421 17592186045585 true] [17592186323806 1069 "q-363670" 13194139533421 17592186045585 true] [17592186323806 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323806 1071 "Find the interval of convergence for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{{4}^{n}{x}^{n}}{{n}^{2}+4n}=\\frac{4x}{1\\cdot 5}+\\frac{{4}^{2}{x}^{2}}{2\\cdot 6}+\\frac{{4}^{3}{x}^{3}}{3\\cdot 7}+\\frac{{4}^{4}{x}^{4}}{4\\cdot 8}+⋯\\,.\n$$\n\nThe interval of convergence is\n{{field-1}}{{field-2}}\n$x\\le $\n{{field-3}}." 13194139533421 17592186045585 true] [17592186323806 1072 #uuid "b4fa36c1-317a-525a-ac54-0f6a26d5b0e3" 13194139533421 17592186045585 true] [17592186323806 1074 "To apply the ratio test we define ${a}_{n}=\\frac{{4}^{n}{x}^{n}}{{n}^{2}+4n}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{{4}^{n+1}{x}^{n+1}}{(n+1)^{2}+4(n+1)}\\cdot \\frac{{n}^{2}+4n}{{4}^{n}{x}^{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{4x({n}^{2}+4n)}{{n}^{2}+6n+5}| \\\\  & =|4x|\\cdot {lim}_{n\\to \\infty }\\frac{{n}^{2}+4n}{{n}^{2}+6n+5} \\\\  & =|4x|\\cdot 1 \\\\  & =|4x|\\end{aligned}\n$$\n\nThe series converges if $L<1.$ In this case, the convergence condition is satisfied for $|4x|<1,$ which means $|x|<\\frac{1}{4}.$ So, the radius of convergence is $\\frac{1}{4},$ and the series converges for any $x$ that lies in the open interval $(-\\frac{1}{4},\\frac{1}{4}).$\n\nThe ratio test gives no conclusion about the convergence of the series when $L=1.$ So, when $|x|=\\frac{1}{4},$ we do not know if the series converges. This means that the endpoints $x=-\\frac{1}{4}$ and $x=\\frac{1}{4}$ need to be investigated separately using another test for convergence.\n\n- When $x=\\frac{1}{4}$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{{4}^{n}{x}^{n}}{{n}^{2}+4n} & ={\\sum }_{n=1}^{\\infty }\\frac{{4}^{n}{(1/4)}^{n}}{{n}^{2}+4n} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2}+4n} \\\\  & =\\frac{1}{1\\cdot 5}+\\frac{1}{2\\cdot 6}+\\frac{1}{3\\cdot 7}+\\frac{1}{4\\cdot 8}+⋯,\\end{aligned}\n$$\n\nwhich is convergent by the direct comparison test with the convergent $p$-series $\\sum \\frac{1}{{n}^{2}}.$ So the endpoint $x=\\frac{1}{4}$ is included in our interval.\n\n- When $x=-\\frac{1}{4}$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{{4}^{n}{x}^{n}}{{n}^{2}+4n} & ={\\sum }_{n=1}^{\\infty }\\frac{{4}^{n}{(-1/4)}^{n}}{{n}^{2}+4n} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}+4n} \\\\  & =-\\frac{1}{1\\cdot 5}+\\frac{1}{2\\cdot 6}-\\frac{1}{3\\cdot 7}+\\frac{1}{4\\cdot 8}-⋯,\\end{aligned}\n$$\n\nwhich is convergent by the alternating series test. So the endpoint $x=-\\frac{1}{4}$ is included in our interval.\n\nTherefore, the interval of convergence is $[-\\frac{1}{4},\\frac{1}{4}],$ or equivalently, $-\\frac{1}{4}\\le x\\le \\frac{1}{4}.$" 13194139533421 17592186045585 true] [17592186323807 1068 #edb/ref 17592186323411 13194139533421 17592186045585 true] [17592186323807 1069 "q-36388" 13194139533421 17592186045585 true] [17592186323807 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323807 1071 "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3}=1$, find the domain of $z=z(x,y).$" 13194139533421 17592186045585 true] [17592186323807 1072 #uuid "e7388c8d-bcb0-58d2-b80f-408abd20ed3a" 13194139533421 17592186045585 true] [17592186323807 1074 "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3} & =1 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & =\\frac{(z+1)^{2}}{3} \\\\ (z+1)^{2} & =3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1) \\\\ (z+1) & =\\pm \\sqrt{3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1)}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}.\n$$" 13194139533421 17592186045585 true] [17592186323808 1068 #edb/ref 17592186323301 13194139533421 17592186045585 true] [17592186323808 1069 "q-36441" 13194139533421 17592186045585 true] [17592186323808 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323808 1071 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $x=0.5.$ Given that the point $P(0.5,2,4)$ lies on $C$, and that ${f}_{y}=y+2y\\operatorname{ln}⁡(xy)+\\frac{1}{x}$, find the equations of the tangent line to $C$ at $P.$" 13194139533421 17592186045585 true] [17592186323808 1072 #uuid "12d0b28e-9c11-5054-bcb2-feb86bd6fc4d" 13194139533421 17592186045585 true] [17592186323808 1074 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=0.5.$ Hence, the slope of the tangent to the curve at the point $P(0.5,2,4)$ will be given by the partial derivative $\\frac{∂z}{∂y}{|}_{(0.5,2)}.$ \n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂y}$ at $(0.5,2):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂y}{|}_{(0.5,2)} & =2+2(2)\\operatorname{ln}⁡((0.5)(2))+\\frac{1}{0.5} \\\\  & =2+4\\operatorname{ln}⁡1+2 \\\\  & =4\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line: \n\n$$\n\\begin{aligned}z-z{|}_{(0.5,2)} & =\\frac{∂z}{∂y}{|}_{(0.5,2)}(y-2) \\\\ z-4 & =4(y-2) \\\\ z & =4y-4\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(0.5,2,4)$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}x=0.5 \\\\ z=4y-4\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323809 1068 #edb/ref 17592186323559 13194139533421 17592186045585 true] [17592186323809 1069 "q-364578" 13194139533421 17592186045585 true] [17592186323809 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323809 1071 "![](images/73/732c560cfab8b78b2f37ae6623567be2ec2934b34d9b5b40d1c9bebcf0f9e92c.png)\n\nEstimate the area $A$ under the curve $y={x}^{2}+2$ over the interval $[0,6]$ using the trapezoidal rule with $3$ trapezoids of equal height. Do not round the answer.\n\n$A≈$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323809 1072 #uuid "b29631a8-f094-5100-a970-2fda9a59a080" 13194139533421 17592186045585 true] [17592186323809 1074 "Let $f(x)={x}^{2}+2$ and let $A$ denote the required area. The general formula for the trapezoidal rule states that\n\n$$\nA≈\\frac{1}{2}[f(a)+2(f({x}_{1})+f({x}_{2})+…+f({x}_{n-1}))+f(b)]Δx,\n$$\n\nwhere $n$ is the number of trapezoids and $Δx=\\frac{b-a}{n}$ is the step size.\n\nHere, we have the following values:\n\n- The number of trapezoids is $n=3.$\n\n- The corresponding interval is $[0,6],$ so we have $a=0$ and $b=6.$\n\n- The step size is given by\n\n$$\nΔx=\\frac{b-a}{n}=\\frac{6-0}{3}=2.\n$$\n\nUsing the above values, the general formula becomes\n\n$$\nA≈\\frac{1}{2}[f(0)+2(f(2)+f(4))+f(6)]\\cdot 2.\n$$\n\nTo identify the function values, we now set up a table with the values of $x$ and $f(x):$\n\n| $x$ | $0$ | $2$ | $4$ | $6$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $2$ | $6$ | $18$ | $38$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\nA≈\\frac{1}{2}\\cdot [2+2(6+18)+38]\\cdot 2=88\n$$\n\nBecause the function is *concave up* over the interval $[0,6],$ the trapezoids lie over the function, and therefore the approximation is an *overestimate* of the correct area." 13194139533421 17592186045585 true] [17592186323810 1068 #edb/ref 17592186323611 13194139533421 17592186045585 true] [17592186323810 1069 "q-364580" 13194139533421 17592186045585 true] [17592186323810 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323810 1071 "![](images/24/24fd0ccf835405c3da099e0993a3cebe6711ecd2f0c4c1e960275be3dad032aa.png)\n\nEstimate the area under the curve $y=\\frac{120}{{x}^{2}-1}$ over the interval $[2,4]$ using the trapezoidal rule with $2$ trapezoids of equal height. Do not round the answer.\n\n$A≈$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323810 1072 #uuid "3a92ba77-683b-57be-ba26-0a06f0c078f2" 13194139533421 17592186045585 true] [17592186323810 1074 "Let $f(x)=\\frac{120}{{x}^{2}-1}$ and let $A$ denote the required area. The general formula for the trapezoidal rule states that\n\n$$\nA≈\\frac{1}{2}[f(a)+2(f({x}_{1})+f({x}_{2})+…+f({x}_{n-1}))+f(b)]Δx,\n$$\n\nwhere $n$ is the number of trapezoids and $Δx=\\frac{b-a}{n}$ is the step size.\n\nHere, we have the following values:\n\n- The number of trapezoids is $n=2.$\n\n- The corresponding interval is $[2,4],$ so we have $a=2$ and $b=4.$\n\n- The step size is given by\n\n$$\nΔx=\\frac{b-a}{n}=\\frac{4-2}{2}=1.\n$$\n\nUsing the above values, the general formula becomes\n\n$$\nA≈\\frac{1}{2}[f(2)+2f(3)+f(4)]\\cdot 1.\n$$\n\nTo identify the function values, we now set up a table with the values of $x$ and $f(x):$\n\n| $x$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $40$ | $15$ | $8$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\nA≈\\frac{1}{2}\\cdot [40+2(15)+8]\\cdot 1=39\n$$\n\nBecause the function is *concave up* over the interval $[2,4],$ the trapezoids lie over the function, and therefore approximation is an *overestimate* of the correct area." 13194139533421 17592186045585 true] [17592186323811 1068 #edb/ref 17592186323232 13194139533421 17592186045585 true] [17592186323811 1069 "q-364639" 13194139533421 17592186045585 true] [17592186323811 1070 #edb/ref 17592186045486 13194139533421 17592186045585 true] [17592186323811 1071 "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{16})\\operatorname{cos}⁡(\\frac{\\pi }{16})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})}.$\n\n$\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{16})\\operatorname{cos}⁡(\\frac{\\pi }{16})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})}=$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323811 1072 #uuid "5749738c-9ac0-51f9-9b71-e3d7fdfbde49" 13194139533421 17592186045585 true] [17592186323811 1074 "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{16}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{16})\\operatorname{cos}⁡(\\frac{\\pi }{16})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{16})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{16})\\operatorname{cos}⁡(\\frac{\\pi }{16})=\\operatorname{sin}⁡(\\frac{\\pi }{8})\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{16})\\operatorname{cos}⁡(\\frac{\\pi }{16})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{8}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{16})\\operatorname{cos}⁡(\\frac{\\pi }{16})}{\\operatorname{sec}⁡(\\frac{\\pi }{8})} & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8}) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{2}}{8}.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323812 1068 #edb/ref 17592186323546 13194139533421 17592186045585 true] [17592186323812 1069 "q-364640" 13194139533421 17592186045585 true] [17592186323812 1070 #edb/ref 17592186045486 13194139533421 17592186045585 true] [17592186323812 1071 "Find the exact value of $\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})}{\\operatorname{sec}⁡(\\frac{\\pi }{6})}.$\n\n$\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})}{\\operatorname{sec}⁡(\\frac{\\pi }{6})}=$\n{{field-1}}" 13194139533421 17592186045585 true] [17592186323812 1072 #uuid "e9ff4e40-981d-5344-8025-a467141eea82" 13194139533421 17592186045585 true] [17592186323812 1074 "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})=\\operatorname{sin}⁡(\\frac{\\pi }{6})\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})}{\\operatorname{sec}⁡(\\frac{\\pi }{6})} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})}{\\operatorname{sec}⁡(\\frac{\\pi }{6})} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{6}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡(\\frac{\\pi }{12})\\operatorname{cos}⁡(\\frac{\\pi }{12})}{\\operatorname{sec}⁡(\\frac{\\pi }{6})} & =\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{6}) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}}{8}.\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323813 1068 #edb/ref 17592186323297 13194139533421 17592186045585 true] [17592186323813 1069 "q-36485" 13194139533421 17592186045585 true] [17592186323813 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323813 1071 "The change-of-coordinates matrix from $B$ to $C$ and the coordinates of the vector $x$ relative to the basis $C$ are given below. What is $[x]_{B}?$ \n\n$$\n{P}_{B\\to C}=[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}],\\,[x]_{C}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$" 13194139533421 17592186045585 true] [17592186323813 1072 #uuid "76994fe0-8052-50ba-9dfa-9fe567d9b172" 13194139533421 17592186045585 true] [17592186323813 1074 "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}-2 & 3 \\\\ 3 & -4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{(-2)\\cdot (-4)-3\\cdot 3}[\\begin{aligned}-4 & -3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}4 & 3 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 5\\end{aligned}]\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323814 1068 #edb/ref 17592186323508 13194139533421 17592186045585 true] [17592186323814 1069 "q-365299" 13194139533421 17592186045585 true] [17592186323814 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323814 1071 "Solve the inequality $\\frac{1}{3}{(\\frac{3}{5})}^{x}\\le 3\\sqrt{3}.$" 13194139533421 17592186045585 true] [17592186323814 1072 #uuid "08e9021a-643b-5729-9c28-b1707d9de34c" 13194139533421 17592186045585 true] [17592186323814 1074 "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{3}{(\\frac{3}{5})}^{x} & \\le 3\\sqrt{3} \\\\ {(\\frac{3}{5})}^{x} & \\le 3\\cdot 3\\sqrt{3} \\\\ {(\\frac{3}{5})}^{x} & \\le 9\\sqrt{3}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[{(\\frac{3}{5})}^{x}] & \\le \\operatorname{ln}⁡(9\\sqrt{3}) \\\\ x\\operatorname{ln}⁡(\\frac{3}{5}) & \\le \\operatorname{ln}⁡(9\\sqrt{3}) \\\\ x(\\operatorname{ln}⁡3-\\operatorname{ln}⁡5) & \\le \\operatorname{ln}⁡(9\\sqrt{3}).\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡3-\\operatorname{ln}⁡5$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x & \\ge \\frac{\\operatorname{ln}⁡(9\\sqrt{3})}{\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323815 1068 #edb/ref 17592186323426 13194139533421 17592186045585 true] [17592186323815 1069 "q-365308" 13194139533421 17592186045585 true] [17592186323815 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323815 1071 "Solve the inequality $\\frac{3}{4}{(0.54)}^{x+3}-2e\\ge e.$" 13194139533421 17592186045585 true] [17592186323815 1072 #uuid "e46505c4-db86-50b2-b143-473fd23e4992" 13194139533421 17592186045585 true] [17592186323815 1074 "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{3}{4}{(0.54)}^{x+3}-2e & \\ge e \\\\ \\frac{3}{4}{(0.54)}^{x+3} & \\ge 3e \\\\ {(0.54)}^{x+3} & \\ge 4e.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡[(0.54)^{x+3}] & \\ge \\operatorname{ln}⁡(4e) \\\\ (x+3)\\operatorname{ln}⁡(0.54) & \\ge \\operatorname{ln}⁡(4e)\\end{aligned}\n$$\n\nLastly, note that $\\operatorname{ln}⁡(0.54)$ is a negative quantity, so when we divide both sides by it, we need to flip the inequality:\n\n$$\n\\begin{aligned}x+3 & \\le \\frac{\\operatorname{ln}⁡(4e)}{\\operatorname{ln}⁡(0.54)} \\\\ x & \\le \\frac{\\operatorname{ln}⁡(4e)}{\\operatorname{ln}⁡(0.54)}-3\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323816 1068 #edb/ref 17592186323442 13194139533421 17592186045585 true] [17592186323816 1069 "q-365323" 13194139533421 17592186045585 true] [17592186323816 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323816 1071 "Solve the inequality ${4}^{1-2x}\\le 3\\cdot {5}^{2-3x}.$" 13194139533421 17592186045585 true] [17592186323816 1072 #uuid "3f36893d-e053-5d18-beeb-2f0d972c9d98" 13194139533421 17592186045585 true] [17592186323816 1074 "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}{4}^{1-2x} & \\le 3\\cdot {5}^{2-3x} \\\\ \\operatorname{ln}⁡({4}^{1-2x}) & \\le \\operatorname{ln}⁡(3\\cdot {5}^{2-3x}) \\\\ \\operatorname{ln}⁡({4}^{1-2x}) & \\le \\operatorname{ln}⁡(3)+\\operatorname{ln}⁡({5}^{2-3x}) \\\\ (1-2x)\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+(2-3x)\\operatorname{ln}⁡5 \\\\ \\operatorname{ln}⁡4-2x\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-3x\\operatorname{ln}⁡5 \\\\ 3x\\operatorname{ln}⁡5-2x\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4 \\\\ x(3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4) & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4 \\\\ x & \\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323817 1068 #edb/ref 17592186323640 13194139533421 17592186045585 true] [17592186323817 1069 "q-365326" 13194139533421 17592186045585 true] [17592186323817 1070 #edb/ref 17592186045487 13194139533421 17592186045585 true] [17592186323817 1071 "Solve the inequality $3{(\\frac{1}{5})}^{x-2}>{3}^{2-3x}.$" 13194139533421 17592186045585 true] [17592186323817 1072 #uuid "4215e98b-bff5-5507-9fa2-a2d9f87a2aa6" 13194139533421 17592186045585 true] [17592186323817 1074 "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following: \n\n$$\n\\begin{aligned}3{(\\frac{1}{5})}^{x-2} & >{3}^{2-3x} \\\\ \\operatorname{ln}⁡[3{(\\frac{1}{5})}^{x-2}] & >\\operatorname{ln}⁡({3}^{2-3x}) \\\\ \\operatorname{ln}⁡3+\\operatorname{ln}⁡[{(\\frac{1}{5})}^{x-2}] & >\\operatorname{ln}⁡({3}^{2-3x}) \\\\ \\operatorname{ln}⁡3+(x-2)\\operatorname{ln}⁡(\\frac{1}{5}) & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+(x-2)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡5) & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+(x-2)(0-\\operatorname{ln}⁡5) & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+(2-x)\\operatorname{ln}⁡5 & >(2-3x)\\operatorname{ln}⁡3 \\\\ \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-x\\operatorname{ln}⁡5 & >2\\operatorname{ln}⁡3-3x\\operatorname{ln}⁡3 \\\\ 3x\\operatorname{ln}⁡3-x\\operatorname{ln}⁡5 & >2\\operatorname{ln}⁡3-\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5 \\\\ x(3\\operatorname{ln}⁡3-\\operatorname{ln}⁡5) & >\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5 \\\\ x & >\\frac{\\operatorname{ln}⁡3-2\\operatorname{ln}⁡5}{3\\operatorname{ln}⁡3-\\operatorname{ln}⁡5}\\end{aligned}\n$$" 13194139533421 17592186045585 true] [17592186323818 1068 #edb/ref 17592186323236 13194139533421 17592186045585 true] [17592186323818 1068 #edb/ref 17592186323438 13194139533421 17592186045585 true] [17592186323818 1069 "q-365332" 13194139533421 17592186045585 true] [17592186323818 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323818 1071 "Consider the d’Alembert differential equation, defined for $t>0:$\n\n$$\ny=x{(\\frac{\\text{d}y}{\\text{d}x})}^{2}+\\frac{\\text{d}y}{\\text{d}x}\n$$\n\nUsing the substitution $t=\\frac{\\text{d}y}{\\text{d}x},$ the equation can be transformed to a first-order linear equation of the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t).\n$$\n\nFind the functions $P$ and $Q.$\n\n$\\,\\,P(t)=$\n{{field-1}}$,\\,Q(t)=$\n{{field-2}}" 13194139533421 17592186045585 true] [17592186323818 1072 #uuid "df1e3a35-d035-58fe-be59-0f6465258bfb" 13194139533421 17592186045585 true] [17592186323818 1074 "A differential equation is a d'Alembert differential equation if it can be expressed in the form\n\n$$\ny=xf({y}^{′})+g({y}^{′}),\n$$\n\nwhere $f$ and $g$ are differentiable functions of ${y}^{′}.$ \n\nIn our case, we wish to transform the equation\n\n$$\ny=x{(\\frac{\\text{d}y}{\\text{d}x})}^{2}+\\frac{\\text{d}y}{\\text{d}x}\n$$\n\ninto a first-order linear equation for $x=x(t).$ We proceed in three steps:\n\n**Step 1**: Substitute, and differentiate with respect to $x.$\n\nWe have the substitution\n\n$$\nt=\\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nSubstituting this into the equation gives\n\n$$\ny=x{t}^{2}+t.\n$$\n\nDifferentiating both sides with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y) & =\\frac{\\text{d}}{\\text{d}x}(x{t}^{2}+t).\\end{aligned}\n$$\n\nApplying the sum and product rules and using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x{t}^{2})+\\frac{\\text{d}}{\\text{d}x}(t) \\\\ t & ={t}^{2}\\frac{\\text{d}}{\\text{d}x}(x)+x\\frac{\\text{d}}{\\text{d}x}({t}^{2})+\\frac{\\text{d}}{\\text{d}x}(t) \\\\ t & ={t}^{2}+2xt\\frac{\\text{d}t}{\\text{d}x}+\\frac{\\text{d}t}{\\text{d}x}.\\end{aligned}\n$$\n\n**Step 2**: Isolate the derivative and take its reciprocal.\n\nWe isolate $\\frac{\\text{d}t}{\\text{d}x}$ as follows:\n\n$$\n\\begin{aligned}t-{t}^{2} & =2xt\\frac{\\text{d}t}{\\text{d}x}+\\frac{\\text{d}t}{\\text{d}x} \\\\ t(1-t) & =(2xt+1)\\frac{\\text{d}t}{\\text{d}x} \\\\ \\frac{t(1-t)}{2xt+1} & =\\frac{\\text{d}t}{\\text{d}x}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\frac{\\text{d}t}{\\text{d}x}=\\frac{t(1-t)}{2xt+1}.\n$$\n\nTherefore, by taking the reciprocal of each side, we have\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{2xt+1}{t(1-t)}.\n$$\n\n**Step 3**: Express the derivative as a first-order linear equation.\n\nFinally, we write this in the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t)\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{2xt+1}{t(1-t)} \\\\ t(1-t)\\frac{\\text{d}x}{\\text{d}t} & =2xt+1 \\\\ t(1-t)\\frac{\\text{d}x}{\\text{d}t}-2xt & =1 \\\\ \\frac{\\text{d}x}{\\text{d}t}-\\frac{2xt}{t(1-t)} & =\\frac{1}{t(1-t)} \\\\ \\frac{\\text{d}x}{\\text{d}t}-\\frac{2x}{1-t} & =\\frac{1}{t(1-t)} \\\\ \\frac{\\text{d}x}{\\text{d}t}+\\frac{2x}{t-1} & =\\frac{1}{t(1-t)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(t)=\\frac{2}{t-1},\\,Q(t)=\\frac{1}{t(1-t)}.\n$$" 13194139533421 17592186045585 true] [17592186323819 1068 #edb/ref 17592186323180 13194139533421 17592186045585 true] [17592186323819 1068 #edb/ref 17592186323648 13194139533421 17592186045585 true] [17592186323819 1069 "q-365372" 13194139533421 17592186045585 true] [17592186323819 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323819 1071 "Consider the d’Alembert differential equation, defined for $t>0:$\n\n$$\ny=x{(\\frac{\\text{d}y}{\\text{d}x})}^{2}+3\\frac{\\text{d}y}{\\text{d}x}\n$$\n\nUsing the substitution $t=\\frac{\\text{d}y}{\\text{d}x},$ the equation can be transformed to a first-order linear equation of the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t).\n$$\n\nFind the functions $P$ and $Q.$\n\n$\\,\\,P(t)=$\n{{field-1}}$,\\,Q(t)=$\n{{field-2}}" 13194139533421 17592186045585 true] [17592186323819 1072 #uuid "00d0a81e-18e6-583c-927a-87161040247c" 13194139533421 17592186045585 true] [17592186323819 1074 "A differential equation is a d'Alembert differential equation if it can be expressed in the form\n\n$$\ny=xf({y}^{′})+g({y}^{′}),\n$$\n\nwhere $f$ and $g$ are differentiable functions of ${y}^{′}.$ \n\nIn our case, we wish to transform the equation\n\n$$\ny=x{(\\frac{\\text{d}y}{\\text{d}x})}^{2}+3\\frac{\\text{d}y}{\\text{d}x}\n$$\n\ninto a first-order linear equation for $x=x(t).$ We proceed in three steps:\n\n**Step 1**: Substitute, and differentiate with respect to $x.$\n\nWe have the substitution\n\n$$\nt=\\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nSubstituting this into the equation gives\n\n$$\ny=x{t}^{2}+3t.\n$$\n\nDifferentiating both sides with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y) & =\\frac{\\text{d}}{\\text{d}x}(x{t}^{2}+3t).\\end{aligned}\n$$\n\nApplying the sum and product rules and using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x{t}^{2})+\\frac{\\text{d}}{\\text{d}x}(3t) \\\\ t & ={t}^{2}\\frac{\\text{d}}{\\text{d}x}(x)+x\\frac{\\text{d}}{\\text{d}x}({t}^{2})+\\frac{\\text{d}}{\\text{d}x}(3t) \\\\ t & ={t}^{2}+2xt\\frac{\\text{d}t}{\\text{d}x}+3\\frac{\\text{d}t}{\\text{d}x}.\\end{aligned}\n$$\n\n**Step 2**: Isolate the derivative and take its reciprocal.\n\nWe isolate $\\frac{\\text{d}t}{\\text{d}x}$ as follows:\n\n$$\n\\begin{aligned}t-{t}^{2} & =2xt\\frac{\\text{d}t}{\\text{d}x}+3\\frac{\\text{d}t}{\\text{d}x} \\\\ t(1-t) & =(2xt+3)\\frac{\\text{d}t}{\\text{d}x} \\\\ \\frac{t(1-t)}{2xt+3} & =\\frac{\\text{d}t}{\\text{d}x}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\frac{\\text{d}t}{\\text{d}x}=\\frac{t(1-t)}{2xt+3}.\n$$\n\nTherefore, by taking the reciprocal of each side, we have\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{2xt+3}{t(1-t)}.\n$$\n\n**Step 3**: Express the derivative as a first-order linear equation.\n\nFinally, we write this in the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t)\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{2xt+3}{t(1-t)} \\\\ t(1-t)\\frac{\\text{d}x}{\\text{d}t} & =2xt+3 \\\\ t(1-t)\\frac{\\text{d}x}{\\text{d}t}-2xt & =3 \\\\ \\frac{\\text{d}x}{\\text{d}t}-\\frac{2xt}{t(1-t)} & =\\frac{3}{t(1-t)} \\\\ \\frac{\\text{d}x}{\\text{d}t}-\\frac{2x}{1-t} & =\\frac{3}{t(1-t)} \\\\ \\frac{\\text{d}x}{\\text{d}t}+\\frac{2x}{t-1} & =\\frac{3}{t(1-t)}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(t)=\\frac{2}{t-1},\\,Q(t)=\\frac{3}{t(1-t)}.\n$$" 13194139533421 17592186045585 true] [17592186323820 1068 #edb/ref 17592186323406 13194139533421 17592186045585 true] [17592186323820 1068 #edb/ref 17592186323467 13194139533421 17592186045585 true] [17592186323820 1069 "q-365373" 13194139533421 17592186045585 true] [17592186323820 1070 #edb/ref 17592186045485 13194139533421 17592186045585 true] [17592186323820 1071 "Consider the d’Alembert differential equation, defined for $t>0:$\n\n$$\ny=x{(\\frac{\\text{d}y}{\\text{d}x})}^{2}-\\frac{\\text{d}y}{\\text{d}x}\n$$\n\nUsing the substitution $t=\\frac{\\text{d}y}{\\text{d}x},$ the equation can be transformed to a first-order linear equation of the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t).\n$$\n\nFind the functions $P$ and $Q.$\n\n$\\,\\,P(t)=$\n{{field-1}}$,\\,Q(t)=$\n{{field-2}}" 13194139533421 17592186045585 true] [17592186323820 1072 #uuid "c23b4e5b-85ca-5730-b4e3-0f8ebb92441d" 13194139533421 1759218604