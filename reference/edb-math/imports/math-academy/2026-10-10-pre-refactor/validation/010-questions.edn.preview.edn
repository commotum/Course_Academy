85 true] [17592186364332 1069 "q-73576" 13194139533445 17592186045585 true] [17592186364332 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364332 1071 "Evaluate \n${\\int }_{0}^{\\pi /12}{\\int }_{\\pi }^{5\\pi /3}\\operatorname{sin}⁡(x+2y)\\,\\text{d}x\\,\\text{d}y.$" 13194139533445 17592186045585 true] [17592186364332 1072 #uuid "d0386666-3fac-5a95-aad2-f27d650f7552" 13194139533445 17592186045585 true] [17592186364332 1074 "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /12}[{\\int }_{\\pi }^{5\\pi /3}\\operatorname{sin}⁡(x+2y)\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{\\pi /12}[-\\operatorname{cos}⁡(x+2y)]_{\\pi }^{5\\pi /3}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /12}(-\\operatorname{cos}⁡(2y+\\frac{5\\pi }{3})+\\operatorname{cos}⁡(2y+\\pi ))\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /12} & (-\\operatorname{cos}⁡(2y+\\frac{5\\pi }{3})+\\operatorname{cos}⁡(2y+\\pi ))\\text{d}y \\\\  & ={[-\\frac{1}{2}\\operatorname{sin}⁡(2y+\\frac{5\\pi }{3})+\\frac{1}{2}\\operatorname{sin}⁡(2y+\\pi )]}_{0}^{\\pi /12} \\\\  & =-\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}+\\frac{5\\pi }{3})+\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot 0+\\frac{5\\pi }{3}) \\\\  & +\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{12}+\\pi )-\\frac{1}{2}\\operatorname{sin}⁡(2\\cdot 0+\\pi ) \\\\  & =\\frac{1}{2}[-\\operatorname{sin}⁡(\\frac{11\\pi }{6})+\\operatorname{sin}⁡(\\frac{5\\pi }{3})+\\operatorname{sin}⁡(\\frac{7\\pi }{6})-\\operatorname{sin}⁡(\\pi )] \\\\  & =\\frac{1}{2}[\\frac{1}{2}-\\frac{\\sqrt{3}}{2}-\\frac{1}{2}-0] \\\\  & =-\\frac{\\sqrt{3}}{4}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186364333 1075 #edb/ref 17592186364334 13194139533445 17592186045585 true] [17592186364333 1075 #edb/ref 17592186364335 13194139533445 17592186045585 true] [17592186364333 1