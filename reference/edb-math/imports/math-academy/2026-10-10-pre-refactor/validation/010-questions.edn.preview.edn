 \\\\ -4 & 1 & 1\\end{aligned}][\\begin{aligned}72 \\\\ 0 \\\\ 369\\end{aligned}] \\\\ [\\begin{aligned}13 & -10 \\\\ -10 & 26\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}216 \\\\ 81\\end{aligned}]\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & ={[\\begin{aligned}13 & -10 \\\\ -10 & 26\\end{aligned}]}^{-1}[\\begin{aligned}216 \\\\ 81\\end{aligned}] \\\\  & =\\frac{1}{13\\cdot 26-(-10)\\cdot (-10)}[\\begin{aligned}26 & 10 \\\\ 10 & 13\\end{aligned}][\\begin{aligned}216 \\\\ 81\\end{aligned}] \\\\  & =\\frac{1}{238}[\\begin{aligned}6\\,426 \\\\ 3\\,213\\end{aligned}] \\\\  & =[\\begin{aligned}27 \\\\ 13.5\\end{aligned}].\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363231 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363232 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363233 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363234 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363235 13194139533445 17592186045585 true] [17592186363230 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363230 1077 "selection" 13194139533445 17592186045585 true] [17592186363230 1079 #edb/ref 17592186363232 13194139533445 17592186045585 true] [17592186363230 1080 #uuid "d2bc20b6-fa65-5cde-b3cb-e9bf425391b4" 13194139533445 17592186045585 true] [17592186363231 1081 "[\\begin{aligned}20 \\\\ 14\\end{aligned}]" 13194139533445 17592186045585 true] [17592186363231 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363231 1084 #uuid "ad3127e8-b057-5ce7-bbd4-c2b8cbbdc14c" 13194139533445 17592186045585 true] [17592186363232 1081 "[\\begin{aligned}27 \\\\ 13.5\\end{aligned}]" 13194139533445 17592186045585 true] [17592186363232 1083 #e