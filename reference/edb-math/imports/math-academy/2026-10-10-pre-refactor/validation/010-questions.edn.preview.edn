2186045585 true] [17592186363011 1081 "{\\int }_{2\\sqrt{x-4}}^{\\sqrt{2x}}{\\int }_{4}^{8}({x}^{2}-{y}^{3})\\,dy\\,dx" 13194139533445 17592186045585 true] [17592186363011 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363011 1084 #uuid "c3e4c286-9755-54c6-814c-0591e7625d0d" 13194139533445 17592186045585 true] [17592186363012 1068 #edb/ref 17592186363013 13194139533445 17592186045585 true] [17592186363012 1069 "q-132240" 13194139533445 17592186045585 true] [17592186363012 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186363012 1071 "![](images/5a/5a7add911aa0a7414c979d758cb9a6e9e9d23f8fcfbb71abb1648aeefe30bc6e.png)\n\nIf $D$ is the finite region enclosed by the line $y=4$ and the curve $y={x}^{2},$ as shown above, then ${∬}_{D}{e}^{x+y}\\,dA=$" 13194139533445 17592186045585 true] [17592186363012 1072 #uuid "c17aef4e-54b4-5fd5-b0e4-5e8c5c062f24" 13194139533445 17592186045585 true] [17592186363012 1074 "First, let's represent $D$ as a type I region. \n\n- To determine the $x$-limits, we need to find the $x$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $x:$\n\n$$\n\\begin{aligned}4 & ={x}^{2} \\\\ {x}^{2}-4 & =0 \\\\ (x-2)(x+2) & =0\\end{aligned}\n$$\n\nSo, $x$-limits are \n$-2\\le x\\le 2.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](images/a5/a5d544a1c4c7d0227e464aae92f8b282f716fa41ee57daa1061e77e1898a8a00.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 2,\\,{x}^{2}\\le y\\le 4}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{e}^{x+y}\\,dA & ={\\int }_{-2}^{2}{\\int }_{{x}^{2}}^{4}{e}^{x+y}\\,dy\\,dx\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363013 1075 #edb/ref 17592186363014 13194139533445 17592186045585 true] [17592186363013 1075 #edb/ref 17592186363015 13194139533445 17592186045585 true] [17592186363013 1075 #edb/ref 17592186363016 13194139533445 17592186045585 true] [17592186363013 1075 #edb/ref 17592186363017 13194139533445 17592186045585 true] [17592186363013 1075 #edb/ref 17592186363018 13194139533445 17592186045585 true] [17592186363013 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363013 1077 "selection" 13194139533445 17592186045585 true] [17592186363013 1079 #edb/ref 17592186363018 13194139533445 17592186045585 true] [17592186363013 1080 #uuid "82b4ec09-37c7-5b51-8059-90f4778e5356" 13194139533445 17592186045585 true] [17592186363014 1081 "{\\int }_{-2}^{4}{\\int }_{{x}^{2}}^{2}{e}^{x+y}\\,dy\\,dx" 13194139533445 17592186045585 true] [17592186363014 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363014 1084 #uuid "17c7d71f-f00f-5dc9-aeb4-885155387bc6" 13194139533445 17592186045585 true] [17592186363015 1081 "{\\int }_{-2}^{2}{\\int }_{4}^{{x}^{2}}{e}^{x+y}\\,dy\\,dx" 13194139533445 17592186045585 true] [17592186363015 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363015 1084 #uuid "83649048-f61a-5a4f-9f1a-a9bd0f8ca399" 13194139533445 17592186045585 true] [17592186363016 1081 "{\\int }_{{x}^{2}}^{4}{\\int }_{-2}^{2}{e}^{x+y}\\,dy\\,dx" 13194139533445 17592186045585 true] [17592186363016 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363016 1084 #uuid "ece3b971-05fd-5c98-a0f4-285c95b8ed48" 13194139533445 17592186045585 true] [17592186363017 1081 "{\\int }_{4}^{2}{\\int }_{{x}^{2}}^{-2}{e}^{x+y}\\,dy\\,dx" 13194139533445 17592186045585 true] [17592186363017 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363017 1084 #uuid "5bc644eb-8546-51f1-b7ea-0f19302e599c" 13194139533445 17592186045585 true] [17592186363018 1081 "{\\int }_{-2}^{2}{\\int }_{{x}^{2}}^{4}{e}^{x+y}\\,dy\\,dx" 13194139533445 17592186045585 true] [17592186363018 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363018 1084 #uuid "d6d962e7-30e5-58e7-bd21-f0a369727307" 13194139533445 17592186045585 true] [17592186363019 1068 #edb/ref 17592186363020 13194139533445 17592186045585 true] [17592186363019 1069 "q-132249" 13194139533445 17592186045585 true] [17592186363019 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363019 1071 "If $D$ is the finite region enclosed by the lines $y=2x,$ $y=6-x,$ and $x=0,$ then ${∬}_{D}f(x,y)\\,dA=$" 13194139533445 17592186045585 true] [17592186363019 1072 #uuid "bf1ebc54-3588-5672-a9a8-34aff8268c29" 13194139533445 17592186045585 true] [17592186363019 1074 "First, let's make a sketch of our region.\n\n![](images/24/24d3b93e82e88bb581eff3005687ae4ee3dc3ae0d6c25fbc26f72665042ae5c6.png)\n\nNow, let's represent $D$ as a type I region. \n\n- To determine the $x$-limits, we need to find the $x$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $x:$\n\n$$\n\\begin{aligned}-x+6 & =2x \\\\ 3x & =6 \\\\ x & =\\frac{6}{3} \\\\ x & =2\\end{aligned}\n$$\n\nSo, $x$-limits are \n$0\\le x\\le 2.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](images/af/af61865f54494840090351296e8a1c21446787ca0b273005e7bf9c2907585adb.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,2x\\le y\\le 6-x}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{2x}^{6-x}f(x,y)\\text{ }dy\\,dx\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363020 1075 #edb/ref 17592186363021 13194139533445 17592186045585 true] [17592186363020 1075 #edb/ref 17592186363022 13194139533445 17592186045585 true] [17592186363020 1075 #edb/ref 17592186363023 13194139533445 17592186045585 true] [17592186363020 1075 #edb/ref 17592186363024 13194139533445 17592186045585 true] [17592186363020 1075 #edb/ref 17592186363025 13194139533445 17592186045585 true] [17592186363020 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363020 1077 "selection" 13194139533445 17592186045585 true] [17592186363020 1079 #edb/ref 17592186363024 13194139533445 17592186045585 true] [17592186363020 1080 #uuid "84cffe0e-beaf-5ba7-9fbe-6bf91ad72904" 13194139533445 17592186045585 true] [17592186363021 1081 "{\\int }_{0}^{6-x}{\\int }_{2x}^{2}f(x,y)\\text{ }dy\\,dx" 13194139533445 17592186045585 true] [17592186363021 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363021 1084 #uuid "61c05038-b02e-505a-ae9f-3fa9ce69d55e" 13194139533445 17592186045585 true] [17592186363022 1081 "{\\int }_{2x}^{6-x}{\\int }_{0}^{2}f(x,y)\\text{ }dy\\,dx" 13194139533445 17592186045585 true] [17592186363022 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363022 1084 #uuid "27ef6b52-a8a0-5857-918a-51fc41c52a52" 13194139533445 17592186045585 true] [17592186363023 1081 "{\\int }_{2x}^{2}{\\int }_{0}^{6-x}f(x,y)\\text{ }dy\\,dx" 13194139533445 17592186045585 true] [17592186363023 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363023 1084 #uuid "4a3da6a9-3a95-52d1-b150-242b21b9f8b2" 13194139533445 17592186045585 true] [17592186363024 1081 "{\\int }_{0}^{2}{\\int }_{2x}^{6-x}f(x,y)\\text{ }dy\\,dx" 13194139533445 17592186045585 true] [17592186363024 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363024 1084 #uuid "77487245-530b-56a2-9d5e-4792a04baf49" 13194139533445 17592186045585 true] [17592186363025 1081 "{\\int }_{0}^{2}{\\int }_{6-x}^{2x}f(x,y)\\text{ }dy\\,dx" 13194139533445 17592186045585 true] [17592186363025 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363025 1084 #uuid "cfdff24d-1b07-5e14-a309-c163da974322" 13194139533445 17592186045585 true] [17592186363026 1068 #edb/ref 17592186363027 13194139533445 17592186045585 true] [17592186363026 1069 "q-132255" 13194139533445 17592186045585 true] [17592186363026 1070 #edb/ref 17592186045486 13194139533445 17592186045585 true] [17592186363026 1071 "For the function $g(x,y,z)=\\sqrt{x}\\operatorname{arccos}⁡(y{z}^{2}),$ evaluate $\\frac{∂g}{∂z}$ at the point $(3,\\frac{1}{2},1).$" 13194139533445 17592186045585 true] [17592186363026 1072 #uuid "9414edde-aaa5-55fe-99cf-fcbd12cf83ce" 13194139533445 17592186045585 true] [17592186363026 1074 "We differentiate the given function with respect to $z,$ treating all other variables as constants. \n\nUsing the constant multiple and chain rules, we have\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z} & =\\frac{∂}{∂z}(\\sqrt{x}\\operatorname{arccos}⁡(y{z}^{2})) \\\\  & =\\sqrt{x}\\cdot \\frac{∂}{∂z}(\\operatorname{arccos}⁡(y{z}^{2})) \\\\  & =\\sqrt{x}\\cdot (-\\frac{1}{\\sqrt{1-{(y{z}^{2})}^{2}}})\\cdot \\frac{∂}{∂z}(y{z}^{2}) \\\\  & =\\sqrt{x}\\cdot (-\\frac{1}{\\sqrt{1-{y}^{2}{z}^{4}}})\\cdot y\\cdot 2z \\\\  & =-\\frac{2yz\\sqrt{x}}{\\sqrt{1-{y}^{2}{z}^{4}}}.\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(3,\\frac{1}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂z}{|}_{(3,\\,1/2,\\,1)} & =-\\frac{2(\\frac{1}{2})(1)\\sqrt{3}}{\\sqrt{1-{(\\frac{1}{2})}^{2}(1)^{4}}} \\\\  & =-\\frac{\\sqrt{3}}{\\sqrt{1-\\frac{1}{4}}} \\\\  & =-\\frac{\\sqrt{3}}{(\\frac{\\sqrt{3}}{2})} \\\\  & =-2\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363027 1075 #edb/ref 17592186363028 13194139533445 17592186045585 true] [17592186363027 1075 #edb/ref 17592186363029 13194139533445 17592186045585 true] [17592186363027 1075 #edb/ref 17592186363030 13194139533445 17592186045585 true] [17592186363027 1075 #edb/ref 17592186363031 13194139533445 17592186045585 true] [17592186363027 1075 #edb/ref 17592186363032 13194139533445 17592186045585 true] [17592186363027 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363027 1077 "selection" 13194139533445 17592186045585 true] [17592186363027 1079 #edb/ref 17592186363032 13194139533445 17592186045585 true] [17592186363027 1080 #uuid "391d0c46-ac45-548f-b507-5755302aa0bb" 13194139533445 17592186045585 true] [17592186363028 1081 "\\frac{1}{2}" 13194139533445 17592186045585 true] [17592186363028 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363028 1084 #uuid "85813fa1-7598-522f-8c21-a78340a56373" 13194139533445 17592186045585 true] [17592186363029 1081 "2" 13194139533445 17592186045585 true] [17592186363029 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363029 1084 #uuid "794f355d-1fd3-5f85-acbc-2a0b9cb24276" 13194139533445 17592186045585 true] [17592186363030 1081 "1" 13194139533445 17592186045585 true] [17592186363030 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363030 1084 #uuid "d727996c-f099-52f9-bb09-3a563b0e8bcb" 13194139533445 17592186045585 true] [17592186363031 1081 "-1" 13194139533445 17592186045585 true] [17592186363031 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363031 1084 #uuid "169f002f-fd26-50ae-930c-9a604e9ae96a" 13194139533445 17592186045585 true] [17592186363032 1081 "-2" 13194139533445 17592186045585 true] [17592186363032 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363032 1084 #uuid "a1d17484-2506-5d97-98a5-73a7fa14daee" 13194139533445 17592186045585 true] [17592186363033 1068 #edb/ref 17592186363034 13194139533445 17592186045585 true] [17592186363033 1069 "q-132283" 13194139533445 17592186045585 true] [17592186363033 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363033 1071 "${\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-{x}^{2}}}y\\,dy\\,dx=$" 13194139533445 17592186045585 true] [17592186363033 1072 #uuid "7fd4d0e6-fb9b-5edf-bf95-e5b4e7371cb5" 13194139533445 17592186045585 true] [17592186363033 1074 "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-{x}^{2}}}y\\,dy\\,dx & ={\\int }_{0}^{2}[{\\int }_{0}^{\\sqrt{4-{x}^{2}}}y\\,dy]dx \\\\  & ={\\int }_{0}^{2}{[\\frac{{y}^{2}}{2}]}_{0}^{\\sqrt{4-{x}^{2}}}\\,dx \\\\  & ={\\int }_{0}^{2}(\\frac{4-{x}^{2}}{2}-0)dx \\\\  & ={\\int }_{0}^{2}(2-\\frac{{x}^{2}}{2})dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(2-\\frac{{x}^{2}}{2})dx & ={[2x-\\frac{{x}^{3}}{6}]}_{0}^{2} \\\\  & =2(2)-\\frac{{2}^{3}}{6}-0 \\\\  & =4-\\frac{4}{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363034 1075 #edb/ref 17592186363035 13194139533445 17592186045585 true] [17592186363034 1075 #edb/ref 17592186363036 13194139533445 17592186045585 true] [17592186363034 1075 #edb/ref 17592186363037 13194139533445 17592186045585 true] [17592186363034 1075 #edb/ref 17592186363038 13194139533445 17592186045585 true] [17592186363034 1075 #edb/ref 17592186363039 13194139533445 17592186045585 true] [17592186363034 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363034 1077 "selection" 13194139533445 17592186045585 true] [17592186363034 1079 #edb/ref 17592186363036 13194139533445 17592186045585 true] [17592186363034 1080 #uuid "7b05dfc6-3d39-5c0e-b32c-791f40800209" 13194139533445 17592186045585 true] [17592186363035 1081 "\\frac{5}{2}" 13194139533445 17592186045585 true] [17592186363035 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363035 1084 #uuid "baf9f366-76b2-5eb7-ad69-d8a2aebcb5b2" 13194139533445 17592186045585 true] [17592186363036 1081 "\\frac{8}{3}" 13194139533445 17592186045585 true] [17592186363036 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363036 1084 #uuid "47b43bfc-dd45-5714-bb1a-6f4698dbf38f" 13194139533445 17592186045585 true] [17592186363037 1081 "2" 13194139533445 17592186045585 true] [17592186363037 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363037 1084 #uuid "7dd8fa31-c85e-507d-8529-51da72de5124" 13194139533445 17592186045585 true] [17592186363038 1081 "4" 13194139533445 17592186045585 true] [17592186363038 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363038 1084 #uuid "bc3376e3-1c16-5e7b-9367-49d4b7b29c63" 13194139533445 17592186045585 true] [17592186363039 1081 "\\frac{10}{3}" 13194139533445 17592186045585 true] [17592186363039 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363039 1084 #uuid "2c994e24-2928-5542-87f6-0ad40b8982fc" 13194139533445 17592186045585 true] [17592186363040 1068 #edb/ref 17592186363041 13194139533445 17592186045585 true] [17592186363040 1069 "q-132288" 13194139533445 17592186045585 true] [17592186363040 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363040 1071 "Calculate ${∬}_{D}(1-y)\\,dA,\\,$\nwhere $D={(x,y)\\,:\\,0\\le x\\le 1,\\,x\\le y\\le \\sqrt{x}}.$" 13194139533445 17592186045585 true] [17592186363040 1072 #uuid "bde71b68-b520-59d3-93af-ca08dc3ea6a8" 13194139533445 17592186045585 true] [17592186363040 1074 "The integral is defined over the type I region $D={(x,y)\\,:\\,0\\le x\\le 1,\\,x\\le y\\le \\sqrt{x}}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}(1-y)\\,dA & ={\\int }_{0}^{1}{\\int }_{x}^{\\sqrt{x}}(1-y)\\,dy\\,dx\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{x}^{\\sqrt{x}}(1-y)\\,dy\\,dx & ={\\int }_{0}^{1}[{\\int }_{x}^{\\sqrt{x}}(1-y)\\,dy]dx \\\\  & ={\\int }_{0}^{1}{[y-\\frac{1}{2}{y}^{2}]}_{x}^{\\sqrt{x}}dx \\\\  & ={\\int }_{0}^{1}(\\sqrt{x}-\\frac{1}{2}(\\sqrt{x})^{2}-x+\\frac{1}{2}{x}^{2})dx \\\\  & ={\\int }_{0}^{1}(\\sqrt{x}-\\frac{3}{2}x+\\frac{1}{2}{x}^{2})dx \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}(2\\sqrt{x}-3x+{x}^{2})dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{1}(2\\sqrt{x}-3x+{x}^{2})dx & =\\frac{1}{2}{\\int }_{0}^{1}(2{x}^{1/2}-3x+{x}^{2})dx \\\\  & =\\frac{1}{2}{[\\frac{4}{3}{x}^{3/2}-\\frac{3}{2}{x}^{2}+\\frac{1}{3}{x}^{3}]}_{0}^{1} \\\\  & =\\frac{1}{2}(\\frac{4}{3}(1)^{3/2}-\\frac{3}{2}(1)^{2}+\\frac{1}{3}(1)^{3}) \\\\  & =\\frac{1}{2}(\\frac{4}{3}-\\frac{3}{2}+\\frac{1}{3}) \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{6} \\\\  & =\\frac{1}{12}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363042 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363043 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363044 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363045 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363046 13194139533445 17592186045585 true] [17592186363041 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363041 1077 "selection" 13194139533445 17592186045585 true] [17592186363041 1079 #edb/ref 17592186363045 13194139533445 17592186045585 true] [17592186363041 1080 #uuid "5867902a-6284-5551-aed8-0475b024eb39" 13194139533445 17592186045585 true] [17592186363042 1081 "\\frac{2}{3}" 13194139533445 17592186045585 true] [17592186363042 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363042 1084 #uuid "2c56c7fa-92c1-5696-b708-fd49a928794e" 13194139533445 17592186045585 true] [17592186363043 1081 "8" 13194139533445 17592186045585 true] [17592186363043 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363043 1084 #uuid "7e49b3d8-6357-56b3-a383-d96da299064c" 13194139533445 17592186045585 true] [17592186363044 1081 "2" 13194139533445 17592186045585 true] [17592186363044 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363044 1084 #uuid "5d04d7e3-1206-53c0-878a-589c62adfa16" 13194139533445 17592186045585 true] [17592186363045 1081 "\\frac{1}{12}" 13194139533445 17592186045585 true] [17592186363045 1083 #edb/ref 17592186045499 13194139533445 1759