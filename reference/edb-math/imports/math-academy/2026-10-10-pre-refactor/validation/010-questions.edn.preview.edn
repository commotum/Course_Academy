53f8-b8d9-f879853ecd8e" 13194139533445 17592186045585 true] [17592186364466 1081 "({\\int }_{0}^{5}\\sqrt{{x}^{3}}\\,\\text{d}x)({\\int }_{3}^{7}{y}^{2}\\sqrt{y}\\,\\text{d}y)" 13194139533445 17592186045585 true] [17592186364466 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364466 1084 #uuid "7cdac1a3-3bf6-56c9-8a56-d27280a12ed6" 13194139533445 17592186045585 true] [17592186364467 1081 "({\\int }_{0}^{5}\\sqrt{x}\\,\\text{d}x)({\\int }_{3}^{7}\\frac{1}{\\sqrt{y}}\\,\\text{d}y)" 13194139533445 17592186045585 true] [17592186364467 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364467 1084 #uuid "3112a97c-a907-5f97-b354-803882c326ce" 13194139533445 17592186045585 true] [17592186364468 1081 "({\\int }_{3}^{7}\\sqrt{x}\\,\\text{d}x)({\\int }_{0}^{5}\\frac{1}{\\sqrt{y}}\\,\\text{d}y)" 13194139533445 17592186045585 true] [17592186364468 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364468 1084 #uuid "1b45808d-a995-5e4a-8b41-6e1777f9df3b" 13194139533445 17592186045585 true] [17592186364469 1068 #edb/ref 17592186364470 13194139533445 17592186045585 true] [17592186364469 1069 "q-80536" 13194139533445 17592186045585 true] [17592186364469 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364469 1071 "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}=1.$ If \n\n$$\nf(x,y)={\\begin{aligned}{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\n- ${∬}_{R}{e}^{x+y}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,2]$\n- ${∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$\n- ${∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-3,3]$" 13194139533445 17592186045585 true] [17592186364469 1072 #uuid "47830ab2-2bae-52c6-8c9c-df89a69a6369" 13194139533445 17592186045585 true] [17592186364469 1074 "First, let's draw our region $D:$\n\n![](images/5c/5c5dbc673c2c6a9bd0a4f06223133e21e2dcbbdbaa2dfe2de2b29d8824dd821e.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is false. The rectangle $R$ does not cover the region $D.$ Also, the integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statements II and III are true. In both cases, the rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533445 17592186045585 true] [17592186364470 1075 #edb/ref 17592186364471 13194139533445 17592186045585 true] [17592186364470 1075 #edb/ref 17592186364472 13194139533445 17592186045585 true] [17592186364470 1075 #edb/ref 17592186364473 13194139533445 17592186045585 true] [17592186364470 1075 #edb/ref 17592186364474 13194139533445 17592186045585 true] [17592186364470 1075 #edb/ref 17592186364475 13194139533445 17592186045585 true] [17592186364470 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364470 1077 "selection" 13194139533445 17592186045585 true] [17592186364470 1079 #edb/ref 17592186364471 13194139533445 17592186045585 true] [17592186364470 1080 #uuid "8b116226-ab8b-5ce9-ac44-338ae9414626" 13194139533445 17592186045585 true] [17592186364471 1081 "II and III only" 13194139533445 17592186045585 true] [17592186364471 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364471 1084 #uuid "5b312bca-7b4b-56e2-8482-c0ca71388a88" 13194139533445 17592186045585 true] [17592186364472 1081 "I only" 13194139533445 17592186045585 true] [17592186364472 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [1759218636