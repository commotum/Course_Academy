atorname{cos}⁡x)+{y}^{5}\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) & =(\\frac{∂}{∂x}(x)\\cdot \\operatorname{cos}⁡x+x\\cdot \\frac{∂}{∂x}(\\operatorname{cos}⁡x))+{y}^{5}\\cdot (\\operatorname{cos}⁡x) \\\\  & =((1)\\cdot \\operatorname{cos}⁡x+x\\cdot (-\\operatorname{sin}⁡x))+{y}^{5}\\operatorname{cos}⁡x \\\\  & =\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+{y}^{5}\\operatorname{cos}⁡x \\\\  & =(1+{y}^{5})\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363349 1075 #edb/ref 17592186363350 13194139533445 17592186045585 true] [17592186363349 1075 #edb/ref 17592186363351 13194139533445 17592186045585 true] [17592186363349 1075 #edb/ref 17592186363352 13194139533445 17592186045585 true] [17592186363349 1075 #edb/ref 17592186363353 13194139533445 17592186045585 true] [17592186363349 1075 #edb/ref 17592186363354 13194139533445 17592186045585 true] [17592186363349 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363349 1077 "selection" 13194139533445 17592186045585 true] [17592186363349 1079 #edb/ref 17592186363350 13194139533445 17592186045585 true] [17592186363349 1080 #uuid "b1af9e5e-7d6f-5413-99e4-88f6a6ae2bd4" 13194139533445 17592186045585 true] [17592186363350 1081 "(1+{y}^{5})\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" 13194139533445 17592186045585 true] [17592186363350 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363350 1084 #uuid "e5361b3e-3a8f-5f23-bccc-16c3847e243d" 13194139533445 17592186045585 true] [17592186363351 1081 "(2+{y}^{5})\\operatorname{cos}⁡x-{x}^{2}\\operatorname{sin}⁡x" 13194139533445 17592186045585 true] [17592186363351 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363351 1084 #uuid "c396d8bd-ee03-54b5-9fa3-772cead8f6f8" 13194139533445 17592186045585 true] [17592186363352 1081 "(1-{y}^{4})\\operatorname{cos}⁡x-y\\operatorname{sin}⁡x" 13194139533445 17592186045585 true] [17592186363352 1083 #edb/ref 175921