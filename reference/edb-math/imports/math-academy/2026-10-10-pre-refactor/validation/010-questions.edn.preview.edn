ue] [17592186363565 1075 #edb/ref 17592186363570 13194139533445 17592186045585 true] [17592186363565 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363565 1077 "selection" 13194139533445 17592186045585 true] [17592186363565 1079 #edb/ref 17592186363569 13194139533445 17592186045585 true] [17592186363565 1080 #uuid "56d3c014-7399-5320-a01a-ad25e78491d4" 13194139533445 17592186045585 true] [17592186363566 1081 "P∧(P∨Q)" 13194139533445 17592186045585 true] [17592186363566 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363566 1084 #uuid "791ba16d-0fde-5494-ae38-151cf6473679" 13194139533445 17592186045585 true] [17592186363567 1081 "(P∧Q)∨P" 13194139533445 17592186045585 true] [17592186363567 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363567 1084 #uuid "570ac923-c70f-5b05-85ab-6d0e3179805a" 13194139533445 17592186045585 true] [17592186363568 1081 "(P∨Q)∨Q" 13194139533445 17592186045585 true] [17592186363568 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363568 1084 #uuid "26713a16-ca66-5149-b579-24b29515572c" 13194139533445 17592186045585 true] [17592186363569 1081 "P∧Q" 13194139533445 17592186045585 true] [17592186363569 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363569 1084 #uuid "814273a2-7641-537c-b209-0d0278585880" 13194139533445 17592186045585 true] [17592186363570 1081 "P∨Q" 13194139533445 17592186045585 true] [17592186363570 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363570 1084 #uuid "87001085-7898-5d47-97c2-c648e169d76b" 13194139533445 17592186045585 true] [17592186363571 1068 #edb/ref 17592186363572 13194139533445 17592186045585 true] [17592186363571 1069 "q-175377" 13194139533445 17592186045585 true] [17592186363571 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363571 1071 "$x$ is negative **or** rational, **and** $x$ is positive **or** an  integer.\n\nExpress 