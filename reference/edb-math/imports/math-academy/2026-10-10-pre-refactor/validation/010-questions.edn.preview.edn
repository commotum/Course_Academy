2}-{y}^{2}}{{e}^{y-x}}) & =\\frac{\\frac{∂}{∂x}({x}^{2}-{y}^{2})\\cdot {e}^{y-x}-({x}^{2}-{y}^{2})\\cdot \\frac{∂}{∂x}({e}^{y-x})}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x\\cdot {e}^{y-x}-({x}^{2}-{y}^{2})\\cdot {e}^{y-x}\\cdot \\frac{∂}{∂x}(y-x)}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x{e}^{y-x}-({x}^{2}-{y}^{2})\\cdot {e}^{y-x}\\cdot (-1)}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{(2x+{x}^{2}-{y}^{2}){e}^{y-x}}{{({e}^{y-x})}^{2}} \\\\  & =\\frac{2x+{x}^{2}-{y}^{2}}{{e}^{y-x}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(1,-1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(1,-1)} & =\\frac{2(1)+{1}^{2}-(-1)^{2}}{{e}^{-1-1}} \\\\  & =\\frac{2+1-1}{{e}^{-2}} \\\\  & =2{e}^{2}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363335 1075 #edb/ref 17592186363336 13194139533445 17592186045585 true] [17592186363335 1075 #edb/ref 17592186363337 13194139533445 17592186045585 true] [17592186363335 1075 #edb/ref 17592186363338 13194139533445 17592186045585 true] [17592186363335 1075 #edb/ref 17592186363339 13194139533445 17592186045585 true] [17592186363335 1075 #edb/ref 17592186363340 13194139533445 17592186045585 true] [17592186363335 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363335 1077 "selection" 13194139533445 17592186045585 true] [17592186363335 1079 #edb/ref 17592186363336 13194139533445 17592186045585 true] [17592186363335 1080 #uuid "c43d33af-7b21-5589-9d8f-5fccd66d3600" 13194139533445 17592186045585 true] [17592186363336 1081 "2{e}^{2}" 13194139533445 17592186045585 true] [17592186363336 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363336 1084 #uuid "8367eed8-8db9-5b16-8030-4fb1d45343f2" 13194139533445 17592186045585 true] [17592186363337 1081 "\\frac{2}{{e}^{2}}" 13194139533445 17592186045585 true] [17592186363337 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363337 1084 #uuid "c3f7d926-4b2e-5a47-a964-89bbf3409d2d" 13194139533445 175921