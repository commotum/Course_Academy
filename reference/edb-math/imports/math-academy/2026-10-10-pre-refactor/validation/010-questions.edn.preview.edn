ue] [17592186362796 1077 "selection" 13194139533445 17592186045585 true] [17592186362796 1079 #edb/ref 17592186362800 13194139533445 17592186045585 true] [17592186362796 1080 #uuid "fc49cdce-e769-51da-8336-49ccccedf4cf" 13194139533445 17592186045585 true] [17592186362797 1081 "¬P∧Q" 13194139533445 17592186045585 true] [17592186362797 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362797 1084 #uuid "73a5dfae-de22-5269-b394-1063a622918b" 13194139533445 17592186045585 true] [17592186362798 1081 "Q" 13194139533445 17592186045585 true] [17592186362798 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362798 1084 #uuid "c22efd1c-d218-5be7-b23b-d5c6adb58073" 13194139533445 17592186045585 true] [17592186362799 1081 "P" 13194139533445 17592186045585 true] [17592186362799 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362799 1084 #uuid "e591001b-b98b-5721-9316-9065bf6556b3" 13194139533445 17592186045585 true] [17592186362800 1081 "P∧Q" 13194139533445 17592186045585 true] [17592186362800 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362800 1084 #uuid "77feb873-4d30-5ac7-b1d1-883e9f13a398" 13194139533445 17592186045585 true] [17592186362801 1081 "P∨¬Q" 13194139533445 17592186045585 true] [17592186362801 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362801 1084 #uuid "eb519314-ed2d-5b40-a432-34a1cb5220cb" 13194139533445 17592186045585 true] [17592186362802 1068 #edb/ref 17592186362803 13194139533445 17592186045585 true] [17592186362802 1069 "q-127923" 13194139533445 17592186045585 true] [17592186362802 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186362802 1071 "Simplify the statement $¬C∧¬(¬D).$" 13194139533445 17592186045585 true] [17592186362802 1072 #uuid "d6dbec0c-4dc8-58a7-82db-bcfaf68f1170" 13194139533445 17592186045585 true] [17592186362802 1074 "Two negations in a row cancel each other out. So, we can simplify $¬