2}}^{2-{x}^{2}}x\\,dy\\,dx & ={\\int }_{0}^{1}x[{\\int }_{{x}^{2}}^{2-{x}^{2}}dy]\\,dx \\\\  & ={\\int }_{0}^{1}x[y]_{{x}^{2}}^{2-{x}^{2}}\\,dx \\\\  & ={\\int }_{0}^{1}x(2-{x}^{2}-{x}^{2})\\,dx \\\\  & =2{\\int }_{0}^{1}(x-{x}^{3})\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}2{\\int }_{0}^{1}(x-{x}^{3})\\,dx & =2{[\\frac{{x}^{2}}{2}-\\frac{{x}^{4}}{4}]}_{0}^{1} \\\\  & =2(\\frac{1}{2}-\\frac{1}{4}-0) \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186364553 1075 #edb/ref 17592186364554 13194139533445 17592186045585 true] [17592186364553 1075 #edb/ref 17592186364555 13194139533445 17592186045585 true] [17592186364553 1075 #edb/ref 17592186364556 13194139533445 17592186045585 true] [17592186364553 1075 #edb/ref 17592186364557 13194139533445 17592186045585 true] [17592186364553 1075 #edb/ref 17592186364558 13194139533445 17592186045585 true] [17592186364553 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364553 1077 "selection" 13194139533445 17592186045585 true] [17592186364553 1079 #edb/ref 17592186364554 13194139533445 17592186045585 true] [17592186364553 1080 #uuid "4f16d658-a7eb-5019-b040-5f1ae39482a6" 13194139533445 17592186045585 true] [17592186364554 1081 "\\frac{1}{2}" 13194139533445 17592186045585 true] [17592186364554 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364554 1084 #uuid "a77e132b-a21c-5306-8cc2-7d72cc0ddb23" 13194139533445 17592186045585 true] [17592186364555 1081 "2" 13194139533445 17592186045585 true] [17592186364555 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364555 1084 #uuid "546cf7f2-fd7a-54c1-9ffb-8e980b3d6416" 13194139533445 17592186045585 true] [17592186364556 1081 "\\frac{1}{4}" 13194139533445 17592186045585 true] [17592186364556 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364556 1084 #uuid "e176f616-3bdf-56d9-9617-1d44a38c0810" 13194139533445 17