}⁡x-\\operatorname{sin}⁡y}) & =\\frac{\\frac{∂}{∂y}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot (\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)-(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot \\frac{∂}{∂y}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)-(\\operatorname{cos}⁡x+\\operatorname{sin}⁡y)\\cdot (-\\operatorname{cos}⁡y)}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡y\\operatorname{cos}⁡x-\\operatorname{cos}⁡y\\operatorname{sin}⁡y+\\operatorname{cos}⁡x\\operatorname{cos}⁡y+\\operatorname{sin}⁡y\\operatorname{cos}⁡y}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}} \\\\  & =\\frac{2\\operatorname{cos}⁡x\\operatorname{cos}⁡y}{(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)^{2}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate the partial derivative at the point $(\\pi ,-\\pi ):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,-\\pi )} & =\\frac{2\\operatorname{cos}⁡\\pi \\operatorname{cos}⁡(-\\pi )}{(\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡(-\\pi ))^{2}} \\\\  & =\\frac{2(-1)(-1)}{(-1-0)^{2}} \\\\  & =\\frac{2}{1} \\\\  & =2\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363328 1075 #edb/ref 17592186363329 13194139533445 17592186045585 true] [17592186363328 1075 #edb/ref 17592186363330 13194139533445 17592186045585 true] [17592186363328 1075 #edb/ref 17592186363331 13194139533445 17592186045585 true] [17592186363328 1075 #edb/ref 17592186363332 13194139533445 17592186045585 true] [17592186363328 1075 #edb/ref 17592186363333 13194139533445 17592186045585 true] [17592186363328 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363328 1077 "selection" 13194139533445 17592186045585 true] [17592186363328 1079 #edb/ref 17592186363330 13194139533445 17592186045585 true] [17592186363328 1080 #uuid "33cf4f0d-d3ae-5f4a-af95-43db53f9c0fe" 