e differential equation\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{{x}^{2}+1}.\n$$" 13194139533445 17592186045585 true] [17592186362759 1075 #edb/ref 17592186362760 13194139533445 17592186045585 true] [17592186362759 1075 #edb/ref 17592186362761 13194139533445 17592186045585 true] [17592186362759 1075 #edb/ref 17592186362762 13194139533445 17592186045585 true] [17592186362759 1075 #edb/ref 17592186362763 13194139533445 17592186045585 true] [17592186362759 1075 #edb/ref 17592186362764 13194139533445 17592186045585 true] [17592186362759 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362759 1077 "selection" 13194139533445 17592186045585 true] [17592186362759 1079 #edb/ref 17592186362762 13194139533445 17592186045585 true] [17592186362759 1080 #uuid "06ab7111-1425-5b44-aaeb-a47933078f99" 13194139533445 17592186045585 true] [17592186362760 1081 "\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{{x}^{2}+1}" 13194139533445 17592186045585 true] [17592186362760 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362760 1084 #uuid "b924fff7-e1f3-501e-8490-87fa8faeb24c" 13194139533445 17592186045585 true] [17592186362761 1081 "2\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{{x}^{2}+1}" 13194139533445 17592186045585 true] [17592186362761 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362761 1084 #uuid "64de2085-9a68-50d7-bbc4-040c3e8e3a91" 13194139533445 17592186045585 true] [17592186362762 1081 "v\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{{x}^{2}+1}" 13194139533445 17592186045585 true] [17592186362762 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362762 1084 #uuid "2c67d96c-5069-5cab-942b-aeb5c32db0a6" 13194139533445 17592186045585 true] [17592186362763 1081 "2{v}^{2}\\frac{\\text{d}v}{\\text{d}x}=\\frac{3}{{x}^{2}+1}" 13194139533445 17592186045585 true] [17592186362763 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362763 1084 #uuid "ae9923eb-45e9-595c-a6d7-