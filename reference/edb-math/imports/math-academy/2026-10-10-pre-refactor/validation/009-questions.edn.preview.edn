)^{′} \\\\ (1-t)^{′}\\end{aligned}] & =[\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}t \\\\ 1-t\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}1\\cdot t+1\\cdot (1-t) \\\\ -1\\cdot t+(-1)\\cdot (1-t)\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}1 \\\\ -1\\end{aligned}]\\,✓\\end{aligned}\n$$\n\n- $b(t)=[\\begin{aligned}{t}^{2}+1 \\\\ -t\\end{aligned}]$ $\\text{isn't}$ a solution of the system. Indeed:\n\n$$\n\\begin{aligned}[\\begin{aligned}({t}^{2}+1)^{′} \\\\ (-t)^{′}\\end{aligned}] & =[\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}{t}^{2}+1 \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}2t \\\\ -1\\end{aligned}] & =[\\begin{aligned}1\\cdot ({t}^{2}+1)+1\\cdot (-t) \\\\ -1\\cdot ({t}^{2}+1)+(-1)\\cdot (-t)\\end{aligned}] \\\\ [\\begin{aligned}2t \\\\ -1\\end{aligned}] & =[\\begin{aligned}{t}^{2}-t+1 \\\\ -{t}^{2}+t-1\\end{aligned}]\\,\\times \\end{aligned}\n$$\n\n- $c(t)=[\\begin{aligned}t+1 \\\\ -t\\end{aligned}]$ $\\text{is}$ a solution of the system. Indeed:\n\n$$\n\\begin{aligned}[\\begin{aligned}(t+1)^{′} \\\\ (-t)^{′}\\end{aligned}] & =[\\begin{aligned}1 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}t+1 \\\\ -t\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}1\\cdot (t+1)+1\\cdot (-t) \\\\ -1\\cdot (t+1)+(-1)\\cdot (-t)\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}1 \\\\ -1\\end{aligned}]\\,✓\\end{aligned}\n$$\n\nNow, consider the set of solutions ${a,b}.$ Its Wronskian is\n\n$$\n\\begin{aligned}W(a,c) & =|\\begin{aligned}t & t+1 \\\\ 1-t & -t\\end{aligned}| \\\\  & =t\\cdot (-t)-(t+1)\\cdot (1-t) \\\\  & =-{t}^{2}-1+{t}^{2} \\\\  & =-1\\end{aligned}\n$$\n\nwhich is nonzero for at least one $t\\in R.$ Thus, since $a$ and $c$ are both solutions of the same linear system, and their Wronskian is nonzero for at least one $t\\in R,$ ${a,c}$ is a set of fundamental solutions of the system." 13194139533445 17592186045585 true] [17592186363767 1075 #edb/ref 17592186363768 13194139533445 17592186045585 true] [17592186363767 1075 #edb/ref 17592186363769 13194139533445 17592186045585 true] [17592186363767 1076 #edb/ref 17592186045494 13194139533445 17592186045585 true] [17592186363767 1077 "field-1" 13194139533445 17592186045585 true] [17592186363767 1079 #edb/ref 17592186363769 13194139533445 17592186045585 true] [17592186363767 1080 #uuid "e5d821b9-6e07-5d65-ac87-618f1913f360" 13194139533445 17592186045585 true] [17592186363768 1081 "isn't" 13194139533445 17592186045585 true] [17592186363768 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363768 1084 #uuid "05deb9cc-0c3e-5fef-8a60-5bf1682dee70" 13194139533445 17592186045585 true] [17592186363769 1081 "is" 13194139533445 17592186045585 true] [17592186363769 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363769 1084 #uuid "ea909113-d4de-5cfa-a787-5e314d72e545" 13194139533445 17592186045585 true] [17592186363770 1075 #edb/ref 17592186363771 13194139533445 17592186045585 true] [17592186363770 1075 #edb/ref 17592186363772 13194139533445 17592186045585 true] [17592186363770 1075 #edb/ref 17592186363773 13194139533445 17592186045585 true] [17592186363770 1075 #edb/ref 17592186363774 13194139533445 17592186045585 true] [17592186363770 1075 #edb/ref 17592186363775 13194139533445 17592186045585 true] [17592186363770 1076 #edb/ref 17592186045494 13194139533445 17592186045585 true] [17592186363770 1077 "field-6" 13194139533445 17592186045585 true] [17592186363770 1079 #edb/ref 17592186363775 13194139533445 17592186045585 true] [17592186363770 1080 #uuid "50200ce2-85a7-548a-b2b6-9cd7dae447d9" 13194139533445 17592186045585 true] [17592186363771 1081 "1" 13194139533445 17592186045585 true] [17592186363771 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363771 1084 #uuid "20cd4ce3-5e37-5847-b78d-da96b7a36af5" 13194139533445 175921860455