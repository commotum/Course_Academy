083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363225 1084 #uuid "4a64ea4a-0ae8-515d-b05b-9ae803e04729" 13194139533445 17592186045585 true] [17592186363226 1081 "{x}^{2}-\\frac{{z}^{2}}{16}=1" 13194139533445 17592186045585 true] [17592186363226 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363226 1084 #uuid "95afe498-6155-5b2e-a789-fae228068697" 13194139533445 17592186045585 true] [17592186363227 1081 "{x}^{2}+{y}^{2}=1" 13194139533445 17592186045585 true] [17592186363227 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363227 1084 #uuid "f44a2ba1-779f-59be-a3bc-5774fcb7c580" 13194139533445 17592186045585 true] [17592186363228 1081 "{y}^{2}-{x}^{2}=1" 13194139533445 17592186045585 true] [17592186363228 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363228 1084 #uuid "98cc0bb9-af80-5a84-b0db-28037e593ea2" 13194139533445 17592186045585 true] [17592186363229 1068 #edb/ref 17592186363230 13194139533445 17592186045585 true] [17592186363229 1069 "q-164399" 13194139533445 17592186045585 true] [17592186363229 1070 #edb/ref 17592186045486 13194139533445 17592186045585 true] [17592186363229 1071 "Given the ellipsoid $(x-1)^{2}+\\frac{(y-1)^{2}}{4}+\\frac{(z-5)^{2}}{2}=1$, find the domain of $z=z(x,y).$" 13194139533445 17592186045585 true] [17592186363229 1072 #uuid "b4c3310c-555f-544e-9fd7-31c9a3fe58ac" 13194139533445 17592186045585 true] [17592186363229 1074 "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+\\frac{(y-1)^{2}}{4}+\\frac{(z-5)^{2}}{2} & =1 \\\\ (z-5)^{2} & =2(1-(x-1)^{2}-\\frac{(y-1)^{2}}{4}) \\\\ z-5 & =\\pm \\sqrt{2(1-(x-1)^{2}-\\frac{(y-1)^{2}}{4})}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-(x-1)^{2}-\\frac{(y-1)^{2}}{4}\\ge 0 \\\\ (x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1\\end{aligned}\n$$\n\n \n\nwhich gives the interior of the ellipse $(x-1)^{2}+\\frac{(y-1)^{2}}{4}=1$ and its boundary.\n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1}.\n$$" 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363231 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363232 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363233 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363234 13194139533445 17592186045585 true] [17592186363230 1075 #edb/ref 17592186363235 13194139533445 17592186045585 true] [17592186363230 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363230 1077 "selection" 13194139533445 17592186045585 true] [17592186363230 1079 #edb/ref 17592186363234 13194139533445 17592186045585 true] [17592186363230 1080 #uuid "b03fdffd-f573-5a99-b226-1770ea3e8102" 13194139533445 17592186045585 true] [17592186363231 1081 "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}>1}" 13194139533445 17592186045585 true] [17592186363231 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363231 1084 #uuid "5a719123-d941-522f-b216-e78a28925020" 13194139533445 17592186045585 true] [17592186363232 1081 "{(x,y)\\,:\\,(x-1)^{2}+\\frac{{y}^{2}}{4}\\le 1}" 13194139533445 17592186045585 true] [17592186363232 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363232 1084 #uuid "e3de31ff-ea7e-5492-8565-087a8702ee30" 13194139533445 17592186045585 true] [17592186363233 1081 "{(x,y)\\,:\\,{x}^{2}+\\frac{(y-1)^{2}}{4}\\le 1}" 13194139533445 17592186045585 true] [17592186363233 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363233 1084 #uuid "a654e349-743c-56dc-bcdd-ec9064bc30d8" 13194139533445 17592186045585 true] [17592186363234 1081 "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{4}\\le 1}" 13194139533445 17592186045585 true] [17592186363234 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [1759218