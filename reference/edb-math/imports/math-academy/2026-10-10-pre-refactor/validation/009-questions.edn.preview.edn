 [17592186363200 1084 #uuid "1fe86808-a860-5dea-a76d-b7863ec75224" 13194139533445 17592186045585 true] [17592186363201 1068 #edb/ref 17592186363202 13194139533445 17592186045585 true] [17592186363201 1069 "q-164283" 13194139533445 17592186045585 true] [17592186363201 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363201 1071 "Given the ellipsoid $\\frac{(x-1)^{2}}{3}+\\frac{(y-1)^{2}}{6}+\\frac{{z}^{2}}{18}=1$, find its intercepts with the $z$-axis." 13194139533445 17592186045585 true] [17592186363201 1072 #uuid "316cb11c-48d9-5765-808b-1c4ae60a779c" 13194139533445 17592186045585 true] [17592186363201 1074 "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation:\n\n$$\n\\begin{aligned}$\\frac{(0-1)^{2}}{3}+\\frac{(0-1)^{2}}{6}+\\frac{{z}^{2}}{18} & =1 \\\\ \\frac{1}{3}+\\frac{1}{6}+\\frac{{z}^{2}}{18} & =1 \\\\ \\frac{{z}^{2}}{18} & =\\frac{1}{2} \\\\ {z}^{2} & =9 \\\\ z & =\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $z=-3$ and $z=3.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-3)$ and $(0,0,3).$" 13194139533445 17592186045585 true] [17592186363202 1075 #edb/ref 17592186363203 13194139533445 17592186045585 true] [17592186363202 1075 #edb/ref 17592186363204 13194139533445 17592186045585 true] [17592186363202 1075 #edb/ref 17592186363205 13194139533445 17592186045585 true] [17592186363202 1075 #edb/ref 17592186363206 13194139533445 17592186045585 true] [17592186363202 1075 #edb/ref 17592186363207 13194139533445 17592186045585 true] [17592186363202 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363202 1077 "selection" 13194139533445 17592186045585 true] [17592186363202 1079 #edb/ref 17592186363204 13194139533445 17592186045585 true] [17592186363202 1080 #uuid "a327b759-622d-5e88-8ad4-130e3ada74ef" 13194139533445 17592186045585 true] [17592186363203 1081 "$(0,0,-3)$ and $(0,0,2)$" 13194139533445 17592186045585 true] [17592186363203 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363203 1084 #uuid "fac58459-fc8a-5be9-a174-357811457c1f" 13194139533445 17592186045585 true] [17592186363204 1081 "$(0,0,-3)$ and $(0,0,3)$" 13194139533445 17592186045585 true] [17592186363204 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363204 1084 #uuid "472da650-36fa-5f79-a933-0ba9360f241a" 13194139533445 17592186045585 true] [17592186363205 1081 "$(0,0,-3)$ and $(0,0,1)$" 13194139533445 17592186045585 true] [17592186363205 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363205 1084 #uuid "f82ff234-f117-517b-813c-c4767f7d1219" 13194139533445 17592186045585 true] [17592186363206 1081 "$(0,0,-2)$ and $(0,0,3)$" 13194139533445 17592186045585 true] [17592186363206 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363206 1084 #uuid "1b6cafc0-e998-5e08-8682-7a681d233ee4" 13194139533445 17592186045585 true] [17592186363207 1081 "$(0,0,-1)$ and $(0,0,3)$" 13194139533445 17592186045585 true] [17592186363207 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363207 1084 #uuid "57202985-5772-5066-a73b-46c3a4f15432" 13194139533445 17592186045585 true] [17592186363208 1068 #edb/ref 17592186363209 13194139533445 17592186045585 true] [17592186363208 1069 "q-164304" 13194139533445 17592186045585 true] [17592186363208 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186363208 1071 "Given the hyperboloid of two sheets $\\frac{(x-1)^{2}}{2}+{y}^{2}-(z+2)^{2}=-1,$ find the domain of $z=z(x,y).$" 13194139533445 17592186045585 true] [17592186363208 1072 #uuid "62c4e3bb-f437-5cc4-9639-1ab5e45aee0f" 13194139533445 17592186045585 true] [17592186363208 1074 "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{2}+{y}^{2}-(z+2)^{2} & =-1 \\\\ \\frac{(x-1)^{2}}{2}+{y}^{2}+1 & =(z+2)^{2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}(z+2)^{2} & =\\frac{(x-1)^{2}}{2}+{y}^{2}+1 \\\\ z+2 & =\\pm \\sqrt{\\frac{(x-1)^{2}}{2}+{y}^{2}+1} \\\\ z & =-2\\pm \\sqrt{\\frac{(x-1)^{2}}{2}+{y}^{2}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n\\frac{(x-1)^{2}}{2}+{y}^{2}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$" 13194139533445 17592186045585 true] [17592186363209 1075 #edb/ref 17592186363210 13194139533445 17592186045585 true] [17592186363209 1075 #edb/ref 17592186363211 13194139533445 17592186045585 true] [17592186363209 1075 #edb/ref 17592186363212 13194139533445 17592186045585 true] [17592186363209 1075 #edb/ref 17592186363213 13194139533445 17592186045585 true] [17592186363209 1075 #edb/ref 17592186363214 13194139533445 17592186045585 true] [17592186363209 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363209 1077 "selection" 13194139533445 17592186045585 true] [17592186363209 1079 #edb/ref 17592186363211 13194139533445 17592186045585 true] [17592186363209 1080 #uuid "ac94e8ec-04ff-5e98-9898-11795c26f50b" 13194139533445 17592186045585 true] [17592186363210 1081 "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}<1}" 13194139533445 17592186045585 true] [17592186363210 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363210 1084 #uuid "01af6213-439b-5eac-b318-f7cb7633b916" 13194139533445 17592186045585 true] [17592186363211 1081 "{R}^{2}" 13194139533445 17592186045585 true] [17592186363211 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363211 1084 #uuid "2f6824e3-a031-5289-8272-ac90c0afa561" 13194139533445 17592186045585 true] [17592186363212 1081 "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}\\ge 1}" 13194139533445 17592186045585 true] [17592186363212 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363212 1084 #uuid "5f615af2-d250-50af-bde8-eeeacad53e13" 13194139533445 17592186045585 true] [17592186363213 1081 "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}\\le 1}" 13194139533445 17592186045585 true] [17592186363213 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363213 1084 #uuid "c320d8c6-f3c0-5c3f-a7a2-639ce24f8db3" 13194139533445 17592186045585 true] [17592186363214 1081 "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{2}+{y}^{2}>1}" 13194139533445 17592186045585 true] [17592186363214 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363214 1084 #uuid "051cf573-4468-506a-b756-2e919742a9f2" 13194139533445 17592186045585 true] [17592186363215 1068 #edb/ref 17592186363216 13194139533445 17592186045585 true] [17592186363215 1069 "q-164308" 13194139533445 17592186045585 true] [17592186363215 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363215 1071 "Given the sphere $(x-2)^{2}+{y}^{2}+(z+1)^{2}=4,$ what is the domain of $z=z(x,y)?$" 13194139533445 17592186045585 true] [17592186363215 1072 #uuid "e5fe8757-d817-5a49-b319-898d54ef3e7a" 13194139533445 17592186045585 true] [17592186363215 1074 "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2}+(z+1)^{2} & =4 \\\\ (z+1)^{2} & =4-((x-2)^{2}+{y}^{2}) \\\\ z+1 & =\\pm \\sqrt{4-((x-2)^{2}+{y}^{2})} \\\\ z & =-1\\pm \\sqrt{4-((x-2)^{2}+{y}^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}4-((x-2)^{2}+{y}^{2})\\ge 0 \\\\ (x-2)^{2}+{y}^{2}\\le 4\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-2)^{2}+{y}^{2}=4\n$$\n\nwhich is a circle of radius $2$ centered at $(2,0)$ in the $xy$-plane." 13194139533445 17592186045585 true] [17592186363216 1075 #edb/ref 17592186363217 13194139533445 17592186045585 true] [17592186363216 1075 #edb/ref 17592186363218 13194139533445 17592186045585 true] [17592186363216 1075 #edb/ref 17592186363219 13194139533445 17592186045585 true] [17592186363216 1075 #edb/ref 17592186363220 13194139533445 17592186045585 true] [17592186363216 1075 #edb/ref 17592186363221 13194139533445 17592186045585 true] [17592186363216 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363216 1077 "selection" 13194139533445 17592186045585 true] [17592186363216 1079 #edb/ref 17592186363220 13194139533445 17592186045585 true] [17592186363216 1080 #uuid "f306b6b7-3d10-5b14-9eca-a2fd85fb47ef" 13194139533445 17592186045585 true] [17592186363217 1081 "The interior and boundary of the circle of radius $1$ centered at  $(\\sqrt{2},0)$" 13194139533445 17592186045585 true] [17592186363217 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363217 1084 #uuid "abcc6672-0a4f-5b81-8a63-fc0d626dc112" 13194139533445 17592186045585 true] [17592186363218 1081 "The interior and boundary of the circle of radius $1$ centered at  $(0,-2)$" 13194139533445 17592186045585 true] [17592186363218 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363218 1084 #uuid "b898cbaf-984e-5450-bac2-8ece98fc9afb" 13194139533445 17592186045585 true] [17592186363219 1081 "The interior and boundary of the circle of radius $1$ centered at  $(0,-\\sqrt{2})$" 13194139533445 17592186045585 true] [17592186363219 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363219 1084 #uuid "73be320b-f16f-5598-b530-b59bfeb6a63e" 13194139533445 17592186045585 true] [17592186363220 1081 "The interior and boundary of the circle of radius $2$ centered at  $(2,0)$" 13194139533445 17592186045585 true] [17592186363220 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363220 1084 #uuid "57e24ecf-a1c3-59cc-8ce7-6a64c874a62f" 13194139533445 17592186045585 true] [17592186363221 1081 "The interior and boundary of the circle of radius $2$ centered at  $(-2,0)$" 13194139533445 17592186045585 true] [17592186363221 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363221 1084 #uuid "bc1a7352-d96a-58b7-b7c5-9d347d7cb95e" 13