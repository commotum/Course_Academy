86045585 true] [17592186364206 1075 #edb/ref 17592186364207 13194139533445 17592186045585 true] [17592186364206 1075 #edb/ref 17592186364208 13194139533445 17592186045585 true] [17592186364206 1075 #edb/ref 17592186364209 13194139533445 17592186045585 true] [17592186364206 1075 #edb/ref 17592186364210 13194139533445 17592186045585 true] [17592186364206 1075 #edb/ref 17592186364211 13194139533445 17592186045585 true] [17592186364206 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364206 1077 "selection" 13194139533445 17592186045585 true] [17592186364206 1079 #edb/ref 17592186364210 13194139533445 17592186045585 true] [17592186364206 1080 #uuid "92bec405-4b97-5b51-967a-b30418a002b4" 13194139533445 17592186045585 true] [17592186364207 1081 "images/d5/d573fdc38a90793a5290862e6cfa5943d982f33ee98800199e04e7200067224d.png" 13194139533445 17592186045585 true] [17592186364207 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364207 1084 #uuid "edb9e29c-19c1-512b-b67b-3c63363893cd" 13194139533445 17592186045585 true] [17592186364208 1081 "images/da/da7c5bc006ec489e9283fcf062f07e2dcc01e72793098bda3f36c2b9bc03fd90.png" 13194139533445 17592186045585 true] [17592186364208 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364208 1084 #uuid "2e884e6f-f213-5463-adf6-1016dc564801" 13194139533445 17592186045585 true] [17592186364209 1081 "images/c7/c759002d1e72c53e719ed43326ba6564b435ae7e9a80d29f4614e51f354714fc.png" 13194139533445 17592186045585 true] [17592186364209 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364209 1084 #uuid "646fdab8-0f60-50f2-ae58-70ccadbb47ed" 13194139533445 17592186045585 true] [17592186364210 1081 "images/6b/6b425704394d6fcd3090b54a3767b031b728cf4dbc44f9ac9446defe1cdb05aa.png" 13194139533445 17592186045585 true] [17592186364210 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364210 1084 #uuid "9e4b569d-919d-5cf9-b068-8191ca16e923" 13194139533445 17592186045585 true] [17592186364211 1081 "images/b7/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" 13194139533445 17592186045585 true] [17592186364211 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364211 1084 #uuid "0a6f9f97-28b2-5b81-9f8c-367ea37c7b39" 13194139533445 17592186045585 true] [17592186364212 1068 #edb/ref 17592186364213 13194139533445 17592186045585 true] [17592186364212 1069 "q-71412" 13194139533445 17592186045585 true] [17592186364212 1070 #edb/ref 17592186045486 13194139533445 17592186045585 true] [17592186364212 1071 "![](images/a3/a3e1daa4db558edc65d65f6bfe25d848de6499fa47695011fa3fb7afda326c2e.png)\n\nWhich of the following could represent the level curves of the surface $z=\\frac{{y}^{2}}{2}$ shown above?" 13194139533445 17592186045585 true] [17592186364212 1072 #uuid "5f669334-e7bc-58b4-bc46-7fea306fb463" 13194139533445 17592186045585 true] [17592186364212 1074 "First, notice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only $c$-level curves for $c\\ge 0.$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\frac{{y}^{2}}{2} & =c \\\\ y & =\\pm \\sqrt{2c}\\end{aligned}\n$$\n\nNotice that in the equations $y=\\pm \\sqrt{2c}$ do not depend on $x.$ So, for a given $c\\ge 0$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n$$\n\n$$\n\n![](images/9f/9f243d14e996f643e746a2c20c4e606df94420355d7da6211770265af2883619.png)" 13194139533445 17592186045585 true] [17592186364213 1075 #edb/ref 17592186364214 13194139533445 17592186045585 true] [17592186364213 1075 #edb/ref 17592186364215 13194139533445 17592186045585 true] [17592186364213 1075 #edb/ref 17592186364216 13194139533445 17592186045585 true] [17592186364213 1075 #edb/ref 17592186364217 13194139533445 17592186045585 true] [17592186364213 1075 #edb/ref 17592186364218 13194139533445 17592186045585 true] [17592186364213 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364213 1077 "selection" 13194139533445 17592186045585 true] [17592186364213 1079 #edb/ref 17592186364216 13194139533445 17592186045585 true] [17592186364213 1080 #uuid "904d8f28-930c-5efc-9ce7-182888897b77" 13194139533445 17592186045585 true] [17592186364214 1081 "images/5d/5d02a08781a848cf603b1a1d7cae1e3674ae1faafa1ec09097c273ee98633e6e.png" 13194139533445 17592186045585 true] [17592186364214 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364214 1084 #uuid "6119211c-9460-5205-91bf-6632457578b6" 13194139533445 17592186045585 true] [17592186364215 1081 "images/a3/a3b9d09b3b5630401089fa4cc3feedc5ac2229bb6bb047d49080d53e5c324a66.png" 13194139533445 17592186045585 true] [17592186364215 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364215 1084 #uuid "6d775fea-4bb7-59be-8dd5-2e78893daa18" 13194139533445 17592186045585 true] [17592186364216 1081 "images/9f/9f243d14e996f643e746a2c20c4e606df94420355d7da6211770265af2883619.png" 13194139533445 17592186045585 true] [17592186364216 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364216 1084 #uuid "bf6746bf-0b94-5c07-8ecc-b541466bdc89" 13194139533445 17592186045585 true] [17592186364217 1081 "images/7a/7ab95ed367277627d5baf535db74994d7d02cd41deae939d76ed08e22799ff40.png" 13194139533445 17592186045585 true] [17592186364217 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364217 1084 #uuid "cf9664db-a17b-5cad-be59-b0b634b2b206" 13194139533445 17592186045585 true] [17592186364218 1081 "images/40/408a028814088bbb85e20e52e9482a0ddfd0b21fcf70470196049c6b5f37a208.png" 13194139533445 17592186045585 true] [17592186364218 1083 #edb/ref 17592186045498 13194139533445 17592186045585 true] [17592186364218 1084 #uuid "f88efe51-ed65-546f-94a6-764382e08792" 13194139533445 17592186045585 