ed}]\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}\\,A \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}} & -\\frac{1}{\\sqrt{6}}\\end{aligned}][\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{3} & -\\frac{1}{\\sqrt{3}} \\\\ 0 & \\frac{4}{\\sqrt{6}}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overset{A}{\\overset{⏞}{[\\begin{aligned}1 & 1 \\\\ -1 & 1 \\\\ 1 & -1\\end{aligned}]}}=\\overset{Q}{\\overset{⏞}{[\\begin{aligned}\\frac{1}{\\sqrt{3}} & \\frac{2}{\\sqrt{6}} \\\\ -\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{1}{\\sqrt{6}}\\end{aligned}]}}\\overset{R}{\\overset{⏞}{[\\begin{aligned}\\sqrt{3} & -\\frac{1}{\\sqrt{6}} \\\\ 0 & \\frac{4}{\\sqrt{6}}\\end{aligned}]}}.\n$$\n\nFinally, $\\frac{{r}_{22}}{{q}_{12}}=\\frac{(\\frac{4}{\\sqrt{6}})}{(\\frac{2}{\\sqrt{6}})}=2.$" 13194139533445 17592186045585 true] [17592186362994 1075 #edb/ref 17592186362995 13194139533445 17592186045585 true] [17592186362994 1075 #edb/ref 17592186362996 13194139533445 17592186045585 true] [17592186362994 1075 #edb/ref 17592186362997 13194139533445 17592186045585 true] [17592186362994 1075 #edb/ref 17592186362998 13194139533445 17592186045585 true] [17592186362994 1075 #edb/ref 17592186362999 13194139533445 17592186045585 true] [17592186362994 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362994 1077 "selection" 13194139533445 17592186045585 true] [17592186362994 1079 #edb/ref 17592186362998 13194139533445 17592186045585 true] [17592186362994 1080 #uuid "9843f025-965b-5496-8a1b-dc49d71508f6" 13194139533445 17592186045585 true] [17592186362995 1081 "\\sqrt{2}" 13194139533445 17592186045585 true] [17592186362995 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362995 1084 #uuid "3