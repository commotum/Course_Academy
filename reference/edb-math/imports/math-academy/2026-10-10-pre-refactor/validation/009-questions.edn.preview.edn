45 17592186045585 true] [17592186364144 1084 #uuid "75b181aa-f301-5c7f-b254-cdbb1c399542" 13194139533445 17592186045585 true] [17592186364145 1081 "y=A{x}^{3}+B{x}^{3}\\operatorname{ln}⁡x" 13194139533445 17592186045585 true] [17592186364145 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364145 1084 #uuid "003bc929-c128-5357-9150-29ca3cf87417" 13194139533445 17592186045585 true] [17592186364146 1081 "y=A{x}^{3}+B\\operatorname{ln}⁡x" 13194139533445 17592186045585 true] [17592186364146 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364146 1084 #uuid "fd6960b1-4d6b-5327-bec5-62411056b13e" 13194139533445 17592186045585 true] [17592186364147 1081 "y=A{x}^{3}+B{x}^{-4}" 13194139533445 17592186045585 true] [17592186364147 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364147 1084 #uuid "2f45a811-b3de-5442-bf6d-e46f435baba6" 13194139533445 17592186045585 true] [17592186364148 1081 "y=A{x}^{3}+B{x}^{-3}" 13194139533445 17592186045585 true] [17592186364148 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364148 1084 #uuid "564018a2-4319-5125-8266-a3329ca443bc" 13194139533445 17592186045585 true] [17592186364149 1068 #edb/ref 17592186364150 13194139533445 17592186045585 true] [17592186364149 1069 "q-7004" 13194139533445 17592186045585 true] [17592186364149 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186364149 1071 "Determine the horizontal asymptote of $f(x)=\\frac{3{x}^{3}-{x}^{5}}{2{x}^{4}+{x}^{2}}.$" 13194139533445 17592186045585 true] [17592186364149 1072 #uuid "24c3e108-969e-525e-ae27-44d67fe4b02f" 13194139533445 17592186045585 true] [17592186364149 1074 "To find the horizontal asymptote of a rational function, we divide every term in the numerator and denominator by the dominant term in the denominator, and then we let $x\\to \\infty .$\n\nIgnoring the coefficient, the dominant term in the denominator is ${x}^{4}.$ So, we divide every term in the numerator and denominator by ${x}^{4},$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{3{x}^{3}-{x}^{5}}{2{x}^{4}+{x}^{2}} \\\\  & =\\frac{(\\frac{3{x}^{3}}{{x}^{4}}-\\frac{{x}^{5}}{{x}^{4}})}{(\\frac{2{x}^{4}}{{x}^{4}}+\\frac{{x}^{2}}{{x}^{4}})} \\\\  & =\\frac{(\\frac{3}{x}-x)}{(2+\\frac{1}{{x}^{2}})}\\end{aligned}\n$$\n\nNow, when $x$ is very large, the terms $\\frac{3}{x}$ and $\\frac{1}{{x}^{2}}$ become very small. Therefore, as $x\\to \\infty ,$ we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{(\\frac{3}{x}-x)}{(2+\\frac{1}{{x}^{2}})} \\\\  & ≈\\frac{0-x}{2+0} \\\\  & =-\\frac{x}{2}.\\end{aligned}\n$$\n\nThis is not a constant, which means that $y=f(x)$ does not have a horizontal asymptote." 13194139533445 17592186045585 true] [17592186364150 1075 #edb/ref 17592186364151 13194139533445 17592186045585 true] [17592186364150 1075 #edb/ref 17592186364152 13194139533445 17592186045585 true] [17592186364150 1075 #edb/ref 17592186364153 13194139533445 17592186045585 true] [17592186364150 1075 #edb/ref 17592186364154 13194139533445 17592186045585 true] [17592186364150 1075 #edb/ref 17592186364155 13194139533445 17592186045585 true] [17592186364150 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364150 1077 "selection" 13194139533445 17592186045585 true] [17592186364150 1079 #edb/ref 17592186364152 13194139533445 17592186045585 true] [17592186364150 1080 #uuid "e716f2f3-6338-537a-a46c-64f398b984ab" 13194139533445 17592186045585 true] [17592186364151 1081 "y=3" 13194139533445 17592186045585 true] [17592186364151 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364151 1084 #uuid "75932503-299a-5664-8eb6-808c05206fbb" 13194139533445 17592186045585 true] [17592186364152 1081 "No horizontal asymptotes" 13194139533445 17592186045585 true] [17592186364152 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364152 1084 #uuid "88ad18c4-d647-5a8a-a3b1-2a55dd16e472" 13194139533445 17592186045585 true] [17592186364153 1081 "y=\\frac{3}{2}" 13194139533445 17592186045585 true] [17592186364153 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364153 1084 #uuid "ea7330c0-375d-5798-bf12-a8d908a09f33" 13194139533445 17592186045585 true] [17592186364154 1081 "y=0" 13194139533445 17592186045585 true] [17592186364154 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364154 1084 #uuid "b4e4d248-805f-531a-9acf-4fac4b878602" 13194139533445 17592186045585 true] [17592186364155 1081 "y=-\\frac{1}{2}" 13194139533445 17592186045585 true] [17592186364155 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364155 1084 #uuid "acbb1152-6fdf-5824-8937-c473f5b8ca7e" 13194139533445 17592186045585 true] [17592186364156 1068 #edb/ref 17592186364157 13194139533445 17592186045585 true] [17592186364156 1069 "q-70561" 13194139533445 17592186045585 true] [17592186364156 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186364156 1071 "What are the radius $r$ and the coordinates of the center $C$ for the sphere $(x+2)^{2}+{y}^{2}+{z}^{2}=9?$" 13194139533445 17592186045585 true] [17592186364156 1072 #uuid "78363164-869e-5f95-8767-f9319085edc9" 13194139533445 17592186045585 true] [17592186364156 1074 "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nWe can write our equation as\n\n$$\n(x-(-2))^{2}+{y}^{2}+{z}^{2}={3}^{2},\n$$\n\nwhich gives us the center at the point point $C(-2,0,0)$ and the radius $r=3.$" 13194139533445 17592186045585 true] [17592186364157 1075 #edb/ref 17592186364158 13194139533445 17592186045585 true] [17592186364157 1075 #edb/ref 17592186364159 13194139533445 17592186045585 true] [17592186364157 1075 #edb/ref 17592186364160 13194139533445 17592186045585 true] [17592186364157 1075 #edb/ref 17592186364161 13194139533445 17592186045585 true] [17592186364157 1