ed}9-\\lambda  & -6 \\\\ -6 & 4-\\lambda \\end{aligned}| & =0 \\\\ (9-\\lambda )(4-\\lambda )-36 & =0 \\\\ {\\lambda }^{2}-9\\lambda -4\\lambda +36-36 & =0 \\\\ {\\lambda }^{2}-13\\lambda  & =0 \\\\ \\lambda (\\lambda -13) & =0 \\\\ \\lambda  & =13,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{13} \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=0\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186364575 1075 #edb/ref 17592186364576 13194139533445 17592186045585 true] [17592186364575 1075 #edb/ref 17592186364577 13194139533445 17592186045585 true] [17592186364575 1075 #edb/ref 17592186364578 13194139533445 17592186045585 true] [17592186364575 1075 #edb/ref 17592186364579 13194139533445 17592186045585 true] [17592186364575 1075 #edb/ref 17592186364580 13194139533445 17592186045585 true] [17592186364575 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364575 1077 "selection" 13194139533445 17592186045585 true] [17592186364575 1079 #edb/ref 17592186364578 13194139533445 17592186045585 true] [17592186364575 1080 #uuid "fd34787a-f30f-575c-9f6f-407c026f6c03" 13194139533445 17592186045585 true] [17592186364576 1081 "$9$ and $4$" 13194139533445 17592186045585 true] [17592186364576 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364576 1084 #uuid "1f0d752a-b826-5c64-be10-12da661ba4f5" 13194139533445 17592186045585 true] [17592186364577 1081 "$13$ and $0$" 13194139533445 17592186045585 true] [17592186364577 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364577 1084 #uuid "013ec41c-cc86-5fe4-b29a-accf164dceb1" 13194139533445 17592186045585 true] [17592186364578 1081 "$\\sqrt{13}$ and $0$" 13194139533445 17592186045585 true] [17592186364578 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364578 1084 #uuid "24eac0e8-069f-5b0b-9420-f802df54dfb4" 13194139533445 17