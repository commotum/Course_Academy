92186045585 true] [17592186364587 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364587 1084 #uuid "0183a8ef-a247-5fec-a72f-23430bb57861" 13194139533445 17592186045585 true] [17592186364588 1068 #edb/ref 17592186364589 13194139533445 17592186045585 true] [17592186364588 1069 "q-9539" 13194139533445 17592186045585 true] [17592186364588 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364588 1071 "Find the arc length of the polar curve $r=5-5\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{3}.$\n\n*Hint: You may wish to use the following identity: $\\operatorname{sin}⁡(\\frac{x}{2})=\\sqrt{\\frac{1-\\operatorname{cos}⁡x}{2}}.$*" 13194139533445 17592186045585 true] [17592186364588 1072 #uuid "821b961c-4260-5cdb-aa68-730b1a7ce8e8" 13194139533445 17592186045585 true] [17592186364588 1074 "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=5-5\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=5\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{(5-5\\operatorname{cos}⁡\\theta )^{2}+{(5\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{25-50\\operatorname{cos}⁡\\theta +25{cos}^{2}⁡\\theta +25{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{25-50\\operatorname{cos}⁡\\theta +25}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{50-50\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{50}{\\int }_{0}^{\\pi /3}\\sqrt{1-\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNow, we recall the identity for $\\operatorname{sin}⁡(\\frac{x}{2}):$\n\n$$\n\\operatorname{sin}⁡(\\frac{x}{2})=\\sqrt{\\frac{1-\\operatorname{cos}⁡x}{2}}\n$$\n\nTherefore, using $x=\\theta $ in the previous identity, the integral can be written as follows:\n\n$$\n\\begin{aligned}L & =\\sqrt{50}{\\int }_{0}^{\\pi /3}\\sqrt{2{sin}^{2}⁡(\\frac{\\theta }{2})}\\,\\text{d}\\theta  \\\\  & =\\sqrt{50}\\cdot \\sqrt{2}\\cdot {\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(\\frac{\\theta }{2})\\,\\text{d}\\theta  \\\\  & ={-10\\cdot 2(\\operatorname{cos}⁡(\\frac{\\theta }{2}))|}_{0}^{\\pi /3} \\\\  & =-20(\\operatorname{cos}⁡(\\frac{\\pi }{6})-\\operatorname{cos}⁡0) \\\\  & =-20(\\frac{\\sqrt{3}}{2}-1) \\\\  & =20-10\\sqrt{3}.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186364589 1075 #edb/ref 17592186364590 13194139533445 17592186045585 true] [17592186364589 1075 #edb/ref 17592186364591 13194139533445 17592186045585 true] [17592186364589 1075 #edb/ref 17592186364592 13194139533445 17592186045585 true] [17592186364589 1075 #edb/ref 17592186364593 13194139533445 17592186045585 true] [17592186364589 1075 #edb/ref 17592186364594 13194139533445 17592186045585 true] [17592186364589 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364589 1077 "selection" 13194139533445 17592186045585 true] [17592186364589 1079 #edb/ref 17592186364591 13194139533445 17592186045585 true] [17592186364589 1080 #uuid "82a45f10-ea66-583d-9440-7fd42435002d" 13194139533445 17592186045585 true] [17592186364590 1081 "10-5\\sqrt{3}" 13194139533445 17592186045585 true] [17592186364590 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364590 1084 #uuid "886a46d3-862e-5cf9-bdf7-2db062a9391d" 13194139533445 17592186045585 true] [17592186364591 1081 "20-10\\sqrt{3}" 13194139533445 17592186045585 true] [17592186364591 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364591 1084 #uuid "2080f337-f34d-5214-ae2e-1f687592ab3b" 13194139533445 17592186045585 true] [1759