3}=\\frac{y}{4},\\,z=-1" 13194139533445 17592186045585 true] [17592186364346 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364346 1084 #uuid "29c0b402-d863-5bbf-a62f-a424e72ac2d9" 13194139533445 17592186045585 true] [17592186364347 1081 "\\frac{y}{4}=\\frac{z-2}{3},\\,x=1" 13194139533445 17592186045585 true] [17592186364347 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364347 1084 #uuid "b58a06e5-6b00-50ce-8d26-0c23fb04832b" 13194139533445 17592186045585 true] [17592186364348 1081 "\\frac{x-2}{3}=\\frac{y}{4}=z-1" 13194139533445 17592186045585 true] [17592186364348 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364348 1084 #uuid "92634e32-6601-549e-96d9-d7542dbf3b94" 13194139533445 17592186045585 true] [17592186364349 1068 #edb/ref 17592186364350 13194139533445 17592186045585 true] [17592186364349 1069 "q-7200" 13194139533445 17592186045585 true] [17592186364349 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186364349 1071 "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na=⟨2t,1-2t⟩.\n$$\n\nGiven that the particle has velocity $v=⟨0,0⟩$ when $t=1$, calculate the velocity vector of $P$ at time $t.$" 13194139533445 17592186045585 true] [17592186364349 1072 #uuid "5236a23e-b8b5-5724-8cb2-cbb08faee832" 13194139533445 17592186045585 true] [17592186364349 1074 "To compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨2t,1-2t⟩\\,\\text{d}t \\\\  & =⟨\\int 2t\\,\\text{d}t,\\int (1-2t)\\,\\text{d}t⟩ \\\\  & =⟨{t}^{2}+{C}_{1},t-{t}^{2}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(1)=⟨0,0⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}v(1) & =⟨{1}^{2}+{C}_{1},1-{1}^{2}+{C}_{2}⟩ \\\\ ⟨0,0⟩ & =⟨1+{C}_{1},{C}_{2}⟩.\\end{aligned}\n$$\n\nSo, we must have\n\n$$\n\\begin{aligned}0 & =1+{C}_{1} \\\\ {C}_{1} & =-1,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}0 & ={C}_{2}.\\end{aligned}\n$$\n\nTherefore, the velocity vector is\n\n$$\nv=⟨{t}^{2}-1,t-{t}^{2}⟩.\n$$" 13194139533445 17592186045585 true] [17592186364350 1075 #edb/ref 17592186364351 13194139533445 17592186045585 true] [17592186364350 1075 #edb/ref 17592186364352 13194139533445 17592186045585 true] [17592186364350 1075 #edb/ref 17592186364353 13194139533445 17592186045585 true] [17592186364350 1075 #edb/ref 17592186364354 13194139533445 17592186045585 true] [17592186364350 1075 #edb/ref 17592186364355 13194139533445 17592186045585 true] [17592186364350 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364350 1077 "selection" 13194139533445 17592186045585 true] [17592186364350 1079 #edb/ref 17592186364352 13194139533445 17592186045585 true] [17592186364350 1080 #uuid "81724044-ccaa-5e9a-9175-e0eaf9795d78" 13194139533445 17592186045585 true] [17592186364351 1081 "v=⟨{t}^{2},2+t-{t}^{2}⟩" 13194139533445 17592186045585 true] [17592186364351 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364351 1084 #uuid "9851c993-d965-5527-911b-9e3463a1f3ba" 13194139533445 17592186045585 true] [17592186364352 1081 "v=⟨{t}^{2}-1,t-{t}^{2}⟩" 13194139533445 17592186045585 true] [17592186364352 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364352 1084 #uuid "d1a15cbd-5a79-5132-b172-b9f0d9305607" 13194139533445 17592186045585 true] [17592186364353 1081 "v=⟨{t}^{2}-1,2+t-2{t}^{2}⟩" 13194139533445 17592186045585 true] [17592186364353 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364353 1084 #uuid "9b095080-081d-5726-9994-dfe0d0a1c585" 13194139533445 17592186045585 true] [17592186364354 1081 "v=⟨2{t}^{2}-1,2t-{t}^{2}⟩" 13194139533445 17592186045585 true] [17592186364354 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364354 1084 #uuid "757fd292-1ad3-5a55-940a-48091b2ca7ce" 131