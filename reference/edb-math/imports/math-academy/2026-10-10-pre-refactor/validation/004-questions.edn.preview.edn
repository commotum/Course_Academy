xt{d}}{\\text{d}t}(1-4{e}^{t/2}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{4-t})⟩ \\\\  & =⟨-2{e}^{t/2},\\,-{e}^{4-t}⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-2{e}^{t/2}),\\,\\frac{\\text{d}}{\\text{d}t}(-{e}^{4-t})⟩ \\\\  & =⟨-{e}^{t/2},\\,{e}^{4-t}⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =5\\cdot ⟨-{e}^{t/2},\\,{e}^{4-t}⟩ \\\\  & =⟨-5{e}^{t/2},\\,5{e}^{4-t}⟩.\\end{aligned}\n$$\n\nWhen $t=3\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(3) & =⟨-5{e}^{3/2},\\,5{e}^{4-3}⟩ \\\\  & =⟨-5{e}^{3/2},\\,5e⟩.\\end{aligned}\n$$\n\nFinally, the magnitude of $F(3)$ is given by\n\n$$\n\\begin{aligned}|F(3)| & =\\sqrt{(-5{e}^{3/2})^{2}+{(5e)}^{2}} \\\\  & =\\sqrt{25{e}^{3}+25{e}^{2}} \\\\  & =5e\\sqrt{e+1} \\\\  & ≈26\\,\\text{N}\\end{aligned}\n$$\n\nrounded to the nearest Newton." 13194139533445 17592186045585 true] [17592186363188 1075 #edb/ref 17592186363189 13194139533445 17592186045585 true] [17592186363188 1075 #edb/ref 17592186363190 13194139533445 17592186045585 true] [17592186363188 1075 #edb/ref 17592186363191 13194139533445 17592186045585 true] [17592186363188 1075 #edb/ref 17592186363192 13194139533445 17592186045585 true] [17592186363188 1075 #edb/ref 17592186363193 13194139533445 17592186045585 true] [17592186363188 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363188 1077 "selection" 13194139533445 17592186045585 true] [17592186363188 1079 #edb/ref 17592186363192 13194139533445 17592186045585 true] [17592186363188 1080 #uuid "378478ea-01cc-576c-b3e5-a85a63d46a5b" 13194139533445 17592186045585 true] [17592186363189 1081 "18\\,\\text{N}" 13194139533445 17592186045585 true] [17592186363189 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363189 1084 #uuid "f0dd4195-709f-59a9-9d13-6ef5b86bc1ba"