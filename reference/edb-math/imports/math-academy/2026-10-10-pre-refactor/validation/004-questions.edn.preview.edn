,\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2})⟩ \\\\  & =⟨9{t}^{1/2},\\,3{t}^{2}-6t⟩\\end{aligned}\n$$\n\nNext, we differentiate the velocity vector to get the acceleration vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{1/2}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-6t)⟩ \\\\  & =⟨\\frac{9}{2\\sqrt{t}},\\,6t-6⟩\\end{aligned}\n$$\n\nTherefore, the resultant force $F$ at time $t$ equals\n\n$$\n\\begin{aligned}F & =ma \\\\  & =4\\cdot ⟨\\frac{9}{2\\sqrt{t}},\\,6t-6⟩ \\\\  & =⟨\\frac{18}{\\sqrt{t}},\\,24t-24⟩.\\end{aligned}\n$$\n\nFinally, when $t=4\\,\\text{s},$ we have\n\n$$\n\\begin{aligned}F(4) & =⟨\\frac{18}{\\sqrt{4}},\\,24(4)-24⟩ \\\\  & =⟨9,\\,72⟩.\\end{aligned}\n$$\n\nTherefore, we conclude that the resultant force acting on $P$ when $t=4\\,\\text{s}$ equals $⟨9,\\,72⟩\\,\\text{N}.$" 13194139533445 17592186045585 true] [17592186363181 1075 #edb/ref 17592186363182 13194139533445 17592186045585 true] [17592186363181 1075 #edb/ref 17592186363183 13194139533445 17592186045585 true] [17592186363181 1075 #edb/ref 17592186363184 13194139533445 17592186045585 true] [17592186363181 1075 #edb/ref 17592186363185 13194139533445 17592186045585 true] [17592186363181 1075 #edb/ref 17592186363186 13194139533445 17592186045585 true] [17592186363181 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363181 1077 "selection" 13194139533445 17592186045585 true] [17592186363181 1079 #edb/ref 17592186363182 13194139533445 17592186045585 true] [17592186363181 1080 #uuid "9e5b3a91-8bdf-50c4-ad53-bf480f0f2288" 13194139533445 17592186045585 true] [17592186363182 1081 "⟨9,\\,72⟩\\,\\text{N}" 13194139533445 17592186045585 true] [17592186363182 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363182 1084 #uuid "14cd1cf0-0779-5f70-9c28-d4db8b703391" 13194139533445 17592186045585 true] [17592186363183 1081 "⟨6,\\,48⟩\\,\\text{N}" 13194139533445 17592186045585 true] [17592186