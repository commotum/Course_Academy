name{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ((\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}+(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{cos}^{2}⁡\\theta {sin}^{2}⁡ϕ+{\\rho }^{2}{sin}^{2}⁡\\theta {sin}^{2}⁡ϕ) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{sin}^{2}⁡ϕ) \\\\  & =2{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2x({x}^{2}+{y}^{2})\\,\\text{d}V & ={∭}_{Δ}2{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{4}2{\\rho }^{5}\\operatorname{cos}⁡\\theta {sin}^{4}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363042 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363043 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363044 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363045 13194139533445 17592186045585 true] [17592186363041 1075 #edb/ref 17592186363046 13194139533445 17592186045585 true] [17592186363041 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363041 1077 "selection" 13194139533445 17592186045585 true] [17592186363041 1079 #edb/ref 17592186363044 13194139533445 17592186045585 true] [17592186363041 1080 #uuid "a7ce963d-75b4-566b-8c6b-5c5079626401" 13194139533445 17592186045585 true] [17592186363042 1081 "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{4