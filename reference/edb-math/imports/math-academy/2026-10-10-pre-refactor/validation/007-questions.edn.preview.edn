139533445 17592186045585 true] [17592186364307 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364307 1077 "selection" 13194139533445 17592186045585 true] [17592186364307 1079 #edb/ref 17592186364311 13194139533445 17592186045585 true] [17592186364307 1080 #uuid "5000b0ad-4add-5d5e-a297-df68ae5024b5" 13194139533445 17592186045585 true] [17592186364308 1081 "II and III only" 13194139533445 17592186045585 true] [17592186364308 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364308 1084 #uuid "17fe1d41-7bf0-5ab0-a8b3-36a281dd2aad" 13194139533445 17592186045585 true] [17592186364309 1081 "I only" 13194139533445 17592186045585 true] [17592186364309 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364309 1084 #uuid "a1ff7b33-78b9-5494-b1f6-21fedac20ac0" 13194139533445 17592186045585 true] [17592186364310 1081 "III only" 13194139533445 17592186045585 true] [17592186364310 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364310 1084 #uuid "1dc8f458-65bc-5c8d-90ae-6ef401a3ebd4" 13194139533445 17592186045585 true] [17592186364311 1081 "I and II only" 13194139533445 17592186045585 true] [17592186364311 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364311 1084 #uuid "67431a46-73ba-543b-b5f2-c0345c743beb" 13194139533445 17592186045585 true] [17592186364312 1081 "II only" 13194139533445 17592186045585 true] [17592186364312 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364312 1084 #uuid "52a7d1c6-e780-567b-a541-1a25d2b17a20" 13194139533445 17592186045585 true] [17592186364313 1068 #edb/ref 17592186364314 13194139533445 17592186045585 true] [17592186364313 1069 "q-71964" 13194139533445 17592186045585 true] [17592186364313 1070 #edb/ref 17592186045486 13194139533445 17592186045585 true] [17592186364313 1071 "Find the projection of the intersection between the sphere ${x}^{2}+(y-1)^{2}+{z}^{2}=18$ and the plane $x+z=4$ onto the $yz$-plane." 13194139533445 17592186045585 true] [17592186364313 1072 #uuid "0bc6ae12-6465-5148-98d4-0ef0bdbe9c9f" 13194139533445 17592186045585 true] [17592186364313 1074 "Since we want to find the projection onto the $yz$-plane, we need to eliminate the variable $x.$ First, we solve for $x$ in the equation of the plane, as follows:\n\n$$\n\\begin{aligned}x+z & =4\\,⟹\\,x=4-z\\end{aligned}\n$$\n\nSubstituting the expression for $x$ into the equation of the sphere, we obtain:\n\n$$\n\\begin{aligned}(4-z)^{2}+(y-1)^{2}+{z}^{2} & =18 \\\\ (16-8z+{z}^{2})+(y-1)^{2}+{z}^{2} & =18 \\\\ (y-1)^{2}+2{z}^{2}-8z+16 & =18\\end{aligned}\n$$\n\nFinally, by completing the square for the variable $z$, we have:\n\n$$\n\\begin{aligned}(y-1)^{2}+2{z}^{2}-8z+16 & =18 \\\\ (y-1)^{2}+2{z}^{2}-8z+8 & =10 \\\\ (y-1)^{2}+2({z}^{2}-4z+4) & =10 \\\\ (y-1)^{2}+2(z-2)^{2} & =10 \\\\ \\frac{(y-1)^{2}}{10}+\\frac{(z-2)^{2}}{5} & =1\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the ellipse $\\frac{(y-1)^{2}}{10}+\\frac{(z-2)^{2}}{5}=1.$" 13194139533445 17592186045585 true] [17592186364314 1075 #edb/ref 17592186364315 13194139533445 17592186045585 true] [17592186364314 1075 #edb/ref 17592186364316 13194139533445 17592186045585 true] [17592186364314 1075 #edb/ref 17592186364317 13194139533445 17592186045585 true] [17592186364314 1075 #edb/ref 17592186364318 13194139533445 17592186045585 true] [17592186364314 1075 #edb/ref 17592186364319 13194139533445 17592186045585 true] [17592186364314 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364314 1077 "selection" 13194139533445 17592186045585 true] [17592186364314 1079 #edb/ref 17592186364317 13194139533445 17592186045585 true] [17592186364314 1080 #uuid "0bea1105-bc8e-5fb7-89fa-b0993734d327" 13194139533445 17592186045585 true] [17592186364315 1081 "\\frac{(y-1)^{2}}{5}+\\frac{(z+1)^{2}}{5}=1" 13194139533445 17592186045585 true] [17592186364315 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364315 1084 #uuid "5065e557-63bb-55f2-bb79-292e1d3a86f0" 13194139533445 17592186045585 true] [17592186364316 1081 "\\frac{(y-1)^{2}}{5}+\\frac{{z}^{2}}{10}=1" 13194139533445 17592186045585 true] [17592186364316 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364316 1084 #uuid "f31a6f60-6d86-5410-a29e-fdd185206266" 13194139533445 17592186045585 true] [17592186364317 1081 "\\frac{(y-1)^{2}}{10}+\\frac{(z-2)^{2}}{5}=1" 13194139533445 17592186045585 true] [17592186364317 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364317 1084 #uuid "457da296-9484-5916-a7b9-b9dfdd65a675" 13194139533445 17592186045585 true] [17592186364318 1081 "\\frac{(y-1)^{2}}{5}+\\frac{(z+2)^{2}}{10}=1" 13194139533445 17592186045585 true] [17592186364318 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364318 1084 #uuid "5573846a-45d9-5945-8299-0e163d2c133a" 13194139533445 17592186045585 true] [17592186364319 1081 "\\frac{(y-1)^{2}}{10}+\\frac{{z}^{2}}{5}=1" 13194139533445 17592186045585 true] [17592186364319 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364319 1084 #uuid "ed93bd94-0b7d-5ad9-914c-e2e3e32149e6" 13194139533445 17592186045585 true] [17592186364320 1068 #edb/ref 17592186364321 13194139533445 17592186045585 true] [17592186364320 1069 "q-72124" 13194139533445 17592186045585 true] [17592186364320 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364320 1071 "![](images/d1/d1c2f0e830c6d3beca27886e839816f46a00be322c9d7cff18248d118ed0e617.png)\n\nWhich of the following represents the shaded region above as a type I region in two-dimensional space?" 13194139533445 17592186045585 true] [17592186364320 1072 #uuid "76027899-49f4-5ed4-93bc-de501abde637" 13194139533445 17592186045585 true] [17592186364320 1074 "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type I region, we first rewrite all of the given curves as functions of $x:$\n\n$$\nx=\\sqrt{3-y}+1\\,⟹\\,y=3-(x-1)^{2}\n$$\n\nThe function $y=0$ is already written as a function of $x.$\n\nNotice that the region lies between the vertical lines $x=1$ and $x=2.$ So, we have $0\\le x\\le 1.$\n\nWe draw a vertical arrow through the region to determine the lower function $g(x)$ and the upper function $f(x).$ A vertical line should intersect the region in a single interval only for it to be a type I region.\n\n![](images/be/be799df2140d3a437bb311427dcae0e297cb6bd3844f88932157eb6ace6e7e59.png)\n\nThe vertical line enters the region through the lower function $y=0$ and leaves through the upper function $y=3-(x-1)^{2}.$ So, we have $0\\le y\\le 3-(x-1)^{2}.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le 3-(x-1)^{2}}.\n$$" 13194139533445 17592186045585 true] [17592186364321 1075 #edb/ref 17592186364322 13194139533445 17592186045585 true] [17592186364321 1075 #edb/ref 17592186364323 13194139533445 17592186045585 true] [17592186364321 1075 #edb/ref 17592186364324 13194139533445 17592186045585 true] [17592186364321 1075 #edb/ref 17592186364325 13194139533445 17592186045585 true] [17592186364321 1075 #edb/ref 17592186364326 13194139533445 17592186045585 true] [17592186364321 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364321 1077 "selection" 13194139533445 17592186045585 true] [17592186364321 1079 #edb/ref 17592186364323 13194139533445 17592186045585 true] [17592186364321 1080 #uuid "e789573f-de55-535f-afca-3eee3bb4aa74" 13194139533445 17592186045585 true] [17592186364322 1081 "{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 3-(x-1)^{2}}" 13194139533445 17592186045585 true] [17592186364322 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364322 1084 #uuid "9db76155-8671-5467-8f85-0d2112f29767" 13194139533445 17592186045585 true] [17592186364323 1081 "{(x,y)\\,:\\,1\\l