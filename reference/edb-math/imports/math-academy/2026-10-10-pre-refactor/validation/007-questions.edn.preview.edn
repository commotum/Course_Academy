2x),\\,y-2x+2x⟩ \\\\  & =⟨{{y}_{⏟}}_{P},\\,{{y-x}_{⏟}}_{Q},\\,{{y}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨y,\\,x+z,\\,z+2x⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-y\\cdot (-2)-(y-x)\\cdot (1)+y)\\,\\text{d}A \\\\  & ={∬}_{D}(2y-y+x+y)\\,\\text{d}A \\\\  & ={∬}_{D}(2y+x)\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}(2y+x)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{[{y}^{2}+xy]}_{y=0}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(1+x)\\,\\text{d}x \\\\  & ={[x+\\frac{{x}^{2}}{2}]}_{1}^{2} \\\\  & =2+2-1-\\frac{1}{2} \\\\  & =\\frac{5}{2}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362986 1075 #edb/ref 17592186362987 13194139533445 17592186045585 true] [17592186362986 1075 #edb/ref 17592186362988 13194139533445 17592186045585 true] [17592186362986 1075 #edb/ref 17592186362989 13194139533445 17592186045585 true] [17592186362986 1075 #edb/ref 17592186362990 13194139533445 17592186045585 true] [17592186362986 1075 #edb/ref 17592186362991 13194139533445 17592186045585 true] [17592186362986 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362986 1077 "selection" 13194139533445 17592186045585 true] [17592186362986 1079 #edb/ref 17592186362988 13194139533445 17592186045585 true] [17592186362986 1080 #uuid "05d45f19-fa05-53a9-92e1-77a6078e07fb" 13194139533445 17592186045585 true] [17592186362987 1081 "\\frac{7}{2}" 13194139533445 17592186045585 true] [17592186362987 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362987 1084 #uuid "35f2e086-31b9-544a-9b9a-99a08a27f04e" 13194139533445 17592186045585 true] [17592186362988 1081 "\\frac{5}{2}" 13194139533445 17592186045585 true] [17592186362988 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362988 1084 #uuid "291af077-cf81-5322-8799-9c4d0a56816f" 13194139533445 17592186045585 true] [1