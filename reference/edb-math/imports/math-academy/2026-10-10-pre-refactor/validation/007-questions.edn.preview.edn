186045585 true] [17592186364611 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364611 1071 "$$\nB={[\\begin{aligned}1 \\\\ -1\\end{aligned}],[\\begin{aligned}-3 \\\\ 4\\end{aligned}]},\\,[T]_{B}=[\\begin{aligned}6 & 3 \\\\ 2 & 2\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ and the matrix $[T]_{B}$ of a linear transformation $T$ with respect to this basis. Find the matrix of $T$ relative to the standard basis $S.$" 13194139533445 17592186045585 true] [17592186364611 1072 #uuid "79a5e7a2-1011-5d57-b87b-c63e9e620d23" 13194139533445 17592186045585 true] [17592186364611 1074 "The connection between the matrices of our linear transformation $T$ relative to the basis $B$ and standard basis $S$ is given by the following diagram:\n\n![](images/db/dbd020362f950fe8bfb4c592652b9e78a73610fa01a247b0b7ead6f201bf9ea5.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{S}={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1},\n$$\n\nand the change-of-coordinates matrix from $B$ to $S$ is\n\n$$\n{P}_{B\\to S}=[\\begin{aligned}1 & -3 \\\\ -1 & 4\\end{aligned}].\n$$\n\nFirst, we compute the inverse of ${P}_{B\\to S}:$\n\n$$\n\\begin{aligned}{P}_{B\\to S}^{-1} & ={[\\begin{aligned}1 & -3 \\\\ -1 & 4\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{4\\cdot 1-(-1)\\cdot (-3)}[\\begin{aligned}4 & 3 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 3 \\\\ 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can compute the matrix of $T$ relative to the standard basis $S:$\n\n$$\n\\begin{aligned}[T]_{S} & ={P}_{B\\to S}\\cdot [T]_{B}\\cdot {P}_{B\\to S}^{-1} \\\\  & =[\\begin{aligned}1 & -3 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}6 & 3 \\\\ 2 & 2\\end{aligned}][\\begin{aligned}4 & 3 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -3 \\\\ 2 & 5\\end{aligned}][\\begin{aligned}4 & 3 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -3 \\\\ 13 & 11\\end{aligned}]\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186364612 1075 #edb/ref 17592186364613 13194139533445 17592186045585 true] [17592186364612 1075 #edb/ref 17592186364614 13194139533445 17592186045585 true] [17592186364612 1075 #edb/ref 17592186364615 13194139533445 17592186045585 true] [17592186364612 1075 #edb/ref 17592186364616 13194139533445 17592186045585 true] [17592186364612 1075 #edb/ref 17592186364617 13194139533445 17592186045585 true] [17592186364612 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364612 1077 "selection" 13194139533445 17592186045585 true] [17592186364612 1079 #edb/ref 17592186364616 13194139533445 17592186045585 true] [17592186364612 1080 #uuid "1ff368e9-8ea0-51a4-8f24-f214ce6cf4d3" 13194139533445 17592186045585 true] [17592186364613 1081 "[\\begin{aligned}12 & -18 \\\\ 3 & -4\\end{aligned}]" 13194139533445 17592186045585 true] [17592186364613 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364613 1084 #uuid "820b9c20-45ba-5de9-bb8b-af39b16c9e09" 13194139533445 17592186045585 true] [17592186364614 1081 "[\\begin{aligned}3 & -12 \\\\ -3 & 14\\end{aligned}]" 13194139533445 17592186045585 true] [17592186364614 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364614 1084 #uuid "ae8e5c22-2007-5bee-a8c6-367d57800d00" 13194139533445 17592186045585 true] [17592186364615 1081 "[\\begin{aligned}3 & -6 \\\\ 0 & 2\\end{aligned}]" 13194139533445 17592186045585 true] [17592186364615 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364615 1084 #uuid "ccb49c47-6d12-5ccf-86ec-19b3a6a0b835" 13194139533445 17592186045585 true] [17592186364616 1081 "[\\begin{aligned}-3 & -3 \\\\ 13 & 11\\end{aligned}]" 13194139533445 17592186045585 true] [17592186364616 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364616 1084 #uuid "885945eb-10d2-5fdc-8538-d0c388289fe3" 13194139533445 17592186045585 true] [17592186364617 1081 "[\\begin{aligned}7 & 1 \\\\ 10 & 8\\end{aligned}]" 13194139533445 17592186045585 true] [17592186364617 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364617 1084 #uuid "d641aa56-a1eb-541f-be4a-bd4ecd276eac" 13194139533445 17592186045585 true] [17592186364618 1075 #edb/ref 17592186364619 13194139533445 17592186045585 true] [17592186364618 1075 #edb/ref 17592186364620 13194139533445 17592186045585 true] [17592186364618 1075 #edb/ref 17592186364621 13194139533445 17592186045585 true] [17592186364618 1075 #edb/ref 17592186364622 13194139533445 17592186045585 true] [17592186364618 1075 #edb/ref 17592186364623 13194139533445 17592186045585 true] [17592186364618 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364618 1077 "selection" 13194139533445 17592186045585 true] [17592186364618 1079 #edb/ref 17592186364622 13194139533445 17592186045585 true] [17592186364618 1080 #uuid "ec043ff4-d58e-5991-9b8d-3bdb610bc66a" 13194139533445 17592186045585 true] [17592186364619 1081 "{\\sum }_{n=1}^{7}{2}^{n-1}" 13194139533445 17592186045585 true] [17592186364619 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364619 1084 #uuid "bfcb3f69-55bd-5341-be4e-72ad353b873a" 13194139533445 17592186045585 true] [17592186364620 1081 "{\\sum }_{n=1}^{5}{4}^{n-1}" 13194139533445 17592186045585 true] [17592186364620 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364620 1084 #uuid "9c16ee8a-773f-5631-922c-482128bc0834" 13194139533445 17592186045585 true] [17592186364621 1081 "{\\sum }_{n=1}^{6}{4}^{n-1}" 13194139533445 17592186045585 true] [17592186364621 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364621 1084 #uuid "e8db406a-797d-5a0c-ad56-ef9f2ae41e97" 13194139533445 17592186045585 true] [17592186364622 1081 "{\\sum }_{n=1}^{7}{4}^{n-1}" 13194139533445 17592186045585 true] [17592186364622 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364622 1084 #uuid "4239cddb-b6b8-5fef-942d-0f2d09b43064" 13194139533445 17592186045585 true] [17592186364623 1081 "{\\sum }_{n=1}^{6}{2}^{n-1}" 13194139533445 17592186045585 true] [17592186364623 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364623 1084 #uuid "16b350b8-e26e-57c5-8c8b-90b312eece58" 13194139533445 17592186045585 true] [17592186364624 1068 #edb/ref 17592186364625 13194139533445 17592186045585 true] [17592186364624 1069 "q-98712" 13194139533445 17592186045585 true] [17592186364624 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364624 1071 "![](images/12/127ce21273f015a6c6d94f7310d55752f0df59109d4eda6b124dcf30dbcd8a84.png)\n\nConsiderer the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=-1$ is a node.\n- $y=-1$ is a sink.\n- $y=3$ is a source." 13194139533445 17592186045585 true] [17592186364624 1072 #uuid "e443c6c6-f36c-520d-8b6e-ac840237648e" 13194139533445 17592186045585 true] [17592186364624 1074 "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/00/00b78ec1a61666d8c313593abeac98da1f2717b4db29ea4dca2c7e0e5c817f55.png)\n\nTherefore, we have:\n\n- Statement I is true while statement II is false. From the phase line, we see that $y=-1$ is a node.\n\n- Statement III is true. From the phase line, we see that $y=3$ is a source.\n\nTherefore, the correct answer is \"I and III only\"." 13194139533445 17592186045585 true] [17592186364625 1075 #edb/ref 17592186364626 13194139533445 17592186045585 true] [17592186364625 1075 #edb/ref 17592186364627 13194139533445 17592186045585 true] [17592186364625 1075 #edb/ref 17592186364628 13194139533445 17592186045585 true] [17592186364625 1075 #edb/ref 17592186364629 13194139533445 17592186045585 true] [17592186364625 1075 #edb/ref 17592186364630 13194139533445 17592186045585 true] [17592186364625 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364625 1077 "selection" 13194139533445 17592186045585 true] [17592186364625 1079 #edb/ref 17592186364627 13194139533445 17592186045585 true] [17592186364625 1080 #uuid "08fff4be-af86-5290-ac57-639c5cca766b" 13194139533445 17592186045585 true] [17592186364626 1081 "II and III only" 13194139533445 17592186045585 true] [17592186364626 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364626 1084 #uuid "e1f8fa5e-8357-5544-87e4-1fecf437e00d" 13194139533445 17592186045585 true] [17592186364627 1081 "I and III only" 13194139533445 17592186045585 true] [17592186364627 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364627 1084 #uuid "9a6438f3-2979-57f0-b1ed-e7628f47b207" 13194139533445 17592186045585 true] [17592186364628 1081 "I only" 13194139533445 17592186045585 true] [17592186364628 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364628 1084 #uuid "170e35af-d209-5a77-98fc-94f282e64001" 13194139533445 17592186045585 true] [17592186364629 1081 "III only" 13194139533445 17592186045585 true] [17592186364629 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364629 1084 #uuid "3c5f035c-5805-5c08-aaa1-170f9450487c" 13194139533445 17592186045585 true] [17592186364630 1081 "II only" 13194139533445 17592186045585 true] [17592186364630 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364630 1084 #uu