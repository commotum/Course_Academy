}⁡ϕ}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{-12\\operatorname{cos}⁡ϕ}\\rho \\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363118 1075 #edb/ref 17592186363119 13194139533445 17592186045585 true] [17592186363118 1075 #edb/ref 17592186363120 13194139533445 17592186045585 true] [17592186363118 1075 #edb/ref 17592186363121 13194139533445 17592186045585 true] [17592186363118 1075 #edb/ref 17592186363122 13194139533445 17592186045585 true] [17592186363118 1075 #edb/ref 17592186363123 13194139533445 17592186045585 true] [17592186363118 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363118 1077 "selection" 13194139533445 17592186045585 true] [17592186363118 1079 #edb/ref 17592186363123 13194139533445 17592186045585 true] [17592186363118 1080 #uuid "10083b6f-a4ec-5324-a060-0ea1a0edbcb5" 13194139533445 17592186045585 true] [17592186363119 1081 "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{-6\\operatorname{cos}⁡ϕ}\\rho \\,d\\rho \\,d\\theta \\,dϕ" 13194139533445 17592186045585 true] [17592186363119 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363119 1084 #uuid "d2fdf814-d2f5-5086-9d1d-4523f27607d3" 13194139533445 17592186045585 true] [17592186363120 1081 "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{-12\\operatorname{cos}⁡ϕ}\\frac{1}{\\rho \\operatorname{sin}⁡ϕ}\\,d\\rho \\,d\\theta \\,dϕ" 13194139533445 17592186045585 true] [17592186363120 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363120 1084 #uuid "b2595f9d-5113-56e8-941b-a8f11678e6cf" 13194139533445 17592186045585 true] [17592186363121 1081 "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{-12\\operatorname{cos}⁡ϕ}\\rho \\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" 13194139533445 17592186045585 true] [17592186363121 1083 #edb/ref 17592186045499 13194139533445 17