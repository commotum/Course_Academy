45 17592186045585 true] [17592186363213 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363213 1071 "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=1,$ $x=3,$ $y=0,$ $y=2,$ $z=-1,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=(y-{x}^{2})\\,i+xy\\,j+3xz\\,k,$ find the flux of $F$ across $S.$" 13194139533445 17592186045585 true] [17592186363213 1072 #uuid "c1604058-cdd6-524d-a2be-ab81c147d2ce" 13194139533445 17592186045585 true] [17592186363213 1074 "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(y-{x}^{2})+\\frac{∂}{∂y}(xy)+\\frac{∂}{∂z}(3xz) \\\\  & =(-2x)+x+3x \\\\  & =2x.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}2x\\,\\text{d}V \\\\  & ={\\int }_{1}^{3}{\\int }_{0}^{2}{\\int }_{-1}^{1}2x\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}2x\\,\\text{d}x\\cdot {\\int }_{0}^{2}\\text{d}y\\cdot {\\int }_{-1}^{1}\\text{d}z \\\\  & =[{x}^{2}]_{x=1}^{x=3}\\cdot (2-0)\\cdot (1-(-1)) \\\\  & =(9-1)\\cdot 2\\cdot 2 \\\\  & =32.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363214 1075 #edb/ref 17592186363215 13194139533445 17592186045585 true] [17592186363214 1075 #edb/ref 17592186363216 13194139533445 17592186045585 true] [17592186363214 1075 #edb/ref 17592186363217 13194139533445 17592186045585 true] [17592186363214 1075 #edb/ref 17592186363218 13194139533445 17592186045585 true] [17592186363214 1075 #edb/ref 17592186363219 13194139533445 17592186045585 true] 