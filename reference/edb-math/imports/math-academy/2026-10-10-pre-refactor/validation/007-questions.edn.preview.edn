1} \\\\ {2}^{5} & ={2}^{N-1} \\\\ 5 & =N-1 \\\\ N & =6.\\end{aligned}\n$$\n\nExpressing the geometric series in sigma notation, we obtain:\n\n$$\n\\begin{aligned}512+256+128⋯+16 & ={\\sum }_{n=1}^{6}512\\cdot {(\\frac{1}{2})}^{n-1}\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362603 1075 #edb/ref 17592186362604 13194139533445 17592186045585 true] [17592186362603 1075 #edb/ref 17592186362605 13194139533445 17592186045585 true] [17592186362603 1075 #edb/ref 17592186362606 13194139533445 17592186045585 true] [17592186362603 1075 #edb/ref 17592186362607 13194139533445 17592186045585 true] [17592186362603 1075 #edb/ref 17592186362608 13194139533445 17592186045585 true] [17592186362603 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362603 1077 "selection" 13194139533445 17592186045585 true] [17592186362603 1079 #edb/ref 17592186362604 13194139533445 17592186045585 true] [17592186362603 1080 #uuid "381bfb81-b652-5949-98b9-4ab59c5d64e0" 13194139533445 17592186045585 true] [17592186362604 1081 "{\\sum }_{n=1}^{6}512\\cdot {(\\frac{1}{2})}^{n-1}" 13194139533445 17592186045585 true] [17592186362604 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362604 1084 #uuid "86f3ac5e-b59b-5ee8-8943-66eacad31e32" 13194139533445 17592186045585 true] [17592186362605 1081 "{\\sum }_{n=1}^{7}512\\cdot {(\\frac{1}{3})}^{n-1}" 13194139533445 17592186045585 true] [17592186362605 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362605 1084 #uuid "b3f9daa4-d172-57d1-a37f-48888b23a194" 13194139533445 17592186045585 true] [17592186362606 1081 "{\\sum }_{n=1}^{5}512\\cdot {(\\frac{1}{2})}^{n-1}" 13194139533445 17592186045585 true] [17592186362606 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362606 1084 #uuid "795acd6a-71f4-55a4-9646-4dbb6d4824dc" 13194139533445 17592186045585 true] [17592186362607 1081 "{\\sum }_{n=1}^{6}512\\cdot {(\\frac{1}{3})}^{n-1}" 13194139533445 1759218