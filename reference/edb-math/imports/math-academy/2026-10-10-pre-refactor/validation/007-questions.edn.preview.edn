94139533445 17592186045585 true] [17592186362702 1081 "{y}^{2}=-\\frac{8}{3}x" 13194139533445 17592186045585 true] [17592186362702 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362702 1084 #uuid "872a2269-3052-5ab5-95d0-5097d1a25948" 13194139533445 17592186045585 true] [17592186362703 1081 "{y}^{2}=\\frac{4}{3}x" 13194139533445 17592186045585 true] [17592186362703 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362703 1084 #uuid "9ae9ebc1-cccc-5e27-aed5-8977b108561d" 13194139533445 17592186045585 true] [17592186362704 1081 "{y}^{2}=-\\frac{16}{3}x" 13194139533445 17592186045585 true] [17592186362704 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362704 1084 #uuid "ff8da08a-86de-5e75-b358-78c4bd37ae62" 13194139533445 17592186045585 true] [17592186362705 1081 "{y}^{2}=\\frac{16}{3}x" 13194139533445 17592186045585 true] [17592186362705 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362705 1084 #uuid "30891f3a-3a59-5735-a045-d3f3eaf7cb5a" 13194139533445 17592186045585 true] [17592186362706 1081 "{y}^{2}=\\frac{8}{3}x" 13194139533445 17592186045585 true] [17592186362706 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362706 1084 #uuid "74827790-27dc-531a-a346-fa5981e4aed8" 13194139533445 17592186045585 true] [17592186362707 1068 #edb/ref 17592186362708 13194139533445 17592186045585 true] [17592186362707 1069 "q-11797" 13194139533445 17592186045585 true] [17592186362707 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186362707 1071 "![](images/fa/fa1a104b11a38b0d028ad583e2d7288af038c59fdece437a09ca1e9142288c56.png)\n\nWhat is the equation of the parabola shown above?" 13194139533445 17592186045585 true] [17592186362707 1072 #uuid "3e7cacdb-d776-5904-af50-bc392a6f6767" 13194139533445 17592186045585 true] [17592186362707 1074 "From the diagram we see that the arms of the parabola open to the right. The parabola has its vertex at $(-4,-2)$ and passes through the point $(8,-6).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-4,-2),$ we substitute $h=-4$ and $k=-2$ into the equation above and get\n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x+4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(8,-6),$ so we can substitute $x=8$ and $y=-6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x+4) \\\\ (-6+2)^{2} & =4p(8+4) \\\\ 16 & =48p \\\\ p & =\\frac{1}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+2)^{2} & =4p(x+4) \\\\ (y+2)^{2} & =4(\\frac{1}{3})(x+4) \\\\ (y+2)^{2} & =\\frac{4}{3}(x+4).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=\\frac{1}{3}$ is positive." 13194139533445 17592186045585 true] [17592186362708 1075 #edb/ref 17592186362709 13194139533445 17592186045585 true] [17592186362708 1075 #edb/ref 17592186362710 13194139533445 17592186045585 true] [17592186362708 1075 #edb/ref 17592186362711 13194139533445 17592186045585 true] [17592186362708 1075 #edb/ref 17592186362712 13194139533445 17592186045585 true] [17592186362708 1075 #edb/ref 17592186362713 13194139533445 17592186045585 true] [17592186362708 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362708 1077 "selection" 13194139533445 17592186045585 true] [17592186362708 1079 #edb/ref 17592186362711 13194139533445 17592186045585 true] [17592186362708 1080 #uuid "c070c142-569a-539d-8d0c-68293be58109" 13194139533445 17592186045585 true] [17592186362709 1081 "(y+2)^{2}=\\frac{8}{3}(x+4)" 13194139533445 17592186045585 true] [17592186362709 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362709 1084 #uuid "747a2ebd-ddb2-520c-8d9d-8fdb2e40d491" 13194139533445 17592186045585 true] [17592186362710 1081 "(y+2)^{2}=-\\frac{4}{3}(x+4)" 13194139533445 17592186045585 true] [17592186362710 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362710 1084 #uuid "08a89cb7-2cc3-5dc5-a896-97af521b6ede" 13194139533445 17592186045585 true] [17592186362711 1081 "(y+2)^{2}=\\frac{4}{3}(x+4)" 13194139533445 17592186045585 true] [17592186362711 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362711 1084 #uuid "cc20249c-802a-5a8b-a58b-af9837b2fae4" 13194139533445 17592186045585 true] [17592186362712 1081 "(y+2)^{2}=-\\frac{8}{3}(x+4)" 13194139533445 17592186045585 true] [17592186362712 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362712 1084 #uuid "82c1fd23-8607-5195-8220-a68685b20753" 13194139533445 17592186045585 true] [17592186362713 1081 "(y+4)^{2}=\\frac{4}{3}(x+2)" 13194139533445 17592186045585 true] [17592186362713 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362713 1084 #uuid "58a6c9a4-ec24-50e9-b4a5-4ee54c9d602c" 13194139533445 17592186045585 true] [17592186362714 1068 #edb/ref 17592186362715 13194139533445 17592186045585 true] [17592186362714 1069 "q-11804" 13194139533445 17592186045585 true] [17592186362714 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186362714 1071 "Find the equation of the right-opening parabola that has its vertex at $(-4,0)$ and passes through the point $(2,6).$" 13194139533445 17592186045585 true] [17592186362714 1072 #uuid "8f696886-0e46-53a6-ad68-09a04d160739" 13194139533445 17592186045585 true] [17592186362714 1074 "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-4,0),$ we substitute $h=-4$ and $k=0$ into the equation above and get\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(2,6),$ so we can substitute $x=2$ and $y=6$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4) \\\\ {6}^{2} & =4p(2+4) \\\\ 36 & =24p \\\\ p & =\\frac{3}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4p(x+4) \\\\ {y}^{2} & =4(\\frac{3}{2})(x+4) \\\\ {y}^{2} & =6(x+4).\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362715 1075 #edb/ref 17592186362716 13194139533445 17592186045585 true] [17592186362715 1075 #edb/ref 17592186362717 13194139533445 17592186045585 true] [17592186362715 1075 #edb/ref 17592186362718 13194139533445 17592186045585 true] [17592186362715 1075 #edb/ref 17592186362719 13194139533445 17592186045585 true] [17592186362715 1075 #edb/ref 17592186362720 13194139533445 17592186045585 true] [17592186362715 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362715 1077 "selection" 13194139533445 17592186045585 true] [17592186362715 1079 #edb/ref 17592186362718 13194139533445 17592186045585 true] [17592186362715 1080 #uuid "5942b929-5089-5214-907e-e7493d6e67ef" 13194139533445 17592186045585 true] [17592186362716 1081 "{y}^{2}=3(x+4)" 13194139533445 17592186045585 true] [17592186362716 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362716 1084 #uuid "4679e248-6c42-5b10-a7f5-85a11d3b7d85" 13194139533445 17592186045585 true] [17592186362717 1081 "{y}^{2}=-3(x+4)" 13194139533445 17592186045585 true] [17592186362717 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362717 1084 #uuid "856d50e5-77b1-5abd-9e58-dd5120b3b2d3" 13194139533445 17592186045585 true] [17592186362718 1081 "{y}^{2}=6(x+4)" 13194139533445 17592186045585 true] [17592186362718 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362718 1084 #uuid "7564d90f-3072-5560-97a2-b7637953b396" 13194139533445 17592186045585 true] [17592186362719 1081 "(y+4)^{2}=6x" 13194139533445 17592186045585 true] [17592186362719 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362719 1084 #uuid "a857ee56-5af2-5972-87ed-e38d87eec7d2" 13194139533445 17592186045585 true] [17592186362720 1081 "{y}^{2}=-6(x+4)" 13194139533445 17592186045585 true] [17592186362720 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362720 1084 #uuid "ec7465ca-5d48-5f3f-a89c-d3a97da947e2" 13194139533445 17592186045585 true] [17592186362721 1068 #edb/ref 17592186362722 13194139533445 17592186045585 true] [17592186362721 1069 "q-119162" 13194139533445 17592186045585 true] [17592186362721 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186362721 1071 "The volume of a cylinder increases at a rate inversely proportional to its height. Write down a differential equation describing the rate of change of the height, $h(t),$ in this process. Assume that the radius of the cylinder does not change and that $K>0.$" 13194139533445 17592186045585 true] [17592186362721 1072 #uuid "a1f7831a-b17a-51fb-b856-65c1e5eaee38" 13194139533445 17592186045585 true] [17592186362721 1074 "Let's highlight the important words in the given statement:\n\n*The **volume** of a cylinder **increases** at a rate **inversely proportional** to its **height**.* \n\nWe note the following:\n\n- The question describes the *rate* at which the *volume $V$ of a cylinder* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}V}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}V}{\\text{d}t}$ *increases* at a rate *inversely proportional to the height $h.$* Therefore,\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=\\frac{k}{h},\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}h}{\\text{d}t}.$\n\nThe volume $V$ of a cylinder is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nDifferentiating this equation with respect to $t,$ and using the fact that the radius of the cylinder does not change, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}h) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\pi {r}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{k}{h} \\\\ \\pi {r}^{2}\\frac{\\text{d}h}{\\text{d}t} & =\\frac{k}{h} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =\\frac{(\\frac{k}{h})}{\\pi {r}^{2}} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =\\frac{k}{\\pi {r}^{2}h}.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{\\pi {r}^{2}}>0\n$$\n\n \n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}=\\frac{K}{h}.\n$$" 13194139533445 17592186045585 true] [17592186362722 1075 #edb/ref 17592186362723 13194139533445 17592186045585 true] [17592186362722 1075 #edb/ref 17592186362724 13194139533445 17592186045585 true] [17592186362722 1075 #edb/ref 17592186362725 13194139533445 17592186045585 true] [17592186362722 1075 #edb/ref 17592186362726 13194139533445 17592186045585 true] [17592186362722 1075 #edb/ref 17592186362727 13194139533445 17592186045585 true] [17592186362722 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362722 1077 "selection" 13194139533445 17592186045585 true] [17592186362722 1079 #edb/ref 17592186362724 13194139533445 17592186045585 true] [17592186362722 1080 #uuid "b6b289cf-37d4-53ba-b515-6ded603baf24" 13194139533445 17592186045585 true] [17592186362723 1081 "\\frac{\\text{d}h}{\\text{d}t}=K{h}^{2}" 13194139533445 17592186045585 true] [17592186362723 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362723 1084 #uuid "95ff1bca-2c6f-5a26-8722-faafc6568b3d" 13194139533445 17592186045585 true] [17592186362724 1081 "\\frac{\\text{d}h}{\\text{d}t}=\\frac{K}{h}" 13194139533445 17592186045585 true] [17592186362724 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [1759218