e}^{3}-1}{{e}^{3}+1}.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186364027 1075 #edb/ref 17592186364028 13194139533445 17592186045585 true] [17592186364027 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186364027 1077 "field-1" 13194139533445 17592186045585 true] [17592186364027 1079 #edb/ref 17592186364028 13194139533445 17592186045585 true] [17592186364027 1080 #uuid "a6f51352-3d01-53ca-8db3-11580f65199a" 13194139533445 17592186045585 true] [17592186364028 1081 "{e}^{3}-1" 13194139533445 17592186045585 true] [17592186364028 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364028 1084 #uuid "60a7da25-3819-543c-8175-bafe62ae6511" 13194139533445 17592186045585 true] [17592186364029 1068 #edb/ref 17592186364030 13194139533445 17592186045585 true] [17592186364029 1069 "q-343184" 13194139533445 17592186045585 true] [17592186364029 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364029 1071 "![](images/e0/e0c966c29904cd5b5bce39e8a6675f05b658c457fa58338f336b90ee50c9141b.png)\n\nA factory uses a rectangular mold with a fixed width of $18\\,\\text{in}$ and a fixed height of $10\\,\\text{in}.$ Liquid resin is poured in so that the resin fills the mold and the length increases as the front face moves. What is the rate of change of the length if the volume is increasing at a rate of $540\\,{\\text{in}}^{3}/\\text{min}?$\n\nThe length is increasing at a rate of\n{{field-1}}\n$\\text{in}/\\text{min}.$" 13194139533445 17592186045585 true] [17592186364029 1072 #uuid "66feadb1-f43c-538a-a529-6b0decd87e96" 13194139533445 17592186045585 true] [17592186364029 1074 "Let $x,y,z$ be the dimensions of the rectangular prism, let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}y & =18\\,\\text{in}, \\\\ z & =10\\,\\text{in}.\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=540\\,{\\text{in}}^{3}/\\text{min}.\n$$\n\nWe would like to find $\\frac{\\text{d}x}{\\text{d}t}$ when $y=18\\,\\text{in}$ and $z=10\\,\\text{in}.$\n\nWe start with the formula for the volume of the rectangular prism:\n\n$$\nV=xyz\n$$\n\nSubstituting the known values, we get\n\n$$\nV=x(18)(10)=180x.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(180x) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =180(\\frac{\\text{d}x}{\\text{d}t}).\\end{aligned}\n$$\n\nWe can now plug in the known value into the above expression. This gives\n\n$$\n\\begin{aligned}540 & =180(\\frac{\\text{d}x}{\\text{d}t}) \\\\ \\frac{\\text{d}x}{\\text{d}t} & =3\\,\\text{in}\\text{/min}.\\end{aligned}\n$$\n\nTherefore, the length is increasing at a rate of $3\\,\\text{in}/\\text{min}.$" 13194139533445 17592186045585 true] [17592186364030 1075 #edb/ref 17592186364031 13194139533445 17592186045585 true] [17592186364030 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186364030 1077 "field-1" 13194139533445 17592186045585 true] [17592186364030 1079 #edb/ref 17592186364031 13194139533445 17592186045585 true] [17592186364030 1080 #uuid "52301b94-6cf0-5a4d-ba7d-d8095c654386" 13194139533445 17592186045585 true] [17592186364031 1081 "3" 13194139533445 17592186045585 true] [17592186364031 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186364031 1084 #uuid "38ea6a32-82ac-510a-a99f-46d79071114f" 13194139533445 17592186045585 true] [17592186364032 1068 #edb/ref 17592186364033 13194139533445 17592186045585 true] [17592186364032 1069 "q-343187" 13194139533445 17592186045585 true] [17592186364032 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186364032 1071 "![](images/6e/6eb2c7621d7be454bb287325e97f2db47ddf6591d269b26df58ac65b8ee7ca5f.png)\n\nA rectangular fish tank is draining. The tank is $6\\,\\text{ft}$ long and $4\\,\\text{ft}$ wide. What is the rate of change of the water level if the volume is decreasing at a rate of $1.2\\,{\\text{ft}}^{3}/\\text{min}?$ Assume that the water level's rate of decrease is positive.\n\nThe water level is decreasing at a rate of\n{{field-1}}\n$\\text{ft}/\\text{min}.$" 13194139533445 17592186045585 true] [17592186364032 1072 #uuid "5b126fc6-73e1-5b77-bb62-276262fc5ca6" 13194139533445 17592186045585 true] [17592186364032 1074 "Let $x,y,z$ be the dimensions of the rectangular prism, let $V$ be its volume. We are given that \n\n$$\n\\begin{aligned}x & =6\\,\\text{ft}, \\\\ y & =4\\,\\text{ft}.\\end{aligned}\n$$\n\nAlso, we know that\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-1.2\\,{\\text{ft}}^{3}/\\text{min}.\n$$\n\nWe would like to find $\\frac{\\text{d}z}{\\text{d}t}$ when $x=6\\,\\text{ft}$ and $y=4\\,\\text{ft}.$\n\nWe start with the formula for the volume of the rectangular prism:\n\n$$\nV=xyz\n$$\n\nSubstituting the known values, we get\n\n$$\nV=(6)(4)z=24z.\n$$\n\nNow, we differentiate with respect to time using the chain rule, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(24z) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =24(\\frac{\\text{d}z}{\\text{d}t}).\\end{aligned}\n$$\n\nWe can now plug in the known value into the above expression. This gives\n\n$$\n\\begin{aligned}-1.2 & =24(\\frac{\\text{d}z}{\\text{d}t}) \\\\ \\frac{\\text{d}z}{\\text{d}t} & =-0.05\\,\\text{ft}\\text{/h}.\\end{aligned}\n$$\n\nTherefore, the water level is decreasing at a rate of $0.05\\,\\text{ft}/\\text{min}.$" 13194139533445 17592186045585 true] [17592186364033 1075 #edb/ref 17592186364034 13194139533445 17592186045585 true] [17592186364033 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186364033 1077 "field-1" 13194139533445 17592186045585 true] [17592186364033 1079 #edb/ref 17592186364034 13194139533445 17592186045585 true] [17592186364033 1080 #uuid "bf326772-e01d-51f5-9d61-a18dbad87b7b" 13194139533445 17592186045585 true] [17592186364034 1081 "0.05" 13194139533445 17592186045585 true] [