86045585 true] [17592186363898 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363898 1077 "selection" 13194139533445 17592186045585 true] [17592186363898 1079 #edb/ref 17592186363903 13194139533445 17592186045585 true] [17592186363898 1080 #uuid "b1b50d6d-f46c-5fab-8128-2948e6ef2591" 13194139533445 17592186045585 true] [17592186363899 1081 "-\\frac{4}{5}" 13194139533445 17592186045585 true] [17592186363899 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363899 1084 #uuid "fa4e200d-3059-501b-ab48-6218a57adb56" 13194139533445 17592186045585 true] [17592186363900 1081 "-\\frac{7}{5}" 13194139533445 17592186045585 true] [17592186363900 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363900 1084 #uuid "07fc866b-fe6c-5b59-a12b-1c07c6f776d6" 13194139533445 17592186045585 true] [17592186363901 1081 "1" 13194139533445 17592186045585 true] [17592186363901 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363901 1084 #uuid "d2e63e01-ec4a-57a5-86b7-843609011e6e" 13194139533445 17592186045585 true] [17592186363902 1081 "0" 13194139533445 17592186045585 true] [17592186363902 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363902 1084 #uuid "32c297e8-07e1-5fab-ad4c-57169fea2237" 13194139533445 17592186045585 true] [17592186363903 1081 "-1" 13194139533445 17592186045585 true] [17592186363903 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363903 1084 #uuid "5466569e-0352-5327-9298-ff146556b7cf" 13194139533445 17592186045585 true] [17592186363904 1068 #edb/ref 17592186363905 13194139533445 17592186045585 true] [17592186363904 1069 "q-38979" 13194139533445 17592186045585 true] [17592186363904 1070 #edb/ref 17592186045486 13194139533445 17592186045585 true] [17592186363904 1071 "Let $T:{R}^{n}\\to {R}^{n}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\n- If $\\text{Ker}(T)={⟨x,y,z⟩\\,|\\,x+y=0}$ then $\\text{rank}(T)+1=n$\n- If there exists a vector $v\\notin \\text{Im}(T),$ then $|T|\\ne 0$\n- If ${{v}_{1},{v}_{2}}$ is linearly independent and $T({v}_{1})=T({v}_{2})=0$ then $\\text{nullity}(T)=1$" 13194139533445 17592186045585 true] [17592186363904 1072 #uuid "936f721f-93be-5c51-8233-7da49b500101" 13194139533445 17592186045585 true] [17592186363904 1074 "Since $T$ is a linear transformation from ${R}^{n}$ into ${R}^{n},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{n} \\\\  & \\text{rank}(T)=n \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Solving $x+y=0$ for $x,$ we get $x=-y.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-y \\\\ y \\\\ z\\end{aligned}]=y{{[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}{{v}_{1},{v}_{2}}.$ Therefore, $\\text{nullity}(T)=2.$ Finally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ \\text{rank}(T)+2 & =n.\\end{aligned}\n$$\n\n- Statement II is false. If $v\\notin \\text{Im}(T)$ then $\\text{Im}(T)\\ne {R}^{n}$, so, according to the invertible matrix theorem, $T$ is not a bijection. Thus, the matrix $T$ is not invertible, and, consequently, $|T|=0.$\n\n- Statement III is false. Since $T({v}_{1})=T({v}_{2})=0$, then ${v}_{1},{v}_{2}\\in \\text{Ker}(T).$ But the vectors are linearly independent, therefore, the dimension of  $\\text{Ker}(T)$ is at least $2.$\n\nTherefore, the correct answer is \"None of the statements are true.\"" 13194139533445 17592186045585 true] [17592186363905 1075 #edb/ref 17592186363906 13194139533445 17592186045585 true] [17592186363905 1075 #edb/ref 17592186363907 13194139533445 17592186045585 true] [17592186363905 1075 #edb/ref 17592186363908 13194139533445 17592186045585 true] [17592186363905 1075 #edb/ref 17592186363909 13194139533445 17592186045585 true] [17592186363905 1075 #edb/ref 17592186363910 13194139533445 17592186045585 true] [17592186363905 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363905 1077 "selection" 13194139533445 17592186045585 true] [17592186363905 1079 #edb/ref 17592186363906 13194139533445 17592186045585 true] [17592186363905 1080 #uuid "969eea6e-2298-5a9b-b572-aaf060b2e3e8" 13194139533445 17592186045585 true] [17592186363906 1081 "None of the statements are true" 13194139533445 17592186045585 true] [17592186363906 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363906 1084 #uuid "52261ad5-06ec-5820-b379-2fa7e2076f68" 13194139533445 17592186045585 true] [17592186363907 1081 "II and III only" 13194139533445 17592186045585 true] [17592186363907 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363907 1084 #uuid "2adddfdb-1396-5670-af1d-5f244b91a536" 13194139533445 17592186045585 true] [17592186363908 1081 "I and III only" 13194139533445 17592186045585 true] [17592186363908 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363908 1084 #uuid "18a44539-28f0-5861-b3bf-f00b77964913" 13194139533445 17592186045585 true] [17592186363909 1081 "I only" 13194139533445 17592186045585 true] [17592186363909 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363909 1084 #uuid "8e23dce7-f9e9-528b-b5da-facf341c2566" 13194139533445 17592186045585 true] [17592186363910 1081 "I and II only" 13194139533445 17592186045585 true] [17592186363910 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186363910 1084 #uuid "aedc4dae-4a5e-589f-b565-ed70c37e8829" 13194139533445 17592186045585 true] [17592186363911 1068 #edb/ref 17592186363912 13194139533445 17592186045585 true] [17592186363911 1069 "q-39411" 13194139533445 17592186045585 true] [17592186363911 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186363911 1071 "![](images/48/48d76f34becfba9f58658c3c38ba2df0e76ad6ff20b83ffc836e213c4eea4565.png)\n\nEvaluate ${\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})dz\\,dy\\,dx.$ The region of integration is shown above.\n\n*Hint: Change the order of integration to $\\text{d}y\\,\\text{d}z\\,\\text{d}x.$*" 13194139533445 17592186045585 true] [17592186363911 1072 #uuid "5a318f0c-c590-5820-90e1-5e9d0a54a78b" 13194139533445 17592186045585 true] [17592186363911 1074 "We cannot integrate the given integral because we cannot find a simple antiderivative of the integrand. So, we change the order of integration.\n\nWe wish to find the limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(x),$ ${v}_{2}(x),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})dz\\,dy\\,dx={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le \\sqrt[6]{\\pi },\\,\\,{y}^{3}\\le z\\le \\sqrt{\\pi }}\n$$\n\nThe region $R$ is shown below.\n\n![](images/86/86af6e58f4f13e79bb9672cef329572f006e5f4875178ede7908bddbd0dec404.png)\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type I *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/83/83041605fcd79db34f249664b12311a4e5d797c331bcaf1279f03b5b68891b23.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region is\n\n$$\ny=0.\n$$\n\n- The right boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nz={y}^{3}\\,⟹\\,y=\\sqrt[3]{z}.\n$$\n\nTherefore, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le \\sqrt[3]{z}},\n$$\n\nas shown in the diagram below.\n\n![](images/b5/b5a3fc034b713ce5fca98fbd0cca3c454d18e42e0e73eecc7ec18c51a8e7ebb5.png)\n\nNow, we consider the projection $D$ as a type I plane region in the $xz$-plane with the bottom curve given by $z=\\sqrt[3]{0}=0.$\n\n![](images/54/54fa3b1c3a15391e0a87c15017b07594c4f2cca7fb741cd7480909a64e3d39db.png)\n\nHence,\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le \\sqrt{\\pi }}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[6]{\\pi }}{\\int }_{{y}^{3}}^{\\sqrt{\\pi }}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})dz\\,dy\\,dx & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}{\\int }_{0}^{\\sqrt[3]{z}}{y}^{2}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})[{\\int }_{0}^{\\sqrt[3]{z}}{y}^{2}\\,\\text{d}y]\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2}){[\\frac{1}{3}{y}^{3}]}_{0}^{\\sqrt[3]{z}}\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{\\pi }}\\frac{1}{3}z\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,\\text{d}z\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}[\\frac{1}{3}{\\int }_{0}^{\\sqrt{\\pi }}z\\operatorname{sin}⁡(\\frac{\\pi }{3}+{z}^{2})\\,\\text{d}z]\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{3}{[-\\frac{1}{2}\\operatorname{cos}⁡(\\frac{\\pi }{3}+{z}^{2})]}_{0}^{\\sqrt{\\pi }}\\,\\text{d}x \\\\  & =-\\frac{1}{6}{\\int }_{0}^{1}\\operatorname{cos}⁡(\\frac{4\\pi }{3})-\\operatorname{cos}⁡(\\frac{\\pi }{3})\\,\\text{d}x \\\\  & =-\\frac{1}{6}{\\int }_{0}^{1}(-\\frac{1}{2}-\\frac{1}{2})\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{1}\\text{d}x \\\\  & =\\frac{1}{6}[x]_{0}^{1} \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186363912 1075 #edb/ref 17592186363913 13194139533445 17592186045585 true] [17592186363912 1075 #edb/ref 17592186363914 13194139533445 17592186045585 true] [17592186363912 1075 #edb/ref 17592186363915 13194139533445 17592186045585 true] [17592186363912 1075 #edb/ref 17592186363916 13194139533445 17592186045585 true] [17592186363912 1075 #edb/ref 17592186363917 13194139533445 17592186045585 true] [17592186363912 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186363912 1077 "selection" 13194139533445 17592186045585 true] [17592186363912 1079 #edb/ref 17592186363916 13194139533445 17592186045585 true] [17592186363912 1080 #uuid "b10f82d7-23d8-5faa-bd60-f6f74f7c290a" 13194139533445 17592186045585 true] [17592186363913 1081 "\\sqrt{2}" 13194139533445 17592186045585 true] [17592186363913 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363913 1084 #uuid "29f0dba1-7067-5d87-99e6-9cf227b19ccd" 13194139533445 17592186045585 true] [17592186363914 1081 "\\frac{1}{2}" 13194139533445 17592186045585 true] [17592186363914 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186363914 1084 #uuid "6fbc4e23-72cd-5330-af02-7585346a0eaa" 13194139533445 17592186045585 true] [17592186363915 1081 "\\frac{\\sqrt{2}}{3}" 13194139533445 17592186045585 true] [17592186363915 1083 #ed