1}-\\frac{1}{3})}^{2}+4{x}_{2}^{2} & =\\frac{36}{3} \\\\ 3{({x}_{1}-\\frac{1}{3})}^{2}+4{x}_{2}^{2} & =12\\end{aligned}\n$$\n\nNow, performing the change of variables\n\n$$\n{\\begin{aligned}{y}_{1}={x}_{1}-\\frac{1}{3}, \\\\ {y}_{2}={x}_{2},\\end{aligned}\n$$\n\nwe get the following:\n\n$$\n\\begin{aligned}3{y}_{1}^{2}+4{y}_{2}^{2} & =12 \\\\ \\frac{{y}_{1}^{2}}{4}+\\frac{{y}_{2}^{2}}{3} & =1 \\\\ \\frac{{y}_{1}^{2}}{{2}^{2}}+\\frac{{y}_{2}^{2}}{(\\sqrt{3})^{2}} & =1\\end{aligned}\n$$\n\n \n\nThis represents an ellipse with semiaxes $2$ and $\\sqrt{3}.$" 13194139533445 17592186045585 true] [17592186364540 1075 #edb/ref 17592186364541 13194139533445 17592186045585 true] [17592186364540 1075 #edb/ref 17592186364542 13194139533445 17592186045585 true] [17592186364540 1075 #edb/ref 17592186364543 13194139533445 17592186045585 true] [17592186364540 1075 #edb/ref 17592186364544 13194139533445 17592186045585 true] [17592186364540 1075 #edb/ref 17592186364545 13194139533445 17592186045585 true] [17592186364540 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186364540 1077 "selection" 13194139533445 17592186045585 true] [17592186364540 1079 #edb/ref 17592186364545 13194139533445 17592186045585 true] [17592186364540 1080 #uuid "296453d6-3c71-5737-82c3-c5c36630c17c" 13194139533445 17592186045585 true] [17592186364541 1081 "A single point" 13194139533445 17592186045585 true] [17592186364541 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364541 1084 #uuid "050d3072-c838-5e08-b0bc-4d5171d8a819" 13194139533445 17592186045585 true] [17592186364542 1081 "A hyperbola with semiaxes $\\sqrt{2}$ and $3$" 13194139533445 17592186045585 true] [17592186364542 1083 #edb/ref 17592186045500 13194139533445 17592186045585 true] [17592186364542 1084 #uuid "e5183501-b9cd-5561-b6e3-c0b1b0bb5462" 13194139533445 17592186045585 true] [17592186364543 1081 "A parabola" 13194139533445 17592186045585 true] [17592186364543 1083 #edb/ref 17592186045500 1319