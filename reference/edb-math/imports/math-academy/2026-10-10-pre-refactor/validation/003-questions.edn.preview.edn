{b}_{ij} \\\\  & =3{\\sum }_{i=1}^{18}{\\sum }_{j=1}^{20}{a}_{ij}+2{\\sum }_{i=1}^{18}{\\sum }_{j=1}^{20}{b}_{ij} \\\\  & =3\\cdot 50+2\\cdot 20 \\\\  & =150+40 \\\\  & =190.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362930 1075 #edb/ref 17592186362931 13194139533445 17592186045585 true] [17592186362930 1075 #edb/ref 17592186362932 13194139533445 17592186045585 true] [17592186362930 1075 #edb/ref 17592186362933 13194139533445 17592186045585 true] [17592186362930 1075 #edb/ref 17592186362934 13194139533445 17592186045585 true] [17592186362930 1075 #edb/ref 17592186362935 13194139533445 17592186045585 true] [17592186362930 1076 #edb/ref 17592186045493 13194139533445 17592186045585 true] [17592186362930 1077 "selection" 13194139533445 17592186045585 true] [17592186362930 1079 #edb/ref 17592186362934 13194139533445 17592186045585 true] [17592186362930 1080 #uuid "432c0b07-5250-5b0b-893a-f8142e12e051" 13194139533445 17592186045585 true] [17592186362931 1081 "170" 13194139533445 17592186045585 true] [17592186362931 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362931 1084 #uuid "d7ce3608-c6c6-5124-be7e-c798c1eaf520" 13194139533445 17592186045585 true] [17592186362932 1081 "130" 13194139533445 17592186045585 true] [17592186362932 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362932 1084 #uuid "e0e43d71-6e2f-5d1b-8955-af33091a3185" 13194139533445 17592186045585 true] [17592186362933 1081 "150" 13194139533445 17592186045585 true] [17592186362933 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362933 1084 #uuid "855d4941-c925-54bc-9c7a-c1736df507b1" 13194139533445 17592186045585 true] [17592186362934 1081 "190" 13194139533445 17592186045585 true] [17592186362934 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362934 1084 #uuid "db78bdf7-e3a3-54f9-809f-7188f1a45b1e" 13194139533445 17592186045585 true] [17592186362935 1081 "160" 13194139533445 175921