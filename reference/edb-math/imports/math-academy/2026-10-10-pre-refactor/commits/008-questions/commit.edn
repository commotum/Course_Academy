1}{2}\\cdot 1\\cdot (1+2) \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\n- To find the second integral where $x\\in [2,6],$ we compute the area ${A}_{2}$ of the triangle as follows:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\cdot 4\\cdot 2 \\\\  & =4\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}g(6)={\\int }_{1}^{6}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2}=\\frac{3}{2}+4=\\frac{11}{2}.\\end{aligned}\n$$" 13194139533452 17592186045585 true] [17592186376028 1075 #edb/ref 17592186376029 13194139533452 17592186045585 true] [17592186376028 1075 #edb/ref 17592186376030 13194139533452 17592186045585 true] [17592186376028 1075 #edb/ref 17592186376031 13194139533452 17592186045585 true] [17592186376028 1075 #edb/ref 17592186376032 13194139533452 17592186045585 true] [17592186376028 1075 #edb/ref 17592186376033 13194139533452 17592186045585 true] [17592186376028 1076 #edb/ref 17592186045493 13194139533452 17592186045585 true] [17592186376028 1077 "selection" 13194139533452 17592186045585 true] [17592186376028 1079 #edb/ref 17592186376031 13194139533452 17592186045585 true] [17592186376028 1080 #uuid "b4c8c7f4-110a-5ca7-b2cf-923b8df55f72" 13194139533452 17592186045585 true] [17592186376029 1081 "\\frac{9}{2}" 13194139533452 17592186045585 true] [17592186376029 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186376029 1084 #uuid "8c7b271b-dd60-5a95-9dcf-9ff45d54f327" 13194139533452 17592186045585 true] [17592186376030 1081 "7" 13194139533452 17592186045585 true] [17592186376030 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186376030 1084 #uuid "bf643b5d-aca2-5cd4-841c-3f655593a72c" 13194139533452 17592186045585 true] [17592186376031 1081 "\\frac{11}{2}" 13194139533452 17592186045585 true] [17592186376031 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186376031 1084 #uuid "0e1138db-ea0a-55f9-9807-c20a4ab56d92" 13194139533452 17592186045585 true] [17592186376032 1081 "\\frac{15}{2}" 131941395334