[17592186377357 1071 "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}-x+3, & x<2, \\\\ 2, & x\\ge 2.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-4}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." 13194139533452 17592186045585 true] [17592186377357 1072 #uuid "1e001a8f-4ba2-509d-b818-1ae312f50458" 13194139533452 17592186045585 true] [17592186377357 1074 "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-4}^{5}f(x)\\,\\text{d}x & ={\\int }_{-4}^{2}(-x+3)\\,\\text{d}x\\,+\\,{\\int }_{2}^{5}2\\,\\text{d}x \\\\  & =(-\\frac{{x}^{2}}{2}+3x){|}_{-4}^{2}\\,+\\,2x{|}_{2}^{5} \\\\  & =[\\,-\\frac{(2)^{2}}{2}+3(2)\\,-\\,(-\\frac{(-4)^{2}}{2}+3(-4))]\\,+\\,[\\,2(5)-2(2)\\,] \\\\  & =[\\,-2+6\\,-\\,(-8-12)]+6 \\\\  & =[4\\,-\\,(-20)]+6 \\\\  & =24+6 \\\\  & =30.\\end{aligned}\n$$" 13194139533452 17592186045585 true] [17592186377358 1075 #edb/ref 17592186377359 13194139533452 17592186045585 true] [17592186377358 1076 #edb/ref 17592186045492 13194139533452 17592186045585 true] [17592186377358 1077 "field-1" 13194139533452 17592186045585 true] [17592186377358 1079 #edb/ref 17592186377359 13194139533452 17592186045585 true] [17592186377358 1080 #uuid "33c43baa-b961-5aa7-bf04-15b73327dd29" 13194139533452 17592186045585 true] [17592186377359 1081 "30" 13194139533452 17592186045585 true] [17592186377359 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186377359 1084 #uuid "b2f45ffd-a764-5c51-9508-326a270b6000" 13194139533452 17592186045585 true] [17592186377360 1068 #edb/ref 17592186377361 13194139533452 17592186045585 true] [17592186377360 1069 "q-342009" 13194139533452 17592186045585 true] [17592186377360 1070 #edb/ref 17592186045485 13194139533452 17592186045585 true] [17592186377360 1071 "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}-\\frac{3}{2}x-1, & x<2, \\\\ x-4, & x\\ge 2.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-2}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." 13194139533452 17592186045585 true] [17592186377360 1072 #uuid "217e4032-648e-53f2-bd0f-9f655554f3d9" 13194139533452 17592186045585 true] [17592186377360 1074 "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-2}^{5}f(x)\\,\\text{d}x & ={\\int }_{-2}^{2}(-\\frac{3}{2}x-1)\\,\\text{d}x\\,+\\,{\\int }_{2}^{5}(x-4)\\,\\text{d}x \\\\  & =(-\\frac{3}{4}{x}^{2}-x){|}_{-2}^{2}+(\\frac{{x}^{2}}{2}-4x){|}_{2}^{5} \\\\  & =[-\\frac{3}{4}(2)^{2}-2-(-\\frac{3}{4}(-2)^{2}-(-2))] \\\\  & \\,+[\\frac{{5}^{2}}{2}-4\\cdot 5-(\\frac{{2}^{2}}{2}-4\\cdot 2))] \\\\  & =[\\,-3-2-(-3+2)]\\,+\\,[\\frac{25}{2}-20-(2-8)] \\\\  & =-4-\\frac{3}{2} \\\\  & =-\\frac{11}{2}.\\end{aligned}\n$$" 13194139533452 17592186045585 true] [17592186377361 1075 #edb/ref 17592186377362 13194139533452 17592186045585 true] [17592186377361 1076 #edb/ref 17592186045492 13194139533452 17592186045585 true] [17592186377361 1077 "field-1" 13194139533452 17592186045585 true] [17592186377361 1079 #edb/ref 17592186377362 13194139533452 17592186045585 true] [17592186377361 1080 #uuid "a53aef57-d7e1-54d2-a90c-8d9593a2af12" 13194139533452 17592186045585 true] [17592186377362 1081 "-\\frac{11}{2}" 13194139533452 17592186045585 true] [17592186377362 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186377362 1084 #uuid "1890e472-5113-59f8-9b0f-f2482253fe3e" 13194139533452 17592186045585 true] [17592186377363 1068 #edb/ref 17592186377364 13194139533452 17592186045585 true] [17592186377363 1069 "q-342014" 13194139533452 17592186045585 true] [17592186377363 1070 #edb/ref 17592186045485 13194139533452 17592186045585 true] [17592186377363 1071 "The function $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}{x}^{2}, & x<2, \\\\ -\\frac{1}{2}x+4, & x\\ge 2.\\end{aligned}\n$$\n\nThen,\n\n${\\int }_{-1}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." 13194139533452 17592186045585 true] [17592186377363 1072 #uuid "f6c68127-8372-5d4a-9ede-b7594ed5b877" 13194139533452 17592186045585 true] [17592186377363 1074 "By the ad