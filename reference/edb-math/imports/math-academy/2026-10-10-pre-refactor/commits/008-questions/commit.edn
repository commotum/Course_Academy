}(0-1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139533452 17592186045585 true] [17592186377346 1075 #edb/ref 17592186377347 13194139533452 17592186045585 true] [17592186377346 1076 #edb/ref 17592186045492 13194139533452 17592186045585 true] [17592186377346 1077 "field-1" 13194139533452 17592186045585 true] [17592186377346 1079 #edb/ref 17592186377347 13194139533452 17592186045585 true] [17592186377346 1080 #uuid "8ec02afa-ff5c-5a8a-83f9-f12941e64e28" 13194139533452 17592186045585 true] [17592186377347 1081 "\\frac{1}{2}" 13194139533452 17592186045585 true] [17592186377347 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186377347 1084 #uuid "5cf3cf48-269f-57ac-b6b0-19f358507270" 13194139533452 17592186045585 true] [17592186377348 1068 #edb/ref 17592186377349 13194139533452 17592186045585 true] [17592186377348 1069 "q-340493" 13194139533452 17592186045585 true] [17592186377348 1070 #edb/ref 17592186045487 13194139533452 17592186045585 true] [17592186377348 1071 "Evaluate the following integral.\n\n${\\int }_{\\pi /4}^{\\pi }\\operatorname{sin}⁡(11x)\\operatorname{cos}⁡(5x)\\,\\text{d}x=$ {{field-1}}" 13194139533452 17592186045585 true] [17592186377348 1072 #uuid "a8899fff-852c-5526-b193-628c43b1b225" 13194139533452 17592186045585 true] [17592186377348 1074 "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(11x)\\operatorname{cos}⁡(5x) & =\\frac{1}{2}(\\operatorname{sin}⁡(11x+5x)+\\operatorname{sin}⁡(11x-5x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(16x)+\\operatorname{sin}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi }\\operatorname{sin}⁡(11x)\\operatorname{cos}⁡(5x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi }\\frac{1}{2}\\operatorname{sin}⁡(16x)+\\frac{1}{2}\\operatorname{sin}⁡(6x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{32}\\operatorname{cos}⁡(16x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)]}_{\\pi /4}^{\\pi } \\\\  & =-\\frac{1}{32}(\\operatorname{cos}⁡(16\\pi )-\\operatorname{cos}⁡(4\\pi ))-\\frac{1}{12}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(\\frac{3\\pi }{2})) \\\\  & =-\\frac{1}{32}(1-1)-\\frac{1}{12}(1-0) \\\\  & =-\\frac{1}{12}.\\end{aligned}\n$$" 13194139533452 17592186045585 true] [17592186377349 1075 #edb/ref 17592186377350 13194139533452 17592186045585 true] [17592186377349 1076 #edb/ref 17592186045492 13194139533452 17592186045585 true] [17592186377349 1077 "field-1" 13194139533452 17592186045585 true] [17592186377349 1079 #edb/ref 17592186377350 13194139533452 17592186045585 true] [17592186377349 1080 #uuid "566d1b4e-0853-51e9-a9d2-e9886b9f1fee" 13194139533452 17592186045585 true] [17592186377350 1081 "-\\frac{1}{12}" 13194139533452 17592186045585 true] [17592186377350 1083 #edb/ref 17592186045499 13194139533452 17592186045585 true] [17592186377350 1084 #uuid "11b8e7d7-477f-5630-a348-70b06bf429f7" 13194139533452 17592186045585 true] [17592186377351 1075 #edb/ref 17592186377352 13194139533452 17592186045585 true] [17592186377351 1075 #edb/ref 17592186377353 13194139533452 17592186045585 true] [17592186377351 1075 #edb/ref 17592186377354 13194139533452 17592186045585 true] [17592186377351 1075 #