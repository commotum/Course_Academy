t }_{-2}^{1}\\,\\text{d}x+4{\\int }_{-2}^{1}f(x)\\,\\text{d}x \\\\  & =5\\cdot x\\,{|}_{-2}^{1}+4(\\frac{5}{2}) \\\\  & =5(1-(-2))+10 \\\\  & =25.\\end{aligned}\n$$" 13194139533446 17592186045585 true] [17592186364337 1075 #edb/ref 17592186364338 13194139533446 17592186045585 true] [17592186364337 1075 #edb/ref 17592186364339 13194139533446 17592186045585 true] [17592186364337 1075 #edb/ref 17592186364340 13194139533446 17592186045585 true] [17592186364337 1075 #edb/ref 17592186364341 13194139533446 17592186045585 true] [17592186364337 1075 #edb/ref 17592186364342 13194139533446 17592186045585 true] [17592186364337 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186364337 1077 "selection" 13194139533446 17592186045585 true] [17592186364337 1079 #edb/ref 17592186364342 13194139533446 17592186045585 true] [17592186364337 1080 #uuid "d18620e4-b83a-5036-9cc0-164c3885d9ea" 13194139533446 17592186045585 true] [17592186364338 1081 "20" 13194139533446 17592186045585 true] [17592186364338 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186364338 1084 #uuid "2548572d-1828-5c15-9c24-9f69c26499fe" 13194139533446 17592186045585 true] [17592186364339 1081 "15" 13194139533446 17592186045585 true] [17592186364339 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186364339 1084 #uuid "cdf16357-ff08-50aa-8d48-287a20aa338c" 13194139533446 17592186045585 true] [17592186364340 1081 "\\frac{1}{2}" 13194139533446 17592186045585 true] [17592186364340 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186364340 1084 #uuid "fa312d6c-985e-5953-8527-699e0ddc3fc7" 13194139533446 17592186045585 true] [17592186364341 1081 "\\frac{2}{5}" 13194139533446 17592186045585 true] [17592186364341 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186364341 1084 #uuid "ccf0fdd7-7278-5aa7-85cf-08123b8757dd" 13194139533446 17592186045585 true] [17592186364342 1081 "25" 13194139533446 17592186045585 true