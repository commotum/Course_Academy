2}}^{2}}}⟩\\cdot ⟨6,5⟩ \\\\ -1 & =-\\frac{5{c}_{2}}{\\sqrt{169-{{c}_{2}}^{2}}} \\\\ \\sqrt{169-{{c}_{2}}^{2}} & =5{c}_{2}.\\end{aligned}\n$$\n\nNow we solve this radical equation:\n\n$$\n\\begin{aligned}\\sqrt{169-{{c}_{2}}^{2}} & =5{c}_{2} \\\\ 169-{{c}_{2}}^{2} & =25{{c}_{2}}^{2} \\\\ 26{{c}_{2}}^{2} & =169 \\\\ {{c}_{2}}^{2} & =\\frac{169}{26} \\\\ {{c}_{2}}^{2} & =\\frac{13}{2} \\\\ {c}_{2} & =\\pm \\frac{\\sqrt{26}}{2}.\\end{aligned}\n$$\n\nSubstituting back into the radical equation, we notice that ${c}_{2}=-\\frac{\\sqrt{26}}{2}$ does not satisfy the equation. Therefore, the only solution is ${c}_{2}=\\frac{\\sqrt{26}}{2}.$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}$ to find ${c}_{1}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-0}{5-0} & =\\frac{x-0}{6-0} \\\\ \\frac{y}{5} & =\\frac{x}{6} \\\\ y & =\\frac{5}{6}x.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =\\frac{5}{6}{c}_{1}.\\end{aligned}\n$$\n\nFinally, taking into account that ${c}_{2}=\\frac{\\sqrt{26}}{2},$ we obtain that\n\n$$\n\\begin{aligned}\\frac{\\sqrt{26}}{2} & =\\frac{5}{6}{c}_{1} \\\\ {c}_{1} & =\\frac{6}{5}\\cdot \\frac{\\sqrt{26}}{2} \\\\ {c}_{1} & =\\frac{3\\sqrt{26}}{5}.\\end{aligned}\n$$\n\nTherefore, the point $C$ that satisfies the mean value theorem is $(\\frac{3\\sqrt{26}}{5},\\frac{\\sqrt{26}}{2}).$" 13194139533446 17592186045585 true] [17592186363066 1075 #edb/ref 17592186363067 13194139533446 17592186045585 true] [17592186363066 1075 #edb/ref 17592186363068 13194139533446 17592186045585 true] [17592186363066 1075 #edb/ref 17592186363069 13194139533446 17592186045585 true] [17592186363066 1075 #edb/ref 17592186363070 13194139533446 17592186045585 true] [17592186363066 1075 #edb/ref 17592186363071 13194139533446 17592186045585 true] [17592186363066 1076 #edb/ref 1759218604549