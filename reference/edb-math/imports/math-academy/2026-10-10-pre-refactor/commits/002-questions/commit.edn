({y}^{3}-9y)\\sqrt{1+(3{y}^{2}-9)^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-3}^{0}({y}^{3}-9y)\\sqrt{1+9({y}^{2}-3)^{2}}\\,\\text{d}y.\\end{aligned}\n$$" 13194139533446 17592186045585 true] [17592186362675 1075 #edb/ref 17592186362676 13194139533446 17592186045585 true] [17592186362675 1075 #edb/ref 17592186362677 13194139533446 17592186045585 true] [17592186362675 1075 #edb/ref 17592186362678 13194139533446 17592186045585 true] [17592186362675 1075 #edb/ref 17592186362679 13194139533446 17592186045585 true] [17592186362675 1075 #edb/ref 17592186362680 13194139533446 17592186045585 true] [17592186362675 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186362675 1077 "selection" 13194139533446 17592186045585 true] [17592186362675 1079 #edb/ref 17592186362680 13194139533446 17592186045585 true] [17592186362675 1080 #uuid "f0023f43-5370-5144-93ca-c1ebad284580" 13194139533446 17592186045585 true] [17592186362676 1081 "2\\pi {\\int }_{-3}^{0}({y}^{2}-3)\\sqrt{1+({y}^{3}-9y)^{2}}\\,\\text{d}y" 13194139533446 17592186045585 true] [17592186362676 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362676 1084 #uuid "1179be5b-67ba-56fc-be5e-2e65b68e77b1" 13194139533446 17592186045585 true] [17592186362677 1081 "2\\pi {\\int }_{-2}^{0}\\sqrt{1+9({y}^{2}-3)^{2}}\\,\\text{d}y" 13194139533446 17592186045585 true] [17592186362677 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362677 1084 #uuid "f388400a-0796-5b61-b9d0-2c9d4478df7b" 13194139533446 17592186045585 true] [17592186362678 1081 "2\\pi {\\int }_{-2}^{0}({y}^{2}-3)\\sqrt{1+9{y}^{4}}\\,\\text{d}y" 13194139533446 17592186045585 true] [17592186362678 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362678 1084 #uuid "70a704a4-76e3-5ec1-a22d-84cc5c20e56c" 13194139533446 17592186045585 true] [17592186362679 1081 "2\\pi {\\int }_{-3}^{0}\\sqrt{1+9{y}^{4}}\\,\\text{d}y" 13194139533446 17592186045585 true] [17592186362679 1083 #edb/r