 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}3 & -2 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}3 & -2 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" 13194139533446 17592186045585 true] [17592186363654 1075 #edb/ref 17592186363655 13194139533446 17592186045585 true] [17592186363654 1075 #edb/ref 17592186363656 13194139533446 17592186045585 true] [17592186363654 1075 #edb/ref 17592186363657 13194139533446 17592186045585 true] [17592186363654 1075 #edb/ref 17592186363658 13194139533446 17592186045585 true] [17592186363654 1075 #edb/ref 17592186363659 13194139533446 17592186045585 true] [17592186363654 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186363654 1077 "selection" 13194139533446 17592186045585 true] [17592186363654 1079 #edb/ref 17592186363655 13194139533446 17592186045585 true] [17592186363654 1080 #uuid "c4428f89-e5a9-5f0c-ab0a-de1fa79f0c7a" 13194139533446 17592186045585 true] [17592186363655 1081 "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" 13194139533446 17592186045585 true] [17592186363655 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363655 1084 #uuid "5526c323-a2c1-5c5b-97ef-7fe8dc93120e" 13194139533446 17592186045585 true] [17592186363656 1081 "[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}]" 13194139533446 17592186045585 true] [17592186363656 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363656 1084 #uuid "047b15e1-e229-59bd-ae6f-4c8c03b091db" 13194139533446 17592186045585 true] [17592186363657 1081 "[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]" 13194139533446 17592186045585 true] [17592186363657 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363657 1084 #uuid "4de571fa-6b40-524d-9743-5964efb8c012" 13194139533446 17592186045585 true] [17592186363658 1081 "[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]" 13194139533446