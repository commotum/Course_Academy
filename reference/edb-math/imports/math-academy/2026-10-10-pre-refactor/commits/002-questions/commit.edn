}^{-4} \\\\  & ={e}^{-4y} \\\\  & =\\frac{1}{{e}^{4y}}\\end{aligned}\n$$" 13194139533446 17592186045585 true] [17592186362962 1075 #edb/ref 17592186362963 13194139533446 17592186045585 true] [17592186362962 1075 #edb/ref 17592186362964 13194139533446 17592186045585 true] [17592186362962 1075 #edb/ref 17592186362965 13194139533446 17592186045585 true] [17592186362962 1075 #edb/ref 17592186362966 13194139533446 17592186045585 true] [17592186362962 1075 #edb/ref 17592186362967 13194139533446 17592186045585 true] [17592186362962 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186362962 1077 "selection" 13194139533446 17592186045585 true] [17592186362962 1079 #edb/ref 17592186362963 13194139533446 17592186045585 true] [17592186362962 1080 #uuid "4f8582ae-8894-5221-aaed-0730b1ac78c7" 13194139533446 17592186045585 true] [17592186362963 1081 "\\frac{1}{{e}^{4y}}" 13194139533446 17592186045585 true] [17592186362963 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362963 1084 #uuid "1b42ef5c-c83d-5cd9-aacf-d1c282288837" 13194139533446 17592186045585 true] [17592186362964 1081 "{e}^{y/4}" 13194139533446 17592186045585 true] [17592186362964 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362964 1084 #uuid "7864b13b-65b6-503b-a466-cdec0e9cca00" 13194139533446 17592186045585 true] [17592186362965 1081 "{e}^{4y}" 13194139533446 17592186045585 true] [17592186362965 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362965 1084 #uuid "e2bcd79a-58b0-5466-99e2-4acff3b71045" 13194139533446 17592186045585 true] [17592186362966 1081 "{e}^{4}" 13194139533446 17592186045585 true] [17592186362966 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362966 1084 #uuid "58155f50-5e0d-51c8-89da-e91b94138c2f" 13194139533446 17592186045585 true] [17592186362967 1081 "{e}^{1/4y}" 13194139533446 17592186045585 true] [17592186362967 1083 #edb/ref 17592186045499 13194139533446 1759218