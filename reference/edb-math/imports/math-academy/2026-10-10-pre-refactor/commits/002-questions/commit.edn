33446 17592186045585 true] [17592186363725 1069 "q-332317" 13194139533446 17592186045585 true] [17592186363725 1070 #edb/ref 17592186045486 13194139533446 17592186045585 true] [17592186363725 1071 "Consider the differential equation \n\n$$\n2\\frac{\\text{d}y}{\\text{d}x}+2y=-{x}^{2}+2.\n$$\n\nFind the particular solution ${y}_{p}(x)$ to this equation." 13194139533446 17592186045585 true] [17592186363725 1072 #uuid "76628764-8ff8-5858-bb94-848ac22307d3" 13194139533446 17592186045585 true] [17592186363725 1074 "The right-hand side of the inhomogeneous equation is a polynomial of degree $2.$ Therefore, we assume that the particular solution is also a polynomial of degree $2,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha {x}^{2}+\\beta x+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta ,$ and $\\gamma $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha x+\\beta .\n$$\n\nTo find the values of $\\alpha ,$ $\\beta $ and $\\gamma ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n2(2\\alpha x+\\beta )+2(\\alpha {x}^{2}+\\beta x+\\gamma )=-{x}^{2}+2\n$$\n\nGrouping the terms on the left-hand side gives\n\n$$\n2\\alpha {x}^{2}+(4\\alpha +2\\beta )x+(2\\beta +2\\gamma )=-{x}^{2}+2.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}2\\alpha =-1\\, & (\\text{equating the coefficients of}\\,\\,{x}^{2}) \\\\ 4\\alpha +2\\beta =0\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ 2\\beta +2\\gamma =2\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-\\frac{1}{2},\\beta =1,\\gamma =0.$\n\nTherefore, the particular integral ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-\\frac{{x}^{2}}{2}+x.\n$$" 13194139533446 17592186045585 true] [17592186363726 1075 #edb/ref 17592186363727 13194139533446 17592186045585 true] [17592186363726 1075 #edb/ref 17592186363728 13194139533446 17592186045585 true] [17592186363726 1075 #edb/ref 17592186363729 13194139533446 17592186045585 true] [17592186363726 1075 #edb/ref 17592186363730 13194139533446 17592186045585 true] [17592186363726 1075 #edb/ref 17592186363731 13194139533446 17592186045585 true] [17592186363726 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186363726 1077 "selection" 13194139533446 17592186045585 true] [17592186363726 1079 #edb/ref 17592186363729 13194139533446 17592186045585 true] [17592186363726 1080 #uuid "13e94b23-42fe-5e43-9e26-4fb331dee071" 13194139533446 17592186045585 true] [17592186363727 1081 "-\\frac{{x}^{2}}{2}" 13194139533446 17592186045585 true] [17592186363727 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363727 1084 #uuid "4d733f69-35f9-5f5f-9849-656bab26e830" 13194139533446 17592186045585 true] [17592186363728 1081 "-\\frac{{x}^{2}}{2}-x" 13194139533446 17592186045585 true] [17592186363728 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363728 1084 #uuid "3b8bbae7-f73c-527a-940c-f4486b540e1e" 13194139533446 17592186045585 true] [17592186363729 1081 "-\\frac{{x}^{2}}{2}+x" 13194139533446 17592186045585 true] [17592186363729 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363729 1084 #uuid "3669945b-4f98-5e9d-b2b6-adb1f42771bb" 13194139533446 17592186045585 true] [17592186363730 1081 "-\\frac{{x}^{2}}{2}+2x" 13194139533446 17592186045585 true] [17592186363730 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363730 1084 #uuid "d9ce2dfb-7dee-52e4-b9f5-b336355a7138" 13194139533446 17592186045585 true] [17592186363731 1081 "\\frac{{x}^{2}}{2}+x" 13194139533446 17592186045585 true] [17592186363731 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363731 1084 #uuid "dead3d0f-8900-57a7-a01e-e5d8b7336ffa" 13194139533446 17592186045585 true] [17592186363732 1068 #edb/ref 17592186363733 13194139533446 17592186045585 true] [17592186363732 1069 "q-332541" 13194139533446 17592186045585 true] [17592186363732 1070 #edb/ref 17592186045487 13194139533446 17592186045585 true] [17592186363732 1071 "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+6y=12x+8.\n$$\n\nFind the general solution to this equation given that the complementary solution is ${y}_{c}(x)=A{e}^{-6x},$ where $A$ is an arbitrary constant.\n\n$y(x)=$\n{{field-1}}" 13194139533446 17592186045585 true] [17592186363732 1072 #uuid "4bc0ce6c-d00c-58b5-b1e7-41739599c291" 13194139533446 17592186045585 true] [17592186363732 1074 "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}+6{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-6x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha x+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=\\alpha .\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\alpha +6(\\alpha x+\\beta )=12x+8\n$$\n\nWe then group the terms on the left-hand side, as follows:\n\n$$\n6\\alpha x+(\\alpha +6\\beta )=12x+8\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}6\\alpha =12\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ \\alpha +6\\beta =8\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =2,\\,\\beta =1.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=2x+1.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{-6x}+2x+1.\n$$" 13194139533446 17592186045585 true] [17592186363733 1075 #edb/ref 17592186363734 13194139533446 17592186045585 true] [17592186363733 1076 #edb/ref 17592186045492 13194139533446 17592186045585 true] [17592186363733 1077 "field-1" 13194139533446 17592186045585 true] [17592186363733 1079 #edb/ref 17592186363734 13194139533446 17592186045585 true] [17592186363733 1080 #uuid "ee428608-570a-59a4-b70a-49c6773b23a9" 13194139533446 17592186045585 true] [17592186363734 1081 "A{e}^{-6x}+2x+1" 13194139533446 17592186045585 true] [17592186363734 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363734 1084 #uuid "ff04b74c-f37f-581b-911a-74f2776e89b1" 13194139533446 17592186045585 true] [17592186363735 1068 #edb/ref 17592186363736 13194139533446 17592186045585 true] [17592186363735 1069 "q-332545" 13194139533446 17592186045585 true] [17592186363735 1070 #edb/ref 17592186045485 13194139533446 17592186045585 true] [17592186363735 1071 "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+7y=14.\n$$\n\nFind the general solution to this equation given that the complementary solution is ${y}_{c}(x)=A{e}^{-7x},$ where $A$ is an arbitrary constant.\n\n$y(x)=$\n{{field-1}}" 13194139533446 17592186045585 true] [17592186363735 1072 #uuid "8314e27c-f2e7-5e8c-a002-f993e47345c9" 13194139533446 17592186045585 true] [17592186363735 1074 "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}+7{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-7x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $0.$ Therefore, we assume that the particular solution is also a polynomial of degree $0,$ i.e.,\n\n$$\n{y}_{p}(x)=\\beta \n$$\n\nwhere $\\beta $ is a constant to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=0.\n$$\n\nTo find the value of $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n0+7\\beta =14\n$$\n\nSolving this equation gives $\\beta =2.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=2.\n$$\n\nNow, since the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nthe general solution in our case is\n\n$$\ny=A{e}^{-7x}+2.\n$$" 13194139533446 17592186045585 true] [17592186363736 1075 #edb/ref 17592186363737 13194139533446 17592186045585 true] [17592186363736 1076 #edb/ref 17592186045492 13194139533446 17592186045585 true] [17592186363736 1077 "field-1" 13194139533446 17592186045585 true] [17592186363736 1079 #edb/ref 17592186363737 13194139533446 17592186045585 true] [17592186363736 1080 #uuid "df136dac-c5da-5637-a378-3f84532849bd" 13194139533446 17592186045585 true] [17592186363737 1081 "A{e}^{-7x}+2" 13194139533446 17592186045585 true] [17592186363737 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186363737 1084 #uuid "9bfdbe0a-f37f-5b25-b1bb-752d783ddb08" 13194139533446 17592186045585 true] [17592186363738 1068 #edb/ref 17592186363739 13194139533446 17592186045585 true] [17592186363738 1069 "q-332711" 13194139533446 17592186045585 true] [17592186363738 1070 #edb/ref 17592186045485 13194139533446 17592186045585 true] [17592186363738 1071 "Consider the differential equation\n\n$$\n{y}^{′}-8y=-2x+9.\n$$\n\nFind the complementary solution ${y}_{c}(x)$ to this equation, where $A$ is an arbitrary constant." 13194139533446 17592186045585 true] [17592186363738 1072 #uuid "a5cfc291-c3bc-5a66-b0b2-c1090070282b" 13194139533446 17592186045585 true] [17592186363738 1074 "To find the complementary solution, we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-8{y}_{c}=0.\n$$\n\nNotice that this differential equation is separable since we can write it as\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}=8{y}_{c}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}_{c}}\\cdot \\frac{\\text{d}{y}_{c}}{\\text{d}x}=8\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}_{c}}\\,\\frac{\\text{d}{y}_{c}}{\\text{d}x}\\,\\text{d}x & =\\int 8\\,\\text{d}x \\\\ \\int \\frac{1}{{y}_{c}}\\,\\text{d}{y}_{c} & =\\int 8\\,\\text{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =8x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{8x+C} \\\\  & ={e}^{8x}{e}^{C} \\\\  & =K{e}^{8x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{8x},\n$$\n\nwhere $A$ is an arbitrary constant." 13194139533446 17592186045585 true] [17592186363739 1075 #edb/ref 17592186363740 13194139533446 17592186045585 true] [17592186363739 1075 #edb/ref 17592186363741 13194139533446 17592186045585 true] [17592186363739 1075 #edb/ref 17592186363742 13194139533446 17592186045585 true] [17592186363739 1075 #edb/ref 17592186363743 13194139533446 17592186045585 true] [17592186363739 1075 #edb/ref 17592186363744 13194139533446 17592186045585 true] [17592186363739 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186363739 1077 "selec