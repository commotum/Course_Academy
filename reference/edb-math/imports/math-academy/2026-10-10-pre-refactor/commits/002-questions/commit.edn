139533446 17592186045585 true] [17592186362751 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362751 1084 #uuid "ed2e2bd4-fa9e-5c29-9fde-5b640f207da7" 13194139533446 17592186045585 true] [17592186362752 1081 "\\text{Col}(A)" 13194139533446 17592186045585 true] [17592186362752 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362752 1084 #uuid "b42b2193-b9c4-5e0c-aafb-563bb246ff36" 13194139533446 17592186045585 true] [17592186362753 1081 "\\text{Col}({A}^{T})" 13194139533446 17592186045585 true] [17592186362753 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362753 1084 #uuid "d28bf949-da52-5d09-b5ad-42160431f00c" 13194139533446 17592186045585 true] [17592186362754 1081 "0" 13194139533446 17592186045585 true] [17592186362754 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362754 1084 #uuid "455a70da-1199-5679-aa6a-6757392650df" 13194139533446 17592186045585 true] [17592186362755 1081 "{R}^{n}" 13194139533446 17592186045585 true] [17592186362755 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362755 1084 #uuid "8522f512-49e6-5a4c-b597-44a8def8386e" 13194139533446 17592186045585 true] [17592186362756 1068 #edb/ref 17592186362757 13194139533446 17592186045585 true] [17592186362756 1069 "q-109850" 13194139533446 17592186045585 true] [17592186362756 1070 #edb/ref 17592186045487 13194139533446 17592186045585 true] [17592186362756 1071 "Let $B$ be a $m\\times n$ matrix. What is the image of $\\text{Col}({B}^{T})$ under the action of $B?$" 13194139533446 17592186045585 true] [17592186362756 1072 #uuid "63c0c3aa-6cd0-5913-9f45-9198721d3066" 13194139533446 17592186045585 true] [17592186362756 1074 "Pre-multiplying a vector $x\\in {R}^{n}$ by $B$ gives a linear combination of the columns of $B:$\n\n$$\n{{[\\begin{aligned}| & | & ⋯ & | \\\\ {b}_{1} & {b}_{2} & ⋯ & {b}_{n} \\\\ | & | & ⋯ & |\\end{aligned}]}_{⏟}}_{B}\\cdot {{[\\begin{aligned}{x}_{1} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}={x}_{1}[\\begin{aligned}| \\\\ {b}_{1} \\\\ |\\end{aligned}]+{x}_{2}[\\begin{aligned}| \\\\ {b}_{2} \\\\ |\\end{aligned}]+⋯+{x}_{n}[\\begin{aligned}| \\\\ {b}_{n} \\\\ |\\end{aligned}]\n$$\n\nTherefore, the image of ${R}^{n}$ under the action of $B$ must be $\\text{Col}(B),$ the column space of $B.$\n\nFurthermore, since $\\text{Null}(B)$ is mapped to the zero vector $0$ by the definition of the null subspace, the image of its orthogonal complement $\\text{Col}({B}^{T})$ must be $\\text{Col}(B).$\n\nThis can be schematically visualized, as shown below.\n\n![](images/ad/ad1557fbd48206baf7239046ada69f60d8cd9ee4916b4f8e37741903ef7d1e9b.png)" 13194139533446 17592186045585 true] [17592186362757 1075 #edb/ref 17592186362758 13194139533446 17592186045585 true] [17592186362757 1075 #edb/ref 17592186362759 13194139533446 17592186045585 true] [17592186362757 1075 #edb/ref 17592186362760 13194139533446 17592186045585 true] [17592186362757 1075 #edb/ref 17592186362761 13194139533446 17592186045585 true] [17592186362757 1075 #edb/ref 17592186362762 13194139533446 17592186045585 true] [17592186362757 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186362757 1077 "selection" 13194139533446 17592186045585 true] [17592186362757 1079 #edb/ref 17592186362759 13194139533446 17592186045585 true] [17592186362757 1080 #uuid "4b3fad67-e441-547e-bcca-af1012111f8e" 13194139533446 17592186045585 true] [17592186362758 1081 "\\text{Null}({B}^{T})" 13194139533446 17592186045585 true] [17592186362758 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362758 1084 #uuid "9ed2ea04-17c5-525d-bb8b-a73bdb48fa90" 13194139533446 17592186045585 true] [17592186362759 1081 "\\text{Col}(B)" 13194139533446 17592186045585 true] [17592186362759 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362759 1084 #uuid "81d7a34a-2311-5d45-891e-5cd69b89006d" 13194139533446 17592186045585 true] [17592186362760 1081 "\\text{Col}({B}^{T})" 13194139533446 17592186045585 true] [17592186362760 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362760 1084 #uuid "1ed9ddc3-ffd8-53ba-802f-ad779bcf8c3e" 13194139533446 17592186045585 true] [17592186362761 1081 "0" 13194139533446 17592186045585 true] [17592186362761 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362761 1084 #uuid "7b88adee-5c88-5a21-99be-baee1cf260db" 13194139533446 17592186045585 true] [17592186362762 1081 "\\text{Null}(B)" 13194139533446 17592186045585 true] [17592186362762 1083 #edb/ref 17592186045499 13194139533446 17592186045585 true] [17592186362762 1084 #uuid "7aed3ab2-0476-5b02-8570-9d68a6779e1a" 13194139533446 17592186045585 true] [17592186362763 1068 #edb/ref 17592186362764 13194139533446 17592186045585 true] [17592186362763 1069 "q-109852" 13194139533446 17592186045585 true] [17592186362763 1070 #edb/ref 17592186045485 13194139533446 17592186045585 true] [17592186362763 1071 "Which of the following subspaces must be orthogonal to $\\text{Col}(B)$ for every matrix $B?$\n\n- $\\text{Null}({B}^{T})$\n- $\\text{Col}({B}^{T})$\n- $\\text{Null}(B)$" 13194139533446 17592186045585 true] [17592186362763 1072 #uuid "4c3520bf-5736-51de-a6b7-f6ed37ab8f1a" 13194139533446 17592186045585 true] [17592186362763 1074 "Recall that $\\text{Col}(B)$ consists of all linear combinations of the columns of $B$, that is, the rows of ${B}^{T}.$\n\nIf a vector is orthogonal to every linear combination of the rows of ${B}^{T},$ it must be orthogonal to each row of ${B}^{T}.$\nBut notice that when pre-multiplying a vector by ${B}^{T},$ we actually multiply each row of ${B}^{T}$ by that vector.\nSo, $\\text{Col}(B)$ must be orthogonal to the left null space of $B,$ which is $\\text{Null}({B}^{T}).$\n\nTherefore, the correct answer is \"I only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $B$ can be schematically visualized, as shown below.\n\n![](images/18/18713ed3d103ca0a02d74cede1e6448012e0aa28a2df804d41cfb277589a0158.png)" 13194139533446 17592186045585 true] [17592186362764 1075 #edb/ref 17592186362765 13194139533446 17592186045585 true] [17592186362764 1075 #edb/ref 17592186362766 13194139533446 17592186045585 true] [17592186362764 1075 #edb/ref 17592186362767 13194139533446 17592186045585 true] [17592186362764 1075 #edb/ref 17592186362768 13194139533446 17592186045585 true] [17592186362764 1075 #edb/ref 17592186362769 13194139533446 17592186045585 true] [17592186362764 1076 #edb/ref 17592186045493 13194139533446 17592186045585 true] [17592186362764 1077 "selection" 13194139533446 17592186045585 true] [17592186362764 1079 #edb/ref 17592186362766 13194139533446 17592186045585 true] [17592186362764 1080 #uuid "db714c4b-ae52-586c-bdd6-a74df8706792" 13194139533446 17592186045585 true] [17592186362765 1081 "I and III only" 13194139533446 17592186045585 true] [17592186362765 1083 #edb/ref 17592186045500 13194139533446 17592186045585 true] [17592186362765 1084 #uuid "15ee909a-2213-5908-aab7-710d877e6fa8" 13194139533446 17592186045585 true] [17592186362766 1081 "I only" 13194139533446 17592186045585 true] [17592186362766 1083 #edb/ref 17592186045500 13194139533446 17592186045585 true] [17592186362766 1084 #uuid "96ddce82-4639-57d8-8962-e06b2b5e382d" 13194139533446 17592186045585 true] [17592186362767 1081 "III only" 13194139533446 17592186045585 true] [17592186362767 1083 #edb/ref 17592186045500 13194139533446 17592186045585 true] [17592186362767 1084 #uuid "a3fb9876-21aa-52b8-b681-8d87695f06f3" 13194139533446 17592186045585 true] [17592186362768 1081 "I and II only" 13194139533446 17592186045585 true] [17592186362768 1083 #edb/ref 17592186045500 13194139533446 17592186045585 true] [17592186362768 1084 #uuid "3d071a53-691d-52f1-b584-49005877a293" 13194139533446 17592186045585 true] [17592186362769 1081 "II only" 13194139533446 17592186045585 true] [17592186362769 1083 #edb/ref 17592186045500 13194139533446 17592186045585 true] 