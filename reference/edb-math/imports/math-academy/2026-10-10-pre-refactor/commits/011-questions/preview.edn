1,1) & =-4\\cdot 1=-4\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent hyperplane:\n\n$$\n\\begin{aligned}w-0 & =(x-1)\\frac{∂f}{∂x}(1,1,1)+(y-1)\\frac{∂f}{∂y}(1,1,1)+(z-1)\\frac{∂f}{∂z}(1,1,1) \\\\ w & =2(x-1)+2(y-1)-4(z-1) \\\\ w & =2x-2+2y-2-4z+4 \\\\ -2x-2y+4z+w & =0 \\\\ 2x+2y-4z-w & =0\\end{aligned}\n$$" 13194139533455 17592186045585 true] [17592186385592 1075 #edb/ref 17592186385593 13194139533455 17592186045585 true] [17592186385592 1075 #edb/ref 17592186385594 13194139533455 17592186045585 true] [17592186385592 1075 #edb/ref 17592186385595 13194139533455 17592186045585 true] [17592186385592 1075 #edb/ref 17592186385596 13194139533455 17592186045585 true] [17592186385592 1075 #edb/ref 17592186385597 13194139533455 17592186045585 true] [17592186385592 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186385592 1077 "selection" 13194139533455 17592186045585 true] [17592186385592 1079 #edb/ref 17592186385596 13194139533455 17592186045585 true] [17592186385592 1080 #uuid "1c44c80b-fac5-529e-a9a1-b7e072fc7f5c" 13194139533455 17592186045585 true] [17592186385593 1081 "2x+2y+4z-w-8=0" 13194139533455 17592186045585 true] [17592186385593 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385593 1084 #uuid "5818aebe-14d2-5cfc-9808-7df8a5a99d29" 13194139533455 17592186045585 true] [17592186385594 1081 "2x-2y+4z-w-4=0" 13194139533455 17592186045585 true] [17592186385594 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385594 1084 #uuid "ba61275e-1282-5b92-8fbf-13fc0a1de178" 13194139533455 17592186045585 true] [17592186385595 1081 "2x+2y-4z+w=0" 13194139533455 17592186045585 true] [17592186385595 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385595 1084 #uuid "a4a3e7eb-d02d-5b58-99ab-47beb608be27" 13194139533455 17592186045585 true] [17592186385596 1081 "2x+2y-4z-w=0" 13194139533455 17592186045585 true] [17592186385596 1083 #edb/ref 17592186045499 13194