92186045585 true] [17592186383553 1069 "q-161835" 13194139533455 17592186045585 true] [17592186383553 1070 #edb/ref 17592186045487 13194139533455 17592186045585 true] [17592186383553 1071 "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}uv \\\\ u+v\\end{aligned}],\n$$\n\nis (locally) orientation-preserving?" 13194139533455 17592186045585 true] [17592186383553 1072 #uuid "927b4bc3-8cb1-536c-9f61-04311b6ad547" 13194139533455 17592186045585 true] [17592186383553 1074 "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}uv \\\\ u+v\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v & u \\\\ 1 & 1\\end{aligned}| \\\\  & =v\\cdot 1-1\\cdot u \\\\  & =v-u.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}v-u & >0 \\\\ v & >u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=u\n$$\n\ndefines a line, and the coordinates of, say, $(1,2)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/42/427cb4b8e6497f75aecfe809aa084b0bf6f4ad167f3a0838aa40b1a50d115e1d.png)" 13194139533455 17592186045585 true] [17592186383554 1075 #edb/ref 17592186383555 13194139533455 17592186045585 true] [17592186383554 1075 #edb/ref 17592186383556 13194139533455 17592186045585 true] [17592186383554 1075 #edb/ref 17592186383557 13194139533455 17592186045585 true] [17592186383554 1075 #edb/ref 17592186383558 13194139533455 17592186045585 true] [17592186383554 1075 #edb/ref 17592186383559 13194139533455 17592186045585 true] [17592186383554 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186383554 1077 "selection" 13194139533455 17592186045585 true] [17592186383554 1079 #edb/ref 17592186383555 13194139533455 17592186045585 true] [17592186383554 1080 #uuid "32f7d7e4-05aa-5348-8c27-28ad80ff2ef5" 13194139533455 17592186045585 true] [17592186383555 1081 "images/42/427cb4b8e6497f75aecfe809aa084b0bf6f4ad167f3a0838aa40b1a50d115e1d.png" 13194139533455 17592186045585 true] [17592186383555 1083 #edb/ref 17592186045498 13194139533455 17592186045585 true] [17592186383555 1084 #uuid "d480733d-2bef-5e70-8bd1-b1ffc7f1c3fb" 13194139533455 17592186045585 true] [17592186383556 1081 "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" 13194139533455 17592186045585 true] [17592186383556 1083 #edb/ref 17592186045498 13194139533455 17592186045585 true] [17592186383556 1084 #uuid "c32a224b-bb0d-59ed-877d-57206e5e909b" 13194139533455 17592186045585 true] [17592186383557 1081 "images/fe/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" 13194139533455 17592186045585 true] [17592186383557 1083 #edb/ref 17592186045498 13194139533455 17592186045585 true] [17592186383557 1084 #uuid "ecaf9992-c899-5cf7-95ad-9660ca75dce5" 13194139533455 17592186045585 true] [17592186383558 1081 "images/30/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" 13194139533455 17592186045585 true] [17592186383558 1083 #edb/ref 17592186045498 13194139533455 17592186045585 true] [17592186383558 1084 #uuid "153ff83b-ae84-5113-a031-ffd9105e29be" 13194139533455 17592186045585 true] [17592186383559 1081 "images/0b/0b764651dbc7999e7af13214685796b5045fab89f101bbc72bf413112df3c51f.png" 13194139533455 17592186045585 true] [17592186383559 1083 #edb/ref 17592186045498 13194139533455 17592186045585 true] [17592186383559 1084 #uuid "c24435eb-c7ff-5866-926c-e388c2da1faf" 13194139533455 17592186045585 true] [17592186383560 1068 #edb/ref 17592186383561 13194139533455 17592186045585 true] [17592186383560 1069 "q-161847" 13194139533455 17592186045585 true] [17592186383560 1070 #edb/ref 17592186045487 13194139533455 17592186045585 true] [17592186383560 1071 "Let $f:U\\to R$ be continuously differentiable on an open set $U⊆R$ such that $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U.$ Which of the following statements **must** be true?\n\n- The function $f$ is invertible on $U.$\n- The inverse ${f}^{-1}$ is continuously differentiable on $U.$\n- The derivative of ${f}^{-1}$ is given by ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$" 13194139533455 17592186045585 true] [17592186383560 1072 #uuid "4dcab08e-c33d-5c73-a45a-265b0e425858" 13194139533455 17592186045585 true] [17592186383560 1074 "The inverse function theorem for single-variable functions states the following:\n\n*If $f:U\\to R$ is continuously differentiable on an open set $U⊆R,$ $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *${f}^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of ${f}^{-1}$ is given by* \n\n$$\n{({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}=\\frac{1}{{f}^{′}({f}^{-1}(b))}\\,.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the theorem, the function $f$ must be invertible in some neighborhood of $a,$ which could be smaller than $U.$ \n\nFor example, the function $f(x)=2{x}^{4}$ satisfies the conditions of the inverse function theorem for $U=(-2,2)$ and $a=-1.$ However, $f(x)$ is not invertible on the entire set $U,$ only on a subset of $U.$\n\n- Statement II is false. According to the theorem, the function${f}^{-1}$ must be continuously differentiable in a neighborhood of $b,$ which could be smaller than $U.$\n\n- Statement III is true. According to the theorem, we must have ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$\n\nTherefore, the correct answer is \"III only.\"" 13194139533455 17592186045585 true] [17592186383561 1075 #edb/ref 17592186383562 13194139533455 17592186045585 true] [17592186383561 1075 #edb/ref 17592186383563 13194139533455 17592186045585 true] [17592186383561 1075 #edb/ref 17592186383564 13194139533455 17592186045585 true] [17592186383561 1075 #edb/ref 17592186383565 13194139533455 17592186045585 true] [17592186383561 1075 #edb/ref 17592186383566 13194139533455 17592186045585 true] [17592186383561 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186383561 1077 "selection" 13194139533455 17592186045585 true] [17592186383561 1079 #edb/ref 17592186383565 13194139533455 17592186045585 true] [17592186383561 1080 #uuid "d2936b7a-671b-55a9-bb7e-ae5b488e2a37" 13194139533455 17592186045585 true] [17592186383562 1081 "None of the statements are true" 13194139533455 17592186045585 true] [17592186383562 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383562 1084 #uuid "08591c50-d2f8-549a-ba10-75d857743ef1" 13194139533455 17592186045585 true] [17592186383563 1081 "I, II, and III" 13194139533455 17592186045585 true] [17592186383563 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383563 1084 #uuid "7ac94a93-62ef-553e-89c8-9d25b60013c2" 13194139533455 17592186045585 true] [17592186383564 1081 "I and III only" 13194139533455 17592186045585 true] [17592186383564 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383564 1084 #uuid "f1287fe6-db30-5067-b4bc-a59e28ea1181" 13194139533455 17592186045585 true] [17592186383565 1081 "III only" 13194139533455 17592186045585 true] [17592186383565 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383565 1084 #uuid "619920e2-3b93-58e3-bda9-575d1e101c63" 13194139533455 17592186045585 true] [17592186383566 1081 "II only" 13194139533455 17592186045585 true] [17592186383566 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383566 1084 #uuid "32f8f703-39ef-57df-bb97-5b1e661fb221" 13194139533455 17592186045585 true] [17592186383567 1068 #edb/ref 17592186383568 13194139533455 17592186045585 true] [17592186383567 1069 "q-161849" 13194139533455 17592186045585 true] [17592186383567 1070 #edb/ref 17592186045487 13194139533455 17592186045585 true] [17592186383567 1071 "Let $f:U\\to R$ be continuously differentiable on an open set $U⊆R$ such that $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U.$ Which of the following statements **must** be true?\n\n- The function $f$ is invertible on $U.$\n- The inverse ${f}^{-1}$ is continuously differentiable in a neighborhood of $b.$\n- The derivative of ${f}^{-1}$ is given by ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$" 13194139533455 17592186045585 true] [17592186383567 1072 #uuid "61853900-8f46-5757-9fa9-7e0c887a8b65" 13194139533455 17592186045585 true] [17592186383567 1074 "The inverse function theorem for single-variable functions states the following:\n\n*If $f:U\\to R$ is continuously differentiable on an open set $U⊆R,$ $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *${f}^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of ${f}^{-1}$ is given by* \n\n$$\n{({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}=\\frac{1}{{f}^{′}({f}^{-1}(b))}\\,.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the theorem, the function $f$ must be invertible in some neighborhood of $a,$ which could be smaller than $U.$ \n\nFor example, the function $f(x)=\\operatorname{sin}⁡x$ satisfies the conditions of the inverse function theorem for $U=(0,\\pi )$ and $a=\\frac{\\pi }{4}.$ However, $f(x)$ is not invertible on the entire set $U,$ only on a subset of $U.$\n\n- Statement II is true. Indeed, the inverse ${f}^{-1}$ must be continuously differentiable in a neighborhood of $b.$\n\n- Statement III is true. According to the theorem, we must have ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$\n\nTherefore, the correct answer is \"II and III only.\"" 13194139533455 17592186045585 true] [17592186383568 1075 #edb/ref 17592186383569 13194139533455 17592186045585 true] [17592186383568 1075 #edb/ref 17592186383570 13194139533455 17592186045585 true] [17592186383568 1075 #edb/ref 17592186383571 13194139533455 17592186045585 true] [17592186383568 1075 #edb/ref 17592186383572 13194139533455 17592186045585 true] [17592186383568 1075 #edb/ref 17592186383573 13194139533455 17592186045585 true] [17592186383568 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186383568 1077 "selection" 13194139533455 17592186045585 true] [17592186383568 1079 #edb/ref 17592186383570 13194139533455 17592186045585 true] [17592186383568 1080 #uuid "6fb80fc7-ba77-5c0f-ba23-96ab5f803c08" 13194139533455 17592186045585 true] [17592186383569 1081 "I, II, and III" 13194139533455 17592186045585 true] [17592186383569 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383569 1084 #uuid "f6f602b5-5a1e-535d-ad68-49ac1667acda" 13194139533455 17592186045585 true] [17592186383570 1081 "II and III only" 13194139533455 17592186045585 true] [17592186383570 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383570 1084 #uuid "93e852fd-5bf0-5a01-b3c9-14356ba77c90" 13194139533455 17592186045585 true] [17592186383571 1081 "I and III only" 13194139533455 17592186045585 true] [17592186383571 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383571 1084 #uuid "7ed9685b-fb83-5c8c-a8d6-889b339ec26f" 13194139533455 17592186045585 true] [17592186383572 1081 "III only" 13194139533455 17592186045585 true] [17592186383572 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383572 1084 #uuid "467618f5-1a41-505d-a03a-c550b4663a12" 13194139533455 17592186045585 true] [17592186383573 1081 "II only" 13194139533455 17592186045585 true] [17592186383573 1083 #edb/ref 17592186045500 13194139533455 17592186045585 true] [17592186383573 1084 #uuid "f19ac791-2d1e-531d-9df4-47827d931c33" 13194139533455 17592186045585 true] [17592186383574 1068 #edb/ref 17592186383575 13194139533455 17592186045585 true] [17592186383574 1069 "q-161877" 13194139533455 17592186045585 true] [17592186383574 1070 #edb/ref 17592186045485 13194139533455 17592186045585 true] [17592186383574 1071 "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(2,1)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{ln}⁡(u-v) \\\\ v-{u}^{2}\\end{aligned}]?\n$$" 13194139533455 17592186045585 true] [17592186383574 1072 #uuid "6f0941ca-edd5-5538-8a0c-b3d25f8e41f5" 13194139533455 17592186045585 true] [17592186383574 1074 "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{u-v} & -\\frac{1}{u-v} \\\\ -2u & 1\\end{aligned}| \\\\  & =\\frac{1}{u-v}\\cdot 1-(-2u)\\cdot (-\\frac{1}{u-v}) \\\\  & =\\frac{1-2u}{u-v} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(2,1)} & ={(\\frac{1-2u}{u-v})\\,|}_{u=2\\,v=1} \\\\  & =\\frac{1-2(2)}{2-1} \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|-3|\\cdot \\delta A \\\\  & =3\\,\\delta A.\\end{aligned}\n$$"