xx}(0,3)-\\cancel{{f}_{yxx}(0,3)} \\\\  & ={f}_{xx}(0,3) \\\\  & =6-(3){e}^{0} \\\\  & =6-3 \\\\  & =3.\\end{aligned}\n$$" 13194139533455 17592186045585 true] [17592186385474 1075 #edb/ref 17592186385475 13194139533455 17592186045585 true] [17592186385474 1075 #edb/ref 17592186385476 13194139533455 17592186045585 true] [17592186385474 1075 #edb/ref 17592186385477 13194139533455 17592186045585 true] [17592186385474 1075 #edb/ref 17592186385478 13194139533455 17592186045585 true] [17592186385474 1075 #edb/ref 17592186385479 13194139533455 17592186045585 true] [17592186385474 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186385474 1077 "selection" 13194139533455 17592186045585 true] [17592186385474 1079 #edb/ref 17592186385476 13194139533455 17592186045585 true] [17592186385474 1080 #uuid "afe27893-1876-50f7-acf5-6e07d5fdf98e" 13194139533455 17592186045585 true] [17592186385475 1081 "6-3e" 13194139533455 17592186045585 true] [17592186385475 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385475 1084 #uuid "0ee62eb6-e19b-5d6a-b0c7-bf3df799ce1f" 13194139533455 17592186045585 true] [17592186385476 1081 "3" 13194139533455 17592186045585 true] [17592186385476 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385476 1084 #uuid "85394c96-0e11-5026-b97f-b8419a68cf98" 13194139533455 17592186045585 true] [17592186385477 1081 "6" 13194139533455 17592186045585 true] [17592186385477 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385477 1084 #uuid "5f88b1a3-0b7e-5c9e-bb2a-8356f20e0409" 13194139533455 17592186045585 true] [17592186385478 1081 "0" 13194139533455 17592186045585 true] [17592186385478 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385478 1084 #uuid "8d287a5e-481f-50ad-8f03-eeb007565588" 13194139533455 17592186045585 true] [17592186385479 1081 "3e" 13194139533455 17592186045585 true] [17592186385479 1083 #edb/ref 17592186045499 13194139533455 17