⟩\\cdot ⟨x+1,y+2⟩ \\\\  & =4+⟨4,-2⟩\\cdot ⟨x+1,y+2⟩.\\end{aligned}\n$$\n\nWe can approximate $f(-1.05,-1.96)$ by evaluating the linear approximation at $x=-1.05$ and $y=-1.96,$ as follows:\n\n$$\n\\begin{aligned}f(-1.05,-1.96) & ≈4+⟨4,-2⟩\\cdot ⟨-1.05+1,-1.96+2⟩ \\\\  & =4+⟨4,-2⟩\\cdot ⟨-0.05,0.04⟩ \\\\  & =4-0.20-0.08 \\\\  & =3.72\\end{aligned}\n$$" 13194139533455 17592186045585 true] [17592186385906 1075 #edb/ref 17592186385907 13194139533455 17592186045585 true] [17592186385906 1075 #edb/ref 17592186385908 13194139533455 17592186045585 true] [17592186385906 1075 #edb/ref 17592186385909 13194139533455 17592186045585 true] [17592186385906 1075 #edb/ref 17592186385910 13194139533455 17592186045585 true] [17592186385906 1075 #edb/ref 17592186385911 13194139533455 17592186045585 true] [17592186385906 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186385906 1077 "selection" 13194139533455 17592186045585 true] [17592186385906 1079 #edb/ref 17592186385910 13194139533455 17592186045585 true] [17592186385906 1080 #uuid "21a9cbd3-1fa3-54d9-8a88-b7bd246ff005" 13194139533455 17592186045585 true] [17592186385907 1081 "4.22" 13194139533455 17592186045585 true] [17592186385907 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385907 1084 #uuid "3f13e13a-e002-5c64-ab1d-da8bbd9057d0" 13194139533455 17592186045585 true] [17592186385908 1081 "4.08" 13194139533455 17592186045585 true] [17592186385908 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385908 1084 #uuid "683a486e-108c-55ae-8121-a1e545dbc2a2" 13194139533455 17592186045585 true] [17592186385909 1081 "3.93" 13194139533455 17592186045585 true] [17592186385909 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385909 1084 #uuid "bd375e59-10f7-50c1-9a25-b68b87c1f2c4" 13194139533455 17592186045585 true] [17592186385910 1081 "3.72" 13194139533455 17592186045585 true] [17592186385910 1083 #edb/ref 17592186045499 13194139533455 1759218