94139533455 17592186045585 true] [17592186385488 1084 #uuid "c0b9fbaf-f64d-5ad3-abb4-a017cae7c08a" 13194139533455 17592186045585 true] [17592186385489 1081 "2" 13194139533455 17592186045585 true] [17592186385489 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385489 1084 #uuid "f66cfb9d-8d11-52f7-9251-406ca3edbde5" 13194139533455 17592186045585 true] [17592186385490 1081 "4" 13194139533455 17592186045585 true] [17592186385490 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385490 1084 #uuid "a4881b3c-27ee-53a8-9aee-4fdff5041ea2" 13194139533455 17592186045585 true] [17592186385491 1081 "0" 13194139533455 17592186045585 true] [17592186385491 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385491 1084 #uuid "0a151ece-41ef-559c-ac72-9ef593d818b8" 13194139533455 17592186045585 true] [17592186385492 1081 "5" 13194139533455 17592186045585 true] [17592186385492 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385492 1084 #uuid "b0cdfb72-e738-5857-8baa-b369b5157864" 13194139533455 17592186045585 true] [17592186385493 1068 #edb/ref 17592186385494 13194139533455 17592186045585 true] [17592186385493 1069 "q-71199" 13194139533455 17592186045585 true] [17592186385493 1070 #edb/ref 17592186045485 13194139533455 17592186045585 true] [17592186385493 1071 "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $y=2.$ Given that the point $P$ with $x$-coordinate $3$ lies on $C$, and that ${f}_{x}=\\frac{\\sqrt{{x}^{2}-2{y}^{2}}}{y-x}$, find the slope of the tangent to $C$ at $P.$" 13194139533455 17592186045585 true] [17592186385493 1072 #uuid "b3d97ced-0267-5370-864a-580ea21d98cd" 13194139533455 17592186045585 true] [17592186385493 1074 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=2.$ Hence, the slope of the tangent to the curve $C$ at the point where $x=3$ will be given by the partial derivative ${f}_{x}(3,2).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(3,2):$\n\n$$\n\\begin{aligned}{f}_{x}(3,2) & =\\frac{\\sqrt{(3)^{2}-2(2)^{2}}}{2-3} \\\\  & =\\frac{\\sqrt{9-8}}{-1} \\\\  & =-1\\end{aligned}\n$$" 13194139533455 17592186045585 true] [17592186385494 1075 #edb/ref 17592186385495 13194139533455 17592186045585 true] [17592186385494 1075 #edb/ref 17592186385496 13194139533455 17592186045585 true] [17592186385494 1075 #edb/ref 17592186385497 13194139533455 17592186045585 true] [17592186385494 1075 #edb/ref 17592186385498 13194139533455 17592186045585 true] [17592186385494 1075 #edb/ref 17592186385499 13194139533455 17592186045585 true] [17592186385494 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186385494 1077 "selection" 13194139533455 17592186045585 true] [17592186385494 1079 #edb/ref 17592186385499 13194139533455 17592186045585 true] [17592186385494 1080 #uuid "81978c17-aece-5d30-9a3d-6fc52afbe445" 13194139533455 17592186045585 true] [17592186385495 1081 "-\\frac{1}{2}" 13194139533455 17592186045585 true] [17592186385495 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385495 1084 #uuid "6357e5c2-cf46-5660-bc20-49dbba19cc28" 13194139533455 17592186045585 true] [17592186385496 1081 "\\frac{1}{2}" 13194139533455 17592186045585 true] [17592186385496 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385496 1084 #uuid "c55a41e3-729e-57f0-b1aa-89cceb118ec8" 13194139533455 17592186045585 true] [17592186385497 1081 "1" 13194139533455 17592186045585 true] [17592186385497 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385497 1084 #uuid "7b13627d-a272-58c9-8614-2ccdaa4b3963" 13194139533455 17592186045585 true] [17592186385498 1081 "0" 13194139533455 17592186045585 true] [17592186385498 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385498 1084 #uuid "a48f0d5e-1c10-5086-b78b-c0af0a0d5cb7" 13194139533455 17592186045585 true] [17592186385499 1081 "-1" 13194139533455 17592186045585 true] [17592186385499 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385499 1084 #uuid "e97a3c40-2850-570e-ac0a-9580b1fbaf26" 13194139533455 17592186045585 true] [17592186385500 1068 #edb/ref 17592186385501 13194139533455 17592186045585 true] [17592186385500 1069 "q-71224" 13194139533455 17592186045585 true] [17592186385500 1070 #edb/ref 17592186045486 13194139533455 17592186045585 true] [17592186385500 1071 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $x=-\\frac{\\pi }{2}.$ Given that the point $P(-\\frac{\\pi }{2},0,2)$ lies on $C$, and that ${f}_{y}=\\frac{\\operatorname{sin}⁡x\\operatorname{cos}⁡y}{2}$, which of the following gives a tangent vector to $C$ at $P?$" 13194139533455 17592186045585 true] [17592186385500 1072 #uuid "851f656d-69a9-5c8d-8482-1385f4b7fe8a" 13194139533455 17592186045585 true] [17592186385500 1074 "The curve $C$ is the intersection of the surface with the plane $x=-\\frac{\\pi }{2}.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{y}(-\\frac{\\pi }{2},0).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(-\\frac{\\pi }{2},0):$\n\n$$\n\\begin{aligned}{f}_{y}(-\\frac{\\pi }{2},0) & =\\frac{\\operatorname{sin}⁡(-\\frac{\\pi }{2})\\operatorname{cos}⁡0}{2} \\\\  & =\\frac{(-1)\\cdot 1}{2} \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(-\\frac{\\pi }{2},0) & ={f}_{y}(-\\frac{\\pi }{2},0)(y-0) \\\\ z-2 & =-\\frac{1}{2}y \\\\ z & =-\\frac{1}{2}y+2\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(-\\frac{\\pi }{2},0,2)$ can be given as the intersection of two planes:\n\n$$\n{\\begin{aligned}x=-\\frac{\\pi }{2} \\\\ z=-\\frac{1}{2}y+2\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $x=-\\frac{\\pi }{2},$ a normal vector to the plane is ${n}_{1}=⟨1,0,0⟩.$\n\n- For the plane $z=-\\frac{1}{2}y+2$ (or $y+2z-4=0$), a normal vector to the plane is ${n}_{2}=⟨0,1,2⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,0,0⟩\\times ⟨0,1,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 2\\end{aligned}\\right| \\\\  & =-2j+k \\\\  & =⟨0,-2,1⟩\\end{aligned}\n$$\n\nTherefore, a tangent vector to $C$ at $P$ is $⟨0,-2,1⟩.$" 13194139533455 17592186045585 true] [17592186385501 1075 #edb/ref 17592186385502 13194139533455 17592186045585 true] [17592186385501 1075 #edb/ref 17592186385503 13194139533455 17592186045585 true] [17592186385501 1075 #edb/ref 17592186385504 13194139533455 17592186045585 true] [17592186385501 1075 #edb/ref 17592186385505 13194139533455 17592186045585 true] [17592186385501 1075 #edb/ref 17592186385506 13194139533455 17592186045585 true] [17592186385501 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186385501 1077 "selection" 13194139533455 17592186045585 true] [17592186385501 1079 #edb/ref 17592186385504 13194139533455 17592186045585 true] [17592186385501 1080 #uuid "472f77ac-e8ea-5a7a-80e6-2f7ea6d432cc" 13194139533455 17592186045585 true] [17592186385502 1081 "⟨0,0,1⟩" 13194139533455 17592186045585 true] [17592186385502 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385502 1084 #uuid "b2187dab-e7ba-58a2-bb51-8cf8f2621861" 13194139533455 17592186045585 true] [17592186385503 1081 "⟨0,0,2⟩" 13194139533455 17592186045585 true] [17592186385503 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385503 1084 #uuid "c7b20770-5530-508f-960d-cfa8e2d86fc3" 13194139533455 17592186045585 true] [17592186385504 1081 "⟨0,-2,1⟩" 13194139533455 17592186045585 true] [17592186385504 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186385504 1084 #uuid "a1c3159c