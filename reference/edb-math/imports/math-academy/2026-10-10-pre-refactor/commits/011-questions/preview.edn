4139533455 17592186045585 true] [17592186383242 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186383242 1084 #uuid "bf422347-5e08-54dc-812b-c19e297a836d" 13194139533455 17592186045585 true] [17592186383243 1068 #edb/ref 17592186383244 13194139533455 17592186045585 true] [17592186383243 1069 "q-131129" 13194139533455 17592186045585 true] [17592186383243 1070 #edb/ref 17592186045486 13194139533455 17592186045585 true] [17592186383243 1071 "Find the equation of the normal line to the surface ${e}^{x+y+z}-2xyz=-3$ at the point $(2,-1,-1).$" 13194139533455 17592186045585 true] [17592186383243 1072 #uuid "d47e612d-20bf-521c-bc95-454c7d00a756" 13194139533455 17592186045585 true] [17592186383243 1074 "Let's set $f(x,y,z)={e}^{x+y+z}-2xyz.$ Then, our surface can be viewed as the level surface $f(x,y,z)=-3.$ \n\nA normal vector to the level surface that passes through the point $(2,-1,-1)$ can be found by computing $∇f(2,-1,-1).$ \n\nSo, we find the gradient and evaluate it at $(2,-1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({e}^{x+y+z}-2xyz)i+\\frac{∂}{∂y}({e}^{x+y+z}-2xyz)j+\\frac{∂}{∂z}({e}^{x+y+z}-2xyz)k \\\\  & =({e}^{x+y+z}-2yz)\\text{ }i+({e}^{x+y+z}-2xz)\\text{ }j+({e}^{x+y+z}-2xy)\\text{ }k \\\\ ∇f(2,-1,-1) & =({e}^{2-1-1}-2(-1)(-1))\\text{ }i+({e}^{2-1-1}-2(2)(-1))\\text{ }j+({e}^{2-1-1}-2(2)(-1))\\text{ }k \\\\  & =({e}^{0}-2)\\text{ }i+({e}^{0}+4)\\text{ }j+({e}^{0}+4)\\text{ }k \\\\  & =-i+5\\,j+5\\,k \\\\  & =⟨-1,5,5⟩\\end{aligned}\n$$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-2}{(-1)}=\\frac{y-(-1)}{5}=\\frac{z-(-1)}{5} \\\\ \\frac{x-2}{(-1)}=\\frac{y+1}{5}=\\frac{z+1}{5} \\\\ 2-x=\\frac{y+1}{5}=\\frac{z+1}{5}\\end{aligned}\n$$" 13194139533455 17592186045585 true] [17592186383244 1075 #edb/ref 17592186383245 13194139533455 17592186045585 true] [17592186383244 1075 #edb/ref 17592186383246 13194139533455 17592186045585 true] [17592186383244 1075 #edb/ref 17592186383247 13194139533455 17592186045585 true] [17592186383244 1075 #edb/ref 17592186383248 13194139533455 17592186045585 true] [17592186383244 1075 #edb/ref 17592186383249 13194139533455 17592186045585 true] [17592186383244 1076 #edb/ref 17592186045493 13194139533455 17592186045585 true] [17592186383244 1077 "selection" 13194139533455 17592186045585 true] [17592186383244 1079 #edb/ref 17592186383245 13194139533455 17592186045585 true] [17592186383244 1080 #uuid "4ee6c88e-5b3b-502a-94c3-437af9351333" 13194139533455 17592186045585 true] [17592186383245 1081 "2-x=\\frac{y+1}{5}=\\frac{z+1}{5}" 13194139533455 17592186045585 true] [17592186383245 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186383245 1084 #uuid "356b8022-b7d2-533d-94f4-726922eda15a" 13194139533455 17592186045585 true] [17592186383246 1081 "x-2=y+1=\\frac{z+1}{5}" 13194139533455 17592186045585 true] [17592186383246 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186383246 1084 #uuid "e09b8534-738c-5763-a9b2-970a08b191e6" 13194139533455 17592186045585 true] [17592186383247 1081 "\\frac{x-2}{2}=y+1=\\frac{z+1}{5}" 13194139533455 17592186045585 true] [17592186383247 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186383247 1084 #uuid "ef55da50-663f-5be8-a53f-b873d7c761d0" 13194139533455 17592186045585 true] [17592186383248 1081 "\\frac{2-x}{2}=\\frac{y+1}{3}=z+1" 13194139533455 17592186045585 true] [17592186383248 1083 #edb/ref 17592186045499 13194139533455 17592186045585 true] [17592186383248 1084 #uuid "8e5e3e97-6073-5e4d-bc6c-d357a63433cf" 13194139533455 17592186045585 true] [17592186383249 1081 "2-x=y+1=z+1" 13194139533455 17592186045585 true] [17592186383249 1083 #edb/ref 1759