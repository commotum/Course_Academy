rac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{6}{∬}_{D}(4{x}^{2}-2xy)\\,\\text{d}A \\\\  & =\\frac{1}{6}{\\int }_{0}^{2}{\\int }_{0}^{3}(4{x}^{2}-2xy)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{2}[4{x}^{2}y-x{y}^{2}]_{y=0}^{y=3}\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{2}(12{x}^{2}-9x)\\,\\text{d}x \\\\  & =\\frac{1}{6}{[4{x}^{3}-\\frac{9{x}^{2}}{2}]}_{x=0}^{x=2} \\\\  & =\\frac{1}{6}(4\\cdot {2}^{3}-18\\cdot 1) \\\\  & =\\frac{14}{6} \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$" 13194139533451 17592186045585 true] [17592186374227 1075 #edb/ref 17592186374228 13194139533451 17592186045585 true] [17592186374227 1075 #edb/ref 17592186374229 13194139533451 17592186045585 true] [17592186374227 1075 #edb/ref 17592186374230 13194139533451 17592186045585 true] [17592186374227 1075 #edb/ref 17592186374231 13194139533451 17592186045585 true] [17592186374227 1075 #edb/ref 17592186374232 13194139533451 17592186045585 true] [17592186374227 1076 #edb/ref 17592186045493 13194139533451 17592186045585 true] [17592186374227 1077 "selection" 13194139533451 17592186045585 true] [17592186374227 1079 #edb/ref 17592186374231 13194139533451 17592186045585 true] [17592186374227 1080 #uuid "c1ebd5b0-25d8-5f24-b968-07449b1544ea" 13194139533451 17592186045585 true] [17592186374228 1081 "\\frac{9}{2}" 13194139533451 17592186045585 true] [17592186374228 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186374228 1084 #uuid "e813966b-fc89-5c4f-b6b6-45799e91d1d5" 13194139533451 17592186045585 true] [17592186374229 1081 "2" 13194139533451 17592186045585 true] [17592186374229 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186374229 1084 #uuid "0ac41a6c-b864-5c4a-ac95-75ec4d5dfde5" 13194139533451 17592186045585 true] [17592186374230 1081 "\\frac{3}{4}" 13194139533451 17592186045585 true] [17592186374230 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186374230 1084 #uuid "ad193002-d484-