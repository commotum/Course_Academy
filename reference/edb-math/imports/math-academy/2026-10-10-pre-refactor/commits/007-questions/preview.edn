name{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ((\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}+(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{cos}^{2}⁡\\theta {sin}^{2}⁡ϕ+{\\rho }^{2}{sin}^{2}⁡\\theta {sin}^{2}⁡ϕ) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{sin}^{2}⁡ϕ) \\\\  & =2{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2x({x}^{2}+{y}^{2})\\,\\text{d}V & ={∭}_{Δ}2{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{4}2{\\rho }^{5}\\operatorname{cos}⁡\\theta {sin}^{4}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139533451 17592186045585 true] [17592186374034 1075 #edb/ref 17592186374035 13194139533451 17592186045585 true] [17592186374034 1075 #edb/ref 17592186374036 13194139533451 17592186045585 true] [17592186374034 1075 #edb/ref 17592186374037 13194139533451 17592186045585 true] [17592186374034 1075 #edb/ref 17592186374038 13194139533451 17592186045585 true] [17592186374034 1075 #edb/ref 17592186374039 13194139533451 17592186045585 true] [17592186374034 1076 #edb/ref 17592186045493 13194139533451 17592186045585 true] [17592186374034 1077 "selection" 13194139533451 17592186045585 true] [17592186374034 1079 #edb/ref 17592186374037 13194139533451 17592186045585 true] [17592186374034 1080 #uuid "a7ce963d-75b4-566b-8c6b-5c5079626401" 13194139533451 17592186045585 true] [17592186374035 1081 "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{4