ed}1 \\\\ -1\\end{aligned}],\\,\\text{and}\\,[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$" 13194139533451 17592186045585 true] [17592186374761 1075 #edb/ref 17592186374762 13194139533451 17592186045585 true] [17592186374761 1075 #edb/ref 17592186374763 13194139533451 17592186045585 true] [17592186374761 1075 #edb/ref 17592186374764 13194139533451 17592186045585 true] [17592186374761 1075 #edb/ref 17592186374765 13194139533451 17592186045585 true] [17592186374761 1075 #edb/ref 17592186374766 13194139533451 17592186045585 true] [17592186374761 1076 #edb/ref 17592186045493 13194139533451 17592186045585 true] [17592186374761 1077 "selection" 13194139533451 17592186045585 true] [17592186374761 1079 #edb/ref 17592186374764 13194139533451 17592186045585 true] [17592186374761 1080 #uuid "a13b7908-8a8e-5940-90b0-2b407feeb2b5" 13194139533451 17592186045585 true] [17592186374762 1081 "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ only" 13194139533451 17592186045585 true] [17592186374762 1083 #edb/ref 17592186045500 13194139533451 17592186045585 true] [17592186374762 1084 #uuid "e6cd0bbe-e3cf-589c-ac46-9d26fb837731" 13194139533451 17592186045585 true] [17592186374763 1081 "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$\nand \n$[\\begin{aligned}1 \\\\ 1\\end{aligned}]$" 13194139533451 17592186045585 true] [17592186374763 1083 #edb/ref 17592186045500 13194139533451 17592186045585 true] [17592186374763 1084 #uuid "44229ef0-908e-5889-b9a4-e9e8594b2ed7" 13194139533451 17592186045585 true] [17592186374764 1081 "$[\\begin{aligned}0 \\\\ 0\\end{aligned}],$\n$[\\begin{aligned}1 \\\\ -1\\end{aligned}],$\nand \n$[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$" 13194139533451 17592186045585 true] [17592186374764 1083 #edb/ref 17592186045500 13194139533451 17592186045585 true] [17592186374764 1084 #uuid "5e7153cc-1e47-5d24-ab61-9c0bd38cd319" 13194139533451 17592186045585 true] [17592186374765 1081 "$[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ only" 13194139533451 17592186045585 true] [17592186374765 1