ned}]\\end{aligned}\n$$" 13194139533451 17592186045585 true] [17592186375605 1075 #edb/ref 17592186375606 13194139533451 17592186045585 true] [17592186375605 1075 #edb/ref 17592186375607 13194139533451 17592186045585 true] [17592186375605 1075 #edb/ref 17592186375608 13194139533451 17592186045585 true] [17592186375605 1075 #edb/ref 17592186375609 13194139533451 17592186045585 true] [17592186375605 1075 #edb/ref 17592186375610 13194139533451 17592186045585 true] [17592186375605 1076 #edb/ref 17592186045493 13194139533451 17592186045585 true] [17592186375605 1077 "selection" 13194139533451 17592186045585 true] [17592186375605 1079 #edb/ref 17592186375609 13194139533451 17592186045585 true] [17592186375605 1080 #uuid "1ff368e9-8ea0-51a4-8f24-f214ce6cf4d3" 13194139533451 17592186045585 true] [17592186375606 1081 "[\\begin{aligned}12 & -18 \\\\ 3 & -4\\end{aligned}]" 13194139533451 17592186045585 true] [17592186375606 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186375606 1084 #uuid "820b9c20-45ba-5de9-bb8b-af39b16c9e09" 13194139533451 17592186045585 true] [17592186375607 1081 "[\\begin{aligned}3 & -12 \\\\ -3 & 14\\end{aligned}]" 13194139533451 17592186045585 true] [17592186375607 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186375607 1084 #uuid "ae8e5c22-2007-5bee-a8c6-367d57800d00" 13194139533451 17592186045585 true] [17592186375608 1081 "[\\begin{aligned}3 & -6 \\\\ 0 & 2\\end{aligned}]" 13194139533451 17592186045585 true] [17592186375608 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186375608 1084 #uuid "ccb49c47-6d12-5ccf-86ec-19b3a6a0b835" 13194139533451 17592186045585 true] [17592186375609 1081 "[\\begin{aligned}-3 & -3 \\\\ 13 & 11\\end{aligned}]" 13194139533451 17592186045585 true] [17592186375609 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186375609 1084 #uuid "885945eb-10d2-5fdc-8538-d0c388289fe3" 13194139533451 17592186045585 true] [17592186375610 1081 "[\