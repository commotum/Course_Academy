\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}y\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\rho }^{4}\\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" 13194139533451 17592186045585 true] [17592186374000 1075 #edb/ref 17592186374001 13194139533451 17592186045585 true] [17592186374000 1075 #edb/ref 17592186374002 13194139533451 17592186045585 true] [17592186374000 1075 #edb/ref 17592186374003 13194139533451 17592186045585 true] [17592186374000 1075 #edb/ref 17592186374004 13194139533451 17592186045585 true] [17592186374000 1075 #edb/ref 17592186374005 13194139533451 17592186045585 true] [17592186374000 1076 #edb/ref 17592186045493 13194139533451 17592186045585 true] [17592186374000 1077 "selection" 13194139533451 17592186045585 true] [17592186374000 1079 #edb/ref 17592186374001 13194139533451 17592186045585 true] [17592186374000 1080 #uuid "a700385c-d096-5782-9773-03ac3b36124f" 13194139533451 17592186045585 true] [17592186374001 1081 "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\rho }^{4}\\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" 13194139533451 17592186045585 true] [17592186374001 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186374001 1084 #uuid "f584638d-028d-5971-ba0e-0417d5a82f56" 13194139533451 17592186045585 true] [17592186374002 1081 "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{16}{\\rho }^{3}\\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" 13194139533451 17592186045585 true] [17592186374002 1083 #edb/ref 17592186045499 13194139533451 17592186045585 true] [17592186374002 1084 #u