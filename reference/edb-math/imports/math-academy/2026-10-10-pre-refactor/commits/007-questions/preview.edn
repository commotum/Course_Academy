z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & 2 & 0 \\\\ 1 & 0 & -1 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}2x & 2 \\\\ 1 & 0\\end{aligned}| \\\\  & =0-2 \\\\  & =-2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}({x}^{2}+2y)\\operatorname{cos}⁡(x-z)\\,dV & ={∭}_{Δ}u\\operatorname{cos}⁡v\\cdot |-\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{1}{2}u\\operatorname{cos}⁡v\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{\\int }_{0}^{\\pi /2}{\\int }_{-1}^{1}u\\operatorname{cos}⁡v\\,dw\\,dv\\,du \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}u\\,du\\cdot {\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡v\\,dv\\cdot {\\int }_{-1}^{1}dw \\\\  & =\\frac{1}{2}[\\frac{{u}^{2}}{2}]_{u=0}^{u=2}\\cdot {[\\operatorname{sin}⁡v]}_{v=0}^{v=\\pi /2}\\cdot [w]_{w=-1}^{w=1} \\\\  & =\\frac{1}{2}(2-0)\\cdot (1-0)\\cdot (1-(-1) \\\\  & =2\\end{aligned}\n$$" 13194139533451 17592186045585 true] [17592186374097 1075 #edb/ref 17592186374098 13194139533451 17592186045585 true] [17592186374097 1075 #edb/ref 17592186374099 13194139533451 17592186045585 true] [17592186374097 1075 #edb/ref 17592186374100 13194139533451 17592186045585 true] [17592186374097 1075 #edb/ref 17592186374101 13194139533451 17592186045585 true] [17592186374097 1075 #edb/ref 17592186374102 13194139533451 17592186045585 true] [17592186374097 1076 #edb/ref 17592186045493 13194139533451 17592186045585 true] [17592186374097 1077 "selection" 13194139533451 17592186045585 true] [175921