y}^{2}+\\frac{1}{4}{y}^{4}]}_{y={x}^{2}}^{y=x}\\,\\text{d}x \\\\  & =15M{\\int }_{0}^{1}(\\frac{1}{2}{x}^{4}+\\frac{1}{4}{x}^{4})-(\\frac{1}{2}{x}^{6}+\\frac{1}{4}{x}^{8})\\text{d}x \\\\  & =15M{\\int }_{0}^{1}\\frac{3}{4}{x}^{4}-\\frac{1}{2}{x}^{6}-\\frac{1}{4}{x}^{8}\\,\\text{d}x \\\\  & =15M{[\\frac{3}{20}{x}^{5}-\\frac{1}{14}{x}^{7}-\\frac{1}{36}{x}^{9}]}_{0}^{1} \\\\  & =15M(\\frac{3}{20}-\\frac{1}{14}-\\frac{1}{36}) \\\\  & =15M\\cdot \\frac{16}{315} \\\\  & =\\frac{16M}{21}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the origin is\n\n$$\n\\begin{aligned}{R}_{0} & =\\sqrt{\\frac{{I}_{0}}{M}} \\\\  & =\\sqrt{\\frac{16M}{21}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{16}{21}} \\\\  & =\\frac{\\sqrt{16}}{\\sqrt{21}} \\\\  & =\\frac{4}{\\sqrt{21}} \\\\  & =\\frac{4\\sqrt{21}}{21}.\\end{aligned}\n$$" 13194139533449 17592186045585 true] [17592186369936 1075 #edb/ref 17592186369937 13194139533449 17592186045585 true] [17592186369936 1075 #edb/ref 17592186369938 13194139533449 17592186045585 true] [17592186369936 1075 #edb/ref 17592186369939 13194139533449 17592186045585 true] [17592186369936 1075 #edb/ref 17592186369940 13194139533449 17592186045585 true] [17592186369936 1075 #edb/ref 17592186369941 13194139533449 17592186045585 true] [17592186369936 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186369936 1077 "selection" 13194139533449 17592186045585 true] [17592186369936 1079 #edb/ref 17592186369940 13194139533449 17592186045585 true] [17592186369936 1080 #uuid "62a718ae-f4a8-5f07-ba0a-54def0cf1028" 13194139533449 17592186045585 true] [17592186369937 1081 "\\frac{4}{5}" 13194139533449 17592186045585 true] [17592186369937 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369937 1084 #uuid "522e13cc-675f-57a2-bbc5-ed75ae553870" 13194139533449 17592186045585 true] [17592186369938 1081 "\\frac{\\sqrt{7}}{3}" 13194139533449 17592186045585 true] [17592186369938 1083 #edb/ref 17592186045499 13194139533449 