infty }(2\\sqrt{a-5}-2\\sqrt{6-5}) \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-5}-2) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{3\\sqrt[3]{{x}^{2}}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{1}^{\\infty }\\frac{1}{3}\\,{x}^{-2/3}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[{x}^{1/3}]}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(\\sqrt[3]{a}-1) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[-\\frac{1}{x}]}_{a}^{-1} \\\\  & ={lim}_{a\\to -\\infty }(1+\\frac{1}{a}) \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent.\n\nIn conclusion, only integrals I and II are divergent." 13194139533449 17592186045585 true] [17592186368976 1075 #edb/ref 17592186368977 13194139533449 17592186045585 true] [17592186368976 1075 #edb/ref 17592186368978 13194139533449 17592186045585 true] [17592186368976 1075 #edb/ref 17592186368979 13194139533449 17592186045585 true] [17592186368976 1075 #edb/ref 17592186368980 13194139533449 17592186045585 true] [17592186368976 1075 #edb/ref 17592186368981 13194139533449 17592186045585 true] [17592186368976 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186368976 1077 "selection" 13194139533449 17592186045585 true] [17592186368976 1079 #edb/ref 17592186368980 13194139533449 17592186045585 true] [17592186368976 1080 #uuid "6e0d9dea-29ca-5077-8ef9-85315fc69e10" 13194139533449 17592186045585 true] [17592186368977 1081 "II and III only" 13194139533449 17592186045585 true] [17592186368977 1083 #edb/ref 17592186045500 13194139533449 17592186045585 true] [17592186368977 1084 #uuid "5cc7e89f-d22e-5fbb-a9dd-d145070270f1" 13194139533449 17592186045585 true] [17592186368978 108