449 17592186045585 true] [17592186370859 1070 #edb/ref 17592186045487 13194139533449 17592186045585 true] [17592186370859 1071 "Consider the vector field $F(x,y,z)=⟨z,\\,z,\\,4xy⟩$ and the surface $S$ defined in Cartesian coordinates as $z=2$ for $0\\le x\\le 2$ and $0\\le y\\le 3.$ Calculate the flux of $F$ through $S$ with respect to the *downward*-pointing unit normal vector $n.$" 13194139533449 17592186045585 true] [17592186370859 1072 #uuid "3c5b1199-265f-51a1-b6b8-07c045672fdb" 13194139533449 17592186045585 true] [17592186370859 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is a continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nFor the surface $z=2$ for $0\\le x\\le 2$ and $0\\le y\\le 3,$ the downward-pointing unit normal vector is\n\n$$\nn=⟨0,\\,0,\\,-1⟩.\n$$\n\nUsing the fact that $z=2$ on $S,$ we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨z,\\,z,\\,4xy⟩\\cdot ⟨0,\\,0,\\,-1⟩ \\\\  & =-4xy.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $F$ across $S$ as follows:\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}(-4xy)\\,\\text{d}S \\\\  & ={∬}_{D}(-4xy)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}(-4xy)\\,\\text{d}x\\,\\text{d}y \\\\  & =-{\\int }_{0}^{3}2y\\,\\text{d}y{\\int }_{0}^{2}2x\\,\\text{d}x \\\\  & =-{[{y}^{2}]}_{0}^{3}\\cdot {[{x}^{2}]}_{0}^{2} \\\\  & =-36\\end{aligned}\n$$" 13194139533449 17592186045585 true] [17592186370860 1075 #edb/ref 17592186370861 13194139533449 17592186045585 true] [17592186370860 1075 #edb/ref 17592186370862 13194139533449 17592186045585 true] [17592186370860 1075 #edb/ref 17592186370863 13194139533449 17592186045585 true] [17592186370860 1075 #edb/ref 17592186370864 13194139533449 17592186045585 true] [17592186370860 1075 #edb/ref 17592186370865 13194139533449 17592186045585 true] [17592186370860 1076 #edb