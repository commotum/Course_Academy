3 \\\\ 7 & 5\\end{aligned}| \\\\  & =4|\\begin{aligned}3 & -3 \\\\ 7 & 5\\end{aligned}| \\\\  & =4(15+21) \\\\  & =144.\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|144|=144.\n$$" 13194139533449 17592186045585 true] [17592186369859 1075 #edb/ref 17592186369860 13194139533449 17592186045585 true] [17592186369859 1075 #edb/ref 17592186369861 13194139533449 17592186045585 true] [17592186369859 1075 #edb/ref 17592186369862 13194139533449 17592186045585 true] [17592186369859 1075 #edb/ref 17592186369863 13194139533449 17592186045585 true] [17592186369859 1075 #edb/ref 17592186369864 13194139533449 17592186045585 true] [17592186369859 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186369859 1077 "selection" 13194139533449 17592186045585 true] [17592186369859 1079 #edb/ref 17592186369863 13194139533449 17592186045585 true] [17592186369859 1080 #uuid "190a5c0e-6b81-53d6-b669-800a2e45a632" 13194139533449 17592186045585 true] [17592186369860 1081 "140" 13194139533449 17592186045585 true] [17592186369860 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369860 1084 #uuid "da1aec45-a768-5bc0-8b78-ec818aed675a" 13194139533449 17592186045585 true] [17592186369861 1081 "96" 13194139533449 17592186045585 true] [17592186369861 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369861 1084 #uuid "2d5fcf24-0e46-5b4b-9678-6276ff3944ab" 13194139533449 17592186045585 true] [17592186369862 1081 "72" 13194139533449 17592186045585 true] [17592186369862 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369862 1084 #uuid "326d3d9a-2161-5ea5-a630-9abd2df1cb38" 13194139533449 17592186045585 true] [17592186369863 1081 "144" 13194139533449 17592186045585 true] [17592186369863 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369863 1084 #uuid "c014177e-0ec9-57d0-9ab5-61d474743308" 13194139533449 17592186045585 true] [17592186369864 1081 "24" 13194139533449 175