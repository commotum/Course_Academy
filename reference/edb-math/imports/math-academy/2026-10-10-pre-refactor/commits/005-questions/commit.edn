,\\text{d}t.\\end{aligned}\n$$" 13194139533449 17592186045585 true] [17592186369265 1075 #edb/ref 17592186369266 13194139533449 17592186045585 true] [17592186369265 1075 #edb/ref 17592186369267 13194139533449 17592186045585 true] [17592186369265 1075 #edb/ref 17592186369268 13194139533449 17592186045585 true] [17592186369265 1075 #edb/ref 17592186369269 13194139533449 17592186045585 true] [17592186369265 1075 #edb/ref 17592186369270 13194139533449 17592186045585 true] [17592186369265 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186369265 1077 "selection" 13194139533449 17592186045585 true] [17592186369265 1079 #edb/ref 17592186369268 13194139533449 17592186045585 true] [17592186369265 1080 #uuid "dc543956-16a6-524a-b735-fabf30c10bc9" 13194139533449 17592186045585 true] [17592186369266 1081 "6{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t" 13194139533449 17592186045585 true] [17592186369266 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369266 1084 #uuid "5a914125-7099-5b0c-a1c1-9224eef57080" 13194139533449 17592186045585 true] [17592186369267 1081 "-6{\\int }_{0}^{\\pi }{cos}^{2}⁡t\\,\\text{d}t" 13194139533449 17592186045585 true] [17592186369267 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369267 1084 #uuid "7213e0d0-98dc-5715-bb95-024708c2eadc" 13194139533449 17592186045585 true] [17592186369268 1081 "-12{\\int }_{0}^{\\pi }{sin}^{2}⁡t\\,\\text{d}t" 13194139533449 17592186045585 true] [17592186369268 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369268 1084 #uuid "9a304234-899b-5867-ae14-f933577257a0" 13194139533449 17592186045585 true] [17592186369269 1081 "12{\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" 13194139533449 17592186045585 true] [17592186369269 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369269 1084 #uuid "5c0a400c-fbad-505f-8344-98b05be346a3" 13194139533449 17592186045585 true] [175921