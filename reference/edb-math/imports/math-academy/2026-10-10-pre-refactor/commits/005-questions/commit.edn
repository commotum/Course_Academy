4}+\\frac{1}{2}.$\n\nWe evaluate the velocity at time $t=\\frac{\\pi }{4}\\,\\text{s},$ and get\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{4}) & =-\\frac{\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{4})}{4}+\\frac{1}{2} \\\\  & =-\\frac{\\operatorname{cos}⁡(\\pi )}{4}+\\frac{1}{2} \\\\  & =\\frac{1}{4}+\\frac{1}{2} \\\\  & =\\frac{3}{4}\\,\\text{m/s}.\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is also  $\\frac{3}{4}\\,\\text{m/s}.$" 13194139533449 17592186045585 true] [17592186368990 1075 #edb/ref 17592186368991 13194139533449 17592186045585 true] [17592186368990 1075 #edb/ref 17592186368992 13194139533449 17592186045585 true] [17592186368990 1075 #edb/ref 17592186368993 13194139533449 17592186045585 true] [17592186368990 1075 #edb/ref 17592186368994 13194139533449 17592186045585 true] [17592186368990 1075 #edb/ref 17592186368995 13194139533449 17592186045585 true] [17592186368990 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186368990 1077 "selection" 13194139533449 17592186045585 true] [17592186368990 1079 #edb/ref 17592186368993 13194139533449 17592186045585 true] [17592186368990 1080 #uuid "f51c8d3a-cc54-5e56-8a0e-ed22d35182c8" 13194139533449 17592186045585 true] [17592186368991 1081 "\\frac{1}{2}\\,\\text{m/s}" 13194139533449 17592186045585 true] [17592186368991 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368991 1084 #uuid "b09f3956-fd2d-5bfc-a545-74c692b21a4c" 13194139533449 17592186045585 true] [17592186368992 1081 "\\frac{1}{4}\\,\\text{m/s}" 13194139533449 17592186045585 true] [17592186368992 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368992 1084 #uuid "a87c31b7-87ed-5526-9a97-54b331faacf5" 13194139533449 17592186045585 true] [17592186368993 1081 "\\frac{3}{4}\\,\\text{m/s}" 13194139533449 17592186045585 true] [17592186368993 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368993 1084 #uuid "cc8abd2a-d7cf-5410-b8bb-f29161276a23" 13194139533449 17592186045585 true] [17592186368994 1081 "\\frac{3}{2}\\,\\text{m/s}" 13194139533449 17592186045585 true] [17592186368994 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368994 1084 #uuid "7c2c38a5-95f0-5fbf-844a-fdd72c906b6f" 13194139533449 17592186045585 true] [17592186368995 1081 "\\frac{5}{4}\\,\\text{m/s}" 13194139533449 17592186045585 true] [17592186368995 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368995 1084 #uuid "34039625-c391-5d5e-860e-8d47e520551f" 13194139533449 17592186045585 true] [17592186368996 1068 #edb/ref 17592186368997 13194139533449 17592186045585 true] [17592186368996 1069 "q-102798" 13194139533449 17592186045585 true] [17592186368996 1070 #edb/ref 17592186045487 13194139533449 17592186045585 true] [17592186368996 1071 "Given that ${y}_{1}(x)={e}^{-2x}$ is a solution to the equation ${y}^{″}-4y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." 13194139533449 17592186045585 true] [17592186368996 1072 #uuid "1861334e-ed7d-5062-93e7-0eb5521a1df5" 13194139533449 17592186045585 true] [17592186368996 1074 "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{-2x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{-2x}-2u{e}^{-2x} \\\\ {y}_{2}^{″} & ={u}^{″}{e}^{-2x}-4{u}^{′}{e}^{-2x}+4u{e}^{-2x}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{u}^{″}{e}^{-2x}-4{u}^{′}{e}^{-2x}+4u{e}^{-2x}-4u{e}^{-2x} & =0 \\\\ {u}^{″}{e}^{-2x}-4{u}^{′}{e}^{-2x} & =0 \\\\ {e}^{-2x}({u}^{″}-4{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{-2x}\\ne 0,$ we must have\n\n$$\n{u}^{″}-4{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}=4w.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{e}^{4x}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{e}^{4x}\\,⟹\\,u=\\frac{{c}_{1}}{4}{e}^{4x}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{-2x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{-2x}(\\frac{{c}_{1}}{4}{e}^{4x}+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=4$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{-2x}\\cdot {e}^{4x}={e}^{2x}.\n$$" 13194139533449 17592186045585 true] [17592186368997 1075 #edb/ref 17592186368998 13194139533449 17592186045585 true] [17592186368997 1075 #edb/ref 17592186368999 13194139533449 17592186045585 true] [17592186368997 1075 #edb/ref 17592186369000 13194139533449 17592186045585 true] [17592186368997 1075 #edb/ref 17592186369001 13194139533449 17592186045585 true] [17592186368997 1075 #edb/ref 17592186369002 13194139533449 17592186045585 true] [17592186368997 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186368997 1077 "selection" 13194139533449 17592186045585 true] [17592186368997 1079 #edb/ref 17592186368998 13194139533449 17592186045585 true] [17592186368997 1080 #uuid "e0d47d62-a03f-58d9-9af2-5fc10f21c9dc" 13194139533449 17592186045585 true] [17592186368998 1081 "{e}^{2x}" 13194139533449 17592186045585 true] [17592186368998 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368998 1084 #uuid "0f7a0465-7966-5616-981e-b9ccde92b144" 13194139533449 17592186045585 true] [17592186368999 1081 "\\operatorname{cos}⁡2x" 13194139533449 17592186045585 true] [17592186368999 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186368999 1084 #uuid "3bb70877-7c6d-5bb9-b0aa-702f3db2d56b" 13194139533449 17592186045585 true] [17592186369000 1081 "x{e}^{4x}" 13194139533449 17592186045585 true] [17592186369000 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369000 1084 #uuid "f3f7ed1f-574f-58ca-a73e-8b81c4c3a498" 13194139533449 17592186045585 true] [17592186369001 1081 "x{e}^{2x}" 13194139533449 17592186045585 true] [17592186369001 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369001 1084 #uuid "a21ba163-b843-5437-a8fc-0d7fe16d30ef" 13194139533449 17592186045585 true] [17592186369002 1081 "{e}^{-4x}" 13194139533449 17592186045585 true] [17592186369002 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369002 1084 #uuid "4a1f721c-026c-56d5-be5f-d6bf871e718e" 13194139533449 17592186045585 true] [17592186369003 1068 #edb/ref 17592186369004 13194139533449 17592186045585 true] [17592186369003 1069 "q-102801" 13194139533449 17592186045585 true] [17592186369003 1070 #edb/ref 17592186045487 13194139533449 17592186045585 true] [17592186369003 1071 "Given that ${y}_{1}(x)={e}^{2x}$ is a solution to the equation ${y}^{″}-4{y}^{′}+4y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." 13194139533449 17592186045585 true] [17592186369003 1072 #uuid "100e6b70-5e37-5a11-a1d8-331d7353c305" 13194139533449 17592186045585 true] [17592186369003 1074 "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{2x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{2x}+2u{e}^{2x} \\\\ {y}_{2}^{″} & ={u}^{″}{e}^{2x}+4{u}^{′}{e}^{2x}+4u{e}^{2x}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}{e}^{2x}+4{u}^{′}{e}^{2x}+4u{e}^{2x})-4({u}^{′}{e}^{2x}+2u{e}^{2x})+4u{e}^{2x} & =0 \\\\ {e}^{2x}({u}^{″}+4{u}^{′}+4u-4{u}^{′}-8u+4u) & =0 \\\\ {e}^{2x}{u}^{″} & =0.\\end{aligned}\n$$\n\nSince ${e}^{2x}\\ne 0$ we must have\n\n$$\n{u}^{″}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}=0.\n$$\n\nThis equation has the solution\n\n$$\nw={c}_{1}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}\\,⟹\\,u={c}_{1}x+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{2x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{2x}({c}_{1}x+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=1$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{2x}\\cdot x=x{e}^{2x}.\n$$" 13194139533