cdot 1 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-12|=12.\n$$" 13194139533449 17592186045585 true] [17592186369852 1075 #edb/ref 17592186369853 13194139533449 17592186045585 true] [17592186369852 1075 #edb/ref 17592186369854 13194139533449 17592186045585 true] [17592186369852 1075 #edb/ref 17592186369855 13194139533449 17592186045585 true] [17592186369852 1075 #edb/ref 17592186369856 13194139533449 17592186045585 true] [17592186369852 1075 #edb/ref 17592186369857 13194139533449 17592186045585 true] [17592186369852 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186369852 1077 "selection" 13194139533449 17592186045585 true] [17592186369852 1079 #edb/ref 17592186369853 13194139533449 17592186045585 true] [17592186369852 1080 #uuid "10725161-b676-53dc-8bff-5c967c1e8dfa" 13194139533449 17592186045585 true] [17592186369853 1081 "12" 13194139533449 17592186045585 true] [17592186369853 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369853 1084 #uuid "4ca3fc2b-bad0-5b4b-bc00-408085561cc9" 13194139533449 17592186045585 true] [17592186369854 1081 "6" 13194139533449 17592186045585 true] [17592186369854 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369854 1084 #uuid "a6c7791b-9b12-5dd6-9d19-547ef87dd6a8" 13194139533449 17592186045585 true] [17592186369855 1081 "24" 13194139533449 17592186045585 true] [17592186369855 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369855 1084 #uuid "c232025a-ca14-5a4a-9e9f-a8ff81b74a6d" 13194139533449 17592186045585 true] [17592186369856 1081 "-12" 13194139533449 17592186045585 true] [17592186369856 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186369856 1084 #uuid "9e6c71c2-2201-52f2-abf4-3b33cdc6feea" 13194139533449 17592186045585 true] [17592186369857 1081 "-6" 13194139533449 17592186045585 true] [17592186369857 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [175