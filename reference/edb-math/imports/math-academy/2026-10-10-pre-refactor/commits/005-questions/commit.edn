 1075 #edb/ref 17592186370908 13194139533449 17592186045585 true] [17592186370907 1075 #edb/ref 17592186370909 13194139533449 17592186045585 true] [17592186370907 1075 #edb/ref 17592186370910 13194139533449 17592186045585 true] [17592186370907 1075 #edb/ref 17592186370911 13194139533449 17592186045585 true] [17592186370907 1075 #edb/ref 17592186370912 13194139533449 17592186045585 true] [17592186370907 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186370907 1077 "selection" 13194139533449 17592186045585 true] [17592186370907 1079 #edb/ref 17592186370908 13194139533449 17592186045585 true] [17592186370907 1080 #uuid "25fe042a-43c8-58b5-bdbc-416af900df99" 13194139533449 17592186045585 true] [17592186370908 1081 "$U$ and $W$ only" 13194139533449 17592186045585 true] [17592186370908 1083 #edb/ref 17592186045500 13194139533449 17592186045585 true] [17592186370908 1084 #uuid "e357c223-7bc5-5391-bfd7-f275c3d2f261" 13194139533449 17592186045585 true] [17592186370909 1081 "$V$ and $W$ only" 13194139533449 17592186045585 true] [17592186370909 1083 #edb/ref 17592186045500 13194139533449 17592186045585 true] [17592186370909 1084 #uuid "80a15d12-7811-54c4-8891-fb1dc121f2d4" 13194139533449 17592186045585 true] [17592186370910 1081 "$U$ only" 13194139533449 17592186045585 true] [17592186370910 1083 #edb/ref 17592186045500 13194139533449 17592186045585 true] [17592186370910 1084 #uuid "6130844f-4763-5bff-8193-a482dcef45bd" 13194139533449 17592186045585 true] [17592186370911 1081 "None of the listed" 13194139533449 17592186045585 true] [17592186370911 1083 #edb/ref 17592186045500 13194139533449 17592186045585 true] [17592186370911 1084 #uuid "bfa42a3b-57d8-5002-8653-551de2275226" 13194139533449 17592186045585 true] [17592186370912 1081 "All the listed" 13194139533449 17592186045585 true] [17592186370912 1083 #edb/ref 17592186045500 13194139533449 17592186045585 true] [17592186370912 1084 #uuid "54efed85-fb73-52bc-8c9d-cb4718ae753f" 13194139533449 17592186045