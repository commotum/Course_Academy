5585 true] [17592186370187 1072 #uuid "4ef04316-d6de-5c0d-a680-25266abf9b77" 13194139533449 17592186045585 true] [17592186370187 1074 "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n{\\begin{aligned}6x-5xy=0 \\\\ -7y+3xy=0\\end{aligned}\n$$\n\nSolving the first equation, we get\n\n$$\n\\begin{aligned}6x-5xy & =0 \\\\ x(6-5y) & =0.\\end{aligned}\n$$\n\nSo, $x=0$ or $y=\\frac{6}{5}.$ We consider both cases separately.\n\n- If $x=0,$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}-7y+3(0)y=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThus, one equilibrium is $(0,0).$\n\n- If $y=\\frac{6}{5},$ substituting it into the second equation, we have\n\n$$\n\\begin{aligned}-7y+3xy & =0 \\\\ y(-7+3x) & =0 \\\\ \\frac{6}{5}(-7+3x) & =0 \\\\ -7+3x & =0 \\\\ x & =\\frac{7}{3}.\\end{aligned}\n$$\n\nThus, another equilibrium is $(\\frac{7}{3},\\frac{6}{5}).$\n\nTherefore, the nonzero equilibrium of the model is\n$(\\frac{7}{3},\\frac{6}{5}).$" 13194139533449 17592186045585 true] [17592186370188 1075 #edb/ref 17592186370189 13194139533449 17592186045585 true] [17592186370188 1076 #edb/ref 17592186045492 13194139533449 17592186045585 true] [17592186370188 1077 "field-1" 13194139533449 17592186045585 true] [17592186370188 1079 #edb/ref 17592186370189 13194139533449 17592186045585 true] [17592186370188 1080 #uuid "4f4acca5-dac1-54fa-9e21-9915bff82215" 13194139533449 17592186045585 true] [17592186370189 1081 "\\frac{7}{3}" 13194139533449 17592186045585 true] [17592186370189 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186370189 1084 #uuid "f7ca91be-1147-5049-8064-d763eb6133e8" 13194139533449 17592186045585 true] [17592186370190 1075 #edb/ref 17592186370191 13194139533449 17592186045585 true] [17592186370190 1076 #edb/ref 17592186045492 13194139533449 17592186045585 true] [17592186370190 1077 "field-2" 13194139533449 17592186045585 true] 