5 true] [17592186371132 1072 #uuid "ee920ebf-0af3-5dda-9562-a67bd29e2941" 13194139533449 17592186045585 true] [17592186371132 1074 "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (3{t}^{2}-2t-3)\\text{d} \\\\  & ={t}^{3}-{t}^{2}-3t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(3)=6.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}6 & =(3)^{3}-(3)^{2}-3(3)+C \\\\ 6 & =27-9-9+C \\\\ C & =-3.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)={t}^{3}-{t}^{2}-3t-3.$" 13194139533449 17592186045585 true] [17592186371133 1075 #edb/ref 17592186371134 13194139533449 17592186045585 true] [17592186371133 1075 #edb/ref 17592186371135 13194139533449 17592186045585 true] [17592186371133 1075 #edb/ref 17592186371136 13194139533449 17592186045585 true] [17592186371133 1075 #edb/ref 17592186371137 13194139533449 17592186045585 true] [17592186371133 1075 #edb/ref 17592186371138 13194139533449 17592186045585 true] [17592186371133 1076 #edb/ref 17592186045493 13194139533449 17592186045585 true] [17592186371133 1077 "selection" 13194139533449 17592186045585 true] [17592186371133 1079 #edb/ref 17592186371134 13194139533449 17592186045585 true] [17592186371133 1080 #uuid "2900c07a-1b7b-502b-b391-aef3475476b9" 13194139533449 17592186045585 true] [17592186371134 1081 "v(t)={t}^{3}-{t}^{2}-3t-3" 13194139533449 17592186045585 true] [17592186371134 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186371134 1084 #uuid "7f13f274-9613-563c-95b7-911dbca041c8" 13194139533449 17592186045585 true] [17592186371135 1081 "v(t)={t}^{3}-2{t}^{2}-t" 13194139533449 17592186045585 true] [17592186371135 1083 #edb/ref 17592186045499 13194139533449 17592186045585 true] [17592186371135 1084 #uuid "67d2a46e-69c5-58fb-9cb7-127ba6e6ad99" 13194139533449 17592186045585 true] [17592186371136 1081 "v(t)={t}^{3}-{t}^{2}-3t-12" 131941395