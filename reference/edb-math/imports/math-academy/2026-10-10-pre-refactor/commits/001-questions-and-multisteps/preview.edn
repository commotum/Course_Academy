86045585 true] [17592186362529 1084 #uuid "5495b539-0a8f-543e-8676-a5e5d4981a60" 13194139533445 17592186045585 true] [17592186362530 1068 #edb/ref 17592186362531 13194139533445 17592186045585 true] [17592186362530 1069 "q-168624" 13194139533445 17592186045585 true] [17592186362530 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186362530 1071 "$∇\\cdot G=\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}" 13194139533445 17592186045585 true] [17592186362530 1072 #uuid "82bf21ed-f804-5bd0-8b8b-a11ec7e6dab6" 13194139533445 17592186045585 true] [17592186362530 1074 "If $G=P\\,\\text{i}+Q\\,\\text{j}+R\\,\\text{k}$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $G$ all exist, then the divergence of $G$ is the scalar field given by\n\n$$\n∇\\cdot G=\\text{div}\\,G=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot G & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(0)+\\frac{∂}{∂y}(0)+\\frac{∂}{∂z}(-xy-2{z}^{2}) \\\\  & =-4z.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362531 1075 #edb/ref 17592186362532 13194139533445 17592186045585 true] [17592186362531 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362531 1077 "field-1" 13194139533445 17592186045585 true] [17592186362531 1079 #edb/ref 17592186362532 13194139533445 17592186045585 true] [17592186362531 1080 #uuid "1e2b5331-a4e0-527d-b59c-5d4964d4f87a" 13194139533445 17592186045585 true] [17592186362532 1081 "-4z" 13194139533445 17592186045585 true] [17592186362532 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362532 1084 #uuid "575f8899-a543-5ab8-8962-53939ce1cefe" 13194139533445 17592186045585 true] [17592186362533 1068 #edb/ref 17592186362534 13194139533445 17592186045585 true] [17592186362533 1069 "q-168627" 13194139533445 17592186045585 true] [17592186362533 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186362533 1071 "The flux of $G$ through the duct surface is$\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." 13194139533445 17592186045585 true] [17592186362533 1072 #uuid "358104ea-eaad-5a15-86b6-df0552400d81" 13194139533445 17592186045585 true] [17592186362533 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $G$ is a continuous vector field, then the flux of $G$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}G\\cdot \\,\\text{d}S={∬}_{S}G\\cdot n\\,\\text{d}S.\n$$\n\nNotice that only the $z$-component of $G=⟨0,0,-xy-2{z}^{2}⟩$ is non-zero. Since the lateral sides of $S$ are parallel to the $z$-axis, the flux of $G$ through $S$ will be non-zero only at the top and bottom sides.\n\n![](images/9e/9e894018baf5f651e2d43cb48a324a5470c9061e6da10f666978519b3bff4c7f.png)\n\nLet's consider the flux of $G$ through these two sides.\n\n* Let ${S}_{1}$ denote the top surface. On this surface, we have $z=4$ for $0\\le x\\le 2$ and $0\\le y\\le 2.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=4$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}G\\cdot {n}_{1} & =⟨0,\\,0,\\,-xy-2{z}^{2}⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨0,\\,0,\\,-xy-32⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =-xy-32.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $G$ across ${S}_{1}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}G\\cdot \\text{d}{S}_{1} & ={∬}_{{S}_{1}}G\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}(-xy-32)\\,\\text{d}S \\\\  & =-{∬}_{D}(xy+32)\\,\\text{d}A \\\\  & =-{\\int }_{0}^{2}{\\int }_{0}^{2}(xy+32)\\,\\text{d}x\\,\\text{d}y \\\\  & =-{\\int }_{0}^{2}{[\\frac{1}{2}{x}^{2}y+32x]}_{x=0}^{x=2}\\,\\text{d}y \\\\  & =-{\\int }_{0}^{2}(2y+64)\\,\\text{d}y \\\\  & =-{[{y}^{2}+64y]}_{y=0}^{y=2} \\\\  & =-132.\\end{aligned}\n$$\n\n* Let ${S}_{2}$ denote the bottom surface. On this surface, we have $z=0$ for $0\\le x\\le 2$ and $0\\le y\\le 2.$ The outward-pointing unit normal vector to ${S}_{2}$ is\n\n$$\n{n}_{2}=⟨0,\\,0,\\,-1⟩.\n$$\n\nUsing the fact that $z=0$ on ${S}_{2},$ we have\n\n$$\n\\begin{aligned}G\\cdot {n}_{2} & =⟨0,\\,0,\\,-xy-2{z}^{2}⟩\\cdot ⟨0,\\,0,\\,-1⟩ \\\\  & =⟨0,\\,0,\\,-xy⟩\\cdot ⟨0,\\,0,\\,-1⟩ \\\\  & =xy.\\end{aligned}\n$$\n\nTherefore, we can calculate the flux of $G$ across ${S}_{2}$ as follows:\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}G\\cdot \\text{d}{S}_{2} & ={∬}_{{S}_{2}}G\\cdot {n}_{2}\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}xy\\,\\text{d}S \\\\  & ={∬}_{D}xy\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}xy\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}x\\,\\text{d}x\\cdot {\\int }_{0}^{2}y\\,\\text{d}y \\\\  & ={[\\frac{1}{2}{x}^{2}]}_{x=0}^{x=2}\\cdot {[\\frac{1}{2}{y}^{2}]}_{y=0}^{y=2} \\\\  & =2\\cdot 2 \\\\  & =4\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}G\\cdot \\text{d}S & ={∬}_{S}G\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}G\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}G\\cdot n\\,\\text{d}S \\\\  & =-132+4 \\\\  & =-128.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362534 1075 #edb/ref 17592186362535 13194139533445 17592186045585 true] [17592186362534 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362534 1077 "field-1" 13194139533445 17592186045585 true] [17592186362534 1079 #edb/ref 17592186362535 13194139533445 17592186045585 true] [17592186362534 1080 #uuid "810d80f0-caf3-5923-a0a0-ee211445f690" 13194139533445 17592186045585 true] [17592186362535 1081 "-128" 13194139533445 17592186045585 true] [17592186362535 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362535 1084 #uuid "d5f60037-9e3d-54bb-a440-952c5cda1375" 13194139533445 17592186045585 true] [17592186362536 1068 #edb/ref 17592186362537 13194139533445 17592186045585 true] [17592186362536 1069 "q-168628" 13194139533445 17592186045585 true] [17592186362536 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186362536 1071 "${∭}_{R}∇\\cdot G\\,\\text{d}V=\\,$\n\n                            \n                                    \n                            \n                                        {{field-1}}" 13194139533445 17592186045585 true] [17592186362536 1072 #uuid "1bdbbeea-ac76-53f1-b3ec-2464f8f2c694" 13194139533445 17592186045585 true] [17592186362536 1074 "We have $∇\\cdot G=-4z.$\nFirst, we express our triple integral as a repeated integral:\n\n$$\n{∭}_{R}∇\\cdot G\\,\\text{d}V={\\int }_{0}^{4}{\\int }_{0}^{2}{\\int }_{0}^{2}-4z\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\nSince the domain of integration $R=[0,2]\\times [0,2]\\times [0,4]$ is a rectangular box, and the integrand can be expressed as $f(x)\\cdot g(y)\\cdot h(z),$ we can rewrite our repeated integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}{\\int }_{0}^{2}{\\int }_{0}^{2}-4z\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z & ={\\int }_{0}^{4}{\\int }_{0}^{2}{\\int }_{0}^{2}-2\\cdot 2z\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z \\\\  & =-2{\\int }_{0}^{2}\\,\\text{d}x{\\int }_{0}^{2}\\,\\text{d}y{\\int }_{0}^{4}2z\\,\\text{d}z\\end{aligned}\n$$\n\nEvaluating each integral separately, we get\n\n$$\n\\begin{aligned}-2{\\int }_{0}^{2}\\,\\text{d}x{\\int }_{0}^{2}\\,\\text{d}y{\\int }_{0}^{4}2z\\,\\text{d}z & =-2[x]_{0}^{2}\\cdot [y]_{0}^{2}\\cdot [{z}^{2}]_{0}^{4} \\\\  & =-2\\cdot (2-0)\\cdot (2-0)\\cdot (16-0) \\\\  & =-128.\\end{aligned}\n$$\n\n**Note**: This is equal to the answer found in step 2. This is not a coincidence! It is a consequence of the so-called divergence theorem. If you haven't met the divergence theorem yet, don't worry, you will soon." 13194139533445 17592186045585 true] [17592186362537 1075 #edb/ref 17592186362538 13194139533445 17592186045585 true] [17592186362537 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362537 1077 "field-1" 13194139533445 17592186045585 true] [17592186362537 1079 #edb/ref 17592186362538 13194139533445 17592186045585 true] [17592186362537 1080 #uuid "afef43c5-6e66-5072-b649-91851ae1cc4c" 13194139533445 17592186045585 true] [17592186362538 1081 "-128" 13194139533445 17592186045585 true] [17592186362538 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362538 1084 #uuid "5cf8205f-5ed8-5624-83ac-4306e219b1f5" 13194139533445 17592186045585 true] [17592186362539 1068 #edb/ref 17592186362540 13194139533445 17592186045585 true] [17592186362539 1069 "q-169201" 13194139533445 17592186045585 true] [17592186362539 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186362539 1071 "$\\text{div}\\,F\\,=$\n\n                            \n                                    \n                            \n                                        {{field-1}}" 13194139533445 17592186045585 true] [17592186362539 1072 #uuid "5a60d2ff-f3ca-50d0-ba00-1dd849742b3e" 13194139533445 17592186045585 true] [17592186362539 1074 "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(3x{y}^{2})+\\frac{∂}{∂y}(-{y}^{3}) \\\\  & =3{y}^{2}+(-3{y}^{2}) \\\\  & =0.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362540 1075 #edb/ref 17592186362541 13194139533445 17592186045585 true] [17592186362540 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362540 1077 "field-1" 13194139533445 17592186045585 true] [17592186362540 1079 #edb/ref 17592186362541 13194139533445 17592186045585 true] [17592186362540 1080 #uuid "70813cd7-ac85-5b7a-93e7-231b03c0abe9" 13194139533445 17592186045585 true] [17592186362541 1081 "0" 13194139533445 17592186045585 true] [17592186362541 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362541 1084 #uuid "d6f39474-a71d-5b92-bb95-057f421dbaa3" 13194139533445 17592186045585 true] [17592186362542 1068 #edb/ref 17592186362543 13194139533445 17592186045585 true] [17592186362542 1069 "q-169202" 13194139533445 17592186045585 true] [17592186362542 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186362542 1071 "The scalar curl of $F$ is\n\n                            \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        ." 13194139533445 17592186045585 true] [17592186362542 1072 #uuid "e244d7dd-417f-51de-bb65-cf4cf4f73429" 13194139533445 17592186045585 true] [17592186362542 1074 "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(-{y}^{3})-\\frac{∂}{∂y}(3x{y}^{2}) \\\\  & =0-(3x\\cdot 2y) \\\\  & =-6xy.\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362543 1075 #edb/ref 17592186362544 13194139533445 17592186045585 true] [17592186362543 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362543 1077 "field-1" 13194139533445 17592186045585 true] [17592186362543 1079 #edb/ref 17592186362544 13194139533445 17592186045585 true] [17592186362543 1080 #uuid "e71f8d4b-84bb-5e5f-b15b-3ca03cb3cddb" 13194139533445 17592186045585 true] [17592186362544 1081 "-6xy" 13194139533445 17592186045585 true] [17592186362544 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362544 1084 #uuid "b80ad287-ac84-5ca1-86d0-c5e6390eb3d1" 13194139533445 17592186045585 true] [17592186362545 1068 #edb/ref 17592186362546 13194139533445 17592186045585 true] [17592186362545 1069 "q-169203" 13194139533445 17592186045585 true] [17592186362545 1070 #edb/ref 17592186045485 13194139533445 17592186045585 true] [17592186362545 1071 "Use Green's theorem to write down the integral that gives the circulation of $F$ along the border $C$ of the plot $D,$ shown in the diagram above.\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        Circulation $\\,={∮}_{C}^{}F\\cdot \\text{d}r={∬}_{D}\\,$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,\\text{d}A.$" 13194139533445 17592186045585 true] [17592186362545 1072 #uuid "231df40f-8e86-536b-af50-43d6f14cbda6" 13194139533445 17592186045585 true] [17592186362545 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}{{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{⏟}}_{\\text{Scalar curl of }F}\\,\\text{d}A.\n$$\n\nFirst, notice that we can rewrite our integral as follows:\n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}{{(3x{y}^{2})}_{⏟}}_{P}\\,dx+{{(-{y}^{3})}_{⏟}}_{Q}\\,dy\n$$\n\nIn part 2, we found that the scalar curl of $F$ is\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-6xy.\\end{aligned}\n$$\n\nTherefore, by applying Green's Theorem, we get\n\n$$\n{∮}_{C}F\\cdot \\text{d}r={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A={∬}_{D}-6xy\\,\\text{d}A.\n$$" 13194139533445 17592186045585 true] [17592186362546 1075 #edb/ref 17592186362547 13194139533445 17592186045585 true] [17592186362546 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362546 1077 "field-1" 13194139533445 17592186045585 true] [17592186362546 1079 #edb/ref 17592186362547 13194139533445 17592186045585 true] [17592186362546 1080 #uuid "02bbd186-1d4e-5461-bc79-ce35c2890910" 13194139533445 17592186045585 true] [17592186362547 1081 "-6xy" 13194139533445 17592186045585 true] [17592186362547 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362547 1084 #uuid "5190752e-a1c8-5dd8-b834-158e58825739" 13194139533445 17592186045585 true] [17592186362548 1068 #edb/ref 17592186362549 13194139533445 17592186045585 true] [17592186362548 1068 #edb/ref 17592186362551 13194139533445 17592186045585 true] [17592186362548 1068 #edb/ref 17592186362553 13194139533445 17592186045585 true] [17592186362548 1069 "q-169204" 13194139533445 17592186045585 true] [17592186362548 1070 #edb/ref 17592186045487 13194139533445 17592186045585 true] [17592186362548 1071 "Write down the double integral from the previous part in polar coordinates.\n\n                            \n                                    \n                                        \n                                            \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        ${∬}_{D}-6xy\\,\\text{d}A\\,={\\int }_{\\pi /2}^{a}\\,{\\int }_{0}^{b}$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-1}}                \n                                    \n                                \n                                    \n                                        \n                                        \n$\\,\\text{d}r\\,\\text{d}\\theta ,$\n\n                                    \n                                \n                                    \n                                        \n                                                \n\n                                                \n\n                                        \n                                        \n                                        \n\n                                    \n                                \n                                    \n                                        \n                                        where $a\\,=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-2}}                \n                                    \n                                \n                                    \n                                        \n                                        \nand $b\\,=$\n\n                                    \n                                \n                                    \n                            \n                                        {{field-3}}                \n                                    \n                                \n                                    \n                                        \n                                        ." 13194139533445 17592186045585 true] [17592186362548 1072 #uuid "8131655d-848c-5eb2-a4f8-11a5d73df386" 13194139533445 17592186045585 true] [17592186362548 1074 "Notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,\\frac{\\pi }{2}\\le \\theta \\le 2\\pi }.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}-6xy\\,\\text{d}A & ={∬}_{Δ}-6(r\\operatorname{cos}⁡\\theta )(r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}-3{r}^{3}(2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{2\\pi }\\,{\\int }_{0}^{2}-3{r}^{3}\\operatorname{sin}⁡(2\\theta )\\,dr\\,d\\theta .\\end{aligned}\n$$" 13194139533445 17592186045585 true] [17592186362549 1075 #edb/ref 17592186362550 13194139533445 17592186045585 true] [17592186362549 1076 #edb/ref 17592186045492 13194139533445 17592186045585 true] [17592186362549 1077 "field-1" 13194139533445 17592186045585 true] [17592186362549 1079 #edb/ref 17592186362550 13194139533445 17592186045585 true] [17592186362549 1080 #uuid "ff34a1ff-5130-50fc-a7fd-b6423f4c353f" 13194139533445 17592186045585 true] [17592186362550 1081 "-3{r}^{3}\\operatorname{sin}(2\\theta )" 13194139533445 17592186045585 true] [17592186362550 1083 #edb/ref 17592186045499 13194139533445 17592186045585 true] [17592186362550 1084 #uuid "96e5a3