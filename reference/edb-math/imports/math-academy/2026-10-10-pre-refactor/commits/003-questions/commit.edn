ned}]\\cdot [\\begin{aligned}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}1 & 2 & 1 \\\\ 2 & -1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 3 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{aligned}]\\cdot {[\\begin{aligned}6 & 2 \\\\ 2 & 9\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{aligned}]\\cdot \\frac{1}{50}[\\begin{aligned}9 & -2 \\\\ -2 & 6\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ -7\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 \\\\ 2 & -1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 3 \\\\ -1\\end{aligned}]\\end{aligned}\n$$" 13194139533447 17592186045585 true] [17592186365178 1075 #edb/ref 17592186365179 13194139533447 17592186045585 true] [17592186365178 1075 #edb/ref 17592186365180 13194139533447 17592186045585 true] [17592186365178 1075 #edb/ref 17592186365181 13194139533447 17592186045585 true] [17592186365178 1075 #edb/ref 17592186365182 13194139533447 17592186045585 true] [17592186365178 1075 #edb/ref 17592186365183 13194139533447 17592186045585 true] [17592186365178 1076 #edb/ref 17592186045493 13194139533447 17592186045585 true] [17592186365178 1077 "selection" 13194139533447 17592186045585 true] [17592186365178 1079 #edb/ref 17592186365179 13194139533447 17592186045585 true] [17592186365178 1080 #uuid "80f414bd-ce38-5f46-a4ae-f2f0ad8e10ac" 13194139533447 17592186045585 true] [17592186365179 1081 "[\\begin{aligned}-1 \\\\ 3 \\\\ -1\\end{aligned}]" 13194139533447 17592186045585 true] [17592186365179 1083 #edb/ref 17592186045499 13194139533447 17592186045585 true] [17592186365179 1084 #uuid "af4b666c-66b7-59db-a2c7-375a67faef78" 13194139533447 17592186045585 true] [17592186365180 1081 "[\\begin{aligned}3 \\\\ -1 \\\\ 1\\end{aligned}]" 13194139533447 17592186045585 true] [17592186365180 1083 #edb/ref 17592186045499 13194139533447 175