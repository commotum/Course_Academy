}^{18}{\\sum }_{j=1}^{20}(3{a}_{ij}+2{b}_{ij}) & ={\\sum }_{i=1}^{18}{\\sum }_{j=1}^{20}3{a}_{ij}+{\\sum }_{i=1}^{18}{\\sum }_{j=1}^{20}2{b}_{ij} \\\\  & =3{\\sum }_{i=1}^{18}{\\sum }_{j=1}^{20}{a}_{ij}+2{\\sum }_{i=1}^{18}{\\sum }_{j=1}^{20}{b}_{ij} \\\\  & =3\\cdot 50+2\\cdot 20 \\\\  & =150+40 \\\\  & =190.\\end{aligned}\n$$" 13194139533447 17592186045585 true] [17592186365129 1075 #edb/ref 17592186365130 13194139533447 17592186045585 true] [17592186365129 1075 #edb/ref 17592186365131 13194139533447 17592186045585 true] [17592186365129 1075 #edb/ref 17592186365132 13194139533447 17592186045585 true] [17592186365129 1075 #edb/ref 17592186365133 13194139533447 17592186045585 true] [17592186365129 1075 #edb/ref 17592186365134 13194139533447 17592186045585 true] [17592186365129 1076 #edb/ref 17592186045493 13194139533447 17592186045585 true] [17592186365129 1077 "selection" 13194139533447 17592186045585 true] [17592186365129 1079 #edb/ref 17592186365133 13194139533447 17592186045585 true] [17592186365129 1080 #uuid "432c0b07-5250-5b0b-893a-f8142e12e051" 13194139533447 17592186045585 true] [17592186365130 1081 "170" 13194139533447 17592186045585 true] [17592186365130 1083 #edb/ref 17592186045499 13194139533447 17592186045585 true] [17592186365130 1084 #uuid "d7ce3608-c6c6-5124-be7e-c798c1eaf520" 13194139533447 17592186045585 true] [17592186365131 1081 "130" 13194139533447 17592186045585 true] [17592186365131 1083 #edb/ref 17592186045499 13194139533447 17592186045585 true] [17592186365131 1084 #uuid "e0e43d71-6e2f-5d1b-8955-af33091a3185" 13194139533447 17592186045585 true] [17592186365132 1081 "150" 13194139533447 17592186045585 true] [17592186365132 1083 #edb/ref 17592186045499 13194139533447 17592186045585 true] [17592186365132 1084 #uuid "855d4941-c925-54bc-9c7a-c1736df507b1" 13194139533447 17592186045585 true] [17592186365133 1081 "190" 13194139533447 17592186045585 true] [17592186365133 1083 #edb/ref 17592186045499 13194139533447 17592186045585 true] [175921863651