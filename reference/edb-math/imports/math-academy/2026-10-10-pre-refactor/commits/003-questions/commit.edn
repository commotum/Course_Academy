 & 2 \\\\ 1 & -2 & 1\\end{aligned}].\n$$\n\nTherefore, we get the following projection:\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & =[\\begin{aligned}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{aligned}]\\cdot {([\\begin{aligned}2 & 2 & 2 \\\\ 1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{aligned}])}^{-1}\\cdot [\\begin{aligned}2 & 2 & 2 \\\\ 1 & -2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 4 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{aligned}]\\cdot {[\\begin{aligned}12 & 0 \\\\ 0 & 6\\end{aligned}]}^{-1}\\cdot [\\begin{aligned}24 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{12} & 0 \\\\ 0 & \\frac{1}{6}\\end{aligned}]\\cdot [\\begin{aligned}24 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 2 & -2 \\\\ 2 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 4 \\\\ 4\\end{aligned}]\\end{aligned}\n$$" 13194139533447 17592186045585 true] [17592186366118 1075 #edb/ref 17592186366119 13194139533447 17592186045585 true] [17592186366118 1075 #edb/ref 17592186366120 13194139533447 17592186045585 true] [17592186366118 1075 #edb/ref 17592186366121 13194139533447 17592186045585 true] [17592186366118 1075 #edb/ref 17592186366122 13194139533447 17592186045585 true] [17592186366118 1075 #edb/ref 17592186366123 13194139533447 17592186045585 true] [17592186366118 1076 #edb/ref 17592186045493 13194139533447 17592186045585 true] [17592186366118 1077 "selection" 13194139533447 17592186045585 true] [17592186366118 1079 #edb/ref 17592186366123 13194139533447 17592186045585 true] [17592186366118 1080 #uuid "974cc47c-a0cf-5ce6-8700-2a3f5c0bccd1" 13194139533447 17592186045585 true] [17592186366119 1081 "[\\begin{aligned}4 \\\\ 2 \\\\ 6\\end{aligned}]" 13194139533447 17592186045585 true] [17592186366119 1083 #edb/ref 17592186045499 13194139533447 17592186045585 true] [17592186366