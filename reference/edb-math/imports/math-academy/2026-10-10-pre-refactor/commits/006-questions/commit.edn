94139533450 17592186045585 true] [17592186372561 1079 #edb/ref 17592186372562 13194139533450 17592186045585 true] [17592186372561 1080 #uuid "531a12cb-dfd3-5f5c-bcf9-3e2b4d045b60" 13194139533450 17592186045585 true] [17592186372562 1081 "9" 13194139533450 17592186045585 true] [17592186372562 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372562 1084 #uuid "01a7f2e9-66ae-5ad5-97db-62d4ad4a4617" 13194139533450 17592186045585 true] [17592186372563 1075 #edb/ref 17592186372564 13194139533450 17592186045585 true] [17592186372563 1076 #edb/ref 17592186045492 13194139533450 17592186045585 true] [17592186372563 1077 "field-2" 13194139533450 17592186045585 true] [17592186372563 1079 #edb/ref 17592186372564 13194139533450 17592186045585 true] [17592186372563 1080 #uuid "42c2261f-f869-5356-ac57-c19dd8883e30" 13194139533450 17592186045585 true] [17592186372564 1081 "\\frac{\\pi }{2}" 13194139533450 17592186045585 true] [17592186372564 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372564 1084 #uuid "d8196c27-f591-5d56-b748-c1523b6fae72" 13194139533450 17592186045585 true] [17592186372565 1068 #edb/ref 17592186372566 13194139533450 17592186045585 true] [17592186372565 1068 #edb/ref 17592186372568 13194139533450 17592186045585 true] [17592186372565 1069 "q-325164" 13194139533450 17592186045585 true] [17592186372565 1070 #edb/ref 17592186045487 13194139533450 17592186045585 true] [17592186372565 1071 "Find the **polar coordinates** of the point where the polar curve $r=\\frac{17}{4}$ intersects the negative $x$-axis. Express the polar angle in radians.\n\nThe point of intersection in polar coordinates is $(${{field-1}}$,$\n{{field-2}}$).$" 13194139533450 17592186045585 true] [17592186372565 1072 #uuid "034fe411-738e-5503-bf83-03678760f7c0" 13194139533450 17592186045585 true] [17592186372565 1074 "The polar curve $r=\\frac{17}{4}$ is a circle of radius $\\frac{17}{4}$ centered at the origin. It crosses the negative $x$-axis where $r=\\frac{17}{4}$ and $\\theta =\\pi .$\n\n![](images/65/652a619b125a7d26cf7cb53b254ac18858204a8972efe2d0383fbd4a81d66b0c.png)\n\nTherefore, the point of intersection in polar coordinates is $(\\,\\frac{17}{4},\\pi ).$" 13194139533450 17592186045585 true] [17592186372566 1075 #edb/ref 17592186372567 13194139533450 17592186045585 true] [17592186372566 1076 #edb/ref 17592186045492 13194139533450 17592186045585 true] [17592186372566 1077 "field-2" 13194139533450 17592186045585 true] [17592186372566 1079 #edb/ref 17592186372567 13194139533450 17592186045585 true] [17592186372566 1080 #uuid "2246f6da-3935-5856-88c2-7b5010c4916a" 13194139533450 17592186045585 true] [17592186372567 1081 "\\pi " 13194139533450 17592186045585 true] [17592186372567 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372567 1084 #uuid "624094c1-41e0-5177-85f1-ea933d6f1345" 13194139533450 17592186045585 true] [17592186372568 1075 #edb/ref 17592186372569 13194139533450 17592186045585 true] [17592186372568 1076 #edb/ref 17592186045492 13194139533450 17592186045585 true] [17592186372568 1077 "field-1" 13194139533450 17592186045585 true] [17592186372568 1079 #edb/ref 17592186372569 13194139533450 17592186045585 true] [17592186372568 1080 #uuid "69845b52-3fb5-5d53-abf0-e9ab05f6dc9b" 13194139533450 17592186045585 true] [17592186372569 1081 "\\frac{17}{4}" 13194139533450 17592186045585 true] [17592186372569 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372569 1084 #uuid "8d49f7db-8d84-52ed-892f-18223ef2099c" 13194139533450 17592186045585 true] [17592186372570 1068 #edb/ref 17592186372571 13194139533450 17592186045585 true] [17592186372570 1069 "q-325181" 13194139533450 17592186045585 true] [17592186372570 1070 #edb/ref 17592186045487 13194139533450 17592186045585 true] [17592186372570 1071 "The polar equation of the circle that is centered at the origin and that passes through the point $A(-12,16)$ is$\\,\\,r=$\n{{field-1}}." 13194139533450 17592186045585 true] [17592186372570 1072 #uuid "d7d23311-b6b2-5da4-8f68-e5997a022d16" 13194139533450 17592186045585 true] [17592186372570 1074 "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-12)^{2}+{16}^{2}} \\\\  & =\\sqrt{144+256} \\\\  & =\\sqrt{400} \\\\  & =20\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=20.$" 13194139533450 17592186045585 true] [17592186372571 1075 #edb/ref 17592186372572 13194139533450 17592186045585 true] [17592186372571 1076 #edb/ref 17592186045492 13194139533450 17592186045585 true] [17592186372571 1077 "field-1" 13194139533450 17592186045585 true] [17592186372571 1079 #edb/ref 17592186372572 13194139533450 17592186045585 true] [17592186372571 1080 #uuid "9f78dd86-df54-5541-9c9c-8b4605e08f8a" 13194139533450 17592186045585 true] [17592186372572 1081 "20" 13194139533450 17592186045585 true] [17592186372572 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372572 1084 #uuid "75d0a2dd-0fa7-55ca-9691-99226b2ba231" 13194139533450 17592186045585 true] [17592186372573 1068 #edb/ref 17592186372574 13194139533450 17592186045585 true] [17592186372573 1068 #edb/ref 17592186372576 13194139533450 17592186045585 true] [17592186372573 1069 "q-325862" 13194139533450 17592186045585 true] [17592186372573 1070 #edb/ref 17592186045485 13194139533450 17592186045585 true] [17592186372573 1071 "Calculate the point where the ellipse $\\frac{(x+4)^{2}}{6}+\\frac{(y-3)^{2}}{9}=1$ intercepts the $x$-axis.\n\nThe $x$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" 13194139533450 17592186045585 true] [17592186372573 1072 #uuid "390bc5bc-70e4-5b0d-ba49-6bf0b808479e" 13194139533450 17592186045585 true] [17592186372573 1074 "To calculate the $x$-intercept, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equatio