j}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-18)\\cdot (-2)+(-16)\\cdot 2+1\\cdot 4}{(-2)^{2}+{2}^{2}+{4}^{2}}v=\\frac{1}{3}[\\begin{aligned}-2 \\\\ 2 \\\\ 4\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-18)\\cdot (-3)+(-16)\\cdot 3+1\\cdot (-3)}{(-3)^{2}+{3}^{2}+(-3)^{2}}w=\\frac{1}{9}[\\begin{aligned}-3 \\\\ 3 \\\\ -3\\end{aligned}]=\\frac{1}{3}[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{3}[\\begin{aligned}-2 \\\\ 2 \\\\ 4\\end{aligned}]+\\frac{1}{3}[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =\\frac{1}{3}([\\begin{aligned}-2 \\\\ 2 \\\\ 4\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]) \\\\  & =[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$" 13194139533450 17592186045585 true] [17592186373285 1075 #edb/ref 17592186373286 13194139533450 17592186045585 true] [17592186373285 1075 #edb/ref 17592186373287 13194139533450 17592186045585 true] [17592186373285 1075 #edb/ref 17592186373288 13194139533450 17592186045585 true] [17592186373285 1075 #edb/ref 17592186373289 13194139533450 17592186045585 true] [17592186373285 1075 #edb/ref 17592186373290 13194139533450 17592186045585 true] [17592186373285 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186373285 1077 "selection" 13194139533450 17592186045585 true] [17592186373285 1079 #edb/ref 17592186373289 13194139533450 17592186045585 true] [17592186373285 1080 #uuid "5446889c-4194-56bc-877f-e62dc48f37d5" 13194139533450 17592186045585 true] [17592186373286 1081 "[\\begin{aligned}-5 \\\\ 5 \\\\ 1\\end{aligned}]" 13194139533450 17592186045585 true] [17592186373286 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186373286 1084 #uuid "9cd5d909-284c-501b-b2c9-da1c869a1f81" 13194139533450 17592186045585 true] [17592186373287 