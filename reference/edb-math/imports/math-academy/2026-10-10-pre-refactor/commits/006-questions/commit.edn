gned}\n$$" 13194139533450 17592186045585 true] [17592186372608 1075 #edb/ref 17592186372609 13194139533450 17592186045585 true] [17592186372608 1075 #edb/ref 17592186372610 13194139533450 17592186045585 true] [17592186372608 1075 #edb/ref 17592186372611 13194139533450 17592186045585 true] [17592186372608 1075 #edb/ref 17592186372612 13194139533450 17592186045585 true] [17592186372608 1075 #edb/ref 17592186372613 13194139533450 17592186045585 true] [17592186372608 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186372608 1077 "selection" 13194139533450 17592186045585 true] [17592186372608 1079 #edb/ref 17592186372613 13194139533450 17592186045585 true] [17592186372608 1080 #uuid "0fa3d86a-d8d4-5dbe-af89-392fd61ba4e2" 13194139533450 17592186045585 true] [17592186372609 1081 "{e}^{2s}\\cdot \\frac{2\\pi }{{s}^{2}+4{\\pi }^{2}}" 13194139533450 17592186045585 true] [17592186372609 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372609 1084 #uuid "0ef9498e-7be2-53e3-8542-6160c2719c63" 13194139533450 17592186045585 true] [17592186372610 1081 "{e}^{-2s}\\cdot \\frac{2\\pi }{{s}^{2}+4{\\pi }^{2}}" 13194139533450 17592186045585 true] [17592186372610 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372610 1084 #uuid "77a046f1-fce6-573f-ace4-8a1f0c57d568" 13194139533450 17592186045585 true] [17592186372611 1081 "{e}^{2s}\\cdot \\frac{s}{{s}^{2}+4{\\pi }^{2}}" 13194139533450 17592186045585 true] [17592186372611 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372611 1084 #uuid "738bd2a4-8e47-5a02-a7f1-6bbdea3087f1" 13194139533450 17592186045585 true] [17592186372612 1081 "{e}^{2s}\\cdot \\frac{\\pi }{{s}^{2}+4}" 13194139533450 17592186045585 true] [17592186372612 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372612 1084 #uuid "318f8a57-21a6-5c6f-85ac-a7338c318e42" 13194139533450 17592186045585 true] [17592186372613 1081 "{e}^{-2s}\\cdot \\frac{s}{{s}^{2}