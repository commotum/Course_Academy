x})\\,k \\\\  & =({e}^{y}+z{e}^{x})\\,i+(x{e}^{y}+{e}^{z})\\,j+(y{e}^{z}+{e}^{x})\\,k \\\\ ∇f(0,0,1) & =({e}^{0}+(1){e}^{0})i+((0){e}^{0}+{e}^{1})j+((0){e}^{1}+{e}^{0})k \\\\  & =2\\,i+e\\,j+k\\end{aligned}\n$$\n\nTherefore, $2\\,i+e\\,j+k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(0,0,1).$" 13194139533450 17592186045585 true] [17592186371756 1075 #edb/ref 17592186371757 13194139533450 17592186045585 true] [17592186371756 1075 #edb/ref 17592186371758 13194139533450 17592186045585 true] [17592186371756 1075 #edb/ref 17592186371759 13194139533450 17592186045585 true] [17592186371756 1075 #edb/ref 17592186371760 13194139533450 17592186045585 true] [17592186371756 1075 #edb/ref 17592186371761 13194139533450 17592186045585 true] [17592186371756 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186371756 1077 "selection" 13194139533450 17592186045585 true] [17592186371756 1079 #edb/ref 17592186371757 13194139533450 17592186045585 true] [17592186371756 1080 #uuid "30f4d423-1557-5b46-a95f-3cf4f20875a3" 13194139533450 17592186045585 true] [17592186371757 1081 "2\\,i+e\\,j+k" 13194139533450 17592186045585 true] [17592186371757 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371757 1084 #uuid "421dd9cb-d37a-51b2-bf54-7fecaeaa111e" 13194139533450 17592186045585 true] [17592186371758 1081 "e\\,i+j+k" 13194139533450 17592186045585 true] [17592186371758 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371758 1084 #uuid "40e107dd-903b-532c-a936-fd8a0507a6f9" 13194139533450 17592186045585 true] [17592186371759 1081 "2\\,i+j+e\\,k" 13194139533450 17592186045585 true] [17592186371759 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371759 1084 #uuid "62840a4a-671f-55d2-ae1f-8ee90cadeddf" 13194139533450 17592186045585 true] [17592186371760 1081 "i+e\\,j+2\\,k" 13194139533450 17592186045585 true] [17592186371760 1083 #edb/ref 17592186045499 131941395