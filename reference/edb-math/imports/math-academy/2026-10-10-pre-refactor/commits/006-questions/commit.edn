\,\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩$\nfrom $t=0$ to $t=1.$" 13194139533450 17592186045585 true] [17592186371727 1072 #uuid "0760b1bf-45a5-5aed-9a7d-860971967403" 13194139533450 17592186045585 true] [17592186371727 1074 "First, we find ${r}^{′}(t)$ and $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t))⟩ \\\\  & =⟨1,\\,\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(1)}^{2}+{(\\operatorname{cos}⁡t)}^{2}+{(-\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\sqrt{1+{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{1}‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{2}\\,\\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{1}\\text{d}t \\\\  & =\\sqrt{2}t\\,{|}_{0}^{1} \\\\  & =\\sqrt{2}(1-0) \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" 13194139533450 17592186045585 true] [17592186371728 1075 #edb/ref 17592186371729 13194139533450 17592186045585 true] [17592186371728 1075 #edb/ref 17592186371730 13194139533450 17592186045585 true] [17592186371728 1075 #edb/ref 17592186371731 13194139533450 17592186045585 true] [17592186371728 1075 #edb/ref 17592186371732 13194139533450 17592186045585 true] [17592186371728 1075 #edb/ref 17592186371733 13194139533450 17592186045585 true] [17592186371728 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186371728 1077 "selection" 13194139533450 17592186045585 true] [17592186371728 1079 #edb/ref 17592186371729 13194139533450 17592186045585 true] [17592186371728 1080 #uuid "af468363-83b9-5ccc-8120-0215969486e5" 13194139533450 17592186045585 true] [17592186371729 1081 "\\sqrt{2}" 13194139533450 17592186045585 true] [17592186371729 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371729 1084 #uuid "a0c3c144-342c-568c-8008-dfc3bbf3e55b" 13194139533450 17592186045585 true] [17592186371730 1081 "\\pi -1" 13194139533450 17592186045585 true] [17592186371730 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371730 1084 #uuid "819bb05a-265c-5492-a6f2-63e69e3366e0" 13194139533450 17592186045585 true] [17592186371731 1081 "2\\sqrt{2}-1" 13194139533450 17592186045585 true] [17592186371731 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371731 1084 #uuid "7cc99bc0-2cfc-57b8-ad76-ee0deba98fe7" 13194139533450 17592186045585 true] [17592186371732 1081 "2\\pi " 13194139533450 17592186045585 true] [17592186371732 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371732 1084 #uuid "9773cc34-e79f-5a4a-b9ef-d818a89d1a1e" 13194139533450 17592186045585 true] [17592186371733 1081 "\\frac{\\sqrt{2}}{2}" 13194139533450 17592186045585 true] [17592186371733 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371733 1084 #uuid "e1a2a18e-b24b-5257-8c86-2b702af0f038" 13194139533450 17592186045585 true] [17592186371734 1068 #edb/ref 17592186371735 13194139533450 17592186045585 true] [17592186371734 1069 "q-127636" 13194139533450 17592186045585 true] [17592186371734 1070 #edb/ref 17592186045485 13194139533450 17592186045585 true] [17592186371734 1071 "Find the binormal vector to the curve $r(t)$ at the point $t=0$, given that\n\n$$\n\\begin{aligned}T(0) & =\\frac{1}{\\sqrt{2}}⟨1,0,1⟩, \\\\ N(0) & =\\frac{1}{\\sqrt{2}}⟨1,0,-1⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." 13194139533450 17592186045585 true] [17592186371734 1072 #uuid "6cb21c0a-bd82-5807-b606-1f7c2d34babf" 13194139533450 17592186045585 true] [17592186371734 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(0) & =T(0)\\times N(0) \\\\  & =\\frac{1}{\\sqrt{2}}⟨1,0,1⟩\\times \\frac{1}{\\sqrt{2}}⟨1,0,-1⟩ \\\\  & =\\frac{1}{2}\\left|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 1 & 0 & -1\\end{aligned}\\right| \\\\  & =\\frac{1}{2}[\\text{ }\\left|\\begin{aligned}0 & 1 \\\\ 0 & -1\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}1 & 0 \\\\ 1 & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{2}⟨(0-0),-(-1-1),(0-0)⟩ \\\\  & =\\frac{1}{2}⟨0,2,0⟩ \\\\  & =⟨0,1,0⟩.\\end{aligned}\n$$" 13194139533450 17592186045585 true] [17592186371735 1075 #edb/ref 17592186371736 13194139533450 17592186045585 true] [17592186371735 1075 #edb/ref 17592186371737 13194139533450 17592186045585 true] [17592186371735 1075 #edb/ref 17592186371738 13194139533450 17592186045585 true] [17592186371735 1075 #edb/ref 17592186371739 13194139533450 17592186045585 true] [17592186371735 1075 #edb/ref 17592186371740 13194139533450 17592186045585 true] [17592186371735 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186371735 1077 "selection" 13194139533450 17592186045585 true] [17592186371735 1079 #edb/ref 17592186371739 13194139533450 17592186045585 true] [17592186371735 1080 #uuid "3afa03db-10c3-5407-b4e7-1007b155e939" 13194139533450 17592186045585 true] [17592186371736 1081 "\\frac{1}{3}⟨-1,0,\\sqrt{2}⟩" 13194139533450 17592186045585 true] [17592186371736 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371736 1084 #uuid "a4f02123-2ec0-5a51-80b4-245d356041ec" 13194139533450 17592186045585 true] [17592186371737 1081 "\\frac{1}{3}⟨\\sqrt{2},1,0⟩" 13194139533450 17592186045585 true] [17592186371737 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371737 1084 #uuid "5eb42ea6-bf60-54c3-9df0-862b1ecd36fa" 13194139533450 17592186045585 true] [17592186371738 1081 "\\frac{1}{\\sqrt{2}}⟨0,1,1⟩" 13194139533450 17592186045585 true] [17592186371738 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371738 1084 #uuid "846f6992-61d4-5a44-9323-422738e64be6" 13194139533450 17592186045585 true] [17592186371739 1081 "⟨0,1,0⟩" 13194139533450 17592186045585 true] [17592186371739 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371739 1084 #uuid "9e3180da-3e30-5444-8b8c-46e4c260905f" 13194139533450 17592186045585 true] [17592186371740 1081 "\\frac{1}{\\sqrt{3}}⟨-1,1,1⟩" 13194139533450 17592186045585 true] [17592186371740 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371740 1084 #uuid "ec93a694-ec31-59e2-8609-b33561329583" 13194139533450 17592186045585 true] [17592186371741 1068 #edb/ref 17592186371742 13194139533450 17592186045585 true] [17592186371741 1069 "q-129059" 13194139533450 17592186045585 true] [17592186371741 1070 #edb/ref 17592186045487 13194139533450 17592186045585 true] [17592186371741 1071 "The level curves of the function $f(x,y)=\\frac{x+y}{x}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=-1$ gives the $x$-axis, excluding the origin\n- $c=0$ gives the $y$-axis, excluding the origin\n- $c=1$ gives the line $y=x,$ excluding the origin" 13194139533450 17592186045585 true] [17592186371741 1072 #uuid "ac11e3e9-cb1c-5541-98a0-caa6e8b5b278" 13194139533450 17592186045585 true] [17592186371741 1074 "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{x+y}{x} & =c \\\\ x+y & =cx \\\\ y & =(c-1)x\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1,$ the level curve is the line $y=-2x,$ excluding the origin. So, I is false.\n\n- If $c=0,$ the level curve is the line $y=-x,$ excluding the origin. So, II is false.\n\n- If $c=1,$ the level curve is $y=0,$ which is the $x$-axis (excluding the origin). So, III is false.\n\nSo, the correct answer is \"None of the listed\"." 13194139533450 17592186045585 true] [17592186371742 1075 #edb/ref 17592186371743 13194139533450 17592186045585 true] [17592186371742 1075 #edb/ref 17592186371744 13194139533450 17592186045585 true] [17592186371742 1075 #edb/ref 17592186371745 13194139533450 17592186045585 true] [175921