0 17592186045585 true] [17592186372363 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186372363 1077 "selection" 13194139533450 17592186045585 true] [17592186372363 1079 #edb/ref 17592186372365 13194139533450 17592186045585 true] [17592186372363 1080 #uuid "7c0f5119-89c7-5db2-a73c-5529b8653533" 13194139533450 17592186045585 true] [17592186372364 1081 "(0,2\\pm \\sqrt{5})" 13194139533450 17592186045585 true] [17592186372364 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372364 1084 #uuid "fbf34fd3-e31f-5f18-a4f5-fe11670c6664" 13194139533450 17592186045585 true] [17592186372365 1081 "(0,-2\\pm \\sqrt{\\frac{5}{2}})" 13194139533450 17592186045585 true] [17592186372365 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372365 1084 #uuid "3f5aab9e-78ab-5f6f-987b-d6e9926e1669" 13194139533450 17592186045585 true] [17592186372366 1081 "(0,1\\pm \\sqrt{5})" 13194139533450 17592186045585 true] [17592186372366 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372366 1084 #uuid "b405c5e3-3dbb-5166-8762-a9592e734970" 13194139533450 17592186045585 true] [17592186372367 1081 "(0,-1\\pm \\sqrt{\\frac{3}{2}})" 13194139533450 17592186045585 true] [17592186372367 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372367 1084 #uuid "04aca6e8-08ff-50f0-8c8c-2174d6f543e9" 13194139533450 17592186045585 true] [17592186372368 1081 "(0,-5\\pm \\sqrt{\\frac{2}{3}})" 13194139533450 17592186045585 true] [17592186372368 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372368 1084 #uuid "32a1670f-e1c5-5e85-8535-2bd775ee5bd4" 13194139533450 17592186045585 true] [17592186372369 1068 #edb/ref 17592186372370 13194139533450 17592186045585 true] [17592186372369 1069 "q-170554" 13194139533450 17592186045585 true] [17592186372369 1070 #edb/ref 17592186045487 13194139533450 17592186045585 true] [17592186372369 1071 "Calculate the $y$-intercepts of the hyperbola $\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25}=1.$" 13194139533450 17592186045585 true] [17592186372369 1072 #uuid "cb98a0f4-3a47-5a3f-8676-25371977fac8" 13194139533450 17592186045585 true] [17592186372369 1074 "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{{0}^{2}}{16}-\\frac{{y}^{2}}{25} & =1 \\\\ 0-\\frac{{y}^{2}}{25} & =1 \\\\ -\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{{y}^{2}}{25} & =-1 \\\\ {y}^{2} & =-25\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, there are no $y$-intercepts." 13194139533450 17592186045585 true] [17592186372370 1075 #edb/ref 17592186372371 13194139533450 17592186045585 true] [17592186372370 1075 #edb/ref 17592186372372 13194139533450 17592186045585 true] [17592186372370 1075 #edb/ref 17592186372373 13194139533450 17592186045585 true] [17592186372370 1075 #edb/ref 17592186372374 13194139533450 17592186045585 true] [17592186372370 1075 #edb/ref 17592186372375 13194139533450 17592186045585 true] [17592186372370 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186372370 1077 "selection" 13194139533450 17592186045585 true] [17592186372370 1079 #edb/ref 17592186372374 13194139533450 17592186045585 true] [17592186372370 1080 #uuid "4b195795-2ddb-57bf-ab90-a6b5dbc7af6b" 13194139533450 17592186045585 true] [17592186372371 1081 "(0,\\pm \\frac{1}{5})" 13194139533450 17592186045585 true] [17592186372371 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372371 1084 #uuid "7625f8c6-161c-52fc-aaa1-209681e826d0" 13194139533450 17592186045585 true] [17592186372372 1081 "(0,\\pm 5)" 13194139533450 17592186045585 true] [17592186372372 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186372372 1084 #uuid "c23309d7-ce49-5954-9985-dc6726cdbfdd" 13194139533450 175921