4139533450 17592186045585 true] [17592186371653 1084 #uuid "ca8b9784-0c8e-540c-ae58-117671d3161c" 13194139533450 17592186045585 true] [17592186371654 1081 "{∅,{{2}},{3},{{2},3}}" 13194139533450 17592186045585 true] [17592186371654 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371654 1084 #uuid "12328763-de10-5194-bac4-a9572b35a5da" 13194139533450 17592186045585 true] [17592186371655 1081 "{∅,{{2}},{3},{{2},{3}}}" 13194139533450 17592186045585 true] [17592186371655 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371655 1084 #uuid "de0deeb1-ee8c-58db-93b7-93e07517e67b" 13194139533450 17592186045585 true] [17592186371656 1081 "{∅,{{2}},{{3}},{{2},3}}" 13194139533450 17592186045585 true] [17592186371656 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371656 1084 #uuid "74c8e2b2-cd1d-5a13-a215-5987e54c2561" 13194139533450 17592186045585 true] [17592186371657 1068 #edb/ref 17592186371658 13194139533450 17592186045585 true] [17592186371657 1069 "q-121725" 13194139533450 17592186045585 true] [17592186371657 1070 #edb/ref 17592186045486 13194139533450 17592186045585 true] [17592186371657 1071 "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{3}^{t-1}}{\\operatorname{ln}⁡3},5t+1⟩,\\,t>0.\n$$\n\nCalculate the speed of the particle at time $t=2.$" 13194139533450 17592186045585 true] [17592186371657 1072 #uuid "73985c53-2b53-5763-8978-e13f9c4108f3" 13194139533450 17592186045585 true] [17592186371657 1074 "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{3}^{t-1}}{\\operatorname{ln}⁡3}),\\frac{\\text{d}}{\\text{d}t}(5t+1)⟩ \\\\  & =⟨\\frac{{3}^{t-1}\\operatorname{ln}⁡3}{\\operatorname{ln}⁡3},5⟩ \\\\  & =⟨{3}^{t-1},5⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=2,$ we substitute in the above:\n\n$$\n\\begin{aligned}v(2) & =⟨{3}^{2-1},5⟩=⟨3,5⟩\\end{aligned}\n$$\n\nTo find the speed at $t=2$ we calculate the magnitude of $v(2),$ and we get\n\n$$\n\\begin{aligned}|v(2)| & =\\sqrt{{3}^{2}+{5}^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$\n\nSo, the speed when $t=2$ is $\\sqrt{34}.$" 13194139533450 17592186045585 true] [17592186371658 1075 #edb/ref 17592186371659 13194139533450 17592186045585 true] [17592186371658 1075 #edb/ref 17592186371660 13194139533450 17592186045585 true] [17592186371658 1075 #edb/ref 17592186371661 13194139533450 17592186045585 true] [17592186371658 1075 #edb/ref 17592186371662 13194139533450 17592186045585 true] [17592186371658 1075 #edb/ref 17592186371663 13194139533450 17592186045585 true] [17592186371658 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186371658 1077 "selection" 13194139533450 17592186045585 true] [17592186371658 1079 #edb/ref 17592186371659 13194139533450 17592186045585 true] [17592186371658 1080 #uuid "c19f4fe0-a2f2-54ce-844c-0a66ea526790" 13194139533450 17592186045585 true] [17592186371659 1081 "\\sqrt{34}" 13194139533450 17592186045585 true] [17592186371659 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371659 1084 #uuid "c22051eb-85a4-5221-baf6-e2e9c7cc50a2" 13194139533450 17592186045585 true] [17592186371660 1081 "\\sqrt{17}" 13194139533450 17592186045585 true] [17592186371660 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371660 1084 #uuid "617b3700-b027-56ba-a86d-80f694931ceb" 13194139533450 17592186045585 true] [17592186371661 1081 "6" 13194139533450 17592186045585 true] [17592186371661 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371661 1084 #uuid "ba681259-2162-569c-ba72-2d7190522e33" 13194139533450 17592186045585 true] [17592186371662 1081 "2\\sqrt{17}" 13194139533450 17592186045585 true] [17592186371662 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371662 1084 #uuid "03851dc9-dce3-5e91-abe3-aa49dc3e57e6" 13194139533450 17592186045585 true] [17592186371663 1081 "5" 13194139533450 17592186045585 true] [17592186371663 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371663 1084 #uuid "59ade160-172a-519f-b77a-946ec8d0ebd2" 13194139533450 17592186045585 true] [17592186371664 1068 #edb/ref 17592186371665 13194139533450 17592186045585 true] [17592186371664 1069 "q-121939" 13194139533450 17592186045585 true] [17592186371664 1070 #edb/ref 17592186045486 13194139533450 17592186045585 true] [17592186371664 1071 "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨4(t+2)^{5/2},3t-2⟩,\\,t>0.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=2.$" 13194139533450 17592186045585 true] [17592186371664 1072 #uuid "8032fd77-a245-5d99-88a8-935ef61e608c" 13194139533450 17592186045585 true] [17592186371664 1074 "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4(t+2)^{5/2}),\\frac{\\text{d}}{\\text{d}t}(3t-2)⟩ \\\\  & =⟨10(t+2)^{3/2},3⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(10(t+2)^{3/2}),\\frac{\\text{d}}{\\text{d}t}(3)⟩ \\\\  & =⟨15(t+2)^{1/2},0⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨15(2+2)^{1/2},0⟩ \\\\  & =⟨15\\sqrt{4},0⟩ \\\\  & =⟨15(2),0⟩ \\\\  & =⟨30,0⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(2)|:$\n\n$$\n\\begin{aligned}|a(2)| & =|⟨30,0⟩| \\\\  & =\\sqrt{(30)^{2}+(0)^{2}} \\\\  & =30\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" 13194139533450 17592186045585 true] [17592186371665 1075 #edb/ref 17592186371666 13194139533450 17592186045585 true] [17592186371665 1075 #edb/ref 17592186371667 13194139533450 17592186045585 true] [17592186371665 1075 #edb/ref 17592186371668 13194139533450 17592186045585 true] [17592186371665 1075 #edb/ref 17592186371669 13194139533450 17592186045585 true] [17592186371665 1075 #edb/ref 17592186371670 13194139533450 17592186045585 true] [17592186371665 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186371665 1077 "selection" 13194139533450 17592186045585 true] [17592186371665 1079 #edb/ref 17592186371668 13194139533450 17592186045585 true] [17592186371665 1080 #uuid "60fd4fe3-fb60-5e25-bcc8-ac6f32ecd7db" 13194139533450 17592186045585 true] [17592186371666 1081 "15\\,{\\text{m/s}}^{2}" 13194139533450 17592186045585 true] [17592186371666 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371666 1084 #uuid "922439db-6c1c-50df-b5ad-9f309d59161b" 13194139533450 17592186045585 true] [17592186371667 1081 "35\\,{\\text{m/s}}^{2}" 13194139533450 17592186045585 true] [17592186371667 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371667 1084 #uuid "8418167b-36c6-552d-807a-dc9ad7ea12f1" 13194139533450 17592186045585 true] [17592186371668 1081 "30\\,{\\text{m/s}}^{2}" 13194139533450 17592186045585 true] [17592186371668 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186371668 1084 #uuid "717a220c-4297-5ce2-8911-a00e6c37ba52" 13194139533450 17592186045585 true] [17592186371669 1081 "10\\,{\\text{m/s}}^{2}" 13194139533450 17592186045585 true] [17592186371669 1083 #edb/ref 17592186045499 13194139533450 17592186045585 