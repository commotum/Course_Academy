ac{-78\\,124}{-4} \\\\  & =19\\,531.\\end{aligned}\n$$" 13194139533450 17592186045585 true] [17592186373038 1075 #edb/ref 17592186373039 13194139533450 17592186045585 true] [17592186373038 1075 #edb/ref 17592186373040 13194139533450 17592186045585 true] [17592186373038 1075 #edb/ref 17592186373041 13194139533450 17592186045585 true] [17592186373038 1075 #edb/ref 17592186373042 13194139533450 17592186045585 true] [17592186373038 1075 #edb/ref 17592186373043 13194139533450 17592186045585 true] [17592186373038 1076 #edb/ref 17592186045493 13194139533450 17592186045585 true] [17592186373038 1077 "selection" 13194139533450 17592186045585 true] [17592186373038 1079 #edb/ref 17592186373041 13194139533450 17592186045585 true] [17592186373038 1080 #uuid "b79a48b0-8cab-5a5f-befc-d2d776b52392" 13194139533450 17592186045585 true] [17592186373039 1081 "97\\,665" 13194139533450 17592186045585 true] [17592186373039 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186373039 1084 #uuid "51edf344-7eb8-58ef-b6bd-475b739188c6" 13194139533450 17592186045585 true] [17592186373040 1081 "13\\,531" 13194139533450 17592186045585 true] [17592186373040 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186373040 1084 #uuid "6adcb5f7-1a7b-5f59-940c-c09d1a295cc6" 13194139533450 17592186045585 true] [17592186373041 1081 "19\\,531" 13194139533450 17592186045585 true] [17592186373041 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186373041 1084 #uuid "7c2fd1cd-f651-55ba-aa0f-58dcae836490" 13194139533450 17592186045585 true] [17592186373042 1081 "19\\,543" 13194139533450 17592186045585 true] [17592186373042 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186373042 1084 #uuid "a9d37a04-eb55-5188-bde2-3fd3731bb7a9" 13194139533450 17592186045585 true] [17592186373043 1081 "19\\,532" 13194139533450 17592186045585 true] [17592186373043 1083 #edb/ref 17592186045499 13194139533450 17592186045585 true] [17592186373043 1