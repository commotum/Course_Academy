45585 true] [17592186068430 1081 "images/f3/f3a1cac41b2f9d6773226d76722508e6d7f368a42a0f7e86a5d8407d6f42c149.png" 13194139533346 17592186045585 true] [17592186068430 1083 #edb/ref 17592186045498 13194139533346 17592186045585 true] [17592186068430 1084 #uuid "b6cfcb00-3352-501b-8c96-ce26e77b5a8e" 13194139533346 17592186045585 true] [17592186068431 1081 "images/79/79b496d28a0136f46e594a1b8dfddffcf4ed72557ded658259326e9ed09276ab.png" 13194139533346 17592186045585 true] [17592186068431 1083 #edb/ref 17592186045498 13194139533346 17592186045585 true] [17592186068431 1084 #uuid "23e003a0-4faa-5012-ab5b-6a16e4b56306" 13194139533346 17592186045585 true] [17592186068432 1081 "images/5a/5a43656a35d47c7321e53d56238cd10f669bc807d57f72fcc002d79fb21aa111.png" 13194139533346 17592186045585 true] [17592186068432 1083 #edb/ref 17592186045498 13194139533346 17592186045585 true] [17592186068432 1084 #uuid "49b26a18-d77e-5918-b476-d158f220dc5d" 13194139533346 17592186045585 true] [17592186068433 1081 "images/89/89233072deb8044ce467c1af083a3cafb680177efc602927fdd0192cf1c26fb4.png" 13194139533346 17592186045585 true] [17592186068433 1083 #edb/ref 17592186045498 13194139533346 17592186045585 true] [17592186068433 1084 #uuid "65274f98-eaa9-5a2d-8d7e-79e14a17f226" 13194139533346 17592186045585 true] [17592186068434 1069 "e-1" 13194139533346 17592186045585 true] [17592186068434 1071 "Find $\\lim_\\limits{x\\rightarrow \\,-1}f(x)$ for the function $f(x)$ whose graph is shown below.\n\n![](images/ee/eead78a813f820cf12cbd05bd22b230b1753c7e4ebe1e77d2c1eb6b61c11f4ed.png)" 13194139533346 17592186045585 true] [17592186068434 1072 #uuid "282add39-5184-589e-bb7b-b87a59cd41e6" 13194139533346 17592186045585 true] [17592186068434 1074 "As $x$ approaches $-1$, the value of $f(x)$ approaches $2$. Consequently,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-1}f(x)=2\\,\n$$" 13194139533346 17592186045585 true] [17592186068435 1069 "e-10008" 13194139533346 17592186045585 true] [17592186068435 1071 "Complete the square on the quadratic expression $x^2 + 2x + 3$." 13194139533346 17592186045585 true] [17592186068435 1072 #uuid "aa51996a-09e5-5950-8438-795ab3e0f027" 13194139533346 17592186045585 true] [17592186068435 1074 "First, we rewrite the coefficient of the linear term as a product with ${\\color{red}{2}}$ as a factor:\n\n$$\nx^2 + {\\color{red}{2}}\\cdot {\\color{blue}{1}}x + {\\color{purple}{3}}\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${\\color{blue}{1}}^2$, writing the constant term ${\\color{purple}{3}}$ last:\n\n$$\n\\underbrace{x^2 + {\\color{red}{2}}\\cdot {\\color{blue}{1}}x + {\\color{blue}{1}}^2} - \\, {\\color{blue}{1}}^2 + {\\color{purple}{3}}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x + {\\color{blue}{1}})^2 - {\\color{blue}{1}}^2 + {\\color{purple}{3}}\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x + {\\color{blue}{1}})^2 + 2\n$$" 13194139533346 17592186045585 true] [17592186068436 1069 "e-10009" 13194139533346 17592186045585 true] [17592186068436 1071 "Complete the square on the quadratic expression $x^2 - 12x + 40$." 13194139533346 17592186045585 true] [17592186068436 1072 #uuid "06ed73b3-1442-5b21-a317-961d0395f7da" 13194139533346 17592186045585 true] [17592186068436 1074 "First, we rewrite the coefficient of the linear term as a product with ${\\color{red}{2}}$ as a factor:\n\n$$\nx^2 - {\\color{red}{2}}\\cdot {\\color{blue}{6}}x + {\\color{purple}{40}}\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${\\color{blue}{6}}^2$, writing the constant term ${\\color{purple}{40}}$ last:\n\n$$\n\\underbrace{x^2 - {\\color{red}{2}}\\cdot {\\color{blue}{6}}x + {\\color{blue}{6}}^2} - \\, {\\color{blue}{6}}^2 + {\\color{purple}{40}}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x - {\\color{blue}{6}})^2 - {\\color{blue}{6}}^2 + {\\color{purple}{40}}\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x - {\\color{blue}{6}})^2 +4\n$$" 13194139533346 17592186045585 true] [17592186068437 1069 "e-10013" 13194139533346 17592186045585 true] [17592186068437 1071 "Solve the equation $x^2 -10x = -24$.\n\n*Hint: Use the fact that $x^2 -10x +25$ is a perfect square.*" 13194139533346 17592186045585 true] [17592186068437 1072 #uuid "369ac89b-e838-5929-ba71-d74b3b06445b" 13194139533346 17592186045585 true] [17592186068437 1074 "Using the hint, we have\n\n$$\nx^2 -10x +25 = (x-5)^2\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}\nx^{2} - 10x &= -24 \\\\\nx^{2} - 2 \\cdot 5 \\cdot x &= -24 \\\\\nx^{2} - 2 \\cdot 5 \\cdot x + 5^{2} - 5^{2} &= -24 \\\\\n(x - 5)^{2} - 25 &= -24\n\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides:\n\n$$\n\\begin{aligned}\n(x - 5)^{2} - 25 + 25 &= -24 + 25 \\\\\n(x - 5)^{2} &= 1\n\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}\n(x - 5)^{2} &= 1 \\\\\n\\sqrt{(x - 5)^{2}} &= \\sqrt{1} \\\\\n\\mid x - 5 \\mid &= 1 \\\\\nx - 5 &= ± 1 \\\\\nx &= 5 ± 1\n\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}\nx_{1} &= 5 - 1 = 4 \\\\\nx_{2} &= 5 + 1 = 6\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068438 1069 "e-10022" 13194139533346 17592186045585 true] [17592186068438 1071 "Simplify $\\sqrt{8z^3}$." 13194139533346 17592186045585 true] [17592186068438 1072 #uuid "a474788c-5b2b-570d-84bf-2c9575ac4f54" 13194139533346 17592186045585 true] [17592186068438 1074 "We first write $8z^3$ as the product $4z^2 \\cdot 2z$ which contains a perfect square $(4z^2){:}$\n\n$$\n\\begin{aligned} \\sqrt{8z^3} \\\\[3pt] &= \\sqrt{4z^2 \\cdot 2z}& \\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned} \\sqrt{4z^2 \\cdot 2z} \\\\[3pt] &= \\sqrt{(2z)^2\\cdot 2z} \\\\[3pt] &= \\sqrt{(2z)^2}\\cdot \\sqrt{2z}& \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned} \\sqrt{(2z)^2}\\cdot \\sqrt{2z} \\\\[3pt] &= \\begin{vmatrix}2z & \\cdot \\sqrt{2z} \\\\[3pt] &= & 2 & \\cdot & z & \\cdot \\sqrt{2z} \\\\[3pt] &= 2 & z\\end{vmatrix}\\sqrt{2z}& \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068439 1069 "e-10610" 13194139533346 17592186045585 true] [17592186068439 1071 "Calculate the discriminant of the quadratic equation $-2x^2+5x-1=0$." 13194139533346 17592186045585 true] [17592186068439 1072 #uuid "360239d4-c271-52f3-8d25-ed47e7dd52f7" 13194139533346 17592186045585 true] [17592186068439 1074 "We have $a=-2$, $b=5$, and $c=-1$. So, we calculate the discriminant as follows:\n\n$$\n\\begin{aligned}\nD &= b^{2} - 4ac \\\\\n&= (5)^{2} - 4(-2)(-1) \\\\\n&= 25 - 8 \\\\\n&= 17\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068440 1069 "e-10611" 13194139533346 17592186045585 true] [17592186068440 1071 "Consider the equation $-x^2-x+1=0$. How many distinct real solutions does it have?" 13194139533346 17592186045585 true] [17592186068440 1072 #uuid "f667bd43-407c-55a9-9821-67a0c1b11a96" 13194139533346 17592186045585 true] [17592186068440 1074 "To quickly determine the number of solutions, we can compute the discriminant. We have $a=-1$, $b=-1$, and $c=1$, so the discriminant is as follows:\n\n$$\n\\begin{aligned}\nD &= b^{2} - 4ac \\\\\n&= (-1)^{2} - 4(-1)(1) \\\\\n&= 1 + 4 \\\\\n&= 5\n\\end{aligned}\n$$\n\nSince the discriminant is positive $(\\mathcal{D}>0)$, the equation has two distinct solutions." 13194139533346 17592186045585 true] [17592186068441 1069 "e-10612" 13194139533346 17592186045585 true] [17592186068441 1071 "Find the values of $k$ for which the quadratic equation $x^2+2x+k=0$ has no real solutions." 13194139533346 17592186045585 true] [17592186068441 1072 #uuid "5d4530b7-c6df-583f-b98f-8a8f93203295" 13194139533346 17592186045585 true] [17592186068441 1074 "The equation has no real solutions if its discriminant is negative. So, we need to find the values of $k$ so that the discriminant is negative.\n\nFirst, we calculate the discriminant. We have $a=1$, $b=2$, and $c=k$, so the discriminant is as follows:\n\n$$\n\\begin{aligned}\nD &= b^{2} - 4ac \\\\\n&= (2)^{2} - 4(1)(k) \\\\\n&= 4 - 4k\n\\end{aligned}\n$$\n\nNow, we find the values of $k$ such that the discriminant is negative:\n\n$$\n\\begin{bmatrix}D & < 0 \\\\ 4 - 4k & < 0 \\\\ 4 & < 4k \\\\ 1 & < k \\\\ k & > 1\\end{bmatrix}\n$$\n\nTherefore, the given equation will have no real solutions if $k>1$." 13194139533346 17592186045585 true] [17592186068442 1069 "e-10616" 13194139533346 17592186045585 true] [17592186068442 1071 "Consider the quadratic equation $x^2+2x -2 = 0$. Which of the following statements are true?\n\n1. The discriminant of the equation is a perfect square.\n2. The equation has only rational solutions.\n3. The equation has only irrational solutions." 13194139533346 17592186045585 true] [17592186068442 1072 #uuid "b92b9a39-e29a-532f-ba2c-f935773d0bf7" 13194139533346 17592186045585 true] [17592186068442 1074 "Let's examine our statements in turn.\n\n- Statement I is false. We have $a=1$, $b=2$, and $c=-2$. So, we calculate the discriminant as follows:\n$D|= b^{2} - 4ac; = (2)^{2} - 4(1)(-2); = 4 + 8; = 12$\nAnd $12$ is *not* a perfect square.\n- Statement II is false, while statement III is true. First, notice that our quadratic equation has rational coefficients. And, since the discriminant is not a perfect square, the equation must have two irrational solutions.\n\nTherefore, the correct answer is \"III only.\"" 13194139533346 17592186045585 true] [17592186068443 1069 "e-1064" 13194139533346 17592186045585 true] [17592186068443 1071 "Write $(2a)^{1/3}$ using radical notation." 13194139533346 17592186045585 true] [17592186068443 1072 #uuid "9d956f2f-da17-5f0a-9eee-d1a8d1aeab0d" 13194139533346 17592186045585 true] [17592186068443 1074 "In general, the fractional exponent $x^{1/n}$ can also be written as the $n$th root $\\sqrt[n]{x}$. In this particular case, $n=3$, $x=2a$, and we have\n\n$$\n(2a)^{1/3} = \\sqrt[3]{2a}\n$$" 13194139533346 17592186045585 true] [17592186068444 1069 "e-1065" 13194139533346 17592186045585 true] [17592186068444 1071 "Write $\\sqrt[4]{2y}$ using power notation." 13194139533346 17592186045585 true] [17592186068444 1072 #uuid "96c1a35f-ee50-5546-bc26-cff2a4e43df8" 13194139533346 17592186045585 true] [17592186068444 1074 "In general, the $n$th root $\\sqrt[n]{x}$ can also be written using a fractional exponent as $x^{1/n}$. In this particular case, $n=4$, $x=2y$, and we have\n\n$$\n\\sqrt[4]{2y} = (2y)^{1/4}\n$$" 13194139533346 17592186045585 true] [17592186068445 1069 "e-10654" 13194139533346 17592186045585 true] [17592186068445 1071 "Solve the equation $\\mid 5x+1|=-x+7$." 13194139533346 17592186045585 true] [17592186068445 1072 #uuid "c5b21644-3478-54b0-9f79-dcbcb67ddd88" 13194139533346 17592186045585 true] [17592186068445 1074 "We have the following two cases:\n\n- If $\\mid 5x+1|=5x+1$, we obtain\n$\\mid 5x + 1 \\mid |=-x + 7; 5x + 1|=-x + 7; 6x + 1|= 7; 6x|= 6; x|= 1$.\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$\\mid 5x + 1 \\mid |=-x + 7; \\mid 5(1) + 1 \\mid |= - (1) + 7; \\mid 6 \\mid |= 6; 6|= 6✓$\nSince $x=1$ satisfies the original equation, it's a valid solution.\n- If $\\mid 5x+1|=-(5x+1)$, we obtain\n$\\mid 5x + 1 \\mid |=-x + 7; - (5x + 1)|=-x + 7; - 5x - 1|=-x + 7; - 1|= 4x + 7; - 8|= 4x; - 2|= x; x|=-2$.\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$\\mid 5x + 1 \\mid |=-x + 7; \\mid 5(-2) + 1 \\mid |= - (-2) + 7; \\mid - 10 + 1 \\mid |= 2 + 7; \\mid - 9 \\mid |= 9; 9|= 9✓$\nSince $x=-2$ satisfies the original equation, it's a valid solution.\n\nTherefore, the solutions of our equation are $x=-2, \\, 1$." 13194139533346 17592186045585 true] [17592186068446 1069 "e-1066" 13194139533346 17592186045585 true] [17592186068446 1071 "Write $x^{-1/2}$ using radical notation." 13194139533346 17592186045585 true] [17592186068446 1072 #uuid "2b4f5483-d272-5605-a7cc-9c9f11653707" 13194139533346 17592186045585 true] [17592186068446 1074 "Remember that, in general, a negative exponent can be converted to a positive exponent if we take the reciprocal. Here, we have\n\n$$\nx^{-1/2} = \\dfrac{1}{x^{1/2}}\n$$\n\nNow, we can proceed as usual to convert the fractional exponent to a radical\n\n$$\n\\dfrac{1}{x^{1/2}} = \\dfrac{1}{\\sqrt{x}}\n$$\n\nTherefore, we have\n\n$$\nx^{-1/2} = \\dfrac{1}{\\sqrt{x}}\n$$" 13194139533346 17592186045585 true] [17592186068447 1069 "e-1067" 13194139533346 17592186045585 true] [17592186068447 1071 "Express $\\dfrac{1}{\\sqrt[3\\phantom{\\mid}]{2y}}$ using power notation." 13194139533346 17592186045585 true] [17592186068447 1072 #uuid "6cb6f11f-cdf8-5082-8ccf-2052d15fb876" 13194139533346 17592186045585 true] [17592186068447 1074 "First, we convert the radical to a fractional exponent:\n\n$$\n\\dfrac{1}{\\sqrt[3\\phantom{\\mid}]{2y}} = \\dfrac{1}{(2y)^{1/3}}\n$$\n\nThen, we take the reciprocal and convert the exponent to a negative exponent:\n\n$$\n\\dfrac{1}{(2y)^{1/3}} = (2y)^{-1/3}\n$$\n\nTherefore, we have:\n\n$$\n\\dfrac{1}{\\sqrt[3\\phantom{\\mid}]{2y}} = (2y)^{-1/3}\n$$" 13194139533346 17592186045585 true] [17592186068448 1069 "e-10699" 13194139533346 17592186045585 true] [17592186068448 1071 "Simplify the expression $\\sqrt{\\dfrac{4z^2}{9}}$." 13194139533346 17592186045585 true] [17592186068448 1072 #uuid "dd7c79e5-d274-5f04-af44-335b5a6d95df" 13194139533346 17592186045585 true] [17592186068448 1074 "First, we put the numerator and denominator under separate radicals and then simplify the result:\n\n$$\n\\sqrt{\\dfrac {4z^2} {9}} = \\dfrac {\\sqrt{4z^2}} {\\sqrt{9}} = \\dfrac{\\sqrt{4z^2}}{\\sqrt{3^2}} = \\dfrac{\\sqrt{4z^2}}{3}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\n\\frac{\\sqrt{4z^{2}}}{3} &=  \\\\\n(\\sqrt{(2z)^{2}})/(3) &=  \\\\\n\\frac{\\mid 2z\\begin{vmatrix}}{3} &= \\\\ \\frac{\\begin{vmatrix}2 & \\cdot & z\\end{vmatrix}}{3}|= \\\\ \\frac{2 \\cdot \\mid z \\mid}{3}|= \\\\ \\frac{2 \\mid z\\end{vmatrix}}{3}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068449 1069 "e-10712" 13194139533346 17592186045585 true] [17592186068449 1071 "Simplify $\\dfrac {\\sqrt {32x^5}} {\\sqrt{2x^3}}$ given that $x > 0$." 13194139533346 17592186045585 true] [17592186068449 1072 #uuid "40af3166-710b-508c-9a8e-2c54365cd238" 13194139533346 17592186045585 true] [17592186068449 1074 "First, we bring the quotient under a single radical and then simplify the result:\n\n$$\n\\begin{aligned} \\dfrac {\\sqrt {32x^5}} {\\sqrt{2x^3}} = \\sqrt {\\dfrac {32x^5} {2x^3}} = \\sqrt {16x^2} \\end{aligned}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned} \\sqrt {16x^2} \\\\[5pt] &= \\sqrt {4^2x^2} \\\\[5pt] &= \\sqrt {(4x)^2} \\\\[5pt] &= \\begin{vmatrix}4x & \\\\[5pt] &= & 4 & \\cdot & x & \\\\[5pt] &= 4 \\cdot & x\\end{vmatrix} \\end{aligned}\n$$\n\nLastly, we are told that $x>0$, so we have\n\n$$\n\\begin{aligned}\n\\mid x &= x\n\\end{aligned}\n$$\n\nTherefore, the final answer is\n\n$$\n\\begin{aligned} 4 \\cdot \\mid x \\mid \\\\[5pt] &= 4 \\cdot x \\\\[5pt] &= 4x. \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068450 1069 "e-10716" 13194139533346 17592186045585 true] [17592186068450 1071 "Simplify the expression $\\dfrac{\\sqrt{45a^4}}{\\sqrt{5}}$." 13194139533346 17592186045585 true] [17592186068450 1072 #uuid "9ceac090-9a1c-57d7-a311-f771ece6e0b6" 13194139533346 17592186045585 true] [17592186068450 1074 "First, we bring the quotient under a single radical and then simplify the result:\n\n$$\n\\dfrac{\\sqrt{45a^4}}{\\sqrt{5}} = \\sqrt{\\dfrac {45a^4} {5}}= \\sqrt{9a^4}\n$$\n\nNow, notice that the expression inside the radical is a perfect square. So, we can continue simplifying by writing the expression as this perfect square:\n\n$$\n\\begin{aligned}\n\\sqrt{9a^{4}} &=  \\\\\n\\sqrt{(3a^{2})^{2}} &=  \\\\\n\\mid 3a^{2} \\mid &=  \\\\\n\\begin{vmatrix}3 & \\cdot & a^{2}\\end{vmatrix} &=  \\\\\n&= 3 \\cdot \\mid a^{2} \\mid\n\\end{aligned}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have\n\n$$\n\\begin{aligned}\n3 \\cdot \\mid a^{2} \\mid &=  \\\\\n3 \\cdot a^{2} &=  \\\\\n&= 3a^{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068451 1069 "e-10718" 13194139533346 17592186045585 true] [17592186068451 1071 "Solve the equation $\\vert 2 -6q \\vert + 2q = 6$." 13194139533346 17592186045585 true] [17592186068451 1072 #uuid "757a78ec-ffa1-5dae-aa64-80dae21b5e3b" 13194139533346 17592186045585 true] [17592186068451 1074 "We start by isolating the absolute value on the left side:\n\n$$\n\\begin{aligned}\n\\mid 2 - 6q \\mid + 2q &= 6 \\\\\n\\mid 2 - 6q \\mid &= -2q + 6\n\\end{aligned}\n$$\n\nNow, we have the following two cases:\n\n- If $\\mid 2-6q|=2-6q$, we obtain\n$\\mid 2 - 6q \\mid |=-2q + 6; 2 - 6q|=-2q + 6; 2|= 4q + 6; - 4|= 4q; - 1|= q; q|=-1$.\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$\\mid 2 - 6q \\mid |=-2q + 6; \\mid 2 - 6(-1) \\mid |=-2(-1) + 6; \\mid 2 + 6 \\mid |= 2 + 6; \\mid 8 \\mid |= 8; 8|= 8✓$\nSince $q=-1$ satisfies the original equation, it's a valid solution.\n- If $\\mid 2-6q|=-(2-6q)$, we obtain\n$\\mid 2 - 6q \\mid |=-2q + 6; - (2 - 6q)|=-2q + 6; - 2 + 6q|=-2q + 6; 8q - 2|= 6; 8q|= 8; q|= 1$.\nThis *potential* solution is valid only if it actually solves the original equation. So, let's plug it back in:\n$\\mid 2 - 6q \\mid |=-2q + 6; \\mid 2 - 6(1) \\mid |=-2(1) + 6; \\mid 2 - 6 \\mid |=-2 + 6; \\mid - 4 \\mid |= 4; 4|= 4✓$\nSince $q=1$ satisfies the original equation, it's a valid solution.\n\nTherefore, our equation has two solutions $q=-1$ and $q=1$." 13194139533346 17592186045585 true] [17592186068452 1069 "e-10736" 13194139533346 17592186045585 true] [17592186068452 1071 "![](images/30/30081d2bd598ed395c5f9ac372b0d9899cc3e6f7ba0a26fefb27a2729b3dbef3.png)\n\nSolve for $x$ in the figure above given that $\\overset{\\longleftrightarrow}{AB} \\parallel \\overset{\\longleftrightarrow}{CD}$." 13194139533346 17592186045585 true] [17592186068452 1072 #uuid "142170e2-0b2d-5612-92d8-7c989aa1453e" 13194139533346 17592186045585 true] [17592186068452 1074 "Since the angles $\\angle{AJF}$ and $\\angle{CIF}$ are corresponding angles, they are congruent and therefore have the same measure:\n\n$$\n\\begin{aligned}\nm∠AJF &= m∠CIF \\\\\n9x - 10^{∘} &= 7x + 4^{∘}\n\\end{aligned}\n$$\n\nNow, we have an equation that we can solve for $x$:\n\n$$\n\\begin{aligned}\n9x - 10^{∘} &= 7x + 4^{∘} \\\\\n9x - 7x &= 4^{∘} + 10^{∘} \\\\\n2x &= 14^{∘} \\\\\n\\frac{2x}{2} &= \\frac{14^{∘}}{2} \\\\\n\\frac{2x}{2} &= 7^{∘} \\\\\nx &= 7^{∘}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068453 1069 "e-10832" 13194139533346 17592186045585 true] [17592186068453 1071 "Find the general solution to the differential equation $y' = \\dfrac {x^2}{y}$." 13194139533346 17592186045585 true] [17592186068453 1072 #uuid "d1de6657-82b1-5bcb-b8cc-fd2629d31faa" 13194139533346 17592186045585 true] [17592186068453 1074 "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\ny^{′} &= \\frac{x^{2}}{y} \\\\\n\\frac{dy}{dx} &= \\frac{x^{2}}{y} \\\\\ny\\frac{dy}{dx} &= x^{2}\n\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\n\\inty\\frac{dy}{dx}dx &= \\intx^{2}dx \\\\\n\\inty\\frac{dy}{dx}dx &= \\intx^{2}dx \\\\\n\\intydy &= \\intx^{2}dx \\\\\n\\frac{1}{2}y^{2} &= \\frac{1}{3}x^{3} + C\n\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\dfrac{1}{2}y^2 = \\dfrac{1}{3}x^3 + C\n$$\n\nWe can express the solution in the form $y = y(x)$ as follows:\n\n$$\n\\begin{aligned}\n\\frac{1}{2}y^{2} &= \\frac{1}{3}x^{3} + C \\\\\ny^{2} &= \\frac{2}{3}x^{3} + 2C \\\\\ny &= ± \\sqrt{\\frac{2}{3}x^{3} + 2C} \\\\\ny &= ± \\sqrt{\\frac{2}{3}x^{3} + K}\n\\end{aligned}\n$$\n\nwhere $K = 2C$." 13194139533346 17592186045585 true] [17592186068454 1069 "e-10833" 13194139533346 17592186045585 true] [17592186068454 1071 "Find the general solution to the differential equation $y' + 2xy = 0$ for $y\\neq 0$." 13194139533346 17592186045585 true] [17592186068454 1072 #uuid "23d66cc8-8e5a-5a33-a7a1-c43f5facdcbc" 13194139533346 17592186045585 true] [17592186068454 1074 "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\ny^{′} + 2xy &= 0 \\\\\n\\frac{dy}{dx} + 2xy &= 0 \\\\\n\\frac{dy}{dx} &= -2xy \\\\\n\\frac{1}{y} \\cdot \\frac{dy}{dx} &= -2x\n\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{y} \\cdot \\frac{dy}{dx}dx &= \\int(-2x)dx \\\\\n\\int\\frac{1}{y}dy &= -2\\intxdx \\\\\n\\ln \\mid y \\mid &= -x^{2} + C\n\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln \\vert y \\vert = -x^2 + C\n$$\n\nWe're required to write the solution in the form $y = y(x)$. By doing this, we get\n\n$$\n\\begin{aligned}\n\\ln \\mid y \\mid &= -x^{2} + C \\\\\n\\mid y \\mid &= e^{-x^{2} + C} \\\\\n\\mid y \\mid &= e^{-x^{2}} \\cdot e^{C} \\\\\n\\mid y \\mid &= Ke^{-x^{2}}\n\\end{aligned}\n$$\n\nwhere $K = e^C$ and $K > 0$.\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny = Ke^{-x^2}\n$$" 13194139533346 17592186045585 true] [17592186068455 1069 "e-10849" 13194139533346 17592186045585 true] [17592186068455 1071 "Given that $x,y \\geq 0$, separate the variables in the following differential equation:\n\n$\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\sqrt{2xy}$" 13194139533346 17592186045585 true] [17592186068455 1072 #uuid "32040154-373e-5a10-a460-1d17f6989da0" 13194139533346 17592186045585 true] [17592186068455 1074 "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = h(x)g(y)\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\dfrac{1}{g(y)} \\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}x} = h(x)\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\sqrt{2x} \\cdot \\sqrt{y}\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\dfrac{1}{\\sqrt{y}} \\cdot \\dfrac {\\textrm{d}y} {\\textrm{d}x} = \\sqrt{2x}\n$$" 13194139533346 17592186045585 true] [17592186068456 1069 "e-10855" 13194139533346 17592186045585 true] [17592186068456 1071 "![](images/c1/c1d1410979b84b183e64f0537af77acde9cba2fabd14cf66eb90b33c4a388649.png)\n\nGiven that $r$, $s$ and $t$ in the above diagram are parallel, find $m\\angle{1}$." 13194139533346 17592186045585 true] [17592186068456 1072 #uuid "40e3c6c8-c86a-55bf-80ef-d8845828ad27" 13194139533346 17592186045585 true] [17592186068456 1074 "Consider $\\angle 2$ and $\\angle 3$ in the diagram below.\n\n![](images/ca/cab8ca51722f9b2079db0f4c81fc0f89f26e23f99430ffac7ba709d945b6b08e.png)\n\nNote that $\\angle 2$ and the angle whose measure is $100^\\circ$ are corresponding angles formed by the same transversal. Therefore,\n\n$$\nm\\angle 2 = 100^\\circ\n$$\n\nSimilarly, note that $\\angle 3$ and the angle whose measure is $50^\\circ$ are corresponding angles formed by the same transversal. Therefore,\n\n$$\nm\\angle 3 = 50^\\circ\n$$\n\nLet's add these measures to our diagram:\n\n![](images/21/215845989e689c4a479101a1e4f6815e884f86c328b0991a02a18e434640aceb.png)\n\nThe angles $\\angle 1$, $\\angle 2$, and $\\angle 3$ combine to give a straight angle. So, we get\n\n$$\n\\begin{aligned}\nm∠1 + m∠2 + m∠3 &= 180^{∘} \\\\\nm∠1 + 100^{∘} + 50^{∘} &= 180^{∘} \\\\\nm∠1 + 150^{∘} &= 180^{∘} \\\\\nm∠1 &= 30^{∘}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068457 1069 "e-10997" 13194139533346 17592186045585 true] [17592186068457 1071 "Find the general solution to the differential equation $\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\dfrac{x}{y}$." 13194139533346 17592186045585 true] [17592186068457 1072 #uuid "d53c6172-978d-57c7-b1f0-e56e892e48a9" 13194139533346 17592186045585 true] [17592186068457 1074 "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{x}{y} \\\\\ny\\frac{dy}{dx} &= x\n\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\n\\inty\\frac{dy}{dx}dx &= \\intxdx \\\\\n\\inty\\frac{dy}{dx}dx &= \\intxdx \\\\\n\\intydy &= \\intxdx \\\\\n\\frac{y^{2}}{2} &= \\frac{x^{2}}{2} + K \\\\\ny^{2} &= x^{2} + 2K \\\\\ny^{2} &= x^{2} + C\n\\end{aligned}\n$$\n\nwhere $C= 2K$.\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\ny^2 = x^2 + C\n$$" 13194139533346 17592186045585 true] [17592186068458 1069 "e-11054" 13194139533346 17592186045585 true] [17592186068458 1071 "![](images/c4/c49d6d86122df4b39745e6e917c38b50efbeb7b5209d1a24e3b8eb19459f2326.png)\n\nSolve for $x$ in the figure above given that $\\overset{\\longleftrightarrow}{AB} \\parallel \\overset{\\longleftrightarrow}{CD}$." 13194139533346 17592186045585 true] [17592186068458 1072 #uuid "b983a05e-715b-5541-be19-cefac6f82b10" 13194139533346 17592186045585 true] [17592186068458 1074 "Since the angles $\\angle{CIF}$ and $\\angle{AJI}$ are corresponding angles, they are congruent and therefore have the same measure:\n\n$$\n\\begin{aligned}\nm∠CIF &= m∠AJI \\\\\n5x + 10^{∘} &= 110^{∘}\n\\end{aligned}\n$$\n\nNow, we have an equation that we can solve for $x$:\n\n$$\n\\begin{aligned}\n5x + 10^{∘} &= 110^{∘} \\\\\n5x &= 100^{∘} \\\\\n\\frac{5x}{5} &= \\frac{100^{∘}}{5} \\\\\n\\frac{5x}{5} &= 20^{∘} \\\\\nx &= 20^{∘}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068459 1069 "e-11055" 13194139533346 17592186045585 true] [17592186068459 1071 "![](images/60/606635acf3efd4f00a82cbc849d11bc6c67543357c84bb37344c9836a2c249e0.png)\n\nSolve for $x$ in the figure above given that $s \\parallel t$." 13194139533346 17592186045585 true] [17592186068459 1072 #uuid "c7d91325-bc8d-571d-8ae7-aa66ae0534c7" 13194139533346 17592186045585 true] [17592186068459 1074 "Consider $\\angle 1$ and $\\angle 2$ in the diagram below.\n\n![](images/23/23f64f62e4a78ccc60e1f2461dc9962f0eac00edac475305c9550419afe956bd.png)\n\nNote that $\\angle 1$ and the angle whose measure is $x$ are corresponding angles formed by the same transversal. Therefore,\n\n$$\nm\\angle 1 = x\n$$\n\nSimilarly, note that $\\angle 2$ and the angle whose measure is $2x$ are corresponding angles formed by the same transversal. Therefore,\n\n$$\nm\\angle 2 = 2x\n$$\n\nLet's add these measures to our diagram.\n\n![](images/74/74448c1e414d472be9e80c8a78e5517f0c431e5e7dde5e21bf3972e137af529c.png)\n\nThe angles $\\angle 1$, $\\angle 2$, and the third angle whose measure is $45^\\circ$, combine to give a straight angle. So, we get\n\n$$\n\\begin{aligned}\nm∠1 + m∠2 + 45^{∘} &= 180^{∘} \\\\\nx + 2x + 45^{∘} &= 180^{∘} \\\\\n3x + 45^{∘} &= 180^{∘} \\\\\n3x &= 135^{∘} \\\\\n\\frac{3x}{3} &= \\frac{135^{∘}}{3} \\\\\n\\frac{3x}{3} &= 45^{∘} \\\\\nx &= 45^{∘}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068460 1069 "e-1226" 13194139533346 17592186045585 true] [17592186068460 1071 "Plot the graph of $y=\\left(\\dfrac{1}{4}\\right)^{x}-3$." 13194139533346 17592186045585 true] [17592186068460 1072 #uuid "da62e401-d03d-54fd-90b5-410d36bdefad" 13194139533346 17592186045585 true] [17592186068460 1074 "First we plot the graph of\n\n$$\ny=\\left(\\dfrac{1}{4}\\right)^{x}{:}\n$$\n\n![](images/bf/bfe6ffc2b355b488899d29a827f779c60c13ca499312e0425c5b10b07057ed0b.png)\n\nTo sketch the graph of\n\n$$\ny=\\left(\\dfrac{1}{4}\\right)^{x}-3\n$$\n\nwe take the graph of\n\n$$\ny=\\left(\\dfrac{1}{4}\\right)^{x}\n$$\n\nand shift it $3$ units down. The $y$-intercept moves from $(0,1)$ to $(0,-2)$, and the horizontal asymptote moves from $y=0$ to $y=-3$.\n\n![](images/2c/2c002392e3cb165c295146c3e725ba5389fcf8c285f1c6ccaf7ae457b0f0ed46.png)" 13194139533346 17592186045585 true] [17592186068461 1069 "e-1227" 13194139533346 17592186045585 true] [17592186068461 1071 "Plot the graph of $y = 2\\left(\\dfrac{1}{5}\\right)^x + 1$." 13194139533346 17592186045585 true] [17592186068461 1072 #uuid "be6b6b07-c139-5ba2-b463-420a2ead54c8" 13194139533346 17592186045585 true] [17592186068461 1074 "First, we plot the graph of\n\n$$\ny = \\left(\\dfrac{1}{5}\\right)^x\n$$\n\n![](images/71/719e665784fe7ab17a0446e1ae1dae0d3acbcee30b8d4c5437003f9b93f954ce.png)\n\nNext, we plot the graph of\n\n$$\ny = 2\\left(\\dfrac{1}{5}\\right)^x\n$$\n\nTo do this, we scale the graph above by a factor of $2$. The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0$.\n\n![](images/ac/acf747ec793e13f14b10232c90d9a7dde80cfd414c278bbf5034a903e74b5f05.png)\n\nFinally, we plot the graph of\n\n$$\ny = 2\\left(\\dfrac{1}{5}\\right)^x + 1\n$$\n\nTo do this, we shift the above graph $1$ unit up. The $y$-intercept moves from $(0,2)$ to $(0,3)$, and the horizontal asymptote moves from $y=0$ to $y=1$.\n\n![](images/c3/c342bc5ec82b31bc9d6ae49d0ecc876f2796a29b7e6df2ee833d3c8723e713c9.png)" 13194139533346 17592186045585 true] [17592186068462 1069 "e-1228" 13194139533346 17592186045585 true] [17592186068462 1071 "The graph below shows the curve $y = k\\left(\\dfrac{1}{2}\\right)^{x}+c$. Determine the values of $k$ and $c$ and find the equation of the curve.\n\n![](images/3b/3bf9fe67940a4257bad36511847e5cdb91974993e3be6d113dbc62dadd782134.png)" 13194139533346 17592186045585 true] [17592186068462 1072 #uuid "5ab90279-394b-5df0-8bf3-a1042196b40c" 13194139533346 17592186045585 true] [17592186068462 1074 "The horizontal asymptote of the curve\n\n$$\ny=k\\left(\\dfrac{1}{2}\\right)^{x}+c\n$$\n\nis $y=c$. In the graph above, the horizontal asymptote is $y=-5$, hence $c=-5$.\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y$. The labeled point on the graph is $(0,-1)$, so we substitute $x=0$ and $y=-1$ into the function and solve for $k$:\n\n$$\n\\begin{aligned}\nk(\\frac{1}{2})^{x} + c &= y \\\\\nk(\\frac{1}{2})^{x} - 5 &= y \\\\\nk(\\frac{1}{2})^{0} - 5 &= -1 \\\\\nk - 5 &= -1 \\\\\nk &= 4\n\\end{aligned}\n$$\n\nTherefore, the equation of the curve is\n\n$$\ny = 4\\left(\\dfrac{1}{2}\\right)^{x} - 5\n$$" 13194139533346 17592186045585 true] [17592186068463 1069 "e-12450" 13194139533346 17592186045585 true] [17592186068463 1071 "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle$, calculate $\\mathbf r (3)$." 13194139533346 17592186045585 true] [17592186068463 1072 #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" 13194139533346 17592186045585 true] [17592186068463 1074 "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}\nr(3) &= ⟨6(3), 2(3)^{2} - 1⟩ \\\\\n&= ⟨18, 17⟩\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068464 1069 "e-12451" 13194139533346 17592186045585 true] [17592186068464 1071 "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t) = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle$," 13194139533346 17592186045585 true] [17592186068464 1072 #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" 13194139533346 17592186045585 true] [17592186068464 1074 "Evaluating the function at $t=4$, we get\n\n$$\n\\begin{aligned}\nr(4) &= ⟨2 - 4, 2\\sqrt{4}, 4 - 1⟩ \\\\\n&= ⟨ - 2, 4, 3⟩\n\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}\n\\mid r(4) \\mid &= \\sqrt{(-2)^{2} + (4)^{2} + (3)^{2}} \\\\\n&= \\sqrt{4 + 16 + 9} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068465 1069 "e-12452" 13194139533346 17592186045585 true] [17592186068465 1071 "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi$." 13194139533346 17592186045585 true] [17592186068465 1072 #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" 13194139533346 17592186045585 true] [17592186068465 1074 "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}\nf(π) &= ⟨\\cos π, \\sin π, π⟩ = ⟨ - 1, 0, π⟩\n\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle$.\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n$\\begin{bmatrix}-1 \\\\ 0 \\\\ π\\end{bmatrix}$" 13194139533346 17592186045585 true] [17592186068466 1069 "e-12869" 13194139533346 17592186045585 true] [17592186068466 1071 "Find the $y$-intercept of the line that passes through the point $(-1, 4)$ and has a slope of $2$." 13194139533346 17592186045585 true] [17592186068466 1072 #uuid "4ad21d3a-bf40-5b65-8ba6-320d853e6cff" 13194139533346 17592186045585 true] [17592186068466 1074 "Since the line passes through the point $(-1,4)$ and its slope is $2$, we substitute $x=-1$, $y=4$, and $m=2$ into the equation in slope-intercept form:\n\n$$\n\\begin{aligned} y &= mx + b \\\\ (4) &= (2)(-1) + b \\\\ 4 &= -2 + b \\\\ 6 &= b \\end{aligned}\n$$\n\nSo, the $y$-intercept is $b=6$. The coordinates of the $y$-intercept are $(0,6)$." 13194139533346 17592186045585 true] [17592186068467 1069 "e-12870" 13194139533346 17592186045585 true] [17592186068467 1071 "Find the equation of the line that passes through the points $(-2,4)$ and $(10,10)$." 13194139533346 17592186045585 true] [17592186068467 1072 #uuid "fdc3a6e9-080b-5e2a-b5a4-3af01c7018ff" 13194139533346 17592186045585 true] [17592186068467 1074 "We will write the equation of the line in the slope-intercept form\n\n$$\ny=mx+b\n$$\n\nSo, we need to work out the slope $m$ and the $y$-intercept $b$.\n\nFirst, we calculate the slope $m$ using the given points:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = (10 - 4)/(10 - (-2)) = \\frac{6}{12} = \\frac{1}{2}\n$$\n\nSubstituting the slope\n\n$$\nm=\\dfrac 1 2\n$$\n\ninto the slope-intercept formula\n\n$$\ny=mx+b\n$$\n\nwe reach\n\n$$\ny = \\dfrac 1 2 x + b\n$$\n\nWe now need to find the $y$-intercept $b$. We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(10,10)$:\n\n$$\n\\begin{aligned}\ny &= \\frac{1}{2}x + b \\\\\n10 &= \\frac{1}{2} \\cdot 10 + b \\\\\n10 &= 5 + b \\\\\nb &= 10 - 5 \\\\\nb &= 5\n\\end{aligned}\n$$\n\nTherefore, the equation of the line is\n\n$$\ny=\\dfrac 1 2 x + 5\n$$" 13194139533346 17592186045585 true] [17592186068468 1069 "e-12871" 13194139533346 17592186045585 true] [17592186068468 1071 "Calculate the $x$-intercept of the line that passes through the point $(-3,2)$ and has a slope of $-\\dfrac{1}{2}$." 13194139533346 17592186045585 true] [17592186068468 1072 #uuid "ec5bebf6-58d8-5b4d-900c-3c024628647c" 13194139533346 17592186045585 true] [17592186068468 1074 "First, we need to find the equation of the line. We know that\n\n$$\nm=-\\dfrac{1}{2}\n$$\n\nso we can write the equation of the line as\n\n$$\ny=-\\dfrac{1}{2}x + b\n$$\n\nIt remains to find the $y$-intercept of the line. We can do that by substituting the point $(-3,2)$ into the equation and solving for $b$ as follows:\n\n$$\n\\begin{aligned}\ny &= -\\frac{1}{2}x + b \\\\\n(2) &= -\\frac{1}{2}(-3) + b \\\\\n2 &= \\frac{3}{2} + b \\\\\n\\frac{1}{2} &= b\n\\end{aligned}\n$$\n\nSo, the equation of the line is\n\n$$\ny=-\\dfrac{1}{2}x+\\dfrac{1}{2}\n$$\n\nAt the $x$-intercept, the $y$-coordinate is equal to $0$. So, we can substitute $y=0$ into the equation and then solve for $x$:\n\n$$\n\\begin{aligned}\ny &= -\\frac{1}{2}x + \\frac{1}{2} \\\\\n0 &= -\\frac{1}{2}x + \\frac{1}{2} \\\\\n\\frac{1}{2}x &= \\frac{1}{2} \\\\\nx &= 1\n\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $x=1$. The coordinates of the $x$-intercept are $(1,0)$." 13194139533346 17592186045585 true] [17592186068469 1069 "e-12872" 13194139533346 17592186045585 true] [17592186068469 1071 "A vertical line $l$ passes through the point $(-6,3)$. Calculate the coordinates of the $x$-intercept of $l$." 13194139533346 17592186045585 true] [17592186068469 1072 #uuid "409dfb1f-7400-5539-9dea-6c2d1b6b7ef0" 13194139533346 17592186045585 true] [17592186068469 1074 "On any vertical line, all points have the same $x$-coordinate.\n\nThe $x$-coordinate of the point $(-6,3)$ is $-6$, so the $x$-coordinate of the $x$-intercept is also $-6$.\n\nTherefore, the coordinates of the $x$-intercept are $(-6,0)$." 13194139533346 17592186045585 true] [17592186068470 1069 "e-1331" 13194139533346 17592186045585 true] [17592186068470 1071 "Factor $9x^2+30x+25$." 13194139533346 17592186045585 true] [17592186068470 1072 #uuid "99376061-f11c-50f9-8c6e-e67ad640afd1" 13194139533346 17592186045585 true] [17592186068470 1074 "The \"square of a sum\" formula states that\n\n$$\na^2 + {\\color{red}{2}}a{\\color{blue}{b}} + {\\color{blue}b}^2 = (a+{\\color{blue}{b}})^2\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9x^2+30x+25\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n\n$$\n(3x)^{2} + 30x + (5)^{2}\n$$\n\nNext, we factor a $2$ out of the linear term:\n$(3x)^{2} + 2(15x) + (5)^{2}$\n\nThen, we write the middle parentheses $(15x)$ as a product of $3x$ and ${\\color{blue}5}$:\n$(3x)^{2} + 2(3x \\cdot 5) + (5)^{2}$\n\nFinally, we factor the trinomial using the square of sum formula with $a=3x$ and\n\n$$\n{\\color{blue}{b}} = {\\color{blue}{5}}\n$$\n\nThis gives\n$(3x + 5)^{2}$" 13194139533346 17592186045585 true] [17592186068471 1069 "e-1333" 13194139533346 17592186045585 true] [17592186068471 1071 "Factor the expression $7a^2+28a+28$." 13194139533346 17592186045585 true] [17592186068471 1072 #uuid "e9c8bdc9-696d-5a55-bb0d-d247008c5684" 13194139533346 17592186045585 true] [17592186068471 1074 "Before we start our normal process of factoring, notice that all of the terms have a common factor of $7$. Therefore, we can simplify the expression by factoring out $7$, as follows:\n\n$$\n\\begin{aligned}\n7a^{2} + 28a + 28 &=  \\\\\n&= 7(a^{2} + 4a + 4)\n\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of sum formula:\n\n$$\n\\begin{aligned}\na^{2} + 4a + 4 &=  \\\\\n&= a^{2} + 4a + 2^{2} \\\\\n&= a^{2} + 2 \\cdot 2a + 2^{2} \\\\\n&= (a + 2)^{2}\n\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}\n7(a^{2} + 4a + 4) &=  \\\\\n&= 7(a + 2)^{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068472 1069 "e-1334" 13194139533346 17592186045585 true] [17592186068472 1071 "Factor $-16y^2 + 4y - \\dfrac{1}{4}$." 13194139533346 17592186045585 true] [17592186068472 1072 #uuid "b74ed282-c54c-56f8-aa9f-8c5ef4465712" 13194139533346 17592186045585 true] [17592186068472 1074 "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1$ as follows:\n\n$$\n\\begin{aligned}\n-16y^{2} + 4y - \\frac{1}{4} &=  \\\\\n&= - (16y^{2} - 4y + \\frac{1}{4})\n\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the sum of difference formula:\n\n$$\n\\begin{aligned}\n16y^{2} - 4y + \\frac{1}{4} &=  \\\\\n(4y)^{2} - 4y + (\\frac{1}{2})^{2} &=  \\\\\n(4y)^{2} - 2 \\cdot (2y) + (\\frac{1}{2})^{2} &=  \\\\\n(4y)^{2} - 2 \\cdot (4y \\cdot \\frac{1}{2}) + (\\frac{1}{2})^{2} &=  \\\\\n&= (4y - \\frac{1}{2})^{2}\n\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}\n- (16y^{2} - 4y + \\frac{1}{4}) &=  \\\\\n&= - (4y - \\frac{1}{2})^{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068473 1069 "e-1357" 13194139533346 17592186045585 true] [17592186068473 1071 "Find $\\sqrt[3]{-8x^6}$." 13194139533346 17592186045585 true] [17592186068473 1072 #uuid "2ca53a08-7b11-552c-983f-96e7a392156c" 13194139533346 17592186045585 true] [17592186068473 1074 "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{-8x^{6}} &=  \\\\\n\\sqrt[3]{(-2x^{2}) \\cdot (-2x^{2}) \\cdot (-2x^{2})} &=  \\\\\n\\sqrt[3]{(-2x^{2})^{3}} &=  \\\\\n&= - 2x^{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068474 1069 "e-1358" 13194139533346 17592186045585 true] [17592186068474 1071 "Simplify $\\sqrt[3]{\\dfrac{a^3}{(b-1)^3}}$." 13194139533346 17592186045585 true] [17592186068474 1072 #uuid "c52719a7-544b-5844-b716-9b9d2999c028" 13194139533346 17592186045585 true] [17592186068474 1074 "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\n\\sqrt[3]{(a^{3})/((b - 1)^{3})} &=  \\\\\n\\sqrt[3]{(a)/((b - 1)) \\cdot (a)/((b - 1)) \\cdot (a)/((b - 1))} &=  \\\\\n\\sqrt[3]{(\\frac{a}{b - 1})^{3}} &=  \\\\\n&= \\frac{a}{b - 1}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068475 1069 "e-1363" 13194139533346 17592186045585 true] [17592186068475 1071 "Simplify $\\sqrt{18y^3}$ given that $y \\geq 0$." 13194139533346 17592186045585 true] [17592186068475 1072 #uuid "969be012-a830-564e-a355-00a4f1985ae8" 13194139533346 17592186045585 true] [17592186068475 1074 "We first write $18y^3$ as the product $9y^2\\cdot 2y$ which contains a perfect square $(9y^2)$. Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned} \\sqrt{18y^3} &= \\ \\sqrt{9y^2 \\cdot 2y} &= \\ \\sqrt{9y^2} \\cdot \\sqrt{2y} &= \\ \\sqrt{(3y)^2} \\cdot \\sqrt{2y} \\\\ &= \\begin{vmatrix}3y & \\cdot \\sqrt{2y} \\\\ &= & 3 & \\cdot & y & \\cdot \\sqrt{2y} \\\\ &= 3 \\cdot & y\\end{vmatrix} \\cdot \\sqrt{2y} \\end{aligned}\n$$\n\nSince\n\n$$\ny \\geq 0\n$$\n\nwe have\n\n$$\n\\begin{aligned}\n\\mid y &= y\n\\end{aligned}\n$$\n\nand we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned} 3 \\cdot \\mid y \\mid \\cdot \\sqrt{2y} \\\\ &= 3 \\cdot y \\cdot \\sqrt{2y} \\\\ &= 3y\\sqrt{2y}. & \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068476 1069 "e-1381" 13194139533346 17592186045585 true] [17592186068476 1071 "Given that $x\\geq1$, simplify $\\sqrt{4x^2 - 8x + 4}$." 13194139533346 17592186045585 true] [17592186068476 1072 #uuid "f0b8ca7a-8455-5ca3-acda-083dfcf01573" 13194139533346 17592186045585 true] [17592186068476 1074 "To simplify the radical expression, we factor the expression inside the radical and then simplify using the identity\n\n$$\n\\sqrt{a^2} = \\mid a \\mid\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n\\sqrt{4x^{2} - 8x + 4} &= \\sqrt{4 \\cdot (x^{2} - 2x + 1)} \\\\\n&= \\sqrt{4} \\cdot \\sqrt{x^{2} - 2x + 1} \\\\\n&= 2 \\cdot \\sqrt{x^{2} - 2x + 1} \\\\\n&= 2 \\cdot \\sqrt{x^{2} - 2 \\cdot 1 \\cdot x + 1^{2}} \\\\\n&= 2 \\cdot \\sqrt{(x - 1)^{2}} \\\\\n&= 2 \\mid x - 1 \\mid\n\\end{aligned}\n$$\n\nNow, since\n\n$$\nx \\geq 1\n$$\n\nwe have that\n\n$$\nx-1 \\geq 0 \\quad \\Longrightarrow\\quad \\mid x-1 \\mid = x-1\n$$\n\nTherefore, our expression simplifies to $2(x-1)$." 13194139533346 17592186045585 true] [17592186068477 1069 "e-1383" 13194139533346 17592186045585 true] [17592186068477 1071 "Simplify $\\sqrt{\\dfrac{x^2-4x+4}{x^2+6x+9}}$." 13194139533346 17592186045585 true] [17592186068477 1072 #uuid "2b49ad8e-f58f-54b4-9a7c-c26e5e63264a" 13194139533346 17592186045585 true] [17592186068477 1074 "To simplify the expression, we first factor the numerator and denominator under the radical:\n\n$$\n\\begin{aligned}\n\\sqrt{\\frac{x^{2} - 4x + 4}{x^{2} + 6x + 9}} &= \\sqrt{(x^{2} + 2 \\cdot x \\cdot (-2) + (-2)^{2})/(x^{2} + 2 \\cdot x \\cdot 3 + 3^{2})} \\\\\n&= \\sqrt{((x - 2)^{2})/((x + 3)^{2})}\n\\end{aligned}\n$$\n\nThen, by applying the quotient rule for radicals and the rules of absolute value, we get\n\n$$\n\\begin{aligned}\n\\sqrt{((x - 2)^{2})/((x + 3)^{2})} &= (\\sqrt{(x - 2)^{2}})/(\\sqrt{(x + 3)^{2}}) \\\\\n&= \\frac{\\begin{vmatrix}x - 2 &}{\\mid x + 3 \\mid} \\\\ = & \\frac{x - 2}{x + 3}\\end{vmatrix}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068478 1069 "e-13932" 13194139533346 17592186045585 true] [17592186068478 1071 "Solve the inequality $0 \\leq 3x+6 < 15$." 13194139533346 17592186045585 true] [17592186068478 1072 #uuid "0901e241-519b-50ee-ab5f-50b2f631e948" 13194139533346 17592186045585 true] [17592186068478 1074 "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned} 0 &\\leq 3x+6 < 15 \\\\[5pt] 0 - 6 &\\leq 3x + 6 -6 < 15-6 \\\\[5pt] -6 &\\leq 3x < 9 \\\\[5pt] \\dfrac{-6}{3} &\\leq \\dfrac{3x}{3} < \\dfrac{9}{3} \\\\[5pt] -2 &\\leq x < 3 \\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n-2 \\leq x < 3\n$$" 13194139533346 17592186045585 true] [17592186068479 1069 "e-13933" 13194139533346 17592186045585 true] [17592186068479 1071 "Solve the inequality $-1 < -2x + 1 \\leq 7$." 13194139533346 17592186045585 true] [17592186068479 1072 #uuid "8208b5ba-8c54-5c05-a9f4-04aa30f8892f" 13194139533346 17592186045585 true] [17592186068479 1074 "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{bmatrix}-1 & < - 2x + 1 \\le 7 \\\\ -1 - 1 & < - 2x + 1 - 1 \\le 7 - 1 \\\\ -2 & < - 2x \\le 6\\end{bmatrix}\n$$\n\nAt this point, we need to divide by $-2$. However, because we are dividing by a negative, we also need to flip the inequality signs.\n\n$$\n\\begin{bmatrix}-2 & < - 2x \\le 6 \\\\ \\frac{-2}{-2} & >\\frac{-2x}{-2}\\ge\\frac{6}{-2} \\\\ 1 & > x \\ge - 3\\end{bmatrix}\n$$\n\nThe solution can be written as\n\n$$\n1 > x \\geq - 3\n$$\n\nbut this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers:\n\n$$\n-3 \\leq x < 1\n$$" 13194139533346 17592186045585 true] [17592186068480 1069 "e-13935" 13194139533346 17592186045585 true] [17592186068480 1071 "Represent the solution to the inequality $-3 < 1-2x < 11$ using a number line." 13194139533346 17592186045585 true] [17592186068480 1072 #uuid "7f671658-055a-599d-8f1f-416570e604b6" 13194139533346 17592186045585 true] [17592186068480 1074 "We isolate $x$ by applying the addition and multiplication principles, as usual.\n\nFirst, we apply the addition principle:\n\n$$\n\\begin{bmatrix}-3 & < 1 - 2x < 11 \\\\ -3 - 1 & < 1 - 2x - 1 < 11 - 1 \\\\ -4 & < - 2x < 10\\end{bmatrix}\n$$\n\nThen, we divide by $-2$. Note that since we are dividing by a negative number, we need to flip the inequality signs.\n\n$$\n\\begin{bmatrix}-4 & < - 2x < 10 \\\\ \\frac{-4}{-2} & > \\frac{-2x}{-2} > \\frac{10}{-2} \\\\ 2 & > x > - 5\\end{bmatrix}\n$$\n\nThe solution can be written as $2 > x > -5$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers:\n\n$$\n-5 < x < 2\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](images/f5/f514a2aca3b3995ea2b1dc970a3b8f16a476ec0f9bb0178909d86ff670503354.png)" 13194139533346 17592186045585 true] [17592186068481 1069 "e-13966" 13194139533346 17592186045585 true] [17592186068481 1071 "Solve $2x^2 - 27=5$." 13194139533346 17592186045585 true] [17592186068481 1072 #uuid "fed35802-1128-5cb4-a91b-e98227dcfba8" 13194139533346 17592186045585 true] [17592186068481 1074 "First, we isolate the $x^2$ on one side of the equation:\n\n$$\n\\begin{aligned}\n2x^{2} - 27 &= 5 \\\\\n2x^{2} &= 32 \\\\\nx^{2} &= 16\n\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\n\\sqrt{x^{2}} &= \\sqrt{16} \\\\\n\\mid x \\mid &= 4 \\\\\nx &= ± 4\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068482 1069 "e-13968" 13194139533346 17592186045585 true] [17592186068482 1071 "Solve for $p$ where $4p^2 - 11 = 14$." 13194139533346 17592186045585 true] [17592186068482 1072 #uuid "6145c2d5-5d09-543c-8405-1319277323aa" 13194139533346 17592186045585 true] [17592186068482 1074 "First, we isolate the $p^2$ on one side of the equation:\n\n$$\n\\begin{aligned}\n4p^{2} - 11 &= 14 \\\\\n4p^{2} &= 25 \\\\\np^{2} &= \\frac{25}{4}\n\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\n\\sqrt{p^{2}} &= \\sqrt{\\frac{25}{4}} \\\\\n\\mid p \\mid &= \\frac{\\sqrt{25}}{\\sqrt{4}} \\\\\n\\mid p \\mid &= \\frac{5}{2} \\\\\np &= ± \\frac{5}{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068483 1069 "e-13970" 13194139533346 17592186045585 true] [17592186068483 1071 "Find $t$ if $2t^2 = 36$." 13194139533346 17592186045585 true] [17592186068483 1072 #uuid "9c00e3e1-9337-5380-af51-e7e8c7ae9f48" 13194139533346 17592186045585 true] [17592186068483 1074 "First, we isolate the $t^2$ on one side of the equation:\n\n$$\n\\begin{aligned} 2t^2 &= 36 \\\\ t^2 &= 18 \\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned} \\sqrt{t^2} &= \\sqrt{18} \\ \\vert t \\vert &= \\sqrt{18} \\ \\vert t \\vert &= \\sqrt{9 \\cdot 2} \\ \\vert t \\vert &= \\sqrt{9} \\cdot \\sqrt{2} \\ \\vert t \\vert &= 3\\sqrt{2} \\\\ t &= \\pm 3\\sqrt{2} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068484 1069 "e-13974" 13194139533346 17592186045585 true] [17592186068484 1071 "Find, in point-slope form, the equation of the line that passes through the point $(6,2)$ and has a slope of $4$." 13194139533346 17592186045585 true] [17592186068484 1072 #uuid "ccc054b8-db6c-5726-bb60-a744467a9f6d" 13194139533346 17592186045585 true] [17592186068484 1074 "Using $m=4$ and\n\n$$\n(x_1,y_1) = (6,2)\n$$\n\n, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 2 &= 4(x - 6)\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068485 1069 "e-13975" 13194139533346 17592186045585 true] [17592186068485 1071 "Find, in point-slope form, the equation of the straight line that passes through the points $(5,7)$ and $(1,-1)$." 13194139533346 17592186045585 true] [17592186068485 1072 #uuid "2b89eb42-8f10-57e8-aaa1-db4a2854c93e" 13194139533346 17592186045585 true] [17592186068485 1074 "We know that the line passes through the point $(5,7)$, so we can use\n\n$$\n(x_1,y_1) = (5,7)\n$$\n\nin our point-slope formula. All that remains is to compute $m$, and we can do this using the given points:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = \\frac{-1 - 7}{1 - 5} = \\frac{-8}{-4} = 2\n$$\n\nThen, we substitute $m=2$ and the point\n\n$$\n(x_1,y_1) = (5,7)\n$$\n\ninto the point-slope formula:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 7 &= 2(x - 5)\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068486 1069 "e-13978" 13194139533346 17592186045585 true] [17592186068486 1071 "Calculate the equation of the straight line that passes through the points $(1,10)$ and $(3,-2)$, giving your final answer in slope-intercept form." 13194139533346 17592186045585 true] [17592186068486 1072 #uuid "88378710-e983-5b10-b56b-40397480e460" 13194139533346 17592186045585 true] [17592186068486 1074 "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = \\frac{-2 - 10}{3 - 1} = \\frac{-12}{2} =-6\n$$\n\nThen, we substitute $m=-6$ and the point\n\n$$\n(x_1,y_1) = (1,10)\n$$\n\ninto the point-slope formula:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 10 &= -6(x - 1)\n\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}\ny - 10 &= -6(x - 1) \\\\\ny - 10 &= -6x + 6 \\\\\ny &= -6x + 16\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068487 1069 "e-14010" 13194139533346 17592186045585 true] [17592186068487 1071 "Find the point of intersection of the lines $y=5x+3$ and $y=x-1$ sketched below.\n\n![](images/e6/e63b2ac5fe2bdfb905fe3c86706be4a556e5322698f9fd26ee115dba0a886f4b.png)" 13194139533346 17592186045585 true] [17592186068487 1072 #uuid "5cf6d36a-0e67-5f16-befd-32d30cf4b930" 13194139533346 17592186045585 true] [17592186068487 1074 "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations\n\n$$\ny=5x+3\n$$\n\nand $y=x-1$. So, we need to solve the system of equations consisting of the two lines:\n\n$$\n{y = 5x + 3; y = x - 1\n$$\n\nWe will use the substitution method to solve the system. Substituting the first equation\n\n$$\ny=5x+3\n$$\n\ninto the second equation $y=x-1$ gives an equation that we can solve for $x$:\n\n$$\n\\begin{aligned}\n5x + 3 &= x - 1 \\\\\n5x &= x - 4 \\\\\n4x &= -4 \\\\\nx &= -1\n\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x = -1$ back into one of the equations, say $y=x-1$, as follows:\n\n$$\n\\begin{aligned}\ny &= x - 1 \\\\\n&=-1 - 1 \\\\\n&=-2\n\\end{aligned}\n$$\n\nTherefore, the solution to the system is\n\n$$\nx=-1, \\, y=-2\n$$\n\nSo, the coordinates of the intersection point are $(-1,-2)$." 13194139533346 17592186045585 true] [17592186068488 1069 "e-14012" 13194139533346 17592186045585 true] [17592186068488 1071 "Find the point of intersection of the lines $x + 2 y = 1$ and $2 x - y = 7$." 13194139533346 17592186045585 true] [17592186068488 1072 #uuid "7fe8c6a0-f152-5349-9152-b4c018368dbc" 13194139533346 17592186045585 true] [17592186068488 1074 "We need to solve the system of equations consisting of the two lines:\n\n$$\n{x + 2y = 1; 2x - y = 7\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $2$, then we will get a $-2y$ term that can cancel with the $2y$ term in the first equation:\n\n$$\n{x + 2y = 1; 2x - y = 7 \\mid \\mid \\cdot 2\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x$:\n\n$$\n\\begin{aligned}\nx + 2y &= 1 \\\\\n4x - 2y &= 14 \\\\\n(x + 4x) &= (1 + 14) \\\\\n5x &= 15 \\\\\nx &= 3\n\\end{aligned}\n$$\n\nFinally, we can substitute $x=3$ into the equation\n\n$$\nx+2y=1\n$$\n\nto solve for $y$:\n\n$$\n\\begin{aligned}\nx + 2y &= 1 \\\\\n3 + 2y &= 1 \\\\\n2y &= -2 \\\\\ny &= -1\n\\end{aligned}\n$$\n\nTherefore, the solution to the system is\n\n$$\nx=3, \\, y=-1\n$$\n\nSo the coordinates of the point of intersection are $(3,-1)$." 13194139533346 17592186045585 true] [17592186068489 1069 "e-14015" 13194139533346 17592186045585 true] [17592186068489 1071 "The lines $y = -3 x + a$ and $y = x - 1$ intersect at the point $C$ with coordinates $(b, -4)$. Find the parameters $a$ and $b$." 13194139533346 17592186045585 true] [17592186068489 1072 #uuid "cceef15c-a242-5486-a830-f6bdf9f07010" 13194139533346 17592186045585 true] [17592186068489 1074 "Since $(b,-4)$ is the point of intersection of the two lines, the values\n\n$$\nx=b, \\, y=-4\n$$\n\nmust solve the following system:\n\n$$\n{y =-3x + a; y = x - 1\n$$\n\nWe substitute\n\n$$\nx=b, \\, y=-4\n$$\n\nto obtain a new system:\n\n$$\n{-4 =-3b + a; - 4 = b - 1\n$$\n\nIn the second equation, we can solve for $b$:\n\n$$\n\\begin{aligned}\n-4 &= b - 1 \\\\\n- 3 &= b\n\\end{aligned}\n$$\n\nThen, we can substitute $b=-3$ into the first equation and solve for $a$:\n\n$$\n\\begin{aligned}\n-4 &= -3b + a \\\\\n- 4 &= -3(-3) + a \\\\\n- 4 &= 9 + a \\\\\n- 13 &= a\n\\end{aligned}\n$$\n\nTherefore, $a = -13$ and $b = -3$." 13194139533346 17592186045585 true] [17592186068490 1069 "e-1413" 13194139533346 17592186045585 true] [17592186068490 1071 "Use the difference of squares method to solve the equation $a^2 - 100 = 0$." 13194139533346 17592186045585 true] [17592186068490 1072 #uuid "8a5c740c-4719-5ebc-a5e3-0b82a2450521" 13194139533346 17592186045585 true] [17592186068490 1074 "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\na^{2} - 100 &= 0 \\\\\n(a)^{2} - (10)^{2} &= 0 \\\\\n(a - 10)(a + 10) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\na-10=0 \\qquad\\text{or}\\qquad a+10=0\n$$\n\nwhich in turn gives\n\n$$\na=10 \\qquad\\text{or}\\qquad a=-10\n$$\n\nTherefore, the solutions are\n\n$$\na = -10, 10\n$$\n\nWe can write this even more concisely as $a=\\pm 10$." 13194139533346 17592186045585 true] [17592186068491 1069 "e-1414" 13194139533346 17592186045585 true] [17592186068491 1071 "Solve the equation $4z^2 - 25 = 0$." 13194139533346 17592186045585 true] [17592186068491 1072 #uuid "74c951a8-5bd6-5296-af9e-4f7a5f4008c4" 13194139533346 17592186045585 true] [17592186068491 1074 "Using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\n4z^{2} - 25 &= 0 \\\\\n(2z)^{2} - (5)^{2} &= 0 \\\\\n(2z - 5)(2z + 5) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2z-5=0 \\qquad\\text{or}\\qquad 2z+5=0\n$$\n\nThen, we solve each equation separately:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}2z - 5 &= 0 & 2z + 5|= 0 \\\\ 2z|= 5 & 2z|=-5 \\\\ z|= \\frac{5}{2} & z|=-\\frac{5}{2}\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nz = -\\dfrac 5 2, \\dfrac 5 2\n$$\n\nWe can write this even more concisely as\n\n$$\nz=\\pm \\dfrac 5 2\n$$" 13194139533346 17592186045585 true] [17592186068492 1069 "e-14148" 13194139533346 17592186045585 true] [17592186068492 1071 "If $g(x) = (x-4)^2+3(5-x)$, calculate $g(2)$." 13194139533346 17592186045585 true] [17592186068492 1072 #uuid "38228952-21ef-5caf-9805-76e42ebf0caa" 13194139533346 17592186045585 true] [17592186068492 1074 "We substitute $x=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned} g(x) &= (x-4)^2+3(5-x) \\\\[5pt] g(2) &= (2-4)^2+3(5-2) \\\\[5pt] &= (-2)^2+3(3) \\\\[5pt] &= 4 + 9 \\\\[5pt] &= 13 \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068493 1069 "e-14150" 13194139533346 17592186045585 true] [17592186068493 1071 "Evaluate $f(4,-1)$ if $f(x,y)= 3\\cdot 2^{x+3y}$." 13194139533346 17592186045585 true] [17592186068493 1072 #uuid "4e06fa0b-f3f0-5e60-9a83-67a393b4cc07" 13194139533346 17592186045585 true] [17592186068493 1074 "We substitute $x=4$ and $y=-1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}\nf(x, y) &= 3 \\cdot 2^{x + 3y} \\\\\nf(4,-1) &= 3 \\cdot 2^{4 + 3(-1)} \\\\\n&= 3 \\cdot 2^{4 - 3} \\\\\n&= 3 \\cdot 2^{1} \\\\\n&= 3 \\cdot 2 \\\\\n&= 6\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068494 1069 "e-1416" 13194139533346 17592186045585 true] [17592186068494 1071 "For which values of $t$ is $-2t^2 -16 = -5 -3t^2$?" 13194139533346 17592186045585 true] [17592186068494 1072 #uuid "be3c2628-847c-5b00-a7ea-7881c8805aa8" 13194139533346 17592186045585 true] [17592186068494 1074 "First, we move all of the terms to the left-hand side and collect the like terms:\n\n$$\n\\begin{aligned}\n-2t^{2} - 16 &= -5 - 3t^{2} \\\\\n(-2t^{2} + 3t^{2}) + (-16 + 5) &= 0 \\\\\nt^{2} - 11 &= 0\n\\end{aligned}\n$$\n\nNow, using the difference of squares formula, we factor the left-hand side of our quadratic equation:\n\n$$\n\\begin{aligned}\nt^{2} - 11 &= 0 \\\\\nt^{2} - (\\sqrt{11})^{2} &= 0 \\\\\n(t - \\sqrt{11})(t + \\sqrt{11}) &= 0\n\\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\nt-\\sqrt{11}=0 \\qquad\\text{or}\\qquad t+\\sqrt{11}=0\n$$\n\nwhich in turn gives\n\n$$\nt=\\sqrt{11} \\qquad\\text{or}\\qquad t=-\\sqrt{11}\n$$\n\nTherefore, the solutions are\n\n$$\nt = -\\sqrt{11}, \\sqrt{11}\n$$\n\nWe can write this even more concisely as\n\n$$\nt=\\pm \\sqrt{11}\n$$" 13194139533346 17592186045585 true] [17592186068495 1069 "e-14216" 13194139533346 17592186045585 true] [17592186068495 1071 "Solve the equation $\\left\\vert 7x \\right\\vert = 21$." 13194139533346 17592186045585 true] [17592186068495 1072 #uuid "b5ef1eb1-4603-5d02-8478-94e8de89ad85" 13194139533346 17592186045585 true] [17592186068495 1074 "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\mid 7x \\mid = 7x$, we obtain:\n$\\mid 7x \\mid |= 21; 7x|= 21; \\frac{7x}{7}|= \\frac{21}{7}; x|= 3$\n- If $\\mid 7x \\mid = -7x$, we obtain:\n$\\mid 7x \\mid |= 21; - 7x|= 21; \\frac{-7x}{-7}|= \\frac{21}{-7}; x|=-3$\n\nTherefore, the solutions are $x=3$ and $x=-3$. We can write this more compactly as $x = \\pm 3$." 13194139533346 17592186045585 true] [17592186068496 1069 "e-14221" 13194139533346 17592186045585 true] [17592186068496 1071 "Solve the equation $\\mid 2x+9 \\mid = 15$." 13194139533346 17592186045585 true] [17592186068496 1072 #uuid "9dd0ea37-1775-577e-9e48-d82a50b28963" 13194139533346 17592186045585 true] [17592186068496 1074 "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\mid 2x+9 \\mid = 2x+9$, we obtain:\n$\\mid 2x + 9 \\mid |= 15; 2x + 9|= 15; 2x|= 6; \\frac{2x}{2}|= \\frac{6}{2}; x|= 3$\n- If $\\mid 2x+9 \\mid = -(2x+9)$, we obtain:\n$\\mid 2x + 9 \\mid |= 15; - (2x + 9)|= 15; - 2x - 9|= 15; - 2x|= 24; \\frac{-2x}{-2}|= \\frac{24}{-2}; x|=-12$\n\nTherefore, the solutions are $x=-12$ and $x=3$." 13194139533346 17592186045585 true] [17592186068497 1069 "e-14222" 13194139533346 17592186045585 true] [17592186068497 1071 "Solve the absolute value inequality $\\left\\vert\\dfrac{x-1}{6}\\right\\vert \\leq 1$." 13194139533346 17592186045585 true] [17592186068497 1072 #uuid "60c2e025-0b7e-5ac2-afec-adeb5f65eed1" 13194139533346 17592186045585 true] [17592186068497 1074 "We convert the absolute value inequality into a compound inequality to remove the absolute value.\n\nThe inequality specifies every number\n\n$$\n\\dfrac{x-1}{6}\n$$\n\nwhose distance from zero is less than or equal to $1$. This corresponds to the following compound inequality:\n\n$$\n-1 \\leq \\dfrac{x-1}{6} \\leq 1\n$$\n\nNow, we can solve the compound inequality using the usual methods.\n\n$$\n\\begin{bmatrix}-1 & \\le \\frac{x - 1}{6} \\le 1 \\\\ -6 & \\le x - 1 \\le 6 \\\\ -5 & \\le x \\le 7\\end{bmatrix}\n$$" 13194139533346 17592186045585 true] [17592186068498 1069 "e-14225" 13194139533346 17592186045585 true] [17592186068498 1071 "Solve the equation $\\mid 5-8y \\mid = 11$." 13194139533346 17592186045585 true] [17592186068498 1072 #uuid "9aa175ae-420f-5bef-855b-4f0aadbac062" 13194139533346 17592186045585 true] [17592186068498 1074 "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\mid 5-8y \\mid = 5-8y$, we obtain:\n$\\mid 5 - 8y \\mid |= 11; 5 - 8y|= 11; - 8y|= 6; \\frac{-8y}{-8}|= \\frac{6}{-8}; y|=-\\frac{3}{4}$\n- If $\\mid 5-8y \\mid = -(5-8y)$, we obtain:\n$\\mid 5 - 8y \\mid |= 11; - (5 - 8y)|= 11; - 5 + 8y|= 11; 8y|= 16; \\frac{8y}{8}|= \\frac{16}{8}; y|= 2$\n\nTherefore, the solutions are\n\n$$\ny=-\\dfrac34\n$$\n\nand $y=2$." 13194139533346 17592186045585 true] [17592186068499 1069 "e-14227" 13194139533346 17592186045585 true] [17592186068499 1071 "Solve the absolute value inequality $\\mid 12x - 5 \\mid \\ge 7$." 13194139533346 17592186045585 true] [17592186068499 1072 #uuid "8497ea21-c194-5bbf-b501-a0e9749d8dc8" 13194139533346 17592186045585 true] [17592186068499 1074 "We convert the absolute value inequality into a compound inequality to remove the absolute value.\n\nThe inequality specifies every number $12x - 5$ whose distance from zero is greater than or equal to $7$. This corresponds to the following compound inequality:\n\n$$\n12x - 5\\begin{vmatrix}\\le - 7 & or & 12x - 5\\end{vmatrix}\\ge 7\n$$\n\nNow, we can solve each inequality using the usual methods.\n\n$$\n\\begin{bmatrix}12x - 5 & \\le - 7 & 12x - 5 & \\ge 7 \\\\ 12x & \\le - 2 & 12x & \\ge 12 \\\\ x & \\le - \\frac{2}{12} & x & \\ge \\frac{12}{12} \\\\ x & \\le - \\frac{1}{6} & x & \\ge 1\\end{bmatrix}\n$$\n\nTherefore, the final solution is\n\n$$\nx\\begin{vmatrix}\\le - \\frac{1}{6} & or & x\\end{vmatrix}\\ge 1\n$$" 13194139533346 17592186045585 true] [17592186068500 1069 "e-14229" 13194139533346 17592186045585 true] [17592186068500 1071 "Solve the equation $\\left| \\dfrac{7}{2}z-2 \\right| = 3$." 13194139533346 17592186045585 true] [17592186068500 1072 #uuid "094b2695-32c7-55dd-b3e1-27afcd3a09c1" 13194139533346 17592186045585 true] [17592186068500 1074 "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $\\left| \\dfrac{7}{2}z-2 \\right| = \\dfrac{7}{2}z-2$, we obtain:\n$\\mid \\frac{7}{2}z - 2 \\mid |= 3; \\frac{7}{2}z - 2|= 3; \\frac{7}{2}z|= 5$\nMultiplying both sides of the equation by $\\dfrac{2}{7}$ gives\n$\\frac{7}{2}z|= 5; (\\frac{2}{7}) \\cdot (\\frac{7}{2}z)|= (\\frac{2}{7}) \\cdot (5); (\\frac{2}{7}) \\cdot (\\frac{7}{2}z)|= \\frac{10}{7}; z|= \\frac{10}{7}$.\n- If $\\left| \\dfrac{7}{2}z-2 \\right| = -\\left(\\dfrac{7}{2}z-2\\right)$, we obtain:\n$\\mid \\frac{7}{2}z - 2 \\mid |= 3; - (\\frac{7}{2}z - 2)|= 3; - \\frac{7}{2}z + 2|= 3; - \\frac{7}{2}z|= 1$\nMultiplying both sides of the equation by $-\\dfrac{2}{7}$ gives\n$-\\frac{7}{2}z|= 1; (-\\frac{2}{7}) \\cdot (-\\frac{7}{2}z)|= (-\\frac{2}{7}) \\cdot (1); (-\\frac{2}{7}) \\cdot (-\\frac{7}{2}z)|=-\\frac{2}{7}; z|=-\\frac{2}{7}$.\n\nTherefore, the solutions are\n\n$$\nz = -\\dfrac{2}{7}\n$$\n\nand\n\n$$\nz = \\dfrac{10}{7}\n$$" 13194139533346 17592186045585 true] [17592186068501 1069 "e-14246" 13194139533346 17592186045585 true] [17592186068501 1071 "What is the solution to the equation $6^x - 6^5= 0$?" 13194139533346 17592186045585 true] [17592186068501 1072 #uuid "4912a540-482c-51be-bdc4-8fb128ddfb77" 13194139533346 17592186045585 true] [17592186068501 1074 "First, we isolate the term with the variable exponent by adding $6^5$ to both sides:\n\n$$\n\\begin{aligned}\n6^{x} - 6^{5} &= 0 \\\\\n6^{x} - 6^{5} + 6^{5} &= 0 + 6^{5} \\\\\n6^{x} - 6^{5} + 6^{5} &= 0 + 6^{5} \\\\\n6^{x} &= 6^{5}\n\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(6)$, we can equate the exponents.\n\n$$\n\\begin{aligned}\n6^{x} &= 6^{5} \\\\\nx &= 5\n\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n{\\color{blue}x} = {\\color{blue}5}\n$$" 13194139533346 17592186045585 true] [17592186068502 1069 "e-14248" 13194139533346 17592186045585 true] [17592186068502 1071 "What is the solution to $3^x = \\dfrac{1}{9}$?" 13194139533346 17592186045585 true] [17592186068502 1072 #uuid "bc9650d4-c12f-5e7a-b0b2-aacca9a9d698" 13194139533346 17592186045585 true] [17592186068502 1074 "First, we rewrite $9$ as $3^2$ and then proceed as before:\n\n$$\n\\begin{aligned}\n3^{x} &= \\frac{1}{9} \\\\\n3^{x} &= \\frac{1}{3^{2}} \\\\\n3^{x} &= 3^{-2}\n\\end{aligned}\n$$\n\nSince both sides of the equation share the same base $(3)$, we equate the exponents and get $x=-2$." 13194139533346 17592186045585 true] [17592186068503 1069 "e-14252" 13194139533346 17592186045585 true] [17592186068503 1071 "Solve the equation $2\\cdot 3^x=54$." 13194139533346 17592186045585 true] [17592186068503 1072 #uuid "9a971439-a68b-58e5-a8f3-51045b2a0bf0" 13194139533346 17592186045585 true] [17592186068503 1074 "First, we divide both sides of the equation by $2$:\n\n$$\n\\begin{aligned}\n2 \\cdot 3^{x} &= 54 \\\\\n\\frac{2 \\cdot 3^{x}}{2} &= \\frac{54}{2} \\\\\n\\frac{2 \\cdot 3^{x}}{2} &= 27 \\\\\n3^{x} &= 27\n\\end{aligned}\n$$\n\nNow, we can rewrite $27$ as $3^3$ so that both sides have the same base:\n\n$$\n3^{x} = 3^{3}\n$$\n\nEquating the exponents, we get\n\n$$\n{\\color{blue}x}={\\color{blue}3}\n$$" 13194139533346 17592186045585 true] [17592186068504 1069 "e-1431" 13194139533346 17592186045585 true] [17592186068504 1071 "Write the equation $x^2 + 6x +5= 0$ in the form $(x+p)^2=q$, and hence solve the equation." 13194139533346 17592186045585 true] [17592186068504 1072 #uuid "a0cb3fb6-5ff3-5f4e-9bb9-35c88a22fd34" 13194139533346 17592186045585 true] [17592186068504 1074 "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}\nx^{2} + 6x + 5 &= 0 \\\\\nx^{2} + 6x &= -5 \\\\\nx^{2} + 2 \\cdot 3 \\cdot x &= -5 \\\\\nx^{2} + 2 \\cdot 3 \\cdot x + 3^{2} - 3^{2} &= -5 \\\\\n(x^{2} + 2 \\cdot 3 \\cdot x + 3^{2}) - 9 &= -5 \\\\\n(x + 3)^{2} - 9 &= -5\n\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}\n(x + 3)^{2} - 9 &= -5 \\\\\n(x + 3)^{2} &= -5 + 9 \\\\\n(x + 3)^{2} &= 4\n\\end{aligned}\n$$\n\nSo, $p=3$ and $q=4$. Now, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}\n(x + 3)^{2} &= 4 \\\\\n\\sqrt{(x + 3)^{2}} &= \\sqrt{4} \\\\\n\\mid x + 3 \\mid &= 2 \\\\\nx + 3 &= ± 2 \\\\\nx &= -3 ± 2\n\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}\nx_{1} &= -3 + 2 =-1 \\\\\nx_{2} &= -3 - 2 =-5\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068505 1069 "e-1432" 13194139533346 17592186045585 true] [17592186068505 1071 "Solve the equation $x^2-2x-1=0$." 13194139533346 17592186045585 true] [17592186068505 1072 #uuid "d53f36b5-fc95-55de-b716-789dd327d2f8" 13194139533346 17592186045585 true] [17592186068505 1074 "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}\nx^{2} - 2x - 1 &= 0 \\\\\nx^{2} - 2x &= 1 \\\\\nx^{2} - 2 \\cdot 1 \\cdot x &= 1 \\\\\nx^{2} - 2 \\cdot 1 \\cdot x + 1^{2} - 1^{2} &= 1 \\\\\n(x^{2} - 2x + 1) - 1 &= 1 \\\\\n(x - 1)^{2} - 1 &= 1\n\\end{aligned}\n$$\n\nThen, we isolate the perfect square and solve the equation using the square-root method:\n\n$$\n\\begin{aligned}\n(x - 1)^{2} - 1 &= 1 \\\\\n(x - 1)^{2} &= 2 \\\\\n\\sqrt{(x - 1)^{2}} &= \\sqrt{2} \\\\\n\\mid x - 1 \\mid &= \\sqrt{2} \\\\\nx - 1 &= ± \\sqrt{2} \\\\\nx &= 1 ± \\sqrt{2}\n\\end{aligned}\n$$\n\nTherefore, our solutions are\n\n$$\n\\begin{aligned}\nx_{1} &= 1 + \\sqrt{2}, \\\\\nx_{2} &= 1 - \\sqrt{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068506 1069 "e-1434" 13194139533346 17592186045585 true] [17592186068506 1071 "Solve for $x$ where $2x^2 - 3x - 5 = 0$." 13194139533346 17592186045585 true] [17592186068506 1072 #uuid "fe2f52aa-f883-5455-8d35-94ddc6a5cb1a" 13194139533346 17592186045585 true] [17592186068506 1074 "The coefficients of our quadratic equation are\n\n$$\na = 2, \\quad b = -3, \\quad c = -5\n$$\n\nSo, we substitute these values into the quadratic formula:\n\n$$\n\\begin{aligned} x &= \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\\\[5pt] &= \\dfrac{-(-3) \\pm \\sqrt{(-3)^2 - 4(2)(-5)}}{2(2)} \\\\[5pt] &= \\dfrac{3 \\pm \\sqrt{49}}{4} \\\\[5pt] &= \\dfrac{3 \\pm 7}{4} \\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}\nx &= \\frac{3 + 7}{4} = \\frac{10}{4} = \\frac{5}{2} \\\\\nx &= \\frac{3 - 7}{4} =-1\n\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-1$ and\n\n$$\nx=\\dfrac{5}{2}\n$$" 13194139533346 17592186045585 true] [17592186068507 1069 "e-1435" 13194139533346 17592186045585 true] [17592186068507 1071 "Solve the equation $x^2 + 2x = 6$." 13194139533346 17592186045585 true] [17592186068507 1072 #uuid "e1662bab-c11d-5770-8b7d-6646902f7e20" 13194139533346 17592186045585 true] [17592186068507 1074 "The first step is to put the equation into standard form:\n\n$$\n\\begin{aligned}\nx^{2} + 2x &= 6 \\\\\nx^{2} + 2x - 6 &= 0\n\\end{aligned}\n$$\n\nThe coefficients of our quadratic equation are\n\n$$\na = 1, \\quad b = 2, \\quad c = -6\n$$\n\nNow, we substitute these values into the quadratic formula:\n\n$$\n\\begin{aligned} x &= \\dfrac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\\\[5pt] &= \\dfrac{-(2) \\pm \\sqrt{(2)^2 - 4(1)(-6)}}{2(1)} \\\\[5pt] &= \\dfrac{-2 \\pm \\sqrt{28}}{2} \\\\[5pt] &= \\dfrac{-2 \\pm 2\\sqrt{7}}{2} \\\\[5pt] &= -1 \\pm \\sqrt{7} \\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nx = -1 + \\sqrt{7}\n$$\n\nand\n\n$$\nx = -1 - \\sqrt{7}\n$$" 13194139533346 17592186045585 true] [17592186068508 1069 "e-1436" 13194139533346 17592186045585 true] [17592186068508 1071 "What are the solutions to $3x^2 = x - 10$?" 13194139533346 17592186045585 true] [17592186068508 1072 #uuid "9812207c-cb3b-5522-a08a-c0bf4672a22e" 13194139533346 17592186045585 true] [17592186068508 1074 "The first step is to put the equation into standard form. This gives\n\n$$\n\\begin{aligned}\n3x^{2} - x + 10 &= 0\n\\end{aligned}\n$$\n\nThe coefficients are\n\n$$\na = 3, \\quad b = -1, \\quad c = 10\n$$\n\nNow, we substitute these values into the quadratic formula:\n\n$$\n\\begin{aligned}\nx &= \\frac{-b ± \\sqrt{b^{2} - 4ac}}{2a} \\\\\n&= (- (-1) ± \\sqrt{(-1)^{2} - 4(3)(10)})/(2(3)) \\\\\n&= \\frac{1 ± \\sqrt{1 - 120}}{6} \\\\\n&= \\frac{1 ± \\sqrt{-119}}{6}\n\\end{aligned}\n$$\n\nFrom here, we can see that the equation has no real solutions because $\\sqrt{-119}$ is not a real number." 13194139533346 17592186045585 true] [17592186068509 1069 "e-1445" 13194139533346 17592186045585 true] [17592186068509 1071 "Identify the equation of the graph shown below.\n\n![](images/36/36a2a45f6078cdf04b798c39b6382c1f40411375a3f16ef77e996b39aa0009b3.png)" 13194139533346 17592186045585 true] [17592186068509 1072 #uuid "9c2447fb-d21a-553f-bc38-243ef63696ec" 13194139533346 17592186045585 true] [17592186068509 1074 "Remember that the graph of\n\n$$\ny=(x-h)^2+k\n$$\n\nis a translation of the standard parabola $y=x^2$ by\n\n- $h$ units right, and\n- $k$ units up.\n\nThe vertex of\n\n$$\ny=(x-h)^2+k\n$$\n\nis located at $(h,k)$.\n\nHere, the parabola is translated $2$ units *left*, so we have $h=-2$. The parabola is also translated $1$ unit up, so we have $k=1$. We can also see that the vertex is at $(-2,1)$, so again we must have $h=-2$ and $k=1$.\n\nTherefore, the equation of the graph is:\n\n$$\n\\begin{aligned}\ny &= (x - (-2))^{2} + 1 \\\\\ny &= (x + 2)^{2} + 1\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068510 1069 "e-14574" 13194139533346 17592186045585 true] [17592186068510 1071 "Calculate $\\displaystyle \\int \\dfrac{1}{x^2-2x + 3}\\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068510 1072 #uuid "648e9e50-03bf-56ba-a4ad-caf142c9628a" 13194139533346 17592186045585 true] [17592186068510 1074 "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned} x^2-2x + 3 & = x^2 - 2 \\cdot x+ (1^2 - 1^2) + 3 \\\\[3pt] & = (x^2 - 2 \\cdot x+ 1^2) - 1 + 3 \\\\[3pt] & = (x-1)^2+2 \\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{x^{2} - 2x + 3}dx &= \\int(1)/((x - 1)^{2} + 2)dx \\\\\n&= \\frac{1}{2}\\int(1)/(1 + ((x - 1)/\\sqrt{2})^{2})dx\n\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\dfrac{1}{1+u^2} \\, \\textrm{d}u = \\arctan u + C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have\n\n$$\n\\left(\\dfrac{x-1}{\\sqrt{2}}\\right)\n$$\n\nSo, let's perform the substitution\n\n$$\nu=\\dfrac{x-1}{\\sqrt{2}}\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=\\dfrac{1}{\\sqrt{2}} \\quad\\Longrightarrow\\quad \\textrm{d}x = \\sqrt{2}\\,\\textrm{d}u\n$$\n\nFinally, we write the integral in terms of $u$, and evaluate:\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{x^{2} - 2x + 3}dx &= \\frac{1}{2}\\int(1)/(1 + ((x - 1)/\\sqrt{2})^{2})dx \\\\\n&= \\frac{1}{2}\\int\\frac{1}{1 + u^{2}} \\cdot \\sqrt{2}du \\\\\n&= \\frac{\\sqrt{2}}{2}\\int\\frac{1}{1 + u^{2}}du \\\\\n&= \\frac{\\sqrt{2}}{2}\\arctan u + C \\\\\n&= \\frac{\\sqrt{2}}{2}\\arctan (\\frac{x - 1}{\\sqrt{2}}) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068511 1069 "e-14575" 13194139533346 17592186045585 true] [17592186068511 1071 "Calculate ${\\displaystyle \\int \\dfrac{1}{\\sqrt{4x - 4x^2}} \\, \\textrm{d}x}$." 13194139533346 17592186045585 true] [17592186068511 1072 #uuid "77952d82-6a9b-5a6b-921e-32cbe82ea298" 13194139533346 17592186045585 true] [17592186068511 1074 "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}\n4x - 4x^{2} &= - (4x^{2} - 4x) \\\\\n&= - ((2x)^{2} - 2 \\cdot 2x + 1 - 1) \\\\\n&= - ((2x - 1)^{2} - 1) \\\\\n&= 1 - (2x - 1)^{2}\n\\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{\\sqrt{4x - 4x^{2}}}dx &= \\int(1)/(\\sqrt{1 - (2x - 1)^{2}})dx\n\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\,\\textrm{d}u = \\arcsin u+C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(2x - 1)$.\n\nSo, let's perform the substitution\n\n$u =2x - 1$.\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=2 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\dfrac12\\textrm{d}u\n$$\n\nFinally, we write the integral in terms of $u$, and evaluate:\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{\\sqrt{4x - 4x^{2}}}dx &= \\int(1)/(\\sqrt{1 - (2x - 1)^{2}})dx \\\\\n&= \\int\\frac{1}{\\sqrt{1 - u^{2}}} \\cdot \\frac{1}{2}du \\\\\n&= \\frac{1}{2}\\int\\frac{1}{\\sqrt{1 - u^{2}}}du \\\\\n&= \\frac{1}{2}\\arcsin u + C \\\\\n&= \\frac{1}{2}\\arcsin (2x - 1) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068512 1069 "e-14576" 13194139533346 17592186045585 true] [17592186068512 1071 "Evaluate the integral $\\displaystyle{\\displaystyle \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{\\mid x-1 \\mid \\sqrt{x^2-2x}}\\, \\textrm{d}x}$." 13194139533346 17592186045585 true] [17592186068512 1072 #uuid "4e0188f0-4d2b-5f3c-b1bd-12270e3adc0f" 13194139533346 17592186045585 true] [17592186068512 1074 "First, we complete the square for the expression inside the square root:\n\n$$\n\\begin{aligned} x^2-2x&= x^2 -2x +(1-1) \\\\[3pt] &= (x^2 -2x +1)-1 \\\\[3pt] &= (x-1)^2-1 \\end{aligned}\n$$\n\nSubstituting the above in the given integral, we get\n\n$$\n\\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{\\begin{vmatrix}x-1 & \\sqrt{x^2-2x}}\\, \\textrm{d}x = \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{\\mid x-1\\end{vmatrix}\\sqrt{(x-1)^2-1}}\\, \\textrm{d}x\n$$\n\nThis resembles the basic integral for inverse secant:\n\n$$\n\\int \\frac{1}{\\mid u \\mid \\sqrt{u^2-1}} \\, \\textrm{d}u = \\textrm{arcsec} \\, u +C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $x-1$.\n\nSo, let's perform the substitution\n$u=x-1$.\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=1 \\quad\\Longrightarrow\\quad \\textrm{d}x = \\textrm{d}u\n$$\n\nLet's use the table below to change the limits from $x$ to $u$.\n\n| $x$ | $1+\\dfrac{2}{\\sqrt{3}}$ | $3$ |\n| --- | ---: | ---: |\n| $u$ | $\\dfrac{2}{\\sqrt{3}}$ | $2$ |\n\nTherefore,\n\n$$\n\\begin{aligned} \\int_{1+2/\\sqrt{3}}^{3} \\dfrac{1}{\\begin{vmatrix}x-1 & \\sqrt{x^2-2x}}\\, \\textrm{d}x &= \\int_{1+2/\\sqrt{3}}^{3}\\dfrac{1}{\\begin{vmatrix}x-1 & \\sqrt{(x-1)^2-1}}\\,\\textrm{d}x \\\\[5pt] &=\\int_{2/\\sqrt{3}}^{2} \\dfrac{1}{\\end{vmatrix}u\\end{vmatrix}\\sqrt{u^2-1}}\\, \\textrm{d}u \\\\[5pt] &= \\left.\\textrm{arcsec}\\, {u}\\Big\\right|_{2/\\sqrt{3}}^{2} \\\\[5pt] &= \\textrm{arcsec} \\left(2\\right) - \\textrm{arcsec}\\left(\\dfrac{2}{\\sqrt{3}} \\right) \\\\[5pt] &=\\left(\\dfrac{\\pi}{3}-\\dfrac{\\pi}{6}\\right) \\\\[5pt] &=\\dfrac{\\pi}{6}. \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068513 1069 "e-14577" 13194139533346 17592186045585 true] [17592186068513 1071 "Calculate $\\displaystyle \\int \\dfrac{1}{\\sqrt{36 -(3x - 2)^2}} \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068513 1072 #uuid "4b6820ef-32a8-5d26-84f6-a464db90129a" 13194139533346 17592186045585 true] [17592186068513 1074 "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\n\\int(1)/(\\sqrt{36 - (3x - 2)^{2}})dx &= \\int(1)/(\\sqrt{36(1 - (3x - 2)^{2}/36)})dx \\\\\n&= \\int(1)/(\\sqrt{36} \\cdot \\sqrt{1 - (3x - 2)^{2}/36})dx \\\\\n&= \\int(1)/(6\\sqrt{1 - (3x - 2)^{2}/36})dx \\\\\n&= \\frac{1}{6}\\int(1)/(\\sqrt{1 - (3x - 2)^{2}/36})dx \\\\\n&= \\frac{1}{6}\\int(1)/(\\sqrt{1 - ((3x - 2)/6)^{2}})dx\n\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse sine:\n\n$$\n\\int \\dfrac{1}{\\sqrt{1-u^2}}\\,\\textrm{d}u = \\arcsin u + C\n$$\n\nThe only difference is that instead of $u$ as the variable, we have\n\n$$\n\\left(\\dfrac{3x-2}{6}\\right)\n$$\n\nSo, let's perform the substitution\n\n$$\nu=\\dfrac{3x-2}{6}\n$$\n\nDifferentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x} = \\dfrac{1}{2} \\quad \\Longrightarrow \\quad \\textrm{d}x = 2\\,\\textrm{d}u\n$$\n\nFinally, we write the integral in terms of $u$, and evaluate:\n\n$$\n\\begin{aligned}\n\\int(1)/(\\sqrt{36 - (3x - 2)^{2}})dx &= \\frac{1}{6}\\int(1)/(\\sqrt{1 - ((3x - 2)/6)^{2}})dx \\\\\n&= \\frac{1}{6}\\int\\frac{1}{\\sqrt{1 - u^{2}}} \\cdot 2du \\\\\n&= \\frac{1}{3}\\arcsin u + C \\\\\n&= \\frac{1}{3}\\arcsin (\\frac{3x - 2}{6}) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068514 1069 "e-14706" 13194139533346 17592186045585 true] [17592186068514 1071 "![](images/24/245e1658a21f0424b61514777512bd2fb935103a798b6496b492fd55bab8277b.png)\n\nWhat is the length of $\\overline{AB}$?" 13194139533346 17592186045585 true] [17592186068514 1072 #uuid "ca739248-c388-531e-ba5f-7f9cce2aa70b" 13194139533346 17592186045585 true] [17592186068514 1074 "From the figure, we note that the points $A$ and $B$ have coordinates $x_{1}$ and $x_{2}$ respectively.\n\nTo find the length of $\\overline{AB}$, we use the distance formula:\n\n$$\n\\begin{aligned} AB &= \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2} \\\\[3pt] &= \\sqrt{(7 - 1)^2 + (-2 - 5)^2} \\\\[3pt] &= \\sqrt{(6)^2 + (-7)^2} \\\\[3pt] &= \\sqrt{36 + 49} \\\\[3pt] &= \\sqrt{85}. \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068515 1069 "e-14707" 13194139533346 17592186045585 true] [17592186068515 1071 "What is the distance between the points $(-9, 6)$ and $(13, 6)$?" 13194139533346 17592186045585 true] [17592186068515 1072 #uuid "303019d6-7004-5de8-92e3-1119d4829ca8" 13194139533346 17592186045585 true] [17592186068515 1074 "In this case, we have $x_{1}$ and $x_{2}$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned} d &= \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2} \\\\[3pt] &= \\sqrt{(13 - (-9))^2 + (6 - 6)^2} \\\\[3pt] &= \\sqrt{(22)^2 + (0)^2} \\\\[3pt] &= \\sqrt{22^2} \\\\[3pt] &= 22 \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068516 1069 "e-14708" 13194139533346 17592186045585 true] [17592186068516 1071 "Solve the absolute value inequality $\\vert 10 - 2x \\vert +1 < 5$." 13194139533346 17592186045585 true] [17592186068516 1072 #uuid "12d8aea9-62dd-5181-bd6e-54c11eba4152" 13194139533346 17592186045585 true] [17592186068516 1074 "First, we isolate the absolute value on the left side of the inequality:\n\n$$\n\\begin{vmatrix}10 - 2x & + 1\\end{vmatrix}< 5; \\mid 10 - 2x \\mid \\mid < 4\n$$\n\nNow, we convert the absolute value inequality into a compound inequality to remove the absolute value.\n\nThe inequality specifies every number $10-2x$ whose distance from zero is less than $4$. This corresponds to the following compound inequality:\n\n$$\n-4 < 10 - 2x < 4\n$$\n\nNow, we can solve the compound inequality using the usual methods. (Remember that whenever we multiply or divide by a negative number, we have to flip the inequality signs.)\n\n$$\n\\begin{bmatrix}-4 < 10 - 2x & < 4 \\\\ -14 < - 2x & < - 6 \\\\ 14 > 2x & > 6 \\\\ 7 > x & > 3\\end{bmatrix}\n$$\n\nTo make the final result easier to read, we will rewrite it so that the smaller number is on the left:\n\n$$\n3 < x < 7\n$$" 13194139533346 17592186045585 true] [17592186068517 1069 "e-14827" 13194139533346 17592186045585 true] [17592186068517 1071 "Solve for $n$ where $n^2 +12n = 0$." 13194139533346 17592186045585 true] [17592186068517 1072 #uuid "580ca72e-31ba-591c-a5c4-08234ac9d2e0" 13194139533346 17592186045585 true] [17592186068517 1074 "First, we factor the left-hand side.\n\n$$\n\\begin{aligned}\nn^{2} + 12n &= 0 \\\\\nn(n + 12) &= 0\n\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\nn=0 \\qquad\\text{or}\\qquad n+12=0\n$$\n\nwhich in turn gives\n\n$$\nn=0 \\qquad\\text{or}\\qquad n=-12\n$$\n\nTherefore, the solutions are $n=-12,0$." 13194139533346 17592186045585 true] [17592186068518 1069 "e-14829" 13194139533346 17592186045585 true] [17592186068518 1071 "Solve $3p^2 = 5p$." 13194139533346 17592186045585 true] [17592186068518 1072 #uuid "8e7b0730-4273-5eef-a9a3-4a9e91c62ff4" 13194139533346 17592186045585 true] [17592186068518 1074 "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned} 3p^2 &= 5p \\\\[3pt] 3p^2 - 5p &= 0 \\\\[3pt] p(3p - 5) &= 0 \\end{aligned}\n$$\n\nSo, by the zero product rule, we have\n\n$$\np=0 \\qquad\\text{or}\\qquad 3p-5=0\n$$\n\nwhich in turn gives\n\n$$\np=0 \\qquad\\text{or}\\qquad p=\\dfrac{5}{3}\n$$\n\nTherefore, the solutions are\n\n$$\np=0,\\dfrac{5}{3}\n$$" 13194139533346 17592186045585 true] [17592186068519 1069 "e-14831" 13194139533346 17592186045585 true] [17592186068519 1071 "Solve the equation $6x^2 +2x -2= 8x^2- x -2$." 13194139533346 17592186045585 true] [17592186068519 1072 #uuid "4003ea24-f1cf-5abb-a3cb-033f8a11a6cb" 13194139533346 17592186045585 true] [17592186068519 1074 "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}\n6x^{2} + 2x - 2 &= 8x^{2} - x - 2 \\\\\n6x^{2} + 2x - 2 - (8x^{2} - x - 2) &= 0 \\\\\n6x^{2} + 2x - 2 - 8x^{2} + x + 2 &= 0 \\\\\n(6x^{2} - 8x^{2}) + (2x + x) + (-2 + 2) &= 0 \\\\\n- 2x^{2} + 3x + 0 &= 0 \\\\\n- 2x^{2} + 3x &= 0 \\\\\nx(-2x + 3) &= 0\n\\end{aligned}\n$$\n\nSo, by the zero product rule, we have\n\n$$\nx=0 \\qquad\\text{or}\\qquad -2x + 3=0\n$$\n\nwhich in turn gives\n\n$$\nx=0 \\qquad\\text{or}\\qquad x=\\dfrac{3}{2}\n$$\n\nTherefore, the solutions are\n\n$$\nx=0,\\dfrac{3}{2}\n$$" 13194139533346 17592186045585 true] [17592186068520 1069 "e-14917" 13194139533346 17592186045585 true] [17592186068520 1071 "Plot the graph of $y=-\\mid x \\mid +4$." 13194139533346 17592186045585 true] [17592186068520 1072 #uuid "c75694b3-1a12-5b24-ae68-fd02ba71fb11" 13194139533346 17592186045585 true] [17592186068520 1074 "Remember that\n\n$$\ny=-\\mid x \\mid +k\n$$\n\nis a reflected absolute value graph\n\n$$\ny=-\\mid x \\mid\n$$\n\nthat is translated $k$ units up.\n\nThe given function\n\n$$\ny=-\\mid x \\mid +4\n$$\n\nhas $k=4$. Therefore, it is a reflected absolute value graph\n\n$$\ny=-\\mid x \\mid\n$$\n\nthat is translated $4$ units up.\n\n![](images/34/3434025dad2723a27ca397e1a9efe23d2b38e004f48c1db8eb8b43afc1e3be47.png)" 13194139533346 17592186045585 true] [17592186068521 1069 "e-14920" 13194139533346 17592186045585 true] [17592186068521 1071 "Plot the graph of $y=-\\mid x+2 \\mid$." 13194139533346 17592186045585 true] [17592186068521 1072 #uuid "69089e30-2e7f-52dc-a334-f3cf5d7dcfe6" 13194139533346 17592186045585 true] [17592186068521 1074 "Remember that\n\n$$\ny=-\\mid x-h \\mid\n$$\n\nis a reflected absolute value graph\n\n$$\ny=-\\mid x \\mid\n$$\n\nthat is translated $h$ units right.\n\nThe given function\n\n$$\ny=-\\mid x+2 \\mid\n$$\n\nhas $h=-2$. To see this clearly, we can write the curve as follows:\n\n$$\n\\begin{aligned}\ny &= -\\mid x + 2 \\mid \\\\\ny &= -\\mid x - (-2) \\mid\n\\end{aligned}\n$$\n\nTherefore, the given curve is a reflected absolute value graph\n\n$$\ny=-\\mid x \\mid\n$$\n\nthat is translated $2$ units *left*.\n\n![](images/96/96cc8a3d41988c6ababa07c8cd2110fb030bcfbc170fbac40be57ed42133271c.png)" 13194139533346 17592186045585 true] [17592186068522 1069 "e-14929" 13194139533346 17592186045585 true] [17592186068522 1071 "Plot the graph of $y=-\\mid x+5 \\mid +6$." 13194139533346 17592186045585 true] [17592186068522 1072 #uuid "72cf578b-17f7-5e7f-b058-1d066d825f10" 13194139533346 17592186045585 true] [17592186068522 1074 "Remember that\n\n$$\ny=-\\mid x-h \\mid +k\n$$\n\nis a reflected absolute value graph\n\n$$\ny=-\\mid x \\mid\n$$\n\nthat is translated $h$ units right and $k$ units up.\n\nThe given function\n\n$$\ny=-\\mid x+5 \\mid +6\n$$\n\nhas $h=-5$ and $k=6$. Therefore, it is a reflected absolute value graph\n\n$$\ny=-\\mid x \\mid\n$$\n\nthat is translated $5$ units *left* and $6$ units up.\n\n![](images/7c/7c536ca25f60ed4fb1b073ec4cc4d13d012cb052be389c03e6ef3cb99efa88b4.png)" 13194139533346 17592186045585 true] [17592186068523 1069 "e-1522" 13194139533346 17592186045585 true] [17592186068523 1071 "What is $\\dfrac{x+2}{2x}$ reduced to lowest terms?" 13194139533346 17592186045585 true] [17592186068523 1072 #uuid "dd115134-c197-57af-9e2c-fc15bd37e1fb" 13194139533346 17592186045585 true] [17592186068523 1074 "The numerator and denominator have no common factors, so the expression can not be reduced. The expression\n\n$$\n\\dfrac{x+2}{2x}\n$$\n\nis already in lowest terms." 13194139533346 17592186045585 true] [17592186068524 1069 "e-1549" 13194139533346 17592186045585 true] [17592186068524 1071 "What is $\\dfrac {2x + 4} {2}$ reduced to lowest terms?" 13194139533346 17592186045585 true] [17592186068524 1072 #uuid "9c3000e9-ed61-52d5-a2eb-c2cc75f4f843" 13194139533346 17592186045585 true] [17592186068524 1074 "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\n\\frac{2x + 4}{2} &= (2(x + 2))/(2) \\\\\n&= (2(x + 2))/(2 \\cdot 1) \\\\\n&= \\frac{x + 2}{1} \\\\\n&= x + 2\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068525 1069 "e-1587" 13194139533346 17592186045585 true] [17592186068525 1071 "The graph below shows the curve $y=\\left(\\dfrac{1}{4} \\right)^{x} + c$. Determine the value of $c$ and find the equation of the curve.\n\n![](images/25/257c44bbc3762968aee94b2612f489af9f2eda7eb8b5473d5d20f6f3f989cbc9.png)" 13194139533346 17592186045585 true] [17592186068525 1072 #uuid "20a59278-1d09-5519-a362-4634ac9d5144" 13194139533346 17592186045585 true] [17592186068525 1074 "The horizontal asymptote of\n\n$$\ny = \\left(\\dfrac{1}{4} \\right)^x\n$$\n\nis $y = 0$.\n\nThe vertical translation\n\n$$\ny=\\left(\\dfrac{1}{4} \\right)^x+c\n$$\n\nshifts the asymptote to $y=c$.\n\nIn the graph above, the horizontal asymptote is $y=1$. Therefore, $c=1$." 13194139533346 17592186045585 true] [17592186068526 1069 "e-1593" 13194139533346 17592186045585 true] [17592186068526 1071 "Factor $9y^2-12y+4$." 13194139533346 17592186045585 true] [17592186068526 1072 #uuid "b7141e58-61cf-5134-8443-a82d79a5506e" 13194139533346 17592186045585 true] [17592186068526 1074 "The \"square of a difference\" formula states that\n\n$$\na^2 - {\\color{red}{2}}a{\\color{blue}{b}} + {\\color{blue}b}^2 = (a-{\\color{blue}{b}})^2\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9y^2-12y+4\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n$(3y)^{2} - 12y + (2)^{2}$\n\nNext, we factor a $2$ out of the linear term:\n$(3y)^{2} - 2(6y) + (2)^{2}$\n\nThen, we write the middle parentheses $(6y)$ as a product of $3y$ and ${\\color{blue}2}$:\n$(3y)^{2} - 2(3y \\cdot 2) + (2)^{2}$\n\nFinally, we factor the trinomial using the square of difference formula with $a=3y$ and\n\n$$\n{\\color{blue}{b}} = {\\color{blue}{2}}\n$$\n\nThis gives\n$(3y - 2)^{2}$" 13194139533346 17592186045585 true] [17592186068527 1069 "e-1695" 13194139533346 17592186045585 true] [17592186068527 1071 "Simplify the union of intervals $(-\\infty,2) \\cup [-1,3]$." 13194139533346 17592186045585 true] [17592186068527 1072 #uuid "9cf4daed-1d80-5a74-90dc-b0b1da0ce6b9" 13194139533346 17592186045585 true] [17592186068527 1074 "If we plot these two intervals on number lines, we get the following:\n\n![](images/27/2720cafe76aff8eb85ca65851570087505ee57a4b51904ee075aa86436cfc475.png)\n\n![](images/c3/c379dc0e0c371832a53e62da4505cfc0b03df50efc7241c0100794a191c8fb97.png)\n\nThe union of the two intervals consists of all the points which are contained within at least one of the intervals. So, to graph the union of the two intervals, we take the graphs of the individual intervals and lay them on top of each other.\n\nThe resulting graph is as follows:\n\n![](images/c4/c43257d8d30711804848039b3b8458302e0030e7512fb7cbf1f4b697263e5155.png)\n\nThis graph represents the interval $(-\\infty,3]$. So, the union $(-\\infty,2) \\cup [-1,3]$ simplifies to the interval $(-\\infty,3]$." 13194139533346 17592186045585 true] [17592186068528 1069 "e-1720" 13194139533346 17592186045585 true] [17592186068528 1071 "Find the value of $435 \\times 435$." 13194139533346 17592186045585 true] [17592186068528 1072 #uuid "305d15c0-d681-57dd-8b52-cf043f76faac" 13194139533346 17592186045585 true] [17592186068528 1074 "We write it this way:\n\n$$\n4\\begin{vmatrix}3 & 5 \\\\ \\cdot & 0\\end{vmatrix}0\\begin{vmatrix}0 & 4 & 3 & 5\\end{vmatrix}2, 175 + 13, 050 + 174, 000 =\n$$\n\nFirst, we multiply the ones:\n\n$$\n[math]\\color{blue}1[/math]\\begin{vmatrix}[math]\\color{blue}2[/math] \\\\ 4\\end{vmatrix}3\\begin{vmatrix}5 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 4 & 3\\end{vmatrix}5; 2\\begin{vmatrix}1 & 7 & 5\\end{vmatrix}435 \\cdot 5 = 2, 175000000000\n$$\n\nNext, we multiply the tens:\n\n$$\n[math]\\color{blue}1[/math]; [math]\\color{blue}1[/math]\\begin{vmatrix}[math]\\color{blue}1[/math] \\\\ [math]\\color{blue}2[/math] \\\\ 4\\end{vmatrix}3\\begin{vmatrix}5 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 4 & 3\\end{vmatrix}5; 2\\begin{vmatrix}1 & 7 & 5 \\\\ 1 & 3 & 0\\end{vmatrix}5 \\mid 0 \\mid 435 \\cdot 30 = 13, 05000000000\n$$\n\nNext, we multiply the hundreds:\n\n$$\n[math]\\color{blue}1[/math]; [math]\\color{blue}1[/math]; [math]\\color{blue}1[/math]\\begin{vmatrix}[math]\\color{blue}2[/math] \\\\ [math]\\color{blue}1[/math] \\\\ [math]\\color{blue}2[/math] \\\\ 4\\end{vmatrix}3\\begin{vmatrix}5 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 4 & 3\\end{vmatrix}5; 2\\begin{vmatrix}1 & 7 & 5 \\\\ 1 & 3 & 0\\end{vmatrix}5\\begin{vmatrix}0 \\\\ 1\\end{vmatrix}7\\begin{vmatrix}4 & 0 & 0 & 0\\end{vmatrix}435 \\cdot 400 = 174, 000000000\n$$\n\nFinally, we add the results:\n\n$$\n[math]\\color{blue}1[/math]; [math]\\color{blue}1[/math]; [math]\\color{blue}1[/math]\\begin{vmatrix}[math]\\color{blue}2[/math] \\\\ [math]\\color{blue}1[/math] \\\\ [math]\\color{blue}2[/math] \\\\ 4\\end{vmatrix}3\\begin{vmatrix}5 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 4 & 3\\end{vmatrix}5; 2\\begin{vmatrix}1 & 7 & 5 \\\\ + & 1 & 3\\end{vmatrix}0\\begin{vmatrix}5 & 0 \\\\ + & 1\\end{vmatrix}7\\begin{vmatrix}4 & 0 & 0 & 0 \\\\ 1 & 8 & 9 & 2\\end{vmatrix}2 \\mid 5 \\mid 2, 175 + 13, 050 + 174, 000 =; = 189, 225\n$$\n\nTherefore,\n\n$$\n435 \\times 435 = 189, 225\n$$" 13194139533346 17592186045585 true] [17592186068529 1069 "e-1721" 13194139533346 17592186045585 true] [17592186068529 1071 "What are the missing digits in the following multiplication problem?\n\n$1\\begin{vmatrix}8 & 0 \\\\ \\cdot & 0\\end{vmatrix}0\\begin{vmatrix}0 & 5 & 1\\end{vmatrix}1; 1\\begin{vmatrix}8 & 0 \\\\ + & 1\\end{vmatrix}8\\begin{vmatrix}0 & 0 \\\\ + & 9\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 0 \\\\ 9 & [math]\\phantom{i}[/math] & [math]\\phantom{i}[/math]\\end{vmatrix}[math]\\phantom{i}[/math] \\mid 0$" 13194139533346 17592186045585 true] [17592186068529 1072 #uuid "81ed7fa8-e611-57f4-b8a9-e479cba3477f" 13194139533346 17592186045585 true] [17592186068529 1074 "We write it this way:\n\n$$\n1\\begin{vmatrix}8 & 0 \\\\ \\cdot & 0\\end{vmatrix}0\\begin{vmatrix}0 & 5 & 1 & 1\\end{vmatrix}180 + 1, 800 + 90, 000 =\n$$\n\nFirst, we multiply the ones:\n\n$$\n[math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ 1\\end{vmatrix}8\\begin{vmatrix}0 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 5 & 1\\end{vmatrix}1; 1\\begin{vmatrix}8 & 0\\end{vmatrix}180 \\cdot 1 = 18000000,\n$$\n\nNext, we multiply the tens:\n\n$$\n[math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ 1\\end{vmatrix}8\\begin{vmatrix}0 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 5 & 1\\end{vmatrix}1; 1\\begin{vmatrix}8 & 0 \\\\ 1 & 8\\end{vmatrix}0 \\mid 0 \\mid 180 \\cdot 10 = 1, 800000,\n$$\n\nNext, we multiply the hundreds:\n\n$$\n[math]\\color{blue}4[/math]; [math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ 1\\end{vmatrix}8\\begin{vmatrix}0 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 5 & 1\\end{vmatrix}1; 1\\begin{vmatrix}8 & 0 \\\\ 1 & 8\\end{vmatrix}0\\begin{vmatrix}0 \\\\ 9\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 0\\end{vmatrix}180 \\cdot 500 = 90, 0000,\n$$\n\nFinally, we add the results:\n\n$$\n[math]\\color{blue}4[/math]; [math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ 1\\end{vmatrix}8\\begin{vmatrix}0 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 5 & 1\\end{vmatrix}1; 1\\begin{vmatrix}8 & 0 \\\\ + & 1\\end{vmatrix}8\\begin{vmatrix}0 & 0 \\\\ + & 9\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 0 \\\\ 9 & 1 & 9\\end{vmatrix}8 \\mid 0 \\mid 180 + 1, 800 + 90, 000 =; = 91, 980\n$$\n\nTherefore, the missing digits are $1$, $9$ and $8$." 13194139533346 17592186045585 true] [17592186068530 1069 "e-1722" 13194139533346 17592186045585 true] [17592186068530 1071 "Richard has $504$ boxes stored in a warehouse. Each box contains $240$ plates. How many plates in total are there in the warehouse?" 13194139533346 17592186045585 true] [17592186068530 1072 #uuid "75c8e810-6bf5-5513-b690-4bc07fdd9b84" 13194139533346 17592186045585 true] [17592186068530 1074 "To find the total number of plates stored in the warehouse, we need to calculate $504 \\times 240$.\n\nWe write it this way:\n\n$$\n5\\begin{vmatrix}0 & 4 \\\\ \\cdot & 0\\end{vmatrix}0\\begin{vmatrix}0 & 2 & 4 & 0\\end{vmatrix}0 + 20, 160 + 100, 800 =\n$$\n\nFirst, we multiply the ones:\n\n$$\n[math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ 5\\end{vmatrix}0\\begin{vmatrix}4 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 2 & 4\\end{vmatrix}0; 0\\begin{vmatrix}0 & 0\\end{vmatrix}504 \\cdot 0 = 00000000000\n$$\n\nNext, we multiply the tens:\n\n$$\n[math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}1[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ 5\\end{vmatrix}0\\begin{vmatrix}4 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 2 & 4\\end{vmatrix}0; 0\\begin{vmatrix}0 & 0 \\\\ 2 & 0\\end{vmatrix}1\\begin{vmatrix}6 & 0\\end{vmatrix}504 \\cdot 40 = 20, 1600000\n$$\n\nNext, we multiply the hundreds:\n\n$$\n[math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}1[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ 5\\end{vmatrix}0\\begin{vmatrix}4 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 2 & 4\\end{vmatrix}0; 0\\begin{vmatrix}0 & 0 \\\\ 2 & 0\\end{vmatrix}1\\begin{vmatrix}6 & 0 \\\\ 1 & 0\\end{vmatrix}0\\begin{vmatrix}8 & 0 & 0\\end{vmatrix}504 \\cdot 200 = 100, 80000\n$$\n\nFinally, we add the results:\n\n$$\n[math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]; [math]\\color{blue}\\phantom{0}[/math]\\begin{vmatrix}[math]\\color{blue}\\phantom{0}[/math] \\\\ [math]\\color{blue}1[/math] \\\\ [math]\\color{blue}\\phantom{0}[/math] \\\\ 5\\end{vmatrix}0\\begin{vmatrix}4 \\\\ \\cdot\\end{vmatrix}0\\begin{vmatrix}0 & 0 & 2 & 4\\end{vmatrix}0; 0\\begin{vmatrix}0 & 0 \\\\ + & 2\\end{vmatrix}0\\begin{vmatrix}1 & 6 & 0 \\\\ + & 1 & 0\\end{vmatrix}0\\begin{vmatrix}8 & 0 & 0 \\\\ 1 & 2 & 0\\end{vmatrix}9\\begin{vmatrix}6 & 0\\end{vmatrix}0 + 20, 160 + 100, 800 =; = 120, 960\n$$\n\nHence,\n\n$$\n504 \\times 240 = 120, 960\n$$\n\nTherefore, Richard has $120,960$ plates in the warehouse." 13194139533346 17592186045585 true] [17592186068531 1069 "e-1793" 13194139533346 17592186045585 true] [17592186068531 1071 "Identify the equation that generated the graph below.\n\n![](images/90/9051b7b34f3b88cbc9b08e0be2ae36b955a081f9cb81a85f667aa6076e3e1859.png)" 13194139533346 17592186045585 true] [17592186068531 1072 #uuid "8106f0ee-a91b-5535-bc05-fe874dc661f2" 13194139533346 17592186045585 true] [17592186068531 1074 "Remember that in general, the graph of\n\n$$\ny=x^2+k\n$$\n\nlooks like the standard parabola $y=x^2$ but translated $k$ units up. The vertex of\n\n$$\ny=x^2+k\n$$\n\nis located at $(0,k)$.\n\nHere, the curve shown is the parabola $y=x^2$ after being translated $3$ units upward. The vertex is located at $(0,3)$.\n\nTherefore, $k=3$, and the equation of the parabola is\n\n$$\ny = x^2 +3\n$$" 13194139533346 17592186045585 true] [17592186068532 1069 "e-1794" 13194139533346 17592186045585 true] [17592186068532 1071 "Sketch the graph of the function $y=(x+3)^2$. What are the coordinates of the minimum point?" 13194139533346 17592186045585 true] [17592186068532 1072 #uuid "a301e57f-0f6f-5078-a2fb-7c39fef91f3d" 13194139533346 17592186045585 true] [17592186068532 1074 "In general, the graph of $y=(x-h)^2$ looks like the standard parabola $y=x^2$ but translated $h$ units right. The vertex of $y=(x-h)^2$ is located at $(h,0)$.\n\nIn the given function\n\n$$\ny=(x+3)^2\n$$\n\nwe have $h=-3$. To see this clearly, we can write the curve as follows:\n\n$$\n\\begin{aligned}\ny &= (x + 3)^{2} \\\\\ny &= (x - (-3))^{2}\n\\end{aligned}\n$$\n\nTherefore, the given curve is the parabola $y=x^2$ after being translated $3$ units *left*.\n\n![](images/bf/bffdacd979eaa77a7a64364840ab318bcc4a1c39ca78137146e82f37540e02e4.png)\n\nThe vertex is located at $(-3,0)$, and these are the coordinates of the minimum point." 13194139533346 17592186045585 true] [17592186068533 1069 "e-18969" 13194139533346 17592186045585 true] [17592186068533 1071 "Find the area of a circle inscribed in a square with sides of length $18\\,\\textrm{m}$." 13194139533346 17592186045585 true] [17592186068533 1072 #uuid "780d1576-f68a-5bb2-a13d-5613d239e186" 13194139533346 17592186045585 true] [17592186068533 1074 "![](images/c8/c835620833e8814cad234d0ec91c03673ac016b5fa7e6f27d4b72fd452b41235.png)\n\nThe side of the square is $18 \\: \\textrm{m}$, which means that the diameter $d$ of the circle is\n\n$$\nd = 18 \\: \\textrm{m}\n$$\n\nThus, the radius $r$ of the circle is\n\n$$\nr = \\dfrac{d}{2} = \\dfrac{18}{2} = 9 \\: \\textrm{m}\n$$\n\nTherefore, the area of the circle is\n\n$$\n\\begin{aligned}\nA &= πr^{2} \\\\\n&= π(9)^{2} \\\\\n&= 81πm^{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068534 1069 "e-18995" 13194139533346 17592186045585 true] [17592186068534 1071 "The circumference of a circle inscribed in a square is $7\\pi$. What is the area of the square?" 13194139533346 17592186045585 true] [17592186068534 1072 #uuid "b44a3cbb-937f-5ac1-b59f-4b3eac00d587" 13194139533346 17592186045585 true] [17592186068534 1074 "![](images/c8/c835620833e8814cad234d0ec91c03673ac016b5fa7e6f27d4b72fd452b41235.png)\n\nThe formula for a circle's circumference is $C = \\pi d$, where $d$ is the diameter. So, we can find the diameter as follows:\n\n$$\n\\begin{aligned}\nd &= \\frac{C}{π} \\\\\n&= \\frac{7π}{π} \\\\\n&= 7\n\\end{aligned}\n$$\n\nThe diameter of the circle is $7$, which means that the side $s$ of the square is\n$s = 7$.\n\nTherefore, the area of the square is\n\n$$\n\\mathcal{A} = s^2 = (7)^2 = 49\n$$" 13194139533346 17592186045585 true] [17592186068535 1069 "e-18996" 13194139533346 17592186045585 true] [17592186068535 1071 "The area of a circle inscribed in a square is $32\\pi \\,\\textrm{mm}^2$. Find the diagonal of the square." 13194139533346 17592186045585 true] [17592186068535 1072 #uuid "94fac2d5-5413-5d1c-8f4a-eb914d749474" 13194139533346 17592186045585 true] [17592186068535 1074 "![](images/86/864676a13c102c547c8b4937d9eb2f8b3422340688630452611a7f111e489bb0.png)\n\nThe area of a circle is given by\n\n$$\n\\mathcal{A} = \\pi r^2\n$$\n\nSubstituting the known area and solving for the radius $r$, we get\n\n$$\n\\begin{aligned}\nA &= πr^{2} \\\\\n32π &= πr^{2} \\\\\n32π &= πr^{2} \\\\\n32 &= r^{2}\n\\end{aligned}\n$$\n\nand taking the square root gives\n\n$$\n\\begin{aligned}\nr &= \\sqrt{32} \\\\\n&= \\sqrt{16 \\cdot 2} \\\\\n&= \\sqrt{16} \\cdot \\sqrt{2} \\\\\n&= 4\\sqrt{2}\n\\end{aligned}\n$$\n\nTherefore, the radius of the circle equals $4\\sqrt 2\\,\\textrm{mm}$.\n\nThe length $s$ of the square's side equals the diameter of the inscribed circle, and the diameter is twice the radius. Therefore,\n\n$$\n\\begin{aligned}\ns &= 2r \\\\\n&= 2(4\\sqrt{2}) \\\\\n&= 8\\sqrt{2}mm\n\\end{aligned}\n$$\n\nFinally, the length $d$ of the square's diagonal is\n\n$$\n\\begin{aligned}\nd &= s\\sqrt{2} \\\\\n&= 8\\sqrt{2} \\cdot \\sqrt{2} \\\\\n&= 8 \\cdot 2 \\\\\n&= 16mm\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068536 1069 "e-19825" 13194139533346 17592186045585 true] [17592186068536 1071 "${x = 6; x =-3y^{2} + 2y + 4$\nSolve the system of equations shown above." 13194139533346 17592186045585 true] [17592186068536 1072 #uuid "bfde89f5-1ff2-50f5-8df2-62ab4a1fae38" 13194139533346 17592186045585 true] [17592186068536 1074 "First, we set the equations equal and solve for $y{:}$\n\n$$\n\\begin{aligned}\n-3y^{2} + 2y + 4 &= 6 \\\\\n- 3y^{2} + 2y - 2 &= 0 \\\\\n3y^{2} - 2y + 2 &= 0\n\\end{aligned}\n$$\n\nIn the obtained quadratic equation, we have\n\n$$\na = 3, \\qquad b = -2, \\qquad c = 2\n$$\n\nSo, the discriminant of the quadratic is\n\n$$\n\\begin{aligned}\nD &= b^{2} - 4ac \\\\\n&= (-2)^{2} - 4(3)(2) \\\\\n&= 4 - 24 \\\\\n&=-20 \\\\\n&< 0\n\\end{aligned}\n$$\n\nSince the discriminant is less than zero, we conclude that the system has no real solutions." 13194139533346 17592186045585 true] [17592186068537 1069 "e-19826" 13194139533346 17592186045585 true] [17592186068537 1071 "${y = x - 4; y = x^{2} - 5x + 5$\nFind the solution $(x, y)$ of the system above." 13194139533346 17592186045585 true] [17592186068537 1072 #uuid "b5227b5e-f8c1-5716-927d-4fbeeff455ca" 13194139533346 17592186045585 true] [17592186068537 1074 "First, we set the equations equal and solve for $x{:}$\n\n$$\n\\begin{aligned}\nx^{2} - 5x + 5 &= x - 4 \\\\\nx^{2} - 6x + 9 &= 0 \\\\\n(x - 3)^{2} &= 0 \\\\\nx - 3 &= 0 \\\\\nx &= 3\n\\end{aligned}\n$$\n\nNow, we substitute this into the first equation:\n\n$$\n\\begin{aligned}\ny &= x - 4 \\\\\n&= 3 - 4 \\\\\n&=-1\n\\end{aligned}\n$$\n\nTherefore, the solution is $\\big(3, -1 \\big)$." 13194139533346 17592186045585 true] [17592186068538 1069 "e-19827" 13194139533346 17592186045585 true] [17592186068538 1071 "${6x - 4y^{2} = 2x; x = 2y^{2} - 5y$\nIf $(x,y)$ is a solution of the system above such that $y \\ne 0$, what is the value of $\\dfrac{x}{y}$?" 13194139533346 17592186045585 true] [17592186068538 1072 #uuid "c6aee8e7-e123-501f-9fe9-071470a83f28" 13194139533346 17592186045585 true] [17592186068538 1074 "First, we simplify the first equation:\n\n$$\n\\begin{aligned}\n6x - 4y^{2} &= 2x \\\\\n4x - 4y^{2} &= 0 \\\\\n4x &= 4y^{2} \\\\\nx &= y^{2}\n\\end{aligned}\n$$\n\nNext, from the second equation, we have\n\n$$\nx = 2y^2 - 5y\n$$\n\nWe substitute this into the first equation:\n\n$$\n\\begin{aligned}\nx &= y^{2} \\\\\n2y^{2} - 5y &= y^{2} \\\\\ny^{2} - 5y &= 0 \\\\\ny(y - 5) &= 0 \\\\\ny &= 0, 5\n\\end{aligned}\n$$\n\nNow, we substitute $y$ into $x=y^2$.\n\n- For $y_1=0$, we get\n$x_{1}|= y_{1}^{2}; = (0)^{2}; = 0$.\n- For $y_2=5$, we get\n$x_{2}|= y_{2}^{2}; = (5)^{2}; = 25$.\n\nTherefore, the solutions are\n\n$$\n(x_1,y_1) = (0,0) \\qquad\\text{and}\\qquad (x_2,y_2) = (25,5)\n$$\n\nFinally, since we require the solution such that\n\n$$\ny \\ne 0\n$$\n\nwe have that\n\n$$\n\\begin{aligned}\n\\frac{x}{y} &= \\frac{x_{2}}{y_{2}} \\\\\n&= \\frac{25}{5} \\\\\n&= 5\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068539 1069 "e-2" 13194139533346 17592186045585 true] [17592186068539 1071 "Find $\\lim_\\limits{x\\rightarrow \\,0} f(x)$ for the function below.\n\n![](images/c0/c0ed78e2e640611d70263e17a76eb4a13e9e2816efba02494b53e540d38065d6.png)" 13194139533346 17592186045585 true] [17592186068539 1072 #uuid "fb401fbe-a718-5ea7-b598-139ef837b047" 13194139533346 17592186045585 true] [17592186068539 1074 "As $x$ approaches $0$, the value of $f(x)$ approaches $1$. Consequently,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0}f(x)= 1\\,\n$$\n\nRemember, it does not matter that the actual value of $f(0)$ is $2$. All that matters is that as $x$ approaches $0$, the function $f(x)$ *looks like* it is getting closer and closer to $1$." 13194139533346 17592186045585 true] [17592186068540 1069 "e-3" 13194139533346 17592186045585 true] [17592186068540 1071 "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below?\n\n1. $\\lim_\\limits{x\\rightarrow \\,0}f(x)=0$\n2. $\\lim_\\limits{x\\rightarrow \\,3}f(x)=0$\n3. $\\lim_\\limits{x\\rightarrow \\,-1}f(x)=\\lim_\\limits{x\\rightarrow \\,1}f(x)$\n\n![](images/68/68241f3cd913cd91d10765499dc4ce4398fb3e8a81ec4bcfb65b47c0d77731d6.png)" 13194139533346 17592186045585 true] [17592186068540 1072 #uuid "ab95d805-958c-5de3-99bd-41368cc57080" 13194139533346 17592186045585 true] [17592186068540 1074 "Let's analyze each statement in turn.\n\n- Statement I is false. As $x$ approaches $0$, the function $f(x)$ approaches the value $y=-1$. Consequently,\n$\\lim_\\limits{x\\rightarrow \\,0}f(x)=-1$.\n- Statement II is true. As $x$ approaches $3$, the function $f(x)$ approaches the value $y=0$. Consequently,\n$\\lim_\\limits{x\\rightarrow \\,3}f(x)=0$.\n- Statement III is false. As $x$ approaches $-1$ the function $f(x)$ approaches the value $y=2$, and consequently\n$\\lim_\\limits{x\\rightarrow \\,-1}f(x)=2$.\nSimiliarly, as $x$ approaches $1$, the function $f(x)$ approaches the value $y=-2$, and consequently\n$\\lim_\\limits{x\\rightarrow \\,1}f(x)=-2$.\nAs a result,\n$\\lim_\\limits{x\\rightarrow \\,-1}f(x)\\ne\\lim_\\limits{x\\rightarrow \\,1}f(x)$.\n\nIn conclusion, only statement II is true." 13194139533346 17592186045585 true] [17592186068541 1069 "e-300" 13194139533346 17592186045585 true] [17592186068541 1071 "Calculate $\\displaystyle \\lim_{x\\rightarrow 3}\\dfrac{x^3-27}{x-3}$." 13194139533346 17592186045585 true] [17592186068541 1072 #uuid "a316177e-e646-576c-bcab-d6cb0a450a03" 13194139533346 17592186045585 true] [17592186068541 1074 "Note that plugging in $x=3$ gives the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\nHowever, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned} \\lim_{x\\to 3} \\dfrac {x^3-27}{x-3} &= \\lim_{x\\to3} \\dfrac {[x^3-27]'}{[x-3]'} \\\\[5pt] &= \\lim_{x\\to 3} \\dfrac {3x^2}{1} \\\\[5pt] &= 3(3)^2 \\\\[5pt] &= 27 \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068542 1069 "e-301" 13194139533346 17592186045585 true] [17592186068542 1071 "Evaluate $\\displaystyle \\lim_{x\\to 0} \\, \\frac {\\sin^2 (2x)}{x^2}$." 13194139533346 17592186045585 true] [17592186068542 1072 #uuid "95c88e72-86e2-5627-b121-beafc7986d76" 13194139533346 17592186045585 true] [17592186068542 1074 "If we plug in $x=0$ we get the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\nso we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned} \\lim_{x\\to0} \\dfrac{\\sin^2 (2x)}{x^2} &= \\lim_{x\\to 0} \\dfrac {\\left[\\sin^2 (2x)\\right]'}{[x^2]'} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{2\\cdot \\sin (2x) \\cdot\\cos (2x)\\cdot 2}{2x} \\\\[5pt] &= \\lim_{x\\to 0}{2\\cos (2x)} \\cdot \\lim_{x\\to 0} \\dfrac{\\sin (2x)}{x} \\\\[5pt] &= 2\\cos(2\\cdot 0)\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x} \\\\[5pt] &= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x} \\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\nBut that's okay, because we can just apply L'Hopital's rule again! We get\n\n$$\n\\begin{aligned} \\lim_{x\\to0} \\dfrac{\\sin^2 (2x)}{x^2} &= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x} \\\\[5pt] &= 2\\lim_{x\\to0} \\dfrac {[\\sin (2x)]'}{[x]'} \\\\[5pt] &= 2\\lim_{x\\to0} \\dfrac {2\\cos (2x)}{1} \\\\[5pt] &= 4\\cos(2\\cdot 0) \\\\ &=4. \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068543 1069 "e-302" 13194139533346 17592186045585 true] [17592186068543 1071 "Evaluate $\\displaystyle \\lim_{x\\to 0} \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)}$." 13194139533346 17592186045585 true] [17592186068543 1072 #uuid "b9a1c3de-68cb-5e07-a71b-41f9ac77c832" 13194139533346 17592186045585 true] [17592186068543 1074 "Here the limits of the numerator and denominator are\n\n$$\n\\displaystyle \\lim_{x\\to 0} \\ln\\left(x^2\\right) = -\\infty\n$$\n\nand\n\n$$\n\\displaystyle \\lim_{x\\to 0} \\dfrac{2}{x^2} = \\infty\n$$\n\nrespectively,\nso we have the case\n\n$$\n\\dfrac{-\\infty}{\\infty}\n$$\n\n.\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned} \\lim_{x\\to 0} \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)} &= \\lim_{x\\to 0} \\dfrac{[\\ln\\left(x^2\\right)]'}{\\left(\\dfrac{2}{x^2}\\right)'} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{\\left(1/x^2\\right)\\cdot 2x}{-\\left({4}/{x^3}\\right)} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{x^{-2} \\cdot 2x}{-4x^{-3}} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{2x^{-1}}{-4x^{-3}} \\\\[5pt] &= -\\dfrac{1}{2} \\lim_{x\\to 0} {x^2} \\\\[5pt] &= -\\dfrac{1}{2}\\cdot 0 \\\\[5pt] &= 0. \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068544 1069 "e-303" 13194139533346 17592186045585 true] [17592186068544 1071 "Evaluate ${\\displaystyle \\lim_{x\\to\\infty} \\frac {x^6}{5x^6-4}}$." 13194139533346 17592186045585 true] [17592186068544 1072 #uuid "8e96079a-3933-5562-a4f5-ddd87ac5d05f" 13194139533346 17592186045585 true] [17592186068544 1074 "In this case, we have an indeterminate form of type\n\n$$\n\\dfrac{\\infty}{\\infty}\n$$\n\nso applying L'Hopital's rule yields\n\n$$\n\\begin{aligned} \\lim_{x\\to \\infty} \\dfrac {x^6}{5x^6-4} &= \\lim_{x\\to\\infty} \\dfrac {[x^6]'}{[5x^6-4]'} \\\\ &= \\lim_{x\\to \\infty} \\dfrac {6x^5}{5(6x^5)-0} \\\\ &= \\lim_{x\\to \\infty} \\dfrac {1}{5} \\\\ &= \\dfrac{1}{5}. \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068545 1069 "e-3072" 13194139533346 17592186045585 true] [17592186068545 1071 "Find the length of the hypotenuse in the triangle below.\n\n![](images/3b/3bba4ff7bf43e29a5daf61ce90fbc86f79356afa9471193f2bb7b195e000ebd6.png)" 13194139533346 17592186045585 true] [17592186068545 1072 #uuid "856c3429-0e56-5123-b2bc-76e3f252b404" 13194139533346 17592186045585 true] [17592186068545 1074 "The given lengths are the legs of the right triangle, so let $a=8$ and $b=6$. According to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}\nc^{2} &= a^{2} + b^{2} \\\\\nc &= \\sqrt{a^{2} + b^{2}}\n\\end{aligned}\n$$\n\nSubstituting in the values for $a$ and $b$ gives us\n\n$$\n\\begin{aligned}\nc &= \\sqrt{(8)^{2} + (6)^{2}} \\\\\n&= \\sqrt{64 + 36} \\\\\n&= \\sqrt{100} \\\\\n&= 10\n\\end{aligned}\n$$\n\n**Watch out!** When taking the square root of $c^2$ we only take the positive value. The reason for this is that we cannot have a negative length." 13194139533346 17592186045585 true] [17592186068546 1069 "e-3073" 13194139533346 17592186045585 true] [17592186068546 1071 "A right triangle has legs of length $5$ and $12$. Calculate the length of its hypotenuse." 13194139533346 17592186045585 true] [17592186068546 1072 #uuid "9c6ba1f6-f462-5e47-9731-a906732a46cb" 13194139533346 17592186045585 true] [17592186068546 1074 "Let $a=5$, $b=12$, and $c$ be the length of the hypotenuse. According to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}\nc^{2} &= a^{2} + b^{2} \\\\\nc &= \\sqrt{a^{2} + b^{2}}\n\\end{aligned}\n$$\n\nSubstituting in the values for $a$ and $b$ gives us\n\n$$\n\\begin{aligned}\nc &= \\sqrt{(5)^{2} + (12)^{2}} \\\\\n&= \\sqrt{25 + 144} \\\\\n&= \\sqrt{169} \\\\\n&= 13\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068547 1069 "e-3074" 13194139533346 17592186045585 true] [17592186068547 1071 "What is the length of $a$ in the triangle shown below?\n\n![](images/0c/0c86e05cad3532a3ac3182ce2f6a834ad19166ac30a2b4d69a8781cbe002c498.png)" 13194139533346 17592186045585 true] [17592186068547 1072 #uuid "83f7c86a-a646-5f19-bd80-2df7d218a8ea" 13194139533346 17592186045585 true] [17592186068547 1074 "Here, we know the lengths of the hypotenuse and one leg, so let $b=9$ and $c=15$. We need to find $a$, the length of the other leg.\n\nAccording to the Pythagorean theorem, we obtain\n\n$$\n\\begin{aligned}\nc^{2} &= a^{2} + b^{2} \\\\\na^{2} &= c^{2} - b^{2} \\\\\na &= \\sqrt{c^{2} - b^{2}}\n\\end{aligned}\n$$\n\nSubstituting in the values for $b$ and $c$ gives us\n\n$$\n\\begin{aligned}\na &= \\sqrt{(15)^{2} - (9)^{2}} \\\\\n&= \\sqrt{225 - 81} \\\\\n&= \\sqrt{144} \\\\\n&= 12\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068548 1069 "e-3178" 13194139533346 17592186045585 true] [17592186068548 1071 "What is the circumference $C$ of a circle with a diameter of $d=10$?\n\n![](images/b1/b1ebd81fca9688b5688dc916d6be62bad14853f55a8e66c5c7af469dd4032ec4.png)" 13194139533346 17592186045585 true] [17592186068548 1072 #uuid "ba3d3abd-4b93-5705-8fcb-cb88b58dad2f" 13194139533346 17592186045585 true] [17592186068548 1074 "We use the formula $C=\\pi d$ and get\n\n$$\n\\begin{aligned}\nC &= πd \\\\\n&= π \\cdot 10 \\\\\n&= 10π\n\\end{aligned}\n$$\n\nThis is the exact answer. If we want an approximate answer, say rounded to three decimal places, we can use the approximation\n\n$$\n\\pi\\approx 3.14\\,159\n$$\n\nand we get\n\n$$\n\\begin{aligned}\nC &= 10 \\cdot π \\\\\n&\\approx 10 \\cdot 3.14159 \\\\\n&\\approx 31.416\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068549 1069 "e-3179" 13194139533346 17592186045585 true] [17592186068549 1071 "What is the circumference $C$ of a circle with a radius of $6$?\n\n![](images/3c/3c21021529285f488ca794a442e5826a033ed2a4c6f4fad53ab9e8fdc84d35ee.png)" 13194139533346 17592186045585 true] [17592186068549 1072 #uuid "d26dfc25-605c-5d73-80bc-15801b20beb5" 13194139533346 17592186045585 true] [17592186068549 1074 "We use the formula $C=2\\pi r$ to get\n\n$$\n\\begin{aligned}\nC &= 2πr \\\\\n&= 2π \\cdot 6 \\\\\n&= 12π\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068550 1069 "e-3180" 13194139533346 17592186045585 true] [17592186068550 1071 "What is the radius $r$ of a circle with a circumference of $C=17\\pi$?\n\n![](images/69/697cc9ca06bcfe46d84dfab74e0f6ae83f4342607ea4af138b111606c16e8a03.png)" 13194139533346 17592186045585 true] [17592186068550 1072 #uuid "af77eddf-8816-5b03-a53d-0f29f1f1a1b3" 13194139533346 17592186045585 true] [17592186068550 1074 "We use the formula for the circumference $C=2\\pi r$ and solve for $r$. So, we have\n\n$$\n\\begin{aligned}\nC &= 2πr \\\\\n17π &= 2πr \\\\\nr &= \\frac{17π}{2π} \\\\\n&= \\frac{17}{2} \\\\\n&= 8.5\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068551 1069 "e-3182" 13194139533346 17592186045585 true] [17592186068551 1071 "Carol has to wrap a rope around a circular column whose diameter is $20\\,\\textrm{cm}$. What length of the rope will wrap the column perfectly?" 13194139533346 17592186045585 true] [17592186068551 1072 #uuid "e18e4cc8-8ecb-53e9-8b12-c9cb5b926aa7" 13194139533346 17592186045585 true] [17592186068551 1074 "The length of the rope needed to wrap around the column is its circumference.\n\nThe formula for the circumference of a circle is $C = \\pi d$, where\n\n$$\nd=20\\,\\textrm{cm}\n$$\n\nis the diameter.\n\nTherefore, we have\n\n$$\nC = \\pi\\cdot 20 = 20\\pi \\,\\textrm{cm}\n$$" 13194139533346 17592186045585 true] [17592186068552 1069 "e-3557" 13194139533346 17592186045585 true] [17592186068552 1071 "Find $\\displaystyle\\lim_{x\\rightarrow 0^-} f(x)$ and $\\displaystyle\\lim_{x\\rightarrow 0^+} f(x)$ for the function given below.\n\n![](images/1d/1dc9fd5dc473e15939a50fbb209475d580be540fb8c9a2bc8602a6a9724b08bd.png)" 13194139533346 17592186045585 true] [17592186068552 1072 #uuid "dbad1aa8-5786-524e-9add-5295231dfd83" 13194139533346 17592186045585 true] [17592186068552 1074 "As $x$ approaches $0$ from the *left*, the function $f(x)$ approaches $1$. Therefore,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{-}}f(x) = 1 \\,\n$$\n\nLikewise, as $x$ approaches $0$ from the *right*, the function $f(x)$ approaches $1$. Therefore,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{+}}f(x) = 1 \\,\n$$\n\nIn conclusion, we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^{-}}f(x)=\\lim_\\limits{x\\rightarrow \\,0^{+}}f(x)=1 \\,\n$$" 13194139533346 17592186045585 true] [17592186068553 1069 "e-3567" 13194139533346 17592186045585 true] [17592186068553 1071 "Is the function $y=f(x)$, plotted below, continuous at $x=0$?\n\n![](images/e3/e395863ca66a7e87fa335c56e5b6aeb1ec206893e57b155bf64e5ab07be7545c.png)" 13194139533346 17592186045585 true] [17592186068553 1072 #uuid "f12b3891-021d-5ae3-a767-f9d423408ce6" 13194139533346 17592186045585 true] [17592186068553 1074 "Because there is an asymptote at $x=0$, it is impossible to draw the function in the neighborhood of $x=0$ without taking our pencil off of the paper.\n\nTherefore, the function $y=f(x)$ is not continuous at $x=0$." 13194139533346 17592186045585 true] [17592186068554 1069 "e-3568" 13194139533346 17592186045585 true] [17592186068554 1071 "What are the points of discontinuity of the function $y=g(x)$, plotted below?\n\n![](images/6d/6d0d3c2cd072841546e66d70105436200e316e156901f8fe27dc150e96ff3da4.png)" 13194139533346 17592186045585 true] [17592186068554 1072 #uuid "514240a0-8a38-564f-ab4c-d0bacb0c5f6b" 13194139533346 17592186045585 true] [17592186068554 1074 "The points of discontinuity are at $x=0$, $x=1$, and $x=2.5$. It is impossible to draw the function in the neighborhood of these three points without taking our pencil off of the page." 13194139533346 17592186045585 true] [17592186068555 1069 "e-3569" 13194139533346 17592186045585 true] [17592186068555 1071 "![](images/18/1867a80955ae4b456cbcb011eefed96431f2b12926994942613eb947e55e38c6.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true?\n\n1. $f(x)$ is defined at $x=2$\n2. $\\lim_\\limits{x\\rightarrow \\, 2}f(x)$ exists\n3. $f(x)$ is continuous at $x=2$" 13194139533346 17592186045585 true] [17592186068555 1072 #uuid "01bca086-0ed4-5626-a357-e0724685f144" 13194139533346 17592186045585 true] [17592186068555 1074 "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(2)=2$.\n- Statement II is false. From the graph, we can see that the left and right-sided limits are different:\n$lim_(x → 2^{-})f(x)|= 2,; lim_(x → 2^{+})f(x)|= 1$.\nTherefore, $\\lim_\\limits{x\\rightarrow \\, 2}f(x)$ does not exist.\n- Statement III is false. The graph of the function breaks at $x=2$. It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper. Therefore, $f(x)$ is not continuous at $x=2$.\n\nIn conclusion, only statement I is true." 13194139533346 17592186045585 true] [17592186068556 1069 "e-3589" 13194139533346 17592186045585 true] [17592186068556 1071 "Is the function $y=g(x)$ below left-continuous at $x=0$?\n\n![](images/03/03166feaa94b64b4fbdfac1096b0e0d771abf5b4a47e84a6e28dbed257540c6b.png)" 13194139533346 17592186045585 true] [17592186068556 1072 #uuid "0acc185c-cc26-523f-981a-3e024f0693a6" 13194139533346 17592186045585 true] [17592186068556 1074 "To determine whether $g(x)$, is left-continuous at $x=0$, we need to check whether the left-sided limit is equal to the function value.\n\nIndeed, we see that\n\n$$\n\\lim_{x\\to 0^-} g(x) = -2 = g(0)\n$$\n\nTherefore, $g(x)$ is left-continuous at $x=0$." 13194139533346 17592186045585 true] [17592186068557 1069 "e-3590" 13194139533346 17592186045585 true] [17592186068557 1071 "If $f(x)$ is right-continuous at $x=3$ and $f(3)=1$, then what is $\\displaystyle{\\lim_{x\\to 3^+}} \\left(f(x)-x^2\\right)$?" 13194139533346 17592186045585 true] [17592186068557 1072 #uuid "e9a8cbce-3bed-567b-9e0e-e1382465a681" 13194139533346 17592186045585 true] [17592186068557 1074 "Since $f(x)$ is right-continuous at $x=3$, we must have\n\n$$\n\\lim_{x\\to 3^+} f(x)=f(3)=1\n$$\n\nConsequently,\n\n$$\nlim_(x → 3^{+})(f(x) - x^{2}) = 1 - 3^{2} =-8\n$$" 13194139533346 17592186045585 true] [17592186068558 1069 "e-3591" 13194139533346 17592186045585 true] [17592186068558 1071 "![](images/6c/6cd9cbc3054c469869f5b5e9ff2cbf3cfc5b31b817d62c6c87d7ce19ea6aaeae.png)\n\nWhich of the following statements are true in relation to the function $y=g(x)$ above?\n\n1. The function is left-continuous at $x=0$\n2. The function is right-continuous at $x=0$\n3. The function is continuous at $x=0$" 13194139533346 17592186045585 true] [17592186068558 1072 #uuid "1ec6e675-6052-5cec-8b29-766084245f74" 13194139533346 17592186045585 true] [17592186068558 1074 "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=0$, since the left-sided limit is not equal to the function value:\n$\\displaystyle \\lim_{x\\to0^-}g(x) = 2 \\neq -2 = g(0)$\n- Statement II is true. The function is right-continuous at $x=0$, since the right-sided limit is equal to the function value:\n$\\displaystyle \\lim_{x\\to0^+}g(x) = -2 = g(0)$\n- Statement III is false. In order for the function to be continuous at $x=0$, it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true." 13194139533346 17592186045585 true] [17592186068559 1069 "e-389" 13194139533346 17592186045585 true] [17592186068559 1071 "Estimate the area under the curve $y=f(x)=(2x-4)^2$ over the interval $[0,2]$ using a left Riemann sum with $4$ rectangles of equal width." 13194139533346 17592186045585 true] [17592186068559 1072 #uuid "f781ef9b-491f-5df4-a273-94f30ce79185" 13194139533346 17592186045585 true] [17592186068559 1074 "First, let's compute the step size $\\Delta x$, which is just the width of each rectangle. In this case, the endpoints of our interval are $a=0$ and $b=2$, and there are $n=4$ rectangles, so the step size is\n\n$$\n\\Delta x=\\dfrac{b-a}{n}=\\dfrac{2-0}{4}=0.5\n$$\n\nNow, let's sketch our situation. We are using a left Riemann sum, which means we draw the rectangles so that the left corner of each rectangle coincides with the curve.\n\n![](images/56/56427bec8108b822c4e1980725073cedc9fc79575d606014f72ea6ca9f8959c2.png)\n\nThe area $\\mathcal{A}$ can be approximated using the formula\n\n$$\n\\mathcal A\\approx(\\overbrace{{\\color{red}{f(0)}}+{\\color{red}{f(0.5)}}+{\\color{red}{f(1)}}+{\\color{red}{f(1.5)}}}^{\\color{red}{\\large\\text{heights}}})\\cdot \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}{\\large\\text{width}}}\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0$ | $0.5$ | $1$ | $1.5$ |\n| --- | ---: | ---: | ---: | ---: |\n| $f(x)$ | $16$ | $9$ | $4$ | $1$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\nA \\approx (16 + 9 + 4 + 1) \\cdot 0.5 = 15\n$$" 13194139533346 17592186045585 true] [17592186068560 1069 "e-390" 13194139533346 17592186045585 true] [17592186068560 1071 "The following table shows some values of a continuous function $f(x)$ over the interval $[0,2]$.\n\n| $x$ | $0$ | $0.8$ | $1.6$ | $2$ |\n| --- | ---: | ---: | ---: | ---: |\n| $f(x)$ | $2$ | $5$ | $10$ | $12$ |\n\nUse the left Riemann sum, with the three subintervals indicated by the data, to approximate the area under the curve $y=f(x)$ over the interval $[0,2]$." 13194139533346 17592186045585 true] [17592186068560 1072 #uuid "6220f2e1-e654-5a30-a0f8-377bb0d64bc7" 13194139533346 17592186045585 true] [17592186068560 1074 "In this case, we have $n=3$ rectangles. Using the left Riemann sum, the area is computed as\n\n$$\n\\mathcal{A} \\approx f(0.0)\\Delta x_1+f(0.8)\\Delta x_2+f(1.6)\\Delta x_3\n$$\n\nwhere each $\\Delta x_i$ is calculated by considering the step between a particular $x$-value and the next one, i.e.,\n\n$$\n\\Delta x_i = x_{i+1}-x_{i}\n$$\n\nWe set up a value table that includes the $\\Delta x$'s.\n\n| $x$ | $0$ | $0.8$ | $1.6$ | $2$ |\n| --- | ---: | ---: | ---: | ---: |\n| $\\Delta{x}$ | $0.8$ | $0.8$ | $0.4$ | $-$ |\n| $f(x)$ | $2$ | $5$ | $10$ | $12$ |\n\nFinally, we plug in the numbers to approximate the area under the curve and get\n\n$$\nA \\mid \\approx 2 \\cdot 0.8 + 5 \\cdot 0.8 + 10 \\cdot 0.4; = 1.6 + 4 + 4; = 9.6\n$$" 13194139533346 17592186045585 true] [17592186068561 1069 "e-3978" 13194139533346 17592186045585 true] [17592186068561 1071 "The equation $\\log_3{9} = 2$ is equivalent to $b^2 = 9$. What is the value of $b$?" 13194139533346 17592186045585 true] [17592186068561 1072 #uuid "0cd0e716-e9da-51ca-9c75-adedad1bf12d" 13194139533346 17592186045585 true] [17592186068561 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare\n\n$$\n\\log_3{9} = 2\n$$\n\nwith\n\n$$\n\\log_{b}{a} = x\n$$\n\nwe get $a = 9$, $b = 3$, and $x = 2$.\n\nTherefore, the given equation is equivalent to $3^2 = 9$. Consequently, $b = 3$." 13194139533346 17592186045585 true] [17592186068562 1069 "e-3979" 13194139533346 17592186045585 true] [17592186068562 1071 "The equation $\\log_{6}{1} = 0$ is equivalent to $b^0 = 1$. What is the value of $b$?" 13194139533346 17592186045585 true] [17592186068562 1072 #uuid "c9eafa03-bc10-5dfd-a212-a662d26974ab" 13194139533346 17592186045585 true] [17592186068562 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare\n\n$$\n\\log_{6}{1} = 0\n$$\n\nwith\n\n$$\n\\log_{b}{a} = x\n$$\n\nwe get $a = 1$, $b = 6$, and $x = 0$.\n\nTherefore, the given equation is equivalent to $6^0 = 1$. Consequently, $b = 6$." 13194139533346 17592186045585 true] [17592186068563 1069 "e-3980" 13194139533346 17592186045585 true] [17592186068563 1071 "The equation $\\log_{16}{4} = \\dfrac{1}{2}$ is equivalent to $\\sqrt{b} = 4$. What is the value of $b$?" 13194139533346 17592186045585 true] [17592186068563 1072 #uuid "446ff062-5a2d-5178-9660-60bafae375fb" 13194139533346 17592186045585 true] [17592186068563 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare\n\n$$\n\\log_{16}{4} = \\dfrac{1}{2}\n$$\n\nwith\n\n$$\n\\log_{b}{a} = x\n$$\n\nwe get $a = 4$, $b = 16$, and\n\n$$\nx = \\dfrac{1}{2}\n$$\n\nTherefore, the given equation is equivalent to\n\n$$\n16^{1/2} = 4\n$$\n\nwhich is also equivalent to\n\n$$\n\\sqrt{16} = 4\n$$\n\nConsequently, $b = 16$." 13194139533346 17592186045585 true] [17592186068564 1069 "e-3981" 13194139533346 17592186045585 true] [17592186068564 1071 "The equation $\\log_{2}\\left(\\dfrac{1}{8} \\right) = -3$ is equivalent to $b^{-3} = \\dfrac{1}{8}$. What is the value of $b$?" 13194139533346 17592186045585 true] [17592186068564 1072 #uuid "2613759b-9a0e-59b1-952b-1d2a8a08b4f4" 13194139533346 17592186045585 true] [17592186068564 1074 "The logarithm of $a$ with base $b$ is defined as follows:\n\n> $\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare\n\n$$\n\\log_{2}\\left(\\dfrac{1}{8} \\right) = -3\n$$\n\nwith\n\n$$\n\\log_{b}{a} = x\n$$\n\nwe get\n\n$$\na = \\dfrac{1}{8}\n$$\n\n$b = 2$, and $x = -3$.\n\nTherefore, the given equation is equivalent to\n\n$$\n2^{-3} = \\dfrac{1}{8}\n$$\n\nConsequently, $b = 2$." 13194139533346 17592186045585 true] [17592186068565 1069 "e-4027" 13194139533346 17592186045585 true] [17592186068565 1071 "What are the solutions to $x^2 + 16 = 0$?" 13194139533346 17592186045585 true] [17592186068565 1072 #uuid "d659780a-f726-5827-a13a-a64b21a0cf41" 13194139533346 17592186045585 true] [17592186068565 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned} x^2 + 16 &= 0 \\\\[3pt] x^2 &= -16 \\end{aligned}\n$$\n\nBy taking the square root, we obtain\n\n$$\nx = \\pm \\sqrt{-16}\n$$\n\nWe now rewrite $x$ using the imaginary unit\n\n$$\n\\textrm{i}=\\sqrt{-1}\\,\n$$\n\n$$\n\\begin{aligned}\nx &= ± \\sqrt{-16} \\\\\n&= ± \\sqrt{16 \\cdot (-1)} \\\\\n&= ± \\sqrt{16} \\cdot \\sqrt{-1} \\\\\n&= ± 4\\textrm{i}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nx = \\pm 4 \\textrm{i}\n$$" 13194139533346 17592186045585 true] [17592186068566 1069 "e-4028" 13194139533346 17592186045585 true] [17592186068566 1071 "If $p^2 + 27 = 0$, then $p =$" 13194139533346 17592186045585 true] [17592186068566 1072 #uuid "8082e3bd-04dc-5598-93c5-dbc423cdba97" 13194139533346 17592186045585 true] [17592186068566 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned} p^2 + 27 & = 0 \\\\[3pt] p^2 & = -27 \\end{aligned}\n$$\n\nBy taking the square root, we obtain\n\n$$\np = \\pm \\sqrt{-27}\n$$\n\nWe now rewrite $p$ using the imaginary unit\n\n$$\n\\textrm{i}=\\sqrt{-1}\\,\n$$\n\n$$\n\\begin{aligned}\np &= ± \\sqrt{-27} \\\\\n&= ± \\sqrt{27 \\cdot (-1)} \\\\\n&= ± \\sqrt{27} \\cdot \\sqrt{-1} \\\\\n&= ± \\sqrt{3^{2} \\cdot 3} \\cdot \\sqrt{-1} \\\\\n&= ± 3\\sqrt{3} \\cdot \\sqrt{-1} \\\\\n&= ± 3\\sqrt{3}\\textrm{i}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\np = \\pm 3\\sqrt{3} \\, \\textrm{i}\n$$" 13194139533346 17592186045585 true] [17592186068567 1069 "e-4029" 13194139533346 17592186045585 true] [17592186068567 1071 "If $16z^2 + 49 = 0$, then $z =$" 13194139533346 17592186045585 true] [17592186068567 1072 #uuid "99f522f8-39ff-5612-86d1-84e703bde35f" 13194139533346 17592186045585 true] [17592186068567 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned} 16z^2 + 49 & = 0 \\\\[5pt] 16z^2 & = -49 \\\\[5pt] z^2 & = -\\dfrac{49}{16} \\end{aligned}\n$$\n\nBy taking the square root, we obtain\n\n$$\nz = \\pm \\sqrt{-\\dfrac{49}{16}}\n$$\n\nWe now rewrite $z$ using the imaginary unit\n\n$$\n\\textrm{i}=\\sqrt{-1}\\,\n$$\n\n$$\n\\begin{aligned}\nz &= ± \\sqrt{-\\frac{49}{16}} \\\\\n&= ± \\sqrt{\\frac{49}{16} \\cdot (-1)} \\\\\n&= ± \\sqrt{\\frac{49}{16}} \\cdot \\sqrt{-1} \\\\\n&= ± \\frac{\\sqrt{49}}{\\sqrt{16}} \\cdot \\sqrt{-1} \\\\\n&= ± \\frac{7}{4}\\textrm{i}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nz=\\pm \\dfrac{7}{4} \\textrm{i}\n$$" 13194139533346 17592186045585 true] [17592186068568 1069 "e-4030" 13194139533346 17592186045585 true] [17592186068568 1071 "What are the solutions of the equation $2y^2 + 9 = 0$?" 13194139533346 17592186045585 true] [17592186068568 1072 #uuid "93aec687-49af-55ea-9212-b33dd29f4ce7" 13194139533346 17592186045585 true] [17592186068568 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned} 2y^2 + 9 &= 0 \\\\[5pt] 2y^2 &= -9 \\\\[5pt] y^2 & = -\\dfrac{9}{2} \\end{aligned}\n$$\n\nBy taking square root, we obtain\n\n$$\ny = \\pm \\sqrt{-\\dfrac{9}{2}}\n$$\n\nWe now rewrite $y$ using the imaginary unit\n\n$$\n\\textrm{i}=\\sqrt{-1}\\,\n$$\n\n$$\n\\begin{aligned}\ny &= ± \\sqrt{-\\frac{9}{2}} \\\\\n&= ± \\sqrt{\\frac{9}{2} \\cdot (-1)} \\\\\n&= ± \\sqrt{\\frac{9}{2}} \\cdot \\sqrt{-1} \\\\\n&= ± \\frac{\\sqrt{9}}{\\sqrt{2}} \\cdot \\sqrt{-1} \\\\\n&= ± \\frac{3}{\\sqrt{2}}\\textrm{i}\n\\end{aligned}\n$$\n\nFinally, we rationalize the denominator:\n\n$$\n\\begin{aligned}\ny &= ± \\frac{3}{\\sqrt{2}}\\textrm{i} \\\\\n&= ± \\frac{3}{\\sqrt{2}} \\cdot \\frac{\\sqrt{2}}{\\sqrt{2}} \\cdot \\sqrt{-1} \\\\\n&= ± \\frac{3\\sqrt{2}}{2}\\textrm{i}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\ny=\\pm \\dfrac{3\\sqrt{2}}{2} \\textrm{i}\n$$" 13194139533346 17592186045585 true] [17592186068569 1069 "e-4102" 13194139533346 17592186045585 true] [17592186068569 1071 "Calculate $\\displaystyle \\int \\dfrac{2x+3}{(x^2+4)(x-1)} \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068569 1072 #uuid "fd2d4aca-7859-5bed-a514-43d82ba25400" 13194139533346 17592186045585 true] [17592186068569 1074 "The quadratic factor $x^2+4$ is irreducible, so we proceed with the following partial fraction decomposition:\n\n$$\n\\begin{aligned}\n(2x + 3)/((x^{2} + 4)(x - 1)) &= (Ax + B)/((x^{2} + 4)) + (C)/((x - 1))\n\\end{aligned}\n$$\n\nTo determine the coefficients $A$, $B$, and $C$, we first multiply both sides of the above equation by $(x^2+4)(x-1)$, and we get\n\n$$\n\\begin{aligned}\n2x + 3 &= (Ax + B)(x - 1) + C(x^{2} + 4)\n\\end{aligned}\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=-1, B=1$, and $C=1$. Therefore,\n\n$$\n\\dfrac{2x+3}{(x^2+4)(x-1)} = \\dfrac{-x+1}{x^2+4} +\\dfrac{1}{x-1}\n$$\n\nNow we integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\n\\int(2x + 3)/((x^{2} + 4)(x - 1))dx &= \\int(\\frac{-x + 1}{x^{2} + 4} + \\frac{1}{x - 1})dx \\\\\n&=-\\int\\frac{x}{x^{2} + 4}dx + \\int\\frac{1}{x^{2} + 4}dx + \\int\\frac{1}{x - 1}dx\n\\end{aligned}\n$$\n\nFor the first integral, we use the substitution\n\n$$\nu = x^2+4\n$$\n\nThen\n\n$$\n2x\\,\\textrm{d}x=\\textrm{d}u\n$$\n\nand we get\n\n$$\n\\begin{aligned}\n\\int\\frac{x}{x^{2} + 4}dx &= \\int(\\frac{1}{u})\\frac{du}{2} \\\\\n&= \\frac{1}{2}\\ln \\mid u \\mid \\\\\n&= \\frac{1}{2}\\ln \\mid x^{2} + 4 \\mid \\\\\n&= \\frac{1}{2}\\ln (x^{2} + 4)\n\\end{aligned}\n$$\n\nFor the second integral, we use the fact that\n\n$$\n\\displaystyle \\int \\dfrac{1}{x^2+a^2} \\, \\textrm{d}x = \\dfrac{1}{a}\\arctan\\left(\\dfrac{x}{a}\\right)\n$$\n\nwhich results in\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{x^{2} + 4}dx &= \\frac{1}{2}\\arctan (\\frac{x}{2})\n\\end{aligned}\n$$\n\nFinally, for the third integral we have\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{x - 1}dx &= \\ln \\mid x - 1 \\mid\n\\end{aligned}\n$$\n\nSo we get the following result:\n\n$$\n\\begin{aligned}\n\\int(2x + 3)/((x^{2} + 4)(x - 1))dx &= -\\int\\frac{x}{x^{2} + 4}dx + \\int\\frac{1}{x^{2} + 4}dx + \\int\\frac{1}{x - 1}dx \\\\\n&=-\\frac{1}{2}\\ln (x^{2} + 4) + \\frac{1}{2}\\arctan (\\frac{x}{2}) + \\ln \\mid x - 1 \\mid + K\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068570 1069 "e-452" 13194139533346 17592186045585 true] [17592186068570 1071 "Calculate $\\displaystyle\\int 6x^2(2x^3+3)^6\\,\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068570 1072 #uuid "e2579380-1933-5819-a39e-9ffcfdafeeee" 13194139533346 17592186045585 true] [17592186068570 1074 "We note that $6x^2$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu=2x^3+3\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\n\\frac{du}{dx} &= 6x^{2}⟹du = 6x^{2}dx\n\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\n\\int6x^{2}(2x^{3} + 3)^{6}dx &= \\int(2x^{3} + 3)^{6}6x^{2}dx \\\\\n&= \\intu^{6}du\n\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\n\\intu^{6}du &= \\frac{u^{7}}{7} + C\n\\end{aligned}\n$$\n\nLastly, we substitute\n\n$$\nu=2x^3+3\n$$\n\nback in the expression. So the final result is\n\n$$\n\\displaystyle\\int 6x^2(2x^3+3)^6\\,\\textrm{d}x =\\dfrac{(2x^3+3)^7}{7}+C\n$$" 13194139533346 17592186045585 true] [17592186068571 1069 "e-453" 13194139533346 17592186045585 true] [17592186068571 1071 "Calculate $\\displaystyle\\int x\\left(1+2x^2\\right)^6\\,\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068571 1072 #uuid "9bf7d343-8d3d-5194-93c4-7b80bc1e3609" 13194139533346 17592186045585 true] [17592186068571 1074 "The $x$ that's outside the parentheses isn't quite the derivative of $(1+2x^2)$. The derivative of $(1+2x^2)$ is $4x$, so we're out by a constant factor of $4$. However, since we're out only by a constant factor, substitution will still work!\n\nSo we make the substitution\n\n$$\nu=1+2x^2\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\n\\frac{du}{dx} &= 4x⟹\\frac{1}{4}du = xdx\n\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u$, as follows:\n\n$$\n\\begin{aligned}\n\\intx(1 + 2x^{2})^{6}dx &= \\int(1 + 2x^{2})^{6} \\cdot xdx \\\\\n&= \\intu^{6} \\cdot \\frac{1}{4}du \\\\\n&= \\frac{1}{4}\\intu^{6}du\n\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x$. We get\n\n$$\n\\begin{aligned}\n\\frac{1}{4}\\intu^{6}du &= \\frac{1}{4} \\cdot \\frac{u^{7}}{7} + C \\\\\n&= \\frac{1}{28}u^{7} + C \\\\\n&= \\frac{1}{28}(1 + 2x^{2})^{7} + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068572 1069 "e-454" 13194139533346 17592186045585 true] [17592186068572 1071 "Calculate $\\displaystyle \\int \\dfrac{x^2}{x^3+1}\\,\\textrm d x$." 13194139533346 17592186045585 true] [17592186068572 1072 #uuid "49f679c4-bbc4-59a5-9b0c-0f3b69d7cf57" 13194139533346 17592186045585 true] [17592186068572 1074 "Let\n\n$$\nu=x^3+1\n$$\n\nThen\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 3x^2\\quad\\Longrightarrow\\quad \\dfrac 1 3 \\textrm d u= x^2 \\, \\textrm d x\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\n\\int\\frac{x^{2}}{x^{3} + 1}dx &= \\int\\frac{1}{x^{3} + 1} \\cdot x^{2}dx \\\\\n&= \\int\\frac{1}{u} \\cdot \\frac{1}{3}du \\\\\n&= \\frac{1}{3}\\int\\frac{1}{u}du \\\\\n&= \\frac{1}{3}\\ln\\begin{vmatrix}u & + C \\\\ = \\frac{1}{3}\\ln & x^{3} + 1\\end{vmatrix}+ C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068573 1069 "e-464" 13194139533346 17592186045585 true] [17592186068573 1071 "Calculate the integral $\\displaystyle\\int 2 \\sin {\\left(\\dfrac x 3\\right)} \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068573 1072 #uuid "0021ae6a-8ef8-564e-9c2e-fb5f9e8f7313" 13194139533346 17592186045585 true] [17592186068573 1074 "If we let\n\n$$\nu=\\dfrac x 3\n$$\n\nthen\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac 1 3\\quad\\Longrightarrow\\quad \\textrm d x =3\\, \\textrm d u\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\n\\int2\\sin (\\frac{x}{3})dx &= 2\\int\\sin u \\cdot 3du \\\\\n&= 2 \\cdot 3\\int\\sin udu \\\\\n&=-6\\cos u + C \\\\\n&=-6\\cos (\\frac{x}{3}) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068574 1069 "e-465" 13194139533346 17592186045585 true] [17592186068574 1071 "Calculate the integral $\\displaystyle\\int 5 \\csc {\\left(6x+\\dfrac \\pi 3\\right)} \\cot {\\left(6x+\\dfrac \\pi 3\\right)} \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068574 1072 #uuid "daf5cc74-4c7d-500a-9345-03bd6b73a333" 13194139533346 17592186045585 true] [17592186068574 1074 "If we let\n\n$$\nu=6x+\\dfrac \\pi 3\n$$\n\nthen\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 6\\quad\\Longrightarrow\\quad \\textrm d x =\\dfrac 1 6\\, \\textrm d u\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\n\\int5\\csc (6x + \\frac{π}{3})\\cot (6x + \\frac{π}{3})dx &= 5\\int\\csc (6x + \\frac{π}{3})\\cot (6x + \\frac{π}{3})dx \\\\\n&= 5\\int\\csc u\\cot u \\cdot \\frac{1}{6}du \\\\\n&= \\frac{5}{6}\\int\\csc u\\cot udu \\\\\n&=-\\frac{5}{6}\\csc u + C \\\\\n&=-\\frac{5}{6}\\csc (6x + \\frac{π}{3}) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068575 1069 "e-466" 13194139533346 17592186045585 true] [17592186068575 1071 "Calculate $\\displaystyle \\int x^2 \\sec^2\\left(x^3-\\dfrac{\\pi}{6}\\right)\\,\\textrm d x$." 13194139533346 17592186045585 true] [17592186068575 1072 #uuid "234c7a86-037c-5316-9419-14db90d1da60" 13194139533346 17592186045585 true] [17592186068575 1074 "Let\n\n$$\nu = x^3 - \\dfrac{\\pi}{6}\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac{\\textrm{d} u}{\\textrm{d}x} = 3x^2 \\quad\\Longrightarrow\\quad \\dfrac 1 3 \\textrm d u = x^2\\,\\textrm d x\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\n\\intx^{2}\\sec^{2} (x^{3} - \\frac{π}{6})dx &= \\int\\sec^{2} (x^{3} - \\frac{π}{6}) \\cdot x^{2}dx \\\\\n&= \\int\\sec^{2} (u) \\cdot \\frac{1}{3}du \\\\\n&= \\frac{1}{3}\\int\\sec^{2} (u)du \\\\\n&= \\frac{1}{3}\\tan u + C \\\\\n&= \\frac{1}{3}\\tan (x^{3} - \\frac{π}{6}) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068576 1069 "e-467" 13194139533346 17592186045585 true] [17592186068576 1071 "Evaluate the integral $\\displaystyle \\int_0^{\\pi/4} \\dfrac{\\tan x \\sec^2 x}{1+\\tan^2x}\\,\\textrm d x$." 13194139533346 17592186045585 true] [17592186068576 1072 #uuid "03e461a3-0fe0-5fb5-813e-ae23a5dc606a" 13194139533346 17592186045585 true] [17592186068576 1074 "Notice that the numerator is proportional to the derivative of the denominator, because\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(1+\\tan^2 x) = 2\\tan{x}\\sec^2 x\n$$\n\nSo, let\n\n$$\nu = 1+\\tan^2 x\n$$\n\nDifferentiating, we have\n\n$$\n\\dfrac{\\textrm{d} u}{\\textrm{d}x} = 2\\tan x\\sec^2 x \\quad\\Longrightarrow\\quad \\dfrac 1 2 \\textrm d u = \\tan x\\sec^2 x\\,\\textrm d x\n$$\n\nCalculating the limits for $u$ gives\n\n| $x$ | $0$ | $\\pi/4$ |\n| --- | ---: | ---: |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate, as follows:\n\n$$\n\\begin{aligned}\n\\int_{0}^{π/4}\\frac{\\tan x\\sec^{2} x}{1 + \\tan^{2} x}dx &= \\int_{0}^{π/4}\\frac{1}{1 + \\tan^{2} x} \\cdot \\tan x\\sec^{2} xdx \\\\\n&= \\int_{1}^{2}\\frac{1}{u} \\cdot \\frac{1}{2}du \\\\\n&= \\frac{1}{2}\\int_{1}^{2}\\frac{1}{u}du \\\\\n&= \\frac{1}{2}(\\ln 2 - \\ln 1) \\\\\n&= \\frac{1}{2}\\ln 2\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068577 1069 "e-495" 13194139533346 17592186045585 true] [17592186068577 1071 "Evaluate the integral $\\displaystyle \\int x^2\\cos(3x) \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068577 1072 #uuid "c1dcb0a7-441f-5628-ba23-71d43d9ea96c" 13194139533346 17592186045585 true] [17592186068577 1074 "In this case, we define\n\n$$\n\\begin{bmatrix}u = x^{2} & ⟹\\frac{du}{dx} = 2x, \\\\ \\frac{dv}{dx} = \\cos (3x) & ⟹v = \\int\\cos (3x)dx = \\frac{1}{3}\\sin (3x)\\end{bmatrix}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\n\\intx^{2}\\cos (3x)dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (x^{2})(\\frac{1}{3}\\sin (3x)) - \\int(\\frac{1}{3}\\sin (3x))2xdx \\\\\n&= \\frac{1}{3}x^{2}\\sin (3x) - \\frac{2}{3}\\intx\\sin (3x)dx\n\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\displaystyle \\int x\\sin(3x) \\textrm{d}x$. We take\n\n$$\n\\begin{bmatrix}u = x & ⟹\\frac{du}{dx} = 1, \\\\ \\frac{dv}{dx} = \\sin (3x) & ⟹v = \\int\\sin (3x)dx =-\\frac{1}{3}\\cos (3x)\\end{bmatrix}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\n\\intx\\sin (3x)dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= x(-\\frac{1}{3}\\cos (3x)) - \\int(-\\frac{1}{3}\\cos (3x)) \\cdot 1dx \\\\\n&=-\\frac{1}{3}x\\cos (3x) + \\frac{1}{3}\\int\\cos (3x)dx \\\\\n&=-\\frac{1}{3}x\\cos (3x) + \\frac{1}{3}(\\frac{1}{3}\\sin (3x)) + C_{1} \\\\\n&=-\\frac{1}{3}x\\cos (3x) + \\frac{1}{9}\\sin (3x) + C_{1}\n\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\n\\intx^{2}\\cos (3x)dx &= \\frac{1}{3}x^{2}\\sin (3x) - \\frac{2}{3}\\intx\\sin (3x)dx \\\\\n&= \\frac{1}{3}x^{2}\\sin (3x) - \\frac{2}{3}(-\\frac{1}{3}x\\cos (3x) + \\frac{1}{9}\\sin (3x) + C_{1}) \\\\\n&= \\frac{1}{3}x^{2}\\sin (3x) + \\frac{2}{9}x\\cos (3x) - \\frac{2}{27}\\sin (3x) - \\frac{2C_{1}}{3} \\\\\n&= \\frac{1}{27}((9x^{2} - 2)\\sin (3x) + 6x\\cos (3x)) + C\n\\end{aligned}\n$$\n\nwhere\n\n$$\nC = -\\dfrac{2C_1}{3}\n$$" 13194139533346 17592186045585 true] [17592186068578 1069 "e-496" 13194139533346 17592186045585 true] [17592186068578 1071 "Evaluate the integral $\\displaystyle \\int_1^e 32x^3(\\ln x)^2 \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068578 1072 #uuid "b81ff533-2067-5d1a-b265-df1ad91fa8da" 13194139533346 17592186045585 true] [17592186068578 1074 "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{bmatrix}u = (\\ln x)^{2} & ⟹\\frac{du}{dx} = \\frac{2\\ln x}{x}, \\\\ \\frac{dv}{dx} = 32x^{3} & ⟹v = \\int32x^{3}dx = 8x^{4}\\end{bmatrix}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\n\\int32x^{3}(\\ln x)^{2}dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (\\ln x)^{2}(8x^{4}) - \\int(8x^{4})(\\frac{2\\ln x}{x})dx \\\\\n&= 8x^{4}(\\ln x)^{2} - 16\\intx^{3}\\ln (x)dx\n\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int {x^3\\ln(x)} \\textrm{d}x$. We take\n\n$$\n\\begin{bmatrix}u = \\ln (x) & ⟹\\frac{du}{dx} = \\frac{1}{x}, \\\\ \\frac{dv}{dx} = x^{3} & ⟹v = \\intx^{3}dx = \\frac{x^{4}}{4}\\end{bmatrix}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\n\\intx^{3}\\ln (x)dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= \\ln (x)(\\frac{x^{4}}{4}) - \\int(\\frac{x^{4}}{4})(\\frac{1}{x})dx \\\\\n&= (x^{4}\\ln (x))/(4) - \\frac{1}{4}\\intx^{3}dx \\\\\n&= (x^{4}\\ln (x))/(4) - \\frac{x^{4}}{16} + C_{1}\n\\end{aligned}\n$$\n\nwhere $C_1$ is an integral constant. So, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\n\\int32x^{3}(\\ln x)^{2}dx &= 8x^{4}(\\ln x)^{2} - 16\\intx^{3}\\ln (x)dx \\\\\n&= 8x^{4}(\\ln x)^{2} - 16((x^{4}\\ln (x))/(4) - \\frac{x^{4}}{16} + C_{1}) \\\\\n&= 8x^{4}(\\ln x)^{2} - 4x^{4}\\ln (x) + x^{4} - 16C_{1} \\\\\n&= x^{4}(8(\\ln x)^{2} - 4\\ln (x) + 1) + C\n\\end{aligned}\n$$\n\nwhere $C = -4C_1$. Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}\n\\int_{1}^{e}32x^{3}\\ln (x)dx &= \\left.x^{4}(8(\\ln x)^{2} - 4\\ln (x) + 1)\\right|_{1}^{e} \\\\\n&= [(e)^{4}(8(\\ln (e))^{2} - 4\\ln (e) + 1)] - [(1)^{4}(8(\\ln (1))^{2} - 4\\ln (1) + 1)] \\\\\n&= [e^{4}(8 - 4 + 1)] - 1 \\\\\n&= 5e^{4} - 1\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068579 1069 "e-4963" 13194139533346 17592186045585 true] [17592186068579 1071 "Factor $x^3 + 3x^2 + 4x + 12$." 13194139533346 17592186045585 true] [17592186068579 1072 #uuid "5d9f2efa-c413-50f3-8b69-f1a9e3ed3c80" 13194139533346 17592186045585 true] [17592186068579 1074 "First, we group the two larger terms and the two smaller terms:\n\n$$\n(x^3 + 3x^2) + (4x + 12)\n$$\n\nNext, we factor the two larger terms and the two smaller terms separately, so that the leftover binomials inside the parentheses match:\n\n$$\nx^2(x + 3) + 4(x + 3)\n$$\n\nThen, we rearrange the expression so that the binomial factors in parentheses appear at the front of each of the two terms:\n\n$$\n(x + 3)x^2 + (x + 3)4\n$$\n\nFinally, we factor out the binomial in parentheses from the entire expression:\n\n$$\n(x + 3)(x^2 + 4)\n$$" 13194139533346 17592186045585 true] [17592186068580 1069 "e-4964" 13194139533346 17592186045585 true] [17592186068580 1071 "Factor $15n^3 + 5n^2 + 3n + 1$." 13194139533346 17592186045585 true] [17592186068580 1072 #uuid "0ae321c8-3514-5ecd-82f2-1f3ebc7360ee" 13194139533346 17592186045585 true] [17592186068580 1074 "First, we group the two larger terms and the two smaller terms:\n\n$$\n(15n^3 + 5n^2) + (3n + 1)\n$$\n\nNext, we factor the two larger terms and the two smaller terms separately, so that the leftover binomials inside the parentheses match:\n\n$$\n5n^2(3n + 1) + (3n + 1)\n$$\n\nThen, we rearrange the expression so that the binomial factors in parentheses appear at the front of each of the two terms:\n\n$$\n(3n + 1)5n^2 + (3n + 1)\n$$\n\nFinally, we factor out the binomial in parentheses from the entire expression:\n\n$$\n(3n + 1)(5n^2 + 1)\n$$" 13194139533346 17592186045585 true] [17592186068581 1069 "e-4965" 13194139533346 17592186045585 true] [17592186068581 1071 "Factor $a^3 + 4a^2 - 3a - 12$." 13194139533346 17592186045585 true] [17592186068581 1072 #uuid "651ed59f-db55-594e-82d9-eeb9718427cc" 13194139533346 17592186045585 true] [17592186068581 1074 "First, we group the two larger terms and the two smaller terms:\n\n$$\n(a^3 + 4a^2) - (3a + 12)\n$$\n\nNotice that when grouping the smaller terms, the negative sign was factored out.\n\nNext, we factor the two larger terms and the two smaller terms separately, so that the leftover binomials inside the parentheses match:\n\n$$\na^2(a + 4) - 3(a + 4)\n$$\n\nThen, we rearrange the expression so that the binomial factors in parentheses appear at the front of each of the two terms:\n\n$$\n(a + 4)a^2 - (a + 4)3\n$$\n\nFinally, we factor out the binomial in parentheses from the entire expression:\n\n$$\n(a + 4)(a^2 - 3)\n$$" 13194139533346 17592186045585 true] [17592186068582 1069 "e-4966" 13194139533346 17592186045585 true] [17592186068582 1071 "Factor $2p^3 +5p^2 -8p - 20$." 13194139533346 17592186045585 true] [17592186068582 1072 #uuid "27e6bdb4-0955-5b4d-ba77-b9e73a1b6e84" 13194139533346 17592186045585 true] [17592186068582 1074 "First, we group the two larger terms and the two smaller terms:\n\n$$\n(2p^3 +5p^2) - (8p +20)\n$$\n\nNext, we factor the two larger terms and the two smaller terms separately, so that the leftover binomials inside the parentheses match:\n\n$$\np^2(2p +5) -4(2p +5)\n$$\n\nThen, we rearrange the expression so that the binomial factors in parentheses appear at the front of each of the two terms:\n\n$$\n(2p+5)p^2-(2p+5)4\n$$\n\nFinally, we factor out the binomial in parentheses from the entire expression:\n\n$$\n(2p + 5)(p^2-4)\n$$\n\nHowever, we need to make sure that we factor *completely*. Here, the factor $p^2-4$ is a difference of squares and can itself be factored into $(p - 2)(p + 2)$. So, our final result is\n\n$$\n(2p + 5)(p-2)(p+2)\n$$" 13194139533346 17592186045585 true] [17592186068583 1069 "e-4967" 13194139533346 17592186045585 true] [17592186068583 1071 "Factor $x^3 - 8$." 13194139533346 17592186045585 true] [17592186068583 1072 #uuid "eb4964f1-0462-5a41-b712-3d0d4dbd8c1b" 13194139533346 17592186045585 true] [17592186068583 1074 "The difference of cubes formula is given by\n\n$$\na^3-b^3=(a-b)(a^2+ab+b^2)\n$$\n\nNotice that we can write the given expression as a difference of cubes:\n\n$$\nx^3 - 8 = x^3 - 2^3\n$$\n\nNow, we factor the given expression using the difference of cubes formula:\n\n$$\n\\begin{aligned} x^3 - 8 & = x^3 - 2^3 \\\\[3pt] & = (x - 2)\\left(x^2 + 2\\cdot x + 2^2\\right) \\\\[3pt] & = (x - 2)\\left(x^2 + 2x + 4\\right) \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068584 1069 "e-4968" 13194139533346 17592186045585 true] [17592186068584 1071 "Factor $8n^3 + m^6$." 13194139533346 17592186045585 true] [17592186068584 1072 #uuid "c0f5e363-d4cd-5e31-bd25-6825209d58d4" 13194139533346 17592186045585 true] [17592186068584 1074 "The sum of cubes formula is given by\n\n$$\na^3+b^3=(a+b)(a^2-ab+b^2)\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n8n^3 + m^6 = (2n)^3 + (m^2)^3\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}\n8n^{3} + m^{6} &= (2n)^{3} + (m^{2})^{3} \\\\\n&= (2n + m^{2})((2n)^{2} - 2n \\cdot m^{2} + (m^{2})^{2}) \\\\\n&= (2n + m^{2})(4n^{2} - 2m^{2}n + m^{4})\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068585 1069 "e-4969" 13194139533346 17592186045585 true] [17592186068585 1071 "Factor $1 - \\dfrac 1 {t^9}$." 13194139533346 17592186045585 true] [17592186068585 1072 #uuid "e90d590d-956d-5bb7-af6c-7572051b7f1a" 13194139533346 17592186045585 true] [17592186068585 1074 "The difference of cubes formula is given by\n\n$$\na^3-b^3=(a-b)(a^2+ab+b^2)\n$$\n\nNotice that our expression can be written as a difference of cubes, as follows:\n\n$$\n1 - \\dfrac{1}{t^9} = 1^3 - \\left(\\dfrac{1}{t^3}\\right)^3\n$$\n\nNow, we factor our expression using the difference of cubes formula:\n\n$$\n\\begin{aligned}\n1 - \\frac{1}{t^{9}} &= 1^{3} - (\\frac{1}{t^{3}})^{3} \\\\\n&= (1 - \\frac{1}{t^{3}})(1^{2} + 1 \\cdot \\frac{1}{t^{3}} + (\\frac{1}{t^{3}})^{2}) \\\\\n&= (1 - \\frac{1}{t^{3}})(1 + \\frac{1}{t^{3}} + (1)/((t^{3})^{2})) \\\\\n&= (1 - \\frac{1}{t^{3}})(1 + \\frac{1}{t^{3}} + \\frac{1}{t^{6}})\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068586 1069 "e-497" 13194139533346 17592186045585 true] [17592186068586 1071 "Calculate $\\displaystyle \\int \\dfrac{\\ln^2{x}}{x} \\textrm{d}x$ using integration by parts." 13194139533346 17592186045585 true] [17592186068586 1072 #uuid "5b83575b-9674-5dc5-b3eb-a918f145be93" 13194139533346 17592186045585 true] [17592186068586 1074 "First, we let\n\n$$\nI = \\int \\dfrac{\\ln^2 x}{x} \\, \\textrm{d}x\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{bmatrix}u = \\ln^{2} x & ⇒\\frac{du}{dx} = \\frac{2\\ln x}{x}, \\\\ \\frac{dv}{dx} = \\frac{1}{x} & ⇒v = \\int\\frac{1}{x}dx = \\ln x\\end{bmatrix}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}\nI &= \\int\\frac{\\ln^{2} x}{x}dx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (\\ln^{2} x)(\\ln x) - \\int(\\ln x)(\\frac{2\\ln x}{x})dx \\\\\n&= \\ln^{3} x - 2\\int\\frac{\\ln^{2} x}{x}dx \\\\\n&= \\ln^{3} x - 2I\n\\end{aligned}\n$$\n\nFinally, we solve for $I$, remembering to add a constant of integration $C$ at the very end:\n\n$$\n\\begin{aligned}\nI &= \\ln^{3} x - 2I \\\\\n3I &= \\ln^{3} x \\\\\nI &= \\frac{\\ln^{3} x}{3} + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068587 1069 "e-498" 13194139533346 17592186045585 true] [17592186068587 1071 "Calculate $\\displaystyle \\int e^{x}\\sin{x} \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068587 1072 #uuid "72d0b4b3-bfc6-5339-809f-ff7cd63e4d3a" 13194139533346 17592186045585 true] [17592186068587 1074 "To use integration by parts, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\sin x & ⇒v = \\int\\sin xdx =-\\cos x\\end{bmatrix}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}\nI &= \\inte^{x}\\sin xdx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}(-\\cos x) - \\int(-\\cos x)(e^{x})dx \\\\\n&=-e^{x}\\cos x + \\inte^{x}\\cos xdx \\\\\n&=-e^{x}\\cos x + J\n\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ = \\int e^{x}\\cos{x}\\,\\textrm{d}x\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\cos x & ⇒v = \\int\\cos xdx = \\sin x\\end{bmatrix}\n$$\n\nUsing the integration by parts formula once more, we get\n\n$$\n\\begin{aligned}\nJ &= \\inte^{x}\\cos xdx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}(\\sin x) - \\int(\\sin x)(e^{x})dx \\\\\n&= e^{x}\\sin x - \\inte^{x}\\sin xdx \\\\\n&= e^{x}\\sin x - I\n\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I$, we can subsequently solve for $I$. We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}\nI &= -e^{x}\\cos x + J \\\\\nI &= -e^{x}\\cos x + e^{x}\\sin x - I \\\\\n2I &= -e^{x}\\cos x + e^{x}\\sin x \\\\\nI &= \\frac{e^{x}}{2}(\\sin x - \\cos x) + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068588 1069 "e-5028" 13194139533346 17592186045585 true] [17592186068588 1071 "Is $x=3$ a root of the polynomial $2x^3+8x^2-2x-8$?" 13194139533346 17592186045585 true] [17592186068588 1072 #uuid "4968972d-3bc9-5100-aa70-46213e0c3581" 13194139533346 17592186045585 true] [17592186068588 1074 "Substituting $3$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned} 2(3)^3+8(3)^2-2(3)-8 \\\\ &= 2(27)+8(9)-6-8 \\\\ &= 54+72-14 \\\\ &= 112 \\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $3$ is substituted for $x$.\n\nTherefore, $3$ is *not* a root." 13194139533346 17592186045585 true] [17592186068589 1069 "e-5030" 13194139533346 17592186045585 true] [17592186068589 1071 "Find $p$ if $3$ is a root of $x^3-3x+p$." 13194139533346 17592186045585 true] [17592186068589 1072 #uuid "c1830274-3260-5bf5-aef1-c855a89efbf2" 13194139533346 17592186045585 true] [17592186068589 1074 "Since $x=3$ is a root, we have\n\n$$\nf(3)=0\n$$\n\nTherefore, we can evaluate the polynomial at $x=3$, set it equal to $0$, and solve the equation for the parameter $p$:\n\n$$\n\\begin{aligned}\n(3)^{3} - 3(3) + p &= 0 \\\\\n27 - 9 + p &= 0 \\\\\np &= -18\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068590 1069 "e-506" 13194139533346 17592186045585 true] [17592186068590 1071 "Evaluate $\\displaystyle \\int \\dfrac{5x}{x^2+3x-4} \\,\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068590 1072 #uuid "f374b567-9a69-57ae-88eb-644ebfc451d7" 13194139533346 17592186045585 true] [17592186068590 1074 "First, we note that the denominator of the integrand can be factored as\n\n$$\nx^2+3x-4 = (x-1)(x+4) \\,\n$$\n\nSo, the integrand can be converted into a sum of partial fractions,\n\n$$\n\\begin{aligned}\n\\frac{5x}{x^{2} + 3x - 4} &= (5x)/((x - 1)(x + 4)) \\\\\n&= (A)/((x - 1)) + (B)/((x + 4))\n\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\n5x &= A(x + 4) + B(x - 1)\n\\end{aligned}\n$$\n\nPlugging in $x=-4$, we can eliminate $A$ and solve for $B$:\n\n$$\n\\begin{aligned}\n5(-4) &= A(-4 + 4) + B(-4 - 1) \\\\\n- 20 &= -5B \\\\\nB &= 4\n\\end{aligned}\n$$\n\nOn the other hand, by plugging in $x=1$, we can eliminate $B$ and solve for $A$:\n\n$$\n\\begin{aligned}\n5(1) &= A(1 + 4) + B(1 - 1) \\\\\n5 &= 5A \\\\\nA &= 1\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{5x}{x^2+3x-4} = \\dfrac{1}{(x-1)} +\\dfrac{4}{(x+4)}\n$$\n\nFinally, we integrate, and we get\n\n$$\n\\begin{aligned}\n\\int\\frac{5x}{x^{2} + 3x - 4}dx &= \\int(\\frac{1}{x - 1} + \\frac{4}{x + 4})dx \\\\\n&= \\int\\frac{1}{x - 1}dx + 4\\int\\frac{1}{x + 4}dx \\\\\n&= \\ln\\begin{vmatrix}x - 1 & + 4\\ln & x + 4\\end{vmatrix}+ C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068591 1069 "e-5061" 13194139533346 17592186045585 true] [17592186068591 1071 "Given the graph below, solve the inequality $(x+2)(1-x) \\geq 0$.\n\n![](images/f1/f1beeeb1247e21e6ebf442f8f9171320674d760551fe715afa98047be78db2bc.png)" 13194139533346 17592186045585 true] [17592186068591 1072 #uuid "659cb2ef-191b-54f0-b0b5-d872cfd781bc" 13194139533346 17592186045585 true] [17592186068591 1074 "Notice that our inequality\n\n$$\n(x+2)(1-x) \\geq 0\n$$\n\nis a \"*greater than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny = (x+2)(1-x)\n$$\n\nis *above* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/ae/ae3c40faa7e89979c135c06adf944aa46ec01564c556becaea725412d3b2560c.png)\n\nSo, the solution to the inequality is\n\n$$\n-2 \\leq x \\leq 1\n$$" 13194139533346 17592186045585 true] [17592186068592 1069 "e-507" 13194139533346 17592186045585 true] [17592186068592 1071 "Evaluate $\\displaystyle \\int_1^4 \\dfrac{2x+3}{4x^2-1} \\,\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068592 1072 #uuid "fce14198-c8ee-50a6-981d-85df79cce761" 13194139533346 17592186045585 true] [17592186068592 1074 "We'll work out the indefinite integral first and then proceed with the definite integral.\n\nFirst, we note that a denominator of the integrand can be factored as\n\n$$\n4x^2-1 = (2x+1)(2x-1) \\,\n$$\n\nSo the integrand can be converted into a sum of partial fractions,\n\n$$\n\\begin{aligned}\n\\frac{2x + 3}{4x^{2} - 1} &= (2x + 3)/((2x + 1)(2x - 1)) \\\\\n&= (A)/((2x + 1)) + (B)/((2x - 1))\n\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}\n2x + 3 &= A(2x - 1) + B(2x + 1)\n\\end{aligned}\n$$\n\nPlugging in\n\n$$\nx=\\dfrac{1}{2}\n$$\n\nwe can eliminate $A$ and solve for $B$:\n\n$$\n\\begin{aligned}\n2(\\frac{1}{2}) + 3 &= A(2(\\frac{1}{2}) - 1) + B(2(\\frac{1}{2}) + 1) \\\\\n4 &= 2B \\\\\nB &= 2\n\\end{aligned}\n$$\n\nOn the other hand, plugging in\n\n$$\nx=-\\dfrac{1}{2}\n$$\n\nwe can eliminate $B$ and solve for $A$:\n\n$$\n\\begin{aligned}\n2(-\\frac{1}{2}) + 3 &= A(2(-\\frac{1}{2}) - 1) + B(2(-\\frac{1}{2}) + 1) \\\\\n2 &= -2A \\\\\nA &= -1\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{2x+3}{4x^2-1} = -\\dfrac{1}{(2x+1)} +\\dfrac{2}{(2x-1)}\n$$\n\nNow, we integrate and get\n\n$$\n\\begin{aligned}\n\\int\\frac{2x + 3}{4x^{2} - 1}dx &= \\int(- (1)/((2x + 1)) + (2)/((2x - 1)))dx \\\\\n&=-\\int\\frac{1}{2x + 1}dx + 2\\int\\frac{1}{2x - 1}dx \\\\\n&=-\\frac{1}{2}\\ln\\begin{vmatrix}2x + 1 & + 2(\\frac{1}{2}\\ln \\mid 2x - 1 \\mid) + C \\\\ =-\\frac{1}{2}\\ln & 2x + 1\\end{vmatrix}+ \\ln \\mid 2x - 1 \\mid + C\n\\end{aligned}\n$$\n\nWe can simplify the result using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\n\\int\\frac{2x + 3}{4x^{2} - 1}dx &= -\\frac{1}{2}\\ln\\begin{vmatrix}2x + 1 & + \\ln & 2x - 1 & + C \\\\ = \\ln & \\frac{1}{\\sqrt{2x + 1}} & + \\ln & 2x - 1\\end{vmatrix}+ C \\\\\n&= \\ln \\mid \\frac{2x - 1}{\\sqrt{2x + 1}} \\mid + C\n\\end{aligned}\n$$\n\nFinally, the definite integral is\n\n$$\n\\begin{aligned}\n\\int_{1}^{4}\\frac{2x + 3}{4x^{2} - 1}dx &= \\left.\\ln \\mid \\frac{2x - 1}{\\sqrt{2x + 1}}\\right|_{1}^{4} \\\\\n&= \\ln (\\frac{7}{3}) - \\ln (\\frac{1}{\\sqrt{3}}) \\\\\n&= \\ln (\\frac{7}{3}) + \\ln (\\sqrt{3}) \\\\\n&= \\ln (\\frac{7\\sqrt{3}}{3})\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068593 1069 "e-508" 13194139533346 17592186045585 true] [17592186068593 1071 "Calculate $\\displaystyle \\int_0^1 \\dfrac{2x+3}{(x+1)^2} \\,\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068593 1072 #uuid "2fb19e4b-c455-599f-8856-5bee85f8efc4" 13194139533346 17592186045585 true] [17592186068593 1074 "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\dfrac{2x+3}{(x+1)^2} = \\dfrac{A}{(x+1)} +\\dfrac{B}{(x+1)^2}\n$$\n\nTo determine the coefficients $A$, and $B$, we first multiply both sides of the above equation by $(x+1)^2$ and get\n\n$$\n2x+3 = A(x+1)+B\n$$\n\nPlugging in $x=-1$, we can eliminate $A$ and solve for $B$:\n\n$$\n\\begin{aligned}\n2(-1) + 3 &= A(-1 + 1) + B \\\\\n1 &= 0 + B \\\\\nB &= 1\n\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B$, we can solve for $A$:\n\n$$\n\\begin{aligned}\n2(0) + 3 &= A(0 + 1) + B \\\\\n3 &= A + B \\\\\n3 &= A + 1 \\\\\nA &= 2\n\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum\n\n$$\n\\dfrac{2x+3}{(x+1)^2} = \\dfrac{2}{(x+1)} +\\dfrac{1}{(x+1)^2}\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}\n\\int_{0}^{1}(2x + 3)/((x + 1)^{2})dx &= \\int_{0}^{1}((2)/((x + 1)) + (1)/((x + 1)^{2}))dx \\\\\n&= 2\\int_{0}^{1}\\frac{1}{x + 1}dx + \\int_{0}^{1}(1)/((x + 1)^{2})dx \\\\\n&= 2\\ln \\mid x + \\left.1 \\mid \\right|_{0}^{1} + \\left.(-\\frac{1}{x + 1})\\right|_{0}^{1} \\\\\n&= 2\\ln \\mid x + \\left.1 \\mid \\right|_{0}^{1} - \\left.\\frac{1}{x + 1}\\right|_{0}^{1} \\\\\n&= 2[\\ln 2 - \\ln 1] - [\\frac{1}{2} - 1] \\\\\n&= 2\\ln 2 + \\frac{1}{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068594 1069 "e-509" 13194139533346 17592186045585 true] [17592186068594 1071 "Evaluate $\\displaystyle \\int \\dfrac{9x^2+2x-1}{(3x-1)^3}\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068594 1072 #uuid "789c5233-a263-55a7-9b27-c834b2ceaf8d" 13194139533346 17592186045585 true] [17592186068594 1074 "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\begin{aligned}\n(9x^{2} + 2x - 1)/((3x - 1)^{3}) &= (A)/((3x - 1)) + (B)/((3x - 1)^{2}) + (C)/((3x - 1)^{3})\n\\end{aligned}\n$$\n\nTo determine the coefficients $A$, $B$, and $C$, we first multiply both sides of the above equation by $(3x-1)^3$ and get\n\n$$\n\\begin{aligned}\n9x^{2} + 2x - 1 &= A(3x - 1)^{2} + B(3x - 1) + C\n\\end{aligned}\n$$\n\nPlugging in\n\n$$\nx=\\dfrac{1}{3}\n$$\n\nwe can eliminate $A$ and $B$ and solve for $C$:\n\n$$\n\\begin{aligned}\n9(\\frac{1}{3})^{2} + 2(\\frac{1}{3}) - 1 &= A(3(\\frac{1}{3}) - 1)^{2} + B(3(\\frac{1}{3}) - 1) + C \\\\\nC &= \\frac{2}{3}\n\\end{aligned}\n$$\n\nPlugging in $x=0$ and substituting the known value of $C$, we get an equation relating $A$ and $B$:\n\n$$\n\\begin{aligned}\n9(0)^{2} + 2(0) - 1 &= A(0 - 1)^{2} + B(0 - 1) + C \\\\\n- 1 &= A - B + \\frac{2}{3} \\\\\nA - B &= -\\frac{5}{3}\n\\end{aligned}\n$$\n\nPlugging in $x=1$ and substituting the known value of $C$, we get another equation relating $A$ and $B$:\n\n$$\n\\begin{aligned}\n9(1)^{2} + 2(1) - 1 &= A(3(1) - 1)^{2} + B(3(1) - 1) + C \\\\\n10 &= 4A + 2B + \\frac{2}{3} \\\\\n2A + B &= \\frac{14}{3}\n\\end{aligned}\n$$\n\nAdding our two equations\n\n$$\nA-B=-\\dfrac{5}{3}\n$$\n\nand\n\n$$\n2A+B=\\dfrac{14}{3}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\n3A &= -\\frac{5}{3} + \\frac{14}{3} \\\\\n3A &= 3 \\\\\nA &= 1\n\\end{aligned}\n$$\n\nand substituting back into\n\n$$\n2A+B=\\dfrac{14}{3}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\n2(1) + B &= \\frac{14}{3} \\\\\nB &= \\frac{8}{3}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{9x^2+2x-1}{(3x-1)^3} = \\dfrac{1}{(3x-1)} +\\dfrac{8}{3(3x-1)^2} + \\dfrac{2}{3(3x-1)^3}\n$$\n\nFinally, we integrate this expression term by term, and get\n\n$$\n\\begin{aligned}\n\\int(9x^{2} + 2x - 1)/((3x - 1)^{3})dx &= \\int((1)/((3x - 1)) + (8)/(3(3x - 1)^{2}) + (2)/(3(3x - 1)^{3}))dx \\\\\n&= \\int\\frac{1}{3x - 1}dx + \\frac{8}{3}\\int(1)/((3x - 1)^{2})dx + \\frac{2}{3}\\int(1)/((3x - 1)^{3})dx \\\\\n&= \\frac{1}{3}\\ln\\begin{vmatrix}3x - 1 & + \\frac{8}{3}(- (1)/(3(3x - 1))) + \\frac{2}{3}(- (1)/(6(3x - 1)^{2})) + K \\\\ = \\frac{1}{3}\\ln & 3x - 1\\end{vmatrix}- (8)/(9(3x - 1)) - (1)/(9(3x - 1)^{2}) + K\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068595 1069 "e-510" 13194139533346 17592186045585 true] [17592186068595 1071 "Evaluate $\\displaystyle \\int \\dfrac{4x^2-x}{(x^2+x+1)(x-2)} \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068595 1072 #uuid "3a2e21bb-c966-5429-98c0-9af209c45dfe" 13194139533346 17592186045585 true] [17592186068595 1074 "Notice that the quadratic factor in the denominator has a negative discriminant:\n\n$$\n\\mathcal{D} = 1^2 - 4(1)(1) = -3 < 0\n$$\n\nSo, we proceed with the following partial fraction decomposition:\n\n$$\n\\begin{aligned}\n(4x^{2} - x)/((x^{2} + x + 1)(x - 2)) &= \\frac{Ax + B}{x^{2} + x + 1} + \\frac{C}{x - 2}\n\\end{aligned}\n$$\n\nTo determine the coefficients $A$, $B$, and $C$, we first multiply both sides of the above equation by $(x^2+x+1)(x-2)$ and get\n\n$$\n\\begin{aligned}\n4x^{2} - x &= (Ax + B)(x - 2) + C(x^{2} + x + 1)\n\\end{aligned}\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=2$, $B=1$, and $C=2$. Therefore,\n\n$$\n\\dfrac{4x^2-x}{(x^2+x+1)(x-2)} = \\dfrac{2x+1}{x^2+x+1} + \\dfrac{2}{x-2}\n$$\n\nNow we integrate this function term by term, adding the constant of integration only at the very end.\n\n$$\n\\begin{aligned}\n\\int(4x^{2} - x)/((x^{2} + x + 1)(x - 2))dx &= \\int(\\frac{2x + 1}{x^{2} + x + 1} + \\frac{2}{x - 2})dx \\\\\n&= \\int\\frac{2x + 1}{x^{2} + x + 1}dx + 2\\int\\frac{1}{x - 2}dx\n\\end{aligned}\n$$\n\nFor the first integral, we use the substitution\n\n$$\nu = x^2+x+1\n$$\n\nThen\n\n$$\n(2x+1) \\, \\textrm{d}x=\\textrm{d}u\n$$\n\nand we get\n\n$$\n\\begin{aligned}\n\\int\\frac{2x + 1}{x^{2} + x + 1}dx &= \\int(\\frac{1}{u})du \\\\\n&= \\ln \\mid u \\mid \\\\\n&= \\ln \\mid x^{2} + x + 1 \\mid \\\\\n&= \\ln (x^{2} + x + 1)\n\\end{aligned}\n$$\n\nFor the second integral we have\n\n$$\n\\begin{aligned}\n\\int\\frac{1}{x - 2}dx &= \\ln \\mid x - 2 \\mid\n\\end{aligned}\n$$\n\nSo we get the following result:\n\n$$\n\\begin{aligned}\n\\int(4x^{2} - x)/((x^{2} + x + 1)(x - 2))dx &= \\int\\frac{2x + 1}{x^{2} + x + 1}dx + 2\\int\\frac{1}{x - 2}dx \\\\\n&= \\ln (x^{2} + x + 1) + 2\\ln \\mid x - 2 \\mid + K\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068596 1069 "e-5126" 13194139533346 17592186045585 true] [17592186068596 1071 "Simplify $\\dfrac{2+a}{2a} + \\dfrac{3+2a}{2a}$." 13194139533346 17592186045585 true] [17592186068596 1072 #uuid "bea63d2c-7283-5b7d-997a-8f6f583fd0cf" 13194139533346 17592186045585 true] [17592186068596 1074 "We have a common denominator of $2a$, so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\n\\frac{2 + a}{2a} + \\frac{3 + 2a}{2a} &=  \\\\\n\\frac{2 + a + 3 + 2a}{2a} &=  \\\\\n\\frac{2 + 3 + a + 2a}{2a} &=  \\\\\n&= \\frac{5 + 3a}{2a}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068597 1069 "e-5128" 13194139533346 17592186045585 true] [17592186068597 1071 "Given that $\\dfrac 3 {2x}=a$ and $\\dfrac y x=b$, what is $a+b$?" 13194139533346 17592186045585 true] [17592186068597 1072 #uuid "c2ecd403-976d-567a-a45d-d811257abfcb" 13194139533346 17592186045585 true] [17592186068597 1074 "We wish to add the following fractions:\n\n$$\na+b = \\dfrac 3 {2x} + \\dfrac y x\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2x$ if we multiply the top and bottom of the second fraction by $2$:\n\n$$\n\\begin{aligned} \\dfrac 3 {2x} + \\dfrac y x \\\\[5pt] &= \\dfrac 3 {2x} + \\dfrac 2 2 \\cdot \\dfrac y x \\\\[5pt] &= \\dfrac 3 {2x} + \\dfrac {2y} {2x} \\\\[5pt] &= \\dfrac {3 + 2y} {2x} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068598 1069 "e-5129" 13194139533346 17592186045585 true] [17592186068598 1071 "Simplify $\\dfrac{y}{x(1+y)} + \\dfrac{y}{1+y}$." 13194139533346 17592186045585 true] [17592186068598 1072 #uuid "1da3fbaf-ef04-56b7-8ddc-338e797b00db" 13194139533346 17592186045585 true] [17592186068598 1074 "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $x(y+1)$ if we multiply the top and bottom of the second fraction by $x$:\n\n$$\n\\begin{aligned}\n(y)/(x(1 + y)) + \\frac{y}{1 + y} &=  \\\\\n(y)/(x(1 + y)) + \\frac{x}{x} \\cdot \\frac{y}{1 + y} &=  \\\\\n(y)/(x(1 + y)) + (xy)/(x(1 + y)) &=  \\\\\n(y + xy)/(x(1 + y)) &=  \\\\\n&= (y(1 + x))/(x(1 + y))\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068599 1069 "e-5131" 13194139533346 17592186045585 true] [17592186068599 1071 "Simplify $\\dfrac 2 x \\cdot \\dfrac 3 {y^2}$." 13194139533346 17592186045585 true] [17592186068599 1072 #uuid "5d90ba01-2318-5f03-9d7a-a7ad66555886" 13194139533346 17592186045585 true] [17592186068599 1074 "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned} \\dfrac 2 x \\cdot \\dfrac 3 {y^2} &=\\dfrac {2 \\cdot 3} {x \\cdot y^2} &=\\dfrac {6} {xy^2} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068600 1069 "e-5132" 13194139533346 17592186045585 true] [17592186068600 1071 "Given that $\\dfrac {6a} {b^2} = x$ and $\\dfrac {3b} {2a}= y$, what is $x\\cdot y$?" 13194139533346 17592186045585 true] [17592186068600 1072 #uuid "702e4d33-7021-5b21-9c9d-d41463f7b665" 13194139533346 17592186045585 true] [17592186068600 1074 "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\nx \\cdot y &= \\frac{6a}{b^{2}} \\cdot \\frac{3b}{2a} \\\\\n&= \\frac{6a \\cdot 3b}{b^{2} \\cdot 2a} \\\\\n&= \\frac{18ab}{2ab^{2}} \\\\\n&= \\frac{9}{b}\n\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying." 13194139533346 17592186045585 true] [17592186068601 1069 "e-5133" 13194139533346 17592186045585 true] [17592186068601 1071 "Simplify $\\dfrac {(n + 1)(n + 3)} {4n^2} \\cdot \\dfrac {8n}{(n + 3)(n - 2)}$." 13194139533346 17592186045585 true] [17592186068601 1072 #uuid "e75ba094-e762-5e8d-9175-1d9617d32128" 13194139533346 17592186045585 true] [17592186068601 1074 "First, we cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\n((n + 1)(n + 3))/(4n^{2}) \\cdot (8n)/((n + 3)(n - 2)) &= ((n + 1)(n + 3))/(4n \\cdot n) \\cdot (2 \\cdot 4n)/((n + 3)(n - 2)) \\\\\n&= \\frac{n + 1}{n} \\cdot \\frac{2}{n - 2} \\\\\n&= \\frac{2n + 2}{n^{2} - 2n}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068602 1069 "e-5134" 13194139533346 17592186045585 true] [17592186068602 1071 "Simplify $\\dfrac {3p - 12}{p^2 - 9} \\cdot \\dfrac {p + 3} {p - 4}$." 13194139533346 17592186045585 true] [17592186068602 1072 #uuid "e521a677-4e95-5c86-80c1-447924b6d34d" 13194139533346 17592186045585 true] [17592186068602 1074 "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned} \\dfrac {3p - 12}{p^2 - 9} \\cdot \\dfrac {p + 3} {p - 4} &=\\dfrac {3(p - 4)} {(p + 3)(p - 3)} \\cdot \\dfrac {p + 3} {p - 4} \\\\[5pt] &=\\dfrac {3\\cancel{(p - 4)}} {\\cancel{(p + 3)}(p - 3)} \\cdot \\dfrac {\\cancel{p + 3}} {\\cancel{p - 4}} \\\\[5pt] &=\\dfrac {3}{p - 3} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068603 1069 "e-5135" 13194139533346 17592186045585 true] [17592186068603 1071 "What is the result of dividing $\\dfrac 3 x$ by $\\dfrac y {6x^2}$?" 13194139533346 17592186045585 true] [17592186068603 1072 #uuid "4fba84c9-6c0f-51cd-b5f2-8b469bd8346f" 13194139533346 17592186045585 true] [17592186068603 1074 "To compute\n\n$$\n\\dfrac{3}{x} \\div \\dfrac{y}{6x^2}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac 3 x \\div \\dfrac y {6x^2} &=\\ \\dfrac 3 x \\cdot \\dfrac {6x^2} y &=\\ \\dfrac {18x^2} {xy}&=\\ \\dfrac {18x^\\cancel{2}} {\\cancel{x}y}&=\\ \\dfrac {18x} {y}& \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $x$ in the numerator and denominator." 13194139533346 17592186045585 true] [17592186068604 1069 "e-5136" 13194139533346 17592186045585 true] [17592186068604 1071 "Given that $\\dfrac {2a^2(1+b)} {3b} =x$ and $\\dfrac {1+b}{5b^2} =y$, then what is $x \\div y$?" 13194139533346 17592186045585 true] [17592186068604 1072 #uuid "fa6bbedb-654a-58a5-8fcf-3bb0fd038160" 13194139533346 17592186045585 true] [17592186068604 1074 "To compute $x \\div y$, i.e.,\n\n$$\n(2a^{2}(1 + b))/(3b) \\mid \\div \\frac{1 + b}{5b^{2}}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {2a^2(1+b)} {3b} \\div \\dfrac{1+b}{5b^2} \\\\[5pt] &= \\dfrac {2a^2(1+b)} {3b} \\cdot \\dfrac {5b^2} {1+b} \\\\[5pt] &= \\dfrac {2a^2\\cancel{(1+b)}} {3\\cancel{b}} \\cdot \\dfrac {5b^{\\cancel{2}}} {\\cancel{1+b}} \\\\[5pt] &= \\dfrac {10a^2b} {3} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068605 1069 "e-5143" 13194139533346 17592186045585 true] [17592186068605 1071 "Determine the quotient and remainder of $6x^3-x^2+3x+1$ divided by $3x^2+x+2$." 13194139533346 17592186045585 true] [17592186068605 1072 #uuid "a2aac357-23c5-5038-84c6-bc263bd45afa" 13194139533346 17592186045585 true] [17592186068605 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n3x^{2} + x + 22x - 1; 3x^{2} + x + 26x^{3} - 0x^{2} + 3x + 1; 3x^{2} + x + 26x^{3} + 2x^{2} + 4x_(―); 3x^{2} + x + 26x^{3} - 3x^{2} - 0x + 1; 3x^{2} + x + 26x^{3}- 3x^{2} - 0x - 2_(―); 3x^{2} + x + 26x^{3} - 3x^{2} - x +3\n$$\n\nTherefore,\n\n- the quotient is ${\\color{blue}2x-1}$, and\n- the remainder is ${\\color{red}3}$." 13194139533346 17592186045585 true] [17592186068606 1069 "e-5144" 13194139533346 17592186045585 true] [17592186068606 1071 "Find the quotient and remainder of the following division problem:\n\n$\\dfrac{2x^4 - 7x^2 - x + 8}{x^2 - 1}$" 13194139533346 17592186045585 true] [17592186068606 1072 #uuid "bd9a160c-574e-506e-865c-d08061c75aed" 13194139533346 17592186045585 true] [17592186068606 1074 "Notice that the dividend is missing the $x^3$ term. So, we first rewrite it by including the missing term with a coefficient of zero, as follows:\n\n$$\n2x^4-7x^2-x+8 = 2x^4+{\\color{red}0}x^3-7x^2-x+8\n$$\n\nNow, using the method of polynomial division, we obtain the following:\n\n$$\nx^{2} - 12x^{2} - 5; x^{2} - 12x^{4} + 0x^{3} - 7x^{2} - 0x + 8; x^{2} - 12x^{4} + 0x^{3} - 2x^{2}_(―); x^{2} - 12x^{4} + 0x^{3} - 5x^{2} - 0x + 8; x^{2} - 12x^{4} + 0x^{3}- 5x^{2} + 0x + 5_(―); x^{2} - 12x^{4} + 0x^{3} - 5x^{2}- 0x + 3\n$$\n\nAs a result,\n\n- the quotient is ${2x^2 - 5}$, and\n- the remainder is ${-x+3}$.\n\nTherefore,\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} = 2x^2-5 + \\dfrac{-x+3}{x^2-1}\n$$\n\nWe can rewrite this result as follows:\n\n$$\n\\dfrac{2x^4 - 7x^2 - x +8}{x^2 - 1} = 2x^2-5 - \\dfrac{x-3}{x^2-1}\n$$" 13194139533346 17592186045585 true] [17592186068607 1069 "e-5192" 13194139533346 17592186045585 true] [17592186068607 1071 "Find the points of intersection, if any, of the curve $y=\\dfrac{1}{x-2}+1$ and the line $y=-x+3$." 13194139533346 17592186045585 true] [17592186068607 1072 #uuid "7fb3c0cb-147c-5d02-a470-c86591394f2c" 13194139533346 17592186045585 true] [17592186068607 1074 "We need to solve the following system of equations:\n\n$$\n{y = \\frac{1}{x - 2} + 1; y =-x + 3\n$$\n\nSetting the equations equal to one another simplifying, we get a quadratic equation:\n\n$$\n\\begin{aligned}\n\\frac{1}{x - 2} + 1 &= -x + 3 \\\\\n\\frac{1}{x - 2} &= -x + 2 \\\\\n1 &= (-x + 2)(x - 2) \\\\\n1 &= -x^{2} + 4x - 4 \\\\\nx^{2} - 4x + 5 &= 0\n\\end{aligned}\n$$\n\nThen, we use the quadratic formula:\n\n$$\n\\begin{aligned}\nx &= (4 ± \\sqrt{(-4)^{2} - 4(1)(5)})/(2(1)) \\\\\n&= \\frac{4 ± \\sqrt{16 - 20}}{2} \\\\\n&= \\frac{4 ± \\sqrt{-4}}{2}\n\\end{aligned}\n$$\n\nThe square root of a negative number is not a real number, so there are no real solutions. Consequently, the line\n\n$$\ny=-x+3\n$$\n\ndoes not intersect the reciprocal function\n\n$$\ny=\\dfrac{1}{x-2}+1\n$$\n\nA sketch of the situation is shown below.\n\n![](images/30/30eb7faffa9cdfbffedbbf0c9d48408fb1be1b8101da80864c4bced5d53d9903.png)" 13194139533346 17592186045585 true] [17592186068608 1069 "e-5193" 13194139533346 17592186045585 true] [17592186068608 1071 "![](images/76/76c0e8aed74f2dcf3a382f79768098eda4f359631cdffb812a0aeccbb9707976.png)\n\nFind the points where the line $y=2x-3$ and the curve $y=\\dfrac{1}{x-2}$ intersect (shown as the points $A$ and $B$ above)." 13194139533346 17592186045585 true] [17592186068608 1072 #uuid "ffb2b712-52b9-5a09-9ac4-10a88f72f57e" 13194139533346 17592186045585 true] [17592186068608 1074 "We need to solve the following system of equations:\n\n$$\n{y = 2x - 3; y = \\frac{1}{x - 2}\n$$\n\nSetting the equations equal and then solving for $x$, we get the following:\n\n$$\n\\begin{aligned}\n2x - 3 &= \\frac{1}{x - 2} \\\\\n(x - 2)(2x - 3) &= 1 \\\\\n2x^{2} - 7x + 6 &= 1 \\\\\n2x^{2} - 7x + 5 &= 0 \\\\\n(x - 1)(2x - 5) &= 0 \\\\\nx &= 1, \\frac{5}{2}\n\\end{aligned}\n$$\n\nSo, the $x$-coordinates of the intersection points are $x=1$ and\n\n$$\nx=\\dfrac{5}{2}\n$$\n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the first equation.\n\n- First, substituting $x=1$, we get\n$y|= 2x - 3; = 2(1) - 3; =-1$,\nso one point of intersection is $(1,-1)$.\n- Then, substituting $x=\\dfrac{5}{2}$, we get\n$y|= 2x - 3; = 2(\\frac{5}{2}) - 3; = 2$,\nso the other point of intersection is $\\left(\\dfrac{5}{2}, 2 \\right)$.\n\nTherefore, the points of intersection are $(1,-1)$ and\n\n$$\n\\left(\\dfrac{5}{2}, 2 \\right)\n$$" 13194139533346 17592186045585 true] [17592186068609 1069 "e-5195" 13194139533346 17592186045585 true] [17592186068609 1071 "Find the point(s) of intersection of the curves $y=\\sqrt {x+1}$ and $y=\\dfrac{x}{2}+\\dfrac{1}{2}$." 13194139533346 17592186045585 true] [17592186068609 1072 #uuid "f4e10cc3-f6f6-5cd8-b240-60417f37a021" 13194139533346 17592186045585 true] [17592186068609 1074 "We need to solve the following system:\n\n$$\n{y = \\sqrt{x + 1}; y = \\frac{x}{2} + \\frac{1}{2}\n$$\n\nSetting the equations equal to one another and then solving for $x$, we get:\n\n$$\n\\begin{aligned}\n\\sqrt{x + 1} &= \\frac{x}{2} + \\frac{1}{2} \\\\\nx + 1 &= (\\frac{x}{2} + \\frac{1}{2})^{2} \\\\\nx + 1 &= \\frac{x^{2}}{4} + \\frac{x}{2} + \\frac{1}{4} \\\\\n4x + 4 &= x^{2} + 2x + 1 \\\\\nx^{2} - 2x - 3 &= 0 \\\\\n(x + 1)(x - 3) &= 0 \\\\\nx &= -1, 3\n\\end{aligned}\n$$\n\nSince we're dealing with square roots, we need to plug each of these solutions back into\n\n$$\n\\sqrt {x+1}=\\dfrac{x}{2}+\\dfrac{1}{2}\n$$\n\nto check whether it satisfies the original equation.\n\n- For $x=-1$, we have\n$\\sqrt{-1 + 1}|= \\frac{-1}{2} + \\frac{1}{2}; 0|= 0, ✓$\nso $x=-1$ is indeed a solution of $\\sqrt {x+1}=\\dfrac{x}{2}+\\dfrac{1}{2}$.\n- For $x=3$, we have\n$\\sqrt{3 + 1}|= \\frac{3}{2} + \\frac{1}{2}; 2|= 2, ✓$\nso $x=3$ is indeed a solution of $\\sqrt {x+1}=\\dfrac{x}{2}+\\dfrac{1}{2}$.\n\nWe found that both $x=-1$ and $x=3$ are solutions of\n\n$$\n\\sqrt {x+1}=\\dfrac{x}{2}+\\dfrac{1}{2}\n$$\n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the radical curve, since it looks simpler.\n\n- Substituting $x=-1$, we get\n$y|= \\sqrt{x + 1}; = \\sqrt{-1 + 1}; = \\sqrt{0}; = 0$,\nso one point of intersection is $(-1,0)$.\n- Substituting $x=3$, we get\n$y|= \\sqrt{x + 1}; = \\sqrt{3 + 1}; = \\sqrt{4}; = 2$,\nso the other point of intersection is $(3,2)$.\n\nTherefore, we conclude that the points of intersection of the two curves are $(-1,0)$ and $(3,2)$.\n\nA sketch of the situation is shown below.\n\n![](images/b4/b4444f4cbb83e5a9d55f6d654a25b7b79ff8a2f02dc6a36d290e5fdf1da42da2.png)" 13194139533346 17592186045585 true] [17592186068610 1069 "e-5206" 13194139533346 17592186045585 true] [17592186068610 1071 "What is the result of dividing $\\dfrac 3 x$ by $\\dfrac {5}{y}$?" 13194139533346 17592186045585 true] [17592186068610 1072 #uuid "dd8b5378-4da1-5955-a566-f84ef0cecb28" 13194139533346 17592186045585 true] [17592186068610 1074 "To compute\n\n$$\n\\dfrac{3}{x} \\div \\dfrac{5}{y}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned} \\dfrac 3 x \\div \\dfrac 5 y&=\\ \\dfrac 3 x \\cdot \\dfrac y 5&=\\ \\dfrac {3y} {5x} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068611 1069 "e-5207" 13194139533346 17592186045585 true] [17592186068611 1071 "Given that $\\dfrac {2a^3 - 10a} {7b} =x$ and $\\dfrac {2a} {14b^2}=y$, then what is $x \\div y$?" 13194139533346 17592186045585 true] [17592186068611 1072 #uuid "3fd58494-e5ee-5dc7-af3c-959888f59627" 13194139533346 17592186045585 true] [17592186068611 1074 "To compute\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {2a^3 - 10a} {7b} &\\div \\dfrac {2a} {14b^2}, \\end{aligned}\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {2a^3 - 10a} {7b} \\div \\dfrac {2a} {14b^2}&=\\ \\dfrac {2a^3 - 10a} {7b} \\cdot \\dfrac {14b^2} {2a}&=\\ \\dfrac {2a(a^2 - 5)} {7b} \\cdot \\dfrac {2b \\cdot 7b} {2a}&=\\ \\dfrac {\\cancel{2a}(a^2 - 5)} {\\cancel{7b}} \\cdot \\dfrac {2b \\cdot \\cancel{7b}} {\\cancel{2a}}&=\\ \\dfrac {2b(a^2 - 5)} 1 \\\\ &= 2a^2b - 10b & \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068612 1069 "e-5260" 13194139533346 17592186045585 true] [17592186068612 1071 "The line $y=2x+3$ does not intersect the reciprocal function $y=\\dfrac{k}{x+3}$, where $k \\neq 0$. What is the range of possible values of $k$?" 13194139533346 17592186045585 true] [17592186068612 1072 #uuid "b7b1d18b-256a-5aa4-9bcb-bd62e512231d" 13194139533346 17592186045585 true] [17592186068612 1074 "To determine whether the line\n\n$$\ny=2x+3\n$$\n\nintersects the reciprocal function\n\n$$\ny=\\dfrac{k}{x+3}\n$$\n\nwe need to solve the following system of equations for the two curves:\n\n$$\n{y = \\frac{k}{x + 3}; y = 2x + 3\n$$\n\nSetting the equations equal to one another and simplifying, we get a quadratic equation:\n\n$$\n\\begin{aligned}\n\\frac{k}{x + 3} &= 2x + 3 \\\\\nk &= (2x + 3)(x + 3) \\\\\nk &= 2x^{2} + 9x + 9 \\\\\n2x^{2} + 9x + 9 - k &= 0\n\\end{aligned}\n$$\n\nThen, we use the quadratic formula:\n\n$$\n\\begin{aligned}\nx &= (-9 ± \\sqrt{9^{2} - 4(2)(9 - k)})/(2(2)) \\\\\n&= \\frac{-9 ± \\sqrt{81 - 72 + 8k}}{4} \\\\\n&= \\frac{-9 ± \\sqrt{9 + 8k}}{4}\n\\end{aligned}\n$$\n\nFor the line *not* to intersect the reciprocal function, the quadratic formula above must *not* give any real solutions.\n\nSo, the expression inside the square root must be negative:\n\n$$\n\\begin{bmatrix}9 + 8k & < 0 \\\\ 8k & < - 9 \\\\ k & < - \\frac{9}{8}\\end{bmatrix}\n$$\n\nTherefore, the range of possible values of $k$ is\n\n$$\nk<-\\dfrac{9}{8}\n$$" 13194139533346 17592186045585 true] [17592186068613 1069 "e-5290" 13194139533346 17592186045585 true] [17592186068613 1071 "Find the point(s) of intersection of the curves $y=\\sqrt{x-1}$ and $y=x+2$." 13194139533346 17592186045585 true] [17592186068613 1072 #uuid "fec22f7a-5fdf-5ac0-ab1b-0a649bc64b56" 13194139533346 17592186045585 true] [17592186068613 1074 "We need to solve the following system:\n\n$$\n{y = \\sqrt{x - 1}; y = x + 2\n$$\n\nSetting the equations equal to one another and then solving for $x$, we get:\n\n$$\n\\begin{aligned}\n\\sqrt{x - 1} &= x + 2 \\\\\nx - 1 &= (x + 2)^{2} \\\\\nx - 1 &= x^{2} + 4x + 4 \\\\\nx^{2} + 3x + 5 &= 0\n\\end{aligned}\n$$\n\nThen, we use the quadratic formula:\n\n$$\n\\begin{aligned}\nx &= (-3 ± \\sqrt{3^{2} - 4(1)(5)})/(2(1)) \\\\\n&= \\frac{-3 ± \\sqrt{9 - 20}}{2} \\\\\n&= \\frac{-3 ± \\sqrt{-11}}{2}\n\\end{aligned}\n$$\n\nThe square root of a negative number is not a real number, so there are no real solutions. Consequently, the line\n\n$$\ny=x+2\n$$\n\ndoes not intersect the radical function\n\n$$\ny=\\sqrt{x-1}\n$$\n\nA sketch of the situation is shown below.\n\n![](images/14/143a459e61679fa80cf65c26c9884dbdbb0dd95af2453ee040d2517e654bed98.png)" 13194139533346 17592186045585 true] [17592186068614 1069 "e-552" 13194139533346 17592186045585 true] [17592186068614 1071 "Write down an integral that gives the area of the finite region bounded by the curves $y=x^2$ and $y=\\sqrt x$, as shown below.\n\n![](images/b9/b98474e6de2c94876a75758d56a7fb356de22bccd029bfeed0207affebab09ce.png)" 13194139533346 17592186045585 true] [17592186068614 1072 #uuid "481f1075-efc3-546a-a1f3-9415f7fc642d" 13194139533346 17592186045585 true] [17592186068614 1074 "The diagram shows that the intersection points between the two graphs occur when $x=0$ and $x=1$. So these will be our limits of integration.\n\nTo determine which is the lower function and which is the upper, let's draw our vertical arrow.\n\n![](images/1b/1b1c2b1826fa988ba23f7270b4c8bbdc91bf03066e8ca3638def329466d5b93e.png)\n\nThe vertical line\n\n- *enters* the region through the lower function $y=x^2$, and\n- *leaves* through the upper function $y=\\sqrt x$.\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}\nA &= \\int_{0}^{1}[(upper function) - (lower function)]dx \\\\\n&= \\int_{0}^{1}[(\\sqrt{x}) - (x^{2})]dx \\\\\n&= \\int_{0}^{1}(\\sqrt{x} - x^{2})dx\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068615 1069 "e-553" 13194139533346 17592186045585 true] [17592186068615 1071 "Find the area of the finite region enclosed between $f(x) =x^2-2x+2$ and $g(x) = 2$, shown below.\n\n![](images/01/01f139c53b6328341b463f5ad941d37fccb241fff109c0584207017341e8e5f7.png)" 13194139533346 17592186045585 true] [17592186068615 1072 #uuid "ff023940-30f8-5b30-ab1b-9ca1f335a6a8" 13194139533346 17592186045585 true] [17592186068615 1074 "First, we want to determine the limits of integration. To do this, we equate the two functions and solve for $x$:\n\n$$\n\\begin{aligned}\nx^{2} - 2x + 2 &= 2 \\\\\nx^{2} - 2x &= 0 \\\\\nx(x - 2) &= 0\n\\end{aligned}\n$$\n\nHence, we need to integrate from $x=0$ to $x=2$.\n\nTo determine which is the lower function and which is the upper, we draw our vertical arrow.\n\n![](images/39/39798ef4ff6e898527864628dc2750f88b115c03b2d6b8fb729f30b21d2d2bf5.png)\n\nThe vertical line\n\n- *enters* the region through the lower function $y=x^2-2x+2$, and\n- *leaves* through the upper function $y=2$.\n\nTherefore, we can find the area as follows:\n\n$$\n\\begin{aligned}\nA &= \\int_{0}^{2}[(upper function) - (lower function)]dx \\\\\n&= \\int_{0}^{2}[(2) - (x^{2} - 2x + 2)]dx \\\\\n&= \\int_{0}^{2}(-x^{2} + 2x)dx \\\\\n&= \\int_{0}^{2}(2x - x^{2})dx \\\\\n&= \\left.(x^{2} - \\frac{1}{3}x^{3})\\right|_{0}^{2} \\\\\n&= (2^{2} - \\frac{1}{3} \\cdot 2^{3}) - (0 - 0) \\\\\n&= (4 - \\frac{8}{3}) - 0 \\\\\n&= \\frac{4}{3}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068616 1069 "e-554" 13194139533346 17592186045585 true] [17592186068616 1071 "What is the integral that gives the area of the finite region bounded by $y=x^2+x+5$ and $y=x+9$?" 13194139533346 17592186045585 true] [17592186068616 1072 #uuid "d1c021cd-b537-5504-8836-eb7a59ba86b6" 13194139533346 17592186045585 true] [17592186068616 1074 "First, let's draw a sketch of the two functions.\n\n![](images/5f/5f6980e3a7e4c7d1a5cc5d9b93a0110764b34ea6b7a4bec7c828f04cef842f7f.png)\n\n*(Note: Figure not drawn to scale)*\n\nNow, we want to determine the limits of integration. To do this, we equate the two functions and solve for $x$:\n\n$$\n\\begin{aligned}\nx^{2} + x + 5 &= x + 9 \\\\\nx^{2} - 4 &= 0 \\\\\n(x - 2)(x + 2) &= 0\n\\end{aligned}\n$$\n\nHence, we need to integrate from $x=-2$ to $x=2$.\n\nTo determine which is the lower function and which is the upper, let's draw our vertical arrow.\n\n![](images/3c/3c52f1405079380459e60ad35e05218d1f0468ee177f1e383498c672d48eaa8d.png)\n\nThe vertical line\n\n- *enters* the region through the lower function $y=x^2+x+5$, and\n- *leaves* through the upper function $y=x+9$.\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}\nA &= \\int_{-2}^{2}[(upper function) - (lower function)]dx \\\\\n&= \\int_{-2}^{2}[(x + 9) - (x^{2} + x + 5)]dx \\\\\n&= \\int_{-2}^{2}(4 - x^{2})dx\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068617 1069 "e-555" 13194139533346 17592186045585 true] [17592186068617 1071 "What integral gives the area of the finite region bounded between the curves $x=1-y^2$ and $x=1-2y+y^2$?\n\n![](images/82/82ecb704e04cbf5ad72dfecabaf728e426cc6fc92fffaa415da65b79afc199f2.png)" 13194139533346 17592186045585 true] [17592186068617 1072 #uuid "83abdf2b-abb0-57ab-8e96-17fb79730571" 13194139533346 17592186045585 true] [17592186068617 1074 "From the diagram, we see that the points of intersection between the two functions occur when $y=0$ and $y=1$. So these will be our limits of integration.\n\nTo determine which is the left function and which is the right, let's draw our horizontal arrow (from left to right).\n\n![](images/75/753ad7d3d24eab93c9950214d7fbddb9c3dbeac1fa04ed79ecf58d4a3ab04445.png)\n\nThe horizontal line\n\n- *enters* the region through the left function $x=1-2y+y^2$, and\n- *leaves* through the right function $x=1-y^2$.\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}\nA &= \\int_{0}^{1}[(right function) - (left function)]dy \\\\\n&= \\int_{0}^{1}[(1 - y^{2}) - (1 - 2y + y^{2})]dy \\\\\n&= \\int_{0}^{1}(-2y^{2} + 2y)dy\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068618 1069 "e-556" 13194139533346 17592186045585 true] [17592186068618 1071 "Calculate the area of the finite region bounded between the curves $x=9-2y^2$ and $x=y^2$?" 13194139533346 17592186045585 true] [17592186068618 1072 #uuid "bfc2a3b8-f7f5-5c5a-97b1-3f1c36c49fe7" 13194139533346 17592186045585 true] [17592186068618 1074 "First, let's draw the graphs of the two functions:\n\n![](images/5e/5e2123f9d2123f1dc9f563e416c4556c8b4f7820a9914cb811eac4d0bc4ae7e3.png)\n\n*(Note: Figure not drawn to scale)*\n\nNow, we want to determine the limits of integration. To do this, we equate the two functions and solve for $y$:\n\n$$\n\\begin{aligned}\ny^{2} &= 9 - 2y^{2} \\\\\n3y^{2} &= 9 \\\\\ny^{2} &= 3 \\\\\ny &= ± \\sqrt{3}\n\\end{aligned}\n$$\n\nHence, we need to integrate from\n\n$$\ny=-\\sqrt 3\n$$\n\nto\n\n$$\ny=\\sqrt 3\n$$\n\nTo determine which is the left function and which is the right, let's draw our horizontal arrow (from left to right).\n\n![](images/bc/bc312ddc975f73957991e81231fe9b21da1800bf1dc1efa8a08044fe0eda9e53.png)\n\nThe horizontal line\n\n- *enters* the region through the left function $x=y^2$, and\n- *leaves* through the right function $x=9-2y^2$.\n\nTherefore, we can find the area as follows:\n\n$$\n\\begin{aligned}\nA &= \\int_{-\\sqrt{3}}^{\\sqrt{3}}[(right function) - (left function)]dy \\\\\n&= \\int_{-\\sqrt{3}}^{\\sqrt{3}}[(9 - 2y^{2}) - (y^{2})]dy \\\\\n&= \\int_{-\\sqrt{3}}^{\\sqrt{3}}(9 - 3y^{2})dy \\\\\n&= \\left.9y\\right|_{-\\sqrt{3}}^{\\sqrt{3}} - \\left.y^{3}\\right|_{-\\sqrt{3}}^{\\sqrt{3}} \\\\\n&= 9(\\sqrt{3} - (-\\sqrt{3})) - ((\\sqrt{3})^{3} - (-\\sqrt{3})^{3}) \\\\\n&= 18\\sqrt{3} - 6\\sqrt{3} \\\\\n&= 12\\sqrt{3}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068619 1069 "e-557" 13194139533346 17592186045585 true] [17592186068619 1071 "Which integral gives the area of the finite region bounded by the curves $x=y^4$, $x=6-y^2$, and the $x$-axis?\n\n![](images/f5/f59ee1131a2f47630415ab227cdfa953ffb183824e508f9f15fb417d266e2f16.png)" 13194139533346 17592186045585 true] [17592186068619 1072 #uuid "660758e0-e8a0-5dcf-b4c3-4ad89061273c" 13194139533346 17592186045585 true] [17592186068619 1074 "First, we want to determine the limits of integration. To do this, we equate the two functions and solve for $y$:\n\n$$\n\\begin{aligned}\ny^{4} &= 6 - y^{2} \\\\\ny^{4} + y^{2} - 6 &= 0 \\\\\n(y^{2} + 3)(y^{2} - 2) &= 0\n\\end{aligned}\n$$\n\nSince\n\n$$\ny^2+3=0\n$$\n\nhas no real solutions, we get only\n\n$$\ny=\\sqrt{2}\n$$\n\nHence, we need to integrate from $y=0$ to\n\n$$\ny=\\sqrt{2}\n$$\n\nTo determine which is the left function and which is the right, let's draw our horizontal arrow (from left to right).\n\n![](images/77/77c2c40c1f2529a7069225a99eb0a70078a8377e690d9adfef3e94d2467b5f8d.png)\n\nThe horizontal line\n\n- *enters* the region through the left function $x=y^4$, and\n- *leaves* through the right function $x=6- y^2$.\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}\nA &= \\int_{c}^{d}[(right function) - (left function)]dy \\\\\n&= \\int_{0}^{\\sqrt{2}}[(6 - y^{2}) - (y^{4})]dy \\\\\n&= \\int_{0}^{\\sqrt{2}}(-y^{4} - y^{2} + 6)dy\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068620 1069 "e-5823" 13194139533346 17592186045585 true] [17592186068620 1071 "Solve for $a$ where $\\dfrac{2a -5}{3a^2} + \\dfrac{1}{a} = \\dfrac{a-1}{2a^2}$." 13194139533346 17592186045585 true] [17592186068620 1072 #uuid "8787186e-94bd-53da-9304-b0d3efbcb966" 13194139533346 17592186045585 true] [17592186068620 1074 "First, note that $a = 0$ cannot be a solution since division by $0$ is undefined.\n\nNow, let's multiply both sides of the equation by the least common denominator. The equation has the denominators $3a^2$, $a$, and $2a^2$, so the least common multiple (or $\\textrm{LCM}$) of the denominators is\n\n$$\n\\textrm{LCM}(3a^2, a, 2a^2) = 6a^2\n$$\n\nMultiplying both sides of the equation by $6a^2$ and simplifying, we get\n\n$$\n\\begin{aligned}\n\\frac{2a - 5}{3a^{2}} + \\frac{1}{a} &= \\frac{a - 1}{2a^{2}} \\\\\n6a^{2} \\cdot (\\frac{2a - 5}{3a^{2}} + \\frac{1}{a}) &= 6a^{2} \\cdot (\\frac{a - 1}{2a^{2}}) \\\\\n6a^{2} \\cdot (\\frac{2a - 5}{3a^{2}}) + 6a^{2} \\cdot (\\frac{1}{a}) &= 6a^{2} \\cdot (\\frac{a - 1}{2a^{2}}) \\\\\n2 \\cdot 3a^{2} \\cdot (\\frac{2a - 5}{3a^{2}}) + 6a \\cdot a \\cdot (\\frac{1}{a}) &= 3 \\cdot 2a^{2} \\cdot (\\frac{a - 1}{2a^{2}}) \\\\\n2 \\cdot 3a^{2} \\cdot (\\frac{2a - 5}{3a^{2}}) + 6a \\cdot a \\cdot (\\frac{1}{a}) &= 3 \\cdot 2a^{2} \\cdot (\\frac{a - 1}{2a^{2}}) \\\\\n2 \\cdot (2a - 5) + 6a \\cdot (1) &= 3 \\cdot (a - 1) \\\\\n2(2a - 5) + 6a &= 3(a - 1)\n\\end{aligned}\n$$\n\nWe now have a linear equation in $a$, and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}\n2(2a - 5) + 6a &= 3(a - 1) \\\\\n4a - 10 + 6a &= 3a - 3 \\\\\n10a - 10 &= 3a - 3 \\\\\n10a - 3a &= -3 + 10 \\\\\n7a &= 7 \\\\\na &= 1\n\\end{aligned}\n$$\n\nFinally, recall that we cannot allow $a=0$ as a solution. Since $a=1$ is different from $a=0$, we can accept it as a solution.\n\nTherefore, the solution is $a=1$." 13194139533346 17592186045585 true] [17592186068621 1069 "e-5825" 13194139533346 17592186045585 true] [17592186068621 1071 "Solve for $x$ where $3 - \\dfrac{10x+7}{8x} = \\dfrac{6x-3}{2x}$." 13194139533346 17592186045585 true] [17592186068621 1072 #uuid "84d3492d-12bb-50c2-b5b4-5f08567eb4f5" 13194139533346 17592186045585 true] [17592186068621 1074 "First, note that $x=0$ cannot be a solution since division by $0$ is undefined.\n\nNow, let's multiply both sides of the equation by the least common denominator. The equation has the denominators $8x$ and $2x$, so the least common multiple (or $\\textrm{LCM}$) of the denominators is\n\n$$\n\\textrm{LCM}(8x,2x) = 8x\n$$\n\nMultiplying both sides of the equation by $8x$ and simplifying, we get\n\n$$\n\\begin{aligned}\n3 - \\frac{10x + 7}{8x} &= \\frac{6x - 3}{2x} \\\\\n8x \\cdot (3 - \\frac{10x + 7}{8x}) &= 8x \\cdot (\\frac{6x - 3}{2x}) \\\\\n8x \\cdot 3 - 8x \\cdot (\\frac{10x + 7}{8x}) &= 8x \\cdot (\\frac{6x - 3}{2x}) \\\\\n24x - 8x \\cdot (\\frac{10x + 7}{8x}) &= 4 \\cdot 2x \\cdot (\\frac{6x - 3}{2x}) \\\\\n24x - (10x + 7) &= 4 \\cdot (6x - 3)\n\\end{aligned}\n$$\n\nWe now have a linear equation in $x$, and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}\n24x - (10x + 7) &= 4 \\cdot (6x - 3) \\\\\n14x - 7 &= 24x - 12 \\\\\n24x - 14x &= -7 + 12 \\\\\n10x &= 5 \\\\\nx &= \\frac{1}{2}\n\\end{aligned}\n$$\n\nFinally, recall that we cannot allow $x=0$ as a solution. Since\n\n$$\nx= \\dfrac 12\n$$\n\nis different from $x=0$, we accept it as a solution.\n\nTherefore, the solution is\n\n$$\nx= \\dfrac 12\n$$" 13194139533346 17592186045585 true] [17592186068622 1069 "e-587" 13194139533346 17592186045585 true] [17592186068622 1071 "Consider the finite region bounded by the curve $y=2x-x^2$ and the $x$-axis, as shown below. What integral gives the volume of the solid generated when that region is rotated $2\\pi$ radians about the $x$-axis?\n\n![](images/72/72502a3e75c9688a95cfa74108ad9cf82114580b865c33af85a97e012a1fd425.png)" 13194139533346 17592186045585 true] [17592186068622 1072 #uuid "53763f9f-33d7-589b-8267-3c28cfa95f4f" 13194139533346 17592186045585 true] [17592186068622 1074 "First, we want to determine the limits of integration. We find the intersections of the curve with the $x$-axis by solving the following equation for $x$:\n\n$$\n\\begin{aligned}\n2x - x^{2} &= 0 \\\\\nx(2 - x) &= 0\n\\end{aligned}\n$$\n\nThe solutions are $x=0$ and $x=2$. So, we need to integrate from $x=0$ to $x=2$.\n\nFinally, the volume can be found as follows:\n\n$$\n\\begin{aligned}\nV &= π\\int_{a}^{b}[f(x)]^{2}dx \\\\\n&= π\\int_{0}^{2}(2x - x^{2})^{2}dx \\\\\n&= π\\int_{0}^{2}(4x^{2} - 4x^{3} + x^{4})dx\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068623 1069 "e-591" 13194139533346 17592186045585 true] [17592186068623 1071 "![](images/73/7373418f2a0bac416e37662cea5a79101220820aa6f23c50a80fbf6addc5eefd.png)\n\nConsider the finite region bounded by $y=x^2$ and $y=x^5$, as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis." 13194139533346 17592186045585 true] [17592186068623 1072 #uuid "3a0a00c8-8a86-52de-bc9d-d9219a0735cf" 13194139533346 17592186045585 true] [17592186068623 1074 "Let\n\n$$\nf(x)=x^2\n$$\n\nand $g(x)=x^5$.\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x$:\n\n$$\n\\begin{aligned}\nf(x) &= g(x) \\\\\nx^{2} &= x^{5} \\\\\nx^{5} - x^{2} &= 0 \\\\\nx^{2}(x^{3} - 1) &= 0\n\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=1$.\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/e4/e41991c460504023c4086aa0070904f20d88304aecd42a293c4b0422132b40e0.png)\n\nThe vertical arrow\n\n- *enters* the region through the inner function $y=g(x)=x^5$, and\n- *leaves* through the outer function $y=f(x)=x^2$.\n\nTherefore, the volume is given by\n\n$$\n\\begin{aligned}\nV &= π\\int_{a}^{b}([outer]^{2} - [inner]^{2})dx \\\\\n&= π\\int_{0}^{1}([x^{2}]^{2} - [x^{5}]^{2})dx \\\\\n&= π\\int_{0}^{1}(x^{4} - x^{10})dx \\\\\n&= \\left.π(\\frac{x^{5}}{5} - \\frac{x^{11}}{11})\\right|_{0}^{1} \\\\\n&= π[(\\frac{1}{5} - \\frac{1}{11}) - 0] \\\\\n&= \\frac{6π}{55}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068624 1069 "e-592" 13194139533346 17592186045585 true] [17592186068624 1071 "![](images/cd/cd7319762569fbab0e64f03719b41af9dfb45d07aac073a534ea68f842b1ce99.png)\n\nConsider the region bounded by $x=\\sqrt{4-y^2}$, $x=1$, and the horizontal lines $y=-1$ and $y=1$, as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $y$-axis." 13194139533346 17592186045585 true] [17592186068624 1072 #uuid "a22887cf-cafa-5ba5-9834-e0c435ec86af" 13194139533346 17592186045585 true] [17592186068624 1074 "Let\n\n$$\nf(y)=\\sqrt{4-y^2}\\,\n$$\n\nand $g(y)=1$.\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing away from the axis of rotation.\n\n![](images/7f/7f875c024b25c37c434a82a4320b4927bde85dc8f0ada3b35837330f829b23c7.png)\n\nThe horizontal arrow\n\n- *enters* the region through the inner function $x=g(y)=1$, and\n- *leaves* through the outer function $x=f(y)=\\sqrt{4-y^2}$.\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}\nV &= π\\int_{c}^{d}([outer]^{2} - [inner]^{2})dy \\\\\n&= π\\int_{-1}^{1}([\\sqrt{4 - y^{2}}]^{2} - 1^{2})dy \\\\\n&= π\\int_{-1}^{1}(3 - y^{2})dy \\\\\n&= 2π\\int_{0}^{1}(3 - y^{2})dy \\\\\n&= \\left.2π(3y - \\frac{y^{3}}{3})\\right|_{0}^{1} \\\\\n&= 2π(3 - \\frac{1}{3} - 0) \\\\\n&= \\frac{16π}{3}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068625 1069 "e-5924" 13194139533346 17592186045585 true] [17592186068625 1071 "Graph the function $y = -\\dfrac{2}{x-1}-1$." 13194139533346 17592186045585 true] [17592186068625 1072 #uuid "d86c6bd2-e528-55ed-bbfc-9f5ecbec024e" 13194139533346 17592186045585 true] [17592186068625 1074 "To plot\n\n$$\ny = -\\dfrac{2}{x-1}-1\n$$\n\nwe apply the following steps:\n\n- Take the curve $y=-\\dfrac{1}{x}$.\n\n![](images/9d/9da0db2e6c97e507e82b7ca801e46802fabf91ad31ff53ad3cc9ae580151370a.png)\n\n- Translate it by one unit to the right to get the graph of $y=-\\dfrac{1}{x-1}$.![](images/8c/8ce8c53f202f04b3b34a247b797f65f7616e8772afa1751de126ddd401417bd7.png)\nNotice that the vertical asymptote is now $x=1$.\n- Then, stretch the result by a scale factor of $2$ parallel to the $y$-axis to get the graph of $y=-\\dfrac{2}{x-1}$.\n\n![](images/c9/c9b708a20d9c6c12f0016279e8d7a3ea55597e7645f0a9518f1c32e8a8406e47.png)\n\n- Finally, translate it by $1$ unit down to get the graph of $y=-\\dfrac{2}{x-1}-1$.![](images/e1/e100b552adb71cae1295492a58b0e60525813adb87d9815ba64a151a856f0c46.png)\nNotice that the horizontal asymptote is now $y=-1$." 13194139533346 17592186045585 true] [17592186068626 1069 "e-5926" 13194139533346 17592186045585 true] [17592186068626 1071 "![](images/fb/fb46d056a8d8010eca509543c231c875f4980a21f1af17505fa98c8c64106207.png)\n\nThe diagram above shows the graph of $y = \\dfrac{a}{x-b}+k$. What is the value of $a+b+k$?" 13194139533346 17592186045585 true] [17592186068626 1072 #uuid "ac8b39e3-a9d0-56fd-8c0b-4d748bedf7d4" 13194139533346 17592186045585 true] [17592186068626 1074 "First, notice that the horizontal asymptote of the graph is $y=-1$, while the vertical asymptote is $x=2$. This means that $k=-1$ and $b=2$, and we can re-write our function as\n\n$$\ny = \\dfrac{a}{x-2}+(-1) = \\dfrac{a}{x-2}-1\n$$\n\nAlso, we are given that the point $(3,2)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}\ny &= \\frac{a}{x - 2} - 1 \\\\\n2 &= \\frac{a}{3 - 2} - 1 \\\\\n3 &= \\frac{a}{1} \\\\\na &= 3\n\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+k = 3+2+(-1) = 4\n$$" 13194139533346 17592186045585 true] [17592186068627 1069 "e-599" 13194139533346 17592186045585 true] [17592186068627 1071 "A curve is defined by the parametric equations $x =e^{t}, \\, y= e^{2t}+1$. Given that $\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}= 2e^t$, calculate $\\dfrac{\\textrm d^2 y}{\\textrm d x^2}$." 13194139533346 17592186045585 true] [17592186068627 1072 #uuid "e2790549-46e6-51c2-b118-0c4a056f6d25" 13194139533346 17592186045585 true] [17592186068627 1074 "To compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= (\\frac{d}{dt}(\\frac{dy}{dx}))/((\\frac{dx}{dt}))\n\\end{aligned}\n$$\n\nWe're given that\n\n$$\n\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}= 2e^t\n$$\n\nand we can calculate\n\n$$\n\\dfrac{\\mathrm dx}{\\mathrm dt}\n$$\n\nas follows:\n\n$$\n\\dfrac{\\mathrm dx}{\\mathrm dt} = \\dfrac{\\mathrm d}{\\mathrm dt} (e^t) = e^t\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= (\\frac{d}{dt}(2e^{t}))/(e^{t}) \\\\\n&= \\frac{2e^{t}}{e^{t}} \\\\\n&= 2\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068628 1069 "e-600" 13194139533346 17592186045585 true] [17592186068628 1071 "A curve is defined by the parametric equations\n\n$x = \\sin(2t), \\qquad y= 2\\cos (2t) \\qquad 0 \\leq t \\lt \\pi$.\n\nGiven that $\\dfrac{\\textrm d y}{\\textrm d x} = -2 \\tan(2t)$, calculate $\\dfrac{\\textrm d^2 y}{\\textrm d x^2}$ at the point where $t=\\dfrac\\pi 8$." 13194139533346 17592186045585 true] [17592186068628 1072 #uuid "68d38626-1153-51ec-a3c6-d39c927fdd99" 13194139533346 17592186045585 true] [17592186068628 1074 "To compute\n\n$$\n\\dfrac{\\textrm d^2 y}{\\textrm d x^2}\n$$\n\nwe can use the formula\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= (\\frac{d}{dt}(\\frac{dy}{dx}))/((\\frac{dx}{dt}))\n\\end{aligned}\n$$\n\nWe're given that\n\n$$\n\\dfrac{\\mathrm{d}y}{\\mathrm{d}x}= -2 \\tan(2t)\n$$\n\nand we can calculate\n\n$$\n\\dfrac{\\mathrm dx}{\\mathrm dt}\n$$\n\nas follows:\n\n$$\n\\dfrac{\\mathrm dx}{\\mathrm dt} = \\dfrac{\\mathrm d}{\\mathrm dt} (\\sin 2t) = 2 \\cos(2t)\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= (\\frac{d}{dt}(-2\\tan 2t))/(2\\cos (2t)) \\\\\n&= (-4\\sec^{2} (2t))/(2\\cos (2t)) \\\\\n&=-4\\sec^{2} (2t) \\cdot \\frac{1}{2}\\sec (2t) \\\\\n&=-2\\sec^{3} (2t)\n\\end{aligned}\n$$\n\nFinally, we evaluate at\n\n$$\nt=\\dfrac{\\pi}{8}\n$$\n\nand we get\n\n$$\n\\begin{aligned}\n\\left.\\frac{d^{2}y}{dx^{2}}\\right|_{t = π/8} &= -2\\sec^{3} (2 \\cdot \\frac{π}{8}) \\\\\n&=-2\\sec^{3} (\\frac{π}{4}) \\\\\n&=-2(\\sqrt{2})^{3} \\\\\n&=-4\\sqrt{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068629 1069 "e-6085" 13194139533346 17592186045585 true] [17592186068629 1071 "Find the slope of each of the lines below.\n\n![](images/e9/e901704deb02efe957129512148c97e42b45b4fdd1d0e3af451562cca2ed1181.png)" 13194139533346 17592186045585 true] [17592186068629 1072 #uuid "4b9a93ba-ed6c-525f-8930-cb68efd6709e" 13194139533346 17592186045585 true] [17592186068629 1074 "The slope of the vertical line is undefined. We can see this by choosing two points on the line, such as $(4,0)$ and $(4,1)$, and computing the slope between them:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = \\frac{1 - 0}{4 - 4} = \\frac{1}{0} = undefined\n$$\n\nOn the other hand, the slope of the horizontal line is zero. We can see this by choosing two points on the line, such as $(0,3)$ and $(1,3)$, and computing the slope between them:\n\n$$\nm = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} = \\frac{3 - 3}{1 - 0} = \\frac{0}{1} = 0\n$$" 13194139533346 17592186045585 true] [17592186068630 1069 "e-6136" 13194139533346 17592186045585 true] [17592186068630 1071 "Which of the following values of $x$ satisfy the inequality $2x < 10\\,$?\n\n1. $x=0$\n2. $x=2$\n3. $x=5$" 13194139533346 17592186045585 true] [17592186068630 1072 #uuid "bd57c7f2-87b5-55a0-9237-1ef814f59898" 13194139533346 17592186045585 true] [17592186068630 1074 "We substitute each value into the given inequality and check to see if the resulting statement is true or false.\n\n- We substitute the value ${\\color{blue}x}={\\color{blue}0}$ into the given inequality. We get:\n$\\begin{bmatrix}2x & < 10 \\\\ 2 \\cdot x & < 10 \\\\ 2 \\cdot 0 & < 10 \\\\ 0 & < 10✓\\end{bmatrix}$\nSo, substituting $x=0$ into the inequality leads to a **true** statement. Therefore, $x=0$ **satisfies** this inequality.\n- We substitute the value ${\\color{blue}x}={\\color{blue}2}$ into the given inequality. We get:\n$\\begin{bmatrix}2x & < 10 \\\\ 2 \\cdot x & < 10 \\\\ 2 \\cdot 2 & < 10 \\\\ 4 & < 10✓\\end{bmatrix}$\nSo, substituting $x=2$ into the inequality leads to a **true** statement. Therefore, $x=2$ **satisfies** this inequality.\n- We substitute the value ${\\color{blue}x}={\\color{blue}5}$ into the given inequality. We get:\n$\\begin{bmatrix}2x & < 10 \\\\ 2 \\cdot x & < 10 \\\\ 2 \\cdot 5 & < 10 \\\\ 10 & < 10\\cdot\\end{bmatrix}$\nSo, substituting $x=5$ into the inequality leads to a **false** statement. Therefore, $x=5$ **does not satisfy** this inequality." 13194139533346 17592186045585 true] [17592186068631 1069 "e-6137" 13194139533346 17592186045585 true] [17592186068631 1071 "Which of the following values of $x$ satisfy the inequality $1 \\leq \\dfrac{x}{2}-1 < 3\\,$?\n\n1. $x=0$\n2. $x=4$\n3. $x=10$" 13194139533346 17592186045585 true] [17592186068631 1072 #uuid "74587421-d1ad-550e-a30d-4d4768588d4f" 13194139533346 17592186045585 true] [17592186068631 1074 "We substitute each value into the given inequality and check to see if the resulting statement is true or false.\n\n- We substitute the value ${\\color{blue}x}={\\color{blue}0}$ into the given inequality. We get:\n$\\begin{bmatrix}1 & \\le \\frac{x}{2} - 1 < 3 \\\\ 1 & \\le \\frac{0}{2} - 1 < 3 \\\\ 1 & \\le 0 - 1 < 3 \\\\ 1 & \\le - 1 < 3\\cdot\\end{bmatrix}$\nSo, substituting $x=0$ into the inequality leads to a **false** statement. Therefore, $x=0$ **does not satisfy** this inequality.\n- We substitute the value ${\\color{blue}x}={\\color{blue}4}$ into the given inequality. We get:\n$\\begin{bmatrix}1 & \\le \\frac{x}{2} - 1 < 3 \\\\ 1 & \\le \\frac{4}{2} - 1 < 3 \\\\ 1 & \\le 2 - 1 < 3 \\\\ 1 & \\le 1 < 3✓\\end{bmatrix}$\nSo, substituting $x=4$ into the inequality leads to a **true** statement. Therefore, $x=4$ **satisfies** this inequality.\n- We substitute the value ${\\color{blue}x}={\\color{blue}10}$ into the given inequality. We get:\n$\\begin{bmatrix}1 & \\le \\frac{x}{2} - 1 < 3 \\\\ 1 & \\le \\frac{10}{2} - 1 < 3 \\\\ 1 & \\le 5 - 1 < 3 \\\\ 1 & \\le 4 < 3\\cdot\\end{bmatrix}$\nSo, substituting $x=10$ into the inequality leads to a **false** statement. Therefore, $x=10$ **does not satisfy** this inequality." 13194139533346 17592186045585 true] [17592186068632 1069 "e-6138" 13194139533346 17592186045585 true] [17592186068632 1071 "The value $a = 2$ satisfies which of the following inequalities?\n\n1. $\\dfrac{a}{2} + 2 > 5$\n2. $1 \\leq 2a < 6$\n3. $3a - 1 < 10$" 13194139533346 17592186045585 true] [17592186068632 1072 #uuid "fb564b00-2d04-556a-a662-7b92e21ec3d3" 13194139533346 17592186045585 true] [17592186068632 1074 "We substitute the given value into each of the inequalities and check to see if the resulting statement is true or false.\n\n- We substitute the value ${\\color{blue}a} = {\\color{blue}2}$ into the first inequality. We get:\n$\\begin{bmatrix}\\frac{a}{2} + 2 & > 5 \\\\ \\frac{2}{2} + 2 & > 5 \\\\ 1 + 2 & > 5 \\\\ 3 & > 5\\cdot\\end{bmatrix}$\nSo, substituting $a = 2$ leads to a **false** statement. Therefore, $a = 2$ **does not satisfy** this inequality.\n- We substitute the value ${\\color{blue}a}={\\color{blue}2}$ into the second inequality. We get:\n$\\begin{bmatrix}1 & \\le 2a < 6 \\\\ 1 & \\le 2 \\cdot a < 6 \\\\ 1 & \\le 2 \\cdot 2 < 6 \\\\ 1 & \\le 4 < 6✓\\end{bmatrix}$\nSo, substituting $a = 2$ leads to a **true** statement. Therefore, $a = 2$ **satisfies** this inequality.\n- We substitute the value ${\\color{blue}a} = {\\color{blue}2}$ into the third inequality. We get:\n$\\begin{bmatrix}3a - 1 & < 10 \\\\ 3 \\cdot a - 1 & < 10 \\\\ 3 \\cdot 2 - 1 & < 10 \\\\ 5 & < 10✓\\end{bmatrix}$\nSo, substituting $a = 2$ leads to a **true** statement. Therefore, $a = 2$ **satisfies** this inequality." 13194139533346 17592186045585 true] [17592186068633 1069 "e-6139" 13194139533346 17592186045585 true] [17592186068633 1071 "Which of the following values of $t$ satisfy the inequality $\\dfrac{2t}{3} < 8\\,$?\n\n1. $t=9$\n2. $t=6$\n3. $t=3$" 13194139533346 17592186045585 true] [17592186068633 1072 #uuid "73bc0b43-f3a9-5a4b-a49f-833cdf1f493f" 13194139533346 17592186045585 true] [17592186068633 1074 "We substitute each value into the given inequality and check to see if the resulting statement is true or false.\n\n- We substitute the value ${\\color{blue}t}={\\color{blue}9}$ into the given inequality. We get:\n$\\begin{bmatrix}\\frac{2t}{3} & < 8 \\\\ \\frac{2 \\cdot t}{3} & < 8 \\\\ \\frac{2 \\cdot 9}{3} & < 8 \\\\ \\frac{18}{3} & < 8 \\\\ 6 & < 8✓\\end{bmatrix}$\nSo, substituting $t = 9$ into the inequality leads to a **true** statement. Therefore, $t=9$ **satisfies** this inequality.\n- We substitute the value ${\\color{blue}t}={\\color{blue}6}$ into the given inequality. We get:\n$\\begin{bmatrix}\\frac{2t}{3} & < 8 \\\\ \\frac{2 \\cdot t}{3} & < 8 \\\\ \\frac{2 \\cdot 6}{3} & < 8 \\\\ \\frac{12}{3} & < 8 \\\\ 4 & < 8✓\\end{bmatrix}$\nSo, substituting $t=6$ into the inequality leads to a **true** statement. Therefore, $t=6$ **satisfies** this inequality.\n- We substitute the value ${\\color{blue}t}={\\color{blue}3}$ into the given inequality. We get:\n$\\begin{bmatrix}\\frac{2t}{3} & < 8 \\\\ \\frac{2 \\cdot t}{3} & < 8 \\\\ \\frac{2 \\cdot 3}{3} & < 8 \\\\ \\frac{6}{3} & < 8 \\\\ 2 & < 8✓\\end{bmatrix}$\nSo, substituting $t=3$ into the inequality leads to a **true** statement. Therefore, $t=3$ **satisfies** this inequality." 13194139533346 17592186045585 true] [17592186068634 1069 "e-6149" 13194139533346 17592186045585 true] [17592186068634 1071 "$\\displaystyle \\int \\dfrac{x^2}{\\sqrt{1-x^3}} \\, \\textrm{d}x=$" 13194139533346 17592186045585 true] [17592186068634 1072 #uuid "0461f8ba-c3c5-5e22-a679-32ee4f2a01b8" 13194139533346 17592186045585 true] [17592186068634 1074 "Let\n\n$$\nu = 1 - x^3\n$$\n\nThen\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3x^2 \\quad \\Longrightarrow\\quad -\\dfrac{1}{3} \\textrm d u= x^2 \\, \\textrm d x\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\n\\int\\frac{x^{2}}{\\sqrt{1 - x^{3}}}dx &= \\int\\frac{1}{\\sqrt{1 - x^{3}}} \\cdot x^{2}dx \\\\\n&= \\int\\frac{1}{\\sqrt{u}} \\cdot (-\\frac{1}{3})du \\\\\n&=-\\frac{1}{3}\\int\\frac{1}{\\sqrt{u}}du \\\\\n&=-\\frac{1}{3}(2\\sqrt{u}) + C \\\\\n&=-\\frac{2}{3}\\sqrt{u} + C \\\\\n&=-\\frac{2}{3}\\sqrt{1 - x^{3}} + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068635 1069 "e-6260" 13194139533346 17592186045585 true] [17592186068635 1071 "Solve for $x$ where $\\dfrac{x+2}{x} = \\dfrac{x-4}{x} + 2$." 13194139533346 17592186045585 true] [17592186068635 1072 #uuid "8e0fa2cd-2b29-510a-868f-4779de8536e5" 13194139533346 17592186045585 true] [17592186068635 1074 "First, we note that $x = 0$ is an excluded solution since division by $0$ is undefined.\n\nNow, let's multiply both sides of the equation by the least common denominator. Both denominators in the equation are $x$, so the least common denominator is $x$.\n\nMultiplying both sides of the equation by $x$ and simplifying, we get\n\n$$\n\\begin{aligned}\n\\frac{x + 2}{x} &= \\frac{x - 4}{x} + 2 \\\\\nx \\cdot (\\frac{x + 2}{x}) &= x \\cdot (\\frac{x - 4}{x} + 2) \\\\\nx \\cdot \\frac{x + 2}{x} &= x \\cdot \\frac{x - 4}{x} + x \\cdot 2 \\\\\nx \\cdot \\frac{x + 2}{x} &= x \\cdot \\frac{x - 4}{x} + 2x \\\\\nx + 2 &= x - 4 + 2x\n\\end{aligned}\n$$\n\nWe now have a linear equation in $x$, and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}\nx + 2 &= x - 4 + 2x \\\\\nx + 2 &= 3x - 4 \\\\\n3x - x &= 2 + 4 \\\\\n2x &= 6 \\\\\nx &= 3\n\\end{aligned}\n$$\n\nFinally, recall that we cannot allow $x=0$ as a solution. Since $x=3$ is different from $x=0$, we accept it as a solution.\n\nTherefore, the solution is $x=3$." 13194139533346 17592186045585 true] [17592186068636 1069 "e-6261" 13194139533346 17592186045585 true] [17592186068636 1071 "Solve for $x$ where $\\dfrac{1+x}{x} + \\dfrac{5+x}{6x} = \\dfrac{1-x}{3x}$?" 13194139533346 17592186045585 true] [17592186068636 1072 #uuid "5d20e960-7554-5a05-b1e0-2b98b944e186" 13194139533346 17592186045585 true] [17592186068636 1074 "First, note that $x = 0$ cannot be a solution since division by $0$ is undefined.\n\nNow, let's multiply both sides of the equation by the least common denominator. The equation has the denominators $x, 6x$, and $3x$, so the the least common multiple (or $\\textrm{LCM}$) of the denominators is\n\n$$\n\\textrm{LCM}(x, 6x, 3x) = 6x\n$$\n\nMultiplying both sides of the equation by $6x$ and simplifying, we get\n\n$$\n\\begin{aligned}\n\\frac{1 + x}{x} + \\frac{5 + x}{6x} &= \\frac{1 - x}{3x} \\\\\n6x \\cdot (\\frac{1 + x}{x} + \\frac{5 + x}{6x}) &= 6x \\cdot \\frac{1 - x}{3x} \\\\\n6x \\cdot (\\frac{1 + x}{x}) + 6x \\cdot (\\frac{5 + x}{6x}) &= 6x \\cdot (\\frac{1 - x}{3x}) \\\\\n6x \\cdot (\\frac{1 + x}{x}) + 6x \\cdot (\\frac{5 + x}{6x}) &= 2 \\cdot 3x \\cdot (\\frac{1 - x}{3x}) \\\\\n6x \\cdot (\\frac{1 + x}{x}) + 6x \\cdot (\\frac{5 + x}{6x}) &= 2 \\cdot 3x \\cdot (\\frac{1 - x}{3x}) \\\\\n6(1 + x) + (5 + x) &= 2(1 - x)\n\\end{aligned}\n$$\n\nWe now have a linear equation in $x$, and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}\n6(1 + x) + (5 + x) &= 2(1 - x) \\\\\n6 + 6x + 5 + x &= 2 - 2x \\\\\n7x + 11 &= 2 - 2x \\\\\n7x + 2x &= 2 - 11 \\\\\n9x &= -9 \\\\\nx &= -1\n\\end{aligned}\n$$\n\nFinally, recall that we cannot allow $x=0$ as a solution. Since $x=-1$ is different from $x=0$, we can accept it as the solution.\n\nTherefore, the solution is $x=-1$." 13194139533346 17592186045585 true] [17592186068637 1069 "e-6278" 13194139533346 17592186045585 true] [17592186068637 1071 "What is the union of the intervals shown on the number lines below?\n\n![](images/60/603da954fd0e711ffa4879c51db847095edd9b1f256bbef66ad9de91c8cb31b4.png)" 13194139533346 17592186045585 true] [17592186068637 1072 #uuid "489ef834-7015-5592-a5f5-b0daa3bc9f7b" 13194139533346 17592186045585 true] [17592186068637 1074 "We have the following number lines:\n\n![](images/60/603da954fd0e711ffa4879c51db847095edd9b1f256bbef66ad9de91c8cb31b4.png)\n\nThe union of the two intervals consists of all the points which are contained within at least one of the intervals. So, to graph the union of the two intervals, we take the graphs of the individual intervals and lay them on top of each other.\n\nThe resulting graph is as follows:\n\n![](images/58/5829d80a75446161fba99c08b361083a025a0c341fa41cf0608867d220dfa538.png)\n\nThe graph represents the interval $(-1,\\infty)$." 13194139533346 17592186045585 true] [17592186068638 1069 "e-6803" 13194139533346 17592186045585 true] [17592186068638 1071 "A curve is defined by the parametric equations $x=e^t, y=2e^{2t}$. Calculate $\\dfrac{\\textrm d^2 y}{\\textrm d x^2}$." 13194139533346 17592186045585 true] [17592186068638 1072 #uuid "e621f828-5fc0-55b6-b726-f9da59878574" 13194139533346 17592186045585 true] [17592186068638 1074 "To find the first derivative, we will use the formula\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\dfrac{y'(t)}{x'(t)}\n$$\n\nDifferentiating $x$ and $y$, we get\n\n$$\nx'(t) = e^t, \\qquad y'(t)=4e^{2t}\n$$\n\nTherefore,\n\n$$\n\\frac{\\mathrm{d}y}{\\mathrm{d}x} = \\dfrac{4e^{2t}}{e^t} = 4e^t\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= (\\frac{d}{dt}(\\frac{dy}{dx}))/((\\frac{dx}{dt}))\n\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\n\\frac{d^{2}y}{dx^{2}} &= (\\frac{d}{dt}(4e^{t}))/(e^{t}) \\\\\n&= \\frac{4e^{t}}{e^{t}} \\\\\n&= 4\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068639 1069 "e-6943" 13194139533346 17592186045585 true] [17592186068639 1071 "Consider the finite region bounded by the curve $y=4-x^2$, the $x$-axis, and the vertical lines $x=0$ and $x=1$, as shown below. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis.\n\n![](images/b9/b97a2db9180ebbd268b12ffe8f923e3878f76dcbd2400d30d6f2cf248f4cd826.png)" 13194139533346 17592186045585 true] [17592186068639 1072 #uuid "a50a4a48-b7d5-5938-8f20-db5d7a1f31b1" 13194139533346 17592186045585 true] [17592186068639 1074 "We are told that the limits of integration are from $x=0$ to $x=1$.\n\nTherefore, the volume can be found as follows:\n\n$$\n\\begin{aligned}\nV &= π\\int_{a}^{b}[f(x)]^{2}dx \\\\\n&= π\\int_{0}^{1}(4 - x^{2})^{2}dx \\\\\n&= π\\int_{0}^{1}(16 - 8x^{2} + x^{4})dx \\\\\n&= π(16\\int_{0}^{1}dx - 8\\int_{0}^{1}x^{2}dx + \\int_{0}^{1}x^{4}dx) \\\\\n&= \\left.π(16x\\right|_{0}^{1} - 8 \\cdot \\left.\\frac{x^{3}}{3}\\right|_{0}^{1} + \\left.\\frac{x^{5}}{5}\\right|_{0}^{1}) \\\\\n&= π(16(1 - 0) - 8(\\frac{1}{3} - 0) + (\\frac{1}{5} - 0)) \\\\\n&= π(16 - \\frac{8}{3} + \\frac{1}{5}) \\\\\n&= \\frac{203π}{15}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068640 1069 "e-6944" 13194139533346 17592186045585 true] [17592186068640 1071 "Consider the finite region bounded by the curve $x=2y^3$, the $y$-axis, and the line $y=1$, as shown below. Which integral gives the volume of the solid generated when this region is rotated by $2\\pi$ radians about the $y$-axis?\n\n![](images/58/588ae37c178db8d6049bf058b064692c367219e3260ebe19ed99ae6bfcea7b6a.png)" 13194139533346 17592186045585 true] [17592186068640 1072 #uuid "ec270f3b-a2f5-51d1-aef7-19c37ac8fa5d" 13194139533346 17592186045585 true] [17592186068640 1074 "First, we want to determine the limits of integration. We find the intersections of the curve with the $y$-axis by solving the following equation:\n\n$$\n\\begin{aligned}\n2y^{3} &= 0 \\\\\ny^{3} &= 0\n\\end{aligned}\n$$\n\nHence, the solution is $y=0$. Since we consider the region above bounded by the curve $x=2y^3$, the $y$-axis, and the line $y=1$, we need to integrate from $y=0$ to $y=1$.\n\nFinally, the volume can be found as follows:\n\n$$\n\\begin{aligned}\nV &= π\\int_{c}^{d}[g(y)]^{2}dy \\\\\n&= π\\int_{0}^{1}(2y^{3})^{2}dy \\\\\n&= 4π\\int_{0}^{1}y^{6}dy\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068641 1069 "e-7" 13194139533346 17592186045585 true] [17592186068641 1071 "Which of the following statements are true concerning the function $y=f(x)$ whose graph is shown below?\n\n1. $\\lim_\\limits{x\\rightarrow \\,0^-}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)$\n2. $\\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)$\n3. $\\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^-}f(x)$\n\n![](images/1c/1c94c7d99009c46023556ce0f4f662f5a90ad315048099394016390552ade809.png)" 13194139533346 17592186045585 true] [17592186068641 1072 #uuid "24c5fa9b-f91e-5088-9647-4923784c5917" 13194139533346 17592186045585 true] [17592186068641 1074 "First, let's compute the limits in question.\n\nLooking at the graph, as $x$ approaches $0$ from the left, the function value $f(x)$ approaches $0$. However, as $x$ approaches $0$ from the right, the function value $f(x)$ is undefined. So we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^-}f(x)=0, \\qquad \\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\text{DNE} \\,\n$$\n\nOn the other hand, as $x$ approaches $1$ from the left, the function value $f(x)$ is undefined, and as $x$ approaches $1$ from the right, the function value $f(x)$ approaches $0$. So we have\n\n$$\n\\lim_\\limits{x\\rightarrow \\,1^-}f(x)=\\text{DNE}, \\qquad \\lim_\\limits{x\\rightarrow \\,1^+}f(x)=0 \\,\n$$\n\nNow, let's look at each statement in turn.\n\nI.\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^-}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)\n$$\n\nbecomes $0=0$, which is true.\n\nII.\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^+}f(x)\n$$\n\nbecomes\n\n$$\n\\text{DNE}=0\n$$\n\nwhich is false.\n\nIII.\n\n$$\n\\lim_\\limits{x\\rightarrow \\,0^+}f(x)=\\lim_\\limits{x\\rightarrow \\,1^-}f(x)\n$$\n\nbecomes\n\n$$\n\\text{DNE}=\\text{DNE}\n$$\n\nwhich is false because we can't compare the undefined values.\n\nTherefore, only statement I is true." 13194139533346 17592186045585 true] [17592186068642 1069 "e-7053" 13194139533346 17592186045585 true] [17592186068642 1071 "Calculate $\\displaystyle \\int x^2e^{2x}\\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068642 1072 #uuid "8ec71af3-4534-5ef1-8745-3220102ba838" 13194139533346 17592186045585 true] [17592186068642 1074 "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{bmatrix}u = x^{2} & ⟹\\frac{du}{dx} = 2x \\\\ \\frac{dv}{dx} = e^{2x} & ⟹v = \\int\\frac{dv}{dx}dx = \\inte^{2x}dx = \\frac{e^{2x}}{2}\\end{bmatrix}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\n\\intx^{2}e^{2x}dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= (x^{2})(\\frac{e^{2x}}{2}) - \\int(\\frac{e^{2x}}{2})(2x)dx \\\\\n&= \\frac{x^{2}e^{2x}}{2} - \\intxe^{2x}dx\n\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int xe^{2x}\\,\\textrm{d}x$. We take\n\n$$\n\\begin{bmatrix}u = x & ⟹\\frac{du}{dx} = 1 \\\\ \\frac{dv}{dx} = e^{2x} & ⟹v = \\int\\frac{dv}{dx}dx = \\inte^{2x}dx = \\frac{e^{2x}}{2}\\end{bmatrix}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\n\\intxe^{2x}dx &= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= x(\\frac{e^{2x}}{2}) - \\int(\\frac{e^{2x}}{2})(1)dx \\\\\n&= \\frac{xe^{2x}}{2} - \\frac{1}{2}\\inte^{2x}dx \\\\\n&= \\frac{xe^{2x}}{2} - \\frac{e^{2x}}{4} + D\n\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\n\\intx^{2}e^{2x}dx &= \\frac{x^{2}e^{2x}}{2} - (\\frac{xe^{2x}}{2} - \\frac{e^{2x}}{4} + D) \\\\\n&= \\frac{x^{2}e^{2x}}{2} - \\frac{xe^{2x}}{2} + \\frac{e^{2x}}{4} + C \\\\\n&= \\frac{e^{2x}}{4}(2x^{2} - 2x + 1) + C\n\\end{aligned}\n$$\n\nwhere $C =-D$." 13194139533346 17592186045585 true] [17592186068643 1069 "e-7054" 13194139533346 17592186045585 true] [17592186068643 1071 "Solving the equation $25x^{2}-20x+4= 0$ using the quadratic formula leads to the expression below:\n$00$\nWhat number is missing from the formula, and what is the solution of the equation?" 13194139533346 17592186045585 true] [17592186068643 1072 #uuid "3ecf6cf7-468d-53d9-b52f-6aa69ce45306" 13194139533346 17592186045585 true] [17592186068643 1074 "The coefficients of our quadratic equation are\n\n$$\na=25, \\quad b=-20, \\quad c=4\n$$\n\nSo, we substitute these values into the quadratic formula:\n\n$$\n\\begin{aligned}\nx &= \\frac{-b ± \\sqrt{b^{2} - 4ac}}{2a} \\\\\n&= (- (-20) ± \\sqrt{(-20)^{2} - 4 \\cdot 25 \\cdot (4)})/(2 \\cdot 25) \\\\\n&= \\frac{20 ± \\sqrt{20^{2} - 4 \\cdot 25 \\cdot [math]\\color{blue}\\,4\\,[/math]}}{2 \\cdot 25}\n\\end{aligned}\n$$\n\nSo, the missing number is $4$\n\nNow, to find the solution, we simplify the above:\n\n$$\n\\begin{aligned}\n\\frac{20 ± \\sqrt{20^{2} - 4 \\cdot 25 \\cdot [math]\\color{blue}\\,4\\,[/math]}}{2 \\cdot 25} &= \\frac{20 ± \\sqrt{400 - 400}}{50} \\\\\n&= \\frac{20 ± \\sqrt{0}}{50} \\\\\n&= \\frac{20 ± 0}{50} \\\\\n&= \\frac{20}{50} \\\\\n&= \\frac{2}{5}\n\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\nx= \\dfrac{2}{5}\n$$" 13194139533346 17592186045585 true] [17592186068644 1069 "e-7055" 13194139533346 17592186045585 true] [17592186068644 1071 "Consider the finite region bounded by the curve $x=2-y^2$ and the $y$-axis, as shown below. Calculate the volume of the solid generated when this region is rotated $360^\\circ$ about the $y$-axis.\n\n![](images/b7/b7d8a063bce77c53b67d672d1ee5a6f62873fd0e507f04e836625a38719039f1.png)" 13194139533346 17592186045585 true] [17592186068644 1072 #uuid "a25b6d87-7779-5408-90d6-a558baaae70f" 13194139533346 17592186045585 true] [17592186068644 1074 "First, we want to determine the limits of integration. We find the intersections of the curve with the $y$-axis by solving for $y$ the following equation:\n\n$$\n\\begin{aligned}\n2 - y^{2} &= 0 \\\\\ny^{2} &= 2\n\\end{aligned}\n$$\n\nHence, the solutions are\n\n$$\ny=\\pm \\sqrt 2\n$$\n\nSo, we need to integrate from\n\n$$\ny=-\\sqrt{2}\n$$\n\nto\n\n$$\ny=\\sqrt 2\n$$\n\nFinally, the volume can be found as follows:\n\n$$\n\\begin{aligned}\nV &= π\\int_{c}^{d}[g(y)]^{2}dy \\\\\n&= π\\int_{-\\sqrt{2}}^{\\sqrt{2}}(2 - y^{2})^{2}dy \\\\\n&= π\\int_{-\\sqrt{2}}^{\\sqrt{2}}(4 - 4y^{2} + y^{4})dy \\\\\n&= 2π\\int_{0}^{\\sqrt{2}}(4 - 4y^{2} + y^{4})dy \\\\\n&= 2π[4y - \\frac{4}{3}y^{3} + \\frac{1}{5}y^{5}]_{0}^{\\sqrt{2}} \\\\\n&= 2π([4(\\sqrt{2}) - \\frac{4}{3}(\\sqrt{2})^{3} + \\frac{1}{5}(\\sqrt{2})^{5}] - [0]) \\\\\n&= 2π(4\\sqrt{2} - \\frac{8\\sqrt{2}}{3} + \\frac{4\\sqrt{2}}{5}) \\\\\n&= 2π(\\frac{32\\sqrt{2}}{15}) \\\\\n&= \\frac{64π\\sqrt{2}}{15}\n\\end{aligned}\n$$\n\n**Note:** Since the region is symmetrical about the $x$-axis, in step $3$ above we were able to write\n\n$$\n\\displaystyle \\pi\\int_{-\\sqrt 2}^\\sqrt 2 [g(y)]^2\\,\\textrm d y = 2\\pi\\int_{0}^\\sqrt 2 [g(y)]^2\\,\\textrm d y\n$$\n\nThis step saved us a bit of work because the antiderivative evaluated to zero at the lower limit." 13194139533346 17592186045585 true] [17592186068645 1069 "e-7223" 13194139533346 17592186045585 true] [17592186068645 1071 "Simplify $\\sqrt[3]{(5x - 4)^3}$." 13194139533346 17592186045585 true] [17592186068645 1072 #uuid "ca60143b-d02c-5497-a134-56444304c2fa" 13194139533346 17592186045585 true] [17592186068645 1074 "The expression underneath the radical is already a perfect cube. Therefore,\n\n$$\n\\begin{aligned}\n\\sqrt[3]{(5x - 4)^{3}} &= 5x - 4\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068646 1069 "e-7228" 13194139533346 17592186045585 true] [17592186068646 1071 "The table below gives some values of a continuous function $f(x)$ over the interval $[-4,2]$. If the left Riemann sum approximation of the area under the curve $y=f(x)$ with $3$ equal subintervals has a value of $28$, then what must be the value of $k$?\n\n| $x$ | $-4$ | $-2$ | $0$ | $2$ |\n| --- | ---: | ---: | ---: | ---: |\n| $f(x)$ | $5$ | $3$ | $k$ | $2$ |" 13194139533346 17592186045585 true] [17592186068646 1072 #uuid "797ec111-8928-5875-8f94-9a423ff558f9" 13194139533346 17592186045585 true] [17592186068646 1074 "The area $\\mathcal{A}$ can be approximated using the formula for the left Riemann sum:\n\n$$\n\\mathcal A\\approx(\\overbrace{{\\color{red}{f(-4)}}+{\\color{red}{f(-2)}}+{\\color{red}{f(0)}}}^{\\color{red}{\\large\\text{heights}}})\\cdot \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}{\\large\\text{width}}}\n$$\n\nSo, we set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $-4$ | $-2$ | $0$ |\n| --- | ---: | ---: | ---: |\n| $f(x)$ | $5$ | $3$ | $k$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\nA \\mid \\approx (5 + 3 + k) \\cdot 2; = (8 + k) \\cdot 2; = 16 + 2k\n$$\n\nSince we are given that $\\mathcal A$ must be $28$, we obtain\n\n$$\n\\begin{aligned}\n16 + 2k &= 28 \\\\\n2k &= 12 \\\\\nk &= 6\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068647 1069 "e-7230" 13194139533346 17592186045585 true] [17592186068647 1071 "Suppose a left Riemann sum is used to approximate the area under the curve $y=f(x)=(2x-4)^2$ over the interval $[0,2]$. Is the resulting estimation an overestimate or an underestimate?" 13194139533346 17592186045585 true] [17592186068647 1072 #uuid "60eae905-fa87-5eac-bff2-8326ae41ca1c" 13194139533346 17592186045585 true] [17592186068647 1074 "Let's sketch our situation. We are using a left Riemann sum, which means we draw the rectangles so that the left corner of each rectangle coincides with the curve.\n\n![](images/02/02b3449f0ccdb2f60eb489aec1b34485ee381b644a52eea7f5394e16851b6cff.png)\n\nBecause the function is *decreasing* over the interval $[0,2]$, the rectangles reach *above* the function, which means our approximation is an *overestimate* of the actual area." 13194139533346 17592186045585 true] [17592186068648 1069 "e-7275" 13194139533346 17592186045585 true] [17592186068648 1071 "Evaluate $\\displaystyle \\int_{0}^{1} \\dfrac{x}{x^2+2x+1} \\,\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068648 1072 #uuid "79049868-d542-5461-ab14-4a4336c9221d" 13194139533346 17592186045585 true] [17592186068648 1074 "Let's first factor the denominator of the integrand:\n\n$$\n\\dfrac{x}{x^2+2x+1} = \\dfrac{x}{(x+1)^2}\n$$\n\nWe must convert the integrand into a sum of partial fractions:\n\n$$\n\\dfrac{x}{(x+1)^2} = \\dfrac {A}{x+1} + \\dfrac {B}{(x+1)^2}\n$$\n\nTo determine the coefficients $A$ and $B$, we first multiply both sides of the above equation by $(x+1)^2$ and get\n\n$$\nx= A(x+1)+B\n$$\n\nPlugging in $x=-1$, we can eliminate $A$ and solve for $B$:\n\n$$\n\\begin{aligned}\n-1 &= A(-1 + 1) + B \\\\\nB &= -1\n\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B$, we can solve for $A$:\n\n$$\n\\begin{aligned}\n0 &= A(0 + 1) + B \\\\\n0 &= A + B \\\\\n0 &= A - 1 \\\\\nA &= 1\n\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum\n\n$$\n\\dfrac{x}{(x+1)^2} = \\dfrac {1}{x+1} - \\dfrac {1}{(x+1)^2}\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}\n\\int_{0}^{1}\\frac{x}{x^{2} + 2x + 1}dx &= \\int_{0}^{1}(\\frac{1}{x + 1} - (1)/((x + 1)^{2}))dx \\\\\n&= \\int_{0}^{1}\\frac{1}{x + 1}dx - \\int_{0}^{1}(1)/((x + 1)^{2})dx \\\\\n&= \\ln \\mid x + \\left.1 \\mid \\right|_{0}^{1} + \\left.\\frac{1}{x + 1}\\right|_{0}^{1} \\\\\n&= (\\ln\\begin{vmatrix}1 + 1 & -\\ln & 0 + 1\\end{vmatrix}) + (\\frac{1}{1 + 1} - \\frac{1}{0 + 1}) \\\\\n&= (\\ln 2 - \\ln 1) + (\\frac{1}{2} - 1) \\\\\n&= \\ln 2 - \\frac{1}{2}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068649 1069 "e-7298" 13194139533346 17592186045585 true] [17592186068649 1071 "Evaluate $\\displaystyle \\int \\dfrac{3x^2-5x+8}{(x-3)^2(x+1)}\\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068649 1072 #uuid "d9f5cd99-436c-5089-a699-b9f9ff245157" 13194139533346 17592186045585 true] [17592186068649 1074 "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\begin{aligned}\n(3x^{2} - 5x + 8)/((x - 3)^{2}(x + 1)) &= (A)/((x - 3)) + (B)/((x - 3)^{2}) + (C)/((x + 1))\n\\end{aligned}\n$$\n\nTo determine the coefficients $A$, $B$, and $C$, we first multiply both sides of the above equation by $(x-3)^2(x+1)$ and get\n\n$$\n\\begin{aligned}\n3x^{2} - 5x + 8 &= A(x - 3)(x + 1) + B(x + 1) + C(x - 3)^{2}\n\\end{aligned}\n$$\n\nPlugging in $x=3$, we can eliminate $A$ and $C$ and solve for $B$:\n\n$$\n\\begin{aligned}\n3(3^{2}) - 5(3) + 8 &= A(3 - 3)(3 + 1) + B(3 + 1) + C(3 - 3)^{2} \\\\\n20 &= B(4) \\\\\nB &= 5\n\\end{aligned}\n$$\n\nPlugging in $x=-1$, we can eliminate $A$ and $B$ and solve for $C$:\n\n$$\n\\begin{aligned}\n3(-1)^{2} - 5(-1) + 8 &= A(-1 - 3)(-1 + 1) + B(-1 + 1) + C(-1 - 3)^{2} \\\\\n16 &= C(-4)^{2} \\\\\nC &= 1\n\\end{aligned}\n$$\n\nPlugging in $x=0$ and substituting the known values of $B$ and $C$, we can solve for $A$:\n\n$$\n\\begin{aligned}\n3(0^{2}) - 5(0) + 8 &= A(0 - 3)(0 + 1) + B(0 + 1) + C(0 - 3)^{2} \\\\\n8 &= -3A + B + 9C \\\\\n8 &= -3A + 5 + 9(1) \\\\\n3A &= 6 \\\\\nA &= 2\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{3x^2-5x+8}{(x-3)^2(x+1)} = \\dfrac{2}{(x-3)} +\\dfrac{5}{(x-3)^2} +\\dfrac{1}{(x+1)}\n$$\n\nFinally, we integrate this expression term by term, and get\n\n$$\n\\begin{aligned}\n\\int(3x^{2} - 5x + 8)/((x - 3)^{2}(x + 1))dx &= \\int((2)/((x - 3)) + (5)/((x - 3)^{2}) + (1)/((x + 1)))dx \\\\\n&= 2\\int\\frac{1}{x - 3}dx + 5\\int(1)/((x - 3)^{2})dx + \\int\\frac{1}{x + 1}dx \\\\\n&= 2\\ln\\begin{vmatrix}x - 3 & + 5(-\\frac{1}{x - 3}) + \\ln & x + 1 & + K \\\\ = 2\\ln & x - 3 & - (5)/((x - 3)) + \\ln & x + 1\\end{vmatrix}+ K\n\\end{aligned}\n$$\n\nwhere $K$ is an integral constant." 13194139533346 17592186045585 true] [17592186068650 1069 "e-7313" 13194139533346 17592186045585 true] [17592186068650 1071 "Evaluate $\\displaystyle \\int_0^{\\pi/2} e^x\\sin(2x) \\, \\textrm{d}x$." 13194139533346 17592186045585 true] [17592186068650 1072 #uuid "f415cae9-6b18-53c1-8c47-6e0a1f0de59c" 13194139533346 17592186045585 true] [17592186068650 1074 "Let's denote the indefinite integral by\n\n$$\nI = \\displaystyle \\int e^{x}\\sin(2x)\\, \\textrm{d}x\n$$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\sin (2x) & ⇒v = \\int\\sin (2x)dx = - (\\cos (2x))/(2)\\end{bmatrix}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}\nI &= \\inte^{x}\\sin (2x)dx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}(- (\\cos (2x))/(2)) - \\int(- (\\cos (2x))/(2))(e^{x})dx \\\\\n&= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}\\inte^{x}\\cos (2x)dx \\\\\n&= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}J\n\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ = \\int e^{x}\\cos(2x)\\,\\textrm{d}x\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{bmatrix}u = e^{x} & ⇒\\frac{du}{dx} = e^{x}, \\\\ \\frac{dv}{dx} = \\cos (2x) & ⇒v = \\int\\cos (2x)dx = (\\sin (2x))/(2)\\end{bmatrix}\n$$\n\nUsing the integration by parts formula once more, we get\n\n$$\n\\begin{aligned}\nJ &= \\inte^{x}\\cos (2x)dx \\\\\n&= \\intu\\frac{dv}{dx}dx \\\\\n&= uv - \\intv\\frac{du}{dx}dx \\\\\n&= e^{x}((\\sin (2x))/(2)) - \\int((\\sin (2x))/(2))(e^{x})dx \\\\\n&= (e^{x}\\sin (2x))/(2) - \\frac{1}{2}\\inte^{x}\\sin (2x)dx \\\\\n&= (e^{x}\\sin (2x))/(2) - \\frac{1}{2}I\n\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I$, we can subsequently solve for $I$:\n\n$$\n\\begin{aligned}\nI &= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}J \\\\\nI &= - (e^{x}\\cos (2x))/(2) + \\frac{1}{2}((e^{x}\\sin (2x))/(2) - \\frac{1}{2}I) \\\\\nI &= - (e^{x}\\cos (2x))/(2) + (e^{x}\\sin (2x))/(4) - \\frac{1}{4}I \\\\\n\\frac{5}{4}I &= (e^{x}\\sin (2x) - 2e^{x}\\cos (2x))/(4) \\\\\nI &= (e^{x}(\\sin (2x) - 2\\cos (2x)))/(5)\n\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}\n\\int_{0}^{π/2}e^{x}\\sin (2x)dx &= \\left.((e^{x}(\\sin (2x) - 2\\cos (2x)))/(5))\\right|_{0}^{π/2} \\\\\n&= (e^{π/2}(\\sin (2 \\cdot \\frac{π}{2}) - 2\\cos (2 \\cdot \\frac{π}{2})))/(5) - (e^{0}(\\sin (2 \\cdot 0) - 2\\cos (2 \\cdot 0)))/(5) \\\\\n&= \\frac{2e^{π/2}}{5} + \\frac{2}{5} \\\\\n&= \\frac{2}{5}(e^{π/2} + 1)\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068651 1069 "e-7314" 13194139533346 17592186045585 true] [17592186068651 1071 "![](images/f6/f6ee4ef4870da694c0ef56cf7395012c9ea1edbe4bc31247d9cdc7b26186b7db.png)\n\nConsider the region bounded by $y=\\sqrt{x}$ and $y=x^3$, as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi$ radians about the $x$-axis." 13194139533346 17592186045585 true] [17592186068651 1072 #uuid "c8be6b12-aad0-5662-a1ae-fa509f578718" 13194139533346 17592186045585 true] [17592186068651 1074 "Let\n\n$$\nf(x)=\\sqrt{x}\n$$\n\nand $g(x)=x^3$.\n\nFirst, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $x$:\n\n$$\n\\begin{aligned}\nf(x) &= g(x) \\\\\n\\sqrt{x} &= x^{3} \\\\\nx &= x^{6} \\\\\nx^{6} - x &= 0 \\\\\nx(x^{5} - 1) &= 0\n\\end{aligned}\n$$\n\nHence, the limits of integration are from $x=0$ to $x=1$.\n\nLet's draw our vertical arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/2a/2abe3a274ab5afee2bc0a85c48c2f1218620b86354c3c4e6e4dd8758ca1af5e5.png)\n\nThe vertical arrow\n\n- *enters* the region through the inner function $y=g(x)=x^3$, and\n- *leaves* through the outer function $y=f(x)=\\sqrt{x}$.\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}\nV &= π\\int_{a}^{b}([outer]^{2} - [inner]^{2})dx \\\\\n&= π\\int_{0}^{1}([\\sqrt{x}]^{2} - [x^{3}]^{2})dx \\\\\n&= π\\int_{0}^{1}(x - x^{6})dx\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068652 1069 "e-7315" 13194139533346 17592186045585 true] [17592186068652 1071 "![](images/97/97ead66fca615e8f9325d445ca14a8478a276e6dc8d2878a2fd5dbea5d880f7a.png)\n\nConsider the finite region bounded by $y=x^3$ and $x=y$, where $y \\leq 0$, as shown above. Find an integral expression for the volume generated when this region is rotated $2\\pi$ radians about the $y$-axis." 13194139533346 17592186045585 true] [17592186068652 1072 #uuid "de8fda0f-8a0f-5f6e-94ab-3852771288db" 13194139533346 17592186045585 true] [17592186068652 1074 "Writing our first function in terms of $y$, we get\n\n$$\ny = x^{3}⟹x = \\sqrt[3]{y}\n$$\n\nLet\n\n$$\nf(y)=\\sqrt[3]{y}\n$$\n\nand $g(y)=y$.\n\nNow, we determine the limits of integration. To do that, we find the intersections of the curves by solving the following equation for $y$:\n\n$$\n\\begin{aligned}\nf(y) &= g(y) \\\\\n\\sqrt[3]{y} &= y \\\\\ny &= y^{3} \\\\\ny^{3} - y &= 0 \\\\\ny(y^{2} - 1) &= 0\n\\end{aligned}\n$$\n\nHence $y=0$ and $y=\\pm 1$. But, since\n\n$$\ny \\leq 0\n$$\n\nthe limits of integration are from $y=0$ to $y=-1$.\n\nLet's draw our horizontal arrow through the region to determine the inner function and the outer function. The arrow should be pointing *away* from the axis of rotation.\n\n![](images/1a/1ab4ce88964c1a4ce12fdfb93b77810b675bc18e656060629c3544eea47129b2.png)\n\nThe horizontal arrow\n\n- *enters* the region through the inner function $x=g(y)=y$, and\n- *leaves* through the outer function $x=f(y)=\\sqrt[3]{y}$.\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}\nV &= π\\int_{a}^{b}([outer]^{2} - [inner]^{2})dy \\\\\n&= π\\int_{-1}^{0}([\\sqrt[3]{y}]^{2} - [y]^{2})dy \\\\\n&= π\\int_{-1}^{0}(\\sqrt[3]{y^{2}} - y^{2})dy\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068653 1069 "e-7316" 13194139533346 17592186045585 true] [17592186068653 1071 "Given that\n$\\dfrac{4x^2-6}{(x-3)(x^2+1)} = \\dfrac{A}{x-3} + \\dfrac{x+3}{x^2 + 1}$,\nwhere $A$ is a constant to be found, calculate $\\displaystyle{\\displaystyle \\int \\dfrac{4x^2-6}{(x-3)(x^2+1)}\\,\\textrm d x}$." 13194139533346 17592186045585 true] [17592186068653 1072 #uuid "8168f846-013a-529a-a916-501438b2ca30" 13194139533346 17592186045585 true] [17592186068653 1074 "First, we find the constant $A$. Multiplying both sides of the given equality by $(x-3)(x^2 + 1)$ gives\n\n$$\n4x^{2} - 6 = A(x^{2} + 1) + x^{2} - 9\n$$\n\nSubstituting $x=0$ into the above gives\n\n$$\n\\begin{aligned}\n4(0)^{2} - 6 &= A(0^{2} + 1) + 0^{2} - 9 \\\\\n- 6 &= A - 9 \\\\\nA &= 3\n\\end{aligned}\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned} \\int \\dfrac{4x^2 - 6}{(x-3)(x^2+1)} \\, \\textrm{d}x & = \\int \\left(\\dfrac{3}{x-3} + \\dfrac{x+3}{x^2 + 1}\\right) \\textrm{d}x \\\\[5pt] & = 3\\int\\dfrac{1}{x-3}\\,\\textrm{d}x + \\int \\dfrac{x}{x^2+1}\\,\\textrm d x + 3\\int \\dfrac{1}{x^2 + 1} \\, \\textrm{d}x \\end{aligned}\n$$\n\nFor the first integral, we get\n\n$$\n\\int \\dfrac{1}{x-3} \\textrm{d}x = \\ln \\mid x-3 \\mid\n$$\n\nFor the second integral, we use the substitution\n\n$$\nx^2 + 1 = u\n$$\n\nThen,\n\n$$\n2x\\,\\textrm{d}x=\\textrm{d}u\n$$\n\nand we get\n\n$$\n\\begin{aligned} \\int \\dfrac{x}{x^2+1}\\,\\textrm{d}x & = \\int \\left(\\dfrac{1}{u}\\right) \\dfrac{\\textrm d u}{2} \\\\[5pt] &= \\dfrac{1}{2}\\ln \\vert u\\vert \\\\[5pt] &= \\dfrac{1}{2}\\ln \\vert x^2 + 1\\vert \\\\[5pt] & = \\dfrac{1}{2}\\ln \\left(x^2+1\\right). \\end{aligned}\n$$\n\nFinally, for the third integral, we use the fact that\n\n$$\n\\displaystyle \\int \\dfrac{1}{x^2 + a^2} \\, \\textrm{d}x = \\dfrac{1}{a}\\arctan\\left(\\dfrac{x}{a}\\right)\n$$\n\nwhich results in\n\n$$\n\\int \\dfrac{1}{x^2+1}\\,\\textrm{d}x = \\arctan{x}\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\n\\int(4x^{2} - 6)/((x - 3)(x^{2} + 1))dx &= 3\\int\\frac{1}{x - 3}dx + \\int\\frac{x}{x^{2} + 1}dx + 3\\int\\frac{1}{x^{2} + 1}dx \\\\\n&= 3\\ln \\mid x - 3 \\mid + \\frac{1}{2}\\ln (x^{2} + 1) + 3\\arctan x + C\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068654 1069 "e-7630" 13194139533346 17592186045585 true] [17592186068654 1071 "Simplify $\\sqrt{4x^4y +12x^4}$." 13194139533346 17592186045585 true] [17592186068654 1072 #uuid "111c0d60-a9de-52bc-94a9-7a443b76d847" 13194139533346 17592186045585 true] [17592186068654 1074 "To simplify the radical expression, we factor the expression inside the radical and then simplify using the identity\n\n$$\n\\sqrt{a^2} = \\mid a \\mid\n$$\n\nas follows:\n\n$$\n\\begin{aligned} \\sqrt{4x^4y +12x^4} &= \\sqrt{4x^4(y+3)} \\\\[3pt] &= \\sqrt{4x^4} \\cdot \\sqrt{y+3} \\\\[3pt] &= \\sqrt{\\left(2x^2\\right)^2} \\cdot \\sqrt{y+3} \\\\[3pt] &= \\mid 2x^2 \\mid \\sqrt{y+3} \\end{aligned}\n$$\n\nNow, since\n\n$$\nx^2 \\geq0\n$$\n\nwe have that\n\n$$\n2x^2 \\geq 0 \\quad \\Longrightarrow\\quad \\mid 2x^2 \\mid = 2x^2\n$$\n\nTherefore, our expression simplifies to $2x^2\\sqrt{y + 3}$." 13194139533346 17592186045585 true] [17592186068655 1069 "e-772" 13194139533346 17592186045585 true] [17592186068655 1071 "The function $y=f(x)$ (shown below) is defined on $x\\in [-2,2]$. Find the left-sided and right-sided limits for the function at $x=-2$ and $x=2$.\n\n![](images/96/963e4b2e7875c5f8156e3d11eee1851ec6b73fd296ccd4a269bbda139f4b895e.png)" 13194139533346 17592186045585 true] [17592186068655 1072 #uuid "b788cb59-f017-5ebe-9f67-f746517de260" 13194139533346 17592186045585 true] [17592186068655 1074 "We see from the graph that, approaching $x=-2$ from the right, the function approaches the value $y=4$. However, we cannot approach $x=-2$ from the left, because the function is not defined left of $x=-2$. Consequently,\n\n$$\n\\lim_\\limits{x\\rightarrow \\,-2^{-}}f(x)=\\text{DNE}\\,,\\quad\\lim_\\limits{x\\rightarrow \\,-2^{+}}f(x)=4 \\,\n$$\n\nOn the other hand, approaching $x=2$ from the left, the function approaches the value $y=2$. However, we cannot approach $x=2$ from the right, because the function is not defined right of $x=2$. So we have\n\n$$\n\\lim_\\limits{x\\rightarrow 2^{-}}f(x)=2\\,,\\quad\\lim_\\limits{x\\rightarrow \\,2^{+}}f(x)=\\text{DNE} \\,\n$$\n\n**Note:** Here, $\\text{DNE}$ is simply short for \"does not exist\"." 13194139533346 17592186045585 true] [17592186068656 1069 "e-7942" 13194139533346 17592186045585 true] [17592186068656 1071 "![](images/06/06a54157969bfc559c8622512bca59b796f8100f8b52542165acb1eb2f397585.png)\n\nWhich of the above could be the graph of $y=\\sqrt[3]{x}$?" 13194139533346 17592186045585 true] [17592186068656 1072 #uuid "efb469e0-ae96-553d-8e7a-56a25739e4af" 13194139533346 17592186045585 true] [17592186068656 1074 "Let's recall some of the basic properties of\n\n$$\ny=\\sqrt[3]{x}{:}\n$$\n\n- The point $(0,0)$ lies on the graph.\n- Its domain is $x\\in (-\\infty,\\infty)$.\n- Its range is $y\\in (-\\infty,\\infty)$.\n- The graph lies in the first and third quadrants.\n- The function is increasing throughout its entire domain.\n- As $x \\rightarrow \\infty$, we have $y\\rightarrow \\infty$, though the function increases more slowly as $x$ gets large.\n- As $x \\rightarrow -\\infty$, we have $y\\rightarrow -\\infty$, though the function decreases more slowly as $x$ becomes very negative.\n\nOf the given options, only graph I has all of the above properties. Therefore, the correct answer is \"I only.\"" 13194139533346 17592186045585 true] [17592186068657 1069 "e-7943" 13194139533346 17592186045585 true] [17592186068657 1071 "Which of the following statements are true regarding the function $f(x) =\\sqrt[3]{x}$?\n\n1. The point $(64,4)$ lies on the graph of $y=f(x)$\n2. The domain of $f(x)$ is $x\\in[-1,\\infty)$\n3. $f(x) \\rightarrow -\\infty$ as $x \\rightarrow -\\infty$" 13194139533346 17592186045585 true] [17592186068657 1072 #uuid "289fd11d-ce6d-5554-a061-9647c67e5326" 13194139533346 17592186045585 true] [17592186068657 1074 "Let's start by recalling the graph of\n\n$$\ny=\\sqrt[3]{x}\n$$\n\n![](images/ab/abafb7d55b4baa0b06f20c3de2b44d5925f7286f078aaa76d71aded7c9c9a001.png)\n\nNow, let's examine each statement in turn.\n\n- Statement I is true. Indeed, $f(64)=\\sqrt[3]{64}=4$.\n- Statement II is false since $f(x) =\\sqrt[3]{x}$ is defined for $x \\in (-\\infty, \\infty)$.\n- Statement III is true. Indeed, $f(x) \\rightarrow -\\infty$ as $x \\rightarrow -\\infty$.\n\nTherefore, the correct answer is \"I and III only.\"" 13194139533346 17592186045585 true] [17592186068658 1069 "e-8017" 13194139533346 17592186045585 true] [17592186068658 1071 "![](images/6e/6eb59afb0e06a3fa59f8ea21a161ab84a91b5c10ca738f182be2ea765be7c130.png)\n\nFind the $x$-coordinates of the points $A$ and $B$ above." 13194139533346 17592186045585 true] [17592186068658 1072 #uuid "b3f76df2-6be7-5f73-ace3-84c5caa51c7f" 13194139533346 17592186045585 true] [17592186068658 1074 "To find the $x$-coordinates of the intersections of\n\n$$\ny= \\mid 2x+3 \\mid\n$$\n\nand\n\n$$\ny=x+3\n$$\n\nwe need to solve the following equation for $x{:}$\n\n$$\n\\mid 2x+3 \\mid = x+3\n$$\n\nThe absolute value graph\n\n$$\ny= \\mid 2x+3 \\mid\n$$\n\nhas two branches:\n\n- where $\\mid 2x+3 \\mid = -(2x+3)$, which has a negative slope, and\n- where $\\mid 2x+3 \\mid = 2x+3$, which has a positive slope.\n\nNow, let's consider each branch in turn:\n\n- The point $A$ lies on the branch with a negative slope. So, if $\\mid 2x+3 \\mid = -(2x+3)$, we obtain:\n$- (2x + 3)|= x + 3; - 2x - 3|= x + 3; - 3|= 3x + 3; - 6|= 3x; - 2|= x; x|=-2$\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$\\mid 2x + 3 \\mid |= x + 3; \\mid 2(-2) + 3 \\mid |= (-2) + 3; \\mid - 4 + 3 \\mid |= 1; \\mid - 1 \\mid |= 1; 1|= 1✓$\nSince $x=-2$ satisfies the original equation, the $x$-coordinate of $A$ is $x=-2$.\n\n- The point $B$ lies on the branch with a positive slope. So, if $\\mid 2x+3 \\mid = 2x+3$, we obtain:\n$2x + 3|= x + 3; x + 3|= 3; x|= 0$\nThis *potential* solution is valid only if it solves the original equation. So, let's plug it back in:\n$\\mid 2x + 3 \\mid |= x + 3; \\mid 2(0) + 3 \\mid |= (0) + 3; \\mid 0 + 3 \\mid |= 3; \\mid 3 \\mid |= 3; 3|= 3✓$\nSince $x=0$ satisfies the original equation, the $x$-coordinate of $B$ is $x=0$.\n\nTherefore, the $x$-coordinates of $A$ and $B$, respectively, are $-2$ and $0$." 13194139533346 17592186045585 true] [17592186068659 1069 "e-843" 13194139533346 17592186045585 true] [17592186068659 1071 "Simplify the expression $\\dfrac {6y + 2} {3xy + x}$." 13194139533346 17592186045585 true] [17592186068659 1072 #uuid "3df1f00a-3a87-5db7-83c5-d47dce633bf9" 13194139533346 17592186045585 true] [17592186068659 1074 "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\require{cancel} \\begin{aligned} \\dfrac {6y + 2} {3xy + x} &= \\dfrac {6y + 2} {x(3y + 1)} \\\\[5pt] &=\\dfrac {2(3y + 1)} {x(3y + 1)} \\\\[5pt] &=\\dfrac {2\\cancel{(3y + 1)}} {x \\cancel{(3y + 1)}} \\\\[5pt] &=\\dfrac {2} {x} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068660 1069 "e-844" 13194139533346 17592186045585 true] [17592186068660 1071 "Simplify $\\dfrac{5c + 10p - 20}{5p+15}$." 13194139533346 17592186045585 true] [17592186068660 1072 #uuid "2504deea-3845-539a-b6d7-5c5ba7f7d042" 13194139533346 17592186045585 true] [17592186068660 1074 "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\n\\frac{5c + 10p - 20}{5p + 15} &= (5(c + 2p - 4))/(5(p + 3)) \\\\\n&= (5(c + 2p - 4))/(5(p + 3)) \\\\\n&= \\frac{c + 2p - 4}{p + 3}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068661 1069 "e-8658" 13194139533346 17592186045585 true] [17592186068661 1071 "Sketch the graph of $y = \\dfrac{7}{2x}$." 13194139533346 17592186045585 true] [17592186068661 1072 #uuid "a76e0252-0574-520e-bb5f-43c8faf6a564" 13194139533346 17592186045585 true] [17592186068661 1074 "To plot\n\n$$\ny = \\dfrac{7}{2x}\n$$\n\nwe apply the following steps:\n\n- Take the curve $y=\\dfrac{1}{x}$.\n\n![](images/e8/e80865b0f32a5473da27b39537034bcdabee0a6c24032f41413e20518642d3f4.png)\n\n- Stretch the result by a scale factor of $\\dfrac{7}{2}$ parallel to the $y$-axis to get the graph of $y=\\dfrac{7}{2x}$.\n\n![](images/b7/b7b1fe93de798c0aa91f60f66a2507869dbe837b843b7233972e1a78ee22576a.png)" 13194139533346 17592186045585 true] [17592186068662 1069 "e-8761" 13194139533346 17592186045585 true] [17592186068662 1071 "Sketch the graph of $y = -\\dfrac{1}{5x}$." 13194139533346 17592186045585 true] [17592186068662 1072 #uuid "a18ff1e7-7f87-5cdd-9a25-91a2e9c1dd5b" 13194139533346 17592186045585 true] [17592186068662 1074 "To plot\n\n$$\ny = -\\dfrac{1}{5x}\n$$\n\nwe apply the following steps:\n\n- Take the curve $y=-\\dfrac{1}{x}$.\n\n![](images/d5/d5d93e12275c683e0a56f0ec9a0c99540a7774879cd0f8fa69151ddba68a44fa.png)\n\n- Stretch the result by a scale factor of $\\dfrac 1 5$ parallel to the $y$-axis to get the graph of $y=-\\dfrac{1}{5x}$.\n\n![](images/30/30ace3126ec127b9949ebf599d615020b9770458825d22460e9e7e0b3d5efec3.png)" 13194139533346 17592186045585 true] [17592186068663 1069 "e-8853" 13194139533346 17592186045585 true] [17592186068663 1071 "Consider the finite region bounded by the curve $x=2y-2y^2$ and the $y$-axis, as shown below. Calculate the volume of the solid generated when this region is rotated $2\\pi$ radians about the $x$-axis.\n\n![](images/c3/c34f58201d91a5490379127a64782b05bd7e7bdea7723109cee11587d019cb29.png)" 13194139533346 17592186045585 true] [17592186068663 1072 #uuid "29e835eb-531e-5241-911f-45e2d686b183" 13194139533346 17592186045585 true] [17592186068663 1074 "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y$:\n\n$$\n\\begin{aligned}\n2y - 2y^{2} &= 0 \\\\\n2y(1 - y) &= 0\n\\end{aligned}\n$$\n\nThe solutions are $y=0$, and $y=1$. So, we need to integrate from $y=0$ to $y=1$.\n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}\nV &= 2π\\int_{c}^{d}yf(y)dy \\\\\n&= 2π\\int_{0}^{1}y(2y - 2y^{2})dy \\\\\n&= 4π\\int_{0}^{1}(y^{2} - y^{3})dy \\\\\n&= 4π(\\int_{0}^{1}y^{2}dy - \\int_{0}^{1}y^{3}dy) \\\\\n&= \\left.4π(\\frac{y^{3}}{3}\\right|_{0}^{1} - \\left.\\frac{y^{4}}{4}\\right|_{0}^{1}) \\\\\n&= 4π((\\frac{1}{3} - 0) - (\\frac{1}{4} - 0)) \\\\\n&= 4π(\\frac{1}{3} - \\frac{1}{4}) \\\\\n&= \\frac{π}{3}\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068664 1069 "e-8856" 13194139533346 17592186045585 true] [17592186068664 1071 "![](images/cf/cf4e624293586613b00a7209cd40a89b5303f0495c2fba36d751660ae7f8a91b.png)\n\nConsider the finite region bounded by the curve $x=4y-y^2$ and the $y$-axis, as shown above. Using the shell method, find an integral that gives the volume of the solid generated when that region is rotated $2\\pi$ radians about the $x$-axis." 13194139533346 17592186045585 true] [17592186068664 1072 #uuid "77659797-1ecc-567e-b864-cfb39c21b0c0" 13194139533346 17592186045585 true] [17592186068664 1074 "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y$:\n\n$$\n\\begin{aligned}\n4y - y^{2} &= 0 \\\\\ny(4 - y) &= 0\n\\end{aligned}\n$$\n\nThe solutions are $y=0, \\, 4$. So, we need to integrate from $y=0$ to $y=4$.\n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}\nV &= 2π\\int_{c}^{d}yf(y)dy \\\\\n&= 2π\\int_{0}^{4}y(4y - y^{2})dy\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068665 1069 "e-89" 13194139533346 17592186045585 true] [17592186068665 1071 "Evaluate $\\lim\\limits_{x\\to0} x^4\\cos \\left(\\dfrac{1}{x}\\right)$." 13194139533346 17592186045585 true] [17592186068665 1072 #uuid "b8d7a1c6-b564-5eb1-b4ce-f15802db1b8e" 13194139533346 17592186045585 true] [17592186068665 1074 "Recall that $\\cos(\\theta)$ ranges between $-1$ and $1$. So we have\n\n$$\n-1 \\le \\cos \\left(\\dfrac{1}{x}\\right) \\le 1\n$$\n\nand multiplying both sides by $x^4$ gives\n\n$$\n-x^4 \\le x^4\\cos\\left(\\dfrac{1}{x}\\right) \\le x^4\n$$\n\nNow, taking the limits gives\n\n$$\n\\begin{bmatrix}lim_(x → 0)(-x^{4}) \\le & lim_(x → 0)x^{4}\\cos (\\frac{1}{x}) \\le lim_(x → 0)(x^{4}) \\\\ 0 \\le & lim_(x → 0)x^{4}\\cos (\\frac{1}{x}) \\le 0\\end{bmatrix}\n$$\n\nwhich, by the squeeze theorem, implies that\n\n$$\n\\lim\\limits_{x\\to0} x^4\\cos \\left(\\dfrac{1}{x}\\right) = 0\n$$" 13194139533346 17592186045585 true] [17592186068666 1069 "e-8932" 13194139533346 17592186045585 true] [17592186068666 1071 "Find the quotient and remainder of the following division problem:\n$\\dfrac {5x^4- 2x^3 - 18x^2 + 11x - 13} {5x^2-2x+2}$" 13194139533346 17592186045585 true] [17592186068666 1072 #uuid "9438b41b-2ad4-5248-881c-cb938b6cf1c3" 13194139533346 17592186045585 true] [17592186068666 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n5x^{2} - 2x + 2x^{2} - 4; 5x^{2} - 2x + 25x^{4} - 2x^{3} - 18x^{2} + 11x - 13; 5x^{2} - 2x + 25x^{4} - 2x^{3} + 02x^{2}_(―); 5x^{2} - 2x + 25x^{4} - 2x^{3} - 20x^{2} + 11x - 13; 5x^{2} - 2x + 25x^{4} - 2x^{3}- 20x^{2} + 08x - 08_(―); 5x^{2} - 2x + 25x^{4} - 2x^{3} - 20x^{2} +03x - 05\n$$\n\nAs a result,\n\n- the quotient is $x^2-4$, and\n- the remainder is $3x-5$.\n\nTherefore,\n\n$$\n\\dfrac{5x^4-2x^3-18x^2+11x-13}{5x^2-2x+2}=x^2-4 + \\dfrac{3x-5}{5x^2-2x+2}\n$$" 13194139533346 17592186045585 true] [17592186068667 1069 "e-90" 13194139533346 17592186045585 true] [17592186068667 1071 "Find $\\lim\\limits_{x\\to 2} f(x)$ given that\n\n$4x-4 \\le f(x) \\le x^2$." 13194139533346 17592186045585 true] [17592186068667 1072 #uuid "c278d442-98a3-57d4-80c3-a4c1ce834841" 13194139533346 17592186045585 true] [17592186068667 1074 "Taking the limits gives\n\n$$\n\\begin{bmatrix}lim_(x → 2)(4x - 4) \\le & lim_(x → 2)f(x) \\le lim_(x → 2)x^{2} \\\\ 4(2) - 4 \\le & lim_(x → 2)f(x) \\le 2^{2} \\\\ 4 \\le & lim_(x → 2)f(x) \\le 4\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we must have\n\n$$\n\\lim\\limits_{x\\to 2} f(x)=4\n$$" 13194139533346 17592186045585 true] [17592186068668 1069 "e-916" 13194139533346 17592186045585 true] [17592186068668 1071 "Jim has $\\[math]96$ in his pocket, which is two-thirds of the price of a particular book. How much does the book cost?" 13194139533346 17592186045585 true] [17592186068668 1072 #uuid "62bd5b25-6b48-5e76-b338-cd4491d9341b" 13194139533346 17592186045585 true] [17592186068668 1074 "First, let $x=$ the cost of the book, which is the unknown quantity we're trying to find.\n\nWe note that:\n\n- Jim has $\\[math]96$ in his pocket.\n- Two-thirds of the cost of the book corresponds to $\\dfrac{2}{3} x$.\n\nSince two-thirds of the cost of the book is *equal* to the amount of money that Jim has, the equation for $x$ is\n\n$$\n\\dfrac 2 3 x = 96\n$$\n\nWe can solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}\n\\frac{2}{3}x &= 96 \\\\\n\\frac{3}{2} \\cdot \\frac{2}{3}x &= \\frac{3}{2} \\cdot 96 \\\\\nx &= 144\n\\end{aligned}\n$$\n\nTherefore, the book costs $\\[/math]144$." 13194139533346 17592186045585 true] [17592186068669 1069 "e-918" 13194139533346 17592186045585 true] [17592186068669 1071 "Triple a number is $40$ greater than one-third of that number. Find the number." 13194139533346 17592186045585 true] [17592186068669 1072 #uuid "7f14ed31-f9b6-554a-8dff-34fa5d646335" 13194139533346 17592186045585 true] [17592186068669 1074 "Let $x=$ the number we are being asked to find.\n\nWe note that:\n\n- Triple the number corresponds to $3x$.\n- One-third of the number corresponds to $\\dfrac{x}{3}$.\n\nNow, we link both expressions using the fact that the triple the number is $40$ greater than one-third of the number, which corresponds to the equation\n\n$$\n3x= \\dfrac{x}{3} + 40\n$$\n\nWe solve the equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned} 3x &= \\dfrac{x}{3} + 40 \\\\[5pt] 3 \\cdot 3x &= 3 \\cdot \\left(\\dfrac{x}{3} + 40 \\right) \\\\[5pt] 9x &= 3 \\cdot \\dfrac{x}{3} + 3 \\cdot 40 \\\\[5pt] 9x &= x + 120 \\\\[5pt] 9x - x &= x + 120 - x \\\\[5pt] 8x &= 120 \\\\[5pt] \\dfrac{8x}{8} &= \\dfrac{120}{8} \\\\[5pt] x &= 15 \\end{aligned}\n$$\n\nTherefore, the number we are interested in is $15$." 13194139533346 17592186045585 true] [17592186068670 1069 "e-92" 13194139533346 17592186045585 true] [17592186068670 1071 "Evaluate $\\lim\\limits_{x\\to0} x^2e^{\\cos (1/x)}$." 13194139533346 17592186045585 true] [17592186068670 1072 #uuid "5b953dc0-bbe3-5b4d-96aa-a5745ca69d59" 13194139533346 17592186045585 true] [17592186068670 1074 "Recall that $\\cos(\\theta)$ ranges between $-1$ and $1$. So we have\n\n$$\n-1 \\le \\cos \\left(\\dfrac{1}{x}\\right) \\le 1\n$$\n\nNow, since $e^x$ is a positive, increasing function, we can exponentiate both sides to give\n\n$$\ne^{-1} \\le e^{\\cos (1/x)} \\le e^{1}\n$$\n\nMultiplying both sides of the inequality by $x^2$ gives\n\n$$\nx^2e^{-1} \\le x^2e^{\\cos (1/x)} \\le x^2e^{1}\n$$\n\nand taking the limits gives\n\n$$\n\\begin{bmatrix}lim_(x → 0)x^{2}e^{-1} \\le & lim_(x → 0)x^{2}e^{\\cos (1/x)} \\le lim_(x → 0)x^{2}e^{1} \\\\ 0 \\le & lim_(x → 0)x^{2}e^{\\cos (1/x)} \\le 0\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we must have\n\n$$\n\\lim_{x\\to0} x^2e^{\\cos (1/x)} = 0\n$$" 13194139533346 17592186045585 true] [17592186068671 1069 "e-93" 13194139533346 17592186045585 true] [17592186068671 1071 "Evaluate $\\displaystyle\\lim_{x\\to 0}x^3\\sin\\left(\\dfrac 3 x\\right)$." 13194139533346 17592186045585 true] [17592186068671 1072 #uuid "19c3a089-2a9d-5a4c-a5c2-55bf1b78d6e4" 13194139533346 17592186045585 true] [17592186068671 1074 "Recall that $\\sin(\\theta)$ ranges between $-1$ and $1$. So, we have\n\n$$\n\\left|\\sin{\\left(\\dfrac{3}{x}\\right)}\\right|\\leq 1\n$$\n\nMultiplying the above inequality by $\\mid x^3 \\mid$ gives\n\n$$\n\\begin{vmatrix}x^{3} & \\cdot & \\sin (\\frac{3}{x}) & \\le & x^{3}\\end{vmatrix};\\begin{vmatrix}x^{3}\\sin (\\frac{3}{x}) & \\le & x^{3}\\end{vmatrix}\n$$\n\nand using the definition of absolute value, we have\n\n$$\n-\\begin{vmatrix}x^3 & \\leq x^3 \\sin{\\left(\\dfrac{3}{x}\\right)} \\leq & x^3\\end{vmatrix}\n$$\n\nNote that we're using absolute value here because $x^3$ has an odd power.\n\nNow, taking the limit as $x\\to 0$, we have\n\n$$\n\\begin{bmatrix}lim_(x → 0)(-\\mid x^{3} \\mid) \\le & lim_(x → 0)x^{3}\\sin (\\frac{3}{x}) \\le lim_(x → 0)(\\mid x^{3} \\mid) \\\\ 0 \\le & lim_(x → 0)x^{3}\\sin (\\frac{3}{x}) \\le 0\\end{bmatrix}\n$$\n\nTherefore, by the squeeze theorem, we conclude that\n\n$$\n\\lim_{x\\to 0} x^3 \\sin{\\left(\\dfrac{3}{x}\\right)} = 0\n$$" 13194139533346 17592186045585 true] [17592186068672 1069 "e-952" 13194139533346 17592186045585 true] [17592186068672 1071 "Express the compound inequality $x < 4$ or $x \\ge 10$ using interval notation." 13194139533346 17592186045585 true] [17592186068672 1072 #uuid "d0e51ce4-7f83-545e-9c3c-b79bf58d0eab" 13194139533346 17592186045585 true] [17592186068672 1074 "We can represent the compound inequality on a number line, as follows:\n\n![](images/26/26594fb87ed7eca0803d554e4a1fbd3d3719cc01ba4e70f96126b73924ac5769.png)\n\nThis number line consists of the interval $(-\\infty, 4)$ as well as the interval $[10, \\infty)$.\n\nSo, we can express the compound inequality as the union of these two intervals:\n\n$$\n(-\\infty, 4) \\:{\\cup}\\: [10, \\infty)\n$$" 13194139533346 17592186045585 true] [17592186068673 1069 "e-954" 13194139533346 17592186045585 true] [17592186068673 1071 "Express $\\left(-\\infty, -1 \\right) \\cup [2, \\infty)$ as an inequality." 13194139533346 17592186045585 true] [17592186068673 1072 #uuid "c575830c-0100-5cec-a3f8-70e29cba3b54" 13194139533346 17592186045585 true] [17592186068673 1074 "First, we graph the two intervals on a number line:\n\n![](images/eb/ebc7db3faf2d9eafb887e93e9cf3613853914bf02ef87b6f63b638494c55a2ac.png)\n\nThe interval\n\n$$\n\\left(-\\infty, -1 \\right)\n$$\n\ncan be expressed as the inequality $x < -1$.\n\nLikewise, the interval $[2, \\infty)$ can be expressed as the inequality\n\n$$\nx \\geq 2\n$$\n\nSo, the union of these intervals represents the compound inequality\n\n$$\nx < -1 \\text{or} x \\geq 2\n$$" 13194139533346 17592186045585 true] [17592186068674 1069 "e-9612" 13194139533346 17592186045585 true] [17592186068674 1071 "A math test has $10$ questions, and each correct answer is worth $3$ points. To calculate the final grade, the teacher first subtracts the number of incorrect answers from the total points obtained from the correct answers. Then, she divides the previous result by $3$.\nIf Ron gets a final grade of $6$, how many questions did he answer correctly?" 13194139533346 17592186045585 true] [17592186068674 1072 #uuid "f989a0c3-225e-52d6-bb79-1cdfe79746c5" 13194139533346 17592186045585 true] [17592186068674 1074 "Let $x=$ the number of questions Ron answered correctly, which is the unknown quantity we're trying to find.\n\nWe note that:\n\n- The total number of points obtained from the correct answers is $3x$.\n- The number of incorrect answers is $10-x$.\n- The teacher subtracts the number of incorrect answers from the total points obtained from the correct answers, which gives\n$3x-(10-x) = 3x-10+x=4x-10$.\n- Then, the teacher divides the number obtained above by $3$. So, the final grade is\n$\\dfrac{4x-10}{3}$.\n\nRon's final grade is $6$. So, we have the equation\n\n$$\n\\dfrac{4x-10}{3} = 6\n$$\n\nWe can solve this equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}\n\\frac{4x - 10}{3} &= 6 \\\\\n3 \\cdot \\frac{4x - 10}{3} &= 3 \\cdot 6 \\\\\n4x - 10 &= 18 \\\\\n4x - 10 + 10 &= 18 + 10 \\\\\n4x &= 28 \\\\\nx &= 7\n\\end{aligned}\n$$\n\nThus, Ron answered $7$ questions correctly." 13194139533346 17592186045585 true] [17592186068675 1069 "e-988" 13194139533346 17592186045585 true] [17592186068675 1071 "Calculate the slope of the line shown below.\n\n![](images/48/48114216e210a4e4dfc353871bbfd16bd2beb480f5831c62189db9299e09f517.png)" 13194139533346 17592186045585 true] [17592186068675 1072 #uuid "0b380dbf-80da-582c-a2cd-ab675791c8b1" 13194139533346 17592186045585 true] [17592186068675 1074 "Note that the line passes through the points $(-2,0)$ and $(0,2)$. So, we let\n\n$$\n(x_1,y_1) = (-2,0)\n$$\n\nand\n\n$$\n(x_2,y_2) = (0,2)\n$$\n\nand compute the slope using the formula:\n\n$$\n\\begin{aligned}\nm &= \\frac{y_{2} - y_{1}}{x_{2} - x_{1}} \\\\\n&= (2 - 0)/(0 - (-2)) \\\\\n&= \\frac{2}{2} \\\\\n&= 1\n\\end{aligned}\n$$\n\nTherefore, the slope of the line is $m=1$." 13194139533346 17592186045585 true] [17592186068676 1069 "e-989" 13194139533346 17592186045585 true] [17592186068676 1071 "Calculate the slope of the line that passes through the points $(1, 5)$ and $(4, 2)$." 13194139533346 17592186045585 true] [17592186068676 1072 #uuid "d086fc71-f668-5ce7-8fd0-b046a3c228eb" 13194139533346 17592186045585 true] [17592186068676 1074 "We let\n\n$$\n(x_1,y_1) = (1,5)\n$$\n\nand\n\n$$\n(x_2,y_2) = (4,2)\n$$\n\nand compute the slope using the formula:\n\n$$\n\\begin{aligned} m &= \\dfrac {y_2 - y_1} {x_2 - x_1} \\\\ &= \\dfrac {2 - 5} {4 - 1} \\\\ &= \\dfrac {-3}{3} \\\\ &= -1 \\end{aligned}\n$$\n\nThus, the slope is $m=-1$." 13194139533346 17592186045585 true] [17592186068677 1069 "e-990" 13194139533346 17592186045585 true] [17592186068677 1071 "Given the following graph, what can we say about the sign of the slope?\n\n![](images/ff/ffa6dd91f72bc66c943e88aa764a64811391a00af162b40320ce3d90f96b16a4.png)" 13194139533346 17592186045585 true] [17592186068677 1072 #uuid "7a806653-8d1d-543c-91de-94b9e892b88b" 13194139533346 17592186045585 true] [17592186068677 1074 "Remember that slope is the amount the line rises vertically per unit that it runs horizontally.\n\nSince the graph decreases ($\\searrow$) as we go from left to right, the line rises by a negative amount.\n\nTherefore, the slope of the line is negative." 13194139533346 17592186045585 true] [17592186068678 1069 "e-9927" 13194139533346 17592186045585 true] [17592186068678 1071 "Rewrite the expression $(x^2 + 14x + 49) - 8$ as the difference between a perfect square and a constant." 13194139533346 17592186045585 true] [17592186068678 1072 #uuid "2acac780-2b17-5489-accc-2a3a090784e4" 13194139533346 17592186045585 true] [17592186068678 1074 "First, we recall the following formula:\n\n$$\nx^2 + {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x + {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}\nx^{2} + 14x + 49 &=  \\\\\nx^{2} + 14x + 7^{2} &=  \\\\\nx^{2} + 2 \\cdot 7x + 7^{2} &=  \\\\\n&= (x + 7)^{2}\n\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n(x^{2} + 14x + 49) - 8 &=  \\\\\n&= (x + 7)^{2} - 8 \\mid\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068679 1069 "e-9935" 13194139533346 17592186045585 true] [17592186068679 1071 "Given the graph below, solve the inequality $x^2- 3x-10 >0$.\n\n![](images/bb/bb4b28c1fbc4e166f22acf62ae4ab11cdab0ee07c2c4af080db0bf7e290744aa.png)" 13194139533346 17592186045585 true] [17592186068679 1072 #uuid "b75cf4ed-e93b-589c-88ed-1a277273945c" 13194139533346 17592186045585 true] [17592186068679 1074 "Notice that our inequality\n\n$$\nx^2 -3x -10> 0\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny =x^2 -3x -10\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/ca/ca22e171b36e21802769e3612a163d29b01209af1ef75887a65ab6013bb1401a.png)\n\nSo, the solution to the inequality is $x < -2$ or $x > 5$." 13194139533346 17592186045585 true] [17592186068680 1069 "e-9975" 13194139533346 17592186045585 true] [17592186068680 1071 "Given the graph below, solve the inequality $-x^2+2x+3 \\leq 0$.\n\n![](images/93/93fa79fb8411a6bdf16b3eb9c1aab489377a9b0d039b0be4b884f8cdc47bf683.png)" 13194139533346 17592186045585 true] [17592186068680 1072 #uuid "58407228-e1f1-5d75-8786-a604caea671a" 13194139533346 17592186045585 true] [17592186068680 1074 "Notice that our inequality\n\n$$\n-x^2+2x+3 \\leq 0\n$$\n\nis a \"*less than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny =-x^2+2x+3\n$$\n\nis *below* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/6b/6b11e0ab1c3cd92003d3b5330b4eab64e192efbe1953cfbc560b717ccc0e3c57.png)\n\nSo, the solution to the inequality is\n\n$$\nx \\leq -1\n$$\n\nor\n\n$$\nx \\geq 3\n$$" 13194139533346 17592186045585 true] [17592186068681 1069 "e-9976" 13194139533346 17592186045585 true] [17592186068681 1071 "Given the graph below, solve the inequality $-(x+2)(x-1) < 0$.\n\n![](images/c7/c764652658e603142d22e4a9ec02c59c2143bd4d5df2a38d6d6e7dd629ccf88b.png)" 13194139533346 17592186045585 true] [17592186068681 1072 #uuid "f84c11bc-b14f-5285-a782-2130d31f9e49" 13194139533346 17592186045585 true] [17592186068681 1074 "Notice that our inequality\n\n$$\n-(x+2)(x-1) < 0\n$$\n\nis a \"*less than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola\n\n$$\ny = -(x+2)(x-1)\n$$\n\nis *below* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/cb/cb3adba60c427e4f68bf756301a9b101ce17ca32adb8ea6ba9f3b492cccce2cc.png)\n\nSo, the solution to the inequality is $x< -2$ or $x > 1$." 13194139533346 17592186045585 true] [17592186068682 1069 "e-9980" 13194139533346 17592186045585 true] [17592186068682 1071 "Simplify $\\sqrt{50u^7}$." 13194139533346 17592186045585 true] [17592186068682 1072 #uuid "ce2e3248-96e3-5d69-9a16-1a62e0ce0eeb" 13194139533346 17592186045585 true] [17592186068682 1074 "We first write $50u^7$ as the product $25u^6\\cdot 2u$ which contains a perfect square $(25u^6){:}$\n\n$$\n\\begin{aligned} \\sqrt{50u^7} \\\\[3pt] &= \\sqrt{25u^6\\cdot 2u}& \\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned} \\sqrt{25u^6\\cdot 2u} \\\\[3pt] &= \\sqrt{\\left(5u^3\\right)^2\\cdot 2u} \\\\[3pt] &= \\sqrt{\\left(5u^3\\right)^2}\\cdot\\sqrt{2u}& \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned} \\sqrt{\\left(5u^3\\right)^2}\\cdot\\sqrt{2u} \\\\[3pt] &= \\begin{vmatrix}5u^3 & \\cdot\\sqrt{2u} \\\\[3pt] &= & 5 & \\cdot & u^3 & \\cdot\\sqrt{2u} \\\\[3pt] &= \\left.5\\end{vmatrix}u\\right|^3 \\sqrt{2u} \\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068683 1069 "e-9997" 13194139533346 17592186045585 true] [17592186068683 1071 "Rewrite the expression $(x^2 - 12x + 36) -5$ as the difference between a perfect square and a constant." 13194139533346 17592186045585 true] [17592186068683 1072 #uuid "b107ed10-4501-50ad-8ad7-231fd933bfc9" 13194139533346 17592186045585 true] [17592186068683 1074 "First, we recall the following formula:\n\n$$\nx^2 - {\\color{red}{2}}{\\color{blue}{a}}x + a^2 = (x - {\\color{blue}{a}})^2\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}\nx^{2} - 12x + 36 &=  \\\\\nx^{2} - 12x + 6^{2} &=  \\\\\nx^{2} - 2 \\cdot 6x + 6^{2} &=  \\\\\n&= (x - 6)^{2}\n\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n(x^{2} - 12x + 36) - 5 &=  \\\\\n&= (x - 6)^{2} - 5 \\mid\n\\end{aligned}\n$$" 13194139533346 17592186045585 true] [17592186068684 1037 #edb/ref 17592186048193 13194139533346 175921