47 17592186045585 true] [17592186073407 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073407 1084 #uuid "f3173d46-cd3e-58bb-8f99-a1d55f59bb8f" 13194139533347 17592186045585 true] [17592186073408 1081 "1" 13194139533347 17592186045585 true] [17592186073408 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073408 1084 #uuid "f973cf96-67d7-55c5-825f-b2a7ef2f4fd2" 13194139533347 17592186045585 true] [17592186073409 1081 "4" 13194139533347 17592186045585 true] [17592186073409 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073409 1084 #uuid "02a4f6f5-2e51-5fef-ab48-4f1869547b73" 13194139533347 17592186045585 true] [17592186073410 1081 "± 3" 13194139533347 17592186045585 true] [17592186073410 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073410 1084 #uuid "17bdc604-682d-5f66-a786-de386622c8bf" 13194139533347 17592186045585 true] [17592186073411 1081 "± 5" 13194139533347 17592186045585 true] [17592186073411 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073411 1084 #uuid "4cafc32f-cfc4-5870-8bdc-ceabba952f3e" 13194139533347 17592186045585 true] [17592186073412 1075 #edb/ref 17592186073413 13194139533347 17592186045585 true] [17592186073412 1075 #edb/ref 17592186073414 13194139533347 17592186045585 true] [17592186073412 1075 #edb/ref 17592186073415 13194139533347 17592186045585 true] [17592186073412 1075 #edb/ref 17592186073416 13194139533347 17592186045585 true] [17592186073412 1075 #edb/ref 17592186073417 13194139533347 17592186045585 true] [17592186073412 1076 #edb/ref 17592186045493 13194139533347 17592186045585 true] [17592186073412 1077 "selection" 13194139533347 17592186045585 true] [17592186073412 1080 #uuid "c6ac99d4-5e65-5537-9246-89c183e033a1" 13194139533347 17592186045585 true] [17592186073413 1081 "6" 13194139533347 17592186045585 true] [17592186073413 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073413 1084 #uuid "96a314a0-2671-587b-b824-eac95c7f153f" 13194139533347 17592186045585 true] [17592186073414 1081 "6\\frac{5}{6}" 13194139533347 17592186045585 true] [17592186073414 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073414 1084 #uuid "a47b33c3-0676-55d1-8e7e-753f879ec4f1" 13194139533347 17592186045585 true] [17592186073415 1081 "5\\frac{1}{6}" 13194139533347 17592186045585 true] [17592186073415 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073415 1084 #uuid "dc8f91b5-b0d8-5918-b9f6-9efc1de7d34a" 13194139533347 17592186045585 true] [17592186073416 1081 "5\\frac{5}{6}" 13194139533347 17592186045585 true] [17592186073416 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073416 1084 #uuid "0eab50d4-9e1f-5a03-beab-bf75a21d9cda" 13194139533347 17592186045585 true] [17592186073417 1081 "6\\frac{1}{6}" 13194139533347 17592186045585 true] [17592186073417 1083 #edb/ref 17592186045499 13194139533347 17592186045585 true] [17592186073417 1084 #uuid "42ff20ad-3f8c-5472-a795-1b5938059673" 13194139533347 17592186045585 true] [17592186073418 1069 "e-10206" 13194139533347 17592186045585 true] [17592186073418 1071 "$\\dfrac{4}{5} \\,\\square \\,\\dfrac{2}{5}$\n\nWhich symbols could replace the empty box above to make the statement true?\n\n1. $=$\n2. $<$\n3. $>$" 13194139533347 17592186045585 true] [17592186073418 1072 #uuid "e0e9aca6-77ed-5279-a810-fc30d6f2e80b" 13194139533347 17592186045585 true] [17592186073418 1074 "Let's start by drawing the area models:\n\n![](images/66/66614b051393ae60a8925817226681b7040977f913107da381736f8f0ec8fc49.png)\n\nNotice that\n\n- the two fractions have the same number of parts, and\n- the fraction on the left has *more shaded parts*.\n\nTherefore, the fraction on the left must be *greater* than the fraction on the right.\n\n![](images/09/0938588247297b0166782cf0789d22ebc891e0ff9bac8124e53aa21c371198d9.png)\n\nTherefore, the correct statement is the following:\n\n$$\n\\dfrac{4}{5} \\,> \\,\\dfrac{2}{5}\n$$\n\nSo, the correct answer is \"III only.\"" 13194139533347 17592186045585 true] [17592186073419 1069 "e-10207" 13194139533347 17592186045585 true] [17592186073419 1071 "$\\dfrac{3}{4} \\,\\square \\,\\dfrac{3}{8}$\n\nWhich symbols could replace the empty box above to make the statement true?\n\n1. $=$\n2. $<$\n3. $>$" 13194139533347 17592186045585 true] [17592186073419 1072 #uuid "15156d69-7edf-543e-9a83-f4b028a0aea5" 13194139533347 17592186045585 true] [17592186073419 1074 "Let's start by drawing the area models:\n\n![](images/5f/5f9642ad1ba67cbdaa922b81b5965ab82c04a8684bd785e29ca0923e8e011515.png)\n\nBoth fractions have the same number of shaded parts. However, the parts are of different sizes.\n\nThe fraction on the left has larger parts (quarters) than the fraction on the right (eighths). Therefore, the fraction on the left is larger.\n\n![](images/6c/6cff7bb8cb216fff408ff5fc6d96b162d57a4a041ac4e3d8b9de5f0739965f37.png)\n\nTherefore, the correct statement is the following:\n\n$$\n\\dfrac{3}{4} > \\dfrac{3}{8}\n$$\n\nSo, the correct answer is \"III only.\"" 13194139533347 17592186045585 true] [17592186073420 1069 "e-10394" 13194139533347 17592186045585 true] [17592186073420 1071 "$\\dfrac{1}{5} \\,\\square \\,\\dfrac{1}{4}$\n\nWhich symbols could replace the empty box above to make the statement true?\n\n1. $=$\n2. $>$\n3. $<$" 13194139533347 17592186045585 true] [17592186073420 1072 #uuid "135f3d7f-4df3-5dee-8dad-61fcc6085f1e" 13194139533347 17592186045585 true] [17592186073420 1074 "Let's start by drawing the area models:\n\n![](images/d1/d137d8ee50ae73bf469a7f7279f103811da0f3f2372c92fb96fa9a6ae2491d22.png)\n\nBoth fractions have the same number of shaded parts. However, the parts are of different sizes.\n\nThe fraction on the left has a smaller shaded part (one-fifth) than the fraction on the right (one-quarter). Therefore, the fraction on the left is smaller.\n\n![](images/d4/d481a19b9e6a9d98eba759849310ac76d520d7b5b05f984f52888775ecba1b3e.png)\n\nTherefore, the correct statement is the following:\n\n$$\n\\dfrac{1}{5} < \\dfrac{1}{4}\n$$\n\nSo, the correct answer is \"III only.\"" 13194139533347 17592186045585 true] [17592186073421 1069 "e-10542" 13194139533347 17592186045585 true] [17592186073421 1071 "Greg stacked $5$ cardboard boxes on top of each other. How tall was his pile if each box is $\\dfrac{3}{4}\\,\\textrm{ft}$ high?" 13194139533347 17592186045585 true] [17592186073421 1072 #uuid "3deda9a1-7edd-5b1e-9f39-5c69644f30ab" 13194139533347 17592186045585 true] [17592186073421 1074 "To find out the height of the pile of boxes, we have to multiply\n\n$$\n\\dfrac{3}{4}\n$$\n\nby $5$.\n\nTo multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n5 \\times \\dfrac34 = \\dfrac{5\\times 3}{4} = \\dfrac{15}{4}\n$$\n\nFinally, we then convert\n\n$$\n\\dfrac {15}{4}\n$$\n\nto a mixed number:\n\n$$\n15 \\div 4 = 3\\,\\textrm{R}\\,3 = 3\\,\\dfrac{3}{4}\n$$\n\nSo, Greg's stack of boxes was\n\n$$\n3\\,\\dfrac{3}{4}\\,\\textrm{ft}\n$$\n\nhigh." 13194139533347 17592186045585 true] [17592186073422 1069 "e-10543" 13194139533347 17592186045585 true] [17592186073422 1071 "Mr. Stewart spends $\\dfrac56$ hours watching an episode of his favorite TV show. If $5$ episodes are played every week, find the total time he spends watching the show every week. Between what two whole numbers does your answer lie?" 13194139533347 17592186045585 true] [17592186073422 1072 #uuid "9fb671f7-6d04-5863-9683-3b2c3753df73" 13194139533347 17592186045585 true] [17592186073422 1074 "To find out how long Mr. Stewart watches the show each week, we need to multiply\n\n$$\n\\dfrac{5}{6}\n$$\n\nby $5$.\n\nTo multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n5\\times\\dfrac56 = \\dfrac{5\\times 5}{6} = \\dfrac{25}6\n$$\n\nFinally, we then convert\n\n$$\n\\dfrac {25}{6}\n$$\n\nto a mixed number:\n\n$$\n25 \\div 6 = 4\\,\\textrm{R}\\,1 = 4\\,\\dfrac{1}{6}\n$$\n\nSo, Mr. Stewart spends a total of\n\n$$\n4\\,\\dfrac{1}{6}\n$$\n\nhours watching the show, which lies between $4$ and $5$ hours." 13194139533347 17592186045585 true] [17592186073423 1069 "e-10548" 13194139533347 17592186045585 true] [17592186073423 1071 "![](images/8f/8fd479debb08b47c49552e543d2a8a53d0cdcbfb59c9a43333b7650f33bd063a.png)\n\nConsider the diagram above. Write down this multiplication as a repeated addition of fraction models." 13194139533347 17592186045585 true] [17592186073423 1072 #uuid "a3241956-5b5b-5760-9383-d7da13f48b16" 13194139533347 17592186045585 true] [17592186073423 1074 "In the model, we have\n\n$$\n\\dfrac{\\color{red}1}{3}\n$$\n\nmultiplied by ${\\color{blue}3}$. This means that we need to make $\\color{blue}3$ copies of the given fraction model.\n\n![](images/38/38d0f24ab003913a30051d64dda233980173939825d9cc6f34473b1cbdcdbeed.png)\n\nSo, the missing fraction model is:\n\n![](images/ac/ac8618a503eb2cfd41a7fa8851cdb0dbb7152325100ec922b533d9da6e63b7c5.png)" 13194139533347 17592186045585 true] [17592186073424 1069 "e-10549" 13194139533347 17592186045585 true] [17592186073424 1071 "![](images/5a/5aef67e5f151465f09eba64456f4566cc984c97857d8e6203cd25d60952e183a.png)\n\nUse the model above to calculate $3 \\times \\dfrac{1}{5}$." 13194139533347 17592186045585 true] [17592186073424 1072 #uuid "eea25500-f78e-544f-8bf9-7eaacfac84a6" 13194139533347 17592186045585 true] [17592186073424 1074 "Since we need to multiply\n\n$$\n\\dfrac{\\color{red}1}{5}\n$$\n\nby $\\color{blue}3$, we repeat the fraction model $\\color{blue}3$ times, as shown below.\n\n![](images/fe/fe41721739d82df825d2a7e28bc19590fbc784354a58aa74137aceda0e6be202.png)\n\nThere are\n\n$$\n{\\color{blue}3} \\times {\\color{red}1} = 3\n$$\n\nshaded pieces in total. Therefore,\n\n$$\n3 \\times \\dfrac{1}{5} = \\dfrac{3}{5}\n$$" 13194139533347 17592186045585 true] [17592186073425 1069 "e-10550" 13194139533347 17592186045585 true] [17592186073425 1071 "![](images/e7/e71724d5a2f16bd88fdae52e2717ec65176ff82bc74e92cd7e18a2a19f1b8218.png)\n\nWhat multiplication problem is represented by the model above?" 13194139533347 17592186045585 true] [17592186073425 1072 #uuid "1c074473-dc1c-56c6-825b-be4b6b3dbfa2" 13194139533347 17592186045585 true] [17592186073425 1074 "We have\n\n$$\n\\dfrac{1}{9}\n$$\n\non the left and\n\n$$\n\\dfrac{4}{9}\n$$\n\non the right.\n\n![](images/ee/eef3cec4311b03e7f4be59e367cbd3d6947afd73b16a00b487f28ae7ea2bf8b8.png)\n\nTherefore, we have\n\n$$\n\\dfrac{1}{9} \\times 4 = \\dfrac{4}{9}\n$$\n\n**Note:** We can swap the factors on the left-hand side. So, the following would be a correct answer too:\n\n$$\n4 \\times \\dfrac{1}{9} = \\dfrac{4}{9}\n$$" 13194139533347 17592186045585 true] [17592186073426 1069 "e-10555" 13194139533347 17592186045585 true] [17592186073426 1071 "![](images/e9/e9bc9f6b014b092a363dbac6ff64bedefe26846c34851fd5029c89af61d68d8f.png)\n\nWhat number is missing from the multiplication problem above?" 13194139533347 17592186045585 true] [17592186073426 1072 #uuid "3e10607a-5812-50cd-a2d5-4b7c3ebcbde1" 13194139533347 17592186045585 true] [17592186073426 1074 "We have\n\n$$\n\\dfrac{1}{5}\n$$\n\non the left and\n\n$$\n\\dfrac{3}{5}\n$$\n\non the right.\n\n![](images/c1/c1efa667a938907fcdd5ba9d0172b37a7efb0a7b312e3025556c4444814d2ab3.png)\n\nThe shape on the left has $1$ shaded piece, and the shape on the right has $3$ shaded pieces. So the number of shaded pieces has increased by a factor of ${\\color{blue}3}$.\n\nTherefore, we have\n\n$$\n\\dfrac{1}{5} \\times {\\color{blue}3} = \\dfrac{3}{5}\n$$\n\nSo, the missing number is ${\\color{blue}3}$." 13194139533347 17592186045585 true] [17592186073427 1069 "e-10689" 13194139533347 17592186045585 true] [17592186073427 1071 "![](images/f5/f5a23469d826e99bc4975a4f2901a18b8af46fb1afbe4315d34a1d82d075ddb2.png)\n\nUse the area model above to find the value of $9\\div\\dfrac 1 3$." 13194139533347 17592186045585 true] [17592186073427 1072 #uuid "41b40311-a183-5d0a-9823-6c241c7deb2a" 13194139533347 17592186045585 true] [17592186073427 1074 "The area of a rectangle equals its length multiplied by its width.\n\nFor the given rectangle:\n\n- its length is $27$\n- its width is $\\dfrac{1}{3}$\n- its area is ${9}$\n\nTherefore, this area model shows the following multiplication problem:\n\n$$\n27\\times\\dfrac 1 {3} = 9\n$$\n\nUsing the relationship between multiplication and division, we can turn this multiplication problem into the following division problem:\n\n$$\n27 = 9\\div \\dfrac 13\n$$\n\nSo, the answer is $27$." 13194139533347 17592186045585 true] [17592186073428 1069 "e-10690" 13194139533347 17592186045585 true] [17592186073428 1071 "Draw an area model that could be used to represent the division problem $\\dfrac 1 {8}\\div 5 = \\dfrac 1 {40}$." 13194139533347 17592186045585 true] [17592186073428 1072 #uuid "9aa20a2d-9255-5d28-9380-6f7cb9ebbca2" 13194139533347 17592186045585 true] [17592186073428 1074 "Our division problem is\n\n$$\n\\dfrac 1 {8} \\div 5 = \\dfrac 1{40}\n$$\n\nUsing the relationship between multiplication and division, we can turn this division problem into the following multiplication problems:\n\n$$\n\\dfrac 1{8} = \\dfrac 1 {40} \\times 5 \\qquad\\textrm{or}\\qquad \\dfrac 1{8} = 5 \\times \\dfrac 1 {40}\n$$\n\nTo describe these multiplication problems using an area model, we need a rectangle with the following properties:\n\n- its area is $\\dfrac 1{8}$\n- its sides have lengths $\\dfrac1{40}$ and $5$\n\nAn area model that represents this multiplication problem could be the following:\n\n![](images/08/08643d8599a91b4976fefc2a0c89eefa794e29e25256851220aaea1d40622891.png)" 13194139533347 17592186045585 true] [17592186073429 1069 "e-10691" 13194139533347 17592186045585 true] [17592186073429 1071 "![](images/dd/dde3a368edcdc45e82d671f5969e7529e99256062f24ca1996afd14be9eb20c4.png)\n\nUsing the area model above, determine an expression that could be missing from the left-hand side of the equation below.\n$\\bbox[2pt, border: 1pt solid black]{\\phantom{\\dfrac{A}{A}\\times\\dfrac{A}{A}}} = \\dfrac{1}{24}$" 13194139533347 17592186045585 true] [17592186073429 1072 #uuid "161e3182-5490-58bf-8396-0cfe316a513b" 13194139533347 17592186045585 true] [17592186073429 1074 "The area of a rectangle equals its length multiplied by its width.\n\nFor the given rectangle:\n\n- its length is $3$\n- its width is $\\dfrac{1}{24}$\n- its area is $\\dfrac{1}{8}$\n\nTherefore, the area model represents the following multiplication problems:\n\n$$\n3 \\times {\\color{blue}\\dfrac{1}{24}} = \\dfrac{1}{8} \\qquad\\textrm{or}\\qquad {\\color{blue}\\dfrac{1}{24}} \\times 3 = \\dfrac{1}{8}\n$$\n\nUsing the relationship between multiplication and division, we can turn this multiplication problem into a division problem where the quotient equals\n\n$$\n{\\color{blue}\\dfrac{1}{24}}{:}\n$$\n\n$$\n\\bbox[5pt, border: 1pt solid black]{\\dfrac{1}{8} \\div 3} = {\\color{blue}\\dfrac{1}{24}}\n$$\n\nSo, the answer is\n\n$$\n\\dfrac{1}{8} \\div 3\n$$" 13194139533347 17592186045585 true] [17592186073430 1069 "e-10933" 13194139533347 17592186045585 true] [17592186073430 1071 "![](images/f4/f4446b7ddd7b178627774c041eae0735ffab7049e112073621698006d96232e2.png)\n\nCalculate the value of $\\sec{F}$." 13194139533347 17592186045585 true] [17592186073430 1072 #uuid "6cca60af-3be2-5e1a-b6d8-d77e3677bb27" 13194139533347 17592186045585 true] [17592186073430 1074 "In the right triangles $\\triangle ABC$ and $\\triangle DEF$, we have two pairs of congruent angles:\n\n- $\\angle B \\cong \\angle E$, since they are both right angles, and\n- $\\angle A\\cong \\angle D$.\n\nTherefore, $\\triangle ABC \\sim \\triangle DEF$ by AA, and consequently, $\\angle F\\cong\\angle C$.\n\nSo we have\n\n$$\n\\cos{F} = \\cos{C} = \\dfrac{BC}{AC} = \\dfrac{6}{10}=\\dfrac{3}{5}\n$$\n\nand finally,\n\n$$\n\\sec{F} = \\dfrac{1}{\\cos{F}} = \\dfrac{5}{3}\n$$" 13194139533347 17592186045585 true] [17592186073431 1069 "e-10934" 13194139533347 17592186045585 true] [17592186073431 1071 "![](images/ed/edbe864c85cc39ca4889bf37821c352491de04b3a3d984eb18b703287f28f765.png)\n\nFind the value of $BM$." 13194139533347 17592186045585 true] [17592186073431 1072 #uuid "c69f8b20-250c-5ad5-8b7f-e849c1cce6a5" 13194139533347 17592186045585 true] [17592186073431 1074 "In the right triangles $\\triangle AON$ and $\\triangle MOB$, we have two pairs of congruent angles:\n\n- $\\angle AON \\cong \\angle BOM$ since they are both right angles, and\n- $\\angle B\\cong \\angle N$.\n\nTherefore, $\\triangle AON \\sim \\triangle MOB$ by AA, and consequently $\\angle M \\cong \\angle A$.\n\nSo we have\n\n$$\n\\begin{aligned}\n\\cos M &= \\cos A \\\\\n\\frac{OM}{BM} &= \\cos 60^{∘} \\\\\n\\frac{10}{BM} &= 0.5 \\\\\nBM &= \\frac{10}{0.5} \\\\\nBM &= 20\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073432 1069 "e-10936" 13194139533347 17592186045585 true] [17592186073432 1071 "![](images/9b/9b0acde97d730592050c336fc0ba89a22cf5c45777c92bfde049715856718f6f.png)\n\nFind the value of $\\cos C$." 13194139533347 17592186045585 true] [17592186073432 1072 #uuid "f3d8d1cc-a8ba-5cea-9e8e-5fc23f4e4ce1" 13194139533347 17592186045585 true] [17592186073432 1074 "In the triangles $\\triangle ADB$ and $\\triangle ABC$, there are two pairs of congruent angles:\n\n- $\\angle ABC \\cong \\angle BDA$ since they are both right angles, and\n- $\\angle A$ is common to both triangles.\n\nTherefore, $\\triangle ADB \\sim \\triangle ABC$ by AA. As a result, we have $\\angle C\\cong\\angle ABD$, and consequently\n\n$$\n\\cos C= \\cos (\\angle ABD) =\\dfrac{BD}{AB}=\\dfrac{5}{AB}\n$$\n\nThe value of $AB$ is not given, but we can calculate it using the Pythagorean theorem on $\\triangle ADB$ as follows:\n\n$$\n\\begin{aligned}\nAB &= \\sqrt{AD^{2} + BD^{2}} \\\\\n&= \\sqrt{(\\sqrt{11})^{2} + 5^{2}} \\\\\n&= \\sqrt{11 + 25} \\\\\n&= \\sqrt{36} \\\\\n&= 6\n\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\cos C=\\dfrac{5}{AB}=\\dfrac{5}{6}\n$$" 13194139533347 17592186045585 true] [17592186073433 1069 "e-10949" 13194139533347 17592186045585 true] [17592186073433 1071 "![](images/95/95ab040dec1b94f5076c705ea691ba3ea9c85fe18b911e37815e3d809d429ff5.png)\n\nCalculate the value of $\\tan{\\angle CBD}$." 13194139533347 17592186045585 true] [17592186073433 1072 #uuid "d0d6ce3a-64f0-5f75-8725-c872e4cda986" 13194139533347 17592186045585 true] [17592186073433 1074 "In the triangles $\\triangle BDC$ and $\\triangle ABC$, there are two pairs of congruent angles:\n\n- $\\angle BDC \\cong \\angle ABC$ since they are both right angles, and\n- $\\angle C$ is common to both triangles.\n\nTherefore, $\\triangle BDC \\sim \\triangle ABC$ by AA, and consequently, $\\angle CBD \\cong \\angle A$.\n\nSo, we have\n\n$$\n\\begin{aligned}\n\\tan (∠CBD) &= \\tan A = \\frac{BC}{AB} = \\frac{3}{4}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073434 1069 "e-11813" 13194139533347 17592186045585 true] [17592186073434 1071 "![](images/9b/9b2f28dea5fd7d223812c1397ba0d56a05c20b6d0d7a878e9057b302db7b9b58.png)\n\nConsider the two spheres above (picture not to scale). What is the ratio of the larger sphere's volume to the smaller one's?" 13194139533347 17592186045585 true] [17592186073434 1072 #uuid "43598bc6-643e-5b3b-aa07-702b0ae26c25" 13194139533347 17592186045585 true] [17592186073434 1074 "Recall that all spheres are similar.\n\nIf two solids are similar with scale factor $k$, then the ratio of the corresponding volumes equals $k^3$.\n\nHere, the larger solid is similar to the smaller one with a scale factor of\n\n$$\nk = \\dfrac{6\\,\\textrm{cm}}{3\\,\\textrm{cm}} = 2\n$$\n\nThus, the volume of the larger solid is\n$k^3=2^3=8$\ntimes bigger than the volume of the smaller one.\n\nTherefore, the ratio of the larger volume to the smaller is $8:1$." 13194139533347 17592186045585 true] [17592186073435 1069 "e-11899" 13194139533347 17592186045585 true] [17592186073435 1071 "![](images/f0/f002a35a8f544738ff823719d73e9d4efb7a73dff7d9c9f6d77d26cd87845caf.png)\n\nIn the diagram above, $\\overset{\\longleftrightarrow}{KL} \\parallel \\overset{\\longleftrightarrow}{MN}$.\n\nConsider the following statement:\n\n> $m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = 180^\\circ$\n\nComplete the proof below by finding the missing entries.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\overset{\\longleftrightarrow}{KL} \\parallel \\overset{\\longleftrightarrow}{MN}$ | Given |\n| 2 | $\\angle{MOQ} \\cong \\angle{\\alpha}$ |  |\n| 3 | $m\\angle{MOQ} = m\\angle{\\alpha}$ | Definition of congruent angles |\n| 4 | $\\angle{QOP} \\cong \\angle{\\beta}$ |  |\n| 5 | $m\\angle{QOP} = m\\angle{\\beta}$ | Definition of congruent angles |\n| 6 | $\\angle{PON} \\cong \\angle{\\gamma}$ | Corresponding angles postulate |\n| 7 | $m\\angle{PON} = m\\angle{\\gamma}$ | Definition of congruent angles |\n| 8 | $m\\angle{MON}=180^\\circ$ |  |\n| 9 | $m\\angle{MOQ} + m\\angle{QOP} + m\\angle{PON}$<br>$\\qquad\\qquad = m\\angle{MON}$ | Angle addition postulate |\n| 10 | $m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = m\\angle{MON}$ | Substitution |\n| 11 | $m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = 180^\\circ$ |  |" 13194139533347 17592186045585 true] [17592186073435 1072 #uuid "59038429-3d79-5b35-8139-b18c20cd6a4f" 13194139533347 17592186045585 true] [17592186073435 1074 "![](images/08/08cf837c2bb4fdac86c7505a211cad873751b1cbc80077e70bbc10618eac7ed1.png)\n\nThe correct proof is below.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\overset{\\longleftrightarrow}{KL} \\parallel \\overset{\\longleftrightarrow}{MN}$ | Given |\n| 2 | $\\angle{MOQ} \\cong \\angle{\\alpha}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Corresponding angles postulate}}$ |\n| 3 | $m\\angle{MOQ} = m\\angle{\\alpha}$ | Definition of congruent angles |\n| 4 | $\\angle{QOP} \\cong \\angle{\\beta}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Vertical angles theorem}}$ |\n| 5 | $m\\angle{QOP} = m\\angle{\\beta}$ | Definition of congruent angles |\n| 6 | $\\angle{PON} \\cong \\angle{\\gamma}$ | Corresponding angles postulate |\n| 7 | $m\\angle{PON} = m\\angle{\\gamma}$ | Definition of congruent angles |\n| 8 | $m\\angle{MON}=180^\\circ$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of a straight angle}}$ |\n| 9 | $m\\angle{MOQ} + m\\angle{QOP} + m\\angle{PON}$<br>$\\qquad\\qquad = m\\angle{MON}$ | Angle addition postulate |\n| 10 | $m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = m\\angle{MON}$ | Substitution |\n| 11 | $m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = 180^\\circ$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Transitive property of equality}}$ |\n\nLet's examine the rows of the table with missing parts in turn.\n\n- Consider row 2. From row 1, we have that $\\overset{\\longleftrightarrow}{KL}$ and $\\overset{\\longleftrightarrow}{MN}$ are parallel. Therefore, by the corresponding angles postulate, the corresponding angles $\\angle {MOQ}$ and $\\angle{\\alpha}$ are congruent.\n- Consider row 4. Since the lines $\\overset{\\longleftrightarrow}{KP}$ and $\\overset{\\longleftrightarrow}{LQ}$ meet at the point $O$, $\\angle{QOP}$ and $\\beta$ are vertical angles, so they are congruent by the vertical angles theorem.\n- Consider row 8. Since $\\overset{\\longleftrightarrow}{MN}$ is a line, $m \\angle MON = 180^\\circ$ by the definition of a straight angle.\n- Consider row 11. From row 8, we have $m \\angle MON = 180^\\circ$, and from row 10, we have\n$m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = m\\angle{MON}$.\nTherefore, by the transitive property of equality, we have\n$m\\angle{\\alpha} + m\\angle{\\beta} + m\\angle{\\gamma} = m\\angle{MON} = 180^\\circ$." 13194139533347 17592186045585 true] [17592186073436 1069 "e-12041" 13194139533347 17592186045585 true] [17592186073436 1071 "![](images/8d/8d4987c5855484b41adcd308152b843bd3e5404f069bf27481cb530329364a2b.png)\n\nIn the diagram above, $\\overline{CD} \\perp \\overline{AB}$ and $\\angle{ACD} \\cong \\angle BCD$.\n\nConsider the following statement:\n\n> $AC=CB$\n\nThe table below gives the proof of the statement. Fill in the empty rows of the table with the correct reasons and thus complete the proof.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\overline{CD}\\perp \\overline{AB}$ | Given |\n| 2 | $\\angle{CDA}$ and $\\angle{CDB}$ are right angles | Definition of perpendicular lines |\n| 3 | $\\angle CDA \\cong \\angle CDB$ |  |\n| 4 | $\\overline{CD} \\cong \\overline{CD}$ | Reflexive property of congruence |\n| 5 | $\\angle ACD \\cong \\angle BCD$ | Given |\n| 6 | $\\triangle ACD \\cong \\triangle BCD$ |  |\n| 7 | $\\overline{AC} \\cong \\overline{BC}$ | CPCTC |\n| 8 | $AC = BC$ |  |" 13194139533347 17592186045585 true] [17592186073436 1072 #uuid "22ebe0a0-b6ec-5af7-97dd-a9f2cd87f01e" 13194139533347 17592186045585 true] [17592186073436 1074 "The correct proof is shown below.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\overline{CD}\\perp \\overline{AB}$ | Given |\n| 2 | $\\angle{CDA}$ and $\\angle{CDB}$ are right angles | Definition of perpendicular lines |\n| 3 | $\\angle CDA \\cong \\angle CDB$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Right angle postulate}}$ |\n| 4 | $\\overline{CD} \\cong \\overline{CD}$ | Reflexive property of congruence |\n| 5 | $\\angle ACD \\cong \\angle BCD$ | Given |\n| 6 | $\\triangle ACD \\cong \\triangle BCD$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{ASA criterion}}$ |\n| 7 | $\\overline{AC} \\cong \\overline{BC}$ | CPCTC |\n| 8 | $AC = BC$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of congruent segments}}$ |\n\nLet's examine the rows of the table with missing parts in turn.\n\n- Consider row 3. From row 2, we have that $\\angle{CDA}$ and $\\angle{CDB}$ are right angles. Therefore, $\\angle{CDA}\\cong \\angle{CDB}$ by the right angle postulate.\n- Consider row 6. From rows 3, 4, and 5, we have\n$\\angle{CDA} \\cong \\angle{CDB}, \\qquad \\overline{CD} \\cong \\overline{CD}, \\qquad \\angle ACD \\cong \\angle BCD$.\nTherefore, $\\triangle ACD \\cong \\triangle BCD$ by the ASA criterion.\n- Consider row 8. From row 7, the segments $\\overline{AC}$ and $\\overline{BC}$ are congruent. Therefore, by definition of congruent segments, these segments have the same measure." 13194139533347 17592186045585 true] [17592186073437 1069 "e-12500" 13194139533347 17592186045585 true] [17592186073437 1071 "Which of the figures below is a rectangle?\n\n![](images/be/be86b926eec82a4763c18df075af149d03cf804d07568a6290bc6d7339d6c27b.png)" 13194139533347 17592186045585 true] [17592186073437 1072 #uuid "540ff408-ba8c-5024-8828-c9b290b673c2" 13194139533347 17592186045585 true] [17592186073437 1074 "First, let's highlight \"rectangle\" in our hierarchy diagram.\n\n![](images/9d/9d5e8b05d742901e15d2099d8f20bddbf97461f4e8968c89286eb79e6eda002e.png)\n\nTo find the other ways in which \"rectangle\" may *sometimes* be classified, we write down all the names moving down (but never up) in the hierarchy diagram.\n\nBy doing this, we can deduce that a rectangle is *sometimes* a\n\n$\\qquad$ ${\\color{darkgreen}\\checkmark}\\:$ square\n\nWith that in mind, let's look at each shape in turn.\n\n- $\\mathcal{P}$ is a rectangle.\n- $\\mathcal{Q}$ is a quadrilateral. However, it is *not* a rectangle.\n- $\\mathcal{R}$ is a rhombus. However, it is *not* a rectangle.\n- $\\mathcal{S}$ is a square. Therefore, it is also a rectangle.\n\nTherefore, only $\\mathcal{P}$ and $\\mathcal{S}$ are rectangles." 13194139533347 17592186045585 true] [17592186073438 1069 "e-12501" 13194139533347 17592186045585 true] [17592186073438 1071 "From left to right, what words are missing from the sentence below?\n\n$\\qquad$ *A rectangle is $\\text{__________}$ a $\\text{__________}$.*\n\n1. sometimes, trapezoid\n2. always, trapezoid\n3. always, polygon" 13194139533347 17592186045585 true] [17592186073438 1072 #uuid "61f7a6fb-6c98-560d-b232-b24388e3cd92" 13194139533347 17592186045585 true] [17592186073438 1074 "First, recall the hierarchy diagram of quadrilaterals.\n\n![](images/a4/a482badbaddac63e0d9646b41385afc0d04632ebcbe1cf952f7af1a666bc5bb9.png)\n\nFrom the diagram, we can deduce the following:\n\n- A rectangle is *always* a${\\color{darkgreen}\\checkmark}\\:$ polygon${\\color{darkgreen}\\checkmark}\\:$ quadrilateral${\\color{darkgreen}\\checkmark}\\:$ parallelogram\n- A rectangle is *sometimes* a${\\color{darkgreen}\\checkmark}\\:$ square\n\nTherefore, the correct statement is\n\n$\\qquad$ \"*A rectangle is **always** a **polygon**.*\"" 13194139533347 17592186045585 true] [17592186073439 1069 "e-12502" 13194139533347 17592186045585 true] [17592186073439 1071 "![](images/a4/a482badbaddac63e0d9646b41385afc0d04632ebcbe1cf952f7af1a666bc5bb9.png)\n\nUse the hierarchy diagram above to determine which of the following statements are true.\n\n1. A parallelogram is *always* a polygon.\n2. A parallelogram is *always* a square.\n3. A parallelogram is *always* a rhombus." 13194139533347 17592186045585 true] [17592186073439 1072 #uuid "5d22282a-39ff-5f78-aafe-2299297e3f9a" 13194139533347 17592186045585 true] [17592186073439 1074 "![](images/d3/d39b7a93b060aba523e9127d4542ddf792bca7c5e290f5cd0fe69ed3a026e96d.png)\n\nTo find the other ways in which \"parallelogram\" may *always* be classified, we write down all the names moving up (but never down) in the hierarchy diagram from \"parallelogram.\"\n\nBy doing this, we can deduce that a parallelogram is *always* a\n\n$\\qquad$ ${\\color{darkgreen}\\checkmark}\\:$ quadrilateral\n\n$\\qquad$ ${\\color{darkgreen}\\checkmark}\\:$ polygon\n\nHowever, it may *not* be described as the following:\n\n$\\qquad$ ${\\color{red}\\times}\\:$ a rectangle\n\n$\\qquad$ ${\\color{red}\\times}\\:$ a trapezoid\n\n$\\qquad$ ${\\color{red}\\times}\\:$ a rhombus\n\n$\\qquad$ ${\\color{red}\\times}\\:$ a square\n\nTherefore, the correct answer is \"I only.\"" 13194139533347 17592186045585 true] [17592186073440 1069 "e-12548" 13194139533347 17592186045585 true] [17592186073440 1071 "Find the shortest distance between the point $(3,2)$ and the line $x=5$." 13194139533347 17592186045585 true] [17592186073440 1072 #uuid "2ce03c34-8e2c-5554-a129-1eaf05ad46fd" 13194139533347 17592186045585 true] [17592186073440 1074 "Let's sketch the given situation.\n\n![](images/95/952be9b27e5350f755f0f534883f3c70516bb4e03b34e9448ab5d43950d4bad6.png)\n\nSince the line $x = 5$ is vertical, the shortest distance between this line and the point $(3,2)$ is given by the absolute value of the difference between $x$-coordinate of the point and $5$.\n\nSo, the shortest distance is\n\n$$\nd = \\mid 3 - 5 \\mid = 2\n$$" 13194139533347 17592186045585 true] [17592186073441 1069 "e-12549" 13194139533347 17592186045585 true] [17592186073441 1071 "Find the shortest distance between the point $(1,3)$ and the line $y=\\dfrac{1}{2}x -5$." 13194139533347 17592186045585 true] [17592186073441 1072 #uuid "64a6782b-aa64-5027-8311-3498c19c39e1" 13194139533347 17592186045585 true] [17592186073441 1074 "Let's draw a diagram describing our situation.\n\n![](images/5c/5ccfa3c27c6bb2759ffc37c73b3640583fa962ee79f47b21f02ac0c1d9164b00.png)\n\nFirst, we find the equation of the line that is perpendicular to\n\n$$\ny=\\dfrac{1}{2}x - 5\n$$\n\nand passes through the point $(1,3)$.\n\nThe given line has a slope of\n\n$$\n\\dfrac{1}{2}\n$$\n\nso our perpendicular line must have a slope of $-2$.\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 3 &= -2(x - 1) \\\\\ny - 3 &= -2x + 2 \\\\\ny &= -2x + 5\n\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{y = \\frac{1}{2}x - 5; y =-2x + 5\n$$\n\nWe can solve this system by setting the two equations equal and solving for $x$. This gives\n\n$$\n\\begin{aligned}\n\\frac{1}{2}x - 5 &= -2x + 5 \\\\\n\\frac{1}{2}x + 2x &= 5 + 5 \\\\\n\\frac{5}{2}x &= 10 \\\\\nx &= 10 \\cdot \\frac{2}{5} \\\\\nx &= 4\n\\end{aligned}\n$$\n\nSubstituting $x=4$ into either of the two equations gives $y=-3$. So, our solution is $x=4$ and $y=-3$. Consequently, the lines intersect at the point\n\n$$\n\\left(4,-3\\right)\n$$\n\nFinally, we find the distance $d$ between the points $(1,3)$ and\n\n$$\n\\left(4, -3 \\right)\n$$\n\n$$\n\\begin{aligned}\nd &= \\sqrt{(x_{2} - x_{1})^{2} + (y_{2} - y_{1})^{2}} \\\\\n&= \\sqrt{(4 - 1)^{2} + (-3 - 3)^{2}} \\\\\n&= \\sqrt{9 + 36} \\\\\n&= \\sqrt{45} \\\\\n&= \\sqrt{9}\\sqrt{5} \\\\\n&= 3\\sqrt{5}\n\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(1,3)$ and the line\n\n$$\ny=\\dfrac{1}{2}x -5\n$$\n\nis $3 \\sqrt{5}$." 13194139533347 17592186045585 true] [17592186073442 1069 "e-12612" 13194139533347 17592186045585 true] [17592186073442 1071 "![](images/c4/c48fc163b3c9543dcfdd03b20882f0d2a19747672c6b1db2a42a683f0014fe25.png)\n\nFind the point on the line $y-x=4$ that is closest to the point $(3,3)$." 13194139533347 17592186045585 true] [17592186073442 1072 #uuid "57fc631b-c251-55d2-a9d5-6b41fc4bb00c" 13194139533347 17592186045585 true] [17592186073442 1074 "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}\ny - x &= 4 \\\\\ny &= x + 4\n\\end{aligned}\n$$\n\nNext, we find the equation of the line that is perpendicular to\n\n$$\ny = x + 4\n$$\n\nand passes through the point $(3,3)$.\n\nThe given line has a slope of $1$, so our perpendicular line must have a slope of $-1$.\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}\ny - y_{1} &= m(x - x_{1}) \\\\\ny - 3 &= -1(x - 3) \\\\\ny - 3 &= -x + 3 \\\\\ny &= -x + 6\n\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{y = x + 4; y =-x + 6\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x$. This gives\n\n$$\n\\begin{aligned}\nx + 4 &= -x + 6 \\\\\nx + x &= 6 - 4 \\\\\n2x &= 2 \\\\\nx &= 1\n\\end{aligned}\n$$\n\nSubstituting $x=1$ into either of the two equations gives $y=5$. So, our solution is $x=1$ and $y=5$. Consequently, the lines intersect at the point $(1,5)$.\n\nTherefore, we conclude that the point on the line $y-x= 4$ that is closest to the point $(3,3)$ is $(1,5)$." 13194139533347 17592186045585 true] [17592186073443 1069 "e-12780" 13194139533347 17592186045585 true] [17592186073443 1071 "What is the additive inverse of $40$?" 13194139533347 17592186045585 true] [17592186073443 1072 #uuid "735e0a05-bc90-5b18-b096-d51d9f9c50e3" 13194139533347 17592186045585 true] [17592186073443 1074 "To find the additive inverse of the number $40$, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. So, we obtain\n\n$$\n{\\color{red}{-}}\\,(40) = -40\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n40+(-40) = 40-40 = 0 \\quad {\\color{green}\\checkmark}\n$$" 13194139533347 17592186045585 true] [17592186073444 1069 "e-12781" 13194139533347 17592186045585 true] [17592186073444 1071 "What number can be added to $-28$ to get a sum of $0$?" 13194139533347 17592186045585 true] [17592186073444 1072 #uuid "de14e5df-9b12-5878-a134-9b02db1d5b5d" 13194139533347 17592186045585 true] [17592186073444 1074 "The number that can be added to $-28$ to give $0$ is the additive inverse of $-28$.\n\nTo find the additive inverse of the number $-28$, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. So, we obtain\n\n$$\n{\\color{red}{-}}\\,(-28) = 28\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n(-28)+28 = -28+28= 0 \\quad {\\color{green}\\checkmark}\n$$" 13194139533347 17592186045585 true] [17592186073445 1069 "e-12782" 13194139533347 17592186045585 true] [17592186073445 1071 "What is the additive inverse of $0.72$?" 13194139533347 17592186045585 true] [17592186073445 1072 #uuid "8b152054-aec8-58f3-9a7a-e435e49fe8c9" 13194139533347 17592186045585 true] [17592186073445 1074 "To find the additive inverse of the number $0.72$, we change its sign by placing a minus symbol $({\\color{red}{-}})$ in front of it. So, we obtain\n\n$$\n{\\color{red}{-}}\\,(0.72) = -0.72\n$$\n\nTo check our work, we add the inverse to the original number. If we're correct, we should get zero.\n\n$$\n0.72+(-0.72) = 0.72-0.72 = 0 \\quad {\\color{green}\\checkmark}\n$$" 13194139533347 17592186045585 true] [17592186073446 1069 "e-12783" 13194139533347 17592186045585 true] [17592186073446 1071 "How can we represent the additive inverse of $-2$ on the number line?" 13194139533347 17592186045585 true] [17592186073446 1072 #uuid "f0a3790d-c67d-5b70-b33e-ce71f8606ad3" 13194139533347 17592186045585 true] [17592186073446 1074 "The only two numbers that are at a distance of $2$ from zero are $2$ and $-2$. So, $2$ is the additive inverse of $-2$.\n\n![](images/25/259f6788e458fc902185709350128e8e8df2bcacb567eb7c5ab85f99aadc47b5.png)\n\nTherefore, the additive inverse of $-2$ is $2$, and can be represented on the number line as follows:\n\n![](images/38/384dc1354574dcd2f43ef5871421d7ca35e5e04498187f3a912c389a14941c43.png)" 13194139533347 17592186045585 true] [17592186073447 1069 "e-12935" 13194139533347 17592186045585 true] [17592186073447 1071 "Which of the options below makes the following statement true?\n\n> $7 \\times \\dfrac{4}{5}$ is $\\text{___________}$\n\n1. less than $7$\n2. equal to $7$\n3. greater than $7$" 13194139533347 17592186045585 true] [17592186073447 1072 #uuid "e1fb9a8a-d0d9-5860-9c54-f8ed44dc9903" 13194139533347 17592186045585 true] [17592186073447 1074 "We must compare the size of the following product to the number $7{:}$\n\n$$\n7 \\times {\\color{red}\\dfrac{4}{5}}\n$$\n\nSince\n\n$$\n\\color{red}\\dfrac{4}{5}\n$$\n\nis *less than* $1$, the number $7$ is *scaled down* (i.e., becomes *smaller*) when it's multiplied by\n\n$$\n{\\color{red}\\dfrac{4}{5}}\n$$\n\nTherefore, the correct statement is as follows:\n\n> *$7 \\times\\dfrac{4}{5}$ is $7$*" 13194139533347 17592186045585 true] [17592186073448 1069 "e-12936" 13194139533347 17592186045585 true] [17592186073448 1071 "Which of the options below makes the following statement true?\n\n> $\\dfrac{4}{9} \\times \\dfrac{7}{2}$ is $\\text{____________}$\n\n1. equal to $\\dfrac{4}{9}$\n2. less than $\\dfrac{4}{9}$\n3. greater than $\\dfrac{4}{9}$" 13194139533347 17592186045585 true] [17592186073448 1072 #uuid "2f8084c9-063c-5e8d-830e-d355ed75b6a8" 13194139533347 17592186045585 true] [17592186073448 1074 "We must compare the size of the following product to the number\n\n$$\n\\dfrac49{:}\n$$\n\n$$\n\\dfrac49 \\times {\\color{red}\\dfrac{7}{2}}\n$$\n\nSince\n\n$$\n\\color{red}\\dfrac{7}{2}\n$$\n\nis *larger than* $1$, the number\n\n$$\n\\dfrac{4}{9}\n$$\n\nis *scaled up* (i.e., becomes *larger*) when it's multiplied by\n\n$$\n{\\color{red}\\dfrac{7}{2}}\n$$\n\nTherefore, the correct statement is as follows:\n\n> *$\\dfrac{4}{9} \\times \\dfrac{7}{2}$ is $\\frac{4}{9}$*" 13194139533347 17592186045585 true] [17592186073449 1069 "e-12937" 13194139533347 17592186045585 true] [17592186073449 1071 "Which of the following products is greater than $6$?\n\n1. $6 \\times \\dfrac{9}{5}$\n2. $1\\,\\dfrac{1}{5} \\times 6$\n3. $\\dfrac{5}{8} \\times 6$" 13194139533347 17592186045585 true] [17592186073449 1072 #uuid "1b969f5d-ce9d-52e4-a930-de775400db7b" 13194139533347 17592186045585 true] [17592186073449 1074 "Let's examine each product in turn.\n\n- Since $\\color{blue}\\dfrac{9}{5}$ is *greater than* $1$, the number $6$ is *scaled up* (i.e., becomes *larger*) when it's multiplied by ${\\color{blue}\\dfrac{9}{5}}$. Therefore, this product is *greater than* $6.\\quad{\\color{green}{\\checkmark}}$\n- Since $\\color{blue}1\\dfrac{1}{5}$ is *greater than* $1$, the number $6$ is *scaled up* (i.e., becomes *larger*) when it's multiplied by ${\\color{blue}1\\dfrac{1}{5}}$. Therefore, this product is *greater than* $6.\\quad{\\color{green}{\\checkmark}}$\n- Since $\\color{blue}\\dfrac{5}{8}$ is *less than* $1$, the number $6$ is *scaled down* (i.e., becomes *smaller*) when it's multiplied by ${\\color{blue}\\dfrac{5}{8}}$. Therefore, this product is *less than* $6.\\quad{\\color{red}{\\times}}$\n\nSo, the correct answer is \"I and II only.\"" 13194139533347 17592186045585 true] [17592186073450 1069 "e-12938" 13194139533347 17592186045585 true] [17592186073450 1071 "Which of the following products is greater than $\\dfrac{3}{2}$?\n\n1. $\\dfrac{3}{2} \\times \\dfrac{2}{2}$\n2. $\\dfrac{3}{2} \\times \\dfrac{3}{2}$\n3. $\\dfrac{3}{2} \\times \\dfrac{2}{3}$" 13194139533347 17592186045585 true] [17592186073450 1072 #uuid "f6ec1aa0-a791-5baf-8048-2a954a1cd8e6" 13194139533347 17592186045585 true] [17592186073450 1074 "Let's examine each product in turn.\n\n- Since $\\color{blue}\\dfrac{2}{2}$ is *equal to* $1$, the number $\\dfrac32$ is neither scaled down nor scaled up when it's multiplied by ${\\color{blue}\\dfrac{2}{2}}$. Therefore, this product *equals* $\\dfrac32.\\quad{\\color{red}{\\times}}$\n- Since $\\color{blue}\\dfrac{3}{2}$ is *greater than* $1$, the number $\\dfrac{3}{2}$ is *scaled up* (i.e., becomes *larger*) when it's multiplied by ${\\color{blue}\\dfrac{3}{2}}$. Therefore, this product is *greater than* $\\dfrac{3}{2}.\\quad{\\color{green}{\\checkmark}}$\n- Since $\\color{blue}\\dfrac23$ is *less than* $1$, the number $\\dfrac32$ is *scaled down* (i.e., becomes *smaller*) when it's multiplied by ${\\color{blue}\\dfrac{2}{3}}$. Therefore, this product is *less than* $\\dfrac32.\\quad{\\color{red}{\\times}}$\n\nSo, the correct answer is \"II only.\"" 13194139533347 17592186045585 true] [17592186073451 1069 "e-13009" 13194139533347 17592186045585 true] [17592186073451 1071 "Solve the following system of equations:\n${x - y = 4; x + 2y = 16$" 13194139533347 17592186045585 true] [17592186073451 1072 #uuid "e9aae52c-65f3-5dff-bc6b-a530f8c7acc1" 13194139533347 17592186045585 true] [17592186073451 1074 "We will isolate a variable in one of the equations and then substitute it into the other equation. It doesn't matter which equation we pick first, so we choose the easiest one. In this case, the first equation looks like the easiest.\n\nUsing the first equation, we can isolate $x$ by adding $y$ to both sides of the equation:\n\n$$\n\\begin{aligned}\nx - y &= 4 \\\\\nx &= 4 + y\n\\end{aligned}\n$$\n\nThen, we replace $x$ with $4+y$ in the second equation and solve for $y$:\n\n$$\n\\begin{aligned} x+2y &=16 \\\\ (4+y) + 2y &=16 \\\\ 4+3y &=16 \\\\ 3y &=12 \\\\ y &=4 \\end{aligned}\n$$\n\nIf we now substitute $y=4$ into\n\n$$\nx=4+y\n$$\n\n, then we can find the value of $x$:\n\n$$\n\\begin{aligned} x &= 4 + y \\\\ &= 4 + (4) \\\\ &=8 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x = 8$ and $y = 4$, which can be written as $(8, 4)$." 13194139533347 17592186045585 true] [17592186073452 1069 "e-13010" 13194139533347 17592186045585 true] [17592186073452 1071 "Solve the following system of equations:\n\n${2u + 9v - 6 = 0; 2u + 6v - 8 = 0$" 13194139533347 17592186045585 true] [17592186073452 1072 #uuid "707504e8-a367-5dc2-a663-371a9dcf7224" 13194139533347 17592186045585 true] [17592186073452 1074 "Sometimes, it's handy to assign a number to each equation in a system, so that we can refer to them more easily:\n\n$$\n{2u + 9v - 6 = 0(1); 2u + 6v - 8 = 0(2)\n$$\n\nWe will isolate a variable in one of the equations and then substitute it into the other equation. Using equation $\\color{blue}(2)$, we can solve for $u$ as follows:\n\n$$\n\\begin{aligned} 2u+6v-8 &= 0 \\\\ 2u+6v &= 8 \\\\ 2u &= 8 - 6v \\\\ u &= \\dfrac{8-6v}{2} \\\\ u &= 4 - 3v \\end{aligned}\n$$\n\nThen, we substitute $u=4-3v$ into equation $\\color{red}(1)$ and solve for $v$:\n\n$$\n\\begin{aligned} 2u+9v-6 &= 0 \\\\ 2(4-3v)+9v-6 &= 0 \\\\ 8-6v+9v-6 &= 0 \\\\ 2+3v &= 0 \\\\ 3v &= -2 \\\\ v &= -\\dfrac{2}{3} \\end{aligned}\n$$\n\nIf we now substitute\n\n$$\nv=-\\dfrac{2}{3}\n$$\n\ninto equation $\\color{red}(1)$, then we can find the value of $u$:\n\n$$\n\\begin{aligned} 2u+9v-6 &= 0 \\\\ 2u+9\\left(-\\dfrac{2}{3}\\right) -6 &= 0 \\\\ 2u-6-6 &= 0 \\\\ 2u-12 &= 0 \\\\ 2u &= 12 \\\\ u &= 6 \\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $u=6$ and\n\n$$\nv=-\\dfrac{2}{3}\n$$\n\n, which can be written as\n\n$$\n\\left(6,-\\dfrac{2}{3}\\right)\n$$" 13194139533347 17592186045585 true] [17592186073453 1069 "e-13120" 13194139533347 17592186045585 true] [17592186073453 1071 "Which of the following ratios is equivalent to $12: 9$?\n\n1. $2: 3$\n2. $4: 3$\n3. $5: 3$" 13194139533347 17592186045585 true] [17592186073453 1072 #uuid "a453e80d-016f-5a6c-9890-705463eb1fb9" 13194139533347 17592186045585 true] [17592186073453 1074 "All of the answer choices have the second number equal to $3$. So our equivalent ratio is of the form $0$\n\nTo find a ratio that's equivalent to $12: 9$, we divide both numbers by the same value. In particular, we need to get $3$ from ${\\color{red}{9}}$, so we divide ${\\color{red}{9}}$ by $3$.\n\n$$\n12\\begin{vmatrix}: & 9 \\\\ ↓ \\div 3 & ↓ \\div 3 \\\\ [math]\\phantom{0}[/math] &:\\end{vmatrix}3\n$$\n\nSo to get $0$ from ${\\color{blue}{12}}$, we divide $12$ by $3$ as well:\n\n$$\n{\\color{blue}12} \\div 3 =4\n$$\n\nTherefore, $12:9$ is equivalent to $4:3$.\n\nSo, the correct answer is \"II only.\"" 13194139533347 17592186045585 true] [17592186073454 1069 "e-13121" 13194139533347 17592186045585 true] [17592186073454 1071 "![](images/f3/f37699e58adadd6450ebc73bc969606b6f24dc8a0a52fd206ad116b2c6703a88.png)\n\nWhat ratio describes the number of triangles to the total number of shapes? Give your answer in its simplest form." 13194139533347 17592186045585 true] [17592186073454 1072 #uuid "0a57949c-efc9-5403-9e7b-08346153f184" 13194139533347 17592186045585 true] [17592186073454 1074 "First, we count the number of triangles. We see that there are $4$ triangles.\n\nThen, we count the total number of shapes. We see that there are $6$ shapes in total.\n\nSo the ratio of triangles to total shapes is $4:6$.\n\nWe can simplify this ratio by dividing both numbers in the ratio by $2$:\n\n$$\n4\\begin{vmatrix}: & 6 \\\\ ↓ \\div 2 & ↓ \\div 2 \\\\ 2 &:\\end{vmatrix}3\n$$\n\nTherefore, the ratio of triangles to the total shapes is $2:3$." 13194139533347 17592186045585 true] [17592186073455 1069 "e-13123" 13194139533347 17592186045585 true] [17592186073455 1071 "![](images/8d/8d9f0a004ca9beb84b3a2a604d71dbf43ab70a67d899b167c5183ecc2ebe15f3.png)\n\nWhat number is missing from the boxes in the statement below?\n\n> The ratio of squares to circles is $0$ because there is $1$ square for every $0$ circles." 13194139533347 17592186045585 true] [17592186073455 1072 #uuid "dd86c5a5-b8be-5d19-a477-dcf46683881f" 13194139533347 17592186045585 true] [17592186073455 1074 "First, we count the number of squares. We see that there are $2$ squares.\n\nThen, we count the number of circles. We see that there are $2$ circles.\n\nSo the ratio of circles to squares is $2:2$.\n\nWe can simplify this ratio by dividing both numbers by $2$:\n\n$$\n2\\begin{vmatrix}: & 2 \\\\ ↓ \\div 2 & ↓ \\div 2 \\\\ 1 &:\\end{vmatrix}1\n$$\n\nThis means that $2:2$ is equivalent to $1:1$.\n\nSo, the complete statement is\n\"The ratio of squares to circles is $1:\\bbox[3px,lightgray]{1}\\,$ because there is $1$ square for every $\\bbox[3px,lightgray]{1}\\,$circle.\"" 13194139533347 17592186045585 true] [17592186073456 1069 "e-13256" 13194139533347 17592186045585 true] [17592186073456 1071 "What ratio describes the number of pentagons to the total number of shapes?\n\n![](images/0f/0fff5dd90ce40b76128001c25b41cf8f34a2b4f63c44717823ba0bdcc98ef224.png)" 13194139533347 17592186045585 true] [17592186073456 1072 #uuid "c4235bf2-0c2b-5c2d-be8d-779a8e5fb38f" 13194139533347 17592186045585 true] [17592186073456 1074 "We can express the ratio of the number of pentagons to the total number of shapes as follows:\n\n$$\n\\textrm{number of pentagons}: \\textrm{total number of shapes}\n$$\n\nTo find this ratio, we start by counting the number of occurrences of each shape:\n\n- First, we count the number of pentagons. There are $3$ pentagons.\n- Next, we count the total number of shapes. There are $6$ shapes.\n\nTherefore, the ratio of pentagons to total shapes is $3:6$." 13194139533347 17592186045585 true] [17592186073457 1069 "e-13257" 13194139533347 17592186045585 true] [17592186073457 1071 "A merchant has $8$ black crates and $5$ green crates. What ratio describes the number of green crates to the total number of crates?" 13194139533347 17592186045585 true] [17592186073457 1072 #uuid "76442c46-6958-556f-a895-027a3ce7427b" 13194139533347 17592186045585 true] [17592186073457 1074 "We can express the ratio of the number of green crates to the total number of crates as follows:\n\n$$\n\\textrm{number of green crates}: \\textrm{total number of crates}\n$$\n\nWe compute our ratio as follows:\n\n- First, we count the number of green crates. There are $5$ green crates.\n- Next, we count the total number of crates. There are $8+5 = 13$ crates.\n\nTherefore, the ratio of green crates to total crates is $5:13$." 13194139533347 17592186045585 true] [17592186073458 1069 "e-13258" 13194139533347 17592186045585 true] [17592186073458 1071 "The ratio of red marbles to blue marbles in a bag is $7:8$. What is the meaning of this ratio?" 13194139533347 17592186045585 true] [17592186073458 1072 #uuid "34ec50f1-1873-510d-8693-49f93bae1df8" 13194139533347 17592186045585 true] [17592186073458 1074 "If the ratio of red marbles to blue marbles is ${\\color{red}{7}}:{\\color{blue}{8}}$, it means that there are ${\\color{red}{7}}$ red marbles for every ${\\color{blue}{8}}$ blue marbles." 13194139533347 17592186045585 true] [17592186073459 1069 "e-13342" 13194139533347 17592186045585 true] [17592186073459 1071 "| $5$ | $4$ |\n| --- | ---: |\n| $20$ | $\\bbox[3pt,Gainsboro]{\\color{red}?}$ |\n| $25$ | $20$ |\n\nWhat number is missing from the ratio table?" 13194139533347 17592186045585 true] [17592186073459 1072 #uuid "8e2f5bec-3573-5f1d-9870-41ac26b1ddf2" 13194139533347 17592186045585 true] [17592186073459 1074 "We start with the ratio ${\\color{blue}5}:{\\color{red}4}$ and write it as a fraction:\n\n$$\n\\dfrac{\\color{blue}5}{\\color{red}4}\n$$\n\nSo the numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}4}$).\n\nWe can make a numerator of $20$ by multiplying the numerator and denominator by $4$:\n\n$$\n\\begin{aligned}\n\\frac{5 \\cdot 4}{4 \\cdot 4} &= \\frac{20}{16}\n\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}4}$ |\n| --- | ---: |\n| ${\\color{blue}20}$ | $\\bbox[3pt,Gainsboro]{\\color{red}16}$ |\n| ${\\color{blue}25}$ | ${\\color{red}20}$ |\n\nSo, the missing number is $\\color{red}16$." 13194139533347 17592186045585 true] [17592186073460 1069 "e-13343" 13194139533347 17592186045585 true] [17592186073460 1071 "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $6$ | $18$ |\n| --- | ---: |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $24$ |\n| $20$ | $\\bbox[3pt,Gainsboro]{\\color{red}?}$ |" 13194139533347 17592186045585 true] [17592186073460 1072 #uuid "11fac5c9-ca4a-54a6-9f38-3c675411673e" 13194139533347 17592186045585 true] [17592186073460 1074 "We start with the ratio ${\\color{blue}6}:{\\color{red}18}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}6}}{{\\color{red}18}}\n$$\n\nSo the numerator represents the left-hand entry (${\\color{blue}6}$), and the denominator represents the right-hand entry (${\\color{red}18}$).\n\nNow we divide the numerator and the denominator by $6$ to find an equivalent ratio:\n\n$$\n\\dfrac{{\\color{blue}{6}}\\div 6}{{\\color{red}{18}}\\div 6} = \\dfrac{{\\color{blue}1}}{{\\color{red}3}}\n$$\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $24$, we multiply the numerator and denominator of the previous fraction by $8{:}$\n$\\dfrac{{\\color{blue}{1}}\\times 8}{{\\color{red}{3}}\\times 8} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}8}}{{\\color{red}24}}$\n- To create a numerator of $20$, we multiply the numerator and denominator of our fraction by $20{:}$\n$\\dfrac{{\\color{blue}{1}}\\times 20}{{\\color{red}{3}}\\times 20} = \\dfrac{{\\color{blue}20}}{\\bbox[3pt,Gainsboro]{\\color{red}60}}$\n\nFinally, we fill in the ratio table:\n\n| ${\\color{blue}6}$ | ${\\color{red}18}$ |\n| --- | ---: |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}8}$ | ${\\color{red}24}$ |\n| ${\\color{blue}20}$ | $\\bbox[3pt,Gainsboro]{\\color{red}60}$ |\n\nSo, from top to bottom, the missing numbers are $8$ and $60$." 13194139533347 17592186045585 true] [17592186073461 1069 "e-13409" 13194139533347 17592186045585 true] [17592186073461 1071 "Complete the ratio table below.\n\n| $3$ | $5$ |\n| --- | ---: |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $10$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $35$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $50$ |" 13194139533347 17592186045585 true] [17592186073461 1072 #uuid "e2ada4db-c1f0-53b0-9af7-ee2712ae75ef" 13194139533347 17592186045585 true] [17592186073461 1074 "We start with the ratio ${\\color{blue}3}:{\\color{red}5}$ and write it as a fraction:\n\n$$\n\\dfrac{\\color{blue}3}{\\color{red}5}\n$$\n\nSo the numerator represents the left-hand entry (${\\color{blue}3}$), and the denominator represents the right-hand entry (${\\color{red}5}$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $10$, we multiply the numerator and denominator of our fraction by $2{:}$\n$\\dfrac{{\\color{blue}3}\\times 2}{{\\color{red}5}\\times 2} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}6}}{\\color{red}10}$\n- To create a denominator of $35$, we multiply the numerator and denominator of our fraction by $7{:}$\n$\\dfrac{{\\color{blue}3}\\times 7}{{\\color{red}5}\\times 7} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}21}}{\\color{red}35}$\n- To create a denominator of $50$, we multiply the numerator and denominator of our fraction by $10{:}$\n$\\dfrac{{\\color{blue}3}\\times 10}{{\\color{red}5}\\times 10} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}30}}{\\color{red}50}$\n\nFinally, we fill in the ratio table:\n\n| ${\\color{blue}3}$ | ${\\color{red}5}$ |\n| --- | ---: |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}6}$ | ${\\color{red}10}$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}21}$ | ${\\color{red}35}$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}30}$ | ${\\color{red}50}$ |" 13194139533347 17592186045585 true] [17592186073462 1069 "e-13410" 13194139533347 17592186045585 true] [17592186073462 1071 "Harvey's parents reward him for each hour he spends helping with the housework. The following ratio table shows the number of hours of work Harvey did over the last three weeks and the corresponding rewards.\n\n| Reward (in dollars) | Hours of work |\n| --- | ---: |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $3$ |\n| $12$ | $4$ |\n| $15$ | $\\bbox[3pt,Gainsboro]{\\color{red}?}$ |\n\nFrom top to bottom, what are the missing numbers in the ratio table?" 13194139533347 17592186045585 true] [17592186073462 1072 #uuid "f1a6757d-3e68-5263-a6c7-d03c73391848" 13194139533347 17592186045585 true] [17592186073462 1074 "We start with the ratio ${\\color{blue}12}:{\\color{red}4}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}12}}{{\\color{red}4}}\n$$\n\nNow we divide the numerator and the denominator by $4$ to find an equivalent ratio:\n\n$$\n\\dfrac{{\\color{blue}{12}}\\div 4}{{\\color{red}{4}}\\div 4} = \\dfrac{{\\color{blue}3}}{{\\color{red}1}}\n$$\n\nWe can generate ratios that are equivalent to $3:1$ by finding more equivalent fractions:\n\n$$\n\\begin{aligned}\n\\frac{3 \\cdot 3}{1 \\cdot 3} &= \\frac{9}{3} \\\\\n\\frac{3 \\cdot 5}{1 \\cdot 5} &= \\frac{15}{5}\n\\end{aligned}\n$$\n\nFinally, we fill in the ratio table:\n\n| Reward (in dollars) | Hours of work |\n| --- | ---: |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}9}$ | $3$ |\n| $12$ | $4$ |\n| $15$ | $\\bbox[3pt,Gainsboro]{\\color{red}5}$ |\n\nSo, from top to bottom, the missing numbers are $9$ and $5$." 13194139533347 17592186045585 true] [17592186073463 1069 "e-13561" 13194139533347 17592186045585 true] [17592186073463 1071 "What is $2\\times 70$?" 13194139533347 17592186045585 true] [17592186073463 1072 #uuid "54c9eeb4-1458-5ce9-8632-a944ca6e0019" 13194139533347 17592186045585 true] [17592186073463 1074 "First, we figure out the non-zero parts:\n$\\begin{bmatrix}2 & ⟶2 \\\\ 70 & ⟶70\\end{bmatrix}$\n\nWe can see that the second number has a block of zeros containing $1$ zero only.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\bbox[2px, lightgray]{2} \\times \\bbox[2px, lightgray]{7} = \\color{red}{14}\n$$\n\nFinally, we join the above with the single $\\color{blue}0$:\n${\\color{red}14}{\\color{blue}0}$\n\nTherefore,\n\n$$\n2\\times 70 = 140\n$$" 13194139533347 17592186045585 true] [17592186073464 1069 "e-13563" 13194139533347 17592186045585 true] [17592186073464 1071 "What is $8$ multiplied by $3,000$?" 13194139533347 17592186045585 true] [17592186073464 1072 #uuid "89c205bb-83c2-5cb3-bbd3-442bfbb7869d" 13194139533347 17592186045585 true] [17592186073464 1074 "First, we figure out the non-zero part and the block of zeros for both numbers:\n$\\begin{bmatrix}3000 & ⟶3000 \\\\ 8 & ⟶8\\end{bmatrix}$\n\nWe can see that there are $\\color{blue}3$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\bbox[2px, lightgray]{3} \\times \\bbox[2px, lightgray]{8} = \\color{red}{24}\n$$\n\nFinally, we join the above with the block of $\\color{blue}3$ zeros:\n${\\color{red}24}{\\color{blue}000}$\n\nTherefore,\n\n$$\n8 \\times 3,000 = 24,000\n$$" 13194139533347 17592186045585 true] [17592186073465 1069 "e-13564" 13194139533347 17592186045585 true] [17592186073465 1071 "A baker bakes $50$ muffins, each with $20$ blueberries inside. How many blueberries are there in total?" 13194139533347 17592186045585 true] [17592186073465 1072 #uuid "9b2e8acf-a5a9-5ec7-94ee-196e91f403bc" 13194139533347 17592186045585 true] [17592186073465 1074 "To calculate the total number of blueberries that the baker used, we need to multiply $50$ by $20$.\n\nFirst, we figure out the non-zero part and the block of zeros for both numbers:\n$\\begin{bmatrix}50 & ⟶50 \\\\ 20 & ⟶20\\end{bmatrix}$\n\nWe can see that there are $\\color{blue}2$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\bbox[2px, lightgray]{5} \\times \\bbox[2px, lightgray]{2} = \\color{red}{10}\n$$\n\nFinally, we join the above with the block of zeros:\n\n$$\n{\\color{red}10}{\\color{blue}00}= 1,000\n$$\n\nTherefore, the baker used a total of $1,000$ blueberries to bake the muffins." 13194139533347 17592186045585 true] [17592186073466 1069 "e-13565" 13194139533347 17592186045585 true] [17592186073466 1071 "Find the value of $500 \\times 3,000$." 13194139533347 17592186045585 true] [17592186073466 1072 #uuid "118ebf8d-0818-59b0-88b2-759d2034c1e6" 13194139533347 17592186045585 true] [17592186073466 1074 "First, we figure out the non-zero part and the block of zeros for both numbers:\n$\\begin{bmatrix}500 & ⟶500 \\\\ 3, 000 & ⟶3000\\end{bmatrix}$\n\nWe can see that there are $\\color{blue}5$ zeros in total.\n\nNext, we multiply the non-zero parts:\n\n$$\n\\bbox[2px, lightgray]{5} \\times \\bbox[2px, lightgray]{3} = {\\color{red}15}\n$$\n\nFinally, we join the above with the block of zeros:\n${\\color{red}15}{\\color{blue}00000}$\n\nTherefore,\n\n$$\n500 \\times 3,000 = 1,500,000\n$$" 13194139533347 17592186045585 true] [17592186073467 1069 "e-13690" 13194139533347 17592186045585 true] [17592186073467 1071 "![](images/46/4644be3ee3652c8a52d62e9d849d107e691dbf1f184ea247f02552af108b2e04.png)\n\nThe $3$ circles above are divided into halves. How many halves are there in total?" 13194139533347 17592186045585 true] [17592186073467 1072 #uuid "4f8f2348-c6ec-5073-9f95-6697173654a7" 13194139533347 17592186045585 true] [17592186073467 1074 "Since each part is\n\n$$\n\\dfrac{1}{\\color{blue}2}\n$$\n\nof a whole, we need to split each of the $\\color{red}3$ circles (wholes) into $\\color{blue}2$ equal parts, as shown below.\n\n![](images/e9/e92a0deb6d9542ca276fba5c7d17c64e45bad265dc8bd8dde2dce4fa166e3e89.png)\n\nSo, we get\n\n$$\n{\\color{red}3} \\times {\\color{blue}2} = 6\n$$\n\nparts in total." 13194139533347 17592186045585 true] [17592186073468 1069 "e-13695" 13194139533347 17592186045585 true] [17592186073468 1071 "What model could represent the division problem below?\n$3 \\div \\dfrac{1}{6} = 18$" 13194139533347 17592186045585 true] [17592186073468 1072 #uuid "2f739b94-f494-546b-8623-bd17a525a436" 13194139533347 17592186045585 true] [17592186073468 1074 "Consider the following $\\color{red}3$ wholes:\n\n![](images/23/235e19c4e3231eb22e6d43ccadcd90c5694077ec4ce562e6c4f188cfff77545f.png)\n\nTo calculate\n\n$$\n{\\color{red}3} \\div \\dfrac{1}{\\color{blue}6}\n$$\n\n, we need to divide each of $\\color{red}3$ wholes into $\\color{blue}6$ equal parts, as shown below. This gives us the corresponding model for the given division problem.\n\n![](images/3b/3b3551ad59a9d5abe2bf03e350f373412959293c68a4f059123fafcbabf72936.png)\n\nWe get\n\n$$\n{\\color{red}3} \\times {\\color{blue}6}= 18\n$$\n\npieces in total." 13194139533347 17592186045585 true] [17592186073469 1069 "e-13698" 13194139533347 17592186045585 true] [17592186073469 1071 "What is the value of $\\dfrac{1}{4} \\div 3$?" 13194139533347 17592186045585 true] [17592186073469 1072 #uuid "abfb2b94-b25f-589f-b1e0-883ce065ca7a" 13194139533347 17592186045585 true] [17592186073469 1074 "To divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\dfrac{1}{4} \\div 3 = \\dfrac{1}{4 \\times 3} = \\dfrac{1}{12}\n$$" 13194139533347 17592186045585 true] [17592186073470 1069 "e-1370" 13194139533347 17592186045585 true] [17592186073470 1071 "Simplify $8\\sqrt 3 - 5\\sqrt 3 + \\sqrt 5$." 13194139533347 17592186045585 true] [17592186073470 1072 #uuid "cf793c45-6c89-50c8-bb28-d066d2b8342a" 13194139533347 17592186045585 true] [17592186073470 1074 "We can combine the two $\\sqrt{3}$ terms together, as follows:\n\n$$\n\\begin{aligned}\n8\\sqrt{3} - 5\\sqrt{3} + \\sqrt{5} &=  \\\\\n(8 - 5)\\sqrt{3} + \\sqrt{5} &=  \\\\\n&= 3\\sqrt{3} + \\sqrt{5}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073471 1069 "e-13700" 13194139533347 17592186045585 true] [17592186073471 1071 "What is the value of $\\dfrac{1}{16} \\div 5$?" 13194139533347 17592186045585 true] [17592186073471 1072 #uuid "e5ecc6c8-ef8d-569b-88cc-82fc31f09730" 13194139533347 17592186045585 true] [17592186073471 1074 "To divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\dfrac{1}{16} \\div 5 = \\dfrac{1}{16 \\times 5} = \\dfrac{1}{80}\n$$" 13194139533347 17592186045585 true] [17592186073472 1069 "e-13705" 13194139533347 17592186045585 true] [17592186073472 1071 "Joshua uses $\\dfrac{1}{2} \\, \\textrm{kg}$ of ham to make $4$ pizzas. If the ham is distributed equally among the $4$ pizzas, how much ham does he put on each pizza?" 13194139533347 17592186045585 true] [17592186073472 1072 #uuid "b95874b2-2a8e-5ffb-9cbf-8a919a7307fb" 13194139533347 17592186045585 true] [17592186073472 1074 "To determine the amount of ham on each pizza, we must divide the amount of ham by the number of pizzas:\n\n$$\n\\dfrac{1}{2} \\div 4\n$$\n\nTo divide a unit fraction by a whole number, we multiply the fraction's denominator by that whole number:\n\n$$\n\\dfrac{1}{2} \\div 4 = \\dfrac{1}{2 \\times 4} = \\dfrac{1}{8}\n$$\n\nTherefore, Joshua puts\n\n$$\n\\dfrac{1}{8} \\, \\textrm{kg}\n$$\n\nof ham on each pizza." 13194139533347 17592186045585 true] [17592186073473 1069 "e-13707" 13194139533347 17592186045585 true] [17592186073473 1071 "Each of the three shapes in the model below represents one whole.\n\n![](images/22/222af9ec253a6624ece646225db926069cd7be3ac416fe846a9216360981f8cb.png)\n\nFrom left to right, what numbers are missing from the division problem below?\n$0$" 13194139533347 17592186045585 true] [17592186073473 1072 #uuid "dd5b4bc8-110c-5247-b5e6-ee4ce7636a1b" 13194139533347 17592186045585 true] [17592186073473 1074 "In the model, there are $\\color{red}3$ shapes. Each shape consists of $4$ pieces that each represent\n\n$$\n\\dfrac{1}{4}\n$$\n\nof a whole. There are $\\color{blue}12$ pieces in total.\n\nThe model tells us that when we divide $\\color{red}3$ wholes into quarters, we will be left with $\\color{blue}12$ pieces.\n\nTherefore, the division problem is:\n$3$\n\nSo, the missing numbers are $\\color{red}3$ and $\\color{blue}12$." 13194139533347 17592186045585 true] [17592186073474 1069 "e-13709" 13194139533347 17592186045585 true] [17592186073474 1071 "![](images/46/4644be3ee3652c8a52d62e9d849d107e691dbf1f184ea247f02552af108b2e04.png)\n\nThe model above represents $3$ wholes. Use this model to calculate the value of $3 \\div \\dfrac{1}{5}$." 13194139533347 17592186045585 true] [17592186073474 1072 #uuid "06e730e3-2df3-5d28-afd1-72c34d11cf8e" 13194139533347 17592186045585 true] [17592186073474 1074 "To calculate\n\n$$\n{\\color{red}3} \\div \\dfrac{1}{\\color{blue}5}\n$$\n\n, we need to divide each of $\\color{red}3$ wholes into $\\color{blue}5$ equal parts, as shown below.\n\n![](images/32/327833c4954c43c2093cb31a03cef01e66389e7cafc3bb2d4cd174e0f7e64f5d.png)\n\nWe get\n\n$$\n{\\color{red}3} \\times {\\color{blue}5} = 15\n$$\n\npieces in total.\n\nTherefore:\n\n$$\n3 \\div \\dfrac{1}{5} = 15\n$$" 13194139533347 17592186045585 true] [17592186073475 1069 "e-13723" 13194139533347 17592186045585 true] [17592186073475 1071 "Divide $14 \\div \\dfrac{1}{3}$." 13194139533347 17592186045585 true] [17592186073475 1072 #uuid "469cedf6-ef5d-5dcd-902e-418b6f19e347" 13194139533347 17592186045585 true] [17592186073475 1074 "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n14 \\div \\dfrac{1}{3} = 14 \\times 3 = 42\n$$" 13194139533347 17592186045585 true] [17592186073476 1069 "e-13724" 13194139533347 17592186045585 true] [17592186073476 1071 "What is the value of $5 \\div \\dfrac{1}{15}$?" 13194139533347 17592186045585 true] [17592186073476 1072 #uuid "a09cb492-4d6a-54ee-884e-fc3ce58bf997" 13194139533347 17592186045585 true] [17592186073476 1074 "To divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div \\dfrac{1}{15} = 5 \\times 15 = 75\n$$" 13194139533347 17592186045585 true] [17592186073477 1069 "e-13725" 13194139533347 17592186045585 true] [17592186073477 1071 "Johnny has $5$ kilograms of wheat flour with which he wants to make some pizzas. If each pizza needs $\\dfrac{1}{10}$ of a kilogram of wheat flour, how many pizzas can Johnny make?" 13194139533347 17592186045585 true] [17592186073477 1072 #uuid "bdc09ee6-a719-5dad-b85e-acb7cdc92458" 13194139533347 17592186045585 true] [17592186073477 1074 "To determine the number of pizzas that Johnny can make, we divide the amount of wheat flour by the amount of wheat flour each pizza needs.\n\n$$\n5 \\div \\dfrac{1}{10}\n$$\n\nTo divide a whole number by a unit fraction, we multiply the whole number by the fraction's denominator:\n\n$$\n5 \\div \\dfrac{1}{10} = 5 \\times 10 = 50\n$$\n\nTherefore, Johnny can make $50$ pizzas." 13194139533347 17592186045585 true] [17592186073478 1069 "e-13727" 13194139533347 17592186045585 true] [17592186073478 1071 "By writing both mixed numbers as improper fractions, determine the missing number in the following equality:\n\n$0$" 13194139533347 17592186045585 true] [17592186073478 1072 #uuid "662dd1ce-e2f5-57c8-8f72-c6767751a43c" 13194139533347 17592186045585 true] [17592186073478 1074 "Writing\n\n$$\n5 \\, \\dfrac{1}{9}\n$$\n\nas an improper fraction, we have\n\n$$\n5 \\, \\dfrac{1}{9} = \\dfrac{(5 \\times 9) + 1}{9} = \\dfrac{46}{9}\n$$\n\nWriting\n\n$$\n4 \\, \\dfrac{1}{3}\n$$\n\nas an improper fraction, we have\n\n$$\n4 \\, \\dfrac{1}{3} = \\dfrac{(4 \\times 3) + 1}{3} = \\dfrac{13}{3}\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\dfrac{46}{9} - \\dfrac{13}{3}\n$$\n\nWe can make a common denominator of $9$. To put\n\n$$\n\\dfrac{13}{3}\n$$\n\nover a denominator of $9$, we multiply the numerator and denominator by $3$:\n\n$$\n\\dfrac{13}{3} = \\dfrac{13 \\times 3}{3 \\times 3} = \\dfrac{39}{9}\n$$\n\nWe can now subtract the fractions.\n\n$$\n\\dfrac{46}{9} - \\dfrac{39}{9} = \\dfrac{\\bbox[2px,lightgray]{7}}{9}\n$$\n\nSo the missing number is $7$." 13194139533347 17592186045585 true] [17592186073479 1069 "e-13730" 13194139533347 17592186045585 true] [17592186073479 1071 "By writing both mixed numbers as improper fractions, determine the value of $4 \\, \\dfrac{1}{4} - 2 \\,\\dfrac{1}{2}$." 13194139533347 17592186045585 true] [17592186073479 1072 #uuid "63ba6ccc-1699-5a3a-9bd1-6df76bfa97ee" 13194139533347 17592186045585 true] [17592186073479 1074 "Writing\n\n$$\n4 \\, \\dfrac{1}{4}\n$$\n\nas an improper fraction, we have\n\n$$\n4 \\, \\dfrac{1}{4} = \\dfrac{(4 \\times 4) + 1}{4} = \\dfrac{17}{4}\n$$\n\nWriting\n\n$$\n2 \\, \\dfrac{1}{2}\n$$\n\nas an improper fraction, we have\n\n$$\n2 \\, \\dfrac{1}{2} = \\dfrac{(2 \\times 2) + 1}{2} = \\dfrac {5}{2}\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\dfrac{17}{4} - \\dfrac {5}{2}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $4$.\n\nTo put\n\n$$\n\\dfrac{5}{2}\n$$\n\nover a denominator of $4$, we multiply the numerator and denominator by $2$:\n\n$$\n\\dfrac{5}{2} = \\dfrac{5 \\times 2}{2 \\times 2} = \\dfrac{10}{4}\n$$\n\nWe can now subtract the fractions.\n\n$$\n\\frac{17}{4} - \\frac{10}{4} = \\frac{7}{4}\n$$" 13194139533347 17592186045585 true] [17592186073480 1069 "e-13733" 13194139533347 17592186045585 true] [17592186073480 1071 "By writing both mixed numbers as improper fractions, express $3 \\, \\dfrac{1}{8} - 1 \\,\\dfrac{1}{4}$ as a mixed number." 13194139533347 17592186045585 true] [17592186073480 1072 #uuid "38dd2bf7-809e-515f-ac23-9d688488423a" 13194139533347 17592186045585 true] [17592186073480 1074 "If we attempt to subtract the fractions by putting them over a common denominator, we get the following:\n\n$$\n\\begin{aligned}\n\\frac{1}{8} - \\frac{1}{4} &= \\frac{1}{8} - \\frac{2 \\cdot 1}{2 \\cdot 4} \\\\\n&= \\frac{1}{8} - \\frac{2}{8}\n\\end{aligned}\n$$\n\nHowever, we cannot carry out this subtraction since the first fraction is *smaller* than the second!\n\nTo get around this problem, we write each mixed number as an improper fraction.\n\n- Writing $3 \\, \\dfrac{1}{8}$ as an improper fraction, we have\n$3 \\, \\dfrac{1}{8} = \\dfrac{(3 \\times 8) + 1}{8} = \\dfrac{25}{8}$.\n- Writing $1 \\, \\dfrac{1}{4}$ as an improper fraction, we have\n$1 \\, \\dfrac{1}{4} = \\dfrac{(1 \\times 4) + 1}{4} = \\dfrac{5}{4}$.\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\dfrac{25}{8} - \\dfrac{5}{4}\n$$\n\nWe can make a common denominator of $8$. To put\n\n$$\n\\dfrac{5}{4}\n$$\n\nover a denominator of $8$, we multiply the numerator and denominator by $2$:\n\n$$\n\\dfrac{5}{4} = \\dfrac{5 \\times 2}{4 \\times 2} = \\dfrac{10}{8}\n$$\n\nWe can now subtract the fractions:\n\n$$\n\\dfrac{25}{8} - \\dfrac{10}{8} = \\dfrac{15}{8}\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\dfrac{15}{8} = 1 \\, \\textrm{R} \\, 7 = 1 \\, \\dfrac{7}{8}\n$$" 13194139533347 17592186045585 true] [17592186073481 1069 "e-13735" 13194139533347 17592186045585 true] [17592186073481 1071 "Calculate the value of $5 \\, \\dfrac{1}{8} - 2 \\,\\dfrac{1}{2}$. Express your answer as a mixed number." 13194139533347 17592186045585 true] [17592186073481 1072 #uuid "8651dc4e-2367-507b-81b4-07dfc80e664d" 13194139533347 17592186045585 true] [17592186073481 1074 "If we attempt to subtract the fractions by putting them over a common denominator, we get the following:\n\n$$\n\\begin{aligned}\n\\frac{1}{8} - \\frac{1}{2} &= \\frac{1}{8} - \\frac{4 \\cdot 1}{4 \\cdot 2} \\\\\n&= \\frac{1}{8} - \\frac{4}{8}\n\\end{aligned}\n$$\n\nHowever, we cannot carry out this subtraction since the first fraction is *smaller* than the second!\n\nTo get around this problem, we write each mixed number as an improper fraction.\n\nWriting\n\n$$\n5 \\, \\dfrac{1}{8}\n$$\n\nas an improper fraction, we have\n\n$$\n5 \\, \\dfrac{1}{8} = \\dfrac{(5 \\times 8) + 1}{8} = \\dfrac{41}{8}\n$$\n\nWriting\n\n$$\n2 \\, \\dfrac{1}{2}\n$$\n\nas an improper fraction, we have\n\n$$\n2 \\, \\dfrac{1}{2} = \\dfrac{(2 \\times 2) + 1}{2} = \\dfrac{5}{2}\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\dfrac{41}{8} - \\dfrac{5}{2}\n$$\n\nWe can make a common denominator of $8$. To put\n\n$$\n\\dfrac{5}{2}\n$$\n\nover a denominator of $8$, we multiply the numerator and denominator by $4$:\n\n$$\n\\dfrac{5}{2} = \\dfrac{5 \\times 4}{2 \\times 4} = \\dfrac{20}{8}\n$$\n\nWe can now subtract the fractions.\n\n$$\n\\dfrac{41}{8} - \\dfrac{20}{8} = \\dfrac{21}{8}\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\dfrac{21}{8} = 2 \\, \\textrm{R} \\, 5 = 2 \\, \\dfrac{5}{8}\n$$" 13194139533347 17592186045585 true] [17592186073482 1069 "e-13890" 13194139533347 17592186045585 true] [17592186073482 1071 "By rounding the dividend to the nearest whole number, estimate the value of $94.8 \\div 5$." 13194139533347 17592186045585 true] [17592186073482 1072 #uuid "145782cb-fa17-5870-a174-16552a6b236b" 13194139533347 17592186045585 true] [17592186073482 1074 "First, we round the dividend to the nearest whole number:\n$94.8 \\rightarrow 95$\n\nHence, we need to find the value of $95 \\div 5$. Computing the quotient, we get:\n\n| $1$$9$$5$$\\!\\!\\require{enclose}\\enclose{longdiv}{9 {\\:\\phantom{\\mid}} 5}$$-\\!\\!\\!\\!\\!\\!\\!$$5$$4$$5$$-\\!\\!\\!\\!\\!\\!\\!$$4$$5$$0$ |  |\n| --- | ---: |\n\nHence,\n\n$$\n95 \\div 5 = 19\n$$\n\nTherefore, $94.8 \\div 5$ is approximately equal to $19$." 13194139533347 17592186045585 true] [17592186073483 1069 "e-13893" 13194139533347 17592186045585 true] [17592186073483 1071 "Estimate $12.3 \\div 106.8$ by rounding the divisor to the nearest hundred." 13194139533347 17592186045585 true] [17592186073483 1072 #uuid "fbbf151d-cecb-5ee1-b5bb-e1843130c0cc" 13194139533347 17592186045585 true] [17592186073483 1074 "First, we round the divisor to the nearest hundred:\n$106.8 \\rightarrow 100$\n\nNow, we need to compute\n\n$$\n12.3 \\div 100\n$$\n\nThere are two zeros in $100$, so we move the decimal point two places to the left:\n\n$$\n12.3 \\rightarrow 0.123\n$$\n\nTherefore, $12.3 \\div 106.8$ is approximately equal to $0.123 \\,$." 13194139533347 17592186045585 true] [17592186073484 1069 "e-13896" 13194139533347 17592186045585 true] [17592186073484 1071 "Estimate the value of $206.6 \\div 3.43$ by rounding each number to the nearest whole number." 13194139533347 17592186045585 true] [17592186073484 1072 #uuid "7272264d-b07f-58d7-b084-24ede4cc2243" 13194139533347 17592186045585 true] [17592186073484 1074 "We round both numbers to the nearest whole number:\n$206.6\\begin{vmatrix}\\div & 3.43 \\\\ ↓ & ↓ \\\\ 207 & \\div\\end{vmatrix}3$\n\nNow, we need to find the value of\n\n$$\n207 \\div 3\n$$\n\nSo, we go through the long division procedure as usual:\n\n| $6$$9$$3$$\\!\\!\\require{enclose}\\enclose{longdiv}{2 {\\:\\phantom{\\mid}} 0 {\\:\\phantom{\\mid}} 7}$$-\\!\\!\\!\\!$$1$$8$$2$$7$$-\\!\\!\\!\\!$$2$$7$$\\fbox{0}$ |\n| --- |\n\nTherefore, $206.6 \\div 3.43$ is approximately equal to $69$." 13194139533347 17592186045585 true] [17592186073485 1069 "e-13900" 13194139533347 17592186045585 true] [17592186073485 1071 "Estimate the value of $116.8 \\div 5.15$ by rounding each number to the nearest whole number. Round your final answer to the nearest whole number." 13194139533347 17592186045585 true] [17592186073485 1072 #uuid "b223571e-3070-5474-a01c-f909c89bf36d" 13194139533347 17592186045585 true] [17592186073485 1074 "We round both numbers to the nearest whole number:\n$116.8\\begin{vmatrix}\\div & 5.15 \\\\ ↓ & ↓ \\\\ 117 & \\div\\end{vmatrix}5$\n\nNow, we need to find the value of\n$117\\div 5$.\n\nSo, we go through the long division procedure as usual:\n\n|  |  | $2$ | $3$ |\n| --- | ---: | ---: | ---: |\n| $5$ | $\\!\\!\\require{enclose}\\enclose{longdiv}{1 {\\:\\phantom{\\mid}} 1 {\\:\\phantom{\\mid}} 7}$ |  |  |\n| $-\\!\\!\\!\\!\\!\\!\\!$ | $1$ | $0$ |  |\n|  |  | $1$ | $7$ |\n|  | $-\\!\\!\\!\\!\\!$ | $1$ | $5$ |\n|  |  |  | $\\fbox{2}$ |\n\nTherefore,\n\n$$\n117 \\div 5 = 23\\,\\text{R}2\n$$\n\nThe remainder $2$ is closer to $0$ than to the divisor $5$. So, to round to the nearest whole number, we must round down:\n\n$$\n117 \\div 5 \\rightarrow 23\n$$\n\nTherefore, $116.8 \\div 5.15$ is approximately equal to $23$." 13194139533347 17592186045585 true] [17592186073486 1069 "e-14009" 13194139533347 17592186045585 true] [17592186073486 1071 "Show that the following system of equations has no solution.\n\n${4x + 2y = 4; 2x + y = 4$" 13194139533347 17592186045585 true] [17592186073486 1072 #uuid "f2105fec-c85b-5928-92e6-95ed80f1326c" 13194139533347 17592186045585 true] [17592186073486 1074 "Let's start by solving the system using elimination.\n\nNotice that if we multiply the second equation by $-2$, then we will get a $-4x$ term that can cancel with the $4x$ term in the first equation:\n\n$$\n{4x + 2y = 4; 2x + y = 4 \\mid \\mid \\cdot (-2)\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a false statement:\n\n$$\n\\begin{aligned}\n4x + 2y &= 4 \\\\\n- 4x - 2y &= -8 \\\\\n0 &= (4 - 8) \\\\\n0 &= -4\n\\end{aligned}\n$$\n\nThe statement $0=-4$ is *always false*. Therefore, we conclude that the system has *no solutions*.\n\nGeometrically, this means that the corresponding lines *do not intersect*. In other words, they are *parallel.*\n\n![](images/04/048c377f99093f493c37bc4de0363527996c8928348b43ad9c9747965f984c1f.png)" 13194139533347 17592186045585 true] [17592186073487 1069 "e-14011" 13194139533347 17592186045585 true] [17592186073487 1071 "At how many points do the lines $x - 2y = 2$ and $10y - 5x = -10$ intersect?" 13194139533347 17592186045585 true] [17592186073487 1072 #uuid "b1d34db3-7f30-5a8c-b233-fd955ac656f0" 13194139533347 17592186045585 true] [17592186073487 1074 "The number of points of intersection between the two lines is equal to the number of solutions of the corresponding system:\n\n$$\n{x - 2y = 2; 10y - 5x =-10\n$$\n\nWe will solve the system using substitution. First, we solve for $x$ in the first equation:\n\n$$\n\\begin{aligned}\nx - 2y &= 2 \\\\\nx &= 2y + 2\n\\end{aligned}\n$$\n\nThen, we substitute\n\n$$\nx=2y+2\n$$\n\ninto the second equation and solve for $y$:\n\n$$\n\\begin{aligned}\n10y - 5x &= -10 \\\\\n10y - 5(2y + 2) &= -10 \\\\\n10y - 10y - 10 &= -10 \\\\\n- 10 &= -10\n\\end{aligned}\n$$\n\nThe result is a statement that's always true. Therefore, we conclude that the system has infinitely many solutions.\n\nConsequently, the lines intersect at infinitely many points (i.e., they coincide)." 13194139533347 17592186045585 true] [17592186073488 1069 "e-14014" 13194139533347 17592186045585 true] [17592186073488 1071 "Find all points of intersection of the lines $3x+2y=2$ and $6x+4y=4$." 13194139533347 17592186045585 true] [17592186073488 1072 #uuid "ab09c3eb-6813-57c6-891b-bf20196cbe93" 13194139533347 17592186045585 true] [17592186073488 1074 "The points of intersection of the lines correspond to the solutions of the following system:\n\n$$\n{3x + 2y = 2; 6x + 4y = 4\n$$\n\nWe will solve the system using elimination. Notice that if we multiply the first equation by $-2$, then we will get a $-6x$ term that can cancel with the $6x$ term in the second equation:\n\n$$\n{3x + 2y = 2 \\mid \\mid \\cdot (-2); 6x + 4y = 4\n$$\n\nWhen we add the two equations, it turns out that both variables cancel, and we obtain a true statement:\n\n$$\n\\begin{aligned}\n-6x - 4y &= -4 \\\\\n6x + 4y &= 4 \\\\\n0 &= (-4 + 4) \\\\\n0 &= 0\n\\end{aligned}\n$$\n\nBecause we obtained a true statement, we conclude that there are infinitely many solutions to the system. Therefore, the lines have infinitely many intersection points.\n\nWe want to find an expression that represents every solution to the system. Any value of $x$ is a solution, and we can find the corresponding $y$-coordinate for each $x$-coordinate by solving one of the lines for $y$, as follows:\n\n$$\n\\begin{aligned}\n3x + 2y &= 2 \\\\\n2y &= 2 - 3x \\\\\ny &= \\frac{2 - 3x}{2} \\\\\ny &= 1 - \\frac{3}{2}x\n\\end{aligned}\n$$\n\nTherefore, the points of intersection are\n\n$$\n\\left(x,1-\\dfrac{3}{2}x \\right)\n$$\n\nwhere $x$ is any number." 13194139533347 17592186045585 true] [17592186073489 1069 "e-14356" 13194139533347 17592186045585 true] [17592186073489 1071 "Find the midpoint of the line segment shown below.\n\n![](images/0f/0f0569c1cdeb9f6631a9e26d63b83f25b283892c977c8595c57e2fbb017955c4.png)" 13194139533347 17592186045585 true] [17592186073489 1072 #uuid "68fc6ab1-0c7b-50b2-b541-137be5f5572e" 13194139533347 17592186045585 true] [17592186073489 1074 "Let $(x_m,y_m)$ be the midpoint between the given points $x_{1}, y_{1})$ and $x_{2}, y_{2})$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2}) \\\\\n&= (\\frac{-7 + 5}{2}, (3 + (-3))/(2)) \\\\\n&= (\\frac{-2}{2}, \\frac{0}{2}) \\\\\n&= (-1, 0)\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073490 1069 "e-14358" 13194139533347 17592186045585 true] [17592186073490 1071 "Find the midpoint of the line segment with endpoints $(5a,0)$ and $(-a,8b)$." 13194139533347 17592186045585 true] [17592186073490 1072 #uuid "ca03fd37-a09e-5546-95a5-12f0cd1657c6" 13194139533347 17592186045585 true] [17592186073490 1074 "Let $(x_m,y_m)$ be the midpoint between the given points $x_{1}, y_{1})$ and $x_{2}, y_{2})$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2}) \\\\\n&= ((5a + (-a))/(2), \\frac{0 + 8b}{2}) \\\\\n&= (\\frac{4a}{2}, \\frac{8b}{2}) \\\\\n&= (2a, 4b)\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073491 1069 "e-14360" 13194139533347 17592186045585 true] [17592186073491 1071 "Find $x+y$ if the midpoint of the line segment with endpoints $(-1,3)$ and $(x,y)$ is $(-2,7)$.\n\n![](images/4f/4f81075174e43d48e1a4312dfb4dcfa0f69daca5e347f7e8aedc56bd458ad4b9.png)" 13194139533347 17592186045585 true] [17592186073491 1072 #uuid "04e5232d-7f2a-5dd7-b08e-666c5cf1aba5" 13194139533347 17592186045585 true] [17592186073491 1074 "The given points are $x_{1}, y_{1})$ $x_{2}, y_{2})$ and $x_{m}, y_{m})$\n\nAccording to the midpoint formula, we have\n\n$$\n\\begin{aligned}\n(x_{m}, y_{m}) &= (\\frac{x_{1} + x_{2}}{2}, \\frac{y_{1} + y_{2}}{2}) \\\\\n(-2, 7) &= (\\frac{-1 + x}{2}, \\frac{3 + y}{2})\n\\end{aligned}\n$$\n\nEquating the corresponding $x$- and $y$-coordinates in the equation above gives us\n\n$$\n{-2 = \\frac{-1 + x}{2}; 7 = \\frac{3 + y}{2}⇒{x =-3; y = 11\n$$\n\nTherefore, the second endpoint is\n\n$$\n(x,y)=(-3,11)\n$$\n\nConsequently,\n\n$$\nx+y=8\n$$" 13194139533347 17592186045585 true] [17592186073492 1069 "e-14418" 13194139533347 17592186045585 true] [17592186073492 1071 "What division problem is represented by the model below?\n\n![](images/b2/b2e5fb40e703cb3d93f22fd315852930eaab540445e3f570e8de3dacfdc83e0b.png)" 13194139533347 17592186045585 true] [17592186073492 1072 #uuid "4fae5cf1-65c9-5217-89ec-54b40e80f293" 13194139533347 17592186045585 true] [17592186073492 1074 "We have\n\n$$\n\\dfrac{1}{4}\n$$\n\non the left and\n\n$$\n\\dfrac{1}{8}\n$$\n\non the right.\n\n![](images/78/785deacac749a6ed43e5e6a2638677e8ff9e9b58087cb4e471ea85fd50609ce6.png)\n\nThe division operation splits the shaded region on the left into $2$ equal parts. So the shaded part on the left is $2$ times larger than the shaded part on the right.\n\nTherefore, the division problem shown is:\n\n$$\n\\dfrac{1}{4} \\div 2 = \\dfrac{1}{8}\n$$" 13194139533347 17592186045585 true] [17592186073493 1069 "e-14420" 13194139533347 17592186045585 true] [17592186073493 1071 "What number is missing from the division problem below?\n\n![](images/cf/cf2500f82f337e5635a5ca9854579e3b883f42cde4598d4324c94364bf998a0d.png)" 13194139533347 17592186045585 true] [17592186073493 1072 #uuid "9cd2d717-01de-5319-8759-2990e79d64ad" 13194139533347 17592186045585 true] [17592186073493 1074 "We have\n\n$$\n\\dfrac{1}{3}\n$$\n\non the left and\n\n$$\n\\dfrac{1}{15}\n$$\n\non the right.\n\n![](images/ed/ed5517a9242aed1c5b521ca07772dacbb7c96a73c69d4d9c6214a098742358e2.png)\n\nThe division operation splits the shaded region on the left into $5$ equal parts. So the shaded part on the left is $5$ times larger than the shaded part on the right.\n\nTherefore, the division problem shown is:\n\n$$\n\\dfrac{1}{3} \\div {\\color{blue}{5}} = \\dfrac{1}{15}\n$$\n\nSo, the missing number is $\\color{blue}5$." 13194139533347 17592186045585 true] [17592186073494 1069 "e-14423" 13194139533347 17592186045585 true] [17592186073494 1071 "What picture is missing from the division model below?\n\n![](images/9c/9cc5d672cb3c12ceb7704f5136e9b7ecae61d11a9418acf3b8e1cbb9e8f044f7.png)" 13194139533347 17592186045585 true] [17592186073494 1072 #uuid "62d9f262-e419-5a9d-a5cb-741c34613570" 13194139533347 17592186045585 true] [17592186073494 1074 "Notice that in the model, we have\n\n$$\n\\dfrac{1}{3}\n$$\n\non the left.\n\nSince we need to divide by $\\color{blue}3$, we split the whole into $\\color{blue}3$ equal parts horizontally.\n\n![](images/30/30f9bbc604d35a9a15e1418c0cf80eca87fe4d704287c15fb8de7426eb9e3de9.png)\n\nFrom the picture on the right, we obtain that the shaded part represents\n\n$$\n\\dfrac{1}{9}\n$$\n\nof the whole.\n\nSo, the missing picture is:\n\n![](images/95/951a4bc0607c53aa0c5ed9cebe664b630acf226a6f9844fd9d1b8e6ae952d0ed.png)" 13194139533347 17592186045585 true] [17592186073495 1069 "e-14424" 13194139533347 17592186045585 true] [17592186073495 1071 "Use the model below to calculate $\\dfrac{1}{4} \\div 4$.\n\n![](images/8e/8eccf163bffabb43593188590a1f995544f3d1ac0aebcdd87dce638b230f8165.png)" 13194139533347 17592186045585 true] [17592186073495 1072 #uuid "c6e1860a-9fe5-559c-8a19-6ed98335659b" 13194139533347 17592186045585 true] [17592186073495 1074 "Since we need to divide by $\\color{blue}4$, we split the whole into $\\color{blue}4$ equal parts horizontally.\n\n![](images/a3/a34a3fb198ef2ea79f8baf8f0acbdbdc179c6259c614824315d3d96e5ea4e921.png)\n\nFrom the picture on the right, we obtain that the shaded part represents\n\n$$\n\\dfrac{1}{16}\n$$\n\nof the whole.\n\nTherefore,\n\n$$\n\\dfrac{1}{4} \\div 4 = \\dfrac{1}{16}\\,\n$$" 13194139533347 17592186045585 true] [17592186073496 1069 "e-14428" 13194139533347 17592186045585 true] [17592186073496 1071 "Use the model below to find the value of $2 - \\dfrac{1}{3}$ as an improper fraction.\n\n![](images/be/be2d9f3f1964bbaf26d9ecbc76940ffda49bd6b1988b59ec4bb18e394dec88ed.png)" 13194139533347 17592186045585 true] [17592186073496 1072 #uuid "b2cf730c-cc27-576c-920c-6d620ec257cb" 13194139533347 17592186045585 true] [17592186073496 1074 "All three shapes are already split into $\\color{red}3$ equal parts, and we have\n\n$$\n3+3-1 = {\\color{blue}{5}}\n$$\n\nparts in total.\n\nTherefore,\n\n$$\n2 - \\dfrac{1}{3} = \\dfrac{{\\color{blue}5}}{{\\color{red}3}}\n$$" 13194139533347 17592186045585 true] [17592186073497 1069 "e-14433" 13194139533347 17592186045585 true] [17592186073497 1071 "![](images/a4/a4491897e98f32e3ebc352f7012541f3aec062299ab8ea788210aba1dd2fbd7b.png)\n\nUse the model above to determine the missing number in the statement below.\n\n$0$" 13194139533347 17592186045585 true] [17592186073497 1072 #uuid "f4e26728-c427-5488-b60e-53a2f932ebf0" 13194139533347 17592186045585 true] [17592186073497 1074 "The shape on the right is split into $\\color{red}5$ equal parts. We can split the first and second shapes into $\\color{red}5$ equal parts as follows:\n\n![](images/2d/2d6a9f12abdbdc368f5f83c3c01eb3848f210a23b8afd9f537a75ad0193fb0c8.png)\n\nWe have\n\n$$\n5 + 5 - 3=\\color{blue}7\n$$\n\nshaded parts in total.\n\nTherefore,\n\n$$\n2 - \\dfrac{3}{5} = \\dfrac{\\color{blue}7}{5}\n$$\n\nSo, the missing number is $\\color{blue}7$." 13194139533347 17592186045585 true] [17592186073498 1069 "e-14435" 13194139533347 17592186045585 true] [17592186073498 1071 "Use a visual fraction model to find the value of $2 - \\dfrac{1}{6}$ as an improper fraction." 13194139533347 17592186045585 true] [17592186073498 1072 #uuid "ed655f33-1e74-552b-ab81-98a1285263e9" 13194139533347 17592186045585 true] [17592186073498 1074 "Writing\n\n$$\n2 - \\dfrac{1}{6}\n$$\n\nas a visual fraction model, we get:\n\n![](images/0e/0e3072e96ed0ec37f743065056ecab6b727b0cdd50086f5c74fa6722e67ce859.png)\n\nThe shape on the right is split into $\\color{red}6$ equal parts. We can split the other two shapes into $\\color{red}6$ equal parts as follows:\n\n![](images/97/970fc3a544d0690f0ac52ed4c4b200a541441ca640781eda20654ba1905c0229.png)\n\nWe have\n\n$$\n6 + 6 - 1 = \\color{blue}11\n$$\n\nshaded parts in total.\n\nTherefore,\n\n$$\n2 - \\dfrac{1}{6} = \\dfrac{\\color{blue}11}{\\color{red}6}\n$$" 13194139533347 17592186045585 true] [17592186073499 1069 "e-14481" 13194139533347 17592186045585 true] [17592186073499 1071 "What number is missing from the area model below?\n\n![](images/e0/e09bbf559f97a7c18bb8757f21c41dccdea24aad3bdaf4bc18ed5888625558e2.png)" 13194139533347 17592186045585 true] [17592186073499 1072 #uuid "1695dc55-3f64-51e4-9b0e-63c6c68a0149" 13194139533347 17592186045585 true] [17592186073499 1074 "The area of the rectangle can be found by multiplying the lengths of the sides:\n\n$$\n\\dfrac{2}{5} \\times \\dfrac{1}{4}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\n\\frac{2}{5} \\cdot \\frac{1}{4} &= \\frac{2}{4} \\cdot \\frac{1}{5} \\\\\n&= \\frac{1}{2} \\cdot \\frac{1}{5} \\\\\n&= \\frac{1 \\cdot 1}{2 \\cdot 5} \\\\\n&= \\frac{1}{[math]\\color{blue}10[/math]}\n\\end{aligned}\n$$\n\nSo, the missing number is $10$." 13194139533347 17592186045585 true] [17592186073500 1069 "e-14483" 13194139533347 17592186045585 true] [17592186073500 1071 "What number is missing from the area model below?\n\n![](images/d2/d268fb561f0d2f1792230a548e6e472865e453044617557b3b9a8aa789019265.png)" 13194139533347 17592186045585 true] [17592186073500 1072 #uuid "1998fe7b-0213-54d8-952f-9097e1754576" 13194139533347 17592186045585 true] [17592186073500 1074 "The area of the rectangle can be found by multiplying the lengths of the sides:\n\n$$\n\\dfrac{5}{7} \\times \\dfrac{9}{5}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\n\\frac{5}{7} \\cdot \\frac{9}{5} &= \\frac{5}{5} \\cdot \\frac{9}{7} \\\\\n&= 1 \\cdot \\frac{9}{7} \\\\\n&= \\frac{1 \\cdot 9}{7} \\\\\n&= \\frac{[math]\\color{blue}9[/math]}{7}\n\\end{aligned}\n$$\n\nSo, the missing number is $9$." 13194139533347 17592186045585 true] [17592186073501 1069 "e-14484" 13194139533347 17592186045585 true] [17592186073501 1071 "![](images/4f/4f5bfdd38a8c02510e86279ac548a2a6b889f9eb33a8ef8c273fd2e384e54b72.png)\n\nWhat multiplication problem is represented by the model above?" 13194139533347 17592186045585 true] [17592186073501 1072 #uuid "f26ed088-6f0b-56b8-9027-9b9af4bcf415" 13194139533347 17592186045585 true] [17592186073501 1074 "We have\n\n$$\n\\dfrac{1}{3}\n$$\n\non the left and\n\n$$\n\\dfrac{1}{6}\n$$\n\non the right.\n\n![](images/b4/b43d5a0e0a44e6d418a901dc9fa806079b1b9425fc111640439e4338f8bf0d84.png)\n\nTherefore, the multiplication problem shown is:\n\n$$\n\\dfrac{1}{3} \\times \\dfrac{1}{2} = \\dfrac{1}{6}\n$$" 13194139533347 17592186045585 true] [17592186073502 1069 "e-14485" 13194139533347 17592186045585 true] [17592186073502 1071 "What number is missing from the area model below?\n\n![](images/f9/f90cfc8b6b2d4e48abb715f8a84f06d41fb53ff7232d8c178ecee87b7b04af21.png)" 13194139533347 17592186045585 true] [17592186073502 1072 #uuid "b1f1de5c-a97b-5008-aea2-91cf2a6a1dd8" 13194139533347 17592186045585 true] [17592186073502 1074 "First, we write\n\n$$\n2\\,\\dfrac{1}{2}\n$$\n\nas an improper fraction:\n\n$$\n2\\,\\dfrac{1}{2} = \\dfrac{(2\\times 2)+1}{2} = \\dfrac{5}{2}\n$$\n\nThe area of the rectangle can be found by multiplying the lengths of the sides:\n\n$$\n\\dfrac{4}{7} \\times \\dfrac{5}{2}\n$$\n\nWe can simplify this product by swapping the denominators:\n\n$$\n\\begin{aligned}\n\\frac{4}{7} \\cdot \\frac{5}{2} &= \\frac{4}{2} \\cdot \\frac{5}{7} \\\\\n&= 2 \\cdot \\frac{5}{7} \\\\\n&= \\frac{2 \\cdot 5}{7} \\\\\n&= \\frac{10}{[math]\\color{blue}\\,7\\,[/math]}\n\\end{aligned}\n$$\n\nSo, the missing number is $7$." 13194139533347 17592186045585 true] [17592186073503 1069 "e-14488" 13194139533347 17592186045585 true] [17592186073503 1071 "The breadth of a rectangular park is $\\dfrac 3 4\\, \\text{km}$ and its length is $1\\, \\dfrac 12 \\, \\text{km}$. Using the model below, find the area of the park, expressed as an improper fraction.\n\n![](images/c8/c83c8476c89d07a5270062ebf029dae99469a1506320a6e3c72ecba886d7a7ad.png)" 13194139533347 17592186045585 true] [17592186073503 1072 #uuid "e04f66f1-70a4-54d0-b53e-848cf0f1804b" 13194139533347 17592186045585 true] [17592186073503 1074 "To find the area, we need to multiply the lengths of the sides.\n\nFirst we write\n\n$$\n1\\,\\dfrac{1}{2}\n$$\n\nas an improper fraction:\n\n$$\n1\\,\\dfrac{1}{2} = \\dfrac{(1\\times2)+1}{2} = \\dfrac{3}{2}\n$$\n\nNow, we find the area of the park by multiplying the lengths of its sides:\n\n$$\n\\dfrac{3}{4} \\times \\dfrac{3}{2} = \\dfrac{3 \\times 3}{4 \\times 2} = \\dfrac{9}{8}\n$$\n\nSo, the area of the park is\n\n$$\n\\dfrac{9}{8}\n$$\n\nsquare kilometers." 13194139533347 17592186045585 true] [17592186073504 1069 "e-14490" 13194139533347 17592186045585 true] [17592186073504 1071 "What number is missing from the multiplication problem below?\n\n![](images/69/69f859c61c693f7ece01fef8f829fdc772acae77e90be97b7b093fb9849acc95.png)" 13194139533347 17592186045585 true] [17592186073504 1072 #uuid "a653f45f-e638-5646-a55c-13b319e511b0" 13194139533347 17592186045585 true] [17592186073504 1074 "We have\n\n$$\n\\dfrac{1}{2}\n$$\n\non the left and\n\n$$\n\\dfrac{1}{6}\n$$\n\non the right.\n\n![](images/dc/dcb89325ddd68043c9edf2f595a7a7d89b3ba078bbb1805af7bea58867f627b6.png)\n\nThe shape on the right-hand side is split into $\\color{blue}3$ equal parts by horizontal lines. So, the shaded part on the left is $\\color{blue}3$ times larger than the shaded part on the right.\n\nTherefore, the multiplication problem shown is:\n\n$$\n\\dfrac{1}{2} \\times \\dfrac{1}{\\color{blue}{3}} = \\dfrac{1}{6}\n$$\n\nSo, the missing number is $\\color{blue}3$." 13194139533347 17592186045585 true] [17592186073505 1069 "e-14491" 13194139533347 17592186045585 true] [17592186073505 1071 "What picture is missing from the multiplication model below?\n\n![](images/39/39c8668bd4bf5309b708769a99d9d3fa2184f0937411d437de8a1195853e5118.png)" 13194139533347 17592186045585 true] [17592186073505 1072 #uuid "9bc02e5b-5028-5aa1-85d8-c1217b425c36" 13194139533347 17592186045585 true] [17592186073505 1074 "In the model, we have\n\n$$\n\\dfrac{1}{4}\n$$\n\non the left.\n\nSince we are multiplying by\n\n$$\n\\dfrac{1}{\\color{blue}5}\n$$\n\n, we need to split the whole into $\\color{blue}5$ equal parts horizontally.\n\n![](images/65/6584c694fbbc990dfa3b58a19545d3deb9889f162da6e02a9820310a190ae04e.png)\n\nFrom the picture on the right, we obtain that the shaded part represents\n\n$$\n\\dfrac{1}{20}\n$$\n\nof the whole.\n\nThe missing picture is:\n\n![](images/e3/e349233ebb5e3927f0d4bda98cb2470c1f17574a522d2f4b9cbddaf365fe946d.png)" 13194139533347 17592186045585 true] [17592186073506 1069 "e-14492" 13194139533347 17592186045585 true] [17592186073506 1071 "![](images/82/82439d51448a442dede4b3965ecbbd2f2daa7b2365ea75c80951478fd10af65c.png)\n\nUse the model above to calculate $\\dfrac{4}{5} \\times \\dfrac{1}{3}$." 13194139533347 17592186045585 true] [17592186073506 1072 #uuid "4730b433-9614-58ea-a452-e404c237ba3b" 13194139533347 17592186045585 true] [17592186073506 1074 "Since we need to multiply by\n\n$$\n\\dfrac{1}{\\color{blue}3}\n$$\n\n, we split the whole into $\\color{blue}3$ equal parts horizontally.\n\n![](images/a9/a95b378064e6ec2ed15637fd05ea49e5f988bfb30d8ae788a7b2086ff920a65f.png)\n\nFrom the picture on the right, we obtain that the shaded part represents\n\n$$\n\\dfrac{4}{15}\n$$\n\nof the whole.\n\nTherefore,\n\n$$\n\\dfrac{4}{5} \\times \\dfrac{1}{3} = \\dfrac{4}{15}\n$$" 13194139533347 17592186045585 true] [17592186073507 1069 "e-14509" 13194139533347 17592186045585 true] [17592186073507 1071 "$8 + \\dfrac{1}{4}$ is equivalent to which mixed number?" 13194139533347 17592186045585 true] [17592186073507 1072 #uuid "081630fd-f068-5eee-8d6f-89f871daabf7" 13194139533347 17592186045585 true] [17592186073507 1074 "The number $8$ is a whole number, and\n\n$$\n\\dfrac{1}{4}\n$$\n\nis a proper fraction. Therefore, their sum is a mixed number:\n\n$$\n8 + \\dfrac{1}{4} = 8 \\, \\dfrac{1}{4}\n$$" 13194139533347 17592186045585 true] [17592186073508 1069 "e-14511" 13194139533347 17592186045585 true] [17592186073508 1071 "Sophia walked $\\dfrac{5}{6}$ of a mile and then ran another $2$ miles. Expressing the result as an improper fraction, how many miles did Sophia travel?" 13194139533347 17592186045585 true] [17592186073508 1072 #uuid "ba9e10b8-4601-5f2a-8681-0ab478bdb081" 13194139533347 17592186045585 true] [17592186073508 1074 "To find out how many miles Sophia traveled, we have to calculate the sum:\n\n$$\n\\dfrac{5}{6} + 2\n$$\n\nTo add\n\n$$\n\\dfrac{5}{\\color{blue}{6}}\n$$\n\nand $2$, we need to express the whole number $2$ as an equivalent fraction with a denominator of ${\\color{blue}{6}}$.\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n\\dfrac{2}{1}\n$$\n\nThen, we put this fraction over a denominator of $\\color{blue}6$ by multiplying the numerator and denominator by ${\\color{blue}{6}}$:\n\n$$\n\\dfrac{2 \\times {\\color{blue}{6}}}{1 \\times{\\color{blue}{6}}} = \\dfrac{12}{6}\n$$\n\nSo now, we have to find the following sum:\n\n$$\n\\dfrac{5}{6} + \\dfrac{12}{6}\n$$\n\nTo add two fractions with like denominators, we add the numerators and keep the denominators the same:\n\n$$\n\\frac{5}{6} + \\frac{12}{6} = \\frac{5 + 12}{6} = \\frac{17}{6}\n$$\n\nTherefore, Sophia traveled\n\n$$\n\\dfrac{17}{6}\n$$\n\nmiles." 13194139533347 17592186045585 true] [17592186073509 1069 "e-14515" 13194139533347 17592186045585 true] [17592186073509 1071 "Tom and Margaret went to a fruit store to buy apples and pears. Tom bought $3$ kilograms of apples while Margaret bought $\\dfrac{11}{3}$ kilograms of pears. Expressing the result as a mixed number, how many kilograms of fruit did they buy together?" 13194139533347 17592186045585 true] [17592186073509 1072 #uuid "6247fce4-259e-5569-bbdf-b88cc1ea9482" 13194139533347 17592186045585 true] [17592186073509 1074 "To know how many kilograms they bought, we have to calculate the sum:\n\n$$\n3 + \\dfrac{11}{3}\n$$\n\nTo add\n\n$$\n3 + \\dfrac{11}{\\color{blue}{3}}\n$$\n\n, we need to express the whole number $3$ as an equivalent fraction with a denominator of ${\\color{blue}{3}}$.\n\nFirst, we write $3$ as an improper fraction:\n\n$$\n\\dfrac{3}{1}\n$$\n\nThen, we put this fraction over a denominator of $\\color{blue}3$ by multiplying the numerator and denominator by ${\\color{blue}{3}}$:\n\n$$\n\\dfrac{3 \\times {\\color{blue}{3}}}{1 \\times{\\color{blue}{3}}} = \\dfrac{9}{3}\n$$\n\nSo now, we have to find the following sum:\n\n$$\n\\dfrac{9}{3} + \\dfrac{11}{3}\n$$\n\nTo add two fractions with like denominators, we add the numerators and keep the denominators the same.\n\n$$\n\\frac{9}{3} + \\frac{11}{3} = \\frac{9 + 11}{3} = \\frac{20}{3}\n$$\n\nFinally, we convert this to a mixed number:\n\n$$\n20 \\div 3 = 6 \\, \\textrm{R} \\, 2 = 6 \\, \\dfrac{2}{3}\n$$\n\nThus, Tom and Margaret bought\n\n$$\n6 \\, \\dfrac{2}{3}\n$$\n\nkilograms of fruit." 13194139533347 17592186045585 true] [17592186073510 1069 "e-14535" 13194139533347 17592186045585 true] [17592186073510 1071 "Use the model below to find the value of $2+\\dfrac{1}{3}$ as an improper fraction.\n\n![](images/04/04e37e42a57d1e91ab22b8a08134bd37be77d6e8f3ed0cd9c9e89dafeba57a4b.png)" 13194139533347 17592186045585 true] [17592186073510 1072 #uuid "3d1dc1f5-c9d6-5bbc-8dad-e50b6a3a0837" 13194139533347 17592186045585 true] [17592186073510 1074 "All three shapes are split into $\\color{red}3$ equal parts, and we have\n\n$$\n3+3+1 = {\\color{blue}{7}}\n$$\n\nparts in total.\n\nTherefore,\n\n$$\n2 + \\dfrac 1 3 = \\dfrac{{\\color{blue}7}}{{\\color{red}3}}\n$$" 13194139533347 17592186045585 true] [17592186073511 1069 "e-14538" 13194139533347 17592186045585 true] [17592186073511 1071 "![](images/76/76a30d70a6c69ce4375e108f9a22d8bc8bbe2f36077342a46dcfb226bd9b58cd.png)\n\nUse the model above to determine the missing number in the following statement:\n$0$" 13194139533347 17592186045585 true] [17592186073511 1072 #uuid "4e2f0150-b229-54ae-80f1-933807b51228" 13194139533347 17592186045585 true] [17592186073511 1074 "The first shape is split into $\\color{red}6$ equal parts. We can split the second shape into $\\color{red}6$ equal parts, as follows:\n\n![](images/e5/e54ea4c59df9e61d46fdb28aac00bfdc4068a716bcfb0a063dce7f88ff5bf7bc.png)\n\nThere are\n\n$$\n5+6 = \\color{blue}11\n$$\n\nshaded parts in total. Therefore, the sum of the two fractions is\n\n$$\n\\dfrac{{\\color{blue}{11}}}{\\color{red}{6}}\n$$\n\nHence, the missing number is $\\color{blue}11$." 13194139533347 17592186045585 true] [17592186073512 1069 "e-14541" 13194139533347 17592186045585 true] [17592186073512 1071 "Use a visual fraction model to find the value of $2+\\dfrac 7 {8}$ as an improper fraction." 13194139533347 17592186045585 true] [17592186073512 1072 #uuid "1bf7aca9-8db8-551d-98e6-d57cb789ed61" 13194139533347 17592186045585 true] [17592186073512 1074 "Writing\n\n$$\n2+\\dfrac 7 {8}\n$$\n\nas a visual fraction model, we get the following:\n\n![](images/e2/e23b3ad4bdaad2b68382b72c72d0ec5b0af985f9aeb616792ff99daee984d0f3.png)\n\nThe shape on the right is split into $\\color{red}8$ equal parts. We can split the first and second shapes into $\\color{red}8$ equal parts as follows:\n\n![](images/fc/fcc8eb879dae196553cb682aeb1a0332c7ccf091c344b17ac2067aa6725ff1e8.png)\n\nThere are\n\n$$\n8+8+7 = \\color{blue}23\n$$\n\nshaded parts in total. Therefore, their sum is\n\n$$\n\\dfrac{{\\color{blue}{23}}}{\\color{red}{8}}\n$$" 13194139533347 17592186045585 true] [17592186073513 1069 "e-14725" 13194139533347 17592186045585 true] [17592186073513 1071 "![](images/1a/1afba9a36c6fd04fecfd50877181380776e13a83422697de4a39d71381f09aff.png)\n\nFind the value of $x$ in the triangle above." 13194139533347 17592186045585 true] [17592186073513 1072 #uuid "ed0361cf-cec0-5ec2-baab-e0f558619191" 13194139533347 17592186045585 true] [17592186073513 1074 "Since the sum of the measures of the interior angles in any triangle is equal to $180^\\circ$, we have\n\n$$\n\\begin{aligned}\nm∠A + m∠B + m∠C &= 180^{∘} \\\\\n36^{∘} + 112^{∘} + x &= 180^{∘} \\\\\n148^{∘} + x &= 180^{∘} \\\\\nx &= 32^{∘}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073514 1069 "e-14727" 13194139533347 17592186045585 true] [17592186073514 1071 "![](images/e4/e43daa39b169c8ba29c21dd33e7a7fab1e92c7c78eafbd1021971e1883f6c9f8.png)\n\nFind the measure of $\\angle C$." 13194139533347 17592186045585 true] [17592186073514 1072 #uuid "bf72c879-105c-5416-8dbd-7976228f0b4b" 13194139533347 17592186045585 true] [17592186073514 1074 "Since the sum of the measures of the interior angles of a triangle is $180^\\circ$, we have\n\n$$\n\\begin{aligned}\n3z + 4z + 40^{∘} &= 180^{∘} \\\\\n7z + 40^{∘} &= 180^{∘} \\\\\n7z &= 140^{∘} \\\\\nz &= 20^{∘}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nm∠C &= 4z \\\\\n&= 4(20^{∘}) \\\\\n&= 80^{∘}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073515 1069 "e-14728" 13194139533347 17592186045585 true] [17592186073515 1071 "Consider a triangle $\\triangle ABC$, where $m\\angle{A} = 55^\\circ$, $m\\angle B = x + 10^\\circ$, and $m\\angle C = 3x - 5^\\circ$. Find the value of $x$." 13194139533347 17592186045585 true] [17592186073515 1072 #uuid "8200fc85-afcc-5fb9-b942-cedbc87c739b" 13194139533347 17592186045585 true] [17592186073515 1074 "The sum of the measures of the interior angles must be $180^\\circ$. Therefore,\n\n$$\n\\begin{aligned}\n55^{∘} + (x + 10^{∘}) + (3x - 5^{∘}) &= 180^{∘} \\\\\n60^{∘} + 4x &= 180^{∘} \\\\\n4x &= 120^{∘} \\\\\nx &= 30^{∘}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073516 1069 "e-15572" 13194139533347 17592186045585 true] [17592186073516 1071 "![](images/1a/1a24187f280eb99640c3d1bfae3b7fe873383f04c2c492e7873a40de16a9560b.png)\n\nFind the measure of angle $C$ given that $m\\angle{A} = m\\angle{B}$." 13194139533347 17592186045585 true] [17592186073516 1072 #uuid "b015f8d6-ac1b-537d-a673-839fc7418f71" 13194139533347 17592186045585 true] [17592186073516 1074 "Using\n\n$$\nm\\angle{A} = m\\angle{B}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\nm∠A &= m∠B \\\\\n3x - 27^{∘} &= 2x \\\\\nx &= 27^{∘}\n\\end{aligned}\n$$\n\nConsequently, substituting $x=27^\\circ$ in the expression for $m\\angle B$, we get\n\n$$\nm\\angle{B}=2(27^\\circ)=54^\\circ\n$$\n\nNow, we can find $m\\angle C$ using the fact that the internal angles of any triangle sum to $180^\\circ$:\n\n$$\n\\begin{aligned}\nm∠A + m∠B + m∠C &= 180^{∘} \\\\\n2m∠B + m∠C &= 180^{∘} \\\\\n2 \\cdot 54^{∘} + m∠C &= 180^{∘} \\\\\n108^{∘} + m∠C &= 180^{∘} \\\\\nm∠C &= 72^{∘}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073517 1069 "e-15687" 13194139533347 17592186045585 true] [17592186073517 1071 "Consider the following true statement.\n\n$\\qquad$ Since $2 \\cdot 5 = 10$ and $10 = 4+6$, we have $2 \\cdot 5 = 4+6$.\n\nWhich property of equality makes this statement true?" 13194139533347 17592186045585 true] [17592186073517 1072 #uuid "5ea17b43-9d4c-5fe8-a2a9-dbb3e272b907" 13194139533347 17592186045585 true] [17592186073517 1074 "The following properties are valid for all integers $a, b$, and $c{:}$\n\n- The *reflexive* property of equality:\n$a = a$\nThis states that every number equals itself.\n- The *symmetric* property of equality:\n$\\textrm{If}\\: a = b, \\textrm{then}\\: b=a$\nThis states that if the first number equals the second, the second must equal the first.\n- The *transitive* property of equality:\n$\\textrm{If}\\: a = b \\:\\textrm{and}\\: b=c,\\textrm{then}\\:a=c$\nThis states that if the first number equals the second and the second equals the third, the first must equal the third.\n\nWe can rewrite the given sentence as follows:\n\n> If $2 \\cdot 5 = 10$ and $10 = 4+6$, then $2 \\cdot 5 = 4+6$.\n\nTherefore, this statement is true by the $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{transitive}}$ property of equality." 13194139533347 17592186045585 true] [17592186073518 1069 "e-15688" 13194139533347 17592186045585 true] [17592186073518 1071 "![](images/ed/ede04322d50034c955e6c954d99bfbfc1f13e7b7e40fd9eb12f660e995e018a0.png)\n\nConsider the following true statement.\n\n$\\qquad$ Since $\\overline{AB} \\cong \\overline{AC}$, we have $\\overline{AC} \\cong \\overline{AB}$.\n\nWhich property of congruence makes this statement true?" 13194139533347 17592186045585 true] [17592186073518 1072 #uuid "90b4737c-9d93-5d6c-b4d1-40b4291f9b49" 13194139533347 17592186045585 true] [17592186073518 1074 "The following properties are valid for all segments $a, b$, and $c{:}$\n\n- The *reflexive* property of congruence:\n$a \\cong a$\nThis states that every segment is congruent to itself.\n- The *symmetric* property of congruence:\n$\\textrm{If}\\: a \\cong b, \\textrm{then}\\: b \\cong a$\nThis states that if the first segment is congruent to the second, the second must be congruent to the first.\n- The *transitive* property of congruence:\n$\\textrm{If}\\: a \\cong b \\:\\textrm{and}\\: b \\cong c,\\textrm{then}\\:a \\cong c$\nThis states that if the first segment is congruent to the second, and the second is congruent to the third, the first must be congruent to the third.\n\nWe can rewrite the given sentence as follows:\n\n> If $\\overline{AB} \\cong \\overline{AC}$, then $\\overline{AC} \\cong \\overline{AB}$.\n\nTherefore, this statement is true by the $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{symmetric}}$ property of congruence." 13194139533347 17592186045585 true] [17592186073519 1069 "e-15689" 13194139533347 17592186045585 true] [17592186073519 1071 "![](images/c9/c9264ea59c02f9c4afb6da803100856bea78ca9e387072f0871af6267a36b127.png)\n\nConsider the following true statement.\n\n$\\qquad$ Since $\\angle ADC \\cong\\angle BDC$, we have $\\angle BDC \\cong \\angle ADC$.\n\nWhich property of congruence makes this statement true?" 13194139533347 17592186045585 true] [17592186073519 1072 #uuid "c64c4d74-afb7-5099-9134-ce888be9e2db" 13194139533347 17592186045585 true] [17592186073519 1074 "The following properties are valid for all angles $\\angle a, \\angle b$, and $\\angle c\\,{:}$\n\n- The *reflexive* property of congruence:\n$\\angle a \\cong \\angle a$\nThis states that every angle is congruent to itself.\n- The *symmetric* property of congruence:\n$\\textrm{If}\\: \\angle a \\cong \\angle b, \\textrm{then}\\: \\angle b \\cong \\angle a$\nThis states that if the first angle is congruent to the second, the second must be congruent to the first.\n- The *transitive* property of congruence:\n$\\textrm{If}\\: \\angle a \\cong \\angle b \\:\\textrm{and}\\: \\angle b \\cong \\angle c,\\textrm{then}\\:\\angle a \\cong \\angle c$\nThis states that if the first angle is congruent to the second, and the second is congruent to the third, the first must be congruent to the third.\n\nWe can rewrite the given sentence as follows:\n\n> If $\\angle ADC \\cong\\angle BDC$, then $\\angle BDC \\cong \\angle ADC$.\n\nTherefore, this statement is true by the $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{symmetric}}$ property of congruence." 13194139533347 17592186045585 true] [17592186073520 1069 "e-15839" 13194139533347 17592186045585 true] [17592186073520 1071 "![](images/bd/bdb8f7a69cc9270c2c69929af3392b5587768748fb437604b6696135f516aca1.png)\n\nIn the diagram above, $\\overline{AH} \\perp \\overline{BC}$, and $\\overline{AB} \\cong \\overline{AC}$.\n\nConsider the following statement:\n\n> *The angles $\\angle {B}$ and $\\angle {C}$ are congruent.*\n\nThe table below gives the proof of the statement. Select the correct options in the table and thus complete the proof.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\angle{AHB}$ and $\\angle{AHC}$ are right angles |  |\n| 2 | $\\triangle{AHB}$ and $\\triangle{AHC}$ are right triangles |  |\n| 3 | $\\overline{AB} \\cong \\overline{AC}$ |  |\n| 4 | $\\overline{AH} \\cong \\overline{AH}$ |  |\n| 5 | $\\triangle{AHB} \\cong \\triangle{AHC}$ |  |\n| 6 | $\\angle B \\cong \\angle C$ |  |" 13194139533347 17592186045585 true] [17592186073520 1072 #uuid "17d142d9-3d52-5c8f-a485-28f01a27075a" 13194139533347 17592186045585 true] [17592186073520 1074 "|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\angle{AHB}$ and $\\angle{AHC}$ are right angles | $\\bbox[3pt,Gainsboro]{\\color{blue}\\overline{AH} \\perp \\overline{BC}}$ |\n| 2 | $\\triangle{AHB}$ and $\\triangle{AHC}$ are right triangles | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of a right triangle}}$ |\n| 3 | $\\overline{AB} \\cong \\overline{AC}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Given}}$ |\n| 4 | $\\overline{AH} \\cong \\overline{AH}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Reflexive property of congruence}}$ |\n| 5 | $\\triangle{AHB} \\cong \\triangle{AHC}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{HL criterion}}$ |\n| 6 | $\\angle B \\cong \\angle C$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{CPCTC}}$ |\n\nLet's examine each row in turn.\n\n1. We are given that $\\overline{AH} \\perp \\overline{BC}$. Therefore, $\\angle{AHB}$ and $\\angle{AHC}$ are right angles by the definition of perpendicular lines.\n2. By the definition of a right triangle, we have from row 1 that $\\triangle{AHB}$ and $\\triangle{AHC}$ are right triangles.\n3. We are given that $\\overline{AB} \\cong \\overline{AC}$ in the question stem.\n4. The reflexive property of congruence states that every segment is congruent to itself. Therefore, $\\overline{AH} \\cong \\overline{AH}$.\n5. From rows 2, 3, and 4, we have that $\\triangle{ABH}$ and $\\triangle{ACH}$ are right triangles, and\n$\\overline{AB} \\cong \\overline{AC}, \\qquad \\overline{AH} \\cong \\overline{AH}$.\nTherefore, $\\triangle{AHB} \\cong \\triangle{AHC}$ by the HL criterion.\n6. From row 5, we have $\\triangle AH{\\color{blue}B} \\cong \\triangle AH{\\color{blue}C}$. Therefore, $\\angle {\\color{blue}B} \\cong \\angle {\\color{blue}C}$ by CPCTC." 13194139533347 17592186045585 true] [17592186073521 1069 "e-15840" 13194139533347 17592186045585 true] [17592186073521 1071 "![](images/82/820871c183af4d5455807ba599aad2f3efeecf3b77a98609434bcb3c1763696a.png)\n\nIn the diagram above, $M$ is the midpoint of $\\overline{BC}$.\n\nConsider the following statement:\n\n> *The angles $\\angle {BAM}$ and $\\angle {CAM}$ are congruent.*\n\nThe table below gives the proof of the statement. Select the correct options in the table and thus complete the proof.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $BM=CM$ | Definition of a midpoint |\n| 2 | $\\overline{BM} \\cong \\overline{CM}$ |  |\n| 3 | $AB=6\\,\\textrm{cm}$ | Given |\n| 4 | $AC=6\\,\\textrm{cm}$ | Given |\n| 5 | $AB=AC$ |  |\n| 6 | $\\overline{AB} \\cong \\overline{AC}$ | Definition of congruent segments |\n| 7 | $\\overline{AM} \\cong \\overline{AM}$ |  |\n| 8 | $\\triangle ABM \\cong \\triangle ACM$ |  |\n| 9 | $\\angle {BAM}\\cong \\angle {CAM}$ | CPCTC |" 13194139533347 17592186045585 true] [17592186073521 1072 #uuid "e8f60892-d1af-5c76-994a-b3558bfde389" 13194139533347 17592186045585 true] [17592186073521 1074 "|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $BM=CM$ | Definition of a midpoint |\n| 2 | $\\overline{BM} \\cong \\overline{CM}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of congruent segments}}$ |\n| 3 | $AB=6\\,\\textrm{cm}$ | Given |\n| 4 | $AC=6\\,\\textrm{cm}$ | Given |\n| 5 | $AB=AC$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Transitive property of equality}}$ |\n| 6 | $\\overline{AB} \\cong \\overline{AC}$ | Definition of congruent segments |\n| 7 | $\\overline{AM} \\cong \\overline{AM}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Reflexive property of congruence}}$ |\n| 8 | $\\triangle ABM \\cong \\triangle ACM$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{SSS criterion}}$ |\n| 9 | $\\angle {BAM}\\cong \\angle {CAM}$ | CPCTC |\n\nLet's examine the rows of the table with missing parts in turn.\n\n- Consider row 2. From row 1, we have that $BM=CM$ Therefore, $\\overline{BM} \\cong \\overline{CM}$ by the definition of congruent segments.\n- Consider row 5. From rows 3 and 4, we have that $AB=6\\,\\textrm{cm}=AC$. Therefore, $AB=AC$ by the transitive property of equality.\n- Consider row 7. Since every segment is congruent with itself, by the reflexive property of congruence, $\\overline{AM} \\cong \\overline{AM}$.\n- Consider row 8. From rows 2, 6, and 7, we have\n$\\overline{BM} \\cong \\overline{CM}, \\qquad\\overline{AB} \\cong \\overline{AC}, \\qquad \\overline{AM} \\cong \\overline{AM}$.\nTherefore, $\\triangle ABM \\cong \\triangle ACM$ by the SSS criterion." 13194139533347 17592186045585 true] [17592186073522 1069 "e-15933" 13194139533347 17592186045585 true] [17592186073522 1071 "![](images/77/771d17ad57e198b36db6d632003a34ea56ab83b4daf2c489ca839f6a2fcff8e3.png)\n\nIn the diagram above, the points $A$, $C$, and $D$ are colinear, and the lines $\\overset{\\longleftrightarrow}{EF}$ and $\\overset{\\longleftrightarrow}{AD}$ are parallel.\n\nConsider the following statement:\n\n> $m\\angle{BCD} = m\\angle{A} + m\\angle{ABC}$\n\nThe table below gives the proof of the statement. Complete the proof by filling in the empty boxes.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\overset{\\longleftrightarrow}{EF} \\parallel \\overset{\\longleftrightarrow}{AD}$ |  |\n| 2 | $\\angle{BCD} \\cong \\angle{CBE}$ |  |\n| 3 | $m\\angle{BCD} = m\\angle{CBE}$ |  |\n| 4 | $m\\angle{CBE} = m\\angle{ABE} + m\\angle{ABC}$ |  |\n| 5 | $\\angle{ABE} \\cong \\angle{A}$ |  |\n| 6 | $m\\angle{ABE} = m\\angle{A}$ |  |\n| 7 | $m\\angle{CBE} = m\\angle{A} + m\\angle{ABC}$ |  |\n| 8 | $m\\angle{BCD} = m\\angle{A} + m\\angle{ABC}$ |  |" 13194139533347 17592186045585 true] [17592186073522 1072 #uuid "d0dd90e2-2976-5953-87f0-ada5fa1045b9" 13194139533347 17592186045585 true] [17592186073522 1074 "![](images/00/008b75ac2feaec944a50368ec0fc5781d47314f8bfe0503ae70c1e564b4035b1.png)\n\nThe correct proof is below.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\overset{\\longleftrightarrow}{EF} \\parallel \\overset{\\longleftrightarrow}{AD}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Given}}$ |\n| 2 | $\\angle{BCD} \\cong \\angle{CBE}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Alternate interior angles theorem}}$ |\n| 3 | $m\\angle{BCD} = m\\angle{CBE}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of congruent angles}}$ |\n| 4 | $m\\angle{CBE} = m\\angle{ABE} + m\\angle{ABC}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Angle addition postulate}}$ |\n| 5 | $\\angle{ABE} \\cong \\angle{A}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Alternate interior angles theorem}}$ |\n| 6 | $m\\angle{ABE} = m\\angle{A}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of congruent angles}}$ |\n| 7 | $m\\angle{CBE} = m\\angle{A} + m\\angle{ABC}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Substitution}}$ |\n| 8 | $m\\angle{BCD} = m\\angle{A} + m\\angle{ABC}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Transitive property of equality}}$ |\n\nLet's examine each row in turn.\n\n1. Note that we're given $\\overset{\\longleftrightarrow}{EF} \\parallel \\overset{\\longleftrightarrow}{AD}$.\n2. From row 1, we have that $\\overset{\\longleftrightarrow}{EF}$ and $\\overset{\\longleftrightarrow}{AD}$ are parallel. Therefore, $\\angle{BCD}$ and $\\angle{CBE}$ are congruent by the alternate interior angles theorem.\n3. From row 2, we have that $\\angle{BCD}$ and $\\angle{CBE}$ are congruent. Therefore, by the definition of congruent angles, $m\\angle{BCD} = m\\angle{CBE}$.\n4. Note that the segment $\\overline{AB}$ divides the angle $\\angle{CBE}$ into consecutive angles $\\angle{ABE}$ and $\\angle{ABC}$. Therefore, by the angle addition postulate, we must have\n$m\\angle{CBE} = m\\angle{ABE} + m\\angle{ABC}$.\n5. From row 1, we have that $\\overset{\\longleftrightarrow}{EF}$ and $\\overset{\\longleftrightarrow}{AD}$ are parallel. Therefore, $\\angle{ABE}$ and $\\angle{A}$ are congruent by the alternate interior angles theorem.\n6. From row 5, $\\angle{ABE}$ and $\\angle{A}$ are congruent. Therefore, by the definition of congruent angles, $m\\angle{ABE} = m\\angle{A}$.\n7. From row 6, $m\\angle{ABE} = m\\angle{A}$. Substituting this into the equation in row 4, we have\n$m\\angle{CBE} = m\\angle{A} + m\\angle{ABC}$.\n8. From rows 3 and 7, we have\n$m\\angle{BCD} = m\\angle{CBE}, \\qquad m\\angle{CBE} = m\\angle{A} + m\\angle{ABC}$.\nTherefore, by the transitive property of equality, $m\\angle{BCD} = m\\angle{A} + m\\angle{ABC}$." 13194139533347 17592186045585 true] [17592186073523 1069 "e-15968" 13194139533347 17592186045585 true] [17592186073523 1071 "![](images/25/25975faf71f7fcac617b767d6fcd2930f065fd1d501a433ccaa7201453edcff0.png)\n\nThe two right cylinders above are similar with a scale factor $k=2$ (not drawn to scale). What is the surface area of the larger cylinder if the surface area of the smaller one is $12\\pi \\: \\textrm{in}^2$?\n\n*Note: $\\pi\\approx 3.141\\,593$*" 13194139533347 17592186045585 true] [17592186073523 1072 #uuid "40ec9eea-01f7-5822-b2d7-efe4aa42bcaf" 13194139533347 17592186045585 true] [17592186073523 1074 "If two solids are similar with scale factor $k$, then the ratio of the corresponding surface areas equals $k^2$.\n\nTherefore,\n\n$$\nk^2 = 2^2 = 4\n$$\n\nand we have\n\n$$\n\\dfrac{\\mathcal{A}_{\\textrm{larger}}}{\\mathcal{A}_{\\textrm{smaller}}} = 4\n$$\n\nSolving for $\\mathcal{A}_{\\textrm{larger}}$ and substituting\n\n$$\n\\mathcal{A}_{\\textrm{smaller}} = 12\\pi\\,\\textrm{in}^2\n$$\n\nwe have\n\n$$\n\\begin{aligned}\nA_{larger} &= 4 \\cdot A_{smaller} \\\\\n&= 4 \\cdot 12πin^{2} \\\\\n&= 48πin^{2}\n\\end{aligned}\n$$" 13194139533347 17592186045585 true] [17592186073524 1069 "e-15969" 13194139533347 17592186045585 true] [17592186073524 1071 "![](images/19/19528e4301a708b177d66af448c344573f2b4a4541aba6a80db74333601e4631.png)\n\nConsider the two spheres above (picture not to scale). If the volume of the smaller sphere is equal to $16\\pi\\,\\textrm{mm}^3$ and the volume of the larger sphere is $60\\pi\\,\\textrm{mm}^3$, what is the ratio of the radii $r_1$ and $r_2$ for these solids? Round your answer to one decimal place." 13194139533347 17592186045585 true] [17592186073524 1072 #uuid "e609c689-33ba-53cb-ae8a-c7f9917692be" 13194139533347 17592186045585 true] [17592186073524 1074 "Recall that all spheres are similar.\n\nIf two solids are similar with scale factor $k$, then the ratio of the corresponding volumes equals $k^3$.\n\nComputing the ratio of the volumes, we have\n\n$$\n\\dfrac{\\mathcal{V}_{\\textrm{larger}}}{\\mathcal{V}_{\\textrm{smaller}}} = \\dfrac{60\\pi}{16\\pi} = \\dfrac{15}{4}\n$$\n\nThis means that the solids are similar with a scale factor of\n\n$$\nk = \\sqrt[3]{\\dfrac{15}{4}} \\approx 1.553\\,6\n$$\n\nThus, the radius $r_2$ is $1.553\\,6$ times larger than the radius $r_1$. Therefore,\n\n$$\n\\dfrac{r_2}{r_1} = k = 1.553\\,6 \\qquad \\Longrightarrow\\qquad \\dfrac{r_1}{r_2} = \\dfrac{1}{1.553\\,6} \\approx 0.6\n$$" 13194139533347 17592186045585 true] [17592186073525 1069 "e-15970" 13194139533347 17592186045585 true] [17592186073525 1071 "![](images/6f/6f3f587b66166c205fc937952c4758f59edff1d7efc492da0de7c3c0ac863f42.png)\n\nThe height of the larger pentagonal prism is $18\\, \\textrm{in}$. The ratio of the surface area of the smaller prism to the surface area of the larger prism is $49:81$ (not drawn to scale). Given that the two prisms are similar, what is the height of the smaller prism?" 13194139533347 17592186045585 true] [17592186073525 1072 #uuid "c1772fd2-9613-5e6c-ab84-635761725453" 13194139533347 17592186045585 true] [17592186073525 1074 "If two solids are similar with scale factor $k$, then the ratio of the corresponding surface areas equals $k^2$.\n\nWe are told that\n\n$$\n\\dfrac{\\mathcal{A}_{\\textrm{smaller}}}{\\mathcal{A}_{\\textrm{larger}}} = \\dfrac{49}{81}\n$$\n\nSo, we have that\n\n$$\nk^2 = \\dfrac{49}{81}\\quad\\Rightarrow\\quad k = \\sqrt{\\dfrac{49}{81}} = \\dfrac{7}{9}\n$$\n\nThus, the height of the smaller prism is\n\n$$\n\\dfrac{7}{9}\n$$\n\ntimes the height of the larger prism. Therefore, the height of the smaller prism is\n\n$$\nh = 18 \\cdot \\dfrac{7}{9} = 14 \\,\\textrm{in}\n$$" 13194139533347 17592186045585 true] [17592186073526 1069 "e-15988" 13194139533347 17592186045585 true] [17592186073526 1071 "![](images/0e/0e0fe9cf7b5a39827133e7ea4648d9aac946e4711cb877cf518bc11587d97712.png)\n\nIn the diagram above, the points $B$, $C$, and $D$ are colinear.\n\nConsider the following statement:\n\n> $m\\angle{ACD} = m\\angle{A} + m\\angle{B}$\n\nThe table below provides proof of the statement. Complete the proof by filling in the empty boxes.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\angle{ACB}$ and $\\angle{ACD}$ are supplementary |  |\n| 2 | $m\\angle{ACB} + m\\angle{ACD} = 180^\\circ$ |  |\n| 3 | $m\\angle{A} + m\\angle{B} + m\\angle{ACB} = 180^\\circ$ | Interior angles of a triangle theorem |\n| 4 | $180^\\circ = m\\angle{A} + m\\angle{B} + m\\angle{ACB}$ |  |\n| 5 | $m\\angle{ACB} + m\\angle{ACD} = m\\angle{A} + m\\angle{B} + m\\angle{ACB}$ | Transitive property of equality |\n| 6 | $m\\angle{ACD} = m\\angle{A} + m\\angle{B}$ | Addition principle |" 13194139533347 17592186045585 true] [17592186073526 1072 #uuid "0e018d52-d174-5ce6-b8ec-0f87222d5505" 13194139533347 17592186045585 true] [17592186073526 1074 "The complete proof is below.\n\n|  | Statement | Reason |\n| --- | ---: | ---: |\n| 1 | $\\angle{ACB}$ and $\\angle{ACD}$ are supplementary | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Linear pair postulate}}$ |\n| 2 | $m\\angle{ACB} + m\\angle{ACD} = 180^\\circ$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Definition of supplementary angles}}$ |\n| 3 | $m\\angle{A} + m\\angle{B} + m\\angle{ACB} = 180^\\circ$ | Interior angles of a triangle theorem |\n| 4 | $180^\\circ = m\\angle{A} + m\\angle{B} + m\\angle{ACB}$ | $\\bbox[3pt,Gainsboro]{\\color{blue}\\textrm{Symmetric property of equality}}$ |\n| 5 | $m\\angle{ACB} + m\\angle{ACD} = m\\angle{A} + m\\angle{B} + m\\angle{ACB}$ | Transitive property of equality |\n| 6 | $m\\angle{ACD} = m\\angle{A} + m\\angle{B}$ | Addition principle |\n\nLet's examine the rows of the table with missing parts in turn.\n\n- Consider row 1. According to the linear pair postulate, $\\angle{ACB}$ and $\\angle{ACD}$ are supplementary angles.\n- Consider row 2. From row 1, $\\angle{ACB}$ and $\\angle{ACD}$ are supplementary angles. Therefore, by definition of supplementary angles,\n$m\\angle{ACB} + m\\angle{ACD} = 180^\\circ$.\n- Consider row 4. From row 3, we have\n$m\\angle{A} + m\\angle{B} + m\\angle{ACB} = 180^\\circ$.\nNow, using the symmetric property of equality, we get\n$180^\\circ = m\\angle{A} + m\\angle{B} + m\\angle{ACB}$." 13194139533347 17592186045585 true] [17592186073527 1069 "e-1743" 13194139533347 17592186045585 true] [17592186073527 1071 "What is $3 - \\dfrac{1}{7}$ expressed as an improper fraction?" 13194139533347 17592186045585 true] [17592186073527 1072 #uuid "c5191ff9-e7ec-5998-a0a9-a0f2b2d41d76" 13194139533347 17592186045585 true] [17592186073527 1074 "To subtract\n\n$$\n\\dfrac{1}{\\color{blue}{7}}\n$$\n\nfrom $3$, we need to express the whole number $3$ as an equivalent fraction with a denominator of ${\\color{blue}{7}}$.\n\nFirst, we write $3$ as an improper fraction:\n\n$$\n\\dfrac{3}{1}\n$$\n\nThen, we put this fraction over a denominator of $\\color{blue}7$ by multiplying the numerator and denominator by ${\\color{blue}{7}}$:\n\n$$\n\\dfrac{3 \\times {\\color{blue}{7}}}{1\\times{\\color{blue}{7}}} = \\dfrac{21}{7}\n$$\n\nSo now, we have to find:\n\n$$\n\\dfrac{21}{7} - \\dfrac{1}{7}\n$$\n\nTo subtract two fractions with like denominators, we subtract the numerators and keep the denominators the same:\n\n$$\n\\frac{21}{7} - \\frac{1}{7} = \\frac{20}{7}\n$$" 13194139533347 17592186045585 true] [17592186073528 1069 "e-1745" 13194139533347 17592186045585 true] [17592186073528 1071 "What is $\\dfrac{31}{9} - 2$ expressed as a mixed number?" 13194139533347 17592186045585 true] [17592186073528 1072 #uuid "d566c6a3-426d-591e-a884-16ff5e10a825" 13194139533347 17592186045585 true] [17592186073528 1074 "To subtract $2$ from\n\n$$\n\\dfrac{31}{\\color{blue}{9}}\n$$\n\n, we need to express the whole number $2$ as an equivalent fraction with a denominator of ${\\color{blue}{9}}$.\n\nFirst, we write $2$ as an improper fraction:\n\n$$\n\\dfrac{2}{1}\n$$\n\nThen, we put this fraction over a denominator of $\\color{blue}9$ by multiplying the numerator and denominator by ${\\color{blue}{9}}$:\n\n$$\n\\dfrac{2 \\times {\\color{blue}{9}}}{1\\times{\\color{blue}{9}}} = \\dfrac{18}{9}\n$$\n\nSo now, we have to find:\n\n$$\n\\dfrac{31}{9} - \\dfrac{18}{9}\n$$\n\nTo subtract two fractions with like denominators, we subtract the numerators and keep the denominators the same:\n\n$$\n\\frac{31}{9} - \\frac{18}{9} = \\frac{31 - 18}{9} = \\frac{13}{9}\n$$\n\nFinally, we convert to a mixed number:\n\n$$\n13 \\div 9 = 1 \\, \\textrm{R} \\, 4\n$$\n\nSo our final answer is\n\n$$\n1 \\, \\dfrac{4}{9}\n$$" 13194139533347 17592186045585 true] [17592186073529 1069 "e-1747" 13194139533347 17592186045585 true] [17592186073529 1071 "Julia had $4$ liters of orange juice, but she accidentally spilled $\\dfrac{15}{8}$ liters of juice. Expressed as a mixed number, how much juice is left?" 13194139533347 17592186045585 true] [17592186073529 1072 #uuid "f6f05542-54f4-5fc6-807b-b012abcfaa70" 13194139533347 17592186045585 true] [17592186073529 1074 "To find out how much juice is left, we have to calculate the difference\n\n$$\n4 - \\dfrac{15}{8}\n$$\n\nTo subtract\n\n$$\n\\dfrac{15}{\\color{blue}{8}}\n$$\n\nfrom $4$, we need to express the whole number $4$ as an equivalent fraction with a denominator of ${\\color{blue}{8}}$.\n\nFirst, we write $4$ as an improper fraction:\n\n$$\n\\dfrac{4}{1}\n$$\n\nThen, we put this fraction over a denominator of $\\color{blue}8$ by multiplying the numerator and denominator by ${\\color{blue}{8}}$:\n\n$$\n\\dfrac{4 \\times {\\color{blue}{8}}}{1\\times{\\color{blue}{8}}} = \\dfrac{32}{8}\n$$\n\nSo now, we have to find:\n\n$$\n\\dfrac{32}{8} - \\dfrac{15}{8}\n$$\n\nTo subtract two fractions with like denominators, we subtract the numerators and keep the denominators the same:\n\n$$\n\\frac{32}{8} - \\frac{15}{8} = \\frac{32 - 15}{8} = \\frac{17}{8}\n$$\n\nFinally, we convert to a mixed number:\n\n$$\n17 \\div 8 = 2 \\, \\textrm{R} \\, 1\n$$\n\nTherefore,\n\n$$\n2 \\, \\dfrac{1}{8}\n$$\n\nliters of juice is left." 13194139533347 17592186045585 true] [17592186073530 1069 "e-1812" 13194139533347 17592186045585 true] [17592186073530 1071 "Harold cuts an $85$-inch long rope into $5$ pieces of the same size. How long is each piece?" 13194139533347 17592186045585 true] [17592186073530 1072 #uuid "83452ea8-bf0c-54eb-8ed5-54bb3c200d2d" 13194139533347 17592186045585 true] [17592186073530 1074 "To find out how long each of the pieces is, we need to divide $85$ by $5$.\n\nWe start by writing down the question using long division notation:\n\n| $5$$\\!\\!\\require{enclose}\\enclose{longdiv}{8 {\\:\\phantom{\\mid}} 5}$ |  |\n| --- | ---: |\n\nFirst, we consider the tens:\n\n| $\\color{blue}1$$5$$\\!\\!\\require{enclose}\\enclose{longdiv}{{\\color{red}8} {\\:\\phantom{\\mid}} 5}$$-\\!\\!\\!\\!\\!\\!\\!$$5$$\\color{lightgray}\\downarrow$$3$$\\color{lightgray}5$ | Divide: ${\\color{red}8} \\div 5 = {\\color{blue}1}\\,\\text{R}\\,3$Write over tens: $\\color{blue}1$Multiply: $5 \\times {\\color{blue}1} = 5$Subtract: ${\\color{red}8} - 5 = 3$Bring down: $5$ |\n| --- | ---: |\n\nNext, we consider the ones:\n\n| $1$$\\color{blue}7$$5$$\\!\\!\\require{enclose}\\enclose{longdiv}{8 {\\:\\phantom{\\mid}} 5}$$-\\!\\!\\!\\!\\!\\!\\!$$5$$\\color{red}3$$\\color{red}5$$-\\!\\!\\!\\!\\!\\!\\!$$3$$5$$\\fbox{0}$ | Divide: ${\\color{red}35} \\div 5 = {\\color{blue}7}$Write over ones: $\\color{blue}7$Multiply: $5 \\times {\\color{blue}7} = 35$Subtract: ${\\color{red}35} - 35 = \\fbox{0}$ |\n| --- | ---: |\n\nWe've gone through all the digits in the number $85$, so the division is done.\n\nTherefore,\n\n$$\n85 \\div 5 = 17\n$$\n\nThis means that each piece of rope is $17$ inches long." 13194139533347 17592186045585 true] [17592186073531 1069 "e-1813" 13194139533347 17592186045585 true] [17592186073531 1071 "From top to bottom, what are the missing digits in the following division problem?\n\n| $1$$2$$7$$\\!\\!\\require{enclose}\\enclose{longdiv}{8 {\\:\\phantom{\\mid}} 5}$$-\\!\\!\\!$$7$$1$$5$$-\\!\\!\\!\\!\\!\\!\\!$$1$$4$$1$ |\n| --- |" 13194139533347 17592186045585 true] [17592186073531 1072 #uuid "00006ac6-b956-55b9-9bac-e83cdee6e998" 13194139533347 17592186045585 true] [17592186073531 1074 "We start by writing down the question using long division notation:\n\n| $7$$\\!\\!\\require{enclose}\\enclose{longdiv}{8 {\\:\\phantom{\\mid}} 5}$ |  |\n| --- | ---: |\n\nFirst, we consider the tens:\n\n| $\\color{blue}1$$7$$\\!\\!\\require{enclose}\\enclose{longdiv}{{\\color{red}8} {\\:\\phantom{\\mid}} 5}$$-\\!\\!\\!\\!\\!\\!\\!$$7$$\\color{lightgray}\\downarrow$$1$$\\color{lightgray}5$ | Divide: ${\\color{red}8} \\div 7 = {\\color{blue}1}\\,\\text{R}\\,1$Write over tens: $\\color{blue}1$Multiply: $7 \\times {\\color{blue}1} = 7$Subtract: ${\\color{red}8} - 7 = 1$Bring down: $5$ |\n| --- | ---: |\n\nNext, we consider the ones:\n\n| $1$$\\color{blue}2$$7$$\\!\\!\\require{enclose}\\enclose{longdiv}{8 {\\:\\phantom{\\mid}} 5}$$-\\!\\!\\!\\!\\!\\!\\!$$7$$\\color{red}1$$\\color{red}5$$-\\!\\!\\!\\!\\!\\!\\!$$1$$4$$\\fbox{1}$ | Divide: ${\\color{red}15} \\div 7 = {\\color{blue}2}\\,\\text{R}\\,1$Write over ones: $\\color{blue}2$Multiply: $7 \\times {\\color{blue}2} = 14$Subtract: ${\\color{red}15} - 14 = \\fbox{1}$ |\n| --- | ---: |\n\nWe've gone through all the digits in the number $85$, so the division is done. However, we still have a remainder of $1$, so we include this in our final answer.\n\nTherefore,\n\n$$\n85 \\div 7 = 12\\,\\text{R}\\,1\n$$\n\nThe missing digits are $1$, $7$ and $1$:\n\n| $\\fbox{1}$$2$$7$$\\!\\!\\require{enclose}\\enclose{longdiv}{8 {\\:\\phantom{\\mid}} 5}$$-\\