-92e6-89b5c4e25502" 13194139533355 17592186045585 true] [17592186110288 1081 "2.854" 13194139533355 17592186045585 true] [17592186110288 1083 #edb/ref 17592186045499 13194139533355 17592186045585 true] [17592186110288 1084 #uuid "97d92e91-3ea1-5c78-aa7b-9fff1e168117" 13194139533355 17592186045585 true] [17592186110289 1081 "0.291" 13194139533355 17592186045585 true] [17592186110289 1083 #edb/ref 17592186045499 13194139533355 17592186045585 true] [17592186110289 1084 #uuid "fe3f7a87-1eaa-507a-bc7d-515aaaea9cc8" 13194139533355 17592186045585 true] [17592186110290 1081 "2.610" 13194139533355 17592186045585 true] [17592186110290 1083 #edb/ref 17592186045499 13194139533355 17592186045585 true] [17592186110290 1084 #uuid "3d174bc9-68e6-5fbb-a9b0-bb37ed4087b9" 13194139533355 17592186045585 true] [17592186110291 1081 "2.571" 13194139533355 17592186045585 true] [17592186110291 1083 #edb/ref 17592186045499 13194139533355 17592186045585 true] [17592186110291 1084 #uuid "52aa8f97-3160-5f94-904b-b6db3f3ee160" 13194139533355 17592186045585 true] [17592186110292 1081 "0.350" 13194139533355 17592186045585 true] [17592186110292 1083 #edb/ref 17592186045499 13194139533355 17592186045585 true] [17592186110292 1084 #uuid "60df0ad3-d4d1-5e57-bf22-52c92fd37f42" 13194139533355 17592186045585 true] [17592186110293 1069 "e-10052" 13194139533355 17592186045585 true] [17592186110293 1071 "Express $2\\tan x\\cdot(\\cot x+\\tan{x})$ in terms of $\\sec x$ only." 13194139533355 17592186045585 true] [17592186110293 1072 #uuid "3d64bc1e-3937-5e0d-b0f8-7dd06acd27ef" 13194139533355 17592186045585 true] [17592186110293 1074 "First, let's recall the secant-tangent identity:\n\n$$\n1+\\tan^2 x = \\sec^2{x}\n$$\n\nAlso, recall the following identity:\n\n$$\n\\cot x = \\dfrac{1}{\\tan x}\\quad\\Longrightarrow\\quad \\tan x\\cdot \\cot x = 1\n$$\n\nUsing the above identities, we can simplify our expression as follows:\n\n$$\n\\begin{aligned}\n2\\tan x \\cdot (\\cot x + \\tan x) &= 2\\tan x \\cdot \\cot x + 2\\tan^{2} x \\\\\n&= 2 \\cdot 1 + 2\\tan^{2} x \\\\\n&= 2(1 + \\tan^{2} x) \\\\\n&= 2\\sec^{2} x\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n2\\tan x\\cdot(\\cot x+\\tan{x})= 2\\sec^2x\n$$" 13194139533355 17592186045585 true] [17592186110294 1069 "e-10053" 13194139533355 17592186045585 true] [17592186110294 1071 "Express $(1-\\sec x)(1+\\sec x)$ in terms of $\\tan x$ only." 13194139533355 17592186045585 true] [17592186110294 1072 #uuid "c04610a2-f73f-57a9-b17b-da9b30a5e431" 13194139533355 17592186045585 true] [17592186110294 1074 "First, let's recall the secant-tangent identity:\n\n$$\n1+\\tan^2 x = \\sec^2{x}\n$$\n\nFirst, we expand the parentheses using the difference of squares formula:\n\n$$\n(1-\\sec x)(1+\\sec x) = 1 - \\sec^2x\n$$\n\nThen, we rewrite the expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\n1 - \\sec^{2} x &= 1 - (1 + \\tan^{2} x) \\\\\n&= 1 - 1 - \\tan^{2} x \\\\\n&=-\\tan^{2} x\n\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n(1-\\sec x)(1+\\sec x)= -\\tan^2 x\n$$" 13194139533355 17592186045585 true] [17592186110295 1069 "e-10455" 13194139533355 17592186045585 true] [17592186110295 1071 "Find the inverse of the function $f(x) = \\dfrac12 e^{x+8}-2$." 13194139533355 17592186045585 true] [17592186110295 1072 #uuid "09634460-21c4-5389-92f4-15339282b7ff" 13194139533355 17592186045585 true] [17592186110295 1074 "To find $f^{-1}(x)$, we start by replacing $f(x)$ with $y$:\n\n$$\n\\begin{aligned}\ny &= \\frac{1}{2}e^{x + 8} - 2\n\\end{aligned}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\n\\begin{aligned}\nx &= \\frac{1}{2}e^{y + 8} - 2\n\\end{aligned}\n$$\n\nFinally, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{1}{2}e^{y + 8} - 2 \\\\\n\\frac{1}{2}e^{y + 8} &= x + 2 \\\\\ne^{y + 8} &= 2x + 4 \\\\\n\\ln (e^{y + 8}) &= \\ln (2x + 4) \\\\\ny + 8 &= \\ln (2x + 4) \\\\\ny &= \\ln (2x + 4) - 8\n\\end{aligned}\n$$\n\nTherefore, the inverse function is\n\n$$\nf^{-1}(x) = \\ln{(2x+4)} - 8\n$$" 13194139533355 17592186045585 true] [17592186110296 1069 "e-1056" 13194139533355 17592186045585 true] [17592186110296 1071 "![](images/bd/bdb5279236cdc7671efa0f309b0a07d5ffc131f9d3c33a048f286fdef4588fcd.png)\n\nWhich system of inequalities defines the shaded region shown above?" 13194139533355 17592186045585 true] [17592186110296 1072 #uuid "4b19b389-7d0e-525b-b37f-787e53f5e3b2" 13194139533355 17592186045585 true] [17592186110296 1074 "Consider the line $y = 2x - 1$. Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny \\leq 2x - 1\n$$\n\nNow consider the line\n\n$$\ny = -x+2\n$$\n\nSince the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny \\geq -x + 2\n$$\n\nTherefore, the system of inequalities that defines our shaded region is\n\n$$\n{y \\le 2x - 1; y \\ge - x + 2\n$$" 13194139533355 17592186045585 true] [17592186110297 1069 "e-10588" 13194139533355 17592186045585 true] [17592186110297 1071 "![](images/44/44aa56708e43f0518d7759e96b0770834f999998280c52910b2ca07cd607c1ab.png)\n\nGiven that $\\angle DOA$ is a straight angle, what is the value of $x$?" 13194139533355 17592186045585 true] [17592186110297 1072 #uuid "60df6f7a-5257-5081-ba0c-0e9499a15f23" 13194139533355 17592186045585 true] [17592186110297 1074 "Note that $\\angle AOD$ is a straight angle and $\\angle BOC$ is a right angle. Hence,\n\n$$\nm∠AOD = 180^{∘}, m∠BOC = 90^{∘}\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}\nm∠AOB + m∠BOC + m∠COD &= m∠AOD \\\\\nx + 90^{∘} + (2x - 30^{∘}) &= 180^{∘} \\\\\n3x + 60^{∘} &= 180^{∘} \\\\\n3x &= 120^{∘} \\\\\nx &= 40^{∘}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110298 1069 "e-10594" 13194139533355 17592186045585 true] [17592186110298 1071 "The measure of the angle $\\angle BAD$ is ${90}^{\\circ}$. Find the value of $x$.\n\n![](images/f4/f41802149d3e2a8524a47123e6de1bb6aa68e480cf54aafd756085ad52355ede.png)" 13194139533355 17592186045585 true] [17592186110298 1072 #uuid "d4240cff-2c48-520b-a11a-f6838c163a17" 13194139533355 17592186045585 true] [17592186110298 1074 "Here, the letter $x$ represents the measure of the unknown angle $\\angle CAD$.\n\nNote the following:\n\n- The angles $\\angle BAC$ and $\\angle CAD$ are adjacent because they share the side $\\overrightarrow{AC}$.\n- So, the measure of the *large* angle $(\\angle BAD)$ must be the *sum* of the measures of the two *smaller* angles $(\\angle BAC$ and $\\angle CAD)$.\n- This means that the measure of $\\angle CAD$ must be the *difference* between the large angle $(\\angle BAD)$ and the smaller known angle $(\\angle BAC)$.\n\nTherefore,\n\n$$\nx = 90^\\circ - 35^\\circ = 55^\\circ\n$$" 13194139533355 17592186045585 true] [17592186110299 1069 "e-10595" 13194139533355 17592186045585 true] [17592186110299 1071 "Which of the following shows a right angle?\n\n![](images/e6/e6ee9f2a0b7dfa70c1d61dac0d19e1347d56ba94d93762c435d0727216d61143.png)" 13194139533355 17592186045585 true] [17592186110299 1072 #uuid "afde7d46-5a88-5ec8-b86f-32d126a36258" 13194139533355 17592186045585 true] [17592186110299 1074 "An angle of $90^\\circ$ has the same measure as one-quarter of a full turn.\n\nAmong the given options, the only $90^\\circ$ angle is the following:\n\n![](images/b2/b2e63cd5919753a0b549f345ecfa5dbfa40bf5d85a3dbe8b59872119316d1dd7.png)\n\nTherefore, the correct answer is II." 13194139533355 17592186045585 true] [17592186110300 1069 "e-10596" 13194139533355 17592186045585 true] [17592186110300 1071 "Which of the following shows a straight angle?\n\n![](images/e6/e6ee9f2a0b7dfa70c1d61dac0d19e1347d56ba94d93762c435d0727216d61143.png)" 13194139533355 17592186045585 true] [17592186110300 1072 #uuid "5427c83b-5f34-57fa-b56c-a0c190e74348" 13194139533355 17592186045585 true] [17592186110300 1074 "A straight angle has a degree measure of $180^\\circ$. This corresponds to one-half of a full turn.\n\nAmong the given options, the only straight angle is the following:\n\n![](images/1e/1e16add703d800bce68d70ded10f220808accb557ae15f9245147eaf3ca513b1.png)\n\nTherefore, the correct answer is III." 13194139533355 17592186045585 true] [17592186110301 1069 "e-10748" 13194139533355 17592186045585 true] [17592186110301 1071 "![](images/2f/2f6d703c604c780da8c97a012b94e75f06a55aa8b6e706a1097dc33ff193e88c.png)\n\nGiven the picture shown above, which of the following statements are true?\n\n1. The points $K$, $N$, and $Z$ are collinear\n2. The points $K$, $P$, and $J$ are collinear" 13194139533355 17592186045585 true] [17592186110301 1072 #uuid "a042ba66-3567-5b06-84e6-344ad0043bbc" 13194139533355 17592186045585 true] [17592186110301 1074 "- Statement I is false. We can't draw a straight line that passes through these three points.\n\n![](images/39/390f01ec8631f4c4eca0f391dd5b1c2f9e450e94d3bd992e6046c42dff0fc1e8.png)\n\n- Statement II is true. There is a straight line that passes through these three points.\n\n![](images/d9/d9d250f402d238388931ec077d17afe65b248d245ae6333f9cb150c18288ccce.png)\n\nTherefore, the correct answer is \"II only.\"" 13194139533355 17592186045585 true] [17592186110302 1069 "e-10749" 13194139533355 17592186045585 true] [17592186110302 1071 "Which of the diagrams below shows three collinear points?\n\n![](images/c0/c0df27c96da9f9c285438faee93652f81362fe91a51dc28e02ec0e2e9ff42177.png)" 13194139533355 17592186045585 true] [17592186110302 1072 #uuid "76902823-634d-5525-afc5-5f2a98cea481" 13194139533355 17592186045585 true] [17592186110302 1074 "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/49/4967d8325f8ed8415a8404286d29ff97eb65cd6926ed1ca27a943178aee1a3cc.png)\n\n- Diagram II shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/af/af746af6fba54f69570f5dcfa38fbbb4cffd290080cc45deec433bc5266aa75e.png)\n\n- Diagram III shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/c0/c0d9d178c5be09aa7f6ad1927c6f8e930154cf077aabbd18a765820babd63069.png)\n\nTherefore, the correct answer is \"II only.\"" 13194139533355 17592186045585 true] [17592186110303 1069 "e-1085" 13194139533355 17592186045585 true] [17592186110303 1071 "Calculate $\\left(\\dfrac{2x}{3}\\right)^4$." 13194139533355 17592186045585 true] [17592186110303 1072 #uuid "dc436197-3170-5ed7-a8f8-2092dd72da21" 13194139533355 17592186045585 true] [17592186110303 1074 "First, we apply the power of quotient rule:\n\n$$\n(\\frac{2x}{3})^{4} = ((2x)^{4})/(3^{4})\n$$\n\nThen, we apply the power rule and simplify:\n\n$$\n\\begin{aligned}\n((2x)^{4})/(3^{4}) &=  \\\\\n\\frac{2^{4}x^{4}}{3^{4}} &=  \\\\\n&= \\frac{16x^{4}}{81}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110304 1069 "e-1086" 13194139533355 17592186045585 true] [17592186110304 1071 "Simplify $\\left(\\dfrac{y}{2}\\right)^3 \\left(\\dfrac{2y}{3}\\right)^2$." 13194139533355 17592186045585 true] [17592186110304 1072 #uuid "7d8ea34f-b406-5bc8-9c00-de65d72e9d6d" 13194139533355 17592186045585 true] [17592186110304 1074 "First, we apply the power of quotient rule:\n\n$$\n(\\frac{y}{2})^{3}(\\frac{2y}{3})^{2} = \\frac{y^{3}}{2^{3}} \\cdot ((2y)^{2})/(3^{2})\n$$\n\nNext, we apply the power rule:\n\n$$\n\\begin{aligned}\n\\frac{y^{3}}{2^{3}} \\cdot ((2y)^{2})/(3^{2}) &=  \\\\\n\\frac{y^{3}}{8} \\cdot \\frac{2^{2}y^{2}}{9} &=  \\\\\n&= \\frac{y^{3}}{8} \\cdot \\frac{4y^{2}}{9}\n\\end{aligned}\n$$\n\nFinally, we apply the product rule and simplify:\n\n$$\n\\begin{aligned}\n\\frac{y^{3}}{8} \\cdot \\frac{4y^{2}}{9} &=  \\\\\n(4y^{(3 + 2)})/(72) &=  \\\\\n\\frac{4y^{5}}{72} &=  \\\\\n&= \\frac{y^{5}}{18}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110305 1069 "e-1088" 13194139533355 17592186045585 true] [17592186110305 1071 "Simplify the expression $\\left(x^2y\\right)^3\\cdot x^2y$." 13194139533355 17592186045585 true] [17592186110305 1072 #uuid "ee3fd0ee-77a9-5ebb-9bc9-c7439f5946b4" 13194139533355 17592186045585 true] [17592186110305 1074 "We start by using the power of product rule:\n\n$$\n(x^{2}y)^{3} \\cdot x^{2}y =; (x^{2})^{3} \\cdot y^{3} \\cdot x^{2}y\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}\nx^{2 \\cdot 3} \\cdot y^{3} \\cdot x^{2}y &=  \\\\\n&= x^{6} \\cdot y^{3} \\cdot x^{2}y\n\\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}\nx^{6} \\cdot y^{3} \\cdot x^{2}y = \\\\\n&= x^{6} \\cdot x^{2} \\cdot y^{3} \\cdot y = \\\\\nx^{6 + 2} \\cdot y^{3 + 1} &=  \\\\\nx^{8} \\cdot y^{4} &=  \\\\\n&= x^{8}y^{4}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110306 1069 "e-1089" 13194139533355 17592186045585 true] [17592186110306 1071 "Given that $a=2x^3$ and $b=\\dfrac{x}{y}$, express $ab^2$ in terms of $x$ and $y$." 13194139533355 17592186045585 true] [17592186110306 1072 #uuid "d8aca072-8ed5-5d49-8d4e-8bcc96a27ddb" 13194139533355 17592186045585 true] [17592186110306 1074 "First, we substitute for $a$ and $b$:\n\n$$\nab^{2} = 2x^{3}(\\frac{x}{y})^{2}\n$$\n\nThen, we apply the power of quotient rule:\n\n$$\n2x^{3}(\\frac{x}{y})^{2} = 2x^{3}(\\frac{x^{2}}{y^{2}})\n$$\n\nFinally, we multiply and apply the product rule:\n\n$$\n\\begin{aligned}\n2x^{3}(\\frac{x^{2}}{y^{2}}) &=  \\\\\n\\frac{2x^{3} \\cdot x^{2}}{y^{2}} &=  \\\\\n\\frac{2x^{3 + 2}}{y^{2}} &=  \\\\\n&= \\frac{2x^{5}}{y^{2}}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110307 1069 "e-1091" 13194139533355 17592186045585 true] [17592186110307 1071 "Simplify the expression $\\dfrac {\\sqrt{y}} {\\sqrt[3]{y}}$." 13194139533355 17592186045585 true] [17592186110307 1072 #uuid "cf539049-76f2-56c0-a890-00c2d767c0a8" 13194139533355 17592186045585 true] [17592186110307 1074 "First, we rewrite the radicals as fractional exponents:\n\n$$\n\\frac{\\sqrt{y}}{\\sqrt[3]{y}} = \\frac{y^{1/2}}{y^{1/3}}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\n\\frac{y^{1/2}}{y^{1/3}} &=  \\\\\ny^{1/2 - 1/3} &=  \\\\\ny^{3/6 - 2/6} &=  \\\\\n&= y^{1/6}\n\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\ny^{1/6} = \\sqrt[6]{y}\n$$" 13194139533355 17592186045585 true] [17592186110308 1069 "e-10925" 13194139533355 17592186045585 true] [17592186110308 1071 "Which of the following plots is the graph of $y = \\log (x)$?\n\n![](images/5f/5f38ded6da0c01657574cf0a40d86d2c5d2ce6b9ff1c29ceaaefbbe82103a277.png)" 13194139533355 17592186045585 true] [17592186110308 1072 #uuid "cb79d4e2-53ee-5a09-93ad-0b2e1bdc645e" 13194139533355 17592186045585 true] [17592186110308 1074 "Let's recall some of the basic properties of $y=\\log (x)$:\n\n- The graph passes through the point $(1,0)$.\n- For $x>1$, the function is positive and grows very slowly as we increase $x$. We say that $y\\rightarrow \\infty$ (slowly) as $x\\rightarrow \\infty$.\n- The domain is $x>0$, and the range is $-\\infty < y < \\infty$. The function is not defined at $x=0$.\n- The function has the vertical asymptote $x=0$.\n- The function is an increasing function.\n\nOf the given plots, the only one that displays all of these properties is II. (For example, plots I, III, and IV all do not have a vertical asymptote $x=0$.)" 13194139533355 17592186045585 true] [17592186110309 1069 "e-10926" 13194139533355 17592186045585 true] [17592186110309 1071 "What are the domain and range of the function $y=\\ln x$?" 13194139533355 17592186045585 true] [17592186110309 1072 #uuid "428c177d-8b83-50ad-9840-0dd3ffdf14ee" 13194139533355 17592186045585 true] [17592186110309 1074 "Let's recall the graph of $y = \\ln x$.\n\n![](images/00/004c1050017c1a0631d0dda46c8335248b4f05dad15645513b71e88588d4ed0c.png)\n\nThe domain of $y=\\ln x$ is $x \\in (0,\\infty)$ and the range is $y \\in (-\\infty,\\infty)$." 13194139533355 17592186045585 true] [17592186110310 1069 "e-10927" 13194139533355 17592186045585 true] [17592186110310 1071 "Which of the following statements are true regarding the function $y=\\ln(x)$?\n\n1. $y\\rightarrow-\\infty$ as $x\\rightarrow 0^+$\n2. The curve passes through the point $(1,0)$\n3. $y\\rightarrow\\infty$ as $x\\rightarrow -\\infty$" 13194139533355 17592186045585 true] [17592186110310 1072 #uuid "b162bb35-509f-5ed3-896c-19eb9c52deb2" 13194139533355 17592186045585 true] [17592186110310 1074 "First, let's plot the graph of $y=\\ln (x)$.\n\n![](images/d9/d9ca282050c64ffc1ab1950dd6d89288e6d65d680e45bbc9ef29c1a4ae2c3a67.png)\n\nNow, let's consider each statement.\n\n- Statement I is true. As $x$ approaches $0^+$, $y$ decreases without bound.\n- Statement II is true. Substituting $x=1$ into the equation of the curve gives a result of $0$:\n$y|= \\ln (1) = 0✓$\n- Statement III is false. The function is not defined for $x<0$, so the function is not defined as $x \\to -\\infty$.\n\nIn conclusion, only statements I and II are true." 13194139533355 17592186045585 true] [17592186110311 1069 "e-10932" 13194139533355 17592186045585 true] [17592186110311 1071 "What is the vertical asymptote of $y=\\log_{2} x$?" 13194139533355 17592186045585 true] [17592186110311 1072 #uuid "8e8032c5-b7cb-5e25-bc37-0621362ac2fa" 13194139533355 17592186045585 true] [17592186110311 1074 "Let's recall the graph of\n\n$$\ny=\\log_{2} x\n$$\n\n![](images/96/96d7da4dd7415b769803b9cea8ebf91b65db2ba5afe0249af9d16521eb0f4818.png)\n\nFrom the graph, we see that the function\n\n$$\ny=\\log_{2} x\n$$\n\nhas the vertical asymptote at $x=0$." 13194139533355 17592186045585 true] [17592186110312 1069 "e-11449" 13194139533355 17592186045585 true] [17592186110312 1071 "Which of the above triangles shows the median $\\overline{CD}$?\n\n![](images/95/95844bd855a9fce81234d02c0c8c8e34101ae654902374a7b02dd4919d08919f.png)" 13194139533355 17592186045585 true] [17592186110312 1072 #uuid "8f908dfc-770a-50ff-8892-8ba1ff0e0bc1" 13194139533355 17592186045585 true] [17592186110312 1074 "A *median* in a triangle is a line segment joining a vertex to the midpoint of the opposite side.\n\nWith that in mind, let's examine our triangles.\n\n- In triangle I, the line segment $\\overline{CD}$ is *not* a median since $D$ is not the midpoint of $\\overline{AB}$.\n- In triangle II, the line segment $\\overline{CD}$ is *not* a median since $D$ is not the midpoint of $\\overline{AB}$.\n- In triangle III, the line segment $\\overline{CD}$ is a median. Indeed, $D$ is the midpoint of $\\overline{AB}$. So, $\\overline{CD}$ connects the vertex $C$ with the midpoint $D$ of the opposite side $\\overline{AB}$.\n\nTherefore, the correct answer is \"III only.\"" 13194139533355 17592186045585 true] [17592186110313 1069 "e-11450" 13194139533355 17592186045585 true] [17592186110313 1071 "![](images/f5/f55dfe52967f65a617320575f687c696edac77b68e7bc0e41b3b36a7df36a609.png)\n\nGiven the triangle $\\triangle ABC$ shown above, draw the centroid $G$." 13194139533355 17592186045585 true] [17592186110313 1072 #uuid "445cd150-4881-50bc-be2d-d4ef44ee163a" 13194139533355 17592186045585 true] [17592186110313 1074 "The centroid is the intersection point of the medians $\\overline{AM}$, $\\overline{BL}$, and $\\overline{CK}$ of the triangle.\n\n![](images/86/86e023d6a5e356d2ba55cf874e0ccb2c56bdef4278904efce88529116cd38237.png)" 13194139533355 17592186045585 true] [17592186110314 1069 "e-11451" 13194139533355 17592186045585 true] [17592186110314 1071 "In the diagram below, $\\overline{VL}$ and $\\overline{WM}$ are medians of $\\triangle UVW$. Find $GM$ given that $WG=16\\: \\textrm{cm}$.\n\n![](images/14/14f5f6d9d48f332dd88a7fc5f09e9ccf8a32bc7c7a04854d3ca4cb3982f5577c.png)" 13194139533355 17592186045585 true] [17592186110314 1072 #uuid "77ac132d-7ec5-5278-87f7-90573b080473" 13194139533355 17592186045585 true] [17592186110314 1074 "All three medians of a triangle intersect at a point called the **centroid** of the triangle.\n\nIn our case, $G$ is the intersection of the medians $\\overline{VL}$ and $\\overline{WM}$. So, $G$ is the centroid.\n\nThe centroid of the triangle splits any median in the proportion $2:1$, starting from the corresponding vertex.\n\nSo, we get that\n\n$$\nWG: GM = 2: 1\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\nGM &= \\frac{1}{2}WG \\\\\n&= \\frac{1}{2} \\cdot 16 \\\\\n&= 8cm\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110315 1069 "e-11452" 13194139533355 17592186045585 true] [17592186110315 1071 "![](images/38/389655de3160fb49a126af97d2eb1c20a27bb3b2fcfd11e967faaf60d0626fba.png)\n\nWhat are the coordinates of the centroid $G$ of $\\triangle PQR$." 13194139533355 17592186045585 true] [17592186110315 1072 #uuid "fe43e8a7-5653-5a45-a29e-3c948a2e0d2e" 13194139533355 17592186045585 true] [17592186110315 1074 "The coordinates of the centroid for a triangle can be calculated by taking the average of the $x$- and $y$-coordinates of the vertices.\n\nIn our case, the vertices of the triangle are\n$P(-3,1), \\qquad Q(4,1), \\qquad R(2,5)$.\n\nThe averages are the following:\n\n$$\n\\begin{aligned}\n\\frac{x_{P} + x_{Q} + x_{R}}{3} &= \\frac{-3 + 4 + 2}{3} = \\frac{3}{3} = 1 \\\\\n\\frac{y_{P} + y_{Q} + y_{R}}{3} &= \\frac{1 + 1 + 5}{3} = \\frac{7}{3}\n\\end{aligned}\n$$\n\nTherefore, the centroid is\n\n$$\nG\\left(\\bbox[3pt,Gainsboro]{\\color{blue}1}, \\bbox[3pt,Gainsboro]{\\color{blue}\\dfrac 73}\\right)\n$$" 13194139533355 17592186045585 true] [17592186110316 1069 "e-1215" 13194139533355 17592186045585 true] [17592186110316 1071 "Sketch the graph of $f(x)=3^x$." 13194139533355 17592186045585 true] [17592186110316 1072 #uuid "99ab6141-164f-5f36-b55b-6e7fa1c8770c" 13194139533355 17592186045585 true] [17592186110316 1074 "The graph of $y=3^x$ has a $y$-intercept at $(0,1)$, grows rapidly for $x>0$, and approaches the asymptote $y=0$ for $x<0$.\n\nWhen $x=1$, we have $y=3^1 = 3$. Therefore, another point on the graph is $(1,3)$.\n\nWe draw the graph through this point as follows:\n\n![](images/43/4367540979396fd0106204a0f71d9368a70ce3538d8e7239ac250e5fc45644f1.png)" 13194139533355 17592186045585 true] [17592186110317 1069 "e-1216" 13194139533355 17592186045585 true] [17592186110317 1071 "Which of the following statements are true in relation to the function $f(x) = 3^x$?\n\n1. It passes through the point $(1,3)$.\n2. $f(x)\\rightarrow -\\infty$ as $x\\rightarrow -\\infty$.\n3. The graph of $y=f(x)$ has a vertical asymptote $x=0$." 13194139533355 17592186045585 true] [17592186110317 1072 #uuid "45473f44-206e-5eb6-a663-04d264e6a890" 13194139533355 17592186045585 true] [17592186110317 1074 "Let's start by recalling the graph of $y=3^x$:\n\n![](images/83/837e535b83d91c67e7e5c592bd71e9b9ebe59c216fc75ba4f99de2ccec2546ae.png)\n\nNow, let's look at each statement:\n\n- Statement I is true because $f(1) = 3^1 = 3$.\n- Statement II is false, since $f(x)\\rightarrow 0$ as $x\\rightarrow -\\infty$.\n- Statement III is false. The graph has a *horizontal* asymptote $y=0$.\n\nIn conclusion, only statement I is true." 13194139533355 17592186045585 true] [17592186110318 1069 "e-1217" 13194139533355 17592186045585 true] [17592186110318 1071 "Plot the graph of $y=\\dfrac{1}{2}(2)^x$." 13194139533355 17592186045585 true] [17592186110318 1072 #uuid "3661675e-e7da-5834-97cf-017e4e084275" 13194139533355 17592186045585 true] [17592186110318 1074 "First we plot the graph of $y=2^{x}$:\n\n![](images/94/946d749b38d09eebd11eba2821be07e61c6551f17ab9cff0149cdbf600257796.png)\n\nThen, we scale this graph vertically by a factor of\n\n$$\n\\dfrac12\n$$\n\nThe $y$-intercept becomes\n\n$$\n\\left(0,\\dfrac{1}{2} \\right)\n$$\n\nand the resulting graph is as follows:\n\n![](images/bc/bc971bc35c4f54baba330aa074bf9618fb7a755593f5f9e713bcc90142da6394.png)" 13194139533355 17592186045585 true] [17592186110319 1069 "e-1223" 13194139533355 17592186045585 true] [17592186110319 1071 "Which of the following statements are true in relation to the function $f(x) = (0.2)^x$?\n\n1. The domain is $x\\in(-\\infty,\\infty)$ and the range is $y\\gt 0$.\n2. The graph of $y=f(x)$ passes through the point $\\left(1,0.2\\right)$.\n3. $f(x) \\to -\\infty$ as $x \\to -\\infty$." 13194139533355 17592186045585 true] [17592186110319 1072 #uuid "c02ce0b7-d660-5d31-8147-303a9e6f806d" 13194139533355 17592186045585 true] [17592186110319 1074 "Let's go through the statements one by one.\n\n- Statement I is true. The function $f(x) = (0.2)^x$ is defined for all input values $x$, and, the set of possible outputs consists of all the positive numbers.\n- Statement II is true. When we evaluate the function at $x=1$, we have\n$f(1) = (0.2)^1 = 0.2$.\n- Statement III is false. As $x$ decreases, the function value gets larger and larger, approaching *positive* infinity. Therefore $f(x) \\to \\infty$ as $x \\to -\\infty$.\n\nIn conclusion, only statements I and II are true." 13194139533355 17592186045585 true] [17592186110320 1069 "e-1224" 13194139533355 17592186045585 true] [17592186110320 1071 "Plot the graph of $y=\\dfrac{1}{4}\\left(\\dfrac{1}{3}\\right)^x$." 13194139533355 17592186045585 true] [17592186110320 1072 #uuid "90054a4d-adcf-56b8-ab73-86048bc0f4d4" 13194139533355 17592186045585 true] [17592186110320 1074 "First we plot the graph of\n\n$$\ny=\\left(\\dfrac{1}{3}\\right)^x\n$$\n\n![](images/f7/f75c2ffd657117da715cd6ec476e39b073dc24e069f1b171d585ac7581f96938.png)\n\nThen, we scale this graph by a factor of\n\n$$\n\\dfrac{1}{4}\n$$\n\nThe $y$-intercept becomes\n\n$$\n\\left(0,\\dfrac{1}{4} \\right)\n$$\n\nand the resulting graph is as follows:\n\n![](images/ec/ec7207a7bc6a224d32c5ed5f6c77eb30f093beb4cfda03eea1d8da0926befe8a.png)" 13194139533355 17592186045585 true] [17592186110321 1069 "e-1225" 13194139533355 17592186045585 true] [17592186110321 1071 "The graph below shows $y=k\\left(\\dfrac{2}{5}\\right)^x$. What is the value of $k$?\n\n![](images/24/247e8b4712be05f38cfba373d930c5c8ee65ab64c9619e4ee74ec488fbd0c61d.png)" 13194139533355 17592186045585 true] [17592186110321 1072 #uuid "055bdf27-d354-57d7-96a6-de3300053035" 13194139533355 17592186045585 true] [17592186110321 1074 "To plot the graph of\n\n$$\ny=k\\left(\\dfrac25\\right)^x\n$$\n\nwe take the graph of\n\n$$\ny=\\left(\\dfrac 25\\right)^x\n$$\n\nand stretch it vertically by a scale factor of $k$. Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k)$.\n\nComparing the point $(0,1.5)$ on the graph to $(0,k)$, we see that we must have $k=1.5$." 13194139533355 17592186045585 true] [17592186110322 1069 "e-13058" 13194139533355 17592186045585 true] [17592186110322 1071 "If $z + 9 = 12$, then what is the value of $z$?" 13194139533355 17592186045585 true] [17592186110322 1072 #uuid "4fe9cbfc-9788-5596-83f2-56bddc767eb2" 13194139533355 17592186045585 true] [17592186110322 1074 "If we substitute\n\n$$\n{\\color{blue}{z}}={\\color{blue}{3}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\nz + 9 &= 12 \\\\\n3 + 9 &= 12 \\\\\n12 &= 12✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $z=3$." 13194139533355 17592186045585 true] [17592186110323 1069 "e-13059" 13194139533355 17592186045585 true] [17592186110323 1071 "What is the solution to the equation $a - 3 = 4$?" 13194139533355 17592186045585 true] [17592186110323 1072 #uuid "8f332559-5eb1-52ca-835e-b0da5a5a29ad" 13194139533355 17592186045585 true] [17592186110323 1074 "If we substitute\n\n$$\n{\\color{blue}{a}}={\\color{blue}{7}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\na - 3 &= 4 \\\\\n7 - 3 &= 4 \\\\\n4 &= 4✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $a=7$." 13194139533355 17592186045585 true] [17592186110324 1069 "e-13060" 13194139533355 17592186045585 true] [17592186110324 1071 "If $2b = 8$, then $b=$" 13194139533355 17592186045585 true] [17592186110324 1072 #uuid "5204a10c-ec1e-5276-95f2-0842b4c1bdf5" 13194139533355 17592186045585 true] [17592186110324 1074 "If we substitute\n\n$$\n{\\color{blue}{b}}={\\color{blue}{4}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\n2b &= 8 \\\\\n2 \\cdot 4 &= 8 \\\\\n8 &= 8✓\n\\end{aligned}\n$$\n\nTherefore, the solution is $b=4$." 13194139533355 17592186045585 true] [17592186110325 1069 "e-13061" 13194139533355 17592186045585 true] [17592186110325 1071 "If $\\dfrac{15}{c} = 5$, then $c=$" 13194139533355 17592186045585 true] [17592186110325 1072 #uuid "e2be2f3b-d507-5447-9ed0-d164374a8b4a" 13194139533355 17592186045585 true] [17592186110325 1074 "If we substitute\n\n$$\n{\\color{blue}{c}}={\\color{blue}{3}}\n$$\n\ninto the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\n\\frac{15}{c} &= 5 \\\\\n\\frac{15}{3} &= 5 \\\\\n5 &= 5✓\n\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\nc = \\bbox[3pt,Gainsboro]{\\color{blue}3}\n$$" 13194139533355 17592186045585 true] [17592186110326 1069 "e-13077" 13194139533355 17592186045585 true] [17592186110326 1071 "Solve the equation $\\dfrac{2x+5}{30} = \\dfrac{1}{2}$." 13194139533355 17592186045585 true] [17592186110326 1072 #uuid "7df7a073-8131-5732-b353-f89484052e38" 13194139533355 17592186045585 true] [17592186110326 1074 "First, we cross-multiply:\n\n$$\n\\begin{aligned}\n\\frac{2x + 5}{30} &= \\frac{1}{2} \\\\\n(2x + 5) \\cdot 2 &= 30 \\cdot 1\n\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}\n(2x + 5) \\cdot 2 &= 30 \\cdot 1 \\\\\n4x + 10 &= 30 \\\\\n4x + 10 - 10 &= 30 - 10 \\\\\n4x &= 20 \\\\\n\\frac{4x}{4} &= \\frac{20}{4} \\\\\nx &= 5\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110327 1069 "e-13078" 13194139533355 17592186045585 true] [17592186110327 1071 "Solve for $x$, where $\\dfrac{6-2x}{2} = \\dfrac{6-x}{3}$." 13194139533355 17592186045585 true] [17592186110327 1072 #uuid "4041cf6f-61b8-5794-9988-436722985bcd" 13194139533355 17592186045585 true] [17592186110327 1074 "First, we cross-multiply:\n\n$$\n\\begin{aligned}\n\\frac{6 - 2x}{2} &= \\frac{6 - x}{3} \\\\\n(6 - 2x) \\cdot 3 &= 2 \\cdot (6 - x)\n\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}\n(6 - 2x) \\cdot 3 &= 2 \\cdot (6 - x) \\\\\n18 - 6x &= 12 - 2x \\\\\n18 - 6x - 18 &= 12 - 2x - 18 \\\\\n- 6x &= -2x - 6 \\\\\n- 6x + 2x &= -2x - 6 + 2x \\\\\n- 4x &= -6 \\\\\n\\frac{-4x}{-4} &= \\frac{-6}{-4} \\\\\nx &= \\frac{6}{4} \\\\\nx &= \\frac{3}{2}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110328 1069 "e-13079" 13194139533355 17592186045585 true] [17592186110328 1071 "Solve for $u$, where $\\dfrac{u+2}{3} =-\\dfrac{3-u}{2}$." 13194139533355 17592186045585 true] [17592186110328 1072 #uuid "d97adcd5-65ea-5cf7-905a-db954e43904b" 13194139533355 17592186045585 true] [17592186110328 1074 "We transfer the negative into the numerator of the fraction, and proceed with cross-multiplication:\n\n$$\n\\begin{aligned}\n\\frac{u + 2}{3} &= -\\frac{3 - u}{2} \\\\\n\\frac{u + 2}{3} &= (- (3 - u))/(2) \\\\\n\\frac{u + 2}{3} &= \\frac{-3 + u}{2} \\\\\n(u + 2) \\cdot 2 &= 3 \\cdot (-3 + u)\n\\end{aligned}\n$$\n\nThen, we proceed as usual to solve the equation:\n\n$$\n\\begin{aligned}\n(u + 2) \\cdot 2 &= 3 \\cdot (-3 + u) \\\\\n2u + 4 &= -9 + 3u \\\\\n2u + 4 - 2u &= -9 + 3u - 2u \\\\\n4 &= -9 + u \\\\\n4 + 9 &= -9 + u + 9 \\\\\n13 &= u\n\\end{aligned}\n$$\n\nTherefore, $u=13$." 13194139533355 17592186045585 true] [17592186110329 1069 "e-1410" 13194139533355 17592186045585 true] [17592186110329 1071 "Calculate the values of $x$ that satisfy $(2x-1)(5x+3)=0$." 13194139533355 17592186045585 true] [17592186110329 1072 #uuid "82b23364-0fd8-5a41-b983-2f7474847c6c" 13194139533355 17592186045585 true] [17592186110329 1074 "Applying the zero product rule, we get\n\n$$\n2x-1=0\\qquad \\textrm{or}\\qquad 5x+3=0\n$$\n\nWe solve each of the equations separately, as follows:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}2x - 1 &= 0 & 5x + 3|= 0 \\\\ 2x|= 1 & 5x|=-3 \\\\ x|= \\frac{1}{2} & x|=-\\frac{3}{5}\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\nx=-\\dfrac{3}{5},\\dfrac{1}{2}\n$$" 13194139533355 17592186045585 true] [17592186110330 1069 "e-1411" 13194139533355 17592186045585 true] [17592186110330 1071 "Solve the equation $x(x-16) = 0$." 13194139533355 17592186045585 true] [17592186110330 1072 #uuid "d3a8f605-3f19-5615-9171-dd53a8f984f2" 13194139533355 17592186045585 true] [17592186110330 1074 "Applying the zero product rule, we get\n\n$$\nx = 0\\qquad \\textrm{or}\\qquad x-16=0\n$$\n\nSolving each of these equations separately, we find that the solutions are $x=0$ and $x=16$." 13194139533355 17592186045585 true] [17592186110331 1069 "e-1412" 13194139533355 17592186045585 true] [17592186110331 1071 "Find a quadratic equation that has roots $x=5$ and $x=7$." 13194139533355 17592186045585 true] [17592186110331 1072 #uuid "982b2b4b-79b0-548c-a49b-46c732639d9a" 13194139533355 17592186045585 true] [17592186110331 1074 "The given roots $x=5$ and $x=7$ are the solutions to the equations $x-5=0$ and $x-7=0$, respectively.\n\nSo, according to the zero product rule, they are also the solutions of the product\n\n$$\n(x-5)(x-7)=0\n$$\n\nWe multiply out the product and collect like terms to produce a quadratic equation in standard form:\n\n$$\n\\begin{aligned} (x-5)(x-7) &=0 \\\\ x(x-7) - 5(x-7) &=0 \\\\ x^2 - 7x - 5x + 35 &= 0 \\\\ x^2 -12x+35 &=0 \\end{aligned}\n$$\n\nTherefore, a quadratic equation that has roots $x=5$ and $x=7$ is\n\n$$\nx^2 -12x+35=0\n$$" 13194139533355 17592186045585 true] [17592186110332 1069 "e-14138" 13194139533355 17592186045585 true] [17592186110332 1071 "Find the solution to $\\dfrac {1} {x-2} = 5$." 13194139533355 17592186045585 true] [17592186110332 1072 #uuid "deda4937-0332-5584-b6a1-fa840e750be1" 13194139533355 17592186045585 true] [17592186110332 1074 "First, note that $x=2$ cannot be a solution. This is because if $x=2$, then the rational term would be\n\n$$\n\\dfrac{1}{0}\n$$\n\nwhich is undefined because it has a zero denominator.\n\nTo solve the equation, we first multiply both sides by the denominator $(x-2)$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\n\\frac{1}{x - 2} &= 5 \\\\\n(x - 2) \\cdot \\frac{1}{x - 2} &= (x - 2) \\cdot 5 \\\\\n(x - 2) \\cdot \\frac{1}{x - 2} &= 5x - 10 \\\\\n1 &= 5x - 10\n\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}\n1 &= 5x - 10 \\\\\n1 + 10 &= 5x - 10 + 10 \\\\\n11 &= 5x \\\\\n\\frac{11}{5} &= \\frac{5x}{5} \\\\\n\\frac{11}{5} &= x\n\\end{aligned}\n$$\n\nSince\n\n$$\nx=\\dfrac{11}{5}\n$$\n\nis different from $x=2$, we can accept it as a solution. Thus, the solution is\n\n$$\nx=\\dfrac{11}{5}\n$$" 13194139533355 17592186045585 true] [17592186110333 1069 "e-14141" 13194139533355 17592186045585 true] [17592186110333 1071 "Solve $\\dfrac {3x} {x+1} = 2$." 13194139533355 17592186045585 true] [17592186110333 1072 #uuid "9640178a-cada-5fd6-8622-9bef515ed443" 13194139533355 17592186045585 true] [17592186110333 1074 "First, note that $x=-1$ cannot be a solution since division by $0$ is undefined.\n\nTo solve the equation, we first multiply both sides by the denominator $(x+1)$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\n\\frac{3x}{x + 1} &= 2 \\\\\n(x + 1) \\cdot \\frac{3x}{x + 1} &= (x + 1) \\cdot 2 \\\\\n(x + 1) \\cdot \\frac{3x}{x + 1} &= 2x + 2 \\\\\n3x &= 2x + 2\n\\end{aligned}\n$$\n\nThen, we apply the addition principle:\n\n$$\n\\begin{aligned}\n3x &= 2x + 2 \\\\\n3x - 2x &= 2x + 2 - 2x \\\\\nx &= 2\n\\end{aligned}\n$$\n\nSince $x = 2$ is different from $x=-1$, we can accept it as a solution. Thus, the solution is $x=2$." 13194139533355 17592186045585 true] [17592186110334 1069 "e-14144" 13194139533355 17592186045585 true] [17592186110334 1071 "Solve the equation $\\dfrac {1} {2x+1} = 2$." 13194139533355 17592186045585 true] [17592186110334 1072 #uuid "d4adcae2-06f8-5d3d-ac48-1aca6c8a0c29" 13194139533355 17592186045585 true] [17592186110334 1074 "First, note that the denominator $2x+1$ cannot be zero, since division by $0$ is undefined. Therefore we cannot have\n\n$$\n2x+1=0\n$$\n\nwhich means\n\n$$\nx=-\\dfrac{1}{2}\n$$\n\ncannot be a solution.\n\nTo solve the equation, we first multiply both sides by the denominator $(2x+1)$ to get rid of the fraction:\n\n$$\n\\begin{aligned}\n\\frac{1}{2x + 1} &= 2 \\\\\n(2x + 1) \\cdot \\frac{1}{2x + 1} &= (2x + 1) \\cdot 2 \\\\\n(2x + 1) \\cdot \\frac{1}{2x + 1} &= 4x + 2 \\\\\n1 &= 4x + 2\n\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}\n1 &= 4x + 2 \\\\\n1 - 2 &= 4x + 2 - 2 \\\\\n- 1 &= 4x \\\\\n\\frac{-1}{4} &= \\frac{4x}{4} \\\\\n- \\frac{1}{4} &= x\n\\end{aligned}\n$$\n\nSince\n\n$$\nx = -\\dfrac{1}{4}\n$$\n\nis different from\n\n$$\nx=-\\dfrac{1}{2}\n$$\n\n, we can accept it as a solution. Thus, the solution is\n\n$$\nx=-\\dfrac{1}{4}\n$$" 13194139533355 17592186045585 true] [17592186110335 1069 "e-1424" 13194139533355 17592186045585 true] [17592186110335 1071 "Solve the equation $-2x^2 +9x -4=0$." 13194139533355 17592186045585 true] [17592186110335 1072 #uuid "1cee05e3-81b9-5207-b937-2c0e4057eb6d" 13194139533355 17592186045585 true] [17592186110335 1074 "First, we multiply by $-1$ so that the leading coefficient becomes positive.\n\n$$\n\\begin{aligned}\n-2x^{2} + 9x - 4 &= 0 \\\\\n(-1) \\cdot (-2x^{2} + 9x - 4) &= (-1) \\cdot 0 \\\\\n2x^{2} - 9x + 4 &= 0\n\\end{aligned}\n$$\n\nTo factor the left-hand side, we need two numbers that multiply to\n\n$$\n2 \\cdot 4 = 8\n$$\n\nand add to $-9$. These two numbers are $-1$ and $-8$, so we can factor the left-hand side as follows:\n\n$$\n\\begin{aligned} 2x^2 -9x +4 &=0 \\\\ 2x^2 -1x - 8x +4 &=0 \\\\ (2x^2 -1x) + (-8x +4) &= 0 \\\\ x(2x-1) -4(2x-1) &= 0 \\\\ (2x-1)(x-4) &=0 \\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2x-1=0 \\qquad\\text{or}\\qquad x-4=0\n$$\n\nwhich in turn gives\n\n$$\nx=\\dfrac{1}{2} \\qquad\\text{or}\\qquad x=4\n$$\n\nTherefore, the solutions are\n\n$$\nx=\\dfrac{1}{2},4\n$$" 13194139533355 17592186045585 true] [17592186110336 1069 "e-1425" 13194139533355 17592186045585 true] [17592186110336 1071 "Solve the equation $45x^2 +24 x -36 =0$." 13194139533355 17592186045585 true] [17592186110336 1072 #uuid "30764242-5fc0-5d42-a49b-9a4afc814377" 13194139533355 17592186045585 true] [17592186110336 1074 "First, notice that $45$, $24$ and $36$ have a common factor of $3$. So, we can divide by $3$ to simplify our equation:\n\n$$\n\\begin{aligned}\n\\frac{45x^{2} + 24x - 36}{3} &= \\frac{0}{3} \\\\\n\\frac{45}{3}x^{2} + \\frac{24}{3}x - \\frac{36}{3} &= \\frac{0}{3} \\\\\n15x^{2} + 8x - 12 &= 0\n\\end{aligned}\n$$\n\nTo factor the left-hand side, we need two numbers that multiply to\n\n$$\n15 \\cdot (-12)=-180\n$$\n\nand sum to $8$. These two numbers are $-10$ and $18$, so we can factor the left-hand side as follows:\n\n$$\n\\begin{aligned} 15x^2 +8 x -12 &=0 \\\\ 15x^2 -10x +18 x -12 &=0 \\\\ (15x^2 -10x) + (18 x -12) &= 0 \\\\ 5x(3x-2) + 6(3x-2) &= 0 \\\\ (5x+6)(3x-2) &=0 \\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n5x+6=0 \\qquad\\text{or}\\qquad 3x-2=0\n$$\n\nwhich in turn gives\n\n$$\nx=-\\dfrac{6}{5} \\qquad\\text{or}\\qquad x=\\dfrac{2}{3}\n$$\n\nTherefore, the solutions are\n\n$$\nx=-\\dfrac{6}{5}, \\dfrac{2}{3}\n$$" 13194139533355 17592186045585 true] [17592186110337 1069 "e-14250" 13194139533355 17592186045585 true] [17592186110337 1071 "The number of students using a new phone app doubles every week. There were $50$ users initially. How many students will be using the app after $4$ weeks?" 13194139533355 17592186045585 true] [17592186110337 1072 #uuid "27d792f0-b574-531e-9907-80891a464ece" 13194139533355 17592186045585 true] [17592186110337 1074 "There are $50$ users initially, and this number *doubles* every week. Remember that doubling means to multiply by a factor of $2$.\n\nTherefore, we can write down the following:\n\n- After $1$ week, there will be $50\\cdot 2$ users.\n- After ${\\color{blue}{2}}$ weeks, there will be $(50\\cdot 2) \\cdot 2 = 50\\cdot 2^{\\color{blue}{2}}$ users.\n- After ${\\color{blue}{3}}$ weeks, there will be $(50\\cdot 2^2) \\cdot 2 = 50\\cdot 2^{\\color{blue}{3}}$ users.\n- After ${\\color{blue}{4}}$ weeks, there will be $(50\\cdot 2^3) \\cdot 2 = 50\\cdot 2^{\\color{blue}{4}}$ users.\n\nSo the total number of users after $4$ weeks is given by the expression $50\\cdot 2^{\\color{blue}{4}}$.\n\nIf we go ahead and evaluate this expression, we get\n\n$$\n50\\cdot 2^4 = 50\\cdot 16 = 800\n$$\n\nTherefore, there will be $800$ users after $4$ weeks." 13194139533355 17592186045585 true] [17592186110338 1069 "e-14254" 13194139533355 17592186045585 true] [17592186110338 1071 "Collectible baseball cards increase in value by $20\\%$ every year. If Josh's collection is currently worth $\\[math]1\\,200$, find an expression that gives the value of his collection in $8$ years." 13194139533355 17592186045585 true] [17592186110338 1072 #uuid "139799dc-8baf-5e41-9241-23e2ede77162" 13194139533355 17592186045585 true] [17592186110338 1074 "The collection is worth $\\[math]1\\,200$, and increases by $20\\%$ every year.\n\nThe number $20\\%$ written as a decimal is $0.2$. So, an increase of $20\\%$ corresponds to multiplication by a factor of\n\n$$\n1+0.2 = 1.2\n$$\n\nTherefore, we can write down the following:\n\n- After $1$ year, the collection will be worth $1\\,200 \\cdot (1.2)$ dollars.\n- After ${\\color{blue}{2}}$ years, the collection will be worth $1\\,200\\cdot (1.2) \\cdot 1.2 = 1\\,200 \\cdot (1.2)^{\\color{blue}{2}}$ dollars.\n- After ${\\color{blue}{3}}$ years, the collection will be worth $1\\,200\\cdot (1.2^2) \\cdot 1.2 = 1\\,200 \\cdot (1.2)^{\\color{blue}{3}}$ dollars.\n- After ${\\color{blue}{4}}$ years, the collection will be worth $1\\,200\\cdot (1.2^3) \\cdot 1.2 = 1\\,200 \\cdot (1.2)^{\\color{blue}{4}}$ dollars.\n- $\\ldots$\n\nIf we continue the pattern, we can see that the collection will be worth $1\\,200 \\cdot (1.2)^{\\color{blue}{8}}$ dollars after ${\\color{blue}{8}}$ years.\n\nIf we evaluate this expression using a calculator, rounding to the nearest dollar, we get\n\n$$\n1\\,200 \\cdot (1.2)^{\\color{blue}{8}} \\approx 5\\,160\n$$\n\nSo, in eight years, the collection will be worth approximately $\\[/math]\\,5\\,160$." 13194139533355 17592186045585 true] [17592186110339 1069 "e-1426" 13194139533355 17592186045585 true] [17592186110339 1071 "Solve the equation $7x^2-x+1=6x-3x^2$." 13194139533355 17592186045585 true] [17592186110339 1072 #uuid "7b289e73-5084-5755-84e6-f5b1f390df95" 13194139533355 17592186045585 true] [17592186110339 1074 "First, we bring all terms to the left-hand side:\n\n$$\n\\begin{aligned} 7x^2-x+1&=6x-3x^2 \\\\ 7x^2-x+1 -6x+3x^2&=0 \\\\ (7x^2+3x^2) + (-x-6x) +1 &=0 \\\\ 10x^2-7x+1 &=0 \\end{aligned}\n$$\n\nTo factor the left-hand side, we need two numbers that multiply to\n\n$$\n10 \\cdot 1=10\n$$\n\nand sum to $-7$. These two numbers are $-2$ and $-5$, so we can factor the left-hand side as follows:\n\n$$\n\\begin{aligned} 10x^2-7x+1 &= 0 \\\\ 10x^2-2x-5x+1 &= 0 \\\\ (10x^2-2x) + (-5x +1) &= 0 \\\\ 2x(5x -1) - (5x -1) &= 0 \\\\ (2x-1)(5x-1)&=0 \\end{aligned}\n$$\n\nApplying the zero product rule, we have\n\n$$\n2x-1=0 \\qquad\\text{or}\\qquad 5x-1=0\n$$\n\nwhich in turn gives\n\n$$\nx=\\dfrac{1}{2} \\qquad\\text{or}\\qquad x=\\dfrac{1}{5}\n$$\n\nTherefore, the solutions are\n\n$$\nx=\\dfrac{1}{2},\\dfrac{1}{5}\n$$" 13194139533355 17592186045585 true] [17592186110340 1069 "e-14359" 13194139533355 17592186045585 true] [17592186110340 1071 "Which of the following lines is perpendicular to $y= -\\dfrac{2}{5}x-3$?\n\n1. $y = 5x + 1$\n2. $y = \\dfrac{5}{2}x + 3$\n3. $y = -\\dfrac{x}{2} + 5$" 13194139533355 17592186045585 true] [17592186110340 1072 #uuid "4cc37ad7-b382-5b7e-bcda-92b2818c5650" 13194139533355 17592186045585 true] [17592186110340 1074 "For the two lines to be perpendicular, their slopes must multiply to $-1$.\n\nThe line\n\n$$\ny=-\\dfrac{2}{5}x-3\n$$\n\nis in slope-intercept form, and its slope is\n\n$$\n-\\dfrac{2}{5}\n$$\n\nLooking at the answer choices, the line\n\n$$\ny = \\dfrac{5}{2}x + 3\n$$\n\nhas a slope of\n\n$$\n\\dfrac{5}{2}\n$$\n\nMultiplying the slopes together, we have\n\n$$\n\\left(-\\dfrac{2}{5}\\right) \\cdot \\dfrac{5}{2} = -1\n$$\n\nSince the slopes multiply to $-1$, we conclude that the line\n\n$$\ny = \\dfrac{5}{2}x + 3\n$$\n\nis perpendicular to the given line.\n\nSo, the correct answer is \"II only\"." 13194139533355 17592186045585 true] [17592186110341 1069 "e-14362" 13194139533355 17592186045585 true] [17592186110341 1071 "The lines $y=2x+9$ and $3y+kx = 12$ are perpendicular. What is the value of $k$?" 13194139533355 17592186045585 true] [17592186110341 1072 #uuid "a53a3337-108b-5129-b203-ff70ce8d0abe" 13194139533355 17592186045585 true] [17592186110341 1074 "For the two lines to be perpendicular, their slopes must multiply to $-1$.\n\n- The first line is in slope-intercept form, and the slope is the $x$-coefficient. So the slope of the line $y=2x+9$ is $2$.\n- To find the slope of $3y+kx = 12$, we convert to slope-intercept form:\n$3y + kx|= 12; 3y|=-kx + 12; y|=-\\frac{k}{3}x + 4$\nTherefore, the slope of the line $3y +kx = 12$ is $-\\dfrac{k}{3}$.\n\nMultiplying the slopes together, we have\n\n$$\n2 \\cdot\\left(-\\dfrac{k}{3}\\right) = -1\\qquad\\Longrightarrow\\qquad k = \\dfrac{3}{2}\n$$" 13194139533355 17592186045585 true] [17592186110342 1069 "e-14365" 13194139533355 17592186045585 true] [17592186110342 1071 "Find the equation of the line that is perpendicular to $x=2$ and passes through the point $(3,4)$." 13194139533355 17592186045585 true] [17592186110342 1072 #uuid "5eca5ef2-627f-5d32-8edb-88e223b11d71" 13194139533355 17592186045585 true] [17592186110342 1074 "Since the line $x=2$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k$.\n\nThe perpendicular line needs to go through the point $(3,4)$, which has a $y$-coordinate of $4$. So, the perpendicular line is $y=4$." 13194139533355 17592186045585 true] [17592186110343 1069 "e-14544" 13194139533355 17592186045585 true] [17592186110343 1071 "The data below is taken from the table of values of the cumulative distribution function $\\Phi(z)$ for the standard normal distribution. Given that $X \\sim N(\\mu, 6^2)$ with $P(X > 4) = 0.1841$, find $\\mu$.\n\n| $z$ | $\\, 0.00 \\,$ | $\\, 0.01 \\,$ | $\\, 0.02 \\,$ |\n| --- | ---: | ---: | ---: |\n| $\\, 0.7 \\,$ | $\\, 0.7580 \\,$ | $\\, 0.7611 \\,$ | $\\, 0.7642 \\,$ |\n| $\\, 0.8 \\,$ | $\\, 0.7881 \\,$ | $\\, 0.7910 \\,$ | $\\, 0.7939 \\,$ |\n| $\\, 0.9 \\,$ | $\\, 0.8159 \\,$ | $\\, 0.8186 \\,$ | $\\, 0.8212 \\,$ |" 13194139533355 17592186045585 true] [17592186110343 1072 #uuid "9662033b-2a3a-5d80-91ad-ed542898b80b" 13194139533355 17592186045585 true] [17592186110343 1074 "First, we convert the given probability into a cumulative probability using the complement:\n\n$$\n\\begin{aligned}\nP(X \\le 4) &= 1 - P(X > 4) \\\\\n&= 1 - 0.1841 \\\\\n&= 0.8159\n\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(X \\le 4) &= 0.8159 \\\\\nP(Z \\le \\frac{4 - μ}{6}) &= 0.8159 \\\\\nΦ(\\frac{4 - μ}{6}) &= 0.8159 \\\\\n\\frac{4 - μ}{6} &= Φ^{-1}(0.8159)\n\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\n\\Phi(0.90) = 0.8159 \\quad \\Rightarrow \\quad \\Phi^{-1}(0.8159) = 0.90\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\frac{4 - μ}{6} &= 0.90 \\\\\n4 - μ &= 5.4 \\\\\nμ &= -1.4\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110344 1069 "e-14545" 13194139533355 17592186045585 true] [17592186110344 1071 "The data below is taken from the table of values of the cumulative distribution function $\\Phi(z)$ for the standard normal distribution. Given that $X\\sim N(2.5, \\sigma^2)$ and $P(X \\geq 3) = 0.4013$, find $\\sigma^2$.\n\n| $z$ | $\\, 0.03 \\,$ | $\\, 0.04 \\,$ | $\\, 0.05 \\,$ |\n| --- | ---: | ---: | ---: |\n| $\\, 0.2 \\,$ | $\\, 0.5910 \\,$ | $\\, 0.5948 \\,$ | $\\, 0.5987 \\,$ |\n| $\\, 0.3 \\,$ | $\\, 0.6293 \\,$ | $\\, 0.6331 \\,$ | $\\, 0.6368 \\,$ |\n| $\\, 0.4 \\,$ | $\\, 0.6664 \\,$ | $\\, 0.6700 \\,$ | $\\, 0.6736 \\,$ |" 13194139533355 17592186045585 true] [17592186110344 1072 #uuid "35cc4c4c-79fb-5ae2-94e0-79f007af832b" 13194139533355 17592186045585 true] [17592186110344 1074 "First, we convert the given probability into a cumulative probability using the complement:\n\n$$\n\\begin{aligned}\nP(X \\le 3) &= 1 - P(X \\ge 3) \\\\\n&= 1 - 0.4013 \\\\\n&= 0.5987\n\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(X \\le 3) &= 0.5987 \\\\\nP(Z \\le \\frac{3 - 2.5}{σ}) &= 0.5987 \\\\\nΦ(\\frac{0.5}{σ}) &= 0.5987 \\\\\n\\frac{0.5}{σ} &= Φ^{-1}(0.5987)\n\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\n\\Phi(0.25) = 0.5987 \\quad \\Rightarrow \\quad \\Phi^{-1}(0.5987) = 0.25\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\frac{0.5}{σ} &= 0.25 \\\\\nσ &= \\frac{0.5}{0.25} \\\\\nσ &= 2\n\\end{aligned}\n$$\n\nFinally,\n\n$$\nσ^{2} = 2^{2} = 4\n$$" 13194139533355 17592186045585 true] [17592186110345 1069 "e-14546" 13194139533355 17592186045585 true] [17592186110345 1071 "The data below is taken from the table of values of the cumulative distribution function $\\Phi(z)$ for the standard normal distribution. Given that $X \\sim N(0, \\sigma^2)$ is a normal random variable with $P(-3.18 < X < 3.18) = 0.4038$, find $\\sigma$.\n\n| $z$ | $\\, 0.02 \\,$ | $\\, 0.03 \\,$ | $\\, 0.04 \\,$ |\n| --- | ---: | ---: | ---: |\n| $\\, 0.4 \\,$ | $\\, 0.6628 \\,$ | $\\, 0.6664 \\,$ | $\\, 0.6700 \\,$ |\n| $\\, 0.5 \\,$ | $\\, 0.6985 \\,$ | $\\, 0.7019 \\,$ | $\\, 0.7054 \\,$ |\n| $\\, 0.6 \\,$ | $\\, 0.7324 \\,$ | $\\, 0.7357 \\,$ | $\\, 0.7389 \\,$ |" 13194139533355 17592186045585 true] [17592186110345 1072 #uuid "2a8633b4-f937-57e3-899d-c3176f07a48f" 13194139533355 17592186045585 true] [17592186110345 1074 "First, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}\nP(-3.18 < X < 3.18) &= 0.4038 \\\\\n2P(0 < X < 3.18) &= 0.4038 \\\\\nP(0 < X < 3.18) &= 0.2019 \\\\\nP(X < 3.18) - P(X < 0) &= 0.2019 \\\\\nP(X < 3.18) - 0.5 &= 0.2019 \\\\\nP(X < 3.18) &= 0.7019 \\\\\nP(X \\le 3.18) &= 0.7019\n\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(X \\le 3.18) &= 0.7019 \\\\\nP(Z \\le \\frac{3.18 - 0}{σ}) &= 0.7019 \\\\\nΦ(\\frac{3.18}{σ}) &= 0.7019 \\\\\n\\frac{3.18}{σ} &= Φ^{-1}(0.7019)\n\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\n\\Phi(0.53) = 0.7019 \\quad \\Rightarrow \\quad \\Phi^{-1}(0.7019) = 0.53\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\frac{3.18}{σ} &= 0.53 \\\\\nσ &= \\frac{3.18}{0.53} \\\\\nσ &= 6\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110346 1069 "e-14548" 13194139533355 17592186045585 true] [17592186110346 1071 "The data below is taken from the table of values of the cumulative distribution function $\\Phi(z)$ for the standard normal distribution. Given that $X \\sim N(\\mu, 2^2)$ is a normal random variable with $P(-4\\mu< X < 6\\mu) = 0.6528$, find $\\mu$ rounded to $2$ decimal places.\n\n| $z$ | $\\, 0.03 \\,$ | $\\, 0.04 \\,$ | $\\, 0.05 \\,$ |\n| --- | ---: | ---: | ---: |\n| $\\, 0.7 \\,$ | $\\, 0.7673 \\,$ | $\\, 0.7704 \\,$ | $\\, 0.7734 \\,$ |\n| $\\, 0.8 \\,$ | $\\, 0.7967 \\,$ | $\\, 0.7995 \\,$ | $\\, 0.8023 \\,$ |\n| $\\, 0.9 \\,$ | $\\, 0.8238 \\,$ | $\\, 0.8264 \\,$ | $\\, 0.8289 \\,$ |\n\n*Hint: Note that the interval $-4\\mu< X < 6\\mu$ is symmetric about the mean $\\mu$.*" 13194139533355 17592186045585 true] [17592186110346 1072 #uuid "5eb435ff-ef12-5f18-89d6-4ac163fae344" 13194139533355 17592186045585 true] [17592186110346 1074 "Note that we can write the given probability as\n\n$$\nP(\\mu -5\\mu < X < \\mu +5\\mu) = 0.6528\n$$\n\nwhich tells us that the interval $-4\\mu< X < 6\\mu$ is symmetric about the mean $\\mu$.\n\nFirst, we find the cumulative probability using symmetry:\n\n$$\n\\begin{aligned}\nP(μ - 5μ < X < μ + 5μ) &= 0.6528 \\\\\n2P(μ < X < μ + 5μ) &= 0.6528 \\\\\nP(μ < X < μ + 5μ) &= 0.3264 \\\\\nP(X < μ + 5μ) - P(X < μ) &= 0.3264 \\\\\nP(X < μ + 5μ) - 0.5 &= 0.3264 \\\\\nP(X < μ + 5μ) &= 0.8264 \\\\\nP(X \\le 6μ) &= 0.8264\n\\end{aligned}\n$$\n\nThen, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}\nP(X \\le 6μ) &= 0.8264 \\\\\nP(Z \\le \\frac{6μ - μ}{2}) &= 0.8264 \\\\\nΦ(\\frac{5μ}{2}) &= 0.8264 \\\\\n\\frac{5μ}{2} &= Φ^{-1}(0.8264)\n\\end{aligned}\n$$\n\nAccording to the table, we have\n\n$$\n\\Phi(0.94) = 0.8264 \\quad \\Rightarrow \\quad \\Phi^{-1}(0.8264) = 0.94\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\n\\frac{5μ}{2} &= 0.94 \\\\\n5μ &= 1.88 \\\\\n&= μ \\mid \\approx 0.38\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110347 1069 "e-1457" 13194139533355 17592186045585 true] [17592186110347 1071 "The graph of the parabola $y = ax^2 + bx + c$ with $a \\gt 0$ has discriminant $\\mathcal{D} = 0$. Which of the following could be the graph of this function?\n\n![](images/30/3070343e812cf1d4344905488b6dad10dc1696b4704c817ab703352166b0b359.png)" 13194139533355 17592186045585 true] [17592186110347 1072 #uuid "b2c044f8-96e8-5d6d-b25d-f97340db8bfc" 13194139533355 17592186045585 true] [17592186110347 1074 "To find the possible graph of the parabola, we need to determine two things:\n\n- The direction in which the parabola opens.\n- The number of distinct real roots of the quadratic function.\n\nSince $a \\gt 0$, the parabola opens upward. Moreover, since the discriminant\n\n$$\n\\mathcal{D} = 0\n$$\n\nthe quadratic function has one distinct real root. So, it should intersect the $x$-axis once.\n\nTherefore, of the given options, the only graph that satisfies both these conditions is diagram IV.\n\n![](images/76/764d9b82a222076ff00201a8ac8844db66b02e8c9f6a0243cfc72b2f4c540b6a.png)" 13194139533355 17592186045585 true] [17592186110348 1069 "e-1458" 13194139533355 17592186045585 true] [17592186110348 1071 "The graph of the parabola $y=ax^2+bx+c$ (shown below) has discriminant $\\mathcal D$. Which of the following statements are true?\n\n1. $\\mathcal D < 0$\n2. $a > 0$\n3. $c < 0$\n\n![](images/68/68d51d31798531b7516af556d4bdf2d1b3d5f9be904836554785cf1ff9bc69c4.png)" 13194139533355 17592186045585 true] [17592186110348 1072 #uuid "8e779cba-3361-5069-9e65-61c12825adb9" 13194139533355 17592186045585 true] [17592186110348 1074 "For the given graph of the parabola\n\n$$\ny=ax^2+bx+c{:}\n$$\n\n- Notice that the parabola does not intersect the $x$-axis, so it has no roots. Therefore, we have $\\mathcal{D} \\lt 0$, and hence, statement I is true.\n- The value $a$ is the leading coefficient. Since the parabola opens downward, we have that $a \\lt 0$. Therefore, statement II is false.\n- The value $c$ represents the $y$-intercept of the parabola. The $y$-intercept is below the $x$-axis, so it must be negative. Therefore, we must have $c < 0$, and hence, statement III is true.\n\nIn conclusion, only statements I and III are true." 13194139533355 17592186045585 true] [17592186110349 1069 "e-14734" 13194139533355 17592186045585 true] [17592186110349 1071 "Which of the following lines is perpendicular to $4x - 2y = 10$?\n\n1. $y = \\dfrac{1}{2}x + 3$\n2. $y = -4x + 1$\n3. $y = -\\dfrac{1}{2}x -5$" 13194139533355 17592186045585 true] [17592186110349 1072 #uuid "b5470454-6a27-5eda-a323-74ce90259f4c" 13194139533355 17592186045585 true] [17592186110349 1074 "For the two lines to be perpendicular, their slopes must multiply to $-1$.\n\nTo find the slope of the given line\n\n$$\n4x - 2y = 10\n$$\n\nwe convert to slope-intercept form:\n\n$$\n\\begin{aligned}\n4x - 2y &= 10 \\\\\n- 2y &= -4x + 10 \\\\\ny &= 2x - 5\n\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $2$.\n\nLooking at the answer choices, the line\n\n$$\ny = -\\dfrac{1}{2}x -5\n$$\n\nhas a slope of\n\n$$\n-\\dfrac{1}{2}\n$$\n\nMultiplying the slopes together, we have\n\n$$\n2 \\cdot \\left(-\\dfrac{1}{2}\\right) = -1\n$$\n\nSince the slopes multiply to $-1$, we conclude that the line\n\n$$\ny = -\\dfrac{1}{2}x -5\n$$\n\nis perpendicular to the given line.\n\nSo, the correct answer is \"III only\"." 13194139533355 17592186045585 true] [17592186110350 1069 "e-14812" 13194139533355 17592186045585 true] [17592186110350 1071 "Solve $(3y +2)^2 = 4$." 13194139533355 17592186045585 true] [17592186110350 1072 #uuid "7ea7c281-596a-55be-81f2-7465b9dbe364" 13194139533355 17592186045585 true] [17592186110350 1074 "We solve the equation using the square root method:\n\n$$\n\\begin{aligned}\n(3y + 2)^{2} &= 4 \\\\\n\\sqrt{(3y + 2)^{2}} &= \\sqrt{4} \\\\\n\\mid 3y + 2 \\mid &= 2 \\\\\n3y + 2 &= ± 2 \\\\\n3y &= -2 ± 2 \\\\\ny &= \\frac{-2 ± 2}{3}\n\\end{aligned}\n$$\n\nNext, we simplify the two solutions:\n\n$$\n\\begin{aligned}\ny &= \\frac{-2 + 2}{3} = 0 \\\\\ny &= \\frac{-2 - 2}{3} =-\\frac{4}{3}\n\\end{aligned}\n$$\n\nTherefore, the solutions are\n\n$$\ny=-\\dfrac{4}{3}\n$$\n\nand $y=0$." 13194139533355 17592186045585 true] [17592186110351 1069 "e-14816" 13194139533355 17592186045585 true] [17592186110351 1071 "If $-2(3x - 6)^2 + 1 = -9$, then calculate $x$." 13194139533355 17592186045585 true] [17592186110351 1072 #uuid "d3b75a40-d7b4-5e45-99e2-47b1a0430687" 13194139533355 17592186045585 true] [17592186110351 1074 "First, we isolate the perfect square:\n\n$$\n\\begin{aligned}\n-2(3x - 6)^{2} + 1 &= -9 \\\\\n- 2(3x - 6)^{2} &= -10 \\\\\n(3x - 6)^{2} &= 5\n\\end{aligned}\n$$\n\nThen, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\n\\sqrt{(3x - 6)^{2}} &= \\sqrt{5} \\\\\n\\mid 3x - 6 \\mid &= \\sqrt{5} \\\\\n3x - 6 &= ± \\sqrt{5} \\\\\n3x &= 6 ± \\sqrt{5} \\\\\nx &= \\frac{6 ± \\sqrt{5}}{3} \\\\\nx &= \\frac{6}{3} ± \\frac{\\sqrt{5}}{3} \\\\\nx &= 2 ± \\frac{\\sqrt{5}}{3}\n\\end{aligned}\n$$\n\nThe two solutions are\n\n$$\nx= 2 + \\dfrac{\\sqrt{5}}{3}\\quad \\textrm{and}\\quad x= 2 - \\dfrac{\\sqrt{5}}{3}\n$$\n\nHowever, because these solutions cannot be simplified any further, we will keep the \"$\\pm$\" symbol in our final answer. So our final answer is\n\n$$\nx = 2 \\pm \\dfrac{\\sqrt{5}}{3}\n$$" 13194139533355 17592186045585 true] [17592186110352 1069 "e-14817" 13194139533355 17592186045585 true] [17592186110352 1071 "Solve $-2(3k-12)^2 = 0$." 13194139533355 17592186045585 true] [17592186110352 1072 #uuid "34bac64f-5afc-5c30-bb87-15b3df40f8a9" 13194139533355 17592186045585 true] [17592186110352 1074 "We can solve this equation using the square root method:\n\n$$\n\\begin{aligned}\n-2(3k - 12)^{2} &= 0 \\\\\n(3k - 12)^{2} &= 0 \\\\\n\\sqrt{(3k - 12)^{2}} &= \\sqrt{0} \\\\\n\\mid 3k - 12 \\mid &= 0 \\\\\n3k - 12 &= 0 \\\\\n3k &= 12 \\\\\nk &= 4\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110353 1069 "e-14819" 13194139533355 17592186045585 true] [17592186110353 1071 "Given that $t^2 -10t +25 = 121$, what are the values of $t$?" 13194139533355 17592186045585 true] [17592186110353 1072 #uuid "39a8afe6-b65a-5b87-bc4c-d20bc470b8fa" 13194139533355 17592186045585 true] [17592186110353 1074 "First, notice that the left-hand side is a perfect square. It just needs to be factored:\n\n$$\n\\begin{aligned}\nt^{2} - 10t + 25 &= 121 \\\\\nt^{2} - 2 \\cdot 5 \\cdot t + 5^{2} &= 121 \\\\\n(t - 5)^{2} &= 121\n\\end{aligned}\n$$\n\nFrom here, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\n\\sqrt{(t - 5)^{2}} &= \\sqrt{121} \\\\\n\\mid t - 5 \\mid &= 11 \\\\\nt - 5 &= ± 11 \\\\\nt &= 5 ± 11\n\\end{aligned}\n$$\n\nNext, we simplify the two solutions:\n\n$$\n\\begin{aligned}\nt &= 5 + 11 = 16 \\\\\nt &= 5 - 11 =-6\n\\end{aligned}\n$$\n\nTherefore, the solutions are $t=-6$ and $t=16$." 13194139533355 17592186045585 true] [17592186110354 1069 "e-14820" 13194139533355 17592186045585 true] [17592186110354 1071 "Which value of $k$ gives precisely one solution to the equation $(x+3)^2+10=k$?" 13194139533355 17592186045585 true] [17592186110354 1072 #uuid "b9db498b-f1e3-5d52-b23d-106895586815" 13194139533355 17592186045585 true] [17592186110354 1074 "First, we solve for $x$ as follows:\n\n$$\n\\begin{aligned}\n(x + 3)^{2} + 10 &= k \\\\\n(x + 3)^{2} &= k - 10 \\\\\n\\sqrt{(x + 3)^{2}} &= \\sqrt{k - 10} \\\\\n\\mid x + 3 \\mid &= \\sqrt{k - 10}\n\\end{aligned}\n$$\n\nThe equation has only one solution if the right-hand side is equal to zero. So, we solve for the value of $k$ that makes the right-hand side equal to zero:\n\n$$\n\\begin{aligned}\n\\sqrt{k - 10} &= 0 \\\\\nk - 10 &= 0 \\\\\nk &= 10\n\\end{aligned}\n$$\n\nTherefore, $k=10$ will give only one solution to the equation." 13194139533355 17592186045585 true] [17592186110355 1069 "e-14822" 13194139533355 17592186045585 true] [17592186110355 1071 "Given that $g^2 -18g + 81 = 0$, what are the values of $g$?" 13194139533355 17592186045585 true] [17592186110355 1072 #uuid "281c39c4-7b52-51aa-aad8-dbd40223b796" 13194139533355 17592186045585 true] [17592186110355 1074 "First, notice that the left-hand side is a perfect square. It just needs to be factored:\n\n$$\n\\begin{aligned}\ng^{2} - 18g + 81 &= 0 \\\\\ng^{2} - 2 \\cdot 9 \\cdot g + 9^{2} &= 0 \\\\\n(g - 9)^{2} &= 0\n\\end{aligned}\n$$\n\nFrom here, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}\n\\sqrt{(g - 9)^{2}} &= \\sqrt{0} \\\\\n\\mid g - 9 \\mid &= 0 \\\\\ng - 9 &= 0 \\\\\ng &= 9\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110356 1069 "e-14824" 13194139533355 17592186045585 true] [17592186110356 1071 "Consider the equation $(4x+1)^2 +2=3k$. For which values of $k$ does this equation have no real solutions?" 13194139533355 17592186045585 true] [17592186110356 1072 #uuid "1e0655ad-122c-5d94-8f8b-9e476eaf4d78" 13194139533355 17592186045585 true] [17592186110356 1074 "Let's try and solve using the square root method:\n\n$$\n\\begin{aligned}\n(4x + 1)^{2} + 2 &= 3k \\\\\n(4x + 1)^{2} &= 3k - 2 \\\\\n\\sqrt{(4x + 1)^{2}} &= \\sqrt{3k - 2} \\\\\n\\mid 4x + 1 \\mid &= \\sqrt{3k - 2}\n\\end{aligned}\n$$\n\nThe equation will have no real solutions if the expression under the square root is negative, which gives the following condition:\n$3k-2 < 0$\n\nWe solve this inequality for $k$:\n\n$$\n\\begin{bmatrix}3k - 2 & < 0 \\\\ 3k & < 2 \\\\ k & < \\frac{2}{3}\\end{bmatrix}\n$$\n\nTherefore, any value of $k$ that is less than\n\n$$\n\\dfrac 2 3\n$$\n\nwill give an equation with no real solutions." 13194139533355 17592186045585 true] [17592186110357 1069 "e-14854" 13194139533355 17592186045585 true] [17592186110357 1071 "Find the axis of symmetry for the parabola sketched below.\n\n![](images/e5/e5393f15ff154f1f4cc310791790db0fe0ad0d9faa076d10f3f6ec7b481de086.png)" 13194139533355 17592186045585 true] [17592186110357 1072 #uuid "30974188-c734-5e99-a9ae-81d1a53b9105" 13194139533355 17592186045585 true] [17592186110357 1074 "From the graph, we deduce that the roots are $x_1=-3$ and $x_2=2$.\n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{x_{1} + x_{2}}{2} = \\frac{-3 + 2}{2} =-\\frac{1}{2}\n\\end{aligned}\n$$\n\nTherefore, the axis of symmetry is\n\n$$\nx=-\\dfrac{1}{2}\n$$" 13194139533355 17592186045585 true] [17592186110358 1069 "e-14857" 13194139533355 17592186045585 true] [17592186110358 1071 "Find the axis of symmetry of the parabola $y=-(x-1)(x-5)$." 13194139533355 17592186045585 true] [17592186110358 1072 #uuid "00575d99-28e6-59b7-b416-765808916fe5" 13194139533355 17592186045585 true] [17592186110358 1074 "From the equation\n\n$$\ny=-(x-1)(x-5)\n$$\n\nwe find that the roots of the parabola are $x_1=1$ and $x_2=5$.\n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\nx = \\dfrac{x_1+x_2}{2} = \\dfrac{1+5}{2} = 3\n$$\n\nTherefore, the axis of symmetry is $x=3$." 13194139533355 17592186045585 true] [17592186110359 1069 "e-14860" 13194139533355 17592186045585 true] [17592186110359 1071 "The axis of symmetry of the parabola $y=\\dfrac14(x-k)(x+2)$ is $x=6$. Find the value of $k$." 13194139533355 17592186045585 true] [17592186110359 1072 #uuid "405e0230-69cb-5679-bec0-13a69c722934" 13194139533355 17592186045585 true] [17592186110359 1074 "First, we will calculate the axis of symmetry in terms of $k$. Then, since we know that the axis of symmetry is $x=6$, we will set our result equal to $6$.\n\nFrom the equation\n\n$$\ny=\\dfrac14(x-k)(x+2)\n$$\n\nwe find that the roots of the parabola are $x_1=k$ and $x_2=-2$.\n\nTo find the axis of symmetry, we take the average of the roots, as follows:\n\n$$\n\\begin{aligned}\nx &= \\frac{x_{1} + x_{2}}{2} \\\\\n&= \\frac{k - 2}{2}\n\\end{aligned}\n$$\n\nWe know that the axis of symmetry is $x=6$. Therefore, we have\n\n$$\n\\begin{aligned}\n\\frac{k - 2}{2} &= 6 \\\\\nk - 2 &= 12 \\\\\nk &= 14\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110360 1069 "e-1491" 13194139533355 17592186045585 true] [17592186110360 1071 "A cannonball is shot straight up from a platform $5 \\, \\textrm{m}$ above the ground with an initial velocity of $22 \\, \\textrm{m/s}$. How high above the ground is the cannonball after $3$ seconds?" 13194139533355 17592186045585 true] [17592186110360 1072 #uuid "f2e0980a-1fea-554e-afd0-fa4eb29488f1" 13194139533355 17592186045585 true] [17592186110360 1074 "To solve this problem, we use the formula\n\n$$\ns=ut+\\dfrac{1}{2}gt^2\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The initial velocity of the cannonball is $u=22\\,\\textrm{m/s}$.\n- The cannonball is moving for $t=3\\,\\textrm{s}$.\n- The acceleration due to gravity is $g=-9.8\\,\\textrm{m/s}^2$. Notice that $g$ is *negative* since the cannonball's motion acts *against* gravity.\n\nSubstituting these values into the formula, we obtain the following:\n\n$$\n\\begin{aligned}\ns &= (22) \\cdot 3 - \\frac{1}{2}(9.8) \\cdot (3)^{2} \\\\\n&= 66 - 4.9(9) \\\\\n&= 66 - 44.1 \\\\\n&= 21.9\n\\end{aligned}\n$$\n\nTherefore, after $3$ seconds the cannonball is $21.9\\,\\textrm{m}$ above the platform.\n\nFinally, we add the height of the $5\\,\\textrm{m}$ platform:\n\n$$\n5 + 21.9 = 26.9 \\,\\textrm{m}\n$$\n\nTherefore, after $3$ seconds, the cannonball is $26.9\\,\\textrm{m}$ above the ground." 13194139533355 17592186045585 true] [17592186110361 1069 "e-15141" 13194139533355 17592186045585 true] [17592186110361 1071 "Find the measure of an angle that's supplementary to an angle of $(7x -63)^\\circ$." 13194139533355 17592186045585 true] [17592186110361 1072 #uuid "62cec20b-28d4-5f08-9201-2d32bb741f1b" 13194139533355 17592186045585 true] [17592186110361 1074 "Two angles are supplementary if their measures add up to $180^\\circ$.\n\nSo, the measure of an angle that's supplementary to an angle of $(7x -63)^\\circ$ must be\n\n$$\n\\begin{aligned}\n180^{∘} - (7x - 63)^{∘} &= (180 - 7x + 63)^{∘} \\\\\n&= (180 + 63 - 7x)^{∘} \\\\\n&= (243 - 7x)^{∘}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110362 1069 "e-15142" 13194139533355 17592186045585 true] [17592186110362 1071 "![](images/b3/b3fb947727e28a9c8424ea906ce8440f2795459278797242dd9e61c63f8ccd9c.png)\n\nSolve for $y$ given the figure above." 13194139533355 17592186045585 true] [17592186110362 1072 #uuid "39e78adf-4714-5461-b3a4-c619019df41a" 13194139533355 17592186045585 true] [17592186110362 1074 "Since the two angles are supplementary, the sum of their measures is equal to $180^\\circ$. Therefore:\n\n$$\n\\begin{aligned}\n(3y - 17^{∘}) + (y + 37^{∘}) &= 180^{∘} \\\\\n4y + 20^{∘} &= 180^{∘} \\\\\n4y &= 160^{∘} \\\\\ny &= 40^{∘}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110363 1069 "e-15641" 13194139533355 17592186045585 true] [17592186110363 1071 "![](images/a6/a65c88ab4b81dcce668f9c936039b990cd4eb8b1d8576a6e53e2234eb16991c6.png)\n\nWhat angle is supplementary to $\\angle DGB$ in the diagram above?" 13194139533355 17592186045585 true] [17592186110363 1072 #uuid "4ebed10c-0a87-528a-ba18-67d960ba7692" 13194139533355 17592186045585 true] [17592186110363 1074 "![](images/ea/ea11964802b9ebca124a7f31b93fe58c30e619fc7279658bdcfcf7b683f24bb0.png)\n\nTwo angles are supplementary if their measures add up to $180^\\circ$, a straight angle.\n\nOnly $\\angle DGF$ is supplementary to $\\angle DGB$ in the given diagram." 13194139533355 17592186045585 true] [17592186110364 1069 "e-15642" 13194139533355 17592186045585 true] [17592186110364 1071 "![](images/22/22e71949f4a63a7f650c38841bd67d3e5cb415a5c8819b0ea4ce80431bf6dbfb.png)\n\nGiven that $\\overline{AD}$ is a segment, what is the measure of $\\angle FOD$?" 13194139533355 17592186045585 true] [17592186110364 1072 #uuid "ba553f7b-1750-5ffb-b6f8-81ad141368a8" 13194139533355 17592186045585 true] [17592186110364 1074 "![](images/41/416aef1d024c1b926eb33bada7611bb1d345b0d9daa2d59730b05bab85617c05.png)\n\nTwo angles are supplementary if their measures add up to $180^\\circ$, a straight angle.\n\nSince $\\overline{AD}$ is a segment, we have that $\\angle AOF$ and $\\angle FOD$ are supplementary.\n\n$$\nm \\angle AOF + m \\angle FOD = 180^\\circ\n$$\n\nTherefore, the measure of $\\angle FOD$ is given by\n\n$$\n\\begin{aligned}\nm∠FOD &= 180^{∘} - m∠AOF \\\\\n&= 180^{∘} - 45^{∘} \\\\\n&= 135^{∘}\n\\end{aligned}\n$$" 13194139533355 17592186045585 true] [17592186110365 1069 "e-15663" 13194139533355 17592186045585 true] [17592186110365 1071 "The point $C$ shown below is rotated by $270^\\circ$ **clockwise** about the origin. What is the image of $C$ under the action of this transformation?\n\n![](images/99/9954626ef8226f2927b012e543e1e84958b763baa9870817fa8ed7b43c297562.png)" 13194139533355 17592186045585 true] [17592186110365 1072 #uuid "9c30de43-957a-5786-b748-9dfc09f1eee7" 13194139533355 17592186045585 true] [17592186110365 1074 "We rotate the point $C$ by an angle of $270^\\circ$ *clockwise* about the origin as follows:\n\n![](images/49/49b33987f43f8aa5a8cffd0d3977f227468f7245e7e3f7c2aad2793deb3388d6.png)\n\nTherefore, the image is the point $D$." 13194139533355 17592186045585 true] [17592186110366 1069 "e-15664" 13194139533355 17592186045585 true] [17592186110366 1071 "![](images/a6/a613f8c8663762d596dc6e2f0ac30100b4da6972bc4454ccb9ac2a89e4bc3468.png)\n\nThe point $A$ shown above is rotated by $80^\\circ$ **counterclockwise** about the origin. Plot the resulting point $A'$." 13194139533355 17592186045585 true] [17592186110366 1072 #uuid "401c6d86-b6e1-5b0a-9708-a448d0eb8d48" 13194139533355 17592186045585 true] [17592186110366 1074 "The point and its image under rotation about the origin must be equidistant from the center of rotation (origin). In other words, both our points should lie on the same circle centered at the origin.\n\nWe rotate the point $A$ by an angle of $80^\\circ$ counterclockwise about the origin as follows:\n\n![](images/e4/e490573a9a4a6ad6ab553459b2191e47de5f0b748f45a6e3c7ea4ecc8aa49740.png)" 13194139533355 17592186045585 true] [17592186110367 1069 "e-15665" 13194139533355 17592186045585 true] [17592186110367 1071 "The polygon shown below is rotated by an angle of $45^\\circ$ counterclockwise about the point $C$. Draw the resulting polygon.\n\n![](images/25/2587f66b0d417c8398fb777d14f1a0e68a68c2506643913e87a2a62e568c10e8.png)" 13194139533355 17592186045585 true] [17592186110367 1072 #uuid "20e99f79-dbcb-5d04-a083-41742ecae9f4" 13194139533355 17592186045585 true] [17592186110367 1074 "To rotate the given polygon by an angle of $45^\\circ$ counterclockwise about the point $C$, we rotate each vertex by an angle of $45^\\circ$ counterclockwise about $C$ and then connect the corresponding adjacent vertices using line segments. The result is shown below.\n\n![](images/15/15692bf7ba076fec5ae8557800ee756a8d16f321760e081c253d53f6c2b4ef47.png)" 13194139533355 17592186045585 true] [17592186110368 1069 "e-1597" 13194139533355 17592186045585 true] [17592186110368 1071 "An object is projected vertically upwards, attaining a height of $40 \\, \\textrm{m}$ in $2\\,\\textrm{s}$. What was the initial velocity of the object?" 13194139533355 17592186045585 true] [17592186110368 1072 #uuid "0e3d275e-bfbb-5c1f-9120-9d916ef9c607" 13194139533355 17592186045585 true] [17592186110368 1074 "To solve this problem, we use the formula\n\n$$\ns=ut+\\dfrac{1}{2}gt^2\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The object is moving for $t=2\\,\\textrm{s}$.\n- The displacement of the object is $s=40\\, \\textrm{m}$.\n- The acceleration due to gravity is $g=-9.8\\,\\textrm{m/s}^2$. Notice that $g$ is *negative* since the object's motion acts *against* gravity.\n\nSubstituting these values into the formula and solving for $u$, we obtain the following:\n\n$$\n\\begin{aligned}\ns &= ut + \\frac{1}{2}gt^{2} \\\\\n(40) &= u(2) + \\frac{1}{2}(-9.8)(2)^{2} \\\\\n40 &= 2u - 19.6 \\\\\n59.6 &= 2u \\\\\n29.8 &= u \\\\\nu &= 29.8\n\\end{aligned}\n$$\n\nTherefore, the initial velocity of the object was $29.8\\,\\textrm{m/s}$." 13194139533355 17592186045585 true] [17592186110369 1069 "e-15978" 13194139533355 17592186045585 true] [17592186110369 1071 "![](images/9a/9aac51b8c8332b482f12abd994aa83ba285d509338441d38b71c99c3393755d4.png)\n\nThe diagram above shows a circle $\\mathcal{C}$ of radius $2$ centered at $A(-3,-4)$ and the unit circle $\\mathcal{U}$ centered at the origin $O$. Prove that $\\mathcal{C}$ is similar to $\\mathcal{U}$." 13194139533355 17592186045585 true] [17592186110369 1072 #uuid "9fff5eff-2780-52b0-a67d-0f967e017418" 13194139533355 17592186045585 true] [17592186110369 1074 "Two geometric figures are similar if there exists a sequence of similarity transformations (translations, rotations, reflections, and dilations) that map one figure onto another.\n\nWe'll use a constructive proof to show that the circles are similar. So, start as follows:\n\n> To prove that $\\mathcal C$ is similar to $\\mathcal U$, we construct a sequence of similarity transformations that map $\\mathcal{C}$ onto $\\mathcal{U}$.\n\nWe first translate our circle $\\mathcal C$ so that its center is at the origin of the coordinate system.\n\n> First, a translation of $3$ units right and $4$ units up maps the circle $\\mathcal{C}$ onto the circle $\\mathcal{C}'$ with center $O$ and radius $2$.\n\nNext, we scale the new circle so that its radius equals $1$.\n\n> Then, a dilation of scale factor $\\dfrac12$ and center $O$ maps the circle $\\mathcal{C}'$ onto the circle $\\mathcal{U}$.\n\nSince $\\mathcal C\\sim \\mathcal C'$ and $\\mathcal C'\\sim\\mathcal U$, we have $\\mathcal C\\sim\\mathcal U$ by the transitive property of similarity. So, finally, we state our conclusion:\n\n> The sequence of transformations map $\\mathcal{C}$ onto $\\mathcal{U}$. Therefore, $\\mathcal{C} \\sim \\mathcal{U}$." 13194139533355 17592186045585 true] [17592186110370 1069 "e-15980" 13194139533355 17592186045585 true] [17592186110370 1071 "Consider a circle $\\mathcal{C}_1$ of radius $\\dfrac{1}{2}$ centered at $A(5,7)$ and a circle $\\mathcal{C}_2$ of radius $3$ centered at $B(-6,-2)$. Prove that $\\mathcal{C}_1$ and $\\mathcal{C}_2$ are similar." 13194139533355 17592186045585 true] [17592186110370 1072 #uuid "4151c142-1da2-5398-8841-ed7a3c2390d4" 13194139533355 17592186045585 true] [17592186110370 1074 "We start by showing that both circles are similar to the unit circle. To do this, we construct a sequence of similarity transformations for each circle that map each of them onto $\\mathcal U$.\n\nFirst, we consider the circle $\\mathcal{C}_1{:}$\n\n> First, we'll show that\n> $\\mathcal{C}_1\\sim\\mathcal U$.\n> For the circle $\\mathcal{C}_1$ of radius $\\dfrac{1}{2}$ centered at $A(5,7)$, applying a translation by $5$ units left and $7$ units down followed by a dilation of scale factor $2$ and center $O$ maps $\\mathcal C_1$ onto $\\mathcal U$.\n\nNext, we consider the circle $\\mathcal{C}_2{:}$\n\n> Next, we'll show that\n> $\\mathcal{C}_2 \\sim \\mathcal{U}$.\n> For the circle $\\mathcal{C}_2$ of radius $3$ centered at $B(-6,-2)$, applying a translation by $6$ units right and $2$ units up followed by a dilation of scale factor $\\dfrac{1}{3}$ and center $O$ maps $\\mathcal C_2$ onto $\\mathcal U$.\n\nSince similarity is symmetric, we can swap the order of the circles in our expressions.\n\n> Now, by the symmetric property of similarity, we have\n> $\\mathcal{U} \\sim \\mathcal{C}_2$.\n\nFinally, we'll use the transitivity of similarity, namely, if $\\mathcal{C}_1 \\sim \\mathcal{U}$ and $\\mathcal{U} \\sim \\mathcal{C}_2$, then $\\mathcal{C}_1 \\sim \\mathcal{C}_2$.\n\n> Therefore, by the transitive property of similarity, we obtain that\n> $\\mathcal{C}_1 \\sim \\mathcal{C}_2$." 13194139533355 17592186045585 true] [17592186110371 1069 "e-15982" 13194139533355 17592186045585 true] [17592186110371 1071 "![](images/64/64a3d59043060678eb1cb727f4f3bcf8aa6c3a3998f7df1d7baef272b3bb9365.png)\n\nThe diagram above shows a circle $\\mathcal{C}$ of radius $1$ centered at $A(2,-2)$ and the unit circle $\\mathcal{U}$ centered at the origin $O$. Prove that $\\mathcal{C}$ is similar to $\\mathcal{U}$." 13194139533355 17592186045585 true] [17592186110371 1072 #uuid "221fd62b-dfd2-5cf4-a4cd-b0a8e2d63f50" 13194139533355 17592186045585 true] [17592186110371 1074 "Two geometric figures are similar if there exists a sequence of similarity transformations (translations, rotations, reflections, and dilations) that map one figure onto another.\n\nWe'll use a constructive proof to show that the circles are similar. So, start as follows:\n\n> To prove that $\\mathcal C$ is similar to $\\mathcal U$, we construct a sequence of similarity transformations that map $\\mathcal{C}$ onto $\\mathcal{U}$.\n\nWe translate our circle $\\mathcal C$ so that its center is at the origin of the coordinate system.\n\n> A translation of $2$ units left and $2$ units up maps the circle $\\mathcal{C}$ onto the circle $\\mathcal{U}$.\n\nThis proves that $\\mathcal C$ is similar to $\\mathcal U$. So, we state our conclusion:\n\n> Therefore, $\\mathcal{C} \\sim \\mathcal{U}$." 13194139533355 17592186045585 true] [17592186110372 1069 "e-16370" 13194139533355 17592186045585 true] [17592186110372 1071 "|  |  |  |  |  |  |\n| --- | ---: | ---: | ---: | ---: | ---: |\n|  | $v_1$ | $v_2$ | $v_3$ | $v_4$ | $v_5$ |\n| $v_1$ | $-$ | $1$ | $-$ | $3$ | $-$ |\n| $v_2$ | $1$ | $-$ | $5$ | $-$ | $7$ |\n| $v_3$ | $-$ | $5$ | $-$ | $9$ | $-$ |\n| $v_4$ | $3$ | $-$ | $9$ | $-$ | $11$ |\n| $v_5$ | $-$ | $7$ | $-$ | $11$ | $-$ |\n\nConsider the distance matrix of a weighted graph shown above.\n\nPrim's algorithm for finding a minimum spanning tree is applied to the matrix, starting at the vertex $v_1$, and after a few steps, we arrive at the configuration shown below.\nWhich edge will be added to the tree at the next step of the algorithm?\n\n| $1$$2$$v_1$$v_2$$v_3$$v_4$$v_5$$v_1$$\\color{lightgrey}-$$\\color{lightgrey}1$$\\color{lightgrey}-$$\\color{lightgrey}3$$\\color{lightgrey}-$$v_2$$1$$\\color{lightgrey}-$$\\color{lightgrey}5$$\\color{lightgrey}-$$\\color{lightgrey}7$$v_3$$-$$5$$-$$9$$-$$v_4$$3$$-$$9$$-$$11$$v_5$$-$$7$$-$$11$$-$ | Added edgesLength$v_1 - v_2$$1$ |\n| --- | ---: |" 13194139533355 17592186045585 true] [17592186110372 1072 #uuid "f1194521-e45f-5f3c-84f6-5994748602ec" 13194139533355 17592186045585 true] [17592186110372 1074 "The pseudocode for Prim's algorithm on a distance matrix is the following:\n\n> `Mark the column corresponding to the starting vertex`\n> `Cancel out the row corresponding to the starting vertex`\n> `while (not all columns are marked):`\n> `Find the smallest distance over all the marked columns`\n> `Let u and v be the row and column corresponding to s`\n> `Mark the column u corresponding to s`\n> `Cancel out the row u corresponding to s`\n> `Add edge v-u to the tree`\n\nSo, at the next step of Prim's algorithm, we consider the smallest unselected distance over all marked columns ($v_1$, and $v_2$). The smallest value is $3$ at the intersection of row $v_4$ and column $v_1$.\n\nWe cancel out the row $v_4$ and add $\\bbox[3pt,Gainsboro]{\\color{blue}v_1-v_4}$ of length $\\bbox[3pt,Gainsboro]{\\color{blue}3}$ to the tree.\n\n|  | $1$ | $2$ |  | $3$ |  |\n| --- | ---: | ---: | ---: | ---: | ---: |\n|  | $v_1$ | $v_2$ | $v_3$ | $v_4$ | $v_5$ |\n| $v_1$ | $\\color{lightgrey}-$ | $\\color{lightgrey}1$ | $\\color{lightgrey}-$ | $\\color{lightgrey}3$ | $\\color{lightgrey}-$ |\n| $v_2$ | $1$ | $\\color{lightgrey}-$ | $\\color{lightgrey}5$ | $\\color{lightgrey}-$ | $\\color{lightgrey}7$ |\n| $v_3$ | $-$ | $5$ | $-$ | $9$ | $-$ |\n| $v_4$ | $3$ | $\\color{lightgrey}-$ | $\\color{lightgrey}9$ | $\\color{lightgrey}-$ | $\\color{lightgrey}11$ |\n| $v_5$ | $-$ | $7$ | $-$ | $11$ | $-$ |" 13194139533355 17592186045585 true] [17592186110373 1069 "e-16371" 13194139533355 17592186045585 true] [17592186110373 1071 "|  |  |  |  |  |  |  |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n|  | $v_1$ | $v_2$ | $v_3$ | $v_4$ | $v_5$ | $v_6$ |\n| $v_1$ | $-$ | $10$ | $-$ | $3$ | $-$ | $12$ |\n| $v_2$ | $10$ | $-$ | $7$ | $-$ | $8$ | $-$ |\n| $v_3$ | $-$ | $7$ | $-$ | $-$ | $15$ | $6$ |\n| $v_4$ | $3$ | $-$ | $-$ | $-$ | $-$ | $-$ |\n| $v_5$ | $-$ | $8$ | $15$ | $-$ | $-$ | $2$ |\n| $v_6$ | $12$ | $-$ | $6$ | $-$ | $2$ | $-$ |\n\nConsider the distance matrix of a weighted graph shown above. Using Prim's algorithm starting from the vertex $v_1$, find a minimum spanning tree of this graph." 13194139533355 17592186045585 true] [17592186110373 1072 #uuid "6eba4b87-8735-54c0-8552-f76f516ada6d" 13194139533355 17592186045585 true] [17592186110373 1074 "The pseudocode for Prim's algorithm on a distance matrix is the following:\n\n> `Mark the column corresponding to the starting vertex`\n> `Cancel out the row corresponding to the starting vertex`\n> `while (not all columns are marked):`\n> `Find the smallest distance s over all the marked columns`\n> `Let u and v be the row and column corresponding to s`\n> `Mark the column u corresponding to s`\n> `Cancel out the row u corresponding to s`\n> `Add edge v-u to the tree`\n\nWith that in mind, we proceed as follows:\n\n| **Step 1.** Mark column $v_1$ and cancel out row $v_1$. |  |\n| --- | ---: |\n| $1$$v_1$$v_2$$v_3$$v_4$$v_5$$v_6$$v_1$$\\color{lightgrey}-$$\\color{lightgrey}10$$\\color{lightgrey}-$$\\color{lightgrey}3$$\\color{lightgrey}-$$\\color{lightgrey}12$$v_2$$10$$-$$7$$-$$8$$-$$v_3$$-$$7$$-$$-$$15$$6$$v_4$$3$$-$$-$$-$$-$$-$$v_5$$-$$8$$15$$-$$-$$2$$v_6$$12$$-$$6$$-$$2$$-$ | Added edgesLength |\n| **Step 2.** The smallest unselected value in the marked column is $3$ located at the intersection of row $v_4$ and column $v_1$. So, we mark column $v_4$, cancel out row $v_4$, and add edge $v_1-v_4$ to the tree. |  |\n| $1$$2$$v_1$$v_2$$v_3$$v_4$$v_5$$v_6$$v_1$$\\color{lightgrey}-$$\\color{lightgrey}10$$\\color{lightgrey}-$$\\color{lightgrey}3$$\\color{lightgrey}-$$\\color{lightgrey}12$$v_2$$10$$-$$7$$-$$8$$-$$v_3$$-$$7$$-$$-$$15$$6$$v_4$$3$$\\color{lightgrey}-$$\\color{lightgrey}-$$\\color{lightgrey}-$$\\color{lightgrey}-$$\\color{lightgrey}-$$v_5$$-$$8$$15$$-$$-$$2$$v_6$$12$$-$$6$$-$$2$$-$ | Added edgesLength$