5a90-aa1e-01e88bb54d2a" :answer/type {:db/ident :answer.type/math} :answer/value "u(x){e}^{15x}" :db/id #edb/ref 17592186397101} {:answer/id #uuid "fe3e4f63-8e52-5102-b305-3e0c04fc80b1" :answer/type {:db/ident :answer.type/math} :answer/value "u(x){e}^{-10x}" :db/id #edb/ref 17592186397102}] :answer-field/correct {:answer/id #uuid "104a2da1-9f11-510a-9e86-88dce1ddf0c7" :answer/type {:db/ident :answer.type/math} :answer/value "u(x){e}^{5x}" :db/id #edb/ref 17592186397100} :answer-field/id #uuid "23391fc0-0d97-510f-b68a-65d0d3b75416" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bf23900-2f3d-53c0-9448-69b2b01a2a2b" :question/math-academy-id "q-337488" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-5y=10\\operatorname{cosh}⁡5x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-5{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{5x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{5x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{5x})}^{′}-5(u{e}^{5x}) & =10\\operatorname{cosh}⁡5x \\\\ {u}^{′}{e}^{5x}+5u{e}^{5x}-5u{e}^{5x} & =10\\operatorname{cosh}⁡5x \\\\ {u}^{′}{e}^{5x}+\\cancel{5u{e}^{5x}}-\\cancel{5u{e}^{5x}} & =10\\operatorname{cosh}⁡5x \\\\ {u}^{′}{e}^{5x} & =10\\operatorname{cosh}⁡5x \\\\ {u}^{′} & =10{e}^{-5x}\\operatorname{cosh}⁡5x\\end{aligned}\n$$\n\nUsing the fact that \n\n$$\n\\operatorname{cosh}⁡5x=\\frac{{e}^{5x}+{e}^{-5x}}{2}\n$$\n\nour equation for $u$ becomes\n\n$$\n\\begin{aligned}{u}^{′} & =10{e}^{-5x}\\operatorname{cosh}⁡5x \\\\  & =10{e}^{-5x}(\\frac{{e}^{5x}+{e}^{-5x}}{2}) \\\\  & =5{e}^{-5x}({e}^{5x}+{e}^{-5x}) \\\\  & =5+5{e}^{-10x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =5+5{e}^{-10x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 5+5{e}^{-10x}\\,\\text{d}x \\\\ u & =5x-\\frac{1}{2}{e}^{-10x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{5x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{5x} \\\\  & =5x{e}^{5x}-\\frac{1}{2}{e}^{-5x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186397103 :knowledge-point/_questions [{:knowledge-point/id #uuid "90930e15-0827-5e0b-82cf-98263fc756d6" :knowledge-point/title "Identifying Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b5ec8b6-d55b-55cc-aa94-056dd87936ff" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397105} {:answer/id #uuid "d8f3b959-aec4-56a5-ac52-93392b485d16" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397106}] :answer-field/correct {:answer/id #uuid "8b5ec8b6-d55b-55cc-aa94-056dd87936ff" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397105} :answer-field/id #uuid "01b3194e-1c5b-5f63-8af7-cad12a568ef1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397104} {:answer-field/choices [{:answer/id #uuid "01e0647b-2813-5eba-b947-eeac3bfb20f8" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397108} {:answer/id #uuid "f34ae965-4585-556a-b037-c112e1a82720" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397109}] :answer-field/correct {:answer/id #uuid "f34ae965-4585-556a-b037-c112e1a82720" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397109} :answer-field/id #uuid "2ac21c56-a1ed-58af-8f2a-f8f3a643de10" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397107} {:answer-field/choices [{:answer/id #uuid "fdd2df26-875b-5cf8-8e35-d22dc66dd099" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397111} {:answer/id #uuid "61df961a-7458-5bdd-bf21-6f1ffc7be0e8" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397112}] :answer-field/correct {:answer/id #uuid "61df961a-7458-5bdd-bf21-6f1ffc7be0e8" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397112} :answer-field/id #uuid "f8930119-dde1-5c7f-9dc6-b7a8c29faee5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397110}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8da06f22-6a38-578e-b590-3e2d4a9025f6" :question/math-academy-id "q-338004" :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.$\\,$ The equation $\\,\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0$ is {{field-1}}. \n\n$\\,$ The equation $\\,{y}^{″}+3{y}^{′}=x$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}-xy+4x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+3{y}^{′}=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}-xy+4x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-xy=-4x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-4x,$ which is different from zero."}] [{:db/id #edb/ref 17592186397113 :knowledge-point/_questions [{:knowledge-point/id #uuid "90930e15-0827-5e0b-82cf-98263fc756d6" :knowledge-point/title "Identifying Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8224d08c-b6d5-59c1-a3e9-c4005d2ce278" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397115} {:answer/id #uuid "51641394-cf83-58e5-aa34-474bd8353286" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397116}] :answer-field/correct {:answer/id #uuid "51641394-cf83-58e5-aa34-474bd8353286" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397116} :answer-field/id #uuid "84f1c5b4-e827-513e-b3a4-9b5e916f4d90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397114} {:answer-field/choices [{:answer/id #uuid "c982b65b-e870-508e-bf5e-ddcdb473e18a" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397118} {:answer/id #uuid "7497ecc8-2fd5-55ef-ad5f-c1e4eba3b91f" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397119}] :answer-field/correct {:answer/id #uuid "7497ecc8-2fd5-55ef-ad5f-c1e4eba3b91f" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397119} :answer-field/id #uuid "cbe235fa-bcf8-5953-9422-9db01e330fa5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397117} {:answer-field/choices [{:answer/id #uuid "c21f26fa-303e-5e74-bcc7-27f756e59fef" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397121} {:answer/id #uuid "81be49a9-a2c9-51ce-9466-8f23516f81e9" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397122}] :answer-field/correct {:answer/id #uuid "c21f26fa-303e-5e74-bcc7-27f756e59fef" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397121} :answer-field/id #uuid "ee6a8920-f14a-5940-b560-371ca67535b3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8b12875-ae8a-5464-b1d4-8be3ec87c5f9" :question/math-academy-id "q-338082" :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.$\\,$ The equation $\\,{y}^{″}+2y=x$ is {{field-1}}. \n\n$\\,$ The equation $\\,\\operatorname{tan}⁡(x){y}^{″}+{y}^{′}-6y=0$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}-(x+2)y+5x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n{y}^{″}+2y=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- The equation\n\n$$\n\\operatorname{tan}⁡(x){y}^{″}+{y}^{′}-6y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- Writing the equation\n\n$$\n{y}^{″}-(x+2)y+5x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-(x+2)y=-5x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-5x,$ which is different from zero."}] [{:db/id #edb/ref 17592186152581 :knowledge-point/_questions [{:knowledge-point/id #uuid "af8cf798-4327-5f5b-82ab-f622f20ccc38" :knowledge-point/title "Identifying Homogeneous Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdcbfc02-0951-530a-bdd6-e4d3b384e4bf" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397124} {:answer/id #uuid "3f18baa1-7086-526c-b930-04b3cbe22feb" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397125} {:answer/id #uuid "1819390b-ed10-5cad-95ce-fcd58864ce6d" :answer/type {:db/ident :answer.type/text} :answer/value "Dirichlet" :db/id #edb/ref 17592186397126}] :answer-field/correct {:answer/id #uuid "cdcbfc02-0951-530a-bdd6-e4d3b384e4bf" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397124} :answer-field/id #uuid "20af0270-925d-5adc-bd31-842158df2ebb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397123} {:answer-field/choices [{:answer/id #uuid "215a0a6c-ad0f-54a4-b9ce-0e55ccae84c1" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397128} {:answer/id #uuid "e3518d61-df59-5386-b3ca-172e84278fc0" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397129}] :answer-field/correct {:answer/id #uuid "e3518d61-df59-5386-b3ca-172e84278fc0" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397129} :answer-field/id #uuid "edc7f057-557e-5798-8bd0-23cc616cd262" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397127} {:answer-field/choices [{:answer/id #uuid "6a97f21e-a71d-5e5e-9343-1f163db58ab2" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397131} {:answer/id #uuid "37849ebb-b4e1-594a-a35e-046d0b945819" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397132}] :answer-field/correct {:answer/id #uuid "6a97f21e-a71d-5e5e-9343-1f163db58ab2" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397131} :answer-field/id #uuid "53d409c4-1129-5429-b0b7-a65bc0e5e62a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397130} {:answer-field/choices [{:answer/id #uuid "e141a51c-1bad-5df3-b98a-e9adf08222fe" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397134} {:answer/id #uuid "f7c5252f-c30d-56e5-9e4e-8b841dfc1553" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397135}] :answer-field/correct {:answer/id #uuid "f7c5252f-c30d-56e5-9e4e-8b841dfc1553" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397135} :answer-field/id #uuid "2f2d4158-46ad-5262-82de-55f5e7b1262a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397133}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b711ebb4-4d84-521d-8e27-4cb308558d9a" :question/math-academy-id "q-338516" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)+{x}^{2}{y}^{′}(x)+y(x)=2x,\\,0\\le x\\le \\pi \n$$\n\n$$\n2y(0)+{y}^{′}(0)=0,\\,y(\\pi )+2{y}^{′}(\\pi )=0\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)+{x}^{2}{y}^{′}(x)+y(x)=2x.\n$$\n\nSince the right-hand side $f(x)=2x≢0,$ the equation is $\\text{inhomogeneous}.$\n\n- The boundary conditions are\n\n$$\n2y(0)+{y}^{′}(0)=0,\\,y(\\pi )+2{y}^{′}(\\pi )=0.\n$$\n\nThese are $\\text{Robin}$ boundary conditions, and since the right-hand sides are zero for both, they are $\\text{homogeneous}.$\n\n- Since the governing equation is inhomogeneous, yet the boundary conditions are homogeneous, the BVP is $\\text{inhomogeneous}.$"}] [{:db/id #edb/ref 17592186152582 :knowledge-point/_questions [{:knowledge-point/id #uuid "af8cf798-4327-5f5b-82ab-f622f20ccc38" :knowledge-point/title "Identifying Homogeneous Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae358f3-d85b-5a1d-acc8-17c991405ff1" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397137} {:answer/id #uuid "0b2c9783-f7e5-5797-b9f1-9f95b4b6673c" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397138} {:answer/id #uuid "bdec2590-f44d-5d16-8f47-5c405afcd805" :answer/type {:db/ident :answer.type/text} :answer/value "Dirichlet" :db/id #edb/ref 17592186397139}] :answer-field/correct {:answer/id #uuid "0b2c9783-f7e5-5797-b9f1-9f95b4b6673c" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397138} :answer-field/id #uuid "70ebcc26-25af-598a-97e1-499e2407aeb0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397136} {:answer-field/choices [{:answer/id #uuid "fe776fd0-8801-585d-a7c4-73bb386abf6d" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397141} {:answer/id #uuid "04b12e10-d19c-5892-a70b-db9c711fc435" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397142}] :answer-field/correct {:answer/id #uuid "fe776fd0-8801-585d-a7c4-73bb386abf6d" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397141} :answer-field/id #uuid "18073122-bf85-5077-973b-f8f6df4708b0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397140} {:answer-field/choices [{:answer/id #uuid "d23b2ad9-78b8-5e2c-978b-06f7f0b9daca" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397144} {:answer/id #uuid "0fde711e-fce0-537b-85be-fb90e2b76123" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397145}] :answer-field/correct {:answer/id #uuid "0fde711e-fce0-537b-85be-fb90e2b76123" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397145} :answer-field/id #uuid "f19326da-14c5-5131-a8ff-fcda659769b1" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397143} {:answer-field/choices [{:answer/id #uuid "f02b63af-f692-59a6-a607-4bbd33881ab2" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397147} {:answer/id #uuid "bc949215-7547-54ff-8dd9-dd5a5c2df74a" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397148}] :answer-field/correct {:answer/id #uuid "bc949215-7547-54ff-8dd9-dd5a5c2df74a" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397148} :answer-field/id #uuid "99ab627e-d079-50a2-8b6c-0a78cf9cf5f3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397146}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc19be1d-a106-5173-ab6a-0a0d552a59ea" :question/math-academy-id "q-338646" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)+\\operatorname{sin}⁡(x){y}^{′}(x)+3y(x)=0,\\,0\\le x\\le 2\n$$\n\n$$\n{y}^{′}(0)=2,\\,{y}^{′}(2)=-1\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)+\\operatorname{sin}⁡(x){y}^{′}(x)+3y(x)=0.\n$$\n\nSince the right-hand side $f(x)≡0,$ the equation is $\\text{homogeneous}.$\n\n- The boundary conditions are\n\n$$\n{y}^{′}(0)=2,\\,{y}^{′}(2)=-1.\n$$\n\nThese are $\\text{Neumann}$ boundary conditions, and since the right-hand sides are not zero for both, they are $\\text{inhomogeneous}.$\n\n- Since the governing equation is homogeneous, yet the boundary conditions are inhomogeneous, the BVP is $\\text{inhomogeneous}.$"}] [{:db/id #edb/ref 17592186229727 :knowledge-point/_questions [{:knowledge-point/id #uuid "532a73e6-e026-57c9-9bad-57cd2f75b6df" :knowledge-point/title "Parity Recognition and Series Type"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "777c0bde-5c50-58aa-bcd9-af554298f662" :answer/type {:db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186397150} {:answer/id #uuid "18bbb808-067a-5c73-a58a-7bbbccd30b52" :answer/type {:db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186397151}] :answer-field/correct {:answer/id #uuid "18bbb808-067a-5c73-a58a-7bbbccd30b52" :answer/type {:db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186397151} :answer-field/id #uuid "00839b4e-f62d-5523-b0a0-cd44b3f38d1f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397149} {:answer-field/choices [{:answer/id #uuid "4046271d-3273-5e3f-a757-9112f2fda282" :answer/type {:db/ident :answer.type/text} :answer/value "sine terms" :db/id #edb/ref 17592186397153} {:answer/id #uuid "3f94849a-be66-556b-b362-390c2fd77a3b" :answer/type {:db/ident :answer.type/text} :answer/value "cosine terms" :db/id #edb/ref 17592186397154}] :answer-field/correct {:answer/id #uuid "3f94849a-be66-556b-b362-390c2fd77a3b" :answer/type {:db/ident :answer.type/text} :answer/value "cosine terms" :db/id #edb/ref 17592186397154} :answer-field/id #uuid "d2ef1e3c-f0e2-50af-90e8-066404b32b3d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7903a61-d4e3-5a7b-991a-79f6efafb8b5" :question/math-academy-id "q-338682" :question/problem "Consider the function $f(x)=x\\operatorname{cos}⁡(x)$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the \n{{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." :question/worked-solution "To determine whether $f$ is even or odd, we compare $f(-x)$ and $f(x):$\n\n$$\n\\begin{aligned}f(-x) & =(-x)\\operatorname{cos}⁡(-x) \\\\  & =-x\\operatorname{cos}⁡(x) \\\\  & =-f(x).\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ we have that $f$ is odd.\n\nFor Fourier series on $[-\\pi ,\\pi ],$ the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x,\n$$\n\nand the constant coefficient is\n\n$$\n{a}_{0}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nHere, $f(x)$ is odd and $\\operatorname{cos}⁡(nx)$ is even, so $f(x)\\operatorname{cos}⁡(nx)$ is odd. Also, $f(x)$ itself is odd.\n\nNow, the integral of an odd function over $[-\\pi ,\\pi ]$ is $0.$ Thus, ${a}_{n}=0$ for all $n\\ge 1,$ and ${a}_{0}=0.$\n\nTherefore, the function $f(x)$ is $\\text{odd}$ and the $\\text{cosine terms}$ in its Fourier series must be zero."}] [{:db/id #edb/ref 17592186397155 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d9576e0-3be5-5d05-8cc8-c3ecde496b46" :knowledge-point/title "Classifying Solutions of Homogeneous BVPs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b159e62b-c689-5e20-8226-00fb7f02cbc8" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397157} {:answer/id #uuid "296d3c7d-583d-5979-b5c1-8a501ca9c153" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397158} {:answer/id #uuid "45559ca1-ecc3-53ab-b9cb-735c0349e5ab" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397159}] :answer-field/correct {:answer/id #uuid "b159e62b-c689-5e20-8226-00fb7f02cbc8" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397157} :answer-field/id #uuid "e847dcfa-8d4c-527b-a527-764fa7af066c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397156} {:answer-field/choices [{:answer/id #uuid "c42e4b6e-5657-51bb-8a20-e55e05bf0b4b" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)=\\operatorname{sin}⁡x$ and ${y}_{2}(x)=\\operatorname{cos}⁡x$" :db/id #edb/ref 17592186397161} {:answer/id #uuid "8e6ce6c5-93bd-58b1-9fb8-00392e5ae9bc" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{2x}$ and ${y}_{2}(x)={e}^{-x}$" :db/id #edb/ref 17592186397162} {:answer/id #uuid "c741b2ff-ab7f-50e9-8510-a9245c14a314" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)=\\operatorname{sin}⁡2x$ and ${y}_{2}(x)=\\operatorname{cos}⁡2x$" :db/id #edb/ref 17592186397163} {:answer/id #uuid "c0522330-3e52-5790-9a75-e3f8ff7f852d" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{-2x}$" :db/id #edb/ref 17592186397164}] :answer-field/correct {:answer/id #uuid "8e6ce6c5-93bd-58b1-9fb8-00392e5ae9bc" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{2x}$ and ${y}_{2}(x)={e}^{-x}$" :db/id #edb/ref 17592186397162} :answer-field/id #uuid "45104fed-d5b1-5f34-94f6-9880f2f08e51" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397160} {:answer-field/choices [{:answer/id #uuid "6f1122a1-93f6-5c64-9f87-7969988c17b6" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186397166} {:answer/id #uuid "b91b465b-5b4d-556f-8377-2a1cf46f49c1" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)=0" :db/id #edb/ref 17592186397167}] :answer-field/correct {:answer/id #uuid "6f1122a1-93f6-5c64-9f87-7969988c17b6" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186397166} :answer-field/id #uuid "51dfa5bc-f977-5d9b-ba50-23229e7fd4f8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397165} {:answer-field/choices [{:answer/id #uuid "d279e548-5266-5f27-9d03-c8398d64cae6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(1)" :db/id #edb/ref 17592186397169} {:answer/id #uuid "54744ac7-fbfd-50c3-8251-2c3e6a450573" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{3}}{e}" :db/id #edb/ref 17592186397170} {:answer/id #uuid "b2774d8c-38d7-522f-be26-a346562dc684" :answer/type {:db/ident :answer.type/math} :answer/value "1-{e}^{2}" :db/id #edb/ref 17592186397171} {:answer/id #uuid "43570723-fc37-5b8a-8a4b-ada76825e92e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397172} {:answer/id #uuid "74cbe6be-bb9e-5d5a-9836-2608cbc207da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}+1}{e}" :db/id #edb/ref 17592186397173}] :answer-field/correct {:answer/id #uuid "54744ac7-fbfd-50c3-8251-2c3e6a450573" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{3}}{e}" :db/id #edb/ref 17592186397170} :answer-field/id #uuid "cb5e74c1-7ef2-5956-a46b-09ebf9d20450" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2dbc0eba-24a7-50e0-964f-4c8949e5821f" :question/math-academy-id "q-338686" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}-{y}^{′}-2y=0,\\,y(0)=y(1)=0,\\,0\\le x\\le 1\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=[\\begin{aligned}{y}_{1}(0) & {y}_{2}(0) \\\\ {y}_{1}(1) & {y}_{2}(1)\\end{aligned}].\n$$\n\nFill in the correct options in the reasoning below.\n\n$\\,$ The boundary value problem has a unique solution if and only if {{field-1}}.\n\n$\\,$ The fundamental solutions to this BVP are {{field-2}}.\n\n$\\,$ For this BVP, we have $det(A)=$ {{field-3}}.\n\n$\\,$ Therefore, this BVP {{field-4}}." :question/worked-solution "Suppose we have the second-order homogeneous boundary value (BVP) problem\n\n$$\n{y}^{″}(x)+P(x){y}^{′}+Q(x)y=0,\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)=0,\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)=0\n$$\n\nwhere $P$ and $Q$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ Furthermore, suppose the fundamental solutions to the equation are ${y}_{1}(x)$ and ${y}_{2}(x).$ \n\nNow, let's define the following matrix:\n\n$$\nA=[\\begin{aligned}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{aligned}]\n$$\n\nThen, the BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$\n\nIn other words, if the determinant equals zero, then the BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Dirichlet boundary conditions. So, setting ${\\alpha }_{i}=1,{\\beta }_{i}=0,a=0,$ and $b=1,$ the matrix $A$ reduces to\n\n$$\nA=[\\begin{aligned}{y}_{1}(0) & {y}_{2}(0) \\\\ {y}_{1}(1) & {y}_{2}(1)\\end{aligned}].\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-m-2 & =0 \\\\ (m-2)(m+1) & =0.\\end{aligned}\n$$\n\nSo, we have $m=2$ and $m=-1,$ and so the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{2x}\\text{ and }{y}_{2}(x)={e}^{-x}.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\nA=[\\begin{aligned}1 & 1 \\\\ {e}^{2} & {e}^{-1}\\end{aligned}]\n$$\n\nand we have\n\n$$\n\\begin{aligned}det(A) & ={e}^{-1}-{e}^{2} \\\\  & =\\frac{1}{e}-{e}^{2} \\\\  & =\\frac{1-{e}^{3}}{e}.\\end{aligned}\n$$\n\nSince $det(A)\\ne 0$ we conclude that this BVP $\\text{has the unique solution }y≡0.$"}] [{:db/id #edb/ref 17592186397174 :knowledge-point/_questions [{:knowledge-point/id #uuid "af8cf798-4327-5f5b-82ab-f622f20ccc38" :knowledge-point/title "Identifying Homogeneous Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed15164b-b252-57a7-9aea-30435b9a3865" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397176} {:answer/id #uuid "cddd9a34-b737-58d1-9afb-cdb77c0c26f9" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397177}] :answer-field/correct {:answer/id #uuid "ed15164b-b252-57a7-9aea-30435b9a3865" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397176} :answer-field/id #uuid "502c80ef-3dec-548c-927b-2e9b14bb965a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397175} {:answer-field/choices [{:answer/id #uuid "f24f87a8-01c4-5e7c-89a1-5d0f6d2ca765" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397179} {:answer/id #uuid "36bf4826-046d-5dea-84ce-588b7abe7e17" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397180} {:answer/id #uuid "4de81ab8-eb50-5141-bc5b-5482b95979d3" :answer/type {:db/ident :answer.type/text} :answer/value "Dirichlet" :db/id #edb/ref 17592186397181}] :answer-field/correct {:answer/id #uuid "f24f87a8-01c4-5e7c-89a1-5d0f6d2ca765" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397179} :answer-field/id #uuid "731a8ac7-b834-5f3c-9988-da7fada8b09f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397178} {:answer-field/choices [{:answer/id #uuid "53642858-4ce5-5373-905a-d8916de650d1" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397183} {:answer/id #uuid "9a8f292a-ee48-5ba5-9da3-8c6c59413e48" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397184}] :answer-field/correct {:answer/id #uuid "53642858-4ce5-5373-905a-d8916de650d1" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397183} :answer-field/id #uuid "844987f3-1e3f-53c7-ae11-937954d8e862" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397182} {:answer-field/choices [{:answer/id #uuid "967be8db-6c8c-5176-a37a-cfbb2d0acb70" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397186} {:answer/id #uuid "3558fe78-12f6-5e58-8639-b31e8f48b34e" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397187}] :answer-field/correct {:answer/id #uuid "967be8db-6c8c-5176-a37a-cfbb2d0acb70" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397186} :answer-field/id #uuid "d7c7990c-99a3-522c-9968-be9df4628906" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8670636a-35fe-5cb8-86c2-aff8f53ead1f" :question/math-academy-id "q-338697" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)-{x}^{2}{y}^{′}(x)+y(x)=0,\\,1\\le x\\le 2\n$$\n\n$$\ny(1)+{y}^{′}(1)=0,\\,5y(2)+2{y}^{′}(2)=0\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)-{x}^{2}{y}^{′}(x)+y(x)=0.\n$$\n\nSince the right-hand side $f(x)≡0,$ the equation is $\\text{homogeneous}.$\n\n- The boundary conditions are\n\n$$\ny(1)+{y}^{′}(1)=0,\\,5y(2)+2{y}^{′}(2)=0.\n$$\n\nThese are $\\text{Robin}$ boundary conditions, and since the right-hand sides are zero for both, they are $\\text{homogeneous}.$\n\n- Since the governing equation is homogeneous, and the boundary conditions are homogeneous, the BVP is $\\text{homogeneous}.$"}] [{:db/id #edb/ref 17592186397188 :knowledge-point/_questions [{:knowledge-point/id #uuid "af8cf798-4327-5f5b-82ab-f622f20ccc38" :knowledge-point/title "Identifying Homogeneous Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c0e445-a378-5434-8482-d18eb5704c6e" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397190} {:answer/id #uuid "7306602c-11b5-5992-8e61-45db9cbc8985" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397191} {:answer/id #uuid "f0bb6775-03ee-58e4-ba5e-2de0eb845912" :answer/type {:db/ident :answer.type/text} :answer/value "Dirichlet" :db/id #edb/ref 17592186397192}] :answer-field/correct {:answer/id #uuid "7306602c-11b5-5992-8e61-45db9cbc8985" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397191} :answer-field/id #uuid "c3dc8825-b674-5f4d-a900-52ba7affe048" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397189} {:answer-field/choices [{:answer/id #uuid "7b924dd1-224e-50e2-9d70-512974f4d0fc" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397194} {:answer/id #uuid "de09bc99-b772-5222-9a50-6fb9789ad69c" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397195}] :answer-field/correct {:answer/id #uuid "7b924dd1-224e-50e2-9d70-512974f4d0fc" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397194} :answer-field/id #uuid "e87367fd-f131-5c27-872b-a8a131079ebd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397193} {:answer-field/choices [{:answer/id #uuid "e49e4968-19a7-5c51-82d4-60b6c4e6e37b" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397197} {:answer/id #uuid "07be78c0-c60b-5a00-a83a-c253c5eb6a9c" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397198}] :answer-field/correct {:answer/id #uuid "07be78c0-c60b-5a00-a83a-c253c5eb6a9c" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397198} :answer-field/id #uuid "91f26eb2-9af1-5ccb-a522-7f873fdb0095" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397196} {:answer-field/choices [{:answer/id #uuid "31af7fa4-4513-5aef-83fe-a1d8f2b8b2e5" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397200} {:answer/id #uuid "2595a937-6145-59d8-b9db-727ca3b3098d" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397201}] :answer-field/correct {:answer/id #uuid "2595a937-6145-59d8-b9db-727ca3b3098d" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397201} :answer-field/id #uuid "f3fa453d-7107-5ec3-9427-f1bb56e42551" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397199}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "748763ae-3cf4-5f3d-aa38-02f8044e2446" :question/math-academy-id "q-338700" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)+\\operatorname{cos}⁡(x)\\,{y}^{′}(x)+y(x)=0,\\,-1\\le x\\le 1\n$$\n\n$$\n{y}^{′}(-1)=2,\\,{y}^{′}(1)=0\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)+\\operatorname{cos}⁡(x)\\,{y}^{′}(x)+y(x)=0.\n$$\n\nSince the right-hand side $f(x)≡0,$ the equation is $\\text{homogeneous}.$\n\n- The boundary conditions are\n\n$$\n{y}^{′}(-1)=2,\\,{y}^{′}(1)=0.\n$$\n\nThese are $\\text{Neumann}$ boundary conditions, and since the right-hand sides are not zero for both, they are $\\text{inhomogeneous}.$\n\n- Since the governing equation is homogeneous, yet the boundary conditions are inhomogeneous, the BVP is $\\text{inhomogeneous}.$"}] [{:db/id #edb/ref 17592186397202 :knowledge-point/_questions [{:knowledge-point/id #uuid "af8cf798-4327-5f5b-82ab-f622f20ccc38" :knowledge-point/title "Identifying Homogeneous Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81cc9abd-b067-56fe-9533-831b282c548c" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186397204} {:answer/id #uuid "79219c09-ee73-5582-b7f0-3c92d3e24434" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397205} {:answer/id #uuid "2f432c12-01eb-5ab3-b66e-a07f7961fb29" :answer/type {:db/ident :answer.type/text} :answer/value "Dirichlet" :db/id #edb/ref 17592186397206}] :answer-field/correct {:answer/id #uuid "79219c09-ee73-5582-b7f0-3c92d3e24434" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186397205} :answer-field/id #uuid "64e29f55-8029-5108-a581-698602c30477" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397203} {:answer-field/choices [{:answer/id #uuid "135741f7-fe86-5292-a33a-499ba6d19968" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397208} {:answer/id #uuid "311509b9-9db7-52b4-ab56-4b0fdb8f104f" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397209}] :answer-field/correct {:answer/id #uuid "311509b9-9db7-52b4-ab56-4b0fdb8f104f" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397209} :answer-field/id #uuid "5827196b-5d11-58a5-8374-869b17b516ae" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397207} {:answer-field/choices [{:answer/id #uuid "aca9f9a4-a5c0-5fb4-b089-3a7f47aa2f2d" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397211} {:answer/id #uuid "35658182-a940-5623-a87d-fd2e05811467" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397212}] :answer-field/correct {:answer/id #uuid "aca9f9a4-a5c0-5fb4-b089-3a7f47aa2f2d" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397211} :answer-field/id #uuid "4d9bbfef-5d8a-5eb4-afd5-bff174a7e808" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397210} {:answer-field/choices [{:answer/id #uuid "2636ba5a-474e-5a5d-9cb3-c2f759834dd5" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186397214} {:answer/id #uuid "da6fc2f4-1dc3-536a-a5eb-cd6619ddf024" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397215}] :answer-field/correct {:answer/id #uuid "da6fc2f4-1dc3-536a-a5eb-cd6619ddf024" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186397215} :answer-field/id #uuid "c5c9b5ab-10e3-5417-9498-0531c5e83157" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397213}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b12a4da-b770-5d48-8104-f0ea5dff8e44" :question/math-academy-id "q-338713" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)+(1+{x}^{2}){y}^{′}(x)-2y(x)=\\operatorname{sin}⁡x,\\,0\\le x\\le \\pi \n$$\n\n$$\n{y}^{′}(0)=0,\\,{y}^{′}(\\pi )=0\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)+(1+{x}^{2}){y}^{′}(x)-2y(x)=\\operatorname{sin}⁡x.\n$$\n\nSince the right-hand side $f(x)=\\operatorname{sin}⁡x≢0,$ the equation is $\\text{inhomogeneous}.$\n\n- The boundary conditions are\n\n$$\n{y}^{′}(0)=0,\\,{y}^{′}(\\pi )=0.\n$$\n\nThese are $\\text{Neumann}$ boundary conditions, and since the right-hand sides are zero for both, they are $\\text{homogeneous}.$\n\n- Since the governing equation is inhomogeneous, yet the boundary conditions are homogeneous, the BVP is $\\text{inhomogeneous}.$"}] [{:db/id #edb/ref 17592186397216 :knowledge-point/_questions [{:knowledge-point/id #uuid "ba4d320f-517e-5dc6-9c6d-02d1c2488472" :knowledge-point/title "Exponential Eigenfunctions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6333f256-57a4-524f-882c-85ce13ed4d52" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{x}$ and $Cx{e}^{-x}$" :db/id #edb/ref 17592186397218} {:answer/id #uuid "bdff980e-244b-5407-8c35-36869326e1f5" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-\\frac{3}{2}x}$ only" :db/id #edb/ref 17592186397219} {:answer/id #uuid "ef9fce80-afaa-5cf2-a342-0dd3523e12a2" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-2x}$ only" :db/id #edb/ref 17592186397220} {:answer/id #uuid "bc315ebe-9716-5917-b194-2a4a36b373d9" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{2x}$ only" :db/id #edb/ref 17592186397221} {:answer/id #uuid "3ce119a8-474d-516f-b714-f6645bb4943e" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{\\frac{3}{2}x}$ and $Cx{e}^{-\\frac{3}{2}x}$" :db/id #edb/ref 17592186397222}] :answer-field/correct {:answer/id #uuid "bdff980e-244b-5407-8c35-36869326e1f5" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-\\frac{3}{2}x}$ only" :db/id #edb/ref 17592186397219} :answer-field/id #uuid "6451528f-6193-5fce-847d-24fbb635dd58" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397217} {:answer-field/choices [{:answer/id #uuid "8f942b92-7058-551e-856d-94bbeff34573" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ only" :db/id #edb/ref 17592186397224} {:answer/id #uuid "e417753c-3dcf-5b7e-8c3e-55d245a9b3a5" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{1}{2}$ only" :db/id #edb/ref 17592186397225} {:answer/id #uuid "9ff25083-915f-5352-b85b-65678f3833df" :answer/type {:db/ident :answer.type/math} :answer/value "\\pm 1" :db/id #edb/ref 17592186397226} {:answer/id #uuid "e1eb5523-b928-553e-8031-34e6f2d343f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\pm \\frac{3}{14}" :db/id #edb/ref 17592186397227} {:answer/id #uuid "182b3678-ac7b-5812-986d-8764905ed502" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{3}{14}$ only" :db/id #edb/ref 17592186397228}] :answer-field/correct {:answer/id #uuid "182b3678-ac7b-5812-986d-8764905ed502" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{3}{14}$ only" :db/id #edb/ref 17592186397228} :answer-field/id #uuid "81e0c9b5-cbc2-598f-97c0-6c5a9eeadf86" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397223}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba070694-f520-5989-9c36-fcafe8653bcc" :question/math-academy-id "q-338837" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}-14\\lambda {y}^{′}+49{\\lambda }^{2}y=0,\\,y(0)=0,\\,y(2)+{y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\in R.\n$$\n\nFind the eigenvalues and eigenfunctions of this problem. Assume that $B$ and $C$ are constants.$\\,$ The eigenvalues are $\\lambda =$ {{field-1}}.\n\n$\\,$ The eigenfunctions are $y=$ {{field-2}}." :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and $y(2)+{y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-14\\lambda m+49{\\lambda }^{2} & =0 \\\\ (m-7\\lambda )(m-7\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=7\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{7\\lambda x},\\,{y}_{2}(x)=x{e}^{7\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{7\\lambda x}+Bx{e}^{7\\lambda x}.\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA+B\\cdot 0=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=Bx{e}^{7\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′}=B{e}^{7\\lambda x}+7B\\lambda x{e}^{7\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition $y(2)+{y}^{′}(2)=0$ yields\n\n$$\n\\begin{aligned}2B{e}^{14\\lambda }+B{e}^{14\\lambda }+14B\\lambda {e}^{14\\lambda } & =0 \\\\ 3B{e}^{14\\lambda }+14B\\lambda {e}^{14\\lambda } & =0 \\\\ B{e}^{14\\lambda }+\\frac{14}{3}B\\lambda {e}^{14\\lambda } & =0 \\\\ B{e}^{14\\lambda }(1+\\frac{14}{3}\\lambda ) & =0.\\end{aligned}\n$$\n\nFor nontrivial solutions, we require $B\\ne 0.$ Thus, since ${e}^{14\\lambda }>0,$ we must have\n\n$$\n\\lambda =-\\frac{3}{14}.\n$$\n\nTherefore, the corresponding eigenfunction is\n\n$$\n\\begin{aligned}y(x) & =Bx{e}^{7\\lambda x} \\\\  & =Bx{e}^{-\\frac{3}{2}x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186397229 :knowledge-point/_questions [{:knowledge-point/id #uuid "ba4d320f-517e-5dc6-9c6d-02d1c2488472" :knowledge-point/title "Exponential Eigenfunctions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bbb88d2-d106-5a48-a491-8a1865d27c49" :answer/type {:db/ident :answer.type/math} :answer/value "\\pm \\frac{7}{18}" :db/id #edb/ref 17592186397231} {:answer/id #uuid "67f9752d-2717-5fd3-89ed-ddffa71fb940" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ only" :db/id #edb/ref 17592186397232} {:answer/id #uuid "a197a422-5c87-5907-bb4d-6cb21111b01d" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ only" :db/id #edb/ref 17592186397233} {:answer/id #uuid "e1402155-85cf-54ae-8dae-41b284721aaa" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{7}{18}$ only" :db/id #edb/ref 17592186397234} {:answer/id #uuid "de1e54e4-c76b-5bbc-878c-a545826e8820" :answer/type {:db/ident :answer.type/math} :answer/value "\\pm 2" :db/id #edb/ref 17592186397235}] :answer-field/correct {:answer/id #uuid "e1402155-85cf-54ae-8dae-41b284721aaa" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{7}{18}$ only" :db/id #edb/ref 17592186397234} :answer-field/id #uuid "4c538818-2826-5c63-ba40-2de95adb895c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397230} {:answer-field/choices [{:answer/id #uuid "140b4847-4a5b-5d7f-86de-35bc43b0ad69" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{7x/6}$ and $Cx{e}^{-7x/6}$" :db/id #edb/ref 17592186397237} {:answer/id #uuid "6c9a82c9-1222-5042-83d2-13a77db7ac2b" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{x}$ and $Cx{e}^{-x}$" :db/id #edb/ref 17592186397238} {:answer/id #uuid "8a10ebeb-c0e2-55fd-a474-2902f9e065b8" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-x}$ only" :db/id #edb/ref 17592186397239} {:answer/id #uuid "ef701c60-7e0e-59df-91ed-7707b3fcd28a" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-7x/6}$ only" :db/id #edb/ref 17592186397240} {:answer/id #uuid "9efb216e-ffb8-5585-b11d-72d7a980688a" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-7x/3}$ only" :db/id #edb/ref 17592186397241}] :answer-field/correct {:answer/id #uuid "ef701c60-7e0e-59df-91ed-7707b3fcd28a" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-7x/6}$ only" :db/id #edb/ref 17592186397240} :answer-field/id #uuid "c3f0e357-b57a-5092-8107-004d7ace2a2f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397236}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fbda52c-e557-5901-ad9a-c542b15bd0a8" :question/math-academy-id "q-338853" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}-6\\lambda {y}^{′}+9{\\lambda }^{2}y=0,\\,y(0)=0,\\,2y(2)+3{y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\in R.\n$$\n\nFind the eigenvalues and eigenfunctions of this problem. Assume that $B$ and $C$ are constants.$\\,$ The eigenvalues are $\\lambda =$ {{field-1}}.\n\n$\\,$ The eigenfunctions are $y=$ {{field-2}}." :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and $2y(2)+3{y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-6\\lambda m+9{\\lambda }^{2} & =0 \\\\ (m-3\\lambda )(m-3\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=3\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{3\\lambda x},\\,{y}_{2}(x)=x{e}^{3\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{3\\lambda x}+Bx{e}^{3\\lambda x}.\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA+B\\cdot 0=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=Bx{e}^{3\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′}=B{e}^{3\\lambda x}+3B\\lambda x{e}^{3\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition $2y(2)+3{y}^{′}(2)=0$ yields\n\n$$\n\\begin{aligned}2(2B{e}^{6\\lambda })+3(B{e}^{6\\lambda }+6B\\lambda {e}^{6\\lambda }) & =0 \\\\ 4B{e}^{6\\lambda }+3B{e}^{6\\lambda }+18B\\lambda {e}^{6\\lambda } & =0 \\\\ B{e}^{6\\lambda }(7+18\\lambda ) & =0.\\end{aligned}\n$$\n\nFor nontrivial solutions, we require $B\\ne 0.$ Thus, since ${e}^{6\\lambda }>0,$ we must have\n\n$$\n\\lambda =-\\frac{7}{18}.\n$$\n\nTherefore, the corresponding eigenfunction is\n\n$$\n\\begin{aligned}y(x) & =Bx{e}^{3\\lambda x} \\\\  & =Bx{e}^{-7x/6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186397242 :knowledge-point/_questions [{:knowledge-point/id #uuid "96494014-7289-548b-9749-2eb6336c9cef" :knowledge-point/title "Classifying Solutions of Inhomogeneous BVPs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57953917-9b55-5619-a644-205d5986c778" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397244} {:answer/id #uuid "84309482-f526-5187-af7f-dc14b214756c" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397245} {:answer/id #uuid "4c30858b-6958-5b31-94ac-a6c2b49da2dc" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397246}] :answer-field/correct {:answer/id #uuid "57953917-9b55-5619-a644-205d5986c778" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397244} :answer-field/id #uuid "469938c6-f220-5660-b177-dff8d9814679" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397243} {:answer-field/choices [{:answer/id #uuid "f9a08f35-f8cd-5a90-bedd-518473486f75" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397248} {:answer/id #uuid "d88de683-917f-5c51-a866-9f444be17076" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397249} {:answer/id #uuid "19b0377b-6071-5f48-bceb-b57e0d0432e2" :answer/type {:db/ident :answer.type/text} :answer/value "has a unique solution" :db/id #edb/ref 17592186397250} {:answer/id #uuid "ed9dc3a2-e8c2-5c1a-ae6f-935009d158f2" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions or no solution" :db/id #edb/ref 17592186397251}] :answer-field/correct {:answer/id #uuid "19b0377b-6071-5f48-bceb-b57e0d0432e2" :answer/type {:db/ident :answer.type/text} :answer/value "has a unique solution" :db/id #edb/ref 17592186397250} :answer-field/id #uuid "7184a2d1-142e-5a80-b6b3-2020f6f8c935" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397247} {:answer-field/choices [{:answer/id #uuid "74a65952-2694-54eb-b16e-b141038d04a7" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}-1" :db/id #edb/ref 17592186397253} {:answer/id #uuid "13f225ac-2005-50c6-8990-1374897e301c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}-1}{{e}^{2}}" :db/id #edb/ref 17592186397254} {:answer/id #uuid "01a78aaf-52d8-5e47-ac82-4d80dbcff436" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397255} {:answer/id #uuid "5b62f57e-bba8-5a70-81e8-84dc47d97b58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}-1}{e}" :db/id #edb/ref 17592186397256} {:answer/id #uuid "faa5f024-9c77-51f7-b98c-9d941600d936" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}+1}{e}" :db/id #edb/ref 17592186397257}] :answer-field/correct {:answer/id #uuid "5b62f57e-bba8-5a70-81e8-84dc47d97b58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{3}-1}{e}" :db/id #edb/ref 17592186397256} :answer-field/id #uuid "cd092bf8-3470-5e3b-adb1-e164fc3a35de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8eb48225-775a-576c-bf42-f55c3f321d8e" :question/math-academy-id "q-338878" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}-{y}^{′}-2y=4x,\\,y(0)=1,\\,y(1)=3,\\,0\\le x\\le 1\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be fundamental solutions of the form $y={e}^{mx}$ to the corresponding homogeneous BVP, and suppose we define the matrix $A$ as \n\n$$\nA=[\\begin{aligned}{y}_{1}(0) & {y}_{2}(0) \\\\ {y}_{1}(1) & {y}_{2}(1)\\end{aligned}].\n$$\n\nFill in the correct options in the reasoning below **without calculating the solution** to this BVP.\n\n$\\,$ The **absolute value** of $det(A)$ is {{field-1}}.\n\n$\\,$ Therefore, the corresponding homogeneous BVP {{field-2}}.\n\n$\\,$ Therefore, our inhomogeneous BVP {{field-3}}." :question/worked-solution "Suppose we have the second-order inhomogeneous boundary value problem (BVP)\n\n$$\n{y}^{″}(x)+P(x){y}^{′}+Q(x)y=f(x),\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere $P,Q,$ and $f$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nThe inhomogeneous BVP has at most one solution if and only if the associated homogeneous BVP has only the trivial solution $y≡0.$ Specifically:\n\n- If the homogeneous BVP has the unique solution $y≡0,$ then the inhomogeneous problem has a unique solution.\n\n- If the homogeneous BVP has (infinitely many) nontrivial solutions, then the inhomogeneous problem either has infinitely many solutions or no solution.\n\nTo classify the solutions of the corresponding homogeneous BVP, we define the matrix $A$ as\n\n$$\nA=[\\begin{aligned}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{aligned}].\n$$\n\nThe homogeneous BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$ In other words, if the determinant equals zero, then the homogeneous BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Dirichlet boundary conditions. So, setting ${\\alpha }_{i}=1,{\\beta }_{i}=0,a=0,$ and $b=1,$ the matrix $A$ reduces to\n\n$$\nA=[\\begin{aligned}{y}_{1}(0) & {y}_{2}(0) \\\\ {y}_{1}(1) & {y}_{2}(1)\\end{aligned}].\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-m-2 & =0 \\\\ (m-2)(m+1) & =0.\\end{aligned}\n$$\n\nSo, we have $m=2$ and $m=-1,$ and so the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{2x},\\,{y}_{2}(x)={e}^{-x}.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\nA=[\\begin{aligned}1 & 1 \\\\ {e}^{2} & {e}^{-1}\\end{aligned}]\n$$\n\nand we have\n\n$$\n\\begin{aligned}|det(A)| & =|{e}^{-1}-{e}^{2}| \\\\  & =|\\frac{1}{e}-{e}^{2}| \\\\  & =\\frac{{e}^{3}-1}{e}.\\end{aligned}\n$$\n\nSince $det(A)\\ne 0,$ the corresponding homogeneous BVP $\\text{has the unique solution }y≡0.$\n\nTherefore, since the corresponding homogeneous BVP has only the trivial solution $y≡0$, our inhomogeneous BVP $\\text{has a unique solution}.$"}] [{:db/id #edb/ref 17592186397258 :knowledge-point/_questions [{:knowledge-point/id #uuid "ba4d320f-517e-5dc6-9c6d-02d1c2488472" :knowledge-point/title "Exponential Eigenfunctions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "877ab039-605d-549e-8622-6cae0d465fe3" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-x}$ and $C{e}^{x/2}(x-3)$" :db/id #edb/ref 17592186397260} {:answer/id #uuid "ebf99903-ee3b-5e01-a931-22d951facaab" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-2x}$ and $C{e}^{x}(x-3)$" :db/id #edb/ref 17592186397261} {:answer/id #uuid "e9a527a7-acdb-51b7-9ade-49877be410a4" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{x}$ and $C{e}^{-x/2}(x-2)$" :db/id #edb/ref 17592186397262} {:answer/id #uuid "479d00a1-2920-59e5-b016-b0576cc21641" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-x}$ and $C{e}^{x/2}(x-2)$" :db/id #edb/ref 17592186397263}] :answer-field/correct {:answer/id #uuid "877ab039-605d-549e-8622-6cae0d465fe3" :answer/type {:db/ident :answer.type/text} :answer/value "$Bx{e}^{-x}$ and $C{e}^{x/2}(x-3)$" :db/id #edb/ref 17592186397260} :answer-field/id #uuid "36ec000b-c994-55b9-b093-1daaa5f63bf9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397259} {:answer-field/choices [{:answer/id #uuid "50817ef9-0b55-5b6b-94aa-573ea49716ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{20}" :db/id #edb/ref 17592186397265} {:answer/id #uuid "42571170-ae49-58a1-a447-73aed3d500ef" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{1}{10}$ and $\\frac{1}{20}$" :db/id #edb/ref 17592186397266} {:answer/id #uuid "219f78d1-948d-5466-8f67-a7b5b558a098" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{1}{20}$ and $\\frac{1}{10}$" :db/id #edb/ref 17592186397267} {:answer/id #uuid "2f1b1192-6a7f-53e2-8bde-b8b0685bd05c" :answer/type {:db/ident :answer.type/math} :answer/value "\\pm \\frac{1}{10}" :db/id #edb/ref 17592186397268}] :answer-field/correct {:answer/id #uuid "42571170-ae49-58a1-a447-73aed3d500ef" :answer/type {:db/ident :answer.type/text} :answer/value "$-\\frac{1}{10}$ and $\\frac{1}{20}$" :db/id #edb/ref 17592186397266} :answer-field/id #uuid "75123b29-65f0-56eb-bdd5-9f239c208387" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e67017cf-eb62-5988-9350-d0872682f901" :question/math-academy-id "q-338905" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}-20\\lambda {y}^{′}+100{\\lambda }^{2}y=0,\\,{y}^{′}(1)=0,\\,y(2)+2{y}^{′}(2)=0,\\,1\\le x\\le 2,\\,\\lambda \\in R.\n$$\n\nFind the eigenvalues and eigenfunctions of this problem. Assume that $B$ and $C$ are constants.$\\,$ The eigenvalues are $\\lambda =$ {{field-1}}.\n\n$\\,$ The eigenfunctions are $y=$ {{field-2}}." :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions ${y}^{′}(1)=0$ and $y(2)+2{y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-20\\lambda m+100{\\lambda }^{2} & =0 \\\\ (m-10\\lambda )(m-10\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=10\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{10\\lambda x},\\,{y}_{2}(x)=x{e}^{10\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{10\\lambda x}+Bx{e}^{10\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′} & =10A\\lambda {e}^{10\\lambda x}+B{e}^{10\\lambda x}+10B\\lambda x{e}^{10\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition ${y}^{′}(1)=0$ yields\n\n$$\n\\begin{aligned}10A\\lambda {e}^{10\\lambda }+B{e}^{10\\lambda }+10B\\lambda {e}^{10\\lambda } & =0 \\\\ 10A\\lambda +B+10B\\lambda  & =0 \\\\ (10\\lambda )A+(1+10\\lambda )B & =0.\\end{aligned}\n$$\n\nApplying the boundary condition $y(2)+2{y}^{′}(2)=0$ yields\n\n$$\n\\begin{aligned}A{e}^{20\\lambda }+2B{e}^{20\\lambda }+2(10A\\lambda {e}^{20\\lambda }+B{e}^{20\\lambda }+20B\\lambda {e}^{20\\lambda }) & =0 \\\\ A+2B+2(10A\\lambda +B+20B\\lambda ) & =0 \\\\ A+2B+20A\\lambda +2B+40B\\lambda  & =0 \\\\ (1+20\\lambda )A+(4+40\\lambda )B & =0 \\\\ (1+20\\lambda )A+4(1+10\\lambda )B & =0.\\end{aligned}\n$$\n\nSo, we have the following systems of equations for $A$ and $B:$\n\n$$\n{\\begin{aligned}(10\\lambda )A+(1+10\\lambda )B=0 \\\\ (1+20\\lambda )A+4(1+10\\lambda )B=0\\end{aligned}\n$$\n\nThis homogeneous linear system has a nontrivial solution if and only if the determinant is zero. This gives\n\n$$\n|\\begin{aligned}10\\lambda  & 1+10\\lambda  \\\\ 1+20\\lambda  & 4(1+10\\lambda )\\end{aligned}|=0.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}10\\lambda \\cdot 4(1+10\\lambda )-(1+10\\lambda )(1+20\\lambda ) & =0 \\\\ (1+10\\lambda )[40\\lambda -(1+20\\lambda )] & =0 \\\\ (1+10\\lambda )[40\\lambda -1-20\\lambda ] & =0 \\\\ (1+10\\lambda )(20\\lambda -1) & =0.\\end{aligned}\n$$\n\nThus, we have the eigenvalues ${\\lambda }_{1}=-\\frac{1}{10}\\text{ and }{\\lambda }_{2}=\\frac{1}{20}.$\n\nFinally, we find the eigenfunction corresponding to each eigenvalue:\n\n- Consider ${\\lambda }_{1}=-\\frac{1}{10}.$ Then, we have the solution\n\n$$\n\\begin{aligned}{y}_{1}(x) & =A{e}^{10{\\lambda }_{1}x}+Bx{e}^{10{\\lambda }_{1}x} \\\\  & =A{e}^{-x}+Bx{e}^{-x}\\end{aligned}\n$$\n\nand substituting ${\\lambda }_{1}$ into\n\n$$\n(10\\lambda )A+(1+10\\lambda )B=0\n$$\n\n \nwe get \n\n$$\n-A+(1-1)B=0\n$$\n\n \nwhich gives $A=0,$ and where $B$ is a free parameter. Thus, the eigenfunction corresponding to this eigenvalue is\n\n$$\n{y}_{1}(x)=Bx{e}^{-x}.\n$$\n\n- For ${\\lambda }_{2}=\\frac{1}{20},$ we have\n\n$$\n\\begin{aligned}{y}_{2}(x) & =A{e}^{10{\\lambda }_{2}x}+Bx{e}^{10{\\lambda }_{2}x} \\\\  & =A{e}^{x/2}+Bx{e}^{x/2}\\end{aligned}\n$$\n\nand substituting ${\\lambda }_{2}$ into\n\n$$\n(10\\lambda )A+(1+10\\lambda )B=0\n$$\n\n \nwe get \n\n$$\n\\frac{1}{2}A+\\frac{3}{2}B=0\\,⇒\\,A=-3B\n$$\n\nwhere $B$ is a free parameter. Thus, the eigenfunction corresponding to this eigenvalue is\n\n$$\n\\begin{aligned}{y}_{2}(x) & =-3B{e}^{x/2}+Bx{e}^{x/2} \\\\  & =B{e}^{x/2}(x-3) \\\\  & =C{e}^{x/2}(x-3)\\end{aligned}\n$$\n\nwhere we have set $C=B.$\n\nSo, the eigenfunctions corresponding to ${\\lambda }_{1}$ and ${\\lambda }_{2},$ respectively, are $Bx{e}^{-x}\\text{ and }C{e}^{x/2}(x-3).$"}] [{:db/id #edb/ref 17592186397269 :knowledge-point/_questions [{:knowledge-point/id #uuid "472cbb79-e22b-50d2-a997-93130ff66c22" :knowledge-point/title "Trigonometric Eigenfunctions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34c15024-ad26-5f05-9256-bec2be1ec08d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n}{3}" :db/id #edb/ref 17592186397271} {:answer/id #uuid "0f13f8cc-8f5b-59e1-9e1b-8571f15b04e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{9}" :db/id #edb/ref 17592186397272} {:answer/id #uuid "ae0e24c0-3ab7-5f6f-99fb-9147b822880e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{3}" :db/id #edb/ref 17592186397273} {:answer/id #uuid "0adf033e-d27a-587a-b356-01b5a700380c" :answer/type {:db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186397274} {:answer/id #uuid "28b42bdc-4e58-542b-8a98-ce465846e44e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3n}{\\pi }" :db/id #edb/ref 17592186397275}] :answer-field/correct {:answer/id #uuid "34c15024-ad26-5f05-9256-bec2be1ec08d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n}{3}" :db/id #edb/ref 17592186397271} :answer-field/id #uuid "00e92f05-552a-5096-91d9-24d9da00fdbd" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397270} {:answer-field/choices [{:answer/id #uuid "d149f557-f909-5ed0-be99-174185a4e256" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(\\frac{{\\lambda }_{n}x}{3})" :db/id #edb/ref 17592186397277} {:answer/id #uuid "5923f52e-15f1-5a9c-b5a9-fa0804ebc1e4" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡(\\frac{3{\\lambda }_{n}x}{2})" :db/id #edb/ref 17592186397278} {:answer/id #uuid "15092485-4594-5a18-ac64-9c22f0bd52ca" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡({\\lambda }_{n}x)" :db/id #edb/ref 17592186397279} {:answer/id #uuid "531f6fe0-e7a7-5f58-9025-95838ba779ba" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡(3{\\lambda }_{n}x)" :db/id #edb/ref 17592186397280} {:answer/id #uuid "5907806c-b6ca-50c7-955f-3897edc07f12" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{cos}⁡({\\lambda }_{n}x)" :db/id #edb/ref 17592186397281} {:answer/id #uuid "86e0f9bf-00a1-5204-9647-0bc6ec485936" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(3{\\lambda }_{n}x)" :db/id #edb/ref 17592186397282}] :answer-field/correct {:answer/id #uuid "86e0f9bf-00a1-5204-9647-0bc6ec485936" :answer/type {:db/ident :answer.type/math} :answer/value "{B}_{n}\\operatorname{sin}⁡(3{\\lambda }_{n}x)" :db/id #edb/ref 17592186397282} :answer-field/id #uuid "57b058f9-2857-5bd3-9ddc-d9ffd448c64e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "958d5083-ae6b-5fcf-874a-f964110a9edf" :question/math-academy-id "q-338907" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+9{\\lambda }^{2}y=0,\\,y(0)=y(\\pi )=0,\\,0\\le x\\le \\pi ,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=y(\\pi )=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ does not correspond to an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+9{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 3\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(3\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(3\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(3\\lambda x)+B\\operatorname{sin}⁡(3\\lambda x).\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=B\\operatorname{sin}⁡(3\\lambda x).\n$$\n\nApplying the boundary condition $y(\\pi )=0$ yields\n\n$$\nB\\operatorname{sin}⁡(3\\lambda \\pi )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n3\\lambda \\pi =n\\pi \n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{n}{3}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{sin}⁡(3{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$"}] [{:db/id #edb/ref 17592186397283 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d9576e0-3be5-5d05-8cc8-c3ecde496b46" :knowledge-point/title "Classifying Solutions of Homogeneous BVPs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc9b72e9-fff2-5f3d-af71-a6cc5a8690e6" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397285} {:answer/id #uuid "e0887495-5b99-519d-8b06-b050d9a2f259" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397286} {:answer/id #uuid "7ecfede9-c62d-5886-a299-f1a637666f1c" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397287}] :answer-field/correct {:answer/id #uuid "fc9b72e9-fff2-5f3d-af71-a6cc5a8690e6" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397285} :answer-field/id #uuid "0c637c93-1ee3-58ef-993c-3c6e5c1fc84b" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397284} {:answer-field/choices [{:answer/id #uuid "4b52e930-14ea-531b-b526-eaff6b0fb8cd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(2)" :db/id #edb/ref 17592186397289} {:answer/id #uuid "8afc5730-0411-589a-b64a-42f650c93db0" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{6}(3{e}^{4}-1)" :db/id #edb/ref 17592186397290} {:answer/id #uuid "6b215d5b-71fa-5321-b766-c19abcce664a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{6}(3{e}^{3}+1)" :db/id #edb/ref 17592186397291} {:answer/id #uuid "db7b6416-a35a-5ac4-84e2-f2ecee72c7f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2)" :db/id #edb/ref 17592186397292} {:answer/id #uuid "cd306ca1-9609-57f9-8243-6c8325a1cf83" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397293}] :answer-field/correct {:answer/id #uuid "8afc5730-0411-589a-b64a-42f650c93db0" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{6}(3{e}^{4}-1)" :db/id #edb/ref 17592186397290} :answer-field/id #uuid "33bba31b-5240-5dae-836f-d5e2781c4733" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397288} {:answer-field/choices [{:answer/id #uuid "dcc04b9a-9cfc-5141-a860-86088f43169c" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186397295} {:answer/id #uuid "3900c0eb-6950-53f9-bfb1-9594df80a763" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)=0" :db/id #edb/ref 17592186397296}] :answer-field/correct {:answer/id #uuid "dcc04b9a-9cfc-5141-a860-86088f43169c" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186397295} :answer-field/id #uuid "40ecf88c-bee2-552d-9e9b-2221a6455c26" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397294} {:answer-field/choices [{:answer/id #uuid "0f04959b-3b97-5dd8-8bc1-66c4bf84b779" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{-x}$ and ${y}_{2}(x)={e}^{-3x}$" :db/id #edb/ref 17592186397298} {:answer/id #uuid "55749b1e-7fb0-5999-951d-ee88ea733318" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{3x}$" :db/id #edb/ref 17592186397299} {:answer/id #uuid "a7af3aac-e800-5201-888a-579b4e28c609" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{x}\\operatorname{sin}⁡3x$ and ${y}_{2}(x)={e}^{x}\\operatorname{cos}⁡3x$" :db/id #edb/ref 17592186397300} {:answer/id #uuid "de01c055-6b53-5e7e-b43f-8cad2dcffec0" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)=\\operatorname{sin}⁡3x$ and ${y}_{2}(x)=\\operatorname{cos}⁡3x$" :db/id #edb/ref 17592186397301}] :answer-field/correct {:answer/id #uuid "55749b1e-7fb0-5999-951d-ee88ea733318" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{3x}$" :db/id #edb/ref 17592186397299} :answer-field/id #uuid "abb190aa-1853-5191-97ba-08809006a2a4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76fbcb9f-680c-51b9-b052-efdce55007dc" :question/math-academy-id "q-338982" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}-4{y}^{′}+3y=0,\\,y(1)={y}^{′}(3)=0,\\,1\\le x\\le 3\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=[\\begin{aligned}{y}_{1}(1) & {y}_{2}(1) \\\\ {y}_{1}^{′}(3) & {y}_{2}^{′}(3)\\end{aligned}].\n$$\n\nFill in the correct options in the reasoning below.\n\n$\\,$ The boundary value problem has a unique solution if and only if {{field-1}}.\n\n$\\,$ The fundamental solutions to this BVP are {{field-2}}.\n\n$\\,$ For this BVP, we have $det(A)=$ {{field-3}}.\n\n$\\,$ Therefore, this BVP {{field-4}}." :question/worked-solution "Suppose we have the second-order homogeneous boundary value (BVP) problem\n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y=0,\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)=0,\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)=0,\n$$\n\nwhere $P$ and $Q$ are continuous on $[a,b],$ and ${\\alpha }_{i},{\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ Furthermore, suppose the fundamental solutions to the equation are ${y}_{1}(x)$ and ${y}_{2}(x).$   \n\nNow, let's define the following matrix:\n\n$$\nA=[\\begin{aligned}{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{aligned}].\n$$\n\nThen, the BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$\nIn other words, if the determinant equals zero, then the BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Robin boundary conditions given by\n\n$$\ny(1)=0,\\,{y}^{′}(3)=0.\n$$\n\nSo, setting ${\\alpha }_{1}=1,$ ${\\beta }_{1}=0,$ ${\\alpha }_{2}=0,$ ${\\beta }_{2}=1,$ and $a=1,$ $b=3,$ the matrix $A$ reduces to\n\n$$\nA=[\\begin{aligned}{y}_{1}(1) & {y}_{2}(1) \\\\ {y}_{1}^{′}(3) & {y}_{2}^{′}(3)\\end{aligned}].\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-4m+3 & =0 \\\\ (m-1)(m-3) & =0.\\end{aligned}\n$$\n\nSo, we have ${m}_{1}=1$ and ${m}_{2}=3,$ and so the fundamental solutions are\n\n$$\n{y}_{1}(x)={e}^{x}\\,\\text{and}\\,{y}_{2}(x)={e}^{3x}.\n$$\n\nDifferentiating, we have\n\n$$\n{y}_{1}^{′}(x)={e}^{x},\\,{y}_{2}^{′}(x)=3{e}^{3x}.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}{e}^{1} & {e}^{3(1)} \\\\ {e}^{3} & 3{e}^{3(3)}\\end{aligned}] \\\\  & =[\\begin{aligned}e & {e}^{3} \\\\ {e}^{3} & 3{e}^{9}\\end{aligned}],\\end{aligned}\n$$\n\nand we have\n\n$$\n\\begin{aligned}det(A) & =e(3{e}^{9})-{e}^{3}({e}^{3}) \\\\  & =3{e}^{10}-{e}^{6} \\\\  & ={e}^{6}(3{e}^{4}-1).\\end{aligned}\n$$\n\nSince $det(A)\\ne 0,$ we conclude that this BVP $\\text{has the unique solution }y≡0.$"}] [{:db/id #edb/ref 17592186397302 :knowledge-point/_questions [{:knowledge-point/id #uuid "01c5809f-cb10-5192-b646-13036813137d" :knowledge-point/title "Solving First-Order Initial Value Problems Using Integrating Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c73a7b2-a2bf-518a-beb1-31fbbadf0c5c" :answer/type {:db/ident :answer.type/math} :answer/value "6-{e}^{{x}^{2}}" :db/id #edb/ref 17592186397304} {:answer/id #uuid "d70f278f-f71b-563b-90a5-a72e4490f97d" :answer/type {:db/ident :answer.type/math} :answer/value "6x+5" :db/id #edb/ref 17592186397305} {:answer/id #uuid "7c9aa96a-e438-54ed-91f2-a9cd9b89c2af" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{6{x}^{2}}" :db/id #edb/ref 17592186397306} {:answer/id #uuid "be7b681a-d4b7-5605-ba2e-22acaaed6363" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{2}+5" :db/id #edb/ref 17592186397307} {:answer/id #uuid "6e0d3cd9-78d0-5801-b268-5ffd73ca96c8" :answer/type {:db/ident :answer.type/math} :answer/value "6-{e}^{-{x}^{2}/12}" :db/id #edb/ref 17592186397308}] :answer-field/correct {:answer/id #uuid "6e0d3cd9-78d0-5801-b268-5ffd73ca96c8" :answer/type {:db/ident :answer.type/math} :answer/value "6-{e}^{-{x}^{2}/12}" :db/id #edb/ref 17592186397308} :answer-field/id #uuid "40c6d291-cf90-51ae-b2e3-e5400146213f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397303} {:answer-field/choices [{:answer/id #uuid "4e829349-3bd7-53b1-81eb-45b5da9870a7" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{12x}" :db/id #edb/ref 17592186397310} {:answer/id #uuid "ddaeb121-e0a6-501b-9a51-af6c7d17b5d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}" :db/id #edb/ref 17592186397311} {:answer/id #uuid "831b7918-1f4b-50de-b1bd-28a0091624cc" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{6}" :db/id #edb/ref 17592186397312} {:answer/id #uuid "327e9b36-504a-55cd-bdeb-9a295dbac872" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{{x}^{2}/12}" :db/id #edb/ref 17592186397313}] :answer-field/correct {:answer/id #uuid "327e9b36-504a-55cd-bdeb-9a295dbac872" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{{x}^{2}/12}" :db/id #edb/ref 17592186397313} :answer-field/id #uuid "f1cc20f5-acca-5b79-8f90-bd4ac033d4c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397309}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b18cb65d-b781-5075-91bf-6c656ac3ed30" :question/math-academy-id "q-339145" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{6}y=x,\\,y(0)=5\n$$\n\nSelect the correct options below.\n$\\,$ An integrating factor for this equation is $I(x)=$ {{field-1}}.\n\n$\\,$ The solution to the initial value problem is $y(x)=$ {{field-2}}." :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x}{6}$ and $Q(x)=x.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int (x/6)\\,\\text{d}x} \\\\  & ={e}^{{x}^{2}/12}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)={e}^{{x}^{2}/12}$ yields\n\n$$\n\\begin{aligned}{e}^{{x}^{2}/12}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{6}y) & ={e}^{{x}^{2}/12}\\cdot x \\\\ {e}^{{x}^{2}/12}\\cdot \\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{6}{e}^{{x}^{2}/12}\\cdot y & =x{e}^{{x}^{2}/12} \\\\ \\frac{\\text{d}}{\\text{d}x}(y{e}^{{x}^{2}/12}) & =x{e}^{{x}^{2}/12}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{{x}^{2}}{12}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(y{e}^{{x}^{2}/12})\\text{d}x & =\\int x{e}^{{x}^{2}/12}\\,\\text{d}x \\\\ y{e}^{{x}^{2}/12} & =\\int 6{e}^{u}\\,\\text{d}u \\\\ y{e}^{{x}^{2}/12} & =6{e}^{u}+C \\\\ y{e}^{{x}^{2}/12} & =6{e}^{{x}^{2}/12}+C \\\\ y & =6+C{e}^{-{x}^{2}/12}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=5$ as follows:\n\n$$\n\\begin{aligned}y(0) & =6+C{e}^{-{0}^{2}/12} \\\\ 5 & =6+C \\\\ C & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=6-{e}^{-{x}^{2}/12}.\n$$"}] [{:db/id #edb/ref 17592186397314 :knowledge-point/_questions [{:knowledge-point/id #uuid "96494014-7289-548b-9749-2eb6336c9cef" :knowledge-point/title "Classifying Solutions of Inhomogeneous BVPs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e79a7021-331e-58f2-b8f6-85a889c84c54" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(1)" :db/id #edb/ref 17592186397316} {:answer/id #uuid "5cf42a17-28d9-5cef-872e-d088f9b14525" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186397317} {:answer/id #uuid "0b68a318-1bc5-51d1-9c23-3a3907eceead" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3}-1" :db/id #edb/ref 17592186397318} {:answer/id #uuid "299cc599-8438-5e31-a5d0-214b9d59050d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186397319} {:answer/id #uuid "198c8e7f-e98a-5eaf-a800-18f9ff78792b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397320}] :answer-field/correct {:answer/id #uuid "299cc599-8438-5e31-a5d0-214b9d59050d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186397319} :answer-field/id #uuid "e3c520b4-13a5-571c-8e5c-ab4db2ff4923" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397315} {:answer-field/choices [{:answer/id #uuid "b599fd4e-bc9d-5170-a7bb-6d77f919c9df" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397322} {:answer/id #uuid "386da076-43fa-52ac-a62c-687b10effaa2" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397323} {:answer/id #uuid "4d473d8d-facd-578f-bf7b-b27f7e42de91" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397324}] :answer-field/correct {:answer/id #uuid "b599fd4e-bc9d-5170-a7bb-6d77f919c9df" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397322} :answer-field/id #uuid "f9682d6c-ccfb-538a-ad04-e49378c99e16" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397321} {:answer-field/choices [{:answer/id #uuid "c2ba89f2-d45a-52ff-863e-45c304e0008e" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397326} {:answer/id #uuid "aa418ebb-9208-5e1f-9afb-0bfc91434063" :answer/type {:db/ident :answer.type/text} :answer/value "has at most one solution" :db/id #edb/ref 17592186397327} {:answer/id #uuid "1e77e3f6-6e5a-5fea-9d66-fcd13e99bf41" :answer/type {:db/ident :answer.type/text} :answer/value "has a unique solution" :db/id #edb/ref 17592186397328} {:answer/id #uuid "e9b6382a-3196-58ad-b56a-9f2fd256cf92" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions or no solution" :db/id #edb/ref 17592186397329}] :answer-field/correct {:answer/id #uuid "aa418ebb-9208-5e1f-9afb-0bfc91434063" :answer/type {:db/ident :answer.type/text} :answer/value "has at most one solution" :db/id #edb/ref 17592186397327} :answer-field/id #uuid "34be03c6-2aad-5ef1-bef0-db216fa83c72" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397325}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dfa31998-de06-5abd-90a7-06def4c1434e" :question/math-academy-id "q-339169" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}+y=x{e}^{3x},\\,{y}^{′}(0)={y}^{′}\\,(\\frac{\\pi }{2})=0,\\,0\\le x\\le \\frac{\\pi }{2}\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=[\\begin{aligned}{y}_{1}^{′}(0) & {y}_{2}^{′}(0) \\\\ {y}_{1}^{′}\\,(\\frac{\\pi }{2}) & {y}_{2}^{′}\\,(\\frac{\\pi }{2})\\end{aligned}].\n$$\n\nFill in the correct options in the reasoning below **without calculating the solution** to this BVP. \n\n$\\,$ The **absolute value** of $det(A)$ is {{field-1}}.\n\n$\\,$ Therefore, the corresponding homogeneous BVP {{field-2}}.\n\n$\\,$ Therefore, our inhomogeneous BVP {{field-3}}." :question/worked-solution "Suppose we have the second-order inhomogeneous boundary value problem (BVP)\n\n$$\n{y}^{″}(x)+P(x){y}^{′}+Q(x)y=f(x),\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere $P,Q,$ and $f$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nThe inhomogeneous BVP has at most one solution if and only if the associated homogeneous BVP has only the trivial solution $y≡0.$ Specifically:\n\n- If the homogeneous BVP has the unique solution $y≡0,$ then the inhomogeneous problem either has no solution or a unique solution.\n\n- If the homogeneous BVP has (infinitely many) nontrivial solutions, then the inhomogeneous problem either has infinitely many solutions or no solution.\n\nTo classify the solutions of the corresponding homogeneous BVP, we define the matrix $A$ as\n\n$$\nA=[\\begin{aligned}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{aligned}].\n$$\n\nThe homogeneous BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$ In other words, if the determinant equals zero, then the homogeneous BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Neumann boundary conditions. So, setting ${\\alpha }_{i}=0,{\\beta }_{i}=1,a=0,$ and $b=\\frac{\\pi }{2},$ the matrix $A$ reduces to\n\n$$\nA=[\\begin{aligned}{y}_{1}^{′}(0) & {y}_{2}^{′}(0) \\\\ {y}_{1}^{′}\\,(\\frac{\\pi }{2}) & {y}_{2}^{′}\\,(\\frac{\\pi }{2})\\end{aligned}].\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+1 & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm \\text{i}.$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡x,\\,{y}_{2}(x)=\\operatorname{sin}⁡x.\n$$\n\nDifferentiating, we have\n\n$$\n{y}_{1}^{′}(x)=-\\operatorname{sin}⁡x,\\,{y}_{2}^{′}(x)=\\operatorname{cos}⁡x.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-\\operatorname{sin}⁡(0) & \\operatorname{cos}⁡(0) \\\\ -sin\\,(\\frac{\\pi }{2}) & cos\\,(\\frac{\\pi }{2})\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nand we have\n\n$$\n\\begin{aligned}|det(A)| & =|0\\cdot 0-1\\cdot (-1)| \\\\  & =1.\\end{aligned}\n$$\n\nSince $det(A)\\ne 0,$ the corresponding homogeneous BVP $\\text{has the unique solution }y≡0.$\n\nTherefore, since the corresponding homogeneous BVP has the unique solution $y≡0,$ our inhomogeneous BVP $\\text{has at most one solution}.$"}] [{:db/id #edb/ref 17592186397330 :knowledge-point/_questions [{:knowledge-point/id #uuid "96494014-7289-548b-9749-2eb6336c9cef" :knowledge-point/title "Classifying Solutions of Inhomogeneous BVPs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a56e84-f444-514c-b047-407709ef1b5d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186397332} {:answer/id #uuid "7cc1070d-440b-55d7-89c6-dad455f0b8ec" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3}-1" :db/id #edb/ref 17592186397333} {:answer/id #uuid "cca250e3-057e-56c3-aa82-f205a90f5f76" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186397334} {:answer/id #uuid "160196c4-affe-5ba6-9053-25ce0b327293" :answer/type {:db/ident :answer.type/math} :answer/value "e-\\frac{1}{e}" :db/id #edb/ref 17592186397335} {:answer/id #uuid "0daa7d71-da3c-5c32-8b51-686cd74886cd" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397336}] :answer-field/correct {:answer/id #uuid "160196c4-affe-5ba6-9053-25ce0b327293" :answer/type {:db/ident :answer.type/math} :answer/value "e-\\frac{1}{e}" :db/id #edb/ref 17592186397335} :answer-field/id #uuid "87a4bdb6-3e46-5b30-beb9-78c8ccdca610" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397331} {:answer-field/choices [{:answer/id #uuid "8bda6fc1-48eb-5196-9d91-5862f18707e0" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397338} {:answer/id #uuid "71878905-3b4f-5678-aa10-771a1c34b5f5" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397339} {:answer/id #uuid "2c628e4f-1497-597b-b3da-f70cc3a170fd" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397340}] :answer-field/correct {:answer/id #uuid "8bda6fc1-48eb-5196-9d91-5862f18707e0" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397338} :answer-field/id #uuid "b5c70429-c9c1-5e9c-a93f-75d9d38f18f1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397337} {:answer-field/choices [{:answer/id #uuid "6637efb4-ea3e-50db-8daf-d770124713cf" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397342} {:answer/id #uuid "3f17e337-89d2-5e4c-9b71-670eca2cb748" :answer/type {:db/ident :answer.type/text} :answer/value "has at most one solution" :db/id #edb/ref 17592186397343} {:answer/id #uuid "f7b01b12-4d13-5495-bae2-fcf7ff5dcf54" :answer/type {:db/ident :answer.type/text} :answer/value "has a unique solution" :db/id #edb/ref 17592186397344} {:answer/id #uuid "33b326e7-0527-59c6-b429-eed05129d540" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions or no solution" :db/id #edb/ref 17592186397345}] :answer-field/correct {:answer/id #uuid "3f17e337-89d2-5e4c-9b71-670eca2cb748" :answer/type {:db/ident :answer.type/text} :answer/value "has at most one solution" :db/id #edb/ref 17592186397343} :answer-field/id #uuid "70c9fd63-30e4-560e-89a6-edd2f7d51959" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "302bac11-c0dd-5a24-97f7-11c22c2ff5b5" :question/math-academy-id "q-339173" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}-y={x}^{2}{e}^{x},\\,{y}^{′}(0)={y}^{′}(1)=0,\\,0\\le x\\le 1\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=[\\begin{aligned}{y}_{1}^{′}(0) & {y}_{2}^{′}(0) \\\\ {y}_{1}^{′}(1) & {y}_{2}^{′}(1)\\end{aligned}].\n$$\n\nFill in the correct options in the reasoning below **without calculating the solution** to this BVP. \n\n$\\,$ The **absolute value** of $det(A)$ is {{field-1}}.\n\n$\\,$ Therefore, the corresponding homogeneous BVP {{field-2}}.\n\n$\\,$ Therefore, our inhomogeneous BVP {{field-3}}." :question/worked-solution "Suppose we have the second-order inhomogeneous boundary value problem (BVP)\n\n$$\n{y}^{″}(x)+P(x){y}^{′}+Q(x)y=f(x),\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere $P,Q,$ and $f$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nThe inhomogeneous BVP has at most one solution if and only if the associated homogeneous BVP has only the trivial solution $y≡0.$ Specifically:\n\n- If the homogeneous BVP has the unique solution $y≡0,$ then the inhomogeneous problem either has no solution or a unique solution.\n\n- If the homogeneous BVP has (infinitely many) nontrivial solutions, then the inhomogeneous problem either has infinitely many solutions or no solution.\n\nTo classify the solutions of the corresponding homogeneous BVP, we define the matrix $A$ as\n\n$$\nA=[\\begin{aligned}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{aligned}].\n$$\n\nThe homogeneous BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$ In other words, if the determinant equals zero, then the homogeneous BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have Neumann boundary conditions. So, setting ${\\alpha }_{i}=0,{\\beta }_{i}=1,a=0,$ and $b=1,$ the matrix $A$ reduces to\n\n$$\nA=[\\begin{aligned}{y}_{1}^{′}(0) & {y}_{2}^{′}(0) \\\\ {y}_{1}^{′}(1) & {y}_{2}^{′}(1)\\end{aligned}].\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-1 & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 1.$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{x},\\,{y}_{2}(x)={e}^{-x}.\n$$\n\nDifferentiating, we have\n\n$$\n{y}_{1}^{′}(x)={e}^{x},\\,{y}_{2}^{′}(x)=-{e}^{-x}.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}{e}^{0} & -{e}^{0} \\\\ {e}^{1} & -{e}^{-1}\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ e & -{e}^{-1}\\end{aligned}]\\end{aligned}\n$$\n\nand we have\n\n$$\n\\begin{aligned}|det(A)| & =|1\\cdot (-{e}^{-1})-(-1)\\cdot e| \\\\  & =-{e}^{-1}+e \\\\  & =e-\\frac{1}{e}.\\end{aligned}\n$$\n\nSince $det(A)\\ne 0,$ the corresponding homogeneous BVP $\\text{has the unique solution }y≡0.$\n\nTherefore, since the corresponding homogeneous BVP has the unique solution $y≡0,$ our inhomogeneous BVP $\\text{has at most one solution}.$"}] [{:db/id #edb/ref 17592186397346 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d9576e0-3be5-5d05-8cc8-c3ecde496b46" :knowledge-point/title "Classifying Solutions of Homogeneous BVPs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5540be47-9b2a-568d-be51-652a02adfb88" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186397348} {:answer/id #uuid "d678551d-3097-5de2-b1cc-a3e1a6bcdb5e" :answer/type {:db/ident :answer.type/math} :answer/value "16{e}^{2}" :db/id #edb/ref 17592186397349} {:answer/id #uuid "9db1d09d-e694-5e62-ab53-9c17dbbeb79b" :answer/type {:db/ident :answer.type/math} :answer/value "4({e}^{2}-{e}^{-2})" :db/id #edb/ref 17592186397350} {:answer/id #uuid "accf96b7-4aa5-51ca-911b-0609fc4e4c1a" :answer/type {:db/ident :answer.type/math} :answer/value "-4({e}^{2}+{e}^{-2})" :db/id #edb/ref 17592186397351} {:answer/id #uuid "448f7af0-31e0-552a-b83c-766dbceb2915" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397352}] :answer-field/correct {:answer/id #uuid "448f7af0-31e0-552a-b83c-766dbceb2915" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186397352} :answer-field/id #uuid "07191edc-8ad7-5bb9-946e-ceccac633b37" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397347} {:answer-field/choices [{:answer/id #uuid "05c19e3e-7994-55a5-b3fd-d6b53f5e6b97" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)=\\operatorname{cos}⁡(2x)$ and ${y}_{2}(x)=\\operatorname{sin}⁡(2x)$" :db/id #edb/ref 17592186397354} {:answer/id #uuid "225ba7d1-c5d6-5cd7-9a9d-2fcb8a221e97" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{2x}$ and ${y}_{2}(x)={e}^{-2x}$" :db/id #edb/ref 17592186397355} {:answer/id #uuid "fcc877a8-9ed9-5862-8ad6-a3cde7bb3319" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{-2x}$ and ${y}_{2}(x)=x{e}^{-2x}$" :db/id #edb/ref 17592186397356} {:answer/id #uuid "16c47780-a095-51a6-87af-0eeac027f5f6" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{4x}$ and ${y}_{2}(x)={e}^{-x}$" :db/id #edb/ref 17592186397357}] :answer-field/correct {:answer/id #uuid "225ba7d1-c5d6-5cd7-9a9d-2fcb8a221e97" :answer/type {:db/ident :answer.type/text} :answer/value "${y}_{1}(x)={e}^{2x}$ and ${y}_{2}(x)={e}^{-2x}$" :db/id #edb/ref 17592186397355} :answer-field/id #uuid "31c9adde-b1e2-5899-93ea-5c224e70de0f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397353} {:answer-field/choices [{:answer/id #uuid "026c0ee9-634f-5e06-8e57-216dd4b78ca8" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186397359} {:answer/id #uuid "c5e299b9-8db8-5c7c-930c-76867c68e4aa" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)=0" :db/id #edb/ref 17592186397360}] :answer-field/correct {:answer/id #uuid "026c0ee9-634f-5e06-8e57-216dd4b78ca8" :answer/type {:db/ident :answer.type/math} :answer/value "det(A)\\ne 0" :db/id #edb/ref 17592186397359} :answer-field/id #uuid "4c72e2c4-74c9-59b4-8573-f0cc3090072c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397358} {:answer-field/choices [{:answer/id #uuid "7b62cf72-f57f-5f0d-9158-aef592b88ff9" :answer/type {:db/ident :answer.type/text} :answer/value "has the unique solution $y≡0$" :db/id #edb/ref 17592186397362} {:answer/id #uuid "3e1123ab-1573-54ff-beeb-fb38fc921c64" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397363} {:answer/id #uuid "cfc3748e-f6bb-54fa-bdd2-c9d309081222" :answer/type {:db/ident :answer.type/text} :answer/value "has no solution" :db/id #edb/ref 17592186397364}] :answer-field/correct {:answer/id #uuid "3e1123ab-1573-54ff-beeb-fb38fc921c64" :answer/type {:db/ident :answer.type/text} :answer/value "has infinitely many solutions" :db/id #edb/ref 17592186397363} :answer-field/id #uuid "e53b80d8-ad34-5531-b34b-01b41813b9b4" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397361}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "355bfeb1-d0b8-53cd-b763-3f92856140f7" :question/math-academy-id "q-339176" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}-4y=0,\\,2y(0)-{y}^{′}(0)=2y(1)-{y}^{′}(1)=0,\\,0\\le x\\le 1\n$$\n\nLet ${y}_{1}(x)$ and ${y}_{2}(x)$ be the fundamental solutions, and suppose we define the matrix $A$ as \n\n$$\nA=[\\begin{aligned}2{y}_{1}(0)-{y}_{1}^{′}(0) & 2{y}_{2}(0)-{y}_{2}^{′}(0) \\\\ 2{y}_{1}(1)-{y}_{1}^{′}(1) & 2{y}_{2}(1)-{y}_{2}^{′}(1)\\end{aligned}].\n$$\n\nFill in the correct options in the reasoning below.\n\n$\\,$ The boundary value problem has a unique solution if and only if {{field-1}}.\n\n$\\,$ The fundamental solutions to this BVP are {{field-2}}.\n\n$\\,$ For this BVP, we have $det(A)=$ {{field-3}}.\n\n$\\,$ Therefore, this BVP {{field-4}}." :question/worked-solution "Suppose we have the second-order homogeneous boundary value (BVP) problem\n\n$$\n{y}^{″}(x)+P(x){y}^{′}+Q(x)y=0,\\,a\\le x\\le b\n$$\n\nwith the Robin (mixed) boundary conditions\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)=0,\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)=0\n$$\n\nwhere $P$ and $Q$ are continuous on $[a,b],$ and ${\\alpha }_{i}$ and ${\\beta }_{i}$ are real constants such that $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ Furthermore, suppose the fundamental solutions to the equation are ${y}_{1}(x)$ and ${y}_{2}(x).$ \n\nNow, let's define the following matrix:\n\n$$\nA=[\\begin{aligned}\\,{\\alpha }_{1}{y}_{1}(a)+{\\beta }_{1}{y}_{1}^{′}(a) & {\\alpha }_{1}{y}_{2}(a)+{\\beta }_{1}{y}_{2}^{′}(a) \\\\ {\\alpha }_{2}{y}_{1}(b)+{\\beta }_{2}{y}_{1}^{′}(b) & {\\alpha }_{2}{y}_{2}(b)+{\\beta }_{2}{y}_{2}^{′}(b)\\end{aligned}]\n$$\n\nThen, the BVP has a unique, trivial solution $y≡0$ if and only if $det(A)\\ne 0.$\n\nIn other words, if the determinant equals zero, then the BVP has *infinitely many solutions*.\n\nNotice that, in our case, we have mixed (Robin) boundary conditions. So, setting ${\\alpha }_{i}=2,$ ${\\beta }_{i}=-1,$ $a=0,$ and $b=1,$ the matrix $A$ reduces to\n\n$$\nA=[\\begin{aligned}2{y}_{1}(0)-{y}_{1}^{′}(0) & 2{y}_{2}(0)-{y}_{2}^{′}(0) \\\\ 2{y}_{1}(1)-{y}_{1}^{′}(1) & 2{y}_{2}(1)-{y}_{2}^{′}(1)\\end{aligned}].\n$$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-4 & =0 \\\\ (m-2)(m+2) & =0.\\end{aligned}\n$$\n\nSo, we have $m=2$ and $m=-2,$ and so the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{2x}\\text{ and }{y}_{2}(x)={e}^{-2x}.\n$$\n\nDifferentiating, we have\n\n$$\n{y}_{1}^{′}(x)=2{e}^{2x},\\,{y}_{2}^{′}(x)=-2{e}^{-2x}.\n$$\n\nTherefore, the matrix $A$ is\n\n$$\nA=[\\begin{aligned}0 & 4 \\\\ 0 & 4{e}^{-2}\\end{aligned}],\n$$\n\nand we have\n\n$$\n\\begin{aligned}det(A) & =0(4{e}^{-2})-0(4) \\\\  & =0.\\end{aligned}\n$$\n\nSince $det(A)=0$ we conclude that this BVP $\\text{has infinitely many solutions }.$"}] [{:db/id #edb/ref 17592186397365 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640be27-8277-5a9c-bf14-83bcc7a38604" :knowledge-point/title "Constructing General Solutions of Inhomogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de93b087-2c87-54a2-8ce4-861cedbe5c5a" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186397367} {:answer/id #uuid "38b22569-4620-5db6-9463-291c3a777e54" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186397368}] :answer-field/correct {:answer/id #uuid "38b22569-4620-5db6-9463-291c3a777e54" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186397368} :answer-field/id #uuid "bcb669d8-5345-5c4e-b897-7495dd431c78" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397366} {:answer-field/choices [{:answer/id #uuid "52998750-f1d9-5a19-9002-6bfcf31c55e0" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{4}+B{x}^{2}" :db/id #edb/ref 17592186397370} {:answer/id #uuid "e45559f1-ba00-51cc-b081-a77f686eee2c" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{3}+B" :db/id #edb/ref 17592186397371} {:answer/id #uuid "5002b657-e4ab-5c5f-89fb-7b1998744e13" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{3}+Bx" :db/id #edb/ref 17592186397372} {:answer/id #uuid "9978a706-bbf5-5974-83fc-49c20b94ddc0" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{2}+Bx" :db/id #edb/ref 17592186397373}] :answer-field/correct {:answer/id #uuid "e45559f1-ba00-51cc-b081-a77f686eee2c" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{3}+B" :db/id #edb/ref 17592186397371} :answer-field/id #uuid "f4a1bd78-53d2-516c-8d40-e476d527e8c3" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397369} {:answer-field/choices [{:answer/id #uuid "31cf0eda-a4b6-57d7-b68f-8800d2cddce3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186397375} {:answer/id #uuid "001536f4-f360-5cf9-a291-5a9b1f3dfd29" :answer/type {:db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186397376}] :answer-field/correct {:answer/id #uuid "31cf0eda-a4b6-57d7-b68f-8800d2cddce3" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186397375} :answer-field/id #uuid "7dd92b7c-9494-5d4d-a0bf-2c6eb063c6ff" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397374} {:answer-field/choices [{:answer/id #uuid "195c6c70-aac6-5801-900c-371891911ecc" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186397378} {:answer/id #uuid "c81b4ebd-b840-598a-aa24-ae2dde79292a" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186397379}] :answer-field/correct {:answer/id #uuid "195c6c70-aac6-5801-900c-371891911ecc" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186397378} :answer-field/id #uuid "01df666f-a411-5cb8-a769-1be13f346ebd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397377} {:answer-field/choices [{:answer/id #uuid "cfacfd88-65dc-5834-aa27-53751d867ede" :answer/type {:db/ident :answer.type/math} :answer/value "C{x}^{2}" :db/id #edb/ref 17592186397381} {:answer/id #uuid "f70ffe80-4c54-5c5e-bd95-d1c6101ae78d" :answer/type {:db/ident :answer.type/math} :answer/value "Cx" :db/id #edb/ref 17592186397382} {:answer/id #uuid "f0077fa3-42e5-59ab-a09b-eca6c457084d" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186397383} {:answer/id #uuid "9eeef3cd-9631-5a88-85c7-a19c1d56b153" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}" :db/id #edb/ref 17592186397384}] :answer-field/correct {:answer/id #uuid "f0077fa3-42e5-59ab-a09b-eca6c457084d" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186397383} :answer-field/id #uuid "2e06630b-2bf3-51a2-895d-741decfb22bb" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397380}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af1eb49f-2047-54c5-af74-dcf0eb0576e3" :question/math-academy-id "q-339910" :question/problem "$$\n{x}^{2}{y}^{″}-2x{y}^{′}=-2x\n$$\n\nConsider the differential equation above, for which the corresponding complementary solution is ${y}_{c}(x)=A{x}^{3}+B,$ where $A$ and $B$ are arbitrary constants. Select the correct options below.$\\,$\nThe function ${y}_{p}(x)=x$ \n{{field-1}} \na particular solution of the differential equation.\n\n$\\,$\nThe function ${y}_{p}(x)={x}^{2}$ \n{{field-2}} \na particular solution of the differential equation.\n\n$\\,$\nThe general solution of the differential equation is given by\n\n$\\,\\,$\n$y(x)=$ \n{{field-3}}\n$+$\n{{field-4}},\n\n$\\,$\nwhere \n{{field-5}} are arbitrary constants." :question/worked-solution "For an inhomogeneous differential equation, the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nwhere\n\n- ${y}_{c}(x)$ is the complementary solution (the general solution of the corresponding homogeneous equation), and\n\n- ${y}_{p}(x)$ is a particular solution of the original inhomogeneous equation.\n\nWith this in mind, let's check which of the two given functions is a particular solution of our inhomogeneous equation:\n\n- For ${y}_{p}(x)=x,$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =(x)^{′}=1, \\\\ {y}^{″}(x) & =(1)^{′}=0.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n{x}^{2}(0)-2x(1)=-2x.\\,\\,✓\n$$\n\nSo, ${y}_{p}(x)=x$ $\\text{is}$ a particular solution of the differential equation.\n\n- For ${y}_{p}(x)={x}^{2},$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =({x}^{2})^{′}=2x, \\\\ {y}^{″}(x) & =(2x)^{′}=2.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n{x}^{2}(2)-2x(2x)=-2x.\\,\\,\\times \n$$\n\nSo, ${y}_{p}(x)={x}^{2}$ $\\text{isn't}$ a particular solution of the differential equation.\n\nWe are told that the complementary solution of our equation is ${y}_{c}(x)=A{x}^{3}+B.$ Therefore, the general solution is\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{x}^{3}+B+x\\end{aligned}\n$$\n\nwhere $A\\text{ and }B$ are arbitrary constants."}] [{:db/id #edb/ref 17592186397385 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640be27-8277-5a9c-bf14-83bcc7a38604" :knowledge-point/title "Constructing General Solutions of Inhomogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f61fa9d-029d-5d0b-836f-7fd9c52c55bf" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186397387} {:answer/id #uuid "89a0b1c8-9210-56e2-99b9-b8e5988b2240" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186397388}] :answer-field/correct {:answer/id #uuid "89a0b1c8-9210-56e2-99b9-b8e5988b2240" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186397388} :answer-field/id #uuid "609fd564-70da-56dd-9299-95878b1b6445" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397386} {:answer-field/choices [{:answer/id #uuid "81058251-1165-5c9f-ab12-5cfd387d4523" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{4}+B{x}^{2}" :db/id #edb/ref 17592186397390} {:answer/id #uuid "a47b03cd-dfc7-52e9-8092-bfa976cb5cfe" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{3}+Bx" :db/id #edb/ref 17592186397391} {:answer/id #uuid "5e8be5da-3d82-55a6-a528-4cbcd7fd1d12" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{5}+B{x}^{3}" :db/id #edb/ref 17592186397392} {:answer/id #uuid "5f1768c0-d2ed-570a-84f8-b83dd61715fd" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{5}+B{x}^{2}" :db/id #edb/ref 17592186397393}] :answer-field/correct {:answer/id #uuid "5f1768c0-d2ed-570a-84f8-b83dd61715fd" :answer/type {:db/ident :answer.type/math} :answer/value "A{x}^{5}+B{x}^{2}" :db/id #edb/ref 17592186397393} :answer-field/id #uuid "4e38af75-4659-57c3-acc3-d958cb168075" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397389} {:answer-field/choices [{:answer/id #uuid "ff04874c-b806-5c51-8ff8-c7783a6dee7f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186397395} {:answer/id #uuid "3d3314f6-149b-5289-97b2-4076da38e6a2" :answer/type {:db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186397396}] :answer-field/correct {:answer/id #uuid "ff04874c-b806-5c51-8ff8-c7783a6dee7f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$" :db/id #edb/ref 17592186397395} :answer-field/id #uuid "93034832-63fb-5330-ae88-5be7fabc5ce3" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397394} {:answer-field/choices [{:answer/id #uuid "e591a31f-a1bb-5d07-9267-8c626c839c91" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186397398} {:answer/id #uuid "478f5c4d-a4a2-5d7e-9928-ff87d28d0d95" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186397399}] :answer-field/correct {:answer/id #uuid "e591a31f-a1bb-5d07-9267-8c626c839c91" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186397398} :answer-field/id #uuid "cc5e5305-f978-5920-9dc9-d9d702e1ab1a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397397} {:answer-field/choices [{:answer/id #uuid "f417bc71-5d41-5c9e-beba-54bc27b5b30c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}" :db/id #edb/ref 17592186397401} {:answer/id #uuid "26af1e26-5364-554f-8e28-c0d8d4ea85a9" :answer/type {:db/ident :answer.type/math} :answer/value "Cx" :db/id #edb/ref 17592186397402} {:answer/id #uuid "254b41b3-fead-5a42-8ab3-af055f04dd2a" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186397403} {:answer/id #uuid "8e9bf666-0e4e-52c1-995e-f94b6aabf304" :answer/type {:db/ident :answer.type/math} :answer/value "C{x}^{3}" :db/id #edb/ref 17592186397404}] :answer-field/correct {:answer/id #uuid "254b41b3-fead-5a42-8ab3-af055f04dd2a" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186397403} :answer-field/id #uuid "db42da3c-4ff8-55e8-8bd3-19b8e3c4c33c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397400}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f873b9e-7818-5ec8-8091-26b92885da7b" :question/math-academy-id "q-339913" :question/problem "$$\n{x}^{2}{y}^{″}-6x{y}^{′}+10y=4x\n$$\n\nConsider the differential equation above, for which the corresponding complementary solution is ${y}_{c}(x)=A{x}^{5}+B{x}^{2},$ where $A$ and $B$ are arbitrary constants. Select the correct options below.$\\,$\nThe function ${y}_{p}(x)=x$ \n{{field-1}} \na particular solution of the differential equation.\n\n$\\,$\nThe function ${y}_{p}(x)={x}^{3}$ \n{{field-2}} \na particular solution of the differential equation.\n\n$\\,$\nThe general solution of the differential equation is given by\n\n$\\,\\,$\n$y(x)=$ \n{{field-3}}\n$+$\n{{field-4}},\n\n$\\,$\nwhere \n{{field-5}} are arbitrary constants." :question/worked-solution "For an inhomogeneous differential equation, the general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nwhere\n\n- ${y}_{c}(x)$ is the complementary solution (the general solution of the corresponding homogeneous equation), and\n\n- ${y}_{p}(x)$ is a particular solution of the original inhomogeneous equation.\n\nWith this in mind, let's check which of the two given functions is a particular solution of our inhomogeneous equation:\n\n- For ${y}_{p}(x)=x,$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =(x)^{′}=1, \\\\ {y}^{″}(x) & =(1)^{′}=0.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n{x}^{2}(0)-6x(1)+10(x)=4x.\\,\\,✓\n$$\n\nSo, ${y}_{p}(x)=x$ $\\text{is}$ a particular solution of the differential equation.\n\n- For ${y}_{p}(x)={x}^{3},$ we have \n\n$$\n\\begin{aligned}{y}^{′}(x) & =({x}^{3})^{′}=3{x}^{2}, \\\\ {y}^{″}(x) & =(3{x}^{2})^{′}=6x.\\end{aligned}\n$$\n\nSubstituting this into the equation, we have\n\n$$\n{x}^{2}(6x)-6x(3{x}^{2})+10({x}^{3})=4x.\\,\\,\\times \n$$\n\nSo, ${y}_{p}(x)={x}^{3}$ $\\text{isn't}$ a particular solution of the differential equation.\n\nWe are told that the complementary solution of our equation is ${y}_{c}(x)=A{x}^{5}+B{x}^{2}.$ Therefore, the general solution is\n\n$$\n\\begin{aligned}y(x) & ={y}_{c}(x)+{y}_{p}(x) \\\\  & =A{x}^{5}+B{x}^{2}+x\\end{aligned}\n$$\n\nwhere $A\\text{ and }B$ are arbitrary constants."}] [{:db/id #edb/ref 17592186167288 :knowledge-point/_questions [{:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2236311d-1dcf-5814-8621-6ca58ac136e7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397406} {:answer/id #uuid "80766049-c81a-5e17-9add-d24c5e9a61f6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{sin}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397407} {:answer/id #uuid "9c2a205e-e06c-5302-98bb-33dd8ef28f57" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{sin}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397408} {:answer/id #uuid "74af64a7-831f-50b9-989b-da92fb9efa80" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397409} {:answer/id #uuid "47abc435-93f1-5e56-be4e-2906875645c2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397410} {:answer/id #uuid "84fdd6c1-2fa1-53ec-9f4e-f2c79cf04198" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{sin}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397411}] :answer-field/correct {:answer/id #uuid "2236311d-1dcf-5814-8621-6ca58ac136e7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186397406} :answer-field/id #uuid "41c0a54b-4090-5079-ad72-a367200f1bb8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397405} {:answer-field/choices [{:answer/id #uuid "576de101-4a4e-5d10-93f1-4794297dd084" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186397413} {:answer/id #uuid "8be2ea60-7536-54c6-8c40-2b3ca7f53e09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186397414} {:answer/id #uuid "ebd3c9f2-b034-51ed-b959-1917ee861c61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186397415} {:answer/id #uuid "a0938cb1-fa06-51a3-9682-a27947461754" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186397416} {:answer/id #uuid "16682102-e4e9-5e8e-b234-f5f85ae7a7c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{5}" :db/id #edb/ref 17592186397417}] :answer-field/correct {:answer/id #uuid "ebd3c9f2-b034-51ed-b959-1917ee861c61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186397415} :answer-field/id #uuid "acd80bdd-4dbe-5452-b9e2-03bec982eb3d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397412} {:answer-field/choices [{:answer/id #uuid "d6896852-8238-5500-8785-a40ba1143f26" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{sin}⁡(5x),\\operatorname{sin}⁡(5x)⟩}{⟨f(x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397419} {:answer/id #uuid "7f0541cc-7371-58fe-8dca-eb545f614b78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(5x)⟩}{⟨\\operatorname{sin}⁡(5x),\\operatorname{sin}⁡(5x)⟩}" :db/id #edb/ref 17592186397420} {:answer/id #uuid "610883b1-a3e9-5606-b9ae-cf0dd1218917" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩}{⟨f(x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397421} {:answer/id #uuid "2c3717c9-e1f6-51ef-9d7f-0c5c74af7ae5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{sin}⁡(5x),\\operatorname{sin}⁡(5x)⟩}" :db/id #edb/ref 17592186397422} {:answer/id #uuid "23137492-fa85-5ebf-bdf6-f3faffc43cb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397423}] :answer-field/correct {:answer/id #uuid "23137492-fa85-5ebf-bdf6-f3faffc43cb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩}" :db/id #edb/ref 17592186397423} :answer-field/id #uuid "d466e0c2-5e9a-5545-9677-019c4fb5c4a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186397418}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa20d8e3-c4d9-5112-bd9c-ec30f6aaa6fe" :question/math-academy-id "q-340418" :question/problem "Let $F(x)={x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{5}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{a}_{5} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(5x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(5x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(5x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(5x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{-\\pi }^{\\pi }{cos}^{2}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{20}(\\operatorname{sin}⁡(10\\pi )-(\\operatorname{sin}⁡(-10\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(5x)⟩ & ={a}_{5}⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩ \\\\ {a}_{5} & =\\frac{⟨f(x),\\operatorname{cos}⁡(5x)⟩}{⟨\\operatorname{cos}⁡(5x),\\operatorname{cos}⁡(5x)⟩} \\\\ {a}_{5} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186397424 :knowledge-point/_questions [{:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8748773f-b48a-58ec-b951-7e2f13629f66" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}+5x)\\operatorname{sin}⁡(6x)\\,\\text{d}x" :db/id #edb/ref 17592186397426} {:answer/id #uuid "0e3eeb27-01e0-5659-a89f-03c69d0adcb3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}+5x)\\operatorname{cos}⁡(6x)\\,\\text{d}x" :db/id #edb/ref 17592186397427} {:answer/id #uuid "c5615bd6-2ce4-5da1-a40b-3086abdcadd8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}+5x)\\operatorname{cos}⁡(6x)\\,\\text{d}x" :db/id #edb/ref 17592186397428} {:answer/id #uuid "07510649-4bdf-56eb-8d9c-ed267705e564" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}+5x)\\operatorname{sin}⁡(6x)\\,\\text{d}x" :db/id #edb/ref 17592186397429} {:answer/id #uuid "03be0b57-cf22-512e-a317-32a2b0abe9aa" :answer/type {:db/ident :answer.type/math} :answer/va