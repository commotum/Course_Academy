 {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/5b59075ed7ac6aa9dfffb13153b307cfacca4bd8854d0f374520f9e6db8d4f87" :answer/id #uuid "93ab4050-ad19-5d1c-8155-556dd79d719e" :answer/type :answer.type/text :answer/value "$1\\cdot f\\ne f$ for some $f\\in S$" :db/ensure [:answer/validate]}
