c1/79743ba2cf4897f08c2f687f8ca9198b4663730a575f74649413a8c994320d18" "q-335460/ma-source-field/109ace1db91725f42902b45fe82fe5a23e60b9fa2a7bee3adb6df27f7ebae4c1/b75bc05c3a8aae4f5f3c2899162126840a25b8f7eda57f1ef199e4a16f56fba4"] :answer-field/correct "q-335460/ma-source-field/109ace1db91725f42902b45fe82fe5a23e60b9fa2a7bee3adb6df27f7ebae4c1/79743ba2cf4897f08c2f687f8ca9198b4663730a575f74649413a8c994320d18" :db/ensure [:answer-field/validate]} {:db/id "q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0/d3d064377015e2100502a8ca521489d27d4a570be9709cc9238160c7c0343862" :answer/id #uuid "0c02ae13-acc9-5b84-b898-d987d50404ef" :answer/type :answer.type/text :answer/value "eventually move away from" :db/ensure [:answer/validate]} {:db/id "q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0/8be2d115fa7b976b4c32465b7251c47b1a3e5672c0a4d8557f26e06f92eb40f8" :answer/id #uuid "57360b16-4b38-50df-85d1-531bb626e68a" :answer/type :answer.type/text :answer/value "remain close to" :db/ensure [:answer/validate]} {:db/id "q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0" :answer-field/id #uuid "58ab2b4c-0421-57e3-9439-37e1ee616b4e" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/choices ["q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0/d3d064377015e2100502a8ca521489d27d4a570be9709cc9238160c7c0343862" "q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0/8be2d115fa7b976b4c32465b7251c47b1a3e5672c0a4d8557f26e06f92eb40f8"] :answer-field/correct "q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0/d3d064377015e2100502a8ca521489d27d4a570be9709cc9238160c7c0343862" :db/ensure [:answer-field/validate]} {:db/id "q-335460" :question/id #uuid "d4f31534-294a-5c66-bb7a-bbd9c8ed5e89" :question/math-academy-id "q-335460" :question/problem "Select the correct options in the statement below that describe an **unstable** equilibrium point.{{field-1}} solutions that start\n{{field-2}}\nthe equilibrium\n{{field-3}}\nthe equilibrium." :question/worked-solution "Let's recall the definitions of stability:\n\n- An equilibrium point ${x}^{∗}$ is called *stable* if for any neighborhood $O$ of ${x}^{∗},$ there exists a neighborhood ${O}_{1}⊆O$ such that every orbit that begins inside ${O}_{1}$ at some point in time $t={t}_{0}$ remains inside $O$ for all $t>{t}_{0}.$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.\n\n- An equilibrium point ${x}^{∗}$ is called *asymptotically stable* if it is stable and there exists a neighborhood $O$ of ${x}^{∗}$ such that every orbit that begins inside $O$ approaches ${x}^{∗}$ as $t\\to \\infty .$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$\n\n- An equilibrium point ${x}^{∗}$ is called *unstable* if it is not stable.\n\nIn plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.\n\nTherefore, the correct answer is the following:\n\n$\\text{Some}$ solutions that start $\\text{arbitrarily close to}$ the equilibrium $\\text{eventually move away from}$ the equilibrium." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-335460/ma-source-field/44df59e4b9ee60c06dc2e1c10402131b446a935d930b385722eb315bc9eaa22b" "q-335460/ma-source-field/109ace1db91725f42902b45fe82fe5a23e60b9fa2a7bee3adb6df27f7ebae4c1" "q-335460/ma-source-field/ffe1cc674d2a127ef7a878ab5c7500a05020c9c5e01ccb739a50783e576fd8c0"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4025650-a2f6-597c-9bba-8008d90aee67"] :knowledge-point/questions ["q-335460"] :db/ensure [:knowledge-point/vali