5f4d012f18ce462b781b455e47316d7d62e5bc1c56f480dd63a33c059b" :answer-field/id #uuid "f8930119-dde1-5c7f-9dc6-b7a8c29faee5" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338004/ma-source-field/bc70985f4d012f18ce462b781b455e47316d7d62e5bc1c56f480dd63a33c059b/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338004/ma-source-field/bc70985f4d012f18ce462b781b455e47316d7d62e5bc1c56f480dd63a33c059b/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :answer-field/correct "q-338004/ma-source-field/bc70985f4d012f18ce462b781b455e47316d7d62e5bc1c56f480dd63a33c059b/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :db/ensure [:answer-field/validate]} {:db/id "q-338004" :question/id #uuid "8da06f22-6a38-578e-b590-3e2d4a9025f6" :question/math-academy-id "q-338004" :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.$\\,$ The equation $\\,\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0$ is {{field-1}}. \n\n$\\,$ The equation $\\,{y}^{″}+3{y}^{′}=x$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}-xy+4x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+3{y}^{′}=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}-xy+4x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-xy=-4x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-4x,$ which is different from zero." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338004/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515" "q-338004/ma-source-field/7ca3f1ddbd8fb00a68fc8ac9a45e54063dfb35ed05148c8d14aafeda65125756" "q-338004/ma-source-field/bc70985f4d012f18ce462b781b455e47316d7d62e5bc1c56f480dd63a33c059b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90930e15-0827-5e0b-82cf-98263fc756d6"] :knowledge-point/questions ["q-338004"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338082/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "8224d08c-b6d5-59c1-a3e9-c4005d2ce278" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338082/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "51641394-cf83-58e5-aa34-474bd8353286" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338082/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d" :answer-field/id #uuid "84f1c5b4-e827-513e-b3a4-9b5e916f4d90" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338082/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338082/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :answer-field/correct "q-338082/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :db/ensure [:answer-field/validate]} {:db/id "q-33808