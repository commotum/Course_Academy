5b5" "q-341448/ma-source-field/81512949606164691d893d745fd7a8a974b05f098d82b489afac43b1382e4de1/9aa9dfbc88f5063553a847c368b29cb8dda581610b843fa8c8f6be915eb97944" "q-341448/ma-source-field/81512949606164691d893d745fd7a8a974b05f098d82b489afac43b1382e4de1/6a46260098fce3dc291803fdba96a1a712933fdeee4d8c5b5bb67cc07cfd19c0"] :answer-field/correct "q-341448/ma-source-field/81512949606164691d893d745fd7a8a974b05f098d82b489afac43b1382e4de1/ccd37af225235e99e0c0beacf5c114a7061b025eb104267b602d298657c10927" :db/ensure [:answer-field/validate]} {:db/id "q-341448" :question/id #uuid "d8e97793-b7f7-5bb2-8257-c5344e5ddb06" :question/math-academy-id "q-341448" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}2,\\, & t\\le 3 \\\\ {e}^{t}\\, & t>3.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}2,\\, & t\\le 3 \\\\ {e}^{t}\\, & t>3\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}2\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{t}\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}2\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{t-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}2{e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{(1-s)t}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 1.$\n\nFor $s>1,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{3}2{e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{(1-s)t}\\,\\text{d}t \\\\  & =-\\frac{2}{s}{[{e}^{-st}]}_{0}^{3}+{\\int }_{3}^{\\infty }{e}^{(1-s)t}\\,\\text{d}t \\\\  & =\\frac{2}{s}-\\frac{2{e}^{-3s}}{s}+{lim}_{a\\to \\infty }{\\int }_{3}^{a}{e}^{(1-s)t}\\,\\text{d}t \\\\  & =\\frac{2}{s}-\\frac{2{e}^{-3s}}{s}+{lim}_{a\\to \\infty }{(\\frac{{e}^{(1-s)t}}{1-s})|}_{3}^{a} \\\\  & =\\frac{2}{s}-\\frac{2{e}^{-3s}}{s}+\\frac{1}{1-s}\\cdot {lim}_{a\\to \\infty }({e}^{(1-s)a}-{e}^{3(1-s)}) \\\\  & =\\frac{2}{s}-\\frac{2{e}^{-3s}}{s}+\\frac{1}{1-s}\\cdot (0-{e}^{3(1-s)}) \\\\  & =\\frac{2}{s}-\\frac{2{e}^{-3s}}{s}+\\frac{{e}^{3(1-s)}}{s-1}\\end{aligned}\n$$\n\nvalid for $s>1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341448/ma-source-field/be2b567a955e9b13a1dd37ef10726ee88f68b964ce253e6ad5059251b0efc807" "q-341448/ma-source-field/81512949606164691d893d745fd7a8a974b05f098d82b489afac43b1382e4de1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "424fc261-d1ca-5bf0-b085-7af1de6cc7cc"] :knowledge-point/questions ["q-341448"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124867 :question/answer-fields 17592186121774] {:db/id "q-342410/ma-source-field/ee9f3e831f316913a27fa1ebbb6ddc91caad511c547d99cbd401999a8fcc2965/dc7020e31a266715738fd921e33efbfc7b16ec3ae5c4b09a04e838c06763119c" :answer/id #uuid "ec690560-1681-5c8e-9a5e-d9729f1a5cb8" :answer/type :answer.type/text :answer/value "a regular singular" :db/ensure [:answer/validate]} {:db/id "q-342410/ma-source-field/ee9f3e831f316913a27fa1ebbb6ddc91caad511c547d99cbd401999a8fcc2965/1cdd626053dfdf43848942eac6640bb67468ab45f1203ea562ecf7407161f894" :answer/id #uuid "ae1974be-cae5-5a5c-b85c-da80cb6ca3f0" :answer/type :answer.type/text :answer/value "an irregular singular" :db/ensure [:answer/validate]} {:db/id "q-342410/ma-source-field/ee9f3e831f316913a27fa1ebbb6ddc91caad511c547d99cbd401999a8fcc2965/711846b5f17da1e0f7b9c58c5ea67feac2751dddb68fa44a9c7038d9f8182937" :answer/id #uuid "a8e73a36-ba65-5180-ab1b-3d21c5dd5547" :answer/type :answer.type/text :answer/value "an ordinary" :db/ensure [:answer/validate]} {:db/id "q-342410/ma-source-field/ee9f3e831