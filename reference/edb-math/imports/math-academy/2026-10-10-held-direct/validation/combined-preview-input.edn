fc39d"] :answer-field/correct "q-342657/ma-source-field/d78f65d17817d7a3f146090e1561941ca6bfb80551ac038d5bc3c1c5126de285/ef8a69cb660449e64835b31d26955ef0433e1eb49332071bb2f143d8ceea2652" :db/ensure [:answer-field/validate]} {:db/id "q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0/ef8a69cb660449e64835b31d26955ef0433e1eb49332071bb2f143d8ceea2652" :answer/id #uuid "4b07bc9b-8163-5605-b7bf-f62facb32b99" :answer/type :answer.type/text :answer/value "False" :db/ensure [:answer/validate]} {:db/id "q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0/b078929a2c7936cc58936f9a3dc3ad9d34bf096fcbea293ffdde0acd0defc39d" :answer/id #uuid "3a784da2-d4e4-5d4b-b900-c6ed1e90fed0" :answer/type :answer.type/text :answer/value "True" :db/ensure [:answer/validate]} {:db/id "q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0" :answer-field/id #uuid "9b046f21-736c-5f03-a92f-dec58bf868ea" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/choices ["q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0/ef8a69cb660449e64835b31d26955ef0433e1eb49332071bb2f143d8ceea2652" "q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0/b078929a2c7936cc58936f9a3dc3ad9d34bf096fcbea293ffdde0acd0defc39d"] :answer-field/correct "q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0/ef8a69cb660449e64835b31d26955ef0433e1eb49332071bb2f143d8ceea2652" :db/ensure [:answer-field/validate]} {:db/id "q-342657" :question/id #uuid "24b6f004-4c8b-5565-a4ef-1d172930ca34" :question/math-academy-id "q-342657" :question/problem "$$\nF(x)={\\begin{aligned}x+2, & x\\in [-2,0] \\\\ \\frac{1}{x}, & x\\in (0,2)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-2,2).$ Let $f(x)$ be the $4$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-2,2)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-2,2)$ | {{field-2}} |\n| III. | ${lim}_{x\\to -{2}^{+}}F(x)={lim}_{x\\to {2}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{false}.$ The function $F(x)$ is not continuous on $x\\in (-2,2)$ because $\\frac{1}{x}\\to \\infty $ as $x\\to {0}^{+}.$ Its graph is shown below.\n\n![](images/8e/8e5eec10427a7061a05c0bd1228ce1146234bf2b09d75bb86ba83b28fbe178d9.png)\n\n- Statement II is $\\text{false}.$ The function $F(x)$ is not piecewise smooth on $x\\in (-2,2)$ because ${F}^{′}(x)=-\\frac{1}{{x}^{2}}\\to -\\infty $ as $x\\to {0}^{+}.$\n\n- Statement III is $\\text{false}.$ Indeed, we have\n\n$$\n{lim}_{x\\to -{2}^{+}}F(x)={lim}_{x\\to -{2}^{+}}(x+2)=-2+2=0\n$$\n\nand \n\n$$\n{lim}_{x\\to {2}^{-}}F(x)={lim}_{x\\to {2}^{-}}\\frac{1}{x}=\\frac{1}{2}.\n$$\n\nSo, ${lim}_{x\\to -{2}^{+}}F(x)\\ne {lim}_{x\\to {2}^{-}}F(x).$\n\n- Statement IV is $\\text{false}$ since statements I and II are false.\n\n**Note:** The $4$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/4a/4afcdf86f777b9c7afc8af31b36cde4b80cfe394fd908db1ccd47ef48dff1617.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342657/ma-source-field/aa89e7b57cea898c9062bc97e334ef1e5a36374ea9c4b9ed6ddcb151321454e8" "q-342657/ma-source-field/1c4aece8c025270284bbca1e36127a7c97c6565f82de04686d8b494520c27e29" "q-342657/ma-source-field/d78f65d17817d7a3f146090e1561941ca6bfb80551ac038d5bc3c1c5126de285" "q-342657/ma-source-field/e3fe0ffb7a9d7c252e773c263f2920c0f0ac746231ca7aa5e8d3f11522e7a2b0"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ae32a2a-438f-547c-8510-7e9f760c3cb6"] :knowledge-point/questions ["q-342657"] :db/ensure [:knowledge-point/validate]} 