f81a8f2a14ef6e95f7680c27ecbcc78b931/59afba529b533d43da0939a1f2e3244430951f512675b31bbaaa22a58d5faf55" :db/ensure [:answer-field/validate]} {:db/id "q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea/0a4fb32c5ead7a42793f1609f7129a2d005c40f06f2ac02448bf0930df5b4d72" :answer/id #uuid "92b8f43d-f4d5-509d-8b12-68825b47ce0d" :answer/type :answer.type/text :answer/value "overestimate" :db/ensure [:answer/validate]} {:db/id "q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea/b75f0df421c1d3c2be4949f3e1d65d645758732d10c6da03e9fdeb34a06af273" :answer/id #uuid "ef65b10b-e65d-5550-b964-4477632fe18b" :answer/type :answer.type/text :answer/value "underestimate" :db/ensure [:answer/validate]} {:db/id "q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea" :answer-field/id #uuid "52b792d3-0847-501a-907c-2ebe956b9ca4" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/choices ["q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea/0a4fb32c5ead7a42793f1609f7129a2d005c40f06f2ac02448bf0930df5b4d72" "q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea/b75f0df421c1d3c2be4949f3e1d65d645758732d10c6da03e9fdeb34a06af273"] :answer-field/correct "q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea/0a4fb32c5ead7a42793f1609f7129a2d005c40f06f2ac02448bf0930df5b4d72" :db/ensure [:answer-field/validate]} {:db/id "q-346720" :question/id #uuid "fb9ed8ae-2017-567d-8d5e-a0f446be0601" :question/math-academy-id "q-346720" :question/problem "The graph of the function $y=f(x)$ passes through $(0,2)$ and is concave down on the interval $(-2,2).$ If ${f}^{′}(0)=0.5,$ estimate the value of $f(0.4)$ using the tangent line approximation of $f(x)$ at $x=0$ and determine whether the approximation is an underestimate or overestimate.$\\,f(0.4)≈$ {{field-1}} and the approximation is an {{field-2}}." :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=0$ is \n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(0)+{f}^{′}(0)(x-0).\\end{aligned}\n$$\n\nThe graph of the function passes through the point $(0,2),$ so we have $f(0)=2.$ Also, we're told that ${f}^{′}(0)=0.5.$ So, we obtain\n\n$$\n\\begin{aligned}L(x) & =2+0.5x.\\end{aligned}\n$$\n\nNow, we can approximate $f(0.4)$ by evaluating the tangent line approximation at $x=0.4.$ We get\n\n$$\n\\begin{aligned}f(0.4) & ≈L(0.4) \\\\  & =2+0.5(0.4) \\\\  & =2.2.\\end{aligned}\n$$\n\nFinally, since the function is concave down on the interval $(-2,2),$ the linear approximation $L(x)$ is above the graph near $x=0,$ and therefore we have an $\\text{overestimate}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346720/ma-source-field/4c052bfda5dbbc552def5ee2ac251f81a8f2a14ef6e95f7680c27ecbcc78b931" "q-346720/ma-source-field/e17075d6c90fc1fbbdf897a6e96c42a06d2e27210bd39e232a59573724f7f3ea"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f542453-9758-55e6-93c6-6bfd2139ec45"] :knowledge-point/questions ["q-346720"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352890/ma-source-field/86d108c811e4a796497e3da67cc667e0cf9cb541698874502309a85eff0c45c7/0f0bf3e5b4d49d098cc5baf660c6977edc9ec113af6f735d59f497de50943951" :answer/id #uuid "3c7b312d-000a-53d2-b64a-ae56b169c7e1" :answer/type :answer.type/math :answer/value "u(x){e}^{-2x}" :db/ensure [:answer/validate]} {:db/id "q-352890/ma-source-field/86d108c811e4a796497e3da67cc667e0cf9cb541698874502309a85eff0c45c7/90244fea567263d29a122e974f426c797e64ce018b292ff9ad249e079209d91d" :answer/id #uuid "d3eaaabd-442d-53ac-81ea-8a2a5fd0cca1" :answer/type :answer.type/math :answer/value "u(x){e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-352890/ma-source-field/86d108c811e4a796497e3da67cc667e0cf9cb541698874502309a85eff0c45c7/d2e81689053b2ebae446faee