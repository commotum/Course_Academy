5ee0150222d5d3e47" "q-78297/ma-source-field/49f0e2c8b85371ff7d8bc05cc344495f93a847174566653e44ab107faa419dc3/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" "q-78297/ma-source-field/49f0e2c8b85371ff7d8bc05cc344495f93a847174566653e44ab107faa419dc3/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a"] :answer-field/correct "q-78297/ma-source-field/49f0e2c8b85371ff7d8bc05cc344495f93a847174566653e44ab107faa419dc3/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" :db/ensure [:answer-field/validate]} {:db/id "q-78297" :question/id #uuid "1040f4bd-3d1a-5f7b-8b2b-4c581d4ad345" :question/math-academy-id "q-78297" :question/problem "Which of the following represents a reflection across the $x$-axis?" :question/worked-solution "The correct answer is $T=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ {j}^{′} & =T(j)=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](images/b9/b93bb91dae85a3e3b40a8d0ade3d4f420064aaa6926431fa7f664c977bb8fd59.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78297/ma-source-field/49f0e2c8b85371ff7d8bc05cc344495f93a847174566653e44ab107faa419dc3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-78297"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" :answer/id #uuid "ace98a54-10d8-5584-91a9-8dc23cfa3eb3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d" :answer/id #uuid "c2191dbe-147e-5390-a126-2d6a0061ee2a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" :answer/id #uuid "c22c0f50-7b0a-5358-91f1-6489ddb8ffdd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" :answer/id #uuid "272ad4ce-b146-5a57-8c5a-5d1e1b3e79ba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a" :answer/id #uuid "b7fe5771-8880-5a10-a850-ea4baad6b72e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a" :answer-field/id #uuid "47512c4c-4d28-5025-9b41-fddc19cb1574" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/65b9637c0afe12708a3772402a0c07eca95c1f147bf1ad07d091bc17f76dfd4d" "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/16d4141643bd2732b6c3d76b14744e546aa05b4bdaa0e7f60defb96106f3c9a9" "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/2389d22ac96573ae4abd1dab5d118d9b28b57ad1e9feea801c16b42019c2ef8a"] :answer-field/correct "q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a/870cc5df514b212a33382339d57a8f1736472f2a2dae5305ee0150222d5d3e47" :db/ensure [:answer-field/validate]} {:db/id "q-78302" :question/id #uuid "a51c70cd-319b-5de1-a71f-816af37c3370" :question/math-academy-id "q-78302" :question/problem "Which of the following represents a reflection in the line $y=-x?$" :question/worked-solution "The correct answer is $T=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}].$ Indeed, consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we can find the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nTherefore, we obtain the following image:\n\n![](images/4a/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78302/ma-source-field/36deeee1b3a459eaf2aaafc1e90069a4f4186a7ffa2826a2ab25e8fedbee127a"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-78302"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/5b59075ed7ac6aa9dfffb13153b307cfacca4bd8854d0f374520f9e6db8d4f87" :answer/id #uuid "93ab4050-ad19-5d1c-8155-556dd79d719e" :answer/type :answer.type/text :answer/value "$1\\cdot f\\ne f$ for some $f\\in S$" :db/ensure [:answer/validate]} {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/c708ad0e8231b3433d9a634fbae6fe3ba27d073670da06247746a109ace66528" :answer/id #uuid "9ba8a7fb-33bd-5b6d-a7ee-19ce6a4656ed" :answer/type :answer.type/text :answer/value "$S$ does not contain the zero function" :db/ensure [:answer/validate]} {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/0254c053a8fcf9e56483b2456fce38aaf17ebd8281a4ef72b0e22e947931a0b7" :answer/id #uuid "dced25c9-e7ab-5f35-8521-98dbb4380860" :answer/type :answer.type/text :answer/value "addition of polynomials is not associative" :db/ensure [:answer/validate]} {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/4323da32f4d0e343524480efb3fc2e33f66f54e3b33c2db4aac6648792846d8c" :answer/id #uuid "44e5f623-8068-52a9-b610-cc58b0a625bb" :answer/type :answer.type/text :answer/value "addition of polynomials is not commutative" :db/ensure [:answer/validate]} {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/5d3f1a556d9a2e94091143fad5710d86f21160731421b4fb0b96c6ee297dba08" :answer/id #uuid "4542450e-69bf-52e8-919b-58face6ea7bb" :answer/type :answer.type/text :answer/value "multiplication of functions in  $S$ by real scalars is not closed" :db/ensure [:answer/validate]} {:db/id "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203" :answer-field/id #uuid "689b4114-c1d3-5f0f-8182-74e6a0c999f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/5b59075ed7ac6aa9dfffb13153b307cfacca4bd8854d0f374520f9e6db8d4f87" "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/c708ad0e8231b3433d9a634fbae6fe3ba27d073670da06247746a109ace66528" "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/0254c053a8fcf9e56483b2456fce38aaf17ebd8281a4ef72b0e22e947931a0b7" "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/4323da32f4d0e343524480efb3fc2e33f66f54e3b33c2db4aac6648792846d8c" "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/5d3f1a556d9a2e94091143fad5710d86f21160731421b4fb0b96c6ee297dba08"] :answer-field/correct "q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203/5d3f1a556d9a2e94091143fad5710d86f21160731421b4fb0b96c6ee297dba08" :db/ensure [:answer-field/validate]} {:db/id "q-94798" :question/id #uuid "f0cbcdef-8d32-524c-bf12-b31a8feacf80" :question/math-academy-id "q-94798" :question/problem "Let $S$ be the set of all polynomials in the real  variable $x$ with coefficients in $Q.$ Complete the following sentence: \n\n*$S$ is **not** a vector space (with respect to polynomials addition and multiplication of a polynomial by a real number) because $\\text{_________}\\,.$*" :question/worked-solution "The correct answer is as follows:\n\n*$S$ is **not** a vector space (with respect to polynomials addition and multiplication of a polynomial by a real number) because **multiplication of functions in  $S$ by real scalars is not closed.** *\n\nIndeed, let's consider, for example, the polynomial  $f(x)=x.$ Then $f\\in S$, but $\\sqrt{2}f(x)=\\sqrt{2}\\,\\text{ }x\\notin S$ because $\\sqrt{2}\\notin Q.$\nOn the other hand: \n\n- Addition of polynomials is associative. $\\,✓$\n\n- Addition of polynomials is commutative. $\\,✓$\n\n- The zero function belongs to $S.$ $\\,✓$\n\n- $1\\cdot f=f$ for all $f\\in S.$ $\\,✓$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94798/ma-source-field/599390c242536d25a8888ac11d0fd7bb38dd7a416c4d81b1e64ef82e92edf203"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d9b62ae-7545-5d65-bcf7-74ab0e8662ec"] :knowledge-point/questions ["q-94798"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/6af3687036885c656f33bb039f5955d43d9ce18bcc9364f69deb05bac6cdd2c3" :answer/id #uuid "7b9b3be8-96e2-584f-b6b0-e44dcfa5b59f" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡(7t)+1" :db/ensure [:answer/validate]} {:db/id "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/c46c107ab52561b188c0c5b83a2ad7662b5428bc1386c771be29e858c48722ef" :answer/id #uuid "5e17787c-fdb3-5dc6-9f7d-ad11c18b5f0b" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡(7t)-1" :db/ensure [:answer/validate]} {:db/id "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/1520d475d8e743d03733ad83c320ba8cd758550512a3dd9459d034ca29edfca6" :answer/id #uuid "556a1d6d-0b97-5b9c-919a-ffcaef348e99" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(7t)+1" :db/ensure [:answer/validate]} {:db/id "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/6998421d12249787a49c0d11d34aba1fce4f706f411ee2431c58829f994d5d8a" :answer/id #uuid "47177d5f-d60d-5a76-a622-4448eaae8c59" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(7t)-1" :db/ensure [:answer/validate]} {:db/id "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8" :answer-field/id #uuid "0c3839e0-7572-5b48-a67f-8007a8d31b72" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices ["q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/6af3687036885c656f33bb039f5955d43d9ce18bcc9364f69deb05bac6cdd2c3" "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/c46c107ab52561b188c0c5b83a2ad7662b5428bc1386c771be29e858c48722ef" "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/1520d475d8e743d03733ad83c320ba8cd758550512a3dd9459d034ca29edfca6" "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/6998421d12249787a49c0d11d34aba1fce4f706f411ee2431c58829f994d5d8a"] :answer-field/correct "q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8/c46c107ab52561b188c0c5b83a2ad7662b5428bc1386c771be29e858c48722ef" :db/ensure [:answer-field/validate]} {:db/id "q-335183" :question/id #uuid "9ba8d18b-c5fe-5645-a494-a8fce82f879d" :question/math-academy-id "q-335183" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=7y(t) \\\\ {y}^{′}(t)=7x(t)+7,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(7t) & \\operatorname{sinh}⁡(7t) \\\\ \\operatorname{sinh}⁡(7t) & \\operatorname{cosh}⁡(7t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 7 \\\\ 7 & 0\\end{aligned}].$*\n\n| $[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | $\\operatorname{sinh}⁡(7t)$ |  |  |" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 7 \\\\ 7 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}0 \\\\ 7\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 7 \\\\ 7 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(7t) & \\operatorname{sinh}⁡(7t) \\\\ \\operatorname{sinh}⁡(7t) & \\operatorname{cosh}⁡(7t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(7t) & \\operatorname{sinh}⁡(7t) \\\\ \\operatorname{sinh}⁡(7t) & \\operatorname{cosh}⁡(7t)\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(7(t-s)) & \\operatorname{sinh}⁡(7(t-s)) \\\\ \\operatorname{sinh}⁡(7(t-s)) & \\operatorname{cosh}⁡(7(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(7(t-s)) & \\operatorname{sinh}⁡(7(t-s)) \\\\ \\operatorname{sinh}⁡(7(t-s)) & \\operatorname{cosh}⁡(7(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}7\\operatorname{sinh}⁡(7(t-s)) \\\\ 7\\operatorname{cosh}⁡(7(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}7\\operatorname{sinh}⁡(7(t-s)) \\\\ 7\\operatorname{cosh}⁡(7(t-s))\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{cosh}⁡(7(t-s)) \\\\ -\\operatorname{sinh}⁡(7(t-s))\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(7t)-1 \\\\ \\operatorname{sinh}⁡(7t)\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\operatorname{cosh}⁡(7t)-1 \\\\ \\operatorname{sinh}⁡(7t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(7t)-1 \\\\ \\operatorname{sinh}⁡(7t)\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-335183/ma-source-field/ceeccb31ffae185662aa7ed8d61b124fd72d99a8a455dc86c422209a95818ec8"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4eca32dd-1563-55c6-b594-08588efd601b"] :knowledge-point/questions ["q-335183"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335401/ma-source-field/d720a6d9c11d40f1cf6c446aeeef814d86489ee2b91858fa3b1609166bff655f/18a578c7b04a3b815ae5d4a457af4a650d712815d58e13e1ae858eb82215727e" :answer/id #uuid "30eef7f5-8b22-5be9-9b66-818bc874eb41" :answer/type :answer.type/text :answer/value "applying a change of variables" :db/ensure [:answer/validate]} {:db/id "q-335401/ma-source-field/d720a6d9c11d40f1cf6c446aeeef814d86489ee2b91858fa3b1609166bff655f/90f9b3aa8bf944a7feca6948bc9b4f8b714976f2a4f40ee10776f871c3970cd2" :answer/id #uuid "5548b470-04df-52fd-9078-8aee9471580b" :answer/type :answer.type/text :answer/value "differentiating and using the product rule" :db/ensure [:answer/validate]} {:db/id "q-335401/ma-source-field/d720a6d9c11d40f1cf6c446aeeef814d86489ee2b91858fa3b1609166bff655f/0d652a7f8f9c1a42526cff8daf2a3a3ea56f579cc8a9cef8a5cb8d5922125a76" :answer/id #uuid "2b5d015d-eaf2-5953-a208-