e18174200" "q-338697/ma-source-field/6a00b1f35c9d3da2f1dc200657e2a96acfee39f2b49fc5d9e4e505b8ccc62e8f/c8a139a7781cbf1484c5c65d833041ae69c859d2c77c229a5e0cb871eee8b46b" "q-338697/ma-source-field/6a00b1f35c9d3da2f1dc200657e2a96acfee39f2b49fc5d9e4e505b8ccc62e8f/b9248a6ddaa63032886818da7db1f1bcca7b4af333798c69a62e6a3c7eb9a71a"] :answer-field/correct "q-338697/ma-source-field/6a00b1f35c9d3da2f1dc200657e2a96acfee39f2b49fc5d9e4e505b8ccc62e8f/b9248a6ddaa63032886818da7db1f1bcca7b4af333798c69a62e6a3c7eb9a71a" :db/ensure [:answer-field/validate]} {:db/id "q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "967be8db-6c8c-5176-a37a-cfbb2d0acb70" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "3558fe78-12f6-5e58-8639-b31e8f48b34e" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861" :answer-field/id #uuid "d7c7990c-99a3-522c-9968-be9df4628906" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :answer-field/correct "q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :db/ensure [:answer-field/validate]} {:db/id "q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "53642858-4ce5-5373-905a-d8916de650d1" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "9a8f292a-ee48-5ba5-9da3-8c6c59413e48" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d" :answer-field/id #uuid "844987f3-1e3f-53c7-ae11-937954d8e862" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :answer-field/correct "q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :db/ensure [:answer-field/validate]} {:db/id "q-338697" :question/id #uuid "8670636a-35fe-5cb8-86c2-aff8f53ead1f" :question/math-academy-id "q-338697" :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)-{x}^{2}{y}^{′}(x)+y(x)=0,\\,1\\le x\\le 2\n$$\n\n$$\ny(1)+{y}^{′}(1)=0,\\,5y(2)+2{y}^{′}(2)=0\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)-{x}^{2}{y}^{′}(x)+y(x)=0.\n$$\n\nSince the right-hand side $f(x)≡0,$ the equation is $\\text{homogeneous}.$\n\n- The boundary conditions are\n\n$$\ny(1)+{y}^{′}(1)=0,\\,5y(2)+2{y}^{′}(2)=0.\n$$\n\nThese are $\\text{Robin}$ boundary conditions, and since the right-hand sides are zero for both, they are $\\text{homogeneous}.$\n\n- Since the governing equation is homogeneous, and the boundary conditions are homogeneous, the BVP is $\\text{homogeneous}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338697/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515" "q-338697/ma-source-field/6a00b1f35c9d3da2f1dc200657e2a96acfee39f2b49fc5d9e4e505b8ccc62e8f" "q-338697/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861" "q-338697/ma-source-field/8a98034c238088f34b49f335b12525dd9860fcb684153d39f6032ce1794fa89d"] :db/ensure [:que