/8fd6891732b67b5b34f3e3c7245f98e064d8e8d8f031f53d5f93e759c8aab5a9/b078929a2c7936cc58936f9a3dc3ad9d34bf096fcbea293ffdde0acd0defc39d" :db/ensure [:answer-field/validate]} [:db/retract 17592186222031 :question/answer-fields 17592186220827] {:db/id "q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435/ef8a69cb660449e64835b31d26955ef0433e1eb49332071bb2f143d8ceea2652" :answer/id #uuid "13360f60-446f-5ba5-8fe4-4db596852ca9" :answer/type :answer.type/text :answer/value "False" :db/ensure [:answer/validate]} {:db/id "q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435/b078929a2c7936cc58936f9a3dc3ad9d34bf096fcbea293ffdde0acd0defc39d" :answer/id #uuid "fff6d535-67cf-5d92-a24c-282ed886a3f3" :answer/type :answer.type/text :answer/value "True" :db/ensure [:answer/validate]} {:db/id "q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435" :answer-field/id #uuid "ecd037f3-14ce-5899-ac94-7cf1fd33f9d0" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/choices ["q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435/ef8a69cb660449e64835b31d26955ef0433e1eb49332071bb2f143d8ceea2652" "q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435/b078929a2c7936cc58936f9a3dc3ad9d34bf096fcbea293ffdde0acd0defc39d"] :answer-field/correct "q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435/b078929a2c7936cc58936f9a3dc3ad9d34bf096fcbea293ffdde0acd0defc39d" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "2cc2bb4c-12ce-5499-9381-7f752bdaab23"] :question/problem "$$\nF(x)={\\begin{aligned}{x}^{2}, & x\\in [0,3) \\\\ -3x, & x\\in [-3,0)\\end{aligned}\n$$\n\nThe above function $F(x)$ is defined on $x\\in [-3,3).$ Let $f(x)$ be the $6$-periodic extension of $F(x)$ to $x\\in R.$\nSelect the correct options below.\n\n| I. | $F(x)$ is continuous on $x\\in (-3,3)$ | {{field-1}} |\n| --- | --- | --- |\n| II. | $F(x)$ is piecewise smooth on $x\\in (-3,3)$ | {{field-2}} |\n| III. | ${lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to {3}^{-}}F(x)$ | {{field-3}} |\n| IV. | $f(x)$ is piecewise smooth and continuous on $R$ | {{field-4}} |" :question/worked-solution "Let's examine the given statements in turn.\n\n- Statement I is $\\text{true}.$ The function $F(x)$ is continuous on $x\\in (-3,3).$ Its graph is shown below.\n\n![](images/18/186106373f9848cfefefb23197e7508497ff3d570f326da2ca342d078682128d.png)\n\n- Statement II is $\\text{true}.$ The function $F(x)$ is piecewise smooth on $x\\in (-3,3).$ It consists of two smooth pieces.\n\n- Statement III is $\\text{true}.$ Indeed, we have\n\n$$\n{lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to -{3}^{+}}-3x=-3(-3)=9\n$$\n\nand \n\n$$\n{lim}_{x\\to {3}^{-}}F(x)={lim}_{x\\to {3}^{-}}{x}^{2}=(3)^{2}=9.\n$$\n\nSo, ${lim}_{x\\to -{3}^{+}}F(x)={lim}_{x\\to {3}^{-}}F(x).$\n\n- Statement IV is $\\text{true}$ since statements I, II, and III are all true.\n\n**Note:** The $6$-periodic extension of $F(x)$ to $x\\in R$ has the graph shown below.\n\n![](images/89/89c3a597ce1114fee9e775f291cf89e8ca04f61eb39cf2b4c896dd4be8022f09.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341129/ma-source-field/ac691fe3a052c91fc5497bf03df7e2fd1487aec1ca8380fe97adf29d62d60a9e" "q-341129/ma-source-field/898591f3025052635eaa1a18adc776334127fc66149af0fe4a2d52dd1c35a58b" "q-341129/ma-source-field/8fd6891732b67b5b34f3e3c7245f98e064d8e8d8f031f53d5f93e759c8aab5a9" "q-341129/ma-source-field/e243a4523a4c9814038fe5a08e80d34b04640937c57f89e3e6c8c257aabc2435"] :db/ensure [:question/validate]} {:db/id "q-341136/ma-source-field/ee42a6f5b6fed2dd4e1cc3d914adc3133517e317fe38d3640fd1f547baa79280/31078a67fa8b467a5c7964cdebab25d910456d5c0f93efea92649a842f31e76d" :answer/id #uuid "2bb3ed42-d158-5ad8-af7f-d31ff6b6b3c8" :answer/type :answer.type/math :answer/value "\\frac{4s}{{s}^{2}+16}" :db/ensure [