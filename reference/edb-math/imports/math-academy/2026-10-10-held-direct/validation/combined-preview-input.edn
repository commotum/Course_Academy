y}{\\text{d}x})}+\\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nUsing the substitution $t=\\frac{\\text{d}y}{\\text{d}x},$ the equation can be transformed to a first-order linear equation of the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t).\n$$\n\nFind the functions $P$ and $Q.$\n\n$\\,\\,P(t)=$\n{{field-1}}$,\\,Q(t)=$\n{{field-2}}" :question/worked-solution "A differential equation is a d'Alembert differential equation if it can be expressed in the form\n\n$$\ny=xf({y}^{′})+g({y}^{′}),\n$$\n\nwhere $f$ and $g$ are differentiable functions of ${y}^{′}.$ \n\nIn our case, we wish to transform the equation\n\n$$\ny=x\\cdot \\frac{1}{(\\frac{\\text{d}y}{\\text{d}x})}+\\frac{\\text{d}y}{\\text{d}x}\n$$\n\ninto a first-order linear equation for $x=x(t).$ We proceed in three steps:\n\n**Step 1**: Substitute, and differentiate with respect to $x.$\n\nWe have the substitution\n\n$$\nt=\\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nSubstituting this into the equation gives\n\n$$\ny=x\\cdot \\frac{1}{t}+t.\n$$\n\nDifferentiating both sides with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y) & =\\frac{\\text{d}}{\\text{d}x}(x\\cdot \\frac{1}{t}+t).\\end{aligned}\n$$\n\nApplying the sum and product rules and using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(x\\cdot \\frac{1}{t})+\\frac{\\text{d}}{\\text{d}x}(t) \\\\ t & =\\frac{1}{t}\\frac{\\text{d}}{\\text{d}x}(x)+x\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{t})+\\frac{\\text{d}}{\\text{d}x}(t) \\\\ t & =\\frac{1}{t}-\\frac{x}{{t}^{2}}\\frac{\\text{d}t}{\\text{d}x}+\\frac{\\text{d}t}{\\text{d}x}.\\end{aligned}\n$$\n\n**Step 2**: Isolate the derivative and take its reciprocal.\n\nWe isolate $\\frac{\\text{d}t}{\\text{d}x}$ as follows:\n\n$$\n\\begin{aligned}t-\\frac{1}{t} & =-\\frac{x}{{t}^{2}}\\frac{\\text{d}t}{\\text{d}x}+\\frac{\\text{d}t}{\\text{d}x} \\\\ \\frac{{t}^{2}-1}{t} & =(\\frac{{t}^{2}-x}{{t}^{2}})\\frac{\\text{d}t}{\\text{d}x} \\\\ \\frac{t({t}^{2}-1)}{{t}^{2}-x} & =\\frac{\\text{d}t}{\\text{d}x}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\frac{\\text{d}t}{\\text{d}x}=\\frac{t({t}^{2}-1)}{{t}^{2}-x}.\n$$\n\nTherefore, by taking the reciprocal of each side, we have\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{{t}^{2}-x}{t({t}^{2}-1)}.\n$$\n\n**Step 3**: Express the derivative as a first-order linear equation.\n\nFinally, we write this in the form\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}+P(t)x=Q(t)\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{{t}^{2}-x}{t({t}^{2}-1)} \\\\ t({t}^{2}-1)\\frac{\\text{d}x}{\\text{d}t} & ={t}^{2}-x \\\\ t({t}^{2}-1)\\frac{\\text{d}x}{\\text{d}t}+x & ={t}^{2} \\\\ \\frac{\\text{d}x}{\\text{d}t}+\\frac{x}{t({t}^{2}-1)} & =\\frac{{t}^{2}}{t({t}^{2}-1)} \\\\ \\frac{\\text{d}x}{\\text{d}t}+\\frac{x}{t({t}^{2}-1)} & =\\frac{t}{{t}^{2}-1}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(t)=\\frac{1}{t({t}^{2}-1)},\\,Q(t)=\\frac{t}{{t}^{2}-1}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-365387/ma-source-field/7dfb847bdf3bc7653de563dc3d0a54962862bf40af1b677ca91c15192c1ab47b" "q-365387/ma-source-field/3d32b6e62d00ded26f6d2db6d798de366d57e00d8970764ddee26d52eed51f2e"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "126ffd6c-f5a9-564f-935f-398a126d2cbd"] :knowledge-point/questions ["q-365387"] :db/ensure [:knowledge-point/validate]}]
