8f05c944769a323ecb5151cee4f85b10dc9445fe60cdbb000" :answer/id #uuid "3ce119a8-474d-516f-b714-f6645bb4943e" :answer/type :answer.type/text :answer/value "$Bx{e}^{\\frac{3}{2}x}$ and $Cx{e}^{-\\frac{3}{2}x}$" :db/ensure [:answer/validate]} {:db/id "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/2bba317cd311a6c4650992163cfe4c5274233afe30ad3cf6223a01396eb17f62" :answer/id #uuid "6333f256-57a4-524f-882c-85ce13ed4d52" :answer/type :answer.type/text :answer/value "$Bx{e}^{x}$ and $Cx{e}^{-x}$" :db/ensure [:answer/validate]} {:db/id "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681" :answer-field/id #uuid "6451528f-6193-5fce-847d-24fbb635dd58" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/8fb1ebb006cbd47b8ea6059bdb38bdf863045361dec046af90db7c0b2d1a6fcf" "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/7ad795a7b8b1c6cab33cde117dec6e92ce404f4d8683f8f5057b5cf614c5a6bc" "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/9228453c873ee5591c68423fe60867d7e1518a378cfc9a9746fb0351da86808f" "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/e8039abdcbde1548f05c944769a323ecb5151cee4f85b10dc9445fe60cdbb000" "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/2bba317cd311a6c4650992163cfe4c5274233afe30ad3cf6223a01396eb17f62"] :answer-field/correct "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681/7ad795a7b8b1c6cab33cde117dec6e92ce404f4d8683f8f5057b5cf614c5a6bc" :db/ensure [:answer-field/validate]} {:db/id "q-338837" :question/id #uuid "ba070694-f520-5989-9c36-fcafe8653bcc" :question/math-academy-id "q-338837" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}-14\\lambda {y}^{′}+49{\\lambda }^{2}y=0,\\,y(0)=0,\\,y(2)+{y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\in R.\n$$\n\nFind the eigenvalues and eigenfunctions of this problem. Assume that $B$ and $C$ are constants.$\\,$ The eigenvalues are $\\lambda =$ {{field-1}}.\n\n$\\,$ The eigenfunctions are $y=$ {{field-2}}." :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions $y(0)=0$ and $y(2)+{y}^{′}(2)=0$ yields the trivial solution $y≡0.$ Since the zero solution is not an eigenfunction, $\\lambda =0$ is not an eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda \\ne 0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}-14\\lambda m+49{\\lambda }^{2} & =0 \\\\ (m-7\\lambda )(m-7\\lambda ) & =0.\\end{aligned}\n$$\n\nSo, we have the double root $m=7\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)={e}^{7\\lambda x},\\,{y}_{2}(x)=x{e}^{7\\lambda x}\n$$\n\nand the general solution is\n\n$$\ny=A{e}^{7\\lambda x}+Bx{e}^{7\\lambda x}.\n$$\n\nApplying the boundary condition $y(0)=0$ yields\n\n$$\nA+B\\cdot 0=0\n$$\n\nwhich gives $A=0.$ So, we have\n\n$$\ny=Bx{e}^{7\\lambda x}.\n$$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}{y}^{′}=B{e}^{7\\lambda x}+7B\\lambda x{e}^{7\\lambda x}.\\end{aligned}\n$$\n\nApplying the boundary condition $y(2)+{y}^{′}(2)=0$ yields\n\n$$\n\\begin{aligned}2B{e}^{14\\lambda }+B{e}^{14\\lambda }+14B\\lambda {e}^{14\\lambda } & =0 \\\\ 3B{e}^{14\\lambda }+14B\\lambda {e}^{14\\lambda } & =0 \\\\ B{e}^{14\\lambda }+\\frac{14}{3}B\\lambda {e}^{14\\lambda } & =0 \\\\ B{e}^{14\\lambda }(1+\\frac{14}{3}\\lambda ) & =0.\\end{aligned}\n$$\n\nFor nontrivial solutions, we require $B\\ne 0.$ Thus, since ${e}^{14\\lambda }>0,$ we must have\n\n$$\n\\lambda =-\\frac{3}{14}.\n$$\n\nTherefore, the corresponding eigenfunction is\n\n$$\n\\begin{aligned}y(x) & =Bx{e}^{7\\lambda x} \\\\  & =Bx{e}^{-\\frac{3}{2}x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338837/ma-source-field/de645e66807f1a735b4fd6a33905cdcaebaab3830a712d09a02c5d478f00a965" "q-338837/ma-source-field/cde251be4b3d1c2a0b03bdd8dd60ab2e0cf42c8ace9a4bce5bbbfe11a024d681"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ba4d320f-517e-5dc6-9c6d-02d1c2488472"] :knowledge-point/questions ["q-338837"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338853/ma-source-field/c8a5d3168103913d239dc385298dcfce07dca1f64b5315d078cddbe8f4416813/ef0d9d6c0fb82916854d020568f97fb09f2cbdf50227cd355cac925271fc81d6" :answer/id #uuid "de1e54e4-c76b-5bbc-878c-a545826e8820" :answer/type :answer.type/math :answer/value "\\pm 2" :db/ensure [:answer/validate]} {:db/id "q-338853/ma-source-field/c8a5d3168103913d239dc385298dcfce07dca1f64b5315d078cddbe8f4416813/1c031025bcffa2d4ec623a5bad9f0e8f18d281fd1a55449902d3de01850db8cd" :answer/id #uuid "3bbb88d2-d106-5a48-a491-8a1865d27c49" :answer/type :answer.type/math :answer/value "\\pm \\frac{7}{18}" :db/ensure [:answer/validate]} {:db/id "q-338853/ma-source-field/c8a5d3168103913d239dc385298dcfce07dca1f64b5315d078cddbe8f4416813/bf7083ab0303a7c61903f56ddfc070744cca53d8bf4b28d9252c4e0dfd6c77ea" :answer/id #uuid "e1402155-85cf-54ae-8dae-41b284721aaa" :answer/type :answer.type/text :answer/value "$-\\frac{7}{18}$ only" :db/ensure [:answer/validate]} {:db/id "q-338853/ma-source-field/c8a5d3168103913d239dc385298dcfce07dca1f64b5315d078cddbe8f4416813/2f817eb15f994caf46175717f58bb0f51c9b451dbd74a973fe420ad3a98f96f2" :answer/id #uuid "67f9752d-2717-5fd3-89ed-ddffa71fb940" :answer/type :answer.type/text :answer/value "$1$ only" :db/ensure [:answer/validate]} {:db/id "q-338853/ma-source-field/c8a5d3168103913d239dc385298dcfc