113418ca9fc39a3f66bd026148/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "e3518d61-df59-5386-b3ca-172e84278fc0" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338516/ma-source-field/947acceff23d77d1e11fd7a62cf60c6e87947d113418ca9fc39a3f66bd026148" :answer-field/id #uuid "edc7f057-557e-5798-8bd0-23cc616cd262" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338516/ma-source-field/947acceff23d77d1e11fd7a62cf60c6e87947d113418ca9fc39a3f66bd026148/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338516/ma-source-field/947acceff23d77d1e11fd7a62cf60c6e87947d113418ca9fc39a3f66bd026148/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :answer-field/correct "q-338516/ma-source-field/947acceff23d77d1e11fd7a62cf60c6e87947d113418ca9fc39a3f66bd026148/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "b711ebb4-4d84-521d-8e27-4cb308558d9a"] :question/problem "Consider the following boundary value problem (BVP).\n\n$$\n{y}^{″}(x)+{x}^{2}{y}^{′}(x)+y(x)=2x,\\,0\\le x\\le \\pi \n$$\n\n$$\n2y(0)+{y}^{′}(0)=0,\\,y(\\pi )+2{y}^{′}(\\pi )=0\n$$\n\nComplete the missing information below:\n\n$\\,$ The governing differential equation is {{field-1}}.\n\n$\\,$ For this BVP, the {{field-2}} boundary conditions are {{field-3}}.\n\n$\\,$ The boundary value problem is {{field-4}}." :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nA set of Dirichlet, Neumann, or Robin boundary conditions is homogeneous if both right-hand sides are zero (i.e., ${\\gamma }_{1}={\\gamma }_{2}=0.)$ Otherwise, they are inhomogeneous.\n\nA boundary value problem is homogeneous if the differential equation is homogeneous $(f≡0)$ and the corresponding boundary conditions are homogeneous. Otherwise, the BVP is inhomogeneous.\n\nWith that in mind, let's consider each statement:\n\n- The governing differential equation is\n\n$$\n{y}^{″}(x)+{x}^{2}{y}^{′}(x)+y(x)=2x.\n$$\n\nSince the right-hand side $f(x)=2x≢0,$ the equation is $\\text{inhomogeneous}.$\n\n- The boundary conditions are\n\n$$\n2y(0)+{y}^{′}(0)=0,\\,y(\\pi )+2{y}^{′}(\\pi )=0.\n$$\n\nThese are $\\text{Robin}$ boundary conditions, and since the right-hand sides are zero for both, they are $\\text{homogeneous}.$\n\n- Since the governing equation is inhomogeneous, yet the boundary conditions are homogeneous, the BVP is $\\text{inhomogeneous}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338516/ma-source-field/b416211afb1db3691dc69bd37b794a6a12159a613c3c04f5654bced2573a228d" "q-338516/ma-source-field/6a00b1f35c9d3da2f1dc200657e2a96acfee39f2b49fc5d9e4e505b8ccc62e8f" "q-338516/ma-source-field/a216a5ca1bb4cd198485d7aef064e21f10e834a6d6f738ebe9755a5d281cc861" "q-338516/ma-source-field/947acceff23d77d1e11fd7a62cf60c6e87947d113418ca9fc39a3f66bd026148"] :db/ensure [:question/validate]} [:db/retract 17592186152582 :question/answer-fields 17592186149942] {:db/id "q-338646/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "fe776fd0-8801-585d-a7c4-73bb386abf6d" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338646/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "04b12e10-d19c-5892-a70b-db9c711fc435" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338646/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515" :answer-field/id #uuid "18073122-bf85-5077-973b-f8f6df4708b0" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices ["q-338646/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338646/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :answer-field/correct "q-338646/ma-source-field/659bc76d13d27aa09af5070fc47b0ed556b5af6ef8541f344a8c58e3f4f79515/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :db/ensure [:answer-field/validate]} [:db/retract 17592186152582 :question/answer-fields 17592186149938] {:db/id "q-338646/ma-source-field/35076650840cbb6beacf9f343738a476a3e52b3aadd11f5ca9f98f5a2c7cbdce/ef6b3c8a066aa4f14722d27e35b31ab6414cf6cba0ded8a063a0b53e18174200" :answer/id #uuid "bdec2590-f44d-5d16-8f47-5c405afcd805" :answer/type :answer.type/text :answer/value "Dirichlet" :db/ensure [:answer/validate]} {:db/id "q-338646/ma-source-field/35076650840cbb6beacf9f343738a476a3e52b3aadd11f5ca9f98f5a2c7cbdce/c8a139a7781cbf1484c5c65d833041ae69c859d2c77c229a5e0cb871eee8b46b" :answer/id #uuid "0b2c9783-f7e5-5797-b9f1-9f95b4b6673c" :answer/type :answer.type/text :answer/value "Neumann" :db/ensure [:answer/validate]} {:db/id "q-338646/ma-source-field/35076650840cbb6beacf9f343738a476a3e52b3aadd11f5ca9f98f5a2c7cbdce/b9248a6ddaa63032886818da7db1f1bcca7b4af333798c69a62e6a3c7eb9a71a" :answe