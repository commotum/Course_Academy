ld/type :answer-field.type/radio :answer-field/choices ["q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553/2ec84acfed806cf968a46378219881c54add29b6e058790084bf62945a365366" "q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553/ee518033e6828c0f6ab512a88666969288145cecbc43466cfd5168a4af1da795" "q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553/a70721455537754320ec584602adb8806561c3d17a1b69befeb2c6d62e67bb5f" "q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553/d49a0e2dfb37f73f8ea621ec4a7244409c547f6d30437d29b0bef5e7bbdceb6c" "q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553/12465ee3248325371e1503c4334cc7c02b270ce634dfd4fe01b259c5e05afb8f"] :answer-field/correct "q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553/d49a0e2dfb37f73f8ea621ec4a7244409c547f6d30437d29b0bef5e7bbdceb6c" :db/ensure [:answer-field/validate]} {:db/id "q-75640" :question/id #uuid "2a792333-1cd7-596e-9f36-ea2d3aa5343e" :question/math-academy-id "q-75640" :question/problem "The set ${{a}_{1},{a}_{2}}$ is linearly dependent. Which of the following vectors could be ${a}_{2}$ if\n${a}_{1}=[\\begin{aligned}5 \\\\ -2\\end{aligned}]?$" :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nA set containing *only two* vectors is linearly *dependent* if and only if the two vectors are parallel.\n\nFrom the given options, the correct answer is \n\n$$\n{a}_{2}=[\\begin{aligned}20 \\\\ -8\\end{aligned}].\n$$\n\nTo see why, notice that \n\n$$\n[\\begin{aligned}20 \\\\ -8\\end{aligned}]=4[\\begin{aligned}5 \\\\ -2\\end{aligned}]=4{a}_{1}.\n$$\n\nThis way, we have\n\n$$\n\\begin{aligned}4{a}_{1}-4{a}_{1} & =0 \\\\ 4{a}_{1}-{a}_{2} & =0 \\\\ 4{a}_{1}+(-1){a}_{2} & =0.\\end{aligned}\n$$\n\nIn other words, the vectors ${a}_{1}$ and ${a}_{2}$ are parallel.\n\nTo see why this means that ${a}_{1}$ and ${a}_{2}$ are linearly dependent, we notice that the equation\n\n$$\n{x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0\n$$\n\nhas the solution ${x}_{1}=4$ and ${x}_{2}=-1,$ which is different from ${x}_{1}={x}_{2}=0.$ Therefore, the set is linearly dependent." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75640/ma-source-field/9e3ef9b4665065886203dfa06d081bdd8387971e8881bd46f00c10e78be6c553"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5130f54d-2a53-5373-81a6-355921ea7523"] :knowledge-point/questions ["q-75640"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/62b43ea31c4ff3c5f25d7fc27d40d146b0e62a1ba500ef6a5ded40d1556904df" :answer/id #uuid "013971a3-aab2-52a1-a19d-7a5ac0084ba8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 \\\\ 4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/af921100fd32d4ea672fcdfa099bd71f2f8225759262a4bcfd2494855404ec7a" :answer/id #uuid "2d0e2276-3b1c-55bc-8e0d-1b1456cbdc62" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 \\\\ 6 \\\\ 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/57084255ac476e88f395c0be08a6ac4da2a99bcadcf8c3392d9e3db8630fd91a" :answer/id #uuid "fc07a05b-0118-5252-b35b-ce58aaf33f50" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 6 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/bbbe21838ae04407686e2d2232567005a9e02c28827ea8ec775cbe5901bc6001" :answer/id #uuid "7d2d7aa3-f1f3-582e-b408-82340acf0b62" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ -4 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/78a0fd963cbae5b8be475e85576b9ad6d9b0bd6c3ac47c14b1e71637cb0fa2f9" :answer/id #uuid "142ba162-ec92-5e12-9e2e-f1802915a4bf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 6 \\\\ -4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4" :answer-field/id #uuid "80b712db-bceb-5724-a93f-11876084e171" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/62b43ea31c4ff3c5f25d7fc27d40d146b0e62a1ba500ef6a5ded40d1556904df" "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/af921100fd32d4ea672fcdfa099bd71f2f8225759262a4bcfd2494855404ec7a" "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/57084255ac476e88f395c0be08a6ac4da2a99bcadcf8c3392d9e3db8630fd91a" "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/bbbe21838ae04407686e2d2232567005a9e02c28827ea8ec775cbe5901bc6001" "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/78a0fd963cbae5b8be475e85576b9ad6d9b0bd6c3ac47c14b1e71637cb0fa2f9"] :answer-field/correct "q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4/af921100fd32d4ea672fcdfa099bd71f2f8225759262a4bcfd2494855404ec7a" :db/ensure [:answer-field/validate]} {:db/id "q-75645" :question/id #uuid "1429f843-5ee1-5edb-b1a8-4da2570633ca" :question/math-academy-id "q-75645" :question/problem "The set ${{a}_{1},{a}_{2}}$ is linearly dependent. Which of the following vectors could be ${a}_{2}$ if\n${a}_{1}=[\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}]?$" :question/worked-solution "We say that two vectors ${v}_{1}$ and ${v}_{2}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}=0\n$$\n\nis ${x}_{1}={x}_{2}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nA set containing *only two* vectors is linearly *dependent* if and only if the two vectors are parallel.\n\nFrom the given options, the correct answer is\n\n$$\n{a}_{2}=[\\begin{aligned}-4 \\\\ 6 \\\\ 4\\end{aligned}].\n$$\n\nTo see why, notice that \n\n$$\n[\\begin{aligned}-4 \\\\ 6 \\\\ 4\\end{aligned}]=-2[\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}]=-2{a}_{1}.\n$$\n\nThis way, we have\n\n$$\n\\begin{aligned}2{a}_{1}-2{a}_{1} & =0 \\\\ 2{a}_{1}+{a}_{2} & =0.\\end{aligned}\n$$\n\nIn other words, the vectors ${a}_{1}$ and ${a}_{2}$ are parallel.\n\nTo see why this means that ${a}_{1}$ and ${a}_{2}$ are linearly dependent, we notice that the equation\n\n$$\n{x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0\n$$\n\nhas the solution ${x}_{1}=2$ and ${x}_{2}=1,$ which is different from ${x}_{1}={x}_{2}=0.$ Therefore, the set is linearly dependent." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75645/ma-source-field/35bf848f8e5bcb916a1f77d93f9c367abe946ef0b6619fad8bccb93d39ad1ad4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5130f54d-2a53-5373-81a6-355921ea7523"] :knowledge-point/questions ["q-75645"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78297/ma-source-field/49f0e2c8b85371ff7d8bc05cc344495f93a847174566653e44ab107faa419dc3/eed85fff1c310132f0359c50f92366bdd4fa19a46b8ed174cc9094aeae2f725d" :answer/id #uuid "d3f965ef-6b47-527f-a571-556003d4b579" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78297/ma-source-field/49f0e2c8b85371ff7d8bc05cc344495f93a847174566653e44ab107faa419dc3/6