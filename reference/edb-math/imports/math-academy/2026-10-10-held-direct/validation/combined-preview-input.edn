940dc1ee228ffce63f3b128f8be97112898917f90b66bc717f/ed95b64e164fb40772d373ca50874f6d79b77c64bf52980113ace7d2a414842b"] :answer-field/correct "q-337121/ma-source-field/344358a8aa1cc4940dc1ee228ffce63f3b128f8be97112898917f90b66bc717f/ed95b64e164fb40772d373ca50874f6d79b77c64bf52980113ace7d2a414842b" :db/ensure [:answer-field/validate]} {:db/id "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/7e2e21aa536ea80cbf601a405abd3f3cc2f8b4ea39b9ced040dd5f4e688f4ef3" :answer/id #uuid "42e3fb46-f61a-5833-95f6-27c46792783b" :answer/type :answer.type/text :answer/value "the fact that $({e}^{A{t}_{0}})^{-1}={e}^{-A{t}_{0}}$" :db/ensure [:answer/validate]} {:db/id "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/718e97f7cd4eb7c704f095d8f0eccf5ae1dba5552deb8a2b4a155f89697d0327" :answer/id #uuid "ae842823-c28d-5956-a3bf-e70e9276c908" :answer/type :answer.type/text :answer/value "the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}$ when $X$ and $Y$ commute" :db/ensure [:answer/validate]} {:db/id "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/4c92a695a061757d4b46494aab7d73a415e4c9ec5c6f711db04fa937a94b87ea" :answer/id #uuid "875b1271-178f-5292-86cb-7fb9f34b060b" :answer/type :answer.type/text :answer/value "the identity ${e}^{X}{e}^{Y}={e}^{XY}$ for matrices" :db/ensure [:answer/validate]} {:db/id "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88" :answer-field/id #uuid "ac58334b-08c3-5e97-99f4-3dd187516d7b" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/choices ["q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/7e2e21aa536ea80cbf601a405abd3f3cc2f8b4ea39b9ced040dd5f4e688f4ef3" "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/718e97f7cd4eb7c704f095d8f0eccf5ae1dba5552deb8a2b4a155f89697d0327" "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/4c92a695a061757d4b46494aab7d73a415e4c9ec5c6f711db04fa937a94b87ea"] :answer-field/correct "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88/718e97f7cd4eb7c704f095d8f0eccf5ae1dba5552deb8a2b4a155f89697d0327" :db/ensure [:answer-field/validate]} {:db/id "q-337121" :question/id #uuid "0d9118b1-b0ff-5db4-a05c-ec3ad938a6f1" :question/math-academy-id "q-337121" :question/problem "Consider the homogeneous system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix. You're given that the standard fundamental matrix ${Φ}_{0}(t)$ is the unique solution to the initial value problem\n\n$$\n{Φ}_{0}^{′}(t)=A{Φ}_{0}(t),\\,{Φ}_{0}(0)={I}_{n}.\n$$\n\nA derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below. \n\n$\\text{L1}:\\,$ Let ${Φ}_{0}(t)={e}^{At}$\n\n$\\text{L2}:\\,$ $x(t)={Φ}_{0}(t)\\,c$ for some constant vector $c$\n\n$\\text{L3}:\\,$ $x(t)={e}^{At}\\,c$ \n\n$\\text{L4}:\\,$ $x({t}_{0})={e}^{A{t}_{0}}\\,c$\n\n$\\text{L5}:\\,$ $({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c$\n\n$\\text{L6}:\\,$ $c={e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L7}:\\,$ $x(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L8}:\\,$ $x(t)={e}^{At-A{t}_{0}}x({t}_{0})\\,$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})\\,$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L5}$ follows from $\\text{L4}$ by {{field-1}}.\n\n$\\,$ Line $\\text{L7}$ can be obtained by {{field-2}}.\n\n$\\,$ Line $\\text{L8}$ follows from $\\text{L7}$ by {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L4}$ and $\\text{L5}.$ Starting from $\\text{L4},$\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c,\n$$\n\nwe multiply both sides on the left by $({e}^{A{t}_{0}})^{-1}$ to get\n\n$$\n({e}^{A{t}_{0}})^{-1}x({t}_{0})=({e}^{A{t}_{0}})^{-1}{e}^{A{t}_{0}}\\,c,\n$$\n\nwhich is line $\\text{L5}.$ Therefore, $\\text{L5}$ follows from $\\text{L4}$ by $\\text{multiplying both sides on the left by }({e}^{A{t}_{0}})^{-1}.$\n\n- Next, we consider line $\\text{L7}.$ Using line $\\text{L3}$ we have\n\n$$\nx(t)={e}^{At}\\,c.\n$$\n\nFrom line $\\text{L6}$, we know that $c={e}^{-A{t}_{0}}x({t}_{0}).$ Substituting this expression for $c$ into the formula for $x(t)$ gives\n\n$$\nx(t)={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}),\n$$\n\nwhich is line $\\text{L7}.$ Thus, line $\\text{L7}$ can be obtained by $\\text{substituting }c={e}^{-A{t}_{0}}x({t}_{0})\\text{ into }x(t)={e}^{At}c.$\n\n- Finally, we consider lines $\\text{L7}$ and $\\text{L8}.$ Since $At$ and $-A{t}_{0}$ commute, we can use the property \n\n$$\n{e}^{At}{e}^{-A{t}_{0}}={e}^{At-A{t}_{0}}.\n$$\n\nSubstituting this into line $\\text{L7},$ we get line $\\text{L8}:$\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}{e}^{-A{t}_{0}}x({t}_{0}) \\\\  & ={e}^{At-A{t}_{0}}x({t}_{0})\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ follows from $\\text{L7}$ by the fact that ${e}^{X}{e}^{Y}={e}^{X+Y}\\text{ when }X\\text{ and }Y\\text{ commute}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337121/ma-source-field/5eff0d6c767aba8aeb18ff615e13bcad4d2455c11fcd32ecd2fbe466e2e079d8" "q-337121/ma-source-field/344358a8aa1cc4940dc1ee228ffce63f3b128f8be97112898917f90b66bc717f" "q-337121/ma-source-field/c21396c49697fc450d6e67649b858755e33707ea5464860fa58e75d720ef8c88"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff837c0-0ebb-5a9e-acb4-894261e0318c"] :knowledge-point/questions ["q-337121"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337376/ma-source-field/65770673cd8d719b4dee3dc922de51842204857dc5ff684e2fa3cd9f617acb98/90244fea567263d29a122e974f426c797e64ce018b292ff9ad249e079209d91d" :answer/id #uuid "40d5b092-c1ca-5934-8385-b0856ab2a919" :answer/type :answer.type/math :answer/value "u(x){e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-337376