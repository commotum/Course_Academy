d31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/33bdbe6ae4de1c51a148a422d10565261690a65d9f90cfe8a8311a3c4c629929" :answer/id #uuid "f947c798-bc89-571a-a666-d5ac5fe1b843" :answer/type :answer.type/text :answer/value "$f(x)={e}^{2x}$ and $b=\\operatorname{ln}⁡2$" :db/ensure [:answer/validate]} {:db/id "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/c1b18dc7fcb69133724e31f65bc53afa52ad45c6d2dc91661f317b396c0e368e" :answer/id #uuid "b72fbfe6-34a0-5341-a7d6-2590a001b91e" :answer/type :answer.type/text :answer/value "$f(x)={e}^{x}$ and $b=2\\operatorname{ln}⁡2$" :db/ensure [:answer/validate]} {:db/id "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/c003d5a95b483eb28c0ccd4193cfb36711e5492d76d11bd0af11db9d69ae2dc3" :answer/id #uuid "6da93e3c-bfd8-566a-bf85-bf589185d302" :answer/type :answer.type/text :answer/value "$f(x)={e}^{x}$ and $b=\\operatorname{ln}⁡2$" :db/ensure [:answer/validate]} {:db/id "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9" :answer-field/id #uuid "eb2a4470-ddb9-5a4f-aab9-d2401a7ffff8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/a22dbddcb3c4ee53c0058c72dbed85adc77015d088e37903033e0ae33b1cbe13" "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/0b6ba394da3b129118f9924713516260132a8235c347d272c7a1366c68894366" "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/33bdbe6ae4de1c51a148a422d10565261690a65d9f90cfe8a8311a3c4c629929" "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/c1b18dc7fcb69133724e31f65bc53afa52ad45c6d2dc91661f317b396c0e368e" "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/c003d5a95b483eb28c0ccd4193cfb36711e5492d76d11bd0af11db9d69ae2dc3"] :answer-field/correct "q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9/0b6ba394da3b129118f9924713516260132a8235c347d272c7a1366c68894366" :db/ensure [:answer-field/validate]} {:db/id "q-49234" :question/id #uuid "6a62fd18-f127-592a-8fe3-1cc5a47bb7fb" :question/math-academy-id "q-49234" :question/problem "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{0}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[2{e}^{(k\\operatorname{ln}⁡2)/n}\\cdot \\frac{\\operatorname{ln}⁡2}{n}].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=0.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{\\operatorname{ln}⁡2}{n}.$ Therefore, \n\n$$\n\\frac{\\operatorname{ln}⁡2}{n}=\\frac{b-0}{n}\\,⟹\\,b=\\operatorname{ln}⁡2.\n$$\n\nConsequently,  ${x}_{k}=\\frac{k\\operatorname{ln}⁡2}{n}$ and $f({x}_{k})=2{e}^{{x}_{k}}.$\n\nHence,\n\n$$\n{\\int }_{0}^{\\operatorname{ln}⁡2}2{e}^{x}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[2{e}^{(k\\operatorname{ln}⁡2)/n}\\cdot \\frac{\\operatorname{ln}⁡2}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=2{e}^{x}$ and $b=\\operatorname{ln}⁡2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49234/ma-source-field/787158b7f55befd31e9c1bcb2b093a45d06bc8ebc81e578c5d2fd59d51764dd9"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f663b0b-9b5e-512c-92bb-0ea84d5baac5"] :knowledge-point/questions ["q-49234"] :db/ensure [:knowledge-point/validate]} {:db/id "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "89d11ef2-0ebb-56ef-85f5-eff24a1c20ef" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "2d49c863-bcca-5003-b60b-2402ac1bbc16" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" :answer/id #uuid "6e8bd46d-8040-58fd-9418-5e14e16fd9fd" :answer/type :answer.type/text :answer/value "I, II and III" :db/ensure [:answer/validate]} {:db/id "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3ecd9f23-0f52-529d-9d3d-4b581fbbb61a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "372a1527-fcb7-5e97-9214-ceab892980ce" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec" :answer-field/id #uuid "fb55a4d3-ef9d-5ba1-bc8d-64b5b8502eb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :answer-field/correct "q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" :db/ensure [:answer-field/validate]} {:db/id "q-66724" :question/id #uuid "8061fba9-94fb-59ab-bb67-c981e34d25e7" :question/math-academy-id "q-66724" :question/problem "Given that $f(x)=2x+4,$ on which of the following intervals is $f(x)$ invertible?\n\nI. $x\\in (-\\infty ,\\infty )$\nII. $x\\in (10,\\infty )$\nIII. $x\\in [-5,5)$" :question/worked-solution "The function $f(x)$ is a linear function with slope $2$ and $y$-intercept $4,$ as shown below. \n\n![](images/d3/d33314230419ec762bc4ad8603b2e6c3436461cd6b4b6fe4783d12a23d01b660.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (10,\\infty )$ and $x\\in [-5,5).$\n\nTherefore, the correct answer is \"I, II, and III\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-66724/ma-source-field/880d895a7253a9f6663687a6a0756ecb33fef2878d3cda8e2cb87de2ade249ec"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b