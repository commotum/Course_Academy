2\\end{aligned}]=-2{a}_{1}.\n$$\n\nThis way, we have\n\n$$\n\\begin{aligned}2{a}_{1}-2{a}_{1} & =0 \\\\ 2{a}_{1}+{a}_{2} & =0.\\end{aligned}\n$$\n\nIn other words, the vectors ${a}_{1}$ and ${a}_{2}$ are parallel.\n\nTo see why this means that ${a}_{1}$ and ${a}_{2}$ are linearly dependent, we notice that the equation\n\n$$\n{x}_{1}{a}_{1}+{x}_{2}{a}_{2}=0\n$$\n\nhas the solution ${x}_{1}=2$ and ${x}_{2}=1,$ which is different from ${x}_{1}={x}_{2}=0.$ Therefore, the set is linearly dependent." 13194139533469 17592186045585 true] [17592186396708 1075 #edb/ref 17592186396709 13194139533469 17592186045585 true] [17592186396708 1075 #edb/ref 17592186396710 13194139533469 17592186045585 true] [17592186396708 1075 #edb/ref 17592186396711 13194139533469 17592186045585 true] [17592186396708 1075 #edb/ref 17592186396712 13194139533469 17592186045585 true] [17592186396708 1075 #edb/ref 17592186396713 13194139533469 17592186045585 true] [17592186396708 1076 #edb/ref 17592186045493 13194139533469 17592186045585 true] [17592186396708 1077 "selection" 13194139533469 17592186045585 true] [17592186396708 1079 #edb/ref 17592186396712 13194139533469 17592186045585 true] [17592186396708 1080 #uuid "80b712db-bceb-5724-a93f-11876084e171" 13194139533469 17592186045585 true] [17592186396709 1081 "[\\begin{aligned}-6 \\\\ 6 \\\\ 6\\end{aligned}]" 13194139533469 17592186045585 true] [17592186396709 1083 #edb/ref 17592186045499 13194139533469 17592186045585 true] [17592186396709 1084 #uuid "fc07a05b-0118-5252-b35b-ce58aaf33f50" 13194139533469 17592186045585 true] [17592186396710 1081 "[\\begin{aligned}-4 \\\\ 4 \\\\ 6\\end{aligned}]" 13194139533469 17592186045585 true] [17592186396710 1083 #edb/ref 17592186045499 13194139533469 17592186045585 true] [17592186396710 1084 #uuid "013971a3-aab2-52a1-a19d-7a5ac0084ba8" 13194139533469 17592186045585 true] [17592186396711 1081 "[\\begin{aligned}4 \\\\ 6 \\\\ -4\\end{aligned}]" 13194139533469 17592186045585 true] [17592186396711 1083 #edb/ref 175921