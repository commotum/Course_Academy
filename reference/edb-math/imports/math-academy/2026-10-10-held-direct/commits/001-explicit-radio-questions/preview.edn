533469 17592186045585 true] [17592186396680 1075 #edb/ref 17592186396683 13194139533469 17592186045585 true] [17592186396680 1075 #edb/ref 17592186396684 13194139533469 17592186045585 true] [17592186396680 1075 #edb/ref 17592186396685 13194139533469 17592186045585 true] [17592186396680 1076 #edb/ref 17592186045493 13194139533469 17592186045585 true] [17592186396680 1077 "selection" 13194139533469 17592186045585 true] [17592186396680 1079 #edb/ref 17592186396681 13194139533469 17592186045585 true] [17592186396680 1080 #uuid "7d5e1e7b-8e38-5b41-953d-3eb5f39cc12b" 13194139533469 17592186045585 true] [17592186396681 1081 "$x=-3$ and $x=0$" 13194139533469 17592186045585 true] [17592186396681 1083 #edb/ref 17592186045500 13194139533469 17592186045585 true] [17592186396681 1084 #uuid "0f8cb089-6505-515d-b264-99e427a1221e" 13194139533469 17592186045585 true] [17592186396682 1081 "$x=0$ and $x=2$" 13194139533469 17592186045585 true] [17592186396682 1083 #edb/ref 17592186045500 13194139533469 17592186045585 true] [17592186396682 1084 #uuid "c08b5c35-a5d7-5069-b56f-c620adb60e5b" 13194139533469 17592186045585 true] [17592186396683 1081 "x=\\pm 2" 13194139533469 17592186045585 true] [17592186396683 1083 #edb/ref 17592186045499 13194139533469 17592186045585 true] [17592186396683 1084 #uuid "86dd1c08-dfcc-5440-8ed6-a1599aed6c51" 13194139533469 17592186045585 true] [17592186396684 1081 "$x=-3$ only" 13194139533469 17592186045585 true] [17592186396684 1083 #edb/ref 17592186045500 13194139533469 17592186045585 true] [17592186396684 1084 #uuid "c8a54622-a441-5f4f-8a9d-6f28f972e33c" 13194139533469 17592186045585 true] [17592186396685 1081 "$x=1$ only" 13194139533469 17592186045585 true] [17592186396685 1083 #edb/ref 17592186045500 13194139533469 17592186045585 true] [17592186396685 1084 #uuid "50484ca8-86cd-5313-806f-14cb83956a21" 13194139533469 17592186045585 true] [17592186396686 1068 #edb/ref 17592186396687 13194139533469 17592186045585 true] [17592186396686 1069 "q-49234" 13194139533469 17592186045585 true] [17592186396686 1070 #edb/ref 17592186045486 13194139533469 17592186045585 true] [17592186396686 1071 "Find the function $f(x)$ and the value of $b,$ given that ${\\int }_{0}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[2{e}^{(k\\operatorname{ln}⁡2)/n}\\cdot \\frac{\\operatorname{ln}⁡2}{n}].$" 13194139533469 17592186045585 true] [17592186396686 1072 #uuid "6a62fd18-f127-592a-8fe3-1cc5a47bb7fb" 13194139533469 17592186045585 true] [17592186396686 1074 "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=0.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{\\operatorname{ln}⁡2}{n}.$ Therefore, \n\n$$\n\\frac{\\operatorname{ln}⁡2}{n}=\\frac{b-0}{n}\\,⟹\\,b=\\operatorname{ln}⁡2.\n$$\n\nConsequently,  ${x}_{k}=\\frac{k\\operatorname{ln}⁡2}{n}$ and $f({x}_{k})=2{e}^{{x}_{k}}.$\n\nHence,\n\n$$\n{\\int }_{0}^{\\operatorname{ln}⁡2}2{e}^{x}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[2{e}^{(k\\operatorname{ln}⁡2)/n}\\cdot \\frac{\\operatorname{ln}⁡2}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=2{e}^{x}$ and $b=\\operatorname{ln}⁡2.$" 13194139533469 17592186045585 true] [17592186396687 1075 #edb/ref 17592186396688 13194139533469 17592186045585 true] [17592186396687 1075 #edb/ref 17592186396689 13194139533469 17592186045585 true] [17592186396687 1075 #edb/ref 17592186396690 13194139533469 17592186045585 true] [17592186396687 1075 #edb/ref 17592186396691 13194139533469 17592186045585 true] [17592186396687 1075 #edb/ref 17592186396692 13194139533469 17592186045585 true] [17592186396687 1076 #edb/ref 17592186045493 13194139533469 17592186045585 true] [17592186396687 1077 "selection" 13194139533469 17592186045585 true] [17592186396687 1079 #ed