{e}^{-3t}}{2}} \\\\  & =L{\\frac{{e}^{3t}}{2}+\\frac{{e}^{-3t}}{2}} \\\\  & =L{\\frac{{e}^{3t}}{2}}+L{\\frac{{e}^{-3t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{3t}}+\\frac{1}{2}L{{e}^{-3t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{3t}} & =\\frac{1}{s-3},\\,s>3 \\\\ L{{e}^{-3t}} & =\\frac{1}{s+3},\\,s>-3\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cosh}⁡(3t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(3t)} & =\\frac{1}{2}L{{e}^{3t}}+\\frac{1}{2}L{{e}^{-3t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-3}+\\frac{1}{2}\\cdot \\frac{1}{s+3} \\\\  & =\\frac{1}{2}(\\frac{1}{s-3}+\\frac{1}{s+3}) \\\\  & =\\frac{1}{2}(\\frac{(s+3)+(s-3)}{(s-3)(s+3)}) \\\\  & =\\frac{1}{2}(\\frac{2s}{{s}^{2}-9}) \\\\  & =\\frac{s}{{s}^{2}-9}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{3t}}$ is defined for $s\\in (3,\\infty )$ and $L{{e}^{-3t}}$ is defined for $s\\in (-3,\\infty ),$ we have that $L{\\operatorname{cosh}⁡(3t)}$ is defined for\n\n$$\n(3,\\infty )\\cap (-3,\\infty )=(3,\\infty ),\n$$\n\nthat is, $s>3.$" 13194139533471 17592186045585 true] [17592186397465 1075 #edb/ref 17592186397466 13194139533471 17592186045585 true] [17592186397465 1075 #edb/ref 17592186397467 13194139533471 17592186045585 true] [17592186397465 1075 #edb/ref 17592186397468 13194139533471 17592186045585 true] [17592186397465 1075 #edb/ref 17592186397469 13194139533471 17592186045585 true] [17592186397465 1075 #edb/ref 17592186397470 13194139533471 17592186045585 true] [17592186397465 1075 #edb/ref 17592186397471 13194139533471 17592186045585 true] [17592186397465 1076 #edb/ref 17592186045494 13194139533471 17592186045585 true] [17592186397465 1077 "field-2" 13194139533471 17592186045585 true] [17592186397465 1079 #edb/ref 17592186397466 13194139533471 17592186045585 true] [17592186397465 1080 #uuid "8fe74c7f-d29a-5023-a627-6b99c33c73b4" 13194139533471 17592186045585 true] [17