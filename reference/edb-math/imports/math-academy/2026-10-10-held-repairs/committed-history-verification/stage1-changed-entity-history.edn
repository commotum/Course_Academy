_{Δ}(1-r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{\\int }_{0}^{2}r-{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139533507 17592186045585 true] [17592186406433 1075 #edb/ref 17592186406434 13194139533507 17592186045585 true] [17592186406433 1075 #edb/ref 17592186406435 13194139533507 17592186045585 true] [17592186406433 1075 #edb/ref 17592186406436 13194139533507 17592186045585 true] [17592186406433 1075 #edb/ref 17592186406437 13194139533507 17592186045585 true] [17592186406433 1075 #edb/ref 17592186406438 13194139533507 17592186045585 true] [17592186406433 1076 #edb/ref 17592186045493 13194139533507 17592186045585 true] [17592186406433 1077 "selection" 13194139533507 17592186045585 true] [17592186406433 1079 #edb/ref 17592186406438 13194139533507 17592186045585 true] [17592186406433 1080 #uuid "9ca86920-5215-52e0-b0cb-aabc47b3bb45" 13194139533507 17592186045585 true] [17592186406434 1081 "1-r\\operatorname{sin}⁡\\theta " 13194139533507 17592186045585 true] [17592186406434 1083 #edb/ref 17592186045499 13194139533507 17592186045585 true] [17592186406434 1084 #uuid "017f8f24-8529-55cc-a1a8-41dc999d12f6" 13194139533507 17592186045585 true] [17592186406435 1081 "r-{r}^{2}\\operatorname{sin}⁡\\theta " 13194139533507 17592186045585 true] [17592186406435 1083 #edb/ref 17592186045499 13194139533507 17592186045585 true] [17592186406435 1084 #uuid "71c0e048-b5e5-51cc-8ee4-8a54d22a60bf" 13194139533507 17592186045585 true] [17592186406436 1081 "2r\\operatorname{sin}⁡\\theta -{r}^{2}\\operatorname{cos}⁡\\theta " 13194139533507 17592186045585 true] [17592186406436 1083 #edb/ref 17592186045499 13194139533507 17592186045585 true] [17592186406436 1084 #uuid "53d65de8-c1f0-596d-875a-4aa5f454bb9f" 13194139533507 17592186045585 true] [17592186406437 1081 "1-r\\operatorname{cos}⁡\\theta " 13194139533507 17592186045585 true] [17592186406437 1083 #edb/ref 17592186045499 13194139533507 