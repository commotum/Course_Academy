{9-{x}^{2}-{y}^{2}}} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(-\\sqrt{9-{x}^{2}-{y}^{2}})=\\frac{y}{\\sqrt{9-{x}^{2}-{y}^{2}}}\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=1,\\,Q=0,\\,R=x.\n$$\n\n \n\nAs a result, since the positive orientation is downward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & =-{∬}_{D}(-P\\frac{∂h}{∂x}-Q\\frac{∂h}{∂y}+R)\\text{d}A \\\\  & =-{∬}_{D}(-1\\cdot \\frac{x}{\\sqrt{9-{x}^{2}-{y}^{2}}}-0\\cdot \\frac{y}{\\sqrt{9-{x}^{2}-{y}^{2}}}+x)\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{\\sqrt{9-{x}^{2}-{y}^{2}}}-x\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}x\\,\\text{d}A+{∬}_{D}\\frac{x}{\\sqrt{9-{x}^{2}-{y}^{2}}}-x\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{\\sqrt{9-{x}^{2}-{y}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{x}{\\sqrt{9-{x}^{2}-{y}^{2}}}\\,\\text{d}A.\\end{aligned}\n$$" 13194139533500 17592186045585 true] [17592186405141 1075 #edb/ref 17592186405142 13194139533500 17592186045585 true] [17592186405141 1075 #edb/ref 17592186405143 13194139533500 17592186045585 true] [17592186405141 1075 #edb/ref 17592186405144 13194139533500 17592186045585 true] [17592186405141 1075 #edb/ref 17592186405145 13194139533500 17592186045585 true] [17592186405141 1075 #edb/ref 17592186405146 13194139533500 17592186045585 true] [17592186405141 1076 #edb/ref 17592186045493 13194139533500 17592186045585 true] [17592186405141 1077 "selection" 13194139533500 17592186045585 true] [17592186405141 1079 #edb/ref 17592186405145 13194139533500 17592186045585 true] [17592186405141 1080 #uuid "9854d104-9a4b-53d3-8285-a6f5f2377a4d" 13194139533500 17592186045585 true] [17592186405142 1081 "\\frac{xy}{\\sqrt{9-{x}^{2}-{y}^{2}}}+x" 13194139533500 17592186045585 true] [17592186405142 1083 #edb/ref 17592186045499 13194139533500 17592186045585 true] [17592186405142 1084 #uuid