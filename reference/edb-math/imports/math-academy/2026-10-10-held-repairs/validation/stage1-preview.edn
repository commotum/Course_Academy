ned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$" 13194139533500 17592186045585 true] [17592186405211 1075 #edb/ref 17592186405212 13194139533500 17592186045585 true] [17592186405211 1075 #edb/ref 17592186405213 13194139533500 17592186045585 true] [17592186405211 1075 #edb/ref 17592186405214 13194139533500 17592186045585 true] [17592186405211 1075 #edb/ref 17592186405215 13194139533500 17592186045585 true] [17592186405211 1075 #edb/ref 17592186405216 13194139533500 17592186045585 true] [17592186405211 1076 #edb/ref 17592186045493 13194139533500 17592186045585 true] [17592186405211 1077 "selection" 13194139533500 17592186045585 true] [17592186405211 1079 #edb/ref 17592186405213 13194139533500 17592186045585 true] [17592186405211 1080 #uuid "efb02de0-491f-59d6-8a75-57bfea7150b9" 13194139533500 17592186045585 true] [17592186405212 1081 "$\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$" 13194139533500 17592186045585 true] [17592186405212 1083 #edb/ref 17592186045500 13194139533500 17592186045585 true] [17592186405212 1084 #uuid "e022e2a9-7ada-59ab-9b55-0e78c7221355" 13194139533500 17592186045585 true] [17592186405213 1081 "$\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\,$ and $\\,\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$" 13194139533500 17592186045585 true] [17592186405213 1083 #edb/ref 17592186045500 13194139533500 17592186045585 true] [17592186405213 1084 #uuid "891a2dde-5575-57e6-8a39-eba10064ab