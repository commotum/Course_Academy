on/problem "What are the pivot columns of the matrix $A$, given by\n$A = \\begin{bmatrix}0 & 0 & 0 & 0 \\\\ 0 & 4 & 8 & -6 \\\\ 0 & -2 & -4 & 1 \\\\ 1 & 4 & 0 & 2\\end{bmatrix}$?"}] [{:db/id #edb/ref 17592186323727 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2842cc73-0f01-58d5-b5f8-0139583e8db8" :answer/type {:db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186321467} {:answer/id #uuid "2de3d6aa-490c-5cae-a784-6e667b895471" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186321512} {:answer/id #uuid "a00a0949-433b-5624-94b0-a6603a842920" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186322418} {:answer/id #uuid "a251689c-7067-57e5-bcb5-7bc51fb827e3" :answer/type {:db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186322434} {:answer/id #uuid "b425d295-6b7a-560e-97ee-8069726e7fc1" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322561}] :answer-field/correct {:answer/id #uuid "b425d295-6b7a-560e-97ee-8069726e7fc1" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322561} :answer-field/id #uuid "bad8f0e9-eadc-541a-b41e-da64a5a6afcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed660c39-3116-519a-a531-99463ad097b8" :question/math-academy-id "q-35833" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{4{x}^{2}-9x+1}{x+4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{2}-9x+1}{x+4} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{2}}{x}-\\frac{9x}{x}+\\frac{1}{x})}{(\\frac{x}{x}+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+\\frac{1}{x})}{(1+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+0)}{(1+0)} \\\\  & ={lim}_{x\\to \\infty }(4x)-9 \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186124955 :knowledge-point/_questions [{:knowledge-point/id #uuid "f232aed9-1584-5e57-a881-226a6876384a" :knowledge-point/title "Finding the Vector Equation of a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd44e118-b9d7-5b0d-aa4b-86097c349fbd" :answer/type {:db/ident :answer.type/math} :answer/value "r = t\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122301} {:answer/id #uuid "fec2dc66-d085-5885-85e3-c479c95c35af" :answer/type {:db/ident :answer.type/math} :answer/value "r = t\\begin{bmatrix}5 \\\\ 0 \\\\ 7\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122302} {:answer/id #uuid "3c1d6d85-1bf2-5b2b-b379-482881497974" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}5 \\\\ 0 \\\\ 7\\end{bmatrix} + t\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122303} {:answer/id #uuid "495b676e-68f2-5a5d-b117-9facba95be57" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix} + t\\begin{bmatrix}5 \\\\ 0 \\\\ 7\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122304} {:answer/id #uuid "625b81d0-5afd-5e1c-8b1f-4ee3e71c9ba2" :answer/type {:db/ident :answer.type/text} :an