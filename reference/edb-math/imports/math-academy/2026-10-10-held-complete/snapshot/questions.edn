/math-academy-id "q-16400" :question/problem "Write the following first-order linear ODE in standard form.\n$2\\frac{dy}{dx} - 3\\cos x = 1 - 4y\\sin x$"}] [{:db/id #edb/ref 17592186284506 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd6eaa8-586c-5103-b0cc-92a8aaaf1a7e" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186281813} {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282020} {:answer/id #uuid "2b318cd8-3045-5788-9bb8-ab1134992947" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282075} {:answer/id #uuid "56d2cf8c-c2ea-5087-9d96-d9a6dcd9d5dd" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282432} {:answer/id #uuid "eafb0571-17a8-5784-a800-513c70030f56" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283749}] :answer-field/correct {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282020} :answer-field/id #uuid "09284adb-1272-5cf4-81c3-aa20d058b0a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e28adc4e-c42a-55a7-ab38-db39626f07cf" :question/math-academy-id "q-164510" :question/problem "Identify the surface $x=\\frac{{y}^{2}}{2}+\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic paraboloid centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\nx=\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic paraboloid whose axis of symmetry is the $x$-axis and $b=\\sqrt{2},\\,c=2.$"}] [{:db/id #edb/ref 17592186060112 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe5bd766-d624-54e3-945e-7ae37b83886a" :knowledge-point/title "Negating a Sentence Containing a Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0035e6e-f36a-5da1-a062-615e7f0ab3c9" :answer/type {:db/ident :answer.type/text} :answer/value "$3 \\mid 18$ and $11$ is not prime" :db/id #edb/ref 17592186057001} {:answer/id #uuid "0b775ec8-6ca9-5db2-8064-a450b230418a" :answer/type {:db/ident :answer.type/text} :answer/value "$3 \\mid 18$ and $11$ is prime" :db/id #edb/ref 17592186057002} {:answer/id #uuid "101774e8-84db-52ee-9a64-592220a96e3c" :answer/type {:db/ident :answer.type/text} :answer/value "$3⧸ \\mid 18$ and $11$ is prime" :db/id #edb/ref 17592186057003} {:answer/id #uuid "37228b0c-4acf-5470-b487-ce615401948e" :answer/type {:db/ident :answer.type/text} :answer/value "$3⧸ \\mid 18$ or $11$ is prime" :db/id #edb/ref 17592186057004} {:answer/id #uuid "698ca85f-1919-5143-8622-5c257aae85d7" :answer/type {:db/ident :answer.type/text} :answer/value "$3 \\mid 18$ or $11$ is prime" :db/id #edb/ref 17592186057005}] :answer-field/id #uuid "c555a8be-5736-508c-a3a8-50d0c1ffb86f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057000}] :questi