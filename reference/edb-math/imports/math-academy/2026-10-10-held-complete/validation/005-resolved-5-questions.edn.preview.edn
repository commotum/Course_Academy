45585 true] [17592186399441 1075 #edb/ref 17592186399443 13194139533478 17592186045585 true] [17592186399441 1075 #edb/ref 17592186399444 13194139533478 17592186045585 true] [17592186399441 1075 #edb/ref 17592186399445 13194139533478 17592186045585 true] [17592186399441 1075 #edb/ref 17592186399446 13194139533478 17592186045585 true] [17592186399441 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399441 1077 "selection" 13194139533478 17592186045585 true] [17592186399441 1079 #edb/ref 17592186399442 13194139533478 17592186045585 true] [17592186399441 1080 #uuid "0f56b5f1-cd7e-5c89-a46d-d954a6720fb6" 13194139533478 17592186045585 true] [17592186399442 1081 "$3$rd only" 13194139533478 17592186045585 true] [17592186399442 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399442 1084 #uuid "b9f7d878-00f4-542b-8edf-3af17fe0109d" 13194139533478 17592186045585 true] [17592186399443 1081 "$4$th only" 13194139533478 17592186045585 true] [17592186399443 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399443 1084 #uuid "72d87fbc-4b88-5bc5-9012-5cf5dcb8fa96" 13194139533478 17592186045585 true] [17592186399444 1081 "$3$rd and $4$th only" 13194139533478 17592186045585 true] [17592186399444 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399444 1084 #uuid "07fc175c-99d2-576d-bf97-0bf7ed21babe" 13194139533478 17592186045585 true] [17592186399445 1081 "$1$st only" 13194139533478 17592186045585 true] [17592186399445 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399445 1084 #uuid "8987d718-6753-5003-aba1-920a4bda3fd4" 13194139533478 17592186045585 true] [17592186399446 1081 "$2$nd only" 13194139533478 17592186045585 true] [17592186399446 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399446 1084 #uuid "99bc6b73-3d0e-57d4-97fb-808b0c314e7e" 13194139533478 17592186045585 true] [17592186399447 1068 #edb/ref 17592186399448 13194139533478 17592186045585 true] [17592186399447 1069 "q-130998" 13194139533478 17592186045585 true] [17592186399447 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186399447 1071 "Which of the following systems is an initial value problem?\n\nI. $5{y}^{″}+x{y}^{′}+y=\\operatorname{cos}⁡x,\\,y(0)=0,\\,{y}^{′}(0)=1$\nII. ${x}^{2}{y}^{″}-{e}^{x}{y}^{′}=0,\\,y(0)=1,\\,{y}^{′}(1)=0$\nIII. $\\frac{1}{x}{y}^{″}+{x}^{2}{y}^{′}={e}^{x},\\,y(1)=0,\\,{y}^{′}(1)=2$" 13194139533478 17592186045585 true] [17592186399447 1072 #uuid "30c6fcc7-4b73-56ac-a7b7-837e8d6bcc9e" 13194139533478 17592186045585 true] [17592186399447 1074 "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=0$).\n\n- The second system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=1$). This is a **boundary value problem.**\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)." 13194139533478 17592186045585 true] [17592186399448 1075 #edb/ref 17592186399449 13194139533478 17592186045585 true] [17592186399448 1075 #edb/ref 17592186399450 13194139533478 17592186045585 true] [17592186399448 1075 #edb/ref 17592186399451 13194139533478 17592186045585 true] [17592186399448 1075 #edb/ref 17592186399452 13194139533478 17592186045585 true] [17592186399448 1075 #edb/ref 17592186399453 13194139533478 17592186045585 true] [17592186399448 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399448 1077 "selection" 13194139533478 17592186045585 true] [17592186399448 1079 #edb/ref 17592186399450 13194139533478 17592186045585 true] [17592186399448 1080 #uuid "8ba78ad2-0850-53db-9d8e-7e73850a3220" 13194139533478 17592186045585 true] [17592186399449 1081 "II and III only" 13194139533478 17592186045585 true] [17592186399449 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399449 1084 #uuid "e377eccc-3189-56b6-b479-71605910738f" 13194139533478 17592186045585 true] [17592186399450 1081 "I and III only" 13194139533478 17592186045585 true] [17592186399450 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399450 1084 #uuid "74fefd89-78b3-5c97-883c-68b88daa0fa5" 13194139533478 17592186045585 true] [17592186399451 1081 "I only" 13194139533478 17592186045585 true] [17592186399451 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399451 1084 #uuid "a20da691-65d2-548d-9a18-553c5730b381" 13194139533478 17592186045585 true] [17592186399452 1081 "III only" 13194139533478 17592186045585 true] [17592186399452 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399452 1084 #uuid "8db29ded-36e3-5353-b386-e022a9b25e4d" 13194139533478 17592186045585 true] [17592186399453 1081 "II only" 13194139533478 17592186045585 true] [17592186399453 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399453 1084 #uuid "c99e3be9-96bf-5cd2-aea1-7adeba26d642" 13194139533478 17592186045585 true] [17592186399454 1068 #edb/ref 17592186399455 13194139533478 17592186045585 true] [17592186399454 1069 "q-131030" 13194139533478 17592186045585 true] [17592186399454 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399454 1071 "Given that ${y}_{1}(x)=\\frac{1}{x}$ and ${y}_{2}(x)=\\sqrt{x}$ are solutions to the equation $2{x}^{2}{y}^{″}+3x{y}^{′}-y=0$ for $x>0,$ what function must also be a solution to the given differential equation?" 13194139533478 17592186045585 true] [17592186399454 1072 #uuid "29af1809-de4f-574a-839e-a36c55c6c73a" 13194139533478 17592186045585 true] [17592186399454 1074 "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, and ${c}_{1}$ and ${c}_{2}$ are constants, then $y(x)={c}_{1}{y}_{1}(x)+{c}_{2}{y}_{2}(x)$ is also a solution to the equation.\n\nWe're given that ${y}_{1}(x)=\\frac{1}{x}$ and ${y}_{2}(x)=\\sqrt{x}.$ Therefore, the following function is also a solution:\n\n$$\ny(x)={c}_{1}\\frac{1}{x}+{c}_{2}\\sqrt{x}\n$$\n\nIf we let ${c}_{1}=2$ and ${c}_{2}=1,$ we get:\n\n$$\ny(x)=\\frac{2}{x}+\\sqrt{x}=\\frac{2+x\\sqrt{x}}{x}\n$$" 13194139533478 17592186045585 true] [17592186399455 1075 #edb/ref 17592186399456 13194139533478 17592186045585 true] [17592186399455 1075 #edb/ref 17592186399457 13194139533478 17592186045585 true] [17592186399455 1075 #edb/ref 17592186399458 13194139533478 17592186045585 true] [17592186399455 1075 #edb/ref 17592186399459 13194139533478 17592186045585 true] [17592186399455 1075 #edb/ref 17592186399460 13194139533478 17592186045585 true] [17592186399455 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399455 1077 "selection" 13194139533478 17592186045585 true] [17592186399455 1079 #edb/ref 17592186399457 13194139533478 17592186045585 true] [17592186399455 1080 #uuid "33649e08-48a2-55ba-ae41-136334d74883" 13194139533478 17592186045585 true] [17592186399456 1081 "y=\\frac{4}{x}+{x}^{2}\\sqrt{x}" 13194139533478 17592186045585 true] [17592186399456 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399456 1084 #uuid "d9f6d29f-2121-5953-b29d-e5fe2ae8cff6" 13194139533478 17592186045585 true] [17592186399457 1081 "y=\\frac{2+x\\sqrt{x}}{x}" 13194139533478 17592186045585 true] [17592186399457 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399457 1084 #uuid "fb108ca1-064a-5a1f-b4a8-c9d68416f398" 13194139533478 17592186045585 true] [17592186399458 1081 "y=2x+3\\sqrt{x}" 13194139533478 17592186045585 true] [17592186399458 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399458 1084 #uuid "99a560b9-f442-53ea-9413-22536b9867f4" 13194139533478 17592186045585 true] [17592186399459 1081 "y=\\frac{2\\sqrt{x}}{3{x}^{2}}" 13194139533478 17592186045585 true] [17592186399459 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399459 1084 #uuid "d3331cb4-e07f-5e65-9fab-eabb5092ba87" 13194139533478 17592186045585 true] [17592186399460 1081 "y=\\frac{x+2}{\\sqrt{x}+1}" 13194139533478 17592186045585 true] [17592186399460 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399460 1084 #uuid "75ebe5a8-11df-5c7c-8635-490c08eb5669" 13194139533478 17592186045585 true] [17592186399461 1068 #edb/ref 17592186399462 13194139533478 17592186045585 true] [17592186399461 1069 "q-131032" 13194139533478 17592186045585 true] [17592186399461 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399461 1071 "Given that ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{-2x}$ are solutions to the equation ${y}^{″}+{y}^{′}-2y=0,$ what function must also be a solution to the given differential equation?" 13194139533478 17592186045585 true] [17592186399461 1072 #uuid "5c0ea85a-8646-5af0-8c5d-b95cfa962333" 13194139533478 17592186045585 true] [17592186399461 1074 "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, and ${c}_{1}$ and ${c}_{2}$ are constants, then $y(x)={c}_{1}{y}_{1}(x)+{c}_{2}{y}_{2}(x)$ is also a solution to the equation.\n\nWe're given that ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{-2x}.$ Therefore, the following function is also a solution:\n\n$$\ny(x)={c}_{1}{e}^{x}+{c}_{2}{e}^{-2x}\n$$\n\nIf we let ${c}_{1}=\\frac{2}{3}$ and ${c}_{2}=-\\frac{1}{3},$ we get:\n\n$$\ny(x)=\\frac{2{e}^{x}}{3}-\\frac{{e}^{-2x}}{3}=\\frac{2{e}^{x}-{e}^{-2x}