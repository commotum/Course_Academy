273-5aef-bab1-b00405cb06a8" 13194139533478 17592186045585 true] [17592186399532 1081 "$x<-5$ or    $x>-1$" 13194139533478 17592186045585 true] [17592186399532 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399532 1084 #uuid "19263d22-de7b-5ef3-9798-b98080320005" 13194139533478 17592186045585 true] [17592186399533 1081 "x>5" 13194139533478 17592186045585 true] [17592186399533 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399533 1084 #uuid "ee071af0-120e-5c4a-b72d-0c54e26d3687" 13194139533478 17592186045585 true] [17592186399534 1081 "$x<-1$ or    $x>5$" 13194139533478 17592186045585 true] [17592186399534 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399534 1084 #uuid "395b066b-730c-5a11-889e-cc63987fd8a1" 13194139533478 17592186045585 true] [17592186399535 1081 "-1<x<5" 13194139533478 17592186045585 true] [17592186399535 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399535 1084 #uuid "3271e9c8-ddaf-5be7-852f-5b3fd22e072b" 13194139533478 17592186045585 true] [17592186399536 1068 #edb/ref 17592186399537 13194139533478 17592186045585 true] [17592186399536 1069 "q-141310" 13194139533478 17592186045585 true] [17592186399536 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186399536 1071 "Does the sequence ${a}_{n}=\\frac{3{(4)}^{n}}{{(-6)}^{n}}$ for $n\\ge 1$ converge or diverge? If it converges, what is its limit?" 13194139533478 17592186045585 true] [17592186399536 1072 #uuid "7c5b5131-1801-5dfb-aff8-f50ca940df15" 13194139533478 17592186045585 true] [17592186399536 1074 "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form ${a}_{n}=a\\cdot {r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{3{(4)}^{n}}{{(-6)}^{n}} \\\\  & =3\\cdot \\frac{{(4)}^{n}}{{(-6)}^{n}} \\\\  & =3{(-\\frac{4}{6})}^{n} \\\\  & =3{(-\\frac{2}{3})}^{n}\\end{aligned}\n$$\n\nWe can now see that this is the geometric sequence with $r=-\\frac{2}{3}.$ \n\nSince $|r|<1,$ the sequence converges to $0.$" 13194139533478 17592186045585 true] [17592186399537 1075 #edb/ref 17592186399538 13194139533478 17592186045585 true] [17592186399537 1075 #edb/ref 17592186399539 13194139533478 17592186045585 true] [17592186399537 1075 #edb/ref 17592186399540 13194139533478 17592186045585 true] [17592186399537 1075 #edb/ref 17592186399541 13194139533478 17592186045585 true] [17592186399537 1075 #edb/ref 17592186399542 13194139533478 17592186045585 true] [17592186399537 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399537 1077 "selection" 13194139533478 17592186045585 true] [17592186399537 1079 #edb/ref 17592186399538 13194139533478 17592186045585 true] [17592186399537 1080 #uuid "a83cb541-9ba7-558c-804e-5b78b4a327b4" 13194139533478 17592186045585 true] [17592186399538 1081 "Converges to $0$" 13194139533478 17592186045585 true] [17592186399538 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399538 1084 #uuid "d912e9d9-60dd-53f8-84b5-6a01262be9b8" 13194139533478 17592186045585 true] [17592186399539 1081 "Converges to $3$" 13194139533478 17592186045585 true] [17592186399539 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399539 1084 #uuid "5e69372e-e868-57ad-81a9-235542604c47" 13194139533478 17592186045585 true] [17592186399540 1081 "Converges to $\\frac{2}{3}$" 13194139533478 17592186045585 true] [17592186399540 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399540 1084 #uuid "ad3cf5dc-1a5e-5ca5-bb04-89cb5648d292" 13194139533478 17592186045585 true] [17592186399541 1081 "Converges to $-\\frac{2}{3}$" 13194139533478 17592186045585 true] [17592186399541 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399541 1084 #uuid "a6f4c2df-fdff-5c81-86c1-ed79a5590ca1" 13194139533478 17592186045585 true] [17592186399542 1081 "The sequence diverges" 13194139533478 17592186045585 true] [17592186399542 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399542 1084 #uuid "ee524a7c-b00b-54ff-b0db-1379d3f0eb87" 13194139533478 17592186045585 true] [17592186399543 1068 #edb/ref 17592186399544 13194139533478 17592186045585 true] [17592186399543 1069 "q-141539" 13194139533478 17592186045585 true] [17592186399543 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399543 1071 "If the expression ${x}^{2}+6x+14$ is written as $(x+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" 13194139533478 17592186045585 true] [17592186399543 1072 #uuid "bd1c73ef-6818-5b51-baee-cca065c2f0da" 13194139533478 17592186045585 true] [17592186399543 1074 "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x+14\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${3}^{2},$ writing the constant term $14$ last:\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-\\,{3}^{2}+14\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+3{)}^{2}-{3}^{2}+14\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+3{)}^{2}+5.\n$$\n\nTherefore, $p=3$ and $q=5.$" 13194139533478 17592186045585 true] [17592186399544 1075 #edb/ref 17592186399545 13194139533478 17592186045585 true] [17592186399544 1075 #edb/ref 17592186399546 13194139533478 17592186045585 true] [17592186399544 1075 #edb/ref 17592186399547 13194139533478 17592186045585 true] [17592186399544 1075 #edb/ref 17592186399548 13194139533478 17592186045585 true] [17592186399544 1075 #edb/ref 17592186399549 13194139533478 17592186045585 true] [17