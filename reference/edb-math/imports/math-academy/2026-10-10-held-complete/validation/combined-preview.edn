0 \\\\ 2 & 0 & 2\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404285 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404285 1084 #uuid "1184eb62-ac2c-5e6b-abd1-f1c4d51d39b0" 13194139533478 17592186045585 true] [17592186404286 1068 #edb/ref 17592186404287 13194139533478 17592186045585 true] [17592186404286 1069 "q-83854" 13194139533478 17592186045585 true] [17592186404286 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186404286 1071 "$$\nA=[\\begin{aligned}2 & 0 & -2 \\\\ 6 & -1 & -10 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\n \nThe matrix $A$ has eigenvalues ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=-1,$ and ${\\lambda }_{3}=2.$\nFind a diagonal matrix $D$ and an invertible matrix $P$ such that $A=PD{P}^{-1}.$" 13194139533478 17592186045585 true] [17592186404286 1072 #uuid "303c15f5-3e83-55c0-a519-b60eaa51efba" 13194139533478 17592186045585 true] [17592186404286 1074 "We apply the diagonalization algorithm.\n\n**Step 1.**  Notice that we are already given the eigenvalues of the matrix: \n\n$\\,$ ${\\lambda }_{1}=1,\\,$ ${\\lambda }_{2}=-1,\\,$ ${\\lambda }_{3}=2.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ Applying our usual method, we find the following.\n\n- For ${\\lambda }_{1}=1,$ we get\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}1 & 0 & -2 \\\\ 6 & -2 & -10 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives us the eigenvector ${v}_{1}=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=-1,$ we get\n\n$$\n\\begin{aligned}A-(-1)I & =[\\begin{aligned}3 & 0 & -2 \\\\ 6 & 0 & -10 \\\\ 0 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-1)I)x=0$ gives us the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{3}=2,$ we get\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}0 & 0 & -2 \\\\ 6 & -3 & -10 \\\\ 0 & 0 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives us the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}],\\,P=[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 2 \\\\ 1 & 0 & 0\\end{aligned}]\n$$" 13194139533478 17592186045585 true] [17592186404287 1075 #edb/ref 17592186404288 13194139533478 17592186045585 true] [17592186404287 1075 #edb/ref 17592186404289 13194139533478 17592186045585 true] [17592186404287 1075 #edb/ref 17592186404290 13194139533478 17592186045585 true] [17592186404287 1075 #edb/ref 17592186404291 13194139533478 17592186045585 true] [17592186404287 1075 #edb/ref 17592186404292 13194139533478 17592186045585 true] [17592186404287 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186404287 1077 "selection" 13194139533478 17592186045585 true] [17592186404287 1079 #edb/ref 17592186404290 13194139533478 17592186045585 true] [17592186404287 1080 #uuid "e147ba3d-c970-55a9-ac96-8187378e9cae" 13194139533478 17592186045585 true] [17592186404288 1081 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}2 & 1 & 1 \\\\ 1 & 2 & 2 \\\\ 1 & 3 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404288 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404288 1084 #uuid "91c8360c-3a50-5dde-b1bc-982c3982cc9e" 13194139533478 17592186045585 true] [17592186404289 1081 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}1 & 0 & 1 \\\\ 1 & -1 & 2 \\\\ 1 & 1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404289 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404289 1084 #uuid "f6699882-8461-5d24-9c25-bf00717bab1d" 13194139533478 17592186045585 true] [17592186404290 1081 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 2 \\\\ 1 & 0 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404290 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404290 1084 #uuid "e9b4c43c-1866-559f-80a2-eb60c22ddff9" 13194139533478 17592186045585 true] [17592186404291 1081 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}-1 & 0 & 1 \\\\ 1 & -1 & 2 \\\\ 1 & -1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404291 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404291 1084 #uuid "77ed7e08-d0f9-52c5-bb87-4330aef31eed" 13194139533478 17592186045585 true] [17592186404292 1081 "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}1 & 0 & 1 \\\\ 1 & 0 & 2 \\\\ -1 & 0 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404292 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404292 1084 #uuid "4129fe51-c35a-5376-82e4-222db49da083" 13194139533478 17592186045585 true] [17592186404293 1068 #edb/ref 17592186404294 13194139533478 17592186045585 true] [17592186404293 1069 "q-83860" 13194139533478 17592186045585 true] [17592186404293 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186404293 1071 "$$\nA=[\\begin{aligned}5 & -6 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 2 & -2\\end{aligned}]\n$$\n\n \nThe matrix $A$ has eigenvalues ${\\lambda }_{1}=2,$ ${\\lambda }_{2}=-2,$ and ${\\lambda }_{3}=5.$\nFind a diagonal matrix $D$ and an invertible matrix $P$ such that $A=PD{P}^{-1}.$" 13194139533478 17592186045585 true] [17592186404293 1072 #uuid "497d051f-d1fb-59f1-b865-99c679ab4f76" 13194139533478 17592186045585 true] [17592186404293 1074 "We apply the diagonalization algorithm.\n\n**Step 1.**  Notice that we are already given the eigenvalues of the matrix: \n\n$\\,$ ${\\lambda }_{1}=2,\\,$ ${\\lambda }_{2}=-2,\\,$ ${\\lambda }_{3}=5.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ Applying our usual method, we find the following.\n\n- For ${\\lambda }_{1}=2,$ we get\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}3 & -6 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 2 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives us the eigenverctor ${v}_{1}=[\\begin{aligned}4 \\\\ 2 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=-2,$ we get\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}7 & -6 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 2 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives us the eigenverctor ${v}_{2}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{3}=5,$ we get\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}0 & -6 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 2 & -7\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives us the eigenverctor ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 5\\end{aligned}],\\,P=[\\begin{aligned}4 & 0 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 1 & 0\\end{aligned}]\n$$" 13194139533478 17592186045585 true] [17592186404294 1075 #edb/ref 17592186404295 13194139533478 17592186045585 true] [17592186404294 1075 #edb/ref 17592186404296 13194139533478 17592186045585 true] [17592186404294 1075 #edb/ref 17592186404297 13194139533478 17592186045585 true] [17592186404294 1075 #edb/ref 17592186404298 13194139533478 17592186045585 true] [17592186404294 1075 #edb/ref 17592186404299 13194139533478 17592186045585 true] [17592186404294 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186404294 1077 "selection" 13194139533478 17592186045585 true] [17592186404294 1079 #edb/ref 17592186404295 13194139533478 17592186045585 true] [17592186404294 1080 #uuid "99303798-a587-5408-b480-605526c75a44" 13194139533478 17592186045585 true] [17592186404295 1081 "$D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}4 & 0 & 1 \\\\ 2 & 0 & 0 \\\\ 1 & 1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404295 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404295 1084 #uuid "a9c721ea-d96e-5bf0-bc9c-8798a2a4ddf0" 13194139533478 17592186045585 true] [17592186404296 1081 "$D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}1 & 0 & 1 \\\\ -2 & 0 & 0 \\\\ 1 & -1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404296 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404296 1084 #uuid "4f82210a-e608-50a1-bf42-9e7411d614b4" 13194139533478 17592186045585 true] [17592186404297 1081 "$D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}2 & 0 & 1 \\\\ 2 & 1 & 0 \\\\ 1 & -1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404297 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404297 1084 #uuid "94c87bfa-134c-55bd-87ae-8cfa1aedb050" 13194139533478 17592186045585 true] [17592186404298 1081 "$D=[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}4 & 0 & 1 \\\\ -2 & 0 & 0 \\\\ -1 & -1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404298 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404298 1084 #uuid "b8e1ec20-80aa-55b5-9af6-1c4b410f8f8a" 13194139533478 17592186045585 true] [17592186404299 1081 "$D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 5\\end{aligned}]$ and $P=[\\begin{aligned}4 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 1 & 1 & 0\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186404299 108