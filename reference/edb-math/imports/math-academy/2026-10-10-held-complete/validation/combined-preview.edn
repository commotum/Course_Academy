,-1,5⟩ \\\\  & =⟨t,\\,-t,\\,5t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PQ=3\\sqrt{3},$ we get:\n\n$$\n\\begin{aligned}PQ & =3\\sqrt{3} \\\\ |\\overset{\\to }{PQ}| & =3\\sqrt{3} \\\\ |⟨t,\\,-t,\\,5t⟩| & =3\\sqrt{3} \\\\ \\sqrt{{t}^{2}+(-t)^{2}+(5t)^{2}} & =3\\sqrt{3} \\\\ \\sqrt{27{t}^{2}} & =3\\sqrt{3} \\\\ \\pm 3\\sqrt{3}t & =3\\sqrt{3} \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{Q}_{1}}=⟨1,1,1⟩+⟨1,-1,5⟩=⟨2,0,6⟩, \\\\  & \\overset{\\to }{O{Q}_{2}}=⟨1,1,1⟩-⟨1,-1,5⟩=⟨0,2,-4⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${Q}_{1}(2,0,6)$ and ${Q}_{2}(0,2,-4).$" 13194139533478 17592186045585 true] [17592186403878 1075 #edb/ref 17592186403879 13194139533478 17592186045585 true] [17592186403878 1075 #edb/ref 17592186403880 13194139533478 17592186045585 true] [17592186403878 1075 #edb/ref 17592186403881 13194139533478 17592186045585 true] [17592186403878 1075 #edb/ref 17592186403882 13194139533478 17592186045585 true] [17592186403878 1075 #edb/ref 17592186403883 13194139533478 17592186045585 true] [17592186403878 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403878 1077 "selection" 13194139533478 17592186045585 true] [17592186403878 1079 #edb/ref 17592186403881 13194139533478 17592186045585 true] [17592186403878 1080 #uuid "4e8713f5-ca93-55c6-99f3-5140f5065e48" 13194139533478 17592186045585 true] [17592186403879 1081 "${Q}_{1}(6,2,2)$ and ${Q}_{2}(1,0,-2)$" 13194139533478 17592186045585 true] [17592186403879 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403879 1084 #uuid "d2d05b78-acf4-5f5e-a4a5-a47b385be2af" 13194139533478 17592186045585 true] [17592186403880 1081 "${Q}_{1}(4,2,6)$ and ${Q}_{2}(1,0,2)$" 13194139533478 17592186045585 true] [17592186403880 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403880 1084 #uuid "e86a9368-3e01-579c-a45b-27cec0740826" 131941395