9533478 17592186045585 true] [17592186403529 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186403529 1071 "What is the projection of the intersection between the sphere $(x-1)^{2}+(y-6)^{2}+{z}^{2}=17$ and the plane $y=5$ onto the $xz$-plane." 13194139533478 17592186045585 true] [17592186403529 1072 #uuid "6d8b4045-9642-5938-bbc6-e68bf8139eaf" 13194139533478 17592186045585 true] [17592186403529 1074 "To find the intersection of the sphere and the plane $y=5$, we substitute $y=5$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(x-1)^{2}+(5-6)^{2}+{z}^{2} & =17 \\\\ (x-1)^{2}+1+{z}^{2} & =17 \\\\ (x-1)^{2}+{z}^{2} & =16 \\\\ (x-1)^{2}+{z}^{2} & ={4}^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xz$-plane gives us the equation of the circle of radius $4$ centered at $(1,0).$" 13194139533478 17592186045585 true] [17592186403530 1075 #edb/ref 17592186403531 13194139533478 17592186045585 true] [17592186403530 1075 #edb/ref 17592186403532 13194139533478 17592186045585 true] [17592186403530 1075 #edb/ref 17592186403533 13194139533478 17592186045585 true] [17592186403530 1075 #edb/ref 17592186403534 13194139533478 17592186045585 true] [17592186403530 1075 #edb/ref 17592186403535 13194139533478 17592186045585 true] [17592186403530 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403530 1077 "selection" 13194139533478 17592186045585 true] [17592186403530 1079 #edb/ref 17592186403532 13194139533478 17592186045585 true] [17592186403530 1080 #uuid "c4f59e4b-4277-5493-8d81-a85578c12018" 13194139533478 17592186045585 true] [17592186403531 1081 "The circle of radius $16$ centered at $(-1,0)$" 13194139533478 17592186045585 true] [17592186403531 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403531 1084 #uuid "70e9bd71-5d88-5167-90c2-169b49327300" 13194139533478 17592186045585 true] [17592186403532 1081 "The circle of radius $4$ centered at $(1,0)$" 13194139533478 17592186045585 true] [17592186403532 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403532 1084 #uuid "23f8b5ef-a6d7-5886-b4e8-fde2fff6e26e" 13194139533478 17592186045585 true] [17592186403533 1081 "The circle of radius $4$ centered at $(-1,0)$" 13194139533478 17592186045585 true] [17592186403533 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403533 1084 #uuid "21d82f56-9813-5d47-8969-ee3b39871961" 13194139533478 17592186045585 true] [17592186403534 1081 "The circle of radius $\\sqrt{17}$ centered at $(1,0)$" 13194139533478 17592186045585 true] [17592186403534 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403534 1084 #uuid "c2da5d34-ebd9-5b2f-ba20-8c77a7870bb9" 13194139533478 17592186045585 true] [17592186403535 1081 "The circle of radius $16$ centered at $(1,0)$" 13194139533478 17592186045585 true] [17592186403535 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403535 1084 #uuid "331daaa1-32e0-5fc0-ab96-15e14ef79e5b" 13194139533478 17592186045585 true] [17592186403536 1068 #edb/ref 17592186403537 13194139533478 17592186045585 true] [17592186403536 1069 "q-7198" 13194139533478 17592186045585 true] [17592186403536 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186403536 1071 "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=4-{t}^{2}$, where $t>0$ is the time  in seconds. If the particle has velocity $v=0\\,\\text{m}/\\text{s}$ when $t=0\\,\\text{s},$ calculate the maximum velocity ${v}_{\\text{max}}$ of the particle and determine the time when the particle reaches its maximum velocity." 13194139533478 17592186045585 true] [17592186403536 1072 #uuid "7d8d60fa-c7ba-5ca6-b3f7-54964544ab73" 13194139533478 17592186045585 true] [17592186403536 1074 "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 4-{t}^{2} & =0 \\\\ (2-t)(2+t) & =0 \\\\ t & =\\pm 2.\\end{aligned}\n$$\n\nSince $t⩾0$, the extremum of the velocity function occurs when $t=2\\,\\text{s}.$\n\nWe now test the extreme value using the second derivative test. For this, we find the second derivative of $v(t)$ and evaluate it at $t=2:$\n\n$$\n\\begin{aligned}{v}^{″}(t) & =\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\text{d}v}{\\text{d}t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4-{t}^{2}) \\\\  & =-2t \\\\ {v}^{″}(2) & =-2(2) \\\\  & =-4.\\end{aligned}\n$$\n\nSince ${v}^{″}(2)<0,$ we conclude that the velocity is maximized when $t=2\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (4-{t}^{2})\\text{d}t \\\\  & =4t-\\frac{1}{3}{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}4(0)-\\frac{1}{3}(0)^{3}+C & =0 \\\\ 0+0+C & =0\\,⟹\\,C=0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=4t-\\frac{1}{3}{t}^{3}.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(2)=4(2)-\\frac{1}{3}(2)^{3}=\\frac{16}{3}\\,\\text{m}/\\text{s}\n$$" 13194139533478 17592186045585 true] [17592186403537 1075 #edb/ref 17592186403538 13194139533478 17592186045585 true] [17592186403537 1075 #edb/ref 17592186403539 13194139533478 17592186045585 true] [17592186403537 1075 #edb/ref 17592186403540 13194139533478 17592186045585 true] [17592186403537 1075 #edb/ref 17592186403541 13194139533478 17592186045585 true] [17592186403537 1075 #edb/ref 17592186403542 13194139533478 17592186045585 true] [17592186403537 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403537 1077 "selection" 13194139533478 17592186045585 true] [17592186403537 1079 #edb/ref 17592186403540 13194139533478 17592186045585 true] [17592186403537 1080 #uuid "bd14f339-50c3-5beb-8aed-1f210e3779d7" 13194139533478 17592186045585 true] [17592186403538 1081 "{v}_{\\text{max}}=\\frac{11}{3}\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" 13194139533478 17592186045585 true] [17592186403538 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403538 1084 #uuid "0b7d9784-51cb-5675-943a-e002b0417fca" 13194139533478 17592186045585 true] [17592186403539 1081 "{v}_{\\text{max}}=\\frac{1}{3}\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" 13194139533478 17592186045585 true] [17592186403539 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403539 1084 #uuid "5c704de0-ab59-544f-b275-85951ebf037c" 13194139533478 17592186045585 true] [17592186403540 1081 "{v}_{\\text{max}}=\\frac{16}{3}\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}" 13194139533478 17592186045585 true] [17592186403540 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403540 1084 #uuid "0127ae0d-4430-5280-a82f-625a311710c8" 13194139533478 17592186045585 true] [17592186403541 1081 "{v}_{\\text{max}}=\\frac{14}{3}\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}" 13194139533478 17592186045585 true] [17592186403541 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403541 1084 #uuid "7f4ceae1-9caf-50f8-bf8b-aedf205ec7d9" 13194139533478 17592186045585 true] [17592186403542 1081 "{v}_{\\text{max}}=\\frac{8}{3}\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}" 13194139533478 17592186045585 true] [17592186403542 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403542 1084 #uuid "76ad20db-ee5e-5f32-b5be-14cbb55e6f65" 13194139533478 17592186045585 true] [17592186403543 1068 #edb/ref 17592186403544 13194139533478 17592186045585 true] [17592186403543 1069 "q-7217" 13194139533478 17592186045585 true] [17592186403543 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186403543 1071 "The velocity $v$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\nv=⟨t(3t-2),\\,8{t}^{3}⟩.\n$$\n\nGiven that the particle is at the position $(30,90)$ when $t=3,$ calculate the position vector of $P$ at time $t.$" 13194139533478 17592186045585 true] [17592186403543 1072 #uuid "4e1070d0-6a3b-5c88-bdfe-23bfbc7b2d02" 13194139533478 17592186045585 true] [17592186403543 1074 "To compute the position vector, we need to integrate the velocity vector:\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨t(3t-2),\\,8{t}^{3}⟩\\,\\text{d}t \\\\  & =⟨\\int t(3t-2)\\,\\text{d}t,\\,\\int 8{t}^{3}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}-{t}^{2}+{C}_{1},\\,2{t}^{4}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(3)=⟨30,90⟩.$ Substituting $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨(3)^{3}-(3)^{2}+{C}_{1},\\,2(3)^{4}+{C}_{2}⟩ \\\\ ⟨30,90⟩ & =⟨18+{C}_{1},162+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=12$ and ${C}_{2}=-72.$ Therefore, the position vector is\n\n$$\nr(t)=⟨{t}^{3}-{t}^{2}+12,\\,2{t}^{4}-72⟩.\n$$" 13194139533478 17592186045585 true] [17592186403544 1075 #edb/ref 17592186403545 13194139533478 17592186045585 true] [17592186403544 1075 #edb/ref 17592186403546 13194139533478 17592186045585 true] [17592186403544 1075 #edb/ref 17592186403547 13194139533478 17592186045585 true] [17592186403544 1075 #edb/ref 17592186403548 13194139533478 17592186045585 true] [17592186403544 1075 #edb/ref 17592186403549 13194139533478 17592186045585 true] [17592186403544 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403544 1077 "selection" 13194139533478 17592186045585 true] [17592186403544 1079 #edb/ref 17592186403549 13194139533478 17592186045585 true] [17592186403544 1080 #uuid "a072aa51-1711-5bcb-b3f7-621b3a6f46ec"