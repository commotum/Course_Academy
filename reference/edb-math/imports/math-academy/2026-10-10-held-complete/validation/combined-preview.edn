533478 17592186045585 true] [17592186402986 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186402986 1084 #uuid "7bd5037d-c800-5b92-94d5-bf8378100f05" 13194139533478 17592186045585 true] [17592186402987 1081 "4x{3}^{2{x}^{2}}" 13194139533478 17592186045585 true] [17592186402987 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186402987 1084 #uuid "bc15acd8-2e05-54df-824b-49b27e8976d4" 13194139533478 17592186045585 true] [17592186402988 1081 "2x{3}^{2{x}^{2}}" 13194139533478 17592186045585 true] [17592186402988 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186402988 1084 #uuid "c86614c3-2ff7-5322-a6c3-9ce930da4214" 13194139533478 17592186045585 true] [17592186402989 1081 "2\\cdot {3}^{2x}\\operatorname{ln}⁡(3)" 13194139533478 17592186045585 true] [17592186402989 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186402989 1084 #uuid "098f7a16-97a6-5c7b-bd17-6d5da322792f" 13194139533478 17592186045585 true] [17592186402990 1068 #edb/ref 17592186402991 13194139533478 17592186045585 true] [17592186402990 1069 "q-48611" 13194139533478 17592186045585 true] [17592186402990 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186402990 1071 "A cup of coffee sitting on a teacher's desk $t$ minutes after it has been made has the temperature $F(t)$ degrees Fahrenheit. What are the units of $\\frac{\\text{d}F}{\\text{d}t}?$" 13194139533478 17592186045585 true] [17592186402990 1072 #uuid "453a4f9f-dc2c-5ef4-9ab6-f86f7acd693b" 13194139533478 17592186045585 true] [17592186402990 1074 "We have that the temperature $F(t)$ is measured in degrees Fahrenheit and the time is measured in minutes. \n\n$$\n\\begin{aligned}F(t): & \\text{degrees Fahrenheit} \\\\ t: & \\text{minutes}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}F}{\\text{d}t}$ measures a change in $F(t)$ over a change in $t.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}F}{\\text{d}t}: & \\frac{\\text{degrees Fahrenheit}}{\\text{minutes}}\\end{aligned}\n$$\n\nTherefore, $\\frac{\\text{d}F}{\\text{d}t}$ is measured in \"degrees Fahrenheit per minute\"." 13194139533478 17592186045585 true] [17592186402991 1075 #edb/ref 17592186402992 13194139533478 17592186045585 true] [17592186402991 1075 #edb/ref 17592186402993 13194139533478 17592186045585 true] [17592186402991 1075 #edb/ref 17592186402994 13194139533478 17592186045585 true] [17592186402991 1075 #edb/ref 17592186402995 13194139533478 17592186045585 true] [17592186402991 1075 #edb/ref 17592186402996 13194139533478 17592186045585 true] [17592186402991 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186402991 1077 "selection" 13194139533478 17592186045585 true] [17592186402991 1079 #edb/ref 17592186402992 13194139533478 17592186045585 true] [17592186402991 1080 #uuid "ad3df16f-9c93-57df-88a3-0c0fe3164587" 13194139533478 17592186045585 true] [17592186402992 1081 "Degrees Fahrenheit per minute" 13194139533478 17592186045585 true] [17592186402992 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402992 1084 #uuid "edec9b0f-e74f-5f71-8e01-c49ef9dcd993" 13194139533478 17592186045585 true] [17592186402993 1081 "Degrees Fahrenheit" 13194139533478 17592186045585 true] [17592186402993 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402993 1084 #uuid "f6d4c614-ec2d-5d40-969c-a53c3dd207e0" 13194139533478 17592186045585 true] [17592186402994 1081 "Minutes per degrees Fahrenheit" 13194139533478 17592186045585 true] [17592186402994 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402994 1084 #uuid "4ec8af8b-c1c2-588d-b21b-584e7bda5fb3" 13194139533478 17592186045585 true] [17592186402995 1081 "Minutes" 13194139533478 17592186045585 true] [17592186402995 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402995 1084 #uuid "c8dada28-2d89-5b17-8652-6cc73bf5852f" 13194139533478 17592186045585 true] [17592186402996 1081 "Degrees Fahrenheit squared per minute" 13194139533478 17592186045585 true] [17592186402996 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402996 1084 #uuid "9dc2b148-ac18-514b-b0ae-11c7d6164436" 13194139533478 17592186045585 true] [17592186402997 1068 #edb/ref 17592186402998 13194139533478 17592186045585 true] [17592186402997 1069 "q-48860" 13194139533478 17592186045585 true] [17592186402997 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186402997 1071 "![](images/61/61b89de34a6900d2ea39e5c2af141b3353e9ca790ac2748d0fc6d4d578127f93.png)\n\nFind the values of $x$ for which the function $f(x)=x\\operatorname{ln}⁡x$ (plotted above) is strictly increasing." 13194139533478 17592186045585 true] [17592186402997 1072 #uuid "680534fd-cbc6-5a80-9a00-31c6d6540a49" 13194139533478 17592186045585 true] [17592186402997 1074 "The function is strictly increasing where ${f}^{′}(x)>0.$ Differentiating $f(x)$ using the product  rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =1\\cdot \\operatorname{ln}⁡x+\\frac{1}{x}\\cdot x \\\\  & =\\operatorname{ln}⁡x+1,\\end{aligned}\n$$\n\nso we need to solve the inequality\n\n$$\n\\operatorname{ln}⁡x+1>0.\n$$\n\nSolving $\\operatorname{ln}⁡x=-1$ gives the critical point\n\n$$\nx={e}^{-1}\\,⟹\\,x=\\frac{1}{e}.\n$$\n\nFrom the graph, we see that this critical point is a minimum. We also see that the slope of the tangent lines is negative to the left of the critical point and positive to the right of the critical point. \n\nSo, we summarize the sign of the derivative in the following table:\n\n$$\n\\left.\\begin{aligned}x & (0,\\frac{1}{e}) & \\frac{1}{e} & (\\frac{1}{e},\\infty ) \\\\ f & ↘ & \\text{min} & ↗ \\\\ {f}^{′} & - & 0 & +\\end{aligned}\\right|\n$$\n\nFinally, we conclude that the function is strictly increasing on the interval $(\\frac{1}{e},\\infty ).$" 13194139533478 17592186045585 true] [17592186402998 1075 #edb/ref 17592186402999 13194139533478 1759218