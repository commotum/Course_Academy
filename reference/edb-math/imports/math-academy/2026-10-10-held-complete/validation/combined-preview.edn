^{‴}(0)}{3!}{x}^{3}+⋯.\n$$\n\nComputing the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\pi \\operatorname{cos}⁡(\\pi x) \\\\ f(0) & =\\pi \\cdot \\operatorname{cos}⁡(0)=\\pi  \\\\ {f}^{′}(x) & =-{\\pi }^{2}\\operatorname{sin}⁡(\\pi x) \\\\ {f}^{′}(0) & =-{\\pi }^{2}\\cdot \\operatorname{sin}⁡(0)=0 \\\\ {f}^{″}(x) & =-{\\pi }^{3}\\operatorname{cos}⁡(\\pi x) \\\\ {f}^{″}(0) & =-{\\pi }^{3}\\cdot \\operatorname{cos}⁡(0)=-{\\pi }^{3}.\\end{aligned}\n$$\n\nTherefore, the Maclaurin expansion is\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡x & =(\\pi )+(0)x+\\frac{(-{\\pi }^{3})}{2!}{x}^{2}+⋯ \\\\  & =\\pi -\\frac{{\\pi }^{3}{x}^{2}}{2}+⋯.\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186400149 1075 #edb/ref 17592186400150 13194139533478 17592186045585 true] [17592186400149 1075 #edb/ref 17592186400151 13194139533478 17592186045585 true] [17592186400149 1075 #edb/ref 17592186400152 13194139533478 17592186045585 true] [17592186400149 1075 #edb/ref 17592186400153 13194139533478 17592186045585 true] [17592186400149 1075 #edb/ref 17592186400154 13194139533478 17592186045585 true] [17592186400149 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186400149 1077 "selection" 13194139533478 17592186045585 true] [17592186400149 1079 #edb/ref 17592186400154 13194139533478 17592186045585 true] [17592186400149 1080 #uuid "ef8d0ae9-e31c-5d1b-b262-de920c86f6a9" 13194139533478 17592186045585 true] [17592186400150 1081 "\\pi \\operatorname{cos}⁡(\\pi x)=\\pi -\\frac{\\pi {x}^{2}}{3}+⋯" 13194139533478 17592186045585 true] [17592186400150 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186400150 1084 #uuid "5d224097-fffa-5001-990d-f9a28a04bed5" 13194139533478 17592186045585 true] [17592186400151 1081 "\\pi \\operatorname{cos}⁡(\\pi x)=1-\\frac{{\\pi }^{2}{x}^{2}}{2}+⋯" 13194139533478 17592186045585 true] [17592186400151 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186400151 1084 #uuid "2e3a