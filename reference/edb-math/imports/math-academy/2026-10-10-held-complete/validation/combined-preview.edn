 & 0 & 0\\end{aligned}]{[\\begin{aligned}-1 & -2 & 1 \\\\ 2 & -3 & 2 \\\\ 1 & 2 & 13\\end{aligned}]}^{-1}.\n$$\n\nIn conclusion, we get $a=2,$ $b=13,$ and $c=3.$" 13194139533478 17592186045585 true] [17592186404315 1075 #edb/ref 17592186404316 13194139533478 17592186045585 true] [17592186404315 1075 #edb/ref 17592186404317 13194139533478 17592186045585 true] [17592186404315 1075 #edb/ref 17592186404318 13194139533478 17592186045585 true] [17592186404315 1075 #edb/ref 17592186404319 13194139533478 17592186045585 true] [17592186404315 1075 #edb/ref 17592186404320 13194139533478 17592186045585 true] [17592186404315 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186404315 1077 "selection" 13194139533478 17592186045585 true] [17592186404315 1079 #edb/ref 17592186404318 13194139533478 17592186045585 true] [17592186404315 1080 #uuid "8345e678-341d-5cbb-a53f-7923d2b2c4f1" 13194139533478 17592186045585 true] [17592186404316 1081 "$a=2,$ $b=3,$ and $c=13$" 13194139533478 17592186045585 true] [17592186404316 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404316 1084 #uuid "e82133f4-cf40-52df-89fc-b9095a2ed393" 13194139533478 17592186045585 true] [17592186404317 1081 "$a=-2,$ $b=13,$ and $c=3$" 13194139533478 17592186045585 true] [17592186404317 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404317 1084 #uuid "243d60de-8290-5d22-a02c-f2dd575ecea1" 13194139533478 17592186045585 true] [17592186404318 1081 "$a=2,$ $b=13,$ and $c=3$" 13194139533478 17592186045585 true] [17592186404318 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404318 1084 #uuid "3f2cbf42-1425-51b3-9612-2bbf89e799f3" 13194139533478 17592186045585 true] [17592186404319 1081 "$a=2,$ $b=-3,$ and $c=0$" 13194139533478 17592186045585 true] [17592186404319 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186404319 1084 #uuid "f5be6a6c-ff71-53df-b6a3-b84c12d5df62" 13194139533478 17592186045585 