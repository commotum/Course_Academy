478 17592186045585 true] [17592186403224 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403224 1084 #uuid "0415b469-b139-5e1a-a412-34227a3897af" 13194139533478 17592186045585 true] [17592186403225 1081 "I and III only" 13194139533478 17592186045585 true] [17592186403225 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403225 1084 #uuid "23feee12-2b3b-5956-a66b-2f5a51f37208" 13194139533478 17592186045585 true] [17592186403226 1081 "III only" 13194139533478 17592186045585 true] [17592186403226 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403226 1084 #uuid "d3754b87-9f75-54d9-9a94-d542f1aaa946" 13194139533478 17592186045585 true] [17592186403227 1081 "None" 13194139533478 17592186045585 true] [17592186403227 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403227 1084 #uuid "4215ac44-f44e-59a5-8b63-fb6307287e01" 13194139533478 17592186045585 true] [17592186403228 1081 "II only" 13194139533478 17592186045585 true] [17592186403228 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403228 1084 #uuid "46e2afd4-b53a-541a-99a5-3d5382aea9b5" 13194139533478 17592186045585 true] [17592186403229 1068 #edb/ref 17592186403230 13194139533478 17592186045585 true] [17592186403229 1069 "q-66005" 13194139533478 17592186045585 true] [17592186403229 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186403229 1071 "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $4\\operatorname{csc}⁡x+1=\\operatorname{csc}⁡x$\nII. $\\operatorname{csc}⁡x+10=2\\operatorname{csc}⁡x$\nIII. $\\operatorname{csc}⁡x=2\\operatorname{csc}⁡x-6$" 13194139533478 17592186045585 true] [17592186403229 1072 #uuid "28fa7313-ebe9-5114-aa43-a48667cbf78a" 13194139533478 17592186045585 true] [17592186403229 1074 "We first simplify the given equations, and get\n\n- $\\operatorname{csc}⁡x=-\\frac{1}{3}$\n- $\\operatorname{csc}⁡x=10$\n- $\\operatorname{csc}⁡x=6$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions." 13194139533478 17592186045585 true] [17592186403230 1075 #edb/ref 17592186403231 13194139533478 17592186045585 true] [17592186403230 1075 #edb/ref 17592186403232 13194139533478 17592186045585 true] [17592186403230 1075 #edb/ref 17592186403233 13194139533478 17592186045585 true] [17592186403230 1075 #edb/ref 17592186403234 13194139533478 17592186045585 true] [17592186403230 1075 #edb/ref 17592186403235 13194139533478 17592186045585 true] [17592186403230 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403230 1077 "selection" 13194139533478 17592186045585 true] [17592186403230 1079 #edb/ref 17592186403233 13194139533478 17592186045585 true] [17592186403230 1080 #uuid "8ca79eb9-6a7d-56ad-a7b2-6517a75087f4" 13194139533478 17592186045585 true] [17592186403231 1081 "II and III only" 13194139533478 17592186045585 true] [17592186403231 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403231 1084 #uuid "36f640cb-1d0e-55cf-82bf-2bc2df4f2cbd" 13194139533478 17592186045585 true] [17592186403232 1081 "I and III only" 13194139533478 17592186045585 true] [17592186403232 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403232 1084 #uuid "2f4fdfad-f0bb-539a-b3dd-5135ecf4149a" 13194139533478 17592186045585 true] [17592186403233 1081 "I only" 13194139533478 17592186045585 true] [17592186403233 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403233 1084 #uuid "de09ab34-6244-5de9-adc0-7d2808c13ffa" 13194139533478 17592186045585 true] [17592186403234 1081 "III only" 13194139533478 17592186045585 true] [17592186403234 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403234 1084 #uuid "a347e69f-18e6-5a4a-896e-70ebdae9cbe6" 13194139533478 17592186045585 true] [17592186403235 1081 "II only" 13194139533478 17592186045585 true] [17592186403235 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403235 1084 #uuid "87a5d244-0e82-5176-9600-2dd50bb45515" 13194139533478 17592186045585 true] [17592186403236 1068 #edb/ref 17592186403237 13194139533478 17592186045585 true] [17592186403236 1069 "q-66435" 13194139533478 17592186045585 true] [17592186403236 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186403236 1071 "The equation ${x}^{2}+16x+164=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." 13194139533478 17592186045585 true] [17592186403236 1072 #uuid "f70143e0-3f9c-51d2-946d-0c2579968816" 13194139533478 17592186045585 true] [17592186403236 1074 "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+16x+164 & =0 \\\\ {x}^{2}+16x & =-164\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+16x & =-164 \\\\ {x}^{2}+2\\cdot 8x+{8}^{2}-{8}^{2} & =-164 \\\\ (x+8)^{2}-64 & =-164 \\\\ (x+8)^{2} & =-100\\end{aligned}\n$$\n\nTherefore, $p=8,\\,q=-100,$ and $p+q=-92.$\n\nWe now solve the equation using the square root method.\n\n$$\n\\begin{aligned}(x+8)^{2} & =-100 \\\\ x+8 & =\\pm \\sqrt{-100} \\\\ x+8 & =\\pm 10\\,\\text{i} \\\\ x & =-8\\pm 10\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-8+10\\,\\text{i}$ and $x=-8-10\\,\\text{i}.$" 13194139533478 17592186045585 true] [17592186403237 1075 #edb/ref 17592186403238 13194139533478 17592186045585 true] [17592186403237 1075 #edb/ref 17592186403239 13194139533478 17592186045585 true] [17592186403237 1075 #edb/ref 17592186403240 13194139533478 17592186045585 true] [17592186403237 1075 #edb/ref 17592186403241 13194139533478 17592186045585 true] [17592186403237 1075 #edb/ref 17592186403242 13194139533478 17592186045585 true] [17592186403237 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403237 1077 "selection" 13194139533478 17592186045585 true] [17592186403237 1079 #edb/ref 17592186403240 13194139533478 17592186045585 true] [17592186403237 1080 #uuid "042ad804-2249-5399-b919-45947b7e0d31" 13194139533478 17592186045585 true] [17592186403238 1081 "p+q=-108,\\,x=10\\pm 8\\,\\text{i}" 13194139533478 17592186045585 true] [17592186403238 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403238 1084 #uuid "8b7d8b31-ae04-5df6-aeb1-961f777e33b7" 13194139533478 17592186045585 true] [17592186403239 1081 "p+q=-108,\\,x=-8\\pm 10\\,\\text{i}" 13194139533478 17592186045585 true] [17592186403239 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403239 1084 #uuid "3477ce1f-9124-5c8e-aee7-0c19aaa37d5c" 13194139533478 17592186045585 true] [17592186403240 1081 "p+q=-92,\\,x=-8\\pm 10\\,\\text{i}" 13194139533478 17592186045585 true] [17592186403240 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403240 1084 #uuid "516e48e9-f368-58d1-b1c7-a413f32276d7" 13194139533478 17592186045585 true] [17592186403241 1081 "p+q=-92,\\,x=10\\pm 8\\,\\text{i}" 13194139533478 17592186045585 true] [17592186403241 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403241 1084 #uuid "cd9c6c12-d688-5f40-9928-9159b2b770a7" 13194139533478 17592186045585 true] [17592186403242 1081 "p+q=-92,\\,x=-8\\pm 8\\,\\text{i}" 13194139533478 17592186045585 true] [17592186403242 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403242 1084 #uuid "a06bc635-fc47-5897-92f1-2184d35dc008" 13194139533478 17592186045585 true] [17592186403243 1068 #edb/ref 17592186403244 13194139533478 17592186045585 true] [17592186403243 1069 "q-66508" 13194139533478 17592186045585 true] [17592186403243 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186403243 1071 "![](images/23/239490fd3be930412d4f67ff89244607a5019d91f201bc4e579410b5610a18ed.png)\n\nWhich of the graphs above correspond to an invertible function?" 13194139533478 17592186045585 true] [17592186403243 1072 #uuid "5b9771ce-36d1-5cb6-a7ee-84e40d892ce6" 13194139533478 17592186045585 true] [17592186403243 1074 "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\n![](images/c7/c728d173c13a1e7b3bcad0e9f0284c97f2ca075c795dcb1f38ed086c19cc0504.png)\n\nFrom the above, we see that: \n\n- For graphs I and IV, a horizontal line will intersect the curve at most once, no matter where we draw the line. Therefore, graphs I  and IV show one-to-one functions. This means that  these functions are invertible.\n\n- For graphs II and  III, some horizontal lines intersect the curve more than once. So, these are not one-to-one functions. As a result, they are not invertible." 13194139533478 17592186045585 true] [17592186403244 1075 #edb/ref 17592186403245 13194139533478 17592186045585 true] [17592186403244 1075 #edb/ref 17592186403246 13194139533478 17592186045585 true] [17592186403244 1075 #edb/ref 17592186403247 13194139533478 17592186045585 true] [17592186403244 1075 #edb/ref 17592186403248 13194139533478 17592186045585 true] [17592186403244 1075 #edb/ref 17592186403249 13194139533478 17592186045585 true] [17592186403244 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403244 1077 "selection" 13194139533478 17592186045585 true] [17592186403244 1079 #edb/ref 17592186403245 13194139533478 17592186045585 true] [17592186403244 1080 #uuid "85ad16e3-732f-5dec-b28a-7752a9983d6e" 13194139533478 17592186045585 true] [17592186403245 1081 "I and IV only" 13194139533478 17592186045585 true] [17592186403245 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403245 1084 #uuid "046ec56a-2154-55dd-81a9-19e9359e8a35" 13194139533478 17592186045585