1072 #uuid "8cbc83e7-bc89-5609-b94a-0fe1dfb1bde0" 13194139533478 17592186045585 true] [17592186402522 1074 "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that in each of the four given graphs, some horizontal lines intersect the curve more than once. Therefore, these are not one-to-one functions. As a result, none of them correspond to an invertible function." 13194139533478 17592186045585 true] [17592186402523 1075 #edb/ref 17592186402524 13194139533478 17592186045585 true] [17592186402523 1075 #edb/ref 17592186402525 13194139533478 17592186045585 true] [17592186402523 1075 #edb/ref 17592186402526 13194139533478 17592186045585 true] [17592186402523 1075 #edb/ref 17592186402527 13194139533478 17592186045585 true] [17592186402523 1075 #edb/ref 17592186402528 13194139533478 17592186045585 true] [17592186402523 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186402523 1077 "selection" 13194139533478 17592186045585 true] [17592186402523 1079 #edb/ref 17592186402526 13194139533478 17592186045585 true] [17592186402523 1080 #uuid "5ab0fae8-fb4f-560c-b176-a3a930105d51" 13194139533478 17592186045585 true] [17592186402524 1081 "I only" 13194139533478 17592186045585 true] [17592186402524 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402524 1084 #uuid "22d016a6-ae62-56e2-94ca-cf268596c630" 13194139533478 17592186045585 true] [17592186402525 1081 "III only" 13194139533478 17592186045585 true] [17592186402525 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402525 1084 #uuid "07a9ea11-bf6b-5bd3-bc0f-8446bc1bf4cd" 13194139533478 17592186045585 true] [17592186402526 1081 "None" 13194139533478 17592186045585 true] [17592186402526 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402526 1084 #uuid "89edd0ab-89db-5aea-aa06-1774d0033938" 13194139533478 1759