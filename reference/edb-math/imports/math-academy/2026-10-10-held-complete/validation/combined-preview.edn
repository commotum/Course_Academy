6045585 true] [17592186401578 1068 #edb/ref 17592186401579 13194139533478 17592186045585 true] [17592186401578 1069 "q-16645" 13194139533478 17592186045585 true] [17592186401578 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186401578 1071 "Calculate the points where the ellipse $\\frac{(x+1)^{2}}{25}+\\frac{(y-1)^{2}}{9}=1$ intercepts the $x$-axis." 13194139533478 17592186045585 true] [17592186401578 1072 #uuid "ba3205c4-c133-5ac7-861e-655b59a14526" 13194139533478 17592186045585 true] [17592186401578 1074 "To calculate the $x$-intercept, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+1)^{2}}{25}+\\frac{(y-1)^{2}}{9} & =1 \\\\ \\frac{(x+1)^{2}}{25}+\\frac{(0-1)^{2}}{9} & =1 \\\\ \\frac{(x+1)^{2}}{25}+\\frac{1}{9} & =1 \\\\ 9(x+1)^{2}+25 & =9\\cdot 25 \\\\ 9(x+1)^{2}+25 & =225 \\\\ 9(x+1)^{2} & =200 \\\\ (x+1)^{2} & =\\frac{200}{9} \\\\ x+1 & =\\pm \\sqrt{\\frac{200}{9}} \\\\ x & =-1\\pm \\frac{10\\sqrt{2}}{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the points $(-1-\\frac{10\\sqrt{2}}{3},0)$ and $(-1+\\frac{10\\sqrt{2}}{3},0).$" 13194139533478 17592186045585 true] [17592186401579 1075 #edb/ref 17592186401580 13194139533478 17592186045585 true] [17592186401579 1075 #edb/ref 17592186401581 13194139533478 17592186045585 true] [17592186401579 1075 #edb/ref 17592186401582 13194139533478 17592186045585 true] [17592186401579 1075 #edb/ref 17592186401583 13194139533478 17592186045585 true] [17592186401579 1075 #edb/ref 17592186401584 13194139533478 17592186045585 true] [17592186401579 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186401579 1077 "selection" 13194139533478 17592186045585 true] [17592186401579 1079 #edb/ref 17592186401582 13194139533478 17592186045585 true] [17592186401579 1080 #uuid "d58b31e7-b6c4-5d90-9a58-b8914d59f384" 13194139533478 17592186045585 true] [17592186401580 1081 "There is no $x$-intercept" 13194139533478 17592186045585 true] [17592186401580 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186401580 1084 #uuid "0e455adf-7973-5ee4-bb3c-0bd83316580a" 13194139533478 17592186045585 true] [17592186401581 1081 "(1\\pm \\frac{5\\sqrt{3}}{2},0)" 13194139533478 17592186045585 true] [17592186401581 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401581 1084 #uuid "d3568acd-90d7-5e24-95a2-7dddb6de4815" 13194139533478 17592186045585 true] [17592186401582 1081 "(-1\\pm \\frac{10\\sqrt{2}}{3},0)" 13194139533478 17592186045585 true] [17592186401582 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401582 1084 #uuid "d33bd951-6cf6-508d-8421-15a11016a317" 13194139533478 17592186045585 true] [17592186401583 1081 "(\\pm \\sqrt{5},0)" 13194139533478 17592186045585 true] [17592186401583 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401583 1084 #uuid "829db562-f4d5-5e31-b45c-b397742cb7e4" 13194139533478 17592186045585 true] [17592186401584 1081 "(1\\pm \\frac{10\\sqrt{2}}{3},0)" 13194139533478 17592186045585 true] [17592186401584 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401584 1084 #uuid "a69ed72a-53dd-5923-8c05-9efa0f54638b" 13194139533478 17592186045585 true] [17592186401585 1068 #edb/ref 17592186401586 13194139533478 17592186045585 true] [17592186401585 1069 "q-167165" 13194139533478 17592186045585 true] [17592186401585 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186401585 1071 "Find the global extrema of the function $f(x,y)=1-{x}^{2}+{y}^{2}$ on the closed region $D={(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 16}.$" 13194139533478 17592186045585 true] [17592186401585 1072 #uuid "e7d00266-1ded-5f4c-819a-7467528496c3" 13194139533478 17592186045585 true] [17592186401585 1074 "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ inside the region. \n\nTo determine the critical points, we solve ${f}^{′}=0.$ Computing the derivative gives\n\n$$\n{f}^{′}(x,y)=[\\begin{aligned}-2x,\\,2y\\end{aligned}].\n$$\n\nThe derivative exists at each point inside $D,$ and it equals zero when\n\n$$\n\\begin{aligned}{\\begin{aligned}-2x=0 \\\\ 2y=0\\end{aligned}\\,⟹\\,{\\begin{aligned}x=0 \\\\ y=0.\\end{aligned}\\end{aligned}\n$$\n\nThis gives us a single point $(0,0)\\in D,$ which we include in the list of candidates for the extrema.\n\n**Step 2.**  Find the points on the boundary of $D$ that could give rise to extreme values. \n\nTo find the boundary points that could give rise to extreme values, we parametrize the bounding circle ${x}^{2}+{y}^{2}=16.$ This gives\n\n$$\nr=⟨4\\operatorname{cos}⁡t,4\\operatorname{sin}⁡t⟩,\\,t\\in [0,2\\pi ).\n$$\n\nThe values of $f$ on the boundary are given by the function\n\n$$\n\\begin{aligned}F(t) & =f(x(t),y(t)) \\\\  & =f(4\\operatorname{cos}⁡t,4\\operatorname{sin}⁡t) \\\\  & =1-(4\\operatorname{cos}⁡t)^{2}+(4\\operatorname{sin}⁡t)^{2} \\\\  & =1-16{cos}^{2}⁡t+16{sin}^{2}⁡t \\\\  & =1-16\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTo find the critical points of $F(t)$ on the open interval $t\\in (0,2\\pi ),$ we solve the following equation:\n\n$$\n\\begin{aligned}{F}^{′}(t) & =0 \\\\ (1-16\\operatorname{cos}⁡2t)^{′} & =0 \\\\ 32\\operatorname{sin}⁡(2t) & =0 \\\\ \\operatorname{sin}⁡(2t) & =0\\end{aligned}\n$$\n\nThe final equation gives four solutions, namely\n\n$$\nt=\\frac{\\pi }{2},\\,\\pi ,\\,\\frac{3\\pi }{2}\\in (0,2\\pi ).\n$$\n\nWe also have to check the endpoint of the interval $t=0.$ Therefore, the only values of $t$ that can give rise to extreme values are \n\n$$\nt=0,\\,\\frac{\\pi }{2},\\,\\pi ,\\,\\frac{3\\pi }{2}.\n$$\n\nEvaluating the corresponding values of $x$ and $y$ on the boundary, we obtain four candidate points:\n\n$$\n(4,0),\\,(0,4),\\,(-4,0),\\,(0,-4)\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n| $(x,y)$ | $(0,0)$ | $(4,0)$ | $(0,4)$ | $(-4,0)$ | $(0,-4)$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x,y)$ | $1$ | $-15$ | $17$ | $-15$ | $17$ |\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-15$ at the points $(4,0)$ and $(-4,0),$ and\n\n- $f$ attains the global maximum of $17$ at the points $(0,4)$ and $(0,-4).$" 13194139533478 17592186045585 true] [17592186401586 1075 #edb/ref 17592186401587 13194139533478 17592186045585 true] [17592186401586 1075 #edb/ref 17592186401588 13194139533478 17592186045585 true] [17592186401586 1075 #edb/ref 17592186401589 13194139533478 17592186045585 true] [17592186401586 1075 #edb/ref 17592186401590 13194139533478 17592186045585 true] [17592186401586 1075 #edb/ref 17592186401591 13194139533478 17592186045585 true] [17592186401586 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186401586 1077 "selection" 13194139533478 17592186045585 true] [17592186401586 1079 #edb/ref 17592186401588 13194139533478 17592186045585 true] [17592186401586 1080 #uuid "bc59060d-a9ed-5533-b31b-311227554f8c" 13194139533478 17592186045585 true] [17592186401587 1081 "${f}_{min}=-3$ and  ${f}_{max}=15$" 13194139533478 17592186045585 true] [17592186401587 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186401587 1084 #uuid "7cd4c18b-e511-5b14-9f13-a5b4cb4f47f2" 13194139533478 17592186045585 true] [17592186401588 1081 "${f}_{min}=-15$ and  ${f}_{max}=17$" 13194139533478 17592186045585 true] [17592186401588 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186401588 1084 #uuid "2821ee27-e28a-5af2-b0bc-7da60bb40070" 13194139533478 17592186045585 true] [17592186401589 1081 "${f}_{min}=-15$ and  ${f}_{max}=1$" 13194139533478 17592186045585 true] [1759218640