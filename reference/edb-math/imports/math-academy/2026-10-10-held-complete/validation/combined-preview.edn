45585 true] [17592186402908 1074 "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the highest point is $D,$ and so this point represents the global maximum of $f(x).$ \n\n**Note:** The point $B$ is not a global maximum, it's a local maximum." 13194139533478 17592186045585 true] [17592186402909 1075 #edb/ref 17592186402910 13194139533478 17592186045585 true] [17592186402909 1075 #edb/ref 17592186402911 13194139533478 17592186045585 true] [17592186402909 1075 #edb/ref 17592186402912 13194139533478 17592186045585 true] [17592186402909 1075 #edb/ref 17592186402913 13194139533478 17592186045585 true] [17592186402909 1075 #edb/ref 17592186402914 13194139533478 17592186045585 true] [17592186402909 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186402909 1077 "selection" 13194139533478 17592186045585 true] [17592186402909 1079 #edb/ref 17592186402911 13194139533478 17592186045585 true] [17592186402909 1080 #uuid "e587e32b-f21e-545a-8ef6-e7a910ea785c" 13194139533478 17592186045585 true] [17592186402910 1081 "$A$ and $C$ only" 13194139533478 17592186045585 true] [17592186402910 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402910 1084 #uuid "b6390a69-73ca-5747-ad35-6ad1cc3e50ad" 13194139533478 17592186045585 true] [17592186402911 1081 "$D$ only" 13194139533478 17592186045585 true] [17592186402911 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402911 1084 #uuid "bf810803-9256-56b1-b55f-ffc26fa5e427" 13194139533478 17592186045585 true] [17592186402912 1081 "$B$ and $C$ only" 13194139533478 17592186045585 true] [17592186402912 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402912 1084 #uuid "6f3e8609-ca99-5684-877b-a0d89799e552" 13194139533478 17592186045585 true] [17592186402913 1081 "$C$ onl