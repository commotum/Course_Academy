94139533478 17592186045585 true] [17592186403973 1072 #uuid "b64247db-6208-5caa-b9cd-3324ac4191ed" 13194139533478 17592186045585 true] [17592186403973 1074 "First, notice that since $f(x)$ is twice-differentiable, the tangent line to the graph exists for all real $x.$\n\nInflection points occur when a graph changes concavity. In order for the graph to change concavity, the value of the second derivative ${f}^{″}(x)$ must switch signs. So, we are looking for points where the graph of ${f}^{″}(x)$ crosses the $x$-axis.\n\nWe can see that the graph $y={f}^{″}(x)$ crosses the $x$-axis at $x=1$ and $x=3.$\n\nTherefore, $f(x)$ has points of inflection at $x=1$ and $x=3.$" 13194139533478 17592186045585 true] [17592186403974 1075 #edb/ref 17592186403975 13194139533478 17592186045585 true] [17592186403974 1075 #edb/ref 17592186403976 13194139533478 17592186045585 true] [17592186403974 1075 #edb/ref 17592186403977 13194139533478 17592186045585 true] [17592186403974 1075 #edb/ref 17592186403978 13194139533478 17592186045585 true] [17592186403974 1075 #edb/ref 17592186403979 13194139533478 17592186045585 true] [17592186403974 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403974 1077 "selection" 13194139533478 17592186045585 true] [17592186403974 1079 #edb/ref 17592186403975 13194139533478 17592186045585 true] [17592186403974 1080 #uuid "c641f013-093d-5f3b-a9f4-c35aaff48baa" 13194139533478 17592186045585 true] [17592186403975 1081 "$x=1$ and $x=3$" 13194139533478 17592186045585 true] [17592186403975 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403975 1084 #uuid "3af905d7-78cb-583f-91a3-952928d02351" 13194139533478 17592186045585 true] [17592186403976 1081 "$x=-2,$ $x=1,$ and $x=3$" 13194139533478 17592186045585 true] [17592186403976 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403976 1084 #uuid "3fa213f3-196c-5248-a606-169ffea1b68e" 13194139533478 17592186045585 true] [17592186403977 1081 "$x=-