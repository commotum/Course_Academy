478 17592186045585 true] [17592186403127 1081 "{y}_{p}=2{x}^{2}{e}^{x}" 13194139533478 17592186045585 true] [17592186403127 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403127 1084 #uuid "d4e81942-358d-5aaf-a5f2-5e1f2ec31b30" 13194139533478 17592186045585 true] [17592186403128 1081 "{y}_{p}=x{e}^{x}" 13194139533478 17592186045585 true] [17592186403128 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403128 1084 #uuid "05bdb4b7-bec0-5820-a812-ddc518d8373b" 13194139533478 17592186045585 true] [17592186403129 1081 "{y}_{p}=5{x}^{2}{e}^{x}" 13194139533478 17592186045585 true] [17592186403129 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403129 1084 #uuid "977556d9-51ca-596c-9fa9-5b596de1cf76" 13194139533478 17592186045585 true] [17592186403130 1068 #edb/ref 17592186403131 13194139533478 17592186045585 true] [17592186403130 1069 "q-64285" 13194139533478 17592186045585 true] [17592186403130 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186403130 1071 "Given that the differential equation \n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-4\\frac{\\text{d}y}{\\text{d}x}-5y=-5x+6\n$$\n\nhas the complementary function ${y}_{c}(x)=A{e}^{5x}+B{e}^{-x}$, find the particular solution ${y}_{p}(x)$ to this equation." 13194139533478 17592186045585 true] [17592186403130 1072 #uuid "3d511e4f-8803-5021-b5c2-53a7b4de5acf" 13194139533478 17592186045585 true] [17592186403130 1074 "The right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular solution is also a polynomial of degree $1,$ i.e.\n\n$$\n{y}_{p}(x)=\\alpha x+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives:\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=\\alpha ,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{x}^{2}}=0\n$$\n\nTo find the values of $\\alpha ,$  and $\\beta ,$ we substitute the derivatives into the differential equation:\n\n$$\n0-4\\alpha -5(\\alpha x+\\beta )=-5x+6\n$$\n\nGrouping the terms on the left-hand side gives:\n\n$$\n-5\\alpha x+(-4\\alpha -5\\beta )=-5x+6\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}-5\\alpha =-5\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ -4\\alpha -5\\beta =6\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =1,\\,\\beta =-2.$\n\nTherefore, the particular integral ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=x-2.\n$$" 13194139533478 17592186045585 true] [17592186403131 1075 #edb/ref 17592186403132 13194139533478 17592186045585 true] [17592186403131 1075 #edb/ref 17592186403133 13194139533478 17592186045585 true] [17592186403131 1075 #edb/ref 17592186403134 13194139533478 17592186045585 true] [17592186403131 1075 #edb/ref 17592186403135 13194139533478 17592186045585 true] [17592186403131 1075 #edb/ref 17592186403136 13194139533478 17592186045585 true] [17592186403131 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403131 1077 "selection" 13194139533478 17592186045585 true] [17592186403131 1079 #edb/ref 17592186403135 13194139533478 17592186045585 true] [17592186403131 1080 #uuid "090c78d3-3a0c-5fa4-b1fc-517e968e51e7" 13194139533478 17592186045585 true] [17592186403132 1081 "{y}_{p}=\\frac{x}{5}-\\frac{2}{5}" 13194139533478 17592186045585 true] [17592186403132 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403132 1084 #uuid "d5720f24-4834-5f92-98ef-62d15aa34022" 13194139533478 17592186045585 true] [17592186403133 1081 "{y}_{p}=2x-10" 13194139533478 17592186045585 true] [17592186403133 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403133 1084 #uuid "94298549-9f11-59e3-9778-348dfb75c6dd" 13194139533478 17592186045585 true] [17592186403134 1081 "{y}_{p}=-x-\\frac{2}{5}" 13194139533