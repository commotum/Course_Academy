n{aligned}1 & 4 & -2 & -1 \\\\ -2 & -8 & 6 & 2 \\\\ 0 & 3 & -9 & 12\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 3 & -9 & 12\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 3 & -9 & 12\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 3 & -9 & 12 \\\\ 0 & 0 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we multiply the $2$nd row by $\\frac{1}{3}$ and the $3$rd row by $\\frac{1}{2}$ to get\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 3 & -9 & 12 \\\\ 0 & 0 & 2 & 0\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 1 & -3 & 4 \\\\ 0 & 0 & 2 & 0\\end{aligned}] & {R}_{3} & :=\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 1 & -3 & 4 \\\\ 0 & 0 & 1 & 0\\end{aligned}].\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186403661 1075 #edb/ref 17592186403662 13194139533478 17592186045585 true] [17592186403661 1075 #edb/ref 17592186403663 13194139533478 17592186045585 true] [17592186403661 1075 #edb/ref 17592186403664 13194139533478 17592186045585 true] [17592186403661 1075 #edb/ref 17592186403665 13194139533478 17592186045585 true] [17592186403661 1075 #edb/ref 17592186403666 13194139533478 17592186045585 true] [17592186403661 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403661 1077 "selection" 13194139533478 17592186045585 true] [17592186403661 1079 #edb/ref 17592186403665 13194139533478 17592186045585 true] [17592186403661 1080 #uuid "45e63128-e41c-54ad-afda-6808e4f902e4" 13194139533478 17592186045585 true] [17592186403662 1081 "M∼[\\begin{aligned}1 & 4 & -2 & -1 \\\\ 0 & 1 & -3 & 12 \\\\ 0 & 0 & 1 & 0\\end{aligned}]" 13194139533478 17592186045585 true] [17592186403662 1083 #e