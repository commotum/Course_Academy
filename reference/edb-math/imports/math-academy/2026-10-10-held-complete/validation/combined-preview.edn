194139533478 17592186045585 true] [17592186401893 1069 "q-2194" 13194139533478 17592186045585 true] [17592186401893 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186401893 1071 "Calculate the integral $\\int \\frac{\\sqrt{2}}{x\\operatorname{ln}⁡x}\\,\\text{d}x.$" 13194139533478 17592186045585 true] [17592186401893 1072 #uuid "6e0472f6-3d3e-5a0e-bbc2-09db07e6e756" 13194139533478 17592186045585 true] [17592186401893 1074 "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{2}}{x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\sqrt{2}\\int \\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\sqrt{2}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\sqrt{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C\\end{aligned}\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186401894 1075 #edb/ref 17592186401895 13194139533478 17592186045585 true] [17592186401894 1075 #edb/ref 17592186401896 13194139533478 17592186045585 true] [17592186401894 1075 #edb/ref 17592186401897 13194139533478 17592186045585 true] [17592186401894 1075 #edb/ref 17592186401898 13194139533478 17592186045585 true] [17592186401894 1075 #edb/ref 17592186401899 13194139533478 17592186045585 true] [17592186401894 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186401894 1077 "selection" 13194139533478 17592186045585 true] [17592186401894 1079 #edb/ref 17592186401898 13194139533478 17592186045585 true] [17592186401894 1080 #uuid "0ff01c23-3bf9-54e8-b3ae-815e53dd5059" 13194139533478 17592186045585 true] [17592186401895 1081 "\\frac{1}{\\operatorname{ln}⁡|\\operatorname{ln}⁡x|}+C" 13194139533478 17592186045585 true] [17592186401895 1083 #edb/ref 17592186045499 13194139533478 17592186