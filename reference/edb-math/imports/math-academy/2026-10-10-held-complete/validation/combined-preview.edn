8 17592186045585 true] [17592186402882 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402882 1084 #uuid "9a831cb5-7996-50f5-a00f-9238c740dfbc" 13194139533478 17592186045585 true] [17592186402883 1081 "$S$ only" 13194139533478 17592186045585 true] [17592186402883 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402883 1084 #uuid "965453b1-8564-5aa8-8e90-1d29787fd17c" 13194139533478 17592186045585 true] [17592186402884 1081 "$Q$ and $S$ only" 13194139533478 17592186045585 true] [17592186402884 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402884 1084 #uuid "d8c136ae-153c-59f1-8f96-afd3d63f12c8" 13194139533478 17592186045585 true] [17592186402885 1081 "$Q$ only" 13194139533478 17592186045585 true] [17592186402885 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402885 1084 #uuid "07ca52bf-aff6-51dc-b9d9-86e513484473" 13194139533478 17592186045585 true] [17592186402886 1081 "$P$ and $S$ only" 13194139533478 17592186045585 true] [17592186402886 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402886 1084 #uuid "4d68e0d7-29e8-5b6d-a9f0-b295aa3c7e0e" 13194139533478 17592186045585 true] [17592186402887 1068 #edb/ref 17592186402888 13194139533478 17592186045585 true] [17592186402887 1069 "q-47516" 13194139533478 17592186045585 true] [17592186402887 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186402887 1071 "![](images/4e/4e796ff4d915d8c8b829574ade4eab05c7740de1f376d00900ec0d14b08f97d9.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nI. It has a removable discontinuity at $x=-1.$\nII. It has a removable discontinuity at $x=1.$\nIII. There are removable discontinuities at both $x=-1$ and $x=1.$" 13194139533478 17592186045585 true] [17592186402887 1072 #uuid "3f6ba6a9-669c-53ec-9eb7-450cfe9629e8" 13194139533478 17592186045585 true] [17592186402887 1074 "The function is continuous at $x=-1.$ Checking our continuity conditions, we have:\n\n- $f(-1)=0$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to (-1)}f(x)=0$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to (-1)}f(x)=f(-1)$ $\\,\\,✓$\n\nOn the other hand, the function has a discontinuity at $x=1.$ Checking our continuity conditions, we have:\n\n- $f(1)=1$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to 1}f(x)=0$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to 1}f(x)\\ne f(1)$ $\\,\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=1$ is a removable discontinuity.\n\nConsequently, II is true while I and III are false." 13194139533478 17592186045585 true] [17592186402888 1075 #edb/ref 17592186402889 13194139533478 17592186045585 true] [17592186402888 1075 #edb/ref 17592186402890 13194139533478 17592186045585 true] [17592186402888 1075 #edb/ref 17592186402891 13194139533478 17592186045585 true] [17592186402888 1075 #edb/ref 17592186402892 13194139533478 17592186045585 true] [17592186402888 1075 #edb/ref 17592186402893 13194139533478 17592186045585 true] [17592186402888 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186402888 1077 "selection" 13194139533478 17592186045585 true] [17592186402888 1079 #edb/ref 17592186402893 13194139533478 17592186045585 true] [17592186402888 1080 #uuid "9247b5bb-55c1-5dcd-9dad-e5cbea588f1a" 13194139533478 17592186045585 true] [17592186402889 1081 "I and III only" 13194139533478 17592186045585 true] [17592186402889 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402889 1084 #uuid "f28e3667-2980-5074-8ca0-7c65c818f580" 13194139533478 17592186045585 true] [17592186402890 1081 "I only" 13194139533478 17592186045585 true] [17592186402890 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402890 1084 #uuid "a36c6aa3-5eca-5ce1-a603-385bd52d2612" 13194139533478 17592186045585 true] [17592186402891 1081 "III only" 13194139533478 17592186045585 true] [17592186402891 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402891 1084 #uuid "cf91ce51-0283-5449-b2fe-9642496d8caa" 13194139533478 17592186045585 true] [17592186402892 1081 "I and II only" 13194139533478 17592186045585 true] [17592186402892 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402892 1084 #uuid "e87dd991-b032-56f7-969b-d3143d2e4eb5" 13194139533478 17592186045585 true] [17592186402893 1081 "II only" 13194139533478 17592186045585 true] [17592186402893 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402893 1084 #uuid "d16a79db-14b9-542d-af73-6d819fa169a8" 13194139533478 17592186045585 true] [17592186402894 1068 #edb/ref 17592186402895 13194139533478 17592186045585 true] [17592186402894 1069 "q-47559" 13194139533478 17592186045585 true] [17592186402894 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186402894 1071 "![](images/61/613eaf413822013885a22df61a4bf32f7cd763bf11db71ab7b8769e19c0369b0.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nI. It has a removable discontinuity at $x=0.$\nII. It is continuous at $x=3.$\nIII. It has removable discontinuities at both $x=0$ and $x=3.$" 13194139533478 17592186045585 true] [17592186402894 1072 #uuid "66cc33ab-f2ce-599f-8f13-d60a316244d0" 13194139533478 17592186045585 true] [17592186402894 1074 "The function has a discontinuity at $x=0.$ Checking our continuity conditions, we have:\n\n- $f(0)=1$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to 0}f(x)=2$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to 0}f(x)\\ne f(0)$ $\\,\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=0$ is a removable discontinuity.\n\nIn the same way, the function has a discontinuity at $x=3.$ Checking our continuity conditions, we have:\n\n- $f(3)=1$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to 3}f(x)=-2$ exists $\\,\\,✓$\n\n- ${lim}_{x\\to 3}f(x)\\ne f(3)$ $\\,\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=3$ is a removable discontinuity.\n\nConsequently, I and III are true while II is false." 13194139533478 17592186045585 true] [17592186402895 1075 #edb/ref 17592186402896 13194139533478 17592186045585 true] [17592186402895 1075 #edb/ref 17592186402897 13194139533478 17592186045585 true] [17592186402895 1075 #edb/ref 17592186402898 13194139533478 17592186045585 true] [17592186402895 1075 #edb/ref 17592186402899 13194139533478 17592186045585 true] [17592186402895 1075 #edb/ref 17592186402900 13194139533478 17592186045585 true] [17592186402895 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186402895 1077 "selection" 13194139533478 17592186045585 true] [17592186402895 1079 #edb/ref 17592186402896 13194139533478 17592186045585 true] [17592186402895 1080 #uuid "8f8a6daf-f494-52bf-bfe7-77e7b41763ac" 13194139533478 17592186045585 true] [17592186402896 1081 "I and III only" 13194139533478 17592186045585 true] [17592186402896 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402896 1084 #uuid "dd4e63c1-9f02-5fd7-949e-98f752ee154d" 13194139533478 17592186045585 true] [17592186402897 1081 "I only" 13194139533478 17592186045585 true] [17592186402897 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402897 1084 #uuid "5399ec6b-9f9b-5481-b0b1-7de0826e1d8b" 13194139533478 17592186045585 true] [17592186402898 1081 "III only" 13194139533478 17592186045585 true] [17592186402898 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402898 1084 #uuid "57b825f2-08f0-5a00-9dfc-852febae5025" 13194139533478 17592186045585 true] [17592186402899 1081 "I and II only" 13194139533478 17592186045585 true] [17592186402899 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402899 1084 #uuid "553afacb-c3c4-5e4f-bddf-bab35e33076b" 13194139533478 17592186045585 true] [17592186402900 1081 "II only" 13194139533478 17592186045585 true] [17592186402900 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186402900 1084 #uuid "6c2d8a1c-1a48-589b-a7fd-3af4c277ad66" 13194139533478 17592186045585 true] [17592186402901 1068 #edb/ref 17592186402902 13194139533478 17592186045585 true] [17592186402901 1069 "q-4772" 13194139533478 17592186045585 true] [17592186402901 1070 #edb/ref 17592186045485 13194139533478 17592186045585 true] [17592186402901 1071 "The displacement (in centimeters) of an ant moving in a straight line is given by $s(t)={t}^{2}+3t,$ where $t$ is measured in seconds.\nFind the ant's acceleration at $t=10$ seconds." 13194139533478 17592186045585 true] [17592186402901 1072 #uuid "3288674d-b4a5-55ff-8fac-98e0dfe5f073" 13194139533478 17592186045585 true] [17592186402901 1074 "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+3t) \\\\  & =2t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+3) \\\\  & =2\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=10,$ we substitute this into the above:\n\n$$\na(10)=2\\,{\\text{m/s}}^{2}\n$$\n\nTherefore, the acceleration when $t=10$ seconds is $2\\,{\\text{m/s}}^{2}.$" 13194139533478 17592186045585 true] [17592186402902 1075 #edb/ref 17592186402903 13194139533478 17592186045585 true] [17592186402902 1075 #edb/ref 17592186402904 13194139533478 17592186045585 true] [17592186402902 1075 #edb/ref 17592186402905 13194139533478 17592186045585 true] [17592186402902 1075 #edb/ref 17592186402906 13194139533478 17592186045585 true] [17592186402902 1075 #edb/ref 17592186402907 13194139533478 17592186045585 true] [17592186402902 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186402902 1077 "selection" 13194139533478 17592186045585 true] [17592186402902 1079 #edb/ref 17592186402905 13194139533478 17592186045585 true] [17592186402902 1080 #uuid "48976552-daf