ame{sin}⁡(t))=6\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(-5\\operatorname{sin}⁡(5t))^{2}+(6\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400094 13194139533478 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400095 13194139533478 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400096 13194139533478 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400097 13194139533478 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400098 13194139533478 17592186045585 true] [17592186400093 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186400093 1077 "selection" 13194139533478 17592186045585 true] [17592186400093 1079 #edb/ref 17592186400098 13194139533478 17592186045585 true] [17592186400093 1080 #uuid "065d677c-9998-56e4-8b57-ce841d04bf36" 13194139533478 17592186045585 true] [17592186400094 1081 "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(5t)+36\\operatorname{cos}⁡(6t)}\\,\\text{d}t" 13194139533478 17592186045585 true] [17592186400094 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186400094 1084 #uuid "221b2a78-3ed9-5fcc-a904-b72ed2d8cda6" 13194139533478 17592186045585 true] [17592186400095 1081 "2{\\int }_{0}^{\\pi /2}\\sqrt{5{sin}^{2}⁡(5t)+6{cos}^{2}⁡(t)}\\,\\text{d}t" 13194139533478 17592186045585 true] [17592186400095 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186400095 1084 #uuid "2037ceca-da9b-5e6c-99af-f9e9635c71f9" 13194139533478 17592186045585 true] [17592186400096 1081 "{\\int }_{0}^{\\pi /2}\\sqrt{10{si