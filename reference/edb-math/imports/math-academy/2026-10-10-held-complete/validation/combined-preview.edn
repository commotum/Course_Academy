ligned}2 \\\\ 1\\end{aligned}] \\\\ T(j) & =T\\cdot j=[\\begin{aligned}2 & 4 \\\\ 1 & -5\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}4 \\\\ -5\\end{aligned}]\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186403933 1075 #edb/ref 17592186403934 13194139533478 17592186045585 true] [17592186403933 1075 #edb/ref 17592186403935 13194139533478 17592186045585 true] [17592186403933 1075 #edb/ref 17592186403936 13194139533478 17592186045585 true] [17592186403933 1075 #edb/ref 17592186403937 13194139533478 17592186045585 true] [17592186403933 1075 #edb/ref 17592186403938 13194139533478 17592186045585 true] [17592186403933 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403933 1077 "selection" 13194139533478 17592186045585 true] [17592186403933 1079 #edb/ref 17592186403937 13194139533478 17592186045585 true] [17592186403933 1080 #uuid "fd1100a3-f46d-5e04-86d4-755b02a479bb" 13194139533478 17592186045585 true] [17592186403934 1081 "$[\\begin{aligned}4 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 1\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186403934 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403934 1084 #uuid "50e07024-23d2-5570-be5e-03b114b3c983" 13194139533478 17592186045585 true] [17592186403935 1081 "$[\\begin{aligned}1 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 4\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186403935 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403935 1084 #uuid "e0bbab46-dd35-5c94-a96c-8093cdf108d9" 13194139533478 17592186045585 true] [17592186403936 1081 "$[\\begin{aligned}2 \\\\ 4\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -5\\end{aligned}]$" 13194139533478 17592186045585 true] [17592186403936 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403936 1084 #uuid "8e4bf657-7654-5279-9a17-d906a95a31d7" 13194139533478 17592186045585 true] [17592186403937 1081 "